     1938   ) no-error
     1939   .
     1940         .
     1941        if error-status :error then message
     1942          vss-workfile vss-revision vss-description skip
     1943          error-status :get-message(1) skip
     1944          return-value skip
     1945          ""
     1946          view-as alert-box error
     1947        .
     1948       for each buf_parts where
     1949                buf_parts.vat-type  = p-vat-type :
     1950         create tt-parts.
     1951         buffer-copy buf_parts to tt-parts
     1952         assign
     1953           tt-parts.out-code = v-num-doc
     1954         .
     1955         end.
     1956        for each tt-parts :
     1957            find first tt2-doc-line where
     1958                       tt2-doc-line.doc-code  =  v-num-doc and
     1959                       tt2-doc-line.artic     =  tt-parts.artic and
     1960                       tt2-doc-line.prod-type =  tt-parts.prod-type and
     1961                       tt2-doc-line.prod-code =  tt-parts.prod-code no-error .
     1962            if not available tt2-doc-line then do:
     1963               create tt2-doc-line.
     1964               v-fact-qnty = 0.
     1965               v-cli-qnty  = 0.
     1966            end.
     1967            else do:
     1968               v-fact-qnty = tt2-doc-line.fact-qnty.
     1969               v-cli-qnty  = tt2-doc-line.cli-qnty.
     1970            end.
     1971            buffer-copy tt-parts except status_ to tt2-doc-line
     1972            assign
     1973                tt2-doc-line.doc-code  = v-num-doc
     1974                tt2-doc-line.doc-qnty   = tt-parts.fact-qnty + v-fact-qnty
     1975                tt2-doc-line.fact-qnty  = tt-parts.fact-qnty + v-fact-qnty
     1976                tt2-doc-line.cli-qnty   = tt-parts.cli-qnty  + v-cli-qnty
     1977            .
     1978            find first tt-doc-line where
     1979                       tt-doc-line.doc-code  =  v-num-doc and
     1980                       tt-doc-line.artic     =  tt-parts.artic and
     1981                       tt-doc-line.prod-type =  tt-parts.prod-type and
     1982                       tt-doc-line.prod-code =  tt-parts.prod-code no-error .
     1983            if not available tt2-doc-line then do:
     1984               create tt-doc-line.
     1985            end.
     1986        end.
     1987        for each  tt2-doc-line where
     1988                       tt2-doc-line.doc-code  =  v-num-doc :
     1989            find first tt-gds-dtl where
     1990                       tt-gds-dtl.doc-code  =  v-num-doc and
     1991                       tt-gds-dtl.artic     =  tt2-doc-line.artic and
     1992                       tt-gds-dtl.prod-type =  tt2-doc-line.prod-type and
     1993                       tt-gds-dtl.prod-code =  tt2-doc-line.prod-code no-error .
     1994            if not available tt-gds-dtl then do:
     1995               create tt-gds-dtl.
     1996            end.
     1997   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1999     (input  tt2-doc-line.artic
     2000     ,input  tt2-doc-line.prod-type
     2001     ,input  tt2-doc-line.prod-code
     2002     ,output v-root-node
     2003     )  .
     2004            buffer-copy tt2-doc-line to tt-gds-dtl
     2005            assign
     2006               tt-gds-dtl.doc-code  = v-num-doc
     2007               tt-gds-dtl.prt-code  = v-root-node
     2008            .
     2009        end.
     2010       find first new_trn-doc where new_trn-doc.doc-code = tt-trn-doc.doc-code  exclusive-lock no-error .
     2011       if  available new_trn-doc then do:
     2012       assign
     2013           new_trn-doc.print-rubl = tt-trn-doc.print-rubl
     2014           new_trn-doc.hold-doc-code-child  = "no-hold":u
     2015           new_trn-doc.hold-doc-code-parent = "no-hold":u
     2016           .
     2017         assign
     2018             new_trn-doc.cli-type = v-cli-type
     2019             new_trn-doc.cli-code = v-cli-code
     2020             new_trn-doc.cli-name = v-cli-name
     2021             .
     2022           end.
     2023   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_copy-ret in g#lib-trn
