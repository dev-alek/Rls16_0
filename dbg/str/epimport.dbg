      761   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   function octal-to-char return character
      763   ( p-string as character ) :
      764     def var v-asc     as integer no-undo .
      765     def var v-new-asc as integer no-undo .
      766     def var ind       as integer no-undo .
      767     if length(p-string) <> 3 then do:
      768       return ? .
      769     end.
      770     assign
      771       v-asc = 0
      772     .
      773     do ind = 1 to length(p-string)
      774     :
      775       assign
      776         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      777       .
      778       if v-new-asc < 0 or v-new-asc >= 8 then do:
      779         return ? .
      780       end.
      781       assign
      782         v-asc = v-asc * 8 + v-new-asc
      783       .
      784     end.
      785     return chr(v-asc) .
      786   end function .
      787   function char-to-octal return character
      788   ( p-chr as character ) :
      789     def var v-asc    as integer   no-undo .
      790     def var ind      as integer   no-undo .
      791     def var v-string as character no-undo .
      792     if length(p-chr) <> 1 then do:
      793       return ? .
      794     end.
      795     assign
      796       v-asc    = asc(p-chr)
      797       v-string = ""
      798     .
      799     do ind = 1 to 3
      800     :
      801       assign
      802         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      803       .
      804       assign
      805         v-asc = truncate(v-asc / 8, 0)
      806       .
      807     end.
      808     return v-string .
      809   end.
      810   function str-encode return character
      811   (   p-init-string       as character
      812     , p-encode-char       as character
      813     , p-special-char-list as character
      814   ) :
      815     def var p-encode-string as character no-undo .
      816     def var ind                as integer no-undo .
      817     def var v-num-special-char as integer no-undo .
      818     def var v-special-char     as character no-undo .
      819     if p-encode-char = ?
      820     or p-encode-char = "" then do:
      821       assign
      822         p-encode-char = "~~"
      823       .
      824     end.
      825     if p-init-string = ? then do:
      826       return "?" .
      827     end.
      828     if p-init-string = "?" then do:
      829       return p-encode-char + char-to-octal("?") .
      830     end.
      831     assign
      832       v-num-special-char = length(p-special-char-list)
      833       p-encode-string    = replace(p-init-string
      834                                   ,p-encode-char
      835                                   ,p-encode-char + char-to-octal(p-encode-char)
      836                                   )
      837     .
      838     do ind = 1 to v-num-special-char
      839     :
      840       assign
      841         v-special-char = substring(p-special-char-list, ind, 1)
      842       .
      843       if v-special-char <> p-encode-char then do:
      844         assign
      845           p-encode-string = replace (p-encode-string
      846                                     ,v-special-char
      847                                     ,p-encode-char + char-to-octal(v-special-char)
      848                                     )
      849         .
      850       end.
      851     end.
      852     return p-encode-string .
      853   end.
      854   function str-decode returns character
      855     (p-init-string   as character
      856     ,p-encode-char   as character
      857     ) :
      858     def var p-decode-string as character no-undo .
      859     def var ind                       as integer no-undo .
      860     def var v-num-entries-init-string as integer no-undo .
      861     def var v-sub-phrase              as character no-undo .
      862     def var v-special-char            as character no-undo .
      863     if p-encode-char = ?
      864     or p-encode-char = "" then do:
      865       assign
      866         p-encode-char = "~~"
      867       .
      868     end.
      869     if p-init-string = "?" then do:
      870       return ? .
      871     end.
      872     assign
      873       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      874     .
      875     if v-num-entries-init-string > 1 then do:
      876       assign
      877         p-decode-string = entry(1, p-init-string, p-encode-char)
      878       .
      879       do ind = 2 to v-num-entries-init-string
      880       :
      881         assign
      882           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      883         .
      884         assign
      885           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      886         .
      887         if v-special-char <> ? then do:
      888           assign
      889             p-decode-string = p-decode-string
      890                             + v-special-char
      891                             + substring(v-sub-phrase, 4)
      892           .
      893         end.
      894         else do:
      895           assign
      896             p-decode-string = p-decode-string
      897                             + p-encode-char
      898                             + v-sub-phrase
      899           .
      900         end.
      901       end.
      902     end.
      903     else do:
      904       assign
      905         p-decode-string = p-init-string
      906       .
      907     end.
      908     return p-decode-string .
      909   end.
