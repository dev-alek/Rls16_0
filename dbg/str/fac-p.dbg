      497        SIZE 9 BY 1.
      498   DEFINE BUTTON b-exp-nd
      499        LABEL "&>>":L
      500        SIZE 4.5 BY 1.
      501   DEFINE BUTTON b-exp-tree
      502        LABEL ">>&->>":L
      503        SIZE 9 BY 1.
      504   DEFINE BUTTON b-amnt
      505        LABEL "&Колич":L
      506        SIZE 9 BY 1.
      507   DEFINE BUTTON b-codes
      508        LABEL "&Коды":L
      509        SIZE 9 BY 1.
      510   DEFINE MENU m-alt
      511          MENU-ITEM m-alt-current  LABEL "Существующие неосновные цены"
      512          MENU-ITEM m-alt-all      LABEL "Все неосновные коды"
      513          rule
      514          MENU-ITEM m-prod-all     LABEL "Дополнительные коды"
      515          .
      516   DEFINE MENU MENU-b-print
      517          MENU-ITEM m_hor          LABEL "Уровни по горизонтали"
      518          MENU-ITEM m_vert         LABEL "Уровни по вертикали"
      519          .
      520   DEFINE BUTTON b-alt
      521        LABEL "&Неос/Доп":L
      522        SIZE 9 BY 1.
      523   DEFINE BUTTON b-rest
      524        LABEL "&Остатки":L
      525        SIZE 9 BY 1.
      526   DEFINE MENU m-inf
      527          MENU-ITEM m-inf-prt      LABEL "По признаку"
      528          MENU-ITEM m-inf-gds      LABEL "По товару"
      529          .
      530   DEFINE BUTTON b-info
      531        LABEL "&Архив":L
      532        SIZE 9 BY 1.
      533   DEFINE BUTTON b-print
      534        LABEL "Пе&чать":L
      535        SIZE 9 BY 1.
      536   DEFINE BUTTON b-help
      537        LABEL "Помо&щь":L
      538        SIZE 9 BY 1.
      539   DEFINE FRAME d-gds-prt
      540     b-exit     AT ROW 1.25  COL 1
      541     b-sel      AT ROW 1.25  COL 10
      542     b-del      AT ROW 1.25  COL 19
      543     b-exp-nd   AT ROW 1.25  COL 28
      544     b-exp-tree AT ROW 1.25  COL 32.5
      545     b-amnt     AT ROW 1.25  COL 41.5
      546     b-codes    AT ROW 1.25  COL 50.5
      547     b-alt      AT ROW 1.25  COL 59.5
      548     b-rest     AT ROW 1.25  COL 68.5
      549     b-info     AT ROW 1.25  COL 77.5
      550     b-print    AT ROW 1.25  COL 76.5
      551     b-help     AT ROW 1.25  COL 78.5
      552     ub.doc-line.doc-qnty
      553                at row 2.5   col 30  label "Товар" format "->>>,>>>,>>9.<<<"
      554     ub.doc-line.fact-qnty
      555                at row 2.5   col 50  label "Факт"  format "->>>,>>>,>>9.<<<"
      556     ub.goods.unit-base at row 2.5   col 70  no-label      format "x(3)"
      557     flt-amnt        at row 3.5   col 5   label "Только с количествами" view-as toggle-box
      558     br-gds-prt      AT ROW 4.5   COL 2
      559     WITH size 96 by 21 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      560     ASSIGN
      561     b-print:POPUP-MENU IN FRAME d-gds-prt       = MENU MENU-b-print:HANDLE.
      562     br-gds-prt :set-repositioned-row (10, "conditional").
      563     b-print:MENU-MOUSE in frame d-gds-prt  = 1.
      564     ASSIGN
      565       FRAME d-gds-prt:SCROLLABLE = FALSE
      566       b-info    :POPUP-MENU IN FRAME d-gds-prt         = MENU m-inf  :HANDLE
      567       b-info    :MENU-MOUSE                                = 1
      568       b-alt     :POPUP-MENU IN FRAME d-gds-prt         = MENU m-alt  :HANDLE
      569       b-alt     :MENU-MOUSE                                = 1
      570       .
      571   on value-changed of flt-amnt do:
      572     gds-prt-row = current-result-row ("br-gds-prt").
      573     find first prt-tree.
      574     if input frame d-gds-prt flt-amnt then
      575       run exp-tree.
      576       run UI-on.
      577   end.
      578   on row-display of br-gds-prt do:
      579     if prt-tree.is-root then
      580       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      581     else
      582       if not prt-tree.is-term then
      583         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      584   end.
      585   ON CHOOSE OF b-exit IN FRAME d-gds-prt  DO:
      586     prt-rec = prt-tree.rid.
      587     return "exit":U.
      588   END.
      589   ON CHOOSE OF b-sel IN FRAME d-gds-prt  DO:
      590     prt-rec = prt-tree.rid.
      591   END.
      592   ON choose of b-del IN FRAME d-gds-prt DO:
      593      def var gds-prt-recid as recid   no-undo.
      594      def var chg-qnty      as decimal no-undo.
      595   END.
      596   ON choose of b-exp-nd IN FRAME d-gds-prt DO:
      597     gds-prt-row = current-result-row ("br-gds-prt").
      598     run exp-nd (?).
      599     run UI-on.
      600   END.
      601   ON choose of b-exp-tree IN FRAME d-gds-prt DO:
      602     gds-prt-row = current-result-row ("br-gds-prt").
      603     run exp-tree.
      604     run UI-on.
      605   END.
      606   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME d-gds-prt DO:
      607     gds-prt-row = current-result-row ("br-gds-prt").
      608     if prt-tree.is-term then do:
      609       if b-amnt:sensitive then
      610         apply "choose" to b-amnt in frame d-gds-prt.
      611     end.
      612     else
      613       apply "choose" to b-exp-nd in frame d-gds-prt.
      614     return no-apply.
      615   END.
      616   ON CHOOSE OF b-amnt IN FRAME d-gds-prt  DO:
      617     DEFINE VARIABLE rid-list as character no-undo .
      618     gds-prt-row = current-result-row ("br-gds-prt").
      619     if not prt-tree.is-root and
      620        not prt-tree.is-term then do:
      621       message "Данный признак промежуточный и не может быть выбран."
      622               view-as alert-box error.
      623       return no-apply.
      624     end.
      625     case ub.trn-doc.doc-type:
      626       when 'при':U or
      627       when 'рас':U or
      628       when 'спи':U or
      629       when 'возврат':U then
      630         run str/out-prt.w (
      631                         parParentProc ,
      632                         doc-rec       ,
      633                         line-rec      ,
      634                         gds-rec       ,
      635                         prt-mode      ,
      636                         prt-tree.rid,
      637                        (if prt-tree.is-term then 'терм':U  else 'корн':U))
      638                        no-error.
      639       when 'инв':U then do:
      640         if ub.trn-doc.ext-doc-type = 'vt':U then do:
      641           run str/inv-prt.w (
      642                         parParentProc ,
      643                         doc-rec       ,
      644                         line-rec      ,
      645                         gds-rec       ,
      646                         prt-mode      ,
      647                         prt-tree.rid,
      648                          (if prt-tree.is-term then
      649                             'терм':U
      650                           else
      651                             'корн':U)) no-error.
      652         end.
      653         else do:
      654           message "Работа с признаками запрещена при работе с документом, имеющим расширенный тип: " ub.trn-doc.ext-doc-type "."
      655           view-as alert-box.
      656           return no-apply.
      657         end.
      658       end.
      659     end.
      660     if not error-status:error then do:
      661       run clc-nd (buffer prt-tree).
      662       disp  prt-tree.doc-amnt
      663             prt-tree.fac-amnt
      664             prt-tree.bc
      665             with browse br-gds-prt.
      666       find first prt-tree.
      667        run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      668       run ui-on.
      669     end.
      670   END.
      671   ON CHOOSE OF b-codes IN FRAME d-gds-prt do:
      672     run cre-code no-error.
      673     if error-status :error then
      674       return no-apply.
      675     prt-rec = prt-tree.rid.
      676     run ref/alt-bc.w (
      677                   input parParentProc
      678                 , input store-type
      679                 , input store-code
      680                 , input prt-tree.bc).
      681     apply "entry" to br-gds-prt in frame d-gds-prt.
      682   END.
      683   ON CHOOSE OF menu-item m-alt-current do:
      684     run cre-code no-error.
      685     if error-status :error then
      686       return no-apply.
      687     run ref/alt-cds.w ( input parParentProc
      688                        ,input store-type
      689                        ,input store-code
      690                        ,input "code-current"
      691                        ,input ub.goods.gds-code
      692                        ,input prt-tree.bc
      693                        ,output rec-list).
      694     apply "entry" to br-gds-prt in frame d-gds-prt.
      695   END.
      696   ON CHOOSE OF menu-item m-alt-all do:
      697     run cre-code no-error.
      698     if error-status :error then
      699       return no-apply.
      700     run ref/alt-cds.w ( input parParentProc
      701                        ,input store-type
      702                        ,input store-code
      703                        ,input "code-all"
      704                        ,input ub.goods.gds-code
      705                        ,input prt-tree.bc
      706                        ,output rec-list).
      707     apply "entry" to br-gds-prt in frame d-gds-prt.
      708   END.
      709   ON CHOOSE OF menu-item m-prod-all do:
      710     run cre-code no-error.
      711     if error-status :error then
      712       return no-apply.
      713     run ref/prod-cds.w (parParentProc, store-type, store-code,
      714                     "code-all", ub.goods.gds-code, prt-tree.bc, output rec-list).
      715     apply "entry" to br-gds-prt in frame d-gds-prt.
      716   END.
      717   ON CHOOSE OF menu-item m-inf-prt
      718   do:
      719   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      720   do:
      721     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      722       (input  v-cntxt-db-num
      723       ,input  v-cntxt-userid
      724       ,input  0
      725       ,input  'actn_reference_archive':U
      726       ,input  'firm':U
      727       ,input  v-cntxt-host-code-obj
      728       ,input  '':U
      729       ,input  0
      730       ,input  0
      731       ,input  0
      732       ,input  0
      733       ,input  true
      734       ,output g#log
      735       )  .
      736   end.
      737     if g#log then
      738       run ref/prt_inf.w (buffer ub.goods,
      739                      input prt-tree.n-code,
      740                      input store-type,
      741                      input store-code).
      742     apply "entry" to br-gds-prt in frame d-gds-prt.
      743   END.
      744   ON CHOOSE OF menu-item m-inf-gds do:
      745      run local-gds_inf.
      746   END.
      747   ON CHOOSE OF b-rest IN FRAME d-gds-prt do:
      748     prt-rec = prt-tree.rid.
      749       run rep/gds-objs.w (parparentproc, ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, g#host-code, prt-tree.n-code).
      750     apply "entry" to br-gds-prt in frame d-gds-prt.
      751   END.
      752   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      753     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      754   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   on help of frame d-gds-prt
      756   do:
      757     run gbl/app_help.p
      758       (input this-procedure :file-name
      759       ,input ''
      760       ,input ?
      761       ) no-error.
      762     if error-status :error then do:
      763       message
      764         "Ошибка при вызове помощи"
      765         error-status :get-message(1)
      766         view-as alert-box .
      767     end.
      768   end.
      769   run minbtn-set in this-procedure .
      770   on choose of b-help in frame d-gds-prt
      771   do:
      772     apply "help":u to frame d-gds-prt .
      773   end.
      774   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      775   procedure minbtn-set :
      776       do
      777           on error undo, return error return-value
      778           :
      779           define variable ii              as integer       no-undo .
      780           define variable fh              as widget-handle no-undo .
      781           define variable hh              as widget-handle no-undo .
      782           define variable v-h             as handle        extent 4 no-undo .
      783           define variable v-name-button   as character     no-undo .
      784           define variable v-help-old-x    as decimal       no-undo .
      785           define variable v-help-old-y    as decimal       no-undo .
      786           define variable v-help-old-size as decimal       no-undo .
      787           define variable v-frame-width   as decimal       no-undo .
      788           define variable jj              as integer       no-undo .
      789           do
      790               on error undo, return error
      791               :
      792               assign
      793                   v-frame-width = frame d-gds-prt:width - 0.3
      794                   fh            = frame d-gds-prt:first-child
      795                   hh            = fh:first-child
      796                   ii            = 1
      797                   .
      798               do while valid-handle(hh):
      799                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      800                   do:
      801                       case lc(hh:name) :
      802                           when "b-help" then
      803                               do:
      804                                   hh:load-image-up("cmp/b-help.bmp":u) .
      805                                   hh:load-image-down("cmp/b-help.bmp":u) .
      806                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      807                                   hh:TOOLTIP = "Помощь" .
      808                                   v-help-old-x = hh:column .
      809                                   v-help-old-y = hh:row    .
      810                                   v-help-old-size = hh:width .
      811                                   hh:width-chars = 2.5 .
      812                               end.
      813                           when "b-print" then
      814                               do:
      815                                   hh:load-image("cmp/b-print.bmp":u) .
      816                                   hh:TOOLTIP = "Печать" .
      817                                   v-h[ii] = hh:handle .
      818                                   ii = ii + 1 .
      819                                   hh:width-chars = 3 .
      820                               end.
      821                           when "b-history" or
      822                           when "b-hist" then
      823                               do:
      824                                   hh:load-image("cmp/b-hist.bmp":u) .
      825                                   hh:TOOLTIP = "История" .
      826                                   v-h[ii] = hh:handle .
      827                                   ii = ii + 1 .
      828                                   hh:width-chars = 3 .
      829                               end.
      830                           when "b-sch" then
      831                               do:
      832                                   hh:load-image("cmp/b-sch.bmp":u) .
      833                                   hh:TOOLTIP = "Установка Фильтра" .
      834                                   v-h[ii] = hh:handle .
      835                                   ii = ii + 1 .
      836                                   hh:width-chars = 3 .
      837                               end.
      838                           when "b-hist-user" then
      839                               do:
      840                                   hh:load-image("cmp/b-hist.bmp":u) .
      841                                   hh:TOOLTIP = "История пользователя" .
      842                                   ii = ii + 1 .
      843                               end.
      844                       end case.
      845                   end.
      846                   hh = hh:next-sibling.
      847               end.
      848               b-help:column = v-frame-width - b-help:width-chars.
      849               jj = 0.
      850               repeat ii = 4 to 1 by -1 :
      851                   if valid-handle (v-h[ii] ) then
      852                   do:
      853                       jj  = jj + 1 .
      854                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      855                       v-h[ii]:row    = v-help-old-y .
      856                   end.
      857               end.
      858           end.
      859       end.
      860   end procedure.
      861   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
      862   find ub.goods no-lock where
      863        recid (ub.goods) = gds-rec.
      864   find ub.gds-prt no-lock where
      865        ub.gds-prt.upper-code = ub.goods.prt-root.
      866   find ub.trn-doc no-lock where
      867        recid (ub.trn-doc) = doc-rec.
      868   find ub.doc-line no-lock where
      869        recid (ub.doc-line) = line-rec.
      870   assign
      871   store-type = ub.trn-doc.obj-type
      872   store-code = ub.trn-doc.obj-code
      873   .
      874   g#log = session:set-wait-state ("COMPILER") .
      875   ENABLE br-gds-prt
      876          b-exit
      877          b-help
      878          b-rest
      879          b-exp-nd
      880          b-exp-tree with FRAME d-gds-prt.
      881   run cre-nd (buffer  ub.gds-prt, buffer prt-tree, 0).
      882   find first prt-tree.
      883   run exp-nd (yes).
      884   FRAME d-gds-prt:title =
      885     ub.goods.artic + " " + ub.goods.gds-name + "  -  " + prt-mode.
      886   ENABLE b-sel when prt-mode = 'выбор':U
      887          b-info
      888          b-codes b-alt b-amnt
      889          with FRAME d-gds-prt.
      890   ENABLE flt-amnt with FRAME d-gds-prt.
      891   find first prt-tree.
      892    run calc-tree (output prt-tree.doc-amnt, output prt-tree.fac-amnt).
      893   run ui-on.
      894   g#log = session:set-wait-state ( "" ) .
      895   do on endkey undo, leave  on error undo, leave:
      896     WAIT-FOR GO OF FRAME d-gds-prt.
      897   end.
      898   run disable_ui.
      899   PROCEDURE disable_UI :
      900     HIDE FRAME d-gds-prt.
      901   END PROCEDURE.
      902   PROCEDURE UI-on :
      903   find  ub.prt-obj where  ub.prt-obj.prt-code  =  ub.gds-prt.node-code
      904                  and  ub.prt-obj.prod-code = ub.goods.prod-code
      905                  and  ub.prt-obj.prod-type = ub.goods.prod-type
      906                  and  ub.prt-obj.artic     = ub.goods.artic
      907                  and  ub.prt-obj.obj-code  = store-code
      908                  and  ub.prt-obj.obj-type  = store-type
      909                  no-lock no-error.
      910   find ub.doc-line where recid (ub.doc-line) = line-rec no-lock.
      911   old_qnty = ub.doc-line.doc-qnty - ub.doc-line.fact-qnty.
      912   if old_qnty = ? then
      913     if available  ub.prt-obj then
      914       old_qnty =  ub.prt-obj.fact-qnty.
      915     else
      916       old_qnty = 0.
      917   disp ub.goods.unit-base ub.doc-line.doc-qnty
      918       ub.doc-line.fact-qnty
      919       with frame d-gds-prt.
      920   if input frame d-gds-prt flt-amnt then
      921     OPEN QUERY br-gds-prt
      922       FOR EACH  prt-tree where
      923                 prt-tree.visible = yes and
      924                 (prt-tree.is-term = no or
      925                 prt-tree.doc-amnt <> 0 or
      926                 prt-tree.fac-amnt <> 0
      927                 ) no-lock.
      928   else
      929   OPEN QUERY  br-gds-prt
      930     FOR EACH  prt-tree where
      931               prt-tree.visible = yes no-lock.
      932   reposition br-gds-prt to row gds-prt-row no-error.
      933   apply "ENTRY":U to br-gds-prt in frame d-gds-prt.
      934   END PROCEDURE.
      935   PROCEDURE calc-tree:
      936   def output param doc-accum like ub.gds-dtl.doc-qnty  no-undo.
      937   def output param fac-accum like ub.gds-dtl.fact-qnty no-undo.
      938   def buffer b-gds-dtl for ub.gds-dtl.
      939   for each b-gds-dtl no-lock where
      940            b-gds-dtl.doc-code  = ub.doc-line.doc-code and
      941            b-gds-dtl.artic     = ub.doc-line.artic and
      942            b-gds-dtl.prod-type = ub.doc-line.prod-type and
      943            b-gds-dtl.prod-code = ub.doc-line.prod-code:
      944     accumulate b-gds-dtl.doc-qnty  (total)
      945                b-gds-dtl.fact-qnty (total)
      946                .
      947   end.
      948   assign
      949     doc-accum  = (accum total b-gds-dtl.doc-qnty)
      950     fac-accum  = (accum total b-gds-dtl.fact-qnty)
      951     .
      952   END PROCEDURE.
      953   PROCEDURE exp-nd :
      954   def input param make-visible as logical no-undo.
      955   define variable nd-level as integer no-undo.
      956   def buffer b-prt-tree for prt-tree.
      957   if prt-tree.exp then do:
      958     nd-level = prt-tree.level.
      959     find b-prt-tree where
      960          recid (b-prt-tree) = recid (prt-tree).
      961     inverse:
      962     do while true:
      963       find next b-prt-tree no-error.
      964       if not available b-prt-tree then
      965         leave inverse.
      966       if b-prt-tree.level > nd-level then do:
      967         if make-visible = ? then
      968           make-visible = not (b-prt-tree.visible).
      969         if not make-visible or
      970            b-prt-tree.level - nd-level = 1 then do:
      971           b-prt-tree.visible = make-visible.
      972           if not b-prt-tree.is-term then
      973             b-prt-tree.mark = "»".
      974         end.
      975       end.
      976       else
      977         leave inverse.
      978     end.
      979   end.
      980   else do:
      981     prt-tree.exp = yes.
      982     run cre-level (recid (prt-tree), prt-tree.level + 1).
      983     make-visible = yes.
      984   end.
      985   if not prt-tree.is-term then
      986     if make-visible then
      987       prt-tree.mark = " ".
      988     else
      989       prt-tree.mark = "»".
      990   END PROCEDURE.
      991   PROCEDURE exp-tree :
      992     define variable rid as recid no-undo.
      993     do
      994     on error undo, return error return-value
      995     :
      996       tree-level = prt-tree.level.
      997       run waitfram-show in this-procedure
      998         (input "Раскрывается шкала. Ждите..."
      999         ).
     1000       tree:
     1001       do while true:
     1002         rid = recid (prt-tree).
     1003         run exp-nd (yes).
     1004         find prt-tree where rid = recid (prt-tree).
     1005         find next prt-tree no-error.
     1006         if not available prt-tree or
     1007           prt-tree.level <= tree-level
     1008           then
     1009           leave tree.
     1010       end.
     1011       run waitfram-hide in this-procedure .
     1012     end.
     1013   END PROCEDURE.
     1014   PROCEDURE cre-level:
     1015   def input param prt-tree-rec as recid   no-undo.
     1016   def input param cur-lev      as integer no-undo.
     1017   def buffer b-gds-prt  for  ub.gds-prt.
     1018   def buffer b-prt-tree for prt-tree.
     1019   define variable up-code like  ub.gds-prt.node-code no-undo.
     1020   find b-prt-tree where
     1021        recid (b-prt-tree) = prt-tree-rec.
     1022   up-code = b-prt-tree.n-code.
     1023   for each b-gds-prt no-lock where
     1024            b-gds-prt.upper-code = up-code
     1025            by b-gds-prt.prt-num:
     1026     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
     1027   end.
     1028   END PROCEDURE.
     1029   PROCEDURE cre-nd:
     1030   def param buffer b-gds-prt  for  ub.gds-prt.
     1031   def param buffer b-prt-tree for prt-tree.
     1032   def input param cur-lev as integer no-undo.
     1033   create b-prt-tree.
     1034   assign
     1035     b-prt-tree.n-code   = b-gds-prt.node-code
     1036     b-prt-tree.level    = cur-lev
     1037     b-prt-tree.n-name   = b-gds-prt.node-name
     1038     b-prt-tree.rid      = recid (b-gds-prt)
     1039     b-prt-tree.visible  = yes
     1040     b-prt-tree.is-term  = b-gds-prt.is-term
     1041     b-prt-tree.is-root  = b-gds-prt.root
     1042     .
     1043   if b-gds-prt.is-term then
     1044     assign
     1045       b-prt-tree.mark = " "
     1046       b-prt-tree.exp = yes
     1047       .
     1048   else
     1049     assign
     1050       b-prt-tree.mark = "»"
     1051       b-prt-tree.exp = no
     1052       .
     1053   run clc-nd (buffer b-prt-tree).
     1054   END PROCEDURE.
     1055   PROCEDURE clc-nd:
     1056   def param buffer b-prt-tree for prt-tree.
     1057   def buffer b-gds-prt for  ub.gds-prt.
     1058   find b-gds-prt no-lock where
     1059        recid (b-gds-prt) = b-prt-tree.rid.
     1060   find  ub.prt-obj no-lock where
     1061          ub.prt-obj.prt-code  = b-gds-prt.node-code and
     1062          ub.prt-obj.obj-type  = store-type and
     1063          ub.prt-obj.obj-code  = store-code and
     1064          ub.prt-obj.artic     = ub.goods.artic and
     1065          ub.prt-obj.prod-type = ub.goods.prod-type and
     1066          ub.prt-obj.prod-code = ub.goods.prod-code no-error.
     1067   if available  ub.prt-obj then do:
     1068     assign
     1069       b-prt-tree.free-qnty  =  ub.prt-obj.free-qnty
     1070       b-prt-tree.fact-qnty  =  ub.prt-obj.fact-qnty
     1071       .
     1072     b-prt-tree.price =  ub.prt-obj.price-sale.
     1073   end.
     1074   find  ub.gds-dtl no-lock where
     1075         ub.gds-dtl.artic = ub.doc-line.artic and
     1076         ub.gds-dtl.prod-code = ub.doc-line.prod-code and
     1077         ub.gds-dtl.prod-type = ub.doc-line.prod-type and
     1078         ub.gds-dtl.doc-code = ub.doc-line.doc-code and
     1079         ub.gds-dtl.prt-code = b-gds-prt.node-code no-error.
     1080   if available  ub.gds-dtl then
     1081     assign
     1082       b-prt-tree.doc-amnt =  ub.gds-dtl.doc-qnty
     1083       b-prt-tree.fac-amnt =  ub.gds-dtl.fact-qnty
     1084       .
     1085   else
     1086     assign
     1087       b-prt-tree.fac-amnt = 0
     1088       b-prt-tree.doc-amnt = 0
     1089       .
     1090   find  ub.bar-code no-lock where
     1091         ub.bar-code.gds-code  = ub.goods.gds-code and
     1092         ub.bar-code.node-code = b-gds-prt.node-code and
     1093         ub.bar-code.part-code = "" and
     1094         ub.bar-code.in-code   = "" and
     1095         ub.bar-code.unit-cli  = ub.goods.unit-base no-error.
     1096   if available ub.bar-code then
     1097     b-prt-tree.bc = ub.bar-code.b-code.
     1098   else
     1099     b-prt-tree.bc = ?.
     1100   END PROCEDURE.
     1101   PROCEDURE cre-code:
     1102   define variable is-new as log no-undo.
     1103   def buffer buf_bar-code for ub.bar-code.
     1104     if not prt-tree.is-term and
     1105        not prt-tree.is-root then do:
     1106       message
     1107         "Узел промежуточный. Работа с кодами запрещена."
     1108         view-as alert-box error.
     1109       return error.
     1110     end.
     1111     if prt-tree.bc = ? then do:
     1112       g#log = no.
     1113       message "Основной код для данного признака отсутствует. Создать код?"
     1114               view-as alert-box question buttons YES-NO update g#log.
     1115       if not g#log then
     1116         return error.
     1117   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1118   do:
     1119     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1120       (input  v-cntxt-db-num
     1121       ,input  v-cntxt-userid
     1122       ,input  0
     1123       ,input  'actn_main-barcode_preparation':U
     1124       ,input  'global':U
     1125       ,input  0
     1126       ,input  '':U
     1127       ,input  0
     1128       ,input  0
     1129       ,input  0
     1130       ,input  0
     1131       ,input  true
     1132       ,output g#log
     1133       )  .
     1134   end.
     1135       if not g#log then do:
     1136         return error.
     1137       END.
     1138   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1139   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1140     (input  ub.goods.gds-code
     1141     ,input  prt-tree.n-code
     1142     ,input  ''
     1143     ,input  ''
     1144     ,input  ub.goods.unit-base
     1145     ,input  1
     1146     ,output is-new
     1147     ,buffer buf_bar-code
     1148     ) no-error .
     1149       if error-status :error then do:
     1150         message
     1151           "Ошибка поиска / создания основного кода." skip
     1152           "Код товара:"        ub.goods.gds-code skip
     1153           "Код признака:"      prt-tree.n-code skip
     1154           "Единица измерения:" ub.goods.unit-base skip
     1155           error-status :get-message(1) skip
     1156           return-value skip
     1157           view-as alert-box error.
     1158         return error.
     1159       end.
     1160       prt-tree.bc = buf_bar-code.b-code.
     1161       disp prt-tree.bc with browse br-gds-prt.
     1162     end.
     1163   end.
     1164   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1165   procedure local-gds_inf :
     1166     for each tt-goods
     1167     :
     1168       delete tt-goods.
     1169     end.
     1170     for each tt-clients
     1171     :
     1172       delete tt-clients.
     1173     end.
     1174     create tt-goods.
     1175     buffer-copy ub.goods to tt-goods.
     1176     create tt-clients.
     1177     assign
     1178       tt-clients.obj-type = store-type
     1179       tt-clients.obj-code = store-code
     1180     .
     1181     define variable v-ok as logical   no-undo .
     1182     define variable v-chk-act-host-code as integer   no-undo .
     1183   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1185     (input  tt-clients.obj-type
     1186     ,input  tt-clients.obj-code
     1187     ,output v-chk-act-host-code
     1188     )  .
     1189   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   do:
     1191     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1192       (input  v-cntxt-db-num
     1193       ,input  v-cntxt-userid
     1194       ,input  0
     1195       ,input  'actn_reference_archive':U
     1196       ,input  'firm':U
     1197       ,input  v-chk-act-host-code
     1198       ,input  '':U
     1199       ,input  0
     1200       ,input  0
     1201       ,input  0
     1202       ,input  0
     1203       ,input  true
     1204       ,output v-ok
     1205       )  .
     1206   end.
     1207     if v-ok then do:
     1208       run arc/gds_inf.w (parparentproc, tt-clients.obj-type, tt-clients.obj-code).
     1209     end.
     1210   end procedure.
