      260   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      263   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      264   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      265   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      266   define variable ptrlprop-autopump      as logical   no-undo initial false .
      267   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      268   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      269   define variable ptrlprop-olddens       as logical   no-undo initial false .
      270   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      271   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      272   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      273   define variable ptrlprop-algoincome as integer no-undo init 0.
      274   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      275   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      276   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      277   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      278   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      279   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      280   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      281   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      282   define variable ptrlprop-block-nozzle as logical no-undo init false.
      283   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      284   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      285   procedure get-ptrl-prop :
      286     define input  parameter p-obj-type as character no-undo .
      287     define input  parameter p-obj-code as integer   no-undo .
      288     do
      289     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      290     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      291     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      292     :
      293       define variable par-type          as character no-undo.
      294       define variable v-value-character as character no-undo .
      295       define variable v-value-date      as date      no-undo .
      296       define variable v-value-decimal   as decimal   no-undo .
      297       define variable v-value-integer   as integer   no-undo .
      298       define variable v-value-logical   as logical   no-undo .
      299       for each thbjattr_thbj-attr
      300       :
      301         delete thbjattr_thbj-attr .
      302       end.
      303       run adm/shattri.p
      304         ( input "get":U
      305         , input p-obj-type
      306         , input p-obj-code
      307         , input 'petrol':U
      308         , input  ""
      309         , output v-value-character
      310         , output v-value-date
      311         , output v-value-decimal
      312         , output v-value-integer
      313         , output v-value-logical
      314         , output par-type
      315         , input-output table thbjattr_thbj-attr
      316         ) no-error .
      317       for each thbjattr_thbj-attr
      318       on error undo, return error return-value
      319       :
      320         case thbjattr_thbj-attr.prop-code :
      321           when 'denstclc':U then do:
      322             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      323               assign
      324                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      325               .
      326             end.
      327           end.
      328           when 'expptrl':U then do:
      329             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      330               and thbjattr_thbj-attr.prop-value-type = 'character':U
      331             then do:
      332               assign
      333                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      334               .
      335             end.
      336           end.
      337           when 'inpptrl':U then do:
      338             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      339               and thbjattr_thbj-attr.prop-value-type = 'character':U
      340             then do:
      341               assign
      342                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      343               .
      344             end.
      345           end.
      346           when 'autopump':U then do:
      347             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      348               assign
      349                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      350               .
      351             end.
      352           end.
      353           when 'rvsnmter':U then do:
      354             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      355               assign
      356                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      357               .
      358             end.
      359           end.
      360           when 'avtinvpm':U then do:
      361             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      362               assign
      363                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      364               .
      365             end.
      366           end.
      367           when 'invclipt':U then do:
      368             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      369               assign
      370                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      371               .
      372             end.
      373           end.
      374           when 'olddens':U then do:
      375             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      376               assign
      377                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      378               .
      379             end.
      380           end.
      381           when 'algrvspt':U then do:
      382             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      383               assign
      384                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      385               .
      386             end.
      387           end.
      388           when 'temp-for-pomi':U then do:
      389             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      390               assign
      391                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      392               .
      393             end.
      394           end.
      395           when 'algoincome':U then do:
      396             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      397               assign
      398                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      399               .
      400             end.
      401           end.
      402           when 'mand-choice-autocar':U then do:
      403             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      404               assign
      405                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      406               .
      407             end.
      408           end.
      409           when 'block-nozzle':U then do:
      410             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      411               assign
      412                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      413               .
      414             end.
      415           end.
      416           when 'timeout-block-nozzle':U then do:
      417             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      418               assign
      419                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      420               .
      421             end.
      422           end.
      423           when 'Delta-mass-horiz':U then do:
      424             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      425               assign
      426                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      427               .
      428             end.
      429           end.
      430           when 'Delta-mass-vert':U then do:
      431             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      432               assign
      433                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      434               .
      435             end.
      436           end.
      437           when 'calc-free-vol':U then do:
      438             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      439               assign
      440                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      441               .
      442             end.
      443           end.
      444           when 'calc-free-vol-sug':U then do:
      445             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      446               assign
      447                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      448               .
      449             end.
      450           end.
      451           when 'trn-reas-sug':U then do:
      452             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      453               assign
      454                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      455               .
      456             end.
      457           end.
      458                 when 'rvd-own-nb':U then do:
      459             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      460               assign
      461                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      462               .
      463             end.
      464           end.
      465           when 'qr-scan-time':U then do:
      466             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      467               assign
      468                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      469               .
      470             end.
      471           end.
      472           when 'autopump-skip-time':U then do:
      473             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      474               assign
      475                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      476               .
      477             end.
      478           end.
      479         end case.
      480         delete thbjattr_thbj-attr .
      481       end.
      482     end.
      483     return .
      484   end procedure.
