     2604           " Норма естественной убыли = " + string(v-normal-wastage) .
     2605         if v-normal-wastage = ? then
     2606         do:
     2607           assign
     2608             K2 = 0.0
     2609             .
     2610         end.
     2611         else
     2612         do:
     2613           assign
     2614             K2 = v-normal-wastage
     2615             .
     2616         end.
     2617         run placelib_get-attr  (
     2618           input "place-error-mass"
     2619           ,input buf_rvs-line.obj-code
     2620           ,input buf_rvs-line.obj-type
