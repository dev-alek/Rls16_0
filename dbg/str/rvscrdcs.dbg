     2710             :
     2711             find first buf_pl-gds no-lock
     2712               where buf_pl-gds.obj-type = buf_rvs-line.obj-type
     2713               and buf_pl-gds.obj-code = buf_rvs-line.obj-code
     2714               and buf_pl-gds.pl-code  = buf_rvs-line.pl-code
     2715               and buf_pl-gds.gds-code = buf_rvs-line.gds-code
     2716               no-error.
     2717             if available buf_pl-gds then
     2718             do:
     2719               assign
     2720                 v-fact-qnty     = buf_pl-gds.fact-qnty
     2721                 v-fact-cli-qnty = buf_pl-gds.cli-fact-qnty
     2722                 .
     2723             end.
     2724             else
     2725             do:
     2726               assign
     2727                 v-fact-qnty     = 0.0
     2728                 v-fact-cli-qnty = 0.0
     2729                 .
     2730             end.
     2731             assign
     2732               v-all-state-measure-qnty = 0.0
     2733               v-all-state-measure-cli-qnty = 0.0
     2734               v-avg-state-density = 0.0
     2735               v-all-state-add-cli-qnty = 0.0
     2736               v-num-tanks = 1
     2737             .
     2738             assign
     2739               O_PKH-base            = v-fact-qnty
     2740               O_FACT-base           = buf_rvs-line.state-measure-qnty + buf_rvs-line.state-add-qnty
     2741               O_PKH-cli             = v-fact-cli-qnty
     2742               O_FACT-cli            = buf_rvs-line.state-measure-cli-qnty + buf_rvs-line.state-add-qnty * buf_rvs-line.state-density
     2743               v-all-state-measure-qnty = buf_rvs-line.state-measure-qnty
     2744               v-all-state-measure-cli-qnty = buf_rvs-line.state-measure-cli-qnty
     2745               v-all-state-add-cli-qnty = buf_rvs-line.state-add-qnty * buf_rvs-line.state-density
     2746               v-avg-state-density   = buf_rvs-line.state-density
     2747               v-metering-qnty-base  = 0.0
     2748               v-metering-qnty-cli   = 0.0
     2749               v-normal-wastage-base = 0.0
     2750               v-normal-wastage-cli  = 0.0
     2751               v-normal-wastage-dens = 1 / buf_goods.cli-base-rate
     2752               v-wastage-qnty-base   = 0.0
     2753               v-wastage-qnty-cli    = 0.0
     2754               v-reserv-qnty-base    = 0.0
     2755               v-reserv-qnty-cli     = 0.0
     2756               v-normal-tp           = 0.0
     2757               v-normal-tp-auto      = 0.0
     2758               v-normal-tp-pl        = 0.0
     2759               .
     2760             logger:StrLogPut =
     2761               " Складское место - " + string(buf_doc-pl.pl-code) + chr(10) +
     2762               "  - Объем расчетно-книжный (л) = " + string(if O_PKH-base <> ? then O_PKH-base else 0) + chr(10) +
     2763               "  - Объем НП, включая трубопровод (л) = " + string(if O_FACT-base <> ? then O_FACT-base else 0) + chr(10) +
     2764               "  - Масса расчетно-книжная (кг) = " + string(if O_PKH-cli <> ? then O_PKH-cli else 0) + chr(10) +
     2765               "  - Масса НП, включая трубопровод (кг) = " + string(if O_FACT-cli <> ? then O_FACT-cli else 0) + chr(10)
     2766               .
     2767             run placelib_get-attr  ( input "place-com-tanks"
     2768               ,input buf_doc-pl.obj-code
