      824   procedure placelib_write-attr:
      825   define input  parameter p-code     like ub.place-attr.attr-code .
      826   define input  parameter p-obj-code like ub.place-attr.obj-code .
      827   define input  parameter p-obj-type like ub.place-attr.obj-type .
      828   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      829   define input  parameter p-value    like ub.place-attr.attr-value .
      830   define output parameter p-ok       as logical.
      831   define buffer buf_place-attr for ub.place-attr .
      832     do on error undo, return error return-value :
      833        p-ok = false.
      834        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      835                                                   and buf_place-attr.obj-code    = p-obj-code
      836                                                   and buf_place-attr.obj-type    = p-obj-type
      837                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      838        if not available buf_place-attr then do :
      839           create buf_place-attr.
      840           assign
      841             buf_place-attr.attr-code   = p-code
      842             buf_place-attr.attr-value  = p-value
      843             buf_place-attr.obj-code    = p-obj-code
      844             buf_place-attr.obj-type    = p-obj-type
      845             buf_place-attr.pl-code     = p-pl-code
      846           .
      847           p-ok = true.
      848        end.
      849        else do:
      850           buf_place-attr.attr-value  = p-value .
      851           p-ok = true.
      852        end.
      853     end.
      854   end.
      855   procedure placelib_get-attr:
      856   define input  parameter  p-code     like ub.place-attr.attr-code .
      857   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      858   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      859   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      860   define output parameter  p-value    like ub.place-attr.attr-value .
      861   define output parameter  p-ok       as logical.
      862   define buffer buf_place-attr for ub.place-attr .
      863     do on error undo, return error return-value :
      864        p-ok = false.
      865        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      866                                                   and buf_place-attr.obj-code    = p-obj-code
      867                                                   and buf_place-attr.obj-type    = p-obj-type
      868                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      869        if available buf_place-attr then do :
      870          p-value = buf_place-attr.attr-value.
      871          p-ok = true.
      872        end.
      873        else do :
      874          p-ok = false.
      875        end.
      876     end.
      877   end.
      878   procedure placelib_del-attr:
      879   define input parameter  p-code     like ub.place-attr.attr-code .
      880   define input parameter  p-obj-code like ub.place-attr.obj-code .
      881   define input parameter  p-obj-type like ub.place-attr.obj-type .
      882   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      883   define input parameter  p-value    like ub.place-attr.attr-value .
      884   define output parameter p-ok       as logical.
      885   define buffer buf_place-attr for ub.place-attr .
      886     do on error undo, return error return-value :
      887        p-ok = false.
      888        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      889                                                   and buf_place-attr.obj-code    = p-obj-code
      890                                                   and buf_place-attr.obj-type    = p-obj-type
      891                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      892        if available buf_place-attr then do :
      893           delete buf_place-attr.
      894           p-ok = true.
      895        end.
      896     end.
      897   end.
