     4268   PROCEDURE init-attr-general :
     4269   do on error undo, return error return-value :
     4270   run cr-tt-upd .
     4271   define variable varexist                  as logical   no-undo.
     4272     run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-prikaz-number':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4273   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-prikaz-date':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4274   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-inv-date':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4275   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-fio-agent':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4276   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-pos-agent':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4277   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-fio-player1':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4278   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-pos-player1':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4279   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-fio-player2':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4280   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-pos-player2':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4281   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-fio-player3':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4282   run create-record in this-procedure (  input v-inv-code                                                         ,  input 'trdcattr-pos-player3':U                                                         ,  input  ""                                                         , output varexist ) no-error.
     4283   end.
     4284   END PROCEDURE.
