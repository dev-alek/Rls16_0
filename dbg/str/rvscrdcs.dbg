     2502         if error-status :error then
     2503         do:
     2504           message
     2505             return-value skip
     2506             error-status :get-message( 1 )
     2507             view-as alert-box.
     2508           undo block_cre-inv, retry block_cre-inv .
     2509         end.
     2510         logger:StrLogPut =
     2511           "Конфигурационный параметр: " + chr(10) +
     2512           " - Определение работы с фактическим количеством бензина во внешнем приходе: " + stfactplvalue + chr(10).
     2513         if varrevision = yes then
     2514         do:
     2515           assign
     2516             K1 = varpercrev.
     2517         end.
     2518         if varauto-tank = yes then
     2519         do:
     2520           assign
     2521             K1 = varpercauto.
     2522         end.
     2523         if varinv = yes then
     2524         do:
     2525           assign
     2526             K1 = varpercinv.
     2527         end.
     2528       end.
     2529       if K1 = ? then
     2530       do:
     2531         assign
     2532           K1 = 0.0
     2533           .
     2534       end.
     2535       define variable K1-all as decimal no-undo.
     2536       K1-all = K1.
     2537       for each buf_doc-line exclusive-lock
     2538         where buf_doc-line.doc-code = v-inv-code
     2539         ,first buf_inv-line exclusive-lock
     2540         where buf_inv-line.doc-code  = buf_doc-line.doc-code
     2541         and buf_inv-line.artic     = buf_doc-line.artic
     2542         and buf_inv-line.prod-type = buf_doc-line.prod-type
     2543         and buf_inv-line.prod-code = buf_doc-line.prod-code
