       10   define variable vss-revision    as character no-undo init "$Revision: 94114751b278, 3560, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       12   define variable vss-date        as character no-undo init "$Date: 2023/11/27 08:31:19 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: rvscrdcs.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: str/rvscrdcs.p $":U .
