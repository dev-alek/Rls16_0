     1999     run mainmenu_getcntxt in parparentproc
     2000       (output v-cntxt-db-num
     2001       ,output v-cntxt-userid
     2002       ,output v-cntxt-level
     2003       ,output v-cntxt-host-code-obj
     2004       ,output v-cntxt-obj-type
     2005       ,output v-cntxt-obj-code
     2006       ,output v-cntxt-db-num-obj
     2007       ,output v-cntxt-is-admin
     2008       ) .
     2009     find first buf_rvs-doc
     2010       where rowid( buf_rvs-doc ) = p-rvs-rowid
     2011       .
     2012     if v-cntxt-obj-type <> buf_rvs-doc.obj-type
     2013       or v-cntxt-obj-code <> buf_rvs-doc.obj-code
     2014       then
     2015     do:
     2016       message
     2017         vss-workfile vss-revision vss-description skip
     2018         substitute("Сверка &1 резервуаров на объекте &2 &3", buf_rvs-doc.rvs-code, buf_rvs-doc.obj-type, buf_rvs-doc.obj-code ) skip
     2019         substitute("На текущем объекте нельзя создать инвентаризацию по данной сверке." ) skip
     2020         view-as alert-box error .
     2021       return error .
     2022     end.
     2023     logger:Path = "log-rvsinv.log".
     2024     logger:StrLogPut =
     2025       chr(10) +
     2026       "-----------------------------------------------" + chr(10) +
     2027       string (now) + chr(10).
     2028     assign
     2029       v-log = no
     2030       .
     2031     message
     2032       "Вы хотите сделать инвентаризацию по сверке?"    skip
     2033       "ДА     - по всем товарам из сверки"             skip
     2034       "НЕТ    - не делать инвентаризацию"              skip
     2035       "ОТМЕНА - опционально по товарам и резервуарам"
     2036       view-as alert-box buttons yes-no-cancel update v-log.
     2037     if v-log = no then
     2038     do:
     2039       return no-apply.
     2040     end.
     2041     assign
     2042       chs-gds-inv = v-log
     2043       p-docs-info = "":U
     2044       .
     2045     RUN gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-value, output rdc-type) no-error .
     2046     v-input-type-err-msg = "" .
     2047     if chs-gds-inv
     2048       and rdc-value = "pomi-rn"
     2049       then
     2050     do :
     2051       for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code,
     2052         first buf_place no-lock where buf_place.obj-type = buf_rvs-doc.obj-type
     2053         and buf_place.obj-code = buf_rvs-doc.obj-code
     2054         and buf_place.pl-code = buf_rvs-line.pl-code,
     2055         first buf_goods no-lock where buf_goods.gds-code = buf_rvs-line.gds-code :
     2056         if is-sug(buf_goods.gds-code)
     2057           or is-gas(buf_goods.gds-code)
     2058           then next .
     2059         assign
     2060           v-input-type-p = ""
