     2963                       then
     2964                     do:
     2965                       find first bf-prev_trn-doc no-lock where bf-prev_trn-doc.doc-code = bf-prev_doc-line.doc-code.
     2966                       oNormWast:ParGdsOAttr:ToInvDate = buf_rvs-doc.fact-date.
     2967                       oNormWast:ParGdsOAttr:FromInvDate =  if bf-prev_trn-doc.fact-date <> ? then bf-prev_trn-doc.fact-date else bf-prev_trn-doc.doc-date.
     2968                       oNormWast:ParGdsOAttr:FromInvFQKg = bf-prev_doc-pl.cli-rest-af-qnty.
     2969                       oNormWast:ParGdsOAttr:PlCode = buf_rvs-line.pl-code.
     2970                       oNormWast:FillNormWast().
     2971                     end.
     2972                     logger:StrLogPut =
     2973                       "Алгоритм " + string(ptrlprop-algrvspt) + chr(10) +
     2974                       "Естественная убыль - " + string(oNormWast:IsDecommissioned) + chr(10)
     2975                       .
     2976                   end.
     2977                   else
     2978                   do:
     2979                     assign
     2980                       varfact-order-prev-inv = 0
     2981                       .
     2982                   end.
     2983                   if ptrlprop-algrvspt = 3
     2984                     then
     2985                   do:
     2986                     logger:StrLogPut =
     2987                       "Технологические потери по документам ПН в межинвентаризационный период (если есть)" +
     2988                       "Объект: " + buf_rvs-line.obj-type + string (buf_rvs-line.obj-code) + chr(10) +
     2989                       "Товар: " + string (buf_goods.gds-code) + " - " + buf_goods.gds-name
     2990                       .
     2991                     for each bf-wst_doc-line no-lock
     2992                       where ( bf-wst_doc-line.obj-type         = buf_doc-line.obj-type
     2993                       and bf-wst_doc-line.obj-code     = buf_doc-line.obj-code
     2994                       and bf-wst_doc-line.prod-type    = buf_doc-line.prod-type
     2995                       and bf-wst_doc-line.prod-code    = buf_doc-line.prod-code
     2996                       and bf-wst_doc-line.artic        = buf_doc-line.artic
     2997                       and
     2998                       (
     2999                       (bf-wst_doc-line.ext-doc-type <> 'vt':U and bf-wst_doc-line.ext-doc-type <> 'vp':U and oNormWast:IsDecommissioned)
     3000                       or
     3001                       (bf-wst_doc-line.ext-doc-type = 'ie':U and not oNormWast:IsDecommissioned)
     3002                       )
     3003                       and bf-wst_doc-line.status_      = 'факт':U
     3004                       and bf-wst_doc-line.fact-order   > varfact-order-prev-inv
     3005                       )
     3006                       on error undo block_cre-inv, retry block_cre-inv
     3007                       :
     3008                       if oNormWast:IsDecommissioned
     3009                         then
     3010                       do:
     3011                         find first bf-wst_trn-doc no-lock where bf-wst_trn-doc.doc-code = bf-wst_doc-line.doc-code.
