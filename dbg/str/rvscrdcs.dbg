     2666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsdtlcr in g#library
     2667     (input  buf_gds-prt.node-code
     2668     ,buffer buf_doc-line
     2669     ,buffer buf_gds-dtl
     2670     ) no-error .
     2671           if error-status :error then
     2672           do:
     2673             undo block_cre-inv, retry block_cre-inv.
     2674           end.
     2675           find first buf_prt-obj no-lock
     2676             where buf_prt-obj.prt-code  = buf_gds-prt.node-code
     2677             and buf_prt-obj.prod-code = buf_goods.prod-code
     2678             and buf_prt-obj.prod-type = buf_goods.prod-type
     2679             and buf_prt-obj.artic     = buf_goods.artic
     2680             and buf_prt-obj.obj-code  = buf_trn-doc.obj-code
     2681             and buf_prt-obj.obj-type  = buf_trn-doc.obj-type
     2682             no-error.
     2683           assign
     2684             buf_gds-dtl.doc-qnty  = 0
     2685             buf_gds-dtl.fact-qnty = ( if available buf_prt-obj then buf_prt-obj.fact-qnty else 0 )
     2686             .
     2687           if buf_doc-line.doc-qnty <> buf_gds-dtl.fact-qnty then
     2688           do:
     2689             message
     2690               "ОШИБКА" skip
     2691               "Кол-во товара по строке : " buf_goods.artic " " buf_goods.prod-type " " buf_goods.prod-code " " buf_goods.gds-name skip
     2692               "на объекте: " buf_trn-doc.obj-type " " buf_trn-doc.obj-code " , равное " buf_doc-line.doc-qnty skip
     2693               " не совпадает с кол-ом по корневому признаку, равном " buf_gds-dtl.fact-qnty "." skip
     2694               view-as alert-box error.
     2695             undo block_cre-inv, retry block_cre-inv.
     2696           end.
     2697           block_doc-pl:
     2698           for each buf_doc-pl exclusive-lock
     2699             where buf_doc-pl.out-code = v-inv-code
     2700             and buf_doc-pl.gds-code = buf_goods.gds-code
     2701             and buf_doc-pl.obj-type = buf_trn-doc.obj-type
     2702             and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     2703             ,each buf_rvs-line no-lock
     2704             where buf_rvs-line.gds-code = buf_doc-pl.gds-code
     2705             and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2706             and buf_rvs-line.obj-type = buf_doc-pl.obj-type
     2707             and buf_rvs-line.obj-code = buf_doc-pl.obj-code
     2708             and buf_rvs-line.pl-code  = buf_doc-pl.pl-code
