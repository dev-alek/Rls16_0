     2799                       O_FACT-cli  = O_FACT-cli + (com_rvs-line.state-measure-cli-qnty + com_rvs-line.state-add-qnty * com_rvs-line.state-density)
     2800                       v-all-state-measure-qnty      = v-all-state-measure-qnty + com_rvs-line.state-measure-qnty
     2801                       v-all-state-measure-cli-qnty  = v-all-state-measure-cli-qnty + com_rvs-line.state-measure-cli-qnty
