     3016                           and bf-wst_doc-pl.out-code = bf-wst_doc-line.doc-code
     3017                           and bf-wst_doc-pl.gds-code = buf_rvs-line.gds-code
     3018                           no-error.
     3019                         if available (bf-wst_doc-pl)
     3020                           then
     3021                         do:
     3022                           if bf-wst_trn-doc.doc-type = 'при':U
     3023                             then oNormWast:NormalWastageHdnler:RegDoc(bf-wst_trn-doc.fact-date, bf-wst_doc-pl.cli-fact-qnty).
     3024                           else oNormWast:NormalWastageHdnler:RegDoc(bf-wst_trn-doc.fact-date, - bf-wst_doc-pl.cli-fact-qnty).
     3025                         end.
     3026                       end.
     3027                       if  bf-wst_doc-line.ext-doc-type = 'ie':U
     3028                         then
     3029                       do:
     3030                         InfoSecsObj = new InfoSectionsTotal ().
     3031                         find first ub.place no-lock where ub.place.pl-code = buf_rvs-line.pl-code
     3032                           and ub.place.obj-code = buf_rvs-line.obj-code and ub.place.obj-type = buf_rvs-line.obj-type no-error.
     3033                         def var listSecLoc as char no-undo.
     3034                         if available (ub.place)
     3035                           then
     3036                         do:
     3037                           InfoSecsObj:Initialization(bf-wst_doc-line.doc-code, buf_goods.gds-code).
     3038                           InfoSecsObj:GetDBAllAttr().
     3039                           InfoSecsObj:CalculateTotal().
     3040                           listSecLoc = InfoSecsObj:GetInfoSectionProp(ub.place.loc1).
     3041                           if listSecLoc <> ""
     3042                             then
     3043                           do:
     3044                             do ii = 1 to num-entries (listSecLoc, chr(4)):
     3045                               InfoSecsObj:GetInfoSectionProp(integer (entry (ii, listSecLoc, chr(4) ))).
     3046                               logger:StrLogPut =
     3047                                 "Номер ПН: " + bf-wst_doc-line.doc-code + chr(10) +
     3048                                 "Место хранения:" + string (ub.place.pl-code) + " - " + ub.place.pl-name + chr(10) +
     3049                                 "Потери при сливе в резервуар: " + string (InfoSecsObj:InfoSectionCurr:TPNormPL) + chr(10) +
     3050                                 "Потери при сливе из АЦ: " + string (InfoSecsObj:InfoSectionCurr:TPNormAuto) + chr(10) +
     3051                                 "Сумма технолог. потерь: " + string (InfoSecsObj:InfoSectionCurr:TPNorm) + chr(10)
     3052                                 .
     3053                               v-normal-tp = v-normal-tp + InfoSecsObj:InfoSectionCurr:TPNorm.
     3054                               v-normal-tp-auto = v-normal-tp-auto + round (InfoSecsObj:InfoSectionCurr:TPNormAuto, 0).
     3055                               v-normal-tp-pl = v-normal-tp-pl + round (InfoSecsObj:InfoSectionCurr:TPNormPL, 0).
     3056                             end.
     3057                           end.
     3058                         end.
     3059                       end.
     3060                     end.
     3061                     if oNormWast:IsDecommissioned
     3062                       then
     3063                     do:
     3064                       oNormWast:CalcWastNorm().
     3065                       logger:StrLogPut =
     3066                         "Норма естественной убыли хранения " + string (oNormWast:NormWastDays)
     3067                         .
     3068                     end.
     3069                   end.
     3070                   else
     3071                   do:
     3072                     for each bf-wst_doc-line no-lock
     3073                       where ( bf-wst_doc-line.obj-type         = buf_doc-line.obj-type
     3074                       and bf-wst_doc-line.obj-code     = buf_doc-line.obj-code
     3075                       and bf-wst_doc-line.prod-type    = buf_doc-line.prod-type
     3076                       and bf-wst_doc-line.prod-code    = buf_doc-line.prod-code
     3077                       and bf-wst_doc-line.artic        = buf_doc-line.artic
     3078                       and bf-wst_doc-line.ext-doc-type = 'ie':U
     3079                       and bf-wst_doc-line.status_      = 'факт':U
     3080                       and bf-wst_doc-line.fact-order   > varfact-order-prev-inv
     3081                       and (not can-find (first buf_sale-doc
     3082                       where buf_sale-doc.doc-code = bf-wst_doc-line.doc-code
     3083                       and buf_sale-doc.doc-kind = 'itr':U))
     3084                       )
     3085                       or
     3086                       ( bf-wst_doc-line.obj-type         = buf_doc-line.obj-type
     3087                       and bf-wst_doc-line.obj-code     = buf_doc-line.obj-code
     3088                       and bf-wst_doc-line.prod-type    = buf_doc-line.prod-type
     3089                       and bf-wst_doc-line.prod-code    = buf_doc-line.prod-code
     3090                       and bf-wst_doc-line.artic        = buf_doc-line.artic
     3091                       and bf-wst_doc-line.ext-doc-type = 'ep':U
     3092                       and bf-wst_doc-line.status_      = 'факт':U
     3093                       and bf-wst_doc-line.fact-order   > varfact-order-prev-inv
     3094                       )
     3095                       on error undo block_cre-inv, retry block_cre-inv
     3096                       :
     3097                       find first bf-wst_doc-pl no-lock
     3098                         where bf-wst_doc-pl.obj-type = bf-wst_doc-line.obj-type
     3099                         and bf-wst_doc-pl.obj-code = bf-wst_doc-line.obj-code
     3100                         and bf-wst_doc-pl.pl-code  = buf_rvs-line.pl-code
     3101                         and bf-wst_doc-pl.out-code = bf-wst_doc-line.doc-code
     3102                         and bf-wst_doc-pl.gds-code = buf_rvs-line.gds-code
     3103                         no-error.
     3104                       if available bf-wst_doc-pl then
     3105                       do:
     3106                         assign
     3107                           WST-base = WST-base + (if bf-wst_doc-line.ext-doc-type = 'ie':U then bf-wst_doc-pl.fact-qnty else - bf-wst_doc-pl.fact-qnty)
     3108                           WST-cli  = WST-cli + (if bf-wst_doc-line.ext-doc-type = 'ie':U then bf-wst_doc-pl.cli-fact-qnty else - bf-wst_doc-pl.cli-fact-qnty )
     3109                           .
     3110                       end.
     3111                     end.
     3112                   end.
     3113                   assign
     3114                     v-normal-wastage-base = WST-base * K2 / 1000
     3115                     v-normal-wastage-cli  = WST-cli  * K2 / 1000
     3116                     v-normal-wastage-dens = WST-cli / WST-base
     3117                     .
     3118                   logger:StrLogPut =
     3119                     "Норма естественной убыли" + chr(10) +
     3120                     "в килограммах: " + string(if v-normal-wastage-cli <> ? then v-normal-wastage-cli else 0) + chr(10) +
     3121                     "в литрах: " + string(if v-normal-wastage-base <> ? then v-normal-wastage-base else 0) + chr(10) +
     3122                     "плотность: " + string(if v-normal-wastage-dens <> ? then v-normal-wastage-dens else 0) + chr(10)
     3123                     .
     3124                 end.
     3125                 if ptrlprop-expptrl = 'weight':U then
     3126                 do:
     3127                   if v-normal-wastage-cli <= 0.0 then
     3128                   do:
     3129                     assign
     3130                       v-normal-wastage-base = 0.0
     3131                       v-normal-wastage-cli  = 0.0
     3132                       .
     3133                   end.
     3134                   else
     3135                   do:
     3136                     if v-normal-wastage-cli > (O_PKH-cli - O_FACT-cli) then
     3137                     do:
     3138                       assign
     3139                         v-normal-wastage-cli  = (O_PKH-cli - O_FACT-cli)
     3140                         v-normal-wastage-base = v-normal-wastage-cli / v-normal-wastage-dens
     3141                         .
     3142                     end.
     3143                   end.
     3144                   assign
     3145                     v-normal-wastage = v-normal-wastage-cli
     3146                     .
     3147                 end.
     3148                 else
     3149                 do:
     3150                   if v-normal-wastage-base <= 0.0 then
     3151                   do:
     3152                     assign
     3153                       v-normal-wastage-base = 0.0
     3154                       v-normal-wastage-cli  = 0.0
     3155                       .
     3156                   end.
     3157                   else
     3158                   do:
     3159                     if v-normal-wastage-base > (O_PKH-base - O_FACT-base) then
     3160                     do:
     3161                       assign
     3162                         v-normal-wastage-base = (O_PKH-base - O_FACT-base)
     3163                         v-normal-wastage-cli  = v-normal-wastage-base * v-normal-wastage-dens
     3164                         .
     3165                     end.
     3166                   end.
     3167                   assign
     3168                     v-normal-wastage = v-normal-wastage-base
     3169                     .
     3170                 end.
     3171                 assign
     3172                   v-wastage-qnty-base = v-normal-wastage-base
     3173                   v-wastage-qnty-cli  = v-normal-wastage-cli
     3174                   .
     3175                 case ptrlprop-algrvspt :
     3176                   when 1 then
     3177                     do:
     3178                       if (O_PKH - O_FACT) - v-metering-error - v-normal-wastage <= 0 then
     3179                       do:
     3180                         logger:StrLogPut =
     3181                           "Все укладывается в погрешность " + string(if v-metering-error <> ? then v-metering-error else 0) + " + естественную убыль: "
     3182                           +  string(if v-normal-wastage <> ? then v-normal-wastage else 0) + chr(10) .
     3183                         .
     3184                         assign
     3185                           v-rsrv-qnty          = 0.0
     3186                           v-metering-qnty-base = v-metering-error-base
     3187                           v-metering-qnty-cli  = v-metering-error-cli
     3188                           .
     3189                         if v-normal-wastage > 0 then
     3190                         do:
     3191                           if (O_PKH - O_FACT) - v-metering-error > 0 then
     3192                           do:
     3193                             logger:StrLogPut =
     3194                               "В погрешность не укладывается, поэтому учитываем естественную убыль " +  string(if v-normal-wastage <> ? then v-normal-wastage else 0) + chr(10) .
     3195                             .
     3196                             if v-normal-wastage > (O_PKH - O_FACT) - v-metering-error then
     3197                             do:
     3198                               logger:StrLogPut =
     3199                                 "Уменьшим естественную убыль, чтобы дельта РКН и ФАКТ была равна погрешности измерения " + chr(10) .
     3200                               if ptrlprop-expptrl = 'weight':U then
     3201                               do:
     3202                                 assign
     3203                                   v-normal-wastage-cli  = (O_PKH-cli - O_FACT-cli) - v-metering-error-cli
     3204                                   v-normal-wastage-base = v-normal-wastage-cli / v-normal-wastage-dens
     3205                                   .
     3206                                 logger:StrLogPut =
     3207                                   "Естественная убыль: " + string(if v-normal-wastage-cli <> ? then v-normal-wastage-cli else 0) + " "
     3208                                   + string(if v-normal-wastage-base <> ? then v-normal-wastage-base else 0) + chr(10) .
     3209                               end.
     3210                               else
     3211                               do:
     3212                                 assign
     3213                                   v-normal-wastage-base = (O_PKH-base - O_FACT-base) - v-metering-error-base
     3214                                   v-normal-wastage-cli  = v-normal-wastage-base * v-normal-wastage-dens
     3215                                   .
     3216                                 logger:StrLogPut =
     3217                                   "Естественная убыль: " + string(if v-normal-wastage-cli <> ? then v-normal-wastage-cli else 0) + " "
     3218                                   + string(if v-normal-wastage-base <> ? then v-normal-wastage-base else 0) + chr(10) .
     3219                               end.
     3220                             end.
     3221                           end.
     3222                           else
     3223                           do:
     3224                             logger:StrLogPut =
     3225                               "Все укладывается в погрешность" + chr(10) .
     3226                             assign
     3227                               v-normal-wastage-cli  = 0.0
     3228                               v-normal-wastage-base = 0.0
     3229                               .
