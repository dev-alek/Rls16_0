     2856             if not v-lgas-gds
     2857               and not is-gas(buf_goods.gds-code)
     2858               and not ptrlprop-algrvspt = 4
     2859               then
     2860             do:
     2861               if (O_PKH - O_FACT) <= 0  then
     2862               do:
     2863                 logger:StrLogPut =
     2864                   "Излишки" + chr(10)
     2865                   .
     2866                 if (O_FACT - O_PKH) - v-metering-error <= 0 then
     2867                 do:
     2868                   assign
     2869                     v-rsrv-qnty          = 0
     2870                     v-metering-qnty-base = v-metering-error-base
     2871                     v-metering-qnty-cli  = v-metering-error-cli
     2872                     .
     2873                   logger:StrLogPut =
     2874                     "Все укладывается в погрешность " + string(if v-metering-error <> ? then v-metering-error else 0) + chr(10) +
     2875                     "погрешность в кг   " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     2876                     "погрешность в литрах   " + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10).
     2877                   case ptrlprop-algrvspt :
     2878                     when 1 then
     2879                       do:
     2880                       end.
     2881                     when 2 then
     2882                       do:
     2883                         if v-metering-error > (O_FACT - O_PKH) then
     2884                         do:
     2885                           if ptrlprop-expptrl = 'weight':U then
     2886                           do:
     2887                             assign
     2888                               v-metering-error-cli  = (O_FACT-cli - O_PKH-cli)
     2889                               v-metering-error-base = v-metering-error-cli / v-metering-error-dens
     2890                               .
     2891                             logger:StrLogPut =
     2892                               "Алгоритм №2 для литров" + chr(10) +
     2893                               "погрешность в кг   " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     2894                               "погрешность в литрах   " + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10) .
     2895                           end.
     2896                           else
     2897                           do:
     2898                             assign
     2899                               v-metering-error-base = (O_FACT-base - O_PKH-base)
     2900                               v-metering-error-cli  = v-metering-error-base * v-metering-error-dens
     2901                               .
     2902                             logger:StrLogPut =
     2903                               "Алгоритм №2 для кг" + chr(10) +
     2904                               "погрешность в кг   " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     2905                               "погрешность в литрах   " + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10) .
     2906                           end.
     2907                         end.
     2908                       end.
     2909                     when 4 then
     2910                       do:
     2911                       end.
     2912                   end case.
     2913                 end.
     2914                 else
     2915                 do:
     2916                   assign
     2917                     v-rsrv-qnty          = (O_FACT - O_PKH) - (if v-without-mt-err = true then 0 else v-metering-error)
     2918                     v-metering-qnty-base = (if v-without-mt-err = true then 0 else v-metering-error-base)
     2919                     v-metering-qnty-cli  = (if v-without-mt-err = true then 0 else v-metering-error-cli )
     2920                     .
     2921                   logger:StrLogPut =
     2922                     "В погрешность не укладывается, пересчитываем по алгоритму" + chr(10) +
     2923                     "кол-во   " + string(if v-rsrv-qnty <> ? then v-rsrv-qnty else 0) + chr(10) +
     2924                     "погрешность в кг   " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     2925                     "погрешность в литрах   " + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10) .
     2926                 end.
     2927               end.
     2928               else
     2929               do:
     2930                 if K2 <> 0 then
     2931                 do:
     2932                   assign
     2933                     WST-base = 0.0
     2934                     WST-cli  = 0.0
     2935                     .
     2936                   logger:StrLogPut =
     2937                     "Недостача" + chr(10) +
     2938                     "Ищем предыдущую инвентарзацию" + chr(10)
     2939                     .
     2940                   find last bf-prev_doc-line no-lock
     2941                     where bf-prev_doc-line.obj-type     = buf_doc-line.obj-type
     2942                     and bf-prev_doc-line.obj-code     = buf_doc-line.obj-code
     2943                     and bf-prev_doc-line.prod-type    = buf_doc-line.prod-type
     2944                     and bf-prev_doc-line.prod-code    = buf_doc-line.prod-code
     2945                     and bf-prev_doc-line.artic        = buf_doc-line.artic
     2946                     and bf-prev_doc-line.ext-doc-type = 'vt':U
     2947                     and bf-prev_doc-line.status_      = 'факт':U
     2948                     use-index dt-fo
     2949                     no-error.
     2950                   if available bf-prev_doc-line then
     2951                   do:
     2952                     assign
     2953                       varfact-order-prev-inv = bf-prev_doc-line.fact-order
     2954                       .
     2955                     find first bf-prev_doc-pl no-lock
     2956                       where bf-prev_doc-pl.obj-type = bf-prev_doc-line.obj-type
     2957                       and bf-prev_doc-pl.obj-code = bf-prev_doc-line.obj-code
     2958                       and bf-prev_doc-pl.pl-code  = buf_rvs-line.pl-code
     2959                       and bf-prev_doc-pl.out-code = bf-prev_doc-line.doc-code
     2960                       and bf-prev_doc-pl.gds-code = buf_rvs-line.gds-code
     2961                       no-error.
