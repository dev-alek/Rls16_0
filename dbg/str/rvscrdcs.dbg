     3235                         logger:StrLogPut =
     3236                           "В погрешность не укладывается, пересчитываем по алгоритму" .
     3237                         assign
     3238                           v-rsrv-qnty          = - ( (O_PKH - O_FACT)
     3239                                                     - (if v-cre-add-docs   = true then v-normal-wastage else 0.0)
     3240                                                     - (if v-without-mt-err = true then 0.0 else v-metering-error)
     3241                                                   )
     3242                           v-metering-qnty-base = (if v-without-mt-err = true then 0 else v-metering-error-base)
     3243                           v-metering-qnty-cli  = (if v-without-mt-err = true then 0 else v-metering-error-cli )
     3244                           .
     3245                         logger:StrLogPut =
     3246                           "Кол-во: v-rsrv-qnty " + string(if v-rsrv-qnty <> ? then v-rsrv-qnty else 0) + chr(10) +
     3247                           "Погрешность v-metering-qnty-base " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     3248                           "Погрешность v-metering-qnty-cli" + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10)
     3249                           .
     3250                       end.
     3251                     end.
     3252                   when 2 then
     3253                     do:
     3254                       if v-normal-wastage = (O_PKH - O_FACT) then
     3255                       do:
     3256                         assign
     3257                           v-rsrv-qnty          = - ( (O_PKH - O_FACT)
     3258                                           - (if v-cre-add-docs = true then v-normal-wastage else 0.0)
     3259                                         )
     3260                           v-metering-qnty-base = 0.0
     3261                           v-metering-qnty-cli  = 0.0
     3262                           .
     3263                         logger:StrLogPut =
     3264                           "Естественная убыль покрыла разницу" + string(if v-normal-wastage <> ? then v-normal-wastage else 0) + chr(10) +
     3265                           "Кол-во: v-rsrv-qnty " + string(if v-rsrv-qnty <> ? then v-rsrv-qnty else 0) + chr(10) +
     3266                           "Погрешность v-metering-qnty-base " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     3267                           "Погрешность v-metering-qnty-cli " + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10)
     3268                           .
     3269                       end.
     3270                       else
     3271                       do:
     3272                         if (O_PKH - O_FACT) - v-metering-error - v-normal-wastage <= 0 then
     3273                         do:
     3274                           logger:StrLogPut =
     3275                             "Все укладывается в погрешность " + string(if v-metering-error <> ? then v-metering-error else 0) + " + естественную убыль: " +
     3276                             string(if v-normal-wastage <> ? then v-normal-wastage else 0) + chr(10) .
     3277                           if v-metering-error > (O_PKH - O_FACT) - v-normal-wastage  then
     3278                           do:
     3279                             if ptrlprop-expptrl = 'weight':U then
     3280                             do:
     3281                               assign
     3282                                 v-metering-error-cli  = (O_PKH-cli - O_FACT-cli) - v-normal-wastage-cli
     3283                                 v-metering-error-base = v-metering-error-cli / v-metering-error-dens
     3284                                 v-metering-error      = v-metering-error-cli
     3285                                 .
     3286                             end.
     3287                             else
     3288                             do:
     3289                               assign
     3290                                 v-metering-error-base = (O_PKH-base - O_FACT-base) - v-normal-wastage-base
     3291                                 v-metering-error-cli  = v-metering-error-base * v-metering-error-dens
     3292                                 v-metering-error      = v-metering-error-base
     3293                                 .
     3294                             end.
     3295                             logger:StrLogPut =
     3296                               "уменьшим погрешность измерения, чтобы она была не больше дельты РКН и ФАКТ с учетом ЕУ" + chr(10) +
     3297                               "Погрешность v-metering-error-base " + string(if v-metering-error-base <> ? then v-metering-error-base else 0) + chr(10) +
     3298                               "Погрешность v-metering-error-cli " + string(if v-metering-error-cli <> ? then v-metering-error-cli else 0) + chr(10) +
     3299                               "Погрешность v-metering-error " + string(if v-metering-error <> ? then v-metering-error else 0) + chr(10)
     3300                               .
     3301                           end.
     3302                           assign
     3303                             v-rsrv-qnty          = - ( (O_PKH - O_FACT)
     3304                                             - (if v-cre-add-docs = true then v-normal-wastage else 0.0)
     3305                                             - v-metering-error
     3306                                           )
     3307                             v-metering-qnty-base = v-metering-error-base
     3308                             v-metering-qnty-cli  = v-metering-error-cli
     3309                             .
     3310                           logger:StrLogPut =
     3311                             "Кол-во: v-rsrv-qnty " + string(if v-rsrv-qnty <> ? then v-rsrv-qnty else 0) + chr(10) +
     3312                             "Погрешность v-metering-qnty-base " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     3313                             "Погрешность v-metering-qnty-cli" + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10)
     3314                             .
     3315                         end.
     3316                         else
     3317                         do:
     3318                           assign
     3319                             v-rsrv-qnty          = - ( (O_PKH - O_FACT)
     3320                                                       - (if v-cre-add-docs   = true then v-normal-wastage else 0.0)
     3321                                                       - (if v-without-mt-err = true then 0.0 else v-metering-error)
     3322                                                     )
     3323                             v-metering-qnty-base = (if v-without-mt-err = true then 0 else v-metering-error-base)
     3324                             v-metering-qnty-cli  = (if v-without-mt-err = true then 0 else v-metering-error-cli )
     3325                             .
     3326                           logger:StrLogPut =
     3327                             "в погрешность не укладывается, пересчитываем по алгоритму " + chr(10) +
     3328                             "Кол-во: v-rsrv-qnty " + string(if v-rsrv-qnty <> ? then v-rsrv-qnty else 0) + chr(10) +
     3329                             "Погрешность v-metering-qnty-base " + string(if v-metering-qnty-base <> ? then v-metering-qnty-base else 0) + chr(10) +
     3330                             "Погрешность v-metering-qnty-cli" + string(if v-metering-qnty-cli <> ? then v-metering-qnty-cli else 0) + chr(10)
     3331                             .
     3332                         end.
     3333                       end.
     3334                     end.
     3335                   when 2 then
     3336                     do:
     3337                     end.
     3338                 end case.
     3339                 if v-cre-add-docs   = true
     3340                   and v-normal-wastage-base <> 0.0
     3341                   and v-normal-wastage-cli <> 0.0
     3342                   then
     3343                 do:
     3344                   create tt-line-for-doc.
     3345                   assign
     3346                     tt-line-for-doc.gds-code      = buf_rvs-line.gds-code
     3347                     tt-line-for-doc.pl-code       = buf_rvs-line.pl-code
     3348                     tt-line-for-doc.fact-qnty     = v-normal-wastage-base
     3349                     tt-line-for-doc.fact-cli-qnty = v-normal-wastage-cli
     3350                     .
     3351                 end.
     3352               end.
     3353               if ptrlprop-algrvspt = 3
     3354                 then
     3355               do:
     3356                 rvsinvsubObj = new rvsinvsub ().
     3357                 rvsinvsubObj:RvsCode  = buf_rvs-line.rvs-code.
     3358                 rvsinvsubObj:ObjType  = buf_rvs-line.obj-type.
     3359                 rvsinvsubObj:ObjCode  = buf_rvs-line.obj-code.
     3360                 rvsinvsubObj:PlCode   = buf_rvs-line.pl-code.
     3361                 rvsinvsubObj:GdsCode  = buf_rvs-line.gds-code.
     3362                 MKN = O_PKH-cli.
     3363                 MFO = O_FACT-cli.
     3364                 MFOR = v-all-state-measure-cli-qnty.
     3365                 MFOT = v-all-state-add-cli-qnty.
     3366                 beta1 = K1.
     3367                 beta2 = K3.
     3368                 dMMBd = (beta1 * MFOR + beta2 * MFOT) / 100.
     3369                 rvsinvsubObj:Diff = MFO - MKN.
     3370                 dM = MFO - MKN.
     3371                 logger:StrLogPut =
     3372                   "Алгоритм: " + string(ptrlprop-algrvspt) + chr(10) +
     3373                   "Номер сверки: " + string(rvsinvsubObj:RvsCode) + chr(10) +
     3374                   "Номер резервуара: " + string(rvsinvsubObj:PlCode) + chr(10) +
     3375                   "Код товара: " + string(rvsinvsubObj:GdsCode) + chr(10) +
     3376                   "MKN: " + string(MKN) + chr(10) +
     3377                   "MFO: " + string(MFO) + chr(10)  +
     3378                   "MFOR: " + string(MFOR) + chr(10)  +
     3379                   "MFOT: " + string(MFOT) + chr(10)   +
     3380                   "beta1: " + string(beta1) + chr(10) +
     3381                   "beta2: " + string(beta2) + chr(10) +
     3382                   "dMMBd: " + string(dMMBd) + chr(10)  +
     3383                   "rvsinvsubObj:Diff: " + string(beta2) + chr(10) +
     3384                   "dM: " + string(dMMBd) + chr(10)   .
     3385                 if absolute (dM) <= dMMBd
     3386                   then
     3387                 do:
     3388                   v-rsrv-qnty = 0.
     3389                   v-reserv-qnty-cli = 0.
     3390                 end.
     3391                 else
     3392                 do:
     3393                   if MFO > MKN
     3394                     then
     3395                   do:
     3396                     dM = MFO - MKN.
     3397                     MI = dM - dMMBd.
     3398                     MKKN = MKN + MI.
     3399                     v-rsrv-qnty = (MI) / v-avg-state-density.
     3400                     logger:StrLogPut =
     3401                       "Излишки: " + chr(10) +
     3402                       "MI: " + string(MI) + chr(10) +
     3403                       "MKKN: " + string(MKKN) + chr(10) +
     3404                       "v-rsrv-qnty: " + string(v-rsrv-qnty) + chr(10)
     3405                       .
     3406                   end.
     3407                   else
     3408                   do:
     3409                     dMPT = v-normal-tp.
     3410                     dMPOT = oNormWast:NormWastDays + dMPT.
     3411                     MPOT = MKN - MFO - dMMBd.
     3412                     if absolute (dM) <= dMMBd + dMPOT
     3413                       then
     3414                     do:
     3415                       MKKN = MFO + dMMBd.
     3416                     end.
     3417                     else
     3418                     do:
     3419                       MKKN = MFO + dMMBd.
     3420                     end.
     3421                     v-rsrv-qnty = (MKKN - MKN) / v-avg-state-density.
     3422                     logger:StrLogPut =
     3423                       "Недостача: " + chr(10) +
     3424                       "dMPT: " + string(dMPT) + chr(10) +
     3425                       "dMPOT: " + string(dMPOT) + chr(10) +
     3426                       "MPOT: " + string(MPOT) + chr(10) +
     3427                       "MKKN: " + string(MKKN) + chr(10) +
     3428                       "v-rsrv-qnty: " + string(v-rsrv-qnty) + chr(10)
     3429                       .
     3430                   end.
     3431                 end.
     3432                 if v-rsrv-qnty >= 0
     3433                   then
     3434                 do:
     3435                   rvsinvsubObj:Diff = absolute (rvsinvsubObj:Diff).
     3436                 end.
     3437                 else
     3438                 do:
     3439                   rvsinvsubObj:Diff = - absolute (rvsinvsubObj:Diff).
     3440                 end.
     3441                 rvsinvsubObj:MeteringErr = dMMBd.
     3442                 if rvsinvsubObj:Diff < 0
     3443                   then
     3444                 do:
     3445                   rvsinvsubObj:TPNormalAuto = v-normal-tp-auto.
     3446                   rvsinvsubObj:TPNormalPl = v-normal-tp-pl.
     3447                   rvsinvsubObj:NormalWastage = oNormWast:NormWastDays.
     3448                 end.
     3449                 else
     3450                 do:
     3451                   rvsinvsubObj:NormalWastage = 0.
     3452                   rvsinvsubObj:TPNormalAuto = 0.
     3453                   rvsinvsubObj:TPNormalPl = 0.
     3454                 end.
     3455                 rvsinvstrObj = new rvsinvstr ().
     3456                 rvsinvstrObj:insertDB(rvsinvsubObj).
     3457                 logger:StrLogPut =
     3458                   "--------------" + chr(10) +
     3459                   "Данные для инвентаризации:" +
     3460                   chr(10) +
     3461                   rvsinvsubObj:ObjType + string (rvsinvsubObj:ObjCode) + chr(10) +
     3462                   "Сверка:" + rvsinvsubObj:RvsCode + chr(10) +
     3463                   "Место хранения:" + string (rvsinvsubObj:PlCode) + chr(10) +
     3464                   "Расчетно-книжный остаток (включая трубопровод) MKN: " + string (MKN) + chr(10) +
     3465                   "Факт. остаток по рез. изм. в резер. MFOR: " + string (MFOR) + chr(10) +
     3466                   "Факт. остаток по рез. изм. в трубопроводе MFOT: " + string (MFOT) + chr(10) +
     3467                   "Факт. остаток по рез. изм. MFO: " + string (MFO) + chr(10) +
     3468                   "Погр.изм. резер. beta1, %: " + string (beta1) + chr(10) +
     3469                   "Погр.изм. трубопровод beta2, %: " + string (beta2) + chr(10) +
     3470                   "Допускаемый небаланс dMMBd = (beta1 * MFOR + beta2 * MFOT) / 100: " + string(dMMBd) + chr(10) +
     3471                   "Сумма по ПН технол. потерь в резервуаре: " + string (v-normal-tp-pl) + chr(10) +
     3472                   "Сумма по ПН технол. потерь при сливе из АЦ: " + string (v-normal-tp-auto) + chr(10) +
     3473                   "Общая сумма по ПН технол. потерь dMPT: " + string (v-normal-tp) + chr(10) +
     3474                   "Общая сумма ест. убыли при хр. dMHREY : " + string (oNormWast:NormWastDays) + chr(10) +
     3475                   "Небаланс |dM|: " + string (absolute (dM)) + chr(10) +
     3476                   "Недостача MNED : " + string (absolute (MNED)) + chr(10) +
     3477                   "Излишки MI : " + string (absolute (MI)) + chr(10) +
     3478                   "Скорректированный расчетно-книжный остаток (включая трубопровод) MKKN: " + string (MKKN) + chr(10)
     3479                   .
     3480                 def var v-infom-mess as char no-undo.
     3481                 if absolute (rvsinvsubObj:Diff) > rvsinvsubObj:MeterErrWast
     3482                   then
     3483                 do:
     3484                   v-infom-mess = v-infom-mess + substitute ("Назв. товара - &2&1Скл.место - &3, РКО,кг - &4, Факт., кг - &5&1&6, кг - &7&1"
     3485                     , chr(10)
     3486                     ,buf_goods.gds-name
     3487                     ,string(rvsinvsubObj:PlCode)
     3488                     ,string(round (MKN, 3))
     3489                     ,string(round (MFO, 3))
     3490                     ,(if rvsinvsubObj:Diff < 0 then "Недостача" else "Излишки")
     3491                     ,string (round (rvsinvsubObj:DeficitOver, 3))
     3492                     ).
     3493                 end.
     3494               end.
     3495               if not ptrlprop-algrvspt = 3
     3496                 then
     3497                 if ptrlprop-expptrl = 'weight':U then
     3498                 do:
     3499                   assign
     3500                     v-reserv-qnty-cli = v-rsrv-qnty
     3501                     .
     3502                   if varinv-set = true then
     3503                   do:
     3504                     assign
     3505                       v-reserv-qnty-base = ( v-fact-cli-qnty + v-reserv-qnty-cli - (if v-cre-add-docs = true then v-normal-wastage-cli else 0.0)
     3506                                             ) / buf_rvs-line.state-density - ( v-fact-qnty - (if v-cre-add-docs = true then v-normal-wastage-base else 0.0) )
     3507                       .
     3508                     logger:StrLogPut =
     3509                       "Установлен параметр, выставляем кол-ва по плотности" + chr(10) +
     3510                       "Кол-во : " + string(if v-reserv-qnty-base <> ? then v-reserv-qnty-base else 0) + chr(10)
     3511                       .
     3512                   end.
     3513                   else
     3514                   do:
     3515                     assign
     3516                       v-reserv-qnty-base = v-reserv-qnty-cli / v-avg-state-density
     3517                       .
     3518                     logger:StrLogPut =
     3519                       "Кол-во : " + string(if v-reserv-qnty-base <> ? then v-reserv-qnty-base else 0) + chr(10)
     3520                       .
     3521                   end.
     3522                 end.
     3523                 else
     3524                 do:
     3525                   assign
     3526                     v-reserv-qnty-base = v-rsrv-qnty
     3527                     .
     3528                   if varinv-set = true then
     3529                   do:
     3530                     assign
     3531                       v-reserv-qnty-cli = ( v-fact-qnty + v-reserv-qnty-base - (if v-cre-add-docs = true then v-normal-wastage-base else 0.0)
     3532                                           ) * buf_rvs-line.state-density - ( v-fact-cli-qnty - (if v-cre-add-docs = true then v-normal-wastage-cli else 0.0) )
     3533                       .
     3534                     logger:StrLogPut =
     3535                       "Установлен параметр, выставляем кол-ва по плотности" + chr(10) +
     3536                       "Кол-во : " + string(if v-reserv-qnty-cli <> ? then v-reserv-qnty-cli else 0) + chr(10)
     3537                       .
     3538                   end.
     3539                   else
     3540                   do:
     3541                     assign
     3542                       v-reserv-qnty-cli = v-reserv-qnty-base * v-avg-state-density
     3543                       .
     3544                     logger:StrLogPut =
     3545                       "Кол-во : " + string(if v-reserv-qnty-cli <> ? then v-reserv-qnty-cli else 0) + chr(10)
     3546                       .
     3547                   end.
     3548                 end.
     3549               else
     3550               do:
     3551                 v-reserv-qnty-base = v-rsrv-qnty.
     3552                 assign
     3553                   v-reserv-qnty-cli = v-reserv-qnty-base * v-avg-state-density
     3554                   .
     3555                 logger:StrLogPut =
     3556                   "Кол-во : " + string(v-reserv-qnty-cli) + chr(10)
     3557                   .
     3558               end.
     3559             end.
     3560             else do:
     3561               assign
     3562                 v-reserv-qnty-cli  = O_FACT-cli - O_PKH-cli
     3563                 v-reserv-qnty-base = O_FACT-base - O_PKH-base
     3564                 .
     3565               logger:StrLogPut =
     3566                 "Кол-во кг: " + string(v-reserv-qnty-cli) + chr(10) +
     3567                 "Кол-во литры: " + string(v-reserv-qnty-base) + chr(10)
     3568                 .
     3569             end.
     3570             if v-reserv-qnty-cli = ? then v-reserv-qnty-cli = 0 .
     3571             if v-reserv-qnty-base = ? then v-reserv-qnty-base = 0 .
     3572             if v-reserv-qnty-base <> 0 then
     3573             do:
     3574               assign
     3575                 v-chg-qnty = v-reserv-qnty-base
     3576                 .
     3577               run trg/rsrv-dtl.p
     3578                 ( input parparentproc
     3579                 , input 'reserv':U + "," + 'plcode':U + "=" + string(buf_rvs-line.pl-code)
     3580                 , buffer buf_gds-dtl
     3581                 , input-output v-chg-qnty
     3582                 , input-output buf_doc-line.price-base
     3583                 , input-output buf_doc-line.price-rubl
     3584                 , input -1
     3585                 , input ""
     3586                 ) no-error.
     3587               if error-status :error then
     3588               do:
     3589                 message
     3590                   vss-workfile vss-revision vss-description skip
     3591                   "Ошибка резервирования." skip
     3592                   error-status:get-message(1)      skip
     3593                   error-status:get-message(2)      skip
     3594                   return-value
     3595                   view-as alert-box error.
     3596                 undo block_cre-inv, retry block_cre-inv.
     3597               end.
     3598               if v-chg-qnty <> v-reserv-qnty-base then
     3599               do:
     3600                 message
     3601                   vss-workfile vss-revision vss-description skip
     3602                   "Не удалось произвести автоматическое резервирование на все кол-во." skip
     3603                   substitute( "Для документа инвентаризации по месту хранения &1", buf_rvs-line.pl-code ) skip
     3604                   "Инвентаризация не может быть сделана автоматически."
     3605                   view-as alert-box.
     3606                 undo block_cre-inv, retry block_cre-inv.
     3607               end.
     3608             end.
     3609             if v-reserv-qnty-base <> 0
     3610               or v-reserv-qnty-cli <> 0
     3611               then
     3612             do:
     3613               assign
     3614                 buf_gds-dtl.fact-qnty       = buf_gds-dtl.fact-qnty       + v-reserv-qnty-base
     3615                 buf_gds-dtl.doc-qnty        = buf_gds-dtl.doc-qnty        + v-reserv-qnty-base
     3616                 buf_doc-line.doc-qnty       = buf_doc-line.doc-qnty       + v-reserv-qnty-base
     3617                 buf_doc-line.fact-qnty      = buf_doc-line.fact-qnty      + v-reserv-qnty-base
     3618                 buf_doc-line.cli-qnty       = buf_doc-line.cli-qnty       + v-reserv-qnty-cli
     3619                 buf_inv-line.wast-cli-qnty  = buf_inv-line.wast-cli-qnty  + v-reserv-qnty-cli
     3620                 buf_doc-pl.doc-qnty         = buf_doc-pl.doc-qnty         + v-reserv-qnty-base
     3621                 buf_doc-pl.cli-qnty         = buf_doc-pl.cli-qnty         + v-reserv-qnty-cli
     3622                 buf_doc-pl.rest-af-qnty     = buf_doc-pl.rest-af-qnty     + v-reserv-qnty-base
     3623                 buf_doc-pl.cli-rest-af-qnty = buf_doc-pl.cli-rest-af-qnty + v-reserv-qnty-cli
     3624                 buf_doc-pl.fact-qnty        = buf_doc-pl.doc-qnty
     3625                 buf_doc-pl.cli-doc-qnty     = buf_doc-pl.cli-qnty
     3626                 buf_doc-pl.cli-fact-qnty    = buf_doc-pl.cli-qnty
     3627                 .
     3628             end.
     3629             create buf_doc-line-sum .
     3630             assign
     3631               buf_doc-line-sum.doc-code  = v-inv-code
     3632               buf_doc-line-sum.gds-code  = buf_rvs-line.gds-code
     3633               buf_doc-line-sum.sum-type  = substitute( "&1&2&3&2&4", 'wst':U, chr(4), "base":U, buf_rvs-line.pl-code )
     3634               buf_doc-line-sum.fact-qnty = v-wastage-qnty-base
     3635               .
     3636             create buf_doc-line-sum .
     3637             assign
     3638               buf_doc-line-sum.doc-code  = v-inv-code
     3639               buf_doc-line-sum.gds-code  = buf_rvs-line.gds-code
     3640               buf_doc-line-sum.sum-type  = substitute( "&1&2&3&2&4", "mterr":U, chr(4), "base":U, buf_rvs-line.pl-code )
     3641               buf_doc-line-sum.fact-qnty = v-metering-qnty-base
     3642               .
     3643             create buf_doc-line-sum .
     3644             assign
     3645               buf_doc-line-sum.doc-code  = v-inv-code
     3646               buf_doc-line-sum.gds-code  = buf_rvs-line.gds-code
