     4024   procedure close-doc :
     4025     define input  parameter p-doc-code  like ub.trn-doc.doc-code no-undo .
     4026     define input  parameter p-doc-recid as   recid               no-undo .
     4027     do
     4028       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4029       on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4030       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4031       :
     4032       define variable varchg-inv as logical no-undo.
     4033       run str/trn-stat.p
     4034         ( input parparentproc
     4035         ,input this-procedure
     4036         ,input '<закрытие документа>':U
     4037         ,input p-doc-code
     4038         ,input ?
     4039         ,input v-cntxt-db-num
     4040         ,input ?
     4041         ,input ?
     4042         ,input ?
     4043         ,input ?
     4044         ,input yes
     4045         ,output varchg-inv
     4046         ,output table gds-list
     4047         ) no-error.
     4048       if error-status :error then
     4049       do:
     4050         message
     4051           vss-workfile vss-revision vss-description skip
     4052           substitute( "Ошибка при переводе документа &1 из статуса накл- в накл+.", p-doc-code ) skip
     4053           return-value skip
     4054           trim(error-status :get-message(1))
     4055           trim(error-status :get-message(2))
     4056           trim(error-status :get-message(3))
     4057           trim(error-status :get-message(4))
     4058           trim(error-status :get-message(5)) skip
     4059           view-as alert-box error.
     4060         undo, return error return-value .
     4061       end.
     4062       run str/trn-stat.p
     4063         ( input parparentproc
     4064         ,input this-procedure
     4065         ,input '<закрытие документа>':U
     4066         ,input p-doc-code
     4067         ,input ?
     4068         ,input v-cntxt-db-num
     4069         ,input ?
     4070         ,input ?
     4071         ,input ?
     4072         ,input ?
     4073         ,input yes
     4074         ,output varchg-inv
     4075         ,output table gds-list
     4076         ) no-error.
     4077       if error-status :error then
     4078       do:
     4079         message
     4080           vss-workfile vss-revision vss-description skip
     4081           substitute( "Ошибка при переводе документа &1 из статуса накл+ в разр+.", p-doc-code ) skip
     4082           return-value skip
     4083           trim(error-status :get-message(1))
     4084           trim(error-status :get-message(2))
     4085           trim(error-status :get-message(3))
     4086           trim(error-status :get-message(4))
     4087           trim(error-status :get-message(5)) skip
     4088           view-as alert-box error.
     4089         undo, return error return-value .
     4090       end.
     4091       run gbl/calc-trn.p
     4092         ( input parparentproc
     4093         ,input p-doc-recid
     4094         ) no-error.
     4095     end.
     4096   end procedure.
     4097   PROCEDURE cr-tt-upd :
