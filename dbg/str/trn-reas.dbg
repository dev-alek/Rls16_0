      982       assign sch-code.
      983       assign FoundRec = ?
      984              sch-num  = 0.
      985       hide   sch-num  in frame fr-D-reason-0.
      986     end.
      987     run proc-find-code in this-procedure ( input yes, input sch-code ) no-error.
      988     if error-status :error then do: return no-apply. end.
      989   end.
      990   on CTRL-J of sch-name in frame fr-D-reason-0 do:
      991     if input frame fr-D-reason-0 sch-name <> sch-name then do:
      992       assign sch-name.
      993       assign FoundRec = ?
      994              sch-num  = 0.
      995       hide   sch-num  in frame fr-D-reason-0.
      996     end.
      997     run proc-find-name in this-procedure ( input yes, input sch-name ) no-error.
      998     if error-status :error then do: return no-apply. end.
      999   end.
     1000   on return of sch-name in frame fr-D-reason-0 do:
     1001     assign sch-name.
     1002     assign FoundRec = ?
     1003            sch-num  = 0.
     1004     hide   sch-num  in frame fr-D-reason-0.
     1005     run proc-find-name in this-procedure ( input no,  input sch-name ) no-error.
     1006     if error-status :error then do: return no-apply. end.
     1007   end.
     1008   on mouse-select-dblclick of sch-name in frame fr-D-reason-0 do:
     1009     if input frame fr-D-reason-0 sch-name <> sch-name then do:
     1010       assign sch-name.
     1011       assign FoundRec = ?
     1012              sch-num  = 0.
     1013       hide   sch-num  in frame fr-D-reason-0.
     1014     end.
     1015     run proc-find-name in this-procedure ( input yes, input sch-name ) no-error.
     1016     if error-status :error then do: return no-apply. end.
     1017   end.
     1018   on value-changed of tb-deleted DO:
     1019       assign tb-deleted.
     1020       run OpenBr in this-procedure ( input yes, input no, input '':U ).
