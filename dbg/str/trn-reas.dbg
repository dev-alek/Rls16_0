     1078   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   procedure minbtn-set :
     1080       do
     1081           on error undo, return error return-value
     1082           :
     1083           define variable ii              as integer       no-undo .
     1084           define variable fh              as widget-handle no-undo .
     1085           define variable hh              as widget-handle no-undo .
     1086           define variable v-h             as handle        extent 4 no-undo .
     1087           define variable v-name-button   as character     no-undo .
     1088           define variable v-help-old-x    as decimal       no-undo .
     1089           define variable v-help-old-y    as decimal       no-undo .
     1090           define variable v-help-old-size as decimal       no-undo .
     1091           define variable v-frame-width   as decimal       no-undo .
     1092           define variable jj              as integer       no-undo .
     1093           do
     1094               on error undo, return error
     1095               :
     1096               assign
     1097                   v-frame-width = frame fr-D-reason-0:width - 0.3
     1098                   fh            = frame fr-D-reason-0:first-child
     1099                   hh            = fh:first-child
     1100                   ii            = 1
     1101                   .
     1102               do while valid-handle(hh):
     1103                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1104                   do:
     1105                       case lc(hh:name) :
     1106                           when "b-help" then
     1107                               do:
     1108                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1109                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1110                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1111                                   hh:TOOLTIP = "Помощь" .
     1112                                   v-help-old-x = hh:column .
     1113                                   v-help-old-y = hh:row    .
     1114                                   v-help-old-size = hh:width .
     1115                                   hh:width-chars = 2.5 .
     1116                               end.
     1117                           when "b-print" then
     1118                               do:
     1119                                   hh:load-image("cmp/b-print.bmp":u) .
     1120                                   hh:TOOLTIP = "Печать" .
     1121                                   v-h[ii] = hh:handle .
     1122                                   ii = ii + 1 .
     1123                                   hh:width-chars = 3 .
     1124                               end.
     1125                           when "b-history" or
     1126                           when "b-hist" then
     1127                               do:
     1128                                   hh:load-image("cmp/b-hist.bmp":u) .
     1129                                   hh:TOOLTIP = "История" .
     1130                                   v-h[ii] = hh:handle .
     1131                                   ii = ii + 1 .
     1132                                   hh:width-chars = 3 .
     1133                               end.
     1134                           when "b-sch" then
     1135                               do:
     1136                                   hh:load-image("cmp/b-sch.bmp":u) .
     1137                                   hh:TOOLTIP = "Установка Фильтра" .
     1138                                   v-h[ii] = hh:handle .
     1139                                   ii = ii + 1 .
     1140                                   hh:width-chars = 3 .
     1141                               end.
     1142                           when "b-hist-user" then
     1143                               do:
     1144                                   hh:load-image("cmp/b-hist.bmp":u) .
     1145                                   hh:TOOLTIP = "История пользователя" .
     1146                                   ii = ii + 1 .
     1147                               end.
     1148                       end case.
     1149                   end.
     1150                   hh = hh:next-sibling.
     1151               end.
     1152               b-help:column = v-frame-width - b-help:width-chars.
     1153               jj = 0.
     1154               repeat ii = 4 to 1 by -1 :
     1155                   if valid-handle (v-h[ii] ) then
     1156                   do:
     1157                       jj  = jj + 1 .
     1158                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1159                       v-h[ii]:row    = v-help-old-y .
     1160                   end.
     1161               end.
     1162           end.
     1163       end.
     1164   end procedure.
     1165   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1166   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1167   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1168   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1169   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1170   define variable v-diasize-current-frame-height as decimal   no-undo .
     1171   define variable v-diasize-change-size          as logical   no-undo .
     1172   define variable v-diasize-resize-button        as handle    no-undo .
     1173   define variable v-diasize-wndmax               as logical   no-undo .
     1174   define variable v-diasize-wndstore             as logical   no-undo .
     1175   define variable v-diasize-proc-name            as character no-undo .
     1176   define variable v-diasize-browse-handle        as handle    no-undo .
     1177   define variable v-diasize-browse-number        as integer   no-undo .
     1178   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1179   define temp-table temp-diasize-handle no-undo
     1180     field handle-value  as handle
     1181     field save-position as decimal
     1182     index xpk is primary unique handle-value
     1183     .
     1184   define temp-table temp-browse-handle no-undo
     1185     field browse-type   as character
     1186     field browse-number as integer
     1187     field browse-handle as handle
     1188     field original-size as decimal
     1189     index xpk is primary unique browse-type browse-number
     1190     index xie browse-type browse-handle
     1191   .
     1192   procedure diasize_change-height :
     1193     define input  parameter p-change-value  as decimal   no-undo .
     1194     define input  parameter p-move-resize   as logical   no-undo .
     1195     define variable v-field-group-handle    as handle    no-undo .
     1196     define variable v-object-handle         as handle    no-undo .
     1197     define variable v-frame-height          as decimal   no-undo .
     1198     define variable v-frame-virtual-height  as decimal   no-undo .
     1199     define variable v-browse-height         as decimal   no-undo .
     1200     define variable v-window-height         as decimal   no-undo .
     1201     define variable v-window-virtual-height as decimal   no-undo .
     1202     define variable v-change-sign           as integer   no-undo .
     1203     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1204     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1205     if p-change-value > 0
     1206     then do:
     1207       if frame fr-D-reason-0 :height + p-change-value
     1208           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1209       then do:
     1210         assign
     1211           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1212                           - (frame fr-D-reason-0 :height-chars)
     1213         .
     1214         if p-change-value <= 0
     1215         then do:
     1216           run diasize_position-resize-button in this-procedure .
     1217           return .
     1218         end.
     1219       end.
     1220     end.
     1221     if p-change-value < 0
     1222     then do:
     1223       if frame fr-D-reason-0 :height + p-change-value < v-diasize-orig-frame-height
     1224       then do:
     1225         assign
     1226           p-change-value = v-diasize-orig-frame-height
     1227                          - (frame fr-D-reason-0 :height-chars)
     1228         .
     1229         if p-change-value >= 0
     1230         then do:
     1231           run diasize_position-resize-button in this-procedure .
     1232           return .
     1233         end.
     1234       end.
     1235     end.
     1236     if p-change-value >= 0
     1237     then do:
     1238       assign
     1239         v-change-sign = 1
     1240       .
     1241     end.
     1242     else do:
     1243       assign
     1244         v-change-sign = -1
     1245       .
     1246     end.
     1247     assign
     1248       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1249     .
     1250     if p-change-value = 0
     1251     then do:
     1252       run diasize_position-resize-button in this-procedure .
     1253       return .
     1254     end.
     1255     move_block:
     1256     do
     1257     on error undo move_block, retry move_block
     1258     :
     1259       if retry
     1260       then do:
     1261         do
     1262         on error undo move_block, leave move_block
     1263         :
     1264           if p-change-value > 0
     1265           then do:
     1266             for each buf_temp-diasize-handle
     1267             on error undo, next
     1268             :
     1269               assign
     1270                 v-object-handle = buf_temp-diasize-handle.handle-value
     1271               .
     1272               if v-object-handle <> v-diasize-resize-button
     1273               then do:
     1274                 assign
     1275                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1276                 .
     1277               end.
     1278             end.
     1279             assign
     1280               v-diasize-browse-handle :height = v-browse-height
     1281             .
     1282             for each buf_temp-browse-handle
     1283               where buf_temp-browse-handle.browse-type = 'height':u
     1284             on error undo, next
     1285             :
     1286               assign
     1287                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1288               .
     1289             end.
     1290             assign
     1291               frame fr-D-reason-0 :height = v-frame-height
     1292             .
     1293             if frame fr-D-reason-0 :scrollable = true
     1294             then do:
     1295               assign
     1296                 frame fr-D-reason-0 :virtual-height = v-frame-virtual-height
     1297               .
     1298             end.
     1299             run diasize_position-resize-button in this-procedure .
     1300           end.
     1301           else do:
     1302             if frame fr-D-reason-0 :scrollable = true
     1303             then do:
     1304               assign
     1305                 frame fr-D-reason-0 :virtual-height = v-frame-virtual-height
     1306               .
     1307             end.
     1308             assign
     1309               frame fr-D-reason-0 :height = v-frame-height
     1310             .
     1311             assign
     1312               v-diasize-browse-handle :height = v-browse-height
     1313             .
     1314             for each buf_temp-browse-handle
     1315               where buf_temp-browse-handle.browse-type = 'height':u
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1320               .
     1321             end.
     1322             for each buf_temp-diasize-handle
     1323             on error undo, next
     1324             :
     1325               assign
     1326                 v-object-handle = buf_temp-diasize-handle.handle-value
     1327               .
     1328               if v-object-handle <> v-diasize-resize-button
     1329               then do:
     1330                 assign
     1331                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1332                 .
     1333               end.
     1334             end.
     1335             run diasize_position-resize-button in this-procedure .
     1336           end.
     1337           assign
     1338             v-diasize-change-size = false
     1339           .
     1340           leave move_block .
     1341         end.
     1342       end.
     1343       assign
     1344         v-diasize-need-full-display = true
     1345       .
     1346       if v-diasize-change-size = false
     1347       then do:
     1348         assign
     1349           v-diasize-change-size = true
     1350         .
     1351       end.
     1352       else do:
     1353         return .
     1354       end.
     1355       assign
     1356         v-frame-height = frame fr-D-reason-0 :height
     1357         v-frame-virtual-height = frame fr-D-reason-0 :virtual-height
     1358         v-browse-height = v-diasize-browse-handle :height
     1359       .
     1360       for each buf_temp-browse-handle
     1361         where buf_temp-browse-handle.browse-type = 'height':u
     1362       :
     1363         assign
     1364           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1365         .
     1366       end.
     1367       for each buf_temp-diasize-handle
     1368       :
     1369         delete buf_temp-diasize-handle .
     1370       end.
     1371       assign
     1372         v-field-group-handle = frame fr-D-reason-0 :first-child
     1373       .
     1374       do while valid-handle(v-field-group-handle)
     1375       :
     1376         assign
     1377           v-object-handle = v-field-group-handle :first-child
     1378         .
     1379         do while valid-handle(v-object-handle)
     1380         :
     1381           if  v-object-handle <> v-diasize-browse-handle :handle
     1382           and can-query(v-object-handle, "row")
     1383           and can-query(v-object-handle, "height")
     1384           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1385           then do:
     1386             find first buf_temp-browse-handle
     1387               where buf_temp-browse-handle.browse-type   = 'height':u
     1388                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1389               no-error .
     1390             if available buf_temp-browse-handle
     1391             then do:
     1392             end.
     1393             else do:
     1394               create buf_temp-diasize-handle .
     1395               assign
     1396                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1397                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1398               .
     1399             end.
     1400           end.
     1401           assign
     1402             v-object-handle = v-object-handle :next-sibling
     1403           .
     1404         end.
     1405         assign
     1406           v-field-group-handle = v-field-group-handle :next-sibling
     1407         .
     1408       end.
     1409       do with frame fr-D-reason-0
     1410       :
     1411         hide v-diasize-resize-button .
     1412         assign
     1413           v-diasize-resize-button :row    = 1
     1414           v-diasize-resize-button :column = 1
     1415         .
     1416       end.
     1417       if p-change-value > 0
     1418       then do:
     1419         if frame fr-D-reason-0 :scrollable = true
     1420         then do:
     1421           assign
     1422             frame fr-D-reason-0 :virtual-height = frame fr-D-reason-0 :virtual-height + p-change-value
     1423             no-error .
     1424           if error-status :error
     1425           or error-status :get-message(1) <> ""
     1426           then do:
     1427             undo move_block, retry move_block .
     1428           end.
     1429         end.
     1430         assign
     1431           frame fr-D-reason-0 :height = frame fr-D-reason-0 :height + p-change-value
     1432           no-error .
     1433         if error-status :error
     1434         or error-status :get-message(1) <> ""
     1435         then do:
     1436           undo move_block, retry move_block .
     1437         end.
     1438         assign
     1439           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1440           no-error .
     1441         if error-status :error
     1442         or error-status :get-message(1) <> ""
     1443         then do:
     1444           undo move_block, retry move_block .
     1445         end.
     1446         for each buf_temp-browse-handle
     1447           where buf_temp-browse-handle.browse-type = 'height':u
     1448         on error undo move_block, retry move_block
     1449         :
     1450           assign
     1451             buf_temp-browse-handle.browse-handle :height
     1452               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1453             no-error .
     1454           if error-status :error
     1455           or error-status :get-message(1) <> ""
     1456           then do:
     1457             undo move_block, retry move_block .
     1458           end.
     1459         end.
     1460         for each buf_temp-diasize-handle
     1461         on error undo move_block, retry move_block
     1462         :
     1463           assign
     1464             v-object-handle = buf_temp-diasize-handle.handle-value
     1465           .
     1466           if v-object-handle <> v-diasize-resize-button
     1467           then do:
     1468             assign
     1469               v-object-handle :row = v-object-handle :row + p-change-value
     1470               no-error .
     1471             if error-status :error
     1472             or error-status :get-message(1) <> ""
     1473             then do:
     1474               undo move_block, retry move_block .
     1475             end.
     1476           end.
     1477         end.
     1478       end.
     1479       else do:
     1480         for each buf_temp-diasize-handle
     1481         on error undo move_block, retry move_block
     1482         :
     1483           assign
     1484             v-object-handle = buf_temp-diasize-handle.handle-value
     1485           .
     1486           if v-object-handle <> v-diasize-resize-button
     1487           then do:
     1488             assign
     1489               v-object-handle :row = v-object-handle :row + p-change-value
     1490               no-error .
     1491             if error-status :error
     1492             or error-status :get-message(1) <> ""
     1493             then do:
     1494               undo move_block, retry move_block .
     1495             end.
     1496           end.
     1497         end.
     1498         assign
     1499           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1500           no-error .
     1501         if error-status :error
     1502         or error-status :get-message(1) <> ""
     1503         then do:
     1504           undo move_block, retry move_block .
     1505         end.
     1506         for each buf_temp-browse-handle
     1507           where buf_temp-browse-handle.browse-type = 'height':u
     1508         on error undo move_block, retry move_block
     1509         :
     1510           assign
     1511             buf_temp-browse-handle.browse-handle :height
     1512               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1513             no-error .
     1514           if error-status :error
     1515           or error-status :get-message(1) <> ""
     1516           then do:
     1517             undo move_block, retry move_block .
     1518           end.
     1519         end.
     1520         assign
     1521           frame fr-D-reason-0 :height = frame fr-D-reason-0 :height + p-change-value
     1522           no-error .
     1523         if error-status :error
     1524         or error-status :get-message(1) <> ""
     1525         then do:
     1526           undo move_block, retry move_block .
     1527         end.
     1528         if frame fr-D-reason-0 :scrollable = true
     1529         then do:
     1530           assign
     1531             frame fr-D-reason-0 :virtual-height = frame fr-D-reason-0 :virtual-height + p-change-value
     1532             no-error .
     1533           if error-status :error
     1534           or error-status :get-message(1) <> ""
     1535           then do:
     1536             undo move_block, retry move_block .
     1537           end.
     1538         end.
     1539       end.
     1540       if p-move-resize = true
     1541       then do:
     1542         run diasize_position-resize-button in this-procedure .
     1543       end.
     1544       if v-diasize-wndstore = true
     1545       then do:
     1546         if connected("ub") = true
     1547         then do:
     1548           define variable v-cntxt-db-num        as integer   no-undo .
     1549           define variable v-cntxt-userid        as character no-undo .
     1550           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1551                                             , OUTPUT v-cntxt-userid
     1552                                             ) .
     1553           run gbl/wndsizew.p
     1554             (input  v-cntxt-db-num
     1555             ,input  v-cntxt-userid
     1556             ,input  v-diasize-proc-name
     1557             ,input  'height':u
     1558             ,input  string(frame fr-D-reason-0 :height - v-diasize-orig-frame-height)
     1559             ) .
     1560         end.
     1561       end.
     1562     end.
     1563     assign
     1564       v-diasize-change-size = false
     1565     .
     1566   end procedure.
     1567   procedure diasize_set-height :
     1568     define input  parameter p-new-height  as decimal   no-undo .
     1569     define input  parameter p-move-resize as logical   no-undo .
     1570     do
     1571     on error undo, return error return-value
     1572     :
     1573       run diasize_change-height in this-procedure
     1574         (input  (p-new-height - frame fr-D-reason-0 :height)
     1575         ,input  p-move-resize
     1576         ) .
     1577     end.
     1578   end procedure.
     1579   procedure diasize_change-width :
     1580     define input  parameter p-change-value as decimal   no-undo .
     1581     define input  parameter p-move-resize  as logical   no-undo .
     1582     define variable v-field-group-handle   as handle    no-undo .
     1583     define variable v-object-handle        as handle    no-undo .
     1584     define variable v-frame-width          as decimal   no-undo .
     1585     define variable v-frame-virtual-width  as decimal   no-undo .
     1586     define variable v-browse-width         as decimal   no-undo .
     1587     define variable v-window-width         as decimal   no-undo .
     1588     define variable v-window-virtual-width as decimal   no-undo .
     1589     define variable v-change-sign          as integer   no-undo .
     1590     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1591     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1592     if p-change-value > 0
     1593     then do:
     1594       if frame fr-D-reason-0 :width + p-change-value >
     1595           session :width-chars
     1596       then do:
     1597         assign
     1598           p-change-value = session :width-chars - frame fr-D-reason-0 :width
     1599         .
     1600         if p-change-value <= 0
     1601         then do:
     1602           run diasize_position-resize-button in this-procedure .
     1603           return .
     1604         end.
     1605       end.
     1606     end.
     1607     if p-change-value < 0
     1608     then do:
     1609       if frame fr-D-reason-0 :width + p-change-value < v-diasize-orig-frame-width
     1610       then do:
     1611         assign
     1612           p-change-value = v-diasize-orig-frame-width
     1613                          - frame fr-D-reason-0 :width
     1614         .
     1615         if p-change-value >= 0
     1616         then do:
     1617           run diasize_position-resize-button in this-procedure .
     1618           return .
     1619         end.
     1620       end.
     1621     end.
     1622     if p-change-value >= 0
     1623     then do:
     1624       assign
     1625         v-change-sign = 1
     1626       .
     1627     end.
     1628     else do:
     1629       assign
     1630         v-change-sign = -1
     1631       .
     1632     end.
     1633     assign
     1634       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1635     .
     1636     if p-change-value = 0
     1637     then do:
     1638       run diasize_position-resize-button in this-procedure .
     1639       return .
     1640     end.
     1641     move_block:
     1642     do
     1643     on error undo move_block, leave move_block
     1644     :
     1645       if retry
     1646       then do:
     1647         do
     1648         on error undo move_block, leave move_block
     1649         :
     1650           if p-change-value > 0
     1651           then do:
     1652             for each buf_temp-diasize-handle
     1653             on error undo, next
     1654             :
     1655               assign
     1656                 v-object-handle = buf_temp-diasize-handle.handle-value
     1657               .
     1658               if v-object-handle <> v-diasize-resize-button
     1659               then do:
     1660                 assign
     1661                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1662                 .
     1663               end.
     1664             end.
     1665             assign
     1666               v-diasize-browse-handle :width = v-browse-width
     1667             .
     1668             for each buf_temp-browse-handle
     1669               where buf_temp-browse-handle.browse-type = 'width':u
     1670             on error undo, next
     1671             :
     1672               assign
     1673                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1674               .
     1675             end.
     1676             assign
     1677               frame fr-D-reason-0 :width = v-frame-width
     1678             .
     1679             if frame fr-D-reason-0 :scrollable = true
     1680             then do:
     1681               assign
     1682                 frame fr-D-reason-0 :virtual-width = v-frame-virtual-width
     1683               .
     1684             end.
     1685             run diasize_position-resize-button in this-procedure .
     1686           end.
     1687           else do:
     1688             if frame fr-D-reason-0 :scrollable = true
     1689             then do:
     1690               assign
     1691                 frame fr-D-reason-0 :virtual-width = v-frame-virtual-width
     1692               .
     1693             end.
     1694             assign
     1695               frame fr-D-reason-0 :width = v-frame-width
     1696             .
     1697             for each buf_temp-browse-handle
     1698               where buf_temp-browse-handle.browse-type = 'width':u
     1699             on error undo, next
     1700             :
     1701               assign
     1702                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1703               .
     1704             end.
     1705             assign
     1706               v-diasize-browse-handle :width = v-browse-width
     1707             .
     1708             for each buf_temp-diasize-handle
     1709             on error undo, next
     1710             :
     1711               assign
     1712                 v-object-handle = buf_temp-diasize-handle.handle-value
     1713               .
     1714               if v-object-handle <> v-diasize-resize-button
     1715               then do:
     1716                 assign
     1717                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1718                 .
     1719               end.
     1720             end.
     1721             run diasize_position-resize-button in this-procedure .
     1722           end.
     1723           assign
     1724             v-diasize-change-size = false
     1725           .
     1726           leave move_block .
     1727         end.
     1728       end.
     1729       assign
     1730         v-diasize-need-full-display = true
     1731       .
     1732       if v-diasize-change-size = false
     1733       then do:
     1734         assign
     1735           v-diasize-change-size = true
     1736         .
     1737       end.
     1738       else do:
     1739         return .
     1740       end.
     1741       assign
     1742         v-frame-width = frame fr-D-reason-0 :width
     1743         v-frame-virtual-width = frame fr-D-reason-0 :virtual-width
     1744         v-browse-width = v-diasize-browse-handle :width
     1745       .
     1746       for each buf_temp-browse-handle
     1747         where buf_temp-browse-handle.browse-type = 'width':u
     1748       :
     1749         assign
     1750           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1751         .
     1752       end.
     1753       for each buf_temp-diasize-handle
     1754       :
     1755         delete buf_temp-diasize-handle .
     1756       end.
     1757       assign
     1758         v-field-group-handle = frame fr-D-reason-0 :first-child
     1759       .
     1760       do while valid-handle(v-field-group-handle)
     1761       :
     1762         assign
     1763           v-object-handle = v-field-group-handle :first-child
     1764         .
     1765         do while valid-handle(v-object-handle)
     1766         :
     1767           if  v-object-handle <> v-diasize-browse-handle :handle
     1768           and v-object-handle <> v-diasize-resize-button
     1769           and can-query(v-object-handle, "row")
     1770           and can-query(v-object-handle, "height")
     1771           and ( v-object-handle :col + v-object-handle :width
     1772                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1773               )
     1774           then do:
     1775             find first buf_temp-browse-handle
     1776               where buf_temp-browse-handle.browse-type   = 'width':u
     1777                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1778               no-error .
     1779             if available buf_temp-browse-handle
     1780             then do:
     1781             end.
     1782             else do:
     1783               create buf_temp-diasize-handle .
     1784               assign
     1785                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1786                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1787               .
     1788             end.
     1789           end.
     1790           assign
     1791             v-object-handle = v-object-handle :next-sibling
     1792           .
     1793         end.
     1794         assign
     1795           v-field-group-handle = v-field-group-handle :next-sibling
     1796         .
     1797       end.
     1798       do with frame fr-D-reason-0
     1799       :
     1800         hide v-diasize-resize-button .
     1801         v-diasize-resize-button :row = 1.
     1802         v-diasize-resize-button :column = 1.
     1803       end.
     1804       if p-change-value > 0
     1805       then do:
     1806         if frame fr-D-reason-0 :scrollable = true
     1807         then do:
     1808           assign
     1809             frame fr-D-reason-0 :virtual-width = frame fr-D-reason-0 :virtual-width + p-change-value
     1810             no-error .
     1811           if error-status :error
     1812           or error-status :get-message(1) <> ""
     1813           then do:
     1814             undo move_block, retry move_block.
     1815           end.
     1816         end.
     1817         assign
     1818           frame fr-D-reason-0 :width = v-frame-width + p-change-value
     1819           no-error .
     1820         if error-status :error
     1821         or error-status :get-message(1) <> ""
     1822         then do:
     1823           undo move_block, retry move_block.
     1824         end.
     1825         assign
     1826           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1827         no-error .
     1828         if error-status :error
     1829         or error-status :get-message(1) <> ""
     1830         then do:
     1831           undo move_block, retry move_block.
     1832         end.
     1833         for each buf_temp-browse-handle
     1834           where buf_temp-browse-handle.browse-type = 'width':u
     1835         on error undo move_block, retry move_block
     1836         :
     1837           assign
     1838             buf_temp-browse-handle.browse-handle :width
     1839               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1840             no-error .
     1841           if error-status :error
     1842           or error-status :get-message(1) <> ""
     1843           then do:
     1844             undo move_block, retry move_block .
     1845           end.
     1846         end.
     1847         for each buf_temp-diasize-handle
     1848         on error undo move_block, retry move_block
     1849         :
     1850           assign
     1851             v-object-handle = buf_temp-diasize-handle.handle-value
     1852           .
     1853           if v-object-handle <> v-diasize-resize-button
     1854           then do:
     1855             assign
     1856               v-object-handle :col = v-object-handle :col + p-change-value
     1857               no-error .
     1858             if error-status :error
     1859             or error-status :get-message(1) <> ""
     1860             then do:
     1861               undo move_block, retry move_block .
     1862             end.
     1863           end.
     1864         end.
     1865       end.
     1866       else do:
     1867         for each buf_temp-diasize-handle
     1868         on error undo move_block, retry move_block
     1869         :
     1870           assign
     1871             v-object-handle = buf_temp-diasize-handle.handle-value
     1872           .
     1873           if v-object-handle <> v-diasize-resize-button
     1874           then do:
     1875             assign
     1876               v-object-handle :col = v-object-handle :col + p-change-value
     1877               no-error .
     1878             if error-status :error
     1879             or error-status :get-message(1) <> ""
     1880             then do:
     1881               undo move_block, retry move_block .
     1882             end.
     1883           end.
     1884         end.
     1885         for each buf_temp-browse-handle
     1886           where buf_temp-browse-handle.browse-type = 'width':u
     1887         on error undo move_block, retry move_block
     1888         :
     1889           assign
     1890             buf_temp-browse-handle.browse-handle :width
     1891               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1892             no-error .
     1893           if error-status :error
     1894           or error-status :get-message(1) <> ""
     1895           then do:
     1896             undo move_block, retry move_block .
     1897           end.
     1898         end.
     1899         assign
     1900           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1901           no-error .
     1902         if error-status :error
     1903         or error-status :get-message(1) <> ""
     1904         then do:
     1905           undo move_block, retry move_block.
     1906         end.
     1907         assign
     1908           frame fr-D-reason-0 :width = frame fr-D-reason-0 :width + p-change-value
     1909         no-error .
     1910         if error-status :error
     1911         or error-status :get-message(1) <> ""
     1912         then do:
     1913           undo move_block, retry move_block.
     1914         end.
     1915         if frame fr-D-reason-0 :scrollable = true
     1916         then do:
     1917           assign
     1918             frame fr-D-reason-0 :virtual-width = frame fr-D-reason-0 :virtual-width + p-change-value
     1919           no-error .
     1920           if error-status :error
     1921           or error-status :get-message(1) <> ""
     1922           then do:
     1923             undo move_block, retry move_block.
     1924           end.
     1925         end.
     1926       end.
     1927       if p-move-resize
     1928       then do:
     1929         run diasize_position-resize-button in this-procedure .
     1930       end.
     1931       if v-diasize-wndstore = true
     1932       then do:
     1933         if connected("ub") = true
     1934         then do:
     1935           define variable v-cntxt-db-num        as integer   no-undo .
     1936           define variable v-cntxt-userid        as character no-undo .
     1937           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1938                                             , OUTPUT v-cntxt-userid
     1939                                             ) .
     1940           run gbl/wndsizew.p
     1941             (input  v-cntxt-db-num
     1942             ,input  v-cntxt-userid
     1943             ,input  v-diasize-proc-name
     1944             ,input  'width':u
     1945             ,input  string(frame fr-D-reason-0 :width - v-diasize-orig-frame-width)
     1946             ) .
     1947         end.
     1948       end.
     1949     end.
     1950     assign
     1951       v-diasize-change-size = false
     1952     .
     1953   end procedure.
     1954   procedure diasize_set-width :
     1955     define input  parameter p-new-width  as decimal   no-undo .
     1956     define input  parameter p-move-resize as logical   no-undo .
     1957     do
     1958     on error undo, return error return-value
     1959     :
     1960       run diasize_change-width in this-procedure
     1961         (input  (p-new-width - frame fr-D-reason-0 :width)
     1962         ,input  p-move-resize
     1963         ) .
     1964     end.
     1965   end procedure.
     1966   procedure diasize_position-resize-button :
     1967     do with frame fr-D-reason-0
     1968     :
     1969       hide v-diasize-resize-button .
     1970       assign
     1971         v-diasize-resize-button :row = frame fr-D-reason-0 :height - v-diasize-resize-button :height
     1972                     - 1
     1973                     - (frame fr-D-reason-0 :border-bottom-pixels / session :pixels-per-row)
     1974         v-diasize-resize-button :col = frame fr-D-reason-0 :width - v-diasize-resize-button :width
     1975                     - 1
     1976                     - (frame fr-D-reason-0 :border-right-pixels / session :pixels-per-column)
     1977       .
     1978       view v-diasize-resize-button .
     1979     end.
     1980   end procedure.
     1981   on alt-right anywhere
     1982   do:
     1983     run diasize_change-width in this-procedure
     1984       (input 1
     1985       ,input true
     1986       ) .
     1987     return no-apply .
     1988   end.
     1989   on alt-left anywhere
     1990   do:
     1991     run diasize_change-width in this-procedure
     1992       (input -1
     1993       ,input true
     1994       ) .
     1995     return no-apply .
     1996   end.
     1997   on alt-down anywhere
     1998   do:
     1999     run diasize_change-height in this-procedure
     2000       (input 1
     2001       ,input true
     2002       ) .
     2003     return no-apply .
     2004   end.
     2005   on alt-up anywhere
     2006   do:
     2007     run diasize_change-height in this-procedure
     2008       (input -1
     2009       ,input true
     2010       ) .
     2011     return no-apply .
     2012   end.
     2013   on alt-enter of frame fr-D-reason-0
     2014   do:
     2015     run diasize_maximize in this-procedure
     2016       (input  ?
     2017       ).
     2018     return no-apply .
     2019   end.
     2020   procedure diasize_end-move :
     2021     do
     2022     on error undo, return error return-value
     2023     :
     2024       define variable v-row-delta as decimal   no-undo .
     2025       define variable v-col-delta as decimal   no-undo .
     2026       define variable v-new-row as decimal   no-undo .
     2027       define variable v-new-col as decimal   no-undo .
     2028       assign
     2029         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2030         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2031       .
     2032       assign
     2033         v-row-delta = v-new-row - frame fr-D-reason-0 :height
     2034         v-col-delta = v-new-col - frame fr-D-reason-0 :width
     2035       .
     2036       run diasize_change-height in this-procedure
     2037         (input v-row-delta
     2038         ,input true
     2039         ) .
     2040       run diasize_change-width in this-procedure
     2041         (input v-col-delta
     2042         ,input true
     2043         ) .
     2044     end.
     2045   end procedure.
     2046   procedure diasize_maximize :
     2047     define input  parameter p-action as logical   no-undo .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       if p-action = ?
     2052       then do:
     2053         if v-diasize-need-maximize = true
     2054         then do:
     2055           assign
     2056             p-action = true
     2057           .
     2058         end.
     2059         else do:
     2060           assign
     2061             p-action = false
     2062           .
     2063         end.
     2064       end.
     2065       if p-action = true
     2066       then do:
     2067         run diasize_change-height in this-procedure
     2068           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2069               - frame fr-D-reason-0 :height-chars
     2070           ,input true
     2071           ) .
     2072         run diasize_change-width in this-procedure
     2073           (input session :width-chars
     2074               - frame fr-D-reason-0 :width-chars
     2075           ,input true
     2076           ) .
     2077         assign
     2078           v-diasize-need-maximize = false
     2079         .
     2080       end.
     2081       else do:
     2082         run diasize_change-width in this-procedure
     2083           (input v-diasize-orig-frame-width
     2084               - frame fr-D-reason-0 :width-chars
     2085           ,input true
     2086           ) .
     2087         run diasize_change-height in this-procedure
     2088           (input v-diasize-orig-frame-height
     2089               - frame fr-D-reason-0 :height-chars
     2090           ,input true
     2091           ) .
     2092         assign
     2093           v-diasize-need-maximize = true
     2094         .
     2095       end.
     2096     end.
     2097   end procedure.
     2098   procedure diasize_restore-orig-size :
     2099     do
     2100     on error undo, return error return-value
     2101     :
     2102       assign
     2103         v-diasize-current-frame-width  = frame fr-D-reason-0 :width
     2104         v-diasize-current-frame-height = frame fr-D-reason-0 :height
     2105       .
     2106       run diasize_set-height in this-procedure
     2107         (input  v-diasize-orig-frame-height
     2108         ,input  true
     2109         ) .
     2110       run diasize_set-width in this-procedure
     2111         (input  v-diasize-orig-frame-width
     2112         ,input  true
     2113         ) .
     2114     end.
     2115   end procedure.
     2116   procedure diasize_restore-current-size :
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       run diasize_set-height in this-procedure
     2121         (input  v-diasize-current-frame-height
     2122         ,input  true
     2123         ) .
     2124       run diasize_set-width in this-procedure
     2125         (input  v-diasize-current-frame-width
     2126         ,input  true
     2127         ) .
     2128     end.
     2129   end procedure.
     2130   procedure diasize_set-browse-handle :
     2131     define input  parameter p-browse-handle as handle   no-undo .
     2132     define buffer buf_temp-browse-handle for temp-browse-handle .
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       assign
     2137         v-diasize-browse-handle = p-browse-handle
     2138       .
     2139       for each buf_temp-browse-handle
     2140       on error undo, return error return-value
     2141       :
     2142         delete buf_temp-browse-handle .
     2143       end.
     2144     end.
     2145   end procedure.
     2146   procedure diasize_add_browse :
     2147     define input  parameter p-browse-type   as character no-undo .
     2148     define input  parameter p-browse-handle as handle    no-undo .
     2149     define buffer buf_temp-browse-handle for temp-browse-handle .
     2150     do
     2151     on error undo, return error return-value
     2152     :
     2153       assign
     2154         v-diasize-browse-number = v-diasize-browse-number + 1
     2155       .
     2156       create buf_temp-browse-handle .
     2157       assign
     2158         buf_temp-browse-handle.browse-type   = p-browse-type
     2159         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2160         buf_temp-browse-handle.browse-handle = p-browse-handle
     2161       .
     2162     end.
     2163   end procedure.
     2164   procedure diasize_init :
     2165     define variable v-default-value    as logical   no-undo .
     2166     define variable v-restore-saved    as logical   no-undo .
     2167     define variable v-resize-value-str as character no-undo .
     2168     do
     2169     on error undo, return error return-value
     2170     :
     2171       do with frame fr-D-reason-0
     2172       :
     2173         assign
     2174           v-diasize-orig-frame-height = frame fr-D-reason-0 :height
     2175           v-diasize-orig-frame-width  = frame fr-D-reason-0 :width
     2176           v-diasize-browse-handle     = browse br-reas :handle
     2177         .
     2178         create button v-diasize-resize-button
     2179         assign
     2180           parent        = frame fr-D-reason-0 :first-child
     2181           label         = "s"
     2182           height-pixels = 16
     2183           width-pixels  = 16
     2184           visible       = true
     2185           sensitive     = true
     2186           movable       = true
     2187           triggers:
     2188             on end-move persistent run diasize_end-move in this-procedure .
     2189           end triggers.
     2190         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2191         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2192         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2193         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2194         assign
     2195           v-diasize-wndmax = false
     2196         .
     2197         if connected("ub") = true
     2198         then do:
     2199           define variable v-cntxt-db-num        as integer   no-undo .
     2200           define variable v-cntxt-userid        as character no-undo .
     2201           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2202                                             , OUTPUT v-cntxt-userid
     2203                                             ) .
     2204           run gbl/wndpar_r.p
     2205             (input  v-cntxt-db-num
     2206             ,input  v-cntxt-userid
     2207             ,input  'wndmax':U
     2208             ,output v-diasize-wndmax
     2209             ,output v-default-value
     2210             ) .
     2211         end.
     2212         assign
     2213           v-diasize-wndstore = false
     2214         .
     2215         if connected("ub") = true
     2216         then do:
     2217           run gbl/wndpar_r.p
     2218             (input  v-cntxt-db-num
     2219             ,input  v-cntxt-userid
     2220             ,input  'wndstore':U
     2221             ,output v-diasize-wndstore
     2222             ,output v-default-value
     2223             ) .
     2224         end.
     2225         assign
     2226           v-diasize-proc-name = entry(1, program-name(2), '.')
     2227         .
     2228         if v-diasize-wndstore = true
     2229         then do:
     2230           assign
     2231             v-restore-saved = false
     2232           .
     2233           if connected("ub") = true
     2234           then do:
     2235             run gbl/wndsizer.p
     2236               (input  v-cntxt-db-num
     2237               ,input  v-cntxt-userid
     2238               ,input  v-diasize-proc-name
     2239               ,input  'height':u
     2240               ,output v-resize-value-str
     2241               ) .
     2242             if v-resize-value-str <> '':U
     2243             then do:
     2244               run diasize_change-height in this-procedure
     2245                 (input  integer(v-resize-value-str)
     2246                 ,input  true
     2247                 ) .
     2248               assign
     2249                 v-restore-saved = true
     2250               .
     2251             end.
     2252           end.
     2253           if connected("ub") = true
     2254           then do:
     2255             run gbl/wndsizer.p
     2256               (input  v-cntxt-db-num
     2257               ,input  v-cntxt-userid
     2258               ,input  v-diasize-proc-name
     2259               ,input  'width':u
     2260               ,output v-resize-value-str
     2261               ) .
     2262             if v-resize-value-str <> '':U
     2263             then do:
     2264               run diasize_change-width in this-procedure
     2265                 (input  integer(v-resize-value-str)
     2266                 ,input  true
     2267                 ) .
     2268               assign
     2269                 v-restore-saved = true
     2270               .
     2271             end.
     2272           end.
     2273           if v-restore-saved <> true
     2274           then do:
     2275             if v-diasize-wndmax = true
     2276             then do:
     2277               run diasize_maximize in this-procedure
     2278                 (input  true
     2279                 ) .
     2280             end.
     2281           end.
     2282         end.
     2283         else do:
     2284           if v-diasize-wndmax = true
     2285           then do:
     2286             run diasize_maximize in this-procedure
     2287               (input  true
     2288               ) .
     2289           end.
     2290         end.
     2291       end.
     2292     end.
     2293   end procedure.
     2294   procedure diasize_need-full-display :
     2295     define output parameter p-need-full-display as logical   no-undo .
     2296     do
     2297     on error undo, return error return-value
     2298     :
     2299       assign
     2300         p-need-full-display = v-diasize-need-full-display
     2301       .
     2302       assign
     2303         v-diasize-need-full-display = false
     2304       .
     2305     end.
     2306   end procedure.
     2307   procedure get-context :
     2308      define output parameter p-db-num as integer          no-undo.
     2309      define output parameter p-user-id as character        no-undo.
     2310      define variable v-login               as character    no-undo.
     2311      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2312      define buffer buf_user-login  for ub.user-login .
     2313      do
     2314      on error undo, return error
     2315      :
     2316            FIND FIRST buf_sys-ctrl no-lock.
     2317            ASSIGN
     2318               v-login = USERID("ub")
     2319               p-db-num = buf_sys-ctrl.db-num
     2320            .
     2321            FIND FIRST buf_user-login
     2322                 WHERE buf_user-login.db-num = p-db-num
     2323                   AND buf_user-login.user-login = v-login
     2324                 no-lock
     2325                 no-error
     2326                 .
     2327            IF AVAILABLE buf_user-login
     2328            THEN DO:
     2329               assign
     2330                  p-user-id = buf_user-login.user-id
     2331               .
     2332            END.
     2333      end.
     2334   end procedure.
     2335       run diasize_init in this-procedure .
     2336   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2337   DEF VAR cur-clmn-numbr-reas as INT EXTENT 4 no-undo.
     2338   DEF VAR varmvibr-reas       as INT no-undo.
     2339   DEF VAR varmvjbr-reas       as INT no-undo.
     2340   DEF VAR varmvkbr-reas       as INT no-undo.
     2341   DEF VAR varmvlbr-reas       as INT no-undo.
     2342   DEF VAR move-elementbr-reas as INT no-undo.
     2343   def var jjbr-reas           as int no-undo.
     2344   do varmvibr-reas = 1 to EXTENT(cur-clmn-numbr-reas):
     2345     ASSIGN cur-clmn-numbr-reas[varmvibr-reas] = varmvibr-reas.
     2346   END.
     2347   RUN start-mv-clmnbr-reas.
     2348   PROCEDURE start-mv-clmnbr-reas:
     2349   def var old-session as logical no-undo.
     2350      old-session = SESSION:IMMEDIATE-DISPLAY.
     2351      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2352      SESSION:IMMEDIATE-DISPLAY = old-session.
     2353   END.
     2354   ON ctrl-cursor-right OF BROWSE br-reas do:
     2355     RUN re-move-clmnbr-reas ( 1, 4).
     2356   END.
     2357   ON ctrl-cursor-left OF BROWSE br-reas do:
     2358     RUN re-move-clmnbr-reas (4, 1).
     2359   END.
     2360   PROCEDURE re-move-clmnbr-reas:
     2361     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2362     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2363     DO varmvibr-reas = 1 TO EXTENT(cur-clmn-numbr-reas):
     2364       if cur-clmn-numbr-reas[varmvibr-reas] = source-column THEN cur-clmn-numbr-reas[varmvibr-reas] = -1.
     2365     END.
     2366     if br-reas:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-reason-0 then.
     2367     if source-column > target-column THEN
     2368     DO varmvjbr-reas = source-column - 1 to target-column BY -1:
     2369       DO varmvibr-reas = 1 TO EXTENT(cur-clmn-numbr-reas):
     2370           if cur-clmn-numbr-reas[varmvibr-reas] = varmvjbr-reas THEN DO:
     2371             cur-clmn-numbr-reas[varmvibr-reas] = cur-clmn-numbr-reas[varmvibr-reas] + 1.
     2372           END.
     2373       END.
     2374     END.
     2375     ELSE
     2376     DO varmvjbr-reas = source-column + 1 to target-column:
     2377       DO varmvibr-reas = 1 TO EXTENT(cur-clmn-numbr-reas):
     2378         if cur-clmn-numbr-reas[varmvibr-reas] = varmvjbr-reas THEN DO:
     2379           cur-clmn-numbr-reas[varmvibr-reas] = cur-clmn-numbr-reas[varmvibr-reas] - 1.
     2380         END.
     2381       END.
     2382     END.
     2383     DO varmvibr-reas = 1 TO EXTENT(cur-clmn-numbr-reas):
     2384       if cur-clmn-numbr-reas[varmvibr-reas] = -1 THEN cur-clmn-numbr-reas[varmvibr-reas] = target-column.
     2385     END.
     2386   END PROCEDURE.
     2387   PROCEDURE ch-clmnbr-reas:
     2388     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2389     if cur-clmn-loc <= 1 then do:
     2390       return .
     2391     end.
     2392     DO varmvibr-reas = 1 TO EXTENT(cur-clmn-numbr-reas):
     2393       if cur-clmn-numbr-reas[varmvibr-reas] = cur-clmn-loc THEN move-elementbr-reas = varmvibr-reas.
     2394     END.
     2395     RUN re-move-clmnbr-reas (cur-clmn-loc, 1).
     2396   END PROCEDURE.
     2397   PROCEDURE mv-brw-defaultbr-reas:
     2398   def var old-session as logical no-undo.
     2399     old-session = SESSION:IMMEDIATE-DISPLAY.
     2400     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2401     do varmvlbr-reas = 1 to EXTENT(cur-clmn-numbr-reas):
     2402       RUN re-move-clmnbr-reas (cur-clmn-numbr-reas[varmvlbr-reas], varmvlbr-reas).
     2403     END.
     2404     RUN start-mv-clmnbr-reas.
     2405     SESSION:IMMEDIATE-DISPLAY = old-session.
     2406   END PROCEDURE.
     2407   .
     2408   def var sort-labelbr-reas   as character no-undo .
     2409   def var sort-clmnbr-reas    as handle    no-undo .
     2410   def var cur-clmnbr-reas     as handle    no-undo .
     2411   def var cur-clmn-locbr-reas as integer   no-undo .
     2412   def var re-querybr-reas     as logical   initial no no-undo .
     2413   on start-search, ctrl-o of br-reas in frame fr-D-reason-0 do:
     2414      run sort-brbr-reas
     2415        (input (if available X_trn-reason
     2416                then recid(X_trn-reason)
     2417                else ?
     2418               )
     2419        ).
     2420   end.
     2421   PROCEDURE sort-brbr-reas :
     2422     define input parameter p-recid as recid no-undo .
     2423     if re-querybr-reas = no then do:
     2424       assign
     2425          cur-clmnbr-reas = br-reas:current-column in frame fr-D-reason-0
     2426       .
     2427       if sort-clmnbr-reas <> ? then sort-clmnbr-reas:column-fgcolor = 0.
     2428       if cur-clmnbr-reas = sort-clmnbr-reas then do:
     2429         assign
     2430            sort-labelbr-reas = ""
     2431            sort-clmnbr-reas = ?
     2432         .
     2433        end.
     2434        else do:
     2435          assign
     2436            sort-labelbr-reas = cur-clmnbr-reas:label
     2437            sort-clmnbr-reas  = cur-clmnbr-reas
     2438            sort-clmnbr-reas:column-fgcolor = 4
     2439          .
     2440        end.
     2441      end.
     2442     assign
     2443       cur-clmn-locbr-reas = 1
     2444     .
     2445     def var column-handle as handle no-undo .
     2446     column-handle = br-reas:first-column.
     2447     do while valid-handle(column-handle) :
     2448       if column-handle = cur-clmnbr-reas then do:
     2449         leave .
     2450       end.
     2451       column-handle = column-handle:NEXT-COLUMN.
     2452       assign
     2453         cur-clmn-locbr-reas = cur-clmn-locbr-reas + 1
     2454       .
     2455     end.
     2456     case sort-labelbr-reas:
     2457           when 'Код основания'  then DO:    assign       sort-column-name = "X_trn-reason.reason-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2458           when 'Основание (причина) создания документа'  then DO:    assign       sort-column-name = "X_trn-reason.reason-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2459           when 'Примечание'  then DO:    assign       sort-column-name = "X_trn-reason.PS"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2460       otherwise do:
     2461         assign
     2462           sort-column-name = ""
     2463         .
     2464         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2465           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-reas') then do:
     2466             run mv-brw-defaultbr-reas.
     2467           end.
     2468         if sort-labelbr-reas <> "" then do:
     2469           assign
     2470             cur-clmnbr-reas:column-fgcolor = 0
     2471           .
     2472         end.
     2473         assign
     2474           cur-clmn-locbr-reas = ?
     2475         .
     2476       end.
     2477     end case.
     2478     if p-recid <> ? then do:
     2479       reposition br-reas to recid p-recid no-error.
     2480       apply "value-changed" to br-reas in frame fr-D-reason-0.
     2481     end.
     2482     apply "entry" to br-reas in frame fr-D-reason-0.
     2483   END PROCEDURE.
     2484   procedure re-open-query-srt-clmnbr-reas:
     2485   if cur-clmnbr-reas = ? then do:
     2486      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2487   end.
     2488   else do:
     2489      assign re-querybr-reas = yes.
     2490      run sort-brbr-reas
     2491        (input (if available X_trn-reason
     2492                then recid(X_trn-reason)
     2493                else ?
     2494               )
     2495        ).
     2496      assign re-querybr-reas = no.
     2497   end.
     2498   end.
     2499   Main-Block:
     2500   do on error   undo Main-Block, leave Main-Block
     2501      on end-key undo Main-Block, leave Main-Block :
     2502     create one-empty-record.
     2503     display   PS-notes     with frame fr-D-reason-0.
     2504     enable  b-sch  b-help b-History b-quit b-lkp
     2505             tb-deleted
     2506             br-reas   sch-code  sch-name    PS-notes
     2507     with frame fr-D-reason-0.
     2508     if p-mode = 'справочник':U then do:
     2509       if v-cntxt-db-num = 0 then do:
     2510         enable
     2511         b-add b-chg b-del
     2512         with frame fr-D-reason-0.
     2513       end.
     2514       else do:
     2515         disable
     2516         b-add b-chg b-del tb-deleted
     2517         with frame fr-D-reason-0.
     2518       end.
     2519       disable
     2520       b-sel with frame fr-D-reason-0.
     2521     end.
     2522     else if p-mode = 'выбор':U then do:
     2523       enable
     2524       b-sel with frame fr-D-reason-0.
     2525       disable
     2526       b-add b-chg b-del tb-deleted
     2527       with frame fr-D-reason-0.
     2528     end.
     2529     find first X_trn-reason no-lock where
     2530                X_trn-reason.reason-code = p-code no-error.
     2531     assign
     2532     ref-rec = ( if available X_trn-reason then recid( X_trn-reason ) else ? ).
     2533     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2534     RUN my-enable IN THIS-PROCEDURE .
     2535     hide sch-num in frame fr-D-reason-0.
     2536     br-reas :set-repositioned-row( 5, "CONDITIONAL":U ).
     2537     if ref-rec <> ? then do:
     2538       reposition br-reas to recid ref-rec no-error.
     2539       if error-status :error then do: reposition br-reas to row 1 no-error. end.
     2540                              else do: assign v-doc-rec = ref-rec. end.
     2541     end.
     2542     wait-for go of frame fr-D-reason-0.
     2543   end.
     2544   hide frame fr-D-reason-0 no-pause.
     2545   procedure OpenBr :
     2546     define input parameter p-open-query     as logical   no-undo.
     2547     define input parameter p-find-next      as logical   no-undo.
     2548     define input parameter p-find-condition as character no-undo.
     2549     define variable l-query-was-opened as logical   no-undo.
     2550     define variable sort-column-phrase as character no-undo.
     2551     define variable p-proc-hand        as handle    no-undo.
     2552     define variable l-open-query       as logical   no-undo.
     2553     assign
     2554      p-proc-hand = this-procedure :handle
     2555     .
     2556     case sort-column-name :
     2557       when "":U                    then do:
     2558         assign sort-column-phrase = "":U.
     2559       end.
     2560       when "X_trn-reason.reason-name" then do:
     2561         assign sort-column-phrase = "by substring( X_trn-reason.reason-name, 1, 79 )".
     2562       end.
     2563       when "X_trn-reason.PS"          then do:
     2564         assign sort-column-phrase = "by substring( X_trn-reason.PS,          1, 95 )".
     2565       end.
     2566       otherwise                         do:
     2567         assign sort-column-phrase = "by " + sort-column-name.
     2568       end.
     2569     end case.
     2570     assign
     2571     frame fr-D-reason-0 :title = substitute("&1 &2", 'Список оснований (причин) создания документа':U, p-mode).
     2572   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2573   define variable  l-disable-where-25  as logical   no-undo .
     2574   define variable  l-filter-open-25    as logical   .
     2575   define variable  flt-rec-25       as recid     no-undo .
     2576   define variable  filter-name-25      as character no-undo .
     2577   define variable  where-phrase-25     as character no-undo .
     2578   define variable  sort-phrase-25      as character no-undo .
     2579   define variable  where-phrase-rus-25 as character no-undo .
     2580   define variable  sort-phrase-rus-25  as character no-undo .
     2581     run waitfram-show in this-procedure
     2582       (input "ЖДИТЕ ..."
     2583       ).
     2584   run gbl/flt-get.p
     2585     (input filter-point
     2586     ,output flt-rec-25
     2587     ,output filter-name-25
     2588     ,output where-phrase-25
     2589     ,output sort-phrase-25
     2590     ,output where-phrase-rus-25
     2591     ,output sort-phrase-rus-25
     2592     ).
     2593   if p-open-query then do:
     2594       run set-filter-name in this-procedure
     2595         (INPUT filter-name-25
     2596         ) no-error .
     2597     assign
     2598       l-filter-open-25 = false
     2599     .
     2600     if flt-rec-25 <> ?
     2601       or sort-column-phrase > ""
     2602     then do:
     2603       define variable  parameter-2-25 as character no-undo .
     2604       define variable  parameter-3-25 as character no-undo .
     2605       define variable  parameter-4-25 as character no-undo .
     2606       define variable  parameter-5-25 as character no-undo .
     2607       define variable  parameter-6-25 as character no-undo .
     2608       define variable  parameter-7-25 as character no-undo .
     2609         assign
     2610         parameter-3-25 =
     2611                                 "for each X_trn-reason"
     2612         parameter-4-25 =
     2613           (
     2614             if (" YES " + " " + where-phrase-25) <> ""
     2615             then " YES " + " " + where-phrase-25
     2616             else "true"
     2617           )
     2618         parameter-5-25 = (" " + "" + " " + SUBSTITUTE(', first buf_trn-rsn-attr outer-join of X_trn-reason no-lock, first one-empty-record no-lock WHERE YES AND ((NOT AVAILABLE buf_trn-rsn-attr) OR (&1 = TRUE))', tb-deleted))
     2619         parameter-6-25 = if sort-phrase-25 = ''
     2620                              then
     2621           (
     2622           " " + "  " +
     2623             " " + sort-column-phrase +
     2624           " " + "  "
     2625           )
     2626                              else
     2627           (
     2628           " " + "  " +
     2629             " " + sort-column-phrase +
     2630           " " + sort-phrase-25
     2631           )
     2632         parameter-7-25 =
     2633           " indexed-reposition  "
     2634       .
     2635       do
     2636       on stop undo, leave
     2637       on error undo, leave
     2638       :
     2639         assign
     2640           l-disable-where-25 =
     2641             (" YES " + " " + where-phrase-25 = "")
     2642         .
     2643         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2644                             ,input query br-reas:handle
     2645                             ,input parameter-3-25
     2646                             ,input parameter-4-25
     2647                             ,input parameter-5-25
     2648                             ,input parameter-6-25
     2649                             ,input parameter-7-25
     2650                             )
     2651         .
     2652         assign
     2653           l-filter-open-25 = true
     2654         .
     2655       end.
     2656       if l-filter-open-25 = false then do:
     2657         message
     2658           "Ошибка при фильтрации / сортировке" skip
     2659           "Будут показаны записи без учета фильтра" skip
     2660           view-as alert-box .
     2661       end.
     2662       else do:
     2663           assign
     2664             l-query-was-opened = true
     2665           .
     2666       end.
     2667     end.
     2668     if l-filter-open-25 = false then do:
     2669       open query br-reas for each X_trn-reason no-lock
     2670         where  YES
     2671       , first buf_trn-rsn-attr outer-join of X_trn-reason no-lock, first one-empty-record no-lock WHERE YES AND ((NOT AVAILABLE buf_trn-rsn-attr) OR (tb-deleted = TRUE))
     2672         indexed-reposition
     2673     .
     2674         assign
     2675           l-query-was-opened = true
     2676         .
     2677     end.
     2678   end.
     2679   else do:
     2680     assign
     2681       v-doc-rec = recid( X_trn-reason )
     2682     .
     2683     do
     2684     on stop undo, leave
     2685     on error undo, leave
     2686     :
     2687       if query br-reas:handle:get-buffer-handle(1) = (buffer X_trn-reason:handle) then do:
     2688         assign
     2689         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     2690         parameter-4-25 =
     2691           "where ":u + " YES " + " ":u + where-phrase-25 + " ":u + p-find-condition + " " + ""
     2692         parameter-5-25 = "  "
     2693       .
     2694         run fltopend_fltfindd in this-procedure  (
     2695                             input this-procedure:handle
     2696                             ,input query br-reas:handle
     2697                             ,input rowid(X_trn-reason)
     2698                             ,input logical(parameter-2-25)
     2699                             ,input no-lock
     2700                             ,input (buffer X_trn-reason:handle)
     2701                             ,input parameter-4-25
     2702                             ,input parameter-5-25
     2703                             ) no-error.
     2704         .
     2705         assign
     2706           v-doc-rec = integer(return-value)
     2707           v-fltopend-rowid[1] = ?
     2708         .
     2709       end.
     2710       else do:
     2711         assign
     2712         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     2713         parameter-3-25 =  "for each X_trn-reason"
     2714         parameter-4-25 =
     2715           (
     2716             if (" YES " + " " + where-phrase-25) <> ""
     2717             then " YES " + " " + where-phrase-25
     2718             else "true"
     2719           )
     2720         parameter-5-25 = (" " + "" + " " + SUBSTITUTE(', first buf_trn-rsn-attr outer-join of X_trn-reason no-lock, first one-empty-record no-lock WHERE YES AND ((NOT AVAILABLE buf_trn-rsn-attr) OR (&1 = TRUE))', tb-deleted) + " " + p-find-condition)
     2721         parameter-6-25 = if sort-phrase-25 = ''
     2722                              then
     2723           (
     2724           " " + "  " +
     2725             " " + sort-column-phrase +
     2726           " " + "  "
     2727           )
     2728                              else
     2729           (
     2730           " " + "  " +
     2731             " " + sort-column-phrase +
     2732           " " + sort-phrase-25
     2733           )
     2734         parameter-7-25 =
     2735           " indexed-reposition  "
     2736       .
     2737         run fltopend_fltfindq in this-procedure  (
     2738                             input this-procedure:handle
     2739                             ,input query br-reas:handle
     2740                             ,input logical(parameter-2-25)
     2741                             ,input no-lock
     2742                             ,input parameter-3-25
     2743                             ,input parameter-4-25
     2744                             ,input parameter-5-25
     2745                             ,input parameter-6-25
     2746                             ,input parameter-7-25
     2747                             ,output v-fltopend-rowid
     2748                             ) no-error.
     2749         .
     2750         v-doc-rec = ?.
     2751       end.
     2752       assign
     2753         l-query-was-opened = true
     2754       .
     2755     end.
     2756   end.
     2757     run waitfram-hide in this-procedure .
     2758   if p-open-query <> yes and v-doc-rec <> ? then
     2759   reposition br-reas to recid v-doc-rec no-error.
     2760   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2761   query br-reas:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2762   apply "VALUE-CHANGED":U to br-reas in frame fr-D-reason-0.
     2763   apply "ENTRY":U         to br-reas in frame fr-D-reason-0.
     2764   end procedure.
     2765   procedure proc-filter :
     2766     assign tbl      = 'trn-reason'
     2767            join-tbl = 'X_trn-reason'
     2768            fld      = '':U
     2769            lab      = '':U
     2770            spr      = '':U
     2771            dim      = '0'.
     2772       run fltfield-add in this-procedure ( input 'reason-code', input 'Код причины',         input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2773     run fltfield-add in this-procedure ( input 'reason-name', input 'Основание (причина)', input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2774     run fltfield-add in this-procedure ( input 'PS',          input 'Примечание',          input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2775     Filter-Block:
     2776     do on error   undo Filter-Block, leave Filter-Block
     2777        on end-key undo Filter-Block, leave Filter-Block :
     2778       run gbl/filter.w ( input parParentProc
     2779                      ,input filter-point + chr(4) + filter-label
     2780                      ,input tbl
     2781                      ,input join-tbl
     2782                      ,input fld
     2783                      ,input lab
     2784                      ,input spr
     2785                      ,input dim            ).
     2786       if return-value = 'undo':U then do:
     2787         apply "ENTRY":U to browse br-reas.
     2788         return no-apply.
     2789       end.
     2790       assign sch-num = 0.
     2791       hide   sch-num in frame fr-D-reason-0.
     2792       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2793     end.
     2794   end procedure.
     2795   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2796   procedure set-filter-name :
     2797   define input parameter p-filter-name as character no-undo .
     2798     do with frame fr-D-reason-0:
     2799       if p-filter-name > "" then do:
     2800         assign
     2801           frame fr-D-reason-0:title
     2802             = frame fr-D-reason-0:title + "   ФИЛЬТР: " + p-filter-name.
     2803         .
     2804         assign
     2805           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2806         .
     2807       end.
     2808       else do:
     2809         assign
     2810           b-sch :tooltip = ""
     2811         .
     2812       end.
     2813     end.
     2814   end procedure.
     2815   procedure proc-find-code :
     2816     define input parameter p-next as logical no-undo.
     2817     define input parameter p-code as integer no-undo.
     2818     run OpenBr in this-procedure ( input no, input p-next, input substitute( ' AND X_trn-reason.reason-code = &1 ', p-code ) ).
     2819     if v-doc-rec <> ? then do:
     2820       if FoundRec = ? then do:
     2821         assign FoundRec = v-doc-rec.
     2822       end.
     2823       if FoundRec = v-doc-rec then do:
     2824         assign sch-num = 0.
     2825       end.
     2826       assign  sch-num = sch-num + 1.
     2827       display
     2828       sch-num with frame fr-D-reason-0.
     2829     end.
     2830     else do:
     2831       assign  sch-num = 0.
     2832       hide    sch-num
     2833       in frame fr-D-reason-0.
     2834     end.
     2835     apply "ENTRY":U to sch-code in frame fr-D-reason-0.
     2836   end procedure.
     2837   procedure proc-find-name :
     2838     define input parameter p-next as logical   no-undo.
     2839     define input parameter p-name as character no-undo.
     2840     assign p-name = replace( p-name, chr(34), chr(34) + chr(34) )
     2841            p-name = replace( p-name, chr(39), chr(39) + chr(39) )
     2842            p-name = chr(34) + p-name + chr(34).
     2843     run OpenBr in this-procedure ( input no,
     2844                                    input p-next,
     2845                                    input substitute( ' AND X_trn-reason.reason-name begins &1 ', p-name ) ).
     2846     if v-doc-rec <> ? then do:
     2847       if FoundRec = ? then do:
     2848         assign FoundRec = v-doc-rec.
     2849       end.
     2850       if FoundRec = v-doc-rec then do:
     2851         assign sch-num = 0.
     2852       end.
     2853       assign  sch-num = sch-num + 1.
     2854       display sch-num
     2855       with frame fr-D-reason-0.
     2856     end.
     2857     else do:
     2858       assign  sch-num = 0.
     2859       hide    sch-num
     2860       in frame fr-D-reason-0.
     2861     end.
     2862     apply "ENTRY":U to sch-name in frame fr-D-reason-0.
     2863   end procedure.
     2864   procedure proc-delete :
     2865     define variable l_log as logical no-undo.
     2866     run ref/trn-rsn1.p
     2867       ( input-output v-doc-rec
     2868       , input 'удаление':U
     2869       , input false
     2870       , input "":U
     2871       , input "":U
     2872       , input "":U
     2873       ) no-error.
     2874     if error-status:error then do:
     2875       message
     2876         substitute("Ошибка при удалении основания (причины)") skip
     2877         error-status :get-message(1) skip
     2878         return-value skip
     2879         view-as alert-box error .
     2880       undo, return error .
     2881     end.
     2882     get prev br-reas no-lock.
     2883     if not available X_trn-reason then do:
     2884       get prev br-reas no-lock.
     2885     end.
     2886     if not available X_trn-reason then do:
     2887       get next br-reas no-lock.
     2888     end.
     2889     assign
     2890       v-doc-rec = ( if available X_trn-reason then recid( X_trn-reason ) else ? )
     2891     .
     2892     reposition br-reas to recid v-doc-rec no-error.
     2893     if error-status :error then do:
     2894       reposition br-reas to row 1 no-error.
     2895     end.
     2896     apply "ENTRY":U         to br-reas in frame fr-D-reason-0.
     2897     apply "VALUE-CHANGED":U to br-reas in frame fr-D-reason-0.
     2898   end procedure.
     2899   procedure get-attr-sign :
     2900     define  input parameter p-code as integer   no-undo.
     2901     define output parameter p-attr as character no-undo.
     2902     define buffer buf_attr for ub.trn-rsn-attr.
     2903     do on error   undo, leave
     2904        on end-key undo, leave :
     2905       find first buf_attr no-lock where
     2906                  buf_attr.reason-code = p-code no-error.
     2907       assign p-attr = ( if available buf_attr then "+":U else " ":U ).
     2908     end.
     2909   end procedure.
     2910   procedure my-enable :
     2911   do
     2912   on error undo, return error
     2913   :
     2914      define buffer buf_trn-rsn-attr      for ub.trn-rsn-attr .
     2915      IF CAN-FIND(first buf_trn-rsn-attr
     2916                  where buf_trn-rsn-attr.reason-code = X_trn-reason.reason-code
     2917                    and buf_trn-rsn-attr.attr-code   = "del":U
     2918               no-lock)
     2919      THEN DO:
     2920         disable
     2921            b-chg b-del
     2922         with frame fr-D-reason-0.
     2923      END.
     2924      ELSE DO:
     2925        if   p-mode = 'справочник':U
     2926        AND  v-cntxt-db-num = 0 then do:
     2927         enable
     2928            b-chg b-del
     2929         with frame fr-D-reason-0.
     2930         END.
     2931      END.
     2932   end.
     2933   end procedure.
