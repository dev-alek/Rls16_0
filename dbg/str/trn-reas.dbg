        1   define input        parameter parParentProc as widget-handle no-undo.
        2   define input        parameter p-mode        as character     no-undo.
        3   define input-output parameter p-code        as integer       no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision$":U.
        5   define variable vss-author      as character no-undo initial "$Author$":U.
        6   define variable vss-date        as character no-undo initial "$Date$":U.
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        8   define variable vss-archive     as character no-undo initial "$Archive$":U.
        9   define variable vss-description as character no-undo initial "Список оснований (причин) создания документа":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable c-point  as character no-undo .
      115   define variable tbl      as character no-undo .
      116   define variable join-tbl as character no-undo .
      117   define variable fld      as character no-undo .
      118   define variable lab      as character no-undo .
      119   define variable spr      as character no-undo .
      120   define variable dim      as character no-undo .
      121   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable v-waitfram-action01         as character   no-undo .
      123   define variable v-waitfram-action02         as character   no-undo .
      124   define variable v-waitfram-action03         as character   no-undo .
      125   define variable mWaitFramTextBeg            as character   no-undo.
      126   define variable mWaitFramTextEnd            as character   no-undo.
      127   define variable mWaitFramView               as logical     no-undo.
      128   define variable mWaitProcEvent              as logical     no-undo init yes.
      129   define variable mWaitFramInterval           as integer     no-undo init 1 .
      130   define variable mWaitFramStop               as logical     no-undo.
      131   define variable mWaitFramStopUser           as logical     no-undo.
      132   define variable mWaitFramStopTimeOut        as logical     no-undo.
      133   define variable mWaitFramStartProc          as datetime-tz no-undo.
      134   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      135   define button B-WaitFramStop auto-end-key
      136        label "Стоп"
      137        size 10 by 1 tooltip "Остоновить процесс".
      138   define button B-viewProcInfo
      139        label "Информация"
      140        size 15 by 1 tooltip "Информация о процесс".
      141   define frame waitfram
      142     v-waitfram-action01 format "x(72)" no-label skip
      143     v-waitfram-action02 format "x(72)" no-label skip
      144     v-waitfram-action03 format "x(72)" no-label skip
      145     B-viewProcInfo
      146     B-WaitFramStop at row 4 col 30
      147     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      148     .
      149   define new global shared variable mBatchMode as logical no-undo init ?.
      150   define variable mFramBachModHandle as handle no-undo.
      151   mFramBachModHandle = frame waitfram:handle.
      152   define variable mFameOldVis as logical no-undo.
      153   define variable mVisCUrentVin as logical no-undo.
      154   if session:batch-mode
      155   then
      156      mBatchMode = yes.
      157   if mBatchMode = ? then do:
      158     mVisCUrentVin = current-window:visible.
      159     mFameOldVis = mFramBachModHandle:visible.
      160     mFramBachModHandle:visible  = yes.
      161     mBatchMode = mFramBachModHandle:visible ne yes.
      162     mFramBachModHandle:visible = mFameOldVis.
      163     current-window:visible = mVisCUrentVin.
      164   end.
      165    if  log-manager:logfile-name ne ?
      166     then DO:
      167         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      168         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      169         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      170     end.
      171   on choose of B-WaitFramStop in frame waitfram
      172   do:
      173     mWaitFramStop = yes.
      174     mWaitFramStopUser = yes.
      175   end.
      176   function waitfram-check-timeout returns logical():
      177      define variable vtime as int64 no-undo.
      178      if mWaitFramStopTimeOut
      179      then
      180         return yes.
      181      vtime = ( now - mWaitFramStartProc ) / 1000 .
      182      if     mWaitFramTimeOut ne ?
      183         and mWaitFramTimeOut ne 0
      184         and mWaitFramTimeOut lt vtime
      185      then do:
      186         mWaitFramStopTimeOut = yes.
      187      end.
      188      return mWaitFramStopTimeOut.
      189   end.
      190   procedure waitfram-hide :
      191     if not session:batch-mode
      192     then do
      193     on error undo, return error return-value
      194     :
      195       pause 0 before-hide .
      196       if not mBatchMode then
      197         hide frame waitfram .
      198     if     not mWaitFramView
      199        and mWaitProcEvent
      200     then
      201       process events .
      202     end.
      203   end procedure.
      204   procedure waitfram-show :
      205     define input  parameter p-message as character no-undo .
      206     define variable v-left-margin as integer   no-undo .
      207     if not session:batch-mode
      208     then do
      209     on error undo, return error return-value
      210     :
      211       if length(p-message) <= 70 then do:
      212         assign
      213           v-left-margin = integer((70 - length(p-message)) / 2)
      214         .
      215         assign
      216           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      217         .
      218         assign
      219           v-waitfram-action01 = " "
      220           v-waitfram-action02 = " "
      221                                    + fill(" ", v-left-margin)
      222                                    + p-message
      223           v-waitfram-action03 = " "
      224         .
      225       end.
      226       else do:
      227         define variable vRindex1 as integer no-undo.
      228         define variable vRindex2 as integer no-undo.
      229         vRindex1 = r-index(p-message," ",70).
      230         if vRindex1 = 0
      231         then
      232            vRindex1 = 70.
      233         if length(p-message)  <= vRindex1 + 70 then do:
      234           assign
      235             v-waitfram-action01 = " "
      236             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      237             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      238           .
      239         end.
      240         else do:
      241           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      242           if vRindex2 <= vRindex1
      243           then
      244              vRindex2 = vRindex1 + 70.
      245           assign
      246             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      247             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      248             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      249           .
      250         end.
      251       end.
      252       B-viewProcInfo:visible   in frame waitfram = no.
      253       B-viewProcInfo:sensitive in frame waitfram = no.
      254       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      255       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      256       if  (   mWaitFramView
      257          or  mWaitProcEvent)
      258          and not mBatchMode
      259       then
      260          display
      261             v-waitfram-action01 skip
      262             v-waitfram-action02 skip
      263             v-waitfram-action03 skip
      264          with frame waitfram .
      265       if     mWaitFramView
      266          then do:
      267             if     mWaitFramInterval ne ?
      268                and not mBatchMode
      269             then
      270                wait-for go of frame waitfram pause mWaitFramInterval.
      271          end.
      272          else
      273             if     mWaitProcEvent
      274                and not mBatchMode
      275             then
      276                process events .
      277     end.
      278   end procedure.
      279      procedure waitfram-show-this:
      280         define input  parameter iInterval as int64 no-undo.
      281         define variable vtime as int64 no-undo.
      282         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      283         mWaitFramInterval = iInterval.
      284         run waitfram-show (substitute("&1&2 &3&4" ,
      285                                       mWaitFramTextBeg ,
      286                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      287                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      288                                       mWaitFramTextEnd
      289                                      )
      290                           ).
      291      end.
      292      procedure WaitFramRunPause:
      293         define input  parameter iInterval as dec no-undo.
      294         define variable vStart  as datetime-tz no-undo.
      295         define variable vend    as datetime-tz no-undo.
      296         define variable vint as int64 no-undo.
      297         define variable vOk as logical no-undo.
      298         vStart = now.
      299         vend   = vStart.
      300         publish "WaitFramPause" (iInterval,output vOk).
      301         vend   =  now.
      302         vint = vend - vStart.
      303         vint = iInterval - vint / 1000.
      304         if     not mWaitFramStop
      305            and (   vint > 0
      306                 or (    not vOk
      307                     and iInterval eq ?
      308                     )
      309                 )
      310         then
      311            run waitfram-show-this (iInterval).
      312         vend   =  now.
      313         vint = vend - vStart.
      314         vint = iInterval - vint / 1000.
      315         if     not mWaitFramStop
      316            and vint > 0
      317         then do:
      318            run gbl/pause.p (vint * 1000).
      319         end.
      320         if iInterval ne ?
      321         then
      322            publish "WaitFramStop".
      323         waitfram-check-timeout().
      324      end.
      325      procedure WaitFramWaitFor:
      326         define input  parameter iInterval as dec no-undo.
      327         assign
      328            mWaitFramStartProc   = now
      329            mWaitFramStopUser    = no
      330            mWaitFramStopTimeOut = no
      331         .
      332         block-wait:
      333         do while not mWaitFramStop:
      334            run WaitFramRunPause (iInterval).
      335            if  waitfram-check-timeout()
      336            then do:
      337               leave block-wait.
      338            end.
      339         end.
      340         run waitfram-hide.
      341      end.
      342   procedure waitfram-join :
      343     define input  parameter p-line-1  as character no-undo .
      344     define input  parameter p-line-2  as character no-undo .
      345     define input  parameter p-line-3  as character no-undo .
      346     define output parameter p-message as character no-undo .
      347     do
      348     on error undo, return error return-value
      349     :
      350       assign
      351         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      352                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      353                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      354       .
      355     end.
      356   end procedure.
      357   function waitfram-join-function returns character
      358     (input p-line-1 as character
      359     ,input p-line-2 as character
      360     ,input p-line-3 as character
      361     ).
      362     define variable v-message as character no-undo .
      363     run waitfram-join in this-procedure
      364       (input  p-line-1
      365       ,input  p-line-2
      366       ,input  p-line-3
      367       ,output v-message
      368       ) .
      369     return v-message .
      370   end function .
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   procedure fltfield-clear :
      373     define output parameter loc-fld as character no-undo.
      374     define output parameter loc-lab as character no-undo .
      375     define output parameter loc-spr as character no-undo .
      376     define output parameter loc-dim as character no-undo .
      377     assign
      378       loc-fld = ""
      379       loc-lab = ""
      380       loc-spr = ""
      381       loc-dim = "0"
      382     .
      383   end procedure .
      384   procedure fltfield-add :
      385     define input        parameter par-fld as character no-undo.
      386     define input        parameter par-lab as character no-undo .
      387     define input        parameter par-spr as character no-undo .
      388     define input-output parameter loc-fld as character no-undo.
      389     define input-output parameter loc-lab as character no-undo .
      390     define input-output parameter loc-spr as character no-undo .
      391     define input-output parameter loc-dim as character no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       assign
      396       loc-fld = if loc-dim = '0'
      397                 then par-fld
      398                 else (loc-fld + chr(44) + par-fld)
      399       loc-lab = if loc-dim = '0'
      400                 then par-lab
      401                 else (loc-lab + chr(44) + par-lab)
      402       loc-spr = if loc-dim = '0'
      403                 then par-spr
      404                 else (loc-spr + chr(44) + par-spr)
      405       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      406                 string(integer(if num-entries(loc-dim) > 1
      407                               then entry(2, loc-dim)
      408                               else entry(1, loc-dim)
      409                               ) + 1)
      410       no-error
      411       .
      412     end.
      413   end procedure.
      414   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      416   procedure fltopend_fltopend :
      417   define input parameter p-parent-handle as handle no-undo .
      418   define input parameter p-qh as handle no-undo .
      419   define input parameter p-flt-open-open-query  as character no-undo .
      420   define input parameter p-where-cond as character no-undo .
      421   define input parameter p-use-indFIRST-query-tail as character no-undo .
      422   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      423   define input parameter p-indexed-reposition as character no-undo .
      424     do
      425     on error undo, return error
      426     :
      427   define variable v-prepare-string as character no-undo .
      428   define variable glog as logical no-undo .
      429   assign
      430   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      431                      p-where-cond + chr(32)  +
      432                      p-use-indFIRST-query-tail + chr(32) +
      433                      p-use-ind-sort-clmn-by + chr(32) +
      434                      p-indexed-reposition
      435   .
      436   assign
      437   glog = p-qh:query-prepare(v-prepare-string) no-error .
      438   if not glog
      439   or error-status:error then do:
      440     message error-status:get-message(1) view-as alert-box .
      441     undo, return error .
      442   end.
      443   assign
      444   glog = p-qh:query-open no-error .
      445   if not glog
      446   or error-status:error then do:
      447     message error-status:get-message(1) view-as alert-box .
      448     undo, return error .
      449   end.
      450     end.
      451   end procedure.
      452   procedure fltopend_fltfindd :
      453   define input parameter p-parent-handle as handle no-undo .
      454   define input parameter p-qh as handle no-undo .
      455   define input parameter p-rowid as rowid no-undo .
      456   define input parameter p-next as logical no-undo .
      457   define input parameter p-lock as integer no-undo .
      458   define input parameter p-bh as handle no-undo .
      459   define input parameter p-where-cond as character no-undo .
      460   define input parameter p-use-index-phrase as character no-undo .
      461   define variable glog as logical no-undo .
      462   define variable v-qh as handle no-undo .
      463   define variable v-bh as handle no-undo .
      464   define variable v-recid as recid no-undo .
      465   define variable v-prepare-string as character no-undo .
      466   do
      467   on error undo, return error
      468   on stop undo, return error
      469   :
      470     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      471     create buffer v-bh for table p-bh buffer-name p-bh:name.
      472     create query v-qh.
      473     v-qh:set-buffers(v-bh).
      474     v-prepare-string = substitute("for each &1 &2 &3"
      475                                     ,v-bh:name
      476                                     ,p-where-cond
      477                                     ,p-use-index-phrase).
      478     glog = v-qh:query-prepare(v-prepare-string) no-error.
      479     if not glog then do:
      480       delete object v-qh.
      481       delete object v-bh.
      482       undo, return error .
      483     end.
      484     glog = v-qh:query-open no-error .
      485     if not glog then do:
      486       delete object v-qh.
      487       delete object v-bh.
      488       undo, return error .
      489     end.
      490     if p-next then do:
      491       v-qh:reposition-to-rowid(p-rowid) no-error .
      492       glog = v-qh:get-next( p-lock) no-error .
      493       glog = v-qh:get-next( p-lock) no-error .
      494       if not glog or v-qh:query-off-end = yes then do:
      495         glog = v-qh:get-first( p-lock) no-error .
      496       end.
      497     end.
      498     else do:
      499       glog = v-qh:get-first( p-lock) no-error .
      500     end.
      501     v-recid = v-bh:recid no-error .
      502     delete object v-qh.
      503     delete object v-bh.
      504     return string(v-recid) .
      505   end.
      506   end procedure.
      507   procedure fltopend_fltfindq :
      508   define input parameter p-parent-handle as handle no-undo .
      509   define input parameter p-qh as handle no-undo .
      510   define input parameter p-next as logical no-undo .
      511   define input parameter p-lock as integer no-undo .
      512   define input parameter p-flt-open-open-query  as character no-undo .
      513   define input parameter p-where-cond as character no-undo .
      514   define input parameter p-use-indFIRST-query-tail as character no-undo .
      515   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      516   define input parameter p-indexed-reposition as character no-undo .
      517   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      518   define variable glog as logical no-undo .
      519   define variable v-qh as handle no-undo .
      520   define variable v-bh as handle no-undo extent 18.
      521   define variable v-rowid as rowid no-undo extent 18.
      522   define variable v-ii as integer no-undo .
      523   define variable v-prepare-string as character no-undo .
      524   do
      525   on error undo, return error
      526   on stop undo, return error
      527   :
      528     create query v-qh.
      529     do v-ii = 1 to p-qh:num-buffers:
      530       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      531       assign
      532       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      533       no-error.
      534       v-qh:add-buffer(v-bh[v-ii]).
      535     end.
      536     assign
      537     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      538                       p-where-cond + chr(32)  +
      539                       p-use-indFIRST-query-tail + chr(32) +
      540                       p-use-ind-sort-clmn-by + chr(32) +
      541                       p-indexed-reposition
      542     .
      543     glog = v-qh:query-prepare( v-prepare-string) no-error .
      544     if not glog then do:
      545       delete object v-qh.
      546       do v-ii = 1 to p-qh:num-buffers:
      547         delete object v-bh[v-ii].
      548       end.
      549       undo, return error .
      550     end.
      551     glog = v-qh:query-open no-error .
      552     if not glog then do:
      553       delete object v-qh.
      554       do v-ii = 1 to p-qh:num-buffers:
      555         delete object v-bh[v-ii].
      556       end.
      557       undo, return error .
      558     end.
      559     if p-next then do:
      560       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      561       glog = v-qh:get-next( p-lock) no-error .
      562       glog = v-qh:get-next( p-lock) no-error .
      563       if not glog or v-qh:query-off-end = yes then do:
      564         glog = v-qh:get-first( p-lock) no-error .
      565       end.
      566     end.
      567     else do:
      568       glog = v-qh:get-first( p-lock) no-error .
      569     end.
      570     do v-ii = 1 to p-qh:num-buffers:
      571       assign
      572       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      573       no-error.
      574     end.
      575     delete object v-qh.
      576     do v-ii = 1 to p-qh:num-buffers:
      577       delete object v-bh[v-ii].
      578     end.
      579   end.
      580   end procedure.
