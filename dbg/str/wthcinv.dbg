      157   DEFINE VARIABLE l-shift-on AS LOG  NO-UNDO.
      158   DEFINE VARIABLE lock-doc as logical no-undo.
      159   DEFINE VARIABLE var-peresort as logical no-undo.
      160   define buffer auto-wth-doc-lock_batchprocess for ub.batchprocess .
      161   DEFINE BUTTON B-chk
