      172        LABEL "&>>"
      173        SIZE 4 BY 1.
      174   DEFINE BUTTON B-prev AUTO-GO
      175        LABEL "&<<"
      176        SIZE 4 BY 1.
      177   DEFINE BUTTON b-quit AUTO-END-KEY
      178        LABEL "&Выход"
      179        SIZE 10 BY 1
      180        BGCOLOR 8 .
      181   DEFINE VARIABLE for-object AS CHARACTER FORMAT "X(40)"
      182         VIEW-AS TEXT
      183        SIZE 24.5 BY 1 NO-UNDO.
      184   DEFINE VARIABLE for-person1 AS CHARACTER FORMAT "X(40)"
      185         VIEW-AS TEXT
      186        SIZE 24.5 BY 1 NO-UNDO.
      187   DEFINE VARIABLE for-person2 AS CHARACTER FORMAT "X(40)"
      188         VIEW-AS TEXT
      189        SIZE 24.5 BY 1 NO-UNDO.
      190   DEFINE VARIABLE for-person3 AS CHARACTER FORMAT "X(40)"
      191         VIEW-AS TEXT
      192        SIZE 24.5 BY 1 NO-UNDO.
      193   DEFINE VARIABLE for-person4 AS CHARACTER FORMAT "X(40)"
      194         VIEW-AS TEXT
      195        SIZE 24.5 BY 1 NO-UNDO.
      196   DEFINE VARIABLE for-person5 AS CHARACTER FORMAT "X(40)"
      197         VIEW-AS TEXT
      198        SIZE 24.5 BY 1 NO-UNDO.
      199   DEFINE QUERY BR-lines FOR
      200         buf_c-wth-line,
      201         buf_wth,
      202         buf_wth-place SCROLLING.
      203   DEFINE QUERY Dialog-Frame FOR
      204         tt-c-wth-doc SCROLLING.
      205   DEFINE BROWSE BR-lines
      206     QUERY BR-lines NO-LOCK DISPLAY
      207         buf_c-wth-line.wth-code FORMAT ">>>>>>>>9":U
      208   buf_wth.wth-name FORMAT "X(20)":U
      209   buf_wth-place.w-p-name FORMAT "X(20)":U
      210   buf_c-wth-line.bef-sum COLUMN-LABEL "Сумма план" FORMAT "->,>>>,>>>,>>9.99":U
      211   buf_c-wth-line.aft-sum COLUMN-LABEL "Сумма факт" FORMAT "->,>>>,>>>,>>9.99":U
      212   buf_c-wth-line.fact-sum COLUMN-LABEL "Расхождение" FORMAT "->,>>>,>>>,>>9.99":U
      213   ENABLE
      214   buf_c-wth-line.fact-sum
      215       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.1 BY 7.8.
      216   DEFINE FRAME Dialog-Frame
      217        b-quit AT ROW 1 COL 1
      218        B-prev AT ROW 1 COL 40
      219        B-next AT ROW 1 COL 44
      220        B-Help AT ROW 1 COL 95
      221        tt-c-wth-doc.obj-type AT ROW 3.33 COL 11 COLON-ALIGNED
      222             LABEL "Объект"
