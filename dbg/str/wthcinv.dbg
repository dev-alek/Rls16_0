        1   DEFINE BUFFER buf_c-wth-line FOR ub.c-wth-line.
        2   DEFINE BUFFER buf_clients FOR ub.clients.
        3   DEFINE BUFFER buf_obj FOR ub.clients.
        4   DEFINE BUFFER buf_person1 FOR ub.clients.
        5   DEFINE BUFFER buf_person2 FOR ub.clients.
        6   DEFINE BUFFER buf_person3 FOR ub.clients.
        7   DEFINE BUFFER buf_person4 FOR ub.clients.
        8   DEFINE BUFFER buf_person5 FOR ub.clients.
        9   DEFINE BUFFER buf_wth FOR ub.wealth.
       10   DEFINE BUFFER buf_wth-place FOR ub.wth-place.
       11   DEFINE TEMP-TABLE tt-c-wth-doc NO-UNDO LIKE ub.c-wth-doc.
       12   define input parameter parparentproc as widget-handle no-undo .
       13   define input parameter par-mode AS CHARACTER NO-UNDO.
       14   define input parameter parhost-code like ub.sysconf.host-code no-undo.
       15   define input parameter parobj-type like ub.clients.obj-type no-undo.
       16   define input parameter parobj-code like ub.clients.obj-code no-undo.
       17   define input parameter parcli-type like ub.clients.obj-type no-undo.
       18   define input parameter parcli-code like ub.clients.obj-code no-undo.
       19   define input parameter parauto-fill like ub.c-wth-doc.auto-fill no-undo .
       20   define input-output parameter p-doc-rec     as recid no-undo .
       21   define input parameter p-call-prog as handle no-undo .
       22   define input-output parameter p-next-prev as character no-undo .
       23   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       24   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       25   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       26   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       27   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       28   define variable vss-description AS CHAR NO-UNDO INIT "перемещение МЦ: добавление, изменение, просмотр инвентаризации":U.
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define new global shared variable g#library  as handle no-undo .
      133   define new global shared variable g#library2 as handle no-undo .
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   function usrfulnf returns character ( input p-user-id as character):
      136   define variable v-user-name as character no-undo .
      137   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      139     (input  p-user-id
      140     ,output v-user-name
      141     ) no-error .
      142   if error-status:error
      143   or v-user-name = ""
      144   then do:
      145     return p-user-id.
      146   end.
      147   else do:
      148     return v-user-name.
      149   end.
      150   end function.
      151   define buffer bf_c-wth-doc for ub.c-wth-doc.
