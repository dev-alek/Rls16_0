      285              VIEW-AS TEXT
      286             SIZE 12.3 BY .67
      287        for-person1 AT ROW 16 COL 17.1 COLON-ALIGNED NO-LABEL
      288        tt-c-wth-doc.deliver AT ROW 17.2 COL 1.8 NO-LABEL
      289              VIEW-AS TEXT
      290             SIZE 12.3 BY .67
      291        for-person2 AT ROW 17.2 COL 17.1 COLON-ALIGNED NO-LABEL
      292        tt-c-wth-doc.receiver AT ROW 18.43 COL 1.8 NO-LABEL
      293              VIEW-AS TEXT
      294             SIZE 12.3 BY .67
      295        for-person3 AT ROW 18.43 COL 17.1 COLON-ALIGNED NO-LABEL
      296        tt-c-wth-doc.inv-prs4 AT ROW 19.57 COL 1.8 NO-LABEL
      297              VIEW-AS TEXT
      298             SIZE 12.3 BY .67
      299        for-person4 AT ROW 19.57 COL 17.1 COLON-ALIGNED NO-LABEL
      300        tt-c-wth-doc.inv-prs5 AT ROW 20.8 COL 1.8 NO-LABEL
      301              VIEW-AS TEXT
      302             SIZE 12.3 BY .67
      303        for-person5 AT ROW 20.8 COL 17.1 COLON-ALIGNED NO-LABEL
      304        "ЧЛЕНЫ ИНВЕНТАРИЗАЦИОННОЙ КОМИССИИ" VIEW-AS TEXT
      305             SIZE 34.1 BY 1 AT ROW 14.97 COL 19.4
      306             BGCOLOR 3 FGCOLOR 15
      307        SPACE(45.76) SKIP(5.90)
      308       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      309            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      310            TITLE "Инвентаризационная ведомость движения материальных ценностей: история"
      311            CANCEL-BUTTON b-quit.
      312   ASSIGN
      313          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      314          FRAME Dialog-Frame:HIDDEN           = TRUE.
      315   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      316   DO:
      317     APPLY "END-ERROR":U TO SELF.
      318   END.
      319   ON CHOOSE OF B-chk IN FRAME Dialog-Frame
      320   DO:
      321     DEFINE VARIABLE loc-ref-list as character no-undo.
      322     run str/chk-docs.w (
      323                    input parparentproc
      324                   ,input '':U
      325                   ,input 'out-code':U
      326                   ,input ?
      327                   ,input parobj-type
      328                   ,input parobj-code
      329                   ,input tt-c-wth-doc.doc-code
      330                   ,input ''
      331                   ,input 0
      332                   ,input ?
      333                   ,input ?
      334                   ,input 0
      335                   ,output loc-ref-list) no-error.
      336     if error-status:error then return no-apply.
      337   END.
      338   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      339   DO:
      340   define variable v-doc-rec as recid no-undo .
      341   define variable v-line-rec as recid no-undo .
      342    if not avail buf_c-wth-line then return no-apply.
      343     ASSIGN
      344     v-line-rec = RECID( buf_c-wth-line )
      345     v-doc-rec = recid(bf_c-wth-doc)
      346     .
      347     run str/wthcinva.w (input parparentproc,
      348                     INPUT 'ПРОСМОТР':U,
      349                     input v-doc-rec,
      350                     input-output v-LINE-REC
      351                     ) no-error.
      352     apply "entry" to br-lines.
      353   END.
      354   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      355   DO:
      356         run reposition-c-wth-doc in this-procedure  (input 'next':U) no-error .
      357     if error-status:error then return no-apply.
      358   END.
      359   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      360   DO:
      361         run reposition-c-wth-doc in this-procedure (input 'prev':U ) no-error .
      362     if error-status:error then return no-apply.
      363   END.
      364   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      365   DO:
      366       p-next-prev = "QUIT".
      367   END.
      368   ON LEAVE OF tt-c-wth-doc.deliver IN FRAME Dialog-Frame
      369   DO:
      370       FIND FIRST buf_person2 NO-LOCK WHERE
      371               buf_person2.obj-type = 'чел':U AND
      372               buf_person2.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.deliver NO-ERROR.
      373     IF AVAIL buf_person2 THEN DO:
      374       DISPLAY
      375       buf_person2.obj-name @ for-person2
      376       WITH FRAME Dialog-Frame.
      377     END.
      378   END.
      379   ON LEAVE OF tt-c-wth-doc.inv-prs4 IN FRAME Dialog-Frame
      380   DO:
      381        FIND FIRST buf_person4 NO-LOCK WHERE
      382               buf_person4.obj-type = 'чел':U AND
      383               buf_person4.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.inv-prs4 NO-ERROR.
      384     IF AVAIL buf_person4 THEN DO:
      385       DISPLAY
      386       buf_person4.obj-name @ for-person4
      387       WITH FRAME Dialog-Frame.
      388     END.
      389   END.
      390   ON LEAVE OF tt-c-wth-doc.inv-prs5 IN FRAME Dialog-Frame
      391   DO:
      392      FIND FIRST buf_person5 NO-LOCK WHERE
      393               buf_person5.obj-type = 'чел':U AND
      394               buf_person5.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.inv-prs5 NO-ERROR.
      395     IF AVAIL buf_person5 THEN DO:
      396       DISPLAY
      397       buf_person5.obj-name @ for-person5
      398       WITH FRAME Dialog-Frame.
      399     END.
      400   END.
      401   ON LEAVE OF tt-c-wth-doc.operator IN FRAME Dialog-Frame
      402   DO:
      403       FIND FIRST buf_person1 NO-LOCK WHERE
      404               buf_person1.obj-type = 'чел':U AND
      405               buf_person1.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.operator NO-ERROR.
      406     IF AVAIL buf_person1 THEN DO:
      407       DISPLAY
      408       buf_person1.obj-name @ for-person1
      409       WITH FRAME Dialog-Frame.
      410     END.
      411   END.
      412   ON LEAVE OF tt-c-wth-doc.receiver IN FRAME Dialog-Frame
      413   DO:
      414      FIND FIRST buf_person3 NO-LOCK WHERE
      415               buf_person3.obj-type = 'чел':U AND
      416               buf_person3.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.receiver NO-ERROR.
      417     IF AVAIL buf_person3 THEN DO:
      418       DISPLAY
      419       buf_person3.obj-name @ for-person3
      420       WITH FRAME Dialog-Frame.
      421     END.
      422   END.
      423   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      424   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      425   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   on help of frame Dialog-Frame
      427   do:
      428     run gbl/app_help.p
      429       (input this-procedure :file-name
      430       ,input ''
      431       ,input ?
      432       ) no-error.
      433     if error-status :error then do:
      434       message
      435         "Ошибка при вызове помощи"
      436         error-status :get-message(1)
      437         view-as alert-box .
      438     end.
      439   end.
      440   run minbtn-set in this-procedure .
      441   on choose of b-help in frame Dialog-Frame
      442   do:
      443     apply "help":u to frame Dialog-Frame .
      444   end.
      445   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      446   procedure minbtn-set :
      447       do
      448           on error undo, return error return-value
      449           :
      450           define variable ii              as integer       no-undo .
      451           define variable fh              as widget-handle no-undo .
      452           define variable hh              as widget-handle no-undo .
      453           define variable v-h             as handle        extent 4 no-undo .
      454           define variable v-name-button   as character     no-undo .
      455           define variable v-help-old-x    as decimal       no-undo .
      456           define variable v-help-old-y    as decimal       no-undo .
      457           define variable v-help-old-size as decimal       no-undo .
      458           define variable v-frame-width   as decimal       no-undo .
      459           define variable jj              as integer       no-undo .
      460           do
      461               on error undo, return error
      462               :
      463               assign
      464                   v-frame-width = frame Dialog-Frame:width - 0.3
      465                   fh            = frame Dialog-Frame:first-child
      466                   hh            = fh:first-child
      467                   ii            = 1
      468                   .
      469               do while valid-handle(hh):
      470                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      471                   do:
      472                       case lc(hh:name) :
      473                           when "b-help" then
      474                               do:
      475                                   hh:load-image-up("cmp/b-help.bmp":u) .
      476                                   hh:load-image-down("cmp/b-help.bmp":u) .
      477                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      478                                   hh:TOOLTIP = "Помощь" .
      479                                   v-help-old-x = hh:column .
      480                                   v-help-old-y = hh:row    .
      481                                   v-help-old-size = hh:width .
      482                                   hh:width-chars = 2.5 .
      483                               end.
      484                           when "b-print" then
      485                               do:
      486                                   hh:load-image("cmp/b-print.bmp":u) .
      487                                   hh:TOOLTIP = "Печать" .
      488                                   v-h[ii] = hh:handle .
      489                                   ii = ii + 1 .
      490                                   hh:width-chars = 3 .
      491                               end.
      492                           when "b-history" or
      493                           when "b-hist" then
      494                               do:
      495                                   hh:load-image("cmp/b-hist.bmp":u) .
      496                                   hh:TOOLTIP = "История" .
      497                                   v-h[ii] = hh:handle .
      498                                   ii = ii + 1 .
      499                                   hh:width-chars = 3 .
      500                               end.
      501                           when "b-sch" then
      502                               do:
      503                                   hh:load-image("cmp/b-sch.bmp":u) .
      504                                   hh:TOOLTIP = "Установка Фильтра" .
      505                                   v-h[ii] = hh:handle .
      506                                   ii = ii + 1 .
      507                                   hh:width-chars = 3 .
      508                               end.
      509                           when "b-hist-user" then
      510                               do:
      511                                   hh:load-image("cmp/b-hist.bmp":u) .
      512                                   hh:TOOLTIP = "История пользователя" .
      513                                   ii = ii + 1 .
      514                               end.
      515                       end case.
      516                   end.
      517                   hh = hh:next-sibling.
      518               end.
      519               b-help:column = v-frame-width - b-help:width-chars.
      520               jj = 0.
      521               repeat ii = 4 to 1 by -1 :
      522                   if valid-handle (v-h[ii] ) then
      523                   do:
      524                       jj  = jj + 1 .
      525                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      526                       v-h[ii]:row    = v-help-old-y .
      527                   end.
      528               end.
      529           end.
      530       end.
      531   end procedure.
      532   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      533   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      534   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      535   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      536   define variable v-diasize-current-frame-width  as decimal   no-undo .
      537   define variable v-diasize-current-frame-height as decimal   no-undo .
      538   define variable v-diasize-change-size          as logical   no-undo .
      539   define variable v-diasize-resize-button        as handle    no-undo .
      540   define variable v-diasize-wndmax               as logical   no-undo .
      541   define variable v-diasize-wndstore             as logical   no-undo .
      542   define variable v-diasize-proc-name            as character no-undo .
      543   define variable v-diasize-browse-handle        as handle    no-undo .
      544   define variable v-diasize-browse-number        as integer   no-undo .
      545   define variable v-diasize-need-full-display    as logical   no-undo init false .
      546   define temp-table temp-diasize-handle no-undo
      547     field handle-value  as handle
      548     field save-position as decimal
      549     index xpk is primary unique handle-value
      550     .
      551   define temp-table temp-browse-handle no-undo
      552     field browse-type   as character
      553     field browse-number as integer
      554     field browse-handle as handle
      555     field original-size as decimal
      556     index xpk is primary unique browse-type browse-number
      557     index xie browse-type browse-handle
      558   .
      559   procedure diasize_change-height :
      560     define input  parameter p-change-value  as decimal   no-undo .
      561     define input  parameter p-move-resize   as logical   no-undo .
      562     define variable v-field-group-handle    as handle    no-undo .
      563     define variable v-object-handle         as handle    no-undo .
      564     define variable v-frame-height          as decimal   no-undo .
      565     define variable v-frame-virtual-height  as decimal   no-undo .
      566     define variable v-browse-height         as decimal   no-undo .
      567     define variable v-window-height         as decimal   no-undo .
      568     define variable v-window-virtual-height as decimal   no-undo .
      569     define variable v-change-sign           as integer   no-undo .
      570     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      571     define buffer buf_temp-browse-handle  for temp-browse-handle .
      572     if p-change-value > 0
      573     then do:
      574       if frame Dialog-Frame :height + p-change-value
      575           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      576       then do:
      577         assign
      578           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      579                           - (frame Dialog-Frame :height-chars)
      580         .
      581         if p-change-value <= 0
      582         then do:
      583           run diasize_position-resize-button in this-procedure .
      584           return .
      585         end.
      586       end.
      587     end.
      588     if p-change-value < 0
      589     then do:
      590       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      591       then do:
      592         assign
      593           p-change-value = v-diasize-orig-frame-height
      594                          - (frame Dialog-Frame :height-chars)
      595         .
      596         if p-change-value >= 0
      597         then do:
      598           run diasize_position-resize-button in this-procedure .
      599           return .
      600         end.
      601       end.
      602     end.
      603     if p-change-value >= 0
      604     then do:
      605       assign
      606         v-change-sign = 1
      607       .
      608     end.
      609     else do:
      610       assign
      611         v-change-sign = -1
      612       .
      613     end.
      614     assign
      615       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      616     .
      617     if p-change-value = 0
      618     then do:
      619       run diasize_position-resize-button in this-procedure .
      620       return .
      621     end.
      622     move_block:
      623     do
      624     on error undo move_block, retry move_block
      625     :
      626       if retry
      627       then do:
      628         do
      629         on error undo move_block, leave move_block
      630         :
      631           if p-change-value > 0
      632           then do:
      633             for each buf_temp-diasize-handle
      634             on error undo, next
      635             :
      636               assign
      637                 v-object-handle = buf_temp-diasize-handle.handle-value
      638               .
      639               if v-object-handle <> v-diasize-resize-button
      640               then do:
      641                 assign
      642                   v-object-handle :row = buf_temp-diasize-handle.save-position
      643                 .
      644               end.
      645             end.
      646             assign
      647               v-diasize-browse-handle :height = v-browse-height
      648             .
      649             for each buf_temp-browse-handle
      650               where buf_temp-browse-handle.browse-type = 'height':u
      651             on error undo, next
      652             :
      653               assign
      654                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      655               .
      656             end.
      657             assign
      658               frame Dialog-Frame :height = v-frame-height
      659             .
      660             if frame Dialog-Frame :scrollable = true
      661             then do:
      662               assign
      663                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      664               .
      665             end.
      666             run diasize_position-resize-button in this-procedure .
      667           end.
      668           else do:
      669             if frame Dialog-Frame :scrollable = true
      670             then do:
      671               assign
      672                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      673               .
      674             end.
      675             assign
      676               frame Dialog-Frame :height = v-frame-height
      677             .
      678             assign
      679               v-diasize-browse-handle :height = v-browse-height
      680             .
      681             for each buf_temp-browse-handle
      682               where buf_temp-browse-handle.browse-type = 'height':u
      683             on error undo, next
      684             :
      685               assign
      686                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      687               .
      688             end.
      689             for each buf_temp-diasize-handle
      690             on error undo, next
      691             :
      692               assign
      693                 v-object-handle = buf_temp-diasize-handle.handle-value
      694               .
      695               if v-object-handle <> v-diasize-resize-button
      696               then do:
      697                 assign
      698                   v-object-handle :row = buf_temp-diasize-handle.save-position
      699                 .
      700               end.
      701             end.
      702             run diasize_position-resize-button in this-procedure .
      703           end.
      704           assign
      705             v-diasize-change-size = false
      706           .
      707           leave move_block .
      708         end.
      709       end.
      710       assign
      711         v-diasize-need-full-display = true
      712       .
      713       if v-diasize-change-size = false
      714       then do:
      715         assign
      716           v-diasize-change-size = true
      717         .
      718       end.
      719       else do:
      720         return .
      721       end.
      722       assign
      723         v-frame-height = frame Dialog-Frame :height
      724         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      725         v-browse-height = v-diasize-browse-handle :height
      726       .
      727       for each buf_temp-browse-handle
      728         where buf_temp-browse-handle.browse-type = 'height':u
      729       :
      730         assign
      731           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      732         .
      733       end.
      734       for each buf_temp-diasize-handle
      735       :
      736         delete buf_temp-diasize-handle .
      737       end.
      738       assign
      739         v-field-group-handle = frame Dialog-Frame :first-child
      740       .
      741       do while valid-handle(v-field-group-handle)
      742       :
      743         assign
      744           v-object-handle = v-field-group-handle :first-child
      745         .
      746         do while valid-handle(v-object-handle)
      747         :
      748           if  v-object-handle <> v-diasize-browse-handle :handle
      749           and can-query(v-object-handle, "row")
      750           and can-query(v-object-handle, "height")
      751           and ( v-object-handle :row > v-diasize-browse-handle :row )
      752           then do:
      753             find first buf_temp-browse-handle
      754               where buf_temp-browse-handle.browse-type   = 'height':u
      755                 and buf_temp-browse-handle.browse-handle = v-object-handle
      756               no-error .
      757             if available buf_temp-browse-handle
      758             then do:
      759             end.
      760             else do:
      761               create buf_temp-diasize-handle .
      762               assign
      763                 buf_temp-diasize-handle.handle-value  = v-object-handle
      764                 buf_temp-diasize-handle.save-position = v-object-handle :row
      765               .
      766             end.
      767           end.
      768           assign
      769             v-object-handle = v-object-handle :next-sibling
      770           .
      771         end.
      772         assign
      773           v-field-group-handle = v-field-group-handle :next-sibling
      774         .
      775       end.
      776       do with frame Dialog-Frame
      777       :
      778         hide v-diasize-resize-button .
      779         assign
      780           v-diasize-resize-button :row    = 1
      781           v-diasize-resize-button :column = 1
      782         .
      783       end.
      784       if p-change-value > 0
      785       then do:
      786         if frame Dialog-Frame :scrollable = true
      787         then do:
      788           assign
      789             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      790             no-error .
      791           if error-status :error
      792           or error-status :get-message(1) <> ""
      793           then do:
      794             undo move_block, retry move_block .
      795           end.
      796         end.
      797         assign
      798           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      799           no-error .
      800         if error-status :error
      801         or error-status :get-message(1) <> ""
      802         then do:
      803           undo move_block, retry move_block .
      804         end.
      805         assign
      806           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      807           no-error .
      808         if error-status :error
      809         or error-status :get-message(1) <> ""
      810         then do:
      811           undo move_block, retry move_block .
      812         end.
      813         for each buf_temp-browse-handle
      814           where buf_temp-browse-handle.browse-type = 'height':u
      815         on error undo move_block, retry move_block
      816         :
      817           assign
      818             buf_temp-browse-handle.browse-handle :height
      819               = buf_temp-browse-handle.browse-handle :height + p-change-value
      820             no-error .
      821           if error-status :error
      822           or error-status :get-message(1) <> ""
      823           then do:
      824             undo move_block, retry move_block .
      825           end.
      826         end.
      827         for each buf_temp-diasize-handle
      828         on error undo move_block, retry move_block
      829         :
      830           assign
      831             v-object-handle = buf_temp-diasize-handle.handle-value
      832           .
      833           if v-object-handle <> v-diasize-resize-button
      834           then do:
      835             assign
      836               v-object-handle :row = v-object-handle :row + p-change-value
      837               no-error .
      838             if error-status :error
      839             or error-status :get-message(1) <> ""
      840             then do:
      841               undo move_block, retry move_block .
      842             end.
      843           end.
      844         end.
      845       end.
      846       else do:
      847         for each buf_temp-diasize-handle
      848         on error undo move_block, retry move_block
      849         :
      850           assign
      851             v-object-handle = buf_temp-diasize-handle.handle-value
      852           .
      853           if v-object-handle <> v-diasize-resize-button
      854           then do:
      855             assign
      856               v-object-handle :row = v-object-handle :row + p-change-value
      857               no-error .
      858             if error-status :error
      859             or error-status :get-message(1) <> ""
      860             then do:
      861               undo move_block, retry move_block .
      862             end.
      863           end.
      864         end.
      865         assign
      866           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      867           no-error .
      868         if error-status :error
      869         or error-status :get-message(1) <> ""
      870         then do:
      871           undo move_block, retry move_block .
      872         end.
      873         for each buf_temp-browse-handle
      874           where buf_temp-browse-handle.browse-type = 'height':u
      875         on error undo move_block, retry move_block
      876         :
      877           assign
      878             buf_temp-browse-handle.browse-handle :height
      879               = buf_temp-browse-handle.browse-handle :height + p-change-value
      880             no-error .
      881           if error-status :error
      882           or error-status :get-message(1) <> ""
      883           then do:
      884             undo move_block, retry move_block .
      885           end.
      886         end.
      887         assign
      888           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      889           no-error .
      890         if error-status :error
      891         or error-status :get-message(1) <> ""
      892         then do:
      893           undo move_block, retry move_block .
      894         end.
      895         if frame Dialog-Frame :scrollable = true
      896         then do:
      897           assign
      898             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      899             no-error .
      900           if error-status :error
      901           or error-status :get-message(1) <> ""
      902           then do:
      903             undo move_block, retry move_block .
      904           end.
      905         end.
      906       end.
      907       if p-move-resize = true
      908       then do:
      909         run diasize_position-resize-button in this-procedure .
      910       end.
      911       if v-diasize-wndstore = true
      912       then do:
      913         if connected("ub") = true
      914         then do:
      915           define variable v-cntxt-db-num        as integer   no-undo .
      916           define variable v-cntxt-userid        as character no-undo .
      917           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      918                                             , OUTPUT v-cntxt-userid
      919                                             ) .
      920           run gbl/wndsizew.p
      921             (input  v-cntxt-db-num
      922             ,input  v-cntxt-userid
      923             ,input  v-diasize-proc-name
      924             ,input  'height':u
      925             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      926             ) .
      927         end.
      928       end.
      929     end.
      930     assign
      931       v-diasize-change-size = false
      932     .
      933   end procedure.
      934   procedure diasize_set-height :
      935     define input  parameter p-new-height  as decimal   no-undo .
      936     define input  parameter p-move-resize as logical   no-undo .
      937     do
      938     on error undo, return error return-value
      939     :
      940       run diasize_change-height in this-procedure
      941         (input  (p-new-height - frame Dialog-Frame :height)
      942         ,input  p-move-resize
      943         ) .
      944     end.
      945   end procedure.
      946   procedure diasize_change-width :
      947     define input  parameter p-change-value as decimal   no-undo .
      948     define input  parameter p-move-resize  as logical   no-undo .
      949     define variable v-field-group-handle   as handle    no-undo .
      950     define variable v-object-handle        as handle    no-undo .
      951     define variable v-frame-width          as decimal   no-undo .
      952     define variable v-frame-virtual-width  as decimal   no-undo .
      953     define variable v-browse-width         as decimal   no-undo .
      954     define variable v-window-width         as decimal   no-undo .
      955     define variable v-window-virtual-width as decimal   no-undo .
      956     define variable v-change-sign          as integer   no-undo .
      957     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      958     define buffer buf_temp-browse-handle  for temp-browse-handle .
      959     if p-change-value > 0
      960     then do:
      961       if frame Dialog-Frame :width + p-change-value >
      962           session :width-chars
      963       then do:
      964         assign
      965           p-change-value = session :width-chars - frame Dialog-Frame :width
      966         .
      967         if p-change-value <= 0
      968         then do:
      969           run diasize_position-resize-button in this-procedure .
      970           return .
      971         end.
      972       end.
      973     end.
      974     if p-change-value < 0
      975     then do:
      976       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      977       then do:
      978         assign
      979           p-change-value = v-diasize-orig-frame-width
      980                          - frame Dialog-Frame :width
      981         .
      982         if p-change-value >= 0
      983         then do:
      984           run diasize_position-resize-button in this-procedure .
      985           return .
      986         end.
      987       end.
      988     end.
      989     if p-change-value >= 0
      990     then do:
      991       assign
      992         v-change-sign = 1
      993       .
      994     end.
      995     else do:
      996       assign
      997         v-change-sign = -1
      998       .
      999     end.
     1000     assign
     1001       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1002     .
     1003     if p-change-value = 0
     1004     then do:
     1005       run diasize_position-resize-button in this-procedure .
     1006       return .
     1007     end.
     1008     move_block:
     1009     do
     1010     on error undo move_block, leave move_block
     1011     :
     1012       if retry
     1013       then do:
     1014         do
     1015         on error undo move_block, leave move_block
     1016         :
     1017           if p-change-value > 0
     1018           then do:
     1019             for each buf_temp-diasize-handle
     1020             on error undo, next
     1021             :
     1022               assign
     1023                 v-object-handle = buf_temp-diasize-handle.handle-value
     1024               .
     1025               if v-object-handle <> v-diasize-resize-button
     1026               then do:
     1027                 assign
     1028                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1029                 .
     1030               end.
     1031             end.
     1032             assign
     1033               v-diasize-browse-handle :width = v-browse-width
     1034             .
     1035             for each buf_temp-browse-handle
     1036               where buf_temp-browse-handle.browse-type = 'width':u
     1037             on error undo, next
     1038             :
     1039               assign
     1040                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1041               .
     1042             end.
     1043             assign
     1044               frame Dialog-Frame :width = v-frame-width
     1045             .
     1046             if frame Dialog-Frame :scrollable = true
     1047             then do:
     1048               assign
     1049                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1050               .
     1051             end.
     1052             run diasize_position-resize-button in this-procedure .
     1053           end.
     1054           else do:
     1055             if frame Dialog-Frame :scrollable = true
     1056             then do:
     1057               assign
     1058                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1059               .
     1060             end.
     1061             assign
     1062               frame Dialog-Frame :width = v-frame-width
     1063             .
     1064             for each buf_temp-browse-handle
     1065               where buf_temp-browse-handle.browse-type = 'width':u
     1066             on error undo, next
     1067             :
     1068               assign
     1069                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1070               .
     1071             end.
     1072             assign
     1073               v-diasize-browse-handle :width = v-browse-width
     1074             .
     1075             for each buf_temp-diasize-handle
     1076             on error undo, next
     1077             :
     1078               assign
     1079                 v-object-handle = buf_temp-diasize-handle.handle-value
     1080               .
     1081               if v-object-handle <> v-diasize-resize-button
     1082               then do:
     1083                 assign
     1084                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1085                 .
     1086               end.
     1087             end.
     1088             run diasize_position-resize-button in this-procedure .
     1089           end.
     1090           assign
     1091             v-diasize-change-size = false
     1092           .
     1093           leave move_block .
     1094         end.
     1095       end.
     1096       assign
     1097         v-diasize-need-full-display = true
     1098       .
     1099       if v-diasize-change-size = false
     1100       then do:
     1101         assign
     1102           v-diasize-change-size = true
     1103         .
     1104       end.
     1105       else do:
     1106         return .
     1107       end.
     1108       assign
     1109         v-frame-width = frame Dialog-Frame :width
     1110         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1111         v-browse-width = v-diasize-browse-handle :width
     1112       .
     1113       for each buf_temp-browse-handle
     1114         where buf_temp-browse-handle.browse-type = 'width':u
     1115       :
     1116         assign
     1117           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1118         .
     1119       end.
     1120       for each buf_temp-diasize-handle
     1121       :
     1122         delete buf_temp-diasize-handle .
     1123       end.
     1124       assign
     1125         v-field-group-handle = frame Dialog-Frame :first-child
     1126       .
     1127       do while valid-handle(v-field-group-handle)
     1128       :
     1129         assign
     1130           v-object-handle = v-field-group-handle :first-child
     1131         .
     1132         do while valid-handle(v-object-handle)
     1133         :
     1134           if  v-object-handle <> v-diasize-browse-handle :handle
     1135           and v-object-handle <> v-diasize-resize-button
     1136           and can-query(v-object-handle, "row")
     1137           and can-query(v-object-handle, "height")
     1138           and ( v-object-handle :col + v-object-handle :width
     1139                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1140               )
     1141           then do:
     1142             find first buf_temp-browse-handle
     1143               where buf_temp-browse-handle.browse-type   = 'width':u
     1144                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1145               no-error .
     1146             if available buf_temp-browse-handle
     1147             then do:
     1148             end.
     1149             else do:
     1150               create buf_temp-diasize-handle .
     1151               assign
     1152                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1153                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1154               .
     1155             end.
     1156           end.
     1157           assign
     1158             v-object-handle = v-object-handle :next-sibling
     1159           .
     1160         end.
     1161         assign
     1162           v-field-group-handle = v-field-group-handle :next-sibling
     1163         .
     1164       end.
     1165       do with frame Dialog-Frame
     1166       :
     1167         hide v-diasize-resize-button .
     1168         v-diasize-resize-button :row = 1.
     1169         v-diasize-resize-button :column = 1.
     1170       end.
     1171       if p-change-value > 0
     1172       then do:
     1173         if frame Dialog-Frame :scrollable = true
     1174         then do:
     1175           assign
     1176             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1177             no-error .
     1178           if error-status :error
     1179           or error-status :get-message(1) <> ""
     1180           then do:
     1181             undo move_block, retry move_block.
     1182           end.
     1183         end.
     1184         assign
     1185           frame Dialog-Frame :width = v-frame-width + p-change-value
     1186           no-error .
     1187         if error-status :error
     1188         or error-status :get-message(1) <> ""
     1189         then do:
     1190           undo move_block, retry move_block.
     1191         end.
     1192         assign
     1193           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1194         no-error .
     1195         if error-status :error
     1196         or error-status :get-message(1) <> ""
     1197         then do:
     1198           undo move_block, retry move_block.
     1199         end.
     1200         for each buf_temp-browse-handle
     1201           where buf_temp-browse-handle.browse-type = 'width':u
     1202         on error undo move_block, retry move_block
     1203         :
     1204           assign
     1205             buf_temp-browse-handle.browse-handle :width
     1206               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1207             no-error .
     1208           if error-status :error
     1209           or error-status :get-message(1) <> ""
     1210           then do:
     1211             undo move_block, retry move_block .
     1212           end.
     1213         end.
     1214         for each buf_temp-diasize-handle
     1215         on error undo move_block, retry move_block
     1216         :
     1217           assign
     1218             v-object-handle = buf_temp-diasize-handle.handle-value
     1219           .
     1220           if v-object-handle <> v-diasize-resize-button
     1221           then do:
     1222             assign
     1223               v-object-handle :col = v-object-handle :col + p-change-value
     1224               no-error .
     1225             if error-status :error
     1226             or error-status :get-message(1) <> ""
     1227             then do:
     1228               undo move_block, retry move_block .
     1229             end.
     1230           end.
     1231         end.
     1232       end.
     1233       else do:
     1234         for each buf_temp-diasize-handle
     1235         on error undo move_block, retry move_block
     1236         :
     1237           assign
     1238             v-object-handle = buf_temp-diasize-handle.handle-value
     1239           .
     1240           if v-object-handle <> v-diasize-resize-button
     1241           then do:
     1242             assign
     1243               v-object-handle :col = v-object-handle :col + p-change-value
     1244               no-error .
     1245             if error-status :error
     1246             or error-status :get-message(1) <> ""
     1247             then do:
     1248               undo move_block, retry move_block .
     1249             end.
     1250           end.
     1251         end.
     1252         for each buf_temp-browse-handle
     1253           where buf_temp-browse-handle.browse-type = 'width':u
     1254         on error undo move_block, retry move_block
     1255         :
     1256           assign
     1257             buf_temp-browse-handle.browse-handle :width
     1258               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1259             no-error .
     1260           if error-status :error
     1261           or error-status :get-message(1) <> ""
     1262           then do:
     1263             undo move_block, retry move_block .
     1264           end.
     1265         end.
     1266         assign
     1267           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1268           no-error .
     1269         if error-status :error
     1270         or error-status :get-message(1) <> ""
     1271         then do:
     1272           undo move_block, retry move_block.
     1273         end.
     1274         assign
     1275           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1276         no-error .
     1277         if error-status :error
     1278         or error-status :get-message(1) <> ""
     1279         then do:
     1280           undo move_block, retry move_block.
     1281         end.
     1282         if frame Dialog-Frame :scrollable = true
     1283         then do:
     1284           assign
     1285             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1286           no-error .
     1287           if error-status :error
     1288           or error-status :get-message(1) <> ""
     1289           then do:
     1290             undo move_block, retry move_block.
     1291           end.
     1292         end.
     1293       end.
     1294       if p-move-resize
     1295       then do:
     1296         run diasize_position-resize-button in this-procedure .
     1297       end.
     1298       if v-diasize-wndstore = true
     1299       then do:
     1300         if connected("ub") = true
     1301         then do:
     1302           define variable v-cntxt-db-num        as integer   no-undo .
     1303           define variable v-cntxt-userid        as character no-undo .
     1304           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1305                                             , OUTPUT v-cntxt-userid
     1306                                             ) .
     1307           run gbl/wndsizew.p
     1308             (input  v-cntxt-db-num
     1309             ,input  v-cntxt-userid
     1310             ,input  v-diasize-proc-name
     1311             ,input  'width':u
     1312             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1313             ) .
     1314         end.
     1315       end.
     1316     end.
     1317     assign
     1318       v-diasize-change-size = false
     1319     .
     1320   end procedure.
     1321   procedure diasize_set-width :
     1322     define input  parameter p-new-width  as decimal   no-undo .
     1323     define input  parameter p-move-resize as logical   no-undo .
     1324     do
     1325     on error undo, return error return-value
     1326     :
     1327       run diasize_change-width in this-procedure
     1328         (input  (p-new-width - frame Dialog-Frame :width)
     1329         ,input  p-move-resize
     1330         ) .
     1331     end.
     1332   end procedure.
     1333   procedure diasize_position-resize-button :
     1334     do with frame Dialog-Frame
     1335     :
     1336       hide v-diasize-resize-button .
     1337       assign
     1338         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1339                     - 1
     1340                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1341         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1342                     - 1
     1343                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1344       .
     1345       view v-diasize-resize-button .
     1346     end.
     1347   end procedure.
     1348   on alt-right anywhere
     1349   do:
     1350     run diasize_change-width in this-procedure
     1351       (input 1
     1352       ,input true
     1353       ) .
     1354     return no-apply .
     1355   end.
     1356   on alt-left anywhere
     1357   do:
     1358     run diasize_change-width in this-procedure
     1359       (input -1
     1360       ,input true
     1361       ) .
     1362     return no-apply .
     1363   end.
     1364   on alt-down anywhere
     1365   do:
     1366     run diasize_change-height in this-procedure
     1367       (input 1
     1368       ,input true
     1369       ) .
     1370     return no-apply .
     1371   end.
     1372   on alt-up anywhere
     1373   do:
     1374     run diasize_change-height in this-procedure
     1375       (input -1
     1376       ,input true
     1377       ) .
     1378     return no-apply .
     1379   end.
     1380   on alt-enter of frame Dialog-Frame
     1381   do:
     1382     run diasize_maximize in this-procedure
     1383       (input  ?
     1384       ).
     1385     return no-apply .
     1386   end.
     1387   procedure diasize_end-move :
     1388     do
     1389     on error undo, return error return-value
     1390     :
     1391       define variable v-row-delta as decimal   no-undo .
     1392       define variable v-col-delta as decimal   no-undo .
     1393       define variable v-new-row as decimal   no-undo .
     1394       define variable v-new-col as decimal   no-undo .
     1395       assign
     1396         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1397         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1398       .
     1399       assign
     1400         v-row-delta = v-new-row - frame Dialog-Frame :height
     1401         v-col-delta = v-new-col - frame Dialog-Frame :width
     1402       .
     1403       run diasize_change-height in this-procedure
     1404         (input v-row-delta
     1405         ,input true
     1406         ) .
     1407       run diasize_change-width in this-procedure
     1408         (input v-col-delta
     1409         ,input true
     1410         ) .
     1411     end.
     1412   end procedure.
     1413   procedure diasize_maximize :
     1414     define input  parameter p-action as logical   no-undo .
     1415     do
     1416     on error undo, return error return-value
     1417     :
     1418       if p-action = ?
     1419       then do:
     1420         if v-diasize-need-maximize = true
     1421         then do:
     1422           assign
     1423             p-action = true
     1424           .
     1425         end.
     1426         else do:
     1427           assign
     1428             p-action = false
     1429           .
     1430         end.
     1431       end.
     1432       if p-action = true
     1433       then do:
     1434         run diasize_change-height in this-procedure
     1435           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1436               - frame Dialog-Frame :height-chars
     1437           ,input true
     1438           ) .
     1439         run diasize_change-width in this-procedure
     1440           (input session :width-chars
     1441               - frame Dialog-Frame :width-chars
     1442           ,input true
     1443           ) .
     1444         assign
     1445           v-diasize-need-maximize = false
     1446         .
     1447       end.
     1448       else do:
     1449         run diasize_change-width in this-procedure
     1450           (input v-diasize-orig-frame-width
     1451               - frame Dialog-Frame :width-chars
     1452           ,input true
     1453           ) .
     1454         run diasize_change-height in this-procedure
     1455           (input v-diasize-orig-frame-height
     1456               - frame Dialog-Frame :height-chars
     1457           ,input true
     1458           ) .
     1459         assign
     1460           v-diasize-need-maximize = true
     1461         .
     1462       end.
     1463     end.
     1464   end procedure.
     1465   procedure diasize_restore-orig-size :
     1466     do
     1467     on error undo, return error return-value
     1468     :
     1469       assign
     1470         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1471         v-diasize-current-frame-height = frame Dialog-Frame :height
     1472       .
     1473       run diasize_set-height in this-procedure
     1474         (input  v-diasize-orig-frame-height
     1475         ,input  true
     1476         ) .
     1477       run diasize_set-width in this-procedure
     1478         (input  v-diasize-orig-frame-width
     1479         ,input  true
     1480         ) .
     1481     end.
     1482   end procedure.
     1483   procedure diasize_restore-current-size :
     1484     do
     1485     on error undo, return error return-value
     1486     :
     1487       run diasize_set-height in this-procedure
     1488         (input  v-diasize-current-frame-height
     1489         ,input  true
     1490         ) .
     1491       run diasize_set-width in this-procedure
     1492         (input  v-diasize-current-frame-width
     1493         ,input  true
     1494         ) .
     1495     end.
     1496   end procedure.
     1497   procedure diasize_set-browse-handle :
     1498     define input  parameter p-browse-handle as handle   no-undo .
     1499     define buffer buf_temp-browse-handle for temp-browse-handle .
     1500     do
     1501     on error undo, return error return-value
     1502     :
     1503       assign
     1504         v-diasize-browse-handle = p-browse-handle
     1505       .
     1506       for each buf_temp-browse-handle
     1507       on error undo, return error return-value
     1508       :
     1509         delete buf_temp-browse-handle .
     1510       end.
     1511     end.
     1512   end procedure.
     1513   procedure diasize_add_browse :
     1514     define input  parameter p-browse-type   as character no-undo .
     1515     define input  parameter p-browse-handle as handle    no-undo .
     1516     define buffer buf_temp-browse-handle for temp-browse-handle .
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520       assign
     1521         v-diasize-browse-number = v-diasize-browse-number + 1
     1522       .
     1523       create buf_temp-browse-handle .
     1524       assign
     1525         buf_temp-browse-handle.browse-type   = p-browse-type
     1526         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1527         buf_temp-browse-handle.browse-handle = p-browse-handle
     1528       .
     1529     end.
     1530   end procedure.
     1531   procedure diasize_init :
     1532     define variable v-default-value    as logical   no-undo .
     1533     define variable v-restore-saved    as logical   no-undo .
     1534     define variable v-resize-value-str as character no-undo .
     1535     do
     1536     on error undo, return error return-value
     1537     :
     1538       do with frame Dialog-Frame
     1539       :
     1540         assign
     1541           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1542           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1543           v-diasize-browse-handle     = browse BR-lines :handle
     1544         .
     1545         create button v-diasize-resize-button
     1546         assign
     1547           parent        = frame Dialog-Frame :first-child
     1548           label         = "s"
     1549           height-pixels = 16
     1550           width-pixels  = 16
     1551           visible       = true
     1552           sensitive     = true
     1553           movable       = true
     1554           triggers:
     1555             on end-move persistent run diasize_end-move in this-procedure .
     1556           end triggers.
     1557         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1558         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1559         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1560         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1561         assign
     1562           v-diasize-wndmax = false
     1563         .
     1564         if connected("ub") = true
     1565         then do:
     1566           define variable v-cntxt-db-num        as integer   no-undo .
     1567           define variable v-cntxt-userid        as character no-undo .
     1568           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1569                                             , OUTPUT v-cntxt-userid
     1570                                             ) .
     1571           run gbl/wndpar_r.p
     1572             (input  v-cntxt-db-num
     1573             ,input  v-cntxt-userid
     1574             ,input  'wndmax':U
     1575             ,output v-diasize-wndmax
     1576             ,output v-default-value
     1577             ) .
     1578         end.
     1579         assign
     1580           v-diasize-wndstore = false
     1581         .
     1582         if connected("ub") = true
     1583         then do:
     1584           run gbl/wndpar_r.p
     1585             (input  v-cntxt-db-num
     1586             ,input  v-cntxt-userid
     1587             ,input  'wndstore':U
     1588             ,output v-diasize-wndstore
     1589             ,output v-default-value
     1590             ) .
     1591         end.
     1592         assign
     1593           v-diasize-proc-name = entry(1, program-name(2), '.')
     1594         .
     1595         if v-diasize-wndstore = true
     1596         then do:
     1597           assign
     1598             v-restore-saved = false
     1599           .
     1600           if connected("ub") = true
     1601           then do:
     1602             run gbl/wndsizer.p
     1603               (input  v-cntxt-db-num
     1604               ,input  v-cntxt-userid
     1605               ,input  v-diasize-proc-name
     1606               ,input  'height':u
     1607               ,output v-resize-value-str
     1608               ) .
     1609             if v-resize-value-str <> '':U
     1610             then do:
     1611               run diasize_change-height in this-procedure
     1612                 (input  integer(v-resize-value-str)
     1613                 ,input  true
     1614                 ) .
     1615               assign
     1616                 v-restore-saved = true
     1617               .
     1618             end.
     1619           end.
     1620           if connected("ub") = true
     1621           then do:
     1622             run gbl/wndsizer.p
     1623               (input  v-cntxt-db-num
     1624               ,input  v-cntxt-userid
     1625               ,input  v-diasize-proc-name
     1626               ,input  'width':u
     1627               ,output v-resize-value-str
     1628               ) .
     1629             if v-resize-value-str <> '':U
     1630             then do:
     1631               run diasize_change-width in this-procedure
     1632                 (input  integer(v-resize-value-str)
     1633                 ,input  true
     1634                 ) .
     1635               assign
     1636                 v-restore-saved = true
     1637               .
     1638             end.
     1639           end.
     1640           if v-restore-saved <> true
     1641           then do:
     1642             if v-diasize-wndmax = true
     1643             then do:
     1644               run diasize_maximize in this-procedure
     1645                 (input  true
     1646                 ) .
     1647             end.
     1648           end.
     1649         end.
     1650         else do:
     1651           if v-diasize-wndmax = true
     1652           then do:
     1653             run diasize_maximize in this-procedure
     1654               (input  true
     1655               ) .
     1656           end.
     1657         end.
     1658       end.
     1659     end.
     1660   end procedure.
     1661   procedure diasize_need-full-display :
     1662     define output parameter p-need-full-display as logical   no-undo .
     1663     do
     1664     on error undo, return error return-value
     1665     :
     1666       assign
     1667         p-need-full-display = v-diasize-need-full-display
     1668       .
     1669       assign
     1670         v-diasize-need-full-display = false
     1671       .
     1672     end.
     1673   end procedure.
     1674   procedure get-context :
     1675      define output parameter p-db-num as integer          no-undo.
     1676      define output parameter p-user-id as character        no-undo.
     1677      define variable v-login               as character    no-undo.
     1678      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1679      define buffer buf_user-login  for ub.user-login .
     1680      do
     1681      on error undo, return error
     1682      :
     1683            FIND FIRST buf_sys-ctrl no-lock.
     1684            ASSIGN
     1685               v-login = USERID("ub")
     1686               p-db-num = buf_sys-ctrl.db-num
     1687            .
     1688            FIND FIRST buf_user-login
     1689                 WHERE buf_user-login.db-num = p-db-num
     1690                   AND buf_user-login.user-login = v-login
     1691                 no-lock
     1692                 no-error
     1693                 .
     1694            IF AVAILABLE buf_user-login
     1695            THEN DO:
     1696               assign
     1697                  p-user-id = buf_user-login.user-id
     1698               .
     1699            END.
     1700      end.
     1701   end procedure.
     1702       run diasize_init in this-procedure .
     1703   p-next-prev = '':U.
     1704   n-p: do while p-next-prev = '':U:
     1705   MAIN-BLOCK:
     1706   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1707      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1708       if par-mode <> 'ПРОСМОТР':U then do:
     1709           message vss-workfile vss-revision vss-description skip
     1710                       "Неверный параметр вызова par-mode"
     1711           view-as alert-box ERROR.
     1712           return error.
     1713       end.
     1714       if not par-mode = 'ПРОСМОТР':U then
     1715       p-next-prev = "QUIT".
     1716       find first ub.sysconf No-LOCK WHERE
     1717                        ub.sysconf.host-code = parhost-code No-ERROR.
     1718       if not avail ub.sysconf then do:
     1719           message vss-workfile vss-revision vss-description skip
     1720                           "Неверный параметр вызова parhost-code"
     1721               view-as alert-box ERROR.
     1722               return error.
     1723       end.
     1724       find first ub.clients No-LOCK WHERE
     1725                   ub.clients.obj-type = parobj-type AND
     1726                   ub.clients.obj-code = parobj-code No-ERROR.
     1727       if not avail ub.clients then do:
     1728         message vss-workfile vss-revision vss-description skip
     1729                 "Неверный параметр вызова parobj-type/parobj-code"
     1730         view-as alert-box ERROR.
     1731         return error.
     1732       end.
     1733       if parcli-type <> '':U or parcli-code <> 0 then do:
     1734         find first ub.clients No-LOCK WHERE
     1735                     ub.clients.obj-type = parcli-type AND
     1736                     ub.clients.obj-code = parcli-code No-ERROR.
     1737         if not avail ub.clients then do:
     1738           message vss-workfile vss-revision vss-description skip
     1739                   "Неверный параметр вызова parcli-type/parcli-code"
     1740           view-as alert-box ERROR.
     1741           return error.
     1742         end.
     1743       end.
     1744       tt-c-wth-doc.obj-type:list-items = 'орг':U + chr(44) +
     1745                                       'чел':U + chr(44) +
     1746                                       'маг':U + chr(44) +
     1747                                       'скл':U + chr(44).
     1748     Run fill-tables no-error.
     1749     if error-status:error then return error.
     1750     RUN Myenable.
     1751   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1752   DEF VAR cur-clmn-numbr-lines as INT EXTENT 18 no-undo.
     1753   DEF VAR varmvibr-lines       as INT no-undo.
     1754   DEF VAR varmvjbr-lines       as INT no-undo.
     1755   DEF VAR varmvkbr-lines       as INT no-undo.
     1756   DEF VAR varmvlbr-lines       as INT no-undo.
     1757   DEF VAR move-elementbr-lines as INT no-undo.
     1758   def var jjbr-lines           as int no-undo.
     1759   do varmvibr-lines = 1 to EXTENT(cur-clmn-numbr-lines):
     1760     ASSIGN cur-clmn-numbr-lines[varmvibr-lines] = varmvibr-lines.
     1761   END.
     1762   RUN start-mv-clmnbr-lines.
     1763   PROCEDURE start-mv-clmnbr-lines:
     1764   def var old-session as logical no-undo.
     1765      old-session = SESSION:IMMEDIATE-DISPLAY.
     1766      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1767          IF  var-peresort = no  THEN DO:
     1768      DO jjbr-lines = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     1769        RUN re-move-clmnbr-lines ( cur-clmn-numbr-lines[INTEGER(ENTRY (jjbr-lines, '1,2,3,4,5,6'))] , 1).
     1770      END.
     1771          END.
     1772          IF  var-peresort = yes  THEN DO:
     1773      DO jjbr-lines = NUM-ENTRIES('1,2,3,6,4,5') TO 1 BY -1:
     1774        RUN re-move-clmnbr-lines ( cur-clmn-numbr-lines[INTEGER(ENTRY (jjbr-lines, '1,2,3,6,4,5'))] , 1).
     1775      END.
     1776          END.
     1777      SESSION:IMMEDIATE-DISPLAY = old-session.
     1778   END.
     1779   ON ctrl-cursor-right OF BROWSE br-lines do:
     1780     RUN re-move-clmnbr-lines ( 1, 18).
     1781   END.
     1782   ON ctrl-cursor-left OF BROWSE br-lines do:
     1783     RUN re-move-clmnbr-lines (18, 1).
     1784   END.
     1785   PROCEDURE re-move-clmnbr-lines:
     1786     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1787     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1788     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     1789       if cur-clmn-numbr-lines[varmvibr-lines] = source-column THEN cur-clmn-numbr-lines[varmvibr-lines] = -1.
     1790     END.
     1791     if br-lines:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     1792     if source-column > target-column THEN
     1793     DO varmvjbr-lines = source-column - 1 to target-column BY -1:
     1794       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     1795           if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     1796             cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] + 1.
     1797           END.
     1798       END.
     1799     END.
     1800     ELSE
     1801     DO varmvjbr-lines = source-column + 1 to target-column:
     1802       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     1803         if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     1804           cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] - 1.
     1805         END.
     1806       END.
     1807     END.
     1808     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     1809       if cur-clmn-numbr-lines[varmvibr-lines] = -1 THEN cur-clmn-numbr-lines[varmvibr-lines] = target-column.
     1810     END.
     1811   END PROCEDURE.
     1812   PROCEDURE ch-clmnbr-lines:
     1813     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1814     if cur-clmn-loc <= 1 then do:
     1815       return .
     1816     end.
     1817     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     1818       if cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-loc THEN move-elementbr-lines = varmvibr-lines.
     1819     END.
     1820     RUN re-move-clmnbr-lines (cur-clmn-loc, 1).
     1821   END PROCEDURE.
     1822   PROCEDURE mv-brw-defaultbr-lines:
     1823   def var old-session as logical no-undo.
     1824     old-session = SESSION:IMMEDIATE-DISPLAY.
     1825     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1826     do varmvlbr-lines = 1 to EXTENT(cur-clmn-numbr-lines):
     1827       RUN re-move-clmnbr-lines (cur-clmn-numbr-lines[varmvlbr-lines], varmvlbr-lines).
     1828     END.
     1829     RUN start-mv-clmnbr-lines.
     1830     SESSION:IMMEDIATE-DISPLAY = old-session.
     1831   END PROCEDURE.
     1832   .
     1833     WAIT-FOR GO OF FRAME Dialog-Frame.
     1834   END.
     1835   end.
     1836   RUN disable_UI.
     1837   PROCEDURE control-peresort :
     1838   DEFINE OUTPUT parameter par-peresort as logical no-undo.
     1839   if tt-c-wth-doc.auto-fill = yes and
     1840   can-find(first ub.chk-doc No-LOCK WHERE
     1841                      ub.chk-doc.obj-type = tt-c-wth-doc.obj-type AND
     1842                       ub.chk-doc.obj-code = tt-c-wth-doc.obj-code AND
     1843                       ub.chk-doc.out-code = tt-c-wth-doc.doc-code AND
     1844                       ub.chk-doc.chk-type = integer('4':U)) then do:
     1845                       par-peresort = yes.
     1846   end.
     1847   else par-peresort = no.
     1848   END PROCEDURE.
     1849   PROCEDURE disable_UI :
     1850     HIDE FRAME Dialog-Frame.
     1851   END PROCEDURE.
     1852   PROCEDURE enable_UI :
     1853     OPEN QUERY Dialog-Frame FOR EACH tt-c-wth-doc SHARE-LOCK.
     1854     GET FIRST Dialog-Frame.
     1855     DISPLAY for-object for-person1 for-person2 for-person3 for-person4 for-person5
     1856         WITH FRAME Dialog-Frame.
     1857     IF AVAILABLE tt-c-wth-doc THEN
     1858       DISPLAY tt-c-wth-doc.obj-type tt-c-wth-doc.corr-date
     1859             tt-c-wth-doc.corr-user-name tt-c-wth-doc.doc-code
     1860             tt-c-wth-doc.doc-date tt-c-wth-doc.fact-date tt-c-wth-doc.shift-date
     1861             tt-c-wth-doc.shift-name tt-c-wth-doc.shift-num tt-c-wth-doc.obj-code
     1862             tt-c-wth-doc.bef-sum tt-c-wth-doc.aft-sum tt-c-wth-doc.fact-sum
     1863             tt-c-wth-doc.operator tt-c-wth-doc.deliver tt-c-wth-doc.receiver
     1864             tt-c-wth-doc.inv-prs4 tt-c-wth-doc.inv-prs5
     1865         WITH FRAME Dialog-Frame.
     1866     ENABLE b-quit B-prev B-next B-Help BR-lines B-lookup B-chk
     1867            tt-c-wth-doc.corr-date tt-c-wth-doc.corr-user-name
     1868            tt-c-wth-doc.doc-date tt-c-wth-doc.fact-date tt-c-wth-doc.shift-date
     1869            tt-c-wth-doc.shift-name tt-c-wth-doc.shift-num tt-c-wth-doc.obj-code
     1870            for-object tt-c-wth-doc.bef-sum tt-c-wth-doc.aft-sum
     1871            tt-c-wth-doc.fact-sum tt-c-wth-doc.operator for-person1
     1872            tt-c-wth-doc.deliver for-person2 tt-c-wth-doc.receiver for-person3
     1873            tt-c-wth-doc.inv-prs4 for-person4 tt-c-wth-doc.inv-prs5 for-person5
     1874         WITH FRAME Dialog-Frame.
     1875     VIEW FRAME Dialog-Frame.
     1876   END PROCEDURE.
     1877   PROCEDURE fill-tables :
     1878   for each tt-c-wth-doc:
     1879       delete tt-c-wth-doc.
     1880   end.
     1881     if par-mode = 'ПРОСМОТР':U then do:
     1882       FIND FIRST bf_c-wth-doc NO-LOCK WHERE
     1883                   recid(bf_c-wth-doc) = p-doc-rec.
     1884     end.
     1885     IF NOT AVAIL bf_c-wth-doc then
     1886     return error.
     1887     if bf_c-wth-doc.status_ = 'факт':U and par-mode <> 'ПРОСМОТР':U then do:
     1888        message "Документ движения МЦ с N" bf_c-wth-doc.doc-code  "имеет статус" bf_c-wth-doc.status_ SKIP
     1889                "Изменения не допускаются"
     1890        view-as alert-box error.
     1891        return error.
     1892       end.
     1893     create tt-c-wth-doc.
     1894     buffer-copy bf_c-wth-doc to tt-c-wth-doc.
     1895       FIND FIRST buf_obj No-LOCK WHERe
     1896                   buf_obj.obj-type = tt-c-wth-doc.obj-type AND
     1897                   buf_obj.obj-code = tt-c-wth-doc.obj-code No-ERROR.
     1898       if not avail buf_obj then do:
     1899         message "Документ движения МЦ N" bf_c-wth-doc.doc-code  skip
     1900                 "Неверный объект" bf_c-wth-doc.obj-type bf_c-wth-doc.obj-code
     1901         view-as alert-box ERROR.
     1902         return error.
     1903       end.
     1904       FIND FIRST buf_clients No-LOCK WHERe
     1905                   buf_clients.obj-type = tt-c-wth-doc.cli-type AND
     1906                   buf_clients.obj-code = tt-c-wth-doc.cli-code No-ERROR.
     1907      if not avail buf_clients
     1908         or NOT (buf_clients.obj-type = 'орг':U AND buf_clients.obj-code = parhost-code) then do:
     1909         message "Документ движения МЦ N" bf_c-wth-doc.doc-code  skip
     1910                 "Неверный контрагент" bf_c-wth-doc.cli-type bf_c-wth-doc.cli-code
     1911         view-as alert-box ERROR.
     1912         return error.
     1913      end.
     1914       FIND FIRST buf_person1 No-LOCK WHERe
     1915                           buf_person1.obj-type = 'чел':U AND
     1916                           buf_person1.obj-code = tt-c-wth-doc.operator No-ERROR.
     1917       FIND FIRST buf_person2 No-LOCK WHERe
     1918                           buf_person2.obj-type = 'чел':U AND
     1919                           buf_person2.obj-code = tt-c-wth-doc.deliver No-ERROR.
     1920       FIND FIRST buf_person3 No-LOCK WHERe
     1921                           buf_person3.obj-type = 'чел':U AND
     1922                           buf_person3.obj-code = tt-c-wth-doc.receiver No-ERROR.
     1923       FIND FIRST buf_person4 No-LOCK WHERe
     1924                           buf_person4.obj-type = 'чел':U AND
     1925                           buf_person4.obj-code = tt-c-wth-doc.inv-prs4 No-ERROR.
     1926       FIND FIRST buf_person5 No-LOCK WHERe
     1927                           buf_person5.obj-type = 'чел':U AND
     1928                           buf_person5.obj-code = tt-c-wth-doc.inv-prs5 No-ERROR.
     1929   END PROCEDURE.
     1930   PROCEDURE lock-peresort :
     1931   DEFINE INPUT PARAMETER par-peresort as logical no-undo.
     1932   CASE par-peresort :
     1933       when yes then do:
     1934           HIDE
     1935           tt-c-wth-doc.aft-sum in frame Dialog-Frame
     1936           tt-c-wth-doc.bef-sum in frame Dialog-Frame.
     1937           DISPLAY tt-c-wth-doc.fact-sum
     1938           with frame Dialog-Frame.
     1939       end.
     1940       when no then do:
     1941           DISPLAY
     1942           tt-c-wth-doc.bef-sum
     1943           tt-c-wth-doc.aft-sum when NOT tt-c-wth-doc.status_ = 'накл':U
     1944           with frame Dialog-Frame.
     1945           if tt-c-wth-doc.status_ = 'накл':U then
     1946           HIDE
     1947           tt-c-wth-doc.fact-sum
     1948           in frame Dialog-Frame.
     1949       end.
     1950   END CASE.
     1951   END PROCEDURE.
     1952   PROCEDURE MyEnable :
     1953    buf_c-wth-line.fact-sum:READ-ONLY IN BROWSE BR-lines = YES.
     1954     IF AVAILABLE buf_person1 THEN
     1955       DISPLAY buf_person1.obj-name @ for-person1
     1956         WITH FRAME Dialog-Frame .
     1957     IF AVAILABLE buf_person2 THEN
     1958       DISPLAY buf_person2.obj-name @ for-person2
     1959         WITH FRAME Dialog-Frame .
     1960     IF AVAILABLE buf_person3 THEN
     1961       DISPLAY buf_person3.obj-name @ for-person3
     1962         WITH FRAME Dialog-Frame .
     1963     IF AVAILABLE buf_person4 THEN
     1964       DISPLAY buf_person4.obj-name @ for-person4
     1965         WITH FRAME Dialog-Frame .
     1966     IF AVAILABLE buf_person5 THEN
     1967       DISPLAY buf_person5.obj-name @ for-person5
     1968         WITH FRAME Dialog-Frame .
     1969     IF AVAILABLE buf_obj THEN
     1970       DISPLAY buf_obj.obj-name @ for-object
     1971         WITH FRAME Dialog-Frame .
     1972     IF AVAILABLE tt-c-wth-doc THEN
     1973       DISPLAY
     1974       tt-c-wth-doc.fact-date
     1975       tt-c-wth-doc.doc-code
     1976       tt-c-wth-doc.doc-date
     1977       tt-c-wth-doc.shift-name
     1978       tt-c-wth-doc.shift-num
     1979       tt-c-wth-doc.shift-date
     1980       tt-c-wth-doc.obj-code
     1981       tt-c-wth-doc.obj-type
     1982       tt-c-wth-doc.bef-sum
     1983       tt-c-wth-doc.aft-sum
     1984       tt-c-wth-doc.fact-sum
     1985       tt-c-wth-doc.operator
     1986       tt-c-wth-doc.deliver
     1987       tt-c-wth-doc.receiver
     1988       tt-c-wth-doc.inv-prs4
     1989       tt-c-wth-doc.inv-prs5
     1990       usrfulnf(tt-c-wth-doc.corr-user-name) @ tt-c-wth-doc.corr-user-name
     1991       tt-c-wth-doc.corr-date
     1992       WITH FRAME Dialog-Frame .
     1993       IF par-mode = 'ПРОСМОТР':U  THEN DO:
     1994         assign
     1995         b-quit:label = "&Выход"
     1996         b-quit:col = 1
     1997         .
     1998         ENABLE
     1999         B-Prev
     2000         B-Next
     2001         b-quit
     2002         WITH FRAME Dialog-Frame.
     2003         HIDE
     2004         tt-c-wth-doc.fact-date IN FRAME Dialog-Frame
     2005         .
     2006       END.
     2007       ENABLE
     2008       b-help
     2009       br-lines
     2010       b-lookup
     2011       WITH FRAME Dialog-Frame.
     2012       Hide b-chk
     2013       in frame Dialog-Frame.
     2014       run control-peresort(output var-peresort) no-error.
     2015       run lock-peresort(input var-peresort) no-error.
     2016       OPEN QUERY BR-lines FOR EACH buf_c-wth-line WHERE buf_c-wth-line.doc-code = tt-c-wth-doc.doc-code     and buf_c-wth-line.corr-user-db-num = tt-c-wth-doc.corr-user-db-num     and buf_c-wth-line.chip-num = tt-c-wth-doc.chip-num  NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_c-wth-line.wth-code NO-LOCK,              EACH buf_wth-place WHERE buf_wth-place.obj-type = buf_c-wth-line.obj-type AND buf_wth-place.obj-code = buf_c-wth-line.obj-code AND buf_wth-place.w-p-code = buf_c-wth-line.w-p-code  NO-LOCK.
     2017       REPOSITION br-lines TO ROW 1 NO-ERROR.
     2018       APPLY "ENTRY":U TO br-lines IN FRAME Dialog-Frame.
     2019       APPLY "VALUE-CHANGED":U TO br-lines IN FRAME Dialog-Frame.
     2020       ASSIGN
     2021       FRAME Dialog-Frame :TITLE = substitute("Удаленная инвентаризационная ведомость движения материальных ценностей № &1  - &2"
     2022                                               , tt-c-wth-doc.doc-code
     2023                                               , CAPS( par-mode )).
     2024        .
     2025     VIEW FRAME Dialog-Frame.
     2026   END PROCEDURE.
     2027   PROCEDURE reposition-c-wth-doc :
     2028   define input parameter p-direction as character no-undo .
     2029   define variable v-new-c-wth-doc-recid as recid no-undo .
     2030   do
     2031   on error undo, return error
     2032   :
     2033     if valid-handle(p-call-prog)
     2034     then do:
     2035       run reposition-c-wth-doc in p-call-prog
     2036         (input  p-direction
     2037         ,output v-new-c-wth-doc-recid
     2038         ).
     2039       if v-new-c-wth-doc-recid <> ?
     2040       then do:
     2041         define buffer buf_c-wth-doc for ub.c-wth-doc .
     2042         find first buf_c-wth-doc no-lock
     2043           where recid(buf_c-wth-doc) = v-new-c-wth-doc-recid
     2044           no-error .
     2045         assign
     2046         p-doc-rec = v-new-c-wth-doc-recid
     2047         p-next-prev = '':U
     2048         .
     2049       end.
     2050     end.
     2051     else do:
     2052       message "Список документов МЦ не определен." view-as alert-box INFORMATION .
     2053       return no-apply.
     2054     end.
     2055     END.
     2056   END PROCEDURE.
