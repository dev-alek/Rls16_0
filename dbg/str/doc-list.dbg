     2584   define variable grp-list as char no-undo.
     2585   define variable ref-list as char no-undo.
     2586   define variable num-rec as integer init 0 no-undo.
     2587   define variable tot-lns as integer init ? no-undo.
     2588   define variable vvalue as character no-undo.
     2589   define variable vother as character no-undo.
     2590   define variable vproc-attr       as character no-undo .
     2591   define variable vfull-screen-val as character no-undo .
     2592   define variable choice as logical   no-undo init ?.
