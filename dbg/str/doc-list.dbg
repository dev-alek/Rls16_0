     9657   run fltfield-add in this-procedure('internal', 'Внутренняя', '',
     9658                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9659   run fltfield-add in this-procedure('cli-name', 'Название контр-а', '',
     9660                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9661   run fltfield-add in this-procedure('creid', 'Создал', '',
     9662                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9663   run fltfield-add in this-procedure('agnt', 'Исполнитель', 'cli',
     9664                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9665   run fltfield-add in this-procedure('wrkr', 'Кладовщик', 'cli',
     9666                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9667   run fltfield-add in this-procedure('out-code', 'На док-т', '',
     9668                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9669   run fltfield-add in this-procedure('acc-date', 'Проводка', '',
     9670                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9671   run fltfield-add in this-procedure('base-rate', 'Курс', '',
     9672                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9673   run fltfield-add in this-procedure('inv-num', 'Инвойс', '',
