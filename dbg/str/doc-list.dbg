     2467   procedure userobjs_transfer :
     2468     define input  parameter p-callback-handle as handle no-undo .
     2469     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     2470     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2471     do
     2472     on error undo, return error return-value
     2473     :
     2474       if valid-handle(p-callback-handle) <> true
     2475       then do:
     2476         message
     2477           vss-workfile vss-revision vss-description skip
     2478           "Ошибка задания входных параметров" skip
     2479           "Неизвестный указатель на процедуру" skip
     2480           view-as alert-box error .
     2481         undo, return error return-value .
     2482       end.
     2483       if p-callback-handle :get-signature("userobjs_append") = ""
     2484       then do:
     2485         message
     2486           vss-workfile vss-revision vss-description skip
     2487           "Ошибка задания входных параметров" skip
     2488           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     2489                     ,p-callback-handle :file-name
     2490                     ) skip
     2491           view-as alert-box error .
     2492         undo, return error return-value .
     2493       end.
     2494       for each buf_userobjs_temp-user-obj
     2495       on error undo, return error return-value
     2496       :
     2497         run userobjs_append in p-callback-handle
     2498           (input  buf_userobjs_temp-user-obj.obj-type
     2499           ,input  buf_userobjs_temp-user-obj.obj-code
     2500           ) .
     2501       end.
     2502     end.
     2503   end procedure.
     2504   procedure userobjs_select-one :
     2505      define input  parameter parparentproc     as widget-handle no-undo .
     2506      define input  parameter p-db-num          as integer   no-undo .
     2507      define input  parameter p-user-id         as character no-undo .
     2508      define input  parameter p-host-code-obj   as integer   no-undo .
     2509      define input  parameter p-obj-type        as character no-undo .
     2510      define input  parameter p-obj-code        as integer   no-undo .
     2511      define output parameter p-user-select     as logical   no-undo .
     2512      define output parameter p-select-obj-type as character no-undo .
     2513      define output parameter p-select-obj-code as character no-undo .
     2514     do
     2515     on error undo, return error return-value
     2516     :
     2517       run gbl/userobjs.w
     2518         (input  parparentproc
     2519         ,input  this-procedure :handle
     2520         ,input  p-db-num
     2521         ,input  p-user-id
     2522         ,input  p-host-code-obj
     2523         ,input  p-obj-type
     2524         ,input  p-obj-code
     2525         ,INPUT  "b-sel"
     2526         ,output p-user-select
     2527         ,output p-select-obj-type
     2528         ,output p-select-obj-code
     2529         ) .
     2530     end.
     2531   end.
     2532   procedure userobjs_select-many :
     2533     define input  parameter parparentproc   as widget-handle no-undo .
     2534     define input  parameter p-db-num        as integer   no-undo .
     2535     define input  parameter p-user-id       as character no-undo .
     2536     define input  parameter p-host-code-obj as integer   no-undo .
