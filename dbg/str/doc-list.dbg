     7098   v-no-hist = - 1.
     7099   if  temp-list.fvalue = "single" then
     7100   run Myenable in this-procedure .
     7101   else do:
     7102     v-no-hist = 0.
     7103     case  rs-list-method:
     7104       when "attr" or when "attr-val" then do:
     7105         run trig-attr in this-procedure (input rs-list-method) no-error.
     7106         if error-status:error then do:
     7107           run MyEnable in this-procedure .
     7108           return error.
     7109         end.
     7110       end.
     7111       when "trn-doc" then do:
     7112         glog = yes.
