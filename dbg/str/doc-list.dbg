     8800                and ub.price-doc.obj-code = buf_user-obj.obj-code
     8801                and ub.price-doc.fact-date >= v-date-from
     8802                and ub.price-doc.fact-date <= v-date-to:
     8803               run ex-DOC in this-procedure(input 0, input rs-list-method, input rs-status, input line-mode) .
     8804               assign                                                           buf_doc-list-hist.num-add  = lns-cnt - v-num-add                       buf_doc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_doc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_doc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8805             end.
     8806           end.
     8807         end.
     8808       end.
     8809     end.
     8810     WHEN "fbr-DOC" THEN DO:
