     7178             if num-rec = 0 then do:
     7179               assign
     7180               v-temp-seq = v-seq
     7181               v-line     = 0
     7182               dsp-rs = substitute("Документы :")
     7183               v-item     = '':U
     7184               v-tbl-name = '':U
     7185               v-bh       = ?
