     8947             for each ub.inkas no-lock where
     8948                    ub.inkas.obj-type = buf_user-obj.obj-type
     8949                and ub.inkas.obj-code = buf_user-obj.obj-code
     8950                and ub.inkas.fact-date >= v-date-from
