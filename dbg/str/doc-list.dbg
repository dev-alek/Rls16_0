     1689   define new global shared variable g#library  as handle no-undo .
     1690   define new global shared variable g#library2 as handle no-undo .
     1691   define variable var-report-r-b as character no-undo .
     1692   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1694     (output var-report-r-b
     1695     )  .
     1696   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1698   define new shared variable RepPathName        as character no-undo .
     1699   define new shared variable PrintRubl          as logical   no-undo .
     1700   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   define  stream PrnLibStream.
     1702   procedure prn-lib-prn-file :
     1703     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1704     define input parameter p-DIsabledoptions as integer no-undo .
     1705     define variable v-report-name as character no-undo .
     1706     define variable v-user-action as character no-undo .
     1707     define variable v-printed     as logical   no-undo .
     1708     define variable v-exist       as logical   no-undo .
     1709     do
     1710       on error undo, return error
     1711       :
     1712       run prn-lib-get-report-name  in this-procedure (
     1713         input parParentProc
     1714         ,output v-report-name
     1715         ).
     1716   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1718     (input  v-report-name
     1719     ,input  2
     1720     ,output v-exist
     1721     )  .
     1722       if NOT v-exist then
     1723       DO:
     1724         Message
     1725           "Нет заданий на печать ! "
     1726           view-as alert-box .
     1727         Return  .
     1728       End.
     1729       run gbl/prnfilen.w
     1730         (input  ""
     1731         ,input  p-DisabledOptions
     1732         ,input  string(v-report-name )
     1733         ,input  7
     1734         ,output v-user-action
     1735         ,output v-printed
     1736         ) .
     1737       if v-printed then
     1738       do:
     1739         return "YES" .
     1740       end.
     1741       else
     1742       do:
     1743         return "NO" .
     1744       end.
     1745     end.
     1746   end procedure.
     1747   procedure prn-lib-open-stream :
     1748     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1749     define input parameter p-page-size    as integer no-undo .
     1750     define input parameter p-is-stream    as logical no-undo .
     1751     define input parameter p-append       as logical no-undo .
     1752     define variable v-report-name as character no-undo .
     1753     do
     1754       on error undo, return error
     1755       :
     1756       run prn-lib-get-report-name  in this-procedure (
     1757         input parParentProc
     1758         ,output v-report-name
     1759         ).
     1760       if p-is-stream then
     1761       do:
     1762         if p-append then
     1763         do:
     1764           output stream PrnLibStream to value( v-report-name )
     1765             page-size value(p-page-size) append .
     1766         end.
     1767         if not p-append then
     1768         do:
     1769           output stream PrnLibStream to value( v-report-name )
     1770             page-size value(p-page-size) .
     1771         end.
     1772       end.
     1773       if not p-is-stream then
     1774       do:
     1775         if p-append then
     1776         do:
     1777           output to value( v-report-name )
     1778             page-size value(p-page-size) append .
     1779         end.
     1780         if not p-append then
     1781         do:
     1782           output to value( v-report-name )
     1783             page-size value(p-page-size) .
     1784         end.
     1785       end.
     1786     end.
     1787   end procedure.
     1788   procedure prn-lib-open-exp :
     1789     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1790     define input parameter p-is-stream    as logical no-undo .
     1791     define input parameter p-is-append    as logical no-undo .
     1792     define output parameter p-ReportFileName as char init "report" no-undo.
     1793     define output parameter p-process as logical no-undo .
     1794     define variable glog as logical no-undo .
     1795     do
     1796       on error undo, return error
     1797       :
     1798       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1799         TITLE      "Укажите путь"
     1800         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1801         ASK-OVERWRITE
     1802         CREATE-TEST-FILE
     1803         SAVE-AS
     1804         USE-FILENAME
     1805         DEFAULT-EXTENSION "txt"
     1806         UPDATE glog
     1807         .
     1808       if not glog then  return.
     1809       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1810       if p-is-stream then
     1811       do:
     1812         if p-is-append then
     1813         do:
     1814           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1815         end.
     1816         else
     1817         do:
     1818           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1819         end.
     1820       end.
     1821       else
     1822       do:
     1823         if p-is-append then
     1824         do:
     1825           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1826         end.
     1827         else
     1828         do:
     1829           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1830         end.
     1831       end.
     1832       p-process = yes.
     1833     end.
     1834   end procedure.
     1835   procedure prn-lib-get-report-name :
     1836     define input parameter parParentProc  as widget-handle no-undo.
     1837     define output parameter p-report-name as character no-undo .
     1838     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1839   end procedure.
     1840   procedure prn-lib-reportviewer-report-name :
     1841     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1842     define input parameter p-report-name-html as character no-undo .
     1843     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1844   end procedure.
     1845   procedure prn-lib-reportviewer :
     1846     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1847     define input parameter p-report-name-html as character no-undo .
     1848     define input parameter p-param        as character no-undo .
     1849     define variable v-excel           as character no-undo init 'TRUE' .
     1850     define variable v-value-character as character no-undo .
     1851     define variable v-value-integer   as character no-undo .
     1852     define variable v-value-date      as date      no-undo .
     1853     define variable v-value-decimal   as decimal   no-undo .
     1854     define variable rep-excel         as logical   no-undo .
     1855     define variable excel-string      as character no-undo .
     1856     define variable v-param-type      as character no-undo .
     1857     define variable v-tth             as handle    no-undo .
     1858     run adm/shattri.p (
     1859       input "get":U
     1860       ,input  ""
     1861       ,input  0
     1862       ,input  'report-glob':U
     1863       ,input  'rep-excel':U
     1864       ,output v-value-character
     1865       ,output v-value-date
     1866       ,output v-value-decimal
     1867       ,output v-value-integer
     1868       ,output rep-excel
     1869       ,output v-param-type
     1870       ,INPUT-OUTPUT table-handle v-tth
     1871       )  .
     1872     if rep-excel then v-excel = "TRUE" .
     1873     else v-excel = "FALSE" .
     1874     if p-param eq ""
     1875     then
     1876        p-param = "EXCEL:" + v-excel.
     1877     else
     1878        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1879     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1880   end procedure.
     1881   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1882   define variable v-waitfram-action01         as character   no-undo .
     1883   define variable v-waitfram-action02         as character   no-undo .
     1884   define variable v-waitfram-action03         as character   no-undo .
     1885   define variable mWaitFramTextBeg            as character   no-undo.
     1886   define variable mWaitFramTextEnd            as character   no-undo.
     1887   define variable mWaitFramView               as logical     no-undo.
     1888   define variable mWaitProcEvent              as logical     no-undo init yes.
     1889   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1890   define variable mWaitFramStop               as logical     no-undo.
     1891   define variable mWaitFramStopUser           as logical     no-undo.
     1892   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1893   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1894   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1895   define button B-WaitFramStop auto-end-key
     1896        label "Стоп"
     1897        size 10 by 1 tooltip "Остоновить процесс".
     1898   define button B-viewProcInfo
     1899        label "Информация"
     1900        size 15 by 1 tooltip "Информация о процесс".
     1901   define frame waitfram
     1902     v-waitfram-action01 format "x(72)" no-label skip
     1903     v-waitfram-action02 format "x(72)" no-label skip
     1904     v-waitfram-action03 format "x(72)" no-label skip
     1905     B-viewProcInfo
     1906     B-WaitFramStop at row 4 col 30
     1907     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1908     .
     1909   define new global shared variable mBatchMode as logical no-undo init ?.
     1910   define variable mFramBachModHandle as handle no-undo.
     1911   mFramBachModHandle = frame waitfram:handle.
     1912   define variable mFameOldVis as logical no-undo.
     1913   define variable mVisCUrentVin as logical no-undo.
     1914   if session:batch-mode
     1915   then
     1916      mBatchMode = yes.
     1917   if mBatchMode = ? then do:
     1918     mVisCUrentVin = current-window:visible.
     1919     mFameOldVis = mFramBachModHandle:visible.
     1920     mFramBachModHandle:visible  = yes.
     1921     mBatchMode = mFramBachModHandle:visible ne yes.
     1922     mFramBachModHandle:visible = mFameOldVis.
     1923     current-window:visible = mVisCUrentVin.
     1924   end.
     1925    if  log-manager:logfile-name ne ?
     1926     then DO:
     1927         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1928         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1929         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1930     end.
     1931   on choose of B-WaitFramStop in frame waitfram
     1932   do:
     1933     mWaitFramStop = yes.
     1934     mWaitFramStopUser = yes.
     1935   end.
     1936   function waitfram-check-timeout returns logical():
     1937      define variable vtime as int64 no-undo.
     1938      if mWaitFramStopTimeOut
     1939      then
     1940         return yes.
     1941      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1942      if     mWaitFramTimeOut ne ?
     1943         and mWaitFramTimeOut ne 0
     1944         and mWaitFramTimeOut lt vtime
     1945      then do:
     1946         mWaitFramStopTimeOut = yes.
     1947      end.
     1948      return mWaitFramStopTimeOut.
     1949   end.
     1950   procedure waitfram-hide :
     1951     if not session:batch-mode
     1952     then do
     1953     on error undo, return error return-value
     1954     :
     1955       pause 0 before-hide .
     1956       if not mBatchMode then
     1957         hide frame waitfram .
     1958     if     not mWaitFramView
     1959        and mWaitProcEvent
     1960     then
     1961       process events .
     1962     end.
     1963   end procedure.
     1964   procedure waitfram-show :
     1965     define input  parameter p-message as character no-undo .
     1966     define variable v-left-margin as integer   no-undo .
     1967     if not session:batch-mode
     1968     then do
     1969     on error undo, return error return-value
     1970     :
     1971       if length(p-message) <= 70 then do:
     1972         assign
     1973           v-left-margin = integer((70 - length(p-message)) / 2)
     1974         .
     1975         assign
     1976           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1977         .
     1978         assign
     1979           v-waitfram-action01 = " "
     1980           v-waitfram-action02 = " "
     1981                                    + fill(" ", v-left-margin)
     1982                                    + p-message
     1983           v-waitfram-action03 = " "
     1984         .
     1985       end.
     1986       else do:
     1987         define variable vRindex1 as integer no-undo.
     1988         define variable vRindex2 as integer no-undo.
     1989         vRindex1 = r-index(p-message," ",70).
     1990         if vRindex1 = 0
     1991         then
     1992            vRindex1 = 70.
     1993         if length(p-message)  <= vRindex1 + 70 then do:
     1994           assign
     1995             v-waitfram-action01 = " "
     1996             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1997             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1998           .
     1999         end.
     2000         else do:
     2001           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2002           if vRindex2 <= vRindex1
     2003           then
     2004              vRindex2 = vRindex1 + 70.
     2005           assign
     2006             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2007             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2008             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2009           .
     2010         end.
     2011       end.
     2012       B-viewProcInfo:visible   in frame waitfram = no.
     2013       B-viewProcInfo:sensitive in frame waitfram = no.
     2014       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2015       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2016       if  (   mWaitFramView
     2017          or  mWaitProcEvent)
     2018          and not mBatchMode
     2019       then
     2020          display
     2021             v-waitfram-action01 skip
     2022             v-waitfram-action02 skip
     2023             v-waitfram-action03 skip
     2024          with frame waitfram .
     2025       if     mWaitFramView
     2026          then do:
     2027             if     mWaitFramInterval ne ?
     2028                and not mBatchMode
     2029             then
     2030                wait-for go of frame waitfram pause mWaitFramInterval.
     2031          end.
     2032          else
     2033             if     mWaitProcEvent
     2034                and not mBatchMode
     2035             then
     2036                process events .
     2037     end.
     2038   end procedure.
     2039      procedure waitfram-show-this:
     2040         define input  parameter iInterval as int64 no-undo.
     2041         define variable vtime as int64 no-undo.
     2042         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2043         mWaitFramInterval = iInterval.
     2044         run waitfram-show (substitute("&1&2 &3&4" ,
     2045                                       mWaitFramTextBeg ,
     2046                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2047                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2048                                       mWaitFramTextEnd
     2049                                      )
     2050                           ).
     2051      end.
     2052      procedure WaitFramRunPause:
     2053         define input  parameter iInterval as dec no-undo.
     2054         define variable vStart  as datetime-tz no-undo.
     2055         define variable vend    as datetime-tz no-undo.
     2056         define variable vint as int64 no-undo.
     2057         define variable vOk as logical no-undo.
     2058         vStart = now.
     2059         vend   = vStart.
     2060         publish "WaitFramPause" (iInterval,output vOk).
     2061         vend   =  now.
     2062         vint = vend - vStart.
     2063         vint = iInterval - vint / 1000.
     2064         if     not mWaitFramStop
     2065            and (   vint > 0
     2066                 or (    not vOk
     2067                     and iInterval eq ?
     2068                     )
     2069                 )
     2070         then
     2071            run waitfram-show-this (iInterval).
     2072         vend   =  now.
     2073         vint = vend - vStart.
     2074         vint = iInterval - vint / 1000.
     2075         if     not mWaitFramStop
     2076            and vint > 0
     2077         then do:
     2078            run gbl/pause.p (vint * 1000).
     2079         end.
     2080         if iInterval ne ?
     2081         then
     2082            publish "WaitFramStop".
     2083         waitfram-check-timeout().
     2084      end.
     2085      procedure WaitFramWaitFor:
     2086         define input  parameter iInterval as dec no-undo.
     2087         assign
     2088            mWaitFramStartProc   = now
     2089            mWaitFramStopUser    = no
     2090            mWaitFramStopTimeOut = no
     2091         .
     2092         block-wait:
     2093         do while not mWaitFramStop:
     2094            run WaitFramRunPause (iInterval).
     2095            if  waitfram-check-timeout()
     2096            then do:
     2097               leave block-wait.
     2098            end.
     2099         end.
     2100         run waitfram-hide.
     2101      end.
     2102   procedure waitfram-join :
     2103     define input  parameter p-line-1  as character no-undo .
     2104     define input  parameter p-line-2  as character no-undo .
     2105     define input  parameter p-line-3  as character no-undo .
     2106     define output parameter p-message as character no-undo .
     2107     do
     2108     on error undo, return error return-value
     2109     :
     2110       assign
     2111         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2112                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2113                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2114       .
     2115     end.
     2116   end procedure.
     2117   function waitfram-join-function returns character
     2118     (input p-line-1 as character
     2119     ,input p-line-2 as character
     2120     ,input p-line-3 as character
     2121     ).
     2122     define variable v-message as character no-undo .
     2123     run waitfram-join in this-procedure
     2124       (input  p-line-1
     2125       ,input  p-line-2
     2126       ,input  p-line-3
     2127       ,output v-message
     2128       ) .
     2129     return v-message .
     2130   end function .
     2131   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2132   procedure cur-time :
     2133      define output parameter p-today as date      no-undo .
     2134      define output parameter p-time  as integer   no-undo .
     2135     do
     2136     on error undo, return error
     2137     :
     2138       define variable v-date1 as date      no-undo .
     2139       define variable v-date2 as date      no-undo .
     2140       define variable v-time  as integer   no-undo .
     2141       assign
     2142         v-date1 = today
     2143         v-time  = time
     2144         v-date2 = today
     2145       .
     2146       if v-date1 <> v-date2
     2147       then do:
     2148         assign
     2149           v-date1 = today
     2150           v-time  = v-time
     2151         .
     2152       end.
     2153       assign
     2154         p-today = v-date1
     2155         p-time  = v-time
     2156       .
     2157     end.
     2158   end.
     2159   function cur-time-date returns character
     2160   :
     2161     return string(today, '99/99/9999':U) .
     2162   end.
     2163   function cur-time-mjd returns decimal
     2164   :
     2165     define variable v-date as date      no-undo .
     2166     define variable v-time as integer   no-undo .
     2167     run cur-time in this-procedure
     2168       (output v-date
     2169       ,output v-time
     2170       ) .
     2171     return integer(v-date) - 2400002 + (v-time / 86400) .
     2172   end.
     2173   function cur-time-get-ending-index returns integer
     2174   (input p-number as integer
     2175   )
     2176   :
     2177     if p-number < 0
     2178     or p-number = ?
     2179     then do:
     2180       return 1 .
     2181     end.
     2182     define variable v-rest as integer   no-undo .
     2183     assign
     2184       p-number = p-number modulo 100
     2185     .
     2186     if p-number < 20
     2187     then do:
     2188       assign
     2189         v-rest = p-number
     2190       .
     2191     end.
     2192     else do:
     2193       assign
     2194         v-rest = p-number modulo 10
     2195       .
     2196     end.
     2197     case v-rest :
     2198       when 1
     2199       then do:
     2200         return 2 .
     2201       end.
     2202       when 2 or
     2203       when 3 or
     2204       when 4
     2205       then do:
     2206         return 3 .
     2207       end.
     2208       otherwise do:
     2209         return 1 .
     2210       end.
     2211     end case .
     2212   end.
     2213   procedure cur-time-mjd-to-date :
     2214      define input  parameter i-mjd-diff as decimal no-undo.
     2215      define output parameter o-Date     as date    no-undo.
     2216      define output parameter o-Time     as integer no-undo.
     2217      define variable v-day-number as integer   no-undo .
     2218      if    i-mjd-diff < 0
     2219         or i-mjd-diff = ?
     2220      then do:
     2221         return "?" .
     2222      end.
     2223      assign
     2224         v-day-number = truncate(i-mjd-diff,0).
     2225         o-Date = date(v-day-number + 2400002).
     2226         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2227     .
     2228   end.
     2229   function cur-time-mjd-to-string returns character
     2230   (input p-mjd-diff as decimal
     2231   )
     2232   :
     2233     define variable v-day-number as integer   no-undo .
     2234     define variable v-seconds    as integer   no-undo .
     2235     define variable v-hour       as integer   no-undo .
     2236     define variable v-min        as integer   no-undo .
     2237     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2238     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2239     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2240     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2241     if p-mjd-diff < 0
     2242     or p-mjd-diff = ?
     2243     then do:
     2244       return "?" .
     2245     end.
     2246     assign
     2247       v-day-number = integer(truncate(p-mjd-diff,0))
     2248       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2249     .
     2250     if v-seconds > 86400
     2251     then do:
     2252       assign
     2253         v-seconds = 86400 - 1
     2254       .
     2255     end.
     2256     if v-seconds < 0
     2257     then do:
     2258       assign
     2259         v-seconds = 0
     2260       .
     2261     end.
     2262     assign
     2263       v-hour = truncate(v-seconds / 3600, 0)
     2264     .
     2265     assign
     2266       v-seconds = v-seconds modulo 3600
     2267     .
     2268     assign
     2269       v-min = truncate(v-seconds / 60, 0)
     2270     .
     2271     assign
     2272       v-seconds = v-seconds modulo 60
     2273     .
     2274     return
     2275         (if v-day-number <> 0
     2276           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2277           else ""
     2278         )
     2279       + (if v-day-number <> 0 or v-hour <> 0
     2280           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2281           else ""
     2282         )
     2283       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2284           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2285           else ""
     2286         )
     2287       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2288       .
     2289   end.
     2290   function cur-time-string returns character
     2291   :
     2292     define variable v-date as date      no-undo .
     2293     define variable v-time as integer   no-undo .
     2294     run cur-time in this-procedure
     2295       (output v-date
     2296       ,output v-time
     2297       ) .
     2298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2299   end.
     2300   function cur-time-string-sec returns character
     2301   :
     2302     define variable v-date as date      no-undo .
     2303     define variable v-time as integer   no-undo .
     2304     run cur-time in this-procedure
     2305       (output v-date
     2306       ,output v-time
     2307       ) .
     2308     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2309   end.
     2310   function cur-time-custom  returns character
     2311   (input p-prefix as character
     2312   ,input p-date-format as character
     2313   ,input p-delimiter as character
     2314   ,input p-time-format as character
     2315   ,input p-suffix as character
     2316   )
     2317   :
     2318     define variable v-date as date      no-undo .
     2319     define variable v-time as integer   no-undo .
     2320     run cur-time in this-procedure
     2321       (output v-date
     2322       ,output v-time
     2323       ) .
     2324     return
     2325       p-prefix
     2326       + string(v-date, p-date-format)
     2327       + p-delimiter
     2328       + string(v-time, p-time-format)
     2329       + p-suffix
     2330       .
     2331   end.
     2332   function cur-time-print  returns character
     2333   :
     2334     define variable v-date as date      no-undo .
     2335     define variable v-time as integer   no-undo .
     2336     run cur-time in this-procedure
     2337       (output v-date
     2338       ,output v-time
     2339       ) .
     2340     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2341   end.
     2342   function cur-time-datetime returns datetime
     2343   :
     2344     define variable v-char as character no-undo .
     2345     define variable v-datetime as datetime no-undo .
     2346     v-char = cur-time-string().
     2347     v-datetime = datetime(v-char).
     2348     return  v-datetime.
     2349   end.
     2350   function cur-time-string-msec returns character
     2351   :
     2352     define variable v-date as datetime  no-undo .
     2353     v-date = now.
     2354     return string(v-date) .
     2355   end.
