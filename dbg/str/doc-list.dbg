     1254   procedure create_obj-list :
     1255      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1256      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1257      do
     1258      on error undo, return error return-value
     1259      :
     1260         define buffer cli-obj for ub.clients .
     1261         define variable p-var as integer no-undo .
     1262         define buffer buf_obj-list for obj-list .
     1263         find last buf_obj-list  use-index pi no-error .
     1264         if available buf_obj-list
     1265         then
     1266            p-var = buf_obj-list.obj-id + 1.
     1267         else
     1268            p-var = 1.
     1269         find first cli-obj where
     1270                   cli-obj.obj-type = p-obj-type
     1271               and cli-obj.obj-code = p-obj-code
     1272         no-lock no-error.
     1273         if available cli-obj
     1274         then do:
     1275            create buf_obj-list.
     1276            assign
     1277               buf_obj-list.obj-id   = p-var
     1278               buf_obj-list.obj-code = cli-obj.obj-code
     1279               buf_obj-list.obj-type = cli-obj.obj-type
     1280               buf_obj-list.obj-name = cli-obj.obj-name
     1281               buf_obj-list.db-num   = cli-obj.db-num
     1282            .
     1283         end.
     1284      end.
     1285   end.
