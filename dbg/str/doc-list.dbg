     8993                and ub.c-inkas.obj-code = buf_user-obj.obj-code
     8994                and ub.c-inkas.fact-date >= v-date-from
     8995                and ub.c-inkas.fact-date <= v-date-to
     8996                and ub.c-inkas.is-del = yes :
     8997               run ex-DOC in this-procedure(input 102, input rs-list-method, input rs-status, input line-mode) .
     8998               assign                                                           buf_doc-list-hist.num-add  = lns-cnt - v-num-add                       buf_doc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_doc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_doc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8999             end.
     9000           end.
     9001         end.
     9002       end.
     9003     end.
     9004     WHEN "ord-doc" THEN DO:
     9005       glog = no.
     9006       _ii:
     9007       for each buf_doc-list-hist where
     9008                buf_doc-list-hist.id = p-id
     9009           and  buf_doc-list-hist.item_  <> '':U:
     9010         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_doc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next _ii.
     9011         find first ub.ord-doc no-lock where
