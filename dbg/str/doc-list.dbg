     2540     define variable v-select-obj-type as character no-undo .
     2541     define variable v-select-obj-code as integer   no-undo .
     2542     do
     2543     on error undo, return error return-value
     2544     :
     2545       run gbl/userobjs.w
     2546         (input  parparentproc
     2547         ,input  this-procedure :handle
     2548         ,input  p-db-num
     2549         ,input  p-user-id
     2550         ,input  p-host-code-obj
     2551         ,input  p-obj-type
     2552         ,input  p-obj-code
     2553         ,INPUT  "b-sel,b-mark"
     2554         ,output p-user-select
     2555         ,output v-select-obj-type
     2556         ,output v-select-obj-code
     2557         ) .
     2558     end.
     2559   end.
     2560   procedure thobjs :
