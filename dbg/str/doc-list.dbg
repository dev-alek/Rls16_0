     3289   if return-value = 'false':u then return NO-apply.
     3290   run create-doc-list-hist in this-procedure (input 'title'
     3291                                        , input-output v-seq
     3292                                        , input 0
     3293                                        , input '':U
     3294                                        , input 'N':U
