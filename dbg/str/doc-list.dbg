     3356   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   on help of frame Dialog-Frame
     3358   do:
     3359     run gbl/app_help.p
     3360       (input this-procedure :file-name
     3361       ,input ''
     3362       ,input ?
     3363       ) no-error.
     3364     if error-status :error then do:
     3365       message
     3366         "Ошибка при вызове помощи"
     3367         error-status :get-message(1)
     3368         view-as alert-box .
