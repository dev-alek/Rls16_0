     9164       string(if lns-ignore <> 0
     9165       then ("Проигнорировано строк :" + string(lns-ignore))
     9166       else "":U)
     9167       .
     9168     end.
     9169     when 'удаление':U then do:
     9170       tot-lns = tot-lns - lns-cnt.
     9171       if not p-from-macro or p-step then
     9172       message
     9173       "Удалено строк :" lns-cnt skip(0)
     9174       string(if lns-ignore <> 0
     9175       then ("Проигнорировано строк :" + string(lns-ignore))
     9176       else "":U)
     9177       .
     9178     end.
     9179   end CASE.
     9180   if line-mode <> 'ОСТАВИТЬ':U then
     9181     run Myenable in this-procedure.
     9182   end.
     9183   END PROCEDURE.
     9184   PROCEDURE trig-attr :
     9185   define input parameter rs-list-method as character no-undo .
