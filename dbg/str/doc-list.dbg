     9269       v-item = v-attr-code
     9270       .
     9271   end.
     9272   else do:
     9273   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input v-attr-code ,
     9274                          output vtype ,
     9275                          output vformat ,
     9276                          output vfillin_width ,
     9277                          output vfillin_height ,
     9278                          output vlabel ,
     9279                          output vuser-can-edit ,
     9280                          output voutput-display ,
     9281                          output vother  ,
     9282                          output vproc-attr ,
     9283                          output vfull-screen-val ,
     9284                          output v-sort
     9285                          )  .
     9286       run gbl/d-prompt.w (
     9287         'title=':u + "Значение атрибута документа" + '\':u
     9288       + 'text1=':u + vlabel + '\':u
     9289       + 'format=' + (if vtype = 'L':U then "yes/no" else vformat) + '\':u
     9290       + 'type=' + vtype + '\':u
     9291       + 'fillin_row=2\':u
     9292       + 'fillin_col=4\':u
     9293       + 'fillin_width=':u  + string(vfillin_width) + '\':u
     9294       + 'fillin_height=':u + string(vfillin_height) + '\':u
     9295       + 'max-chars=70\':u
     9296       + 'readonly=no\':u
     9297       , input-output vvalue
     9298       ).
     9299       if return-value = 'false':U then do:
     9300         return error.
     9301       end.
     9302       message
     9303       substitute("Все документы с атрибутом &1 = &2" , vlabel, vvalue)
     9304        view-as alert-box question buttons OK-Cancel update glog.
     9305       if not glog then do:
     9306         return error.
     9307       end.
     9308       assign
     9309       dsp-rs = substitute("ВСЕ документы с атрибутом &1 = &2", vlabel, vvalue)
     9310       v-item = v-attr-code + chr(3) + vvalue
     9311       .
     9312   end.
     9313   v-no-hist = 0.
     9314   run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9315                                       , input-output v-seq
     9316                                       , input 0
     9317                                       , input 'trn-doc':U
     9318                                       , input '':U
