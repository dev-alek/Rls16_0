     9691   run fltfield-add in this-procedure('fact-num', 'Порядок закрытия', '',
     9692                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9693   run fltfield-add in this-procedure('PS', 'Примечание', '',
     9694                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9695   run gbl/filter.w ( input parparentproc
     9696                     ,input c-point
     9697                     ,input tbl
     9698                     ,input join-tbl
     9699                     ,input fld
     9700                     ,input lab
     9701                     ,input spr
     9702                     ,input dim).
     9703   run gbl/flt-get.p (input c-point
     9704                 , output v-flt-rec
     9705                 , output filter-name
     9706                 , output where-phrase
     9707                 , output sort-phrase
     9708                 , output where-phrase-rus
     9709                 , output sort-phrase-rus
     9710                 ) .
     9711   if v-flt-rec = ? then do:
     9712     return error.
     9713   end.
     9714   else do:
     9715     find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     9716     run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9717                                         , input-output v-seq
     9718                                         , input 0
     9719                                         , input 'trn-doc':U
     9720                                         , input '':U
     9721                                         , input substitute("Фильтр накладных: &1 &2", ubflt.filter.naim, ubflt.filter.where-ysl-rus)
     9722                                         , input tot-lns
     9723                                         , input rs-list-method
     9724                                         , input rs-status
     9725                                         , input ubflt.filter.where-ysl
     9726                                         , input '':U
     9727                                         , input ?
     9728                                         ).
     9729   end.
     9730   END PROCEDURE.
     9731   PROCEDURE write-hist :
     9732   define input parameter p-from-macro as logical no-undo .
     9733   define input parameter rs-list-method as character no-undo .
     9734   define input parameter p-table-name as character no-undo .
     9735   define input parameter rs-status as character no-undo .
     9736   define input parameter line-mode as character no-undo .
     9737   define variable v-ii as integer no-undo .
     9738   define variable v-temp-seq as integer no-undo .
     9739   if rs-list-method = "single" then do:
     9740     if v-no-hist < 0 then do:
     9741       run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9742                                           , input-output v-seq
     9743                                           , input 0
     9744                                           , input p-table-name
     9745                                           , input get-hist-mode(line-mode)
     9746                                           , input substitute("Документ &1 от &2 &3&4 (факт.дата &5)"
     9747                                                             , doc-list.doc-code
     9748                                                             , string(doc-list.doc-date, "99/99/9999")
     9749                                                             , doc-list.obj-type
     9750                                                             , doc-list.obj-code
     9751                                                             , string(doc-list.fact-date, "99/99/9999")
     9752                                                             )
     9753                                           , input tot-lns
     9754                                           , input rs-list-method
     9755                                           , input rs-status
     9756                                           , input (p-table-name + chr(3) + doc-list.doc-code)
     9757                                           , input ''
     9758                                           , input ?
     9759                                           ).
     9760     end.
     9761     else do:
     9762       v-temp-seq = v-seq - 1.
     9763       do v-ii = 0 to v-no-hist:
     9764         run create-doc-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9765                                             , input-output v-temp-seq
     9766                                             , input v-ii
     9767                                             , input p-table-name
     9768                                             , input get-hist-mode(line-mode)
     9769                                             , input substitute("Документ &1 от &2 &3&4 (факт.дата &5)"
     9770                                                               , doc-list.doc-code
     9771                                                               , string(doc-list.doc-date, "99/99/9999")
     9772                                                               , doc-list.obj-type
     9773                                                               , doc-list.obj-code
     9774                                                               , string(doc-list.fact-date, "99/99/9999")
     9775                                                               )
     9776                                             , input tot-lns
     9777                                             , input '':U
     9778                                             , input '':U
     9779                                             , input (p-table-name + chr(3) + doc-list.doc-code)
     9780                                             , input '':U
     9781                                             , input ?
     9782                                             ).
     9783       end.
     9784     end.
     9785   end.
     9786   else do:
     9787     v-temp-seq = v-seq - 1.
     9788     do v-ii = 0 to v-no-hist:
     9789       run create-doc-list-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     9790                                           , input-output  v-temp-seq
     9791                                           , input v-ii
     9792                                           , input p-table-name
     9793                                           , input get-hist-mode(line-mode)
     9794                                           , input '':U
     9795                                           , input tot-lns
     9796                                           , input rs-list-method
     9797                                           , input '':U
     9798                                           , input '':U
     9799                                           , input '':U
     9800                                           , input ?
     9801                                           ).
     9802     end.
     9803   end.
     9804   END PROCEDURE.
     9805   FUNCTION get-client RETURNS CHARACTER
     9806     ( input loc-doc-code as character,
     9807       input loc-doc-type as character) :
     9808     case loc-doc-type:
     9809       when 'переоценка':U then do:
     9810       assign
     9811       dcli-type = ""
     9812       dcli-code = ?
     9813       dcli-name = "Переоценка"
     9814       .
     9815       find first ub.price-doc no-lock where
     9816                  ub.price-doc.doc-num = doc-list.doc-code No-ERROR.
     9817       if avail ub.price-doc then
     9818       ddoc-ps = ub.price-doc.PS.
     9819       else ddoc-ps = "".
     9820       return dcli-type.
     9821     end.
     9822       when 'производство':U  then do:
     9823         assign
     9824         dcli-type = ""
     9825         dcli-code = ?
     9826         dcli-name = "Производство"
     9827         .
     9828         find first ub.fbr-doc no-lock where
     9829                   ub.fbr-doc.doc-code = doc-list.doc-code No-ERROR.
     9830         if avail ub.fbr-doc then
     9831         ddoc-ps = ub.fbr-doc.PS.
     9832         else ddoc-ps = "".
     9833         return dcli-type.
     9834       end.
     9835       otherwise do:
     9836         if lookup(loc-doc-type, 'ОФ,ФП,ОП,ОО,ОР,ПО') > 0 then do:
     9837           FIND FIRST ub.ord-doc No-LOCK WHERE
     9838                     ub.ord-doc.doc-code = loc-doc-code No-ERROR.
     9839           if not avail ub.ord-doc then do:
     9840             assign
     9841             dcli-type = "?"
     9842             dcli-code = ?
     9843             dcli-name = "Заказ/заявка не найдены"
     9844             ddoc-ps = ""
     9845             .
     9846             return dcli-type.
     9847           end.
     9848           assign
     9849           dcli-type = ub.ord-doc.cli-type
     9850           dcli-code = ub.ord-doc.cli-code
     9851           ddoc-ps = ub.ord-doc.PS
     9852           .
     9853           find first ub.clients no-lock where
     9854                     ub.clients.obj-type = ub.ord-doc.cli-type AND
     9855                     ub.clients.obj-code = ub.ord-doc.cli-code No-ERROR.
     9856           if not avail ub.clients then do:
     9857               assign
     9858               dcli-name = "Контрагент по заказу/заявке не найден"
     9859               .
     9860               return dcli-type.
     9861           end.
     9862           assign
     9863           dcli-name = ub.clients.obj-name
     9864           .
     9865           return dcli-type.
     9866         end.
     9867         else do:
     9868           if loc-doc-type begins "-" then do:
     9869             FIND FIRST ub.c-trn-doc No-LOCK WHERE
     9870                       ub.c-trn-doc.doc-code = loc-doc-code No-ERROR.
     9871             if not avail ub.c-trn-doc then do:
     9872               assign
     9873               dcli-type = "?"
     9874               dcli-code = ?
     9875               dcli-name = "Документ не найден"
     9876               ddoc-ps = ""
     9877               .
     9878               return dcli-type.
     9879             end.
     9880             assign
     9881             dcli-type = ub.c-trn-doc.cli-type
     9882             dcli-code = ub.c-trn-doc.cli-code
     9883             ddoc-ps = ub.c-trn-doc.PS
     9884             .
     9885             find first ub.clients no-lock where
     9886                       ub.clients.obj-type = ub.c-trn-doc.cli-type AND
     9887                       ub.clients.obj-code = ub.c-trn-doc.cli-code No-ERROR.
     9888             if not avail ub.clients then do:
     9889               assign
     9890               dcli-name = "Контрагент по документу не найден"
     9891               .
     9892               return dcli-type.
     9893             end.
     9894             assign
     9895             dcli-name = ub.clients.obj-name
     9896             .
     9897             return dcli-type.
     9898           end.
     9899           else do:
     9900         FIND FIRST ub.trn-doc No-LOCK WHERE
     9901                   ub.trn-doc.doc-code = loc-doc-code No-ERROR.
     9902             if not avail ub.trn-doc then do:
     9903           assign
     9904           dcli-type = "?"
     9905           dcli-code = ?
     9906           dcli-name = "Документ не найден"
     9907           ddoc-ps = ""
     9908           .
     9909           return dcli-type.
     9910       end.
     9911       assign
     9912       dcli-type = ub.trn-doc.cli-type
     9913       dcli-code = ub.trn-doc.cli-code
     9914       ddoc-ps = ub.trn-doc.PS
     9915       .
     9916       find first ub.clients no-lock where
     9917                  ub.clients.obj-type = ub.trn-doc.cli-type AND
     9918                  ub.clients.obj-code = ub.trn-doc.cli-code No-ERROR.
     9919       if not avail ub.clients then do:
     9920           assign
     9921           dcli-name = "Контрагент по документу не найден"
     9922           .
     9923           return dcli-type.
     9924       end.
     9925       assign
     9926       dcli-name = ub.clients.obj-name
     9927       .
     9928       return dcli-type.
     9929     end.
     9930       end.
     9931     end.
     9932   end case.
     9933     RETURN "".
     9934   END FUNCTION.
