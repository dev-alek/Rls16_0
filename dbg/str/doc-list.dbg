        1   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        4   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        5   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo initial "Автоматизированное формирование списка документов":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define  SHARED  temp-table doc-list no-undo
      117   field doc-date   like ub.trn-doc.doc-date
      118   field doc-code   like ub.trn-doc.doc-code
      119   field obj-type   like ub.trn-doc.obj-type
      120   field obj-code   like ub.trn-doc.obj-code
      121   field fact-num   like ub.trn-doc.fact-num
      122   field fact-date  like ub.trn-doc.fact-date
      123   field shift-date like ub.trn-doc.shift-date
      124   field shift-num  like ub.trn-doc.shift-num
      125   field shift-name like ub.trn-doc.shift-name
      126   field fact-order as decimal
      127   field is-trn-doc as logical
      128   field is-del as logical
      129   field doc-type   like ub.trn-doc.doc-type
      130   field ext-doc-type   like ub.trn-doc.ext-doc-type
      131   field sel-order  as integer
      132   field znak       as integer
      133   field to-del     as logical
      134   field is-archive-exist as logical
      135   index xpk is primary unique doc-code doc-type
      136   index xfact fact-num
      137   index xfact-date fact-date
      138   index sel-order sel-order
      139   index znak-order znak sel-order
      140   index isdel is-del
      141   .
      142   define buffer inkas_trn-doc for ub.trn-doc .
      143   define buffer c-inkas_trn-doc for ub.c-trn-doc .
      144   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define   SHARED   temp-table doc-list-hist no-undo
      146   field list-table as character
      147   field id as integer
      148   field line as integer
      149   field hist-mode as character
      150   field des as character
      151   field num-recs as integer
      152   field option_ as character
      153   field item_ as character
      154   field status_ as character
      155   field num-add as integer
      156   field num-ignored as integer
      157   field done as logical
      158   field err_ as logical
      159   field err-mes as character
      160   index pi is primary
      161   id
      162   line
      163   index isdone
      164   done
      165   .
      166   define variable g#report-num as integer no-undo .
      167   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   procedure gen-key-rec :
      170     define input  parameter p-tbl-name    as character no-undo.
      171     define input  parameter p-bh_tbl-name as handle    no-undo.
      172     define output parameter p-key-rec     as character no-undo.
      173     do
      174     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      175     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      176     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      177     :
      178       define variable fh               as handle    no-undo .
      179       define variable v-ok             as logical   no-undo .
      180       define variable v-inform         as character no-undo .
      181       define variable v-ind            as integer   no-undo .
      182       define variable v-idx-field-qnty as integer   no-undo .
      183       if p-tbl-name = ?
      184         or p-tbl-name = "":U
      185       then do:
      186         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      187       end.
      188       if not p-bh_tbl-name:available then do:
      189         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      190       end.
      191       assign
      192         p-key-rec = p-tbl-name
      193         v-inform  = p-bh_tbl-name:index-information(1)
      194         v-ind     = 2
      195       .
      196       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      197       on error undo, return error
      198       :
      199         assign
      200           v-inform = p-bh_tbl-name:index-information( v-ind )
      201           v-ind    = v-ind + 1
      202         .
      203       end.
      204       if v-inform = ?
      205         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      206         or entry( 3, v-inform, ",":U ) <> "1":U
      207       then do:
      208         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      209       end.
      210       else do:
      211         assign
      212           v-idx-field-qnty = num-entries( v-inform ) - 4
      213         .
      214         if v-idx-field-qnty < 2 then do:
      215           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      216         end.
      217         do v-ind = 1 to v-idx-field-qnty by 2
      218         on error undo, return error
      219         :
      220           assign
      221             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      222             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      223           .
      224         end.
      225       end.
      226       if p-key-rec = ? then do:
      227         assign
      228           p-key-rec = "":U
      229         .
      230         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      231       end.
      232     end.
      233     return.
      234   end procedure.
      235   procedure gen-where-keyr-tab :
      236     define input  parameter i-tableSerach as character no-undo.
      237     define input  parameter i-tablekey   as character  no-undo.
      238     define input  parameter p-key-rec    as character  no-undo.
      239     define input  parameter p-key-handle as handle     no-undo .
      240     define input  parameter p-db-name    as character  no-undo .
      241     define input  parameter p-tt-handle  as handle     no-undo .
      242     define output parameter o-Where      as character  no-undo.
      243     do
      244     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      245     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      246     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      247     :
      248       define variable v-full-tbl-name  as character no-undo .
      249       define variable bh_tbl-name      as handle    no-undo .
      250       define variable fh_key           as handle    no-undo .
      251       define variable fh_search        as handle    no-undo .
      252       define variable v-field-num      as integer   no-undo .
      253       define variable v-count-fld      as integer   no-undo .
      254       define variable v-inform         as character no-undo .
      255       define variable v-ind            as integer   no-undo .
      256       define variable v-idx-field-qnty as integer   no-undo .
      257       define variable v-field-name     as character no-undo .
      258       define variable v-field-val      as character no-undo .
      259       define variable v-word-link      as character no-undo .
      260       define variable vTable           as character no-undo.
      261       define variable bh_tbl-key       as handle    no-undo .
      262       assign
      263         p-key-rec = trim( p-key-rec )
      264       .
      265       if p-key-handle <> ? then do:
      266         if not valid-handle(p-key-handle)
      267            or p-key-handle:type <> "buffer"
      268         then do:
      269           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      270         end.
      271         if num-entries( p-key-rec, chr(3) ) > 1
      272           or p-key-rec = ?
      273           or p-key-rec = "":U
      274         then do:
      275           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      276         end.
      277       end.
      278       else do:
      279         if p-key-rec = ?
      280           or p-key-rec = "":U
      281         then do:
      282           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      283         end.
      284       end.
      285       assign
      286         vTable = entry( 1 , p-key-rec, chr(3) )
      287       .
      288       if p-tt-handle <> ?
      289         and ( not valid-handle(p-tt-handle)
      290               or p-tt-handle:type <> "buffer"
      291             )
      292       then do:
      293         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      294       end.
      295       if p-tt-handle = ? then do:
      296         assign
      297           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      298         .
      299         create buffer bh_tbl-name for table v-full-tbl-name .
      300       end.
      301       else do:
      302         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      303       end.
      304       assign
      305         v-inform = bh_tbl-name:index-information(1)
      306         v-ind    = 2
      307       .
      308       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      309       on error undo, return error
      310       :
      311         assign
      312           v-inform = bh_tbl-name:index-information( v-ind )
      313           v-ind    = v-ind + 1
      314         .
      315       end.
      316       if v-inform = ?
      317         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      318         or entry( 3, v-inform, ",":U ) <> "1":U
      319       then do:
      320         delete object bh_tbl-name no-error.
      321         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      322       end.
      323       assign
      324         v-idx-field-qnty = num-entries( v-inform ) - 4
      325       .
      326       if v-idx-field-qnty < 2 then do:
      327         delete object bh_tbl-name no-error.
      328         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      329       end.
      330       assign
      331         o-where     = "where":U
      332         v-word-link = "":U
      333         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      334         v-count-fld = 0
      335       .
      336       if i-tablekey ne "" and i-tablekey ne ?
      337       then do:
      338         assign
      339           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      340         .
      341         create buffer bh_tbl-key for table v-full-tbl-name .
      342       end.
      343       if i-tableSerach ne "" and i-tableSerach ne ?
      344       then do:
      345         delete object bh_tbl-name no-error.
      346         assign
      347           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      348         .
      349         create buffer bh_tbl-name for table v-full-tbl-name .
      350       end.
      351       block_where:
      352       do v-ind = 1 to v-idx-field-qnty by 2
      353       on error undo, return error
      354       :
      355         assign
      356           v-count-fld = v-count-fld + 1
      357         .
      358         if p-key-handle = ?
      359           and v-count-fld > v-field-num
      360         then do:
      361           leave block_where.
      362         end.
      363         define variable VfieldKeyTable as handle no-undo.
      364         assign
      365           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      366           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      367         .
      368         if     bh_tbl-key ne ?
      369         then do:
      370            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      371            if VfieldKeyTable eq ?
      372            then next block_where.
      373         end.
      374         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      375         then
      376            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      377         else
      378            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      379         if p-key-handle = ? then do:
      380           assign
      381             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      382           .
      383         end.
      384         else do:
      385           assign
      386             fh_key = p-key-handle:buffer-field( v-field-name )
      387           .
      388           if fh_key = ?
      389             or not valid-handle( fh_key )
      390           then do:
      391             delete object bh_tbl-name.
      392             if     bh_tbl-key ne ?
      393             then
      394                delete object bh_tbl-key.
      395             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      396           end.
      397           assign
      398             v-field-val = fh_key:buffer-value
      399           .
      400         end.
      401         if fh_search:data-type ="character":U then do:
      402           assign
      403             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      404             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      405             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      406             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      407             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      408             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      409             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      410             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      411             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      412             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      413             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      414             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      415             v-field-val = substitute( '"&1"', v-field-val )
      416           .
      417         end.
      418         assign
      419           o-where = substitute( "&1 &2", o-where, v-field-val )
      420         .
      421         if v-word-link = "":U then do:
      422           assign
      423             v-word-link = "and":U
      424           .
      425         end.
      426       end.
      427       delete object bh_tbl-name.
      428       if     bh_tbl-key ne ?
      429       then
      430          delete object bh_tbl-key.
      431       if p-key-handle = ?
      432         and v-count-fld <> v-field-num
      433       then do:
      434         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      435       end.
      436     end.
      437   end procedure.
      438   procedure gen-hn-keyr-tab :
      439     define input  parameter i-tableSerach as character no-undo.
      440     define input  parameter i-tablekey   as character no-undo.
      441     define input  parameter p-key-rec    as character no-undo.
      442     define input  parameter p-key-handle as handle    no-undo .
      443     define input  parameter p-db-name    as character no-undo .
      444     define input  parameter p-tt-handle  as handle    no-undo .
      445     define input  parameter p-stts-lock  as integer   no-undo .
      446     define output parameter o-hn         as handle    no-undo.
      447     define variable v-full-tbl-name as character no-undo.
      448     define variable v-where         as character no-undo.
      449     define variable bh_tbl-name     as handle    no-undo.
      450     define variable vTable          as character no-undo.
      451     do
      452     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      453     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      454     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      455         run gen-where-keyr-tab(i-tableSerach,
      456                                i-tablekey,
      457                                p-key-rec,
      458                                p-key-handle,
      459                                p-db-name,
      460                                p-tt-handle,
      461                                output v-where).
      462         if i-tableSerach ne "" and i-tableSerach ne ?
      463         then do:
      464            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      465            create buffer bh_tbl-name for table v-full-tbl-name .
      466         end.
      467         else do:
      468            if p-tt-handle = ? then do:
      469               assign
      470                  vTable = entry( 1 , p-key-rec, chr(3) )
      471               .
      472               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      473               create buffer bh_tbl-name for table v-full-tbl-name .
      474            end.
      475            else do:
      476               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      477            end.
      478         end.
      479         if p-tt-handle = ? then do:
      480            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      481         end.
      482         else do:
      483            bh_tbl-name:find-first( v-where ) no-error .
      484         end.
      485         o-hn = bh_tbl-name.
      486      end.
      487   end procedure.
      488   procedure gen-hn-keyr :
      489     define input  parameter p-key-rec    as character no-undo.
      490     define input  parameter p-key-handle as handle    no-undo .
      491     define input  parameter p-db-name    as character no-undo .
      492     define input  parameter p-tt-handle  as handle    no-undo .
      493     define input  parameter p-stts-lock  as integer   no-undo .
      494     define output parameter o-hn         as handle    no-undo.
      495     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      496   end.
      497   procedure gen-row-keyr :
      498     define input  parameter p-key-rec    as character no-undo.
      499     define input  parameter p-key-handle as handle    no-undo .
      500     define input  parameter p-db-name    as character no-undo .
      501     define input  parameter p-tt-handle  as handle    no-undo .
      502     define input  parameter p-stts-lock  as integer   no-undo .
      503     define output parameter p-tbl-row    as rowid     no-undo.
      504     define output parameter p-tbl-name   as character no-undo.
      505     define variable vHn as handle no-undo.
      506       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      507       p-tbl-row = if vHn:available then vHn:rowid else ?.
      508       p-tbl-name =  vHn:table.
      509       delete object vHn no-error.
      510     if p-tbl-row = ? then do:
      511       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      512     end.
      513     else do:
      514       return.
      515     end.
      516   end procedure.
      517   procedure gen-key-fv :
      518     define input  parameter p-key-rec    as character no-undo .
      519     define output parameter p-field-list as character no-undo .
      520     define output parameter p-value-list as character no-undo.
      521     do
      522     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      523     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      524     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      525     :
      526       define variable v-full-tbl-name  as character no-undo .
      527       define variable bh_tbl-name      as handle    no-undo .
      528       define variable v-tbl-name       as character no-undo .
      529       define variable v-field-num      as integer   no-undo .
      530       define variable v-count-fld      as integer   no-undo .
      531       define variable v-inform         as character no-undo .
      532       define variable v-ind            as integer   no-undo .
      533       define variable v-idx-field-qnty as integer   no-undo .
      534       define variable v-delim-key      as character no-undo .
      535       if p-key-rec = ?
      536         or p-key-rec = "":U
      537       then do:
      538         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      539       end.
      540       assign
      541         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      542         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      543       .
      544       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      545       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      546       assign
      547         v-inform = bh_tbl-name:index-information(1)
      548         v-ind    = 2
      549       .
      550       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      551       on error undo, return error
      552       :
      553         assign
      554           v-inform = bh_tbl-name:index-information( v-ind )
      555           v-ind    = v-ind + 1
      556         .
      557       end.
      558       if v-inform = ?
      559         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      560         or entry( 3, v-inform, ",":U ) <> "1":U
      561       then do:
      562         delete object bh_tbl-name no-error.
      563         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      564       end.
      565       assign
      566         v-idx-field-qnty = num-entries( v-inform ) - 4
      567       .
      568       if v-idx-field-qnty < 2 then do:
      569         delete object bh_tbl-name no-error.
      570         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      571       end.
      572       assign
      573         p-field-list = "":U
      574         p-value-list = "":U
      575         v-delim-key  = "":U
      576         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      577         v-count-fld  = 0
      578       .
      579       block_where:
      580       do v-ind = 1 to v-idx-field-qnty by 2
      581       on error undo, return error
      582       :
      583         assign
      584           v-count-fld = v-count-fld + 1
      585         .
      586         if v-count-fld > v-field-num then do:
      587           leave block_where.
      588         end.
      589         assign
      590           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      591           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      592         .
      593         if v-ind = 1 then do:
      594           assign
      595             v-delim-key = chr(3)
      596           .
      597         end.
      598       end.
      599       delete object bh_tbl-name.
      600       if v-count-fld <> v-field-num then do:
      601         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      602       end.
      603     end.
      604   end procedure.
      605   procedure gen-key-field :
      606     define input  parameter p-table      as character no-undo .
      607     define output parameter p-field-list as character no-undo .
      608     do
      609     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      610     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      611     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      612     :
      613       define variable v-full-tbl-name  as character no-undo .
      614       define variable bh_tbl-name      as handle    no-undo .
      615       define variable v-tbl-name       as character no-undo .
      616       define variable v-field-num      as integer   no-undo .
      617       define variable v-count-fld      as integer   no-undo .
      618       define variable v-inform         as character no-undo .
      619       define variable v-ind            as integer   no-undo .
      620       define variable v-idx-field-qnty as integer   no-undo .
      621       define variable v-delim-key      as character no-undo .
      622       if p-table = ?
      623         or p-table = "":U
      624       then do:
      625         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      626       end.
      627       assign
      628         v-tbl-name      = p-table
      629         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      630       .
      631       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      632       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      633       assign
      634         v-inform = bh_tbl-name:index-information(1)
      635         v-ind    = 2
      636       .
      637       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      638       on error undo, return error
      639       :
      640         assign
      641           v-inform = bh_tbl-name:index-information( v-ind )
      642           v-ind    = v-ind + 1
      643         .
      644       end.
      645       if v-inform = ?
      646         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      647         or entry( 3, v-inform, ",":U ) <> "1":U
      648       then do:
      649         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      650       end.
      651       assign
      652         v-idx-field-qnty = num-entries( v-inform ) - 4
      653       .
      654       if v-idx-field-qnty < 2 then do:
      655         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      656       end.
      657       assign
      658         p-field-list = "":U
      659         v-delim-key  = "":U
      660         v-count-fld  = 0
      661       .
      662       block_where:
      663       do v-ind = 1 to v-idx-field-qnty by 2
      664       on error undo, return error
      665       :
      666         assign
      667           v-count-fld = v-count-fld + 1
      668         .
      669         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      670         if v-ind = 1 then do:
      671           assign
      672             v-delim-key = chr(3)
      673           .
      674         end.
      675       end.
      676       delete object bh_tbl-name.
      677     end.
      678   end procedure.
      679   procedure create-doc-list-hist :
      680   define input parameter p-mode as character no-undo .
      681   define input-output parameter p-seq as integer no-undo .
      682   define input parameter p-line as integer no-undo .
      683   define input parameter p-list-table as character no-undo .
      684   define input parameter p-hist-mode as character no-undo .
      685   define input parameter p-des as character no-undo .
      686   define input parameter p-num-recs as integer no-undo .
      687   define input parameter p-option as character no-undo .
      688   define input parameter p-status_ as character no-undo .
      689   define input parameter p-item as character no-undo .
      690   define input parameter p-tbl-name as character no-undo .
      691   define input parameter p-bh_tbl-name as handle no-undo .
      692   define variable v-num-add as integer no-undo .
      693   define variable v-num-ignored as integer no-undo .
      694   define buffer buf_doc-list-hist for doc-list-hist.
      695     do
      696     on error undo, return error
      697     :
      698       CASE p-mode:
      699         when 'title' then do:
      700           find first buf_doc-list-hist where
      701                      buf_doc-list-hist.id = 0   no-error.
      702           if not available buf_doc-list-hist then do:
      703             create buf_doc-list-hist.
      704             assign
      705             buf_doc-list-hist.id = 0
      706             buf_doc-list-hist.line = 0
      707             buf_doc-list-hist.list-table = '':U
      708             .
      709           end.
      710           assign
      711           buf_doc-list-hist.des =  p-des
      712           buf_doc-list-hist.num-recs = p-num-recs
      713           buf_doc-list-hist.option_  = p-option
      714           buf_doc-list-hist.item_ = p-item
      715           .
      716         end.
      717         when 'ДОБАВЛЕНИЕ':U then do:
      718           if p-option begins 'single' then do:
      719             CASE p-hist-mode:
      720               when '+':U then do:
      721                 assign
      722                 v-num-add = 1
      723                 v-num-ignored  = 0
      724                 .
      725               end.
      726               when '-':U then do:
      727                 assign
      728                 v-num-add = 1
      729                 v-num-ignored  = 0
      730                 .
      731               end.
      732               when '*':U then do:
      733                 assign
      734                 v-num-add = p-num-recs - 1
      735                 p-num-recs = 1
      736                 v-num-ignored  = 0
      737                 .
      738               end.
      739             END CASE.
      740           end.
      741           create buf_doc-list-hist.
      742           assign
      743           buf_doc-list-hist.id = p-seq
      744           buf_doc-list-hist.list-table = p-list-table
      745            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
      746           buf_doc-list-hist.des =  p-des
      747           buf_doc-list-hist.line = p-line
      748           buf_doc-list-hist.num-recs = p-num-recs
      749           buf_doc-list-hist.option_  = p-option
      750           buf_doc-list-hist.item_ = p-item
      751           buf_doc-list-hist.hist-mode =  p-hist-mode
      752           buf_doc-list-hist.status_ =  p-status_
      753           buf_doc-list-hist.num-add = v-num-add
      754           buf_doc-list-hist.num-ignored = v-num-ignored
      755           .
      756         end.
      757         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
      758           find first buf_doc-list-hist where
      759                     buf_doc-list-hist.id = p-seq
      760                 and buf_doc-list-hist.line = p-line no-error .
      761           if  available buf_doc-list-hist then do:
      762             assign
      763             buf_doc-list-hist.des =  p-des
      764             buf_doc-list-hist.num-recs = p-num-recs
      765             buf_doc-list-hist.option_  = p-option
      766             buf_doc-list-hist.item_ = p-item
      767             buf_doc-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      768                                        then p-list-table
      769                                        else buf_doc-list-hist.list-table)
      770             .
      771           end.
      772         end.
      773         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
      774           find first buf_doc-list-hist where
      775                     buf_doc-list-hist.id = p-seq
      776                 and buf_doc-list-hist.line = p-line  no-error .
      777           if available buf_doc-list-hist then do:
      778             assign
      779             buf_doc-list-hist.hist-mode =  p-hist-mode
      780             buf_doc-list-hist.num-recs  = (if buf_doc-list-hist.line = 0 then p-num-recs else buf_doc-list-hist.num-recs)
      781             buf_doc-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
      782                                        then p-list-table
      783                                        else buf_doc-list-hist.list-table)
      784             .
      785           end.
      786         end.
      787       END CASE.
      788       if p-tbl-name <> "":U
      789       and valid-handle(p-bh_tbl-name)
      790       then do:
      791         run gen-key-rec  in this-procedure (
      792                                               input  p-tbl-name
      793                                              ,input  p-bh_tbl-name
      794                                              ,output p-item) no-error .
      795         if not error-status:error then do:
      796           assign
      797           buf_doc-list-hist.item_ = p-item
      798           .
      799         end.
      800         else do:
      801           assign
      802           buf_doc-list-hist.item_ = "!ERROR"
      803           .
      804         end.
      805       end.
      806     end.
      807   end procedure.
      808   FUNCTION get-line-mode returns character(input p-hist-mode as character):
      809   case p-hist-mode:
      810     when '+':U then
      811       return  'ДОБАВЛЕНИЕ':U.
      812     when '-':U then
      813       return  'удаление':U.
      814     when '*':U then
      815       return  'ОСТАВИТЬ':U.
      816   end CASE.
      817   END FUNCTION.
      818   FUNCTION get-hist-mode returns character(input p-line-mode as character):
      819   case p-line-mode:
      820     when 'ДОБАВЛЕНИЕ':U then
      821       return  "+".
      822     when 'удаление':U then
      823       return  "-".
      824     when 'ОСТАВИТЬ':U then
      825       return  "*".
      826   end CASE.
      827   END FUNCTION.
      828   procedure proc-write-filter-expression :
      829   define input parameter p-filter-expression as character no-undo .
      830   define variable v-ii as integer no-undo .
      831   output to value(string(g#report-num) + ".whr").
      832   put .
      833   if num-entries(p-filter-expression) > 0 then do:
      834      put unformatted 'and ('.
      835      do v-ii = 1 to num-entries(p-filter-expression):
      836        put unformatted entry(v-ii, p-filter-expression) skip.
      837      end.
      838      put unformatted ')'.
      839   end.
      840   output close.
      841   end procedure.
      842   procedure proc-write-filter-expression-var :
      843   define input parameter p-filter-expression as character no-undo .
      844   define output parameter p-string as character no-undo .
      845   define variable v-ii as integer no-undo .
      846   if num-entries(p-filter-expression) > 0 then do:
      847      p-string = 'and ('.
      848      do v-ii = 1 to num-entries(p-filter-expression):
      849        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
      850      end.
      851      p-string = p-string + ')'.
      852   end.
      853   end procedure.
      854   DEFINE TEMP-TABLE temp-list NO-UNDO LIKE ub.units
      855   field fname as character format "X(40)"
      856   field fvalue as character
      857   field id as integer
      858   index pi is primary unique
      859   id.
      860   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define variable c-point  as character no-undo .
      862   define variable tbl      as character no-undo .
      863   define variable join-tbl as character no-undo .
      864   define variable fld      as character no-undo .
      865   define variable lab      as character no-undo .
      866   define variable spr      as character no-undo .
      867   define variable dim      as character no-undo .
      868   function diff-list returns character (
      869     input parfirst-list  as character,
      870     input parsecond-list as character,
      871     input pardelim       as character).
      872     if pardelim = ""
      873     or pardelim = ?
      874     then do:
      875       assign
      876         pardelim = ","
      877       .
      878     end.
      879     def var ind as integer no-undo .
      880     def var v-elem as character no-undo .
      881     def var v-result-list as character no-undo init "".
      882     def var v-num-parfirst-list as integer no-undo .
      883     assign
      884       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      885     .
      886     do ind = 1 to v-num-parfirst-list
      887     :
      888       assign
      889         v-elem = entry(ind, parfirst-list, pardelim)
      890       .
      891       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      892         assign
      893           v-result-list = v-result-list
      894                         + (if v-result-list > "" then pardelim else "")
      895                         + v-elem
      896         .
      897       end.
      898     end.
      899     return v-result-list .
      900   end function.
      901   function add-list returns character (
      902    input parfirst-list  as character,
      903    input parsecond-list as character,
      904    input pardelim       as character).
      905     if pardelim = ""
      906     or pardelim = ?
      907     then do:
      908       assign
      909         pardelim = ","
      910       .
      911     end.
      912     def var ind as integer no-undo .
      913     def var v-elem as character no-undo .
      914     def var v-result-list as character no-undo init "".
      915     def var v-num-parfirst-list as integer no-undo .
      916     assign
      917       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      918     .
      919     do ind = 1 to v-num-parfirst-list
      920     :
      921       assign
      922         v-elem = entry(ind, parfirst-list, pardelim)
      923       .
      924       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      925         assign
      926           v-result-list = v-result-list
      927                         + (if v-result-list > "" then pardelim else "")
      928                         + v-elem
      929         .
      930       end.
      931     end.
      932     def var v-num-parsecond-list as integer no-undo .
      933     assign
      934       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      935     .
      936     do ind = 1 to v-num-parsecond-list
      937     :
      938       assign
      939         v-elem = entry(ind, parsecond-list, pardelim)
      940       .
      941       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      942         assign
      943           v-result-list = v-result-list
      944                         + (if v-result-list > "" then pardelim else "")
      945                         + v-elem
      946         .
      947       end.
      948     end.
      949     return v-result-list .
      950   end function.
      951   function cross-list returns character (
      952    input parfirst-list  as character,
      953    input parsecond-list as character,
      954    input pardelim       as character).
      955     if pardelim = ""
      956     or pardelim = ?
      957     then do:
      958       assign
      959         pardelim = ","
      960       .
      961     end.
      962     def var ind as integer no-undo .
      963     def var v-elem as character no-undo .
      964     def var v-result-list as character no-undo init "".
      965     def var v-num-parfirst-list as integer no-undo .
      966     assign
      967       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      968     .
      969     do ind = 1 to v-num-parfirst-list
      970     :
      971       assign
      972         v-elem = entry(ind, parfirst-list, pardelim)
      973       .
      974       if lookup(v-elem, v-result-list, pardelim) = 0
      975       and lookup(v-elem, parsecond-list, pardelim) > 0
      976       then do:
      977         assign
      978           v-result-list = v-result-list
      979                         + (if v-result-list > "" then pardelim else "")
      980                         + v-elem
      981         .
      982       end.
      983     end.
      984     return v-result-list .
      985   end function.
      986   function radio-label returns character (
      987    input par-rs-value  as character,
      988    input par-rs-radio-buttons as character)
      989    .
      990    DEFINE variable v-result-label as character no-undo.
      991    assign
      992    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      993                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      994                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      995                             ), par-rs-radio-buttons
      996                           )
      997    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      998    .
      999   return v-result-label.
     1000   end function.
     1001   function m-radio-label returns character (
     1002    input par-rs-value  as character,
     1003    input par-rs-radio-buttons as character,
     1004    input par-delim as character
     1005    )
     1006    .
     1007    DEFINE variable v-result-label as character no-undo.
     1008    assign
     1009    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1010                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1011                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1012                             ), par-rs-radio-buttons, par-delim
     1013                           )
     1014    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1015    .
     1016   return v-result-label.
     1017   end function.
     1018   FUNCTION mixlist returns character
     1019   (
     1020    input parfirst-list  as character
     1021    ,input parsecond-list as character
     1022    ,input pardelim       as character
     1023    ,input pardelim-result as character ) :
     1024     if pardelim = ""
     1025     or pardelim = ?
     1026     then do:
     1027       assign
     1028         pardelim = ","
     1029       .
     1030     end.
     1031     def var ind as integer no-undo .
     1032     def var v-elem1 as character no-undo .
     1033     def var v-elem2 as character no-undo .
     1034     def var v-result-list as character no-undo init "".
     1035     do ind = 1 to num-entries(parfirst-list, pardelim)
     1036     :
     1037       assign
     1038         v-elem1 = entry(ind, parfirst-list, pardelim)
     1039         v-elem2 = entry(ind, parsecond-list, pardelim)
     1040       .
     1041         assign
     1042           v-result-list = v-result-list
     1043                         + (if v-result-list > "" then pardelim-result else "")
     1044                         + v-elem1 + pardelim-result + v-elem2
     1045         .
     1046     end.
     1047     return v-result-list .
     1048   END FUNCTION.
     1049   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   procedure fltfield-clear :
     1051     define output parameter loc-fld as character no-undo.
     1052     define output parameter loc-lab as character no-undo .
     1053     define output parameter loc-spr as character no-undo .
     1054     define output parameter loc-dim as character no-undo .
     1055     assign
     1056       loc-fld = ""
     1057       loc-lab = ""
     1058       loc-spr = ""
     1059       loc-dim = "0"
     1060     .
     1061   end procedure .
     1062   procedure fltfield-add :
     1063     define input        parameter par-fld as character no-undo.
     1064     define input        parameter par-lab as character no-undo .
     1065     define input        parameter par-spr as character no-undo .
     1066     define input-output parameter loc-fld as character no-undo.
     1067     define input-output parameter loc-lab as character no-undo .
     1068     define input-output parameter loc-spr as character no-undo .
     1069     define input-output parameter loc-dim as character no-undo .
     1070     do
     1071     on error undo, return error
     1072     :
     1073       assign
     1074       loc-fld = if loc-dim = '0'
     1075                 then par-fld
     1076                 else (loc-fld + chr(44) + par-fld)
     1077       loc-lab = if loc-dim = '0'
     1078                 then par-lab
     1079                 else (loc-lab + chr(44) + par-lab)
     1080       loc-spr = if loc-dim = '0'
     1081                 then par-spr
     1082                 else (loc-spr + chr(44) + par-spr)
     1083       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1084                 string(integer(if num-entries(loc-dim) > 1
     1085                               then entry(2, loc-dim)
     1086                               else entry(1, loc-dim)
     1087                               ) + 1)
     1088       no-error
     1089       .
     1090     end.
     1091   end procedure.
     1092   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   procedure cli-grplib-get-full-name :
     1094      define input parameter  p-node-code  as integer      no-undo.
     1095      define output parameter p-full-name as character    no-undo.
     1096   do
     1097   on error undo, return error
     1098   :
     1099       define variable v-upper-code    as integer           no-undo.
     1100       define buffer buf_cli-grp       for ub.cli-grp.
     1101       define buffer buf_upper_cli-grp for ub.cli-grp.
     1102       find first buf_cli-grp no-lock
     1103            where buf_cli-grp.node-code = p-node-code
     1104       no-error.
     1105       if not available buf_cli-grp
     1106       then do:
     1107           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1108       end.
     1109       assign
     1110           p-full-name  = ""
     1111           v-upper-code = 1
     1112       .
     1113       do while buf_cli-grp.upper-code <> 0
     1114       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1115       :
     1116           assign
     1117               p-full-name  = buf_cli-grp.node-name
     1118                            + (if p-full-name <> "" then chr(47) else "")
     1119                            + p-full-name
     1120               v-upper-code = buf_cli-grp.upper-code
     1121           .
     1122           find first buf_cli-grp no-lock
     1123                where buf_cli-grp.node-code = v-upper-code
     1124           no-error.
     1125           if not available buf_cli-grp
     1126           then do:
     1127               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1128                                   + string( v-upper-code )
     1129                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1130           end.
     1131       end.
     1132       assign
     1133       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1134       .
     1135   end.
     1136   end .
     1137   procedure cgrplib-get-node-from-full-name :
     1138   define input parameter p-full-name as character no-undo .
     1139   define output parameter p-node-code as integer no-undo .
     1140   define variable v-ii as integer no-undo .
     1141   define variable v-upper-code as integer no-undo .
     1142   define variable v-root-code as integer no-undo .
     1143   define variable v-entry as character no-undo .
     1144   define buffer buf_cli-grp       for ub.cli-grp.
     1145   do
     1146   on error undo, return error
     1147   :
     1148     find first buf_cli-grp no-lock
     1149         where buf_cli-grp.upper-code = 0
     1150     no-error .
     1151     if not available buf_cli-grp
     1152     then do:
     1153         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1154     end.
     1155     else do:
     1156       assign
     1157       v-root-code = buf_cli-grp.node-code
     1158       .
     1159     end.
     1160     v-upper-code = v-root-code.
     1161     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1162       assign
     1163       v-entry = entry(v-ii, p-full-name, chr(47)).
     1164       if v-entry = '' then leave.
     1165       find first buf_cli-grp no-lock where
     1166                 buf_cli-grp.node-name = v-entry
     1167             and buf_cli-grp.upper-code = v-upper-code
     1168             no-error.
     1169       if not available buf_cli-grp then do:
     1170         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1171       end.
     1172       else do:
     1173         p-node-code = buf_cli-grp.node-code.
     1174         v-upper-code = buf_cli-grp.node-code.
     1175       end.
     1176     end.
     1177   end.
     1178   end .
