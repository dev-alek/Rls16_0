     7144                       ) no-error .
     7145         if ref-list = "" then do:
     7146           run Myenable in this-procedure .
     7147           return error.
     7148         end.
     7149         run str/sortdctp.p (input-output ref-list, input no).
     7150         v-recs = num-entries(ref-list).
     7151         do num-rec = 0 to v-recs:
     7152           if v-recs = 1 then do:
     7153             num-rec = 1 .
     7154           end.
     7155           if num-rec > 0 then do:
     7156             v-ref-rec = integer (entry (num-rec, ref-list)).
     7157             find buf_trn-doc where recid (buf_trn-doc) = v-ref-rec no-lock.
     7158           end.
     7159           if v-recs = 1 then do:
     7160             assign
     7161             v-temp-seq = v-seq
     7162             v-line     = 0
     7163             dsp-rs = substitute("Документ : &1 &2 &3 &4 № &5 от &6"
     7164                                 , buf_trn-doc.doc-type
     7165                                 , buf_trn-doc.status_
     7166                                 , buf_trn-doc.obj-type
     7167                                 , buf_trn-doc.obj-code
     7168                                 , buf_trn-doc.doc-code
     7169                                 , string (buf_trn-doc.doc-date, '99/99/9999')
     7170                                 )
     7171             v-item     = '':U
     7172             v-tbl-name = 'trn-doc':U
     7173             v-bh       = buffer buf_trn-doc:handle
     7174             v-tot-lns = tot-lns
     7175             .
     7176           end.
