     5024   def var vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5025   def var vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5026   define variable v-no-context as logical no-undo .
     5027   define variable v-user-obj-type as character no-undo .
     5028   define variable v-user-obj-code as integer no-undo .
     5029   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5030                                            , input p-no-context as logical ):
     5031   define variable v-uniq-key-rec as character no-undo .
     5032   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5033     v-uniq-key-rec = 'clients':U + chr(3) +
     5034                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5035                     entry(5, p-uniq-key-rec, chr(3)).
     5036   end.
     5037   else do:
     5038     v-uniq-key-rec = p-uniq-key-rec.
     5039     case entry(1, p-uniq-key-rec, chr(3)):
     5040        when 'user-obj':U then do:
     5041          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5042          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5043        end.
     5044     end case.
     5045   end.
     5046   return v-uniq-key-rec.
     5047   end function.
     5048   procedure find-user-obj-rowid :
     5049   define input parameter p-rowid as rowid no-undo .
     5050   define input parameter p-no-context as logical no-undo .
     5051   define output parameter p-user-obj-type as character no-undo .
     5052   define output parameter p-user-obj-code as integer no-undo .
     5053   define buffer user-obj_clients for ub.clients.
     5054   define buffer user-obj_user-obj for ub.user-obj .
     5055   if p-no-context then do:
     5056     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5057     assign
     5058     p-user-obj-type = user-obj_clients.obj-type
     5059     p-user-obj-code = user-obj_clients.obj-code.
     5060   end.
     5061   else do:
     5062     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5063     if not available user-obj_user-obj then do:
     5064       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5065     end.
     5066     assign
     5067     p-user-obj-type = user-obj_user-obj.obj-type
     5068     p-user-obj-code = user-obj_user-obj.obj-code.
     5069   end.
     5070   end procedure.
