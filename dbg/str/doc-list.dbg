     3371   run minbtn-set in this-procedure .
     3372   on choose of b-help in frame Dialog-Frame
     3373   do:
     3374     apply "help":u to frame Dialog-Frame .
     3375   end.
     3376   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3377   procedure minbtn-set :
     3378       do
     3379           on error undo, return error return-value
     3380           :
     3381           define variable ii              as integer       no-undo .
     3382           define variable fh              as widget-handle no-undo .
     3383           define variable hh              as widget-handle no-undo .
     3384           define variable v-h             as handle        extent 4 no-undo .
     3385           define variable v-name-button   as character     no-undo .
     3386           define variable v-help-old-x    as decimal       no-undo .
     3387           define variable v-help-old-y    as decimal       no-undo .
     3388           define variable v-help-old-size as decimal       no-undo .
     3389           define variable v-frame-width   as decimal       no-undo .
     3390           define variable jj              as integer       no-undo .
     3391           do
     3392               on error undo, return error
     3393               :
     3394               assign
     3395                   v-frame-width = frame Dialog-Frame:width - 0.3
     3396                   fh            = frame Dialog-Frame:first-child
     3397                   hh            = fh:first-child
     3398                   ii            = 1
     3399                   .
     3400               do while valid-handle(hh):
     3401                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3402                   do:
     3403                       case lc(hh:name) :
     3404                           when "b-help" then
     3405                               do:
     3406                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3407                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3408                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3409                                   hh:TOOLTIP = "Помощь" .
     3410                                   v-help-old-x = hh:column .
     3411                                   v-help-old-y = hh:row    .
     3412                                   v-help-old-size = hh:width .
     3413                                   hh:width-chars = 2.5 .
     3414                               end.
     3415                           when "b-print" then
     3416                               do:
     3417                                   hh:load-image("cmp/b-print.bmp":u) .
     3418                                   hh:TOOLTIP = "Печать" .
     3419                                   v-h[ii] = hh:handle .
     3420                                   ii = ii + 1 .
     3421                                   hh:width-chars = 3 .
     3422                               end.
     3423                           when "b-history" or
     3424                           when "b-hist" then
     3425                               do:
     3426                                   hh:load-image("cmp/b-hist.bmp":u) .
     3427                                   hh:TOOLTIP = "История" .
     3428                                   v-h[ii] = hh:handle .
     3429                                   ii = ii + 1 .
     3430                                   hh:width-chars = 3 .
     3431                               end.
     3432                           when "b-sch" then
     3433                               do:
     3434                                   hh:load-image("cmp/b-sch.bmp":u) .
     3435                                   hh:TOOLTIP = "Установка Фильтра" .
     3436                                   v-h[ii] = hh:handle .
     3437                                   ii = ii + 1 .
     3438                                   hh:width-chars = 3 .
     3439                               end.
     3440                           when "b-hist-user" then
     3441                               do:
     3442                                   hh:load-image("cmp/b-hist.bmp":u) .
     3443                                   hh:TOOLTIP = "История пользователя" .
     3444                                   ii = ii + 1 .
     3445                               end.
     3446                       end case.
     3447                   end.
     3448                   hh = hh:next-sibling.
     3449               end.
     3450               b-help:column = v-frame-width - b-help:width-chars.
     3451               jj = 0.
     3452               repeat ii = 4 to 1 by -1 :
     3453                   if valid-handle (v-h[ii] ) then
     3454                   do:
     3455                       jj  = jj + 1 .
     3456                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3457                       v-h[ii]:row    = v-help-old-y .
     3458                   end.
     3459               end.
     3460           end.
     3461       end.
     3462   end procedure.
     3463   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3464   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3465   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3466   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3467   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3468   define variable v-diasize-current-frame-height as decimal   no-undo .
     3469   define variable v-diasize-change-size          as logical   no-undo .
     3470   define variable v-diasize-resize-button        as handle    no-undo .
     3471   define variable v-diasize-wndmax               as logical   no-undo .
     3472   define variable v-diasize-wndstore             as logical   no-undo .
     3473   define variable v-diasize-proc-name            as character no-undo .
     3474   define variable v-diasize-browse-handle        as handle    no-undo .
     3475   define variable v-diasize-browse-number        as integer   no-undo .
     3476   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3477   define temp-table temp-diasize-handle no-undo
     3478     field handle-value  as handle
     3479     field save-position as decimal
     3480     index xpk is primary unique handle-value
     3481     .
     3482   define temp-table temp-browse-handle no-undo
     3483     field browse-type   as character
     3484     field browse-number as integer
     3485     field browse-handle as handle
     3486     field original-size as decimal
     3487     index xpk is primary unique browse-type browse-number
     3488     index xie browse-type browse-handle
     3489   .
     3490   procedure diasize_change-height :
     3491     define input  parameter p-change-value  as decimal   no-undo .
     3492     define input  parameter p-move-resize   as logical   no-undo .
     3493     define variable v-field-group-handle    as handle    no-undo .
     3494     define variable v-object-handle         as handle    no-undo .
     3495     define variable v-frame-height          as decimal   no-undo .
     3496     define variable v-frame-virtual-height  as decimal   no-undo .
     3497     define variable v-browse-height         as decimal   no-undo .
     3498     define variable v-window-height         as decimal   no-undo .
     3499     define variable v-window-virtual-height as decimal   no-undo .
     3500     define variable v-change-sign           as integer   no-undo .
     3501     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3502     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3503     if p-change-value > 0
     3504     then do:
     3505       if frame Dialog-Frame :height + p-change-value
     3506           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3507       then do:
     3508         assign
     3509           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3510                           - (frame Dialog-Frame :height-chars)
     3511         .
     3512         if p-change-value <= 0
     3513         then do:
     3514           run diasize_position-resize-button in this-procedure .
     3515           return .
     3516         end.
     3517       end.
     3518     end.
     3519     if p-change-value < 0
     3520     then do:
     3521       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3522       then do:
     3523         assign
     3524           p-change-value = v-diasize-orig-frame-height
     3525                          - (frame Dialog-Frame :height-chars)
     3526         .
     3527         if p-change-value >= 0
     3528         then do:
     3529           run diasize_position-resize-button in this-procedure .
     3530           return .
     3531         end.
     3532       end.
     3533     end.
     3534     if p-change-value >= 0
     3535     then do:
     3536       assign
     3537         v-change-sign = 1
     3538       .
     3539     end.
     3540     else do:
     3541       assign
     3542         v-change-sign = -1
     3543       .
     3544     end.
     3545     assign
     3546       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3547     .
     3548     if p-change-value = 0
     3549     then do:
     3550       run diasize_position-resize-button in this-procedure .
     3551       return .
     3552     end.
     3553     move_block:
     3554     do
     3555     on error undo move_block, retry move_block
     3556     :
     3557       if retry
     3558       then do:
     3559         do
     3560         on error undo move_block, leave move_block
     3561         :
     3562           if p-change-value > 0
     3563           then do:
     3564             for each buf_temp-diasize-handle
     3565             on error undo, next
     3566             :
     3567               assign
     3568                 v-object-handle = buf_temp-diasize-handle.handle-value
     3569               .
     3570               if v-object-handle <> v-diasize-resize-button
     3571               then do:
     3572                 assign
     3573                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3574                 .
     3575               end.
     3576             end.
     3577             assign
     3578               v-diasize-browse-handle :height = v-browse-height
     3579             .
     3580             for each buf_temp-browse-handle
     3581               where buf_temp-browse-handle.browse-type = 'height':u
     3582             on error undo, next
     3583             :
     3584               assign
     3585                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3586               .
     3587             end.
     3588             assign
     3589               frame Dialog-Frame :height = v-frame-height
     3590             .
     3591             if frame Dialog-Frame :scrollable = true
     3592             then do:
     3593               assign
     3594                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3595               .
     3596             end.
     3597             run diasize_position-resize-button in this-procedure .
     3598           end.
     3599           else do:
     3600             if frame Dialog-Frame :scrollable = true
     3601             then do:
     3602               assign
     3603                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3604               .
     3605             end.
     3606             assign
     3607               frame Dialog-Frame :height = v-frame-height
     3608             .
     3609             assign
     3610               v-diasize-browse-handle :height = v-browse-height
     3611             .
     3612             for each buf_temp-browse-handle
     3613               where buf_temp-browse-handle.browse-type = 'height':u
     3614             on error undo, next
     3615             :
     3616               assign
     3617                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3618               .
     3619             end.
     3620             for each buf_temp-diasize-handle
     3621             on error undo, next
     3622             :
     3623               assign
     3624                 v-object-handle = buf_temp-diasize-handle.handle-value
     3625               .
     3626               if v-object-handle <> v-diasize-resize-button
     3627               then do:
     3628                 assign
     3629                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3630                 .
     3631               end.
     3632             end.
     3633             run diasize_position-resize-button in this-procedure .
     3634           end.
     3635           assign
     3636             v-diasize-change-size = false
     3637           .
     3638           leave move_block .
     3639         end.
     3640       end.
     3641       assign
     3642         v-diasize-need-full-display = true
     3643       .
     3644       if v-diasize-change-size = false
     3645       then do:
     3646         assign
     3647           v-diasize-change-size = true
     3648         .
     3649       end.
     3650       else do:
     3651         return .
     3652       end.
     3653       assign
     3654         v-frame-height = frame Dialog-Frame :height
     3655         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3656         v-browse-height = v-diasize-browse-handle :height
     3657       .
     3658       for each buf_temp-browse-handle
     3659         where buf_temp-browse-handle.browse-type = 'height':u
     3660       :
     3661         assign
     3662           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3663         .
     3664       end.
     3665       for each buf_temp-diasize-handle
     3666       :
     3667         delete buf_temp-diasize-handle .
     3668       end.
     3669       assign
     3670         v-field-group-handle = frame Dialog-Frame :first-child
     3671       .
     3672       do while valid-handle(v-field-group-handle)
     3673       :
     3674         assign
     3675           v-object-handle = v-field-group-handle :first-child
     3676         .
     3677         do while valid-handle(v-object-handle)
     3678         :
     3679           if  v-object-handle <> v-diasize-browse-handle :handle
     3680           and can-query(v-object-handle, "row")
     3681           and can-query(v-object-handle, "height")
     3682           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3683           then do:
     3684             find first buf_temp-browse-handle
     3685               where buf_temp-browse-handle.browse-type   = 'height':u
     3686                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3687               no-error .
     3688             if available buf_temp-browse-handle
     3689             then do:
     3690             end.
     3691             else do:
     3692               create buf_temp-diasize-handle .
     3693               assign
     3694                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3695                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3696               .
     3697             end.
     3698           end.
     3699           assign
     3700             v-object-handle = v-object-handle :next-sibling
     3701           .
     3702         end.
     3703         assign
     3704           v-field-group-handle = v-field-group-handle :next-sibling
     3705         .
     3706       end.
     3707       do with frame Dialog-Frame
     3708       :
     3709         hide v-diasize-resize-button .
     3710         assign
     3711           v-diasize-resize-button :row    = 1
     3712           v-diasize-resize-button :column = 1
     3713         .
     3714       end.
     3715       if p-change-value > 0
     3716       then do:
     3717         if frame Dialog-Frame :scrollable = true
     3718         then do:
     3719           assign
     3720             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3721             no-error .
     3722           if error-status :error
     3723           or error-status :get-message(1) <> ""
     3724           then do:
     3725             undo move_block, retry move_block .
     3726           end.
     3727         end.
     3728         assign
     3729           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3730           no-error .
     3731         if error-status :error
     3732         or error-status :get-message(1) <> ""
     3733         then do:
     3734           undo move_block, retry move_block .
     3735         end.
     3736         assign
     3737           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3738           no-error .
     3739         if error-status :error
     3740         or error-status :get-message(1) <> ""
     3741         then do:
     3742           undo move_block, retry move_block .
     3743         end.
     3744         for each buf_temp-browse-handle
     3745           where buf_temp-browse-handle.browse-type = 'height':u
     3746         on error undo move_block, retry move_block
     3747         :
     3748           assign
     3749             buf_temp-browse-handle.browse-handle :height
     3750               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3751             no-error .
     3752           if error-status :error
     3753           or error-status :get-message(1) <> ""
     3754           then do:
     3755             undo move_block, retry move_block .
     3756           end.
     3757         end.
     3758         for each buf_temp-diasize-handle
     3759         on error undo move_block, retry move_block
     3760         :
     3761           assign
     3762             v-object-handle = buf_temp-diasize-handle.handle-value
     3763           .
     3764           if v-object-handle <> v-diasize-resize-button
     3765           then do:
     3766             assign
     3767               v-object-handle :row = v-object-handle :row + p-change-value
     3768               no-error .
     3769             if error-status :error
     3770             or error-status :get-message(1) <> ""
     3771             then do:
     3772               undo move_block, retry move_block .
     3773             end.
     3774           end.
     3775         end.
     3776       end.
     3777       else do:
     3778         for each buf_temp-diasize-handle
     3779         on error undo move_block, retry move_block
     3780         :
     3781           assign
     3782             v-object-handle = buf_temp-diasize-handle.handle-value
     3783           .
     3784           if v-object-handle <> v-diasize-resize-button
     3785           then do:
     3786             assign
     3787               v-object-handle :row = v-object-handle :row + p-change-value
     3788               no-error .
     3789             if error-status :error
     3790             or error-status :get-message(1) <> ""
     3791             then do:
     3792               undo move_block, retry move_block .
     3793             end.
     3794           end.
     3795         end.
     3796         assign
     3797           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3798           no-error .
     3799         if error-status :error
     3800         or error-status :get-message(1) <> ""
     3801         then do:
     3802           undo move_block, retry move_block .
     3803         end.
     3804         for each buf_temp-browse-handle
     3805           where buf_temp-browse-handle.browse-type = 'height':u
     3806         on error undo move_block, retry move_block
     3807         :
     3808           assign
     3809             buf_temp-browse-handle.browse-handle :height
     3810               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3811             no-error .
     3812           if error-status :error
     3813           or error-status :get-message(1) <> ""
     3814           then do:
     3815             undo move_block, retry move_block .
     3816           end.
     3817         end.
     3818         assign
     3819           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3820           no-error .
     3821         if error-status :error
     3822         or error-status :get-message(1) <> ""
     3823         then do:
     3824           undo move_block, retry move_block .
     3825         end.
     3826         if frame Dialog-Frame :scrollable = true
     3827         then do:
     3828           assign
     3829             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3830             no-error .
     3831           if error-status :error
     3832           or error-status :get-message(1) <> ""
     3833           then do:
     3834             undo move_block, retry move_block .
     3835           end.
     3836         end.
     3837       end.
     3838       if p-move-resize = true
     3839       then do:
     3840         run diasize_position-resize-button in this-procedure .
     3841       end.
     3842       if v-diasize-wndstore = true
     3843       then do:
     3844         if connected("ub") = true
     3845         then do:
     3846           define variable v-cntxt-db-num        as integer   no-undo .
     3847           define variable v-cntxt-userid        as character no-undo .
     3848           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3849                                             , OUTPUT v-cntxt-userid
     3850                                             ) .
     3851           run gbl/wndsizew.p
     3852             (input  v-cntxt-db-num
     3853             ,input  v-cntxt-userid
     3854             ,input  v-diasize-proc-name
     3855             ,input  'height':u
     3856             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3857             ) .
     3858         end.
     3859       end.
     3860     end.
     3861     assign
     3862       v-diasize-change-size = false
     3863     .
     3864   end procedure.
     3865   procedure diasize_set-height :
     3866     define input  parameter p-new-height  as decimal   no-undo .
     3867     define input  parameter p-move-resize as logical   no-undo .
     3868     do
     3869     on error undo, return error return-value
     3870     :
     3871       run diasize_change-height in this-procedure
     3872         (input  (p-new-height - frame Dialog-Frame :height)
     3873         ,input  p-move-resize
     3874         ) .
     3875     end.
     3876   end procedure.
     3877   procedure diasize_change-width :
     3878     define input  parameter p-change-value as decimal   no-undo .
     3879     define input  parameter p-move-resize  as logical   no-undo .
     3880     define variable v-field-group-handle   as handle    no-undo .
     3881     define variable v-object-handle        as handle    no-undo .
     3882     define variable v-frame-width          as decimal   no-undo .
     3883     define variable v-frame-virtual-width  as decimal   no-undo .
     3884     define variable v-browse-width         as decimal   no-undo .
     3885     define variable v-window-width         as decimal   no-undo .
     3886     define variable v-window-virtual-width as decimal   no-undo .
     3887     define variable v-change-sign          as integer   no-undo .
     3888     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3889     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3890     if p-change-value > 0
     3891     then do:
     3892       if frame Dialog-Frame :width + p-change-value >
     3893           session :width-chars
     3894       then do:
     3895         assign
     3896           p-change-value = session :width-chars - frame Dialog-Frame :width
     3897         .
     3898         if p-change-value <= 0
     3899         then do:
     3900           run diasize_position-resize-button in this-procedure .
     3901           return .
     3902         end.
     3903       end.
     3904     end.
     3905     if p-change-value < 0
     3906     then do:
     3907       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3908       then do:
     3909         assign
     3910           p-change-value = v-diasize-orig-frame-width
     3911                          - frame Dialog-Frame :width
     3912         .
     3913         if p-change-value >= 0
     3914         then do:
     3915           run diasize_position-resize-button in this-procedure .
     3916           return .
     3917         end.
     3918       end.
     3919     end.
     3920     if p-change-value >= 0
     3921     then do:
     3922       assign
     3923         v-change-sign = 1
     3924       .
     3925     end.
     3926     else do:
     3927       assign
     3928         v-change-sign = -1
     3929       .
     3930     end.
     3931     assign
     3932       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3933     .
     3934     if p-change-value = 0
     3935     then do:
     3936       run diasize_position-resize-button in this-procedure .
     3937       return .
     3938     end.
     3939     move_block:
     3940     do
     3941     on error undo move_block, leave move_block
     3942     :
     3943       if retry
     3944       then do:
     3945         do
     3946         on error undo move_block, leave move_block
     3947         :
     3948           if p-change-value > 0
     3949           then do:
     3950             for each buf_temp-diasize-handle
     3951             on error undo, next
     3952             :
     3953               assign
     3954                 v-object-handle = buf_temp-diasize-handle.handle-value
     3955               .
     3956               if v-object-handle <> v-diasize-resize-button
     3957               then do:
     3958                 assign
     3959                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3960                 .
     3961               end.
     3962             end.
     3963             assign
     3964               v-diasize-browse-handle :width = v-browse-width
     3965             .
     3966             for each buf_temp-browse-handle
     3967               where buf_temp-browse-handle.browse-type = 'width':u
     3968             on error undo, next
     3969             :
     3970               assign
     3971                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3972               .
     3973             end.
     3974             assign
     3975               frame Dialog-Frame :width = v-frame-width
     3976             .
     3977             if frame Dialog-Frame :scrollable = true
     3978             then do:
     3979               assign
     3980                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3981               .
     3982             end.
     3983             run diasize_position-resize-button in this-procedure .
     3984           end.
     3985           else do:
     3986             if frame Dialog-Frame :scrollable = true
     3987             then do:
     3988               assign
     3989                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3990               .
     3991             end.
     3992             assign
     3993               frame Dialog-Frame :width = v-frame-width
     3994             .
     3995             for each buf_temp-browse-handle
     3996               where buf_temp-browse-handle.browse-type = 'width':u
     3997             on error undo, next
     3998             :
     3999               assign
     4000                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4001               .
     4002             end.
     4003             assign
     4004               v-diasize-browse-handle :width = v-browse-width
     4005             .
     4006             for each buf_temp-diasize-handle
     4007             on error undo, next
     4008             :
     4009               assign
     4010                 v-object-handle = buf_temp-diasize-handle.handle-value
     4011               .
     4012               if v-object-handle <> v-diasize-resize-button
     4013               then do:
     4014                 assign
     4015                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4016                 .
     4017               end.
     4018             end.
     4019             run diasize_position-resize-button in this-procedure .
     4020           end.
     4021           assign
     4022             v-diasize-change-size = false
     4023           .
     4024           leave move_block .
     4025         end.
     4026       end.
     4027       assign
     4028         v-diasize-need-full-display = true
     4029       .
     4030       if v-diasize-change-size = false
     4031       then do:
     4032         assign
     4033           v-diasize-change-size = true
     4034         .
     4035       end.
     4036       else do:
     4037         return .
     4038       end.
     4039       assign
     4040         v-frame-width = frame Dialog-Frame :width
     4041         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4042         v-browse-width = v-diasize-browse-handle :width
     4043       .
     4044       for each buf_temp-browse-handle
     4045         where buf_temp-browse-handle.browse-type = 'width':u
     4046       :
     4047         assign
     4048           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4049         .
     4050       end.
     4051       for each buf_temp-diasize-handle
     4052       :
     4053         delete buf_temp-diasize-handle .
     4054       end.
     4055       assign
     4056         v-field-group-handle = frame Dialog-Frame :first-child
     4057       .
     4058       do while valid-handle(v-field-group-handle)
     4059       :
     4060         assign
     4061           v-object-handle = v-field-group-handle :first-child
     4062         .
     4063         do while valid-handle(v-object-handle)
     4064         :
     4065           if  v-object-handle <> v-diasize-browse-handle :handle
     4066           and v-object-handle <> v-diasize-resize-button
     4067           and can-query(v-object-handle, "row")
     4068           and can-query(v-object-handle, "height")
     4069           and ( v-object-handle :col + v-object-handle :width
     4070                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4071               )
     4072           then do:
     4073             find first buf_temp-browse-handle
     4074               where buf_temp-browse-handle.browse-type   = 'width':u
     4075                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4076               no-error .
     4077             if available buf_temp-browse-handle
     4078             then do:
     4079             end.
     4080             else do:
     4081               create buf_temp-diasize-handle .
     4082               assign
     4083                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4084                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4085               .
     4086             end.
     4087           end.
     4088           assign
     4089             v-object-handle = v-object-handle :next-sibling
     4090           .
     4091         end.
     4092         assign
     4093           v-field-group-handle = v-field-group-handle :next-sibling
     4094         .
     4095       end.
     4096       do with frame Dialog-Frame
     4097       :
     4098         hide v-diasize-resize-button .
     4099         v-diasize-resize-button :row = 1.
     4100         v-diasize-resize-button :column = 1.
     4101       end.
     4102       if p-change-value > 0
     4103       then do:
     4104         if frame Dialog-Frame :scrollable = true
     4105         then do:
     4106           assign
     4107             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4108             no-error .
     4109           if error-status :error
     4110           or error-status :get-message(1) <> ""
     4111           then do:
     4112             undo move_block, retry move_block.
     4113           end.
     4114         end.
     4115         assign
     4116           frame Dialog-Frame :width = v-frame-width + p-change-value
     4117           no-error .
     4118         if error-status :error
     4119         or error-status :get-message(1) <> ""
     4120         then do:
     4121           undo move_block, retry move_block.
     4122         end.
     4123         assign
     4124           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4125         no-error .
     4126         if error-status :error
     4127         or error-status :get-message(1) <> ""
     4128         then do:
     4129           undo move_block, retry move_block.
     4130         end.
     4131         for each buf_temp-browse-handle
     4132           where buf_temp-browse-handle.browse-type = 'width':u
     4133         on error undo move_block, retry move_block
     4134         :
     4135           assign
     4136             buf_temp-browse-handle.browse-handle :width
     4137               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4138             no-error .
     4139           if error-status :error
     4140           or error-status :get-message(1) <> ""
     4141           then do:
     4142             undo move_block, retry move_block .
     4143           end.
     4144         end.
     4145         for each buf_temp-diasize-handle
     4146         on error undo move_block, retry move_block
     4147         :
     4148           assign
     4149             v-object-handle = buf_temp-diasize-handle.handle-value
     4150           .
     4151           if v-object-handle <> v-diasize-resize-button
     4152           then do:
     4153             assign
     4154               v-object-handle :col = v-object-handle :col + p-change-value
     4155               no-error .
     4156             if error-status :error
     4157             or error-status :get-message(1) <> ""
     4158             then do:
     4159               undo move_block, retry move_block .
     4160             end.
     4161           end.
     4162         end.
     4163       end.
     4164       else do:
     4165         for each buf_temp-diasize-handle
     4166         on error undo move_block, retry move_block
     4167         :
     4168           assign
     4169             v-object-handle = buf_temp-diasize-handle.handle-value
     4170           .
     4171           if v-object-handle <> v-diasize-resize-button
     4172           then do:
     4173             assign
     4174               v-object-handle :col = v-object-handle :col + p-change-value
     4175               no-error .
     4176             if error-status :error
     4177             or error-status :get-message(1) <> ""
     4178             then do:
     4179               undo move_block, retry move_block .
     4180             end.
     4181           end.
     4182         end.
     4183         for each buf_temp-browse-handle
     4184           where buf_temp-browse-handle.browse-type = 'width':u
     4185         on error undo move_block, retry move_block
     4186         :
     4187           assign
     4188             buf_temp-browse-handle.browse-handle :width
     4189               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4190             no-error .
     4191           if error-status :error
     4192           or error-status :get-message(1) <> ""
     4193           then do:
     4194             undo move_block, retry move_block .
     4195           end.
     4196         end.
     4197         assign
     4198           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4199           no-error .
     4200         if error-status :error
     4201         or error-status :get-message(1) <> ""
     4202         then do:
     4203           undo move_block, retry move_block.
     4204         end.
     4205         assign
     4206           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4207         no-error .
     4208         if error-status :error
     4209         or error-status :get-message(1) <> ""
     4210         then do:
     4211           undo move_block, retry move_block.
     4212         end.
     4213         if frame Dialog-Frame :scrollable = true
     4214         then do:
     4215           assign
     4216             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4217           no-error .
     4218           if error-status :error
     4219           or error-status :get-message(1) <> ""
     4220           then do:
     4221             undo move_block, retry move_block.
     4222           end.
     4223         end.
     4224       end.
     4225       if p-move-resize
     4226       then do:
     4227         run diasize_position-resize-button in this-procedure .
     4228       end.
     4229       if v-diasize-wndstore = true
     4230       then do:
     4231         if connected("ub") = true
     4232         then do:
     4233           define variable v-cntxt-db-num        as integer   no-undo .
     4234           define variable v-cntxt-userid        as character no-undo .
     4235           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4236                                             , OUTPUT v-cntxt-userid
     4237                                             ) .
     4238           run gbl/wndsizew.p
     4239             (input  v-cntxt-db-num
     4240             ,input  v-cntxt-userid
     4241             ,input  v-diasize-proc-name
     4242             ,input  'width':u
     4243             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4244             ) .
     4245         end.
     4246       end.
     4247     end.
     4248     assign
     4249       v-diasize-change-size = false
     4250     .
     4251   end procedure.
     4252   procedure diasize_set-width :
     4253     define input  parameter p-new-width  as decimal   no-undo .
     4254     define input  parameter p-move-resize as logical   no-undo .
     4255     do
     4256     on error undo, return error return-value
     4257     :
     4258       run diasize_change-width in this-procedure
     4259         (input  (p-new-width - frame Dialog-Frame :width)
     4260         ,input  p-move-resize
     4261         ) .
     4262     end.
     4263   end procedure.
     4264   procedure diasize_position-resize-button :
     4265     do with frame Dialog-Frame
     4266     :
     4267       hide v-diasize-resize-button .
     4268       assign
     4269         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4270                     - 1
     4271                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4272         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4273                     - 1
     4274                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4275       .
     4276       view v-diasize-resize-button .
     4277     end.
     4278   end procedure.
     4279   on alt-right anywhere
     4280   do:
     4281     run diasize_change-width in this-procedure
     4282       (input 1
     4283       ,input true
     4284       ) .
     4285     return no-apply .
     4286   end.
     4287   on alt-left anywhere
     4288   do:
     4289     run diasize_change-width in this-procedure
     4290       (input -1
     4291       ,input true
     4292       ) .
     4293     return no-apply .
     4294   end.
     4295   on alt-down anywhere
     4296   do:
     4297     run diasize_change-height in this-procedure
     4298       (input 1
     4299       ,input true
     4300       ) .
     4301     return no-apply .
     4302   end.
     4303   on alt-up anywhere
     4304   do:
     4305     run diasize_change-height in this-procedure
     4306       (input -1
     4307       ,input true
     4308       ) .
     4309     return no-apply .
     4310   end.
     4311   on alt-enter of frame Dialog-Frame
     4312   do:
     4313     run diasize_maximize in this-procedure
     4314       (input  ?
     4315       ).
     4316     return no-apply .
     4317   end.
     4318   procedure diasize_end-move :
     4319     do
     4320     on error undo, return error return-value
     4321     :
     4322       define variable v-row-delta as decimal   no-undo .
     4323       define variable v-col-delta as decimal   no-undo .
     4324       define variable v-new-row as decimal   no-undo .
     4325       define variable v-new-col as decimal   no-undo .
     4326       assign
     4327         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4328         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4329       .
     4330       assign
     4331         v-row-delta = v-new-row - frame Dialog-Frame :height
     4332         v-col-delta = v-new-col - frame Dialog-Frame :width
     4333       .
     4334       run diasize_change-height in this-procedure
     4335         (input v-row-delta
     4336         ,input true
     4337         ) .
     4338       run diasize_change-width in this-procedure
     4339         (input v-col-delta
     4340         ,input true
     4341         ) .
     4342     end.
     4343   end procedure.
     4344   procedure diasize_maximize :
     4345     define input  parameter p-action as logical   no-undo .
     4346     do
     4347     on error undo, return error return-value
     4348     :
     4349       if p-action = ?
     4350       then do:
     4351         if v-diasize-need-maximize = true
     4352         then do:
     4353           assign
     4354             p-action = true
     4355           .
     4356         end.
     4357         else do:
     4358           assign
     4359             p-action = false
     4360           .
     4361         end.
     4362       end.
     4363       if p-action = true
     4364       then do:
     4365         run diasize_change-height in this-procedure
     4366           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4367               - frame Dialog-Frame :height-chars
     4368           ,input true
     4369           ) .
     4370         run diasize_change-width in this-procedure
     4371           (input session :width-chars
     4372               - frame Dialog-Frame :width-chars
     4373           ,input true
     4374           ) .
     4375         assign
     4376           v-diasize-need-maximize = false
     4377         .
     4378       end.
     4379       else do:
     4380         run diasize_change-width in this-procedure
     4381           (input v-diasize-orig-frame-width
     4382               - frame Dialog-Frame :width-chars
     4383           ,input true
     4384           ) .
     4385         run diasize_change-height in this-procedure
     4386           (input v-diasize-orig-frame-height
     4387               - frame Dialog-Frame :height-chars
     4388           ,input true
     4389           ) .
     4390         assign
     4391           v-diasize-need-maximize = true
     4392         .
     4393       end.
     4394     end.
     4395   end procedure.
     4396   procedure diasize_restore-orig-size :
     4397     do
     4398     on error undo, return error return-value
     4399     :
     4400       assign
     4401         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4402         v-diasize-current-frame-height = frame Dialog-Frame :height
     4403       .
     4404       run diasize_set-height in this-procedure
     4405         (input  v-diasize-orig-frame-height
     4406         ,input  true
     4407         ) .
     4408       run diasize_set-width in this-procedure
     4409         (input  v-diasize-orig-frame-width
     4410         ,input  true
     4411         ) .
     4412     end.
     4413   end procedure.
     4414   procedure diasize_restore-current-size :
     4415     do
     4416     on error undo, return error return-value
     4417     :
     4418       run diasize_set-height in this-procedure
     4419         (input  v-diasize-current-frame-height
     4420         ,input  true
     4421         ) .
     4422       run diasize_set-width in this-procedure
     4423         (input  v-diasize-current-frame-width
     4424         ,input  true
     4425         ) .
     4426     end.
     4427   end procedure.
     4428   procedure diasize_set-browse-handle :
     4429     define input  parameter p-browse-handle as handle   no-undo .
     4430     define buffer buf_temp-browse-handle for temp-browse-handle .
     4431     do
     4432     on error undo, return error return-value
     4433     :
     4434       assign
     4435         v-diasize-browse-handle = p-browse-handle
     4436       .
     4437       for each buf_temp-browse-handle
     4438       on error undo, return error return-value
     4439       :
     4440         delete buf_temp-browse-handle .
     4441       end.
     4442     end.
     4443   end procedure.
     4444   procedure diasize_add_browse :
     4445     define input  parameter p-browse-type   as character no-undo .
     4446     define input  parameter p-browse-handle as handle    no-undo .
     4447     define buffer buf_temp-browse-handle for temp-browse-handle .
     4448     do
     4449     on error undo, return error return-value
     4450     :
     4451       assign
     4452         v-diasize-browse-number = v-diasize-browse-number + 1
     4453       .
     4454       create buf_temp-browse-handle .
     4455       assign
     4456         buf_temp-browse-handle.browse-type   = p-browse-type
     4457         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4458         buf_temp-browse-handle.browse-handle = p-browse-handle
     4459       .
     4460     end.
     4461   end procedure.
     4462   procedure diasize_init :
     4463     define variable v-default-value    as logical   no-undo .
     4464     define variable v-restore-saved    as logical   no-undo .
     4465     define variable v-resize-value-str as character no-undo .
     4466     do
     4467     on error undo, return error return-value
     4468     :
     4469       do with frame Dialog-Frame
     4470       :
     4471         assign
     4472           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4473           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4474           v-diasize-browse-handle     = browse br-list :handle
     4475         .
     4476         create button v-diasize-resize-button
     4477         assign
     4478           parent        = frame Dialog-Frame :first-child
     4479           label         = "s"
     4480           height-pixels = 16
     4481           width-pixels  = 16
     4482           visible       = true
     4483           sensitive     = true
     4484           movable       = true
     4485           triggers:
     4486             on end-move persistent run diasize_end-move in this-procedure .
     4487           end triggers.
     4488         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4489         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4490         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4491         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4492         assign
     4493           v-diasize-wndmax = false
     4494         .
     4495         if connected("ub") = true
     4496         then do:
     4497           define variable v-cntxt-db-num        as integer   no-undo .
     4498           define variable v-cntxt-userid        as character no-undo .
     4499           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4500                                             , OUTPUT v-cntxt-userid
     4501                                             ) .
     4502           run gbl/wndpar_r.p
     4503             (input  v-cntxt-db-num
     4504             ,input  v-cntxt-userid
     4505             ,input  'wndmax':U
     4506             ,output v-diasize-wndmax
     4507             ,output v-default-value
     4508             ) .
     4509         end.
     4510         assign
     4511           v-diasize-wndstore = false
     4512         .
     4513         if connected("ub") = true
     4514         then do:
     4515           run gbl/wndpar_r.p
     4516             (input  v-cntxt-db-num
     4517             ,input  v-cntxt-userid
     4518             ,input  'wndstore':U
     4519             ,output v-diasize-wndstore
     4520             ,output v-default-value
     4521             ) .
     4522         end.
     4523         assign
     4524           v-diasize-proc-name = entry(1, program-name(2), '.')
     4525         .
     4526         if v-diasize-wndstore = true
     4527         then do:
     4528           assign
     4529             v-restore-saved = false
     4530           .
     4531           if connected("ub") = true
     4532           then do:
     4533             run gbl/wndsizer.p
     4534               (input  v-cntxt-db-num
     4535               ,input  v-cntxt-userid
     4536               ,input  v-diasize-proc-name
     4537               ,input  'height':u
     4538               ,output v-resize-value-str
     4539               ) .
     4540             if v-resize-value-str <> '':U
     4541             then do:
     4542               run diasize_change-height in this-procedure
     4543                 (input  integer(v-resize-value-str)
     4544                 ,input  true
     4545                 ) .
     4546               assign
     4547                 v-restore-saved = true
     4548               .
     4549             end.
     4550           end.
     4551           if connected("ub") = true
     4552           then do:
     4553             run gbl/wndsizer.p
     4554               (input  v-cntxt-db-num
     4555               ,input  v-cntxt-userid
     4556               ,input  v-diasize-proc-name
     4557               ,input  'width':u
     4558               ,output v-resize-value-str
     4559               ) .
     4560             if v-resize-value-str <> '':U
     4561             then do:
     4562               run diasize_change-width in this-procedure
     4563                 (input  integer(v-resize-value-str)
     4564                 ,input  true
     4565                 ) .
     4566               assign
     4567                 v-restore-saved = true
     4568               .
     4569             end.
     4570           end.
     4571           if v-restore-saved <> true
     4572           then do:
     4573             if v-diasize-wndmax = true
     4574             then do:
     4575               run diasize_maximize in this-procedure
     4576                 (input  true
     4577                 ) .
     4578             end.
     4579           end.
     4580         end.
     4581         else do:
     4582           if v-diasize-wndmax = true
     4583           then do:
     4584             run diasize_maximize in this-procedure
     4585               (input  true
     4586               ) .
     4587           end.
     4588         end.
     4589       end.
     4590     end.
     4591   end procedure.
     4592   procedure diasize_need-full-display :
     4593     define output parameter p-need-full-display as logical   no-undo .
     4594     do
     4595     on error undo, return error return-value
     4596     :
     4597       assign
     4598         p-need-full-display = v-diasize-need-full-display
     4599       .
     4600       assign
     4601         v-diasize-need-full-display = false
     4602       .
     4603     end.
     4604   end procedure.
     4605   procedure get-context :
     4606      define output parameter p-db-num as integer          no-undo.
     4607      define output parameter p-user-id as character        no-undo.
     4608      define variable v-login               as character    no-undo.
     4609      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4610      define buffer buf_user-login  for ub.user-login .
     4611      do
     4612      on error undo, return error
     4613      :
     4614            FIND FIRST buf_sys-ctrl no-lock.
     4615            ASSIGN
     4616               v-login = USERID("ub")
     4617               p-db-num = buf_sys-ctrl.db-num
     4618            .
     4619            FIND FIRST buf_user-login
     4620                 WHERE buf_user-login.db-num = p-db-num
     4621                   AND buf_user-login.user-login = v-login
     4622                 no-lock
     4623                 no-error
     4624                 .
     4625            IF AVAILABLE buf_user-login
     4626            THEN DO:
     4627               assign
     4628                  p-user-id = buf_user-login.user-id
     4629               .
     4630            END.
     4631      end.
     4632   end procedure.
     4633   run diasize_add_browse in this-procedure
     4634     (input  'height':u
     4635     ,input  browse BR-option :handle
     4636     ) .
     4637   run diasize_init in this-procedure .
     4638   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4639   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     4640     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     4641     return no-apply.
     4642   end.
     4643   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4644   on F3 of frame Dialog-Frame anywhere do:
     4645     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     4646     return no-apply.
     4647   end.
     4648   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4649   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     4650     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     4651     return no-apply.
     4652   end.
     4653   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4654   on F8 of frame Dialog-Frame anywhere do:
     4655     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     4656     return no-apply.
     4657   end.
     4658   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4659   PROCEDURE ex-doc :
     4660   DEFINE INPUT PARAMETER loc-is-trn-doc as integer no-undo.
     4661   define input parameter rs-list-method as character no-undo .
     4662   define input parameter rs-status as character no-undo .
     4663   define input parameter line-mode as character no-undo .
     4664     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     4665       CASE loc-is-trn-doc:
     4666         when 1 then do:
     4667           if ub.trn-doc.host-code <> p-curr-host-code then return.
     4668           find first doc-list where
     4669                     doc-list.doc-code = ub.trn-doc.doc-code
     4670                and  doc-list.doc-type = ub.trn-doc.doc-type
     4671                     no-error.
     4672         end.
     4673         when 101 then do:
     4674           if ub.c-trn-doc.host-code <> p-curr-host-code then return.
     4675           find first doc-list where
