     9154     end.
     9155   END CASE.
     9156   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     9157   if session:set-wait-state( "" )  then .
     9158   case line-mode :
     9159     when 'ДОБАВЛЕНИЕ':U then do:
