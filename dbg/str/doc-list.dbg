     9066           and  buf_doc-list-hist.item_  <> '':U:
     9067         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_doc-list-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
