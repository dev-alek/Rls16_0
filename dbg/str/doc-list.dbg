     8615       end.
     8616       WHEN "FILTER-trn"
     8617       or
     8618       when "FILTER-price"
     8619       or
     8620       when "filter-inkas"
     8621       or
     8622       when "filter-fbr"
     8623       THEN DO:
     8624         CASE rs-list-method:
     8625           when "filter-trn" then run trig-filter-trn in this-procedure no-error.
     8626           when "filter-price" then run trig-filter-price in this-procedure no-error.
     8627           when "filter-inkas" then run trig-filter-inkas in this-procedure no-error.
     8628           when "filter-fbr" then run trig-filter-fbr in this-procedure no-error.
     8629         END CASE.
     8630         if error-status:error then do:
     8631           run MyEnable in this-procedure .
     8632           return error.
     8633         end.
     8634       END.
     8635     end case.
     8636     if tot-lns <> 0 then do:
     8637       run get-operation in this-procedure (input dsp-rs, output v-operation).
     8638       CASE v-operation:
     8639         when 1 then do:
     8640           run proc-b-add in this-procedure(input no
     8641                                           ,input ?
     8642                                           ,input rs-list-method
     8643                                           ,input v-table-name
     8644                                           ,input rs-status) no-error  .
     8645         end.
     8646         when 2 then do:
     8647           run proc-b-del in this-procedure(input no
     8648                                           ,input ?
     8649                                           ,input rs-list-method
     8650                                           ,input v-table-name
     8651                                           ,input rs-status ) no-error  .
     8652         end.
     8653         when 3 then do:
     8654           run proc-b-rest in this-procedure(input no
     8655                                            ,input ?
     8656                                            ,input rs-list-method
     8657                                            ,input v-table-name
     8658                                            ,input rs-status) no-error  .
     8659         end.
     8660         otherwise do:
     8661           assign
     8662           dsp-rs = "":U.
     8663           run MyEnable in this-procedure .
     8664           return error.
     8665         end.
     8666       END CASE.
     8667     end.
     8668     assign
     8669     rs-list-method =  temp-list.fvalue
     8670     .
     8671     find last buf_doc-list-hist no-lock where
     8672               buf_doc-list-hist.id = (v-seq - 1)
     8673         and  buf_doc-list-hist.line = 0 no-error .
     8674     DISPLAY
     8675     (if available buf_doc-list-hist
     8676     then buf_doc-list-hist.des
     8677     else '') @ dsp-rs
     8678     with frame Dialog-Frame.
     8679     if tot-lns = 0
     8680     then do:
     8681       run proc-b-add in this-procedure(input no
     8682                                       ,input ?
     8683                                       ,input rs-list-method
     8684                                       ,input v-table-name
     8685                                       ,input rs-status)  .
     8686     end.
     8687   end.
     8688   END PROCEDURE.
     8689   PROCEDURE rs-do :
     8690   define input parameter p-from-macro as logical no-undo .
     8691   define input parameter p-step as logical no-undo .
     8692   define input parameter rs-list-method as character no-undo .
     8693   define input parameter p-table-name as character no-undo .
     8694   define input parameter rs-status as character no-undo .
     8695   define input parameter line-mode as character no-undo .
     8696   define input parameter p-id      as integer no-undo .
     8697   define variable imp-ART like ub.goods.ARTIC no-undo.
     8698   define variable imp-type like ub.goods.prod-type no-undo.
     8699   define variable imp-code like ub.goods.prod-code no-undo.
     8700   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     8701   define variable imp-doc-type as character no-undo.
     8702   define variable grp-path like ub.goods.grp-name no-undo.
     8703   define variable v-report-num as integer no-undo .
     8704   define variable glog as logical no-undo .
     8705   define variable v-rowid   as rowid no-undo .
     8706   define variable v-tbl-name as character no-undo .
     8707   define variable v-obj-type as character  no-undo.
     8708   define variable v-obj-code as integer    no-undo.
     8709   DEFINE VARIABLE v-attr-code          as character           no-undo .
     8710   define variable v-gds-code like ub.goods.gds-code no-undo .
     8711   define variable v-full-path        as character no-undo .
     8712   define variable v-path             as character no-undo .
     8713   define variable v-file-name        as character no-undo .
     8714   define variable v-file-name-no-ext as character no-undo .
     8715   define variable v-file-name-ext    as character no-undo .
     8716   define variable v-date-from  as date no-undo .
     8717   define variable v-date-to  as date no-undo .
     8718   define buffer buf_doc-list-hist for doc-list-hist.
     8719   define buffer buf_user-obj for ub.user-obj.
     8720   do
     8721   on error undo, return error return-value
     8722   :
     8723   assign
     8724   lns-cnt = 0
     8725   lns-ignore = 0
     8726   v-num-add  = 0
     8727   v-num-ignored = 0
     8728   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     8729   .
     8730   run write-hist in this-procedure (input p-from-macro, input rs-list-method, input p-table-name, input RS-STATUS, input line-mode).
     8731   if session:set-wait-state( "COMPILER" )  then .
     8732   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     8733   case rs-list-method:
     8734     when "attr"
     8735     or
     8736     when "attr-val" then do:
     8737       find first buf_doc-list-hist where
     8738                buf_doc-list-hist.id = p-id
     8739            AND buf_doc-list-hist.item_ <> '':U no-error .
     8740       assign
     8741       v-attr-code = entry(1, buf_doc-list-hist.item_, chr(3))
     8742       vvalue = (if rs-list-method = "attr" then '':U else entry(2, buf_doc-list-hist.item_, chr(3)))
     8743       no-error
     8744       .
     8745       if error-status:error then do:
     8746       end.
     8747       else do:
     8748           for each ub.doc-attr No-LOCK WHERE
     8749                 ub.doc-attr.attr-code = v-attr-code,
     8750               first ub.trn-doc no-lock where
     8751                    ub.trn-doc.doc-code = ub.doc-attr.doc-code
     8752           :
     8753            if rs-list-method = "attr-val" then do:
     8754   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
     8755                           input v-attr-code ,
     8756                          output vvalue1 ,
     8757                          output vtype1 )  .
     8758              if vvalue1 <> vvalue then NEXT.
     8759            end.
     8760          run ex-doc in this-procedure(input 1, input rs-list-method, input rs-status, input line-mode).
     8761         end.
     8762         assign                                                           buf_doc-list-hist.num-add  = lns-cnt - v-num-add                       buf_doc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_doc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_doc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8763       end.
     8764     end.
     8765     WHEN "PRICE-DOC" THEN DO:
     8766       glog = no.
     8767       _jj:
     8768       for each buf_doc-list-hist where
     8769                buf_doc-list-hist.id = p-id
