     5103   procedure assign-nums :
     5104   define input-output parameter p-num-add as integer no-undo .
     5105   define input-output parameter p-num-rec as integer no-undo .
     5106   define input-output parameter p-num-ignored as integer no-undo .
     5107   define input parameter p-line-mode as character no-undo .
     5108   assign
     5109   p-num-add  = lns-cnt - v-num-add
     5110   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5111                             then (tot-lns + p-num-add)
     5112                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5113   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5114   p-num-ignored = lns-ignore  - v-num-ignored
     5115   v-num-add             = lns-cnt
     5116   v-num-ignored         = lns-ignore
     5117   .
     5118   END PROCEDURE.
     5119   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5120   or INSERT-MODE of br-list
     5121   DO:
     5122   define variable glog as logical no-undo .
     5123   define buffer buf-doc-list-hist for doc-list-hist.
     5124   define buffer buf_macro-list-hist for macro-list-hist.
     5125   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5126    if p-keep-query then do:
     5127       glog = no.
     5128       message "Реинициализация списка. Вы уверены ?"
     5129               view-as alert-box question buttons OK-Cancel update glog.
     5130       if not glog then return no-apply.
     5131       if session:set-wait-state( "COMPILER" )  then .
     5132       for each doc-list:
     5133         delete doc-list.
     5134       end.
     5135       if session:set-wait-state( "" )  then .
     5136       tot-lns = 0.
     5137       v-seq = 1.
     5138       for each buf-doc-list-hist:
     5139         delete buf-doc-list-hist.
     5140       end.
     5141      for each buf_keep-macro-list-hist:
     5142        create buf_macro-list-hist.
     5143      end.
     5144      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5145      run create-doc-list-hist in this-procedure (
     5146                                             input 'ДОБАВЛЕНИЕ':U
     5147                                           , input-output v-seq
     5148                                           , input 0
     5149                                           , input '':U
     5150                                           , input '0':U
     5151                                           , input "# Реинициализация списка."
     5152                                           , input 0
     5153                                           , input "init"
     5154                                           , input '':U
     5155                                           , input '':U
     5156                                           , input '':U
     5157                                           , input ?
     5158                                           ).
     5159       display
     5160       tot-lns @ f-tot-lns
     5161       with frame Dialog-Frame.
     5162       run MyEnable in this-procedure .
     5163    end.
     5164    else do:
     5165      assign rs-list-method = "single".
     5166      run proc-b-add in this-procedure(input no
     5167                                     ,input ?
     5168                                     ,input rs-list-method
     5169                                     ,input  ?
     5170                                     ,input rs-status)  no-error .
     5171     if error-status:error then return no-apply.
     5172   end.
     5173   END.
     5174   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     5175   or DELETE-CHARACTER of br-list
     5176   DO:
     5177     if not available doc-list then return no-apply.
     5178     assign rs-list-method = "single".
     5179       run proc-b-del in this-procedure(
     5180                                                  input no
     5181                                                 ,input ?
     5182                                                 ,input rs-list-method
     5183                                                 ,input ?
     5184                                                 ,input rs-status) no-error .
     5185     if error-status:error then return no-apply.
     5186   END.
     5187   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     5188   DO:
     5189   if not available doc-list then return no-apply.
     5190     assign rs-list-method = "single".
     5191    run proc-b-rest in this-procedure(
     5192                                                   input no
     5193                                                  ,input ?
     5194                                                  ,input rs-list-method
     5195                                                  ,input  ?
     5196                                                  ,input rs-status) no-error .
     5197     if error-status:error then return no-apply.
     5198   END.
     5199   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     5200   DO:
     5201   run proc-b-macro in this-procedure ( input 'file') no-error .
     5202   if error-status:error then return no-apply.
     5203   END.
     5204   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     5205   DO:
     5206   define variable glog as logical no-undo .
     5207   message
     5208   "Начать запись макроса формирования списка?"
     5209   view-as alert-box QUESTION buttons yes-no update glog.
     5210   if not glog then return no-apply.
     5211   assign
     5212   an-listp-start-macro-id = v-seq
     5213   an-listp-end-macro-id = ?
     5214   .
     5215   disable
     5216   b-record with frame Dialog-Frame .
     5217   hide
     5218   b-record
     5219   b-macro
     5220   in frame Dialog-Frame .
     5221   enable
     5222   b-stop with frame Dialog-Frame .
     5223   run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5224                                       , input-output v-seq
     5225                                       , input 0
     5226                                       , input '':U
     5227                                       , input 'o':U
     5228                                       , input "Начата запись макроса формирования списка"
     5229                                       , input tot-lns
     5230                                       , input 'macro':U
     5231                                       , input '':U
     5232                                       , input '':U
     5233                                       , input '':U
     5234                                       , input ?
     5235                                       ).
     5236   END.
     5237   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     5238   DO:
     5239   define variable glog as logical no-undo .
     5240   define variable v-id as integer no-undo .
     5241   define buffer buf_doc-list-hist for doc-list-hist.
     5242   message
     5243   "Закончить запись макроса формирования списка?"
     5244   view-as alert-box QUESTION buttons yes-no update glog.
     5245   if not glog then return no-apply.
     5246   assign
     5247   an-listp-end-macro-id = v-seq.
     5248   disable
     5249   b-stop with frame Dialog-Frame .
     5250   hide
     5251   b-stop in frame Dialog-Frame .
     5252   enable
     5253   b-record
     5254   b-macro
     5255   with frame Dialog-Frame .
     5256   run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5257                                       , input-output v-seq
     5258                                       , input 0
     5259                                       , input '':U
     5260                                       , input '[]':U
     5261                                       , input "Закончена запись макроса формирования списка"
     5262                                       , input tot-lns
     5263                                       , input 'macro':U
     5264                                       , input '':U
     5265                                       , input '':U
     5266                                       , input '':U
     5267                                       , input ?
     5268                                       ).
     5269   for each macro-list-hist:
     5270     delete macro-list-hist.
     5271   end.
     5272   for each buf_doc-list-hist where
     5273           buf_doc-list-hist.id >=  an-listp-start-macro-id
     5274     and  buf_doc-list-hist.id <=  an-listp-end-macro-id:
     5275     create macro-list-hist.
     5276     buffer-copy buf_doc-list-hist
     5277     except id num-recs num-add num-ignored
     5278     to macro-list-hist
     5279     assign
     5280     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5281     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5282     .
     5283   end.
     5284   END.
     5285   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     5286   DO:
     5287   disable
     5288   b-clear-macro with frame Dialog-Frame .
     5289   assign
     5290   an-listp-start-macro-id = ?
     5291   an-listp-end-macro-id = ?
     5292   an-listp-macros-label-id = 0
     5293   .
     5294   for each macro-list-hist:
     5295     delete macro-list-hist.
     5296   end.
     5297   hide
     5298   b-clear-macro in frame Dialog-Frame .
     5299   enable
     5300   b-record
     5301   b-macro
     5302   with frame Dialog-Frame .
     5303   END.
     5304   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     5305   DO:
     5306     assign
     5307     Rs-list-method = temp-list.fvalue
     5308     .
     5309     run proc-vc-rs-list-method in this-procedure no-error .
     5310     if error-status:error then return no-apply.
     5311   END.
     5312   PROCEDURE get-operation :
     5313   define input parameter p-message as character no-undo .
     5314   define output parameter p-operation as integer no-undo .
     5315     do
     5316     on error undo, return error
     5317     :
     5318       run gbl/d-askw.w (
     5319                     input "Выбор операции над заданным списком"
     5320                    ,input (p-message + chr(10) +
     5321                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     5322                    ,input "|"
     5323                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     5324                            "Удалить" + "|" +
     5325                            "Оставить" + "|" +
     5326                            "Отказ")
     5327                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     5328                           "Удалить полученный список из уже имеющегося" + "|" +
     5329                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     5330                           "Ничего не делать")
     5331                    ,input  (if p-keep-query then 2 else 1)
     5332                    ,input  4
     5333                    ,output p-operation).
     5334      if p-operation = 4 then do:
     5335         return error .
     5336      end.
     5337     end.
     5338   END PROCEDURE.
     5339   PROCEDURE proc-fill-temp-list :
     5340     define variable v-index               as integer   no-undo .
     5341     define variable v-num-entries-options as integer   no-undo .
     5342     do
     5343     on error undo, return error
     5344     :
     5345       assign
     5346         v-num-entries-options = num-entries("Текущая строка,single,                       Накладная,trn-doc,                            Накладные с <=датой ФАКТ<=,trn-doc-fact-date,   Переоценка,price-doc,                         Переоценки с <=датой ФАКТ<=,price-doc-fact-date,       Продажи,inkas,                                Продажи c <=датой ФАКТ<=,inkas-fact-date,    Производство,fbr-doc,                         Заказ/заявка,ord-doc,                         Заказы/заявки с <=датой ФАКТ<=,ord-doc-fact-date,   УДАЛЕННАЯ накладная,c-trn-doc,                            УДАЛЕННЫЕ накладные с <=датой ФАКТ<=,c-trn-doc-fact-date,   УДАЛЕННЫЕ Продажи,c-inkas,                                УДАЛЕННЫЕ Продажи c <=датой ФАКТ<=,c-inkas-fact-date,    С установл.атрибутом,attr,                    С атрибутом= ,attr-val,                       Накладные  контр-та,cli-trn-doc,              Накладные гр-пы контр-тов,cli-grp-trn-doc,    Накладные сп-ка контр-тов,cli-list-trn-doc,   Накл. с тов. из списка,trn-gds-list,          Переоц. с тов. из списка,price-gds-list,      Файл,file,                                    Фильтр переоценок,filter-price,               Фильтр накладных,filter-trn,                  Фильтр производств,filter-fbr,                Фильтр продаж,filter-inkas")
     5347       .
     5348       do v-index = 1 to v-num-entries-options by 2
     5349       :
     5350         create temp-list.
     5351         assign
     5352           temp-list.fname  = trim(entry(v-index
     5353                                        ,"Текущая строка,single,                       Накладная,trn-doc,                            Накладные с <=датой ФАКТ<=,trn-doc-fact-date,   Переоценка,price-doc,                         Переоценки с <=датой ФАКТ<=,price-doc-fact-date,       Продажи,inkas,                                Продажи c <=датой ФАКТ<=,inkas-fact-date,    Производство,fbr-doc,                         Заказ/заявка,ord-doc,                         Заказы/заявки с <=датой ФАКТ<=,ord-doc-fact-date,   УДАЛЕННАЯ накладная,c-trn-doc,                            УДАЛЕННЫЕ накладные с <=датой ФАКТ<=,c-trn-doc-fact-date,   УДАЛЕННЫЕ Продажи,c-inkas,                                УДАЛЕННЫЕ Продажи c <=датой ФАКТ<=,c-inkas-fact-date,    С установл.атрибутом,attr,                    С атрибутом= ,attr-val,                       Накладные  контр-та,cli-trn-doc,              Накладные гр-пы контр-тов,cli-grp-trn-doc,    Накладные сп-ка контр-тов,cli-list-trn-doc,   Накл. с тов. из списка,trn-gds-list,          Переоц. с тов. из списка,price-gds-list,      Файл,file,                                    Фильтр переоценок,filter-price,               Фильтр накладных,filter-trn,                  Фильтр производств,filter-fbr,                Фильтр продаж,filter-inkas"
     5354                                        )
     5355                                  ,chr(32)
     5356                                  )
     5357           temp-list.fvalue = trim(entry(v-index + 1
     5358                                        ,"Текущая строка,single,                       Накладная,trn-doc,                            Накладные с <=датой ФАКТ<=,trn-doc-fact-date,   Переоценка,price-doc,                         Переоценки с <=датой ФАКТ<=,price-doc-fact-date,       Продажи,inkas,                                Продажи c <=датой ФАКТ<=,inkas-fact-date,    Производство,fbr-doc,                         Заказ/заявка,ord-doc,                         Заказы/заявки с <=датой ФАКТ<=,ord-doc-fact-date,   УДАЛЕННАЯ накладная,c-trn-doc,                            УДАЛЕННЫЕ накладные с <=датой ФАКТ<=,c-trn-doc-fact-date,   УДАЛЕННЫЕ Продажи,c-inkas,                                УДАЛЕННЫЕ Продажи c <=датой ФАКТ<=,c-inkas-fact-date,    С установл.атрибутом,attr,                    С атрибутом= ,attr-val,                       Накладные  контр-та,cli-trn-doc,              Накладные гр-пы контр-тов,cli-grp-trn-doc,    Накладные сп-ка контр-тов,cli-list-trn-doc,   Накл. с тов. из списка,trn-gds-list,          Переоц. с тов. из списка,price-gds-list,      Файл,file,                                    Фильтр переоценок,filter-price,               Фильтр накладных,filter-trn,                  Фильтр производств,filter-fbr,                Фильтр продаж,filter-inkas"
     5359                                        )
     5360                                  ,chr(32)
     5361                                  )
     5362           temp-list.id     = v-index
     5363         .
     5364       end.
     5365     end.
     5366   END PROCEDURE.
     5367   procedure proc-b-macro :
     5368   define input parameter p-option as character no-undo .
     5369   define variable glog as logical no-undo .
     5370   define variable v-id as integer no-undo .
     5371   define variable v-result as character no-undo .
     5372   define variable v-des as character no-undo .
     5373   define variable v-hist-mode as character no-undo .
     5374   define variable v-file as logical no-undo .
     5375   define variable v-full-path        as character no-undo .
     5376   define variable v-path             as character no-undo .
     5377   define variable v-file-name        as character no-undo .
     5378   define variable v-file-name-no-ext as character no-undo .
     5379   define variable v-file-name-ext    as character no-undo .
     5380   define variable v-rid-list as character no-undo .
     5381   define variable v-ok as logical no-undo .
     5382   define buffer buf_doc-list-hist for doc-list-hist.
     5383   define buffer buf_clob-bind for ub.clob-bind.
     5384   define buffer buf_clob-data for ub.clob-data.
     5385   do
     5386   on error undo, return error
     5387   :
     5388     if v-macro-is-running then do:
     5389     end.
     5390     else do:
     5391       glog = yes.
     5392       if an-listp-start-macro-id >= 1 then do:
     5393         case p-option:
     5394           when "file" then do:
     5395         message
     5396         "Согласно командам формирования списка из записанного макроса"
     5397         view-as alert-box question buttons OK-Cancel update glog.
     5398           end.
     5399           when "lob" then do:
     5400             message
     5401             "Нелья!"
     5402             view-as alert-box question buttons OK-Cancel update glog.
     5403             run MyEnable in this-procedure .
     5404             return error.
     5405           end.
     5406         end case.
     5407         if not glog then do:
     5408           run MyEnable in this-procedure .
     5409           return error.
     5410         end.
     5411         if an-listp-end-macro-id = ? then do:
     5412           assign
     5413           an-listp-end-macro-id  = v-seq.
     5414           for each macro-list-hist:
     5415             delete macro-list-hist.
     5416           end.
     5417           for each buf_doc-list-hist where
     5418                   buf_doc-list-hist.id >=  an-listp-start-macro-id
     5419             and  buf_doc-list-hist.id <=  an-listp-end-macro-id:
     5420             create macro-list-hist.
     5421             buffer-copy buf_doc-list-hist
     5422             except id num-recs num-add num-ignored
     5423             to macro-list-hist
     5424             assign
     5425             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5426             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5427             macro-list-hist.done = no
     5428             .
     5429           end.
     5430         end.
     5431         else do:
     5432           find last macro-list-hist no-error.
     5433           if available macro-list-hist then do:
     5434             v-id = macro-list-hist.id.
     5435           end.
     5436         end.
     5437       end.
     5438       else do:
     5439         case p-option:
     5440           when "file" then do:
     5441         message
     5442         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     5443         view-as alert-box question buttons OK-Cancel update glog.
     5444         if not glog then do:
     5445           run MyEnable in this-procedure .
     5446           return error.
     5447         end.
     5448         system-dialog get-file f-name
     5449           filters "Макрос формирования списка *.trm" "*.trm"
     5450           title "Выберите файл макроса"
     5451           INITIAL-DIR "."
     5452           return-to-start-dir
     5453           must-exist
     5454           update glog
     5455           default-extension "trm".
     5456         if not glog then do:
     5457           run MyEnable in this-procedure .
     5458           return error.
     5459         end.
     5460           end.
     5461           when "lob" then do:
     5462             message
     5463             "Согласно командам формирования списка из макроса, сохраненного в БД"
     5464             view-as alert-box question buttons OK-Cancel update glog.
     5465             if not glog then do:
     5466               run MyEnable in this-procedure .
     5467               return error.
     5468             end.
     5469             run ref/clobbnds.w ( input parparentproc
     5470                                 ,input this-procedure:handle
     5471                                 ,input 'b-sel'
     5472                                 ,input "uniq-key-rec"
     5473                                 ,input ""
     5474                                 ,input 'list-macro':U
     5475                                 ,input 'doc-list'
     5476                                 ,input -1
     5477                                 ,input-output v-rid-list) no-error.
     5478             if v-rid-list = '' then do:
     5479               run MyEnable in this-procedure.
     5480               return error.
     5481             end.
     5482             find first buf_clob-bind no-lock where
     5483                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     5484             if not available buf_clob-bind then do:
     5485               message
     5486               "Не найдена ссылка на макрос, сохраненный в БД!"
     5487               view-as alert-box error .
     5488               run MyEnable in this-procedure .
     5489               return error.
     5490             end.
     5491             find first buf_clob-data no-lock where
     5492                       buf_clob-data.db-num = buf_clob-bind.db-num
     5493                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     5494             if not available buf_clob-data then do:
     5495               message
     5496               "Не найдена ссылка на макрос, сохраненный в БД!"
     5497               view-as alert-box error .
     5498               run MyEnable in this-procedure .
     5499               return error.
     5500             end.
     5501             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     5502               message
     5503               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     5504                         , buf_clob-data.db-num
     5505                         , chr(10))
     5506              view-as alert-box question buttons yes-no update v-ok.
     5507              if not v-ok then do:
     5508                 run MyEnable in this-procedure .
     5509                 return error.
     5510              end.
     5511             end.
     5512             run gbl/_tmpfile.p ( input ""
     5513                           ,input "tmp"
     5514                           ,output v-file-name) .
     5515             copy-lob from object buf_clob-data.cdata
     5516             to file f-name.
     5517             run gbl/filename.p
     5518               (input  v-file-name
     5519               ,output f-name
     5520               ,output v-path
     5521               ,output v-file-name
     5522               ,output v-file-name-no-ext
     5523               ,output v-file-name-ext
     5524               ) no-error .
     5525             if error-status:error then do:
     5526             end.
     5527           end.
     5528         end case.
     5529         for each macro-list-hist:
     5530           delete macro-list-hist.
     5531         end.
     5532         input stream sout from value (f-name).
     5533         _macro:
     5534         repeat:
     5535           create macro-list-hist.
     5536           import stream sout macro-list-hist no-error.
     5537           if error-status:error then do:
     5538               undo _macro, next _macro.
     5539           end.
     5540           assign
     5541           macro-list-hist.num-rec = 0
     5542           macro-list-hist.num-add = 0
     5543           macro-list-hist.num-ignored = 0
     5544           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     5545           macro-list-hist.done = no
     5546           .
     5547         end.
     5548         find first macro-list-hist where
     5549                 macro-list-hist.id = 0.
     5550         delete macro-list-hist.
     5551         input stream sout close.
     5552         If p-option = "lob" then do:
     5553          os-delete value(f-name).
     5554         end.
     5555         v-file = yes.
     5556       end.
     5557       an-listp-macros-label-id = v-seq.
     5558       run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5559                                           , input-output v-seq
     5560                                           , input 0
     5561                                       , input '':U
     5562                                           , input '>':U
     5563                                           , input (if v-file
     5564                                                   then substitute("Файл макроса : &1", f-name)
     5565                                                   else substitute("Записанный макрос")
     5566                                                   )
     5567                                           , input tot-lns
     5568                                           , input 'macro':U
     5569                                           , input '':U
     5570                                           , input (if v-file then f-name else '':U)
     5571                                           , input '':U
     5572                                           , input ?
     5573                                           ).
     5574     end.
     5575     disable
     5576     b-record
     5577     b-macro
     5578     with frame Dialog-Frame .
     5579     hide
     5580     b-record in frame Dialog-Frame .
     5581     enable
     5582     b-clear-macro with frame Dialog-Frame .
     5583     v-macro-is-running = yes.
     5584     run str/listmcro.w (input parparentproc
     5585                   ,input this-procedure:handle
     5586                  ,input "Макрос формирования списка документов" + chr(4) + "trm"
     5587                   ,input "b-play,b-step"
     5588                   ,input-output v-current-step
     5589                   ,input v-id
     5590                   ,output v-result) no-error .
     5591     if error-status:error
     5592     or v-result = "b-stop"
     5593     or v-result = 'end':U
     5594     then do:
     5595       for each macro-list-hist:
     5596         delete macro-list-hist.
     5597       end.
     5598       assign
     5599       an-listp-start-macro-id = ?
     5600       an-listp-end-macro-id = ?
     5601       an-listp-macros-label-id = 0
     5602       .
     5603       if v-result = 'b-stop' then do:
     5604         assign
     5605         v-hist-mode = '[]':U
     5606         v-des = "Выполнение макроса прекращено пользователем"
     5607         .
     5608         hide
     5609         b-clear-macro
     5610         b-stop
     5611         in frame Dialog-Frame .
     5612         enable
     5613         b-record
     5614         with frame Dialog-Frame .
     5615       end.
     5616       if v-result = 'end' then do:
     5617         assign
     5618         v-hist-mode = '<':U
     5619         v-des = "Выполнение макроса завершено"
     5620         .
     5621         hide
     5622         b-clear-macro
     5623         b-stop
     5624         in frame Dialog-Frame .
     5625         enable
     5626         b-record
     5627         with frame Dialog-Frame .
     5628       end.
     5629       if error-status:error then do:
     5630         assign
     5631         v-hist-mode = 'E':U
     5632         v-des = "Выполнение макроса прекращено из-за ошибки"
     5633         .
     5634       end.
     5635       run create-doc-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     5636                                           , input-output v-seq
     5637                                           , input 0
     5638                                           , input '':U
     5639                                           , input v-hist-mode
     5640                                           , input v-des
     5641                                           , input tot-lns
     5642                                           , input 'macro':U
     5643                                           , input '':U
     5644                                           , input f-name
     5645                                           , input '':U
     5646                                           , input ?
     5647                                           ) no-error .
     5648       assign
     5649       v-macro-is-running = no
     5650       v-current-step = 0
     5651       .
     5652     end.
     5653     enable
     5654     b-macro
     5655     with frame Dialog-Frame .
     5656   end.
     5657   end procedure.
     5658   procedure proc-create-macro-list-hist :
     5659   define input parameter p-list-table as character no-undo .
     5660   define input parameter p-id as integer           no-undo .
     5661   define input parameter p-line as integer         no-undo .
     5662   define input parameter p-hist-mode as character  no-undo .
     5663   define input parameter p-des as character        no-undo .
     5664   define input parameter p-option_ as character    no-undo .
     5665   define input parameter p-item_ as character      no-undo .
     5666   define input parameter p-status_ as character    no-undo .
     5667   define buffer buf_macro-list-hist for macro-list-hist.
     5668   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5669     do
     5670     on error undo, return error return-value
     5671     :
     5672       create buf_macro-list-hist.
     5673       assign
     5674       buf_macro-list-hist.list-table = p-list-table
     5675       buf_macro-list-hist.id         = p-id
     5676       buf_macro-list-hist.line       = p-line
     5677       buf_macro-list-hist.hist-mode  = p-hist-mode
     5678       buf_macro-list-hist.des        = p-des
     5679       buf_macro-list-hist.option_    = p-option_
     5680       buf_macro-list-hist.item_      = p-item_
     5681       buf_macro-list-hist.status_    = p-status_
     5682       .
     5683       if p-keep-query then do:
     5684         create buf_keep-macro-list-hist.
     5685         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     5686       end.
     5687     end.
     5688   end procedure.
     5689   procedure proc-macro-play :
     5690   define input parameter p-id as integer no-undo .
     5691   define input parameter p-step as logical no-undo .
     5692   define input parameter p-max-id as integer no-undo .
     5693   define variable v-id as integer no-undo .
     5694   define variable v-rowid   as rowid no-undo .
     5695   define variable v-tbl-name as character no-undo .
     5696   define variable v-old-seq as integer no-undo .
     5697   define variable v-current-id as integer no-undo .
     5698   define variable v-temp-seq as integer no-undo .
     5699   define variable v-rs-do-error as logical no-undo .
     5700   define  buffer buf_macro-list-hist for macro-list-hist.
     5701   define  buffer buf_doc-list-hist for doc-list-hist.
     5702   do
     5703   on error undo, return error return-value
     5704   :
     5705     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     5706       assign
     5707       v-current-id = v-current-id + 1
     5708       v-id = macro-list-hist.id.
     5709       CASE entry(1, macro-list-hist.option_, chr(4)):
     5710         when 'macro':U
     5711         or
     5712         when 'title':U
     5713         or
     5714         when 'start':U
     5715         then do:
     5716         end.
     5717         when 'clear':U then do:
     5718           for each doc-list:
     5719             delete doc-list.
     5720           end.
     5721           for each doc-list-hist where doc-list-hist.id > an-listp-macros-label-id:
     5722             delete doc-list-hist.
     5723           end.
     5724           tot-lns = 0.
     5725           v-seq = an-listp-macros-label-id + 1.
     5726           v-no-hist = 0.
     5727           create buf_doc-list-hist.
     5728           buffer-copy macro-list-hist
     5729           to buf_doc-list-hist
     5730           assign buf_doc-list-hist.id = v-seq
     5731           v-temp-seq = v-seq
     5732           v-seq = v-seq + 1
     5733           v-no-hist = v-no-hist + 1
     5734           .
     5735           run MyEnable in this-procedure .
     5736         end.
     5737         when 'single' then do:
     5738            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     5739                                                 ,input ?
     5740                                                 ,input 'ub'
     5741                                                 ,input ?
     5742                                                 ,input no-lock
     5743                                                 ,output v-rowid
     5744                                                 ,output v-tbl-name) no-error .
     5745           if not error-status:error then do:
     5746             CASE macro-list-hist.hist-mode:
     5747               when '+':U then do:
     5748                 run proc-b-add in this-procedure(input yes
     5749                                                 ,input v-rowid
     5750                                                 ,input macro-list-hist.option_
     5751                                                 ,input macro-list-hist.list-table
     5752                                                 ,input macro-list-hist.status_) no-error .
     5753               end.
     5754               when '-':U then do:
     5755                 run proc-b-del in this-procedure(input yes
     5756                                                 ,input v-rowid
     5757                                                 ,input macro-list-hist.option_
     5758                                                 ,input macro-list-hist.list-table
     5759                                                 ,input macro-list-hist.status_) no-error .
     5760               end.
     5761               when '*':U then do:
     5762                 run proc-b-rest in this-procedure(input yes
     5763                                                  ,input v-rowid
     5764                                                  ,input macro-list-hist.option_
     5765                                                  ,input macro-list-hist.list-table
     5766                                                  ,input macro-list-hist.status_) no-error .
     5767               end.
     5768             END.
     5769             if error-status:error then do:
     5770                 return ("error" + chr(4) + return-value) .
     5771             end.
     5772             find first  buf_doc-list-hist where
     5773                     buf_doc-list-hist.id = v-seq - 1 no-error .
     5774             if available buf_doc-list-hist then
     5775             assign
     5776             macro-list-hist.num-recs = buf_doc-list-hist.num-recs
     5777             macro-list-hist.num-add = buf_doc-list-hist.num-add
     5778             macro-list-hist.num-ignored = buf_doc-list-hist.num-ignored
     5779             .
     5780           end.
     5781           else do:
     5782             return ("error" + chr(4) + return-value).
     5783           end.
     5784         end.
     5785         otherwise do:
     5786           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     5787           or lookup(macro-list-hist.option_, '':U) > 0
     5788           then do:
     5789             if macro-list-hist.line = 0 then do:
     5790               v-no-hist = 0.
     5791               for each buf_macro-list-hist where
     5792                       buf_macro-list-hist.id = v-id:
     5793                 create buf_doc-list-hist.
     5794                 buffer-copy buf_macro-list-hist
     5795                 except id  num-recs num-add num-ignored done
     5796                 to buf_doc-list-hist
     5797                 assign
     5798                 buf_doc-list-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     5799                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     5800                 v-seq = (if buf_macro-list-hist.line = 0
     5801                         then (v-seq + 1)
     5802                         else v-seq)
     5803                 v-no-hist = v-no-hist + 1
     5804                 .
     5805               end.
     5806               if v-no-hist = 1 then v-no-hist = 0.
     5807               run rs-do in this-procedure (input yes
     5808                                         , input p-step
     5809                                         , input macro-list-hist.option_
     5810                                         , input macro-list-hist.list-table
     5811                                         , input macro-list-hist.status_
     5812                                         , input get-line-mode(macro-list-hist.hist-mode)
     5813                                         , input v-temp-seq
     5814                                         ) no-error .
     5815               if error-status:error then do:
     5816                 assign
     5817                 v-rs-do-error = yes.
     5818               end.
     5819               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     5820                 run proc-b-rest-2 in this-procedure .
     5821                 run MyEnable in this-procedure .
     5822               end.
     5823               for each buf_doc-list-hist where
     5824                       buf_doc-list-hist.id = v-temp-seq,
     5825                  first buf_macro-list-hist where
     5826                       buf_macro-list-hist.id = v-id
     5827                   AND buf_macro-list-hist.line = buf_doc-list-hist.line:
     5828                  assign
     5829                  buf_macro-list-hist.num-recs = buf_doc-list-hist.num-recs
     5830                  buf_macro-list-hist.num-add = buf_doc-list-hist.num-add
     5831                  buf_macro-list-hist.num-ignored = buf_doc-list-hist.num-ignored
     5832                  .
     5833               end.
     5834               if v-rs-do-error then do:
     5835                 run MyEnable in this-procedure .
     5836                 return ("error" + chr(4) + return-value).
     5837               end.
     5838               v-id = macro-list-hist.id.
     5839             end.
     5840           end.
     5841         end.
     5842       END CASE.
     5843     end.
     5844   end.
     5845   end procedure.
     5846   procedure proc-b-rest-2 :
     5847     do
     5848     on error undo, return error
     5849     :
     5850       for each doc-list:
     5851         if doc-list.to-del = ? then do:
     5852           assign
     5853           doc-list.to-del = no
     5854           .
     5855         end.
     5856         else do:
     5857           delete doc-list.
     5858         end.
     5859       end.
     5860       tot-lns = lns-cnt.
     5861     end.
     5862   end procedure.
     5863   PROCEDURE proc-expand :
     5864   define input parameter p-shift as integer no-undo .
     5865   define input parameter p-from as integer no-undo .
     5866   define input parameter p-to as integer no-undo .
     5867   define input parameter p-forcer-name as character no-undo .
     5868   define variable fh as widget-handle no-undo .
     5869   define variable hh as widget-handle no-undo .
     5870   define variable lh as widget-handle no-undo .
     5871   define variable ii as INTEGER no-undo .
     5872   ASSIGN
     5873   fh = frame Dialog-Frame:first-child
     5874   hh = fh:first-child
     5875   .
     5876   CASE v-expand:
     5877     WHEN YES THEN DO:
     5878       ASSIGN
     5879       v-expand = NO.
     5880       DO ii = 1 TO NUM-ENTRIES(v-downed):
     5881         ASSIGN
     5882         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     5883         hh:ROW          = (hh:ROW - p-shift).
     5884         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     5885       END.
     5886     END.
     5887     WHEN NO THEN DO:
     5888       v-expand = YES.
     5889       v-downed = ''.
     5890       _do:
     5891       do while valid-handle(hh):
     5892         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     5893          AND hh:ROW >= p-from
     5894          AND hh:ROW <= p-to
     5895          and lookup(hh:name, p-forcer-name) = 0
     5896          THEN DO:
     5897           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     5898           hh:ROW          = (hh:ROW + p-shift).
     5899           ASSIGN
     5900           v-downed = v-downed + chr(44) + STRING(hh).
     5901           IF hh:TYPE = "fill-in"
     5902           AND valid-handle(hh:side-label-handle) THEN dO:
     5903             assign
     5904             lh = hh:SIDE-LABEL-HANDLE
     5905             lh:ROW = lh:ROW + p-shift
     5906             v-downed = v-downed + chr(44) + STRING(lh)
     5907             .
     5908            END.
     5909          END.
     5910          hh = hh:next-sibling.
     5911       END.
     5912       v-downed = trim(v-downed, chr(44)).
     5913     END.
     5914   END CASE.
     5915   END PROCEDURE.
     5916   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5917   do:
     5918     br-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     5919   end.
     5920   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5921   DEF VAR cur-clmn-numBR-list as INT EXTENT 10 no-undo.
     5922   DEF VAR varmviBR-list       as INT no-undo.
     5923   DEF VAR varmvjBR-list       as INT no-undo.
     5924   DEF VAR varmvkBR-list       as INT no-undo.
     5925   DEF VAR varmvlBR-list       as INT no-undo.
     5926   DEF VAR move-elementBR-list as INT no-undo.
     5927   def var jjBR-list           as int no-undo.
     5928   do varmviBR-list = 1 to EXTENT(cur-clmn-numBR-list):
     5929     ASSIGN cur-clmn-numBR-list[varmviBR-list] = varmviBR-list.
     5930   END.
     5931   RUN start-mv-clmnBR-list.
     5932   PROCEDURE start-mv-clmnBR-list:
     5933   def var old-session as logical no-undo.
     5934      old-session = SESSION:IMMEDIATE-DISPLAY.
     5935      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5936      SESSION:IMMEDIATE-DISPLAY = old-session.
     5937   END.
     5938   ON ctrl-cursor-right OF BROWSE BR-list do:
     5939     RUN re-move-clmnBR-list ( 1, 10).
     5940   END.
     5941   ON ctrl-cursor-left OF BROWSE BR-list do:
     5942     RUN re-move-clmnBR-list (10, 1).
     5943   END.
     5944   PROCEDURE re-move-clmnBR-list:
     5945     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5946     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5947     DO varmviBR-list = 1 TO EXTENT(cur-clmn-numBR-list):
     5948       if cur-clmn-numBR-list[varmviBR-list] = source-column THEN cur-clmn-numBR-list[varmviBR-list] = -1.
     5949     END.
     5950     if BR-list:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     5951     if source-column > target-column THEN
     5952     DO varmvjBR-list = source-column - 1 to target-column BY -1:
     5953       DO varmviBR-list = 1 TO EXTENT(cur-clmn-numBR-list):
     5954           if cur-clmn-numBR-list[varmviBR-list] = varmvjBR-list THEN DO:
     5955             cur-clmn-numBR-list[varmviBR-list] = cur-clmn-numBR-list[varmviBR-list] + 1.
     5956           END.
     5957       END.
     5958     END.
     5959     ELSE
     5960     DO varmvjBR-list = source-column + 1 to target-column:
     5961       DO varmviBR-list = 1 TO EXTENT(cur-clmn-numBR-list):
     5962         if cur-clmn-numBR-list[varmviBR-list] = varmvjBR-list THEN DO:
     5963           cur-clmn-numBR-list[varmviBR-list] = cur-clmn-numBR-list[varmviBR-list] - 1.
     5964         END.
     5965       END.
     5966     END.
     5967     DO varmviBR-list = 1 TO EXTENT(cur-clmn-numBR-list):
     5968       if cur-clmn-numBR-list[varmviBR-list] = -1 THEN cur-clmn-numBR-list[varmviBR-list] = target-column.
     5969     END.
     5970   END PROCEDURE.
     5971   PROCEDURE ch-clmnBR-list:
     5972     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5973     if cur-clmn-loc <= 1 then do:
     5974       return .
     5975     end.
     5976     DO varmviBR-list = 1 TO EXTENT(cur-clmn-numBR-list):
     5977       if cur-clmn-numBR-list[varmviBR-list] = cur-clmn-loc THEN move-elementBR-list = varmviBR-list.
     5978     END.
     5979     RUN re-move-clmnBR-list (cur-clmn-loc, 1).
     5980   END PROCEDURE.
     5981   PROCEDURE mv-brw-defaultBR-list:
     5982   def var old-session as logical no-undo.
     5983     old-session = SESSION:IMMEDIATE-DISPLAY.
     5984     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5985     do varmvlBR-list = 1 to EXTENT(cur-clmn-numBR-list):
     5986       RUN re-move-clmnBR-list (cur-clmn-numBR-list[varmvlBR-list], varmvlBR-list).
     5987     END.
     5988     RUN start-mv-clmnBR-list.
     5989     SESSION:IMMEDIATE-DISPLAY = old-session.
     5990   END PROCEDURE.
     5991   .
     5992   MAIN-BLOCK:
     5993   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5994      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5995   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5996     run mainmenu_getcntxt in parparentproc
     5997       (output v-cntxt-db-num
     5998       ,output v-cntxt-userid
     5999       ,output v-cntxt-level
     6000       ,output v-cntxt-host-code-obj
     6001       ,output v-cntxt-obj-type
     6002       ,output v-cntxt-obj-code
     6003       ,output v-cntxt-db-num-obj
     6004       ,output v-cntxt-is-admin
     6005       ) .
     6006   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6007   do:
     6008     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6009       (input  v-cntxt-db-num
     6010       ,input  v-cntxt-userid
     6011       ,input  0
     6012       ,input  'actn_documents_all':U
     6013       ,input  'global':U
     6014       ,input  0
     6015       ,input  '':U
     6016       ,input  0
     6017       ,input  0
     6018       ,input  0
     6019       ,input  0
     6020       ,input  false
     6021       ,output v-docs-all
     6022       )  .
     6023   end.
     6024   define variable vss-include-info54 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6025   do:
     6026     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6027       (input  v-cntxt-db-num
     6028       ,input  v-cntxt-userid
     6029       ,input  0
     6030       ,input  'actn_documents_company':U
     6031       ,input  'firm':U
     6032       ,input  v-cntxt-host-code-obj
     6033       ,input  '':U
     6034       ,input  0
     6035       ,input  0
     6036       ,input  0
     6037       ,input  0
     6038       ,input  false
     6039       ,output v-docs-cmp
     6040       )  .
     6041   end.
     6042     run get-report-num in parparentproc ( output g#report-num ).
     6043     assign
     6044     line-rec = ?
     6045     v-sort-mode = 'sort-doc-code'
     6046     .
     6047     run proc-fill-temp-list in this-procedure .
     6048     ASSIGN
     6049     b-save:MENU-MOUSE = 1
     6050     b-print:MENU-MOUSE = 1
     6051     .
     6052     RUN Myenable in this-procedure .
     6053     if v-sort-mode <> 'sort-sel-order'
     6054     then do:
     6055       assign
     6056         b-up :visible   = false
     6057         b-down :visible = false
     6058       .
     6059     end.
     6060     else do:
     6061       assign
     6062         b-up :visible     = true
     6063         b-down :visible   = true
     6064         b-up :sensitive   = true
     6065         b-down :sensitive = true
     6066       .
     6067       run re-move-clmnbr-list in this-procedure (input 10, 1) .
     6068     end.
     6069     WAIT-FOR GO OF FRAME Dialog-Frame.
     6070   END.
     6071   RUN disable_UI.
     6072   procedure cb_get-next-doc-by-doc-code :
     6073   define input parameter p-doc-code as character no-undo .
     6074   define input parameter p-doc-type as character no-undo .
     6075   define input parameter p-bh as handle no-undo .
     6076   define buffer buf_doc-list for doc-list.
     6077   find first buf_doc-list no-lock where
     6078             buf_doc-list.doc-code = p-doc-code
     6079        and  buf_doc-list.doc-type = p-doc-type no-error.
     6080   find next buf_doc-list use-index xpk no-error.
     6081   if available buf_doc-list then do:
     6082     p-bh:buffer-create().
     6083     p-bh:buffer-copy(buffer buf_doc-list:handle).
     6084   end.
     6085   else do:
     6086   end.
     6087   end procedure.
     6088   PROCEDURE disable_UI :
     6089     HIDE FRAME Dialog-Frame.
     6090   END PROCEDURE.
     6091   PROCEDURE enable_UI :
     6092     DISPLAY dsp-rs sch-code sch-date ED-notes f-tot-lns
     6093         WITH FRAME Dialog-Frame.
     6094     ENABLE dsp-rs BR-option B-exit B-save B-print B-hist B-lkp B-clr B-Help B-add
     6095            B-del B-rest B-macro B-stop B-clear-macro B-record  BR-list sch-code ~
     6096            sch-date b-up b-down ED-notes f-tot-lns
     6097         WITH FRAME Dialog-Frame.
     6098     VIEW FRAME Dialog-Frame.
     6099     run openbr in this-procedure .    open query br-option for each temp-list no-lock .
     6100   END PROCEDURE.
     6101   PROCEDURE MyEnable :
     6102   define variable v-start as logical no-undo .
     6103   define variable v-recid0 as recid no-undo.
     6104   define buffer buf_temp-list for temp-list.
     6105   define buffer buf_doc-list-hist for doc-list-hist.
     6106   ASSIGN b-print:MENU-MOUSE IN FRAME Dialog-Frame = 1.
     6107   ASSIGN b-save:MENU-MOUSE IN FRAME Dialog-Frame = 1.
     6108   find first buf_doc-list-hist where buf_doc-list-hist.id = 0 no-error.
     6109   if available buf_doc-list-hist then
     6110   assign
     6111   frame Dialog-Frame:title = substitute("СПИСОК  ДОКУМЕНТОВ &1",  string(buf_doc-list-hist.des, "X(60)"))
     6112   .
     6113   br-option:column-scrolling in frame Dialog-Frame  = no.
     6114   if tot-lns = ? then do:
     6115     v-start = yes.
     6116     for each l-doc-list :
     6117       accumulate l-doc-list.obj-code (count).
     6118     end.
     6119     tot-lns = (accum count l-doc-list.obj-code).
     6120     if tot-lns > 0 then do:
     6121       find last  buf_doc-list-hist no-error .
     6122       v-seq = (if available buf_doc-list-hist then buf_doc-list-hist.id else 0)  + 1.
     6123       run create-doc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6124                                             , input-output v-seq
     6125                                             , input 0
     6126                                             , input '':U
     6127                                             , input 'S':U
     6128                                             , input substitute("# Исходный список: &1 строк", tot-lns)
     6129                                             , input tot-lns
     6130                                             , input "start":U
     6131                                             , input '':U
     6132                                             , input '':U
     6133                                             , input '':U
     6134                                             , input ?
     6135                                             ).
     6136     end.
     6137     else do:
     6138       line-mode = 'ДОБАВЛЕНИЕ':U.
     6139       for each buf_doc-list-hist:
     6140         delete buf_doc-list-hist.
     6141       end.
     6142       v-seq = 1.
     6143       run create-doc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6144                                             , input-output v-seq
     6145                                             , input 0
     6146                                             , input '':U
     6147                                             , input '':U
     6148                                             , input "# Исходный список документов пуст."
     6149                                             , input tot-lns
     6150                                             , input 'start':U
     6151                                             , input '':U
     6152                                             , input '':U
     6153                                             , input '':U
     6154                                             , input ?
     6155                                             ).
     6156     end.
     6157   end.
     6158   find first buf_temp-list no-lock where
     6159               buf_temp-list.fvalue = "single".
     6160   assign
     6161   v-recid0 = recid(buf_temp-list).
     6162   open query br-option for each temp-list no-lock .
     6163   assign
     6164   RS-list-method = "single".
     6165   if v-seq > 1 then
     6166   find last buf_doc-list-hist no-lock where
     6167             buf_doc-list-hist.id = (v-seq - 1)
     6168         and  buf_doc-list-hist.line = 0 no-error .
     6169   DISPLAY br-option
     6170   (if available buf_doc-list-hist
     6171   then buf_doc-list-hist.des
     6172   else '') @ dsp-rs
     6173   WITH FRAME Dialog-Frame.
     6174   ENABLE
     6175   b-macro  when v-start
     6176   b-record when v-start
     6177   b-exit b-add b-hist b-help br-option br-list WITH FRAME Dialog-Frame.
     6178   if v-start then do:
     6179     hide
     6180     b-stop
     6181     b-clear-macro
     6182     in frame Dialog-Frame.
     6183   end.
     6184   v-start = no.
     6185   hide sch-code in frame Dialog-Frame
     6186   sch-date in frame Dialog-Frame
     6187   .
     6188   ENABLE
     6189   b-exit
     6190   b-add
     6191   b-hist
     6192   b-help
     6193   br-list
     6194   br-option
     6195   WITH FRAME Dialog-Frame.
     6196   reposition br-option to recid v-recid0.
     6197   if tot-lns > 0 then
     6198     ENABLE
     6199     b-print
     6200     b-rest
     6201     b-save
     6202     b-del
     6203     b-lkp
     6204     b-clr
     6205     sch-code sch-date
     6206     WITH FRAME Dialog-Frame.
     6207   else do:
     6208     DISABLE b-print b-rest b-save b-del b-lkp b-clr sch-code sch-date WITH FRAME Dialog-Frame.
     6209   end.
     6210   if tot-lns = ? or tot-lns = 0 then do:
     6211     hide sch-code sch-date in frame Dialog-Frame .
     6212   end.
     6213   VIEW FRAME Dialog-Frame.
     6214   run openbr in this-procedure .
     6215   if line-rec <> ? then
     6216     reposition br-list to recid line-rec no-error.
     6217   if avail doc-list then do:     assign ed-notes = ddoc-ps.     display     ed-notes     tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.    else do:     assign ed-notes = ''.     display ed-notes      tot-lns @ f-tot-lns     with frame Dialog-Frame.   end.
     6218   END PROCEDURE.
     6219   PROCEDURE OpenBr :
     6220     case v-sort-mode :
     6221       when 'sort-doc-code':u
     6222       then do:
     6223         Open query br-list
     6224           for each doc-list No-LOCK
     6225           by doc-list.doc-code
     6226           indexed-reposition
     6227           .
     6228       end.
     6229       when 'sort-sel-order':u
     6230       then do:
     6231         Open query br-list
     6232           for each doc-list No-LOCK
     6233           by doc-list.sel-order
     6234           indexed-reposition
     6235           .
     6236       end.
     6237       otherwise do:
     6238         message
     6239           vss-workfile vss-revision vss-description skip
     6240           "Ошибка задания входных параметров" skip
     6241           "Неизвестный порядок сортировки" v-sort-mode skip
     6242           view-as alert-box error .
     6243         Open query br-list
     6244           for each doc-list No-LOCK indexed-reposition
     6245           .
     6246       end.
     6247     end case .
     6248     APPLY "ENTRY" to br-list in frame Dialog-Frame .
     6249   END PROCEDURE.
     6250   PROCEDURE proc-b-add :
     6251   define input parameter p-from-macro as logical no-undo .
     6252   define input parameter p-rowid as rowid no-undo .
     6253   define input parameter rs-list-method as character no-undo .
     6254   define input parameter p-table-name as character no-undo .
     6255   define input parameter rs-status as character no-undo .
     6256   line-mode = 'ДОБАВЛЕНИЕ':U.
     6257   if rs-list-method = "single"
     6258   then do:
     6259     v-no-hist = - 1.
     6260     if p-from-macro then do:
     6261       CASE p-table-name:
     6262         when 'trn-doc':U then do:
     6263           find first ub.trn-doc where rowid(ub.trn-doc) = p-rowid no-error.
     6264           if not available ub.trn-doc then do:
     6265             return error "Нет в БД такого документа".
     6266           end.
     6267         end.
     6268         when 'c-trn-doc':U then do:
     6269           find first ub.c-trn-doc where rowid(ub.c-trn-doc) = p-rowid no-error.
     6270           if not available ub.c-trn-doc then do:
     6271             return error "Нет в БД такого УДАЛЕННОГО документа".
     6272           end.
     6273         end.
     6274         when 'price-doc':U then do:
     6275           find first ub.price-doc where rowid(ub.price-doc) = p-rowid no-error.
     6276           if not available ub.price-doc then do:
     6277             return error "Нет в БД такой переоценки".
     6278           end.
     6279         end.
     6280         when 'fbr-doc':U then do:
     6281           find first ub.fbr-doc where rowid(ub.fbr-doc) = p-rowid no-error.
     6282           if not available ub.fbr-doc then do:
     6283             return error "Нет в БД такого производство".
     6284           end.
     6285         end.
     6286         when 'inkas':U then do:
     6287           find first ub.inkas where rowid( ub.inkas) = p-rowid no-error.
     6288           if not available ub.inkas then do:
     6289             return error "Нет в БД такой продажи".
     6290           end.
     6291         end.
     6292         when 'ord-doc':U then do:
     6293           find first ub.ord-doc where rowid(ub.ord-doc) = p-rowid no-error.
     6294           if not available ub.ord-doc then do:
     6295             return error "Нет в БД такого заказа".
     6296           end.
     6297         end.
     6298         when 'c-inkas':U then do:
     6299           find first ub.c-inkas where rowid(ub.c-inkas) = p-rowid no-error.
     6300           if not available ub.c-inkas then do:
     6301             return error "Нет в БД такой УДАЛЕННОЙ продажи".
     6302           end.
     6303         end.
     6304       END CASE.
     6305     end.
     6306     else do:
     6307     define variable v-input-output as character no-undo .
     6308     p-table-name = 'trn-doc':U.
     6309     run str/all-docs.w (input parparentproc
     6310                         ,input (if v-docs-all
     6311                                 then ?
     6312                                 else v-cntxt-host-code-obj)
     6313                         ,input (if v-docs-all
     6314                                 then ?
     6315                                 else v-cntxt-obj-type)
     6316                         ,input (if v-docs-all
     6317                                 then ?
     6318                                 else v-cntxt-obj-code)
     6319                         ,input (if v-docs-all
     6320                                 then 'работа':U
     6321                                 else (if v-docs-cmp
     6322                                       then 'фирма':U
     6323                                       else 'объект':U)
     6324                                 )
     6325                        ,input ?
     6326                        ,input ?
     6327                        ,input ?
     6328                        ,input ?
     6329                        ,input 'b-sel':U
     6330                        ,input '':U
     6331                        ,input ?
     6332                        ,input ?
     6333                        ,output ref-list
     6334                        ) no-error .
     6335     apply "entry" to br-list in frame Dialog-Frame.
     6336     if ref-list = "" then   return error.
     6337     find first ub.trn-doc where recid ( ub.trn-doc) = integer (ref-list) no-lock no-error.
     6338     end.
     6339     if not p-from-macro and avail ub.trn-doc
     6340     or (
     6341         (p-from-macro and p-table-name = 'trn-doc':U and available ub.trn-doc)
     6342         or
     6343         (p-from-macro and p-table-name = 'inkas':U and available ub.inkas)
     6344         or
     6345         (p-from-macro and p-table-name = 'price-doc':U and available ub.price-doc)
     6346         or
     6347         (p-from-macro and p-table-name = 'fbr-doc':U and available ub.fbr-doc)
     6348         or
     6349         (p-from-macro and p-table-name = 'ord-doc':U and available ub.ord-doc)
     6350         or
     6351         (p-from-macro and p-table-name = 'c-trn-doc':U and available ub.c-trn-doc)
     6352         or
     6353         (p-from-macro and p-table-name = 'c-inkas':U and available ub.c-inkas)
     6354         )
     6355     then do:
     6356       run ex-doc in this-procedure (input (if not p-from-macro
     6357                                            then 1
     6358                                            else (if p-table-name begins "c-"
     6359                                                  then  (lookup(p-table-name, 'c-price-doc':U + chr(44) +
     6360                                                                             'c-trn-doc':U + chr(44) +
     6361                                                                             'c-inkas':U + chr(44) +
     6362                                                                             'c-fbr-doc':U + chr(44) +
     6363                                                                             'c-ord-doc':U ) - 1 + 100)
     6364                                                  else  (lookup(p-table-name, 'price-doc':U + chr(44) +
     6365                                                                             'trn-doc':U + chr(44) +
     6366                                                                             'inkas':U + chr(44) +
     6367                                                                             'fbr-doc':U + chr(44) +
     6368                                                                             'ord-doc':U ) - 1)
     6369                                                  )
     6370                                           )
     6371                                   , input rs-list-method
     6372                                   , input rs-status
     6373                                   , input line-mode) .
     6374       tot-lns = tot-lns + 1.
     6375       run write-hist in this-procedure (input p-from-macro, input rs-list-method, input p-table-name, input rs-status, input line-mode).
     6376     end.
     6377     else do:
     6378       return error "Нет в БД такого документа".
     6379     end.
     6380     run Myenable in this-procedure .
     6381   end.
     6382   else do:
     6383       run rs-do in this-procedure (no, no, rs-list-method, p-table-name, rs-status, line-mode, v-seq - 1).
     6384   end.
     6385   END PROCEDURE.
     6386   PROCEDURE proc-b-del :
     6387   define input parameter p-from-macro as logical no-undo .
     6388   define input parameter p-rowid as rowid no-undo .
     6389   define input parameter rs-list-method as character no-undo .
     6390   define input parameter p-table-name as character no-undo .
     6391   define input parameter rs-status as character no-undo .
     6392   define variable v-rep-rec as recid no-undo .
     6393   define variable glog as logical no-undo .
     6394   line-mode = 'удаление':U.
     6395   if rs-list-method = "single" then do:
     6396     v-no-hist = - 1.
     6397     if p-from-macro then do:
     6398       CASE p-table-name:
     6399         when 'trn-doc':U then do:
     6400           find first ub.trn-doc where rowid(ub.trn-doc) = p-rowid no-error.
     6401           if not available ub.trn-doc then do:
     6402             return error "Нет в БД такого документа".
     6403           end.
     6404           find first doc-list where doc-list.doc-code = ub.trn-doc.doc-code no-error.
     6405         end.
     6406         when 'c-trn-doc':U then do:
     6407           find first ub.c-trn-doc where rowid(ub.c-trn-doc) = p-rowid no-error.
     6408           if not available ub.c-trn-doc then do:
     6409             return error "Нет в БД такого УДАЛЕННОГО документа".
     6410           end.
     6411           find first doc-list where doc-list.doc-code = ub.c-trn-doc.doc-code no-error.
     6412         end.
     6413         when 'price-doc':U then do:
     6414           find first ub.price-doc where rowid(ub.price-doc) = p-rowid no-error.
     6415           if not available ub.price-doc then do:
     6416             return error "Нет в БД такой переоценки".
     6417           end.
     6418           find first doc-list where doc-list.doc-code = ub.price-doc.doc-num no-error.
     6419         end.
     6420         when 'inkas':U then do:
     6421           find first ub.inkas where rowid( ub.inkas) = p-rowid no-error.
     6422           if not available ub.inkas then do:
     6423             return error "Нет в БД такой продажи".
     6424           end.
     6425           find first doc-list where doc-list.doc-code = ub.inkas.inkas-code no-error.
     6426         end.
     6427         when 'c-inkas':U then do:
     6428           find first ub.c-inkas where rowid(ub.c-inkas) = p-rowid no-error.
     6429           if not available ub.c-inkas then do:
     6430             return error "Нет в БД такой УДАЛЕННОЙ продажи".
     6431           end.
     6432           find first doc-list where doc-list.doc-code = ub.c-inkas.inkas-code no-error.
     6433         end.
     6434         when 'fbr-doc':U then do:
     6435           find first ub.fbr-doc where rowid(ub.fbr-doc) = p-rowid no-error.
     6436           if not available ub.fbr-doc then do:
     6437             return error "Нет в БД такого производства".
     6438           end.
     6439           find first doc-list where doc-list.doc-code = price-doc.doc-num no-error.
     6440         end.
     6441         when 'ord-doc':U then do:
     6442           find first ub.ord-doc where rowid(ub.ord-doc) = p-rowid no-error.
     6443           if not available ub.ord-doc then do:
     6444             return error "Нет в БД такого заказа".
     6445           end.
     6446           find first doc-list where doc-list.doc-code = ub.ord-doc.doc-code no-error.
     6447         end.
     6448       END CASE.
     6449     end.
     6450     if available doc-list then do:
     6451       if not p-from-macro then p-table-name = get-table-name(input doc-list.doc-type).
     6452       line-rec = recid (doc-list).
     6453       get next br-list.
     6454       if available doc-list then v-rep-rec = recid (doc-list).
     6455       else do:
     6456         reposition br-list to recid line-rec no-error.
     6457         get prev br-list.
     6458         if available doc-list then v-rep-rec = recid (doc-list).
     6459       end.
     6460       reposition br-list to recid line-rec no-error.
     6461       tot-lns = tot-lns - 1.
     6462       run write-hist in this-procedure (input p-from-macro, input rs-list-method, input p-table-name, input RS-STATUS, input line-mode).
     6463       delete doc-list.
     6464       line-rec = v-rep-rec.
     6465       run Myenable in this-procedure .
     6466     end.
     6467     else do:
     6468       return error "Нет в списке документов такого документа".
     6469     end.
     6470   end.
     6471   else do:
     6472     glog = no.
     6473     message "Удалить документы из списка ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     6474             view-as alert-box question buttons OK-Cancel update glog.
     6475     if not glog then
     6476       return error.
     6477     run rs-do in this-procedure (no, no, rs-list-method, p-table-name, rs-status, line-mode, v-seq - 1).
     6478   end.
     6479   END PROCEDURE.
     6480   PROCEDURE proc-b-rest :
     6481   define input parameter p-from-macro as logical no-undo .
     6482   define input parameter p-rowid as rowid no-undo .
     6483   define input parameter rs-list-method as character no-undo .
     6484   define input parameter p-table-name as character no-undo .
     6485   define input parameter rs-status as character no-undo .
     6486   define variable glog as logical no-undo .
     6487   define buffer buf_doc-list-hist for doc-list-hist.
     6488   line-mode = 'ОСТАВИТЬ':U.
     6489   if rs-list-method = "single" then do:
     6490     v-no-hist = - 1.
     6491     if p-from-macro then do:
     6492       CASE p-table-name:
     6493         when 'trn-doc':U then do:
     6494           find first ub.trn-doc where rowid(ub.trn-doc) = p-rowid no-error.
     6495           if not available ub.trn-doc then do:
     6496             return error "Нет в БД такого документа".
     6497           end.
     6498           find first doc-list where doc-list.doc-code = ub.trn-doc.doc-code no-error.
     6499         end.
     6500         when 'c-trn-doc':U then do:
     6501           find first ub.c-trn-doc where rowid(ub.c-trn-doc) = p-rowid no-error.
     6502           if not available ub.c-trn-doc then do:
     6503             return error "Нет в БД такого УДАЛЕННОГО документа".
     6504           end.
     6505           find first doc-list where doc-list.doc-code = ub.c-trn-doc.doc-code no-error.
     6506         end.
     6507         when 'price-doc':U then do:
     6508           find first ub.price-doc where rowid(ub.price-doc) = p-rowid no-error.
     6509           if not available ub.price-doc then do:
     6510             return error "Нет в БД такой переоценки".
     6511           end.
     6512           find first doc-list where doc-list.doc-code = ub.price-doc.doc-num no-error.
     6513         end.
     6514         when 'inkas':U then do:
     6515           find first ub.inkas where rowid( ub.inkas) = p-rowid no-error.
     6516           if not available ub.inkas then do:
     6517             return error "Нет в БД такой продажи".
     6518           end.
     6519           find first doc-list where doc-list.doc-code = ub.inkas.inkas-code no-error.
     6520         end.
     6521         when 'c-inkas':U then do:
     6522           find first ub.c-inkas where rowid(ub.c-inkas) = p-rowid no-error.
     6523           if not available ub.c-inkas then do:
     6524             return error "Нет в БД такой УДАЛЕННОЙ продажи".
     6525           end.
     6526           find first doc-list where doc-list.doc-code = ub.c-inkas.inkas-code no-error.
     6527         end.
     6528         when 'fbr-doc':U then do:
     6529           find first ub.fbr-doc where rowid(ub.fbr-doc) = p-rowid no-error.
     6530           if not available ub.fbr-doc then do:
     6531             return error "Нет в БД такого производвства".
     6532           end.
     6533           find first doc-list where doc-list.doc-code = ub.fbr-doc.doc-code no-error.
     6534         end.
     6535         when 'ord-doc':U then do:
     6536           find first ub.ord-doc where rowid(ub.ord-doc) = p-rowid no-error.
     6537           if not available ub.ord-doc then do:
     6538             return error "Нет в БД такого заказа".
     6539           end.
     6540           find first doc-list where doc-list.doc-code = ub.ord-doc.doc-code no-error.
     6541         end.
     6542       END CASE.
     6543     end.
     6544     if available doc-list then do:
     6545       if not p-from-macro then p-table-name = get-table-name(input doc-list.doc-type).
     6546       if p-from-macro then do:
     6547          glog = yes.
     6548       end.
     6549       else do:
     6550         glog = no.
     6551         message
     6552         "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6553         view-as alert-box question buttons OK-Cancel update glog.
     6554         if not glog then return error.
     6555       end.
     6556       line-rec = recid (doc-list).
     6557       v-seq = 1.
     6558       for each buf_doc-list-hist:
     6559         delete buf_doc-list-hist.
     6560       end.
     6561       run write-hist in this-procedure (input p-from-macro, input rs-list-method, input p-table-name, input rs-status, input line-mode).
     6562       for each doc-list:
     6563         if line-rec <> recid (doc-list) then delete doc-list.
     6564       end.
     6565       tot-lns = 1.
     6566       run Myenable in this-procedure .
     6567     end.
     6568     else do:
     6569       return error substitute("Нет в списке такого документа").
     6570     end.
     6571   end.
     6572   else do:
     6573     if not p-from-macro then do:
     6574       glog = no.
     6575       message
     6576       "Оставить документы в списке ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     6577       view-as alert-box question buttons OK-Cancel update glog.
     6578       if not glog then
     6579         return no-apply.
     6580     end.
     6581     assign
     6582     lns-cnt = 0
     6583     lns-ignore = 0
     6584     .
     6585     run rs-do in this-procedure (no, no, rs-list-method, p-table-name, rs-status, line-mode, v-seq - 1).
     6586     for each doc-list:
     6587       if doc-list.to-del = ? then do:
     6588         assign
     6589         doc-list.to-del = no
     6590         .
     6591       end.
     6592       else do:
     6593         delete doc-list.
     6594       end.
     6595     end.
     6596     tot-lns = lns-cnt.
     6597     run Myenable in this-procedure .
     6598     message
     6599     "Оставлено строк :" lns-cnt skip(0)
     6600     string(if lns-ignore <> 0
     6601     then ("Проигнорировано строк :" + string(lns-ignore))
     6602     else "":U)
     6603     .
     6604   end.
     6605   END PROCEDURE.
     6606   PROCEDURE proc-b-save :
     6607   define input parameter loc-save-option as character no-undo.
     6608   define variable v-frame-width as integer no-undo.
     6609   define variable glog as logical no-undo .
     6610   case loc-save-option:
     6611       when "doc-list":U then do:
     6612         assign
     6613         f-doc-name = "default.trn"
     6614         glog = yes
     6615         .
     6616         system-dialog get-file f-doc-name
     6617         filters "Списки документов *.trn" "*.trn"
     6618         ask-overwrite
     6619         save-as
     6620         use-filename
     6621         update glog
     6622         default-extension "trn".
     6623         if not glog then do:
     6624           apply "entry" to br-list in frame Dialog-Frame.
     6625           return no-apply.
     6626         end.
     6627         output to value (f-doc-name).
     6628         for each doc-list:
     6629           export
     6630           doc-list.doc-code
     6631           doc-list.doc-type
     6632           doc-list.obj-type
     6633           doc-list.obj-code
     6634           .
     6635         end.
     6636         output close.
     6637       end.
     6638       when "excel":U then do:
     6639           do on stop  undo, return no-apply
     6640              on error undo, return no-apply
     6641              on quit  undo, return no-apply
     6642           :
     6643           run str/docl-prn.p (input parparentproc,
     6644                         input p-curr-host-code,
     6645                         input p-curr-obj-type,
     6646                         input p-curr-obj-code,
     6647                         input "excel":U,
     6648                         output v-Frame-Width) no-error.
     6649             run waitfram-hide in this-procedure .
     6650          end.
     6651       end.
     6652   end case.
     6653   END PROCEDURE.
     6654   PROCEDURE proc-doc-print :
     6655   do
     6656   on error undo, return error return-value
     6657   :
     6658   define buffer buf_trn-doc for  ub.trn-doc .
     6659   define buffer buf_pr-doc  for  ub.price-doc .
     6660   define buffer buf_inkas   for  ub.inkas.
     6661   define buffer buf_fbr-doc for  ub.fbr-doc.
     6662   define variable v-doc-rec as   recid no-undo .
     6663   DEFINE VARIABLE v-frame-width as integer no-undo .
     6664   define variable glog as logical no-undo .
     6665   if doc-list.doc-type = 'производство':U
     6666   or lookup(doc-list.doc-type, 'ОФ,ФП,ОП,ОО,ОР,ПО') > 0
     6667   then do:
     6668     message
     6669     "Нет печати для документов производства и заказок/заявок!"
     6670     view-as alert-box .
     6671     return.
     6672   end.
     6673   if doc-list.doc-type = 'переоценка':U then do:
     6674      find first buf_pr-doc no-lock  where buf_pr-doc.doc-num = doc-list.doc-code no-error .
     6675       v-doc-rec = recid (buf_pr-doc).
     6676       run rep/pr-dprn.w ( input parparentproc
     6677                          ,input v-doc-rec).
     6678   end.
     6679   else do:
     6680     if doc-list.doc-type = 'касс':U then do:
     6681             find first buf_inkas no-lock where
     6682                        buf_inkas.inkas-code = doc-list.doc-code No-error.
     6683       run rep/sale-prn.p (
     6684               input parparentproc
     6685             , input recid(buf_inkas)
     6686             , input yes
     6687             ).
     6688     end.
     6689     else do:
     6690       find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = doc-list.doc-code no-error .
     6691       v-doc-rec = recid (buf_trn-doc).
     6692       case buf_trn-doc.doc-type
     6693       :
     6694         when 'при':U
     6695         then do:
     6696   define variable vss-include-info55 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6697   do:
     6698     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6699       (input  v-cntxt-db-num
     6700       ,input  v-cntxt-userid
     6701       ,input  0
     6702       ,input  'actn_income_print':U
     6703       ,input  'object':U
     6704       ,input  buf_trn-doc.host-code
     6705       ,input  buf_trn-doc.obj-type
     6706       ,input  buf_trn-doc.obj-code
     6707       ,input  0
     6708       ,input  0
     6709       ,input  0
     6710       ,input  true
     6711       ,output glog
     6712       )  .
     6713   end.
     6714         end.
     6715         when 'рас':U
     6716         then do:
     6717   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6718   do:
     6719     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6720       (input  v-cntxt-db-num
     6721       ,input  v-cntxt-userid
     6722       ,input  0
     6723       ,input  'actn_expense_print':U
     6724       ,input  'object':U
     6725       ,input  buf_trn-doc.host-code
     6726       ,input  buf_trn-doc.obj-type
     6727       ,input  buf_trn-doc.obj-code
     6728       ,input  0
     6729       ,input  0
     6730       ,input  0
     6731       ,input  true
     6732       ,output glog
     6733       )  .
     6734   end.
     6735         end.
     6736         when 'спи':U
     6737         then do:
     6738   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6739   do:
     6740     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6741       (input  v-cntxt-db-num
     6742       ,input  v-cntxt-userid
     6743       ,input  0
     6744       ,input  'actn_write-off_print':U
     6745       ,input  'object':U
     6746       ,input  buf_trn-doc.host-code
     6747       ,input  buf_trn-doc.obj-type
     6748       ,input  buf_trn-doc.obj-code
     6749       ,input  0
     6750       ,input  0
     6751       ,input  0
     6752       ,input  true
     6753       ,output glog
     6754       )  .
     6755   end.
     6756         end.
     6757         when 'инв':U
     6758         then do:
     6759   define variable vss-include-info58 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6760   do:
     6761     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6762       (input  v-cntxt-db-num
     6763       ,input  v-cntxt-userid
     6764       ,input  0
     6765       ,input  'actn_inventory_print':U
     6766       ,input  'object':U
     6767       ,input  buf_trn-doc.host-code
     6768       ,input  buf_trn-doc.obj-type
     6769       ,input  buf_trn-doc.obj-code
     6770       ,input  0
     6771       ,input  0
     6772       ,input  0
     6773       ,input  true
     6774       ,output glog
     6775       )  .
     6776   end.
     6777         end.
     6778         when 'возврат':U
     6779         then do:
     6780   define variable vss-include-info59 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6781   do:
     6782     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6783       (input  v-cntxt-db-num
     6784       ,input  v-cntxt-userid
     6785       ,input  0
     6786       ,input  'actn_return_print':U
     6787       ,input  'object':U
     6788       ,input  buf_trn-doc.host-code
     6789       ,input  buf_trn-doc.obj-type
     6790       ,input  buf_trn-doc.obj-code
     6791       ,input  0
     6792       ,input  0
     6793       ,input  0
     6794       ,input  true
     6795       ,output glog
     6796       )  .
     6797   end.
     6798         end.
     6799         otherwise do:
     6800           message
     6801             vss-workfile vss-revision vss-description skip
     6802             "Неизвестный тип документа" skip
     6803             "Тип документа" buf_trn-doc.doc-type skip
     6804             "Код документа" buf_trn-doc.doc-code skip
     6805             view-as alert-box error .
     6806           undo, return error return-value .
     6807         end.
     6808       end case .
     6809       if not glog then return error.
     6810       define buffer buf1_trn-doc for ub.trn-doc  .
     6811       define variable v-spis-recid as character no-undo .
     6812       v-spis-recid = "".
     6813       for each doc-list :
     6814           find first buf1_trn-doc no-lock  where buf1_trn-doc.doc-code = doc-list.doc-code no-error .
     6815           v-spis-recid = v-spis-recid + string(recid (buf1_trn-doc)) + "," .
     6816       end.
     6817       run rep/doc-prn.p (
     6818             input parparentproc
     6819           , input ?
     6820           , input v-spis-recid
     6821       ).
     6822     end.
     6823   end.
     6824   choice = ?.
     6825   end.
     6826   END PROCEDURE.
     6827   PROCEDURE proc-ex-print :
     6828     do
     6829     on error undo, return error return-value
     6830     :
     6831       run str/doc-xls.p ( input parparentproc, input p-curr-obj-type, input p-curr-obj-code) .
     6832     end.
     6833   END PROCEDURE.
     6834   procedure proc-file-list-methods :
     6835   define input parameter p-from-macro as logical no-undo .
     6836   define input parameter rs-list-method as character no-undo .
     6837   define input parameter rs-status as character no-undo .
     6838   define input parameter line-mode as character no-undo .
     6839   define input parameter p-id      as integer no-undo .
     6840   define variable ss as character no-undo .
     6841   define variable b-c as integer no-undo.
     6842   define variable imp-art like ub.goods.artic no-undo .
     6843   define variable imp-type like ub.goods.prod-type no-undo.
     6844   define variable imp-code like ub.goods.prod-code no-undo.
     6845   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     6846   define variable imp-doc-type as character no-undo.
     6847   define variable v-full-path        as character no-undo .
     6848   define variable v-path             as character no-undo .
     6849   define variable v-file-name        as character no-undo .
     6850   define variable v-file-name-no-ext as character no-undo .
     6851   define variable v-file-name-ext    as character no-undo .
     6852   define buffer buf_doc-list-hist for doc-list-hist.
     6853   do
     6854   on error undo, return error
     6855   :
     6856     find first buf_doc-list-hist where
     6857               buf_doc-list-hist.id = p-id
     6858           AND buf_doc-list-hist.item_ <> '':U .
     6859     run gbl/filename.p
     6860       (input  buf_doc-list-hist.item_
     6861       ,output v-full-path
     6862       ,output v-path
     6863       ,output v-file-name
     6864       ,output v-file-name-no-ext
     6865       ,output v-file-name-ext
     6866       ) no-error .
     6867     if error-status:error then do: end. else do:
     6868       input stream sout from value (v-full-path).
     6869       CASE rs-list-method:
     6870         when "cli-list-trn-doc" then do:
     6871           repeat:
     6872             import stream sout imp-type imp-code no-error.
     6873             for each ub.trn-doc where ub.trn-doc.cli-type = imp-type
     6874                               and ub.trn-doc.cli-code = imp-code no-lock:
     6875                 run ex-doc in this-procedure(input 1, input rs-list-method, input rs-status, input line-mode)  .
     6876             end.
     6877           end.
     6878         end.
     6879         when "trn-gds-list" or
     6880         when "price-gds-list" then do:
     6881           define variable v-doc-code as character no-undo .
     6882         repeat:
     6883           import stream sout  imp-type imp-code imp-art no-error.
     6884           if rs-list-method = "price-gds-list" then do:
     6885             for each ub.price-list No-LOCK WHERE
     6886                       ub.price-list.artic = imp-art
     6887                   AND ub.price-list.prod-type = imp-type
     6888                   AND ub.price-list.prod-code = imp-code
     6889                   and ub.price-list.main-price = yes:
     6890               if ub.price-list.doc-num <> v-doc-code then do:
     6891                 find first ub.price-doc no-lock where
     6892                             ub.price-doc.doc-num = ub.price-list.doc-num no-error.
     6893                 if avail ub.price-doc then do:
     6894                   run ex-doc in this-procedure(input 0, input rs-list-method, input rs-status, input line-mode) .
     6895                 end.
     6896                 v-doc-code = ub.price-list.doc-num.
     6897               end.
     6898             end.
     6899           end.
     6900           else do:
     6901             for each ub.db no-lock,
     6902                 each ub.clients no-lock where
     6903                     ub.clients.db-num = ub.db.db-num,
     6904                each ub.doc-line No-LOCK WHERE
     6905                       ub.doc-line.artic = imp-art
     6906                   AND ub.doc-line.prod-type = imp-type
     6907                   AND ub.doc-line.prod-code = imp-code
     6908                   and ub.doc-line.obj-type = ub.clients.obj-type
     6909                   and ub.doc-line.obj-code = ub.clients.obj-code:
     6910                if ub.doc-line.doc-code <> v-doc-code then do:
     6911                 find first ub.trn-doc no-lock where
     6912                           ub.trn-doc.doc-code = ub.doc-line.doc-code no-error.
     6913                 if avail ub.trn-doc then do:
     6914                   run ex-doc in this-procedure(input 1, input rs-list-method, input rs-status, input line-mode) .
     6915                 end.
     6916                 v-doc-code = ub.doc-line.doc-code.
     6917               end.
     6918             end.
     6919           end.
     6920         end.
     6921         end.
     6922         when "file" then do:
     6923           repeat:
     6924             import stream sout imp-doc-code imp-doc-type no-error.
     6925             CASE imp-doc-type:
     6926               when 'переоценка':U then do:
     6927                 find first ub.price-doc no-lock where
     6928                           ub.price-doc.doc-num = imp-doc-code No-error.
     6929                 if available ub.price-doc then run ex-doc in this-procedure (input 0, input rs-list-method, input rs-status, input line-mode).
     6930               end.
     6931               when 'касс':U then do:
     6932                 find first ub.inkas no-lock where
     6933                           ub.inkas.inkas-code = imp-doc-code No-error.
     6934                 if available ub.inkas then run ex-doc in this-procedure (input 2, input rs-list-method, input rs-status, input line-mode).
     6935               end.
     6936               when "-" + 'касс':U then do:
     6937                 find first ub.c-inkas no-lock where
     6938                           ub.c-inkas.inkas-code = imp-doc-code No-error.
     6939                 if available ub.c-inkas then run ex-doc in this-procedure (input 102, input rs-list-method, input rs-status, input line-mode).
     6940               end.
     6941               when 'производство':U then do:
     6942                 find first ub.fbr-doc no-lock where
     6943                           ub.fbr-doc.doc-code = imp-doc-code No-error.
     6944                 if available ub.fbr-doc then run ex-doc in this-procedure (input 3, input rs-list-method, input rs-status, input line-mode).
     6945               end.
     6946               otherwise do:
     6947                 if lookup(imp-doc-type, 'ОФ,ФП,ОП,ОО,ОР,ПО') > 0 then do:
     6948                   find first ub.ord-doc no-lock where
     6949                             ub.ord-doc.doc-code = imp-doc-code No-error.
     6950                   if available ub.ord-doc then run ex-doc in this-procedure (input 4, input rs-list-method, input rs-status, input line-mode).
     6951                 end.
     6952                 else do:
     6953                   if imp-doc-type begins "-" then do:
     6954                     find first ub.c-trn-doc no-lock where
     6955                               ub.c-trn-doc.doc-code = imp-doc-code No-error.
     6956                     if available ub.trn-doc then run ex-doc in this-procedure (input 101, input rs-list-method, input rs-status, input line-mode).
     6957                   end.
     6958                   else do:
     6959                 find first ub.trn-doc no-lock where
     6960                           ub.trn-doc.doc-code = imp-doc-code No-error.
     6961                 if available ub.trn-doc then run ex-doc in this-procedure (input 1, input rs-list-method, input rs-status, input line-mode).
     6962               end.
     6963                 end.
     6964               end.
     6965             END CASE.
     6966           end.
     6967         end.
     6968       END CASE.
     6969       input stream sout close.
     6970       assign                                                           buf_doc-list-hist.num-add  = lns-cnt - v-num-add                       buf_doc-list-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_doc-list-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_doc-list-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     6971     end.
     6972   end.
     6973   end procedure.
     6974   PROCEDURE proc-find :
     6975   define input parameter loc-find as character no-undo.
     6976   case loc-find:
     6977     when "doc-code":U then do:
     6978       if last-event:label = "Ctrl-J" then
     6979           find next l-doc-list no-lock where
     6980                      l-doc-list.doc-code begins sch-code no-error.
     6981       else
     6982           find first l-doc-list no-lock where
     6983                      l-doc-list.doc-code begins sch-code no-error.
     6984     end.
     6985     when "fact-date":U then do:
     6986       if last-event:label = "Ctrl-J" then
     6987           find next l-doc-list no-lock where
     6988                      l-doc-list.fact-date = sch-date no-error.
     6989       else
     6990           find first l-doc-list no-lock where
     6991                      l-doc-list.fact-date = sch-date no-error.
     6992     end.
     6993   end case.
     6994   if available l-doc-list then do:
     6995     line-rec = recid (l-doc-list).
     6996     reposition br-list to recid line-rec no-error.
     6997     apply "value-changed" to br-list in frame Dialog-Frame.
     6998   end.
     6999   else do:
     7000     message
     7001     "Строка не найдена."
     7002     view-as alert-box error.
     7003   end.
     7004   END PROCEDURE.
     7005   procedure proc-macros :
     7006   define variable glog as logical no-undo .
     7007   define variable v-option as integer no-undo .
     7008   define buffer buf_doc-list-hist for doc-list-hist.
     7009   define buffer buf_macro-list-hist for macro-list-hist.
     7010   if can-find(first macro-list-hist) then do:
     7011     run gbl/d-askw.w ( input "Сохранение макроса"
     7012                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
     7013                   ,input "|"
     7014                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
     7015                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
     7016                   ,input 1
     7017                   ,input 3
     7018                   ,output v-option).
     7019     if v-option = 3 then return no-apply.
     7020     v-option = 1.
     7021   end.
     7022   else do:
     7023     message
     7024     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
     7025     view-as alert-box question buttons yes-no update glog.
     7026     v-option = 2.
     7027     if not glog then do:
     7028       return no-apply.
     7029     end.
     7030   end.
     7031   do
     7032   on error undo, return error
     7033   :
     7034     assign
     7035     f-name = "default.trm"
     7036     glog = yes
     7037     .
     7038     system-dialog get-file f-name
     7039     filters "Макрос создания списка документов *.trm" "*.trm"
     7040     ask-overwrite
     7041     save-as
     7042     use-filename
     7043     update glog
     7044     default-extension "trm".
     7045     if not glog then do:
     7046       apply "entry" to br-list in frame Dialog-Frame.
     7047       return no-apply.
     7048     end.
     7049     run waitfram-show in this-procedure ("Сохранение макроса формирования списка документов.    ЖДИТЕ...").
     7050     output stream PrnLibStream to value (f-name).
     7051     case v-option:
     7052       when 1 then do:
     7053         for each buf_macro-list-hist:
     7054           export stream PrnLibStream
     7055           buf_macro-list-hist.
     7056         end.
     7057       end.
     7058       when 2 then do:
     7059     for each buf_doc-list-hist:
     7060         export stream PrnLibStream
     7061         buf_doc-list-hist.
     7062     end.
     7063       end.
     7064     end case.
     7065     output stream PrnLibStream close.
     7066     run waitfram-hide in this-procedure .
     7067   end.
     7068   end procedure.
     7069   PROCEDURE proc-vc-rs-list-method :
     7070   define variable v-operation as integer no-undo .
     7071   define variable ii as integer no-undo.
