     3111   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     3112   DO:
     3113     if choice = ? then do:
     3114       run gbl/pop-up.p (self:handle, no) no-error.
     3115       if error-status:error then return no-apply.
     3116     end.
     3117   END.
     3118   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     3119   DO:
     3120       if save-option = "" then do:
     3121          run gbl/pop-up.p (self:handle, no) no-error.
     3122      end.
     3123      run proc-b-save in this-procedure (save-option) no-error.
     3124      if error-status:error then return no-apply.
     3125   END.
     3126   ON CHOOSE OF b-up IN FRAME Dialog-Frame
     3127   DO:
     3128     define buffer buf_prev_doc-list for doc-list .
     3129     if available doc-list
     3130     then do:
     3131       find last buf_prev_doc-list
     3132         where buf_prev_doc-list.sel-order < doc-list.sel-order
     3133         use-index sel-order
     3134         no-error .
     3135       if not available buf_prev_doc-list
     3136       then do:
     3137         message
     3138           "Текущий документ первый в списке"
     3139           view-as alert-box information .
     3140       end.
     3141       else do:
     3142         define variable v-current-sel-order as integer   no-undo .
     3143         assign
     3144           v-current-sel-order    = doc-list.sel-order
     3145           doc-list.sel-order          = buf_prev_doc-list.sel-order
     3146           buf_prev_doc-list.sel-order = v-current-sel-order
     3147         .
     3148         define variable v-current-rowid as rowid no-undo .
     3149         assign
     3150           v-current-rowid = rowid(doc-list)
     3151         .
     3152         run openbr in this-procedure .
     3153         reposition br-list to rowid v-current-rowid no-error .
     3154       end.
     3155     end.
     3156     else do:
     3157       message
     3158         "Документ не выбран" skip
     3159         view-as alert-box information .
     3160     end.
     3161   END.
