     2603   DEFine VARiable RS-list-method AS CHARACTER.
     2604   define variable lns-ignore as integer no-undo .
     2605   define variable save-option as character no-undo.
     2606   define variable dcli-type like ub.trn-doc.cli-type no-undo.
     2607   define variable dcli-code like ub.trn-doc.cli-code no-undo.
     2608   define variable dcli-name like ub.clients.obj-name no-undo.
     2609   define variable ddoc-PS like ub.clients.obj-name no-undo.
     2610   define variable rs-status as character no-undo .
     2611   define variable line-mode as character no-undo .
     2612   define variable lns-cnt as integer no-undo .
     2613   define variable v-num-add          as integer no-undo .
     2614   define variable v-num-ignored      as integer no-undo .
     2615   define variable line-rec as recid no-undo .
     2616   define variable vsort as integer   no-undo .
     2617   define variable v-docs-all as logical no-undo .
     2618   define variable v-docs-cmp as logical no-undo .
     2619   define new shared variable br-handle as handle no-undo.
     2620   define new shared buffer f-doc for ub.fbr-doc.
     2621   DEFINE new shared QUERY br-docs FOR f-doc SCROLLING.
     2622   define variable f-name as char init "default.trn" no-undo.
     2623   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2624   define  new shared  temp-table macro-list-hist no-undo
     2625   field list-table as character
     2626   field id as integer
     2627   field line as integer
     2628   field hist-mode as character
     2629   field des as character
     2630   field num-recs as integer
     2631   field option_ as character
     2632   field item_ as character
     2633   field status_ as character
     2634   field num-add as integer
     2635   field num-ignored as integer
     2636   field done as logical
     2637   field err_ as logical
     2638   field err-mes as character
     2639   index pi is primary
     2640   id
     2641   line
     2642   index isdone
     2643   done
     2644   .
     2645   FUNCTION get-table-name returns character(input p-doc-type as character):
     2646   CASE p-doc-type:
     2647     when 'переоценка':U then return 'price-doc':U.
     2648     when 'производство':U then return 'fbr-doc':U.
     2649     when 'касс':U then return 'inkas':U.
     2650     when ("-" + 'касс':U) then return 'c-inkas':U.
     2651     otherwise do:
     2652      if lookup(p-doc-type, 'ОФ,ФП,ОП,ОО,ОР,ПО') > 0 then return 'ord-doc':U.
     2653      if p-doc-type begins "-"
     2654      and lookup(entry(2, p-doc-type), 'ОФ,ФП,ОП,ОО,ОР,ПО') > 0 then return 'c-ord-doc':U.
     2655      if p-doc-type begins "-" then return 'c-trn-doc':U.
     2656      return 'trn-doc':U.
     2657     end.
     2658   END CASE.
     2659   END FUNCTION.
     2660   FUNCTION get-client RETURNS CHARACTER
     2661     ( input loc-doc-code as character,
     2662       input loc-doc-type as character)  FORWARD.
     2663   DEFINE MENU MENU-B-print
     2664          MENU-ITEM m_main-print   LABEL "Простой формат"
     2665          MENU-ITEM m_doc-print    LABEL "Печать документов"
     2666          MENU-ITEM m_ex-print     LABEL "По шаблону в EXCEL".
     2667   DEFINE MENU MENU-B-save
     2668          MENU-ITEM m_doc-save     LABEL "Файл списка документов"
     2669          MENU-ITEM m_xls-save     LABEL "Таблица EXCEL"
     2670          MENU-ITEM m-title-save   LABEL "Имя списка"
     2671          MENU-ITEM m-macros-save  LABEL "Макрос формирования списка"
     2672          RULE
     2673          MENU-ITEM m-rum           LABEL "Операции над списком" .
     2674   DEFINE BUTTON B-add
     2675        LABEL "&+Доб. строку"
     2676        SIZE 15 BY 1 TOOLTIP "Добавление в список документов 1 строки".
     2677   DEFINE BUTTON B-clear-macro
     2678        IMAGE-UP FILE "cmp/fstop.bmp":U
     2679        IMAGE-DOWN FILE "cmp/fstopi.bmp":U
     2680        IMAGE-INSENSITIVE FILE "cmp/fstopi.bmp":U
     2681        LABEL "&[ ]"
     2682        SIZE 4 BY 1.25 TOOLTIP "Удаление макроса формирования истории из памяти".
     2683   DEFINE BUTTON B-clr
     2684        LABEL "Очи&стить"
     2685        SIZE 10 BY 1 TOOLTIP "Удалить из списка все документы (строки)".
     2686   DEFINE BUTTON B-del
     2687        LABEL "&-Удал. строку"
     2688        SIZE 15 BY 1 TOOLTIP "Удаление из списка документов 1 строки".
     2689   DEFINE BUTTON b-down
     2690        IMAGE-UP FILE "btn-down-arrow":U
     2691        IMAGE-DOWN FILE "btn-down-arrow":U
     2692        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     2693        LABEL ""
     2694        SIZE 3 BY 1 TOOLTIP "Переместить документ вниз".
     2695   DEFINE BUTTON B-exit AUTO-GO
     2696        LABEL "&Выход"
     2697        SIZE 10 BY 1
     2698        BGCOLOR 8 .
     2699   DEFINE BUTTON B-Help
     2700        LABEL "Помо&щь"
     2701        SIZE 10 BY 1
     2702        BGCOLOR 8 .
     2703   DEFINE BUTTON B-hist
     2704        LABEL "Ис&тория"
     2705        SIZE 10 BY 1 TOOLTIP "Последовательность шагов, приведшая к заполнению данного списка".
     2706   DEFINE BUTTON B-macro
     2707        IMAGE-UP FILE "cmp/run.bmp":U
     2708        IMAGE-DOWN FILE "cmp/runi.bmp":U
     2709        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
     2710        LABEL "&>"
     2711        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
     2712   DEFINE BUTTON B-lkp
     2713        LABEL "&Просмотр"
     2714        SIZE 10 BY 1 TOOLTIP "Просмотр текущего документа".
     2715   DEFINE BUTTON B-print
     2716        LABEL "Пе&чать"
     2717        SIZE 10 BY 1 TOOLTIP "Просмотр текущего документа".
     2718   DEFINE BUTTON B-record
     2719        IMAGE-UP FILE "cmp/record.bmp":U
     2720        IMAGE-DOWN FILE "cmp/recordi.bmp":U
     2721        IMAGE-INSENSITIVE FILE "cmp/recordi.bmp":U
     2722        LABEL "&o"
     2723        SIZE 4 BY 1.25 TOOLTIP "Запись макроса формирования истории".
     2724   DEFINE BUTTON B-rest
     2725        LABEL "&*Остав. строку"
     2726        SIZE 15 BY 1 TOOLTIP "Оставить в списке документов только текущую строку".
     2727   DEFINE BUTTON B-save
     2728        LABEL "Со&хр./Выполн."
     2729        SIZE 15 BY 1 TOOLTIP "Сохранить список документов в текстовом файле, EXCEL".
     2730   DEFINE BUTTON B-stop
     2731        IMAGE-UP FILE "cmp/stop.bmp":U
     2732        IMAGE-DOWN FILE "cmp/stopi.bmp":U
     2733        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
     2734        LABEL "&[ ]"
     2735        SIZE 4 BY 1.25 TOOLTIP "Конец записи макроса формирования истории".
     2736   DEFINE BUTTON b-up
     2737        IMAGE-UP FILE "btn-up-arrow":U
     2738        IMAGE-DOWN FILE "btn-up-arrow":U
     2739        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
     2740        LABEL ""
     2741        SIZE 3 BY 1 TOOLTIP "Переместить документ вверх".
     2742   DEFINE VARIABLE ED-notes AS CHARACTER
     2743        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2744        SIZE 70 BY 1.54 NO-UNDO.
     2745   DEFINE VARIABLE dsp-rs AS CHARACTER FORMAT "X(256)":U
     2746         VIEW-AS TEXT
     2747        SIZE 75.5 BY 1
     2748        FGCOLOR 4  NO-UNDO.
     2749   DEFINE VARIABLE f-tot-lns AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     2750         VIEW-AS TEXT
     2751        SIZE 10 BY .71 TOOLTIP "Кол. строк"
     2752        FGCOLOR 4  NO-UNDO.
     2753   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(256)":U
     2754        LABEL "Начало №"
     2755        VIEW-AS FILL-IN
     2756        SIZE 16 BY 1 NO-UNDO.
     2757   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     2758        LABEL "Факт. дата"
     2759        VIEW-AS FILL-IN
     2760        SIZE 12 BY 1 NO-UNDO.
     2761   DEFINE QUERY BR-list FOR
     2762         doc-list SCROLLING.
     2763   DEFINE QUERY BR-option FOR
     2764         temp-list SCROLLING.
     2765   DEFINE BROWSE BR-list
     2766     QUERY BR-list DISPLAY
     2767         doc-list.doc-code COLUMN-LABEL "Документ" FORMAT "X(14)":U
     2768         doc-list.obj-type FORMAT "X(3)":U
     2769         doc-list.obj-code FORMAT "99999":U
     2770         doc-list.fact-date COLUMN-LABEL "Дата факт" FORMAT "99/99/9999":U
     2771         doc-list.shift-date COLUMN-LABEL "Дата смены" FORMAT "99/99/9999":U
     2772         shift-name-no-err(buffer doc-list) COLUMN-LABEL "№ смены" FORMAT "X(6)":U
     2773         doc-list.doc-type COLUMN-LABEL "Тип док-та" FORMAT "X(10)":U
     2774         get-client(input doc-list.doc-code, input doc-list.doc-type) + string(dcli-code) COLUMN-LABEL "Контрагент" FORMAT "X(12)":U
     2775         dcli-name COLUMN-LABEL "Название контрагента" FORMAT "X(40)":U
     2776         doc-list.sel-order COLUMN-LABEL "Пор.Номер" FORMAT ">>>,>>>,>>9":U
     2777         doc-list.is-del COLUMN-LABEL "У" FORMAT "+/":U
     2778       WITH NO-ROW-MARKERS SEPARATORS SIZE 70 BY 16.13.
     2779   DEFINE BROWSE BR-option
     2780     QUERY BR-option DISPLAY
     2781         temp-list.fname format "X(30)"
     2782       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 28 BY 21 TOOLTIP "Условие для выбора документов, которые будут добавлены/удалены/оставлены".
     2783   DEFINE FRAME Dialog-Frame
     2784        dsp-rs AT ROW 1 COL 1 NO-LABEL
     2785        B-hist AT ROW 1 COL 31
     2786        B-Help AT ROW 1 COL 61
     2787        B-exit AT ROW 2 COL 1
     2788        B-save AT ROW 2 COL 11
     2789        B-print AT ROW 2 COL 21
     2790        B-lkp AT ROW 2 COL 41
     2791        B-clr AT ROW 2 COL 51
     2792        B-macro AT ROW 2 COL 61
     2793        B-stop AT ROW 2 COL 65
     2794        B-clear-macro AT ROW 2 COL 65
     2795        B-record AT ROW 2 COL 65
     2796        BR-option AT ROW 2 COL 72
     2797        B-add AT ROW 3 COL 11
     2798        B-del AT ROW 3 COL 26
     2799        B-rest AT ROW 3 COL 41
     2800        BR-list AT ROW 4.21 COL 1.25
     2801        f-tot-lns AT ROW 3.5 COL 60 COLON-ALIGNED NO-LABEL
     2802        sch-code AT ROW 20.5 COL 2.63
     2803        sch-date AT ROW 20.5 COL 46.38 COLON-ALIGNED
     2804        b-up AT ROW 20.5 COL 66
     2805        b-down AT ROW 20.5 COL 71
     2806        ED-notes AT ROW 21.54 COL 1 NO-LABEL
     2807        SPACE(21.36) SKIP(0.04)
     2808       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2809            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2810            TITLE "Список документов"
     2811            DEFAULT-BUTTON B-exit.
     2812   ASSIGN
     2813          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2814          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2815   ASSIGN
     2816          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     2817   ASSIGN
     2818          B-save:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-save:HANDLE.
     2819   ASSIGN
     2820          ED-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2821   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2822   DO:
     2823     APPLY "END-ERROR":U TO SELF.
     2824   END.
     2825   ON CHOOSE OF B-clr IN FRAME Dialog-Frame
     2826   DO:
     2827   define variable glog as logical no-undo .
     2828   define buffer buf-doc-list-hist for doc-list-hist.
     2829   message
     2830   "Удаление всех строк списка. Вы уверены ?"
     2831    view-as alert-box question buttons OK-Cancel update glog.
     2832   if not glog then return no-apply.
     2833   if session:set-wait-state( "COMPILER" )  then .
     2834   for each doc-list:
     2835     delete doc-list.
     2836   end.
     2837   if session:set-wait-state( "" )  then .
     2838   tot-lns = 0.
     2839   v-seq = 1.
     2840   for each buf-doc-list-hist:
     2841     delete buf-doc-list-hist.
     2842   end.
     2843   run create-doc-list-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     2844                                        , input-output v-seq
     2845                                        , input 0
     2846                                        , input '':U
     2847                                        , input '0':U
     2848                                        , input "# Список документов очищен."
     2849                                        , input 0
     2850                                        , input "clear"
     2851                                        , input '':U
     2852                                        , input '':U
     2853                                        , input '':U
     2854                                        , input ?
     2855                                        ).
     2856   ed-notes:screen-value = ''.
     2857   display
     2858   tot-lns @ f-tot-lns
     2859   with frame Dialog-Frame.
     2860   run MyEnable in this-procedure .
     2861   END.
     2862   ON CHOOSE OF b-down IN FRAME Dialog-Frame
     2863   DO:
     2864     define buffer buf_prev_doc-list for doc-list .
     2865     if available doc-list
     2866     then do:
     2867       find first buf_prev_doc-list
     2868         where buf_prev_doc-list.sel-order > doc-list.sel-order
     2869         use-index sel-order
     2870         no-error .
     2871       if not available buf_prev_doc-list
     2872       then do:
     2873         message
     2874           "Текущий документ последний в списке"
     2875           view-as alert-box information .
     2876       end.
     2877       else do:
     2878         define variable v-current-sel-order as integer   no-undo .
     2879         assign
     2880           v-current-sel-order    = doc-list.sel-order
     2881           doc-list.sel-order          = buf_prev_doc-list.sel-order
     2882           buf_prev_doc-list.sel-order = v-current-sel-order
     2883         .
     2884         define variable v-current-rowid as rowid no-undo .
     2885         assign
     2886           v-current-rowid = rowid(doc-list)
     2887         .
     2888         run openbr in this-procedure .
     2889         reposition br-list to rowid v-current-rowid no-error .
     2890       end.
     2891     end.
     2892     else do:
     2893       message
     2894         "Документ не выбран" skip
     2895         view-as alert-box information .
     2896     end.
     2897   END.
     2898   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     2899   DO:
     2900   define buffer buf_doc-list-hist for doc-list-hist.
     2901   run prn-lib-open-stream  in this-procedure (
     2902                                                input parParentProc
     2903                                               ,input 43
     2904                                               ,input yes
     2905                                               ,input no
     2906                                               ).
     2907   find first buf_doc-list-hist no-lock where buf_doc-list-hist.id = 0 no-error .
     2908   PUT  STREAM PrnLibStream unformatted
     2909   SPACE(25) "История создания списка документов "
     2910   (if available buf_doc-list-hist
     2911   then buf_doc-list-hist.des
     2912   else "БЕЗЫМЯННЫЙ") skip(0)
     2913   space(25) cur-time-print() skip(1)
     2914   .
     2915   put stream PrnLibStream unformatted
     2916   string("№", "X(9)") chr(32)
     2917   string("Действие", "X(9)") chr(32)
     2918   string("записей", "X(9)") chr(32)
     2919   string(" = итого", "X(12)") chr(32)
     2920   string("Множество", "X(155)")
     2921   skip(0)
     2922   fill('-':U, 9) chr(32)
     2923   fill('-':U, 9) chr(32)
     2924   fill('-':U, 9) chr(32)
     2925   fill('-':U, 12) chr(32)
     2926   fill('-':U, 155)
     2927   skip(0)
     2928   .
     2929   for each buf_doc-list-hist where buf_doc-list-hist.id > 0
     2930   by buf_doc-list-hist.id
     2931   :
     2932     put stream PrnLibStream unformatted
     2933     (if buf_doc-list-hist.line = 0
     2934      then string(buf_doc-list-hist.id, ">>>>>>>>9")
     2935      else fill(chr(32) , 9)
     2936     )  chr(32)
     2937     (if buf_doc-list-hist.item_ <> '':U
     2938      then string(buf_doc-list-hist.hist-mode, "X(8)")
     2939      else fill( chr(32), 8)) chr(32)
     2940     string(buf_doc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     2941     string(buf_doc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     2942     string(buf_doc-list-hist.des, "X(155)") skip.
     2943   end.
     2944   output stream prnlibstream close.
     2945     run prn-lib-prn-file in this-procedure (
     2946                                               input parParentProc
     2947                                               ,input 8
     2948                                               ).
     2949    apply "entry" to br-list in frame Dialog-Frame.
     2950   END.
     2951   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     2952   DO:
     2953   define variable glog as logical no-undo .
     2954   define variable v-doc-rec as recid no-undo .
     2955   define variable v-host-code as integer no-undo .
     2956   define variable v-fbr-doc-next-prev as logical no-undo .
     2957   define buffer buf_fbr-doc for ub.fbr-doc.
     2958   define buffer buf_inkas for ub.inkas.
     2959   define buffer buf_c-trn-doc for ub.c-trn-doc.
     2960   define buffer buf_ord-doc for ub.ord-doc.
     2961    if not available doc-list then do:
     2962     message "Неправильно выбран документ."
     2963             view-as alert-box error.
     2964     return no-apply.
     2965    end.
     2966    CASE doc-list.doc-type:
     2967      when 'производство':U then do:
     2968   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2969   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2970     (input  doc-list.obj-type
     2971     ,input  doc-list.obj-code
     2972     ,output v-host-code
     2973     )  .
     2974   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
