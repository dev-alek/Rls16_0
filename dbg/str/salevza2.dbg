      809   sale-sum descending
      810   .
      811   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   DEFINE NEW SHARED TEMP-TABLE treal-3 no-undo
      814   FIELD gds-code like ub.goods.gds-code
      815   FIELD cpay-code as integer
      816   FIELD curr-code as integer
      817   FIELD qnty1 as decimal
      818   FIELD netto as decimal
      819   FIELD out-name as character format "X(20)"
      820   FIELD is-pay as logical
      821   FIELD ii as integer
      822   FIELD netto-rubl as decimal
      823   FIELD rest-qnty as decimal
      824   FIELD src-code like ub.chk-gds.src-code
