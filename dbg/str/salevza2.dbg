      835   .
      836   main-block:
      837   do
      838   on error undo, return error
      839   :
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      842     (output v-curr-r-b
      843     )  .
      844     if p-mode = "work" then do:
      845       do transaction
      846       on error undo main-block, return error
      847       :
      848         find first buf_inkas exclusive-lock where
      849                     buf_inkas.inkas-code = p-inkas-code no-wait no-error .
      850         IF NOT AVAILABLE buf_inkas
      851         AND NOT LOCKED buf_inkas THEN DO:
      852           message
      853           vss-workfile vss-revision vss-description skip
      854           "Неправильный выбор кассового отчета."
      855           view-as alert-box WARNING .
      856           UNDO main-block, RETURN ERROR.
      857         END.
      858         IF LOCKED buf_inkas THEN DO:
      859             MESSAGE
      860             SUBSTITUTE("В настоящее время занята запись ОТЧЕТА ПРОДАЖИ &1"
      861                       , p-inkas-code
      862                       )
      863           VIEW-AS ALERT-BOX ERROR.
      864           UNDO main-block, RETURN ERROR.
      865         END.
      866       end.
      867     end.
      868     else do:
      869       find first buf_inkas no-lock where
      870                   buf_inkas.inkas-code = p-inkas-code no-error .
      871       if NOT available buf_inkas then do:
      872         message
      873         vss-workfile vss-revision vss-description skip
      874         "Неправильный выбор кассового отчета."
      875         view-as alert-box WARNING .
      876         return error .
      877       end.
      878     end.
      879   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
      881     (input  buf_inkas.host-code
      882     ,output v-r-b-abbr
      883     )  .
      884     find first buf_shop no-lock where
      885               buf_shop.obj-code = buf_inkas.obj-code no-error .
      886     if not available buf_shop then do:
      887       message
      888       vss-workfile vss-revision vss-description skip
      889       "Не найден объекта для кассового отчета." p-inkas-code
      890       view-as alert-box WARNING .
      891       return error .
      892     end.
      893     find first buf_clients no-lock where
      894               buf_clients.obj-type = 'маг':U
      895           AND buf_clients.obj-code = buf_shop.obj-code no-error .
      896     find first buf_trn-doc no-lock where
      897               buf_trn-doc.doc-code = buf_inkas.inkas-code.
      898     IF  can-find (first ub.gds-dtl no-lock where
      899                           ub.gds-dtl.doc-code = buf_trn-doc.doc-code
      900                       AND ub.gds-dtl.doc-qnty <> ub.gds-dtl.fact-qnty USE-INDEX pi)
      901     then do:
      902       message
      903       "Не все товары в расходной части продажи зарезервированы" skip
      904       "Печать отчета невозможна"
      905       view-as alert-box ERROR.
      906       return .
      907     end.
      908     run cre-sj in this-procedure (
      909                                    input v-curr-r-b
      910                                  , buf_inkas.inkas-code
      911                                  , input 0
      912                                  , input "":U
      913                                  , input "":U
      914                                  , input 0
      915                                  , input ?
      916                                  , input ?
      917                                    ).
      918     run process-inkas in this-procedure (buffer buf_inkas, (if p-mode <> "export" then yes else no), output v-z-number, output v-pay-desk).
      919     CASE p-mode:
      920       when  "print" then do:
      921         run process-two-tables in this-procedure (0, ?)  .
      922         run proc-print in this-procedure .
      923       end.
      924       when "work" then do:
      925         run process-two-tables in this-procedure (0, ?).
      926         run str/salevzaw.w (
      927                          input parparentproc
      928                         ,buffer buf_inkas
      929                         ,input this-procedure
      930                         ,input (if buf_Inkas.status_ <> 'факт':U then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U)
      931                         ,input "":U
      932                         ,input-output v-rec-list
      933                         ) no-error .
      934       end.
      935       when  "export" then do:
      936         run proc-export in this-procedure(buffer buf_inkas, input v-z-number, input v-pay-desk) .
      937       end.
      938     END CASE.
      939   end.
      940   procedure cre-sj :
      941   define input parameter p-curr-r-b as character no-undo .
      942   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      943   define input parameter p-gds-code   like ub.goods.gds-code no-undo.
      944   define input parameter p-artic      like ub.goods.artic no-undo.
      945   define input parameter p-prod-type  like ub.goods.prod-type no-undo.
      946   define input parameter p-prod-code  like ub.goods.prod-code no-undo.
      947   define input parameter p-is-out     as logical              no-undo .
      948   define input parameter p-doc-line-rec as recid no-undo.
      949   define variable v-b-code like ub.bar-code.b-code no-undo .
      950   define variable v-price-sale      like ub.price-list.price-sale no-undo.
      951   define variable v-price-sale-calc like ub.price-list.price-sale no-undo.
      952   define variable v-price-base      like ub.price-list.price-sale no-undo.
      953   define variable v-price-rubl      like ub.price-list.price-sale no-undo.
      954   define variable v-price-flag       as logical no-undo .
      955   define variable sale_sum_r-b     as decimal no-undo .
      956   define variable v-price-netto    as decimal no-undo .
      957   define variable my-accum          as integer no-undo .
      958   define variable v-var-purch       as integer no-undo .
      959   define variable v-is-out          as logical no-undo .
      960   define buffer buf_trn for ub.trn-doc.
      961   define buffer buf_doc-line for ub.doc-line.
      962   define buffer buf_gds-dtl for ub.gds-dtl.
      963   define buffer buf_parts for ub.parts.
      964   define buffer buf_goods for ub.goods.
      965   define buffer buf_sj-goods for sj-goods.
      966   define buffer sj-goods0 for sj-goods.
      967   define buffer sj-goods00 for sj-goods.
      968   define buffer sj-goods01v for sj-goods.
      969   define buffer sj-goods02v for sj-goods.
      970   define buffer sj-goods01r for sj-goods.
      971   define buffer sj-goods02r for sj-goods.
      972   define buffer buf_clients for ub.clients.
      973     do
      974     on error undo, return error
      975     :
      976       find first buf_trn no-lock where
      977                 buf_trn.doc-code = p-inkas-code no-error .
      978       if not available buf_trn then do:
      979         undo, return error substitute("Не найдена расходная часть для кассового отчета &1", p-inkas-code).
      980       end.
      981       if p-gds-code = 0 then do:
      982         for each sj-goods:
      983           delete sj-goods.
      984         end.
      985         create sj-goods00.
      986         assign
      987         sj-goods00.gds-code = 0
      988         sj-goods00.var-purch = 0
      989         sj-goods00.prod-type = "":U
      990         sj-goods00.prod-code = 0
      991         sj-goods00.artic     = "":U
      992         sj-goods00.gds-name = "ИТОГО по всем вариантам закупки"
      993         sj-goods00.is-out  = ?
      994         .
      995         create sj-goods01r.
      996         assign
      997         sj-goods01r.gds-code = 0
      998         sj-goods01r.var-purch = 1
      999         sj-goods01r.prod-type = "":U
     1000         sj-goods01r.prod-code = 0
     1001         sj-goods01r.artic     = "":U
     1002         sj-goods01r.is-out    = yes
     1003         sj-goods01r.gds-name = "Итого по варианту закупки 1"
     1004         sj-goods01r.prod-name = "по расходам"
     1005         .
     1006         create sj-goods01v.
     1007         assign
     1008         sj-goods01v.gds-code = 0
     1009         sj-goods01v.var-purch = 1
     1010         sj-goods01v.prod-type = "":U
     1011         sj-goods01v.prod-code = 0
     1012         sj-goods01v.artic     = "":U
     1013         sj-goods01v.is-out    = no
     1014         sj-goods01v.gds-name = "Итого по варианту закупки 1"
     1015         sj-goods01v.prod-name = "по возвратам"
     1016         .
     1017         create sj-goods02r.
     1018         assign
     1019         sj-goods02r.gds-code = 0
     1020         sj-goods02r.var-purch = 2
     1021         sj-goods02r.prod-type = "":U
     1022         sj-goods02r.prod-code = 0
     1023         sj-goods02r.artic     = "":U
     1024         sj-goods02r.is-out    = yes
     1025         sj-goods02r.gds-name = "Итого по варианту закупки 2"
     1026         sj-goods02r.prod-name = "по расходам"
     1027         .
     1028         create sj-goods02v.
     1029         assign
     1030         sj-goods02v.gds-code = 0
     1031         sj-goods02v.var-purch = 2
     1032         sj-goods02v.prod-type = "":U
     1033         sj-goods02v.prod-code = 0
     1034         sj-goods02v.artic     = "":U
     1035         sj-goods02v.is-out    = no
     1036         sj-goods02v.gds-name = "Итого по варианту закупки 2"
     1037         sj-goods02v.prod-name = "по возвратам"
     1038         .
     1039       end.
     1040       else do:
     1041         find first sj-goods00 where
     1042                 sj-goods00.gds-code = 0
     1043             AND sj-goods00.var-purch = 0
     1044             AND sj-goods00.is-out  = ?
     1045             AND sj-goods00.supp-type = "":U
     1046             AND sj-goods00.supp-code = 0
     1047         .
     1048         find  first sj-goods01r where
     1049                 sj-goods01r.gds-code = 0
     1050             AND sj-goods01r.var-purch = 1
     1051             AND sj-goods01r.is-out    = yes
     1052             AND sj-goods01r.supp-type = "":U
     1053             AND sj-goods01r.supp-code = 0
     1054         .
     1055         find first sj-goods01v where
     1056                 sj-goods01v.gds-code = 0
     1057             AND sj-goods01v.var-purch = 1
     1058             AND sj-goods01v.supp-type = "":U
     1059             AND sj-goods01v.supp-code = 0
     1060             AND sj-goods01v.is-out    = no
     1061                 .
     1062         find first sj-goods02r where
     1063                 sj-goods02r.gds-code = 0
     1064            AND  sj-goods02r.var-purch = 2
     1065            AND  sj-goods02r.supp-type = "":U
     1066            AND  sj-goods02r.supp-code = 0
     1067            AND  sj-goods02r.is-out    = yes
     1068         .
     1069         find first sj-goods02v where
     1070                 sj-goods02v.gds-code = 0
     1071            AND  sj-goods02v.var-purch = 2
     1072            AND  sj-goods02v.supp-type = "":U
     1073            AND  sj-goods02v.supp-code = 0
     1074            AND  sj-goods02v.is-out    = no
     1075                 .
     1076         for each buf_sj-goods where
     1077                buf_sj-goods.gds-code = p-gds-code
     1078            AND buf_sj-goods.is-out   = p-is-out:
     1079          for each sj-goods no-lock where
     1080                  sj-goods.gds-code = 0
     1081              and (sj-goods.is-out = ? or sj-goods.is-out = p-is-out )
     1082              and (sj-goods.var-purch = 0 or sj-goods.var-purch = buf_sj-goods.var-purch)
     1083              :
     1084            assign
     1085            sj-goods.qnty = sj-goods.qnty - buf_sj-goods.qnty
     1086            sj-goods.sale-sum = sj-goods.sale-sum - buf_sj-goods.sale-sum
     1087            sj-goods.rest-qnty = sj-goods.rest-qnty
     1088            .
     1089          end.
     1090          delete buf_sj-goods.
     1091         end.
     1092         for each treal-3 where
     1093                 treal-3.gds-code = p-gds-code
     1094            AND  treal-3.gds-code = p-gds-code
     1095            AND treal-3.is-out = p-is-out:
     1096            assign
     1097            treal-3.rest-qnty = treal-3.qnty1
     1098            .
     1099         end.
     1100       end.
     1101       run waitfram-show in this-procedure ("Ждите..." ).
     1102       for each buf_doc-line no-lock where
     1103                (p-doc-line-rec = ? and
     1104                (buf_doc-line.doc-code = buf_trn.doc-code
     1105                or
     1106                buf_doc-line.doc-code = buf_trn.out-code))
     1107                or recid(buf_doc-line) = p-doc-line-rec
     1108                :
     1109         assign
     1110         v-is-out = (buf_doc-line.doc-code = buf_trn-doc.doc-code).
     1111         find first buf_goods no-lock where
     1112                   buf_goods.artic = buf_doc-line.artic
     1113               AND buf_goods.prod-type = buf_doc-line.prod-type
     1114               and buf_goods.prod-code = buf_doc-line.prod-code no-error .
     1115         if not available buf_goods then do:
     1116         end.
     1117         find first buf_clients no-lock where
     1118                   buf_Clients.obj-type = buf_doc-line.prod-type
     1119               AND buf_Clients.obj-code = buf_doc-line.prod-code no-error .
     1120         if not available buf_clients then do:
     1121         end.
     1122         my-accum = my-accum + 1.
     1123         IF my-accum MODULO 50  = 0 then do:
     1124             run waitfram-show in this-procedure ("Обработано " + string(my-accum) + " строк накладных ").
     1125         end.
     1126         assign
     1127         sale_sum_r-b  = 0
     1128         v-price-flag  = ?
     1129         .
     1130         FOR EACH buf_gds-dtl No-LOCK WHERE
     1131                 buf_gds-dtl.doc-code = buf_doc-line.doc-code AND
     1132                 buf_gds-dtl.artic = buf_doc-line.artic AND
     1133                 buf_gds-dtl.prod-type = buf_doc-line.prod-type AND
     1134                 buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1135           assign
     1136           v-price-netto =  (If p-curr-r-b = 'rubl':U
     1137                             then (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1138                             else (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1139                             )
     1140           v-price-flag  = (if v-price-flag = ? or v-price-flag = yes
     1141                            then (v-price-flag = ?
     1142                                 or
     1143                                 (v-price-sale = v-price-netto)
     1144                                 )
     1145                            else v-price-flag)
     1146           v-price-sale   = (if v-price-flag = yes or v-price-flag = yes
     1147                            then v-price-netto
     1148                            else v-price-sale)
     1149           sale_sum_r-b = sale_sum_r-b + (if v-is-out then 1 else - 1) * v-price-netto * buf_gds-dtl.fact-qnty
     1150           .
     1151         END.
     1152         assign
     1153         v-price-sale-calc  = sale_sum_r-b / buf_doc-line.fact-qnty
     1154         .
     1155         assign
     1156         sj-goods00.sale-sum  = sj-goods00.sale-sum  + sale_sum_r-b
     1157         sj-goods00.qnty      = sj-goods00.qnty + (if v-is-out then 1 else - 1) * buf_Doc-line.fact-qnty
     1158         sj-goods00.rest-qnty = sj-goods00.qnty
     1159         .
     1160         FOR EACH buf_parts NO-LOCK WHERE
     1161                 buf_parts.artic = buf_doc-line.artic AND
     1162                 buf_parts.prod-type = buf_doc-line.prod-type AND
     1163                 buf_parts.prod-code = buf_doc-line.prod-code AND
     1164                 buf_parts.out-code = buf_doc-line.doc-code AND
     1165                 buf_parts.obj-type = buf_doc-line.obj-type AND
     1166                 buf_parts.obj-code = buf_doc-line.obj-code:
     1167           CASE buf_parts.purch-code:
     1168             when integer('4':U) then do:
     1169               assign
     1170               v-var-purch = 2.
     1171               find first sj-goods where
     1172                         sj-goods.gds-code = buf_goods.gds-code
     1173                     AND sj-goods.is-out   = v-is-out
     1174                     AND sj-goods.var-purch = 2
     1175                     and sj-goods.supp-type = buf_parts.supp-type
     1176                     and sj-goods.supp-code = buf_parts.supp-code  no-error.
     1177             end.
     1178             otherwise do:
     1179               assign
     1180               v-var-purch = 1.
     1181               find first sj-goods where
     1182                         sj-goods.gds-code = buf_goods.gds-code
     1183                     AND sj-goods.is-out   =  v-is-out
     1184                     AND sj-goods.var-purch = 1
     1185                     and sj-goods.supp-type = buf_parts.supp-type
     1186                     and sj-goods.supp-code = buf_parts.supp-code  no-error.
     1187             end.
     1188           END CASE.
     1189           if not available sj-goods then do:
     1190             create sj-goods.
     1191             assign
     1192             sj-goods.gds-code = buf_goods.gds-code
     1193             sj-goods.is-out   = v-is-out
     1194             sj-goods.gds-name = buf_goods.gds-name
     1195             sj-goods.prod-name = buf_clients.obj-name
     1196             sj-goods.var-purch = v-var-purch
     1197             sj-goods.prod-type = buf_doc-line.prod-type
     1198             sj-goods.prod-code = buf_doc-line.prod-code
     1199             sj-goods.artic     = buf_doc-line.artic
     1200             sj-goods.price-flag    = not v-price-flag
     1201             sj-goods.price-sale = (if v-price-flag
     1202                                    then v-price-sale
     1203                                    else ?)
     1204             sj-goods.supp-type = (if sj-goods.supp-type = "":U
     1205                                   then buf_parts.supp-type
     1206                                   else sj-goods.supp-type)
     1207             sj-goods.supp-code = (if sj-goods.supp-code = 0
     1208                                   then buf_parts.supp-code
     1209                                   else sj-goods.supp-code)
     1210             sj-goods.supp-flag = (if sj-goods.supp-flag = yes
     1211                                   then (sj-goods.supp-type = buf_parts.supp-type
     1212                                         and
     1213                                         sj-goods.supp-code = buf_parts.supp-code)
     1214                                   else sj-goods.supp-flag)
     1215             .
     1216           end.
     1217           assign
     1218           sj-goods.qnty          = sj-goods.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1219           sj-goods.rest-qnty     = sj-goods.qnty
     1220           sj-goods.sale-sum      = sale_sum_r-b / buf_doc-line.fact-qnty * abs(sj-goods.qnty)
     1221           .
     1222           if v-is-out then do:
     1223             if v-var-purch = 1 then do:
     1224               assign
     1225               sj-goods01r.sale-sum = sj-goods01r.sale-sum  +
     1226                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1227               sj-goods01r.qnty     = sj-goods01r.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1228               .
     1229             end.
     1230             else do:
     1231               assign
     1232               sj-goods02r.sale-sum = sj-goods02r.sale-sum  +
     1233                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1234               sj-goods02r.qnty     = sj-goods02r.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1235               .
     1236             end.
     1237           end.
     1238           else do:
     1239             if v-var-purch = 1 then do:
     1240               assign
     1241               sj-goods01v.sale-sum = sj-goods01v.sale-sum  +
     1242                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1243               sj-goods01v.qnty     = sj-goods01v.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1244               .
     1245             end.
     1246             else do:
     1247               assign
     1248               sj-goods02v.sale-sum = sj-goods02v.sale-sum  +
     1249                                      sale_sum_r-b / buf_doc-line.fact-qnty * buf_parts.qnty
     1250               sj-goods02v.qnty     = sj-goods02v.qnty + (if v-is-out then 1 else - 1) * buf_parts.qnty
     1251               .
     1252             end.
     1253           end.
     1254         end.
     1255       end.
     1256       release sj-goods00.
     1257       run waitfram-hide in this-procedure .
     1258     end.
     1259   end procedure.
     1260   procedure process-inkas :
     1261   define parameter buffer buf_inkas for ub.inkas.
     1262   define input parameter p-without-src-code as logical no-undo .
     1263   define output parameter p-z-number   like ub.chk-doc.z-number no-undo .
     1264   define output parameter p-pay-desk  like ub.chk-doc.pay-desk no-undo .
     1265   define variable v-curr-r-b as character no-undo .
     1266   define variable v-base-code like ub.sysconf.base-code no-undo .
     1267   define variable p-by-pay-desk as logical no-undo .
     1268   define variable v-curr-code like ub.currency.curr-code no-undo init ?.
     1269   define variable v-one-curr-code as logical no-undo .
     1270   define variable v-flag as logical no-undo .
     1271   define buffer buf_trn-doc for ub.trn-doc.
     1272   define buffer buf_ret-doc for ub.trn-doc.
     1273   define buffer buf_goods   for ub.goods.
     1274   define buffer buf_doc-line for ub.doc-line.
     1275   define buffer buf_chk-gds for ub.chk-gds.
     1276   define buffer buf_bar-code for ub.bar-code.
     1277   define buffer buf_cash-pay for ub.cash-pay.
     1278   define variable v-ret-doc-code like ub.trn-doc.doc-code no-undo .
     1279   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   define variable pychk_without-src-code as logical no-undo .
     1281   DEFINE BUFFER b-treal-3 for treal-3.
     1282   do
     1283   on error undo, return error
     1284   :
     1285   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1287     (output v-curr-r-b
     1288     )  .
     1289   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1290   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1291     (input  buf_inkas.host-code
     1292     ,output v-base-code
     1293     )  .
     1294     assign
     1295     v-curr-code = (if v-curr-code = ? then v-base-code else v-curr-code)
     1296     v-one-curr-code = (if v-base-code = v-curr-code then yes else no)
     1297     .
     1298     pychk_without-src-code = p-without-src-code.
     1299     find first buf_trn-doc no-lock where
     1300               buf_trn-doc.doc-code = buf_inkas.inkas-code .
     1301     find first buf_ret-doc no-lock where
     1302               buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
     1303     if available buf_ret-doc then
     1304     assign
     1305     v-ret-doc-code = buf_ret-doc.doc-code
     1306     .
     1307     for each treal-3:
     1308       delete treal-3.
     1309     end.
     1310     v-flag = ?.
     1311     run rep/rpychk0.p ( input "salevza2"
     1312                         ,input buf_inkas.obj-type
     1313                         ,input buf_inkas.obj-code
     1314                         ,input ?
     1315                         ,input ?
     1316                         ,input ?
     1317                         ,input ?
     1318                         ,input ?
     1319                         ,input ?
     1320                         ,input buf_inkas.inkas-code
     1321                         ).
     1322       _chk-doc:
     1323     FOR EACH ub.chk-doc No-LOCK WHERE
     1324             ub.chk-doc.obj-type = buf_inkas.obj-type AND
     1325             ub.chk-doc.obj-code = buf_inkas.obj-code AND
     1326             ub.chk-doc.out-code = buf_inkas.inkas-code:
     1327       if v-flag = ? then do:
     1328         assign
     1329         p-z-number  = chk-doc.z-number
     1330         p-pay-desk = chk-doc.pay-desk
     1331         v-flag = no
     1332         .
     1333       end.
     1334       if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1335       if (chk-doc.z-number <> p-z-number
     1336       or chk-doc.pay-desk <> p-pay-desk)
     1337       and not v-flag
     1338       then do:
     1339         message
     1340         substitute("В Вашей продаже &1 обнаружены чеки по разным Z-отчетам или разным кассам", buf_inkas.inkas-code) skip
     1341         "ЭКСПОРТ БУДЕТ НЕПРАВИЛЬНЫМ" SKIP
     1342         "Продолжать формирование экспорта?"
     1343         view-as alert-box question buttons yes-no update v-flag.
     1344         if not v-flag then  return error .
     1345       end.
     1346       for each ub.chk-gds no-lock where
     1347               ub.chk-gds.doc-code = ub.chk-doc.doc-code:
     1348         if ub.chk-gds.src-code = ?
     1349         or ub.chk-gds.src-code = "":U then do:
     1350           message
     1351           substitute("Обнаружено незаполненное поле ИСХОДНЫЙ КОД в чеке &1, товарная строка &2"
     1352                     , ub.chk-gds.doc-code
     1353                     , ub.chk-gds.line-num)   skip
     1354           "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     1355           view-as alert-box error .
     1356           return error .
     1357         end.
     1358       end.
     1359       for each buf_chk-gds-pay no-lock where
     1360               buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     1361           and  buf_chk-gds-pay.algo-num = "1.8",
     1362           first buf_bar-code no-lock where
     1363               buf_bar-code.b-code = buf_chk-gds-pay.b-code,
     1364           first buf_cash-pay no-lock where
     1365               buf_cash-pay.cdpay-code = buf_chk-gds-pay.pay-code
     1366           and buf_cash-pay.curr-code = buf_chk-gds-pay.curr-code,
     1367           first buf_chk-gds no-lock where
     1368                 buf_chk-gds.doc-code = ub.chk-doc.doc-code
     1369             and buf_chk-gds.line-num = buf_chk-gds-pay.line-num :
     1370   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371      FIND FIRST treal-3 No-LOCK WHERE
     1372                treal-3.gds-code = buf_bar-code.gds-code
     1373           AND  treal-3.is-out   = (chk-doc.chk-type = integer('1':U)) AND
     1374                         (
     1375                         p-without-src-code = yes
     1376                         or
     1377                         treal-3.src-code = buf_chk-gds.src-code)
     1378            AND treal-3.is-pay = yes No-ERROR.
     1379      IF NOT AVAIL treal-3 then do:
     1380        FIND last b-treal-3 No-LOCK WHERE
     1381                   b-treal-3.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
     1382        create treal-3.
     1383        assign
     1384        treal-3.gds-code = buf_bar-code.gds-code
     1385        treal-3.is-out   = (ub.chk-doc.chk-type = integer('1':U))
     1386        treal-3.src-code = (if p-without-src-code then "":U else buf_chk-gds.src-code)
     1387        treal-3.qnty1    = 0
     1388        treal-3.netto    = 0
     1389        treal-3.out-name = buf_cash-pay.obj-name
     1390        treal-3.is-pay   = yes
     1391        treal-3.ii       =  (if avail b-treal-3
     1392                             then b-treal-3.ii + 1
     1393                             else 1)
     1394        .
     1395      END.
     1396      assign
     1397      treal-3.netto = treal-3.netto + (if v-curr-r-b = 'base':U
     1398                                       or v-base-code = 0
     1399                                       then buf_chk-gds-pay.tot-r-b
     1400                                       else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
     1401      treal-3.qnty1 = treal-3.qnty1 + buf_chk-gds-pay.eff-doc-qnty
     1402      treal-3.netto-rubl = treal-3.netto-rubl + (if v-curr-r-b = 'rubl':U
     1403                                                 or v-base-code = 0
     1404                                                 then buf_chk-gds-pay.tot-r-b
     1405                                                 else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
     1406      treal-3.rest-qnty = treal-3.qnty1
     1407      .
     1408       end.
     1409     END.
     1410   end.
     1411   end procedure.
     1412   procedure process-two-tables :
     1413   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     1414   define input parameter p-is-out   as logical no-undo .
     1415   define variable v-is-out-int     as integer no-undo .
     1416     do
     1417     on error undo, return error
     1418     :
     1419     run waitfram-show in this-procedure ("Ждите...").
     1420     v-is-out-int = (if p-is-out then 1 else - 1).
     1421     if p-gds-code = 0 then do:
     1422       for each sj-print:
     1423         delete sj-print.
     1424       end.
     1425     end.
     1426     else do:
     1427       for each sj-print where
     1428             sj-print.gds-code = p-gds-code
     1429         AND sj-print.is-out = p-is-out :
     1430         delete sj-print.
     1431       end.
     1432     end.
     1433     _cycle:
     1434     for each sj-goods where
     1435             sj-goods.gds-code > 0
     1436          AND (p-gds-code = 0 or sj-goods.gds-code = p-gds-code)
     1437          and (p-is-out = ? or sj-goods.is-out = p-is-out)
     1438          and sj-goods.var-purch > 0,
     1439     each treal-3 where
     1440         treal-3.is-out   = sj-goods.is-out
     1441     AND treal-3.gds-code = sj-goods.gds-code
     1442     break
     1443     by sj-goods.is-out
     1444     by sj-goods.gds-code
     1445     by sj-goods.var-purch
     1446     by sj-goods.sale-sum descending
     1447     by treal-3.is-out
     1448     by treal-3.gds-code
     1449     by treal-3.is-pay descending:
     1450       if sj-goods.rest-qnty = 0
     1451       or treal-3.rest-qnty = 0 then NEXT _cycle.
     1452       if sj-goods.rest-qnty = treal-3.rest-qnty then do:
     1453         create sj-print.                                                       buffer-copy sj-goods                                                   except sj-goods.qnty                                                   to sj-print                                                            assign                                                                 sj-print.qnty = (if sj-goods.is-out then 1 else (- 1)) * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty))             sj-print.is-cash = treal-3.is-pay                                      sj-print.sale-sum = (if sj-print.qnty = sj-goods.qnty                                       then sj-goods.sale-sum                                                 else (if sj-goods.price-flag                                                 then sj-goods.price-sale                                               else sj-goods.sale-sum / sj-goods.qnty) * sj-print.qnty                            ).
     1454         assign
     1455         treal-3.rest-qnty = 0
     1456         sj-goods.rest-qnty = 0
     1457         .
     1458         next _cycle.
     1459       end.
     1460       if abs(sj-goods.rest-qnty) < abs(treal-3.rest-qnty) then do:
     1461         create sj-print.                                                       buffer-copy sj-goods                                                   except sj-goods.qnty                                                   to sj-print                                                            assign                                                                 sj-print.qnty = (if sj-goods.is-out then 1 else (- 1)) * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty))             sj-print.is-cash = treal-3.is-pay                                      sj-print.sale-sum = (if sj-print.qnty = sj-goods.qnty                                       then sj-goods.sale-sum                                                 else (if sj-goods.price-flag                                                 then sj-goods.price-sale                                               else sj-goods.sale-sum / sj-goods.qnty) * sj-print.qnty                            ).
     1462         assign
     1463         treal-3.rest-qnty = (if sj-goods.is-out then 1 else (- 1)) * (abs(treal-3.rest-qnty) - abs(sj-goods.rest-qnty))
     1464         sj-goods.rest-qnty = 0
     1465         .
     1466         next _cycle.
     1467       end.
     1468       if abs(sj-goods.rest-qnty) > abs(treal-3.rest-qnty) then do:
     1469         create sj-print.                                                       buffer-copy sj-goods                                                   except sj-goods.qnty                                                   to sj-print                                                            assign                                                                 sj-print.qnty = (if sj-goods.is-out then 1 else (- 1)) * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty))             sj-print.is-cash = treal-3.is-pay                                      sj-print.sale-sum = (if sj-print.qnty = sj-goods.qnty                                       then sj-goods.sale-sum                                                 else (if sj-goods.price-flag                                                 then sj-goods.price-sale                                               else sj-goods.sale-sum / sj-goods.qnty) * sj-print.qnty                            ).
     1470         assign
     1471         sj-goods.rest-qnty = (if sj-goods.is-out then 1 else (- 1)) * (abs(sj-goods.rest-qnty) - abs(treal-3.rest-qnty))
     1472         treal-3.rest-qnty = 0
     1473         .
     1474         next _cycle.
     1475       end.
     1476     end.
     1477     run waitfram-hide in this-procedure .
     1478     end.
     1479   end procedure.
     1480   procedure proc-print :
     1481   define variable v-supp as character no-undo .
     1482   define variable v-supp-name as character no-undo .
     1483   define variable date_string as character no-undo.
     1484   define variable v-header-base-curr as character no-undo .
     1485   DEFINE VARIABLE Line                as character                    no-undo .
     1486   define variable g#report-num  as integer no-undo .
     1487   define variable g#quest-print as logical no-undo .
     1488   define variable g#log as logical no-undo .
     1489   define variable v-is-out-border as logical no-undo .
     1490   define variable v-is-out-border-2 as logical no-undo .
     1491   define buffer sj-goods00 for sj-goods.
     1492   DEFINE FRAME Purch-frame
     1493   sj-print.gds-code     column-label "Код товара"
     1494   sj-print.gds-name     column-label "Название товара" format "X(30)"
     1495   sj-print.price-sale   column-label "Цена нетто"
     1496   sj-print.price-flag   column-label "При!вед"            format "+/"
     1497   sj-print.is-cash      column-label "Нал"                format "+/"
     1498   sj-print.qnty         column-label "Количество"
     1499   sj-print.sale-sum     column-label "Сумма нетто"
     1500   sj-print.artic        column-label "Артикул"
     1501   sj-print.prod-name    column-label "Производитель"   format "X(30)"
     1502   v-supp                column-label "Поставщик"       format "X(12)"
     1503   v-supp-name           column-label "Поставщик-название" format "X(30)"
     1504   HEADER  date_string AT 5 format "X(35)"
     1505   v-header-base-curr        format "X(20)" AT 42
     1506   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     1507   Line format "X(177)" AT 1
     1508   with width 232 down stream-io use-text    .
     1509     do
     1510     on error undo, return error
     1511     :
     1512     date_string = cur-time-print() .
     1513     if v-curr-r-b = 'base':U then do:
     1514       assign
     1515       v-header-base-curr = string( "( Б.Вал. - " + caps( v-r-b-abbr ) + " )" )
     1516       .
     1517     end.
     1518     run prn-lib-open-stream  in this-procedure (
     1519                                                 input parParentProc
     1520                                                 ,input 43
     1521                                                 ,input yes
     1522                                                 ,input no
     1523                                                 ).
     1524     PUT  STREAM PrnLibStream
     1525     SPACE(25) ( substitute("Отчет по зарезервированным партиям продажи &1 по вариантам закупки", buf_inkas.inkas-code) )
     1526     format "x(90)" SKIP(2) .
     1527     Line = fill("-", 198).
     1528     FORM HEADER
     1529     string(Line, "X(198)") AT 1 SKIP
     1530     "Продолжение - на следующей странице" AT 30 SKIP
     1531     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1532     VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1533     FORM with FRAME Purch-frame .
     1534     run waitfram-show in this-procedure ("Ждите...").
     1535     find first sj-goods00 no-lock where
     1536               sj-goods00.gds-code = 0
     1537            and sj-goods00.var-purch = 0 .
     1538     display stream PrnLibStream
     1539     "Вариант закупки 1" @ sj-print.qnty
     1540     with frame Purch-Frame.
     1541     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1542     assign
     1543     v-is-out-border = yes
     1544     v-is-out-border-2 = yes
     1545     .
     1546     for each sj-print no-lock where
     1547            sj-print.gds-code > 0
     1548        and sj-print.var-purch = 1
     1549     break
     1550     by sj-print.is-out descending
     1551     by sj-print.var-purch
     1552     by sj-print.sale-sum descending
     1553      :
     1554       if first-of(sj-print.is-out) then do:
     1555         if sj-print.is-out then do:
     1556           display stream PrnLibStream
     1557           "РАСХОД" @ sj-print.qnty
     1558           with frame Purch-Frame.
     1559           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1560         end.
     1561         else do:
     1562           display stream PrnLibStream
     1563           "ВОЗВРАТ" @ sj-print.qnty
     1564           with frame Purch-Frame.
     1565           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1566         end.
     1567       end.
     1568       find first buf_clients no-lock where
     1569                 buf_clients.obj-type = sj-print.supp-type
     1570             AND buf_clients.obj-code = sj-print.supp-code no-error .
     1571       Display STREAM PrnLibStream
     1572       sj-print.gds-code
     1573       sj-print.artic
     1574       sj-print.gds-name
     1575       sj-print.prod-name
     1576       (sj-print.supp-type + string(sj-print.supp-code)) @ v-supp
     1577       (if available buf_clients then buf_clients.obj-name else "":U) @ v-supp-name
     1578       (if sj-print.price-flag
     1579       then sj-print.price-sale
     1580       else sj-print.sale-sum / sj-print.qnty) @ sj-print.price-sale
     1581       sj-print.price-flag @ sj-print.price-flag
     1582       sj-print.is-cash
     1583       sj-print.qnty
     1584       sj-print.sale-sum
     1585       with FRAME Purch-Frame .
     1586       DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1587       if last-of(sj-print.is-out) then do:
     1588         if sj-print.is-out then do:
     1589           find first sj-goods no-lock where
     1590                     sj-goods.gds-code = 0
     1591                 and sj-goods.is-out   =  yes
     1592                 and sj-goods.var-purch = 1 .
     1593           assign
     1594           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1595           .
     1596           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1597           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1598           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1599         end.
     1600         if not sj-print.is-out then do:
     1601           find first sj-goods no-lock where
     1602                     sj-goods.gds-code = 0
     1603                 AND SJ-GOODS.IS-OUT  = NO
     1604                 and sj-goods.var-purch = 1 .
     1605           assign
     1606           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1607           .
     1608           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1609           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1610           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1611         end.
     1612       end.
     1613     END.
     1614     display stream PrnLibStream
     1615     "Итого по варианту закупки 1 в %" @ sj-print.gds-name
     1616     string(var-sale-sum / sj-goods00.sale-sum * 100, "->>9.999%") @ sj-print.sale-sum
     1617     with frame Purch-Frame.
     1618     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1619     assign
     1620     var-sale-sum = 0
     1621     .
     1622     put stream PrnLibStream unformatted string(Line, "X(198)") skip.
     1623     display stream PrnLibStream
     1624     "Вариант закупки 2" @ sj-print.qnty
     1625     with frame Purch-Frame.
     1626     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1627     for each sj-print no-lock where
     1628            sj-print.gds-code > 0
     1629        and sj-print.var-purch = 2
     1630     break
     1631     by sj-print.is-out descending
     1632     by sj-print.var-purch
     1633     by sj-print.sale-sum descending
     1634     :
     1635       if first-of(sj-print.is-out) then do:
     1636         if sj-print.is-out then do:
     1637           display stream PrnLibStream
     1638           "РАСХОД" @ sj-print.qnty
     1639           with frame Purch-Frame.
     1640           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1641         end.
     1642         else do:
     1643           display stream PrnLibStream
     1644           "ВОЗВРАТ" @ sj-print.qnty
     1645           with frame Purch-Frame.
     1646           DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1647         end.
     1648       end.
     1649       find first buf_clients no-lock where
     1650                 buf_clients.obj-type = sj-print.supp-type
     1651             AND buf_clients.obj-code = sj-print.supp-code no-error .
     1652       Display STREAM PrnLibStream
     1653       sj-print.gds-code
     1654       sj-print.artic
     1655       sj-print.gds-name
     1656       sj-print.prod-name
     1657       (sj-print.supp-type + string(sj-print.supp-code)) @ v-supp
     1658       (if available buf_clients then buf_clients.obj-name else "":U) @ v-supp-name
     1659       (if not sj-print.price-flag
     1660       then sj-print.price-sale
     1661       else sj-print.sale-sum / sj-print.qnty) @ sj-print.price-sale
     1662       sj-print.price-flag @ sj-print.price-flag
     1663       sj-print.is-cash
     1664       sj-print.qnty
     1665       sj-print.sale-sum
     1666       with FRAME Purch-Frame .
     1667       DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1668       if last-of(sj-print.is-out) then do:
     1669         if sj-print.is-out then do:
     1670           find first sj-goods no-lock where
     1671                     sj-goods.gds-code = 0
     1672                 and sj-goods.is-out   =  yes
     1673                 and sj-goods.var-purch = 2 .
     1674           assign
     1675           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1676           .
     1677           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1678           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1679           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1680         end.
     1681         else do:
     1682           find first sj-goods no-lock where
     1683                     sj-goods.gds-code = 0
     1684                 and sj-goods.is-out = no
     1685                 and sj-goods.var-purch = 2 .
     1686           assign
     1687           var-sale-sum = var-sale-sum + sj-goods.sale-sum
     1688           .
     1689           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1690           display stream PrnLibStream                               sj-goods.gds-name  @ sj-print.gds-name                    sj-goods.prod-name @ sj-print.prod-name                   sj-goods.qnty      @ sj-print.qnty                        sj-goods.sale-sum  @ sj-print.sale-sum                    with frame Purch-Frame.                                   DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1691           UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1692         end.
     1693       end.
     1694     END.
     1695     display stream PrnLibStream
     1696     "Итого по варианту закупки 2 в %" @ sj-print.gds-name
     1697     string(var-sale-sum / sj-goods00.sale-sum * 100, "->>9.999%") @ sj-print.sale-sum
     1698     with frame Purch-Frame.
     1699     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1700     UNDERLINE stream PrnLibStream    sj-print.gds-code                sj-print.artic                   sj-print.gds-name                sj-print.prod-name               v-supp                           v-supp-name                      sj-print.price-sale              sj-print.qnty                    sj-print.sale-sum                with frame Purch-Frame.
     1701     display stream PrnLibStream
     1702     "ИТОГО ПО ВСЕМ ВАРИАНТАМ ЗАКУПКИ" @ sj-print.gds-name
     1703     sj-goods00.sale-sum  @ sj-print.sale-sum
     1704     with frame Purch-Frame.
     1705     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     1706     HIDE  STREAM PrnLibStream FRAME BottomFrame .
     1707     HIDE  STREAM PrnLibStream FRAME Chk-List.
     1708     output STREAM PrnLibStream CLOSE.
     1709     run get-report-num  in parParentProc(output g#report-num).
     1710     run get-quest-print in parParentProc(output g#quest-print).
     1711   if g#quest-print = false
     1712   then do:
     1713     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1714                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1715                                         OUTPUT g#log ).
     1716   end.
     1717   else do:
     1718     os-command silent
     1719       value( "COPY /b " +
     1720         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1721         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1722         string( session:temp-directory) +  "$" + string( g#report-num )
     1723                 ) .
     1724     os-command silent
     1725       value( "COPY /b " +
     1726         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1727         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1728         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1729                 ) .
     1730   end.
     1731     end.
     1732   end procedure.
     1733   procedure proc-export :
     1734   define parameter buffer buf_inkas for ub.inkas.
     1735   define input parameter p-z-number   like ub.chk-doc.z-number no-undo .
     1736   define input parameter p-pay-desk  like ub.chk-doc.pay-desk no-undo .
     1737   define variable v-short-file-name as character no-undo .
     1738   define variable v-file-name         as character no-undo .
     1739   define variable v-full-path         as character no-undo .
     1740   define variable v-path              as character no-undo .
     1741   define variable v-file-name-no-ext  as character no-undo .
     1742   define variable v-file-name-ext     as character no-undo .
     1743   define variable ii                  as integer no-undo .
     1744   define variable v-is-out-int        as integer no-undo .
     1745   define variable v-full-path-two     as character no-undo .
     1746     do
     1747     on error undo, return error
     1748     :
     1749       run waitfram-show in this-procedure ("Ждите...").
     1750       do ii = 1 to 2:
     1751         assign
     1752         v-short-file-name = 'маг':U + string(buf_inkas.obj-code) + "_"  +
     1753                             "kassa":U + string(p-pay-desk) + "_" +
     1754                             "z":U + string(p-z-number) + "_" +
     1755                             (if ii = 1 then "v" else "r") + ".txt".
     1756         v-is-out-int = if ii = 1 then (- 1) else 1.
     1757         output stream PrnLibStream to value(v-short-file-name).
     1758         _cycle:
     1759         for each sj-goods where
     1760                 sj-goods.gds-code > 0
     1761             and sj-goods.var-purch > 0
     1762             and sj-goods.is-out = (if ii = 1 then no else yes) ,
     1763         each treal-3 where
     1764             treal-3.is-out   = sj-goods.is-out
     1765         AND treal-3.gds-code = sj-goods.gds-code
     1766         break
     1767         by sj-goods.is-out
     1768         by sj-goods.gds-code
     1769         by sj-goods.var-purch
     1770         by sj-goods.sale-sum descending
     1771         by treal-3.is-out
     1772         by treal-3.gds-code
     1773         by treal-3.is-pay descending
     1774         by treal-3.src-code:
     1775           if sj-goods.rest-qnty = 0
     1776           or treal-3.rest-qnty = 0 then next _cycle.
     1777           if sj-goods.rest-qnty = treal-3.rest-qnty then do:
     1778             if sj-goods.var-purch = 2 and treal-3.is-pay then do:          put stream PrnLibStream unformatted         treal-3.src-code chr(44) v-is-out-int * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty)) chr(32) .       end.
     1779             assign
     1780             sj-goods.rest-qnty = 0
     1781             treal-3.rest-qnty = 0
     1782             .
     1783             next _cycle.
     1784           end.
     1785           if abs(sj-goods.rest-qnty) < abs(treal-3.rest-qnty) then do:
     1786             if sj-goods.var-purch = 2 and treal-3.is-pay then do:          put stream PrnLibStream unformatted         treal-3.src-code chr(44) v-is-out-int * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty)) chr(32) .       end.
     1787             assign
     1788             treal-3.rest-qnty = v-is-out-int * (abs(treal-3.rest-qnty) - abs(sj-goods.rest-qnty))
     1789             sj-goods.rest-qnty = 0
     1790             .
     1791             next _cycle.
     1792           end.
     1793           if abs(sj-goods.rest-qnty) > abs(treal-3.rest-qnty) then do:
     1794             if sj-goods.var-purch = 2 and treal-3.is-pay then do:          put stream PrnLibStream unformatted         treal-3.src-code chr(44) v-is-out-int * min(abs(treal-3.rest-qnty), abs(sj-goods.rest-qnty)) chr(32) .       end.
     1795             assign
     1796             sj-goods.rest-qnty = v-is-out-int * (abs(sj-goods.rest-qnty) - abs(treal-3.rest-qnty))
     1797             treal-3.rest-qnty = 0
     1798             .
     1799             next _cycle.
     1800           end.
     1801         end.
     1802         put stream PrnLibStream unformatted skip.
     1803         output STREAM PrnLibStream CLOSE.
     1804         run gbl/filename.p
     1805           (input  v-short-file-name
     1806           ,output v-full-path
     1807           ,output v-path
     1808           ,output v-file-name
     1809           ,output v-file-name-no-ext
     1810           ,output v-file-name-ext
     1811           ) no-error  .
     1812         if error-status :error
     1813         then do:
     1814           message
     1815           "Не найден файл экспорта" v-short-file-name
     1816           view-as alert-box .
     1817         end.
     1818         v-full-path-two = v-full-path-two + chr(10) + v-full-path.
     1819       end.
     1820       run waitfram-hide in this-procedure .
     1821       message
     1822       "Экспорт завершен" skip
     1823       "Файл(-ы) экспорта" v-full-path-two
     1824       view-as alert-box.
     1825     end.
     1826   end procedure.
