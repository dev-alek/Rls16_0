      641   DEFINE VARIABLE fi-fact AS DECIMAL FORMAT "->>>,>>>,>>9.999":U INITIAL 0
      642        LABEL "Факт"
      643         VIEW-AS TEXT
      644        SIZE 17 BY .67
      645        FGCOLOR 4  NO-UNDO.
