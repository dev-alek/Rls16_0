      874     define variable v-is-new          as logical   no-undo .
      875     run str/crebcprt.w
      876       (input  parparentproc
      877       ,input  p-gds-code
      878       ,input  false
      879       ,output v-create-bar-code
      880       ,output v-is-new
      881       ) .
