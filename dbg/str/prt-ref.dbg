      676   DEFINE VARIABLE RADIO-SET-filter AS INTEGER
      677        VIEW-AS RADIO-SET HORIZONTAL EXPAND
      678        RADIO-BUTTONS
      679             "Все", 1,
      680   "На объекте", 2,
      681   "Остаток", 3
      682        SIZE 39.13 BY .88
      683        FGCOLOR 4  NO-UNDO.
