     1081       "Процедура" this-procedure :file-name skip
     1082       view-as alert-box .
     1083   end.
     1084   else do:
     1085     apply "entry":u to self  .
     1086     if focus :handle <> self :handle  then do:
     1087       return no-apply .
     1088     end.
     1089   end.
     1090     if available temp-gds-prt
     1091     then do:
     1092       assign
     1093         p-sel-node-code = temp-gds-prt.node-code
     1094       .
     1095     end.
     1096     apply "go" to frame Dialog-Frame .
     1097   END.
     1098   ON RETURN OF BROWSE-1 IN FRAME Dialog-Frame
     1099   DO:
     1100     apply "choose":U to b-sel.
     1101   END.
     1102   ON RETURN OF fi-search-b-code IN FRAME Dialog-Frame
     1103   DO:
     1104     define variable v-find-next as logical   no-undo .
     1105     if fi-search-b-code <> input frame Dialog-Frame fi-search-b-code then do:
     1106       assign
     1107         v-find-next = false
     1108       .
     1109     end.
     1110     else do:
     1111       assign
     1112         v-find-next = true
     1113       .
     1114     end.
     1115     do with frame Dialog-Frame:
     1116       assign
     1117         fi-search-b-code
     1118       .
     1119     end.
     1120     run search-bar-code in this-procedure
     1121       (input fi-search-b-code
     1122       ,input false
     1123       ) .
     1124   END.
     1125   ON VALUE-CHANGED OF RADIO-SET-filter IN FRAME Dialog-Frame
     1126   DO:
     1127     assign
     1128       radio-set-filter
     1129       .
     1130     case radio-set-filter :
     1131       when 1 then do:
     1132         assign
     1133           v-filter-mode = 'filter-b-code':u
     1134         .
     1135       end.
     1136       when 2 then do:
     1137         assign
     1138           v-filter-mode = 'filter-prt-obj':u
     1139         .
     1140       end.
     1141       when 3 then do:
     1142         assign
     1143           v-filter-mode = 'filter-not-zero':u
     1144         .
     1145       end.
     1146     end case .
     1147     run local-open-query in this-procedure
     1148       (input ?
     1149       ) .
     1150   END.
     1151   ON VALUE-CHANGED OF RADIO-SET-sort IN FRAME Dialog-Frame
     1152   DO:
     1153     assign
     1154       radio-set-sort
     1155       .
     1156     case radio-set-sort :
     1157       when 1 then do:
     1158         assign
     1159           v-sort-mode = 'sort-b-code':u
     1160         .
     1161       end.
     1162       when 2 then do:
     1163         assign
     1164           v-sort-mode = 'sort-sort-code':u
     1165         .
     1166       end.
     1167       when 3 then do:
     1168         assign
     1169           v-sort-mode = 'sort-tree':u
     1170         .
     1171       end.
     1172     end case .
     1173     run local-open-query in this-procedure
     1174       (input ?
     1175       ) .
     1176   END.
     1177   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1178   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1179   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   on help of frame Dialog-Frame
     1181   do:
     1182     run gbl/app_help.p
     1183       (input this-procedure :file-name
     1184       ,input ''
     1185       ,input ?
     1186       ) no-error.
     1187     if error-status :error then do:
     1188       message
     1189         "Ошибка при вызове помощи"
     1190         error-status :get-message(1)
     1191         view-as alert-box .
     1192     end.
     1193   end.
     1194   run minbtn-set in this-procedure .
     1195   on choose of b-help in frame Dialog-Frame
     1196   do:
     1197     apply "help":u to frame Dialog-Frame .
     1198   end.
     1199   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   procedure minbtn-set :
     1201       do
     1202           on error undo, return error return-value
     1203           :
     1204           define variable ii              as integer       no-undo .
     1205           define variable fh              as widget-handle no-undo .
     1206           define variable hh              as widget-handle no-undo .
     1207           define variable v-h             as handle        extent 4 no-undo .
     1208           define variable v-name-button   as character     no-undo .
     1209           define variable v-help-old-x    as decimal       no-undo .
     1210           define variable v-help-old-y    as decimal       no-undo .
     1211           define variable v-help-old-size as decimal       no-undo .
     1212           define variable v-frame-width   as decimal       no-undo .
     1213           define variable jj              as integer       no-undo .
     1214           do
     1215               on error undo, return error
     1216               :
     1217               assign
     1218                   v-frame-width = frame Dialog-Frame:width - 0.3
     1219                   fh            = frame Dialog-Frame:first-child
     1220                   hh            = fh:first-child
     1221                   ii            = 1
     1222                   .
     1223               do while valid-handle(hh):
     1224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1225                   do:
     1226                       case lc(hh:name) :
     1227                           when "b-help" then
     1228                               do:
     1229                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1230                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1232                                   hh:TOOLTIP = "Помощь" .
     1233                                   v-help-old-x = hh:column .
     1234                                   v-help-old-y = hh:row    .
     1235                                   v-help-old-size = hh:width .
     1236                                   hh:width-chars = 2.5 .
     1237                               end.
     1238                           when "b-print" then
     1239                               do:
     1240                                   hh:load-image("cmp/b-print.bmp":u) .
     1241                                   hh:TOOLTIP = "Печать" .
     1242                                   v-h[ii] = hh:handle .
     1243                                   ii = ii + 1 .
     1244                                   hh:width-chars = 3 .
     1245                               end.
     1246                           when "b-history" or
     1247                           when "b-hist" then
     1248                               do:
     1249                                   hh:load-image("cmp/b-hist.bmp":u) .
     1250                                   hh:TOOLTIP = "История" .
     1251                                   v-h[ii] = hh:handle .
     1252                                   ii = ii + 1 .
     1253                                   hh:width-chars = 3 .
     1254                               end.
     1255                           when "b-sch" then
     1256                               do:
     1257                                   hh:load-image("cmp/b-sch.bmp":u) .
     1258                                   hh:TOOLTIP = "Установка Фильтра" .
     1259                                   v-h[ii] = hh:handle .
     1260                                   ii = ii + 1 .
     1261                                   hh:width-chars = 3 .
     1262                               end.
     1263                           when "b-hist-user" then
     1264                               do:
     1265                                   hh:load-image("cmp/b-hist.bmp":u) .
     1266                                   hh:TOOLTIP = "История пользователя" .
     1267                                   ii = ii + 1 .
     1268                               end.
     1269                       end case.
     1270                   end.
     1271                   hh = hh:next-sibling.
     1272               end.
     1273               b-help:column = v-frame-width - b-help:width-chars.
     1274               jj = 0.
     1275               repeat ii = 4 to 1 by -1 :
     1276                   if valid-handle (v-h[ii] ) then
     1277                   do:
     1278                       jj  = jj + 1 .
     1279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1280                       v-h[ii]:row    = v-help-old-y .
     1281                   end.
     1282               end.
     1283           end.
     1284       end.
     1285   end procedure.
     1286   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1287   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1288   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1289   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1290   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1291   define variable v-diasize-current-frame-height as decimal   no-undo .
     1292   define variable v-diasize-change-size          as logical   no-undo .
     1293   define variable v-diasize-resize-button        as handle    no-undo .
     1294   define variable v-diasize-wndmax               as logical   no-undo .
     1295   define variable v-diasize-wndstore             as logical   no-undo .
     1296   define variable v-diasize-proc-name            as character no-undo .
     1297   define variable v-diasize-browse-handle        as handle    no-undo .
     1298   define variable v-diasize-browse-number        as integer   no-undo .
     1299   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1300   define temp-table temp-diasize-handle no-undo
     1301     field handle-value  as handle
     1302     field save-position as decimal
     1303     index xpk is primary unique handle-value
     1304     .
     1305   define temp-table temp-browse-handle no-undo
     1306     field browse-type   as character
     1307     field browse-number as integer
     1308     field browse-handle as handle
     1309     field original-size as decimal
     1310     index xpk is primary unique browse-type browse-number
     1311     index xie browse-type browse-handle
     1312   .
     1313   procedure diasize_change-height :
     1314     define input  parameter p-change-value  as decimal   no-undo .
     1315     define input  parameter p-move-resize   as logical   no-undo .
     1316     define variable v-field-group-handle    as handle    no-undo .
     1317     define variable v-object-handle         as handle    no-undo .
     1318     define variable v-frame-height          as decimal   no-undo .
     1319     define variable v-frame-virtual-height  as decimal   no-undo .
     1320     define variable v-browse-height         as decimal   no-undo .
     1321     define variable v-window-height         as decimal   no-undo .
     1322     define variable v-window-virtual-height as decimal   no-undo .
     1323     define variable v-change-sign           as integer   no-undo .
     1324     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1325     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1326     if p-change-value > 0
     1327     then do:
     1328       if frame Dialog-Frame :height + p-change-value
     1329           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1330       then do:
     1331         assign
     1332           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1333                           - (frame Dialog-Frame :height-chars)
     1334         .
     1335         if p-change-value <= 0
     1336         then do:
     1337           run diasize_position-resize-button in this-procedure .
     1338           return .
     1339         end.
     1340       end.
     1341     end.
     1342     if p-change-value < 0
     1343     then do:
     1344       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1345       then do:
     1346         assign
     1347           p-change-value = v-diasize-orig-frame-height
     1348                          - (frame Dialog-Frame :height-chars)
     1349         .
     1350         if p-change-value >= 0
     1351         then do:
     1352           run diasize_position-resize-button in this-procedure .
     1353           return .
     1354         end.
     1355       end.
     1356     end.
     1357     if p-change-value >= 0
     1358     then do:
     1359       assign
     1360         v-change-sign = 1
     1361       .
     1362     end.
     1363     else do:
     1364       assign
     1365         v-change-sign = -1
     1366       .
     1367     end.
     1368     assign
     1369       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1370     .
     1371     if p-change-value = 0
     1372     then do:
     1373       run diasize_position-resize-button in this-procedure .
     1374       return .
     1375     end.
     1376     move_block:
     1377     do
     1378     on error undo move_block, retry move_block
     1379     :
     1380       if retry
     1381       then do:
     1382         do
     1383         on error undo move_block, leave move_block
     1384         :
     1385           if p-change-value > 0
     1386           then do:
     1387             for each buf_temp-diasize-handle
     1388             on error undo, next
     1389             :
     1390               assign
     1391                 v-object-handle = buf_temp-diasize-handle.handle-value
     1392               .
     1393               if v-object-handle <> v-diasize-resize-button
     1394               then do:
     1395                 assign
     1396                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1397                 .
     1398               end.
     1399             end.
     1400             assign
     1401               v-diasize-browse-handle :height = v-browse-height
     1402             .
     1403             for each buf_temp-browse-handle
     1404               where buf_temp-browse-handle.browse-type = 'height':u
     1405             on error undo, next
     1406             :
     1407               assign
     1408                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1409               .
     1410             end.
     1411             assign
     1412               frame Dialog-Frame :height = v-frame-height
     1413             .
     1414             if frame Dialog-Frame :scrollable = true
     1415             then do:
     1416               assign
     1417                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1418               .
     1419             end.
     1420             run diasize_position-resize-button in this-procedure .
     1421           end.
     1422           else do:
     1423             if frame Dialog-Frame :scrollable = true
     1424             then do:
     1425               assign
     1426                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1427               .
     1428             end.
     1429             assign
     1430               frame Dialog-Frame :height = v-frame-height
     1431             .
     1432             assign
     1433               v-diasize-browse-handle :height = v-browse-height
     1434             .
     1435             for each buf_temp-browse-handle
     1436               where buf_temp-browse-handle.browse-type = 'height':u
     1437             on error undo, next
     1438             :
     1439               assign
     1440                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1441               .
     1442             end.
     1443             for each buf_temp-diasize-handle
     1444             on error undo, next
     1445             :
     1446               assign
     1447                 v-object-handle = buf_temp-diasize-handle.handle-value
     1448               .
     1449               if v-object-handle <> v-diasize-resize-button
     1450               then do:
     1451                 assign
     1452                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1453                 .
     1454               end.
     1455             end.
     1456             run diasize_position-resize-button in this-procedure .
     1457           end.
     1458           assign
     1459             v-diasize-change-size = false
     1460           .
     1461           leave move_block .
     1462         end.
     1463       end.
     1464       assign
     1465         v-diasize-need-full-display = true
     1466       .
     1467       if v-diasize-change-size = false
     1468       then do:
     1469         assign
     1470           v-diasize-change-size = true
     1471         .
     1472       end.
     1473       else do:
     1474         return .
     1475       end.
     1476       assign
     1477         v-frame-height = frame Dialog-Frame :height
     1478         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1479         v-browse-height = v-diasize-browse-handle :height
     1480       .
     1481       for each buf_temp-browse-handle
     1482         where buf_temp-browse-handle.browse-type = 'height':u
     1483       :
     1484         assign
     1485           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1486         .
     1487       end.
     1488       for each buf_temp-diasize-handle
     1489       :
     1490         delete buf_temp-diasize-handle .
     1491       end.
     1492       assign
     1493         v-field-group-handle = frame Dialog-Frame :first-child
     1494       .
     1495       do while valid-handle(v-field-group-handle)
     1496       :
     1497         assign
     1498           v-object-handle = v-field-group-handle :first-child
     1499         .
     1500         do while valid-handle(v-object-handle)
     1501         :
     1502           if  v-object-handle <> v-diasize-browse-handle :handle
     1503           and can-query(v-object-handle, "row")
     1504           and can-query(v-object-handle, "height")
     1505           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1506           then do:
     1507             find first buf_temp-browse-handle
     1508               where buf_temp-browse-handle.browse-type   = 'height':u
     1509                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1510               no-error .
     1511             if available buf_temp-browse-handle
     1512             then do:
     1513             end.
     1514             else do:
     1515               create buf_temp-diasize-handle .
     1516               assign
     1517                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1518                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1519               .
     1520             end.
     1521           end.
     1522           assign
     1523             v-object-handle = v-object-handle :next-sibling
     1524           .
     1525         end.
     1526         assign
     1527           v-field-group-handle = v-field-group-handle :next-sibling
     1528         .
     1529       end.
     1530       do with frame Dialog-Frame
     1531       :
     1532         hide v-diasize-resize-button .
     1533         assign
     1534           v-diasize-resize-button :row    = 1
     1535           v-diasize-resize-button :column = 1
     1536         .
     1537       end.
     1538       if p-change-value > 0
     1539       then do:
     1540         if frame Dialog-Frame :scrollable = true
     1541         then do:
     1542           assign
     1543             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1544             no-error .
     1545           if error-status :error
     1546           or error-status :get-message(1) <> ""
     1547           then do:
     1548             undo move_block, retry move_block .
     1549           end.
     1550         end.
     1551         assign
     1552           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1553           no-error .
     1554         if error-status :error
     1555         or error-status :get-message(1) <> ""
     1556         then do:
     1557           undo move_block, retry move_block .
     1558         end.
     1559         assign
     1560           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1561           no-error .
     1562         if error-status :error
     1563         or error-status :get-message(1) <> ""
     1564         then do:
     1565           undo move_block, retry move_block .
     1566         end.
     1567         for each buf_temp-browse-handle
     1568           where buf_temp-browse-handle.browse-type = 'height':u
     1569         on error undo move_block, retry move_block
     1570         :
     1571           assign
     1572             buf_temp-browse-handle.browse-handle :height
     1573               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1574             no-error .
     1575           if error-status :error
     1576           or error-status :get-message(1) <> ""
     1577           then do:
     1578             undo move_block, retry move_block .
     1579           end.
     1580         end.
     1581         for each buf_temp-diasize-handle
     1582         on error undo move_block, retry move_block
     1583         :
     1584           assign
     1585             v-object-handle = buf_temp-diasize-handle.handle-value
     1586           .
     1587           if v-object-handle <> v-diasize-resize-button
     1588           then do:
     1589             assign
     1590               v-object-handle :row = v-object-handle :row + p-change-value
     1591               no-error .
     1592             if error-status :error
     1593             or error-status :get-message(1) <> ""
     1594             then do:
     1595               undo move_block, retry move_block .
     1596             end.
     1597           end.
     1598         end.
     1599       end.
     1600       else do:
     1601         for each buf_temp-diasize-handle
     1602         on error undo move_block, retry move_block
     1603         :
     1604           assign
     1605             v-object-handle = buf_temp-diasize-handle.handle-value
     1606           .
     1607           if v-object-handle <> v-diasize-resize-button
     1608           then do:
     1609             assign
     1610               v-object-handle :row = v-object-handle :row + p-change-value
     1611               no-error .
     1612             if error-status :error
     1613             or error-status :get-message(1) <> ""
     1614             then do:
     1615               undo move_block, retry move_block .
     1616             end.
     1617           end.
     1618         end.
     1619         assign
     1620           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1621           no-error .
     1622         if error-status :error
     1623         or error-status :get-message(1) <> ""
     1624         then do:
     1625           undo move_block, retry move_block .
     1626         end.
     1627         for each buf_temp-browse-handle
     1628           where buf_temp-browse-handle.browse-type = 'height':u
     1629         on error undo move_block, retry move_block
     1630         :
     1631           assign
     1632             buf_temp-browse-handle.browse-handle :height
     1633               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1634             no-error .
     1635           if error-status :error
     1636           or error-status :get-message(1) <> ""
     1637           then do:
     1638             undo move_block, retry move_block .
     1639           end.
     1640         end.
     1641         assign
     1642           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1643           no-error .
     1644         if error-status :error
     1645         or error-status :get-message(1) <> ""
     1646         then do:
     1647           undo move_block, retry move_block .
     1648         end.
     1649         if frame Dialog-Frame :scrollable = true
     1650         then do:
     1651           assign
     1652             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1653             no-error .
     1654           if error-status :error
     1655           or error-status :get-message(1) <> ""
     1656           then do:
     1657             undo move_block, retry move_block .
     1658           end.
     1659         end.
     1660       end.
     1661       if p-move-resize = true
     1662       then do:
     1663         run diasize_position-resize-button in this-procedure .
     1664       end.
     1665       if v-diasize-wndstore = true
     1666       then do:
     1667         if connected("ub") = true
     1668         then do:
     1669           define variable v-cntxt-db-num        as integer   no-undo .
     1670           define variable v-cntxt-userid        as character no-undo .
     1671           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1672                                             , OUTPUT v-cntxt-userid
     1673                                             ) .
     1674           run gbl/wndsizew.p
     1675             (input  v-cntxt-db-num
     1676             ,input  v-cntxt-userid
     1677             ,input  v-diasize-proc-name
     1678             ,input  'height':u
     1679             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1680             ) .
     1681         end.
     1682       end.
     1683     end.
     1684     assign
     1685       v-diasize-change-size = false
     1686     .
     1687   end procedure.
     1688   procedure diasize_set-height :
     1689     define input  parameter p-new-height  as decimal   no-undo .
     1690     define input  parameter p-move-resize as logical   no-undo .
     1691     do
     1692     on error undo, return error return-value
     1693     :
     1694       run diasize_change-height in this-procedure
     1695         (input  (p-new-height - frame Dialog-Frame :height)
     1696         ,input  p-move-resize
     1697         ) .
     1698     end.
     1699   end procedure.
     1700   procedure diasize_change-width :
     1701     define input  parameter p-change-value as decimal   no-undo .
     1702     define input  parameter p-move-resize  as logical   no-undo .
     1703     define variable v-field-group-handle   as handle    no-undo .
     1704     define variable v-object-handle        as handle    no-undo .
     1705     define variable v-frame-width          as decimal   no-undo .
     1706     define variable v-frame-virtual-width  as decimal   no-undo .
     1707     define variable v-browse-width         as decimal   no-undo .
     1708     define variable v-window-width         as decimal   no-undo .
     1709     define variable v-window-virtual-width as decimal   no-undo .
     1710     define variable v-change-sign          as integer   no-undo .
     1711     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1712     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1713     if p-change-value > 0
     1714     then do:
     1715       if frame Dialog-Frame :width + p-change-value >
     1716           session :width-chars
     1717       then do:
     1718         assign
     1719           p-change-value = session :width-chars - frame Dialog-Frame :width
     1720         .
     1721         if p-change-value <= 0
     1722         then do:
     1723           run diasize_position-resize-button in this-procedure .
     1724           return .
     1725         end.
     1726       end.
     1727     end.
     1728     if p-change-value < 0
     1729     then do:
     1730       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1731       then do:
     1732         assign
     1733           p-change-value = v-diasize-orig-frame-width
     1734                          - frame Dialog-Frame :width
     1735         .
     1736         if p-change-value >= 0
     1737         then do:
     1738           run diasize_position-resize-button in this-procedure .
     1739           return .
     1740         end.
     1741       end.
     1742     end.
     1743     if p-change-value >= 0
     1744     then do:
     1745       assign
     1746         v-change-sign = 1
     1747       .
     1748     end.
     1749     else do:
     1750       assign
     1751         v-change-sign = -1
     1752       .
     1753     end.
     1754     assign
     1755       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1756     .
     1757     if p-change-value = 0
     1758     then do:
     1759       run diasize_position-resize-button in this-procedure .
     1760       return .
     1761     end.
     1762     move_block:
     1763     do
     1764     on error undo move_block, leave move_block
     1765     :
     1766       if retry
     1767       then do:
     1768         do
     1769         on error undo move_block, leave move_block
     1770         :
     1771           if p-change-value > 0
     1772           then do:
     1773             for each buf_temp-diasize-handle
     1774             on error undo, next
     1775             :
     1776               assign
     1777                 v-object-handle = buf_temp-diasize-handle.handle-value
     1778               .
     1779               if v-object-handle <> v-diasize-resize-button
     1780               then do:
     1781                 assign
     1782                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1783                 .
     1784               end.
     1785             end.
     1786             assign
     1787               v-diasize-browse-handle :width = v-browse-width
     1788             .
     1789             for each buf_temp-browse-handle
     1790               where buf_temp-browse-handle.browse-type = 'width':u
     1791             on error undo, next
     1792             :
     1793               assign
     1794                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1795               .
     1796             end.
     1797             assign
     1798               frame Dialog-Frame :width = v-frame-width
     1799             .
     1800             if frame Dialog-Frame :scrollable = true
     1801             then do:
     1802               assign
     1803                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1804               .
     1805             end.
     1806             run diasize_position-resize-button in this-procedure .
     1807           end.
     1808           else do:
     1809             if frame Dialog-Frame :scrollable = true
     1810             then do:
     1811               assign
     1812                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1813               .
     1814             end.
     1815             assign
     1816               frame Dialog-Frame :width = v-frame-width
     1817             .
     1818             for each buf_temp-browse-handle
     1819               where buf_temp-browse-handle.browse-type = 'width':u
     1820             on error undo, next
     1821             :
     1822               assign
     1823                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1824               .
     1825             end.
     1826             assign
     1827               v-diasize-browse-handle :width = v-browse-width
     1828             .
     1829             for each buf_temp-diasize-handle
     1830             on error undo, next
     1831             :
     1832               assign
     1833                 v-object-handle = buf_temp-diasize-handle.handle-value
     1834               .
     1835               if v-object-handle <> v-diasize-resize-button
     1836               then do:
     1837                 assign
     1838                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1839                 .
     1840               end.
     1841             end.
     1842             run diasize_position-resize-button in this-procedure .
     1843           end.
     1844           assign
     1845             v-diasize-change-size = false
     1846           .
     1847           leave move_block .
     1848         end.
     1849       end.
     1850       assign
     1851         v-diasize-need-full-display = true
     1852       .
     1853       if v-diasize-change-size = false
     1854       then do:
     1855         assign
     1856           v-diasize-change-size = true
     1857         .
     1858       end.
     1859       else do:
     1860         return .
     1861       end.
     1862       assign
     1863         v-frame-width = frame Dialog-Frame :width
     1864         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1865         v-browse-width = v-diasize-browse-handle :width
     1866       .
     1867       for each buf_temp-browse-handle
     1868         where buf_temp-browse-handle.browse-type = 'width':u
     1869       :
     1870         assign
     1871           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1872         .
     1873       end.
     1874       for each buf_temp-diasize-handle
     1875       :
     1876         delete buf_temp-diasize-handle .
     1877       end.
     1878       assign
     1879         v-field-group-handle = frame Dialog-Frame :first-child
     1880       .
     1881       do while valid-handle(v-field-group-handle)
     1882       :
     1883         assign
     1884           v-object-handle = v-field-group-handle :first-child
     1885         .
     1886         do while valid-handle(v-object-handle)
     1887         :
     1888           if  v-object-handle <> v-diasize-browse-handle :handle
     1889           and v-object-handle <> v-diasize-resize-button
     1890           and can-query(v-object-handle, "row")
     1891           and can-query(v-object-handle, "height")
     1892           and ( v-object-handle :col + v-object-handle :width
     1893                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1894               )
     1895           then do:
     1896             find first buf_temp-browse-handle
     1897               where buf_temp-browse-handle.browse-type   = 'width':u
     1898                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1899               no-error .
     1900             if available buf_temp-browse-handle
     1901             then do:
     1902             end.
     1903             else do:
     1904               create buf_temp-diasize-handle .
     1905               assign
     1906                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1907                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1908               .
     1909             end.
     1910           end.
     1911           assign
     1912             v-object-handle = v-object-handle :next-sibling
     1913           .
     1914         end.
     1915         assign
     1916           v-field-group-handle = v-field-group-handle :next-sibling
     1917         .
     1918       end.
     1919       do with frame Dialog-Frame
     1920       :
     1921         hide v-diasize-resize-button .
     1922         v-diasize-resize-button :row = 1.
     1923         v-diasize-resize-button :column = 1.
     1924       end.
     1925       if p-change-value > 0
     1926       then do:
     1927         if frame Dialog-Frame :scrollable = true
     1928         then do:
     1929           assign
     1930             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1931             no-error .
     1932           if error-status :error
     1933           or error-status :get-message(1) <> ""
     1934           then do:
     1935             undo move_block, retry move_block.
     1936           end.
     1937         end.
     1938         assign
     1939           frame Dialog-Frame :width = v-frame-width + p-change-value
     1940           no-error .
     1941         if error-status :error
     1942         or error-status :get-message(1) <> ""
     1943         then do:
     1944           undo move_block, retry move_block.
     1945         end.
     1946         assign
     1947           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1948         no-error .
     1949         if error-status :error
     1950         or error-status :get-message(1) <> ""
     1951         then do:
     1952           undo move_block, retry move_block.
     1953         end.
     1954         for each buf_temp-browse-handle
     1955           where buf_temp-browse-handle.browse-type = 'width':u
     1956         on error undo move_block, retry move_block
     1957         :
     1958           assign
     1959             buf_temp-browse-handle.browse-handle :width
     1960               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1961             no-error .
     1962           if error-status :error
     1963           or error-status :get-message(1) <> ""
     1964           then do:
     1965             undo move_block, retry move_block .
     1966           end.
     1967         end.
     1968         for each buf_temp-diasize-handle
     1969         on error undo move_block, retry move_block
     1970         :
     1971           assign
     1972             v-object-handle = buf_temp-diasize-handle.handle-value
     1973           .
     1974           if v-object-handle <> v-diasize-resize-button
     1975           then do:
     1976             assign
     1977               v-object-handle :col = v-object-handle :col + p-change-value
     1978               no-error .
     1979             if error-status :error
     1980             or error-status :get-message(1) <> ""
     1981             then do:
     1982               undo move_block, retry move_block .
     1983             end.
     1984           end.
     1985         end.
     1986       end.
     1987       else do:
     1988         for each buf_temp-diasize-handle
     1989         on error undo move_block, retry move_block
     1990         :
     1991           assign
     1992             v-object-handle = buf_temp-diasize-handle.handle-value
     1993           .
     1994           if v-object-handle <> v-diasize-resize-button
     1995           then do:
     1996             assign
     1997               v-object-handle :col = v-object-handle :col + p-change-value
     1998               no-error .
     1999             if error-status :error
     2000             or error-status :get-message(1) <> ""
     2001             then do:
     2002               undo move_block, retry move_block .
     2003             end.
     2004           end.
     2005         end.
     2006         for each buf_temp-browse-handle
     2007           where buf_temp-browse-handle.browse-type = 'width':u
     2008         on error undo move_block, retry move_block
     2009         :
     2010           assign
     2011             buf_temp-browse-handle.browse-handle :width
     2012               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2013             no-error .
     2014           if error-status :error
     2015           or error-status :get-message(1) <> ""
     2016           then do:
     2017             undo move_block, retry move_block .
     2018           end.
     2019         end.
     2020         assign
     2021           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2022           no-error .
     2023         if error-status :error
     2024         or error-status :get-message(1) <> ""
     2025         then do:
     2026           undo move_block, retry move_block.
     2027         end.
     2028         assign
     2029           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2030         no-error .
     2031         if error-status :error
     2032         or error-status :get-message(1) <> ""
     2033         then do:
     2034           undo move_block, retry move_block.
     2035         end.
     2036         if frame Dialog-Frame :scrollable = true
     2037         then do:
     2038           assign
     2039             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2040           no-error .
     2041           if error-status :error
     2042           or error-status :get-message(1) <> ""
     2043           then do:
     2044             undo move_block, retry move_block.
     2045           end.
     2046         end.
     2047       end.
     2048       if p-move-resize
     2049       then do:
     2050         run diasize_position-resize-button in this-procedure .
     2051       end.
     2052       if v-diasize-wndstore = true
     2053       then do:
     2054         if connected("ub") = true
     2055         then do:
     2056           define variable v-cntxt-db-num        as integer   no-undo .
     2057           define variable v-cntxt-userid        as character no-undo .
     2058           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2059                                             , OUTPUT v-cntxt-userid
     2060                                             ) .
     2061           run gbl/wndsizew.p
     2062             (input  v-cntxt-db-num
     2063             ,input  v-cntxt-userid
     2064             ,input  v-diasize-proc-name
     2065             ,input  'width':u
     2066             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2067             ) .
     2068         end.
     2069       end.
     2070     end.
     2071     assign
     2072       v-diasize-change-size = false
     2073     .
     2074   end procedure.
     2075   procedure diasize_set-width :
     2076     define input  parameter p-new-width  as decimal   no-undo .
     2077     define input  parameter p-move-resize as logical   no-undo .
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       run diasize_change-width in this-procedure
     2082         (input  (p-new-width - frame Dialog-Frame :width)
     2083         ,input  p-move-resize
     2084         ) .
     2085     end.
     2086   end procedure.
     2087   procedure diasize_position-resize-button :
     2088     do with frame Dialog-Frame
     2089     :
     2090       hide v-diasize-resize-button .
     2091       assign
     2092         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2093                     - 1
     2094                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2095         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2096                     - 1
     2097                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2098       .
     2099       view v-diasize-resize-button .
     2100     end.
     2101   end procedure.
     2102   on alt-right anywhere
     2103   do:
     2104     run diasize_change-width in this-procedure
     2105       (input 1
     2106       ,input true
     2107       ) .
     2108     return no-apply .
     2109   end.
     2110   on alt-left anywhere
     2111   do:
     2112     run diasize_change-width in this-procedure
     2113       (input -1
     2114       ,input true
     2115       ) .
     2116     return no-apply .
     2117   end.
     2118   on alt-down anywhere
     2119   do:
     2120     run diasize_change-height in this-procedure
     2121       (input 1
     2122       ,input true
     2123       ) .
     2124     return no-apply .
     2125   end.
     2126   on alt-up anywhere
     2127   do:
     2128     run diasize_change-height in this-procedure
     2129       (input -1
     2130       ,input true
     2131       ) .
     2132     return no-apply .
     2133   end.
     2134   on alt-enter of frame Dialog-Frame
     2135   do:
     2136     run diasize_maximize in this-procedure
     2137       (input  ?
     2138       ).
     2139     return no-apply .
     2140   end.
     2141   procedure diasize_end-move :
     2142     do
     2143     on error undo, return error return-value
     2144     :
     2145       define variable v-row-delta as decimal   no-undo .
     2146       define variable v-col-delta as decimal   no-undo .
     2147       define variable v-new-row as decimal   no-undo .
     2148       define variable v-new-col as decimal   no-undo .
     2149       assign
     2150         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2151         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2152       .
     2153       assign
     2154         v-row-delta = v-new-row - frame Dialog-Frame :height
     2155         v-col-delta = v-new-col - frame Dialog-Frame :width
     2156       .
     2157       run diasize_change-height in this-procedure
     2158         (input v-row-delta
     2159         ,input true
     2160         ) .
     2161       run diasize_change-width in this-procedure
     2162         (input v-col-delta
     2163         ,input true
     2164         ) .
     2165     end.
     2166   end procedure.
     2167   procedure diasize_maximize :
     2168     define input  parameter p-action as logical   no-undo .
     2169     do
     2170     on error undo, return error return-value
     2171     :
     2172       if p-action = ?
     2173       then do:
     2174         if v-diasize-need-maximize = true
     2175         then do:
     2176           assign
     2177             p-action = true
     2178           .
     2179         end.
     2180         else do:
     2181           assign
     2182             p-action = false
     2183           .
     2184         end.
     2185       end.
     2186       if p-action = true
     2187       then do:
     2188         run diasize_change-height in this-procedure
     2189           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2190               - frame Dialog-Frame :height-chars
     2191           ,input true
     2192           ) .
     2193         run diasize_change-width in this-procedure
     2194           (input session :width-chars
     2195               - frame Dialog-Frame :width-chars
     2196           ,input true
     2197           ) .
     2198         assign
     2199           v-diasize-need-maximize = false
     2200         .
     2201       end.
     2202       else do:
     2203         run diasize_change-width in this-procedure
     2204           (input v-diasize-orig-frame-width
     2205               - frame Dialog-Frame :width-chars
     2206           ,input true
     2207           ) .
     2208         run diasize_change-height in this-procedure
     2209           (input v-diasize-orig-frame-height
     2210               - frame Dialog-Frame :height-chars
     2211           ,input true
     2212           ) .
     2213         assign
     2214           v-diasize-need-maximize = true
     2215         .
     2216       end.
     2217     end.
     2218   end procedure.
     2219   procedure diasize_restore-orig-size :
     2220     do
     2221     on error undo, return error return-value
     2222     :
     2223       assign
     2224         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2225         v-diasize-current-frame-height = frame Dialog-Frame :height
     2226       .
     2227       run diasize_set-height in this-procedure
     2228         (input  v-diasize-orig-frame-height
     2229         ,input  true
     2230         ) .
     2231       run diasize_set-width in this-procedure
     2232         (input  v-diasize-orig-frame-width
     2233         ,input  true
     2234         ) .
     2235     end.
     2236   end procedure.
     2237   procedure diasize_restore-current-size :
     2238     do
     2239     on error undo, return error return-value
     2240     :
     2241       run diasize_set-height in this-procedure
     2242         (input  v-diasize-current-frame-height
     2243         ,input  true
     2244         ) .
     2245       run diasize_set-width in this-procedure
     2246         (input  v-diasize-current-frame-width
     2247         ,input  true
     2248         ) .
     2249     end.
     2250   end procedure.
     2251   procedure diasize_set-browse-handle :
     2252     define input  parameter p-browse-handle as handle   no-undo .
     2253     define buffer buf_temp-browse-handle for temp-browse-handle .
     2254     do
     2255     on error undo, return error return-value
     2256     :
     2257       assign
     2258         v-diasize-browse-handle = p-browse-handle
     2259       .
     2260       for each buf_temp-browse-handle
     2261       on error undo, return error return-value
     2262       :
     2263         delete buf_temp-browse-handle .
     2264       end.
     2265     end.
     2266   end procedure.
     2267   procedure diasize_add_browse :
     2268     define input  parameter p-browse-type   as character no-undo .
     2269     define input  parameter p-browse-handle as handle    no-undo .
     2270     define buffer buf_temp-browse-handle for temp-browse-handle .
     2271     do
     2272     on error undo, return error return-value
     2273     :
     2274       assign
     2275         v-diasize-browse-number = v-diasize-browse-number + 1
     2276       .
     2277       create buf_temp-browse-handle .
     2278       assign
     2279         buf_temp-browse-handle.browse-type   = p-browse-type
     2280         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2281         buf_temp-browse-handle.browse-handle = p-browse-handle
     2282       .
     2283     end.
     2284   end procedure.
     2285   procedure diasize_init :
     2286     define variable v-default-value    as logical   no-undo .
     2287     define variable v-restore-saved    as logical   no-undo .
     2288     define variable v-resize-value-str as character no-undo .
     2289     do
     2290     on error undo, return error return-value
     2291     :
     2292       do with frame Dialog-Frame
     2293       :
     2294         assign
     2295           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2296           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2297           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2298         .
     2299         create button v-diasize-resize-button
     2300         assign
     2301           parent        = frame Dialog-Frame :first-child
     2302           label         = "s"
     2303           height-pixels = 16
     2304           width-pixels  = 16
     2305           visible       = true
     2306           sensitive     = true
     2307           movable       = true
     2308           triggers:
     2309             on end-move persistent run diasize_end-move in this-procedure .
     2310           end triggers.
     2311         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2312         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2313         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2314         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2315         assign
     2316           v-diasize-wndmax = false
     2317         .
     2318         if connected("ub") = true
     2319         then do:
     2320           define variable v-cntxt-db-num        as integer   no-undo .
     2321           define variable v-cntxt-userid        as character no-undo .
     2322           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2323                                             , OUTPUT v-cntxt-userid
     2324                                             ) .
     2325           run gbl/wndpar_r.p
     2326             (input  v-cntxt-db-num
     2327             ,input  v-cntxt-userid
     2328             ,input  'wndmax':U
     2329             ,output v-diasize-wndmax
     2330             ,output v-default-value
     2331             ) .
     2332         end.
     2333         assign
     2334           v-diasize-wndstore = false
     2335         .
     2336         if connected("ub") = true
     2337         then do:
     2338           run gbl/wndpar_r.p
     2339             (input  v-cntxt-db-num
     2340             ,input  v-cntxt-userid
     2341             ,input  'wndstore':U
     2342             ,output v-diasize-wndstore
     2343             ,output v-default-value
     2344             ) .
     2345         end.
     2346         assign
     2347           v-diasize-proc-name = entry(1, program-name(2), '.')
     2348         .
     2349         if v-diasize-wndstore = true
     2350         then do:
     2351           assign
     2352             v-restore-saved = false
     2353           .
     2354           if connected("ub") = true
     2355           then do:
     2356             run gbl/wndsizer.p
     2357               (input  v-cntxt-db-num
     2358               ,input  v-cntxt-userid
     2359               ,input  v-diasize-proc-name
     2360               ,input  'height':u
     2361               ,output v-resize-value-str
     2362               ) .
     2363             if v-resize-value-str <> '':U
     2364             then do:
     2365               run diasize_change-height in this-procedure
     2366                 (input  integer(v-resize-value-str)
     2367                 ,input  true
     2368                 ) .
     2369               assign
     2370                 v-restore-saved = true
     2371               .
     2372             end.
     2373           end.
     2374           if connected("ub") = true
     2375           then do:
     2376             run gbl/wndsizer.p
     2377               (input  v-cntxt-db-num
     2378               ,input  v-cntxt-userid
     2379               ,input  v-diasize-proc-name
     2380               ,input  'width':u
     2381               ,output v-resize-value-str
     2382               ) .
     2383             if v-resize-value-str <> '':U
     2384             then do:
     2385               run diasize_change-width in this-procedure
     2386                 (input  integer(v-resize-value-str)
     2387                 ,input  true
     2388                 ) .
     2389               assign
     2390                 v-restore-saved = true
     2391               .
     2392             end.
     2393           end.
     2394           if v-restore-saved <> true
     2395           then do:
     2396             if v-diasize-wndmax = true
     2397             then do:
     2398               run diasize_maximize in this-procedure
     2399                 (input  true
     2400                 ) .
     2401             end.
     2402           end.
     2403         end.
     2404         else do:
     2405           if v-diasize-wndmax = true
     2406           then do:
     2407             run diasize_maximize in this-procedure
     2408               (input  true
     2409               ) .
     2410           end.
     2411         end.
     2412       end.
     2413     end.
     2414   end procedure.
     2415   procedure diasize_need-full-display :
     2416     define output parameter p-need-full-display as logical   no-undo .
     2417     do
     2418     on error undo, return error return-value
     2419     :
     2420       assign
     2421         p-need-full-display = v-diasize-need-full-display
     2422       .
     2423       assign
     2424         v-diasize-need-full-display = false
     2425       .
     2426     end.
     2427   end procedure.
     2428   procedure get-context :
     2429      define output parameter p-db-num as integer          no-undo.
     2430      define output parameter p-user-id as character        no-undo.
     2431      define variable v-login               as character    no-undo.
     2432      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2433      define buffer buf_user-login  for ub.user-login .
     2434      do
     2435      on error undo, return error
     2436      :
     2437            FIND FIRST buf_sys-ctrl no-lock.
     2438            ASSIGN
     2439               v-login = USERID("ub")
     2440               p-db-num = buf_sys-ctrl.db-num
     2441            .
     2442            FIND FIRST buf_user-login
     2443                 WHERE buf_user-login.db-num = p-db-num
     2444                   AND buf_user-login.user-login = v-login
     2445                 no-lock
     2446                 no-error
     2447                 .
     2448            IF AVAILABLE buf_user-login
     2449            THEN DO:
     2450               assign
     2451                  p-user-id = buf_user-login.user-id
     2452               .
     2453            END.
     2454      end.
     2455   end procedure.
     2456       run diasize_init in this-procedure .
     2457   assign
     2458     RADIO-SET-sort   = 2
     2459     RADIO-SET-filter = 3
     2460     v-sort-mode      = 'sort-sort-code':u
     2461     v-filter-mode    = 'filter-not-zero':u
     2462   .
     2463   assign
     2464     p-sel-node-code = ?
     2465   .
     2466   define variable v-ok as logical   no-undo .
     2467   assign
     2468     v-ok = BROWSE-1 :set-repositioned-row(5, "conditional")
     2469   .
     2470   MAIN-BLOCK:
     2471   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2472      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2473     run validate-input-parameters in this-procedure .
     2474     run make-temp-table in this-procedure .
     2475     run waitfram-hide in this-procedure .
     2476     RUN enable_UI.
     2477     run show-input-info in this-procedure .
     2478     if fi-search-b-code <> ""
     2479     then do:
     2480       run search-bar-code in this-procedure
     2481         (input fi-search-b-code
     2482         ,input true
     2483         ) no-error .
     2484       if error-status :error
     2485       then do:
     2486         assign
     2487           fi-search-b-code :screen-value = ""
     2488         .
     2489         assign
     2490           fi-search-b-code
     2491         .
     2492       end.
     2493     end.
     2494     if p-mode = 'выбор':U
     2495     then do:
     2496       assign
     2497         b-sel :sensitive = true
     2498       .
     2499     end.
     2500     else do:
     2501       assign
     2502         b-sel :sensitive = false
     2503       .
     2504     end.
     2505     define variable v-empty-scale as logical   no-undo .
     2506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     2507     (input  p-gds-code
     2508     ,input  'empty-scale=request':u
     2509     ,output v-empty-scale
     2510     )  .
     2511     if v-empty-scale = false
     2512     then do:
     2513       assign
     2514         b-crebcprt :sensitive = true
     2515       .
     2516     end.
     2517     else do:
     2518       assign
     2519         b-crebcprt :sensitive = false
     2520       .
     2521     end.
     2522     apply 'entry':U to BROWSE-1.
     2523     WAIT-FOR GO OF FRAME Dialog-Frame.
     2524   END.
     2525   RUN disable_UI.
     2526   PROCEDURE disable_UI :
     2527     HIDE FRAME Dialog-Frame.
     2528   END PROCEDURE.
     2529   PROCEDURE enable_UI :
     2530     DISPLAY fi-search-b-code RADIO-SET-sort RADIO-SET-filter fi-gds-label fi-gds
     2531             fi-obj fi-obj-label fi-free fi-sort-label fi-fact fi-filter-label
     2532         WITH FRAME Dialog-Frame.
     2533     ENABLE b-exit b-sel b-check b-codes b-alt b-rest b-arch b-prt-arch b-print
     2534            b-help b-scale b-print-ticket b-crebcprt b-refresh fi-search-b-code
     2535            RADIO-SET-sort RADIO-SET-filter BROWSE-1 fi-gds-label fi-gds fi-obj
     2536            fi-obj-label fi-free fi-sort-label fi-fact fi-filter-label
     2537         WITH FRAME Dialog-Frame.
     2538     VIEW FRAME Dialog-Frame.
     2539     run local-open-query in this-procedure (input ? ) .
     2540   END PROCEDURE.
     2541   PROCEDURE get-sort-code :
     2542     define input  parameter p-node-code as integer   no-undo .
     2543     define output parameter p-sort-code as character no-undo .
     2544     define buffer buf_gds-prt for ub.gds-prt .
     2545     define variable v-upper-code as integer   no-undo .
     2546     define variable v-sort-code  as character no-undo .
     2547     define variable v-curr-node-sort as character no-undo .
     2548     find first buf_gds-prt no-lock
     2549       where buf_gds-prt.node-code = p-node-code
     2550       no-error .
     2551     do while true
     2552     :
     2553       assign
     2554         v-curr-node-sort = string(buf_gds-prt.prt-num, '999999999':u)
     2555       .
     2556       assign
     2557         v-upper-code = buf_gds-prt.upper-code
     2558       .
     2559       find first buf_gds-prt no-lock
     2560         where buf_gds-prt.node-code = v-upper-code
     2561         no-error .
     2562       if not available buf_gds-prt
     2563       then do:
     2564         leave .
     2565       end.
     2566       assign
     2567         v-sort-code = v-curr-node-sort  + '/' + v-sort-code
     2568       .
     2569     end.
     2570     assign
     2571       p-sort-code = v-sort-code
     2572     .
     2573   END PROCEDURE.
     2574   PROCEDURE local-open-query :
     2575     define input  parameter p-reposition-b-code as integer   no-undo .
     2576     define variable v-last-b-code as integer   no-undo .
     2577     if p-reposition-b-code <> ?
     2578     then do:
     2579       assign
     2580         v-last-b-code = p-reposition-b-code
     2581       .
     2582     end.
     2583     else do:
     2584       if available temp-gds-prt
     2585       then do:
     2586         assign
     2587           v-last-b-code = temp-gds-prt.b-code
     2588         .
     2589       end.
     2590       else do:
     2591         assign
     2592           v-last-b-code = ?
     2593         .
     2594       end.
     2595     end.
     2596     if  v-need-refresh = true
     2597     and v-filter-mode = 'filter-b-code':u
     2598     then do:
     2599       run make-temp-table in this-procedure no-error .
     2600       run waitfram-hide in this-procedure .
     2601       assign
     2602         v-need-refresh = false
     2603       .
     2604     end.
     2605     display
     2606       v-free-qnty @ fi-free
     2607       v-fact-qnty @ fi-fact
     2608       with frame Dialog-Frame .
     2609     case v-filter-mode :
     2610       when 'filter-b-code':u then do:
     2611         case v-sort-mode
     2612         :
     2613           when 'sort-b-code':u
     2614           then do:
     2615             open query BROWSE-1 for each temp-gds-prt
     2616               where temp-gds-prt.show-list = true
     2617               by b-code .
     2618           end.
     2619           when 'sort-sort-code':u
     2620           then do:
     2621             open query BROWSE-1 for each temp-gds-prt
     2622               where temp-gds-prt.show-list = true
     2623               by sort-code .
     2624           end.
     2625           when 'sort-tree':u
     2626           then do:
     2627             open query BROWSE-1 for each temp-gds-prt
     2628               by sort-code .
     2629           end.
     2630           otherwise do:
     2631             message
     2632               vss-workfile vss-revision vss-description skip
     2633               "Внутренняя ошибка" skip
     2634               "Неизвестное значение переменной v-sort-mode" skip
     2635               "" v-sort-mode skip
     2636               view-as alert-box error .
     2637             undo, return error return-value .
     2638           end.
     2639         end case.
     2640       end.
     2641       when 'filter-prt-obj':u then do:
     2642         case v-sort-mode
     2643         :
     2644           when 'sort-b-code':u
     2645           then do:
     2646             open query BROWSE-1 for each temp-gds-prt
     2647               where temp-gds-prt.show-prt = true
     2648                 and temp-gds-prt.show-list = true
     2649               by b-code .
     2650           end.
     2651           when 'sort-sort-code':u
     2652           then do:
     2653             open query BROWSE-1 for each temp-gds-prt
     2654               where temp-gds-prt.show-prt = true
     2655                 and temp-gds-prt.show-list = true
     2656               by sort-code .
     2657           end.
     2658           when 'sort-tree':u
     2659           then do:
     2660             open query BROWSE-1 for each temp-gds-prt
     2661               where temp-gds-prt.show-prt = true
     2662               by sort-code .
     2663           end.
     2664           otherwise do:
     2665             message
     2666               vss-workfile vss-revision vss-description skip
     2667               "Внутренняя ошибка" skip
     2668               "Неизвестное значение переменной v-sort-mode" skip
     2669               "" v-sort-mode skip
     2670               view-as alert-box error .
     2671             undo, return error return-value .
     2672           end.
     2673         end case.
     2674       end.
     2675       when 'filter-not-zero':u then do:
     2676         case v-sort-mode
     2677         :
     2678           when 'sort-b-code':u
     2679           then do:
     2680             open query BROWSE-1 for each temp-gds-prt
     2681               where temp-gds-prt.show-rest = true
     2682                 and temp-gds-prt.show-list = true
     2683               by b-code .
     2684           end.
     2685           when 'sort-sort-code':u
     2686           then do:
     2687             open query BROWSE-1 for each temp-gds-prt
     2688               where temp-gds-prt.show-rest = true
     2689                 and temp-gds-prt.show-list = true
     2690               by sort-code .
     2691           end.
     2692           when 'sort-tree':u
     2693           then do:
     2694             open query BROWSE-1 for each temp-gds-prt
     2695               where temp-gds-prt.show-rest = true
     2696               by sort-code .
     2697           end.
     2698           otherwise do:
     2699             message
     2700               vss-workfile vss-revision vss-description skip
     2701               "Внутренняя ошибка" skip
     2702               "Неизвестное значение переменной v-sort-mode" skip
     2703               "" v-sort-mode skip
     2704               view-as alert-box error .
     2705             undo, return error return-value .
     2706           end.
     2707         end case.
     2708       end.
     2709       otherwise do:
     2710         message
     2711           vss-workfile vss-revision vss-description skip
     2712           "Внутренняя ошибка" skip
     2713           "Неизвестное значение переменной v-filter-mode" skip
     2714           "" v-filter-mode skip
     2715           view-as alert-box error .
     2716         undo, return error return-value .
     2717       end.
     2718     end.
     2719     if v-last-b-code <> ?
     2720     then do:
     2721       define buffer buf_reposition_temp-gds-prt for temp-gds-prt .
     2722       define variable v-reposition-rowid as rowid     no-undo .
     2723       find first buf_reposition_temp-gds-prt
     2724         where buf_reposition_temp-gds-prt.b-code = v-last-b-code
     2725         no-error .
     2726       if available buf_reposition_temp-gds-prt
     2727       then do:
     2728         assign
     2729           v-reposition-rowid = rowid(buf_reposition_temp-gds-prt)
     2730         .
     2731         reposition BROWSE-1 to rowid v-reposition-rowid no-error .
     2732         if error-status :error
     2733         then do:
     2734           reposition BROWSE-1 to row 1 .
     2735         end.
     2736       end.
     2737     end.
     2738   END PROCEDURE.
     2739   PROCEDURE make-temp-table :
     2740     define buffer buf_temp-gds-prt for temp-gds-prt .
     2741     define buffer buf_goods        for ub.goods .
     2742     define buffer buf_prt-obj      for ub.prt-obj .
     2743     define buffer buf_bar-code     for ub.bar-code .
     2744     define buffer buf_gds-prt      for ub.gds-prt .
     2745     for each buf_temp-gds-prt
     2746     on error undo, return error return-value
     2747     :
     2748       delete buf_temp-gds-prt .
     2749     end.
     2750     assign
     2751       v-free-qnty = 0
     2752       v-fact-qnty = 0
     2753     .
     2754     find first buf_goods no-lock
     2755       where buf_goods.gds-code = p-gds-code
     2756       .
     2757     define variable v-root-node as integer   no-undo .
     2758     define variable v-prt-level as integer   no-undo .
     2759   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsrtnod in g#library
     2761     (input  p-gds-code
     2762     ,output v-root-node
     2763     )  .
     2764   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtlevel in g#library
     2765     (input  v-root-node
     2766     ,output v-prt-level
     2767     )  .
     2768     define variable v-ind as integer   no-undo .
     2769     assign
     2770       v-ind = 0
     2771     .
     2772     for each buf_prt-obj no-lock
     2773       where buf_prt-obj.obj-type  = p-obj-type
     2774         and buf_prt-obj.obj-code  = p-obj-code
     2775         and buf_prt-obj.artic     = buf_goods.artic
     2776         and buf_prt-obj.prod-type = buf_goods.prod-type
     2777         and buf_prt-obj.prod-code = buf_goods.prod-code
     2778     on error undo, return error return-value
     2779     :
     2780       assign
     2781         v-ind = v-ind + 1
     2782       .
     2783       if v-ind modulo 10 = 0
     2784       then do:
     2785         run waitfram-show in this-procedure
     2786           (input substitute("Просмотр признаков товара на объекте &1", v-ind)
     2787           ) .
     2788       end.
     2789       define variable v-node-code as integer   no-undo .
     2790       assign
     2791         v-node-code = buf_prt-obj.prt-code
     2792       .
     2793       define variable v-is-new as logical   no-undo .
     2794   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     2796     (input  buf_goods.gds-code
     2797     ,input  v-node-code
     2798     ,input  ''
     2799     ,input  ''
     2800     ,input  buf_goods.unit-base
     2801     ,input  ?
     2802     ,output v-is-new
     2803     ,buffer buf_bar-code
     2804     )  .
     2805       define variable v-term-prt as logical   no-undo .
     2806   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2807     (input  v-node-code
     2808     ,input  'terminal-prt=request':u
     2809     ,output v-term-prt
     2810     )  .
     2811       if v-term-prt = true
     2812       then do:
     2813         find first buf_gds-prt no-lock
     2814           where buf_gds-prt.node-code = v-node-code
     2815           .
     2816         create buf_temp-gds-prt .
     2817         assign
     2818           buf_temp-gds-prt.b-code     = buf_bar-code.b-code
     2819           buf_temp-gds-prt.node-code  = v-node-code
     2820           buf_temp-gds-prt.upper-code = buf_gds-prt.upper-code
     2821           buf_temp-gds-prt.prt-name   = buf_gds-prt.f-name
     2822           buf_temp-gds-prt.node-name  = buf_gds-prt.node-name
     2823           buf_temp-gds-prt.free-qnty  = buf_prt-obj.free-qnty
     2824           buf_temp-gds-prt.fact-qnty  = buf_prt-obj.fact-qnty
     2825           buf_temp-gds-prt.price      = buf_prt-obj.price-sale
     2826           buf_temp-gds-prt.price-ord  = ?
     2827           buf_temp-gds-prt.diff-qnty  = 0
     2828           buf_temp-gds-prt.rest-qnty  = 0
     2829           buf_temp-gds-prt.show-list  = true
     2830           buf_temp-gds-prt.show-prt   = true
     2831           buf_temp-gds-prt.show-rest  = false
     2832           buf_temp-gds-prt.prt-level  = v-prt-level
     2833         .
     2834         assign
     2835           v-free-qnty = v-free-qnty + buf_prt-obj.free-qnty
     2836           v-fact-qnty = v-fact-qnty + buf_prt-obj.fact-qnty
     2837         .
     2838         if (buf_temp-gds-prt.free-qnty <> 0
     2839              and buf_temp-gds-prt.free-qnty <> ?
     2840             )
     2841         or (buf_temp-gds-prt.fact-qnty <> 0
     2842              and buf_temp-gds-prt.fact-qnty = ?
     2843             )
     2844         then do:
     2845           assign
     2846             buf_temp-gds-prt.show-rest = true
     2847           .
     2848         end.
     2849         run get-sort-code in this-procedure
     2850           (input  buf_temp-gds-prt.node-code
     2851           ,output buf_temp-gds-prt.sort-code
     2852           ) .
     2853       end.
     2854     end.
     2855     assign
     2856       v-ind = 0
     2857     .
     2858     for each buf_bar-code no-lock
     2859       where buf_bar-code.gds-code  = p-gds-code
     2860         and buf_bar-code.part-code = ""
     2861         and buf_bar-code.in-code   = ""
     2862         and buf_bar-code.unit-cli  = buf_goods.unit-base
     2863     on error undo, return error return-value
     2864     :
     2865       assign
     2866         v-ind = v-ind + 1
     2867       .
     2868       if v-ind modulo 10 = 0
     2869       then do:
     2870         run waitfram-show in this-procedure
     2871           (input substitute("Просмотр бар-кодов &1", v-ind)
     2872           ) .
     2873       end.
     2874       find first buf_temp-gds-prt
     2875         where buf_temp-gds-prt.node-code = buf_bar-code.node-code
     2876         no-error .
     2877       if not available buf_temp-gds-prt
     2878       then do:
     2879   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2880     (input  buf_bar-code.node-code
     2881     ,input  'terminal-prt=request':u
     2882     ,output v-term-prt
     2883     )  .
     2884         if v-term-prt = true
     2885         then do:
     2886           find first buf_gds-prt no-lock
     2887             where buf_gds-prt.node-code = buf_bar-code.node-code
     2888             .
     2889           create buf_temp-gds-prt .
     2890           assign
     2891             buf_temp-gds-prt.b-code     = buf_bar-code.b-code
     2892             buf_temp-gds-prt.node-code  = buf_bar-code.node-code
     2893             buf_temp-gds-prt.upper-code = buf_gds-prt.upper-code
     2894             buf_temp-gds-prt.prt-name   = buf_gds-prt.f-name
     2895             buf_temp-gds-prt.node-name  = buf_gds-prt.node-name
     2896             buf_temp-gds-prt.free-qnty  = 0
     2897             buf_temp-gds-prt.fact-qnty  = 0
     2898             buf_temp-gds-prt.price      = ?
     2899             buf_temp-gds-prt.price-ord  = ?
     2900             buf_temp-gds-prt.diff-qnty  = 0
     2901             buf_temp-gds-prt.rest-qnty  = 0
     2902             buf_temp-gds-prt.show-list  = true
     2903             buf_temp-gds-prt.show-prt   = false
     2904             buf_temp-gds-prt.show-rest  = false
     2905             buf_temp-gds-prt.prt-level  = v-prt-level
     2906           .
     2907           run get-sort-code in this-procedure
     2908             (input  buf_temp-gds-prt.node-code
     2909             ,output buf_temp-gds-prt.sort-code
     2910             ) .
     2911         end.
     2912       end.
     2913     end.
     2914     define variable v-level-tree as integer   no-undo .
     2915     do v-level-tree = v-prt-level to 2 by -1
     2916     :
     2917       define buffer upper_temp-gds-prt for temp-gds-prt .
     2918       for each buf_temp-gds-prt
     2919         where buf_temp-gds-prt.prt-level = v-level-tree
     2920       :
     2921         find first upper_temp-gds-prt
     2922           where upper_temp-gds-prt.node-code = buf_temp-gds-prt.upper-code
     2923           no-error .
     2924         if not available upper_temp-gds-prt
     2925         then do:
     2926           find first buf_gds-prt no-lock
     2927             where buf_gds-prt.node-code = buf_temp-gds-prt.upper-code
     2928             .
     2929           find first buf_goods no-lock
     2930             where buf_goods.gds-code = p-gds-code
     2931             .
     2932           find first buf_bar-code no-lock
     2933             where buf_bar-code.gds-code  = buf_goods.gds-code
     2934               and buf_bar-code.node-code = buf_gds-prt.node-code
     2935               and buf_bar-code.part-code = ""
     2936               and buf_bar-code.in-code   = ""
     2937               and buf_bar-code.unit-cli  = buf_goods.unit-base
     2938             no-error .
     2939           define variable v-b-code as integer   no-undo .
     2940           if available buf_bar-code
     2941           then do:
     2942             assign
     2943               v-b-code = buf_bar-code.b-code
     2944             .
     2945           end.
     2946           else do:
     2947             assign
     2948               v-b-code = ?
     2949             .
     2950           end.
     2951           create upper_temp-gds-prt .
     2952           assign
     2953             upper_temp-gds-prt.b-code     = v-b-code
     2954             upper_temp-gds-prt.node-code  = buf_gds-prt.node-code
     2955             upper_temp-gds-prt.upper-code = buf_gds-prt.upper-code
     2956             upper_temp-gds-prt.prt-name   = ( if v-level-tree <> 2
     2957                                               then buf_gds-prt.f-name
     2958                                               else buf_gds-prt.node-name
     2959                                             )
     2960             upper_temp-gds-prt.node-name  = buf_gds-prt.node-name
     2961             upper_temp-gds-prt.free-qnty  = 0
     2962             upper_temp-gds-prt.fact-qnty  = 0
     2963             upper_temp-gds-prt.price      = ?
     2964             upper_temp-gds-prt.price-ord  = ?
     2965             upper_temp-gds-prt.diff-qnty  = 0
     2966             upper_temp-gds-prt.rest-qnty  = 0
     2967             upper_temp-gds-prt.show-list  = false
     2968             upper_temp-gds-prt.show-prt   = false
     2969             upper_temp-gds-prt.show-rest  = false
     2970             upper_temp-gds-prt.prt-level  = v-level-tree - 1
     2971           .
     2972           run get-sort-code in this-procedure
     2973             (input  upper_temp-gds-prt.node-code
     2974             ,output upper_temp-gds-prt.sort-code
     2975             ) .
     2976         end.
     2977         assign
     2978           upper_temp-gds-prt.free-qnty = upper_temp-gds-prt.free-qnty + buf_temp-gds-prt.free-qnty
     2979           upper_temp-gds-prt.fact-qnty = upper_temp-gds-prt.fact-qnty + buf_temp-gds-prt.fact-qnty
     2980         .
     2981         if buf_temp-gds-prt.show-prt = true
     2982         then do:
     2983           assign
     2984             upper_temp-gds-prt.show-prt = true
     2985           .
     2986         end.
     2987         if buf_temp-gds-prt.show-rest = true
     2988         then do:
     2989           assign
     2990             upper_temp-gds-prt.show-rest = true
     2991           .
     2992         end.
     2993       end.
     2994     end.
     2995   END PROCEDURE.
     2996   PROCEDURE print-temp-gds-prt :
     2997     define variable v-curr-rowid as rowid no-undo .
     2998     assign
     2999       v-curr-rowid = rowid(temp-gds-prt)
     3000     .
     3001     run ref/prtobxls.p
     3002       (input this-procedure :handle
     3003       ,input frame Dialog-Frame :title
     3004       ,input "Сортировка/Вид"
     3005       ,input radio-label(string(RADIO-SET-sort),   RADIO-SET-sort   :radio-buttons)
     3006       ,input "Фильтр"
     3007       ,input radio-label(string(RADIO-SET-filter), RADIO-SET-filter :radio-buttons)
     3008       ) .
     3009     reposition BROWSE-1 to rowid v-curr-rowid no-error .
     3010     if error-status :error
     3011     then do:
     3012       reposition BROWSE-1 to row 1 .
     3013     end.
     3014   END PROCEDURE.
     3015   PROCEDURE prt-ref_get-current :
     3016     define output parameter p-available as logical   no-undo .
     3017     define output parameter p-b-code    as integer   no-undo .
     3018     define output parameter p-prt-name  as character no-undo .
     3019     define output parameter p-free-qnty as decimal   no-undo .
     3020     define output parameter p-fact-qnty as decimal   no-undo .
     3021     define output parameter p-price     as decimal   no-undo .
     3022     if available temp-gds-prt
     3023     then do:
     3024       assign
     3025         p-available = true
     3026         p-b-code    = temp-gds-prt.b-code
     3027         p-prt-name  = get-prt-name(buffer temp-gds-prt)
     3028         p-free-qnty = temp-gds-prt.free-qnty
     3029         p-fact-qnty = temp-gds-prt.fact-qnty
     3030         p-price     = temp-gds-prt.price
     3031       .
     3032     end.
     3033     else do:
     3034       assign
     3035         p-available = false
     3036       .
     3037     end.
     3038   END PROCEDURE.
     3039   PROCEDURE prt-ref_get-first :
     3040     apply "home":u to browse BROWSE-1 .
     3041   END PROCEDURE.
     3042   PROCEDURE prt-ref_get-next :
     3043     get next BROWSE-1 .
     3044   END PROCEDURE.
     3045   PROCEDURE search-bar-code :
     3046     define input  parameter p-search-code  as character no-undo .
     3047     define input  parameter p-first-search as logical   no-undo .
     3048     define buffer buf_temp-gds-prt for temp-gds-prt .
     3049     define buffer buf_bar-code for ub.bar-code .
     3050     define buffer buf_goods    for ub.goods .
     3051     define variable v-b-code as integer   no-undo .
     3052     run gbl/getbcode.p
     3053       (input  parparentproc
     3054       ,input  p-search-code
     3055       ,input  p-obj-type
     3056       ,input  p-obj-code
     3057       ,input  true
     3058       ,output v-b-code
     3059       ) .
     3060     if v-b-code = ?
     3061     then do:
     3062       if p-first-search <> true
     3063       then do:
     3064         message
     3065           "Бар-код не найден !"
     3066           "Бар-код" p-search-code skip
     3067           view-as alert-box error .
     3068       end.
     3069       undo, return error return-value .
     3070     end.
     3071     find first buf_bar-code no-lock
     3072       where buf_bar-code.b-code = v-b-code
     3073       no-error .
     3074     if not available buf_bar-code
     3075     then do:
     3076       if p-first-search <> true
     3077       then do:
     3078         message
     3079           vss-workfile vss-revision vss-description skip
     3080           "Бар-код не найден !"
     3081           "Бар-код" v-b-code skip
     3082           view-as alert-box error .
     3083       end.
     3084       undo, return error return-value .
     3085     end.
     3086     if buf_bar-code.gds-code <> p-gds-code
     3087     then do:
     3088       if p-first-search <> true
     3089       then do:
     3090         find first buf_goods no-lock
     3091           where buf_goods.gds-code = buf_bar-code.gds-code
     3092           .
     3093         message
     3094           "Заданный бар-код принадлежит другому товару" skip
     3095           "В данном окне поиск работает только внутри бар-кодов одного товара"
     3096           "Бар-код" fi-search-b-code skip
     3097           "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     3098           buf_goods.gds-name skip
     3099           view-as alert-box information .
     3100       end.
     3101       undo, return error return-value .
     3102     end.
     3103     find first buf_temp-gds-prt
     3104       where buf_temp-gds-prt.node-code = buf_bar-code.node-code
     3105       no-error .
     3106     if available buf_temp-gds-prt
     3107     then do:
     3108       define variable v-curr-rowid as rowid no-undo .
     3109       assign
     3110         v-curr-rowid = rowid(temp-gds-prt)
     3111       .
     3112       reposition BROWSE-1 to rowid rowid(buf_temp-gds-prt) no-error .
     3113       if error-status :error
     3114       then do:
     3115         message
     3116           "Признак с указанным бар-кодом не показывается в заданных условиях выбора" skip
     3117           "Бар-код"  buf_temp-gds-prt.b-code    skip
     3118           "Признак"  buf_temp-gds-prt.prt-name  skip
     3119           "Свободно" buf_temp-gds-prt.free-qnty skip
     3120           "Факт"     buf_temp-gds-prt.fact-qnty skip
     3121           "Цена"     buf_temp-gds-prt.price     skip
     3122           view-as alert-box information .
     3123         reposition BROWSE-1 to rowid v-curr-rowid no-error .
     3124         if error-status :error
     3125         then do:
     3126           reposition BROWSE-1 to row 1 .
     3127         end.
     3128       end.
     3129     end.
     3130     else do:
     3131       message
     3132         "Внутренняя ошибка - не найден указанный признак" skip
     3133         "Код товара" p-gds-code skip
     3134         "Задан бар-код" v-b-code skip
     3135         "Код признака" buf_bar-code.node-code skip
     3136         view-as alert-box error .
     3137     end.
     3138   END PROCEDURE.
     3139   PROCEDURE show-alt :
     3140     define variable v-select-function as character no-undo .
     3141     define variable v-rec-list as character no-undo .
     3142     if available temp-gds-prt
     3143     then do:
     3144       run gbl/d-list.w
     3145         (input "b-sel"
     3146         ,input "Просмотр"
     3147         ,input 'alt-current':u
     3148           + chr(44) + 'alt-all':u
     3149           + chr(44) + 'prod-all':u
     3150         ,input "Существующие неосновные цены"
     3151           + chr(44) + "Все неосновные коды"
     3152           + chr(44) + "Дополнительные коды"
     3153         ,input chr(44)
     3154         ,'':U
     3155         ,output v-select-function
     3156         ).
     3157       case v-select-function
     3158       :
     3159         when 'alt-current':u
     3160         then do:
     3161           run ref/alt-cds.w
     3162             (input  parparentproc
     3163             ,input  p-obj-type
     3164             ,input  p-obj-code
     3165             ,input  'code-current':u
     3166             ,input  p-gds-code
     3167             ,input  temp-gds-prt.b-code
     3168             ,output v-rec-list
     3169             ).
     3170         end.
     3171         when 'alt-all':u
     3172         then do:
     3173           run ref/alt-cds.w
     3174             (input  parparentproc
     3175             ,input  p-obj-type
     3176             ,input  p-obj-code
     3177             ,input  'code-all':u
     3178             ,input  p-gds-code
     3179             ,input  temp-gds-prt.b-code
     3180             ,output v-rec-list
     3181             ).
     3182         end.
     3183         when 'prod-all':u
     3184         then do:
     3185           run ref/prod-cds.w
     3186             (input  parparentproc
     3187             ,input  p-obj-type
     3188             ,input  p-obj-code
     3189             ,input  'code-all':u
     3190             ,input  p-gds-code
     3191             ,input  temp-gds-prt.b-code
     3192             ,output v-rec-list
     3193             ).
     3194         end.
     3195       end case.
     3196     end.
     3197   END PROCEDURE.
     3198   PROCEDURE show-check :
     3199     define variable v-rid-list as character no-undo .
     3200     if available temp-gds-prt
     3201     then do:
     3202       run ref/gds-chk.w
     3203         (input parparentproc
     3204         ,input temp-gds-prt.b-code
     3205         ,input "":U
     3206         ,input 'объект':U
     3207         ,input ?
     3208         ,input p-obj-type
     3209         ,input p-obj-code
     3210         ,input "":U
     3211         ,input "":U
     3212         ,output v-rid-list
     3213         ).
     3214     end.
     3215   END PROCEDURE.
     3216   PROCEDURE show-codes :
     3217   define buffer buf_bar-code for ub.bar-code.
     3218     if available temp-gds-prt then do:
     3219       find first buf_bar-code no-lock where
     3220                 buf_bar-code.b-code = temp-gds-prt.b-code no-error .
     3221       if available buf_bar-code then do:
     3222         run ref/alt-bc.w
     3223           (input parparentproc
     3224           ,input  p-obj-type
     3225           ,input  p-obj-code
     3226           ,input temp-gds-prt.b-code
     3227           ).
     3228       end.
     3229       else do:
     3230         assign
     3231         v-need-refresh = no
     3232         .
     3233       end.
     3234     end.
     3235     else do:
     3236       assign
     3237       v-need-refresh = no
     3238       .
     3239     end.
     3240   END PROCEDURE.
     3241   PROCEDURE show-gds-arch :
     3242     run gbl/shgdsarh.p
     3243       (input parparentproc
     3244       ,input p-gds-code
     3245       ,input p-obj-type
     3246       ,input p-obj-code
     3247       ) .
     3248   END PROCEDURE.
     3249   PROCEDURE show-gds-prt :
     3250     if available temp-gds-prt
     3251     then do:
     3252       run ref/docprtob.p
     3253         (input parparentproc
     3254         ,input p-gds-code
     3255         ,input p-obj-type
     3256         ,input p-obj-code
     3257         ,input temp-gds-prt.b-code
     3258         ) .
     3259     end.
     3260   END PROCEDURE.
     3261   PROCEDURE show-input-info :
     3262     do with frame Dialog-Frame:
     3263       define buffer buf_goods for ub.goods .
     3264       find first buf_goods no-lock
     3265         where buf_goods.gds-code = p-gds-code
     3266         no-error .
     3267       if available buf_goods
     3268       then do:
     3269         assign
     3270           fi-gds :screen-value = substitute("&1 &2 &3 &4"
     3271                                           ,buf_goods.artic
     3272                                           ,buf_goods.prod-type
     3273                                           ,buf_goods.prod-code
     3274                                           ,buf_goods.gds-name
     3275                                           )
     3276         .
     3277         assign
     3278           frame Dialog-Frame :title = substitute("Признаки товара &1 &2 &3 &4"
     3279                                                   ,buf_goods.artic
     3280                                                   ,buf_goods.prod-type
     3281                                                   ,buf_goods.prod-code
     3282                                                   ,buf_goods.gds-name
     3283                                                   )
     3284         .
     3285       end.
     3286       else do:
     3287         assign
     3288           fi-gds :screen-value = ''
     3289         .
     3290         assign
     3291           frame Dialog-Frame :title = "Признаки товара"
     3292         .
     3293       end.
     3294       define buffer buf_clients for ub.clients .
     3295       find first buf_clients no-lock
     3296         where buf_clients.obj-type = p-obj-type
     3297           and buf_clients.obj-code = p-obj-code
     3298         no-error .
     3299       if available buf_clients
     3300       then do:
     3301         assign
     3302           fi-obj :screen-value = substitute('&1 &2 &3'
     3303                                   ,buf_clients.obj-type
     3304                                   ,buf_clients.obj-code
     3305                                   ,buf_clients.obj-name
     3306                                   )
     3307         .
     3308       end.
     3309       if p-search-code <> ""
     3310       then do:
     3311         assign
     3312           fi-search-b-code :screen-value = p-search-code
     3313         .
     3314         assign
     3315           fi-search-b-code
     3316         .
     3317       end.
     3318     end.
     3319   END PROCEDURE.
     3320   PROCEDURE show-rest :
     3321     if available temp-gds-prt
     3322     then do:
     3323       define variable v-host-code as integer   no-undo .
     3324   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3325   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3326     (input  p-obj-type
     3327     ,input  p-obj-code
     3328     ,output v-host-code
     3329     )  .
     3330       define buffer buf_goods for ub.goods .
     3331       find first buf_goods no-lock
     3332         where buf_goods.gds-code = p-gds-code
     3333         .
     3334       run rep/gds-objs.w
     3335         (input  parparentproc
     3336         ,input  buf_goods.artic
     3337         ,input  buf_goods.prod-type
     3338         ,input  buf_goods.prod-code
     3339         ,input  v-host-code
     3340         ,input  temp-gds-prt.node-code
     3341         ).
     3342     end.
     3343   END PROCEDURE.
     3344   PROCEDURE show-scale :
     3345     define variable v-root-node as character no-undo .
     3346   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsrtnod in g#library
     3348     (input  p-gds-code
     3349     ,output v-root-node
     3350     )  .
     3351     run str/showprop.w
     3352       (input v-root-node
     3353       ) .
     3354   END PROCEDURE.
     3355   PROCEDURE validate-input-parameters :
     3356     define buffer buf_goods for ub.goods .
     3357     find first buf_goods no-lock
     3358       where buf_goods.gds-code = p-gds-code
     3359       no-error .
     3360     if not available buf_goods
     3361     then do:
     3362       message
     3363         vss-workfile vss-revision vss-description skip
     3364         "Ошибка задания входных параметров" skip
     3365         "Не найден товар" skip
     3366         "Режим" p-mode skip
     3367         "Код товара" p-gds-code skip
     3368         "Объект" p-obj-type p-obj-code skip
     3369         "Документ" p-doc-code skip
     3370         view-as alert-box error .
     3371       undo, return error return-value .
     3372     end.
     3373     define variable v-valid-obj as logical   no-undo .
     3374   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3376     (input  p-obj-type
     3377     ,input  p-obj-code
     3378     ,input  'check-exist':u
     3379     ,output v-valid-obj
     3380     ) no-error .
     3381     if error-status :error
     3382     then do:
     3383       message
     3384         vss-workfile vss-revision vss-description skip
     3385         "Ошибка задания входных параметров" skip
     3386         "Не найден объект" skip
     3387         "Режим" p-mode skip
     3388         "Код товара" p-gds-code skip
     3389         "Объект" p-obj-type p-obj-code skip
     3390         "Документ" p-doc-code skip
     3391         view-as alert-box error .
     3392       undo, return error return-value .
     3393     end.
     3394     if lookup(p-mode, 'ПРОСМОТР':U + chr(44) + 'выбор':U) = 0
     3395     then do:
     3396       message
     3397         vss-workfile vss-revision vss-description skip
     3398         "Ошибка задания входных параметров" skip
     3399         "Неизвестный режим" skip
     3400         "Режим" p-mode skip
     3401         "Код товара" p-gds-code skip
     3402         "Объект" p-obj-type p-obj-code skip
     3403         "Документ" p-doc-code skip
     3404         view-as alert-box error .
     3405       undo, return error return-value .
     3406     end.
     3407   END PROCEDURE.
     3408   FUNCTION get-prt-name RETURNS CHARACTER
     3409     ( BUFFER buf_temp-gds-prt FOR temp-gds-prt ) :
     3410     define variable v-return-prt-name as character no-undo .
     3411     if v-sort-mode = 'sort-tree':u
     3412     then do:
     3413       assign
     3414         v-return-prt-name = fill(" ", 2 * (buf_temp-gds-prt.prt-level - 1) )+ buf_temp-gds-prt.node-name
     3415       .
     3416     end.
     3417     else do:
     3418       assign
     3419         v-return-prt-name = buf_temp-gds-prt.prt-name
     3420       .
     3421     end.
     3422     RETURN v-return-prt-name.
     3423   END FUNCTION.
