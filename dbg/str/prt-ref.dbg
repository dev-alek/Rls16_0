      690        SIZE 39 BY .79
      691        FGCOLOR 4  NO-UNDO.
      692   DEFINE QUERY BROWSE-1 FOR
      693         temp-gds-prt SCROLLING.
      694   DEFINE BROWSE BROWSE-1
      695     QUERY BROWSE-1 DISPLAY
      696         b-code
      697         get-prt-name(buffer temp-gds-prt) @ v-prt-name
      698         free-qnty
      699         fact-qnty
      700         price
      701         price-ord
      702         diff-qnty
      703         rest-qnty
      704       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.63 BY 15.58.
      705   DEFINE FRAME Dialog-Frame
      706        b-exit AT ROW 1 COL 1
      707        b-sel AT ROW 1 COL 9
      708        b-check AT ROW 1 COL 17
      709        b-codes AT ROW 1 COL 25
      710        b-alt AT ROW 1 COL 33
      711        b-rest AT ROW 1 COL 43
      712        b-arch AT ROW 1 COL 53
      713        b-prt-arch AT ROW 1 COL 64
      714        b-print AT ROW 1 COL 74
      715        b-help AT ROW 1 COL 84
      716        b-scale AT ROW 2 COL 9
      717        b-print-ticket AT ROW 2 COL 17
      718        b-crebcprt AT ROW 2 COL 25
      719        b-refresh AT ROW 2 COL 36
      720        fi-search-b-code AT ROW 2.13 COL 61.38 COLON-ALIGNED
      721        RADIO-SET-sort AT ROW 5.21 COL 28 NO-LABEL
      722        RADIO-SET-filter AT ROW 6.21 COL 27.63 NO-LABEL
      723        BROWSE-1 AT ROW 7.5 COL 1.5
      724        fi-gds-label AT ROW 3.38 COL 1.88 NO-LABEL
      725        fi-gds AT ROW 3.38 COL 16.75 NO-LABEL
      726        fi-obj AT ROW 4.25 COL 16.63 NO-LABEL
      727        fi-obj-label AT ROW 4.29 COL 1.75 NO-LABEL
      728        fi-free AT ROW 5.25 COL 75.75 COLON-ALIGNED
      729        fi-sort-label AT ROW 5.33 COL 1.88 NO-LABEL
      730        fi-fact AT ROW 6.21 COL 75.88 COLON-ALIGNED
      731        fi-filter-label AT ROW 6.42 COL 2.13 NO-LABEL
      732        SPACE(73.36) SKIP(16.19)
      733       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      734            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      735            TITLE "Признаки товара"
      736            DEFAULT-BUTTON b-exit.
      737   ASSIGN
      738          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      739          FRAME Dialog-Frame:HIDDEN           = TRUE.
      740   ASSIGN
      741          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      742   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      743   DO:
      744     APPLY "END-ERROR":U TO SELF.
      745   END.
      746   ON CHOOSE OF b-alt IN FRAME Dialog-Frame
      747   DO:
      748   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      749   if lookup(self :type
      750            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      751            ) = 0
      752   then do:
      753     message
      754       "$Workfile$"
      755       "Указанному интерфейсному элементу фокус не может быть передан" skip
      756       "Интерфейсный элемент" self :name  skip
      757       "Тип" self :type  skip
      758       "Процедура" this-procedure :file-name skip
      759       view-as alert-box .
      760   end.
      761   else do:
      762     apply "entry":u to self  .
      763     if focus :handle <> self :handle  then do:
      764       return no-apply .
      765     end.
      766   end.
      767     run show-alt in this-procedure .
      768     assign
      769       v-need-refresh = true
      770     .
      771     run local-open-query in this-procedure
      772       (input ?
      773       ) .
      774   END.
