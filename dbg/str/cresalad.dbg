      766   ,input v-doc-type
      767   ,input no
      768   ,input buf_main_trn-doc.host-code
      769   ,input v-internal
      770   ,input buf_main_trn-doc.obj-code
      771   ,input buf_main_trn-doc.obj-type
      772   ,input buf_main_trn-doc.office
      773   ,input v-pay-code
      774   ,input v-ps
      775   ,input no
      776   ,input ?
      777   ,input v-status
      778   ,input ?
      779   ,input v-ext-doc-type
      780   ,input v-purch-code
      781   ) no-error
      782   .
      783     if error-status:error then do:
      784       v-mes = substitute("Ошибка при генерации автодокумента вида &5 для продажи &4:&1&2 &3"
      785                         , chr(10)
      786                         , error-status:get-message(1)
      787                         , return-value
      788                         , buf_main_trn-doc.doc-code
      789                         , p-doc-kind
      790                         ).
      791       undo _main, return error v-mes.
      792     end.
      793     find buf_trn-doc where buf_trn-doc.doc-code = p-doc-code.
      794     assign
      795       buf_trn-doc.fact-date  = buf_main_trn-doc.fact-date
      796       buf_trn-doc.shift-date = buf_main_trn-doc.shift-date
      797       buf_trn-doc.shift-num  = buf_main_trn-doc.shift-num
      798       buf_trn-doc.shift-name = buf_main_trn-doc.shift-name
      799       buf_trn-doc.exch-code  = buf_main_trn-doc.exch-code
      800       buf_trn-doc.exch-rate  = buf_main_trn-doc.exch-rate
      801       buf_trn-doc.exch-scale = buf_main_trn-doc.exch-scale
      802       buf_trn-doc.print-rubl = buf_main_trn-doc.print-rubl
      803       buf_trn-doc.out-code   = buf_main_trn-doc.doc-code
      804       buf_trn-doc.office     = (if p-office = 'у':U then yes else no)
      805       buf_main_trn-doc.out-code = (if (p-doc-kind = 'rs':U and p-office = 'т':U) then buf_trn-doc.doc-code else buf_main_trn-doc.out-code)
      806       buf_trn-doc.wrkr = buf_main_trn-doc.wrkr
      807       buf_trn-doc.agnt = buf_main_trn-doc.agnt
      808       buf_trn-doc.boss = buf_main_trn-doc.boss
      809     .
      810     if p-doc-kind = 'swo':U or
      811        p-doc-kind = 'trf':U
      812     then do:
      813   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input buf_trn-doc.doc-code ,
      814                          input 'othermoves':U ,
      815                          input yes ) no-error .
      816     end.
      817     run saledoc-create  in this-procedure (
      818                                              input buf_main_trn-doc.doc-code
      819                                             ,input buf_main_trn-doc.host-code
      820                                             ,input buf_main_trn-doc.obj-type
      821                                             ,input buf_main_trn-doc.obj-code
      822                                             ,input p-doc-kind
      823                                             ,input p-office
      824                                             ,input no
      825                                             ,input '':U
      826                                             ,input '':U
      827                                             ,input 0
      828                                             ,buffer buf_trn-doc ) no-error .
      829     if error-status:error then do:
      830       undo, return error substitute("Ошибка записи данных автодокумента вида &5 для продажи &4 во временную таблицу:&1&2 &3"
      831                                     , chr(10)
      832                                     , error-status:get-message(1)
      833                                     , return-value
      834                                     , buf_main_trn-doc.doc-code
      835                                     , p-doc-kind
      836                                     ).
      837     end.
      838   end.
