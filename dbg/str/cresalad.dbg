        1   block-level on error undo, throw.
        2   define parameter buffer buf_main_trn-doc for ub.trn-doc.
        3   define parameter buffer buf_trn-doc for ub.trn-doc.
        4   define input parameter p-doc-kind as character no-undo .
        5   define input parameter p-office as character no-undo .
        6   define input parameter p-cli-type as character no-undo .
        7   define input parameter p-cli-code as integer no-undo .
        8   define output parameter p-doc-code like ub.trn-doc.doc-code no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: 315b966a6a9b, 3487, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: BelovaMM $":U .
       11   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:36 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: cresalad.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/cresalad.p $":U .
       14   define variable vss-description as character no-undo init "Генерация дополнительных (помимо простого расхода и возврата) документов, привязанных к продаже".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define new global shared variable g#trdcalib as handle no-undo.
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
       92   define variable v-ps as character no-undo .
       93   if available buf_sale-doc then
       94   assign
       95   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
       96                       , chr(4)
       97                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
       98                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
       99                       , buf_sale-doc.chk-amount
      100                       , buf_sale-doc.gds-amount
      101                       , buf_sale-doc.tot-lines
      102                       , buf_sale-doc.tot-dtl
      103                       ).
      104   else  do:
      105   assign
      106   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      107                       , chr(4)
      108                       , '':U
      109                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      110                       , 0
      111                       , 0
      112                       , 0
      113                       , 0
      114                       ).
      115   end.
      116   return v-ps.
      117   END FUNCTION.
      118   FUNCTION get-sale-doc-kind returns character (
      119                                                input p-doc-kind as character
      120                                              , input p-ext-doc-type as character
      121                                              , output p-order as integer
      122                                              , output p-msign as integer
      123                                              , output p-main as logical
      124                                              , output p-in-inkas as logical
      125                                              , output p-dir_ as integer
      126                                              ):
      127   define variable v-doc-kind as character no-undo.
      128   define variable v-type as character no-undo .
      129   define variable v-value as character no-undo .
      130   CASE p-doc-kind:
      131     when 'es':U then do:
      132       assign
      133       p-order = 100
      134       p-msign = 1
      135       p-main = yes
      136       p-in-inkas = yes
      137       p-dir_ = 1
      138       .
      139       return p-ext-doc-type.
      140     end.
      141     when  'rs':U then do:
      142       assign
      143       p-order = 200
      144       p-msign = - 1
      145       p-main = no
      146       p-in-inkas = yes
      147       p-dir_ = - 1
      148       .
      149       return p-ext-doc-type.
      150     end.
      151     when 'rwo':U then do:
      152       assign
      153       p-msign = - 1
      154       p-main = no
      155       p-in-inkas = no
      156       p-order = 300
      157       p-dir_ = 1
      158       .
      159       return 'rwo':U.
      160     end.
      161     when 'trf':U then do:
      162       assign
      163       p-msign = 1
      164       p-main = no
      165       p-in-inkas = no
      166       p-order = 400
      167       p-dir_ = 1
      168       .
      169       return 'trf':U.
      170     end.
      171     when 'swo':U then do:
      172      assign
      173      p-msign = 1
      174      p-main = no
      175      p-in-inkas = no
      176      p-order =  500
      177      p-dir_ = 1
      178      .
      179      return 'swo':U.
      180    end.
      181    when 'vir':U then do:
      182      assign
      183      p-msign = 1
      184      p-main = no
      185      p-in-inkas = no
      186      p-order = 600
      187      p-dir_ = 1
      188      .
      189      return 'vir':U.
      190    end.
      191    when 'itr':U then do:
      192      assign
      193      p-msign = 1
      194      p-main = no
      195      p-in-inkas = no
      196      p-order = -1
      197      p-dir_ = -1
      198      .
      199     return 'itr':U.
      200    end.
      201    when 'ngs':U then do:
      202      assign
      203      p-msign = 1
      204      p-main = no
      205      p-in-inkas = no
      206      p-order = 700
      207      p-dir_ = 1
      208      .
      209      return 'ngs':U.
      210    end.
      211    when 'rgs':U then do:
      212      assign
      213      p-msign = -1
      214      p-main = no
      215      p-in-inkas = no
      216      p-order = 701
      217      p-dir_ = -1
      218      .
      219      return 'rgs':U.
      220    end.
      221    otherwise do:
      222       assign
      223       p-msign = 1
      224       p-main = no
      225       p-in-inkas = no
      226       p-order = -1.
      227       return p-ext-doc-type.
      228     end.
      229   END CASE.
      230   END FUNCTION.
      231   procedure saledoc-create :
      232   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      233   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      234   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      235   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      236   define input parameter p-doc-kind as character no-undo .
      237   define input parameter p-office as character no-undo .
      238   define input parameter p-tpsidoc as logical no-undo .
      239   define input parameter p-alias-type-price as character no-undo .
      240   define input parameter p-price-obj-type as character no-undo .
      241   define input parameter p-price-obj-code as integer no-undo .
      242   define parameter buffer buf_trn-doc for ub.trn-doc.
      243   define variable v-order as integer no-undo.
      244   define variable v-main as logical no-undo .
      245   define variable v-in-inkas as logical no-undo .
      246   define variable v-msign as integer no-undo .
      247   define variable v-dir_ as integer no-undo .
      248   define variable v-trn-doc-code as character no-undo .
      249   define buffer buf_sale-doc for ub.sale-doc.
      250   main-block:
      251   do
      252   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      253   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      254   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      255   :
      256      if available buf_trn-doc then do:
      257        v-trn-doc-code = buf_trn-doc.doc-code.
      258      end.
      259      find first buf_sale-doc where
      260               buf_sale-doc.inkas-code = p-inkas-code
      261           and buf_sale-doc.doc-kind = p-doc-kind
      262           and buf_sale-doc.chr-office = p-office
      263           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
      264           no-error .
      265      if not available buf_sale-doc  then do:
      266         create buf_sale-doc.
      267         assign
      268         buf_sale-doc.inkas-code = p-inkas-code
      269         buf_sale-doc.storage =  'trn-doc':U
      270         buf_sale-doc.host-code = p-host-code
      271         buf_sale-doc.obj-type = p-obj-type
      272         buf_sale-doc.obj-code = p-obj-code
      273         buf_sale-doc.doc-kind  = p-doc-kind
      274         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
      275         buf_sale-doc.chr-office = p-office
      276         buf_sale-doc.doc-code = v-trn-doc-code
      277         .
      278      end.
      279      if available buf_trn-doc then
      280      buffer-copy buf_trn-doc
      281      to buf_sale-doc
      282      .
      283     assign
      284     buf_sale-doc.doc-kind = get-sale-doc-kind (
      285                                                input p-doc-kind
      286                                               ,input buf_sale-doc.ext-doc-type
      287                                               ,output v-order
      288                                               ,output v-msign
      289                                               ,output v-main
      290                                               ,output v-in-inkas
      291                                               ,output v-dir_).
      292     assign
      293     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
      294     buf_sale-doc.main-doc = v-main
      295     buf_sale-doc.in-inkas = v-in-inkas
      296     buf_sale-doc.msign = v-msign
      297     buf_sale-doc.dir = v-dir_
      298     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
      299     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
      300     buf_sale-doc.poss-wro-codes = '':U
      301     buf_sale-doc.chr-office = p-office
      302     buf_sale-doc.tpsidoc = p-tpsidoc
      303     buf_sale-doc.alias-type-price = p-alias-type-price
      304     buf_sale-doc.price-obj-type = (if p-tpsidoc
      305                                    then p-price-obj-type
      306                                    else '':U)
      307     buf_sale-doc.price-obj-code = (if p-tpsidoc
      308                                    then p-price-obj-code
      309                                    else 0)
      310     .
      311     assign
      312     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
      313     no-error.
      314   end.
      315   END.
      316   procedure fbr-saledoc-create :
      317   define input parameter p-inkas-code as character no-undo .
      318   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
      319   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
      320   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
      321   define buffer buf_fbr-doc for ub.fbr-doc.
      322   define buffer buf_trn-doc for ub.trn-doc.
      323   define buffer buf_sale-doc for ub.sale-doc.
      324   define buffer buf2_sale-doc for ub.sale-doc.
      325   define buffer buf2_trn-doc for ub.trn-doc.
      326   define buffer buf_doc-line for ub.doc-line.
      327   define buffer buf_gds-dtl for ub.gds-dtl.
      328   define buffer buf_chk-gds for ub.chk-gds.
      329   define buffer buf_chk-doc for ub.chk-doc.
      330   do
      331   on error undo, return error
      332   :
      333     for each buf_fbr-doc no-lock where
      334           buf_fbr-doc.out-code = p-inkas-code:
      335       for each buf_trn-doc no-lock where
      336             buf_trn-doc.out-code = buf_fbr-doc.doc-code
      337       by buf_trn-doc.fact-order
      338       on error undo, return error:
      339         if buf_trn-doc.ext-doc-type = 'em':U
      340         or buf_trn-doc.ext-doc-type = 'im':U
      341         or buf_trn-doc.ext-doc-type = 'wm':U
      342         or buf_trn-doc.ext-doc-type = 'ev':U
      343         or buf_trn-doc.ext-doc-type = 'iv':U
      344         then do:
      345           find first buf_sale-doc where
      346                   buf_sale-doc.inkas-code = p-inkas-code
      347               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
      348               AND buf_sale-doc.storage  = 'trn-doc':U
      349                   no-error .
      350           if not available buf_sale-doc then do:
      351           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
      352           end.
      353           if buf_trn-doc.ext-doc-type = 'im':U then do:
      354             assign
      355             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
      356             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
      357             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
      358             .
      359           end.
      360           for each buf2_trn-doc no-lock where
      361                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
      362             find first buf2_sale-doc where
      363                     buf2_sale-doc.inkas-code = p-inkas-code
      364                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
      365                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
      366             if not available buf2_sale-doc then do:
      367               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
      368             end.
      369           end.
      370         end.
      371       end.
      372       find first buf_sale-doc where
      373                 buf_sale-doc.inkas-code = p-inkas-code
      374             AND buf_sale-doc.storage = 'fbr-doc':U
      375             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
      376       if not available buf_sale-doc then do:
      377         create buf_sale-doc.
      378         assign
      379         buf_sale-doc.storage       =  'fbr-doc':U
      380         buf_sale-doc.doc-type      = 'производство':U
      381         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
      382         buf_sale-doc.ext-doc-type  = 'производство':U
      383         buf_sale-doc.doc-kind      = 'производство':U
      384         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
      385         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
      386         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
      387         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
      388         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
      389         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
      390         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
      391         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
      392         buf_sale-doc.fbrsale       = yes
      393         buf_sale-doc.inkas-code    = p-inkas-code
      394         .
      395       end.
      396     end.
      397   end.
      398   end procedure.
      399   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   procedure doc-code:
      401   define input  parameter parmode          as   character           no-undo.
      402   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      403   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      404   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      405   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      406   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      407   define variable vardb-remote     as   logical             no-undo.
      408   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      409   define variable v-delimiter as character no-undo .
      410   do
      411   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      412   :
      413   find first buf_sys-ctrl no-lock .
      414   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      415     CASE parmode:
      416       when "main":u then do:
      417         if vardb-remote then do:
      418           assign
      419             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      420         end.
      421         else do:
      422           assign
      423             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      424         end.
      425       end.
      426       when "trio" then do:
      427         assign
      428           pardoc-code = replace (parroot-doc-code, "=", "*").
      429       end.
      430       otherwise do:
      431         assign
      432         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      433         no-error
      434         .
      435         if error-status:error  then do:
      436           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      437                                         ,chr(10)
      438                                         ,parmode
      439                                         ).
      440         end.
      441         if num-entries(parmode) = 1
      442         and parmode <> "chip":U
      443         and parmode <> "chip_s":U
      444         then do:
      445           assign
      446           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      447         end.
      448         else if (lookup("chip":U, parmode) > 0
      449                  or
      450                  lookup("chip_s":U, parmode) > 0) then do:
      451           assign
      452             vartemp-doc-code = parroot-doc-code.
      453           do while true:
      454             if index (vartemp-doc-code , ".") = 0 then
      455               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      456             else
      457               vartemp-doc-code  =
      458               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      459               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      460               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      461             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      462           end.
      463           assign
      464             pardoc-code = vartemp-doc-code.
      465         end.
      466       end.
      467     end CASE.
      468     if pardoc-code = '':U
      469     or (parroot-doc-code <> '':U
      470     and pardoc-code = parroot-doc-code) then do:
      471       undo, return error substitute("Ошибка при генерации номера документа&1"
      472                                     ,chr(10)).
      473     end.
      474   end.
      475   end. // procedure/method
      476   function get-doc-code-int64 returns int64
      477     ( input p-doc-code as character ) :
      478     define variable v-ind              as integer   no-undo .
      479     define variable v-num-entries      as integer   no-undo .
      480     define variable v-doc-code-int64   as int64     no-undo .
      481     define variable v-canonic-doc-code as character no-undo .
      482     assign
      483       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      484       v-canonic-doc-code = p-doc-code
      485     .
      486     do v-ind = 1 to v-num-entries
      487     :
      488       assign
      489         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      490       .
      491     end.
      492     assign
      493       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      494     .
      495     return v-doc-code-int64 .
      496   end. // function/method
      497   define variable v-doc-type like ub.trn-doc.doc-type no-undo .
      498   define variable v-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      499   define variable v-cli-type like ub.trn-doc.cli-type no-undo .
      500   define variable v-cli-code like ub.trn-doc.cli-code no-undo .
      501   define variable v-cli-name like ub.trn-doc.cli-name no-undo .
      502   define variable v-internal like ub.trn-doc.internal no-undo .
      503   define variable v-pay-code like ub.trn-doc.pay-code no-undo .
      504   define variable v-purch-code like ub.trn-doc.purch-code no-undo .
      505   define variable v-status    like ub.trn-doc.status_ no-undo .
      506   define variable v-ps like ub.trn-doc.ps no-undo .
      507   define variable v-mes as character no-undo .
      508   define variable v-entry as character no-undo .
      509   define variable v-doc-kind as character no-undo .
      510   define variable v-doc-kind-label as character no-undo .
      511   define variable conf-attr as character no-undo .
      512   define variable conf-par as character no-undo .
      513   define variable par-type as character no-undo .
      514   define variable v-down-pay like ub.shop.down-pay no-undo .
      515   define variable ii as integer no-undo .
      516   define variable v-doc-code-parameter as character no-undo .
      517   define variable v-cntxt-userid as character no-undo .
      518   define variable v-discnt-type as character no-undo .
      519   define variable v-value-character as character no-undo .
      520   define variable v-value-date as date no-undo .
      521   define variable v-value-decimal as decimal no-undo .
      522   define variable v-value-integer as INTEGER no-undo .
      523   define variable v-value-logical AS LOGICAL no-undo .
      524   define variable v-tth as handle no-undo .
      525   define buffer buf_clients for ub.clients.
      526   define buffer buf_shop for ub.shop.
      527   define buffer buf_store for ub.store.
      528   _main:
      529   do
      530   on error undo, return error return-value
      531   :
      532     if lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) = 0 then do:
      533       v-mes = substitute("Неизвестный вид автодокумента &1 для продажи &2"
      534                         , p-doc-kind
      535                         , buf_main_trn-doc.doc-code
      536                         ).
      537       undo _main, return error v-mes.
      538     end.
      539     if p-doc-kind = 'es':U
      540     and p-office = 'т':U
      541     then do:
      542       v-mes = substitute("Автодокумент &1 для продажи товаров типа &2 с номером &3 должен быть создан вместе с продажей"
      543                         , p-doc-kind
      544                         , 'т':U
      545                         , buf_main_trn-doc.doc-code
      546                         ).
      547       undo _main, return error v-mes.
      548     end.
      549     if not available buf_main_trn-doc then do:
      550       message
      551       vss-workfile vss-revision vss-description skip
      552       substitute("Нет записи в буфере-параметре при вызове")
      553       view-as alert-box error .
      554       undo _main, return error .
      555     end.
      556     if buf_main_trn-doc.ext-doc-type <> 'es':U then do:
      557       message
      558       vss-workfile vss-revision vss-description skip
      559       substitute("Неверный расш. тип докум &1 &2 в буфере-параметре при вызове"
      560                  , buf_main_trn-doc.doc-code
      561                  , buf_main_trn-doc.ext-doc-type)
      562       view-as alert-box error .
      563       undo _main, return error .
      564     end.
      565     assign
      566       v-doc-code-parameter = entry (lookup (p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U), 'main,pair,trio-m,quadro,stock-down,quadro,chip') + (if p-office = 'у':U then "_s" else "":U)
      567     no-error .
      568     if error-status:error then do:
      569       message
      570       vss-workfile vss-revision vss-description skip
      571       substitute("Неверно определено или не определено правило создания номера документа для дополнительного документа по продаже вида &1"
      572                   , entry (lookup (p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      573                  )
      574       view-as alert-box error .
      575       undo _main, return error .
      576     end.
      577     run doc-code in this-procedure
      578         (input v-doc-code-parameter
      579         ,input buf_main_trn-doc.obj-type
      580         ,input buf_main_trn-doc.obj-code
      581         ,input buf_main_trn-doc.doc-code
      582         ,output p-doc-code ) no-error.
      583     if error-status:error then do:
      584       v-mes = substitute("Ошибка при генерации номера дополнительного документа вида &5 для продажи &4:&1&2 &3"
      585                         , chr(10)
      586                         , error-status:get-message(1)
      587                         , return-value
      588                         , buf_main_trn-doc.doc-code
      589                         , p-doc-kind
      590                         ).
      591       undo _main, return error v-mes.
      592     end.
      593     find first buf_trn-doc exclusive-lock where
      594               buf_trn-doc.doc-code = p-doc-code
      595           AND buf_trn-doc.out-code = buf_main_trn-doc.doc-code no-error .
      596     if locked buf_trn-doc then do:
      597       return 'locked':U.
      598     end.
      599     else do:
      600       if available buf_trn-doc then return.
      601     end.
      602     if lookup(p-doc-kind, 'rwo,trf,swo,ngs,rgs,vir':U) > 0 and p-cli-code = 0 and p-cli-type = "" then do:
      603       run adm/shattri.p (
      604           input "get":U
      605           ,input  buf_main_trn-doc.obj-type
      606           ,input  buf_main_trn-doc.obj-code
      607           ,input  'autosale':U
      608           ,input  'sale-add':U
      609           ,output v-value-character
      610           ,output v-value-date
      611           ,output  v-value-decimal
      612           ,output  v-value-integer
      613           ,output  v-value-logical
      614           ,output par-type
      615           ,INPUT-OUTPUT table-handle v-tth
      616           ) no-error .
      617       v-mes = substitute("Ошибка при определении контрагента дополнительного документа вида &5 для продажи &4:&1&2 &3"
      618                         , chr(10)
      619                         , error-status:get-message(1)
      620                         , return-value
      621                         , buf_main_trn-doc.doc-code
      622                         , entry (lookup (p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      623                         ).
      624       if error-status:error
      625       then do:
      626         delete object v-tth.
      627         undo _main, return error v-mes.
      628       end.
      629       delete object v-tth.
      630       _ii:
      631       do ii = 1 to num-entries(v-value-character, ';':U):
      632         assign
      633           v-entry =  ENTRY(ii, v-value-character, ';':U)
      634           v-doc-kind = ENTRY(1, v-entry)
      635           v-cli-type = ENTRY(2, v-entry)
      636           v-cli-code = integer(ENTRY(3, v-entry))
      637         .
      638         assign
      639           v-doc-kind-label = entry (lookup (p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      640         no-error .
      641         if v-doc-kind = p-doc-kind then do:
      642           leave _ii.
      643         end.
      644       end.
      645       if v-cli-type = '':U
      646       or v-cli-code = 0 then do:
      647         v-mes = substitute("Ошибка при определении контрагента дополнительного документа вида &5 для продажи &4:&1&2 &3"
      648                           , chr(10)
      649                           , error-status:get-message(1)
      650                           , "Контрагент не задан - задайте контрагента (АРМ Администратор-Справочники-Магазины-Параметры-Опции работы с продажей"
      651                           , buf_main_trn-doc.doc-code
      652                           , entry (lookup (p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      653                           ).
      654         if error-status:error
      655         then do:
      656           undo _main, return error v-mes.
      657         end.
      658       end.
      659       find first buf_clients no-lock where buf_clients.obj-type  = v-cli-type
      660                                        and buf_clients.obj-code  = v-cli-code
      661       no-error .
      662       if not available buf_clients then do:
      663         undo _main, return error v-mes.
      664       end.
      665     end.
      666     v-ps = substitute('&1&2 &1&3&1 Кол-во_чеков 0&1строк_чеков 0&1 товаров 0&1признаков 0&1'
      667                       , chr(4)
      668                       , (if buf_main_trn-doc.office then "УСЛУГИ." else "ТОВАРЫ." )
      669                       , entry (lookup (p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      670                       ).
      671     CASE p-doc-kind:
      672       when 'es':U then do:
      673         v-mes = '':U.
      674         assign
      675           v-ext-doc-type       = 'es':U
      676           v-doc-type           = 'рас':U
      677           v-cli-type = buf_main_trn-doc.cli-type
      678           v-cli-code = buf_main_trn-doc.cli-code
      679           v-cli-name           = buf_main_trn-doc.cli-name
      680           v-internal = no
      681           v-pay-code = buf_main_trn-doc.pay-code
      682           v-status   = (if buf_main_trn-doc.status_ = 'запрос':U
      683                         then 'запрос':U
      684                         else 'касс':U)
      685           v-purch-code  = buf_main_trn-doc.purch-code
      686           v-discnt-type = 'касс':U
      687         .
      688       end.
      689       when 'rs':U then do:
      690         v-mes = '':U.
      691         assign
      692           v-ext-doc-type       = 'rs':U
      693           v-doc-type           = 'возврат':U
      694           v-cli-type = buf_main_trn-doc.cli-type
      695           v-cli-code = buf_main_trn-doc.cli-code
      696           v-cli-name           = buf_main_trn-doc.cli-name
      697           v-internal = no
      698           v-pay-code = buf_main_trn-doc.pay-code
      699           v-status   = (if buf_main_trn-doc.status_ = 'запрос':U
      700                         then 'запрос':U
      701                         else 'касс':U)
      702           v-purch-code  = buf_main_trn-doc.purch-code
      703           v-discnt-type = 'касс':U
      704         .
      705       end.
      706       when 'trf':U
      707       or
      708       when 'rwo':U
      709       or
      710       when 'swo':U
      711       or
      712       when 'vir':U
      713       then do:
      714         case buf_main_trn-doc.obj-type :
      715           when 'маг':U then do:
      716             find first buf_shop no-lock where
      717                     buf_shop.obj-code = buf_main_trn-doc.obj-code.
      718             v-down-pay = buf_shop.down-pay.
      719           end.
      720           when 'скл':U then do:
      721             find first buf_store no-lock where
      722                     buf_store.obj-code = buf_main_trn-doc.obj-code.
      723             v-down-pay = buf_store.down-pay.
      724           end.
      725         END CASE.
      726         v-mes = '':U.
      727         assign
      728           v-ext-doc-type       = entry(lookup(p-doc-kind, 'rwo,trf,swo,ngs,rgs,vir':U), 'we,we,we,we,ee':U)
      729           v-cli-name           = if available(buf_clients) then buf_clients.obj-name else ''
      730           v-internal = no
      731           v-pay-code = v-down-pay
      732           v-ps = '':U
      733           v-status   = (if buf_main_trn-doc.status_ = 'запрос':U
      734                   then 'запрос':U
      735                   else 'нередакт':U)
      736           v-purch-code  = ?
      737           v-discnt-type = 'строка':U
      738         .
      739         v-doc-type = if p-doc-kind = 'vir':U then 'рас':U else 'спи':U.
      740       end.
      741     END CASE.
      742     if p-cli-type <> "" and p-cli-code > 0 then do:
      743       for first buf_clients no-lock where buf_clients.obj-type = p-cli-type
      744                                       and buf_clients.obj-code = p-cli-code
      745       :
      746         assign
      747           v-cli-type = buf_clients.obj-type
      748           v-cli-code = buf_clients.obj-code
      749           v-cli-name = buf_clients.obj-name
      750         .
      751       end.
      752     end.
      753   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crtrndoc in g#lib-trn
      754   (input ?
      755   ,input ?
      756   ,input buf_main_trn-doc.base-rate
      757   ,input buf_main_trn-doc.base-scale
      758   ,input v-cli-code
      759   ,input v-cli-type
      760   ,input v-cli-name
