     1152           then do:
     1153             find first buf_temp-browse-handle
     1154               where buf_temp-browse-handle.browse-type   = 'height':u
     1155                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1156               no-error .
     1157             if available buf_temp-browse-handle
     1158             then do:
     1159             end.
     1160             else do:
     1161               create buf_temp-diasize-handle .
     1162               assign
     1163                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1164                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1165               .
     1166             end.
     1167           end.
     1168           assign
     1169             v-object-handle = v-object-handle :next-sibling
     1170           .
     1171         end.
