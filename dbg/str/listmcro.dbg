     1333   end procedure.
     1334   procedure diasize_set-height :
     1335     define input  parameter p-new-height  as decimal   no-undo .
     1336     define input  parameter p-move-resize as logical   no-undo .
     1337     do
     1338     on error undo, return error return-value
     1339     :
     1340       run diasize_change-height in this-procedure
     1341         (input  (p-new-height - frame Dialog-Frame :height)
     1342         ,input  p-move-resize
     1343         ) .
     1344     end.
     1345   end procedure.
     1346   procedure diasize_change-width :
     1347     define input  parameter p-change-value as decimal   no-undo .
     1348     define input  parameter p-move-resize  as logical   no-undo .
     1349     define variable v-field-group-handle   as handle    no-undo .
     1350     define variable v-object-handle        as handle    no-undo .
