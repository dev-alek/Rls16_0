      392   define  stream PrnLibStream.
      393   procedure prn-lib-prn-file :
      394     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      395     define input parameter p-DIsabledoptions as integer no-undo .
      396     define variable v-report-name as character no-undo .
      397     define variable v-user-action as character no-undo .
      398     define variable v-printed     as logical   no-undo .
      399     define variable v-exist       as logical   no-undo .
      400     do
      401       on error undo, return error
      402       :
      403       run prn-lib-get-report-name  in this-procedure (
      404         input parParentProc
      405         ,output v-report-name
      406         ).
      407   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      409     (input  v-report-name
      410     ,input  2
      411     ,output v-exist
      412     )  .
      413       if NOT v-exist then
      414       DO:
      415         Message
      416           "Нет заданий на печать ! "
      417           view-as alert-box .
      418         Return  .
      419       End.
      420       run gbl/prnfilen.w
      421         (input  ""
      422         ,input  p-DisabledOptions
      423         ,input  string(v-report-name )
      424         ,input  7
      425         ,output v-user-action
      426         ,output v-printed
      427         ) .
      428       if v-printed then
      429       do:
      430         return "YES" .
      431       end.
      432       else
      433       do:
      434         return "NO" .
      435       end.
      436     end.
      437   end procedure.
      438   procedure prn-lib-open-stream :
      439     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      440     define input parameter p-page-size    as integer no-undo .
      441     define input parameter p-is-stream    as logical no-undo .
      442     define input parameter p-append       as logical no-undo .
      443     define variable v-report-name as character no-undo .
      444     do
      445       on error undo, return error
      446       :
      447       run prn-lib-get-report-name  in this-procedure (
      448         input parParentProc
      449         ,output v-report-name
      450         ).
      451       if p-is-stream then
      452       do:
      453         if p-append then
      454         do:
      455           output stream PrnLibStream to value( v-report-name )
      456             page-size value(p-page-size) append .
      457         end.
      458         if not p-append then
      459         do:
      460           output stream PrnLibStream to value( v-report-name )
      461             page-size value(p-page-size) .
      462         end.
      463       end.
      464       if not p-is-stream then
      465       do:
      466         if p-append then
      467         do:
      468           output to value( v-report-name )
      469             page-size value(p-page-size) append .
      470         end.
      471         if not p-append then
      472         do:
      473           output to value( v-report-name )
      474             page-size value(p-page-size) .
      475         end.
      476       end.
      477     end.
      478   end procedure.
      479   procedure prn-lib-open-exp :
      480     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      481     define input parameter p-is-stream    as logical no-undo .
      482     define input parameter p-is-append    as logical no-undo .
      483     define output parameter p-ReportFileName as char init "report" no-undo.
      484     define output parameter p-process as logical no-undo .
      485     define variable glog as logical no-undo .
      486     do
      487       on error undo, return error
      488       :
      489       SYSTEM-DIALOG GET-FILE p-ReportFileName
      490         TITLE      "Укажите путь"
      491         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      492         ASK-OVERWRITE
      493         CREATE-TEST-FILE
      494         SAVE-AS
      495         USE-FILENAME
      496         DEFAULT-EXTENSION "txt"
      497         UPDATE glog
      498         .
      499       if not glog then  return.
      500       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      501       if p-is-stream then
      502       do:
      503         if p-is-append then
      504         do:
      505           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      506         end.
      507         else
      508         do:
      509           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      510         end.
      511       end.
      512       else
      513       do:
      514         if p-is-append then
      515         do:
      516           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      517         end.
      518         else
      519         do:
      520           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      521         end.
      522       end.
      523       p-process = yes.
      524     end.
      525   end procedure.
      526   procedure prn-lib-get-report-name :
      527     define input parameter parParentProc  as widget-handle no-undo.
      528     define output parameter p-report-name as character no-undo .
      529     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      530   end procedure.
      531   procedure prn-lib-reportviewer-report-name :
      532     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      533     define input parameter p-report-name-html as character no-undo .
      534     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      535   end procedure.
      536   procedure prn-lib-reportviewer :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-report-name-html as character no-undo .
      539     define input parameter p-param        as character no-undo .
      540     define variable v-excel           as character no-undo init 'TRUE' .
      541     define variable v-value-character as character no-undo .
      542     define variable v-value-integer   as character no-undo .
      543     define variable v-value-date      as date      no-undo .
      544     define variable v-value-decimal   as decimal   no-undo .
      545     define variable rep-excel         as logical   no-undo .
      546     define variable excel-string      as character no-undo .
      547     define variable v-param-type      as character no-undo .
      548     define variable v-tth             as handle    no-undo .
      549     run adm/shattri.p (
      550       input "get":U
      551       ,input  ""
      552       ,input  0
      553       ,input  'report-glob':U
      554       ,input  'rep-excel':U
      555       ,output v-value-character
      556       ,output v-value-date
      557       ,output v-value-decimal
      558       ,output v-value-integer
      559       ,output rep-excel
      560       ,output v-param-type
      561       ,INPUT-OUTPUT table-handle v-tth
      562       )  .
      563     if rep-excel then v-excel = "TRUE" .
      564     else v-excel = "FALSE" .
      565     if p-param eq ""
      566     then
      567        p-param = "EXCEL:" + v-excel.
      568     else
      569        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      570     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      571   end procedure.
      572   DEFINE BUFFER buf_macro-list-hist FOR macro-list-hist.
      573   DEFINE VARIABLE v-id AS CHARACTER NO-UNDO.
      574   DEFINE VARIABLE v-action AS CHARACTER NO-UNDO.
      575   DEFINE VARIABLE v-stop AS logical NO-UNDO.
      576   DEFINE VARIABLE v-pause AS logical NO-UNDO.
      577   DEFINE BUTTON B-Help
      578        LABEL "Помо&щь"
      579        SIZE 10 BY 1
      580        BGCOLOR 8 .
      581   DEFINE BUTTON B-pause AUTO-END-KEY
      582        IMAGE-UP FILE "cmp/pause.bmp":U
      583        IMAGE-DOWN FILE "cmp/pausei.bmp":U
      584        IMAGE-INSENSITIVE FILE "cmp/pausei.bmp":U
      585        LABEL "&||"
      586        SIZE 4 BY 1.25 TOOLTIP "Приостановка выполнения макроса истории".
      587   DEFINE BUTTON B-play
      588        IMAGE-UP FILE "cmp/run.bmp":U
      589        IMAGE-DOWN FILE "cmp/runi.bmp":U
      590        IMAGE-INSENSITIVE FILE "cmp/runi.bmp":U
      591        LABEL "&>"
      592        SIZE 4 BY 1.25 TOOLTIP "Выполнение макроса формирования истории".
      593   DEFINE BUTTON B-save
      594        IMAGE-UP FILE "cmp/save.bmp":U
      595        LABEL "&Сохранить"
      596        SIZE 4 BY 1.25.
      597   DEFINE BUTTON B-step
      598        IMAGE-UP FILE "cmp/step.bmp":U
      599        IMAGE-DOWN FILE "cmp/stepi.bmp":U
      600        IMAGE-INSENSITIVE FILE "cmp/stepi.bmp":U
      601        LABEL "&.>"
      602        SIZE 4 BY 1.25 TOOLTIP "Пошаговое выполнение макроса формирования истории".
      603   DEFINE BUTTON B-stop AUTO-END-KEY
      604        IMAGE-UP FILE "cmp/stop.bmp":U
      605        IMAGE-DOWN FILE "cmp/stopi.bmp":U
      606        IMAGE-INSENSITIVE FILE "cmp/stopi.bmp":U
      607        LABEL "&[ ]"
      608        SIZE 4 BY 1.25 TOOLTIP "Прекращение выполнения макроса - удаление макроса из памяти".
      609   DEFINE QUERY BR-macro FOR
      610         buf_macro-list-hist SCROLLING.
      611   DEFINE BROWSE BR-macro
      612     QUERY BR-macro DISPLAY
      613         buf_macro-list-hist.done COLUMN-LABEL "*" FORMAT "+/"
      614   (if buf_macro-list-hist.line = 0
      615      then string(buf_macro-list-hist.id, ">>>>>>>>9")
      616      else fill(chr(32) , 9)
      617     ) @ v-id COLUMN-LABEL "№" FORMAT "X(9)"
      618   (if buf_macro-list-hist.ITEM_ <> '':U
      619   THEN buf_macro-list-hist.hist-mode
      620   else '':U) @ v-action  COLUMN-LABEL "Действие" FORMAT "X(8)"
      621   buf_macro-list-hist.num-add   COLUMN-LABEL "записей" FORMAT "->>>>>>>>9"
      622   buf_macro-list-hist.num-recs   COLUMN-LABEL " = итого" FORMAT ">>>>>>>>9"
      623   buf_macro-list-hist.des   COLUMN-LABEL "Множество" FORMAT "X(155)"
      624       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.75 EXPANDABLE.
      625   DEFINE FRAME Dialog-Frame
      626        B-play AT ROW 1 COL 1
      627        B-step AT ROW 1 COL 5
      628        B-pause AT ROW 1 COL 9
      629        B-stop AT ROW 1 COL 13
      630        B-save AT ROW 1 COL 31
      631        B-Help AT ROW 1 COL 54.88
      632        BR-macro AT ROW 3 COL 1
      633        SPACE(0.24) SKIP(0.28)
      634       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      635            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      636            TITLE "Макрос формирования истории".
      637   ASSIGN
      638          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      639          FRAME Dialog-Frame:HIDDEN           = TRUE.
      640   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      641   DO:
      642     APPLY "END-ERROR":U TO SELF.
      643   END.
      644   ON CHOOSE OF B-pause IN FRAME Dialog-Frame
      645   DO:
      646     ASSIGN
      647     v-pause = YES.
      648     p-result = 'b-pause'.
      649   END.
      650   ON CHOOSE OF B-play IN FRAME Dialog-Frame
      651   DO:
      652   DEFINE VARIABLE v-id AS INTEGER NO-UNDO.
      653   DEFINE VARIABLE v-start AS INTEGER NO-UNDO.
      654   DEFINE VARIABLE glog AS LOGICAL NO-UNDO INIT YES.
      655   define variable v-dop as character no-undo .
      656   DEFINE BUFFER loc_macro-list-hist FOR macro-list-hist.
      657   DEFINE BUFFER loc_tree-macro-list-hist FOR macro-list-hist.
      658   IF NOT AVAILABLE buf_macro-list-hist THEN RETURN NO-APPLY.
      659   ASSIGN
      660   v-start = 1
      661   glog = no
      662   .
      663   if buf_macro-list-hist.line <> 0 then do:
      664     message
      665     "Для выполнения можно выбрать только действие <Верхнего> уровня"
      666     view-as alert-box error .
      667     return no-apply.
      668   end.
      669   DO WHILE glog OR v-start <= p-max-id:
      670     _loc-macro:
      671     FOR EACH loc_macro-list-hist WHERE
      672              loc_macro-list-hist.id >= v-start
      673     by loc_macro-list-hist.id:
      674       if loc_macro-list-hist.done = yes then do:
      675         assign
      676         v-start = loc_macro-list-hist.id + 1.
      677         next _loc-macro.
      678       end.
      679       RUN proc-macro-play IN p-callback-handle(INPUT v-start, input no, INPUT p-max-id) NO-ERROR.
      680       IF ERROR-STATUS:ERROR
      681       or entry(1, return-value, chr(4))  = "error":U
      682       THEN DO:
      683         assign
      684         v-dop = return-value
      685         v-dop = substring(v-dop, index(v-dop, chr(4)) + 1)
      686         .
      687         IF v-start < p-max-id THEN DO:
      688           MESSAGE
      689           substitute("Произошла ошибка при выполнении макроса&1&2&1&3&1" +
      690                       "продолжить выполнение?"
      691                       , chr(10)
      692                       , ERROR-STATUS:GET-MESSAGE(1)
      693                       , v-dop)
      694           VIEW-AS ALERT-BOX ERROR BUTTONS YES-NO UPDATE glog.
      695           IF NOT glog THEN RETURN no-apply.
      696           glog = no.
      697         END.
      698         ELSE DO:
      699           MESSAGE
      700           substitute("Произошла ошибка при выполнении макроса&1&2&1&3&1"
      701                       , chr(10)
      702                       , ERROR-STATUS:GET-MESSAGE(1)
      703                       , RETURN-VALUE)
      704           VIEW-AS ALERT-BOX ERROR.
      705         END.
      706       END.
      707       ASSIGN
      708       loc_macro-list-hist.done = YES.
      709       for each loc_tree-macro-list-hist where
      710             loc_tree-macro-list-hist.id = loc_macro-list-hist.id:
      711         loc_tree-macro-list-hist.done = yes.
      712       end.
      713       p-current-step = loc_macro-list-hist.id.
      714       v-start = v-start + 1.
      715       br-macro:REFRESH().
      716       APPLY "CURSOR-DOWN" to br-macro.
      717       PROCESS EVENTS.
      718       RUN get-pause IN THIS-PROCEDURE (OUTPUT v-pause).
      719       RUN get-stop IN THIS-PROCEDURE (OUTPUT v-stop).
      720       IF v-stop  OR v-pause THEN RETURN NO-APPLY.
      721     END.
      722     v-start = v-start + 1.
      723   END.
      724   END.
      725   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      726   DO:
      727     DEFINE VARIABLE f-name AS CHARACTER NO-UNDO.
      728     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      729     define variable filter-str1 as character no-undo .
      730     define variable filter-str2 as character no-undo .
      731     DEFINE BUFFER buf_macro-list-hist FOR macro-list-hist.
      732     find first buf_macro-list-hist no-error.
      733     if not available buf_macro-list-hist then do:
      734       message
      735       "Нет ни одной записи макроса формирования списка" skip
      736       "Нечего сохранять"
      737       view-as alert-box.
      738       return no-apply.
      739     end.
      740       assign
      741       f-name = "default." + entry(2, p-title, chr(4) )
      742       filter-str1 = substitute("&1 *.&2", entry(1, p-title, chr(4)), entry(2, p-title, chr(4) ))
      743       filter-str2 = substitute("*.&1", entry(2, p-title, chr(4)))
      744       glog = yes
      745       .
      746     system-dialog get-file f-name
      747       filters filter-str1 filter-str2
      748       ask-overwrite
      749       save-as
      750       use-filename
      751       update glog
      752       default-extension entry(2, p-title, chr(4) ).
      753     if not glog then do:
      754       apply "entry" to br-macro in frame Dialog-Frame.
      755       return no-apply.
      756     end.
      757     run waitfram-show in this-procedure ("Сохранение макроса формирования списка.    ЖДИТЕ...").
      758     output stream PrnLibStream to value (f-name).
      759     for each buf_macro-list-hist:
      760         export stream PrnLibStream
      761         buf_macro-list-hist.
      762     end.
      763     output stream PrnLibStream close.
      764     run waitfram-hide in this-procedure .
      765   END.
      766   ON CHOOSE OF B-step IN FRAME Dialog-Frame
      767   DO:
      768   DEFINE VARIABLE v-id AS INTEGER NO-UNDO.
      769   define variable v-dop as character no-undo .
      770   DEFINE BUFFER loc_macro-list-hist FOR macro-list-hist.
      771   DEFINE BUFFER loc_tree-macro-list-hist FOR macro-list-hist.
      772     IF NOT AVAILABLE buf_macro-list-hist
      773     or buf_macro-list-hist.done  THEN do:
      774       BELL.
      775       RETURN NO-APPLY.
      776     end.
      777     find first loc_macro-list-hist where loc_macro-list-hist.id = buf_macro-list-hist.id.
      778     RUN proc-macro-play IN p-callback-handle(INPUT buf_macro-list-hist.id, input yes, INPUT p-max-id) NO-ERROR.
      779     IF ERROR-STATUS:ERROR
      780     or entry(1, return-value, chr(4))  = "error":U
      781     THEN DO:
      782       assign
      783       v-dop = return-value
      784       v-dop = substring(v-dop, index(v-dop, chr(4)) + 1)
      785       .
      786        MESSAGE
      787         substitute("Произошла ошибка при выполнении макроса&1&2&1&3"
      788                    , chr(10)
      789                    , ERROR-STATUS:GET-MESSAGE(1)
      790                    , v-dop)
      791         VIEW-AS ALERT-BOX ERROR.
      792     END.
      793     if not (error-status:error
      794            and return-value = '':U) then DO:
      795       ASSIGN
      796       buf_macro-list-hist.done = YES.
      797       for each loc_tree-macro-list-hist where
      798             loc_tree-macro-list-hist.id = loc_macro-list-hist.id:
      799         loc_tree-macro-list-hist.done = yes.
      800       end.
      801       br-macro:REFRESH().
      802       find first loc_macro-list-hist where loc_macro-list-hist.id > buf_macro-list-hist.id no-error .
      803       if available loc_macro-list-hist then do:
      804         REPOSITION br-macro TO RECID RECID(loc_macro-list-hist).
      805         p-current-step = loc_macro-list-hist.id.
      806       end.
      807     END.
      808   END.
      809   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
      810   DO:
      811   define buffer loc_macro-list-hist for macro-list-hist.
      812     ASSIGN
      813     v-stop = YES.
      814     find first loc_macro-list-hist no-lock where
      815               loc_macro-list-hist.id > 0 AND
      816               loc_macro-list-hist.done = no no-error .
      817     if not available loc_macro-list-hist then
      818     p-result = 'end':U.
      819     else do:
      820       p-result = (if p-result = '':u then 'b-stop' else p-result).
      821     end.
      822   END.
      823   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      824   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      825   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   on help of frame Dialog-Frame
      827   do:
      828     run gbl/app_help.p
      829       (input this-procedure :file-name
      830       ,input ''
      831       ,input ?
      832       ) no-error.
      833     if error-status :error then do:
      834       message
      835         "Ошибка при вызове помощи"
      836         error-status :get-message(1)
      837         view-as alert-box .
      838     end.
      839   end.
      840   run minbtn-set in this-procedure .
      841   on choose of b-help in frame Dialog-Frame
      842   do:
      843     apply "help":u to frame Dialog-Frame .
      844   end.
      845   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   procedure minbtn-set :
      847       do
      848           on error undo, return error return-value
      849           :
      850           define variable ii              as integer       no-undo .
      851           define variable fh              as widget-handle no-undo .
      852           define variable hh              as widget-handle no-undo .
      853           define variable v-h             as handle        extent 4 no-undo .
      854           define variable v-name-button   as character     no-undo .
      855           define variable v-help-old-x    as decimal       no-undo .
      856           define variable v-help-old-y    as decimal       no-undo .
      857           define variable v-help-old-size as decimal       no-undo .
      858           define variable v-frame-width   as decimal       no-undo .
      859           define variable jj              as integer       no-undo .
      860           do
      861               on error undo, return error
      862               :
      863               assign
      864                   v-frame-width = frame Dialog-Frame:width - 0.3
      865                   fh            = frame Dialog-Frame:first-child
      866                   hh            = fh:first-child
      867                   ii            = 1
      868                   .
      869               do while valid-handle(hh):
      870                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      871                   do:
      872                       case lc(hh:name) :
      873                           when "b-help" then
      874                               do:
      875                                   hh:load-image-up("cmp/b-help.bmp":u) .
      876                                   hh:load-image-down("cmp/b-help.bmp":u) .
      877                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      878                                   hh:TOOLTIP = "Помощь" .
      879                                   v-help-old-x = hh:column .
      880                                   v-help-old-y = hh:row    .
      881                                   v-help-old-size = hh:width .
      882                                   hh:width-chars = 2.5 .
      883                               end.
      884                           when "b-print" then
      885                               do:
      886                                   hh:load-image("cmp/b-print.bmp":u) .
      887                                   hh:TOOLTIP = "Печать" .
      888                                   v-h[ii] = hh:handle .
      889                                   ii = ii + 1 .
      890                                   hh:width-chars = 3 .
      891                               end.
      892                           when "b-history" or
      893                           when "b-hist" then
      894                               do:
      895                                   hh:load-image("cmp/b-hist.bmp":u) .
      896                                   hh:TOOLTIP = "История" .
      897                                   v-h[ii] = hh:handle .
      898                                   ii = ii + 1 .
      899                                   hh:width-chars = 3 .
      900                               end.
      901                           when "b-sch" then
      902                               do:
      903                                   hh:load-image("cmp/b-sch.bmp":u) .
      904                                   hh:TOOLTIP = "Установка Фильтра" .
      905                                   v-h[ii] = hh:handle .
      906                                   ii = ii + 1 .
      907                                   hh:width-chars = 3 .
      908                               end.
      909                           when "b-hist-user" then
      910                               do:
      911                                   hh:load-image("cmp/b-hist.bmp":u) .
      912                                   hh:TOOLTIP = "История пользователя" .
      913                                   ii = ii + 1 .
      914                               end.
      915                       end case.
      916                   end.
      917                   hh = hh:next-sibling.
      918               end.
      919               b-help:column = v-frame-width - b-help:width-chars.
      920               jj = 0.
      921               repeat ii = 4 to 1 by -1 :
      922                   if valid-handle (v-h[ii] ) then
      923                   do:
      924                       jj  = jj + 1 .
      925                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      926                       v-h[ii]:row    = v-help-old-y .
      927                   end.
      928               end.
      929           end.
      930       end.
      931   end procedure.
      932   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      933   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      934   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      935   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      936   define variable v-diasize-current-frame-width  as decimal   no-undo .
      937   define variable v-diasize-current-frame-height as decimal   no-undo .
      938   define variable v-diasize-change-size          as logical   no-undo .
      939   define variable v-diasize-resize-button        as handle    no-undo .
      940   define variable v-diasize-wndmax               as logical   no-undo .
      941   define variable v-diasize-wndstore             as logical   no-undo .
      942   define variable v-diasize-proc-name            as character no-undo .
      943   define variable v-diasize-browse-handle        as handle    no-undo .
      944   define variable v-diasize-browse-number        as integer   no-undo .
      945   define variable v-diasize-need-full-display    as logical   no-undo init false .
      946   define temp-table temp-diasize-handle no-undo
      947     field handle-value  as handle
      948     field save-position as decimal
      949     index xpk is primary unique handle-value
      950     .
      951   define temp-table temp-browse-handle no-undo
      952     field browse-type   as character
      953     field browse-number as integer
      954     field browse-handle as handle
      955     field original-size as decimal
      956     index xpk is primary unique browse-type browse-number
      957     index xie browse-type browse-handle
      958   .
      959   procedure diasize_change-height :
      960     define input  parameter p-change-value  as decimal   no-undo .
      961     define input  parameter p-move-resize   as logical   no-undo .
      962     define variable v-field-group-handle    as handle    no-undo .
      963     define variable v-object-handle         as handle    no-undo .
      964     define variable v-frame-height          as decimal   no-undo .
      965     define variable v-frame-virtual-height  as decimal   no-undo .
      966     define variable v-browse-height         as decimal   no-undo .
      967     define variable v-window-height         as decimal   no-undo .
      968     define variable v-window-virtual-height as decimal   no-undo .
      969     define variable v-change-sign           as integer   no-undo .
      970     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      971     define buffer buf_temp-browse-handle  for temp-browse-handle .
      972     if p-change-value > 0
      973     then do:
      974       if frame Dialog-Frame :height + p-change-value
      975           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      976       then do:
      977         assign
      978           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      979                           - (frame Dialog-Frame :height-chars)
      980         .
      981         if p-change-value <= 0
      982         then do:
      983           run diasize_position-resize-button in this-procedure .
      984           return .
      985         end.
      986       end.
      987     end.
      988     if p-change-value < 0
      989     then do:
      990       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      991       then do:
      992         assign
      993           p-change-value = v-diasize-orig-frame-height
      994                          - (frame Dialog-Frame :height-chars)
      995         .
      996         if p-change-value >= 0
      997         then do:
      998           run diasize_position-resize-button in this-procedure .
      999           return .
     1000         end.
     1001       end.
     1002     end.
     1003     if p-change-value >= 0
     1004     then do:
     1005       assign
     1006         v-change-sign = 1
     1007       .
     1008     end.
     1009     else do:
     1010       assign
     1011         v-change-sign = -1
     1012       .
     1013     end.
     1014     assign
     1015       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1016     .
     1017     if p-change-value = 0
     1018     then do:
     1019       run diasize_position-resize-button in this-procedure .
     1020       return .
     1021     end.
     1022     move_block:
     1023     do
     1024     on error undo move_block, retry move_block
     1025     :
     1026       if retry
     1027       then do:
     1028         do
     1029         on error undo move_block, leave move_block
     1030         :
     1031           if p-change-value > 0
     1032           then do:
     1033             for each buf_temp-diasize-handle
     1034             on error undo, next
     1035             :
     1036               assign
     1037                 v-object-handle = buf_temp-diasize-handle.handle-value
     1038               .
     1039               if v-object-handle <> v-diasize-resize-button
     1040               then do:
     1041                 assign
     1042                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1043                 .
     1044               end.
     1045             end.
     1046             assign
     1047               v-diasize-browse-handle :height = v-browse-height
     1048             .
     1049             for each buf_temp-browse-handle
     1050               where buf_temp-browse-handle.browse-type = 'height':u
     1051             on error undo, next
     1052             :
     1053               assign
     1054                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1055               .
     1056             end.
     1057             assign
     1058               frame Dialog-Frame :height = v-frame-height
     1059             .
     1060             if frame Dialog-Frame :scrollable = true
     1061             then do:
     1062               assign
     1063                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1064               .
     1065             end.
     1066             run diasize_position-resize-button in this-procedure .
     1067           end.
     1068           else do:
     1069             if frame Dialog-Frame :scrollable = true
     1070             then do:
     1071               assign
     1072                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1073               .
     1074             end.
     1075             assign
     1076               frame Dialog-Frame :height = v-frame-height
     1077             .
     1078             assign
     1079               v-diasize-browse-handle :height = v-browse-height
     1080             .
     1081             for each buf_temp-browse-handle
     1082               where buf_temp-browse-handle.browse-type = 'height':u
     1083             on error undo, next
     1084             :
     1085               assign
     1086                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1087               .
     1088             end.
     1089             for each buf_temp-diasize-handle
     1090             on error undo, next
     1091             :
     1092               assign
