     1114       then do:
     1115         assign
     1116           v-diasize-change-size = true
     1117         .
     1118       end.
     1119       else do:
     1120         return .
     1121       end.
     1122       assign
     1123         v-frame-height = frame Dialog-Frame :height
     1124         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1125         v-browse-height = v-diasize-browse-handle :height
     1126       .
     1127       for each buf_temp-browse-handle
     1128         where buf_temp-browse-handle.browse-type = 'height':u
     1129       :
     1130         assign
