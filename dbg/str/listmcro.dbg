     1702           define variable v-cntxt-db-num        as integer   no-undo .
     1703           define variable v-cntxt-userid        as character no-undo .
     1704           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1705                                             , OUTPUT v-cntxt-userid
     1706                                             ) .
     1707           run gbl/wndsizew.p
     1708             (input  v-cntxt-db-num
     1709             ,input  v-cntxt-userid
     1710             ,input  v-diasize-proc-name
     1711             ,input  'width':u
     1712             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1713             ) .
     1714         end.
     1715       end.
     1716     end.
     1717     assign
     1718       v-diasize-change-size = false
     1719     .
     1720   end procedure.
     1721   procedure diasize_set-width :
     1722     define input  parameter p-new-width  as decimal   no-undo .
     1723     define input  parameter p-move-resize as logical   no-undo .
     1724     do
     1725     on error undo, return error return-value
     1726     :
     1727       run diasize_change-width in this-procedure
     1728         (input  (p-new-width - frame Dialog-Frame :width)
     1729         ,input  p-move-resize
     1730         ) .
     1731     end.
     1732   end procedure.
     1733   procedure diasize_position-resize-button :
     1734     do with frame Dialog-Frame
     1735     :
     1736       hide v-diasize-resize-button .
     1737       assign
     1738         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1739                     - 1
     1740                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1741         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1742                     - 1
     1743                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1744       .
     1745       view v-diasize-resize-button .
     1746     end.
     1747   end procedure.
     1748   on alt-right anywhere
     1749   do:
     1750     run diasize_change-width in this-procedure
     1751       (input 1
     1752       ,input true
     1753       ) .
     1754     return no-apply .
     1755   end.
     1756   on alt-left anywhere
     1757   do:
     1758     run diasize_change-width in this-procedure
     1759       (input -1
     1760       ,input true
     1761       ) .
     1762     return no-apply .
     1763   end.
     1764   on alt-down anywhere
     1765   do:
     1766     run diasize_change-height in this-procedure
     1767       (input 1
     1768       ,input true
     1769       ) .
     1770     return no-apply .
     1771   end.
     1772   on alt-up anywhere
     1773   do:
     1774     run diasize_change-height in this-procedure
     1775       (input -1
     1776       ,input true
     1777       ) .
     1778     return no-apply .
     1779   end.
     1780   on alt-enter of frame Dialog-Frame
     1781   do:
     1782     run diasize_maximize in this-procedure
     1783       (input  ?
     1784       ).
     1785     return no-apply .
     1786   end.
     1787   procedure diasize_end-move :
     1788     do
     1789     on error undo, return error return-value
     1790     :
     1791       define variable v-row-delta as decimal   no-undo .
     1792       define variable v-col-delta as decimal   no-undo .
     1793       define variable v-new-row as decimal   no-undo .
     1794       define variable v-new-col as decimal   no-undo .
     1795       assign
     1796         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1797         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1798       .
     1799       assign
     1800         v-row-delta = v-new-row - frame Dialog-Frame :height
     1801         v-col-delta = v-new-col - frame Dialog-Frame :width
     1802       .
     1803       run diasize_change-height in this-procedure
     1804         (input v-row-delta
     1805         ,input true
     1806         ) .
     1807       run diasize_change-width in this-procedure
     1808         (input v-col-delta
     1809         ,input true
     1810         ) .
     1811     end.
     1812   end procedure.
     1813   procedure diasize_maximize :
     1814     define input  parameter p-action as logical   no-undo .
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818       if p-action = ?
     1819       then do:
     1820         if v-diasize-need-maximize = true
     1821         then do:
     1822           assign
     1823             p-action = true
     1824           .
     1825         end.
     1826         else do:
     1827           assign
     1828             p-action = false
     1829           .
     1830         end.
     1831       end.
     1832       if p-action = true
     1833       then do:
     1834         run diasize_change-height in this-procedure
     1835           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1836               - frame Dialog-Frame :height-chars
     1837           ,input true
     1838           ) .
     1839         run diasize_change-width in this-procedure
     1840           (input session :width-chars
     1841               - frame Dialog-Frame :width-chars
     1842           ,input true
     1843           ) .
     1844         assign
     1845           v-diasize-need-maximize = false
     1846         .
     1847       end.
     1848       else do:
     1849         run diasize_change-width in this-procedure
     1850           (input v-diasize-orig-frame-width
     1851               - frame Dialog-Frame :width-chars
     1852           ,input true
     1853           ) .
     1854         run diasize_change-height in this-procedure
     1855           (input v-diasize-orig-frame-height
     1856               - frame Dialog-Frame :height-chars
     1857           ,input true
     1858           ) .
     1859         assign
     1860           v-diasize-need-maximize = true
     1861         .
     1862       end.
     1863     end.
     1864   end procedure.
     1865   procedure diasize_restore-orig-size :
     1866     do
     1867     on error undo, return error return-value
     1868     :
     1869       assign
     1870         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1871         v-diasize-current-frame-height = frame Dialog-Frame :height
     1872       .
     1873       run diasize_set-height in this-procedure
     1874         (input  v-diasize-orig-frame-height
     1875         ,input  true
     1876         ) .
     1877       run diasize_set-width in this-procedure
     1878         (input  v-diasize-orig-frame-width
     1879         ,input  true
     1880         ) .
     1881     end.
     1882   end procedure.
     1883   procedure diasize_restore-current-size :
     1884     do
     1885     on error undo, return error return-value
     1886     :
     1887       run diasize_set-height in this-procedure
     1888         (input  v-diasize-current-frame-height
     1889         ,input  true
     1890         ) .
     1891       run diasize_set-width in this-procedure
     1892         (input  v-diasize-current-frame-width
     1893         ,input  true
     1894         ) .
     1895     end.
     1896   end procedure.
     1897   procedure diasize_set-browse-handle :
     1898     define input  parameter p-browse-handle as handle   no-undo .
     1899     define buffer buf_temp-browse-handle for temp-browse-handle .
     1900     do
     1901     on error undo, return error return-value
     1902     :
     1903       assign
     1904         v-diasize-browse-handle = p-browse-handle
     1905       .
     1906       for each buf_temp-browse-handle
     1907       on error undo, return error return-value
     1908       :
     1909         delete buf_temp-browse-handle .
     1910       end.
     1911     end.
     1912   end procedure.
     1913   procedure diasize_add_browse :
     1914     define input  parameter p-browse-type   as character no-undo .
     1915     define input  parameter p-browse-handle as handle    no-undo .
     1916     define buffer buf_temp-browse-handle for temp-browse-handle .
     1917     do
     1918     on error undo, return error return-value
     1919     :
     1920       assign
     1921         v-diasize-browse-number = v-diasize-browse-number + 1
     1922       .
     1923       create buf_temp-browse-handle .
     1924       assign
     1925         buf_temp-browse-handle.browse-type   = p-browse-type
     1926         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1927         buf_temp-browse-handle.browse-handle = p-browse-handle
     1928       .
     1929     end.
     1930   end procedure.
     1931   procedure diasize_init :
     1932     define variable v-default-value    as logical   no-undo .
     1933     define variable v-restore-saved    as logical   no-undo .
     1934     define variable v-resize-value-str as character no-undo .
     1935     do
     1936     on error undo, return error return-value
     1937     :
     1938       do with frame Dialog-Frame
     1939       :
     1940         assign
     1941           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1942           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1943           v-diasize-browse-handle     = browse BR-macro :handle
     1944         .
     1945         create button v-diasize-resize-button
     1946         assign
     1947           parent        = frame Dialog-Frame :first-child
     1948           label         = "s"
     1949           height-pixels = 16
     1950           width-pixels  = 16
     1951           visible       = true
     1952           sensitive     = true
     1953           movable       = true
     1954           triggers:
     1955             on end-move persistent run diasize_end-move in this-procedure .
     1956           end triggers.
     1957         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1958         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1959         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1960         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1961         assign
     1962           v-diasize-wndmax = false
     1963         .
     1964         if connected("ub") = true
     1965         then do:
     1966           define variable v-cntxt-db-num        as integer   no-undo .
     1967           define variable v-cntxt-userid        as character no-undo .
     1968           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1969                                             , OUTPUT v-cntxt-userid
     1970                                             ) .
     1971           run gbl/wndpar_r.p
     1972             (input  v-cntxt-db-num
     1973             ,input  v-cntxt-userid
     1974             ,input  'wndmax':U
     1975             ,output v-diasize-wndmax
     1976             ,output v-default-value
     1977             ) .
     1978         end.
     1979         assign
     1980           v-diasize-wndstore = false
     1981         .
     1982         if connected("ub") = true
     1983         then do:
     1984           run gbl/wndpar_r.p
     1985             (input  v-cntxt-db-num
     1986             ,input  v-cntxt-userid
     1987             ,input  'wndstore':U
     1988             ,output v-diasize-wndstore
     1989             ,output v-default-value
     1990             ) .
     1991         end.
     1992         assign
     1993           v-diasize-proc-name = entry(1, program-name(2), '.')
     1994         .
     1995         if v-diasize-wndstore = true
     1996         then do:
     1997           assign
     1998             v-restore-saved = false
     1999           .
     2000           if connected("ub") = true
     2001           then do:
     2002             run gbl/wndsizer.p
     2003               (input  v-cntxt-db-num
     2004               ,input  v-cntxt-userid
     2005               ,input  v-diasize-proc-name
     2006               ,input  'height':u
     2007               ,output v-resize-value-str
     2008               ) .
     2009             if v-resize-value-str <> '':U
     2010             then do:
     2011               run diasize_change-height in this-procedure
     2012                 (input  integer(v-resize-value-str)
     2013                 ,input  true
     2014                 ) .
     2015               assign
     2016                 v-restore-saved = true
     2017               .
     2018             end.
     2019           end.
     2020           if connected("ub") = true
     2021           then do:
     2022             run gbl/wndsizer.p
     2023               (input  v-cntxt-db-num
     2024               ,input  v-cntxt-userid
     2025               ,input  v-diasize-proc-name
     2026               ,input  'width':u
     2027               ,output v-resize-value-str
     2028               ) .
     2029             if v-resize-value-str <> '':U
     2030             then do:
     2031               run diasize_change-width in this-procedure
     2032                 (input  integer(v-resize-value-str)
     2033                 ,input  true
     2034                 ) .
     2035               assign
     2036                 v-restore-saved = true
     2037               .
     2038             end.
     2039           end.
     2040           if v-restore-saved <> true
     2041           then do:
     2042             if v-diasize-wndmax = true
     2043             then do:
     2044               run diasize_maximize in this-procedure
     2045                 (input  true
     2046                 ) .
     2047             end.
     2048           end.
     2049         end.
     2050         else do:
     2051           if v-diasize-wndmax = true
     2052           then do:
     2053             run diasize_maximize in this-procedure
     2054               (input  true
     2055               ) .
     2056           end.
     2057         end.
     2058       end.
     2059     end.
     2060   end procedure.
     2061   procedure diasize_need-full-display :
     2062     define output parameter p-need-full-display as logical   no-undo .
     2063     do
     2064     on error undo, return error return-value
     2065     :
     2066       assign
     2067         p-need-full-display = v-diasize-need-full-display
     2068       .
     2069       assign
     2070         v-diasize-need-full-display = false
     2071       .
     2072     end.
     2073   end procedure.
     2074   procedure get-context :
     2075      define output parameter p-db-num as integer          no-undo.
     2076      define output parameter p-user-id as character        no-undo.
     2077      define variable v-login               as character    no-undo.
     2078      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2079      define buffer buf_user-login  for ub.user-login .
     2080      do
     2081      on error undo, return error
     2082      :
     2083            FIND FIRST buf_sys-ctrl no-lock.
     2084            ASSIGN
     2085               v-login = USERID("ub")
     2086               p-db-num = buf_sys-ctrl.db-num
     2087            .
     2088            FIND FIRST buf_user-login
     2089                 WHERE buf_user-login.db-num = p-db-num
     2090                   AND buf_user-login.user-login = v-login
     2091                 no-lock
     2092                 no-error
     2093                 .
     2094            IF AVAILABLE buf_user-login
     2095            THEN DO:
     2096               assign
     2097                  p-user-id = buf_user-login.user-id
     2098               .
     2099            END.
     2100      end.
     2101   end procedure.
     2102       run diasize_init in this-procedure .
     2103   MAIN-BLOCK:
     2104   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2105      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2106     RUN Myenable.
     2107     WAIT-FOR GO OF FRAME Dialog-Frame.
     2108   END.
     2109   RUN disable_UI.
     2110   PROCEDURE disable_UI :
     2111     HIDE FRAME Dialog-Frame.
     2112   END PROCEDURE.
     2113   PROCEDURE enable_UI :
     2114     ENABLE B-play B-step B-pause B-stop B-save B-Help
     2115         WITH FRAME Dialog-Frame.
     2116     VIEW FRAME Dialog-Frame.
     2117     OPEN QUERY BR-macro FOR EACH buf_macro-list-hist.
     2118   END PROCEDURE.
     2119   PROCEDURE get-pause :
     2120   DEFINE OUTPUT PARAMETER p-pause AS LOGICAL NO-UNDO.
     2121   IF v-pause  THEN
     2122   p-pause = YES.
     2123   END PROCEDURE.
     2124   PROCEDURE get-stop :
     2125   DEFINE OUTPUT PARAMETER p-stop AS LOGICAL NO-UNDO.
     2126   IF v-stop  THEN
     2127   p-stop = YES.
     2128   END PROCEDURE.
     2129   PROCEDURE MyEnable :
     2130   define buffer find_macro-list-hist for macro-list-hist.
     2131   ASSIGN
     2132   buf_macro-list-hist.des:RESIZABLE IN BROWSE br-macro = YES
     2133   buf_macro-list-hist.des:width IN BROWSE br-macro = 60
     2134   frame Dialog-Frame:title = entry(1, p-title, chr(4))
     2135   .
     2136   ENABLE
     2137   B-play  WHEN lookup("b-play", bttns) > 0
     2138   B-step   WHEN lookup("b-step", bttns) > 0
     2139   b-save
     2140   B-pause
     2141   B-stop
     2142   B-save
     2143   B-Help
     2144   br-macro
     2145   WITH FRAME Dialog-Frame.
     2146   VIEW FRAME Dialog-Frame.
     2147   OPEN QUERY BR-macro FOR EACH buf_macro-list-hist.
     2148   if p-current-step <> 0  then do:
     2149     find first find_macro-list-hist no-lock where
     2150              find_macro-list-hist.id = p-current-step
     2151          and find_macro-list-hist.line = 0 no-error .
     2152     if available find_macro-list-hist then do:
     2153       reposition br-macro to recid recid(find_macro-list-hist) no-error .
     2154     end.
     2155     apply "ENTRY" to br-macro.
     2156   end.
     2157   END PROCEDURE.
