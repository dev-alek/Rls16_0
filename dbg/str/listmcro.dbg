     1180           v-diasize-resize-button :row    = 1
     1181           v-diasize-resize-button :column = 1
     1182         .
     1183       end.
     1184       if p-change-value > 0
     1185       then do:
     1186         if frame Dialog-Frame :scrollable = true
     1187         then do:
     1188           assign
     1189             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1190             no-error .
     1191           if error-status :error
     1192           or error-status :get-message(1) <> ""
     1193           then do:
     1194             undo move_block, retry move_block .
     1195           end.
     1196         end.
     1197         assign
     1198           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1199           no-error .
     1200         if error-status :error
     1201         or error-status :get-message(1) <> ""
     1202         then do:
     1203           undo move_block, retry move_block .
     1204         end.
     1205         assign
