     1354     define variable v-window-width         as decimal   no-undo .
     1355     define variable v-window-virtual-width as decimal   no-undo .
     1356     define variable v-change-sign          as integer   no-undo .
     1357     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1358     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1359     if p-change-value > 0
     1360     then do:
     1361       if frame Dialog-Frame :width + p-change-value >
     1362           session :width-chars
     1363       then do:
     1364         assign
     1365           p-change-value = session :width-chars - frame Dialog-Frame :width
     1366         .
     1367         if p-change-value <= 0
     1368         then do:
     1369           run diasize_position-resize-button in this-procedure .
     1370           return .
     1371         end.
     1372       end.
     1373     end.
     1374     if p-change-value < 0
     1375     then do:
     1376       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1377       then do:
     1378         assign
     1379           p-change-value = v-diasize-orig-frame-width
     1380                          - frame Dialog-Frame :width
     1381         .
     1382         if p-change-value >= 0
     1383         then do:
     1384           run diasize_position-resize-button in this-procedure .
     1385           return .
     1386         end.
     1387       end.
     1388     end.
     1389     if p-change-value >= 0
     1390     then do:
     1391       assign
     1392         v-change-sign = 1
     1393       .
     1394     end.
     1395     else do:
     1396       assign
     1397         v-change-sign = -1
     1398       .
     1399     end.
     1400     assign
     1401       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1402     .
     1403     if p-change-value = 0
     1404     then do:
     1405       run diasize_position-resize-button in this-procedure .
     1406       return .
     1407     end.
     1408     move_block:
     1409     do
     1410     on error undo move_block, leave move_block
     1411     :
     1412       if retry
     1413       then do:
     1414         do
     1415         on error undo move_block, leave move_block
     1416         :
     1417           if p-change-value > 0
     1418           then do:
     1419             for each buf_temp-diasize-handle
     1420             on error undo, next
     1421             :
     1422               assign
     1423                 v-object-handle = buf_temp-diasize-handle.handle-value
     1424               .
