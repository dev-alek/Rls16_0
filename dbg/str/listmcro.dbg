     1543               where buf_temp-browse-handle.browse-type   = 'width':u
     1544                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1545               no-error .
     1546             if available buf_temp-browse-handle
     1547             then do:
     1548             end.
     1549             else do:
     1550               create buf_temp-diasize-handle .
     1551               assign
     1552                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1553                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1554               .
     1555             end.
     1556           end.
     1557           assign
     1558             v-object-handle = v-object-handle :next-sibling
     1559           .
     1560         end.
