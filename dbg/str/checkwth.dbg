      990             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      991             SIZE 98.6 BY 2.27
      992        ":" VIEW-AS TEXT
      993             SIZE .8 BY 1.07 AT ROW 3.7 COL 20.4
      994        "Время:" VIEW-AS TEXT
      995             SIZE 10.3 BY 1 AT ROW 3.63 COL 2
      996        ":" VIEW-AS TEXT
      997             SIZE .8 BY 1.07 AT ROW 3.7 COL 16.4
      998        "Тип чека" VIEW-AS TEXT
      999             SIZE 11.8 BY .83 AT ROW 1.47 COL 72.3
     1000        SPACE(16.27) SKIP(19.74)
     1001       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1002            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1003            TITLE "Чек МЦ"
     1004            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1005   ASSIGN
     1006          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1007          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1008   ON ANY-KEY OF FRAME Dialog-Frame
     1009   DO:
     1010     return no-apply.
     1011   END.
     1012   ON END-ERROR OF FRAME Dialog-Frame
     1013   DO:
     1014      apply "choose" to B-quit in frame Dialog-Frame.
     1015     return no-apply.
     1016   END.
     1017   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1018   DO:
     1019      p-next-prev = "QUIT".
     1020     APPLY "END-ERROR":U TO SELF.
     1021   END.
     1022   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1023   DO:
     1024     run proc-b-add in this-procedure no-error.
     1025     if error-status:error THEN return no-apply.
     1026   END.
     1027   ON CHOOSE OF b-cd IN FRAME Dialog-Frame
     1028   DO:
     1029     run sel-cd in this-procedure no-error.
     1030     if error-status:error then return no-apply.
     1031     else do:
     1032       assign
     1033       tt-chk-doc.pay-desk = buf_cash-desk.cash-num
     1034       .
     1035       display
     1036       tt-chk-doc.pay-desk
     1037       with frame Dialog-Frame.
     1038     end.
     1039   END.
     1040   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1041   DO:
     1042     APPLY "DELETE-CHARACTER" to br-lines.
     1043   END.
     1044   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1045   DO:
     1046   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   if lookup(self :type
     1048            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1049            ) = 0
     1050   then do:
     1051     message
     1052       "$Workfile$"
     1053       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1054       "Интерфейсный элемент" self :name  skip
     1055       "Тип" self :type  skip
     1056       "Процедура" this-procedure :file-name skip
     1057       view-as alert-box .
     1058   end.
     1059   else do:
     1060     apply "entry":u to self  .
     1061     if focus :handle <> self :handle  then do:
     1062       return no-apply .
     1063     end.
     1064   end.
     1065     if par-mode = 'ПРОСМОТР':U then.
     1066     else do:
     1067       run check-this-check in this-procedure no-error.
     1068       if error-status:error then do:
     1069         return no-apply.
     1070       end.
     1071     end.
     1072   END.
     1073   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1074   DO:
     1075   define variable v-rid-list as character no-undo .
     1076       if available locked_chk-doc THEN
     1077       run str/cchkdocs.w (
     1078                           input parparentproc
     1079                          ,input "":U
     1080                          ,input "one":U
     1081                          ,input locked_chk-doc.doc-code
     1082                          ,input p-obj-type
     1083                          ,input p-obj-code
     1084                          ,input-output v-rid-list
     1085                       ).
     1086   END.
     1087   ON CHOOSE OF B-next IN FRAME Dialog-Frame
     1088   DO:
     1089      run reposition-chk-doc in this-procedure
     1090     (input 'next':U
     1091     ).
     1092   END.
     1093   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
     1094   DO:
     1095      run reposition-chk-doc in this-procedure
     1096     (input 'prev':U
     1097     ).
     1098   END.
     1099   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1100   DO:
     1101   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1102   if lookup(self :type
     1103            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1104            ) = 0
     1105   then do:
     1106     message
     1107       "$Workfile$"
     1108       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1109       "Интерфейсный элемент" self :name  skip
     1110       "Тип" self :type  skip
     1111       "Процедура" this-procedure :file-name skip
     1112       view-as alert-box .
     1113   end.
     1114   else do:
     1115     apply "entry":u to self  .
     1116     if focus :handle <> self :handle  then do:
     1117       return no-apply .
     1118     end.
     1119   end.
     1120   define variable glog as logical no-undo .
     1121      IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1122       IF CAN-FIND( FIRST ub.chk-pay NO-LOCK WHERE
     1123                          ub.chk-pay.doc-code = tt-chk-doc.doc-code ) THEN DO:
     1124         MESSAGE
     1125           "Чек не будет сохранен, а вся введенная Вами информация будет потеряна!" SKIP
     1126           "Для того, чтобы сохранить документ, нужно нажать кнопку ~"" +
     1127           B-exit:LABEL IN FRAME Dialog-Frame + "~"." SKIP( 1 )
     1128           "Вы уверены, что хотите выйти БЕЗ СОХРАНЕНИЯ?" SKIP
     1129           "YES[ДА] - Выйти БЕЗ СОХРАНЕНИЯ;" SKIP
     1130           "NO[НЕТ] - Остаться в документе."
     1131         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO
     1132         TITLE "Выход из чека без сохранения" UPDATE glog.
     1133         IF glog = NO THEN DO:
     1134           RETURN NO-APPLY.
     1135         END.
     1136       END.
     1137       DO TRANSACTION ON ERROR UNDO, LEAVE :
     1138         case par-mode:
     1139           when 'ДОБАВЛЕНИЕ':U then do:
     1140             if available locked_chk-doc then
     1141             delete locked_chk-doc.
     1142             p-doc-rec = ?.
     1143           end.
     1144         END CASE.
     1145         p-doc-rec = ?.
     1146         p-next-prev = ?.
     1147       END.
     1148     END.
     1149     p-next-prev = ?.
     1150   END.
     1151   ON DELETE-CHARACTER OF BR-lines IN FRAME Dialog-Frame
     1152   DO:
     1153   define variable glog as logical no-undo .
     1154   if par-mode <> 'ДОБАВЛЕНИЕ':U then return no-apply.
     1155   glog = yes.
     1156   message
     1157   "Удалить строчку из чека ?"
     1158   view-as alert-box question buttons OK-Cancel update glog.
     1159   if glog <> true then return.
     1160   FIND FIRST locked_chk-pay where
     1161         locked_chk-pay.doc-code = tt-chk-pay.doc-code
     1162     AND locked_chk-pay.line-num = tt-chk-pay.line-num.
     1163   DELETE tt-chk-pay.
     1164   delete locked_chk-pay.
     1165   OPEN QUERY BR-lines FOR EACH locked_chk-pay NO-LOCK WHERE        locked_chk-pay.doc-code = tt-chk-doc.doc-code,            FIRST tt-chk-pay WHERE         tt-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-chk-pay.line-num = locked_chk-pay.line-num.
     1166   run control-line in this-procedure ( output locked-title).
     1167   run lock-proc in this-procedure ( input locked-title).
     1168   APPLY "entry" TO br-lines.
     1169   END.
     1170   ON VALUE-CHANGED OF tt-chk-doc.chk-type IN FRAME Dialog-Frame
     1171   DO:
     1172   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   if lookup(self :type
     1174            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1175            ) = 0
