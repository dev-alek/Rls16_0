     1177     message
     1178       "$Workfile$"
     1179       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1180       "Интерфейсный элемент" self :name  skip
     1181       "Тип" self :type  skip
     1182       "Процедура" this-procedure :file-name skip
     1183       view-as alert-box .
     1184   end.
     1185   else do:
     1186     apply "entry":u to self  .
     1187     if focus :handle <> self :handle  then do:
     1188       return no-apply .
     1189     end.
     1190   end.
     1191     IF CAN-FIND(FIRST tt-chk-pay WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code)
     1192         THEN DO:
     1193         MESSAGE
     1194         "Установить тип чека можно только в самом начале процесса создания чека" SKIP
     1195         "когда еще не созданы строки"
     1196         VIEW-AS ALERT-BOX ERROR.
     1197         display tt-chk-doc.chk-type
     1198         with frame Dialog-Frame .
     1199         RETURN NO-APPLY.
     1200     END.
     1201     ASSIGN
     1202     tt-chk-doc.chk-type.
     1203     locked_chk-doc.chk-type = tt-chk-doc.chk-type.
     1204   END.
     1205   ON LEAVE OF fhour IN FRAME Dialog-Frame
     1206   DO:
     1207     run check-time in this-procedure ( input fhour:screen-value, input "hour":U) no-error.
     1208     if error-status:error then return no-apply.
     1209   END.
     1210   ON LEAVE OF fmin IN FRAME Dialog-Frame
     1211   DO:
     1212     run check-time in this-procedure ( input fmin:screen-value, input "min":U) no-error.
     1213     if error-status:error then return no-apply.
     1214   END.
     1215   ON LEAVE OF fsec IN FRAME Dialog-Frame
     1216   DO:
     1217       run check-time in this-procedure ( input fsec:screen-value, input "sec":U)  no-error.
     1218     if error-status:error then return no-apply.
     1219   END.
     1220   ON LEAVE OF tt-chk-doc.shift-name IN FRAME Dialog-Frame
     1221   DO:
     1222       define variable v-dopi as integer no-undo .
     1223     define variable v-old-shift-name as character no-undo .
     1224       assign
     1225       v-old-shift-name = tt-chk-doc.shift-name
     1226       tt-chk-doc.shift-name
     1227       .
     1228       assign
     1229       v-dopi = integer(tt-chk-doc.shift-name) no-error .
     1230       if error-status:error
     1231       or v-dopi < 0
     1232       or v-dopi > 99 then do:
     1233         message
     1234         "Неверное значение № смены"
     1235         view-as alert-box error .
     1236         tt-chk-doc.shift-name = v-old-shift-name .
     1237         display
     1238         tt-chk-doc.shift-name
     1239         with frame Dialog-Frame .
     1240         return no-apply.
     1241       end.
     1242       display
     1243       v-dopi @ tt-chk-doc.shift-num
     1244       with frame Dialog-Frame .
     1245   END.
     1246   ON LEAVE OF tt-chk-doc.src-shift-date IN FRAME Dialog-Frame
     1247   DO:
     1248      assign
     1249     tt-chk-doc.src-shift-date.
     1250     run find-uchet-date in this-procedure no-error.
     1251     if error-status:error then return no-apply.
     1252   END.
     1253   ON LEAVE OF tt-chk-pay.tot-sum IN BROWSE br-lines,
     1254               tt-chk-pay.pay-code IN BROWSE br-lines,
     1255               tt-chk-pay.curr-code IN BROWSE br-lines DO:
     1256   define variable old-sum      like tt-chk-pay.tot-sum no-undo .
     1257   define variable old-pay-code like tt-chk-pay.pay-code no-undo .
     1258   define variable old-curr-code like tt-chk-pay.curr-code no-undo .
     1259   define variable old-src-qnty like tt-chk-pay.src-qnty no-undo .
     1260   define variable old-src-val like tt-chk-pay.src-val no-undo .
     1261   DEFINE VARIABLE varopl-curs as decimal no-undo .
     1262   DEFINE VARIABLE varbase-curs as decimal no-undo .
     1263   define buffer buf_wth-par for ub.wth-par.
     1264   if avail tt-chk-pay then DO:
     1265   assign
     1266   old-sum      = tt-chk-pay.tot-sum
     1267   old-pay-code = tt-chk-pay.pay-code
     1268   old-curr-code = tt-chk-pay.curr-code
     1269   old-src-qnty = tt-chk-pay.src-qnty
     1270   old-src-val = tt-chk-pay.src-val
     1271   .
     1272   assign
     1273   tt-chk-pay.tot-sum = decimal(tt-chk-pay.tot-sum:screen-value in browse br-lines)
     1274   tt-chk-pay.pay-code = integer(tt-chk-pay.pay-code:screen-value in browse br-lines)
     1275   tt-chk-pay.curr-code = decimal(tt-chk-pay.curr-code:screen-value in browse br-lines    )
     1276   tt-chk-pay.src-qnty = decimal(tt-chk-pay.src-qnty:screen-value in browse br-lines    )
     1277   tt-chk-pay.src-val = integer(tt-chk-pay.src-val:screen-value in browse br-lines    )
     1278   .
     1279   FIND FIRST LOCKED_chk-pay NO-LOCK WHERE
     1280             LOCKED_chk-pay.doc-code = tt-chk-doc.doc-code
     1281        AND  LOCKED_chk-pay.line-num = tt-chk-pay.line-num.
     1282   run trg/chkins02.p (
     1283                 input  tt-chk-doc.doc-code
     1284                ,input  1
     1285                ,input  tt-chk-doc.chk-type
     1286                ,input  tt-chk-doc.obj-type
     1287                ,input  tt-chk-doc.obj-code
     1288                ,input  tt-chk-doc.chk-date
     1289                ,input  tt-chk-doc.chk-time
     1290                ,input  tt-chk-pay.pay-code
     1291                ,input  tt-chk-pay.curr-code
     1292                ,input  varbase-code
     1293                ,input  get-chkc_context.r-b
     1294                ,input  get-chkc_context.cas-curs
     1295                ,input-output  tt-chk-pay.cash-rate
     1296                ,input-output  tt-chk-pay.bank-rate
     1297                ,input-output  tt-chk-pay.bank-scale
     1298                ,input  recid(locked_chk-pay)
     1299                ,output varbase-curs
     1300                ,output varopl-curs
     1301                ,output tt-chk-pay.par-code
     1302              ) no-error.
     1303     if error-status:error then do:
     1304       assign
     1305       tt-chk-pay.tot-sum        =   old-sum
     1306       tt-chk-pay.pay-code   =   old-pay-code
     1307       tt-chk-pay.curr-code  =   old-curr-code
     1308       tt-chk-pay.src-qnty = old-src-qnty
     1309       tt-chk-pay.src-val = old-src-val
     1310       .
     1311       display
     1312       tt-chk-pay.tot-sum
     1313       tt-chk-pay.pay-code
     1314       tt-chk-pay.curr-code
     1315       tt-chk-pay.src-qnty
     1316       tt-chk-pay.src-val
     1317       with browse br-lines.
     1318     end.
     1319    END.
     1320   end.
     1321   ON RETURN OF tt-chk-pay.tot-sum IN BROWSE br-lines,
     1322               tt-chk-pay.pay-code IN BROWSE br-lines,
     1323               tt-chk-pay.curr-code IN BROWSE br-lines,
     1324               tt-chk-pay.src-qnty IN BROWSE br-lines,
     1325               tt-chk-pay.src-val IN BROWSE br-lines
     1326               DO:
     1327     APPLY "LEAVE" TO SELF.
     1328   END.
     1329   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1330   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1331   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332   on help of frame Dialog-Frame
     1333   do:
     1334     run gbl/app_help.p
     1335       (input this-procedure :file-name
     1336       ,input ''
     1337       ,input ?
     1338       ) no-error.
     1339     if error-status :error then do:
     1340       message
     1341         "Ошибка при вызове помощи"
     1342         error-status :get-message(1)
     1343         view-as alert-box .
     1344     end.
     1345   end.
     1346   run minbtn-set in this-procedure .
     1347   on choose of b-help in frame Dialog-Frame
     1348   do:
     1349     apply "help":u to frame Dialog-Frame .
     1350   end.
     1351   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352   procedure minbtn-set :
     1353       do
     1354           on error undo, return error return-value
     1355           :
     1356           define variable ii              as integer       no-undo .
     1357           define variable fh              as widget-handle no-undo .
     1358           define variable hh              as widget-handle no-undo .
     1359           define variable v-h             as handle        extent 4 no-undo .
     1360           define variable v-name-button   as character     no-undo .
     1361           define variable v-help-old-x    as decimal       no-undo .
     1362           define variable v-help-old-y    as decimal       no-undo .
     1363           define variable v-help-old-size as decimal       no-undo .
     1364           define variable v-frame-width   as decimal       no-undo .
     1365           define variable jj              as integer       no-undo .
     1366           do
     1367               on error undo, return error
     1368               :
     1369               assign
     1370                   v-frame-width = frame Dialog-Frame:width - 0.3
     1371                   fh            = frame Dialog-Frame:first-child
     1372                   hh            = fh:first-child
     1373                   ii            = 1
     1374                   .
     1375               do while valid-handle(hh):
     1376                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1377                   do:
     1378                       case lc(hh:name) :
     1379                           when "b-help" then
     1380                               do:
     1381                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1382                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1383                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1384                                   hh:TOOLTIP = "Помощь" .
     1385                                   v-help-old-x = hh:column .
     1386                                   v-help-old-y = hh:row    .
     1387                                   v-help-old-size = hh:width .
     1388                                   hh:width-chars = 2.5 .
     1389                               end.
     1390                           when "b-print" then
     1391                               do:
     1392                                   hh:load-image("cmp/b-print.bmp":u) .
     1393                                   hh:TOOLTIP = "Печать" .
     1394                                   v-h[ii] = hh:handle .
     1395                                   ii = ii + 1 .
     1396                                   hh:width-chars = 3 .
     1397                               end.
     1398                           when "b-history" or
     1399                           when "b-hist" then
     1400                               do:
     1401                                   hh:load-image("cmp/b-hist.bmp":u) .
     1402                                   hh:TOOLTIP = "История" .
     1403                                   v-h[ii] = hh:handle .
     1404                                   ii = ii + 1 .
     1405                                   hh:width-chars = 3 .
     1406                               end.
     1407                           when "b-sch" then
     1408                               do:
     1409                                   hh:load-image("cmp/b-sch.bmp":u) .
     1410                                   hh:TOOLTIP = "Установка Фильтра" .
     1411                                   v-h[ii] = hh:handle .
     1412                                   ii = ii + 1 .
     1413                                   hh:width-chars = 3 .
     1414                               end.
     1415                           when "b-hist-user" then
     1416                               do:
     1417                                   hh:load-image("cmp/b-hist.bmp":u) .
     1418                                   hh:TOOLTIP = "История пользователя" .
     1419                                   ii = ii + 1 .
     1420                               end.
     1421                       end case.
     1422                   end.
     1423                   hh = hh:next-sibling.
     1424               end.
     1425               b-help:column = v-frame-width - b-help:width-chars.
     1426               jj = 0.
     1427               repeat ii = 4 to 1 by -1 :
     1428                   if valid-handle (v-h[ii] ) then
     1429                   do:
     1430                       jj  = jj + 1 .
     1431                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1432                       v-h[ii]:row    = v-help-old-y .
     1433                   end.
     1434               end.
     1435           end.
     1436       end.
     1437   end procedure.
     1438   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1439   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1440   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1441   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1442   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1443   define variable v-diasize-current-frame-height as decimal   no-undo .
     1444   define variable v-diasize-change-size          as logical   no-undo .
     1445   define variable v-diasize-resize-button        as handle    no-undo .
     1446   define variable v-diasize-wndmax               as logical   no-undo .
     1447   define variable v-diasize-wndstore             as logical   no-undo .
     1448   define variable v-diasize-proc-name            as character no-undo .
     1449   define variable v-diasize-browse-handle        as handle    no-undo .
     1450   define variable v-diasize-browse-number        as integer   no-undo .
     1451   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1452   define temp-table temp-diasize-handle no-undo
     1453     field handle-value  as handle
     1454     field save-position as decimal
     1455     index xpk is primary unique handle-value
     1456     .
     1457   define temp-table temp-browse-handle no-undo
     1458     field browse-type   as character
     1459     field browse-number as integer
     1460     field browse-handle as handle
     1461     field original-size as decimal
     1462     index xpk is primary unique browse-type browse-number
     1463     index xie browse-type browse-handle
     1464   .
     1465   procedure diasize_change-height :
     1466     define input  parameter p-change-value  as decimal   no-undo .
     1467     define input  parameter p-move-resize   as logical   no-undo .
     1468     define variable v-field-group-handle    as handle    no-undo .
     1469     define variable v-object-handle         as handle    no-undo .
     1470     define variable v-frame-height          as decimal   no-undo .
     1471     define variable v-frame-virtual-height  as decimal   no-undo .
     1472     define variable v-browse-height         as decimal   no-undo .
     1473     define variable v-window-height         as decimal   no-undo .
     1474     define variable v-window-virtual-height as decimal   no-undo .
     1475     define variable v-change-sign           as integer   no-undo .
     1476     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1477     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1478     if p-change-value > 0
     1479     then do:
     1480       if frame Dialog-Frame :height + p-change-value
     1481           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1482       then do:
     1483         assign
     1484           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1485                           - (frame Dialog-Frame :height-chars)
     1486         .
     1487         if p-change-value <= 0
     1488         then do:
     1489           run diasize_position-resize-button in this-procedure .
     1490           return .
     1491         end.
     1492       end.
     1493     end.
     1494     if p-change-value < 0
     1495     then do:
     1496       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1497       then do:
     1498         assign
     1499           p-change-value = v-diasize-orig-frame-height
     1500                          - (frame Dialog-Frame :height-chars)
     1501         .
     1502         if p-change-value >= 0
     1503         then do:
     1504           run diasize_position-resize-button in this-procedure .
     1505           return .
     1506         end.
     1507       end.
     1508     end.
     1509     if p-change-value >= 0
     1510     then do:
     1511       assign
     1512         v-change-sign = 1
     1513       .
     1514     end.
     1515     else do:
     1516       assign
     1517         v-change-sign = -1
     1518       .
     1519     end.
     1520     assign
     1521       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1522     .
     1523     if p-change-value = 0
     1524     then do:
     1525       run diasize_position-resize-button in this-procedure .
     1526       return .
     1527     end.
     1528     move_block:
     1529     do
     1530     on error undo move_block, retry move_block
     1531     :
     1532       if retry
     1533       then do:
     1534         do
     1535         on error undo move_block, leave move_block
     1536         :
     1537           if p-change-value > 0
     1538           then do:
     1539             for each buf_temp-diasize-handle
     1540             on error undo, next
     1541             :
     1542               assign
     1543                 v-object-handle = buf_temp-diasize-handle.handle-value
     1544               .
     1545               if v-object-handle <> v-diasize-resize-button
     1546               then do:
     1547                 assign
     1548                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1549                 .
     1550               end.
     1551             end.
     1552             assign
     1553               v-diasize-browse-handle :height = v-browse-height
     1554             .
     1555             for each buf_temp-browse-handle
     1556               where buf_temp-browse-handle.browse-type = 'height':u
     1557             on error undo, next
     1558             :
     1559               assign
     1560                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1561               .
     1562             end.
     1563             assign
     1564               frame Dialog-Frame :height = v-frame-height
     1565             .
     1566             if frame Dialog-Frame :scrollable = true
     1567             then do:
     1568               assign
     1569                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1570               .
     1571             end.
     1572             run diasize_position-resize-button in this-procedure .
     1573           end.
     1574           else do:
     1575             if frame Dialog-Frame :scrollable = true
     1576             then do:
     1577               assign
     1578                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1579               .
     1580             end.
     1581             assign
     1582               frame Dialog-Frame :height = v-frame-height
     1583             .
     1584             assign
     1585               v-diasize-browse-handle :height = v-browse-height
     1586             .
     1587             for each buf_temp-browse-handle
     1588               where buf_temp-browse-handle.browse-type = 'height':u
     1589             on error undo, next
     1590             :
     1591               assign
     1592                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1593               .
     1594             end.
     1595             for each buf_temp-diasize-handle
     1596             on error undo, next
     1597             :
     1598               assign
     1599                 v-object-handle = buf_temp-diasize-handle.handle-value
     1600               .
     1601               if v-object-handle <> v-diasize-resize-button
     1602               then do:
     1603                 assign
     1604                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1605                 .
     1606               end.
     1607             end.
     1608             run diasize_position-resize-button in this-procedure .
     1609           end.
     1610           assign
     1611             v-diasize-change-size = false
     1612           .
     1613           leave move_block .
     1614         end.
     1615       end.
     1616       assign
     1617         v-diasize-need-full-display = true
     1618       .
     1619       if v-diasize-change-size = false
     1620       then do:
     1621         assign
     1622           v-diasize-change-size = true
     1623         .
     1624       end.
     1625       else do:
     1626         return .
     1627       end.
     1628       assign
     1629         v-frame-height = frame Dialog-Frame :height
     1630         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1631         v-browse-height = v-diasize-browse-handle :height
     1632       .
     1633       for each buf_temp-browse-handle
     1634         where buf_temp-browse-handle.browse-type = 'height':u
     1635       :
     1636         assign
     1637           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1638         .
     1639       end.
     1640       for each buf_temp-diasize-handle
     1641       :
     1642         delete buf_temp-diasize-handle .
     1643       end.
     1644       assign
     1645         v-field-group-handle = frame Dialog-Frame :first-child
     1646       .
     1647       do while valid-handle(v-field-group-handle)
     1648       :
     1649         assign
     1650           v-object-handle = v-field-group-handle :first-child
     1651         .
     1652         do while valid-handle(v-object-handle)
     1653         :
     1654           if  v-object-handle <> v-diasize-browse-handle :handle
     1655           and can-query(v-object-handle, "row")
     1656           and can-query(v-object-handle, "height")
     1657           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1658           then do:
     1659             find first buf_temp-browse-handle
     1660               where buf_temp-browse-handle.browse-type   = 'height':u
     1661                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1662               no-error .
     1663             if available buf_temp-browse-handle
     1664             then do:
     1665             end.
     1666             else do:
     1667               create buf_temp-diasize-handle .
     1668               assign
     1669                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1670                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1671               .
     1672             end.
     1673           end.
     1674           assign
     1675             v-object-handle = v-object-handle :next-sibling
     1676           .
     1677         end.
     1678         assign
     1679           v-field-group-handle = v-field-group-handle :next-sibling
     1680         .
     1681       end.
     1682       do with frame Dialog-Frame
     1683       :
     1684         hide v-diasize-resize-button .
     1685         assign
     1686           v-diasize-resize-button :row    = 1
     1687           v-diasize-resize-button :column = 1
     1688         .
     1689       end.
     1690       if p-change-value > 0
     1691       then do:
     1692         if frame Dialog-Frame :scrollable = true
     1693         then do:
     1694           assign
     1695             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1696             no-error .
     1697           if error-status :error
     1698           or error-status :get-message(1) <> ""
     1699           then do:
     1700             undo move_block, retry move_block .
     1701           end.
     1702         end.
     1703         assign
     1704           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1705           no-error .
     1706         if error-status :error
     1707         or error-status :get-message(1) <> ""
     1708         then do:
     1709           undo move_block, retry move_block .
     1710         end.
     1711         assign
     1712           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1713           no-error .
     1714         if error-status :error
     1715         or error-status :get-message(1) <> ""
     1716         then do:
     1717           undo move_block, retry move_block .
     1718         end.
     1719         for each buf_temp-browse-handle
     1720           where buf_temp-browse-handle.browse-type = 'height':u
     1721         on error undo move_block, retry move_block
     1722         :
     1723           assign
     1724             buf_temp-browse-handle.browse-handle :height
     1725               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1726             no-error .
     1727           if error-status :error
     1728           or error-status :get-message(1) <> ""
     1729           then do:
     1730             undo move_block, retry move_block .
     1731           end.
     1732         end.
     1733         for each buf_temp-diasize-handle
     1734         on error undo move_block, retry move_block
     1735         :
     1736           assign
     1737             v-object-handle = buf_temp-diasize-handle.handle-value
     1738           .
     1739           if v-object-handle <> v-diasize-resize-button
     1740           then do:
     1741             assign
     1742               v-object-handle :row = v-object-handle :row + p-change-value
     1743               no-error .
     1744             if error-status :error
     1745             or error-status :get-message(1) <> ""
     1746             then do:
     1747               undo move_block, retry move_block .
     1748             end.
     1749           end.
     1750         end.
     1751       end.
     1752       else do:
     1753         for each buf_temp-diasize-handle
     1754         on error undo move_block, retry move_block
     1755         :
     1756           assign
     1757             v-object-handle = buf_temp-diasize-handle.handle-value
     1758           .
     1759           if v-object-handle <> v-diasize-resize-button
     1760           then do:
     1761             assign
     1762               v-object-handle :row = v-object-handle :row + p-change-value
     1763               no-error .
     1764             if error-status :error
     1765             or error-status :get-message(1) <> ""
     1766             then do:
     1767               undo move_block, retry move_block .
     1768             end.
     1769           end.
     1770         end.
     1771         assign
     1772           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1773           no-error .
     1774         if error-status :error
     1775         or error-status :get-message(1) <> ""
     1776         then do:
     1777           undo move_block, retry move_block .
     1778         end.
     1779         for each buf_temp-browse-handle
     1780           where buf_temp-browse-handle.browse-type = 'height':u
     1781         on error undo move_block, retry move_block
     1782         :
     1783           assign
     1784             buf_temp-browse-handle.browse-handle :height
     1785               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1786             no-error .
     1787           if error-status :error
     1788           or error-status :get-message(1) <> ""
     1789           then do:
     1790             undo move_block, retry move_block .
     1791           end.
     1792         end.
     1793         assign
     1794           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1795           no-error .
     1796         if error-status :error
     1797         or error-status :get-message(1) <> ""
     1798         then do:
     1799           undo move_block, retry move_block .
     1800         end.
     1801         if frame Dialog-Frame :scrollable = true
     1802         then do:
     1803           assign
     1804             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1805             no-error .
     1806           if error-status :error
     1807           or error-status :get-message(1) <> ""
     1808           then do:
     1809             undo move_block, retry move_block .
     1810           end.
     1811         end.
     1812       end.
     1813       if p-move-resize = true
     1814       then do:
     1815         run diasize_position-resize-button in this-procedure .
     1816       end.
     1817       if v-diasize-wndstore = true
     1818       then do:
     1819         if connected("ub") = true
     1820         then do:
     1821           define variable v-cntxt-db-num        as integer   no-undo .
     1822           define variable v-cntxt-userid        as character no-undo .
     1823           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1824                                             , OUTPUT v-cntxt-userid
     1825                                             ) .
     1826           run gbl/wndsizew.p
     1827             (input  v-cntxt-db-num
     1828             ,input  v-cntxt-userid
     1829             ,input  v-diasize-proc-name
     1830             ,input  'height':u
     1831             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1832             ) .
     1833         end.
     1834       end.
     1835     end.
     1836     assign
     1837       v-diasize-change-size = false
     1838     .
     1839   end procedure.
     1840   procedure diasize_set-height :
     1841     define input  parameter p-new-height  as decimal   no-undo .
     1842     define input  parameter p-move-resize as logical   no-undo .
     1843     do
     1844     on error undo, return error return-value
     1845     :
     1846       run diasize_change-height in this-procedure
     1847         (input  (p-new-height - frame Dialog-Frame :height)
     1848         ,input  p-move-resize
     1849         ) .
     1850     end.
     1851   end procedure.
     1852   procedure diasize_change-width :
     1853     define input  parameter p-change-value as decimal   no-undo .
     1854     define input  parameter p-move-resize  as logical   no-undo .
     1855     define variable v-field-group-handle   as handle    no-undo .
     1856     define variable v-object-handle        as handle    no-undo .
     1857     define variable v-frame-width          as decimal   no-undo .
     1858     define variable v-frame-virtual-width  as decimal   no-undo .
     1859     define variable v-browse-width         as decimal   no-undo .
     1860     define variable v-window-width         as decimal   no-undo .
     1861     define variable v-window-virtual-width as decimal   no-undo .
     1862     define variable v-change-sign          as integer   no-undo .
     1863     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1864     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1865     if p-change-value > 0
     1866     then do:
     1867       if frame Dialog-Frame :width + p-change-value >
     1868           session :width-chars
     1869       then do:
     1870         assign
     1871           p-change-value = session :width-chars - frame Dialog-Frame :width
     1872         .
     1873         if p-change-value <= 0
     1874         then do:
     1875           run diasize_position-resize-button in this-procedure .
     1876           return .
     1877         end.
     1878       end.
     1879     end.
     1880     if p-change-value < 0
     1881     then do:
     1882       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1883       then do:
     1884         assign
     1885           p-change-value = v-diasize-orig-frame-width
     1886                          - frame Dialog-Frame :width
     1887         .
     1888         if p-change-value >= 0
     1889         then do:
     1890           run diasize_position-resize-button in this-procedure .
     1891           return .
     1892         end.
     1893       end.
     1894     end.
     1895     if p-change-value >= 0
     1896     then do:
     1897       assign
     1898         v-change-sign = 1
     1899       .
     1900     end.
     1901     else do:
     1902       assign
     1903         v-change-sign = -1
     1904       .
     1905     end.
     1906     assign
     1907       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1908     .
     1909     if p-change-value = 0
     1910     then do:
     1911       run diasize_position-resize-button in this-procedure .
     1912       return .
     1913     end.
     1914     move_block:
     1915     do
     1916     on error undo move_block, leave move_block
     1917     :
     1918       if retry
     1919       then do:
     1920         do
     1921         on error undo move_block, leave move_block
     1922         :
     1923           if p-change-value > 0
     1924           then do:
     1925             for each buf_temp-diasize-handle
     1926             on error undo, next
     1927             :
     1928               assign
     1929                 v-object-handle = buf_temp-diasize-handle.handle-value
     1930               .
     1931               if v-object-handle <> v-diasize-resize-button
     1932               then do:
     1933                 assign
     1934                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1935                 .
     1936               end.
     1937             end.
     1938             assign
     1939               v-diasize-browse-handle :width = v-browse-width
     1940             .
     1941             for each buf_temp-browse-handle
     1942               where buf_temp-browse-handle.browse-type = 'width':u
     1943             on error undo, next
     1944             :
     1945               assign
     1946                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1947               .
     1948             end.
     1949             assign
     1950               frame Dialog-Frame :width = v-frame-width
     1951             .
     1952             if frame Dialog-Frame :scrollable = true
     1953             then do:
     1954               assign
     1955                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1956               .
     1957             end.
     1958             run diasize_position-resize-button in this-procedure .
     1959           end.
     1960           else do:
     1961             if frame Dialog-Frame :scrollable = true
     1962             then do:
     1963               assign
     1964                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1965               .
     1966             end.
     1967             assign
     1968               frame Dialog-Frame :width = v-frame-width
     1969             .
     1970             for each buf_temp-browse-handle
     1971               where buf_temp-browse-handle.browse-type = 'width':u
     1972             on error undo, next
     1973             :
     1974               assign
     1975                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1976               .
     1977             end.
     1978             assign
     1979               v-diasize-browse-handle :width = v-browse-width
     1980             .
     1981             for each buf_temp-diasize-handle
     1982             on error undo, next
     1983             :
     1984               assign
     1985                 v-object-handle = buf_temp-diasize-handle.handle-value
     1986               .
     1987               if v-object-handle <> v-diasize-resize-button
     1988               then do:
     1989                 assign
     1990                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1991                 .
     1992               end.
     1993             end.
     1994             run diasize_position-resize-button in this-procedure .
     1995           end.
     1996           assign
     1997             v-diasize-change-size = false
     1998           .
     1999           leave move_block .
     2000         end.
     2001       end.
     2002       assign
     2003         v-diasize-need-full-display = true
     2004       .
     2005       if v-diasize-change-size = false
     2006       then do:
     2007         assign
     2008           v-diasize-change-size = true
     2009         .
     2010       end.
     2011       else do:
     2012         return .
     2013       end.
     2014       assign
     2015         v-frame-width = frame Dialog-Frame :width
     2016         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2017         v-browse-width = v-diasize-browse-handle :width
     2018       .
     2019       for each buf_temp-browse-handle
     2020         where buf_temp-browse-handle.browse-type = 'width':u
     2021       :
     2022         assign
     2023           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2024         .
     2025       end.
     2026       for each buf_temp-diasize-handle
     2027       :
     2028         delete buf_temp-diasize-handle .
     2029       end.
     2030       assign
     2031         v-field-group-handle = frame Dialog-Frame :first-child
     2032       .
     2033       do while valid-handle(v-field-group-handle)
     2034       :
     2035         assign
     2036           v-object-handle = v-field-group-handle :first-child
     2037         .
     2038         do while valid-handle(v-object-handle)
     2039         :
     2040           if  v-object-handle <> v-diasize-browse-handle :handle
     2041           and v-object-handle <> v-diasize-resize-button
     2042           and can-query(v-object-handle, "row")
     2043           and can-query(v-object-handle, "height")
     2044           and ( v-object-handle :col + v-object-handle :width
     2045                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2046               )
     2047           then do:
     2048             find first buf_temp-browse-handle
     2049               where buf_temp-browse-handle.browse-type   = 'width':u
     2050                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2051               no-error .
     2052             if available buf_temp-browse-handle
     2053             then do:
     2054             end.
     2055             else do:
     2056               create buf_temp-diasize-handle .
     2057               assign
     2058                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2059                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2060               .
     2061             end.
     2062           end.
     2063           assign
     2064             v-object-handle = v-object-handle :next-sibling
     2065           .
     2066         end.
     2067         assign
     2068           v-field-group-handle = v-field-group-handle :next-sibling
     2069         .
     2070       end.
     2071       do with frame Dialog-Frame
     2072       :
     2073         hide v-diasize-resize-button .
     2074         v-diasize-resize-button :row = 1.
     2075         v-diasize-resize-button :column = 1.
     2076       end.
     2077       if p-change-value > 0
     2078       then do:
     2079         if frame Dialog-Frame :scrollable = true
     2080         then do:
     2081           assign
     2082             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2083             no-error .
     2084           if error-status :error
     2085           or error-status :get-message(1) <> ""
     2086           then do:
     2087             undo move_block, retry move_block.
     2088           end.
     2089         end.
     2090         assign
     2091           frame Dialog-Frame :width = v-frame-width + p-change-value
     2092           no-error .
     2093         if error-status :error
     2094         or error-status :get-message(1) <> ""
     2095         then do:
     2096           undo move_block, retry move_block.
     2097         end.
     2098         assign
     2099           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2100         no-error .
     2101         if error-status :error
     2102         or error-status :get-message(1) <> ""
     2103         then do:
     2104           undo move_block, retry move_block.
     2105         end.
     2106         for each buf_temp-browse-handle
     2107           where buf_temp-browse-handle.browse-type = 'width':u
     2108         on error undo move_block, retry move_block
     2109         :
     2110           assign
     2111             buf_temp-browse-handle.browse-handle :width
     2112               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2113             no-error .
     2114           if error-status :error
     2115           or error-status :get-message(1) <> ""
     2116           then do:
     2117             undo move_block, retry move_block .
     2118           end.
     2119         end.
     2120         for each buf_temp-diasize-handle
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             v-object-handle = buf_temp-diasize-handle.handle-value
     2125           .
     2126           if v-object-handle <> v-diasize-resize-button
     2127           then do:
     2128             assign
     2129               v-object-handle :col = v-object-handle :col + p-change-value
     2130               no-error .
     2131             if error-status :error
     2132             or error-status :get-message(1) <> ""
     2133             then do:
     2134               undo move_block, retry move_block .
     2135             end.
     2136           end.
     2137         end.
     2138       end.
     2139       else do:
     2140         for each buf_temp-diasize-handle
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             v-object-handle = buf_temp-diasize-handle.handle-value
     2145           .
     2146           if v-object-handle <> v-diasize-resize-button
     2147           then do:
     2148             assign
     2149               v-object-handle :col = v-object-handle :col + p-change-value
     2150               no-error .
     2151             if error-status :error
     2152             or error-status :get-message(1) <> ""
     2153             then do:
     2154               undo move_block, retry move_block .
     2155             end.
     2156           end.
     2157         end.
     2158         for each buf_temp-browse-handle
     2159           where buf_temp-browse-handle.browse-type = 'width':u
     2160         on error undo move_block, retry move_block
     2161         :
     2162           assign
     2163             buf_temp-browse-handle.browse-handle :width
     2164               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2165             no-error .
     2166           if error-status :error
     2167           or error-status :get-message(1) <> ""
     2168           then do:
     2169             undo move_block, retry move_block .
     2170           end.
     2171         end.
     2172         assign
     2173           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2174           no-error .
     2175         if error-status :error
     2176         or error-status :get-message(1) <> ""
     2177         then do:
     2178           undo move_block, retry move_block.
     2179         end.
     2180         assign
     2181           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2182         no-error .
     2183         if error-status :error
     2184         or error-status :get-message(1) <> ""
     2185         then do:
     2186           undo move_block, retry move_block.
     2187         end.
     2188         if frame Dialog-Frame :scrollable = true
     2189         then do:
     2190           assign
     2191             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2192           no-error .
     2193           if error-status :error
     2194           or error-status :get-message(1) <> ""
     2195           then do:
     2196             undo move_block, retry move_block.
     2197           end.
     2198         end.
     2199       end.
     2200       if p-move-resize
     2201       then do:
     2202         run diasize_position-resize-button in this-procedure .
     2203       end.
     2204       if v-diasize-wndstore = true
     2205       then do:
     2206         if connected("ub") = true
     2207         then do:
     2208           define variable v-cntxt-db-num        as integer   no-undo .
     2209           define variable v-cntxt-userid        as character no-undo .
     2210           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2211                                             , OUTPUT v-cntxt-userid
     2212                                             ) .
     2213           run gbl/wndsizew.p
     2214             (input  v-cntxt-db-num
     2215             ,input  v-cntxt-userid
     2216             ,input  v-diasize-proc-name
     2217             ,input  'width':u
     2218             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2219             ) .
     2220         end.
     2221       end.
     2222     end.
     2223     assign
     2224       v-diasize-change-size = false
     2225     .
     2226   end procedure.
     2227   procedure diasize_set-width :
     2228     define input  parameter p-new-width  as decimal   no-undo .
     2229     define input  parameter p-move-resize as logical   no-undo .
     2230     do
     2231     on error undo, return error return-value
     2232     :
     2233       run diasize_change-width in this-procedure
     2234         (input  (p-new-width - frame Dialog-Frame :width)
     2235         ,input  p-move-resize
     2236         ) .
     2237     end.
     2238   end procedure.
     2239   procedure diasize_position-resize-button :
     2240     do with frame Dialog-Frame
     2241     :
     2242       hide v-diasize-resize-button .
     2243       assign
     2244         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2245                     - 1
     2246                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2247         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2248                     - 1
     2249                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2250       .
     2251       view v-diasize-resize-button .
     2252     end.
     2253   end procedure.
     2254   on alt-right anywhere
     2255   do:
     2256     run diasize_change-width in this-procedure
     2257       (input 1
     2258       ,input true
     2259       ) .
     2260     return no-apply .
     2261   end.
     2262   on alt-left anywhere
     2263   do:
     2264     run diasize_change-width in this-procedure
     2265       (input -1
     2266       ,input true
     2267       ) .
     2268     return no-apply .
     2269   end.
     2270   on alt-down anywhere
     2271   do:
     2272     run diasize_change-height in this-procedure
     2273       (input 1
     2274       ,input true
     2275       ) .
     2276     return no-apply .
     2277   end.
     2278   on alt-up anywhere
     2279   do:
     2280     run diasize_change-height in this-procedure
     2281       (input -1
     2282       ,input true
     2283       ) .
     2284     return no-apply .
     2285   end.
     2286   on alt-enter of frame Dialog-Frame
     2287   do:
     2288     run diasize_maximize in this-procedure
     2289       (input  ?
     2290       ).
     2291     return no-apply .
     2292   end.
     2293   procedure diasize_end-move :
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       define variable v-row-delta as decimal   no-undo .
     2298       define variable v-col-delta as decimal   no-undo .
     2299       define variable v-new-row as decimal   no-undo .
     2300       define variable v-new-col as decimal   no-undo .
     2301       assign
     2302         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2303         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2304       .
     2305       assign
     2306         v-row-delta = v-new-row - frame Dialog-Frame :height
     2307         v-col-delta = v-new-col - frame Dialog-Frame :width
     2308       .
     2309       run diasize_change-height in this-procedure
     2310         (input v-row-delta
     2311         ,input true
     2312         ) .
     2313       run diasize_change-width in this-procedure
     2314         (input v-col-delta
     2315         ,input true
     2316         ) .
     2317     end.
     2318   end procedure.
     2319   procedure diasize_maximize :
     2320     define input  parameter p-action as logical   no-undo .
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       if p-action = ?
     2325       then do:
     2326         if v-diasize-need-maximize = true
     2327         then do:
     2328           assign
     2329             p-action = true
     2330           .
     2331         end.
     2332         else do:
     2333           assign
     2334             p-action = false
     2335           .
     2336         end.
     2337       end.
     2338       if p-action = true
     2339       then do:
     2340         run diasize_change-height in this-procedure
     2341           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2342               - frame Dialog-Frame :height-chars
     2343           ,input true
     2344           ) .
     2345         run diasize_change-width in this-procedure
     2346           (input session :width-chars
     2347               - frame Dialog-Frame :width-chars
     2348           ,input true
     2349           ) .
     2350         assign
     2351           v-diasize-need-maximize = false
     2352         .
     2353       end.
     2354       else do:
     2355         run diasize_change-width in this-procedure
     2356           (input v-diasize-orig-frame-width
     2357               - frame Dialog-Frame :width-chars
     2358           ,input true
     2359           ) .
     2360         run diasize_change-height in this-procedure
     2361           (input v-diasize-orig-frame-height
     2362               - frame Dialog-Frame :height-chars
     2363           ,input true
     2364           ) .
     2365         assign
     2366           v-diasize-need-maximize = true
     2367         .
     2368       end.
     2369     end.
     2370   end procedure.
     2371   procedure diasize_restore-orig-size :
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       assign
     2376         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2377         v-diasize-current-frame-height = frame Dialog-Frame :height
     2378       .
     2379       run diasize_set-height in this-procedure
     2380         (input  v-diasize-orig-frame-height
     2381         ,input  true
     2382         ) .
     2383       run diasize_set-width in this-procedure
     2384         (input  v-diasize-orig-frame-width
     2385         ,input  true
     2386         ) .
     2387     end.
     2388   end procedure.
     2389   procedure diasize_restore-current-size :
     2390     do
     2391     on error undo, return error return-value
     2392     :
     2393       run diasize_set-height in this-procedure
     2394         (input  v-diasize-current-frame-height
     2395         ,input  true
     2396         ) .
     2397       run diasize_set-width in this-procedure
     2398         (input  v-diasize-current-frame-width
     2399         ,input  true
     2400         ) .
     2401     end.
     2402   end procedure.
     2403   procedure diasize_set-browse-handle :
     2404     define input  parameter p-browse-handle as handle   no-undo .
     2405     define buffer buf_temp-browse-handle for temp-browse-handle .
     2406     do
     2407     on error undo, return error return-value
     2408     :
     2409       assign
     2410         v-diasize-browse-handle = p-browse-handle
     2411       .
     2412       for each buf_temp-browse-handle
     2413       on error undo, return error return-value
     2414       :
     2415         delete buf_temp-browse-handle .
     2416       end.
     2417     end.
     2418   end procedure.
     2419   procedure diasize_add_browse :
     2420     define input  parameter p-browse-type   as character no-undo .
     2421     define input  parameter p-browse-handle as handle    no-undo .
     2422     define buffer buf_temp-browse-handle for temp-browse-handle .
     2423     do
     2424     on error undo, return error return-value
     2425     :
     2426       assign
     2427         v-diasize-browse-number = v-diasize-browse-number + 1
     2428       .
     2429       create buf_temp-browse-handle .
     2430       assign
     2431         buf_temp-browse-handle.browse-type   = p-browse-type
     2432         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2433         buf_temp-browse-handle.browse-handle = p-browse-handle
     2434       .
     2435     end.
     2436   end procedure.
     2437   procedure diasize_init :
     2438     define variable v-default-value    as logical   no-undo .
     2439     define variable v-restore-saved    as logical   no-undo .
     2440     define variable v-resize-value-str as character no-undo .
     2441     do
     2442     on error undo, return error return-value
     2443     :
     2444       do with frame Dialog-Frame
     2445       :
     2446         assign
     2447           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2448           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2449           v-diasize-browse-handle     = browse BR-lines :handle
     2450         .
     2451         create button v-diasize-resize-button
     2452         assign
     2453           parent        = frame Dialog-Frame :first-child
     2454           label         = "s"
     2455           height-pixels = 16
     2456           width-pixels  = 16
     2457           visible       = true
     2458           sensitive     = true
     2459           movable       = true
     2460           triggers:
     2461             on end-move persistent run diasize_end-move in this-procedure .
     2462           end triggers.
     2463         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2464         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2465         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2466         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2467         assign
     2468           v-diasize-wndmax = false
     2469         .
     2470         if connected("ub") = true
     2471         then do:
     2472           define variable v-cntxt-db-num        as integer   no-undo .
     2473           define variable v-cntxt-userid        as character no-undo .
     2474           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2475                                             , OUTPUT v-cntxt-userid
     2476                                             ) .
     2477           run gbl/wndpar_r.p
     2478             (input  v-cntxt-db-num
     2479             ,input  v-cntxt-userid
     2480             ,input  'wndmax':U
     2481             ,output v-diasize-wndmax
     2482             ,output v-default-value
     2483             ) .
     2484         end.
     2485         assign
     2486           v-diasize-wndstore = false
     2487         .
     2488         if connected("ub") = true
     2489         then do:
     2490           run gbl/wndpar_r.p
     2491             (input  v-cntxt-db-num
     2492             ,input  v-cntxt-userid
     2493             ,input  'wndstore':U
     2494             ,output v-diasize-wndstore
     2495             ,output v-default-value
     2496             ) .
     2497         end.
     2498         assign
     2499           v-diasize-proc-name = entry(1, program-name(2), '.')
     2500         .
     2501         if v-diasize-wndstore = true
     2502         then do:
     2503           assign
     2504             v-restore-saved = false
     2505           .
     2506           if connected("ub") = true
     2507           then do:
     2508             run gbl/wndsizer.p
     2509               (input  v-cntxt-db-num
     2510               ,input  v-cntxt-userid
     2511               ,input  v-diasize-proc-name
     2512               ,input  'height':u
     2513               ,output v-resize-value-str
     2514               ) .
     2515             if v-resize-value-str <> '':U
     2516             then do:
     2517               run diasize_change-height in this-procedure
     2518                 (input  integer(v-resize-value-str)
     2519                 ,input  true
     2520                 ) .
     2521               assign
     2522                 v-restore-saved = true
     2523               .
     2524             end.
     2525           end.
     2526           if connected("ub") = true
     2527           then do:
     2528             run gbl/wndsizer.p
     2529               (input  v-cntxt-db-num
     2530               ,input  v-cntxt-userid
     2531               ,input  v-diasize-proc-name
     2532               ,input  'width':u
     2533               ,output v-resize-value-str
     2534               ) .
     2535             if v-resize-value-str <> '':U
     2536             then do:
     2537               run diasize_change-width in this-procedure
     2538                 (input  integer(v-resize-value-str)
     2539                 ,input  true
     2540                 ) .
     2541               assign
     2542                 v-restore-saved = true
     2543               .
     2544             end.
     2545           end.
     2546           if v-restore-saved <> true
     2547           then do:
     2548             if v-diasize-wndmax = true
     2549             then do:
     2550               run diasize_maximize in this-procedure
     2551                 (input  true
     2552                 ) .
     2553             end.
     2554           end.
     2555         end.
     2556         else do:
     2557           if v-diasize-wndmax = true
     2558           then do:
     2559             run diasize_maximize in this-procedure
     2560               (input  true
     2561               ) .
     2562           end.
     2563         end.
     2564       end.
     2565     end.
     2566   end procedure.
     2567   procedure diasize_need-full-display :
     2568     define output parameter p-need-full-display as logical   no-undo .
     2569     do
     2570     on error undo, return error return-value
     2571     :
     2572       assign
     2573         p-need-full-display = v-diasize-need-full-display
     2574       .
     2575       assign
     2576         v-diasize-need-full-display = false
     2577       .
     2578     end.
     2579   end procedure.
     2580   procedure get-context :
     2581      define output parameter p-db-num as integer          no-undo.
     2582      define output parameter p-user-id as character        no-undo.
     2583      define variable v-login               as character    no-undo.
     2584      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2585      define buffer buf_user-login  for ub.user-login .
     2586      do
     2587      on error undo, return error
     2588      :
     2589            FIND FIRST buf_sys-ctrl no-lock.
     2590            ASSIGN
     2591               v-login = USERID("ub")
     2592               p-db-num = buf_sys-ctrl.db-num
     2593            .
     2594            FIND FIRST buf_user-login
     2595                 WHERE buf_user-login.db-num = p-db-num
     2596                   AND buf_user-login.user-login = v-login
     2597                 no-lock
     2598                 no-error
     2599                 .
     2600            IF AVAILABLE buf_user-login
     2601            THEN DO:
     2602               assign
     2603                  p-user-id = buf_user-login.user-id
     2604               .
     2605            END.
     2606      end.
     2607   end procedure.
     2608       run diasize_init in this-procedure .
     2609   p-next-prev = ''.
     2610   n-p:
     2611   do while p-next-prev = '':U:
     2612   MAIN-BLOCK:
     2613   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2614      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2615   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616     run mainmenu_getcntxt in parparentproc
     2617       (output v-cntxt-db-num
     2618       ,output v-cntxt-userid
     2619       ,output v-cntxt-level
     2620       ,output v-cntxt-host-code-obj
     2621       ,output v-cntxt-obj-type
     2622       ,output v-cntxt-obj-code
     2623       ,output v-cntxt-db-num-obj
     2624       ,output v-cntxt-is-admin
     2625       ) .
     2626     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
     2627         message vss-workfile vss-revision vss-description skip
     2628                     "Неверный параметр вызова par-mode"
     2629         view-as alert-box ERROR.
     2630         return error.
     2631     end.
     2632     assign
     2633     v-first-mode = par-mode
     2634     .
     2635     if par-mode <> 'ПРОСМОТР':U then do:
     2636       p-next-prev = 'quit'.
     2637     end.
     2638     assign
     2639     shop-type =   p-obj-type
     2640     shop-code = p-obj-code
     2641     .
     2642   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2643   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   FUNCTION convert-discount returns integer
     2645                                             ( input p-disc-reason as integer
     2646                                             , input p-disc-type  as integer
     2647                                             , input p-line-type as integer) :
     2648   define variable v-disc-type as integer no-undo .
     2649   if p-line-type = integer('1':U)
     2650   or p-line-type = integer('0':U)
     2651   then do:
     2652     if p-disc-type = 0
     2653     or p-disc-type = 1
     2654     or p-disc-type = 2
     2655     then do:
     2656       if p-disc-reason <> 0 then
     2657       p-disc-type = p-disc-reason
     2658       .
     2659     end.
     2660   end.
     2661   if p-line-type = integer('3':U)
     2662   or p-line-type = integer('2':U) then do:
     2663     if p-disc-type = 101
     2664     or p-disc-type = 102
     2665     then do:
     2666       if p-disc-reason <> 0 then
     2667       p-disc-type = p-disc-reason
     2668       .
     2669     end.
     2670   end.
     2671   if p-disc-reason <> 0 then do:
     2672     CASE p-disc-reason:
     2673       when 0 then do:
     2674         return integer('0':U).
     2675       end.
     2676       when 1 then do:
     2677         return integer('11':U).
     2678       end.
     2679       when 2 then do:
     2680         return integer('1':U).
     2681       end.
     2682       when 3 or when 15 then do:
     2683         return integer('7':U).
     2684       end.
     2685       when 4 then do:
     2686         return integer('4':U).
     2687       end.
     2688       when 5 then do:
     2689         return integer('12':U).
     2690       end.
     2691       when 6 then do:
     2692         return integer('3':U).
     2693       end.
     2694       when 7 then do:
     2695         return integer('13':U).
     2696       end.
     2697       when 8
     2698       or
     2699       when 9
     2700       or
     2701       when 10
     2702       then do:
     2703         return integer('20':U).
     2704       end.
     2705       when 11
     2706       then do:
     2707         return integer('21':U).
     2708       end.
     2709       when 13
     2710       then do:
     2711         return integer('22':U).
     2712       end.
     2713       when 16 then do:
     2714         return integer('23':U).
     2715       end.
     2716     END CASE.
     2717   end.
     2718   CASE p-disc-type:
     2719     when 0 then do:
     2720       return integer('0':U).
     2721     end.
     2722     when 1 then do:
     2723       return integer('13':U).
     2724     end.
     2725     when 2 then do:
     2726       return integer('2':U).
     2727     end.
     2728     when 3 then do:
     2729       return integer('4':U).
     2730     end.
     2731     when 4 then do:
     2732       return integer('12':U).
     2733     end.
     2734     when 5 then do:
     2735       return integer('1':U).
     2736     end.
     2737     when 6 then do:
     2738       return integer('3':U).
     2739     end.
     2740     when 7 then do:
     2741       return integer('14':U).
     2742     end.
     2743     when 8 then do:
     2744       return integer('15':U).
     2745     end.
     2746     when 9 then do:
     2747       return integer('16':U).
     2748     end.
     2749     when 101 then do:
     2750       return integer('13':U).
     2751     end.
     2752     when 102 then do:
     2753       return integer('5':U).
     2754     end.
     2755     when 103 then do:
     2756       return integer('1':U).
     2757     end.
     2758     when 104 then do:
     2759       return integer('5':U).
     2760     end.
     2761     when 105 then do:
     2762       return integer('1':U).
     2763     end.
     2764     when 106 then do:
     2765       return integer('1':U).
     2766     end.
     2767   END CASE.
     2768   END FUNCTION.
     2769   run get-general-parameters in this-procedure .
     2770   procedure get-general-parameters :
     2771   define buffer buf_get-chkc_context for get-chkc_context.
     2772   do
     2773   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2774   :
     2775     for each buf_get-chkc_context:
     2776       delete buf_get-chkc_context.
     2777     end.
     2778     create buf_get-chkc_context.
     2779   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2780   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     2781     (input  shop-type
     2782     ,input  shop-code
     2783     ,input  buffer buf_get-chkc_context:handle
     2784     ) no-error .
     2785     if error-status:error then do:
     2786       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     2787                                      , chr(10)
     2788                                      , error-status:get-message(1)
     2789                                      , return-value ).
     2790     end.
     2791     find first buf_get-chkc_context.
     2792     assign
     2793     buf_get-chkc_context.parparentproc = parparentproc
     2794     buf_get-chkc_context.p-log-handle = p-log-handle
     2795     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     2796     .
     2797     release buf_get-chkc_context.
     2798     find first get-chkc_context.
     2799   end.
     2800   end procedure.
     2801     run get-params in this-procedure ( input shop-type, input shop-code) no-error.
     2802     if error-status:error then return error.
     2803     Run fill-tables in this-procedure no-error.
     2804     if error-status:error then return error.
     2805     RUN MyEnable in this-procedure .
     2806     WAIT-FOR GO OF FRAME Dialog-Frame.
     2807   END.
     2808   end.
     2809   RUN disable_UI in this-procedure .
     2810   PROCEDURE check-dublicate :
     2811   define buffer dub_chk-doc for ub.chk-doc.
     2812         FIND  dub_chk-doc where
     2813               dub_chk-doc.obj-type = tt-chk-doc.obj-type and
     2814               dub_chk-doc.obj-code = tt-chk-doc.obj-code and
     2815               dub_chk-doc.chk-date = tt-chk-doc.chk-date and
     2816               dub_chk-doc.pay-desk = tt-chk-doc.pay-desk and
     2817               dub_chk-doc.chk-time = tt-chk-doc.chk-time and
     2818               dub_chk-doc.chk-num = tt-chk-doc.chk-num and
     2819               dub_chk-doc.sales-man = tt-chk-doc.sales-man NO-ERROR .
     2820   if available dub_chk-doc  and
     2821   recid(dub_chk-doc) <> recid(locked_chk-doc) then do:
     2822       message
     2823       "Уже есть чек" dub_chk-doc.doc-code      "по магазину" tt-chk-doc.obj-code "в котором"
     2824       "дата" tt-chk-doc.chk-date SKIP
     2825       "время" string(tt-chk-doc.chk-time, "HH:MM:SS":U)  SKIP
     2826       "касса" tt-chk-doc.pay-desk SKIP
     2827       "номер чека на кассе" tt-chk-doc.chk-num SKIP
     2828       "продавец" tt-chk-doc.sales-man
     2829       view-as alert-box ERROR.
     2830       return error.
     2831   end.
     2832   END PROCEDURE.
     2833   PROCEDURE check-manual :
     2834   if not can-find(first locked_chk-pay where locked_chk-pay.doc-code = tt-chk-doc.doc-code) then do:
     2835     message
     2836     "В чеке нет строк товаров и/или строк оплат" skip
     2837     "Такой чек не может быть сохранен"
     2838     view-as alert-box error .
     2839     return error.
     2840   end.
     2841   if tt-chk-doc.pay-desk = 0 then do:
     2842     message
     2843     "Нельзя создать чек для кассы с номером 0"
     2844     view-as alert-box error .
     2845     return error .
     2846   end.
     2847   END PROCEDURE.
     2848   PROCEDURE check-this-check :
     2849   define variable v-num as integer no-undo.
     2850   define buffer loc_chk-pay for ub.chk-pay.
     2851   assign
     2852   mc-prev-code = tt-chk-doc.doc-code.
     2853   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     2854       run proc-save-doc in this-procedure ( input yes, input yes) no-error.
     2855       if error-status:error then return error.
     2856       run check-dublicate in this-procedure no-error.
     2857       if error-status:error then return error.
     2858       run check-manual in this-procedure no-error .
     2859       if error-status:error then return error.
     2860   end.
     2861   run proc-save-doc in this-procedure  ( input yes, input yes) no-error.
     2862   if error-status:error then return error.
     2863   assign
     2864   locked_chk-doc.discnt = 0
     2865   locked_chk-doc.correct = yes
     2866   for-chk-type = "":U
     2867   .
     2868   for each loc_chk-pay where
     2869               loc_chk-pay.doc-code = tt-chk-doc.doc-code:
     2870       assign
     2871       loc_chk-pay.obj-code =   tt-chk-doc.obj-code
     2872       loc_chk-pay.line-sign = (if tt-chk-doc.chk-type = integer('2':U)
     2873                                       or tt-chk-doc.chk-type =  integer('5':U
     2874                                      )
     2875                                     then (loc_chk-pay.tot-sum <= 0)
     2876                                     else (loc_chk-pay.tot-sum >= 0)
     2877                                     )
     2878       loc_chk-pay.time-oper = (if par-mode = 'ДОБАВЛЕНИЕ':U
     2879                                             then tt-chk-doc.chk-time
     2880                                             else loc_chk-pay.time-oper)
     2881       .
     2882   End.
     2883   for each loc_chk-pay where
     2884               loc_chk-pay.doc-code = tt-chk-doc.doc-code:
     2885       assign
     2886       loc_chk-pay.obj-code =   tt-chk-doc.obj-code
     2887       loc_chk-pay.line-sign = (if tt-chk-doc.chk-type = integer('2':U)
     2888                                       or tt-chk-doc.chk-type =  integer('5':U
     2889                                      )
     2890                                     then (loc_chk-pay.tot-sum <= 0)
     2891                                     else (loc_chk-pay.tot-sum >= 0)
     2892                                     )
     2893       loc_chk-pay.time-oper = (if par-mode = 'ДОБАВЛЕНИЕ':U
     2894                                             then tt-chk-doc.chk-time
     2895                                             else loc_chk-pay.time-oper)
     2896       .
     2897   End.
     2898   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2899   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getwcheck in g#libchkvl
     2900     (input  buffer get-chkc_context:handle
     2901     ,input  'ИЗМЕНЕНИЕ':U
     2902     ,input  par-mode
     2903     ,input  yes
     2904     ,input  yes
     2905     ,input  ?
     2906     ,input-output mc-prev-code
     2907       ) no-error .
     2908   assign
     2909   p-view-log = (p-view-log or get-chkc_context.view-log)
     2910   .
     2911   if locked_chk-doc.correct = no then do:
     2912     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     2913           run gbl/d-askw.w (
     2914              input "Выход из режима создания чека МЦ"
     2915             ,input "Созданный Вами чек является ошибочным" + chr(10)
     2916               + "Вы действительно хотите сделать это?" + chr(10)
     2917             ,input "|^"
     2918             ,input "Сохранить|Редактировать|Не сохранять"
     2919             ,input "Чек будет сохранен как ошибочный и к нему можно будет вернуться для последующего редактирования|"
     2920                  + "Продолжить редактирование и постараться исправить все ошибки в чеке|"
     2921                  + "Чек не будет сохранен"
     2922             ,input 2
     2923             ,input 3
     2924             ,output v-num
     2925             ).
     2926           CASE v-num:
     2927               when 2 then do:
     2928                   return error.
     2929               end.
     2930                when 3 then do:
     2931                   p-doc-rec = ?.
     2932                   delete locked_chk-doc .
     2933                   return.
     2934                end.
     2935           END CASE.
     2936     end.
     2937     else do:
     2938       run gbl/d-askw.w (
     2939          input "Выход из режима редактирования чека МЦ"
     2940         ,input "Редактируемый Вами чек МЦ является ошибочным" + chr(10)
     2941         ,input "|^"
     2942         ,input "Сохр ошибочный|Редактировать"
     2943         ,input "Чек будет сохранен как ошибочный и к нему можно будет вернуться для последующего редактирования|"
     2944               + "Постараться исправить все ошибки в чеке"
     2945         ,input 1
     2946         ,input 2
     2947         ,output v-num
     2948         ).
     2949         if v-num = 2 then return error.
     2950     end.
     2951   end.
     2952   if par-mode = 'ИЗМЕНЕНИЕ':U then
     2953   run trg/chk-doch.p (
     2954                   buffer locked_chk-doc
     2955                 , input yes
     2956                 , input no
     2957                 , input no
     2958                 , input-output v-chip-num
     2959                 , output v-is-update).
     2960   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     2961     run trg/chk-doch.p (
     2962                     buffer locked_chk-doc
     2963                   , input no
     2964                   , input yes
     2965                   , input no
     2966                   , input-output v-chip-num
     2967                   , output v-is-update).
     2968   end.
     2969   if v-is-update or par-mode = 'ДОБАВЛЕНИЕ':U then do:
     2970     assign
     2971     locked_chk-doc.PS = "!":U + (if index(locked_chk-doc.ps, "shift!") > 0 then "shift!" else '':U) +
     2972                                 (if index(locked_chk-doc.ps, "shift!") > 0
     2973                                 then substring(left-trim(locked_chk-doc.ps, "!"), 7)
     2974                                 else left-trim(locked_chk-doc.PS, "!":U))
     2975     tt-chk-doc.PS = locked_chk-doc.pS
     2976     .
     2977     display
     2978     tt-chk-doc.ps
     2979     with frame Dialog-Frame .
     2980   end.
     2981   END PROCEDURE.
     2982   PROCEDURE check-time :
     2983   define input parameter parscreen-value as integer no-undo.
     2984   define input parameter par-mode as character no-undo.
     2985   define variable var-limit as integer no-undo.
     2986   CASE par-mode:
     2987       when "hour":U then do:
     2988            var-limit = 23.
     2989       end.
     2990       when "min":U then do:
     2991             var-limit = 59.
     2992       end.
     2993       when "sec" then do:
     2994             var-limit = 59.
     2995       end.
     2996   END.
     2997     if int(parscreen-value) > var-limit then do:
     2998       bell.
     2999       Message "Неверное время!" view-as alert-box ERROR.
     3000       return error.
     3001     end.
     3002     run find-curs in this-procedure (
     3003                                       input date(tt-chk-doc.chk-date:screen-value in frame Dialog-Frame)
     3004                                       ,input (integer(fhour:screen-value) * 3600 + integer(fmin:screen-value) * 60) + integer(fsec:screen-value)
     3005                                       ,output varbase-curs) no-error.
     3006    if error-status:error then return error.
     3007   END PROCEDURE.
     3008   PROCEDURE control-line :
     3009   DEFINE OUTPUT PARAMETER locked-title as logical no-undo.
     3010   IF CAN-FIND(FIRST ub.chk-pay No-LOCK WHERE
     3011                     ub.chk-pay.doc-code = tt-chk-doc.doc-code) then
     3012   locked-title = yes.
     3013   else locked-title = no.
     3014   END PROCEDURE.
     3015   PROCEDURE disable_UI :
     3016     HIDE FRAME Dialog-Frame.
     3017   END PROCEDURE.
     3018   PROCEDURE enable_UI :
     3019     OPEN QUERY Dialog-Frame FOR EACH tt-chk-doc SHARE-LOCK.
     3020     GET FIRST Dialog-Frame.
     3021     DISPLAY fhour fmin fsec
     3022         WITH FRAME Dialog-Frame.
     3023     IF AVAILABLE tt-chk-doc THEN
     3024       DISPLAY tt-chk-doc.chk-date tt-chk-doc.obj-code tt-chk-doc.chk-type
     3025             tt-chk-doc.pay-desk tt-chk-doc.src-shift-date tt-chk-doc.shift-date
     3026             tt-chk-doc.cashier tt-chk-doc.shift-name tt-chk-doc.shift-num
     3027             tt-chk-doc.chk-num tt-chk-doc.cash-rate tt-chk-doc.z-number
     3028             tt-chk-doc.PS
     3029         WITH FRAME Dialog-Frame.
     3030     ENABLE B-exit b-quit B-prev B-next B-hist B-Help tt-chk-doc.chk-date
     3031            tt-chk-doc.obj-code tt-chk-doc.chk-type fhour fmin fsec
     3032            tt-chk-doc.pay-desk b-cd tt-chk-doc.src-shift-date
     3033            tt-chk-doc.shift-date tt-chk-doc.cashier tt-chk-doc.shift-name
     3034            tt-chk-doc.shift-num tt-chk-doc.chk-num tt-chk-doc.cash-rate
     3035            tt-chk-doc.z-number B-add B-del BR-lines tt-chk-doc.PS
     3036         WITH FRAME Dialog-Frame.
     3037     VIEW FRAME Dialog-Frame.
     3038     OPEN QUERY BR-lines FOR EACH locked_chk-pay NO-LOCK WHERE        locked_chk-pay.doc-code = tt-chk-doc.doc-code,            FIRST tt-chk-pay WHERE         tt-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-chk-pay.line-num = locked_chk-pay.line-num.
     3039   END PROCEDURE.
     3040   PROCEDURE fill-tables :
     3041   define variable v-first-cashier as integer no-undo .
     3042   define variable v-first-seller as integer no-undo .
     3043   DEFINE VARIABLE v-today as date no-undo .
     3044   DEFINE VARIABLE v-time as integer no-undo .
     3045   for each tt-chk-doc:
     3046       delete tt-chk-doc.
     3047   end.
     3048   for each tt-chk-pay:
     3049       delete tt-chk-pay.
     3050   end.
     3051   IF par-mode = 'ДОБАВЛЕНИЕ':U then do:
     3052      p-doc-rec = ?.
     3053      run get-environment in this-Procedure no-error.
     3054      if error-status:error then return error.
     3055       message
     3056       "Выберите из списка кассу, для которой Вы хотите создать чек!"
     3057       view-as alert-box.
     3058       run sel-cd in this-procedure no-error.
     3059       if error-status:error then do:
     3060         undo, return error .
     3061       end.
     3062      run gbl/factdate.p (
     3063                        INPUT        p-obj-type
     3064                       ,INPUT        p-obj-code
     3065                       ,INPUT-OUTPUT chk-date_
     3066                       ,INPUT-OUTPUT chk-time_
     3067                       ,INPUT-OUTPUT shift-date_
     3068                       ,INPUT-OUTPUT shift-num_
     3069                       ,input-output shift-name_
     3070                       ,INPUT        YES
     3071                  ) NO-ERROR.
     3072       IF ERROR-STATUS:ERROR THEN DO:
     3073         return error.
     3074       END.
     3075       if shift-name_ = ? then do:
     3076         shift-name_ = "":U.
     3077       end.
     3078       cash-scale_ = 1.
     3079       run find-curs in this-procedure
     3080                           (
     3081                            input chk-date_
     3082                           ,input chk-time_
     3083                           ,output cash-rate_
     3084                            )  no-error.
     3085       if error-status:error then undo, return error .
     3086       assign
     3087       v-first-cashier = gbclcode-get-this-db-first-role ( input 'C':U, input vardb-num, input ?) no-error .
     3088       if v-first-cashier = 0 then do:
     3089         message
     3090         "В справочнике нет ни одного кассира для текущей БД" skip
     3091         "невозможно создать чек"
     3092         view-as alert-box error.
     3093         return error.
     3094       end.
     3095       run cur-time in THIS-PROCEDURE ( output v-today, output v-time).
     3096       DO TRANSACTION ON ERROR UNDO, RETURN ERROR:
     3097         create tt-chk-doc.
     3098         ASSIGN
     3099         tt-chk-doc.chk-date = chk-date_
     3100         tt-chk-doc.src-shift-date = (if shift-date_ = ? then chk-date_ else shift-date_)
     3101         tt-chk-doc.shift-num  = shift-num_
     3102         tt-chk-doc.shift-name = shift-name_
     3103         tt-chk-doc.cashier   = v-first-cashier
     3104         tt-chk-doc.sales-man   = v-first-seller
     3105         tt-chk-doc.doc-code =   (if get-chkc_context.db-num = 0
     3106                                   then string(next-value(s-chk, ub ))
     3107                                   else string( p-obj-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     3108         tt-chk-doc.obj-type = p-obj-type
     3109         tt-chk-doc.obj-code = p-obj-code
     3110         tt-chk-doc.chk-num  = 1
     3111         tt-chk-doc.chk-time  = v-time
     3112         tt-chk-doc.chk-type  = integer('2':U)
     3113         tt-chk-doc.correct  = yes
     3114         tt-chk-doc.pay-desk = buf_cash-desk.cash-num
     3115         tt-chk-doc.cash-rate = if get-chkc_context.r-b = 'base':U
     3116                                     then cash-rate_
     3117                                     else 1
     3118         tt-chk-doc.cash-scale = if get-chkc_context.r-b = 'base':U
     3119                                           then cash-scale_
     3120                                           else 1
     3121         .
     3122         create locked_chk-doc.
     3123         buffer-copy tt-chk-doc to locked_chk-doc.
     3124         assign
     3125         .
     3126     END.
     3127     FIND FIRST buf_obj No-LOCK WHERe
     3128               buf_obj.obj-type = shop-type
     3129           AND buf_obj.obj-code = shop-code No-ERROR.
     3130   end.
     3131   else do:
     3132     if par-mode = 'ПРОСМОТР':U then do:
     3133       FIND FIRST locked_chk-doc NO-LOCK WHERE
     3134                   recid(locked_chk-doc) = p-doc-rec.
     3135     end.
     3136     ELSE do:
     3137       DO TRANSACTION
     3138         ON ERROR UNDO, RETURN ERROR:
     3139       FIND FIRST locked_chk-doc EXCLUSIVE-LOCK WHERE
     3140                   recid(locked_chk-doc) = p-doc-rec.
     3141       END.
     3142     END.
     3143     IF NOT AVAIL locked_chk-doc then
     3144     return error.
     3145     if locked_chk-doc.out-code <> ?
     3146     and par-mode <> 'ПРОСМОТР':U then do:
     3147       message
     3148       "Чек МЦ с N" locked_chk-doc.doc-code  "включен в документ МЦ" SKIP
     3149       "Изменения не допускаются"
     3150       view-as alert-box error.
     3151       return error.
     3152     end.
     3153     assign
     3154     p-obj-type = locked_chk-doc.obj-type
     3155     p-obj-code = locked_chk-doc.obj-code
     3156     .
     3157     run get-environment in this-Procedure no-error.
     3158     if error-status:error then return error.
     3159     create tt-chk-doc.
     3160     buffer-copy locked_chk-doc to tt-chk-doc.
     3161     if gbclcode-is-this-db-role ( input 'C':U, input vardb-num, input tt-chk-doc.cashier, input tt-chk-doc.chk-date) = 0 then do:
     3162       message
     3163       "В справочнике нет кассира" tt-chk-doc.cashier
     3164       view-as alert-box WARNING.
     3165     end.
     3166     FIND FIRST buf_cash-desk no-lock where
     3167               buf_cash-desk.db-num = vardb-num and
     3168               buf_cash-desk.obj-code = p-obj-code AND
     3169               buf_cash-desk.cash-num = tt-chk-doc.pay-desk no-error.
     3170     if not available buf_cash-desk then dO:
     3171       message
     3172       "В справочнике нет кассы" tt-chk-doc.pay-desk
     3173       view-as alert-box error.
     3174     end.
     3175     for each locked_chk-pay where
     3176              locked_chk-pay.doc-code = tt-chk-doc.doc-code no-lock:
     3177           create tt-chk-pay.
     3178           buffer-copy locked_chk-pay to tt-chk-pay.
     3179       end.
     3180       for each locked_chk-doc-attr no-lock where
     3181              locked_chk-doc-attr.doc-code = tt-chk-doc.doc-code:
     3182           create tt-chk-doc-attr.
     3183           buffer-copy locked_chk-doc-attr to tt-chk-doc-attr.
     3184       end.
     3185   end.
     3186   if not par-mode = 'ПРОСМОТР':U then do:
     3187     if par-mode = 'ДОБАВЛЕНИЕ':U
     3188     and (not get-chkc_context.shift-on
     3189     and get-chkc_context.cas-shft) then do:
     3190       assign
     3191       tt-chk-doc.src-shift-date = tt-chk-doc.chk-date
     3192       tt-chk-doc.shift-date = tt-chk-doc.chk-date
     3193       .
     3194     end.
     3195   end.
     3196   END PROCEDURE.
     3197   PROCEDURE find-curs :
     3198   DEFINE INPUT PARAMETER par-date as date no-undo.
     3199   DEFINE INPUT PARAMETER par-time as integer no-undo.
     3200   DEFINE output PARAMETER parbase-curs as decimal no-undo.
     3201   DEFINE BUFFER buf_curr-shop FOR ub.curr-shop .
     3202   IF varbase-code <> 0 then do:
     3203       FIND LAST buf_curr-shop NO-LOCK Where
     3204                            buf_curr-shop.obj-type = p-obj-type AND
     3205                   buf_curr-shop.obj-code  = p-obj-code AND
     3206                   buf_curr-shop.curr-code = varbase-code AND
     3207                  ( ( buf_curr-shop.exch-date = par-date AND
     3208                  buf_curr-shop.exch-time <= par-time ) OR
     3209                  buf_curr-shop.exch-date < par-date ) NO-ERROR .
     3210       IF NOT AVAIL buf_curr-shop then do:
     3211           message
     3212           "Нет магазинного курса базовой валюты на дату и время чека!" skip
     3213            " - дата " string(par-date, "99/99/9999")
     3214           " время - " string(par-time, "hh:mm") view-as alert-box ERROR.
     3215          return error.
     3216       end.
     3217       parbase-curs = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale.
     3218   END.
     3219   else parbase-curs = 1.
     3220   END PROCEDURE.
     3221   PROCEDURE find-uchet-date :
     3222   assign
     3223   tt-chk-doc.src-shift-date = if (get-chkc_context.cas-shft and not get-chkc_context.shift-on)
     3224                                 then tt-chk-doc.src-shift-date
     3225                                 else tt-chk-doc.chk-date
     3226   tt-chk-doc.shift-date = if get-chkc_context.t-shft < 0 AND tt-chk-doc.chk-time < abs(t-shft)
     3227                             then (tt-chk-doc.chk-date - 1)
     3228                             else tt-chk-doc.src-shift-date
     3229   .
     3230   display
     3231   tt-chk-doc.shift-date
     3232   with frame Dialog-Frame.
     3233   run find-curs in this-procedure (
     3234                                         input tt-chk-doc.chk-date
     3235                                        ,input tt-chk-doc.chk-time
     3236                                        ,output cash-rate_
     3237                                        ) no-error.
     3238    if error-status:error then return error.
     3239   END PROCEDURE.
     3240   PROCEDURE get-environment :
     3241     FIND FIRST buf_obj No-LOCK WHERE
     3242                   buf_obj.obj-type = p-obj-type and
     3243                   buf_obj.obj-code = p-obj-code No-ERROR.
     3244   if not avail buf_obj or p-obj-type <> 'маг':U then do:
     3245       message vss-workfile vss-revision vss-description skip
     3246       "Неверный параметр вызова p-obj-type и/или p-obj-code" p-obj-type p-obj-code
     3247       view-as alert-box ERROR.
     3248       return.
     3249   end.
     3250   vardb-num = buf_obj.db-num.
     3251   FIND FIRST ub.shop No-LOCK WHERE
     3252                            ub.shop.obj-code = p-obj-code No-ERROR.
     3253           if not available shop then do:
     3254               message "Не найден магазин с кодом" p-obj-code
     3255               view-as alert-box ERROR.
     3256               return error.
     3257           end.
     3258   FIND FIRSt ub.sysconf No-LOCK WHERE
     3259                           ub.sysconf.host-code = ub.shop.host-code No-ERROR.
     3260           if not available ub.sysconf then do:
     3261               message "Не найдена фирма с кодом" ub.shop.host-code
     3262               view-as alert-box ERROR.
     3263               return error.
     3264           end.
     3265           assign
     3266           varbase-code = ub.sysconf.base-code.
     3267   END PROCEDURE.
     3268   PROCEDURE get-params :
     3269   DEFINE INPUT PARAMETER p-obj-type like ub.clients.obj-type no-undo.
     3270   DEFINE INPUT PARAMETER p-obj-code like ub.clients.obj-code no-undo.
     3271   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3272   define variable v-param-type22 as character no-undo .
     3273   define variable v-value-date22 as date no-undo .
     3274   define variable v-value-decimal22 as decimal no-undo .
     3275   define variable v-value-integer22 as INTEGER no-undo .
     3276   define variable v-value-logical22 AS LOGICAL no-undo .
     3277   define variable v-tth22 as handle no-undo .
     3278   run adm/shattri.p (
     3279       input "get":U
     3280       ,input  p-obj-type
     3281       ,input  p-obj-code
     3282       ,input  'cd-sending':U
     3283       ,input  'dflt-cd':U
     3284       ,output dflt-cd
     3285       ,output v-value-date22
     3286       ,output v-value-decimal22
     3287       ,output v-value-integer22
     3288       ,output v-value-logical22
     3289       ,output v-param-type22
     3290       ,INPUT-OUTPUT table-handle v-tth22
     3291       )  .
     3292   delete object v-tth22 no-error.
     3293   get-chkc_context.pos-type = dflt-cd.
     3294   get-chkc_context.p-log-handle = this-procedure:handle.
     3295   if get-chkc_context.shift-on and not get-chkc_context.cas-shft then do:
     3296     message
     3297     "Внимание! На текущем объекте требуется использование смен" skip
     3298     "а настройка СМЕНЫ НА КАССЕ ( cas-shft ) выключена - это недопустимо." skip (2)
     3299     view-as alert-box ERROR.
     3300     return ERROR.
     3301   end.
     3302   END PROCEDURE.
     3303   PROCEDURE lock-proc :
     3304   DEFINE INPUT PARAMETER locked-title as logical no-undo.
     3305   if locked-title then do:
     3306       DISABLE
     3307       fhour fmin fsec
     3308       tt-chk-doc.cash-rate
     3309       tt-chk-doc.chk-date
     3310       tt-chk-doc.chk-type
     3311       with frame Dialog-Frame
     3312       .
     3313   end.
     3314   else do:
     3315       if par-mode <> 'ПРОСМОТР':U then
     3316       ENABLE
     3317       fhour when par-mode = 'ДОБАВЛЕНИЕ':U
     3318       fmin when par-mode = 'ДОБАВЛЕНИЕ':U
     3319       fsec when par-mode = 'ДОБАВЛЕНИЕ':U
     3320       tt-chk-doc.cash-rate when par-mode = 'ДОБАВЛЕНИЕ':U
     3321       tt-chk-doc.chk-date when par-mode = 'ДОБАВЛЕНИЕ':U
     3322       tt-chk-doc.chk-type when par-mode = 'ДОБАВЛЕНИЕ':U
     3323       tt-chk-doc.src-shift-date  when (get-chkc_context.cas-shft and not  get-chkc_context.SHiFT-on)
     3324       tt-chk-doc.shift-name when (get-chkc_context.cas-shft and not  get-chkc_context.SHiFT-on)
     3325       with frame Dialog-Frame
     3326       .
     3327   end.
     3328   END PROCEDURE.
     3329   PROCEDURE MyEnable :
     3330   define variable var-dopi as integer no-undo.
     3331    tt-chk-doc.chk-type:Radio-buttons in frame Dialog-Frame =
     3332    "Инкассация" + chr(44) + string('2':U) + chr(44) +
     3333    "Касс_фонд" + chr(44) + string('3':U) + chr(44) +
     3334    "Перевод_опл" + chr(44) + string('4':U) + chr(44) +
     3335    "Расход_кассы" + chr(44) + string('5':U) + chr(44) +
     3336    "Декл_ден_ящ" + chr(44) + string('7':U)
     3337    .
     3338   if get-chkc_context.cas-curs then
     3339   assign
     3340   tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = no
     3341   tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = no
     3342   tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = no
     3343   .
     3344   else
     3345   assign
     3346   tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = yes
     3347   tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = yes
     3348   tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = yes
     3349   .
     3350   assign
     3351   fhour = (tt-chk-doc.chk-time - tt-chk-doc.chk-time MODULO 3600) / 3600
     3352   var-dopi = tt-chk-doc.chk-time MODULO 3600
     3353   fmin =  (var-dopi - var-dopi modulo 60) / 60
     3354   var-dopi = var-dopi modulo 60
     3355   fsec = (var-dopi - var-dopi modulo 60) / 60
     3356   .
     3357   IF AVAILABLE tt-chk-doc THEN
     3358   DISPLAY
     3359   fhour
     3360   fmin
     3361   fsec
     3362   tt-chk-doc.cash-rate
     3363   tt-chk-doc.cash-scale
     3364   tt-chk-doc.chk-date
     3365   tt-chk-doc.obj-code
     3366   tt-chk-doc.chk-type
     3367   tt-chk-doc.src-shift-date
     3368   tt-chk-doc.shift-date
     3369   tt-chk-doc.pay-desk
     3370   tt-chk-doc.shift-num
     3371   tt-chk-doc.shift-name
     3372   tt-chk-doc.cashier
     3373   tt-chk-doc.z-number
     3374   tt-chk-doc.chk-num
     3375   tt-chk-doc.ps
     3376   WITH FRAME Dialog-Frame .
     3377   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     3378     ASSIGN
     3379     tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = yes
     3380     tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = yes
     3381     tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = yes
     3382     tt-chk-pay.pay-code:READ-ONLY IN BROWSE BR-lines = yes
     3383     tt-chk-pay.curr-code:READ-ONLY IN BROWSE BR-lines = yes
     3384     tt-chk-pay.doc-qnty:visible IN BROWSE BR-lines = no
     3385     tt-chk-pay.par-val:visible IN BROWSE BR-lines = no
     3386     tt-chk-pay.par-code:visible IN BROWSE BR-lines = no
     3387     .
     3388     ENABLE
     3389     B-exit
     3390     b-quit
     3391     B-Help
     3392     B-add
     3393     B-del
     3394     fhour
     3395     fmin
     3396     fsec
     3397     tt-chk-doc.cash-rate when cas-curs
     3398     tt-chk-doc.chk-date
     3399     tt-chk-doc.chk-type
     3400     tt-chk-doc.src-shift-date  when (get-chkc_context.cas-shft and not get-chkc_context.shift-on)
     3401     b-cd
     3402     tt-chk-doc.shift-name  when (get-chkc_context.cas-shft and not get-chkc_context.shift-on)
     3403     tt-chk-doc.cashier
     3404     tt-chk-doc.z-number
     3405     tt-chk-doc.chk-num
     3406     BR-lines
     3407     tt-chk-doc.ps
     3408     WITH FRAME Dialog-Frame.
     3409     hide b-hist
     3410     in frame Dialog-Frame.
     3411     end.
     3412     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     3413       assign
     3414       tt-chk-pay.src-qnty:READ-ONLY IN BROWSE BR-lines = yes
     3415       tt-chk-pay.src-val:READ-ONLY IN BROWSE BR-lines = yes
     3416       .
     3417       ENABLE
     3418       b-quit
     3419       B-exit
     3420       B-Help
     3421       b-hist
     3422       BR-lines
     3423       tt-chk-doc.src-shift-date  when (get-chkc_context.cas-shft and not get-chkc_context.shift-on)
     3424       tt-chk-doc.shift-name when (get-chkc_context.cas-shft and not get-chkc_context.shift-on)
     3425       tt-chk-doc.ps
     3426       tt-chk-doc.z-number
     3427       WITH FRAME Dialog-Frame .
     3428     end.
     3429     if par-mode = 'ПРОСМОТР':U then do:
     3430       ASSIGN
     3431       tt-chk-pay.tot-sum:READ-ONLY IN BROWSE BR-lines = yes
     3432       tt-chk-pay.cash-rate:READ-ONLY IN BROWSE BR-lines = yes
     3433       tt-chk-pay.bank-rate:READ-ONLY IN BROWSE BR-lines = yes
     3434       tt-chk-pay.bank-scale:READ-ONLY IN BROWSE BR-lines = yes
     3435       tt-chk-pay.pay-code:READ-ONLY IN BROWSE BR-lines = yes
     3436       tt-chk-pay.curr-code:READ-ONLY IN BROWSE BR-lines = yes
     3437       tt-chk-pay.src-qnty:READ-ONLY IN BROWSE BR-lines = yes
     3438       tt-chk-pay.src-val:READ-ONLY IN BROWSE BR-lines = yes
     3439       .
     3440       b-quit:label = "&Выход".
     3441       ENABLE
     3442       b-quit
     3443       B-Help
     3444       b-next
     3445       b-prev
     3446       b-hist
     3447       BR-lines
     3448       WITH FRAME Dialog-Frame .
     3449       HIDE
     3450       b-exit
     3451       in frame Dialog-Frame.
     3452     end.
     3453   VIEW FRAME Dialog-Frame .
     3454   run control-line in this-procedure ( output locked-title).
     3455   run lock-proc in this-procedure ( locked-title).
     3456   if not cas-shft then do:
     3457     hide
     3458     tt-chk-doc.src-shift-date
     3459     tt-chk-doc.shift-num
     3460     tt-chk-doc.shift-name
     3461     in frame Dialog-Frame.
     3462   end.
     3463   OPEN QUERY BR-lines FOR EACH locked_chk-pay NO-LOCK WHERE        locked_chk-pay.doc-code = tt-chk-doc.doc-code,            FIRST tt-chk-pay WHERE         tt-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-chk-pay.line-num = locked_chk-pay.line-num.
     3464   IF ERROR-STATUS:ERROR THEN DO:
     3465     REPOSITION br-lines TO ROW 1 NO-ERROR.
     3466   END.
     3467   APPLY "ENTRY":U TO br-lines IN FRAME Dialog-Frame.
     3468   APPLY "VALUE-CHANGED" to br-lines in frame Dialog-Frame .
     3469   ASSIGN
     3470   frame Dialog-Frame:title = if par-mode = 'ДОБАВЛЕНИЕ':U
     3471                               then substitute("ЧЕК № &1"
     3472                                         ,tt-chk-doc.doc-code)
     3473                             else (
     3474                             substitute("ЧЕК № &1 Дата: &2 Время: &3"
     3475                                         ,tt-chk-doc.doc-code
     3476                                         ,tt-chk-doc.chk-date
     3477                                         ,string (tt-chk-doc.chk-time, "HH:MM")) +
     3478                             if (cas-shft OR T-SHFT <> 0)
     3479                             then substitute(" Смена от &1 N смены &2&3"
     3480                                             ,string(tt-chk-doc.src-shift-date, "99/99/9999")
     3481                                             ,tt-chk-doc.shift-name
     3482                                             , (if integer(tt-chk-doc.shift-name) = tt-chk-doc.shift-num
     3483                                                 then '':U
     3484                                                 else string(tt-chk-doc.shift-num, "(>9)"))
     3485                                             )
     3486                             else substitute("Дата учета &1", string(tt-chk-doc.shift-date)))
     3487   .
     3488   END PROCEDURE.
     3489   PROCEDURE proc-b-add :
     3490   define variable ii as integer no-undo.
     3491   DEFINE VARIABLE var-rid as recid no-undo.
     3492   DEFINE VARIABLE rid-list as character no-undo.
     3493   define variable par-rid-list as character no-undo .
     3494   DEFINE VARIABLE varopl-curs as decimal no-undo .
     3495   DEFINE VARIABLE varbase-curs as decimal no-undo .
     3496   define buffer count_chk-pay for ub.chk-pay.
     3497   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     3498   DEFINE BUFFER buf_wealth FOR ub.wealth.
     3499   DEFINE BUFFER loc_tt-chk-pay FOR tt-chk-pay.
     3500   define buffer buf_wth-par for ub.wth-par.
     3501   if not par-mode = 'ДОБАВЛЕНИЕ':U then return.
     3502   rid-list = "" .
     3503   run proc-save-doc ( INPUT CAN-FIND (FIRST tt-chk-pay WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code)
     3504                      ,INPUT NO) No-ERROR.
     3505   if error-status:error then return error.
     3506   run ref/cashpays.w (
     3507                input parparentproc
     3508               ,input "b-mark,b-sel":U
     3509               ,input 'все':U
     3510               ,input get-chkc_context.host-code
     3511               ,input locked_chk-doc.obj-type
     3512               ,input locked_chk-doc.obj-code
     3513               ,output rid-list ) .
     3514   IF rid-list = '':U THEN UNDO, RETURN ERROR.
     3515   ii = 1.
     3516   find last count_chk-pay No-LOCK WHERE
     3517                   count_chk-pay.doc-code = tt-chk-doc.doc-code  use-index ln No-ERROR.
     3518   if available count_chk-pay then lnp = count_chk-pay.line-num.
     3519   ELSE lnp = 0.
     3520    _ii:
     3521    DO WHILE (ii <= num-entries(rid-list) )
     3522    on error undo _ii, next _ii
     3523    :
     3524     FIND FIRST buf_cash-pay WHERE recid( buf_cash-pay ) = integer( entry(ii, rid-list ) ) NO-LOCK .
     3525     if buf_cash-pay.wth-code = 0 then do:
     3526       message
     3527       substitute("Выбранному типу кассового платежа с кодом &1 и кодом валюты &2 не соответствует ни одна МЦ!"
     3528                  , buf_cash-pay.cdpay-code
     3529                  , buf_cash-pay.curr-code)
     3530       view-as alert-box ERROR.
     3531       ii = ii + 1.
     3532       UNDO _ii, NEXT _ii.
     3533     end.
     3534     FIND FIRST buf_wealth No-LOCK WHERE
     3535                      buf_wealth.wth-code = buf_cash-pay.wth-code No-ERROR.
     3536     if not avail buf_wealth then do:
     3537       message
     3538       substitute("Не найдена МЦ с кодом &1",buf_cash-pay.wth-code)
     3539       view-as alert-box ERROR.
     3540       ii = ii + 1.
     3541       UNDO _ii, NEXT _ii.
     3542     end.
     3543     if buf_wealth.get-qnty-method = '=val-qnty':U then do:
     3544       par-rid-list = ''.
     3545       if available buf_wth-par then release buf_wth-par.
     3546       run ref/wthp-ref.w (
     3547                           input parparentproc
     3548                          ,input "b-sel,b-mark"
     3549                          ,input get-chkc_context.host-code
     3550                          ,input tt-chk-doc.obj-type
     3551                          ,input tt-chk-doc.obj-code
     3552                          ,input 'МЦ':U
     3553                          ,input buf_wealth.wth-code
     3554                          ,input-output par-rid-list ) no-error.
     3555       if par-rid-list = '' then do:
     3556         ii = ii + 1.
     3557         undo _ii, next _ii.
     3558       end.
     3559       find first buf_wth-par no-lock where
     3560                 recid(buf_wth-par) = integer(par-rid-list) no-error.
     3561       if not available buf_wth-par then do:
     3562         message
     3563         substitute("Не найдена номинал для МЦ с кодом &1", buf_cash-pay.wth-code)
     3564         view-as alert-box ERROR.
     3565         ii = ii + 1.
     3566         undo _ii, next _ii.
     3567       end.
     3568     end.
     3569     assign
     3570     lnp = lnp + 1
     3571     .
     3572     CREATE tt-chk-pay.
     3573     ASSIGN
     3574     tt-chk-pay.doc-code = tt-chk-doc.doc-CODE
     3575     tt-chk-pay.line-num = lnp
     3576     tt-chk-pay.pay-code = buf_cash-pay.cdpay-code
     3577     tt-chk-pay.curr-code = buf_cash-pay.curr-code
     3578     tt-chk-pay.wth-code = buf_cash-pay.wth-code
     3579     tt-chk-pay.obj-code = tt-chk-doc.obj-code
     3580     tt-chk-pay.obj-type = tt-chk-doc.obj-type
     3581     tt-chk-pay.time-oper = tt-chk-doc.chk-time
     3582     tt-chk-pay.tot-sum = 0
     3583     tt-chk-pay.cash-rate = 0
     3584     tt-chk-pay.bank-rate = 0
     3585     tt-chk-pay.bank-scale = 0
     3586     tt-chk-pay.src-qnty = 0
     3587     tt-chk-pay.doc-qnty = 0
     3588     tt-chk-pay.src-val = (if available buf_wth-par then buf_wth-par.par-val else 0)
     3589     tt-chk-pay.par-val = 0
     3590     tt-chk-pay.par-code = 0
     3591     var-rid = (IF var-rid = ? THEN RECID(tt-chk-pay) ELSE var-rid)
     3592     .
     3593     create locked_chk-pay.
     3594     buffer-copy tt-chk-pay to locked_chk-pay
     3595     .
     3596     run trg/chkins02.p (
     3597                     input  tt-chk-doc.doc-code
     3598                    ,input  1
     3599                    ,input  tt-chk-doc.chk-type
     3600                    ,input  tt-chk-doc.obj-type
     3601                    ,input  tt-chk-doc.obj-code
     3602                    ,input  tt-chk-doc.chk-date
     3603                    ,input  tt-chk-doc.chk-time
     3604                    ,input  buf_cash-pay.cdpay-code
     3605                    ,input  buf_cash-pay.curr-code
     3606                    ,input  get-chkc_context.base-code
     3607                    ,input  get-chkc_context.r-b
     3608                    ,input  get-chkc_context.cas-curs
     3609                    ,input-output  tt-chk-pay.cash-rate
     3610                    ,input-output  tt-chk-pay.bank-rate
     3611                    ,input-output  tt-chk-pay.bank-scale
     3612                    ,input  recid(locked_chk-pay)
     3613                    ,output varbase-curs
     3614                    ,output varopl-curs
     3615                    ,output tt-chk-pay.par-code
     3616                  ) no-error.
     3617       if error-status:error then do:
     3618         var-rid = ?.
     3619         delete tt-chk-pay.
     3620         run control-line in THIS-PROCEDURE ( output locked-title).
     3621         run lock-proc in THIS-PROCEDURE ( INPUT locked-title).
     3622         ii = ii + 1.
     3623         UNDO _ii, NEXT _ii.
     3624       end.
     3625       run control-line in THIS-PROCEDURE ( output locked-title).
     3626       run lock-proc in THIS-PROCEDURE ( INPUT locked-title).
     3627     ii = ii + 1.
     3628   END.
     3629   OPEN QUERY BR-lines FOR EACH locked_chk-pay NO-LOCK WHERE        locked_chk-pay.doc-code = tt-chk-doc.doc-code,            FIRST tt-chk-pay WHERE         tt-chk-pay.doc-code = tt-chk-doc.doc-code     AND tt-chk-pay.line-num = locked_chk-pay.line-num.
     3630   find first loc_tt-chk-pay WHERE
     3631              loc_tt-chk-pay.doc-code = tt-chk-doc.doc-code AND
     3632              loc_tt-chk-pay.tot-sum = 0 NO-LOCK NO-ERROR.
     3633   IF avail loc_tt-chk-pay then do:
     3634     reposition br-lines to recid var-rid NO-ERROR.
     3635   end.
     3636   apply "entry" to br-lines in frame Dialog-Frame .
     3637   END PROCEDURE.
     3638   PROCEDURE proc-save-doc :
     3639   DEFINE INPUT PARAMETER parlines-exist as logical no-undo.
     3640   define input parameter par-check-lines as logical no-undo .
     3641   DEFINE VARIABLE var-rid as recid no-undo.
     3642   define variable var-chk-type as character no-undo.
     3643   DEFINE VARIABLE varline-rid as recid no-undo .
     3644   define buffer check_chk-pay for ub.chk-pay .
     3645   DEFINE BUFFER buf-tt-chk-pay FOR tt-chk-pay.
     3646   do
     3647   on error undo, return ERROR return-value
     3648   :
     3649   assign
     3650   frame Dialog-Frame fhour
     3651   frame Dialog-Frame fmin
     3652   frame Dialog-Frame fsec
     3653   .
     3654   if par-mode = 'ИЗМЕНЕНИЕ':U then
     3655   run trg/chk-doch.p (
     3656                    buffer locked_chk-doc
     3657                 , input no
     3658                 , input no
     3659                 , input no
     3660                 , input-output v-chip-num
     3661                 , output v-is-update).
     3662   assign
     3663   tt-chk-doc.cash-rate
     3664   tt-chk-doc.cashier
     3665   tt-chk-doc.chk-date
     3666   tt-chk-doc.chk-num
     3667   tt-chk-doc.chk-time = fhour * 3600 + fmin * 60 + fsec * 60
     3668   tt-chk-doc.chk-type
     3669   tt-chk-doc.obj-code
     3670   tt-chk-doc.pay-desk
     3671   tt-chk-doc.ps
     3672   tt-chk-doc.src-shift-date
     3673   tt-chk-doc.shift-num
     3674   tt-chk-doc.shift-name
     3675   tt-chk-doc.z-number
     3676   .
     3677   buffer-copy tt-chk-doc
     3678   except
     3679   discnt
     3680   correct
     3681   cashier-psn-code
     3682   out-code
     3683   to locked_chk-doc
     3684   assign
     3685   locked_chk-doc.correct = yes
     3686   .
     3687   display tt-chk-doc.ps
     3688   with frame Dialog-Frame .
     3689   assign
     3690   locked_chk-doc.correct = yes
     3691   .
     3692   display tt-chk-doc.ps
     3693   with frame Dialog-Frame .
     3694   for each buf-tt-chk-pay no-lock where
     3695            buf-tt-chk-pay.doc-code = tt-chk-doc.doc-code,
     3696       first locked_chk-pay where
     3697             locked_chk-pay.doc-code = buf-tt-chk-pay.doc-code
     3698        AND  locked_chk-pay.line-num = buf-tt-chk-pay.line-num:
     3699     assign
     3700     locked_chk-pay.pay-code = buf-tt-chk-pay.pay-code
     3701     locked_chk-pay.curr-code = buf-tt-chk-pay.curr-code
     3702     locked_chk-pay.tot-sum       = buf-tt-chk-pay.tot-sum
     3703     locked_chk-pay.wth-code  = buf-tt-chk-pay.wth-code
     3704     locked_chk-pay.cash-rate  = buf-tt-chk-pay.cash-rate
     3705     locked_chk-pay.bank-rate  = buf-tt-chk-pay.bank-rate
     3706     locked_chk-pay.bank-scale  = buf-tt-chk-pay.bank-scale
     3707     locked_chk-pay.src-qnty = buf-tt-chk-pay.src-qnty
     3708     locked_chk-pay.src-val = buf-tt-chk-pay.src-val
     3709     .
     3710   END.
     3711   end.
     3712   END PROCEDURE.
     3713   PROCEDURE reposition-chk-doc :
     3714   define input parameter p-direction as character no-undo .
     3715   define variable v-new-chk-doc-recid as recid no-undo .
     3716   do
     3717   on error undo, return error
     3718   :
     3719     if valid-handle(p-call-prog)
     3720     then do:
     3721       run reposition-chk-doc in p-call-prog
     3722         (input  p-direction
     3723         ,output v-new-chk-doc-recid
     3724         ).
     3725       if v-new-chk-doc-recid <> ?
     3726       then do:
     3727         define buffer buf_chk-doc for ub.chk-doc .
     3728         find first buf_chk-doc no-lock
     3729           where recid(buf_chk-doc) = v-new-chk-doc-recid
     3730           no-error .
     3731         assign
     3732         p-doc-rec = v-new-chk-doc-recid
     3733         p-next-prev = '':U
     3734         .
     3735       end.
     3736     end.
     3737     else do:
     3738       message "Список чеков не определен." view-as alert-box INFORMATION .
     3739       return no-apply.
     3740     end.
     3741     END.
     3742   END PROCEDURE.
     3743   PROCEDURE sel-cd :
     3744   define variable ri-list as character no-undo .
     3745   define variable glog as logical no-undo .
     3746   define buffer loc_cash-desk  for ub.cash-desk.
     3747   run ref/cashlist.w
     3748       (input  parparentproc
     3749       ,input  'b-sel':U
     3750       ,input  'объект':U
     3751       ,input  get-chkc_context.db-num
     3752       ,input  get-chkc_context.host-code
     3753       ,input  'маг':U
     3754       ,input  shop-code
     3755       ,input  ?
     3756       ,output ri-list
     3757       ) no-error.
     3758   if ri-list = '' then do:
     3759     undo, return error .
     3760   end.
     3761   FIND FIRST loc_cash-desk No-LOCK WHERE
     3762             recid(loc_cash-desk) = integer(ri-list) no-error.
     3763   if not available loc_cash-desk then do:
     3764     undo, return error .
     3765   end.
     3766   if loc_cash-desk.autonomy = integer('2':U) then do:
     3767     message
     3768     "Нельзя создать чек для КАССОВОГО МЕНЕДЖЕРА!"
     3769     view-as alert-box error.
     3770     undo, return error .
     3771   end.
     3772   if loc_cash-desk.pos-type <> dflt-cd then do:
     3773     message
     3774     substitute("На &1&2 установлен тип кассы по умолчанию - &3&4" +
     3775               "Вы уверены, что хотите создать чек для кассы с типом &5?"
     3776               , 'маг':U
     3777               , shop-code
     3778               , dflt-cd
     3779               , chr(10)
     3780               , loc_cash-desk.pos-type)
     3781     view-as alert-box question buttons yes-no update glog.
     3782     if not glog then undo, return error .
     3783   end.
     3784   find first buf_cash-desk no-lock where
     3785             recid(buf_cash-desk) = recid(loc_cash-desk).
     3786   END PROCEDURE.
     3787   PROCEDURE write-log-and-file :
     3788   define input parameter p-tab-position   as integer   no-undo.
     3789   define input parameter p-file-name      as character no-undo .
     3790   define input parameter p-log-level      as integer no-undo .
     3791   define input parameter p-log-string     as character no-undo .
     3792   message
     3793   p-log-string
     3794   view-as alert-box error .
     3795   END PROCEDURE.
     3796   FUNCTION get-cash-pay RETURNS CHARACTER
     3797     ( input parpay-code as integer, parcurr-code as integer, OUTPUT p-wth-code AS INTEGER ) :
     3798   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     3799   DEFINE BUFFER buf_wealth FOR ub.wealth.
     3800   FIND FIRST buf_cash-pay No-LOCK WHERE
     3801            buf_cash-pay.cdpay-code = parpay-code
     3802       AND buf_cash-pay.curr-code = parcurr-code No-ERROR.
     3803   if available buf_cash-pay then do:
     3804     varwth-code = buf_cash-pay.wth-code.
     3805     p-wth-code = varwth-code.
     3806     if varwth-code > 0 then do:
     3807         FIND FIRST buf_wealth No-LOCK WHERE
     3808                         buf_wealth.wth-code = varwth-code No-error.
     3809         if available buf_wealth then do:
     3810           assign
     3811           varwth-code = buf_wealth.wth-code
     3812           varwth-name = buf_wealth.wth-name
     3813           p-wth-code = varwth-code
     3814           .
     3815           return buf_cash-pay.obj-name.
     3816         end.
     3817         else do:
     3818           assign
     3819           varwth-code = 0
     3820           varwth-name = "Неопознанная МЦ"
     3821           p-wth-code = varwth-code
     3822           .
     3823           RETURN buf_cash-pay.obj-name.
     3824         end.
     3825     end.
     3826     else do:
     3827       assign
     3828       varwth-code = 0
     3829       varwth-name = "Неопознанная МЦ"
     3830       p-wth-code = varwth-code
     3831       .
     3832       RETURN buf_cash-pay.obj-name .
     3833     end.
     3834   end.
     3835   assign
     3836   varwth-code = 0
     3837   varwth-name = '':U
     3838   p-wth-code = varwth-code
     3839   .
     3840   RETURN "Неопознанная оплата".
     3841   END FUNCTION.
