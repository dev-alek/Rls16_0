      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      587                                                       ,input p-range-type as character
      588                                                       ,input p-code as integer):
      589   define variable v-seq-val as integer no-undo .
      590   define buffer buf_code-range for ub.code-range.
      591   find first buf_code-range no-lock where
      592             buf_code-range.db-num = p-db-num
      593       and  buf_code-range.range-type = p-range-type
      594       and  buf_code-range.stts = 'u'
      595       and buf_code-range.first-code <= p-code
      596       and buf_code-range.last-code >= p-code no-error .
      597   if available buf_code-range then return yes.
      598   CASE p-range-type:
      599     when 'pngb':U then do:
      600       v-seq-val = current-value(s-pngb-code, ub).
      601     end.
      602     when 'fmgb':U then do:
      603       v-seq-val = current-value(s-fmgb-code, ub).
      604     end.
      605   END CASE.
      606   if p-code <= v-seq-val then do:
      607     find first buf_code-range no-lock where
      608               buf_code-range.db-num = p-db-num
      609         and  buf_code-range.range-type = p-range-type
      610         and  buf_code-range.stts = 'a'
      611         and buf_code-range.first-code <= p-code
      612         no-error .
      613    if available buf_code-range then return yes.
      614   end.
      615   find first buf_code-range no-lock where
      616             buf_code-range.db-num = p-db-num
      617       and  buf_code-range.range-type = p-range-type
      618       and  buf_code-range.stts = 'f'
      619       and buf_code-range.first-code <= p-code
      620       and buf_code-range.last-code >= p-code
      621       no-error .
      622   if available buf_code-range then return yes.
      623   return no.
      624   END FUNCTION.
      625   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      626                                                       ,input p-range-type as character
      627                                                       ,input p-code as integer):
      628   define variable v-seq-val as integer no-undo .
      629   define buffer buf_code-range for ub.code-range.
      630   CASE p-range-type:
      631     when 'pngb':U then do:
      632       v-seq-val = current-value(s-pngb-code, ub).
      633     end.
      634     when 'fmgb':U then do:
      635       v-seq-val = current-value(s-fmgb-code, ub).
      636     end.
      637   END CASE.
      638   if p-code <= v-seq-val then do:
      639     find first buf_code-range no-lock where
      640               buf_code-range.db-num = p-db-num
      641         and  buf_code-range.range-type = p-range-type
      642         and buf_code-range.first-code <= p-code
      643         and buf_code-range.last-code >= p-code no-error .
      644     if available buf_code-range then return yes.
      645   end.
      646   return no.
      647   END FUNCTION.
      648   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      649                                                       ,input p-db-num as integer
      650                                                       ,input p-staff-code as integer
      651                                                       ,input p-date as date
      652                                                        ):
      653   define buffer buf_staff for ub.staff.
      654   if p-date = ? then do:
      655     p-date = today .
      656   end.
      657   find first buf_staff no-lock where
      658             buf_staff.role = p-role
      659         and buf_staff.role-level = 'db':U
      660         and buf_staff.db-num = p-db-num
      661         and buf_staff.staff-code = p-staff-code
      662         and buf_staff.date-end >= p-date use-index pi  no-error .
      663   if available buf_staff then do:
      664     return buf_staff.psn-code.
      665   end.
      666   return 0.
      667   end FUNCTION.
      668   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      669                                                             ,input p-db-num as integer
      670                                                             ,input p-date as date
      671                                                                 ):
      672   define buffer buf_staff for ub.staff.
      673   define buffer buf2_staff for ub.staff.
      674   if p-date = ? then do:
      675     p-date = today .
      676   end.
      677   for each  buf_staff no-lock where
      678             buf_staff.role = p-role
      679         and buf_staff.db-num = p-db-num,
      680   first buf2_staff no-lock where
      681         buf2_staff.role = p-role
      682     and buf2_staff.role-level = 'db':U
      683     and buf2_staff.staff-code = buf_staff.staff-code
      684     and buf2_staff.date-start <= p-date
      685     and buf2_staff.date-end >= p-date
      686   by buf_staff.staff-code
      687   by date-start descending:
      688     return buf_staff.staff-code.
      689   end.
      690   end FUNCTION.
      691   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      692                                                  ,input p-db-num as integer
      693                                                  ,input p-psn-code as integer
      694                                                  ,input p-date as date
      695                                                  ,output p-c-password as character
      696                                                        ):
      697   define buffer buf_staff for ub.staff.
      698   if p-date = ? then do:
      699     p-date = today .
      700   end.
      701   find first buf_staff no-lock where
      702             buf_staff.role = p-role
      703         and buf_staff.role-level = 'db':U
      704         and buf_staff.db-num = p-db-num
      705        and buf_staff.date-end >= p-date
      706        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      707   if available buf_staff
      708   then do:
      709     assign
      710     p-c-password = buf_staff.password.
      711     return buf_staff.staff-code.
      712   end.
      713   p-c-password = ''.
      714   return 0.
      715   end FUNCTION.
      716   FUNCTION gbclcode-is-psn-role returns integer (
      717                                                 input p-role as character
      718                                                 ,input p-psn-code as integer
      719                                                 ,input p-date as date
      720                                                     ):
      721   define buffer buf_staff for ub.staff.
      722   if p-date = ? then do:
      723     p-date = today .
      724   end.
      725   for each buf_staff no-lock where
      726             buf_staff.psn-code = p-psn-code
      727        and  buf_staff.role = p-role
      728   by buf_staff.role-level
      729   by buf_staff.date-start
      730        :
      731     if  buf_staff.date-start <= p-date and
      732     buf_staff.date-end >= p-date  then do:
      733       return buf_staff.staff-code.
      734     end.
      735   end.
      736   return 0.
      737   end FUNCTION.
      738   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      739   define variable v-role-name as character no-undo .
      740   assign
      741   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      742   no-error .
      743   return v-role-name.
      744   END.
      745   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   FUNCTION gbclcode-get-position returns character ( input p-role as character
      747                                                     ,input p-role-level as character
      748                                                     ,input p-work-place as character
      749                                                     ,input p-staff-code as integer
      750                                                                ):
      751   define variable v-role-name as character no-undo .
      752   define variable v-role-level as character no-undo .
      753   define variable v-staff-code as integer no-undo .
      754   assign
      755   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      756   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      757   v-staff-code = p-staff-code
      758   no-error .
      759   return substitute("&1, &2, Код &3"
      760                   ,v-role-name
      761                   ,v-role-level
      762                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      763   END.
      764   FUNCTION gbclcode-get-work-place returns character (
      765                                                   input p-role as character
      766                                                  ,input p-role-level as character
      767                                                  ,input p-db-num as integer
      768                                                  ,input p-host-code as integer
      769                                                  ,input p-obj-type as character
      770                                                  ,input p-obj-code as integer
      771                                                  ) :
      772   define variable v-work-place as character no-undo .
      773   define variable v-obj-type as character no-undo .
      774     case p-role-level:
      775       when 'db':U then do:
      776         v-work-place = string(p-db-num, "99999").
      777       end.
      778       when 'firm':U then do:
      779         v-work-place = string(p-host-code, "99999").
      780       end.
      781       when 'object':U then do:
      782         assign
      783         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      784         .
      785       end.
      786     END CASE.
      787     return v-work-place.
      788   END FUNCTION.
      789   FUNCTION gbclcode-get-level-last-code returns integer (
      790                                                           input p-role as character
      791                                                         , input p-role-level as character
      792                                                         , input p-work-place as character
      793                                                         , input p-date-start as date
      794                                                         ):
      795   DEFINE VARIABLE v-today as date no-undo .
      796   define buffer buf_staff for ub.staff.
      797   if p-work-place = chr(63) then return ?.
      798   if p-date-start = ? then do:
      799     v-today = today .
      800   end.
      801   else do:
      802     v-today = p-date-start.
      803   end.
      804   find last buf_staff no-lock where
      805             buf_staff.role = p-role
      806        and  buf_staff.role-level = p-role-level
      807        and  buf_staff.work-place = p-work-place
      808        and  buf_staff.date-start <= v-today + 1
      809        and  buf_staff.date-end >= v-today + 1
      810        use-index pi  no-error .
      811   if available buf_staff
      812   then return buf_staff.staff-code.
      813   return 0.
      814   end FUNCTION.
