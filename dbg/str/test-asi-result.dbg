        1   define input parameter p-title as character no-undo .
        2   define input parameter p-labels as character no-undo .
        3   define input parameter p-values as character no-undo .
        4   DEFINE BUTTON Btn_OK AUTO-GO
        5        LABEL "OK"
        6        SIZE 15 BY 1.14
        7        BGCOLOR 8 .
        8   DEFINE VARIABLE FILL-IN-1 AS DECIMAL FORMAT "->>>>9.9999":U INITIAL 0
        9        LABEL "Fill 1"
       10        VIEW-AS FILL-IN
       11        SIZE 8 BY 1 NO-UNDO.
       12   DEFINE VARIABLE FILL-IN-2 AS DECIMAL FORMAT "->>>>9.9999":U INITIAL 0
       13        LABEL "Fill 1"
       14        VIEW-AS FILL-IN
       15        SIZE 8 BY 1 NO-UNDO.
       16   DEFINE VARIABLE FILL-IN-3 AS DECIMAL FORMAT "->>>>9.9999":U INITIAL 0
       17        LABEL "Fill 1"
       18        VIEW-AS FILL-IN
       19        SIZE 8 BY 1 NO-UNDO.
       20   DEFINE VARIABLE FILL-IN-4 AS DECIMAL FORMAT "->>>>9.99":U INITIAL 0
       21        LABEL "Fill 1"
       22        VIEW-AS FILL-IN
       23        SIZE 8 BY 1 NO-UNDO.
       24   DEFINE RECTANGLE RECT-1
       25        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
       26        SIZE 85 BY 7.5.
       27   DEFINE FRAME Dialog-Frame
       28        FILL-IN-1 AT ROW 2 COL 70 COLON-ALIGNED WIDGET-ID 2
       29        FILL-IN-2 AT ROW 3.5 COL 70 COLON-ALIGNED WIDGET-ID 4
       30        FILL-IN-3 AT ROW 5 COL 70 COLON-ALIGNED WIDGET-ID 6
       31        FILL-IN-4 AT ROW 6.5 COL 70 COLON-ALIGNED WIDGET-ID 6
       32        Btn_OK AT ROW 9 COL 65
       33        RECT-1 AT ROW 1 COL 2 WIDGET-ID 8
       34        SPACE(1) SKIP(1)
       35       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       36            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       37            TITLE "<insert dialog title>"
       38            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
       39   ASSIGN
       40          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       41          FRAME Dialog-Frame:HIDDEN           = TRUE.
       42   ASSIGN
       43          FILL-IN-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       44   ASSIGN
       45          FILL-IN-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       46   ASSIGN
       47          FILL-IN-3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       48   ASSIGN
       49          FILL-IN-4:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       50   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       51   DO:
       52     APPLY "END-ERROR":U TO SELF.
       53   END.
       54   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       55   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       56   MAIN-BLOCK:
       57   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       58      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       59     Frame Dialog-Frame:title = p-title .
       60     FILL-IN-1 = decimal(entry(1, p-values)) no-error .
       61     FILL-IN-1:label = entry(1, p-labels, "|") no-error .
       62     FILL-IN-2 = decimal(entry(2, p-values)) no-error .
       63     FILL-IN-2:label = entry(2, p-labels, "|") no-error .
       64     FILL-IN-3 = decimal(entry(3, p-values)) no-error .
       65     FILL-IN-3:label = entry(3, p-labels, "|") no-error .
       66     FILL-IN-4 = decimal(entry(4, p-values)) no-error .
       67     FILL-IN-4:label = entry(4, p-labels, "|") no-error .
       68     if p-title = "Результат расчета проверки корректности работы АСИ по массе НП"
       69     then do :
       70       FILL-IN-1:format = "->>>>>>>>>>9.9" .
       71       FILL-IN-2:format = "->>>>>>>>>>9.9" .
       72       FILL-IN-3:format = "->>>>>>>>>>9.9" .
       73     end .
       74     RUN enable_UI.
       75     WAIT-FOR GO OF FRAME Dialog-Frame.
       76   END.
       77   RUN disable_UI.
       78   PROCEDURE disable_UI :
       79     HIDE FRAME Dialog-Frame.
       80   END PROCEDURE.
       81   PROCEDURE enable_UI :
       82     DISPLAY FILL-IN-1 FILL-IN-2 FILL-IN-3 FILL-IN-4
       83         WITH FRAME Dialog-Frame.
       84     ENABLE RECT-1 Btn_OK
       85         WITH FRAME Dialog-Frame.
       86     VIEW FRAME Dialog-Frame.
       87   END PROCEDURE.
