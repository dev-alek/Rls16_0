     2530   DEFINE QUERY br-mark FOR
     2531     X_marking-line SCROLLING.
     2532   DEFINE BROWSE br-mark
     2533     QUERY br-mark NO-LOCK DISPLAY
     2534     X_marking-line.doc-type COLUMN-LABEL "Тип" FORMAT "X(35)":U
     2535     X_marking-line.date_ COLUMN-LABEL "Дата" FORMAT "99.99.9999":U width 30
     2536     X_marking-line.out-code COLUMN-LABEL "Номер документа" FORMAT "x(30)":U
     2537     string(X_marking-line.obj-code) + " " + X_marking-line.obj-type COLUMN-LABEL "Объект" FORMAT "x(20)":U
     2538     X_marking-line.doc-level COLUMN-LABEL "Уровень" FORMAT "-99":U
     2539       WITH NO-ROW-MARKERS SEPARATORS SIZE 106.5 BY 12.75 FIT-LAST-COLUMN.
     2540   DEFINE FRAME d-mark
     2541        b-exit AT ROW 1 COL 1.38
     2542        B-1 AT ROW 1 COL 11.63 WIDGET-ID 248
     2543        v-mark AT ROW 1.08 COL 27.63 COLON-ALIGNED WIDGET-ID 34
     2544        b-hist AT ROW 1.08 COL 106
     2545        b-sostav AT ROW 2.19 COL 57 WIDGET-ID 294
     2546        f-GTIN AT ROW 2.21 COL 67 COLON-ALIGNED WIDGET-ID 220
     2547        v-mark-2 AT ROW 2.25 COL 10.63 COLON-ALIGNED WIDGET-ID 252
     2548        f-last-change AT ROW 3.38 COL 67 COLON-ALIGNED WIDGET-ID 268
     2549        f-status AT ROW 3.42 COL 10.63 COLON-ALIGNED NO-LABEL WIDGET-ID 218
     2550        f-gds-name AT ROW 4.54 COL 67 COLON-ALIGNED WIDGET-ID 222
     2551        f-gds-code AT ROW 4.63 COL 10.63 COLON-ALIGNED WIDGET-ID 224
     2552        mrc AT ROW 5.67 COL 82 RIGHT-ALIGNED WIDGET-ID 266
     2553        f-obj-code AT ROW 5.75 COL 10.63 COLON-ALIGNED WIDGET-ID 256
     2554        f-obj-type AT ROW 5.75 COL 18.75 COLON-ALIGNED NO-LABEL WIDGET-ID 258
     2555        f-weight AT ROW 5.75 COL 107 RIGHT-ALIGNED WIDGET-ID 294
     2556        produced_Date AT ROW 6.75 COL 82 RIGHT-ALIGNED WIDGET-ID 262
     2557        emission_Date AT ROW 7.83 COL 82 RIGHT-ALIGNED WIDGET-ID 264
     2558        Btn_dateOther AT ROW 8.92 COL 89 WIDGET-ID 292
     2559        expire_Date AT ROW 8.96 COL 88 RIGHT-ALIGNED WIDGET-ID 290
     2560        online-check AT ROW 9.96 COL 22.38 WIDGET-ID 274
     2561        f-online-result AT ROW 10.04 COL 67 COLON-ALIGNED NO-LABEL WIDGET-ID 278
     2562        f-rn AT ROW 11.25 COL 10.63 COLON-ALIGNED WIDGET-ID 246
     2563        Btn_rn AT ROW 11.25 COL 34.25 WIDGET-ID 250
     2564        f-unit AT ROW 11.25 COL 81.25 COLON-ALIGNED WIDGET-ID 226
     2565        f-unit-2 AT ROW 11.25 COL 107.25 RIGHT-ALIGNED WIDGET-ID 254
     2566        br-mark AT ROW 12.25 COL 3.38 WIDGET-ID 200
     2567        f-loc-key AT ROW 25.21 COL 21 COLON-ALIGNED WIDGET-ID 260
     2568        f-pn AT ROW 25.21 COL 81 COLON-ALIGNED WIDGET-ID 244
     2569        Btn_pn AT ROW 25.5 COL 104.75 WIDGET-ID 68
     2570        "Результат online-проверки ГИС МТ:" VIEW-AS TEXT
     2571             SIZE 36 BY .63 AT ROW 10.25 COL 35 WIDGET-ID 288
     2572        "Статус:" VIEW-AS TEXT
     2573             SIZE 8 BY .63 AT ROW 3.75 COL 4.38 WIDGET-ID 272
     2574        SPACE(83.24) SKIP(15.44)
     2575       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2576            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2577            TITLE "Движение марки":L.
     2578   ASSIGN
     2579          FRAME d-mark:SCROLLABLE       = FALSE.
     2580   ON value-changed OF br-mark IN FRAME d-mark
     2581   DO:
     2582       run enable_mark .
     2583     END .
     2584   ON CHOOSE OF Btn_dateOther IN FRAME d-mark
     2585   DO:
     2586      define variable kk as integer no-undo .
     2587      define variable dateOther as character no-undo .
     2588      define variable dateOtherMes as character no-undo .
     2589      do kk = 1 to num-entries(expire_DateOther):
     2590          dateOtherMes = entry(1,entry(kk,expire_DateOther),".") .
     2591          dateOtherMes = replace(dateOtherMes,"/",".") .
     2592          if kk = 1 then dateOther = " " + dateOtherMes .
     2593          else dateOther = dateOther + chr(10) + dateOtherMes .
     2594      end.
     2595   message dateOther
     2596   view-as alert-box title "Иные условия хранения".
     2597   END.
     2598   ON value-changed OF f-status IN FRAME d-mark
     2599   DO:
     2600      assign
     2601        f-status
     2602      .
     2603   END .
     2604   ON value-changed OF f-online-result IN FRAME d-mark
     2605   DO:
     2606      assign
     2607        f-online-result
     2608      .
     2609   END .
     2610   ON CHOOSE OF Btn_pn IN FRAME d-mark
     2611   DO:
     2612   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2613   if lookup(self :type
     2614            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2615            ) = 0
     2616   then do:
     2617     message
     2618       "$Workfile$"
     2619       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2620       "Интерфейсный элемент" self :name  skip
     2621       "Тип" self :type  skip
     2622       "Процедура" this-procedure :file-name skip
     2623       view-as alert-box .
     2624   end.
     2625   else do:
     2626     apply "entry":u to self  .
     2627     if focus :handle <> self :handle  then do:
     2628       return no-apply .
     2629     end.
     2630   end.
     2631   run show-in-code in this-procedure .
     2632   END.
     2633   ON CHOOSE OF b-exit IN FRAME d-mark
     2634   DO:
     2635     define buffer b_marking for ub.marking.
     2636     define buffer buf_marking-attr for ub.marking-attr.
     2637     if available buf_marking then
     2638     do:
     2639       if online-check:sensitive then
     2640       do:
     2641           assign online-check.
     2642           find first buf_marking-attr where
     2643                      buf_marking-attr.attr-code = "notOnlineCheck"
     2644                  and buf_marking-attr.mark begins buf_marking.mark
     2645                exclusive-lock no-error.
     2646           if (available buf_marking-attr and buf_marking-attr.attr-value <> string(online-check))
     2647              or (not available buf_marking-attr and online-check) then
     2648           do:
     2649             if available buf_marking-attr and not online-check then
     2650             do:
     2651               delete buf_marking-attr.
     2652             end.
     2653             else do:
     2654               if not available buf_marking-attr then
     2655               do:
     2656                 create buf_marking-attr.
     2657                 assign
     2658                   buf_marking-attr.mark = buf_marking.mark
     2659                   buf_marking-attr.attr-code = "notOnlineCheck"
     2660                 .
     2661               end.
     2662               buf_marking-attr.attr-value = string(online-check).
     2663             end.
     2664           end.
     2665       end.
     2666       if buf_marking.sts <> f-status then do:
     2667         message "У марки был изменен статус.~nСохранить?" view-as alert-box question buttons yes-no
     2668           update isSave as logical.
     2669         if isSave then do:
     2670           find first b_marking where rowid(b_marking) = rowid(buf_marking) exclusive-lock.
     2671           assign
     2672             b_marking.sts = f-status
     2673             b_marking.last-change = now
     2674           .
     2675         end.
     2676       end.
     2677       if buf_marking.online-result <> (if f-online-result = -1 then ? else f-online-result) then do:
     2678         message "У марки был изменен результат online-проверки ГИС МТ.~nСохранить?" view-as alert-box question buttons yes-no
     2679           update isSaveResult as logical.
     2680         if isSaveResult then do:
     2681           find first b_marking where rowid(b_marking) = rowid(buf_marking) exclusive-lock.
     2682           assign
     2683             b_marking.online-result = if f-online-result = -1 then ? else f-online-result
     2684           .
     2685         end.
     2686       end.
     2687     end.
     2688   END.
     2689   ON CHOOSE OF Btn_rn IN FRAME d-mark
     2690   DO:
     2691   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2692   if lookup(self :type
     2693            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2694            ) = 0
     2695   then do:
     2696     message
     2697       "$Workfile$"
     2698       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2699       "Интерфейсный элемент" self :name  skip
     2700       "Тип" self :type  skip
     2701       "Процедура" this-procedure :file-name skip
     2702       view-as alert-box .
     2703   end.
     2704   else do:
     2705     apply "entry":u to self  .
     2706     if focus :handle <> self :handle  then do:
     2707       return no-apply .
     2708     end.
     2709   end.
     2710   if X_marking-line.type <> 1  then do:
     2711   run show-out-code in this-procedure .
     2712   end.
     2713   else do:
     2714           run str/upd_browse.w (input parparentproc,
     2715           input x_marking-line.doc-id,
     2716           input x_marking-line.db-num,
     2717           input x_marking-line.EDocType,
     2718           input 'ПРОСМОТР':U,
     2719           input ?
     2720           ) no-error .
     2721   end.
     2722   END.
     2723   ON return OF v-mark IN FRAME d-mark
     2724   DO:
     2725       define variable v_list as character no-undo .
     2726       define variable ii     as integer   no-undo.
     2727       assign
     2728         v-mark = v-mark:screen-value .
     2729       ASSIGN
     2730         v_list = 'Ё,Й,Ц,У,К,Е,Н,Г,Ш,Щ,З,Х,Ъ,Ф,Ы,В,А,П,Р,О,Л,Д,Ж,Э,Я,Ч,С,М,И,Т,Ь,Б,Ю':U .
     2731       do ii = 1 to length (v-mark):
     2732         if LOOKUP( SUBSTRING( v-mark, ii, 1 ), v_list )  > 1 then
     2733         do:
     2734           message "Не корректно считана акцизная марка, перед считыванием переключите клавиатуру на английскую раскладку."
     2735             view-as alert-box.
     2736           v-mark:screen-value = "" .
     2737           v-mark = "" .
     2738           return .
     2739         end.
     2740       end.
     2741       run init-temp .
     2742       run enable_mark .
     2743       v-mark:screen-value = "" .
     2744       v-mark = "" .
     2745       display
     2746         with frame d-mark .
     2747     END.
     2748   ON CHOOSE OF B-hist IN FRAME d-mark
     2749   DO:
     2750     DEFINE VARIABLE v-rid-list AS CHARACTER NO-undo.
     2751     IF available buf_marking THEN DO:
     2752       run ref/cmarking.w (
     2753                 buf_marking.mark,
     2754                 parparentproc,
     2755                 0,
     2756                 "",
     2757                 0,
     2758                 "",
     2759                 "one",
     2760                 ?,
     2761                 "",
     2762                 "" ,
     2763                 v-cntxt-db-num,
     2764                 ?,
     2765                 input-output v-rid-list ) .
     2766     END.
     2767   END.
     2768   ON CHOOSE OF b-sostav IN FRAME d-mark
     2769   DO:
     2770     define buffer bf_marking for ub.marking.
     2771     if v-mark-2 = "" then return no-apply.
     2772     if can-find(first bf_marking where bf_marking.mark-parent begins v-mark-2)
     2773     then do:
     2774         empty temp-table tt-marking-lines.
     2775         for first bf_marking no-lock where
     2776                   bf_marking.mark begins v-mark-2:
     2777           create tt-marking-lines .
     2778           assign
     2779             tt-marking-lines.gds-name    = GdsName(bf_marking.gds-code)
     2780             tt-marking-lines.mark        = bf_marking.mark
     2781             tt-marking-lines.gds-code    = bf_marking.gds-code
     2782             tt-marking-lines.isMark      = IsMark(tt-marking-lines.mark)
     2783             tt-marking-lines.sts         = bf_marking.sts
     2784             tt-marking-lines.unit        = bf_marking.unit
     2785             tt-marking-lines.unit-ext    = bf_marking.unit-ext
     2786             tt-marking-lines.box-qnty    = bf_marking.box-qnty  when tt-marking-lines.box-qnty eq 0 or tt-marking-lines.box-qnty eq ?
     2787             tt-marking-lines.mark-parent = bf_marking.mark-parent
     2788             tt-marking-lines.stts        = Marking:GetLabel(bf_marking.sts)
     2789             tt-marking-lines.doc-level   = 1
     2790           .
     2791         end.
     2792         for each bf_marking no-lock where
     2793                   bf_marking.mark-parent begins v-mark-2:
     2794           create tt-marking-lines .
     2795           assign
     2796             tt-marking-lines.gds-name    = GdsName(bf_marking.gds-code)
     2797             tt-marking-lines.mark        = bf_marking.mark
     2798             tt-marking-lines.gds-code    = bf_marking.gds-code
     2799             tt-marking-lines.isMark      = IsMark(tt-marking-lines.mark)
     2800             tt-marking-lines.sts         = bf_marking.sts
     2801             tt-marking-lines.unit        = bf_marking.unit
     2802             tt-marking-lines.unit-ext    = bf_marking.unit-ext
     2803             tt-marking-lines.box-qnty    = bf_marking.box-qnty  when tt-marking-lines.box-qnty eq 0 or tt-marking-lines.box-qnty eq ?
     2804             tt-marking-lines.mark-parent = bf_marking.mark-parent
     2805             tt-marking-lines.stts        = Marking:GetLabel(bf_marking.sts)
     2806             tt-marking-lines.doc-level   = 2
     2807           .
     2808         end.
     2809         if available (tt-marking-lines) then
     2810         do:
     2811           run str/mark_browse.w (input parparentproc,
     2812              input-output table tt-marking-lines by-reference,
     2813              input 'ПРОСМОТР':U,
     2814              input "Состав марки " + v-mark-2,
     2815              input 0,
     2816              input ""
     2817              ) no-error .
     2818         end.
     2819     end.
     2820   END.
     2821   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-mark:PARENT eq ?
     2822     THEN FRAME d-mark:PARENT = ACTIVE-WINDOW.
     2823   ON WINDOW-CLOSE OF FRAME d-mark
     2824     APPLY "END-ERROR":U TO SELF.
     2825   MAIN-BLOCK:
     2826   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2827     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2828   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2829     run mainmenu_getcntxt in parparentproc
     2830       (output v-cntxt-db-num
     2831       ,output v-cntxt-userid
     2832       ,output v-cntxt-level
     2833       ,output v-cntxt-host-code-obj
     2834       ,output v-cntxt-obj-type
     2835       ,output v-cntxt-obj-code
     2836       ,output v-cntxt-db-num-obj
     2837       ,output v-cntxt-is-admin
     2838       ) .
     2839     Marking = ObjSrv:Env:Marking:Sts:Mark. .
     2840     if p-mark <> "" then v-mark = p-mark .
     2841     run LoadKeyboardLayoutA (input v-mark, input 0, output iLang).
     2842         run adm/shattri.p (
     2843                  input "get":U
     2844                  ,input  v-cntxt-obj-type
     2845                  ,input  v-cntxt-obj-code
     2846                  ,input  'marking':U
     2847                  ,input  'rus-key':U
     2848                  ,output p-value-character
     2849                  ,output p-value-date
     2850                  ,output p-value-decimal
     2851                  ,output p-value-integer
     2852                  ,output p-value-logical
     2853                  ,output p-param-type
     2854                  ,input-output table-handle v-tth
     2855                  ) no-error .
     2856         IF p-value-logical = yes THEN  iLang = 68748313.
     2857     run ActivateKeyboardLayout (input iLang, input 0).
     2858   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2859   do:
     2860     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2861       (input  v-cntxt-db-num
     2862       ,input  v-cntxt-userid
     2863       ,input  0
     2864       ,input  'actn_mark_stchange':U
     2865       ,input  'firm':U
     2866       ,input  v-cntxt-host-code-obj
     2867       ,input  '':U
     2868       ,input  0
     2869       ,input  0
     2870       ,input  0
     2871       ,input  0
     2872       ,input  false
     2873       ,output canEditStatus
     2874       )  .
     2875   end.
     2876   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2877   do:
     2878     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2879       (input  v-cntxt-db-num
     2880       ,input  v-cntxt-userid
     2881       ,input  0
     2882       ,input  'actn_mark_online_check':U
     2883       ,input  'global':U
     2884       ,input  0
     2885       ,input  '':U
     2886       ,input  0
     2887       ,input  0
     2888       ,input  0
     2889       ,input  0
     2890       ,input  false
     2891       ,output canEditOnlineCheck
     2892       )  .
     2893   end.
     2894     run init-status in this-procedure .
     2895     run init-temp in this-procedure .
     2896     run enable_UI in this-procedure .
     2897     run enable_mark in this-procedure .
     2898     apply "entry" to v-mark in FRAME d-mark.
     2899     if p-mark <> "" then WAIT-FOR GO OF FRAME d-mark focus br-mark.
     2900     else WAIT-FOR GO OF FRAME d-mark FOCUS v-mark.
     2901   END.
     2902   run disable_UI in this-procedure .
     2903   PROCEDURE disable_UI :
     2904     HIDE FRAME d-mark.
     2905   END PROCEDURE.
     2906   PROCEDURE enable_mark :
     2907     display
     2908       f-last-change
     2909       f-gds-code
     2910       f-obj-code
     2911       f-obj-type
     2912       f-gds-name
     2913       f-unit
     2914       f-unit-2
     2915       f-GTIN
     2916       v-mark-2
     2917       f-loc-key
     2918       mrc
     2919       f-weight
     2920       produced_Date
     2921       emission_Date
     2922       expire_Date
     2923       with frame d-mark .
     2924     hide online-check in frame d-mark .
     2925     if expire_DateOther <> "" and expire_DateOther <> ? then enable Btn_dateOther with frame d-mark .
     2926     else disable Btn_dateOther with frame d-mark .
     2927     if available (buf_marking) then do:
     2928       display f-status f-online-result with frame d-mark .
     2929       if canEditStatus then
     2930         enable f-status with frame d-mark .
     2931       if canEditOnlineCheck then
     2932         enable f-online-result with frame d-mark .
     2933     end.
     2934     else do:
     2935       hide f-status f-online-result in frame d-mark .
     2936     end.
     2937     if available (buf_marking) and buf_marking.sts = Marking:MarkError:KeyIntDB then do:
     2938       f-status:fgcolor in frame d-mark = 12.
     2939     end.
     2940     if available (X_marking-line) then
     2941     do:
     2942       f-pn = X_marking-line.in-code .
     2943       f-rn = X_marking-line.out-code .
     2944       display
     2945         f-pn
     2946         f-rn
     2947         with frame d-mark .
     2948       if f-pn <> "" and f-pn <> 'free-zone':U and f-pn <> 'out-zone':U then
     2949       do:
     2950         display
     2951           f-pn
     2952           with frame d-mark .
     2953         enable
     2954           Btn_pn
     2955           with frame d-mark .
     2956       end.
     2957       if f-rn <> "" and f-rn <> 'free-zone':U and f-rn <> 'out-zone':U then
     2958       do:
     2959         display
     2960           f-rn
     2961           with frame d-mark .
     2962         enable
     2963           Btn_rn
     2964           with frame d-mark .
     2965       end.
     2966       end.
     2967   END PROCEDURE.
     2968   PROCEDURE enable_UI :
     2969     ENABLE
     2970       br-mark
     2971       b-exit
     2972       b-hist
     2973       b-sostav
     2974       WITH FRAME d-mark.
     2975     hide B-1 in frame d-mark .
     2976     if p-mark <> "" then
     2977     do:
     2978       hide
     2979         v-mark
     2980         in FRAME d-mark .
     2981     end.
     2982     else
     2983     do:
     2984       enable
     2985         v-mark
     2986         WITH FRAME d-mark .
     2987     end.
     2988     if f-pn <> "" and f-pn <> 'free-zone':U and f-pn <> 'out-zone':U then
     2989     do:
     2990       display
     2991         f-pn
     2992         with frame d-mark .
     2993       enable
     2994         Btn_pn
     2995         with frame d-mark .
     2996     end.
     2997     if f-rn <> "" and f-rn <> 'free-zone':U and f-rn <> 'out-zone':U then
     2998     do:
     2999       display
     3000         f-rn
     3001         with frame d-mark .
     3002       enable
     3003         Btn_rn
     3004         with frame d-mark .
     3005     end.
     3006     display
     3007       f-gds-name
     3008       f-obj-code
     3009       f-obj-type
     3010       f-gds-code
     3011       f-unit
     3012       f-unit-2
     3013       f-GTIN
     3014       v-mark-2
     3015       f-loc-key
     3016       with frame d-mark .
     3017     hide f-status f-online-result in frame d-mark .
     3018   END PROCEDURE.
     3019   PROCEDURE init-status :
     3020     define variable vi as integer no-undo.
     3021     define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     3022     define variable objMark  as ibs.th.gbl.propmap no-undo.
     3023     do with frame d-mark:
     3024       MarkType = ObjSrv:Env:Marking:Sts:Mark:MAPTYPE.
     3025       do vi = 1 to MarkType:GetItemByLab(vi):
     3026         objMark  = ObjSrv:Env:Marking:Sts:Mark:CurrProp.
     3027         f-status:add-last(objMark:Label_, objMark:KeyIntDB).
     3028       end.
     3029     end.
     3030   END PROCEDURE.
     3031   PROCEDURE init-temp :
     3032     release buf_marking.
     3033     empty temp-table X_marking-line.
     3034     assign
     3035         f-GTIN = ""
     3036         f-gds-code = ""
     3037         f-gds-name = ""
     3038         f-status = 0
     3039         f-last-change = ?
     3040         f-unit     = ""
     3041         f-unit-2   = ""
     3042         f-obj-code = ?
     3043         f-obj-type = ""
     3044         v-mark-2 = ""
     3045         f-loc-key = ""
     3046         f-pn = ""
     3047         f-rn = ""
     3048         mrc  = ""
     3049         f-weight = ""
     3050         emission_Date = ""
     3051         produced_Date = ""
     3052         f-online-result = -1
     3053         online-check  = no
     3054         .
     3055     if v-mark <> "" then
     3056     do:
     3057     v-marking = GetCodeIdent(v-mark) .
     3058     v-mark-2   = v-marking .
     3059     if v-marking <> "" and v-marking <> ? then do:
     3060       find first buf_marking no-lock where buf_marking.mark begins v-marking
     3061       no-error .
     3062       if available (buf_marking) then
     3063       do:
     3064            assign
     3065              f-status = buf_marking.sts
     3066              f-online-result = if buf_marking.online-result = ? then -1 else buf_marking.online-result
     3067              f-last-change = buf_marking.last-change
     3068              f-gds-code = string(buf_marking.gds-code)
     3069              f-gds-name = GdsName(buf_marking.gds-code)
     3070              f-unit     = buf_marking.unit-ext
     3071              f-GTIN     = buf_marking.gds-ext-id
     3072              f-unit-2   = buf_marking.unit
     3073              f-obj-code = buf_marking.obj-code
     3074              f-obj-type = buf_marking.obj-type
     3075              f-loc-key = buf_marking.loc-key
     3076              expire_Date = entry(1,buf_marking.expDate,".")
     3077              expire_Date = replace(expire_Date,"/",".")
     3078              expire_DateOther = buf_marking.expDateOther
     3079              .
     3080            for first buf_marking-attr no-lock where buf_marking-attr.attr-code = "MRC"
     3081                                                 and buf_marking-attr.mark = buf_marking.mark:
     3082               mrc = buf_marking-attr.attr-value .
     3083            end.
     3084            for first buf_marking-attr no-lock where buf_marking-attr.attr-code = "emissionDate"
     3085                                                 and buf_marking-attr.mark = buf_marking.mark:
     3086               emission_Date = buf_marking-attr.attr-value .
     3087            end.
     3088            for first buf_marking-attr no-lock where buf_marking-attr.attr-code = "producedDate"
     3089                                                 and buf_marking-attr.mark = buf_marking.mark:
     3090               produced_Date = buf_marking-attr.attr-value .
     3091            end.
     3092            for first buf_marking-attr no-lock where buf_marking-attr.attr-code = "weight"
     3093                                                 and buf_marking-attr.mark = buf_marking.mark:
     3094               f-weight = if decimal(buf_marking-attr.attr-value) < 1 and  decimal(buf_marking-attr.attr-value) >= 0
     3095                             then string(decimal(buf_marking-attr.attr-value),"9.999")
     3096                             else buf_marking-attr.attr-value.
     3097               f-weight = substitute("&1 &2",f-weight, GdsUnit(buf_marking.gds-code)).
     3098            end.
     3099            for each buf_marking-lines no-lock where buf_marking-lines.mark begins v-marking:
     3100               create X_marking-line .
     3101               buffer-copy buf_marking-lines to X_marking-line .
     3102               X_marking-line.gds-code = buf_marking.gds-code .
     3103               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = if buf_marking-lines.out-code <> 'out-zone':U
     3104                                                and buf_marking-lines.out-code <> 'free-zone':U then buf_marking-lines.out-code else buf_marking-lines.in-code
     3105                  no-error .
     3106               if available (buf_trn-doc) then do:
     3107                   X_marking-line.date_ = buf_trn-doc.doc-date .
     3108                   X_marking-line.doc-type = func-get-name-from-ext-type(buf_trn-doc.ext-doc-type,no) .
     3109                   if X_marking-line.fact-order = 0 then X_marking-line.fact-order = 1 .
     3110               end.
     3111            end.
     3112            for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.mark begins v-marking:
     3113               for first buf_utd no-lock where buf_utd.doc-id = buf_utd-marking-lines.doc-id
     3114                                           and buf_utd.db-num = buf_utd-marking-lines.db-num:
     3115                   create X_marking-line .
     3116                   assign
     3117                     X_marking-line.doc-type    = EdoTypeName(buf_utd.EDocType)
     3118                     X_marking-line.mark        = buf_marking.mark
     3119                     X_marking-line.out-code    = buf_utd.DocumentNumber
     3120                     X_marking-line.date_       = buf_utd.DocumentDate
     3121                     X_marking-line.sts         = buf_utd-marking-lines.sts
     3122                     X_marking-line.type        = 1
     3123                     X_marking-line.obj-code    = buf_utd.obj-code
     3124                     X_marking-line.obj-type    = buf_utd.obj-type
     3125                     X_marking-line.doc-id      = buf_utd.doc-id
     3126                     X_marking-line.db-num      = buf_utd.db-num
     3127                     X_marking-line.EdocType    = buf_utd.EdocType
     3128                   .
     3129               end.
     3130            end.
     3131       end.
     3132       else do:
     3133         assign
     3134            f-GTIN = getGtinByDM(v-mark)
     3135            f-gds-code = string(getGdsCodeByGtin(f-GTIN))
     3136            f-gds-name = GdsName(integer(f-gds-code))
     3137            .
     3138       end.
     3139     end.
     3140     end.
     3141     OPEN QUERY br-mark FOR EACH X_marking-line NO-LOCK by X_marking-line.fact-order desc by X_marking-line.date_ desc INDEXED-REPOSITION.
     3142   END PROCEDURE.
     3143   PROCEDURE show-in-code :
     3144     for first ub.marking-lines no-lock where ub.marking-lines.mark = buf_marking.mark,
     3145       first ub.goods no-lock where ub.goods.gds-code = ub.marking-lines.gds-code:
     3146       run str/showdoc.p
     3147         (input parparentproc
     3148         ,input f-pn
     3149         ,input ub.goods.artic
     3150         ,input ub.goods.prod-type
     3151         ,input ub.goods.prod-code
     3152         ,input true
     3153         ).
     3154     end.
     3155     apply "entry":u to br-mark in frame d-mark.
     3156   END PROCEDURE.
     3157   PROCEDURE show-out-code :
     3158     for first ub.marking-lines no-lock where ub.marking-lines.mark = buf_marking.mark,
     3159       first ub.goods no-lock where ub.goods.gds-code = ub.marking-lines.gds-code:
     3160       run str/showdoc.p
     3161         (input parparentproc
     3162         ,input f-rn
     3163         ,input ub.goods.artic
     3164         ,input ub.goods.prod-type
     3165         ,input ub.goods.prod-code
     3166         ,input true
     3167         ).
     3168       apply "entry":u to br-mark in frame d-mark.
     3169     end.
     3170   END PROCEDURE.
     3171   FUNCTION GdsName RETURNS CHARACTER
     3172     ( input p-gds-code as integer ) :
     3173     define buffer buf_goods for ub.goods .
     3174     define variable v-gds-name as character no-undo .
     3175     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     3176     if available (buf_goods) then v-gds-name = buf_goods.gds-name .
     3177     RETURN v-gds-name.
     3178   END FUNCTION.
     3179   FUNCTION GdsUnit RETURNS CHARACTER
     3180     ( input p-gds-code as integer ) :
     3181     define buffer buf_goods for ub.goods .
     3182     define variable v-gds-unit as character no-undo .
     3183     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     3184     if available (buf_goods) then v-gds-unit = buf_goods.unit-base .
     3185     RETURN v-gds-unit.
     3186   END FUNCTION.
     3187   FUNCTION StatusName RETURNS CHARACTER
     3188     ( input p-sts as integer ) :
     3189     Return Marking:GetLabel(p-sts) .
     3190   END FUNCTION.
     3191   ON ENTRY OF v-mark IN FRAME d-mark
     3192   DO:
     3193               run LoadKeyboardLayoutA (input v-mark, input 0, output iLang).
     3194               run adm/shattri.p (
     3195                  input "get":U
     3196                  ,input  v-cntxt-obj-type
     3197                  ,input  v-cntxt-obj-code
     3198                  ,input  'marking':U
     3199                  ,input  'rus-key':U
     3200                  ,output p-value-character
     3201                  ,output p-value-date
     3202                  ,output p-value-decimal
     3203                  ,output p-value-integer
     3204                  ,output p-value-logical
     3205                  ,output p-param-type
     3206                  ,input-output table-handle v-tth
     3207                  ) no-error .
     3208               IF p-value-logical = yes THEN  iLang = 68748313.
     3209               run ActivateKeyboardLayout (input iLang, input 0).
     3210           END.
     3211   procedure LoadKeyboardLayoutA external "user32" :
     3212       define input  parameter P1 as char.
     3213       define input  parameter P2 as LONG.
