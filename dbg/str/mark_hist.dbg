      544   define  stream PrnLibStream.
      545   procedure prn-lib-prn-file :
      546     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      547     define input parameter p-DIsabledoptions as integer no-undo .
      548     define variable v-report-name as character no-undo .
      549     define variable v-user-action as character no-undo .
      550     define variable v-printed     as logical   no-undo .
      551     define variable v-exist       as logical   no-undo .
      552     do
      553       on error undo, return error
      554       :
