      309   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   procedure cur-time :
      311      define output parameter p-today as date      no-undo .
      312      define output parameter p-time  as integer   no-undo .
      313     do
      314     on error undo, return error
      315     :
      316       define variable v-date1 as date      no-undo .
      317       define variable v-date2 as date      no-undo .
      318       define variable v-time  as integer   no-undo .
      319       assign
      320         v-date1 = today
      321         v-time  = time
      322         v-date2 = today
      323       .
      324       if v-date1 <> v-date2
      325       then do:
      326         assign
      327           v-date1 = today
      328           v-time  = v-time
      329         .
      330       end.
      331       assign
      332         p-today = v-date1
      333         p-time  = v-time
      334       .
      335     end.
      336   end.
      337   function cur-time-date returns character
      338   :
      339     return string(today, '99/99/9999':U) .
      340   end.
      341   function cur-time-mjd returns decimal
      342   :
      343     define variable v-date as date      no-undo .
      344     define variable v-time as integer   no-undo .
      345     run cur-time in this-procedure
      346       (output v-date
      347       ,output v-time
      348       ) .
      349     return integer(v-date) - 2400002 + (v-time / 86400) .
      350   end.
      351   function cur-time-get-ending-index returns integer
      352   (input p-number as integer
      353   )
      354   :
      355     if p-number < 0
      356     or p-number = ?
      357     then do:
      358       return 1 .
      359     end.
      360     define variable v-rest as integer   no-undo .
      361     assign
      362       p-number = p-number modulo 100
      363     .
      364     if p-number < 20
      365     then do:
      366       assign
      367         v-rest = p-number
      368       .
      369     end.
      370     else do:
      371       assign
      372         v-rest = p-number modulo 10
      373       .
      374     end.
      375     case v-rest :
      376       when 1
      377       then do:
      378         return 2 .
      379       end.
      380       when 2 or
      381       when 3 or
      382       when 4
      383       then do:
      384         return 3 .
      385       end.
      386       otherwise do:
      387         return 1 .
      388       end.
      389     end case .
      390   end.
      391   procedure cur-time-mjd-to-date :
      392      define input  parameter i-mjd-diff as decimal no-undo.
      393      define output parameter o-Date     as date    no-undo.
      394      define output parameter o-Time     as integer no-undo.
      395      define variable v-day-number as integer   no-undo .
      396      if    i-mjd-diff < 0
      397         or i-mjd-diff = ?
      398      then do:
      399         return "?" .
      400      end.
      401      assign
      402         v-day-number = truncate(i-mjd-diff,0).
      403         o-Date = date(v-day-number + 2400002).
      404         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      405     .
      406   end.
      407   function cur-time-mjd-to-string returns character
      408   (input p-mjd-diff as decimal
      409   )
      410   :
      411     define variable v-day-number as integer   no-undo .
      412     define variable v-seconds    as integer   no-undo .
      413     define variable v-hour       as integer   no-undo .
      414     define variable v-min        as integer   no-undo .
      415     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      416     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      417     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      418     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      419     if p-mjd-diff < 0
      420     or p-mjd-diff = ?
      421     then do:
      422       return "?" .
      423     end.
      424     assign
      425       v-day-number = integer(truncate(p-mjd-diff,0))
      426       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      427     .
      428     if v-seconds > 86400
      429     then do:
      430       assign
      431         v-seconds = 86400 - 1
      432       .
      433     end.
      434     if v-seconds < 0
      435     then do:
      436       assign
      437         v-seconds = 0
      438       .
      439     end.
      440     assign
      441       v-hour = truncate(v-seconds / 3600, 0)
      442     .
      443     assign
      444       v-seconds = v-seconds modulo 3600
      445     .
      446     assign
      447       v-min = truncate(v-seconds / 60, 0)
      448     .
      449     assign
      450       v-seconds = v-seconds modulo 60
      451     .
      452     return
      453         (if v-day-number <> 0
      454           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      455           else ""
      456         )
      457       + (if v-day-number <> 0 or v-hour <> 0
      458           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      459           else ""
      460         )
      461       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      462           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      463           else ""
      464         )
      465       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      466       .
      467   end.
      468   function cur-time-string returns character
      469   :
      470     define variable v-date as date      no-undo .
      471     define variable v-time as integer   no-undo .
      472     run cur-time in this-procedure
      473       (output v-date
      474       ,output v-time
      475       ) .
      476     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      477   end.
      478   function cur-time-string-sec returns character
      479   :
      480     define variable v-date as date      no-undo .
      481     define variable v-time as integer   no-undo .
      482     run cur-time in this-procedure
      483       (output v-date
      484       ,output v-time
      485       ) .
      486     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      487   end.
      488   function cur-time-custom  returns character
      489   (input p-prefix as character
      490   ,input p-date-format as character
      491   ,input p-delimiter as character
      492   ,input p-time-format as character
      493   ,input p-suffix as character
      494   )
      495   :
      496     define variable v-date as date      no-undo .
      497     define variable v-time as integer   no-undo .
      498     run cur-time in this-procedure
      499       (output v-date
      500       ,output v-time
      501       ) .
      502     return
      503       p-prefix
      504       + string(v-date, p-date-format)
      505       + p-delimiter
      506       + string(v-time, p-time-format)
      507       + p-suffix
      508       .
      509   end.
      510   function cur-time-print  returns character
      511   :
      512     define variable v-date as date      no-undo .
      513     define variable v-time as integer   no-undo .
      514     run cur-time in this-procedure
      515       (output v-date
      516       ,output v-time
      517       ) .
      518     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      519   end.
      520   function cur-time-datetime returns datetime
      521   :
      522     define variable v-char as character no-undo .
      523     define variable v-datetime as datetime no-undo .
      524     v-char = cur-time-string().
      525     v-datetime = datetime(v-char).
      526     return  v-datetime.
      527   end.
      528   function cur-time-string-msec returns character
      529   :
      530     define variable v-date as datetime  no-undo .
      531     v-date = now.
      532     return string(v-date) .
      533   end.
