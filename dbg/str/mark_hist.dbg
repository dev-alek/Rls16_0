     1118   procedure xmlchar-test :
     1119   define input parameter p-in-string          as character        no-undo.
     1120   define output parameter p-out-string-enc    as character        no-undo.
     1121   define output parameter p-out-string-dec    as character        no-undo.
     1122   do
     1123   on error undo, return error
     1124   :
     1125          run xmlchar-encode in this-procedure
     1126       (
     1127             input p-in-string
     1128           , output p-out-string-enc
     1129       ).
     1130          run xmlchar-decode in this-procedure
     1131       (
     1132             input p-out-string-enc
     1133           , output p-out-string-dec
     1134       ).
     1135   end.
     1136   end .
     1137   procedure xmlchar-encode :
     1138   define input parameter p-in-string      as character        no-undo.
     1139   define output parameter p-out-string    as character        no-undo.
     1140       define variable v-position      as integer      no-undo.
     1141       define variable v-current-char  as character    no-undo.
     1142   do
     1143   on error undo, return error
     1144   :
     1145       assign
     1146           p-out-string = "":U
     1147       .
     1148       case p-in-string
     1149       :
     1150           when ?
     1151           then do:
     1152               assign
     1153                   p-out-string = "?":U
     1154               .
     1155           end.
     1156           when "?":U
     1157           then do:
     1158               assign
     1159                   p-out-string = "&#63;":U
     1160               .
     1161           end.
     1162           otherwise do:
     1163               do v-position = 1 to length( p-in-string )
     1164               :
     1165                   assign
     1166                       v-current-char = substring( p-in-string, v-position, 1 )
     1167                   .
     1168                   case v-current-char
     1169                   :
     1170                       when "&":U
     1171                       then do:
     1172                           assign
     1173                               p-out-string = p-out-string + "&amp;":U
     1174                           .
     1175                       end.
     1176                       when ">":U
     1177                       then do:
     1178                           assign
     1179                               p-out-string = p-out-string + "&gt;":U
     1180                           .
     1181                       end.
     1182                       when "<":U
     1183                       then do:
     1184                           assign
     1185                               p-out-string = p-out-string + "&lt;":U
     1186                           .
     1187                       end.
     1188                       when "'":U
     1189                       then do:
     1190                           assign
     1191                               p-out-string = p-out-string + "&apos;":U
     1192                           .
     1193                       end.
     1194                       when '"':U
     1195                       then do:
     1196                           assign
     1197                               p-out-string = p-out-string + "&quot;":U
     1198                           .
     1199                       end.
     1200                       when chr(1)
     1201                       then do:
     1202                           assign
     1203                               p-out-string = p-out-string + "":U
     1204                           .
     1205                       end.
     1206                       when chr(2)
     1207                       then do:
     1208                           assign
     1209                               p-out-string = p-out-string + "":U
     1210                           .
     1211                       end.
     1212                       when chr(3)
     1213                       then do:
     1214                           assign
     1215                               p-out-string = p-out-string + "":U
     1216                           .
     1217                       end.
     1218                       when chr(4)
     1219                       then do:
     1220                           assign
     1221                               p-out-string = p-out-string + "":U
     1222                           .
     1223                       end.
     1224                       when chr(5)
     1225                       then do:
     1226                           assign
     1227                               p-out-string = p-out-string + "":U
     1228                           .
     1229                       end.
     1230                       when chr(6)
     1231                       then do:
     1232                           assign
     1233                               p-out-string = p-out-string + "":U
     1234                           .
     1235                       end.
     1236                       when chr(7)
     1237                       then do:
     1238                           assign
     1239                               p-out-string = p-out-string + "":U
     1240                           .
     1241                       end.
     1242                       when chr(8)
     1243                       then do:
     1244                           assign
     1245                               p-out-string = p-out-string + "":U
     1246                           .
     1247                       end.
     1248                       when chr(9)
     1249                       then do:
     1250                           assign
     1251                               p-out-string = p-out-string + "":U
     1252                           .
     1253                       end.
     1254                       when chr(29)
     1255                       then do:
     1256                           assign
     1257                               p-out-string = p-out-string + "":U
     1258                           .
     1259                       end.
     1260                       when chr(10)
     1261                       then do:
     1262                           assign
     1263                               p-out-string = p-out-string + "&#10;":U
     1264                           .
     1265                       end.
     1266                       when chr(13)
     1267                       then do:
     1268                           assign
     1269                               p-out-string = p-out-string + "&#13;":U
     1270                           .
     1271                       end.
     1272                       otherwise do:
     1273                           assign
     1274                               p-out-string = p-out-string + v-current-char
     1275                           .
     1276                       end.
     1277                   end case.
     1278               end.
     1279           end.
     1280       end case.
     1281   end.
     1282   end .
     1283   procedure xmlchar-encode-1c :
     1284   define input parameter p-in-string      as character        no-undo.
     1285   define output parameter p-out-string    as character        no-undo.
     1286       define variable v-position      as integer      no-undo.
     1287       define variable v-current-char  as character    no-undo.
     1288   do
     1289   on error undo, return error
     1290   :
     1291       assign
     1292           p-out-string = "":U
     1293       .
     1294       case p-in-string
     1295       :
     1296           when ?
     1297           then do:
     1298               assign
     1299                   p-out-string = "?":U
     1300               .
     1301           end.
     1302           otherwise do:
     1303               do v-position = 1 to length( p-in-string )
     1304               :
     1305                   assign
     1306                       v-current-char = substring( p-in-string, v-position, 1 )
     1307                   .
     1308                   case v-current-char
     1309                   :
     1310                       when chr(1)
     1311                       then do:
     1312                           assign
     1313                               p-out-string = p-out-string + " ":U
     1314                           .
     1315                       end.
     1316                       when chr(2)
     1317                       then do:
     1318                           assign
     1319                               p-out-string = p-out-string + " ":U
     1320                           .
     1321                       end.
     1322                       when chr(3)
     1323                       then do:
     1324                           assign
     1325                               p-out-string = p-out-string + " ":U
     1326                           .
     1327                       end.
     1328                       when chr(4)
     1329                       then do:
     1330                           assign
     1331                               p-out-string = p-out-string + " ":U
     1332                           .
     1333                       end.
     1334                       when chr(5)
     1335                       then do:
     1336                           assign
     1337                               p-out-string = p-out-string + " ":U
     1338                           .
     1339                       end.
     1340                       when chr(6)
     1341                       then do:
     1342                           assign
     1343                               p-out-string = p-out-string + " ":U
     1344                           .
     1345                       end.
     1346                       when chr(7)
     1347                       then do:
     1348                           assign
     1349                               p-out-string = p-out-string + " ":U
     1350                           .
     1351                       end.
     1352                       when chr(8)
     1353                       then do:
     1354                           assign
     1355                               p-out-string = p-out-string + " ":U
     1356                           .
     1357                       end.
     1358                       when chr(9)
     1359                       then do:
     1360                           assign
     1361                               p-out-string = p-out-string + " ":U
     1362                           .
     1363                       end.
     1364                       when chr(29)
     1365                       then do:
     1366                           assign
     1367                               p-out-string = p-out-string + " ":U
     1368                           .
     1369                       end.
     1370                       when chr(10)
     1371                       then do:
     1372                           assign
     1373                               p-out-string = p-out-string + " ":U
     1374                           .
     1375                       end.
     1376                       when chr(13)
     1377                       then do:
     1378                           assign
     1379                               p-out-string = p-out-string + " ":U
     1380                           .
     1381                       end.
     1382                       otherwise do:
     1383                           assign
     1384                               p-out-string = p-out-string + v-current-char
     1385                           .
     1386                       end.
     1387                   end case.
     1388               end.
     1389           end.
     1390       end case.
     1391   end.
     1392   end .
     1393   procedure xmlchar-decode :
     1394   define input parameter p-in-string      as character        no-undo.
     1395   define output parameter p-out-string    as character        no-undo.
     1396       define variable v-position      as integer      no-undo.
     1397       define variable v-last-position as integer      no-undo.
     1398       define variable v-temp-integer  as integer      no-undo.
     1399       define variable v-current-char  as character    no-undo.
     1400       define variable v-next-char     as character    no-undo.
     1401       define variable v-success       as logical      no-undo.
     1402   do
     1403   on error undo, return error
     1404   :
     1405       assign
     1406           p-out-string = "":U
     1407           v-position   = 0
     1408       .
     1409       replace-cycle:
     1410       do while yes
     1411       on error undo, return error
     1412       :
     1413           assign
     1414               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1415           .
     1416           if v-last-position <= v-position
     1417           then do:
     1418               if v-position = 0
     1419               then do:
     1420                   assign
     1421                       p-out-string = p-in-string
     1422                   .
     1423               end.
     1424               else do:
     1425                   assign
     1426                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1427                   .
     1428               end.
     1429               leave replace-cycle.
     1430           end.
     1431           else do:
     1432               assign
     1433                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1434                   v-position      = v-last-position
     1435                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1436               .
     1437               if v-current-char = "#":U
     1438               then do:
     1439                   assign
     1440                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1441                   .
     1442                   if v-last-position > 0
     1443                   then do:
     1444                       run xmlchar-read-integer in this-procedure
     1445                        (
     1446                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1447                           , output v-temp-integer
     1448                           , output v-success
     1449                       ).
     1450                       if v-success = yes
     1451                       and v-temp-integer >= 1
     1452                       and v-temp-integer <= 255
     1453                       then do:
     1454                           assign
     1455                               p-out-string = p-out-string + chr( v-temp-integer )
     1456                               v-position   = v-last-position + 1
     1457                           .
     1458                       end.
     1459                       else do:
     1460                           assign
     1461                               p-out-string = p-out-string + "&":U
     1462                               v-position   = v-position   + 1
     1463                           .
     1464                       end.
     1465                   end.
     1466                   else do:
     1467                       assign
     1468                           p-out-string = p-out-string + "&":U
     1469                           v-position   = v-position   + 1
     1470                       .
     1471                   end.
     1472               end.
     1473               else do:
     1474                   case substring( p-in-string, v-position + 1, 3 )
     1475                   :
     1476                       when "lt;":U
     1477                       then do:
     1478                           assign
     1479                               p-out-string = p-out-string + "<":U
     1480                               v-position   = v-position   + 3
     1481                           .
     1482                       end.
     1483                       when "gt;":U
     1484                       then do:
     1485                           assign
     1486                               p-out-string = p-out-string + ">":U
     1487                               v-position   = v-position   + 3
     1488                           .
     1489                       end.
     1490                       otherwise do:
     1491                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1492                           then do:
     1493                               assign
     1494                                   p-out-string = p-out-string + "&":U
     1495                                   v-position   = v-position   + 4
     1496                               .
     1497                           end.
     1498                           else do:
     1499                               case substring( p-in-string, v-position + 1, 5 )
     1500                               :
     1501                                   when "quot;":U
     1502                                   then do:
     1503                                       assign
     1504                                           p-out-string = p-out-string + '"':U
     1505                                           v-position   = v-position   + 5
     1506                                       .
     1507                                   end.
     1508                                   when "apos;":U
     1509                                   then do:
     1510                                       assign
     1511                                           p-out-string = p-out-string + "'":U
     1512                                           v-position   = v-position   + 5
     1513                                       .
     1514                                   end.
     1515                                   otherwise do:
     1516                                       assign
     1517                                           p-out-string = p-out-string + "&":U
     1518                                       .
     1519                                   end.
     1520                               end case.
     1521                           end.
     1522                       end.
     1523                   end case.
     1524               end.
     1525           end.
     1526       end.
     1527   end.
     1528   end .
     1529   procedure xmlchar-read-integer :
     1530   define input parameter p-input-string      as character        no-undo.
     1531   define output parameter p-output-integer   as integer          no-undo.
     1532   define output parameter p-success       as logical          no-undo.
     1533   do
     1534   on error undo, return error
     1535   :
     1536       assign
     1537           p-output-integer = integer( p-input-string )
     1538       no-error.
     1539       if error-status :error
     1540       then do:
     1541           assign
     1542               p-success           = no
     1543               p-output-integer    = 0
     1544           .
     1545       end.
     1546       else do:
     1547           assign
     1548               p-success           = yes
     1549           .
     1550       end.
     1551   end.
     1552   end.
     1553   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1554   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1555   define new global shared variable g#attr-lib  as handle no-undo .
     1556   define variable v-attr-lib-variable as handle no-undo .
     1557   define variable mMRCCode  as logical    no-undo.
     1558   define variable mTypeMark as character  no-undo.
     1559   function IS-NeedMark returns logical
     1560   ( input ib-code as integer  ,
     1561     input ib-str as character ):
     1562      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1563      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1564                                    and buf_prod-bc-attr.b-str  eq ib-str
     1565                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1566        no-lock no-error.
     1567      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1568   end.
     1569   function repTegforDm return char
     1570   (iDM as char ):
     1571       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1572       define variable vteg as character no-undo.
     1573       define variable oDM as character no-undo.
     1574       define variable vi as integer no-undo.
     1575       oDM = iDm.
     1576       do vi = 1 to num-entries(vTeglist):
     1577          vTeg = entry(vi,vTeglist).
     1578          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1579       end.
     1580       return oDM.
     1581   end.
     1582   function repSpecSimbforDm return char
     1583   (iDM as char ):
     1584       define variable oDM as character no-undo.
     1585     run
     1586       xmlchar-decode(iDM, output oDM).
     1587     return repTegforDm (oDM).
     1588   end.
     1589   function CheckGtin return logical
     1590   (iGtin as char):
     1591      define variable bar_code as character no-undo.
     1592      define variable vGtin as logical no-undo init "yes".
     1593      if length(iGtin) eq 14
     1594      then do:
     1595         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1596         run str/chk-sum.p
     1597          (input-output bar_code ) no-error .
     1598         if iGtin ne  bar_code
     1599         then
     1600            vGtin = no.
     1601      end.
     1602      else
     1603         vGtin = no.
     1604      return vgtin.
     1605   end.
     1606   function repSpecSimbforXlm return char
     1607   (iDM as char ):
     1608       iDM = replace(iDM,chr(29),"").
     1609       return iDM.
     1610   end.
     1611   function getGtinByDM return char
     1612   (IDM as char):
     1613      define variable VTXT as char no-undo.
     1614      define variable vGtin as char no-undo.
     1615      vTXt = IdM.
     1616      vGtin = IDM.
     1617      if    length(vtxt) > 14
     1618      then do:
     1619         if   vtxt begins "(01)"
     1620                or vtxt begins "(02)"
     1621         then
     1622            vGtin = substring(vtxt,5,14).
     1623         else if   (vtxt begins "01"
     1624                or vtxt begins "02" )
     1625                and (   (    substring(iDm,17,2) eq "21"
     1626                         and length(vtxt) >= 21)
     1627                     or substring(iDm,17,2) eq "37"
     1628                     or substring(iDm,17,4) eq "(37)" )
     1629         then do:
     1630            vGtin = substring(vtxt,3,14).
     1631            if not checkGtin(vGtin)
     1632            then
     1633               vGtin = substring(vtxt,1,14).
     1634         end.
     1635         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1636             or length(vtxt) eq 14 + 7 + 4
     1637             or length(vtxt) eq 14 + 7
     1638         then
     1639            vGtin = substring(vtxt,1,14).
     1640      end.
     1641      if not checkGtin(vGtin)
     1642      then
     1643         vGtin = "".
     1644      return vgtin.
     1645   end.
     1646   function getGdsCodeByGtin return int
     1647   (iGtin as char):
     1648      define buffer prod-bc  for ub.prod-bc.
     1649      define buffer bar-code for ub.bar-code.
     1650      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1651      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1652      return if avail bar-code then bar-code.gds-code else ?.
     1653   end.
     1654   function getQntyCodeByGtin return decimal
     1655   (iGtin as char):
     1656      define buffer prod-bc  for ub.prod-bc.
     1657      define buffer bar-code for ub.bar-code.
     1658      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1659      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1660      return if avail bar-code then bar-code.cli-base-rate else ?.
     1661   end.
     1662   function getGdsCodeByDM return int
     1663   (iDm as char):
     1664      define variable vGtin as char no-undo.
     1665      define buffer prod-bc for ub.prod-bc.
     1666      vGtin  = getGtinByDM (IDM ).
     1667      return getGdsCodeByGtin (vGtin).
     1668   end.
     1669   function ChekTypeMarkByGds return logical
     1670   (iGds-code as integer ):
     1671      define buffer goods-attr for ub.goods-attr.
     1672      find first goods-attr where goods-attr.gds-code   = iGds-code
     1673                              and goods-attr.attr-code  = 'mark-type':U
     1674      no-lock no-error.
     1675      if available goods-attr
     1676      then do:
     1677         mTypeMark = goods-attr.attr-value.
     1678         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1679           .
     1680      end.
     1681      else
     1682         return no.
     1683   end.
     1684   function ChekTypeMarkByDm return logical
     1685   (iDM as char ):
     1686      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1687   end.
     1688   function ChekTypeMarkByGtin return logical
     1689   (iGtin as char ):
     1690      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1691   end.
     1692   function GetNextElement return character
     1693     (input iAllTeg        as logical
     1694     ,output oteg          as character
     1695     ,output otegval       as character
     1696     ,input-output pstr    as character
     1697      ):
     1698        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1699        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1700        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1701        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1702        define variable vTeg as character no-undo.
     1703        define variable vLength as integer no-undo.
     1704        define variable vi as integer no-undo.
     1705        define variable vj as integer no-undo.
     1706        define buffer code for ub.code.
     1707        find first code where Code.parent eq "MarkType"
     1708                          and Code.CodeValue   eq mTypeMark
     1709                          no-lock no-error.
     1710        if     available code
     1711           and Code.misc1 ne ""
     1712           and Code.misc1 ne ?
     1713        then do:
     1714           integer (Code.misc1) no-error.
     1715           if not error-status:error
     1716           then
     1717             entry (4,vlistleng) = Code.misc1.
     1718        end.
     1719        if iAllTeg
     1720        then
     1721           assign
     1722              vlistElem     = vlistElem    + vlistElemDop
     1723              vlistleng     = vlistleng    + vlistlengDop
     1724           .
     1725        else if mMRCCode
     1726        then
     1727           assign
     1728              vlistElem     = vlistElem    + ",(8005),8005"
     1729              vlistleng     = vlistleng    + ",000006,0006"
     1730           .
     1731       block-elem:
     1732       do vi = 1 to num-entries(vlistElem):
     1733          vTeg = entry(vi,vlistElem).
     1734          if pstr begins vTeg
     1735          then do:
     1736             if    vTeg eq "21"
     1737             then
     1738                vLength = index(pstr,chr(29)) - 2 no-error.
     1739             if vLength  <= 0
     1740             then
     1741                vLength = int(entry(vi,vlistleng)).
     1742             otegval = substring (pstr,length(vteg) + 1, vLength).
     1743             oteg = replace(replace(vteg,")",""),"(","").
     1744             vTeg = vteg + otegval.
     1745             otegval = replace(otegval,chr(29),"").
     1746             oteg = replace(replace(oteg,")",""),"(","").
     1747             pstr = substring (pstr,length(vTeg)+ 1).
     1748             vTeg = replace(vTeg,chr(29),"").
     1749             leave block-elem.
     1750          end.
     1751          else
     1752             vTeg = "".
     1753       end.
     1754       return vteg.
     1755   end.
     1756   function GetCodeIdent return character
     1757   (iDm as char):
     1758      define variable Velement   as character no-undo init "first".
     1759      define variable oCodeIdent as character no-undo.
     1760      define variable vteg as character no-undo.
     1761      define variable vtegval as character no-undo.
     1762      define variable vGtin as character no-undo.
     1763      define buffer marking for ub.marking.
     1764      for first marking no-lock where
     1765                marking.mark eq iDm
     1766            and marking.unit-ext = "LEVEL2"
     1767      :
     1768        return iDm.
     1769      end.
     1770      vGtin  = getGtinByDM (iDm ).
     1771      ChekTypeMarkByDm(idm).
     1772      if iDm begins 'tech_':U
     1773      then
     1774         oCodeIdent = iDm.
     1775      else if length(iDm) < 21
     1776      then do:
     1777         find first marking where marking.mark eq idm
     1778         no-lock no-error.
     1779         oCodeIdent = if available marking then marking.mark else  ?.
     1780      end.
     1781      else if     length(iDm) eq 29
     1782         and not iDm begins "01"
     1783         and not iDm begins "02"
     1784      then
     1785         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1786      else  if     length(iDm) >= 24
     1787               and (  iDm begins "01"
     1788                   or iDm begins "02")
     1789               and  substring(iDm,17,2) ne "21"
     1790      then do:
     1791         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1792                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1793         then
     1794            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1795         else
     1796            oCodeIdent = iDM.
     1797      end.
     1798      else  if     (   length(iDm) eq 25
     1799                    or length(iDm) eq 21)
     1800               and (not iDm begins "01"
     1801               and  not iDm begins "02")
     1802      then
     1803         oCodeIdent = substring(iDm,1,21).
     1804      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1805      then
     1806         oCodeIdent = substring(iDm,1,21).
     1807      else do while Velement ne "" and idm ne "":
     1808         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1809         oCodeIdent = oCodeIdent + Velement.
     1810      end.
     1811      return oCodeIdent.
     1812   end.
     1813   function GetTegCod return character
     1814   (icodeIdent as char, iTeg as char):
     1815      define variable Velement   as character no-undo init "first".
     1816      define variable oTeg as character no-undo init ?.
     1817      define variable vteg as character no-undo.
     1818      define variable vtegval as character no-undo.
     1819      if     ((length(icodeIdent) eq 21
     1820         and not icodeIdent begins "01"
     1821         and not icodeIdent begins "02")
     1822         or
     1823             ( length(icodeIdent) eq 25
     1824               and not icodeIdent begins "01"
     1825               and not icodeIdent begins "02"))
     1826      then do:
     1827         if iTeg eq "01" or iTeg eq "02"
     1828         then
     1829            oTeg = substring(icodeIdent,1,21).
     1830         else  if  iTeg eq "21"
     1831         then
     1832            oTeg = substring(icodeIdent,15,7).
     1833      end.
     1834      else do:
     1835         ChekTypeMarkByDm(icodeIdent).
     1836         block-teg:
     1837            do while Velement ne "" and icodeIdent ne "":
     1838            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1839            if    Velement begins iTeg
     1840               or Velement begins "(" + iTeg + ")"
     1841            then do:
     1842               oTeg = vtegval.
     1843               leave block-teg.
     1844            end.
     1845         end.
     1846      end.
     1847      return oTeg.
     1848   end.
     1849   function isOAD return logical
     1850   (icodeIdent as character):
     1851      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1852   end.
     1853   function isMark return logical
     1854   (icodeIdent as character):
     1855      define buffer buf_marking for ub.marking.
     1856      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1857             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1858   end.
     1859   function addBracketForCode return character
     1860   (icodeIdent as char):
     1861      define variable Velement   as character no-undo init "first".
     1862      define variable oTeg as character no-undo.
     1863      define variable vteg as character no-undo.
     1864      define variable vtegval as character no-undo.
     1865      define buffer marking for ub.marking.
     1866      find first marking no-lock where
     1867                 marking.mark begins icodeIdent no-error.
     1868      if    not ChekTypeMarkByDm(icodeIdent)
     1869         or length(icodeIdent) le 24
     1870         or (avail marking and marking.unit-ext = "LEVEL2")
     1871      then
     1872         oTeg = icodeIdent.
     1873      else do:
     1874         if (  icodeIdent begins "01"
     1875            or icodeIdent begins "02"
     1876            ) and CheckGtin(substring (icodeIdent,3,14))
     1877            and substring (icodeIdent,17,2) eq "21"
     1878         then do:
     1879            mMRCCode = yes.
     1880            ChekTypeMarkByDm(icodeIdent).
     1881            block-teg:
     1882            do while Velement ne "" and icodeIdent ne "":
     1883               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1884               if vteg ne ""
     1885               then
     1886                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1887            end.
     1888            mMRCCode = no.
     1889         end.
     1890         else do:
     1891            oTeg = icodeIdent.
     1892         end.
     1893      end.
     1894      return oTeg.
     1895   end.
     1896   function getlevelByCodId return int
     1897   (iCode as char):
     1898      define variable vLength as int no-undo.
     1899      define variable vLevel  as int no-undo.
     1900      if not ChekTypeMarkByDM (icode) then return ?.
     1901      vLength = length(iCode).
     1902      if    vLength eq 18
     1903         or vLength eq 20
     1904      then
     1905         Vlevel = 4.
     1906      else if vLength eq 21
     1907      then
     1908         Vlevel = 1.
     1909      else if vLength eq 25
     1910      then do:
     1911         if  iCode begins "01"
     1912         then
     1913            Vlevel = 3.
     1914         else
     1915            Vlevel = 1.
     1916      end.
     1917      else if     vLength >= 26
     1918              and vLength <= 46
     1919      then do:
     1920         if    substring(iCode,17,2) eq "11"
     1921            or substring(iCode,17,2) eq "13"
     1922            or (    substring(iCode,17,2) eq "21"
     1923                and vLength >= 33
     1924                and substring(iCode,26,4) ne "8005")
     1925         then
     1926            Vlevel = 4.
     1927         else if    vLength eq 31
     1928                 or vLength eq 38
     1929                 or vLength eq 39
     1930                 or vLength eq 45
     1931         then
     1932            Vlevel = 1.
     1933         else if    vLength eq 35
     1934                 or vLength eq 43
     1935         then
     1936            Vlevel = 3.
     1937         else
     1938            Vlevel = ?.
     1939      end.
     1940      else
     1941         Vlevel = ?.
     1942      return Vlevel.
     1943   end.
     1944   function getLevelMotpBycodid return character
     1945   (iDm as char):
     1946      define variable vLevel as integer no-undo.
     1947      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1948      vLevel = getlevelByCodId(iDm).
     1949      if    vLevel eq ?
     1950         or vLevel < 1
     1951         or vLevel > 6
     1952      then
     1953         return ?.
     1954      else
     1955         return entry(vlevel,vList).
     1956   end.
     1957   function getLevelUTDByLevelMotp return character
     1958   (iUnit as char):
     1959      define variable vLevel as integer no-undo.
     1960      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1961      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1962      vLevel = lookup(iUnit,vListMOTP).
     1963      if    vLevel eq ?
     1964         or vLevel < 1
     1965         or vLevel > 4
     1966      then
     1967         return ?.
     1968      else
     1969         return entry(vlevel,vListutd).
     1970   end.
     1971   function getLevelMotpByDM return character
     1972   (iDm as char):
     1973      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1974   end.
     1975   function getLevelUTDByCodId return character
     1976   (iDm as char):
     1977      define variable vLevel as integer no-undo.
     1978      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1979      vLevel = getlevelByCodId(iDm).
     1980      if    vLevel eq ?
     1981         or vLevel < 1
     1982         or vLevel > 4
     1983      then
     1984         return ?.
     1985      else
     1986         return entry(vlevel,vList).
     1987   end.
     1988   function getLevelUTDByDM return character
     1989   (iDm as char):
     1990      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1991   end.
     1992   define variable mNotMarkQnty as logical no-undo.
     1993   function getQntyUTDByCodId return decimal
     1994   (iDM as char):
     1995      define variable vLevel as integer no-undo.
     1996      define variable vList as character no-undo init "1,5,10,500".
     1997      define variable vGtin as character no-undo.
     1998      define variable vqnty as decimal no-undo init ?.
     1999      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2000      if vqnty eq ?
     2001      then do:
     2002         if not mNotMarkQnty
     2003         then do:
     2004            define buffer marking for ub.marking.
     2005            define variable vCodident as character no-undo.
     2006            vCodident = GetCodeIdent(idm).
     2007            find first marking where marking.mark begins vCodident no-lock no-error.
     2008            if     available marking
     2009               and marking.box-qnty ne ?
     2010            then
     2011               return marking.box-qnty.
     2012         end.
     2013         vGtin = getGtinByDm(iDM).
     2014         if ChekTypeMarkByGtin (vGtin)
     2015         then do:
     2016            vLevel = getlevelByCodId(iDM).
     2017            if     vLevel >= 1
     2018               and vLevel <= 4
     2019            then
     2020               vqnty = int(entry(vlevel,vList)).
     2021         end.
     2022         else
     2023            vqnty = getQntyCodeByGtin(vgtin).
     2024      end.
     2025      return vqnty.
     2026   end.
     2027   function getQntyUTDByDM return decimal
     2028   (iDm as char):
     2029      define variable vDM as character no-undo.
     2030      if     length (iDm) ne 25
     2031         and length (iDm) ne 29
     2032         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2033      then
     2034         vDM = substring (iDm,1,length (iDm) - 6 ).
     2035      else
     2036         vDM = substring (iDm,1,length (iDm) - 4 ).
     2037      return getQntyUTDByCodId(vDM).
     2038   end.
     2039   function getMRC4 return decimal
     2040   (iMRC as char):
     2041      define variable oMrc     as decimal no-undo init ?.
     2042      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2043      define variable vi       as integer no-undo.
     2044      define variable vfound   as integer no-undo.
     2045      define variable vposStart   as integer no-undo.
     2046      do:
     2047      OMRc = 0.
     2048      do vi = 1 to 4:
     2049         define variable vsimb as character no-undo.
     2050         vsimb = substring(iMRC,vi,1).
     2051         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2052         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2053         if vfound > 0
     2054         then
     2055            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2056         end.
     2057         OMRc = OMRc / 100.
     2058      end.
     2059      return OMRc.
     2060   end.
     2061   function getMRCByDM return decimal
     2062   (iDm as char):
     2063      define variable vMRC     as character no-undo.
     2064      define variable oMrc     as decimal no-undo init ?.
     2065      define variable Velement as character no-undo init "empty".
     2066      define variable vteg as character no-undo.
     2067      define variable vtegval as character no-undo.
     2068      if    length(idm) eq 14 + 7 + 4 + 4
     2069         or length(idm) eq 14 + 7 + 4
     2070      then do:
     2071         vMRC = substring(idm,22,4).
     2072         omrc = getMRC4(vMRC).
     2073      end.
     2074      else do:
     2075          ChekTypeMarkByDm(iDm).
     2076          block-mrc:
     2077          do while Velement ne "" and idm ne "":
     2078             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2079             if Velement begins "8005"
     2080             then do:
     2081                vMRC = substring(Velement,5,6).
     2082                leave block-mrc.
     2083             end.
     2084             else if Velement begins "(8005)"
     2085             then do:
     2086                vMRC = substring(Velement,7,6).
     2087                leave block-mrc.
     2088             end.
     2089          end.
     2090          if vMRC ne ""
     2091          then
     2092             OMRc = dec(vmrc) / 100 no-error.
     2093      end.
     2094      return OMRc.
     2095   end.
     2096   function MoveDate return Date
     2097   (idate as date,
     2098    iMonth as int64):
     2099      define variable vMonth   as int64 no-undo.
     2100      define variable vYear    as int64 no-undo.
     2101      define variable vDateNew as date  no-undo.
     2102       define variable vDay     as int64 no-undo.
     2103       vMonth = month(iDate) + iMonth.
     2104       vYear =  year(iDate).
     2105       if vMonth <= 0
     2106       then assign
     2107          vMonth = vMonth + 12
     2108           vYear  = vYear - 1
     2109       .
     2110       else if vMonth > 12
     2111       then assign
     2112          vMonth = vMonth - 12
     2113           vYear  = vYear + 1
     2114       .
     2115       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2116       do while error-status:error eq yes:
     2117          VDay = vDay + 1.
     2118          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2119       end.
     2120       if VDay > 0
     2121       then
     2122          vDateNew + 1.
     2123       return vDateNew.
     2124   end.
     2125   procedure checkEMRC:
     2126   define input  parameter iDm as character no-undo.
     2127   define output parameter vok as logical   no-undo init yes.
     2128      define variable v-value-emrc as character no-undo.
     2129      define variable v-type-emrc  as character no-undo.
     2130      define variable vDateIso     as character no-undo.
     2131      define variable vMRC         as decimal no-undo.
     2132      define variable vqnty        as decimal no-undo.
     2133      define variable vPrice       as decimal no-undo.
     2134      define variable vparent      as character no-undo.
     2135      define variable vgds-code    as integer no-undo.
     2136      define buffer code for ub.code.
     2137      vMRC = getMRCByDM(iDm).
     2138      if vMRC > 0
     2139      then do:
     2140         vgds-code = getGdsCodeByDM(iDm).
     2141         vqnty     = getQntyUTDByDM(iDm).
     2142               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2143            (
     2144             input   vgds-code
     2145            ,input   'emrc-type':U
     2146            ,output   v-value-emrc
     2147            ,output   v-type-emrc
     2148          ) no-error.
     2149          if     v-value-emrc ne ""
     2150             and v-value-emrc ne ?
     2151          then do:
     2152             vDateIso = iso-date(today).
     2153             vPrice = vMRC / vqnty.
     2154             vparent ="emc" + chr(4) + v-value-emrc.
     2155             find last code where Code.parent      eq vparent
     2156                              and Code.code        le vDateIso
     2157                              and code.status_  eq 0
     2158             no-lock no-error.
     2159             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2160             then
     2161                vOk = true .
     2162             else do:
     2163                 define variable vText      as character no-undo.
     2164                 define variable vDate      as date no-undo.
     2165                 define variable vDateLast  as character no-undo.
     2166                 define variable vDateFirst as character no-undo.
     2167                 define variable vDate3     as date no-undo.
     2168                 vdate = date(code.misc1).
     2169                 vDateLast = code.misc1.
     2170                 vDate3 = MoveDate(today, - 3 ).
     2171                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2172                                      string(vDate3  , "99/99/9999"),
     2173                                      string(vDate   , "99/99/9999")
     2174                                      ).
     2175                 vdateIso = iso-date(vdate3).
     2176                 find last code  where Code.parent      eq vparent
     2177                                   and Code.code        le vDateIso
     2178                                   and code.status_  eq 0 no-lock no-error.
     2179                 if available code
     2180                 then
     2181                    vDateIso = code.code.
     2182                 vDateFirst = vDateIso.
     2183                 vDateLast = iso-date(vdate).
     2184                 define variable vGood as logical no-undo.
     2185                 define variable vDateSale as date no-undo.
     2186                 define buffer bcode for code.
     2187                 for last code where Code.parent   eq vparent
     2188                                 and code.status_  eq 0
     2189                                 and code.code     < vDateLast
     2190                                 and code.code     >= vDateFirst
     2191                 no-lock:
     2192                    find first bcode where bCode.parent   eq vparent
     2193                                       and bcode.status_  eq 0
     2194                                       and bcode.code     > code.code no-lock no-error.
     2195                    if available bcode
     2196                    then do:
     2197                       if vPrice < dec(Code.CodeValue)
     2198                       then
     2199                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2200                                                     chr(10),
     2201                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2202                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2203                                                     ).
     2204                       else do:
     2205                          vGood = yes.
     2206                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2207                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2208                                                     chr(10),
     2209                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2210                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2211                                                     string(         vDateSale            ,"99/99/9999"),
     2212                                                     string(vDateSale - today)
     2213                                                     ).
     2214                       end.
     2215                    end.
     2216                 end.
     2217                 if vgood
     2218                 then do:
     2219                    define variable choice as integer no-undo .
     2220                    run gbl/d-askw.w (input "Уточнение"
     2221                           ,input  vText
     2222                           ,input "|"
     2223                           ,input "Принять|Вернуть"
     2224                           ,input "Принять данный товар|Вернуть товар постащику"
     2225                           ,input 1
     2226                           ,input 2
     2227                           ,output choice) no-error.
     2228                    vok = choice eq 1.
     2229                 end.
     2230                 else
     2231                    vok =false.
     2232             end.
     2233          end.
     2234      end.
     2235   end.
     2236   function addGs2Mark return character
     2237   (iMark as char):
     2238      define variable vDM   as character no-undo.
     2239      define variable vIdx  as integer   no-undo.
     2240      if index(iMark,chr(29),1) > 0
     2241      then return iMark.
     2242      if substring(iMark,26,4) = "8005" then
     2243      do:
     2244        vIdx = index(iMark,"93",26 + 4 + 5).
     2245        if vIdx > 1 then do:
     2246          vDM = substitute("&1&4&2&4&3",
     2247                           substring(iMark,1,25),
     2248                           substring(iMark,26,vIdx - 25 - 1),
     2249                           substring(iMark,vIdx),
     2250                           chr(29)) no-error.
     2251          vIdx = index(vDm,"240",vIdx + 4).
     2252          if vIdx > 0 then
     2253          do:
     2254            vDM = substitute("&1&3&2",
     2255                             substring(vDm,1,vIdx - 1),
     2256                             substring(vDm,vIdx),
     2257                             chr(29)) no-error.
     2258          end.
     2259        end.
     2260        else
     2261          vDM = substitute("&1&3&2",
     2262                           substring(iMark,1,25),
     2263                           substring(iMark,26),
     2264                           chr(29)) no-error.
     2265      end.
     2266      else if substring(iMark,32,2) = "91" then
     2267      do:
     2268        vIdx = index(iMark,"92",32).
     2269        if vIdx > 1 then
     2270          vDM = substitute("&1&4&2&4&3",
     2271                           substring(iMark,1,31),
     2272                           substring(iMark,32,vIdx - 31 - 1),
     2273                           substring(iMark,vIdx),
     2274                           chr(29)) no-error.
     2275        else
     2276          vDM = substitute("&1&3&2",
     2277                           substring(iMark,1,31),
     2278                           substring(iMark,32),
     2279                           chr(29)) no-error.
     2280      end.
     2281      else if substring(iMark,39,2) = "91" then
     2282      do:
     2283        vIdx = index(iMark,"92",38).
     2284        if vIdx > 1 then
     2285          vDM = substitute("&1&4&2&4&3",
     2286                           substring(iMark,1,38),
     2287                           substring(iMark,39,vIdx - 38 - 1),
     2288                           substring(iMark,vIdx),
     2289                           chr(29)) no-error.
     2290        else
     2291          vDM = substitute("&1&3&2",
     2292                           substring(iMark,1,38),
     2293                           substring(iMark,39),
     2294                           chr(29)) no-error.
     2295      end.
     2296      else if substring(iMark,25,2) = "93" then
     2297      do:
     2298        vIdx = index(iMark,"92",25).
     2299        if vIdx > 1 then
     2300          vDM = substitute("&1&4&2&4&3",
     2301                           substring(iMark,1,24),
     2302                           substring(iMark,25,vIdx - 24 - 1),
     2303                           substring(iMark,vIdx),
     2304                           chr(29)) no-error.
     2305        else
     2306          vIdx = index(iMark,"3103",25).
     2307          if vIdx > 0 then
     2308          vDM = substitute("&1&4&2&4&3",
     2309                           substring(iMark,1,24),
     2310                           substring(iMark,25,vIdx - 24 - 1),
     2311                           substring(iMark,vIdx),
     2312                           chr(29)) no-error.
     2313          else
     2314            vDM = substitute("&1&3&2",
     2315                             substring(iMark,1,24),
     2316                             substring(iMark,25),
     2317                             chr(29)) no-error.
     2318      end.
     2319      else if substring(iMark,32,2) = "93" then
     2320      do:
     2321        vDM = substitute("&1&3&2",
     2322              substring(iMark,1,31),
     2323              substring(iMark,32),
     2324              chr(29)) no-error.
     2325      end.
     2326      return if vDM <> "" then vDm else iMark.
     2327   end.
     2328   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2329   function func-get-name-from-ext-type   returns char
     2330     ( p-ext-type as character   ,
     2331       p-caps     as logical ).
     2332   define variable v-ext-name as character no-undo .
     2333   run get-name-from-ext-type in this-procedure (
     2334       input p-ext-type  ,
     2335       input p-caps  ,
     2336       output v-ext-name )
     2337       no-error .
     2338       if error-status :error then do:
     2339          assign
     2340            v-ext-name = p-ext-type
     2341          .
     2342       end.
     2343    return (v-ext-name) .
     2344   end.
     2345   procedure get-name-from-ext-type :
     2346    do
     2347    on error undo, return error return-value
     2348    :
     2349   define input  parameter p-ext-type as character no-undo .
     2350   define input  parameter p-caps     as logical no-undo   .
     2351   define output parameter p-ext-name as character no-undo .
     2352   define variable v-num as integer no-undo .
     2353     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     2354       message
     2355         vss-include-info11 skip
     2356         "Неправильно задано значение входящего параметра! "
     2357         "Нет такого типа документов " p-ext-type
     2358         view-as alert-box error .
     2359         undo, return error .
     2360     end.
     2361     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     2362     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     2363     if p-caps  = true then do :
     2364        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     2365     end .
     2366     end.
     2367   end procedure.
