      121   define temp-table userobjs_temp-user-obj no-undo
      122     field obj-type as character
      123     field obj-code as integer
      124     index xpk is primary unique obj-type obj-code
      125     .
      126   procedure userobjs_clear :
      127     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      128     do
      129     on error undo, return error return-value
      130     :
      131       for each buf_userobjs_temp-user-obj
      132       on error undo, return error return-value
      133       :
      134         delete buf_userobjs_temp-user-obj .
      135       end.
      136     end.
      137   end .
      138   procedure userobjs_object-count :
      139     define output parameter p-total-count as integer   no-undo .
      140     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      141     do
      142     on error undo, return error return-value
      143     :
      144       assign
      145         p-total-count = 0
      146       .
      147       for each buf_userobjs_temp-user-obj
      148       on error undo, return error return-value
      149       :
      150         assign
      151           p-total-count = p-total-count + 1
      152         .
      153       end.
      154     end.
      155   end.
      156   procedure userobjs_append :
      157      define input  parameter p-obj-type as character no-undo .
      158      define input  parameter p-obj-code as integer   no-undo .
      159     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      160     do
      161     on error undo, return error return-value
      162     :
      163       find first buf_userobjs_temp-user-obj
      164         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      165           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      166         no-error .
      167       if not available buf_userobjs_temp-user-obj
      168       then do:
      169         create buf_userobjs_temp-user-obj .
      170         assign
      171           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      172           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      173         .
      174       end.
      175     end.
      176   end.
      177   procedure userobjs_object-exist :
      178     define output parameter p-object-exist as logical   no-undo .
      179     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      180     do
      181     on error undo, return error return-value
      182     :
      183       find first buf_userobjs_temp-user-obj
      184         no-error .
      185       if not available buf_userobjs_temp-user-obj
      186       then do:
      187         assign
      188           p-object-exist = false
      189         .
      190       end.
      191       else do:
      192         assign
      193           p-object-exist = true
      194         .
      195       end.
      196     end.
      197   end.
      198   procedure userobjs_transfer :
      199     define input  parameter p-callback-handle as handle no-undo .
      200     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      201     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      202     do
      203     on error undo, return error return-value
      204     :
      205       if valid-handle(p-callback-handle) <> true
      206       then do:
      207         message
      208           vss-workfile vss-revision vss-description skip
      209           "Ошибка задания входных параметров" skip
      210           "Неизвестный указатель на процедуру" skip
      211           view-as alert-box error .
      212         undo, return error return-value .
      213       end.
      214       if p-callback-handle :get-signature("userobjs_append") = ""
      215       then do:
      216         message
      217           vss-workfile vss-revision vss-description skip
      218           "Ошибка задания входных параметров" skip
      219           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      220                     ,p-callback-handle :file-name
      221                     ) skip
      222           view-as alert-box error .
      223         undo, return error return-value .
      224       end.
      225       for each buf_userobjs_temp-user-obj
      226       on error undo, return error return-value
      227       :
      228         run userobjs_append in p-callback-handle
      229           (input  buf_userobjs_temp-user-obj.obj-type
      230           ,input  buf_userobjs_temp-user-obj.obj-code
      231           ) .
      232       end.
      233     end.
      234   end procedure.
      235   procedure userobjs_select-one :
