      559   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      561     (input  v-report-name
      562     ,input  2
      563     ,output v-exist
      564     )  .
      565       if NOT v-exist then
      566       DO:
      567         Message
      568           "Нет заданий на печать ! "
      569           view-as alert-box .
      570         Return  .
      571       End.
      572       run gbl/prnfilen.w
      573         (input  ""
      574         ,input  p-DisabledOptions
      575         ,input  string(v-report-name )
      576         ,input  7
      577         ,output v-user-action
      578         ,output v-printed
      579         ) .
      580       if v-printed then
      581       do:
      582         return "YES" .
      583       end.
      584       else
      585       do:
      586         return "NO" .
      587       end.
      588     end.
      589   end procedure.
      590   procedure prn-lib-open-stream :
      591     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      592     define input parameter p-page-size    as integer no-undo .
      593     define input parameter p-is-stream    as logical no-undo .
      594     define input parameter p-append       as logical no-undo .
      595     define variable v-report-name as character no-undo .
      596     do
      597       on error undo, return error
      598       :
      599       run prn-lib-get-report-name  in this-procedure (
      600         input parParentProc
      601         ,output v-report-name
      602         ).
      603       if p-is-stream then
      604       do:
      605         if p-append then
      606         do:
      607           output stream PrnLibStream to value( v-report-name )
      608             page-size value(p-page-size) append .
      609         end.
      610         if not p-append then
      611         do:
      612           output stream PrnLibStream to value( v-report-name )
      613             page-size value(p-page-size) .
      614         end.
      615       end.
      616       if not p-is-stream then
      617       do:
      618         if p-append then
      619         do:
      620           output to value( v-report-name )
      621             page-size value(p-page-size) append .
      622         end.
      623         if not p-append then
      624         do:
      625           output to value( v-report-name )
      626             page-size value(p-page-size) .
      627         end.
      628       end.
      629     end.
      630   end procedure.
      631   procedure prn-lib-open-exp :
      632     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      633     define input parameter p-is-stream    as logical no-undo .
      634     define input parameter p-is-append    as logical no-undo .
      635     define output parameter p-ReportFileName as char init "report" no-undo.
      636     define output parameter p-process as logical no-undo .
      637     define variable glog as logical no-undo .
      638     do
      639       on error undo, return error
      640       :
      641       SYSTEM-DIALOG GET-FILE p-ReportFileName
      642         TITLE      "Укажите путь"
      643         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      644         ASK-OVERWRITE
      645         CREATE-TEST-FILE
      646         SAVE-AS
      647         USE-FILENAME
      648         DEFAULT-EXTENSION "txt"
      649         UPDATE glog
      650         .
      651       if not glog then  return.
      652       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      653       if p-is-stream then
      654       do:
      655         if p-is-append then
      656         do:
      657           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      658         end.
      659         else
      660         do:
      661           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      662         end.
      663       end.
      664       else
      665       do:
      666         if p-is-append then
      667         do:
      668           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      669         end.
      670         else
      671         do:
      672           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      673         end.
      674       end.
      675       p-process = yes.
      676     end.
      677   end procedure.
      678   procedure prn-lib-get-report-name :
      679     define input parameter parParentProc  as widget-handle no-undo.
      680     define output parameter p-report-name as character no-undo .
      681     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      682   end procedure.
      683   procedure prn-lib-reportviewer-report-name :
      684     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      685     define input parameter p-report-name-html as character no-undo .
      686     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      687   end procedure.
      688   procedure prn-lib-reportviewer :
      689     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      690     define input parameter p-report-name-html as character no-undo .
      691     define input parameter p-param        as character no-undo .
      692     define variable v-excel           as character no-undo init 'TRUE' .
      693     define variable v-value-character as character no-undo .
      694     define variable v-value-integer   as character no-undo .
      695     define variable v-value-date      as date      no-undo .
      696     define variable v-value-decimal   as decimal   no-undo .
      697     define variable rep-excel         as logical   no-undo .
      698     define variable excel-string      as character no-undo .
      699     define variable v-param-type      as character no-undo .
      700     define variable v-tth             as handle    no-undo .
      701     run adm/shattri.p (
      702       input "get":U
      703       ,input  ""
      704       ,input  0
      705       ,input  'report-glob':U
      706       ,input  'rep-excel':U
      707       ,output v-value-character
      708       ,output v-value-date
      709       ,output v-value-decimal
      710       ,output v-value-integer
      711       ,output rep-excel
      712       ,output v-param-type
      713       ,INPUT-OUTPUT table-handle v-tth
      714       )  .
      715     if rep-excel then v-excel = "TRUE" .
      716     else v-excel = "FALSE" .
      717     if p-param eq ""
      718     then
      719        p-param = "EXCEL:" + v-excel.
      720     else
      721        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      722     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      723   end procedure.
      724   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725   define variable v-waitfram-action01         as character   no-undo .
      726   define variable v-waitfram-action02         as character   no-undo .
      727   define variable v-waitfram-action03         as character   no-undo .
      728   define variable mWaitFramTextBeg            as character   no-undo.
      729   define variable mWaitFramTextEnd            as character   no-undo.
      730   define variable mWaitFramView               as logical     no-undo.
      731   define variable mWaitProcEvent              as logical     no-undo init yes.
      732   define variable mWaitFramInterval           as integer     no-undo init 1 .
      733   define variable mWaitFramStop               as logical     no-undo.
      734   define variable mWaitFramStopUser           as logical     no-undo.
      735   define variable mWaitFramStopTimeOut        as logical     no-undo.
      736   define variable mWaitFramStartProc          as datetime-tz no-undo.
      737   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      738   define button B-WaitFramStop auto-end-key
      739        label "Стоп"
      740        size 10 by 1 tooltip "Остоновить процесс".
      741   define button B-viewProcInfo
      742        label "Информация"
      743        size 15 by 1 tooltip "Информация о процесс".
      744   define frame waitfram
      745     v-waitfram-action01 format "x(72)" no-label skip
      746     v-waitfram-action02 format "x(72)" no-label skip
      747     v-waitfram-action03 format "x(72)" no-label skip
      748     B-viewProcInfo
      749     B-WaitFramStop at row 4 col 30
      750     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      751     .
      752   define new global shared variable mBatchMode as logical no-undo init ?.
      753   define variable mFramBachModHandle as handle no-undo.
      754   mFramBachModHandle = frame waitfram:handle.
      755   define variable mFameOldVis as logical no-undo.
      756   define variable mVisCUrentVin as logical no-undo.
      757   if session:batch-mode
      758   then
      759      mBatchMode = yes.
      760   if mBatchMode = ? then do:
      761     mVisCUrentVin = current-window:visible.
      762     mFameOldVis = mFramBachModHandle:visible.
      763     mFramBachModHandle:visible  = yes.
      764     mBatchMode = mFramBachModHandle:visible ne yes.
      765     mFramBachModHandle:visible = mFameOldVis.
      766     current-window:visible = mVisCUrentVin.
      767   end.
      768    if  log-manager:logfile-name ne ?
      769     then DO:
      770         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      771         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      772         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      773     end.
      774   on choose of B-WaitFramStop in frame waitfram
      775   do:
      776     mWaitFramStop = yes.
      777     mWaitFramStopUser = yes.
      778   end.
      779   function waitfram-check-timeout returns logical():
      780      define variable vtime as int64 no-undo.
      781      if mWaitFramStopTimeOut
      782      then
      783         return yes.
      784      vtime = ( now - mWaitFramStartProc ) / 1000 .
      785      if     mWaitFramTimeOut ne ?
      786         and mWaitFramTimeOut ne 0
      787         and mWaitFramTimeOut lt vtime
      788      then do:
      789         mWaitFramStopTimeOut = yes.
      790      end.
      791      return mWaitFramStopTimeOut.
      792   end.
      793   procedure waitfram-hide :
      794     if not session:batch-mode
      795     then do
      796     on error undo, return error return-value
      797     :
      798       pause 0 before-hide .
      799       if not mBatchMode then
      800         hide frame waitfram .
      801     if     not mWaitFramView
      802        and mWaitProcEvent
      803     then
      804       process events .
      805     end.
      806   end procedure.
      807   procedure waitfram-show :
      808     define input  parameter p-message as character no-undo .
      809     define variable v-left-margin as integer   no-undo .
      810     if not session:batch-mode
      811     then do
      812     on error undo, return error return-value
      813     :
      814       if length(p-message) <= 70 then do:
      815         assign
      816           v-left-margin = integer((70 - length(p-message)) / 2)
      817         .
      818         assign
      819           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      820         .
      821         assign
      822           v-waitfram-action01 = " "
      823           v-waitfram-action02 = " "
      824                                    + fill(" ", v-left-margin)
      825                                    + p-message
      826           v-waitfram-action03 = " "
      827         .
      828       end.
      829       else do:
      830         define variable vRindex1 as integer no-undo.
      831         define variable vRindex2 as integer no-undo.
      832         vRindex1 = r-index(p-message," ",70).
      833         if vRindex1 = 0
      834         then
      835            vRindex1 = 70.
      836         if length(p-message)  <= vRindex1 + 70 then do:
      837           assign
      838             v-waitfram-action01 = " "
      839             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      840             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      841           .
      842         end.
      843         else do:
      844           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      845           if vRindex2 <= vRindex1
      846           then
      847              vRindex2 = vRindex1 + 70.
      848           assign
      849             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      850             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      851             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      852           .
      853         end.
      854       end.
      855       B-viewProcInfo:visible   in frame waitfram = no.
      856       B-viewProcInfo:sensitive in frame waitfram = no.
      857       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      858       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      859       if  (   mWaitFramView
      860          or  mWaitProcEvent)
      861          and not mBatchMode
      862       then
      863          display
      864             v-waitfram-action01 skip
      865             v-waitfram-action02 skip
      866             v-waitfram-action03 skip
      867          with frame waitfram .
      868       if     mWaitFramView
      869          then do:
      870             if     mWaitFramInterval ne ?
      871                and not mBatchMode
      872             then
      873                wait-for go of frame waitfram pause mWaitFramInterval.
      874          end.
      875          else
      876             if     mWaitProcEvent
      877                and not mBatchMode
      878             then
      879                process events .
      880     end.
      881   end procedure.
      882      procedure waitfram-show-this:
      883         define input  parameter iInterval as int64 no-undo.
      884         define variable vtime as int64 no-undo.
      885         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      886         mWaitFramInterval = iInterval.
      887         run waitfram-show (substitute("&1&2 &3&4" ,
      888                                       mWaitFramTextBeg ,
      889                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      890                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      891                                       mWaitFramTextEnd
      892                                      )
      893                           ).
      894      end.
      895      procedure WaitFramRunPause:
      896         define input  parameter iInterval as dec no-undo.
      897         define variable vStart  as datetime-tz no-undo.
      898         define variable vend    as datetime-tz no-undo.
      899         define variable vint as int64 no-undo.
      900         define variable vOk as logical no-undo.
      901         vStart = now.
      902         vend   = vStart.
      903         publish "WaitFramPause" (iInterval,output vOk).
      904         vend   =  now.
      905         vint = vend - vStart.
      906         vint = iInterval - vint / 1000.
      907         if     not mWaitFramStop
      908            and (   vint > 0
      909                 or (    not vOk
      910                     and iInterval eq ?
      911                     )
      912                 )
      913         then
      914            run waitfram-show-this (iInterval).
      915         vend   =  now.
      916         vint = vend - vStart.
      917         vint = iInterval - vint / 1000.
      918         if     not mWaitFramStop
      919            and vint > 0
      920         then do:
      921            run gbl/pause.p (vint * 1000).
      922         end.
      923         if iInterval ne ?
      924         then
      925            publish "WaitFramStop".
      926         waitfram-check-timeout().
      927      end.
      928      procedure WaitFramWaitFor:
      929         define input  parameter iInterval as dec no-undo.
      930         assign
      931            mWaitFramStartProc   = now
      932            mWaitFramStopUser    = no
      933            mWaitFramStopTimeOut = no
      934         .
      935         block-wait:
      936         do while not mWaitFramStop:
      937            run WaitFramRunPause (iInterval).
      938            if  waitfram-check-timeout()
      939            then do:
      940               leave block-wait.
      941            end.
      942         end.
      943         run waitfram-hide.
      944      end.
      945   procedure waitfram-join :
      946     define input  parameter p-line-1  as character no-undo .
      947     define input  parameter p-line-2  as character no-undo .
      948     define input  parameter p-line-3  as character no-undo .
      949     define output parameter p-message as character no-undo .
      950     do
      951     on error undo, return error return-value
      952     :
      953       assign
      954         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      955                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      956                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      957       .
      958     end.
      959   end procedure.
      960   function waitfram-join-function returns character
      961     (input p-line-1 as character
      962     ,input p-line-2 as character
      963     ,input p-line-3 as character
      964     ).
      965     define variable v-message as character no-undo .
      966     run waitfram-join in this-procedure
      967       (input  p-line-1
      968       ,input  p-line-2
      969       ,input  p-line-3
      970       ,output v-message
      971       ) .
      972     return v-message .
      973   end function .
      974   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   FUNCTION mark-string RETURNS CHARACTER
      976     ( input p-recid as recid, input mark-list as character  ) :
      977     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      978   END FUNCTION.
