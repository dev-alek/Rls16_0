        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle as widget-handle    no-undo .
        4   define input parameter p-log-handle     as handle           no-undo.
        5   define input parameter p-doc-code       as character        no-undo.
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo initial "Закрытие плана-меню до статуса разрешен.":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure doc-code:
       74   define input  parameter parmode          as   character           no-undo.
       75   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       76   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       77   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       78   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       79   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       80   define variable vardb-remote     as   logical             no-undo.
       81   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       82   define variable v-delimiter as character no-undo .
       83   do
       84   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       85   :
       86   find first buf_sys-ctrl no-lock .
       87   vardb-remote = buf_sys-ctrl.db-num <> 0 .
       88     CASE parmode:
       89       when "main":u then do:
       90         if vardb-remote then do:
       91           assign
       92             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
       93         end.
       94         else do:
       95           assign
       96             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
       97         end.
       98       end.
       99       when "trio" then do:
      100         assign
      101           pardoc-code = replace (parroot-doc-code, "=", "*").
      102       end.
      103       otherwise do:
      104         assign
      105         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      106         no-error
      107         .
      108         if error-status:error  then do:
      109           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      110                                         ,chr(10)
      111                                         ,parmode
      112                                         ).
      113         end.
      114         if num-entries(parmode) = 1
      115         and parmode <> "chip":U
      116         and parmode <> "chip_s":U
      117         then do:
      118           assign
      119           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      120         end.
      121         else if (lookup("chip":U, parmode) > 0
      122                  or
      123                  lookup("chip_s":U, parmode) > 0) then do:
      124           assign
      125             vartemp-doc-code = parroot-doc-code.
      126           do while true:
      127             if index (vartemp-doc-code , ".") = 0 then
      128               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      129             else
      130               vartemp-doc-code  =
      131               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      132               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      133               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      134             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      135           end.
      136           assign
      137             pardoc-code = vartemp-doc-code.
      138         end.
      139       end.
      140     end CASE.
      141     if pardoc-code = '':U
      142     or (parroot-doc-code <> '':U
      143     and pardoc-code = parroot-doc-code) then do:
      144       undo, return error substitute("Ошибка при генерации номера документа&1"
      145                                     ,chr(10)).
      146     end.
      147   end.
      148   end. // procedure/method
      149   function get-doc-code-int64 returns int64
      150     ( input p-doc-code as character ) :
      151     define variable v-ind              as integer   no-undo .
      152     define variable v-num-entries      as integer   no-undo .
      153     define variable v-doc-code-int64   as int64     no-undo .
      154     define variable v-canonic-doc-code as character no-undo .
      155     assign
      156       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      157       v-canonic-doc-code = p-doc-code
      158     .
      159     do v-ind = 1 to v-num-entries
      160     :
      161       assign
      162         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      163       .
      164     end.
      165     assign
      166       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      167     .
      168     return v-doc-code-int64 .
      169   end. // function/method
      170   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   procedure cur-time :
      172      define output parameter p-today as date      no-undo .
      173      define output parameter p-time  as integer   no-undo .
      174     do
      175     on error undo, return error
      176     :
      177       define variable v-date1 as date      no-undo .
      178       define variable v-date2 as date      no-undo .
      179       define variable v-time  as integer   no-undo .
      180       assign
      181         v-date1 = today
      182         v-time  = time
      183         v-date2 = today
      184       .
      185       if v-date1 <> v-date2
      186       then do:
      187         assign
      188           v-date1 = today
      189           v-time  = v-time
      190         .
      191       end.
      192       assign
      193         p-today = v-date1
      194         p-time  = v-time
      195       .
      196     end.
      197   end.
      198   function cur-time-date returns character
      199   :
      200     return string(today, '99/99/9999':U) .
      201   end.
      202   function cur-time-mjd returns decimal
      203   :
      204     define variable v-date as date      no-undo .
      205     define variable v-time as integer   no-undo .
      206     run cur-time in this-procedure
      207       (output v-date
      208       ,output v-time
      209       ) .
      210     return integer(v-date) - 2400002 + (v-time / 86400) .
      211   end.
      212   function cur-time-get-ending-index returns integer
      213   (input p-number as integer
      214   )
      215   :
      216     if p-number < 0
      217     or p-number = ?
      218     then do:
      219       return 1 .
      220     end.
      221     define variable v-rest as integer   no-undo .
      222     assign
      223       p-number = p-number modulo 100
      224     .
      225     if p-number < 20
      226     then do:
      227       assign
      228         v-rest = p-number
      229       .
      230     end.
      231     else do:
      232       assign
      233         v-rest = p-number modulo 10
      234       .
      235     end.
      236     case v-rest :
      237       when 1
      238       then do:
      239         return 2 .
      240       end.
      241       when 2 or
      242       when 3 or
      243       when 4
      244       then do:
      245         return 3 .
      246       end.
      247       otherwise do:
      248         return 1 .
      249       end.
      250     end case .
      251   end.
      252   procedure cur-time-mjd-to-date :
      253      define input  parameter i-mjd-diff as decimal no-undo.
      254      define output parameter o-Date     as date    no-undo.
      255      define output parameter o-Time     as integer no-undo.
      256      define variable v-day-number as integer   no-undo .
      257      if    i-mjd-diff < 0
      258         or i-mjd-diff = ?
      259      then do:
      260         return "?" .
      261      end.
      262      assign
      263         v-day-number = truncate(i-mjd-diff,0).
      264         o-Date = date(v-day-number + 2400002).
      265         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      266     .
      267   end.
      268   function cur-time-mjd-to-string returns character
      269   (input p-mjd-diff as decimal
      270   )
      271   :
      272     define variable v-day-number as integer   no-undo .
      273     define variable v-seconds    as integer   no-undo .
      274     define variable v-hour       as integer   no-undo .
      275     define variable v-min        as integer   no-undo .
      276     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      277     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      278     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      279     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      280     if p-mjd-diff < 0
      281     or p-mjd-diff = ?
      282     then do:
      283       return "?" .
      284     end.
      285     assign
      286       v-day-number = integer(truncate(p-mjd-diff,0))
      287       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      288     .
      289     if v-seconds > 86400
      290     then do:
      291       assign
      292         v-seconds = 86400 - 1
      293       .
      294     end.
      295     if v-seconds < 0
      296     then do:
      297       assign
      298         v-seconds = 0
      299       .
      300     end.
      301     assign
      302       v-hour = truncate(v-seconds / 3600, 0)
      303     .
      304     assign
      305       v-seconds = v-seconds modulo 3600
      306     .
      307     assign
      308       v-min = truncate(v-seconds / 60, 0)
      309     .
      310     assign
      311       v-seconds = v-seconds modulo 60
      312     .
      313     return
      314         (if v-day-number <> 0
      315           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      316           else ""
      317         )
      318       + (if v-day-number <> 0 or v-hour <> 0
      319           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      320           else ""
      321         )
      322       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      323           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      324           else ""
      325         )
      326       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      327       .
      328   end.
      329   function cur-time-string returns character
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      338   end.
      339   function cur-time-string-sec returns character
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      348   end.
      349   function cur-time-custom  returns character
      350   (input p-prefix as character
      351   ,input p-date-format as character
      352   ,input p-delimiter as character
      353   ,input p-time-format as character
      354   ,input p-suffix as character
      355   )
      356   :
      357     define variable v-date as date      no-undo .
      358     define variable v-time as integer   no-undo .
      359     run cur-time in this-procedure
      360       (output v-date
      361       ,output v-time
      362       ) .
      363     return
      364       p-prefix
      365       + string(v-date, p-date-format)
      366       + p-delimiter
      367       + string(v-time, p-time-format)
      368       + p-suffix
      369       .
      370   end.
      371   function cur-time-print  returns character
      372   :
      373     define variable v-date as date      no-undo .
      374     define variable v-time as integer   no-undo .
      375     run cur-time in this-procedure
      376       (output v-date
      377       ,output v-time
      378       ) .
      379     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      380   end.
      381   function cur-time-datetime returns datetime
      382   :
      383     define variable v-char as character no-undo .
      384     define variable v-datetime as datetime no-undo .
      385     v-char = cur-time-string().
      386     v-datetime = datetime(v-char).
      387     return  v-datetime.
      388   end.
      389   function cur-time-string-msec returns character
      390   :
      391     define variable v-date as datetime  no-undo .
      392     v-date = now.
      393     return string(v-date) .
      394   end.
      395   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396     define variable v-cntxt-db-num        as integer   no-undo .
      397     define variable v-cntxt-userid        as character no-undo .
      398     define variable v-cntxt-level         as character no-undo .
      399     define variable v-cntxt-host-code-obj as integer   no-undo .
      400     define variable v-cntxt-obj-type      as character no-undo .
      401     define variable v-cntxt-obj-code      as integer   no-undo .
      402     define variable v-cntxt-db-num-obj    as integer   no-undo .
      403     define variable v-cntxt-is-admin      as logical   no-undo .
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405       def var log-file-name as char no-undo.
      406       if search('fbr.log') = ?
      407       then do:
      408           assign
      409               log-file-name = ""
      410           .
      411       end.
      412       else do:
      413           assign
      414               log-file-name = 'fbr.log'
      415           .
      416       end.
      417       DEF STREAM stm-log.
      418       PROCEDURE writelog:
      419       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      420       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      421       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      422       if p-file-name <> ""
      423       then do:
      424       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      425           PUT STREAM stm-log UNFORMATTED chr(10).
      426           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      427                                           OR p-log-string = "&Line") THEN "" ELSE
      428                                           cur-time-string-sec() + " ").
      429           PUT STREAM stm-log UNFORMATTED
      430                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      431                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      432                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      433       OUTPUT STREAM stm-log CLOSE.
      434       end.
      435       END PROCEDURE.
      436   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      438   procedure partslib-clear-temp-parts :
      439     define buffer buf_temp-parts for temp-parts .
      440     do
      441     on error undo, return error
      442     :
      443       for each buf_temp-parts
      444       on error undo, return error
      445       :
      446         delete buf_temp-parts .
      447       end.
      448     end.
      449   end procedure.
      450   procedure partslib-create-temp-parts :
      451     define parameter buffer buf_parts       for ub.parts .
      452     define parameter buffer buf_temp-parts  for temp-parts .
      453     define input  parameter p-goods-twounit as logical   no-undo .
      454     define variable v-base-part-code as character no-undo .
      455     do
      456     on error undo, return error
      457     :
      458       if p-goods-twounit = true
      459       then do:
      460         assign
      461           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      462         .
      463       end.
      464       else do:
      465         assign
      466           v-base-part-code = buf_parts.part-code
      467         .
      468       end.
      469       find first buf_temp-parts exclusive-lock
      470         where buf_temp-parts.obj-type  = buf_parts.obj-type
      471           and buf_temp-parts.obj-code  = buf_parts.obj-code
      472           and buf_temp-parts.artic     = buf_parts.artic
      473           and buf_temp-parts.prod-type = buf_parts.prod-type
      474           and buf_temp-parts.prod-code = buf_parts.prod-code
      475           and buf_temp-parts.in-code   = buf_parts.in-code
      476           and buf_temp-parts.out-code  = 'free-zone':U
      477           and buf_temp-parts.part-code = v-base-part-code
      478         no-error.
      479       if not available buf_temp-parts
      480       then do:
      481         create buf_temp-parts .
      482         buffer-copy buf_parts to buf_temp-parts
      483         assign
      484           buf_temp-parts.out-code  = 'free-zone':U
      485           buf_temp-parts.part-code = v-base-part-code
      486           buf_temp-parts.rsrv-free = yes
      487           buf_temp-parts.status_   = no
      488           buf_temp-parts.qnty      = 0
      489           buf_temp-parts.fact-qnty = 0
      490           buf_temp-parts.real-qnty = 0
      491           buf_temp-parts.cli-qnty  = 0
      492         .
      493       end.
      494     end.
      495   end procedure.
      496   procedure partslib-init-temp-parts :
      497     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      498     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      499     define input parameter p-artic           like ub.parts.artic     no-undo .
      500     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      501     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      502     define buffer buf_parts      for ub.parts .
      503     define buffer buf_temp-parts for temp-parts .
      504     define variable v-goods-twounit    as logical   no-undo .
      505     do
      506     on error undo, return error
      507     :
      508   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      510     (input  p-artic
      511     ,input  p-prod-type
      512     ,input  p-prod-code
      513     ,input  'twounit=request':u
      514     ,output v-goods-twounit
      515     ) no-error .
      516       if error-status :error
      517       then do:
      518         message
      519           vss-workfile vss-revision vss-description skip
      520           vss-include-info4 skip
      521           "Ошибка при определении атрибута товара" skip
      522           "Артикул" p-artic p-prod-type p-prod-code skip
      523           "twounit=request" skip
      524           error-status :get-message(1) skip
      525           return-value skip
      526           view-as alert-box error .
      527         undo, return error return-value .
      528       end.
      529       run partslib-clear-temp-parts in this-procedure .
      530       for each buf_parts
      531         where buf_parts.obj-type  = p-obj-type
      532           and buf_parts.obj-code  = p-obj-code
      533           and buf_parts.artic     = p-artic
      534           and buf_parts.prod-type = p-prod-type
      535           and buf_parts.prod-code = p-prod-code
      536           and buf_parts.rsrv-free = yes
      537           and buf_parts.status_   = no
      538           and buf_parts.in-code   <> buf_parts.out-code
      539       on error undo, return error
      540       :
      541         run partslib-create-temp-parts in this-procedure
      542           (buffer buf_parts
      543           ,buffer buf_temp-parts
      544           ,input  v-goods-twounit
      545           ) .
      546         define variable v-parts-qnty          as decimal   no-undo .
      547         define variable v-parts-cli-qnty      as decimal   no-undo .
      548         define variable v-parts-free-qnty     as decimal   no-undo .
      549         define variable v-parts-free-cli-qnty as decimal   no-undo .
      550         if buf_parts.out-code = 'free-zone':U
      551         then do:
      552           assign
      553             v-parts-qnty          = buf_parts.qnty
      554             v-parts-cli-qnty      = buf_parts.cli-qnty
      555             v-parts-free-qnty     = buf_parts.qnty
      556             v-parts-free-cli-qnty = buf_parts.cli-qnty
      557           .
      558         end.
      559         else do:
      560           assign
      561             v-parts-qnty          = abs(buf_parts.qnty)
      562             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      563             v-parts-free-qnty     = 0
      564             v-parts-free-cli-qnty = 0
      565           .
      566         end.
      567         assign
      568           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      569           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      570           buf_temp-parts.real-qnty     = 0
      571           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      572           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      573           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      574         .
      575       end.
      576     end.
      577   end procedure.
      578   procedure partslib-init-temp-parts-by-factord :
      579     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      580     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      581     define input parameter p-artic              like ub.parts.artic     no-undo .
      582     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      583     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      584     define input parameter p-fact-order         as decimal   no-undo .
      585     define input parameter p-include-fact-order as logical   no-undo .
      586     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      587     define buffer buf_gds-obj  for ub.gds-obj .
      588     do
      589     on error undo, return error
      590     :
      591       do transaction
      592       on error undo, return error
      593       :
      594   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      596     (input  p-obj-type
      597     ,input  p-obj-code
      598     ,input  p-artic
      599     ,input  p-prod-type
      600     ,input  p-prod-code
      601     ,buffer buf_gds-obj
      602     ) no-error .
      603         if error-status :error
      604         then do:
      605           message
      606             vss-workfile vss-revision vss-description skip
      607             vss-include-info4 skip
      608             "Невозможно найти товар на объекте" skip
      609             "Объект" p-obj-type p-obj-code skip
      610             "Артикул" p-artic p-prod-type p-prod-code skip
      611             error-status :get-message(1) skip
      612             return-value skip
      613             view-as alert-box error .
      614           undo, return error .
      615         end.
      616         find current buf_gds-obj exclusive-lock .
      617       end.
      618       run partslib-init-temp-parts in this-procedure
      619         (input p-obj-type
      620         ,input p-obj-code
      621         ,input p-artic
      622         ,input p-prod-type
      623         ,input p-prod-code
      624         ) no-error .
      625       if error-status :error
      626       then do:
      627         message
      628           vss-workfile vss-revision vss-description skip
      629           vss-include-info4 skip
      630           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      631           "Объект" p-obj-type p-obj-code skip
      632           "Артикул" p-artic p-prod-type p-prod-code skip
      633           "p-fact-order" p-fact-order skip
      634           view-as alert-box error .
      635         undo, return error .
      636       end.
      637       if p-include-fact-order = true
      638       then do:
      639         assign
      640           p-fact-order = p-fact-order - 0.0000000001
      641         .
      642       end.
      643       define variable v-max-fact-order as character no-undo .
      644       run factord-max-fact-order in this-procedure
      645         (output v-max-fact-order
      646         ) no-error .
      647       if error-status :error
      648       then do:
      649         message
      650           vss-workfile vss-revision vss-description skip
      651           vss-include-info4 skip
      652           "Ошибка при вызове процедуры factord-max-fact-order" skip
      653           "Объект" p-obj-type p-obj-code skip
      654           "Артикул" p-artic p-prod-type p-prod-code skip
      655           "p-fact-order" p-fact-order skip
      656           view-as alert-box error .
      657         undo, return error .
      658       end.
      659       run partslib-update-by-factord in this-procedure
      660         (input p-obj-type
      661         ,input p-obj-code
      662         ,input p-artic
      663         ,input p-prod-type
      664         ,input p-prod-code
      665         ,input p-fact-order
      666         ,input v-max-fact-order
      667         ,input false
      668         ) no-error .
      669       if error-status :error
      670       then do:
      671         message
      672           vss-workfile vss-revision vss-description skip
      673           vss-include-info4 skip
      674           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      675           "Объект" p-obj-type p-obj-code skip
      676           "Артикул" p-artic p-prod-type p-prod-code skip
      677           "p-fact-order" p-fact-order skip
      678           "v-max-fact-order" v-max-fact-order skip
      679           view-as alert-box error .
      680         undo, return error .
      681       end.
      682     end.
      683   end procedure.
      684   procedure partslib-update-by-factord :
      685     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      686     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      687     define input parameter p-artic              like ub.parts.artic     no-undo .
      688     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      689     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      690     define input parameter p-start-fact-order   as decimal   no-undo .
      691     define input parameter p-end-fact-order     as decimal   no-undo .
      692     define input parameter p-lock-gds-obj       as logical   no-undo .
      693     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      694     define buffer buf_gds-obj  for ub.gds-obj .
      695     define buffer buf_doc-line for ub.doc-line .
      696     define variable v-total-parts-qnty as decimal   no-undo .
      697     define variable v-goods-gds-goods  as logical   no-undo .
      698     define variable v-goods-twounit    as logical   no-undo .
      699     do
      700     on error undo, return error
      701     :
      702       if p-start-fact-order > p-end-fact-order
      703       then do:
      704         message
      705           vss-workfile vss-revision vss-description skip
      706           vss-include-info4 skip
      707           "Ошибка задания входных параметров" skip
      708           "Начало интервала превышает конец интервала" skip
      709           "Объект" p-obj-type p-obj-code skip
      710           "Артикул" p-artic p-prod-type p-prod-code skip
      711           "p-start-fact-order" p-start-fact-order skip
      712           "p-end-fact-order"   p-end-fact-order skip
      713           view-as alert-box error .
      714         undo, return error .
      715       end.
      716       if p-lock-gds-obj = true
      717       then do:
      718         do transaction
      719         on error undo, return error
      720         :
      721   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      723     (input  p-obj-type
      724     ,input  p-obj-code
      725     ,input  p-artic
      726     ,input  p-prod-type
      727     ,input  p-prod-code
      728     ,buffer buf_gds-obj
      729     ) no-error .
      730           if error-status :error
      731           then do:
      732             message
      733               vss-workfile vss-revision vss-description skip
      734               vss-include-info4 skip
      735               "Невозможно найти gds-obj" skip
      736               error-status :get-message(1) skip
      737               return-value skip
      738               view-as alert-box error .
      739             undo, return error .
      740           end.
      741           find current buf_gds-obj exclusive-lock .
      742         end.
      743       end.
      744   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      745   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      746     (input  p-artic
      747     ,input  p-prod-type
      748     ,input  p-prod-code
      749     ,input  'gds-goods=request':u
      750     ,output v-goods-gds-goods
      751     ) no-error .
      752       if error-status :error
      753       then do:
      754         message
      755           vss-workfile vss-revision vss-description skip
      756           vss-include-info4 skip
      757           "Ошибка при определении атрибута товара" skip
      758           "Артикул" p-artic p-prod-type p-prod-code skip
      759           "gds-goods=request" skip
      760           error-status :get-message(1) skip
      761           return-value skip
      762           view-as alert-box error .
      763         undo, return error return-value .
      764       end.
      765   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      767     (input  p-artic
      768     ,input  p-prod-type
      769     ,input  p-prod-code
      770     ,input  'twounit=request':u
      771     ,output v-goods-twounit
      772     ) no-error .
      773       if error-status :error
      774       then do:
      775         message
      776           vss-workfile vss-revision vss-description skip
      777           vss-include-info4 skip
      778           "Ошибка при определении атрибута товара" skip
      779           "Артикул" p-artic p-prod-type p-prod-code skip
      780           "twounit=request" skip
      781           error-status :get-message(1) skip
      782           return-value skip
      783           view-as alert-box error .
      784         undo, return error return-value .
      785       end.
      786       for each buf_doc-line no-lock
      787         where buf_doc-line.obj-type   = p-obj-type
      788           and buf_doc-line.obj-code   = p-obj-code
      789           and buf_doc-line.artic      = p-artic
      790           and buf_doc-line.prod-type  = p-prod-type
      791           and buf_doc-line.prod-code  = p-prod-code
      792           and buf_doc-line.status_    = 'факт':U
      793           and buf_doc-line.fact-order > p-start-fact-order
      794           and buf_doc-line.fact-order <= p-end-fact-order
      795       on error undo, return error
      796       :
      797         run partslib-process-document in this-procedure
      798           (input  buf_doc-line.doc-code
      799           ,input  p-obj-type
      800           ,input  p-obj-code
      801           ,input  p-artic
      802           ,input  p-prod-type
      803           ,input  p-prod-code
      804           ,input  v-goods-gds-goods
      805           ,input  v-goods-twounit
      806           ,output v-total-parts-qnty
      807           ) no-error .
      808         if error-status :error
      809         then do:
      810           message
      811             vss-workfile vss-revision vss-description skip
      812             vss-include-info4 skip
      813             "Ошибка при вызове процедуры partslib-process-document" skip
      814             "Документ" buf_doc-line.doc-code skip
      815             "Объект" p-obj-type p-obj-code skip
      816             "Артикул" p-artic p-prod-type p-prod-code skip
      817             "p-start-fact-order" p-start-fact-order skip
      818             "p-end-fact-order" p-end-fact-order skip
      819             error-status :get-message(1) skip
      820             return-value skip
      821             view-as alert-box error .
      822           undo, return error return-value .
      823         end.
      824       end.
      825     end.
      826   end procedure.
      827   procedure partslib-process-document :
      828     define input  parameter p-doc-code         as character no-undo .
      829     define input  parameter p-obj-type         as character no-undo .
      830     define input  parameter p-obj-code         as integer   no-undo .
      831     define input  parameter p-artic            as character no-undo .
      832     define input  parameter p-prod-type        as character no-undo .
      833     define input  parameter p-prod-code        as integer   no-undo .
      834     define input  parameter p-goods-gds-goods  as logical   no-undo .
      835     define input  parameter p-goods-twounit    as logical   no-undo .
      836     define output parameter p-total-parts-qnty as decimal   no-undo .
      837     define variable v-parts-sign as integer   no-undo .
      838     define buffer buf_trn-doc    for ub.trn-doc .
      839     define buffer buf_doc-line   for ub.doc-line .
      840     define buffer buf_parts      for ub.parts .
      841     define buffer buf_temp-parts for temp-parts .
      842     do
      843     on error undo, return error return-value
      844     :
      845       find first buf_trn-doc no-lock
      846         where buf_trn-doc.doc-code = p-doc-code
      847         no-error .
      848       if not available buf_trn-doc
      849       then do:
      850         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      851                                      ,p-doc-code
      852                                      ) .
      853       end.
      854       case buf_trn-doc.doc-type
      855       :
      856         when 'при':U or
      857         when 'возврат':U or
      858         when 'инв':U
      859         then do:
      860           assign
      861             v-parts-sign = -1
      862           .
      863         end.
      864         when 'рас':U or
      865         when 'спи':U
      866         then do:
      867           assign
      868             v-parts-sign = 1
      869           .
      870         end.
      871         otherwise do:
      872           undo, return error substitute("Неизвестный тип документа &1"
      873                                       ,buf_trn-doc.doc-type
      874                                       ) .
      875         end.
      876       end.
      877       find first buf_doc-line no-lock
      878         where buf_doc-line.doc-code  = p-doc-code
      879           and buf_doc-line.artic     = p-artic
      880           and buf_doc-line.prod-type = p-prod-type
      881           and buf_doc-line.prod-code = p-prod-code
      882         no-error .
      883       if not available buf_doc-line
      884       then do:
      885         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      886                                      ,p-doc-code
      887                                      ,artic
      888                                      ,prod-type
      889                                      ,prod-code
      890                                      ) .
      891       end.
      892       assign
      893         p-total-parts-qnty = 0
      894       .
      895       if p-goods-gds-goods = true
      896       then do:
      897         for each buf_parts no-lock
      898           where buf_parts.out-code  = p-doc-code
      899             and buf_parts.obj-type  = p-obj-type
      900             and buf_parts.obj-code  = p-obj-code
      901             and buf_parts.artic     = p-artic
      902             and buf_parts.prod-type = p-prod-type
      903             and buf_parts.prod-code = p-prod-code
      904         on error undo, return error
      905         :
      906           run partslib-create-temp-parts in this-procedure
      907             (buffer buf_parts
      908             ,buffer buf_temp-parts
      909             ,input  p-goods-twounit
      910             ) .
      911           assign
      912             p-total-parts-qnty        = p-total-parts-qnty
      913                                       + v-parts-sign * buf_parts.fact-qnty
      914             buf_temp-parts.qnty       = buf_temp-parts.qnty
      915                                       + v-parts-sign * buf_parts.fact-qnty
      916             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      917                                       + v-parts-sign * buf_parts.fact-qnty
      918             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      919                                       + v-parts-sign * buf_parts.cli-qnty
      920           .
      921           if buf_temp-parts.qnty = 0
      922           then do:
      923             delete buf_temp-parts .
      924           end.
      925         end.
      926       end.
      927       else do:
      928         assign
      929           p-total-parts-qnty = p-total-parts-qnty
      930                              + v-parts-sign * buf_doc-line.fact-qnty
      931         .
      932       end.
      933     end.
      934   end procedure.
      935   procedure partslib-init-temp-parts-by-date :
      936     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      937     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      938     define input parameter p-artic           like ub.parts.artic     no-undo .
      939     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      940     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      941     define input parameter p-fact-date       as date      no-undo .
      942     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      943     do
      944     on error undo, return error
      945     :
      946       define variable v-fact-order                as decimal   no-undo .
      947       define variable v-shift-end-fact-order      as decimal   no-undo .
      948       define variable v-day-end-fact-order        as decimal   no-undo .
      949       run factord in this-procedure
      950         (input  p-fact-date
      951         ,input  1
      952         ,input  1
      953         ,input  ?
      954         ,input  0
      955         ,input  false
      956         ,output v-fact-order
      957         ,output v-shift-end-fact-order
      958         ,output v-day-end-fact-order
      959         ) no-error .
      960       if error-status :error
      961       then do:
      962         message
      963           vss-workfile vss-revision vss-description skip
      964           vss-include-info4 skip
      965           "Ошибка при определении момента времени, на который требуется остаток" skip
      966           "Объект" p-obj-type p-obj-code skip
      967           "Артикул" p-artic p-prod-type p-prod-code skip
      968           "Дата" p-fact-date skip
      969           view-as alert-box error .
      970         undo, return error .
      971       end.
      972       run partslib-init-temp-parts-by-factord in this-procedure
      973         (input p-obj-type
      974         ,input p-obj-code
      975         ,input p-artic
      976         ,input p-prod-type
      977         ,input p-prod-code
      978         ,input v-day-end-fact-order
      979         ,input false
      980         ) no-error .
      981       if error-status :error
      982       then do:
      983         message
      984           vss-workfile vss-revision vss-description skip
      985           vss-include-info4 skip
      986           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      987           "Объект" p-obj-type p-obj-code skip
      988           "Артикул" p-artic p-prod-type p-prod-code skip
      989           "Дата" p-fact-date skip
      990           view-as alert-box error .
      991         undo, return error .
      992       end.
      993     end.
      994   end procedure.
      995   procedure partslib-calc-cost :
      996     define output parameter p-fact-qnty      as decimal   no-undo .
      997     define output parameter p-vat-pc         as decimal   no-undo .
      998     define output parameter p-slt-pc         as decimal   no-undo .
      999     define output parameter p-sum-base       as decimal   no-undo .
     1000     define output parameter p-sum-rubl       as decimal   no-undo .
     1001     define output parameter p-vat-base       as decimal   no-undo .
     1002     define output parameter p-vat-rubl       as decimal   no-undo .
     1003     define output parameter p-slt-base       as decimal   no-undo .
     1004     define output parameter p-slt-rubl       as decimal   no-undo .
     1005     define output parameter p-road-tax-base  as decimal   no-undo .
     1006     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1007     define output parameter p-transport-base as decimal   no-undo .
     1008     define output parameter p-transport-rubl as decimal   no-undo .
     1009     define output parameter p-other-base     as decimal   no-undo .
     1010     define output parameter p-other-rubl     as decimal   no-undo .
     1011     define output parameter p-excise-base    as decimal   no-undo .
     1012     define output parameter p-excise-rubl    as decimal   no-undo .
     1013     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1014     do
     1015     on error undo, return error return-value
     1016     :
     1017       define buffer buf_temp-parts for temp-parts .
     1018       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1019       define buffer   in-vatp-parts    for ub.parts   .
     1020       define buffer   in-vatp-doc      for ub.trn-doc .
     1021       define buffer   in-vatp-goods    for ub.goods   .
     1022       define buffer   in-vatp-sysconf  for ub.sysconf .
     1023       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1024       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1025       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1026       define variable varinvprb                  as   character              no-undo.
     1027       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1028       define variable cli-base-rate              as   decimal                no-undo.
     1029       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1030       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1031       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1032       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1033       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1034       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1035       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1036       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1037       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1038       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1039       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1040       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1041       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1042       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1043       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1044       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1045       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1046       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1047       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1048       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1049       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1050       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1051       define variable varinvatp-envd             as   character              no-undo.
     1052       define variable varinvatp-type             as   character              no-undo.
     1053       for each buf_temp-parts
     1054       on error undo, return error
     1055       :
     1056   assign
     1057     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1058     price-base-with-tax-loc = buf_temp-parts.price-base
     1059   .
     1060   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1061   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1062     (output varinvprb
     1063     )  .
     1064     if buf_temp-parts.out-code = 'free-zone':U     or
     1065        buf_temp-parts.out-code = 'out-zone':U   or
     1066        buf_temp-parts.doc-type = 'акт':U then do:
     1067       assign
     1068         in-vatp-have-vat-slt = yes.
     1069     end.
     1070     else do:
     1071       find first in-vatp_doc-attr no-lock
     1072         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1073           and in-vatp_doc-attr.attr-code = 'envd':U
     1074         no-error .
     1075       if not available in-vatp_doc-attr then do:
     1076         assign
     1077           in-vatp-have-vat-slt = yes.
     1078       end.
     1079       else do:
     1080            in-vatp-have-vat-slt = no.
     1081       end.
     1082     end.
     1083     assign
     1084      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1085      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1086     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1087              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1088     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1089             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1090             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1091             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1092             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1093             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1094             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1095       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1096     assign
     1097       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1098     assign
     1099       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1100       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1101       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1102       transport-cli-loc  = 0
     1103       other-cli-loc      = 0
     1104     .
     1105   ASSIGN
     1106             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1107       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1108   .
     1109         assign
     1110           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1111           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1112           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1113           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1114           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1115           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1116           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1117           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1118           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1119           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1120           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1121           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1122           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1123           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1124           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1125           p-excise-base    = p-excise-base    + 0
     1126           p-excise-rubl    = p-excise-rubl    + 0
     1127         .
     1128       end.
     1129       if p-fact-qnty      = ?
     1130       or p-sum-base       = ?
     1131       or p-sum-rubl       = ?
     1132       or p-vat-base       = ?
     1133       or p-vat-rubl       = ?
     1134       or p-slt-base       = ?
     1135       or p-slt-rubl       = ?
     1136       or p-road-tax-base  = ?
     1137       or p-road-tax-rubl  = ?
     1138       or p-transport-base = ?
     1139       or p-transport-rubl = ?
     1140       or p-other-base     = ?
     1141       or p-other-rubl     = ?
     1142       or p-excise-base    = ?
     1143       or p-excise-rubl    = ?
     1144       then do:
     1145         message
     1146           vss-workfile vss-revision vss-description skip
     1147           vss-include-info4 skip
     1148           "Программа in-vatp.i вернула неопределенные значения" skip
     1149           "p-fact-qnty"      p-fact-qnty      skip
     1150           "p-sum-base"       p-sum-base       skip
     1151           "p-sum-rubl"       p-sum-rubl       skip
     1152           "p-vat-base"       p-vat-base       skip
     1153           "p-vat-rubl"       p-vat-rubl       skip
     1154           "p-slt-base"       p-slt-base       skip
     1155           "p-slt-rubl"       p-slt-rubl       skip
     1156           "p-road-tax-base"  p-road-tax-base  skip
     1157           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1158           "p-transport-base" p-transport-base skip
     1159           "p-transport-rubl" p-transport-rubl skip
     1160           "p-other-base"     p-other-base     skip
     1161           "p-other-rubl"     p-other-rubl     skip
     1162           "p-excise-base"    p-excise-base    skip
     1163           "p-excise-rubl"    p-excise-rubl    skip
     1164           view-as alert-box error .
     1165         undo, return error .
     1166       end.
     1167     end.
     1168   end procedure.
     1169   define temp-table tt-utd like ub.utd
     1170     field stts        as character
