     5274                           skip "большее количество товара, чем было добавлено."
     5275                           skip "Количество товара в документе будет восстановлено."
     5276                           skip(1)
     5277                           skip "Товар: " buf_fbr-line.artic v-gds-name
     5278                           skip "Количество в строке документа производства:" v-old-fact-qnty
     5279                           skip "Новое количество:" buf_fbr-line.fact-qnty
     5280                       view-as alert-box information
     5281                       title "Изменение строки документа производства".
     5282                       find first buf_change_fbr-line exclusive-lock
     5283                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5284                              and buf_change_fbr-line.is-comp     = yes
     5285                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5286                       .
     5287                       assign
