     5289                           buf_change_fbr-line.price-sale = v-old-price-sale
     5290                       .
     5291                       delete buf_start_temp_goods-qnty.
     5292                   end.
     5293                   else do:
     5294                       find first buf_change_fbr-line exclusive-lock
     5295                            where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5296                              and buf_change_fbr-line.is-comp     = yes
     5297                              and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5298                       .
     5299                       assign
     5300                           buf_start_temp_goods-qnty.need-qnty  = buf_fbr-line.fact-qnty
     5301                           buf_start_temp_goods-qnty.calculated = no
     5302                           buf_change_fbr-line.fact-qnty     = 0
     5303                       .
     5304                   end.
     5305                   run test-temp-tables in this-procedure ( "Товар добавлять не надо - параметр fbr-frcp=yes, но введенное в диалоге количество меньше необходимого." ).
     5306                   find first buf_start_temp_goods-qnty
     5307                        where buf_start_temp_goods-qnty.calculated = no
     5308                   no-error.
     5309                   next calc-not-calculated-goods.
     5310               end.
     5311               else do:
     5312                   find first buf_change_fbr-line exclusive-lock
     5313                        where buf_change_fbr-line.doc-code    = p-fbr-doc-doc-code
     5314                          and buf_change_fbr-line.is-comp     = yes
     5315                          and buf_change_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5316                   .
     5317                   assign
     5318                       buf_start_temp_goods-qnty.need-qnty  = buf_start_temp_goods-qnty.need-qnty + buf_fbr-line.fact-qnty
     5319                       buf_change_fbr-line.fact-qnty        = buf_start_temp_goods-qnty.need-qnty
     5320                   .
