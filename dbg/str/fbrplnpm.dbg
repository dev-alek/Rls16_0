     1378     (output v-db-num
     1379     )  .
     1380   if v-obj-db-num <> v-db-num then do:
     1381     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1382                             , chr(10)
     1383                             , p-obj-type
     1384                             , p-obj-code
     1385                             , v-obj-db-num
     1386                             , v-db-num).
     1387   end.
     1388   run cur-time in this-procedure ( output v-today, output v-time).
     1389   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1391     (input  p-obj-type
     1392     ,input  p-obj-code
     1393     ,output v-today
     1394     )  .
     1395   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1397     (input  v-host-code
     1398     ,output v-base-code
     1399     )  .
     1400   find last buf_curr-accnt no-lock
     1401       where buf_curr-accnt.curr-code = v-base-code
     1402         and buf_curr-accnt.exch-date <= v-today use-index pi
     1403   no-error.
     1404   if not available buf_curr-accnt
     1405   then do:
     1406     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1407                                     , string(v-today, "99/99/9999")
     1408                                     , v-base-code).
     1409   end.
     1410   run doc-code in this-procedure (
     1411         input  "main"
     1412       , input  p-obj-type
     1413       , input  p-obj-code
     1414       , input  ?
     1415       , output v-doc-code
     1416   ) no-error.
     1417   if error-status:error
     1418   then do:
     1419     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1420                                   , chr(10)
     1421                                   , error-status:get-message(1)
     1422                                   , return-value ).
     1423   end.
     1424   run trg/chkdocnm.p (
     1425         input v-doc-code
     1426       , input 'fbr-doc':U
     1427       , input ?
     1428   ) no-error.
     1429   if error-status:error
     1430   then do:
     1431     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1432                                   , chr(10)
     1433                                   , error-status:get-message(1)
     1434                                   , return-value ).
     1435   end.
     1436   create buf_fbr-doc.
     1437   assign
     1438   buf_fbr-doc.doc-code  = v-doc-code
     1439   buf_fbr-doc.creid     = p-userid
     1440   buf_fbr-doc.doc-date  = v-today
     1441   buf_fbr-doc.doc-type  = 'производство':U
     1442   buf_fbr-doc.host-code = v-host-code
     1443   buf_fbr-doc.obj-code  = p-obj-code
     1444   buf_fbr-doc.obj-type  = p-obj-type
     1445   buf_fbr-doc.PS        = "@"
     1446   buf_fbr-doc.status_   = 'новый':U
     1447   buf_fbr-doc.user-db-num = v-obj-db-num
     1448   buf_fbr-doc.user-name   = p-userid
     1449   .
     1450   run fbrlib_get-default-pay-code in this-procedure (
     1451         input buf_fbr-doc.obj-type
     1452       , input buf_fbr-doc.obj-code
     1453       , output fi-pay-code
     1454   ).
     1455   buf_fbr-doc.pay-code = fi-pay-code.
     1456   p-recid = recid(buf_fbr-doc).
     1457   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1458   end.
     1459   end procedure.
     1460   procedure fbrlib_get-default-pay-code :
     1461   define input parameter p-obj-type   as character        no-undo.
     1462   define input parameter p-obj-code   as integer          no-undo.
     1463   define output parameter p-pay-code  as integer          no-undo.
     1464   define variable v-host-code as integer no-undo .
     1465   define buffer buf_shop          for ub.shop.
     1466   define buffer buf_store         for ub.store.
     1467   define buffer buf_sysconf       for ub.sysconf.
     1468   do
     1469   for buf_shop
     1470     , buf_store
     1471     , buf_sysconf
     1472   on error undo, return error
     1473   :
     1474     case p-obj-type  :
     1475       when 'маг':U then do:
     1476           find first buf_shop no-lock
     1477                 where buf_shop.obj-code = p-obj-code
     1478           no-error.
     1479           if available buf_shop
     1480           then do:
     1481               assign
     1482                   p-pay-code = buf_shop.fbr-pay
     1483               .
     1484           end.
     1485       end.
     1486       when 'скл':U then do:
     1487           find first buf_store no-lock
     1488                 where buf_store.obj-code = p-obj-code
     1489           no-error.
     1490           if available buf_store
     1491           then do:
     1492               assign
     1493                   p-pay-code = buf_store.fbr-pay
     1494               .
     1495           end.
     1496       end.
     1497     end case.
     1498     if p-pay-code = ?
     1499     or p-pay-code = 0
     1500     then do:
     1501   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1503     (input  p-obj-type
     1504     ,input  p-obj-code
     1505     ,output v-host-code
     1506     )  .
     1507         find first buf_sysconf no-lock
     1508               where buf_sysconf.host-code = v-host-code
     1509         no-error.
     1510         if available buf_sysconf
     1511         then do:
     1512             assign
     1513                 p-pay-code = buf_sysconf.fbr-pay
     1514             .
     1515         end.
     1516     end.
     1517     if p-pay-code = ?
     1518     or p-pay-code = 0
     1519     then do:
     1520   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1522     (input  p-obj-type
     1523     ,input  p-obj-code
     1524     ,output p-pay-code
     1525     )  .
     1526     end.
     1527   end.
     1528   end procedure.
     1529   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1530   do
     1531   on error undo, return error
     1532   :
     1533   define input parameter p-fbr-doc-code as character    no-undo.
     1534       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1535       define variable v-gds-name      as character    no-undo.
     1536       define buffer buf_fbr-doc               for ub.fbr-doc.
     1537       define buffer buf_fbr-line              for ub.fbr-line.
     1538       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1539       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1540       find first buf_fbr-doc no-lock
     1541            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1542       .
     1543       for each buf_temp_fbrlib_recipe
     1544       :
     1545           delete buf_temp_fbrlib_recipe.
     1546       end.
     1547       for each buf_fbr-line no-lock
     1548          where buf_fbr-line.doc-code = p-fbr-doc-code
     1549       :
     1550           find first buf_temp_fbrlib_recipe
     1551                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1552           no-error.
     1553           if not available buf_temp_fbrlib_recipe
     1554           then do:
     1555               create buf_temp_fbrlib_recipe.
     1556               assign
     1557                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1558                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1559               .
     1560           end.
     1561       end.
     1562       for each buf_temp_fbrlib_recipe
     1563       :
     1564           assign
     1565               buf_temp_fbrlib_recipe.count-income                = 0
     1566               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1567               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1568               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1569               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1570               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1571               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1572               buf_temp_fbrlib_recipe.count-write-off             = 0
     1573               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1574               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1575               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1576               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1577               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1578               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1579           .
     1580           for each buf_fbr-line no-lock
     1581              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1582                and buf_fbr-line.trn-type     = 'при':U
     1583                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1584           :
     1585               if ( buf_fbr-line.price-base   = ?
     1586                   or buf_fbr-line.price-rubl = ?
     1587                   or buf_fbr-line.price-base <= 0
     1588                   or buf_fbr-line.price-rubl <= 0 )
     1589               and buf_fbr-line.fact-qnty <> 0
     1590               and buf_fbr-line.rsrv-qnty <> ?
     1591               and buf_fbr-doc.is-free    = no
     1592               then do:
     1593   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1594   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1595     (input  buf_fbr-line.artic
     1596     ,input  buf_fbr-line.prod-type
     1597     ,input  buf_fbr-line.prod-code
     1598     ,output v-gds-name
     1599     ) no-error .
     1600                   if error-status :error
     1601                   then do:
     1602                       assign
     1603                           v-gds-name = ""
     1604                       .
     1605                   end.
     1606                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1607                                                 ,vss-description
     1608                                                 ,buf_fbr-doc.doc-code
     1609                                                 ,chr(10)
     1610                                                 ,buf_fbr-line.recipe-code
     1611                                                 ,buf_fbr-line.artic
     1612                                                 ,v-gds-name).
     1613               end.
     1614               assign
     1615                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1616                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1617                                                                   + buf_fbr-line.fact-qnty
     1618                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1619                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1620               .
     1621               if buf_fbr-line.is-waste = no
     1622               then do:
     1623                   assign
     1624                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1625                                                                       + buf_fbr-line.price-sum-base
     1626                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1627                                                                       + buf_fbr-line.price-sum-rubl
     1628                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1629                                                                       + buf_fbr-line.price-sum-vat-base
     1630                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1631                                                                       + buf_fbr-line.price-sum-vat-rubl
     1632                   .
     1633               end.
     1634           end.
     1635           for each buf_fbr-line no-lock
     1636              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1637                and buf_fbr-line.trn-type     = 'спи':U
     1638                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1639           :
     1640               if ( buf_fbr-line.price-base   = ?
     1641                   or buf_fbr-line.price-rubl = ?
     1642                   or buf_fbr-line.price-base <= 0
     1643                   or buf_fbr-line.price-rubl <= 0 )
     1644               and buf_fbr-line.fact-qnty <> 0
     1645               and buf_fbr-line.rsrv-qnty <> ?
     1646               and buf_fbr-doc.is-free    = no
     1647               and buf_fbr-doc.status_    = 'разрешен':U
     1648               then do:
     1649   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1651     (input  buf_fbr-line.artic
     1652     ,input  buf_fbr-line.prod-type
     1653     ,input  buf_fbr-line.prod-code
     1654     ,output v-gds-name
     1655     ) no-error .
     1656                   if error-status :error
     1657                   then do:
     1658                       assign
     1659                           v-gds-name = ""
     1660                       .
     1661                   end.
     1662                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1663                                                 ,vss-description
     1664                                                 ,buf_fbr-doc.doc-code
     1665                                                 ,chr(10)
     1666                                                 ,buf_fbr-line.recipe-code
     1667                                                 ,buf_fbr-line.artic
     1668                                                 ,v-gds-name).
     1669               end.
     1670               assign
     1671                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1672                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1673                                                                   + buf_fbr-line.fact-qnty
     1674                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1675                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1676               .
     1677               if buf_fbr-line.is-waste = no
     1678               then do:
     1679                   assign
     1680                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1681                                                                       + buf_fbr-line.price-sum-base
     1682                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1683                                                                       + buf_fbr-line.price-sum-rubl
     1684                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1685                                                                       + buf_fbr-line.price-sum-vat-base
     1686                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1687                                                                       + buf_fbr-line.price-sum-vat-rubl
     1688                   .
     1689               end.
     1690           end.
     1691           if buf_fbr-doc.status_    = 'разрешен':U
     1692           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1693           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1694           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1695           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1696               )
     1697           then do:
     1698            undo, return error
     1699               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1700                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1701                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1702                           "Сумма в &9.&4&7&4&4&8&2"
     1703                          , buf_fbr-doc.doc-code
     1704                          , chr(10)
     1705                          , buf_temp_fbrlib_recipe.recipe-code
     1706                          , chr(9)
     1707                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1708                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1709                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1710                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1711                          , "руб"
     1712                          )
     1713              +
     1714              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1715                         "НДС в &7.&1&5&1&1&6&4"
     1716                        ,  chr(9)
     1717                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1718                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1719                        ,chr(10)
     1720                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1721                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1722                        ,"руб"
     1723                        )       .
     1724           end.
     1725       end.
     1726   end.
     1727   end procedure.
     1728   procedure fbrlib-fill-sum-fbr-doc :
     1729   do
     1730   on error undo, return error
     1731   :
     1732   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1733   define input parameter p-mode           as character    no-undo.
     1734       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1735       define buffer buf_fbr-doc           for ub.fbr-doc.
     1736       define buffer buf_fbr-line          for ub.fbr-line.
     1737       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1738       define variable v-in-count          as integer       no-undo.
     1739       define variable v-out-count         as integer       no-undo.
     1740       find first buf_fbr-doc exclusive-lock
     1741            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1742       .
     1743       find first buf_temp_fbrlib_recipe no-error.
     1744       if not available buf_temp_fbrlib_recipe
     1745       then do:
     1746           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1747               input buf_fbr-doc.doc-code
     1748           ) no-error.
     1749           if error-status :error
     1750           then do:
     1751               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1752                                              , vss-description
     1753                                              , chr(10)
     1754                                              , error-status:get-message(1)
     1755                                              , return-value ).
     1756           end.
     1757       end.
     1758       assign
     1759           v-in-count                  = 0
     1760           buf_fbr-doc.in-qnty         = 0
     1761           buf_fbr-doc.in-sale         = 0
     1762           buf_fbr-doc.in-base         = 0
     1763           buf_fbr-doc.in-rubl         = 0
     1764           buf_fbr-doc.in-vat-base     = 0
     1765           buf_fbr-doc.in-vat-rubl     = 0
     1766           v-out-count                 = 0
     1767           buf_fbr-doc.out-qnty        = 0
     1768           buf_fbr-doc.out-sale        = 0
     1769           buf_fbr-doc.out-base        = 0
     1770           buf_fbr-doc.out-rubl        = 0
     1771           buf_fbr-doc.out-vat-base    = 0
     1772           buf_fbr-doc.out-vat-rubl    = 0
     1773       .
     1774       for each buf_temp_fbrlib_recipe
     1775       :
     1776           assign
     1777               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1778               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1779               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1780               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1781               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1782               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1783               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1784               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1785               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1786               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1787               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1788               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1789               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1790               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1791           .
     1792       end.
     1793       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1794       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1795       or p-mode <> 'факт':U
     1796       then do:
     1797           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1798           then do:
     1799               assign
     1800                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1801                                   + string( v-out-count, ">>>,>>9" )
     1802                                   + chr(10) + "Строк исходных товаров : "
     1803                                   + string( v-in-count, ">>>,>>9" )
     1804               .
     1805           end.
     1806       end.
     1807       else do:
     1808         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1809                                       "Сумма списанных товаров в &3 - &4&2" +
     1810                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1811                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1812                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1813                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1814                                       , buf_fbr-doc.doc-code
     1815                                       , chr(10)
     1816                                       , "рублях"
     1817                                       , round( buf_fbr-doc.out-rubl, 2 )
     1818                                       , round( buf_fbr-doc.in-rubl,  2 )
     1819                                       , round( buf_fbr-doc.in-rubl,  2 )
     1820                                       , round( buf_fbr-doc.out-base, 2 )
     1821                                       , round( buf_fbr-doc.in-base,  2 )).
     1822       end.
     1823   end.
     1824   end procedure.
     1825   procedure fbrlib-calc-prices :
     1826   do
     1827   on error undo, return error
     1828   :
     1829   define input parameter p-fbr-line-recid as recid        no-undo.
     1830   define input parameter p-price-obj-type as character    no-undo.
     1831   define input parameter p-price-obj-code as integer      no-undo.
     1832   define output parameter p-current-price as decimal      no-undo.
     1833       define variable v-void          as decimal       no-undo.
     1834       define variable v-void-char     as character     no-undo.
     1835       define variable v-gds-code      as integer       no-undo.
     1836       define variable v-b-code        as integer       no-undo.
     1837       define buffer buf_fbr-doc   for ub.fbr-doc.
     1838       define buffer buf_fbr-line  for ub.fbr-line.
     1839       define buffer buf_gds-prt   for ub.gds-prt.
     1840       define buffer buf_bar-code  for ub.bar-code.
     1841       find first buf_fbr-line no-lock
     1842           where recid( buf_fbr-line ) = p-fbr-line-recid
     1843       .
     1844   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1846     (input  buf_fbr-line.artic
     1847     ,input  buf_fbr-line.prod-type
     1848     ,input  buf_fbr-line.prod-code
     1849     ,output v-gds-code
     1850     ) no-error .
     1851       if error-status :error
     1852       then do:
     1853         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1854                                         ,vss-workfile
     1855                                         ,vss-revision
     1856                                         ,vss-description
     1857                                         ,chr(10)
     1858                                         , error-status:get-message(1)
     1859                                         , return-value
     1860                                         , buf_fbr-line.artic
     1861                                         ).
     1862       end.
     1863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1864     (input  v-gds-code
     1865     ,input  ?
     1866     ,output v-b-code
     1867     ) no-error .
     1868       if error-status :error
     1869       then do:
     1870         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1871                                         ,vss-workfile
     1872                                         ,vss-revision
     1873                                         ,vss-description
     1874                                         ,chr(10)
     1875                                         , error-status:get-message(1)
     1876                                         , return-value
     1877                                         , v-gds-code
     1878                                         ).
     1879       end.
     1880       if buf_fbr-line.is-calc = no
     1881       then do:
     1882   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1884     (input  p-price-obj-type
     1885     ,input  p-price-obj-code
     1886     ,input  v-b-code
     1887     ,input  0
     1888     ,input  0
     1889     ,output v-void-char
     1890     ,output p-current-price
     1891     ,output v-void
     1892     ,output v-void
     1893     ) no-error .
     1894           if error-status :error
     1895           then do:
     1896             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1897                                             ,vss-workfile
     1898                                             ,vss-revision
     1899                                             ,vss-description
     1900                                             ,chr(10)
     1901                                             , error-status:get-message(1)
     1902                                             , return-value
     1903                                             , v-gds-code
     1904                                             ).
     1905           end.
     1906       end.
     1907       else do:
     1908           assign
     1909               p-current-price = buf_fbr-line.price-sale
     1910           .
     1911       end.
     1912   end.
     1913   end procedure.
     1914   procedure fbrlib-put-in-order-recipe :
     1915   do
     1916   on error undo, return error
     1917   :
     1918   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1919       define variable v-recipe-counter    as integer          no-undo.
     1920       define variable v-recipe-amount     as integer init 0   no-undo.
     1921       define variable v-child-counter     as integer          no-undo.
     1922       define variable v-is-call-cycle     as logical          no-undo.
     1923       define variable v-str as character     no-undo.
     1924       define buffer buf_in_fbr-line       for ub.fbr-line.
     1925       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1926       define buffer buf_fbr-line          for ub.fbr-line.
     1927       define buffer buf_recipe-gds        for ub.recipe-gds.
     1928       define buffer buf_recipe            for ub.recipe.
     1929       for each temp_recipe-childs-qnty
     1930       :
     1931           delete temp_recipe-childs-qnty.
     1932       end.
     1933       for each temp_recipe-childs
     1934       :
     1935           delete temp_recipe-childs.
     1936       end.
     1937       for each temp_recipe-order
     1938       :
     1939           delete temp_recipe-order.
     1940       end.
     1941       for each buf_fbr-line no-lock
     1942          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1943       on error undo, return error
     1944       :
     1945           find first temp_recipe-childs-qnty
     1946                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1947           no-error.
     1948           if not available temp_recipe-childs-qnty
     1949           then do:
     1950               create temp_recipe-childs-qnty.
     1951               assign
     1952                   v-recipe-amount                     = v-recipe-amount + 1
     1953                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1954                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1955                   temp_recipe-childs-qnty.childs-qnty = 0
     1956                   v-child-counter                     = 0
     1957               .
     1958           end.
     1959       end.
     1960       for each buf_in_fbr-line no-lock
     1961          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1962            and buf_in_fbr-line.trn-type = 'спи':U
     1963       on error undo, return error
     1964       :
     1965           for each buf_dress_fbr-line no-lock
     1966              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1967                and buf_dress_fbr-line.trn-type    = 'при':U
     1968                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1969                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1970                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1971           on error undo, return error
     1972           :
     1973               find first buf_recipe no-lock
     1974                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1975               .
     1976               if buf_in_fbr-line.is-comp = yes
     1977               then do:
     1978                   find last temp_recipe-childs-qnty
     1979                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1980                   .
     1981                   assign
     1982                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1983                   .
     1984                   create temp_recipe-childs.
     1985                   assign
     1986                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1987                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1988                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1989                   .
     1990               end.
     1991               else do:
     1992               end.
     1993           end.
     1994       end.
     1995       for each buf_in_fbr-line no-lock
     1996          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1997            and buf_in_fbr-line.trn-type = 'при':U
     1998       on error undo, return error
     1999       :
     2000           find first buf_recipe no-lock
     2001                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2002           no-error.
     2003           if buf_in_fbr-line.is-comp = no
     2004           then do:
     2005           end.
     2006           else do:
     2007               for each buf_recipe-gds no-lock
     2008               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2009               :
     2010                   for each buf_fbr-line no-lock
     2011                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2012                       and buf_fbr-line.trn-type    = 'при':U
     2013                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2014                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2015                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2016                   on error undo, return error
     2017                   :
     2018                       find first buf_recipe no-lock
     2019                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2020                       .
     2021                       if buf_recipe.recipe-type = 'разделка':U
     2022                       then do:
     2023                       end.
     2024                       else do:
     2025                           find last temp_recipe-childs-qnty
     2026                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2027                           .
     2028                           assign
     2029                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2030                           .
     2031                           create temp_recipe-childs.
     2032                           assign
     2033                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2034                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2035                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2036                           .
     2037                       end.
     2038                   end.
     2039               end.
     2040           end.
     2041       end.
     2042       for each temp_recipe-order
     2043       on error undo, return error
     2044       :
     2045           delete temp_recipe-order.
     2046       end.
     2047       assign
     2048           v-fbrlib-recipe-order = 0
     2049       .
     2050       do v-recipe-counter = 1 to v-recipe-amount
     2051       on error undo, return error
     2052       :
     2053           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2054                 input v-recipe-counter
     2055               , input 0
     2056               , output v-is-call-cycle
     2057           ).
     2058           if v-is-call-cycle = yes
     2059           then do:
     2060               message
     2061                       "Достигнут максимальный уровень вложенности рецептов."
     2062                   skip(1)
     2063                   skip "Невозможно упорядочить рецепты."
     2064                   skip(1)
     2065                   skip "Необходимо изменить структуру рецептов,"
     2066                   skip "используемых при формировании"
     2067                   skip "данного документа производства."
     2068               view-as alert-box error
     2069               title "Невозможно рассчитать документ производства".
     2070               for each temp_recipe-childs-qnty
     2071               :
     2072                   delete temp_recipe-childs-qnty.
     2073               end.
     2074               for each temp_recipe-childs
     2075               :
     2076                   delete temp_recipe-childs.
     2077               end.
     2078               for each temp_recipe-order
     2079               :
     2080                   delete temp_recipe-order.
     2081               end.
     2082               for each temp_recipe-order
     2083               on error undo, return error
     2084               :
     2085                   delete temp_recipe-order.
     2086               end.
     2087               for each temp_fbrlib_recipe
     2088               on error undo, return error
     2089               :
     2090                   delete temp_recipe-order.
     2091               end.
     2092               undo, return error.
     2093           end.
     2094       end.
     2095   end.
     2096   end procedure.
     2097   procedure fbrlib-add-recipe-in-tmp-order :
     2098   do
     2099   on error undo, return error
     2100   :
     2101   define input parameter p-order              as integer      no-undo.
     2102   define input parameter p-call-counter       as integer      no-undo.
     2103   define output parameter p-is-call-cycle     as logical      no-undo.
     2104       define variable v-nodes-counter     as integer       no-undo.
     2105       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2106       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2107       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2108       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2109       assign
     2110           p-call-counter = p-call-counter + 1
     2111       .
     2112       if p-call-counter > 50
     2113       then do:
     2114           assign
     2115               p-is-call-cycle = yes
     2116           .
     2117       end.
     2118       else do:
     2119           find first buf_temp_recipe-childs-qnty
     2120                where buf_temp_recipe-childs-qnty.order = p-order
     2121           .
     2122           find first buf_temp_recipe-order
     2123                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2124           no-error.
     2125           if not available buf_temp_recipe-order
     2126           then do:
     2127               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2128               :
     2129                   find first buf_temp_recipe-childs
     2130                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2131                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2132                   .
     2133                   find first buf_c_temp_recipe-childs-qnty
     2134                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2135                   .
     2136                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2137                         input buf_c_temp_recipe-childs-qnty.order
     2138                       , input p-call-counter
     2139                       , output p-is-call-cycle
     2140                   ).
     2141                   if p-is-call-cycle = yes
     2142                   then do:
     2143                       return.
     2144                   end.
     2145               end.
     2146               assign
     2147                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2148               .
     2149               create buf_temp_recipe-order.
     2150               assign
     2151                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2152                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2153               .
     2154           end.
     2155       end.
     2156   end.
     2157   end procedure.
     2158   procedure fbrlib-get-trn-type :
     2159   define input parameter p-recipe-code    as character    no-undo.
     2160   define input parameter p-goods-recid    as recid        no-undo.
     2161   define input parameter p-is-integration as logical      no-undo.
     2162   define output parameter p-is-comp       as logical      no-undo.
     2163   define output parameter p-trn-type      as character    no-undo.
     2164   define buffer buf_recipe    for ub.recipe.
     2165   define buffer buf_goods     for ub.goods.
     2166   do
     2167   for buf_recipe
     2168     , buf_goods
     2169   on error undo, return error
     2170   :
     2171       find first buf_goods no-lock
     2172            where recid( buf_goods ) = p-goods-recid
     2173       .
     2174       find first buf_recipe no-lock
     2175            where buf_recipe.recipe-code = p-recipe-code
     2176       no-error.
     2177       if not available buf_recipe
     2178       then do:
     2179           assign
     2180               p-is-comp = no
     2181               p-trn-type = "":U
     2182           .
     2183           undo, return.
     2184       end.
     2185       if  buf_recipe.artic        = buf_goods.artic
     2186       and buf_recipe.prod-type    = buf_goods.prod-type
     2187       and buf_recipe.prod-code    = buf_goods.prod-code
     2188       then do:
     2189           assign
     2190               p-is-comp = yes
     2191           .
     2192       end.
     2193       else do:
     2194           assign
     2195               p-is-comp = no
     2196           .
     2197       end.
     2198       case buf_recipe.recipe-type
     2199       :
     2200           when 'производство':U
     2201           then do:
     2202               if p-is-comp = yes
     2203               then do:
     2204                   assign
     2205                       p-trn-type = 'при':U
     2206                   .
     2207               end.
     2208               else do:
     2209                   assign
     2210                       p-trn-type = 'спи':U
     2211                   .
     2212               end.
     2213           end.
     2214           when 'альтернатива':U
     2215           then do:
     2216               if p-is-comp = yes
     2217               then do:
     2218                   assign
     2219                       p-trn-type = 'при':U
     2220                   .
     2221               end.
     2222               else do:
     2223                   assign
     2224                       p-trn-type = 'спи':U
     2225                   .
     2226               end.
     2227           end.
     2228           when 'разделка':U
     2229           then do:
     2230               if p-is-comp = no
     2231               then do:
     2232                   assign
     2233                       p-trn-type = 'при':U
     2234                   .
     2235               end.
     2236               else do:
     2237                   assign
     2238                       p-trn-type = 'спи':U
     2239                   .
     2240               end.
     2241           end.
     2242           when 'комплектация':U
     2243           then do:
     2244               if p-is-integration = ?
     2245               then do:
     2246                   message
     2247                       "Выберите тип операции по рецепту комплектации:"
     2248                       skip (2) "YES - комплектация"
     2249                       skip     "NO - разукомплектация"
     2250                   view-as alert-box question
     2251                   buttons YES-NO
     2252                   update p-is-integration.
     2253               end.
     2254               if p-is-integration = yes
     2255               then do:
     2256                   if p-is-comp = yes
     2257                   then do:
     2258                       assign
     2259                           p-trn-type = 'при':U
     2260                       .
     2261                   end.
     2262                   else do:
     2263                       assign
     2264                           p-trn-type = 'спи':U
     2265                       .
     2266                   end.
     2267               end.
     2268               else do:
     2269                   if p-is-comp = yes
     2270                   then do:
     2271                       assign
     2272                           p-trn-type = 'спи':U
     2273                       .
     2274                   end.
     2275                   else do:
     2276                       assign
     2277                           p-trn-type = 'при':U
     2278                       .
     2279                   end.
     2280               end.
     2281           end.
     2282       end case.
     2283   end.
     2284   end procedure.
     2285   procedure fbrlib-get-mark :
     2286   define input parameter p-recipe-code    as character    no-undo.
     2287   define output parameter p-mark          as logical    no-undo.
     2288   define buffer buf_goods-attr     for ub.goods-attr.
     2289   define buffer buf_recipe-gds for ub.recipe-gds .
     2290       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2291            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2292                                               buf_goods-attr.attr-code = 'mark-type':U:
     2293            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2294               p-mark = true .
     2295               return .
     2296            end.
     2297       end.
     2298   end procedure.
     2299   procedure fbrlib-check-temp-tables :
     2300   do
     2301   on error undo, return error
     2302   :
     2303   define input parameter p-title  as character    no-undo.
     2304       define variable v-str               as character        no-undo.
     2305       assign
     2306           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2307       .
     2308       for each temp_recipe-childs-qnty
     2309       on error undo, return error
     2310       :
     2311           assign
     2312               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2313                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2314                       + "   " + string( temp_recipe-childs-qnty.order )
     2315                       + chr(10)
     2316           .
     2317       end.
     2318       assign
     2319           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2320       .
     2321       for each temp_recipe-childs
     2322       on error undo, return error
     2323       :
     2324           assign
     2325               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2326                       + "   " + string( temp_recipe-childs.child-code )
     2327                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2328                       + chr(10)
     2329           .
     2330       end.
     2331       assign
     2332           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2333       .
     2334       for each temp_recipe-order
     2335       on error undo, return error
     2336       :
     2337           assign
     2338               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2339                       + "   " + string( temp_recipe-order.order )
     2340                       + chr(10)
     2341           .
     2342       end.
     2343       assign
     2344           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2345       .
     2346       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2347       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2348       for each temp_fbrlib_recipe
     2349       on error undo, return error
     2350       :
     2351           assign
     2352               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2353                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2354                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2355                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2356                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2357                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2358                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2359                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2360                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2361                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2362                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2363                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2364                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2365                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2366                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2367                       + chr(10)
     2368           .
     2369           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2370       end.
     2371   end.
     2372   end procedure.
     2373   procedure fbrlib-s-coeff-value :
     2374   define input  parameter p-gds-code    as integer        no-undo.
     2375   define input  parameter p-date        as date           no-undo.
     2376   define input  parameter p-obj-type    as character      no-undo.
     2377   define input  parameter p-obj-code    as integer        no-undo.
     2378   define output parameter p-coeff-value as decimal        no-undo.
     2379   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2380       define variable v-date          as date         no-undo.
     2381       define variable v-host-code     as integer      no-undo.
     2382       define buffer buf_goods       for ub.goods.
     2383       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2384       define buffer buf_clients     for ub.clients.
     2385       define buffer buf_s-coeff     for ub.s-coeff.
     2386   do
     2387   for buf_goods
     2388     , buf_fbr-gds-obj
     2389     , buf_clients
     2390     , buf_s-coeff
     2391   on error undo, return error return-value
     2392   :
     2393       find first buf_goods no-lock
     2394            where buf_goods.gds-code = p-gds-code
     2395       no-error .
     2396       if not available buf_goods
     2397       then do:
     2398          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2399       end.
     2400       find first buf_clients no-lock
     2401            where buf_clients.obj-type = p-obj-type
     2402              and buf_clients.obj-code = p-obj-code
     2403       no-error.
     2404       if not available buf_clients
     2405       then do:
     2406          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2407       end.
     2408       assign
     2409           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2410       .
     2411       find first buf_fbr-gds-obj no-lock
     2412            where buf_fbr-gds-obj.gds-code = p-gds-code
     2413              and buf_fbr-gds-obj.obj-type = p-obj-type
     2414              and buf_fbr-gds-obj.obj-code = p-obj-code
     2415       no-error.
     2416       if not available buf_fbr-gds-obj
     2417       or buf_fbr-gds-obj.is-season = no
     2418       then do:
     2419           assign
     2420               p-coeff-value = 0
     2421           .
     2422           return.
     2423       end.
     2424   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2426     (input  p-obj-type
     2427     ,input  p-obj-code
     2428     ,output v-host-code
     2429     )  .
     2430       find last buf_s-coeff no-lock
     2431           where buf_s-coeff.gds-code = p-gds-code
     2432             and buf_s-coeff.host-code = v-host-code
     2433             and buf_s-coeff.obj-type = p-obj-type
     2434             and buf_s-coeff.obj-code = p-obj-code
     2435             and buf_s-coeff.s-date <= v-date
     2436       no-error.
     2437       if available buf_s-coeff
     2438       then do:
     2439           assign
     2440               p-coeff-value = buf_s-coeff.coeff-value
     2441           .
     2442           return.
     2443       end.
     2444       find last buf_s-coeff no-lock
     2445           where buf_s-coeff.gds-code = p-gds-code
     2446             and buf_s-coeff.host-code = v-host-code
     2447             and buf_s-coeff.obj-type = "":U
     2448             and buf_s-coeff.obj-code = 0
     2449             and buf_s-coeff.s-date <= v-date
     2450       no-error.
     2451       if available buf_s-coeff
     2452       then do:
     2453           assign
     2454               p-coeff-value = buf_s-coeff.coeff-value
     2455           .
     2456           return.
     2457       end.
     2458       find last buf_s-coeff no-lock
     2459           where buf_s-coeff.gds-code = p-gds-code
     2460             and buf_s-coeff.host-code = 0
     2461             and buf_s-coeff.obj-type = "":U
     2462             and buf_s-coeff.obj-code = 0
     2463             and buf_s-coeff.s-date <= v-date
     2464       no-error.
     2465       if available buf_s-coeff
     2466       then do:
     2467           assign
     2468               p-coeff-value = buf_s-coeff.coeff-value
     2469           .
     2470       end.
     2471       else do:
     2472           assign
     2473               p-coeff-value = 0
     2474           .
     2475       end.
     2476   end.
     2477   end procedure.
     2478   procedure fbrlib_create-fbr-recipe-gds :
     2479   define input parameter p-doc-code         as character      no-undo.
     2480   define input parameter p-recipe-code      as character      no-undo.
     2481   define input parameter p-prod-type        as character      no-undo.
     2482   define input parameter p-prod-code        as integer        no-undo.
     2483   define input parameter p-artic            as character      no-undo.
     2484   define input parameter p-gds-code         as integer        no-undo.
     2485   define input parameter p-is-waste         as logical        no-undo.
     2486   define input parameter p-proc-number      as integer        no-undo.
     2487   define input parameter p-obj-date         as date           no-undo.
     2488   define input parameter p-obj-type         as character      no-undo.
     2489   define input parameter p-obj-code         as integer        no-undo.
     2490   define input parameter p-calc-method      as decimal        no-undo.
     2491   define input parameter p-coeff-waste      as decimal        no-undo.
     2492   define input parameter p-orig-qnty        as decimal        no-undo.
     2493   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2494       define variable v-coeff-season  as decimal      no-undo.
     2495       define variable v-void-decimal  as decimal      no-undo.
     2496       define variable v-void-integer  as integer      no-undo.
     2497       define variable v-recipe-type   as character    no-undo.
     2498       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2499       define buffer buf_goods             for ub.goods.
     2500       define buffer buf_recipe            for ub.recipe.
     2501   do
     2502   for buf_fbr-recipe-gds
     2503     , buf_recipe
     2504     , buf_goods
     2505   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2506   :
     2507       find first buf_fbr-recipe-gds exclusive-lock
     2508            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2509              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2510              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2511              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2512              and buf_fbr-recipe-gds.artic       = p-artic
     2513       no-error.
     2514       if not available buf_fbr-recipe-gds
     2515       then do:
     2516           create buf_fbr-recipe-gds.
     2517           assign
     2518               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2519               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2520               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2521               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2522               buf_fbr-recipe-gds.artic              = p-artic
     2523               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2524               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2525               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2526               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2527               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2528           .
     2529           find first buf_goods no-lock
     2530                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2531                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2532                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2533           .
     2534           run fbrlib-s-coeff-value in this-procedure (
     2535                 input buf_goods.gds-code
     2536               , input p-obj-date
     2537               , input p-obj-type
     2538               , input p-obj-code
     2539               , output v-coeff-season
     2540           ) no-error.
     2541           if error-status:error
     2542           then do:
     2543               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2544           end.
     2545           assign
     2546               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2547               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2548               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2549           .
     2550           run fbrlib-get-recipe-type in this-procedure (
     2551                 input buf_fbr-recipe-gds.doc-code
     2552               , input buf_fbr-recipe-gds.recipe-code
     2553               , output v-recipe-type
     2554           ).
     2555           if v-recipe-type <> 'производство':U
     2556           then do:
     2557               assign
     2558                   buf_fbr-recipe-gds.coeff-value  = 0
     2559                   buf_fbr-recipe-gds.coeff-waste  = 0
     2560                   buf_fbr-recipe-gds.calc-method  = 1
     2561                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2562               .
     2563           end.
     2564           else do:
     2565               run fbrlib-calc-brutto in this-procedure (
     2566                     input v-recipe-type
     2567                   , input buf_fbr-recipe-gds.qnty
     2568                   , input buf_fbr-recipe-gds.coeff-value
     2569                   , input buf_fbr-recipe-gds.coeff-waste
     2570                   , input 0
     2571                   , input 3
     2572                   , output v-void-decimal
     2573                   , output v-void-decimal
     2574                   , output buf_fbr-recipe-gds.brutto-qnty
     2575                   , output v-void-integer
     2576               ).
     2577               assign
     2578                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2579               .
     2580               run fbrlib-calc-brutto in this-procedure (
     2581                     input v-recipe-type
     2582                   , input buf_fbr-recipe-gds.qnty
     2583                   , input buf_fbr-recipe-gds.coeff-value
     2584                   , input buf_fbr-recipe-gds.coeff-waste
     2585                   , input buf_fbr-recipe-gds.brutto-qnty
     2586                   , input buf_fbr-recipe-gds.calc-method
     2587                   , output buf_fbr-recipe-gds.qnty
     2588                   , output v-void-decimal
     2589                   , output v-void-decimal
     2590                   , output v-void-integer
     2591               ).
     2592           end.
     2593       end.
     2594   end.
     2595   end procedure.
     2596   procedure fbrlib-set-default-recipe :
     2597   define input parameter p-obj-type   as character    no-undo.
     2598   define input parameter p-obj-code   as integer      no-undo.
     2599   define input parameter p-gds-code   as integer      no-undo.
     2600       define variable v-artic             as character    no-undo.
     2601       define variable v-prod-type         as character    no-undo.
     2602       define variable v-prod-code         as character    no-undo.
     2603       define variable v-recipe-code       as character    no-undo.
     2604       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2605       define variable v-recipe-found      as logical      no-undo.
     2606       define buffer buf_recipe        for ub.recipe.
     2607       define buffer buf_other_recipe  for ub.recipe.
     2608       define buffer buf_goods         for ub.goods.
     2609       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2610   do
     2611   for buf_recipe
     2612     , buf_goods
     2613     , buf_fbr-gds-obj
     2614   on error undo, return error
     2615   :
     2616       find first buf_goods no-lock
     2617            where buf_goods.gds-code = p-gds-code
     2618       .
     2619       run fbrlib-get-obj-recipe in this-procedure (
     2620             input p-obj-type
     2621           , input p-obj-code
     2622           , input p-gds-code
     2623           , output v-recipe-code
     2624       ).
     2625       if v-recipe-code <> ""
     2626       then do:
     2627           find first buf_recipe no-lock
     2628               where buf_recipe.recipe-code = v-recipe-code
     2629           no-error.
     2630           if not available buf_recipe
     2631           then do:
     2632               assign
     2633                   v-recipe-code = ""
     2634               .
     2635           end.
     2636       end.
     2637       if v-recipe-code = ""
     2638       then do:
     2639           find first buf_fbr-gds-obj exclusive-lock
     2640                where buf_fbr-gds-obj.obj-type = p-obj-type
     2641                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2642                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2643           no-error.
     2644           if not available buf_fbr-gds-obj
     2645           then do:
     2646               run ref/fgdsobj1.p (
     2647                     input-output v-fbr-gds-obj-recid
     2648                   , input 'ДОБАВЛЕНИЕ':U
     2649                   , input no
     2650                   , input p-gds-code
     2651                   , input p-obj-type
     2652                   , input p-obj-code
     2653                   , input 0
     2654                   , input ""
     2655                   , input 0
     2656                   , input no
     2657                   , input no
     2658                   , input no
     2659                   , input no
     2660                   , input no
     2661                   , input no
     2662               ) no-error.
     2663               if error-status:error
     2664               then do:
     2665                   message
     2666                           vss-workfile vss-revision vss-description
     2667                       skip "Ошибка изменения атрибутов товара на объекте"
     2668                       skip return-value
     2669                       skip trim(error-status :get-message(1))
     2670                               trim(error-status :get-message(2))
     2671                               trim(error-status :get-message(3))
     2672                   view-as alert-box error.
     2673                   undo, return error .
     2674               end.
     2675               find first buf_fbr-gds-obj exclusive-lock
     2676                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2677               .
     2678           end.
     2679           assign
     2680               v-recipe-found = no
     2681           .
     2682           for first buf_recipe no-lock
     2683               where buf_recipe.obj-type    = p-obj-type
     2684                 and buf_recipe.obj-code    = p-obj-code
     2685                 and buf_recipe.artic       = buf_goods.artic
     2686                 and buf_recipe.prod-type   = buf_goods.prod-type
     2687                 and buf_recipe.prod-code   = buf_goods.prod-code
     2688                 and buf_recipe.recipe-type = 'производство':U
     2689                 or (
     2690                     buf_recipe.obj-type    = ""
     2691                 and buf_recipe.obj-code    = 0
     2692                 and buf_recipe.artic       = buf_goods.artic
     2693                 and buf_recipe.prod-type   = buf_goods.prod-type
     2694                 and buf_recipe.prod-code   = buf_goods.prod-code
     2695                 and buf_recipe.recipe-type = 'производство':U
     2696                     )
     2697           :
     2698               assign
     2699                   v-recipe-found = yes
     2700                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2701               .
     2702           end.
     2703           if v-recipe-found = no
     2704           then do:
     2705               for first buf_recipe no-lock
     2706                   where buf_recipe.obj-type    = p-obj-type
     2707                     and buf_recipe.obj-code    = p-obj-code
     2708                     and buf_recipe.artic       = buf_goods.artic
     2709                     and buf_recipe.prod-type   = buf_goods.prod-type
     2710                     and buf_recipe.prod-code   = buf_goods.prod-code
     2711                     and buf_recipe.recipe-type <> 'альтернатива':U
     2712                     or (
     2713                         buf_recipe.obj-type    = ""
     2714                     and buf_recipe.obj-code    = 0
     2715                     and buf_recipe.artic       = buf_goods.artic
     2716                     and buf_recipe.prod-type   = buf_goods.prod-type
     2717                     and buf_recipe.prod-code   = buf_goods.prod-code
     2718                     and buf_recipe.recipe-type <> 'альтернатива':U
     2719                         )
     2720               :
     2721                   assign
     2722                       v-recipe-found = yes
     2723                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2724                   .
     2725               end.
     2726               if v-recipe-found = no
     2727               then do:
     2728                   for first buf_recipe no-lock
     2729                       where buf_recipe.obj-type    = p-obj-type
     2730                         and buf_recipe.obj-code    = p-obj-code
     2731                         and buf_recipe.artic       = buf_goods.artic
     2732                         and buf_recipe.prod-type   = buf_goods.prod-type
     2733                         and buf_recipe.prod-code   = buf_goods.prod-code
     2734                         or (
     2735                             buf_recipe.obj-type    = ""
     2736                         and buf_recipe.obj-code    = 0
     2737                         and buf_recipe.artic       = buf_goods.artic
     2738                         and buf_recipe.prod-type   = buf_goods.prod-type
     2739                         and buf_recipe.prod-code   = buf_goods.prod-code
     2740                             )
     2741                   :
     2742                       assign
     2743                           v-recipe-found = yes
     2744                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2745                       .
     2746                   end.
     2747                   if v-recipe-found = no
     2748                   then do:
     2749                       assign
     2750                           buf_fbr-gds-obj.default-recipe-code = ""
     2751                       .
     2752                   end.
     2753               end.
     2754           end.
     2755       end.
     2756   end.
     2757   end procedure.
     2758   procedure fbrlib-get-obj-recipe :
     2759   define input parameter p-obj-type       as character    no-undo.
     2760   define input parameter p-obj-code       as integer      no-undo.
     2761   define input parameter p-gds-code       as integer      no-undo.
     2762   define output parameter p-recipe-code   as character    no-undo.
     2763       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2764   do
     2765   for buf_fbr-gds-obj
     2766   on error undo, return error
     2767   :
     2768       find first buf_fbr-gds-obj no-lock
     2769            where buf_fbr-gds-obj.obj-type = p-obj-type
     2770              and buf_fbr-gds-obj.obj-code = p-obj-code
     2771              and buf_fbr-gds-obj.gds-code = p-gds-code
     2772       no-error.
     2773       if available buf_fbr-gds-obj
     2774       then do:
     2775           assign
     2776               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2777           .
     2778       end.
     2779       else do:
     2780           assign
     2781               p-recipe-code = ""
     2782           .
     2783       end.
     2784   end.
     2785   end procedure.
     2786   procedure fbrlib-create-or-update-recipe-gds :
     2787   define input parameter p-recipe-code    as character        no-undo.
     2788   define input parameter p-gds-code       as integer          no-undo.
     2789   define input parameter p-is-waste       as logical          no-undo.
     2790   define input parameter p-qnty           as decimal          no-undo.
     2791   define input parameter p-proc-number    as integer          no-undo.
     2792   define input parameter p-nws-self       as logical          no-undo.
     2793       define variable v-max-proc-num  as integer      no-undo.
     2794       define variable v-recipe-type   as character    no-undo.
     2795       define buffer buf_goods             for ub.goods.
     2796       define buffer buf_recipe-gds        for ub.recipe-gds.
     2797       define buffer buf_recipe            for ub.recipe.
     2798       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2799   do
     2800   for buf_goods
     2801     , buf_recipe-gds
     2802     , buf_recipe
     2803     , buf_proc_recipe-gds
     2804   on error undo, return error
     2805   :
     2806       find first buf_recipe no-lock
     2807            where buf_recipe.recipe-code = p-recipe-code
     2808       .
     2809       find first buf_goods no-lock
     2810            where buf_goods.gds-code = p-gds-code
     2811       .
     2812       find first buf_recipe-gds
     2813            where buf_recipe-gds.recipe-code = p-recipe-code
     2814              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2815              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2816              and buf_recipe-gds.artic       = buf_goods.artic
     2817       no-error.
     2818       if not available buf_recipe-gds
     2819       then do:
     2820           create buf_recipe-gds.
     2821           assign
     2822               buf_recipe-gds.recipe-code = p-recipe-code
     2823               buf_recipe-gds.gds-code    = p-gds-code
     2824               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2825               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2826               buf_recipe-gds.artic       = buf_goods.artic
     2827           .
     2828           assign
     2829               buf_recipe-gds.is-waste    = no
     2830               buf_recipe-gds.qnty        = 0
     2831               buf_recipe-gds.coeff-waste = 0
     2832               buf_recipe-gds.brutto-qnty = 0
     2833               buf_recipe-gds.proc-number = 0
     2834               buf_recipe-gds.nws-self    = no
     2835           .
     2836       end.
     2837       assign
     2838           buf_recipe-gds.is-waste    = p-is-waste
     2839       .
     2840       run fbrlib-get-recipe-type in this-procedure (
     2841             input "":U
     2842           , input buf_recipe-gds.recipe-code
     2843           , output v-recipe-type
     2844       ).
     2845       if v-recipe-type <> 'производство':U
     2846       then do:
     2847           assign
     2848               buf_recipe-gds.calc-method = 1
     2849               buf_recipe-gds.qnty        = p-qnty
     2850               buf_recipe-gds.brutto-qnty = p-qnty
     2851               buf_recipe-gds.coeff-waste = 0
     2852           .
     2853       end.
     2854       else do:
     2855           assign
     2856               buf_recipe-gds.calc-method = 1
     2857               buf_recipe-gds.brutto-qnty = p-qnty
     2858           .
     2859           run fbrlib-calc-brutto in this-procedure (
     2860                 input v-recipe-type
     2861               , input 0
     2862               , input 0
     2863               , input buf_recipe-gds.coeff-waste
     2864               , input buf_recipe-gds.brutto-qnty
     2865               , input 1
     2866               , output buf_recipe-gds.qnty
     2867               , output buf_recipe-gds.coeff-waste
     2868               , output buf_recipe-gds.brutto-qnty
     2869               , output buf_recipe-gds.calc-method
     2870           ).
     2871       end.
     2872       assign
     2873           buf_recipe-gds.nws-self    = p-nws-self
     2874       .
     2875       if buf_recipe.recipe-type = 'альтернатива':U
     2876       and buf_recipe-gds.proc-number <> 0
     2877       then do:
     2878       end.
     2879       else do:
     2880           if p-proc-number <> 0
     2881           then do:
     2882               assign
     2883                   buf_recipe-gds.proc-number = p-proc-number
     2884               .
     2885           end.
     2886           else do:
     2887               assign
     2888                   v-max-proc-num = 0
     2889               .
     2890               for each buf_proc_recipe-gds no-lock
     2891                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2892               :
     2893                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2894                   then do:
     2895                       assign
     2896                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2897                       .
     2898                   end.
     2899               end.
     2900               assign
     2901                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2902               .
     2903           end.
     2904       end.
     2905   end.
     2906   end procedure.
     2907   PROCEDURE fbrlib-create-or-update-recipe :
     2908   define input parameter p-mode               as character    no-undo.
     2909   define input parameter p-obj-type           as character    no-undo.
     2910   define input parameter p-obj-code           as integer      no-undo.
     2911   define input parameter p-recipe-code        as character    no-undo.
     2912   define input parameter p-recipe-type        as character    no-undo.
     2913   define input parameter p-gds-code           as integer      no-undo.
     2914   define input parameter p-name               as character    no-undo.
     2915   define input parameter p-design             as character    no-undo.
     2916   define input parameter p-order              as integer      no-undo.
     2917   define input parameter p-quality            as character    no-undo.
     2918   define input parameter p-ref-num            as character    no-undo.
     2919   define input parameter p-technique          as character    no-undo.
     2920   define input parameter p-template           as character    no-undo.
     2921   define input parameter p-qnty               as decimal      no-undo.
     2922   define input parameter p-portion-qnty       as integer      no-undo.
     2923   define input parameter p-portion-weight     as decimal      no-undo.
     2924   define output parameter p-new-recipe-code   as character    no-undo.
     2925       define variable v-host-code         as integer      no-undo.
     2926       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2927       define buffer buf_recipe    for ub.recipe.
     2928       define buffer buf_goods     for ub.goods.
     2929   do
     2930   for buf_recipe
     2931     , buf_goods
     2932   on error undo, return error
     2933   :
     2934       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2935       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2936       then do:
     2937           message
     2938               skip "Ошибка задания типа операции для создания или измения рецепта."
     2939               skip (1)
     2940               skip "Задан тип операции:" p-mode
     2941           view-as alert-box error.
     2942           undo, return error .
     2943       end.
     2944       if p-recipe-code = ""
     2945       then do:
     2946   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2947   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2948     (input  p-obj-type
     2949     ,input  p-obj-code
     2950     ,output v-host-code
     2951     )  .
     2952           find first buf_goods no-lock
     2953                where buf_goods.gds-code = p-gds-code
     2954           .
     2955           create buf_recipe .
     2956           run fbrcode-gen-recipe-code in this-procedure (
     2957                 input p-obj-type
     2958               , input p-obj-code
     2959               , output buf_recipe.recipe-code
     2960           ).
     2961           assign
     2962               buf_recipe.artic               = buf_goods.artic
     2963               buf_recipe.prod-type           = buf_goods.prod-type
     2964               buf_recipe.prod-code           = buf_goods.prod-code
     2965               buf_recipe.recipe-type         = p-recipe-type
     2966               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2967               buf_recipe.gds-code            = p-gds-code
     2968               buf_recipe.host-code           = v-host-code
     2969               buf_recipe.obj-type            = p-obj-type
     2970               buf_recipe.obj-code            = p-obj-code
     2971               buf_recipe.recipe-design       = ""
     2972               buf_recipe.recipe-order        = 0
     2973               buf_recipe.recipe-quality      = ""
     2974               buf_recipe.recipe-ref-num      = ""
     2975               buf_recipe.recipe-technique    = ""
     2976               buf_recipe.recipe-template     = ""
     2977               buf_recipe.qnty                = 1.0
     2978               buf_recipe.portion-qnty        = 1
     2979               buf_recipe.portion-weight      = 0
     2980           .
     2981       end.
     2982       if p-name <> ""
     2983       then do:
     2984           assign
     2985               buf_recipe.recipe-name = p-name
     2986           .
     2987       end.
     2988       assign
     2989           buf_recipe.recipe-design       = p-design
     2990           buf_recipe.recipe-order        = p-order
     2991           buf_recipe.recipe-quality      = p-quality
     2992           buf_recipe.recipe-ref-num      = p-ref-num
     2993           buf_recipe.recipe-technique    = p-technique
     2994           buf_recipe.recipe-template     = p-template
     2995           buf_recipe.qnty                = p-qnty
     2996           buf_recipe.portion-qnty        = p-portion-qnty
     2997           buf_recipe.portion-weight      = p-portion-weight
     2998       .
     2999       assign
     3000           p-new-recipe-code = buf_recipe.recipe-code
     3001       .
     3002       run fbrlib-set-default-recipe in this-procedure (
     3003             input p-obj-type
     3004           , input p-obj-code
     3005           , input buf_goods.gds-code
     3006       ).
     3007   end.
     3008   END PROCEDURE.
     3009   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3010   define input parameter parparentproc-handle as widget-handle no-undo .
     3011   define input parameter p-doc-code   as character no-undo.
     3012   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3013       define variable v-shift-on      as logical      no-undo.
     3014       define variable v-shift-date    as date         no-undo.
     3015       define variable v-shift-num     as integer      no-undo.
     3016       define variable v-shift-name    as character    no-undo.
     3017       define variable v-obj-date      as date         no-undo.
     3018       define variable v-chip-num      as integer      no-undo.
     3019       define buffer buf_fbr-doc       for ub.fbr-doc.
     3020       define buffer buf_fbr-line      for ub.fbr-line.
     3021       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3022       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3023       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3024       define buffer buf_marking-lines for ub.marking-lines .
     3025       define buffer buf_marking       for ub.marking .
     3026       define buffer buf_goods         for ub.goods .
     3027   do
     3028   for buf_fbr-doc
     3029     , buf_fbr-line
     3030     , buf_c-fbr-doc
     3031     , buf_fbr-recipe
     3032     , buf_fbr-recipe-gds
     3033     , buf_goods
     3034     , buf_marking
     3035     , buf_marking-lines
     3036   on error undo, return error
     3037   :
     3038   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3039     define variable v-cntxt-db-num        as integer   no-undo .
     3040     define variable v-cntxt-userid        as character no-undo .
     3041     define variable v-cntxt-level         as character no-undo .
     3042     define variable v-cntxt-host-code-obj as integer   no-undo .
     3043     define variable v-cntxt-obj-type      as character no-undo .
     3044     define variable v-cntxt-obj-code      as integer   no-undo .
     3045     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3046     define variable v-cntxt-is-admin      as logical   no-undo .
     3047   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3048     run mainmenu_getcntxt in parparentproc-handle
     3049       (output v-cntxt-db-num
     3050       ,output v-cntxt-userid
     3051       ,output v-cntxt-level
     3052       ,output v-cntxt-host-code-obj
     3053       ,output v-cntxt-obj-type
     3054       ,output v-cntxt-obj-code
     3055       ,output v-cntxt-db-num-obj
     3056       ,output v-cntxt-is-admin
     3057       ) .
     3058       if search ("delfbr.err") <> ?
     3059       then do:
     3060           os-delete "delfbr.err".
     3061       end.
     3062     _del-block:
     3063       do transaction
     3064     on error undo _del-block, return error return-value
     3065     on endkey undo _del-block , return error return-value
     3066     on stop undo _del-block , return error return-value
     3067       :
     3068           find first buf_fbr-doc exclusive-lock
     3069                where buf_fbr-doc.doc-code = p-doc-code
     3070           no-error.
     3071           if not available buf_fbr-doc
     3072           then do:
     3073         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3074                                           ,vss-workfile
     3075                                           ,vss-revision
     3076                                           ,vss-description
     3077                                           ,chr(10)
     3078                                           , p-doc-code).
     3079           end.
     3080           run fbrlib-delete-fact-trn-doc in this-procedure (
     3081               input parparentproc-handle
     3082              ,input p-doc-code
     3083              ,input 'при':U
     3084              ,input p-chip-num
     3085              ,output v-chip-num
     3086           ) no-error.
     3087           if error-status :error
     3088           then do:
     3089               run fbrlib-print-del-error-message in this-procedure .
     3090         undo _del-block, return error.
     3091           end.
     3092           assign
     3093           p-chip-num = (if p-chip-num = ?
     3094                         then v-chip-num
     3095                         else p-chip-num).
     3096           run fbrlib-delete-fact-trn-doc in this-procedure (
     3097               input parparentproc-handle
     3098              ,input p-doc-code
     3099              ,input 'рас':U
     3100              ,input p-chip-num
     3101              ,output v-chip-num
     3102           ) no-error.
     3103           if error-status :error
     3104           then do:
     3105               run fbrlib-print-del-error-message in this-procedure .
     3106         undo _del-block, return error.
     3107           end.
     3108           run fbrlib-delete-fact-trn-doc in this-procedure (
     3109               input parparentproc-handle
     3110              ,input p-doc-code
     3111              ,input 'спи':U
     3112              ,input p-chip-num
     3113              ,output v-chip-num
     3114           ) no-error.
     3115           if error-status :error
     3116           then do:
     3117               run fbrlib-print-del-error-message in this-procedure .
     3118         undo _del-block, return error.
     3119           end.
     3120           create buf_c-fbr-doc.
     3121           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3122   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3124     (input  buf_fbr-doc.obj-type
     3125     ,input  buf_fbr-doc.obj-code
     3126     ,output v-obj-date
     3127     ) no-error .
     3128           if error-status :error
     3129           or v-obj-date = ?
     3130           then do:
     3131         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3132           end.
     3133   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3135     (input  buf_fbr-doc.obj-type
     3136     ,input  buf_fbr-doc.obj-code
     3137     ,input  'shift-on=request'
     3138     ,output v-shift-on
     3139     )  .
     3140           if v-shift-on
     3141           then do:
     3142   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3144     (input  buf_fbr-doc.obj-type
     3145     ,input  buf_fbr-doc.obj-code
     3146     ,output v-shift-date
     3147     ,output v-shift-num
     3148     ,output v-shift-name
     3149     ) no-error .
     3150               if error-status :error
     3151               then do:
     3152           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3153               end.
     3154           end.
     3155           else do:
     3156               assign
     3157                   v-shift-date = ?
     3158                   v-shift-num  = ?
     3159                   v-shift-name = ?
     3160               .
     3161           end.
     3162           define variable v-today       as date         no-undo.
     3163           define variable v-time        as integer      no-undo.
     3164           run cur-time in this-procedure (
     3165                 output v-today
     3166               , output v-time
     3167           ).
     3168           assign
     3169               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3170               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3171               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3172               buf_c-fbr-doc.corr-date        = v-today
     3173               buf_c-fbr-doc.corr-time        = v-time
     3174               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3175               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3176               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3177               buf_c-fbr-doc.is-del           = yes
     3178           .
     3179           assign
     3180               buf_fbr-doc.is-del = yes
     3181           .
     3182           for each buf_fbr-line exclusive-lock
     3183              where buf_fbr-line.doc-code = p-doc-code
     3184       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3185       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3186       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3187           :
     3188               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3189                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3190                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3191               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3192                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3193                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3194                                                       and buf_marking-lines.in-code  = "manufacturing"
     3195                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3196                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3197                                                       and buf_marking-lines.prt-code = 0
     3198               :
     3199                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3200                   assign
     3201                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3202                   .
     3203                 end .
     3204                 delete buf_marking-lines.
     3205               end .
     3206               delete buf_fbr-line.
     3207           end.
     3208           for each buf_fbr-recipe exclusive-lock
     3209              where buf_fbr-recipe.doc-code = p-doc-code
     3210       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3211       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3212       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3213           :
     3214               delete buf_fbr-recipe.
     3215           end.
     3216           for each buf_fbr-recipe-gds exclusive-lock
     3217              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3218       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3219       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3220       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3221           :
     3222               delete buf_fbr-recipe-gds.
     3223           end.
     3224           delete buf_fbr-doc.
     3225       end.
     3226   end.
     3227   END PROCEDURE.
     3228   PROCEDURE fbrlib-del-trn-doc :
     3229   do
     3230   on error undo, return error
     3231   :
     3232   define input parameter parparentproc        as widget-handle no-undo .
     3233   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3234   define input parameter p-trn-doc-type       as character    no-undo.
     3235   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3236   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3237       define variable v-trn-doc-doc-code  as character     no-undo.
     3238       define buffer buf_trn-doc       for ub.trn-doc.
     3239   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3240     define variable v-cntxt-db-num        as integer   no-undo .
     3241     define variable v-cntxt-userid        as character no-undo .
     3242     define variable v-cntxt-level         as character no-undo .
     3243     define variable v-cntxt-host-code-obj as integer   no-undo .
     3244     define variable v-cntxt-obj-type      as character no-undo .
     3245     define variable v-cntxt-obj-code      as integer   no-undo .
     3246     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3247     define variable v-cntxt-is-admin      as logical   no-undo .
     3248   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3249     run mainmenu_getcntxt in parparentproc
     3250       (output v-cntxt-db-num
     3251       ,output v-cntxt-userid
     3252       ,output v-cntxt-level
     3253       ,output v-cntxt-host-code-obj
     3254       ,output v-cntxt-obj-type
     3255       ,output v-cntxt-obj-code
     3256       ,output v-cntxt-db-num-obj
     3257       ,output v-cntxt-is-admin
     3258       ) .
     3259       run fbrcode-trn-doc in this-procedure (
     3260             input 'производство':U
     3261           , input p-fbr-doc-doc-code
     3262           , input p-trn-doc-type
     3263           , output v-trn-doc-doc-code
     3264       ).
     3265       find first buf_trn-doc no-lock
     3266            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3267       no-error.
     3268       if available buf_trn-doc
     3269       then do:
     3270           run str/del-doc.p (
     3271                 input parparentproc
     3272               , input buf_trn-doc.doc-code
     3273               , input v-cntxt-db-num
     3274               , input "del-doc.err"
     3275               , input ?
     3276               , input p-fbr-doc-doc-code
     3277               , input v-cntxt-userid
     3278               , input 0
     3279               , input p-phchip-num
     3280               , output p-chip-num
     3281           ) no-error.
     3282           if error-status :error
     3283           then do:
     3284             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3285                                           ,v-trn-doc-doc-code
     3286                                           ,p-fbr-doc-doc-code
     3287                                           , chr(10)
     3288                                           , error-status:get-message(1)
     3289                                           , return-value ).
     3290           end.
     3291       end.
     3292   end.
     3293   END PROCEDURE.
     3294   PROCEDURE fbrlib-delete-fact-trn-doc :
     3295   define input parameter parparentproc    as widget-handle    no-undo.
     3296   define input parameter p-fbr-doc-code   as character        no-undo.
     3297   define input parameter p-doc-type       as character    no-undo.
     3298   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3299   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3300       define variable v-doc-code          as character        no-undo.
     3301       define variable v-ext-doc-type      as character        no-undo.
     3302       define variable v-trn-doc-recid     as recid            no-undo.
     3303       define variable varchip-code        as integer          no-undo.
     3304       define variable varchip-code2       as integer          no-undo.
     3305       define variable v-chip-counter      as integer          no-undo.
     3306       define buffer buf_trn-doc       for ub.trn-doc.
     3307       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3308       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3309   do
     3310   for buf_trn-doc
     3311     , buf_pri_trn-doc
     3312     , buf_cons_trn-doc
     3313   on error undo, return error
     3314   :
     3315   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3316     define variable v-cntxt-db-num        as integer   no-undo .
     3317     define variable v-cntxt-userid        as character no-undo .
     3318     define variable v-cntxt-level         as character no-undo .
     3319     define variable v-cntxt-host-code-obj as integer   no-undo .
     3320     define variable v-cntxt-obj-type      as character no-undo .
     3321     define variable v-cntxt-obj-code      as integer   no-undo .
     3322     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3323     define variable v-cntxt-is-admin      as logical   no-undo .
     3324   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3325     run mainmenu_getcntxt in parparentproc
     3326       (output v-cntxt-db-num
     3327       ,output v-cntxt-userid
     3328       ,output v-cntxt-level
     3329       ,output v-cntxt-host-code-obj
     3330       ,output v-cntxt-obj-type
     3331       ,output v-cntxt-obj-code
     3332       ,output v-cntxt-db-num-obj
     3333       ,output v-cntxt-is-admin
     3334       ) .
     3335       run fbrcode-trn-doc in this-procedure (
     3336             input 'производство':U
     3337           , input p-fbr-doc-code
     3338           , input p-doc-type
     3339           , output v-doc-code
     3340       ).
     3341       find first buf_trn-doc no-lock
     3342            where buf_trn-doc.doc-code = v-doc-code
     3343       no-error.
     3344       if not available buf_trn-doc
     3345       then do:
     3346           if p-doc-type <> 'спи':U
     3347           then do:
     3348               message
     3349                   "Не найден документ '" p-doc-type "'"
     3350                   "по документу производства " p-fbr-doc-code
     3351               view-as alert-box.
     3352               undo, return error.
     3353           end.
     3354           else do:
     3355           end.
     3356       end.
     3357       else do:
     3358           assign
     3359               v-trn-doc-recid = recid( buf_trn-doc )
     3360               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3361           .
     3362           if v-ext-doc-type = 'ev':U
     3363           then do:
     3364               find first buf_pri_trn-doc no-lock
     3365                    where buf_pri_trn-doc.out-code     = v-doc-code
     3366                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3367               no-error.
     3368               if available buf_pri_trn-doc
     3369               then do:
     3370                   run str/del-doc.p (
     3371                         input parparentproc
     3372                       , input buf_pri_trn-doc.doc-code
     3373                       , input v-cntxt-db-num
     3374                       , input "delfbr.err"
     3375                       , input ?
     3376                       , input p-fbr-doc-code
     3377                       , input v-cntxt-userid
     3378                       , input 0
     3379                       , input (if p-ph-chip-num <> ?
     3380                               then p-ph-chip-num
     3381                               else (if varchip-code <> 0
     3382                                   then varchip-code
     3383                                   else ?)
     3384                               )
     3385                       , output varchip-code2
     3386                   ) no-error.
     3387                   if error-status :error
     3388                   then do:
     3389                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3390                                                   ,buf_pri_trn-doc.doc-code
     3391                                                   ,p-fbr-doc-code
     3392                                                   , chr(10)
     3393                                                   , error-status:get-message(1)
     3394                                                   , return-value ).
     3395                   end.
     3396               end.
     3397           end.
     3398           define buffer buf_out_trn-doc       for ub.trn-doc.
     3399           if p-doc-type = 'при':U
     3400           then do:
     3401               assign
     3402                   v-chip-counter = 0
     3403               .
     3404               for each buf_out_trn-doc exclusive-lock
     3405                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3406               on error undo, return error
     3407               :
     3408                   assign
     3409                       v-chip-counter = v-chip-counter + 1
     3410                   .
     3411                   if v-chip-counter > 1
     3412                   then do:
     3413                       assign
     3414                           varchip-code = varchip-code2
     3415                       .
     3416                   end.
     3417                   run str/del-doc.p (
     3418                         input parparentproc
     3419                       , input buf_out_trn-doc.doc-code
     3420                       , input v-cntxt-db-num
     3421                       , input "delfbr.err"
     3422                       , input ?
     3423                       , input p-fbr-doc-code
     3424                       , input v-cntxt-userid
     3425                       , input 0
     3426                       , input (if p-ph-chip-num <> ?
     3427                               then p-ph-chip-num
     3428                               else (if varchip-code <> 0
     3429                                   then varchip-code
     3430                                   else ?)
     3431                               )
     3432                       , output varchip-code2
     3433                   ) no-error.
     3434                   if error-status :error
     3435                   then do:
     3436                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3437                                                   ,buf_out_trn-doc.doc-code
     3438                                                   ,buf_trn-doc.doc-code
     3439                                                   ,p-fbr-doc-code
     3440                                                   , chr(10)
     3441                                                   , error-status:get-message(1)
     3442                                                   , return-value ).
     3443                   end.
     3444               end.
     3445           end.
     3446           run str/del-doc.p (
     3447                 input parparentproc
     3448               , input buf_trn-doc.doc-code
     3449               , input v-cntxt-db-num
     3450               , input "delfbr.err"
     3451               , input ?
     3452               , input p-fbr-doc-code
     3453               , input v-cntxt-userid
     3454               , input 0
     3455               , input (if p-ph-chip-num <> ?
     3456                        then p-ph-chip-num
     3457                        else (if varchip-code <> 0
     3458                              then varchip-code
     3459                              else ?)
     3460                        )
     3461               , output varchip-code2
     3462           ) no-error.
     3463           if error-status :error
     3464           then do:
     3465               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3466                                             ,buf_trn-doc.doc-code
     3467                                             ,p-fbr-doc-code
     3468                                             , chr(10)
     3469                                             , error-status:get-message(1)
     3470                                             , return-value ).
     3471           end.
     3472           if p-doc-type = 'рас':U
     3473           or p-doc-type = 'спи':U
     3474           then do:
     3475               assign
     3476                   v-chip-counter = 0
     3477               .
     3478               for each buf_cons_trn-doc no-lock
     3479                  where buf_cons_trn-doc.out-code      = v-doc-code
     3480                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3481               :
     3482                   assign
     3483                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3484                       v-chip-counter = v-chip-counter + 1
     3485                   .
     3486                   assign
     3487                   varchip-code = if v-chip-counter = 2
     3488                                  then varchip-code2
     3489                                  else varchip-code.
     3490                   run str/del-doc.p (
     3491                         input parparentproc
     3492                       , input buf_cons_trn-doc.doc-code
     3493                       , input v-cntxt-db-num
     3494                       , input "delfbr.err"
     3495                       , input ?
     3496                       , input ?
     3497                       , input v-cntxt-userid
     3498                       , input 0
     3499                       , input (if p-ph-chip-num <> ?
     3500                                then p-ph-chip-num
     3501                                else ( if v-chip-counter = 1
     3502                                       then ?
     3503                                       else varchip-code )
     3504                                )
     3505                       , output varchip-code2
     3506                   ) no-error.
     3507                   if error-status :error
     3508                   then do:
     3509                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3510                                                     ,buf_cons_trn-doc.doc-code
     3511                                                     ,p-fbr-doc-code
     3512                                                     , chr(10)
     3513                                                     , error-status:get-message(1)
     3514                                                     , return-value ).
     3515                   end.
     3516                   assign
     3517                       p-chip-num = varchip-code2
     3518                   .
     3519               end.
     3520           end.
     3521           assign
     3522               p-chip-num = varchip-code2
     3523           .
     3524       end.
     3525   end.
     3526   END PROCEDURE.
     3527   PROCEDURE fbrlib-print-del-error-message :
     3528   do
     3529   on error undo, return error
     3530   :
     3531       define variable v-user-action   as character    no-undo.
     3532       define variable v-printed       as logical      no-undo.
     3533       message
     3534           vss-workfile vss-revision vss-description
     3535           skip "Ошибка при удалении документа."
     3536           skip return-value
     3537           skip trim(error-status :get-message(1))
     3538           skip trim(error-status :get-message(2))
     3539           skip trim(error-status :get-message(3))
     3540       view-as alert-box error.
     3541       if search ("delfbr.err") <> ?
     3542       then do:
     3543         run gbl/prnfilen.w
     3544           (input  "Ошибки при удалении документа производства"
     3545           ,input  0
     3546           ,input  "delfbr.err"
     3547           ,input  7
     3548           ,output v-user-action
     3549           ,output v-printed
     3550           ).
     3551       end.
     3552   end.
     3553   END PROCEDURE.
     3554   procedure fbrlib-calc-brutto :
     3555   define input parameter p-recipe-type        as character        no-undo.
     3556   define input parameter p-netto              as decimal          no-undo.
     3557   define input parameter p-coeff-value        as decimal          no-undo.
     3558   define input parameter p-coeff-waste        as decimal          no-undo.
     3559   define input parameter p-brutto             as decimal          no-undo.
     3560   define input parameter p-calc-method        as integer          no-undo.
     3561   define output parameter p-new-netto         as decimal          no-undo.
     3562   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3563   define output parameter p-new-brutto        as decimal          no-undo.
     3564   define output parameter p-new-calc-method   as integer          no-undo.
     3565   do
     3566   on error undo, return error
     3567   :
     3568       if p-recipe-type <> 'производство':U
     3569       then do:
     3570           assign
     3571               p-new-coeff-waste = 0
     3572               p-new-calc-method = 1
     3573               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3574               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3575           .
     3576       end.
     3577       else do:
     3578           assign
     3579               p-new-calc-method = p-calc-method
     3580           .
     3581           if p-coeff-waste = 0
     3582           then do:
     3583               assign
     3584                   p-coeff-value = 0
     3585               .
     3586           end.
     3587           case p-calc-method
     3588           :
     3589               when 1
     3590               then do:
     3591                   assign
     3592                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3593                       p-new-coeff-waste   = p-coeff-waste
     3594                       p-new-brutto        = p-brutto
     3595                   .
     3596               end.
     3597               when 2
     3598               then do:
     3599                   assign
     3600                       p-new-netto         = p-netto
     3601                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3602                       p-new-brutto        = p-brutto
     3603                   .
     3604               end.
     3605               when 3
     3606               then do:
     3607                   assign
     3608                       p-new-netto         = p-netto
     3609                       p-new-coeff-waste   = p-coeff-waste
     3610                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3611                   .
     3612               end.
     3613               otherwise do:
     3614                   define variable v-yesno    as logical      no-undo.
     3615                   assign
     3616                       v-yesno = yes
     3617                   .
     3618                   message
     3619                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3620                       skip "Значение метода должно быть 1, 2 или 3."
     3621                       skip(1)
     3622                       skip "Заданное значение:" p-calc-method
     3623                       skip(1)
     3624                       skip "Установить значение метода расчета 1"
     3625                       skip "(расчет нетто по брутто и проценту потерь)?"
     3626                   view-as alert-box warning
     3627                   buttons yes-no
     3628                   title "Неверное значение метода пересчета в строках документа-производства"
     3629                   update v-yesno
     3630                   .
     3631                   if v-yesno = yes
     3632                   then do:
     3633                       assign
     3634                           p-new-calc-method   = 1
     3635                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3636                           p-new-coeff-waste   = p-coeff-waste
     3637                           p-new-brutto        = p-brutto
     3638                       .
     3639                   end.
     3640                   else do:
     3641                       message
     3642                               vss-workfile vss-revision vss-description
     3643                           skip(1)
     3644                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3645                           skip return-value
     3646                           skip trim(error-status :get-message(1))
     3647                               trim(error-status :get-message(2))
     3648                               trim(error-status :get-message(3))
     3649                       view-as alert-box error
     3650                       title "Неверное значение метода расчета"
     3651                       .
     3652                       undo, return error .
     3653                   end.
     3654               end.
     3655           end case.
     3656       end.
     3657   end.
     3658   end procedure.
     3659   procedure fbrlib-check-brutto :
     3660   define input parameter p-recipe-type        as character        no-undo.
     3661   define input parameter p-netto              as decimal          no-undo.
     3662   define input parameter p-coeff-value        as decimal          no-undo.
     3663   define input parameter p-coeff-waste        as decimal          no-undo.
     3664   define input parameter p-brutto             as decimal          no-undo.
     3665   define input parameter p-calc-method        as integer          no-undo.
     3666   define output parameter p-error-message     as character        no-undo.
     3667   define output parameter p-not-good          as logical          no-undo.
     3668   do
     3669   on error undo, return error
     3670   :
     3671       if p-recipe-type <> 'производство':U
     3672       then do:
     3673           if p-netto <> p-brutto
     3674           or p-coeff-waste <> 0
     3675           then do:
     3676               assign
     3677                   p-not-good      = yes
     3678                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3679                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3680               .
     3681           end.
     3682       end.
     3683       else do:
     3684           if p-coeff-waste = 0
     3685           then do:
     3686               assign
     3687                   p-coeff-value = 0
     3688               .
     3689           end.
     3690           case p-calc-method
     3691           :
     3692               when 1
     3693               then do:
     3694                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3695                   then do:
     3696                       assign
     3697                           p-not-good      = yes
     3698                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3699                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3700                       .
     3701                   end.
     3702               end.
     3703               when 2
     3704               then do:
     3705                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3706                   then do:
     3707                       assign
     3708                           p-not-good      = yes
     3709                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3710                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3711                       .
     3712                   end.
     3713               end.
     3714               when 3
     3715               then do:
     3716                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3717                   then do:
     3718                       assign
     3719                           p-not-good      = yes
     3720                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3721                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3722                       .
     3723                   end.
     3724               end.
     3725               otherwise do:
     3726                   assign
     3727                       p-not-good      = yes
     3728                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3729                   .
     3730               end.
     3731           end case.
     3732       end.
     3733   end.
     3734   end procedure.
     3735   procedure fbrlib-check-fbr-recipe :
     3736   define input parameter p-doc-code       as character        no-undo.
     3737   define input parameter p-recipe-code    as character        no-undo.
     3738   define output parameter p-is-correct    as logical          no-undo.
     3739       define variable v-comp-factor    as decimal      no-undo.
     3740       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3741       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3742       define buffer buf_fbr-line          for ub.fbr-line.
     3743   do
     3744   for buf_fbr-recipe
     3745     , buf_fbr-recipe-gds
     3746     , buf_fbr-line
     3747   on error undo, return error
     3748   :
     3749       assign
     3750           p-is-correct = yes
     3751       .
     3752       find first buf_fbr-recipe no-lock
     3753            where buf_fbr-recipe.doc-code    = p-doc-code
     3754              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3755       .
     3756       if not available buf_fbr-recipe then do:
     3757         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3758       end.
     3759       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3760       then do:
     3761       end.
     3762       else do:
     3763           find first buf_fbr-line no-lock
     3764                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3765                  and buf_fbr-line.is-comp     = yes
     3766                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3767                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3768                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3769                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3770           .
     3771           assign
     3772               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3773           .
     3774           recipe-line-cycle:
     3775           for each buf_fbr-recipe-gds no-lock
     3776              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3777                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3778           on error undo, return error
     3779           :
     3780               find first buf_fbr-line no-lock
     3781                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3782                      and buf_fbr-line.is-comp     = no
     3783                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3784                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3785                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3786                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3787               .
     3788               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3789               then do:
     3790                   assign
     3791                       p-is-correct = no
     3792                   .
     3793                   leave recipe-line-cycle.
     3794               end.
     3795           end.
     3796       end.
     3797   end.
     3798   end procedure.
     3799   procedure fbrlib-get-recipe-type :
     3800   define input parameter p-fbr-doc-code   as character        no-undo.
     3801   define input parameter p-recipe-code    as character        no-undo.
     3802   define output parameter p-recipe-type   as character        no-undo.
     3803       define buffer buf_recipe        for ub.recipe.
     3804       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3805   do
     3806   for buf_recipe
     3807     , buf_fbr-recipe
     3808   on error undo, return error
     3809   :
     3810       if p-fbr-doc-code = ""
     3811       then do:
     3812           find first buf_recipe no-lock
     3813                where buf_recipe.recipe-code = p-recipe-code
     3814           no-error.
     3815           if available buf_recipe
     3816           then do:
     3817               assign
     3818                   p-recipe-type = buf_recipe.recipe-type
     3819               .
     3820           end.
     3821           else do:
     3822               assign
     3823                   p-recipe-type = "":U
     3824               .
     3825           end.
     3826       end.
     3827       else do:
     3828           find first buf_fbr-recipe no-lock
     3829                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3830                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3831           no-error.
     3832           if available buf_fbr-recipe
     3833           then do:
     3834               assign
     3835                   p-recipe-type = buf_fbr-recipe.recipe-type
     3836               .
     3837           end.
     3838           else do:
     3839               assign
     3840                   p-recipe-type = "":U
     3841               .
     3842           end.
     3843       end.
     3844   end.
     3845   end procedure.
     3846   PROCEDURE calc-comp-from-ingr :
     3847   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3848   define input parameter p-fact-qnty                          as decimal      no-undo.
     3849   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3850   define output parameter p-comp-qnty                         as decimal      no-undo.
     3851       define variable v-ingr-qnty     as decimal       no-undo.
     3852       define buffer buf_i_fbr-line    for ub.fbr-line.
     3853       define buffer buf_fbr-line      for ub.fbr-line.
     3854       define buffer buf_recipe        for ub.fbr-recipe.
     3855       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3856   do
     3857   for buf_i_fbr-line
     3858     , buf_fbr-line
     3859     , buf_recipe
     3860     , buf_recipe-gds
     3861   on error undo, return error
     3862   :
     3863       find first buf_i_fbr-line no-lock
     3864            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3865       .
     3866       find first buf_recipe no-lock
     3867            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3868              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3869       no-error.
     3870       if not available buf_recipe
     3871       then do:
     3872           message
     3873                   vss-workfile vss-revision vss-description
     3874               skip "В строке производства не указан рецепт."
     3875               skip "Невозможно рассчитать количество составного товара."
     3876               skip return-value
     3877               skip trim(error-status :get-message(1))
     3878                   trim(error-status :get-message(2))
     3879                   trim(error-status :get-message(3))
     3880           view-as alert-box error.
     3881           undo, return error .
     3882       end.
     3883       if buf_recipe.recipe-type = 'альтернатива':U
     3884       then do:
     3885           for each buf_fbr-line no-lock
     3886              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3887                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3888                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3889           on error undo, return error
     3890           :
     3891               find first buf_recipe-gds no-lock
     3892                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3893                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3894                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3895                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3896                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3897               .
     3898               assign
     3899                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3900               .
     3901           end.
     3902           assign
     3903               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3904           .
     3905       end.
     3906       else do:
     3907           find first buf_recipe-gds no-lock
     3908                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3909                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3910                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3911                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3912                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3913           .
     3914           assign
     3915               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3916           .
     3917       end.
     3918       find first buf_fbr-line no-lock
     3919            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3920              and buf_fbr-line.is-comp     = yes
     3921              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3922       .
     3923       assign
     3924           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3925       .
     3926   end.
     3927   END PROCEDURE.
     3928   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3929   define input parameter p-recipe-code    as character    no-undo.
     3930   define input parameter p-gds-code       as integer      no-undo.
     3931   define output parameter p-line-qnty     as decimal      no-undo.
     3932   define output parameter p-used-qnty     as decimal      no-undo.
     3933   define output parameter p-recipe-qnty   as decimal      no-undo.
     3934       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3935   do
     3936   for buf_temp_dressing-ingr
     3937   on error undo, return error
     3938   :
     3939       find first buf_temp_dressing-ingr no-lock
     3940            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3941              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3942       no-error.
     3943       if available buf_temp_dressing-ingr
     3944       then do:
     3945           assign
     3946               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3947               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3948               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3949           .
     3950       end.
     3951       else do:
     3952           assign
     3953               p-line-qnty     = 0
     3954               p-used-qnty     = 0
     3955               p-recipe-qnty   = 0
     3956           .
     3957       end.
     3958   end.
     3959   END PROCEDURE.
     3960   PROCEDURE fbrlib_adjust-recipe :
     3961   do
     3962   on error undo, return error
     3963   :
     3964   define input parameter parparentproc as widget-handle no-undo .
     3965   define input parameter p-fbrhist-handle as handle no-undo .
     3966   define input parameter p-doc-code       as character    no-undo.
     3967   define input parameter p-recipe-code    as character    no-undo.
     3968   define input parameter p-price-sale-obj-type as character no-undo .
     3969   define input parameter p-price-sale-obj-code as integer no-undo .
     3970       define variable v-recipe-qnty       as decimal      no-undo.
     3971       define variable v-comp-qnty         as decimal      no-undo.
     3972       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3973       define variable v-ingr-qnty         as decimal      no-undo.
     3974       define variable v-qnty              as decimal      no-undo.
     3975       define variable v-coeff-waste       as decimal      no-undo.
     3976       define variable v-brutto-qnty       as decimal      no-undo.
     3977       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3978       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3979       define buffer buf_fbr-line          for ub.fbr-line.
     3980       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3981       find first buf_fbr-recipe no-lock
     3982            where buf_fbr-recipe.doc-code      = p-doc-code
     3983              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3984       .
     3985       assign
     3986           v-recipe-qnty = buf_fbr-recipe.qnty
     3987       .
     3988       find first buf_fbr-line no-lock
     3989            where buf_fbr-line.doc-code    = p-doc-code
     3990              and buf_fbr-line.is-comp     = yes
     3991              and buf_fbr-line.recipe-code = p-recipe-code
     3992       .
     3993       assign
     3994           v-comp-qnty = buf_fbr-line.fact-qnty
     3995       .
     3996       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3997       then do:
     3998       end.
     3999       else do:
     4000           for each buf_fbr-recipe-gds no-lock
     4001              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4002                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4003           on error undo, return error
     4004           :
     4005               find first buf_fbr-line no-lock
     4006                    where buf_fbr-line.doc-code    = p-doc-code
     4007                      and buf_fbr-line.is-comp     = no
     4008                      and buf_fbr-line.recipe-code = p-recipe-code
     4009                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4010                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4011                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4012               .
     4013               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4014               then do:
     4015                   do transaction
     4016                   on error undo, return error
     4017                   :
     4018                       find first buf_el_fbr-recipe-gds exclusive-lock
     4019                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4020                       .
     4021                       assign
     4022                           buf_el_fbr-recipe-gds.calc-method   = 1
     4023                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4024                       .
     4025                       run fbrlib-calc-brutto in this-procedure (
     4026                             input buf_fbr-recipe.recipe-type
     4027                           , input 0
     4028                           , input buf_el_fbr-recipe-gds.coeff-value
     4029                           , input buf_el_fbr-recipe-gds.coeff-waste
     4030                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4031                           , input 1
     4032                           , output buf_el_fbr-recipe-gds.qnty
     4033                           , output buf_el_fbr-recipe-gds.coeff-waste
     4034                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4035                           , output buf_el_fbr-recipe-gds.calc-method
     4036                       ).
     4037                   end.
     4038               end.
     4039           end.
     4040           run fbrlib_adjust-doc-lines in this-procedure (
     4041                 input parparentproc
     4042               , input p-fbrhist-handle
     4043               , input p-doc-code
     4044               , input p-recipe-code
     4045               , input p-price-sale-obj-type
     4046               , input p-price-sale-obj-code
     4047           ).
     4048       end.
     4049   end.
     4050   END PROCEDURE.
     4051   PROCEDURE fbrlib_adjust-doc-lines :
     4052   define input parameter parparentproc as widget-handle no-undo .
     4053   define input parameter p-fbrhist-handle as handle no-undo .
     4054   define input parameter p-doc-code       as character    no-undo.
     4055   define input parameter p-recipe-code    as character    no-undo.
     4056   define input parameter p-price-sale-obj-type as character no-undo .
     4057   define input parameter p-price-sale-obj-code as integer no-undo .
     4058   define variable v-comp-qnty         as decimal      no-undo.
     4059   define variable v-trn-type          as character    no-undo.
     4060   define variable v-ingr-qnty         as decimal      no-undo.
     4061   define variable v-recipe-qnty       as decimal      no-undo.
     4062   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4063   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4064   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4065   define buffer buf_fbr-line          for ub.fbr-line.
     4066   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4067   define buffer buf_goods             for ub.goods.
     4068   define buffer buf_fbr-doc           for ub.fbr-doc.
     4069   do
     4070   for buf_fbr-recipe
     4071     , buf_fbr-recipe-gds
     4072     , buf_fbr-line
     4073     , buf_coeff_fbr-line
     4074     , buf_goods
     4075     , buf_fbr-doc
     4076   on error undo, return error
     4077   :
     4078       find first buf_fbr-line no-lock
     4079            where buf_fbr-line.doc-code      = p-doc-code
     4080              and buf_fbr-line.is-comp       = yes
     4081              and buf_fbr-line.recipe-code   = p-recipe-code
     4082       .
     4083       find first buf_fbr-doc no-lock
     4084            where buf_fbr-doc.doc-code      = p-doc-code
     4085       .
     4086       assign
     4087           v-comp-qnty = buf_fbr-line.fact-qnty
     4088           v-trn-type  = buf_fbr-line.trn-type
     4089       .
     4090       find first buf_fbr-recipe no-lock
     4091            where buf_fbr-recipe.doc-code    = p-doc-code
     4092              and buf_fbr-recipe.recipe-code = p-recipe-code
     4093       .
     4094       assign
     4095       v-recipe-qnty = buf_fbr-recipe.qnty
     4096       .
     4097       do transaction
     4098       on error undo, return error
     4099       :
     4100           for each buf_fbr-recipe-gds no-lock
     4101              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4102                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4103           on error undo, return error
     4104           :
     4105               find first buf_fbr-line no-lock
     4106                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4107                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4108                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4109                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4110                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4111               no-error.
     4112               if not available buf_fbr-line
     4113               then do:
     4114                   find first buf_goods no-lock
     4115                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4116                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4117                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4118                   .
     4119                   run str/fbr-crln.p (
     4120                         input parparentproc
     4121                       , input recid( buf_fbr-doc )
     4122                       , input recid( buf_goods )
     4123                       , input buf_fbr-recipe-gds.recipe-code
     4124                       , input v-trn-type
     4125                       , input no
     4126                       , input no
     4127                       , input buf_fbr-doc.obj-type
     4128                       , input buf_fbr-doc.obj-code
     4129                       , output v-fbr-v-fbr-doc-line-recid
     4130                   ).
     4131                   find first buf_fbr-line no-lock
     4132                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4133                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4134                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4135                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4136                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4137                   no-error.
     4138                   if not available buf_fbr-line
     4139                   then do:
     4140                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4141                                                      , p-doc-code
     4142                                                      , buf_fbr-recipe-gds.artic
     4143                                                      , buf_fbr-recipe-gds.prod-type
     4144                                                      , buf_fbr-recipe-gds.prod-code).
     4145                   end.
     4146               end.
     4147               find first buf_coeff_fbr-line exclusive-lock
     4148                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4149               .
     4150               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4151               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4152               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4153               then do:
     4154                   assign
     4155                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4156                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4157                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4158                   .
     4159               end.
     4160           end.
     4161       end.
     4162       define variable v-need-goods    as logical       no-undo.
     4163       define variable v-need-goods-list       as character     no-undo.
     4164       define variable v-need-goods-qnty-list  as character     no-undo.
     4165       find first buf_fbr-line no-lock
     4166            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4167              and buf_fbr-line.is-comp     = yes
     4168              and buf_fbr-line.recipe-code = p-recipe-code
     4169       .
     4170       run str/fbr-qnty.p (
     4171             input parparentproc
     4172           , input p-fbrhist-handle
     4173           , input recid( buf_fbr-doc )
     4174           , input recid( buf_fbr-line )
     4175           , input no
     4176           , input "ingr"
     4177           , input no
     4178           , input p-price-sale-obj-type
     4179           , input p-price-sale-obj-code
     4180           , input no
     4181           , input no
     4182           , input no
     4183           , output v-need-goods
     4184           , output v-need-goods-list
     4185           , output v-need-goods-qnty-list
     4186       ).
     4187   end.
     4188   END PROCEDURE.
     4189   procedure fbrlib_check-before-close :
     4190   define input parameter p-doc-code as character no-undo .
     4191   define variable same-sale as decimal no-undo .
     4192   define variable is-waste as logical no-undo .
     4193   define variable fix-price as logical no-undo .
     4194   define buffer buf_fbr-doc for ub.fbr-doc.
     4195   define buffer buf_fbr-line for ub.fbr-line.
     4196   define buffer buf_goods for ub.goods.
     4197   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4198   do
     4199   on error undo, return error
     4200   :
     4201     for each buf_fbr-line no-lock
     4202         where buf_fbr-line.doc-code = p-doc-code
     4203       , each buf_goods no-lock
     4204         where buf_goods.artic     = buf_fbr-line.artic
     4205           and buf_goods.prod-type = buf_fbr-line.prod-type
     4206           and buf_goods.prod-code = buf_fbr-line.prod-code
     4207     break by buf_fbr-line.prod-type
     4208           by buf_fbr-line.prod-code
     4209           by buf_fbr-line.artic
     4210     :
     4211       if first-of (buf_fbr-line.artic)
     4212       then do:
     4213         assign
     4214         same-sale = buf_fbr-line.price-sale
     4215         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4216         fix-price = buf_fbr-line.is-calc
     4217         .
     4218       end.
     4219       if same-sale <> buf_fbr-line.price-sale
     4220       then do:
     4221           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4222                                         ,p-doc-code
     4223                                         ,buf_goods.artic
     4224                                         ,buf_goods.gds-name
     4225                                         ,chr(10)).
     4226       end.
     4227       if fix-price <> buf_fbr-line.is-calc then do:
     4228           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4229                                         ,p-doc-code
     4230                                         ,buf_goods.artic
     4231                                         ,buf_goods.gds-name
     4232                                         ,chr(10)).
     4233       end.
     4234       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4235       then do:
     4236         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4237                                         ,p-doc-code
     4238                                         ,buf_goods.artic
     4239                                         ,buf_goods.gds-name
     4240                                         ,chr(10)).
     4241       end.
     4242       if buf_fbr-line.rsrv-qnty <> ?
     4243       and buf_goods.gds-type <> 'у':U
     4244       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4245       and buf_fbr-line.fact-qnty <> 0
     4246       then do:
     4247         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4248           if  can-find(first buf_fbr-gds-obj no-lock where
     4249                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4250               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4251               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4252               and buf_fbr-gds-obj.is-null-price  )  then .
     4253                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4254                                         ,p-doc-code
     4255                                         ,buf_goods.artic
     4256                                         ,buf_goods.gds-name
     4257                                         ,chr(10)
     4258                                         ,buf_fbr-line.recipe-code
     4259                                         ).
     4260         end.
     4261         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4262                                         ,p-doc-code
     4263                                         ,buf_goods.artic
     4264                                         ,buf_goods.gds-name
     4265                                         ,chr(10)
     4266                                         ,buf_fbr-line.recipe-code
     4267                                         ).
     4268       end.
     4269     end.
     4270   end.
     4271   end procedure.
     4272   define variable vss-include-info35 as character format "X(65)" no-undo
     4273   initial "@(#)$Workfile$ $Revision$".
     4274   procedure fbrpln-create-line :
     4275   define input parameter p-doc-code       as character    no-undo.
     4276   define input parameter p-gds-code       as integer      no-undo.
     4277   define input parameter p-recipe-code    as character    no-undo.
     4278   define input parameter p-fbr-obj-type   as character    no-undo.
     4279   define input parameter p-fbr-obj-code   as integer      no-undo.
     4280   define input parameter p-silence        as logical      no-undo.
     4281   define input parameter p-qnty           as decimal      no-undo.
     4282       define buffer buf_fbr-pln       for fbr-pln.
     4283       define buffer buf_fbr-pln-line  for fbr-pln-line.
     4284       define buffer buf_goods         for goods.
     4285   do
     4286   for buf_fbr-pln
     4287     , buf_fbr-pln-line
     4288     , buf_goods
     4289   on error undo, return error
     4290   :
     4291       find first buf_fbr-pln no-lock
     4292            where buf_fbr-pln.doc-code = p-doc-code
     4293       .
     4294       if buf_fbr-pln.status_ <> 'новый':U
     4295       then do:
     4296           if p-silence = no
     4297           then do:
     4298               message
     4299                   skip "Добавить строки можно только"
     4300                   skip "в документ в статусе 'новый'"
     4301               view-as alert-box error.
     4302           end.
     4303           undo, return error .
     4304       end.
     4305       find first buf_goods no-lock
     4306            where buf_goods.gds-code = p-gds-code
     4307       .
     4308       if p-recipe-code <> ""
     4309       and p-fbr-obj-type = ""
     4310       and p-fbr-obj-code = 0
     4311       then do:
     4312           if p-silence = no
     4313           then do:
     4314               message
     4315                   skip "Не задан объект для производства товара с рецептом."
     4316                   skip "Товар: " buf_goods.artic buf_goods.gds-name
     4317                   skip(1)
     4318                   skip "Товар не может быть включен в план-меню."
     4319               view-as alert-box error.
     4320           end.
     4321           undo, return error .
     4322       end.
     4323       do transaction
     4324       on error undo, return error
     4325       :
     4326           create buf_fbr-pln-line.
     4327           assign
     4328               buf_fbr-pln-line.doc-code       = p-doc-code
     4329               buf_fbr-pln-line.gds-code       = p-gds-code
     4330               buf_fbr-pln-line.recipe-code    = p-recipe-code
     4331               buf_fbr-pln-line.obj-type       = buf_fbr-pln.obj-type
     4332               buf_fbr-pln-line.obj-code       = buf_fbr-pln.obj-code
     4333               buf_fbr-pln-line.doc-type       = buf_fbr-pln.doc-type
     4334               buf_fbr-pln-line.fact-qnty      = p-qnty
     4335               buf_fbr-pln-line.artic          = buf_goods.artic
     4336               buf_fbr-pln-line.prod-type      = buf_goods.prod-type
     4337               buf_fbr-pln-line.prod-code      = buf_goods.prod-code
     4338               buf_fbr-pln-line.fbr-obj-type   = p-fbr-obj-type
     4339               buf_fbr-pln-line.fbr-obj-code   = p-fbr-obj-code
     4340               buf_fbr-pln-line.status_        = buf_fbr-pln.status_
     4341           .
     4342       end.
     4343   end.
     4344   end procedure.
     4345   procedure fbrpln-create-doc :
     4346   define input parameter p-obj-type   as character    no-undo.
     4347   define input parameter p-obj-code   as integer      no-undo.
     4348   define input parameter p-doc-type   as character    no-undo.
     4349   define input parameter p-db-remote  as logical          no-undo.
     4350   define input parameter p-userid     as character        no-undo.
     4351   define output parameter p-doc-code  as character    no-undo.
     4352       define variable v-today     as date           no-undo.
     4353       define variable v-time      as integer        no-undo.
     4354       define variable v-host-code as integer        no-undo.
     4355       define variable v-doc-code  as character      no-undo.
     4356       define buffer buf_fbr-pln       for fbr-pln.
     4357   do
     4358   for buf_fbr-pln
     4359   on error undo, return error
     4360   :
     4361       run cur-time in this-procedure (
     4362             output v-today
     4363           , output v-time
     4364       ).
     4365   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4366   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4367     (input  p-obj-type
     4368     ,input  p-obj-code
     4369     ,output v-host-code
     4370     )  .
     4371       run fbrpln-doc-code (
     4372             input p-obj-type
     4373           , input p-obj-code
     4374           , input p-db-remote
     4375           , output v-doc-code
     4376       ).
     4377       create buf_fbr-pln.
     4378       assign
     4379           buf_fbr-pln.doc-code        = v-doc-code
     4380           buf_fbr-pln.doc-type        = p-doc-type
     4381           buf_fbr-pln.obj-type        = p-obj-type
     4382           buf_fbr-pln.obj-code        = p-obj-code
     4383           buf_fbr-pln.doc-date        = v-today
     4384           buf_fbr-pln.creid           = p-userid
     4385           buf_fbr-pln.PS              = ""
     4386           buf_fbr-pln.fact-date       = ?
     4387           buf_fbr-pln.fact-time       = ?
     4388           buf_fbr-pln.fact-num        = 0
     4389           buf_fbr-pln.fact-order      = 0
     4390           buf_fbr-pln.host-code       = v-host-code
     4391           buf_fbr-pln.status_         = 'новый':U
     4392           buf_fbr-pln.sys-date        = v-today
     4393           buf_fbr-pln.sys-time-int    = v-time
     4394           buf_fbr-pln.sys-time        = string( v-time, "HH:MM:SS" )
     4395           buf_fbr-pln.user-name       = p-userid
     4396       .
     4397       assign
     4398           p-doc-code = buf_fbr-pln.doc-code
     4399       .
     4400   end.
     4401   end procedure.
     4402   procedure fbrpln-create-fbr-doc :
     4403   define input parameter p-obj-type       as character        no-undo.
     4404   define input parameter p-obj-code       as integer          no-undo.
     4405   define input parameter p-pln-doc-code   as character        no-undo.
     4406   define input parameter p-db-remote      as logical          no-undo.
     4407   define input parameter p-userid         as character        no-undo.
     4408   define output parameter p-doc-code      as character        no-undo.
     4409       define variable v-today         as date             no-undo.
     4410       define variable v-host-code     as integer          no-undo.
     4411       define variable v-base-code     as integer          no-undo.
     4412       define buffer buf_curr-accnt    for curr-accnt.
     4413       define buffer buf_fbr-doc       for fbr-doc.
     4414       define buffer buf_fbr-pln       for fbr-pln.
     4415   do
     4416   for buf_curr-accnt
     4417     , buf_fbr-doc
     4418     , buf_fbr-pln
     4419   on error undo, return error
     4420   :
     4421   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4423     (input  p-obj-type
     4424     ,input  p-obj-code
     4425     ,output v-today
     4426     )  .
     4427   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4429     (input  p-obj-type
     4430     ,input  p-obj-code
     4431     ,output v-host-code
     4432     )  .
     4433   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4435     (input  v-host-code
     4436     ,output v-base-code
     4437     )  .
     4438       find last buf_curr-accnt no-lock
     4439           where buf_curr-accnt.curr-code = v-base-code
     4440             and buf_curr-accnt.exch-date <= v-today
     4441       use-index pi
     4442       no-error.
     4443       if not available buf_curr-accnt
     4444       then do:
     4445           message
     4446               "На дату" v-today "неизвестен курс базовой валюты."
     4447           view-as alert-box error.
     4448           undo, return error.
     4449       end.
     4450       run doc-code in this-procedure (
     4451             input  "main"
     4452           , input  p-obj-type
     4453           , input  p-obj-code
     4454           , input  ?
     4455           , output p-doc-code
     4456       ) no-error.
     4457       if error-status:error
     4458       then do:
     4459           message
     4460               "Ошибка при генерации номера документа производства."
     4461               skip return-value
     4462               skip trim(error-status :get-message(1))
     4463                       trim(error-status :get-message(2))
     4464                       trim(error-status :get-message(3))
     4465           view-as alert-box error.
     4466           return error.
     4467       end.
     4468       run trg/chkdocnm.p (
     4469             input p-doc-code
     4470           , input "fbr-doc"
     4471           , input "?"
     4472       ) no-error.
     4473       if error-status:error
     4474       then do:
     4475           message
     4476                       vss-workfile vss-revision vss-description
     4477               skip "Ошибка при проверке номера для нового документа."
     4478               skip return-value
     4479               skip trim(error-status :get-message(1))
     4480                       trim(error-status :get-message(2))
     4481                       trim(error-status :get-message(3))
     4482           view-as alert-box error.
     4483           undo, return error .
     4484       end.
     4485       create buf_fbr-doc.
     4486       assign
     4487           buf_fbr-doc.doc-code  = p-doc-code
     4488           buf_fbr-doc.creid     = p-userid
     4489           buf_fbr-doc.doc-date  = v-today
     4490           buf_fbr-doc.doc-type  = 'производство':U
     4491           buf_fbr-doc.host-code = v-host-code
     4492           buf_fbr-doc.obj-type  = p-obj-type
     4493           buf_fbr-doc.obj-code  = p-obj-code
     4494           buf_fbr-doc.PS        = "@"
     4495           buf_fbr-doc.status_   = 'новый':U
     4496           buf_fbr-doc.out-code  = p-pln-doc-code
     4497       .
     4498   end.
     4499   end procedure.
     4500   procedure fbrpln-doc-code :
     4501   define input parameter p-obj-type   as character    no-undo.
     4502   define input parameter p-obj-code   as integer      no-undo.
     4503   define input parameter p-db-remote  as logical      no-undo.
     4504   define output parameter p-doc-code  as character    no-undo.
     4505   do
     4506   on error undo, return error
     4507   :
     4508       if p-db-remote = yes
     4509       then do:
     4510           assign
     4511               p-doc-code = trim( string( next-value( s-fbr-doc, ub ), ">>>>>>>>>9" ) )
     4512                           + "-"
     4513                           + trim( string( p-obj-code, ">>>>9" ) )
     4514                           + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
     4515           .
     4516       end.
     4517       else do:
     4518           assign
     4519               p-doc-code = trim( string( next-value( s-fbr-doc, ub ) ) ) + "-"
     4520           .
     4521       end.
     4522   end.
     4523   end procedure.
     4524   procedure fbrrest-get-free-qnty :
     4525   do
     4526   on error undo, return error
     4527   :
     4528   define input parameter p-obj-type       as character            no-undo.
     4529   define input parameter p-obj-code       as integer              no-undo.
     4530   define input parameter p-gds-code       as integer              no-undo.
     4531   define input parameter p-autofbr        as logical              no-undo.
     4532   define output parameter p-avail-qnty    as decimal              no-undo.
     4533       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
     4534       define variable v-free-qnty as decimal       no-undo.
     4535       define buffer buf_goods         for ub.goods.
     4536       define buffer buf_gds-obj       for ub.gds-obj.
     4537       define buffer buf_temp-parts    for temp-parts.
     4538       find first buf_goods no-lock
     4539            where buf_goods.gds-code = p-gds-code
     4540       .
     4541       assign
     4542           p-avail-qnty = 0
     4543       .
     4544       run partslib-init-temp-parts in this-procedure (
     4545             input p-obj-type
     4546           , input p-obj-code
     4547           , input buf_goods.artic
     4548           , input buf_goods.prod-type
     4549           , input buf_goods.prod-code
     4550       ).
     4551       assign
     4552           v-free-qnty = 0
     4553       .
     4554       for each buf_temp-parts
     4555       on error undo, return error
     4556       :
     4557           if buf_temp-parts.qnty > 0
     4558           then do:
     4559               assign
     4560                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
     4561               .
     4562           end.
     4563       end.
     4564       assign
     4565           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
     4566       .
     4567   end.
     4568   end procedure.
     4569   procedure fbrrest-get-catering-object :
     4570   do
     4571   on error undo, return error
     4572   :
     4573   define input parameter p-obj-code            as integer      no-undo.
     4574   define output parameter p-catering-obj-type  as character    no-undo.
     4575   define output parameter p-catering-obj-code  as integer      no-undo.
     4576       define buffer buf_shop              for ub.shop.
     4577       find first buf_shop no-lock
     4578            where buf_shop.obj-code = p-obj-code
     4579       .
     4580       assign
     4581           p-catering-obj-type = buf_shop.kitchen-store-type
     4582           p-catering-obj-code = buf_shop.kitchen-store-code
     4583       .
     4584   end.
     4585   end procedure.
     4586   define variable vss-include-info40 as character format "X(65)" no-undo
     4587   initial "@(#)$Workfile$ $Revision$".
     4588   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4589   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     4590       define variable v-upper-code as int no-undo.
     4591       define variable v-value as character no-undo.
     4592       define variable v-type as character no-undo.
     4593       define buffer lc_gds-grp for ub.gds-grp.
     4594       define buffer lc_goods for ub.goods.
     4595      if p-gds-code <> 0 then do:
     4596       find first lc_goods where lc_goods.gds-code = p-gds-code.
     4597       v-upper-code = lc_goods.grp-code.
     4598       do while v-upper-code > 0 :
     4599           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4600           run ggoattr-value(
     4601             input lc_gds-grp.node-code,
     4602             input 0,
     4603             input "",
     4604             input 0,
     4605             input 'ban-sales-via-cd':U,
     4606             output v-value,
     4607             output v-type
     4608           ).
     4609          if v-value = "yes" then
     4610             return true.
     4611          else
     4612          do:
     4613             run ggoattr-value(
     4614                input lc_gds-grp.node-code,
     4615                input v-cntxt-host-code-obj,
     4616                input "",
     4617                input 0,
     4618                input 'ban-sales-via-cd':U,
     4619                output v-value,
     4620                output v-type
     4621                ).
     4622             if v-value = "yes" then
     4623                return true.
     4624             else
     4625             do:
     4626                run ggoattr-value(
     4627                   input lc_gds-grp.node-code,
     4628                   input v-cntxt-host-code-obj,
     4629                   input v-cntxt-obj-type,
     4630                   input v-cntxt-obj-code,
     4631                   input 'ban-sales-via-cd':U,
     4632                   output v-value,
     4633                   output v-type
     4634                   ).
     4635                if v-value = "yes" then
     4636                   return true.
     4637                else v-upper-code = lc_gds-grp.upper-code.
     4638             end .
     4639          end.
     4640         end.
     4641       end.
     4642       if v-value = "" or logical(v-value) = false then return false .
     4643   end.
     4644   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     4645       define variable v-upper-code as int no-undo.
     4646       define variable v-value as character no-undo.
     4647       define variable v-type as character no-undo.
     4648       define buffer lc_gds-grp for ub.gds-grp.
     4649       define buffer lc_goods for ub.goods.
     4650       v-upper-code = p-grp-code.
     4651       do while v-upper-code > 0 :
     4652           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     4653           run ggoattr-value(
     4654             input lc_gds-grp.node-code,
     4655             input 0,
     4656             input "",
     4657             input 0,
     4658             input 'ban-sales-via-cd':U,
     4659             output v-value,
     4660             output v-type
     4661           ).
     4662          if v-value = "yes" then
     4663             return true.
     4664          else
     4665          do:
     4666             run ggoattr-value(
     4667                input lc_gds-grp.node-code,
     4668                input v-cntxt-host-code-obj,
     4669                input "",
     4670                input 0,
     4671                input 'ban-sales-via-cd':U,
     4672                output v-value,
     4673                output v-type
     4674                ).
     4675             if v-value = "yes" then
     4676                return true.
     4677             else
     4678             do:
     4679                run ggoattr-value(
     4680                   input lc_gds-grp.node-code,
     4681                   input v-cntxt-host-code-obj,
     4682                   input v-cntxt-obj-type,
     4683                   input v-cntxt-obj-code,
     4684                   input 'ban-sales-via-cd':U,
     4685                   output v-value,
     4686                   output v-type
     4687                   ).
     4688                if v-value = "yes" then
     4689                   return true.
     4690                else v-upper-code = lc_gds-grp.upper-code.
     4691             end .
     4692          end.
     4693         end.
     4694   end.
     4695   define temp-table temp_goods-qnty no-undo
     4696       field gds-code      as integer
     4697       field artic         as character
     4698       field prod-type     as character
     4699       field prod-code     as integer
     4700       field recipe-type   as character
     4701       field recipe-code   as character
     4702       field trn-type      as character
     4703       field need-qnty     as decimal
     4704       field calculated    as logical
     4705       index pi is primary unique gds-code recipe-code
     4706       index cl calculated
     4707   .
     4708   PROCEDURE create-initial-temp-goods :
     4709   do
     4710   on error undo, return error
     4711   :
     4712   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4713   define input parameter p-artic              as character    no-undo.
     4714   define input parameter p-prod-type          as character    no-undo.
     4715   define input parameter p-prod-code          as integer      no-undo.
     4716   define input parameter p-trn-type           as character    no-undo.
     4717   define input parameter p-recipe-type        as character    no-undo.
     4718   define input parameter p-recipe-code        as character    no-undo.
     4719   define input parameter p-need-qnty          as decimal      no-undo.
     4720   define output parameter p-same-good             as logical      no-undo.
     4721   define output parameter p-same-good-old-qnty    as decimal      no-undo.
     4722       define variable v-gds-code    as integer      no-undo.
     4723       define buffer buf_fbr-doc               for ub.fbr-doc.
     4724       define buffer buf_fbr-line              for ub.fbr-line.
     4725       define buffer buf_recipe                for ub.fbr-recipe.
     4726       define buffer buf_obj_recipe            for ub.recipe.
     4727       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4728       run clear-temp-tables in this-procedure.
     4729   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4731     (input  p-artic
     4732     ,input  p-prod-type
     4733     ,input  p-prod-code
     4734     ,output v-gds-code
     4735     )  .
     4736       create buf_temp_goods-qnty.
     4737       assign
     4738           buf_temp_goods-qnty.gds-code    = v-gds-code
     4739           buf_temp_goods-qnty.artic       = p-artic
     4740           buf_temp_goods-qnty.prod-type   = p-prod-type
     4741           buf_temp_goods-qnty.prod-code   = p-prod-code
     4742           buf_temp_goods-qnty.trn-type    = p-trn-type
     4743           buf_temp_goods-qnty.recipe-type = p-recipe-type
     4744           buf_temp_goods-qnty.recipe-code = p-recipe-code
     4745           buf_temp_goods-qnty.need-qnty   = p-need-qnty
     4746           buf_temp_goods-qnty.calculated  = no
     4747       .
     4748       assign
     4749           p-same-good                 = no
     4750           p-same-good-old-qnty        = 0
     4751       .
     4752       find first buf_fbr-doc where buf_fbr-doc.doc-code = p-fbr-doc-doc-code exclusive-lock.
     4753       for each buf_fbr-line no-lock
     4754          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4755            and buf_fbr-line.is-comp  = yes
     4756       on error undo, return error
     4757       :
     4758           find first buf_temp_goods-qnty
     4759                where buf_temp_goods-qnty.artic        = buf_fbr-line.artic
     4760                  and buf_temp_goods-qnty.prod-type    = buf_fbr-line.prod-type
     4761                  and buf_temp_goods-qnty.prod-code    = buf_fbr-line.prod-code
     4762           no-error.
     4763           if available buf_temp_goods-qnty
     4764           then do:
     4765               assign
     4766                   p-same-good                 = yes
     4767                   p-same-good-old-qnty        = buf_fbr-line.fact-qnty
     4768                   buf_temp_goods-qnty.calculated  = no
     4769               .
     4770           end.
     4771           else do:
     4772               define variable v-recipe-type   as character     no-undo.
     4773               run copy-recipe-in-doc in this-procedure (
     4774                     input p-fbr-doc-doc-code
     4775                   , input buf_fbr-line.recipe-code
     4776                   , input buf_fbr-doc.doc-date
     4777                   , input buf_fbr-doc.obj-type
     4778                   , input buf_fbr-doc.obj-code
     4779               ).
     4780               find first buf_recipe no-lock
     4781                    where buf_recipe.doc-code      = p-fbr-doc-doc-code
     4782                      and buf_recipe.recipe-code   = buf_fbr-line.recipe-code
     4783               no-error.
     4784               if available buf_recipe
     4785               then do:
     4786                   assign
     4787                       v-recipe-type = buf_recipe.recipe-type
     4788                   .
     4789                   if v-recipe-type = 'разделка':U
     4790                   or ( v-recipe-type = 'комплектация':U
     4791                       and buf_fbr-line.trn-type = 'спи':U )
     4792                   then do:
     4793                       run fill-temp-dressing-ingr in this-procedure (
     4794                             input buf_fbr-line.doc-code
     4795                           , input buf_recipe.recipe-code
     4796                       ).
     4797                   end.
     4798               end.
     4799               else do:
     4800                   assign
     4801                       v-recipe-type = ?
     4802                   .
     4803               end.
     4804   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4806     (input  buf_fbr-line.artic
     4807     ,input  buf_fbr-line.prod-type
     4808     ,input  buf_fbr-line.prod-code
     4809     ,output v-gds-code
     4810     )  .
     4811               create buf_temp_goods-qnty.
     4812               assign
     4813                   buf_temp_goods-qnty.gds-code    = v-gds-code
     4814                   buf_temp_goods-qnty.artic       = buf_fbr-line.artic
     4815                   buf_temp_goods-qnty.prod-type   = buf_fbr-line.prod-type
     4816                   buf_temp_goods-qnty.prod-code   = buf_fbr-line.prod-code
     4817                   buf_temp_goods-qnty.trn-type    = buf_fbr-line.trn-type
     4818                   buf_temp_goods-qnty.need-qnty   = buf_fbr-line.fact-qnty
     4819                   buf_temp_goods-qnty.recipe-type = v-recipe-type
     4820                   buf_temp_goods-qnty.recipe-code = buf_fbr-line.recipe-code
     4821                   buf_temp_goods-qnty.calculated  = yes
     4822               .
     4823           end.
     4824       end.
     4825   end.
     4826   END PROCEDURE.
     4827   PROCEDURE calc-not-calculated-goods :
     4828   do
     4829   on error undo, return error
     4830   :
     4831   define input parameter p-mainmenu-handle        as handle           no-undo.
     4832   define input parameter p-fbrhist-handle         as widget-handle    no-undo.
     4833   define input parameter p-fbr-doc-doc-code       as character        no-undo.
     4834   define input parameter p-same-good              as logical          no-undo.
     4835   define input parameter p-same-good-old-qnty     as decimal          no-undo.
     4836   define input parameter p-always-select-recipe   as logical          no-undo.
     4837   define input parameter p-add-childs             as logical          no-undo.
     4838   define input parameter p-price-sale-obj-type    as character        no-undo.
     4839   define input parameter p-price-sale-obj-code    as integer          no-undo.
     4840   define input parameter p-autofbr                as logical          no-undo.
     4841   define input parameter p-have-store             as logical          no-undo.
     4842       define variable v-counter               as integer       no-undo.
     4843       define variable v-recipe-type           as character     no-undo.
     4844       define variable v-recipe-code           as character     no-undo.
     4845       define variable v-recipe-found          as logical       no-undo.
     4846       define variable v-gds-code              as integer       no-undo.
     4847       define variable v-yesno                 as logical       no-undo.
     4848       define variable v-fbr-line-recid        as recid         no-undo.
     4849       define variable v-recipe-recid-list     as character     no-undo.
     4850       define variable v-need-goods            as logical       no-undo.
     4851       define variable v-need-goods-list       as character     no-undo.
     4852       define variable v-need-goods-qnty-list  as character     no-undo.
     4853       define variable v-have-rights           as logical       no-undo.
     4854       define variable v-trn-type              as character     no-undo.
     4855       define variable v-is-comp               as logical       no-undo.
     4856       define variable v-host-code             as integer       no-undo.
     4857       define variable v-is-manual-input       as logical       no-undo.
     4858       define variable v-add-good              as logical       no-undo.
     4859       define variable v-cancel                as logical       no-undo.
     4860       define variable v-value          as character no-undo .
     4861       define variable v-type           as character no-undo .
     4862       define variable v-attr-value     as character no-undo .
     4863       define variable v-attr-value-rec as character no-undo .
     4864       define variable v-attr-type      as character no-undo .
     4865       define variable v-mark-qnty      as decimal no-undo init ? .
     4866       define buffer buf_obj_recipe            for recipe.
     4867       define buffer buf_obj_recipe-gds        for recipe-gds.
     4868       define buffer buf_fbr-recipe            for fbr-recipe.
     4869       define buffer buf_fbr-recipe-gds        for fbr-recipe-gds.
     4870       define buffer buf_goods                 for goods.
     4871       define buffer buf_fbr-doc               for fbr-doc.
     4872       define buffer buf_fbr-line              for fbr-line.
     4873       define buffer buf_comp_fbr-line         for fbr-line.
     4874       define buffer buf_temp_goods-qnty       for temp_goods-qnty.
     4875       define buffer buf_new_temp_goods-qnty   for temp_goods-qnty.
     4876       define buffer buf_start_temp_goods-qnty for temp_goods-qnty.
     4877       define buffer buf_del_temp_goods-qnty   for temp_goods-qnty.
     4878       define buffer buf_marking-lines         for ub.marking-lines .
     4879       define buffer buf_marking               for ub.marking .
     4880      define variable v-ban-recipes as logical no-undo .
     4881      define variable v-ban-altr    as logical no-undo .
     4882      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     4883      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     4884       find first buf_fbr-doc no-lock
     4885            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     4886       .
     4887       run test-temp-tables in this-procedure ( "Заполнена временная таблица по товарам документа." ).
     4888       find first buf_start_temp_goods-qnty
     4889            where buf_start_temp_goods-qnty.calculated = no
     4890       no-error.
     4891       calc-not-calculated-goods:
     4892       do while available buf_start_temp_goods-qnty
     4893       :
     4894           run writelog in this-procedure ( log-file-name, 2, substitute( "Расчет товара с артикулом &1", buf_start_temp_goods-qnty.artic ) ).
     4895           find first buf_goods no-lock
     4896                where buf_goods.gds-code = buf_start_temp_goods-qnty.gds-code
     4897           .
     4898           if buf_start_temp_goods-qnty.recipe-code = ?
     4899           then do:
     4900               assign
     4901                   v-is-manual-input = yes
     4902               .
     4903           end.
     4904           else do:
     4905               assign
     4906                   v-is-manual-input = no
     4907               .
     4908           end.
     4909           if buf_start_temp_goods-qnty.recipe-code = ?
     4910           or p-always-select-recipe = yes
     4911           then do:
     4912               assign
     4913                   v-yesno     = ?
     4914                   v-add-good  = no
     4915               .
     4916               do while v-yesno = ?
     4917               and v-add-good = no
     4918               :
     4919                   run ref/rcp-all.w (
     4920                         input p-mainmenu-handle
     4921                       , input "b-add,b-sel"
     4922                       , input 'все':U
     4923                       , input recid( buf_goods )
     4924                       , input buf_fbr-doc.obj-type
     4925                       , input buf_fbr-doc.obj-code
     4926                       , output v-recipe-recid-list
     4927                   ) no-error.
     4928                   if error-status :error
     4929                   or v-recipe-recid-list = ""
     4930                   then do:
     4931                       message
     4932                           "Отменить добавление товара?"
     4933                           skip(1)
     4934                           skip "Товар:" buf_goods.artic buf_goods.gds-name
     4935                           skip(1)
     4936                           skip "Yes - отменить добавление текущего товара"
     4937                           skip "No  - отменить добавление всех товаров списка"
     4938                           skip "Cancel - вернуться к выбору рецепта"
     4939                       view-as alert-box question
     4940                       buttons yes-no-cancel
     4941                       title "Отмена"
     4942                       update v-yesno
     4943                       .
     4944                   end.
     4945                   else do:
     4946         if v-ban-altr or v-ban-recipes then
     4947         do:
     4948            for each buf_obj_recipe no-lock where recid (buf_obj_recipe) = integer(v-recipe-recid-list):
     4949               if buf_obj_recipe.recipe-type = 'производство':U and v-ban-recipes then
     4950               do:
     4951                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4952                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4953                        , input  'mark-type':U
     4954                        , output v-attr-value
     4955                        , output v-attr-type
     4956                        ) no-error .
     4957                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4958                     do:
     4959                        message "Рецепт производства " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " содержит маркированный товар."
     4960                           view-as alert-box.
     4961                        return .
     4962                     end.
     4963                  end.
     4964               end.
     4965               if buf_obj_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     4966               do:
     4967                  if not check-ban-sales-via-cd(buf_goods.gds-code) then
     4968                  do:
     4969                     message "Рецепт альтернатива " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + chr(10) + "входит в группу, у которой не установлен атрибут: " + chr(10) + "Запрет передачи на кассу."
     4970                        view-as alert-box.
     4971                     return .
     4972                  end.
     4973               end.
     4974               if buf_obj_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     4975               do:
     4976                  for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_obj_recipe.recipe-code:
     4977                     run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     4978                        , input  'mark-type':U
     4979                        , output v-attr-value
     4980                        , output v-attr-type
     4981                        ) no-error .
     4982                     if v-attr-value <> "" and v-attr-value <> "not-type" then
     4983                     do:
     4984                        run gds-attr-value in this-procedure  ( input  buf_obj_recipe.gds-code
     4985                           , input  'mark-type':U
     4986                           , output v-attr-value-rec
     4987                           , output v-attr-type
     4988                           ) no-error .
     4989                        if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     4990                        do:
     4991                           message "Рецепт комплектации " + buf_obj_recipe.recipe-code + " " + buf_obj_recipe.recipe-name + " должен быть маркированным"
     4992                              view-as alert-box.
     4993                           return .
     4994                        end.
     4995                        else leave.
     4996                     end.
     4997                  end.
     4998               end.
     4999            end.
     5000         end.
     5001                       assign
     5002                           v-add-good = yes
     5003                       .
     5004                   end.
     5005               end.
     5006               if v-add-good = no
     5007               then do:
     5008                   if v-yesno = yes
     5009                   then do:
     5010                       for each tt-marking-lines where tt-marking-lines.gds-code = buf_start_temp_goods-qnty.gds-code
     5011                       :
     5012                         for first buf_marking exclusive-lock where buf_marking.mark begins tt-marking-lines.mark :
     5013                           assign
     5014                             buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB
     5015                           .
     5016                         end .
     5017                         delete tt-marking-lines .
     5018                       end .
     5019                       delete buf_start_temp_goods-qnty.
     5020                       find first buf_start_temp_goods-qnty
     5021                               where buf_start_temp_goods-qnty.calculated = no
     5022                       no-error.
     5023                       next calc-not-calculated-goods.
     5024                   end.
     5025                   else do:
     5026                       undo, return error .
     5027                   end.
     5028               end.
     5029               find first buf_obj_recipe no-lock
     5030                    where recid( buf_obj_recipe ) = integer( v-recipe-recid-list )
