       89   field fact-date  like ub.trn-doc.fact-date
       90   field shift-date like ub.trn-doc.shift-date
       91   field shift-num  like ub.trn-doc.shift-num
       92   field shift-name like ub.trn-doc.shift-name
       93   field fact-order as decimal
       94   field is-trn-doc as logical
       95   field is-del as logical
       96   field doc-type   like ub.trn-doc.doc-type
       97   field ext-doc-type   like ub.trn-doc.ext-doc-type
       98   field sel-order  as integer
       99   field znak       as integer
      100   field to-del     as logical
      101   field is-archive-exist as logical
      102   index xpk is primary unique doc-code doc-type
      103   index xfact fact-num
      104   index xfact-date fact-date
      105   index sel-order sel-order
      106   index znak-order znak sel-order
      107   index isdel is-del
      108   .
      109   define buffer inkas_trn-doc for ub.trn-doc .
      110   define buffer c-inkas_trn-doc for ub.c-trn-doc .
      111   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define   new shared   temp-table doc-list-hist no-undo
      113   field list-table as character
      114   field id as integer
      115   field line as integer
      116   field hist-mode as character
      117   field des as character
      118   field num-recs as integer
      119   field option_ as character
      120   field item_ as character
      121   field status_ as character
      122   field num-add as integer
      123   field num-ignored as integer
      124   field done as logical
      125   field err_ as logical
      126   field err-mes as character
      127   index pi is primary
      128   id
      129   line
      130   index isdone
      131   done
      132   .
      133   define variable v-host-code as integer no-undo .
      134   define variable glog as logical no-undo .
      135   define variable log-file-name as character no-undo .
      136   define variable v-view-log  as logical no-undo .
      137   define variable lns-cnt as integer no-undo .
      138   define variable line-rec as recid no-undo .
      139   define variable p-parent-handle as handle no-undo .
      140   define buffer buf_trn-doc for ub.trn-doc.
      141   define buffer buf_inkas for ub.inkas.
      142   define buffer buf_fbr-doc for ub.fbr-doc.
      143   find first buf_inkas no-lock where
      144           buf_inkas.inkas-code = p-inkas-code no-error.
      145   if not available buf_inkas then do:
      146     undo, return error substitute("Не найдена продажа &1", p-inkas-code).
      147   end.
      148   if p-auto = 0 then do:
      149     log-file-name = 'saleclos.log' .
      150   end.
      151   else do:
      152     log-file-name = 'ext-sale.log'.
      153   end.
      154   run get-doc-list in this-procedure no-error.
      155   if can-find(first doc-list)  then do:
      156     case p-auto:
      157       when 0
      158       or
      159       when 1
      160       then do:
      161         message
      162         substitute("Согласно настройкам закрытие продажи ведет к закрытию периода до даты &1,&2" +
      163                    "Однако на Вашем объекте имеются еще незакрытые документы&2" +
      164                    "После закрытия продажи эти документы могут быть закрыты только следующим периодом&2&2" +
      165                    "Ознакомтесь со списком незакрытых документов"
      166                   , (buf_inkas.doc-date +  1)
      167                   , chr(10)
      168                   )
      169         view-as alert-box warning.
      170   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      172     (input  buf_inkas.obj-type
      173     ,input  buf_inkas.obj-code
      174     ,output v-host-code
      175     )  .
      176         run str/doc-list.w (
      177                       input parparentproc
      178                       ,input v-host-code
      179                       ,input buf_inkas.obj-type
      180                       ,input buf_inkas.obj-code
      181                       ) no-error.
      182         if error-status:error then do:
      183                   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Ошибка при проверке наличия незакрытых документов")                                       ).
      184           return error.
      185         end.
      186         else do:
      187           message
      188           substitute("Продолжить закрытие продажи невзирая на открытые документы?")
      189           view-as alert-box question buttons yes-no update glog.
      190           if glog then do:
      191             run get-doc-list in this-procedure no-error.
      192             if can-find(first doc-list) then do:
      193                           run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("При закрытии продажи на объекте имелись незакрытые документы!")                                       ).
      194               p-continue = yes.
      195               return.
      196             end.
      197           end.
      198         end.
      199       end.
      200       when 2 then do:
      201               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Согласно настройкам закрытие продажи ведет к закрытию периода до даты &1,&2" +                  "Однако на объекте имеются еще незакрытые документы&2" +                  "Закрытие продажи НЕВОЗМОЖНО!"                 , (buf_inkas.doc-date +  1)                 , chr(10)                 )                                       ).
      202       end.
      203     end case.
      204   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   if v-view-log
      206   and not g#news
      207   and not g#auto
      208   then do:
      209     message
      210     substitute('!!!В процессе закрытия продажи произошли ошибки!!!')  skip
      211     "!!!Внимательно прочитайте Log-file!!"
      212     view-as alert-box error .
      213        define variable v-user-action4   as character no-undo .
      214     define variable v-printed4       as logical   no-undo .
      215     run gbl/prnfilen.w
      216       (input  (substitute('!!!В процессе закрытия продажи произошли ошибки!!!'))
      217       ,input  0
      218       ,input  (string("./":U) + 'saleclos.log')
      219       ,input  7
      220       ,output v-user-action4
      221       ,output v-printed4
      222       ) .
      223   end.
      224   if v-view-log = true
      225   and (g#news
      226   or g#auto)
      227   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      228   then do:
      229      run cb_set-view-log in p-parent-handle ( input yes).
      230   end.
      231   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      232     OS-DELETE value(string("./":U) + 'saleclos.log').
      233   end.
      234     return "error":U.
      235   end.
      236   else do:
      237     p-continue = yes.
      238   end.
      239   procedure get-doc-list :
      240   for each doc-list :
      241     delete doc-list.
      242   end.
      243   for each buf_trn-doc no-lock where
      244           buf_trn-doc.obj-type = buf_inkas.obj-type
      245       and buf_trn-doc.obj-code = buf_inkas.obj-code
      246       and (buf_trn-doc.status_ = 'накл':U
      247       or
      248          buf_trn-doc.status_ = 'разрешен':U
      249       or buf_trn-doc.status_ = 'прво':U
      250          )
      251       and buf_trn-doc.doc-date <= buf_inkas.doc-date
      252       :
      253     if buf_trn-doc.doc-code = p-inkas-code then next.
      254     if buf_trn-doc.out-code = p-inkas-code then next.
      255     if buf_trn-doc.doc-type = 'инв':U then do:
      256       next.
      257     end.
      258   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   find doc-list
      260     where doc-list.doc-code = buf_trn-doc.doc-code
      261       and doc-list.doc-type = buf_trn-doc.doc-type
      262     no-error .
      263   if available doc-list then do:
      264     assign
      265       doc-list.to-del = no
      266     .
      267   end.
      268   else do:
      269     create doc-list .
      270     assign
      271     doc-list.doc-code   = buf_trn-doc.doc-code
      272     doc-list.obj-type   = buf_trn-doc.obj-type
      273     doc-list.obj-code   = buf_trn-doc.obj-code
      274     doc-list.fact-num   = buf_trn-doc.fact-num
      275     doc-list.doc-date   = buf_trn-doc.doc-date
      276     doc-list.fact-date  = buf_trn-doc.fact-date
      277     doc-list.shift-date = buf_trn-doc.shift-date
      278     doc-list.shift-num  = buf_trn-doc.shift-num
      279     doc-list.fact-order = buf_trn-doc.fact-order
      280     doc-list.is-trn-doc = yes
      281     doc-list.is-del     = no
      282     doc-list.doc-type   = buf_trn-doc.doc-type
      283     doc-list.ext-doc-type   = buf_trn-doc.ext-doc-type
      284     doc-list.znak       = if can-do ('рас,спи':U, doc-list.doc-type) then -1 else 1
      285     doc-list.to-del = no
      286     .
      287     assign
      288       lns-cnt = lns-cnt + 1
      289       line-rec = recid (doc-list)
      290     .
      291   end.
      292   end.
      293   for each buf_trn-doc no-lock where
      294           buf_trn-doc.obj-type = buf_inkas.obj-type
      295       and buf_trn-doc.obj-code = buf_inkas.obj-code
      296       and buf_trn-doc.doc-type = 'инв':U
      297       and buf_inkas.fact-date <= buf_Inkas.doc-date
      298       and (buf_trn-doc.status_ = 'накл':U
      299           or  buf_trn-doc.status_ = 'разрешен':U ):
      300   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   find doc-list
      302     where doc-list.doc-code = buf_trn-doc.doc-code
      303       and doc-list.doc-type = buf_trn-doc.doc-type
      304     no-error .
      305   if available doc-list then do:
      306     assign
      307       doc-list.to-del = no
      308     .
      309   end.
      310   else do:
      311     create doc-list .
      312     assign
      313     doc-list.doc-code   = buf_trn-doc.doc-code
      314     doc-list.obj-type   = buf_trn-doc.obj-type
      315     doc-list.obj-code   = buf_trn-doc.obj-code
      316     doc-list.fact-num   = buf_trn-doc.fact-num
      317     doc-list.doc-date   = buf_trn-doc.doc-date
      318     doc-list.fact-date  = buf_trn-doc.fact-date
      319     doc-list.shift-date = buf_trn-doc.shift-date
      320     doc-list.shift-num  = buf_trn-doc.shift-num
      321     doc-list.fact-order = buf_trn-doc.fact-order
      322     doc-list.is-trn-doc = yes
      323     doc-list.is-del     = no
      324     doc-list.doc-type   = buf_trn-doc.doc-type
      325     doc-list.ext-doc-type   = buf_trn-doc.ext-doc-type
      326     doc-list.znak       = if can-do ('рас,спи':U, doc-list.doc-type) then -1 else 1
      327     doc-list.to-del = no
      328     .
      329     assign
      330       lns-cnt = lns-cnt + 1
      331       line-rec = recid (doc-list)
      332     .
      333   end.
      334   end.
      335   for each buf_fbr-doc no-lock where
      336           buf_fbr-doc.obj-type = buf_inkas.obj-type
      337       and buf_fbr-doc.obj-code = buf_inkas.obj-code
      338       and (buf_fbr-doc.status_ = 'разрешен':U
      339       or buf_fbr-doc.status_ = 'новый':U)
      340       and buf_fbr-doc.doc-date <= buf_inkas.doc-date:
      341   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   find doc-list
      343     where doc-list.doc-code = buf_fbr-doc.doc-code
      344       and doc-list.doc-type = 'производство':U
      345     no-error .
      346   if available doc-list then do:
      347     assign
      348       doc-list.to-del = no
      349     .
      350   end.
      351   else do:
      352     create doc-list .
      353     assign
      354     doc-list.doc-code   = buf_fbr-doc.doc-code
      355     doc-list.obj-type   = buf_fbr-doc.obj-type
      356     doc-list.obj-code   = buf_fbr-doc.obj-code
      357     doc-list.fact-num   = 0
      358     doc-list.fact-date  = buf_fbr-doc.fact-date
      359     doc-list.shift-date = buf_fbr-doc.shift-date
      360     doc-list.shift-num  = buf_fbr-doc.shift-num
      361     doc-list.fact-order = 0
      362     doc-list.is-trn-doc = no
      363     doc-list.doc-type   = 'производство':U
      364     doc-list.ext-doc-type   = 'производство':U
      365     doc-list.znak       = 1
      366     doc-list.to-del = no
      367     .
      368     assign
      369       lns-cnt = lns-cnt + 1
      370       line-rec = recid (doc-list)
      371     .
      372   end.
      373   end.
      374   end procedure.
