        1   define input parameter p-gds-code like ub.goods.gds-code no-undo .
        2   define output parameter p-mark as character no-undo .
        3   define output parameter p-ok as logical no-undo .
        4   define output parameter p-b-code like ub.bar-code.b-code no-undo .
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       10   define variable vss-include-info1 as character format "X(65)" no-undo
       11   initial "@(#)$Workfile$ $Revision$".
       12   procedure xmlchar-test :
       13   define input parameter p-in-string          as character        no-undo.
       14   define output parameter p-out-string-enc    as character        no-undo.
       15   define output parameter p-out-string-dec    as character        no-undo.
       16   do
       17   on error undo, return error
       18   :
       19          run xmlchar-encode in this-procedure
       20       (
       21             input p-in-string
       22           , output p-out-string-enc
       23       ).
       24          run xmlchar-decode in this-procedure
       25       (
       26             input p-out-string-enc
       27           , output p-out-string-dec
       28       ).
       29   end.
       30   end .
       31   procedure xmlchar-encode :
       32   define input parameter p-in-string      as character        no-undo.
       33   define output parameter p-out-string    as character        no-undo.
       34       define variable v-position      as integer      no-undo.
       35       define variable v-current-char  as character    no-undo.
       36   do
       37   on error undo, return error
       38   :
       39       assign
       40           p-out-string = "":U
       41       .
       42       case p-in-string
       43       :
       44           when ?
       45           then do:
       46               assign
       47                   p-out-string = "?":U
       48               .
       49           end.
       50           when "?":U
       51           then do:
       52               assign
       53                   p-out-string = "&#63;":U
       54               .
       55           end.
       56           otherwise do:
       57               do v-position = 1 to length( p-in-string )
       58               :
       59                   assign
       60                       v-current-char = substring( p-in-string, v-position, 1 )
       61                   .
       62                   case v-current-char
       63                   :
       64                       when "&":U
       65                       then do:
       66                           assign
       67                               p-out-string = p-out-string + "&amp;":U
       68                           .
       69                       end.
       70                       when ">":U
       71                       then do:
       72                           assign
       73                               p-out-string = p-out-string + "&gt;":U
       74                           .
       75                       end.
       76                       when "<":U
       77                       then do:
       78                           assign
       79                               p-out-string = p-out-string + "&lt;":U
       80                           .
       81                       end.
       82                       when "'":U
       83                       then do:
       84                           assign
       85                               p-out-string = p-out-string + "&apos;":U
       86                           .
       87                       end.
       88                       when '"':U
       89                       then do:
       90                           assign
       91                               p-out-string = p-out-string + "&quot;":U
       92                           .
       93                       end.
       94                       when chr(1)
       95                       then do:
       96                           assign
       97                               p-out-string = p-out-string + "":U
       98                           .
       99                       end.
      100                       when chr(2)
      101                       then do:
      102                           assign
      103                               p-out-string = p-out-string + "":U
      104                           .
      105                       end.
      106                       when chr(3)
      107                       then do:
      108                           assign
      109                               p-out-string = p-out-string + "":U
      110                           .
      111                       end.
      112                       when chr(4)
      113                       then do:
      114                           assign
      115                               p-out-string = p-out-string + "":U
      116                           .
      117                       end.
      118                       when chr(5)
      119                       then do:
      120                           assign
      121                               p-out-string = p-out-string + "":U
      122                           .
      123                       end.
      124                       when chr(6)
      125                       then do:
      126                           assign
      127                               p-out-string = p-out-string + "":U
      128                           .
      129                       end.
      130                       when chr(7)
      131                       then do:
      132                           assign
      133                               p-out-string = p-out-string + "":U
      134                           .
      135                       end.
      136                       when chr(8)
      137                       then do:
      138                           assign
      139                               p-out-string = p-out-string + "":U
      140                           .
      141                       end.
      142                       when chr(9)
      143                       then do:
      144                           assign
      145                               p-out-string = p-out-string + "":U
      146                           .
      147                       end.
      148                       when chr(29)
      149                       then do:
      150                           assign
      151                               p-out-string = p-out-string + "":U
      152                           .
      153                       end.
      154                       when chr(10)
      155                       then do:
      156                           assign
      157                               p-out-string = p-out-string + "&#10;":U
      158                           .
      159                       end.
      160                       when chr(13)
      161                       then do:
      162                           assign
      163                               p-out-string = p-out-string + "&#13;":U
      164                           .
      165                       end.
      166                       otherwise do:
      167                           assign
      168                               p-out-string = p-out-string + v-current-char
      169                           .
      170                       end.
      171                   end case.
      172               end.
      173           end.
      174       end case.
      175   end.
      176   end .
      177   procedure xmlchar-encode-1c :
      178   define input parameter p-in-string      as character        no-undo.
      179   define output parameter p-out-string    as character        no-undo.
      180       define variable v-position      as integer      no-undo.
      181       define variable v-current-char  as character    no-undo.
      182   do
      183   on error undo, return error
      184   :
      185       assign
      186           p-out-string = "":U
      187       .
      188       case p-in-string
      189       :
      190           when ?
      191           then do:
      192               assign
      193                   p-out-string = "?":U
      194               .
      195           end.
      196           otherwise do:
      197               do v-position = 1 to length( p-in-string )
      198               :
      199                   assign
      200                       v-current-char = substring( p-in-string, v-position, 1 )
      201                   .
      202                   case v-current-char
      203                   :
      204                       when chr(1)
      205                       then do:
      206                           assign
      207                               p-out-string = p-out-string + " ":U
      208                           .
      209                       end.
      210                       when chr(2)
      211                       then do:
      212                           assign
      213                               p-out-string = p-out-string + " ":U
      214                           .
      215                       end.
      216                       when chr(3)
      217                       then do:
      218                           assign
      219                               p-out-string = p-out-string + " ":U
      220                           .
      221                       end.
      222                       when chr(4)
      223                       then do:
      224                           assign
      225                               p-out-string = p-out-string + " ":U
      226                           .
      227                       end.
      228                       when chr(5)
      229                       then do:
      230                           assign
      231                               p-out-string = p-out-string + " ":U
      232                           .
      233                       end.
      234                       when chr(6)
      235                       then do:
      236                           assign
      237                               p-out-string = p-out-string + " ":U
      238                           .
      239                       end.
      240                       when chr(7)
      241                       then do:
      242                           assign
      243                               p-out-string = p-out-string + " ":U
      244                           .
      245                       end.
      246                       when chr(8)
      247                       then do:
      248                           assign
      249                               p-out-string = p-out-string + " ":U
      250                           .
      251                       end.
      252                       when chr(9)
      253                       then do:
      254                           assign
      255                               p-out-string = p-out-string + " ":U
      256                           .
      257                       end.
      258                       when chr(29)
      259                       then do:
      260                           assign
      261                               p-out-string = p-out-string + " ":U
      262                           .
      263                       end.
      264                       when chr(10)
      265                       then do:
      266                           assign
      267                               p-out-string = p-out-string + " ":U
      268                           .
      269                       end.
      270                       when chr(13)
      271                       then do:
      272                           assign
      273                               p-out-string = p-out-string + " ":U
      274                           .
      275                       end.
      276                       otherwise do:
      277                           assign
      278                               p-out-string = p-out-string + v-current-char
      279                           .
      280                       end.
      281                   end case.
      282               end.
      283           end.
      284       end case.
      285   end.
      286   end .
      287   procedure xmlchar-decode :
      288   define input parameter p-in-string      as character        no-undo.
      289   define output parameter p-out-string    as character        no-undo.
      290       define variable v-position      as integer      no-undo.
      291       define variable v-last-position as integer      no-undo.
      292       define variable v-temp-integer  as integer      no-undo.
      293       define variable v-current-char  as character    no-undo.
      294       define variable v-next-char     as character    no-undo.
      295       define variable v-success       as logical      no-undo.
      296   do
      297   on error undo, return error
      298   :
      299       assign
      300           p-out-string = "":U
      301           v-position   = 0
      302       .
      303       replace-cycle:
      304       do while yes
      305       on error undo, return error
      306       :
      307           assign
      308               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      309           .
      310           if v-last-position <= v-position
      311           then do:
      312               if v-position = 0
      313               then do:
      314                   assign
      315                       p-out-string = p-in-string
      316                   .
      317               end.
      318               else do:
      319                   assign
      320                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      321                   .
      322               end.
      323               leave replace-cycle.
      324           end.
      325           else do:
      326               assign
      327                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      328                   v-position      = v-last-position
      329                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      330               .
      331               if v-current-char = "#":U
      332               then do:
      333                   assign
      334                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      335                   .
      336                   if v-last-position > 0
      337                   then do:
      338                       run xmlchar-read-integer in this-procedure
      339                        (
      340                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      341                           , output v-temp-integer
      342                           , output v-success
      343                       ).
      344                       if v-success = yes
      345                       and v-temp-integer >= 1
      346                       and v-temp-integer <= 255
      347                       then do:
      348                           assign
      349                               p-out-string = p-out-string + chr( v-temp-integer )
      350                               v-position   = v-last-position + 1
      351                           .
      352                       end.
      353                       else do:
      354                           assign
      355                               p-out-string = p-out-string + "&":U
      356                               v-position   = v-position   + 1
      357                           .
      358                       end.
      359                   end.
      360                   else do:
      361                       assign
      362                           p-out-string = p-out-string + "&":U
      363                           v-position   = v-position   + 1
      364                       .
      365                   end.
      366               end.
      367               else do:
      368                   case substring( p-in-string, v-position + 1, 3 )
      369                   :
      370                       when "lt;":U
      371                       then do:
      372                           assign
      373                               p-out-string = p-out-string + "<":U
      374                               v-position   = v-position   + 3
      375                           .
      376                       end.
      377                       when "gt;":U
      378                       then do:
      379                           assign
      380                               p-out-string = p-out-string + ">":U
      381                               v-position   = v-position   + 3
      382                           .
      383                       end.
      384                       otherwise do:
      385                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      386                           then do:
      387                               assign
      388                                   p-out-string = p-out-string + "&":U
      389                                   v-position   = v-position   + 4
      390                               .
      391                           end.
      392                           else do:
      393                               case substring( p-in-string, v-position + 1, 5 )
      394                               :
      395                                   when "quot;":U
      396                                   then do:
      397                                       assign
      398                                           p-out-string = p-out-string + '"':U
      399                                           v-position   = v-position   + 5
      400                                       .
      401                                   end.
      402                                   when "apos;":U
      403                                   then do:
      404                                       assign
      405                                           p-out-string = p-out-string + "'":U
      406                                           v-position   = v-position   + 5
      407                                       .
      408                                   end.
      409                                   otherwise do:
      410                                       assign
      411                                           p-out-string = p-out-string + "&":U
      412                                       .
      413                                   end.
      414                               end case.
      415                           end.
      416                       end.
      417                   end case.
      418               end.
      419           end.
      420       end.
      421   end.
      422   end .
      423   procedure xmlchar-read-integer :
      424   define input parameter p-input-string      as character        no-undo.
      425   define output parameter p-output-integer   as integer          no-undo.
      426   define output parameter p-success       as logical          no-undo.
      427   do
      428   on error undo, return error
      429   :
      430       assign
      431           p-output-integer = integer( p-input-string )
      432       no-error.
      433       if error-status :error
      434       then do:
      435           assign
      436               p-success           = no
      437               p-output-integer    = 0
      438           .
      439       end.
      440       else do:
      441           assign
      442               p-success           = yes
      443           .
      444       end.
      445   end.
      446   end.
      447   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      448   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      449   define new global shared variable g#attr-lib  as handle no-undo .
      450   define variable v-attr-lib-variable as handle no-undo .
      451   define variable mMRCCode  as logical    no-undo.
      452   define variable mTypeMark as character  no-undo.
      453   function IS-NeedMark returns logical
      454   ( input ib-code as integer  ,
      455     input ib-str as character ):
      456      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      457      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      458                                    and buf_prod-bc-attr.b-str  eq ib-str
      459                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      460        no-lock no-error.
      461      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      462   end.
      463   function repTegforDm return char
      464   (iDM as char ):
      465       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      466       define variable vteg as character no-undo.
      467       define variable oDM as character no-undo.
      468       define variable vi as integer no-undo.
      469       oDM = iDm.
      470       do vi = 1 to num-entries(vTeglist):
      471          vTeg = entry(vi,vTeglist).
      472          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      473       end.
      474       return oDM.
      475   end.
      476   function repSpecSimbforDm return char
      477   (iDM as char ):
      478       define variable oDM as character no-undo.
      479     run
      480       xmlchar-decode(iDM, output oDM).
      481     return repTegforDm (oDM).
      482   end.
      483   function CheckGtin return logical
      484   (iGtin as char):
      485      define variable bar_code as character no-undo.
      486      define variable vGtin as logical no-undo init "yes".
      487      if length(iGtin) eq 14
      488      then do:
      489         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      490         run str/chk-sum.p
      491          (input-output bar_code ) no-error .
      492         if iGtin ne  bar_code
      493         then
      494            vGtin = no.
      495      end.
      496      else
      497         vGtin = no.
      498      return vgtin.
      499   end.
      500   function repSpecSimbforXlm return char
      501   (iDM as char ):
      502       iDM = replace(iDM,chr(29),"").
      503       return iDM.
      504   end.
      505   function getGtinByDM return char
      506   (IDM as char):
      507      define variable VTXT as char no-undo.
      508      define variable vGtin as char no-undo.
      509      vTXt = IdM.
      510      vGtin = IDM.
      511      if    length(vtxt) > 14
      512      then do:
      513         if   vtxt begins "(01)"
      514                or vtxt begins "(02)"
      515         then
      516            vGtin = substring(vtxt,5,14).
      517         else if   (vtxt begins "01"
      518                or vtxt begins "02" )
      519                and (   (    substring(iDm,17,2) eq "21"
      520                         and length(vtxt) >= 21)
      521                     or substring(iDm,17,2) eq "37"
      522                     or substring(iDm,17,4) eq "(37)" )
      523         then do:
      524            vGtin = substring(vtxt,3,14).
      525            if not checkGtin(vGtin)
      526            then
      527               vGtin = substring(vtxt,1,14).
      528         end.
      529         else if     length(vtxt) eq 14 + 7 + 4 + 4
      530             or length(vtxt) eq 14 + 7 + 4
      531             or length(vtxt) eq 14 + 7
      532         then
      533            vGtin = substring(vtxt,1,14).
      534      end.
      535      if not checkGtin(vGtin)
      536      then
      537         vGtin = "".
      538      return vgtin.
      539   end.
      540   function getGdsCodeByGtin return int
      541   (iGtin as char):
      542      define buffer prod-bc  for ub.prod-bc.
      543      define buffer bar-code for ub.bar-code.
      544      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      545      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      546      return if avail bar-code then bar-code.gds-code else ?.
      547   end.
      548   function getQntyCodeByGtin return decimal
      549   (iGtin as char):
      550      define buffer prod-bc  for ub.prod-bc.
      551      define buffer bar-code for ub.bar-code.
      552      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      553      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      554      return if avail bar-code then bar-code.cli-base-rate else ?.
      555   end.
      556   function getGdsCodeByDM return int
      557   (iDm as char):
      558      define variable vGtin as char no-undo.
      559      define buffer prod-bc for ub.prod-bc.
      560      vGtin  = getGtinByDM (IDM ).
      561      return getGdsCodeByGtin (vGtin).
      562   end.
      563   function ChekTypeMarkByGds return logical
      564   (iGds-code as integer ):
      565      define buffer goods-attr for ub.goods-attr.
      566      find first goods-attr where goods-attr.gds-code   = iGds-code
      567                              and goods-attr.attr-code  = 'mark-type':U
      568      no-lock no-error.
      569      if available goods-attr
      570      then do:
      571         mTypeMark = goods-attr.attr-value.
      572         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      573           .
      574      end.
      575      else
      576         return no.
      577   end.
      578   function ChekTypeMarkByDm return logical
      579   (iDM as char ):
      580      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      581   end.
      582   function ChekTypeMarkByGtin return logical
      583   (iGtin as char ):
      584      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      585   end.
      586   function GetNextElement return character
      587     (input iAllTeg        as logical
      588     ,output oteg          as character
      589     ,output otegval       as character
      590     ,input-output pstr    as character
      591      ):
      592        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      593        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      594        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      595        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      596        define variable vTeg as character no-undo.
      597        define variable vLength as integer no-undo.
      598        define variable vi as integer no-undo.
      599        define variable vj as integer no-undo.
      600        define buffer code for ub.code.
      601        find first code where Code.parent eq "MarkType"
      602                          and Code.CodeValue   eq mTypeMark
      603                          no-lock no-error.
      604        if     available code
      605           and Code.misc1 ne ""
      606           and Code.misc1 ne ?
      607        then do:
      608           integer (Code.misc1) no-error.
      609           if not error-status:error
      610           then
      611             entry (4,vlistleng) = Code.misc1.
      612        end.
      613        if iAllTeg
      614        then
      615           assign
      616              vlistElem     = vlistElem    + vlistElemDop
      617              vlistleng     = vlistleng    + vlistlengDop
      618           .
      619        else if mMRCCode
      620        then
      621           assign
      622              vlistElem     = vlistElem    + ",(8005),8005"
      623              vlistleng     = vlistleng    + ",000006,0006"
      624           .
      625       block-elem:
      626       do vi = 1 to num-entries(vlistElem):
      627          vTeg = entry(vi,vlistElem).
      628          if pstr begins vTeg
      629          then do:
      630             if    vTeg eq "21"
      631             then
      632                vLength = index(pstr,chr(29)) - 2 no-error.
      633             if vLength  <= 0
      634             then
      635                vLength = int(entry(vi,vlistleng)).
      636             otegval = substring (pstr,length(vteg) + 1, vLength).
      637             oteg = replace(replace(vteg,")",""),"(","").
      638             vTeg = vteg + otegval.
      639             otegval = replace(otegval,chr(29),"").
      640             oteg = replace(replace(oteg,")",""),"(","").
      641             pstr = substring (pstr,length(vTeg)+ 1).
      642             vTeg = replace(vTeg,chr(29),"").
      643             leave block-elem.
      644          end.
      645          else
      646             vTeg = "".
      647       end.
      648       return vteg.
      649   end.
      650   function GetCodeIdent return character
      651   (iDm as char):
      652      define variable Velement   as character no-undo init "first".
      653      define variable oCodeIdent as character no-undo.
      654      define variable vteg as character no-undo.
      655      define variable vtegval as character no-undo.
      656      define variable vGtin as character no-undo.
      657      define buffer marking for ub.marking.
      658      for first marking no-lock where
      659                marking.mark eq iDm
      660            and marking.unit-ext = "LEVEL2"
      661      :
      662        return iDm.
      663      end.
      664      vGtin  = getGtinByDM (iDm ).
      665      ChekTypeMarkByDm(idm).
      666      if iDm begins 'tech_':U
      667      then
      668         oCodeIdent = iDm.
      669      else if length(iDm) < 21
      670      then do:
      671         find first marking where marking.mark eq idm
      672         no-lock no-error.
      673         oCodeIdent = if available marking then marking.mark else  ?.
      674      end.
      675      else if     length(iDm) eq 29
      676         and not iDm begins "01"
      677         and not iDm begins "02"
      678      then
      679         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      680      else  if     length(iDm) >= 24
      681               and (  iDm begins "01"
      682                   or iDm begins "02")
      683               and  substring(iDm,17,2) ne "21"
      684      then do:
      685         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      686                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      687         then
      688            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      689         else
      690            oCodeIdent = iDM.
      691      end.
      692      else  if     (   length(iDm) eq 25
      693                    or length(iDm) eq 21)
      694               and (not iDm begins "01"
      695               and  not iDm begins "02")
      696      then
      697         oCodeIdent = substring(iDm,1,21).
      698      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      699      then
      700         oCodeIdent = substring(iDm,1,21).
      701      else do while Velement ne "" and idm ne "":
      702         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      703         oCodeIdent = oCodeIdent + Velement.
      704      end.
      705      return oCodeIdent.
      706   end.
      707   function GetTegCod return character
      708   (icodeIdent as char, iTeg as char):
      709      define variable Velement   as character no-undo init "first".
      710      define variable oTeg as character no-undo init ?.
      711      define variable vteg as character no-undo.
      712      define variable vtegval as character no-undo.
      713      if     ((length(icodeIdent) eq 21
      714         and not icodeIdent begins "01"
      715         and not icodeIdent begins "02")
      716         or
      717             ( length(icodeIdent) eq 25
      718               and not icodeIdent begins "01"
      719               and not icodeIdent begins "02"))
      720      then do:
      721         if iTeg eq "01" or iTeg eq "02"
      722         then
      723            oTeg = substring(icodeIdent,1,21).
      724         else  if  iTeg eq "21"
      725         then
      726            oTeg = substring(icodeIdent,15,7).
      727      end.
      728      else do:
      729         ChekTypeMarkByDm(icodeIdent).
      730         block-teg:
      731            do while Velement ne "" and icodeIdent ne "":
      732            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      733            if    Velement begins iTeg
      734               or Velement begins "(" + iTeg + ")"
      735            then do:
      736               oTeg = vtegval.
      737               leave block-teg.
      738            end.
      739         end.
      740      end.
      741      return oTeg.
      742   end.
      743   function isOAD return logical
      744   (icodeIdent as character):
      745      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      746   end.
      747   function isMark return logical
      748   (icodeIdent as character):
      749      define buffer buf_marking for ub.marking.
      750      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      751             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      752   end.
      753   function addBracketForCode return character
      754   (icodeIdent as char):
      755      define variable Velement   as character no-undo init "first".
      756      define variable oTeg as character no-undo.
      757      define variable vteg as character no-undo.
      758      define variable vtegval as character no-undo.
      759      define buffer marking for ub.marking.
      760      find first marking no-lock where
      761                 marking.mark begins icodeIdent no-error.
      762      if    not ChekTypeMarkByDm(icodeIdent)
      763         or length(icodeIdent) le 24
      764         or (avail marking and marking.unit-ext = "LEVEL2")
      765      then
      766         oTeg = icodeIdent.
      767      else do:
      768         if (  icodeIdent begins "01"
      769            or icodeIdent begins "02"
      770            ) and CheckGtin(substring (icodeIdent,3,14))
      771            and substring (icodeIdent,17,2) eq "21"
      772         then do:
      773            mMRCCode = yes.
      774            ChekTypeMarkByDm(icodeIdent).
      775            block-teg:
      776            do while Velement ne "" and icodeIdent ne "":
      777               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      778               if vteg ne ""
      779               then
      780                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      781            end.
      782            mMRCCode = no.
      783         end.
      784         else do:
      785            oTeg = icodeIdent.
      786         end.
      787      end.
      788      return oTeg.
      789   end.
      790   function getlevelByCodId return int
      791   (iCode as char):
      792      define variable vLength as int no-undo.
      793      define variable vLevel  as int no-undo.
      794      if not ChekTypeMarkByDM (icode) then return ?.
      795      vLength = length(iCode).
      796      if    vLength eq 18
      797         or vLength eq 20
      798      then
      799         Vlevel = 4.
      800      else if vLength eq 21
      801      then
      802         Vlevel = 1.
      803      else if vLength eq 25
      804      then do:
      805         if  iCode begins "01"
      806         then
      807            Vlevel = 3.
      808         else
      809            Vlevel = 1.
      810      end.
      811      else if     vLength >= 26
      812              and vLength <= 46
      813      then do:
      814         if    substring(iCode,17,2) eq "11"
      815            or substring(iCode,17,2) eq "13"
      816            or (    substring(iCode,17,2) eq "21"
      817                and vLength >= 33
      818                and substring(iCode,26,4) ne "8005")
      819         then
      820            Vlevel = 4.
      821         else if    vLength eq 31
      822                 or vLength eq 38
      823                 or vLength eq 39
      824                 or vLength eq 45
      825         then
      826            Vlevel = 1.
      827         else if    vLength eq 35
      828                 or vLength eq 43
      829         then
      830            Vlevel = 3.
      831         else
      832            Vlevel = ?.
      833      end.
      834      else
      835         Vlevel = ?.
      836      return Vlevel.
      837   end.
      838   function getLevelMotpBycodid return character
      839   (iDm as char):
      840      define variable vLevel as integer no-undo.
      841      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      842      vLevel = getlevelByCodId(iDm).
      843      if    vLevel eq ?
      844         or vLevel < 1
      845         or vLevel > 6
      846      then
      847         return ?.
      848      else
      849         return entry(vlevel,vList).
      850   end.
      851   function getLevelUTDByLevelMotp return character
      852   (iUnit as char):
      853      define variable vLevel as integer no-undo.
      854      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      855      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      856      vLevel = lookup(iUnit,vListMOTP).
      857      if    vLevel eq ?
      858         or vLevel < 1
      859         or vLevel > 4
      860      then
      861         return ?.
      862      else
      863         return entry(vlevel,vListutd).
      864   end.
      865   function getLevelMotpByDM return character
      866   (iDm as char):
      867      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      868   end.
      869   function getLevelUTDByCodId return character
      870   (iDm as char):
      871      define variable vLevel as integer no-undo.
      872      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      873      vLevel = getlevelByCodId(iDm).
      874      if    vLevel eq ?
      875         or vLevel < 1
      876         or vLevel > 4
      877      then
      878         return ?.
      879      else
      880         return entry(vlevel,vList).
      881   end.
      882   function getLevelUTDByDM return character
      883   (iDm as char):
      884      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      885   end.
      886   define variable mNotMarkQnty as logical no-undo.
      887   function getQntyUTDByCodId return decimal
      888   (iDM as char):
      889      define variable vLevel as integer no-undo.
      890      define variable vList as character no-undo init "1,5,10,500".
      891      define variable vGtin as character no-undo.
      892      define variable vqnty as decimal no-undo init ?.
      893      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      894      if vqnty eq ?
      895      then do:
      896         if not mNotMarkQnty
      897         then do:
      898            define buffer marking for ub.marking.
      899            define variable vCodident as character no-undo.
      900            vCodident = GetCodeIdent(idm).
      901            find first marking where marking.mark begins vCodident no-lock no-error.
      902            if     available marking
      903               and marking.box-qnty ne ?
      904            then
      905               return marking.box-qnty.
      906         end.
      907         vGtin = getGtinByDm(iDM).
      908         if ChekTypeMarkByGtin (vGtin)
      909         then do:
      910            vLevel = getlevelByCodId(iDM).
      911            if     vLevel >= 1
      912               and vLevel <= 4
      913            then
      914               vqnty = int(entry(vlevel,vList)).
      915         end.
      916         else
      917            vqnty = getQntyCodeByGtin(vgtin).
      918      end.
      919      return vqnty.
      920   end.
      921   function getQntyUTDByDM return decimal
      922   (iDm as char):
      923      define variable vDM as character no-undo.
      924      if     length (iDm) ne 25
      925         and length (iDm) ne 29
      926         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
      927      then
      928         vDM = substring (iDm,1,length (iDm) - 6 ).
      929      else
      930         vDM = substring (iDm,1,length (iDm) - 4 ).
      931      return getQntyUTDByCodId(vDM).
      932   end.
      933   function getMRC4 return decimal
      934   (iMRC as char):
      935      define variable oMrc     as decimal no-undo init ?.
      936      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
      937      define variable vi       as integer no-undo.
      938      define variable vfound   as integer no-undo.
      939      define variable vposStart   as integer no-undo.
      940      do:
      941      OMRc = 0.
      942      do vi = 1 to 4:
      943         define variable vsimb as character no-undo.
      944         vsimb = substring(iMRC,vi,1).
      945         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
      946         vfound = index(vAlphabet,vsimb,vposStart) - 1.
      947         if vfound > 0
      948         then
      949            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
      950         end.
      951         OMRc = OMRc / 100.
      952      end.
      953      return OMRc.
      954   end.
      955   function getMRCByDM return decimal
      956   (iDm as char):
      957      define variable vMRC     as character no-undo.
      958      define variable oMrc     as decimal no-undo init ?.
      959      define variable Velement as character no-undo init "empty".
      960      define variable vteg as character no-undo.
      961      define variable vtegval as character no-undo.
      962      if    length(idm) eq 14 + 7 + 4 + 4
      963         or length(idm) eq 14 + 7 + 4
      964      then do:
      965         vMRC = substring(idm,22,4).
      966         omrc = getMRC4(vMRC).
      967      end.
      968      else do:
      969          ChekTypeMarkByDm(iDm).
      970          block-mrc:
      971          do while Velement ne "" and idm ne "":
      972             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
      973             if Velement begins "8005"
      974             then do:
      975                vMRC = substring(Velement,5,6).
      976                leave block-mrc.
      977             end.
      978             else if Velement begins "(8005)"
      979             then do:
      980                vMRC = substring(Velement,7,6).
      981                leave block-mrc.
      982             end.
      983          end.
      984          if vMRC ne ""
      985          then
      986             OMRc = dec(vmrc) / 100 no-error.
      987      end.
      988      return OMRc.
      989   end.
      990   function MoveDate return Date
      991   (idate as date,
      992    iMonth as int64):
      993      define variable vMonth   as int64 no-undo.
      994      define variable vYear    as int64 no-undo.
      995      define variable vDateNew as date  no-undo.
      996       define variable vDay     as int64 no-undo.
      997       vMonth = month(iDate) + iMonth.
      998       vYear =  year(iDate).
      999       if vMonth <= 0
     1000       then assign
     1001          vMonth = vMonth + 12
     1002           vYear  = vYear - 1
     1003       .
     1004       else if vMonth > 12
     1005       then assign
     1006          vMonth = vMonth - 12
     1007           vYear  = vYear + 1
     1008       .
     1009       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1010       do while error-status:error eq yes:
     1011          VDay = vDay + 1.
     1012          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1013       end.
     1014       if VDay > 0
     1015       then
     1016          vDateNew + 1.
     1017       return vDateNew.
     1018   end.
     1019   procedure checkEMRC:
     1020   define input  parameter iDm as character no-undo.
     1021   define output parameter vok as logical   no-undo init yes.
     1022      define variable v-value-emrc as character no-undo.
     1023      define variable v-type-emrc  as character no-undo.
     1024      define variable vDateIso     as character no-undo.
     1025      define variable vMRC         as decimal no-undo.
     1026      define variable vqnty        as decimal no-undo.
     1027      define variable vPrice       as decimal no-undo.
     1028      define variable vparent      as character no-undo.
     1029      define variable vgds-code    as integer no-undo.
     1030      define buffer code for ub.code.
     1031      vMRC = getMRCByDM(iDm).
     1032      if vMRC > 0
     1033      then do:
     1034         vgds-code = getGdsCodeByDM(iDm).
     1035         vqnty     = getQntyUTDByDM(iDm).
     1036               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1037            (
     1038             input   vgds-code
     1039            ,input   'emrc-type':U
     1040            ,output   v-value-emrc
     1041            ,output   v-type-emrc
     1042          ) no-error.
     1043          if     v-value-emrc ne ""
     1044             and v-value-emrc ne ?
     1045          then do:
     1046             vDateIso = iso-date(today).
     1047             vPrice = vMRC / vqnty.
     1048             vparent ="emc" + chr(4) + v-value-emrc.
     1049             find last code where Code.parent      eq vparent
     1050                              and Code.code        le vDateIso
     1051                              and code.status_  eq 0
     1052             no-lock no-error.
     1053             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1054             then
     1055                vOk = true .
     1056             else do:
     1057                 define variable vText      as character no-undo.
     1058                 define variable vDate      as date no-undo.
     1059                 define variable vDateLast  as character no-undo.
     1060                 define variable vDateFirst as character no-undo.
     1061                 define variable vDate3     as date no-undo.
     1062                 vdate = date(code.misc1).
     1063                 vDateLast = code.misc1.
     1064                 vDate3 = MoveDate(today, - 3 ).
     1065                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1066                                      string(vDate3  , "99/99/9999"),
     1067                                      string(vDate   , "99/99/9999")
     1068                                      ).
     1069                 vdateIso = iso-date(vdate3).
     1070                 find last code  where Code.parent      eq vparent
     1071                                   and Code.code        le vDateIso
     1072                                   and code.status_  eq 0 no-lock no-error.
     1073                 if available code
     1074                 then
     1075                    vDateIso = code.code.
     1076                 vDateFirst = vDateIso.
     1077                 vDateLast = iso-date(vdate).
     1078                 define variable vGood as logical no-undo.
     1079                 define variable vDateSale as date no-undo.
     1080                 define buffer bcode for code.
     1081                 for last code where Code.parent   eq vparent
     1082                                 and code.status_  eq 0
     1083                                 and code.code     < vDateLast
     1084                                 and code.code     >= vDateFirst
     1085                 no-lock:
     1086                    find first bcode where bCode.parent   eq vparent
     1087                                       and bcode.status_  eq 0
     1088                                       and bcode.code     > code.code no-lock no-error.
     1089                    if available bcode
     1090                    then do:
     1091                       if vPrice < dec(Code.CodeValue)
     1092                       then
     1093                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1094                                                     chr(10),
     1095                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1096                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1097                                                     ).
     1098                       else do:
     1099                          vGood = yes.
     1100                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1101                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1102                                                     chr(10),
     1103                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1104                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1105                                                     string(         vDateSale            ,"99/99/9999"),
     1106                                                     string(vDateSale - today)
     1107                                                     ).
     1108                       end.
     1109                    end.
     1110                 end.
     1111                 if vgood
     1112                 then do:
     1113                    define variable choice as integer no-undo .
     1114                    run gbl/d-askw.w (input "Уточнение"
     1115                           ,input  vText
     1116                           ,input "|"
     1117                           ,input "Принять|Вернуть"
     1118                           ,input "Принять данный товар|Вернуть товар постащику"
     1119                           ,input 1
     1120                           ,input 2
     1121                           ,output choice) no-error.
     1122                    vok = choice eq 1.
     1123                 end.
     1124                 else
     1125                    vok =false.
     1126             end.
     1127          end.
     1128      end.
     1129   end.
     1130   function addGs2Mark return character
     1131   (iMark as char):
     1132      define variable vDM   as character no-undo.
     1133      define variable vIdx  as integer   no-undo.
     1134      if index(iMark,chr(29),1) > 0
     1135      then return iMark.
     1136      if substring(iMark,26,4) = "8005" then
     1137      do:
     1138        vIdx = index(iMark,"93",26 + 4 + 5).
     1139        if vIdx > 1 then do:
     1140          vDM = substitute("&1&4&2&4&3",
     1141                           substring(iMark,1,25),
     1142                           substring(iMark,26,vIdx - 25 - 1),
     1143                           substring(iMark,vIdx),
     1144                           chr(29)) no-error.
     1145          vIdx = index(vDm,"240",vIdx + 4).
     1146          if vIdx > 0 then
     1147          do:
     1148            vDM = substitute("&1&3&2",
     1149                             substring(vDm,1,vIdx - 1),
     1150                             substring(vDm,vIdx),
     1151                             chr(29)) no-error.
     1152          end.
     1153        end.
     1154        else
     1155          vDM = substitute("&1&3&2",
     1156                           substring(iMark,1,25),
     1157                           substring(iMark,26),
     1158                           chr(29)) no-error.
     1159      end.
     1160      else if substring(iMark,32,2) = "91" then
     1161      do:
     1162        vIdx = index(iMark,"92",32).
     1163        if vIdx > 1 then
     1164          vDM = substitute("&1&4&2&4&3",
     1165                           substring(iMark,1,31),
     1166                           substring(iMark,32,vIdx - 31 - 1),
     1167                           substring(iMark,vIdx),
     1168                           chr(29)) no-error.
     1169        else
     1170          vDM = substitute("&1&3&2",
     1171                           substring(iMark,1,31),
     1172                           substring(iMark,32),
     1173                           chr(29)) no-error.
     1174      end.
     1175      else if substring(iMark,39,2) = "91" then
     1176      do:
     1177        vIdx = index(iMark,"92",38).
     1178        if vIdx > 1 then
     1179          vDM = substitute("&1&4&2&4&3",
     1180                           substring(iMark,1,38),
     1181                           substring(iMark,39,vIdx - 38 - 1),
     1182                           substring(iMark,vIdx),
     1183                           chr(29)) no-error.
     1184        else
     1185          vDM = substitute("&1&3&2",
     1186                           substring(iMark,1,38),
     1187                           substring(iMark,39),
     1188                           chr(29)) no-error.
     1189      end.
     1190      else if substring(iMark,25,2) = "93" then
     1191      do:
     1192        vIdx = index(iMark,"92",25).
     1193        if vIdx > 1 then
     1194          vDM = substitute("&1&4&2&4&3",
     1195                           substring(iMark,1,24),
     1196                           substring(iMark,25,vIdx - 24 - 1),
     1197                           substring(iMark,vIdx),
     1198                           chr(29)) no-error.
     1199        else
     1200          vIdx = index(iMark,"3103",25).
     1201          if vIdx > 0 then
     1202          vDM = substitute("&1&4&2&4&3",
     1203                           substring(iMark,1,24),
     1204                           substring(iMark,25,vIdx - 24 - 1),
     1205                           substring(iMark,vIdx),
     1206                           chr(29)) no-error.
     1207          else
     1208            vDM = substitute("&1&3&2",
     1209                             substring(iMark,1,24),
     1210                             substring(iMark,25),
     1211                             chr(29)) no-error.
     1212      end.
     1213      else if substring(iMark,32,2) = "93" then
     1214      do:
     1215        vDM = substitute("&1&3&2",
     1216              substring(iMark,1,31),
     1217              substring(iMark,32),
     1218              chr(29)) no-error.
     1219      end.
     1220      return if vDM <> "" then vDm else iMark.
     1221   end.
     1222   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1223     define variable v-cntxt-db-num        as integer   no-undo .
     1224     define variable v-cntxt-userid        as character no-undo .
     1225     define variable v-cntxt-level         as character no-undo .
     1226     define variable v-cntxt-host-code-obj as integer   no-undo .
     1227     define variable v-cntxt-obj-type      as character no-undo .
     1228     define variable v-cntxt-obj-code      as integer   no-undo .
     1229     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1230     define variable v-cntxt-is-admin      as logical   no-undo .
     1231   define buffer buf_marking for ub.marking .
     1232   define buffer buf_prod-bc for ub.prod-bc .
     1233   define buffer buf_bar-code for ub.bar-code .
     1234   define variable iLang           as integer   no-undo.
     1235   define variable p-value-logical as logical no-undo.
     1236   define variable p-value-character  as character no-undo.
     1237   define variable p-value-date       as date no-undo.
     1238   define variable p-value-decimal    as decimal no-undo.
     1239   define variable p-value-integer    as integer no-undo.
     1240   define variable p-param-type       as character no-undo.
     1241   define variable v-tth as handle no-undo .
     1242   define variable vCodeIdent        as character no-undo .
     1243   define variable v-GTIN        as character no-undo .
     1244   define variable v-find        as logical no-undo .
     1245   DEFINE BUTTON b-cancel AUTO-END-KEY
     1246        LABEL "Отмена"
     1247        SIZE 15 BY 1.14
     1248        BGCOLOR 8 .
     1249   DEFINE BUTTON b-ok AUTO-GO
     1250        LABEL "Ввод"
     1251        SIZE 15 BY 1.14
     1252        BGCOLOR 8 .
     1253   DEFINE VARIABLE f-mark AS CHARACTER FORMAT "X(256)":U
     1254        VIEW-AS FILL-IN
     1255        SIZE 63 BY 1 NO-UNDO.
     1256   DEFINE FRAME Dialog-Frame
     1257        f-mark AT ROW 1.95 COL 3 COLON-ALIGNED NO-LABEL WIDGET-ID 2
     1258        b-ok AT ROW 3.38 COL 15
     1259        b-cancel AT ROW 3.38 COL 36
     1260        SPACE(19.59) SKIP(0.76)
     1261       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1262            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1263            TITLE "Введите марку"
     1264            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
     1265   ASSIGN
     1266          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1267          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1268   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1269   DO:
     1270     p-ok = false .
     1271     APPLY "END-ERROR":U TO SELF.
     1272   END.
     1273   on choose of b-ok in frame Dialog-Frame
     1274   do :
     1275     vCodeIdent = GetCodeIdent(f-mark) .
     1276     find first buf_marking no-lock where buf_marking.mark = vCodeIdent no-error .
     1277     if not available buf_marking
     1278     then do :
     1279       message "Марка не найдена в системе!" view-as alert-box .
     1280       return no-apply .
     1281     end .
     1282     v-GTIN = getGtinByDM(f-mark) .
     1283     v-find = false .
     1284     for each buf_bar-code no-lock where buf_bar-code.gds-code = p-gds-code,
     1285     each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code
     1286                                and buf_prod-bc.b-str  = v-GTIN :
     1287       v-find = true .
     1288       p-b-code = buf_bar-code.b-code .
     1289       leave .
     1290     end .
     1291     if not v-find
     1292     then do :
     1293       message "GTIN " v-GTIN " не привязан к товару!" view-as alert-box .
     1294       return no-apply .
     1295     end .
     1296     p-mark = vCodeIdent .
     1297     p-ok = true .
     1298   end .
     1299   on return of f-mark in frame Dialog-Frame
     1300   do :
     1301     assign frame Dialog-Frame f-mark .
     1302     apply "choose" to b-ok in frame Dialog-Frame .
     1303   end .
     1304   on entry of f-mark in frame Dialog-Frame
     1305   do :
     1306     run LoadKeyboardLayoutA (input f-mark, input 0, output iLang).
     1307         run adm/shattri.p (
     1308                  input "get":U
     1309                  ,input  v-cntxt-obj-type
     1310                  ,input  v-cntxt-obj-code
     1311                  ,input  'marking':U
     1312                  ,input  'rus-key':U
     1313                  ,output p-value-character
     1314                  ,output p-value-date
     1315                  ,output p-value-decimal
     1316                  ,output p-value-integer
     1317                  ,output p-value-logical
     1318                  ,output p-param-type
     1319                  ,input-output table-handle v-tth
     1320                  ) no-error .
     1321         IF p-value-logical = yes THEN  iLang = 68748313.
     1322     run ActivateKeyboardLayout (input iLang, input 0).
     1323   end .
     1324   on leave of f-mark in frame Dialog-Frame
     1325   do :
     1326     assign frame Dialog-Frame f-mark .
     1327   end .
     1328   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1329   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1330   MAIN-BLOCK:
     1331   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1332      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1333     run LoadKeyboardLayoutA (input f-mark, input 0, output iLang).
     1334         run adm/shattri.p (
     1335                  input "get":U
     1336                  ,input  v-cntxt-obj-type
     1337                  ,input  v-cntxt-obj-code
     1338                  ,input  'marking':U
     1339                  ,input  'rus-key':U
     1340                  ,output p-value-character
     1341                  ,output p-value-date
     1342                  ,output p-value-decimal
     1343                  ,output p-value-integer
     1344                  ,output p-value-logical
     1345                  ,output p-param-type
     1346                  ,input-output table-handle v-tth
     1347                  ) no-error .
     1348         IF p-value-logical = yes THEN  iLang = 68748313.
     1349     run ActivateKeyboardLayout (input iLang, input 0).
     1350     RUN enable_UI.
     1351     WAIT-FOR GO OF FRAME Dialog-Frame.
     1352   END.
     1353   RUN disable_UI.
     1354   PROCEDURE disable_UI :
     1355     HIDE FRAME Dialog-Frame.
     1356   END PROCEDURE.
     1357   PROCEDURE enable_UI :
     1358     DISPLAY f-mark
     1359         WITH FRAME Dialog-Frame.
     1360     ENABLE f-mark b-ok b-cancel
     1361         WITH FRAME Dialog-Frame.
     1362     VIEW FRAME Dialog-Frame.
     1363   END PROCEDURE.
     1364   PROCEDURE ActivateKeyboardLayout external 'user32' :
     1365     define input parameter P1 as long.
     1366     define input parameter P2 as long.
     1367   end procedure.
     1368   PROCEDURE LoadKeyboardLayoutA external 'user32':
     1369     define input  parameter P1 as char.
     1370     define input  parameter P2 as long.
     1371     define return parameter pret as long.
     1372   end procedure.
