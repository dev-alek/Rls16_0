        1   define  input parameter parparentproc as handle    no-undo.
        2   define  input parameter pardoc-mode   as character no-undo.
        3   define output parameter parrvs-rec    as recid     no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision$":U.
        5   define variable vss-author      as character no-undo initial "$Author$":U.
        6   define variable vss-date        as character no-undo initial "$Date$":U.
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        8   define variable vss-archive     as character no-undo initial "$Archive$":U.
        9   define variable vss-description as character no-undo initial "Добавление документа сверки":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define new global shared variable g#lib-trn  as handle no-undo .
      116   define new global shared variable g#lib-trn2 as handle no-undo .
      117   define new global shared variable g#lib-trn3 as handle no-undo .
      118   define new global shared variable g#lib-trn4 as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define variable varlog     as logical   no-undo.
      129   define variable was_found  as logical   no-undo initial no.
      130   DEFINE BUTTON b-cancel AUTO-END-KEY
      131        LABEL "&Отмена"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-ok AUTO-GO
      135        LABEL "&Ввод"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON b-help
      139        LABEL "&Помощь"
      140        SIZE 10 BY 1
      141        BGCOLOR 8 .
      142   DEFINE VARIABLE r-type AS INTEGER
      143        VIEW-AS RADIO-SET VERTICAL
      144        RADIO-BUTTONS
      145        'контроль':U, 1,
      146        'смена':U, 2
      147        SIZE 30.88 BY 3 NO-UNDO.
      148   DEFINE VARIABLE varall-place AS LOGICAL LABEL "полный"
      149        VIEW-AS TOGGLE-BOX SIZE 10 BY 1 NO-UNDO.
      150   DEFINE RECTANGLE RECT-1
      151        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      152        SIZE 32.38 BY 4.04.
      153   DEFINE FRAME Dialog-Frame
      154        b-cancel     AT ROW 1.5  COL 11.88
      155        b-ok         AT ROW 1.5  COL 1.88
      156        b-help       at row 1.5  col 21.88
      157        r-type       AT ROW 4.38 COL 2.63 NO-LABEL
      158        varall-place AT ROW 4.6 COL 15.63
      159        RECT-1       AT ROW 3.88 COL 1.38
      160        SPACE(0.48) SKIP(0.11)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "Тип документа сверки"
      164            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON VALUE-CHANGED OF r-type IN FRAME Dialog-Frame
      173   DO:
      174     if input frame Dialog-Frame r-type = 1 then do:
      175        enable varall-place with frame Dialog-Frame.
      176        display varall-place with frame Dialog-Frame.
      177     end.
      178     else do:
      179       hide varall-place in frame Dialog-Frame.
      180     end.
      181   END.
      182   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      183   DO:
      184     assign frame Dialog-Frame r-type
      185                                varall-place.
      186     if r-type = 1 then do:
      187   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   do:
      189     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      190       (input  v-cntxt-db-num
      191       ,input  v-cntxt-userid
      192       ,input  0
      193       ,input  'actn_rvs-control_cr-revision':U
      194       ,input  'object':U
      195       ,input  v-cntxt-host-code-obj
      196       ,input  v-cntxt-obj-type
      197       ,input  v-cntxt-obj-code
      198       ,input  0
      199       ,input  0
      200       ,input  0
      201       ,input  true
      202       ,output varlog
      203       )  .
      204   end.
      205        if varlog <> yes then do:
      206           apply "go" to frame Dialog-Frame.
      207           return no-apply.
      208        end.
      209        run str/rvs-doc.w
      210          ( input        parparentproc
      211           ,input        pardoc-mode
      212           ,input        'контроль':U
      213           ,input        varall-place
      214           ,input-output parrvs-rec
      215          ) no-error.
      216        if error-status :error then do:
      217          message
      218            vss-workfile vss-revision vss-description skip
      219            "Ошибка при создании документа сверки." skip
      220            error-status :get-message(1) skip
      221            return-value skip
      222            view-as alert-box error .
      223          return no-apply.
      224        end.
      225     end.
      226     else do:
      227   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_rvschtrn in g#lib-trn3
      228     (  input v-cntxt-obj-type
      229     ,  input v-cntxt-obj-code
      230     ,  input ?
      231     ,  input ?
      232     ,  input ?
      233     ,  input no
      234     ,  input no
      235     , output was_found
      236     )        no-error
      237   .
      238        if error-status :error then do:
      239          message "Ошибка поиска незакрытых документов (rvschtrn)." skip return-value view-as alert-box error.
      240         return no-apply.
      241       end.
      242       if was_found = yes then do:
      243         message
      244           "Невозможно создать сверку." skip
      245           return-value
      246           view-as alert-box error.
      247         return no-apply.
      248       end.
      249   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   do:
      251     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      252       (input  v-cntxt-db-num
      253       ,input  v-cntxt-userid
      254       ,input  0
      255       ,input  'actn_rvs-shift_cr-revision':U
      256       ,input  'object':U
      257       ,input  v-cntxt-host-code-obj
      258       ,input  v-cntxt-obj-type
      259       ,input  v-cntxt-obj-code
      260       ,input  0
      261       ,input  0
      262       ,input  0
      263       ,input  true
      264       ,output varlog
      265       )  .
      266   end.
      267        if varlog <> yes then do:
      268           apply "go" to frame Dialog-Frame.
      269           return no-apply.
      270        end.
      271        run str/rvs-doc.w
      272          ( input        parparentproc
      273           ,input        pardoc-mode
      274           ,input        'смена':U
      275           ,input        varall-place
      276           ,input-output parrvs-rec
      277          ) no-error.
      278        if error-status :error then do:
      279          message
      280            vss-workfile vss-revision vss-description skip
      281            "Ошибка при создании документа сверки." skip
      282            error-status :get-message(1) skip
      283            return-value skip
      284            view-as alert-box error .
      285          return no-apply.
