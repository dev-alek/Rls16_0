      288   END.
      289   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      290   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      291   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   on help of frame Dialog-Frame
      293   do:
      294     run gbl/app_help.p
      295       (input this-procedure :file-name
      296       ,input ''
      297       ,input ?
      298       ) no-error.
      299     if error-status :error then do:
      300       message
      301         "Ошибка при вызове помощи"
      302         error-status :get-message(1)
      303         view-as alert-box .
      304     end.
      305   end.
      306   run minbtn-set in this-procedure .
      307   on choose of b-help in frame Dialog-Frame
      308   do:
      309     apply "help":u to frame Dialog-Frame .
      310   end.
      311   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   procedure minbtn-set :
      313       do
      314           on error undo, return error return-value
      315           :
      316           define variable ii              as integer       no-undo .
      317           define variable fh              as widget-handle no-undo .
      318           define variable hh              as widget-handle no-undo .
      319           define variable v-h             as handle        extent 4 no-undo .
      320           define variable v-name-button   as character     no-undo .
      321           define variable v-help-old-x    as decimal       no-undo .
      322           define variable v-help-old-y    as decimal       no-undo .
      323           define variable v-help-old-size as decimal       no-undo .
      324           define variable v-frame-width   as decimal       no-undo .
      325           define variable jj              as integer       no-undo .
      326           do
      327               on error undo, return error
      328               :
      329               assign
      330                   v-frame-width = frame Dialog-Frame:width - 0.3
      331                   fh            = frame Dialog-Frame:first-child
      332                   hh            = fh:first-child
      333                   ii            = 1
      334                   .
      335               do while valid-handle(hh):
      336                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      337                   do:
      338                       case lc(hh:name) :
      339                           when "b-help" then
      340                               do:
      341                                   hh:load-image-up("cmp/b-help.bmp":u) .
      342                                   hh:load-image-down("cmp/b-help.bmp":u) .
      343                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      344                                   hh:TOOLTIP = "Помощь" .
      345                                   v-help-old-x = hh:column .
      346                                   v-help-old-y = hh:row    .
      347                                   v-help-old-size = hh:width .
      348                                   hh:width-chars = 2.5 .
      349                               end.
      350                           when "b-print" then
      351                               do:
      352                                   hh:load-image("cmp/b-print.bmp":u) .
      353                                   hh:TOOLTIP = "Печать" .
      354                                   v-h[ii] = hh:handle .
      355                                   ii = ii + 1 .
      356                                   hh:width-chars = 3 .
      357                               end.
      358                           when "b-history" or
      359                           when "b-hist" then
      360                               do:
      361                                   hh:load-image("cmp/b-hist.bmp":u) .
      362                                   hh:TOOLTIP = "История" .
      363                                   v-h[ii] = hh:handle .
      364                                   ii = ii + 1 .
      365                                   hh:width-chars = 3 .
      366                               end.
      367                           when "b-sch" then
      368                               do:
      369                                   hh:load-image("cmp/b-sch.bmp":u) .
      370                                   hh:TOOLTIP = "Установка Фильтра" .
      371                                   v-h[ii] = hh:handle .
      372                                   ii = ii + 1 .
      373                                   hh:width-chars = 3 .
      374                               end.
      375                           when "b-hist-user" then
      376                               do:
      377                                   hh:load-image("cmp/b-hist.bmp":u) .
      378                                   hh:TOOLTIP = "История пользователя" .
      379                                   ii = ii + 1 .
      380                               end.
      381                       end case.
      382                   end.
      383                   hh = hh:next-sibling.
      384               end.
      385               b-help:column = v-frame-width - b-help:width-chars.
      386               jj = 0.
      387               repeat ii = 4 to 1 by -1 :
      388                   if valid-handle (v-h[ii] ) then
      389                   do:
      390                       jj  = jj + 1 .
      391                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      392                       v-h[ii]:row    = v-help-old-y .
      393                   end.
      394               end.
      395           end.
      396       end.
      397   end procedure.
      398   MAIN-BLOCK:
      399   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      400      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      401   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402     run mainmenu_getcntxt in parparentproc
      403       (output v-cntxt-db-num
      404       ,output v-cntxt-userid
      405       ,output v-cntxt-level
      406       ,output v-cntxt-host-code-obj
      407       ,output v-cntxt-obj-type
      408       ,output v-cntxt-obj-code
      409       ,output v-cntxt-db-num-obj
      410       ,output v-cntxt-is-admin
      411       ) .
      412     RUN enable_UI IN THIS-PROCEDURE.
      413     WAIT-FOR GO OF FRAME Dialog-Frame.
      414   END.
      415   RUN disable_UI.
      416   PROCEDURE disable_UI :
      417     HIDE FRAME Dialog-Frame.
      418   END PROCEDURE.
      419   PROCEDURE enable_UI :
      420     ASSIGN  r-type       = 1
      421             varall-place = yes.
      422     DISPLAY r-type varall-place
      423         WITH FRAME Dialog-Frame.
      424     ENABLE b-cancel b-ok RECT-1 r-type varall-place b-help
      425         WITH FRAME Dialog-Frame.
      426     VIEW FRAME Dialog-Frame.
      427   END PROCEDURE.
