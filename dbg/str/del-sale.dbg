     3116                                        in-vatp-goods.prod-type = b-doc-line.prod-type and
     3117                                        in-vatp-goods.prod-code = b-doc-line.prod-code no-lock.
     3118      if (not b-trn-doc.internal and
     3119              b-trn-doc.doc-type = 'при':U) or
