     3833   procedure del-lines :
     3834   _main:
     3835   do
     3836   on error undo, return error
     3837   :
     3838   define buffer buf_sale-doc for ub.sale-doc.
     3839   define buffer buf_trn-doc for ub.trn-doc.
     3840     for each buf_sale-doc where
     3841              buf_sale-doc.inkas-code = p-inkas-code
     3842          and buf_sale-doc.order > 0
     3843     by buf_sale-doc.order
     3844     on error undo, return error substitute("&1&2&1&3", error-status:get-message(1), chr(10), return-value )
     3845     on stop undo, return error substitute("&1&2&1&3", error-status:get-message(1), chr(10), return-value )
     3846     :
     3847       if buf_sale-doc.doc-kind = 'rwo':U then next.
     3848       find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = buf_sale-doc.doc-code.
     3849       assign
     3850       buf_trn-doc.status_ = 'накл':U.
     3851           run write-log-and-file in p-log-handle (                                   input 1                                 , input log-file-name                                 , input 1                                 , input substitute("УДАЛЕНИЕ резервов с накладной &1 &2...", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.doc-code)                                                               ).
     3852       for each ub.doc-line where
     3853               ub.doc-line.doc-code = buf_sale-doc.doc-code
     3854       on error undo _main, return error substitute("&1&2&1&3", error-status:get-message(1), chr(10), return-value )
     3855       :
     3856         run trg/rsrv-del.p
     3857           (input ub.doc-line.doc-code
     3858           ,input ub.doc-line.artic
     3859           ,input ub.doc-line.prod-type
     3860           ,input ub.doc-line.prod-code
     3861           ) no-error .
     3862         if error-status :error then do:
     3863           if p-auto = 0 then do:
     3864   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3865   if v-view-log
