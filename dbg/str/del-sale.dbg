     3050           .
     3051           _fbr:
     3052           for each loc-doc-fbr-gds where
     3053                   loc-doc-fbr-gds.gds-code = gdscode:
     3054             assign
     3055             fbr-chg-qnty = min(loc-doc-fbr-gds.fact-qnty - loc-doc-fbr-gds.doc-qnty, fbr-qnty)
     3056             fbr-qnty = fbr-qnty - fbr-chg-qnty
     3057             loc-doc-fbr-gds.doc-qnty = loc-doc-fbr-gds.doc-qnty + fbr-chg-qnty
     3058             .
     3059             if fbr-qnty = 0 then do:
     3060                 leave _fbR.
     3061             end.
     3062           end.
     3063         end.
     3064         assign
     3065         loc-gds-dtl.doc-qnty = loc-gds-dtl.doc-qnty + chg-qnty
     3066         b-doc-line.doc-qnty = b-doc-line.doc-qnty + chg-qnty
     3067         buf_sale-doc.doc-qnty = buf_sale-doc.doc-qnty  + chg-qnty
     3068         b-trn-doc.doc-qnty = b-trn-doc.doc-qnty  + chg-qnty
     3069         .
     3070         if available buf_doc-fbr-gds
     3071         then do :
     3072           if rz then do :
     3073             if buf_doc-fbr-gds.fact-qnty > 0
     3074             then do :
     3075               if loc-gds-dtl.doc-qnty = buf_doc-fbr-gds.fact-qnty then assign num_rec_res = num_rec_res + 1 .
     3076             end.
     3077             else
     3078             if buf_doc-fbr-gds.fact-qnty < 0
     3079             then do :
     3080               if loc-gds-dtl.doc-qnty = - buf_doc-fbr-gds.fact-qnty then assign num_rec_res = num_rec_res + 1 .
     3081             end.
     3082             else do :
     3083               if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     3084             end.
     3085           end.
     3086           else do :
     3087             if loc-gds-dtl.doc-qnty = 0 then assign num_rec_res = num_rec_res + 1 .
     3088           end.
     3089         end.
     3090         else do :
     3091           if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     3092         end.
     3093         if bottle then do:
     3094   assign
     3095     price-rubl-with-tax-loc = b-doc-line.price-rubl
     3096     price-base-with-tax-loc = b-doc-line.price-base
     3097   .
