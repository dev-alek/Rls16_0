     3877       ,input  0
     3878       ,input  (string("./":U) + 'sale-del.log')
     3879       ,input  7
     3880       ,output v-user-action30
     3881       ,output v-printed30
     3882       ) .
     3883   end.
     3884   if v-view-log = true
     3885   and (g#news
     3886   or g#auto)
     3887   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3888   then do:
     3889      run cb_set-view-log in p-parent-handle ( input yes).
     3890   end.
     3891   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     3892     OS-DELETE value(string("./":U) + 'sale-del.log').
     3893   end.
