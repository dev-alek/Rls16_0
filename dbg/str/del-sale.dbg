     3295                                                 ,input v-was-gds-dtl-doc-qnty
     3296                                                 ,input v-gds-dtl-fact-qnty
     3297                                                 ,input v-was-gds-dtl-doc-qnty
     3298                                                 ,input '':u).
     3299           end.
     3300           if v-gds-dtl-fact-qnty = 0 then do:
     3301               p-run-tpsi = no.
     3302           end.
     3303         end.
     3304       end.
     3305     END.
     3306   end.
