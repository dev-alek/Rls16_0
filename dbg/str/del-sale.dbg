     3265                                                     else
     3266                                                     (if r-qnty = ?
     3267                                                     then ?
     3268                                                     else r-qnty
     3269                                                     )
     3270                                                    )
     3271                                           ,output v-was-gds-dtl-doc-qnty
     3272                                           ,output v-gds-dtl-fact-qnty
     3273                                           ,buffer b-doc-line
     3274                                           ,buffer loc-gds-dtl
     3275                                           ,buffer tpsi_sale-doc
     3276                                           ).
     3277           if not v-is-own and p-r-v > 0 and v-gds-dtl-fact-qnty <> 0 then do:
