     2708                     then loc-doc-prts.doc-qnty
     2709                     else (if r-qnty = ?
     2710                           then (- loc-doc-prts.doc-qnty)
     2711                           else r-qnty)
     2712         ser-chg-qnty = if rz
     2713                         then loc-doc-prts.fact-qnty - res-parts
     2714                         else (if r-qnty = ?
     2715                               then (- loc-doc-prts.doc-qnty)
     2716                               else r-qnty)
     2717         res-qnty = res-qnty + ser-chg-qnty
     2718         no-partion-qnty = gds-dtl-res-qnty - res-qnty
     2719         cost-base = 0
     2720         cost-rubl = 0
     2721         .
