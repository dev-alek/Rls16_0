     3215                 loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     3216                 loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     3217                                          then 0
