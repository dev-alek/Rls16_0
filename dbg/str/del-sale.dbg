     3249             )
     3250         then do:
     3251           p-run-tpsi = no.
     3252         end.
     3253         else do:
     3254           run create-tt0-doc-line-gds-dtl(
     3255                                            input v-proprietor-obj-type
     3256                                           ,input v-proprietor-obj-code
     3257                                           ,input v-ext-doc-type
