     1180   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   define   temp-table tt0-info no-undo
     1182   field doc-code   like ub.trn-doc.doc-code
     1183   field artic      like ub.doc-line.artic
     1184   field prod-type  like ub.doc-line.prod-type
     1185   field prod-code  like ub.doc-line.prod-code
     1186   field prt-code  like ub.gds-dtl.prt-code
     1187   field obj-type   like ub.doc-line.obj-type
