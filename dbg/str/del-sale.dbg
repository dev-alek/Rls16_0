      691   function cross-list returns logical (
      692     input parfirst-stream  as character,
      693     input parsecond-stream as character,
      694     input pardelim         as character).
      695     if pardelim = ""
      696     or pardelim = ?
      697     then do:
      698       assign
      699         pardelim = ","
      700       .
      701     end.
      702     define variable vari            as integer no-undo .
      703     define variable varresult-cross as logical no-undo .
      704     assign
      705       varresult-cross = no
      706     .
      707     def var v-num-parfirst-stream as integer no-undo .
      708     assign
      709       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      710     .
      711     do vari = 1 to v-num-parfirst-stream
      712     :
      713       if lookup(entry(vari, parfirst-stream, pardelim)
      714                ,parsecond-stream
      715                ,pardelim
      716                ) > 0 then do:
      717         assign
      718           varresult-cross = yes
      719         .
      720         leave.
      721       end.
      722     end.
      723     return varresult-cross .
      724   end function.
      725   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   function octal-to-char return character
      727   ( p-string as character ) :
      728     def var v-asc     as integer no-undo .
      729     def var v-new-asc as integer no-undo .
      730     def var ind       as integer no-undo .
      731     if length(p-string) <> 3 then do:
      732       return ? .
      733     end.
      734     assign
      735       v-asc = 0
      736     .
      737     do ind = 1 to length(p-string)
      738     :
      739       assign
      740         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      741       .
      742       if v-new-asc < 0 or v-new-asc >= 8 then do:
      743         return ? .
      744       end.
      745       assign
      746         v-asc = v-asc * 8 + v-new-asc
      747       .
      748     end.
      749     return chr(v-asc) .
      750   end function .
      751   function char-to-octal return character
      752   ( p-chr as character ) :
      753     def var v-asc    as integer   no-undo .
      754     def var ind      as integer   no-undo .
      755     def var v-string as character no-undo .
      756     if length(p-chr) <> 1 then do:
      757       return ? .
      758     end.
      759     assign
      760       v-asc    = asc(p-chr)
      761       v-string = ""
      762     .
      763     do ind = 1 to 3
      764     :
      765       assign
      766         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      767       .
      768       assign
      769         v-asc = truncate(v-asc / 8, 0)
      770       .
      771     end.
      772     return v-string .
      773   end.
      774   function str-encode return character
      775   (   p-init-string       as character
      776     , p-encode-char       as character
      777     , p-special-char-list as character
      778   ) :
      779     def var p-encode-string as character no-undo .
      780     def var ind                as integer no-undo .
      781     def var v-num-special-char as integer no-undo .
      782     def var v-special-char     as character no-undo .
      783     if p-encode-char = ?
      784     or p-encode-char = "" then do:
      785       assign
      786         p-encode-char = "~~"
      787       .
      788     end.
      789     if p-init-string = ? then do:
      790       return "?" .
      791     end.
      792     if p-init-string = "?" then do:
      793       return p-encode-char + char-to-octal("?") .
      794     end.
      795     assign
      796       v-num-special-char = length(p-special-char-list)
      797       p-encode-string    = replace(p-init-string
      798                                   ,p-encode-char
      799                                   ,p-encode-char + char-to-octal(p-encode-char)
      800                                   )
      801     .
      802     do ind = 1 to v-num-special-char
      803     :
      804       assign
      805         v-special-char = substring(p-special-char-list, ind, 1)
      806       .
      807       if v-special-char <> p-encode-char then do:
      808         assign
      809           p-encode-string = replace (p-encode-string
      810                                     ,v-special-char
      811                                     ,p-encode-char + char-to-octal(v-special-char)
      812                                     )
      813         .
      814       end.
      815     end.
      816     return p-encode-string .
      817   end.
      818   function str-decode returns character
      819     (p-init-string   as character
      820     ,p-encode-char   as character
      821     ) :
      822     def var p-decode-string as character no-undo .
      823     def var ind                       as integer no-undo .
      824     def var v-num-entries-init-string as integer no-undo .
      825     def var v-sub-phrase              as character no-undo .
      826     def var v-special-char            as character no-undo .
      827     if p-encode-char = ?
      828     or p-encode-char = "" then do:
      829       assign
      830         p-encode-char = "~~"
      831       .
      832     end.
      833     if p-init-string = "?" then do:
      834       return ? .
      835     end.
      836     assign
      837       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      838     .
      839     if v-num-entries-init-string > 1 then do:
      840       assign
      841         p-decode-string = entry(1, p-init-string, p-encode-char)
      842       .
      843       do ind = 2 to v-num-entries-init-string
      844       :
      845         assign
      846           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      847         .
      848         assign
      849           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      850         .
      851         if v-special-char <> ? then do:
      852           assign
      853             p-decode-string = p-decode-string
      854                             + v-special-char
      855                             + substring(v-sub-phrase, 4)
      856           .
      857         end.
      858         else do:
      859           assign
      860             p-decode-string = p-decode-string
      861                             + p-encode-char
      862                             + v-sub-phrase
      863           .
      864         end.
      865       end.
      866     end.
      867     else do:
      868       assign
      869         p-decode-string = p-init-string
      870       .
      871     end.
      872     return p-decode-string .
      873   end.
      874   function is-gas returns logical
      875           (input p-gds-code as integer):
      876   define variable result as logical no-undo.
      877   define variable c-value as character no-undo.
      878   define variable c-type as character no-undo.
      879   do on error undo, return error:
      880           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      881         (input  p-gds-code
      882         ,input  'fuel-type':U
      883         ,output c-value
      884         ,output c-type) no-error.
      885   end.
      886   result = logical(c-value = 'metan':U) no-error.
      887   return result.
