     1927   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928   PROCEDURE UNRESERV:
     1929   define input parameter p-is-tpsi-obj  as logical no-undo .
     1930   define parameter buffer buf_Inkas for ub.inkas.
     1931   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     1932   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     1933   define variable v-is-dish as character no-undo .
     1934   define variable v-run-tpsi-line as logical no-undo .
     1935   define variable v-run-tpsi      as logical no-undo .
     1936   define variable ser-good        as logical no-undo .
     1937   define variable v-msg-on as logical   no-undo .
     1938   define buffer buf_trn-doc for ub.trn-doc.
     1939   define buffer buf_sale-doc for ub.sale-doc.
     1940   assign
     1941   num_rec = 0
     1942   num_rec_res = 0
     1943   num_resv = 0
     1944   num_resv_res = 0
     1945   r-artic =      "":U
     1946   r-prod-type = "":U
     1947   r-prod-code = 0
     1948   r-prt-code = 0
     1949   .
     1950   for each tt0-info:
     1951     delete tt0-info.
     1952   end.
     1953   if rdoc-line = -1 then do:
     1954     assign
     1955     v-msg-on = yes
     1956     rdoc-line = ?.
     1957   end.
     1958   _buf_sale-doc:
     1959   for each buf_sale-doc where
     1960          buf_sale-doc.inkas-code = buf_inkas.inkas-code
     1961      and buf_sale-doc.order > 0
     1962   by buf_sale-doc.order:
     1963     if buf_sale-doc.doc-kind = 'rwo':U then NEXT _BUF_sale-doc.
     1964     if r-or-v <> ?
     1965     and buf_sale-doc.doc-kind <> r-or-v then NEXT _BUF_sale-doc.
     1966     FIND FIRST buf_trn-doc WHERE buf_trn-doc.doc-code = buf_sale-doc.doc-code .
     1967   .
     1968     _doc-line:
     1969     FOR EACH ub.doc-line WHERE
     1970               ub.doc-line.doc-code = buf_sale-doc.doc-code EXCLUSIVE-LOCK,
     1971       FIRST ub.goods WHERE
     1972             ub.goods.artic = ub.doc-line.artic AND
     1973             ub.goods.prod-type = ub.doc-line.prod-type AND
     1974             ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK :
     1975         if buf_sale-doc.doc-kind = 'es':U then do:
     1976           IF ub.doc-line.doc-qnty = 0 and not p-is-tpsi-obj then NEXT _doc-line.
     1977           IF NOT (rdoc-line = ?) then do:
     1978             if NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
     1979             assign
     1980             r-artic = ub.doc-line.artic
     1981             r-prod-type = ub.doc-line.prod-type
     1982             r-prod-code = ub.doc-line.prod-code
     1983             .
     1984           end.
     1985         end.
     1986         else do:
     1987           IF ub.doc-line.doc-qnty = 0 then NEXT _doc-line.
     1988           IF NOT (rdoc-line = ?)
     1989           AND NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
     1990        end.
     1991   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1993     (input  ub.goods.gds-code
     1994     ,input  '1':U
     1995     ,input  buf_inkas.shift-date
     1996     ,input  buf_inkas.host-code
     1997     ,input  buf_inkas.obj-type
     1998     ,input  buf_inkas.obj-code
     1999     ,output vat-value
     2000     ) no-error .
     2001   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2003     (input  ub.goods.gds-code
     2004     ,input  '2':U
     2005     ,input  buf_inkas.shift-date
     2006     ,input  buf_inkas.host-code
     2007     ,input  buf_inkas.obj-type
     2008     ,input  buf_inkas.obj-code
     2009     ,output slt-value
     2010     ) no-error .
     2011         assign
     2012         ub.doc-line.vat-pc = vat-value
     2013         ub.doc-line.slt-pc = slt-value
     2014         .
     2015         IF CAN-FIND(FIRST ub.doc-pl No-LOCK WHERE
     2016                           ub.doc-pl.out-code = ub.doc-line.doc-code AND
     2017                           ub.doc-pl.gds-code = ub.goods.gds-code)
     2018         then do:
     2019             FIND FIRST ub.gds-prt NO-LOCK WHERE
     2020                         ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     2021             cashplace = yes.
     2022         end.
     2023         else cashplace = no.
     2024         IF NOT cashplace then do:
     2025             IF CAN-FIND(FIRST ub.doc-prts No-LOCK WHERE
     2026                               ub.doc-prts.out-code = ub.doc-line.doc-code AND
     2027                               ub.doc-prts.gds-code = ub.goods.gds-code)
     2028             then do:
     2029                 FIND FIRST ub.gds-prt NO-LOCK WHERE
     2030                             ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
     2031                 cashparts = yes.
     2032             end.
     2033             else cashparts = no.
     2034         end.
     2035         else cashparts = no.
     2036         FIND FIRST ub.units WHERE
     2037                     ub.units.unit-name = ub.goods.unit-base NO-LOCK .
     2038         if LOOKUP( 'сер':U, ub.units.type ) > 0 then  do:
     2039             assign
     2040             ser-good = yes.
     2041         end.
     2042         else do:
     2043             ser-good = no.
     2044         end.
     2045         IF CAN-FIND(FIRST ub.doc-fbr-gds No-LOCK WHERE
     2046                           ub.doc-fbr-gds.out-code = ub.doc-line.doc-code AND
     2047                           ub.doc-fbr-gds.gds-code = ub.goods.gds-code)
     2048         then do:
     2049   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
     2051     (input  ub.doc-line.obj-type
     2052     ,input  ub.doc-line.obj-code
     2053     ,input  ub.goods.gds-code
     2054     ,input  'is-dish=request'
     2055     ,output v-is-dish
     2056     )  .
     2057           if not error-status:error
     2058           then assign
     2059           cashfbr = integer(v-is-dish) > 0
     2060           no-error .
     2061         end.
     2062         else cashfbr = no.
     2063         rsrv-title = substitute("Снятие резервов. &1. Строк ", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )).
     2064         run RSRV-line(
     2065                       input buf_sale-doc.dir,
     2066                       input no,
     2067                       input no,
     2068                       input no,
     2069                       input p-is-tpsi-obj,
     2070                       input no,
     2071                       input no,
     2072                       input ub.goods.gds-code,
     2073                       input (if avail ub.gds-prt then ub.gds-prt.node-code else ?),
     2074                       output v-run-tpsi-line,
     2075                       buffer ub.doc-line,
     2076                       buffer buf_trn-doc,
     2077                       buffer buf_sale-doc
     2078                       ) no-error.
     2079         if error-status:error then do:
     2080           if rdoc-line <> ?
     2081           or v-msg-on
     2082           then do:
     2083             .
     2084             return error substitute("Ошибка при снятии резервов товаров:&1&2 &3"
     2085                                   , chr(10)
     2086                                   , error-status:get-message(1)
     2087                                   , return-value ).
     2088           end.
     2089           else next.
     2090         end.
     2091         assign
     2092         ub.doc-line.price-base = cost-base
     2093         ub.doc-line.price-rubl = cost-rubl .
     2094         assign
     2095         v-run-tpsi = v-run-tpsi-line or v-run-tpsi.
     2096     END.
     2097     if buf_sale-doc.doc-kind = 'es':U then do:
     2098       .
     2099       if p-is-tpsi-obj
     2100       and v-run-tpsi
     2101       then do:
     2102       .
     2103         run str/tpsirsrv.p (
     2104                         input parparentproc
     2105                         ,input p-parent-handle
     2106                         ,input p-log-handle
     2107                         ,input p-auto
     2108                         ,input v-curr-r-b
     2109                         ,input buf_inkas.inkas-code
     2110                         ,input buf_trn-doc.host-code
     2111                         ,input buf_trn-doc.obj-type
     2112                         ,input buf_trn-doc.obj-code
     2113                         ,input r-artic
     2114                         ,input r-prod-type
     2115                         ,input r-prod-code
     2116                         ,input r-prt-code
     2117                         ,input no
     2118                         ,input "Снятие резеров ЧУЖИХ товаров. Расход. Строк "
     2119                         ,input-output num_rec_res
     2120                         ,output num_rec_other
     2121                         ,output num_rec_other_res
     2122                         ,buffer buf_trn-doc
     2123                       ) no-error .
     2124         if error-status:error then do:
     2125           .
     2126           if rdoc-line <> ? then do:
     2127           return error substitute("Ошибка при снятии резервов ЧУЖИХ товаров:&1&2 &3"
     2128                                   , chr(10)
     2129                                   , error-status:get-message(1)
     2130                                   , return-value ).
     2131           end.
     2132         end.
     2133         .
     2134       end.
     2135     end.
     2136     assign
     2137     num_resv = num_resv + num_rec
     2138     num_resv_res = num_resv_res + num_rec_res
     2139     num_rec = 0
     2140     num_rec_res = 0
     2141     .
     2142     .
     2143     release buf_trn-doc.
     2144   end.
     2145   END PROCEDURE.
     2146   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2147   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2148   PROCEDURE RSRv-line:
