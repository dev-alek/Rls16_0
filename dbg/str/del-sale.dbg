     2171   define buffer buf_doc-fbr-gds for ub.doc-fbr-gds .
     2172   define variable res-qnty                    as decimal no-undo.
     2173   define variable gds-dtl-res-qnty            as decimal no-undo.
     2174   define variable no-partion-qnty             as decimal no-undo.
