     3283                                                   input b-doc-line.artic
     3284                                                 ,input b-doc-line.prod-type
     3285                                                 ,input b-doc-line.prod-code
     3286                                                 ,input loc-gds-dtl.prt-code
     3287                                                 ,input v-proprietor-obj-type
     3288                                                 ,input v-proprietor-obj-code
