     2194   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     2195   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     2196   define variable v-was-gds-dtl-doc-qnty      like ub.gds-dtl.fact-qnty no-undo .
     2197   define variable v-return-st-fl              as logical no-undo .
     2198   define variable v-return-status             like ub.trn-doc.status_ no-undo .
     2199   define variable v-return-flag               like ub.trn-doc.flag    no-undo .
     2200   define variable v-dop-sale-negative-check   as character no-undo .
     2201   define variable v-nc-option                 as character no-undo .
     2202   define variable current-rgds-dtl            as recid no-undo .
     2203   define variable v-qnty                      as decimal no-undo .
     2204   define variable v-cli-qnty                  as decimal no-undo .
     2205   define variable v-err-msg                   as character no-undo .
     2206   define buffer tpsi_sale-doc for ub.sale-doc.
     2207   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     2208       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2209       define buffer   in-vatp-parts    for ub.parts   .
     2210       define buffer   in-vatp-doc      for ub.trn-doc .
     2211       define buffer   in-vatp-goods    for ub.goods   .
     2212       define buffer   in-vatp-sysconf  for ub.sysconf .
     2213       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2214       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2215       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2216       define variable varinvprb                  as   character              no-undo.
     2217       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2218       define variable cli-base-rate              as   decimal                no-undo.
     2219       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2220       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2221       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2222       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2223       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2224       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2225       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2226       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2227       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2228       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2229       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2230       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2231       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2232       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2233       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2234       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2235       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2236       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2237       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2238       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2239       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2240       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2241       define variable varinvatp-envd             as   character              no-undo.
     2242       define variable varinvatp-type             as   character              no-undo.
     2243     if not rz and v-dop-sale-negative-check = '':U then v-dop-sale-negative-check = ',' + 'negative-check':U + "=1".
     2244   if not p-rsrv-prop-goods
     2245   AND (p-tpsi-obj
     2246   and p-r-v = 1
     2247   and not cashplace
     2248   and not cashparts
     2249   and not b-trn-doc.office)
     2250   then do:
     2251     run tpsi-gds-proprietor in this-procedure (
     2252                                                 input gdscode
     2253                                                ,input g#db-num
     2254                                                ,output v-proprietor-host-code
     2255                                                ,output v-proprietor-obj-type
     2256                                                ,output v-proprietor-obj-code ) no-error .
     2257     if error-status:error then do:
     2258       num_rec = num_rec + 1.
     2259       undo, return error substitute("Ошибки при проверке атрибута товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 на БД &2:&3&4 &5"
     2260                                     ,gdscode
     2261                                     ,g#db-num
     2262                                     , chr(10)
     2263                                     , error-status:get-message(1)
     2264                                     , return-value
     2265                                     ).
     2266     end.
     2267     if (v-proprietor-obj-type = "":U
     2268         and
     2269         v-proprietor-obj-code = 0)
     2270     or v-proprietor-obj-code = ?
     2271         then do:
     2272       num_rec = num_rec + 1.
     2273       undo, return error substitute("Не установлен атрибут товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 ни для одного объекта БД &2"
     2274                                     ,gdscode
     2275                                     ,g#db-num
     2276                                     ).
     2277     end.
     2278     if (v-proprietor-obj-type = b-trn-doc.obj-type
     2279     and v-proprietor-obj-code = b-trn-doc.obj-code)
     2280     then do:
     2281       assign
     2282       v-is-own = yes
     2283       .
     2284     end.
     2285     else do:
     2286       assign
     2287       p-run-tpsi = yes.
     2288       if v-proprietor-host-code = v-host-code then do:
     2289         assign
     2290         v-ext-doc-type = 'ev':U .
     2291       end.
     2292       else do:
     2293         assign
     2294         v-ext-doc-type =  'ee':U .
     2295       end.
     2296       find first tpsi_sale-doc no-lock where
     2297                 tpsi_sale-doc.inkas-code = buf_sale-doc.inkas-code
     2298             and tpsi_sale-doc.tpsidoc = yes
     2299             and tpsi_sale-doc.obj-type = v-proprietor-obj-type
     2300             AND tpsi_sale-doc.obj-code = v-proprietor-obj-code
     2301             AND tpsi_sale-doc.ext-doc-type = v-ext-doc-type  no-error .
     2302      end.
     2303   end.
     2304   else v-is-own = yes.
     2305   if v-is-own then do:
     2306     assign
     2307     v-to-reserv = yes
     2308     rsrv-option = (if (rgds-dtl = ?) and not p-auto-fbr
     2309                     then 'reserv':U  + ',' + 'no-message':U
     2310                     else 'reserv':U
     2311                     )
     2312     + v-dop-sale-negative-check
     2313     .
     2314     if cashfbr and p-auto-fbr-on and rz and not p-auto-fbr then return.
     2315   end.
     2316   else do:
     2317     assign
     2318     cashfbr = no.
     2319     if p-rest-tpsi or rz = no then do:
     2320       assign
     2321       v-nc-option = "=2":U.
     2322       assign
     2323       v-to-reserv = yes
     2324       rsrv-option = (if (rgds-dtl = ?) and not p-auto-fbr
     2325                       then 'reserv':U  + ',' + 'no-message':U + ',' + 'negative-check':U + v-nc-option
     2326                       else 'reserv':U  + ',' + 'negative-check':U + v-nc-option
     2327                       )
     2328       .
     2329       if p-rest-tpsi then do:
     2330         assign
     2331         rsrv-option = rsrv-option + ',' + 'sale-negative-check-on':u
     2332         .
     2333       end.
     2334     end.
     2335   end.
     2336   if cashfbr
     2337   and (not p-rest-dish)
     2338   and p-auto-fbr-on and rz
     2339   and p-fbr-income-doc-code <> "":U
     2340   then do:
     2341     _parts:
     2342     for each buf_parts no-lock
     2343         where buf_parts.obj-type  = b-trn-doc.obj-type
     2344           and buf_parts.obj-code  = b-trn-doc.obj-code
     2345           and buf_parts.prod-type = b-doc-line.prod-type
     2346           and buf_parts.prod-code = b-doc-line.prod-code
     2347           and buf_parts.artic     = b-doc-line.artic
     2348           and buf_parts.status_   = yes
     2349           and buf_parts.out-code  = p-fbr-income-doc-code
     2350     on error undo, return error return-value
     2351       :
     2352       assign
     2353       rsrv-option = 'reserv':U
     2354                       + "," + 'rsrv-single-part':U
     2355                       + "," + 'rsrv-in-code':U   + "=":u + str-encode ( buf_parts.in-code  ,  "", ",=":u )
     2356                       + "," + 'rsrv-part-code':U + "=":u + str-encode ( buf_parts.part-code,  "", ",=":u )
     2357       .
     2358       leave _parts.
     2359     end.
     2360   end.
     2361   if cashplace then do:
     2362     FIND FIRST loc-gds-dtl WHERE
     2363             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     2364             loc-gds-dtl.artic = b-doc-line.artic AND
     2365             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     2366             loc-gds-dtl.prod-code = b-doc-line.prod-code AND
     2367             loc-gds-dtl.prt-code = nodecode
     2368             EXCLUSIVE-LOCK NO-ERROR.
     2369     IF rz  and loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then LEAVE.
     2370     IF NOT rz and loc-gds-dtl.doc-qnty = 0 then LEAVE.
     2371     IF NOT (rgds-dtl = ?) AND NOT recid(loc-gds-dtl) = rgds-dtl THEN LEAVE.
     2372     if ( num_rec modulo 10 ) = 0 then
     2373   .
     2374     if rz then
     2375     find first buf_tt0-gds-dtl no-lock where
     2376               buf_tt0-gds-dtl.artic = loc-gds-dtl.artic
     2377          AND  buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     2378          AND  buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     2379          AND  buf_tt0-gds-dtl.prt-code  = loc-gds-dtl.prt-code no-error .
     2380     assign
     2381     chg-qnty   = 0.0
     2382     res-qnty   = 0.0
     2383     cost-base  = 0.0
     2384     cost-rubl  = 0.0
     2385     v-qnty     = 0.0
     2386     v-cli-qnty = 0.0
     2387     gds-dtl-res-qnty = if rz
     2388                       then ((loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty) + (if available buf_tt0-gds-dtl
     2389                                                                               then (buf_tt0-gds-dtl.fact-qnty - buf_tt0-gds-dtl.doc-qnty)
     2390                                                                               else 0))
     2391                       else (if r-qnty = ?
     2392                             then (- loc-gds-dtl.doc-qnty)
     2393                             else r-qnty)
     2394     .
     2395     _docpl:
     2396     FOR EACH loc-doc-pl where
     2397               loc-doc-pl.gds-code = gdscode AND
     2398               loc-doc-pl.out-code = b-doc-line.doc-code ON ERROR UNDO, NEXT:
     2399       assign
     2400       v-qnty                  = v-qnty + loc-doc-pl.doc-qnty
     2401       v-cli-qnty              = v-cli-qnty + loc-doc-pl.cli-doc-qnty
     2402       .
     2403       if rz and loc-doc-pl.fact-qnty <= loc-doc-pl.doc-qnty then NEXT.
     2404       if not rz and loc-doc-pl.doc-qnty = 0 then NEXT.
     2405       if NOT r-pl-code = ? AND r-pl-code <> loc-doc-pl.pl-code then NEXT.
     2406       assign
     2407       v-err-msg       = "":U
     2408       pl-chg-qnty     = (if rz then loc-doc-pl.fact-qnty     else 0.0 ) - loc-doc-pl.doc-qnty
     2409       pl-chg-cli-qnty = (if rz then loc-doc-pl.cli-fact-qnty else 0.0 ) - loc-doc-pl.cli-doc-qnty
     2410       res-qnty = res-qnty + pl-chg-qnty
     2411       no-partion-qnty = gds-dtl-res-qnty - res-qnty
     2412       cost-base = 0
     2413       cost-rubl = 0
     2414       rsrv-option-place = rsrv-option + "," + 'plcode':U + "=" + string(loc-doc-pl.pl-code)
     2415       .
     2416       if b-trn-doc.status_ = 'нередакт':U
     2417       or b-trn-doc.flag <> no
     2418       then do:
     2419         assign
     2420         v-return-status =  b-trn-doc.status_
     2421         v-return-flag = b-trn-doc.flag
     2422         b-trn-doc.status_ = 'накл':U
     2423         b-trn-doc.flag = no
     2424         v-return-st-fl = yes
     2425         .
     2426       end.
     2427       if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     2428       then do :
     2429         if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     2430       end.
     2431       assign
     2432         old-pl-qnty = (- loc-doc-pl.doc-qnty)
     2433       .
     2434       if old-pl-qnty <> 0.0 then do:
     2435         run trg/rsrv-dtl.p (
     2436                         input parparentproc
     2437                         ,input rsrv-option-place
     2438                         ,buffer loc-gds-dtl
     2439                         ,input-output old-pl-qnty
     2440                         ,input-output cost-base
     2441                         ,input-output cost-rubl
     2442                         ,-1, "" ) no-error.
     2443         if error-status :error then do:
     2444           assign
     2445           v-err-msg = substitute( "Ошибка при разрезервировании.&1&2"
     2446                                  , chr(10)
     2447                                  , return-value
     2448                                 )
     2449           .
     2450         end.
     2451         else do:
     2452           if old-pl-qnty <> (- loc-doc-pl.doc-qnty) then do:
     2453             assign
     2454             v-err-msg = substitute( "Не удалось снять резервы по ранее зарезервированному количеству.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     2455                                   , chr(10)
     2456                                   , (- loc-doc-pl.doc-qnty)
     2457                                   , old-pl-qnty
     2458                                   )
     2459             .
     2460           end.
     2461         end.
     2462         if v-err-msg <> "":U then do:
     2463           v-return-st-fl = no.
     2464           undo _docpl, NEXT.
     2465         end.
     2466       end.
     2467       assign
     2468       loc-doc-pl.doc-qnty     = loc-doc-pl.doc-qnty     + pl-chg-qnty
     2469       loc-doc-pl.cli-doc-qnty = loc-doc-pl.cli-doc-qnty + pl-chg-cli-qnty
     2470       loc-doc-pl.cli-qnty     = loc-doc-pl.cli-doc-qnty
     2471       new-pl-qnty             = loc-doc-pl.doc-qnty
     2472       v-qnty                  = v-qnty + pl-chg-qnty
     2473       v-cli-qnty              = v-cli-qnty + pl-chg-cli-qnty
     2474       .
     2475       if new-pl-qnty <> 0.0 then do:
     2476         run trg/rsrv-dtl.p (
     2477                         input parparentproc
     2478                         ,input rsrv-option-place
     2479                         ,buffer loc-gds-dtl
     2480                         ,input-output new-pl-qnty
     2481                         ,input-output cost-base
     2482                         ,input-output cost-rubl
     2483                         ,-1
     2484                         ,"") no-error.
     2485         if error-status :error then do:
     2486           assign
     2487           v-err-msg = substitute( "Ошибка при резервировании.&1&2"
     2488                                 , chr(10)
     2489                                 , return-value
     2490                                 )
     2491           .
     2492         end.
     2493         else do:
     2494           if new-pl-qnty <> loc-doc-pl.doc-qnty then do:
     2495             assign
     2496             v-err-msg = substitute( "Не удалось зарезервировать все запрошенное количество.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     2497                                   , chr(10)
     2498                                   , loc-doc-pl.doc-qnty - old-pl-qnty
     2499                                   , new-pl-qnty - old-pl-qnty
     2500                                   )
     2501             .
     2502           end.
     2503         end.
     2504         if v-err-msg <> "":U then do:
     2505           v-return-st-fl = no.
     2506           undo _docpl, NEXT.
     2507         end.
     2508       end.
     2509       if v-return-st-fl then do:
     2510         assign
     2511         b-trn-doc.status_ = v-return-status
     2512         b-trn-doc.flag = v-return-flag
     2513         v-return-st-fl = no
     2514         .
     2515       end.
     2516       assign
     2517       chg-qnty = chg-qnty + pl-chg-qnty
     2518       .
     2519     END.
     2520     if v-qnty <> 0.0
     2521       and v-cli-qnty <> 0.0
     2522     then do:
     2523       assign
     2524       b-doc-line.doc-density = v-cli-qnty / v-qnty
     2525       .
     2526     end.
     2527     if chg-qnty <> 0 then  do:
     2528         assign
     2529         loc-gds-dtl.doc-qnty = loc-gds-dtl.doc-qnty + chg-qnty
     2530         b-doc-line.doc-qnty = b-doc-line.doc-qnty + chg-qnty
     2531         buf_sale-doc.doc-qnty = buf_sale-doc.doc-qnty  + chg-qnty
     2532         b-trn-doc.doc-qnty = b-trn-doc.doc-qnty  + chg-qnty
     2533         b-doc-line.cli-qnty = v-cli-qnty
     2534         .
     2535         if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     2536         if bottle then do:
     2537   assign
     2538     price-rubl-with-tax-loc = b-doc-line.price-rubl
     2539     price-base-with-tax-loc = b-doc-line.price-base
     2540   .
     2541   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2543     (output varinvprb
     2544     )  .
     2545      find first in-vatp_doc-attr no-lock
     2546       where in-vatp_doc-attr.doc-code  = b-trn-doc.doc-code
     2547         and in-vatp_doc-attr.attr-code = 'envd':U
     2548       no-error .
     2549       if available in-vatp_doc-attr
     2550          then do:
     2551          assign
     2552            in-vatp-have-vat-slt = no.
     2553      end.
     2554      else do:
     2555        assign
     2556          in-vatp-have-vat-slt = yes.
     2557      end.
     2558      find first in-vatp-goods where in-vatp-goods.artic     = b-doc-line.artic     and
     2559                                        in-vatp-goods.prod-type = b-doc-line.prod-type and
     2560                                        in-vatp-goods.prod-code = b-doc-line.prod-code no-lock.
     2561      if (not b-trn-doc.internal and
     2562              b-trn-doc.doc-type = 'при':U) or
     2563         in-vatp-goods.gds-type = 'у':U then do:
     2564         if varinvprb = "base":u then do:
     2565           assign
     2566             road-tax-base-loc = b-doc-line.road-tax
     2567             road-tax-rubl-loc = b-doc-line.road-tax * b-trn-doc.base-rate / b-trn-doc.base-scale.
     2568         end.
     2569         else do:
     2570           ASSIGN
     2571             road-tax-rubl-loc = b-doc-line.road-tax
     2572             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     2573         end.
     2574         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2575         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2576         assign
     2577           road-tax-cli-loc = ?.
     2578         ASSIGN
     2579           transport-base-loc = (if b-doc-line.transport-base = ? then 0 else b-doc-line.transport-base)
     2580           transport-rubl-loc = (if b-doc-line.transport-rubl = ? then 0 else b-doc-line.transport-rubl)
     2581           transport-cli-loc  = 0
     2582           other-base-loc     = (if b-doc-line.other-base     = ? then 0 else b-doc-line.other-base)
     2583           other-rubl-loc     = (if b-doc-line.other-rubl     = ? then 0 else b-doc-line.other-rubl)
     2584           other-cli-loc      = 0
     2585           vat-pc-loc         = (if b-doc-line.vat-pc         = ? then 0 else b-doc-line.vat-pc)
     2586           slt-pc-loc         = (if b-doc-line.slt-pc         = ? then 0 else b-doc-line.slt-pc).
     2587                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2588               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2589         assign
