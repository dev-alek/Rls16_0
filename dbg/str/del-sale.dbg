     2795                                        in-vatp-goods.prod-code = b-doc-line.prod-code no-lock.
     2796      if (not b-trn-doc.internal and
     2797              b-trn-doc.doc-type = 'при':U) or
     2798         in-vatp-goods.gds-type = 'у':U then do:
     2799         if varinvprb = "base":u then do:
     2800           assign
