     3219           else assign
     3220               loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     3221               loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     3222               loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     3223                                       then 0
     3224                                       else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base) .
     3225         end.
     3226         if (not v-is-own and res-qnty = 0)
     3227         or (not rz and (loc-gds-dtl.doc-qnty = 0  and res-qnty = 0) and p-tpsi-obj)
     3228           then do:
     3229         end.
     3230         if chg-qnty = res-qnty and chg-qnty <> 0
     3231         AND parts-OK
     3232         AND (v-is-own
     3233             OR ((not v-is-own)
     3234                 and v-to-reserv
     3235                 and (
     3236                      ((loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty) and (rz))
     3237                      OR
