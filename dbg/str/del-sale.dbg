     1192   field to-res as decimal
     1193   field is-res as decimal
     1194   field o-was-res as decimal
     1195   field o-to-res as decimal
     1196   field o-is-res as decimal
     1197   index pi is unique primary
     1198   obj-type
     1199   obj-code
     1200   artic
     1201   prod-type
     1202   prod-code
     1203   index iartic
     1204   artic
     1205   prod-type
     1206   prod-code
     1207   .
     1208   define   temp-table tt0-doc-line no-undo like lib-trn_ret-line.
     1209   define   temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
     1210   define   temp-table tt0-parts    no-undo like ub.parts.
     1211   define   temp-table temp-tpsi-clients  no-undo like ub.clients.
     1212   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1213   define variable v-ps as character no-undo .
     1214   assign
     1215   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     1216                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     1217                     , buf_sale-doc.out-code
     1218                     , buf_sale-doc.obj-type
     1219                     , buf_sale-doc.obj-code
     1220                     , chr(4)
     1221                     , buf_sale-doc.tot-lines
     1222                     , buf_sale-doc.tot-dtl
     1223                     ).
     1224   return v-Ps.
     1225   END FUNCTION.
     1226   procedure create-tt0-doc-line-gds-dtl :
     1227   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     1228   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     1229   define input parameter p-ext-doc-type        as character no-undo .
     1230   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     1231   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     1232   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     1233   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     1234   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     1235   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     1236   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1237   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1238   define parameter buffer b-doc-line           for ub.doc-line.
     1239   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     1240   define parameter buffer buf_sale-doc for ub.sale-doc.
     1241   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     1242   define buffer other_doc-line for ub.doc-line.
     1243   define buffer other_gds-dtl for ub.gds-dtl.
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       find first tt0-doc-line where
     1248                 tt0-doc-line.obj-type = p-proprietor-obj-type
     1249             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     1250             AND tt0-doc-line.prod-type = p-prod-type
     1251             AND tt0-doc-line.prod-code = p-prod-code
     1252             AND tt0-doc-line.artic     = p-artic
     1253             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     1254             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     1255       if not available tt0-doc-line then do:
     1256         create tt0-doc-line.
     1257         buffer-copy b-doc-line
     1258         except
     1259         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     1260         to tt0-doc-line
     1261         assign
     1262         tt0-doc-line.status_ = 'нередакт':U
     1263         tt0-doc-line.ext-doc-type = p-ext-doc-type
     1264         tt0-doc-line.obj-type = p-proprietor-obj-type
     1265         tt0-doc-line.obj-code = p-proprietor-obj-code
     1266         tt0-doc-line.doc-code = p-doc-code
     1267         .
     1268       end.
     1269       if p-doc-code <> "":U then do:
     1270         find first other_doc-line no-lock where
     1271                 other_doc-line.doc-code = p-doc-code
     1272             AND  other_doc-line.artic    = p-artic
     1273             AND  other_doc-line.prod-type = p-prod-type
     1274             AND  other_doc-line.prod-code = p-prod-code no-error .
     1275         if available other_doc-line then do:
     1276           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     1277           assign
     1278           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     1279           .
     1280         end.
     1281         else do:
     1282           assign
     1283           tt0-doc-line.doc-code = '':U
     1284           .
     1285         end.
     1286       end.
     1287       find first tt0-gds-dtl where
     1288               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1289           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1290           AND tt0-gds-dtl.prod-type = p-prod-type
     1291           AND tt0-gds-dtl.prod-code = p-prod-code
     1292           AND tt0-gds-dtl.artic     = p-artic
     1293           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     1294       if not available tt0-gds-dtl then do:
     1295         create tt0-gds-dtl.
     1296         buffer-copy b-gds-dtl
     1297         except
     1298         obj-type obj-code doc-code doc-qnty fact-qnty
     1299         to tt0-gds-dtl
     1300         assign
     1301         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1302         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1303         tt0-gds-dtl.doc-code = p-doc-code
     1304         .
     1305       end.
     1306       if p-doc-code <> "":U then do:
     1307           find first other_gds-dtl no-lock where
     1308                   other_gds-dtl.doc-code = p-doc-code
     1309               AND  other_gds-dtl.artic    = p-artic
     1310               AND  other_gds-dtl.prod-type    = p-prod-type
     1311               AND  other_gds-dtl.prod-code    = p-prod-code
     1312               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     1313           if available other_gds-dtl then do:
     1314             assign
     1315             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     1316             .
     1317           end.
     1318           else do:
     1319             assign
     1320             tt0-gds-dtl.doc-code = '':U
     1321             .
     1322           end.
     1323       end.
     1324       assign
     1325       old-qnty = tt0-gds-dtl.doc-qnty
     1326       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     1327       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     1328       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     1329       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     1330       .
     1331     end.
     1332   end procedure.
     1333   procedure fill-tt-tpsi-table :
     1334   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     1335   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     1336   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     1337   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     1338   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     1339   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     1340   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     1341   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     1342   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     1343   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     1344   define buffer buf_goods for ub.goods.
     1345   define buffer buf_doc-line for ub.doc-line.
     1346   define buffer buf_gds-dtl for ub.gds-dtl.
     1347   define buffer buf_sale-doc for ub.sale-doc.
     1348     do
     1349     on error undo, return error
     1350     :
     1351       _doc-line:
     1352       for each buf_Doc-line no-lock where
     1353             buf_doc-line.doc-code = p-doc-code,
     1354         first buf_goods no-lock where
     1355             buf_goods.artic = buf_doc-line.artic
     1356        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     1357        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     1358           each buf_gds-dtl no-lock where
     1359             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     1360         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     1361         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1362         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1363         assign
     1364         v-ext-doc-type = "":U.
     1365         run tpsi-preselect-gds-proprietor in this-procedure (
     1366                                                     input buf_goods.gds-code
     1367                                                   ,input g#db-num
     1368                                                   ,output v-proprietor-host-code
     1369                                                   ,output v-proprietor-obj-type
     1370                                                   ,output v-proprietor-obj-code ) no-error .
     1371         if v-proprietor-host-code = p-host-code then do:
     1372           assign
     1373           v-ext-doc-type = 'ev':U .
     1374         end.
     1375         else do:
     1376           assign
     1377           v-ext-doc-type =  'ee':U .
     1378         end.
     1379         if  (v-proprietor-obj-type = p-obj-type
     1380         AND v-proprietor-obj-code = p-obj-code)
     1381         OR (v-proprietor-obj-type = "":U
     1382         AND v-proprietor-obj-code = 0)
     1383         OR v-proprietor-obj-code = ?
     1384         then next _doc-line.
     1385         find first buf_sale-doc no-lock where
     1386                   buf_sale-doc.inkas-code = p-doc-code
     1387              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     1388              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     1389              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     1390              no-error .
     1391         run create-tt0-doc-line-gds-dtl  in this-procedure (
     1392                                                              input v-proprietor-obj-type
     1393                                                             ,input v-proprietor-obj-code
     1394                                                             ,input v-ext-doc-type
     1395                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     1396                                                             ,input buf_doc-line.artic
     1397                                                             ,input buf_Doc-line.prod-type
     1398                                                             ,input buf_doc-line.prod-code
     1399                                                             ,input buf_gds-dtl.prt-code
     1400                                                             ,input 0
     1401                                                             ,output v-was-gds-dtl-fact-qnty
     1402                                                             ,output v-gds-dtl-fact-qnty
     1403                                                             ,buffer buf_doc-line
     1404                                                             ,buffer buf_gds-dtl
     1405                                                             ,buffer buf_sale-doc
     1406                                                           ).
     1407       end.
     1408     end.
     1409   end procedure.
     1410   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1412   procedure get-alias-type-price-obj :
     1413   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1414   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1415   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1416   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     1417   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     1418   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     1419   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     1420   define output parameter p-alias-type-price as character no-undo .
     1421   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     1422   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     1423   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     1424   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     1425   define variable v-mediat-objf               as character no-undo .
     1426   define variable v-param-type as character no-undo .
     1427   define variable v-value-character as character no-undo .
     1428   define variable v-value-date as date no-undo .
     1429   define variable v-value-decimal as decimal no-undo .
     1430   define variable v-value-integer as INTEGER no-undo .
     1431   define variable v-value-logical AS LOGICAL no-undo .
     1432   define variable v-tth as handle no-undo .
     1433   assign
     1434   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1435   define buffer buf_trn-doc for ub.trn-doc.
     1436     _main:
     1437     do
     1438     on error undo, return error return-value
     1439     :
     1440       run adm/shattri.p (
     1441         input "get":U
     1442         ,input  p-prop-obj-type
     1443         ,input  p-prop-obj-code
     1444         ,input  'alias-tpsi':U
     1445         ,input  '':U
     1446         ,output v-value-character
     1447         ,output v-value-date
     1448         ,output v-value-decimal
     1449         ,output v-value-integer
     1450         ,output v-value-logical
     1451         ,output v-param-type
     1452         ,INPUT-OUTPUT table-handle v-tth
     1453         ) no-error .
     1454       if error-status:error
     1455       then do:
     1456         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1457                                 , p-prop-obj-type
     1458                                 , p-prop-obj-code).
     1459       end.
     1460       find first thbjattr_thbj-attr where
     1461                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1462             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1463             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1464             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1465       if not available thbjattr_thbj-attr
     1466       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1467         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1468                                 , p-prop-obj-type
     1469                                 , p-prop-obj-code).
     1470       end.
     1471       assign
     1472       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1473       if p-prop-host-code = p-host-code
     1474       and (p-alias-type-price = '':U
     1475       or   p-alias-type-price <> '5':U)
     1476       then  do:
     1477         assign
     1478         p-ext-doc-type = 'ev':U
     1479         p-price-obj-type = p-obj-type
     1480         p-price-obj-code = p-obj-code
     1481         p-alias-type-price = '3':U
     1482         .
     1483       end.
     1484       else do:
     1485         if p-prop-host-code = p-host-code  then do:
     1486           assign
     1487           p-ext-doc-type = 'ev':U
     1488           p-price-obj-type = p-obj-type
     1489           p-price-obj-code = p-obj-code
     1490           .
     1491         end.
     1492         else do:
     1493           assign
     1494           p-ext-doc-type = 'ee':U.
     1495           assign
     1496           v-mediat-obj-type = "":U
     1497           v-mediat-obj-code = 0
     1498           v-mediat-objf = "":U
     1499           .
     1500           if p-alias-type-price = '4':U then do:
     1501             find first thbjattr_thbj-attr where
     1502                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1503                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1504                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1505                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1506             if not available thbjattr_thbj-attr
     1507             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1508               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1509                                       , p-prop-obj-type
     1510                                       , p-prop-obj-code).
     1511             end.
     1512             assign
     1513             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1514             v-mediat-obj-type = entry(1, v-mediat-objf)
     1515             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1516             no-error
     1517             .
     1518             if error-status:error then do:
     1519               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1520                                       , p-prop-obj-type
     1521                                       , p-prop-obj-code).
     1522             end.
     1523           end.
     1524           CASE p-alias-type-price:
     1525             when '1':U then do:
     1526               assign
     1527               p-price-obj-type = p-prop-obj-type
     1528               p-price-obj-code = p-prop-obj-code
     1529               .
     1530             end.
     1531             when '2':U then do:
     1532               assign
     1533               p-price-obj-type = p-prop-obj-type
     1534               p-price-obj-code = p-prop-obj-code
     1535               .
     1536             end.
     1537             when '3':U
     1538             or
     1539             when '5':U
     1540             then do:
     1541               assign
     1542               p-price-obj-type = p-obj-type
     1543               p-price-obj-code = p-obj-code
     1544               .
     1545             end.
     1546             when '4':U then do:
     1547               assign
     1548               p-price-obj-type = v-mediat-obj-type
     1549               p-price-obj-code = v-mediat-obj-code
     1550               .
     1551             end.
     1552           END CASE.
     1553         end.
     1554       end.
     1555     end.
     1556   end procedure.
     1557   procedure write-tt0-info:
     1558   define input parameter p-artic as character no-undo .
     1559   define input parameter p-prod-type as character no-undo .
     1560   define input parameter p-prod-code as integer no-undo .
     1561   define input parameter p-prt-code as integer no-undo .
     1562   define input parameter p-obj-type as character no-undo .
     1563   define input parameter p-obj-code as integer no-undo .
     1564   define input parameter p-doc-code as character no-undo .
     1565   define input parameter p-from-tpsi as logical no-undo .
     1566   define input parameter p-all-qnty as decimal no-undo .
     1567   define input parameter p-was-res as decimal no-undo .
     1568   define input parameter p-to-res as decimal no-undo .
     1569   define input parameter p-is-res as decimal no-undo .
     1570   define input parameter p-o-was-res as decimal no-undo .
     1571   define input parameter p-o-to-res as decimal no-undo .
     1572   define input parameter p-o-is-res as decimal no-undo .
     1573   define input parameter p-mess   as character no-undo .
     1574   define buffer buf_tt0-info for tt0-info.
     1575     do
     1576     on error undo, return error return-value
     1577     :
     1578       find first buf_tt0-info where
     1579                buf_tt0-info.artic = p-artic
     1580            and buf_tt0-info.prod-type = p-prod-type
     1581            and buf_tt0-info.prod-code = p-prod-code
     1582            and buf_tt0-info.prt-code = p-prt-code
     1583            no-error .
     1584       if not available buf_tt0-info then do:
     1585         create buf_tt0-info.
     1586         assign
     1587         buf_tt0-info.artic = p-artic
     1588         buf_tt0-info.prod-type = p-prod-type
     1589         buf_tt0-info.prod-code = p-prod-code
     1590         buf_tt0-info.prt-code  = p-prt-code
     1591         buf_tt0-info.obj-type  = p-obj-type
     1592         buf_tt0-info.obj-code  = p-obj-code
     1593         buf_tt0-info.a-to-res  = ?
     1594         buf_tt0-info.to-res    = ?
     1595         buf_tt0-info.was-res   = ?
     1596         buf_tt0-info.o-was-res = ?
     1597         buf_tt0-info.o-to-res  = ?
     1598         buf_tt0-info.o-is-res  = ?
     1599         buf_tt0-info.is-res    = ?
     1600         .
     1601       end.
     1602       assign
     1603       buf_tt0-info.a-to-res  =
     1604                                 (if buf_tt0-info.a-to-res <> ?
     1605                                 and p-all-qnty = ?
     1606                                 then buf_tt0-info.a-to-res
     1607                                 else p-all-qnty)
     1608       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1609                                 and p-was-res = ?
     1610                                 then buf_tt0-info.was-res
     1611                                 else p-was-res)
     1612       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1613                                 and p-to-res = ?
     1614                                 then buf_tt0-info.to-res
     1615                                 else p-to-res)
     1616       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1617                                 and p-is-res = ?
     1618                                 then buf_tt0-info.is-res
     1619                                 else p-is-res)
     1620       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1621                                 and p-o-was-res = ?
     1622                                 then buf_tt0-info.o-was-res
     1623                                 else p-o-was-res)
     1624       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1625                                 and p-o-to-res = ?
     1626                                 then buf_tt0-info.o-to-res
     1627                                 else p-o-to-res)
     1628       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1629                                 and p-o-is-res = ?
     1630                                 then buf_tt0-info.o-is-res
     1631                                 else p-o-is-res)
     1632       .
     1633       assign
     1634       buf_tt0-info.doc-code  = p-doc-code
     1635       buf_tt0-info.error-message   = p-mess
     1636       .
     1637     end.
     1638   end procedure.
     1639   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   procedure cur-time :
     1641      define output parameter p-today as date      no-undo .
     1642      define output parameter p-time  as integer   no-undo .
     1643     do
     1644     on error undo, return error
     1645     :
     1646       define variable v-date1 as date      no-undo .
     1647       define variable v-date2 as date      no-undo .
     1648       define variable v-time  as integer   no-undo .
     1649       assign
     1650         v-date1 = today
     1651         v-time  = time
     1652         v-date2 = today
     1653       .
     1654       if v-date1 <> v-date2
     1655       then do:
     1656         assign
     1657           v-date1 = today
     1658           v-time  = v-time
     1659         .
     1660       end.
     1661       assign
     1662         p-today = v-date1
     1663         p-time  = v-time
     1664       .
     1665     end.
     1666   end.
     1667   function cur-time-date returns character
     1668   :
     1669     return string(today, '99/99/9999':U) .
     1670   end.
     1671   function cur-time-mjd returns decimal
     1672   :
     1673     define variable v-date as date      no-undo .
     1674     define variable v-time as integer   no-undo .
     1675     run cur-time in this-procedure
     1676       (output v-date
     1677       ,output v-time
     1678       ) .
     1679     return integer(v-date) - 2400002 + (v-time / 86400) .
     1680   end.
     1681   function cur-time-get-ending-index returns integer
     1682   (input p-number as integer
     1683   )
     1684   :
     1685     if p-number < 0
     1686     or p-number = ?
     1687     then do:
     1688       return 1 .
     1689     end.
     1690     define variable v-rest as integer   no-undo .
     1691     assign
     1692       p-number = p-number modulo 100
     1693     .
     1694     if p-number < 20
     1695     then do:
     1696       assign
     1697         v-rest = p-number
     1698       .
     1699     end.
     1700     else do:
     1701       assign
     1702         v-rest = p-number modulo 10
     1703       .
     1704     end.
     1705     case v-rest :
     1706       when 1
     1707       then do:
     1708         return 2 .
     1709       end.
     1710       when 2 or
     1711       when 3 or
     1712       when 4
     1713       then do:
     1714         return 3 .
     1715       end.
     1716       otherwise do:
     1717         return 1 .
     1718       end.
     1719     end case .
     1720   end.
     1721   procedure cur-time-mjd-to-date :
     1722      define input  parameter i-mjd-diff as decimal no-undo.
     1723      define output parameter o-Date     as date    no-undo.
     1724      define output parameter o-Time     as integer no-undo.
     1725      define variable v-day-number as integer   no-undo .
     1726      if    i-mjd-diff < 0
     1727         or i-mjd-diff = ?
     1728      then do:
     1729         return "?" .
     1730      end.
     1731      assign
     1732         v-day-number = truncate(i-mjd-diff,0).
     1733         o-Date = date(v-day-number + 2400002).
     1734         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1735     .
     1736   end.
     1737   function cur-time-mjd-to-string returns character
     1738   (input p-mjd-diff as decimal
     1739   )
     1740   :
     1741     define variable v-day-number as integer   no-undo .
     1742     define variable v-seconds    as integer   no-undo .
     1743     define variable v-hour       as integer   no-undo .
     1744     define variable v-min        as integer   no-undo .
     1745     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1746     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1747     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1748     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1749     if p-mjd-diff < 0
     1750     or p-mjd-diff = ?
     1751     then do:
     1752       return "?" .
     1753     end.
     1754     assign
     1755       v-day-number = integer(truncate(p-mjd-diff,0))
     1756       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1757     .
     1758     if v-seconds > 86400
     1759     then do:
     1760       assign
     1761         v-seconds = 86400 - 1
     1762       .
     1763     end.
     1764     if v-seconds < 0
     1765     then do:
     1766       assign
     1767         v-seconds = 0
     1768       .
     1769     end.
     1770     assign
     1771       v-hour = truncate(v-seconds / 3600, 0)
     1772     .
     1773     assign
     1774       v-seconds = v-seconds modulo 3600
     1775     .
     1776     assign
     1777       v-min = truncate(v-seconds / 60, 0)
     1778     .
     1779     assign
     1780       v-seconds = v-seconds modulo 60
     1781     .
     1782     return
     1783         (if v-day-number <> 0
     1784           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1785           else ""
     1786         )
     1787       + (if v-day-number <> 0 or v-hour <> 0
     1788           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1789           else ""
     1790         )
     1791       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1792           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1793           else ""
     1794         )
     1795       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1796       .
     1797   end.
     1798   function cur-time-string returns character
     1799   :
     1800     define variable v-date as date      no-undo .
     1801     define variable v-time as integer   no-undo .
     1802     run cur-time in this-procedure
     1803       (output v-date
     1804       ,output v-time
     1805       ) .
     1806     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1807   end.
     1808   function cur-time-string-sec returns character
     1809   :
     1810     define variable v-date as date      no-undo .
     1811     define variable v-time as integer   no-undo .
     1812     run cur-time in this-procedure
     1813       (output v-date
     1814       ,output v-time
     1815       ) .
     1816     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1817   end.
     1818   function cur-time-custom  returns character
     1819   (input p-prefix as character
     1820   ,input p-date-format as character
     1821   ,input p-delimiter as character
     1822   ,input p-time-format as character
     1823   ,input p-suffix as character
     1824   )
     1825   :
     1826     define variable v-date as date      no-undo .
     1827     define variable v-time as integer   no-undo .
     1828     run cur-time in this-procedure
     1829       (output v-date
     1830       ,output v-time
     1831       ) .
     1832     return
     1833       p-prefix
     1834       + string(v-date, p-date-format)
     1835       + p-delimiter
     1836       + string(v-time, p-time-format)
     1837       + p-suffix
     1838       .
     1839   end.
     1840   function cur-time-print  returns character
     1841   :
     1842     define variable v-date as date      no-undo .
     1843     define variable v-time as integer   no-undo .
     1844     run cur-time in this-procedure
     1845       (output v-date
     1846       ,output v-time
     1847       ) .
     1848     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1849   end.
     1850   function cur-time-datetime returns datetime
     1851   :
     1852     define variable v-char as character no-undo .
     1853     define variable v-datetime as datetime no-undo .
     1854     v-char = cur-time-string().
     1855     v-datetime = datetime(v-char).
     1856     return  v-datetime.
     1857   end.
     1858   function cur-time-string-msec returns character
     1859   :
     1860     define variable v-date as datetime  no-undo .
     1861     v-date = now.
     1862     return string(v-date) .
     1863   end.
     1864   define variable v-view-log as logical no-undo .
     1865   define variable v-esm as character no-undo .
     1866   define variable v-input-error as logical no-undo .
     1867   define variable v-found as character no-undo .
     1868   define variable log-file-name as character no-undo .
     1869   define buffer buf_sale-doc for ub.sale-doc.
     1870   define buffer tpsi_sale-doc for ub.sale-doc.
     1871   define buffer check_sale-doc for ub.sale-doc.
     1872   define buffer check_gds-dtl for ub.gds-dtl.
     1873   if num-entries(p-parameter, chr(4)) <> 5
     1874   then do:
     1875     assign
     1876     v-input-error = yes
     1877     v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 5"
     1878                                , num-entries(p-parameter, chr(4))).
     1879     .
     1880   end.
     1881   else do:
     1882     assign
     1883     p-auto              = integer(entry(1, p-parameter, chr(4)))
     1884     p-obj-type          = entry(2, p-parameter, chr(4))
     1885     p-obj-code          = integer(entry(3, p-parameter, chr(4)))
     1886     forced              = logical(entry(4, p-parameter, chr(4)))
     1887     p-inkas-code        = entry(5, p-parameter, chr(4))
     1888     no-error .
     1889     if error-status:error then do:
     1890       assign
     1891       v-esm = error-status:get-message(1)
     1892       v-input-error = yes
     1893       .
     1894     end.
     1895   end.
     1896   if p-auto <= 1 then do:
     1897      log-file-name = 'saleclos.log'.
     1898   end.
     1899   else do:
     1900      log-file-name = 'ext-sale.log'.
     1901   end.
     1902   define variable ii         as integer no-undo.
     1903   define variable const-str as char       init "Отвязано чеков и строк : " format "x(30)" no-undo.
     1904   define variable rdoc-line as recid.
     1905   define variable r-or-v as character no-undo.
     1906   define variable num_resv as int no-undo.
     1907   define variable num_resv_res as int no-undo.
     1908   define variable ser-good as logical init no.
     1909   define variable found-unres as logical init no.
     1910   define variable v-is-tpsi-obj as logical no-undo .
     1911   define variable glog as logical no-undo .
     1912   define variable autofbr as logical no-undo .
     1913   define variable v-curr-r-b as character no-undo .
     1914   define variable v-host-code like ub.sysconf.host-code no-undo .
     1915   define variable v-was-gds-moving             as logical no-undo .
     1916   define variable varchip-code                as integer no-undo .
     1917   define variable varchip-code2               as integer no-undo .
     1918   define variable v-mes                       as character no-undo .
     1919   define buffer ink-doc for ub.inkas.
