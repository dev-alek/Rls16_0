     2803         end.
     2804         else do:
     2805           ASSIGN
     2806             road-tax-rubl-loc = b-doc-line.road-tax
     2807             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     2808         end.
     2809         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2810         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2811         assign
     2812           road-tax-cli-loc = ?.
     2813         ASSIGN
     2814           transport-base-loc = (if b-doc-line.transport-base = ? then 0 else b-doc-line.transport-base)
     2815           transport-rubl-loc = (if b-doc-line.transport-rubl = ? then 0 else b-doc-line.transport-rubl)
     2816           transport-cli-loc  = 0
     2817           other-base-loc     = (if b-doc-line.other-base     = ? then 0 else b-doc-line.other-base)
     2818           other-rubl-loc     = (if b-doc-line.other-rubl     = ? then 0 else b-doc-line.other-rubl)
     2819           other-cli-loc      = 0
     2820           vat-pc-loc         = (if b-doc-line.vat-pc         = ? then 0 else b-doc-line.vat-pc)
     2821           slt-pc-loc         = (if b-doc-line.slt-pc         = ? then 0 else b-doc-line.slt-pc).
     2822                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2823               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2824         assign
     2825           vat-cli-loc            = ?
     2826           slt-cli-loc            = ?
     2827           price-cli-with-tax-loc = ?.
     2828      end.
     2829      else do:
     2830                                                   for each in-vatp-parts where in-vatp-parts.out-code  = b-doc-line.doc-code  and
     2831                                         in-vatp-parts.obj-type  = b-doc-line.obj-type  and
     2832                                         in-vatp-parts.obj-code  = b-doc-line.obj-code  and
     2833                                         in-vatp-parts.artic     = b-doc-line.artic     and
     2834                                         in-vatp-parts.prod-type = b-doc-line.prod-type and
     2835                                         in-vatp-parts.prod-code = b-doc-line.prod-code
     2836                            use-index out-code no-lock:
     2837             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     2838                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     2839                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     2840                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     2841                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     2842                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     2843                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2844                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2845                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2846                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2847                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2848                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2849                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2850                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2851                         .
     2852         end.
     2853         ASSIGN
     2854           road-tax-base-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     2855           road-tax-rubl-loc   = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     2856           transport-base-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     2857           transport-rubl-loc  = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     2858           other-base-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     2859           other-rubl-loc      = if b-doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b-doc-line.fact-qnty  else 0
     2860                                           vat-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     2861           slt-base-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     2862                   vat-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b-doc-line.fact-qnty   else 0
     2863           slt-rubl-loc        = if b-doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b-doc-line.fact-qnty   else 0
     2864           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     2865           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     2866         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     2867         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     2868         if transport-base-loc = ? then transport-base-loc = 0.
     2869         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     2870         if other-base-loc     = ? then other-base-loc     = 0.
     2871         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     2872         assign
     2873           transport-cli-loc      = 0
     2874           other-cli-loc          = 0
     2875           road-tax-cli-loc       = ?
     2876           vat-cli-loc            = ?
     2877           slt-cli-loc            = ?
     2878           price-cli-with-tax-loc = ?.
     2879      end.
     2880   ASSIGN
     2881             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2882       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2883   .
     2884           assign
     2885           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U then road-tax-rubl-loc else road-tax-base-loc).
     2886         end.
     2887         if rz then do:
     2888           if b-trn-doc.print-rubl
     2889           then assign
     2890             loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     2891             loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     2892             loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     2893                                      then 0
     2894                                      else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     2895           else
     2896           assign
     2897           loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     2898           loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     2899           loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     2900                                    then 0
     2901                                    else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base ).
     2902         end.
     2903       end.
     2904       if chg-qnty = res-qnty
     2905       then parts-ok = yes.
     2906       else parts-ok = no.
     2907       release loc-gds-dtl.
     2908       if no-partion-qnty = 0 then return.
     2909     end.
     2910     if not cashparts or no-partion-qnty <> 0 or NOT cashplace OR no-place-qnty <> 0 then do:
     2911     if cashplace then no-partion-qnty = no-place-qnty.
     2912     _gdsdtl:
     2913     FOR EACH loc-gds-dtl WHERE
     2914             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     2915             loc-gds-dtl.artic = b-doc-line.artic AND
     2916             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     2917             loc-gds-dtl.prod-code = b-doc-line.prod-code
     2918             EXCLUSIVE-LOCK ON ERROR UNDO, NEXT:
     2919       IF rz AND loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then NEXT.
     2920       IF not rz AND loc-gds-dtl.doc-qnty = 0 AND v-is-own then NEXT.
     2921       IF NOT (rgds-dtl = ?) then do:
     2922         if NOT recid(loc-gds-dtl) = rgds-dtl THEN NEXT.
     2923         assign
     2924         r-prt-code = loc-gds-dtl.prt-code.
     2925       end.
     2926   if ( num_rec modulo 10 ) = 0 then
     2927   .
     2928       assign
     2929       res-qnty = if cashparts
     2930                   then (if rz
     2931                         then no-partion-qnty
     2932                         else (if r-qnty = ?
     2933                               then (- loc-gds-dtl.doc-qnty)
     2934                               else no-partion-qnty)
     2935                         )
     2936                   else (if rz
     2937                         then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     2938                         else (if r-qnty = ?
     2939                               then (- loc-gds-dtl.doc-qnty)
     2940                               else r-qnty
     2941                               )
     2942                         )
     2943       chg-qnty = res-qnty
     2944       cost-base = 0
     2945       cost-rubl = 0 .
     2946       if not v-is-own and rz then do:
     2947         find first buf_tt0-gds-dtl no-lock where
     2948                   buf_tt0-gds-dtl.artic     = loc-gds-dtl.artic
     2949               AND buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     2950               AND buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     2951               AND buf_tt0-gds-dtl.prt-code = loc-gds-dtl.prt-code no-error .
     2952         if available buf_tt0-gds-dtl then do:
     2953           assign
     2954           chg-qnty = chg-qnty - buf_tt0-gds-dtl.doc-qnty.
     2955         end.
     2956       end.
     2957       if not v-is-own and not rz and chg-qnty = 0 then
     2958       assign
     2959       v-to-reserv = no
     2960       .
     2961       if not v-is-own
     2962       and rz
     2963       and (available buf_tt0-gds-dtl and (buf_tt0-gds-dtl.doc-qnty + loc-gds-dtl.doc-qnty) = loc-gds-dtl.fact-qnty)
     2964       then
     2965       assign
     2966       v-to-reserv = no
     2967       .
     2968       if p-auto-fbr-on
     2969       then do :
     2970         find first goods no-lock where goods.artic = loc-gds-dtl.artic
     2971                                    and goods.prod-type = loc-gds-dtl.prod-type
     2972                                    and goods.prod-code = loc-gds-dtl.prod-code
     2973                                    .
     2974         if b-trn-doc.ext-doc-type =  'rs':U
     2975         then do :
     2976           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = replace(loc-gds-dtl.doc-code, "=", "-")
     2977                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     2978                                                no-error .
     2979           if available buf_doc-fbr-gds
     2980           then do :
     2981             if buf_doc-fbr-gds.fact-qnty > 0
     2982             then do :
     2983               assign
     2984                 v-to-reserv = no
     2985               .
     2986             end.
     2987             else do :
     2988               chg-qnty = if res-qnty >= 0 then abs(buf_doc-fbr-gds.fact-qnty) else buf_doc-fbr-gds.fact-qnty.
     2989             end.
     2990           end.
     2991         end.
     2992         if b-trn-doc.ext-doc-type =  'es':U
     2993         then do :
     2994           find first buf_doc-fbr-gds no-lock where buf_doc-fbr-gds.out-code = loc-gds-dtl.doc-code
     2995                                                and buf_doc-fbr-gds.gds-code = goods.gds-code
     2996                                                no-error .
     2997           if available buf_doc-fbr-gds
     2998           then do :
     2999             if buf_doc-fbr-gds.fact-qnty >= 0
     3000             then do :
     3001               chg-qnty = if res-qnty >= 0 then buf_doc-fbr-gds.fact-qnty else - buf_doc-fbr-gds.fact-qnty .
     3002             end.
     3003             else do :
     3004               assign
     3005                 v-to-reserv = no
     3006               .
     3007             end.
     3008           end.
     3009         end.
     3010       end.
     3011       if v-to-reserv and chg-qnty <> 0 then do:
     3012         if b-trn-doc.status_ = 'нередакт':U
     3013         or b-trn-doc.flag <> no
     3014         then do:
     3015           assign
     3016           v-return-status =  b-trn-doc.status_
     3017           v-return-flag = b-trn-doc.flag
     3018           b-trn-doc.status_ = 'накл':U
     3019           b-trn-doc.flag = no
     3020           v-return-st-fl = yes
     3021           .
     3022         end.
     3023         if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     3024         then do :
     3025           if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     3026         end.
     3027         run trg/rsrv-dtl.p (
     3028                          input parparentproc
     3029                         ,input rsrv-option
     3030                         ,buffer loc-gds-dtl
     3031                         ,input-output chg-qnty
     3032                         ,input-output cost-base
     3033                         ,input-output cost-rubl
     3034                         , -1
     3035                         , "" ) no-error.
     3036         if error-status:error then  do:
     3037           v-return-st-fl = no.
     3038           undo _gdsdtl, NEXT.
     3039         end.
     3040       if v-return-st-fl then do:
     3041         assign
     3042         b-trn-doc.status_ = v-return-status
     3043         b-trn-doc.flag = v-return-flag
     3044         v-return-st-fl = no
     3045         .
     3046       end.
