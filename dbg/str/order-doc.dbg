      307   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      308   DO:
      309           define buffer bf_order-line  for ub.order-line .
      310           define buffer buF_order-line for ub.order-line .
      311           define variable line-num as integer no-undo .
      312           empty temp-table gds-list .
      313           empty temp-table tt-gds-list .
      314           for each buF_order-line no-lock where buF_order-line.doc-code = p-doc-code:
      315               create tt-gds-list .
      316               assign
      317                   tt-gds-list.artic     = buF_order-line.artic
      318                   tt-gds-list.gds-code  = buF_order-line.gds-code
      319                   tt-gds-list.prod-code = buF_order-line.prod-code
      320                   tt-gds-list.prod-type = buF_order-line.prod-type
      321                   .
      322           end.
      323           RUN str/order_choose.w (
      324               input  parparentproc,
      325               input  "b-mark,b-sel",
      326               input  v-cntxt-host-code-obj,
      327               input  X_order.contract-code,
      328               input integer(''),
      329               input  X_order.params,
      330               input X_order.doc-code,
      331               input X_order.db-num,
      332               input table tt-gds-list,
      333               output table gds-list
      334               ).
      335           find last bf_order-line no-lock where bf_order-line.doc-code = X_order.doc-code no-error .
      336           if available (bf_order-line) then line-num = bf_order-line.line-num .
      337           for each gds-list:
      338               find first buf_order-line no-lock where buf_order-line.gds-code = gds-list.gds-code
      339                   and buf_order-line.doc-code = X_order.doc-code no-error .
      340               if not available (buf_order-line) then
      341               do:
      342                   line-num = line-num + 1 .
      343                   create buf_order-line .
      344                   assign
      345                       buf_order-line.doc-code   = X_order.doc-code
      346                       buf_order-line.db-num     = X_order.db-num
      347                       buf_order-line.line-num   = line-num
      348                       buf_order-line.artic      = gds-list.artic
      349                       buf_order-line.order-qnty = gds-list.doc-qnty
      350                       buf_order-line.gds-code   = gds-list.gds-code
      351                       buf_order-line.prod-code  = gds-list.prod-code
      352                       buf_order-line.prod-type  = gds-list.prod-type
      353                       .
      354               end.
      355           end.
      356           OPEN QUERY br-line FOR EACH X_order-line no-lock where X_order-line.doc-code = p-doc-code INDEXED-REPOSITION.
      357       END.
      358   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      359   DO:
      360           define variable p-ok as logical no-undo .
      361           find first X_order-line no-lock where X_order-line.db-num = X_order.db-num and X_order-line.doc-code = X_order.doc-code no-error .
      362           if not available (X_order-line) then do:
      363            message "Вы уверены, что хотите закрыть заказ без сохранения?" skip
      364                    "Пустой заказ будет удален"
      365            view-as alert-box question buttons yes-no update p-ok.
      366            if p-ok then do:
      367            delete X_order .
      368            end.
      369            else return no-apply .
      370           end.
      371           vUndo = yes.
      372           return.
      373       END.
      374   ON CHOOSE OF b-date IN FRAME Dialog-Frame
      375   DO:
      376           if par-mode <> 'ПРОСМОТР':U then
      377           do:
      378               run sel-date in this-procedure
      379                   (input X_order.order-date :handle
      380                   ,input ""
      381                   ) .
      382               if date(X_order.order-date:screen-value) < today then
      383               do:
      384                   message "Дата заказа должна быть равна или больше текущей"
      385                       view-as alert-box.
      386                   display X_order.order-date with frame Dialog-Frame .
      387                   return no-apply .
      388               end.
      389               assign X_order.order-date .
      390           end.
      391       END.
      392   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      393   DO:
      394           define variable ii as integer no-undo .
      395           define buffer bf_order-line for ub.order-line .
      396           define variable recid_line as integer no-undo init ?.
      397           if v-rid-list = "" then
      398           do:
      399               if available (X_order-line) then
      400               do:
      401                   ii = X_order-line.line-num .
      402                   delete X_order-line .
      403               end.
      404               find first X_order-line where X_order-line.doc-code = X_order.doc-code and
      405               X_order-line.db-num = X_order.db-num and X_order-line.line-num > ii no-error .
      406               if available (X_order-line) then do:
      407                   recid_line = recid(X_order-line) .
      408               end.
      409           end.
      410           else
      411           do:
      412               do ii = 0 to num-entries (v-rid-list):
      413                   find first bf_order-line exclusive-lock where recid(bf_order-line) = integer(entry (ii,v-rid-list)) no-error .
      414                   if available (bf_order-line) then
      415                   do:
      416                       delete bf_order-line .
      417                   end.
      418               end.
      419           end.
      420            OPEN QUERY br-line FOR EACH X_order-line no-lock where X_order-line.doc-code = p-doc-code INDEXED-REPOSITION.
      421           if recid_line <> ? then reposition br-line to recid recid_line no-error .
      422       END.
      423   ON CHOOSE OF b-excel IN FRAME Dialog-Frame
      424   DO:
      425           define variable Log-Res as logical no-undo .
      426   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      427   do:
      428     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      429       (input  v-cntxt-db-num
      430       ,input  v-cntxt-userid
      431       ,input  0
      432       ,input  'actn_pmnt-ord-doc_lookup':U
      433       ,input  'object':U
      434       ,input  v-cntxt-host-code-obj
      435       ,input  v-cntxt-obj-type
      436       ,input  v-cntxt-obj-code
      437       ,input  0
      438       ,input  0
      439       ,input  0
      440       ,input  true
      441       ,output log-res
      442       )  .
      443   end.
      444               if not log-res then return no-apply .
      445           run rep/r-order.p(input parparentproc,
      446               input X_order.doc-code,
      447               input X_order.db-num,
      448               input X_order.params)  .
      449       END.
      450   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
      451   DO:
      452           define variable v-rid-list as character no-undo.
      453           if available (X_order) then
      454           do:
      455               row_order = rowid (X_order) .
      456               run ref/cordhist.w (
      457                   X_order.db-num,
      458                   X_order.doc-code,
      459                   parparentproc,
      460                   0,
      461                   "",
      462                   0,
      463                   "",
      464                   "one",
      465                   ?,
      466                   "",
      467                   "" ,
      468                   v-cntxt-db-num,
      469                   ?,
      470                   input-output v-rid-list ) .
      471           end.
      472       END.
      473   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      474   DO:
      475           define variable loc#log as logical no-undo .
      476           if available X_order-line then
      477           do:
      478   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   define variable v-str-recid7 as character no-undo .
      480   define variable v-num-entry7 as integer   no-undo .
      481   assign
      482     v-str-recid7 = trim( string( recid( X_order-line ) , "->>>>>>>>>>>9":U ) )
      483     v-num-entry7 = lookup( v-str-recid7 , v-rid-list )
      484   .
      485   if v-num-entry7 > 0 then do:
      486     assign
      487       entry( v-num-entry7, v-rid-list ) = "":U
      488       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      489     .
      490   end.
      491   else do:
      492     assign
      493       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      494     .
      495   end.
      496               row_order = rowid(X_order-line).
      497               loc#log = br-line:refresh() .
      498               reposition br-line to rowid row_order.
      499               if last-event:function <> "MOUSE-SELECT-DBLCLICK" then
      500               do:
      501                   loc#log = br-line:select-next-row ().
      502                   apply "VALUE-CHANGED" to br-line in frame Dialog-Frame.
      503               end.
      504           end.
      505           apply "entry" to br-line in frame Dialog-Frame.
      506       END.
      507   ON CHOOSE OF b-next IN FRAME Dialog-Frame
      508   DO:
      509           assign .
      510       END.
      511   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
      512   DO:
      513           assign .
      514       END.
      515   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      516   DO:
      517       define variable p-ok as logical no-undo .
      518       find first X_order-line no-lock where X_order-line.db-num = X_order.db-num and X_order-line.doc-code = X_order.doc-code no-error .
      519           if not available (X_order-line) then do:
      520            message "Вы уверены, что хотите закрыть заказ?" skip
      521                    "Пустой заказ будет удален"
      522            view-as alert-box question buttons yes-no update p-ok.
      523            if p-ok then do:
      524            delete X_order .
      525            return .
      526            end.
      527            else return no-apply .
      528           end.
      529       END.
      530   ON CHOOSE OF b-send IN FRAME Dialog-Frame
      531   DO:
      532           define variable p-ok as logical no-undo .
      533           find first X_order-line no-lock where X_order-line.doc-code = X_order.doc-code and
      534           X_order-line.db-num = X_order.db-num no-error .
      535           if not available (X_order-line) then do:
      536               message "Нельзя отправить заказ, т.к. нет товаров по нему"
      537               view-as alert-box.
      538               return no-apply .
      539           end.
      540           find first X_order-line no-lock where X_order-line.doc-code = X_order.doc-code and
      541           X_order-line.db-num = X_order.db-num and X_order-line.order-qnty <= 0 no-error .
      542           if not available (X_order-line) then
      543           do:
      544               message "Вы уверены, что хотите отправить заказ поставщику?"
      545                   view-as alert-box question buttons yes-no update p-ok.
      546               if p-ok then
      547               do:
      548                   run bge\send1cerp.p (parparentproc,
      549                       this-procedure,
      550                       this-procedure,
      551                       "order",
      552                       (buffer X_order:handle),
      553                       ?,
      554                       ?) no-error.
      555                   if  error-status:error then
      556                   do:
      557                       message return-value
      558                           view-as alert-box.
      559                       return .
      560                   end.
      561                   X_order.sts = StatusOrder:Sended:KeyIntDB .
      562                   run init_tt .
      563               end.
      564           end.
      565           else
      566           do:
      567               message "Количество товара в заказе не может быть отрицательным или равным нулю"
      568               view-as alert-box .
      569               return no-apply .
      570           end.
      571       END.
      572   ON ROW-DISPLAY OF br-line IN FRAME Dialog-Frame
      573   DO:
      574           if  X_order-line.order-qnty <= 0 then
      575           do:
      576               do ii = 1 to extent (bcol):
      577                   if valid-handle (bcol[ii])
      578                       then
      579                   do:
      580                       assign
      581                           bcol[ii]:fgcolor = red_COLOR.
      582                   end.
      583               end.
      584           end.
      585           if X_order.sts <> StatusOrder:NewStatus:KeyIntDB and
      586              X_order.sts <> StatusOrder:Sended:KeyIntDB then
      587           do:
      588           if  X_order-line.order-qnty <> X_order-line.fact-qnty then
      589           do:
      590               do ii = 1 to extent (bcol):
      591                   if valid-handle (bcol[ii])
      592                       then
      593                   do:
      594                       assign
      595                           bcol[ii]:fgcolor = red_COLOR.
      596                   end.
      597               end.
      598           end.
      599           end.
      600       END .
      601   ON row-leave OF br-line IN FRAME Dialog-Frame
      602   DO:
      603           find current X_order-line exclusive-lock.
      604           assign
      605               browse br-line X_order-line.order-qnty
      606               .
      607               if X_order-line.order-qnty = ? then do:
      608                   return no-apply .
      609               end.
      610               X_order-line.fact-qnty = X_order-line.order-qnty .
      611           find current X_order-line no-lock.
      612           br-line:refresh ().
      613           apply "ROW-DISPLAY" to br-line IN FRAME Dialog-Frame.
      614       end.
      615   ON LEAVE OF X_order.order-date IN FRAME Dialog-Frame
      616   DO:
      617           apply "TAB":U to self .
      618       END.
      619   ON RETURN OF X_order.order-date IN FRAME Dialog-Frame
      620   DO:
      621           apply "TAB":U to self .
      622       END.
      623   ON TAB OF X_order.order-date IN FRAME Dialog-Frame
      624   DO:
      625           date(X_order.order-date:screen-value) no-error.
      626           if error-status:error then
      627           do:
      628               message "Ошибка ввода даты"
      629                   view-as alert-box.
      630               display X_order.order-date with frame Dialog-Frame .
      631               return no-apply .
      632           end.
      633           if string(X_order.order-date) <> X_order.order-date:screen-value then
      634           do:
      635               if date(X_order.order-date:screen-value) < today then
      636               do:
      637                   message "Дата заказа должна быть равна или больше текущей"
      638                       view-as alert-box.
      639                   display X_order.order-date with frame Dialog-Frame .
      640                   return no-apply.
      641               end.
      642               assign X_order.order-date .
      643               display X_order.order-date with frame Dialog-Frame .
      644           end.
      645       END.
      646   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      647       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      648   MAIN-BLOCK:
      649   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      650       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      651   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   on ' ' of v-doc-date in frame Dialog-Frame
      653   do:
      654     if (can-query (self, "sensitive")
      655        and
      656        self :sensitive = true
      657        )
      658     or (can-query (self, "read-only")
      659        and
      660        self :read-only = false
      661        )
      662     then do:
      663       assign
      664         self :screen-value = ?
      665       .
      666     end.
      667     return no-apply.
      668   end.
      669   on delete-character of v-doc-date in frame Dialog-Frame
      670   do:
      671     if (can-query (self, "sensitive")
      672        and
      673        self :sensitive = true
      674        )
      675     or (can-query (self, "read-only")
      676        and
      677        self :read-only = false
      678        )
      679     then do:
      680       assign
      681         self :screen-value = ?
      682       .
      683     end.
      684     return no-apply.
      685   end.
      686   on ctrl-d of v-doc-date in frame Dialog-Frame
      687   do:
      688     define variable v-curr-sv-date as date no-undo .
      689     if (can-query (self, "sensitive")
      690        and
      691        self :sensitive = true
      692        )
      693     or (can-query (self, "read-only")
      694        and
      695        self :read-only = false
      696        )
      697     then do:
      698       if self :handle <> focus :handle
      699       then do:
      700         apply "entry":u to self .
      701       end.
      702       run gbl/getcurdt.p
      703         (output v-curr-sv-date
      704         ) .
      705       assign
      706         self :screen-value = string(v-curr-sv-date) .
      707       .
      708     end.
      709     return no-apply.
      710   end.
      711   on ctrl-b of v-doc-date in frame Dialog-Frame
      712   do:
      713     if (can-query (self, "sensitive")
      714        and
      715        self :sensitive = true
      716        )
      717     or (can-query (self, "read-only")
      718        and
      719        self :read-only = false
      720        )
      721     then do:
      722       if self :handle <> focus :handle
      723       then do:
      724         apply "entry":u to self .
      725       end.
      726       define variable v-curr-sv-date as date no-undo .
      727       define variable v-new-sv-date  as date no-undo .
      728       assign
      729         v-curr-sv-date = date(self :screen-value) no-error
      730       .
      731       if v-curr-sv-date = ?
      732       then do:
      733         run gbl/getcurdt.p
      734           (output v-curr-sv-date
      735           ) .
      736       end.
      737       if v-curr-sv-date <> ?
      738       then do:
      739         assign
      740           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      741         .
      742         assign
      743           self :screen-value = string(v-new-sv-date) .
      744         .
      745       end.
      746     end.
      747     return no-apply .
      748   end.
      749   on ctrl-e of v-doc-date in frame Dialog-Frame
      750   do:
      751     if (can-query (self, "sensitive")
      752        and
      753        self :sensitive = true
      754        )
      755     or (can-query (self, "read-only")
      756        and
      757        self :read-only = false
      758        )
      759     then do:
      760       if self :handle <> focus :handle
      761       then do:
      762         apply "entry":u to self .
      763       end.
      764       define variable v-curr-sv-date as date no-undo .
      765       define variable v-new-sv-date  as date no-undo .
      766       assign
      767         v-curr-sv-date = date(self :screen-value) no-error
      768       .
      769       if v-curr-sv-date = ?
      770       then do:
      771         run gbl/getcurdt.p
      772           (output v-curr-sv-date
      773           ) .
      774       end.
      775       if v-curr-sv-date <> ?
      776       then do:
      777         run gbl/lastdate.p
      778           (input  v-curr-sv-date
      779           ,output v-new-sv-date
      780           ).
      781         assign
      782           self :screen-value = string(v-new-sv-date) .
      783         .
      784       end.
      785     end.
      786     return no-apply .
      787   end.
      788   on ctrl-f of v-doc-date in frame Dialog-Frame
      789   do:
      790     if (can-query (self, "sensitive")
      791        and
      792        self :sensitive = true
      793        )
      794     or (can-query (self, "read-only")
      795        and
      796        self :read-only = false
      797        )
      798     then do:
      799       if self :handle <> focus :handle
      800       then do:
      801         apply "entry":u to self .
      802       end.
      803       define variable v-ok            as logical   no-undo .
      804       define variable v-curr-sv-date  as date      no-undo .
      805       define variable v-description   as character no-undo .
      806       assign
      807         v-curr-sv-date = date(self :screen-value) no-error
      808       .
      809       if v-curr-sv-date = ?
      810       then do:
      811         run gbl/getcurdt.p
      812           (output v-curr-sv-date
      813           ) .
      814       end.
      815       if v-curr-sv-date <> ?
      816       then do:
      817         run gbl/d-inpday.w
      818           (input ?
      819           ,input "Выбор даты"
      820           ,input v-description
      821           ,input ""
      822           ,input-output v-curr-sv-date
      823           ,output v-ok
      824           ).
      825         if v-ok = true
      826         then do:
      827           assign
      828             self :screen-value = string(v-curr-sv-date) .
      829           .
      830         end.
      831       end.
      832     end.
      833     return no-apply .
      834   end.
      835     define MENU m-ed-date9
      836       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      837       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      838       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      839       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      840       .
      841     if v-doc-date :POPUP-MENU in frame Dialog-Frame = ?
      842     then do:
      843       ASSIGN
      844         v-doc-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
      845         v-doc-date :MENU-MOUSE in frame Dialog-Frame = 3
      846       .
      847     end.
      848     define variable v-label-handle9 as handle no-undo .
      849     assign
      850       v-label-handle9 = v-doc-date :side-label-handle in frame Dialog-Frame
      851     .
      852     if valid-handle (v-label-handle9)
      853     then do:
      854       if v-label-handle9 :tooltip = ""
      855       or v-label-handle9 :tooltip = ?
      856       then do:
      857         assign
      858           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      859         .
      860       end.
      861     end.
      862     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
      863       apply "ctrl-b":U to v-doc-date in frame Dialog-Frame .
      864     END.
      865     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
      866       apply "ctrl-d":U to v-doc-date in frame Dialog-Frame .
      867     END.
      868     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
      869       apply "ctrl-e":U to v-doc-date in frame Dialog-Frame .
      870     END.
      871     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
      872       apply "ctrl-f":U to v-doc-date in frame Dialog-Frame .
      873     END.
      874   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   do:
      876     br-line :SET-REPOSITIONED-ROW(12, "CONDITIONAL") .
      877   end.
      878   StatusOrder =  new ibs.th.str.order.sts.order().
      879   if par-mode = 'ПРОСМОТР':U then find first X_order no-lock where X_order.doc-code = p-doc-code no-error .
      880   else find first X_order exclusive-lock where X_order.doc-code = p-doc-code no-error .
      881   v-doc-date = X_order.doc-date .
      882   extent (bcol) = ?.
      883   hbrowse = browse br-line:handle.
      884   extent (bcol) = hbrowse:num-columns.
      885   bcol[1] = hbrowse:first-column.
      886   do ii = 1 to extent (bcol).
      887       bcol[ii] = hbrowse:get-browse-column (ii).
      888   end.
      889   if X_order.order-item <> "" then title0 = "Заказ № " + string(X_order.order-item).
      890   else title0 = "Заказ".
      891   run init_tt .
      892   RUN enable_UI .
      893   run enable_tt .
      894   frame Dialog-Frame:title = title0 .
      895      on F9 of frame Dialog-Frame anywhere
      896         do:
      897            if not available X_order-line then  return no-apply.
      898            find first goods no-lock where goods.gds-code = X_order-line.gds-code .
      899            gds-rec = recid(goods) .
      900            run ref/gds-form.w
      901               (input  parParentProc
      902               ,input  'ПРОСМОТР':U
      903               ,input  v-cntxt-obj-type
      904               ,input  v-cntxt-obj-code
      905               ,input ?
      906               ,input-output gds-rec
      907               ).
      908            apply "entry" to br-line in frame Dialog-Frame.
      909            return no-apply.
      910         end.
      911   WAIT-FOR GO OF FRAME Dialog-Frame .
      912   if vUndo then
      913     UNDO MAIN-BLOCK, LEAVE.
      914   END.
      915   RUN disable_UI.
      916   PROCEDURE disable_UI :
      917     HIDE FRAME Dialog-Frame.
      918   END PROCEDURE.
      919   PROCEDURE enable_tt :
      920       if par-mode = 'ПРОСМОТР':U or X_order.sts <> StatusOrder:NewStatus:KeyIntDB then
      921       do:
      922           disable
      923               b-add
      924               b-del
      925               b-date
      926               v-doc-date
      927               b-send
      928               X_order.order-date
      929               with frame Dialog-Frame .
      930               X_order-line.order-qnty:column-read-only in browse br-line = true .
      931       end.
      932       if X_order.sts = StatusOrder:NewStatus:KeyIntDB or X_order.sts = StatusOrder:Sended:KeyIntDB or X_order.sts = StatusOrder:Cancelled:KeyIntDB then
      933       X_order-line.fact-qnty:visible IN BROWSE br-line = false.
      934       else X_order-line.fact-qnty:visible IN BROWSE br-line = true.
      935   END PROCEDURE.
      936   PROCEDURE enable_UI :
      937       DISPLAY c-status user-name
      938           WITH FRAME Dialog-Frame.
      939       IF AVAILABLE X_order THEN
      940           DISPLAY X_order.doc-code v-doc-date X_order.cli-code
      941               X_order.cli-type X_order.cli-name X_order.order-date user-name contract-name
      942               v-doc-code X_order.info X_order.contract-code X_order.contract-prn-code
      943               WITH FRAME Dialog-Frame.
      944       ENABLE b-save b-send b-next b-excel X_order.order-date b-date
      945           b-mark b-add b-del br-line b-hist b-cancel
      946           WITH FRAME Dialog-Frame.
      947       hide b-prev b-next b-prev b-next b-ok b-notOk in frame Dialog-Frame .
      948       VIEW FRAME Dialog-Frame.
      949       OPEN QUERY br-line FOR EACH X_order-line no-lock where X_order-line.doc-code = p-doc-code INDEXED-REPOSITION.
      950   END PROCEDURE.
      951   PROCEDURE init_tt :
      952       v-doc-code = string(X_order.order-item) .
      953       find first ub.contract no-lock where ub.contract.contract-code = X_order.contract-code no-error .
      954       if available (ub.contract) then contract-name = ub.contract.contract-name .
      955       if X_order.user-id <> '' then
      956       do:
      957           find first ub.user-account no-lock where ub.user-account.user-id = X_order.user-id no-error .
      958           if available (ub.user-account) then
      959           do:
      960               user-name = ub.user-account.last-name + " " + ub.user-account.first-name + " " + ub.user-account.second-name .
      961           end.
      962       end.
      963       c-status = StatusOrder:GetLabel(X_order.sts) .
      964   END PROCEDURE.
      965   FUNCTION gds-name RETURNS character
      966       (p-code as integer ):
      967       define variable v-gds-name as character no-undo.
      968       find first ub.goods no-lock where ub.goods.gds-code = p-code no-error .
      969       if available (ub.goods) then
      970       do:
      971           v-gds-name = ub.goods.gds-name .
      972       end.
      973       return v-gds-name.
      974   end function.
      975   FUNCTION stock RETURNS character
      976       (p-code as integer ):
      977       define variable stock-code as character no-undo.
      978       if p-code = -1 then stock-code = "-" .
      979       else stock-code = string (p-code) .
      980       return stock-code.
      981   end function.
