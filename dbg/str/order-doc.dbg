       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Карточка заказа".
       12   define new global shared variable g#language as character no-undo .
       13   if g#language <> '' and g#language <> 'rus':U then do:
       14     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       15   end.
       16   define new global shared variable g#library  as handle no-undo .
       17   define new global shared variable g#library2 as handle no-undo .
       18   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19   FUNCTION mark-string RETURNS CHARACTER
       20     ( input p-recid as recid, input mark-list as character  ) :
       21     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
       22   END FUNCTION.
       23   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       24   procedure sel-date :
       25     define input  parameter p-date-handle as handle    no-undo .
       26     define input  parameter p-description as character no-undo .
       27     do
       28     on error undo, return error return-value
       29     :
       30       if (can-query (p-date-handle, "sensitive")
       31         and
       32         p-date-handle :sensitive = true
       33         )
       34       or (can-query (p-date-handle, "read-only")
       35         and
       36         p-date-handle :read-only = false
       37         )
       38       then do:
       39         if p-date-handle :handle <> focus :handle
       40         then do:
       41           apply "entry":u to p-date-handle .
       42         end.
       43         define variable v-ok            as logical no-undo .
       44         define variable v-curr-sv-date as date no-undo .
       45         assign
       46           v-curr-sv-date = date(p-date-handle :screen-value) no-error
       47         .
       48         if v-curr-sv-date = ?
       49         then do:
       50           run gbl/getcurdt.p
       51             (output v-curr-sv-date
       52             ) .
       53         end.
       54         if v-curr-sv-date <> ?
       55         then do:
       56           run gbl/d-inpday.w
       57             (input ?
       58             ,input "Выбор даты"
       59             ,input p-description
       60             ,input ""
       61             ,input-output v-curr-sv-date
       62             ,output v-ok
       63             ).
       64           if v-ok = true
       65           then do:
       66             assign
       67               p-date-handle :screen-value = string(v-curr-sv-date) .
       68             .
       69           end.
       70         end.
       71       end.
       72     end.
       73   end procedure.
       74   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
