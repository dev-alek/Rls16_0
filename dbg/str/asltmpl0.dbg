      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   procedure cur-time :
      122      define output parameter p-today as date      no-undo .
      123      define output parameter p-time  as integer   no-undo .
      124     do
      125     on error undo, return error
      126     :
      127       define variable v-date1 as date      no-undo .
      128       define variable v-date2 as date      no-undo .
      129       define variable v-time  as integer   no-undo .
      130       assign
      131         v-date1 = today
      132         v-time  = time
      133         v-date2 = today
      134       .
      135       if v-date1 <> v-date2
      136       then do:
      137         assign
      138           v-date1 = today
      139           v-time  = v-time
      140         .
      141       end.
      142       assign
      143         p-today = v-date1
      144         p-time  = v-time
      145       .
      146     end.
      147   end.
      148   function cur-time-date returns character
      149   :
      150     return string(today, '99/99/9999':U) .
      151   end.
      152   function cur-time-mjd returns decimal
      153   :
      154     define variable v-date as date      no-undo .
      155     define variable v-time as integer   no-undo .
      156     run cur-time in this-procedure
      157       (output v-date
      158       ,output v-time
      159       ) .
      160     return integer(v-date) - 2400002 + (v-time / 86400) .
      161   end.
      162   function cur-time-get-ending-index returns integer
      163   (input p-number as integer
      164   )
      165   :
      166     if p-number < 0
      167     or p-number = ?
      168     then do:
      169       return 1 .
      170     end.
      171     define variable v-rest as integer   no-undo .
      172     assign
      173       p-number = p-number modulo 100
      174     .
      175     if p-number < 20
      176     then do:
      177       assign
      178         v-rest = p-number
      179       .
      180     end.
      181     else do:
      182       assign
      183         v-rest = p-number modulo 10
      184       .
      185     end.
      186     case v-rest :
      187       when 1
      188       then do:
      189         return 2 .
      190       end.
      191       when 2 or
      192       when 3 or
      193       when 4
      194       then do:
      195         return 3 .
      196       end.
      197       otherwise do:
      198         return 1 .
      199       end.
      200     end case .
      201   end.
      202   procedure cur-time-mjd-to-date :
      203      define input  parameter i-mjd-diff as decimal no-undo.
      204      define output parameter o-Date     as date    no-undo.
      205      define output parameter o-Time     as integer no-undo.
      206      define variable v-day-number as integer   no-undo .
      207      if    i-mjd-diff < 0
      208         or i-mjd-diff = ?
      209      then do:
      210         return "?" .
      211      end.
      212      assign
      213         v-day-number = truncate(i-mjd-diff,0).
      214         o-Date = date(v-day-number + 2400002).
      215         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      216     .
      217   end.
      218   function cur-time-mjd-to-string returns character
      219   (input p-mjd-diff as decimal
      220   )
      221   :
      222     define variable v-day-number as integer   no-undo .
      223     define variable v-seconds    as integer   no-undo .
      224     define variable v-hour       as integer   no-undo .
      225     define variable v-min        as integer   no-undo .
      226     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      227     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      228     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      229     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      230     if p-mjd-diff < 0
      231     or p-mjd-diff = ?
      232     then do:
      233       return "?" .
      234     end.
      235     assign
      236       v-day-number = integer(truncate(p-mjd-diff,0))
      237       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      238     .
      239     if v-seconds > 86400
      240     then do:
      241       assign
      242         v-seconds = 86400 - 1
      243       .
      244     end.
      245     if v-seconds < 0
      246     then do:
      247       assign
      248         v-seconds = 0
      249       .
      250     end.
      251     assign
      252       v-hour = truncate(v-seconds / 3600, 0)
      253     .
      254     assign
      255       v-seconds = v-seconds modulo 3600
      256     .
      257     assign
      258       v-min = truncate(v-seconds / 60, 0)
      259     .
      260     assign
      261       v-seconds = v-seconds modulo 60
      262     .
      263     return
      264         (if v-day-number <> 0
      265           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      266           else ""
      267         )
      268       + (if v-day-number <> 0 or v-hour <> 0
      269           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      273           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      274           else ""
      275         )
      276       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      277       .
      278   end.
      279   function cur-time-string returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-string-sec returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      298   end.
      299   function cur-time-custom  returns character
      300   (input p-prefix as character
      301   ,input p-date-format as character
      302   ,input p-delimiter as character
      303   ,input p-time-format as character
      304   ,input p-suffix as character
      305   )
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return
      314       p-prefix
      315       + string(v-date, p-date-format)
      316       + p-delimiter
      317       + string(v-time, p-time-format)
      318       + p-suffix
      319       .
      320   end.
      321   function cur-time-print  returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      330   end.
      331   function cur-time-datetime returns datetime
      332   :
      333     define variable v-char as character no-undo .
      334     define variable v-datetime as datetime no-undo .
      335     v-char = cur-time-string().
      336     v-datetime = datetime(v-char).
      337     return  v-datetime.
      338   end.
      339   function cur-time-string-msec returns character
      340   :
      341     define variable v-date as datetime  no-undo .
      342     v-date = now.
      343     return string(v-date) .
      344   end.
      345   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   function octal-to-char return character
      347   ( p-string as character ) :
      348     def var v-asc     as integer no-undo .
      349     def var v-new-asc as integer no-undo .
      350     def var ind       as integer no-undo .
      351     if length(p-string) <> 3 then do:
      352       return ? .
      353     end.
      354     assign
      355       v-asc = 0
      356     .
      357     do ind = 1 to length(p-string)
      358     :
      359       assign
      360         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      361       .
      362       if v-new-asc < 0 or v-new-asc >= 8 then do:
      363         return ? .
      364       end.
      365       assign
      366         v-asc = v-asc * 8 + v-new-asc
      367       .
      368     end.
      369     return chr(v-asc) .
      370   end function .
      371   function char-to-octal return character
      372   ( p-chr as character ) :
      373     def var v-asc    as integer   no-undo .
      374     def var ind      as integer   no-undo .
      375     def var v-string as character no-undo .
      376     if length(p-chr) <> 1 then do:
      377       return ? .
      378     end.
      379     assign
      380       v-asc    = asc(p-chr)
      381       v-string = ""
      382     .
      383     do ind = 1 to 3
      384     :
      385       assign
      386         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      387       .
      388       assign
      389         v-asc = truncate(v-asc / 8, 0)
      390       .
      391     end.
      392     return v-string .
      393   end.
      394   function str-encode return character
      395   (   p-init-string       as character
      396     , p-encode-char       as character
      397     , p-special-char-list as character
      398   ) :
      399     def var p-encode-string as character no-undo .
      400     def var ind                as integer no-undo .
      401     def var v-num-special-char as integer no-undo .
      402     def var v-special-char     as character no-undo .
      403     if p-encode-char = ?
      404     or p-encode-char = "" then do:
      405       assign
      406         p-encode-char = "~~"
      407       .
      408     end.
      409     if p-init-string = ? then do:
      410       return "?" .
      411     end.
      412     if p-init-string = "?" then do:
      413       return p-encode-char + char-to-octal("?") .
      414     end.
      415     assign
      416       v-num-special-char = length(p-special-char-list)
      417       p-encode-string    = replace(p-init-string
      418                                   ,p-encode-char
      419                                   ,p-encode-char + char-to-octal(p-encode-char)
      420                                   )
      421     .
      422     do ind = 1 to v-num-special-char
      423     :
      424       assign
      425         v-special-char = substring(p-special-char-list, ind, 1)
      426       .
      427       if v-special-char <> p-encode-char then do:
      428         assign
      429           p-encode-string = replace (p-encode-string
      430                                     ,v-special-char
      431                                     ,p-encode-char + char-to-octal(v-special-char)
      432                                     )
      433         .
      434       end.
      435     end.
      436     return p-encode-string .
      437   end.
      438   function str-decode returns character
      439     (p-init-string   as character
      440     ,p-encode-char   as character
      441     ) :
      442     def var p-decode-string as character no-undo .
      443     def var ind                       as integer no-undo .
      444     def var v-num-entries-init-string as integer no-undo .
      445     def var v-sub-phrase              as character no-undo .
      446     def var v-special-char            as character no-undo .
      447     if p-encode-char = ?
      448     or p-encode-char = "" then do:
      449       assign
      450         p-encode-char = "~~"
      451       .
      452     end.
      453     if p-init-string = "?" then do:
      454       return ? .
      455     end.
      456     assign
      457       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      458     .
      459     if v-num-entries-init-string > 1 then do:
      460       assign
      461         p-decode-string = entry(1, p-init-string, p-encode-char)
      462       .
      463       do ind = 2 to v-num-entries-init-string
      464       :
      465         assign
      466           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      467         .
      468         assign
      469           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      470         .
      471         if v-special-char <> ? then do:
      472           assign
      473             p-decode-string = p-decode-string
      474                             + v-special-char
      475                             + substring(v-sub-phrase, 4)
      476           .
      477         end.
      478         else do:
      479           assign
      480             p-decode-string = p-decode-string
      481                             + p-encode-char
      482                             + v-sub-phrase
      483           .
      484         end.
      485       end.
      486     end.
      487     else do:
      488       assign
      489         p-decode-string = p-init-string
      490       .
      491     end.
      492     return p-decode-string .
      493   end.
      494   DEFINE BUTTON b-exit AUTO-GO DEFAULT
      495        LABEL "&Ввод":L
      496        SIZE 10 BY 1
      497        BGCOLOR 8 .
      498   DEFINE BUTTON b-Help DEFAULT
      499        LABEL "Помо&щь":L
      500        SIZE 3 BY 1
      501        BGCOLOR 8 .
      502   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      503        LABEL "&Отмена":L
      504        SIZE 10 BY 1
      505        BGCOLOR 8 .
      506   DEFINE VARIABLE F-name AS CHARACTER FORMAT "X(256)":U
      507        LABEL "Название шаблона"
      508        VIEW-AS FILL-IN
      509        SIZE 50 BY 1 NO-UNDO.
      510   DEFINE VARIABLE shift-date AS DATE FORMAT "99/99/9999":U
      511        LABEL "Дата смены(учета)"
      512        VIEW-AS FILL-IN
      513        SIZE 11 BY 1 NO-UNDO.
      514   DEFINE VARIABLE shift-name AS CHARACTER FORMAT "X(2)":U
      515        LABEL "№ смены"
      516        VIEW-AS FILL-IN
      517        SIZE 4 BY 1 NO-UNDO.
      518   DEFINE VARIABLE shift-num AS INTEGER FORMAT ">9":U INITIAL 0
      519        LABEL "Пор.  смены"
      520        VIEW-AS FILL-IN
      521        SIZE 3.5 BY 1 NO-UNDO.
      522   DEFINE VARIABLE toggle-date AS LOGICAL INITIAL no
      523        LABEL "СЕГОДНЯ +/- ДНЕЙ"
      524        VIEW-AS TOGGLE-BOX
      525        SIZE 21 BY .83 NO-UNDO.
      526   DEFINE FRAME DIALOG-1
      527        b-exit AT ROW 1 COL 1
      528        b-quit AT ROW 1 COL 11
      529        b-Help AT ROW 1 COL 65
      530        F-name AT ROW 3 COL 18 COLON-ALIGNED
      531        shift-date AT ROW 4.77 COL 1
      532        toggle-date AT ROW 4.77 COL 36
      533        shift-name AT ROW 6 COL 18 COLON-ALIGNED
      534        shift-num AT ROW 7.5 COL 7
      535        "(Для несменных объектов игнорируется)" VIEW-AS TEXT
      536             SIZE 49 BY 1 AT ROW 6 COL 24.5
      537             FGCOLOR 4
      538        "(Для несменных объектов игнорируется)" VIEW-AS TEXT
      539             SIZE 49 BY 1 AT ROW 7.5 COL 24.5
      540             FGCOLOR 4
      541        SPACE(0.37) SKIP(0.16)
      542       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      543            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      544            TITLE "":L
      545            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      546   ASSIGN
      547          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      548   ON CHOOSE OF b-exit IN FRAME DIALOG-1
      549   DO:
      550   DEFINE VARIABLE v-dopi AS INTEGER NO-UNDO.
      551     ASSIGN
      552     f-name.
      553     IF f-name = "":U THEN DO:
      554         MESSAGE
      555         "Название шаблона не может быть пустым"
      556         VIEW-AS ALERT-BOX.
      557         RETURN NO-APPLY.
      558     END.
      559     ASSIGN
      560     v-dopi = INTEGER(INPUT FRAME DIALOG-1 shift-name)
      561     NO-ERROR.
      562     IF ERROR-STATUS:ERROR
      563     OR v-dopi < 0 THEN DO:
      564         MESSAGE
      565         "Неверный № смены"
      566         VIEW-AS ALERT-BOX.
      567         RETURN NO-APPLY.
      568     END.
      569   END.
      570   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   on F1 of frame DIALOG-1 anywhere do:
      572     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame DIALOG-1. END.
      573     return no-apply.
      574   end.
      575   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      576   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      577   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      578   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   on help of frame DIALOG-1
      580   do:
      581     run gbl/app_help.p
      582       (input this-procedure :file-name
      583       ,input ''
      584       ,input ?
      585       ) no-error.
      586     if error-status :error then do:
      587       message
      588         "Ошибка при вызове помощи"
      589         error-status :get-message(1)
      590         view-as alert-box .
      591     end.
      592   end.
      593   run minbtn-set in this-procedure .
      594   on choose of b-help in frame DIALOG-1
      595   do:
      596     apply "help":u to frame DIALOG-1 .
      597   end.
      598   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   procedure minbtn-set :
      600       do
      601           on error undo, return error return-value
      602           :
      603           define variable ii              as integer       no-undo .
      604           define variable fh              as widget-handle no-undo .
      605           define variable hh              as widget-handle no-undo .
      606           define variable v-h             as handle        extent 4 no-undo .
      607           define variable v-name-button   as character     no-undo .
      608           define variable v-help-old-x    as decimal       no-undo .
      609           define variable v-help-old-y    as decimal       no-undo .
      610           define variable v-help-old-size as decimal       no-undo .
      611           define variable v-frame-width   as decimal       no-undo .
      612           define variable jj              as integer       no-undo .
      613           do
      614               on error undo, return error
      615               :
      616               assign
      617                   v-frame-width = frame DIALOG-1:width - 0.3
      618                   fh            = frame DIALOG-1:first-child
      619                   hh            = fh:first-child
      620                   ii            = 1
      621                   .
      622               do while valid-handle(hh):
      623                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      624                   do:
      625                       case lc(hh:name) :
      626                           when "b-help" then
      627                               do:
      628                                   hh:load-image-up("cmp/b-help.bmp":u) .
      629                                   hh:load-image-down("cmp/b-help.bmp":u) .
      630                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      631                                   hh:TOOLTIP = "Помощь" .
      632                                   v-help-old-x = hh:column .
      633                                   v-help-old-y = hh:row    .
      634                                   v-help-old-size = hh:width .
      635                                   hh:width-chars = 2.5 .
      636                               end.
      637                           when "b-print" then
      638                               do:
      639                                   hh:load-image("cmp/b-print.bmp":u) .
      640                                   hh:TOOLTIP = "Печать" .
      641                                   v-h[ii] = hh:handle .
      642                                   ii = ii + 1 .
      643                                   hh:width-chars = 3 .
      644                               end.
      645                           when "b-history" or
      646                           when "b-hist" then
      647                               do:
      648                                   hh:load-image("cmp/b-hist.bmp":u) .
      649                                   hh:TOOLTIP = "История" .
      650                                   v-h[ii] = hh:handle .
      651                                   ii = ii + 1 .
      652                                   hh:width-chars = 3 .
      653                               end.
      654                           when "b-sch" then
      655                               do:
      656                                   hh:load-image("cmp/b-sch.bmp":u) .
      657                                   hh:TOOLTIP = "Установка Фильтра" .
      658                                   v-h[ii] = hh:handle .
      659                                   ii = ii + 1 .
      660                                   hh:width-chars = 3 .
      661                               end.
      662                           when "b-hist-user" then
      663                               do:
      664                                   hh:load-image("cmp/b-hist.bmp":u) .
      665                                   hh:TOOLTIP = "История пользователя" .
      666                                   ii = ii + 1 .
      667                               end.
      668                       end case.
      669                   end.
      670                   hh = hh:next-sibling.
      671               end.
      672               b-help:column = v-frame-width - b-help:width-chars.
      673               jj = 0.
      674               repeat ii = 4 to 1 by -1 :
      675                   if valid-handle (v-h[ii] ) then
      676                   do:
      677                       jj  = jj + 1 .
      678                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      679                       v-h[ii]:row    = v-help-old-y .
      680                   end.
      681               end.
      682           end.
      683       end.
      684   end procedure.
      685   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   on ' ' of shift-date in frame DIALOG-1
      687   do:
      688     if (can-query (self, "sensitive")
      689        and
      690        self :sensitive = true
      691        )
      692     or (can-query (self, "read-only")
      693        and
      694        self :read-only = false
      695        )
      696     then do:
      697       assign
      698         self :screen-value = ?
      699       .
      700     end.
      701     return no-apply.
      702   end.
      703   on delete-character of shift-date in frame DIALOG-1
      704   do:
      705     if (can-query (self, "sensitive")
      706        and
      707        self :sensitive = true
      708        )
      709     or (can-query (self, "read-only")
      710        and
      711        self :read-only = false
      712        )
      713     then do:
      714       assign
      715         self :screen-value = ?
      716       .
      717     end.
      718     return no-apply.
      719   end.
      720   on ctrl-d of shift-date in frame DIALOG-1
      721   do:
      722     define variable v-curr-sv-date as date no-undo .
      723     if (can-query (self, "sensitive")
      724        and
      725        self :sensitive = true
      726        )
      727     or (can-query (self, "read-only")
      728        and
      729        self :read-only = false
      730        )
      731     then do:
      732       if self :handle <> focus :handle
      733       then do:
      734         apply "entry":u to self .
      735       end.
      736       run gbl/getcurdt.p
      737         (output v-curr-sv-date
      738         ) .
      739       assign
      740         self :screen-value = string(v-curr-sv-date) .
      741       .
      742     end.
      743     return no-apply.
      744   end.
      745   on ctrl-b of shift-date in frame DIALOG-1
      746   do:
      747     if (can-query (self, "sensitive")
      748        and
      749        self :sensitive = true
      750        )
      751     or (can-query (self, "read-only")
      752        and
      753        self :read-only = false
      754        )
      755     then do:
      756       if self :handle <> focus :handle
      757       then do:
      758         apply "entry":u to self .
      759       end.
      760       define variable v-curr-sv-date as date no-undo .
      761       define variable v-new-sv-date  as date no-undo .
      762       assign
      763         v-curr-sv-date = date(self :screen-value) no-error
      764       .
      765       if v-curr-sv-date = ?
      766       then do:
      767         run gbl/getcurdt.p
      768           (output v-curr-sv-date
      769           ) .
      770       end.
      771       if v-curr-sv-date <> ?
      772       then do:
      773         assign
      774           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      775         .
      776         assign
      777           self :screen-value = string(v-new-sv-date) .
      778         .
      779       end.
      780     end.
      781     return no-apply .
      782   end.
      783   on ctrl-e of shift-date in frame DIALOG-1
      784   do:
      785     if (can-query (self, "sensitive")
      786        and
      787        self :sensitive = true
      788        )
      789     or (can-query (self, "read-only")
      790        and
      791        self :read-only = false
      792        )
      793     then do:
      794       if self :handle <> focus :handle
      795       then do:
      796         apply "entry":u to self .
      797       end.
      798       define variable v-curr-sv-date as date no-undo .
      799       define variable v-new-sv-date  as date no-undo .
      800       assign
      801         v-curr-sv-date = date(self :screen-value) no-error
      802       .
      803       if v-curr-sv-date = ?
      804       then do:
      805         run gbl/getcurdt.p
      806           (output v-curr-sv-date
      807           ) .
      808       end.
      809       if v-curr-sv-date <> ?
      810       then do:
      811         run gbl/lastdate.p
      812           (input  v-curr-sv-date
      813           ,output v-new-sv-date
      814           ).
      815         assign
      816           self :screen-value = string(v-new-sv-date) .
      817         .
      818       end.
      819     end.
      820     return no-apply .
      821   end.
      822   on ctrl-f of shift-date in frame DIALOG-1
      823   do:
      824     if (can-query (self, "sensitive")
      825        and
      826        self :sensitive = true
      827        )
      828     or (can-query (self, "read-only")
      829        and
      830        self :read-only = false
      831        )
      832     then do:
      833       if self :handle <> focus :handle
      834       then do:
      835         apply "entry":u to self .
      836       end.
      837       define variable v-ok            as logical   no-undo .
      838       define variable v-curr-sv-date  as date      no-undo .
      839       define variable v-description   as character no-undo .
      840       assign
      841         v-curr-sv-date = date(self :screen-value) no-error
      842       .
      843       if v-curr-sv-date = ?
      844       then do:
      845         run gbl/getcurdt.p
      846           (output v-curr-sv-date
      847           ) .
      848       end.
      849       if v-curr-sv-date <> ?
      850       then do:
      851         run gbl/d-inpday.w
      852           (input ?
      853           ,input "Выбор даты"
      854           ,input v-description
      855           ,input ""
      856           ,input-output v-curr-sv-date
      857           ,output v-ok
      858           ).
      859         if v-ok = true
      860         then do:
      861           assign
      862             self :screen-value = string(v-curr-sv-date) .
      863           .
      864         end.
      865       end.
      866     end.
      867     return no-apply .
      868   end.
      869     define MENU m-ed-date6
      870       MENU-ITEM m-ed-date6-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      871       MENU-ITEM m-ed-date6-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      872       MENU-ITEM m-ed-date6-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      873       MENU-ITEM m-ed-date6-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      874       .
      875     if shift-date :POPUP-MENU in frame DIALOG-1 = ?
      876     then do:
      877       ASSIGN
      878         shift-date :POPUP-MENU in frame DIALOG-1 = MENU m-ed-date6 :HANDLE
      879         shift-date :MENU-MOUSE in frame DIALOG-1 = 3
      880       .
      881     end.
      882     define variable v-label-handle6 as handle no-undo .
      883     assign
      884       v-label-handle6 = shift-date :side-label-handle in frame DIALOG-1
      885     .
      886     if valid-handle (v-label-handle6)
      887     then do:
      888       if v-label-handle6 :tooltip = ""
      889       or v-label-handle6 :tooltip = ?
      890       then do:
      891         assign
      892           v-label-handle6 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      893         .
      894       end.
      895     end.
      896     ON CHOOSE OF MENU-ITEM m-ed-date6-1 in menu m-ed-date6 DO:
      897       apply "ctrl-b":U to shift-date in frame DIALOG-1 .
      898     END.
      899     ON CHOOSE OF MENU-ITEM m-ed-date6-2 in menu m-ed-date6 DO:
      900       apply "ctrl-d":U to shift-date in frame DIALOG-1 .
      901     END.
      902     ON CHOOSE OF MENU-ITEM m-ed-date6-3 in menu m-ed-date6 DO:
      903       apply "ctrl-e":U to shift-date in frame DIALOG-1 .
      904     END.
      905     ON CHOOSE OF MENU-ITEM m-ed-date6-4 in menu m-ed-date6 DO:
      906       apply "ctrl-f":U to shift-date in frame DIALOG-1 .
      907     END.
      908   MAIN-BLOCK:
      909   DO ON ERROR    UNDO MAIN-BLOCK, return error
      910         ON STOP       UNDO MAIN-BLOCK, return error
      911         ON END-KEY UNDO MAIN-BLOCK, return error :
      912     RUN UI_on.
      913     WAIT-FOR GO OF FRAME DIALOG-1.
      914     ASSIGN
      915     f-name.
      916     if input frame DIALOG-1 shift-date = "":U
      917     or input frame DIALOG-1 shift-date = ?
      918     or input frame DIALOG-1 shift-date = "?"
      919     then do:
      920       assign
      921         str = chr(63)
      922         str_rus = chr(63)
      923       .
      924     end.
      925     else do:
      926       if toggle-date :checked = true then do:
      927         define variable v-diff-value as integer   no-undo .
      928         define variable v-diff-str   as character no-undo .
      929         define variable v-diff-day   as character no-undo .
      930         assign
      931         v-diff-value = input frame DIALOG-1 shift-date - today
      932         .
      933         if v-diff-value = 0 then do:
      934           assign
      935             v-diff-str = ""
      936             v-diff-day = ""
      937           .
      938         end.
      939         if v-diff-value > 0  then do:
      940           assign
      941             v-diff-str = '+ ':u + string(v-diff-value)
      942             v-diff-day = v-diff-str + " ДНЕЙ"
      943           .
      944         end.
      945         if v-diff-value < 0 then do:
      946           assign
      947             v-diff-str = '- ':u + string(abs(v-diff-value))
      948             v-diff-day = v-diff-str + " ДНЕЙ"
      949           .
      950         end.
      951         assign
      952         str = '(TODAY ':u + v-diff-str + ')':u
      953         str_rus = "СЕГОДНЯ " + v-diff-day
      954         .
      955       end.
      956       else do:
      957         define variable v-date as date      no-undo .
      958         assign
      959           v-date = input frame DIALOG-1 shift-date
      960         .
      961         if v-date = ? then do:
      962           assign
      963             str = chr(63)
      964             str_rus = "НЕ_ЗАДАНА"
      965           .
      966         end.
      967         else do:
      968           assign
      969             str = 'date(':u + string(month(v-date))
      970                 + '~~054':u + string(day(v-date))
      971                 + '~~054':u + string(year(v-date))
      972                 + ')':u
      973             str_rus = string(v-date, "99/99/9999")
      974           .
      975         end.
      976       end.
      977     end.
      978   assign
      979     str-int = string(input frame DIALOG-1 shift-num)
      980     str_rus-int = string(input shift-num)
      981     str-int-shift-name = input frame DIALOG-1 shift-name
      982     str_rus-int-shift-name = input shift-name
      983     p-name = f-name
      984   .
      985   END.
      986   RUN disable_UI.
      987   PROCEDURE disable_UI :
      988     HIDE FRAME DIALOG-1.
      989   END PROCEDURE.
      990   PROCEDURE enable_UI :
      991     DISPLAY F-name shift-date toggle-date shift-name shift-num
      992         WITH FRAME DIALOG-1.
      993     ENABLE b-exit b-quit b-Help F-name shift-date toggle-date shift-name
      994            shift-num
      995         WITH FRAME DIALOG-1.
      996   END PROCEDURE.
      997   PROCEDURE UI_on :
      998   DEFINE VARIABLE v-time as integer no-undo .
      999   DEFINE VARIABLE v-dop AS CHARACTER NO-UNDO.
     1000   DEFINE VARIABLE v-dop1 AS CHARACTER NO-UNDO.
     1001   DEFINE VARIABLE v-dop2 AS CHARACTER NO-UNDO.
     1002   DEFINE VARIABLE v-dop3 AS CHARACTER NO-UNDO.
     1003   define variable v-dop-int as integer no-undo .
     1004   run cur-time in this-procedure (output shift-date, output v-time).
     1005   ASSIGN
     1006   f-name = p-name
     1007   v-dop = str
     1008   .
     1009   IF INDEX (str, "today") = 0  THEN DO:
     1010      v-dop = str-decode(str, "":U).
     1011      ASSIGN
     1012      v-dop = substring(v-dop, 6)
     1013      v-dop = TRIM(v-dop, ")")
     1014      v-dop1 = ENTRY(1, v-dop, chr(44))
     1015      v-dop2 = ENTRY(2, v-dop, chr(44))
     1016      v-dop3 = ENTRY(3, v-dop, chr(44)).
     1017   END.
     1018   else do:
     1019     assign
     1020     v-dop = trim(str, "(")
     1021     v-dop = trim(v-dop, ")")
     1022     v-dop = replace(v-dop, "TODAY", "":U)
     1023     v-dop = trim(v-dop)
     1024     v-dop-int = integer(v-dop)
     1025     .
     1026     shift-date = shift-date  + v-dop-int.
     1027   end.
     1028   ASSIGN
     1029   shift-date = IF INDEX (str, "today") > 0
     1030                THEN shift-date
     1031                ELSE DATE( INTEGER(v-dop1),
     1032                           INTEGER(v-dop2),
     1033                           INTEGER(v-dop3)
     1034                         )
     1035   toggle-date  = INDEX (str, "today") > 0
     1036   shift-num = integer(str-int)
     1037   shift-name = str-int-shift-name
     1038   .
     1039   display
     1040   f-name
     1041   shift-date
     1042   toggle-date
     1043   shift-num
     1044   shift-name with frame DIALOG-1.
     1045   enable
     1046   f-name
     1047   shift-date
     1048   toggle-date
     1049   shift-num
     1050   shift-name
     1051   b-exit
     1052   b-quit
     1053   b-help with frame DIALOG-1.
     1054   END PROCEDURE.
