     3457         return no-apply.
     3458   end.
     3459   if p-man = "agnt" and p-action = "button" then do:
     3460     define variable v-ref-rec20   as recid no-undo .
     3461     find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.agnt
     3462                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3463     assign v-ref-rec20 = ( if available cli-buf then recid( cli-buf ) else ? ).
     3464     v-ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     3465     release cli-buf.
     3466     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3467       run ref/cli-all.w (  input parparentproc
