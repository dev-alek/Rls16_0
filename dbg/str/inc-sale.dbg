      823             SIZE 14.9 BY 1
      824             BGCOLOR 8 FGCOLOR 4
      825        tt-trn-doc.wrkr AT ROW 18.13 COL 71.5 COLON-ALIGNED WIDGET-ID 18
      826             LABEL "К&л-к"
      827             VIEW-AS FILL-IN
      828             SIZE 9.8 BY 1
      829        r-wrkr AT ROW 18.27 COL 96.1 WIDGET-ID 14
      830        ub.chk-doc.tot-doc AT ROW 18.77 COL 15.8 COLON-ALIGNED
