     3530          v-ref-rec
     3531          no-lock no-error.
     3532       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3533         find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.boss
