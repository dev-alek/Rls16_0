     2422     end.
     2423     empty temp-table thbjattr_thbj-attr.
     2424     if rdtaxcd > 0 then do:
     2425         FIND FIRST ub.tax No-LOCK WHERE ub.tax.tax-code = rdtaxcd No-ERROR.
     2426         if not avail ub.tax then do:
     2427             message "Не найден дорожный налог!" view-as alert-box ERROR.
     2428             return error.
     2429         end.
     2430     end.
     2431     if exctaxcd > 0 then do:
