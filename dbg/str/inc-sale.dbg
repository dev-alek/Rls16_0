      849            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE .
      850   DEFINE FRAME d-chk
      851        r-boss AT ROW 20.27 COL 96 WIDGET-ID 12
      852        wrkr-name AT ROW 18.13 COL 82 COLON-ALIGNED NO-LABEL WIDGET-ID 20
      853        agnt-name AT ROW 19.13 COL 82 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      854        curs-mes AT ROW 20 COL 2 COLON-ALIGNED NO-LABEL
      855        boss-name AT ROW 20.13 COL 82 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      856        "ВОЗВРАТ" VIEW-AS TEXT
      857             SIZE 8 BY 1 AT ROW 12.5 COL 56.5
      858             BGCOLOR 3 FGCOLOR 15
      859        "РАСХОД" VIEW-AS TEXT
      860             SIZE 8 BY 1 AT ROW 10.5 COL 56.5
      861             BGCOLOR 3 FGCOLOR 15
      862        "Проставлять в док-ты:" VIEW-AS TEXT
      863             SIZE 22 BY 1 AT ROW 17 COL 77 WIDGET-ID 16
      864             FGCOLOR 4
      865        RECT-1 AT ROW 10 COL 1.5
      866        SPACE(1.74) SKIP(7.47)
      867       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      868            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      869            TITLE "Формирование  ОТЧЕТА  О  ПРОДАЖЕ":L.
      870   ASSIGN
      871          FRAME d-chk:SCROLLABLE       = FALSE.
      872   ASSIGN
      873          f-shift-name:HIDDEN IN FRAME d-chk           = TRUE.
      874   ASSIGN
      875          f-shift-num:HIDDEN IN FRAME d-chk           = TRUE.
      876   ON END-ERROR OF FRAME d-chk
      877   DO:
      878       apply "choose" to b-quit .
      879   END.
      880   ON LEAVE OF tt-trn-doc.agnt IN FRAME d-chk
      881   DO:
      882     if input frame d-chk tt-trn-doc.agnt <> tt-trn-doc.agnt then do:
      883       run local-psn-chk in this-procedure ("agnt", "leave").
      884     end.
      885   END.
      886   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.agnt IN FRAME d-chk
      887   OR RETURN OF tt-trn-doc.agnt IN FRAME d-chk DO:
      888     run local-psn-chk in this-procedure ("agnt", "ret-mouse").
      889     apply "entry" to tt-trn-doc.boss in frame d-chk.
      890     return no-apply.
      891   END.
      892   ON CHOOSE OF b-doc IN FRAME d-chk
      893   DO:
      894   define variable v-doc-type as character no-undo .
      895   define variable v-doc-code as character no-undo .
      896   define variable glog as logical no-undo .
      897   define buffer buf_fbr-doc for ub.fbr-doc.
      898     assign
      899     v-doc-type = buf_sale-doc.doc-type
      900     v-doc-code = buf_sale-doc.doc-code
      901    .
      902     if v-doc-type = 'производство':U then do:
      903       find first buf_fbr-doc no-lock where
      904                 buf_fbr-doc.doc-code = v-doc-code  no-error .
      905       if not available buf_fbr-doc then do:
      906         message
      907         substitute("Не найден документ производства с № &1", v-doc-code)
      908         view-as alert-box error .
      909         return no-apply.
      910       end.
      911       run str/fbr-lkp.p (
      912                     input parparentproc
      913                   , input recid(buf_fbr-doc)).
      914     end.
      915     else do:
      916       run str/showdoc.p
      917               (input parparentproc
      918               ,input v-doc-code
      919               ,input ""
      920               ,input ""
      921               ,input 0
      922               ,input ?
      923               ).
      924    end.
      925     APPLY "ENTRY" TO  br-saledoc.
      926   end.
      927   ON CHOOSE OF b-exit IN FRAME d-chk
      928   DO:
      929       DO  on ERROR undo, return no-apply
      930                                     on STOP undo, return no-apply  :
      931           RUN IncProcStart in this-procedure ( input yes) .
      932       END.
      933   END.
      934   ON CHOOSE OF b-quit IN FRAME d-chk
      935   DO:
      936     if p-mode = 'ИЗМЕНЕНИЕ':U then return "cancell":U .
      937     else return '':U.
      938   END.
      939   ON CHOOSE OF B-sch IN FRAME d-chk
      940   DO:
      941     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      942     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      943   END.
      944   ON LEAVE OF tt-trn-doc.boss IN FRAME d-chk
      945   DO:
      946     if input frame d-chk tt-trn-doc.boss <> tt-trn-doc.boss then do:
      947       run local-psn-chk in this-procedure ("boss", "leave").
      948     end.
      949   END.
      950   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.boss IN FRAME d-chk
      951   OR RETURN OF tt-trn-doc.boss IN FRAME d-chk DO:
      952     run local-psn-chk in this-procedure ("boss", "ret-mouse").
      953     apply "entry" to tt-trn-doc.boss in frame d-chk.
      954     return no-apply.
      955   END.
      956   ON LEAVE OF f-shift-name IN FRAME d-chk
      957   DO:
      958     run proc-shift-name in this-procedure no-error .
      959     if error-status:error then do:
      960       return no-apply.
      961     end.
      962     display
      963     integer(f-shift-name) @ f-shift-num
      964     with frame d-chk .
      965   END.
      966   ON VALUE-CHANGED OF f-shift-name IN FRAME d-chk
      967   DO:
      968   define buffer buf_sale-doc for ub.sale-doc.
      969   define buffer buf_trn-doc for ub.trn-doc.
      970     assign f-shift-name .
      971     assign
      972     v-shift-name  = f-shift-name
      973     f-shift-num  = integer(f-shift-name)
      974     ink-doc.shift-num = f-shift-num
      975     ink-doc.shift-date = ink-doc.doc-date
      976     ink-doc.shift-name = f-shift-name
      977     .
      978     for each buf_sale-doc where
      979             buf_sale-doc.inkas-code = ink-doc.inkas-code
      980        and  buf_sale-doc.order > 0,
      981             first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = buf_sale-doc.doc-code:
      982       assign
      983       buf_trn-doc.shift-num = f-shift-num
      984       buf_trn-doc.shift-date = ink-doc.doc-date
      985       buf_trn-doc.shift-name = f-shift-name
      986       .
      987     end.
      988   END.
      989   ON CHOOSE OF r-agnt IN FRAME d-chk
      990   DO:
      991     RUN local-psn-chk in this-procedure ("agnt", "button").
      992     apply "entry" to tt-trn-doc.agnt in FRAME d-chk.
      993     return no-apply.
      994   END.
      995   ON CHOOSE OF r-boss IN FRAME d-chk
      996   DO:
      997       RUN local-psn-chk in this-procedure ("boss", "button").
      998     apply "entry" to tt-trn-doc.boss in FRAME d-chk.
      999     return no-apply.
     1000   END.
     1001   ON CHOOSE OF r-wrkr IN FRAME d-chk
     1002   DO:
     1003     RUN local-psn-chk in this-procedure ("wrkr", "button").
     1004     apply "entry" to tt-trn-doc.wrkr in FRAME d-chk.
     1005     return no-apply.
     1006   END.
     1007   ON VALUE-CHANGED OF RS-get-method IN FRAME d-chk
     1008   DO:
     1009      RUN IncProcStart in this-procedure ( input no).
     1010      ASSIGN
     1011      rs-get-method.
     1012      CASE rs-get-method:
     1013        WHEN "chk-docs" THEN DO:
     1014           if not ink-doc.is-mand-sale-filter then
     1015           DISABLE
     1016           b-sch
     1017           with FRAME d-chk.
     1018           ASSIGN
     1019           v-rid-list = "":U.
     1020           run str/chk-docs.w (
     1021                            input parparentproc
     1022                           ,input ('b-sel,b-mark':U )
     1023                           ,input "to-sale"
     1024                           ,input ?
     1025                           ,input ink-doc.obj-type
     1026                           ,input ink-doc.obj-code
     1027                           ,input ink-doc.inkas-code
     1028                           ,input '':U
     1029                           ,input 0
     1030                           ,input  ?
     1031                           ,input  ?
     1032                           ,input 0
     1033                           ,output v-rid-list) no-error.
     1034            IF v-rid-list = "":U  THEN DO:
     1035                ASSIGN
     1036                rs-get-method = "inc-salr".
     1037                ENABLE
     1038                b-sch when (not ink-doc.is-mand-sale-filter or NOT can-find( FIRST ub.chk-doc WHERE ub.chk-doc.out-code = ink-doc.inkas-code ))
     1039                with frame d-chk .
     1040                DISPLAY rs-get-method
     1041                with frame d-chk
     1042                .
     1043                RETURN NO-APPLY.
     1044            END.
     1045          END.
     1046          WHEN "inc-salr":U THEN DO:
     1047              v-rid-list = "":U.
     1048              ENABLE
     1049              b-sch when (NOT ink-doc.is-mand-sale-filter or can-find( FIRST ub.chk-doc WHERE ub.chk-doc.out-code = ink-doc.inkas-code ))
     1050              with FRAME d-chk.
     1051         END.
     1052      END CASE.
     1053   END.
     1054   ON RETURN OF ub.chk-doc.shift-date IN FRAME d-chk
     1055   DO:
     1056       apply "choose" to b-exit in frame d-chk .
     1057   END.
     1058   ON LEAVE OF tt-trn-doc.wrkr IN FRAME d-chk
     1059   DO:
     1060     if input frame d-chk tt-trn-doc.wrkr <> tt-trn-doc.wrkr then do:
     1061       run local-psn-chk in this-procedure ("wrkr", "leave").
     1062     end.
     1063   END.
     1064   ON MOUSE-SELECT-DBLCLICK OF tt-trn-doc.wrkr IN FRAME d-chk
     1065   OR RETURN OF tt-trn-doc.wrkr IN FRAME d-chk DO:
     1066     run local-psn-chk in this-procedure ("wrkr", "ret-mouse").
     1067     apply "entry" to tt-trn-doc.agnt in frame d-chk.
     1068     return no-apply.
     1069   END.
     1070   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-chk:PARENT eq ?
     1071   THEN FRAME d-chk:PARENT = ACTIVE-WINDOW.
     1072   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1073   on help of frame d-chk
     1074   do:
     1075     run gbl/app_help.p
     1076       (input this-procedure :file-name
     1077       ,input ''
     1078       ,input ?
     1079       ) no-error.
     1080     if error-status :error then do:
     1081       message
     1082         "Ошибка при вызове помощи"
     1083         error-status :get-message(1)
     1084         view-as alert-box .
     1085     end.
     1086   end.
     1087   run minbtn-set in this-procedure .
     1088   on choose of b-help in frame d-chk
     1089   do:
     1090     apply "help":u to frame d-chk .
     1091   end.
     1092   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   procedure minbtn-set :
     1094       do
     1095           on error undo, return error return-value
     1096           :
     1097           define variable ii              as integer       no-undo .
     1098           define variable fh              as widget-handle no-undo .
     1099           define variable hh              as widget-handle no-undo .
     1100           define variable v-h             as handle        extent 4 no-undo .
     1101           define variable v-name-button   as character     no-undo .
     1102           define variable v-help-old-x    as decimal       no-undo .
     1103           define variable v-help-old-y    as decimal       no-undo .
     1104           define variable v-help-old-size as decimal       no-undo .
     1105           define variable v-frame-width   as decimal       no-undo .
     1106           define variable jj              as integer       no-undo .
     1107           do
     1108               on error undo, return error
     1109               :
     1110               assign
     1111                   v-frame-width = frame d-chk:width - 0.3
     1112                   fh            = frame d-chk:first-child
     1113                   hh            = fh:first-child
     1114                   ii            = 1
     1115                   .
     1116               do while valid-handle(hh):
     1117                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1118                   do:
     1119                       case lc(hh:name) :
     1120                           when "b-help" then
     1121                               do:
     1122                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1123                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1124                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1125                                   hh:TOOLTIP = "Помощь" .
     1126                                   v-help-old-x = hh:column .
     1127                                   v-help-old-y = hh:row    .
     1128                                   v-help-old-size = hh:width .
     1129                                   hh:width-chars = 2.5 .
     1130                               end.
     1131                           when "b-print" then
     1132                               do:
     1133                                   hh:load-image("cmp/b-print.bmp":u) .
     1134                                   hh:TOOLTIP = "Печать" .
     1135                                   v-h[ii] = hh:handle .
     1136                                   ii = ii + 1 .
     1137                                   hh:width-chars = 3 .
     1138                               end.
     1139                           when "b-history" or
     1140                           when "b-hist" then
     1141                               do:
     1142                                   hh:load-image("cmp/b-hist.bmp":u) .
     1143                                   hh:TOOLTIP = "История" .
     1144                                   v-h[ii] = hh:handle .
     1145                                   ii = ii + 1 .
     1146                                   hh:width-chars = 3 .
     1147                               end.
     1148                           when "b-sch" then
     1149                               do:
     1150                                   hh:load-image("cmp/b-sch.bmp":u) .
     1151                                   hh:TOOLTIP = "Установка Фильтра" .
     1152                                   v-h[ii] = hh:handle .
     1153                                   ii = ii + 1 .
     1154                                   hh:width-chars = 3 .
     1155                               end.
     1156                           when "b-hist-user" then
     1157                               do:
     1158                                   hh:load-image("cmp/b-hist.bmp":u) .
     1159                                   hh:TOOLTIP = "История пользователя" .
     1160                                   ii = ii + 1 .
     1161                               end.
     1162                       end case.
     1163                   end.
     1164                   hh = hh:next-sibling.
     1165               end.
     1166               b-help:column = v-frame-width - b-help:width-chars.
     1167               jj = 0.
     1168               repeat ii = 4 to 1 by -1 :
     1169                   if valid-handle (v-h[ii] ) then
     1170                   do:
     1171                       jj  = jj + 1 .
     1172                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1173                       v-h[ii]:row    = v-help-old-y .
     1174                   end.
     1175               end.
     1176           end.
     1177       end.
     1178   end procedure.
     1179   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1180   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1181   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1182   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1183   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1184   define variable v-diasize-current-frame-height as decimal   no-undo .
     1185   define variable v-diasize-change-size          as logical   no-undo .
     1186   define variable v-diasize-resize-button        as handle    no-undo .
     1187   define variable v-diasize-wndmax               as logical   no-undo .
     1188   define variable v-diasize-wndstore             as logical   no-undo .
     1189   define variable v-diasize-proc-name            as character no-undo .
     1190   define variable v-diasize-browse-handle        as handle    no-undo .
     1191   define variable v-diasize-browse-number        as integer   no-undo .
     1192   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1193   define temp-table temp-diasize-handle no-undo
     1194     field handle-value  as handle
     1195     field save-position as decimal
     1196     index xpk is primary unique handle-value
     1197     .
     1198   define temp-table temp-browse-handle no-undo
     1199     field browse-type   as character
     1200     field browse-number as integer
     1201     field browse-handle as handle
     1202     field original-size as decimal
     1203     index xpk is primary unique browse-type browse-number
     1204     index xie browse-type browse-handle
     1205   .
     1206   procedure diasize_change-height :
     1207     define input  parameter p-change-value  as decimal   no-undo .
     1208     define input  parameter p-move-resize   as logical   no-undo .
     1209     define variable v-field-group-handle    as handle    no-undo .
     1210     define variable v-object-handle         as handle    no-undo .
     1211     define variable v-frame-height          as decimal   no-undo .
     1212     define variable v-frame-virtual-height  as decimal   no-undo .
     1213     define variable v-browse-height         as decimal   no-undo .
     1214     define variable v-window-height         as decimal   no-undo .
     1215     define variable v-window-virtual-height as decimal   no-undo .
     1216     define variable v-change-sign           as integer   no-undo .
     1217     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1218     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1219     if p-change-value > 0
     1220     then do:
     1221       if frame d-chk :height + p-change-value
     1222           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1223       then do:
     1224         assign
     1225           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1226                           - (frame d-chk :height-chars)
     1227         .
     1228         if p-change-value <= 0
     1229         then do:
     1230           run diasize_position-resize-button in this-procedure .
     1231           return .
     1232         end.
     1233       end.
     1234     end.
     1235     if p-change-value < 0
     1236     then do:
     1237       if frame d-chk :height + p-change-value < v-diasize-orig-frame-height
     1238       then do:
     1239         assign
     1240           p-change-value = v-diasize-orig-frame-height
     1241                          - (frame d-chk :height-chars)
     1242         .
     1243         if p-change-value >= 0
     1244         then do:
     1245           run diasize_position-resize-button in this-procedure .
     1246           return .
     1247         end.
     1248       end.
     1249     end.
     1250     if p-change-value >= 0
     1251     then do:
     1252       assign
     1253         v-change-sign = 1
     1254       .
     1255     end.
     1256     else do:
     1257       assign
     1258         v-change-sign = -1
     1259       .
     1260     end.
     1261     assign
     1262       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1263     .
     1264     if p-change-value = 0
     1265     then do:
     1266       run diasize_position-resize-button in this-procedure .
     1267       return .
     1268     end.
     1269     move_block:
     1270     do
     1271     on error undo move_block, retry move_block
     1272     :
     1273       if retry
     1274       then do:
     1275         do
     1276         on error undo move_block, leave move_block
     1277         :
     1278           if p-change-value > 0
     1279           then do:
     1280             for each buf_temp-diasize-handle
     1281             on error undo, next
     1282             :
     1283               assign
     1284                 v-object-handle = buf_temp-diasize-handle.handle-value
     1285               .
     1286               if v-object-handle <> v-diasize-resize-button
     1287               then do:
     1288                 assign
     1289                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1290                 .
     1291               end.
     1292             end.
     1293             assign
     1294               v-diasize-browse-handle :height = v-browse-height
     1295             .
     1296             for each buf_temp-browse-handle
     1297               where buf_temp-browse-handle.browse-type = 'height':u
     1298             on error undo, next
     1299             :
     1300               assign
     1301                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1302               .
     1303             end.
     1304             assign
     1305               frame d-chk :height = v-frame-height
     1306             .
     1307             if frame d-chk :scrollable = true
     1308             then do:
     1309               assign
     1310                 frame d-chk :virtual-height = v-frame-virtual-height
     1311               .
     1312             end.
     1313             run diasize_position-resize-button in this-procedure .
     1314           end.
     1315           else do:
     1316             if frame d-chk :scrollable = true
     1317             then do:
     1318               assign
     1319                 frame d-chk :virtual-height = v-frame-virtual-height
     1320               .
     1321             end.
     1322             assign
     1323               frame d-chk :height = v-frame-height
     1324             .
     1325             assign
     1326               v-diasize-browse-handle :height = v-browse-height
     1327             .
     1328             for each buf_temp-browse-handle
     1329               where buf_temp-browse-handle.browse-type = 'height':u
     1330             on error undo, next
     1331             :
     1332               assign
     1333                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1334               .
     1335             end.
     1336             for each buf_temp-diasize-handle
     1337             on error undo, next
     1338             :
     1339               assign
     1340                 v-object-handle = buf_temp-diasize-handle.handle-value
     1341               .
     1342               if v-object-handle <> v-diasize-resize-button
     1343               then do:
     1344                 assign
     1345                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1346                 .
     1347               end.
     1348             end.
     1349             run diasize_position-resize-button in this-procedure .
     1350           end.
     1351           assign
     1352             v-diasize-change-size = false
     1353           .
     1354           leave move_block .
     1355         end.
     1356       end.
     1357       assign
     1358         v-diasize-need-full-display = true
     1359       .
     1360       if v-diasize-change-size = false
     1361       then do:
     1362         assign
     1363           v-diasize-change-size = true
     1364         .
     1365       end.
     1366       else do:
     1367         return .
     1368       end.
     1369       assign
     1370         v-frame-height = frame d-chk :height
     1371         v-frame-virtual-height = frame d-chk :virtual-height
     1372         v-browse-height = v-diasize-browse-handle :height
     1373       .
     1374       for each buf_temp-browse-handle
     1375         where buf_temp-browse-handle.browse-type = 'height':u
     1376       :
     1377         assign
     1378           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1379         .
     1380       end.
     1381       for each buf_temp-diasize-handle
     1382       :
     1383         delete buf_temp-diasize-handle .
     1384       end.
     1385       assign
     1386         v-field-group-handle = frame d-chk :first-child
     1387       .
     1388       do while valid-handle(v-field-group-handle)
     1389       :
     1390         assign
     1391           v-object-handle = v-field-group-handle :first-child
     1392         .
     1393         do while valid-handle(v-object-handle)
     1394         :
     1395           if  v-object-handle <> v-diasize-browse-handle :handle
     1396           and can-query(v-object-handle, "row")
     1397           and can-query(v-object-handle, "height")
     1398           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1399           then do:
     1400             find first buf_temp-browse-handle
     1401               where buf_temp-browse-handle.browse-type   = 'height':u
     1402                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1403               no-error .
     1404             if available buf_temp-browse-handle
     1405             then do:
     1406             end.
     1407             else do:
     1408               create buf_temp-diasize-handle .
     1409               assign
     1410                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1411                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1412               .
     1413             end.
     1414           end.
     1415           assign
     1416             v-object-handle = v-object-handle :next-sibling
     1417           .
     1418         end.
     1419         assign
     1420           v-field-group-handle = v-field-group-handle :next-sibling
     1421         .
     1422       end.
     1423       do with frame d-chk
     1424       :
     1425         hide v-diasize-resize-button .
     1426         assign
     1427           v-diasize-resize-button :row    = 1
     1428           v-diasize-resize-button :column = 1
     1429         .
     1430       end.
     1431       if p-change-value > 0
     1432       then do:
     1433         if frame d-chk :scrollable = true
     1434         then do:
     1435           assign
     1436             frame d-chk :virtual-height = frame d-chk :virtual-height + p-change-value
     1437             no-error .
     1438           if error-status :error
     1439           or error-status :get-message(1) <> ""
     1440           then do:
     1441             undo move_block, retry move_block .
     1442           end.
     1443         end.
     1444         assign
     1445           frame d-chk :height = frame d-chk :height + p-change-value
     1446           no-error .
     1447         if error-status :error
     1448         or error-status :get-message(1) <> ""
     1449         then do:
     1450           undo move_block, retry move_block .
     1451         end.
     1452         assign
     1453           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1454           no-error .
     1455         if error-status :error
     1456         or error-status :get-message(1) <> ""
     1457         then do:
     1458           undo move_block, retry move_block .
     1459         end.
     1460         for each buf_temp-browse-handle
     1461           where buf_temp-browse-handle.browse-type = 'height':u
     1462         on error undo move_block, retry move_block
     1463         :
     1464           assign
     1465             buf_temp-browse-handle.browse-handle :height
     1466               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1467             no-error .
     1468           if error-status :error
     1469           or error-status :get-message(1) <> ""
     1470           then do:
     1471             undo move_block, retry move_block .
     1472           end.
     1473         end.
     1474         for each buf_temp-diasize-handle
     1475         on error undo move_block, retry move_block
     1476         :
     1477           assign
     1478             v-object-handle = buf_temp-diasize-handle.handle-value
     1479           .
     1480           if v-object-handle <> v-diasize-resize-button
     1481           then do:
     1482             assign
     1483               v-object-handle :row = v-object-handle :row + p-change-value
     1484               no-error .
     1485             if error-status :error
     1486             or error-status :get-message(1) <> ""
     1487             then do:
     1488               undo move_block, retry move_block .
     1489             end.
     1490           end.
     1491         end.
     1492       end.
     1493       else do:
     1494         for each buf_temp-diasize-handle
     1495         on error undo move_block, retry move_block
     1496         :
     1497           assign
     1498             v-object-handle = buf_temp-diasize-handle.handle-value
     1499           .
     1500           if v-object-handle <> v-diasize-resize-button
     1501           then do:
     1502             assign
     1503               v-object-handle :row = v-object-handle :row + p-change-value
     1504               no-error .
     1505             if error-status :error
     1506             or error-status :get-message(1) <> ""
     1507             then do:
     1508               undo move_block, retry move_block .
     1509             end.
     1510           end.
     1511         end.
     1512         assign
     1513           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1514           no-error .
     1515         if error-status :error
     1516         or error-status :get-message(1) <> ""
     1517         then do:
     1518           undo move_block, retry move_block .
     1519         end.
     1520         for each buf_temp-browse-handle
     1521           where buf_temp-browse-handle.browse-type = 'height':u
     1522         on error undo move_block, retry move_block
     1523         :
     1524           assign
     1525             buf_temp-browse-handle.browse-handle :height
     1526               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1527             no-error .
     1528           if error-status :error
     1529           or error-status :get-message(1) <> ""
     1530           then do:
     1531             undo move_block, retry move_block .
     1532           end.
     1533         end.
     1534         assign
     1535           frame d-chk :height = frame d-chk :height + p-change-value
     1536           no-error .
     1537         if error-status :error
     1538         or error-status :get-message(1) <> ""
     1539         then do:
     1540           undo move_block, retry move_block .
     1541         end.
     1542         if frame d-chk :scrollable = true
     1543         then do:
     1544           assign
     1545             frame d-chk :virtual-height = frame d-chk :virtual-height + p-change-value
     1546             no-error .
     1547           if error-status :error
     1548           or error-status :get-message(1) <> ""
     1549           then do:
     1550             undo move_block, retry move_block .
     1551           end.
     1552         end.
     1553       end.
     1554       if p-move-resize = true
     1555       then do:
     1556         run diasize_position-resize-button in this-procedure .
     1557       end.
     1558       if v-diasize-wndstore = true
     1559       then do:
     1560         if connected("ub") = true
     1561         then do:
     1562           define variable v-cntxt-db-num        as integer   no-undo .
     1563           define variable v-cntxt-userid        as character no-undo .
     1564           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1565                                             , OUTPUT v-cntxt-userid
     1566                                             ) .
     1567           run gbl/wndsizew.p
     1568             (input  v-cntxt-db-num
     1569             ,input  v-cntxt-userid
     1570             ,input  v-diasize-proc-name
     1571             ,input  'height':u
     1572             ,input  string(frame d-chk :height - v-diasize-orig-frame-height)
     1573             ) .
     1574         end.
     1575       end.
     1576     end.
     1577     assign
     1578       v-diasize-change-size = false
     1579     .
     1580   end procedure.
     1581   procedure diasize_set-height :
     1582     define input  parameter p-new-height  as decimal   no-undo .
     1583     define input  parameter p-move-resize as logical   no-undo .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       run diasize_change-height in this-procedure
     1588         (input  (p-new-height - frame d-chk :height)
     1589         ,input  p-move-resize
     1590         ) .
     1591     end.
     1592   end procedure.
     1593   procedure diasize_change-width :
     1594     define input  parameter p-change-value as decimal   no-undo .
     1595     define input  parameter p-move-resize  as logical   no-undo .
     1596     define variable v-field-group-handle   as handle    no-undo .
     1597     define variable v-object-handle        as handle    no-undo .
     1598     define variable v-frame-width          as decimal   no-undo .
     1599     define variable v-frame-virtual-width  as decimal   no-undo .
     1600     define variable v-browse-width         as decimal   no-undo .
     1601     define variable v-window-width         as decimal   no-undo .
     1602     define variable v-window-virtual-width as decimal   no-undo .
     1603     define variable v-change-sign          as integer   no-undo .
     1604     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1605     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1606     if p-change-value > 0
     1607     then do:
     1608       if frame d-chk :width + p-change-value >
     1609           session :width-chars
     1610       then do:
     1611         assign
     1612           p-change-value = session :width-chars - frame d-chk :width
     1613         .
     1614         if p-change-value <= 0
     1615         then do:
     1616           run diasize_position-resize-button in this-procedure .
     1617           return .
     1618         end.
     1619       end.
     1620     end.
     1621     if p-change-value < 0
     1622     then do:
     1623       if frame d-chk :width + p-change-value < v-diasize-orig-frame-width
     1624       then do:
     1625         assign
     1626           p-change-value = v-diasize-orig-frame-width
     1627                          - frame d-chk :width
     1628         .
     1629         if p-change-value >= 0
     1630         then do:
     1631           run diasize_position-resize-button in this-procedure .
     1632           return .
     1633         end.
     1634       end.
     1635     end.
     1636     if p-change-value >= 0
     1637     then do:
     1638       assign
     1639         v-change-sign = 1
     1640       .
     1641     end.
     1642     else do:
     1643       assign
     1644         v-change-sign = -1
     1645       .
     1646     end.
     1647     assign
     1648       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1649     .
     1650     if p-change-value = 0
     1651     then do:
     1652       run diasize_position-resize-button in this-procedure .
     1653       return .
     1654     end.
     1655     move_block:
     1656     do
     1657     on error undo move_block, leave move_block
     1658     :
     1659       if retry
     1660       then do:
     1661         do
     1662         on error undo move_block, leave move_block
     1663         :
     1664           if p-change-value > 0
     1665           then do:
     1666             for each buf_temp-diasize-handle
     1667             on error undo, next
     1668             :
     1669               assign
     1670                 v-object-handle = buf_temp-diasize-handle.handle-value
     1671               .
     1672               if v-object-handle <> v-diasize-resize-button
     1673               then do:
     1674                 assign
     1675                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1676                 .
     1677               end.
     1678             end.
     1679             assign
     1680               v-diasize-browse-handle :width = v-browse-width
     1681             .
     1682             for each buf_temp-browse-handle
     1683               where buf_temp-browse-handle.browse-type = 'width':u
     1684             on error undo, next
     1685             :
     1686               assign
     1687                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1688               .
     1689             end.
     1690             assign
     1691               frame d-chk :width = v-frame-width
     1692             .
     1693             if frame d-chk :scrollable = true
     1694             then do:
     1695               assign
     1696                 frame d-chk :virtual-width = v-frame-virtual-width
     1697               .
     1698             end.
     1699             run diasize_position-resize-button in this-procedure .
     1700           end.
     1701           else do:
     1702             if frame d-chk :scrollable = true
     1703             then do:
     1704               assign
     1705                 frame d-chk :virtual-width = v-frame-virtual-width
     1706               .
     1707             end.
     1708             assign
     1709               frame d-chk :width = v-frame-width
     1710             .
     1711             for each buf_temp-browse-handle
     1712               where buf_temp-browse-handle.browse-type = 'width':u
     1713             on error undo, next
     1714             :
     1715               assign
     1716                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1717               .
     1718             end.
     1719             assign
     1720               v-diasize-browse-handle :width = v-browse-width
     1721             .
     1722             for each buf_temp-diasize-handle
     1723             on error undo, next
     1724             :
     1725               assign
     1726                 v-object-handle = buf_temp-diasize-handle.handle-value
     1727               .
     1728               if v-object-handle <> v-diasize-resize-button
     1729               then do:
     1730                 assign
     1731                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1732                 .
     1733               end.
     1734             end.
     1735             run diasize_position-resize-button in this-procedure .
     1736           end.
     1737           assign
     1738             v-diasize-change-size = false
     1739           .
     1740           leave move_block .
     1741         end.
     1742       end.
     1743       assign
     1744         v-diasize-need-full-display = true
     1745       .
     1746       if v-diasize-change-size = false
     1747       then do:
     1748         assign
     1749           v-diasize-change-size = true
     1750         .
     1751       end.
     1752       else do:
     1753         return .
     1754       end.
     1755       assign
     1756         v-frame-width = frame d-chk :width
     1757         v-frame-virtual-width = frame d-chk :virtual-width
     1758         v-browse-width = v-diasize-browse-handle :width
     1759       .
     1760       for each buf_temp-browse-handle
     1761         where buf_temp-browse-handle.browse-type = 'width':u
     1762       :
     1763         assign
     1764           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1765         .
     1766       end.
     1767       for each buf_temp-diasize-handle
     1768       :
     1769         delete buf_temp-diasize-handle .
     1770       end.
     1771       assign
     1772         v-field-group-handle = frame d-chk :first-child
     1773       .
     1774       do while valid-handle(v-field-group-handle)
     1775       :
     1776         assign
     1777           v-object-handle = v-field-group-handle :first-child
     1778         .
     1779         do while valid-handle(v-object-handle)
     1780         :
     1781           if  v-object-handle <> v-diasize-browse-handle :handle
     1782           and v-object-handle <> v-diasize-resize-button
     1783           and can-query(v-object-handle, "row")
     1784           and can-query(v-object-handle, "height")
     1785           and ( v-object-handle :col + v-object-handle :width
     1786                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1787               )
     1788           then do:
     1789             find first buf_temp-browse-handle
     1790               where buf_temp-browse-handle.browse-type   = 'width':u
     1791                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1792               no-error .
     1793             if available buf_temp-browse-handle
     1794             then do:
     1795             end.
     1796             else do:
     1797               create buf_temp-diasize-handle .
     1798               assign
     1799                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1800                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1801               .
     1802             end.
     1803           end.
     1804           assign
     1805             v-object-handle = v-object-handle :next-sibling
     1806           .
     1807         end.
     1808         assign
     1809           v-field-group-handle = v-field-group-handle :next-sibling
     1810         .
     1811       end.
     1812       do with frame d-chk
     1813       :
     1814         hide v-diasize-resize-button .
     1815         v-diasize-resize-button :row = 1.
     1816         v-diasize-resize-button :column = 1.
     1817       end.
     1818       if p-change-value > 0
     1819       then do:
     1820         if frame d-chk :scrollable = true
     1821         then do:
     1822           assign
     1823             frame d-chk :virtual-width = frame d-chk :virtual-width + p-change-value
     1824             no-error .
     1825           if error-status :error
     1826           or error-status :get-message(1) <> ""
     1827           then do:
     1828             undo move_block, retry move_block.
     1829           end.
     1830         end.
     1831         assign
     1832           frame d-chk :width = v-frame-width + p-change-value
     1833           no-error .
     1834         if error-status :error
     1835         or error-status :get-message(1) <> ""
     1836         then do:
     1837           undo move_block, retry move_block.
     1838         end.
     1839         assign
     1840           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1841         no-error .
     1842         if error-status :error
     1843         or error-status :get-message(1) <> ""
     1844         then do:
     1845           undo move_block, retry move_block.
     1846         end.
     1847         for each buf_temp-browse-handle
     1848           where buf_temp-browse-handle.browse-type = 'width':u
     1849         on error undo move_block, retry move_block
     1850         :
     1851           assign
     1852             buf_temp-browse-handle.browse-handle :width
     1853               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1854             no-error .
     1855           if error-status :error
     1856           or error-status :get-message(1) <> ""
     1857           then do:
     1858             undo move_block, retry move_block .
     1859           end.
     1860         end.
     1861         for each buf_temp-diasize-handle
     1862         on error undo move_block, retry move_block
     1863         :
     1864           assign
     1865             v-object-handle = buf_temp-diasize-handle.handle-value
     1866           .
     1867           if v-object-handle <> v-diasize-resize-button
     1868           then do:
     1869             assign
     1870               v-object-handle :col = v-object-handle :col + p-change-value
     1871               no-error .
     1872             if error-status :error
     1873             or error-status :get-message(1) <> ""
     1874             then do:
     1875               undo move_block, retry move_block .
     1876             end.
     1877           end.
     1878         end.
     1879       end.
     1880       else do:
     1881         for each buf_temp-diasize-handle
     1882         on error undo move_block, retry move_block
     1883         :
     1884           assign
     1885             v-object-handle = buf_temp-diasize-handle.handle-value
     1886           .
     1887           if v-object-handle <> v-diasize-resize-button
     1888           then do:
     1889             assign
     1890               v-object-handle :col = v-object-handle :col + p-change-value
     1891               no-error .
     1892             if error-status :error
     1893             or error-status :get-message(1) <> ""
     1894             then do:
     1895               undo move_block, retry move_block .
     1896             end.
     1897           end.
     1898         end.
     1899         for each buf_temp-browse-handle
     1900           where buf_temp-browse-handle.browse-type = 'width':u
     1901         on error undo move_block, retry move_block
     1902         :
     1903           assign
     1904             buf_temp-browse-handle.browse-handle :width
     1905               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1906             no-error .
     1907           if error-status :error
     1908           or error-status :get-message(1) <> ""
     1909           then do:
     1910             undo move_block, retry move_block .
     1911           end.
     1912         end.
     1913         assign
     1914           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1915           no-error .
     1916         if error-status :error
     1917         or error-status :get-message(1) <> ""
     1918         then do:
     1919           undo move_block, retry move_block.
     1920         end.
     1921         assign
     1922           frame d-chk :width = frame d-chk :width + p-change-value
     1923         no-error .
     1924         if error-status :error
     1925         or error-status :get-message(1) <> ""
     1926         then do:
     1927           undo move_block, retry move_block.
     1928         end.
     1929         if frame d-chk :scrollable = true
     1930         then do:
     1931           assign
     1932             frame d-chk :virtual-width = frame d-chk :virtual-width + p-change-value
     1933           no-error .
     1934           if error-status :error
     1935           or error-status :get-message(1) <> ""
     1936           then do:
     1937             undo move_block, retry move_block.
     1938           end.
     1939         end.
     1940       end.
     1941       if p-move-resize
     1942       then do:
     1943         run diasize_position-resize-button in this-procedure .
     1944       end.
     1945       if v-diasize-wndstore = true
     1946       then do:
     1947         if connected("ub") = true
     1948         then do:
     1949           define variable v-cntxt-db-num        as integer   no-undo .
     1950           define variable v-cntxt-userid        as character no-undo .
     1951           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1952                                             , OUTPUT v-cntxt-userid
     1953                                             ) .
     1954           run gbl/wndsizew.p
     1955             (input  v-cntxt-db-num
     1956             ,input  v-cntxt-userid
     1957             ,input  v-diasize-proc-name
     1958             ,input  'width':u
     1959             ,input  string(frame d-chk :width - v-diasize-orig-frame-width)
     1960             ) .
     1961         end.
     1962       end.
     1963     end.
     1964     assign
     1965       v-diasize-change-size = false
     1966     .
     1967   end procedure.
     1968   procedure diasize_set-width :
     1969     define input  parameter p-new-width  as decimal   no-undo .
     1970     define input  parameter p-move-resize as logical   no-undo .
     1971     do
     1972     on error undo, return error return-value
     1973     :
     1974       run diasize_change-width in this-procedure
     1975         (input  (p-new-width - frame d-chk :width)
     1976         ,input  p-move-resize
     1977         ) .
     1978     end.
     1979   end procedure.
     1980   procedure diasize_position-resize-button :
     1981     do with frame d-chk
     1982     :
     1983       hide v-diasize-resize-button .
     1984       assign
     1985         v-diasize-resize-button :row = frame d-chk :height - v-diasize-resize-button :height
     1986                     - 1
     1987                     - (frame d-chk :border-bottom-pixels / session :pixels-per-row)
     1988         v-diasize-resize-button :col = frame d-chk :width - v-diasize-resize-button :width
     1989                     - 1
     1990                     - (frame d-chk :border-right-pixels / session :pixels-per-column)
     1991       .
     1992       view v-diasize-resize-button .
     1993     end.
     1994   end procedure.
     1995   on alt-right anywhere
     1996   do:
     1997     run diasize_change-width in this-procedure
     1998       (input 1
     1999       ,input true
     2000       ) .
     2001     return no-apply .
     2002   end.
     2003   on alt-left anywhere
     2004   do:
     2005     run diasize_change-width in this-procedure
     2006       (input -1
     2007       ,input true
     2008       ) .
     2009     return no-apply .
     2010   end.
     2011   on alt-down anywhere
     2012   do:
     2013     run diasize_change-height in this-procedure
     2014       (input 1
     2015       ,input true
     2016       ) .
     2017     return no-apply .
     2018   end.
     2019   on alt-up anywhere
     2020   do:
     2021     run diasize_change-height in this-procedure
     2022       (input -1
     2023       ,input true
     2024       ) .
     2025     return no-apply .
     2026   end.
     2027   on alt-enter of frame d-chk
     2028   do:
     2029     run diasize_maximize in this-procedure
     2030       (input  ?
     2031       ).
     2032     return no-apply .
     2033   end.
     2034   procedure diasize_end-move :
     2035     do
     2036     on error undo, return error return-value
     2037     :
     2038       define variable v-row-delta as decimal   no-undo .
     2039       define variable v-col-delta as decimal   no-undo .
     2040       define variable v-new-row as decimal   no-undo .
     2041       define variable v-new-col as decimal   no-undo .
     2042       assign
     2043         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2044         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2045       .
     2046       assign
     2047         v-row-delta = v-new-row - frame d-chk :height
     2048         v-col-delta = v-new-col - frame d-chk :width
     2049       .
     2050       run diasize_change-height in this-procedure
     2051         (input v-row-delta
     2052         ,input true
     2053         ) .
     2054       run diasize_change-width in this-procedure
     2055         (input v-col-delta
     2056         ,input true
     2057         ) .
     2058     end.
     2059   end procedure.
     2060   procedure diasize_maximize :
     2061     define input  parameter p-action as logical   no-undo .
     2062     do
     2063     on error undo, return error return-value
     2064     :
     2065       if p-action = ?
     2066       then do:
     2067         if v-diasize-need-maximize = true
     2068         then do:
     2069           assign
     2070             p-action = true
     2071           .
     2072         end.
     2073         else do:
     2074           assign
     2075             p-action = false
     2076           .
     2077         end.
     2078       end.
     2079       if p-action = true
     2080       then do:
     2081         run diasize_change-height in this-procedure
     2082           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2083               - frame d-chk :height-chars
     2084           ,input true
     2085           ) .
     2086         run diasize_change-width in this-procedure
     2087           (input session :width-chars
     2088               - frame d-chk :width-chars
     2089           ,input true
     2090           ) .
     2091         assign
     2092           v-diasize-need-maximize = false
     2093         .
     2094       end.
     2095       else do:
     2096         run diasize_change-width in this-procedure
     2097           (input v-diasize-orig-frame-width
     2098               - frame d-chk :width-chars
     2099           ,input true
     2100           ) .
     2101         run diasize_change-height in this-procedure
     2102           (input v-diasize-orig-frame-height
     2103               - frame d-chk :height-chars
     2104           ,input true
     2105           ) .
     2106         assign
     2107           v-diasize-need-maximize = true
     2108         .
     2109       end.
     2110     end.
     2111   end procedure.
     2112   procedure diasize_restore-orig-size :
     2113     do
     2114     on error undo, return error return-value
     2115     :
     2116       assign
     2117         v-diasize-current-frame-width  = frame d-chk :width
     2118         v-diasize-current-frame-height = frame d-chk :height
     2119       .
     2120       run diasize_set-height in this-procedure
     2121         (input  v-diasize-orig-frame-height
     2122         ,input  true
     2123         ) .
     2124       run diasize_set-width in this-procedure
     2125         (input  v-diasize-orig-frame-width
     2126         ,input  true
     2127         ) .
     2128     end.
     2129   end procedure.
     2130   procedure diasize_restore-current-size :
     2131     do
     2132     on error undo, return error return-value
     2133     :
     2134       run diasize_set-height in this-procedure
     2135         (input  v-diasize-current-frame-height
     2136         ,input  true
     2137         ) .
     2138       run diasize_set-width in this-procedure
     2139         (input  v-diasize-current-frame-width
     2140         ,input  true
     2141         ) .
     2142     end.
     2143   end procedure.
     2144   procedure diasize_set-browse-handle :
     2145     define input  parameter p-browse-handle as handle   no-undo .
     2146     define buffer buf_temp-browse-handle for temp-browse-handle .
     2147     do
     2148     on error undo, return error return-value
     2149     :
     2150       assign
     2151         v-diasize-browse-handle = p-browse-handle
     2152       .
     2153       for each buf_temp-browse-handle
     2154       on error undo, return error return-value
     2155       :
     2156         delete buf_temp-browse-handle .
