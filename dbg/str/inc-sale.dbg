     3445       display cli-buf.obj-code @ tt-trn-doc.agnt
     3446               cli-buf.obj-name @ agnt-name with frame d-chk.
     3447       assign frame d-chk tt-trn-doc.agnt.
     3448     end.
     3449     else display ? @ tt-trn-doc.agnt
     3450                  ? @ agnt-name with frame d-chk.
     3451     apply "entry" to tt-trn-doc.boss
     3452                               in frame d-chk.
     3453   if available cli-buf then do:
     3454         display cli-buf.obj-code @ tt-trn-doc.agnt cli-buf.obj-name @ agnt-name with frame d-chk.
     3455     end.
