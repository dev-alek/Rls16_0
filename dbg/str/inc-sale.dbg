      126   function diff-list returns character (
      127     input parfirst-list  as character,
      128     input parsecond-list as character,
      129     input pardelim       as character).
      130     if pardelim = ""
      131     or pardelim = ?
      132     then do:
      133       assign
      134         pardelim = ","
      135       .
      136     end.
      137     def var ind as integer no-undo .
      138     def var v-elem as character no-undo .
      139     def var v-result-list as character no-undo init "".
      140     def var v-num-parfirst-list as integer no-undo .
      141     assign
      142       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      143     .
      144     do ind = 1 to v-num-parfirst-list
      145     :
      146       assign
      147         v-elem = entry(ind, parfirst-list, pardelim)
      148       .
      149       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      150         assign
      151           v-result-list = v-result-list
      152                         + (if v-result-list > "" then pardelim else "")
      153                         + v-elem
      154         .
      155       end.
      156     end.
      157     return v-result-list .
      158   end function.
      159   function add-list returns character (
      160    input parfirst-list  as character,
      161    input parsecond-list as character,
      162    input pardelim       as character).
      163     if pardelim = ""
      164     or pardelim = ?
      165     then do:
      166       assign
      167         pardelim = ","
      168       .
      169     end.
      170     def var ind as integer no-undo .
      171     def var v-elem as character no-undo .
      172     def var v-result-list as character no-undo init "".
      173     def var v-num-parfirst-list as integer no-undo .
      174     assign
      175       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      176     .
      177     do ind = 1 to v-num-parfirst-list
      178     :
      179       assign
      180         v-elem = entry(ind, parfirst-list, pardelim)
      181       .
      182       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      183         assign
      184           v-result-list = v-result-list
      185                         + (if v-result-list > "" then pardelim else "")
      186                         + v-elem
      187         .
      188       end.
      189     end.
      190     def var v-num-parsecond-list as integer no-undo .
      191     assign
      192       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      193     .
      194     do ind = 1 to v-num-parsecond-list
      195     :
      196       assign
      197         v-elem = entry(ind, parsecond-list, pardelim)
      198       .
      199       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      200         assign
      201           v-result-list = v-result-list
      202                         + (if v-result-list > "" then pardelim else "")
      203                         + v-elem
      204         .
      205       end.
      206     end.
      207     return v-result-list .
      208   end function.
      209   function cross-list returns character (
      210    input parfirst-list  as character,
      211    input parsecond-list as character,
      212    input pardelim       as character).
      213     if pardelim = ""
      214     or pardelim = ?
      215     then do:
      216       assign
      217         pardelim = ","
      218       .
      219     end.
      220     def var ind as integer no-undo .
      221     def var v-elem as character no-undo .
      222     def var v-result-list as character no-undo init "".
      223     def var v-num-parfirst-list as integer no-undo .
      224     assign
      225       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      226     .
      227     do ind = 1 to v-num-parfirst-list
      228     :
      229       assign
      230         v-elem = entry(ind, parfirst-list, pardelim)
      231       .
      232       if lookup(v-elem, v-result-list, pardelim) = 0
      233       and lookup(v-elem, parsecond-list, pardelim) > 0
      234       then do:
      235         assign
      236           v-result-list = v-result-list
      237                         + (if v-result-list > "" then pardelim else "")
      238                         + v-elem
      239         .
      240       end.
      241     end.
      242     return v-result-list .
      243   end function.
      244   function radio-label returns character (
      245    input par-rs-value  as character,
      246    input par-rs-radio-buttons as character)
      247    .
      248    DEFINE variable v-result-label as character no-undo.
      249    assign
      250    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      251                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      252                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      253                             ), par-rs-radio-buttons
      254                           )
      255    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      256    .
      257   return v-result-label.
      258   end function.
      259   function m-radio-label returns character (
      260    input par-rs-value  as character,
      261    input par-rs-radio-buttons as character,
      262    input par-delim as character
      263    )
      264    .
      265    DEFINE variable v-result-label as character no-undo.
      266    assign
      267    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      268                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      269                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      270                             ), par-rs-radio-buttons, par-delim
      271                           )
      272    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      273    .
      274   return v-result-label.
      275   end function.
      276   FUNCTION mixlist returns character
      277   (
      278    input parfirst-list  as character
      279    ,input parsecond-list as character
      280    ,input pardelim       as character
      281    ,input pardelim-result as character ) :
      282     if pardelim = ""
      283     or pardelim = ?
      284     then do:
      285       assign
      286         pardelim = ","
      287       .
      288     end.
      289     def var ind as integer no-undo .
      290     def var v-elem1 as character no-undo .
      291     def var v-elem2 as character no-undo .
      292     def var v-result-list as character no-undo init "".
      293     do ind = 1 to num-entries(parfirst-list, pardelim)
      294     :
      295       assign
      296         v-elem1 = entry(ind, parfirst-list, pardelim)
      297         v-elem2 = entry(ind, parsecond-list, pardelim)
      298       .
      299         assign
      300           v-result-list = v-result-list
      301                         + (if v-result-list > "" then pardelim-result else "")
      302                         + v-elem1 + pardelim-result + v-elem2
      303         .
      304     end.
      305     return v-result-list .
      306   END FUNCTION.
      307   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define variable c-point  as character no-undo .
      309   define variable tbl      as character no-undo .
      310   define variable join-tbl as character no-undo .
      311   define variable fld      as character no-undo .
      312   define variable lab      as character no-undo .
      313   define variable spr      as character no-undo .
      314   define variable dim      as character no-undo .
      315   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   procedure fltfield-clear :
      317     define output parameter loc-fld as character no-undo.
      318     define output parameter loc-lab as character no-undo .
      319     define output parameter loc-spr as character no-undo .
      320     define output parameter loc-dim as character no-undo .
      321     assign
      322       loc-fld = ""
      323       loc-lab = ""
      324       loc-spr = ""
      325       loc-dim = "0"
      326     .
      327   end procedure .
      328   procedure fltfield-add :
      329     define input        parameter par-fld as character no-undo.
      330     define input        parameter par-lab as character no-undo .
      331     define input        parameter par-spr as character no-undo .
      332     define input-output parameter loc-fld as character no-undo.
      333     define input-output parameter loc-lab as character no-undo .
      334     define input-output parameter loc-spr as character no-undo .
      335     define input-output parameter loc-dim as character no-undo .
      336     do
      337     on error undo, return error
      338     :
      339       assign
      340       loc-fld = if loc-dim = '0'
      341                 then par-fld
      342                 else (loc-fld + chr(44) + par-fld)
      343       loc-lab = if loc-dim = '0'
      344                 then par-lab
      345                 else (loc-lab + chr(44) + par-lab)
      346       loc-spr = if loc-dim = '0'
      347                 then par-spr
      348                 else (loc-spr + chr(44) + par-spr)
      349       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      350                 string(integer(if num-entries(loc-dim) > 1
      351                               then entry(2, loc-dim)
      352                               else entry(1, loc-dim)
      353                               ) + 1)
      354       no-error
      355       .
      356     end.
      357   end procedure.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      360   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      361     field cst-code                like ub.trn-doc.cst-code
      362     field part-code               like ub.parts.part-code
      363     .
      364   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      365   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      366   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define new global shared variable g#trdcalib as handle no-undo.
      369   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   FUNCTION set-inkas-PS returns character(    input p-ps as character,
      371                                               input p-chk-amount as integer,
      372                                               input p-gds-amount as integer,
      373                                               input p-line-out as integer,
      374                                               input p-dtl-out as integer,
      375                                               input p-line-ret as integer,
      376                                               input p-dtl-ret as integer,
      377                                               input p-nf-chk-amount as integer,
      378                                               input p-nf-gds-amount as integer,
      379                                               input p-ps-where-rus as character
      380                                               ):
      381   define variable v-ps as character no-undo .
      382   define variable v-other as character no-undo .
      383   v-other = p-ps.
      384   entry(1, v-other, "@") = ''.
      385   v-other = trim(v-other, "@").
      386   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
      387                       , chr(4)
      388                       , p-chk-amount
      389                       , p-gds-amount
      390                       , p-line-out
      391                       , p-dtl-out
      392                       , p-line-ret
      393                       , p-dtl-ret).
      394   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
      395                               , p-nf-chk-amount
      396                               , chr(4)
      397                               , p-nf-gds-amount
      398                               , p-ps-where-rus
      399                               , v-other)
      400                       .
      401   return v-ps.
      402   END FUNCTION.
      403   FUNCTION set-inkas-PS-simple returns character(
      404                                               input p-chk-amount as integer,
      405                                               input p-gds-amount as integer,
      406                                               input p-line-out as integer,
      407                                               input p-dtl-out as integer,
      408                                               input p-line-ret as integer,
      409                                               input p-dtl-ret as integer,
      410                                               input p-nf-chk-amount as integer,
      411                                               input p-nf-gds-amount as integer
      412                                               ):
      413   define variable v-ps as character no-undo .
      414   define variable v-str1 as character no-undo .
      415   assign
      416     v-ps = fill( chr(32) +  chr(4), 9).
      417     v-str1 = ENTRY(1, v-PS, chr(4)).
      418     entry(2, v-str1, chr(32))  = string(p-chk-amount).
      419     ENTRY(1, v-PS, chr(4)) = v-str1.
      420     v-str1 = ENTRY(2, v-PS, chr(4)).
      421     entry(2, v-str1, chr(32))  = string(p-gds-amount).
      422     ENTRY(2, v-PS, chr(4)) = v-str1.
      423     v-str1 = ENTRY(3, v-PS, chr(4)).
      424     entry(2, v-str1, chr(32))  = string(p-line-out).
      425     ENTRY(3, v-PS, chr(4)) = v-str1.
      426     v-str1 = ENTRY(4, v-PS, chr(4)).
      427     entry(2, v-str1, chr(32))  = string(p-dtl-out).
      428     ENTRY(4, v-PS, chr(4)) = v-str1.
      429     v-str1 = ENTRY(5, v-PS, chr(4)).
      430     entry(2, v-str1, chr(32))  = string(p-line-ret).
      431     ENTRY(5, v-PS, chr(4)) = v-str1.
      432     v-str1 = ENTRY(6, v-PS, chr(4)).
      433     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
      434     ENTRY(5, v-PS, chr(4)) = v-str1.
      435     v-str1 = ENTRY(7, v-PS, chr(4)).
      436     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
      437     ENTRY(5, v-PS, chr(4)) = v-str1.
      438     v-str1 = ENTRY(8, v-PS, chr(4)).
      439     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
      440     ENTRY(5, v-PS, chr(4)) = v-str1.
      441   return v-ps.
      442   END FUNCTION.
      443   FUNCTION get-inkas-nf-PS-simple returns logical (
      444                                                input p-ps as character
      445                                               ,output p-gds-amount as integer
      446                                               ,output p-nf-gds-amount as integer
      447                                               ):
      448   if num-entries(p-ps, chr(4)) >= 8 then do:
      449     assign
      450     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
      451     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
      452     no-error .
      453   end.
      454   return not error-status:error .
      455   END FUNCTION.
      456   PROCEDURE get-inkas-PS:
      457   define parameter buffer buf_inkas for ub.inkas.
      458   define output parameter p-chk-amount as integer no-undo .
      459   define output parameter p-gds-amount as integer no-undo .
      460   define output parameter p-line-out as integer no-undo .
      461   define output parameter p-dtl-out as integer no-undo .
      462   define output parameter p-line-ret as integer no-undo .
      463   define output parameter p-dtl-ret as integer no-undo .
      464   define output parameter p-nf-chk-amount as integer no-undo .
      465   define output parameter p-nf-gds-amount as integer no-undo .
      466   define output parameter p-ps-where-rus as character no-undo .
      467   define variable v-gds-amount as integer no-undo .
      468   define variable v-nf-gds-amount as integer no-undo .
      469   define buffer buf_sale-doc for ub.sale-doc.
      470   for each buf_sale-doc no-lock where
      471           buf_sale-doc.inkas-code = buf_inkas.inkas-code
      472       and buf_sale-doc.order > 0:
      473     assign
      474     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
      475                                    or buf_sale-doc.doc-kind = 'trf':U
      476                                    then buf_sale-doc.gds-amount
      477                                    else 0)
      478     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
      479                                 and buf_sale-doc.dir = 1
      480                                 then buf_sale-doc.tot-lines
      481                                 else 0)
      482     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
      483                             and buf_sale-doc.dir = 1
      484                             then buf_sale-doc.tot-dtl
      485                             else 0)
      486     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
      487                                 and buf_sale-doc.dir = -1
      488                                 then buf_sale-doc.tot-lines
      489                                 else 0)
      490     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
      491                              and buf_sale-doc.dir = -1
      492                             then buf_sale-doc.tot-dtl
      493                             else 0)
      494     .
      495   end.
      496   if get-inkas-nf-PS-simple( input buf_inkas.ps
      497                             ,output v-gds-amount
      498                             ,output v-nf-gds-amount) then do:
      499     assign
      500     p-gds-amount = v-gds-amount
      501     p-nf-gds-amount = v-nf-gds-amount
      502     .
      503   end.
      504   assign
      505   p-ps-where-rus = buf_inkas.sale-filter-rus
      506   p-nf-chk-amount = buf_inkas.num-chk-nf
      507   p-chk-amount = buf_inkas.num-chk
      508   .
      509   END PROCEDURE.
      510   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   define SHARED temp-table tt0-info no-undo
      512   field doc-code   like ub.trn-doc.doc-code
      513   field artic      like ub.doc-line.artic
