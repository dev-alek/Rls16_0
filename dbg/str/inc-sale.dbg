     2578       if ink-doc.is-mand-sale-filter then do:
     2579         _lock-inc-sale:
     2580         DO while ind < 100 :
     2581           run gbl/lock-prc.p
     2582             (input 'inkr':U
     2583             ,input p-obj-code
     2584             ,input 0
     2585             ,input 0
     2586             ,input p-obj-type
     2587             ,input ""
     2588             ,input ""
     2589             ,input (
     2590                     "Код объекта" + ",,," +
     2591                     "Тип объекта" +  ",,,Закачка чеков в продажу"
     2592                   )
     2593             ,input no
     2594             ,buffer lock-batchprocess
     2595             ) no-error .
     2596           if not error-status:error then do:
     2597             leave _lock-inc-sale.
     2598           end.
     2599           message
     2600           substitute("Для объекта &1&2 включена настройка <В продажу чеки только по фильтру (если задан)>,&3" +
     2601                     "поэтому одновременно на одном магазине можно работать только с одной продажей&3" +
     2602                     "В настоящий момент ресурс закачки чеков в продажу занят&3" +
     2603                     "Попробуйте позже"
     2604                     , p-obj-type
     2605                     , p-obj-code
     2606                     , chr(10))
     2607           view-as alert-box WARNING.
     2608           undo main-block, return error .
     2609         end.
     2610       end.
     2611       find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code.
     2612   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2614     (input  p-host-code
     2615     ,output v-base-code
