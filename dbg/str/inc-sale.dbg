     2569     end.
     2570     create tt-trn-doc.
     2571     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2572      if ink-doc.status_ = 'факт':U then do:
     2573         message
     2574         "Продажа уже закрыта !!"
     2575         view-as alert-box error .
     2576         undo main-block, return error .
