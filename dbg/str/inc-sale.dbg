     2468                 , error-status:get-message(1)
     2469                 , return-value )
     2470        view-as alert-box error .
     2471        undo, return error .
     2472     end.
     2473     find first thbjattr_thbj-attr where
     2474               thbjattr_thbj-attr.obj-type = p-obj-type
     2475           and thbjattr_thbj-attr.obj-code = p-obj-code
     2476           and thbjattr_thbj-attr.upper-prop-code = 'get-chk':U
     2477           and thbjattr_thbj-attr.prop-code = 'cas-shft':U no-error.
     2478     if available thbjattr_thbj-attr then do:
     2479       cas-shft = thbjattr_thbj-attr.property-value-logical.
     2480     end.
     2481     find first thbjattr_thbj-attr where
