     3469                     ,  input 'чел':U
     3470                     ,  input ?
     3471                     ,  input ?
     3472                     ,  input v-ref-rec
     3473                     ,  input ",,,,,,NO"
     3474                     ,  input "lock-cli-type"
     3475                     , output ref-list ) .
     3476       assign v-ref-rec20 = integer( ref-list ).
     3477       v-ref-rec = integer( ref-list ) .
     3478       find cli-buf where recid (cli-buf) =
     3479          v-ref-rec
     3480          no-lock no-error.
     3481       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3482         find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.agnt
     3483                              and cli-buf.obj-type = 'чел':U no-lock no-error.
