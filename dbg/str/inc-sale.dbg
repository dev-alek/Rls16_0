     2617       FIND FIRST ub.shop WHERE ub.shop.obj-code = p-obj-code NO-LOCK .
     2618       FIND FIRST ub.trn-doc WHERE ub.trn-doc.doc-code = ink-doc.inkas-code exclusive.
     2619       FIND FIRST ret-doc WHERE ret-doc.doc-code = ub.trn-doc.out-code exclusive no-error .
     2620       assign
     2621       chk-amount = ink-doc.num-chk
     2622       line-out = 0
     2623       dtl-out = 0
     2624       line-ret = 0
     2625       dtl-ret = 0
     2626       gds-amount = 0
     2627       nf-chk-amount = 0
     2628       nf-gds-amount = 0
     2629       .
     2630       ASSIGN
     2631       tt-trn-doc.wrkr = trn-doc.wrkr
     2632       tt-trn-doc.agnt = trn-doc.agnt
     2633       tt-trn-doc.boss = trn-doc.boss
     2634       .
     2635     end.
     2636     if p-mode = 'ПРОСМОТР':U then do:
     2637       find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code.
     2638   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2639   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2640     (input  p-host-code
     2641     ,output v-base-code
     2642     )  .
     2643       FIND FIRST shop WHERE shop.obj-code = p-obj-code NO-LOCK .
     2644       FIND FIRST trn-doc no-lock WHERE trn-doc.doc-code = ink-doc.inkas-code.
     2645       FIND FIRST ret-doc no-lock WHERE ret-doc.doc-code = trn-doc.out-code no-error .
     2646       ASSIGN
     2647       tt-trn-doc.wrkr = trn-doc.wrkr
     2648       tt-trn-doc.agnt = trn-doc.agnt
     2649       tt-trn-doc.boss = trn-doc.boss
     2650       .
     2651     end.
     2652     if ink-doc.is-mand-sale-filter then do:
     2653       assign
     2654       v-filter-name = ink-doc.sale-filter-name
     2655       v-where-phrase = ink-doc.sale-filter
     2656       v-where-phrase-rus = ink-doc.sale-filter-rus
     2657       .
     2658     end.
     2659     if can-find( FIRST ub.chk-doc WHERE ub.chk-doc.out-code = ink-doc.inkas-code ) then do:
     2660       FIND FIRST ub.chk-doc WHERE ub.chk-doc.out-code = ink-doc.inkas-code use-index sale
     2661       NO-LOCK .
     2662       assign
     2663       time_ = string( ub.chk-doc.chk-time, "HH:MM" )
     2664       cursh = ub.trn-doc.exch-rate
     2665       cursh-scale = ub.trn-doc.exch-scale
     2666       cursh-date1 = ub.chk-doc.chk-date
     2667       cursh-time1 = ub.chk-doc.chk-time
     2668       curs-mes = "В продажу чеки с курсом баз.вал. = " +
     2669                           string(ub.trn-doc.exch-rate / ub.trn-doc.exch-scale, ">>,>>9.9999").
     2670       run get-inkas-ps in this-procedure (
     2671                                           buffer ink-doc
     2672                                         , output chk-amount
     2673                                         , output gds-amount
     2674                                         , output line-out
     2675                                         , output dtl-out
     2676                                         , output line-ret
     2677                                         , output dtl-ret
     2678                                         , output nf-chk-amount
     2679                                         , output nf-gds-amount
     2680                                         , output ps-where-rus
     2681                                         ).
     2682     end.
     2683     assign
     2684     old-doc-date   =  ink-doc.doc-date
     2685     old-shift-date =  ink-doc.shift-date
     2686     old-shift-num  =  ink-doc.shift-num
     2687     old-shift-nAME  =  ink-doc.shift-nAME
     2688     .
     2689     RUN Myenable in this-procedure .
     2690     WAIT-FOR GO OF FRAME d-chk focus chk-doc.shift-date .
     2691   END.
     2692   RUN disable_UI.
     2693   PROCEDURE check-filter :
     2694   define variable v-dup as logical no-undo .
     2695   define buffer buf_inkas for ub.inkas.
     2696   do
     2697   on error undo, return error
     2698   :
     2699     for each buf_Inkas no-lock where
     2700             buf_inkas.obj-type = ink-doc.obj-type
     2701         AND buf_inkas.obj-code = ink-doc.obj-code
     2702         AND buf_inkas.status_  = 'новый':U
     2703         and recid(buf_inkas) <> recid(ink-doc)
     2704         :
     2705       if buf_inkas.sale-filter = v-where-phrase then do:
     2706         if cas-shft then do:
     2707           if buf_inkas.shift-date = ink-doc.shift-date
     2708           and buf_inkas.shift-nAME = ink-doc.shift-nAME then do:
     2709             assign
     2710             v-dup = yes.
     2711           end.
     2712         end.
     2713         else do:
     2714           if ub.shop.day-only then do:
     2715             if buf_inkas.shift-date = ink-doc.shift-date then do:
     2716               assign
     2717               v-dup = yes.
     2718             end.
     2719           end.
     2720           else do:
     2721             assign
     2722             v-dup = yes.
     2723           end.
     2724         end.
     2725         if v-dup then do:
     2726           message
     2727           substitute("Для объекта &1&2 включена настройка <В продажу чеки только по фильтру (если задан)>,&3" +
     2728                     "и найден отчет о продаже с №&4, полученный по фильтру&3<&5>&3" +
     2729                     "поэтому ВЫ НЕ МОЖЕТЕ УСТАНОВИТЬ ФИЛЬТР &3<&5>&3 для продажи &6&3"
     2730                     , ink-doc.obj-type
     2731                     , ink-doc.obj-code
     2732                     , chr(10)
     2733                     , buf_inkas.inkas-code
     2734                     , v-where-phrase-rus
     2735                     , ink-doc.inkas-code
     2736                     )
     2737           view-as alert-box ERROR.
     2738           undo, return error.
     2739         end.
     2740       end.
     2741     end.
     2742   end.
     2743   end procedure.
     2744   PROCEDURE disable_UI :
     2745     HIDE FRAME d-chk.
     2746   END PROCEDURE.
     2747   PROCEDURE display-chk :
     2748   DEFINE INPUT PARAMETER p-chk-amount AS INTEGER NO-UNDO.
     2749   define input parameter p-nf-chk-amount as integer no-undo .
     2750   DISPLAY
     2751   p-chk-amount @ chk-amount
     2752   p-nf-chk-amount @ nf-chk-amount
     2753   with frame d-chk.
     2754   if available X_chk-doc then
     2755   DISPLAY
     2756   X_chk-doc.cashier @ ub.chk-doc.cashier
     2757   X_chk-doc.shift-date @ ub.chk-doc.shift-date
     2758   X_chk-doc.chk-num    @ ub.chk-doc.chk-num
     2759   string( X_chk-doc.chk-time, "HH:MM" ) @ time_
     2760   X_chk-doc.office  @ ub.chk-doc.office
     2761   X_chk-doc.discnt @ ub.chk-doc.discnt
     2762   X_chk-doc.netto  @ ub.chk-doc.netto
     2763   X_chk-doc.doc-code  @ ub.chk-doc.doc-code
     2764   X_chk-doc.sub-discnt  @ ub.chk-doc.sub-discnt
     2765   X_chk-doc.pay-desk  @ ub.chk-doc.pay-desk
     2766   X_chk-doc.sales-man @ ub.chk-doc.sales-man
     2767   X_chk-doc.tot-doc   @ ub.chk-doc.tot-doc
     2768   entry (lookup (string(X_chk-doc.chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)  @ f-chk-type
     2769   with frame d-chk.
     2770   END PROCEDURE.
     2771   PROCEDURE display-ink-doc :
     2772   define input parameter p-gds-amount  as integer no-undo .
     2773   define input parameter p-nf-gds-amount  as integer no-undo .
     2774   define input parameter p-line-out    as integer no-undo .
     2775   define input parameter p-line-ret    as integer no-undo .
     2776   define input parameter p-dtl-out     as integer no-undo .
     2777   define input parameter p-dtl-ret     as integer no-undo .
     2778   DISPLAY
     2779   p-dtl-out @ dtl-out
     2780   p-dtl-ret @ dtl-ret
     2781   p-line-out @ line-out
     2782   p-line-ret @ line-ret
     2783   p-gds-amount @ gds-amount
     2784   p-nf-gds-amount @ nf-gds-amount
     2785   with frame d-chk.
     2786   END PROCEDURE.
     2787   PROCEDURE Enable_UI :
     2788     DISPLAY RS-get-method chk-amount gds-amount line-out dtl-out nf-chk-amount
     2789             nf-gds-amount line-ret dtl-ret f-shift-name f-shift-num time_
     2790             f-chk-type wrkr-name agnt-name curs-mes boss-name
     2791         WITH FRAME d-chk.
     2792     IF AVAILABLE tt-trn-doc THEN
     2793       DISPLAY tt-trn-doc.wrkr tt-trn-doc.agnt tt-trn-doc.boss
     2794         WITH FRAME d-chk.
     2795     IF AVAILABLE ub.chk-doc THEN
     2796       DISPLAY ub.chk-doc.shift-date ub.chk-doc.chk-num ub.chk-doc.office
     2797             ub.chk-doc.pay-desk ub.chk-doc.cashier ub.chk-doc.sales-man
     2798             ub.chk-doc.doc-code ub.chk-doc.netto ub.chk-doc.sub-discnt
     2799             ub.chk-doc.tot-doc ub.chk-doc.discnt
     2800         WITH FRAME d-chk.
     2801     ENABLE b-exit RECT-1 b-quit B-sch b-doc b-help RS-get-method br-saledoc
     2802            chk-amount gds-amount line-out dtl-out nf-chk-amount nf-gds-amount
     2803            line-ret dtl-ret ub.chk-doc.shift-date f-shift-name f-shift-num
     2804            ub.chk-doc.chk-num time_ ub.chk-doc.office f-chk-type
     2805            ub.chk-doc.pay-desk ub.chk-doc.cashier ub.chk-doc.sales-man
     2806            ub.chk-doc.doc-code ub.chk-doc.netto ub.chk-doc.sub-discnt
     2807            tt-trn-doc.wrkr r-wrkr ub.chk-doc.tot-doc ub.chk-doc.discnt
     2808            tt-trn-doc.agnt r-agnt tt-trn-doc.boss r-boss wrkr-name agnt-name
     2809            curs-mes boss-name
     2810         WITH FRAME d-chk.
     2811     OPEN QUERY br-saledoc FOR EACH buf_sale-doc WHERE buf_sale-doc.inkas-code = ink-doc.inkas-code.
     2812   END PROCEDURE.
     2813   PROCEDURE IncProc :
     2814   define variable v-ii     as integer no-undo .
     2815   define variable v-ii-ok  as integer no-undo .
     2816   define variable v-rc-ii as integer no-undo .
     2817   define variable v-rc-max as integer no-undo .
     2818   DEFINE VARIABLE v-query-prepare AS CHARACTER NO-UNDO.
     2819   define variable v-error-status as logical no-undo .
     2820   define variable v-error-status-message as character no-undo .
     2821   if rs-get-method = "inc-salr":U
     2822   or ink-doc.is-mand-sale-filter
     2823   then do:
     2824     ASSIGN
     2825     v-query-prepare = substitute("for each X_chk-doc no-lock where ":U +
     2826                               "X_chk-doc.obj-type = '&1'":U +
     2827                               " AND X_chk-doc.obj-code = &2":U +
     2828                               " AND X_chk-doc.out-code = ? ", p-obj-type, p-obj-code).
     2829     if cas-shft then do:
     2830       ASSIGN
     2831       v-query-prepare = v-query-prepare +
     2832                       substitute(" AND X_chk-doc.shift-date = &1 AND X_chk-doc.shift-num = &2"
     2833                                 , string(ink-doc.shift-date, "99/99/9999")
     2834                                 , ink-doc.shift-num).
     2835     end.
     2836     else do:
     2837         if ub.shop.day-only then do:
     2838             ASSIGN
     2839             v-query-prepare = v-query-prepare +
     2840                             substitute(" AND X_chk-doc.shift-date = &1", string(ink-doc.shift-date, "99/99/9999")).
     2841                             .
     2842         end.
     2843         else do:
     2844             ASSIGN
     2845             v-query-prepare = v-query-prepare +
     2846                             substitute(" AND X_chk-doc.shift-date <= &1", string(ink-doc.shift-date, "99/99/9999")).
     2847         end.
     2848     end.
     2849     if rs-get-method = "chk-docs":U then do:
     2850       assign
     2851       v-query-prepare = v-query-prepare + substitute(" AND lookup(string(recid(X_chk-doc)), '&1') > 0 ", v-rid-list)
     2852       .
     2853     end.
     2854     assign
     2855     glog =
     2856     QUERY query-chk-doc:QUERY-PREPARE(v-query-prepare + v-where-phrase) No-error.
     2857     IF not glog
     2858     THEN DO:
     2859         MESSAGE
     2860         "Ошибка - неверно выбран или построен ФИЛЬТР" skip
     2861         error-status:get-message(1) skip
     2862         VIEW-AS ALERT-BOX ERROR.
     2863         UNDO, RETURN ERROR.
     2864     END.
     2865     assign
     2866     glog = QUERY query-chk-doc:query-OPEN() NO-ERROR.
     2867     IF not glog
     2868     THEN DO:
     2869         MESSAGE
     2870         "Неверно выбран или построен ФИЛЬТР"
     2871         VIEW-AS ALERT-BOX ERROR.
     2872         UNDO, RETURN ERROR.
     2873     END.
     2874     ASSIGN
     2875     glog = QUERY query-chk-doc:GET-FIRST(no-LOCK) NO-ERROR.
     2876     IF not glog THEN DO:
     2877       message
     2878       "Нет чеков, удовлетворяющих условиям закачки в продажу" skip
     2879       view-as alert-box WARNING .
     2880       RETURN.
     2881     END.
     2882     ASSIGN
     2883     glog = QUERY query-chk-doc:GET-FIRST(exclusive-LOCK, no-wait) NO-ERROR.
     2884     do while locked (X_chk-doc ) and available X_chk-doc:
     2885        glog = QUERY query-chk-doc:GET-NEXT(exclusive-LOCK, no-wait) NO-ERROR.
     2886     end.
     2887   end.
     2888   else do:
     2889     assign
     2890     v-rc-max = num-entries(v-rid-list).
     2891     _v-rc:
     2892     do while v-rc-ii < v-rc-max:
     2893       assign
     2894       v-rc-ii = v-rc-ii + 1
     2895       .
     2896       find first X_chk-doc exclusive-lock where
     2897                 recid(X_chk-doc) = integer(entry(v-rc-ii, v-rid-list))  no-wait no-error.
     2898       if locked X_chk-doc or not available X_chk-doc then do:
     2899          next _v-rc.
     2900       end.
     2901       else leave _v-rc.
     2902     end.
     2903     if not available X_chk-doc
     2904     or locked(X_chk-doc) then do:
     2905       message
     2906       "Ни один из выбранных Вами чеков не может быть сейчас закачан в продажу" skip
     2907       "Возможно они заняты другим пользователем"
     2908       view-as alert-box Warning.
     2909       return.
     2910     end.
     2911   end.
     2912   run str/inc-salr.p (
     2913                    input  parparentproc
     2914                   ,input  this-procedure
     2915                   ,input-output v-ii
     2916                   ,input-output v-ii-ok
     2917                   ,input (IF rs-get-method = "chk-docs":U and ink-doc.is-mand-sale-filter THEN no ELSE (if ink-doc.sale-filter = "":U then no else yes))
     2918                   ,input v-where-phrase-rus
     2919                   ,INPUT (IF rs-get-method = "chk-docs":U and not ink-doc.is-mand-sale-filter THEN v-rid-list ELSE "":U)
     2920                   ,input  p-obj-type
     2921                   ,input  p-obj-code
     2922                   ,input  v-curr-r-b
     2923                   ,input  is-wth
     2924                   ,input  cas-shft
     2925                   ,input  one-curs
     2926                   ,input  cas-curs
     2927                   ,input  cursh
     2928                   ,input  cursh-scale
     2929                   ,input  prcl-spl
     2930                   ,input  pay-gds-algo
     2931                   ,input  rdtaxcd
     2932                   ,input  exctaxcd
     2933                   ,input  factorrt
     2934                   ,input  btltaxcd
     2935                   ,input  gds-amount
     2936                   ,input  chk-amount
     2937                   ,input  line-out
     2938                   ,input  line-ret
     2939                   ,input  dtl-out
     2940                   ,input  dtl-ret
     2941                   ,input  nf-chk-amount
     2942                   ,input  nf-gds-amount
     2943                   ,input  shop.day-only
     2944                   ,input  old-doc-date
     2945                   ,input  old-shift-date
     2946                   ,input  old-shift-num
     2947                   ,input  new-doc-date
     2948                   ,input  new-shift-date
     2949                   ,input  new-shift-num
     2950                   ,buffer ink-doc
     2951                   ,buffer ub.trn-doc
     2952                   ,buffer ret-doc
     2953                   ,buffer buf_sysconf
     2954       ) NO-ERROR.
     2955   assign
     2956   v-error-status = error-status:error
     2957   v-error-status-message = error-status:get-message(1)
     2958   .
     2959   enable
     2960   br-saledoc
     2961   with frame d-chk .
     2962   OPEN QUERY br-saledoc FOR EACH buf_sale-doc WHERE buf_sale-doc.inkas-code = ink-doc.inkas-code.
     2963   if not p-augetres then do:
     2964     if v-ii = 0 then do:
     2965       if v-error-status then
     2966       message
     2967       "Произошла ошибка при закачке чеков в продажу" skip
     2968       v-error-status-message skip
     2969       return-value
     2970       view-as alert-box .
     2971       else
     2972       message
     2973       "Нет чеков, удовлетворяющих условиям закачки в продажу" skip
     2974       view-as alert-box WARNING .
     2975     end.
     2976     else do:
     2977       message
     2978       substitute("Просмотрено &1 чеков, успешно закачано в продажу &2", v-ii, v-ii-ok)
     2979       view-as alert-box WARNING .
     2980     end.
     2981   end.
     2982   END PROCEDURE.
     2983   PROCEDURE IncProcStart :
     2984   define input parameter p-run as logical no-undo .
     2985   if p-mode <> 'ИЗМЕНЕНИЕ':U then return.
     2986   define variable v-deleted as logical no-undo .
     2987   DEFINE VARIABLE screen-shift-num AS INTEGER NO-UNDO.
     2988   DEFINE VARIABLE screen-shift-name AS character NO-UNDO.
     2989   DEFINE VARIABLE screen-shift-date AS date NO-UNDO.
     2990   define variable v-dopi as integer no-undo .
     2991   define buffer buf_sale-doc for ub.sale-doc.
     2992   define buffer buf_trn-doc for ub.trn-doc.
     2993   ASSIGN
     2994   screen-shift-num = input frame d-chk f-shift-num
     2995   screen-shift-name = input frame d-chk f-shift-name
     2996   screen-shift-date = input frame d-chk ub.chk-doc.shift-date
     2997   .
     2998   if screen-shift-date <> ink-doc.doc-date OR
     2999   (cas-shft AND screen-shift-name <> ink-doc.shift-name) then do:
     3000     glog = yes.
     3001     message substitute("Вы поменяли предложенную дату отчета о продаже&1&2" +
     3002                        "Вы хотите, чтобы в отчет попали чеки &3 &4 &5?"
     3003                         ,(if cas-shft then "  И/ИЛИ № смены отчета о продаже"  else "" )
     3004                         ,chr(10)
     3005                         ,(if ub.shop.day-only then "ЗА " else "ПО ")
     3006                         ,string(screen-shift-date, "99/99/9999")
     3007                         ,(if cas-shft
     3008                           then SUBSTITUTE(" за смену № &1 &2"
     3009                                             ,screen-shift-name
     3010                                             ,(if screen-shift-num = integer(screen-shift-name)
     3011                                               then screen-shift-name
     3012                                               else (screen-shift-name + "(" +
     3013                                                     string(screen-shift-num) + ")"
     3014                                                    )
     3015                                              )
     3016                                           )
     3017                             else "")
     3018                          )
     3019     view-as alert-box question buttons YES-NO update glog.
     3020     if NOT glog then return error .
     3021     if one-sale-per-day then do:
     3022       define variable v-shift-date as date no-undo .
     3023       define variable v-shift-num as integer no-undo .
     3024       define variable v-mes as character no-undo .
     3025       define buffer buf_inkas for ub.inkas.
     3026       v-shift-date = input frame d-chk chk-doc.shift-date.
     3027       v-shift-num = ink-doc.shift-num.
     3028       if l-shift-on
     3029       or cas-shft
     3030       then do:
     3031         find first buf_inkas no-lock where
     3032                   buf_inkas.obj-type =  ink-doc.obj-type
     3033               and buf_inkas.obj-code =  ink-doc.obj-code
     3034               and buf_inkas.shift-date = v-shift-date
     3035               and buf_inkas.shift-num = v-shift-num
     3036               no-error.
     3037         if available buf_inkas then do:
     3038           v-mes = substitute("Нельзя создать вторую продажу за смену &1 П. &2 - запрещено параметрами"
     3039                             , string(v-shift-date, "99/99/9999")
     3040                             , v-shift-num
     3041                               ).
     3042         end.
     3043       end.
     3044       else do:
     3045         find first buf_inkas no-lock where
     3046                   buf_inkas.obj-type =  ink-doc.obj-type
     3047               and buf_inkas.obj-code =  ink-doc.obj-code
     3048               and buf_inkas.doc-date = v-shift-date no-error.
     3049         if available buf_inkas then do:
     3050           v-mes = substitute("Нельзя создать вторую продажу за день &1 - запрещено параметрами"
     3051                             , string(v-shift-date, "99/99/9999")
     3052                             ).
     3053         end.
     3054       end.
     3055     end.
     3056     if available buf_inkas then do:
     3057       message v-mes view-as alert-box error .
     3058       return error .
     3059     end.
     3060     assign
     3061     ink-doc.doc-date = input frame d-chk chk-doc.shift-date
     3062     ink-doc.shift-date = ink-doc.doc-date
     3063     ink-doc.shift-name = input frame d-chk f-shift-name
     3064     .
     3065   end.
     3066   for each buf_sale-doc where
     3067           buf_sale-doc.inkas-code = ink-doc.inkas-code
     3068       and buf_sale-doc.order > 0,
     3069       first buf_trn-doc exclusive-lock where
     3070           buf_trn-doc.doc-code = buf_sale-doc.doc-code
     3071   ON ERROR UNDO, RETURN ERROR:
     3072     assign
     3073     buf_trn-doc.wrkr = tt-trn-doc.wrkr
     3074     buf_trn-doc.agnt = tt-trn-doc.agnt
     3075     buf_trn-doc.boss = tt-trn-doc.boss
     3076     .
     3077   end.
     3078   if cas-shft then do:
     3079     assign
     3080     v-dopi = integer(f-shift-name)
     3081     no-error .
     3082     if error-status:error
     3083     or v-dopi <= 0
     3084     or v-dopi > 99
     3085     then do:
     3086       message
     3087       "Номер смены должен быть числом >0!" view-as alert-box ERROR.
     3088       return error.
     3089     end.
     3090     ASSIGN f-shift-name.
     3091     assign
     3092     f-shift-num = (if not l-shift-on then integer(f-shift-name) else f-shift-num)
     3093     ink-doc.shift-num = f-shift-num
     3094     ink-doc.shift-nAME = F-shift-nAME
     3095     ink-doc.shift-date = ink-doc.doc-date
     3096     new-doc-date      = ink-doc.doc-date
     3097     new-shift-date      = ink-doc.shift-date
     3098     new-shift-num       = ink-doc.shift-num
     3099     new-shift-name       = ink-doc.shift-name
     3100     .
     3101     for each buf_sale-doc where
     3102             buf_sale-doc.inkas-code = ink-doc.inkas-code
     3103         and buf_sale-doc.order > 0,
     3104         first buf_trn-doc exclusive-lock where
     3105             buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     3106       assign
     3107       buf_Trn-doc.shift-num = f-shift-num
     3108       buf_Trn-doc.shift-name = f-shift-name
     3109       buf_trn-doc.shift-date = ink-doc.doc-date
     3110       .
     3111     end.
     3112   end.
     3113   else do:
     3114     assign
     3115     ink-doc.shift-num = 0
     3116     ink-doc.shift-date = ink-doc.doc-date
     3117     new-doc-date      = ink-doc.doc-date
     3118     new-shift-date      = ink-doc.shift-date
     3119     new-shift-num       = 0
     3120     new-shift-name      = '':U
     3121     .
     3122   end.
     3123    if shop.day-only then do:
     3124      if can-find( first chk-doc where chk-doc.obj-type = p-obj-type and
     3125                                      chk-doc.obj-code = p-obj-code and
     3126                                      chk-doc.out-code = ? and
     3127                                       chk-doc.shift-date < ink-doc.doc-date ) then  do:
     3128         glog = yes.
     3129         message substitute("Имеются чеки за более раннюю дату,&1" +
     3130                            "не включенные ни в один отчет о продаже.&1" +
     3131                            "Не забудьте создать отчет о продаже&1" +
     3132                            "и включить в него эти чеки.&1&1" +
     3133                            "Продолжать ?"
     3134                            ,chr(10))
     3135         view-as alert-box question buttons YES-NO update glog.
     3136         if NOT glog then return error .
     3137       end.
     3138     end.
     3139     else do:
     3140       if can-find( first ub.inkas where ub.inkas.obj-type = p-obj-type and
     3141                                    ub.inkas.obj-code = p-obj-code and
     3142                                    ub.inkas.status_ = 'факт':U and
     3143                                    ub.inkas.doc-date > ink-doc.doc-date ) then do:
     3144         glog = yes.
     3145         message substitute("Уже имеется отчет о продаже, содержащий чеки,&1"  +
     3146                            "дата которых БОЛЬШЕ указанной Вами.&1"  +
     3147                            "Вы уверены, что в базе появились новые чеки ?&1"
     3148                           , chr(10))
     3149         view-as alert-box question buttons YES-NO update glog.
     3150         if NOT glog then  return error .
     3151       end.
     3152     end.
     3153   if NOT can-find( FIRST ub.chk-doc WHERE ub.chk-doc.out-code = ink-doc.inkas-code )  then  do:
     3154     FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-type = p-obj-type and
     3155                               ub.curr-shop.obj-code = p-obj-code and
     3156                               ub.curr-shop.curr-code = v-base-code and
     3157                               ub.curr-shop.exch-date <= ink-doc.doc-date NO-LOCK no-error.
     3158     if available ub.curr-shop then do:
     3159       for each buf_sale-doc where
     3160               buf_sale-doc.inkas-code = ink-doc.inkas-code
     3161           and buf_sale-doc.order > 0,
     3162         first buf_trn-doc exclusive-lock where
     3163               buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     3164         assign
     3165         buf_trn-doc.base-rate = curr-shop.exch-rate
     3166         buf_trn-doc.base-scale = curr-shop.exch-scale
     3167         .
     3168         if v-curr-r-b = 'base':U then do:
     3169           assign
     3170           buf_trn-doc.exch-rate = buf_trn-doc.base-rate
     3171           buf_trn-doc.exch-scale = buf_trn-doc.base-scale
     3172           .
     3173         end.
     3174       end.
     3175     end.
     3176     else do:
     3177       for each buf_sale-doc where
     3178               buf_sale-doc.inkas-code = ink-doc.inkas-code
     3179           and buf_sale-doc.order > 0,
     3180         first buf_trn-doc exclusive-lock where
     3181               buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     3182         assign
     3183         buf_trn-doc.base-rate   = 1
     3184         buf_trn-doc.base-scale = 1
     3185         .
     3186         if v-curr-r-b = 'base':U then do:
     3187           assign
     3188           buf_trn-doc.exch-rate = buf_trn-doc.base-rate
     3189           buf_trn-doc.exch-scale = buf_trn-doc.base-scale
     3190           .
     3191         end.
     3192       end.
     3193       message substitute("Нет магазинного курса базовой валюты&1"  +
     3194                         "на дату &2!&1" +
     3195                         "Курс в накладных устанавливается равным 1."
     3196                         ,chr(10)
     3197                         ,string(ink-doc.doc-date, "99/99/9999"))
     3198       view-as alert-box error .
     3199     end.
     3200     if ink-doc.is-mand-sale-filter and p-run then do:
     3201       message
     3202       substitute("Для объекта &1&2 включена настройка <В продажу чеки только по фильтру (если задан)>,&3" +
     3203                  "поэтому ТОЛЬКО СЕЙЧАС - пока продажа ПУСТА - ВЫ МОЖЕТЕ УСТАНОВИТЬ ИЛИ ИЗМЕНИТЬ ФИЛЬТР&3&3" +
     3204                  "УСТАНОВИТЬ или ИЗМЕНИТЬ ФИЛЬТР ?"
     3205                 , ink-doc.obj-type
     3206                 , ink-doc.obj-code
     3207                 , chr(10)
     3208                  )
     3209       view-as alert-box QUESTION buttons YES-NO update glog.
     3210       if glog then do:
     3211         run proc-b-sch in this-procedure.
     3212       end.
     3213       else do:
     3214       end.
     3215       if v-where-phrase = "":U then do:
     3216         message
     3217         substitute("Фильтр НЕ УСТАНОВЛЕН&1" +
     3218                   "Закачка чеков в продажу НЕВОЗМОЖНА"
     3219                    ,chr(10))
     3220         view-as alert-box error .
     3221         return error .
     3222       end.
     3223       run check-filter in this-procedure no-error .
     3224       if error-status:error then undo, return error .
     3225     end.
     3226     if one-curs then do:
     3227         run str/selcursh.w (
     3228                        input parparentproc,
     3229                        input ink-doc.obj-type,
     3230                        input ink-doc.obj-code,
     3231                        input v-base-code,
     3232                        input ink-doc.doc-date,
     3233                       input shop.day-only,
     3234                       input-output cursh,
     3235                       output cursh-scale,
     3236                       input-output cursh-date1,
     3237                       output cursh-date2,
     3238                       input-output cursh-time1,
     3239                       output cursh-time2) no-error.
     3240       if error-status:error or cursh = 0 then return error.
     3241         message
     3242         substitute("В продажу попадут чеки с курсом базовой валюты &1 (масштаб &2)"
     3243                   , cursh
     3244                   , cursh-scale)
     3245         view-as alert-box .
     3246     end.
     3247     assign
     3248     ink-doc.shift-num = (if cas-shft then f-shift-num else 0)
     3249     ink-doc.shift-name = (if cas-shft then f-shift-name else '')
     3250     .
     3251     for each buf_sale-doc where
     3252              buf_sale-doc.inkas-code = ink-doc.inkas-code
     3253         and  buf_sale-doc.order > 0,
     3254         first buf_trn-doc exclusive-lock where
     3255             buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     3256       assign
     3257       buf_trn-doc.doc-date = ink-doc.doc-date
     3258       buf_trn-doc.shift-num = (if cas-shft then f-shift-num else 0)
     3259       buf_trn-doc.shift-name = (if cas-shft then f-shift-name else '')
     3260       .
     3261       If one-curs then do:
     3262         assign
     3263         buf_trn-doc.base-rate = cursh
     3264         buf_trn-doc.base-scale = cursh-scale
     3265         .
     3266         if v-curr-r-b = 'base':U then do:
     3267           assign
     3268           buf_trn-doc.exch-rate = buf_trn-doc.base-rate
     3269           buf_trn-doc.exch-scale = buf_trn-doc.base-scale
     3270           .
     3271         end.
     3272       end.
     3273     end.
     3274   end.
     3275   else do:
     3276     FIND LAST curr-shop WHERE curr-shop.obj-type = p-obj-type and
     3277                               curr-shop.obj-code = p-obj-code and
     3278                               curr-shop.curr-code = v-base-code and
     3279                               curr-shop.exch-date <= ink-doc.doc-date NO-LOCK no-error.
     3280     if available curr-shop then do:
     3281       for each buf_sale-doc where
     3282               buf_sale-doc.inkas-code = ink-doc.inkas-code
     3283            and buf_sale-doc.order > 0,
     3284         first buf_trn-doc exclusive-lock where
     3285               buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     3286         assign
     3287         buf_trn-doc.base-rate = curr-shop.exch-rate
     3288         buf_trn-doc.base-scale = curr-shop.exch-scale
     3289         .
     3290         if v-curr-r-b = 'base':U then do:
     3291           assign
     3292           buf_trn-doc.exch-rate = buf_trn-doc.base-rate
     3293           buf_trn-doc.exch-scale = buf_trn-doc.base-scale
     3294           .
     3295         end.
     3296       end.
     3297     end.
     3298     else do:
     3299       for each buf_sale-doc where
     3300               buf_Sale-doc.inkas-code = ink-doc.inkas-code
     3301           and buf_sale-doc.order > 0,
     3302         first buf_trn-doc exclusive-lock where
     3303               buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     3304         assign
     3305         buf_trn-doc.base-rate   = 1
     3306         buf_trn-doc.base-scale = 1
     3307         .
     3308         if v-curr-r-b = 'base':U then do:
     3309           assign
     3310           buf_trn-doc.exch-rate = buf_trn-doc.base-rate
     3311           buf_trn-doc.exch-scale = buf_trn-doc.base-scale
     3312           .
     3313         end.
     3314       end.
     3315       message "Нет магазинного курса базовой валюты" skip
     3316               "на дату " ink-doc.doc-date " !" skip
     3317               "Курс в накладных устанавливается равным 1."
     3318       view-as alert-box error .
     3319     end.
     3320   end.
     3321   if p-run then
     3322   run IncProc in this-procedure .
     3323   END PROCEDURE.
     3324   PROCEDURE local-psn-chk :
     3325   define input parameter p-man    as character no-undo.
     3326   define input parameter p-action as character no-undo.
     3327   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     3328   if p-man = "wrkr" and p-action = "ret-mouse" then do:
     3329     define variable v-ref-rec16   as recid no-undo .
     3330     find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.wrkr
     3331                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3332     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3333       if input frame d-chk tt-trn-doc.wrkr <> ""
     3334          and input frame d-chk tt-trn-doc.wrkr <> ? then
     3335         message "Из справочника клиентов Вы должны выбрать человека.".
     3336       run ref/cli-all.w (  input parparentproc
     3337                     ,  input "b-sel"
     3338                     ,  input 'чел':U
     3339                     ,  input ?
     3340                     ,  input ?
     3341                     ,  input v-ref-rec
     3342                     ,  input ",,,,,,NO"
     3343                     ,  input "lock-cli-type"
     3344                     , output ref-list ) .
     3345       assign v-ref-rec16 = integer( ref-list ).
     3346       v-ref-rec = integer( ref-list ) .
     3347       find cli-buf where recid (cli-buf) =
     3348          v-ref-rec
     3349          no-lock no-error.
     3350       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3351         find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.wrkr
     3352                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3353     end.
     3354     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3355       display cli-buf.obj-code @ tt-trn-doc.wrkr
     3356               cli-buf.obj-name @ wrkr-name with frame d-chk.
     3357       assign frame d-chk tt-trn-doc.wrkr.
     3358     end.
     3359     else display ? @ tt-trn-doc.wrkr
     3360                  ? @ wrkr-name with frame d-chk.
     3361     apply "entry" to tt-trn-doc.agnt in frame d-chk.
     3362   if available cli-buf then do:
     3363         display cli-buf.obj-code @ tt-trn-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-chk.
     3364     end.
     3365     else display ? @ tt-trn-doc.wrkr ? @ wrkr-name with frame d-chk.
     3366         return no-apply.
     3367   end.
     3368   if p-man = "wrkr" and p-action = "button" then do:
     3369     define variable v-ref-rec17   as recid no-undo .
     3370     find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.wrkr
     3371                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3372     assign v-ref-rec17 = ( if available cli-buf then recid( cli-buf ) else ? ).
     3373     v-ref-rec = ( if available cli-buf then recid( cli-buf ) else ? ).
     3374     release cli-buf.
     3375     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     3376       run ref/cli-all.w (  input parparentproc
     3377                     ,  input "b-sel"
     3378                     ,  input 'чел':U
     3379                     ,  input ?
     3380                     ,  input ?
     3381                     ,  input v-ref-rec
     3382                     ,  input ",,,,,,NO"
     3383                     ,  input "lock-cli-type"
     3384                     , output ref-list ) .
     3385       assign v-ref-rec17 = integer( ref-list ).
     3386       v-ref-rec = integer( ref-list ) .
     3387       find cli-buf where recid (cli-buf) =
     3388          v-ref-rec
     3389          no-lock no-error.
     3390       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3391         find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.wrkr
     3392                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     3393     end.
     3394     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     3395       display cli-buf.obj-code @ tt-trn-doc.wrkr
     3396               cli-buf.obj-name @ wrkr-name with frame d-chk.
     3397       assign frame d-chk tt-trn-doc.wrkr.
     3398     end.
     3399     else display ? @ tt-trn-doc.wrkr
     3400                  ? @ wrkr-name with frame d-chk.
     3401     apply "entry" to tt-trn-doc.agnt in frame d-chk.
     3402   if available cli-buf then do:
     3403         display cli-buf.obj-code @ tt-trn-doc.wrkr cli-buf.obj-name @ wrkr-name with frame d-chk.
     3404     end.
     3405     else display ? @ tt-trn-doc.wrkr ? @ wrkr-name with frame d-chk.
     3406         return no-apply.
     3407   end.
     3408   if p-man = "wrkr" and p-action = "leave" then do:
     3409     define variable v-ref-rec18   as recid no-undo .
     3410     find cli-buf where cli-buf.obj-code = input frame d-chk tt-trn-doc.wrkr
     3411                    and cli-buf.obj-type = 'чел':U no-lock no-error.
