       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":u .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
       14   define variable vss-workfile    as character no-undo init "$Workfile: inc-sale.w $":u .
       15   define variable vss-archive     as character no-undo init "$Archive: str/inc-sale.w $":u .
