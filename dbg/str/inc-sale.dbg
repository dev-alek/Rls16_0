     2160   procedure diasize_add_browse :
     2161     define input  parameter p-browse-type   as character no-undo .
     2162     define input  parameter p-browse-handle as handle    no-undo .
     2163     define buffer buf_temp-browse-handle for temp-browse-handle .
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       assign
     2168         v-diasize-browse-number = v-diasize-browse-number + 1
     2169       .
     2170       create buf_temp-browse-handle .
     2171       assign
     2172         buf_temp-browse-handle.browse-type   = p-browse-type
     2173         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2174         buf_temp-browse-handle.browse-handle = p-browse-handle
     2175       .
     2176     end.
     2177   end procedure.
     2178   procedure diasize_init :
     2179     define variable v-default-value    as logical   no-undo .
     2180     define variable v-restore-saved    as logical   no-undo .
     2181     define variable v-resize-value-str as character no-undo .
     2182     do
     2183     on error undo, return error return-value
     2184     :
     2185       do with frame d-chk
     2186       :
     2187         assign
     2188           v-diasize-orig-frame-height = frame d-chk :height
     2189           v-diasize-orig-frame-width  = frame d-chk :width
     2190           v-diasize-browse-handle     = browse br-saledoc :handle
     2191         .
     2192         create button v-diasize-resize-button
     2193         assign
     2194           parent        = frame d-chk :first-child
     2195           label         = "s"
     2196           height-pixels = 16
     2197           width-pixels  = 16
     2198           visible       = true
     2199           sensitive     = true
     2200           movable       = true
     2201           triggers:
     2202             on end-move persistent run diasize_end-move in this-procedure .
     2203           end triggers.
     2204         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2205         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2206         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2207         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2208         assign
     2209           v-diasize-wndmax = false
     2210         .
     2211         if connected("ub") = true
     2212         then do:
     2213           define variable v-cntxt-db-num        as integer   no-undo .
     2214           define variable v-cntxt-userid        as character no-undo .
     2215           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2216                                             , OUTPUT v-cntxt-userid
     2217                                             ) .
     2218           run gbl/wndpar_r.p
     2219             (input  v-cntxt-db-num
     2220             ,input  v-cntxt-userid
     2221             ,input  'wndmax':U
     2222             ,output v-diasize-wndmax
     2223             ,output v-default-value
     2224             ) .
     2225         end.
     2226         assign
     2227           v-diasize-wndstore = false
     2228         .
     2229         if connected("ub") = true
     2230         then do:
     2231           run gbl/wndpar_r.p
     2232             (input  v-cntxt-db-num
     2233             ,input  v-cntxt-userid
     2234             ,input  'wndstore':U
     2235             ,output v-diasize-wndstore
     2236             ,output v-default-value
     2237             ) .
     2238         end.
     2239         assign
     2240           v-diasize-proc-name = entry(1, program-name(2), '.')
     2241         .
     2242         if v-diasize-wndstore = true
     2243         then do:
     2244           assign
     2245             v-restore-saved = false
     2246           .
     2247           if connected("ub") = true
     2248           then do:
     2249             run gbl/wndsizer.p
     2250               (input  v-cntxt-db-num
     2251               ,input  v-cntxt-userid
     2252               ,input  v-diasize-proc-name
     2253               ,input  'height':u
     2254               ,output v-resize-value-str
     2255               ) .
     2256             if v-resize-value-str <> '':U
     2257             then do:
     2258               run diasize_change-height in this-procedure
     2259                 (input  integer(v-resize-value-str)
     2260                 ,input  true
     2261                 ) .
     2262               assign
     2263                 v-restore-saved = true
     2264               .
     2265             end.
     2266           end.
     2267           if connected("ub") = true
     2268           then do:
     2269             run gbl/wndsizer.p
     2270               (input  v-cntxt-db-num
     2271               ,input  v-cntxt-userid
     2272               ,input  v-diasize-proc-name
     2273               ,input  'width':u
     2274               ,output v-resize-value-str
     2275               ) .
     2276             if v-resize-value-str <> '':U
     2277             then do:
     2278               run diasize_change-width in this-procedure
     2279                 (input  integer(v-resize-value-str)
     2280                 ,input  true
     2281                 ) .
     2282               assign
     2283                 v-restore-saved = true
     2284               .
     2285             end.
     2286           end.
     2287           if v-restore-saved <> true
     2288           then do:
     2289             if v-diasize-wndmax = true
     2290             then do:
     2291               run diasize_maximize in this-procedure
     2292                 (input  true
     2293                 ) .
     2294             end.
     2295           end.
     2296         end.
     2297         else do:
     2298           if v-diasize-wndmax = true
     2299           then do:
     2300             run diasize_maximize in this-procedure
     2301               (input  true
     2302               ) .
     2303           end.
     2304         end.
     2305       end.
     2306     end.
     2307   end procedure.
     2308   procedure diasize_need-full-display :
     2309     define output parameter p-need-full-display as logical   no-undo .
     2310     do
     2311     on error undo, return error return-value
     2312     :
