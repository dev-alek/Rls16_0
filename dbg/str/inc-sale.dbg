     2321   procedure get-context :
     2322      define output parameter p-db-num as integer          no-undo.
     2323      define output parameter p-user-id as character        no-undo.
     2324      define variable v-login               as character    no-undo.
     2325      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2326      define buffer buf_user-login  for ub.user-login .
     2327      do
     2328      on error undo, return error
     2329      :
     2330            FIND FIRST buf_sys-ctrl no-lock.
     2331            ASSIGN
     2332               v-login = USERID("ub")
     2333               p-db-num = buf_sys-ctrl.db-num
     2334            .
     2335            FIND FIRST buf_user-login
     2336                 WHERE buf_user-login.db-num = p-db-num
     2337                   AND buf_user-login.user-login = v-login
     2338                 no-lock
     2339                 no-error
     2340                 .
     2341            IF AVAILABLE buf_user-login
     2342            THEN DO:
     2343               assign
     2344                  p-user-id = buf_user-login.user-id
     2345               .
     2346            END.
     2347      end.
     2348   end procedure.
     2349       run diasize_init in this-procedure .
     2350   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2351   procedure set-filter-name :
