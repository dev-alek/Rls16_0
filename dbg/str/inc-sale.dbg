     3770   nf-chk-amount
     3771   gds-amount
     3772   nf-gds-amount
     3773   line-out
     3774   dtl-out
     3775   line-ret
     3776   dtl-ret
     3777   WITH frame d-chk.
     3778   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3779     DISABLE
     3780     chk-doc.cashier
     3781     chk-doc.chk-num
     3782     chk-doc.sales-man
     3783     chk-doc.netto
     3784     chk-doc.doc-code
     3785     chk-doc.discnt
     3786     time_
     3787     chk-doc.sub-discnt
     3788     chk-doc.office
     3789     f-chk-type
     3790     chk-doc.tot-doc
     3791     chk-doc.pay-desk
     3792     WITH frame d-chk.
     3793     if  not cas-shft
     3794     then
     3795     HIDE
     3796     f-shift-num
     3797     f-shift-name
     3798     in frame d-chk.
     3799     HIDE b-doc
     3800     in frame d-chk.
     3801   end.
     3802   else do:
     3803     HIDE
     3804     rs-get-method
     3805     chk-doc.cashier
     3806     chk-doc.chk-num
     3807     chk-doc.sales-man
     3808     chk-doc.netto
     3809     chk-doc.doc-code
     3810     chk-doc.discnt
     3811     time_
     3812     chk-doc.sub-discnt
     3813     chk-doc.office
     3814     f-chk-type
     3815     chk-doc.tot-doc
     3816     chk-doc.pay-desk
     3817     in frame d-chk.
     3818   end.
     3819   END PROCEDURE.
     3820   PROCEDURE proc-b-sch :
     3821   assign
     3822     tbl = 'chk-doc'
     3823     join-tbl = 'X_chk-doc'
     3824     fld = ""
     3825     lab = ""
     3826     spr = ""
     3827     dim = '0'
     3828     .
     3829   run fltfield-add in this-procedure('doc-code', 'Номер в базе', '',
     3830   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3831   run fltfield-add in this-procedure('chk-date', '', '',
     3832   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3833   run fltfield-add in this-procedure('chk-time', '', 'time',
     3834   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3835   run fltfield-add in this-procedure('chk-type', 'Тип чека', 'receipt-code',
     3836   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3837   run fltfield-add in this-procedure('office', 'Т или у', 'gds-type',
     3838   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3839   run fltfield-add in this-procedure('shift-date', 'Смена от', '',
     3840   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3841   run fltfield-add in this-procedure('shift-num', 'Порядок смен', '',
     3842   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3843   run fltfield-add in this-procedure('shift-name', '№ смены', '',
     3844   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3845   run fltfield-add in this-procedure('chk-num', 'Номер по кассе', '',
     3846   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3847   run fltfield-add in this-procedure('pay-desk', '', '',
     3848   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3849   run fltfield-add in this-procedure('cashier', '', '',
     3850   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3851   run fltfield-add in this-procedure('sales-man', '', '',
     3852   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3853   run fltfield-add in this-procedure('tot-doc', '', '',
     3854   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3855   run fltfield-add in this-procedure('discnt', '', '',
     3856   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3857   run fltfield-add in this-procedure('sub-discnt', 'Списания', '',
     3858   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3859   run fltfield-add in this-procedure('netto', 'Нетто сумма (выручка)', '',
     3860   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3861   run fltfield-add in this-procedure('d-card', 'N дис.карты', '',
     3862   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3863   Filter-Block:
     3864   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3865       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3866       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3867     run gbl/filter.w ( input parparentproc
     3868                      , INPUT (filter-point + chr(4) + filter-label)
     3869                      , INPUT tbl
     3870                      , INPUT join-tbl
     3871                      , INPUT fld
     3872                      , INPUT lab
     3873                      , INPUT spr
     3874                      , INPUT dim ).
     3875     RUN set-filter IN THIS-PROCEDURE ( input YES) no-error.
     3876     if error-status:error then do:
     3877       undo filter-block, return error .
     3878     end.
     3879   END.
     3880   END PROCEDURE.
     3881   PROCEDURE proc-shift-name :
     3882   define variable v-dopi as integer no-undo .
     3883   assign
     3884   v-dopi = integer(f-shift-name:screen-value in frame d-chk )
     3885   no-error .
     3886   if error-status:error
     3887   or v-dopi <= 0
     3888   or v-dopi > 99 then do:
     3889     message "Неверный номер смены!" view-as alert-box ERROR.
     3890     return no-apply.
     3891   end.
     3892   END PROCEDURE.
     3893   PROCEDURE set-filter :
     3894   DEFINE INPUT PARAMETER p-on-off AS LOGICAL NO-UNDO.
     3895   define variable v-attr-value as character no-undo .
     3896   define variable v-deleted    as logical no-undo .
     3897   CASE p-on-off :
     3898       WHEN yes THEN DO:
     3899            run gbl/flt-get.p (
     3900              input filter-point
     3901             ,output v-filter-rec
     3902             ,output v-filter-name
     3903             ,output v-where-phrase
     3904             ,output v-sort-phrase
     3905             ,output v-where-phrase-rus
     3906             ,output v-sort-phrase-rus
     3907             ).
     3908         if v-filter-rec <> ? then do:
     3909           assign
     3910           ink-doc.sale-filter = v-where-phrase
     3911           ink-doc.sale-filter-name = v-filter-name
     3912           ink-doc.sale-filter-rus  = v-where-phrase-rus
     3913           .
     3914         end.
     3915         if ink-doc.is-mand-sale-filter then do:
     3916           run check-filter in this-procedure no-error .
     3917           if error-status:error then undo, return error .
     3918           if v-filter-rec <> ? then do:
     3919             assign
     3920             ink-doc.sale-filter = v-where-phrase
     3921             ink-doc.sale-filter-name = v-filter-name
     3922             ink-doc.sale-filter-rus = v-where-phrase-rus
     3923             .
     3924           end.
     3925           else do:
     3926             assign
     3927             ink-doc.sale-filter = ?
     3928             ink-doc.sale-filter-name = ?
     3929             ink-doc.sale-filter-rus = ?
     3930             .
     3931             assign
     3932             v-where-phrase = "":U
     3933             .
     3934           end.
     3935         end.
     3936       END.
     3937       WHEN no THEN DO:
     3938         ASSIGN
     3939         v-filter-rec = ?
     3940         v-filter-name = "":U
     3941         v-where-phrase = "":U
     3942         v-sort-phrase = "":U
     3943         v-where-phrase-rus = "":U
     3944         v-sort-phrase-rus = "":U
     3945         .
     3946         if ink-doc.is-mand-sale-filter then do:
     3947           assign
     3948           ink-doc.sale-filter = ?
     3949           ink-doc.sale-filter-name = ?
     3950           ink-doc.sale-filter-rus = ?
     3951           .
     3952         end.
     3953       END.
     3954   END CASE.
     3955     assign
     3956     frame d-chk:title = title0.
     3957     if v-filter-rec <> ? then
     3958     RUN Set-filter-name IN THIS-PROCEDURE ( input v-filter-name).
     3959     else do:
     3960       RUN Set-filter-name IN THIS-PROCEDURE ( input "":U).
     3961     end.
     3962   END PROCEDURE.
