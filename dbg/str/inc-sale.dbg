     3713   chk-doc.doc-code
     3714   chk-doc.sales-man
     3715   curs-mes
     3716   rs-get-method when (p-mode= 'ИЗМЕНЕНИЕ':U  and (ink-doc.is-mand-sale-filter = no  or not can-find(first ub.chk-doc no-lock where ub.chk-doc.out-code = ink-doc.inkas-code)))
     3717   br-saledoc
     3718   tt-trn-doc.wrkr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3719   tt-trn-doc.agnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3720   tt-trn-doc.boss WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3721   r-wrkr WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3722   r-agnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3723   r-boss WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     3724   WITH FRAME d-chk .
     3725   if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     3726     hide
     3727     b-exit in frame d-chk .
     3728   end.
     3729   OPEN QUERY br-saledoc FOR EACH buf_sale-doc WHERE buf_sale-doc.inkas-code = ink-doc.inkas-code.
     3730   OPEN QUERY br-saledoc FOR EACH buf_sale-doc WHERE buf_sale-doc.inkas-code = ink-doc.inkas-code.
     3731   assign
     3732   f-Shift-name = if cas-shft or p-mode = 'ПРОСМОТР':U then ink-doc.shift-name else '':U
     3733   f-Shift-num = if cas-shft or p-mode = 'ПРОСМОТР':U then ink-doc.shift-num else 0
     3734   .
     3735   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3736     if ink-doc.is-mand-sale-filter
     3737     and (ink-doc.sale-filter  <> '':U
     3738         or
     3739         ink-doc.sale-filter  <> ?)
     3740         then do:
     3741       RUN Set-filter-name IN THIS-PROCEDURE ( input v-filter-name).
     3742     end.
     3743     else if not can-find(first chk-doc no-lock where chk-doc.out-code = ink-doc.inkas-code) and not ink-doc.is-mand-sale-filter then do:
     3744       run gbl/flt-get.p (
     3745       input filter-point
     3746       ,output v-filter-rec
     3747       ,output v-filter-name
     3748       ,output v-where-phrase
     3749       ,output v-sort-phrase
     3750       ,output v-where-phrase-rus
     3751       ,output v-sort-phrase-rus
     3752       ).
     3753       RUN Set-filter-name IN THIS-PROCEDURE ( input v-filter-name).
     3754     end.
     3755     if l-shift-on OR can-find( FIRST chk-doc WHERE chk-doc.out-code = ink-doc.inkas-code )  then  do:
     3756       DISABLE
     3757       chk-doc.shift-date
     3758       f-shift-num
     3759       f-shift-name
     3760       with frame d-chk.
     3761     end.
     3762   end.
     3763   DISPLAY
     3764   f-shift-num when (cas-shft or (p-mode = 'ПРОСМОТР':U and ink-doc.shift-num <> 0))
     3765   f-shift-name when (cas-shft or (p-mode = 'ПРОСМОТР':U and ink-doc.shift-name <> ''))
     3766   ink-doc.doc-date @ chk-doc.shift-date
     3767   with frame d-chk.
