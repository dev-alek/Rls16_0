     3693   chk-amount
     3694   nf-chk-amount
     3695   B-sch when (p-mode= 'ИЗМЕНЕНИЕ':U and not ink-doc.is-mand-sale-filter or NOT can-find( FIRST ub.chk-doc WHERE ub.chk-doc.out-code = ink-doc.inkas-code ))
     3696   dtl-ret
     3697   gds-amount
     3698   nf-gds-amount
     3699   time_
     3700   chk-doc.netto
