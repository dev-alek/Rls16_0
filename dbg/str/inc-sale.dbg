     3705   line-out
     3706   ub.chk-doc.pay-desk
     3707   dtl-out
     3708   ub.chk-doc.cashier
     3709   line-ret
     3710   chk-doc.chk-num
     3711   b-exit when p-mode = 'ИЗМЕНЕНИЕ':U
