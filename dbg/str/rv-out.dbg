      356   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   function octal-to-char return character
      358   ( p-string as character ) :
      359     def var v-asc     as integer no-undo .
      360     def var v-new-asc as integer no-undo .
      361     def var ind       as integer no-undo .
      362     if length(p-string) <> 3 then do:
      363       return ? .
      364     end.
      365     assign
      366       v-asc = 0
      367     .
      368     do ind = 1 to length(p-string)
      369     :
      370       assign
      371         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      372       .
      373       if v-new-asc < 0 or v-new-asc >= 8 then do:
      374         return ? .
      375       end.
      376       assign
      377         v-asc = v-asc * 8 + v-new-asc
      378       .
      379     end.
      380     return chr(v-asc) .
      381   end function .
      382   function char-to-octal return character
      383   ( p-chr as character ) :
      384     def var v-asc    as integer   no-undo .
      385     def var ind      as integer   no-undo .
      386     def var v-string as character no-undo .
      387     if length(p-chr) <> 1 then do:
      388       return ? .
      389     end.
      390     assign
      391       v-asc    = asc(p-chr)
      392       v-string = ""
      393     .
      394     do ind = 1 to 3
      395     :
      396       assign
      397         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      398       .
      399       assign
      400         v-asc = truncate(v-asc / 8, 0)
      401       .
      402     end.
      403     return v-string .
      404   end.
      405   function str-encode return character
      406   (   p-init-string       as character
      407     , p-encode-char       as character
      408     , p-special-char-list as character
      409   ) :
      410     def var p-encode-string as character no-undo .
      411     def var ind                as integer no-undo .
      412     def var v-num-special-char as integer no-undo .
      413     def var v-special-char     as character no-undo .
      414     if p-encode-char = ?
      415     or p-encode-char = "" then do:
      416       assign
      417         p-encode-char = "~~"
      418       .
      419     end.
      420     if p-init-string = ? then do:
      421       return "?" .
      422     end.
      423     if p-init-string = "?" then do:
      424       return p-encode-char + char-to-octal("?") .
      425     end.
      426     assign
      427       v-num-special-char = length(p-special-char-list)
      428       p-encode-string    = replace(p-init-string
      429                                   ,p-encode-char
      430                                   ,p-encode-char + char-to-octal(p-encode-char)
      431                                   )
      432     .
      433     do ind = 1 to v-num-special-char
      434     :
      435       assign
      436         v-special-char = substring(p-special-char-list, ind, 1)
      437       .
      438       if v-special-char <> p-encode-char then do:
      439         assign
      440           p-encode-string = replace (p-encode-string
      441                                     ,v-special-char
      442                                     ,p-encode-char + char-to-octal(v-special-char)
      443                                     )
      444         .
      445       end.
      446     end.
      447     return p-encode-string .
      448   end.
      449   function str-decode returns character
      450     (p-init-string   as character
      451     ,p-encode-char   as character
      452     ) :
      453     def var p-decode-string as character no-undo .
      454     def var ind                       as integer no-undo .
      455     def var v-num-entries-init-string as integer no-undo .
      456     def var v-sub-phrase              as character no-undo .
      457     def var v-special-char            as character no-undo .
      458     if p-encode-char = ?
      459     or p-encode-char = "" then do:
      460       assign
      461         p-encode-char = "~~"
      462       .
      463     end.
      464     if p-init-string = "?" then do:
      465       return ? .
      466     end.
      467     assign
      468       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      469     .
      470     if v-num-entries-init-string > 1 then do:
      471       assign
      472         p-decode-string = entry(1, p-init-string, p-encode-char)
      473       .
      474       do ind = 2 to v-num-entries-init-string
      475       :
      476         assign
      477           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      478         .
      479         assign
      480           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      481         .
      482         if v-special-char <> ? then do:
      483           assign
      484             p-decode-string = p-decode-string
      485                             + v-special-char
      486                             + substring(v-sub-phrase, 4)
      487           .
      488         end.
      489         else do:
      490           assign
      491             p-decode-string = p-decode-string
      492                             + p-encode-char
      493                             + v-sub-phrase
      494           .
      495         end.
      496       end.
      497     end.
      498     else do:
      499       assign
      500         p-decode-string = p-init-string
      501       .
      502     end.
      503     return p-decode-string .
      504   end.
      505   define variable chg-qnty       like ub.gds-dtl.doc-qnty no-undo.
      506   define variable v-today        as   date             no-undo.
      507   define variable varconf-attr   as   character        no-undo.
      508   define variable varpar-type    as   character        no-undo.
      509   define variable v-is-parts as logical   no-undo .
      510   define buffer t-doc for ub.trn-doc.
      511   define buffer n-d for ub.trn-doc.
      512   define buffer n-l for ub.doc-line.
      513   define buffer n-g for ub.gds-dtl.
      514   define buffer buf_bar-code for ub.bar-code  .
      515   if v-cntxt-db-num <> v-cntxt-db-num-obj then do:
      516     message "На пассивной стороне резервирование невозможно.".
      517     return error.
      518   end.
      519   find t-doc where t-doc.doc-code = p-trn-code.
      520   if not (can-do ('спи,возврат':U, t-doc.doc-type) and not t-doc.internal or t-doc.doc-type = 'рас':U) then do:
      521     message "Документ №" t-doc.doc-code skip
      522                     "По документу данного типа резервирование невозможно.".
      523     return error.
      524   end.
      525   if t-doc.status_ <> 'запрос':U then do:
      526     message "Документ №" t-doc.doc-code skip
      527                     "По документу с данным статусом резервирование невозможно.".
      528     return error.
      529   end.
      530   req1:
      531   do on stop undo req1, return error on error undo req1, return error :
      532     assign
      533       t-doc.status_ = 'накл':U
      534       t-doc.flag_ = no.
      535     create n-d.
      536   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      538     (input  v-cntxt-obj-type
      539     ,input  v-cntxt-obj-code
      540     ,output v-today
      541     )  .
      542     run doc-code in this-procedure
      543     (input  "chip",
      544      input  v-cntxt-obj-type,
      545      input  v-cntxt-obj-code,
      546      input  t-doc.doc-code,
      547      output n-d.doc-code ) no-error.
      548     if error-status:error then do:
      549       message "Ошибка при генерации номера документа." return-value
      550       view-as alert-box error.
      551       undo req1, return error.
      552     end.
      553     buffer-copy t-doc except doc-code acc-date creid to n-d
      554     assign
      555       n-d.status_    = 'запрос':U
      556       n-d.flag_      = no
      557       n-d.rsrv-date  = today + v-cntxp-rsrv-time
      558       n-d.doc-qnty   = 0
      559       n-d.fact-base  = 0
      560       n-d.fact-num   = 0
      561       n-d.fact-qnty  = 0
      562       n-d.fact-rubl  = 0
      563       n-d.tot-cli    = 0
      564       n-d.tot-doc    = 0
      565       n-d.tot-fact   = 0
      566       n-d.tot-ov     = 0
      567       n-d.tot-rubl   = 0
      568       n-d.tot-sale   = 0
      569       n-d.PS = "@  Остаток от резервирования по документу : " + t-doc.doc-code + chr (10) +
      570                     "Для расчета итогов по документу нажмите Измен.".
      571     for each ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code
      572          on stop undo req1, return error on error undo req1, return error :
      573       create n-l.
      574       buffer-copy ub.doc-line to n-l
      575       assign
      576         n-l.doc-code  = n-d.doc-code
      577         n-l.doc-qnty  = 0
      578         n-l.cli-qnty  = 0
      579         n-l.fact-qnty = 0
      580         .
      581       find ub.goods where ub.goods.artic         = ub.doc-line.artic
      582                         and ub.goods.prod-type = ub.doc-line.prod-type
      583                         and ub.goods.prod-code = ub.doc-line.prod-code no-lock.
      584       for each ub.gds-dtl where ub.gds-dtl.doc-code  = t-doc.doc-code
      585                          and ub.gds-dtl.prod-code = ub.doc-line.prod-code
      586                          and ub.gds-dtl.prod-type = ub.doc-line.prod-type
      587                          and ub.gds-dtl.artic     = ub.doc-line.artic
      588            on stop undo req1, return error on error undo req1, return error :
      589   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
      591     ( input recid(gds-dtl)
      592     , input no
      593     , input ?
      594     ) no-error.
      595         if error-status:error then do:
      596            undo req1, return error return-value .
      597         end.
      598         if ub.gds-dtl.price-base = ? or ub.gds-dtl.price-base = 0  THEN DO:
      599             FIND FIRST ub.gds-prt WHERE ub.gds-prt.node-code = ub.gds-dtl.prt-code NO-LOCK.
      600             FIND FIRST ub.goods WHERE ub.goods.artic = ub.gds-dtl.artic
      601                                AND ub.goods.prod-code = ub.gds-dtl.prod-code
      602                                AND ub.goods.prod-type = ub.gds-dtl.prod-type NO-LOCK.
      603             FIND FIRST ub.bar-code WHERE ub.bar-code.gds-code  = ub.goods.gds-code
      604                                   AND ub.bar-code.node-code = ub.gds-dtl.prt-code
      605                                   AND ub.bar-code.part-code = ''
      606                                   AND ub.bar-code.in-code   = ''
      607                                   AND ub.bar-code.unit-cli  = ub.goods.unit-base NO-LOCK.
      608            MESSAGE "Не определена валютная цена товара:" ub.gds-dtl.artic " " (if ub.gds-prt.node-name <> '_Пустая шкала':U and ub.gds-prt.upper-code <> ub.goods.prt-root then ub.goods.gds-name + ' - ' + ub.gds-prt.f-name else ub.goods.gds-name) "." SKIP
      609                    "Бар-код:" ub.bar-code.b-code
      610                     VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      611               undo req1, return ERROR "Не определена валютная цена товара".
      612         END.
      613         if ub.gds-dtl.price-rubl = ? or ub.gds-dtl.price-rubl = 0 THEN DO:
      614             FIND FIRST ub.gds-prt WHERE ub.gds-prt.node-code = ub.gds-dtl.prt-code NO-LOCK.
      615             FIND FIRST ub.goods WHERE ub.goods.artic = ub.gds-dtl.artic
      616                                AND ub.goods.prod-code = ub.gds-dtl.prod-code
      617                                AND ub.goods.prod-type = ub.gds-dtl.prod-type NO-LOCK.
      618             FIND FIRST ub.bar-code WHERE ub.bar-code.gds-code  = ub.goods.gds-code
      619                               AND ub.bar-code.node-code = ub.gds-dtl.prt-code
      620                               AND ub.bar-code.part-code = ''
      621                               AND ub.bar-code.in-code   = ''
      622                               AND ub.bar-code.unit-cli  = ub.goods.unit-base NO-LOCK.
      623            MESSAGE "Не определена рублевая цена товара:" ub.gds-dtl.artic " " (if ub.gds-prt.node-name <> '_Пустая шкала':U and ub.gds-prt.upper-code <> ub.goods.prt-root then ub.goods.gds-name + ' - ' + ub.gds-prt.f-name else ub.goods.gds-name) "." SKIP
      624                    "Бар-код:" ub.bar-code.b-code
      625               VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      626               undo req1, return ERROR "Не определена рублевая цена товара".
      627         END.
      628         accumulate ub.gds-dtl.doc-qnty (total).
      629         assign
      630           chg-qnty = ub.gds-dtl.doc-qnty
      631           .
      632         v-is-parts = false .
      633         define variable v-sumq as decimal   no-undo .
      634         define buffer free_parts for ub.parts  .
      635         v-sumq = 0.
      636         for each ub.doc-prts no-lock where
      637                  ub.doc-prts.out-code  = p-trn-code and
      638                  ub.doc-prts.gds-code  = ub.goods.gds-code ,
      639         first buf_bar-code no-lock where
      640                    buf_bar-code.b-code = ub.doc-prts.b-code ,
      641         first free_parts no-lock where
      642                    free_parts.obj-type  = t-doc.obj-type and
      643                    free_parts.obj-code  = t-doc.obj-code and
      644                    free_parts.artic     = ub.goods.artic and
      645                    free_parts.prod-type = ub.goods.prod-type and
      646                    free_parts.prod-code = ub.goods.prod-code and
      647                    free_parts.in-code   = buf_bar-code.in-code  and
      648                    free_parts.out-code  = 'free-zone':U  and
      649                    free_parts.part-code = buf_bar-code.part-code :
      650         v-is-parts = true  .
      651         chg-qnty = free_parts.qnty .
      652         run trg/rsrv-dtl.p (
      653             input parparentproc,
      654             ( 'reserv':U
      655                 + ",":U + 'rsrv-single-part':U
      656                 + ",":U + 'rsrv-in-code':U   + "=":U + str-encode ( buf_bar-code.in-code  ,  "", ",=":U )
      657                 + ",":U + 'rsrv-part-code':U + "=":U + str-encode ( buf_bar-code.part-code,  "", ",=":U )
      658                 + ( if p-mess-neg then "" else
      659                     ",":U + 'negative-check':U + "=1":U )
      660             ),
      661             buffer ub.gds-dtl,
      662             input-output chg-qnty,
      663             input-output ub.doc-line.price-base,
      664             input-output ub.doc-line.price-rubl,
      665             -1, "")
      666             no-error.
      667             v-sumq = v-sumq + chg-qnty .
      668             for each ub.parts exclusive-lock where
      669                    ( ub.parts.out-code     = t-doc.doc-code and
      670                      ub.parts.obj-type     = t-doc.obj-type and
      671                      ub.parts.obj-code     = t-doc.obj-code and
      672                      ub.parts.artic        = ub.gds-dtl.artic and
      673                      ub.parts.prod-type    = ub.gds-dtl.prod-type and
      674                      ub.parts.prod-code    = ub.gds-dtl.prod-code and
      675                      ub.parts.in-code      = buf_bar-code.in-code  and
      676                      ub.parts.part-code    = buf_bar-code.part-code ) or
      677                    ( ub.parts.out-code     = 'out-zone':U and
      678                      ub.parts.obj-type     = t-doc.obj-type and
      679                      ub.parts.obj-code     = t-doc.obj-code and
      680                      ub.parts.artic        = ub.gds-dtl.artic and
      681                      ub.parts.prod-type    = ub.gds-dtl.prod-type and
      682                      ub.parts.prod-code    = ub.gds-dtl.prod-code and
      683                      ub.parts.in-code      = buf_bar-code.in-code  and
      684                      ub.parts.part-code    = buf_bar-code.part-code )
      685                      :
      686                     if ub.parts.defect <> ub.doc-prts.defect then do:
      687                         assign
      688                           ub.parts.defect = ub.doc-prts.defect
      689                         .
      690                     end.
      691            end.
      692            chg-qnty = v-sumq .
      693          end.
      694         if v-is-parts = false  then do:
      695         run trg/rsrv-dtl.p (
      696             input parparentproc,
      697             'reserv':U
      698           + ( if p-mess-neg then "" else
      699               ",":U + 'negative-check':U + "=1":U )
      700             ,
      701             buffer ub.gds-dtl,
      702             input-output chg-qnty,
      703             input-output ub.doc-line.price-base,
      704             input-output ub.doc-line.price-rubl,
      705             -1, "")
      706             no-error.
      707         end.
      708         if error-status:error then do:
      709           undo req1, return error substitute("При резервировании из rsrv-dtl.p: &1 &2" , return-value , error-status :get-message(1)  ) .
      710         end.
      711         assign
      712           chg-qnty = ub.gds-dtl.doc-qnty  - chg-qnty.
      713         assign
      714           ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty - chg-qnty
      715           ub.gds-dtl.doc-qnty   = ub.gds-dtl.doc-qnty  - chg-qnty
      716           ub.gds-dtl.fact-qnty  = ub.gds-dtl.doc-qnty
      717           ub.doc-line.fact-qnty = ub.doc-line.doc-qnty.
      718         accumulate ub.gds-dtl.fact-qnty (total).
      719         if chg-qnty <> 0 then do:
      720           create n-g.
      721           buffer-copy ub.gds-dtl to n-g
      722           assign
      723             n-g.doc-code = n-d.doc-code
      724             n-g.doc-qnty = chg-qnty
      725             n-g.fact-qnty = n-g.doc-qnty.
      726           assign
      727             n-l.doc-qnty  = n-l.doc-qnty + n-g.doc-qnty
      728             n-l.fact-qnty  = n-l.doc-qnty
      729             n-d.doc-qnty = n-d.doc-qnty + n-g.doc-qnty
      730             n-d.fact-qnty = n-d.doc-qnty
      731             t-doc.doc-qnty = t-doc.doc-qnty - n-g.doc-qnty.
      732         end.
      733         if ub.gds-dtl.doc-qnty = 0 then delete ub.gds-dtl.
      734       end.
      735     end.
      736     if p-null <> true then do:
      737         if (accum total ub.gds-dtl.fact-qnty) = 0 then do:
      738           message "Документ :" t-doc.doc-code skip (2)
      739                           "НЕ УДАЛОСЬ зарезервировать ничего !".
      740           undo req1, return error.
      741         end.
      742     end.
      743     if (accum total ub.gds-dtl.doc-qnty) <> (accum total ub.gds-dtl.fact-qnty) then do:
      744   define variable v-mess as character no-undo .
      745   define variable v-is-rt as logical   no-undo .
      746   define variable v-uh as handle no-undo .
      747     v-mess  =  substitute("Документ : &2&1&1 НЕ ВСЕ количество УДАЛОСЬ зарезервировать ! &1&1 Было количество в запросе : &3&1 Удалось зарезервировать : &4 &1 &1  Остальное помещено в новый запрос : &5 " ,
      748              chr(10)  ,
      749              t-doc.doc-code ,
      750              (accum total ub.gds-dtl.doc-qnty) ,
      751              (accum total ub.gds-dtl.fact-qnty) ,
      752              n-d.doc-code )
      753               .
      754     assign
      755     v-uh = this-procedure:instantiating-procedure
      756     v-is-rt = false
      757     .
      758     do while valid-handle(v-uh):
      759       if lookup("w-reqsrv_print-log", v-uh:internal-entries) > 0 then do:
      760         v-is-rt = true .
      761         run cb-for-struct-i in v-uh ( input v-mess ) no-error.
      762         leave.
      763       end.
      764       v-uh = v-uh:instantiating-procedure.
      765     end.
      766     if v-is-rt = false then do:
      767        message v-mess view-as alert-box information .
      768     end.
      769       if substr (t-doc.PS, 1, 1) = "@" then
      770         t-doc.PS = "@  ЧАСТИЧНОЕ резервирование по запросу.  Остаток - в новом запросе : " + n-d.doc-code.
      771       n-d.out-code = t-doc.doc-code.
      772       run cus/oo-mkrcv.p (
      773            buffer t-doc ,
      774            buffer n-d  )
      775           no-error .
      776           if error-status:error then do:
      777             undo req1, return error.
      778           end.
      779     end.
      780     else delete n-d.
      781   end.
