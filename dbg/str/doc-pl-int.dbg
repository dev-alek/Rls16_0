     1642        ,input loc-t-doc-pl.cli-fact-qnty    - (if available buf-upd_tt-doc-pl then buf-upd_tt-doc-pl.cli-fact-qnty    else 0.0 )
     1643        ,input loc-t-doc-pl.rest-af-qnty     - (if available buf-upd_tt-doc-pl then buf-upd_tt-doc-pl.rest-af-qnty     else 0.0 )
