     1684   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-doc-pl:PARENT eq ?
     1685   THEN FRAME f-doc-pl:PARENT = ACTIVE-WINDOW.
     1686   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
