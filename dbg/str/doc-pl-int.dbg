      942     end.
      943     if loc-t-doc-pl.doc-qnty :sensitive = true then do:
      944       assign
      945         loc-t-doc-pl.doc-qnty = loc-t-doc-pl.doc-qnty + f-doc-line-doc-qnty - f-tot-doc-pl-doc-qnty
      946       .
      947       display
      948         loc-t-doc-pl.doc-qnty
      949         with frame f-doc-pl.
      950       apply "leave" to loc-t-doc-pl.doc-qnty in frame f-doc-pl .
      951     end.
      952     if loc-t-doc-pl.cli-fact-qnty :sensitive = true then do:
      953       assign
      954         loc-t-doc-pl.cli-fact-qnty = loc-t-doc-pl.cli-fact-qnty + f-doc-line-cli-fact-qnty - f-tot-doc-pl-cli-fact-qnty
      955       .
