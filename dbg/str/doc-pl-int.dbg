     1701   run minbtn-set in this-procedure .
     1702   on choose of b-help in frame f-doc-pl
     1703   do:
     1704     apply "help":u to frame f-doc-pl .
     1705   end.
     1706   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1707   procedure minbtn-set :
     1708       do
     1709           on error undo, return error return-value
     1710           :
     1711           define variable ii              as integer       no-undo .
     1712           define variable fh              as widget-handle no-undo .
     1713           define variable hh              as widget-handle no-undo .
     1714           define variable v-h             as handle        extent 4 no-undo .
     1715           define variable v-name-button   as character     no-undo .
     1716           define variable v-help-old-x    as decimal       no-undo .
     1717           define variable v-help-old-y    as decimal       no-undo .
     1718           define variable v-help-old-size as decimal       no-undo .
     1719           define variable v-frame-width   as decimal       no-undo .
     1720           define variable jj              as integer       no-undo .
     1721           do
     1722               on error undo, return error
     1723               :
     1724               assign
     1725                   v-frame-width = frame f-doc-pl:width - 0.3
     1726                   fh            = frame f-doc-pl:first-child
     1727                   hh            = fh:first-child
     1728                   ii            = 1
     1729                   .
     1730               do while valid-handle(hh):
     1731                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1732                   do:
     1733                       case lc(hh:name) :
     1734                           when "b-help" then
     1735                               do:
     1736                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1737                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1738                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1739                                   hh:TOOLTIP = "Помощь" .
     1740                                   v-help-old-x = hh:column .
     1741                                   v-help-old-y = hh:row    .
     1742                                   v-help-old-size = hh:width .
     1743                                   hh:width-chars = 2.5 .
     1744                               end.
     1745                           when "b-print" then
     1746                               do:
     1747                                   hh:load-image("cmp/b-print.bmp":u) .
     1748                                   hh:TOOLTIP = "Печать" .
     1749                                   v-h[ii] = hh:handle .
     1750                                   ii = ii + 1 .
     1751                                   hh:width-chars = 3 .
     1752                               end.
     1753                           when "b-history" or
     1754                           when "b-hist" then
     1755                               do:
     1756                                   hh:load-image("cmp/b-hist.bmp":u) .
     1757                                   hh:TOOLTIP = "История" .
     1758                                   v-h[ii] = hh:handle .
     1759                                   ii = ii + 1 .
     1760                                   hh:width-chars = 3 .
     1761                               end.
     1762                           when "b-sch" then
     1763                               do:
     1764                                   hh:load-image("cmp/b-sch.bmp":u) .
     1765                                   hh:TOOLTIP = "Установка Фильтра" .
     1766                                   v-h[ii] = hh:handle .
     1767                                   ii = ii + 1 .
     1768                                   hh:width-chars = 3 .
     1769                               end.
     1770                           when "b-hist-user" then
     1771                               do:
     1772                                   hh:load-image("cmp/b-hist.bmp":u) .
     1773                                   hh:TOOLTIP = "История пользователя" .
     1774                                   ii = ii + 1 .
     1775                               end.
     1776                       end case.
     1777                   end.
     1778                   hh = hh:next-sibling.
     1779               end.
     1780               b-help:column = v-frame-width - b-help:width-chars.
     1781               jj = 0.
     1782               repeat ii = 4 to 1 by -1 :
     1783                   if valid-handle (v-h[ii] ) then
     1784                   do:
     1785                       jj  = jj + 1 .
     1786                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1787                       v-h[ii]:row    = v-help-old-y .
     1788                   end.
     1789               end.
     1790           end.
     1791       end.
     1792   end procedure.
     1793   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1794     procedure disp-total :
     1795       define input  parameter p-add-cli-qnty         like ub.doc-pl.cli-qnty         no-undo .
     1796       define input  parameter p-add-doc-qnty         like ub.doc-pl.doc-qnty         no-undo .
