       53   define input  parameter p-pl-code                   like ub.doc-pl.pl-code          no-undo .
       54   define input  parameter p-pl-code2                  like ub.doc-pl.pl-code          no-undo .
       55   define input  parameter p-doc-line-unit-cli         like ub.doc-line.unit-cli       no-undo .
       56   define input  parameter p-doc-line-cli-base-rate    like ub.doc-line.cli-base-rate  no-undo .
