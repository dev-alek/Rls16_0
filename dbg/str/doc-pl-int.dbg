     1533                                               ,buf_goods.gds-code
     1534                                               ,buf_trn-doc.doc-code
     1535                                               ,buf-obj_clients.obj-type
     1536                                               ,buf-obj_clients.obj-code
     1537                                               ,p-mode
     1538                                               )
     1539     .
