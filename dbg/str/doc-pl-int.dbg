     1427   ON LEAVE OF loc-t-doc-pl.pl-code IN FRAME f-doc-pl
     1428   or return of loc-t-doc-pl.pl-code in frame f-doc-pl
     1429   DO:
     1430     define buffer buf_pl-gds for ub.pl-gds .
     1431     define buffer buf-old_parts  for ub.parts .
     1432     define buffer buf-new_parts  for ub.parts .
     1433     if input frame f-doc-pl loc-t-doc-pl.pl-code = ?
     1434       or input frame f-doc-pl loc-t-doc-pl.pl-code = 0
     1435     then do:
     1436       message
     1437         "Необходимо указать место хранения!"
     1438         view-as alert-box information.
     1439       return no-apply .
     1440     end.
     1441     if input frame f-doc-pl loc-t-doc-pl.pl-code <> loc-t-doc-pl.pl-code then do:
     1442       find first buf_pl-gds no-lock
     1443         where buf_pl-gds.obj-type = buf_trn-doc.obj-type
     1444           and buf_pl-gds.obj-code = buf_trn-doc.obj-code
     1445           and buf_pl-gds.pl-code  = input frame f-doc-pl loc-t-doc-pl.pl-code
     1446           and buf_pl-gds.gds-code = p-gds-code
     1447         no-error .
     1448       if not available buf_pl-gds then do:
     1449         apply "choose" to b-place in frame f-doc-pl .
     1450         return no-apply .
     1451       end.
     1452       else do:
     1453         find first tt-doc-pl no-lock
     1454           where tt-doc-pl.obj-type = buf_trn-doc.obj-type
     1455             and tt-doc-pl.obj-code = buf_trn-doc.obj-code
     1456             and tt-doc-pl.pl-code  = buf_pl-gds.pl-code
     1457             and tt-doc-pl.out-code = buf_trn-doc.doc-code
     1458             and tt-doc-pl.gds-code = buf_pl-gds.gds-code
     1459           no-error .
     1460         if available tt-doc-pl then do:
     1461           if not available buf-upd_tt-doc-pl
     1462             or ( available buf-upd_tt-doc-pl
     1463                  and buf-upd_tt-doc-pl.pl-code <> buf_pl-gds.pl-code
     1464                )
     1465           then do:
     1466             assign
     1467               loc-t-doc-pl.pl-code :screen-value = string( loc-t-doc-pl.pl-code, loc-t-doc-pl.pl-code :format )
     1468             .
     1469             message
     1470               substitute( "Строка по месту хранения &1 уже существует.", buf_pl-gds.pl-code ) skip
     1471               view-as alert-box information .
     1472             return no-apply .
     1473           end.
     1474         end.
     1475         if buf_trn-doc.doc-type = 'при':U then do:
     1476           for each buf-old_parts
     1477             where buf-old_parts.obj-type  = buf_trn-doc.obj-type
     1478               and buf-old_parts.obj-code  = buf_trn-doc.obj-code
     1479               and buf-old_parts.artic     = buf_goods.artic
     1480               and buf-old_parts.prod-type = buf_goods.prod-type
     1481               and buf-old_parts.prod-code = buf_goods.prod-code
     1482               and buf-old_parts.in-code   = buf_trn-doc.doc-code
     1483               and buf-old_parts.out-code  = buf_trn-doc.doc-code
     1484           on error undo, return no-apply
     1485           :
     1486             if buf-old_parts.pl-code = loc-t-doc-pl.pl-code then do:
     1487               find first buf-new_parts
     1488                 where buf-new_parts.obj-type  = buf_trn-doc.obj-type
     1489                   and buf-new_parts.obj-code  = buf_trn-doc.obj-code
     1490                   and buf-new_parts.artic     = buf_goods.artic
     1491                   and buf-new_parts.prod-type = buf_goods.prod-type
     1492                   and buf-new_parts.prod-code = buf_goods.prod-code
     1493                   and buf-new_parts.in-code   = buf_trn-doc.doc-code
     1494                   and buf-new_parts.out-code  = buf_trn-doc.doc-code
     1495                   and buf-new_parts.part-code = string( buf_pl-gds.pl-code )
     1496                 no-error .
     1497               if available buf-new_parts then do:
     1498                 assign
     1499                   buf-new_parts.pl-code   = buf-old_parts.pl-code
     1500                   buf-new_parts.part-code = buf-old_parts.part-code
     1501                 .
     1502               end.
     1503               assign
     1504                 buf-old_parts.pl-code   = buf_pl-gds.pl-code
     1505                 buf-old_parts.part-code = string( buf_pl-gds.pl-code )
     1506               .
     1507             end.
     1508           end.
     1509         end.
     1510         assign
     1511           loc-t-doc-pl.pl-code
     1512         .
     1513         if loc-t-doc-pl.cli-doc-qnty :sensitive = true then do:
     1514           apply "leave" to loc-t-doc-pl.cli-doc-qnty in frame f-doc-pl .
     1515         end.
     1516         if loc-t-doc-pl.doc-qnty :sensitive = true then do:
     1517           apply "leave" to loc-t-doc-pl.doc-qnty in frame f-doc-pl .
     1518         end.
     1519         if loc-t-doc-pl.cli-fact-qnty :sensitive = true then do:
     1520           apply "leave" to loc-t-doc-pl.cli-fact-qnty in frame f-doc-pl .
     1521         end.
     1522         if loc-t-doc-pl.fact-qnty :sensitive = true then do:
