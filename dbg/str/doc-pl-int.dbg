     2227       else do:
     2228         assign
     2229           loc-t-doc-pl.pl-code = p-pl-code
     2230         .
     2231       end.
     2232       if p-pl-code2 = ?
     2233         or p-pl-code2 = 0
     2234       then do:
     2235         assign
     2236           loc-t-doc-pl.pl-code2 = ?
     2237         .
     2238       end.
     2239       else do:
     2240         assign
     2241           loc-t-doc-pl.pl-code2 = p-pl-code2
     2242         .
     2243       end.
     2244       assign
     2245         loc-t-doc-pl.cli-qnty         = p-doc-line-cli-qnty
     2246         loc-t-doc-pl.cli-doc-qnty     = p-doc-line-doc-cli-qnty
     2247         loc-t-doc-pl.doc-qnty         = p-doc-line-doc-qnty
     2248         loc-t-doc-pl.cli-fact-qnty    = p-doc-line-fact-cli-qnty
     2249         loc-t-doc-pl.fact-qnty        = p-doc-line-fact-qnty
     2250         loc-t-doc-pl.rest-af-qnty     = p-doc-line-rest-af-qnty
     2251         loc-t-doc-pl.cli-rest-af-qnty = p-doc-line-cli-rest-af-qnty
     2252       .
     2253       for each buf_tt-doc-pl no-lock
     2254         where buf_tt-doc-pl.obj-type = buf_trn-doc.obj-type
     2255           and buf_tt-doc-pl.obj-code = buf_trn-doc.obj-code
     2256           and buf_tt-doc-pl.out-code = buf_trn-doc.doc-code
     2257           and buf_tt-doc-pl.gds-code = p-gds-code
     2258       on error undo, return error return-value
     2259       :
     2260         assign
     2261           loc-t-doc-pl.cli-qnty         = loc-t-doc-pl.cli-qnty         - buf_tt-doc-pl.cli-qnty
     2262           loc-t-doc-pl.cli-doc-qnty     = loc-t-doc-pl.cli-doc-qnty     - buf_tt-doc-pl.cli-doc-qnty
     2263           loc-t-doc-pl.doc-qnty         = loc-t-doc-pl.doc-qnty         - buf_tt-doc-pl.doc-qnty
     2264           loc-t-doc-pl.cli-fact-qnty    = loc-t-doc-pl.cli-fact-qnty    - buf_tt-doc-pl.cli-fact-qnty
     2265           loc-t-doc-pl.fact-qnty        = loc-t-doc-pl.fact-qnty        - buf_tt-doc-pl.fact-qnty
     2266           loc-t-doc-pl.rest-af-qnty     = loc-t-doc-pl.rest-af-qnty     - buf_tt-doc-pl.rest-af-qnty
     2267           loc-t-doc-pl.cli-rest-af-qnty = loc-t-doc-pl.cli-rest-af-qnty - buf_tt-doc-pl.cli-rest-af-qnty
     2268         .
