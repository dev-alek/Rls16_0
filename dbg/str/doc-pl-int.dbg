     2361           f-tot-doc-pl-cli-rest-af-qnty :row in frame f-doc-pl   = f-tot-doc-pl-rest-af-qnty :row in frame f-doc-pl
     2362           f-tot-doc-pl-rest-density     :row in frame f-doc-pl   = f-tot-doc-pl-rest-af-qnty :row in frame f-doc-pl
     2363           rect-tot :height-chars in frame f-doc-pl = 3.5
     2364           frame f-doc-pl :height-chars = frame f-doc-pl :height-chars - 3.5
     2365         .
     2366         display
     2367           f-tot-doc-pl-fact-qnty
     2368           f-tot-doc-pl-cli-fact-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     2369           f-tot-doc-pl-rest-af-qnty
     2370           f-tot-doc-pl-cli-rest-af-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2371           f-tot-doc-pl-rest-density     when buf_goods.unit-base <> buf_goods.unit-cli
     2372           with frame f-doc-pl.
     2373           .
     2374       end.
     2375       when "doc":U then do:
     2376         assign
     2377           f-tot-doc-pl-doc-qnty     :bgcolor = 8
     2378           f-tot-doc-pl-cli-doc-qnty :bgcolor = 8
     2379           f-doc-line-doc-qnty       :bgcolor = 8
     2380           f-doc-line-cli-doc-qnty   :bgcolor = 8
     2381           f-doc-line-doc-density    :bgcolor = 8
     2382         .
     2383         display
     2384           f-tot-doc-pl-doc-qnty
     2385           f-tot-doc-pl-cli-doc-qnty  when buf_goods.unit-base <> buf_goods.unit-cli
     2386           f-tot-doc-label
     2387           f-doc-line-doc-qnty
     2388           f-doc-line-cli-doc-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     2389           f-doc-line-doc-density     when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2390           with frame f-doc-pl
     2391           .
     2392       end.
     2393       when "fact":U then do:
     2394         assign
     2395           f-tot-doc-pl-fact-qnty     :bgcolor = 8
     2396           f-tot-doc-pl-cli-fact-qnty :bgcolor = 8
     2397           f-doc-line-fact-qnty       :bgcolor = 8
     2398           f-doc-line-cli-fact-qnty   :bgcolor = 8
     2399           f-doc-line-fact-density    :bgcolor = 8
     2400         .
     2401         display
     2402           f-tot-doc-pl-doc-qnty
     2403           f-tot-doc-pl-fact-qnty
     2404           f-tot-doc-pl-cli-doc-qnty  when buf_goods.unit-base <> buf_goods.unit-cli
     2405           f-tot-doc-pl-cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2406           f-tot-doc-label
     2407           f-doc-line-doc-qnty
     2408           f-doc-line-fact-qnty
     2409           f-doc-line-cli-doc-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     2410           f-doc-line-cli-fact-qnty   when buf_goods.unit-base <> buf_goods.unit-cli
     2411           f-doc-line-doc-density     when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2412           f-doc-line-fact-density    when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2413           with frame f-doc-pl
     2414           .
     2415       end.
     2416       when "fact-doc":U then do:
     2417         assign
     2418           f-tot-doc-pl-fact-qnty     :bgcolor = 8
     2419           f-tot-doc-pl-cli-fact-qnty :bgcolor = 8
     2420           f-doc-line-fact-qnty       :bgcolor = 8
     2421           f-doc-line-cli-fact-qnty   :bgcolor = 8
     2422           f-doc-line-fact-density    :bgcolor = 8
     2423         .
     2424         display
     2425           f-tot-doc-pl-fact-qnty
     2426           f-tot-doc-pl-cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2427           f-tot-doc-label
     2428           f-doc-line-fact-qnty
     2429           f-doc-line-cli-fact-qnty   when buf_goods.unit-base <> buf_goods.unit-cli
     2430           f-doc-line-fact-density    when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2431           with frame f-doc-pl
     2432           .
     2433       end.
     2434     end case.
     2435     if buf_trn-doc.doc-type = 'при':U
     2436       and buf_trn-doc.internal = false
     2437     then do:
     2438       assign
     2439         loc-t-doc-pl.cli-qnty   :label in frame f-doc-pl = substitute( "по ТТН (&1)", p-doc-line-unit-cli )
     2440       .
     2441       display
     2442         loc-t-doc-pl.cli-qnty
     2443         with frame f-doc-pl.
     2444         .
     2445     end.
     2446     case p-upd-field :
     2447       when "rest":U
     2448       or when "rest-fact":U
     2449       then do:
     2450         assign
     2451           loc-t-doc-pl.fact-qnty        :label in frame f-doc-pl = substitute( "Разница" )
     2452           loc-t-doc-pl.rest-af-qnty     :row in frame f-doc-pl   = loc-t-doc-pl.doc-qnty :row in frame f-doc-pl
     2453           loc-t-doc-pl.rest-af-qnty     :handle :side-label-handle :row in frame f-doc-pl = loc-t-doc-pl.rest-af-qnty :row in frame f-doc-pl
     2454           loc-t-doc-pl.cli-rest-af-qnty :row in frame f-doc-pl   = loc-t-doc-pl.rest-af-qnty :row in frame f-doc-pl
     2455           f-doc-pl-rest-density         :row in frame f-doc-pl   = loc-t-doc-pl.rest-af-qnty :row in frame f-doc-pl
     2456         .
     2457         display
     2458           loc-t-doc-pl.fact-qnty
     2459           loc-t-doc-pl.rest-af-qnty
     2460           loc-t-doc-pl.cli-fact-qnty    when buf_goods.unit-base <> buf_goods.unit-cli
     2461           loc-t-doc-pl.cli-rest-af-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2462           f-doc-pl-rest-density         when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2463           with frame f-doc-pl.
     2464           .
     2465       end.
     2466       when "doc":U then do:
     2467         display
     2468           loc-t-doc-pl.doc-qnty
     2469           loc-t-doc-pl.cli-doc-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2470           f-doc-pl-doc-density      when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2471           with frame f-doc-pl
     2472           .
     2473       end.
     2474       when "fact":U then do:
     2475         display
     2476           loc-t-doc-pl.doc-qnty
     2477           loc-t-doc-pl.fact-qnty
     2478           loc-t-doc-pl.cli-doc-qnty  when buf_goods.unit-base <> buf_goods.unit-cli
     2479           loc-t-doc-pl.cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2480           f-doc-pl-doc-density       when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2481           f-doc-pl-fact-density      when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2482           with frame f-doc-pl
     2483           .
     2484       end.
     2485       when "fact-doc":U then do:
     2486         display
     2487           loc-t-doc-pl.fact-qnty
     2488           loc-t-doc-pl.cli-fact-qnty when buf_goods.unit-base <> buf_goods.unit-cli
     2489           f-doc-pl-fact-density      when v-is-ptrl = "yes":U and buf_goods.unit-base <> buf_goods.unit-cli
     2490           with frame f-doc-pl
     2491           .
     2492       end.
     2493     end case.
     2494     if p-mode = 'ПРОСМОТР':U
     2495       or buf_trn-doc.status_ = 'факт':U
     2496     then do:
     2497       disable
     2498         all
     2499         with frame f-doc-pl
     2500       .
     2501       enable
     2502         b-quit
     2503         b-help
     2504         with frame f-doc-pl
     2505       .
     2506     end.
     2507     else do:
     2508       if p-mode = 'АВТОИЗМЕНЕНИЕ':U then do:
     2509         assign
     2510           v-msg-on = true
     2511         .
     2512       end.
     2513       else do:
     2514         assign
     2515           v-msg-on = false
     2516         .
     2517       end.
     2518       find first buf_rvs-doc no-lock
     2519         where buf_rvs-doc.out-code = buf_trn-doc.doc-code
     2520           and ( buf_rvs-doc.rvs-type = 'перед_док':U
     2521                 or buf_rvs-doc.rvs-type = 'после_док':U
     2522               )
     2523         no-error .
     2524       if p-upd-field = "doc":U
     2525         or p-upd-field = "fact":U
     2526         or p-upd-field = "fact-doc":U
     2527       then do:
     2528         enable
     2529           b-qnty
     2530           with frame f-doc-pl.
     2531         if ( ( buf_trn-doc.doc-type = 'при':U
     2532               and not available buf_rvs-doc
     2533             )
     2534             or buf_trn-doc.doc-type <> 'при':U
     2535           )
     2536         then do:
     2537           enable
     2538             loc-t-doc-pl.pl-code
     2539             b-place
     2540             loc-t-doc-pl.pl-code2
     2541             b-place2
     2542             with frame f-doc-pl.
     2543         end.
     2544         if buf_trn-doc.ext-doc-type = 'eo':U and buf_trn-doc.flag_ then do :
     2545           disable
     2546             loc-t-doc-pl.pl-code
     2547             b-place
     2548             loc-t-doc-pl.pl-code2
     2549             b-place2
     2550             with frame f-doc-pl .
     2551         end.
     2552       end.
     2553       case p-upd-field :
     2554         when "rest":U then do:
     2555           if buf_goods.unit-base <> buf_goods.unit-cli then do:
     2556             enable
     2557               f-doc-pl-rest-density
     2558               with frame f-doc-pl.
     2559           end.
     2560           if p-upd-units = "cli":U
     2561             and loc-t-doc-pl.cli-rest-af-qnty :visible = true
     2562           then do:
     2563             enable
     2564               loc-t-doc-pl.cli-rest-af-qnty
     2565               with frame f-doc-pl.
     2566           end.
     2567           else do:
     2568             enable
     2569               loc-t-doc-pl.rest-af-qnty
     2570               with frame f-doc-pl.
     2571           end.
     2572         end.
     2573         when "rest-fact":U then do:
     2574           if loc-t-doc-pl.cli-fact-qnty :visible = true then do:
     2575             enable
     2576               loc-t-doc-pl.cli-fact-qnty
     2577               with frame f-doc-pl.
     2578           end.
     2579           if loc-t-doc-pl.fact-qnty :visible = true then do:
     2580             enable
     2581               loc-t-doc-pl.fact-qnty
     2582               with frame f-doc-pl.
     2583           end.
     2584         end.
     2585         when "doc":U then do:
     2586           if p-upd-units = "cli":U
     2587             and loc-t-doc-pl.cli-doc-qnty :visible = true
     2588           then do:
     2589             enable
     2590               loc-t-doc-pl.cli-doc-qnty
     2591               with frame f-doc-pl.
     2592             apply "leave" to loc-t-doc-pl.cli-doc-qnty in frame f-doc-pl .
     2593           end.
     2594           else do:
     2595             enable
     2596               loc-t-doc-pl.doc-qnty
     2597               with frame f-doc-pl.
     2598             apply "leave" to loc-t-doc-pl.doc-qnty in frame f-doc-pl .
     2599           end.
     2600         end.
     2601         when "fact":U
     2602         or when "fact-doc":U
     2603         then do:
     2604           if p-upd-units = "cli":U
     2605             and loc-t-doc-pl.cli-fact-qnty :visible = true
     2606           then do:
     2607             enable
     2608               loc-t-doc-pl.cli-fact-qnty
     2609               with frame f-doc-pl.
     2610             apply "leave" to loc-t-doc-pl.cli-fact-qnty in frame f-doc-pl .
     2611           end.
     2612           else do:
     2613             enable
     2614               loc-t-doc-pl.fact-qnty
     2615               with frame f-doc-pl.
     2616             apply "leave" to loc-t-doc-pl.fact-qnty in frame f-doc-pl .
     2617           end.
     2618         end.
     2619       end case.
     2620       assign
     2621         v-msg-on = true
     2622       .
     2623     end.
     2624     apply "value-changed" to loc-t-doc-pl.pl-code in frame f-doc-pl.
     2625     apply "value-changed" to loc-t-doc-pl.pl-code2 in frame f-doc-pl.
     2626     WAIT-FOR GO OF FRAME f-doc-pl.
     2627   END.
     2628   RUN disable_UI.
     2629   delete loc-t-doc-pl .
     2630   PROCEDURE calc-qnty :
     2631     do
     2632     on error undo, return error return-value
     2633     :
     2634       case p-upd-field :
     2635         when "rest":U then do:
     2636           assign
     2637             loc-t-doc-pl.fact-qnty     = loc-t-doc-pl.rest-af-qnty - loc-t-doc-pl.rest-bf-qnty
     2638             loc-t-doc-pl.cli-fact-qnty = loc-t-doc-pl.cli-rest-af-qnty - loc-t-doc-pl.cli-rest-bf-qnty
     2639           .
     2640         end.
     2641         when "rest-fact":U then do:
     2642           assign
     2643             loc-t-doc-pl.rest-af-qnty     = loc-t-doc-pl.rest-bf-qnty + loc-t-doc-pl.fact-qnty
     2644             loc-t-doc-pl.cli-rest-af-qnty = loc-t-doc-pl.cli-rest-bf-qnty + loc-t-doc-pl.cli-fact-qnty
     2645           .
     2646           if loc-t-doc-pl.rest-af-qnty <> 0.0
     2647             and loc-t-doc-pl.cli-rest-af-qnty <> 0.0
     2648           then do:
     2649             assign
     2650               f-doc-pl-rest-density = loc-t-doc-pl.cli-rest-af-qnty / loc-t-doc-pl.rest-af-qnty
     2651             .
     2652           end.
     2653           else do:
     2654             assign
     2655               f-doc-pl-rest-density = p-doc-line-rest-density
     2656             .
     2657           end.
     2658         end.
     2659       end case.
     2660       display
     2661         loc-t-doc-pl.cli-qnty         when loc-t-doc-pl.cli-qnty :visible = true
     2662         loc-t-doc-pl.doc-qnty         when loc-t-doc-pl.doc-qnty :visible = true
     2663         loc-t-doc-pl.cli-doc-qnty     when loc-t-doc-pl.cli-doc-qnty :visible = true
     2664         loc-t-doc-pl.fact-qnty        when loc-t-doc-pl.fact-qnty :visible = true
     2665         loc-t-doc-pl.cli-fact-qnty    when loc-t-doc-pl.cli-fact-qnty :visible = true
     2666         loc-t-doc-pl.rest-af-qnty     when loc-t-doc-pl.rest-af-qnty :visible = true
     2667         loc-t-doc-pl.cli-rest-af-qnty when loc-t-doc-pl.cli-rest-af-qnty :visible = true
     2668         f-doc-pl-rest-density         when f-doc-pl-rest-density :visible = true
     2669         with frame f-doc-pl.
     2670     end.
     2671   END PROCEDURE.
     2672   PROCEDURE disable_UI :
     2673     HIDE FRAME f-doc-pl.
     2674   END PROCEDURE.
     2675   PROCEDURE enable_UI :
     2676     DISPLAY f-prod-name f-units-base
     2677         WITH FRAME f-doc-pl.
     2678     IF AVAILABLE buf-obj_clients THEN
     2679       DISPLAY buf-obj_clients.obj-type buf-obj_clients.obj-code
     2680             buf-obj_clients.obj-name
     2681         WITH FRAME f-doc-pl.
     2682     IF AVAILABLE buf_goods THEN
     2683       DISPLAY buf_goods.gds-code buf_goods.gds-name buf_goods.artic
     2684             buf_goods.prod-type buf_goods.prod-code
     2685         WITH FRAME f-doc-pl.
     2686     IF AVAILABLE buf_place THEN
     2687       DISPLAY buf_place.pl-name buf_place.loc1 buf_place.loc2 buf_place.loc3
     2688             buf_place.loc4
     2689         WITH FRAME f-doc-pl.
     2690     IF AVAILABLE loc-t-doc-pl THEN
     2691       DISPLAY loc-t-doc-pl.pl-code loc-t-doc-pl.pl-code2
     2692         WITH FRAME f-doc-pl.
     2693     ENABLE b-exit b-quit b-help
     2694         WITH FRAME f-doc-pl.
     2695   END PROCEDURE.
