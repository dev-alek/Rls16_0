      675   ON CHOOSE OF b-exit IN FRAME f-doc-pl
      676   DO:
      677   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   if lookup(self :type
      679            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      680            ) = 0
      681   then do:
      682     message
      683       "$Workfile$"
      684       "Указанному интерфейсному элементу фокус не может быть передан" skip
      685       "Интерфейсный элемент" self :name  skip
      686       "Тип" self :type  skip
      687       "Процедура" this-procedure :file-name skip
      688       view-as alert-box .
      689   end.
      690   else do:
      691     apply "entry":u to self  .
      692     if focus :handle <> self :handle  then do:
      693       return no-apply .
      694     end.
      695   end.
      696     define variable v-quit as logical   no-undo .
      697     apply "leave" to loc-t-doc-pl.pl-code in frame f-doc-pl.
      698     if loc-t-doc-pl.pl-code = ?
      699       or loc-t-doc-pl.pl-code = 0
      700       or loc-t-doc-pl.pl-code2 = ?
      701       or loc-t-doc-pl.pl-code2 = 0
      702     then do:
      703       message
      704         "Не указаны места хранения." skip
      705         "Хотите выйти без сохранения?" skip
      706         view-as alert-box question buttons yes-no update v-quit.
      707       if v-quit = true then do:
      708         apply "choose" to b-quit in frame f-doc-pl.
      709       end.
      710       return no-apply.
      711     end.
      712     if p-upd-field = "rest":U
      713       or p-upd-field = "rest-fact":U
      714     then do:
      715       assign
      716         loc-t-doc-pl.doc-qnty     = loc-t-doc-pl.fact-qnty
      717         loc-t-doc-pl.cli-doc-qnty = loc-t-doc-pl.cli-fact-qnty
      718         loc-t-doc-pl.cli-qnty     = loc-t-doc-pl.cli-doc-qnty
      719       .
      720       if f-doc-pl-rest-density :sensitive = true then do:
      721         if loc-t-doc-pl.rest-af-qnty <> 0.0
      722           and loc-t-doc-pl.cli-rest-af-qnty <> 0.0
      723           and absolute( loc-t-doc-pl.cli-rest-af-qnty / loc-t-doc-pl.rest-af-qnty - f-doc-pl-rest-density ) > 0.00001
      724         then do:
      725           message
      726             "Указанная плотность не соответствует расчетной." skip
      727             substitute( "Расчетная: &1", loc-t-doc-pl.cli-rest-af-qnty / loc-t-doc-pl.rest-af-qnty ) skip
      728             substitute( "Задана: &1", f-doc-pl-rest-density ) skip
      729             view-as alert-box error .
      730           apply "entry" to f-doc-pl-rest-density in frame f-doc-pl.
      731           return no-apply .
      732         end.
      733         if valid-density( f-doc-pl-rest-density, (buf_goods.unit-base = buf_goods.unit-cli)  ) <> true then do:
      734           message
      735             "Значение плотности не корректно." skip
      736             substitute( 'Плотность "стало": &1', f-doc-pl-rest-density ) skip
      737             view-as alert-box error .
      738           apply "entry" to f-doc-pl-rest-density in frame f-doc-pl.
      739           return no-apply .
      740         end.
      741       end.
      742     end.
      743     if p-upd-field <> "rest":U
      744       and p-upd-field <> "rest-fact":U
      745       and p-upd-field <> "fact-doc":U
      746       and loc-t-doc-pl.cli-doc-qnty = 0.0
      747       and loc-t-doc-pl.doc-qnty = 0.0
      748     then do:
      749       message
      750         "Указаны нулевые количества, запись будет удалена." skip
      751         "Хотите продолжить редактирование?" skip
      752         view-as alert-box question buttons yes-no update v-quit.
      753       if v-quit = true then do:
      754         return no-apply.
      755       end.
      756       else do:
      757         if available buf-upd_tt-doc-pl then do:
      758           delete buf-upd_tt-doc-pl .
      759         end.
      760       end.
      761     end.
      762     else do:
      763       if not available buf-upd_tt-doc-pl then do:
      764         create buf-upd_tt-doc-pl .
      765       end.
      766       buffer-copy loc-t-doc-pl to buf-upd_tt-doc-pl .
      767     end.
      768   END.
      769   ON CHOOSE OF b-place IN FRAME f-doc-pl
      770   DO:
      771   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      772   if lookup(self :type
      773            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      774            ) = 0
      775   then do:
      776     message
      777       "$Workfile$"
      778       "Указанному интерфейсному элементу фокус не может быть передан" skip
      779       "Интерфейсный элемент" self :name  skip
      780       "Тип" self :type  skip
      781       "Процедура" this-procedure :file-name skip
      782       view-as alert-box .
      783   end.
      784   else do:
      785     apply "entry":u to self  .
      786     if focus :handle <> self :handle  then do:
      787       return no-apply .
      788     end.
      789   end.
      790     define variable v-rid-list as character no-undo .
      791     define variable j-pl-code  as integer   no-undo .
      792     define variable ref-rec    as recid     no-undo .
      793     define buffer buf_pl-gds for ub.pl-gds .
      794     run ref/pl-gdss.w
      795       ( input parparentproc
      796        ,input "b-sel"
      797        ,input buf-obj_clients.obj-type
      798        ,input buf-obj_clients.obj-code
      799        ,input ( if v-is-ptrl = "yes":U then 'топ':U else 'ТОВАР':U )
      800        ,input recid( buf_goods )
      801        ,input ?
      802        ,output v-rid-list
      803       ) no-error .
      804     assign
      805       ref-rec = integer( entry( 1, v-rid-list ) ) no-error
      806     .
      807     if error-status :error then do:
      808       assign
      809         ref-rec = ?
      810       .
      811     end.
      812     find first buf_pl-gds no-lock
      813       where recid( buf_pl-gds ) = ref-rec
      814       no-error .
      815     if available buf_pl-gds then do:
      816       if loc-t-doc-pl.pl-code = buf_pl-gds.pl-code then do:
      817         return no-apply .
      818       end.
      819       if loc-t-doc-pl.pl-code2 = buf_pl-gds.pl-code then do:
      820         message "Некорректный выбор!" view-as alert-box.
      821         return no-apply .
      822       end.
      823       assign
      824         loc-t-doc-pl.pl-code :screen-value = string( buf_pl-gds.pl-code, loc-t-doc-pl.pl-code :format )
      825       .
      826       apply "leave" to loc-t-doc-pl.pl-code in frame f-doc-pl .
      827     end.
      828     apply "value-changed" to loc-t-doc-pl.pl-code in frame f-doc-pl.
      829   END.
