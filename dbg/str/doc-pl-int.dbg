     1819           f-tot-doc-pl-rest-af-qnty     = f-tot-doc-pl-rest-af-qnty     + tt-doc-pl.rest-af-qnty
     1820           f-tot-doc-pl-cli-rest-af-qnty = f-tot-doc-pl-cli-rest-af-qnty + tt-doc-pl.cli-rest-af-qnty
     1821         .
     1822       end.
     1823       if f-tot-doc-pl-rest-af-qnty <> 0.0
     1824         and f-tot-doc-pl-cli-rest-af-qnty <> 0.0
     1825       then do:
     1826         assign
