     1949       then do:
     1950         if f-tot-doc-pl-rest-af-qnty <> f-doc-line-rest-af-qnty then do:
     1951           assign
     1952             f-tot-doc-pl-rest-af-qnty :fgcolor = 12
     1953             f-doc-line-rest-af-qnty   :fgcolor = 12
     1954           .
     1955         end.
     1956         else do:
     1957           assign
     1958             f-tot-doc-pl-rest-af-qnty :fgcolor = ?
     1959             f-doc-line-rest-af-qnty   :fgcolor = ?
     1960           .
     1961         end.
     1962       end.
     1963       if f-tot-doc-pl-cli-rest-af-qnty :visible = true
     1964         and f-doc-line-cli-rest-af-qnty :visible = true
     1965       then do:
     1966         if absolute( f-tot-doc-pl-cli-rest-af-qnty - f-doc-line-cli-rest-af-qnty ) > 0.001 then do:
     1967           assign
     1968             f-tot-doc-pl-cli-rest-af-qnty :fgcolor = 12
     1969             f-doc-line-cli-rest-af-qnty   :fgcolor = 12
     1970           .
     1971         end.
     1972         else do:
     1973           assign
     1974             f-tot-doc-pl-cli-rest-af-qnty :fgcolor = ?
     1975             f-doc-line-cli-rest-af-qnty   :fgcolor = ?
     1976           .
     1977         end.
     1978       end.
     1979     end procedure.
     1980     procedure get-from-rvs :
     1981       define input  parameter p-doc-code               like ub.trn-doc.doc-code                no-undo .
     1982       define input  parameter p-gds-code               like ub.rvs-line.gds-code               no-undo .
     1983       define input  parameter p-pl-code                like ub.rvs-line.pl-code                no-undo .
     1984       define output parameter p-state-measure-qnty     like ub.rvs-line.state-measure-qnty     no-undo .
     1985       define output parameter p-measure-qnty           like ub.rvs-line.measure-qnty           no-undo .
     1986       define output parameter p-state-measure-cli-qnty like ub.rvs-line.state-measure-cli-qnty no-undo .
     1987       define output parameter p-measure-cli-qnty       like ub.rvs-line.measure-cli-qnty       no-undo .
     1988       define output parameter p-state-density          like ub.rvs-line.state-density          no-undo .
     1989       define output parameter p-measure-density        like ub.rvs-line.density                no-undo .
     1990       define output parameter p-label                  as   character                          no-undo .
     1991       do
     1992       on error  undo, return error substitute( "&1 (disp-from-rvs). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1993       on stop   undo, return error substitute( "&1 (disp-from-rvs). stop", vss-workfile )
     1994       on endkey undo, return error substitute( "&1 (disp-from-rvs). endkey", vss-workfile )
     1995       :
     1996         define buffer rvs_trn-doc  for ub.trn-doc .
     1997         define buffer bef_rvs-doc  for ub.rvs-doc  .
     1998         define buffer aft_rvs-doc  for ub.rvs-doc  .
     1999         define buffer bef_rvs-line for ub.rvs-line .
     2000         define buffer aft_rvs-line for ub.rvs-line .
     2001         assign
     2002           p-state-measure-qnty     = 0
     2003           p-measure-qnty           = 0
     2004           p-state-measure-cli-qnty = 0
     2005           p-measure-cli-qnty       = 0
     2006           p-label                  = "":U
     2007         .
     2008         case buf_trn-doc.doc-type :
     2009           when 'при':U then do:
     2010             for each bef_rvs-doc no-lock
     2011               where bef_rvs-doc.out-code  = p-doc-code
     2012                 and bef_rvs-doc.rvs-type  = 'перед_док':U
     2013             :
     2014               for each bef_rvs-line no-lock
     2015                 where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
     2016                   and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
     2017                   and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
     2018                   and bef_rvs-line.pl-code  = p-pl-code
     2019                   and bef_rvs-line.gds-code = p-gds-code
     2020               :
     2021                 assign
     2022                   p-state-measure-qnty     = p-state-measure-qnty     - bef_rvs-line.state-measure-qnty
     2023                   p-measure-qnty           = p-measure-qnty           - bef_rvs-line.measure-qnty
     2024                   p-state-measure-cli-qnty = p-state-measure-cli-qnty - bef_rvs-line.state-measure-cli-qnty
     2025                   p-measure-cli-qnty       = p-measure-cli-qnty       - bef_rvs-line.measure-cli-qnty
     2026                 .
     2027               end .
     2028             end .
     2029             for each aft_rvs-doc no-lock
     2030               where aft_rvs-doc.out-code  = p-doc-code
     2031                 and aft_rvs-doc.rvs-type  = 'после_док':U
     2032             :
     2033               for each aft_rvs-line no-lock
     2034                 where aft_rvs-line.rvs-code = aft_rvs-doc.rvs-code
     2035                   and aft_rvs-line.obj-type = aft_rvs-doc.obj-type
     2036                   and aft_rvs-line.obj-code = aft_rvs-doc.obj-code
     2037                   and aft_rvs-line.pl-code  = p-pl-code
     2038                   and aft_rvs-line.gds-code = p-gds-code
     2039               :
     2040                 assign
     2041                   p-state-measure-qnty     = p-state-measure-qnty     + aft_rvs-line.state-measure-qnty
     2042                   p-measure-qnty           = p-measure-qnty           + aft_rvs-line.measure-qnty
     2043                   p-state-measure-cli-qnty = p-state-measure-cli-qnty + aft_rvs-line.state-measure-cli-qnty
     2044                   p-measure-cli-qnty       = p-measure-cli-qnty       + aft_rvs-line.measure-cli-qnty
     2045                 .
     2046               end.
     2047             end .
     2048             assign
     2049               p-state-density          = p-state-measure-cli-qnty / p-state-measure-qnty
     2050               p-measure-density        = p-measure-cli-qnty / p-measure-qnty
     2051             .
     2052             assign
     2053               p-label = "По сверкам":U
     2054             .
     2055           end.
     2056           when 'инв':U then do:
     2057             find first rvs_trn-doc no-lock
     2058               where rvs_trn-doc.doc-code = p-doc-code
     2059               .
     2060             find first bef_rvs-doc no-lock
     2061               where bef_rvs-doc.rvs-code = rvs_trn-doc.out-code
     2062               no-error .
     2063             if available bef_rvs-doc then do:
     2064               assign
     2065                 p-label = "По сверке":U
     2066               .
     2067               find first bef_rvs-line no-lock
     2068                 where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
     2069                   and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
     2070                   and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
     2071                   and bef_rvs-line.pl-code  = p-pl-code
     2072                   and bef_rvs-line.gds-code = p-gds-code
     2073                 no-error .
     2074               if available bef_rvs-line then do:
     2075                 assign
     2076                   p-state-measure-qnty     = bef_rvs-line.state-measure-qnty
     2077                   p-measure-qnty           = bef_rvs-line.measure-qnty
     2078                   p-state-measure-cli-qnty = bef_rvs-line.state-measure-cli-qnty
     2079                   p-measure-cli-qnty       = bef_rvs-line.measure-cli-qnty
     2080                   p-state-density          = bef_rvs-line.state-density
     2081                   p-measure-density        = bef_rvs-line.density
     2082                 .
     2083               end.
     2084             end.
     2085           end.
     2086         end case.
     2087       end.
     2088     end procedure.
     2089   MAIN-BLOCK:
     2090   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2091      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2092     define buffer buf_clients for ub.clients .
     2093     define buffer buf_rvs-doc for ub.rvs-doc .
     2094     define buffer buf_tt-doc-pl for tt-doc-pl .
     2095     if p-upd-field = "doc":U then do:
     2096       assign
     2097         p-doc-line-fact-cli-qnty = p-doc-line-doc-cli-qnty
     2098         p-doc-line-fact-qnty     = p-doc-line-doc-qnty
     2099       .
     2100     end.
     2101     find first buf_trn-doc no-lock
     2102       where buf_trn-doc.doc-code = p-doc-code
     2103     .
     2104     find first buf-upd_tt-doc-pl
     2105       where buf-upd_tt-doc-pl.obj-type = buf_trn-doc.obj-type
     2106         and buf-upd_tt-doc-pl.obj-code = buf_trn-doc.obj-code
     2107         and buf-upd_tt-doc-pl.pl-code  = p-pl-code
     2108         and buf-upd_tt-doc-pl.out-code = buf_trn-doc.doc-code
     2109         and buf-upd_tt-doc-pl.gds-code = p-gds-code
     2110       no-error .
     2111     if not available buf-upd_tt-doc-pl then do:
     2112       if p-mode = 'ПРОСМОТР':U then do:
     2113         message
     2114           vss-workfile vss-revision vss-description skip
     2115           "Ошибка задания входных параметров" skip
     2116           "Нет записи о редактируемом резервуаре" skip
     2117           view-as alert-box error .
     2118         return error .
     2119       end.
     2120     end.
     2121   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2122     define variable v-data-type as character no-undo .
     2123     define variable is-petrol   as logical   no-undo .
     2124     define variable is-pieces   as logical   no-undo .
     2125     find first buf_goods no-lock
     2126       where buf_goods.gds-code = p-gds-code
     2127     .
     2128     assign
     2129       f-units-base = "(" + trim( buf_goods.unit-base ) + ")"
     2130       f-units-cli  = "(" + trim( buf_goods.unit-cli ) + ")"
     2131       f-label-density = "Плотность"
     2132     .
     2133     assign
     2134       f-doc-line-doc-density      = p-doc-line-doc-density
     2135       f-doc-line-fact-density     = p-doc-line-fact-density
     2136       f-doc-line-rest-density     = p-doc-line-rest-density
     2137       f-doc-line-cli-qnty         = p-doc-line-cli-qnty
     2138       f-doc-line-doc-qnty         = p-doc-line-doc-qnty
     2139       f-doc-line-cli-doc-qnty     = p-doc-line-doc-cli-qnty
     2140       f-doc-line-fact-qnty        = p-doc-line-fact-qnty
     2141       f-doc-line-cli-fact-qnty    = p-doc-line-fact-cli-qnty
     2142       f-doc-line-rest-af-qnty     = p-doc-line-rest-af-qnty
     2143       f-doc-line-cli-rest-af-qnty = p-doc-line-cli-rest-af-qnty
     2144     .
     2145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2146     (input  'is-ptrl':U
     2147     ,input  ''
     2148     ,input  ''
     2149     ,input  0
     2150     ,input  ''
     2151     ,input  ''
     2152     ,input  ''
     2153     ,input  no
     2154     ,output v-is-ptrl
     2155     ,output v-data-type
     2156     ) no-error .
     2157     if error-status :error
     2158       or v-data-type <> "L":U
     2159       or lookup( v-is-ptrl, "yes,no":U ) = 0
     2160     then do:
     2161       assign
