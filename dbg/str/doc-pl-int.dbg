      930         "Все количества уже установлены корректно."
      931         view-as alert-box information.
      932       return no-apply .
      933     end.
      934     if loc-t-doc-pl.cli-doc-qnty :sensitive = true then do:
      935       assign
      936         loc-t-doc-pl.cli-doc-qnty = loc-t-doc-pl.cli-doc-qnty + f-doc-line-cli-doc-qnty - f-tot-doc-pl-cli-doc-qnty
      937       .
