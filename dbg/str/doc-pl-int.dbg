       47   define input  parameter parparentproc               as   widget-handle              no-undo .
       48   define input  parameter p-mode                      as   character                  no-undo .
       49   define input  parameter p-upd-field                 as   character                  no-undo .
       50   define input  parameter p-upd-units                 as   character                  no-undo .
