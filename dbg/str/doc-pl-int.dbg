       65   define input  parameter p-doc-line-rest-af-qnty     like ub.doc-pl.rest-af-qnty     no-undo .
       66   define input  parameter p-doc-line-cli-rest-af-qnty like ub.doc-pl.cli-rest-af-qnty no-undo .
       67   define variable vss-revision    as character no-undo initial "$Revision$":U .
       68   define variable vss-author      as character no-undo initial "$Author$":U .
       69   define variable vss-date        as character no-undo initial "$Date$":U .
       70   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       71   define variable vss-archive     as character no-undo initial "$Archive$":U .
       72   define variable vss-description as character no-undo initial "Складское место с товарами с указанием количеств":U .
       73   procedure vss-get-info :
       74     define output parameter p-vss-revision    like vss-revision    no-undo .
       75     define output parameter p-vss-author      like vss-author      no-undo .
       76     define output parameter p-vss-date        like vss-date        no-undo .
       77     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       78     define output parameter p-vss-archive     like vss-archive     no-undo .
       79     define output parameter p-vss-description like vss-description no-undo .
       80     assign
       81       p-vss-revision    = vss-revision
       82       p-vss-author      = vss-author
       83       p-vss-date        = vss-date
       84       p-vss-workfile    = vss-workfile
       85       p-vss-archive     = vss-archive
       86       p-vss-description = vss-description
       87     .
       88   end procedure.
       89   procedure vss-get-parameters :
       90     define output parameter p-vss-parameters as character no-undo .
       91   end procedure.
       92   define new global shared variable g#vssrevis-logger as handle    no-undo .
       93   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       94   define variable v-vssrevis-logger                   as handle    no-undo .
       95   procedure vss-logevent :
       96     define input  parameter p-extra-paramters as character no-undo .
       97     define variable v-vssrevis-parameters as character no-undo .
       98     do
       99     on error undo, return error return-value
      100     :
      101       if  valid-handle(v-vssrevis-logger)
      102       and v-vssrevis-logger :get-signature("logevent") <> ""
      103       then do:
      104         run vss-get-parameters in this-procedure
      105           (output v-vssrevis-parameters
      106           ).
      107         run logevent in v-vssrevis-logger
      108           (input vss-workfile
      109           ,input vss-revision
      110           ,input v-vssrevis-parameters
      111           ,input p-extra-paramters
      112           ).
      113       end.
      114     end.
      115   end procedure.
      116   assign
      117     v-vssrevis-logger = g#vssrevis-logger
      118   .
      119   if  valid-handle(v-vssrevis-logger)
      120   and v-vssrevis-logger :get-signature("logevent") <> ""
      121   then do:
      122     assign
      123       v-vssrevis-logevent = true
      124     .
      125     run vss-logevent in this-procedure (input vss-description) .
      126   end.
      127   define new global shared variable g#language as character no-undo .
      128   if g#language <> '' and g#language <> 'rus':U then do:
      129     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      130   end.
      131   procedure proc-alt-shift-f2:
      132     if not ibs.th.gbl.gbl-var:rcode
      133   then
      134     run gbl\inidebug.p .
      135   end.
      136   procedure proc-alt-shift-f3:
      137     run gbl/prvssinf.p
      138       ( input this-procedure
      139       ) .
      140   end.
      141   define variable v-inform-launched as logical no-undo initial false .
      142   procedure proc-alt-shift-f4:
      143     define variable v-action as character no-undo .
      144     if v-inform-launched = false then do:
      145       assign
      146         v-inform-launched = true
      147       .
      148       run gbl/d-inform.w
      149         (  input self
      150         ,  input this-procedure
      151         , output v-action
      152         ) no-error .
      153       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      154       assign
      155         v-inform-launched = false
      156       .
      157     end.
      158   end.
      159   procedure proc-alt-f1:
      160     run gbl/corrhelp.p
      161       (input this-procedure
      162       ) .
      163   end .
      164   on alt-shift-f2 anywhere do:
      165     run proc-alt-shift-f2.
      166   end.
      167   on alt-shift-f3 anywhere do:
      168     run proc-alt-shift-f3 in this-procedure .
      169   end.
      170   on alt-shift-f4 anywhere do:
      171     run proc-alt-shift-f4 in this-procedure.
      172   end.
      173   on alt-f1 anywhere do:
      174     run proc-alt-f1 in this-procedure .
      175   end.
      176   define new global shared variable g#library  as handle no-undo .
      177   define new global shared variable g#library2 as handle no-undo .
      178   define new global shared variable g#lib-trn  as handle no-undo .
      179   define new global shared variable g#lib-trn2 as handle no-undo .
      180   define new global shared variable g#lib-trn3 as handle no-undo .
      181   define new global shared variable g#lib-trn4 as handle no-undo .
      182     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      183       define variable v-answ as logical no-undo .
      184       if ( p-unit-base-cli-eq = true
      185            and p-density = 1.0
      186          )
      187         or ( p-unit-base-cli-eq = false
      188              and p-density <> ?
      189              and p-density > 0.0
      190              and p-density < 1.0
      191            )
      192       then do:
      193         assign
      194           v-answ = true
      195         .
      196       end.
      197       else do:
      198         assign
      199           v-answ = false
      200         .
      201       end.
      202       return v-answ.
      203     end function.
