      831   DO:
      832   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   if lookup(self :type
      834            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      835            ) = 0
      836   then do:
      837     message
      838       "$Workfile$"
      839       "Указанному интерфейсному элементу фокус не может быть передан" skip
      840       "Интерфейсный элемент" self :name  skip
      841       "Тип" self :type  skip
      842       "Процедура" this-procedure :file-name skip
      843       view-as alert-box .
      844   end.
      845   else do:
      846     apply "entry":u to self  .
      847     if focus :handle <> self :handle  then do:
      848       return no-apply .
      849     end.
      850   end.
      851     define variable v-rid-list as character no-undo .
      852     define variable j-pl-code  as integer   no-undo .
      853     define variable ref-rec    as recid     no-undo .
      854     define buffer buf_pl-gds for ub.pl-gds .
      855     run ref/pl-gdss.w
      856       ( input parparentproc
      857        ,input "b-sel"
      858        ,input buf-obj_clients.obj-type
      859        ,input buf-obj_clients.obj-code
      860        ,input ( if v-is-ptrl = "yes":U then 'топ':U else 'ТОВАР':U )
      861        ,input recid( buf_goods )
      862        ,input ?
      863        ,output v-rid-list
      864       ) no-error .
      865     assign
      866       ref-rec = integer( entry( 1, v-rid-list ) ) no-error
      867     .
      868     if error-status :error then do:
      869       assign
      870         ref-rec = ?
      871       .
      872     end.
      873     find first buf_pl-gds no-lock
      874       where recid( buf_pl-gds ) = ref-rec
      875       no-error .
      876     if available buf_pl-gds then do:
      877       if loc-t-doc-pl.pl-code2 = buf_pl-gds.pl-code then do:
      878         return no-apply .
      879       end.
      880       if loc-t-doc-pl.pl-code = buf_pl-gds.pl-code then do:
      881         message "Некорректный выбор!" view-as alert-box.
      882         return no-apply .
      883       end.
      884       if can-find(first buf-upd_tt-doc-pl no-lock where buf-upd_tt-doc-pl.pl-code2 = buf_pl-gds.pl-code) then do :
      885           message "В одном документе нельзя делать перемещение с нескольких резервуаров на один." view-as alert-box.
      886           return no-apply .
      887       end.
      888       assign
      889         loc-t-doc-pl.pl-code2 :screen-value = string( buf_pl-gds.pl-code )
      890         loc-t-doc-pl.pl-code2
      891       .
      892     end.
      893     apply "value-changed" to loc-t-doc-pl.pl-code2 in frame f-doc-pl.
      894   END.
