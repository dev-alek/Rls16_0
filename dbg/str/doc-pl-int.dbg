     1809         f-tot-doc-pl-cli-rest-af-qnty = p-add-cli-rest-af-qnty
     1810       .
     1811       for each tt-doc-pl no-lock
     1812       :
     1813         assign
     1814           f-tot-doc-pl-cli-qnty         = f-tot-doc-pl-cli-qnty         + tt-doc-pl.cli-qnty
     1815           f-tot-doc-pl-doc-qnty         = f-tot-doc-pl-doc-qnty         + tt-doc-pl.doc-qnty
     1816           f-tot-doc-pl-cli-doc-qnty     = f-tot-doc-pl-cli-doc-qnty     + tt-doc-pl.cli-doc-qnty
