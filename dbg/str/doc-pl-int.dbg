     2195     .
     2196     find first buf-obj_clients no-lock
     2197       where buf-obj_clients.obj-type = buf_trn-doc.obj-type
     2198         and buf-obj_clients.obj-code = buf_trn-doc.obj-code
     2199       .
     2200     create loc-t-doc-pl .
     2201     if available buf-upd_tt-doc-pl then do:
     2202       assign
     2203         v-is-add = false
     2204       .
     2205       buffer-copy buf-upd_tt-doc-pl to loc-t-doc-pl .
     2206       if buf_trn-doc.ext-doc-type = 'io':U then
     2207       assign
     2208           loc-t-doc-pl.pl-code  = buf-upd_tt-doc-pl.pl-code2
     2209           loc-t-doc-pl.pl-code2 = buf-upd_tt-doc-pl.pl-code
     2210       .
     2211     end.
     2212     else do:
     2213       assign
     2214         v-is-add                            = true
     2215         loc-t-doc-pl.obj-type               = buf_trn-doc.obj-type
     2216         loc-t-doc-pl.obj-code               = buf_trn-doc.obj-code
     2217         loc-t-doc-pl.out-code               = buf_trn-doc.doc-code
     2218         loc-t-doc-pl.gds-code               = p-gds-code
     2219       .
     2220       if p-pl-code = ?
