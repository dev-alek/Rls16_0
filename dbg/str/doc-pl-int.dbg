     1585             f-rvs-measure-cli-qnty
     1586             f-rvs-state-density
     1587             f-rvs-state-measure-cli-qnty
     1588             with frame f-doc-pl.
     1589         end.
     1590       end.
     1591       find first buf_place no-lock
     1592         where buf_place.obj-type = buf-obj_clients.obj-type
     1593           and buf_place.obj-code = buf-obj_clients.obj-code
     1594           and buf_place.pl-code  = loc-t-doc-pl.pl-code
     1595           and buf_place.status_ <> 'удал':U
     1596         no-error .
     1597       if available buf_place then do:
     1598         display
     1599           buf_place.pl-name
     1600           buf_place.loc1
     1601           buf_place.loc2
     1602           buf_place.loc3
     1603           buf_place.loc4
     1604           with frame f-doc-pl.
     1605       end.
     1606     end.
     1607   END.
     1608   ON VALUE-CHANGED OF loc-t-doc-pl.pl-code2 IN FRAME f-doc-pl
