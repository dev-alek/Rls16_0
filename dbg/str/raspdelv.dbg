        1   block-level on error undo, throw.
        2   define input parameter parparentproc AS WIDGET-HANDLE        NO-UNDO.
        3   define input parameter pardoc-code   like trn-doc.doc-code   no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: raspdelv.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: str/raspdelv.p $":U .
        9   define variable vss-description as character no-undo initial "Размазывание наценки за срочность и работу, стоимость доставки по строкам накладной":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new global shared variable g#trdcalib as handle no-undo.
       72   define variable varhost-code  like trn-doc.obj-code no-undo.
       73   define variable v-deliv-rubl  like gds-dtl.price-rubl  no-undo .
       74   define variable v-deliv-base  like gds-dtl.price-rubl no-undo .
       75   define variable v-nac-rubl  like gds-dtl.price-rubl  no-undo .
       76   define variable v-nac-base  like gds-dtl.price-rubl no-undo .
       77   define variable par-sum_deliv like gds-dtl.price-rubl  no-undo .
       78   define variable v-deliv      as character no-undo .
       79   define variable v-sumwrk     as character no-undo .
       80   define variable v-sumsrk     as character no-undo .
       81   define variable v-stop       as character no-undo .
       82   define variable v-type       as character no-undo .
       83   define buffer ready_trn-doc for trn-doc.
       84   find trn-doc where trn-doc.doc-code = pardoc-code no-lock no-error.
       85   find first ready_trn-doc no-lock where ready_trn-doc.doc-code = trn-doc.out-code and
       86                                          ready_trn-doc.status_ = 'готов':U no-error .
       87   if error-status :error then return.
       88   if trn-doc.status_ <> 'разрешен':U then return .
       89   v-deliv = "" .
       90   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
       91                           input '5deliv':U ,
       92                          output v-deliv ,
       93                          output v-type )  .
       94   v-sumwrk = "" .
       95   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
       96                           input '6sumwrk':U ,
       97                          output v-sumwrk ,
       98                          output v-type )  .
       99   v-sumsrk = "" .
      100   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
      101                           input '7sumsrk':U ,
      102                          output v-sumsrk ,
      103                          output v-type )  .
      104   define variable v-sum  like gds-dtl.price-rubl    no-undo .
      105   define variable v-sss as decimal   no-undo .
      106   define variable v-sum-new-rubl as character no-undo .
      107   define variable i-sum-rubl as decimal   no-undo .
      108   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input trn-doc.doc-code ,
      109                           input 'discnt-stop':U ,
      110                          output v-sum-new-rubl ,
      111                          output v-type )  .
      112         i-sum-rubl = dec (v-sum-new-rubl) .
      113      if i-sum-rubl = 0 then return error .
      114      v-sss = decimal (v-deliv) .
      115   if par-sum_deliv = ? then par-sum_deliv = 0.
      116   define variable v-sum-rm as decimal   no-undo .
      117   v-sum-rm =  ( (i-sum-rubl -  v-sss )  * 100 / ( 100 - trn-doc.discnt-pc )) - trn-doc.tot-sale .
      118   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      120     (input  trn-doc.obj-type
      121     ,input  trn-doc.obj-code
      122     ,output varhost-code
      123     )  .
      124   if not available trn-doc then do:
      125      message "Не найден документ с кодом: " pardoc-code
      126      view-as alert-box.
      127      return error.
      128   end.
      129   tr:
      130   do transaction
      131      ON ERROR   UNDO tr, LEAVE
      132      ON END-KEY UNDO tr, LEAVE
      133      ON STOP    UNDO tr , LEAVE :
      134      for each gds-dtl exclusive-lock where gds-dtl.doc-code = pardoc-code:
      135         v-deliv-rubl = 0 .
      136         v-deliv-base = 0 .
      137         v-nac-rubl = 0 .
      138         v-nac-base = 0 .
      139          assign
      140                v-nac-base = gds-dtl.price-base  * v-sum-rm / ( trn-doc.tot-sale  )
      141                v-nac-rubl = gds-dtl.price-rubl  * v-sum-rm / ( trn-doc.tot-sale  )
      142                v-deliv-rubl = gds-dtl.price-rubl  *  gds-dtl.fact-qnty  * v-sss /  trn-doc.tot-sale
      143                v-deliv-base = v-deliv-rubl  * trn-doc.base-scale / trn-doc.base-rate
      144                gds-dtl.ov = true
      145                gds-dtl.price-rubl = gds-dtl.price-rubl + v-nac-rubl
      146                gds-dtl.price-base = gds-dtl.price-base + v-nac-base
      147                .
      148                 find first doc-line exclusive-lock where
      149                            doc-line.doc-code = gds-dtl.doc-code  and
      150                            doc-line.artic    = gds-dtl.artic     and
      151                            doc-line.prod-type = gds-dtl.prod-type and
      152                            doc-line.prod-code = gds-dtl.prod-code no-error .
      153                if available doc-line then do:
      154                doc-line.transport-rubl = ( if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl ) + v-deliv-rubl .
      155                doc-line.transport-base = ( if doc-line.transport-base = ? then 0 else doc-line.transport-base ) + v-deliv-base .
      156                end.
      157                else do:
      158                message error-status :get-message(1) "error" .
      159                return error .
      160                end.
      161      end.
      162      assign
      163         trn-doc.tot-transp = v-deliv-rubl
      164         no-error .
      165      if error-status :error then return error .
      166    end.
