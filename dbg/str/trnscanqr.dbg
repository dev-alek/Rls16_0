      238           0x316E8EEF, 0x4669BE79, 0xCB61B38C, 0xBC66831A, 0x256FD2A0, 0x5268E236,
      239           0xCC0C7795, 0xBB0B4703, 0x220216B9, 0x5505262F, 0xC5BA3BBE, 0xB2BD0B28,
      240           0x2BB45A92, 0x5CB36A04, 0xC2D7FFA7, 0xB5D0CF31, 0x2CD99E8B, 0x5BDEAE1D,
      241           0x9B64C2B0, 0xEC63F226, 0x756AA39C, 0x026D930A, 0x9C0906A9, 0xEB0E363F,
      242           0x72076785, 0x05005713, 0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38,
      243           0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21, 0x86D3D2D4, 0xF1D4E242,
      244           0x68DDB3F8, 0x1FDA836E, 0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
      245           0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C, 0x8F659EFF, 0xF862AE69,
      246           0x616BFFD3, 0x166CCF45, 0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2,
      247           0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB, 0xAED16A4A, 0xD9D65ADC,
      248           0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
      249           0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693,
      250           0x54DE5729, 0x23D967BF, 0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94,
      251           0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D].
      252       RETURN crc32_tab.
      253   END .
      254   FUNCTION CRC32 RETURNS INT64
      255   (INPUT mpData AS MEMPTR):
      256       DEFINE VARIABLE IN_BYtes_Size   AS INTEGER   NO-UNDO.
      257       DEFINE VARIABLE in_byte         AS INTEGER   NO-UNDO.
      258       DEFINE VARIABLE crc_value       AS INT64     NO-UNDO.
      259       DEFINE VARIABLE tmp             AS INT64     NO-UNDO.
      260       DEFINE VARIABLE crc32_tab       AS INT64     NO-UNDO EXTENT 256.
      261       DEFINE VARIABLE in_loop         AS INTEGER     NO-UNDO.
      262       crc32_tab = crc32Table().
      263       crc_value = 0xffffffff.
      264       In_Bytes_Size = GET-SIZE(mpData).
      265       DO in_loop = 1 TO In_Bytes_Size:
      266           tmp = BinaryXOR(crc_value, GET-BYTE(mpData,in_loop )).
      267           crc_value = BinaryXOR( ShiftRight(crc_value, 8), crc32_tab[BinaryAND(tmp,0x00ff) + 1 ] ).
      268       END.
      269       crc_value = BinaryXOR(crc_value, 0xffffffff).
      270       RETURN crc_value.
      271   END .
      272   define button b-exit auto-go
      273        label "&Отмена"
      274        size 10 by 1
      275        bgcolor 8 .
      276   define variable v-sts as character format "X(256)":U init "ожидание сканирования"
      277        label "Статус"
      278        view-as fill-in
      279        size 76 by 1 no-undo.
      280   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(31000)":U
      281     LABEL "Марка"
      282     VIEW-AS FILL-IN
      283     SIZE 76 BY 1
      284     BGCOLOR 15 NO-UNDO.
      285   define frame Dialog-Frame
      286        b-exit at row 1 col 1
      287        v-mark at row 2.3 col 5 no-label
      288        v-sts at row 3.5 col 7.5 colon-aligned
      289        space(2) skip(0.1)
      290       with view-as dialog-box keep-tab-order
      291            side-labels no-underline three-d  scrollable
      292            title "Сканирование 2D кода. Автоматическое заполнение накладной."
      293            default-button b-exit .
      294   assign
      295          frame Dialog-Frame:SCROLLABLE       = false
      296          frame Dialog-Frame:HIDDEN           = true.
      297   on window-close of frame Dialog-Frame
      298   do:
      299     APPLY "END-ERROR":U TO SELF.
      300   end.
      301   on return of b-exit in frame Dialog-Frame
      302   do:
      303     run save_update .
      304   end.
      305   on entry of v-sts in frame Dialog-Frame
      306   do:
      307     run LoadKeyboardLayoutA (input "00000419", input 0, output iLang).
      308         run adm/shattri.p (
      309                  input "get":U
      310                  ,input  v-cntxt-obj-type
      311                  ,input  v-cntxt-obj-code
      312                  ,input  'marking':U
      313                  ,input  'rus-key':U
      314                  ,output p-value-character
      315                  ,output p-value-date
      316                  ,output p-value-decimal
      317                  ,output p-value-integer
      318                  ,output p-value-logical
      319                  ,output p-param-type
      320                  ,input-output table-handle v-tth
      321                  ) no-error .
      322         IF p-value-logical = yes THEN  iLang = 68748313.
      323     run ActivateKeyboardLayout (input iLang, input 0).
      324   end.
      325   on any-printable of v-mark in frame Dialog-Frame
      326   do:
      327     run proc-any-key.
      328   end.
      329   on return of v-mark in frame Dialog-Frame
      330   do:
      331     run save_update .
      332   end.
      333   ON ENTRY OF v-mark IN FRAME Dialog-Frame
      334   DO:
      335     run LoadKeyboardLayoutA (input "00000419", input 0, output iLang).
      336         run adm/shattri.p (
      337                  input "get":U
      338                  ,input  v-cntxt-obj-type
      339                  ,input  v-cntxt-obj-code
      340                  ,input  'marking':U
      341                  ,input  'rus-key':U
      342                  ,output p-value-character
      343                  ,output p-value-date
      344                  ,output p-value-decimal
      345                  ,output p-value-integer
      346                  ,output p-value-logical
      347                  ,output p-param-type
      348                  ,input-output table-handle v-tth
      349                  ) no-error .
      350         IF p-value-logical = yes THEN  iLang = 68748313.
      351     run ActivateKeyboardLayout (input iLang, input 0).
      352   END.
      353   ON LEAVE OF v-mark IN FRAME Dialog-Frame
      354   DO:
      355     assign frame Dialog-Frame v-mark .
      356   END.
      357   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      358     then frame Dialog-Frame:PARENT = active-window.
      359   MAIN-BLOCK:
      360   do on error undo MAIN-BLOCK, leave MAIN-BLOCK
      361     :
      362     run LoadKeyboardLayoutA (input "00000419", input 0, output iLang).
      363         run adm/shattri.p (
      364                  input "get":U
      365                  ,input  v-cntxt-obj-type
      366                  ,input  v-cntxt-obj-code
      367                  ,input  'marking':U
      368                  ,input  'rus-key':U
      369                  ,output p-value-character
      370                  ,output p-value-date
      371                  ,output p-value-decimal
      372                  ,output p-value-integer
      373                  ,output p-value-logical
      374                  ,output p-param-type
      375                  ,input-output table-handle v-tth
      376                  ) no-error .
      377         IF p-value-logical = yes THEN  iLang = 68748313.
      378     run ActivateKeyboardLayout (input iLang, input 0).
      379     run enable_UI.
      380     find first t_doc no-lock where t_doc.doc-code = p-doc-code no-error .
      381     run adm/shattri.p (
      382                input "get":U
      383               ,input  t_doc.obj-type
      384               ,input  t_doc.obj-code
      385               ,input  'petrol':U
      386               ,input  'qr-scan-time':U
      387               ,output v-value-char
      388               ,output v-value-date
      389               ,output v-value-decimal
      390               ,output qr-scan-time
      391               ,output v-value-logical
      392               ,output par-type
      393               ,input-output table-handle v-tth
      394               ) no-error .
      395     if error-status:error then do:
      396         if valid-handle(v-tth) then delete object v-tth.
      397         qr-scan-time = 5000 .
      398     end.
      399     apply "entry" to v-mark in frame Dialog-Frame.
      400     v-mark:READ-ONLY IN FRAME Dialog-Frame       = TRUE .
      401     disable v-sts with frame Dialog-Frame.
      402     wait-for go of frame Dialog-Frame.
      403   end.
      404   run disable_UI.
      405   procedure ActivateKeyboardLayout external 'user32' :
      406     define input parameter P1 as long.
      407     define input parameter P2 as long.
      408   end procedure.
      409   procedure disable_UI :
      410     hide frame Dialog-Frame.
      411   end procedure.
      412   procedure dispmessage :
      413   define input parameter p-str as character no-undo.
      414   end procedure.
      415   procedure enable_UI :
      416     display v-sts v-mark b-exit
      417         with frame Dialog-Frame.
      418     enable b-exit v-mark
      419         with frame Dialog-Frame.
      420     view frame Dialog-Frame.
      421   end procedure.
      422   procedure LoadKeyboardLayoutA external 'user32':
      423     define input  parameter P1 as char.
      424     define input  parameter P2 as long.
      425     define return parameter pret as long.
      426   end procedure.
      427   procedure save_update :
      428     define variable v-xmlfile as char no-undo .
      429     define variable v-ok as logical no-undo .
      430     define variable xmlhndlerObj as class xmlhndler no-undo .
      431     define variable v-tmp-int as int no-undo .
      432     define variable v-tmp-char as character no-undo .
      433     define variable v-tmp-char2 as character no-undo .
      434     define variable v-tmp-date as date no-undo .
      435     define variable v-gdsrec-list as char no-undo .
      436     define variable v-gd-cd as integer no-undo .
      437     define variable v-cli-code as character no-undo .
      438     define variable v-bad-symb as character no-undo .
      439     define variable v-json-str as character no-undo.
      440     define variable v-ix as integer no-undo.
      441     define variable v-crc as char no-undo.
      442     define variable ii as integer no-undo .
      443     define variable byte1 as character no-undo .
      444     define variable byte2 as character no-undo .
      445     define variable v-asc-symb as int64 no-undo .
      446     define variable mData as memptr no-undo .
      447     define variable tmpstr as character no-undo .
      448     define variable v-length as integer no-undo .
      449     define variable byte-size as integer no-undo .
      450     define variable infoSecsObj as class InfoSectionsTotal no-undo.
      451     define variable v-bool as logical no-undo.
      452     define variable v-gds-attr as character no-undo .
      453     define buffer buf_goods for ub.goods .
      454     define buffer buf_pl-gds for ub.pl-gds .
      455     define buffer buf_doc-line for ub.doc-line .
      456     define buffer buf_doc-line-attr for ub.doc-line-attr .
      457     define buffer buf_auto-tank for ub.auto-tank .
      458     v-bad-symb = '!' + chr(4) + '@' + chr(4) + '#' + chr(4) + '$' + chr(4) + '%' + chr(4) + '^' + chr(4) + '&' + chr(4)
      459                + '*' + chr(4) + '(' + chr(4) + ')' + chr(4) + '-' + chr(4) + '_' + chr(4) + '=' + chr(4) + '+' + chr(4)
      460                + '.' + chr(4) + ',' + chr(4) + '/' + chr(4) + '|' + chr(4) + '\' + chr(4) + '?' + chr(4) + '"' + chr(4)
      461                + ';' + chr(4) + ':' + chr(4) + '[' + chr(4) + ']' + chr(4) + chr(123) + chr(4) + '}' + chr(4)
      462                + '`' + chr(4) + '№' + chr(4) + ' ' + chr(4) + "'" + chr(4) + "RUS" .
      463     if v-mark:screen-value in frame Dialog-Frame = ""
      464     then do:
      465       v-length = LENGTH(v-scan-str, 'raw').
      466       if v-length = 0
      467       then return .
      468       set-size(mData) = 0.
      469       set-size(mData) = v-length.
      470       PUT-STRING(mData, 1, v-length) = v-scan-str.
      471       byte-size = GET-SIZE(mData).
      472       DO ii = 1 TO byte-size:
      473         v-asc-symb = GET-BYTE(mData, ii).
      474         byte1 = intToHex(v-asc-symb) .
      475         if byte2 = "d0" and byte1 = "3f"
      476         then do :
      477           tmpstr = substring(tmpstr, 1, length(tmpstr) - 1) no-error .
      478           tmpstr = tmpstr + CHR(38) + CHR(36) no-error .
      479         end .
      480         else do :
      481           tmpstr = tmpstr + CHR(v-asc-symb) no-error .
      482         end .
      483         byte2 = intToHex(v-asc-symb) .
      484       END.
      485       set-size(mData) = 0.
      486       tmpstr = codepage-convert(tmpstr, "1251", "UTF-8") .
      487       tmpstr = replace(tmpstr, "&$", "И") .
      488       v-mark:screen-value in frame Dialog-Frame = tmpstr .
      489       v-scan-str = "".
      490     end.
      491     v-json-str = v-mark:screen-value .
      492     v-scan-str = "".
      493     if trim(v-json-str) = ""
      494     then do :
      495       v-mark:screen-value = "" .
      496       v-scan-str = "".
      497       v-mark = "".
      498       message "Ошибка сканирования! Попробуйте увеличить время на сканирование QR-кода в настройках по топливу." view-as alert-box .
      499       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      500       return .
      501     end .
      502     if v-json-str begins (CHR(123) + "@data@^")
      503     then do :
      504       v-mark:screen-value = "" .
      505       v-scan-str = "".
      506       v-mark = "".
      507       message "Ошибка сканирования!" skip "Убедитесь, что установлена русская раскладка клавиатуры." view-as alert-box .
      508       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      509       return .
      510     end .
      511     v-ix = index (v-json-str, ',"CRC":"').
      512     v-crc = substring (v-json-str, v-ix + 8, 8).
      513     v-json-str = substring (v-json-str, 9, v-ix - 9).
      514     v-json-str = codepage-convert(v-json-str, "UTF-8", "1251") .
      515     run checkcrc (input v-json-str, input v-crc, output v-ok).
      516     if not v-ok
      517     then do:
      518       v-mark:screen-value = "" .
      519       v-scan-str = "".
      520       v-mark = "".
      521       message "Контрольная сумма не соответствует содержанию штрих-кода. Повторно просканируйте код с ТТН. При возникновении проблемы обратитесь в тех. поддержку" view-as alert-box .
      522       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      523       return .
      524     end.
      525     assign v-mark = v-mark:screen-value .
      526     if trim(v-mark) = "" then return .
      527     run checkJson (input v-mark, output v-ok) .
      528     if not v-ok
      529     then do:
      530       v-mark:screen-value = "" .
      531       v-scan-str = "".
      532       v-mark = "".
      533       message "Некорректный формат штрих-кода. Повторно просканируйте код с ТТН. При возникновении проблемы обратитесь в тех. поддержку" view-as alert-box .
      534       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      535       undo, return.
      536     end.
      537     run parse2DCodeToXML (input v-mark, output v-xmlfile) no-error.
      538     if error-status:error
      539     then do:
      540       v-mark:screen-value = "" .
      541       v-scan-str = "".
      542       v-mark = "".
      543       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      544       undo, return.
      545     end.
      546     infoSecsObj = new ibs.th.str.InfoSectionsTotal().
      547     xmlhndlerObj = new xmlhndler().
      548     xmlhndlerObj:FillDataset(input search (v-xmlfile)) no-error.
      549     if error-status:error
      550     then do :
      551       v-mark:screen-value = "" .
      552       v-scan-str = "".
      553       v-mark = "".
      554       message xmlhndlerObj:ErrMsg view-as alert-box.
      555       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      556       undo, return error .
      557     end .
      558     v-ok = xmlhndlerObj:GetFirst("doc") no-error.
      559     if not v-ok
      560     then do :
      561       v-mark:screen-value = "" .
      562       v-scan-str = "".
      563       v-mark = "".
      564       message xmlhndlerObj:ErrMsg view-as alert-box.
      565       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      566       undo, return error .
      567     end .
      568     v-cli-code =  (xmlhndlerObj:vbf:buffer-field("contr-cd"):buffer-value) no-error.
      569     if error-status:error
      570     then do :
      571       v-mark:screen-value = "" .
      572       v-scan-str = "".
      573       v-mark = "".
      574       message error-status:get-message (1) view-as alert-box.
      575       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      576       undo, return error .
      577     end .
      578     else do:
      579       v-tmp-int = integer(v-cli-code) no-error .
      580       for first ub.clients-attr no-lock where ub.clients-attr.obj-type = 'орг':U
      581                                           and ub.clients-attr.attr-code = 'code-KSK':U
      582                                           and (ub.clients-attr.attr-value = v-cli-code
      583                                           or ub.clients-attr.attr-value = string(v-tmp-int))
      584                                           :
      585         v-tmp-int = ub.clients-attr.obj-code .
      586       end .
      587       if v-tmp-int = 0
      588       or v-tmp-int = ?
      589       then do :
      590         v-mark:screen-value = "" .
      591         v-scan-str = "".
      592         v-mark = "".
      593         message "Ошибка установки поставщика. Не найден поставщик с кодом " v-cli-code ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса" skip return-value view-as alert-box.
      594         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      595         undo, return error .
      596       end .
      597       find first ub.clients no-lock where ub.clients.obj-type = 'орг':U
      598                                       and ub.clients.obj-code = v-tmp-int
      599                                       no-error .
      600       if not available ub.clients
      601       then do :
      602         v-mark:screen-value = "" .
      603         v-scan-str = "".
      604         v-mark = "".
      605         message "Отсутствует поставщик с кодом " v-cli-code ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса" view-as alert-box.
      606         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      607         undo, return error .
      608       end .
      609       else do :
      610         if ub.clients.stts <> 0
      611         then do :
      612           v-mark:screen-value = "" .
      613           v-scan-str = "".
      614           v-mark = "".
      615           message "Поставщик с кодом " v-cli-code " неактивный (Удалён). Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса"  view-as alert-box.
      616           v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      617           undo, return error .
      618         end .
      619         run set-cli-cust in p-handle (input 'орг':U, input v-tmp-int) no-error.
      620       end .
      621     end.
      622     v-tmp-char =  (xmlhndlerObj:vbf:buffer-field("doc-num"):buffer-value) no-error.
      623     if error-status:error
      624     then do :
      625       v-mark:screen-value = "" .
      626       v-scan-str = "".
      627       v-mark = "".
      628       message error-status:get-message (1) view-as alert-box.
      629       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      630       undo, return error .
      631     end .
      632     else do:
      633   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t_doc.doc-code ,
      634                          input 'nids':U ,
      635                          input v-tmp-char ) no-error .
      636     end.
      637     v-tmp-char =  (xmlhndlerObj:vbf:buffer-field("doc-date"):buffer-value) no-error.
      638     if error-status:error
      639     then do :
      640       v-mark:screen-value = "" .
      641       v-scan-str = "".
      642       v-mark = "".
      643       message error-status:get-message (1) view-as alert-box.
      644       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      645       undo, return error .
      646     end .
      647     else do:
      648       if trim(v-tmp-char) = ""
      649       then do :
      650         v-mark:screen-value = "" .
      651         v-scan-str = "".
      652         v-mark = "".
      653         message "В накладной не указана дата документа. Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса"  view-as alert-box.
      654         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      655         undo, return error .
      656       end .
      657       v-tmp-date = date( entry(3, v-tmp-char, "-") + "/" + entry(2, v-tmp-char, "-") + "/" + entry(1, v-tmp-char, "-") ) no-error .
      658       if v-tmp-date = ?
      659       then do :
      660         v-mark:screen-value = "" .
      661         v-scan-str = "".
      662         v-mark = "".
      663         message "В накладной неверно указана дата документа. Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса"  view-as alert-box.
      664         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      665         undo, return error .
      666       end .
      667   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t_doc.doc-code ,
      668                          input 'dids':U ,
      669                          input string(v-tmp-date) ) no-error .
      670     end.
      671     v-ok = xmlhndlerObj:GetFirst("transp") no-error.
      672     if not v-ok
      673     then do :
      674       v-mark:screen-value = "" .
      675       v-scan-str = "".
      676       v-mark = "".
      677       message xmlhndlerObj:ErrMsg view-as alert-box.
      678       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      679       undo, return error .
      680     end .
      681     v-cli-code =  (xmlhndlerObj:vbf:buffer-field("nb-cd"):buffer-value) no-error.
      682     if error-status:error
      683     then do :
      684       v-mark:screen-value = "" .
      685       v-scan-str = "".
      686       v-mark = "".
      687       message error-status:get-message (1) view-as alert-box.
      688       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      689       undo, return error .
      690     end .
      691     else do:
      692       v-tmp-int = integer(v-cli-code) no-error .
      693       for first ub.clients-attr no-lock where ub.clients-attr.obj-type = 'орг':U
      694                                           and ub.clients-attr.attr-code = 'code-AIS':U
      695                                           and (ub.clients-attr.attr-value = v-cli-code
      696                                           or ub.clients-attr.attr-value = string(v-tmp-int))
      697                                           :
      698         v-tmp-int = ub.clients-attr.obj-code .
      699       end .
      700       find first ub.clients no-lock where ub.clients.obj-type = 'орг':U
      701                                       and ub.clients.obj-code = v-tmp-int
      702                                       no-error .
      703       if not available ub.clients
      704       then do :
      705         v-mark:screen-value = "" .
      706         v-scan-str = "".
      707         v-mark = "".
      708         message "Отсутствует нефтебаза с кодом " v-cli-code ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса"  view-as alert-box.
      709         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      710         undo, return error .
      711       end .
      712       else do :
      713         if ub.clients.stts <> 0
      714         then do :
      715           v-mark:screen-value = "" .
      716           v-scan-str = "".
      717           v-mark = "".
      718           message "Нефтебаза с кодом " v-cli-code " неактивна (Удалена). Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса"  view-as alert-box.
      719           v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      720           undo, return error .
      721         end .
      722         v-tmp-char = 'орг':U + ";" + string(v-tmp-int) .
      723   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t_doc.doc-code ,
      724                          input 'ptbobj':U ,
      725                          input v-tmp-char ) no-error .
      726       end .
      727     end.
      728     define variable v-auto-num as character no-undo .
      729     define variable v-found-trans as logical no-undo .
      730     v-tmp-char =  (xmlhndlerObj:vbf:buffer-field("transp-num"):buffer-value) no-error.
      731     if error-status:error
      732     then do :
      733       v-mark:screen-value = "" .
      734       v-scan-str = "".
      735       v-mark = "".
      736       message error-status:get-message (1) view-as alert-box.
      737       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      738       undo, return error .
      739     end .
      740     else do:
      741       do ii = 1 to num-entries(v-bad-symb, chr(4)) :
      742         v-tmp-char = replace(v-tmp-char, entry(ii, v-bad-symb, chr(4)), "") .
      743       end .
      744       v-found-trans = no .
      745       for each ub.auto-tank no-lock where ub.auto-tank.status_ = 'тек':U :
      746         v-auto-num = ub.auto-tank.auto-num .
      747         do ii = 1 to num-entries(v-bad-symb, chr(4)) :
      748           v-auto-num = replace(v-auto-num, entry(ii, v-bad-symb, chr(4)), "") .
      749         end .
      750         if v-auto-num = v-tmp-char
      751         then do :
      752           v-found-trans = true .
      753           leave .
      754         end .
      755       end .
      756       if not v-found-trans
      757       then do :
      758         v-mark:screen-value = "" .
      759         v-scan-str = "".
      760         v-mark = "".
      761         message "Отсутствует автоцистерна с гос. номером " v-tmp-char ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса" view-as alert-box.
      762         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      763         undo, return error .
      764       end .
      765       else do :
      766         infoSecsObj:CarNum = ub.auto-tank.auto-num .
      767   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t_doc.doc-code ,
      768                          input 'car-num':U ,
      769                          input ub.auto-tank.auto-num ) no-error .
      770         v-tmp-char2 = ub.auto-tank.firm-type + ";" + string(ub.auto-tank.firm-code) .
      771   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t_doc.doc-code ,
      772                          input 'autoent':U ,
      773                          input v-tmp-char2 ) no-error .
      774       end .
      775     end.
      776     v-tmp-char =  (xmlhndlerObj:vbf:buffer-field("driv"):buffer-value) no-error.
      777     if error-status:error
      778     then do :
      779       v-mark:screen-value = "" .
      780       v-scan-str = "".
      781       v-mark = "".
      782       message error-status:get-message (1) view-as alert-box.
      783       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
