      800     end .
      801     else do:
      802   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t_doc.doc-code ,
      803                          input 'seals-condition':U ,
      804                          input v-tmp-char ) no-error .
      805     end.
      806     v-ok = xmlhndlerObj:GetFirst("scs") no-error.
      807     if not v-ok
      808     then do :
      809       v-mark:screen-value = "" .
      810       v-scan-str = "".
      811       v-mark = "".
      812       message xmlhndlerObj:ErrMsg view-as alert-box.
      813       v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      814       undo, return error .
      815     end .
      816     rep_:
      817     repeat:
      818       if available ub.auto-tank
      819       then do :
      820         find first ub.auto-section no-lock where ub.auto-section.auto-num = ub.auto-tank.auto-num
      821                                              and ub.auto-section.section-num = xmlhndlerObj:vbf:buffer-field("sc-num"):buffer-value
      822                                              no-error .
      823         if not available ub.auto-section
      824         then do :
      825           v-mark:screen-value = "" .
      826           v-scan-str = "".
      827           v-mark = "".
      828           message "Для автоцистерны с номером " ub.auto-tank.auto-num " не найдена секция " xmlhndlerObj:vbf:buffer-field("sc-num"):buffer-value ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса" view-as alert-box title "Ошибка".
      829           if not xmlhndlerObj:GetNext()
      830             then leave rep_.
      831           next rep_.
      832         end .
      833       end .
      834       v-gd-cd = xmlhndlerObj:vbf:buffer-field("gd-cd"):buffer-value no-error.
      835       if error-status:error
      836       then do:
      837         v-mark:screen-value = "" .
      838         v-scan-str = "".
      839         v-mark = "".
      840         message error-status:get-message (1) view-as alert-box.
      841         v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      842         if not xmlhndlerObj:GetNext()
      843           then leave rep_.
      844         next rep_.
      845       end.
      846       else do:
      847         v-tmp-int = v-gd-cd .
      848         v-tmp-char = "" .
      849         for each ub.goods-attr no-lock where ub.goods-attr.attr-code = 'gds-code-AIS':U
      850                                          and trim(ub.goods-attr.attr-value) > ""
      851                                          :
      852           v-gds-attr = replace(ub.goods-attr.attr-value, " ", "") .
      853           if lookup(string(v-gd-cd), v-gds-attr) > 0
      854           then do :
      855             v-tmp-char = v-tmp-char + string(ub.goods-attr.gds-code) + "," .
      856             v-tmp-int = ub.goods-attr.gds-code .
      857           end .
      858         end .
      859         v-tmp-char = trim(v-tmp-char, ",") .
      860         if num-entries(v-tmp-char) > 1
      861         then do :
      862           message "Коду топлива " string(v-gd-cd) " соответствуют несколько товаров TH." skip "Выберите  топливо по справочнику ТН,  соответствующее  топливу сливаемой секции АЦ по ТТН (секция №" xmlhndlerObj:vbf:buffer-field("sc-num"):buffer-value ")."
      863           view-as alert-box .
      864           run str\chs-gd-from-list.w (input v-tmp-char,
      865                                       output v-tmp-int) .
      866           if v-tmp-int = 0
      867           or v-tmp-int = ?
      868           then do :
      869             next rep_.
      870           end .
      871         end .
      872         find first ub.goods where ub.goods.gds-code = v-tmp-int no-lock no-error.
      873         if not available (ub.goods)
      874         then do:
      875           v-mark:screen-value = "" .
      876           v-scan-str = "".
      877           v-mark = "".
      878           message "Для секции ТТН № " xmlhndlerObj:vbf:buffer-field("sc-num"):buffer-value "отсутствует товар с кодом " v-gd-cd ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса" view-as alert-box title "Ошибка".
      879           if not xmlhndlerObj:GetNext()
      880             then leave rep_.
      881           next rep_.
      882         end.
      883         find first ub.pl-gds no-lock where ub.pl-gds.obj-type   = t_doc.obj-type
      884                                        and ub.pl-gds.obj-code   = t_doc.obj-code
      885                                        and ub.pl-gds.gds-code   = ub.goods.gds-code
      886                                        no-error .
      887         if not available (ub.pl-gds)
      888         then do:
      889           v-mark:screen-value = "" .
      890           v-scan-str = "".
      891           v-mark = "".
      892           message "Для товара с кодом " v-tmp-int " не удалось определить резервуар для приема НП" ". Для внесения в систему данных обратитесь к ответственному сотруднику регионального офиса" view-as alert-box title "Ошибка".
      893           if not xmlhndlerObj:GetNext()
      894             then leave rep_.
      895           next rep_.
      896         end.
      897         if lookup (string (recid (ub.goods)), v-gdsrec-list) = 0
      898         then do:
      899           v-gdsrec-list = string (v-gdsrec-list) + "," + string (recid (ub.goods)).
      900           infoSecsObj:Initialization(t_doc.doc-code, ub.goods.gds-code).
      901           infoSecsObj:GetInfoSectionProp().
      902         end.
      903         else do :
      904           infoSecsObj:Initialization(t_doc.doc-code, ub.goods.gds-code).
      905           infoSecsObj:NewSection().
      906         end .
      907         infoSecsObj:InfoSectionCurr:SectionName = xmlhndlerObj:vbf:buffer-field("sc-num"):buffer-value no-error.
      908         infoSecsObj:InfoSectionCurr:SetCarVol(infoSecsObj:InfoSectionCurr:SectionName) .
      909         infoSecsObj:InfoSectionCurr:DocVolume = xmlhndlerObj:vbf:buffer-field("vol"):buffer-value no-error.
      910         infoSecsObj:InfoSectionCurr:CliQnty = xmlhndlerObj:vbf:buffer-field("mass"):buffer-value no-error.
      911         infoSecsObj:InfoSectionCurr:DocDensity = xmlhndlerObj:vbf:buffer-field("dens"):buffer-value / 1000 no-error.
      912         infoSecsObj:InfoSectionCurr:DocQnty = infoSecsObj:InfoSectionCurr:CliQnty / infoSecsObj:InfoSectionCurr:DocDensity .
      913         infoSecsObj:InfoSectionCurr:TTNTemp = xmlhndlerObj:vbf:buffer-field("temp"):buffer-value no-error.
      914         v-tmp-int = xmlhndlerObj:vbf:buffer-field("gd-gr"):buffer-value no-error.
      915         if not error-status:error
      916         then do :
      917           case v-tmp-int:
      918             when 1 then infoSecsObj:InfoSectionCurr:GroupNP = "I" .
      919             when 2 then infoSecsObj:InfoSectionCurr:GroupNP = "II" .
      920             when 3 then infoSecsObj:InfoSectionCurr:GroupNP = "III" .
      921             when 4 then infoSecsObj:InfoSectionCurr:GroupNP = "IV" .
      922             otherwise infoSecsObj:InfoSectionCurr:GroupNP = "" .
      923           end case .
      924         end .
      925         v-tmp-int = xmlhndlerObj:vbf:buffer-field("fill-type"):buffer-value no-error.
      926         if not error-status:error
      927         then do :
      928           case v-tmp-int:
      929             when 0 then infoSecsObj:InfoSectionCurr:Pour = "Верхний налив" .
      930             when 1 then infoSecsObj:InfoSectionCurr:Pour = "Нижний налив" .
      931             otherwise infoSecsObj:InfoSectionCurr:Pour = "Верхний налив" .
      932           end case .
      933         end .
      934         infoSecsObj:InfoSectionCurr:DocDensST = xmlhndlerObj:vbf:buffer-field("dens-st"):buffer-value / 1000 no-error.
      935         infoSecsObj:InfoSectionCurr:AccShip = xmlhndlerObj:vbf:buffer-field("contr-err"):buffer-value no-error.
      936         infoSecsObj:InfoSectionCurr:PaspDens = xmlhndlerObj:vbf:buffer-field("dens-pas"):buffer-value / 1000 no-error.
      937         infoSecsObj:InfoSectionCurr:NumPassport = xmlhndlerObj:vbf:buffer-field("pasp"):buffer-value no-error.
      938         infoSecsObj:SaveDBNoCheck().
      939         if not xmlhndlerObj:GetNext()
      940           then leave rep_.
      941       end.
      942     end.
      943     v-gdsrec-list = left-trim (v-gdsrec-list, ",").
      944     v-mark:screen-value = "" .
      945     v-scan-str = "".
      946     v-mark = "".
      947     v-sts:screen-value in frame Dialog-Frame = "ожидание сканирования" .
      948     run cycle-add-cust in p-handle (input v-gdsrec-list) no-error.
      949     if error-status:error
      950       then message "Ошибка добавление товара." return-value view-as alert-box.
      951     v-sts:screen-value in frame Dialog-Frame  = "считано".
      952     for each buf_doc-line-attr exclusive-lock where buf_doc-line-attr.doc-code = t_doc.doc-code,
      953     first buf_goods no-lock where buf_goods.gds-code = buf_doc-line-attr.gds-code
      954     :
      955       if not can-find (first buf_doc-line no-lock where buf_doc-line.doc-code = buf_doc-line-attr.doc-code
      956                                                     and buf_doc-line.artic = buf_goods.artic
      957                                                     and buf_doc-line.prod-code = buf_goods.prod-code
      958                                                     and buf_doc-line.prod-type = buf_goods.prod-type)
      959       then do :
      960         delete buf_doc-line-attr .
      961       end .
      962     end .
      963     delete object infoSecsObj no-error .
      964     apply "choose" to b-exit in frame Dialog-Frame.
      965   end procedure.
      966   procedure parse2DCodeToXML :
      967     define input parameter p-2dcode as char no-undo.
      968     define output parameter p-xmlfile as char no-undo.
      969     define variable v-ok as logical no-undo .
      970     define variable v-json-str as character no-undo.
      971     define variable v-ix as integer no-undo.
      972     define variable v-crc as char no-undo.
      973     define variable cmd as char no-undo.
      974     v-json-str = p-2dcode.
      975     v-scan-str = "".
      976     v-ix = index (v-json-str, ',"CRC":"').
      977     v-crc = substring (v-json-str, v-ix + 8, 8).
      978     v-json-str = substring (v-json-str, 9, v-ix - 9).
      979     v-json-str = replace(v-json-str, '\', '\\') .
      980     v-json-str = replace(v-json-str, '/', '\/') .
      981     output to "qr2d.json" convert target 'UTF-8'.
      982     put unformatted v-json-str.
      983     output close.
      984     cmd = substitute ('&1 -file=&2 >&3',
      985                        search("exe/json2xml.exe"),
      986                        search("qr2d.json"),
      987                        "qr2d.xml"
      988                        ) .
      989     os-command silent value (cmd).
      990     file-info:file-name = search("qr2d.xml") .
      991     if file-info:file-size = 0
      992     then do :
      993       v-ok = false .
      994       v-sts = "oшибка при конвертации json в XML. Файл " + search("qr2d.xml") + " пустой (размер 0 байт)." .
      995       return error.
      996     end .
      997     p-xmlfile = search("qr2d.xml").
      998   end.
      999   procedure checkJson :
     1000     define input parameter p-str as character no-undo .
     1001     define output parameter p-ok as logical no-undo .
     1002     define variable v-num-sec as integer no-undo .
     1003     define variable v-tmp-str as character no-undo .
     1004     define variable ii as integer no-undo .
     1005     define variable v-num-teg as integer no-undo .
     1006     p-ok = yes .
     1007     if index(p-str, '"data"') = 0
     1008     then do :
     1009       p-ok = no .
     1010       return .
     1011     end .
     1012     if index(p-str, '"CRC"') = 0
     1013     then do :
     1014       p-ok = no .
     1015       return .
     1016     end .
     1017     if index(p-str, '"doc"') = 0
     1018     then do :
     1019       p-ok = no .
     1020       return .
     1021     end .
     1022     if index(p-str, '"contr-cd"') = 0
     1023     then do :
     1024       p-ok = no .
     1025       return .
     1026     end .
     1027     if index(p-str, '"doc-date"') = 0
     1028     then do :
     1029       p-ok = no .
     1030       return .
     1031     end .
     1032     if index(p-str, '"doc-num"') = 0
     1033     then do :
     1034       p-ok = no .
     1035       return .
     1036     end .
     1037     if index(p-str, '"transp"') = 0
     1038     then do :
     1039       p-ok = no .
     1040       return .
     1041     end .
     1042     if index(p-str, '"nb-cd"') = 0
     1043     then do :
     1044       p-ok = no .
     1045       return .
     1046     end .
     1047     if index(p-str, '"transp-num"') = 0
     1048     then do :
     1049       p-ok = no .
     1050       return .
     1051     end .
     1052     if index(p-str, '"driv"') = 0
     1053     then do :
     1054       p-ok = no .
     1055       return .
     1056     end .
     1057     if index(p-str, '"scs"') = 0
     1058     then do :
     1059       p-ok = no .
     1060       return .
     1061     end .
     1062     if index(p-str, '"sc-num"') = 0
     1063     then do :
     1064       p-ok = no .
     1065       return .
     1066     end .
     1067     if index(p-str, '"gd-cd"') = 0
     1068     then do :
     1069       p-ok = no .
     1070       return .
     1071     end .
     1072     if index(p-str, '"gd-gr"') = 0
     1073     then do :
     1074       p-ok = no .
     1075       return .
     1076     end .
     1077     if index(p-str, '"fill-type"') = 0
     1078     then do :
     1079       p-ok = no .
     1080       return .
     1081     end .
     1082     if index(p-str, '"temp"') = 0
     1083     then do :
     1084       p-ok = no .
     1085       return .
     1086     end .
     1087     if index(p-str, '"dens"') = 0
     1088     then do :
     1089       p-ok = no .
     1090       return .
     1091     end .
     1092     if index(p-str, '"mass"') = 0
     1093     then do :
     1094       p-ok = no .
     1095       return .
     1096     end .
     1097     if index(p-str, '"vol"') = 0
     1098     then do :
     1099       p-ok = no .
     1100       return .
     1101     end .
     1102     if index(p-str, '"dens-st"') = 0
     1103     then do :
     1104       p-ok = no .
     1105       return .
     1106     end .
     1107     if index(p-str, '"contr-err"') = 0
     1108     then do :
     1109       p-ok = no .
     1110       return .
     1111     end .
     1112     if index(p-str, '"pasp"') = 0
     1113     then do :
     1114       p-ok = no .
     1115       return .
     1116     end .
     1117     if index(p-str, '"dens-pas"') = 0
     1118     then do :
     1119       p-ok = no .
     1120       return .
     1121     end .
     1122     v-tmp-str = p-str .
     1123     v-tmp-str = substring(v-tmp-str, index(v-tmp-str, '"scs"') + 6) .
     1124     v-tmp-str = replace(v-tmp-str, chr(123), "") .
     1125     v-tmp-str = replace(v-tmp-str, chr(125), "") .
     1126     v-tmp-str = replace(v-tmp-str, "[", "") .
     1127     v-tmp-str = replace(v-tmp-str, "]", "") .
     1128     v-num-sec = 0 .
     1129     do ii = 1 to num-entries(v-tmp-str) :
     1130       if entry(ii, v-tmp-str) begins '"sc-num"' then v-num-sec = v-num-sec + 1 .
     1131     end.
     1132     v-num-teg = 0 .
     1133     do ii = 1 to num-entries(v-tmp-str) :
     1134       if entry(ii, v-tmp-str) begins '"gd-cd"' then v-num-teg = v-num-teg + 1 .
     1135     end.
     1136     if v-num-teg <> v-num-sec
     1137     then do :
     1138       p-ok = no .
     1139       return .
     1140     end .
     1141     v-num-teg = 0 .
     1142     do ii = 1 to num-entries(v-tmp-str) :
     1143       if entry(ii, v-tmp-str) begins '"gd-gr"' then v-num-teg = v-num-teg + 1 .
     1144     end.
     1145     if v-num-teg <> v-num-sec
     1146     then do :
     1147       p-ok = no .
     1148       return .
     1149     end .
     1150     v-num-teg = 0 .
     1151     do ii = 1 to num-entries(v-tmp-str) :
     1152       if entry(ii, v-tmp-str) begins '"fill-type"' then v-num-teg = v-num-teg + 1 .
     1153     end.
     1154     if v-num-teg <> v-num-sec
     1155     then do :
     1156       p-ok = no .
     1157       return .
     1158     end .
     1159     v-num-teg = 0 .
     1160     do ii = 1 to num-entries(v-tmp-str) :
     1161       if entry(ii, v-tmp-str) begins '"temp"' then v-num-teg = v-num-teg + 1 .
     1162     end.
     1163     if v-num-teg <> v-num-sec
     1164     then do :
     1165       p-ok = no .
     1166       return .
     1167     end .
     1168     v-num-teg = 0 .
     1169     do ii = 1 to num-entries(v-tmp-str) :
     1170       if entry(ii, v-tmp-str) begins '"dens"' then v-num-teg = v-num-teg + 1 .
     1171     end.
     1172     if v-num-teg <> v-num-sec
     1173     then do :
     1174       p-ok = no .
     1175       return .
     1176     end .
     1177     v-num-teg = 0 .
     1178     do ii = 1 to num-entries(v-tmp-str) :
     1179       if entry(ii, v-tmp-str) begins '"mass"' then v-num-teg = v-num-teg + 1 .
     1180     end.
     1181     if v-num-teg <> v-num-sec
     1182     then do :
     1183       p-ok = no .
     1184       return .
     1185     end .
     1186     v-num-teg = 0 .
     1187     do ii = 1 to num-entries(v-tmp-str) :
     1188       if entry(ii, v-tmp-str) begins '"vol"' then v-num-teg = v-num-teg + 1 .
     1189     end.
     1190     if v-num-teg <> v-num-sec
     1191     then do :
     1192       p-ok = no .
     1193       return .
     1194     end .
     1195     v-num-teg = 0 .
     1196     do ii = 1 to num-entries(v-tmp-str) :
     1197       if entry(ii, v-tmp-str) begins '"dens-st"' then v-num-teg = v-num-teg + 1 .
     1198     end.
     1199     if v-num-teg <> v-num-sec
     1200     then do :
     1201       p-ok = no .
     1202       return .
     1203     end .
     1204     v-num-teg = 0 .
     1205     do ii = 1 to num-entries(v-tmp-str) :
     1206       if entry(ii, v-tmp-str) begins '"contr-err"' then v-num-teg = v-num-teg + 1 .
     1207     end.
     1208     if v-num-teg <> v-num-sec
     1209     then do :
     1210       p-ok = no .
     1211       return .
     1212     end .
     1213     v-num-teg = 0 .
     1214     do ii = 1 to num-entries(v-tmp-str) :
     1215       if entry(ii, v-tmp-str) begins '"pasp"' then v-num-teg = v-num-teg + 1 .
     1216     end.
     1217     if v-num-teg <> v-num-sec
     1218     then do :
     1219       p-ok = no .
     1220       return .
     1221     end .
     1222     v-num-teg = 0 .
     1223     do ii = 1 to num-entries(v-tmp-str) :
     1224       if entry(ii, v-tmp-str) begins '"dens-pas"' then v-num-teg = v-num-teg + 1 .
     1225     end.
     1226     if v-num-teg <> v-num-sec
     1227     then do :
     1228       p-ok = no .
     1229       return .
     1230     end .
     1231   end .
     1232   procedure checkcrc:
     1233     define input parameter p-json-str as char no-undo.
     1234     define input parameter p-crc32 as char no-undo.
     1235     define output parameter p-ok as logical no-undo.
     1236     define variable v-crc32   as character no-undo .
     1237     define variable mpData    as memptr    no-undo .
     1238     define variable inLength  as integer   no-undo .
     1239     p-ok = false.
     1240     inLength     = LENGTH(p-json-str, 'raw').
     1241     set-size(mpData) = 0.
     1242     set-size(mpData) = inLength.
     1243     PUT-STRING(mpData,1,inLength) = p-json-str.
     1244     v-crc32 =  intToHex(CRC32(INPUT mpData)) .
     1245     set-size(mpData) = 0.
     1246     if length(v-crc32) < 8
     1247     then
     1248       v-crc32 = fill("0", 8 - length(v-crc32)) + v-crc32 .
     1249     if p-crc32 = v-crc32
     1250     then do :
     1251       p-ok = true.
     1252     end .
     1253   end.
     1254   procedure proc-any-key :
     1255     if v-scan-str = ""
     1256     then
     1257       v-timedelay = etime.
     1258     else
     1259     if etime - v-timedelay > qr-scan-time
     1260     then
     1261       v-scan-str = "".
     1262     v-scan-str = v-scan-str + last-event:label.
     1263   end.
