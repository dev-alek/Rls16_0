      147   FUNCTION BinaryXOR RETURNS INT64(INPUT intOperand1 AS INT64,
      148                                    INPUT intOperand2 AS INT64)
      149                                    forward .
      150   FUNCTION ShiftRight RETURNS INT64(INPUT in_Operand_A AS INT64,
      151                                     INPUT in_Operand_B AS INTEGER)
      152                                     forward .
      153   FUNCTION BinaryAND RETURNS INTEGER (INPUT in_Operand_A AS INT64,
      154                                       INPUT in_Operand_B AS INT64)
      155                                       forward .
      156   FUNCTION intToHex RETURNS CHARACTER (i_iint AS INT64) forward .
      157   FUNCTION crc32Table RETURNS INT64 EXTENT 256  () forward .
      158   FUNCTION CRC32 RETURNS INT64 (INPUT mpData AS MEMPTR) forward .
      159   FUNCTION BinaryXOR RETURNS INT64
      160   (INPUT intOperand1 AS INT64,
      161    INPUT intOperand2 AS INT64):
      162       DEFINE VARIABLE iByteLoop  AS INTEGER NO-UNDO.
      163       DEFINE VARIABLE iXOResult  AS INT64 NO-UNDO.
      164       DEFINE VARIABLE lFirstBit  AS LOGICAL NO-UNDO.
      165       DEFINE VARIABLE lSecondBit AS LOGICAL NO-UNDO.
      166       iXOResult = 0.
      167       DO iByteLoop = 1 TO 64:
      168           ASSIGN
      169           lFirstBit  = LOGICAL(GET-BITS(intOperand1,iByteLoop  ,1))
      170           lSecondBit = LOGICAL(GET-BITS(intOperand2,iByteLoop , 1)).
      171           IF (lFirstBit  AND NOT lSecondBit) OR
      172              (lSecondBit AND NOT lFirstBit) THEN
      173               iXOResult = iXOResult + EXP(2, iByteLoop - 1).
      174       END.
      175       RETURN iXOResult.
      176   END .
      177   FUNCTION ShiftRight RETURNS INT64
      178   (INPUT in_Operand_A AS INT64,
      179    INPUT in_Operand_B AS INTEGER):
      180      RETURN INT64( TRUNCATE( in_Operand_A / EXP(2,in_Operand_B), 0 ) ).
      181   END .
      182   FUNCTION BinaryAND RETURNS INTEGER
      183   (INPUT in_Operand_A AS INT64,
      184    INPUT in_Operand_B AS INT64):
      185      DEFINE VARIABLE in_cbit     AS INTEGER     NO-UNDO.
      186      DEFINE VARIABLE in_result   AS INT64     NO-UNDO.
      187      DO in_cbit = 1 TO 64:
      188         IF LOGICAL( GET-BITS( in_Operand_A, in_cbit, 1 ) ) AND
      189            LOGICAL( GET-BITS( in_Operand_B, in_cbit, 1 ) )
      190         THEN
      191            PUT-BITS( in_result, in_cbit, 1 ) = 1.
      192     END.
      193     RETURN in_result.
      194   END .
      195   FUNCTION intToHex RETURNS CHARACTER
      196   (i_iint AS INT64):
      197      DEF VAR chex  AS CHAR NO-UNDO.
      198      DEF VAR rbyte AS RAW  NO-UNDO.
      199      DO WHILE i_iint > 0:
      200         PUT-BYTE( rbyte, 1 ) = i_iint MODULO 256.
      201         chex = STRING( HEX-ENCODE( rbyte ) ) + chex.
      202         i_iint = TRUNCATE( i_iint / 256, 0 ).
      203      END.
      204      RETURN chex.
      205   END .
