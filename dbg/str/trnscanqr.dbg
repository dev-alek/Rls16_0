      120     define variable v-cntxt-obj-code      as integer   no-undo .
      121     define variable v-cntxt-db-num-obj    as integer   no-undo .
      122     define variable v-cntxt-is-admin      as logical   no-undo .
      123   define input  parameter parparentproc         as handle              no-undo .
      124   define input  parameter p-doc-code            as character           no-undo .
      125   define input  parameter p-mode                as character           no-undo .
      126   define input  parameter p-handle              as handle              no-undo .
      127   define variable iLang           as integer   no-undo.
      128   define variable p-value-logical as logical no-undo.
      129   define variable p-value-character  as character no-undo.
      130   define variable p-value-date       as date no-undo.
      131   define variable p-value-decimal    as decimal no-undo.
      132   define variable p-value-integer    as integer no-undo.
      133   define variable p-param-type       as character no-undo.
      134   define variable v-tth as handle no-undo .
      135   define variable par-type          as character no-undo .
      136   define variable v-value-char      as character no-undo .
      137   define variable v-value-date      as date      no-undo .
      138   define variable v-value-decimal   as decimal   no-undo .
      139   define variable qr-scan-time      as integer   no-undo .
      140   define variable v-value-logical   as logical   no-undo .
      141   define buffer t_doc        for ub.trn-doc .
      142   define buffer bf_doc-line  for ub.doc-line.
      143   define variable v-timedelay  as integer   no-undo.
      144   define variable v-scan-str as character no-undo.
      145   define stream str-err .
