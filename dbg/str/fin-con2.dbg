        1   DEFINE TEMP-TABLE temp_fin-doc NO-UNDO LIKE ub.fin-doc
        2          field no-con-sum as decimal
        3          field is-plus as logical
        4          field ri as recid .
        5     define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        6     define input  parameter p-host-code    as integer    no-undo .
        7     define input  parameter p-ri           as  recid     no-undo .
        8     define input  parameter p-list         as  character no-undo .
        9     define output parameter p-end          as logical initial no  no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Связка фин. обязательств с платежами - 1 ФО и много платежей".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define new global shared variable g#language as character no-undo .
      116   if g#language <> '' and g#language <> 'rus':U then do:
      117     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   procedure cur-time :
      121      define output parameter p-today as date      no-undo .
      122      define output parameter p-time  as integer   no-undo .
      123     do
      124     on error undo, return error
      125     :
      126       define variable v-date1 as date      no-undo .
      127       define variable v-date2 as date      no-undo .
      128       define variable v-time  as integer   no-undo .
      129       assign
      130         v-date1 = today
      131         v-time  = time
      132         v-date2 = today
      133       .
      134       if v-date1 <> v-date2
      135       then do:
      136         assign
      137           v-date1 = today
      138           v-time  = v-time
      139         .
      140       end.
      141       assign
      142         p-today = v-date1
      143         p-time  = v-time
      144       .
      145     end.
      146   end.
      147   function cur-time-date returns character
      148   :
      149     return string(today, '99/99/9999':U) .
      150   end.
      151   function cur-time-mjd returns decimal
      152   :
      153     define variable v-date as date      no-undo .
      154     define variable v-time as integer   no-undo .
      155     run cur-time in this-procedure
      156       (output v-date
      157       ,output v-time
      158       ) .
      159     return integer(v-date) - 2400002 + (v-time / 86400) .
      160   end.
      161   function cur-time-get-ending-index returns integer
      162   (input p-number as integer
      163   )
      164   :
      165     if p-number < 0
      166     or p-number = ?
      167     then do:
      168       return 1 .
      169     end.
      170     define variable v-rest as integer   no-undo .
      171     assign
      172       p-number = p-number modulo 100
      173     .
      174     if p-number < 20
      175     then do:
      176       assign
      177         v-rest = p-number
      178       .
      179     end.
      180     else do:
      181       assign
      182         v-rest = p-number modulo 10
      183       .
      184     end.
      185     case v-rest :
      186       when 1
      187       then do:
      188         return 2 .
      189       end.
      190       when 2 or
      191       when 3 or
      192       when 4
      193       then do:
      194         return 3 .
      195       end.
      196       otherwise do:
      197         return 1 .
      198       end.
      199     end case .
      200   end.
      201   procedure cur-time-mjd-to-date :
      202      define input  parameter i-mjd-diff as decimal no-undo.
      203      define output parameter o-Date     as date    no-undo.
      204      define output parameter o-Time     as integer no-undo.
      205      define variable v-day-number as integer   no-undo .
      206      if    i-mjd-diff < 0
      207         or i-mjd-diff = ?
      208      then do:
      209         return "?" .
      210      end.
      211      assign
      212         v-day-number = truncate(i-mjd-diff,0).
      213         o-Date = date(v-day-number + 2400002).
      214         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216   end.
      217   function cur-time-mjd-to-string returns character
      218   (input p-mjd-diff as decimal
      219   )
      220   :
      221     define variable v-day-number as integer   no-undo .
      222     define variable v-seconds    as integer   no-undo .
      223     define variable v-hour       as integer   no-undo .
      224     define variable v-min        as integer   no-undo .
      225     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      226     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      227     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      228     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      229     if p-mjd-diff < 0
      230     or p-mjd-diff = ?
      231     then do:
      232       return "?" .
      233     end.
      234     assign
      235       v-day-number = integer(truncate(p-mjd-diff,0))
      236       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      237     .
      238     if v-seconds > 86400
      239     then do:
      240       assign
      241         v-seconds = 86400 - 1
      242       .
      243     end.
      244     if v-seconds < 0
      245     then do:
      246       assign
      247         v-seconds = 0
      248       .
      249     end.
      250     assign
      251       v-hour = truncate(v-seconds / 3600, 0)
      252     .
      253     assign
      254       v-seconds = v-seconds modulo 3600
      255     .
      256     assign
      257       v-min = truncate(v-seconds / 60, 0)
      258     .
      259     assign
      260       v-seconds = v-seconds modulo 60
      261     .
      262     return
      263         (if v-day-number <> 0
      264           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      265           else ""
      266         )
      267       + (if v-day-number <> 0 or v-hour <> 0
      268           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      269           else ""
      270         )
      271       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      272           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      273           else ""
      274         )
      275       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      276       .
      277   end.
      278   function cur-time-string returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-string-sec returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      297   end.
      298   function cur-time-custom  returns character
      299   (input p-prefix as character
      300   ,input p-date-format as character
      301   ,input p-delimiter as character
      302   ,input p-time-format as character
      303   ,input p-suffix as character
      304   )
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return
      313       p-prefix
      314       + string(v-date, p-date-format)
      315       + p-delimiter
      316       + string(v-time, p-time-format)
      317       + p-suffix
      318       .
      319   end.
      320   function cur-time-print  returns character
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      329   end.
      330   function cur-time-datetime returns datetime
      331   :
      332     define variable v-char as character no-undo .
      333     define variable v-datetime as datetime no-undo .
      334     v-char = cur-time-string().
      335     v-datetime = datetime(v-char).
      336     return  v-datetime.
      337   end.
      338   function cur-time-string-msec returns character
      339   :
      340     define variable v-date as datetime  no-undo .
      341     v-date = now.
      342     return string(v-date) .
      343   end.
      344   define new global shared variable g#library  as handle no-undo .
      345   define new global shared variable g#library2 as handle no-undo .
      346   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347     define variable v-cntxt-db-num        as integer   no-undo .
      348     define variable v-cntxt-userid        as character no-undo .
      349     define variable v-cntxt-level         as character no-undo .
      350     define variable v-cntxt-host-code-obj as integer   no-undo .
      351     define variable v-cntxt-obj-type      as character no-undo .
      352     define variable v-cntxt-obj-code      as integer   no-undo .
      353     define variable v-cntxt-db-num-obj    as integer   no-undo .
      354     define variable v-cntxt-is-admin      as logical   no-undo .
      355     define variable g-log as logical   no-undo .
      356     define buffer b_fin-ob  for ub.fin-ob .
      357     define variable csum        as decimal   no-undo .
      358     define variable p-sys-time  as character no-undo .
      359     assign csum = 0 .
      360     define variable ii    as integer   no-undo .
      361     define variable msum as decimal initial 0  no-undo .
      362   DEFINE BUTTON b-chg
      363        LABEL "&Изм.сумму"
      364        SIZE 10 BY 1.
      365   DEFINE BUTTON B-conn-doc
      366        LABEL "Связи пл."
      367        SIZE 10 BY 1.
      368   DEFINE BUTTON B-conn-fo
      369        LABEL "Связи ф-о"
      370        SIZE 10 BY 1.
      371   DEFINE BUTTON b-exit AUTO-GO
      372        LABEL "&Ввод"
      373        SIZE 10 BY 1
      374        BGCOLOR 8 .
      375   DEFINE BUTTON b-help
      376        LABEL "Помо&щь"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE BUTTON b-quit AUTO-END-KEY
      380        LABEL "&Отмена"
      381        SIZE 10 BY 1
      382        BGCOLOR 8 .
      383   DEFINE BUTTON B-view-doc
      384        LABEL "&Платеж"
      385        SIZE 10 BY 1.
      386   DEFINE BUTTON B-view-fo
      387        LABEL "&Фин.обяз."
      388        SIZE 10 BY 1.
      389   DEFINE VARIABLE current-sum AS DECIMAL FORMAT "->>>,>>>,>>>,>>>,>>9.99" INITIAL 0
      390        LABEL "Тек. сумма "
      391        VIEW-AS FILL-IN
      392        SIZE 26 BY 1 NO-UNDO.
      393   DEFINE VARIABLE FILL-curr-contr AS CHARACTER FORMAT "X(256)":U
      394        LABEL "Вал."
      395         VIEW-AS TEXT
      396        SIZE 6 BY .67 NO-UNDO.
      397   DEFINE VARIABLE FILL-IN_con-sum-contr AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      398        LABEL "Свободно"
      399        VIEW-AS FILL-IN
      400        SIZE 25.5 BY 1 NO-UNDO.
      401   DEFINE QUERY Br-doc FOR
      402         temp_fin-doc SCROLLING.
      403   DEFINE BROWSE Br-doc
      404     QUERY Br-doc NO-LOCK DISPLAY
      405         temp_fin-doc.prn-doc-code FORMAT "X(16)":U
      406         temp_fin-doc.fin-doc-type FORMAT "X(3)":U
      407         temp_fin-doc.fin-doc-code COLUMN-LABEL "Вн.н." FORMAT "999999999":U
      408         temp_fin-doc.doc-date FORMAT "99/99/9999":U
      409         temp_fin-doc.no-con-sum COLUMN-LABEL "Связать " FORMAT "->>>>,>>>,>>>,>>9.99":U
      410         temp_fin-doc.con-sum-contr FORMAT "->>>>,>>>,>>>,>>9.99":U
      411         temp_fin-doc.sum-contr  COLUMN-LABEL "Сумма в вал. договора"  FORMAT "->>>>,>>>,>>>,>>9.99":U
      412       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.33.
      413   DEFINE FRAME Dialog-Frame
      414        b-exit AT ROW 1 COL 1
      415        b-quit AT ROW 1 COL 11
      416        b-chg AT ROW 1 COL 30
      417        B-view-fo AT ROW 1 COL 40
      418        B-conn-fo AT ROW 1 COL 50
      419        B-view-doc AT ROW 1 COL 60
      420        B-conn-doc AT ROW 1 COL 70
      421        b-help AT ROW 1 COL 88.5
      422        ub.fin-ob.prn-doc-code AT ROW 2.21 COL 10 COLON-ALIGNED
      423             LABEL "Фин.Об. №"
      424             VIEW-AS FILL-IN
      425             SIZE 12 BY 1
      426        ub.fin-ob.doc-date AT ROW 2.21 COL 26.38 COLON-ALIGNED
      427             LABEL "от"
      428             VIEW-AS FILL-IN
      429             SIZE 11 BY 1
      430        ub.fin-ob.pay-date AT ROW 2.21 COL 45.75 COLON-ALIGNED
      431             LABEL "Платеж"
      432             VIEW-AS FILL-IN
      433             SIZE 11 BY 1
      434        ub.fin-ob.sum-contract AT ROW 2.21 COL 64.13 COLON-ALIGNED
      435             VIEW-AS FILL-IN
      436             SIZE 22.38 BY 1
      437        Br-doc AT ROW 3.42 COL 1.63
      438        FILL-IN_con-sum-contr AT ROW 20.96 COL 17.5 COLON-ALIGNED
      439        current-sum AT ROW 20.96 COL 69.5 COLON-ALIGNED
      440        FILL-curr-contr AT ROW 2.5 COL 93 COLON-ALIGNED
      441        SPACE(0.00) SKIP(18.82)
      442       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      443            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      444            TITLE "Связь фин. обязательств и платежей".
      445   ASSIGN
      446          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      447          FRAME Dialog-Frame:HIDDEN           = TRUE.
      448   ASSIGN
      449          ub.fin-ob.doc-date:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      450   ASSIGN
      451          FILL-curr-contr:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      452   ASSIGN
      453          FILL-IN_con-sum-contr:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      454   ASSIGN
      455          current-sum:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      456   ASSIGN
      457          ub.fin-ob.prn-doc-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      459   DO:
      460     APPLY "END-ERROR":U TO SELF.
      461   END.
      462   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      463   DO:
      464     IF AVAIL temp_fin-doc THEN DO:
      465       define variable v-max as decimal   no-undo .
      466       define buffer b_temp_fin-doc for temp_fin-doc .
      467       assign msum = 0 .
      468       if ub.fin-ob.sum-contr > 0 then do:
      469         for each b_temp_fin-doc : if b_temp_fin-doc.no-con-sum < 0 then assign msum = msum - b_temp_fin-doc.no-con-sum . end.
      470         if (ub.fin-ob.sum-contr - ub.fin-ob.con-sum-contr) >= (temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr + msum) then assign v-max = temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr .
      471         else  assign v-max = ub.fin-ob.sum-contr - ub.fin-ob.con-sum-contr .
      472       end.
      473       else do:
      474         for each b_temp_fin-doc : if b_temp_fin-doc.no-con-sum > 0 then assign msum = msum + b_temp_fin-doc.no-con-sum . end.
      475         if ( - ub.fin-ob.sum-contr + ub.fin-ob.con-sum-contr) >= (temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr - msum) then assign v-max = temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr .
      476         else  assign v-max = - ub.fin-ob.sum-contr + ub.fin-ob.con-sum-contr .
      477       end.
      478       assign current-sum = current-sum - temp_fin-doc.no-con-sum .
      479       run str/fin-conp.w (input v-max,input-output temp_fin-doc.no-con-sum ) .
      480       assign current-sum = current-sum + temp_fin-doc.no-con-sum .
      481       br-doc:refresh() .
      482       DISPLAY current-sum WITH FRAME Dialog-Frame.
      483     END.
      484   END.
      485   ON CHOOSE OF B-conn-doc IN FRAME Dialog-Frame
      486   DO:
      487     if available temp_fin-doc then do:
      488       run str/finconn.w ( input parParentProc, input p-host-code, input 'при':U, input "fin-doc", input string(temp_fin-doc.fin-doc-code)) .
      489       br-doc:refresh() .
      490     end.
      491   END.
      492   ON CHOOSE OF B-conn-fo IN FRAME Dialog-Frame
      493   DO:
      494     if available ub.fin-ob then do:
      495       run str/finconn.w ( input parParentProc, input p-host-code, input 'при':U, input "fin-ob", input ub.fin-ob.doc-code) .
      496       br-doc:refresh() .
      497     end.
      498   END.
      499   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      500   DO:
      501     assign p-end = yes .
      502     run CreateProc no-error.
      503     if error-status:error then return no-apply.
      504   END.
      505   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      506   DO:
      507     message "Вы действительно хотите отменить создание связи?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
      508     if g-log = no then return no-apply.
      509   END.
      510   ON CHOOSE OF B-view-doc IN FRAME Dialog-Frame
      511   DO:
      512     if not available temp_fin-doc then return.
      513     run ref/showfind.p (
      514                          input parParentProc
      515                         ,input p-host-code
      516                         ,input temp_fin-doc.host-code
      517                         ,input ub.fin-doc.fin-doc-code
      518                         ).
      519   END.
      520   ON CHOOSE OF B-view-fo IN FRAME Dialog-Frame
      521   DO:
      522   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   do:
      524     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      525       (input  v-cntxt-db-num
      526       ,input  v-cntxt-userid
      527       ,input  0
      528       ,input  'actn_fin-liability_lookup':U
      529       ,input  'firm':U
      530       ,input  p-host-code
      531       ,input  '':U
      532       ,input  0
      533       ,input  0
      534       ,input  0
      535       ,input  0
      536       ,input  true
      537       ,output g-log
      538       )  .
      539   end.
      540     if not g-log then  return .
      541     define variable rr as recid no-undo .
      542     if not available ub.fin-ob then return.
      543     run str/sh-finob.p ( input parParentProc, input p-host-code, input recid( ub.fin-ob)).
      544   END.
      545   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   on help of frame Dialog-Frame
      547   do:
      548     run gbl/app_help.p
      549       (input this-procedure :file-name
      550       ,input ''
      551       ,input ?
      552       ) no-error.
      553     if error-status :error then do:
      554       message
      555         "Ошибка при вызове помощи"
      556         error-status :get-message(1)
      557         view-as alert-box .
      558     end.
      559   end.
      560   run minbtn-set in this-procedure .
      561   on choose of b-help in frame Dialog-Frame
      562   do:
      563     apply "help":u to frame Dialog-Frame .
      564   end.
      565   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   procedure minbtn-set :
      567       do
      568           on error undo, return error return-value
      569           :
      570           define variable ii              as integer       no-undo .
      571           define variable fh              as widget-handle no-undo .
      572           define variable hh              as widget-handle no-undo .
      573           define variable v-h             as handle        extent 4 no-undo .
      574           define variable v-name-button   as character     no-undo .
      575           define variable v-help-old-x    as decimal       no-undo .
      576           define variable v-help-old-y    as decimal       no-undo .
      577           define variable v-help-old-size as decimal       no-undo .
      578           define variable v-frame-width   as decimal       no-undo .
      579           define variable jj              as integer       no-undo .
      580           do
      581               on error undo, return error
      582               :
      583               assign
      584                   v-frame-width = frame Dialog-Frame:width - 0.3
      585                   fh            = frame Dialog-Frame:first-child
      586                   hh            = fh:first-child
      587                   ii            = 1
      588                   .
      589               do while valid-handle(hh):
      590                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      591                   do:
      592                       case lc(hh:name) :
      593                           when "b-help" then
      594                               do:
      595                                   hh:load-image-up("cmp/b-help.bmp":u) .
      596                                   hh:load-image-down("cmp/b-help.bmp":u) .
      597                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      598                                   hh:TOOLTIP = "Помощь" .
      599                                   v-help-old-x = hh:column .
      600                                   v-help-old-y = hh:row    .
      601                                   v-help-old-size = hh:width .
      602                                   hh:width-chars = 2.5 .
      603                               end.
      604                           when "b-print" then
      605                               do:
      606                                   hh:load-image("cmp/b-print.bmp":u) .
      607                                   hh:TOOLTIP = "Печать" .
      608                                   v-h[ii] = hh:handle .
      609                                   ii = ii + 1 .
      610                                   hh:width-chars = 3 .
      611                               end.
      612                           when "b-history" or
      613                           when "b-hist" then
      614                               do:
      615                                   hh:load-image("cmp/b-hist.bmp":u) .
      616                                   hh:TOOLTIP = "История" .
      617                                   v-h[ii] = hh:handle .
      618                                   ii = ii + 1 .
      619                                   hh:width-chars = 3 .
      620                               end.
      621                           when "b-sch" then
      622                               do:
      623                                   hh:load-image("cmp/b-sch.bmp":u) .
      624                                   hh:TOOLTIP = "Установка Фильтра" .
      625                                   v-h[ii] = hh:handle .
      626                                   ii = ii + 1 .
      627                                   hh:width-chars = 3 .
      628                               end.
      629                           when "b-hist-user" then
      630                               do:
      631                                   hh:load-image("cmp/b-hist.bmp":u) .
      632                                   hh:TOOLTIP = "История пользователя" .
      633                                   ii = ii + 1 .
      634                               end.
      635                       end case.
      636                   end.
      637                   hh = hh:next-sibling.
      638               end.
      639               b-help:column = v-frame-width - b-help:width-chars.
      640               jj = 0.
      641               repeat ii = 4 to 1 by -1 :
      642                   if valid-handle (v-h[ii] ) then
      643                   do:
      644                       jj  = jj + 1 .
      645                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      646                       v-h[ii]:row    = v-help-old-y .
      647                   end.
      648               end.
      649           end.
      650       end.
      651   end procedure.
      652   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      653   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      654   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      655   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      656   define variable v-diasize-current-frame-width  as decimal   no-undo .
      657   define variable v-diasize-current-frame-height as decimal   no-undo .
      658   define variable v-diasize-change-size          as logical   no-undo .
      659   define variable v-diasize-resize-button        as handle    no-undo .
      660   define variable v-diasize-wndmax               as logical   no-undo .
      661   define variable v-diasize-wndstore             as logical   no-undo .
      662   define variable v-diasize-proc-name            as character no-undo .
      663   define variable v-diasize-browse-handle        as handle    no-undo .
      664   define variable v-diasize-browse-number        as integer   no-undo .
      665   define variable v-diasize-need-full-display    as logical   no-undo init false .
      666   define temp-table temp-diasize-handle no-undo
      667     field handle-value  as handle
      668     field save-position as decimal
      669     index xpk is primary unique handle-value
      670     .
      671   define temp-table temp-browse-handle no-undo
      672     field browse-type   as character
      673     field browse-number as integer
      674     field browse-handle as handle
      675     field original-size as decimal
      676     index xpk is primary unique browse-type browse-number
      677     index xie browse-type browse-handle
      678   .
      679   procedure diasize_change-height :
      680     define input  parameter p-change-value  as decimal   no-undo .
      681     define input  parameter p-move-resize   as logical   no-undo .
      682     define variable v-field-group-handle    as handle    no-undo .
      683     define variable v-object-handle         as handle    no-undo .
      684     define variable v-frame-height          as decimal   no-undo .
      685     define variable v-frame-virtual-height  as decimal   no-undo .
      686     define variable v-browse-height         as decimal   no-undo .
      687     define variable v-window-height         as decimal   no-undo .
      688     define variable v-window-virtual-height as decimal   no-undo .
      689     define variable v-change-sign           as integer   no-undo .
      690     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      691     define buffer buf_temp-browse-handle  for temp-browse-handle .
      692     if p-change-value > 0
      693     then do:
      694       if frame Dialog-Frame :height + p-change-value
      695           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      696       then do:
      697         assign
      698           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      699                           - (frame Dialog-Frame :height-chars)
      700         .
      701         if p-change-value <= 0
      702         then do:
      703           run diasize_position-resize-button in this-procedure .
      704           return .
      705         end.
      706       end.
      707     end.
      708     if p-change-value < 0
      709     then do:
      710       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      711       then do:
      712         assign
      713           p-change-value = v-diasize-orig-frame-height
      714                          - (frame Dialog-Frame :height-chars)
      715         .
      716         if p-change-value >= 0
      717         then do:
      718           run diasize_position-resize-button in this-procedure .
      719           return .
      720         end.
      721       end.
      722     end.
      723     if p-change-value >= 0
      724     then do:
      725       assign
      726         v-change-sign = 1
      727       .
      728     end.
      729     else do:
      730       assign
      731         v-change-sign = -1
      732       .
      733     end.
      734     assign
      735       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      736     .
      737     if p-change-value = 0
      738     then do:
      739       run diasize_position-resize-button in this-procedure .
      740       return .
      741     end.
      742     move_block:
      743     do
      744     on error undo move_block, retry move_block
      745     :
      746       if retry
      747       then do:
      748         do
      749         on error undo move_block, leave move_block
      750         :
      751           if p-change-value > 0
      752           then do:
      753             for each buf_temp-diasize-handle
      754             on error undo, next
      755             :
      756               assign
      757                 v-object-handle = buf_temp-diasize-handle.handle-value
      758               .
      759               if v-object-handle <> v-diasize-resize-button
      760               then do:
      761                 assign
      762                   v-object-handle :row = buf_temp-diasize-handle.save-position
      763                 .
      764               end.
      765             end.
      766             assign
      767               v-diasize-browse-handle :height = v-browse-height
      768             .
      769             for each buf_temp-browse-handle
      770               where buf_temp-browse-handle.browse-type = 'height':u
      771             on error undo, next
      772             :
      773               assign
      774                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      775               .
      776             end.
      777             assign
      778               frame Dialog-Frame :height = v-frame-height
      779             .
      780             if frame Dialog-Frame :scrollable = true
      781             then do:
      782               assign
      783                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      784               .
      785             end.
      786             run diasize_position-resize-button in this-procedure .
      787           end.
      788           else do:
      789             if frame Dialog-Frame :scrollable = true
      790             then do:
      791               assign
      792                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      793               .
      794             end.
      795             assign
      796               frame Dialog-Frame :height = v-frame-height
      797             .
      798             assign
      799               v-diasize-browse-handle :height = v-browse-height
      800             .
      801             for each buf_temp-browse-handle
      802               where buf_temp-browse-handle.browse-type = 'height':u
      803             on error undo, next
      804             :
      805               assign
      806                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      807               .
      808             end.
      809             for each buf_temp-diasize-handle
      810             on error undo, next
      811             :
      812               assign
      813                 v-object-handle = buf_temp-diasize-handle.handle-value
      814               .
      815               if v-object-handle <> v-diasize-resize-button
      816               then do:
      817                 assign
      818                   v-object-handle :row = buf_temp-diasize-handle.save-position
      819                 .
      820               end.
      821             end.
      822             run diasize_position-resize-button in this-procedure .
      823           end.
      824           assign
      825             v-diasize-change-size = false
      826           .
      827           leave move_block .
      828         end.
      829       end.
      830       assign
      831         v-diasize-need-full-display = true
      832       .
      833       if v-diasize-change-size = false
      834       then do:
      835         assign
      836           v-diasize-change-size = true
      837         .
      838       end.
      839       else do:
      840         return .
      841       end.
      842       assign
      843         v-frame-height = frame Dialog-Frame :height
      844         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      845         v-browse-height = v-diasize-browse-handle :height
      846       .
      847       for each buf_temp-browse-handle
      848         where buf_temp-browse-handle.browse-type = 'height':u
      849       :
      850         assign
      851           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      852         .
      853       end.
      854       for each buf_temp-diasize-handle
      855       :
      856         delete buf_temp-diasize-handle .
      857       end.
      858       assign
      859         v-field-group-handle = frame Dialog-Frame :first-child
      860       .
      861       do while valid-handle(v-field-group-handle)
      862       :
      863         assign
      864           v-object-handle = v-field-group-handle :first-child
      865         .
      866         do while valid-handle(v-object-handle)
      867         :
      868           if  v-object-handle <> v-diasize-browse-handle :handle
      869           and can-query(v-object-handle, "row")
      870           and can-query(v-object-handle, "height")
      871           and ( v-object-handle :row > v-diasize-browse-handle :row )
      872           then do:
      873             find first buf_temp-browse-handle
      874               where buf_temp-browse-handle.browse-type   = 'height':u
      875                 and buf_temp-browse-handle.browse-handle = v-object-handle
      876               no-error .
      877             if available buf_temp-browse-handle
      878             then do:
      879             end.
      880             else do:
      881               create buf_temp-diasize-handle .
      882               assign
      883                 buf_temp-diasize-handle.handle-value  = v-object-handle
      884                 buf_temp-diasize-handle.save-position = v-object-handle :row
      885               .
      886             end.
      887           end.
      888           assign
      889             v-object-handle = v-object-handle :next-sibling
      890           .
      891         end.
      892         assign
      893           v-field-group-handle = v-field-group-handle :next-sibling
      894         .
      895       end.
      896       do with frame Dialog-Frame
      897       :
      898         hide v-diasize-resize-button .
      899         assign
      900           v-diasize-resize-button :row    = 1
      901           v-diasize-resize-button :column = 1
      902         .
      903       end.
      904       if p-change-value > 0
      905       then do:
      906         if frame Dialog-Frame :scrollable = true
      907         then do:
      908           assign
      909             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      910             no-error .
      911           if error-status :error
      912           or error-status :get-message(1) <> ""
      913           then do:
      914             undo move_block, retry move_block .
      915           end.
      916         end.
      917         assign
      918           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      919           no-error .
      920         if error-status :error
      921         or error-status :get-message(1) <> ""
      922         then do:
      923           undo move_block, retry move_block .
      924         end.
      925         assign
      926           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      927           no-error .
      928         if error-status :error
      929         or error-status :get-message(1) <> ""
      930         then do:
      931           undo move_block, retry move_block .
      932         end.
      933         for each buf_temp-browse-handle
      934           where buf_temp-browse-handle.browse-type = 'height':u
      935         on error undo move_block, retry move_block
      936         :
      937           assign
      938             buf_temp-browse-handle.browse-handle :height
      939               = buf_temp-browse-handle.browse-handle :height + p-change-value
      940             no-error .
      941           if error-status :error
      942           or error-status :get-message(1) <> ""
      943           then do:
      944             undo move_block, retry move_block .
      945           end.
      946         end.
      947         for each buf_temp-diasize-handle
      948         on error undo move_block, retry move_block
      949         :
      950           assign
      951             v-object-handle = buf_temp-diasize-handle.handle-value
      952           .
      953           if v-object-handle <> v-diasize-resize-button
      954           then do:
      955             assign
      956               v-object-handle :row = v-object-handle :row + p-change-value
      957               no-error .
      958             if error-status :error
      959             or error-status :get-message(1) <> ""
      960             then do:
      961               undo move_block, retry move_block .
      962             end.
      963           end.
      964         end.
      965       end.
      966       else do:
      967         for each buf_temp-diasize-handle
      968         on error undo move_block, retry move_block
      969         :
      970           assign
      971             v-object-handle = buf_temp-diasize-handle.handle-value
      972           .
      973           if v-object-handle <> v-diasize-resize-button
      974           then do:
      975             assign
      976               v-object-handle :row = v-object-handle :row + p-change-value
      977               no-error .
      978             if error-status :error
      979             or error-status :get-message(1) <> ""
      980             then do:
      981               undo move_block, retry move_block .
      982             end.
      983           end.
      984         end.
      985         assign
      986           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      987           no-error .
      988         if error-status :error
      989         or error-status :get-message(1) <> ""
      990         then do:
      991           undo move_block, retry move_block .
      992         end.
      993         for each buf_temp-browse-handle
      994           where buf_temp-browse-handle.browse-type = 'height':u
      995         on error undo move_block, retry move_block
      996         :
      997           assign
      998             buf_temp-browse-handle.browse-handle :height
      999               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1000             no-error .
     1001           if error-status :error
     1002           or error-status :get-message(1) <> ""
     1003           then do:
     1004             undo move_block, retry move_block .
     1005           end.
     1006         end.
     1007         assign
     1008           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1009           no-error .
     1010         if error-status :error
     1011         or error-status :get-message(1) <> ""
     1012         then do:
     1013           undo move_block, retry move_block .
     1014         end.
     1015         if frame Dialog-Frame :scrollable = true
     1016         then do:
     1017           assign
     1018             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1019             no-error .
     1020           if error-status :error
     1021           or error-status :get-message(1) <> ""
     1022           then do:
     1023             undo move_block, retry move_block .
     1024           end.
     1025         end.
     1026       end.
     1027       if p-move-resize = true
     1028       then do:
     1029         run diasize_position-resize-button in this-procedure .
     1030       end.
     1031       if v-diasize-wndstore = true
     1032       then do:
     1033         if connected("ub") = true
     1034         then do:
     1035           define variable v-cntxt-db-num        as integer   no-undo .
     1036           define variable v-cntxt-userid        as character no-undo .
     1037           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1038                                             , OUTPUT v-cntxt-userid
     1039                                             ) .
     1040           run gbl/wndsizew.p
     1041             (input  v-cntxt-db-num
     1042             ,input  v-cntxt-userid
     1043             ,input  v-diasize-proc-name
     1044             ,input  'height':u
     1045             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1046             ) .
     1047         end.
     1048       end.
     1049     end.
     1050     assign
     1051       v-diasize-change-size = false
     1052     .
     1053   end procedure.
     1054   procedure diasize_set-height :
     1055     define input  parameter p-new-height  as decimal   no-undo .
     1056     define input  parameter p-move-resize as logical   no-undo .
     1057     do
     1058     on error undo, return error return-value
     1059     :
     1060       run diasize_change-height in this-procedure
     1061         (input  (p-new-height - frame Dialog-Frame :height)
     1062         ,input  p-move-resize
     1063         ) .
     1064     end.
     1065   end procedure.
     1066   procedure diasize_change-width :
     1067     define input  parameter p-change-value as decimal   no-undo .
     1068     define input  parameter p-move-resize  as logical   no-undo .
     1069     define variable v-field-group-handle   as handle    no-undo .
     1070     define variable v-object-handle        as handle    no-undo .
     1071     define variable v-frame-width          as decimal   no-undo .
     1072     define variable v-frame-virtual-width  as decimal   no-undo .
     1073     define variable v-browse-width         as decimal   no-undo .
     1074     define variable v-window-width         as decimal   no-undo .
     1075     define variable v-window-virtual-width as decimal   no-undo .
     1076     define variable v-change-sign          as integer   no-undo .
     1077     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1078     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1079     if p-change-value > 0
     1080     then do:
     1081       if frame Dialog-Frame :width + p-change-value >
     1082           session :width-chars
     1083       then do:
     1084         assign
     1085           p-change-value = session :width-chars - frame Dialog-Frame :width
     1086         .
     1087         if p-change-value <= 0
     1088         then do:
     1089           run diasize_position-resize-button in this-procedure .
     1090           return .
     1091         end.
     1092       end.
     1093     end.
     1094     if p-change-value < 0
     1095     then do:
     1096       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1097       then do:
     1098         assign
     1099           p-change-value = v-diasize-orig-frame-width
     1100                          - frame Dialog-Frame :width
     1101         .
     1102         if p-change-value >= 0
     1103         then do:
     1104           run diasize_position-resize-button in this-procedure .
     1105           return .
     1106         end.
     1107       end.
     1108     end.
     1109     if p-change-value >= 0
     1110     then do:
     1111       assign
     1112         v-change-sign = 1
     1113       .
     1114     end.
     1115     else do:
     1116       assign
     1117         v-change-sign = -1
     1118       .
     1119     end.
     1120     assign
     1121       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1122     .
     1123     if p-change-value = 0
     1124     then do:
     1125       run diasize_position-resize-button in this-procedure .
     1126       return .
     1127     end.
     1128     move_block:
     1129     do
     1130     on error undo move_block, leave move_block
     1131     :
     1132       if retry
     1133       then do:
     1134         do
     1135         on error undo move_block, leave move_block
     1136         :
     1137           if p-change-value > 0
     1138           then do:
     1139             for each buf_temp-diasize-handle
     1140             on error undo, next
     1141             :
     1142               assign
     1143                 v-object-handle = buf_temp-diasize-handle.handle-value
     1144               .
     1145               if v-object-handle <> v-diasize-resize-button
     1146               then do:
     1147                 assign
     1148                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1149                 .
     1150               end.
     1151             end.
     1152             assign
     1153               v-diasize-browse-handle :width = v-browse-width
     1154             .
     1155             for each buf_temp-browse-handle
     1156               where buf_temp-browse-handle.browse-type = 'width':u
     1157             on error undo, next
     1158             :
     1159               assign
     1160                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1161               .
     1162             end.
     1163             assign
     1164               frame Dialog-Frame :width = v-frame-width
     1165             .
     1166             if frame Dialog-Frame :scrollable = true
     1167             then do:
     1168               assign
     1169                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1170               .
     1171             end.
     1172             run diasize_position-resize-button in this-procedure .
     1173           end.
     1174           else do:
     1175             if frame Dialog-Frame :scrollable = true
     1176             then do:
     1177               assign
     1178                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1179               .
     1180             end.
     1181             assign
     1182               frame Dialog-Frame :width = v-frame-width
     1183             .
     1184             for each buf_temp-browse-handle
     1185               where buf_temp-browse-handle.browse-type = 'width':u
     1186             on error undo, next
     1187             :
     1188               assign
     1189                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1190               .
     1191             end.
     1192             assign
     1193               v-diasize-browse-handle :width = v-browse-width
     1194             .
     1195             for each buf_temp-diasize-handle
     1196             on error undo, next
     1197             :
     1198               assign
     1199                 v-object-handle = buf_temp-diasize-handle.handle-value
     1200               .
     1201               if v-object-handle <> v-diasize-resize-button
     1202               then do:
     1203                 assign
     1204                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1205                 .
     1206               end.
     1207             end.
     1208             run diasize_position-resize-button in this-procedure .
     1209           end.
     1210           assign
     1211             v-diasize-change-size = false
     1212           .
     1213           leave move_block .
     1214         end.
     1215       end.
     1216       assign
     1217         v-diasize-need-full-display = true
     1218       .
     1219       if v-diasize-change-size = false
     1220       then do:
     1221         assign
     1222           v-diasize-change-size = true
     1223         .
     1224       end.
     1225       else do:
     1226         return .
     1227       end.
     1228       assign
     1229         v-frame-width = frame Dialog-Frame :width
     1230         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1231         v-browse-width = v-diasize-browse-handle :width
     1232       .
     1233       for each buf_temp-browse-handle
     1234         where buf_temp-browse-handle.browse-type = 'width':u
     1235       :
     1236         assign
     1237           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1238         .
     1239       end.
     1240       for each buf_temp-diasize-handle
     1241       :
     1242         delete buf_temp-diasize-handle .
     1243       end.
     1244       assign
     1245         v-field-group-handle = frame Dialog-Frame :first-child
     1246       .
     1247       do while valid-handle(v-field-group-handle)
     1248       :
     1249         assign
     1250           v-object-handle = v-field-group-handle :first-child
     1251         .
     1252         do while valid-handle(v-object-handle)
     1253         :
     1254           if  v-object-handle <> v-diasize-browse-handle :handle
     1255           and v-object-handle <> v-diasize-resize-button
     1256           and can-query(v-object-handle, "row")
     1257           and can-query(v-object-handle, "height")
     1258           and ( v-object-handle :col + v-object-handle :width
     1259                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1260               )
     1261           then do:
     1262             find first buf_temp-browse-handle
     1263               where buf_temp-browse-handle.browse-type   = 'width':u
     1264                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1265               no-error .
     1266             if available buf_temp-browse-handle
     1267             then do:
     1268             end.
     1269             else do:
     1270               create buf_temp-diasize-handle .
     1271               assign
     1272                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1273                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1274               .
     1275             end.
     1276           end.
     1277           assign
     1278             v-object-handle = v-object-handle :next-sibling
     1279           .
     1280         end.
     1281         assign
     1282           v-field-group-handle = v-field-group-handle :next-sibling
     1283         .
     1284       end.
     1285       do with frame Dialog-Frame
     1286       :
     1287         hide v-diasize-resize-button .
     1288         v-diasize-resize-button :row = 1.
     1289         v-diasize-resize-button :column = 1.
     1290       end.
     1291       if p-change-value > 0
     1292       then do:
     1293         if frame Dialog-Frame :scrollable = true
     1294         then do:
     1295           assign
     1296             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1297             no-error .
     1298           if error-status :error
     1299           or error-status :get-message(1) <> ""
     1300           then do:
     1301             undo move_block, retry move_block.
     1302           end.
     1303         end.
     1304         assign
     1305           frame Dialog-Frame :width = v-frame-width + p-change-value
     1306           no-error .
     1307         if error-status :error
     1308         or error-status :get-message(1) <> ""
     1309         then do:
     1310           undo move_block, retry move_block.
     1311         end.
     1312         assign
     1313           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1314         no-error .
     1315         if error-status :error
     1316         or error-status :get-message(1) <> ""
     1317         then do:
     1318           undo move_block, retry move_block.
     1319         end.
     1320         for each buf_temp-browse-handle
     1321           where buf_temp-browse-handle.browse-type = 'width':u
     1322         on error undo move_block, retry move_block
     1323         :
     1324           assign
     1325             buf_temp-browse-handle.browse-handle :width
     1326               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1327             no-error .
     1328           if error-status :error
     1329           or error-status :get-message(1) <> ""
     1330           then do:
     1331             undo move_block, retry move_block .
     1332           end.
     1333         end.
     1334         for each buf_temp-diasize-handle
     1335         on error undo move_block, retry move_block
     1336         :
     1337           assign
     1338             v-object-handle = buf_temp-diasize-handle.handle-value
     1339           .
     1340           if v-object-handle <> v-diasize-resize-button
     1341           then do:
     1342             assign
     1343               v-object-handle :col = v-object-handle :col + p-change-value
     1344               no-error .
     1345             if error-status :error
     1346             or error-status :get-message(1) <> ""
     1347             then do:
     1348               undo move_block, retry move_block .
     1349             end.
     1350           end.
     1351         end.
     1352       end.
     1353       else do:
     1354         for each buf_temp-diasize-handle
     1355         on error undo move_block, retry move_block
     1356         :
     1357           assign
     1358             v-object-handle = buf_temp-diasize-handle.handle-value
     1359           .
     1360           if v-object-handle <> v-diasize-resize-button
     1361           then do:
     1362             assign
     1363               v-object-handle :col = v-object-handle :col + p-change-value
     1364               no-error .
     1365             if error-status :error
     1366             or error-status :get-message(1) <> ""
     1367             then do:
     1368               undo move_block, retry move_block .
     1369             end.
     1370           end.
     1371         end.
     1372         for each buf_temp-browse-handle
     1373           where buf_temp-browse-handle.browse-type = 'width':u
     1374         on error undo move_block, retry move_block
     1375         :
     1376           assign
     1377             buf_temp-browse-handle.browse-handle :width
     1378               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1379             no-error .
     1380           if error-status :error
     1381           or error-status :get-message(1) <> ""
     1382           then do:
     1383             undo move_block, retry move_block .
     1384           end.
     1385         end.
     1386         assign
     1387           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1388           no-error .
     1389         if error-status :error
     1390         or error-status :get-message(1) <> ""
     1391         then do:
     1392           undo move_block, retry move_block.
     1393         end.
     1394         assign
     1395           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1396         no-error .
     1397         if error-status :error
     1398         or error-status :get-message(1) <> ""
     1399         then do:
     1400           undo move_block, retry move_block.
     1401         end.
     1402         if frame Dialog-Frame :scrollable = true
     1403         then do:
     1404           assign
     1405             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1406           no-error .
     1407           if error-status :error
     1408           or error-status :get-message(1) <> ""
     1409           then do:
     1410             undo move_block, retry move_block.
     1411           end.
     1412         end.
     1413       end.
     1414       if p-move-resize
     1415       then do:
     1416         run diasize_position-resize-button in this-procedure .
     1417       end.
     1418       if v-diasize-wndstore = true
     1419       then do:
     1420         if connected("ub") = true
     1421         then do:
     1422           define variable v-cntxt-db-num        as integer   no-undo .
     1423           define variable v-cntxt-userid        as character no-undo .
     1424           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1425                                             , OUTPUT v-cntxt-userid
     1426                                             ) .
     1427           run gbl/wndsizew.p
     1428             (input  v-cntxt-db-num
     1429             ,input  v-cntxt-userid
     1430             ,input  v-diasize-proc-name
     1431             ,input  'width':u
     1432             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1433             ) .
     1434         end.
     1435       end.
     1436     end.
     1437     assign
     1438       v-diasize-change-size = false
     1439     .
     1440   end procedure.
     1441   procedure diasize_set-width :
     1442     define input  parameter p-new-width  as decimal   no-undo .
     1443     define input  parameter p-move-resize as logical   no-undo .
     1444     do
     1445     on error undo, return error return-value
     1446     :
     1447       run diasize_change-width in this-procedure
     1448         (input  (p-new-width - frame Dialog-Frame :width)
     1449         ,input  p-move-resize
     1450         ) .
     1451     end.
     1452   end procedure.
     1453   procedure diasize_position-resize-button :
     1454     do with frame Dialog-Frame
     1455     :
     1456       hide v-diasize-resize-button .
     1457       assign
     1458         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1459                     - 1
     1460                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1461         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1462                     - 1
     1463                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1464       .
     1465       view v-diasize-resize-button .
     1466     end.
     1467   end procedure.
     1468   on alt-right anywhere
     1469   do:
     1470     run diasize_change-width in this-procedure
     1471       (input 1
     1472       ,input true
     1473       ) .
     1474     return no-apply .
     1475   end.
     1476   on alt-left anywhere
     1477   do:
     1478     run diasize_change-width in this-procedure
     1479       (input -1
     1480       ,input true
     1481       ) .
     1482     return no-apply .
     1483   end.
     1484   on alt-down anywhere
     1485   do:
     1486     run diasize_change-height in this-procedure
     1487       (input 1
     1488       ,input true
     1489       ) .
     1490     return no-apply .
     1491   end.
     1492   on alt-up anywhere
     1493   do:
     1494     run diasize_change-height in this-procedure
     1495       (input -1
     1496       ,input true
     1497       ) .
     1498     return no-apply .
     1499   end.
     1500   on alt-enter of frame Dialog-Frame
     1501   do:
     1502     run diasize_maximize in this-procedure
     1503       (input  ?
     1504       ).
     1505     return no-apply .
     1506   end.
     1507   procedure diasize_end-move :
     1508     do
     1509     on error undo, return error return-value
     1510     :
     1511       define variable v-row-delta as decimal   no-undo .
     1512       define variable v-col-delta as decimal   no-undo .
     1513       define variable v-new-row as decimal   no-undo .
     1514       define variable v-new-col as decimal   no-undo .
     1515       assign
     1516         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1517         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1518       .
     1519       assign
     1520         v-row-delta = v-new-row - frame Dialog-Frame :height
     1521         v-col-delta = v-new-col - frame Dialog-Frame :width
     1522       .
     1523       run diasize_change-height in this-procedure
     1524         (input v-row-delta
     1525         ,input true
     1526         ) .
     1527       run diasize_change-width in this-procedure
     1528         (input v-col-delta
     1529         ,input true
     1530         ) .
     1531     end.
     1532   end procedure.
     1533   procedure diasize_maximize :
     1534     define input  parameter p-action as logical   no-undo .
     1535     do
     1536     on error undo, return error return-value
     1537     :
     1538       if p-action = ?
     1539       then do:
     1540         if v-diasize-need-maximize = true
     1541         then do:
     1542           assign
     1543             p-action = true
     1544           .
     1545         end.
     1546         else do:
     1547           assign
     1548             p-action = false
     1549           .
     1550         end.
     1551       end.
     1552       if p-action = true
     1553       then do:
     1554         run diasize_change-height in this-procedure
     1555           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1556               - frame Dialog-Frame :height-chars
     1557           ,input true
     1558           ) .
     1559         run diasize_change-width in this-procedure
     1560           (input session :width-chars
     1561               - frame Dialog-Frame :width-chars
     1562           ,input true
     1563           ) .
     1564         assign
     1565           v-diasize-need-maximize = false
     1566         .
     1567       end.
     1568       else do:
     1569         run diasize_change-width in this-procedure
     1570           (input v-diasize-orig-frame-width
     1571               - frame Dialog-Frame :width-chars
     1572           ,input true
     1573           ) .
     1574         run diasize_change-height in this-procedure
     1575           (input v-diasize-orig-frame-height
     1576               - frame Dialog-Frame :height-chars
     1577           ,input true
     1578           ) .
     1579         assign
     1580           v-diasize-need-maximize = true
     1581         .
     1582       end.
     1583     end.
     1584   end procedure.
     1585   procedure diasize_restore-orig-size :
     1586     do
     1587     on error undo, return error return-value
     1588     :
     1589       assign
     1590         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1591         v-diasize-current-frame-height = frame Dialog-Frame :height
     1592       .
     1593       run diasize_set-height in this-procedure
     1594         (input  v-diasize-orig-frame-height
     1595         ,input  true
     1596         ) .
     1597       run diasize_set-width in this-procedure
     1598         (input  v-diasize-orig-frame-width
     1599         ,input  true
     1600         ) .
     1601     end.
     1602   end procedure.
     1603   procedure diasize_restore-current-size :
     1604     do
     1605     on error undo, return error return-value
     1606     :
     1607       run diasize_set-height in this-procedure
     1608         (input  v-diasize-current-frame-height
     1609         ,input  true
     1610         ) .
     1611       run diasize_set-width in this-procedure
     1612         (input  v-diasize-current-frame-width
     1613         ,input  true
     1614         ) .
     1615     end.
     1616   end procedure.
     1617   procedure diasize_set-browse-handle :
     1618     define input  parameter p-browse-handle as handle   no-undo .
     1619     define buffer buf_temp-browse-handle for temp-browse-handle .
     1620     do
     1621     on error undo, return error return-value
     1622     :
     1623       assign
     1624         v-diasize-browse-handle = p-browse-handle
     1625       .
     1626       for each buf_temp-browse-handle
     1627       on error undo, return error return-value
     1628       :
     1629         delete buf_temp-browse-handle .
     1630       end.
     1631     end.
     1632   end procedure.
     1633   procedure diasize_add_browse :
     1634     define input  parameter p-browse-type   as character no-undo .
     1635     define input  parameter p-browse-handle as handle    no-undo .
     1636     define buffer buf_temp-browse-handle for temp-browse-handle .
     1637     do
     1638     on error undo, return error return-value
     1639     :
     1640       assign
     1641         v-diasize-browse-number = v-diasize-browse-number + 1
     1642       .
     1643       create buf_temp-browse-handle .
     1644       assign
     1645         buf_temp-browse-handle.browse-type   = p-browse-type
     1646         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1647         buf_temp-browse-handle.browse-handle = p-browse-handle
     1648       .
     1649     end.
     1650   end procedure.
     1651   procedure diasize_init :
     1652     define variable v-default-value    as logical   no-undo .
     1653     define variable v-restore-saved    as logical   no-undo .
     1654     define variable v-resize-value-str as character no-undo .
     1655     do
     1656     on error undo, return error return-value
     1657     :
     1658       do with frame Dialog-Frame
     1659       :
     1660         assign
     1661           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1662           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1663           v-diasize-browse-handle     = browse Br-doc :handle
     1664         .
     1665         create button v-diasize-resize-button
     1666         assign
     1667           parent        = frame Dialog-Frame :first-child
     1668           label         = "s"
     1669           height-pixels = 16
     1670           width-pixels  = 16
     1671           visible       = true
     1672           sensitive     = true
     1673           movable       = true
     1674           triggers:
     1675             on end-move persistent run diasize_end-move in this-procedure .
     1676           end triggers.
     1677         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1678         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1679         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1680         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1681         assign
     1682           v-diasize-wndmax = false
     1683         .
     1684         if connected("ub") = true
     1685         then do:
     1686           define variable v-cntxt-db-num        as integer   no-undo .
     1687           define variable v-cntxt-userid        as character no-undo .
     1688           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1689                                             , OUTPUT v-cntxt-userid
     1690                                             ) .
     1691           run gbl/wndpar_r.p
     1692             (input  v-cntxt-db-num
     1693             ,input  v-cntxt-userid
     1694             ,input  'wndmax':U
     1695             ,output v-diasize-wndmax
     1696             ,output v-default-value
     1697             ) .
     1698         end.
     1699         assign
     1700           v-diasize-wndstore = false
     1701         .
     1702         if connected("ub") = true
     1703         then do:
     1704           run gbl/wndpar_r.p
     1705             (input  v-cntxt-db-num
     1706             ,input  v-cntxt-userid
     1707             ,input  'wndstore':U
     1708             ,output v-diasize-wndstore
     1709             ,output v-default-value
     1710             ) .
     1711         end.
     1712         assign
     1713           v-diasize-proc-name = entry(1, program-name(2), '.')
     1714         .
     1715         if v-diasize-wndstore = true
     1716         then do:
     1717           assign
     1718             v-restore-saved = false
     1719           .
     1720           if connected("ub") = true
     1721           then do:
     1722             run gbl/wndsizer.p
     1723               (input  v-cntxt-db-num
     1724               ,input  v-cntxt-userid
     1725               ,input  v-diasize-proc-name
     1726               ,input  'height':u
     1727               ,output v-resize-value-str
     1728               ) .
     1729             if v-resize-value-str <> '':U
     1730             then do:
     1731               run diasize_change-height in this-procedure
     1732                 (input  integer(v-resize-value-str)
     1733                 ,input  true
     1734                 ) .
     1735               assign
     1736                 v-restore-saved = true
     1737               .
     1738             end.
     1739           end.
     1740           if connected("ub") = true
     1741           then do:
     1742             run gbl/wndsizer.p
     1743               (input  v-cntxt-db-num
     1744               ,input  v-cntxt-userid
     1745               ,input  v-diasize-proc-name
     1746               ,input  'width':u
     1747               ,output v-resize-value-str
     1748               ) .
     1749             if v-resize-value-str <> '':U
     1750             then do:
     1751               run diasize_change-width in this-procedure
     1752                 (input  integer(v-resize-value-str)
     1753                 ,input  true
     1754                 ) .
     1755               assign
     1756                 v-restore-saved = true
     1757               .
     1758             end.
     1759           end.
     1760           if v-restore-saved <> true
     1761           then do:
     1762             if v-diasize-wndmax = true
     1763             then do:
     1764               run diasize_maximize in this-procedure
     1765                 (input  true
     1766                 ) .
     1767             end.
     1768           end.
     1769         end.
     1770         else do:
     1771           if v-diasize-wndmax = true
     1772           then do:
     1773             run diasize_maximize in this-procedure
     1774               (input  true
     1775               ) .
     1776           end.
     1777         end.
     1778       end.
     1779     end.
     1780   end procedure.
     1781   procedure diasize_need-full-display :
     1782     define output parameter p-need-full-display as logical   no-undo .
     1783     do
     1784     on error undo, return error return-value
     1785     :
     1786       assign
     1787         p-need-full-display = v-diasize-need-full-display
     1788       .
     1789       assign
     1790         v-diasize-need-full-display = false
     1791       .
     1792     end.
     1793   end procedure.
     1794   procedure get-context :
     1795      define output parameter p-db-num as integer          no-undo.
     1796      define output parameter p-user-id as character        no-undo.
     1797      define variable v-login               as character    no-undo.
     1798      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1799      define buffer buf_user-login  for ub.user-login .
     1800      do
     1801      on error undo, return error
     1802      :
     1803            FIND FIRST buf_sys-ctrl no-lock.
     1804            ASSIGN
     1805               v-login = USERID("ub")
     1806               p-db-num = buf_sys-ctrl.db-num
     1807            .
     1808            FIND FIRST buf_user-login
     1809                 WHERE buf_user-login.db-num = p-db-num
     1810                   AND buf_user-login.user-login = v-login
     1811                 no-lock
     1812                 no-error
     1813                 .
     1814            IF AVAILABLE buf_user-login
     1815            THEN DO:
     1816               assign
     1817                  p-user-id = buf_user-login.user-id
     1818               .
     1819            END.
     1820      end.
     1821   end procedure.
     1822       run diasize_init in this-procedure .
     1823   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1824   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1825   MAIN-BLOCK:
     1826   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1827      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1828   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1829     run mainmenu_getcntxt in parparentproc
     1830       (output v-cntxt-db-num
     1831       ,output v-cntxt-userid
     1832       ,output v-cntxt-level
     1833       ,output v-cntxt-host-code-obj
     1834       ,output v-cntxt-obj-type
     1835       ,output v-cntxt-obj-code
     1836       ,output v-cntxt-db-num-obj
     1837       ,output v-cntxt-is-admin
     1838       ) .
     1839     run StartProc in this-procedure .
     1840     assign FILL-IN_con-sum-contr = ub.fin-ob.sum-contr - ub.fin-ob.con-sum-contr .
     1841     find ub.currency where ub.currency.curr-code = ub.fin-ob.contract-curr no-lock.
     1842     assign FILL-curr-contr = ub.currency.curr-abbr .
     1843     RUN enable_UI.
     1844     WAIT-FOR GO OF FRAME Dialog-Frame.
     1845   END.
     1846   RUN disable_UI.
     1847   PROCEDURE CreateProc :
     1848     define variable all-sum-contr as decimal   no-undo .
     1849     define variable all-sum-base as decimal   no-undo .
     1850     define variable all-sum-rubl as decimal   no-undo .
     1851     define variable all-sum-doc as decimal   no-undo .
     1852     for each temp_fin-doc :
     1853       if temp_fin-doc.no-con-sum = 0 then next.
     1854       create ub.fin-connect .
     1855       assign
     1856         ub.fin-connect.connect-code   = next-value( s-fin-connect, ub )
     1857         ub.fin-connect.host-code      = p-host-code
     1858         ub.fin-connect.fin-doc-code   = temp_fin-doc.fin-doc-code
     1859         ub.fin-connect.fin-ob-code    = ub.fin-ob.doc-code
     1860         ub.fin-connect.contract-code  = ub.fin-ob.contract-code
     1861         ub.fin-connect.curr-code      = ub.fin-ob.curr-code
     1862         ub.fin-connect.base-rate      = ub.fin-ob.base-rate
     1863         ub.fin-connect.base-scale     = ub.fin-ob.base-scale
     1864         ub.fin-connect.contract-curr  = ub.fin-ob.contract-curr
     1865         ub.fin-connect.contract-rate  = ub.fin-ob.contract-rate
     1866         ub.fin-connect.contract-scale = ub.fin-ob.contract-scale
     1867         ub.fin-connect.exch-rate      = ub.fin-ob.exch-rate
     1868         ub.fin-connect.exch-scale     = ub.fin-ob.exch-scale
     1869         ub.fin-connect.status_        = 'тек':U
     1870         ub.fin-connect.sum-contr      = temp_fin-doc.no-con-sum
     1871         ub.fin-connect.sum-rubl       = round(ub.fin-connect.sum-contr * ub.fin-connect.contract-rate / ub.fin-connect.contract-scale,2)
     1872         ub.fin-connect.sum-base       = ub.fin-connect.sum-rubl * ub.fin-connect.base-scale / ub.fin-connect.base-rate
     1873         ub.fin-connect.sum-doc        = ub.fin-connect.sum-rubl * ub.fin-connect.exch-scale / ub.fin-connect.exch-rate
     1874         ub.fin-connect.sum-contr-ob   = ub.fin-connect.sum-contr
     1875         ub.fin-connect.sum-rubl-ob    = ub.fin-connect.sum-rubl
     1876         ub.fin-connect.sum-base-ob    = ub.fin-connect.sum-base
     1877       .
     1878   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1879   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     1880     (output ub.fin-connect.user-db-num
     1881     ,output ub.fin-connect.user-name
     1882     ,output ub.fin-connect.fact-date
     1883     ,output p-sys-time
     1884     ,output ub.fin-connect.fact-time
     1885     )  .
     1886       find first ub.fin-doc exclusive-lock where ub.fin-doc.host-code = p-host-code and ub.fin-doc.fin-doc-code = temp_fin-doc.fin-doc-code .
     1887       if ub.fin-connect.sum-contr > 0 then
     1888         assign
     1889           ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr + ub.fin-connect.sum-contr
     1890           ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  + ub.fin-connect.sum-base
     1891           ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  + ub.fin-connect.sum-rubl
     1892           ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   + ub.fin-connect.sum-doc
     1893         .
     1894       else
     1895         assign
     1896           ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr - ub.fin-connect.sum-contr
     1897           ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  - ub.fin-connect.sum-base
     1898           ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  - ub.fin-connect.sum-rubl
     1899           ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   - ub.fin-connect.sum-doc
     1900         .
     1901       assign
     1902         all-sum-contr       = all-sum-contr + ub.fin-connect.sum-contr
     1903         all-sum-base        = all-sum-base  + ub.fin-connect.sum-base
     1904         all-sum-rubl         = all-sum-rubl  + ub.fin-connect.sum-rubl
     1905         all-sum-doc          = all-sum-doc   + ub.fin-connect.sum-doc
     1906       .
     1907       if ub.fin-doc.sum-contr > ub.fin-doc.con-sum-contr then assign ub.fin-doc.con-stat = 1 .
     1908       else                                            assign ub.fin-doc.con-stat = 2 .
     1909     end.
     1910     if all-sum-contr <> 0 then do:
     1911       find current ub.fin-ob exclusive-lock .
     1912       assign
     1913         ub.fin-ob.con-sum-contr = ub.fin-ob.con-sum-contr + all-sum-contr
     1914         ub.fin-ob.con-sum-base  = ub.fin-ob.con-sum-base  + all-sum-base
     1915         ub.fin-ob.con-sum-rubl  = ub.fin-ob.con-sum-rubl  + all-sum-rubl
     1916         ub.fin-ob.con-sum-doc   = ub.fin-ob.con-sum-doc   + all-sum-doc
     1917       .
     1918       if ub.fin-ob.sum-contr > 0 then do:
     1919         if ub.fin-ob.sum-contr > ub.fin-ob.con-sum-contr then assign ub.fin-ob.con-stat = 1 .
     1920         else                                          assign ub.fin-ob.con-stat = 2 .
     1921       end.
     1922       else do:
     1923         if ub.fin-ob.sum-contr < ub.fin-ob.con-sum-contr then assign ub.fin-ob.con-stat = 1 .
     1924         else                                          assign ub.fin-ob.con-stat = 2 .
     1925       end.
     1926     end.
     1927   END PROCEDURE.
     1928   PROCEDURE disable_UI :
     1929     HIDE FRAME Dialog-Frame.
     1930   END PROCEDURE.
     1931   PROCEDURE enable_UI :
     1932     DISPLAY FILL-IN_con-sum-contr current-sum FILL-curr-contr
     1933         WITH FRAME Dialog-Frame.
     1934     IF AVAILABLE ub.fin-ob THEN
     1935       DISPLAY ub.fin-ob.prn-doc-code ub.fin-ob.doc-date ub.fin-ob.pay-date
     1936             ub.fin-ob.sum-contract
     1937         WITH FRAME Dialog-Frame.
     1938     ENABLE b-exit b-quit b-chg B-view-fo B-conn-fo B-view-doc B-conn-doc b-help
     1939            ub.fin-ob.prn-doc-code ub.fin-ob.doc-date ub.fin-ob.pay-date
     1940            ub.fin-ob.sum-contract Br-doc FILL-IN_con-sum-contr current-sum
     1941            FILL-curr-contr
     1942         WITH FRAME Dialog-Frame.
     1943     VIEW FRAME Dialog-Frame.
     1944     OPEN QUERY Br-doc FOR EACH temp_fin-doc WHERE TRUE  NO-LOCK INDEXED-REPOSITION.
     1945   END PROCEDURE.
     1946   PROCEDURE StartProc :
     1947     find first ub.fin-ob no-lock where recid(ub.fin-ob) = p-ri .
     1948     assign csum = ub.fin-ob.sum-contr - ub.fin-ob.con-sum-contr .
     1949     for each temp_fin-doc : delete temp_fin-doc . end.
     1950     DO ii = 1 TO NUM-ENTRIES(p-list) :
     1951       find first ub.fin-doc NO-LOCK WHERE RECID( ub.fin-doc ) = INT ( ENTRY( ii, p-list) ) .
     1952       CREATE temp_fin-doc .
     1953       BUFFER-COPY ub.fin-doc TO temp_fin-doc .
     1954       assign temp_fin-doc.ri = RECID( ub.fin-doc ) .
     1955       find first ub.contract no-lock where ub.contract.host-code = ub.fin-doc.host-code and ub.contract.contract-code = ub.fin-doc.contract-code .
     1956       if ub.contract.doc-type = 'при':U then do:
     1957         if   ub.fin-doc.fin-doc-type = 'ппп':U or ub.fin-doc.fin-doc-type = 'пко':U or ub.fin-doc.fin-doc-type = 'апп':U then
     1958           assign
     1959             temp_fin-doc.is-plus      = no
     1960             temp_fin-doc.sum-contr     = - temp_fin-doc.sum-contr
     1961             temp_fin-doc.con-sum-contr = - temp_fin-doc.con-sum-contr
     1962           .
     1963         else assign temp_fin-doc.is-plus = yes .
     1964       end.
     1965       else do:
     1966         if   ub.fin-doc.fin-doc-type = 'рпп':U or ub.fin-doc.fin-doc-type = 'рко':U or ub.fin-doc.fin-doc-type = 'апр':U then
     1967           assign
     1968             temp_fin-doc.is-plus      = no
     1969             temp_fin-doc.sum-contr     = - temp_fin-doc.sum-contr
     1970             temp_fin-doc.con-sum-contr = - temp_fin-doc.con-sum-contr
     1971           .
     1972         else assign temp_fin-doc.is-plus = yes .
     1973       end.
     1974       if csum > 0 then do:
     1975         if csum > temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr then do:
     1976           assign
     1977             temp_fin-doc.no-con-sum = temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr
     1978             csum = csum - temp_fin-doc.no-con-sum
     1979           .
     1980         end.
     1981         else do:
     1982           assign
     1983             temp_fin-doc.no-con-sum = csum
     1984             csum = 0
     1985           .
     1986         end.
     1987         assign current-sum = current-sum + temp_fin-doc.no-con-sum .
     1988       END.
     1989       else if csum < 0 then do:
     1990         if csum < temp_fin-doc.sum-contr - temp_fin-doc.con-sum-contr then do:
     1991           assign
     1992             temp_fin-doc.no-con-sum = - temp_fin-doc.sum-contr + temp_fin-doc.con-sum-contr
     1993             csum = csum + temp_fin-doc.no-con-sum
     1994           .
     1995         end.
     1996         else do:
     1997           assign
     1998             temp_fin-doc.no-con-sum = csum
     1999             csum = 0
     2000           .
     2001         end.
     2002         assign current-sum = current-sum + temp_fin-doc.no-con-sum .
     2003       END.
     2004     END.
     2005   END PROCEDURE.
