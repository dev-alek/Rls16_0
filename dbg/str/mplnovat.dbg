     1463      else do:
     1464                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1465                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1466                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
