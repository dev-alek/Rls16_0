      943   define variable parrecid as recid no-undo.
      944   define variable price-rubl-with-tax-saleprl    like doc-line.price-rubl no-undo.
      945   define variable price-base-with-tax-saleprl    like doc-line.price-base no-undo.
      946   define variable price-rubl-without-tax-saleprl like doc-line.price-rubl no-undo.
      947   define variable price-base-without-tax-saleprl like doc-line.price-base no-undo.
      948   define variable vat-base-saleprl               like doc-line.price-base no-undo.
      949   define variable vat-rubl-saleprl               like doc-line.price-rubl no-undo.
      950   define variable vat-base-buyerprl              like doc-line.price-base no-undo.
      951   define variable vat-rubl-buyerprl              like doc-line.price-rubl no-undo.
      952   define variable slt-base-saleprl               like doc-line.price-base no-undo.
