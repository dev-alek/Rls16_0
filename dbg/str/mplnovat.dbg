     2263     do
     2264     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     2265     :
     2266       find first bf_price-list no-lock
     2267         where recid(bf_price-list) = parrecid
     2268         no-error .
     2269       if not available bf_price-list
     2270       then do:
     2271         return error "Ошибка во входящих параметрах prl-vat.i" .
     2272       end.
     2273       find first bf_goods no-lock
     2274         where bf_goods.artic     = bf_price-list.artic
     2275           and bf_goods.prod-type = bf_price-list.prod-type
     2276           and bf_goods.prod-code = bf_price-list.prod-code
     2277         no-error .
     2278       if not available bf_goods
     2279       then do:
     2280         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     2281       end.
     2282       assign
     2283         varvat-pc = bf_price-list.vat-pc
     2284         varslt-pc = bf_price-list.slt-pc
     2285       .
     2286       if varvat-pc = ?
     2287       then do:
     2288         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2289       end.
     2290       if varslt-pc = ?
     2291       then do:
     2292         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2293       end.
     2294       assign
     2295         varbase-rate   = 1
     2296         varbase-scale  = 1
     2297         varroad-tax    = bf_price-list.road-tax
     2298         varexcise      = bf_price-list.excise
     2299         varprice-base  = bf_price-list.price-sale
     2300         varprice-rubl  = bf_price-list.price-sale
     2301         vardiscnt-base = 0
     2302         vardiscnt-rubl = 0
     2303       .
     2304       assign
     2305         varfact-qnty = 0
     2306       .
     2307       for each bf_parts no-lock
     2308         where bf_parts.out-code   = bf_price-list.doc-num
     2309           and bf_parts.obj-type   = bf_price-list.obj-type
     2310           and bf_parts.obj-code   = bf_price-list.obj-code
     2311           and bf_parts.artic      = bf_price-list.artic
     2312           and bf_parts.prod-type  = bf_price-list.prod-type
     2313           and bf_parts.prod-code  = bf_price-list.prod-code
     2314       :
     2315         assign
     2316           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     2317         .
     2318       end.
     2319       assign
     2320         vardoc-num   = bf_price-list.doc-num
     2321         vardoc-code  = bf_price-list.doc-num
     2322         varobj-type  = bf_price-list.obj-type
     2323         varobj-code  = bf_price-list.obj-code
     2324         varartic     = bf_price-list.artic
     2325         varprod-type = bf_price-list.prod-type
     2326         varprod-code = bf_price-list.prod-code
     2327         vardoc-qnty  = varfact-qnty
     2328         varext-doc-type = 'ot':U
     2329       .
     2330   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2332     (input  bf_price-list.obj-type
     2333     ,input  bf_price-list.obj-code
     2334     ,output v-host-code
     2335     )  .
     2336       find first bf_sysconf no-lock
     2337         where bf_sysconf.host-code = v-host-code
     2338         .
     2339       if bf_sysconf.cons-vat-pc = ?
     2340       then do:
     2341         return error "Не задан консигнационный НДС по фирме." .
     2342       end.
     2343       else do:
     2344         assign
