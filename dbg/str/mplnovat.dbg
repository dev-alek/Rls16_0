      236     on error undo, return error return-value
      237     :
      238           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      239         (input  p-code
      240         ,output p-type
      241         ,output p-format
      242         ,output p-label
      243         ,output p-user-can-edit
      244         ,output p-output-display
      245         ,output p-other
      246         ) no-error .
      247       if error-status :error
