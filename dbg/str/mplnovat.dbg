     1832          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     1833          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     1834          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1835          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     1836          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     1837          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     1838          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     1839          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1840          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     1841       end.
     1842       if buf2_trn-doc.doc-type = 'инв':U then do:
     1843         ASSIGN
     1844                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     1845           slt-base-sale               = varslt-base-docovp / varfact-qnty
     1846           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     1847           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     1848           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     1849                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     1850           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     1851           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     1852           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     1853           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     1854       end.
     1855       else do:
     1856         ASSIGN
     1857                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     1858           slt-base-sale               = varslt-base-factovp / varfact-qnty
     1859           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     1860           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     1861           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     1862                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     1863           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     1864           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     1865           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     1866           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     1867       end.
     1868     end.
     1869   end.
     1870   assign
     1871     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1872     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1873             if p-road-tax-rubl =  ? and  p-road-tax-base = ?  then
     1874             assign
     1875                 p-road-tax-base =  road-tax-base-sale
     1876                 p-road-tax-rubl =  road-tax-rubl-sale
     1877                 .
     1878             Assign
     1879                 p-calc-base   =  price-base-without-tax-sale
     1880                 p-calc-rubl   =  price-rubl-without-tax-sale
     1881                 p-price-base  =   price-base-without-tax-sale
     1882                       * (1 + p-disc / 100 )
     1883                       * (1 + (v-vat-pc / 100))
     1884                       * (1 + (v-slt-pc / 100))
     1885                       + p-road-tax-base
     1886                 p-price-rubl  = price-rubl-without-tax-sale
     1887                       * (1 + p-disc / 100 )
     1888                       * (1 + (v-vat-pc / 100))
     1889                       * (1 + (v-slt-pc / 100))
     1890                       + p-road-tax-rubl
     1891                 .
     1892             end.
     1893     End.
     1894   when 'Стар-безНДС':U  then do:
     1895         if v-cur-dn = ? then do:
     1896           message "Нет Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
     1897                   "- расчет от старой цены продажи невозможен."
     1898                   view-as alert-box question buttons OK-Cancel update v-log.
     1899                   return error .
     1900                   end.
     1901         else do :
     1902           find first buff-price-list-a where
     1903                      buff-price-list-a.doc-num = v-cur-dn and
     1904                      buff-price-list-a.price-type = "" and
     1905                      buff-price-list-a.b-code = p-b-code
     1906                      no-lock no-error .
     1907           if available buff-price-list-a then do:
     1908               l-vat = buff-price-list-a.vat-pc.
     1909               l-slt = buff-price-list-a.slt-pc.
     1910           end.
     1911           if not available buff-price-list-a
     1912               Then  parrecid = ?.
     1913               Else  DO :
     1914               parrecid = recid(buff-price-list-a) .
     1915               run prl-vat in this-procedure ( input   parrecid               ,
     1916               output  price-rubl-with-tax-saleprl    ,
     1917               output  price-base-with-tax-saleprl    ,
     1918               output  price-rubl-without-tax-saleprl ,
     1919               output  price-base-without-tax-saleprl ,
     1920               output  vat-base-saleprl               ,
     1921               output  vat-rubl-saleprl               ,
     1922               output  vat-base-buyerprl              ,
     1923               output  vat-rubl-buyerprl              ,
     1924               output  slt-base-saleprl               ,
     1925               output  slt-rubl-saleprl               ,
     1926               output  road-tax-base-saleprl          ,
     1927               output  road-tax-rubl-saleprl          ,
     1928               output  excise-base-saleprl            ,
     1929               output  excise-rubl-saleprl            ,
     1930               output  discnt-base-saleprl            ,
     1931               output  discnt-rubl-saleprl             ) no-error .
     1932               End.
     1933             if p-road-tax-rubl =  ? and  p-road-tax-base = ?  then
     1934             assign
     1935                 p-road-tax-base =  road-tax-base-saleprl
     1936                 p-road-tax-rubl =  road-tax-rubl-saleprl
     1937                 .
     1938             Assign
     1939                 p-calc-rubl   =  if var-pr-r-b = "rubl"  then  v-cur-pr else 0
     1940                 p-calc-base   =  if var-pr-r-b = "base" then   v-cur-pr else 0
     1941                 p-price-base  =  ( price-base-with-tax-saleprl
     1942                       - road-tax-base-saleprl)
     1943                       / (1 + (l-slt / 100))
     1944                       / (1 + (l-vat / 100))
     1945                       * (1 + p-disc    / 100 )
     1946                       * (1 + (v-vat-pc / 100))
     1947                       * (1 + (v-slt-pc / 100))
     1948                       + p-road-tax-base
     1949                 p-price-rubl  =   (price-rubl-with-tax-saleprl
     1950                       - road-tax-rubl-saleprl)
     1951                       / (1 + (l-slt / 100))
     1952                       / (1 + (l-vat / 100))
     1953                       * (1 + p-disc    / 100 )
     1954                       * (1 + (v-vat-pc / 100))
     1955                       * (1 + (v-slt-pc / 100))
     1956                       + p-road-tax-rubl
     1957                 .
     1958     end.
     1959   end.
     1960   when 'Старая':U  then do:
     1961         if v-cur-dn = ? then do:
     1962           message "Нет Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
     1963                   "- расчет от старой цены продажи невозможен."
     1964                   view-as alert-box question buttons OK-Cancel update v-log.
     1965                   return error .
     1966                   end.
     1967         else do :
     1968           find first buff-price-list-a where
     1969                      buff-price-list-a.doc-num = v-cur-dn and
     1970                      buff-price-list-a.price-type = "" and
     1971                      buff-price-list-a.b-code = p-b-code
     1972                      no-lock no-error .
     1973           if available buff-price-list-a then do:
     1974               l-vat = buff-price-list-a.vat-pc.
     1975               l-slt = buff-price-list-a.slt-pc.
     1976           end.
     1977           if not available buff-price-list-a
     1978               Then  parrecid = ?.
     1979               Else  DO :
     1980               parrecid = recid(buff-price-list-a) .
     1981               run prl-vat in this-procedure ( input   parrecid               ,
     1982               output  price-rubl-with-tax-saleprl    ,
     1983               output  price-base-with-tax-saleprl    ,
     1984               output  price-rubl-without-tax-saleprl ,
     1985               output  price-base-without-tax-saleprl ,
     1986               output  vat-base-saleprl               ,
     1987               output  vat-rubl-saleprl               ,
     1988               output  vat-base-buyerprl              ,
     1989               output  vat-rubl-buyerprl              ,
     1990               output  slt-base-saleprl               ,
     1991               output  slt-rubl-saleprl               ,
     1992               output  road-tax-base-saleprl          ,
     1993               output  road-tax-rubl-saleprl          ,
     1994               output  excise-base-saleprl            ,
     1995               output  excise-rubl-saleprl            ,
     1996               output  discnt-base-saleprl            ,
     1997               output  discnt-rubl-saleprl             ) no-error .
     1998               End.
     1999             if p-road-tax-rubl =  ? and  p-road-tax-base = ?  then
     2000             assign
     2001                 p-road-tax-base =  road-tax-base-saleprl
     2002                 p-road-tax-rubl =  road-tax-rubl-saleprl
     2003                 .
     2004             Assign
     2005                 p-calc-rubl   =  if var-pr-r-b = "rubl"  then  v-cur-pr else 0
     2006                 p-calc-base   =  if var-pr-r-b = "base" then   v-cur-pr else 0
     2007                 p-price-base  =   price-base-with-tax-saleprl  * (1 + p-disc    / 100 )
     2008                 p-price-rubl  =   price-rubl-with-tax-saleprl  * (1 + p-disc    / 100 )
     2009                 .
     2010     end.
     2011   end.
     2012   when 'Отсутствует':U  then do:
     2013         if v-cur-dn = ? then do:
     2014             assign
     2015                 p-road-tax-base =  0
     2016                 p-road-tax-rubl =  0
     2017                 p-calc-rubl   =  0
     2018                 p-calc-base   =  0
     2019                 p-price-base  =  0
     2020                 p-price-rubl  =  0
     2021                 .
     2022         end.
     2023         else do :
     2024           find first buff-price-list-a where
     2025                      buff-price-list-a.doc-num    = v-cur-dn and
     2026                      buff-price-list-a.price-type = ""       and
     2027                      buff-price-list-a.b-code     = p-b-code
     2028                      no-lock no-error .
     2029           if available buff-price-list-a then do:
     2030               l-vat = buff-price-list-a.vat-pc .
     2031               l-slt = buff-price-list-a.slt-pc .
     2032           end.
     2033           if not available buff-price-list-a
     2034               then  parrecid = ? .
     2035               else  do :
     2036               parrecid = recid ( buff-price-list-a ) .
     2037               run prl-vat in this-procedure
     2038                   ( input   parrecid                       ,
     2039                     output  price-rubl-with-tax-saleprl    ,
     2040                     output  price-base-with-tax-saleprl    ,
     2041                     output  price-rubl-without-tax-saleprl ,
     2042                     output  price-base-without-tax-saleprl ,
     2043                     output  vat-base-saleprl               ,
     2044                     output  vat-rubl-saleprl               ,
     2045                     output  vat-base-buyerprl              ,
     2046                     output  vat-rubl-buyerprl              ,
     2047                     output  slt-base-saleprl               ,
     2048                     output  slt-rubl-saleprl               ,
     2049                     output  road-tax-base-saleprl          ,
     2050                     output  road-tax-rubl-saleprl          ,
     2051                     output  excise-base-saleprl            ,
     2052                     output  excise-rubl-saleprl            ,
     2053                     output  discnt-base-saleprl            ,
     2054                     output  discnt-rubl-saleprl            )
     2055                     no-error .
     2056             end.
     2057             if p-road-tax-rubl =  ? and  p-road-tax-base = ?  then
     2058             assign
     2059                 p-road-tax-base =  road-tax-base-saleprl
     2060                 p-road-tax-rubl =  road-tax-rubl-saleprl
     2061                .
     2062             assign
     2063                 p-calc-rubl   =  if available buff-price-list-a then buff-price-list-a.price-sale else price-rubl-with-tax-saleprl
     2064                 p-calc-base   =  if available buff-price-list-a then buff-price-list-a.price-sale else price-base-with-tax-saleprl
     2065                 p-price-base  =  price-base-with-tax-saleprl  * (1 + p-disc / 100 )
     2066                 p-price-rubl  =  price-rubl-with-tax-saleprl  * (1 + p-disc / 100 )
     2067                .
     2068     end.
     2069   end.
     2070     when 'Откат_цен':U then do:
     2071       if v-cur-pr = ? then do:
     2072         message "Нет Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
     2073                 "- откат цены невозможен."
     2074                 view-as alert-box .
     2075         return error .
     2076       end.
     2077       else do:
     2078       v-cur-pr2 = ?.
     2079       find first buf_last_last-price-doc no-lock where
     2080                  buf_last_last-price-doc.doc-num = v-cur-dn no-error .
     2081       if available buf_last_last-price-doc then do:
     2082   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2083   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2084     (input  buf_last_last-price-doc.obj-type
     2085     ,input  buf_last_last-price-doc.obj-code
     2086     ,input  v-bar-code
     2087     ,input  0
     2088     ,input  buf_last_last-price-doc.fact-order
     2089     ,output v-cur-dn2
     2090     ,output v-cur-pr2
     2091     ,output v-cur-rt2
     2092     ,output v-cur-ex2
     2093     )  .
     2094       end.
     2095       if v-cur-pr2 = ? then do:
     2096         message "Нет предпоследнего Акта переоценки для товара :" buf_goods.artic buf_goods.gds-name
     2097                 "- откат цены невозможен."
     2098                 view-as alert-box.
     2099                 return error .
     2100         end.
     2101         else do:
     2102           assign
     2103             p-calc-base     =   v-cur-pr
     2104             p-calc-rubl     =   v-cur-pr
     2105             p-price-base    =   v-cur-pr2
     2106             p-price-rubl    =   v-cur-pr2
     2107             p-road-tax-base =   v-cur-rt2
     2108             p-road-tax-rubl =   v-cur-rt2
     2109             .
     2110         end.
     2111       end.
     2112     end.
     2113   end case.
     2114   if var-pr-r-b = "rubl" then
     2115   run compare_road-tax in this-procedure (input-output p-road-tax-rubl,  input v-bar-code, input  p-obj-type,  input p-obj-code,  input yes ).
     2116   else
     2117   run compare_road-tax in this-procedure (input-output p-road-tax-base,  input v-bar-code, input  p-obj-type,  input p-obj-code,  input yes ).
     2118   if p-price-base = 0 then do:
     2119     assign
     2120       p-price-base = ?
     2121     .
     2122   end.
     2123   if p-price-rubl = 0 then do:
     2124     assign
     2125       p-price-rubl = ?
     2126     .
     2127   end.
     2128   if (p-price-base = ?) <> (p-price-rubl = ?) then do:
     2129     message
     2130       vss-workfile vss-revision vss-description skip
     2131       "Цена в одной из валют не задана" skip
     2132       "p-price-base" p-price-base skip
     2133       "p-price-rubl" p-price-rubl skip
     2134       view-as alert-box error .
     2135     undo, return error .
     2136   end.
     2137   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2138   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2139   procedure prl-vat:
     2140     define input parameter parrecid as recid no-undo.
     2141       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     2142       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     2143       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     2144       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     2145       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     2146       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2147       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     2148       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     2149       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     2150       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2151       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     2152       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     2153       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     2154       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     2155       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     2156       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     2157       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     2158       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
     2159       define buffer out-vatp_partsprl       for ub.parts.
     2160       define buffer out-vatp_sysconfprl     for ub.sysconf.
     2161       define buffer out-vatp_doc-lineprl    for ub.doc-line.
