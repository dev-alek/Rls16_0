     2395       "Артикул" varartic varprod-type varprod-code skip
     2396       "Признак" varroot-nodeprl skip
     2397       "Запрашивался атрибут" "empty-scale=request" skip
     2398       error-status :get-message(1) skip
     2399       return-value skip
     2400       view-as alert-box error .
     2401     undo, return error .
     2402   end.
