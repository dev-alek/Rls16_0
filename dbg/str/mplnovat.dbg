      960   define variable v-cur-dn as character no-undo .
      961   define variable v-cur-pr as decimal no-undo .
      962   define variable v-cur-rt as decimal no-undo .
      963   define variable v-cur-ex as decimal no-undo .
      964   define variable v-cur-dn2 as character no-undo .
      965   define variable v-cur-pr2 as decimal no-undo .
      966   define variable v-cur-rt2 as decimal no-undo .
      967   define variable v-cur-ex2 as decimal no-undo .
      968   define variable v-log as logical no-undo .
      969   define variable p-obj-type    as character no-undo .
      970   define variable p-obj-code    as integer   no-undo .
      971   define variable l-slt like price-list.slt-pc no-undo .
      972   define variable l-vat like price-list.vat-pc no-undo .
      973   define variable par-type    as character no-undo .
      974   define variable v-tax-road as decimal no-undo .
      975   find first buf_goods no-lock
      976     where buf_goods.artic     = p-artic
      977       and buf_goods.prod-type = p-prod-type
      978       and buf_goods.prod-code = p-prod-code
      979     no-error .
      980   if not available buf_goods then do:
      981     message
      982       vss-workfile vss-revision vss-description skip
      983       "Не найден товар" skip
      984       "Артикул" p-artic p-prod-type p-prod-code skip
      985       view-as alert-box .
      986     undo, return error .
      987   end.
      988   find first x_obj-group no-error .
      989   if error-status :error then message
      990     vss-workfile vss-revision vss-description skip
      991     error-status :get-message(1) skip
      992     return-value skip
      993     ""
      994     view-as alert-box error
      995   .
      996   p-obj-type = x_obj-group.obj-type.
      997   p-obj-code = x_obj-group.obj-code.
      998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      999     (input  buf_goods.gds-code
     1000     ,input  ?
     1001     ,output v-bar-code
     1002     )  .
     1003   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1005     (input  p-obj-type
     1006     ,input  p-obj-code
     1007     ,input  p-b-code
     1008     ,input  0
     1009     ,input  0
     1010     ,output v-cur-dn
