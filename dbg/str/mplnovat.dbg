     2351      out-vatp-have-vat-sltprl = yes.
     2352   end.
     2353   else do:
     2354     find first out-vatp_doc-attrprl no-lock
     2355       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     2356         and out-vatp_doc-attrprl.attr-code = 'envd':U
     2357         no-error .
     2358     if not available out-vatp_doc-attrprl then do:
     2359       assign
     2360         out-vatp-have-vat-sltprl = yes.
     2361     end.
     2362     else do:
     2363        out-vatp-have-vat-sltprl = no.
     2364     end.
     2365   end.
