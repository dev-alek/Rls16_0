     1543     when 'Накл-безНДС':U + "Other":U then DO:
     1544             find buf2_trn-doc where buf2_trn-doc.doc-code  = p-doc-num no-lock no-error .
     1545             find buf_doc-line where     buf_doc-line.doc-code = p-doc-num
     1546                             and buf_doc-line.artic     = p-artic
     1547                             and buf_doc-line.prod-type = p-prod-type
     1548                             and buf_doc-line.prod-code = p-prod-code no-lock no-error.
     1549             if available buf_doc-line then do :
     1550   if buf2_trn-doc.ext-doc-type = 'ot':U or
