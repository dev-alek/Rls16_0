     2404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2405     (output varoutvprbprl
     2406     )  .
     2407   if varoutvprbprl = "base":u then do:
     2408     assign
     2409           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     2410       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     2411     .
     2412   end.
     2413   else do:
     2414     assign
     2415           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     2416       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     2417     .
     2418   end.
     2419   if varoutvprbprl = "rubl":u then do:
     2420     assign
     2421           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     2422       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     2423   end.
     2424   else do:
     2425     assign
     2426           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     2427       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     2428   end.
     2429   assign
     2430     varis-cons-parts-haveprl =  no.
     2431   assign
     2432     varfact-qntyprl       = 0
     2433     varcons-qntyprl       = 0
     2434     varprice-base-consprl = 0
     2435     varprice-rubl-consprl = 0.
     2436   find first out-vatp_doc-lineprl where
     2437              out-vatp_doc-lineprl.doc-code   = vardoc-num
     2438          and out-vatp_doc-lineprl.artic      = varartic
     2439          and out-vatp_doc-lineprl.prod-type  = varprod-type
     2440          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     2441   if available out-vatp_doc-lineprl           and
     2442     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     2443     assign
