     1013     ,output v-cur-ex
     1014     )  .
     1015   define buffer buff_price-lista for ub.price-list.
     1016     find first buff_price-lista no-lock where
     1017                buff_price-lista.doc-num = v-cur-dn and
     1018                buff_price-lista.price-type = "" and
     1019                buff_price-lista.b-code = p-b-code no-error .
     1020     if v-cur-dn = ?  or not available buff_price-lista then do:
     1021   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1023     (input  p-obj-type
     1024     ,input  p-obj-code
     1025     ,input  v-bar-code
     1026     ,input  0
     1027     ,input  0
     1028     ,output v-cur-dn
     1029     ,output v-cur-pr
     1030     ,output v-cur-rt
     1031     ,output v-cur-ex
     1032     )  .
     1033           p-b-code = v-bar-code .
     1034     end.
     1035   run main-road-tax in this-procedure
     1036     ( input p-obj-type,
     1037       input p-obj-code,
     1038       input p-artic   ,
     1039       input p-prod-type,
     1040       input p-prod-code,
     1041       input-output p-road-tax-base,
     1042       input-output p-road-tax-rubl )
     1043      .
     1044   assign
     1045       v-total-avrg-qnty  = 0
     1046       v-total-price-base = 0
     1047       v-total-price-rubl = 0
     1048       v-total-road-tax-base =  0
     1049       v-total-road-tax-rubl =  0
     1050       v-all-total-road-tax-base =  0
     1051       v-all-total-road-tax-rubl =  0
     1052             .
     1053   case p-price-type :
     1054     when 'Учет+накл':U  then do:
     1055       if buf_goods.gds-type = 'т':U then do:
     1056         for each x_obj-group ,
     1057         each buf_parts no-lock
     1058           where  buf_parts.obj-type  = x_obj-group.obj-type
     1059             and buf_parts.obj-code  = x_obj-group.obj-code
     1060             and buf_parts.artic     = p-artic
     1061             and buf_parts.prod-type = p-prod-type
     1062             and buf_parts.prod-code = p-prod-code
     1063             and buf_parts.status_   = no
     1064             and ( buf_parts.out-code  = 'free-zone':U
     1065                 or buf_parts.out-code  = p-doc-num  )
     1066         on error undo, return error
     1067         :
     1068           assign
     1069             v-total-avrg-base = v-total-avrg-base
     1070                               + (buf_parts.price-base * buf_parts.qnty)
     1071             v-total-avrg-rubl = v-total-avrg-rubl
     1072                               + (buf_parts.price-rubl * buf_parts.qnty)
     1073             v-total-avrg-qnty = v-total-avrg-qnty
     1074                               + buf_parts.qnty
     1075           .
     1076         end.
     1077         if v-total-avrg-qnty > 0 then do:
     1078           assign
     1079             p-price-base = ( v-total-avrg-base / v-total-avrg-qnty ) * (1 + p-disc / 100)
     1080             p-price-rubl = ( v-total-avrg-rubl / v-total-avrg-qnty ) * (1 + p-disc / 100)
     1081           .
     1082         end.
     1083         else do:
     1084             run last-incom-S in this-procedure
     1085             ( input   p-artic ,
     1086               input   p-prod-type,
     1087               input   p-prod-code ,
     1088               output  v-last-in-code,
     1089               output  v-last-obj-type,
     1090               output  v-last-obj-code ).
     1091               find first buf_gds-obj no-lock
     1092                 where buf_gds-obj.obj-type  = v-last-obj-type
     1093                   and buf_gds-obj.obj-code  = v-last-obj-code
     1094                   and buf_gds-obj.artic     = p-artic
     1095                   and buf_gds-obj.prod-type = p-prod-type
     1096                   and buf_gds-obj.prod-code = p-prod-code
     1097                 no-error .
     1098               if available buf_gds-obj then do:
     1099                 assign
     1100                   p-price-base = buf_gds-obj.last-base * (1 + p-disc / 100)
     1101                   p-price-rubl = buf_gds-obj.last-rubl * (1 + p-disc / 100)
     1102                 .
     1103               end.
     1104         end.
     1105       end.
     1106       else do:
     1107             run last-incom-S in this-procedure
     1108             ( input   p-artic ,
     1109               input   p-prod-type,
     1110               input   p-prod-code ,
     1111               output  v-last-in-code,
     1112               output  v-last-obj-type,
     1113               output  v-last-obj-code ).
     1114         find first buf_gds-obj no-lock
     1115           where buf_gds-obj.obj-type  = v-last-obj-type
     1116             and buf_gds-obj.obj-code  = v-last-obj-code
     1117             and buf_gds-obj.artic     = p-artic
     1118             and buf_gds-obj.prod-type = p-prod-type
     1119             and buf_gds-obj.prod-code = p-prod-code
     1120           no-error .
     1121         if available buf_gds-obj then do:
     1122           assign
     1123             p-price-base = ( buf_gds-obj.price-base ) * (1 + p-disc / 100)
     1124             p-price-rubl = ( buf_gds-obj.price-rubl ) * (1 + p-disc / 100)
     1125           .
     1126         end.
     1127         else do:
     1128           assign
     1129             p-price-base = ?
     1130             p-price-rubl = ?
     1131           .
     1132         end.
     1133       end.
     1134     end.
     1135     when 'Учет-НДСS':U then do:
     1136        assign
     1137             v-total-avrg-qnty  = 0
     1138             v-total-price-base = 0
     1139             v-total-price-rubl = 0
     1140             v-total-road-tax-base =  0
     1141             v-total-road-tax-rubl =  0
     1142             v-all-total-road-tax-base =  0
     1143             v-all-total-road-tax-rubl =  0
     1144             .
     1145         for each x_obj-group,
     1146             each buf_parts no-lock
     1147           where (
     1148                 buf_parts.obj-type  = x_obj-group.obj-type
     1149             and buf_parts.obj-code  = x_obj-group.obj-code
     1150             and buf_parts.artic     = p-artic
     1151             and buf_parts.prod-type = p-prod-type
     1152             and buf_parts.prod-code = p-prod-code
     1153             and buf_parts.status_   = no
     1154             and buf_parts.out-code  = 'free-zone':U
     1155             and buf_parts.qnty      > 0
     1156             ) or
     1157             (   buf_parts.obj-type  = x_obj-group.obj-type
     1158             and buf_parts.obj-code  = x_obj-group.obj-code
     1159             and buf_parts.artic     = p-artic
     1160             and buf_parts.prod-type = p-prod-type
     1161             and buf_parts.prod-code = p-prod-code
     1162             and buf_parts.status_   = no
     1163             and buf_parts.out-code  = p-doc-num
     1164             )
     1165         on error undo, return error
     1166         :
     1167            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     1168   assign
     1169     price-rubl-with-tax-loc = buf_parts.price-rubl
     1170     price-base-with-tax-loc = buf_parts.price-base
     1171   .
     1172   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1174     (output varinvprb
     1175     )  .
     1176     if buf_parts.out-code = 'free-zone':U     or
     1177        buf_parts.out-code = 'out-zone':U   or
     1178        buf_parts.doc-type = 'акт':U then do:
     1179       assign
     1180         in-vatp-have-vat-slt = yes.
     1181     end.
     1182     else do:
     1183       find first in-vatp_doc-attr no-lock
     1184         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1185           and in-vatp_doc-attr.attr-code = 'envd':U
     1186         no-error .
     1187       if not available in-vatp_doc-attr then do:
     1188         assign
     1189           in-vatp-have-vat-slt = yes.
     1190       end.
     1191       else do:
     1192            in-vatp-have-vat-slt = no.
     1193       end.
     1194     end.
     1195     assign
     1196      price-cli-with-tax-loc = buf_parts.price-cli
     1197      cli-base-rate          = buf_parts.cli-base-rate.
     1198     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1199              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1200     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1201             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1202             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1203             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1204             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1205             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1206             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1207       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1208     assign
     1209       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1210     assign
     1211       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1212       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1213       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1214       transport-cli-loc  = 0
     1215       other-cli-loc      = 0
     1216     .
     1217   ASSIGN
     1218             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1219       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1220   .
     1221           assign
     1222             v-total-price-base    =  v-total-price-base +
     1223                         ( (price-base-with-tax-loc
     1224                         - vat-base-loc
     1225                         - road-tax-base-loc )
     1226                         * buf_parts.fact-qnty)
     1227             v-total-price-rubl    =  v-total-price-rubl +
     1228                          ( (price-rubl-with-tax-loc
     1229                          - road-tax-rubl-loc
     1230                          - vat-rubl-loc)
     1231                          * buf_parts.fact-qnty)
     1232             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     1233             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     1234            .
     1235         end.
     1236             if v-total-avrg-qnty > 0 then  DO:
     1237                 Assign
     1238                     p-calc-base     =  v-total-price-base / v-total-avrg-qnty
     1239                     p-calc-rubl     =  v-total-price-rubl / v-total-avrg-qnty
     1240                     p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     1241                     p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     1242                     p-price-base    =  p-calc-base
     1243                                         * (1 + p-disc / 100)
     1244                                         * (1 + v-vat-pc / 100 )
     1245                                         * (1 + v-slt-pc / 100 )
     1246             + p-road-tax-base
     1247                     p-price-rubl    = ( p-calc-rubl )
     1248                                        * (1 + p-disc / 100)
     1249                                        * (1 + v-vat-pc / 100)
     1250                                        * (1 + v-slt-pc / 100)
     1251                                        + p-road-tax-rubl
     1252                     .
     1253                End.
     1254               if v-total-avrg-qnty <= 0 then do:
     1255                   run last-incom-S in this-procedure
     1256                   ( input   p-artic ,
     1257                     input   p-prod-type,
     1258                     input   p-prod-code ,
     1259                     output  v-last-in-code,
     1260                     output  v-last-obj-type,
     1261                     output  v-last-obj-code ).
     1262                         find buf2_trn-doc where buf2_trn-doc.doc-code  = v-last-in-code no-lock no-error .
     1263                         find buf_doc-line where     buf_doc-line.doc-code = v-last-in-code
     1264                                         and buf_doc-line.artic     = p-artic
     1265                                         and buf_doc-line.prod-type = p-prod-type
     1266                                         and buf_doc-line.prod-code = p-prod-code no-lock no-error.
     1267                         if available buf_doc-line then do :
     1268   assign
     1269     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1270     price-base-with-tax-loc = buf_doc-line.price-base
     1271   .
     1272   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1274     (output varinvprb
     1275     )  .
     1276      find first in-vatp_doc-attr no-lock
     1277       where in-vatp_doc-attr.doc-code  = buf2_trn-doc.doc-code
     1278         and in-vatp_doc-attr.attr-code = 'envd':U
     1279       no-error .
     1280       if available in-vatp_doc-attr
     1281          then do:
     1282          assign
     1283            in-vatp-have-vat-slt = no.
     1284      end.
     1285      else do:
     1286        assign
     1287          in-vatp-have-vat-slt = yes.
     1288      end.
     1289      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1290                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1291                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1292      if (not buf2_trn-doc.internal and
     1293              buf2_trn-doc.doc-type = 'при':U) or
     1294         in-vatp-goods.gds-type = 'у':U then do:
     1295         if varinvprb = "base":u then do:
     1296           assign
     1297             road-tax-base-loc = buf_doc-line.road-tax
     1298             road-tax-rubl-loc = buf_doc-line.road-tax * buf2_trn-doc.base-rate / buf2_trn-doc.base-scale.
     1299         end.
     1300         else do:
     1301           ASSIGN
     1302             road-tax-rubl-loc = buf_doc-line.road-tax
     1303             road-tax-base-loc = buf_doc-line.road-tax / buf2_trn-doc.base-rate * buf2_trn-doc.base-scale.
     1304         end.
     1305         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1306         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1307         assign
     1308           road-tax-cli-loc = ?.
     1309         ASSIGN
     1310           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1311           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1312           transport-cli-loc  = 0
