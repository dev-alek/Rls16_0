     1985   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1986   function octal-to-char return character
     1987   ( p-string as character ) :
     1988     def var v-asc     as integer no-undo .
     1989     def var v-new-asc as integer no-undo .
     1990     def var ind       as integer no-undo .
     1991     if length(p-string) <> 3 then do:
     1992       return ? .
     1993     end.
     1994     assign
     1995       v-asc = 0
     1996     .
     1997     do ind = 1 to length(p-string)
     1998     :
     1999       assign
     2000         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2001       .
     2002       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2003         return ? .
     2004       end.
     2005       assign
     2006         v-asc = v-asc * 8 + v-new-asc
     2007       .
     2008     end.
     2009     return chr(v-asc) .
     2010   end function .
     2011   function char-to-octal return character
     2012   ( p-chr as character ) :
     2013     def var v-asc    as integer   no-undo .
     2014     def var ind      as integer   no-undo .
     2015     def var v-string as character no-undo .
     2016     if length(p-chr) <> 1 then do:
     2017       return ? .
     2018     end.
     2019     assign
     2020       v-asc    = asc(p-chr)
     2021       v-string = ""
     2022     .
     2023     do ind = 1 to 3
     2024     :
     2025       assign
     2026         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2027       .
     2028       assign
     2029         v-asc = truncate(v-asc / 8, 0)
     2030       .
     2031     end.
     2032     return v-string .
     2033   end.
     2034   function str-encode return character
     2035   (   p-init-string       as character
     2036     , p-encode-char       as character
     2037     , p-special-char-list as character
     2038   ) :
     2039     def var p-encode-string as character no-undo .
     2040     def var ind                as integer no-undo .
     2041     def var v-num-special-char as integer no-undo .
     2042     def var v-special-char     as character no-undo .
     2043     if p-encode-char = ?
     2044     or p-encode-char = "" then do:
     2045       assign
     2046         p-encode-char = "~~"
     2047       .
     2048     end.
     2049     if p-init-string = ? then do:
     2050       return "?" .
     2051     end.
     2052     if p-init-string = "?" then do:
     2053       return p-encode-char + char-to-octal("?") .
     2054     end.
     2055     assign
     2056       v-num-special-char = length(p-special-char-list)
     2057       p-encode-string    = replace(p-init-string
     2058                                   ,p-encode-char
     2059                                   ,p-encode-char + char-to-octal(p-encode-char)
     2060                                   )
     2061     .
     2062     do ind = 1 to v-num-special-char
     2063     :
     2064       assign
     2065         v-special-char = substring(p-special-char-list, ind, 1)
     2066       .
     2067       if v-special-char <> p-encode-char then do:
     2068         assign
     2069           p-encode-string = replace (p-encode-string
     2070                                     ,v-special-char
     2071                                     ,p-encode-char + char-to-octal(v-special-char)
     2072                                     )
     2073         .
     2074       end.
     2075     end.
     2076     return p-encode-string .
     2077   end.
     2078   function str-decode returns character
     2079     (p-init-string   as character
     2080     ,p-encode-char   as character
     2081     ) :
     2082     def var p-decode-string as character no-undo .
     2083     def var ind                       as integer no-undo .
     2084     def var v-num-entries-init-string as integer no-undo .
     2085     def var v-sub-phrase              as character no-undo .
     2086     def var v-special-char            as character no-undo .
     2087     if p-encode-char = ?
     2088     or p-encode-char = "" then do:
     2089       assign
     2090         p-encode-char = "~~"
     2091       .
     2092     end.
     2093     if p-init-string = "?" then do:
     2094       return ? .
     2095     end.
     2096     assign
     2097       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2098     .
     2099     if v-num-entries-init-string > 1 then do:
     2100       assign
     2101         p-decode-string = entry(1, p-init-string, p-encode-char)
     2102       .
     2103       do ind = 2 to v-num-entries-init-string
     2104       :
     2105         assign
     2106           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2107         .
     2108         assign
     2109           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2110         .
     2111         if v-special-char <> ? then do:
     2112           assign
     2113             p-decode-string = p-decode-string
     2114                             + v-special-char
     2115                             + substring(v-sub-phrase, 4)
     2116           .
     2117         end.
     2118         else do:
     2119           assign
     2120             p-decode-string = p-decode-string
     2121                             + p-encode-char
     2122                             + v-sub-phrase
     2123           .
     2124         end.
     2125       end.
     2126     end.
     2127     else do:
     2128       assign
     2129         p-decode-string = p-init-string
     2130       .
     2131     end.
     2132     return p-decode-string .
     2133   end.
     2134   define variable vss-include-info20 as character format "X(65)" no-undo
     2135   initial "@(#)$Workfile$ $Revision$".
     2136   procedure fbrrsrv-rsrv-goods :
     2137   define input parameter p-parent-proc            as handle                   no-undo.
     2138   define input parameter p-goods-recid            as recid                    no-undo.
     2139   define input parameter p-doc-line-recid         as recid                    no-undo.
     2140   define input parameter p-required-qnty          like doc-line.doc-qnty      no-undo.
     2141   define input parameter p-set-price              as logical                  no-undo.
     2142   define input parameter p-price                  as decimal                  no-undo.
