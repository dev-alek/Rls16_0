     3122   procedure create-doc-line :
     3123   define input parameter p-doc-code       as character    no-undo.
     3124   define input parameter p-gds-code       as integer      no-undo.
     3125   define input parameter p-qnty           as decimal      no-undo.
     3126   define output parameter p-sum-base      as decimal      no-undo .
     3127   define output parameter p-sum-rubl      as decimal      no-undo .
     3128   define output parameter p-sum-vat-base  as decimal      no-undo .
     3129   define output parameter p-sum-vat-rubl  as decimal      no-undo .
     3130       define variable v-required-qnty     as decimal        no-undo.
     3131       define variable v-reserved-qnty     as decimal        no-undo.
     3132       define variable v-today             as date           no-undo.
     3133       define variable v-time              as integer        no-undo.
     3134       define variable v-sum-base          as decimal        no-undo.
     3135       define variable v-sum-rubl          as decimal        no-undo.
     3136       define variable v-vat-base          as decimal        no-undo.
     3137       define variable v-vat-rubl          as decimal        no-undo.
     3138       define variable v-vat-pc            as decimal        no-undo.
     3139       define variable v-host-code         as integer        no-undo.
     3140       define buffer buf_trn-doc       for trn-doc.
     3141       define buffer buf_doc-line      for doc-line.
     3142       define buffer buf_goods         for goods.
     3143       define buffer buf_gds-dtl       for gds-dtl.
     3144       define buffer buf_gds-prt       for gds-prt.
     3145   do
     3146   for buf_trn-doc
     3147     , buf_doc-line
     3148     , buf_goods
     3149     , buf_gds-dtl
     3150     , buf_gds-prt
     3151   on error undo, return error
     3152   :
     3153       find first buf_trn-doc no-lock
     3154            where buf_trn-doc.doc-code = p-doc-code
     3155       .
     3156       find first buf_goods no-lock
     3157            where buf_goods.gds-code = p-gds-code
     3158       .
     3159       create buf_doc-line.
     3160       assign
     3161           buf_doc-line.artic         = buf_goods.artic
     3162           buf_doc-line.prod-type     = buf_goods.prod-type
     3163           buf_doc-line.prod-code     = buf_goods.prod-code
     3164           buf_doc-line.obj-type      = buf_trn-doc.obj-type
     3165           buf_doc-line.obj-code      = buf_trn-doc.obj-code
     3166           buf_doc-line.doc-code      = buf_trn-doc.doc-code
     3167           buf_doc-line.prt-ok        = yes
     3168           buf_doc-line.prt-root      = buf_goods.prt-root
     3169           buf_doc-line.status_       = buf_trn-doc.status_
     3170           buf_doc-line.doc-qnty      = 0
     3171           buf_doc-line.cli-base-rate = 1
     3172           v-required-qnty            = round( p-qnty, 3 )
     3173           v-reserved-qnty            = 0
     3174       .
     3175       run fbrrsrv-rsrv-goods in this-procedure (
     3176             input parparentproc
     3177           , input recid( buf_goods )
     3178           , input recid( buf_doc-line )
     3179           , input v-required-qnty
     3180           , input no
     3181           , input 0
     3182           , input no
     3183           , input ""
     3184           , output v-reserved-qnty
     3185       ) no-error.
     3186       if error-status :error
     3187       then do:
     3188           if error-status :get-message(1) <> ""
     3189           or return-value <> "user-interrupt":U
     3190           then do:
     3191               message
     3192               vss-workfile vss-revision vss-description
     3193               skip "Ошибка резервирования товара."
     3194               skip return-value
     3195               skip trim(error-status :get-message(1))
     3196                   trim(error-status :get-message(2))
     3197                   trim(error-status :get-message(3))
     3198               view-as alert-box error.
     3199           end.
     3200           undo, return error return-value.
     3201       end.
     3202       if v-required-qnty <> v-reserved-qnty
     3203       then do:
     3204           message
     3205           "Невозможно зарезервировать товар."
     3206           skip(1)
     3207           skip "Товар:" buf_goods.artic buf_goods.gds-name
     3208           skip "Объект:" buf_trn-doc.obj-type buf_trn-doc.obj-code
     3209           skip "Количество:" v-required-qnty
     3210           skip "Доступно количество:" v-reserved-qnty
     3211           view-as alert-box error.
     3212           undo, return error .
     3213       end.
     3214       run str/fbrcost.p (
     3215             input recid( buf_doc-line )
     3216           , input -1
     3217           , input v-required-qnty
     3218           , output v-sum-base
     3219           , output v-sum-rubl
     3220           , output v-vat-base
     3221           , output v-vat-rubl
     3222           , output v-vat-pc
     3223         ) .
     3224       run cur-time in this-procedure (
     3225             output v-today
     3226           , output v-time
     3227       ).
     3228   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3230     (input  buf_trn-doc.obj-type
     3231     ,input  buf_trn-doc.obj-code
     3232     ,output v-host-code
     3233     )  .
     3234   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3236     (input  buf_goods.gds-code
     3237     ,input  '1':U
     3238     ,input  ?
     3239     ,input  v-host-code
     3240     ,input  buf_trn-doc.obj-type
     3241     ,input  buf_trn-doc.obj-code
     3242     ,output v-vat-pc
     3243     )  .
     3244       find first buf_gds-prt no-lock
     3245            where buf_gds-prt.upper-code = buf_goods.prt-root
     3246       .
     3247       find first buf_gds-dtl exclusive-lock
     3248            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     3249              and buf_gds-dtl.artic     = buf_goods.artic
     3250              and buf_gds-dtl.prod-type = buf_goods.prod-type
     3251              and buf_gds-dtl.prod-code = buf_goods.prod-code
     3252              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     3253       .
     3254       assign
     3255           buf_doc-line.doc-qnty   = v-reserved-qnty
     3256           buf_doc-line.fact-qnty  = v-reserved-qnty
     3257           buf_gds-dtl.doc-qnty    = v-reserved-qnty
     3258           buf_gds-dtl.fact-qnty   = v-reserved-qnty
     3259           p-sum-base              = v-sum-base - v-vat-base
     3260           p-sum-rubl              = v-sum-rubl - v-vat-rubl
     3261           p-sum-vat-base          = v-vat-base
     3262           p-sum-vat-rubl          = v-vat-rubl
     3263       .
     3264       assign
     3265           buf_doc-line.price-cli  = v-sum-rubl / v-reserved-qnty
     3266           buf_doc-line.price-base = v-sum-base / v-reserved-qnty
     3267           buf_doc-line.price-rubl = v-sum-rubl / v-reserved-qnty
     3268           buf_doc-line.VAT-pc     = v-vat-pc
     3269       .
     3270   end.
     3271   end procedure.
     3272   procedure get-fbroperator :
     3273   define input parameter p-fbr-doc-code   as character        no-undo.
     3274   define output parameter p-agnt          as integer          no-undo.
     3275   define output parameter p-boss          as integer          no-undo.
     3276   define output parameter p-wrkr          as integer          no-undo.
     3277       define variable v-agntbosswrkr      as character    no-undo.
     3278       define variable v-operator-code     as integer      no-undo.
     3279       define variable v-operator-string   as integer      no-undo.
     3280       define buffer buf_clients       for clients.
     3281   do
     3282   for buf_clients
     3283   on error undo, return error
     3284   :
     3285       assign
     3286           v-operator-code = 0
     3287       .
     3288       run fbrattr-value in this-procedure (
     3289           input 'fbr-doc':U
     3290           , input p-fbr-doc-code
     3291           , input 'fbroperator':U
     3292           , output v-operator-string
     3293       ) no-error.
     3294       if not error-status :error
     3295       then do:
     3296           assign
     3297               v-operator-code = integer( v-operator-string )
     3298           no-error.
     3299           if error-status :error
     3300           then do:
     3301               assign
     3302                   v-operator-code = 0
     3303               .
     3304           end.
     3305           else do:
     3306               find first buf_clients no-lock
     3307                   where buf_clients.obj-type = 'чел':U
     3308                   and buf_clients.obj-code = v-operator-code
     3309               no-error.
     3310               if not available buf_clients
     3311               then do:
     3312                   assign
     3313                       v-operator-code = 0
     3314                   .
     3315               end.
     3316           end.
     3317       end.
     3318       if v-operator-code > 0
     3319       then do:
     3320           assign
     3321               p-agnt = v-operator-code
     3322               p-boss = v-operator-code
     3323               p-wrkr = v-operator-code
     3324           .
     3325       end.
     3326   end.
     3327   end procedure.
