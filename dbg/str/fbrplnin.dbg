     2345               end.
     2346               if v-cost-base <= 0
     2347               or v-cost-rubl <= 0
     2348               then do:
     2349                   undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     2350                                                 ,chr(10)
     2351                                                 ,"РУБЛИ:   "
     2352                                                 ,v-cost-rubl
     2353                                                 ,v-cost-base
     2354                                                 ,buf_doc-line.artic).
     2355               end.
     2356           end.
     2357           assign
     2358               p-rsrv-qnty = p-rsrv-qnty + v-sum-parts-rsrv-qnty
     2359           .
     2360       end.
     2361       else do:
     2362           run trg/rsrv-dtl.p (
     2363                 input p-parent-proc
     2364               , input 'reserv':U
     2365                       + ",":U + 'no-message':U
     2366                       + ",":U + 'negative-check':U + '=':U + '1':U
     2367               , buffer buf_gds-dtl
     2368               , input-output p-rsrv-qnty
     2369               , input-output v-cost-base
     2370               , input-output v-cost-rubl
     2371               , input -1
     2372               , input ""
     2373           ) no-error.
     2374           if error-status:error
     2375           then do:
     2376               undo, return error return-value.
     2377           end.
     2378           if v-cost-base <= 0
     2379           or v-cost-rubl <= 0
     2380           then do:
     2381             undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     2382                                           ,chr(10)
     2383                                           ,"РУБЛИ:   "
     2384                                           ,v-cost-rubl
     2385                                           ,v-cost-base
     2386                                           ,buf_doc-line.artic).
     2387           end.
     2388       end.
     2389   end.
     2390   end procedure.
     2391   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2392   procedure doc-code:
     2393   define input  parameter parmode          as   character           no-undo.
     2394   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2395   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2396   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2397   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2398   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2399   define variable vardb-remote     as   logical             no-undo.
     2400   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2401   define variable v-delimiter as character no-undo .
     2402   do
     2403   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2404   :
     2405   find first buf_sys-ctrl no-lock .
     2406   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2407     CASE parmode:
     2408       when "main":u then do:
     2409         if vardb-remote then do:
     2410           assign
     2411             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2412         end.
     2413         else do:
     2414           assign
     2415             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2416         end.
     2417       end.
     2418       when "trio" then do:
     2419         assign
     2420           pardoc-code = replace (parroot-doc-code, "=", "*").
     2421       end.
     2422       otherwise do:
     2423         assign
     2424         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2425         no-error
     2426         .
     2427         if error-status:error  then do:
     2428           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2429                                         ,chr(10)
     2430                                         ,parmode
     2431                                         ).
     2432         end.
     2433         if num-entries(parmode) = 1
     2434         and parmode <> "chip":U
     2435         and parmode <> "chip_s":U
     2436         then do:
     2437           assign
     2438           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2439         end.
     2440         else if (lookup("chip":U, parmode) > 0
     2441                  or
     2442                  lookup("chip_s":U, parmode) > 0) then do:
     2443           assign
     2444             vartemp-doc-code = parroot-doc-code.
     2445           do while true:
     2446             if index (vartemp-doc-code , ".") = 0 then
     2447               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2448             else
     2449               vartemp-doc-code  =
     2450               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2451               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2452               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2453             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2454           end.
     2455           assign
     2456             pardoc-code = vartemp-doc-code.
     2457         end.
     2458       end.
     2459     end CASE.
     2460     if pardoc-code = '':U
     2461     or (parroot-doc-code <> '':U
     2462     and pardoc-code = parroot-doc-code) then do:
     2463       undo, return error substitute("Ошибка при генерации номера документа&1"
     2464                                     ,chr(10)).
     2465     end.
     2466   end.
     2467   end. // procedure/method
     2468   function get-doc-code-int64 returns int64
     2469     ( input p-doc-code as character ) :
     2470     define variable v-ind              as integer   no-undo .
     2471     define variable v-num-entries      as integer   no-undo .
     2472     define variable v-doc-code-int64   as int64     no-undo .
     2473     define variable v-canonic-doc-code as character no-undo .
     2474     assign
     2475       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2476       v-canonic-doc-code = p-doc-code
     2477     .
     2478     do v-ind = 1 to v-num-entries
     2479     :
     2480       assign
     2481         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2482       .
     2483     end.
     2484     assign
     2485       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2486     .
     2487     return v-doc-code-int64 .
     2488   end. // function/method
     2489   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2490   procedure cur-time :
     2491      define output parameter p-today as date      no-undo .
     2492      define output parameter p-time  as integer   no-undo .
     2493     do
     2494     on error undo, return error
     2495     :
     2496       define variable v-date1 as date      no-undo .
     2497       define variable v-date2 as date      no-undo .
     2498       define variable v-time  as integer   no-undo .
     2499       assign
     2500         v-date1 = today
     2501         v-time  = time
     2502         v-date2 = today
     2503       .
     2504       if v-date1 <> v-date2
     2505       then do:
     2506         assign
     2507           v-date1 = today
     2508           v-time  = v-time
     2509         .
     2510       end.
     2511       assign
     2512         p-today = v-date1
     2513         p-time  = v-time
     2514       .
     2515     end.
     2516   end.
     2517   function cur-time-date returns character
     2518   :
     2519     return string(today, '99/99/9999':U) .
     2520   end.
     2521   function cur-time-mjd returns decimal
     2522   :
     2523     define variable v-date as date      no-undo .
     2524     define variable v-time as integer   no-undo .
     2525     run cur-time in this-procedure
     2526       (output v-date
     2527       ,output v-time
     2528       ) .
     2529     return integer(v-date) - 2400002 + (v-time / 86400) .
     2530   end.
     2531   function cur-time-get-ending-index returns integer
     2532   (input p-number as integer
     2533   )
     2534   :
     2535     if p-number < 0
     2536     or p-number = ?
     2537     then do:
     2538       return 1 .
     2539     end.
     2540     define variable v-rest as integer   no-undo .
     2541     assign
     2542       p-number = p-number modulo 100
     2543     .
     2544     if p-number < 20
     2545     then do:
     2546       assign
     2547         v-rest = p-number
     2548       .
     2549     end.
     2550     else do:
     2551       assign
     2552         v-rest = p-number modulo 10
     2553       .
     2554     end.
     2555     case v-rest :
     2556       when 1
     2557       then do:
     2558         return 2 .
     2559       end.
     2560       when 2 or
     2561       when 3 or
     2562       when 4
     2563       then do:
     2564         return 3 .
     2565       end.
     2566       otherwise do:
     2567         return 1 .
     2568       end.
     2569     end case .
     2570   end.
     2571   procedure cur-time-mjd-to-date :
     2572      define input  parameter i-mjd-diff as decimal no-undo.
     2573      define output parameter o-Date     as date    no-undo.
     2574      define output parameter o-Time     as integer no-undo.
     2575      define variable v-day-number as integer   no-undo .
     2576      if    i-mjd-diff < 0
     2577         or i-mjd-diff = ?
     2578      then do:
     2579         return "?" .
     2580      end.
     2581      assign
     2582         v-day-number = truncate(i-mjd-diff,0).
     2583         o-Date = date(v-day-number + 2400002).
     2584         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2585     .
     2586   end.
     2587   function cur-time-mjd-to-string returns character
     2588   (input p-mjd-diff as decimal
     2589   )
     2590   :
     2591     define variable v-day-number as integer   no-undo .
     2592     define variable v-seconds    as integer   no-undo .
     2593     define variable v-hour       as integer   no-undo .
     2594     define variable v-min        as integer   no-undo .
     2595     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2596     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2597     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2598     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2599     if p-mjd-diff < 0
     2600     or p-mjd-diff = ?
     2601     then do:
     2602       return "?" .
     2603     end.
     2604     assign
     2605       v-day-number = integer(truncate(p-mjd-diff,0))
     2606       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2607     .
     2608     if v-seconds > 86400
     2609     then do:
     2610       assign
     2611         v-seconds = 86400 - 1
     2612       .
     2613     end.
     2614     if v-seconds < 0
     2615     then do:
     2616       assign
     2617         v-seconds = 0
     2618       .
     2619     end.
     2620     assign
     2621       v-hour = truncate(v-seconds / 3600, 0)
     2622     .
     2623     assign
     2624       v-seconds = v-seconds modulo 3600
     2625     .
     2626     assign
     2627       v-min = truncate(v-seconds / 60, 0)
     2628     .
     2629     assign
     2630       v-seconds = v-seconds modulo 60
     2631     .
     2632     return
     2633         (if v-day-number <> 0
     2634           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2635           else ""
     2636         )
     2637       + (if v-day-number <> 0 or v-hour <> 0
     2638           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2639           else ""
     2640         )
     2641       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2642           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2643           else ""
     2644         )
     2645       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2646       .
     2647   end.
     2648   function cur-time-string returns character
     2649   :
     2650     define variable v-date as date      no-undo .
     2651     define variable v-time as integer   no-undo .
     2652     run cur-time in this-procedure
     2653       (output v-date
     2654       ,output v-time
     2655       ) .
     2656     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2657   end.
     2658   function cur-time-string-sec returns character
     2659   :
     2660     define variable v-date as date      no-undo .
     2661     define variable v-time as integer   no-undo .
     2662     run cur-time in this-procedure
     2663       (output v-date
     2664       ,output v-time
     2665       ) .
     2666     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2667   end.
     2668   function cur-time-custom  returns character
     2669   (input p-prefix as character
     2670   ,input p-date-format as character
     2671   ,input p-delimiter as character
     2672   ,input p-time-format as character
     2673   ,input p-suffix as character
     2674   )
     2675   :
     2676     define variable v-date as date      no-undo .
     2677     define variable v-time as integer   no-undo .
     2678     run cur-time in this-procedure
     2679       (output v-date
     2680       ,output v-time
     2681       ) .
     2682     return
     2683       p-prefix
     2684       + string(v-date, p-date-format)
     2685       + p-delimiter
     2686       + string(v-time, p-time-format)
     2687       + p-suffix
     2688       .
     2689   end.
     2690   function cur-time-print  returns character
     2691   :
     2692     define variable v-date as date      no-undo .
     2693     define variable v-time as integer   no-undo .
     2694     run cur-time in this-procedure
     2695       (output v-date
     2696       ,output v-time
     2697       ) .
     2698     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2699   end.
     2700   function cur-time-datetime returns datetime
     2701   :
     2702     define variable v-char as character no-undo .
     2703     define variable v-datetime as datetime no-undo .
     2704     v-char = cur-time-string().
     2705     v-datetime = datetime(v-char).
     2706     return  v-datetime.
     2707   end.
     2708   function cur-time-string-msec returns character
     2709   :
     2710     define variable v-date as datetime  no-undo .
     2711     v-date = now.
     2712     return string(v-date) .
     2713   end.
