     2144   define input parameter p-income-trn-doc-code    as character                no-undo.
     2145   define output parameter p-rsrv-qnty             like doc-line.doc-qnty      no-undo.
     2146       define variable v-parts-rsrv-qnty       as decimal      no-undo.
