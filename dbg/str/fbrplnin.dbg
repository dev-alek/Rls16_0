     1034                                       or buf_trn-doc.doc-type = 'возврат':U
     1035                                       or buf_trn-doc.doc-type = 'инв':U
     1036                                       then buf_parts.fact-qnty
     1037                                       else - buf_parts.fact-qnty
     1038                                      )
     1039               .
     1040               assign
     1041                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1042                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1043                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1044                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1045                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
