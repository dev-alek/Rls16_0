     1270           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1271           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1272                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1273           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1274                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1275           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1276           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1277           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1278         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1279         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1280         if transport-base-loc = ? then transport-base-loc = 0.
     1281         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1282         if other-base-loc     = ? then other-base-loc     = 0.
     1283         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1284         assign
     1285           transport-cli-loc      = 0
     1286           other-cli-loc          = 0
     1287           road-tax-cli-loc       = ?
     1288           vat-cli-loc            = ?
     1289           slt-cli-loc            = ?
     1290           price-cli-with-tax-loc = ?.
     1291      end.
     1292   ASSIGN
     1293             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1294       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1295   .
     1296             assign
     1297               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1298               v-vat-pc              = vat-pc-loc
     1299               v-slt-pc              = slt-pc-loc
     1300               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1301               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1302               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1303               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1304               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1305               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1306               v-road-tax-base       =  0
     1307               v-road-tax-rubl       =  0
     1308               v-excise-base         =  0
     1309               v-excise-rubl         =  0
     1310               v-transport-base      =  0
     1311               v-transport-rubl      =  0
     1312               v-other-base          =  0
     1313               v-other-rubl          =  0
     1314             .
     1315       end.
     1316     end.
     1317   end procedure.
     1318   procedure fbrrep-fill-qnty-and-prices :
     1319   do
     1320   on error undo, return error
     1321   :
     1322   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1323       define variable v-gds-code  as integer       no-undo.
     1324       define variable v-gds-name  as character     no-undo.
     1325       define variable v-sign      as decimal       no-undo.
     1326       define buffer buf_fbr-line          for ub.fbr-line.
     1327       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1328       for each buf_fbr-line no-lock
     1329          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1330       on error undo, return error
     1331       :
     1332           find first buf_temp_fbrrep-goods
     1333                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     1334                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     1335                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     1336           use-index ar
     1337           no-error.
     1338           if not available buf_temp_fbrrep-goods
     1339           then do:
     1340               create buf_temp_fbrrep-goods.
     1341   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1343     (input  buf_fbr-line.artic
     1344     ,input  buf_fbr-line.prod-type
     1345     ,input  buf_fbr-line.prod-code
     1346     ,output v-gds-code
     1347     )  .
     1348   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1350     (input  buf_fbr-line.artic
     1351     ,input  buf_fbr-line.prod-type
     1352     ,input  buf_fbr-line.prod-code
     1353     ,output v-gds-name
     1354     )  .
     1355   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1357     (input  buf_fbr-line.artic
     1358     ,input  buf_fbr-line.prod-type
     1359     ,input  buf_fbr-line.prod-code
     1360     ,input  'gds-goods=request':u
     1361     ,output buf_temp_fbrrep-goods.is-not-office
     1362     )  .
     1363               assign
     1364                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     1365                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     1366                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     1367                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     1368                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     1369                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     1370                   buf_temp_fbrrep-goods.fact-qnty            = 0
     1371                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1372                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     1373                   buf_temp_fbrrep-goods.income-qnty          = 0
     1374                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1375                   buf_temp_fbrrep-goods.cost-rubl            = 0
     1376                   buf_temp_fbrrep-goods.cost-base            = 0
     1377                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1378                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     1379                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1380                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     1381                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1382                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1383                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     1384                   buf_temp_fbrrep-goods.deleted              = no
     1385               .
     1386   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1388     (input  v-gds-code
     1389     ,output buf_temp_fbrrep-goods.unit-base
     1390     )  .
     1391           end.
     1392           case buf_fbr-line.trn-type
     1393           :
     1394               when 'при':U
     1395               then do:
     1396                   assign
     1397                       v-sign                                  = 1
     1398                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     1399                   .
     1400                   if buf_fbr-line.rsrv-qnty <> ?
     1401                   then do:
     1402                       assign
     1403                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1404                       .
     1405                   end.
     1406               end.
     1407               when 'спи':U
     1408               then do:
     1409                   assign
     1410                       v-sign                                  = -1
     1411                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     1412                   .
     1413                   if buf_fbr-line.rsrv-qnty <> ?
     1414                   then do:
     1415                       assign
     1416                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1417                       .
     1418                   end.
     1419               end.
     1420           end case.
     1421           assign
     1422               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     1423               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     1424               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     1425               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     1426           .
     1427       end.
     1428       run test-temp-tables in this-procedure .
     1429   end.
     1430   end procedure.
     1431   procedure fbrrep-fill-for-fbr-actp :
     1432   do
     1433   on error undo, return error
     1434   :
     1435   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     1436       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1437       define buffer buf_fbr-line          for ub.fbr-line.
     1438       run fbrrep-fill-qnty-and-prices in this-procedure (
     1439           input p-fbr-doc-doc-code
     1440       ).
     1441       for each buf_temp_fbrrep-goods
     1442       :
     1443           assign
     1444               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1445               buf_temp_fbrrep-goods.sum-cost-base     = 0
     1446               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1447               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1448               buf_temp_fbrrep-goods.cost-rubl     = 0
     1449               buf_temp_fbrrep-goods.cost-base     = 0
     1450               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1451               buf_temp_fbrrep-goods.vat-cost-base = 0
     1452           .
     1453           if buf_temp_fbrrep-goods.income-qnty = 0
     1454           or buf_temp_fbrrep-goods.write-off-qnty = 0
     1455           then do:
     1456               assign
     1457                   buf_temp_fbrrep-goods.deleted   = yes
     1458                   buf_temp_fbrrep-goods.fact-qnty = 0
     1459               .
     1460           end.
     1461           else do:
     1462               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     1463               then do:
     1464                   assign
     1465                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1466                   .
     1467                   for each buf_fbr-line no-lock
     1468                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1469                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1470                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1471                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1472                        and buf_fbr-line.trn-type  = 'при':U
     1473                   :
     1474                       assign
     1475                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1476                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1477                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1478                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1479                       .
     1480                   end.
     1481                   assign
     1482                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1483                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1484                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1485                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1486                   .
     1487               end.
     1488               else do:
     1489                   assign
     1490                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1491                   .
     1492                   for each buf_fbr-line no-lock
     1493                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1494                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     1495                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1496                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1497                        and buf_fbr-line.trn-type  = 'спи':U
     1498                   :
     1499                       assign
     1500                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     1501                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     1502                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     1503                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     1504                       .
     1505                   end.
     1506                   assign
     1507                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     1508                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     1509                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     1510                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     1511                   .
     1512               end.
     1513           end.
     1514       end.
     1515       for each buf_temp_fbrrep-goods
     1516          where buf_temp_fbrrep-goods.deleted = yes
     1517       on error undo, return error
     1518       :
     1519           delete buf_temp_fbrrep-goods.
     1520       end.
     1521       run test-temp-tables in this-procedure .
     1522   end.
     1523   end procedure.
     1524   procedure fbrrep-fill-for-op-del :
     1525   do
     1526   on error undo, return error
     1527   :
     1528   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1529   define input parameter p-db-remote          as logical          no-undo.
     1530       define variable v-serv-code as character    no-undo.
     1531       define variable v-in-code   as character    no-undo.
     1532       define variable v-out-code  as character    no-undo.
     1533       define variable v-trn-qnty  as decimal       no-undo.
     1534       define variable v-sign      as decimal       no-undo.
     1535       define variable v-qnty      as decimal       no-undo.
     1536       define buffer buf_fbr-doc           for ub.fbr-doc.
     1537       define buffer buf_fbr-line          for ub.fbr-line.
     1538       define buffer buf_goods             for ub.goods .
     1539       define buffer buf_doc-line          for ub.doc-line .
     1540       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     1541       run fbrrep-fill-qnty-and-prices in this-procedure (
     1542           input p-fbr-doc-doc-code
     1543       ).
     1544       for each buf_temp_fbrrep-goods
     1545       on error undo, return error
     1546       :
     1547           if buf_temp_fbrrep-goods.income-qnty <> 0
     1548           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     1549           then do:
     1550               assign
     1551                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     1552               .
     1553               if v-qnty = 0
     1554               then do:
     1555                   find first buf_fbr-line no-lock
     1556                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1557                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     1558                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     1559                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     1560                          and buf_fbr-line.fact-qnty   <> 0
     1561                   no-error.
     1562                   if available buf_fbr-line
     1563                   then do:
     1564                       assign
     1565                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     1566                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     1567                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     1568                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     1569                       .
     1570                   end.
     1571                   else do:
     1572                       assign
     1573                           buf_temp_fbrrep-goods.cost-rubl     = 0
     1574                           buf_temp_fbrrep-goods.cost-base     = 0
     1575                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1576                           buf_temp_fbrrep-goods.vat-cost-base = 0
     1577                       .
     1578                   end.
     1579               end.
     1580               else do:
     1581                   assign
     1582                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     1583                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     1584                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     1585                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     1586                   .
     1587               end.
     1588           end.
     1589           else do:
     1590               assign
     1591                   buf_temp_fbrrep-goods.cost-rubl     = 0
     1592                   buf_temp_fbrrep-goods.cost-base     = 0
     1593                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     1594                   buf_temp_fbrrep-goods.vat-cost-base = 0
     1595               .
     1596           end.
     1597       end.
     1598       for each buf_temp_fbrrep-goods
     1599       :
     1600           if buf_temp_fbrrep-goods.is-waste = yes
     1601           then do:
     1602               assign
     1603                   buf_temp_fbrrep-goods.deleted = yes
     1604               .
     1605           end.
     1606           else do:
     1607               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     1608               and buf_temp_fbrrep-goods.income-qnty <> 0
     1609               then do:
     1610                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     1611                   then do:
     1612                       assign
     1613                           buf_temp_fbrrep-goods.deleted = yes
     1614                       .
     1615                   end.
     1616                   else do:
     1617                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     1618                       then do:
     1619                           assign
     1620                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     1621                               buf_temp_fbrrep-goods.income-qnty       = 0
     1622                           .
     1623                       end.
     1624                       else do:
     1625                           assign
     1626                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     1627                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     1628                           .
     1629                       end.
     1630                   end.
     1631               end.
     1632           end.
     1633       end.
     1634       for each buf_temp_fbrrep-goods
     1635          where buf_temp_fbrrep-goods.deleted = yes
     1636       on error undo, return error
     1637       :
     1638           delete buf_temp_fbrrep-goods.
     1639       end.
     1640       run test-temp-tables in this-procedure .
     1641       find first buf_fbr-doc no-lock
     1642            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     1643       .
     1644       assign
     1645           v-out-code = p-fbr-doc-doc-code
     1646       .
     1647       run doc-code in this-procedure (
     1648             input  "pair"
     1649           , input  buf_fbr-doc.obj-type
     1650           , input  buf_fbr-doc.obj-code
     1651           , input  v-out-code
     1652           , output v-in-code
     1653       ) no-error.
     1654       if error-status:error
     1655       then do:
     1656           message
     1657                    vss-workfile vss-revision vss-description
     1658               skip "Ошибка вычисления номера приходной накладной."
     1659               skip return-value
     1660               skip trim(error-status :get-message(1))
     1661                    trim(error-status :get-message(2))
     1662                    trim(error-status :get-message(3))
     1663           view-as alert-box error.
     1664           undo, return error .
     1665       end.
     1666       run doc-code in this-procedure (
     1667             input  "trio"
     1668           , input  buf_fbr-doc.obj-type
     1669           , input  buf_fbr-doc.obj-code
     1670           , input  v-in-code
     1671           , output v-serv-code
     1672       ) no-error.
     1673       if error-status:error
     1674       then do:
     1675           message
     1676                    vss-workfile vss-revision vss-description
     1677               skip "Ошибка вычисления номера накладной расхода."
     1678               skip return-value
     1679               skip trim(error-status :get-message(1))
     1680                    trim(error-status :get-message(2))
     1681                    trim(error-status :get-message(3))
     1682           view-as alert-box error.
     1683           undo, return error .
     1684       end.
     1685       for each buf_temp_fbrrep-goods
     1686       on error undo, return error
     1687       :
     1688           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     1689           then do:
     1690               find first buf_doc-line no-lock
     1691                    where buf_doc-line.doc-code  = v-in-code
     1692                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1693                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1694                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1695               no-error.
     1696               if available buf_doc-line
     1697               then do:
     1698                   assign
     1699                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     1700                   .
     1701               end.
     1702               else do:
     1703                   assign
     1704                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     1705                   .
     1706               end.
     1707           end.
     1708           else do:
     1709               if buf_temp_fbrrep-goods.is-not-office = no
     1710               then do:
     1711                   find first buf_doc-line no-lock
     1712                        where buf_doc-line.doc-code  = v-serv-code
     1713                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1714                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1715                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1716                   no-error.
     1717               end.
     1718               else do:
     1719                   find first buf_doc-line no-lock
     1720                        where buf_doc-line.doc-code  = v-out-code
     1721                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     1722                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     1723                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     1724                   no-error.
     1725               end.
     1726               if available buf_doc-line
     1727               then do:
     1728                   assign
     1729                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     1730                   .
     1731               end.
     1732               else do:
     1733                   assign
     1734                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     1735                   .
     1736               end.
     1737           end.
     1738           if available buf_doc-line
     1739           then do:
     1740               define variable v-void              as decimal       no-undo.
     1741               define variable v-fact-qnty         as decimal       no-undo.
     1742               define variable v-sum-base          as decimal       no-undo.
     1743               define variable v-sum-rubl          as decimal       no-undo.
     1744               define variable v-vat-base          as decimal       no-undo.
     1745               define variable v-vat-rubl          as decimal       no-undo.
     1746               define variable v-slt-base          as decimal       no-undo.
     1747               define variable v-slt-rubl          as decimal       no-undo.
     1748               define variable v-road-tax-base     as decimal       no-undo.
     1749               define variable v-road-tax-rubl     as decimal       no-undo.
     1750               define variable v-transport-base    as decimal       no-undo.
     1751               define variable v-transport-rubl    as decimal       no-undo.
     1752               define variable v-other-base        as decimal       no-undo.
     1753               define variable v-other-rubl        as decimal       no-undo.
     1754               define variable v-excise-base       as decimal       no-undo.
     1755               define variable v-excise-rubl       as decimal       no-undo.
     1756               run r-cost in this-procedure (
     1757                     input buf_doc-line.doc-code
     1758                   , input buf_doc-line.artic
     1759                   , input buf_doc-line.prod-type
     1760                   , input buf_doc-line.prod-code
     1761                   , output v-fact-qnty
     1762                   , output v-void
     1763                   , output v-void
     1764                   , output v-sum-base
     1765                   , output v-sum-rubl
     1766                   , output v-vat-base
     1767                   , output v-vat-rubl
     1768                   , output v-slt-base
     1769                   , output v-slt-rubl
     1770                   , output v-road-tax-base
     1771                   , output v-road-tax-rubl
     1772                   , output v-transport-base
     1773                   , output v-transport-rubl
     1774                   , output v-other-base
     1775                   , output v-other-rubl
     1776                   , output v-excise-base
     1777                   , output v-excise-rubl
     1778               ).
     1779               assign
     1780                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     1781               .
     1782               assign
     1783                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     1784                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     1785                   v-sum-rubl = v-sum-rubl   * v-sign
     1786                   v-sum-base = v-sum-base   * v-sign
     1787                   v-vat-rubl = v-vat-rubl   * v-sign
     1788                   v-vat-base = v-vat-base   * v-sign
     1789                   v-fact-qnty = v-fact-qnty * v-sign
     1790               .
     1791               output to "fbrrep.txt" append .
     1792               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     1793               output close.
     1794               assign
     1795                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     1796                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     1797                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     1798                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     1799               .
     1800               if buf_temp_fbrrep-goods.fact-qnty          = 0
     1801               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     1802               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     1803               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     1804               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     1805               then do:
     1806                   assign
     1807                       buf_temp_fbrrep-goods.deleted = yes
     1808                   .
     1809               end.
     1810           end.
     1811       end.
     1812       for each buf_temp_fbrrep-goods
     1813          where buf_temp_fbrrep-goods.deleted = yes
     1814       on error undo, return error
     1815       :
     1816           delete buf_temp_fbrrep-goods.
     1817       end.
     1818       run test-temp-tables in this-procedure .
     1819   end.
     1820   end procedure.
     1821   procedure test-temp-tables :
     1822   do
     1823   on error undo, return error
     1824   :
     1825       define variable v-str   as character     no-undo.
     1826       assign
     1827           v-str = ""
     1828       .
     1829       for each temp_fbrrep-goods
     1830       :
     1831           assign
     1832               v-str = v-str
     1833                   + chr(10) + temp_fbrrep-goods.artic
     1834                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     1835                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     1836                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     1837                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     1838                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     1839                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     1840                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     1841           .
     1842       end.
     1843       output to "fbrrep.txt" append .
     1844       put unformatted skip(2) v-str.
     1845       output close.
     1846   end.
     1847   end procedure.
     1848   procedure fbrrep-test-fbrdoc-for-fact :
     1849   do
     1850   on error undo, return error
     1851   :
     1852   define output parameter p-have-error        as logical      no-undo.
     1853       define buffer buf_fbr-line          for ub.fbr-line.
     1854       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1855       for each buf_temp_fbrrep-goods
     1856       on error undo, return error
     1857       :
     1858       end.
     1859   end.
     1860   end procedure.
     1861   procedure fbrrep-fill-qnty-and-prices-gds :
     1862   do
     1863   on error undo, return error
     1864   :
     1865   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1866   define input parameter p-gds-code           as integer      no-undo.
     1867       define variable v-sign      as decimal       no-undo.
     1868       define buffer buf_fbr-line          for ub.fbr-line.
     1869       define buffer buf_goods             for ub.goods.
     1870       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     1871       find first buf_goods no-lock
     1872            where buf_goods.gds-code = p-gds-code
     1873       .
     1874       find first buf_temp_fbrrep-goods
     1875            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     1876              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     1877              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     1878       use-index ar
     1879       no-error.
     1880       if available buf_temp_fbrrep-goods
     1881       then do:
     1882           delete buf_temp_fbrrep-goods.
     1883       end.
     1884       create buf_temp_fbrrep-goods.
     1885   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1887     (input  buf_goods.artic
     1888     ,input  buf_goods.prod-type
     1889     ,input  buf_goods.prod-code
     1890     ,input  'gds-goods=request':u
     1891     ,output buf_temp_fbrrep-goods.is-not-office
     1892     )  .
     1893       assign
     1894           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     1895           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     1896           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     1897           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     1898           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     1899           buf_temp_fbrrep-goods.is-waste             = no
     1900           buf_temp_fbrrep-goods.fact-qnty            = 0
     1901           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     1902           buf_temp_fbrrep-goods.write-off-qnty       = 0
     1903           buf_temp_fbrrep-goods.income-qnty          = 0
     1904           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     1905           buf_temp_fbrrep-goods.cost-rubl            = 0
     1906           buf_temp_fbrrep-goods.cost-base            = 0
     1907           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     1908           buf_temp_fbrrep-goods.sum-cost-base        = 0
     1909           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     1910           buf_temp_fbrrep-goods.vat-cost-base        = 0
     1911           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     1912           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     1913           buf_temp_fbrrep-goods.price-sale           = 0
     1914           buf_temp_fbrrep-goods.deleted              = no
     1915       .
     1916   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1918     (input  p-gds-code
     1919     ,output buf_temp_fbrrep-goods.unit-base
     1920     )  .
     1921       for each buf_fbr-line no-lock
     1922          where buf_fbr-line.prod-type = buf_goods.prod-type
     1923            and buf_fbr-line.prod-code = buf_goods.prod-code
     1924            and buf_fbr-line.artic     = buf_goods.artic
     1925            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     1926       on error undo, return error
     1927       :
     1928           case buf_fbr-line.trn-type
     1929           :
     1930               when 'при':U
     1931               then do:
     1932                   assign
     1933                       v-sign                                          = 1
     1934                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     1935                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     1936                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     1937                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     1938                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     1939                   .
     1940                   if buf_fbr-line.rsrv-qnty <> ?
     1941                   then do:
     1942                       assign
     1943                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     1944                       .
     1945                   end.
     1946               end.
     1947               when 'спи':U
     1948               then do:
     1949                   assign
     1950                       v-sign                                  = -1
     1951                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     1952                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     1953                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     1954                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     1955                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     1956                   .
     1957                   if buf_fbr-line.rsrv-qnty <> ?
     1958                   then do:
     1959                       assign
     1960                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     1961                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     1962                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     1963                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     1964                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     1965                       .
     1966                   end.
     1967               end.
     1968           end case.
     1969           assign
     1970               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
