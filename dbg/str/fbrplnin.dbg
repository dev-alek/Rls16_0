     2165     , buf_gds-dtl
     2166     , buf_trn-doc
     2167     , buf_doc-line
     2168     , buf_parts
     2169   on error undo, return error
     2170   :
     2171   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2173     (output v-r-b-is-base
     2174     )  .
     2175       find first buf_goods no-lock
     2176            where recid( buf_goods ) = p-goods-recid
     2177       .
     2178       find first buf_gds-prt no-lock
     2179            where buf_gds-prt.upper-code = buf_goods.prt-root
     2180       .
     2181       find first buf_doc-line no-lock
     2182            where recid( buf_doc-line ) = p-doc-line-recid
     2183       .
     2184       find first buf_trn-doc exclusive-lock
     2185            where buf_trn-doc.doc-code = buf_doc-line.doc-code
     2186       .
     2187       assign
     2188           buf_trn-doc.print-rubl = ( if v-r-b-is-base = yes then no else yes )
     2189       .
     2190   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     2191     ( input buf_trn-doc.obj-code
     2192      ,input buf_trn-doc.obj-type
     2193      ,input buf_trn-doc.doc-code
     2194      ,input buf_goods.artic
     2195      ,input buf_goods.prod-code
     2196      ,input buf_goods.prod-type
     2197      ,input buf_gds-prt.node-code
     2198      ,input yes
     2199     ) no-error .
     2200       if error-status:error
     2201       then do:
     2202           message
     2203               "Ошибка при создании признака."
     2204               skip return-value
     2205           view-as alert-box error.
     2206       end.
     2207       find first buf_gds-dtl exclusive-lock
     2208            where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     2209              and buf_gds-dtl.artic     = buf_goods.artic
     2210              and buf_gds-dtl.prod-type = buf_goods.prod-type
     2211              and buf_gds-dtl.prod-code = buf_goods.prod-code
     2212              and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     2213       .
     2214       if p-set-price = yes
     2215       then do:
     2216           if v-r-b-is-base = yes
     2217           then do:
     2218               assign
     2219                   buf_gds-dtl.price-base = p-price
     2220                   buf_gds-dtl.price-rubl = p-price * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     2221               .
     2222           end.
     2223           else do:
     2224               assign
     2225                   buf_gds-dtl.price-rubl = p-price
     2226                   buf_gds-dtl.price-base = p-price / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     2227               .
     2228           end.
     2229       end.
     2230       else do:
     2231   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2232   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     2233     ( input recid(buf_gds-dtl)
     2234     , input no
     2235     , input ?
     2236     ) no-error.
     2237           if error-status:error
     2238           then do:
     2239               message
     2240                   "Ошибка при назначении цены признака."
     2241                   skip return-value
     2242               view-as alert-box error.
     2243           end.
     2244           if v-r-b-is-base = yes
     2245           then do:
     2246               assign
     2247                   buf_gds-dtl.price-rubl = buf_gds-dtl.price-base * buf_trn-doc.base-rate / buf_trn-doc.base-scale
     2248                   buf_gds-dtl.price-base = buf_gds-dtl.price-base
     2249               .
     2250           end.
     2251           else do:
     2252               assign
     2253                   buf_gds-dtl.price-rubl = buf_gds-dtl.price-rubl
     2254                   buf_gds-dtl.price-base = buf_gds-dtl.price-rubl / buf_trn-doc.base-rate * buf_trn-doc.base-scale
     2255               .
     2256           end.
     2257       end.
     2258       assign
     2259           buf_trn-doc.status_ = 'накл':U
     2260           buf_trn-doc.flag_   = no
     2261       .
     2262       assign
     2263           buf_gds-dtl.ov  = yes
     2264           v-cost-base     = buf_doc-line.price-base
     2265           v-cost-rubl     = buf_doc-line.price-rubl
     2266           p-rsrv-qnty     = round( p-required-qnty, 3 )
     2267       .
     2268       if p-rsrv-by-parts = yes
     2269       then do:
     2270           assign
     2271               v-parts-found           = no
     2272               v-sum-parts-rsrv-qnty   = 0
     2273           .
     2274           if p-income-trn-doc-code <> ""
     2275           then do:
     2276               for each buf_parts no-lock
     2277                  where buf_parts.obj-type  = buf_doc-line.obj-type
     2278                    and buf_parts.obj-code  = buf_doc-line.obj-code
     2279                    and buf_parts.prod-type = buf_doc-line.prod-type
     2280                    and buf_parts.prod-code = buf_doc-line.prod-code
     2281                    and buf_parts.artic     = buf_doc-line.artic
     2282                    and buf_parts.in-code   = p-income-trn-doc-code
     2283                    and buf_parts.out-code  = p-income-trn-doc-code
     2284               on error undo, return error return-value
     2285               :
     2286                   assign
     2287                       v-parts-found     = yes
     2288                       v-parts-parameter = 'reserv':U
     2289                                   + ",":U + 'no-message':U
     2290                                   + ",":U + 'rsrv-single-part':U
     2291                                   + ",":U + 'rsrv-in-code':U   + "=":U + str-encode ( buf_parts.in-code  ,  "", ",=":U )
     2292                                   + ",":U + 'rsrv-part-code':U + "=":U + str-encode ( buf_parts.part-code,  "", ",=":U )
     2293                   .
     2294                   assign
     2295                       v-parts-rsrv-qnty = ( if p-rsrv-qnty < buf_parts.fact-qnty then p-rsrv-qnty else buf_parts.fact-qnty )
     2296                   .
     2297                   run trg/rsrv-dtl.p (
     2298                         input p-parent-proc
     2299                       , input v-parts-parameter
     2300                       , buffer buf_gds-dtl
     2301                       , input-output v-parts-rsrv-qnty
     2302                       , input-output v-cost-base
     2303                       , input-output v-cost-rubl
     2304                       , input -1
     2305                       , input ""
     2306                   ) no-error.
     2307                   if error-status:error
     2308                   then do:
     2309                       undo, return error return-value.
     2310                   end.
     2311                   if v-cost-base <= 0
     2312                   or v-cost-rubl <= 0
     2313                   then do:
     2314                       undo, return error substitute("Неправильные цены резервирования:&1&2&3&1БАЗ.ВАЛ.:&4&1Артикул:&5"
     2315                                                     ,chr(10)
     2316                                                     ,"РУБЛИ:   "
     2317                                                     ,v-cost-rubl
     2318                                                     ,v-cost-base
     2319                                                     ,buf_doc-line.artic).
     2320                       .
     2321                   end.
     2322                   assign
     2323                       v-sum-parts-rsrv-qnty = v-sum-parts-rsrv-qnty + v-parts-rsrv-qnty
     2324                       p-rsrv-qnty           = p-rsrv-qnty           - v-parts-rsrv-qnty
     2325                   .
     2326               end.
     2327           end.
     2328           if p-rsrv-qnty > 0
     2329           then do:
     2330               run trg/rsrv-dtl.p (
     2331                     input p-parent-proc
     2332                   , input 'reserv':U
     2333                           + ",":U + 'no-message':U
     2334                           + ",":U + 'negative-check':U + '=':U + '1':U
     2335                   , buffer buf_gds-dtl
     2336                   , input-output p-rsrv-qnty
     2337                   , input-output v-cost-base
     2338                   , input-output v-cost-rubl
     2339                   , input -1
     2340                   , input ""
     2341               ) no-error.
