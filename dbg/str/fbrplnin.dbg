     1048                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1049                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1050                 v-excise-base         =   0
     1051                 v-excise-rubl         =   0
     1052                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1053                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1054                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1055                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1056               .
     1057           end.
