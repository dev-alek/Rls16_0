        1   block-level on error undo, throw.
        2   define input parameter parparentproc        as widget-handle    no-undo.
        3   define input parameter p-fbr-doc-code       as character        no-undo.
        4   define input parameter p-fbrhist-handle     as widget-handle    no-undo.
        5   define input parameter p-kitchen-obj-code   as integer          no-undo.
        6   define input parameter p-restaurant-code    as integer          no-undo.
        7   define input parameter p-fbr-pln-code       as character        no-undo.
        8   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile: fbrplnin.p $":U .
       12   define variable vss-archive     as character no-undo initial "$Archive: str/fbrplnin.p $":U .
       13   define variable vss-description as character no-undo initial "Создание документов внутреннего перемещения для плана-меню.":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define new global shared variable g#lib-trn  as handle no-undo .
       75   define new global shared variable g#lib-trn2 as handle no-undo .
       76   define new global shared variable g#lib-trn3 as handle no-undo .
       77   define new global shared variable g#lib-trn4 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       80   procedure partslib-clear-temp-parts :
       81     define buffer buf_temp-parts for temp-parts .
       82     do
       83     on error undo, return error
       84     :
       85       for each buf_temp-parts
       86       on error undo, return error
       87       :
       88         delete buf_temp-parts .
       89       end.
       90     end.
       91   end procedure.
       92   procedure partslib-create-temp-parts :
       93     define parameter buffer buf_parts       for ub.parts .
       94     define parameter buffer buf_temp-parts  for temp-parts .
       95     define input  parameter p-goods-twounit as logical   no-undo .
       96     define variable v-base-part-code as character no-undo .
       97     do
       98     on error undo, return error
       99     :
      100       if p-goods-twounit = true
      101       then do:
      102         assign
      103           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      104         .
      105       end.
      106       else do:
      107         assign
      108           v-base-part-code = buf_parts.part-code
      109         .
      110       end.
      111       find first buf_temp-parts exclusive-lock
      112         where buf_temp-parts.obj-type  = buf_parts.obj-type
      113           and buf_temp-parts.obj-code  = buf_parts.obj-code
      114           and buf_temp-parts.artic     = buf_parts.artic
      115           and buf_temp-parts.prod-type = buf_parts.prod-type
      116           and buf_temp-parts.prod-code = buf_parts.prod-code
      117           and buf_temp-parts.in-code   = buf_parts.in-code
      118           and buf_temp-parts.out-code  = 'free-zone':U
      119           and buf_temp-parts.part-code = v-base-part-code
      120         no-error.
      121       if not available buf_temp-parts
      122       then do:
      123         create buf_temp-parts .
      124         buffer-copy buf_parts to buf_temp-parts
      125         assign
      126           buf_temp-parts.out-code  = 'free-zone':U
      127           buf_temp-parts.part-code = v-base-part-code
      128           buf_temp-parts.rsrv-free = yes
      129           buf_temp-parts.status_   = no
      130           buf_temp-parts.qnty      = 0
      131           buf_temp-parts.fact-qnty = 0
      132           buf_temp-parts.real-qnty = 0
      133           buf_temp-parts.cli-qnty  = 0
      134         .
      135       end.
      136     end.
      137   end procedure.
      138   procedure partslib-init-temp-parts :
      139     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      140     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      141     define input parameter p-artic           like ub.parts.artic     no-undo .
      142     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      143     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      144     define buffer buf_parts      for ub.parts .
      145     define buffer buf_temp-parts for temp-parts .
      146     define variable v-goods-twounit    as logical   no-undo .
      147     do
      148     on error undo, return error
      149     :
      150   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      152     (input  p-artic
      153     ,input  p-prod-type
      154     ,input  p-prod-code
      155     ,input  'twounit=request':u
      156     ,output v-goods-twounit
      157     ) no-error .
      158       if error-status :error
      159       then do:
      160         message
      161           vss-workfile vss-revision vss-description skip
      162           vss-include-info0 skip
      163           "Ошибка при определении атрибута товара" skip
      164           "Артикул" p-artic p-prod-type p-prod-code skip
      165           "twounit=request" skip
      166           error-status :get-message(1) skip
      167           return-value skip
      168           view-as alert-box error .
      169         undo, return error return-value .
      170       end.
      171       run partslib-clear-temp-parts in this-procedure .
      172       for each buf_parts
      173         where buf_parts.obj-type  = p-obj-type
      174           and buf_parts.obj-code  = p-obj-code
      175           and buf_parts.artic     = p-artic
      176           and buf_parts.prod-type = p-prod-type
      177           and buf_parts.prod-code = p-prod-code
      178           and buf_parts.rsrv-free = yes
      179           and buf_parts.status_   = no
      180           and buf_parts.in-code   <> buf_parts.out-code
      181       on error undo, return error
      182       :
      183         run partslib-create-temp-parts in this-procedure
      184           (buffer buf_parts
      185           ,buffer buf_temp-parts
      186           ,input  v-goods-twounit
      187           ) .
      188         define variable v-parts-qnty          as decimal   no-undo .
      189         define variable v-parts-cli-qnty      as decimal   no-undo .
      190         define variable v-parts-free-qnty     as decimal   no-undo .
      191         define variable v-parts-free-cli-qnty as decimal   no-undo .
      192         if buf_parts.out-code = 'free-zone':U
      193         then do:
      194           assign
      195             v-parts-qnty          = buf_parts.qnty
      196             v-parts-cli-qnty      = buf_parts.cli-qnty
      197             v-parts-free-qnty     = buf_parts.qnty
      198             v-parts-free-cli-qnty = buf_parts.cli-qnty
      199           .
      200         end.
      201         else do:
      202           assign
      203             v-parts-qnty          = abs(buf_parts.qnty)
      204             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      205             v-parts-free-qnty     = 0
      206             v-parts-free-cli-qnty = 0
      207           .
      208         end.
      209         assign
      210           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      211           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      212           buf_temp-parts.real-qnty     = 0
      213           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      214           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      215           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      216         .
      217       end.
      218     end.
      219   end procedure.
      220   procedure partslib-init-temp-parts-by-factord :
      221     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      222     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      223     define input parameter p-artic              like ub.parts.artic     no-undo .
      224     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      225     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      226     define input parameter p-fact-order         as decimal   no-undo .
      227     define input parameter p-include-fact-order as logical   no-undo .
      228     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      229     define buffer buf_gds-obj  for ub.gds-obj .
      230     do
      231     on error undo, return error
      232     :
      233       do transaction
      234       on error undo, return error
      235       :
      236   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      238     (input  p-obj-type
      239     ,input  p-obj-code
      240     ,input  p-artic
      241     ,input  p-prod-type
      242     ,input  p-prod-code
      243     ,buffer buf_gds-obj
      244     ) no-error .
      245         if error-status :error
      246         then do:
      247           message
      248             vss-workfile vss-revision vss-description skip
      249             vss-include-info0 skip
      250             "Невозможно найти товар на объекте" skip
      251             "Объект" p-obj-type p-obj-code skip
      252             "Артикул" p-artic p-prod-type p-prod-code skip
      253             error-status :get-message(1) skip
      254             return-value skip
      255             view-as alert-box error .
      256           undo, return error .
      257         end.
      258         find current buf_gds-obj exclusive-lock .
      259       end.
      260       run partslib-init-temp-parts in this-procedure
      261         (input p-obj-type
      262         ,input p-obj-code
      263         ,input p-artic
      264         ,input p-prod-type
      265         ,input p-prod-code
      266         ) no-error .
      267       if error-status :error
      268       then do:
      269         message
      270           vss-workfile vss-revision vss-description skip
      271           vss-include-info0 skip
      272           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      273           "Объект" p-obj-type p-obj-code skip
      274           "Артикул" p-artic p-prod-type p-prod-code skip
      275           "p-fact-order" p-fact-order skip
      276           view-as alert-box error .
      277         undo, return error .
      278       end.
      279       if p-include-fact-order = true
      280       then do:
      281         assign
      282           p-fact-order = p-fact-order - 0.0000000001
      283         .
      284       end.
      285       define variable v-max-fact-order as character no-undo .
      286       run factord-max-fact-order in this-procedure
      287         (output v-max-fact-order
      288         ) no-error .
      289       if error-status :error
      290       then do:
      291         message
      292           vss-workfile vss-revision vss-description skip
      293           vss-include-info0 skip
      294           "Ошибка при вызове процедуры factord-max-fact-order" skip
      295           "Объект" p-obj-type p-obj-code skip
      296           "Артикул" p-artic p-prod-type p-prod-code skip
      297           "p-fact-order" p-fact-order skip
      298           view-as alert-box error .
      299         undo, return error .
      300       end.
      301       run partslib-update-by-factord in this-procedure
      302         (input p-obj-type
      303         ,input p-obj-code
      304         ,input p-artic
      305         ,input p-prod-type
      306         ,input p-prod-code
      307         ,input p-fact-order
      308         ,input v-max-fact-order
      309         ,input false
      310         ) no-error .
      311       if error-status :error
      312       then do:
      313         message
      314           vss-workfile vss-revision vss-description skip
      315           vss-include-info0 skip
      316           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      317           "Объект" p-obj-type p-obj-code skip
      318           "Артикул" p-artic p-prod-type p-prod-code skip
      319           "p-fact-order" p-fact-order skip
      320           "v-max-fact-order" v-max-fact-order skip
      321           view-as alert-box error .
      322         undo, return error .
      323       end.
      324     end.
      325   end procedure.
      326   procedure partslib-update-by-factord :
      327     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      328     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      329     define input parameter p-artic              like ub.parts.artic     no-undo .
      330     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      331     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      332     define input parameter p-start-fact-order   as decimal   no-undo .
      333     define input parameter p-end-fact-order     as decimal   no-undo .
      334     define input parameter p-lock-gds-obj       as logical   no-undo .
      335     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      336     define buffer buf_gds-obj  for ub.gds-obj .
      337     define buffer buf_doc-line for ub.doc-line .
      338     define variable v-total-parts-qnty as decimal   no-undo .
      339     define variable v-goods-gds-goods  as logical   no-undo .
      340     define variable v-goods-twounit    as logical   no-undo .
      341     do
      342     on error undo, return error
      343     :
      344       if p-start-fact-order > p-end-fact-order
      345       then do:
      346         message
      347           vss-workfile vss-revision vss-description skip
      348           vss-include-info0 skip
      349           "Ошибка задания входных параметров" skip
      350           "Начало интервала превышает конец интервала" skip
      351           "Объект" p-obj-type p-obj-code skip
      352           "Артикул" p-artic p-prod-type p-prod-code skip
      353           "p-start-fact-order" p-start-fact-order skip
      354           "p-end-fact-order"   p-end-fact-order skip
      355           view-as alert-box error .
      356         undo, return error .
      357       end.
      358       if p-lock-gds-obj = true
      359       then do:
      360         do transaction
      361         on error undo, return error
      362         :
      363   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      365     (input  p-obj-type
      366     ,input  p-obj-code
      367     ,input  p-artic
      368     ,input  p-prod-type
      369     ,input  p-prod-code
      370     ,buffer buf_gds-obj
      371     ) no-error .
      372           if error-status :error
      373           then do:
      374             message
      375               vss-workfile vss-revision vss-description skip
      376               vss-include-info0 skip
      377               "Невозможно найти gds-obj" skip
      378               error-status :get-message(1) skip
      379               return-value skip
      380               view-as alert-box error .
      381             undo, return error .
      382           end.
      383           find current buf_gds-obj exclusive-lock .
      384         end.
      385       end.
      386   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      388     (input  p-artic
      389     ,input  p-prod-type
      390     ,input  p-prod-code
      391     ,input  'gds-goods=request':u
      392     ,output v-goods-gds-goods
      393     ) no-error .
      394       if error-status :error
      395       then do:
      396         message
      397           vss-workfile vss-revision vss-description skip
      398           vss-include-info0 skip
      399           "Ошибка при определении атрибута товара" skip
      400           "Артикул" p-artic p-prod-type p-prod-code skip
      401           "gds-goods=request" skip
      402           error-status :get-message(1) skip
      403           return-value skip
      404           view-as alert-box error .
      405         undo, return error return-value .
      406       end.
      407   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      409     (input  p-artic
      410     ,input  p-prod-type
      411     ,input  p-prod-code
      412     ,input  'twounit=request':u
      413     ,output v-goods-twounit
      414     ) no-error .
      415       if error-status :error
      416       then do:
      417         message
      418           vss-workfile vss-revision vss-description skip
      419           vss-include-info0 skip
      420           "Ошибка при определении атрибута товара" skip
      421           "Артикул" p-artic p-prod-type p-prod-code skip
      422           "twounit=request" skip
      423           error-status :get-message(1) skip
      424           return-value skip
      425           view-as alert-box error .
      426         undo, return error return-value .
      427       end.
      428       for each buf_doc-line no-lock
      429         where buf_doc-line.obj-type   = p-obj-type
      430           and buf_doc-line.obj-code   = p-obj-code
      431           and buf_doc-line.artic      = p-artic
      432           and buf_doc-line.prod-type  = p-prod-type
      433           and buf_doc-line.prod-code  = p-prod-code
      434           and buf_doc-line.status_    = 'факт':U
      435           and buf_doc-line.fact-order > p-start-fact-order
      436           and buf_doc-line.fact-order <= p-end-fact-order
      437       on error undo, return error
      438       :
      439         run partslib-process-document in this-procedure
      440           (input  buf_doc-line.doc-code
      441           ,input  p-obj-type
      442           ,input  p-obj-code
      443           ,input  p-artic
      444           ,input  p-prod-type
      445           ,input  p-prod-code
      446           ,input  v-goods-gds-goods
      447           ,input  v-goods-twounit
      448           ,output v-total-parts-qnty
      449           ) no-error .
      450         if error-status :error
      451         then do:
      452           message
      453             vss-workfile vss-revision vss-description skip
      454             vss-include-info0 skip
      455             "Ошибка при вызове процедуры partslib-process-document" skip
      456             "Документ" buf_doc-line.doc-code skip
      457             "Объект" p-obj-type p-obj-code skip
      458             "Артикул" p-artic p-prod-type p-prod-code skip
      459             "p-start-fact-order" p-start-fact-order skip
      460             "p-end-fact-order" p-end-fact-order skip
      461             error-status :get-message(1) skip
      462             return-value skip
      463             view-as alert-box error .
      464           undo, return error return-value .
      465         end.
      466       end.
      467     end.
      468   end procedure.
      469   procedure partslib-process-document :
      470     define input  parameter p-doc-code         as character no-undo .
      471     define input  parameter p-obj-type         as character no-undo .
      472     define input  parameter p-obj-code         as integer   no-undo .
      473     define input  parameter p-artic            as character no-undo .
      474     define input  parameter p-prod-type        as character no-undo .
      475     define input  parameter p-prod-code        as integer   no-undo .
      476     define input  parameter p-goods-gds-goods  as logical   no-undo .
      477     define input  parameter p-goods-twounit    as logical   no-undo .
      478     define output parameter p-total-parts-qnty as decimal   no-undo .
      479     define variable v-parts-sign as integer   no-undo .
      480     define buffer buf_trn-doc    for ub.trn-doc .
      481     define buffer buf_doc-line   for ub.doc-line .
      482     define buffer buf_parts      for ub.parts .
      483     define buffer buf_temp-parts for temp-parts .
      484     do
      485     on error undo, return error return-value
      486     :
      487       find first buf_trn-doc no-lock
      488         where buf_trn-doc.doc-code = p-doc-code
      489         no-error .
      490       if not available buf_trn-doc
      491       then do:
      492         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      493                                      ,p-doc-code
      494                                      ) .
      495       end.
      496       case buf_trn-doc.doc-type
      497       :
      498         when 'при':U or
      499         when 'возврат':U or
      500         when 'инв':U
      501         then do:
      502           assign
      503             v-parts-sign = -1
      504           .
      505         end.
      506         when 'рас':U or
      507         when 'спи':U
      508         then do:
      509           assign
      510             v-parts-sign = 1
      511           .
      512         end.
      513         otherwise do:
      514           undo, return error substitute("Неизвестный тип документа &1"
      515                                       ,buf_trn-doc.doc-type
      516                                       ) .
      517         end.
      518       end.
      519       find first buf_doc-line no-lock
      520         where buf_doc-line.doc-code  = p-doc-code
      521           and buf_doc-line.artic     = p-artic
      522           and buf_doc-line.prod-type = p-prod-type
      523           and buf_doc-line.prod-code = p-prod-code
      524         no-error .
      525       if not available buf_doc-line
      526       then do:
      527         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      528                                      ,p-doc-code
      529                                      ,artic
      530                                      ,prod-type
      531                                      ,prod-code
      532                                      ) .
      533       end.
      534       assign
      535         p-total-parts-qnty = 0
      536       .
      537       if p-goods-gds-goods = true
      538       then do:
      539         for each buf_parts no-lock
      540           where buf_parts.out-code  = p-doc-code
      541             and buf_parts.obj-type  = p-obj-type
      542             and buf_parts.obj-code  = p-obj-code
      543             and buf_parts.artic     = p-artic
      544             and buf_parts.prod-type = p-prod-type
      545             and buf_parts.prod-code = p-prod-code
      546         on error undo, return error
      547         :
      548           run partslib-create-temp-parts in this-procedure
      549             (buffer buf_parts
      550             ,buffer buf_temp-parts
      551             ,input  p-goods-twounit
      552             ) .
      553           assign
      554             p-total-parts-qnty        = p-total-parts-qnty
      555                                       + v-parts-sign * buf_parts.fact-qnty
      556             buf_temp-parts.qnty       = buf_temp-parts.qnty
      557                                       + v-parts-sign * buf_parts.fact-qnty
      558             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      559                                       + v-parts-sign * buf_parts.fact-qnty
      560             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      561                                       + v-parts-sign * buf_parts.cli-qnty
      562           .
      563           if buf_temp-parts.qnty = 0
      564           then do:
      565             delete buf_temp-parts .
      566           end.
      567         end.
      568       end.
      569       else do:
      570         assign
      571           p-total-parts-qnty = p-total-parts-qnty
      572                              + v-parts-sign * buf_doc-line.fact-qnty
      573         .
      574       end.
      575     end.
      576   end procedure.
      577   procedure partslib-init-temp-parts-by-date :
      578     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      579     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      580     define input parameter p-artic           like ub.parts.artic     no-undo .
      581     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      582     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      583     define input parameter p-fact-date       as date      no-undo .
      584     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      585     do
      586     on error undo, return error
      587     :
      588       define variable v-fact-order                as decimal   no-undo .
      589       define variable v-shift-end-fact-order      as decimal   no-undo .
      590       define variable v-day-end-fact-order        as decimal   no-undo .
      591       run factord in this-procedure
      592         (input  p-fact-date
      593         ,input  1
      594         ,input  1
      595         ,input  ?
      596         ,input  0
      597         ,input  false
      598         ,output v-fact-order
      599         ,output v-shift-end-fact-order
      600         ,output v-day-end-fact-order
      601         ) no-error .
      602       if error-status :error
      603       then do:
      604         message
      605           vss-workfile vss-revision vss-description skip
      606           vss-include-info0 skip
      607           "Ошибка при определении момента времени, на который требуется остаток" skip
      608           "Объект" p-obj-type p-obj-code skip
      609           "Артикул" p-artic p-prod-type p-prod-code skip
      610           "Дата" p-fact-date skip
      611           view-as alert-box error .
      612         undo, return error .
      613       end.
      614       run partslib-init-temp-parts-by-factord in this-procedure
      615         (input p-obj-type
      616         ,input p-obj-code
      617         ,input p-artic
      618         ,input p-prod-type
      619         ,input p-prod-code
      620         ,input v-day-end-fact-order
      621         ,input false
      622         ) no-error .
      623       if error-status :error
      624       then do:
      625         message
      626           vss-workfile vss-revision vss-description skip
      627           vss-include-info0 skip
      628           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      629           "Объект" p-obj-type p-obj-code skip
      630           "Артикул" p-artic p-prod-type p-prod-code skip
      631           "Дата" p-fact-date skip
      632           view-as alert-box error .
      633         undo, return error .
      634       end.
      635     end.
      636   end procedure.
      637   procedure partslib-calc-cost :
      638     define output parameter p-fact-qnty      as decimal   no-undo .
      639     define output parameter p-vat-pc         as decimal   no-undo .
      640     define output parameter p-slt-pc         as decimal   no-undo .
      641     define output parameter p-sum-base       as decimal   no-undo .
      642     define output parameter p-sum-rubl       as decimal   no-undo .
      643     define output parameter p-vat-base       as decimal   no-undo .
      644     define output parameter p-vat-rubl       as decimal   no-undo .
      645     define output parameter p-slt-base       as decimal   no-undo .
      646     define output parameter p-slt-rubl       as decimal   no-undo .
      647     define output parameter p-road-tax-base  as decimal   no-undo .
      648     define output parameter p-road-tax-rubl  as decimal   no-undo .
      649     define output parameter p-transport-base as decimal   no-undo .
      650     define output parameter p-transport-rubl as decimal   no-undo .
      651     define output parameter p-other-base     as decimal   no-undo .
      652     define output parameter p-other-rubl     as decimal   no-undo .
      653     define output parameter p-excise-base    as decimal   no-undo .
      654     define output parameter p-excise-rubl    as decimal   no-undo .
      655     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      656     do
      657     on error undo, return error return-value
      658     :
      659       define buffer buf_temp-parts for temp-parts .
      660       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      661       define buffer   in-vatp-parts    for ub.parts   .
      662       define buffer   in-vatp-doc      for ub.trn-doc .
      663       define buffer   in-vatp-goods    for ub.goods   .
      664       define buffer   in-vatp-sysconf  for ub.sysconf .
      665       define buffer   in-vatp_doc-attr for ub.doc-attr.
      666       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      667       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      668       define variable varinvprb                  as   character              no-undo.
      669       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      670       define variable cli-base-rate              as   decimal                no-undo.
      671       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      672       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      673       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      674       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      675       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      676       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      677       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      678       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      679       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      680       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      681       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      682       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      683       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      684       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      685       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      686       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      687       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      688       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      689       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      690       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      691       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      692       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      693       define variable varinvatp-envd             as   character              no-undo.
      694       define variable varinvatp-type             as   character              no-undo.
      695       for each buf_temp-parts
      696       on error undo, return error
      697       :
      698   assign
      699     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      700     price-base-with-tax-loc = buf_temp-parts.price-base
      701   .
      702   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      703   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      704     (output varinvprb
      705     )  .
      706     if buf_temp-parts.out-code = 'free-zone':U     or
      707        buf_temp-parts.out-code = 'out-zone':U   or
      708        buf_temp-parts.doc-type = 'акт':U then do:
      709       assign
      710         in-vatp-have-vat-slt = yes.
      711     end.
      712     else do:
      713       find first in-vatp_doc-attr no-lock
      714         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      715           and in-vatp_doc-attr.attr-code = 'envd':U
      716         no-error .
      717       if not available in-vatp_doc-attr then do:
      718         assign
      719           in-vatp-have-vat-slt = yes.
      720       end.
      721       else do:
      722            in-vatp-have-vat-slt = no.
      723       end.
      724     end.
      725     assign
      726      price-cli-with-tax-loc = buf_temp-parts.price-cli
      727      cli-base-rate          = buf_temp-parts.cli-base-rate.
      728     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      729              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      730     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      731             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      732             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      733             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      734             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      735             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      736             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      737       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      738     assign
      739       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      740     assign
      741       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      742       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      743       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      744       transport-cli-loc  = 0
      745       other-cli-loc      = 0
      746     .
      747   ASSIGN
      748             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      749       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      750   .
      751         assign
      752           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      753           p-vat-pc         = p-vat-pc         + vat-pc-loc
      754           p-slt-pc         = p-slt-pc         + slt-pc-loc
      755           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      756           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      757           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      758           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      759           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      760           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      761           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      762           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      763           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      764           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      765           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      766           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      767           p-excise-base    = p-excise-base    + 0
      768           p-excise-rubl    = p-excise-rubl    + 0
      769         .
      770       end.
      771       if p-fact-qnty      = ?
      772       or p-sum-base       = ?
      773       or p-sum-rubl       = ?
      774       or p-vat-base       = ?
      775       or p-vat-rubl       = ?
      776       or p-slt-base       = ?
      777       or p-slt-rubl       = ?
      778       or p-road-tax-base  = ?
      779       or p-road-tax-rubl  = ?
      780       or p-transport-base = ?
      781       or p-transport-rubl = ?
      782       or p-other-base     = ?
      783       or p-other-rubl     = ?
      784       or p-excise-base    = ?
      785       or p-excise-rubl    = ?
      786       then do:
      787         message
      788           vss-workfile vss-revision vss-description skip
      789           vss-include-info0 skip
      790           "Программа in-vatp.i вернула неопределенные значения" skip
      791           "p-fact-qnty"      p-fact-qnty      skip
      792           "p-sum-base"       p-sum-base       skip
      793           "p-sum-rubl"       p-sum-rubl       skip
      794           "p-vat-base"       p-vat-base       skip
      795           "p-vat-rubl"       p-vat-rubl       skip
      796           "p-slt-base"       p-slt-base       skip
      797           "p-slt-rubl"       p-slt-rubl       skip
      798           "p-road-tax-base"  p-road-tax-base  skip
      799           "p-road-tax-rubl"  p-road-tax-rubl  skip
      800           "p-transport-base" p-transport-base skip
      801           "p-transport-rubl" p-transport-rubl skip
      802           "p-other-base"     p-other-base     skip
      803           "p-other-rubl"     p-other-rubl     skip
      804           "p-excise-base"    p-excise-base    skip
      805           "p-excise-rubl"    p-excise-rubl    skip
      806           view-as alert-box error .
      807         undo, return error .
      808       end.
      809     end.
      810   end procedure.
      811   define variable vss-include-info7 as character format "X(65)" no-undo
      812   initial "@(#)$Workfile$ $Revision$".
      813   define temp-table temp_fbrrep-goods no-undo
      814       field gds-code                      as integer
      815       field artic                         as character
      816       field prod-type                     as character
      817       field prod-code                     as integer
      818       field gds-name                      as character
      819       field is-not-office                 as logical
      820       field is-waste                      as logical
      821       field unit-base                     as character
      822       field fact-qnty                     as decimal
      823       field write-off-qnty                as decimal
      824       field write-off-rsrv-qnty           as decimal
      825       field sum-write-off-rsrv-rubl       as decimal
      826       field sum-write-off-rsrv-base       as decimal
      827       field sum-write-off-rsrv-vat-rubl   as decimal
      828       field sum-write-off-rsrv-vat-base   as decimal
      829       field cost-rubl                     as decimal
      830       field cost-base                     as decimal
      831       field sum-cost-rubl                 as decimal
      832       field sum-cost-base                 as decimal
      833       field sum-vat-cost-rubl             as decimal
      834       field sum-vat-cost-base             as decimal
      835       field vat-cost-rubl                 as decimal
      836       field vat-cost-base                 as decimal
      837       field income-qnty                   as decimal
      838       field income-rsrv-qnty              as decimal
      839       field cost-income-rubl              as decimal
      840       field cost-income-base              as decimal
      841       field sum-cost-income-rubl          as decimal
      842       field sum-cost-income-base          as decimal
      843       field sum-vat-cost-income-rubl      as decimal
      844       field sum-vat-cost-income-base      as decimal
      845       field vat-cost-income-rubl          as decimal
      846       field vat-cost-income-base          as decimal
      847       field price-sale                    as decimal
      848       field deleted                       as logical
      849       index pi is primary unique gds-code
      850       index ar is unique artic prod-type prod-code
      851       index dd deleted
      852       index ws is-waste
      853   .
      854   define variable vss-include-info8 as character format "X(65)" no-undo
      855   initial "@(#)$Workfile$ $Revision$".
      856   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   procedure r-cost :
      858     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      859     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      860     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      861     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      862     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      863     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      864     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
