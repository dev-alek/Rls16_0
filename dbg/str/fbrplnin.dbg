     1084         in-vatp-goods.gds-type = 'у':U then do:
     1085         if varinvprb = "base":u then do:
     1086           assign
     1087             road-tax-base-loc = buf_doc-line.road-tax
     1088             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1089         end.
     1090         else do:
     1091           ASSIGN
     1092             road-tax-rubl-loc = buf_doc-line.road-tax
     1093             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1094         end.
     1095         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1096         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1097         assign
     1098           road-tax-cli-loc = ?.
     1099         ASSIGN
     1100           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1101           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1102           transport-cli-loc  = 0
