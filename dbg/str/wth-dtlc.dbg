      400     FIND FIRST buf_wth-par NO-LOCK WHERE
      401                buf_wth-par.wth-code = buf_wealth.wth-code  AND
      402                buf_wth-par.par-code = tt-par-dtl.par-code NO-ERROR.
      403     IF NOT AVAIL buf_wth-par THEN DO:
      404       MESSAGE "Номинал не найден! " VIEW-AS ALERT-BOX ERROR.
      405       RETURN NO-APPLY.
      406     END.
      407     run ref/wthpform.w (
      408                       input Parparentproc
      409                       ,input buf_wth-doc.host-code
      410                       ,input buf_wth-doc.obj-type
      411                       ,input buf_wth-doc.obj-code
      412                       ,INPUT buf_wth-par.wth-code
      413                       ,INPUT buf_wth-par.par-code
      414                       ,INPUT 'ПРОСМОТР':U
      415                      ,OUTPUT v-rep-rec
      416                    ).
