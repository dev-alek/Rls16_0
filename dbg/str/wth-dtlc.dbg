        1   DEFINE BUFFER buf_wealth FOR ub.wealth.
        2   DEFINE BUFFER buf_wth-line FOR ub.wth-line.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
        5   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
        6   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
        7   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        8   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
        9   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
       10   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
       11   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
       12   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам ()"
       13   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
       14   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!()"
       15   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
       16   FIELD w-p-code     like ub.wth-dtl.w-p-code
       17   FIELD doc-code     like ub.wth-dtl.doc-code
       18   FIELD gds-code     like ub.wth-gds.gds-code
       19   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
       20   INDEX tt-i1                        par-feat par-unit par-val
       21   INDEX tt-i2                        doc-sum  q-ty-doc
       22    .
       23   DEFINE INPUT PARAMETER par-mode as character no-undo .
       24   define input parameter parline-rec as recid no-undo.
       25   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
       26   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       27   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       28   define input parameter pardoc-sum like ub.wth-line.doc-sum no-undo .
       29   define input parameter parfact-sum like ub.wth-line.fact-sum no-undo .
       30   define input parameter parbef-sum like ub.wth-line.bef-sum no-undo .
       31   define input parameter paraft-sum like ub.wth-line.aft-sum no-undo .
       32   DEFINE INPUT PARAMETER pardoc-type like ub.wth-doc.doc-type no-undo .
       33   define input parameter parext-type like ub.wth-doc.ext-doc-type no-undo.
       34   define input-output parameter table for tt-par-dtl.
       35   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       36   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       37   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       38   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       39   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       40   define variable vss-description AS CHAR NO-UNDO INIT "Добавление, изменение, просмотр детализации строки документа МЦ (не инвентаризация)":U.
       41   procedure vss-get-info :
       42     define output parameter p-vss-revision    like vss-revision    no-undo .
       43     define output parameter p-vss-author      like vss-author      no-undo .
       44     define output parameter p-vss-date        like vss-date        no-undo .
       45     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       46     define output parameter p-vss-archive     like vss-archive     no-undo .
       47     define output parameter p-vss-description like vss-description no-undo .
       48     assign
       49       p-vss-revision    = vss-revision
       50       p-vss-author      = vss-author
       51       p-vss-date        = vss-date
       52       p-vss-workfile    = vss-workfile
       53       p-vss-archive     = vss-archive
       54       p-vss-description = vss-description
       55     .
       56   end procedure.
       57   procedure vss-get-parameters :
       58     define output parameter p-vss-parameters as character no-undo .
       59   end procedure.
       60   define new global shared variable g#vssrevis-logger as handle    no-undo .
       61   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       62   define variable v-vssrevis-logger                   as handle    no-undo .
       63   procedure vss-logevent :
       64     define input  parameter p-extra-paramters as character no-undo .
       65     define variable v-vssrevis-parameters as character no-undo .
       66     do
       67     on error undo, return error return-value
       68     :
       69       if  valid-handle(v-vssrevis-logger)
       70       and v-vssrevis-logger :get-signature("logevent") <> ""
       71       then do:
       72         run vss-get-parameters in this-procedure
       73           (output v-vssrevis-parameters
       74           ).
       75         run logevent in v-vssrevis-logger
       76           (input vss-workfile
       77           ,input vss-revision
       78           ,input v-vssrevis-parameters
       79           ,input p-extra-paramters
       80           ).
       81       end.
       82     end.
       83   end procedure.
       84   assign
       85     v-vssrevis-logger = g#vssrevis-logger
       86   .
       87   if  valid-handle(v-vssrevis-logger)
       88   and v-vssrevis-logger :get-signature("logevent") <> ""
       89   then do:
       90     assign
       91       v-vssrevis-logevent = true
       92     .
       93     run vss-logevent in this-procedure (input vss-description) .
       94   end.
       95   define new global shared variable g#language as character no-undo .
       96   if g#language <> '' and g#language <> 'rus':U then do:
       97     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       98   end.
       99   procedure proc-alt-shift-f2:
      100     if not ibs.th.gbl.gbl-var:rcode
      101   then
      102     run gbl\inidebug.p .
      103   end.
      104   procedure proc-alt-shift-f3:
      105     run gbl/prvssinf.p
      106       ( input this-procedure
      107       ) .
      108   end.
      109   define variable v-inform-launched as logical no-undo initial false .
      110   procedure proc-alt-shift-f4:
      111     define variable v-action as character no-undo .
      112     if v-inform-launched = false then do:
      113       assign
      114         v-inform-launched = true
      115       .
      116       run gbl/d-inform.w
      117         (  input self
      118         ,  input this-procedure
      119         , output v-action
      120         ) no-error .
      121       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      122       assign
      123         v-inform-launched = false
      124       .
      125     end.
      126   end.
      127   procedure proc-alt-f1:
      128     run gbl/corrhelp.p
      129       (input this-procedure
      130       ) .
      131   end .
      132   on alt-shift-f2 anywhere do:
      133     run proc-alt-shift-f2.
      134   end.
      135   on alt-shift-f3 anywhere do:
      136     run proc-alt-shift-f3 in this-procedure .
      137   end.
      138   on alt-shift-f4 anywhere do:
      139     run proc-alt-shift-f4 in this-procedure.
      140   end.
      141   on alt-f1 anywhere do:
      142     run proc-alt-f1 in this-procedure .
      143   end.
      144   define new global shared variable g#library  as handle no-undo .
      145   define new global shared variable g#library2 as handle no-undo .
      146   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147     define variable v-cntxt-db-num        as integer   no-undo .
      148     define variable v-cntxt-userid        as character no-undo .
      149     define variable v-cntxt-level         as character no-undo .
      150     define variable v-cntxt-host-code-obj as integer   no-undo .
      151     define variable v-cntxt-obj-type      as character no-undo .
      152     define variable v-cntxt-obj-code      as integer   no-undo .
      153     define variable v-cntxt-db-num-obj    as integer   no-undo .
      154     define variable v-cntxt-is-admin      as logical   no-undo .
      155   DEFine VARiable d_doc-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      156   DEFine VARiable d_fact-sum LIKE ub.wth-doc.doc-sum NO-UNDO.
      157   DEFINE VARIABLE vardoc-status_ like ub.wth-doc.status_ no-undo .
      158   define buffer buf_wth-par for ub.wth-par.
      159   define buffer buf_wth-doc for ub.wth-doc.
      160   define buffer buf_wth-parts for ub.wth-parts.
      161   DEFINE BUTTON B-exit AUTO-GO
      162        LABEL "&Ввод"
      163        SIZE 10 BY 1
      164        BGCOLOR 8 .
      165   DEFINE BUTTON B-Help
      166        LABEL "Помо&щь"
      167        SIZE 10 BY 1
      168        BGCOLOR 8 .
      169   DEFINE BUTTON B-par
      170        LABEL "&Инфо"
      171        SIZE 10 BY 1.
      172   DEFINE BUTTON B-parts
      173        LABEL "&Партии"
      174        SIZE 10 BY 1.
      175   DEFINE BUTTON b-quit AUTO-END-KEY
      176        LABEL "Отменить"
      177        SIZE 10 BY 1
      178        BGCOLOR 8 .
      179   DEFINE VARIABLE for-d_doc-sum AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      180        LABEL "ИТОГО по документу"
      181         VIEW-AS TEXT
      182        SIZE 21.5 BY .67
      183        FGCOLOR 4  NO-UNDO.
      184   DEFINE VARIABLE for-d_fact-sum AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      185        LABEL "ИТОГО факт"
      186         VIEW-AS TEXT
      187        SIZE 21.5 BY .67
      188        FGCOLOR 4  NO-UNDO.
      189   DEFINE QUERY BR-dtl FOR
      190         tt-par-dtl SCROLLING.
      191   DEFINE QUERY Dialog-Frame FOR
      192         buf_wth-line SCROLLING.
      193   DEFINE BROWSE BR-dtl
      194     QUERY BR-dtl DISPLAY
      195         tt-par-dtl.par-feat
      196         tt-par-dtl.par-val
      197         tt-par-dtl.par-unit
      198         tt-par-dtl.q-ty-doc
      199         tt-par-dtl.doc-sum
      200         tt-par-dtl.q-ty-fact
      201         tt-par-dtl.fact-sum
      202         tt-par-dtl.sum-gds-rubl
      203         tt-par-dtl.sum-gds-base
      204         tt-par-dtl.price-rubl
      205         tt-par-dtl.price-base
      206         tt-par-dtl.gds-code
      207   ENABLE
      208         tt-par-dtl.q-ty-doc
      209         tt-par-dtl.q-ty-fact
      210       WITH NO-ROW-MARKERS SEPARATORS SIZE 101.75 BY 13.67.
      211   DEFINE FRAME Dialog-Frame
      212        B-exit AT ROW 1 COL 1.13
      213        b-quit AT ROW 1 COL 11.13
      214        B-par AT ROW 1 COL 21
      215        B-parts AT ROW 1 COL 31 WIDGET-ID 4
      216        B-Help AT ROW 1 COL 54.88
      217        BR-dtl AT ROW 4.5 COL 1.38
      218        ub.wth-line.doc-sum AT ROW 3.25 COL 24 COLON-ALIGNED
      219             LABEL "Кол-во по документу"
      220              VIEW-AS TEXT
      221             SIZE 21.5 BY .67
      222             FGCOLOR 4
      223        ub.wth-line.fact-sum AT ROW 3.25 COL 60 COLON-ALIGNED
      224             LABEL "Кол-во факт"
      225              VIEW-AS TEXT
      226             SIZE 21.5 BY .67
      227             FGCOLOR 4
      228        for-d_doc-sum AT ROW 18.63 COL 24.25 COLON-ALIGNED
      229        for-d_fact-sum AT ROW 18.67 COL 60.25 COLON-ALIGNED
      230        SPACE(19.49) SKIP(0.53)
      231       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      232            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      233            TITLE "<insert dialog title>"
      234            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      235   ASSIGN
      236          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      237          FRAME Dialog-Frame:HIDDEN           = TRUE.
      238   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      239   DO:
      240     APPLY "END-ERROR":U TO SELF.
      241   END.
      242   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      243   DO:
      244     define variable d_line-sum LIKE d_doc-sum NO-UNDO.
      245     IF par-mode = 'ПРОСМОТР':U THEN DO:
      246       RETURN NO-APPLY.
      247     END.
      248   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   if lookup(self :type
      250            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      251            ) = 0
      252   then do:
      253     message
      254       "$Workfile$"
      255       "Указанному интерфейсному элементу фокус не может быть передан" skip
      256       "Интерфейсный элемент" self :name  skip
      257       "Тип" self :type  skip
      258       "Процедура" this-procedure :file-name skip
      259       view-as alert-box .
      260   end.
      261   else do:
      262     apply "entry":u to self  .
      263     if focus :handle <> self :handle  then do:
      264       return no-apply .
      265     end.
      266   end.
      267     DO TRANSACTION on error undo, return NO-apply
      268                                   on stop undo, return no-apply:
      269     case vardoc-status_:
      270       when 'накл':U then do:
      271         FOR EACH tt-par-dtl:
      272           IF tt-par-dtl.doc-sum  = 0 AND tt-par-dtl.q-ty-doc  = 0 THEN DO:
      273             NEXT.
      274           END.
      275           IF tt-par-dtl.doc-sum  = 0 AND tt-par-dtl.q-ty-doc <> 0 OR
      276             tt-par-dtl.doc-sum <> 0 AND tt-par-dtl.q-ty-doc  = 0
      277           THEN DO:
      278             IF tt-par-dtl.doc-sum  = 0 AND tt-par-dtl.q-ty-doc <> 0 THEN DO:
      279               ASSIGN
      280               tt-par-dtl.doc-sum = tt-par-dtl.q-ty-doc * tt-par-dtl.par-rate.
      281             END.
      282             IF tt-par-dtl.doc-sum <> 0 AND tt-par-dtl.q-ty-doc  = 0 THEN DO:
      283               ASSIGN tt-par-dtl.q-ty-doc    = tt-par-dtl.doc-sum / tt-par-dtl.par-rate .
      284             END.
      285           END.
      286         END.
      287       end.
      288       when 'разрешен':U then do:
      289         FOR EACH tt-par-dtl:
      290           IF tt-par-dtl.fact-sum  = 0 AND tt-par-dtl.q-ty-fact  = 0 THEN DO:
      291             NEXT.
      292           END.
      293           IF tt-par-dtl.fact-sum  = 0 AND tt-par-dtl.q-ty-fact <> 0 OR
      294              tt-par-dtl.fact-sum <> 0 AND tt-par-dtl.q-ty-fact  = 0
      295           THEN DO:
      296             IF tt-par-dtl.fact-sum  = 0 AND tt-par-dtl.q-ty-fact <> 0 THEN DO:
      297               ASSIGN
      298               tt-par-dtl.fact-sum = tt-par-dtl.q-ty-fact * tt-par-dtl.par-rate.
      299             END.
      300             IF tt-par-dtl.fact-sum <> 0 AND tt-par-dtl.q-ty-fact  = 0 THEN DO:
      301               ASSIGN tt-par-dtl.q-ty-fact = tt-par-dtl.fact-sum / tt-par-dtl.par-rate .
      302             END.
      303           END.
      304         END.
      305       end.
      306       END CASE.
      307     END.
      308     APPLY "GO":U TO FRAME Dialog-Frame.
      309   END.
      310   ON CHOOSE OF B-par IN FRAME Dialog-Frame
      311   DO:
      312   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   if lookup(self :type
      314            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      315            ) = 0
      316   then do:
      317     message
      318       "$Workfile$"
      319       "Указанному интерфейсному элементу фокус не может быть передан" skip
      320       "Интерфейсный элемент" self :name  skip
      321       "Тип" self :type  skip
      322       "Процедура" this-procedure :file-name skip
      323       view-as alert-box .
      324   end.
      325   else do:
      326     apply "entry":u to self  .
      327     if focus :handle <> self :handle  then do:
      328       return no-apply .
      329     end.
      330   end.
      331    define variable glog as logical no-undo .
      332    define variable v-rep-rec as recid no-undo .
      333     DEF BUFFER buf-par FOR ub.wth-par.
      334       if not avail tt-par-dtl then return no-apply.
      335     case par-mode :
      336       when 'ДОБАВЛЕНИЕ':U  then do:
      337   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   do:
      339     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      340       (input  v-cntxt-db-num
      341       ,input  v-cntxt-userid
      342       ,input  0
      343       ,input  'actn_wth-doc_add-def':U
