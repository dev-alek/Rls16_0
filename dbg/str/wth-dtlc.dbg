      418   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
      419   DO:
      420   if not available tt-par-dtl then return.
      421   run str/wthparts.w (
      422                    input parparentproc
      423                   ,input p-curr-host-code
      424                   ,input p-curr-obj-type
      425                   ,input p-curr-obj-code
      426                   ,input 'document':U
      427                   ,input (if par-mode = 'ПРОСМОТР':U then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U)
      428                   ,input parwth-code
      429                   ,input tt-par-dtl.par-code
      430                   ,INPUT 0
      431                   ,input 0
      432                   ,INPUT buf_wth-doc.doc-code
      433                   ,INPUT parw-p-code
      434                   ,INPUT buf_wth-doc.cli-type
      435                   ,INPUT buf_wth-doc.cli-code
      436                   ,INPUT buf_wth-doc.doc-type ) no-error.
      437   if error-status:error then do:
      438     message return-value error-status:get-message(1) view-as alert-box error title 'Ошибка при запуске wthparts.w'.
      439     return no-apply.
      440   end.
      441   if par-mode <> 'ПРОСМОТР':U then do:
      442   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   assign
      444   tt-par-dtl.q-ty-doc  = 0
      445   tt-par-dtl.q-ty-fact = 0
      446   tt-par-dtl.doc-sum   = 0
      447   tt-par-dtl.fact-sum  = 0
      448   tt-par-dtl.sum-gds-rubl = 0
      449   tt-par-dtl.sum-gds-base = 0
      450   .
      451   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-par-dtl.w-p-code
      452                          and buf_wth-parts.wth-code = tt-par-dtl.wth-code
      453                          and buf_wth-parts.par-code = tt-par-dtl.par-code
      454                          and buf_wth-parts.out-code = tt-par-dtl.doc-code
      455                          and buf_wth-parts.stts = 0 :
      456      assign
      457     tt-par-dtl.q-ty-doc     =  tt-par-dtl.q-ty-doc  + buf_wth-parts.qnty-doc
      458     tt-par-dtl.q-ty-fact    =  tt-par-dtl.q-ty-fact + buf_wth-parts.fact-qnty
      459     tt-par-dtl.sum-gds-rubl =  tt-par-dtl.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
      460     tt-par-dtl.sum-gds-base =  tt-par-dtl.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
      461     no-error
      462     .
      463   end.
      464   assign
      465     tt-par-dtl.doc-sum     =  tt-par-dtl.q-ty-doc  * tt-par-dtl.par-rate
      466     tt-par-dtl.fact-sum    =  tt-par-dtl.q-ty-fact * tt-par-dtl.par-rate
      467     no-error
      468     .
      469       DISPLAY
      470       tt-par-dtl.q-ty-doc
      471       tt-par-dtl.doc-sum
      472       tt-par-dtl.q-ty-fact
      473       tt-par-dtl.fact-sum
      474       tt-par-dtl.sum-gds-rubl
      475       tt-par-dtl.sum-gds-base
      476       tt-par-dtl.price-rubl
      477       tt-par-dtl.price-base
      478       WITH BROWSE BR-dtl.
      479    end.
      480   END.
      481   ON DEFAULT-ACTION OF BR-dtl IN FRAME Dialog-Frame
      482   DO:
      483     if b-parts:sensitive then
      484     apply 'choose':U to b-parts .
      485   END.
      486   ON ROW-LEAVE OF BR-dtl IN FRAME Dialog-Frame
      487   DO:
      488   if vardoc-status_ = 'накл':U then do:
      489     if tt-par-dtl.q-ty-doc:read-only  in BROWSE BR-dtl = no then do:
      490       ASSIGN
      491       tt-par-dtl.q-ty-doc = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-doc
      492       tt-par-dtl.q-ty-fact = tt-par-dtl.q-ty-doc.
      493       ASSIGN
      494       d_doc-sum = d_doc-sum - tt-par-dtl.doc-sum.
      495       ASSIGN
      496       tt-par-dtl.doc-sum = tt-par-dtl.q-ty-doc  * tt-par-dtl.par-rate
      497       tt-par-dtl.fact-sum = tt-par-dtl.doc-sum.
      498       ASSIGN
      499       d_doc-sum = d_doc-sum + tt-par-dtl.doc-sum.
      500       DISPLAY
      501       tt-par-dtl.q-ty-doc
      502       tt-par-dtl.doc-sum
      503       tt-par-dtl.q-ty-fact
      504       tt-par-dtl.fact-sum
      505       WITH BROWSE BR-dtl.
      506       DISPLAY
      507       d_doc-sum @ for-d_doc-sum
      508       WITH FRAME Dialog-Frame.
      509     end.
      510     if tt-par-dtl.q-ty-fact:read-only  in BROWSE BR-dtl = no then do:
      511       ASSIGN
      512       tt-par-dtl.q-ty-fact = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-fact.
      513       ASSIGN
      514       d_fact-sum = d_fact-sum - tt-par-dtl.fact-sum.
      515       ASSIGN
      516       tt-par-dtl.fact-sum = tt-par-dtl.q-ty-fact  * tt-par-dtl.par-rate.
      517       ASSIGN
      518       d_fact-sum = d_fact-sum + tt-par-dtl.fact-sum.
      519       DISPLAY
      520       tt-par-dtl.q-ty-fact
      521       tt-par-dtl.fact-sum
      522       WITH BROWSE BR-dtl.
      523       DISPLAY
      524       d_fact-sum @ for-d_fact-sum
      525       WITH FRAME Dialog-Frame.
      526     end.
      527   end.
      528   END.
      529   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      530   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      531   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   on help of frame Dialog-Frame
      533   do:
      534     run gbl/app_help.p
      535       (input this-procedure :file-name
      536       ,input ''
      537       ,input ?
      538       ) no-error.
      539     if error-status :error then do:
      540       message
      541         "Ошибка при вызове помощи"
      542         error-status :get-message(1)
      543         view-as alert-box .
      544     end.
      545   end.
      546   run minbtn-set in this-procedure .
      547   on choose of b-help in frame Dialog-Frame
      548   do:
      549     apply "help":u to frame Dialog-Frame .
      550   end.
      551   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   procedure minbtn-set :
      553       do
      554           on error undo, return error return-value
      555           :
      556           define variable ii              as integer       no-undo .
      557           define variable fh              as widget-handle no-undo .
      558           define variable hh              as widget-handle no-undo .
      559           define variable v-h             as handle        extent 4 no-undo .
      560           define variable v-name-button   as character     no-undo .
      561           define variable v-help-old-x    as decimal       no-undo .
      562           define variable v-help-old-y    as decimal       no-undo .
      563           define variable v-help-old-size as decimal       no-undo .
      564           define variable v-frame-width   as decimal       no-undo .
      565           define variable jj              as integer       no-undo .
      566           do
      567               on error undo, return error
      568               :
      569               assign
      570                   v-frame-width = frame Dialog-Frame:width - 0.3
      571                   fh            = frame Dialog-Frame:first-child
      572                   hh            = fh:first-child
      573                   ii            = 1
      574                   .
      575               do while valid-handle(hh):
      576                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      577                   do:
      578                       case lc(hh:name) :
      579                           when "b-help" then
      580                               do:
      581                                   hh:load-image-up("cmp/b-help.bmp":u) .
      582                                   hh:load-image-down("cmp/b-help.bmp":u) .
      583                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      584                                   hh:TOOLTIP = "Помощь" .
      585                                   v-help-old-x = hh:column .
      586                                   v-help-old-y = hh:row    .
      587                                   v-help-old-size = hh:width .
      588                                   hh:width-chars = 2.5 .
      589                               end.
      590                           when "b-print" then
      591                               do:
      592                                   hh:load-image("cmp/b-print.bmp":u) .
      593                                   hh:TOOLTIP = "Печать" .
      594                                   v-h[ii] = hh:handle .
      595                                   ii = ii + 1 .
      596                                   hh:width-chars = 3 .
      597                               end.
      598                           when "b-history" or
      599                           when "b-hist" then
      600                               do:
      601                                   hh:load-image("cmp/b-hist.bmp":u) .
      602                                   hh:TOOLTIP = "История" .
      603                                   v-h[ii] = hh:handle .
      604                                   ii = ii + 1 .
      605                                   hh:width-chars = 3 .
      606                               end.
      607                           when "b-sch" then
      608                               do:
      609                                   hh:load-image("cmp/b-sch.bmp":u) .
      610                                   hh:TOOLTIP = "Установка Фильтра" .
      611                                   v-h[ii] = hh:handle .
      612                                   ii = ii + 1 .
      613                                   hh:width-chars = 3 .
      614                               end.
      615                           when "b-hist-user" then
      616                               do:
      617                                   hh:load-image("cmp/b-hist.bmp":u) .
      618                                   hh:TOOLTIP = "История пользователя" .
      619                                   ii = ii + 1 .
      620                               end.
      621                       end case.
      622                   end.
      623                   hh = hh:next-sibling.
      624               end.
      625               b-help:column = v-frame-width - b-help:width-chars.
      626               jj = 0.
      627               repeat ii = 4 to 1 by -1 :
      628                   if valid-handle (v-h[ii] ) then
      629                   do:
      630                       jj  = jj + 1 .
      631                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      632                       v-h[ii]:row    = v-help-old-y .
      633                   end.
      634               end.
      635           end.
      636       end.
      637   end procedure.
      638   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      639   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      640   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      641   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      642   define variable v-diasize-current-frame-width  as decimal   no-undo .
      643   define variable v-diasize-current-frame-height as decimal   no-undo .
      644   define variable v-diasize-change-size          as logical   no-undo .
      645   define variable v-diasize-resize-button        as handle    no-undo .
      646   define variable v-diasize-wndmax               as logical   no-undo .
      647   define variable v-diasize-wndstore             as logical   no-undo .
      648   define variable v-diasize-proc-name            as character no-undo .
      649   define variable v-diasize-browse-handle        as handle    no-undo .
      650   define variable v-diasize-browse-number        as integer   no-undo .
      651   define variable v-diasize-need-full-display    as logical   no-undo init false .
      652   define temp-table temp-diasize-handle no-undo
      653     field handle-value  as handle
      654     field save-position as decimal
      655     index xpk is primary unique handle-value
      656     .
      657   define temp-table temp-browse-handle no-undo
      658     field browse-type   as character
      659     field browse-number as integer
      660     field browse-handle as handle
      661     field original-size as decimal
      662     index xpk is primary unique browse-type browse-number
      663     index xie browse-type browse-handle
      664   .
      665   procedure diasize_change-height :
      666     define input  parameter p-change-value  as decimal   no-undo .
      667     define input  parameter p-move-resize   as logical   no-undo .
      668     define variable v-field-group-handle    as handle    no-undo .
      669     define variable v-object-handle         as handle    no-undo .
      670     define variable v-frame-height          as decimal   no-undo .
      671     define variable v-frame-virtual-height  as decimal   no-undo .
      672     define variable v-browse-height         as decimal   no-undo .
      673     define variable v-window-height         as decimal   no-undo .
      674     define variable v-window-virtual-height as decimal   no-undo .
      675     define variable v-change-sign           as integer   no-undo .
      676     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      677     define buffer buf_temp-browse-handle  for temp-browse-handle .
      678     if p-change-value > 0
      679     then do:
      680       if frame Dialog-Frame :height + p-change-value
      681           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      682       then do:
      683         assign
      684           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      685                           - (frame Dialog-Frame :height-chars)
      686         .
      687         if p-change-value <= 0
      688         then do:
      689           run diasize_position-resize-button in this-procedure .
      690           return .
      691         end.
      692       end.
      693     end.
      694     if p-change-value < 0
      695     then do:
      696       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      697       then do:
      698         assign
      699           p-change-value = v-diasize-orig-frame-height
      700                          - (frame Dialog-Frame :height-chars)
      701         .
      702         if p-change-value >= 0
      703         then do:
      704           run diasize_position-resize-button in this-procedure .
      705           return .
      706         end.
      707       end.
      708     end.
      709     if p-change-value >= 0
      710     then do:
      711       assign
      712         v-change-sign = 1
      713       .
      714     end.
      715     else do:
      716       assign
      717         v-change-sign = -1
      718       .
      719     end.
      720     assign
      721       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      722     .
      723     if p-change-value = 0
      724     then do:
      725       run diasize_position-resize-button in this-procedure .
      726       return .
      727     end.
      728     move_block:
      729     do
      730     on error undo move_block, retry move_block
      731     :
      732       if retry
      733       then do:
      734         do
      735         on error undo move_block, leave move_block
      736         :
      737           if p-change-value > 0
      738           then do:
      739             for each buf_temp-diasize-handle
      740             on error undo, next
      741             :
      742               assign
      743                 v-object-handle = buf_temp-diasize-handle.handle-value
      744               .
      745               if v-object-handle <> v-diasize-resize-button
      746               then do:
      747                 assign
      748                   v-object-handle :row = buf_temp-diasize-handle.save-position
      749                 .
      750               end.
      751             end.
      752             assign
      753               v-diasize-browse-handle :height = v-browse-height
      754             .
      755             for each buf_temp-browse-handle
      756               where buf_temp-browse-handle.browse-type = 'height':u
      757             on error undo, next
      758             :
      759               assign
      760                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      761               .
      762             end.
      763             assign
      764               frame Dialog-Frame :height = v-frame-height
      765             .
      766             if frame Dialog-Frame :scrollable = true
      767             then do:
      768               assign
      769                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      770               .
      771             end.
      772             run diasize_position-resize-button in this-procedure .
      773           end.
      774           else do:
      775             if frame Dialog-Frame :scrollable = true
      776             then do:
      777               assign
      778                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      779               .
      780             end.
      781             assign
      782               frame Dialog-Frame :height = v-frame-height
      783             .
      784             assign
      785               v-diasize-browse-handle :height = v-browse-height
      786             .
      787             for each buf_temp-browse-handle
      788               where buf_temp-browse-handle.browse-type = 'height':u
      789             on error undo, next
      790             :
      791               assign
      792                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      793               .
      794             end.
      795             for each buf_temp-diasize-handle
      796             on error undo, next
      797             :
      798               assign
      799                 v-object-handle = buf_temp-diasize-handle.handle-value
      800               .
      801               if v-object-handle <> v-diasize-resize-button
      802               then do:
      803                 assign
      804                   v-object-handle :row = buf_temp-diasize-handle.save-position
      805                 .
      806               end.
      807             end.
      808             run diasize_position-resize-button in this-procedure .
      809           end.
      810           assign
      811             v-diasize-change-size = false
      812           .
      813           leave move_block .
      814         end.
      815       end.
      816       assign
      817         v-diasize-need-full-display = true
      818       .
      819       if v-diasize-change-size = false
      820       then do:
      821         assign
      822           v-diasize-change-size = true
      823         .
      824       end.
      825       else do:
      826         return .
      827       end.
      828       assign
      829         v-frame-height = frame Dialog-Frame :height
      830         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      831         v-browse-height = v-diasize-browse-handle :height
      832       .
      833       for each buf_temp-browse-handle
      834         where buf_temp-browse-handle.browse-type = 'height':u
      835       :
      836         assign
      837           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      838         .
      839       end.
      840       for each buf_temp-diasize-handle
      841       :
      842         delete buf_temp-diasize-handle .
      843       end.
      844       assign
      845         v-field-group-handle = frame Dialog-Frame :first-child
      846       .
      847       do while valid-handle(v-field-group-handle)
      848       :
      849         assign
      850           v-object-handle = v-field-group-handle :first-child
      851         .
      852         do while valid-handle(v-object-handle)
      853         :
      854           if  v-object-handle <> v-diasize-browse-handle :handle
      855           and can-query(v-object-handle, "row")
      856           and can-query(v-object-handle, "height")
      857           and ( v-object-handle :row > v-diasize-browse-handle :row )
      858           then do:
      859             find first buf_temp-browse-handle
      860               where buf_temp-browse-handle.browse-type   = 'height':u
      861                 and buf_temp-browse-handle.browse-handle = v-object-handle
      862               no-error .
      863             if available buf_temp-browse-handle
      864             then do:
      865             end.
      866             else do:
      867               create buf_temp-diasize-handle .
      868               assign
      869                 buf_temp-diasize-handle.handle-value  = v-object-handle
      870                 buf_temp-diasize-handle.save-position = v-object-handle :row
      871               .
      872             end.
      873           end.
      874           assign
      875             v-object-handle = v-object-handle :next-sibling
      876           .
      877         end.
      878         assign
      879           v-field-group-handle = v-field-group-handle :next-sibling
      880         .
      881       end.
      882       do with frame Dialog-Frame
      883       :
      884         hide v-diasize-resize-button .
      885         assign
      886           v-diasize-resize-button :row    = 1
      887           v-diasize-resize-button :column = 1
      888         .
      889       end.
      890       if p-change-value > 0
      891       then do:
      892         if frame Dialog-Frame :scrollable = true
      893         then do:
      894           assign
      895             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      896             no-error .
      897           if error-status :error
      898           or error-status :get-message(1) <> ""
      899           then do:
      900             undo move_block, retry move_block .
      901           end.
      902         end.
      903         assign
      904           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      905           no-error .
      906         if error-status :error
      907         or error-status :get-message(1) <> ""
      908         then do:
      909           undo move_block, retry move_block .
      910         end.
      911         assign
      912           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      913           no-error .
      914         if error-status :error
      915         or error-status :get-message(1) <> ""
      916         then do:
      917           undo move_block, retry move_block .
      918         end.
      919         for each buf_temp-browse-handle
      920           where buf_temp-browse-handle.browse-type = 'height':u
      921         on error undo move_block, retry move_block
      922         :
      923           assign
      924             buf_temp-browse-handle.browse-handle :height
      925               = buf_temp-browse-handle.browse-handle :height + p-change-value
      926             no-error .
      927           if error-status :error
      928           or error-status :get-message(1) <> ""
      929           then do:
      930             undo move_block, retry move_block .
      931           end.
      932         end.
      933         for each buf_temp-diasize-handle
      934         on error undo move_block, retry move_block
      935         :
      936           assign
      937             v-object-handle = buf_temp-diasize-handle.handle-value
      938           .
      939           if v-object-handle <> v-diasize-resize-button
      940           then do:
      941             assign
      942               v-object-handle :row = v-object-handle :row + p-change-value
      943               no-error .
      944             if error-status :error
      945             or error-status :get-message(1) <> ""
      946             then do:
      947               undo move_block, retry move_block .
      948             end.
      949           end.
      950         end.
      951       end.
      952       else do:
      953         for each buf_temp-diasize-handle
      954         on error undo move_block, retry move_block
      955         :
      956           assign
      957             v-object-handle = buf_temp-diasize-handle.handle-value
      958           .
      959           if v-object-handle <> v-diasize-resize-button
      960           then do:
      961             assign
      962               v-object-handle :row = v-object-handle :row + p-change-value
      963               no-error .
      964             if error-status :error
      965             or error-status :get-message(1) <> ""
      966             then do:
      967               undo move_block, retry move_block .
      968             end.
      969           end.
      970         end.
      971         assign
      972           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      973           no-error .
      974         if error-status :error
      975         or error-status :get-message(1) <> ""
      976         then do:
      977           undo move_block, retry move_block .
      978         end.
      979         for each buf_temp-browse-handle
      980           where buf_temp-browse-handle.browse-type = 'height':u
      981         on error undo move_block, retry move_block
      982         :
      983           assign
      984             buf_temp-browse-handle.browse-handle :height
      985               = buf_temp-browse-handle.browse-handle :height + p-change-value
      986             no-error .
      987           if error-status :error
      988           or error-status :get-message(1) <> ""
      989           then do:
      990             undo move_block, retry move_block .
      991           end.
      992         end.
      993         assign
      994           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      995           no-error .
      996         if error-status :error
      997         or error-status :get-message(1) <> ""
      998         then do:
      999           undo move_block, retry move_block .
     1000         end.
     1001         if frame Dialog-Frame :scrollable = true
     1002         then do:
     1003           assign
     1004             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1005             no-error .
     1006           if error-status :error
     1007           or error-status :get-message(1) <> ""
     1008           then do:
     1009             undo move_block, retry move_block .
     1010           end.
     1011         end.
     1012       end.
     1013       if p-move-resize = true
     1014       then do:
     1015         run diasize_position-resize-button in this-procedure .
     1016       end.
     1017       if v-diasize-wndstore = true
     1018       then do:
     1019         if connected("ub") = true
     1020         then do:
     1021           define variable v-cntxt-db-num        as integer   no-undo .
     1022           define variable v-cntxt-userid        as character no-undo .
     1023           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1024                                             , OUTPUT v-cntxt-userid
     1025                                             ) .
     1026           run gbl/wndsizew.p
     1027             (input  v-cntxt-db-num
     1028             ,input  v-cntxt-userid
     1029             ,input  v-diasize-proc-name
     1030             ,input  'height':u
     1031             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1032             ) .
     1033         end.
     1034       end.
     1035     end.
     1036     assign
     1037       v-diasize-change-size = false
     1038     .
     1039   end procedure.
     1040   procedure diasize_set-height :
     1041     define input  parameter p-new-height  as decimal   no-undo .
     1042     define input  parameter p-move-resize as logical   no-undo .
     1043     do
     1044     on error undo, return error return-value
     1045     :
     1046       run diasize_change-height in this-procedure
     1047         (input  (p-new-height - frame Dialog-Frame :height)
     1048         ,input  p-move-resize
     1049         ) .
     1050     end.
     1051   end procedure.
     1052   procedure diasize_change-width :
     1053     define input  parameter p-change-value as decimal   no-undo .
     1054     define input  parameter p-move-resize  as logical   no-undo .
     1055     define variable v-field-group-handle   as handle    no-undo .
     1056     define variable v-object-handle        as handle    no-undo .
     1057     define variable v-frame-width          as decimal   no-undo .
     1058     define variable v-frame-virtual-width  as decimal   no-undo .
     1059     define variable v-browse-width         as decimal   no-undo .
     1060     define variable v-window-width         as decimal   no-undo .
     1061     define variable v-window-virtual-width as decimal   no-undo .
     1062     define variable v-change-sign          as integer   no-undo .
     1063     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1064     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1065     if p-change-value > 0
     1066     then do:
     1067       if frame Dialog-Frame :width + p-change-value >
     1068           session :width-chars
     1069       then do:
     1070         assign
     1071           p-change-value = session :width-chars - frame Dialog-Frame :width
     1072         .
     1073         if p-change-value <= 0
     1074         then do:
     1075           run diasize_position-resize-button in this-procedure .
     1076           return .
     1077         end.
     1078       end.
     1079     end.
     1080     if p-change-value < 0
     1081     then do:
     1082       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1083       then do:
     1084         assign
     1085           p-change-value = v-diasize-orig-frame-width
     1086                          - frame Dialog-Frame :width
     1087         .
     1088         if p-change-value >= 0
     1089         then do:
     1090           run diasize_position-resize-button in this-procedure .
     1091           return .
     1092         end.
     1093       end.
     1094     end.
     1095     if p-change-value >= 0
     1096     then do:
     1097       assign
     1098         v-change-sign = 1
     1099       .
     1100     end.
     1101     else do:
     1102       assign
     1103         v-change-sign = -1
     1104       .
     1105     end.
     1106     assign
     1107       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1108     .
     1109     if p-change-value = 0
     1110     then do:
     1111       run diasize_position-resize-button in this-procedure .
     1112       return .
     1113     end.
     1114     move_block:
     1115     do
     1116     on error undo move_block, leave move_block
     1117     :
     1118       if retry
     1119       then do:
     1120         do
     1121         on error undo move_block, leave move_block
     1122         :
     1123           if p-change-value > 0
     1124           then do:
     1125             for each buf_temp-diasize-handle
     1126             on error undo, next
     1127             :
     1128               assign
     1129                 v-object-handle = buf_temp-diasize-handle.handle-value
     1130               .
     1131               if v-object-handle <> v-diasize-resize-button
     1132               then do:
     1133                 assign
     1134                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1135                 .
     1136               end.
     1137             end.
     1138             assign
     1139               v-diasize-browse-handle :width = v-browse-width
     1140             .
     1141             for each buf_temp-browse-handle
     1142               where buf_temp-browse-handle.browse-type = 'width':u
     1143             on error undo, next
     1144             :
     1145               assign
     1146                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1147               .
     1148             end.
     1149             assign
     1150               frame Dialog-Frame :width = v-frame-width
     1151             .
     1152             if frame Dialog-Frame :scrollable = true
     1153             then do:
     1154               assign
     1155                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1156               .
     1157             end.
     1158             run diasize_position-resize-button in this-procedure .
     1159           end.
     1160           else do:
     1161             if frame Dialog-Frame :scrollable = true
     1162             then do:
     1163               assign
     1164                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1165               .
     1166             end.
     1167             assign
     1168               frame Dialog-Frame :width = v-frame-width
     1169             .
     1170             for each buf_temp-browse-handle
     1171               where buf_temp-browse-handle.browse-type = 'width':u
     1172             on error undo, next
     1173             :
     1174               assign
     1175                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1176               .
     1177             end.
     1178             assign
     1179               v-diasize-browse-handle :width = v-browse-width
     1180             .
     1181             for each buf_temp-diasize-handle
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 v-object-handle = buf_temp-diasize-handle.handle-value
     1186               .
     1187               if v-object-handle <> v-diasize-resize-button
     1188               then do:
     1189                 assign
     1190                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1191                 .
     1192               end.
     1193             end.
     1194             run diasize_position-resize-button in this-procedure .
     1195           end.
     1196           assign
     1197             v-diasize-change-size = false
     1198           .
     1199           leave move_block .
     1200         end.
     1201       end.
     1202       assign
     1203         v-diasize-need-full-display = true
     1204       .
     1205       if v-diasize-change-size = false
     1206       then do:
     1207         assign
     1208           v-diasize-change-size = true
     1209         .
     1210       end.
     1211       else do:
     1212         return .
     1213       end.
     1214       assign
     1215         v-frame-width = frame Dialog-Frame :width
     1216         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1217         v-browse-width = v-diasize-browse-handle :width
     1218       .
     1219       for each buf_temp-browse-handle
     1220         where buf_temp-browse-handle.browse-type = 'width':u
     1221       :
     1222         assign
     1223           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1224         .
     1225       end.
     1226       for each buf_temp-diasize-handle
     1227       :
     1228         delete buf_temp-diasize-handle .
     1229       end.
     1230       assign
     1231         v-field-group-handle = frame Dialog-Frame :first-child
     1232       .
     1233       do while valid-handle(v-field-group-handle)
     1234       :
     1235         assign
     1236           v-object-handle = v-field-group-handle :first-child
     1237         .
     1238         do while valid-handle(v-object-handle)
     1239         :
     1240           if  v-object-handle <> v-diasize-browse-handle :handle
     1241           and v-object-handle <> v-diasize-resize-button
     1242           and can-query(v-object-handle, "row")
     1243           and can-query(v-object-handle, "height")
     1244           and ( v-object-handle :col + v-object-handle :width
     1245                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1246               )
     1247           then do:
     1248             find first buf_temp-browse-handle
     1249               where buf_temp-browse-handle.browse-type   = 'width':u
     1250                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1251               no-error .
     1252             if available buf_temp-browse-handle
     1253             then do:
     1254             end.
     1255             else do:
     1256               create buf_temp-diasize-handle .
     1257               assign
     1258                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1259                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1260               .
     1261             end.
     1262           end.
     1263           assign
     1264             v-object-handle = v-object-handle :next-sibling
     1265           .
     1266         end.
     1267         assign
     1268           v-field-group-handle = v-field-group-handle :next-sibling
     1269         .
     1270       end.
     1271       do with frame Dialog-Frame
     1272       :
     1273         hide v-diasize-resize-button .
     1274         v-diasize-resize-button :row = 1.
     1275         v-diasize-resize-button :column = 1.
     1276       end.
     1277       if p-change-value > 0
     1278       then do:
     1279         if frame Dialog-Frame :scrollable = true
     1280         then do:
     1281           assign
     1282             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1283             no-error .
     1284           if error-status :error
     1285           or error-status :get-message(1) <> ""
     1286           then do:
     1287             undo move_block, retry move_block.
     1288           end.
     1289         end.
     1290         assign
     1291           frame Dialog-Frame :width = v-frame-width + p-change-value
     1292           no-error .
     1293         if error-status :error
     1294         or error-status :get-message(1) <> ""
     1295         then do:
     1296           undo move_block, retry move_block.
     1297         end.
     1298         assign
     1299           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1300         no-error .
     1301         if error-status :error
     1302         or error-status :get-message(1) <> ""
     1303         then do:
     1304           undo move_block, retry move_block.
     1305         end.
     1306         for each buf_temp-browse-handle
     1307           where buf_temp-browse-handle.browse-type = 'width':u
     1308         on error undo move_block, retry move_block
     1309         :
     1310           assign
     1311             buf_temp-browse-handle.browse-handle :width
     1312               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1313             no-error .
     1314           if error-status :error
     1315           or error-status :get-message(1) <> ""
     1316           then do:
     1317             undo move_block, retry move_block .
     1318           end.
     1319         end.
     1320         for each buf_temp-diasize-handle
     1321         on error undo move_block, retry move_block
     1322         :
     1323           assign
     1324             v-object-handle = buf_temp-diasize-handle.handle-value
     1325           .
     1326           if v-object-handle <> v-diasize-resize-button
     1327           then do:
     1328             assign
     1329               v-object-handle :col = v-object-handle :col + p-change-value
     1330               no-error .
     1331             if error-status :error
     1332             or error-status :get-message(1) <> ""
     1333             then do:
     1334               undo move_block, retry move_block .
     1335             end.
     1336           end.
     1337         end.
     1338       end.
     1339       else do:
     1340         for each buf_temp-diasize-handle
     1341         on error undo move_block, retry move_block
     1342         :
     1343           assign
     1344             v-object-handle = buf_temp-diasize-handle.handle-value
     1345           .
     1346           if v-object-handle <> v-diasize-resize-button
     1347           then do:
     1348             assign
     1349               v-object-handle :col = v-object-handle :col + p-change-value
     1350               no-error .
     1351             if error-status :error
     1352             or error-status :get-message(1) <> ""
     1353             then do:
     1354               undo move_block, retry move_block .
     1355             end.
     1356           end.
     1357         end.
     1358         for each buf_temp-browse-handle
     1359           where buf_temp-browse-handle.browse-type = 'width':u
     1360         on error undo move_block, retry move_block
     1361         :
     1362           assign
     1363             buf_temp-browse-handle.browse-handle :width
     1364               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1365             no-error .
     1366           if error-status :error
     1367           or error-status :get-message(1) <> ""
     1368           then do:
     1369             undo move_block, retry move_block .
     1370           end.
     1371         end.
     1372         assign
     1373           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1374           no-error .
     1375         if error-status :error
     1376         or error-status :get-message(1) <> ""
     1377         then do:
     1378           undo move_block, retry move_block.
     1379         end.
     1380         assign
     1381           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1382         no-error .
     1383         if error-status :error
     1384         or error-status :get-message(1) <> ""
     1385         then do:
     1386           undo move_block, retry move_block.
     1387         end.
     1388         if frame Dialog-Frame :scrollable = true
     1389         then do:
     1390           assign
     1391             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1392           no-error .
     1393           if error-status :error
     1394           or error-status :get-message(1) <> ""
     1395           then do:
     1396             undo move_block, retry move_block.
     1397           end.
     1398         end.
     1399       end.
     1400       if p-move-resize
     1401       then do:
     1402         run diasize_position-resize-button in this-procedure .
     1403       end.
     1404       if v-diasize-wndstore = true
     1405       then do:
     1406         if connected("ub") = true
     1407         then do:
     1408           define variable v-cntxt-db-num        as integer   no-undo .
     1409           define variable v-cntxt-userid        as character no-undo .
     1410           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1411                                             , OUTPUT v-cntxt-userid
     1412                                             ) .
     1413           run gbl/wndsizew.p
     1414             (input  v-cntxt-db-num
     1415             ,input  v-cntxt-userid
     1416             ,input  v-diasize-proc-name
     1417             ,input  'width':u
     1418             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1419             ) .
     1420         end.
     1421       end.
     1422     end.
     1423     assign
     1424       v-diasize-change-size = false
     1425     .
     1426   end procedure.
     1427   procedure diasize_set-width :
     1428     define input  parameter p-new-width  as decimal   no-undo .
     1429     define input  parameter p-move-resize as logical   no-undo .
     1430     do
     1431     on error undo, return error return-value
     1432     :
     1433       run diasize_change-width in this-procedure
     1434         (input  (p-new-width - frame Dialog-Frame :width)
     1435         ,input  p-move-resize
     1436         ) .
     1437     end.
     1438   end procedure.
     1439   procedure diasize_position-resize-button :
     1440     do with frame Dialog-Frame
     1441     :
     1442       hide v-diasize-resize-button .
     1443       assign
     1444         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1445                     - 1
     1446                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1447         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1448                     - 1
     1449                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1450       .
     1451       view v-diasize-resize-button .
     1452     end.
     1453   end procedure.
     1454   on alt-right anywhere
     1455   do:
     1456     run diasize_change-width in this-procedure
     1457       (input 1
     1458       ,input true
     1459       ) .
     1460     return no-apply .
     1461   end.
     1462   on alt-left anywhere
     1463   do:
     1464     run diasize_change-width in this-procedure
     1465       (input -1
     1466       ,input true
     1467       ) .
     1468     return no-apply .
     1469   end.
     1470   on alt-down anywhere
     1471   do:
     1472     run diasize_change-height in this-procedure
     1473       (input 1
     1474       ,input true
     1475       ) .
     1476     return no-apply .
     1477   end.
     1478   on alt-up anywhere
     1479   do:
     1480     run diasize_change-height in this-procedure
     1481       (input -1
     1482       ,input true
     1483       ) .
     1484     return no-apply .
     1485   end.
     1486   on alt-enter of frame Dialog-Frame
     1487   do:
     1488     run diasize_maximize in this-procedure
     1489       (input  ?
     1490       ).
     1491     return no-apply .
     1492   end.
     1493   procedure diasize_end-move :
     1494     do
     1495     on error undo, return error return-value
     1496     :
     1497       define variable v-row-delta as decimal   no-undo .
     1498       define variable v-col-delta as decimal   no-undo .
     1499       define variable v-new-row as decimal   no-undo .
     1500       define variable v-new-col as decimal   no-undo .
     1501       assign
     1502         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1503         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1504       .
     1505       assign
     1506         v-row-delta = v-new-row - frame Dialog-Frame :height
     1507         v-col-delta = v-new-col - frame Dialog-Frame :width
     1508       .
     1509       run diasize_change-height in this-procedure
     1510         (input v-row-delta
     1511         ,input true
     1512         ) .
     1513       run diasize_change-width in this-procedure
     1514         (input v-col-delta
     1515         ,input true
     1516         ) .
     1517     end.
     1518   end procedure.
     1519   procedure diasize_maximize :
     1520     define input  parameter p-action as logical   no-undo .
     1521     do
     1522     on error undo, return error return-value
     1523     :
     1524       if p-action = ?
     1525       then do:
     1526         if v-diasize-need-maximize = true
     1527         then do:
     1528           assign
     1529             p-action = true
     1530           .
     1531         end.
     1532         else do:
     1533           assign
     1534             p-action = false
     1535           .
     1536         end.
     1537       end.
     1538       if p-action = true
     1539       then do:
     1540         run diasize_change-height in this-procedure
     1541           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1542               - frame Dialog-Frame :height-chars
     1543           ,input true
     1544           ) .
     1545         run diasize_change-width in this-procedure
     1546           (input session :width-chars
     1547               - frame Dialog-Frame :width-chars
     1548           ,input true
     1549           ) .
     1550         assign
     1551           v-diasize-need-maximize = false
     1552         .
     1553       end.
     1554       else do:
     1555         run diasize_change-width in this-procedure
     1556           (input v-diasize-orig-frame-width
     1557               - frame Dialog-Frame :width-chars
     1558           ,input true
     1559           ) .
     1560         run diasize_change-height in this-procedure
     1561           (input v-diasize-orig-frame-height
     1562               - frame Dialog-Frame :height-chars
     1563           ,input true
     1564           ) .
     1565         assign
     1566           v-diasize-need-maximize = true
     1567         .
     1568       end.
     1569     end.
     1570   end procedure.
     1571   procedure diasize_restore-orig-size :
     1572     do
     1573     on error undo, return error return-value
     1574     :
     1575       assign
     1576         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1577         v-diasize-current-frame-height = frame Dialog-Frame :height
     1578       .
     1579       run diasize_set-height in this-procedure
     1580         (input  v-diasize-orig-frame-height
     1581         ,input  true
     1582         ) .
     1583       run diasize_set-width in this-procedure
     1584         (input  v-diasize-orig-frame-width
     1585         ,input  true
     1586         ) .
     1587     end.
     1588   end procedure.
     1589   procedure diasize_restore-current-size :
     1590     do
     1591     on error undo, return error return-value
     1592     :
     1593       run diasize_set-height in this-procedure
     1594         (input  v-diasize-current-frame-height
     1595         ,input  true
     1596         ) .
     1597       run diasize_set-width in this-procedure
     1598         (input  v-diasize-current-frame-width
     1599         ,input  true
     1600         ) .
     1601     end.
     1602   end procedure.
     1603   procedure diasize_set-browse-handle :
     1604     define input  parameter p-browse-handle as handle   no-undo .
     1605     define buffer buf_temp-browse-handle for temp-browse-handle .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609       assign
     1610         v-diasize-browse-handle = p-browse-handle
     1611       .
     1612       for each buf_temp-browse-handle
     1613       on error undo, return error return-value
     1614       :
     1615         delete buf_temp-browse-handle .
     1616       end.
     1617     end.
     1618   end procedure.
     1619   procedure diasize_add_browse :
     1620     define input  parameter p-browse-type   as character no-undo .
     1621     define input  parameter p-browse-handle as handle    no-undo .
     1622     define buffer buf_temp-browse-handle for temp-browse-handle .
     1623     do
     1624     on error undo, return error return-value
     1625     :
     1626       assign
     1627         v-diasize-browse-number = v-diasize-browse-number + 1
     1628       .
     1629       create buf_temp-browse-handle .
     1630       assign
     1631         buf_temp-browse-handle.browse-type   = p-browse-type
     1632         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1633         buf_temp-browse-handle.browse-handle = p-browse-handle
     1634       .
     1635     end.
     1636   end procedure.
     1637   procedure diasize_init :
     1638     define variable v-default-value    as logical   no-undo .
     1639     define variable v-restore-saved    as logical   no-undo .
     1640     define variable v-resize-value-str as character no-undo .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644       do with frame Dialog-Frame
     1645       :
     1646         assign
     1647           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1648           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1649           v-diasize-browse-handle     = browse BR-dtl :handle
     1650         .
     1651         create button v-diasize-resize-button
     1652         assign
     1653           parent        = frame Dialog-Frame :first-child
     1654           label         = "s"
     1655           height-pixels = 16
     1656           width-pixels  = 16
     1657           visible       = true
     1658           sensitive     = true
     1659           movable       = true
     1660           triggers:
     1661             on end-move persistent run diasize_end-move in this-procedure .
     1662           end triggers.
     1663         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1664         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1665         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1666         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1667         assign
     1668           v-diasize-wndmax = false
     1669         .
     1670         if connected("ub") = true
     1671         then do:
     1672           define variable v-cntxt-db-num        as integer   no-undo .
     1673           define variable v-cntxt-userid        as character no-undo .
     1674           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1675                                             , OUTPUT v-cntxt-userid
     1676                                             ) .
     1677           run gbl/wndpar_r.p
     1678             (input  v-cntxt-db-num
     1679             ,input  v-cntxt-userid
     1680             ,input  'wndmax':U
     1681             ,output v-diasize-wndmax
     1682             ,output v-default-value
     1683             ) .
     1684         end.
     1685         assign
     1686           v-diasize-wndstore = false
     1687         .
     1688         if connected("ub") = true
     1689         then do:
     1690           run gbl/wndpar_r.p
     1691             (input  v-cntxt-db-num
     1692             ,input  v-cntxt-userid
     1693             ,input  'wndstore':U
     1694             ,output v-diasize-wndstore
     1695             ,output v-default-value
     1696             ) .
     1697         end.
     1698         assign
     1699           v-diasize-proc-name = entry(1, program-name(2), '.')
     1700         .
     1701         if v-diasize-wndstore = true
     1702         then do:
     1703           assign
     1704             v-restore-saved = false
     1705           .
     1706           if connected("ub") = true
     1707           then do:
     1708             run gbl/wndsizer.p
     1709               (input  v-cntxt-db-num
     1710               ,input  v-cntxt-userid
     1711               ,input  v-diasize-proc-name
     1712               ,input  'height':u
     1713               ,output v-resize-value-str
     1714               ) .
     1715             if v-resize-value-str <> '':U
     1716             then do:
     1717               run diasize_change-height in this-procedure
     1718                 (input  integer(v-resize-value-str)
     1719                 ,input  true
     1720                 ) .
     1721               assign
     1722                 v-restore-saved = true
     1723               .
     1724             end.
     1725           end.
     1726           if connected("ub") = true
     1727           then do:
     1728             run gbl/wndsizer.p
     1729               (input  v-cntxt-db-num
     1730               ,input  v-cntxt-userid
     1731               ,input  v-diasize-proc-name
     1732               ,input  'width':u
     1733               ,output v-resize-value-str
     1734               ) .
     1735             if v-resize-value-str <> '':U
     1736             then do:
     1737               run diasize_change-width in this-procedure
     1738                 (input  integer(v-resize-value-str)
     1739                 ,input  true
     1740                 ) .
     1741               assign
     1742                 v-restore-saved = true
     1743               .
     1744             end.
     1745           end.
     1746           if v-restore-saved <> true
     1747           then do:
     1748             if v-diasize-wndmax = true
     1749             then do:
     1750               run diasize_maximize in this-procedure
     1751                 (input  true
     1752                 ) .
     1753             end.
     1754           end.
     1755         end.
     1756         else do:
     1757           if v-diasize-wndmax = true
     1758           then do:
     1759             run diasize_maximize in this-procedure
     1760               (input  true
     1761               ) .
     1762           end.
     1763         end.
     1764       end.
     1765     end.
     1766   end procedure.
     1767   procedure diasize_need-full-display :
     1768     define output parameter p-need-full-display as logical   no-undo .
     1769     do
     1770     on error undo, return error return-value
     1771     :
     1772       assign
     1773         p-need-full-display = v-diasize-need-full-display
     1774       .
     1775       assign
     1776         v-diasize-need-full-display = false
     1777       .
     1778     end.
     1779   end procedure.
     1780   procedure get-context :
     1781      define output parameter p-db-num as integer          no-undo.
     1782      define output parameter p-user-id as character        no-undo.
     1783      define variable v-login               as character    no-undo.
     1784      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1785      define buffer buf_user-login  for ub.user-login .
     1786      do
     1787      on error undo, return error
     1788      :
     1789            FIND FIRST buf_sys-ctrl no-lock.
     1790            ASSIGN
     1791               v-login = USERID("ub")
     1792               p-db-num = buf_sys-ctrl.db-num
     1793            .
     1794            FIND FIRST buf_user-login
     1795                 WHERE buf_user-login.db-num = p-db-num
     1796                   AND buf_user-login.user-login = v-login
     1797                 no-lock
     1798                 no-error
     1799                 .
     1800            IF AVAILABLE buf_user-login
     1801            THEN DO:
     1802               assign
     1803                  p-user-id = buf_user-login.user-id
     1804               .
     1805            END.
     1806      end.
     1807   end procedure.
     1808       run diasize_init in this-procedure .
     1809   MAIN-BLOCK:
     1810   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1811      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1812   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1813     run mainmenu_getcntxt in parparentproc
     1814       (output v-cntxt-db-num
     1815       ,output v-cntxt-userid
     1816       ,output v-cntxt-level
     1817       ,output v-cntxt-host-code-obj
     1818       ,output v-cntxt-obj-type
     1819       ,output v-cntxt-obj-code
     1820       ,output v-cntxt-db-num-obj
     1821       ,output v-cntxt-is-admin
     1822       ) .
     1823     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
     1824         message vss-workfile vss-revision vss-description skip
     1825                     "Неверный параметр вызова par-mode"
     1826         view-as alert-box ERROR.
     1827         return error.
     1828     end.
     1829     if par-mode = 'ПРОСМОТР':U then do:
     1830           FIND FIRST buf_wth-line No-LOCK WHERE
     1831                      recid(buf_wth-line) = parline-rec No-ERROR.
     1832     end.
     1833     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     1834           FIND FIRST buf_wth-line EXCLUSIVE-LOCK WHERE
     1835                      recid(buf_wth-line) = parline-rec NO-WAIT No-ERROR.
     1836         IF LOCKED buf_wth-line then do:
     1837           message
     1838           vss-workfile vss-revision vss-description skip
     1839           "Занята запись строки документа движения МЦ"
     1840           view-as alert-box.
     1841           return error.
     1842         end.
     1843         IF NOT avail buf_wth-line then do:
     1844           message
     1845           vss-workfile vss-revision vss-description skip
     1846           "Не найдена строка документа движения МЦ"
     1847           view-as alert-box.
     1848           return error.
     1849         end.
     1850     assign
     1851     pardoc-code = buf_wth-line.doc-code
     1852     parwth-code = buf_wth-line.wth-code
     1853     parbef-sum = buf_wth-line.bef-sum
     1854     paraft-sum = buf_wth-line.aft-sum
     1855     pardoc-sum = buf_wth-line.doc-sum
     1856     parfact-sum = buf_wth-line.fact-sum
     1857     .
     1858     end.
     1859     FIND FIRST buf_wth-doc No-LOCK WHERE
     1860                buf_wth-doc.doc-code = pardoc-code No-ERROR.
     1861     IF NOT AVAIL buf_wth-doc THEN DO:
     1862       MESSAGE  "Не найден документ движения МЦ"
     1863       VIEW-AS ALERT-BOX ERROR.
     1864       RETURN error.
     1865     END.
     1866     if par-mode = 'ИЗМЕНЕНИЕ':U and buf_wth-doc.status_ = 'факт':U then do:
     1867          message "Документ движения МЦ с N" buf_wth-doc.doc-code  "имеет статус" buf_wth-doc.status_ SKIP
     1868                         "Изменения не допускаются"
     1869           view-as alert-box error.
     1870           return error.
     1871     end.
     1872     if LOOKUP(buf_wth-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u) = 0 then do:
     1873       MESSAGE
     1874       vss-workfile vss-revision vss-description skip
     1875       "Неверный вызов - документ МЦ имеет тип" buf_wth-doc.doc-type
     1876       VIEW-AS ALERT-BOX ERROR.
     1877       RETURN error.
     1878     end.
     1879     vardoc-status_ = buf_wth-doc.status_.
     1880     FIND FIRST buf_wealth No-LOCK WHERE
     1881                 buf_wealth.wth-code = parwth-code NO-ERROR.
     1882     IF NOT AVAIL buf_wealth THEN DO:
     1883         MESSAGE
     1884           "Не найдена материальная ценность в справочнике!"
     1885         VIEW-AS ALERT-BOX ERROR.
     1886         RETURN error.
     1887     END.
     1888     run fill-tables in this-Procedure no-error.
     1889     if error-status:error then return error.
     1890     RUN Myenable.
     1891     WAIT-FOR GO OF FRAME Dialog-Frame.
     1892   END.
     1893   RUN disable_UI.
     1894   PROCEDURE disable_UI :
     1895     HIDE FRAME Dialog-Frame.
     1896   END PROCEDURE.
     1897   PROCEDURE enable_UI :
     1898     OPEN QUERY Dialog-Frame FOR EACH buf_wth-line SHARE-LOCK.
     1899     GET FIRST Dialog-Frame.
     1900     DISPLAY for-d_doc-sum for-d_fact-sum
     1901         WITH FRAME Dialog-Frame.
     1902     IF AVAILABLE ub.wth-line THEN
     1903       DISPLAY ub.wth-line.doc-sum ub.wth-line.fact-sum
     1904         WITH FRAME Dialog-Frame.
     1905     ENABLE B-exit b-quit B-par B-Help BR-dtl ub.wth-line.doc-sum ub.wth-line.fact-sum
     1906            for-d_doc-sum for-d_fact-sum
     1907         WITH FRAME Dialog-Frame.
     1908     VIEW FRAME Dialog-Frame.
     1909   END PROCEDURE.
     1910   PROCEDURE fill-tables :
     1911   if not can-find(first tt-par-dtl) then do:
     1912       FOR EACH ub.wth-par NO-LOCK WHERE
     1913                ub.wth-par.wth-code = buf_wealth.wth-code :
     1914         FIND FIRST tt-par-dtl WHERE
     1915                    tt-par-dtl.par-code = ub.wth-par.par-code NO-ERROR.
     1916         IF NOT AVAIL tt-par-dtl THEN DO:
     1917           CREATE tt-par-dtl.
     1918           ASSIGN
     1919             tt-par-dtl.wth-code = ub.wth-par.wth-code
     1920             tt-par-dtl.w-p-code = parw-p-code
     1921             tt-par-dtl.doc-code = pardoc-code
     1922             tt-par-dtl.par-code = ub.wth-par.par-code
     1923             tt-par-dtl.par-val  = ub.wth-par.par-val
     1924             tt-par-dtl.par-unit = ub.wth-par.par-unit
     1925             tt-par-dtl.par-feat = ub.wth-par.par-feat
     1926             tt-par-dtl.par-rate = ub.wth-par.par-rate
     1927             tt-par-dtl.q-ty-doc = 0
     1928             tt-par-dtl.doc-sum  = 0
     1929             tt-par-dtl.q-ty-fact = 0
     1930             tt-par-dtl.fact-sum  = 0
     1931          .
     1932         END.
     1933       END.
     1934       FOR EACH ub.wth-dtl NO-LOCK WHERE
     1935               ub.wth-dtl.doc-code = pardoc-code AND
     1936               ub.wth-dtl.wth-code = parwth-code AND
     1937               ub.wth-dtl.w-p-code = parw-p-code
     1938       BY
     1939       ub.wth-dtl.par-code :
     1940         FIND FIRST tt-par-dtl WHERE
     1941                    tt-par-dtl.par-code = ub.wth-dtl.par-code NO-ERROR.
     1942         IF NOT AVAIL tt-par-dtl THEN DO:
     1943           NEXT.
     1944         END.
     1945         IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1946           ASSIGN
     1947           tt-par-dtl.doc-sum = ub.wth-dtl.bef-sum
     1948           tt-par-dtl.fact-sum = ub.wth-dtl.aft-sum
     1949           .
     1950         END.
     1951         ELSE DO:
     1952         buffer-copy ub.wth-dtl using doc-sum fact-sum sum-gds-rubl sum-gds-base price-rubl price-base gds-code to tt-par-dtl.
     1953         END.
     1954         ASSIGN
     1955         tt-par-dtl.q-ty-doc = tt-par-dtl.doc-sum / tt-par-dtl.par-rate
     1956         tt-par-dtl.q-ty-fact = tt-par-dtl.fact-sum / tt-par-dtl.par-rate
     1957         d_doc-sum    = d_doc-sum   + tt-par-dtl.doc-sum
     1958         d_fact-sum   = d_fact-sum   + tt-par-dtl.fact-sum
     1959         .
     1960       END.
     1961   end.
     1962   else do:
     1963     for each tt-par-dtl no-lock:
     1964         ASSIGN
     1965         d_doc-sum   = d_doc-sum      + tt-par-dtl.doc-sum
     1966         d_fact-sum   = d_fact-sum      + tt-par-dtl.fact-sum
     1967         .
     1968     end.
     1969   end.
     1970   END PROCEDURE.
     1971   PROCEDURE MyEnable :
     1972   tt-par-dtl.q-ty-doc:label-BGCOLOR IN BROWSE BR-dtl = 15.
     1973   tt-par-dtl.q-ty-fact:label-BGCOLOR IN BROWSE BR-dtl = 15.
     1974   IF par-mode = 'ПРОСМОТР':U THEN DO:
     1975     ASSIGN
     1976     tt-par-dtl.q-ty-doc:READ-ONLY IN BROWSE BR-dtl = YES
     1977     tt-par-dtl.q-ty-fact:READ-ONLY IN BROWSE BR-dtl = YES
     1978     tt-par-dtl.q-ty-doc:label-BGCOLOR IN BROWSE BR-dtl = ?
     1979     tt-par-dtl.q-ty-fact:label-BGCOLOR IN BROWSE BR-dtl = ?
     1980       .
     1981     b-quit:label in frame Dialog-Frame  = 'Выход'.
     1982   END.
     1983     ASSIGN FRAME Dialog-Frame:TITLE = 'Детализация по номиналам. МЦ ' + CAPS( buf_wealth.wth-name ).
     1984     DISPLAY
     1985     d_doc-sum @ for-d_doc-sum
     1986     d_fact-sum @ for-d_fact-sum
     1987     WITH FRAME Dialog-Frame.
     1988     DISPLAY
     1989     pardoc-sum @ ub.wth-line.doc-sum
     1990     parfact-sum @ ub.wth-line.fact-sum
     1991     WITH FRAME Dialog-Frame.
     1992     ENABLE
     1993     b-quit
     1994     b-help
     1995     B-Par
     1996     BR-dtl
     1997     WITH FRAME Dialog-Frame.
     1998     IF par-mode <> 'ПРОСМОТР':U THEN DO:
     1999       ENABLE
     2000       b-exit
     2001       WITH FRAME Dialog-Frame.
     2002     END.
     2003    if buf_wth-doc.doc-type = 'декл':U then do:
     2004       HIDE
     2005       wth-line.fact-sum
     2006       for-d_fact-sum
     2007       in frame Dialog-Frame .
     2008       assign
     2009       tt-par-dtl.q-ty-fact:visible in browse br-dtl = no
     2010       tt-par-dtl.fact-sum:visible in browse br-dtl = no
     2011       .
     2012     end.
     2013     if buf_wealth.is-ser = 1 then do:
     2014         tt-par-dtl.q-ty-doc:READ-ONLY IN BROWSE BR-dtl = YES.
     2015         tt-par-dtl.q-ty-fact:READ-ONLY IN BROWSE BR-dtl = YES.
     2016         tt-par-dtl.q-ty-doc:label-BGCOLOR IN BROWSE BR-dtl = ?.
     2017         tt-par-dtl.q-ty-fact:label-BGCOLOR IN BROWSE BR-dtl = ?.
     2018         enable b-parts with frame Dialog-Frame.
     2019     end.
     2020     else do:
     2021         if buf_wth-doc.doc-type = 'при':U and buf_wth-doc.exter_ = no and par-mode <> 'ПРОСМОТР':U then do:
     2022                tt-par-dtl.q-ty-doc:READ-ONLY IN BROWSE BR-dtl = YES.
     2023                tt-par-dtl.q-ty-doc:label-BGCOLOR IN BROWSE BR-dtl = ?.
     2024         end.
     2025         else  if buf_wth-doc.status_ =  'накл':U then dO:
     2026               tt-par-dtl.q-ty-fact:READ-ONLY IN BROWSE BR-dtl = YES.
     2027               tt-par-dtl.q-ty-fact:label-BGCOLOR IN BROWSE BR-dtl = ?.
     2028               HIDE
     2029               wth-line.fact-sum
     2030               for-d_fact-sum
     2031               in frame Dialog-Frame .
     2032           end.
     2033     end.
     2034     VIEW FRAME Dialog-Frame .
     2035     OPEN QUERY BR-dtl FOR EACH tt-par-dtl USE-INDEX tt-i1.
     2036   END PROCEDURE.
