      366       ,input  buf_wth-doc.obj-type
      367       ,input  buf_wth-doc.obj-code
      368       ,input  0
      369       ,input  0
      370       ,input  0
      371       ,input  true
      372       ,output glog
      373       )  .
      374   end.
      375       end.
      376       when 'ПРОСМОТР':U  then do:
      377   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   do:
      379     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      380       (input  v-cntxt-db-num
      381       ,input  v-cntxt-userid
      382       ,input  0
      383       ,input  'actn_wth-doc_lookup':U
      384       ,input  'object':U
