      182   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   define variable v-waitfram-action01         as character   no-undo .
      184   define variable v-waitfram-action02         as character   no-undo .
      185   define variable v-waitfram-action03         as character   no-undo .
      186   define variable mWaitFramTextBeg            as character   no-undo.
      187   define variable mWaitFramTextEnd            as character   no-undo.
      188   define variable mWaitFramView               as logical     no-undo.
      189   define variable mWaitProcEvent              as logical     no-undo init yes.
      190   define variable mWaitFramInterval           as integer     no-undo init 1 .
      191   define variable mWaitFramStop               as logical     no-undo.
      192   define variable mWaitFramStopUser           as logical     no-undo.
      193   define variable mWaitFramStopTimeOut        as logical     no-undo.
      194   define variable mWaitFramStartProc          as datetime-tz no-undo.
      195   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      196   define button B-WaitFramStop auto-end-key
      197        label "Стоп"
      198        size 10 by 1 tooltip "Остоновить процесс".
      199   define button B-viewProcInfo
      200        label "Информация"
      201        size 15 by 1 tooltip "Информация о процесс".
      202   define frame waitfram
      203     v-waitfram-action01 format "x(72)" no-label skip
      204     v-waitfram-action02 format "x(72)" no-label skip
      205     v-waitfram-action03 format "x(72)" no-label skip
      206     B-viewProcInfo
      207     B-WaitFramStop at row 4 col 30
      208     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      209     .
      210   define new global shared variable mBatchMode as logical no-undo init ?.
      211   define variable mFramBachModHandle as handle no-undo.
      212   mFramBachModHandle = frame waitfram:handle.
      213   define variable mFameOldVis as logical no-undo.
      214   define variable mVisCUrentVin as logical no-undo.
      215   if session:batch-mode
      216   then
      217      mBatchMode = yes.
      218   if mBatchMode = ? then do:
      219     mVisCUrentVin = current-window:visible.
      220     mFameOldVis = mFramBachModHandle:visible.
      221     mFramBachModHandle:visible  = yes.
      222     mBatchMode = mFramBachModHandle:visible ne yes.
      223     mFramBachModHandle:visible = mFameOldVis.
      224     current-window:visible = mVisCUrentVin.
      225   end.
      226    if  log-manager:logfile-name ne ?
      227     then DO:
      228         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      229         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      230         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      231     end.
      232   on choose of B-WaitFramStop in frame waitfram
      233   do:
      234     mWaitFramStop = yes.
      235     mWaitFramStopUser = yes.
      236   end.
      237   function waitfram-check-timeout returns logical():
      238      define variable vtime as int64 no-undo.
      239      if mWaitFramStopTimeOut
      240      then
      241         return yes.
      242      vtime = ( now - mWaitFramStartProc ) / 1000 .
      243      if     mWaitFramTimeOut ne ?
      244         and mWaitFramTimeOut ne 0
      245         and mWaitFramTimeOut lt vtime
      246      then do:
      247         mWaitFramStopTimeOut = yes.
      248      end.
      249      return mWaitFramStopTimeOut.
      250   end.
      251   procedure waitfram-hide :
      252     if not session:batch-mode
      253     then do
      254     on error undo, return error return-value
      255     :
      256       pause 0 before-hide .
      257       if not mBatchMode then
      258         hide frame waitfram .
      259     if     not mWaitFramView
      260        and mWaitProcEvent
      261     then
      262       process events .
      263     end.
      264   end procedure.
      265   procedure waitfram-show :
      266     define input  parameter p-message as character no-undo .
      267     define variable v-left-margin as integer   no-undo .
      268     if not session:batch-mode
      269     then do
      270     on error undo, return error return-value
      271     :
      272       if length(p-message) <= 70 then do:
      273         assign
      274           v-left-margin = integer((70 - length(p-message)) / 2)
      275         .
      276         assign
      277           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      278         .
      279         assign
      280           v-waitfram-action01 = " "
      281           v-waitfram-action02 = " "
      282                                    + fill(" ", v-left-margin)
      283                                    + p-message
      284           v-waitfram-action03 = " "
      285         .
      286       end.
      287       else do:
      288         define variable vRindex1 as integer no-undo.
      289         define variable vRindex2 as integer no-undo.
      290         vRindex1 = r-index(p-message," ",70).
      291         if vRindex1 = 0
      292         then
      293            vRindex1 = 70.
      294         if length(p-message)  <= vRindex1 + 70 then do:
      295           assign
      296             v-waitfram-action01 = " "
      297             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      298             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      299           .
      300         end.
      301         else do:
      302           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      303           if vRindex2 <= vRindex1
      304           then
      305              vRindex2 = vRindex1 + 70.
      306           assign
      307             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      308             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      309             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      310           .
      311         end.
      312       end.
      313       B-viewProcInfo:visible   in frame waitfram = no.
      314       B-viewProcInfo:sensitive in frame waitfram = no.
      315       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      316       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      317       if  (   mWaitFramView
      318          or  mWaitProcEvent)
      319          and not mBatchMode
      320       then
      321          display
      322             v-waitfram-action01 skip
      323             v-waitfram-action02 skip
      324             v-waitfram-action03 skip
      325          with frame waitfram .
      326       if     mWaitFramView
      327          then do:
      328             if     mWaitFramInterval ne ?
      329                and not mBatchMode
      330             then
      331                wait-for go of frame waitfram pause mWaitFramInterval.
      332          end.
      333          else
      334             if     mWaitProcEvent
      335                and not mBatchMode
      336             then
      337                process events .
      338     end.
      339   end procedure.
      340      procedure waitfram-show-this:
      341         define input  parameter iInterval as int64 no-undo.
      342         define variable vtime as int64 no-undo.
      343         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      344         mWaitFramInterval = iInterval.
      345         run waitfram-show (substitute("&1&2 &3&4" ,
      346                                       mWaitFramTextBeg ,
      347                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      348                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      349                                       mWaitFramTextEnd
      350                                      )
      351                           ).
      352      end.
      353      procedure WaitFramRunPause:
      354         define input  parameter iInterval as dec no-undo.
      355         define variable vStart  as datetime-tz no-undo.
      356         define variable vend    as datetime-tz no-undo.
      357         define variable vint as int64 no-undo.
      358         define variable vOk as logical no-undo.
      359         vStart = now.
      360         vend   = vStart.
      361         publish "WaitFramPause" (iInterval,output vOk).
      362         vend   =  now.
      363         vint = vend - vStart.
      364         vint = iInterval - vint / 1000.
      365         if     not mWaitFramStop
      366            and (   vint > 0
      367                 or (    not vOk
      368                     and iInterval eq ?
      369                     )
      370                 )
      371         then
      372            run waitfram-show-this (iInterval).
      373         vend   =  now.
      374         vint = vend - vStart.
      375         vint = iInterval - vint / 1000.
      376         if     not mWaitFramStop
      377            and vint > 0
      378         then do:
      379            run gbl/pause.p (vint * 1000).
      380         end.
      381         if iInterval ne ?
      382         then
      383            publish "WaitFramStop".
      384         waitfram-check-timeout().
      385      end.
      386      procedure WaitFramWaitFor:
      387         define input  parameter iInterval as dec no-undo.
      388         assign
      389            mWaitFramStartProc   = now
      390            mWaitFramStopUser    = no
      391            mWaitFramStopTimeOut = no
      392         .
      393         block-wait:
      394         do while not mWaitFramStop:
      395            run WaitFramRunPause (iInterval).
      396            if  waitfram-check-timeout()
      397            then do:
      398               leave block-wait.
      399            end.
      400         end.
      401         run waitfram-hide.
      402      end.
      403   procedure waitfram-join :
      404     define input  parameter p-line-1  as character no-undo .
      405     define input  parameter p-line-2  as character no-undo .
      406     define input  parameter p-line-3  as character no-undo .
      407     define output parameter p-message as character no-undo .
      408     do
      409     on error undo, return error return-value
      410     :
      411       assign
      412         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      413                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      414                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      415       .
      416     end.
      417   end procedure.
      418   function waitfram-join-function returns character
      419     (input p-line-1 as character
      420     ,input p-line-2 as character
      421     ,input p-line-3 as character
      422     ).
      423     define variable v-message as character no-undo .
      424     run waitfram-join in this-procedure
      425       (input  p-line-1
      426       ,input  p-line-2
      427       ,input  p-line-3
      428       ,output v-message
      429       ) .
      430     return v-message .
      431   end function .
      432   define temp-table loc-in-bc no-undo like in-bc.
      433   define work-table file-inv
      434   field file-name as character format "x(256)".
      435   define variable scan-txt as character no-undo.
      436   define variable scan-name as character no-undo.
      437   define variable is-err as logical no-undo.
      438   define stream inv.
      439   define stream log.
      440   define stream err.
      441   define variable i as integer no-undo.
      442   define variable rec-file as recid.
      443   define variable last-file as character no-undo.
      444   define variable flag-save as logical initial yes no-undo.
      445   define variable b-c     as character        no-undo.
      446   define variable rate     like ub.doc-line.cli-base-rate no-undo.
      447   define variable ret-mode as character no-undo.
      448   define variable add-scan as logical initial no no-undo.
      449   define variable bar-str  like ub.prod-bc.b-str  no-undo.
      450   define variable varlog  as logical no-undo.
      451   define variable line-rec as recid no-undo .
      452   define buffer t-doc for ub.trn-doc  .
      453   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   procedure cur-time :
      455      define output parameter p-today as date      no-undo .
      456      define output parameter p-time  as integer   no-undo .
      457     do
      458     on error undo, return error
      459     :
      460       define variable v-date1 as date      no-undo .
      461       define variable v-date2 as date      no-undo .
      462       define variable v-time  as integer   no-undo .
      463       assign
      464         v-date1 = today
      465         v-time  = time
      466         v-date2 = today
      467       .
      468       if v-date1 <> v-date2
      469       then do:
      470         assign
      471           v-date1 = today
      472           v-time  = v-time
      473         .
      474       end.
      475       assign
      476         p-today = v-date1
      477         p-time  = v-time
      478       .
      479     end.
      480   end.
      481   function cur-time-date returns character
      482   :
      483     return string(today, '99/99/9999':U) .
      484   end.
      485   function cur-time-mjd returns decimal
      486   :
      487     define variable v-date as date      no-undo .
      488     define variable v-time as integer   no-undo .
      489     run cur-time in this-procedure
      490       (output v-date
      491       ,output v-time
      492       ) .
      493     return integer(v-date) - 2400002 + (v-time / 86400) .
      494   end.
      495   function cur-time-get-ending-index returns integer
      496   (input p-number as integer
      497   )
      498   :
      499     if p-number < 0
      500     or p-number = ?
      501     then do:
      502       return 1 .
      503     end.
      504     define variable v-rest as integer   no-undo .
      505     assign
      506       p-number = p-number modulo 100
      507     .
      508     if p-number < 20
      509     then do:
      510       assign
      511         v-rest = p-number
      512       .
      513     end.
      514     else do:
      515       assign
      516         v-rest = p-number modulo 10
      517       .
      518     end.
      519     case v-rest :
      520       when 1
      521       then do:
      522         return 2 .
      523       end.
      524       when 2 or
      525       when 3 or
      526       when 4
      527       then do:
      528         return 3 .
      529       end.
      530       otherwise do:
      531         return 1 .
      532       end.
      533     end case .
      534   end.
      535   procedure cur-time-mjd-to-date :
      536      define input  parameter i-mjd-diff as decimal no-undo.
      537      define output parameter o-Date     as date    no-undo.
      538      define output parameter o-Time     as integer no-undo.
      539      define variable v-day-number as integer   no-undo .
      540      if    i-mjd-diff < 0
      541         or i-mjd-diff = ?
      542      then do:
      543         return "?" .
      544      end.
      545      assign
      546         v-day-number = truncate(i-mjd-diff,0).
      547         o-Date = date(v-day-number + 2400002).
      548         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      549     .
      550   end.
      551   function cur-time-mjd-to-string returns character
      552   (input p-mjd-diff as decimal
      553   )
      554   :
      555     define variable v-day-number as integer   no-undo .
      556     define variable v-seconds    as integer   no-undo .
      557     define variable v-hour       as integer   no-undo .
      558     define variable v-min        as integer   no-undo .
      559     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      560     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      561     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      562     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      563     if p-mjd-diff < 0
      564     or p-mjd-diff = ?
      565     then do:
      566       return "?" .
      567     end.
      568     assign
      569       v-day-number = integer(truncate(p-mjd-diff,0))
      570       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      571     .
      572     if v-seconds > 86400
      573     then do:
      574       assign
      575         v-seconds = 86400 - 1
      576       .
      577     end.
      578     if v-seconds < 0
      579     then do:
      580       assign
      581         v-seconds = 0
      582       .
      583     end.
      584     assign
      585       v-hour = truncate(v-seconds / 3600, 0)
      586     .
      587     assign
      588       v-seconds = v-seconds modulo 3600
      589     .
      590     assign
      591       v-min = truncate(v-seconds / 60, 0)
      592     .
      593     assign
      594       v-seconds = v-seconds modulo 60
      595     .
      596     return
      597         (if v-day-number <> 0
      598           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      599           else ""
      600         )
      601       + (if v-day-number <> 0 or v-hour <> 0
      602           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      603           else ""
      604         )
      605       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      606           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      607           else ""
      608         )
      609       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      610       .
      611   end.
      612   function cur-time-string returns character
      613   :
      614     define variable v-date as date      no-undo .
      615     define variable v-time as integer   no-undo .
      616     run cur-time in this-procedure
      617       (output v-date
      618       ,output v-time
      619       ) .
      620     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      621   end.
      622   function cur-time-string-sec returns character
      623   :
      624     define variable v-date as date      no-undo .
      625     define variable v-time as integer   no-undo .
      626     run cur-time in this-procedure
      627       (output v-date
      628       ,output v-time
      629       ) .
      630     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      631   end.
      632   function cur-time-custom  returns character
      633   (input p-prefix as character
      634   ,input p-date-format as character
      635   ,input p-delimiter as character
      636   ,input p-time-format as character
      637   ,input p-suffix as character
      638   )
      639   :
      640     define variable v-date as date      no-undo .
      641     define variable v-time as integer   no-undo .
      642     run cur-time in this-procedure
      643       (output v-date
      644       ,output v-time
      645       ) .
      646     return
      647       p-prefix
      648       + string(v-date, p-date-format)
      649       + p-delimiter
      650       + string(v-time, p-time-format)
      651       + p-suffix
      652       .
      653   end.
      654   function cur-time-print  returns character
      655   :
      656     define variable v-date as date      no-undo .
      657     define variable v-time as integer   no-undo .
      658     run cur-time in this-procedure
      659       (output v-date
      660       ,output v-time
      661       ) .
      662     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      663   end.
      664   function cur-time-datetime returns datetime
      665   :
      666     define variable v-char as character no-undo .
      667     define variable v-datetime as datetime no-undo .
      668     v-char = cur-time-string().
      669     v-datetime = datetime(v-char).
      670     return  v-datetime.
      671   end.
      672   function cur-time-string-msec returns character
      673   :
      674     define variable v-date as datetime  no-undo .
      675     v-date = now.
      676     return string(v-date) .
      677   end.
      678   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679     define variable v-cntxt-db-num        as integer   no-undo .
      680     define variable v-cntxt-userid        as character no-undo .
      681     define variable v-cntxt-level         as character no-undo .
      682     define variable v-cntxt-host-code-obj as integer   no-undo .
      683     define variable v-cntxt-obj-type      as character no-undo .
      684     define variable v-cntxt-obj-code      as integer   no-undo .
      685     define variable v-cntxt-db-num-obj    as integer   no-undo .
      686     define variable v-cntxt-is-admin      as logical   no-undo .
      687   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      688     run mainmenu_getcntxt in parparentproc
      689       (output v-cntxt-db-num
      690       ,output v-cntxt-userid
      691       ,output v-cntxt-level
      692       ,output v-cntxt-host-code-obj
      693       ,output v-cntxt-obj-type
      694       ,output v-cntxt-obj-code
      695       ,output v-cntxt-db-num-obj
      696       ,output v-cntxt-is-admin
      697       ) .
      698   DEFINE BUTTON b-add
      699        LABEL "&Добавить"
      700        SIZE 10 BY 1.13
      701        BGCOLOR 8 .
      702   DEFINE BUTTON b-bc
      703        LABEL "Бар-Код"
      704        SIZE 10 BY 1.13
      705        BGCOLOR 8 .
      706   DEFINE BUTTON b-exit AUTO-GO
      707        LABEL "&Выход "
      708        SIZE 10 BY 1.13
      709        BGCOLOR 8 .
      710   DEFINE BUTTON b-help
      711        LABEL "Помо&щь"
      712        SIZE 10 BY 1.13
      713        BGCOLOR 8 .
      714   DEFINE BUTTON b-inf
      715        LABEL "&Информация"
      716        SIZE 10.88 BY .96
      717        BGCOLOR 8 .
      718   DEFINE BUTTON b-save
      719        LABEL "Сох&ранить"
      720        SIZE 10 BY 1.13
      721        BGCOLOR 8 .
      722   DEFINE BUTTON b-undo
      723        LABEL "В&ернуть"
      724        SIZE 10 BY 1.13
      725        BGCOLOR 8 .
      726   DEFINE VARIABLE vardes-anlz AS CHARACTER
      727        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      728        SIZE 32.63 BY 3.63 NO-UNDO.
      729   DEFINE VARIABLE vardes-in AS CHARACTER
      730        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      731        SIZE 33 BY 3.63 NO-UNDO.
      732   DEFINE VARIABLE vardes-un AS CHARACTER
      733        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      734        SIZE 32.88 BY 3.63 NO-UNDO.
      735   DEFINE VARIABLE varerr-msg-anlz AS CHARACTER
      736        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      737        SIZE 32.75 BY 1.29 NO-UNDO.
      738   DEFINE VARIABLE varerr-msg-in AS CHARACTER
      739        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      740        SIZE 33 BY 1.29 NO-UNDO.
      741   DEFINE VARIABLE varerr-msg-un AS CHARACTER
      742        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      743        SIZE 32.88 BY 1.29 NO-UNDO.
      744   DEFINE QUERY b-anlz-bc FOR
      745         anlz-bc,
      746         main-bc SCROLLING.
      747   DEFINE QUERY b-file FOR
      748         file-inv SCROLLING.
      749   DEFINE QUERY b-in-bc FOR
      750         in-bc SCROLLING.
      751   DEFINE QUERY b-un-bc FOR
      752         un-bc SCROLLING.
      753   DEFINE BROWSE b-anlz-bc
      754     QUERY b-anlz-bc DISPLAY
      755         main-bc.b-c column-label "Основной бар-код"  format ">>>>>>>>>>>>9"
      756   anlz-bc.scn-qnty column-label "Количество" format ">>,>>>,>>9.999"
      757   anlz-bc.scn-pl column-label "Место"  format "x(14)"
      758   anlz-bc.rez column-label "Рез" format "x(3)"
      759   enable anlz-bc.scn-qnty anlz-bc.scn-pl
      760       WITH NO-ROW-MARKERS SEPARATORS SIZE 64 BY 6.96.
      761   DEFINE BROWSE b-file
      762     QUERY b-file DISPLAY
      763         file-inv.file-name column-label "Файлы"
      764       WITH NO-ROW-MARKERS SIZE 18.75 BY 6.54.
      765   DEFINE BROWSE b-in-bc
      766     QUERY b-in-bc DISPLAY
      767         in-bc.bar-str  column-label "Строка" format "x(25)"
      768   in-bc.bar-code column-label "Бар-код" format "x(13)"
      769   in-bc.rez      column-label "Рез" format "x(3)"
      770       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.5 BY 6.67.
      771   DEFINE BROWSE b-un-bc
      772     QUERY b-un-bc DISPLAY
      773         un-bc.bar-code column-label "Бар-код" format "x(13)"
      774   un-bc.b-c column-label "Собств.бар-код" format ">>>>>>>>>>>>9"
      775   un-bc.scn-qnty column-label "Всего" format ">>,>>>,>>9.999"
      776   un-bc.file-qnty column-label "Файл" format ">>,>>>,>>9.999"
      777   un-bc.rez column-label "Рез" format "x(3)"
      778   un-bc.scn-pl column-label "Место" format "x(13)"
      779       WITH NO-ROW-MARKERS SEPARATORS SIZE 64 BY 7.04.
      780   DEFINE FRAME d-scn-inv
      781        b-exit AT ROW 1.38 COL 1.5
      782        b-save AT ROW 1.38 COL 11.63
      783        b-add AT ROW 1.38 COL 21.75
      784        b-undo AT ROW 1.38 COL 31.88
      785        b-bc AT ROW 1.38 COL 42.13
      786        b-help AT ROW 1.38 COL 52.5
      787        b-in-bc AT ROW 2.58 COL 19.75
      788        b-file AT ROW 2.71 COL 1.25
      789        varerr-msg-in AT ROW 2.96 COL 65.38 NO-LABEL
      790        vardes-in AT ROW 5.13 COL 65.38 NO-LABEL
      791        b-un-bc AT ROW 9.33 COL 1.25
      792        b-inf AT ROW 9.33 COL 65.63
      793        varerr-msg-un AT ROW 10.42 COL 65.5 NO-LABEL
      794        vardes-un AT ROW 12.54 COL 65.5 NO-LABEL
      795        b-anlz-bc AT ROW 16.42 COL 1.25
      796        varerr-msg-anlz AT ROW 17.29 COL 65.63 NO-LABEL
      797        vardes-anlz AT ROW 19.63 COL 65.75 NO-LABEL
      798        "Описание" VIEW-AS TEXT
      799             SIZE 8.88 BY .75 AT ROW 4.38 COL 75.63
      800        "Ошибки" VIEW-AS TEXT
      801             SIZE 6.88 BY .79 AT ROW 16.38 COL 76.75
      802        "Ошибки" VIEW-AS TEXT
      803             SIZE 6.88 BY .79 AT ROW 9.46 COL 77
      804        "Описание" VIEW-AS TEXT
      805             SIZE 8.88 BY .75 AT ROW 11.75 COL 76.38
      806        "Описание" VIEW-AS TEXT
      807             SIZE 8.88 BY .75 AT ROW 18.75 COL 76.5
      808        "Ошибки" VIEW-AS TEXT
      809             SIZE 6.88 BY .79 AT ROW 2.08 COL 75.63
      810        SPACE(16.11) SKIP(20.58)
      811       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      812            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      813            TITLE "Файл сканера -> Файл инвентаризации".
      814   ASSIGN
      815          FRAME d-scn-inv:SCROLLABLE       = FALSE
      816          FRAME d-scn-inv:HIDDEN           = TRUE.
      817   ASSIGN
      818          vardes-anlz:READ-ONLY IN FRAME d-scn-inv        = TRUE.
      819   ASSIGN
      820          vardes-in:READ-ONLY IN FRAME d-scn-inv        = TRUE.
      821   ASSIGN
      822          vardes-un:READ-ONLY IN FRAME d-scn-inv        = TRUE.
      823   ASSIGN
      824          varerr-msg-anlz:READ-ONLY IN FRAME d-scn-inv        = TRUE.
      825   ASSIGN
      826          varerr-msg-in:READ-ONLY IN FRAME d-scn-inv        = TRUE.
      827   ASSIGN
      828          varerr-msg-un:READ-ONLY IN FRAME d-scn-inv        = TRUE.
      829   ON WINDOW-CLOSE OF FRAME d-scn-inv
      830   DO:
      831     APPLY "END-ERROR":U TO SELF.
      832   END.
      833   ON CHOOSE OF b-add IN FRAME d-scn-inv
      834   DO:
      835   system-dialog get-file scan-txt
      836     title "Выберите файл со сканера"
      837          filters "WorkAbout MS15" "*.dbs",
      838                    "WorkAbout" "*.imp",
      839                    "Инвентр" "*.inv",
      840                    "Все файлы" "*.*"
      841          update varlog.
      842   if not varlog then return.
      843   if entry (2, scan-txt, ".") = "err" then do:
      844     message "Файл с расширением '.err' не может быть обработан. Переименуйте его.".
      845     return no-apply.
      846   end.
      847   scan-name = entry (1, scan-txt, ".").
      848   output stream log to value(scan-name + ".log").
      849   output stream err to value(scan-name + ".err").
      850   run waitfram-show in this-procedure
      851     (input "Разбор файла: " + scan-txt + "     ЖДИТЕ..."
      852     ).
      853   create file-inv.
      854   assign file-inv.file-name = scan-txt.
      855   last-file = scan-txt.
      856   flag-save = no.
      857   rec-file = recid(file-inv).
      858   for each in-bc :
      859     delete in-bc.
      860   end.
      861   run str/bc-anlz.p (parparentproc, "file", scan-txt, yes, output is-err, output table in-bc) no-error.
      862   FOR EACH in-bc:
      863       if in-bc.rez = "ERR" then DO:
      864          put stream log unformatted in-bc.err-msg skip.
      865          put stream err unformatted in-bc.bar-str skip.
      866          ASSIGN is-err = YES.
      867       END.
      868       put stream log unformatted in-bc.des.
      869   END.
      870   FOR EACH un-bc:
      871       if un-bc.rez = "ERR" THEN DO:
      872          put stream log unformatted un-bc.err-msg skip.
      873          put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
      874          ASSIGN is-err = YES.
      875       END.
      876       put stream log unformatted un-bc.des skip.
      877   END.
      878   run waitfram-hide in this-procedure .
      879   run enable_UI in this-procedure .
      880   reposition b-file to recid rec-file.
      881   run loc-val-chg in this-procedure .
      882   output stream log close.
      883   output stream err close.
      884   END.
      885   ON ROW-DISPLAY OF b-anlz-bc IN FRAME d-scn-inv
      886   DO:
      887     if available anlz-bc then do:
      888        IF anlz-bc.upd-line THEN
      889           ASSIGN anlz-bc.scn-qnty:BGCOLOR IN BROWSE b-anlz-bc = 3.
      890     end.
      891   END.
      892   ON ROW-LEAVE OF b-anlz-bc IN FRAME d-scn-inv
      893   DO:
      894   if available anlz-bc and anlz-bc.upd-line = no then do:
      895     if input browse b-anlz-bc anlz-bc.scn-qnty <> ""
      896     then do:
      897        assign anlz-bc.upd-line = yes.
      898        if b-anlz-bc:refresh() then.
      899     end.
      900   end.
      901   END.
      902   ON VALUE-CHANGED OF b-anlz-bc IN FRAME d-scn-inv
      903   DO:
      904   if available anlz-bc then
      905     ASSIGN vardes-anlz = anlz-bc.des
      906            varerr-msg-anlz = anlz-bc.err-msg.
      907   else
      908     ASSIGN vardes-anlz = ""
      909            varerr-msg-anlz = "".
      910   display vardes-anlz varerr-msg-anlz with frame d-scn-inv.
      911   END.
      912   ON CHOOSE OF b-bc IN FRAME d-scn-inv
      913   DO:
      914    REPEAT:
      915      run str/chs-bc.w (
      916      input parparentproc,
      917      input "",
      918      input ?,
      919      input ?,
      920      input  YES,
      921      output       b-c,
      922      output       rate,
      923      output       ret-mode,
      924      input-output add-scan,
      925      input-output bar-str) no-error.
      926      if error-status:error or b-c = ? THEN LEAVE.
      927      run str/bc-anlz.p (parparentproc, if add-scan then "code-add" else "code-update", string(b-c), yes, output is-err, output table in-bc) no-error.
      928      if error-status:error then do:
      929         message "Неверный анализ бар-кода."
      930         view-as alert-box.
      931         return no-apply.
      932      end.
      933      find first in-bc.
      934      create file-inv.
      935      assign file-inv.file-name = in-bc.bar-str
      936             last-file = in-bc.bar-str
      937             flag-save = no
      938             rec-file = recid(file-inv).
      939      run enable_ui in this-procedure .
      940      find first un-bc where un-bc.bar-code = in-bc.bar-code no-error.
      941      if available un-bc then do:
      942         REPOSITION b-un-bc TO RECID RECID(un-bc).
      943         find first anlz-bc where anlz-bc.b-c = un-bc.b-c no-error.
      944         if available anlz-bc then do:
      945            REPOSITION b-anlz-bc TO RECID RECID(anlz-bc).
      946            if not add-scan then do:
      947               apply "entry" to browse b-anlz-bc.
      948               apply "entry" to anlz-bc.scn-qnty in browse b-anlz-bc.
      949            end.
      950         end.
      951      end.
      952      run loc-val-chg in this-procedure .
      953      reposition b-file to recid rec-file.
      954      if not add-scan then leave.
      955    END.
      956   END.
      957   ON CHOOSE OF b-exit IN FRAME d-scn-inv
      958   DO:
      959     varlog = no.
      960     if flag-save = no and can-find (first anlz-bc) then
      961        message "Вы хотите выйти ничего не сохранив?"
      962        view-as alert-box question button yes-no update varlog.
      963     else
      964        message "Выход?"
      965        view-as alert-box question button yes-no update varlog.
      966     if varlog <> yes then return no-apply.
      967   END.
      968   ON VALUE-CHANGED OF b-in-bc IN FRAME d-scn-inv
      969   DO:
      970   if available in-bc then
      971     ASSIGN vardes-in = in-bc.des
      972            varerr-msg-in = in-bc.err-msg.
      973   else
      974     ASSIGN vardes-in = ""
      975            varerr-msg-in = "".
      976     display vardes-in varerr-msg-in with frame d-scn-inv.
      977   END.
      978   ON CHOOSE OF b-inf IN FRAME d-scn-inv
      979   DO:
      980     if available un-bc then do:
      981       run str/bc-inf.w (
      982                      input parparentproc
      983                     ,input v-cntxt-obj-type
      984                     ,input v-cntxt-obj-code
      985                     ,input RECID(un-bc)
      986                     ,output table loc-in-bc).
      987     end.
      988     else do:
      989         message "Неправильно выбран бар-код" view-as alert-box.
      990         return no-apply.
      991     end.
      992   END.
      993   ON CHOOSE OF b-save IN FRAME d-scn-inv
      994   DO:
      995   scan-txt = scan-name + ".inv".
      996   system-dialog get-file scan-txt
      997     filters "Файл инвентаризации *.inv" "*.inv"
      998     ask-overwrite
      999     save-as
     1000     use-filename
     1001     update varlog
     1002     default-extension "inv".
     1003   scan-name = entry (1, scan-txt, ".").
     1004   if not varlog then return no-apply.
     1005   run waitfram-show in this-procedure
     1006     (input "Запись файла: " + scan-txt + "     ЖДИТЕ..."
     1007     ).
     1008   output stream inv to value (scan-txt).
     1009   output stream log to value (scan-name + ".log") append.
     1010   output stream err to value (scan-name + ".err") append.
     1011   put stream log unformatted "  " skip.
     1012   put stream log unformatted cur-time-string-sec() skip.
     1013   put stream log unformatted " " skip skip "!!! -> Файл Инвентаризации: " + scan-txt skip skip.
     1014   for each anlz-bc ,
     1015       first main-bc where anlz-bc.nm = main-bc.nm
     1016       :
     1017     i = i + 1.
     1018     if i modulo 25 = 0 then
     1019       run waitfram-show in this-procedure
     1020         (input "Запись файла: " + scan-txt + "     Записано: " + string (i)
     1021         ).
     1022       put stream inv unformatted
     1023             string(main-bc.b-c) + minimum (", ", string (anlz-bc.scn-qnty)) + string (anlz-bc.scn-qnty) + minimum (", ", string(anlz-bc.scn-pl)) + string(anlz-bc.scn-pl) skip.
     1024       put stream log unformatted
     1025             "Код: " main-bc.b-c " Количество: " anlz-bc.scn-qnty skip.
     1026   end.
     1027   flag-save = yes.
     1028   output stream inv close.
     1029   output stream log close.
     1030   output stream err close.
     1031   run waitfram-hide in this-procedure .
     1032   if p-recid <> ? then do:
     1033      find first t-doc no-lock where recid(t-doc) = p-recid  .
     1034      message substitute("Закачать информацию по кодам в документ инвентаризации &1 ?" , t-doc.doc-code)
     1035              view-as alert-box question
     1036              buttons yes-no
     1037              update v-log as logical
     1038              .
     1039      if v-log = true then do:
     1040         if t-doc.status_ =  'накл':U and
     1041            t-doc.flag_   <> yes     then do:
     1042            run str/use-list.p (input parparentproc, input-output line-rec, input p-recid , input NO , input  (buffer anlz-bc:handle) ).
     1043         end.
     1044         else do:
     1045            run str/scan.p ( input parparentproc, input no , input p-recid , input scan-txt ).
     1046         end.
     1047      end.
     1048   end.
     1049   END.
     1050   ON VALUE-CHANGED OF b-un-bc IN FRAME d-scn-inv
     1051   DO:
     1052   if available un-bc then
     1053      ASSIGN vardes-un = un-bc.des
     1054            varerr-msg-un = un-bc.err-msg.
     1055   else
     1056      ASSIGN vardes-un = ""
     1057            varerr-msg-un = "".
     1058   display vardes-un varerr-msg-un with frame d-scn-inv.
     1059   END.
     1060   ON CHOOSE OF b-undo IN FRAME d-scn-inv
     1061   DO:
     1062   if last-file <> "" then do:
     1063      varlog = no.
     1064      message "Отменить добавление последнего файла и вернуть предыдущее состояние?"
     1065              view-as alert-box question buttons OK-Cancel update varlog.
     1066      if not varlog then return no-apply.
     1067      run str/bc-anlz.p (parparentproc, "undo", ?, yes, output is-err, output table in-bc).
     1068      find last file-inv where file-inv.file-name = last-file.
     1069      delete file-inv.
     1070      run enable_UI in this-procedure .
     1071      run loc-val-chg in this-procedure .
     1072      last-file = "".
     1073      flag-save = no.
     1074   end.
     1075   else do:
     1076     message "Возможен откат лишь одного файла." skip
     1077             "После последней очистки не был загружен ни один файл."
     1078     view-as alert-box error.
     1079     return no-apply.
     1080   end.
     1081   END.
     1082   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-scn-inv:PARENT eq ?
     1083   THEN FRAME d-scn-inv:PARENT = ACTIVE-WINDOW.
     1084   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1085   on help of frame d-scn-inv
     1086   do:
     1087     run gbl/app_help.p
     1088       (input this-procedure :file-name
     1089       ,input ''
     1090       ,input ?
     1091       ) no-error.
     1092     if error-status :error then do:
     1093       message
     1094         "Ошибка при вызове помощи"
     1095         error-status :get-message(1)
     1096         view-as alert-box .
     1097     end.
     1098   end.
     1099   run minbtn-set in this-procedure .
     1100   on choose of b-help in frame d-scn-inv
     1101   do:
     1102     apply "help":u to frame d-scn-inv .
     1103   end.
     1104   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   procedure minbtn-set :
     1106       do
     1107           on error undo, return error return-value
     1108           :
     1109           define variable ii              as integer       no-undo .
     1110           define variable fh              as widget-handle no-undo .
     1111           define variable hh              as widget-handle no-undo .
     1112           define variable v-h             as handle        extent 4 no-undo .
     1113           define variable v-name-button   as character     no-undo .
     1114           define variable v-help-old-x    as decimal       no-undo .
     1115           define variable v-help-old-y    as decimal       no-undo .
     1116           define variable v-help-old-size as decimal       no-undo .
     1117           define variable v-frame-width   as decimal       no-undo .
     1118           define variable jj              as integer       no-undo .
     1119           do
     1120               on error undo, return error
     1121               :
     1122               assign
     1123                   v-frame-width = frame d-scn-inv:width - 0.3
     1124                   fh            = frame d-scn-inv:first-child
     1125                   hh            = fh:first-child
     1126                   ii            = 1
     1127                   .
     1128               do while valid-handle(hh):
     1129                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1130                   do:
     1131                       case lc(hh:name) :
     1132                           when "b-help" then
     1133                               do:
     1134                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1135                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1136                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1137                                   hh:TOOLTIP = "Помощь" .
     1138                                   v-help-old-x = hh:column .
     1139                                   v-help-old-y = hh:row    .
     1140                                   v-help-old-size = hh:width .
     1141                                   hh:width-chars = 2.5 .
     1142                               end.
     1143                           when "b-print" then
     1144                               do:
     1145                                   hh:load-image("cmp/b-print.bmp":u) .
     1146                                   hh:TOOLTIP = "Печать" .
     1147                                   v-h[ii] = hh:handle .
     1148                                   ii = ii + 1 .
     1149                                   hh:width-chars = 3 .
     1150                               end.
     1151                           when "b-history" or
     1152                           when "b-hist" then
     1153                               do:
     1154                                   hh:load-image("cmp/b-hist.bmp":u) .
     1155                                   hh:TOOLTIP = "История" .
     1156                                   v-h[ii] = hh:handle .
     1157                                   ii = ii + 1 .
     1158                                   hh:width-chars = 3 .
     1159                               end.
     1160                           when "b-sch" then
     1161                               do:
     1162                                   hh:load-image("cmp/b-sch.bmp":u) .
     1163                                   hh:TOOLTIP = "Установка Фильтра" .
     1164                                   v-h[ii] = hh:handle .
     1165                                   ii = ii + 1 .
     1166                                   hh:width-chars = 3 .
     1167                               end.
     1168                           when "b-hist-user" then
     1169                               do:
     1170                                   hh:load-image("cmp/b-hist.bmp":u) .
     1171                                   hh:TOOLTIP = "История пользователя" .
     1172                                   ii = ii + 1 .
     1173                               end.
     1174                       end case.
     1175                   end.
     1176                   hh = hh:next-sibling.
     1177               end.
     1178               b-help:column = v-frame-width - b-help:width-chars.
     1179               jj = 0.
     1180               repeat ii = 4 to 1 by -1 :
     1181                   if valid-handle (v-h[ii] ) then
     1182                   do:
     1183                       jj  = jj + 1 .
     1184                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1185                       v-h[ii]:row    = v-help-old-y .
     1186                   end.
     1187               end.
     1188           end.
     1189       end.
     1190   end procedure.
     1191   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1192   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1193   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1194   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1195   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1196   define variable v-diasize-current-frame-height as decimal   no-undo .
     1197   define variable v-diasize-change-size          as logical   no-undo .
     1198   define variable v-diasize-resize-button        as handle    no-undo .
     1199   define variable v-diasize-wndmax               as logical   no-undo .
     1200   define variable v-diasize-wndstore             as logical   no-undo .
     1201   define variable v-diasize-proc-name            as character no-undo .
     1202   define variable v-diasize-browse-handle        as handle    no-undo .
     1203   define variable v-diasize-browse-number        as integer   no-undo .
     1204   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1205   define temp-table temp-diasize-handle no-undo
     1206     field handle-value  as handle
     1207     field save-position as decimal
     1208     index xpk is primary unique handle-value
     1209     .
     1210   define temp-table temp-browse-handle no-undo
     1211     field browse-type   as character
     1212     field browse-number as integer
     1213     field browse-handle as handle
     1214     field original-size as decimal
     1215     index xpk is primary unique browse-type browse-number
     1216     index xie browse-type browse-handle
     1217   .
     1218   procedure diasize_change-height :
     1219     define input  parameter p-change-value  as decimal   no-undo .
     1220     define input  parameter p-move-resize   as logical   no-undo .
     1221     define variable v-field-group-handle    as handle    no-undo .
     1222     define variable v-object-handle         as handle    no-undo .
     1223     define variable v-frame-height          as decimal   no-undo .
     1224     define variable v-frame-virtual-height  as decimal   no-undo .
     1225     define variable v-browse-height         as decimal   no-undo .
     1226     define variable v-window-height         as decimal   no-undo .
     1227     define variable v-window-virtual-height as decimal   no-undo .
     1228     define variable v-change-sign           as integer   no-undo .
     1229     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1230     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1231     if p-change-value > 0
     1232     then do:
     1233       if frame d-scn-inv :height + p-change-value
     1234           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1235       then do:
     1236         assign
     1237           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1238                           - (frame d-scn-inv :height-chars)
     1239         .
     1240         if p-change-value <= 0
     1241         then do:
     1242           run diasize_position-resize-button in this-procedure .
     1243           return .
     1244         end.
     1245       end.
     1246     end.
     1247     if p-change-value < 0
     1248     then do:
     1249       if frame d-scn-inv :height + p-change-value < v-diasize-orig-frame-height
     1250       then do:
     1251         assign
     1252           p-change-value = v-diasize-orig-frame-height
     1253                          - (frame d-scn-inv :height-chars)
     1254         .
     1255         if p-change-value >= 0
     1256         then do:
     1257           run diasize_position-resize-button in this-procedure .
     1258           return .
     1259         end.
     1260       end.
     1261     end.
     1262     if p-change-value >= 0
     1263     then do:
     1264       assign
     1265         v-change-sign = 1
     1266       .
     1267     end.
     1268     else do:
     1269       assign
     1270         v-change-sign = -1
     1271       .
     1272     end.
     1273     assign
     1274       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1275     .
     1276     if p-change-value = 0
     1277     then do:
     1278       run diasize_position-resize-button in this-procedure .
     1279       return .
     1280     end.
     1281     move_block:
     1282     do
     1283     on error undo move_block, retry move_block
     1284     :
     1285       if retry
     1286       then do:
     1287         do
     1288         on error undo move_block, leave move_block
     1289         :
     1290           if p-change-value > 0
     1291           then do:
     1292             for each buf_temp-diasize-handle
     1293             on error undo, next
     1294             :
     1295               assign
     1296                 v-object-handle = buf_temp-diasize-handle.handle-value
     1297               .
     1298               if v-object-handle <> v-diasize-resize-button
     1299               then do:
     1300                 assign
     1301                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1302                 .
     1303               end.
     1304             end.
     1305             assign
     1306               v-diasize-browse-handle :height = v-browse-height
     1307             .
     1308             for each buf_temp-browse-handle
     1309               where buf_temp-browse-handle.browse-type = 'height':u
     1310             on error undo, next
     1311             :
     1312               assign
     1313                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1314               .
     1315             end.
     1316             assign
     1317               frame d-scn-inv :height = v-frame-height
     1318             .
     1319             if frame d-scn-inv :scrollable = true
     1320             then do:
     1321               assign
     1322                 frame d-scn-inv :virtual-height = v-frame-virtual-height
     1323               .
     1324             end.
     1325             run diasize_position-resize-button in this-procedure .
     1326           end.
     1327           else do:
     1328             if frame d-scn-inv :scrollable = true
     1329             then do:
     1330               assign
     1331                 frame d-scn-inv :virtual-height = v-frame-virtual-height
     1332               .
     1333             end.
     1334             assign
     1335               frame d-scn-inv :height = v-frame-height
     1336             .
     1337             assign
     1338               v-diasize-browse-handle :height = v-browse-height
     1339             .
     1340             for each buf_temp-browse-handle
     1341               where buf_temp-browse-handle.browse-type = 'height':u
     1342             on error undo, next
     1343             :
     1344               assign
     1345                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1346               .
     1347             end.
     1348             for each buf_temp-diasize-handle
     1349             on error undo, next
     1350             :
     1351               assign
     1352                 v-object-handle = buf_temp-diasize-handle.handle-value
     1353               .
     1354               if v-object-handle <> v-diasize-resize-button
     1355               then do:
     1356                 assign
     1357                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1358                 .
     1359               end.
     1360             end.
     1361             run diasize_position-resize-button in this-procedure .
     1362           end.
     1363           assign
     1364             v-diasize-change-size = false
     1365           .
     1366           leave move_block .
     1367         end.
     1368       end.
     1369       assign
     1370         v-diasize-need-full-display = true
     1371       .
     1372       if v-diasize-change-size = false
     1373       then do:
     1374         assign
     1375           v-diasize-change-size = true
     1376         .
     1377       end.
     1378       else do:
     1379         return .
     1380       end.
     1381       assign
     1382         v-frame-height = frame d-scn-inv :height
     1383         v-frame-virtual-height = frame d-scn-inv :virtual-height
     1384         v-browse-height = v-diasize-browse-handle :height
     1385       .
     1386       for each buf_temp-browse-handle
     1387         where buf_temp-browse-handle.browse-type = 'height':u
     1388       :
     1389         assign
     1390           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1391         .
     1392       end.
     1393       for each buf_temp-diasize-handle
     1394       :
     1395         delete buf_temp-diasize-handle .
     1396       end.
     1397       assign
     1398         v-field-group-handle = frame d-scn-inv :first-child
     1399       .
     1400       do while valid-handle(v-field-group-handle)
     1401       :
     1402         assign
     1403           v-object-handle = v-field-group-handle :first-child
     1404         .
     1405         do while valid-handle(v-object-handle)
     1406         :
     1407           if  v-object-handle <> v-diasize-browse-handle :handle
     1408           and can-query(v-object-handle, "row")
     1409           and can-query(v-object-handle, "height")
     1410           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1411           then do:
     1412             find first buf_temp-browse-handle
     1413               where buf_temp-browse-handle.browse-type   = 'height':u
     1414                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1415               no-error .
     1416             if available buf_temp-browse-handle
     1417             then do:
     1418             end.
     1419             else do:
     1420               create buf_temp-diasize-handle .
     1421               assign
     1422                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1423                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1424               .
     1425             end.
     1426           end.
     1427           assign
     1428             v-object-handle = v-object-handle :next-sibling
     1429           .
     1430         end.
     1431         assign
     1432           v-field-group-handle = v-field-group-handle :next-sibling
     1433         .
     1434       end.
     1435       do with frame d-scn-inv
     1436       :
     1437         hide v-diasize-resize-button .
     1438         assign
     1439           v-diasize-resize-button :row    = 1
     1440           v-diasize-resize-button :column = 1
     1441         .
     1442       end.
     1443       if p-change-value > 0
     1444       then do:
     1445         if frame d-scn-inv :scrollable = true
     1446         then do:
     1447           assign
     1448             frame d-scn-inv :virtual-height = frame d-scn-inv :virtual-height + p-change-value
     1449             no-error .
     1450           if error-status :error
     1451           or error-status :get-message(1) <> ""
     1452           then do:
     1453             undo move_block, retry move_block .
     1454           end.
     1455         end.
     1456         assign
     1457           frame d-scn-inv :height = frame d-scn-inv :height + p-change-value
     1458           no-error .
     1459         if error-status :error
     1460         or error-status :get-message(1) <> ""
     1461         then do:
     1462           undo move_block, retry move_block .
     1463         end.
     1464         assign
     1465           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1466           no-error .
     1467         if error-status :error
     1468         or error-status :get-message(1) <> ""
     1469         then do:
     1470           undo move_block, retry move_block .
     1471         end.
     1472         for each buf_temp-browse-handle
     1473           where buf_temp-browse-handle.browse-type = 'height':u
     1474         on error undo move_block, retry move_block
     1475         :
     1476           assign
     1477             buf_temp-browse-handle.browse-handle :height
     1478               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1479             no-error .
     1480           if error-status :error
     1481           or error-status :get-message(1) <> ""
     1482           then do:
     1483             undo move_block, retry move_block .
     1484           end.
     1485         end.
     1486         for each buf_temp-diasize-handle
     1487         on error undo move_block, retry move_block
     1488         :
     1489           assign
     1490             v-object-handle = buf_temp-diasize-handle.handle-value
     1491           .
     1492           if v-object-handle <> v-diasize-resize-button
     1493           then do:
     1494             assign
     1495               v-object-handle :row = v-object-handle :row + p-change-value
     1496               no-error .
     1497             if error-status :error
     1498             or error-status :get-message(1) <> ""
     1499             then do:
     1500               undo move_block, retry move_block .
     1501             end.
     1502           end.
     1503         end.
     1504       end.
     1505       else do:
     1506         for each buf_temp-diasize-handle
     1507         on error undo move_block, retry move_block
     1508         :
     1509           assign
     1510             v-object-handle = buf_temp-diasize-handle.handle-value
     1511           .
     1512           if v-object-handle <> v-diasize-resize-button
     1513           then do:
     1514             assign
     1515               v-object-handle :row = v-object-handle :row + p-change-value
     1516               no-error .
     1517             if error-status :error
     1518             or error-status :get-message(1) <> ""
     1519             then do:
     1520               undo move_block, retry move_block .
     1521             end.
     1522           end.
     1523         end.
     1524         assign
     1525           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1526           no-error .
     1527         if error-status :error
     1528         or error-status :get-message(1) <> ""
     1529         then do:
     1530           undo move_block, retry move_block .
     1531         end.
     1532         for each buf_temp-browse-handle
     1533           where buf_temp-browse-handle.browse-type = 'height':u
     1534         on error undo move_block, retry move_block
     1535         :
     1536           assign
     1537             buf_temp-browse-handle.browse-handle :height
     1538               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1539             no-error .
     1540           if error-status :error
     1541           or error-status :get-message(1) <> ""
     1542           then do:
     1543             undo move_block, retry move_block .
     1544           end.
     1545         end.
     1546         assign
     1547           frame d-scn-inv :height = frame d-scn-inv :height + p-change-value
     1548           no-error .
     1549         if error-status :error
     1550         or error-status :get-message(1) <> ""
     1551         then do:
     1552           undo move_block, retry move_block .
     1553         end.
     1554         if frame d-scn-inv :scrollable = true
     1555         then do:
     1556           assign
     1557             frame d-scn-inv :virtual-height = frame d-scn-inv :virtual-height + p-change-value
     1558             no-error .
     1559           if error-status :error
     1560           or error-status :get-message(1) <> ""
     1561           then do:
     1562             undo move_block, retry move_block .
     1563           end.
     1564         end.
     1565       end.
     1566       if p-move-resize = true
     1567       then do:
     1568         run diasize_position-resize-button in this-procedure .
     1569       end.
     1570       if v-diasize-wndstore = true
     1571       then do:
     1572         if connected("ub") = true
     1573         then do:
     1574           define variable v-cntxt-db-num        as integer   no-undo .
     1575           define variable v-cntxt-userid        as character no-undo .
     1576           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1577                                             , OUTPUT v-cntxt-userid
     1578                                             ) .
     1579           run gbl/wndsizew.p
     1580             (input  v-cntxt-db-num
     1581             ,input  v-cntxt-userid
     1582             ,input  v-diasize-proc-name
     1583             ,input  'height':u
     1584             ,input  string(frame d-scn-inv :height - v-diasize-orig-frame-height)
     1585             ) .
     1586         end.
     1587       end.
     1588     end.
     1589     assign
     1590       v-diasize-change-size = false
     1591     .
     1592   end procedure.
     1593   procedure diasize_set-height :
     1594     define input  parameter p-new-height  as decimal   no-undo .
     1595     define input  parameter p-move-resize as logical   no-undo .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       run diasize_change-height in this-procedure
     1600         (input  (p-new-height - frame d-scn-inv :height)
     1601         ,input  p-move-resize
     1602         ) .
     1603     end.
     1604   end procedure.
     1605   procedure diasize_change-width :
     1606     define input  parameter p-change-value as decimal   no-undo .
     1607     define input  parameter p-move-resize  as logical   no-undo .
     1608     define variable v-field-group-handle   as handle    no-undo .
     1609     define variable v-object-handle        as handle    no-undo .
     1610     define variable v-frame-width          as decimal   no-undo .
     1611     define variable v-frame-virtual-width  as decimal   no-undo .
     1612     define variable v-browse-width         as decimal   no-undo .
     1613     define variable v-window-width         as decimal   no-undo .
     1614     define variable v-window-virtual-width as decimal   no-undo .
     1615     define variable v-change-sign          as integer   no-undo .
     1616     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1617     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1618     if p-change-value > 0
     1619     then do:
     1620       if frame d-scn-inv :width + p-change-value >
     1621           session :width-chars
     1622       then do:
     1623         assign
     1624           p-change-value = session :width-chars - frame d-scn-inv :width
     1625         .
     1626         if p-change-value <= 0
     1627         then do:
     1628           run diasize_position-resize-button in this-procedure .
     1629           return .
     1630         end.
     1631       end.
     1632     end.
     1633     if p-change-value < 0
     1634     then do:
     1635       if frame d-scn-inv :width + p-change-value < v-diasize-orig-frame-width
     1636       then do:
     1637         assign
     1638           p-change-value = v-diasize-orig-frame-width
     1639                          - frame d-scn-inv :width
     1640         .
     1641         if p-change-value >= 0
     1642         then do:
     1643           run diasize_position-resize-button in this-procedure .
     1644           return .
     1645         end.
     1646       end.
     1647     end.
     1648     if p-change-value >= 0
     1649     then do:
     1650       assign
     1651         v-change-sign = 1
     1652       .
     1653     end.
     1654     else do:
     1655       assign
     1656         v-change-sign = -1
     1657       .
     1658     end.
     1659     assign
     1660       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1661     .
     1662     if p-change-value = 0
     1663     then do:
     1664       run diasize_position-resize-button in this-procedure .
     1665       return .
     1666     end.
     1667     move_block:
     1668     do
     1669     on error undo move_block, leave move_block
     1670     :
     1671       if retry
     1672       then do:
     1673         do
     1674         on error undo move_block, leave move_block
     1675         :
     1676           if p-change-value > 0
     1677           then do:
     1678             for each buf_temp-diasize-handle
     1679             on error undo, next
     1680             :
     1681               assign
     1682                 v-object-handle = buf_temp-diasize-handle.handle-value
     1683               .
     1684               if v-object-handle <> v-diasize-resize-button
     1685               then do:
     1686                 assign
     1687                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1688                 .
     1689               end.
     1690             end.
     1691             assign
     1692               v-diasize-browse-handle :width = v-browse-width
     1693             .
     1694             for each buf_temp-browse-handle
     1695               where buf_temp-browse-handle.browse-type = 'width':u
     1696             on error undo, next
     1697             :
     1698               assign
     1699                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1700               .
     1701             end.
     1702             assign
     1703               frame d-scn-inv :width = v-frame-width
     1704             .
     1705             if frame d-scn-inv :scrollable = true
     1706             then do:
     1707               assign
     1708                 frame d-scn-inv :virtual-width = v-frame-virtual-width
     1709               .
     1710             end.
     1711             run diasize_position-resize-button in this-procedure .
     1712           end.
     1713           else do:
     1714             if frame d-scn-inv :scrollable = true
     1715             then do:
     1716               assign
     1717                 frame d-scn-inv :virtual-width = v-frame-virtual-width
     1718               .
     1719             end.
     1720             assign
     1721               frame d-scn-inv :width = v-frame-width
     1722             .
     1723             for each buf_temp-browse-handle
     1724               where buf_temp-browse-handle.browse-type = 'width':u
     1725             on error undo, next
     1726             :
     1727               assign
     1728                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1729               .
     1730             end.
     1731             assign
     1732               v-diasize-browse-handle :width = v-browse-width
     1733             .
     1734             for each buf_temp-diasize-handle
     1735             on error undo, next
     1736             :
     1737               assign
     1738                 v-object-handle = buf_temp-diasize-handle.handle-value
     1739               .
     1740               if v-object-handle <> v-diasize-resize-button
     1741               then do:
     1742                 assign
     1743                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1744                 .
     1745               end.
     1746             end.
     1747             run diasize_position-resize-button in this-procedure .
     1748           end.
     1749           assign
     1750             v-diasize-change-size = false
     1751           .
     1752           leave move_block .
     1753         end.
     1754       end.
     1755       assign
     1756         v-diasize-need-full-display = true
     1757       .
     1758       if v-diasize-change-size = false
     1759       then do:
     1760         assign
     1761           v-diasize-change-size = true
     1762         .
     1763       end.
     1764       else do:
     1765         return .
     1766       end.
     1767       assign
     1768         v-frame-width = frame d-scn-inv :width
     1769         v-frame-virtual-width = frame d-scn-inv :virtual-width
     1770         v-browse-width = v-diasize-browse-handle :width
     1771       .
     1772       for each buf_temp-browse-handle
     1773         where buf_temp-browse-handle.browse-type = 'width':u
     1774       :
     1775         assign
     1776           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1777         .
     1778       end.
     1779       for each buf_temp-diasize-handle
     1780       :
     1781         delete buf_temp-diasize-handle .
     1782       end.
     1783       assign
     1784         v-field-group-handle = frame d-scn-inv :first-child
     1785       .
     1786       do while valid-handle(v-field-group-handle)
     1787       :
     1788         assign
     1789           v-object-handle = v-field-group-handle :first-child
     1790         .
     1791         do while valid-handle(v-object-handle)
     1792         :
     1793           if  v-object-handle <> v-diasize-browse-handle :handle
     1794           and v-object-handle <> v-diasize-resize-button
     1795           and can-query(v-object-handle, "row")
     1796           and can-query(v-object-handle, "height")
     1797           and ( v-object-handle :col + v-object-handle :width
     1798                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1799               )
     1800           then do:
     1801             find first buf_temp-browse-handle
     1802               where buf_temp-browse-handle.browse-type   = 'width':u
     1803                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1804               no-error .
     1805             if available buf_temp-browse-handle
     1806             then do:
     1807             end.
     1808             else do:
     1809               create buf_temp-diasize-handle .
     1810               assign
     1811                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1812                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1813               .
     1814             end.
     1815           end.
     1816           assign
     1817             v-object-handle = v-object-handle :next-sibling
     1818           .
     1819         end.
     1820         assign
     1821           v-field-group-handle = v-field-group-handle :next-sibling
     1822         .
     1823       end.
     1824       do with frame d-scn-inv
     1825       :
     1826         hide v-diasize-resize-button .
     1827         v-diasize-resize-button :row = 1.
     1828         v-diasize-resize-button :column = 1.
     1829       end.
     1830       if p-change-value > 0
     1831       then do:
     1832         if frame d-scn-inv :scrollable = true
     1833         then do:
     1834           assign
     1835             frame d-scn-inv :virtual-width = frame d-scn-inv :virtual-width + p-change-value
     1836             no-error .
     1837           if error-status :error
     1838           or error-status :get-message(1) <> ""
     1839           then do:
     1840             undo move_block, retry move_block.
     1841           end.
     1842         end.
     1843         assign
     1844           frame d-scn-inv :width = v-frame-width + p-change-value
     1845           no-error .
     1846         if error-status :error
     1847         or error-status :get-message(1) <> ""
     1848         then do:
     1849           undo move_block, retry move_block.
     1850         end.
     1851         assign
     1852           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1853         no-error .
     1854         if error-status :error
     1855         or error-status :get-message(1) <> ""
     1856         then do:
     1857           undo move_block, retry move_block.
     1858         end.
     1859         for each buf_temp-browse-handle
     1860           where buf_temp-browse-handle.browse-type = 'width':u
     1861         on error undo move_block, retry move_block
     1862         :
     1863           assign
     1864             buf_temp-browse-handle.browse-handle :width
     1865               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1866             no-error .
     1867           if error-status :error
     1868           or error-status :get-message(1) <> ""
     1869           then do:
     1870             undo move_block, retry move_block .
     1871           end.
     1872         end.
     1873         for each buf_temp-diasize-handle
     1874         on error undo move_block, retry move_block
     1875         :
     1876           assign
     1877             v-object-handle = buf_temp-diasize-handle.handle-value
     1878           .
     1879           if v-object-handle <> v-diasize-resize-button
     1880           then do:
     1881             assign
     1882               v-object-handle :col = v-object-handle :col + p-change-value
     1883               no-error .
     1884             if error-status :error
     1885             or error-status :get-message(1) <> ""
     1886             then do:
     1887               undo move_block, retry move_block .
     1888             end.
     1889           end.
     1890         end.
     1891       end.
     1892       else do:
     1893         for each buf_temp-diasize-handle
     1894         on error undo move_block, retry move_block
     1895         :
     1896           assign
     1897             v-object-handle = buf_temp-diasize-handle.handle-value
     1898           .
     1899           if v-object-handle <> v-diasize-resize-button
     1900           then do:
     1901             assign
     1902               v-object-handle :col = v-object-handle :col + p-change-value
     1903               no-error .
     1904             if error-status :error
     1905             or error-status :get-message(1) <> ""
     1906             then do:
     1907               undo move_block, retry move_block .
     1908             end.
     1909           end.
     1910         end.
     1911         for each buf_temp-browse-handle
     1912           where buf_temp-browse-handle.browse-type = 'width':u
     1913         on error undo move_block, retry move_block
     1914         :
     1915           assign
     1916             buf_temp-browse-handle.browse-handle :width
     1917               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1918             no-error .
     1919           if error-status :error
     1920           or error-status :get-message(1) <> ""
     1921           then do:
     1922             undo move_block, retry move_block .
     1923           end.
     1924         end.
     1925         assign
     1926           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1927           no-error .
     1928         if error-status :error
     1929         or error-status :get-message(1) <> ""
     1930         then do:
     1931           undo move_block, retry move_block.
     1932         end.
     1933         assign
     1934           frame d-scn-inv :width = frame d-scn-inv :width + p-change-value
     1935         no-error .
     1936         if error-status :error
     1937         or error-status :get-message(1) <> ""
     1938         then do:
     1939           undo move_block, retry move_block.
     1940         end.
     1941         if frame d-scn-inv :scrollable = true
     1942         then do:
     1943           assign
     1944             frame d-scn-inv :virtual-width = frame d-scn-inv :virtual-width + p-change-value
     1945           no-error .
     1946           if error-status :error
     1947           or error-status :get-message(1) <> ""
     1948           then do:
     1949             undo move_block, retry move_block.
     1950           end.
     1951         end.
     1952       end.
     1953       if p-move-resize
     1954       then do:
     1955         run diasize_position-resize-button in this-procedure .
     1956       end.
     1957       if v-diasize-wndstore = true
     1958       then do:
     1959         if connected("ub") = true
     1960         then do:
     1961           define variable v-cntxt-db-num        as integer   no-undo .
     1962           define variable v-cntxt-userid        as character no-undo .
     1963           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1964                                             , OUTPUT v-cntxt-userid
     1965                                             ) .
     1966           run gbl/wndsizew.p
     1967             (input  v-cntxt-db-num
     1968             ,input  v-cntxt-userid
     1969             ,input  v-diasize-proc-name
     1970             ,input  'width':u
     1971             ,input  string(frame d-scn-inv :width - v-diasize-orig-frame-width)
     1972             ) .
     1973         end.
     1974       end.
     1975     end.
     1976     assign
     1977       v-diasize-change-size = false
     1978     .
     1979   end procedure.
     1980   procedure diasize_set-width :
     1981     define input  parameter p-new-width  as decimal   no-undo .
     1982     define input  parameter p-move-resize as logical   no-undo .
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986       run diasize_change-width in this-procedure
     1987         (input  (p-new-width - frame d-scn-inv :width)
     1988         ,input  p-move-resize
     1989         ) .
     1990     end.
     1991   end procedure.
     1992   procedure diasize_position-resize-button :
     1993     do with frame d-scn-inv
     1994     :
     1995       hide v-diasize-resize-button .
     1996       assign
     1997         v-diasize-resize-button :row = frame d-scn-inv :height - v-diasize-resize-button :height
     1998                     - 1
     1999                     - (frame d-scn-inv :border-bottom-pixels / session :pixels-per-row)
     2000         v-diasize-resize-button :col = frame d-scn-inv :width - v-diasize-resize-button :width
     2001                     - 1
     2002                     - (frame d-scn-inv :border-right-pixels / session :pixels-per-column)
     2003       .
     2004       view v-diasize-resize-button .
     2005     end.
     2006   end procedure.
     2007   on alt-right anywhere
     2008   do:
     2009     run diasize_change-width in this-procedure
     2010       (input 1
     2011       ,input true
     2012       ) .
     2013     return no-apply .
     2014   end.
     2015   on alt-left anywhere
     2016   do:
     2017     run diasize_change-width in this-procedure
     2018       (input -1
     2019       ,input true
     2020       ) .
     2021     return no-apply .
     2022   end.
     2023   on alt-down anywhere
     2024   do:
     2025     run diasize_change-height in this-procedure
     2026       (input 1
     2027       ,input true
     2028       ) .
     2029     return no-apply .
     2030   end.
     2031   on alt-up anywhere
     2032   do:
     2033     run diasize_change-height in this-procedure
     2034       (input -1
     2035       ,input true
     2036       ) .
     2037     return no-apply .
     2038   end.
     2039   on alt-enter of frame d-scn-inv
     2040   do:
     2041     run diasize_maximize in this-procedure
     2042       (input  ?
     2043       ).
     2044     return no-apply .
     2045   end.
     2046   procedure diasize_end-move :
     2047     do
     2048     on error undo, return error return-value
     2049     :
     2050       define variable v-row-delta as decimal   no-undo .
     2051       define variable v-col-delta as decimal   no-undo .
     2052       define variable v-new-row as decimal   no-undo .
     2053       define variable v-new-col as decimal   no-undo .
     2054       assign
     2055         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2056         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2057       .
     2058       assign
     2059         v-row-delta = v-new-row - frame d-scn-inv :height
     2060         v-col-delta = v-new-col - frame d-scn-inv :width
     2061       .
     2062       run diasize_change-height in this-procedure
     2063         (input v-row-delta
     2064         ,input true
     2065         ) .
     2066       run diasize_change-width in this-procedure
     2067         (input v-col-delta
     2068         ,input true
     2069         ) .
     2070     end.
     2071   end procedure.
     2072   procedure diasize_maximize :
     2073     define input  parameter p-action as logical   no-undo .
     2074     do
     2075     on error undo, return error return-value
     2076     :
     2077       if p-action = ?
     2078       then do:
     2079         if v-diasize-need-maximize = true
     2080         then do:
     2081           assign
     2082             p-action = true
     2083           .
     2084         end.
     2085         else do:
     2086           assign
     2087             p-action = false
     2088           .
     2089         end.
     2090       end.
     2091       if p-action = true
     2092       then do:
     2093         run diasize_change-height in this-procedure
     2094           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2095               - frame d-scn-inv :height-chars
     2096           ,input true
     2097           ) .
     2098         run diasize_change-width in this-procedure
     2099           (input session :width-chars
     2100               - frame d-scn-inv :width-chars
     2101           ,input true
     2102           ) .
     2103         assign
     2104           v-diasize-need-maximize = false
     2105         .
     2106       end.
     2107       else do:
     2108         run diasize_change-width in this-procedure
     2109           (input v-diasize-orig-frame-width
     2110               - frame d-scn-inv :width-chars
     2111           ,input true
     2112           ) .
     2113         run diasize_change-height in this-procedure
     2114           (input v-diasize-orig-frame-height
     2115               - frame d-scn-inv :height-chars
     2116           ,input true
     2117           ) .
     2118         assign
     2119           v-diasize-need-maximize = true
     2120         .
     2121       end.
     2122     end.
     2123   end procedure.
     2124   procedure diasize_restore-orig-size :
     2125     do
     2126     on error undo, return error return-value
     2127     :
     2128       assign
     2129         v-diasize-current-frame-width  = frame d-scn-inv :width
     2130         v-diasize-current-frame-height = frame d-scn-inv :height
     2131       .
     2132       run diasize_set-height in this-procedure
     2133         (input  v-diasize-orig-frame-height
     2134         ,input  true
     2135         ) .
     2136       run diasize_set-width in this-procedure
     2137         (input  v-diasize-orig-frame-width
     2138         ,input  true
     2139         ) .
     2140     end.
     2141   end procedure.
     2142   procedure diasize_restore-current-size :
     2143     do
     2144     on error undo, return error return-value
     2145     :
     2146       run diasize_set-height in this-procedure
     2147         (input  v-diasize-current-frame-height
     2148         ,input  true
     2149         ) .
     2150       run diasize_set-width in this-procedure
     2151         (input  v-diasize-current-frame-width
     2152         ,input  true
     2153         ) .
     2154     end.
     2155   end procedure.
     2156   procedure diasize_set-browse-handle :
     2157     define input  parameter p-browse-handle as handle   no-undo .
     2158     define buffer buf_temp-browse-handle for temp-browse-handle .
     2159     do
     2160     on error undo, return error return-value
     2161     :
     2162       assign
     2163         v-diasize-browse-handle = p-browse-handle
     2164       .
     2165       for each buf_temp-browse-handle
     2166       on error undo, return error return-value
     2167       :
     2168         delete buf_temp-browse-handle .
     2169       end.
     2170     end.
     2171   end procedure.
     2172   procedure diasize_add_browse :
     2173     define input  parameter p-browse-type   as character no-undo .
     2174     define input  parameter p-browse-handle as handle    no-undo .
     2175     define buffer buf_temp-browse-handle for temp-browse-handle .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       assign
     2180         v-diasize-browse-number = v-diasize-browse-number + 1
     2181       .
     2182       create buf_temp-browse-handle .
     2183       assign
     2184         buf_temp-browse-handle.browse-type   = p-browse-type
     2185         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2186         buf_temp-browse-handle.browse-handle = p-browse-handle
     2187       .
     2188     end.
     2189   end procedure.
     2190   procedure diasize_init :
     2191     define variable v-default-value    as logical   no-undo .
     2192     define variable v-restore-saved    as logical   no-undo .
     2193     define variable v-resize-value-str as character no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       do with frame d-scn-inv
     2198       :
     2199         assign
     2200           v-diasize-orig-frame-height = frame d-scn-inv :height
     2201           v-diasize-orig-frame-width  = frame d-scn-inv :width
     2202           v-diasize-browse-handle     = browse b-anlz-bc :handle
     2203         .
     2204         create button v-diasize-resize-button
     2205         assign
     2206           parent        = frame d-scn-inv :first-child
     2207           label         = "s"
     2208           height-pixels = 16
     2209           width-pixels  = 16
     2210           visible       = true
     2211           sensitive     = true
     2212           movable       = true
     2213           triggers:
     2214             on end-move persistent run diasize_end-move in this-procedure .
     2215           end triggers.
     2216         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2217         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2218         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2219         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2220         assign
     2221           v-diasize-wndmax = false
     2222         .
     2223         if connected("ub") = true
     2224         then do:
     2225           define variable v-cntxt-db-num        as integer   no-undo .
     2226           define variable v-cntxt-userid        as character no-undo .
     2227           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2228                                             , OUTPUT v-cntxt-userid
     2229                                             ) .
     2230           run gbl/wndpar_r.p
     2231             (input  v-cntxt-db-num
     2232             ,input  v-cntxt-userid
     2233             ,input  'wndmax':U
     2234             ,output v-diasize-wndmax
     2235             ,output v-default-value
     2236             ) .
     2237         end.
     2238         assign
     2239           v-diasize-wndstore = false
     2240         .
     2241         if connected("ub") = true
     2242         then do:
     2243           run gbl/wndpar_r.p
     2244             (input  v-cntxt-db-num
     2245             ,input  v-cntxt-userid
     2246             ,input  'wndstore':U
     2247             ,output v-diasize-wndstore
     2248             ,output v-default-value
     2249             ) .
     2250         end.
     2251         assign
     2252           v-diasize-proc-name = entry(1, program-name(2), '.')
     2253         .
     2254         if v-diasize-wndstore = true
     2255         then do:
     2256           assign
     2257             v-restore-saved = false
     2258           .
     2259           if connected("ub") = true
     2260           then do:
     2261             run gbl/wndsizer.p
     2262               (input  v-cntxt-db-num
     2263               ,input  v-cntxt-userid
     2264               ,input  v-diasize-proc-name
     2265               ,input  'height':u
     2266               ,output v-resize-value-str
     2267               ) .
     2268             if v-resize-value-str <> '':U
     2269             then do:
     2270               run diasize_change-height in this-procedure
     2271                 (input  integer(v-resize-value-str)
     2272                 ,input  true
     2273                 ) .
     2274               assign
     2275                 v-restore-saved = true
     2276               .
     2277             end.
     2278           end.
     2279           if connected("ub") = true
     2280           then do:
     2281             run gbl/wndsizer.p
     2282               (input  v-cntxt-db-num
     2283               ,input  v-cntxt-userid
     2284               ,input  v-diasize-proc-name
     2285               ,input  'width':u
     2286               ,output v-resize-value-str
     2287               ) .
     2288             if v-resize-value-str <> '':U
     2289             then do:
     2290               run diasize_change-width in this-procedure
     2291                 (input  integer(v-resize-value-str)
     2292                 ,input  true
     2293                 ) .
     2294               assign
     2295                 v-restore-saved = true
     2296               .
     2297             end.
     2298           end.
     2299           if v-restore-saved <> true
     2300           then do:
     2301             if v-diasize-wndmax = true
     2302             then do:
     2303               run diasize_maximize in this-procedure
     2304                 (input  true
     2305                 ) .
     2306             end.
     2307           end.
     2308         end.
     2309         else do:
     2310           if v-diasize-wndmax = true
     2311           then do:
     2312             run diasize_maximize in this-procedure
     2313               (input  true
     2314               ) .
     2315           end.
     2316         end.
     2317       end.
     2318     end.
     2319   end procedure.
     2320   procedure diasize_need-full-display :
     2321     define output parameter p-need-full-display as logical   no-undo .
     2322     do
     2323     on error undo, return error return-value
     2324     :
     2325       assign
     2326         p-need-full-display = v-diasize-need-full-display
     2327       .
     2328       assign
     2329         v-diasize-need-full-display = false
     2330       .
     2331     end.
     2332   end procedure.
     2333   procedure get-context :
     2334      define output parameter p-db-num as integer          no-undo.
     2335      define output parameter p-user-id as character        no-undo.
     2336      define variable v-login               as character    no-undo.
     2337      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2338      define buffer buf_user-login  for ub.user-login .
     2339      do
     2340      on error undo, return error
     2341      :
     2342            FIND FIRST buf_sys-ctrl no-lock.
     2343            ASSIGN
     2344               v-login = USERID("ub")
     2345               p-db-num = buf_sys-ctrl.db-num
     2346            .
     2347            FIND FIRST buf_user-login
     2348                 WHERE buf_user-login.db-num = p-db-num
     2349                   AND buf_user-login.user-login = v-login
     2350                 no-lock
     2351                 no-error
     2352                 .
     2353            IF AVAILABLE buf_user-login
     2354            THEN DO:
     2355               assign
     2356                  p-user-id = buf_user-login.user-id
     2357               .
     2358            END.
     2359      end.
     2360   end procedure.
     2361       run diasize_init in this-procedure .
     2362   MAIN-BLOCK:
     2363   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2364      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2365     for each anlz-bc :
     2366       delete anlz-bc.
     2367     end.
     2368     run enable_ui in this-procedure .
     2369     run loc-val-chg in this-procedure .
     2370     WAIT-FOR GO OF FRAME d-scn-inv.
     2371   END.
     2372   run disable_ui in this-procedure .
     2373   PROCEDURE disable_UI :
     2374     HIDE FRAME d-scn-inv.
     2375   END PROCEDURE.
     2376   PROCEDURE enable_UI :
     2377     DISPLAY varerr-msg-in vardes-in varerr-msg-un vardes-un varerr-msg-anlz
     2378             vardes-anlz
     2379         WITH FRAME d-scn-inv.
     2380     ENABLE b-exit b-save b-add b-undo b-bc b-help b-in-bc b-file varerr-msg-in
     2381            vardes-in b-un-bc b-inf varerr-msg-un vardes-un b-anlz-bc
     2382            varerr-msg-anlz vardes-anlz
     2383         WITH FRAME d-scn-inv.
     2384     VIEW FRAME d-scn-inv.
     2385     OPEN QUERY b-anlz-bc FOR EACH anlz-bc ,             first main-bc where anlz-bc.nm = main-bc.nm INDEXED-REPOSITION.    OPEN QUERY b-file FOR EACH file-inv.    OPEN QUERY b-in-bc FOR EACH in-bc INDEXED-REPOSITION.    OPEN QUERY b-un-bc FOR EACH un-bc INDEXED-REPOSITION.
     2386   END PROCEDURE.
     2387   PROCEDURE loc-val-chg :
     2388     apply "value-changed" to browse b-in-bc.
     2389     apply "value-changed" to browse b-un-bc.
     2390     apply "value-changed" to browse b-anlz-bc.
     2391   END PROCEDURE.
