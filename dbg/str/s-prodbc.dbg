    12056         if search(v-kat-file) = ? then do:
    12057           output stream bar to value(v-kat-file) convert target "ibm866" .
    12058           put stream bar unformatted skip.
    12059           output stream bar close.
    12060         end.
    12061         else do:
    12062          if ncr-save-param <> 'no':U then do:                                                     if search(v-kat-file-save) <> ? then do:                                               input stream bar from value(v-kat-file-save) convert source "ibm866" .                 repeat:                                                                                  import stream bar unformatted ss.                                                      find first cash-ncr-save-param where                                                            cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat                                 AND cash-ncr-save-param.cd-line = substring(ss, 1, 24) no-error.                  if not available cash-ncr-save-param then do:                                            create cash-ncr-save-param.                                                            assign                                                                                 cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat                                     cash-ncr-save-param.cd-line = substring(ss, 1, 24)                                     cash-ncr-save-param.cd-other = substring(ss, 25)                                       .                                                                                    end.                                                                                 end.                                                                                   input stream bar close .                                                               end.                                                                                   else do:                                                                               end.                                                                                 end.
    12063         end.
    12064         input stream bar from value(v-kat-file) convert source "ibm866" .
    12065         assign
    12066         ss0 = ''
    12067         ss = '':U
    12068         v-cd-subject-code = '':U
    12069         v-cd-disc-string  = '':U
    12070         v-next = no
    12071         v-updated-subject-dis-kat = no
    12072         .
    12073         output stream plucash to value(v-temp-kat-file) convert target "ibm866".
    12074         _rr2:
    12075         repeat:
    12076           import stream bar unformatted ss.
    12077           assign
    12078           v-next = no
    12079           v-updated-subject-dis-kat = no
    12080           v-cd-subject-code = substring(ss, 1, 16)
    12081           v-cd-disc-string =  substring(ss, 17, 7)
    12082           .
    12083           if not ss begins fill(chr(32), 2 )
    12084           then do:
    12085             if substring(ss0, 1, 3) = substring(v-cd-subject-code, 1, 3) then do:
    12086               put stream plucash unformatted
    12087               ss skip.
    12088               ss0 = v-cd-subject-code.
    12089               NEXT _rr2.
    12090             end.
    12091             v-next = yes.
    12092           end.
    12093           _for_rr2:
    12094           for each  buf_cash-ncr-dis-kat no-lock where
    12095                     buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    12096                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
    12097                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    12098                 and crf <= cr-ncr-dis-kat
    12099           by buf_cash-ncr-dis-kat.cd-subject-code
    12100           by buf_cash-ncr-dis-kat.cd-disc-string
    12101           :
    12102             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12103             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) > v-cd-disc-string then do:
    12104               leave  _for_rr2.
    12105             end.
    12106             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
    12107               v-updated-subject-dis-kat = yes.
    12108             end.
    12109             find first  cash-ncr-save-param no-lock where
    12110                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    12111                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    12112                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    12113             if available cash-ncr-save-param then do:
    12114               put stream plucash unformatted
    12115               cash-ncr-save-param.cd-line
    12116               cash-ncr-save-param.cd-other
    12117               skip.
    12118               v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7)
    12119                                  .
    12120               NEXT _for_rr2.
    12121             end.
    12122             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    12123           end.
    12124           if v-next then do:
    12125             ss0 = v-cd-subject-code.
    12126             put stream plucash unformatted
    12127             ss skip.
    12128             NEXT _rr2.
    12129           end.
    12130           if not v-updated-subject-dis-kat then do:
    12131             find first buf_cash-ncr-dis-kat no-lock where
    12132                       buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12133                   AND buf_cash-ncr-dis-kat.crf <= cr-ncr-dis-kat no-error.
    12134             if not available buf_cash-ncr-dis-kat then do:
    12135               put stream plucash unformatted
    12136               ss skip.
    12137             end.
    12138           end.
    12139           ss0 = v-cd-subject-code.
    12140         end.
    12141         input stream bar close.
    12142         _for_rr3:
    12143         for each  buf_cash-ncr-dis-kat no-lock where
    12144                   buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    12145               AND buf_cash-ncr-dis-kat.cd-subject-code >= v-cd-subject-code
    12146               and crf <= cr-ncr-dis-kat
    12147         by buf_cash-ncr-dis-kat.cd-subject-code
    12148         by buf_cash-ncr-dis-kat.cd-disc-string
    12149         :
    12150             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    12151             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) <= v-cd-disc-string then do:
    12152               next  _for_rr3.
    12153             end.
    12154           find first  cash-ncr-save-param no-lock where
    12155                         cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    12156                     AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    12157                                                       substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    12158           if available cash-ncr-save-param then do:
    12159             put stream plucash unformatted
    12160             cash-ncr-save-param.cd-line
    12161             cash-ncr-save-param.cd-other
    12162             skip.
    12163             v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7) .
    12164           end.
    12165           else do:
    12166             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
    12167           end.
    12168         end.
    12169         output stream plucash close.
    12170         find first temp-dis-kat-file no-lock where                                                       temp-dis-kat-file.dis-kat = cash-ncr-dis-kat.dis-kat no-error.                   if not available temp-dis-kat-file then                                                create temp-dis-kat-file.                                                              assign                                                                                 temp-dis-kat-file.dis-kat   = cash-ncr-dis-kat.dis-kat                                     .                                                                                      assign                                                                                 temp-dis-kat-file.temp-file = v-temp-kat-file                                          temp-dis-kat-file.send-file = v-kat-file                                               temp-dis-kat-file.to-send   = yes.
    12171       end.
    12172     END.
    12173   end.
    12174     end.
    12175     when 'MARIA':U then do:
    12176   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12177   define variable v-found98 as logical no-undo .
    12178   define variable v-is-script98 as logical no-undo.
    12179   define variable v-fields-shift98 as integer no-undo .
    12180      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    12181      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    12182      then do:
    12183        v-fields-shift98 = - 1.
    12184   if v-record <> '':U then
    12185       run maria-put in this-procedure (
    12186                                       buffer for-cash-desk
    12187                                     , input out
    12188                                     , input fname
    12189                                     , input yes
    12190                                     , input v-fields-shift98
    12191                                     , input yes
    12192                                     , input 24
    12193                                     , input 1
    12194                                     , input string(1)
    12195                                     , input v-record
    12196                                       ).
    12197      end.
    12198   find first temp-tekka-tsk no-error.
    12199   if available temp-tekka-tsk then do:
    12200      v-found98 = yes.
    12201   end.
    12202   if v-found98 = yes then do:
