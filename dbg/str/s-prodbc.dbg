     3015   procedure xml-cd-write-header:
     3016   do
     3017   on error undo, return error
     3018   :
     3019   define input parameter p-xml-file-name       as character    no-undo.
     3020   define input parameter p-xml-file-name-path  as character    no-undo.
     3021   define input parameter p-doc-name            as character    no-undo.
     3022   define input parameter p-version             as character    no-undo.
     3023   define input parameter p-obj-list            as character    no-undo.
     3024   define input parameter p-correspondent       as character    no-undo .
     3025   define input parameter p-write-header        as logical      no-undo .
     3026   define variable OS-time as character no-undo .
     3027   define variable id as character no-undo .
     3028   define buffer buf_db for ub.db.
     3029   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3030   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3031   assign
     3032   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3033   .
     3034   run bgelib-tag-open in this-procedure (
     3035                                        1
     3036                                       ,p-doc-name
     3037                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3038                                         ).
     3039   if p-write-header then do:
     3040     run bgelib-tag-open(2, "Header","").
     3041     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3042     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3043     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3044     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3045     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3046     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3047     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3048     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3049     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3050     run bgelib-tag-close( 2, "Header" ).
     3051   end.
     3052   output stream stmXMLOut close.
     3053   end.
     3054   end procedure.
     3055   procedure xml-cd-write-footer:
     3056   do
     3057   on error undo, return error
     3058   :
     3059   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3060   define input parameter p-xml-file-name as character    no-undo.
     3061   define input parameter p-doc-name      as character    no-undo .
     3062   define variable v-error-num     as integer           no-undo.
     3063   define variable v-md5-signature as character no-undo .
     3064   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3065   run bgelib-tag-close( 0, p-doc-name ).
     3066   put stream stmXMLOut unformatted skip.
     3067   output stream stmXMLOut close.
     3068   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3069   if v-error-num > 0
     3070   then do:
     3071      return error.
     3072   end.
     3073   if opsys = "unix"
     3074   then do:
     3075       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3076   end.
     3077   end.
     3078   end procedure.
     3079   procedure xml-cd-filename :
     3080   do
     3081   on error undo, return error
     3082   :
     3083   define input parameter  p-out               as character no-undo .
     3084   define output parameter p-xml-file-name     as character    no-undo.
     3085   define output parameter p-xml-file-name-path   as character    no-undo.
     3086   define output parameter p-log-file-name     as character    no-undo.
     3087   define output parameter p-locked            as logical      no-undo.
     3088   define variable v-out as character     no-undo.
     3089   define variable loc#log as logical no-undo .
     3090   define variable BadFlag as logical no-undo .
     3091   define variable fq as integer no-undo .
     3092   define variable v-remote as character no-undo .
     3093   assign
     3094   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3095   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3096   p-log-file-name = p-out + "actions.log"
     3097   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3098   .
     3099   end.
     3100   end procedure.
     3101   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3102   define variable v-date-str as character no-undo .
     3103   assign
     3104   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3105                string(Month(p-date), "99":U) + "-":U +
     3106                string(DAY(p-date), "99":U).
     3107   return v-date-str.
     3108   END FUNCTION.
     3109   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3110   define variable v-date-str as character no-undo .
     3111   assign
     3112   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3113                string(Month(p-date), "99":U) + "-":U +
     3114                string(DAY(p-date), "99":U) + chr(32) +
     3115                string(p-time, "HH:MM:SS").
     3116   return v-date-str.
     3117   END FUNCTION.
     3118   function string-to-date returns date ( input p-string  as character):
     3119     define variable v-date as date no-undo .
     3120     assign
     3121     v-date = date(integer(substring(p-string, 4, 2))
     3122                   ,integer(substring(p-string, 1, 2))
     3123                   ,integer(substring(p-string, 7, 4))
     3124                  ) no-error .
     3125     if error-status:error then return ?.
     3126     return v-date.
     3127   END FUNCTION.
     3128   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3129   define variable v-time as integer no-undo init ?.
     3130   define variable v-dop1 as character no-undo .
     3131   define variable v-dop2 as character no-undo .
     3132   assign
     3133   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3134   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3135   no-error .
     3136   if error-status:error then return ?.
     3137   assign
     3138   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3139             integer(entry(2, v-dop2, ";":U)) * 60 +
     3140             integer(entry(3, v-dop2, ";":U)) no-error .
     3141   return v-time.
     3142   END FUNCTION.
     3143   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3144   procedure gdcstcod_cst-code :
     3145     define input  parameter p-obj-type  as character no-undo .
     3146     define input  parameter p-obj-code  as integer   no-undo .
     3147     define input  parameter p-gds-code  as integer   no-undo .
     3148     define input  parameter p-in-code   as character no-undo .
     3149     define input  parameter p-part-code as character no-undo .
     3150     define output parameter p-cst-code  as character no-undo .
     3151     define buffer buf_goods for ub.goods .
     3152     define buffer buf_parts for ub.parts .
     3153     do
     3154     on error undo, return error return-value
     3155     :
     3156       assign
     3157         p-cst-code = ''
     3158       .
     3159       find first buf_goods no-lock
     3160         where buf_goods.gds-code = p-gds-code
     3161         no-error .
     3162       if not available buf_goods
     3163       then do:
     3164         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3165       end.
     3166       if p-in-code = ?
     3167       then do:
     3168         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3169       end.
     3170       if p-part-code = ?
     3171       then do:
     3172         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3173       end.
     3174       if p-in-code = '':u
     3175       then do:
     3176         find first buf_parts no-lock
     3177           where buf_parts.obj-type  = p-obj-type
     3178             and buf_parts.obj-code  = p-obj-code
     3179             and buf_parts.artic     = buf_goods.artic
     3180             and buf_parts.prod-type = buf_goods.prod-type
     3181             and buf_parts.prod-code = buf_goods.prod-code
     3182             and buf_parts.out-code  = 'free-zone':U
     3183             and buf_parts.status_   = false
     3184           no-error .
     3185         if available buf_parts
     3186         then do:
     3187           assign
     3188             p-cst-code = buf_parts.cst-code
     3189           .
     3190         end.
     3191       end.
     3192       else do:
     3193         find first buf_parts no-lock
     3194           where buf_parts.obj-type  = p-obj-type
     3195             and buf_parts.obj-code  = p-obj-code
     3196             and buf_parts.artic     = buf_goods.artic
     3197             and buf_parts.prod-type = buf_goods.prod-type
     3198             and buf_parts.prod-code = buf_goods.prod-code
     3199             and buf_parts.out-code  = 'free-zone':U
     3200             and buf_parts.in-code   = p-in-code
     3201             and buf_parts.part-code = p-part-code
     3202           no-error .
     3203         if available buf_parts
     3204         then do:
     3205           assign
     3206             p-cst-code = buf_parts.cst-code
     3207           .
     3208         end.
     3209       end.
     3210     end.
     3211   end procedure.
