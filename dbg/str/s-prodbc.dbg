    12799                                       , input (if integer(v-plu) <= v-20-part1
    12800                                               then 2621
    12801                                               else 2379)
    12802                                       , input v-plu
    12803                                       , input (if v-marketer-action = 'U':U
    12804                                                 then string(convert-maria-tax-code(cash-gds.vat-code, 0  , cdtaxlst), "X(8)")
    12805                                                 else '00000000':U) + chr(4) + chk_name).
    12806         run maria-put in this-procedure (
    12807                                         buffer for-cash-desk
    12808                                       , input out
    12809                                       , input fname
    12810                                       , input yes
    12811                                       , input 0
    12812                                       , input no
    12813                                       , input 6
    12814                                       , input 5000
    12815                                       , input v-plu
    12816                                       , input (if cash-gds.grp-code = 0
    12817                                                then '001'
    12818                                                else string(cash-gds.grp-code, "999"))).
    12819       end.
    12820     end.
    12821   end.
    12822     end.
    12823   END .
    12824   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
