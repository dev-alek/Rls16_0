    14759   def var v-today         as date no-undo .
    14760   def buffer buf_dis-gds-rule-attr for ub.dis-gds-rule-attr.
    14761   def buffer buf_dis-gds-rule      for ub.dis-gds-rule .
    14762   def buffer chk_dis-gds-rule      for ub.dis-gds-rule .
    14763   def buffer buf_dis-thbj-rule     for ub.dis-thbj-rule .
    14764   def buffer buf_dis-rule          for ub.dis-rule .
    14765   def buffer buf_dis-time-rule     for ub.dis-time-rule .
    14766   def buffer buf_prod-bc           for ub.prod-bc .
    14767   def buffer buf_bar-code          for ub.bar-code .
