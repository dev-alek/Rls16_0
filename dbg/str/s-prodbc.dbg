     9711       run bgelib-tag-put in this-procedure ( input 4, input "ISComplex" ,
     9712                                             input string(1), input 1 ).
     9713       end.
     9714       else do:
     9715       run bgelib-tag-put in this-procedure ( input 4, input "ISComplex" ,
     9716                                             input string(0), input 1 ).
     9717       end.
     9718       run bgelib-tag-put in this-procedure ( input 4, input "ISActivate" ,
     9719                                             input (if cash-gds.office-type = 'card-act':U then string(1) else string(0)), input 1 ).
     9720       run bgelib-tag-put in this-procedure ( input 4, input "ISNoDiscount" ,
     9721                                               input string(if cash-gds.wgd > 0 then wgd-option else 0), input 1 ).
     9722       run bgelib-tag-put in this-procedure ( input 4, input "ISGaz" ,
     9723                                               input string(if cash-gds.is-gas then 1 else 0), input 1 ).
     9724       run bgelib-tag-put in this-procedure ( input 4, input "ISFuelAsUnit" ,
     9725                                               input string(if cash-gds.ptrl-as-good then 1 else 0), input 1 ).
     9726     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9727            and buf_goods-attr.attr-code = "IS18Plus"
     9728            and buf_goods-attr.attr-value = "1"
     9729            no-lock no-error.
     9730     if available buf_goods-attr then do:
     9731         run bgelib-tag-put in this-procedure ( input 4, input "IS18Plus", input 1, input 1 ).
     9732     end.
     9733     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9734            and buf_goods-attr.attr-code = "loyalty-gift"
     9735            and buf_goods-attr.attr-value = "1"
     9736            no-lock no-error.
     9737     if available buf_goods-attr then do:
     9738         run bgelib-tag-put in this-procedure ( input 4, input "ItemLoyaltyGift", input 1, input 1 ).
     9739     end.
     9740     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "alcohol-prod" no-lock no-error.
     9741     if available buf_goods-attr then do:
     9742     v-attr-egais = 1.
     9743     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "mark" no-lock no-error.
     9744       if available buf_goods-attr and buf_goods-attr.attr-value = "no" then  do:
     9745         run bgelib-tag-put in this-procedure ( input 4, input "ISEgaisNoPDF", input 1, input 1 ).
     9746       end.
     9747       if available buf_goods-attr and buf_goods-attr.attr-value = "yes" then  do:
     9748         run bgelib-tag-put in this-procedure ( input 4, input "ISEgaisPDF"      , input 1, input 1 ).
     9749       end.
     9750       if not available buf_goods-attr then do:
     9751         run bgelib-tag-put in this-procedure ( input 4, input "ISEgaisNoPDF", input 1, input 1 ).
     9752       end.
     9753     end.
     9754     find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9755                                 and buf_goods-attr.attr-code = "time-coock"
     9756                                 and buf_goods-attr.attr-value = "yes" no-lock no-error.
     9757     if available buf_goods-attr then do:
     9758         run bgelib-tag-put in this-procedure ( input 4, input "ISCookStumped", input 1, input 1 ).
     9759     end.
     9760         run bgelib-tag-close in this-procedure ( input 3, input "ItemStatus").
     9761     end.
     9762     if cash-gds.temp-discnt-rule <> 0 then do:
     9763       find first cash-dis-rule no-lock where
     9764                 cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
     9765       if available cash-dis-rule then do:
     9766         for each buf_cash-dis-rule no-lock where
     9767                 (cash-dis-rule.is-term = yes
     9768                 and buf_cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     9769               or
     9770               buf_cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule,
     9771           first cash-dis-time-rule no-lock where
     9772                     cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num:
     9773           if buf_cash-dis-rule.is-term
     9774           and buf_cash-dis-rule.root then do:
     9775           end.
     9776           else do:
     9777             case buf_cash-dis-rule.value-type:
     9778               when integer('1':U) then do:
     9779                 assign
     9780                 temp-disc-dec = - buf_cash-dis-rule.discnt-value
     9781                 .
     9782               end.
     9783               when integer('11':U) then do:
     9784                 find first cash-gds-discnt where
     9785                           cash-gds-discnt.b-code = cash-gds.b-code
     9786                       and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
     9787                       and cash-gds-discnt.obj-type = 'маг':U
     9788                       and cash-gds-discnt.obj-code = i-obj-code
     9789                       no-error.
     9790                 if available cash-gds-discnt then do:
     9791                   assign
     9792                   temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) /  cash-gds.price-sale * 100
     9793                   .
     9794                 end.
     9795                 else do:
     9796                   assign
     9797                   temp-disc-dec = 0.
     9798                 end.
     9799               end.
     9800               otherwise do:
     9801                 temp-disc-dec = 0.
     9802               end.
     9803             end case.
     9804           end.
     9805           assign
     9806           temp-disc-reason = 0
     9807           temp-disc-weekday = 0
     9808           no-error
     9809           .
     9810           assign
     9811           temp-disc-start = cash-dis-time-rule.date-from
     9812           temp-disc-end   = cash-dis-time-rule.date-to
     9813           temp-disc-time-start = (if cash-dis-time-rule.time-from >= 0 then cash-dis-time-rule.time-from else 0)
     9814           temp-disc-time-end = (if cash-dis-time-rule.time-to >= 0 then cash-dis-time-rule.time-to else 0)
     9815           temp-disc-weekday = (if cash-dis-time-rule.week-day-1 then 1 else 0) +
     9816                               (if cash-dis-time-rule.week-day-2 then 2 else 0) +
     9817                               (if cash-dis-time-rule.week-day-3 then 3 else 0) +
     9818                               (if cash-dis-time-rule.week-day-4 then 4 else 0) +
     9819                               (if cash-dis-time-rule.week-day-5 then 5 else 0) +
     9820                               (if cash-dis-time-rule.week-day-6 then 6 else 0) +
     9821                               (if cash-dis-time-rule.week-day-7 then 7 else 0)
     9822           .
     9823           if temp-disc-end <> 12/31/1989 and temp-disc-end < today then
     9824           assign
     9825           temp-disc-dec = 0
     9826           temp-disc-reason = 0
     9827           temp-disc-weekday = 0
     9828           temp-disc-time-start = 0
     9829           temp-disc-time-end = 0
     9830           temp-disc-start = 12/31/1989
     9831           temp-disc-end = 12/31/9999
     9832           .
     9833           run bgelib-tag-open in this-procedure ( input 3, input "ItemTimeDisc", input "" ).
     9834           run bgelib-tag-put in this-procedure ( input 4, input "ITDEvery"     , input string(temp-disc-weekday), input 1 ).
     9835           run bgelib-tag-put in this-procedure ( input 4, input "ITDValue" , input string(temp-disc-dec), input 1 ).
     9836           if temp-disc-start <> ? then
     9837           run bgelib-tag-put in this-procedure ( input 4, input "ITDBeg" , input Xml-CD-DateTimetoString(temp-disc-start, temp-disc-time-start), input 1 ).
     9838           if temp-disc-end <> ? then
     9839           run bgelib-tag-put in this-procedure ( input 4, input "ITDEnd" , input Xml-CD-DateTimetoString(temp-disc-end, temp-disc-time-end), input 1 ).
     9840           run bgelib-tag-put in this-procedure ( input 4, input "ITDReason" , input string(temp-disc-reason), input 1 ).
     9841           run bgelib-tag-close in this-procedure ( input 3, input "ItemTimeDisc").
     9842         end.
     9843       end.
     9844     end.
     9845     else do:
     9846         run bgelib-tag-open in this-procedure ( input 3, input "ItemTimeDisc", input "" ).
     9847         run bgelib-tag-close in this-procedure ( input 3, input "ItemTimeDisc").
     9848     end.
     9849     if cash-gds.qnty-discnt-rule <> 0 then do:
     9850       for each cash-dis-rule no-lock where
     9851               cash-dis-rule.upper-rule-num = cash-gds.qnty-discnt-rule
     9852         :
     9853         run bgelib-tag-open in this-procedure ( input 3, input "ItemQtyDisc", input "" ).
     9854         run bgelib-tag-put in this-procedure ( input 4, input "IQty", input string(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate), input 1 ).
     9855         run bgelib-tag-put in this-procedure ( input 4, input "IQPercent" , input string(- cash-dis-rule.discnt-value),  input 1 ).
     9856         if v-version-dec >= 1.09 then do:
     9857             run bgelib-tag-put in this-procedure ( input 4, input "IQType"
     9858                                                 , input string(if cash-dis-rule.value-type = integer('2':U)
     9859                                                                 then 1
     9860                                                                 else 0)
     9861                                                   , input 1 ).
     9862             run bgelib-tag-put in this-procedure ( input 4, input "IQPayRestriction"
     9863                                                  , input string(if cash-dis-rule.templ-rl-root = 73
     9864                                                                 or cash-dis-rule.templ-rl-root = 74
     9865                                                                 then cash-dis-rule.key#_one
     9866                                                                 else 0
     9867                                                                 ),  input 1 ).
     9868         end.
     9869         run bgelib-tag-close in this-procedure ( input 3, input "ItemQtyDisc").
     9870       end.
     9871     end.
     9872     else do:
     9873       run bgelib-tag-open in this-procedure ( input 3, input "ItemQtyDisc", input "" ).
     9874       run bgelib-tag-close in this-procedure ( input 3, input "ItemQtyDisc").
     9875     end.
     9876     if cash-gds.kat-discnt-rule <> 0  then do:
     9877       for each cash-dis-rule no-lock where
     9878               cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule   :
     9879         run bgelib-tag-open in this-procedure ( input 3, input "ItemDisCat", input "" ).
     9880         run bgelib-tag-put in this-procedure ( input 4, input "IDCCat" ,  input string(cash-dis-rule.dis-kat), input 1 ).
     9881         if cash-dis-rule.templ-rl-root = 34 then do:
     9882           run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(5), input 1 ).
     9883           run bgelib-tag-put in this-procedure ( input 4, input "IDCLimit", input string(- cash-dis-rule.discnt-value),  input 1 ).
     9884           run bgelib-tag-put in this-procedure ( input 4, input "IDCFactor", input string(cash-dis-rule.tot-sum),  input 1 ).
     9885         end.
     9886         else do:
     9887           case cash-dis-rule.value-type:
     9888             when integer('2':U) then do:
     9889               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(2), input 1 ).
     9890               run bgelib-tag-put in this-procedure ( input 4, input "IDCValue", input string(- cash-dis-rule.discnt-value * cash-gds.cli-base-rate),  input 1 ).
     9891             end.
     9892             when integer('1':U) then do:
     9893               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(1), input 1 ).
     9894               run bgelib-tag-put in this-procedure ( input 4, input "IDCPercent", input string(- cash-dis-rule.discnt-value),  input 1 ).
     9895             end.
     9896             when integer('3':U) then do:
     9897               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(3), input 1 ).
     9898               run bgelib-tag-put in this-procedure ( input 4, input "IDCPrice", input string(cash-dis-rule.discnt-value),  input 1 ).
     9899             end.
     9900             when integer('12':U) then do:
     9901               find first cash-gds-discnt where
     9902                         cash-gds-discnt.b-code = cash-gds.b-code
     9903                     and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     9904                   and cash-gds-discnt.obj-type = 'маг':U
     9905                   and cash-gds-discnt.obj-code = i-obj-code
     9906                     no-error.
     9907               if available cash-gds-discnt then do:
     9908                 assign
     9909                 v-kat-discnt = cash-gds-discnt.discnt-value
     9910                 .
     9911               end.
     9912               else do:
     9913                 v-kat-discnt = cash-gds.price-sale.
     9914               end.
     9915               run bgelib-tag-put in this-procedure ( input 4, input "IDCMode" , input string(3), input 1 ).
     9916               run bgelib-tag-put in this-procedure ( input 4, input "IDCPrice", input string(v-kat-discnt),  input 1 ).
     9917             end.
     9918           end case.
     9919         end.
     9920         run bgelib-tag-close in this-procedure ( input 3, input "ItemDisCat").
     9921       end.
     9922     end.
     9923     else do:
     9924       run bgelib-tag-open in this-procedure ( input 3, input "ItemDisCat", input "" ).
     9925       run bgelib-tag-close in this-procedure ( input 3, input "ItemDisCat").
     9926     end.
     9927   if pos-type <> 'InfoKiosk':U then do:
     9928         if tax-cass
     9929         AND vaction = "U" then do:
     9930           do i-entry = 1 to num-entries(cash-gds.tax-string, chr(32)):
     9931             if entry(i-entry, cash-gds.tax-string, chr(32)) <> "":U then do:
     9932               run bgelib-tag-open in this-procedure ( input 3, input "ItemTax", input "" ).
     9933               run bgelib-tag-put in this-procedure ( input 4, input "ITCode"  , input entry(i-entry, cash-gds.tax-string, chr(32)), input 1 ).
     9934               run bgelib-tag-close in this-procedure ( input 3, input "ItemTax").
     9935             end.
     9936           end.
     9937         end.
     9938       end.
     9939   end.
     9940   run gds-attr-value in this-procedure (
     9941                                    input cash-gds.gds-code
     9942                                   ,input 'emrc-type':U
     9943                                   ,output v-attr-emrc
     9944                                   ,output v-attr-type) no-error.
     9945   run bgelib-tag-put in this-procedure ( input 3, input "Item_EMRC"  , input v-attr-emrc , input 1 ).
     9946   vGdsTabak = if vaction = "D" then yes else no.
     9947   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9948                 and buf_goods-attr.attr-code  = 'mark-type':U and buf_goods-attr.attr-value <> "not-type" no-error .
     9949       if available (buf_goods-attr)
     9950          and MarkType:GetKeyIntDB(buf_goods-attr.attr-value) > 0
     9951       then do:
     9952         run bgelib-tag-put in this-procedure ( input 3, input "ItemDataMatrixType"  , input string(MarkType:GetKeyIntDB(buf_goods-attr.attr-value)) , input 1 ).
     9953         v-mark = yes .
     9954         if buf_goods-attr.attr-value eq MarkType:tabak:NameProp
     9955         then do:
     9956            vGdsTabak = yes.
     9957         end.
     9958       end.
     9959       else do:
     9960         run bgelib-tag-put in this-procedure ( input 3, input "ItemDataMatrixType"  , input "0", input 1 ).
     9961       end.
     9962       find FIRST buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code and buf_goods-attr.attr-code = "gds-CommodityCode" no-error.
     9963       if available buf_goods-attr then
     9964       do:
     9965         run bgelib-tag-put in this-procedure ( input 4, input "ItemCommodityCode" , input string( buf_goods-attr.attr-value), input 1 ).
     9966       end.
     9967   find first buf_goods-attr where buf_goods-attr.gds-code = cash-gds.gds-code
     9968                 and buf_goods-attr.attr-code  = 'oper-serv-idd':U no-error.
     9969     if available buf_goods-attr then do:
     9970               run bgelib-tag-put in this-procedure ( input 3, input "ItemOSPayAgent"  , input string(buf_goods-attr.attr-value), input 1 ).
     9971     end.
     9972     else do:
     9973               run bgelib-tag-put in this-procedure ( input 3, input "ItemOSPayAgent"  , input "0", input 1 ).
     9974     end.
     9975   run bgelib-tag-close in this-procedure ( input 2, input "Item").
     9976     if v-attr-egais = 1 then do:
     9977           run bgelib-tag-open in this-procedure ( input 2, input "ItemMarkCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     9978                                             ,"ADD":U, OS2-time,cash-gds.b-code)).
     9979           find first buf_alc-type-gds where buf_alc-type-gds.gds-code = cash-gds.gds-code no-lock no-error.
     9980           find first buf_alc-type where buf_alc-type.alc-type-inner-code = buf_alc-type-gds.alc-type-inner-code no-lock no-error.
     9981           if available buf_alc-type then do:
     9982             run bgelib-tag-put in this-procedure ( input 3, input "IMarkCode" , input string(buf_alc-type.alc-type-code), input 1 ).
     9983           end.
     9984           find first bb_goods where bb_goods.gds-code = cash-gds.gds-code no-lock no-error .
     9985           run bgelib-tag-put in this-procedure ( input 3, input "IMarkVolume" , input string(bb_goods.ms-base), input 1 ).
     9986           run bgelib-tag-put in this-procedure ( input 3, input "IMarkQnty" , input string(cash-gds.cli-base-rate), input 1 ).
     9987           run bgelib-tag-put in this-procedure ( input 3, input "IMarkAlc" ,    input string(bb_goods.proof), input 1 ).
     9988           run bgelib-tag-close in this-procedure ( input 2, input "ItemMarkCode").
     9989       end.
     9990   for each buf_cash-gds no-lock where
     9991             buf_cash-gds.b-code = cash-gds.b-code
     9992         AND buf_cash-gds.obj-type = 'маг':U
     9993         AND buf_cash-gds.obj-code = abs(i-obj-code)
     9994             :
     9995      if LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0 and buf_cash-gds.b-str = "" and ub.shop.cd-sc-base  then NEXT.
     9996      if (ub.shop.cd-loc-base = no and buf_cash-gds.is-main-code = yes) then next.
     9997      v-IBCType = 0 .
     9998      if v-mark then do:
     9999          find first buf_prod-bc no-lock where buf_prod-bc.b-code = buf_cash-gds.b-code and buf_prod-bc.bc-on-type = 'GTIN':U
    10000                                           and buf_prod-bc.b-str = buf_cash-gds.b-str no-error .
    10001          if available (buf_prod-bc) then do:
    10002          v-IBCType = 2 .
    10003          end.
    10004          else do:
    10005          find first buf_prod-bc-attr no-lock where buf_prod-bc-attr.b-code = buf_cash-gds.b-code
    10006                                 and buf_prod-bc-attr.b-str = buf_cash-gds.b-str
    10007                                 and buf_prod-bc-attr.attr-code = 'mark':U
    10008                                 no-error .
    10009          if available (buf_prod-bc-attr) and buf_prod-bc-attr.attr-value = "yes" then
    10010            v-IBCType = 1 .
    10011        end.
    10012      end.
    10013     if v-mark and buf_cash-gds.b-str = "" then v-IBCType = 1 .
    10014     find first ub.prod-bc no-lock where ub.prod-bc.b-str = buf_cash-gds.b-str and ub.prod-bc.b-str <> "" and ub.prod-bc.bc-on-type = 'GTIN':U
    10015     no-error .
    10016     define variable vBarCode1 as int no-undo.
    10017     define variable vBarCode2 as int no-undo.
    10018     if available (ub.prod-bc) then do:
    10019       if cash-gds.cli-base-rate eq 1
    10020       then do:
    10021          v-i-cli-qnty = 999999999.
    10022          for each buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    10023                                     and buf_bar-code_cl.cli-base-rate ne cash-gds.cli-base-rate
    10024          no-lock:
    10025            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    10026            if v-i-cli-qnty =  buf_bar-code_cl.cli-base-rate
    10027            then
    10028               vBarCode1 = buf_bar-code_cl.b-code.
    10029          end.
    10030          if vaction = "D" and
    10031             v-i-cli-qnty = 999999999
    10032          then do:
    10033             assign
    10034                v-i-cli-qnty = cash-gds.cli-base-rate
    10035                vBarCode1 = cash-gds.main-prt-b-code
    10036                .
    10037          end.
    10038       end.
    10039       else do:
    10040          v-i-cli-qnty = 999999999.
    10041          for first buf_bar-code_cl where buf_bar-code_cl.gds-code      eq cash-gds.gds-code
    10042                                     and buf_bar-code_cl.cli-base-rate eq 1
    10043          no-lock:
    10044            v-i-cli-qnty = min (v-i-cli-qnty, buf_bar-code_cl.cli-base-rate).
    10045            vBarCode2 = buf_bar-code_cl.b-code.
    10046          end.
    10047          if vaction = "D" and
    10048             v-i-cli-qnty = 999999999
    10049          then do:
    10050             assign
    10051                v-i-cli-qnty = cash-gds.cli-base-rate
    10052                vBarCode2 = cash-gds.main-prt-b-code
    10053                .
    10054          end.
    10055       end.
    10056       if vGdsTabak then do:
    10057          block-cli:
    10058          do v-i-cli = 1 to 2:
    10059            if (      v-i-cli-qnty eq 999999999
    10060                  and v-i-cli eq 2
    10061                  and cash-gds.cli-base-rate eq 1  )
    10062               or (   v-i-cli-qnty eq 999999999
    10063                  and v-i-cli eq 1
    10064                  and cash-gds.cli-base-rate ne 1  )
    10065            then
    10066               next block-cli.
    10067            v-cli-base = string (v-i-cli,"99").
    10068            run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
    10069                                                , (if vaction = "U"
    10070                                                   then (if buf_cash-gds.bc-on eq yes then "ADD":U else "DEL":U)
    10071                                                   else "DEL":U)
    10072                                                 , OS2-time
    10073                                                , string(v-cli-base + buf_cash-gds.b-str))).
    10074            run bgelib-tag-put in this-procedure ( input 3, input "IBCCode"
    10075                                                 , input string( if v-i-cli eq 1 and cash-gds.cli-base-rate ne 1
    10076                                                                  then vBarCode2
    10077                                                                  else if v-i-cli eq 2 and cash-gds.cli-base-rate eq 1
    10078                                                                  then vBarCode1
    10079                                                                  else cash-gds.main-prt-b-code )
    10080                                                 , input 1 ).
    10081            if vaction = 'U':U then do:
    10082              run bgelib-tag-put in this-procedure ( input 3, input "IBCProducer"
