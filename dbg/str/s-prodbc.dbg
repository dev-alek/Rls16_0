     6102   procedure fact-order-mpl :
     6103     do
     6104     on error undo, return error return-value
     6105     :
     6106   define input  parameter p-doc-date as date     no-undo .
     6107   define input  parameter p-obj-type as character no-undo .
     6108   define input  parameter p-obj-code as integer   no-undo .
     6109   define output parameter p-fact-order as decimal   no-undo .
     6110   define variable v-fact-date            as date    no-undo .
     6111   define variable v-fact-time            as integer no-undo .
     6112   define variable v-fact-order           as decimal no-undo .
     6113   define variable v-shift-end-fact-order as decimal no-undo .
     6114   define variable v-day-end-fact-order   as decimal no-undo .
     6115   define variable l-shift-on as logical no-undo .
     6116   define variable l-date as date      no-undo .
     6117   define variable l-time as integer   no-undo .
     6118   define variable shift-date as date      no-undo .
     6119   define variable shift-num  as integer   no-undo .
     6120   define variable shift-name as character no-undo .
     6121   define variable max-fact-order as decimal   no-undo .
     6122   define buffer buf_global-state for ub.global-state  .
     6123   find first buf_global-state no-lock no-error .
     6124   if not available buf_global-state then do:
     6125      message
     6126        "Не заданы параметры ценообразования!"
     6127        view-as alert-box error
     6128      .
     6129      return error return-value .
     6130   end.
     6131     run cur-time in this-procedure
     6132     ( output v-fact-date ,
     6133       output v-fact-time  ).
     6134   if p-doc-date = ? then do:
     6135   if buf_global-state.pl-use-sys-date-time  = true then do:
     6136         run factord in this-procedure
     6137           (input  v-fact-date
     6138           ,input  v-fact-time
     6139           ,input  v-fact-time
     6140           ,input  ?
     6141           ,input  ?
     6142           ,input  false
     6143           ,output v-fact-order
     6144           ,output v-shift-end-fact-order
     6145           ,output v-day-end-fact-order
     6146           ) no-error .
     6147         if error-status :error
     6148         or v-fact-order = ?
     6149         or v-fact-order = 0 then do:
     6150           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6151         end.
     6152         p-fact-order = v-fact-order .
     6153   end.
     6154   else do:
     6155   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6156   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6157     (input  p-obj-type
     6158     ,input  p-obj-code
     6159     ,input  'shift-on=request'
     6160     ,output l-shift-on
     6161     ) no-error .
     6162         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6163         if p-doc-date <> ? then do:
     6164         end.
     6165          run gbl/factdate.p
     6166          ( input        p-obj-type  ,
     6167            input        p-obj-code  ,
     6168            input-output v-fact-date ,
     6169            input-output v-fact-time ,
     6170            input-output shift-date      ,
     6171            input-output shift-num       ,
     6172            input-output shift-name      ,
     6173            input        yes
     6174            ) no-error .
     6175         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6176         run factord in this-procedure
     6177           (input  v-fact-date
     6178           ,input  v-fact-time
     6179           ,input  v-fact-time
     6180           ,input  shift-date
     6181           ,input  shift-num
     6182           ,input  l-shift-on
     6183           ,output v-fact-order
     6184           ,output v-shift-end-fact-order
     6185           ,output v-day-end-fact-order
     6186           ) no-error .
     6187         if error-status :error
     6188         or v-fact-order = ?
     6189         or v-fact-order = 0 then do:
     6190           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6191         end.
     6192         p-fact-order = v-fact-order .
     6193   end.
     6194   end.
     6195   else do:
     6196          run gbl/factdate.p
     6197          ( input        p-obj-type  ,
     6198            input        p-obj-code  ,
     6199            input-output v-fact-date ,
     6200            input-output v-fact-time ,
     6201            input-output shift-date      ,
     6202            input-output shift-num       ,
     6203            input-output shift-name      ,
     6204            input        yes
     6205            ) no-error .
     6206         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6207         v-fact-date = p-doc-date .
     6208         run factord in this-procedure
     6209           (input  v-fact-date
     6210           ,input  v-fact-time
     6211           ,input  v-fact-time
     6212           ,input  shift-date
     6213           ,input  shift-num
     6214           ,input  l-shift-on
     6215           ,output v-fact-order
     6216           ,output v-shift-end-fact-order
     6217           ,output v-day-end-fact-order
     6218           ) no-error .
     6219         if error-status :error
     6220         or v-fact-order = ?
     6221         or v-fact-order = 0 then do:
     6222           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6223         end.
     6224         p-fact-order = v-fact-order .
     6225   end.
     6226     end.
     6227   end procedure.
