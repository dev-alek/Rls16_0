    14098   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14099   PROCEDURE putc-13.
    14100   define parameter buffer buf_cash-desk for ub.cash-desk.
    14101   define input parameter pos-type as char no-undo.
    14102   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    14103   define input parameter p-call-from-goods as logical no-undo .
    14104   define variable ii as integer no-undo .
    14105   define variable v-rate-code like ub.tax-rate.rate-code no-undo .
    14106   define variable v-envd as LOGICAL no-undo .
    14107   define variable v-plu as integer no-undo .
    14108   define buffer buf_tax-rate for ub.tax-rate.
    14109   define buffer buf_tax-rate-attr for ub.tax-rate-attr.
    14110   if cash-txr.rate-value = ?
    14111   and not (cash-txr.news-action OR cash-txr.status_ <> 'тек':U)
    14112   then do:
    14113       run write-log-and-file in p-log-handle (
    14114             input 1
    14115           , input log-file-name
    14116           , input 1
    14117           , input substitute( "!!!Для маг &1 ставка налога &2 НЕ ОПРЕДЕЛЕНА"
    14118                               ,buf_cash-desk.obj-code
    14119                               ,cash-txr.rate-code
    14120                             )
    14121                                             ).
    14122       v-view-log = yes.
    14123       return '':U .
    14124   end.
    14125   CASE pos-type:
    14126     when 'IBM':U then do:
    14127      if cd-vat = 0 or p-cash-os = "LINUX":U then do:
    14128         PUT stream IBMstream unformatted
    14129         '13 "'
    14130         if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    14131         then "D"
    14132         else string( action, "x(1)" )
    14133         '" '
    14134         cash-txr.tax-code format "9"
    14135         ' '
    14136         cash-txr.rate-code
    14137         ' '
    14138         (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    14139         (if cash-txr.rate-value = ?
    14140           then 0
    14141           else cash-txr.rate-value) format ">>>>>>>>>9.99"
    14142         chr(10).
    14143       end.
    14144       else do:
    14145         _do:
    14146         do ii = 1 to num-entries(cdtaxlst, ";":U):
    14147           assign
    14148           v-rate-code = integer(entry(1, entry(ii, cdtaxlst, ";":U), "-":U))
    14149           no-error .
    14150           if error-status:error then do:
    14151             message
    14152             "Неверное значение настроечного параметра cdtaxlst" cdtaxlst
    14153             view-as alert-box error .
    14154             return error .
    14155           end.
    14156           find first buf_tax-rate no-lock where
    14157                     buf_tax-rate.rate-code = v-rate-code no-error .
    14158           if not available buf_tax-rate then do:
    14159             run write-log-and-file in p-log-handle (
    14160                   input 1
    14161                 , input log-file-name
    14162                 , input 1
    14163                 , input substitute( "!!!Для маг &1 ставка налога &2 не входит в число действующих на кассе &2"
    14164                                     ,buf_cash-desk.obj-code
    14165                                     ,v-rate-code
    14166                                     ,buf_Cash-desk.pos-type
    14167                                   )
    14168                                                   ).
    14169             v-view-log = yes.
    14170             return error .
    14171           end.
    14172           if buf_tax-rate.rate-code = cash-txr.rate-code then do:
    14173             PUT stream IBMstream unformatted
    14174             '13 "'
    14175             if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    14176             then "D"
    14177             else string( action, "x(1)" )
    14178             '" '
    14179             convert-tax-code(buf_tax-rate.rate-code, cdtaxlst)  format "9"
    14180             ' '
    14181             cash-txr.rate-code
    14182             ' '
    14183             (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    14184             (if cash-txr.rate-value = ?
    14185             then 0
    14186             else cash-txr.rate-value) format ">>>>>>>>>9.99"
    14187             chr(10).
    14188           end.
    14189         end.
    14190       end.
    14191     end.
    14192     when 'IBM-XML':U then do:
    14193         find first buf_tax-rate-attr where buf_tax-rate-attr.rate-code = cash-txr.rate-code
    14194                                        and buf_tax-rate-attr.tax-code = cash-txr.tax-code
    14195                                        and buf_tax-rate-attr.attr-code = "envd" no-error .
    14196          if AVAILABLE buf_tax-rate-attr then do:
    14197              v-envd = yes .
    14198          end.
    14199          else v-envd = no .
    14200       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    14201                                             , input "":U).
    14202       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    14203                                             , input string(cash-txr.rate-code), input 1 ).
    14204       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    14205                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    14206       if v-envd then do:
    14207       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    14208                                             , input string(-1), input 1 ).
    14209       end.
    14210       else do:
    14211       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    14212                                             , input string(if cash-txr.rate-value = ?
    14213                                                            then 0
    14214                                                            else cash-txr.rate-value), input 1 ).
    14215       end.
    14216       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    14217                                             , input string(1), input 1 ).
    14218       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    14219     end.
    14220     when 'MAGIA-XML':U then do:
    14221       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    14222                                             , input "":U).
    14223       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    14224                                             , input string(cash-txr.rate-code), input 1 ).
    14225       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    14226                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    14227       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    14228                                             , input string(if cash-txr.rate-value = ?
    14229                                                            then 0
    14230                                                            else cash-txr.rate-value), input 1 ).
    14231       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    14232                                             , input string(1), input 1 ).
    14233       run bgelib-tag-put in this-procedure ( input 4, input "TCLock"
    14234                                             , input string(if cash-txr.news-action
    14235                                                            OR cash-txr.status_ <> 'тек':U
    14236                                                            then 1
    14237                                                            else 0), input 1 ).
    14238       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    14239     end.
    14240     when 'MARIA':U then do:
    14241     end.
    14242   END CASE .
    14243   END PROCEDURE .
    14244   procedure get-o-attr :
    14245   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    14246   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    14247   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    14248   define output parameter par-std-discnt-rule as integer no-undo .
    14249   define output parameter par-temp-disc-rule as integer no-undo .
    14250   define output parameter par-temp-disc-method as character no-undo .
    14251   define output parameter par-wd-rule as integer no-undo .
    14252   define output parameter par-fp as logical no-undo .
    14253   define output parameter par-grp-code as integer no-undo init 1.
    14254   define output parameter par-petrol-purse as logical no-undo .
    14255   define output parameter par-need-auth as logical no-undo .
    14256   define output parameter par-qnty-discnt-rule as integer no-undo .
    14257   define output parameter par-kat-discnt-rule as integer no-undo .
    14258   define output parameter par-kat-discnt-method as character no-undo .
    14259   define output parameter par-date-discnt-rule as integer no-undo .
    14260   define output parameter par-abs-discnt-rule as integer no-undo .
    14261   define output parameter par-tot-discnt-rule as integer no-undo .
    14262   define output parameter par-wgd-rule as integer no-undo .
    14263   define output parameter par-taracode as character no-undo .
    14264   define buffer loc-gds-obj-attr for ub.gds-obj-attr.
    14265   define buffer loc-dis-gds-rule for ub.dis-gds-rule.
    14266   define buffer buf_dis-rule for ub.dis-rule.
    14267   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
    14268   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    14269     do
    14270     on error undo, return error
    14271     :
    14272       for each  loc-gds-obj-attr No-LOCK  where
    14273                 loc-gds-obj-attr.gds-code = par-gds-code AND
    14274                 loc-gds-obj-attr.obj-code = par-obj-code AND
    14275                 loc-gds-obj-attr.obj-type = par-obj-type :
    14276         CASE loc-gds-obj-attr.attr-code:
    14277           when 'free-price':U  then do:
    14278             assign
    14279             par-fp =  if loc-gds-obj-attr.attr-value = "yes"
    14280                       then yes
    14281                       else no
    14282             .
    14283           end.
    14284           when 'sum-grp':U then do:
    14285             assign
    14286             par-grp-code =  integer(loc-gds-obj-attr.attr-value) no-error
    14287             .
    14288           end.
    14289           when 'petrol-purse':U then do:
    14290             assign
    14291             par-petrol-purse =  if loc-gds-obj-attr.attr-value = "yes"
    14292                                 then yes
    14293                                 else no
    14294             .
    14295           end.
    14296           when 'need-auth':U then do:
    14297             assign
    14298             par-need-auth =  if loc-gds-obj-attr.attr-value = "yes"
    14299                                 then yes
    14300                                 else no
    14301             .
    14302           end.
    14303           when 'taracode':U  then do:
    14304             assign
    14305             par-taracode = loc-gds-obj-attr.attr-value no-error
    14306             .
    14307           end.
    14308         END CASE.
    14309       end.
    14310       define variable v-par-log as logical no-undo .
    14311      find first loc-dis-gds-rule where
    14312                 loc-dis-gds-rule.gds-code = par-gds-code
    14313             and loc-dis-gds-rule.pos-type = dflt-cd
    14314             and loc-dis-gds-rule.obj-type = ''
    14315             and loc-dis-gds-rule.obj-code = 0
    14316             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    14317       if available loc-dis-gds-rule then do:
    14318         par-wgd-rule = loc-dis-gds-rule.rule-num.
    14319       end.
    14320       find first loc-dis-gds-rule where
    14321                 loc-dis-gds-rule.gds-code = par-gds-code
    14322             and loc-dis-gds-rule.pos-type = dflt-cd
    14323             and loc-dis-gds-rule.obj-type = ''
    14324             and loc-dis-gds-rule.obj-code = 0
    14325             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    14326       if available loc-dis-gds-rule then do:
    14327         par-wd-rule = loc-dis-gds-rule.rule-num.
    14328       end.
    14329       define variable loc-host-code as integer no-undo .
    14330   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    14332     (input  par-obj-type
    14333     ,input  par-obj-code
    14334     ,output loc-host-code
    14335     )  .
    14336       find first loc-dis-gds-rule where
    14337                 loc-dis-gds-rule.gds-code = par-gds-code
    14338             and loc-dis-gds-rule.pos-type = dflt-cd
    14339             and loc-dis-gds-rule.obj-type = 'орг':U
    14340             and loc-dis-gds-rule.obj-code = loc-host-code
    14341             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    14342       if available loc-dis-gds-rule then do:
    14343         par-wgd-rule = loc-dis-gds-rule.rule-num.
    14344       end.
    14345       find first loc-dis-gds-rule where
    14346                 loc-dis-gds-rule.gds-code = par-gds-code
    14347             and loc-dis-gds-rule.pos-type = dflt-cd
    14348             and loc-dis-gds-rule.obj-type = 'орг':U
    14349             and loc-dis-gds-rule.obj-code = loc-host-code
    14350             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    14351       if available loc-dis-gds-rule then do:
    14352         par-wd-rule = loc-dis-gds-rule.rule-num.
    14353       end.
    14354       if par-wd-rule > 0 then do:
    14355         find first buf_dis-rule no-lock where
    14356                   buf_Dis-rule.rule-num = par-wd-rule no-error.
    14357         if available buf_dis-rule then do:
    14358           run create-dis-rule in this-procedure ( input buf_dis-rule.rule-num
    14359                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    14360         end.
    14361       end.
    14362       if par-wgd-rule > 0 then do:
    14363         find first buf_dis-rule no-lock where
    14364                   buf_Dis-rule.rule-num = par-wgd-rule no-error.
    14365         if available buf_dis-rule then do:
    14366           run create-dis-rule in this-procedure ( input buf_dis-rule.rule-num
    14367                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    14368         end.
    14369       end.
    14370       for each  loc-dis-gds-rule No-LOCK  where
    14371                 loc-dis-gds-rule.gds-code = par-gds-code
    14372            AND  loc-dis-gds-rule.obj-code = par-obj-code
    14373            AND  loc-dis-gds-rule.obj-type = par-obj-type
    14374            and  loc-dis-gds-rule.pos-type = dflt-cd :
    14375         CASE loc-dis-gds-rule.discnt-role:
    14376           when 'std-disc':U then do:
    14377             assign
    14378             par-std-discnt-rule = loc-dis-gds-rule.rule-num
    14379             .
    14380           end.
    14381           when 'temp-disc':U then do:
    14382             if loc-dis-gds-rule.nonunique = ''
    14383             then do:
    14384             assign
    14385             par-temp-disc-rule = loc-dis-gds-rule.rule-num
    14386             .
    14387           end.
    14388             else do:
    14389               if par-temp-disc-method = '' then do:
    14390                 find first buf_dis-cfg-rule no-lock where
    14391                           buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
    14392                       and buf_dis-cfg-rule.pos-type = dflt-cd
    14393                       and buf_dis-cfg-rule.templ-rl-root = loc-dis-gds-rule.templ-rl-root no-error.
    14394                 assign
    14395                 par-temp-disc-method = (if available buf_dis-cfg-rule
    14396                                         then buf_dis-cfg-rule.nonunique
    14397                                         else chr(63))
    14398                 .
    14399               end.
    14400               create buf_temp-dis-gds-rule.
    14401               buffer-copy
    14402               loc-dis-gds-rule
    14403               to
    14404               buf_temp-dis-gds-rule
    14405               .
    14406               release buf_temp-dis-gds-rule.
    14407             end.
    14408           end.
    14409           when 'pcnt-kat':U then do:
    14410             if loc-dis-gds-rule.nonunique = ''
    14411             then do:
    14412               assign
    14413               par-kat-discnt-rule = loc-dis-gds-rule.rule-num
    14414               .
    14415             end.
    14416             else do:
    14417               if par-kat-discnt-method = '' then do:
    14418                 find first buf_dis-cfg-rule no-lock where
    14419                           buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
    14420                       and buf_dis-cfg-rule.pos-type = dflt-cd
    14421                       and buf_dis-cfg-rule.templ-rl-root = loc-dis-gds-rule.templ-rl-root no-error.
    14422                 assign
    14423                 par-kat-discnt-method = (if available buf_dis-cfg-rule
    14424                                         then buf_dis-cfg-rule.nonunique
    14425                                         else chr(63))
    14426                 .
    14427               end.
    14428               create buf_temp-dis-gds-rule.
    14429               buffer-copy
    14430               loc-dis-gds-rule
    14431               to
    14432               buf_temp-dis-gds-rule
    14433               .
    14434               release buf_temp-dis-gds-rule.
    14435             end.
    14436           end.
    14437           when 'pcnt-date':U then do:
    14438             assign
    14439             par-date-discnt-rule = loc-dis-gds-rule.rule-num
    14440             .
    14441           end.
    14442           when 'without-disc':U then do:
    14443             assign
    14444             par-wd-rule =  loc-dis-gds-rule.rule-num
    14445             .
    14446           end.
    14447           when 'without-gds-disc':U then do:
    14448             assign
    14449             par-wgd-rule =  loc-dis-gds-rule.rule-num
    14450             .
    14451           end.
    14452           when 'pcnt-qnty':U then do:
    14453             assign
    14454             par-qnty-discnt-rule = loc-dis-gds-rule.rule-num
    14455             .
    14456           end.
    14457           when 'pcnt-kat':U  then do:
    14458             assign
    14459             par-kat-discnt-rule = loc-dis-gds-rule.rule-num
    14460             .
    14461           end.
    14462           when 'abs-disc':U  then do:
    14463             assign
    14464             par-abs-discnt-rule = loc-dis-gds-rule.rule-num
    14465             .
    14466           end.
    14467           when 'pcnt-tot':U  then do:
    14468             assign
    14469             par-tot-discnt-rule = loc-dis-gds-rule.rule-num
    14470             .
    14471           end.
    14472         END CASE.
    14473         find first buf_dis-rule no-lock where
    14474                   buf_Dis-rule.rule-num = loc-dis-gds-rule.templ-rl-root no-error.
    14475         if available buf_dis-rule then do:
    14476           run create-dis-rule in this-procedure ( input loc-dis-gds-rule.rule-num
    14477                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    14478         end.
    14479       end.
    14480     end.
    14481   end procedure.
    14482   procedure get-gds-obj-fields :
    14483   define parameter buffer buf_gds-obj for ub.gds-obj .
    14484   define input parameter par-find-buffer as logical no-undo .
    14485   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    14486   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    14487   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    14488   define output parameter par-fact-qnty like ub.gds-obj.fact-qnty no-undo .
    14489   define output parameter par-cash-parts as logical no-undo .
    14490   define output parameter p-is-null-price              like ub.fbr-gds-obj.is-null-price  no-undo .
    14491   define output parameter p-is-menu                    like ub.fbr-gds-obj.is-menu no-undo .
    14492   define output parameter p-is-semi-finished           like ub.fbr-gds-obj.is-semi-finished no-undo .
    14493   define output parameter p-is-modificator             like ub.fbr-gds-obj.is-semi-finished no-undo .
    14494   define output parameter p-fbr-grp-code               like ub.fbr-gds-grp.node-code no-undo .
    14495   define output parameter p-fbr-obj-code               like ub.fbr-gds-obj.fbr-obj-code no-undo .
    14496     do
    14497     on error undo, return error
    14498     :
    14499       if par-find-buffer then do:
    14500         find first buf_gds-obj no-lock where
    14501                   buf_gds-obj.gds-code = par-gds-code AND
    14502                   buf_gds-obj.obj-type = par-obj-type AND
    14503                   buf_gds-obj.obj-code = par-obj-code no-error .
    14504       end.
    14505       if not avail buf_gds-obj
    14506       and ub.shop.is-catering = no
    14507       then do:
    14508         return.
    14509       end.
    14510       assign
    14511       par-fact-qnty = (if available buf_gds-obj
    14512                        then buf_gds-obj.fact-qnty
    14513                        else 0)
    14514       .
    14515       assign
    14516       par-cash-parts = (if available buf_gds-obj
    14517                         then buf_gds-obj.cash-parts
    14518                         else no)
    14519       .
    14520       if available buf_fbr-gds-obj then do:
    14521         assign
    14522         p-is-null-price     =  buf_fbr-gds-obj.is-null-price
    14523         p-is-menu           =  buf_fbr-gds-obj.is-menu
    14524         p-is-semi-finished  =  buf_fbr-gds-obj.is-semi-finished
    14525         p-is-modificator    =  buf_fbr-gds-obj.is-modificator
    14526         p-fbr-grp-code      =  buf_fbr-gds-obj.fbr-grp-code
    14527         p-fbr-obj-code      =  buf_fbr-gds-obj.fbr-obj-code
    14528         .
    14529       end.
    14530     end.
    14531   end procedure.
    14532   procedure get-prt-and-unit :
    14533   define input parameter par-prt-root like ub.goods.prt-root no-undo .
    14534   define input parameter par-unit-base like ub.goods.unit-base no-undo .
    14535   define output parameter par-empty-scale as logical no-undo .
    14536     do
    14537     on error undo, return error
    14538     :
    14539       FIND FIRST ub.gds-prt where
    14540                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
    14541       assign
    14542       par-empty-scale = NOT (ub.shop.doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
    14543       .
    14544       FIND FIRST ub.units WHERE
    14545                  ub.units.unit-name = par-unit-base NO-LOCK .
    14546     end.
    14547   end procedure.
    14548   define variable vss-include-info122 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14549   procedure create-ncr-kat-discnt :
    14550   define input parameter p-subject-code as character no-undo .
    14551   define input parameter p-cd-subject-code as character no-undo .
    14552   define input parameter p-subject-name as character no-undo .
    14553   define input parameter p-dis-rule-num like ub.dis-rule.rule-num no-undo .
    14554   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
    14555   define input parameter p-tree as character no-undo .
    14556   define input parameter p-discnt as decimal no-undo .
    14557   define variable v-dis-rule-num as integer no-undo .
    14558   define variable v-tree as logical no-undo init yes.
    14559   define variable v-discnt as decimal no-undo .
    14560   define variable v-dis-kat as integer   no-undo .
    14561   define buffer buf_cash-dis-rule for cash-dis-rule.
    14562   define buffer buf_cash-dis-time-rule for cash-dis-time-rule.
    14563   define buffer slave_cash-dis-rule for cash-dis-rule.
    14564     do
    14565     on error undo, return error
    14566     :
    14567       v-discnt = p-discnt.
    14568       if p-dis-rule-num > 0 then do:
    14569         find first buf_cash-dis-rule no-lock where
    14570                   buf_cash-dis-rule.rule-num = p-dis-rule-num no-error.
    14571         if not available buf_cash-dis-rule
    14572         or (buf_cash-dis-rule.templ-rl-root <> p-templ-rl-root
    14573            and
    14574            p-templ-rl-root <> ?)
    14575         then do:
    14576           return error .
    14577         end.
    14578         if p-templ-rl-root = ? then do:
    14579           p-templ-rl-root = buf_cash-dis-rule.templ-rl-root.
    14580         end.
    14581         if buf_cash-dis-rule.uniq-field = ''
    14582         or buf_cash-dis-rule.is-term
    14583         then do:
    14584           v-tree = no.
    14585           v-dis-rule-num = buf_cash-dis-rule.upper-rule-num.
    14586         end.
    14587         if buf_cash-dis-rule.time-rule-num > 0 then do:
    14588           find first buf_cash-dis-time-rule no-lock where
    14589                   buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
    14590           if not available buf_cash-dis-time-rule then do:
    14591             return error .
    14592           end.
    14593           release buf_cash-dis-time-rule.
    14594         end.
    14595           _buf-cash-dis-rule:
    14596           for each buf_cash-dis-rule no-lock where
    14597                   buf_cash-dis-rule.upper-rule-num = (if v-tree then p-dis-rule-num else v-dis-rule-num):
    14598             if not v-tree then do:
    14599               find first slave_cash-dis-rule no-lock where
    14600                   slave_cash-dis-rule.rule-num = v-dis-rule-num .
    14601               assign v-dis-kat = slave_cash-dis-rule.dis-kat .
    14602               if buf_cash-dis-rule.rule-num <> p-dis-rule-num then next _buf-cash-dis-rule.
    14603             end.
    14604             else
    14605              do:
    14606                assign v-dis-kat = buf_cash-dis-rule.dis-kat .
    14607              end .
    14608             if buf_cash-dis-rule.time-rule-num > 0 then do:
    14609               find first buf_cash-dis-time-rule no-lock where
    14610                         buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
    14611               if not available buf_cash-dis-time-rule then next _buf-cash-dis-rule.
    14612             end.
    14613             FIND FIRST cash-ncr-dis-kat where
    14614                     cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
    14615             if not avail cash-ncr-dis-kat then do:
    14616               create cash-ncr-dis-kat.
    14617               error-status:error = false.
    14618             end.
    14619             cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
    14620             cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
    14621             if buf_cash-dis-rule.value-type = integer('12':U) then do:
    14622               find first cash-gds-discnt where
    14623                         cash-gds-discnt.b-code = integer(p-subject-code)
    14624                     and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
    14625                     and cash-gds-discnt.obj-type = 'маг':U
    14626                     and cash-gds-discnt.obj-code = i-obj-code
    14627                     no-error.
    14628               if available cash-gds-discnt then do:
    14629                 assign
    14630                 v-discnt = cash-gds-discnt.discnt-value
    14631                 .
    14632               end.
    14633               else do:
    14634                 v-discnt = p-discnt.
    14635               end.
    14636             end.
    14637             assign
    14638             cash-ncr-dis-kat.subject-code  =  p-subject-code
    14639             cash-ncr-dis-kat.cd-subject-code  =  p-cd-subject-code
    14640             cash-ncr-dis-kat.cd-subject-name  =  SUBSTRING(p-subject-name, 1, 20)
    14641             cash-ncr-dis-kat.cd-subject-name  =  SUBSTRING(p-subject-name, 1, 20) +
    14642                                                ( if length(p-subject-name) < 20 then fill( chr(32) , 20 - length(p-subject-name) ) else '' )
    14643             cash-ncr-dis-kat.dis-kat =  (if v-dis-kat < 0 then 0 else v-dis-kat)
    14644             cash-ncr-dis-kat.rule-num = buf_cash-dis-rule.rule-num
    14645             cash-ncr-dis-kat.time-rule-num = buf_cash-dis-rule.time-rule-num
    14646             cash-ncr-dis-kat.cd-disc-string   = "****":U  +
    14647                                             (if buf_cash-dis-rule.templ-rl-root = 89
    14648                                              then '80'
    14649                                              else (if buf_cash-dis-rule.discnt-value > 0
    14650                                                    then '80':U
    14651                                                    else '00':U)
    14652                                              )
    14653             .
    14654             if p-tree = 'time-rule-num':U then do:
    14655               if available buf_cash-dis-time-rule
    14656               and buf_cash-dis-time-rule.value-type <> '0':U
    14657               then do:
    14658                 assign
    14659                 cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
    14660                                               (if buf_cash-dis-time-rule.value-type = '2':U
    14661                                                 then
    14662                                                 ("D":U + substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 9, 2) +
    14663                                                         substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 4, 2) +
    14664                                                         substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 1, 2) +
    14665                                                         "-":U +
    14666                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 9, 2) +
    14667                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 4, 2) +
    14668                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 1, 2)
    14669                                                 )
    14670                                                 else
    14671                                                 ("T00":U +
    14672                                                           (if buf_cash-dis-time-rule.week-day-0  then "0" else "":U) +
    14673                                                           (if buf_cash-dis-time-rule.week-day-1  then "2" else "":U) +
    14674                                                           (if buf_cash-dis-time-rule.week-day-2  then "3" else "":U) +
    14675                                                           (if buf_cash-dis-time-rule.week-day-3  then "4" else "":U) +
    14676                                                           (if buf_cash-dis-time-rule.week-day-4  then "5" else "":U) +
    14677                                                           (if buf_cash-dis-time-rule.week-day-5  then "6" else "":U) +
    14678                                                           (if buf_cash-dis-time-rule.week-day-6  then "7" else "":U) +
    14679                                                           (if buf_cash-dis-time-rule.week-day-7  then "1" else "":U) +
    14680                                                         chr(47) +
    14681                                                         replace(string(buf_cash-dis-time-rule.time-from, "HH:MM"), ':':U, '':U) + "-":U +
    14682                                                         replace(string(buf_cash-dis-time-rule.time-to, "HH:MM"), ':':U, '':U)
    14683                                                 )
    14684                                               )
    14685                 .
    14686               end.
    14687               else do:
    14688                 assign
    14689                 cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string + "D000101-991231":U
    14690                 .
    14691               end.
    14692             end.
    14693             if p-tree = 'tot-sum':U then do:
    14694               assign
    14695               cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
    14696               '>' + replace(string(round(buf_cash-dis-rule.tot-sum, 2), '99999999999.99'), '.':u , '':U)
    14697               .
    14698             end.
    14699             assign
    14700             cash-ncr-dis-kat.cd-other =   fill(chr(32), 10) +  "xx ":U +
    14701                                           (if buf_cash-dis-rule.value-type = integer('12':U)
    14702                                            or buf_cash-dis-rule.value-type = integer('3':U)
    14703                                           then "=":U
    14704                                           else "%":U) +
    14705                                           replace(string(abs(if v-discnt <> ? then v-discnt else buf_cash-dis-rule.discnt-value),"9999999.9"), '.':U, '':U)
    14706             .
    14707           end.
    14708       end.
    14709       else do:
    14710         FIND FIRST cash-ncr-dis-kat where
    14711                 cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
    14712         if not avail cash-ncr-dis-kat then do:
    14713         create cash-ncr-dis-kat.
    14714         error-status:error = false.
    14715         end.
    14716         cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
    14717         cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
    14718         assign
    14719         cash-ncr-dis-kat.subject-code  = p-subject-code
    14720         cash-ncr-dis-kat.cd-subject-code  = p-cd-subject-code
    14721         cash-ncr-dis-kat.cd-subject-name  = p-subject-name
    14722         cash-ncr-dis-kat.dis-kat =  - 1
    14723         cash-ncr-dis-kat.rule-num = 0
    14724         cash-ncr-dis-kat.time-rule-num = 0
    14725         .
    14726       end.
    14727     end.
    14728   end procedure.
    14729   procedure output-ncr-bonus:
    14730   define input parameter i-host-code as integer no-undo .
    14731   define input parameter i-obj-code  as integer no-undo .
    14732   define input parameter out         as character no-undo .
    14733   define output parameter fname      as character no-undo .
    14734   def var v-found as log no-undo .
