    12044       output stream plucash close.
    12045       find first temp-dis-kat-file no-lock where                                                       temp-dis-kat-file.dis-kat = v-kat-file-number no-error.                   if not available temp-dis-kat-file then                                                create temp-dis-kat-file.                                                              assign                                                                                 temp-dis-kat-file.dis-kat   = v-kat-file-number                                     .                                                                                      assign                                                                                 temp-dis-kat-file.temp-file = v-temp-kat-file                                          temp-dis-kat-file.send-file = v-kat-file                                               temp-dis-kat-file.to-send   = yes.
    12046     end.
    12047   end.
    12048   if action = 'U':U then do:
    12049     FOR EACH cash-ncr-dis-kat No-LOCK WHERE
    12050             cash-ncr-dis-kat.crf <= cr-ncr-dis-kat
