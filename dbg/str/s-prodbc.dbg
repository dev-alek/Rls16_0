    12828      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    12829      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    12830      then do:
    12831        v-fields-shift103 = - 1.
    12832   if v-record <> '':U then
    12833       run maria-put in this-procedure (
    12834                                       buffer for-cash-desk
    12835                                     , input out
    12836                                     , input fname
    12837                                     , input yes
    12838                                     , input v-fields-shift103
    12839                                     , input yes
    12840                                     , input 24
    12841                                     , input 1
    12842                                     , input string(1)
    12843                                     , input v-record
    12844                                       ).
    12845      end.
    12846   find first temp-tekka-tsk no-error.
    12847   if available temp-tekka-tsk then do:
    12848      v-found103 = yes.
    12849   end.
    12850   if v-found103 = yes then do:
    12851   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
    12852   v-is-script103 = no.
    12853   for each temp-tekka-tsk:
    12854     if (temp-tekka-tsk.num-rec > 0
    12855     or temp-tekka-tsk.send-get = 'task')
    12856     and temp-tekka-tsk.task-num = fname then do:
    12857       export stream IBmSTREAM temp-tekka-tsk.
    12858       v-found103 = yes.
    12859     end.
    12860     if temp-tekka-tsk.is-script then do:
    12861       v-is-script103 = yes.
    12862     end.
    12863     delete temp-tekka-tsk.
    12864   end.
    12865   output stream IBMStream
    12866   close.
