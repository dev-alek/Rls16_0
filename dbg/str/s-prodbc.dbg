    14738   def var v-char-delim-2  as char initial ';' no-undo .
    14739   def var v-char-1        as char no-undo .
    14740   def var v-char-2        as char no-undo .
    14741   def var v-char-21       as char no-undo .
    14742   def var v-char-3        as char no-undo .
    14743   def var v-char-4        as char no-undo .
    14744   def var v-char-41       as char no-undo .
    14745   def var v-char-42       as char no-undo .
    14746   def var v-char-5        as char no-undo .
    14747   def var v-char-6        as char no-undo .
    14748   def var v-char-61       as char no-undo .
