    12208     and temp-tekka-tsk.task-num = fname then do:
    12209       export stream IBmSTREAM temp-tekka-tsk.
    12210       v-found98 = yes.
    12211     end.
    12212     if temp-tekka-tsk.is-script then do:
    12213       v-is-script98 = yes.
    12214     end.
    12215     delete temp-tekka-tsk.
    12216   end.
    12217   output stream IBMStream
    12218   close.
    12219   run write-log-and-file in p-log-handle (
    12220         input 1
    12221       , input log-file-name
    12222       , input 1
    12223       , input substitute( "Данные выгружены в файлы &1(..),&2файл задания &3"
    12224                           , (out + fname)
    12225                           , chr(10)
    12226                           , (out + fname + '.tsk')
    12227                           )
    12228                                          ).
    12229   run str/runtekka.p (
    12230                        input parparentproc
    12231                       ,input p-parent-handle
    12232                       ,input p-log-handle
    12233                       ,input out
    12234                       ,input out
    12235                       ,input fname
    12236                       ,input v-remote
    12237                       ,input v-is-script98
    12238                       ) no-error .
    12239   if error-status:error then do:
    12240     for each temp-tekka-tsk:
    12241       os-delete value( temp-tekka-tsk.filename) .
    12242       delete temp-tekka-tsk.
    12243     end.
    12244     run write-log-and-file in p-log-handle (
    12245           input 1
    12246         , input log-file-name
    12247         , input 1
    12248         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    12249                              ,for-cash-desk.cash-num
    12250                              ,chr(10)
    12251                              ,return-value
    12252                           )
    12253                                           ).
    12254     assign
    12255     v-view-log = yes
    12256     .
    12257       for each temp-cd-plu:
    12258         delete temp-cd-plu.
    12259       end.
    12260     return "error":U.
    12261   end.
    12262   else do:
    12263     for each temp-cd-plu,
    12264         first buf_cd-plu where
    12265                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    12266                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    12267                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    12268                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    12269                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    12270       if temp-cd-plu.to-del = yes
    12271       and v-del-mrkt-gds
    12272       then do:
    12273         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    12274           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    12275           assign
    12276           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    12277           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
