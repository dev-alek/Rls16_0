     8749   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8750   procedure ibm-gdsc :
     8751   define input  parameter p-zeros         as logical no-undo .
     8752   define output parameter IBM-good-code as character no-undo .
     8753   define output parameter IBM-good-code-2 as character no-undo .
     8754   define output parameter IBM2-short      as character no-undo .
     8755   define variable v-delim as character no-undo .
     8756   define variable v-format-str-16 as character no-undo .
     8757     do
     8758     on error undo, return error
     8759     :
     8760       if p-zeros then do:
     8761         assign
     8762         v-delim = '0'
     8763         v-format-str-16 =  "9999999999999999"
     8764         .
     8765       end.
     8766       else do:
     8767         assign
     8768         v-delim = chr(32)
     8769         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
     8770         .
     8771       end.
     8772       if cash-gds.b-str = "" then do:
     8773         assign
     8774         b_code = string( cash-gds.b-code, v-format-str-16 ) .
     8775         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
     8776         or cash-gds.unit-base <> cash-gds.unit-cli
     8777         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
     8778         then
     8779         do:
     8780           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8781               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8782             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8783             iBM2-short = bar_code.
     8784             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
     8785           END.
     8786           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8787               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8788             IBM-good-code-2 = b_code.
     8789           end.
     8790         end.
     8791       end.
     8792       else do:
     8793         IBm-good-code =
     8794         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8795           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8796            or
     8797            cash-gds.bc-on-type = 'pglc':U)
     8798         then string( decimal( cash-gds.b-str ), v-format-str-16)
     8799         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
     8800       end.
     8801     end.
     8802   end procedure.
     8803   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8804   procedure ncr-gdsc :
     8805   define output parameter IBM-good-code as character no-undo .
     8806   define output parameter IBM-good-code-2 as character no-undo .
     8807   define output parameter is-sc as logical no-undo .
     8808   define output parameter p-taracode-bc as character no-undo .
     8809   define variable v-taracode-bc as character no-undo .
     8810   define variable v-type as character no-undo .
     8811   define variable v-bc-buf as character no-undo .
     8812   define variable iii as integer no-undo .
     8813     do
     8814     on error undo, return error
     8815     :
     8816       if cash-gds.b-str = "" then do:
     8817         assign
     8818         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
     8819         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
     8820           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8821               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8822             RUN gen-bc( input cash-gds.b-code, output bar_code ).
     8823             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
     8824           end.
     8825           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
     8826               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
     8827             IBM-good-code-2 = b_code.
     8828           end.
     8829         end.
     8830       end.
     8831       else do:
     8832         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
     8833         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8834                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8835                              or
     8836                              cash-gds.bc-on-type = 'pglc':U)
     8837                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
     8838                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
     8839                                       trim( cash-gds.b-str ), "9999999999999" ) ).
     8840          if action <> "D":U then do:
     8841           is-sc = no.
     8842           find first request_prod-bc no-lock where
     8843                     request_prod-bc.b-str = cash-gds.b-str no-error .
     8844           if not avail request_prod-bc then do :
     8845             if mask_s-c <> "" then do :
     8846               iii_ :
     8847               do iii = 1 to num-entries(mask_s-c) :
     8848                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
     8849                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
     8850                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
     8851                   if available request_prod-bc then leave iii_ .
     8852                 end.
     8853               end.
     8854             end.
     8855           end.
     8856           if avail request_prod-bc then do :
     8857             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
     8858   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     8860     (buffer request_prod-bc
     8861     ,input  'scaleable=request'
     8862     ,output is-sc
     8863     ) no-error .
     8864             end.
     8865             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8866                LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     8867                then do:
     8868   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8869     define variable tmp-str67  as character no-undo.
     8870     define variable tmp-num67  as character no-undo.
     8871     define variable i67        as integer   no-undo.
     8872     define variable sum67      as integer   no-undo.
     8873     define variable len-code67 as integer   no-undo.
     8874     define variable varcont67  as logical   initial yes no-undo.
     8875     CASE ncrsc-frmt :
     8876       WHEN "EAN13" THEN do:
     8877         assign
     8878           tmp-str67 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
     8879         .
     8880       end.
     8881       WHEN "EAN8" THEN do:
     8882         assign
     8883           tmp-str67 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
     8884         .
     8885       end.
     8886       OTHERWISE DO:
     8887           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
     8888           view-as alert-box error.
     8889           return error.
     8890       END.
     8891     END CASE.
     8892     if varcont67 = yes then do:
     8893       if integer( substring( tmp-str67, 1, length( ncrsc-pfx ) ) ) <> 0
     8894       then do:
     8895         message
     8896           "Невозможно сформировать бар-код" SKIP
     8897           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
     8898           view-as alert-box error title "подрезание кода".
     8899         return error.
     8900       end.
     8901       else do:
     8902         assign
     8903           IBm-good-code = ncrsc-pfx + substring( tmp-str67, length( ncrsc-pfx ) + 1, length( tmp-str67 ) - length( ncrsc-pfx ) )
     8904           len-code67    = length( IBm-good-code )
     8905         .
     8906         define variable v-sum-char67 as character no-undo .
     8907         assign
     8908           sum67 = 0
     8909         .
     8910         do i67 = 1 to len-code67 by 2
     8911         :
     8912           assign
     8913             v-sum-char67 = substr(IBm-good-code, len-code67 - i67 + 1, 1)
     8914           .
     8915           if v-sum-char67 < "0"
     8916           or v-sum-char67 > "9"
     8917           then do:
     8918             message
     8919               "Невозможно сформировать бар-код" skip
     8920               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     8921               view-as alert-box error title "подсчет контрольной суммы".
     8922             return error.
     8923           end.
     8924           assign
     8925             sum67 = sum67 + integer(v-sum-char67)
     8926           .
     8927         end.
     8928         if varcont67 = yes then do:
     8929           assign
     8930             sum67 = sum67 * 3
     8931           .
     8932           do i67 = 2 to len-code67 by 2
     8933           :
     8934             assign
     8935               v-sum-char67 = substr(IBm-good-code, len-code67 - i67 + 1, 1)
     8936             .
     8937             if v-sum-char67 < "0"
     8938             or v-sum-char67 > "9"
     8939             then do:
     8940               message
     8941                 "Невозможно сформировать бар-код" skip
     8942                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     8943                 view-as alert-box error title "подсчет контрольной суммы".
     8944               return error.
     8945             end.
     8946             assign
     8947               sum67 = sum67 + integer(v-sum-char67)
     8948             .
     8949           end.
     8950           if varcont67 = yes then do:
     8951              if sum67 mod 10 = 0 then do:
     8952                assign
     8953                  IBm-good-code = IBm-good-code + '0'
     8954                .
     8955              end.
     8956              else do:
     8957                assign
     8958                  IBm-good-code = IBm-good-code + string(10 - sum67 mod 10)
     8959                .
     8960              end.
     8961           end.
     8962         end.
     8963       end.
     8964     end.
     8965             end.
     8966             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
     8967                cash-gds.bc-on-type = 'pglc':U
     8968                then do:
     8969   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8970     define variable tmp-str68  as character no-undo.
     8971     define variable tmp-num68  as character no-undo.
     8972     define variable i68        as integer   no-undo.
     8973     define variable sum68      as integer   no-undo.
     8974     define variable len-code68 as integer   no-undo.
     8975     define variable varcont68  as logical   initial yes no-undo.
     8976     CASE ncrpg-frmt :
     8977       WHEN "EAN13" THEN do:
     8978         assign
     8979           tmp-str68 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
     8980         .
     8981       end.
     8982       WHEN "EAN8" THEN do:
     8983         assign
     8984           tmp-str68 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
     8985         .
     8986       end.
     8987       OTHERWISE DO:
     8988           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrpg-frmt " ."
     8989           view-as alert-box error.
     8990           return error.
     8991       END.
     8992     END CASE.
     8993     if varcont68 = yes then do:
     8994       if integer( substring( tmp-str68, 1, length( ncrpg-pfx ) ) ) <> 0
     8995       then do:
     8996         message
     8997           "Невозможно сформировать бар-код" SKIP
     8998           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
     8999           view-as alert-box error title "подрезание кода".
     9000         return error.
     9001       end.
     9002       else do:
     9003         assign
     9004           IBm-good-code = ncrpg-pfx + substring( tmp-str68, length( ncrpg-pfx ) + 1, length( tmp-str68 ) - length( ncrpg-pfx ) )
     9005           len-code68    = length( IBm-good-code )
     9006         .
     9007         define variable v-sum-char68 as character no-undo .
     9008         assign
     9009           sum68 = 0
     9010         .
     9011         do i68 = 1 to len-code68 by 2
     9012         :
     9013           assign
     9014             v-sum-char68 = substr(IBm-good-code, len-code68 - i68 + 1, 1)
     9015           .
     9016           if v-sum-char68 < "0"
     9017           or v-sum-char68 > "9"
     9018           then do:
     9019             message
     9020               "Невозможно сформировать бар-код" skip
     9021               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     9022               view-as alert-box error title "подсчет контрольной суммы".
     9023             return error.
     9024           end.
     9025           assign
     9026             sum68 = sum68 + integer(v-sum-char68)
     9027           .
     9028         end.
     9029         if varcont68 = yes then do:
     9030           assign
     9031             sum68 = sum68 * 3
     9032           .
     9033           do i68 = 2 to len-code68 by 2
     9034           :
     9035             assign
     9036               v-sum-char68 = substr(IBm-good-code, len-code68 - i68 + 1, 1)
     9037             .
     9038             if v-sum-char68 < "0"
     9039             or v-sum-char68 > "9"
     9040             then do:
     9041               message
     9042                 "Невозможно сформировать бар-код" skip
     9043                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
     9044                 view-as alert-box error title "подсчет контрольной суммы".
     9045               return error.
     9046             end.
     9047             assign
     9048               sum68 = sum68 + integer(v-sum-char68)
     9049             .
     9050           end.
     9051           if varcont68 = yes then do:
     9052              if sum68 mod 10 = 0 then do:
     9053                assign
     9054                  IBm-good-code = IBm-good-code + '0'
     9055                .
     9056              end.
     9057              else do:
     9058                assign
     9059                  IBm-good-code = IBm-good-code + string(10 - sum68 mod 10)
     9060                .
     9061              end.
     9062           end.
     9063         end.
     9064       end.
     9065     end.
     9066             end.
     9067           end.
     9068         end.
     9069       end.
     9070       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
     9071       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
     9072             or
     9073             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
     9074       then do:
     9075           run bc-oattr_value in this-procedure ( input cash-gds.b-code
     9076                                               ,input 'taracode-bc':U
     9077                                               ,input 'маг':U
     9078                                               ,input i-obj-code
     9079                                               ,output v-taracode-bc
     9080                                               ,output v-type) no-error.
     9081           if not error-status:error
     9082           and v-taracode-bc <> '' then do:
     9083             is-sc = yes.
     9084             p-taracode-bc = v-taracode-bc.
     9085           end.
     9086       end.
     9087     end.
     9088   end procedure.
     9089   procedure finish-send :
     9090     do
     9091     on error undo, return error
     9092     :
     9093   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9094   if v-view-log
     9095   and not g#news
     9096   and not g#auto
     9097   then do:
     9098     message
     9099     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     9100     "!!!Внимательно прочитайте Log-file!!"
     9101     view-as alert-box error .
     9102        define variable v-user-action70   as character no-undo .
     9103     define variable v-printed70       as logical   no-undo .
     9104     run gbl/prnfilen.w
     9105       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     9106       ,input  0
     9107       ,input  (string("./":U) + log-file-name)
     9108       ,input  7
     9109       ,output v-user-action70
     9110       ,output v-printed70
     9111       ) .
     9112   end.
     9113   if v-view-log = true
     9114   and (g#news
     9115   or g#auto)
     9116   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     9117   then do:
     9118      run cb_set-view-log in p-parent-handle ( input yes).
     9119   end.
     9120       define variable v-save-file-name as character no-undo .
     9121       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     9122       OS-APPEND value(log-file-name) value(v-save-file-name).
     9123       OS-DELETE value(log-file-name).
     9124     end.
     9125   end procedure.
     9126   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
     9127   PROCEDURE putc-gds.
     9128   define parameter buffer buf_cash-desk for ub.cash-desk.
     9129   define input parameter pos-type as char no-undo.
     9130   define input parameter p-version like ub.cash-desk.version no-undo .
     9131   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
     9132   define variable ff  as  int     no-undo.
     9133   define variable gg  as  int     no-undo.
     9134   DEFINE VARIABLE second-name as character no-undo.
     9135   define variable nam-2str-shift as integer no-undo .
     9136   define variable v-length as integer no-undo .
     9137   DEFINE VARIABLE IBM-good-code-2 as character no-undo .
     9138   define variable std-disc-dec as decimal no-undo .
     9139   define variable std-disc-reason as integer no-undo .
     9140   define variable std-disc-lim as date no-undo .
     9141   define variable temp-disc-dec as decimal no-undo .
     9142   define variable temp-disc-reason as integer no-undo .
     9143   define variable temp-disc-start as date no-undo .
     9144   define variable temp-disc-end as date no-undo .
     9145   define variable temp-disc-time-start as integer no-undo .
     9146   define variable temp-disc-time-end as integer no-undo .
     9147   define variable temp-disc-weekday as integer no-undo .
     9148   define variable v-version-dec as decimal no-undo .
     9149   define variable v-kat-num as integer no-undo .
     9150   define variable v-kat-discnt as decimal no-undo .
     9151   define variable v-time-rule-num like ub.dis-rule.time-rule-num no-undo .
     9152   define variable IBM2-short as character no-undo .
     9153   define variable v-what-find as character no-undo .
     9154   define variable v-plu as character no-undo .
     9155   define variable v-pl-code as integer no-undo .
     9156   define variable v-marketer-action as character no-undo .
     9157   define variable v-versiond as decimal no-undo .
     9158   define variable v-b-code-to-find as logical no-undo .
     9159   define variable v-maria-discnt-value as character no-undo .
     9160   define variable v-ii as integer no-undo .
     9161   define variable v-dop as character no-undo .
     9162   define variable v-gds-rule-num as integer no-undo .
     9163   define variable v-maria-rule-num as integer no-undo .
     9164   define variable v-discreteness as character no-undo .
     9165   define variable wd-option as integer no-undo .
     9166   define variable wgd-option as integer no-undo .
     9167   define variable v-type as logical   no-undo .
     9168   define variable  s as char no-undo.
     9169   define variable articul as char no-undo.
     9170   define variable v-disc-price-sale as decimal no-undo .
     9171   define variable v-pdf-id as integer no-undo .
     9172   define variable v-pdf-db-num as integer no-undo .
     9173   define buffer buf_cash-dis-rule for cash-dis-rule .
     9174   define buffer buf_cd-plu for ub.cd-plu.
     9175   define buffer buf_dis-rule for ub.dis-rule.
     9176   define buffer buf_place for ub.place.
     9177   define buffer buf_pl-gds for ub.pl-gds.
     9178   define buffer bcash-gds for cash-gds.
     9179   define buffer buf_cash-desk-attr for cash-desk-attr.
     9180   define variable vcash-desk-stndart as logical no-undo init yes.
     9181   assign
     9182   v-version-dec = decimal(p-version)
     9183   no-error .
     9184   if buf_cash-desk.autonomy = integer('2':U)
     9185   then do:
     9186      vcash-desk-stndart = no.
     9187   end.
     9188     if buf_cash-desk.device-kind = 2 then vcash-desk-stndart = no.
     9189   define variable is-petrol   as logical   no-undo.
     9190   define variable is-pieces   as logical   no-undo.
     9191   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     9192     (
     9193        input cash-gds.artic
     9194     ,  input ?
     9195     ,  input cash-gds.gds-code
     9196     , output is-petrol
     9197     , output is-pieces
     9198     ) NO-ERROR.
     9199   if     not vcash-desk-stndart
     9200      and not is-petrol
     9201   then
     9202      return.
     9203   if cash-gds.std-discnt-rule > 0 then do:
     9204     find first cash-dis-rule no-lock where
     9205               cash-dis-rule.rule-num =  cash-gds.std-discnt-rule no-error .
     9206     if available cash-dis-rule then do:
     9207       find first cash-dis-time-rule no-lock where
     9208                 cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
     9209       assign
     9210       std-disc-dec = - cash-dis-rule.discnt-value
     9211       std-disc-reason = 0
     9212       no-error
     9213       .
     9214       if available cash-dis-time-rule then do:
     9215         assign
     9216         std-disc-lim = cash-dis-time-rule.date-to
     9217         .
     9218         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
     9219         assign
     9220         std-disc-dec = 0
     9221         std-disc-reason = 0
     9222         .
     9223         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
     9224         assign
     9225         std-disc-dec = 0
     9226         std-disc-reason = 0
     9227         .
     9228       end.
     9229     end.
     9230   end.
     9231   if cash-gds.wd > 1 then do:
     9232     find first cash-dis-rule no-lock where
     9233               cash-dis-rule.rule-num =  cash-gds.wd-rule no-error .
     9234     if available cash-dis-rule then  do:
     9235       assign
     9236       wd-option = integer(cash-dis-rule.discnt-value).
     9237     end.
     9238   end.
     9239   if cash-gds.wd = 1 then do:
     9240      wd-option = 1.
     9241   end.
     9242   if cash-gds.wgd > 0 then do:
     9243     find first cash-dis-rule no-lock where
     9244               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
     9245     if available cash-dis-rule then  do:
     9246       assign
     9247       wgd-option = integer(cash-dis-rule.discnt-value).
     9248     end.
     9249   end.
     9250   if cash-gds.temp-discnt-rule <> 0 then do:
     9251     assign
     9252     temp-disc-dec = 0
     9253     .
     9254     find first cash-dis-rule no-lock where
     9255               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
     9256     if available cash-dis-rule
     9257              and cash-dis-rule.is-term = yes then do:
     9258       if cash-dis-rule.time-rule-num > 0 then do:
     9259         find first cash-dis-time-rule no-lock where
     9260                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
     9261         if available cash-dis-time-rule
     9262         and cash-dis-time-rule.templ-rl-root = 50001
     9263             or
     9264             (
     9265              (
     9266               (cash-dis-time-rule.date-from < today)
     9267               or
     9268               (cash-dis-time-rule.date-from = 12/31/1989)
     9269              )
     9270             and
     9271             (
     9272              (cash-dis-time-rule.date-to >= today)
     9273              or
     9274              (cash-dis-time-rule.date-to = 12/31/1989)
     9275             )
     9276            ) then do:
     9277            temp-disc-dec = ?.
     9278         end.
     9279         else do:
     9280           assign
     9281           temp-disc-dec = 0
     9282           .
     9283         end.
     9284       end.
     9285       else do:
     9286         temp-disc-dec = ?.
     9287       end.
     9288       if temp-disc-dec = ? then do:
     9289         case cash-dis-rule.value-type:
     9290           when integer('1':U) then do:
     9291         assign
     9292         temp-disc-dec = - cash-dis-rule.discnt-value
     9293         .
     9294       end.
     9295           when integer('11':U) then do:
     9296             find first cash-gds-discnt where
     9297                       cash-gds-discnt.b-code = cash-gds.b-code
     9298                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     9299                   and cash-gds-discnt.obj-type = 'маг':U
     9300                   and cash-gds-discnt.obj-code = i-obj-code
     9301                   no-error.
     9302             if available cash-gds-discnt then do:
     9303               assign
     9304               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
     9305               .
     9306             end.
     9307             else do:
     9308              assign
     9309               temp-disc-dec = 0.
     9310             end.
     9311           end.
     9312           otherwise do:
     9313             temp-disc-dec = 0.
     9314           end.
     9315         end case.
     9316       end.
     9317     end.
     9318   end.
     9319   CASE pos-type:
     9320     when 'MAGIA-XML':U
     9321     then do:
     9322       if cash-gds.b-str <> "":U then do:
     9323         return.
     9324       end.
     9325       assign
     9326       chk_name = replace(cash-gds.gds-name, chr(34), "":U) + cash-gds.f-name
     9327       .
     9328       if cash-gds.unit-base <> cash-gds.unit-cli then
     9329       assign
     9330       chk_name = string(substr(chk_name, 1, max(33, 50 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))) +
     9331                         "*":U +
     9332                         trim(string( cash-gds.cli-base-rate ), chr(32)), "x(50)":U ).
     9333       else
     9334       chk_name = string(chk_name, "X(50)":U).
     9335       assign
     9336       second-name = replace(cash-gds.gds-namelong, chr(39), "":U)
     9337       second-name =   (chr(34) +
     9338                         TRIM(CAPS(string( replace(second-name, chr(34), "":U), "X(40)":U )))
     9339                         + chr(34) )
     9340       .
     9341       if cash-gds.unit-base <> cash-gds.unit-cli then
     9342       assign
     9343       second-name = string(substr(second-name, 1, max(23, 40 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))  ) +
     9344                         "*":U +
     9345                         trim(string(cash-gds.cli-base-rate), chr(32)), "x(40)":U ).
     9346       else
     9347       second-name = string(second-name, "X(40)":U).
     9348       if tax-cass AND cash-gds.new-good then do:
     9349           for each cash-txr No-LOCK WHERE
     9350                     cash-txr.rc = cash-gds.rc AND
     9351                     cash-txr.host-code = ub.shop.host-code AND
     9352                     cash-txr.obj-type = 'маг':U AND
     9353                     cash-txr.obj-code = ub.shop.obj-code:
     9354             run putc-13(buffer buf_cash-desk
     9355                       , input pos-type
     9356                       , input p-cash-os
     9357                       , input yes
     9358                       ).
     9359           end.
     9360       end.
     9361   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9362   define variable mi-entry as integer no-undo .
     9363   define variable v-out-code like ub.fbr-gds-grp.out-code no-undo .
     9364   define variable v-out-code-0 like ub.fbr-gds-grp.out-code no-undo .
     9365   define variable v-global-code like ub.fbr-gds-grp.global-code no-undo .
     9366   define variable v-xml-vat like ub.tax-rate-value.rate-value no-undo .
