      110   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   def new shared var bc-frmt as character no-undo .
      112   def new shared var bc-pfx  as character no-undo .
      113   def var bc-par-type as character no-undo .
      114       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      115       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      116           do:
      117               message "Не задан или не верно задан ТИП собственного бар-кода!"
      118                   view-as alert-box ERROR TITLE "".
      119               return error.
      120           end.
      121       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      122       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      123           do:
      124               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      125                   view-as alert-box ERROR TITLE "".
      126               return error.
      127           end.
      128   PROCEDURE gen-bc:
      129     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      130     def output parameter full-b-code     as character init ""    no-undo .
      131   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132     define variable tmp-str3  as character no-undo.
      133     define variable tmp-num3  as character no-undo.
      134     define variable i3        as integer   no-undo.
      135     define variable sum3      as integer   no-undo.
      136     define variable len-code3 as integer   no-undo.
      137     define variable varcont3  as logical   initial yes no-undo.
      138     CASE bc-frmt :
      139       WHEN "EAN13" THEN do:
      140         assign
      141           tmp-str3 = string( internal-b-code, "999999999999" )
      142         .
      143       end.
      144       WHEN "EAN8" THEN do:
      145         assign
      146           tmp-str3 = string( internal-b-code, "9999999" )
      147         .
      148       end.
      149       OTHERWISE DO:
      150           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      151           view-as alert-box error.
      152           return error.
      153       END.
      154     END CASE.
      155     if varcont3 = yes then do:
      156       if integer( substring( tmp-str3, 1, length( bc-pfx ) ) ) <> 0
      157       then do:
      158         message
      159           "Невозможно сформировать бар-код" SKIP
      160           "для товара с кодом: " internal-b-code
      161           view-as alert-box error title "подрезание кода".
      162         return error.
      163       end.
      164       else do:
      165         assign
      166           full-b-code = bc-pfx + substring( tmp-str3, length( bc-pfx ) + 1, length( tmp-str3 ) - length( bc-pfx ) )
      167           len-code3    = length( full-b-code )
      168         .
      169         define variable v-sum-char3 as character no-undo .
      170         assign
      171           sum3 = 0
      172         .
      173         do i3 = 1 to len-code3 by 2
      174         :
      175           assign
      176             v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      177           .
      178           if v-sum-char3 < "0"
      179           or v-sum-char3 > "9"
      180           then do:
      181             message
      182               "Невозможно сформировать бар-код" skip
      183               "для товара с кодом: " internal-b-code skip
      184               view-as alert-box error title "подсчет контрольной суммы".
      185             return error.
      186           end.
      187           assign
      188             sum3 = sum3 + integer(v-sum-char3)
      189           .
      190         end.
      191         if varcont3 = yes then do:
      192           assign
      193             sum3 = sum3 * 3
      194           .
      195           do i3 = 2 to len-code3 by 2
      196           :
      197             assign
      198               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      199             .
      200             if v-sum-char3 < "0"
      201             or v-sum-char3 > "9"
      202             then do:
      203               message
      204                 "Невозможно сформировать бар-код" skip
      205                 "для товара с кодом: " internal-b-code skip
      206                 view-as alert-box error title "подсчет контрольной суммы".
      207               return error.
      208             end.
      209             assign
      210               sum3 = sum3 + integer(v-sum-char3)
      211             .
      212           end.
      213           if varcont3 = yes then do:
      214              if sum3 mod 10 = 0 then do:
      215                assign
      216                  full-b-code = full-b-code + '0'
      217                .
      218              end.
      219              else do:
      220                assign
      221                  full-b-code = full-b-code + string(10 - sum3 mod 10)
      222                .
      223              end.
      224           end.
      225         end.
      226       end.
      227     end.
      228   END PROCEDURE.
