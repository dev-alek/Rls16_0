     7225   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7226   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7227   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7228   procedure create-dis-rule :
     7229   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7230   define input parameter p-tree as logical no-undo .
     7231   define buffer buf_dis-rule for ub.dis-rule.
     7232   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7233   define buffer term_dis-rule for ub.dis-rule.
     7234   define buffer term_dis-time-rule for ub.dis-time-rule.
     7235   define buffer root_cash-dis-rule for cash-dis-rule.
     7236   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7237   define buffer term_cash-dis-rule for cash-dis-rule.
     7238   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7239     do
     7240     on error undo, return error
     7241     :
     7242       find first root_cash-dis-rule no-lock where                                                         ~
     7243                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7244       if not available root_cash-dis-rule then do:
     7245         find first buf_dis-rule no-lock where
     7246                   buf_dis-rule.rule-num = p-rule-num no-error.
     7247         if available buf_dis-rule then do:
     7248           if buf_dis-rule.time-rule-num <> 0 then do:
     7249             find first buf_dis-time-rule no-lock where
     7250                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7251           end.
     7252           create root_cash-dis-rule.
     7253           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7254           if available buf_dis-time-rule then do:
     7255             find first root_cash-dis-time-rule no-lock where
     7256                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7257             if not available root_cash-dis-time-rule then do:
     7258               create root_cash-dis-time-rule.
     7259               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7260             end.
     7261           end.
     7262           else do:
     7263             assign
     7264             root_cash-dis-rule.time-rule-num = 0.
     7265           end.
     7266           if buf_dis-rule.uniq-field <> "":U then do:
     7267             for each term_dis-rule no-lock where
     7268                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7269               if term_dis-rule.time-rule-num <> 0 then do:
     7270                 find first term_dis-time-rule no-lock where
     7271                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7272               end.
     7273               create term_cash-dis-rule.
     7274               buffer-copy term_dis-rule to term_cash-dis-rule.
     7275               if term_dis-rule.time-rule-num = 0
     7276               or available term_dis-time-rule
     7277               or root_cash-dis-rule.time-rule-num = 0
     7278               then do:
     7279                 if available term_dis-time-rule then do:
     7280                   find first term_cash-dis-time-rule no-lock where
     7281                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7282                   if not available term_cash-dis-time-rule then do:
     7283                     create term_cash-dis-time-rule.
     7284                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7285                   end.
     7286                 end.
     7287               end.
     7288             end.
     7289           end.
     7290         end.
     7291       end.
     7292     end.
     7293   end procedure.
     7294   define temp-table temp-cd-plu no-undo like ub.cd-plu .
     7295   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7296   function ncr-amnt-disc returns character (
     7297     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7298   define variable v-result as character no-undo .
     7299   define variable ii as integer no-undo .
     7300   define variable v-entry as character no-undo extent 3.
     7301   for each cash-dis-rule  no-lock where
     7302         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7303     assign
     7304     ii = ii + 1
     7305     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7306                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7307     .
     7308   end.
     7309   if v-entry[2] = "":U then
     7310   assign
     7311   v-entry[2] = v-entry[1]
     7312   .
     7313   if v-entry[3] = "":U then
     7314   assign
     7315   v-entry[3] = v-entry[2]
     7316   .
     7317   assign
     7318   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7319   .
     7320   return v-result.
     7321   END FUNCTION.
     7322   function ncr-date-disc returns character (
     7323     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7324   define variable v-result as character no-undo .
     7325   define variable ii as integer no-undo .
     7326   define variable v-entry as character no-undo extent 3.
     7327   for each cash-dis-rule  no-lock where
     7328         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7329       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7330     assign
     7331     ii = ii + 1
     7332     v-entry[ii] =
     7333                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7334                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7335                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7336                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7337                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7338                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7339                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7340   end.
     7341   if v-entry[2] = "":U then
     7342   assign
     7343   v-entry[2] = v-entry[1]
     7344   .
     7345   if v-entry[3] = "":U then
     7346   assign
     7347   v-entry[3] = v-entry[2]
     7348   .
     7349   assign
     7350   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7351   .
     7352   return v-result.
     7353   END FUNCTION.
     7354   function ncr-temp-disc returns character (
     7355     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7356   define variable v-result as character no-undo .
     7357   define variable ii as integer no-undo .
     7358   define variable v-entry as character no-undo extent 3.
     7359   define variable v-dec as decimal no-undo .
     7360   define variable v-disc-price-sale as decimal no-undo .
     7361   define variable v-pdf-id as integer no-undo .
     7362   define variable v-pdf-db-num as integer no-undo .
     7363   define buffer buf_cash-dis-rule for cash-dis-rule.
     7364   find first buf_cash-dis-rule where
     7365            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7366   if not available buf_cash-dis-rule then return "":U.
     7367   if buf_cash-dis-rule.templ-rl-root <> 29
     7368   and buf_cash-dis-rule.templ-rl-root <> 86
     7369   then do:
     7370     assign
     7371     v-entry[1] =
     7372     "000"                                                   +
     7373     "0"                                                     +
     7374     "0000"                                                  +
     7375     "2359"                                                     +
     7376      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7377      .
     7378   end.
     7379   else do:
     7380     for each cash-dis-rule  no-lock where
     7381           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7382         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7383       case cash-dis-rule.value-type:
     7384         when integer('1':U) then do:
     7385           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7386         end.
     7387         when integer('12':U) then do:
     7388           find first cash-gds-discnt where
     7389                     cash-gds-discnt.b-code = cash-gds.b-code
     7390                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7391                 and cash-gds-discnt.obj-type = 'маг':U
     7392                 and cash-gds-discnt.obj-code = i-obj-code
     7393                 no-error.
     7394           if not available cash-gds-discnt then do:
     7395             v-dec = cash-gds.price-sale.
     7396           end.
     7397           else do:
     7398             assign
     7399             v-dec = cash-gds-discnt.discnt-value
     7400             .
     7401           end.
     7402         end.
     7403         otherwise do:
     7404           v-dec = cash-gds.price-sale.
     7405         end.
     7406       end case.
     7407       assign
     7408       ii = ii + 1
     7409       v-entry[ii] =
     7410                     "000"                                                   +
     7411                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7412                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7413                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7414                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7415                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7416                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7417                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7418                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7419                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7420                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7421                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7422       .
     7423   if ii = 3 then leave.
     7424     end.
     7425   end.
     7426   if v-entry[2] = "":U then
     7427   assign
     7428   v-entry[2] = v-entry[1]
     7429   .
     7430   if v-entry[3] = "":U then
     7431   assign
     7432   v-entry[3] = v-entry[2]
     7433   .
     7434   assign
     7435   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7436   .
     7437   return v-result.
     7438   END FUNCTION.
     7439   function ncr-d-rank returns character (
     7440     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7441   define variable v-result as character no-undo .
     7442   define variable ii as integer no-undo .
     7443   do ii = 1 to length(p-d-rank):
     7444     CASE substr(p-d-rank, ii, 1):
     7445       when "X":U then do:
     7446         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7447       end.
     7448       when "T":U then do:
     7449         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7450       end.
     7451       when "D":U then do:
     7452         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7453       end.
     7454     END CASE.
     7455     if v-result <> "":U then LEAVE.
     7456   end.
     7457   if v-result = "":U then v-result = chr(32).
     7458   return v-result.
     7459   END FUNCTION.
     7460   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7461       define variable v-upper-code as int no-undo.
     7462       define variable v-value as character no-undo.
     7463       define variable v-type as character no-undo.
     7464       define buffer lc_gds-grp for ub.gds-grp.
     7465       define buffer lc_goods for ub.goods.
     7466      if p-gds-code <> 0 then do:
     7467       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7468       v-upper-code = lc_goods.grp-code.
     7469       do while v-upper-code > 0 :
     7470           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7471           run ggoattr-value(
     7472             input lc_gds-grp.node-code,
     7473             input 0,
     7474             input "",
     7475             input 0,
     7476             input 'ban-sales-via-cd':U,
     7477             output v-value,
     7478             output v-type
     7479           ).
     7480          if v-value = "yes" then
     7481             return true.
     7482          else
     7483          do:
     7484             run ggoattr-value(
     7485                input lc_gds-grp.node-code,
     7486                input shop.host-code,
     7487                input "",
     7488                input 0,
     7489                input 'ban-sales-via-cd':U,
     7490                output v-value,
     7491                output v-type
     7492                ).
     7493             if v-value = "yes" then
     7494                return true.
     7495             else
     7496             do:
     7497                run ggoattr-value(
     7498                   input lc_gds-grp.node-code,
     7499                   input shop.host-code,
     7500                   input 'маг':U,
     7501                   input i-obj-code,
     7502                   input 'ban-sales-via-cd':U,
     7503                   output v-value,
     7504                   output v-type
     7505                   ).
     7506                if v-value = "yes" then
     7507                   return true.
     7508                else v-upper-code = lc_gds-grp.upper-code.
     7509             end .
     7510          end.
     7511         end.
     7512       end.
     7513   end.
     7514   FUNCTION convert-tax-code returns integer
     7515                                             ( input p-rate-code as integer
     7516                                              ,input p-cdtaxlst  as character
     7517                                             ) :
     7518   define variable jj as integer no-undo .
     7519     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7520       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7521         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7522       end.
     7523     end.
     7524   END FUNCTION.
     7525   FUNCTION convert-maria-tax-code returns character
     7526                                             ( input p-vat-rate-code as integer
     7527                                              ,input p-slt-rate-code as integer
     7528                                              ,input p-cdtaxlst  as character
     7529                                             ) :
     7530   define variable jj as integer no-undo .
     7531   define variable aa as character no-undo extent 8.
     7532   define variable v-return-value as character no-undo .
     7533     do jj = 1 to 8:
     7534       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7535         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7536           aa[jj] = '1'.
     7537         end.
     7538         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7539           aa[jj] = '1'.
     7540         end.
     7541       end.
     7542       if aa[jj] = '':U then aa[jj] = '0'.
     7543       v-return-value = aa[jj] + v-return-value.
     7544     end.
     7545   return v-return-value.
     7546   END FUNCTION.
     7547   FUNCTION convert-maria-tax-code-2 returns integer
     7548                                             ( input p-rate-code as integer
     7549                                              ,input p-cdtaxlst  as character
     7550                                             ) :
     7551   define variable jj as integer no-undo .
     7552   define variable v-return-value as integer no-undo .
     7553     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7554       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7555         return jj.
     7556       end.
     7557     end.
     7558   return 0.
     7559   END FUNCTION.
     7560   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
