     4582           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-periodic-tasks in g#attr-lib
     4583         (input  p-db-num
     4584         ,input  p-obj-code
     4585         ,input  p-pos-type
     4586         ,input  p-cash-num
     4587         ,input-output p-value
     4588         ,output p-setted
     4589         ) no-error .
     4590       if error-status :error
     4591       then do:
     4592         undo, return error return-value .
     4593       end.
     4594     end.
     4595   end procedure.
