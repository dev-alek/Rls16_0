     1480   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1483   procedure disrules-fill-properties:
     1484   define input  parameter p-templ-rl-root as integer   no-undo .
     1485   define buffer buf_drt-prop for ub.drt-prop.
     1486   define buffer buf_temp-drt-prop for temp-drt-prop.
     1487   do
     1488   on error undo, return error return-value
     1489   :
     1490     for each buf_temp-drt-prop:
     1491       delete buf_temp-drt-prop.
     1492     end.
     1493     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1494       create buf_temp-drt-prop.
     1495       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1496     end.
     1497   end.
     1498   end procedure.
     1499   ~
     1500   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   procedure discfgru-check :
     1502   define input parameter p-table-name as character no-undo .
     1503   define input parameter p-templ-rl-root as integer no-undo .
     1504   define input parameter p-time-templ-rl-root as integer no-undo .
     1505   define input parameter p-pos-type as character no-undo .
     1506   define output parameter p-disnct-role as character no-undo .
     1507   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1508     do
     1509     on error undo, return error return-value
     1510     :
     1511       find first buf_dis-cfg-rule no-lock where
     1512               buf_dis-cfg-rule.table-name = p-table-name
     1513           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1514           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1515           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1516       if not available buf_dis-cfg-rule
     1517       or p-pos-type = "":U
     1518       then do:
     1519          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1520                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1521                                  , p-templ-rl-root
     1522                                  , (if p-time-templ-rl-root = ?
     1523                                     then '':U
     1524                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1525                                     )
     1526                                  ).
     1527       end.
     1528       assign
     1529       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1530       .
     1531     end.
     1532   end procedure.
     1533   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534   FUNCTION get-region RETURNS CHARACTER
     1535     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1536     define variable par-region as character no-undo.
     1537     if parhost-code = 0 and
     1538          parobj-type = "":U and
     1539          parobj-code = 0 then do:
     1540          par-region = "Глобально".
     1541          return par-region.
     1542       end.
     1543       if parobj-type = 'орг':U then do:
     1544          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1545          return par-region.
     1546       end.
     1547       if parobj-type = 'регион':U
     1548       then do:
     1549          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1550          return par-region.
     1551       end.
     1552       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1553       return par-region.
     1554   END FUNCTION.
     1555   FUNCTION get-objregion RETURNS CHARACTER
     1556     (  input parobj-type as character, input parobj-code as integer ) :
     1557     define variable par-region as character no-undo.
     1558     if  parobj-type = "":U and
     1559         parobj-code = 0
     1560     then do:
     1561        par-region = "Глобально".
     1562     end.
     1563     else if parobj-type = 'орг':U
     1564     then do:
     1565        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1566     end.
     1567     else if parobj-type = 'регион':U
     1568     then do:
     1569        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1570     end.
     1571     else
     1572        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1573     return par-region.
     1574   END FUNCTION.
     1575   procedure disgdsru-name :
     1576   define buffer buf_dis-rule for ub.dis-rule.
     1577   do
     1578     on error undo, return error
     1579     :
     1580     define input  parameter p-templ-rl-root  as integer no-undo .
     1581     define output parameter p-label          as character no-undo .
     1582     find first buf_dis-rule no-lock where
     1583               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1584     if available buf_dis-rule
     1585     then do:
     1586       if buf_dis-rule.rule-num > 0 then
     1587       p-label = buf_dis-rule.des.
     1588     end.
     1589     else do:
     1590       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1591     end.
     1592   end.
     1593   end procedure.
     1594   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1595   define variable v-rule-label as character no-undo .
     1596   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1597                                        ,output v-rule-label) no-error.
     1598   return v-rule-label.
     1599   end function.
     1600   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1601   define variable v-rule-label as character no-undo .
     1602   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1603   end function.
     1604   procedure disgdsru-write :
     1605     do
     1606     on error undo, return error
     1607     :
     1608       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1609       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1610       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1611       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1612       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1613       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1614       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1615       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1616       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1617       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1618       define buffer buf_dis-rule for ub.dis-rule.
     1619       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1620       define variable v-label          as character no-undo .
     1621       define variable v-discnt-role as character no-undo .
     1622       run discfgru-check in this-procedure (
     1623                                             input 'dis-gds-rule':U
     1624                                            ,input p-templ-rl-root
     1625                                            ,input p-time-templ-rl-root
     1626                                            ,input p-pos-type
     1627                                            ,output v-discnt-role
     1628                                             ) no-error .
     1629       if error-status :error then do:
     1630         undo, return error return-value .
     1631       end.
     1632       if p-discnt-role = ? then do:
     1633         p-discnt-role = v-discnt-role.
     1634       end.
     1635       if p-discnt-role <> v-discnt-role then do:
     1636         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1637                                 ,p-gds-code
     1638                                 ,p-obj-type
     1639                                 ,p-obj-code
     1640                                 ,p-pos-type
     1641                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1642                                 ,chr(10)
     1643                                 ,p-templ-rl-root
     1644                                 ,p-rule-num).
     1645       end.
     1646       if p-pos-type = ? then do:
     1647   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1648   define variable v-param-type22 as character no-undo .
     1649   define variable v-value-date22 as date no-undo .
     1650   define variable v-value-decimal22 as decimal no-undo .
     1651   define variable v-value-integer22 as INTEGER no-undo .
     1652   define variable v-value-logical22 AS LOGICAL no-undo .
     1653   define variable v-tth22 as handle no-undo .
     1654   run adm/shattri.p (
     1655       input "get":U
     1656       ,input  p-obj-type
     1657       ,input  p-obj-code
     1658       ,input  'cd-sending':U
     1659       ,input  'dflt-cd':U
     1660       ,output p-pos-type
     1661       ,output v-value-date22
     1662       ,output v-value-decimal22
     1663       ,output v-value-integer22
     1664       ,output v-value-logical22
     1665       ,output v-param-type22
     1666       ,INPUT-OUTPUT table-handle v-tth22
     1667       )  .
     1668   delete object v-tth22 no-error.
     1669       end.
     1670       find first buf_dis-rule no-lock where
     1671                 buf_dis-rule.rule-num = p-rule-num no-error.
     1672       if not available buf_Dis-rule then do:
     1673         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1674                                 ,p-gds-code
     1675                                 ,p-obj-type
     1676                                 ,p-obj-code
     1677                                 ,p-pos-type
     1678                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1679                                 ,chr(10)
     1680                                 ,p-rule-num).
     1681       end.
     1682       if buf_dis-rule.root <> yes then do:
     1683         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1684                                 ,p-gds-code
     1685                                 ,p-obj-type
     1686                                 ,p-obj-code
     1687                                 ,p-pos-type
     1688                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1689                                 ,chr(10)
     1690                                 ,p-rule-num).
     1691       end.
     1692       if not (p-obj-type = buf_dis-rule.obj-type
     1693           and p-obj-code = buf_dis-rule.obj-code)
     1694       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1695                and
     1696                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1697        then do:
     1698         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1699                                 ,p-gds-code
     1700                                 ,p-obj-type
     1701                                 ,p-obj-code
     1702                                 ,p-pos-type
     1703                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1704                                 ,chr(10)
     1705                                 ) +
     1706                             substitute("Правило скидки &1 определено для &2&3" +
     1707                                        "а привязка к товару для &4"
     1708                                        ,buf_dis-rule.rule-num
     1709                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1710                                        ,chr(10)
     1711                                        ,get-objregion( p-obj-type, p-obj-code)
     1712                                        ))
     1713                                 .
     1714       end.
     1715       find first buf_dis-gds-rule exclusive-lock where
     1716                  buf_dis-gds-rule.gds-code  = p-gds-code
     1717              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1718              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1719              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1720              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1721              and buf_dis-gds-rule.nonunique = p-nonunique
     1722              no-error .
     1723       if not available buf_dis-gds-rule then do:
     1724         find first buf_dis-gds-rule exclusive-lock where
     1725                   buf_dis-gds-rule.gds-code  = p-gds-code
     1726               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1727               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1728               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1729               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1730               no-error .
     1731         if available buf_Dis-gds-rule then do:
     1732           if p-nonunique = ''
     1733           and available buf_dis-gds-rule
     1734           then do:
     1735             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1736                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1737                                      , p-gds-code
     1738                                      , buf_Dis-rule.obj-type
     1739                                      , buf_Dis-rule.obj-code
     1740                                      , p-nonunique
     1741                                     ).
     1742           end.
     1743           if available buf_dis-gds-rule
     1744           and buf_dis-gds-rule.nonunique = ''
     1745           and p-nonunique <> ''then do:
     1746             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1747                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1748                                      , p-gds-code
     1749                                      , buf_Dis-rule.obj-type
     1750                                      , buf_Dis-rule.obj-code
     1751                                     ).
     1752           end.
     1753         end.
     1754         create buf_dis-gds-rule .
     1755         assign
     1756         buf_dis-gds-rule.gds-code  = p-gds-code
     1757         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1758         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1759         buf_dis-gds-rule.pos-type = p-pos-type
     1760         buf_dis-gds-rule.discnt-role = v-discnt-role
     1761         buf_dis-gds-rule.rule-num = p-rule-num
     1762         buf_dis-gds-rule.nonunique = p-nonunique
     1763         no-error
     1764         .
     1765       end.
     1766       ASSIGN
     1767       buf_dis-gds-rule.rule-num = p-rule-num
     1768       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1769       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1770       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1771       buf_dis-gds-rule.nonunique = p-nonunique
     1772       no-error.
     1773     end.
     1774   end procedure.
     1775   PROCEDURE cmp-disgdsru-write :
     1776   do
     1777   on error undo, return error
     1778   :
     1779     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1780     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1781     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1782     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1783     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1784     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1785     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1786     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1787     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1788     define variable v-rule-label          as character no-undo .
     1789     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1790     define buffer buf_dis-rule     for ub.dis-rule.
     1791     run disgdsru-name in this-procedure (
     1792                                         input  p-templ-rl-root
     1793                                         ,output v-rule-label
     1794                                         ) no-error .
     1795     if error-status :error then do:
     1796       undo, return error return-value .
     1797     end.
     1798     find first buf_tt0-dis-gds-rule exclusive-lock where
     1799                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1800             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1801             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1802             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1803             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1804             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1805             no-error .
     1806     if not available buf_tt0-dis-gds-rule then do:
     1807       create buf_tt0-dis-gds-rule .
     1808       assign
     1809       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1810       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1811       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1812       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1813       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1814       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1815       no-error
     1816       .
     1817     end.
     1818     find first buf_dis-rule no-lock where
     1819               buf_dis-rule.rule-num = p-rule-num.
     1820     ASSIGN
     1821     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1822     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1823     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1824     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1825     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1826     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1827     no-error.
     1828     release buf_tt0-dis-gds-rule no-error .
     1829     if error-status:error then do:
     1830       undo, return error return-value .
     1831     end.
     1832   end.
     1833   END PROCEDURE.
     1834   define variable vss-include-info23 as character format "X(65)" no-undo
     1835   initial "@(#)$Workfile$ $Revision$".
     1836   define variable v-bgelib-bgefmt        as character         no-undo.
     1837   define variable v-bgelib-bgeflold      as character         no-undo.
     1838   define stream stmXMLOut.
     1839   define stream stmXMLLog.
     1840   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1841   procedure cur-time :
     1842      define output parameter p-today as date      no-undo .
     1843      define output parameter p-time  as integer   no-undo .
     1844     do
     1845     on error undo, return error
     1846     :
     1847       define variable v-date1 as date      no-undo .
     1848       define variable v-date2 as date      no-undo .
     1849       define variable v-time  as integer   no-undo .
     1850       assign
     1851         v-date1 = today
     1852         v-time  = time
     1853         v-date2 = today
     1854       .
     1855       if v-date1 <> v-date2
     1856       then do:
     1857         assign
     1858           v-date1 = today
     1859           v-time  = v-time
     1860         .
     1861       end.
     1862       assign
     1863         p-today = v-date1
     1864         p-time  = v-time
     1865       .
     1866     end.
     1867   end.
     1868   function cur-time-date returns character
     1869   :
     1870     return string(today, '99/99/9999':U) .
     1871   end.
     1872   function cur-time-mjd returns decimal
     1873   :
     1874     define variable v-date as date      no-undo .
     1875     define variable v-time as integer   no-undo .
     1876     run cur-time in this-procedure
     1877       (output v-date
     1878       ,output v-time
     1879       ) .
     1880     return integer(v-date) - 2400002 + (v-time / 86400) .
     1881   end.
     1882   function cur-time-get-ending-index returns integer
     1883   (input p-number as integer
     1884   )
     1885   :
     1886     if p-number < 0
     1887     or p-number = ?
     1888     then do:
     1889       return 1 .
     1890     end.
     1891     define variable v-rest as integer   no-undo .
     1892     assign
     1893       p-number = p-number modulo 100
     1894     .
     1895     if p-number < 20
     1896     then do:
     1897       assign
     1898         v-rest = p-number
     1899       .
     1900     end.
     1901     else do:
     1902       assign
     1903         v-rest = p-number modulo 10
     1904       .
     1905     end.
     1906     case v-rest :
     1907       when 1
     1908       then do:
     1909         return 2 .
     1910       end.
     1911       when 2 or
     1912       when 3 or
     1913       when 4
     1914       then do:
     1915         return 3 .
     1916       end.
     1917       otherwise do:
     1918         return 1 .
     1919       end.
     1920     end case .
     1921   end.
     1922   procedure cur-time-mjd-to-date :
     1923      define input  parameter i-mjd-diff as decimal no-undo.
     1924      define output parameter o-Date     as date    no-undo.
     1925      define output parameter o-Time     as integer no-undo.
     1926      define variable v-day-number as integer   no-undo .
     1927      if    i-mjd-diff < 0
     1928         or i-mjd-diff = ?
     1929      then do:
     1930         return "?" .
     1931      end.
     1932      assign
     1933         v-day-number = truncate(i-mjd-diff,0).
     1934         o-Date = date(v-day-number + 2400002).
     1935         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1936     .
     1937   end.
     1938   function cur-time-mjd-to-string returns character
     1939   (input p-mjd-diff as decimal
     1940   )
     1941   :
     1942     define variable v-day-number as integer   no-undo .
     1943     define variable v-seconds    as integer   no-undo .
     1944     define variable v-hour       as integer   no-undo .
     1945     define variable v-min        as integer   no-undo .
     1946     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1947     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1948     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1949     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1950     if p-mjd-diff < 0
     1951     or p-mjd-diff = ?
     1952     then do:
     1953       return "?" .
     1954     end.
     1955     assign
     1956       v-day-number = integer(truncate(p-mjd-diff,0))
     1957       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1958     .
     1959     if v-seconds > 86400
     1960     then do:
     1961       assign
     1962         v-seconds = 86400 - 1
     1963       .
     1964     end.
     1965     if v-seconds < 0
     1966     then do:
     1967       assign
     1968         v-seconds = 0
     1969       .
     1970     end.
     1971     assign
     1972       v-hour = truncate(v-seconds / 3600, 0)
     1973     .
     1974     assign
     1975       v-seconds = v-seconds modulo 3600
     1976     .
     1977     assign
     1978       v-min = truncate(v-seconds / 60, 0)
     1979     .
     1980     assign
     1981       v-seconds = v-seconds modulo 60
     1982     .
     1983     return
     1984         (if v-day-number <> 0
     1985           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1986           else ""
     1987         )
     1988       + (if v-day-number <> 0 or v-hour <> 0
     1989           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1990           else ""
     1991         )
     1992       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1993           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1994           else ""
     1995         )
     1996       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1997       .
     1998   end.
     1999   function cur-time-string returns character
     2000   :
     2001     define variable v-date as date      no-undo .
     2002     define variable v-time as integer   no-undo .
     2003     run cur-time in this-procedure
     2004       (output v-date
     2005       ,output v-time
     2006       ) .
     2007     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2008   end.
     2009   function cur-time-string-sec returns character
     2010   :
     2011     define variable v-date as date      no-undo .
     2012     define variable v-time as integer   no-undo .
     2013     run cur-time in this-procedure
     2014       (output v-date
     2015       ,output v-time
     2016       ) .
     2017     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2018   end.
     2019   function cur-time-custom  returns character
     2020   (input p-prefix as character
     2021   ,input p-date-format as character
     2022   ,input p-delimiter as character
     2023   ,input p-time-format as character
     2024   ,input p-suffix as character
     2025   )
     2026   :
     2027     define variable v-date as date      no-undo .
     2028     define variable v-time as integer   no-undo .
     2029     run cur-time in this-procedure
     2030       (output v-date
     2031       ,output v-time
     2032       ) .
     2033     return
     2034       p-prefix
     2035       + string(v-date, p-date-format)
     2036       + p-delimiter
     2037       + string(v-time, p-time-format)
     2038       + p-suffix
     2039       .
     2040   end.
     2041   function cur-time-print  returns character
     2042   :
     2043     define variable v-date as date      no-undo .
     2044     define variable v-time as integer   no-undo .
     2045     run cur-time in this-procedure
     2046       (output v-date
     2047       ,output v-time
     2048       ) .
     2049     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2050   end.
     2051   function cur-time-datetime returns datetime
     2052   :
     2053     define variable v-char as character no-undo .
     2054     define variable v-datetime as datetime no-undo .
     2055     v-char = cur-time-string().
     2056     v-datetime = datetime(v-char).
     2057     return  v-datetime.
     2058   end.
     2059   function cur-time-string-msec returns character
     2060   :
     2061     define variable v-date as datetime  no-undo .
     2062     v-date = now.
     2063     return string(v-date) .
     2064   end.
     2065   define variable vss-include-info25 as character format "X(65)" no-undo
     2066   initial "@(#)$Workfile$ $Revision$".
     2067   procedure xmlchar-test :
     2068   define input parameter p-in-string          as character        no-undo.
     2069   define output parameter p-out-string-enc    as character        no-undo.
     2070   define output parameter p-out-string-dec    as character        no-undo.
     2071   do
     2072   on error undo, return error
     2073   :
     2074          run xmlchar-encode in this-procedure
     2075       (
     2076             input p-in-string
     2077           , output p-out-string-enc
     2078       ).
     2079          run xmlchar-decode in this-procedure
     2080       (
     2081             input p-out-string-enc
     2082           , output p-out-string-dec
