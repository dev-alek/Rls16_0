      370   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      372                                                                     input  orders as integer):
      373   define variable  round-m-sum as decimal no-undo.
      374   if orders >= 0 then
      375   round-m-sum = round(mysum,orders).
      376   else
      377   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      378   return round-m-sum.
      379   END FUNCTION.
      380   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   procedure factord :
      382     define input  parameter p-fact-date            as date    no-undo .
      383     define input  parameter p-fact-time            as integer no-undo .
      384     define input  parameter p-fact-num             as integer no-undo .
      385     define input  parameter p-shift-date           as date    no-undo .
      386     define input  parameter p-shift-num            as integer no-undo .
      387     define input  parameter p-shift-on             as logical no-undo .
      388     define output parameter p-fact-order           as decimal no-undo .
      389     define output parameter p-shift-end-fact-order as decimal no-undo .
      390     define output parameter p-day-end-fact-order   as decimal no-undo .
      391     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      392     if p-fact-date = ?
      393     then do:
      394       return error "Не указана фактическая дата" .
      395     end.
      396     define variable v-fact-date-num as integer no-undo .
      397     assign
      398       v-fact-date-num = integer(p-fact-date)
      399     .
      400     if p-fact-num = ?
      401     or p-fact-num = 0
      402     then do:
      403       return error "Не задан p-fact-num " + string(p-fact-num) .
      404     end.
      405     if p-fact-num < 0
      406     then do:
      407       return error "Отрицательный fact-num " + string(p-fact-num) .
      408     end.
      409     if p-fact-num >= 100000000
      410     then do:
      411       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      412     end.
      413     if p-shift-on = true
      414     then do:
      415       if p-shift-date = ?
      416       then do:
      417         return error "Не задана дата смены" .
      418       end.
      419       if p-shift-num = ?
      420       or p-shift-num = 0
      421       then do:
      422         return error "Не задан номер смены" .
      423       end.
      424     end.
      425     else do:
      426       assign
      427         p-shift-date = p-fact-date
      428         p-shift-num  = 24
      429       .
      430     end.
      431     define variable v-shift-offset as integer no-undo .
      432     if p-shift-date = p-fact-date
      433     then do:
      434       assign
      435         v-shift-offset = 1
      436       .
      437     end.
      438     if p-shift-date < p-fact-date
      439     then do:
      440       assign
      441         v-shift-offset = 0
      442       .
      443     end.
      444     if p-shift-date > p-fact-date
      445     then do:
      446       message
      447         vss-workfile vss-revision vss-description skip
      448         "Неправильная дата закрытия смены" skip
      449         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      450         view-as alert-box error .
      451       undo, return error
      452         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      453           ,string(p-fact-date, '99/99/9999':U)
      454           ,string(p-shift-date, '99/99/9999':U)
      455           )
      456       .
      457     end.
      458     if p-shift-num < 1
      459     or p-shift-num > 24
      460     then do:
      461       message
      462         vss-workfile vss-revision vss-description skip
      463         "Неправильный номер смены" skip
      464         "p-shift-num" p-shift-num skip
      465         view-as alert-box error .
      466       undo, return error return-value .
      467     end.
      468     assign
      469       p-fact-order           = v-fact-date-num
      470                              + v-shift-offset * 0.5
      471                              + p-shift-num    * 0.02 - 0.01
      472                              + p-fact-num     * 0.0000000001
      473       p-shift-end-fact-order = v-fact-date-num
      474                              + v-shift-offset * 0.5
      475                              + p-shift-num    * 0.02
      476       p-day-end-fact-order   = v-fact-date-num
      477                              + 0.99
      478     .
      479     if p-fact-order           <= v-fact-date-num
      480     or p-shift-end-fact-order <= v-fact-date-num
      481     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      482     or p-shift-end-fact-order >= p-day-end-fact-order
      483     then do:
      484       message
      485         vss-workfile vss-revision vss-description skip
      486         "Внутренняя ошибка при генерации фактического номера" skip
      487         "p-fact-date"            p-fact-date            skip
      488         "p-fact-time"            p-fact-time            skip
      489         "p-fact-num"             p-fact-num             skip
      490         "p-shift-date"           p-shift-date           skip
      491         "p-shift-num"            p-shift-num            skip
      492         "p-shift-on"             p-shift-on             skip
      493         "p-shift-end-fact-order" p-shift-end-fact-order skip
      494         "p-day-end-fact-order"   p-day-end-fact-order   skip
      495         "v-fact-date-num"        v-fact-date-num        skip
      496         view-as alert-box error .
      497       undo, return error return-value .
      498     end.
      499   end procedure.
      500   procedure day-begin-fact-order :
      501     define input  parameter p-fact-date            as date    no-undo .
      502     define output parameter p-day-begin-fact-order as decimal no-undo .
      503     do
      504     on error undo, return error return-value
      505     :
      506       if p-fact-date = ?
      507       then do:
      508         assign
      509           p-day-begin-fact-order = 0
      510         .
      511       end.
      512       else do:
      513         assign
      514           p-day-begin-fact-order = integer(p-fact-date)
      515         .
      516       end.
      517     end.
      518   end procedure.
      519   procedure factord-max-fact-order :
      520     define output parameter p-max-fact-order as decimal   no-undo .
      521     do
      522     on error undo, return error return-value
      523     :
      524       run day-begin-fact-order in this-procedure
      525         (input  date(1, 1, 5000)
      526         ,output p-max-fact-order
      527         ) .
      528     end.
      529   end procedure.
      530   procedure factord-cut-archive :
      531     define input  parameter p-obj-type             as character no-undo .
      532     define input  parameter p-obj-code             as integer   no-undo .
      533     define input  parameter p-fact-date            as date      no-undo .
      534     define output parameter p-shift-on             as logical   no-undo .
      535     define output parameter p-shift-date           as date      no-undo .
      536     define output parameter p-shift-num            as integer   no-undo .
      537     define output parameter p-day-end-fact-order   as decimal   no-undo .
      538     define output parameter p-shift-end-fact-order as decimal   no-undo .
      539     define variable v-fact-order as decimal   no-undo .
      540     define buffer buf_shift-obj for ub.shift-obj .
      541     do
      542     on error undo, return error return-value
      543     :
      544   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      546     (input  p-obj-type
      547     ,input  p-obj-code
      548     ,input  'shift-on=request'
      549     ,output p-shift-on
      550     ) no-error .
      551       if error-status :error
      552       then do:
      553         message
      554           vss-workfile vss-revision vss-description skip
      555           "Ошибка при определении атрибута объекта" skip
      556           "Объект" p-obj-type p-obj-code skip
      557           error-status :get-message(1) skip
      558           return-value skip
      559           view-as alert-box error .
      560         undo, return error return-value .
      561       end.
      562       if p-shift-on = false
      563       then do:
      564         assign
      565           p-shift-date               = ?
      566           p-shift-num                = 0
      567         .
      568       end.
      569       else do:
      570         find first buf_shift-obj share-lock
      571           where buf_shift-obj.obj-type   = p-obj-type
      572             and buf_shift-obj.obj-code   = p-obj-code
      573             and buf_shift-obj.shift-date > p-fact-date
      574           use-index pi
      575           no-error .
      576         if not available buf_shift-obj
      577         or buf_shift-obj.status_ <> 'зкр':U
      578         then do:
      579           message
      580             vss-workfile vss-revision vss-description skip
      581             "Невозможно вычислить последнюю смену" skip
      582             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      583             "Объект" p-obj-type p-obj-code skip
      584             "Дата" p-fact-date skip
      585             view-as alert-box error .
      586           undo, return error return-value .
      587         end.
      588         find last buf_shift-obj share-lock
      589           where buf_shift-obj.obj-type = p-obj-type
      590             and buf_shift-obj.obj-code = p-obj-code
      591             and buf_shift-obj.shift-date <= p-fact-date
      592           use-index pi
      593           no-error .
      594         if available buf_shift-obj
      595         then do:
      596           if  buf_shift-obj.status_ = 'зкр':U
      597           then do:
      598             assign
      599               p-shift-date = buf_shift-obj.shift-date
      600               p-shift-num  = buf_shift-obj.shift-num
      601             .
      602           end.
      603           else do:
      604             message
      605               vss-workfile vss-revision vss-description skip
      606               "Невозможно вычислить последнюю смену" skip
      607               "Статус смены отличен от статуса" 'зкр':U skip
      608               "Объект" p-obj-type p-obj-code skip
      609               "Дата" p-fact-date skip
      610               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      611               view-as alert-box error .
      612             undo, return error return-value .
      613           end.
      614         end.
      615         else do:
      616           assign
      617             p-shift-date = p-fact-date - 1
      618             p-shift-num  = 1
      619           .
      620         end.
      621       end.
      622       run factord in this-procedure
      623         (input  p-fact-date
      624         ,input  1
      625         ,input  1
      626         ,input  p-shift-date
      627         ,input  p-shift-num
      628         ,input  p-shift-on
      629         ,output v-fact-order
      630         ,output p-shift-end-fact-order
      631         ,output p-day-end-fact-order
      632         ) no-error .
      633       if error-status :error
      634       then do:
      635         message
      636           vss-workfile vss-revision vss-description skip
      637           "Ошибка при вызове процедуры factord"
      638           error-status :get-message(1) skip
      639           return-value skip
      640           view-as alert-box error .
      641         undo, return error return-value .
      642       end.
      643     end.
      644   end procedure.
      645   procedure factord-lock-shift :
      646     define input  parameter p-obj-type  as character no-undo .
      647     define input  parameter p-obj-code  as integer   no-undo .
      648     define input  parameter p-fact-date as date      no-undo .
      649     define parameter buffer buf_shift-obj for ub.shift-obj .
      650     define variable v-shift-on      as logical   no-undo .
      651     define variable v-extra-message as character no-undo .
      652     define variable v-error as character no-undo .
      653     do
      654     on error undo, return error return-value
      655     :
      656   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      658     (input  p-obj-type
      659     ,input  p-obj-code
      660     ,input  'shift-on=request'
      661     ,output v-shift-on
      662     ) no-error .
      663       if error-status :error
      664       then do:
      665         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      666         undo, return error v-error .
      667       end.
      668       if v-shift-on = true
      669       then do:
      670         find first buf_shift-obj share-lock
      671           where buf_shift-obj.obj-type   = p-obj-type
      672             and buf_shift-obj.obj-code   = p-obj-code
      673             and buf_shift-obj.shift-date > p-fact-date
      674           use-index pi
      675           no-error .
      676         if not available buf_shift-obj
      677         or buf_shift-obj.status_ <> 'зкр':U
      678         then do:
      679           find last buf_shift-obj
      680             where buf_shift-obj.obj-type = p-obj-type
      681               and buf_shift-obj.obj-code = p-obj-code
      682               and buf_shift-obj.status_  = 'зкр':U
      683             use-index stts
      684             no-error .
      685           if available buf_shift-obj
      686           then do:
      687             assign
      688               v-extra-message =
      689                     substitute("Дата начала последеней закрытой смены на объекте &1"
      690                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      691                               )
      692             .
      693           end.
      694           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      695           undo, return error v-error .
      696         end.
      697       end.
      698     end.
      699   end procedure.
      700   procedure factord-end-day :
      701     define input  parameter p-fact-date            as date    no-undo .
      702     define output parameter p-day-end-fact-order   as decimal no-undo .
      703     do
      704     on error undo, return error return-value
      705     :
      706       if p-fact-date = ?
      707       then do:
      708         return error "Не указана фактическая дата" .
      709       end.
      710       assign
      711         p-day-end-fact-order = integer(p-fact-date) + 0.99
      712       .
      713     end.
      714   end procedure.
      715   procedure factord-to-date :
      716     define input  parameter p-fact-order as decimal no-undo .
      717     define output parameter p-fact-date  as date    no-undo .
      718     define variable v-ref-date  as date      no-undo .
      719     define variable v-ref-delta as integer   no-undo .
      720     do
      721     on error undo, return error return-value
      722     :
      723       if p-fact-order = ?
      724       or p-fact-order = 0
      725       then do:
      726         return error "Не указан fact-order" .
      727       end.
      728       assign
      729         v-ref-date  = date(1, 1, 2000)
      730       .
      731       assign
      732         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      733       .
      734       assign
      735         p-fact-date = v-ref-date + v-ref-delta
      736       .
      737     end.
      738   end procedure.
      739   procedure factord-to-fact-num :
      740     define input  parameter p-fact-order as decimal no-undo .
      741     define output parameter p-fact-num   as integer no-undo .
      742     define variable v-fact-order-trunc as decimal no-undo .
      743     do
      744     on error undo, return error return-value
      745     :
      746       if p-fact-order = ?
      747       or p-fact-order = 0
      748       then do:
      749         return error "Не указан fact-order" .
      750       end.
      751       assign
      752        v-fact-order-trunc = truncate(p-fact-order, 2)
      753       .
      754       assign
      755         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      756       .
      757     end.
      758   end procedure.
      759   procedure factord-to-shift-num :
      760     define input  parameter p-fact-order as decimal no-undo .
      761     define output parameter p-shift-num   as integer no-undo .
      762     define variable  p-shift-numd  as decimal   no-undo .
      763     define variable v-fact-order-trunc as decimal no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       if p-fact-order = ?
      768       or p-fact-order = 0
      769       then do:
      770         return error "Не указан fact-order" .
      771       end.
      772       assign
      773        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      774       .
      775       if v-fact-order-trunc < 0.5 then do:
      776         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      777       end.
      778       assign
      779         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      780         .
      781        assign
      782         p-shift-num = truncate (p-shift-numd , 0)
      783       .
      784     end.
      785   end procedure.
      786   define new global shared variable g#lib-trn  as handle no-undo .
      787   define new global shared variable g#lib-trn2 as handle no-undo .
      788   define new global shared variable g#lib-trn3 as handle no-undo .
      789   define new global shared variable g#lib-trn4 as handle no-undo .
      790   define temp-table  tt-tax no-undo
      791     field tax-code    like ub.tax.tax-code
      792     field individual  like ub.tax.individual
      793     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      794     field rate-code   like ub.tax-rate.rate-code
      795     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      796     field tax-type    like ub.tax.tax-type
      797     field rate-value  like ub.tax-rate-value.rate-value
      798     field tax-rate-gds-rc  as recid
      799     field to-cashdesk like ub.tax.to-cashdesk
      800     index tax-code is unique primary tax-code
      801     .
      802   procedure tax-val :
      803     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      804     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      805     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      806     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      807     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      808     define input  parameter       parunits-type like ub.units.type         no-undo.
      809     define input  parameter       parrec-id     as recid                   no-undo.
      810     define input  parameter       paris-log     as logical                 no-undo.
      811     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      812     define input  parameter       vattaxcdvalue as integer                 no-undo.
      813     define input  parameter       exctaxcdvalue as integer                 no-undo.
      814     define input  parameter       only-check    as logical                 no-undo.
      815     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      816     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      817     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      818     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      819     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      820     define output parameter       parerr-mes    as character               no-undo.
      821     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      822     do
      823     on error undo, return error return-value
      824     :
      825   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      827   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      828   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      829   define variable gp-excise     like ub.price-list.excise     no-undo.
      830   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      831   define variable gp-fact-order as decimal   no-undo .
      832   define variable gp-price-sale-parts as decimal   no-undo .
      833       define buffer buf_tax          for ub.tax .
      834       define buffer buf_tax-rate     for ub.tax-rate .
      835       define buffer buf_tax-units    for ub.tax-units .
      836       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      837       define buffer buf_goods        for ub.goods .
      838       define buffer buf_bar-code     for ub.bar-code .
      839       define buffer buf_prod-bc      for ub.prod-bc .
      840       define buffer buf_units        for ub.units .
      841       define buffer buf_shop         for ub.shop .
      842       define buffer buf_store        for ub.store .
      843       define buffer buf_gds-prt      for ub.gds-prt .
      844       define buffer buf_tt-tax       for tt-tax .
      845       define variable varrate-value    as decimal   initial ? no-undo.
      846       define variable pr-list-recid    as recid     initial ? no-undo.
      847       define variable varmes           as character no-undo.
      848       define variable varfactorrtvalue as char      initial ? no-undo.
      849       define variable varfactorrttype  as char      initial ? no-undo.
      850       define variable is-petrolium     as logical no-undo.
      851       define variable is-pieces        as logical no-undo.
      852       define variable vargds-code      like ub.goods.gds-code no-undo.
      853       define variable pargds-code      like ub.goods.gds-code no-undo.
      854       define variable var-fact-order   as decimal no-undo .
      855       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      856       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      857       define variable currate-gds-rc   as recid no-undo .
      858       define variable v-today          as date no-undo .
      859       define variable v-time           as integer no-undo .
      860       for each buf_tt-tax:
      861         delete buf_tt-tax.
      862       end.
      863       run cur-time in this-procedure(output v-today, output v-time).
      864       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      865       if parartic     = ?
      866       or parprod-type = ?
      867       or parprod-code = ?
      868       or parunit-base = ?
      869       then do:
      870         find first buf_goods no-lock
      871           where recid(buf_goods) = parrec-id
      872           no-error .
      873       end.
      874       else do:
      875         find first buf_goods no-lock
      876           where buf_goods.artic = parartic
      877             and buf_goods.prod-type = parprod-type
      878             and buf_goods.prod-code = parprod-code
      879           no-error .
      880       end.
      881       if not available buf_goods then do:
      882         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      883         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      884       end.
      885       assign
      886         parartic     = buf_goods.artic
      887         parprod-type = buf_goods.prod-type
      888         parprod-code = buf_goods.prod-code
      889         parunit-base = buf_goods.unit-base
      890         pargds-code  = buf_goods.gds-code
      891       .
      892       if parunits-type = ?
      893       then do:
      894         find buf_units no-lock
      895           where buf_units.unit-name = parunit-base
      896           no-error .
      897         if not available buf_units then do:
      898           assign
      899             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      900           .
      901           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      902         end.
      903         assign
      904           parunits-type = buf_units.type
      905         .
      906       end.
      907       if parhost-code = ?
      908       or parhost-code = 0
      909       then do:
      910   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      912     (input  parobj-type
      913     ,input  abs(parobj-code)
      914     ,output parhost-code
      915     ) no-error .
      916         if error-status :error then do:
      917           assign
      918             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      919               ,string(parobj-type)
      920               ,string(parobj-code)
      921               ) + chr(10)
      922           .
      923           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      924         end.
      925       end.
      926       assign
      927         vargds-code = buf_goods.gds-code
      928       .
      929       for each buf_tax-units no-lock
      930         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      931       ,first buf_tax no-lock
      932         where buf_tax.tax-code = buf_tax-units.tax-code
      933       :
      934         find first buf_tt-tax where
      935                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      936         if not available buf_tt-tax then do:
      937           create buf_tt-tax .
      938         end.
      939         assign
      940           buf_tt-tax.tax-code = buf_tax.tax-code
      941         .
      942         if buf_tax.individual = false then do:
      943           assign
      944             currate-gds-rc = ?
      945           .
      946           _tax-rate-gds:
      947           for each buf_tax-rate-gds no-lock where
      948                   buf_tax-rate-gds.gds-code = pargds-code and
      949                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      950           first buf_tax-rate where
      951                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      952                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      953           by buf_tax-rate-gds.host-code
      954           by buf_tax-rate-gds.obj-type
      955           by buf_tax-rate-gds.obj-code
      956           by buf_tax-rate-gds.fact-order
      957           :
      958             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      959               next _tax-rate-gds.
      960             end.
      961             if buf_tax-rate-gds.host-code = 0 or
      962               ((buf_tax-rate-gds.host-code = parhost-code) or
      963               (buf_tax-rate-gds.obj-type = parobj-type AND
      964               buf_tax-rate-gds.obj-code = parobj-code))
      965             then do:
      966               assign
      967               currate-code = buf_tax-rate.rate-code
      968               currate-name = buf_tax-rate.rate-name
      969               currate-gds-rc = recid(buf_tax-rate)
      970               .
      971             end.
      972             else do:
      973               next _tax-rate-gds.
      974             end.
      975           end.
      976           if currate-gds-rc = ? then do:
      977             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      978                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      979                             chr(10).
      980             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      981           end.
      982         end.
      983         assign
      984           buf_tt-tax.rate-code   = currate-code
      985           buf_tt-tax.individual  = buf_tax.individual
      986           buf_tt-tax.tax-name    = buf_tax.tax-name
      987           buf_tt-tax.rate-name   = currate-name
      988           buf_tt-tax.tax-type    = buf_tax.tax-type
      989           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
      990           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
      991         .
      992       end.
      993       if parprice-sale = ?
