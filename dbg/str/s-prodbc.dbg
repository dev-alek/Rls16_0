     8365   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8366   PROCEDURE term-prt.
     8367   define buffer b-g-p for ub.gds-prt.
     8368   DEFINE var incode like ub.bar-code.in-code no-undo.
     8369   DEFINE var partcode like ub.bar-code.part-code no-undo.
     8370   DEFINE var unitcli like ub.bar-code.unit-cli no-undo.
     8371   DEFINE var clibaserate like ub.bar-code.cli-base-rate no-undo.
     8372   DEFINE var dpcnt  as decimal no-undo.
     8373   DEFINE var nodecode like ub.bar-code.node-code no-undo.
     8374   def buffer b-units for ub.units.
     8375   FIND FIRST ub.bar-code WHERE
     8376              ub.bar-code.b-code = ub.prod-bc.b-code NO-LOCK No-ERROR.
     8377   if v-is-restaurant then do:
     8378     find first buf_fbr-gds-obj no-lock where
     8379                 buf_fbr-gds-obj.obj-type = 'маг':U
     8380             AND buf_fbr-gds-obj.obj-code = i-obj-code
     8381             AND buf_fbr-gds-obj.gds-code = ub.bar-code.gds-code no-error .
     8382     if     available buf_fbr-gds-obj
     8383        and not buf_fbr-gds-obj.is-cd
     8384     then
     8385        return.
     8386   end.
     8387   FIND FIRST ub.goods WHERE
     8388              ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK NO-ERROR.
     8389   FIND FIRST b-units No-LOCK WHERE
     8390              b-units.unit-name = ub.bar-code.unit-cli NO-ERROR.
     8391   assign
     8392   incode = ub.bar-code.in-code
     8393   partcode = ub.bar-code.part-code
     8394   unitcli = ub.bar-code.unit-cli
     8395   clibaserate = ub.bar-code.cli-base-rate
     8396   nodecode = ub.bar-code.node-code
     8397   .
     8398   assign                 new-good = yes                 temp-discnt-rule_ = 0                 temp-discnt-method_ = ''                 petrol-trk = no                 tax-string = ""                 std-discnt-rule_ = 0                 for-wd = 0                 for-fp = no                 cashparts = no                 for-grp-code = 1                 for-petrol-purse = no                 qnty-discnt-rule_ = 0                 kat-discnt-rule_ = 0                 kat-discnt-method_ = ''                 date-discnt-rule_ = 0                 for-producer = "":U                 main-b-code = 0                 for-taracode = '00'                 abs-discnt-rule_ = 0                 for-wgd = 0                 . empty temp-table temp-dis-gds-rule. run cur-time in this-procedure(output v-today, output v-time).
     8399   run get-prt-and-unit in this-procedure (
     8400                                            input ub.goods.prt-root
     8401                                           ,input ub.goods.unit-base
     8402                                           ,output l-empty-scale
     8403                                           ) .                                            .
     8404   run get-gds-obj-fields in this-procedure(                                                  buffer ub.gds-obj                                                 ,input yes                                                 ,input ub.goods.gds-code                                                 ,input i-obj-code                                                 ,input 'маг':U                                                 ,output for-fact-qnty                                                 ,output cashparts                                                 ,output v-is-null-price                                                 ,output v-is-menu                                                 ,output v-is-semi-finished                                                 ,output v-is-modificator                                                 ,output v-fbr-grp-code                                                 ,output v-fbr-obj-code                                                 ) no-error .       if error-status:error then do:         run write-log-and-file in p-log-handle (                 input 1                                                                              , input log-file-name                                                                  , input 1                                                                              , input substitute("!!!Ошибка при получении характеристик товара &1 &2&3 на объекте"                                      , ub.gds-obj.artic                                                               , ub.gds-obj.prod-type                                                           , ub.gds-obj.prod-code                                                           )                                                                                         ).                                                            assign                                                                                  v-view-log = yes                                                                        .      end.
     8405   if not avail ub.gds-obj then return.
     8406   FIND FIRST b-g-p where b-g-p.node-code = nodecode NO-LOCK NO-ERROR.
     8407   if not avail b-g-p then do:
     8408     if not g#news then do:
     8409       message "Не найден узел шкалы для ДОПБК"
     8410               ub.prod-bc.b-str
     8411       view-as alert-box ERROR.
     8412       return error.
     8413     end.
     8414     else return error.
     8415   end.
     8416   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8417     if action = "U" then do:
     8418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8419     (input  ub.goods.gds-code
     8420     ,input  ?
     8421     ,output main-b-code
     8422     ) no-error .
     8423         find first buf_producer no-lock where
     8424                    buf_producer.obj-type = ub.goods.prod-type
     8425                AND buf_producer.obj-code = ub.goods.prod-code no-error .
     8426         assign
