     2086   procedure xmlchar-encode :
     2087   define input parameter p-in-string      as character        no-undo.
     2088   define output parameter p-out-string    as character        no-undo.
     2089       define variable v-position      as integer      no-undo.
     2090       define variable v-current-char  as character    no-undo.
     2091   do
     2092   on error undo, return error
     2093   :
     2094       assign
     2095           p-out-string = "":U
     2096       .
     2097       case p-in-string
     2098       :
     2099           when ?
     2100           then do:
     2101               assign
     2102                   p-out-string = "?":U
     2103               .
     2104           end.
     2105           when "?":U
     2106           then do:
     2107               assign
     2108                   p-out-string = "&#63;":U
     2109               .
     2110           end.
     2111           otherwise do:
     2112               do v-position = 1 to length( p-in-string )
     2113               :
     2114                   assign
     2115                       v-current-char = substring( p-in-string, v-position, 1 )
     2116                   .
     2117                   case v-current-char
     2118                   :
     2119                       when "&":U
     2120                       then do:
     2121                           assign
     2122                               p-out-string = p-out-string + "&amp;":U
     2123                           .
     2124                       end.
     2125                       when ">":U
     2126                       then do:
     2127                           assign
     2128                               p-out-string = p-out-string + "&gt;":U
     2129                           .
     2130                       end.
     2131                       when "<":U
     2132                       then do:
     2133                           assign
     2134                               p-out-string = p-out-string + "&lt;":U
     2135                           .
     2136                       end.
     2137                       when "'":U
     2138                       then do:
     2139                           assign
     2140                               p-out-string = p-out-string + "&apos;":U
     2141                           .
     2142                       end.
     2143                       when '"':U
     2144                       then do:
     2145                           assign
     2146                               p-out-string = p-out-string + "&quot;":U
     2147                           .
     2148                       end.
     2149                       when chr(1)
     2150                       then do:
     2151                           assign
     2152                               p-out-string = p-out-string + "":U
     2153                           .
     2154                       end.
     2155                       when chr(2)
     2156                       then do:
     2157                           assign
     2158                               p-out-string = p-out-string + "":U
     2159                           .
     2160                       end.
     2161                       when chr(3)
     2162                       then do:
     2163                           assign
     2164                               p-out-string = p-out-string + "":U
     2165                           .
     2166                       end.
     2167                       when chr(4)
     2168                       then do:
     2169                           assign
     2170                               p-out-string = p-out-string + "":U
     2171                           .
     2172                       end.
     2173                       when chr(5)
     2174                       then do:
     2175                           assign
     2176                               p-out-string = p-out-string + "":U
     2177                           .
     2178                       end.
     2179                       when chr(6)
     2180                       then do:
     2181                           assign
     2182                               p-out-string = p-out-string + "":U
     2183                           .
     2184                       end.
     2185                       when chr(7)
     2186                       then do:
     2187                           assign
     2188                               p-out-string = p-out-string + "":U
     2189                           .
     2190                       end.
     2191                       when chr(8)
     2192                       then do:
     2193                           assign
     2194                               p-out-string = p-out-string + "":U
     2195                           .
     2196                       end.
     2197                       when chr(9)
     2198                       then do:
     2199                           assign
     2200                               p-out-string = p-out-string + "":U
     2201                           .
     2202                       end.
     2203                       when chr(29)
     2204                       then do:
     2205                           assign
     2206                               p-out-string = p-out-string + "":U
     2207                           .
     2208                       end.
     2209                       when chr(10)
     2210                       then do:
     2211                           assign
     2212                               p-out-string = p-out-string + "&#10;":U
     2213                           .
     2214                       end.
     2215                       when chr(13)
     2216                       then do:
     2217                           assign
     2218                               p-out-string = p-out-string + "&#13;":U
     2219                           .
     2220                       end.
     2221                       otherwise do:
     2222                           assign
     2223                               p-out-string = p-out-string + v-current-char
     2224                           .
     2225                       end.
     2226                   end case.
     2227               end.
     2228           end.
     2229       end case.
     2230   end.
     2231   end .
     2232   procedure xmlchar-encode-1c :
     2233   define input parameter p-in-string      as character        no-undo.
     2234   define output parameter p-out-string    as character        no-undo.
     2235       define variable v-position      as integer      no-undo.
     2236       define variable v-current-char  as character    no-undo.
     2237   do
     2238   on error undo, return error
     2239   :
     2240       assign
     2241           p-out-string = "":U
     2242       .
     2243       case p-in-string
     2244       :
     2245           when ?
     2246           then do:
     2247               assign
     2248                   p-out-string = "?":U
     2249               .
     2250           end.
     2251           otherwise do:
     2252               do v-position = 1 to length( p-in-string )
     2253               :
     2254                   assign
     2255                       v-current-char = substring( p-in-string, v-position, 1 )
     2256                   .
     2257                   case v-current-char
     2258                   :
     2259                       when chr(1)
     2260                       then do:
     2261                           assign
     2262                               p-out-string = p-out-string + " ":U
     2263                           .
     2264                       end.
     2265                       when chr(2)
     2266                       then do:
     2267                           assign
     2268                               p-out-string = p-out-string + " ":U
     2269                           .
     2270                       end.
     2271                       when chr(3)
     2272                       then do:
     2273                           assign
     2274                               p-out-string = p-out-string + " ":U
     2275                           .
     2276                       end.
     2277                       when chr(4)
     2278                       then do:
     2279                           assign
     2280                               p-out-string = p-out-string + " ":U
     2281                           .
     2282                       end.
     2283                       when chr(5)
     2284                       then do:
     2285                           assign
     2286                               p-out-string = p-out-string + " ":U
     2287                           .
     2288                       end.
     2289                       when chr(6)
     2290                       then do:
     2291                           assign
     2292                               p-out-string = p-out-string + " ":U
     2293                           .
     2294                       end.
     2295                       when chr(7)
     2296                       then do:
     2297                           assign
     2298                               p-out-string = p-out-string + " ":U
     2299                           .
     2300                       end.
     2301                       when chr(8)
     2302                       then do:
     2303                           assign
     2304                               p-out-string = p-out-string + " ":U
     2305                           .
     2306                       end.
     2307                       when chr(9)
     2308                       then do:
     2309                           assign
     2310                               p-out-string = p-out-string + " ":U
     2311                           .
     2312                       end.
     2313                       when chr(29)
     2314                       then do:
     2315                           assign
     2316                               p-out-string = p-out-string + " ":U
     2317                           .
     2318                       end.
     2319                       when chr(10)
     2320                       then do:
     2321                           assign
     2322                               p-out-string = p-out-string + " ":U
     2323                           .
     2324                       end.
     2325                       when chr(13)
     2326                       then do:
     2327                           assign
     2328                               p-out-string = p-out-string + " ":U
     2329                           .
     2330                       end.
     2331                       otherwise do:
     2332                           assign
     2333                               p-out-string = p-out-string + v-current-char
     2334                           .
     2335                       end.
     2336                   end case.
     2337               end.
     2338           end.
     2339       end case.
     2340   end.
     2341   end .
     2342   procedure xmlchar-decode :
     2343   define input parameter p-in-string      as character        no-undo.
     2344   define output parameter p-out-string    as character        no-undo.
     2345       define variable v-position      as integer      no-undo.
     2346       define variable v-last-position as integer      no-undo.
     2347       define variable v-temp-integer  as integer      no-undo.
     2348       define variable v-current-char  as character    no-undo.
     2349       define variable v-next-char     as character    no-undo.
     2350       define variable v-success       as logical      no-undo.
     2351   do
     2352   on error undo, return error
     2353   :
     2354       assign
     2355           p-out-string = "":U
     2356           v-position   = 0
     2357       .
     2358       replace-cycle:
     2359       do while yes
     2360       on error undo, return error
     2361       :
     2362           assign
     2363               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2364           .
     2365           if v-last-position <= v-position
     2366           then do:
     2367               if v-position = 0
     2368               then do:
     2369                   assign
     2370                       p-out-string = p-in-string
     2371                   .
     2372               end.
     2373               else do:
     2374                   assign
     2375                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2376                   .
     2377               end.
     2378               leave replace-cycle.
     2379           end.
     2380           else do:
     2381               assign
     2382                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2383                   v-position      = v-last-position
     2384                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2385               .
     2386               if v-current-char = "#":U
     2387               then do:
     2388                   assign
     2389                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2390                   .
     2391                   if v-last-position > 0
     2392                   then do:
     2393                       run xmlchar-read-integer in this-procedure
     2394                        (
     2395                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2396                           , output v-temp-integer
     2397                           , output v-success
     2398                       ).
     2399                       if v-success = yes
     2400                       and v-temp-integer >= 1
     2401                       and v-temp-integer <= 255
     2402                       then do:
     2403                           assign
     2404                               p-out-string = p-out-string + chr( v-temp-integer )
     2405                               v-position   = v-last-position + 1
     2406                           .
     2407                       end.
     2408                       else do:
     2409                           assign
     2410                               p-out-string = p-out-string + "&":U
     2411                               v-position   = v-position   + 1
     2412                           .
     2413                       end.
     2414                   end.
     2415                   else do:
     2416                       assign
     2417                           p-out-string = p-out-string + "&":U
     2418                           v-position   = v-position   + 1
     2419                       .
     2420                   end.
     2421               end.
     2422               else do:
     2423                   case substring( p-in-string, v-position + 1, 3 )
     2424                   :
     2425                       when "lt;":U
     2426                       then do:
     2427                           assign
     2428                               p-out-string = p-out-string + "<":U
     2429                               v-position   = v-position   + 3
     2430                           .
     2431                       end.
     2432                       when "gt;":U
     2433                       then do:
     2434                           assign
     2435                               p-out-string = p-out-string + ">":U
     2436                               v-position   = v-position   + 3
     2437                           .
     2438                       end.
     2439                       otherwise do:
     2440                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2441                           then do:
     2442                               assign
     2443                                   p-out-string = p-out-string + "&":U
     2444                                   v-position   = v-position   + 4
     2445                               .
     2446                           end.
     2447                           else do:
     2448                               case substring( p-in-string, v-position + 1, 5 )
     2449                               :
     2450                                   when "quot;":U
     2451                                   then do:
     2452                                       assign
     2453                                           p-out-string = p-out-string + '"':U
     2454                                           v-position   = v-position   + 5
     2455                                       .
     2456                                   end.
     2457                                   when "apos;":U
     2458                                   then do:
     2459                                       assign
     2460                                           p-out-string = p-out-string + "'":U
     2461                                           v-position   = v-position   + 5
     2462                                       .
     2463                                   end.
     2464                                   otherwise do:
     2465                                       assign
     2466                                           p-out-string = p-out-string + "&":U
     2467                                       .
     2468                                   end.
     2469                               end case.
     2470                           end.
     2471                       end.
     2472                   end case.
     2473               end.
     2474           end.
     2475       end.
     2476   end.
     2477   end .
     2478   procedure xmlchar-read-integer :
     2479   define input parameter p-input-string      as character        no-undo.
     2480   define output parameter p-output-integer   as integer          no-undo.
     2481   define output parameter p-success       as logical          no-undo.
     2482   do
     2483   on error undo, return error
     2484   :
     2485       assign
     2486           p-output-integer = integer( p-input-string )
     2487       no-error.
     2488       if error-status :error
     2489       then do:
     2490           assign
     2491               p-success           = no
     2492               p-output-integer    = 0
     2493           .
     2494       end.
     2495       else do:
     2496           assign
     2497               p-success           = yes
     2498           .
     2499       end.
     2500   end.
     2501   end.
     2502   define variable v-bgelib-bgeclall           as logical      no-undo.
     2503   define variable v-bgelib-bgedict            as logical      no-undo.
     2504   define temp-table temp_ext-doc-type no-undo
     2505       field edt-key               as integer
     2506       field ext-doc-type          as character
     2507       field ext-doc-type-label    as character
     2508       index pi is primary unique
     2509           edt-key
     2510   .
     2511   define temp-table temp_bgelib_goods no-undo
     2512       field gds-code as integer
     2513       index pi is primary unique
     2514           gds-code
     2515   .
     2516   define temp-table temp_bgelib_clients no-undo
     2517       field obj-type as character
     2518       field obj-code as integer
     2519       index pi is primary unique
     2520           obj-type
     2521           obj-code
     2522   .
     2523   define temp-table temp_bgelib_dis-card no-undo
     2524       field d-card as character
     2525       index pi is primary unique
     2526           d-card
     2527   .
     2528   define temp-table temp_bgelib_trn-doc no-undo
     2529       field doc-code as integer
     2530   .
     2531   procedure bgelib-tag-open:
     2532   do
     2533   on error undo, return error
     2534   :
     2535   define input parameter v-tag-level  as integer      no-undo.
     2536   define input parameter v-tag-name   as character    no-undo.
     2537   define input parameter v-tag-value  as character    no-undo.
     2538       put stream stmXMLOut unformatted
     2539           chr(10)
     2540           + fill(" ", 4 * v-tag-level)
     2541           + "<" + v-tag-name
     2542           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2543           + v-tag-value + ">"
     2544       .
     2545   end.
     2546   end procedure.
     2547   procedure bgelib-tag-put:
     2548   do
     2549   on error undo, return error
     2550   :
     2551   define input parameter v-tag-level      as integer      no-undo.
     2552   define input parameter v-tag-name       as character    no-undo.
     2553   define input parameter v-tag-value      as character    no-undo.
     2554   define input parameter v-empty-mode     as integer      no-undo.
     2555       v-tag-name = trim(v-tag-name).
     2556       if  v-empty-mode = 1
     2557       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2558       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2559       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2560       then do:
     2561           run xmlchar-encode in this-procedure (
     2562                 input v-tag-value
     2563               , output v-tag-value
     2564           ).
     2565           put stream stmXMLOut unformatted
     2566               chr(10) + fill(" ", 4 * v-tag-level)
     2567                           + '<' + v-tag-name + '>'
     2568                           + v-tag-value
     2569                           + '</' + v-tag-name + '>'
     2570           .
     2571       end.
     2572   end.
     2573   end procedure.
     2574   procedure bgelib-tag-close:
     2575   do
     2576   on error undo, return error
     2577   :
     2578   define input parameter v-tag-level as integer      no-undo.
     2579   define input parameter v-tag-name  as character    no-undo.
     2580       put stream stmXMLOut unformatted
     2581           chr(10)
     2582           + fill( " ", 4 * v-tag-level)
     2583           + '</' + v-tag-name + '>'
     2584       .
     2585   end.
     2586   end procedure.
     2587   procedure bgelib-write-log:
     2588   do
     2589   on error undo, return error
     2590   :
     2591   define input parameter v-filename   as character    no-undo.
     2592   define input parameter v-log-level  as integer      no-undo.
     2593   define input parameter v-out-string as character    no-undo.
     2594       output stream stmXMLLog to value( v-filename ) append.
     2595       put stream stmXMLLog unformatted
     2596           chr(10)
     2597       .
     2598       put stream stmXMLLog unformatted
     2599           ( if v-log-level = 0
     2600             or v-out-string = "&DLine"
     2601             or v-out-string = "&Line"
     2602             then ""
     2603             else cur-time-string-sec() + " " )
     2604       .
     2605       put stream stmXMLLog unformatted
     2606           ( if v-out-string = "&Line"
     2607             then fill( "-", 80 )
     2608             else if v-out-string = "&DLine"
     2609                  then fill( "=", 80 )
     2610                  else v-out-string )
     2611       .
     2612       output stream stmXMLLog close.
     2613   end.
     2614   end procedure.
     2615   procedure bgelib-write-edt:
     2616   do
     2617   on error undo, return error
     2618   :
     2619   define input parameter v-editor-handle    as handle       no-undo.
     2620   define input parameter v-log-level        as integer      no-undo.
     2621   define input parameter v-out-string       as character    no-undo.
     2622       if valid-handle ( v-editor-handle )
     2623       then do:
     2624           v-editor-handle :move-to-eof().
     2625           v-editor-handle :insert-string( ( if v-log-level = 0
     2626                                             or v-out-string = "&DLine"
     2627                                             or v-out-string = "&Line"
     2628                                             then ""
     2629                                             else cur-time-string-sec() + " "
     2630                                         ) ).
     2631           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2632                                             then fill( "-", 80 )
     2633                                             else if v-out-string = "&DLine" then fill("=", 80)
     2634                                             else fill( " ", v-log-level) + v-out-string
     2635                                         ) ).
     2636           v-editor-handle :insert-string( chr(10) ).
     2637       end.
     2638       process events.
     2639       output to 'bgescn.txt' append.
     2640           put unformatted
     2641               chr(10)
     2642               string( ( if v-log-level = 0
     2643                         or v-out-string = "&DLine"
     2644                         or v-out-string = "&Line"
     2645                         then ""
     2646                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2647                     ) )
     2648               string( ( if v-out-string = "&Line"
     2649                         then fill( "-", 80 )
     2650                         else if v-out-string = "&DLine"
     2651                              then fill( "=", 80 )
     2652                              else fill( " ", v-log-level ) + v-out-string
     2653                     ) )
     2654           .
     2655       output close.
     2656   end.
     2657   end procedure.
     2658   procedure bgelib-show-cnt:
     2659   do
     2660   on error undo, return error
     2661   :
     2662   define input parameter v-fillin-handle     as handle   no-undo.
     2663       if valid-handle( v-fillin-handle )
     2664       then do:
     2665           assign
     2666               v-fillin-handle :visible = true
     2667           .
     2668       end.
     2669   end.
     2670   end procedure.
     2671   procedure bgelib-hide-cnt:
     2672   do
     2673   on error undo, return error
     2674   :
     2675   define input parameter v-fillin-handle     as handle   no-undo.
     2676       if valid-handle( v-fillin-handle )
     2677       then do:
     2678           assign v-fillin-handle :visible = false.
     2679       end.
     2680   end.
     2681   end procedure.
     2682   procedure bgelib-write-cnt:
     2683   do
     2684   on error undo, return error
     2685   :
     2686   define input parameter v-fillin-handle    as handle       no-undo.
     2687   define input parameter v-fillin-string    as character    no-undo.
     2688       if valid-handle( v-fillin-handle )
     2689       then do:
     2690           assign
     2691               v-fillin-handle :SCREEN-value = v-fillin-string
     2692           .
     2693       end.
     2694   end.
     2695   end procedure.
     2696   procedure bgelib-write-header:
     2697   do
     2698   on error undo, return error
     2699   :
     2700   define input parameter p-first-file     as logical      no-undo.
     2701   define input parameter p-xml-file-name  as character    no-undo.
     2702   define input parameter p-list-file-name as character    no-undo.
     2703   define input parameter p-file-number    as integer      no-undo.
     2704   define input parameter p-have-prev      as logical      no-undo.
     2705   define input parameter p-prev-filename  as character    no-undo.
     2706   define input parameter p-obj-list       as character    no-undo.
     2707   define input parameter p-doc-type-list  as character    no-undo.
     2708   define input parameter p-parameter-list as character    no-undo.
     2709       define variable v-counter    as integer        no-undo.
     2710       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2711       put stream stmXMLOut unformatted
     2712           "<?xml version='1.0' encoding='windows-1251'?>"
     2713       .
     2714       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2715       run bgelib-tag-open( input 0, input "header", input "" ).
     2716       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2717       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2718       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2719       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2720       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2721       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2722       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2723       :
     2724           run bgelib-tag-put(
     2725                 input 1
     2726               , input entry( 2 * v-counter, p-parameter-list )
     2727               , input entry( 2 * v-counter + 1, p-parameter-list )
     2728               , input 0
     2729           ).
     2730       end.
     2731       run bgelib-tag-close( input 0, input "header" ).
     2732       output stream stmXMLOut close.
     2733       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2734       if p-first-file = yes
     2735       then do:
     2736           put stream stmXMLOut unformatted
     2737               "<?xml version='1.0' encoding='windows-1251'?>"
     2738           .
     2739           run bgelib-tag-open( input 0, input "export", input "" ).
     2740       end.
     2741       run bgelib-tag-open( input 1, input "file", input "" ).
     2742       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2743       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2744       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2745       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2746       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2747       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2748       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2749       :
     2750           run bgelib-tag-put(
     2751                 input 2
     2752               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2753               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2754               , input 0
     2755           ).
     2756       end.
     2757       run bgelib-tag-close( input 1, input "file" ).
     2758       output stream stmXMLOut close.
     2759   end.
     2760   end procedure.
     2761   procedure bgelib-write-footer:
     2762   do
     2763   on error undo, return error
     2764   :
     2765   define input parameter p-last-file      as logical      no-undo.
     2766   define input parameter p-xml-file-name  as character    no-undo.
     2767   define input parameter p-list-file-name as character    no-undo.
     2768   define input parameter p-have-next      as logical      no-undo.
     2769   define input parameter p-next-file-name as character    no-undo.
     2770       define variable v-error-num     as integer           no-undo.
     2771       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2772       if p-have-next = yes
     2773       then do:
     2774           run bgelib-tag-open( input 0, input "footer", "" ).
     2775           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2776           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2777           run bgelib-tag-close( input 0, input "footer" ).
     2778       end.
     2779       run bgelib-tag-close( input 0, input "root" ).
     2780       output stream stmXMLOut close.
     2781       run bge/os_copy.p (
     2782             input "M"
     2783           , input p-xml-file-name + "tmp"
     2784           , input p-xml-file-name + "xml"
     2785           , output v-error-num
     2786       ).
     2787       if p-last-file = yes
     2788       then do:
     2789           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2790               run bgelib-tag-close( input 0, input "export" ).
     2791           output stream stmXMLOut close.
     2792           run bge/os_copy.p (
     2793                 input "M"
     2794               , input p-list-file-name + "tmp"
     2795               , input p-list-file-name + "xml"
     2796               , output v-error-num
     2797           ).
     2798       end.
     2799   end.
     2800   end procedure.
     2801   procedure bgelib-filename :
     2802   do
     2803   on error undo, return error
     2804   :
     2805   define input parameter p-prefix             as character    no-undo.
     2806   define output parameter p-xml-file-name     as character    no-undo.
     2807   define output parameter p-log-file-name     as character    no-undo.
     2808   define output parameter p-list-file-name    as character    no-undo.
     2809       define variable v-home-dir  as character    no-undo.
     2810       define variable v-error-num as integer      no-undo.
     2811       get-key-value section "BGE" key "outdir" value v-home-dir.
     2812       if v-home-dir = ?
     2813       then do:
     2814           message
     2815             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2816             skip(1)
     2817             skip "Обратитесь к администратору."
     2818           view-as alert-box error.
     2819           undo, return error .
     2820       end.
     2821       run gbl/dir-cre.p (
     2822           input v-home-dir
     2823       ) no-error.
     2824       if error-status :error
     2825       then do:
     2826           message
     2827             skip "Неверно задан каталог экспорта."
     2828             skip(1)
     2829             skip "Обратитесь к администратору."
     2830           view-as alert-box error.
     2831           undo, return error .
     2832       end.
     2833       run bge/genfname.p (
     2834             input v-home-dir
     2835           , input p-prefix
     2836           , input ""
     2837           , input "xml"
     2838           , input "tmp"
     2839           , output p-xml-file-name
     2840       ).
     2841       assign
     2842           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2843           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2844           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2845       .
     2846   end.
     2847   end procedure.
     2848   procedure bgelib-read-config :
     2849   do
     2850   on error undo, return error
     2851   :
     2852   define variable v-par-type as character     no-undo.
     2853     define variable v-param-type      as character  no-undo .
     2854     define variable v-value-character as character  no-undo .
     2855     define variable v-value-date      as date       no-undo .
     2856     define variable v-value-decimal   as decimal    no-undo .
     2857     define variable v-value-integer   as integer    no-undo .
     2858     define variable v-value-logical   as logical    no-undo .
     2859     define variable v-tth             as handle     no-undo .
     2860       assign
     2861           v-bgelib-bgeclall = no
     2862           v-bgelib-bgedict  = no
     2863       .
     2864       run adm/shattri.p ( input "get":U
     2865                         , input  '':u
     2866                         , input  0
     2867                         , input  'bge-export':U
     2868                         , input  'bgeclall':U
     2869                         , output v-value-character
     2870                         , output v-value-date
     2871                         , output v-value-decimal
     2872                         , output v-value-integer
     2873                         , output v-value-logical
     2874                         , output v-param-type
     2875                         , input-output table-handle v-tth
     2876                         ) no-error .
     2877       if error-status :error
     2878       then do:
     2879         assign
     2880           v-bgelib-bgeclall = no
     2881         .
     2882       end.
     2883       else do:
     2884         assign
     2885           v-bgelib-bgeclall = v-value-logical
     2886         .
     2887       end.
     2888       delete object v-tth.
     2889       run adm/shattri.p ( input "get":U
     2890                         , input  '':u
     2891                         , input  0
     2892                         , input  'bge-export':U
     2893                         , input  'bgedict':U
     2894                         , output v-value-character
     2895                         , output v-value-date
     2896                         , output v-value-decimal
     2897                         , output v-value-integer
     2898                         , output v-value-logical
     2899                         , output v-param-type
     2900                         , input-output table-handle v-tth
     2901                         ) no-error .
     2902       if error-status :error
     2903       then do:
     2904         assign
     2905           v-bgelib-bgedict = no
     2906         .
     2907       end.
     2908       else do:
     2909         assign
     2910           v-bgelib-bgedict = v-value-logical
     2911         .
     2912       end.
     2913       delete object v-tth.
     2914       run adm/shattri.p ( input "get":U
     2915                         , input  '':u
     2916                         , input  0
     2917                         , input  'bge-export':U
     2918                         , input  'bgefmt':U
     2919                         , output v-value-character
     2920                         , output v-value-date
     2921                         , output v-value-decimal
     2922                         , output v-value-integer
     2923                         , output v-value-logical
     2924                         , output v-param-type
     2925                         , input-output table-handle v-tth
     2926                         ) no-error .
     2927       if error-status :error
     2928       then do:
     2929         assign
     2930           v-bgelib-bgefmt  = "xml":U
     2931         .
     2932       end.
     2933       else do:
     2934         assign
     2935           v-bgelib-bgefmt  = v-value-character
     2936         .
     2937       end.
     2938       delete object v-tth.
     2939       run adm/shattri.p ( input "get":U
     2940                         , input  '':u
     2941                         , input  0
     2942                         , input  'bge-export':U
     2943                         , input  'bgeflold':U
     2944                         , output v-value-character
     2945                         , output v-value-date
     2946                         , output v-value-decimal
     2947                         , output v-value-integer
     2948                         , output v-value-logical
     2949                         , output v-param-type
     2950                         , input-output table-handle v-tth
     2951                         ) no-error .
     2952       if error-status :error
     2953       then do:
     2954         assign
     2955           v-bgelib-bgeflold  = "old":U
     2956         .
     2957       end.
     2958       else do:
     2959         assign
     2960           v-bgelib-bgeflold  = v-value-character
     2961         .
     2962       end.
     2963       delete object v-tth.
     2964   end.
     2965   end procedure.
     2966   procedure bgelib-check-file-size :
     2967   do
     2968   on error undo, return error
     2969   :
     2970   define input parameter p-out-filename   as character    no-undo.
     2971   define output parameter p-is-big        as logical      no-undo.
     2972       define variable v-current-position    as integer        no-undo.
     2973       assign
     2974           v-current-position = seek( stmXMLOut )
     2975       .
     2976       if v-current-position / 1024 / 1024  >= 100
     2977       then do:
     2978           assign
     2979               p-is-big = yes
     2980           .
     2981       end.
     2982   end.
     2983   end procedure.
     2984   procedure bgelib-init-ext-doc-type :
     2985       define variable v-counter    as integer      no-undo.
     2986       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2987   do
     2988   for buf_temp_ext-doc-type
     2989   on error undo, return error
     2990   :
     2991       empty temp-table buf_temp_ext-doc-type.
     2992       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2993       :
     2994           create buf_temp_ext-doc-type.
     2995           assign
     2996               buf_temp_ext-doc-type.edt-key               = v-counter
     2997               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2998               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2999           .
     3000       end.
     3001   end.
     3002   end procedure.
     3003   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3004   define variable v-xml-file-name     as character            no-undo.
     3005   define variable v-xml-file-name-path as character            no-undo.
     3006   define variable v-log-file-name     as character            no-undo.
     3007   define variable v-locked            as logical              no-undo.
     3008   define variable v-log-string        as character            no-undo.
     3009   define variable v-oper-num          as integer              no-undo.
     3010   define variable v-obj-list          as character            no-undo.
     3011   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3012   DEF VAR intRep      AS INT NO-UNDO.
