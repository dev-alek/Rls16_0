    12882                       ,input out
    12883                       ,input fname
    12884                       ,input v-remote
    12885                       ,input v-is-script103
    12886                       ) no-error .
    12887   if error-status:error then do:
    12888     for each temp-tekka-tsk:
    12889       os-delete value( temp-tekka-tsk.filename) .
    12890       delete temp-tekka-tsk.
    12891     end.
    12892     run write-log-and-file in p-log-handle (
    12893           input 1
    12894         , input log-file-name
    12895         , input 1
    12896         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    12897                              ,for-cash-desk.cash-num
    12898                              ,chr(10)
    12899                              ,return-value
    12900                           )
    12901                                           ).
    12902     assign
    12903     v-view-log = yes
    12904     .
    12905       for each temp-cd-plu:
    12906         delete temp-cd-plu.
    12907       end.
    12908     return "error":U.
    12909   end.
    12910   else do:
    12911     for each temp-cd-plu,
    12912         first buf_cd-plu where
    12913                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    12914                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    12915                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    12916                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    12917                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    12918       if temp-cd-plu.to-del = yes
    12919       and v-del-mrkt-gds
    12920       then do:
    12921         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    12922           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    12923           assign
    12924           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    12925           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    12926           .
    12927         end.
    12928         if buf_cd-plu.charkey_one = '':U then do:
    12929           delete buf_cd-plu.
    12930           NEXT.
    12931         end.
    12932       end.
    12933       if temp-cd-plu.charkey_two = "":U
    12934       then
    12935       assign
    12936       buf_cd-plu.charkey_two = "":U
    12937       buf_cd-plu.to-send = no
    12938       .
    12939       delete temp-cd-plu.
    12940     end.
    12941   end.
    12942   end.
    12943   run cd-mrkt_update-marketer in this-procedure (
