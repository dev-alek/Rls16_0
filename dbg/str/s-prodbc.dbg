     7599   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7600   PROCEDURE asc-gds.
     7601   DEFINE parameter buffer loc-goods for ub.goods.
     7602   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7603   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7604   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7605   DEFINE parameter buffer loc-price-list for ub.price-list.
     7606   DEFINE parameter buffer loc-units for ub.units.
     7607   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7608   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7609   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7610   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7611   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7612   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7613   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7614   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7615   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7616   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7617   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7618   define variable v-disc-price-sale as decimal no-undo .
     7619   define variable v-pdf-id as integer no-undo .
     7620   define variable v-pdf-db-num as integer no-undo .
     7621   define variable v-oss as character no-undo.
     7622   define variable v-gtd as character no-undo .
     7623   define variable v-is-gas as character no-undo .
     7624   define variable v-ban-bonus as character no-undo .
     7625   define variable v-ptrl-as-good as character no-undo .
     7626   define variable v-type as character no-undo .
     7627   define variable disc-b-code as integer no-undo .
     7628   define variable v-main-prt-b-code as integer no-undo .
     7629   define variable IBM-good-code as character no-undo .
     7630   define variable IBM-good-code-2 as character no-undo .
     7631   define variable IBM2-short      as character no-undo .
     7632   define variable v-gds-null-price as character no-undo .
     7633   define variable iii as integer no-undo .
     7634   define variable v-mask-full as character no-undo .
     7635   define variable v-mask-short as character no-undo .
     7636   define variable vKKT as integer no-undo.
     7637   define variable attrValue as character no-undo.
     7638   define variable attrType  as character no-undo.
     7639   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7640   define buffer buf_price-list for ub.price-list.
     7641   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7642   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7643   define buffer main-prt-bar-code  for ub.bar-code.
     7644   define buffer buf_goods-attr for goods-attr.
     7645   define buffer b-code for code.
     7646   if action = "U" then do:
     7647     if loc-bar-code.stts = Integer('79':U) then return.
     7648       for-price = ?.
     7649   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7651     (input  'маг':U
     7652     ,input  ub.shop.obj-code
     7653     ,input  loc-bar-code.b-code
     7654     ,input  main-b-code
     7655     ,input  0
     7656     ,output v-doc-num
     7657     ,output for-price
     7658     ,output for-road
     7659     ,output for-excise
     7660     ) no-error .
     7661       if error-status:error then do:
     7662           if g#news
     7663           or g#auto
     7664           or g#esys
     7665           then return error.
     7666           else do:
     7667               error-status:error = no.
     7668               message "Ошибка при определении цены на товар "
     7669                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7670               view-as alert-box ERROR.
     7671               return.
     7672           end.
     7673       end.
     7674       if return-value = "error" then do:
     7675           if for-price = ? then do:
     7676             return.
     7677           end.
     7678           if not g#news
     7679           and not g#auto
     7680           and not g#esys
     7681           then
     7682           message prichina view-as alert-box ERROR.
     7683           return error.
     7684       end.
     7685       else if (for-price = ? or for-price = 0) then do:
     7686         if v-is-restaurant and v-is-null-price  then do:
     7687           assign
     7688           for-price = 0.
     7689         end.
     7690         else do:
     7691           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7692                                                  ,input 'null-price':U
     7693                                                  ,output v-gds-null-price
     7694                                                  ,output v-type) no-error.
     7695           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7696           return "NEXT".
     7697         end.
     7698       end.
     7699     end.
     7700     else do:
     7701           for-price = 0.
     7702     end.
     7703   for-price = round-m( for-price , rnd-znak ).
     7704   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7705   start-paket = no.
     7706   if not avail cash-gds then do:
     7707   create cash-gds.
     7708   error-status:error = false.
     7709   end.
     7710   cash-gds.crf = cr + 1.
     7711   cr = cr + 1.
     7712   if loc-bar-code.in-code <> ''
     7713   or loc-bar-code.part-code <> ''
     7714   then do:
     7715     find first main-prt-bar-code no-lock where
     7716               main-prt-bar-code.gds-code = loc-goods.gds-code
     7717           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7718           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7719           and main-prt-bar-code.part-code = ''
     7720           and main-prt-bar-code.in-code = '' no-error.
     7721     if available main-prt-bar-code then do:
     7722       v-main-prt-b-code = main-prt-bar-code.b-code.
     7723     end.
     7724   end.
     7725   else do:
     7726     v-main-prt-b-code = loc-bar-code.b-code.
     7727   end.
     7728   find first tt-tax no-lock where
     7729              tt-tax.tax-code = vattaxcd no-error .
     7730   do iii = 1 to num-entries(mask_s-c) :
     7731     assign
     7732       v-mask-full  = trim(entry(iii, mask_s-c))
     7733       v-mask-short = entry(1, v-mask-full, "*")
     7734       loc-prod-bc  = trim(loc-prod-bc)
     7735     .
     7736     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7737       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7738   end.
     7739   define variable vBc-on as logical no-undo.
     7740   if loc-prod-bc ne ?
     7741   then do:
     7742       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7743                            and prod-bc.b-str  eq loc-prod-bc
     7744                            no-lock no-error.
     7745       if available prod-bc
     7746       then
     7747          vBc-on = prod-bc.bc-on.
     7748       else
     7749          vBc-on = yes.
     7750   end.
     7751   else
     7752      vBc-on = yes.
     7753   run gdsoattr-value in this-procedure (
     7754     'dt-seasons':U,
     7755     loc-goods.gds-code,
     7756     parobj-type,
     7757     parobj-code,
     7758     output attrValue,
     7759     output attrType
     7760   ) no-error.
     7761   if attrValue <> "" then do:
     7762     find first b-code where
     7763                b-code.parent = "DTSeasons"
     7764            and b-code.code   = attrValue
     7765          no-lock no-error.
     7766     v-main-prt-b-code = integer(b-code.code).
     7767   end.
     7768   else release b-code.
     7769   assign
     7770   cash-gds.gds-code = loc-goods.gds-code
     7771   cash-gds.artic = loc-goods.artic
     7772   cash-gds.b-code = loc-bar-code.b-code
     7773   cash-gds.main-prt-b-code = v-main-prt-b-code
     7774   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7775   cash-gds.bc-on-type = loc-bc-on-type
     7776   cash-gds.bc-on = vBc-on
     7777   cash-gds.unit-cli = loc-bar-code.unit-cli
     7778   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7779   cash-gds.std-discnt-rule = std-discnt-rule_
     7780   cash-gds.gds-namelong = loc-goods.gds-name
     7781   cash-gds.gds-name = IF nam-2str
     7782                       then if available b-code then b-code.codename else loc-goods.gds-name
     7783                       else (
     7784                             IF nam-artc
     7785                             then loc-goods.artic
     7786                             else if available b-code
     7787                                  then b-code.codename
     7788                                  else (if loc-goods.chk-name <> ""
     7789                                        then loc-goods.chk-name
     7790                                        else loc-goods.gds-name)
     7791                            )
     7792   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7793   cash-gds.unit-base = loc-goods.unit-base
     7794   cash-gds.grp-code = for-grp-code
     7795   cash-gds.fp = for-fp
     7796   cash-gds.ingredient = loc-goods.struct
     7797   cash-gds.producer = for-producer
     7798   cash-gds.producer-int = for-producer-int
     7799   cash-gds.alpha1     = loc-goods.alpha1.
     7800     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7801                                            ,input 'office-type':U
     7802                                            ,output v-oss
     7803                                            ,output v-type) no-error.
     7804   cash-gds.office-type = v-oss.
     7805     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7806                                            ,input 'type-method-calc':U
     7807                                            ,output v-oss
     7808                                            ,output v-type) no-error.
     7809   if v-oss <> "" then
     7810     assign
     7811       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7812       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7813     .
     7814   else
     7815     assign
     7816       cash-gds.CalculationMethod = 0
     7817       cash-gds.CalculationMethodRestr = 0
     7818     .
     7819   assign
     7820   cash-gds.fact-qnty = for-fact-qnty
     7821   cash-gds.okei = loc-bc-units-okei
     7822   cash-gds.kat-discnt-method = kat-discnt-method_
     7823   cash-gds.temp-discnt-method = temp-discnt-method_
     7824   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7825                                then  kat-discnt-rule_pdf
     7826                                else  kat-discnt-rule_)
     7827   cash-gds.date-discnt-rule = date-discnt-rule_
     7828   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7829   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7830   cash-gds.wgd-rule = for-wgd
     7831   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7832                           then 1
     7833                           else 0)
     7834   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7835                        or for-petrol-purse
     7836                        then (cash-gds.gds-stat + 8)
     7837                        else cash-gds.gds-stat)
     7838   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7839                       then (cash-gds.gds-stat + 16)
     7840                       else cash-gds.gds-stat
     7841   cash-gds.gds-stat = if cash-gds.fp
     7842                       then (cash-gds.gds-stat + 2)
     7843                       else cash-gds.gds-stat
     7844   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7845                       then (cash-gds.gds-stat + 128)
     7846                       else cash-gds.gds-stat
     7847   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7848   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7849                                then temp-discnt-rule_pdf
     7850                                else temp-discnt-rule_)
     7851   cash-gds.wd-rule = for-wd
     7852   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7853   cash-gds.need-auth = (if need-auth then 1 else 0)
     7854   cash-gds.price-sale =  for-price
     7855   cash-gds.unit-type = loc-units.type
     7856   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7857   cash-gds.tax-string = tax-string
     7858   cash-gds.new-good = new-good
     7859   cash-gds.rc = recid(loc-goods)
     7860   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7861   cash-gds.vat-pc = (if avail tt-tax
     7862                      then tt-tax.rate-value
     7863                      else 0)
     7864   cash-gds.vat-code = (if avail tt-tax
     7865                        then tt-tax.rate-code
     7866                        else ?)
     7867   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7868   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7869   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7870   cash-gds.fbr-grp-code = v-fbr-grp-code
     7871   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7872   cash-gds.DepartID = v-fbr-obj-code
     7873   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7874   cash-gds.node-code = loc-bar-code.node-code
     7875   cash-gds.taracode = for-taracode
     7876   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7877                            and loc-bar-code.in-code = ""
     7878                            and loc-bar-code.part-code = ""
     7879                            and cash-gds.unit-base = cash-gds.unit-cli
     7880                            then yes
     7881                            else no)
     7882   cash-gds.obj-type = parobj-type
     7883   cash-gds.obj-code = parobj-code
     7884   .
     7885   assign
     7886   cash-gds.gds-name1 =   name-2cdf(
     7887                         input name-2cd
     7888                       , input yes
     7889                       , input cod-pcod
     7890                       , input cash-gds.b-code
     7891                       , input loc-goods.gds-code
     7892                       , input loc-goods.artic
     7893                       , input loc-goods.engl-name
     7894                       , input loc-bar-code.in-code
     7895                       , input loc-bar-code.part-code
     7896                       , input parobj-type
     7897                       , input parobj-code
     7898                       , input loc-goods.alpha1
     7899                       , output v-gtd
     7900                       )
     7901   cash-gds.gtd   = v-gtd
     7902   .
     7903   vKKT = 255.
     7904   find first b-code where
     7905              b-code.parent  = "okei-kkt"
     7906          and b-code.code    = string(cash-gds.okei)
     7907          and b-code.status_ = 0
     7908   no-lock no-error.
     7909   if avail b-code then
     7910      vKKT = integer(b-code.CodeName) no-error.
     7911   if error-status:error then vKKT = 255.
     7912   cash-gds.kkt = vKKT.
     7913   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7914      run gds-attr-value in this-procedure  (
     7915                                             input cash-gds.gds-code
     7916                                            ,input 'fuel-type':U
     7917                                            ,output v-is-gas
     7918                                            ,output v-type) no-error.
     7919      run gds-attr-value in this-procedure  (
     7920                                             input cash-gds.gds-code
     7921                                            ,input 'ptrl-as-good':U
     7922                                            ,output v-ptrl-as-good
     7923                                            ,output v-type) no-error.
     7924      assign
     7925      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7926      no-error .
     7927      assign
     7928      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7929      no-error .
     7930      if cash-gds.is-gas then do:
     7931        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7932      end.
     7933   end.
     7934      run gds-attr-value in this-procedure  (
     7935                                             input cash-gds.gds-code
     7936                                            ,input 'ban-bonus':U
     7937                                            ,output v-ban-bonus
     7938                                            ,output v-type) no-error.
     7939     assign
     7940      cash-gds.wd = int(logical(v-ban-bonus))
     7941      no-error .
     7942   if how-temp-disc = 'temp-disc':U then do:
     7943     case temp-discnt-method_:
     7944       when "" then do:
     7945       end.
     7946       when "bar-code.b-code" then do:
     7947         if loc-bar-code.in-code <> ''
     7948         or loc-bar-code.part-code <> ''
     7949         then do:
     7950           disc-b-code = cash-gds.main-prt-b-code.
     7951         end.
     7952         else do:
     7953           disc-b-code = cash-gds.b-code.
     7954         end.
     7955         find first buf_temp-dis-gds-rule where
     7956                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7957             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7958         if available buf_temp-dis-gds-rule then do:
     7959             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7960         end.
     7961       end.
     7962       otherwise do:
     7963         cash-gds.temp-discnt-rule = 0.
     7964       end.
     7965     end.
     7966   end.
     7967   assign
     7968   cash-gds.gds-name1 =   name-2cdf(
     7969                         input name-2cd
     7970                       , input yes
     7971                       , input cod-pcod
     7972                       , input cash-gds.b-code
     7973                       , input loc-goods.gds-code
     7974                       , input loc-goods.artic
     7975                       , input loc-goods.engl-name
     7976                       , input loc-bar-code.in-code
     7977                       , input loc-bar-code.part-code
     7978                       , input parobj-type
     7979                       , input parobj-code
     7980                       , input loc-goods.alpha1
     7981                       , output v-gtd
     7982                       )
     7983   cash-gds.gtd   = v-gtd
     7984   .
     7985   assign
     7986   cash-gds.ean-lz = ''
     7987   cash-gds.ean-rz = ''
     7988   cash-gds.code-short = ''
     7989   .
     7990   run ibm-gdsc in this-procedure (input no
     7991                                 , output cash-gds.ean-lz
     7992                                 , output cash-gds.ean-rz
     7993                                 , output cash-gds.code-short
     7994                                 ) no-error .
     7995   if new-good then new-good = not new-good.
     7996   if action = "U" then do:
     7997     if cash-gds.kat-discnt-rule <> 0
     7998     and how-pcnt-kat = 'pcnt-kat-pdf':U
     7999     then do:
     8000       for each cash-dis-rule no-lock where
     8001             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8002       :
     8003         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8004                                             ,input 'маг':U
     8005                                             ,input i-obj-code
     8006                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8007                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8008                                             ,input ?
     8009                                             ,output v-disc-price-sale
     8010                                             ,output v-pdf-id
     8011                                             ,output v-pdf-db-num ) no-error.
     8012         if error-status:error
     8013         or v-disc-price-sale = 0
     8014         or v-disc-price-sale = ?
     8015         then do:
     8016         end.
     8017         else do:
     8018           find first  cash-gds-discnt where
     8019                     cash-gds-discnt.b-code = cash-gds.b-code
     8020                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8021                   and cash-gds-discnt.obj-type = parobj-type
     8022                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8023           if not available cash-gds-discnt then do:
     8024             find first  cash-gds-discnt where
     8025                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8026             if not available cash-gds-discnt then do:
     8027               create cash-gds-discnt.
     8028               assign
     8029               cash-gds-discnt.crf = crgd + 1.
     8030             end.
     8031             crgd = crgd + 1.
     8032             assign
     8033             cash-gds-discnt.b-code = cash-gds.b-code
     8034             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8035             cash-gds-discnt.obj-type = parobj-type
     8036             cash-gds-discnt.obj-code = parobj-code
     8037             cash-gds-discnt.discnt-value = v-disc-price-sale
     8038             .
     8039             release cash-gds-discnt.
     8040           end.
     8041         end.
     8042       end.
     8043     end.
     8044     if cash-gds.temp-discnt-rule <> 0
     8045     and how-temp-disc = 'temp-disc-pdf':U
     8046     then do:
     8047       for each cash-dis-rule no-lock where
     8048             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8049         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8050         and cash-dis-rule.is-term = yes
     8051       :
     8052         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8053                                             ,input 'маг':U
     8054                                             ,input i-obj-code
     8055                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8056                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8057                                             ,input ?
     8058                                             ,output v-disc-price-sale
     8059                                             ,output v-pdf-id
     8060                                             ,output v-pdf-db-num ) no-error.
     8061         if error-status:error
     8062         or v-disc-price-sale = 0
     8063         or v-disc-price-sale = ?
     8064         then do:
     8065         end.
     8066         else do:
     8067           find first  cash-gds-discnt where
     8068                     cash-gds-discnt.b-code = cash-gds.b-code
     8069                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8070                   and cash-gds-discnt.obj-type = parobj-type
     8071                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8072           if not available cash-gds-discnt then do:
     8073             find first  cash-gds-discnt where
     8074                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8075             if not available cash-gds-discnt then do:
     8076               create cash-gds-discnt.
     8077               assign
     8078               cash-gds-discnt.crf = crgd + 1.
     8079             end.
     8080             crgd = crgd + 1.
     8081             assign
     8082             cash-gds-discnt.b-code = cash-gds.b-code
     8083             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8084             cash-gds-discnt.obj-type = parobj-type
     8085             cash-gds-discnt.obj-code = parobj-code
     8086             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8087             release cash-gds-discnt.
     8088           end.
     8089         end.
     8090       end.
     8091     end.
     8092   end.
     8093   END PROCEDURE.
