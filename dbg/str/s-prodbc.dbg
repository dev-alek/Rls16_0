    11285   define buffer buf_place for ub.place.
    11286   define buffer buf_pl-gds for ub.pl-gds.
    11287   FOR EACH for-cash-desk NO-LOCK WHERE
    11288           for-cash-desk.db-num = g#db-num AND
    11289           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    11290           for-cash-desk.obj-code = i-obj-code AND
    11291    for-cash-desk.cash-on  = yes
    11292       BREAK
    11293       BY for-cash-desk.db-num
    11294       BY for-cash-desk.obj-code
    11295       BY for-cash-desk.pos-type
    11296       BY for-cash-desk.cash-on
    11297       BY for-cash-desk.cash-num
    11298       :
    11299     if LOOKUP(ub.cash-desk.pos-type,
    11300               ('NCR-GM':U + chr(44) +
    11301                'IBM-XML':U + chr(44) +
    11302                'MAGIA-XML':U + chr(44) +
    11303                'NCR-AS@R':U  + chr(44) +
    11304                'Autotank':U
    11305                  )) > 0
    11306     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    11307     if LOOKUP(ub.cash-desk.pos-type,
    11308               'MARIA':U
    11309                  ) > 0 then do:
    11310       if for-cash-desk.autonomy = integer('2':U) then do:
    11311         assign
    11312         v-cd-list-update = for-cash-desk.addr-path
    11313         v-cd-list-delete = for-cash-desk.addr-path
    11314         .
    11315         NEXT.
    11316       end.
    11317       else do:
    11318         if v-cd-list-update = '':U then nExt.
    11319       end.
    11320     end.
