    12002     when 'NCR-AS@R':U
    12003     then do:
    12004   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12005   output stream IBMStream close.
    12006   define variable v-kat-file-number as integer no-undo .
    12007   if action = 'D':U then do:
    12008     do v-kat-file-number = 0 to 99:
    12009       if v-kat-file-number > 0
    12010       and v-kat-file-number < 10 then NEXt.
    12011       assign                                                                                 v-temp-kat-file = out + fname + '.' + string(v-kat-file-number)                     v-kat-file = (if v-kat-file-number  > 0                                                          then (entry(1, out2, chr(4))   + 'group_':U  + string(v-kat-file-number))                   else (entry(2, out2, chr(4))   + 's_plurbt':U ))                               + '.dat':u                                                                v-updated-subject-dis-kat = no.                                                        if ncr-save-param <> 'no' then do:                                                       v-kat-file-save = if ncr-save-param = 'NCR'                                                              then replace(v-kat-file, '.dat', '.sav')                                                else search((if v-kat-file-number  > 0                                                          then ('group_':U  + string(v-kat-file-number))                                      else 's_plurbt':U) + '.sav':U).                         end.
    12012       V-NEXT = NO.
    12013       if search(v-kat-file) = ? then do:
    12014         next .
    12015       end.
    12016       if ncr-save-param <> 'no':U then do:                                                     if search(v-kat-file-save) <> ? then do:                                               input stream bar from value(v-kat-file-save) convert source "ibm866" .                 repeat:                                                                                  import stream bar unformatted ss.                                                      find first cash-ncr-save-param where                                                            cash-ncr-save-param.dis-kat = v-kat-file-number                                 AND cash-ncr-save-param.cd-line = substring(ss, 1, 24) no-error.                  if not available cash-ncr-save-param then do:                                            create cash-ncr-save-param.                                                            assign                                                                                 cash-ncr-save-param.dis-kat = v-kat-file-number                                     cash-ncr-save-param.cd-line = substring(ss, 1, 24)                                     cash-ncr-save-param.cd-other = substring(ss, 25)                                       .                                                                                    end.                                                                                 end.                                                                                   input stream bar close .                                                               end.                                                                                   else do:                                                                               end.                                                                                 end.
    12017       input stream bar from value(v-kat-file) convert source "ibm866" .
    12018       output stream plucash to value(v-temp-kat-file) convert target "ibm866".
    12019       _rr:
    12020       repeat:
    12021         import stream bar unformatted ss.
    12022         if not ss begins fill(chr(32), 2 )
    12023         or can-find(first cash-ncr-save-param no-lock where
    12024                          cash-ncr-save-param.dis-kat = v-kat-file-number
    12025                      AND cash-ncr-save-param.cd-line = substring(ss, 1, 24))
    12026         then do:
    12027           put stream plucash unformatted
    12028           ss skip.
    12029           next _rr.
    12030         end.
    12031         find first buf_cash-ncr-dis-kat no-lock where
    12032                   buf_cash-ncr-dis-kat.dis-kat = - 1
    12033               AND buf_cash-ncr-dis-kat.cd-subject-code = substring(ss, 1, 16) no-error.
    12034         if not available buf_cash-ncr-dis-kat then do:
    12035           put stream plucash unformatted
    12036           ss skip.
    12037         end.
    12038         ELSE DO:
