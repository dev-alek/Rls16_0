     6314   define variable v-trn-pay-code  as integer   no-undo .
     6315   define variable v-cash-pay-curr as integer   no-undo .
     6316   define variable v-cash-pay-code as integer   no-undo .
     6317   do
     6318   on error undo, return error return-value
     6319   :
     6320   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6321   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6322   if p-fact-order = ? then do:
     6323     run fact-order-mpl (
     6324         input   today       ,
     6325         input   p-obj-type  ,
     6326         input   p-obj-code  ,
     6327         output  p-fact-order ).
     6328   end.
     6329   if p-vid-pay <> "" then do:
     6330      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6331      if available buf_pay-type
     6332         then v-trn-pay-code = buf_pay-type.obj-code.
     6333         else v-trn-pay-code =  0.
     6334   end.
     6335   else v-trn-pay-code = 0 .
     6336   if p-cash-pay-type <> "" then do:
     6337      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6338      if available buf_pay-type
     6339         then
     6340           assign
     6341             v-cash-pay-curr = buf_cash-pay.curr-code
     6342             v-cash-pay-code = buf_cash-pay.cdpay-code
     6343           .
     6344         else
     6345           assign
     6346             v-cash-pay-curr = 0
     6347             v-cash-pay-code = 0
     6348             .
     6349   end.
     6350   else
     6351     assign
     6352       v-cash-pay-curr = 0
     6353       v-cash-pay-code = 0
     6354       .
     6355   for each tt_price-all  : delete tt_price-all . end.
     6356   assign
     6357     p-plt-id             = ?
     6358     p-plt-db-num         = ?
     6359     p-pdf-id             = ?
     6360     p-pdf-db-num         = ?
     6361     p-sale-price-base    = ?
     6362     p-sale-price-rubl    = ?
     6363     v-cli-oborot         = 0
     6364   .
     6365   find first buf_global-state no-lock no-error .
     6366   if not available buf_global-state then do:
     6367      message
     6368        "Не заданы параметры ценообразования!"
     6369        view-as alert-box error
     6370      .
     6371      return error return-value .
     6372   end.
     6373   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6375     (input  p-obj-type
     6376     ,input  p-obj-code
     6377     ,output to-day
     6378     )  .
     6379   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6381     (input  p-obj-type
     6382     ,input  p-obj-code
     6383     ,output v-host-code
     6384     )  .
     6385   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6387     (input  v-host-code
     6388     ,input  to-day
     6389     ,output v-base-rate0
     6390     ,output v-base-scale0
     6391     )  .
     6392     v-cli-oborot-ALL  = 0 .
     6393     for each buf_turnover-buyer-main no-lock  where
     6394              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6395              buf_turnover-buyer-main.cli-code = p-cli-code
     6396              :
     6397              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6398     end.
     6399   for each buf_price-all no-lock where
     6400            buf_price-all.obj-type = p-obj-type and
     6401            buf_price-all.obj-code = p-obj-code and
     6402            buf_price-all.gds-code = buf_goods.gds-code and
     6403            buf_price-all.status_  = 'акт':U  and
     6404          ( p-only-b-code = false   or
     6405          ( buf_price-all.b-code = p-main-b-code or
     6406            buf_price-all.b-code = p-b-code))    and
     6407           ( p-only-b-code = true  or
     6408             buf_price-all.b-code = p-b-code)
     6409             and
     6410             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6411           ( buf_price-all.fact-order-sys-to = ? or
     6412             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6413           :
     6414            v-interv   = "" .
     6415            v-grp-name = "" .
     6416            v-pay-name = "" .
     6417            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6418            if buf_price-all.bgr-id > 0 then do:
     6419               find first buf_buyer-group no-lock where
     6420                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6421                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6422               if available buf_buyer-group then do:
     6423                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6424                  find first buf_buyer-in-buyer-group no-lock where
     6425                             buf_buyer-in-buyer-group.stts         = 0 and
     6426                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6427                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6428                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6429                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6430                             no-error .
     6431                             if not available buf_buyer-in-buyer-group then do:
     6432                                v-grp-name = "".
     6433                                next.
     6434                             end.
     6435                             v-grp-name = buf_buyer-group.name .
     6436                  end.
     6437               end.
     6438               else do:
     6439                    v-grp-name = "".
     6440                    next.
     6441               end.
     6442            end.
     6443            if buf_price-all.tog-id > 0 then do:
     6444               find first buf_turnover-group no-lock where
     6445                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6446                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6447               if available buf_turnover-group then do:
     6448                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6449                     v-cli-oborot = v-cli-oborot-all  .
     6450                     find first buf1_tnv-in-turnover-group no-lock where
     6451                                buf1_tnv-in-turnover-group.stts       =  0     and
     6452                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6453                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6454                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6455                     find first buf2_tnv-in-turnover-group no-lock where
     6456                                buf2_tnv-in-turnover-group.stts       =  0     and
     6457                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6458                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6459                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6460                     if not (available buf1_tnv-in-turnover-group and
     6461                             available buf2_tnv-in-turnover-group ) then do:
     6462                             v-grp-name = "".
     6463                             next .
     6464                     end.
     6465                     v-grp-name = buf_turnover-group.name.
     6466                  end.
     6467               end.
     6468               else do:
     6469                    v-grp-name = "".
     6470                    next.
     6471               end.
     6472            end.
     6473            if buf_price-all.plt-fix-cource-crc-base = true then
     6474               assign
     6475                 v-base-rate  = buf_price-all.pdf-base-rate
     6476                 v-base-scale = buf_price-all.pdf-base-scale
     6477               .
     6478               else
     6479               assign
     6480                 v-base-rate  = v-base-rate0
     6481                 v-base-scale = v-base-scale0
     6482               .
     6483            if buf_price-all.plt-fix-cource-crc-doc = true then
     6484               assign
     6485                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6486                 v-exch-scale = buf_price-all.pdf-exch-scale
     6487               .
     6488               else do:
     6489   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6490   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6491     (input  buf_price-all.curr-code
     6492     ,input  to-day
     6493     ,output v-exch-rate0
     6494     ,output v-exch-scale0
     6495     ,output v-curr-abbr
     6496     )  .
     6497               assign
     6498                 v-exch-rate  = v-exch-rate0
     6499                 v-exch-scale = v-exch-scale0
     6500                 .
     6501              end.
     6502              v-date-1 = date ( "" )  .
     6503              if buf_price-all.fact-order-sys-from > 0 then do:
     6504                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6505                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6506                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6507              end.
     6508              v-date-2 =  date ( "" )  .
     6509              if buf_price-all.fact-order-sys-to > 0 then do:
     6510                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6511                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6512                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6513              end.
     6514              if buf_price-all.qnty-from <> ? then do :
     6515                 if not (
     6516                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6517                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6518                 ) then do:
     6519                        v-interv = "".
     6520                        next.
     6521                 end.
     6522                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6523              end.
     6524              if buf_price-all.sum-from <> ? then do :
     6525                 if not (
     6526                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6527                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6528                 ) then do:
     6529                    v-interv = "".
     6530                    next.
     6531                 end.
     6532                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6533              end.
     6534              if buf_price-all.turnover-from <> ? then do :
     6535                 if not (
     6536                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6537                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6538                 ) then do:
     6539                    v-interv = "".
     6540                    next.
     6541                 end.
     6542                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6543              end.
     6544              if buf_price-all.use-pay-type = 1 then do :
     6545                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6546                    v-pay-name = "" .
     6547                    next.
     6548                  end.
     6549                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6550              end.
     6551              if buf_price-all.use-cash-pay = 1 then do :
     6552                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6553                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6554                   v-pay-name = "" .
     6555                   next.
     6556                 end.
     6557                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6558              end.
     6559             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6560             create tt_price-all .
     6561             buffer-copy buf_price-all to tt_price-all
     6562             assign
     6563               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6564               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6565               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6566               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6567               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6568               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6569               tt_price-all.price-sale     = buf_price-all.price-sale
     6570               tt_price-all.road-tax       = buf_price-all.road-tax
     6571               tt_price-all.excise         = buf_price-all.excise
     6572               tt_price-all.pdf-exch-rate   = v-exch-rate
     6573               tt_price-all.pdf-exch-scale  = v-exch-scale
     6574               tt_price-all.pdf-base-rate   = v-base-rate
     6575               tt_price-all.pdf-base-scale  = v-base-scale
     6576               tt_price-all.grp-name        = v-grp-name
     6577               tt_price-all.date-1          = v-date-1
     6578               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6579               tt_price-all.time-1          = buf_price-all.start-sys-time
     6580               tt_price-all.date-2          = v-date-2
     6581               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6582               tt_price-all.time-2          = buf_price-all.end-sys-time
     6583               tt_price-all.interv-name     = v-interv
     6584               tt_price-all.pay-name        = v-pay-name
     6585               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6586             .
     6587   end.
     6588   define variable vt-plt-id as integer   no-undo .
     6589   define variable vt-plt-db as integer   no-undo .
     6590   define variable vt-pdf-id as integer   no-undo .
     6591   define variable vt-pdf-db as integer   no-undo .
     6592   define buffer neos_price-all for tt_price-all  .
     6593   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6594       if available tt_price-all then do:
     6595        assign
     6596          vt-plt-id = tt_price-all.plt-id
     6597          vt-plt-db = tt_price-all.plt-db-num
     6598          vt-pdf-id = tt_price-all.pdf-id
     6599          vt-pdf-db = tt_price-all.pdf-db
     6600        .
     6601        if tt_price-all.b-code = p-b-code then do:
     6602             assign
     6603               p-plt-id           = tt_price-all.plt-id
     6604               p-plt-db-num       = tt_price-all.plt-db-num
     6605               p-pdf-id           = tt_price-all.pdf-id
     6606               p-pdf-db-num       = tt_price-all.pdf-db
     6607               p-sale-price-base  = tt_price-all.price-sale-base
     6608               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6609               p-road-tax-base    = tt_price-all.road-tax-base
     6610               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6611               p-excise-base      = tt_price-all.excise-base
     6612               p-excise-rubl      = tt_price-all.excise-rubl
     6613               .
     6614        end.
     6615        else do:
     6616          find first neos_price-all where
     6617                     neos_price-all.b-code     = p-b-code  and
     6618                     neos_price-all.plt-id     = vt-plt-id and
     6619                     neos_price-all.plt-db-num = vt-plt-db and
     6620                     neos_price-all.pdf-id     = vt-pdf-id and
     6621                     neos_price-all.pdf-db     = vt-pdf-db
     6622                     use-index pi no-error .
     6623            if available neos_price-all then do:
     6624             assign
     6625               p-plt-id           = tt_price-all.plt-id
     6626               p-plt-db-num       = tt_price-all.plt-db-num
     6627               p-pdf-id           = tt_price-all.pdf-id
     6628               p-pdf-db-num       = tt_price-all.pdf-db
     6629               p-sale-price-base  = neos_price-all.price-sale-base
     6630               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6631               p-road-tax-base    = neos_price-all.road-tax-base
     6632               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6633               p-excise-base      = neos_price-all.excise-base
     6634               p-excise-rubl      = neos_price-all.excise-rubl
     6635               .
     6636            end.
     6637            else do:
     6638                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6639                 if error-status :error    then do:
     6640                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6641                   return error return-value .
     6642                 end.
     6643             assign
     6644               p-plt-id           = tt_price-all.plt-id
     6645               p-plt-db-num       = tt_price-all.plt-db-num
     6646               p-pdf-id           = tt_price-all.pdf-id
     6647               p-pdf-db-num       = tt_price-all.pdf-db
     6648               p-sale-price-base  = tt_price-all.price-sale-base
     6649               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6650               p-road-tax-base    = tt_price-all.road-tax-base
     6651               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6652               p-excise-base      = tt_price-all.excise-base
     6653               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6654               .
     6655            end.
     6656        end.
     6657     end.
     6658   end.
     6659   end procedure.
     6660   procedure mpl-tpl-auto :
     6661   define input  parameter p-b-code     as integer   no-undo .
     6662   define input  parameter p-obj-type   as character no-undo .
     6663   define input  parameter p-obj-code   as integer   no-undo .
     6664   define input  parameter p-plt-id     as integer   no-undo .
     6665   define input  parameter p-plt-db-num as integer   no-undo .
     6666   define input  parameter p-fact-order as decimal   no-undo .
     6667   define output parameter p-sale-price as decimal   no-undo .
     6668   define output parameter p-pdf-id     as integer   no-undo .
     6669   define output parameter p-pdf-db-num as integer   no-undo .
     6670     do
     6671     on error undo, return error return-value
     6672     :
     6673   if p-fact-order = ? then do:
     6674     run fact-order-mpl (
     6675         input   today       ,
     6676         input   p-obj-type  ,
     6677         input   p-obj-code  ,
     6678         output  p-fact-order ) .
     6679   end.
     6680   assign
     6681     p-pdf-id      = ?
     6682     p-pdf-db-num  = ?
     6683     p-sale-price  = ?
     6684   .
     6685   define buffer buf_bar-code for ub.bar-code  .
     6686   define buffer buf_goods for ub.goods  .
     6687   find first buf_bar-code no-lock where
     6688              buf_bar-code.b-code = p-b-code
     6689              no-error .
     6690   if error-status :error then return error return-value .
     6691   find first buf_goods no-lock where
     6692              buf_goods.gds-code = buf_bar-code.gds-code
     6693              no-error .
     6694   if error-status :error then return error return-value .
     6695   define variable v-main-b-code as integer   no-undo .
     6696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6697     (input  buf_goods.gds-code
     6698     ,input  ?
     6699     ,output v-main-b-code
     6700     )  .
     6701   define buffer buf_price-all for ub.price-all  .
     6702   for each tt_price-all : delete tt_price-all. end.
     6703       for each buf_price-all no-lock where
     6704               buf_price-all.plt-id     = p-plt-id                 and
     6705               buf_price-all.plt-db-num = p-plt-db-num             and
     6706               buf_price-all.obj-type   = p-obj-type               and
     6707               buf_price-all.obj-code   = p-obj-code               and
     6708               buf_price-all.gds-code   = buf_goods.gds-code       and
     6709             ( buf_price-all.b-code = v-main-b-code or
     6710               buf_price-all.b-code = p-b-code)    and
     6711               buf_price-all.status_    = 'акт':U         and
     6712               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6713             ( buf_price-all.fact-order-sys-to = ? or
     6714               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6715               :
     6716                 create tt_price-all .
     6717                 buffer-copy buf_price-all to tt_price-all
     6718                 assign
     6719                   tt_price-all.price-sale  = buf_price-all.price-sale
     6720                 .
     6721       end.
     6722   define variable vt-plt-id as integer   no-undo .
     6723   define variable vt-plt-db as integer   no-undo .
     6724   define variable vt-pdf-id as integer   no-undo .
     6725   define variable vt-pdf-db as integer   no-undo .
     6726   define buffer neos_price-all for tt_price-all  .
     6727   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6728       if available tt_price-all then do:
     6729        assign
     6730          vt-plt-id = tt_price-all.plt-id
     6731          vt-plt-db = tt_price-all.plt-db-num
     6732          vt-pdf-id = tt_price-all.pdf-id
     6733          vt-pdf-db = tt_price-all.pdf-db
     6734        .
     6735        if tt_price-all.b-code = p-b-code then do:
     6736             assign
     6737               p-plt-id           = tt_price-all.plt-id
     6738               p-plt-db-num       = tt_price-all.plt-db-num
     6739               p-pdf-id           = tt_price-all.pdf-id
     6740               p-pdf-db-num       = tt_price-all.pdf-db
     6741               p-sale-price       = tt_price-all.price-sale
     6742               .
     6743        end.
     6744        else do:
     6745          find first neos_price-all where
     6746                     neos_price-all.b-code     = p-b-code  and
     6747                     neos_price-all.plt-id     = vt-plt-id and
     6748                     neos_price-all.plt-db-num = vt-plt-db and
     6749                     neos_price-all.pdf-id     = vt-pdf-id and
     6750                     neos_price-all.pdf-db     = vt-pdf-db
     6751                     use-index pi no-error .
     6752            if available neos_price-all then do:
     6753             assign
     6754               p-plt-id           = tt_price-all.plt-id
     6755               p-plt-db-num       = tt_price-all.plt-db-num
     6756               p-pdf-id           = tt_price-all.pdf-id
     6757               p-pdf-db-num       = tt_price-all.pdf-db
     6758               p-sale-price       = neos_price-all.price-sale
     6759               .
     6760            end.
     6761            else do:
     6762           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6763           if error-status :error    then do:
     6764              message "Не найден бар-код" p-b-code view-as alert-box error .
     6765              return error return-value .
     6766           end.
     6767             assign
     6768               p-plt-id           = tt_price-all.plt-id
     6769               p-plt-db-num       = tt_price-all.plt-db-num
     6770               p-pdf-id           = tt_price-all.pdf-id
     6771               p-pdf-db-num       = tt_price-all.pdf-db
     6772               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6773               .
     6774            end.
     6775        end.
     6776     end.
     6777     end.
     6778   end procedure.
