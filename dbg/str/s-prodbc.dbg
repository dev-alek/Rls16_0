    14803   .
    14804   define variable vss-include-info123 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    14806     (input  'маг':U
    14807     ,input  i-obj-code
    14808     ,output v-today
    14809     )  .
    14810    output stream IBMStream to value(out + fname + ".dat") convert target "utf-8"  .
    14811    _buf_dis-gds-rule:
    14812    for each buf_dis-gds-rule no-lock
    14813    where buf_dis-gds-rule.templ-rl-root = 91
    14814      and buf_dis-gds-rule.pos-type = 'NCR-AS@R':U
    14815      ,
    14816      first buf_dis-rule no-lock
    14817      where buf_dis-rule.rule-num = buf_dis-gds-rule.rule-num
    14818        and buf_dis-rule.sts = integer('0':U),
    14819       first buf_dis-time-rule no-lock
    14820         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    14821       and buf_dis-time-rule.date-to >= v-today
    14822         :
    14823          if buf_dis-gds-rule.obj-type = "" and buf_dis-gds-rule.obj-code = 0 then do:
    14824              find first chk_dis-gds-rule no-lock
    14825              where chk_dis-gds-rule.gds-code = buf_dis-gds-rule.gds-code and
    14826                    chk_dis-gds-rule.templ-rl-root = buf_dis-gds-rule.templ-rl-root and
    14827                    chk_dis-gds-rule.pos-type = buf_dis-gds-rule.pos-type and
    14828                 (( chk_dis-gds-rule.obj-type = 'орг':U  and chk_dis-gds-rule.obj-code = i-host-code ) or
    14829                  ( chk_dis-gds-rule.obj-type = 'маг':U and chk_dis-gds-rule.obj-code = i-obj-code  )) no-error .
    14830              if avail chk_dis-gds-rule then next _buf_dis-gds-rule .
    14831          end.
    14832          if buf_dis-gds-rule.obj-type = 'орг':U and buf_dis-gds-rule.obj-code = i-host-code then do:
    14833              find first chk_dis-gds-rule no-lock
    14834              where chk_dis-gds-rule.gds-code = buf_dis-gds-rule.gds-code and
    14835                    chk_dis-gds-rule.templ-rl-root = buf_dis-gds-rule.templ-rl-root and
    14836                    chk_dis-gds-rule.pos-type = buf_dis-gds-rule.pos-type and
    14837                    chk_dis-gds-rule.obj-type = 'маг':U and
    14838                    chk_dis-gds-rule.obj-code = i-obj-code no-error .
    14839              if avail chk_dis-gds-rule then next _buf_dis-gds-rule .
    14840          end.
    14841          find first buf_gds-obj no-lock
    14842          where buf_gds-obj.gds-code = buf_dis-gds-rule.gds-code
    14843            and buf_gds-obj.obj-type = 'маг':U
    14844            and buf_gds-obj.obj-code = i-obj-code
    14845          no-error.
    14846          if avail buf_gds-obj and
    14847            (( buf_dis-gds-rule.obj-type = ""      and buf_dis-gds-rule.obj-code = 0) or
    14848             ( buf_dis-gds-rule.obj-type = 'орг':U  and buf_dis-gds-rule.obj-code = i-host-code) or
    14849             ( buf_dis-gds-rule.obj-type = 'маг':U and buf_dis-gds-rule.obj-code = i-obj-code))
    14850          then do:
    14851             assign
    14852               v-char-2 = "0,0,0,0,0,0,"
    14853               v-is-weight = false
    14854             .
    14855             find buf_goods where buf_goods.gds-code = buf_dis-gds-rule.gds-code no-lock no-error.
    14856             if avail buf_goods then do:
    14857                 find buf_units where buf_units.unit-name = buf_goods.unit-base no-lock no-error.
    14858                 if avail buf_units then do:
    14859                     if lookup ('вес':U, buf_units.type) > 0 then do:
    14860                         assign
    14861                           v-char-2    = "0,0,0,2,0,0,"
    14862                           v-is-weight = true
    14863                         .
    14864                     end.
    14865                 end.
    14866             end.
    14867             _bdr-attr:
    14868       for each  buf_dis-gds-rule-attr WHERE
    14869                buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
    14870            AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
    14871            AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
    14872            AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
    14873            AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
    14874            and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
    14875                     :
    14876              assign
    14877        v-upd = entry(2,buf_dis-gds-rule-attr.attr-value,",")
    14878                v-ean13 = entry(1,buf_dis-gds-rule-attr.attr-value,",")
    14879        .
    14880              if v-is-weight and length(v-ean13) = 5 then do:
    14881                  def var ncrsc-pfx as char no-undo init "23":U .
    14882                  def var ncrsc-frmt as char no-undo init "EAN13" .
    14883                  assign v-tmpchar = "" .
    14884   define variable vss-include-info124 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14885     define variable tmp-str124  as character no-undo.
    14886     define variable tmp-num124  as character no-undo.
    14887     define variable i124        as integer   no-undo.
    14888     define variable sum124      as integer   no-undo.
    14889     define variable len-code124 as integer   no-undo.
    14890     define variable varcont124  as logical   initial yes no-undo.
    14891     CASE ncrsc-frmt :
    14892       WHEN "EAN13" THEN do:
    14893         assign
    14894           tmp-str124 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "999999999999" )
    14895         .
    14896       end.
    14897       WHEN "EAN8" THEN do:
    14898         assign
    14899           tmp-str124 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "9999999" )
    14900         .
    14901       end.
    14902       OTHERWISE DO:
    14903           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    14904           view-as alert-box error.
    14905           return error.
    14906       END.
    14907     END CASE.
    14908     if varcont124 = yes then do:
    14909       if integer( substring( tmp-str124, 1, length( ncrsc-pfx ) ) ) <> 0
    14910       then do:
    14911         message
    14912           "Невозможно сформировать бар-код" SKIP
    14913           "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U)
    14914           view-as alert-box error title "подрезание кода".
    14915         return error.
    14916       end.
    14917       else do:
    14918         assign
    14919           v-tmpchar = ncrsc-pfx + substring( tmp-str124, length( ncrsc-pfx ) + 1, length( tmp-str124 ) - length( ncrsc-pfx ) )
    14920           len-code124    = length( v-tmpchar )
    14921         .
    14922         define variable v-sum-char124 as character no-undo .
    14923         assign
    14924           sum124 = 0
    14925         .
    14926         do i124 = 1 to len-code124 by 2
    14927         :
    14928           assign
    14929             v-sum-char124 = substr(v-tmpchar, len-code124 - i124 + 1, 1)
    14930           .
    14931           if v-sum-char124 < "0"
    14932           or v-sum-char124 > "9"
    14933           then do:
    14934             message
    14935               "Невозможно сформировать бар-код" skip
    14936               "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    14937               view-as alert-box error title "подсчет контрольной суммы".
    14938             return error.
    14939           end.
    14940           assign
    14941             sum124 = sum124 + integer(v-sum-char124)
    14942           .
    14943         end.
    14944         if varcont124 = yes then do:
    14945           assign
    14946             sum124 = sum124 * 3
    14947           .
    14948           do i124 = 2 to len-code124 by 2
    14949           :
    14950             assign
    14951               v-sum-char124 = substr(v-tmpchar, len-code124 - i124 + 1, 1)
    14952             .
    14953             if v-sum-char124 < "0"
    14954             or v-sum-char124 > "9"
    14955             then do:
    14956               message
    14957                 "Невозможно сформировать бар-код" skip
    14958                 "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    14959                 view-as alert-box error title "подсчет контрольной суммы".
    14960               return error.
    14961             end.
    14962             assign
    14963               sum124 = sum124 + integer(v-sum-char124)
    14964             .
    14965           end.
    14966           if varcont124 = yes then do:
    14967              if sum124 mod 10 = 0 then do:
    14968                assign
    14969                  v-tmpchar = v-tmpchar + '0'
    14970                .
    14971              end.
    14972              else do:
    14973                assign
    14974                  v-tmpchar = v-tmpchar + string(10 - sum124 mod 10)
    14975                .
    14976              end.
    14977           end.
    14978         end.
    14979       end.
    14980     end.
    14981                  if not v-tmpchar = "":U then assign v-ean13 = v-tmpchar .
    14982              end.
    14983              if v-ean13 begins "20" and length(v-ean13) = 13 then next _bdr-attr .
    14984        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    14985         buf_dis-gds-rule-attr.attr-code v-char-delim-1
    14986         "3,MAPKA,"
    14987         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    14988         "0" v-char-delim-1
    14989         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    14990         "0" v-char-delim-1
    14991         v-char-1
    14992         v-char-2
    14993         trim(string(buf_dis-rule.doc-qnty,'>>>>9')) v-char-delim-1
    14994         v-char-3
    14995               v-ean13 v-char-delim-2
    14996         v-char-4
    14997         trim(string(buf_dis-rule.discnt-value,">>>9")) v-char-delim-1
    14998         v-char-5
    14999               v-ean13 v-char-delim-2
    15000         v-char-6 v-char-7 skip.
    15001       end.
    15002      end.
    15003    end.
    15004    for each buf_dis-thbj-rule no-lock where buf_dis-thbj-rule.templ-rl-root = 90
    15005                      and buf_dis-thbj-rule.pos-type = 'NCR-AS@R':U,
    15006       first buf_dis-rule no-lock where
    15007           buf_dis-rule.rule-num = buf_dis-thbj-rule.rule-num
    15008       and buf_dis-rule.sts = integer('0':U),
    15009       first buf_dis-time-rule no-lock
    15010         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    15011           and buf_dis-time-rule.date-to >= v-today
    15012         :
    15013      if (buf_dis-thbj-rule.obj-type = "" and
    15014          buf_dis-thbj-rule.obj-code = 0) or
    15015         (buf_dis-thbj-rule.obj-type = 'орг':U and
    15016          buf_dis-thbj-rule.obj-code = i-host-code) or
    15017         (buf_dis-thbj-rule.obj-type = 'маг':U and
    15018          buf_dis-thbj-rule.obj-code = i-obj-code)
    15019      then
    15020      do:
    15021        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    15022         buf_dis-rule.key#_one v-char-delim-1
    15023         "3,MAPKA,"
    15024         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    15025         "0" v-char-delim-1
    15026         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    15027         "0" v-char-delim-1
    15028         v-char-1
    15029         v-char-21
    15030         "9,0,0,"
    15031         trim(string(buf_dis-rule.tot-sum * 100,">>>>>>>>>9")) v-char-delim-1
    15032         v-char-3
    15033         v-char-41
    15034         trim(string(buf_dis-rule.discnt-value,">>>9")) v-char-delim-1
    15035         v-char-5
    15036          v-char-delim-2
    15037         v-char-61 v-char-71 skip.
    15038      end.
    15039    end.
    15040    for each buf_dis-thbj-rule no-lock where buf_dis-thbj-rule.templ-rl-root = 92
    15041                      and buf_dis-thbj-rule.pos-type = 'NCR-AS@R':U,
    15042       first buf_dis-rule no-lock where
    15043           buf_dis-rule.rule-num = buf_dis-thbj-rule.rule-num
    15044       and buf_dis-rule.sts = integer('0':U),
    15045       first buf_dis-time-rule no-lock
    15046         where buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num
    15047           and buf_dis-time-rule.date-to >= v-today
    15048         :
    15049      if (buf_dis-thbj-rule.obj-type = "" and
    15050          buf_dis-thbj-rule.obj-code = 0) or
    15051         (buf_dis-thbj-rule.obj-type = 'орг':U and
    15052          buf_dis-thbj-rule.obj-code = i-host-code) or
    15053         (buf_dis-thbj-rule.obj-type = 'маг':U and
    15054          buf_dis-thbj-rule.obj-code = i-obj-code)
    15055      then
    15056      do:
    15057        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    15058         buf_dis-rule.key#_one v-char-delim-1
    15059         "4,MAPKA,"
    15060         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    15061         "0" v-char-delim-1
    15062         entry(1,iso-date(buf_dis-time-rule.date-to),"-") + entry(2,iso-date(buf_dis-time-rule.date-to),"-") + entry(3,iso-date(buf_dis-time-rule.date-to),"-") v-char-delim-1
    15063         "0" v-char-delim-1
    15064         v-char-1
    15065         v-char-21
    15066         "4,1,0,"
    15067         "1" v-char-delim-1
    15068         v-char-3
    15069         v-char-42
    15070         "0" v-char-delim-1
    15071         v-char-5
    15072          v-char-delim-2
    15073         v-char-62 v-char-72 v-char-8 v-char-9 skip.
    15074      end.
    15075    end.
    15076    output stream IBMStream close .
    15077   end procedure .
    15078   procedure get-thbj-rule :
    15079   define input  parameter p-obj-type as character no-undo .
    15080   define input  parameter p-obj-code as integer no-undo .
    15081   define input  parameter p-host-code as integer no-undo .
    15082   define input  parameter p-discnt-role as character no-undo .
    15083   define input  parameter p-pos-type as character   no-undo .
    15084   define input  parameter p-reg-list as character no-undo .
    15085   define parameter buffer  buf_dis-thbj-rule for ub.dis-thbj-rule.
    15086   define variable v-region-type as character no-undo .
    15087   define variable v-region-code as integer   no-undo .
    15088   define variable v-region-host as integer   no-undo .
    15089   define variable v-region-ii as integer   no-undo .
    15090   _v-region-ii:
    15091   do v-region-ii = 1 to 3:
    15092     if lookup(string(v-region-ii), p-reg-list) = 0 then next _v-region-ii.
    15093     case v-region-ii:
    15094       when 1 then do:
    15095         assign
    15096         v-region-type = p-obj-type
    15097         v-region-code = p-obj-code
    15098         v-region-host = p-host-code
    15099         .
    15100       end.
    15101       when 2 then do:
    15102         assign
    15103         v-region-type = ''
    15104         v-region-code = 0
    15105         v-region-host = p-host-code
    15106         .
    15107       end.
    15108       when 3 then do:
    15109         assign
    15110         v-region-type = ''
    15111         v-region-code = 0
    15112         v-region-host = 0
    15113         .
    15114       end.
    15115     end case.
    15116     find first buf_dis-thbj-rule no-lock where
    15117               buf_dis-thbj-rule.obj-type = v-region-type
    15118           and buf_dis-thbj-rule.obj-code = v-region-code
    15119           and buf_dis-thbj-rule.host-code = v-region-host
    15120           and buf_dis-thbj-rule.discnt-role = p-discnt-role
    15121           and buf_dis-thbj-rule.pos-type = p-pos-type no-error.
    15122     if available buf_dis-thbj-rule then do:
    15123       find first buf_dis-rule no-lock where
    15124                 buf_Dis-rule.rule-num = buf_dis-thbj-rule.templ-rl-root no-error.
    15125       if available buf_dis-rule then do:
    15126         run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num
    15127                                               , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    15128       end.
    15129       leave _v-region-ii.
    15130     end.
    15131   end.
    15132   END PROCEDURE.
