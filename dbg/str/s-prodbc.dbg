    13297   _do26:
    13298   do vdr-26 = 1 to 3:
    13299     CASE vdr-26:
    13300       when 1 then do:
    13301         assign
    13302         vc-obj-code = ub.shop.obj-code
    13303         vc-obj-type = 'маг':U
    13304         vc-host-code = ub.shop.host-code
    13305         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    13306         .
    13307       end.
    13308       when 2 then do:
    13309         assign
    13310         vc-obj-code = 0
    13311         vc-obj-type = '':U
