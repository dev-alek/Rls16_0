     6970   procedure grp-obj-notcorr-value :
     6971   do
     6972   on error undo, return error
     6973   :
     6974   define input parameter p-node-code             as integer      no-undo.
     6975   define input parameter p-obj-type              as character    no-undo.
     6976   define input parameter p-obj-code              as integer      no-undo.
     6977   define output parameter p-notcorr              as character    no-undo init ?.
     6978   define output parameter p-range-notcorr     as integer      no-undo.
     6979   define output parameter p-exists-notcorr    as logical      no-undo.
     6980   define variable v-host-code as integer      no-undo.
     6981   DEFINE VARIABLE v-found as logical no-undo .
     6982   DEFINE VARIABLE v-exists as logical no-undo .
     6983   DEFINE VARIABLE v-range as integer no-undo .
     6984   DEFINE VARIABLE jj as integer no-undo .
     6985   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     6986   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     6987   define buffer buf_gds-grp for ub.gds-grp.
     6988   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     6989   find first buf_gds-grp no-lock where
     6990              buf_gds-grp.node-code = p-node-code no-error .
     6991   if not avail buf_gds-grp and p-node-code <> 0 then do:
     6992     message
     6993       vss-workfile vss-revision vss-description
     6994       skip "Не удалось найти группу товаров с кодом" p-node-code
     6995       view-as alert-box error .
     6996     undo, return error .
     6997   end.
     6998   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6999   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7000     (input  p-obj-type
     7001     ,input  p-obj-code
     7002     ,output v-host-code
     7003     ) no-error .
     7004   if error-status :error
     7005   then do:
     7006       message
     7007         vss-workfile vss-revision vss-description
     7008         skip "Не удалось найти фирму объекта"
     7009         skip p-obj-type p-obj-code
     7010         skip return-value
     7011         skip trim(error-status :get-message(1))
     7012       view-as alert-box error.
     7013       undo, return error .
     7014   end.
     7015   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7016   do while v-found = no and jj < 2:
     7017     if v-range <> 3 then do:
     7018       find first buf_gds-grp-obj no-lock
     7019           where buf_gds-grp-obj.node-code = p-node-code
     7020             and buf_gds-grp-obj.host-code = v-host-code
     7021             and buf_gds-grp-obj.obj-type  = p-obj-type
     7022             and buf_gds-grp-obj.obj-code  = p-obj-code
     7023       no-error .
     7024     end.
     7025     if v-range = 3 or not available buf_gds-grp-obj
     7026     then do:
     7027        if v-range <> 2 then do:
     7028           find first buf_gds-grp-obj no-lock
     7029               where buf_gds-grp-obj.node-code = p-node-code
     7030                 and buf_gds-grp-obj.host-code = v-host-code
     7031                 and buf_gds-grp-obj.obj-type  = ""
     7032                 and buf_gds-grp-obj.obj-code  = 0
     7033           no-error .
     7034         end.
     7035         if v-range = 2 or not available buf_gds-grp-obj
     7036         then do:
     7037             if v-range <> 1 then do:
     7038               find first buf_gds-grp-obj no-lock
     7039                   where buf_gds-grp-obj.node-code = p-node-code
     7040                   and buf_gds-grp-obj.host-code = 0
     7041                   and buf_gds-grp-obj.obj-type  = ""
     7042                   and buf_gds-grp-obj.obj-code  = 0
     7043               no-error .
     7044             end.
     7045             if v-range = 1 or not available buf_gds-grp-obj
     7046             then do:
     7047                 assign
     7048                     v-exists = no
     7049                 .
     7050             end.
     7051             else do:
     7052                 assign
     7053                     v-exists = yes
     7054                     v-range = 1
     7055                 .
     7056             end.
     7057         end.
     7058         else do:
     7059             assign
     7060                 v-exists = yes
     7061                 v-range  = 2
     7062             .
     7063         end.
     7064     end.
     7065     else do:
     7066         assign
     7067             v-exists = yes
     7068             v-range  = 3
     7069         .
     7070     end.
     7071     if available buf_gds-grp-obj
     7072     then do:
     7073       find first buf_gds-grp-obj-attr no-lock
     7074         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7075           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7076           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7077           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7078           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7079         no-error .
     7080       if available buf_gds-grp-obj-attr then do:
     7081         assign
     7082           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7083         .
     7084       end.
     7085       else do:
     7086         assign
     7087           v-notcorr-value = ?
     7088         .
     7089       end.
     7090       assign
     7091       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7092                           then yes
     7093                           else p-exists-notcorr)
     7094       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7095                         then v-range
     7096                         else p-range-notcorr
     7097       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7098                         then v-notcorr-value
     7099                         else p-notcorr
     7100       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7101       jj = jj + 1
     7102       .
     7103     end.
     7104     else do:
     7105       assign
     7106       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7107       jj = jj + 1
     7108       .
     7109     end.
     7110   end.
     7111   end.
     7112   end procedure.
