     3249   procedure alienini-getkey :
     3250   define input parameter i-filename as char.
     3251   define input parameter i-section as char.
     3252   define input parameter i-key as char.
     3253   define output parameter o-value as char.
     3254   define variable EntryPointer as integer no-undo.
     3255   define variable mem1 as memptr no-undo.
     3256   define variable mem2 as memptr no-undo.
     3257   define variable mem1size as integer no-undo.
     3258   define variable mem2size as integer no-undo.
     3259   define variable ii       as integer    no-undo.
     3260   define variable cbReturnSize  as integer    no-undo.
     3261   assign
     3262   set-size(mem1)  = 4000
     3263   mem1size = 4000.
     3264   if i-key = "" then EntryPointer = 0.
     3265   else do:
     3266     assign
     3267     set-size(mem2) = 128
     3268     mem2size = 128
     3269     EntryPointer = get-pointer-value(mem2)
     3270     put-string(mem2, 1) = i-key.
     3271   end.
     3272   run getprivateprofilestringA
     3273                                 (i-section,
     3274                                  EntryPointer,
     3275                                  "",
     3276                                  get-pointer-value(mem1),
     3277                                  input mem1size,
     3278                                  i-filename,
     3279                                  output cbReturnSize).
     3280   do ii = 1 to cbReturnSize:
     3281     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3282                  then o-value + ","
     3283                  else o-value + chr(get-byte(mem1, ii)).
     3284   end.
     3285     set-size(mem1) = 0.
     3286     set-size(mem2) = 0.
     3287   end procedure.
     3288   procedure alienini-putkey :
     3289   define input parameter i-filename as char.
     3290   define input parameter i-section as char.
     3291   define input parameter i-key as char.
     3292   define input parameter i-value as char.
     3293   define variable cbReturnSize as integer.
     3294   run writeprivateprofilestringA
     3295                                  (i-section,
     3296                                   i-key,
     3297                                   i-value,
     3298                                   i-filename,
     3299                                   output cbReturnSize ).
     3300   end procedure.
     3301   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3302     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3303     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3304     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3305     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3306     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3307     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3308     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3309   END PROCEDURE.
     3310   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3311     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3312     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3313     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3314     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3315     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3316   END PROCEDURE.
     3317   define   temp-table temp-tekka-tsk no-undo
     3318   field filename      as character
     3319   field obj-num       as integer
     3320   field obj-name      as character
     3321   field num-records   as integer
     3322   field max-records   as integer
     3323   field min-plu       as integer
     3324   field max-plu       as integer
     3325   field num-fields    as integer
     3326   field task-num      as character
     3327   field by-record     as logical
     3328   field send-get      as character
     3329   field cash-num      as integer
     3330   field cash-num-char as character
     3331   field port-num      as character
     3332   field way           as character
     3333   field is-script     as logical
     3334   field pswd          as character
     3335   field waiting-sek   as integer
     3336   field other-info    as character
     3337   field order-num     as integer
     3338   field secondary     as integer
     3339   field shift-fields  as integer
     3340   field binary        as logical
     3341   field range         as integer
     3342   index pi is unique primary
     3343   filename
     3344   range
     3345   index lpi
     3346   filename
     3347   min-plu
     3348   index gpi
     3349   filename
     3350   max-plu
     3351   index iorder
     3352   order-num
     3353   .
     3354   define   temp-table temp-tekka-schema no-undo
     3355   field obj-num as integer
     3356   field obj-name as character
     3357   field field-num as integer
     3358   field field-name as character
     3359   field num-records as integer
     3360   field size_ as integer
     3361   field host as character
     3362   field progress-type as character
     3363   field custom-type as character
     3364   field start-pos as integer
     3365   field end-pos as integer
     3366   field bin-group as character
     3367   index pi is unique primary
     3368   host obj-num field-num
     3369   .
     3370   define temp-table temp-tekka-record no-undo
     3371   field obj-num as integer
     3372   field plu as integer
     3373   field body as character
     3374   field shift as integer
     3375   index pi is unique primary obj-num plu.
     3376   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3377   define variable v-is-closed-shift-journal as integer no-undo .
     3378   assign
     3379   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3380                               +
     3381                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3382                               +
     3383                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3384   .
     3385   return v-is-closed-shift-journal.
     3386   END FUNCTION.
     3387   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3388   define variable v-is-first-journal as logical no-undo .
     3389   assign
     3390   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3391                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3392                     or (p-journal-num =  integer(entry(1, '17':U)))
     3393                     or (p-journal-num = integer(entry(1, '16':U)))
     3394   .
     3395   return v-is-first-journal.
     3396   END FUNCTION.
     3397   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3398   define variable v-is-petrol-journal as logical no-undo .
     3399   assign
     3400   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3401   return v-is-petrol-journal.
     3402   END FUNCTION.
     3403   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3404   define variable v-max-record-num as integer no-undo .
     3405   assign
     3406   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3407                       then 1489
     3408                       else 2340).
     3409   return v-max-record-num.
     3410   END FUNCTION.
     3411   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3412   define variable v-max-record-num as integer no-undo .
     3413   assign
     3414   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3415                       then 1489 * num-entries('30,31,32,33':U)
     3416                       else 2340 * num-entries('17':U)).
     3417   return v-max-record-num.
     3418   END FUNCTION.
     3419   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3420                                           ,input p-rec-no as integer):
     3421   define variable v-num-recs as integer no-undo .
     3422   if tekka-is-petrol-journal (p-journal-num) then do:
     3423     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3424       assign
     3425       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3426       .
     3427     end.
     3428     else do:
     3429       assign
     3430       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3431       .
     3432     end.
     3433   end.
     3434   else do:
     3435     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3436       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3437         assign
     3438         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3439         .
     3440       end.
     3441       else do:
     3442         assign
     3443         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3444         .
     3445       end.
     3446     end.
     3447     else do:
     3448       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3449         assign
     3450         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3451         .
     3452       end.
     3453       else do:
     3454         assign
     3455         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3456         .
     3457       end.
     3458     end.
     3459   end.
     3460   return v-num-recs.
     3461   END FUNCTION.
     3462   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3463                                              ,input p-is-petrol as logical
     3464                                              ,input p-is-current as logical
     3465                                              ,output p-rec-no as decimal
     3466                                              ):
     3467   define variable v-obj-num0 as integer no-undo .
     3468   define variable v-obj-num as integer no-undo .
     3469   define variable v-obj-num2 as integer no-undo .
     3470   define variable p-num-recs2 as integer no-undo .
     3471   define variable p-rec-no2 as integer no-undo .
     3472   if p-is-petrol then do:
     3473     assign
     3474     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3475     .
     3476     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3477     then
     3478     assign
     3479     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3480     p-rec-no = p-num-recs modulo 1489
     3481     .
     3482     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3483     then
     3484     assign
     3485     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3486     p-rec-no = p-num-recs modulo 1489
     3487     .
     3488   end.
     3489   else do:
     3490     assign
     3491     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3492     p-num-recs = trunc(p-num-recs, 0)
     3493     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3494     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3495     .
     3496     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3497     then
     3498     assign
     3499     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3500     p-rec-no = p-num-recs modulo 2340
     3501     .
     3502     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3503     then
     3504     assign
     3505     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3506     p-rec-no = p-num-recs modulo 2340
     3507     .
     3508     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3509     then
     3510     assign
     3511     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3512     p-rec-no2 = p-num-recs2 modulo 2978
     3513     .
     3514     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3515     then
     3516     assign
     3517     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3518     p-rec-no2 = p-num-recs2 modulo 2978
     3519     .
     3520     assign
     3521     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3522     .
     3523   end.
     3524   if v-obj-num = 0 then v-obj-num = 100.
     3525   return v-obj-num.
     3526   END FUNCTION.
     3527   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3528   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3529   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3530      if p-is-ptrl then
     3531      return integer(entry(1, '26,27,28,29':U)).
     3532      if not p-is-ptrl then
     3533      return integer(entry(1, '16':U)).
     3534   end.
     3535   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3536   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3537   return 0.
     3538   END FUNCTION.
     3539   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3540   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3541   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3542     if p-is-ptrl then
     3543     return integer(entry(1, '26,27,28,29':U)).
     3544     if not p-is-ptrl then
     3545     return integer(entry(1, '16':U)).
     3546   end.
     3547   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3548   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3549   return 0.
     3550   END FUNCTION.
     3551   PROCEDURE maria-put:
     3552   define parameter buffer buf_cash-desk for ub.cash-desk.
     3553   define input parameter p-out    as character no-undo .
     3554   define input parameter p-fname as character no-undo .
     3555   define input parameter p-by-record as logical no-undo .
     3556   define input parameter p-shift-fields as integer no-undo .
     3557   define input parameter p-binary as logical no-undo .
     3558   define input parameter p-obj-num as integer no-undo .
     3559   define input parameter p-max-records as integer no-undo .
     3560   define input parameter p-plu as integer no-undo .
     3561   define input parameter p-value as character no-undo .
     3562   define variable v-file-name as character no-undo .
     3563   define variable v-create as logical no-undo .
     3564   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3565   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3566   output stream IBMSTREAM
     3567   to value(v-file-name) append .
     3568   Put  stream IBMSTREAM unformatted
     3569   p-plu
     3570   chr(3)
     3571   p-value
     3572   skip.
     3573   output stream IBMSTREAM
     3574   close.
     3575   if not p-by-record then do:
     3576     find first buf_temp-tekka-tsk where
     3577               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3578     if not available buf_temp-tekka-tsk then do:
     3579       v-create = yes.
     3580     end.
     3581   end.
     3582   else do:
     3583     find first buf_temp-tekka-tsk where
     3584               buf_temp-tekka-tsk.filename  = v-file-name
     3585           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3586     if not available buf_temp-tekka-tsk
     3587     then do:
     3588       find first buf_temp-tekka-tsk where
     3589                 buf_temp-tekka-tsk.filename  = v-file-name
     3590             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3591       if not available buf_temp-tekka-tsk
     3592       then do:
     3593         v-create = yes.
     3594       end.
     3595     end.
     3596   end.
     3597   if v-create then do:
     3598     create buf_temp-tekka-tsk.
     3599     assign
     3600     buf_temp-tekka-tsk.filename = v-file-name
     3601     buf_temp-tekka-tsk.range    = p-plu
     3602     buf_temp-tekka-tsk.obj-num = p-obj-num
     3603     buf_temp-tekka-tsk.obj-name = '':U
     3604     buf_temp-tekka-tsk.num-records = 0
     3605     buf_temp-tekka-tsk.max-records = p-max-records
     3606     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3607     buf_temp-tekka-tsk.task-num = p-fname
     3608     buf_temp-tekka-tsk.by-record = p-by-record
     3609     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3610     buf_temp-tekka-tsk.binary = p-binary
     3611     buf_temp-tekka-tsk.send-get = 'send'
     3612     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3613     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3614     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3615     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3616                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3617                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3618                                 then 'local'
     3619                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3620     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3621     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3622     buf_temp-tekka-tsk.waiting-sek = 30
     3623     buf_temp-tekka-tsk.min-plu     = p-plu
     3624     buf_temp-tekka-tsk.max-plu     = p-plu
     3625     .
     3626   end.
     3627   assign
     3628   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3629   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3630   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3631   .
     3632   END PROCEDURE.
     3633   PROCEDURE maria-get:
     3634   define parameter buffer buf_cash-desk for ub.cash-desk.
     3635   define input parameter p-out    as character no-undo .
     3636   define input parameter p-fname as character no-undo .
     3637   define input parameter p-by-record as logical no-undo .
     3638   define input parameter p-obj-num as integer no-undo .
     3639   define input parameter p-num-fields as integer no-undo .
     3640   define input parameter p-max-records as integer no-undo .
     3641   define input parameter p-min-plu as integer no-undo .
     3642   define input parameter p-max-plu as integer no-undo .
     3643   define input parameter p-other as character no-undo .
     3644   define input parameter p-order-num as integer no-undo .
     3645   define variable v-file-name as character no-undo .
     3646   define variable v-secondary-obj-num as character no-undo .
     3647   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3648   if p-by-record then do:
     3649     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3650   end.
     3651   else do:
     3652     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3653   end.
     3654   find first buf_temp-tekka-tsk where
     3655             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3656   if not available buf_temp-tekka-tsk then do:
     3657     create buf_temp-tekka-tsk.
     3658     assign
     3659     buf_temp-tekka-tsk.filename = v-file-name
     3660     buf_temp-tekka-tsk.obj-num = p-obj-num
     3661     buf_temp-tekka-tsk.obj-name = '':U
     3662     buf_temp-tekka-tsk.max-records = p-max-records
     3663     buf_temp-tekka-tsk.num-fields = p-num-fields
     3664     buf_temp-tekka-tsk.task-num = p-fname
     3665     buf_temp-tekka-tsk.by-record = p-by-record
     3666     buf_temp-tekka-tsk.send-get = 'get'
     3667     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3668     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3669     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3670     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3671                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3672                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3673                                   then 'local'
     3674                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3675     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3676     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3677     buf_temp-tekka-tsk.waiting-sek = 30
     3678     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3679     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3680     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3681                                       and p-max-plu <> ?
     3682                                       then p-max-plu - p-min-plu + 1
     3683                                       else 0)
     3684     buf_temp-tekka-tsk.other-info = p-other
     3685     buf_temp-tekka-tsk.order-num = p-order-num
     3686     .
     3687     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3688       assign
     3689       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3690       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3691       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3692       no-error
     3693       .
     3694       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3695     end.
     3696   end.
     3697   END PROCEDURE.
     3698   PROCEDURE maria-task:
     3699   define parameter buffer buf_cash-desk for ub.cash-desk.
     3700   define input parameter p-fname as character no-undo .
     3701   define input parameter p-obj-num-list as character no-undo .
     3702   define input parameter p-parameters as character no-undo .
     3703   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3704   find first buf_temp-tekka-tsk where
     3705             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3706   if not available buf_temp-tekka-tsk then do:
     3707     create buf_temp-tekka-tsk.
     3708     assign
     3709     buf_temp-tekka-tsk.filename = ''
     3710     buf_temp-tekka-tsk.range = 1
     3711     buf_temp-tekka-tsk.obj-num = 0
     3712     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3713     buf_temp-tekka-tsk.task-num = p-fname
     3714     buf_temp-tekka-tsk.by-record = no
     3715     buf_temp-tekka-tsk.send-get = 'task'
     3716     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3717     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3718     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3719     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3720                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3721                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3722                                   then 'local'
     3723                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3724     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3725     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3726     buf_temp-tekka-tsk.waiting-sek = 30
     3727     buf_temp-tekka-tsk.other-info = p-parameters
     3728     buf_temp-tekka-tsk.order-num = 0
     3729     .
     3730   end.
     3731   END PROCEDURE.
     3732   procedure tekkatsk-verify-schema :
     3733   define input parameter p-obj-list as character no-undo .
     3734   define input parameter p-dir-path as character no-undo .
     3735   define variable v-obj-num as integer no-undo .
     3736   define variable v-obj-name as character no-undo .
     3737   define variable v-num-records as integer no-undo .
     3738   define variable v-size_ as integer no-undo .
     3739   define variable v-value as character no-undo .
     3740   define variable ii as integer no-undo .
     3741   define variable jj as integer no-undo .
     3742   define variable ii-ibs as integer no-undo .
     3743   define variable ii-tekka as integer no-undo .
     3744   define variable v-result as character no-undo .
     3745   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3746   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3747     do
     3748     on error undo, return error
     3749     :
     3750        for each buf_temp-tekka-schema:
     3751          delete buf_temp-tekka-schema.
     3752        end.
     3753        input from value('tekkasch.d').
     3754        repeat :
     3755          create buf_temp-tekka-schema.
     3756          import buf_temp-tekka-schema.
     3757          assign
     3758          buf_temp-tekka-schema.host = 'IBS'
     3759          ii = ii + 1.
     3760          .
     3761        end.
     3762        input close.
     3763        ii-ibs = ii.
     3764         _ii:
     3765         do ii = 1 to 256:
     3766           if p-obj-list = "ALL"
     3767           or lookup(string(ii), p-obj-list) > 0 then do:
     3768             assign
     3769             v-obj-num = 0
     3770             v-obj-name = ''
     3771             v-num-records = 0
     3772             v-size_ = 0
     3773             .
     3774             run alienini-getkey in this-procedure (
     3775                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3776                                                     ,input ('obj' + string(ii, '999'))
     3777                                                     ,input 'oname'
     3778                                                     ,output v-value) no-error .
     3779             if v-value = ? then next _ii.
     3780             assign
     3781             v-obj-num = ii
     3782             v-obj-name = v-value
     3783             .
     3784             run alienini-getkey in this-procedure (
     3785                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3786                                                     ,input ('obj' + string(ii, '999'))
     3787                                                     ,input 'size'
     3788                                                     ,output v-value) no-error .
     3789             assign
     3790             v-num-records = integer(v-value) no-error  .
     3791             if error-status:error
     3792             or v-num-records = 0 then next _ii.
     3793             run alienini-getkey in this-procedure (
     3794                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3795                                                     ,input 'obj' + string(ii, '999')
     3796                                                     ,input 'f000'
     3797                                                     ,output v-value) no-error .
     3798             assign
     3799             v-size_ = integer(v-value) no-error  .
     3800             if error-status:error
     3801             or v-size_ = 0 then next _ii.
     3802             _jj:
     3803             do jj = 1 to 256:
     3804               run alienini-getkey in this-procedure (
     3805                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3806                                                       ,input 'obj' + string(ii, '999')
     3807                                                       ,input 'f' + string(jj, '999')
     3808                                                       ,output v-value) no-error .
     3809               if v-value = ? then next _ii.
     3810               create buf_temp-tekka-schema.
     3811               assign
     3812               buf_temp-tekka-schema.host = 'tekka'
     3813               buf_temp-tekka-schema.obj-num = v-obj-num
     3814               buf_temp-tekka-schema.obj-name = v-obj-name
     3815               buf_temp-tekka-schema.num-records = v-num-records
     3816               buf_temp-tekka-schema.size_ = v-size_
     3817               buf_temp-tekka-schema.field-num = jj
     3818               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3819               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3820                                                  then entry(2, entry(2, v-value, '#'), ':')
     3821                                                  else '':U)
     3822               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3823               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3824               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3825                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3826               no-error
     3827               .
     3828               if error-status:error then do:
     3829                 delete buf_temp-tekka-schema.
     3830                 next _jj.
     3831               end.
     3832               run alienini-getkey in this-procedure (
     3833                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3834                                                       ,input 'obj' + string(ii, '999') + 'name'
     3835                                                       ,input 'n' + string(jj, '999')
     3836                                                       ,output v-value) no-error .
     3837               if v-value <> ? then
     3838               buf_temp-tekka-schema.field-name = v-value.
     3839             end.
     3840           end.
     3841         end.
     3842         ii-tekka = ii - 1.
     3843        if p-obj-list <> 'ALL' then do:
     3844         if ii-tekka <> ii-ibs then do:
     3845           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3846                                   , ii-ibs
     3847                                   , ii-tekka).
     3848         end.
     3849        end.
     3850        for each buf_temp-tekka-schema where
     3851               buf_temp-tekka-schema.host = 'tekka':
     3852          find first buf2_temp-tekka-schema where
     3853                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3854                AND buf2_temp-tekka-schema.host = 'ibs'
     3855                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3856          if not available buf2_temp-tekka-schema then do:
     3857           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3858                                   , buf_temp-tekka-schema.field-num
     3859                                   , buf_temp-tekka-schema.obj-num).
     3860          end.
     3861          buffer-compare buf_temp-tekka-schema
     3862          to buf2_temp-tekka-schema
     3863          save result in v-result.
     3864          if v-result <> '':U then do:
     3865           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3866                                   , buf_temp-tekka-schema.field-num
     3867                                   , buf_temp-tekka-schema.obj-num).
     3868          end.
     3869        end.
     3870     end.
     3871   end procedure.
     3872   FUNCTION set-Sx returns character (input p-string as character):
     3873   return p-string.
     3874   END FUNCTION.
     3875   FUNCTION get-Sx returns character (input p-string  as character):
     3876   return p-string.
     3877   END FUNCTION.
     3878   FUNCTION set-B returns character (input p-string  as character):
     3879   return chr(integer(p-string)).
     3880   END FUNCTION.
     3881   FUNCTION get-B returns character (input p-string  as character):
     3882   return string(asc(p-string)).
     3883   END FUNCTION.
     3884   FUNCTION set-BF returns character (input p-string  as character):
     3885   define variable v-dopi as integer no-undo .
     3886   define variable ii as integer no-undo .
     3887   do ii = 1 to 8:
     3888     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3889   end.
     3890   return chr(v-dopi).
     3891   END FUNCTION.
     3892   FUNCTION get-BF returns character (input p-string  as character):
     3893   define variable v-dopi as integer no-undo .
     3894   define variable v-dops as character no-undo .
     3895   define variable ii as integer no-undo .
     3896   v-dopi = asc(p-string).
     3897   do ii = 8 to 1 BY -1:
     3898     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3899   end.
     3900   return v-dops.
     3901   END FUNCTION.
     3902   FUNCTION set-BN returns character (input p-string  as character
     3903                                     ,input p-bin-group as character):
     3904   define variable v-dopi as integer no-undo .
     3905   define variable ii as integer no-undo .
     3906   define variable jj as integer no-undo .
     3907   define variable v-grp-nums as integer no-undo .
     3908   define variable v-dopi2 as integer no-undo .
     3909   v-grp-nums = num-entries(p-bin-group).
     3910   do jj = 0 to v-grp-nums - 1:
     3911     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3912     do ii = 1 to 8:
     3913       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3914     end.
     3915   end.
     3916   return chr(v-dopi).
     3917   END FUNCTION.
     3918   FUNCTION get-BN returns character (input p-string  as character
     3919                                     ,input p-bin-group as character):
     3920   define variable v-dopi as integer no-undo .
     3921   define variable v-dops as character no-undo .
     3922   define variable v-grp-nums as integer no-undo .
     3923   define variable ii as integer no-undo .
     3924   define variable jj as integer no-undo .
     3925   v-dopi = asc(p-string).
     3926   v-grp-nums = num-entries(p-bin-group).
     3927   do jj = 1 to v-grp-nums:
     3928   do ii = 8 to 1 BY -1:
     3929     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3930   end.
     3931   end.
     3932   return v-dops.
     3933   END FUNCTION.
     3934   procedure fill-temp-cd :
     3935   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3936   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3937   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3938   define input parameter p-clear-table as logical no-undo .
     3939   define buffer buf_temp-cd for temp-cd.
     3940   define buffer buf_cash-desk for ub.cash-desk.
     3941     do
     3942     on error undo, return error
     3943     :
     3944        if p-clear-table  then do:
     3945          for each buf_temp-cd:
     3946            delete buf_temp-cd.
     3947          end.
     3948        end.
     3949        for each buf_cash-desk no-lock where
     3950               buf_cash-desk.db-num = p-db-num
     3951           AND buf_cash-desk.obj-code = p-obj-code
     3952           and buf_cash-desk.cash-on  = yes
     3953        BREAK by buf_cash-desk.pos-type:
     3954          if first-of(buf_cash-desk.pos-type) then do:
     3955            create buf_temp-cd.
     3956            buffer-copy buf_cash-desk to buf_temp-cd.
     3957          end.
     3958        end.
     3959     end.
     3960   end procedure.
     3961   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3962   FUNCTION name-2cdf returns character
     3963                      (  input p-name-2cd as character
     3964                       , input p-mode as logical
     3965                       , input p-cod-pcod as logical
     3966                       , input p-b-code  as integer
     3967                       , input p-gds-code as integer
     3968                       , input p-artic   as character
     3969                       , input p-engl-name  as character
     3970                       , input p-in-code as character
     3971                       , input p-part-code as character
     3972                       , input p-obj-type as character
     3973                       , input p-obj-code as integer
     3974                       , input p-alpha1 as character
     3975                       , output p-gtd as character
     3976                       ) :
     3977   define variable v-name-2cd as character no-undo .
     3978   define variable v-dop-alt-name as character no-undo.
     3979   define variable v-type as character no-undo.
     3980   define buffer buf_parts for ub.parts.
     3981   define buffer buf_code for ub.code.
     3982   if not p-mode and p-name-2cd = "PLU":U then do:
     3983     return "PLU кассы":U.
     3984   end.
     3985   if not p-mode then do:
     3986     if p-name-2cd <> "GTD":U
     3987     and  p-name-2cd <> "alpha1|gtd":U
     3988     then do:
     3989     assign
     3990     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     3991   end.
     3992   end.
     3993   if p-part-code = "":U or p-cod-pcod = no then do:
     3994     run gdsoattr-value in this-procedure (
     3995       'dt-seasons':U,
     3996       p-gds-code,
     3997       p-obj-type,
     3998       p-obj-code,
     3999       output v-dop-alt-name,
     4000       output v-type
     4001     ) no-error.
     4002     if v-dop-alt-name <> "" then do:
     4003       find first buf_code where
     4004                  buf_code.parent = "DTSeasons"
     4005              and buf_code.code   = v-dop-alt-name
     4006            no-lock no-error.
     4007       if available buf_code then
     4008         assign
     4009           p-engl-name = ""
     4010           v-dop-alt-name =  buf_code.misc1
     4011         .
     4012     end.
     4013     else do:
     4014       run gdsoattr-value in this-procedure
     4015                           ( input  'dop-alt-name-o':U
     4016                            ,input  p-gds-code
     4017                            ,input  p-obj-type
     4018                            ,input  p-obj-code
     4019                            ,output v-dop-alt-name
     4020                            ,output v-type
     4021                           ) no-error .
     4022     end.
     4023     CASE p-name-2cd:
     4024       when "name" then do:
     4025         if p-mode then return p-engl-name + v-dop-alt-name.
     4026         return "Англ. название".
     4027       end.
     4028       when "code":U then do:
     4029         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4030         return "Лок. код товара"  .
     4031       end.
     4032       when "GTD":U
     4033       or
     4034       when "name-GTD":U
     4035       or
     4036       when "code-GTD":U
     4037       or
     4038       when "alpha1|gtd":U
     4039       or
     4040       when "name-alpha1|gtd":U
     4041       or
     4042       when "code-alpha1|gtd":U
     4043       then do:
     4044         if p-mode then do:
     4045           run gdcstcod_cst-code  in this-procedure (
     4046                                                       input  p-obj-type
     4047                                                       ,input  p-obj-code
     4048                                                       ,input  p-gds-code
     4049                                                       ,input  p-in-code
     4050                                                       ,input  p-part-code
     4051                                                       ,output p-gtd
     4052                                                       ) no-error .
     4053         end.
     4054         if p-name-2cd = "name-gtd":U then do:
     4055           if p-mode then return p-engl-name  + v-dop-alt-name.
     4056           return "Англ. название".
     4057         end.
     4058         if p-name-2cd = "name-alpha1|gtd":U then do:
     4059           if p-mode then return p-engl-name  + v-dop-alt-name.
     4060           return "Англ. название".
     4061         end.
     4062         if p-name-2cd = "code-GTD":U then do:
     4063           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4064           return "Лок. код товара"  .
     4065         end.
     4066         if p-name-2cd = "code-alpha1|gtd":U then do:
     4067           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4068           return "Лок. код товара"  .
     4069         end.
     4070         if p-mode then do:
     4071           if p-name-2cd = "GTD" then  return p-gtd.
     4072           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4073         end.
     4074         if p-name-2cd = "GTD" then  return "Код ГТД".
     4075         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4076       end.
     4077     END CASE.
     4078   end.
     4079   else do:
     4080     if p-name-2cd = "name-gtd":U
     4081     or p-name-2cd = "code-GTD":U
     4082     or p-name-2cd = "name-alpha1|GTD":U
     4083     or p-name-2cd = "code-alpha1|GTD":U
     4084     or p-name-2cd = "alpha1|GTD":U
     4085     then do:
     4086       if p-mode then do:
     4087         run gdcstcod_cst-code  in this-procedure (
     4088                                                      input  p-obj-type
     4089                                                     ,input  p-obj-code
     4090                                                     ,input  p-gds-code
     4091                                                     ,input  p-in-code
     4092                                                     ,input  p-part-code
     4093                                                     ,output p-gtd
     4094                                                     ) no-error .
     4095       end.
     4096       else do:
     4097         if p-name-2cd = "gtd":U then
     4098         p-gtd = "Код ГТД".
     4099         if p-name-2cd = "alpha1|Gtd":U then
     4100         p-gtd = "Страна|Код ГТД".
     4101       end.
     4102     end.
     4103     if p-mode then  return p-part-code.
     4104     return "Код партии".
     4105   end.
     4106   END FUNCTION.
     4107   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4108                                            ,input p-nam-2str as logical
     4109                                            ,input p-nam-artc as logical
     4110                                            ,input p-unit-cli-type as character
     4111                                            ,input p-unit-base as character
     4112                                            ,input p-unit-cli as character
     4113                                            ,input p-cli-base-rate as decimal
     4114                                            ,input p-artic as character
     4115                                            ,input p-f-name as character
     4116                                            ,input p-gds-name as character
     4117                                            ,input p-gds-name1 as character
     4118                                            ,output p-second-name as character):
     4119   define variable v-length as integer no-undo .
     4120   define variable nam-2str-shift as integer no-undo .
     4121   define variable chk_name as character no-undo .
     4122   assign
     4123   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4124   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4125   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4126               then 5
     4127               else v-length)
     4128   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4129   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4130   .
     4131   if p-nam-artc then do:
     4132     assign
     4133     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4134       .
     4135   end.
     4136   else  do:
     4137     assign
     4138     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4139     .
     4140   end.
     4141   if p-unit-base <> p-unit-cli then do:
     4142     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4143     assign
     4144     chk_name = string(substr(chk_name
     4145                               ,1
     4146                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4147                       "*":U +
     4148                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4149   end.
     4150   else do:
     4151     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4152   end.
     4153   if p-nam-2str then do:
     4154     assign
     4155     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4156     chk_name = substr(chk_name, 1, v-length)
     4157     .
     4158   end.
     4159   else do:
     4160     assign
     4161     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4162     p-second-name =   (chr(34) +
     4163                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4164                       + chr(34) )
     4165     .
     4166   end.
     4167   return chk_name.
     4168   end function.
     4169   def var vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4170   procedure disrules-get-interface-form :
     4171   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4172   define output parameter p-form-name as character no-undo .
     4173   define buffer buf_temp-drt-prop for temp-drt-prop.
     4174   define buffer buf_drt-prop for ub.drt-prop.
     4175   find first buf_temp-drt-prop where
     4176             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4177         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4178         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4179   if not available buf_temp-drt-prop then do:
     4180     find first buf_drt-prop where
     4181               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4182           and buf_drt-prop.upper-prop-code = "InputForm"
     4183           and buf_drt-prop.prop-code = "FormName" no-error.
     4184     if available buf_drt-prop then do:
     4185       p-form-name = buf_drt-prop.property-value.
     4186     end.
     4187     else do:
     4188       p-form-name = "ref/dis-ruli.w".
     4189     end.
     4190   end.
     4191   else do:
