     4734   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4735   PROCEDURE cd-mrkt_plu-marketer :
     4736   define input parameter p-silence as logical no-undo .
     4737   define parameter buffer buf_cash-desk for ub.cash-desk.
     4738   define input parameter p-id as character no-undo .
     4739   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4740   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4741   define input parameter p-loc-ean as logical no-undo .
     4742   define input parameter p-is-petrolium as logical no-undo .
     4743   define input parameter p-extra as character no-undo .
     4744   define variable v-tot-gds as integer no-undo .
     4745   define variable v-max-gds as integer no-undo .
     4746   define variable v-petrol-start as integer no-undo .
     4747   define variable v-petrol-range as integer no-undo .
     4748   DEFINE VARIABLE v-today as date no-undo .
     4749   DEFINE VARIABLE v-time as integer no-undo .
     4750   define variable v-plu-type as character no-undo .
     4751   define variable v-int as integer no-undo .
     4752   define buffer  buf_cd-plu for ub.cd-plu.
     4753   define buffer  loc_cd-plu for ub.cd-plu.
     4754   define variable  ii as integer no-undo.
     4755   define variable v-mes as character no-undo .
     4756   _main:
     4757   DO ON ERROR undo, leave on stop undo, leave:
     4758     if buf_cash-desk.pos-type <> 'MARIA':U
     4759     or buf_cash-desk.cash-num <> 0 then do:
     4760       assign
     4761       v-mes =
     4762       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4763                 , buf_cash-desk.pos-type).
     4764       if not p-silence then
     4765       message
     4766       v-mes
     4767       view-as alert-box error .
     4768       return error v-mes.
     4769     end.
     4770     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4771                                     ,input 'MARIA_operative':U
     4772                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4773                                           and p-is-petrolium
     4774                                           then 'tot-petrol':U
     4775                                           else 'tot-gds':U)
     4776                                     , output v-mes).
     4777     if v-tot-gds = ? then undo _main, return error v-mes.
     4778     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4779                                     ,input 'MARIA_general':U
     4780                                     ,input 'max-gds':U
     4781                                     ,output v-mes).
     4782     if v-max-gds = ? then undo _main, return error v-mes.
     4783     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4784                                          ,input 'petrolium-range':U
     4785                                          ,input 'petrolium-range':U
     4786                                          ,output v-mes).
     4787     if v-petrol-range = ? then undo _main, return error v-mes.
     4788     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4789       assign
     4790       v-petrol-start = 1
     4791       v-max-gds = (if p-is-petrolium
     4792                    then v-petrol-range
     4793                    else v-max-gds)
     4794       v-plu-type = (if p-is-petrolium
     4795                  then 'топ':U
     4796                  else '':U)
     4797       .
     4798       if p-is-petrolium then do:
     4799         if p-id = '':U then do:
     4800           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4801                               "Невозможно привязать к кассе типа &3"
     4802                               , p-b-str
     4803                               , chr(10)
     4804                               , 'MARIA':U).
     4805           if not p-silence then
     4806           message
     4807           v-mes
     4808           view-as alert-box error .
     4809           return error v-mes.
     4810         end.
     4811         assign
     4812         v-int = integer(p-id)
     4813         no-error
     4814         .
     4815         if error-status:error
     4816         or v-int > v-petrol-range then do:
     4817           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4818                               "в диапазоны номеров резервуаров для кассы типа &4"
     4819                               , p-id
     4820                               , p-b-str
     4821                               , chr(10)
     4822                               , 'MARIA':U).
     4823           if not p-silence then
     4824           message
     4825           v-mes
     4826           view-as alert-box error .
     4827           return error v-mes.
     4828         end.
     4829       end.
     4830     end.
     4831     if buf_cash-desk.pos-type = 'MARIA':U
     4832     and p-is-petrolium then do:
     4833       find first loc_cd-plu where
     4834                loc_cd-plu.obj-type = 'маг':U
     4835            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4836            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4837            and loc_cd-plu.plu-type = 'топ':U
     4838      no-error .
     4839      if available loc_cd-plu then do:
     4840        if loc_cd-plu.b-code = p-b-code
     4841        and loc_cd-plu.b-str = p-b-str then do:
     4842           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4843                               , p-id
     4844                               , p-b-str
     4845                               , chr(10)
     4846                               ).
     4847           if not p-silence then
     4848           message
     4849           v-mes
     4850           view-as alert-box WARNING .
     4851           return v-mes.
     4852        end.
     4853        else do:
     4854           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4855                               "нельзя его привязать к топливу &2&3"
     4856                               , p-id
     4857                               , loc_cd-plu.b-str
     4858                               , chr(10)
     4859                               , p-b-str).
     4860           if not p-silence then
     4861           message
     4862           v-mes
     4863           view-as alert-box error .
     4864           return error v-mes.
     4865        end.
     4866      end.
     4867      ii = v-int.
     4868     end.
     4869     else do:
     4870       DO ii = (if p-is-petrolium
     4871               then v-petrol-start
     4872               else (if buf_cash-desk.pos-type = 'MARIA':U
     4873                    then 1
     4874                    else (if v-petrol-start = 1
     4875                           then (v-petrol-range + 1)
     4876                           else 1)
     4877                   )
     4878               )
     4879         to v-max-gds :
     4880         if not can-find (loc_cd-plu where
     4881                         loc_cd-plu.obj-type = 'маг':U
     4882                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4883                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4884                      and loc_cd-plu.plu-type = v-plu-type
     4885                      and loc_cd-plu.plu-code = ii
     4886                       )
     4887         then LEAVE .
     4888       END .
     4889     end.
     4890     if ii > v-max-gds then do:
     4891         if not p-silence then
     4892         message
     4893         substitute("Превышено максимально допустимое количество &5 &1" +
     4894                   "для касс &2 &3&4"
     4895                   , chr(10)
     4896                   , v-max-gds
     4897                   , 'маг':U
     4898                   , buf_cash-desk.obj-code
     4899                   , (if p-is-petrolium then "топлив" else "товаров")
     4900                   )
     4901         view-as alert-box ERROR .
     4902         undo, return error "max-gds":U.
     4903     end.
     4904     DO ii = (if p-is-petrolium
     4905              then v-petrol-start
     4906              else (if v-petrol-start = 1
     4907                    then (v-petrol-range + 1)
     4908                    else 1)
     4909              )
     4910        to v-max-gds :
     4911       if not can-find (loc_cd-plu where
     4912                         loc_cd-plu.obj-type = 'маг':U
     4913                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4914                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4915                      and loc_cd-plu.plu-type = v-plu-type
     4916                      and loc_cd-plu.plu-code = ii
     4917                      )
     4918       then LEAVE .
     4919     END .
     4920     if ii > v-max-gds then do:
     4921         if not p-silence then
     4922         message
     4923         substitute("Превышено максимально допустимое количество &5 &1" +
     4924                   "для касс &2 &3&4"
     4925                   , chr(10)
     4926                   , v-max-gds
     4927                   , 'маг':U
     4928                   , buf_cash-desk.obj-code
     4929                   , (if p-is-petrolium then "топлив" else "товаров")
     4930                   )
     4931         view-as alert-box ERROR .
     4932         undo, return error "max-gds":U.
     4933     end.
     4934     run cur-time in this-procedure ( output v-today, output v-time).
     4935     create buf_cd-plu.
     4936     assign
     4937     buf_cd-plu.b-code = p-b-code
     4938     buf_cd-plu.b-str = p-b-str
     4939     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4940                                         then buf_cash-desk.addr-path
     4941                                         else "U":U)
     4942     buf_cd-plu.to-send = yes
     4943     buf_cd-plu.charkey_one = "":U
     4944     buf_cd-plu.to-del = no
     4945     buf_cd-plu.plu-code = ii
     4946     buf_cd-plu.obj-type = 'маг':U
     4947     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4948     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4949     buf_cd-plu.plu-type = v-plu-type
     4950     buf_cd-plu.logkey_one = p-loc-ean
     4951     buf_cd-plu.key#_one = integer(p-extra)
     4952     .
     4953     run cd-attr-write  in this-procedure (
     4954                                           input   buf_cash-desk.db-num
     4955                                           ,input  buf_cash-desk.obj-code
     4956                                           ,input  buf_cash-desk.pos-type
     4957                                           ,input  buf_cash-desk.cash-num
     4958                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4959                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4960                                                 and p-is-petrolium
     4961                                                 then 'tot-petrol':U
     4962                                                 else 'tot-gds':U)
     4963                                           ,input ''
     4964                                           ,input ?
     4965                                           ,input 0.0
     4966                                           ,input  (v-tot-gds + 1)
     4967                                           ,input no
     4968                                          ) no-error .
     4969     if error-status:error then do:
     4970       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4971                          ,buf_cash-desk.cash-num
     4972                          , 'маг':U
     4973                          ,buf_cash-desk.obj-code
     4974                          , chr(10)
     4975                          , error-status:get-message(1)
     4976                          , return-value
     4977                          ).
     4978       if not p-silence then
     4979       message
     4980       v-mes
     4981       view-as alert-box error .
     4982       undo _main, return error v-mes.
     4983     end.
     4984     run cd-attr-write  in this-procedure (
     4985                                           input   buf_cash-desk.db-num
     4986                                           ,input  buf_cash-desk.obj-code
     4987                                           ,input  buf_cash-desk.pos-type
     4988                                           ,input  buf_cash-desk.cash-num
     4989                                           ,input  'MARIA_operative':U
     4990                                           ,input  'to-send':U
     4991                                           ,input ''
     4992                                           ,input ?
     4993                                           ,input 0.0
     4994                                           ,input 0
     4995                                           ,input yes
     4996                                          ) no-error .
     4997     if error-status:error then do:
     4998       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     4999                          ,buf_cash-desk.cash-num
     5000                          , 'маг':U
     5001                          ,buf_cash-desk.obj-code
     5002                          , chr(10)
     5003                          , error-status:get-message(1)
     5004                          , return-value
     5005                          ).
     5006       if not p-silence then
     5007       message
     5008       v-mes
     5009       view-as alert-box error .
     5010       undo _main, return error v-mes.
     5011     end.
     5012     return "":U.
     5013   end.
     5014   END PROCEDURE.
     5015   procedure cd-mrkt_update-marketer :
     5016   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5017   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5018   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5019   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5020   define input parameter p-is-petrolium as logical no-undo .
     5021   define variable v-to-send as logical no-undo .
     5022   define variable v-tot-gds as integer no-undo .
     5023   define variable v-max-plu as integer no-undo .
     5024   define buffer buf_cd-plu for ub.cd-plu.
     5025   define variable v-plu-type as character no-undo .
     5026     do
     5027     on error undo, return error
     5028     :
     5029       v-to-send = no.
     5030       v-tot-gds = 0.
     5031       assign
     5032       v-plu-type = (if p-is-petrolium
     5033                     then  'топ':U
     5034                     else '':U
     5035                 )
     5036       .
     5037       FOR EACH buf_cd-plu WHERE
     5038              buf_cd-plu.obj-type = 'маг':U
     5039         and  buf_cd-plu.obj-code = p-obj-code
     5040         and  buf_cd-plu.pos-type = p-pos-type
     5041         and  buf_cd-plu.plu-type = v-plu-type
     5042             :
     5043         if  buf_cd-plu.to-del
     5044         or  buf_cd-plu.to-send then do:
     5045           assign
     5046           v-to-send = yes.
     5047         end.
     5048         assign
     5049         v-tot-gds = v-tot-gds + 1.
     5050       end.
     5051       run cd-attr-write  in this-procedure (
     5052                                               input   p-db-num
     5053                                               ,input  p-obj-code
     5054                                               ,input  p-pos-type
     5055                                               ,input  p-cash-num
     5056                                               ,input  'MARIA_operative':U
     5057                                               ,input  (if p-pos-type = 'MARIA':U
     5058                                                        and p-is-petrolium
     5059                                                        then  'tot-petrol':U
     5060                                                        else 'tot-gds':U)
     5061                                               ,input ''
     5062                                               ,input ?
     5063                                               ,input 0.0
     5064                                               ,input v-tot-gds
     5065                                               ,input no
     5066                                                                                           ) no-error .
     5067       if error-status:error then do:
     5068           UNDO, RETURN ERROR RETURN-VALUE.
     5069       END.
     5070       run cd-attr-write  in this-procedure (
     5071                                               input   p-db-num
     5072                                               ,input  p-obj-code
     5073                                               ,input  p-pos-type
     5074                                               ,input  p-cash-num
     5075                                               ,input  'MARIA_operative':U
     5076                                               ,input  (if p-pos-type = 'MARIA':U
     5077                                                        and p-is-petrolium
     5078                                                        then  'petrol-to-send':U
     5079                                                        else 'to-send':U)
     5080                                               ,input ''
     5081                                               ,input ?
     5082                                               ,input 0.0
     5083                                               ,input 0
     5084                                               ,input v-to-send
     5085                                               ) no-error .
     5086       if error-status:error then do:
     5087           UNDO, RETURN ERROR RETURN-VALUE.
     5088       END.
     5089       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5090                buf_cd-plu.obj-type = 'маг':U
     5091            and buf_cd-plu.obj-code = p-obj-code
     5092            and buf_cd-plu.pos-type = p-pos-type
     5093            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5094       if available buf_cd-plu then do:
     5095         if v-max-plu < buf_cd-plu.plu-code
     5096         then
     5097         v-max-plu = buf_cd-plu.plu-code .
     5098       end.
     5099       else do:
     5100         v-max-plu = 0.
     5101       end.
     5102       run cd-attr-write  in this-procedure (
     5103                                             input   p-db-num
     5104                                             ,input  p-obj-code
     5105                                             ,input  p-pos-type
     5106                                             ,input  p-cash-num
     5107                                             ,input  'MARIA_operative':U
     5108                                             ,input  (if p-pos-type = 'MARIA':U
     5109                                                     and p-is-petrolium
     5110                                                     then 'max-petrol-plu':U
     5111                                                     else 'max-plu':U)
     5112                                               ,input ''
     5113                                               ,input ?
     5114                                               ,input 0.0
     5115                                               ,input v-max-plu
     5116                                               ,input no
     5117                                             ) no-error .
     5118       if error-status:error then do:
     5119           UNDO, RETURN ERROR RETURN-VALUE.
     5120       END.
     5121     end.
     5122   end procedure.
     5123   PROCEDURE cd-mrkt_clu-marketer :
     5124   define input parameter p-silence as logical no-undo .
     5125   define parameter buffer buf_cash-desk for ub.cash-desk.
     5126   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5127   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5128   define variable v-tot-cli as integer no-undo .
     5129   define variable v-max-cli as integer no-undo .
     5130   DEFINE VARIABLE v-today as date no-undo .
     5131   DEFINE VARIABLE v-time as integer no-undo .
     5132   define buffer  buf_cd-clu for ub.cd-clu.
     5133   define buffer  loc_cd-clu for ub.cd-clu.
     5134   define variable  ii as integer no-undo.
     5135   define variable v-mes as character no-undo .
     5136   _main:
     5137   DO ON ERROR undo, leave on stop undo, leave:
     5138     if buf_cash-desk.pos-type <> 'MARIA':U
     5139     or buf_cash-desk.cash-num <> 0 then do:
     5140       assign
     5141       v-mes =
     5142       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5143                 , buf_cash-desk.pos-type).
     5144       if not p-silence then
     5145       message
     5146       v-mes
     5147       view-as alert-box error .
     5148       return error v-mes.
     5149     end.
     5150     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5151                                     ,input 'MARIA_operative':U
     5152                                     ,input 'tot-cli':U
     5153                                     ,output v-mes).
     5154     if v-tot-cli = ? then undo _main, return error v-mes.
     5155     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5156                                     ,input 'MARIA_general':U
     5157                                     ,input 'max-cli':U
     5158                                     , output v-mes).
     5159     if v-max-cli = ? then undo _main, return error v-mes.
     5160     DO ii = 1
     5161        to v-max-cli :
     5162       if not can-find (loc_cd-clu where
     5163                       loc_cd-clu.obj-type = 'маг':U
     5164                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5165                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5166                   and loc_cd-clu.clu-type = '':U
     5167                   and loc_cd-clu.clu-code = ii
     5168                      )
     5169       then LEAVE .
     5170     END .
     5171     if ii > v-max-cli then do:
     5172         if not p-silence then
     5173         message
     5174         substitute("Превышено максимально допустимое количество клиентов &1" +
     5175                   "для касс &2 &3&4"
     5176                   , chr(10)
     5177                   , v-max-cli
     5178                   , 'маг':U
     5179                   , buf_cash-desk.obj-code
     5180                   )
     5181         view-as alert-box ERROR .
     5182         undo, return error "max-cli":U.
     5183     end.
     5184     run cur-time in this-procedure ( output v-today, output v-time).
     5185     create buf_cd-clu.
     5186     assign
     5187     buf_cd-clu.cli-code = p-obj-code
     5188     buf_cd-clu.cli-type = p-obj-type
     5189     buf_cd-clu.obj-type = 'маг':U
     5190     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5191     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5192     buf_cd-clu.clu-type = '':U
     5193     buf_cd-clu.to-send = yes
     5194     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5195                               then buf_cash-desk.addr-path
     5196                               else "U":U)
     5197     buf_cd-clu.clu-code = ii
     5198     .
     5199     run cd-attr-write  in this-procedure (
     5200                                           input   buf_cash-desk.db-num
     5201                                           ,input  buf_cash-desk.obj-code
     5202                                           ,input  buf_cash-desk.pos-type
     5203                                           ,input  buf_cash-desk.cash-num
     5204                                           ,input  'MARIA_operative':U
     5205                                           ,input  'tot-cli':U
     5206                                           ,input ''
     5207                                           ,input ?
     5208                                           ,input 0.0
     5209                                           ,input  (v-tot-cli + 1)
     5210                                           ,input no
     5211                                          ) no-error .
     5212     if error-status:error then do:
     5213       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5214                          ,buf_cash-desk.cash-num
     5215                          , 'маг':U
     5216                          ,buf_cash-desk.obj-code
     5217                          , chr(10)
     5218                          , error-status:get-message(1)
     5219                          , return-value
     5220                          ).
     5221       if not p-silence then
     5222       message
     5223       v-mes
     5224       view-as alert-box error .
     5225       undo _main, return error v-mes.
     5226     end.
     5227     run cd-attr-write  in this-procedure (
     5228                                           input   buf_cash-desk.db-num
     5229                                           ,input  buf_cash-desk.obj-code
     5230                                           ,input  buf_cash-desk.pos-type
     5231                                           ,input  buf_cash-desk.cash-num
     5232                                           ,input  'MARIA_operative':U
     5233                                           ,input  'cli-to-send':U
     5234                                           ,input ''
     5235                                           ,input ?
     5236                                           ,input 0.0
     5237                                           ,input 0
     5238                                           ,input yes
     5239                                          ) no-error .
     5240     if error-status:error then do:
     5241       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5242                          ,buf_cash-desk.cash-num
     5243                          , 'маг':U
     5244                          ,buf_cash-desk.obj-code
     5245                          , chr(10)
     5246                          , error-status:get-message(1)
     5247                          , return-value
     5248                          ).
     5249       if not p-silence then
     5250       message
     5251       v-mes
     5252       view-as alert-box error .
     5253       undo _main, return error v-mes.
     5254     end.
     5255     return "":U.
     5256   end.
     5257   END PROCEDURE.
     5258   procedure cd-mrkt_update-marketer-cli :
     5259   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5260   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5261   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5262   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5263   define variable v-cli-to-send as logical no-undo .
     5264   define variable v-tot-cli as integer no-undo .
     5265   define variable v-max-clu as integer no-undo .
     5266   define buffer buf_cd-clu for ub.cd-clu.
     5267   do
     5268   on error undo, return error return-value
     5269   :
     5270     v-cli-to-send = no.
     5271     v-tot-cli = 0.
     5272     FOR EACH buf_cd-clu WHERE
     5273           buf_cd-clu.obj-type = 'маг':U
     5274       and buf_cd-clu.obj-code =  p-obj-code
     5275       and buf_cd-clu.pos-type =  p-pos-type
     5276       and buf_cd-clu.clu-type =  '':U
     5277       :
     5278       if buf_cd-clu.to-del = yes then do:
     5279         assign
     5280         v-cli-to-send = yes.
     5281       end.
     5282       assign
     5283       v-tot-cli = v-tot-cli + 1.
     5284     end.
     5285     run cd-attr-write  in this-procedure (
     5286                                             input   p-db-num
     5287                                             ,input  p-obj-code
     5288                                             ,input  p-pos-type
     5289                                             ,input  p-cash-num
     5290                                             ,input  'MARIA_operative':U
     5291                                             ,input  'tot-cli':U
     5292                                             ,input ''
     5293                                             ,input ?
     5294                                             ,input 0.0
     5295                                             ,input v-tot-cli
     5296                                             ,input no
     5297                                             ) no-error .
     5298     if error-status:error then do:
     5299         UNDO, RETURN ERROR RETURN-VALUE.
     5300     END.
     5301     run cd-attr-write  in this-procedure (
     5302                                             input   p-db-num
     5303                                             ,input  p-obj-code
     5304                                             ,input  p-pos-type
     5305                                             ,input  p-cash-num
     5306                                             ,input  'MARIA_operative':U
     5307                                             ,input  'cli-to-send':U
     5308                                             ,input ''
     5309                                             ,input ?
     5310                                             ,input 0.0
     5311                                             ,input 0
     5312                                             ,input v-cli-to-send
     5313                                             ) no-error .
     5314     if error-status:error then do:
     5315         UNDO, RETURN ERROR RETURN-VALUE.
     5316     END.
     5317     FIND LAST buf_cd-clu WHERE
     5318             buf_cd-clu.obj-type = 'маг':U
     5319         and buf_cd-clu.obj-code = p-obj-code
     5320         and buf_cd-clu.pos-type = p-pos-type
     5321         and buf_cd-clu.clu-type = '':U
     5322         NO-LOCK use-index pi no-error .
     5323     if available buf_cd-clu then do:
     5324       if v-max-clu < buf_cd-clu.clu-code
     5325       then
     5326       v-max-clu = buf_cd-clu.clu-code.
     5327     end.
     5328     else do:
     5329       v-max-clu = 0.
     5330     end.
     5331     run cd-attr-write  in this-procedure (
     5332                                           input   p-db-num
     5333                                           ,input  p-obj-code
     5334                                           ,input  p-pos-type
     5335                                           ,input  p-cash-num
     5336                                           ,input  'MARIA_operative':U
     5337                                           ,input  'max-clu':U
     5338                                           ,input ''
     5339                                           ,input ?
     5340                                           ,input 0.0
     5341                                           ,input v-max-clu
     5342                                           ,input no
     5343                                           ) no-error .
     5344     if error-status:error then do:
     5345         UNDO, RETURN ERROR RETURN-VALUE.
     5346     END.
     5347   end.
     5348   end procedure.
     5349   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5350   procedure gds-attr-name :
     5351     define input  parameter p-code           as character no-undo .
     5352     define output parameter p-type           as character no-undo .
     5353     define output parameter p-format         as character no-undo .
     5354     define output parameter p-label          as character no-undo .
     5355     define output parameter p-user-can-edit  as logical   no-undo .
     5356     define output parameter p-output-display as logical   no-undo .
     5357     define output parameter p-other          as character no-undo .
     5358     do
     5359     on error undo, return error
     5360     :
     5361           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     5362         (input  p-code
     5363         ,output p-type
     5364         ,output p-format
     5365         ,output p-label
     5366         ,output p-user-can-edit
     5367         ,output p-output-display
     5368         ,output p-other
     5369         ) no-error .
     5370       if error-status :error
     5371       then do:
     5372         undo, return error return-value .
     5373       end.
     5374     end.
     5375   end procedure.
