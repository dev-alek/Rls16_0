        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: 66c80260f80d, 2644, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
        4   define variable vss-date        as character no-undo initial "$Date: 2020/10/23 18:03:38 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: pstlnupd.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: str/pstlnupd.p $":U .
        7   define variable vss-description as character no-undo initial "Добавление связки пересортицы":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define temp-table tt-gds-dtl no-undo
       73   field gds-code like ub.goods.gds-code
       74   field prt-code like ub.gds-dtl.prt-code
       75   field qnty     as   decimal
       76   index pi is unique primary gds-code prt-code.
       77   define temp-table tt-gds-dtl-plus no-undo
       78   field gds-code like ub.goods.gds-code
       79   field prt-code like ub.gds-dtl.prt-code
       80   field qnty     as   decimal
       81   index pi is unique primary gds-code prt-code.
       82   define temp-table tt-pl-qty no-undo
       83   field pl-code like ub.place.pl-code
       84   field qnty-l  as   decimal
       85   field qnty-kg as   decimal
       86   index pi is unique primary pl-code.
       87   define temp-table tt-pl-qty-plus no-undo
       88   field pl-code like ub.place.pl-code
       89   field qnty-l  as   decimal
       90   field rsrv-l  as   decimal
       91   field qnty-kg as   decimal
       92   index pi is unique primary pl-code.
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   function octal-to-char return character
       95   ( p-string as character ) :
       96     def var v-asc     as integer no-undo .
       97     def var v-new-asc as integer no-undo .
       98     def var ind       as integer no-undo .
       99     if length(p-string) <> 3 then do:
      100       return ? .
      101     end.
      102     assign
      103       v-asc = 0
      104     .
      105     do ind = 1 to length(p-string)
      106     :
      107       assign
      108         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      109       .
      110       if v-new-asc < 0 or v-new-asc >= 8 then do:
      111         return ? .
      112       end.
      113       assign
      114         v-asc = v-asc * 8 + v-new-asc
      115       .
      116     end.
      117     return chr(v-asc) .
      118   end function .
      119   function char-to-octal return character
      120   ( p-chr as character ) :
      121     def var v-asc    as integer   no-undo .
      122     def var ind      as integer   no-undo .
      123     def var v-string as character no-undo .
      124     if length(p-chr) <> 1 then do:
      125       return ? .
      126     end.
      127     assign
      128       v-asc    = asc(p-chr)
      129       v-string = ""
      130     .
      131     do ind = 1 to 3
      132     :
      133       assign
      134         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      135       .
      136       assign
      137         v-asc = truncate(v-asc / 8, 0)
      138       .
      139     end.
      140     return v-string .
      141   end.
      142   function str-encode return character
      143   (   p-init-string       as character
      144     , p-encode-char       as character
      145     , p-special-char-list as character
      146   ) :
      147     def var p-encode-string as character no-undo .
      148     def var ind                as integer no-undo .
      149     def var v-num-special-char as integer no-undo .
      150     def var v-special-char     as character no-undo .
      151     if p-encode-char = ?
      152     or p-encode-char = "" then do:
      153       assign
      154         p-encode-char = "~~"
      155       .
      156     end.
      157     if p-init-string = ? then do:
      158       return "?" .
      159     end.
      160     if p-init-string = "?" then do:
      161       return p-encode-char + char-to-octal("?") .
      162     end.
      163     assign
      164       v-num-special-char = length(p-special-char-list)
      165       p-encode-string    = replace(p-init-string
      166                                   ,p-encode-char
      167                                   ,p-encode-char + char-to-octal(p-encode-char)
      168                                   )
      169     .
      170     do ind = 1 to v-num-special-char
      171     :
      172       assign
      173         v-special-char = substring(p-special-char-list, ind, 1)
      174       .
      175       if v-special-char <> p-encode-char then do:
      176         assign
      177           p-encode-string = replace (p-encode-string
      178                                     ,v-special-char
      179                                     ,p-encode-char + char-to-octal(v-special-char)
      180                                     )
      181         .
      182       end.
      183     end.
      184     return p-encode-string .
      185   end.
      186   function str-decode returns character
      187     (p-init-string   as character
      188     ,p-encode-char   as character
      189     ) :
      190     def var p-decode-string as character no-undo .
      191     def var ind                       as integer no-undo .
      192     def var v-num-entries-init-string as integer no-undo .
      193     def var v-sub-phrase              as character no-undo .
      194     def var v-special-char            as character no-undo .
      195     if p-encode-char = ?
      196     or p-encode-char = "" then do:
      197       assign
      198         p-encode-char = "~~"
      199       .
      200     end.
      201     if p-init-string = "?" then do:
      202       return ? .
      203     end.
      204     assign
      205       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      206     .
      207     if v-num-entries-init-string > 1 then do:
      208       assign
      209         p-decode-string = entry(1, p-init-string, p-encode-char)
      210       .
      211       do ind = 2 to v-num-entries-init-string
      212       :
      213         assign
      214           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      215         .
      216         assign
      217           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      218         .
      219         if v-special-char <> ? then do:
      220           assign
      221             p-decode-string = p-decode-string
      222                             + v-special-char
      223                             + substring(v-sub-phrase, 4)
      224           .
      225         end.
      226         else do:
      227           assign
      228             p-decode-string = p-decode-string
      229                             + p-encode-char
      230                             + v-sub-phrase
      231           .
      232         end.
      233       end.
      234     end.
      235     else do:
      236       assign
      237         p-decode-string = p-init-string
      238       .
      239     end.
      240     return p-decode-string .
      241   end.
      242   define input  parameter parparentproc      as   handle              no-undo.
      243   define input  parameter parcallback        as   handle              no-undo.
      244   define input  parameter pardoc-code        like ub.trn-doc.doc-code no-undo.
      245   define input  parameter parold-supp-cntr   as   logical             no-undo.
      246   define input  parameter parpstunqtn-log    as   logical             no-undo.
      247   define input  parameter parpstunit         as   logical             no-undo.
      248   define input  parameter parmxpcicp-dec     as   decimal             no-undo.
      249   define input  parameter parmxpcdcp-dec     as   decimal             no-undo.
      250   define input  parameter parmxsmicp-dec     as   decimal             no-undo.
      251   define input  parameter parmxsmdcp-dec     as   decimal             no-undo.
      252   define input  parameter parrec-minus-line  as   recid               no-undo.
      253   define input  parameter parrec-plus-line   as   recid               no-undo.
      254   define output parameter parchg             as   logical initial no  no-undo.
      255   define buffer bf_trn-doc           for ub.trn-doc.
      256   define buffer bf-chg_goods         for ub.goods.
      257   define buffer bf-chg-plus_goods    for ub.goods.
      258   define buffer bf-chg_doc-line      for ub.doc-line.
      259   define buffer bf-chg-plus_doc-line for ub.doc-line.
      260   define buffer bf_parts-root        for ub.parts-root.
      261   define buffer bf-plus_parts        for ub.parts.
      262   define buffer bf_parts             for ub.parts.
      263   define buffer bf_gds-prt           for ub.gds-prt.
      264   define buffer bf-plus_gds-prt      for ub.gds-prt.
      265   define buffer bf-chg_doc-pl        for ub.doc-pl.
      266   define buffer bf-chg-plus_doc-pl   for ub.doc-pl.
      267   define buffer bf-chg_gds-dtl       for ub.gds-dtl.
      268   define buffer bf-chg-plus_gds-dtl  for ub.gds-dtl.
      269   define buffer bf-chg_parts         for ub.parts.
      270   define buffer bf-chg-plus_parts    for ub.parts.
      271   define buffer bf-all_parts-root    for ub.parts-root.
      272   define buffer bf-all-plus_parts    for ub.parts.
      273   define variable varqnty             as decimal no-undo.
      274   define variable varqnty-plus        as decimal no-undo.
      275   define variable varqnty-kg          as decimal no-undo.
      276   define variable varqnty-kg-plus     as decimal no-undo.
      277   define variable varis-petrol        as logical no-undo.
      278   define variable varis-pieces        as logical no-undo.
      279   define variable varis-petrol-plus   as logical no-undo.
      280   define variable varis-pieces-plus   as logical no-undo.
      281   define variable varoutgds-code      as integer no-undo.
      282   define variable varoutgds-code-plus as integer no-undo.
      283   define variable varoutqnty          as decimal no-undo.
      284   define variable varoutqnty-plus     as decimal no-undo.
      285   define variable varoutqnty-kg       as decimal no-undo.
      286   define variable varoutqnty-kg-plus  as decimal no-undo.
      287   define variable varhave-chg         as logical no-undo.
      288   define variable vareq               as logical no-undo.
      289   define variable vartotal-chg-qnty         as decimal no-undo.
      290   define variable vartotal-chg-qnty-plus    as decimal no-undo.
      291   define variable vartotal-chg-qnty-kg      as decimal no-undo.
      292   define variable vartotal-chg-qnty-plus-kg as decimal no-undo.
      293   define variable varkoeff                  as decimal no-undo.
      294   define variable varqnty-check             as decimal no-undo.
      295   define variable varqnty-check-plus        as decimal no-undo.
      296   define variable varqnty-check-pl          as decimal no-undo.
      297   define variable varqnty-check-pl-plus     as decimal no-undo.
      298   define variable varqnty-check-pl-kg       as decimal no-undo.
      299   define variable varqnty-check-pl-kg-plus  as decimal no-undo.
      300   define variable varchg-qnty               as decimal no-undo.
      301   define variable varmem-qnty               as decimal no-undo.
      302   define variable varrsrv-qnty              as decimal no-undo.
      303   define variable vardel-qnty               as decimal no-undo.
      304   define variable varreal-del-qnty          as decimal no-undo.
      305   define variable varparts-qnty             as decimal no-undo.
      306   define variable varcorrect-qnty             as decimal no-undo.
      307   define variable varqnty-parts             as integer no-undo.
      308   define variable vartotal-rsrv-qnty-parts  like ub.parts.fact-qnty  no-undo.
      309   define variable varcorrect                as   logical             no-undo.
      310   define variable varcorrect-many           as   logical             no-undo initial no .
      311   define variable varqnty-pieces            as   decimal             no-undo.
      312   define variable varpices-varkoeff         as   decimal             no-undo.
      313   define variable Loc-cr-varkoeff           as   decimal             no-undo.
      314   define variable varoutqnty-plus-temp      as   decimal             no-undo.
      315   define variable varoutqnty-temp           as   decimal             no-undo.
      316   define temp-table tt-parts            no-undo like ub.parts.
      317   define temp-table tt-mem-gds-dtl      no-undo like tt-gds-dtl.
      318   define temp-table tt-mem-gds-dtl-plus no-undo like tt-gds-dtl-plus.
      319   define temp-table tt-mem-pl-qty       no-undo like tt-pl-qty.
      320   define temp-table tt-mem-pl-qty-plus  no-undo like tt-pl-qty-plus.
      321   define temp-table tt-chg-gds-dtl      no-undo like tt-gds-dtl.
      322   define temp-table tt-chg-gds-dtl-plus no-undo like tt-gds-dtl-plus.
      323   define temp-table tt-chg-pl-qty       no-undo like tt-pl-qty.
      324   define temp-table tt-chg-pl-qty-plus  no-undo like tt-pl-qty-plus.
      325   do on error undo, return error return-value :
      326   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code.
      327   find first bf-chg_doc-line where recid (bf-chg_doc-line)      = parrec-minus-line.
      328   find first bf-chg_goods    where bf-chg_goods.artic     = bf-chg_doc-line.artic     and
      329                                    bf-chg_goods.prod-type = bf-chg_doc-line.prod-type and
      330                                    bf-chg_goods.prod-code = bf-chg_doc-line.prod-code .
      331   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      332     (
      333        input bf-chg_goods.artic
      334     ,  input bf-chg_goods.prod-type
      335     ,  input bf-chg_goods.prod-code
      336     , output varis-petrol
      337     , output varis-pieces
      338     ) .
      339   if varis-petrol     and
      340      not varis-pieces then do:
      341     return error substitute ("Товар &1 &2 &3 &4 - топливо. Топливо не обрабатывается в процедуре на изменение.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name).
      342   end.
      343   find first bf-chg-plus_doc-line where recid (bf-chg-plus_doc-line) = parrec-plus-line.
      344   find first bf-chg-plus_goods    where bf-chg-plus_goods.artic     = bf-chg-plus_doc-line.artic     and
      345                                         bf-chg-plus_goods.prod-type = bf-chg-plus_doc-line.prod-type and
      346                                         bf-chg-plus_goods.prod-code = bf-chg-plus_doc-line.prod-code .
      347   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      348     (
      349        input bf-chg-plus_goods.artic
      350     ,  input bf-chg-plus_goods.prod-type
      351     ,  input bf-chg-plus_goods.prod-code
      352     , output varis-petrol-plus
      353     , output varis-pieces-plus
      354     ) .
      355   if varis-petrol-plus     and
      356      not varis-pieces-plus then do:
      357     return error substitute ("Товар &1 &2 &3 &4 - топливо. Топливо не обрабатывается в процедуре на изменение.", bf-chg-plus_goods.artic, bf-chg-plus_goods.prod-type, bf-chg-plus_goods.prod-code, bf-chg-plus_goods.gds-name).
      358   end.
      359   find first bf_gds-prt      where bf_gds-prt.upper-code      = bf-chg_goods.prt-root      no-lock.
      360   find first bf-plus_gds-prt where bf-plus_gds-prt.upper-code = bf-chg-plus_goods.prt-root no-lock.
      361   for each tt-gds-dtl on error undo, return error return-value :
      362     delete tt-gds-dtl.
      363   end.
      364   for each tt-gds-dtl-plus on error undo, return error return-value :
      365     delete tt-gds-dtl-plus.
      366   end.
      367   for each bf_parts-root where bf_parts-root.doc-code      = bf_trn-doc.doc-code        and
      368                                bf_parts-root.orig-gds-code = bf-chg_goods.gds-code      and
      369                                bf_parts-root.gds-code      = bf-chg-plus_goods.gds-code use-index pi on error undo, return error return-value :
      370     find first bf-plus_parts where bf-plus_parts.obj-type  = bf_trn-doc.obj-type          and
      371                                    bf-plus_parts.obj-code  = bf_trn-doc.obj-code          and
      372                                    bf-plus_parts.artic     = bf-chg-plus_goods.artic      and
      373                                    bf-plus_parts.prod-type = bf-chg-plus_goods.prod-type  and
      374                                    bf-plus_parts.prod-code = bf-chg-plus_goods.prod-code  and
      375                                    bf-plus_parts.in-code   = bf_parts-root.in-code        and
      376                                    bf-plus_parts.out-code  = bf_parts-root.doc-code       and
      377                                    bf-plus_parts.part-code = bf_parts-root.part-code  .
      378     find first bf_parts where bf_parts.obj-type  = bf_trn-doc.obj-type          and
      379                               bf_parts.obj-code  = bf_trn-doc.obj-code          and
      380                               bf_parts.artic     = bf-chg_goods.artic           and
      381                               bf_parts.prod-type = bf-chg_goods.prod-type       and
      382                               bf_parts.prod-code = bf-chg_goods.prod-code       and
      383                               bf_parts.in-code   = bf_parts-root.orig-in-code   and
      384                               bf_parts.out-code  = bf_parts-root.doc-code       and
      385                               bf_parts.part-code = bf_parts-root.orig-part-code .
      386     assign
      387       varqnty      = varqnty      + bf-plus_parts.real-qnty
      388       varqnty-plus = varqnty-plus + bf-plus_parts.fact-qnty.
      389   end.
      390   for each bf-chg_gds-dtl where bf-chg_gds-dtl.doc-code  = bf_trn-doc.doc-code    and
      391                                 bf-chg_gds-dtl.artic     = bf-chg_goods.artic     and
      392                                 bf-chg_gds-dtl.prod-type = bf-chg_goods.prod-type and
      393                                 bf-chg_gds-dtl.prod-code = bf-chg_goods.prod-code on error undo, return error return-value :
      394     create tt-mem-gds-dtl.
      395     assign
      396       tt-mem-gds-dtl.gds-code = bf-chg_goods.gds-code
      397       tt-mem-gds-dtl.prt-code = bf-chg_gds-dtl.prt-code
      398       tt-mem-gds-dtl.qnty     = - bf-chg_gds-dtl.doc-qnty.
      399   end.
      400   for each bf-chg-plus_gds-dtl where bf-chg-plus_gds-dtl.doc-code  = bf_trn-doc.doc-code         and
      401                                      bf-chg-plus_gds-dtl.artic     = bf-chg-plus_goods.artic     and
      402                                      bf-chg-plus_gds-dtl.prod-type = bf-chg-plus_goods.prod-type and
      403                                      bf-chg-plus_gds-dtl.prod-code = bf-chg-plus_goods.prod-code on error undo, return error return-value :
      404     create tt-mem-gds-dtl-plus.
      405     assign
      406       tt-mem-gds-dtl-plus.gds-code = bf-chg-plus_goods.gds-code
      407       tt-mem-gds-dtl-plus.prt-code = bf-chg-plus_gds-dtl.prt-code
      408       tt-mem-gds-dtl-plus.qnty     = bf-chg-plus_gds-dtl.doc-qnty.
      409   end.
      410   run str/prst-gds.w (input  parparentproc,
      411                   input  bf_trn-doc.doc-code,
      412                   input  'ИЗМЕНЕНИЕ':U,
      413                   input  bf_trn-doc.obj-type,
      414                   input  bf_trn-doc.obj-code,
      415                   input  bf-chg_goods.gds-code,
      416                   input  bf-chg-plus_goods.gds-code,
      417                   input  varqnty,
      418                   input  ?,
      419                   input  varqnty-plus,
      420                   input  ?,
      421                   input  parpstunqtn-log,
      422                   input  parpstunit,
      423                   input  parmxpcicp-dec,
      424                   input  parmxpcdcp-dec,
      425                   input  parmxsmicp-dec,
      426                   input  parmxsmdcp-dec,
      427                   output varoutgds-code,
      428                   output varoutgds-code-plus,
      429                   output table tt-gds-dtl,
      430                   output table tt-pl-qty,
      431                   output varoutqnty,
      432                   output varoutqnty-plus,
      433                   output varoutqnty-kg,
      434                   output varoutqnty-kg-plus,
      435                   output table tt-gds-dtl-plus,
      436                   output table tt-pl-qty-plus,
      437                   output varhave-chg) no-error.
      438   if varhave-chg = yes then do:
      439     if not (varoutqnty > 0)  then do:
      440       undo, return error substitute ("Неверно задано количество по списываемому товару: &1.", varoutqnty).
      441     end.
      442     if not (varoutqnty-plus > 0)  then do:
      443       undo, return error substitute ("Неверно задано количество по оприходуемому товару: &1.", varoutqnty-plus).
      444     end.
      445     if varqnty      = varoutqnty      and
      446        varqnty-plus = varoutqnty-plus then do:
      447        assign
      448          vareq = yes.
      449     end.
      450     else do:
      451       assign
      452         vareq = no.
      453     end.
      454     for each tt-gds-dtl on error undo, return error return-value :
      455       find first tt-mem-gds-dtl where tt-mem-gds-dtl.gds-code = tt-gds-dtl.gds-code and
      456                                       tt-mem-gds-dtl.prt-code = tt-gds-dtl.prt-code no-error.
      457       if not available tt-mem-gds-dtl then do:
      458         assign
      459           vareq = no.
      460         create tt-chg-gds-dtl.
      461         buffer-copy tt-gds-dtl to tt-chg-gds-dtl.
      462       end.
      463       else do:
      464         if tt-mem-gds-dtl.qnty <> tt-gds-dtl.qnty then do:
      465           assign
      466             vareq = no.
      467           create tt-chg-gds-dtl.
      468           buffer-copy tt-gds-dtl except qnty to tt-chg-gds-dtl.
      469           assign
      470             tt-chg-gds-dtl.qnty = tt-gds-dtl.qnty - tt-mem-gds-dtl.qnty .
      471         end.
      472       end.
      473     end.
      474     for each tt-mem-gds-dtl on error undo, return error return-value :
      475       find first tt-gds-dtl where tt-gds-dtl.gds-code = tt-mem-gds-dtl.gds-code and
      476                                   tt-gds-dtl.prt-code = tt-mem-gds-dtl.prt-code no-error.
      477       if not available tt-gds-dtl then do:
      478         assign
      479           vareq = no.
      480         create tt-chg-gds-dtl.
      481         buffer-copy tt-mem-gds-dtl except qnty to tt-chg-gds-dtl.
      482         assign
      483           tt-chg-gds-dtl.qnty = - tt-mem-gds-dtl.qnty.
      484       end.
      485     end.
      486     for each tt-gds-dtl-plus on error undo, return error return-value :
      487       find first tt-mem-gds-dtl-plus where tt-mem-gds-dtl-plus.gds-code = tt-gds-dtl-plus.gds-code and
      488                                            tt-mem-gds-dtl-plus.prt-code = tt-gds-dtl-plus.prt-code no-error.
      489       if not available tt-mem-gds-dtl-plus then do:
      490         assign
      491           vareq = no.
      492         create tt-chg-gds-dtl-plus.
      493         buffer-copy tt-gds-dtl-plus to tt-chg-gds-dtl-plus.
      494       end.
      495       else do:
      496         if tt-mem-gds-dtl-plus.qnty <> tt-gds-dtl-plus.qnty then do:
      497           assign
      498             vareq = no.
      499           create tt-chg-gds-dtl-plus.
      500           buffer-copy tt-gds-dtl-plus except qnty to tt-chg-gds-dtl-plus.
      501           assign
      502             tt-chg-gds-dtl-plus.qnty = tt-gds-dtl-plus.qnty - tt-mem-gds-dtl-plus.qnty .
      503         end.
      504       end.
      505     end.
      506     for each tt-mem-gds-dtl-plus on error undo, return error return-value :
      507       find first tt-gds-dtl-plus where tt-gds-dtl-plus.gds-code = tt-mem-gds-dtl-plus.gds-code and
      508                                        tt-gds-dtl-plus.prt-code = tt-mem-gds-dtl-plus.prt-code no-error.
      509       if not available tt-gds-dtl-plus then do:
      510         assign
      511           vareq = no.
      512         create tt-chg-gds-dtl-plus.
      513         buffer-copy tt-mem-gds-dtl-plus except qnty to tt-chg-gds-dtl-plus.
      514         assign
      515           tt-chg-gds-dtl-plus.qnty = - tt-mem-gds-dtl-plus.qnty.
      516       end.
      517     end.
      518     if vareq = yes then do:
      519       message "Не было изменений по списанным и оприходованным товарам." view-as alert-box information.
      520       return.
      521     end.
      522     assign
      523       parchg = yes.
      524     assign
      525       varkoeff                  = varoutqnty-plus / varoutqnty
      526       vartotal-chg-qnty         = varoutqnty         - varqnty
      527       vartotal-chg-qnty-plus    = varoutqnty-plus    - varqnty-plus
      528       vartotal-chg-qnty-kg      = varoutqnty-kg      - varqnty-kg
      529       vartotal-chg-qnty-plus-kg = varoutqnty-kg-plus - varqnty-kg-plus
      530       varoutqnty-plus-temp = varoutqnty-plus
      531       varoutqnty-temp = varoutqnty
      532     .
      533     assign
      534       varqnty-check            = 0.00
      535       varqnty-check-plus       = 0.00
      536       varqnty-check-pl         = 0.00
      537       varqnty-check-pl-plus    = 0.00
      538       varqnty-check-pl-kg      = 0.00
      539       varqnty-check-pl-kg-plus = 0.00
      540       .
      541     for each tt-gds-dtl on error undo, return error return-value :
      542       if tt-gds-dtl.gds-code <> bf-chg_goods.gds-code then do:
      543         undo, return error substitute ("Критическая ошибка. В признаках для списания товара указан товар с внутренним кодом: &1. Товар для списания с внутренним кодом: &2", tt-gds-dtl.gds-code, bf-chg_goods.gds-code).
      544       end.
      545     end.
      546     for each tt-chg-gds-dtl on error undo, return error return-value :
      547       assign
      548         varqnty-check = varqnty-check + tt-chg-gds-dtl.qnty.
      549     end.
      550     for each tt-gds-dtl-plus on error undo, return error return-value :
      551       if tt-gds-dtl-plus.gds-code <> bf-chg-plus_goods.gds-code then do:
      552         undo, return error substitute ("Критическая ошибка. В признаках для оприходования товара указан товар с внутренним кодом: &1. Товар для оприходования с внутренним кодом: &2.", tt-gds-dtl-plus.gds-code, bf-chg-plus_goods.gds-code).
      553       end.
      554     end.
      555     for each tt-chg-gds-dtl-plus on error undo, return error return-value :
      556       assign
      557         varqnty-check-plus = varqnty-check-plus + tt-chg-gds-dtl-plus.qnty.
      558     end.
      559     if varoutqnty - varqnty <> varqnty-check then do:
      560       undo, return error substitute ("Ошибка в количестве по списываемому товару: &1 &2 &3 &4. Количество для списания: &5. Количество для списания по признакам: &6.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, varoutqnty - varqnty, varqnty-check) .
      561     end.
      562     if varoutqnty-plus - varqnty-plus <> varqnty-check-plus then do:
      563       undo, return error substitute("Ошибка в количестве по оприходоваемому товару: &1 &2 &3 &4. Количество для оприходования: &5. Количество для приходования по признакам: &6.", bf-chg-plus_goods.artic, bf-chg-plus_goods.prod-type, bf-chg-plus_goods.prod-code, bf-chg-plus_goods.gds-name, varoutqnty-plus - varqnty-plus, varqnty-check-plus).
      564     end.
      565     run local-recalc in parcallback (input "old":u,
      566                                      input recid(bf-chg_doc-line),
      567                                      input yes) no-error.
      568     if error-status:error then do:
      569       undo, return error substitute ("Ошибка при пересчете строки документа: ", return-value).
      570     end.
      571     for each tt-parts on error undo, return error return-value :
      572       delete tt-parts.
      573     end.
      574     for each bf-chg_parts where bf-chg_parts.out-code   = bf_trn-doc.doc-code    and
      575                                 bf-chg_parts.obj-type   = bf_trn-doc.obj-type    and
      576                                 bf-chg_parts.obj-code   = bf_trn-doc.obj-code    and
      577                                 bf-chg_parts.artic      = bf-chg_goods.artic     and
      578                                 bf-chg_parts.prod-type  = bf-chg_goods.prod-type and
      579                                 bf-chg_parts.prod-code  = bf-chg_goods.prod-code and
      580                                 bf-chg_parts.fact-qnty  < 0                      on error undo, return error return-value :
      581       create tt-parts.
      582       buffer-copy bf-chg_parts to tt-parts.
      583     end.
      584     find first bf-chg_gds-dtl where bf-chg_gds-dtl.doc-code  = bf_trn-doc.doc-code    and
      585                                     bf-chg_gds-dtl.artic     = bf-chg_goods.artic     and
      586                                     bf-chg_gds-dtl.prod-type = bf-chg_goods.prod-type and
      587                                     bf-chg_gds-dtl.prod-code = bf-chg_goods.prod-code .
      588     if vartotal-chg-qnty > 0 then do:
      589       assign
      590         varchg-qnty = - vartotal-chg-qnty
      591         varmem-qnty = varchg-qnty.
      592       run trg/rsrv-dtl.p (input parparentproc,
      593                       'reserv':U + ',' + 'negative-check':U + "=2",
      594                       buffer bf-chg_gds-dtl,
      595                       input-output varchg-qnty,
      596                       input-output bf-chg_doc-line.price-base,
      597                       input-output bf-chg_doc-line.price-rubl,
      598                       -1, "") no-error.
      599       if error-status:error then do:
      600         undo, return error substitute ("Ошибка при резервировании по товару &1 &2 &3 &4: &5.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, return-value).
      601       end.
      602       if varmem-qnty <> varchg-qnty then do:
      603         undo, return error substitute("Не все количество было зарезервировано по товару: &1 &2 &3 &4. Количество для резервирования: &5. Зарезервированное количество: &6.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, varmem-qnty, varchg-qnty).
      604       end.
      605     end.
      606     else do:
      607       if vartotal-chg-qnty < 0 then do:
      608         assign
      609           varchg-qnty = - vartotal-chg-qnty.
      610         rsrv-parts-root:
      611         for each bf_parts-root where bf_parts-root.doc-code      = bf_trn-doc.doc-code        and
      612                                      bf_parts-root.orig-gds-code = bf-chg_goods.gds-code      and
      613                                      bf_parts-root.gds-code      = bf-chg-plus_goods.gds-code ,
      614            first bf-chg_parts where bf-chg_parts.obj-type  = bf_trn-doc.obj-type          and
      615                                     bf-chg_parts.obj-code  = bf_trn-doc.obj-code          and
      616                                     bf-chg_parts.artic     = bf-chg_goods.artic           and
      617                                     bf-chg_parts.prod-type = bf-chg_goods.prod-type       and
      618                                     bf-chg_parts.prod-code = bf-chg_goods.prod-code       and
      619                                     bf-chg_parts.in-code   = bf_parts-root.orig-in-code   and
      620                                     bf-chg_parts.out-code  = bf_trn-doc.doc-code          and
      621                                     bf-chg_parts.part-code = bf_parts-root.orig-part-code and
      622                                     bf-chg_parts.fact-qnty < 0                            on error undo, return error return-value :
      623           if - bf-chg_parts.fact-qnty >= varchg-qnty then do:
      624             assign
      625               varrsrv-qnty = varchg-qnty
      626               varmem-qnty  = varrsrv-qnty.
      627             run trg/rsrv-dtl.p (input parparentproc,
      628                            'reserv':U
      629                            + "," + 'rsrv-single-part':U
      630                            + "," + 'rsrv-in-code':U   + "=" + str-encode(bf-chg_parts.in-code, "", ",=":u)
      631                            + "," + 'rsrv-part-code':U + "=" + str-encode(bf-chg_parts.part-code, "", ",=":u)
      632                            + ',' + 'negative-check':U + "=2",
      633                             buffer bf-chg_gds-dtl,
      634                             input-output varrsrv-qnty,
      635                             input-output bf-chg_doc-line.price-base,
      636                             input-output bf-chg_doc-line.price-rubl,
      637                            -1, "") no-error.
      638             if error-status:error then do:
      639               undo, return error substitute ("Ошибка при резервировании по товару &1 &2 &3 &4: &5.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, return-value).
      640             end.
      641             if varmem-qnty <> varrsrv-qnty then do:
      642               undo, return error substitute("Не все количество было зарезервировано по товару: &1 &2 &3 &4. Количество для резервирования: &5. Зарезервированное количество: &6.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, varmem-qnty, varrsrv-qnty).
      643             end.
      644             assign
      645               varchg-qnty        = 0.
      646             if available bf-chg_parts and
      647                bf-chg_parts.qnty = 0 then do:
      648                delete bf-chg_parts.
      649             end.
      650             leave rsrv-parts-root.
      651           end.
      652           else do:
      653             assign
      654               varrsrv-qnty = - bf-chg_parts.fact-qnty
      655               varmem-qnty  = varrsrv-qnty
      656               varchg-qnty  = varchg-qnty + bf-chg_parts.fact-qnty.
      657             run trg/rsrv-dtl.p (input parparentproc,
      658                            'reserv':U
      659                            + "," + 'rsrv-single-part':U
      660                            + "," + 'rsrv-in-code':U   + "=" + str-encode(bf-chg_parts.in-code, "", ",=":u)
      661                            + "," + 'rsrv-part-code':U + "=" + str-encode(bf-chg_parts.part-code, "", ",=":u)
      662                            + ',' + 'negative-check':U + "=2",
      663                             buffer bf-chg_gds-dtl,
      664                             input-output varrsrv-qnty,
      665                             input-output bf-chg_doc-line.price-base,
      666                             input-output bf-chg_doc-line.price-rubl,
      667                            -1, "") no-error.
      668             if error-status:error then do:
      669               undo, return error substitute ("Ошибка при резервировании по товару &1 &2 &3 &4: &5.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, return-value).
      670             end.
      671             if varmem-qnty <> varrsrv-qnty then do:
      672               undo, return error substitute("Не все количество было зарезервировано по товару: &1 &2 &3 &4. Количество для резервирования: &5. Зарезервированное количество: &6.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, varmem-qnty, varrsrv-qnty).
      673             end.
      674           end.
      675         end.
      676       end.
      677       if varchg-qnty <> 0 then do:
      678         return error substitute ("Не удалось изменить списанное количество по товару &1 &2 &3 &4. Запрос на резерв &5. Недорезервировано &6.",
      679                                  bf-chg_goods.artic,
      680                                  bf-chg_goods.prod-type,
      681                                  bf-chg_goods.prod-code,
      682                                  bf-chg_goods.gds-name,
      683                                  varmem-qnty,
      684                                  varchg-qnty).
      685       end.
      686     end.
      687     assign
      688       bf-chg_doc-line.fact-qnty      = bf-chg_doc-line.fact-qnty     - (varoutqnty    - varqnty)
      689       bf-chg_doc-line.cli-qnty       = bf-chg_doc-line.cli-qnty      - (varoutqnty-kg - varqnty-kg)
      690     .
      691     for each tt-chg-gds-dtl on error undo, return error return-value :
      692       find first bf-chg_gds-dtl where bf-chg_gds-dtl.doc-code  = bf_trn-doc.doc-code      and
      693                                       bf-chg_gds-dtl.artic     = bf-chg_goods.artic       and
      694                                       bf-chg_gds-dtl.prod-type = bf-chg_goods.prod-type   and
      695                                       bf-chg_gds-dtl.prod-code = bf-chg_goods.prod-code   and
      696                                       bf-chg_gds-dtl.prt-code  = tt-chg-gds-dtl.prt-code  no-error.
      697       if not available bf-chg_gds-dtl then do:
      698   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
      699     ( input bf_trn-doc.obj-code
      700      ,input bf_trn-doc.obj-type
      701      ,input bf_trn-doc.doc-code
      702      ,input bf-chg_goods.artic
      703      ,input bf-chg_goods.prod-code
      704      ,input bf-chg_goods.prod-type
      705      ,input tt-chg-gds-dtl.prt-code
      706      ,input yes
      707     ) no-error .
      708   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
      710     ( input recid(bf-chg_gds-dtl)
      711     , input no
      712     , input ?
      713     ) no-error.
      714         if error-status:error then do:
      715           undo, return error substitute ("Ошибка при установке цены признака товара: &1 &2 &3 &4 &5 на объекте: &6 &7.", bf-chg_goods.artic, bf-chg_goods.prod-type, bf-chg_goods.prod-code, bf-chg_goods.gds-name, tt-chg-gds-dtl.prt-code, bf_trn-doc.obj-type, bf_trn-doc.obj-code).
      716         end.
      717       end.
      718       assign
      719         bf-chg_gds-dtl.doc-qnty = bf-chg_gds-dtl.doc-qnty - tt-chg-gds-dtl.qnty .
      720     end.
      721     run local-recalc in parcallback (input "update":u,
      722                                      input recid(bf-chg_doc-line),
      723                                      input yes) no-error.
      724     if error-status:error then do:
      725       undo, return error substitute ("Ошибка при пересчете строки документа: ", return-value).
      726     end.
      727     run local-recalc in parcallback (input "old":u,
      728                                      input recid(bf-chg-plus_doc-line),
      729                                      input no) no-error.
      730     if error-status:error then do:
      731       undo, return error substitute ("Ошибка при пересчете строки документа: ", return-value).
      732     end.
      733     if vartotal-chg-qnty > 0 then do:
      734       for each bf-chg_parts where bf-chg_parts.out-code   = bf_trn-doc.doc-code    and
      735                                   bf-chg_parts.obj-type   = bf_trn-doc.obj-type    and
      736                                   bf-chg_parts.obj-code   = bf_trn-doc.obj-code    and
      737                                   bf-chg_parts.artic      = bf-chg_goods.artic     and
      738                                   bf-chg_parts.prod-type  = bf-chg_goods.prod-type and
      739                                   bf-chg_parts.prod-code  = bf-chg_goods.prod-code and
      740                                   bf-chg_parts.fact-qnty  < 0                      on error undo, return error return-value :
      741         find first tt-parts where tt-parts.obj-type  = bf-chg_parts.obj-type  and
      742                                   tt-parts.obj-code  = bf-chg_parts.obj-code  and
      743                                   tt-parts.artic     = bf-chg_parts.artic     and
      744                                   tt-parts.prod-type = bf-chg_parts.prod-type and
      745                                   tt-parts.prod-code = bf-chg_parts.prod-code and
      746                                   tt-parts.in-code   = bf-chg_parts.in-code   and
      747                                   tt-parts.out-code  = bf-chg_parts.out-code  and
      748                                   tt-parts.part-code = bf-chg_parts.part-code  no-error.
      749         if not available tt-parts then do:
      750           run local-create-parts in this-procedure
      751             (input 0,
      752              input 0,
      753              input 0,
      754              input 0,
      755              input 0,
      756              input 0,
      757              (if parold-supp-cntr then bf-chg_parts.supp-type     else bf_trn-doc.cli-type),
      758              (if parold-supp-cntr then bf-chg_parts.supp-code     else bf_trn-doc.cli-code),
      759              (if parold-supp-cntr then bf-chg_parts.contract-code else bf_trn-doc.contract-code)
      760             ) no-error.
      761           if error-status :error then do:
      762             undo, return error substitute ("Ошибка при создании партии: &1", return-value).
      763           end.
      764         end.
      765       end.
      766     end.
      767     else do:
      768       for each tt-parts on error undo, return error return-value :
      769         find first bf-chg_parts where bf-chg_parts.obj-type  = tt-parts.obj-type   and
      770                                       bf-chg_parts.obj-code  = tt-parts.obj-code   and
      771                                       bf-chg_parts.artic     = tt-parts.artic      and
      772                                       bf-chg_parts.prod-type = tt-parts.prod-type  and
      773                                       bf-chg_parts.prod-code = tt-parts.prod-code  and
      774                                       bf-chg_parts.in-code   = tt-parts.in-code    and
      775                                       bf-chg_parts.out-code  = tt-parts.out-code   and
      776                                       bf-chg_parts.part-code = tt-parts.part-code  no-error.
      777         if not available bf-chg_parts then do:
      778           assign
      779             vardel-qnty      = tt-parts.fact-qnty
      780             varreal-del-qnty = 0.
      781           for each bf_parts-root where bf_parts-root.doc-code       = bf_trn-doc.doc-code   and
      782                                        bf_parts-root.orig-in-code   = tt-parts.in-code      and
      783                                        bf_parts-root.orig-gds-code  = bf-chg_goods.gds-code and
      784                                        bf_parts-root.orig-part-code = tt-parts.part-code    ,
      785             first bf-chg-plus_parts where bf-chg-plus_parts.obj-type  = bf_trn-doc.obj-type         and
      786                                           bf-chg-plus_parts.obj-code  = bf_trn-doc.obj-code         and
      787                                           bf-chg-plus_parts.artic     = bf-chg-plus_goods.artic     and
      788                                           bf-chg-plus_parts.prod-type = bf-chg-plus_goods.prod-type and
      789                                           bf-chg-plus_parts.prod-code = bf-chg-plus_goods.prod-code and
      790                                           bf-chg-plus_parts.in-code   = bf_parts-root.in-code       and
      791                                           bf-chg-plus_parts.out-code  = bf_trn-doc.doc-code         and
      792                                           bf-chg-plus_parts.part-code = bf_parts-root.part-code     on error undo, return error return-value :
      793             assign
      794               varreal-del-qnty = varreal-del-qnty + bf-chg-plus_parts.real-qnty.
      795             delete bf-chg-plus_parts.
      796             delete bf_parts-root.
      797           end.
      798           if - vardel-qnty <> varreal-del-qnty then do:
      799             return error substitute ("При удалении партий оприходованного товара по удаляемым партиям списанного товара не удалось удалить должное количество партий. Удалялась списываемая партия (пн &1 код &2) с количеством &3. Партии оприходуемого товара покрывают списываемое количество &4", tt-parts.in-code, tt-parts.part-code, vardel-qnty, varreal-del-qnty).
      800           end.
      801         end.
      802       end.
      803     end.
      804     assign
      805       vartotal-rsrv-qnty-parts = 0.00
      806       varpices-varkoeff = varkoeff
      807     .
      808     for each bf_parts-root where bf_parts-root.doc-code      = bf_trn-doc.doc-code        and
      809                                  bf_parts-root.orig-gds-code = bf-chg_goods.gds-code      and
      810                                  bf_parts-root.gds-code      = bf-chg-plus_goods.gds-code on error undo, return error return-value :
      811       find first bf-chg_parts where bf-chg_parts.obj-type  = bf_trn-doc.obj-type          and
      812                                     bf-chg_parts.obj-code  = bf_trn-doc.obj-code          and
      813                                     bf-chg_parts.artic     = bf-chg_goods.artic           and
      814                                     bf-chg_parts.prod-type = bf-chg_goods.prod-type       and
      815                                     bf-chg_parts.prod-code = bf-chg_goods.prod-code       and
      816                                     bf-chg_parts.in-code   = bf_parts-root.orig-in-code   and
      817                                     bf-chg_parts.out-code  = bf_trn-doc.doc-code          and
      818                                     bf-chg_parts.part-code = bf_parts-root.orig-part-code and
      819                                     bf-chg_parts.fact-qnty < 0                            .
      820       assign
      821         varcorrect-qnty = 0
      822         varqnty-parts = 0.
      823       for each bf-all_parts-root where bf-all_parts-root.doc-code       = bf_trn-doc.doc-code    and
      824                                        bf-all_parts-root.orig-in-code   = bf-chg_parts.in-code   and
      825                                        bf-all_parts-root.orig-gds-code  = bf-chg_goods.gds-code  and
      826                                        bf-all_parts-root.orig-part-code = bf-chg_parts.part-code on error undo, return error :
      827         if bf-all_parts-root.gds-code <> bf-chg-plus_goods.gds-code then do :
      828           find first bf-all-plus_parts where bf-all-plus_parts.obj-type  = bf_trn-doc.obj-type         and
      829                                              bf-all-plus_parts.obj-code  = bf_trn-doc.obj-code         and
      830                                              (bf-all-plus_parts.artic    <> bf-chg-plus_goods.artic     or
      831                                              bf-all-plus_parts.prod-type <> bf-chg-plus_goods.prod-type or
      832                                              bf-all-plus_parts.prod-code <> bf-chg-plus_goods.prod-code) and
      833                                              bf-all-plus_parts.in-code   = bf-all_parts-root.in-code   and
      834                                              bf-all-plus_parts.out-code  = bf_trn-doc.doc-code         and
      835                                              bf-all-plus_parts.part-code = bf-all_parts-root.part-code no-error.
      836           if available bf-all-plus_parts then do :
      837               assign
      838                   varcorrect-qnty = varcorrect-qnty + bf-all-plus_parts.fact-qnty
      839                   varcorrect-many = yes
      840               .
      841           end.
      842         end.
      843         else assign
      844           varqnty-parts = varqnty-parts + 1.
      845         if varqnty-parts > 1 and bf-all_parts-root.gds-code = bf-chg-plus_goods.gds-code then do:
      846           find first bf-all-plus_parts where bf-all-plus_parts.obj-type  = bf_trn-doc.obj-type         and
      847                                              bf-all-plus_parts.obj-code  = bf_trn-doc.obj-code         and
      848                                              bf-all-plus_parts.artic     = bf-chg-plus_goods.artic     and
      849                                              bf-all-plus_parts.prod-type = bf-chg-plus_goods.prod-type and
      850                                              bf-all-plus_parts.prod-code = bf-chg-plus_goods.prod-code and
      851                                              bf-all-plus_parts.in-code   = bf-all_parts-root.in-code   and
      852                                              bf-all-plus_parts.out-code  = bf_trn-doc.doc-code         and
      853                                              bf-all-plus_parts.part-code = bf-all_parts-root.part-code no-error.
      854           delete bf-all-plus_parts no-error.
      855           delete bf-all_parts-root.
      856         end.
      857       end.
      858       find first bf-chg-plus_parts where bf-chg-plus_parts.obj-type  = bf_trn-doc.obj-type         and
      859                                          bf-chg-plus_parts.obj-code  = bf_trn-doc.obj-code         and
      860                                          bf-chg-plus_parts.artic     = bf-chg-plus_goods.artic     and
      861                                          bf-chg-plus_parts.prod-type = bf-chg-plus_goods.prod-type and
      862                                          bf-chg-plus_parts.prod-code = bf-chg-plus_goods.prod-code and
      863                                          bf-chg-plus_parts.in-code   = bf_parts-root.in-code       and
      864                                          bf-chg-plus_parts.out-code  = bf_trn-doc.doc-code         and
      865                                          bf-chg-plus_parts.part-code = bf_parts-root.part-code .
      866       if varis-pieces-plus and not varis-petrol-plus then do:
      867           if varoutqnty = (if available tt-parts then - (bf-chg_parts.fact-qnty - tt-parts.fact-qnty) else - bf-chg_parts.fact-qnty) then varqnty-pieces = varoutqnty-plus.
      868           else  varqnty-pieces = max(1,(if available tt-parts then - truncate((bf-chg_parts.fact-qnty - tt-parts.fact-qnty) * varpices-varkoeff, 0) else - truncate(bf-chg_parts.fact-qnty * varpices-varkoeff, 0))).
      869           Loc-cr-varkoeff =  varqnty-pieces / (if available tt-parts then - (bf-chg_parts.fact-qnty - tt-parts.fact-qnty)  else - bf-chg_parts.fact-qnty).
      870           assign
      871             bf-chg-plus_parts.qnty          = ( - bf-chg_parts.fact-qnty - (if varcorrect-many then varcorrect-qnty else 0)) * Loc-cr-varkoeff
      872             bf-chg-plus_parts.fact-qnty     = bf-chg-plus_parts.qnty
      873             bf-chg-plus_parts.cli-qnty      = bf-chg-plus_parts.qnty
      874             bf-chg-plus_parts.price-cli     = bf-chg_parts.price-rubl / Loc-cr-varkoeff
      875             bf-chg-plus_parts.cli-base-rate = 1
      876             bf-chg-plus_parts.real-qnty     = ( - bf-chg_parts.fact-qnty - (if varcorrect-many then varcorrect-qnty else 0))
      877             bf-chg-plus_parts.price-base    = bf-chg_parts.price-base / Loc-cr-varkoeff
      878             bf-chg-plus_parts.price-rubl    = bf-chg_parts.price-rubl / Loc-cr-varkoeff
      879           .
      880           varoutqnty-plus = varoutqnty-plus - varqnty-pieces.
      881           varoutqnty = varoutqnty - (if available tt-parts then - (bf-chg_parts.fact-qnty - tt-parts.fact-qnty)  else - bf-chg_parts.fact-qnty).
      882           varpices-varkoeff = varoutqnty-plus / varoutqnty.
      883       end.
      884       else do:
      885           assign
      886             bf-chg-plus_parts.qnty          = - bf-chg_parts.fact-qnty * varkoeff
      887             bf-chg-plus_parts.fact-qnty     = bf-chg-plus_parts.qnty
      888             bf-chg-plus_parts.cli-qnty      = bf-chg-plus_parts.qnty
      889             bf-chg-plus_parts.price-cli     = bf-chg_parts.price-rubl / varkoeff
      890             bf-chg-plus_parts.cli-base-rate = 1
      891             bf-chg-plus_parts.real-qnty     = - bf-chg_parts.fact-qnty
      892             bf-chg-plus_parts.price-base    = bf-chg_parts.price-base / varkoeff
      893             bf-chg-plus_parts.price-rubl    = bf-chg_parts.price-rubl / varkoeff
      894           .
      895       end.
      896       assign
      897         vartotal-rsrv-qnty-parts = vartotal-rsrv-qnty-parts + bf-chg-plus_parts.qnty.
      898     end.
      899     assign
      900       bf-chg-plus_doc-line.fact-qnty = bf-chg-plus_doc-line.fact-qnty + (varoutqnty-plus-temp - varqnty-plus)
      901       bf-chg-plus_doc-line.cli-qnty  = bf-chg-plus_doc-line.cli-qnty  + (varoutqnty-kg-plus - varqnty-kg-plus)
      902     .
      903     if vartotal-rsrv-qnty-parts <> bf-chg-plus_doc-line.fact-qnty then do:
      904       if vartotal-rsrv-qnty-parts <> bf-chg-plus_doc-line.fact-qnty then do:
      905         if abs (vartotal-rsrv-qnty-parts - bf-chg-plus_doc-line.fact-qnty) > 0.01 then do:
      906            message "Невозможно зарезервировать данную связку товаров при установленных количествах." skip
      907                    "Зарезервированное количество по партиям:" vartotal-rsrv-qnty-parts skip
      908                    "Зарезервированное количество по строке: " bf-chg-plus_doc-line.fact-qnty
      909            view-as alert-box.
      910            return error.
      911         end.
      912         assign
      913           varcorrect = no.
      914         for each bf_parts-root where bf_parts-root.doc-code      = bf_trn-doc.doc-code        and
      915                                      bf_parts-root.orig-gds-code = bf-chg_goods.gds-code      and
      916                                      bf_parts-root.gds-code      = bf-chg-plus_goods.gds-code,
      917           first bf-chg-plus_parts where bf-chg-plus_parts.out-code   = bf_trn-doc.doc-code         and
      918                                         bf-chg-plus_parts.obj-type   = bf_trn-doc.obj-type         and
      919                                         bf-chg-plus_parts.obj-code   = bf_trn-doc.obj-code         and
      920                                         bf-chg-plus_parts.artic      = bf-chg-plus_goods.artic     and
      921                                         bf-chg-plus_parts.prod-type  = bf-chg-plus_goods.prod-type and
      922                                         bf-chg-plus_parts.prod-code  = bf-chg-plus_goods.prod-code and
      923                                         bf-chg-plus_parts.in-code    = bf_parts-root.in-code       and
      924                                         bf-chg-plus_parts.part-code  = bf_parts-root.part-code     and
      925                                         bf-chg-plus_parts.fact-qnty  > 0                           and
      926                                         bf-chg-plus_parts.fact-qnty  > vartotal-rsrv-qnty-parts - bf-chg-plus_doc-line.fact-qnty :
      927           assign
      928             bf-chg-plus_parts.fact-qnty = bf-chg-plus_parts.fact-qnty - (vartotal-rsrv-qnty-parts - bf-chg-plus_doc-line.fact-qnty)
      929             varcorrect = yes.
      930           leave.
      931         end.
      932         if varcorrect = no then do:
      933            message "Невозможно зарезервировать данную связку товаров при установленных количествах." skip
      934            view-as alert-box.
      935            return error.
      936         end.
      937       end.
      938     end.
      939     for each tt-chg-gds-dtl-plus on error undo, return error return-value :
      940       find first bf-chg-plus_gds-dtl where bf-chg-plus_gds-dtl.doc-code  = bf_trn-doc.doc-code          and
      941                                            bf-chg-plus_gds-dtl.artic     = bf-chg-plus_goods.artic      and
      942                                            bf-chg-plus_gds-dtl.prod-type = bf-chg-plus_goods.prod-type  and
      943                                            bf-chg-plus_gds-dtl.prod-code = bf-chg-plus_goods.prod-code  and
      944                                            bf-chg-plus_gds-dtl.prt-code  = tt-chg-gds-dtl-plus.prt-code no-error.
      945       if not available bf-chg-plus_gds-dtl then do:
      946   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
      947     ( input bf_trn-doc.obj-code
      948      ,input bf_trn-doc.obj-type
      949      ,input bf_trn-doc.doc-code
      950      ,input bf-chg-plus_goods.artic
      951      ,input bf-chg-plus_goods.prod-code
      952      ,input bf-chg-plus_goods.prod-type
      953      ,input tt-chg-gds-dtl-plus.prt-code
      954      ,input yes
      955     ) no-error .
      956   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
      958     ( input recid(bf-chg-plus_gds-dtl)
      959     , input no
      960     , input ?
      961     ) no-error.
      962         if error-status:error then do:
      963           undo, return error substitute ("Ошибка при установке цены признака товара: &1 &2 &3 &4 &5 на объекте: &6 &7.", bf-chg-plus_goods.artic, bf-chg-plus_goods.prod-type, bf-chg-plus_goods.prod-code, bf-chg-plus_goods.gds-name, tt-chg-gds-dtl-plus.prt-code, bf_trn-doc.obj-type, bf_trn-doc.obj-code).
      964         end.
      965       end.
      966       assign
      967         bf-chg-plus_gds-dtl.doc-qnty = bf-chg-plus_gds-dtl.doc-qnty + tt-chg-gds-dtl-plus.qnty .
      968     end.
      969     run local-recalc in parcallback (input "update":u,
      970                                      input recid(bf-chg-plus_doc-line),
      971                                      input no) no-error.
      972     if error-status:error then do:
      973       undo, return error substitute ("Ошибка при пересчете строки документа: ", return-value).
      974     end.
      975   end.
      976   end.
      977   procedure local-create-parts:
      978   define input parameter parqnty          as decimal   no-undo.
      979   define input parameter parcli-qnty      as decimal   no-undo.
      980   define input parameter parprice-cli     as decimal   no-undo.
      981   define input parameter parcli-base-rate as decimal   no-undo.
      982   define input parameter parreal-qnty     as decimal   no-undo.
      983   define input parameter parpl-code       as integer   no-undo.
      984   define input parameter parsupp-type     as character no-undo.
      985   define input parameter parsupp-code     as integer   no-undo.
      986   define input parameter parcontract-code as integer   no-undo.
      987   define buffer bf-chg-cr_parts-root for ub.parts-root.
      988   define buffer bf-chg-plus-cr_parts for ub.parts.
      989   define variable varpart-code as character no-undo.
      990   do on error undo, return error return-value :
      991     run holdprts-get-part-code in parcallback ( input bf_trn-doc.doc-code
      992                                                ,output varpart-code
      993                                               ) no-error .
      994     if error-status:error then do:
      995       undo, return error substitute ("Ошибка при получении кода партии: &1", return-value).
      996     end.
      997     create bf-chg-plus-cr_parts.
      998     assign
      999       bf-chg-plus-cr_parts.prod-type      = bf-chg-plus_goods.prod-type
     1000       bf-chg-plus-cr_parts.prod-code      = bf-chg-plus_goods.prod-code
     1001       bf-chg-plus-cr_parts.artic          = bf-chg-plus_goods.artic
     1002       bf-chg-plus-cr_parts.in-code        = bf_trn-doc.doc-code
     1003       bf-chg-plus-cr_parts.out-code       = bf_trn-doc.doc-code
     1004       bf-chg-plus-cr_parts.price-base     = bf-chg_parts.price-base / varkoeff
     1005       bf-chg-plus-cr_parts.price-rubl     = bf-chg_parts.price-rubl / varkoeff
     1006       bf-chg-plus-cr_parts.obj-type       = bf_trn-doc.obj-type
     1007       bf-chg-plus-cr_parts.obj-code       = bf_trn-doc.obj-code
     1008       bf-chg-plus-cr_parts.VAT-pc         = bf-chg_parts.vat-pc
     1009       bf-chg-plus-cr_parts.part-code      = varpart-code
     1010       bf-chg-plus-cr_parts.PS             = bf-chg_parts.PS
     1011       bf-chg-plus-cr_parts.pay-code       = bf-chg_parts.pay-code
     1012       bf-chg-plus-cr_parts.status_        = no
     1013       bf-chg-plus-cr_parts.supp-type      = parsupp-type
     1014       bf-chg-plus-cr_parts.supp-code      = parsupp-code
     1015       bf-chg-plus-cr_parts.rsrv-free      = ?
     1016       bf-chg-plus-cr_parts.doc-type       = bf_trn-doc.doc-type
     1017       bf-chg-plus-cr_parts.pl-code        = 0
     1018       bf-chg-plus-cr_parts.VAT-type       = bf-chg_parts.vat-type
     1019       bf-chg-plus-cr_parts.exch-code      = 0
     1020       bf-chg-plus-cr_parts.SLT-pc         = bf-chg_parts.slt-pc
     1021       bf-chg-plus-cr_parts.host-code      = bf_trn-doc.host-code
     1022       bf-chg-plus-cr_parts.is-supp        = yes
     1023       bf-chg-plus-cr_parts.SLT-type       = bf-chg_parts.slt-type
     1024       bf-chg-plus-cr_parts.cst-code       = "":u
     1025       bf-chg-plus-cr_parts.last-date      = ?
     1026       bf-chg-plus-cr_parts.road-tax-base  = bf-chg_parts.road-tax-base  / varkoeff
     1027       bf-chg-plus-cr_parts.road-tax-rubl  = bf-chg_parts.road-tax-rubl  / varkoeff
     1028       bf-chg-plus-cr_parts.transport-base = bf-chg_parts.transport-base / varkoeff
     1029       bf-chg-plus-cr_parts.transport-rubl = bf-chg_parts.transport-rubl / varkoeff
     1030       bf-chg-plus-cr_parts.other-base     = bf-chg_parts.other-base     / varkoeff
     1031       bf-chg-plus-cr_parts.other-rubl     = bf-chg_parts.other-rubl     / varkoeff
     1032       bf-chg-plus-cr_parts.purch-code     = bf-chg_parts.purch-code
     1033       bf-chg-plus-cr_parts.contract-code  = parcontract-code
     1034       bf-chg-plus-cr_parts.qnty           = parqnty
     1035       bf-chg-plus-cr_parts.cli-qnty       = parcli-qnty
     1036       bf-chg-plus-cr_parts.price-cli      = parprice-cli
     1037       bf-chg-plus-cr_parts.cli-base-rate  = parcli-base-rate
     1038       bf-chg-plus-cr_parts.real-qnty      = parreal-qnty
     1039       bf-chg-plus-cr_parts.fact-qnty      = bf-chg-plus-cr_parts.qnty
     1040       bf-chg-plus-cr_parts.pl-code        = parpl-code
     1041     .
     1042     if bf-chg-plus-cr_parts.supp-type = bf-chg-plus-cr_parts.obj-type and
     1043        bf-chg-plus-cr_parts.supp-code = bf-chg-plus-cr_parts.obj-code then do:
     1044       assign
     1045         bf-chg-plus-cr_parts.is-supp = no.
     1046     end.
     1047     create bf-chg-cr_parts-root.
     1048     assign
     1049       bf-chg-cr_parts-root.doc-code       = bf-chg_parts.out-code
     1050       bf-chg-cr_parts-root.orig-in-code   = bf-chg_parts.in-code
     1051       bf-chg-cr_parts-root.orig-gds-code  = bf-chg_goods.gds-code
     1052       bf-chg-cr_parts-root.orig-part-code = bf-chg_parts.part-code
     1053       bf-chg-cr_parts-root.in-code        = bf-chg-plus-cr_parts.in-code
     1054       bf-chg-cr_parts-root.gds-code       = bf-chg-plus_goods.gds-code
     1055       bf-chg-cr_parts-root.part-code      = bf-chg-plus-cr_parts.part-code
     1056     .
     1057   end.
     1058   end procedure.
