        1   define input-output  parameter p-sum1 as decimal   no-undo .
        2   define input-output  parameter p-sum2 as decimal   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Корректировка цены производителя".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   DEFINE BUTTON B-Cancel AUTO-END-KEY
       68        LABEL "Отмена"
       69        SIZE 10 BY 1
       70        BGCOLOR 8 .
       71   DEFINE BUTTON B-Help
       72        LABEL "&Help"
       73        SIZE 5 BY 1.13
       74        BGCOLOR 8 .
       75   DEFINE BUTTON B-OK AUTO-GO
       76        LABEL "Ввод"
       77        SIZE 10 BY 1
       78        BGCOLOR 8 .
       79   DEFINE VARIABLE v-pole-1 AS DECIMAL FORMAT ">>>,>>>,>>9.99":U INITIAL 0
       80        LABEL "Цена производителя без НДС"
       81        VIEW-AS FILL-IN
       82        SIZE 14 BY 1 NO-UNDO.
       83   DEFINE VARIABLE v-pole-2 AS DECIMAL FORMAT ">>>,>>>,>>9.99":U INITIAL 0
       84        LABEL "Цена производителя c НДС"
       85        VIEW-AS FILL-IN
       86        SIZE 14 BY 1 NO-UNDO.
       87   DEFINE FRAME Dialog-Frame
       88        B-OK AT ROW 1 COL 1.5
       89        B-Cancel AT ROW 1 COL 11.5
       90        B-Help AT ROW 1 COL 60
       91        v-pole-1 AT ROW 3 COL 30.5 COLON-ALIGNED WIDGET-ID 2
       92        v-pole-2 AT ROW 4 COL 30.5 COLON-ALIGNED WIDGET-ID 4
       93        SPACE(18.62) SKIP(4.12)
       94       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       95            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       96            TITLE "Корректировка цены производителя"
       97            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
       98   ASSIGN
       99          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      100          FRAME Dialog-Frame:HIDDEN           = TRUE.
      101   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      102   DO:
      103     APPLY "END-ERROR":U TO SELF.
      104   END.
      105   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      106   OR HELP OF FRAME Dialog-Frame
      107   DO:
      108   END.
      109   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      110   DO:
      111   assign v-pole-1
      112   v-pole-2
      113   .
      114   p-sum1 = v-pole-1.
      115   p-sum2 = v-pole-2.
      116   END.
      117   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      118   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   on help of frame Dialog-Frame
      121   do:
      122     run gbl/app_help.p
      123       (input this-procedure :file-name
      124       ,input ''
      125       ,input ?
      126       ) no-error.
      127     if error-status :error then do:
      128       message
      129         "Ошибка при вызове помощи"
      130         error-status :get-message(1)
      131         view-as alert-box .
      132     end.
      133   end.
      134   run minbtn-set in this-procedure .
      135   on choose of b-help in frame Dialog-Frame
      136   do:
      137     apply "help":u to frame Dialog-Frame .
      138   end.
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   procedure minbtn-set :
      141       do
      142           on error undo, return error return-value
      143           :
      144           define variable ii              as integer       no-undo .
      145           define variable fh              as widget-handle no-undo .
      146           define variable hh              as widget-handle no-undo .
      147           define variable v-h             as handle        extent 4 no-undo .
      148           define variable v-name-button   as character     no-undo .
      149           define variable v-help-old-x    as decimal       no-undo .
      150           define variable v-help-old-y    as decimal       no-undo .
      151           define variable v-help-old-size as decimal       no-undo .
      152           define variable v-frame-width   as decimal       no-undo .
      153           define variable jj              as integer       no-undo .
      154           do
      155               on error undo, return error
      156               :
      157               assign
      158                   v-frame-width = frame Dialog-Frame:width - 0.3
      159                   fh            = frame Dialog-Frame:first-child
      160                   hh            = fh:first-child
      161                   ii            = 1
      162                   .
      163               do while valid-handle(hh):
      164                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      165                   do:
      166                       case lc(hh:name) :
      167                           when "b-help" then
      168                               do:
      169                                   hh:load-image-up("cmp/b-help.bmp":u) .
      170                                   hh:load-image-down("cmp/b-help.bmp":u) .
      171                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      172                                   hh:TOOLTIP = "Помощь" .
      173                                   v-help-old-x = hh:column .
      174                                   v-help-old-y = hh:row    .
      175                                   v-help-old-size = hh:width .
      176                                   hh:width-chars = 2.5 .
      177                               end.
      178                           when "b-print" then
      179                               do:
      180                                   hh:load-image("cmp/b-print.bmp":u) .
      181                                   hh:TOOLTIP = "Печать" .
      182                                   v-h[ii] = hh:handle .
      183                                   ii = ii + 1 .
      184                                   hh:width-chars = 3 .
      185                               end.
      186                           when "b-history" or
      187                           when "b-hist" then
      188                               do:
      189                                   hh:load-image("cmp/b-hist.bmp":u) .
      190                                   hh:TOOLTIP = "История" .
      191                                   v-h[ii] = hh:handle .
      192                                   ii = ii + 1 .
      193                                   hh:width-chars = 3 .
      194                               end.
      195                           when "b-sch" then
      196                               do:
      197                                   hh:load-image("cmp/b-sch.bmp":u) .
      198                                   hh:TOOLTIP = "Установка Фильтра" .
      199                                   v-h[ii] = hh:handle .
      200                                   ii = ii + 1 .
      201                                   hh:width-chars = 3 .
      202                               end.
      203                           when "b-hist-user" then
      204                               do:
      205                                   hh:load-image("cmp/b-hist.bmp":u) .
      206                                   hh:TOOLTIP = "История пользователя" .
      207                                   ii = ii + 1 .
      208                               end.
      209                       end case.
      210                   end.
      211                   hh = hh:next-sibling.
      212               end.
      213               b-help:column = v-frame-width - b-help:width-chars.
      214               jj = 0.
      215               repeat ii = 4 to 1 by -1 :
      216                   if valid-handle (v-h[ii] ) then
      217                   do:
      218                       jj  = jj + 1 .
      219                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      220                       v-h[ii]:row    = v-help-old-y .
      221                   end.
      222               end.
      223           end.
      224       end.
      225   end procedure.
      226   MAIN-BLOCK:
      227   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      228      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      229      v-pole-1 = p-sum1.
      230      v-pole-2 = p-sum2.
      231     RUN enable_UI.
      232     WAIT-FOR GO OF FRAME Dialog-Frame.
      233   END.
      234   RUN disable_UI.
      235   PROCEDURE disable_UI :
      236     HIDE FRAME Dialog-Frame.
      237   END PROCEDURE.
      238   PROCEDURE enable_UI :
      239     DISPLAY v-pole-1 v-pole-2
      240         WITH FRAME Dialog-Frame.
      241     ENABLE B-OK B-Cancel B-Help v-pole-1 v-pole-2
      242         WITH FRAME Dialog-Frame.
      243     VIEW FRAME Dialog-Frame.
      244   END PROCEDURE.
