     4911   end.
     4912   ON return OF loc-code IN FRAME d-pr-doc do:
     4913     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     4914     return no-apply.
     4915   end.
     4916   ON return, Ctrl-J OF loc-name IN FRAME d-pr-doc do:
     4917     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     4918     return no-apply.
     4919   end.
     4920   PROCEDURE proc-valchg-a-n-c:
     4921     case input frame d-pr-doc a-n-c :
     4922       when "art" then do:
     4923         apply "entry" to br-list in frame d-pr-doc.
     4924         hide loc-name loc-code
     4925         in frame d-pr-doc.
     4926         loc-art = "".
     4927       end.
     4928       when "name" then do:
     4929         enable loc-name with frame d-pr-doc.
     4930         disp loc-name with frame d-pr-doc.
     4931         hide loc-art loc-code
     4932         in frame d-pr-doc.
     4933         apply "entry" to loc-name in frame d-pr-doc.
     4934       end.
     4935       when "code"
     4936    or when "DataMatrix" then
     4937       do:
     4938         enable loc-code with frame d-pr-doc.
     4939         disp loc-code with frame d-pr-doc.
     4940         hide loc-art loc-name
     4941         in frame d-pr-doc.
     4942         apply "entry" to loc-code in frame d-pr-doc.
     4943       end.
     4944     end CASE.
     4945   END PROCEDURE.
     4946   PROCEDURE proc-any-printable-br-list :
     4947     if input frame d-pr-doc a-n-c = "art" then do:
     4948       if last-event:label = " " and
     4949          loc-art = "" then
     4950       return error.
     4951       find first l-price-list where
     4952                  l-price-list.doc-num = p-doc.doc-num and l-price-list.artic begins (loc-art + last-event:label)
     4953                  no-lock no-error.
     4954       if available l-price-list then do:
     4955         loc-art = loc-art + last-event:label.
     4956         disp loc-art with frame d-pr-doc.
     4957         line-rec = recid (l-price-list).
     4958         reposition br-list to recid line-rec no-error.
     4959       end.
     4960     end.
     4961   END PROCEDURE.
     4962   PROCEDURE proc-backspace-br-list:
     4963     if input frame d-pr-doc a-n-c = "art" then do:
     4964       if loc-art = "" then
     4965         return error.
     4966       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4967       find first l-price-list where
     4968                  l-price-list.doc-num = p-doc.doc-num and l-price-list.artic begins loc-art
     4969                  no-lock.
     4970       disp loc-art with frame d-pr-doc.
     4971       line-rec = recid (l-price-list).
     4972       reposition br-list to recid line-rec no-error.
     4973     end.
     4974   END PROCEDURE.
     4975   PROCEDURE proc-mouse-dbl-click-loc-code:
     4976   def var str-code as integer no-undo.
     4977   define variable varresult   as character         no-undo.
     4978   define variable vartype-bc  as character         no-undo.
     4979   define variable varweight   as decimal           no-undo.
     4980   define buffer l-goods for ub.goods.
     4981   define buffer l-bar-code for ub.bar-code.
     4982   define buffer buf_bar-code for ub.bar-code .
     4983   define buffer buf_prod-bc for ub.prod-bc.
     4984   define buffer buf_place for ub.place.
     4985     assign
     4986     frame d-pr-doc
     4987     loc-code
     4988     a-n-c.
     4989     if a-n-c = "datamatrix"
     4990     then do:
     4991   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4992   (
     4993    input  parparentproc
     4994   ,input  loc-code
     4995   ,input  ?
     4996   ,input  v-cntxt-obj-type
     4997   ,input  v-cntxt-obj-code
     4998   ,input  yes
     4999   ,input  no
     5000   ,input  varscales-pref56
     5001   ,input  varpgscales-pref56
     5002   ,output varresult
     5003   ,output vartype-bc
     5004   ,output varweight
     5005   ,buffer buf_bar-code
     5006   ,buffer buf_prod-bc
     5007   ,buffer buf_place
     5008   ) no-error.
     5009        if varresult eq "prod-bc"
     5010        then
     5011           loc-code:screen-value in frame d-pr-doc = buf_prod-bc.b-str.
     5012     end.
     5013     else do:
     5014   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     5015   (
     5016    input  parparentproc
     5017   ,input  loc-code
     5018   ,input  ?
     5019   ,input  v-cntxt-obj-type
     5020   ,input  v-cntxt-obj-code
     5021   ,input  yes
     5022   ,input  no
     5023   ,input  varscales-pref56
     5024   ,input  varpgscales-pref56
     5025   ,output varresult
     5026   ,output vartype-bc
     5027   ,output varweight
     5028   ,buffer buf_bar-code
     5029   ,buffer buf_prod-bc
     5030   ,buffer buf_place
     5031   ) no-error.
     5032   end.
     5033     if available buf_bar-code then do:
     5034           find first l-goods where
     5035                     l-goods.gds-code =
     5036     buf_bar-code.gds-code No-LOCK.
     5037           find first l-price-list where l-price-list.doc-num = p-doc.doc-num and
     5038                     l-price-list.artic = l-goods.artic AND
     5039                     l-price-list.prod-type = l-goods.prod-type AND
     5040                     l-price-list.prod-code = l-goods.prod-code no-lock no-error.
     5041       if available l-price-list then do:
     5042         line-rec = recid (l-price-list).
     5043         reposition br-list to recid line-rec no-error.
     5044       end.
     5045       else do:
     5046         message "Строка не найдена."
     5047                 view-as alert-box error.
     5048       end.
     5049     end.
     5050     else
     5051       message "Бар-код не найден."
     5052               view-as alert-box error.
     5053     apply "entry" to loc-code in frame d-pr-doc.
     5054   END PROCEDURE.
     5055   PROCEDURE  proc-mouse-dbl-click-loc-name:
     5056     assign
     5057     frame d-pr-doc
     5058     loc-name.
     5059       if last-event:label = "Ctrl-J" then
     5060         find next l-price-list where l-price-list.doc-num = p-doc.doc-num and
     5061                   can-find (ub.goods where ub.goods.artic = l-price-list.artic and
     5062                   ub.goods.prod-type = l-price-list.prod-type and
     5063                   ub.goods.prod-code = l-price-list.prod-code and
     5064                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     5065       else
     5066         find first l-price-list where l-price-list.doc-num = p-doc.doc-num and
     5067                   can-find (ub.goods where ub.goods.artic = l-price-list.artic and
     5068                   ub.goods.prod-type = l-price-list.prod-type and
     5069                   ub.goods.prod-code = l-price-list.prod-code and
     5070                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     5071       if available l-price-list then do:
     5072         line-rec = recid (l-price-list).
     5073         reposition br-list to recid line-rec no-error.
     5074       end.
     5075       else do:
     5076         message "Строка не найдена."
     5077                 view-as alert-box error.
     5078       end.
     5079     apply "entry" to loc-name in frame d-pr-doc.
     5080   END PROCEDURE.
     5081   on value-changed of br-list in frame d-pr-doc do:
