      542   function hvrdtax return logical (input parrecid as recid):
      543   define variable varresult as logical no-undo.
      544   run hvrdtax-proc (input parrecid, output varresult).
      545   return varresult.
      546   end function.
      547   procedure hvrdtax-proc:
      548   define input  parameter parrecid  as recid   no-undo.
      549   define output parameter parresult as logical no-undo.
      550   define buffer bf_goods for ub.goods.
      551   define buffer bf_units for ub.units.
      552   define buffer rt_tax   for ub.tax.
      553   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      554   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      555   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      556   if available rt_tax and
      557       can-find(first ub.tax-units No-LOCK WHERE
      558                      ub.tax-units.tax-code = rt_tax.tax-code AND
      559                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      560                                                       else assign parresult = no.
      561   end procedure.
