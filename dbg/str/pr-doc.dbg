     1512   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   procedure ver-modificator-price-is-null :
     1514    do
     1515    on error undo, return error return-value
     1516    :
     1517   define input parameter p-artic     like ub.goods.artic no-undo.
     1518   define input parameter p-prod-type like ub.goods.prod-type no-undo.
     1519   define input parameter p-prod-code like ub.goods.prod-code no-undo.
     1520   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
     1521   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
     1522   define output parameter p-ret as logical no-undo .
     1523   define variable v-gds-code  like ub.goods.gds-code no-undo .
     1524   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     1525   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1527     (input  p-artic
     1528     ,input  p-prod-type
     1529     ,input  p-prod-code
     1530     ,output v-gds-code
     1531     )  .
     1532   p-ret = true .
     1533   find first buf_fbr-gds-obj no-lock where
     1534               buf_fbr-gds-obj.gds-code = v-gds-code and
     1535               buf_fbr-gds-obj.obj-code = p-obj-code and
     1536               buf_fbr-gds-obj.obj-type = p-obj-type use-index pi no-error .
     1537    if available buf_fbr-gds-obj then
     1538                 if buf_fbr-gds-obj.is-modificator = true and
     1539                    buf_fbr-gds-obj.is-null-price = true
     1540                    then  p-ret = false .
     1541    end.
     1542   end procedure.
     1543   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   procedure doc-code:
     1545   define input  parameter parmode          as   character           no-undo.
     1546   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1547   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1548   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1549   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1550   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1551   define variable vardb-remote     as   logical             no-undo.
     1552   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1553   define variable v-delimiter as character no-undo .
     1554   do
     1555   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1556   :
     1557   find first buf_sys-ctrl no-lock .
     1558   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1559     CASE parmode:
     1560       when "main":u then do:
     1561         if vardb-remote then do:
     1562           assign
     1563             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1564         end.
     1565         else do:
     1566           assign
     1567             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1568         end.
     1569       end.
     1570       when "trio" then do:
     1571         assign
     1572           pardoc-code = replace (parroot-doc-code, "=", "*").
     1573       end.
     1574       otherwise do:
     1575         assign
     1576         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1577         no-error
     1578         .
     1579         if error-status:error  then do:
     1580           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1581                                         ,chr(10)
     1582                                         ,parmode
     1583                                         ).
     1584         end.
     1585         if num-entries(parmode) = 1
     1586         and parmode <> "chip":U
     1587         and parmode <> "chip_s":U
     1588         then do:
     1589           assign
     1590           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1591         end.
     1592         else if (lookup("chip":U, parmode) > 0
     1593                  or
     1594                  lookup("chip_s":U, parmode) > 0) then do:
     1595           assign
     1596             vartemp-doc-code = parroot-doc-code.
     1597           do while true:
     1598             if index (vartemp-doc-code , ".") = 0 then
     1599               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1600             else
     1601               vartemp-doc-code  =
     1602               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1603               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1604               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1605             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1606           end.
     1607           assign
     1608             pardoc-code = vartemp-doc-code.
     1609         end.
     1610       end.
     1611     end CASE.
     1612     if pardoc-code = '':U
     1613     or (parroot-doc-code <> '':U
     1614     and pardoc-code = parroot-doc-code) then do:
     1615       undo, return error substitute("Ошибка при генерации номера документа&1"
     1616                                     ,chr(10)).
     1617     end.
     1618   end.
     1619   end. // procedure/method
     1620   function get-doc-code-int64 returns int64
     1621     ( input p-doc-code as character ) :
     1622     define variable v-ind              as integer   no-undo .
     1623     define variable v-num-entries      as integer   no-undo .
     1624     define variable v-doc-code-int64   as int64     no-undo .
     1625     define variable v-canonic-doc-code as character no-undo .
     1626     assign
     1627       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1628       v-canonic-doc-code = p-doc-code
     1629     .
     1630     do v-ind = 1 to v-num-entries
     1631     :
     1632       assign
     1633         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1634       .
     1635     end.
     1636     assign
     1637       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1638     .
     1639     return v-doc-code-int64 .
     1640   end. // function/method
     1641   define new global shared variable g#libbcrcn as handle no-undo .
     1642   procedure create-price-list-attr :
     1643    do
     1644    on error undo, return error return-value
     1645    :
     1646   define input parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
     1647   define input parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
     1648   define input parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
     1649   define input parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
     1650   define input parameter p-price-type   like ub.price-list-attr.price-type no-undo .
     1651   define buffer buf_price-list-attr for ub.price-list-attr.
     1652   find first buf_price-list-attr  exclusive-lock  where
     1653     buf_price-list-attr.attr-code    = p-attr-code    and
     1654     buf_price-list-attr.b-code       = p-b-code       and
     1655     buf_price-list-attr.doc-num      = p-doc-num      and
     1656     buf_price-list-attr.price-type   = p-price-type  no-error .
     1657     if not available  buf_price-list-attr then do:
     1658         create buf_price-list-attr.
     1659         assign
     1660           buf_price-list-attr.attr-code    = p-attr-code
     1661           buf_price-list-attr.attr-value   = p-attr-value
     1662           buf_price-list-attr.b-code       = p-b-code
     1663           buf_price-list-attr.doc-num      = p-doc-num
     1664           buf_price-list-attr.price-type   = p-price-type
     1665         .
     1666     end.
     1667     else do:
     1668           buf_price-list-attr.attr-value   = p-attr-value .
     1669     end.
     1670    end.
     1671   end procedure.
     1672   procedure view-price-list-attr :
     1673    do
     1674    on error undo, return error return-value
     1675    :
     1676   define input  parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
     1677   define input  parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
     1678   define input  parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
     1679   define input  parameter p-price-type   like ub.price-list-attr.price-type no-undo .
     1680   define output parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
     1681   define buffer buf_price-list-attr for ub.price-list-attr.
     1682   find first buf_price-list-attr no-lock where
     1683     buf_price-list-attr.attr-code    = p-attr-code    and
     1684     buf_price-list-attr.b-code       = p-b-code       and
     1685     buf_price-list-attr.doc-num      = p-doc-num      and
     1686     buf_price-list-attr.price-type   = p-price-type  no-error .
     1687     if available  buf_price-list-attr then do:
     1688         assign
     1689           p-attr-value = buf_price-list-attr.attr-value
     1690         .
     1691     end.
     1692     else do:
     1693           p-attr-value = ? .
     1694     end.
     1695    end.
     1696   end procedure.
     1697   procedure pdoc-forming-attr :
     1698   define input  parameter p-plt-id       as integer   no-undo .
     1699   define input  parameter p-plt-db-num   as integer   no-undo .
     1700   define input  parameter p-pdf-id       as integer   no-undo .
     1701   define input  parameter p-pdf-db       as integer   no-undo .
     1702   define input  parameter p-attr-code    as character no-undo .
     1703   define input  parameter p-val          as character no-undo .
     1704     do
     1705     on error undo, return error return-value
     1706     :
     1707     find first  ub.price-doc-forming-attr exclusive-lock where
     1708                 ub.price-doc-forming-attr.plt-id       = p-plt-id       and
     1709                 ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num   and
     1710                 ub.price-doc-forming-attr.pdf-id       = p-pdf-id       and
     1711                 ub.price-doc-forming-attr.pdf-db       = p-pdf-db       and
     1712                 ub.price-doc-forming-attr.attr-code    = p-attr-code
     1713                 no-error .
     1714       if not available  ub.price-doc-forming-attr then create ub.price-doc-forming-attr.
     1715       assign
     1716         ub.price-doc-forming-attr.plt-id       = p-plt-id
     1717         ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num
     1718         ub.price-doc-forming-attr.pdf-id       = p-pdf-id
     1719         ub.price-doc-forming-attr.pdf-db       = p-pdf-db
     1720         ub.price-doc-forming-attr.attr-code    = p-attr-code
     1721         ub.price-doc-forming-attr.attr-value   = p-val
     1722       .
     1723     end.
     1724   end procedure.
     1725   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1726   define variable v-waitfram-action01         as character   no-undo .
     1727   define variable v-waitfram-action02         as character   no-undo .
     1728   define variable v-waitfram-action03         as character   no-undo .
     1729   define variable mWaitFramTextBeg            as character   no-undo.
     1730   define variable mWaitFramTextEnd            as character   no-undo.
     1731   define variable mWaitFramView               as logical     no-undo.
     1732   define variable mWaitProcEvent              as logical     no-undo init yes.
     1733   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1734   define variable mWaitFramStop               as logical     no-undo.
     1735   define variable mWaitFramStopUser           as logical     no-undo.
     1736   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1737   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1738   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1739   define button B-WaitFramStop auto-end-key
     1740        label "Стоп"
     1741        size 10 by 1 tooltip "Остоновить процесс".
     1742   define button B-viewProcInfo
     1743        label "Информация"
     1744        size 15 by 1 tooltip "Информация о процесс".
     1745   define frame waitfram
     1746     v-waitfram-action01 format "x(72)" no-label skip
     1747     v-waitfram-action02 format "x(72)" no-label skip
     1748     v-waitfram-action03 format "x(72)" no-label skip
     1749     B-viewProcInfo
     1750     B-WaitFramStop at row 4 col 30
     1751     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1752     .
     1753   define new global shared variable mBatchMode as logical no-undo init ?.
     1754   define variable mFramBachModHandle as handle no-undo.
     1755   mFramBachModHandle = frame waitfram:handle.
     1756   define variable mFameOldVis as logical no-undo.
     1757   define variable mVisCUrentVin as logical no-undo.
     1758   if session:batch-mode
     1759   then
     1760      mBatchMode = yes.
     1761   if mBatchMode = ? then do:
     1762     mVisCUrentVin = current-window:visible.
     1763     mFameOldVis = mFramBachModHandle:visible.
     1764     mFramBachModHandle:visible  = yes.
     1765     mBatchMode = mFramBachModHandle:visible ne yes.
     1766     mFramBachModHandle:visible = mFameOldVis.
     1767     current-window:visible = mVisCUrentVin.
     1768   end.
     1769    if  log-manager:logfile-name ne ?
     1770     then DO:
     1771         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1772         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1773         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1774     end.
     1775   on choose of B-WaitFramStop in frame waitfram
     1776   do:
     1777     mWaitFramStop = yes.
     1778     mWaitFramStopUser = yes.
     1779   end.
     1780   function waitfram-check-timeout returns logical():
     1781      define variable vtime as int64 no-undo.
     1782      if mWaitFramStopTimeOut
     1783      then
     1784         return yes.
     1785      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1786      if     mWaitFramTimeOut ne ?
     1787         and mWaitFramTimeOut ne 0
     1788         and mWaitFramTimeOut lt vtime
     1789      then do:
     1790         mWaitFramStopTimeOut = yes.
     1791      end.
     1792      return mWaitFramStopTimeOut.
     1793   end.
     1794   procedure waitfram-hide :
     1795     if not session:batch-mode
     1796     then do
     1797     on error undo, return error return-value
     1798     :
     1799       pause 0 before-hide .
     1800       if not mBatchMode then
     1801         hide frame waitfram .
     1802     if     not mWaitFramView
     1803        and mWaitProcEvent
     1804     then
     1805       process events .
     1806     end.
     1807   end procedure.
     1808   procedure waitfram-show :
     1809     define input  parameter p-message as character no-undo .
     1810     define variable v-left-margin as integer   no-undo .
     1811     if not session:batch-mode
     1812     then do
     1813     on error undo, return error return-value
     1814     :
     1815       if length(p-message) <= 70 then do:
     1816         assign
     1817           v-left-margin = integer((70 - length(p-message)) / 2)
     1818         .
     1819         assign
     1820           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1821         .
     1822         assign
     1823           v-waitfram-action01 = " "
     1824           v-waitfram-action02 = " "
     1825                                    + fill(" ", v-left-margin)
     1826                                    + p-message
     1827           v-waitfram-action03 = " "
     1828         .
     1829       end.
     1830       else do:
     1831         define variable vRindex1 as integer no-undo.
     1832         define variable vRindex2 as integer no-undo.
     1833         vRindex1 = r-index(p-message," ",70).
     1834         if vRindex1 = 0
     1835         then
     1836            vRindex1 = 70.
     1837         if length(p-message)  <= vRindex1 + 70 then do:
     1838           assign
     1839             v-waitfram-action01 = " "
     1840             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1841             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1842           .
     1843         end.
     1844         else do:
     1845           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1846           if vRindex2 <= vRindex1
     1847           then
     1848              vRindex2 = vRindex1 + 70.
     1849           assign
     1850             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1851             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1852             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1853           .
     1854         end.
     1855       end.
     1856       B-viewProcInfo:visible   in frame waitfram = no.
     1857       B-viewProcInfo:sensitive in frame waitfram = no.
     1858       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1859       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1860       if  (   mWaitFramView
     1861          or  mWaitProcEvent)
     1862          and not mBatchMode
     1863       then
     1864          display
     1865             v-waitfram-action01 skip
     1866             v-waitfram-action02 skip
     1867             v-waitfram-action03 skip
     1868          with frame waitfram .
     1869       if     mWaitFramView
     1870          then do:
     1871             if     mWaitFramInterval ne ?
     1872                and not mBatchMode
     1873             then
     1874                wait-for go of frame waitfram pause mWaitFramInterval.
     1875          end.
     1876          else
     1877             if     mWaitProcEvent
     1878                and not mBatchMode
     1879             then
     1880                process events .
     1881     end.
     1882   end procedure.
     1883      procedure waitfram-show-this:
     1884         define input  parameter iInterval as int64 no-undo.
     1885         define variable vtime as int64 no-undo.
     1886         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1887         mWaitFramInterval = iInterval.
     1888         run waitfram-show (substitute("&1&2 &3&4" ,
     1889                                       mWaitFramTextBeg ,
     1890                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1891                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1892                                       mWaitFramTextEnd
     1893                                      )
     1894                           ).
     1895      end.
     1896      procedure WaitFramRunPause:
     1897         define input  parameter iInterval as dec no-undo.
     1898         define variable vStart  as datetime-tz no-undo.
     1899         define variable vend    as datetime-tz no-undo.
     1900         define variable vint as int64 no-undo.
     1901         define variable vOk as logical no-undo.
     1902         vStart = now.
     1903         vend   = vStart.
     1904         publish "WaitFramPause" (iInterval,output vOk).
     1905         vend   =  now.
     1906         vint = vend - vStart.
     1907         vint = iInterval - vint / 1000.
     1908         if     not mWaitFramStop
     1909            and (   vint > 0
     1910                 or (    not vOk
     1911                     and iInterval eq ?
     1912                     )
     1913                 )
     1914         then
     1915            run waitfram-show-this (iInterval).
     1916         vend   =  now.
     1917         vint = vend - vStart.
     1918         vint = iInterval - vint / 1000.
     1919         if     not mWaitFramStop
     1920            and vint > 0
     1921         then do:
     1922            run gbl/pause.p (vint * 1000).
     1923         end.
     1924         if iInterval ne ?
     1925         then
     1926            publish "WaitFramStop".
     1927         waitfram-check-timeout().
     1928      end.
     1929      procedure WaitFramWaitFor:
     1930         define input  parameter iInterval as dec no-undo.
     1931         assign
     1932            mWaitFramStartProc   = now
     1933            mWaitFramStopUser    = no
     1934            mWaitFramStopTimeOut = no
     1935         .
     1936         block-wait:
     1937         do while not mWaitFramStop:
     1938            run WaitFramRunPause (iInterval).
     1939            if  waitfram-check-timeout()
     1940            then do:
     1941               leave block-wait.
     1942            end.
     1943         end.
     1944         run waitfram-hide.
     1945      end.
     1946   procedure waitfram-join :
     1947     define input  parameter p-line-1  as character no-undo .
     1948     define input  parameter p-line-2  as character no-undo .
     1949     define input  parameter p-line-3  as character no-undo .
     1950     define output parameter p-message as character no-undo .
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       assign
     1955         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1956                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1957                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1958       .
     1959     end.
     1960   end procedure.
     1961   function waitfram-join-function returns character
     1962     (input p-line-1 as character
     1963     ,input p-line-2 as character
     1964     ,input p-line-3 as character
     1965     ).
     1966     define variable v-message as character no-undo .
     1967     run waitfram-join in this-procedure
     1968       (input  p-line-1
     1969       ,input  p-line-2
     1970       ,input  p-line-3
     1971       ,output v-message
     1972       ) .
     1973     return v-message .
     1974   end function .
