     4770           when '%'  then DO:   assign     sort-clmn-name = "fnc-pr-pc (buffer ub.price-list)"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by fnc-pr-pc (buffer ub.price-list).   . END.
