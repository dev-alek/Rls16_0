     3363      define variable ii as integer   no-undo .
     3364      define variable nn as integer   no-undo .
     3365      define variable v-fullname as character no-undo .
     3366      nn = num-entries ( par-pr-nogds ).
     3367      par-pr-nogds-long = "".
     3368      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     3369         repeat ii = 1 to nn :
     3370           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     3371           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     3372         end.
     3373         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     3374      end.
     3375   l-par = true .
     3376   end procedure.
     3377   PROCEDURE cre-pr-list:
     3378   define input  parameter bc      like ub.price-list.b-code no-undo.
     3379   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     3380   define output parameter new-rec as recid             no-undo.
     3381   define buffer buf-price-list for ub.price-list.
     3382   define buffer buf-price-doc  for ub.price-doc.
     3383   define buffer buf-bar-code   for ub.bar-code.
     3384   define buffer buf-goods      for ub.goods.
     3385   define buffer buf-gds-prt    for ub.gds-prt.
     3386   define buffer root-gds-prt   for ub.gds-prt.
     3387   define variable cur-pr like ub.price-list.price-sale no-undo.
     3388   define variable cur-rt like ub.price-list.road-tax   no-undo.
     3389   define variable cur-ex like ub.price-list.excise     no-undo.
     3390   define variable cur-dn like ub.price-list.doc-num    no-undo.
     3391   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     3392   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     3393   define variable cur-rt-base as decimal no-undo .
     3394   define variable cur-rt-rubl as decimal no-undo .
     3395   define variable p-hostcode as int no-undo .
     3396   define variable v-line-num as integer no-undo .
     3397   define variable v-skip-del-gds as logical no-undo initial no .
     3398   cre-pr:
     3399   do on error undo cre-pr, return error:
     3400     find  buf-bar-code no-lock where
     3401           buf-bar-code.b-code = bc.
     3402     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     3403     if error-status :error then do:
     3404       message
     3405         return-value skip
     3406         "Ошибка !"
     3407         view-as alert-box error
     3408       .
     3409       undo cre-pr, return.
     3410     end.
     3411     find  buf-goods no-lock where
     3412           buf-goods.gds-code = buf-bar-code.gds-code.
     3413     find first root-gds-prt no-lock where
     3414               root-gds-prt.upper-code = buf-goods.prt-root.
     3415     if root-gds-prt.node-name <> '_Пустая шкала':U and
     3416       buf-bar-code.in-code <> "" then do:
     3417       message
     3418         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     3419         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3420         view-as alert-box error.
     3421       undo cre-pr, return.
     3422     end.
     3423     find  buf-gds-prt no-lock where
     3424           buf-gds-prt.node-code = buf-bar-code.node-code.
     3425     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     3426       message
     3427         "Не допускается создавать цены на удаленные товары!" skip (2)
     3428         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3429         view-as alert-box error.
     3430       undo cre-pr, return.
     3431     end.
     3432     find  buf-price-doc where
     3433           buf-price-doc.doc-num = new-num.
     3434   define variable v-ret as logical no-undo .
     3435      run ver-modificator-price-is-null (
     3436             input    buf-goods.artic        ,
     3437             input    buf-goods.prod-type    ,
     3438             input    buf-goods.prod-code    ,
     3439             input    buf-price-doc.obj-type   ,
     3440             input    buf-price-doc.obj-code   ,
     3441             output   v-ret ).
     3442         if v-ret = false then dO:
     3443             message
     3444               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     3445               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     3446               view-as alert-box error.
     3447             undo cre-pr, return.
     3448           end.
     3449   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3451     (input  buf-price-doc.obj-type
     3452     ,input  buf-price-doc.obj-code
     3453     ,output p-hostcode
     3454     ) no-error .
     3455   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3457     (input  buf-goods.gds-code
     3458     ,input  '1':U
     3459     ,input  ?
     3460     ,input  p-hostcode
     3461     ,input  buf-price-doc.obj-type
     3462     ,input  buf-price-doc.obj-code
     3463     ,output local_vat-pc
     3464     ) no-error .
     3465   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3467     (input  buf-goods.gds-code
     3468     ,input  '2':U
     3469     ,input  ?
     3470     ,input  p-hostcode
     3471     ,input  buf-price-doc.obj-type
     3472     ,input  buf-price-doc.obj-code
     3473     ,output local_slt-pc
     3474     ) no-error .
     3475   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3477     (input  buf-price-doc.obj-type
     3478     ,input  buf-price-doc.obj-code
     3479     ,input  bc
     3480     ,input  0
     3481     ,input  0
     3482     ,output cur-dn
     3483     ,output cur-pr
     3484     ,output cur-rt
     3485     ,output cur-ex
     3486     ) no-error .
     3487     find first buf-price-list where
     3488               buf-price-list.b-code  = buf-bar-code.b-code and
     3489               buf-price-list.doc-num = new-num  and
     3490               buf-price-list.price-type = ""    no-error .
     3491     if not available buf-price-list then do:
     3492       run calc-price-line-num (input  new-num , output v-line-num) .
     3493       create buf-price-list.
     3494       assign
     3495         buf-price-list.line-num  = v-line-num
     3496         buf-price-list.b-code    = buf-bar-code.b-code
     3497         buf-price-list.doc-num   = buf-price-doc.doc-num
     3498         buf-price-list.prod-type = buf-goods.prod-type
     3499         buf-price-list.prod-code = buf-goods.prod-code
     3500         buf-price-list.artic     = buf-goods.artic
     3501         buf-price-list.obj-type  = buf-price-doc.obj-type
     3502         buf-price-list.obj-code  = buf-price-doc.obj-code
     3503         buf-price-list.vat-pc    = local_vat-pc
     3504         buf-price-list.slt-pc    = local_slt-pc
     3505         buf-price-list.price-prev = cur-pr
     3506         .
     3507       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     3508           buf-bar-code.in-code   = "" and
     3509           buf-bar-code.part-code = "" and
     3510           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     3511         buf-price-list.main-price = yes.
     3512         if cur-pr <> ? then do:
     3513           run exp-prt (input buf-goods.gds-code,
     3514                       input cur-dn,
     3515                       input new-num,
     3516                       output new-rec) no-error.
     3517           if error-status :error then do:
     3518             message
     3519               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     3520               view-as alert-box error.
     3521             undo cre-pr, return error.
     3522           end.
     3523         end.
     3524       end.
     3525       else do:
     3526         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3527           buf-price-list.d-pcnt = ?.
     3528         end.
     3529         buf-price-list.main-price = no.
     3530       end.
     3531     end.
     3532   end.
     3533   new-rec = recid (buf-price-list).
     3534   END PROCEDURE.
     3535   procedure calc-price-line-num :
     3536    do
     3537    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3538    :
     3539   define input parameter p-doc-num as character no-undo .
     3540   define output parameter p-num  as integer no-undo .
     3541   define variable v-fact as integer no-undo .
     3542   define buffer buf_1_price-list for ub.price-list .
     3543   p-num = 1 .
     3544   find last  buf_1_price-list no-lock where
     3545              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     3546              if available buf_1_price-list then
     3547                   assign
     3548                     v-fact = buf_1_price-list.line-num
     3549                   .
     3550   v-fact = v-fact + 1.
     3551   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     3552    end.
     3553   end procedure.
     3554   PROCEDURE del-pr-list:
     3555   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3556   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3557   define input parameter round-method as character         no-undo.
     3558   define input parameter round-base   as decimal      no-undo.
     3559   define buffer buf-price-list for ub.price-list.
     3560   define buffer buf-bar-code   for ub.bar-code.
     3561   define buffer buf-goods      for ub.goods.
     3562   define variable l-ov-on as logical no-undo .
     3563   del-pr:
     3564   do on error undo del-pr, return error:
     3565     find first  buf-price-list no-lock where
     3566                 buf-price-list.doc-num    = d-num and
     3567                 buf-price-list.b-code     = bc and
     3568                 buf-price-list.price-type = "" no-error.
     3569     if not available buf-price-list then
     3570       undo del-pr, return error.
     3571     find  buf-goods no-lock where
     3572           buf-goods.prod-type = buf-price-list.prod-type and
     3573           buf-goods.prod-code = buf-price-list.prod-code and
     3574           buf-goods.artic     = buf-price-list.artic.
     3575     if buf-price-list.main-price then do:
     3576       for each  buf-price-list exclusive-lock where
     3577                 buf-price-list.doc-num   = d-num and
     3578                 buf-price-list.artic     = buf-goods.artic and
     3579                 buf-price-list.prod-type = buf-goods.prod-type and
     3580                 buf-price-list.prod-code = buf-goods.prod-code,
     3581           first buf-bar-code no-lock where
     3582                 buf-bar-code.b-code = buf-price-list.b-code
     3583       on error undo del-pr, return error:
     3584   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3586     (input  ub.buf-price-list.obj-type
     3587     ,input  ub.buf-price-list.obj-code
     3588     ,input  ub.buf-price-list.artic
     3589     ,input  ub.buf-price-list.prod-type
     3590     ,input  ub.buf-price-list.prod-code
     3591     ,input  'ov-on=request:exclusive'
     3592     ,output l-ov-on
     3593     ) no-error .
     3594         if error-status:error then do:
     3595           message
     3596             vss-workfile vss-revision vss-description skip
     3597             "Ошибка получения признака товара на объекте" skip
     3598             error-status :get-message(1) skip
     3599             return-value skip
     3600             view-as alert-box error .
     3601         end.
     3602         if l-ov-on then do:
     3603   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3605     (input  ub.buf-price-list.obj-type
     3606     ,input  ub.buf-price-list.obj-code
     3607     ,input  ub.buf-price-list.artic
     3608     ,input  ub.buf-price-list.prod-type
     3609     ,input  ub.buf-price-list.prod-code
     3610     ,input  'ov-on=false'
     3611     ,output l-ov-on
     3612     ) no-error .
     3613           if error-status :error then do:
     3614           end.
     3615          end.
     3616         delete buf-price-list.
     3617       end.
     3618     end.
     3619     else do:
     3620       find  buf-bar-code no-lock where
     3621             buf-bar-code.b-code = buf-price-list.b-code.
     3622       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     3623         message
     3624           "Нельзя удалить неосновную цену." skip
     3625           "Неосновная цена (скидка) не может быть неопределенной." skip
     3626           "Код:" bc skip
     3627           "Переоценка:" d-num
     3628           view-as alert-box error.
     3629         undo del-pr, return error.
     3630       end.
     3631       find current buf-price-list exclusive-lock no-error .
     3632       delete buf-price-list.
     3633       run calc-base-upd (input buf-bar-code.b-code,
     3634                         input d-num,
     3635                         input round-method,
     3636                         input round-base) no-error.
     3637       if error-status :error then
     3638         undo del-pr, return error.
     3639     end.
     3640   end.
     3641   END PROCEDURE.
     3642   PROCEDURE calc-base-upd:
     3643   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3644   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3645   define input parameter round-method as character         no-undo.
     3646   define input parameter round-base   as decimal      no-undo.
     3647   define buffer alt-bar-code   for ub.bar-code.
     3648   define buffer alt-price-list for ub.price-list.
     3649   define buffer buf-bar-code   for ub.bar-code.
     3650   define buffer buf-goods      for ub.goods.
     3651   calc-base:
     3652   do on error undo calc-base, return error:
     3653     find  buf-bar-code no-lock where
     3654           buf-bar-code.b-code = bc.
     3655     find  buf-goods no-lock where
     3656           buf-goods.gds-code = buf-bar-code.gds-code.
     3657     for each  alt-bar-code no-lock where
     3658               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     3659               alt-bar-code.node-code = buf-bar-code.node-code and
     3660               alt-bar-code.part-code = buf-bar-code.part-code and
     3661               alt-bar-code.in-code   = buf-bar-code.in-code and
     3662               alt-bar-code.unit-cli <> buf-goods.unit-base,
     3663         each  alt-price-list where
     3664               alt-price-list.doc-num    = d-num and
     3665               alt-price-list.b-code     = alt-bar-code.b-code and
     3666               alt-price-list.price-type = ""
     3667         on error undo calc-base, return error:
     3668       run calc-pr-alt (input d-num,
     3669                       input alt-bar-code.b-code,
     3670                       input round-method,
     3671                       input round-base) no-error.
     3672       if error-status:error then
     3673         undo calc-base, return error.
     3674     end.
     3675   end.
     3676   END PROCEDURE.
     3677   PROCEDURE calc-pr-alt:
     3678   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3679   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3680   define input parameter r-method as character             no-undo.
     3681   define input parameter r-base   as decimal              no-undo.
     3682   define buffer buf-price-doc  for ub.price-doc.
     3683   define buffer buf-price-list for ub.price-list.
     3684   define buffer buf-bar-code   for ub.bar-code.
     3685   define buffer buf-goods      for ub.goods.
     3686   define buffer old-price-list for ub.price-list.
     3687   define variable pr-rec   as   recid                  no-undo.
     3688   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3689   pr-alt:
     3690   do on error undo pr-alt, return error:
     3691     if r-method = ? or
     3692        r-base = ? then do:
     3693       message
     3694         "Нельзя удалить основную цену." skip
     3695         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     3696         "Код:" bc skip
     3697         "Переоценка:" d-num
     3698         view-as alert-box error.
     3699       undo pr-alt, return error.
     3700     end.
     3701     find  buf-price-doc where
     3702           buf-price-doc.doc-num = d-num.
     3703     find  buf-bar-code no-lock where
     3704           buf-bar-code.b-code = bc.
     3705     find  buf-goods no-lock where
     3706           buf-goods.gds-code = buf-bar-code.gds-code.
     3707     find  buf-price-list where
     3708           buf-price-list.doc-num = buf-price-doc.doc-num and
     3709           buf-price-list.b-code  = bc.
     3710     if buf-price-list.d-pcnt = ? then do:
     3711   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3713     (input  buf-price-doc.obj-type
     3714     ,input  buf-price-doc.obj-code
     3715     ,input  bc
     3716     ,input  0
     3717     ,input  0
     3718     ,output pr-rec
     3719     ,output pr-c-b-r
     3720     )  .
     3721       find old-price-list no-lock where
     3722           recid (old-price-list) = pr-rec no-error.
     3723       if available old-price-list and
     3724         old-price-list.b-code = bc then
     3725         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     3726       else
     3727         buf-price-list.d-pcnt = 0.
     3728     end.
     3729      if buf-price-list.d-pcnt = ? then do:
     3730         assign
     3731           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     3732           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     3733           .
     3734     end.
     3735     else do:
     3736         assign
     3737           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     3738                                         buf-bar-code.cli-base-rate *
     3739                                         (1 - buf-price-list.d-pcnt / 100)
     3740           buf-price-list.calc-method =  'Основная':U
     3741           .
     3742   case r-method :
     3743     when '9-окончание':U then do:
     3744       if buf-price-list.price-sale < 29 then do:
     3745         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     3746           assign
     3747             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     3748           .
     3749         end.
     3750       end.
     3751       else do:
     3752         if (buf-price-list.price-sale modulo 10) < 3 then do:
     3753           assign
     3754             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3755                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3756                   - 1 ) * 10
     3757                 + 9
     3758           .
     3759         end.
     3760         else do:
     3761           assign
     3762             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     3763                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     3764                   ) * 10
     3765                 + 9
     3766           .
     3767         end.
     3768         assign
     3769           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3770         .
     3771       end.
     3772     end.
     3773     when '9-99окончание':U then do:
     3774       if buf-price-list.price-sale < r-base then do:
     3775         assign
     3776           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     3777         .
     3778       end.
     3779       else do:
     3780         assign
     3781           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     3782         .
     3783       end.
     3784     end.
     3785     when 'Без-дробных':U then do:
     3786       assign
     3787         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     3788       .
     3789     end.
     3790     when 'Произвольно':U then do:
     3791       if r-base <> 0 then do:
     3792         assign
     3793           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     3794         .
     3795         if buf-price-list.price-sale = 0 then do:
     3796           assign
     3797             buf-price-list.price-sale = r-base
     3798           .
     3799         end.
     3800       end.
     3801     end.
     3802     when 'Вверх':U then do:
     3803       if r-base <> 0 then do:
     3804         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     3805           assign
     3806             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     3807           .
     3808         end.
     3809       end.
     3810       if buf-price-list.price-sale = 0 then do:
     3811         assign
     3812           buf-price-list.price-sale = r-base
     3813         .
     3814       end.
     3815     end.
     3816     when 'Коэффициент':U then do:
     3817       if r-base <> 0 then do:
     3818         assign
     3819           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     3820         .
     3821       end.
     3822     end.
     3823     when 'Отключено':U then do:
     3824     end.
     3825     otherwise do:
     3826       message
     3827         vss-workfile vss-revision vss-description skip
     3828         "Неизвестный метод округления продажной цены" skip
     3829         "round-method" r-method skip
     3830         "round-base"   r-base   skip
     3831         "price"        buf-price-list.price-sale             skip
     3832         view-as alert-box error .
     3833     end.
     3834   end.
     3835     end.
     3836   end.
     3837   END PROCEDURE.
     3838   PROCEDURE calc-pr-discnt:
     3839   define input parameter d-num like ub.price-doc.doc-num no-undo.
     3840   define input parameter bc    like ub.bar-code.b-code   no-undo.
     3841   define buffer buf-price-doc  for ub.price-doc.
     3842   define buffer buf-price-list for ub.price-list.
     3843   define buffer buf-bar-code   for ub.bar-code.
     3844   define buffer buf-goods      for ub.goods.
     3845   define buffer old-price-list for ub.price-list.
     3846   define variable pr-rec   as   recid                  no-undo.
     3847   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     3848   pr-discnt:
     3849   do on error undo pr-discnt, return error:
     3850     find  buf-price-doc where
     3851           buf-price-doc.doc-num = d-num.
     3852     find  buf-bar-code no-lock where
     3853           buf-bar-code.b-code = bc.
     3854     find  buf-goods no-lock where
     3855           buf-goods.gds-code = buf-bar-code.gds-code.
     3856     find  buf-price-list where
     3857           buf-price-list.doc-num = buf-price-doc.doc-num and
     3858           buf-price-list.b-code  = bc.
     3859     buf-price-list.d-pcnt = (1 -
     3860                              buf-price-list.price-sale /
     3861                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     3862                              buf-bar-code.cli-base-rate) *
     3863                              100
     3864                              .
     3865   end.
     3866   END PROCEDURE.
     3867   PROCEDURE calc-pr-sub :
     3868   define  input  parameter bc             like ub.price-list.b-code no-undo.
     3869   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     3870   define  input  parameter calc-method  as character    no-undo.
     3871   define  input  parameter increase-pc  as decimal      no-undo.
     3872   define  input  parameter round-method as character    no-undo.
     3873   define  input  parameter round-base   as decimal      no-undo.
     3874   define  output parameter calc-rec     as recid        no-undo.
     3875   define  buffer buf-price-list for ub.price-list.
     3876   define  buffer buf-bar-code   for ub.bar-code.
     3877   define  buffer buf-goods      for ub.goods.
     3878   define  buffer buf-gds-prt    for ub.gds-prt.
     3879   define  buffer buf-gds-grp    for ub.gds-grp.
     3880   define  buffer buf-price-doc  for ub.price-doc.
     3881   calc-sub:
     3882   do on error undo calc-sub, return error:
     3883     find  buf-bar-code no-lock where
     3884           buf-bar-code.b-code = bc.
     3885     find  buf-goods no-lock where
     3886           buf-goods.gds-code = buf-bar-code.gds-code.
     3887     find  buf-gds-prt no-lock where
     3888           buf-gds-prt.node-code = buf-bar-code.node-code.
     3889     find  buf-price-list where
     3890           buf-price-list.doc-num    = d-num and
     3891           buf-price-list.b-code     = bc and
     3892           buf-price-list.price-type = "".
     3893     find  buf-price-doc where
     3894           buf-price-doc.doc-num = d-num.
     3895     calc-rec = recid (buf-price-list).
     3896     if buf-price-list.main-price then do:
     3897       for each  buf-price-list where
     3898                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3899                 buf-price-list.main-price = no and
     3900                 buf-price-list.artic      = buf-goods.artic and
     3901                 buf-price-list.prod-type  = buf-goods.prod-type and
     3902                 buf-price-list.prod-code  = buf-goods.prod-code,
     3903           first buf-bar-code no-lock where
     3904                 buf-bar-code.b-code   = buf-price-list.b-code and
     3905                 buf-bar-code.unit-cli = buf-goods.unit-base
     3906           on error undo calc-sub, return error:
     3907         run calc-pr-list (input  buf-bar-code.b-code,
     3908                           input  buf-price-list.doc-num,
     3909                           input  calc-method,
     3910                           input  increase-pc,
     3911                           input  round-method,
     3912                           input  round-base,
     3913                           input ? ,
     3914                           input ? ,
     3915                           input ? ,
     3916                           input ? ,
     3917                           output calc-rec) no-error.
     3918         if error-status :error then
     3919           undo calc-sub, return error.
     3920         calc-rec = recid (buf-price-list).
     3921       end.
     3922       for each  buf-price-list where
     3923                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     3924                 buf-price-list.main-price = no and
     3925                 buf-price-list.artic      = buf-goods.artic and
     3926                 buf-price-list.prod-type  = buf-goods.prod-type and
     3927                 buf-price-list.prod-code  = buf-goods.prod-code,
     3928           first buf-bar-code no-lock where
     3929                 buf-bar-code.b-code    = buf-price-list.b-code and
     3930                 buf-bar-code.unit-cli <> buf-goods.unit-base
     3931           on error undo calc-sub, return error:
     3932         run calc-pr-alt (input buf-price-doc.doc-num,
     3933                         input buf-bar-code.b-code,
     3934                         input round-method,
     3935                         input round-base) no-error.
     3936         if error-status :error then
     3937           undo calc-sub, return error.
     3938       end.
     3939     end.
     3940     else do:
     3941       run calc-base-upd (input buf-bar-code.b-code,
     3942                         input buf-price-doc.doc-num,
     3943                         input round-method,
     3944                         input round-base) no-error.
     3945       if error-status :error then
     3946         undo calc-sub, return error.
     3947     end.
     3948   end.
     3949   END PROCEDURE.
     3950   procedure ver-pr-nogds :
     3951   define input  parameter p-gds-code      as integer   no-undo .
     3952   define input  parameter p-par-pr-nogds  as character no-undo .
     3953   define output parameter p-not           as logical   no-undo .
     3954   define output parameter p-str           as character no-undo .
     3955   define buffer buf_goods for ub.goods  .
     3956   define variable nn as integer   no-undo .
     3957   define variable ii as integer   no-undo .
     3958   define variable v-namegrp as character no-undo .
     3959     do
     3960     on error undo, return error return-value
     3961     :
     3962     if p-par-pr-nogds = "1" then do:
     3963        assign
     3964         p-not = true
     3965         p-str = ""
     3966        .
     3967        return .
     3968     end.
     3969     assign
     3970       p-not = false
     3971       p-str = ""
     3972     .
     3973     find first buf_goods no-lock where
     3974                buf_goods.gds-code = p-gds-code no-error .
     3975     nn = num-entries(par-pr-nogds-long,chr(4)) .
     3976     repeat ii = 1 to nn:
     3977        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     3978        if buf_goods.grp-name  begins v-namegrp  then do:
     3979           assign
     3980             p-not = true
     3981             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     3982           .
     3983           leave .
     3984        end.
     3985     end.
     3986     end.
     3987   end procedure.
     3988   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3989   define temp-table tt-level-dis-attr no-undo
     3990         field attr-code   like global-state-attr.attr-code
     3991         field attr-value  like global-state-attr.attr-value
     3992         index pi   attr-value descending
     3993         index pi1 is unique attr-value
     3994               attr-code .
     3995   procedure lvldsc-byattr :
     3996   define input  parameter p-attr-code  as character no-undo .
     3997   define input  parameter p-attr-value as character no-undo .
     3998   define output parameter p-val1       as decimal   no-undo .
     3999   define output parameter p-val2       as decimal   no-undo .
     4000   define output parameter p-prc        as decimal   no-undo .
     4001     do
     4002     on error undo, return error return-value
     4003     :
     4004     define variable v-str1 as character no-undo .
     4005     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     4006     v-str1 = trim ( v-str1 , chr(4) ) .
     4007    run lvldsc-bytt (
     4008         input   v-str1
     4009       , input   p-attr-value
     4010       , output  p-val1
     4011       , output  p-val2
     4012       , output  p-prc )
     4013         no-error .
     4014     end.
     4015   end procedure.
     4016   procedure lvldsc-bytt :
     4017   define input  parameter p-attr-code as character no-undo .
     4018   define input  parameter p-attr-value as character no-undo .
     4019   define output parameter p-val1 as decimal   no-undo .
     4020   define output parameter p-val2 as decimal   no-undo .
     4021   define output parameter p-prc  as decimal   no-undo .
     4022   define variable v-str1 as character no-undo .
     4023     do
     4024     on error undo, return error return-value
     4025     :
     4026     assign
     4027        v-str1 = trim ( p-attr-code , "[]()" )
     4028        p-val1 = decimal(entry(1,v-str1, ";"))
     4029        p-val2 = decimal(entry(2,v-str1, ";"))
     4030        p-prc  = decimal(p-attr-value)
     4031        no-error
     4032     .
     4033     end.
     4034   end procedure.
     4035   procedure level-dis-value :
     4036   define input  parameter p-price-prod as decimal   no-undo .
     4037   define input  parameter p-b-code     as integer   no-undo .
     4038   define input  parameter p-obj-type   as character no-undo .
     4039   define input  parameter p-obj-code   as integer   no-undo .
     4040   define output parameter p-prc as decimal   no-undo .
     4041   define variable v-level-dis-attr as character no-undo .
     4042   define variable v-type as character no-undo .
     4043   define variable v-val1 as decimal   no-undo .
     4044   define variable v-val2 as decimal   no-undo .
     4045   define variable v-prc  as decimal   no-undo .
     4046   define variable ix     as integer   no-undo .
     4047   do
     4048    on error undo, return error return-value
     4049    :
     4050   define buffer buf_goods for ub.goods  .
     4051   define buffer buf_bar-code for ub.bar-code  .
     4052   find first buf_bar-code no-lock where
     4053              buf_bar-code.b-code = p-b-code
     4054              no-error .
     4055   find first buf_goods no-lock where
     4056              buf_goods.gds-code = buf_bar-code.gds-code
     4057              no-error .
     4058   run ggoattr-value (
     4059      input   buf_goods.grp-code
     4060     ,input   v-cntxt-host-code-obj
     4061     ,input   p-obj-type
     4062     ,input   p-obj-code
     4063     ,input   'level-dis':U
     4064     ,output  v-level-dis-attr
     4065     ,output  v-type ) no-error .
     4066   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     4067     create
     4068       tt-level-dis-attr
     4069     .
     4070     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     4071     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     4072   end.
     4073   p-prc = 0 .
     4074     if p-price-prod = 0 then do:
     4075         for each tt-level-dis-attr no-lock
     4076                 :
     4077               run lvldsc-bytt (
     4078                 input   tt-level-dis-attr.attr-code
     4079               , input   tt-level-dis-attr.attr-value
     4080               , output  v-val1
     4081               , output  v-val2
     4082               , output  v-prc  )
     4083               .
     4084               if v-val1  = 0  then do:
     4085                  p-prc = v-prc .
     4086                 leave.
     4087               end.
     4088         end.
     4089     end.
     4090     else do:
     4091         for each tt-level-dis-attr no-lock
     4092                 :
     4093               run lvldsc-bytt (
     4094                 input   tt-level-dis-attr.attr-code
     4095               , input   tt-level-dis-attr.attr-value
     4096               , output  v-val1
     4097               , output  v-val2
     4098               , output  v-prc  )
     4099               .
     4100               if p-price-prod   > v-val1 and
     4101                  p-price-prod  <= v-val2 then do:
     4102                  p-prc = v-prc .
     4103                 leave.
     4104               end.
     4105         end.
     4106     end.
     4107   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     4108    end.
     4109   end procedure.
     4110   procedure calc-price-levelprod :
     4111   define input  parameter p-mode     as integer   no-undo .
     4112   define input  parameter p-rb       as character no-undo .
     4113   define input  parameter p-b-code   as integer   no-undo .
     4114   define input  parameter p-obj-type as character no-undo .
     4115   define input  parameter p-obj-code as integer   no-undo .
     4116   define output parameter p-price-sale as decimal   no-undo .
     4117   define output parameter p-descript-calc as character no-undo .
     4118   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     4119   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     4120   define variable  v-prod-vat        as decimal   no-undo init 0.
     4121   define variable  v-discnt          as decimal   no-undo init 0.
     4122   define buffer buf_goods for ub.goods  .
     4123   define buffer buf_bar-code for ub.bar-code  .
