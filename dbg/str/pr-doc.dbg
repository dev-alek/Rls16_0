     4798   procedure re-open-query-srt-clmnbr-list:
     4799   if cur-clmnbr-list = ? then do:
     4800      open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by ub.price-list.artic by ub.gds-prt.node-code .
     4801   end.
     4802   else do:
     4803      assign re-querybr-list = yes.
     4804      run sort-brbr-list
     4805        (input (if available ub.price-list
     4806                then recid(ub.price-list)
     4807                else ?
     4808               )
     4809        ).
     4810      assign re-querybr-list = no.
     4811   end.
     4812   end.
     4813   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
