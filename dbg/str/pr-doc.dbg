     4279    function func-cost-price return decimal ( input  p-b-code  as integer ,
     4280                                              input  p-gds-code as integer ,
     4281                                              input  p-status_  as character ,
     4282                                              input  p-r-b      as character) .
     4283   define variable f-price as decimal no-undo .
     4284   run proc-cost-price-fact in this-procedure (
     4285         input  p-b-code   ,
     4286         input  p-gds-code ,
     4287         input  p-status_  ,
     4288         input  p-r-b      ,
     4289         output f-price    )
     4290         .
     4291   return (f-price).
     4292   end function.
     4293   function fnc-alt-pr return logical (buffer local-price-list for ub.price-list).
     4294   define variable f-log as logical no-undo .
     4295   define buffer o-price-list for ub.price-list.
     4296   define buffer o-goods      for ub.goods.
     4297   define buffer o-bar-code   for ub.bar-code.
     4298   define buffer b-bar-code   for ub.bar-code.
     4299    f-log = false .
     4300   case local-price-list.main-price :
     4301     when true  then do:
     4302         for each o-price-list no-lock where
     4303                   o-price-list.doc-num    = local-price-list.doc-num and
     4304                   o-price-list.artic      = local-price-list.artic and
     4305                   o-price-list.prod-type  = local-price-list.prod-type and
     4306                   o-price-list.prod-code  = local-price-list.prod-code and
     4307                   o-price-list.price-type = '',
     4308             each o-bar-code no-lock where
     4309                   o-bar-code.b-code = o-price-list.b-code,
     4310             each o-goods no-lock where
     4311                   o-goods.gds-code = o-bar-code.gds-code and
     4312                   o-goods.unit-base <> o-bar-code.unit-cli :
     4313                     f-log = true .
     4314                     leave.
     4315         end.
     4316     end.
     4317     otherwise  do:
     4318         find first b-bar-code no-lock where
     4319                     b-bar-code.b-code  = local-price-list.b-code  no-error .
     4320         for each o-price-list no-lock where
     4321                   o-price-list.doc-num    = local-price-list.doc-num   and
     4322                   o-price-list.artic      = local-price-list.artic     and
     4323                   o-price-list.prod-type  = local-price-list.prod-type and
     4324                   o-price-list.prod-code  = local-price-list.prod-code and
     4325                   o-price-list.price-type = '',
     4326             each o-bar-code no-lock where
     4327                   o-bar-code.b-code     = o-price-list.b-code and
     4328                   o-bar-code.node-code  = b-bar-code.node-code ,
     4329             each o-goods no-lock where
     4330                   o-goods.gds-code   = o-bar-code.gds-code  and
     4331                   o-goods.unit-base <> o-bar-code.unit-cli  :
     4332                     f-log = true .
     4333                     leave.
     4334         end.
     4335     end.
     4336   end case.
     4337   return (f-log).
     4338   end function.
     4339   function fnc-arg-price return decimal (buffer local-price-list for ub.price-list).
     4340     arg-price = local-price-list.price-calc.
     4341     return (arg-price).
     4342   end function.
     4343   function fnc-arg-pc return decimal (buffer local-price-list for ub.price-list).
     4344     arg-pc = (local-price-list.price-sale / local-price-list.price-calc - 1) * 100.
     4345     if arg-pc > 9999 then
     4346       arg-pc = ?.
     4347     return (arg-pc).
     4348   end function.
