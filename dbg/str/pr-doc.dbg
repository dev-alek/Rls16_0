     1389   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1390   procedure check-use-bar-code :
     1391     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     1392     do
     1393     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1394     on stop   undo, return error substitute( "&1. stop", vss-include-info10 )
     1395     on endkey undo, return error substitute( "&1. endkey", vss-include-info10 )
     1396     :
     1397       define buffer buf_bar-code for ub.bar-code .
     1398       find first buf_bar-code no-lock
     1399         where buf_bar-code.b-code     = p-b-code
     1400         no-error .
     1401       if not available buf_bar-code then do:
     1402         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info10, p-b-code ) .
     1403       end.
     1404       if buf_bar-code.stts = integer('99':U) then do:
     1405         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1406                                 + "Выполняется удаление бар-кода"
     1407                                 ,vss-include-info10
     1408                                 ,p-b-code
     1409                                 ,chr(10)
     1410                               ) .
     1411       end.
     1412       if buf_bar-code.stts = integer('79':U) then do:
     1413         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1414                                 + "Бар-код выключен"
     1415                                 ,vss-include-info10
     1416                                 ,p-b-code
     1417                                 ,chr(10)
     1418                               ) .
     1419       end.
     1420       return .
     1421     end.
     1422   end procedure.
