     2207     ,output v-base-rate
     2208     ,output v-base-scale
     2209     )  .
     2210       end.
     2211      assign
     2212       buf_price-doc.base-rate      = v-base-rate
     2213       buf_price-doc.base-scale     = v-base-scale
     2214       buf_price-doc.cr-db-num      = p-curr-db-num
     2215       buf_price-doc.doc-date       = v-obj-current-date
     2216       buf_price-doc.fact-num       = 0
     2217       buf_price-doc.host-code      = v-host-code
     2218       buf_price-doc.is-corr        = false
     2219       buf_price-doc.is-del         = false
     2220       buf_price-doc.obj-code       = p-obj-code
     2221       buf_price-doc.obj-type       = p-obj-type
     2222       buf_price-doc.out-code       = ""
     2223       buf_price-doc.pdf-db         = p-pdf-db-num
     2224       buf_price-doc.pdf-id         = p-pdf-id
     2225       buf_price-doc.plt-db-num     = p-plt-db-num
     2226       buf_price-doc.plt-id         = p-plt-id
     2227       buf_price-doc.PS             = "@ "
     2228       buf_price-doc.rest-base      = 0
     2229       buf_price-doc.rest-last      = 0
     2230       buf_price-doc.rest-qnty      = 0
     2231       buf_price-doc.rest-sale      = 0
     2232       buf_price-doc.sale-base      = 0
     2233       buf_price-doc.status_        = 'новый':U
     2234       .
     2235       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     2236       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     2237       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     2238       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     2239       assign
     2240           p-price-doc-recid = recid ( buf_price-doc )
     2241       .
     2242   end.
     2243   end procedure.
     2244   procedure prcreate-new-price-list :
     2245   do
     2246   on error undo, return error return-value
     2247   :
     2248   define input parameter p-price-doc-recid   as recid                    no-undo.
     2249   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     2250   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     2251   define output parameter p-update           as logical                  no-undo.
     2252   define variable kk as integer no-undo .
     2253   define var v-b-code    like ub.bar-code.b-code     no-undo.
     2254   define variable p-hostcode as int no-undo .
     2255   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     2256   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     2257   define buffer buf_price-doc        for ub.price-doc.
     2258   define buffer buf_price-list       for ub.price-list.
     2259   define buffer buf_bar-code         for ub.bar-code.
     2260   define buffer buf_goods            for ub.goods.
     2261   define buffer buf_root_gds-prt     for ub.gds-prt.
     2262   define buffer buf_gds-prt          for ub.gds-prt.
     2263   find first buf_price-doc no-lock
     2264        where recid( buf_price-doc ) = p-price-doc-recid
     2265   .
     2266   find first buf_goods no-lock
     2267        where buf_goods.gds-code = p-gds-code
     2268   .
     2269   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2270     (input  p-gds-code
     2271     ,input  ?
     2272     ,output v-b-code
     2273     ) no-error .
     2274   if error-status :error
     2275   then do:
     2276       message
     2277           "Не найден основной бар-код"
     2278           skip "для товара "
     2279           skip string(buf_goods.artic)
     2280           skip buf_goods.gds-name
     2281       view-as alert-box
     2282       title "Ошибка при выполнении prcreate.i".
     2283       undo, return error .
     2284   end.
     2285   find first buf_bar-code no-lock
     2286        where buf_bar-code.b-code = v-b-code
     2287   no-error.
     2288   if error-status :error
     2289   then do:
     2290       message
     2291           "Не найдена запись bar-code"
     2292           skip "для товара "
     2293           skip string(buf_goods.artic)
     2294           skip buf_goods.gds-name
     2295           skip "С основным бар-кодом"
     2296           skip string(v-b-code)
     2297       view-as alert-box
     2298       title "Ошибка при выполнении prcreate.i".
     2299       undo, return error .
     2300   end.
     2301   find first buf_root_gds-prt no-lock
     2302        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     2303   .
     2304   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     2305     and buf_bar-code.in-code <> ""
     2306   then do:
     2307       message
     2308           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     2309           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     2310           view-as alert-box error.
     2311       undo, return error.
     2312   end.
     2313   find first buf_gds-prt no-lock
     2314        where buf_gds-prt.node-code = buf_bar-code.node-code
     2315   .
     2316   find first buf_price-list
     2317        where buf_price-list.doc-num = buf_price-doc.doc-num
     2318          and buf_price-list.b-code  = v-b-code
     2319   no-error.
     2320   if available buf_price-list
     2321   then do:
     2322       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     2323          skip "  Цена:   " buf_price-list.price-sale
     2324          skip "Цена будет изменена"
     2325       view-as alert-box warning.
     2326       assign
     2327           p-update = yes
     2328       .
     2329   end.
     2330   else do:
     2331   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2332   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2333     (input  buf_price-doc.obj-type
     2334     ,input  buf_price-doc.obj-code
     2335     ,output p-hostcode
     2336     ) no-error .
     2337   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2339     (input  buf_goods.gds-code
     2340     ,input  '1':U
     2341     ,input  ?
     2342     ,input  p-hostcode
     2343     ,input  buf_price-doc.obj-type
     2344     ,input  buf_price-doc.obj-code
     2345     ,output local_vat-pc
     2346     ) no-error .
     2347   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2349     (input  buf_goods.gds-code
     2350     ,input  '2':U
     2351     ,input  ?
     2352     ,input  p-hostcode
     2353     ,input  buf_price-doc.obj-type
     2354     ,input  buf_price-doc.obj-code
     2355     ,output local_slt-pc
     2356     ) no-error .
     2357       kk = kk + 1.
     2358   define variable v-main-bar-code as integer   no-undo .
     2359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2360     (input  buf_goods.gds-code
     2361     ,input  ?
     2362     ,output v-main-bar-code
     2363     )  .
     2364       create buf_price-list.
     2365       assign
     2366           buf_price-list.line-num    = kk
     2367           buf_price-list.doc-num     = buf_price-doc.doc-num
     2368           buf_price-list.b-code      = buf_bar-code.b-code
     2369           buf_price-list.artic       = buf_goods.artic
     2370           buf_price-list.prod-type   = buf_goods.prod-type
     2371           buf_price-list.prod-code   = buf_goods.prod-code
     2372           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     2373           buf_price-list.calc-method = 'Отсутствует':U
     2374           buf_price-list.obj-type    = buf_price-doc.obj-type
     2375           buf_price-list.obj-code    = buf_price-doc.obj-code
     2376           buf_price-list.price-sale  = p-price-sale
     2377           buf_price-list.vat-pc      = local_vat-pc
     2378           buf_price-list.slt-pc      = local_slt-pc
     2379           p-update                   = no
     2380       .
     2381   end.
     2382   end.
     2383   end procedure.
     2384   procedure create_new_price-doc-forming :
     2385   define input  parameter p-obj-type   as character no-undo .
     2386   define input  parameter p-obj-code   as integer   no-undo .
     2387   define output parameter p-pdf-db-num as integer   no-undo .
     2388   define output parameter p-pdf-id     as integer   no-undo .
     2389   define output parameter p-plt-db-num as integer   no-undo .
     2390   define output parameter p-plt-id     as integer   no-undo .
     2391   define buffer buf_price-list-type for ub.price-list-type  .
     2392   define variable v-host-code  as integer   no-undo .
     2393   define variable v-base-rate  as decimal   no-undo .
     2394   define variable v-base-scale as integer   no-undo .
     2395   define variable v-exch-rate  as decimal   no-undo .
     2396   define variable v-exch-scale as integer   no-undo .
     2397   define variable v-base as logical   no-undo .
     2398     do
     2399     on error undo, return error return-value
     2400     :
     2401   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2403     (output v-base
     2404     )  .
     2405   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2407     (input  p-obj-type
     2408     ,input  p-obj-code
     2409     ,output v-host-code
     2410     )  .
     2411   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     2413     (input  v-host-code
     2414     ,input  today
     2415     ,output v-base-rate
     2416     ,output v-base-scale
     2417     )  .
     2418   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2419   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     2420     (input  ?
     2421     ,input  p-obj-type
     2422     ,input  p-obj-code
     2423     ,input  yes
     2424     ,output p-plt-id
     2425     ,output p-plt-db-num
     2426     )  .
     2427      create ub.price-doc-forming.
     2428      assign
     2429         ub.price-doc-forming.plt-id       = p-plt-id
     2430         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2431         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2432         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2433         ub.price-doc-forming.base-rate    = v-base-rate
     2434         ub.price-doc-forming.base-scale   = v-base-scale
     2435         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     2436         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     2437         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     2438         ub.price-doc-forming.stts         = 0
     2439         ub.price-doc-forming.sys-date     = today
     2440         ub.price-doc-forming.sys-time     = time
     2441         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     2442         ub.price-doc-forming.who          = v-cntxt-userid
     2443         ub.price-doc-forming.name         = "автосоздание"
     2444      .
     2445      assign
     2446       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     2447       p-pdf-id      = ub.price-doc-forming.pdf-id
     2448       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     2449       p-plt-id      = ub.price-doc-forming.plt-id
     2450      .
     2451     end.
     2452   end procedure.
     2453   procedure prcreate-new-price-doc-forming-gds :
     2454   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     2455   define input  parameter p-obj-type   as character no-undo .
     2456   define input  parameter p-obj-code   as integer   no-undo .
     2457   define input  parameter par-pr-notls as character no-undo .
     2458   define input  parameter par-pr-altex as character no-undo .
     2459   define input  parameter par-pr-sclex as character no-undo .
     2460   define input  parameter p-line-num    as integer   no-undo .
     2461   define input  parameter p-gds-code    as integer   no-undo .
     2462   define input  parameter p-price-sale  as decimal   no-undo .
     2463   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     2464   define buffer buf_goods for ub.goods  .
     2465   define buffer buf_bar-code for ub.bar-code  .
     2466   define buffer main_bar-code for ub.bar-code  .
     2467   define variable main-b-code as integer   no-undo .
     2468   define variable v-sec as integer   no-undo .
     2469     do
     2470     on error undo, return error return-value
     2471     :
     2472   define variable v-cur-dn as character no-undo .
     2473   define variable v-cur-pr as decimal   no-undo .
     2474   define variable v-cur-rt as decimal   no-undo .
     2475   define variable v-cur-ex as decimal   no-undo .
     2476   find first buf_price-doc-forming no-lock where
     2477              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     2478              if error-status :error then return error .
     2479   find first buf_goods no-lock where
     2480              buf_goods.gds-code  = p-gds-code no-error .
     2481              if error-status :error then return error .
     2482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2483     (input  buf_goods.gds-code
     2484     ,input  ?
     2485     ,output main-b-code
     2486     ) no-error .
     2487   run check-use-bar-code (main-b-code) no-error .
     2488   if error-status :error then return .
     2489   run create-line-pdf-mpl-lib (
     2490        input buf_price-doc-forming.plt-db-num
     2491       ,input buf_price-doc-forming.plt-id
     2492       ,input buf_price-doc-forming.pdf-db
     2493       ,input buf_price-doc-forming.pdf-id
     2494       ,input p-line-num
     2495       ,input main-b-code
     2496       ,input buf_goods.artic
     2497       ,input buf_goods.prod-type
     2498       ,input buf_goods.prod-code
     2499       ,input ""
     2500       ,input 0
     2501       ,input p-price-sale
     2502       ,input ""
     2503       ,input 0
     2504      ,input-output v-sec ) no-error .
     2505      if error-status :error  then do:
     2506        message
     2507          vss-workfile vss-revision vss-description skip
     2508          error-status :get-message(1) skip
     2509          return-value skip
     2510          "2"
     2511          view-as alert-box error
     2512        .
     2513      end.
     2514   define buffer old_price-list for ub.price-list  .
     2515   if par-pr-notls = "yes" then do:
     2516   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2517   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2518     (input  p-obj-type
     2519     ,input  p-obj-code
     2520     ,input  main-b-code
     2521     ,input  0
     2522     ,input  0
     2523     ,output v-cur-dn
     2524     ,output v-cur-pr
     2525     ,output v-cur-rt
     2526     ,output v-cur-ex
     2527     )  .
     2528   end.
     2529   if par-pr-altex = "yes" and
     2530      par-pr-notls = "yes" then do:
     2531       if v-cur-dn <> "" then do:
     2532           for each old_price-list no-lock where
     2533                    old_price-list.doc-num = v-cur-dn and
     2534                    old_price-list.artic      = buf_goods.artic and
     2535                    old_price-list.prod-type  = buf_goods.prod-type and
     2536                    old_price-list.prod-code  = buf_goods.prod-code and
     2537                    old_price-list.main-price = no,
     2538                   first buf_bar-code no-lock where
     2539                         buf_bar-code.b-code   = old_price-list.b-code and
     2540                         buf_bar-code.unit-cli <> buf_goods.unit-base
     2541                         :
     2542                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2543                          if error-status :error then next.
     2544                    run create-line-pdf-mpl-lib (
     2545                          input buf_price-doc-forming.plt-db-num
     2546                         ,input buf_price-doc-forming.plt-id
     2547                         ,input buf_price-doc-forming.pdf-db
     2548                         ,input buf_price-doc-forming.pdf-id
     2549                         ,input p-line-num
     2550                         ,input old_price-list.b-code
     2551                         ,input buf_goods.artic
     2552                         ,input buf_goods.prod-type
     2553                         ,input buf_goods.prod-code
     2554                         ,input ""
     2555                         ,input 0
     2556                         ,input old_price-list.price-sale
     2557                         ,input ""
     2558                         ,input 0
     2559                        ,input-output v-sec ) no-error .
     2560           end.
     2561       end.
     2562   end.
     2563   if par-pr-sclex = "yes" and
     2564      par-pr-notls = "yes" then do:
     2565       if v-cur-dn <> "" then do:
     2566           for each old_price-list no-lock where
     2567                    old_price-list.doc-num    = v-cur-dn and
     2568                    old_price-list.artic      = buf_goods.artic and
     2569                    old_price-list.prod-type  = buf_goods.prod-type and
     2570                    old_price-list.prod-code  = buf_goods.prod-code and
     2571                    old_price-list.main-price = no,
     2572                   first buf_bar-code no-lock where
     2573                         buf_bar-code.b-code   = old_price-list.b-code and
     2574                         buf_bar-code.in-code  = "" and
     2575                         buf_bar-code.unit-cli = buf_goods.unit-base
     2576                         :
     2577                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2578                          if error-status :error then next.
     2579                    run create-line-pdf-mpl-lib (
     2580                          input buf_price-doc-forming.plt-db-num
     2581                         ,input buf_price-doc-forming.plt-id
     2582                         ,input buf_price-doc-forming.pdf-db
     2583                         ,input buf_price-doc-forming.pdf-id
     2584                         ,input p-line-num
     2585                         ,input old_price-list.b-code
     2586                         ,input buf_goods.artic
     2587                         ,input buf_goods.prod-type
     2588                         ,input buf_goods.prod-code
     2589                         ,input ""
     2590                         ,input 0
     2591                         ,input old_price-list.price-sale
     2592                         ,input ""
     2593                         ,input 0
     2594                       ,input-output v-sec ) no-error .
     2595           end.
     2596       end.
     2597   end.
     2598   end.
     2599   end procedure.
     2600   procedure copy_new_price-doc-forming :
     2601   define input  parameter       p-recid      as recid no-undo .
     2602   define input-output parameter p-plt-db-num as integer   no-undo .
     2603   define input-output parameter p-plt-id     as integer   no-undo .
     2604   define output parameter       p-pdf-db-num as integer   no-undo .
     2605   define output parameter       p-pdf-id     as integer   no-undo .
     2606   define buffer buf_price-list-type        for ub.price-list-type  .
     2607   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     2608   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     2609   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     2610   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     2611   define variable v-host-code  as integer   no-undo .
     2612   define variable v-base-rate  as decimal   no-undo .
     2613   define variable v-base-scale as integer   no-undo .
     2614   define variable v-exch-rate  as decimal   no-undo .
     2615   define variable v-exch-scale as integer   no-undo .
     2616   define variable v-base as logical   no-undo .
     2617   define variable v-name as character no-undo .
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2623     (output v-base
     2624     )  .
     2625   find first buf_price-list-type no-lock where
     2626              buf_price-list-type.plt-db-num = p-plt-db-num and
     2627              buf_price-list-type.plt-id     = p-plt-id no-error .
     2628   if error-status :error then return error "Не найден ТПЛ".
     2629   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     2630   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     2631       if available buf_price-doc-forming then do :
     2632           assign
     2633             v-base-rate  = buf_price-doc-forming.base-rate
     2634             v-base-scale = buf_price-doc-forming.base-scale
     2635             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     2636           .
     2637       end.
     2638       else do:
     2639           assign
     2640             v-base-rate  = 1
     2641             v-base-scale = 1
     2642             v-name       = "Автосоздание"
     2643           .
     2644       end.
     2645      create ub.price-doc-forming.
     2646      assign
     2647         ub.price-doc-forming.plt-id       = p-plt-id
     2648         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2649         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2650         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2651         ub.price-doc-forming.base-rate    = v-base-rate
     2652         ub.price-doc-forming.base-scale   = v-base-scale
     2653         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     2654         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     2655         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     2656         ub.price-doc-forming.stts         = 0
     2657         ub.price-doc-forming.sys-date     = today
     2658         ub.price-doc-forming.sys-time     = time
     2659         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     2660         ub.price-doc-forming.who          = v-cntxt-userid
     2661         ub.price-doc-forming.name         = v-name
     2662      .
     2663      assign
     2664       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     2665       p-pdf-id      = ub.price-doc-forming.pdf-id
     2666       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     2667       p-plt-id      = ub.price-doc-forming.plt-id
     2668      .
     2669     end.
     2670     if not available buf_price-doc-forming then return .
     2671   for each buf_price-doc-forming-attr no-lock where
     2672            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2673            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2674            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2675            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2676       create ub.price-doc-forming-attr.
     2677       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     2678       assign
     2679         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     2680         ub.price-doc-forming-attr.plt-id      = p-plt-id
     2681         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     2682         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     2683         .
     2684   end.
     2685   for each buf_price-doc-forming-gds no-lock where
     2686            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     2687            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     2688            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2689            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     2690       create ub.price-doc-forming-gds.
     2691       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     2692       assign
     2693         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     2694         ub.price-doc-forming-gds.plt-id      = p-plt-id
     2695         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     2696         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     2697       .
     2698   end.
     2699   for each buf_pd-forming-gds-attr no-lock where
     2700            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2701            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2702            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2703            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2704       create ub.price-doc-forming-gdsattr.
     2705       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     2706       assign
     2707         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     2708         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     2709         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     2710         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     2711       .
     2712   end.
     2713   end procedure.
     2714   define variable par-pr-incpc as character no-undo.
     2715   define variable par-pr-rndmt as character no-undo.
     2716   define variable par-pr-rndbs as character no-undo.
     2717   define variable par-pr-clt-q as character no-undo.
     2718   define variable par-pr-dpl-q as character no-undo.
     2719   define variable par-pr-rdc-q as character no-undo.
     2720   define variable par-pr-abs-d as character no-undo.
     2721   define variable par-pr-altex as character no-undo.
     2722   define variable par-pr-parex as character no-undo.
     2723   define variable par-pr-sclex as character no-undo.
     2724   define variable par-pr-notls as character no-undo.
     2725   define variable par-pr-equ-dq as integer  no-undo.
     2726   define variable par-pr-discm as character no-undo .
     2727   define variable par-pr-dscnt as character no-undo .
     2728   define variable par-pr-print as character no-undo .
     2729   define variable par-pr-sigma as character no-undo .
     2730   define variable par-pr-goods as character no-undo.
     2731   define variable par-pr-nogds as character no-undo.
     2732   define variable par-alcohol  as character no-undo.
     2733   define variable par-gen-mrgn-ie as character no-undo .
     2734   define variable par-gen-mrgn-iv as character no-undo .
     2735   define variable par-gen-mrgn-im as character no-undo .
     2736   define variable par-pr-nakl-ie  as logical   no-undo .
     2737   define variable par-pr-nakl-iv  as logical   no-undo .
     2738   define variable par-pr-nakl-im  as logical   no-undo .
     2739   define variable par-pr-nogds-long as longchar no-undo .
     2740   define temp-table tmp-proof-price no-undo
     2741     field node-code like ub.gds-grp.node-code
     2742     field proof as decimal
     2743     field price as decimal
     2744   index pi node-code proof descending .
     2745   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2746   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2747   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2748   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     2749   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     2750   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     2751   ASSIGN
     2752      v-S_CONTRACT                = "Contract":U
     2753      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     2754      v-DELIM_CHR_3               = ","
     2755      .
     2756   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     2757   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     2758   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2759   FUNCTION Can-Find-Spec RETURN LOGICAL (
     2760      INPUT iHost-Code    AS INTEGER,
     2761      INPUT iContract-Num AS INTEGER,
     2762      INPUT iGds-Code     AS INTEGER ):
     2763      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     2764      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     2765      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     2766      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     2767      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     2768      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     2769          INPUT  iHost-Code,
     2770          INPUT  iContract-Num,
     2771          OUTPUT iTmp-Extent3
     2772          ).
     2773      IF iTmp-Extent3[1] = 2 THEN DO:
     2774         ASSIGN
     2775            iTmp-Host-Code      = iTmp-Extent3[2]
     2776            iTmp-Contract-Num   = iTmp-Extent3[3]
     2777            .
     2778      END. ELSE DO:
     2779         ASSIGN
     2780            iTmp-Host-Code      = iHost-Code
     2781            iTmp-Contract-Num   = iContract-Num
     2782            .
     2783      END.
     2784      IF iGds-Code = ? THEN DO:
     2785         ASSIGN
     2786            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2787                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2788                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2789                           ).
     2790      END. ELSE DO:
     2791            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     2792                                  buf_Spec.Host-Code     = iTmp-Host-Code
     2793                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     2794                              AND buf_Spec.Gds-Code      = iGds-Code
     2795                            ).
     2796      END.
     2797      RETURN (lRet).
     2798   END FUNCTION.
     2799   PROCEDURE MS-Contract-EXTENT-3:
     2800      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     2801      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     2802      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     2803      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     2804      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     2805      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     2806      FIND FIRST buf_Cont-2 WHERE
     2807                 buf_Cont-2.Host-Code      = i-Host-Code
     2808             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     2809           NO-LOCK NO-ERROR.
     2810      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     2811         RETURN.
     2812      END.
     2813      FOR FIRST buf_Ext-Classif WHERE
     2814                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2815           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2816                                               STRING(i-Contract-code)
     2817           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2818          NO-LOCK,
     2819          EACH buf_Cont WHERE
     2820               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     2821           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     2822          NO-LOCK:
     2823          ASSIGN
     2824             i-Ret[1] = 1
     2825             i-Ret[2] = buf_Cont.Host-code
     2826             i-Ret[3] = buf_Cont.Contract-code
     2827             .
     2828          LEAVE.
     2829      END.
     2830      IF i-Ret[1] <> 1 THEN DO:
     2831         FOR FIRST buf_Ext-Classif WHERE
     2832                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     2833              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     2834                                                  STRING(i-Contract-code)
     2835              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     2836             NO-LOCK,
     2837             EACH buf_Cont WHERE
     2838                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2839              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     2840             NO-LOCK:
     2841             ASSIGN
     2842                i-Ret[1] = 2
     2843                i-Ret[2] = buf_Cont.Host-code
     2844                i-Ret[3] = buf_Cont.Contract-code
     2845                .
     2846             LEAVE.
     2847         END.
     2848      END.
     2849      RETURN.
     2850   END PROCEDURE.
     2851   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2852   procedure ggoattr-code :
     2853     define input  parameter p-code           as character no-undo .
