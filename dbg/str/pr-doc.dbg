     2145   define input  parameter p-plt-id       as integer   no-undo .
     2146   define input  parameter p-plt-db-num   as integer   no-undo .
     2147   define input  parameter p-pdf-id       as integer   no-undo .
     2148   define input  parameter p-pdf-db-num   as integer   no-undo .
     2149   define output parameter p-price-doc-recid  as recid                no-undo.
     2150   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     2151   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     2152   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     2153   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     2154   define buffer buf_price-doc-forming for ub.price-doc-forming.
     2155   define buffer buf_price-doc         for ub.price-doc.
     2156   find first buf_price-doc-forming no-lock where
     2157              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     2158              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     2159              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     2160              buf_price-doc-forming.plt-id     = p-plt-id
     2161              no-error .
     2162   if not available buf_price-doc-forming and p-plt-id = ? then do:
     2163      run create_new_price-doc-forming
     2164           ( input p-obj-type ,
     2165             input p-obj-code ,
     2166             output p-pdf-db-num ,
     2167             output p-pdf-id ,
     2168             output p-plt-db-num ,
     2169             output p-plt-id
     2170             ).
     2171       find first buf_price-doc-forming no-lock where
     2172                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     2173                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     2174                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     2175                 buf_price-doc-forming.plt-id     = p-plt-id
     2176                 no-error .
     2177   end.
     2178       create buf_price-doc .
     2179       run doc-code in this-procedure
     2180       (input  "main",
     2181        input  p-obj-type  ,
     2182        input  p-obj-code  ,
     2183        input  ?,
     2184        output buf_price-doc.doc-num) no-error.
     2185       if error-status:error then do:
     2186         message vss-workfile vss-revision vss-description skip
     2187                error-status :get-message(1)
     2188               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     2189         return error.
     2190       end.
     2191   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2193     (input  p-obj-type
     2194     ,input  p-obj-code
     2195     ,output v-host-code
     2196     )  .
     2197       v-obj-current-date  = today .
     2198       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     2199           v-base-rate   =  buf_price-doc-forming.base-rate  .
     2200           v-base-scale  =  buf_price-doc-forming.base-scale .
     2201       end.
     2202       else do:
     2203   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2204   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
