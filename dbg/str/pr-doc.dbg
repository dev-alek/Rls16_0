     1429   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-list).
     1430   define variable f-cost     as decimal no-undo .
     1431   define variable f-cost-pc  as decimal no-undo .
     1432   find first ub.goods where ub.goods.artic = local-price-list.artic and
     1433                          ub.goods.prod-type = local-price-list.prod-type and
     1434                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     1435   find ub.gds-obj no-lock where
     1436        ub.gds-obj.gds-code = ub.goods.gds-code and
     1437        ub.gds-obj.obj-type = local-price-list.obj-type and
     1438        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
     1439   if  available ub.gds-obj then
     1440     if ub.goods.gds-type = 'т':U then
     1441       assign
     1442         f-cost = ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base)
     1443         .
     1444       else  f-cost = ?.
     1445   else f-cost = ?.
     1446    f-cost-pc = (round(local-price-list.price-sale / f-cost , 2) - 1) * 100.
     1447     if f-cost-pc > 9999 then
     1448       f-cost-pc = ?.
     1449     return (f-cost-pc).
     1450   end function.
     1451   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-list).
     1452   define variable f-pr     as decimal no-undo .
     1453   define variable f-pr-pc  as decimal no-undo.
     1454   find first ub.goods where ub.goods.artic = local-price-list.artic and
     1455                          ub.goods.prod-type = local-price-list.prod-type and
     1456                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     1457   find ub.gds-obj no-lock where
     1458        ub.gds-obj.gds-code = ub.goods.gds-code and
     1459        ub.gds-obj.obj-type = local-price-list.obj-type and
     1460        ub.gds-obj.obj-code = local-price-list.obj-code  no-error .
     1461   if  available ub.gds-obj then do:
     1462     if ub.goods.gds-type = 'т':U then
     1463       assign
     1464         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     1465         .
     1466       else f-pr = ?.
     1467   end.
     1468   else f-pr = ?.
     1469     f-pr-pc = ( local-price-list.price-sale / f-pr - 1 ) * 100.
     1470     if f-pr-pc > 9999 then
     1471       f-pr-pc = ?.
     1472     return (f-pr-pc).
     1473   end function.
     1474   function fnc-cost return decimal (buffer local-price-list for ub.price-list).
     1475   define variable f-cost   as decimal no-undo .
     1476   find first ub.goods where
     1477              ub.goods.artic = local-price-list.artic and
     1478              ub.goods.prod-type = local-price-list.prod-type and
     1479              ub.goods.prod-code = local-price-list.prod-code no-lock
     1480              no-error .
     1481   find ub.gds-obj no-lock where
     1482        ub.gds-obj.gds-code = ub.goods.gds-code and
     1483        ub.gds-obj.obj-type = local-price-list.obj-type and
     1484        ub.gds-obj.obj-code = local-price-list.obj-code no-error.
     1485   if  available ub.gds-obj then
     1486     if ub.goods.gds-type = 'т':U then
     1487       assign
