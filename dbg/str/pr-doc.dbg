     1489         .
     1490       else  f-cost = ?.
     1491   else f-cost = ?.
     1492     return ( f-cost ).
     1493   end function.
     1494   function fnc-pr return decimal (buffer local-price-list for ub.price-list).
     1495   define variable f-pr   as decimal no-undo .
     1496   find first ub.goods where ub.goods.artic = local-price-list.artic and
     1497                          ub.goods.prod-type = local-price-list.prod-type and
     1498                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     1499   find ub.gds-obj no-lock where
     1500        ub.gds-obj.gds-code = ub.goods.gds-code and
     1501        ub.gds-obj.obj-type = local-price-list.obj-type and
