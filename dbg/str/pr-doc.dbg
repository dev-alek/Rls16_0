     9950                   vat-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     9951           slt-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     9952           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     9953           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     9954         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     9955         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     9956         if transport-base-loc = ? then transport-base-loc = 0.
     9957         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     9958         if other-base-loc     = ? then other-base-loc     = 0.
     9959         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     9960         assign
     9961           transport-cli-loc      = 0
     9962           other-cli-loc          = 0
     9963           road-tax-cli-loc       = ?
     9964           vat-cli-loc            = ?
     9965           slt-cli-loc            = ?
     9966           price-cli-with-tax-loc = ?.
     9967      end.
     9968   ASSIGN
     9969             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     9970       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     9971   .
     9972                if var-pr-r-b = "rubl" then
     9973                    s-cost = price-rubl-with-tax-loc.
     9974                  else
     9975                    s-cost = price-base-with-tax-loc.
     9976                s-qnty = b_doc-line.fact-qnty .
     9977              end.
     9978              else do:
     9979                assign
     9980                 s-cost = 0
     9981                 s-qnty = 0
     9982                .
     9983              end.
     9984              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     9985           end.
     9986           when "cost-vat":u then do:
     9987                run str/gdsnovat.p ('Уч+накл-НДС':U,
     9988                        b_trn-doc.obj-type,
     9989                        b_trn-doc.obj-code,
     9990                        b_trn-doc.host-code,
     9991                        b_doc-line.artic,
     9992                        b_doc-line.prod-type,
     9993                        b_doc-line.prod-code,
     9994                        0 ,
     9995                        b_doc-line.doc-code,
     9996                        ?,
     9997                        ?,
     9998                        output cost-base   ,
     9999                        output cost-rubl   ,
    10000                        output v-price-base  ,
    10001                        output v-price-rubl  ,
    10002                        output cur-rt-base ,
    10003                        output cur-rt-rubl ).
    10004                        if var-pr-r-b = "rubl"
    10005                           then l_price = v-price-rubl.
    10006                           else l_price = v-price-base.
    10007           end.
    10008           when "sale":u then do:
    10009                 l_price = ( if var-pr-r-b = "rubl"
    10010                                then b_doc-line.price-rubl
    10011                                else b_doc-line.price-base ).
    10012           end.
    10013           when "prod":u then do:
    10014   define variable vss-include-info112 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10015   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
    10016   (  input  b_price-list.b-code
    10017    , input  p-obj-type
    10018    , input  p-obj-code
    10019    , output l_pricewithoutvat
    10020    , output l_price
    10021    , output l_prod-vat
    10022    , output v-str
    10023    , output v-str
    10024           )  .
    10025           end.
    10026           when "prod-vat":u then do:
    10027   define variable vss-include-info113 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
    10029   (  input  b_price-list.b-code
    10030    , input  p-obj-type
    10031    , input  p-obj-code
    10032    , output l_price
    10033    , output l_pricewithvat
    10034    , output l_prod-vat
    10035    , output v-str
    10036    , output v-str
    10037           )  .
    10038           end.
    10039         end case.
    10040          run view-price-list-attr (
    10041               input   'full-price-sale':U   ,
    10042               input   b_price-list.b-code       ,
    10043               input   b_price-list.doc-num      ,
    10044               input   b_price-list.price-type   ,
    10045               output  p-attr-value   ).
    10046              if not ( p-attr-value = ? or p-attr-value = "")  then
    10047                      tt-price-sale = decimal(p-attr-value).
    10048                 else  tt-price-sale = b_price-list.price-sale .
    10049           if v-bonus <> ? and v-bonus <> 0 then do:
    10050               l_price0 = l_price .
    10051               l_price = l_price + ( l_price * v-bonus / 100 ) .
    10052           end.
    10053           t-prc = ( (tt-price-sale / v-koff)   / l_price - 1) * 100 .
    10054      end.
    10055   end.
    10056     if  p-prc-max <> ? then do:
    10057       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
    10058       then do:
    10059         message (if b_price-list.main-price = true then "По товару :"
    10060             else "По признаку"  )
    10061             b_price-list.artic
    10062             b_price-list.prod-type
    10063             b_price-list.prod-code skip
    10064             "бар-код: " b_price-list.b-code skip
    10065                             skip
    10066                  fnc-pr  (buffer b_price-list)
    10067             skip
    10068           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
    10069           "Процент не менее :" p-prc-min "%" skip
    10070           "Процент не более :" p-prc-max "%" skip
    10071           "Процент фактический :" t-prc  "%"  skip
    10072           "переоценка " b_price-list.doc-num
    10073               view-as alert-box error .
    10074                 p-err = true .
    10075                 undo , return error .
    10076       end.
    10077       else do:
    10078          if  t-prc = ? then  do:
    10079             if pr-discm = "sale"  then do:
    10080             end.
    10081             else do:
    10082               message (if b_price-list.main-price = true then "По товару :"
    10083               else "По признаку"  )
    10084               b_price-list.artic
    10085               b_price-list.prod-type
    10086               b_price-list.prod-code skip
    10087               "бар-код: " b_price-list.b-code skip
    10088               fnc-pr  (buffer b_price-list) skip
    10089               "Нет базовой цены для расчета процента наценки !" skip
    10090               "Процент торговой наценки вышел за интервал возможных значений !!! " skip
    10091               "Процент не менее :" p-prc-min "%" skip
    10092               "Процент не более :" p-prc-max "%" skip
    10093               "Процент фактический :" t-prc  "%"  skip
    10094               "переоценка " b_price-list.doc-num
    10095               view-as alert-box error .
    10096               p-err = true .
    10097               undo , return error .
    10098           end.
    10099          end.
    10100       end.
    10101     end.
    10102   end.
    10103   end procedure.
    10104   define variable vss-include-info114 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10105   procedure exp-prt :
    10106     define input  parameter  g-code  like ub.goods.gds-code    no-undo.
    10107     define input  parameter  old-num like ub.price-doc.doc-num no-undo.
    10108     define input  parameter  new-num like ub.price-doc.doc-num no-undo.
    10109     define output parameter  new-rec as recid               no-undo.
    10110     do
    10111     on error undo, return error return-value
    10112     :
    10113     define buffer buf-bar-code   for ub.bar-code.
    10114     define buffer buf-goods      for ub.goods.
    10115     define buffer buf-price-list for ub.price-list.
    10116     find buf-goods no-lock where
    10117         buf-goods.gds-code = g-code.
    10118     if par-pr-altex = "yes" and
    10119        par-pr-notls = "yes" then do:
    10120   define variable vss-include-info115 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10121   for each  buf-price-list where
    10122             buf-price-list.doc-num    = old-num and
    10123             buf-price-list.artic      = buf-goods.artic and
    10124             buf-price-list.prod-type  = buf-goods.prod-type and
    10125             buf-price-list.prod-code  = buf-goods.prod-code and
    10126             buf-price-list.main-price = no,
    10127       first buf-bar-code no-lock where
    10128             buf-bar-code.b-code   = buf-price-list.b-code and
    10129             buf-bar-code.unit-cli <> buf-goods.unit-base:
    10130     run cre-pr-list (input  buf-bar-code.b-code,
    10131                      input  new-num,
    10132                      output new-rec) no-error.
    10133     if error-status:error then do:
    10134       message
    10135         "Ошибка cre-pr-list." skip
    10136         "Код:" buf-bar-code.b-code
    10137         view-as alert-box.
    10138       next.
    10139     end.
    10140   end.
    10141     end.
    10142     if par-pr-sclex = "yes" and
    10143       par-pr-notls = "yes" then do:
    10144   define variable vss-include-info116 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10145       define buffer buf_alt-calc_price-doc117 for ub.price-doc .
    10146     find first buf_alt-calc_price-doc117 no-lock
    10147       where buf_alt-calc_price-doc117.doc-num = old-num
    10148       .
    10149     define variable v-ok as logical   no-undo .
    10150   define variable vss-include-info118 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10151   do:
    10152     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10153       (input  v-cntxt-db-num
    10154       ,input  v-cntxt-userid
    10155       ,input  0
    10156       ,input  'actn_overvalue_properties':U
    10157       ,input  'object':U
    10158       ,input  buf_alt-calc_price-doc117.host-code
    10159       ,input  buf_alt-calc_price-doc117.obj-type
    10160       ,input  buf_alt-calc_price-doc117.obj-code
    10161       ,input  0
    10162       ,input  0
    10163       ,input  0
    10164       ,input  false
    10165       ,output v-ok
    10166       )  .
    10167   end.
    10168     if v-ok then do:
    10169   for each  buf-price-list where
    10170             buf-price-list.doc-num    = old-num and
    10171             buf-price-list.artic      = buf-goods.artic and
    10172             buf-price-list.prod-type  = buf-goods.prod-type and
    10173             buf-price-list.prod-code  = buf-goods.prod-code and
    10174             buf-price-list.main-price = no,
    10175       first buf-bar-code no-lock where
    10176             buf-bar-code.b-code   = buf-price-list.b-code and
    10177             buf-bar-code.in-code = "" and
    10178             buf-bar-code.unit-cli = buf-goods.unit-base:
    10179     run cre-pr-list (input  buf-bar-code.b-code,
    10180                      input  new-num,
    10181                      output new-rec) no-error.
    10182     if error-status:error then do:
    10183       message
    10184         "Ошибка cre-pr-list." skip
    10185         "Код:" buf-bar-code.b-code
    10186         view-as alert-box.
    10187       next.
    10188     end.
    10189   end.
    10190   end.
    10191     end.
    10192     end.
    10193   end procedure.
    10194   procedure disable_ui :
    10195     hide frame d-pr-doc.
    10196   end procedure.
    10197   procedure mode-on :
    10198   define variable v-today as date      no-undo.
    10199   define variable new-doc-rec as recid no-undo .
    10200   define buffer old-doc for ub.price-doc.
    10201   if doc-mode = 'ДОБАВЛЕНИЕ':U then do:
    10202     find last old-doc where old-doc.obj-type = v-cntxt-obj-type
    10203                         and old-doc.obj-code = v-cntxt-obj-code
    10204                         and old-doc.status_ = 'новый':U no-lock no-error.
    10205     if available old-doc then do:
    10206       g#log = yes.
    10207       message "По" v-cntxt-obj-type v-cntxt-obj-code "имеется незакрытый приказ №" old-doc.doc-num "от" old-doc.doc-date
    10208               ". Вы уверены, что Вы хотите создать новый приказ ? ОТКАЗ от создания - cancel."
    10209               view-as alert-box question buttons ok-cancel update g#log.
    10210       if not g#log then   do:
    10211           undo, return error.
    10212           end.
    10213     end.
    10214     run prcreate-new-price-doc in this-procedure
    10215       ( input v-cntxt-db-num ,
    10216         input v-cntxt-obj-type ,
    10217         input v-cntxt-obj-code ,
    10218         ?,?,?,?,
    10219         output new-doc-rec ) no-error .
    10220         if error-status :error then
    10221             message vss-workfile vss-revision vss-description skip
    10222             error-status :get-message(1)
    10223             "Ошибка при создании документа переоценки "
    10224             view-as alert-box error .
    10225      doc-rec = new-doc-rec .
    10226      find first p-doc where recid(p-doc) = doc-rec  exclusive-lock  .
    10227   end.
    10228   else do:
    10229     if doc-mode = 'ИЗМЕНЕНИЕ':U then do:
    10230       find p-doc where recid (p-doc) = doc-rec no-error.
    10231       if available p-doc then do:
    10232          if lookup ( p-doc.status_ , 'приказ,разрешен,акт':U)  > 0 then do:
    10233            message "Приказ/Акт переоценки №" p-doc.doc-num
    10234                    "для" p-doc.obj-type p-doc.obj-code "от"
    10235                    p-doc.doc-date "закрыт. Изменение невозможно."
    10236                    view-as alert-box error.
    10237            undo, return error.
    10238          end.
    10239        end.
    10240     end.
    10241     if not available p-doc then do:
    10242       message "Неправильный выбор документа."
    10243               view-as alert-box error.
    10244       undo, return error.
    10245     end.
    10246   end.
    10247   end procedure.
    10248   procedure cre-line:
    10249   def input param bc    like ub.price-list.b-code no-undo.
    10250   define variable v-ret as logical no-undo .
    10251   define buffer buf-bar-code  for ub.bar-code.
    10252   define buffer buf-goods     for ub.goods.
    10253   define buffer buf-gds-prt   for ub.gds-prt.
    10254   find  buf-bar-code no-lock where
    10255         buf-bar-code.b-code = bc.
    10256     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
    10257     if error-status :error then do:
    10258       message
    10259         return-value skip
    10260         "Ошибка !"
    10261         view-as alert-box error
    10262       .
    10263       undo, return error.
    10264     end.
    10265   find  buf-goods no-lock where
    10266         buf-goods.gds-code = buf-bar-code.gds-code.
    10267   find  buf-gds-prt no-lock where
    10268         buf-gds-prt.node-code = buf-bar-code.node-code.
    10269       run ver-modificator-price-is-null in this-procedure (
    10270           input    buf-goods.artic        ,
    10271           input    buf-goods.prod-type    ,
    10272           input    buf-goods.prod-code    ,
    10273           input    p-doc.obj-type   ,
    10274           input    p-doc.obj-code   ,
    10275           output   v-ret ).
    10276       if v-ret = false then do:
    10277       message
    10278         "На модификатор : " skip
    10279         "Артикул : "buf-goods.artic skip
    10280         buf-goods.gds-name skip
    10281         "не должно быть цены! "
    10282         view-as alert-box information .
    10283         undo, return error.
    10284     end.
    10285   if par-pr-dpl-q = "yes" then do:
    10286     find first ub.price-list where
    10287                ub.price-list.b-code   = bc and
    10288                ub.price-list.obj-type = p-doc.obj-type and
    10289                ub.price-list.obj-code = p-doc.obj-code and
    10290                ub.price-list.doc-num <> p-doc.doc-num and
    10291                ub.price-list.fact-order = 0
    10292                no-lock   no-error.
    10293     if available ub.price-list then do:
    10294       g#log = yes.
    10295       message "Строка :" ub.price-list.artic buf-goods.gds-name
    10296               "ЕСТЬ в Приказе №" ub.price-list.doc-num
    10297               "для" p-doc.obj-type p-doc.obj-code skip
    10298               "Продолжать?"
    10299               view-as alert-box question buttons ok-cancel update g#log.
    10300       if not g#log then
    10301         undo, return error.
    10302     end.
    10303   end.
    10304   find  ub.price-list where
    10305         ub.price-list.b-code  = bc and
    10306         ub.price-list.price-type = "" and
    10307         ub.price-list.doc-num = p-doc.doc-num  no-error.
    10308   if available ub.price-list then do:
    10309     line-rec = recid (ub.price-list).
    10310     new-pr-recid = line-rec.
    10311     if ub.price-list.calc-method <> "" and
    10312        buf-gds-prt.upper-code = buf-goods.prt-root then do:
    10313           if par-pr-clt-q = "yes" then do:
    10314             g#log = yes.
    10315             message "Строка :" ub.price-list.artic buf-goods.gds-name
    10316                     "уже ЕСТЬ в заполняемом Приказе, цена =" ub.price-list.price-sale skip
    10317                     "Продолжать?"
    10318                     view-as alert-box question buttons ok-cancel update g#log.
    10319             if not g#log then  do:
    10320                undo, return error.
    10321                end.
    10322           end.
    10323     end.
    10324   end.
    10325   else do:
    10326     run cre-pr-list in this-procedure (input  bc,
    10327                      input  p-doc.doc-num,
    10328                      output line-rec) no-error.
    10329     if error-status :error then do:
    10330       undo, return error.
    10331       end.
    10332      new-pr-recid = line-rec.
    10333   end.
    10334   end procedure.
    10335   procedure pro-list :
    10336   def input param fnc as char no-undo.
    10337   define variable l-c as integer no-undo.
    10338   run waitfram-show in this-procedure ("ЖДИТЕ.  Заполняется список...").
    10339   l-c = 0.
    10340   if fnc = "b-add" then do:
    10341     if calc-method = 'Накладная':U or
    10342        calc-method = 'НсП+накл':U or
    10343        calc-method = 'Накл-безНДС':U then do:
    10344       for each ub.doc-line no-lock where
    10345                ub.doc-line.doc-code = doc-code,
    10346           each ub.goods no-lock where
    10347                ub.goods.artic = ub.doc-line.artic and
    10348                ub.goods.prod-type = ub.doc-line.prod-type and
    10349                ub.goods.prod-code = ub.doc-line.prod-code:
    10350         l-c = l-c + 1.
    10351         if l-c modulo 25 = 0 then
    10352           run waitfram-show in this-procedure ("Заполнено строк по накладной : " + string (l-c)).
    10353   define variable vss-include-info119 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10354   find gds-list
    10355     where gds-list.prod-type = goods.prod-type
    10356       and gds-list.prod-code = goods.prod-code
    10357       and gds-list.artic     = goods.artic
    10358     no-error .
    10359   if available gds-list then do:
    10360     assign
    10361       gds-list.to-del = no
    10362     .
    10363   end.
    10364   else do:
    10365     define variable v-last119 as integer no-undo .
    10366     find last gds-list use-index oi no-error.
    10367     if available gds-list then do:
    10368       v-last119 = gds-list.order-num .
    10369     end.
    10370     else do:
    10371       v-last119 = 0 .
    10372     end.
    10373     create gds-list .
    10374     buffer-copy goods to gds-list
    10375     assign
    10376       gds-list.to-del = no
    10377       gds-list.order-num = v-last119 + 1
    10378     .
    10379     assign
    10380       lns-cnt = lns-cnt + 1
    10381       line-rec = recid (gds-list)
    10382     .
    10383   end.
    10384         process events.
    10385       end.
    10386     end.
    10387     if calc-method = 'Переоценка':U then do:
    10388       for  each prev-list no-lock where
    10389                 prev-list.doc-num = doc-code,
    10390            each ub.goods no-lock where
    10391                 ub.goods.artic = prev-list.artic and
    10392                 ub.goods.prod-type = prev-list.prod-type and
    10393                 ub.goods.prod-code = prev-list.prod-code:
    10394         l-c = l-c + 1.
    10395         if l-c modulo 25 = 0 then
    10396           run waitfram-show in this-procedure ( "Заполнено строк по переоценке : " + string (l-c) ).
    10397   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10398   find gds-list
    10399     where gds-list.prod-type = goods.prod-type
    10400       and gds-list.prod-code = goods.prod-code
    10401       and gds-list.artic     = goods.artic
    10402     no-error .
    10403   if available gds-list then do:
    10404     assign
    10405       gds-list.to-del = no
    10406     .
    10407   end.
    10408   else do:
    10409     define variable v-last120 as integer no-undo .
    10410     find last gds-list use-index oi no-error.
    10411     if available gds-list then do:
    10412       v-last120 = gds-list.order-num .
    10413     end.
    10414     else do:
    10415       v-last120 = 0 .
    10416     end.
    10417     create gds-list .
    10418     buffer-copy goods to gds-list
    10419     assign
    10420       gds-list.to-del = no
    10421       gds-list.order-num = v-last120 + 1
    10422     .
    10423     assign
    10424       lns-cnt = lns-cnt + 1
    10425       line-rec = recid (gds-list)
    10426     .
    10427   end.
    10428         process events.
    10429       end.
    10430     end.
    10431   end.
    10432   else do:
    10433     for each ub.price-list where
    10434              ub.price-list.doc-num    = p-doc.doc-num and
    10435              ub.price-list.main-price = yes,
    10436         each ub.goods no-lock where
    10437              ub.goods.artic     = ub.price-list.artic and
    10438              ub.goods.prod-type = ub.price-list.prod-type and
    10439              ub.goods.prod-code = ub.price-list.prod-code:
    10440       l-c = l-c + 1.
    10441       if l-c modulo 25 = 0 then
    10442         run waitfram-show in this-procedure ("ЖДИТЕ.  Документ переносится в список : " + string (l-c)).
    10443   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10444   find gds-list
    10445     where gds-list.prod-type = goods.prod-type
    10446       and gds-list.prod-code = goods.prod-code
    10447       and gds-list.artic     = goods.artic
    10448     no-error .
    10449   if available gds-list then do:
    10450     assign
    10451       gds-list.to-del = no
    10452     .
    10453   end.
    10454   else do:
    10455     define variable v-last121 as integer no-undo .
    10456     find last gds-list use-index oi no-error.
    10457     if available gds-list then do:
    10458       v-last121 = gds-list.order-num .
    10459     end.
    10460     else do:
    10461       v-last121 = 0 .
    10462     end.
    10463     create gds-list .
    10464     buffer-copy goods to gds-list
    10465     assign
    10466       gds-list.to-del = no
    10467       gds-list.order-num = v-last121 + 1
    10468     .
    10469     assign
    10470       lns-cnt = lns-cnt + 1
    10471       line-rec = recid (gds-list)
    10472     .
    10473   end.
    10474       ub.price-list.doc-qnty = 0.
    10475       process events.
    10476     end.
    10477   end.
    10478   for each gds-list where gds-list.to-del = yes:
    10479     delete gds-list.
    10480   end.
    10481   run waitfram-hide in this-procedure .
    10482   if fnc <> "b-add" then
    10483      run str/gds-list.w
    10484          ( parParentProc, p-doc.host-code, p-doc.obj-type, p-doc.obj-code).
    10485   doc-rec = recid (p-doc).
    10486   g#log = yes.
    10487   case fnc :
    10488     when "b-chg" then
    10489       message "Рассчитать цены по всем строкам списка ?"
    10490               "Вы уверены ?"
    10491               view-as alert-box question buttons ok-cancel update g#log.
    10492     when "b-del" then
    10493       message "В документе будут только те строки, которые оставлены в списке."
    10494               "Вы уверены ?"
    10495               view-as alert-box question buttons ok-cancel update g#log.
    10496   end.
    10497   if not g#log then
    10498     return.
    10499   run waitfram-show in this-procedure ("ЖДИТЕ.  Список переносится в документ...").
    10500   lns-cnt = 0.
    10501   for each  gds-list,
    10502       first ub.gds-prt no-lock where
    10503             ub.gds-prt.upper-code = gds-list.prt-root,
    10504       first ub.bar-code no-lock where
    10505             ub.bar-code.gds-code  = gds-list.gds-code and
    10506             ub.bar-code.node-code = ub.gds-prt.node-code and
    10507             ub.bar-code.in-code   = "" and
    10508             ub.bar-code.part-code = "" and
    10509             ub.bar-code.unit-cli  = gds-list.unit-base:
    10510     lns-cnt = lns-cnt + 1.
    10511     if lns-cnt modulo 25 = 0 then
    10512       run waitfram-show in this-procedure ("ЖДИТЕ.  Переписано строк : " + string (lns-cnt)).
    10513     if ( calc-method = 'Накладная':U or
    10514          calc-method = 'НсП+накл':U or
    10515          calc-method = 'Накл-безНДС':U or
    10516          calc-method = 'Переоценка':U )
    10517           and  fnc = "b-add" then do:
    10518       run cre-line in this-procedure (ub.bar-code.b-code) no-error.
    10519       if error-status:error then do:  next.  end.
    10520     end.
    10521     find ub.price-list where
    10522          ub.price-list.doc-num    = p-doc.doc-num and
    10523          ub.price-list.b-code     = ub.bar-code.b-code and
    10524          ub.price-list.price-type = "" no-error .
    10525     if available  ub.price-list then do:
    10526       ub.price-list.doc-qnty = ?.
    10527       if lookup (fnc, "b-chg,b-add") > 0 then do:
    10528         define variable p-line-mode as character no-undo .
    10529         p-line-mode = line-mode .
    10530         line-mode = "calc":u.
    10531         run calc-pr-list in this-procedure
    10532                          (input ub.bar-code.b-code,
    10533                           input p-doc.doc-num,
    10534                           input calc-method,
    10535                           input increase-pc,
    10536                           input round-method,
    10537                           input round-base,
    10538                           input ? ,
    10539                           input ? ,
    10540                           input ? ,
    10541                           input ? ,
    10542                           output line-rec) no-error.
    10543         if error-status:error then do:
    10544           line-mode = p-line-mode .
    10545           next.
    10546           end.
    10547         line-mode = p-line-mode .
    10548       end.
    10549     end.
    10550     gds-list.to-del = yes.
    10551     process events.
    10552   end.
    10553   if fnc = "b-del" then do:
    10554     for each ub.price-list no-lock where
    10555              ub.price-list.doc-num = p-doc.doc-num and
    10556              ub.price-list.main-price = yes and
    10557              ub.price-list.doc-qnty = 0:
    10558       run del-pr-list in this-procedure
    10559                        (input ub.price-list.b-code,
    10560                         input p-doc.doc-num,
    10561                         input round-method,
    10562                         input round-base) no-error.
    10563       if error-status :error then
    10564         next.
    10565     end.
    10566   end.
    10567   run open-br in this-procedure .
    10568   doc-rec = recid(p-doc) .
    10569   run waitfram-hide in this-procedure .
    10570   end procedure.
    10571   procedure ui-on :
    10572   doc-rec = recid (p-doc).
    10573   hide loc-art  in frame d-pr-doc.
    10574   hide loc-art loc-name loc-code in frame d-pr-doc.
    10575   loc-art = "".
    10576   enable a-n-c b-exit b-help br-list b-history b-notes b-arch b-alt with frame d-pr-doc.
    10577   frame d-pr-doc:title = if p-doc.status_ = 'акт':U then "Акт" else "Приказ".
    10578   frame d-pr-doc:title = frame d-pr-doc:title + " переоценки № " + p-doc.doc-num +
    10579                               "  для " + p-doc.obj-type + " " + string (p-doc.obj-code) + "  от " +
    10580                               string (p-doc.doc-date) + "      " + doc-mode.
    10581   run upd-disp-tot in this-procedure ("disp").
    10582   if doc-mode = 'ПРОСМОТР':U then do:
    10583     assign
    10584       ub.price-list.price-sale:read-only in browse br-list = yes
    10585       ub.price-list.excise:read-only in browse br-list = yes
    10586       .
    10587     enable b-prev b-next with frame d-pr-doc.
    10588     hide increase-pc calc-method round-method copy-type copy-code doc-code common-price  r-copy in frame d-pr-doc.
    10589   end.
    10590   else do:
    10591     assign
    10592       ub.price-list.price-sale:read-only in browse br-list = no
    10593       ub.price-list.excise:read-only in browse br-list = no
    10594       .
    10595     if v-cntxp-doc-prt then
    10596       enable b-special with frame d-pr-doc.
    10597     display round-method increase-pc round-base with frame d-pr-doc.
    10598     if input round-method = "" then do:
    10599       round-method = 'Отключено':U.
    10600       display round-method with frame d-pr-doc.
    10601     end.
    10602     if input calc-method = "" then do:
    10603       calc-method = 'Отсутствует':U.
    10604       display calc-method with frame d-pr-doc.
    10605     end.
    10606     enable b-add b-chg b-del round-method increase-pc calc-method b-calc with frame d-pr-doc.
    10607     if lookup( input frame d-pr-doc round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
    10608       enable round-base with frame d-pr-doc.
    10609       display round-base with frame d-pr-doc.
    10610     end.
    10611     else
    10612       hide round-base in frame d-pr-doc.
    10613     hide copy-type copy-code doc-code common-price r-copy in frame d-pr-doc.
    10614     case calc-method :
    10615       when 'Объект':U then do:
    10616         enable copy-type copy-code r-copy with frame d-pr-doc.
    10617         display copy-type copy-code with frame d-pr-doc.
    10618       end.
    10619       when 'Накладная':U or
    10620       when 'Накл-безНДС':U or
    10621       when 'НсП+накл':U or
    10622       when 'Переоценка':U then do:
    10623         enable doc-code r-copy with frame d-pr-doc.
    10624         display doc-code with frame d-pr-doc.
    10625       end.
    10626       when 'Единая':U then do:
    10627         enable common-price with frame d-pr-doc.
    10628         display common-price with frame d-pr-doc.
    10629       end.
    10630     end case.
    10631   end.
    10632   if (calc-method = 'Накладная':U or
    10633       calc-method = 'Накл-безНДС':U or
    10634       calc-method = 'НсП+накл':U or
    10635       calc-method = 'Переоценка':U) and
    10636      doc-code = "" then
    10637     apply "entry" to doc-code in frame d-pr-doc.
    10638   else do:
    10639      if (calc-method = 'Единая':U ) then apply "entry" to common-price in frame d-pr-doc.
    10640      else
    10641         apply "entry" to br-list in frame d-pr-doc.
    10642   end.
    10643   end procedure.
    10644   procedure open-br :
    10645   define variable t-ret as logical no-undo .
    10646   define variable t1 as decimal no-undo .
    10647     t1 = time.
    10648    t-ret =  session:SET-WAIT-STATE("GENERAL") .
    10649    open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by ub.price-list.artic by ub.gds-prt.node-code .
    10650         run value-changed-br-list in this-procedure .
    10651         t-ret =  session:SET-WAIT-STATE("") .
    10652   end procedure.
    10653   procedure upd-disp-tot :
    10654   def input param mode as char no-undo.
    10655   if mode = "clear" then
    10656     if s-new = ? then
    10657       return.
    10658     else
    10659       p-doc.sale-base = ?.
    10660   assign
    10661     s-new = p-doc.rest-sale + p-doc.sale-base
    10662     s-old = p-doc.rest-sale
    10663     pc-prev = (s-new / s-old - 1) * 100
    10664     s-new-old = s-new - s-old
    10665     pc-avrg = (s-new / p-doc.rest-base - 1) * 100
    10666     op-avrg = (s-old / p-doc.rest-base - 1) * 100
    10667     pc-op-avrg = pc-avrg - op-avrg
    10668     pc-last = (s-new / p-doc.rest-last - 1) * 100
    10669     op-last = (s-old / p-doc.rest-last - 1) * 100
    10670     pc-op-last = pc-last - op-last
    10671     .
    10672     if pc-prev > 9999 then
    10673       pc-prev = ?.
    10674     if pc-avrg > 9999 then
    10675       pc-avrg = ?.
    10676     if op-avrg > 9999 then
    10677      op-avrg = ?.
    10678     if pc-op-avrg > 9999 then
    10679      pc-op-avrg = ?.
    10680     if pc-last > 9999 then
    10681       pc-last = ?.
    10682     if op-last > 9999 then
    10683      op-last = ?.
    10684     if pc-op-last > 9999 then
    10685      pc-op-last = ?.
    10686     if s-new-old > 9999999999 then
    10687      s-new-old = ?.
    10688   disp s-new s-old s-new-old pc-prev pc-avrg op-avrg pc-op-avrg pc-last op-last pc-op-last
    10689        with frame d-pr-doc no-error .
    10690   end procedure.
    10691   procedure upd-br-field:
    10692   define variable ff as logical no-undo .
    10693   define variable ff1 as logical init true no-undo .
    10694   define variable cur-dn as decimal no-undo .
    10695   define variable cur-pr as decimal no-undo .
    10696   define variable cur-rt as decimal no-undo .
    10697   define variable cur-ex as decimal no-undo .
    10698   define variable calc-rec as recid no-undo.
    10699     find current ub.price-list.
    10700     if decimal  (ub.price-list.price-sale :screen-value in browse br-list) <> ub.price-list.price-sale then do:
    10701       assign
    10702         ub.price-list.calc-method = 'Отсутствует':U
    10703         ub.price-list.price-calc = ub.price-list.price-sale
    10704         ub.price-list.price-sale = decimal  (ub.price-list.price-sale :screen-value in browse br-list)
    10705         .
    10706       run calc-pr-sub in this-procedure
    10707                        (input  ub.price-list.b-code,
    10708                         input  p-doc.doc-num,
    10709                         input  calc-method,
    10710                         input  increase-pc,
    10711                         input  round-method,
    10712                         input  round-base,
    10713                         output calc-rec) no-error.
    10714       if error-status :error then do:
    10715         undo, return error.
    10716         end.
    10717       run upd-disp-tot in this-procedure ("clear").
    10718     end.
    10719   if decimal  (ub.price-list.excise :screen-value in browse br-list) <> ub.price-list.excise then do:
    10720       assign
    10721       ub.price-list.excise     = decimal  (ub.price-list.excise     :screen-value in browse br-list)
    10722       .
    10723   end.
    10724   if decimal  (ub.price-list.road-tax :screen-value in browse br-list) <> ub.price-list.road-tax then do:
    10725          find first buff-goods no-lock where
    10726               buff-goods.artic     = ub.price-list.artic and
    10727               buff-goods.prod-type = ub.price-list.prod-type and
    10728               buff-goods.prod-code = ub.price-list.prod-code
    10729               no-error .
    10730         if avail buff-goods then do:
    10731                 if hvrdtax( recid(buff-goods)) = false  then  do :
    10732                    message "В товаре нет компонента цены '"   ub.price-list.road-tax:label  "' ,  изменять нельзя ! " .
    10733                    ub.price-list.road-tax   = ub.price-list.road-tax.
    10734                 end.
    10735                 else do:
    10736                     define variable v-chk-act-host-code as integer   no-undo .
    10737   define variable vss-include-info122 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10739     (input  ub.price-list.obj-type
    10740     ,input  ub.price-list.obj-code
    10741     ,output v-chk-act-host-code
    10742     )  .
    10743   define variable vss-include-info123 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10744   do:
    10745     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10746       (input  v-cntxt-db-num
    10747       ,input  v-cntxt-userid
    10748       ,input  0
    10749       ,input  'actn_overvalue_update':U
    10750       ,input  'object':U
    10751       ,input  v-chk-act-host-code
    10752       ,input  ub.price-list.obj-type
    10753       ,input  ub.price-list.obj-code
    10754       ,input  0
    10755       ,input  0
    10756       ,input  0
    10757       ,input  true
    10758       ,output ff
    10759       )  .
    10760   end.
    10761                       if not ff
    10762                       then do:
    10763                         assign
    10764                           ub.price-list.road-tax   = ub.price-list.road-tax
    10765                         .
    10766                       end.
    10767                       else do :
    10768                         assign
    10769                           ub.price-list.road-tax = dec(ub.price-list.road-tax:screen-value in browse br-list)
    10770                         .
    10771                       end.
    10772                 end.
    10773               end.
    10774          end.
    10775   end procedure.
    10776   procedure add-spec-proc:
    10777   def input param bas-mode as char no-undo.
    10778   define variable vss-include-info124 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10779   do:
    10780     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10781       (input  v-cntxt-db-num
    10782       ,input  v-cntxt-userid
    10783       ,input  0
    10784       ,input  'actn_overvalue_properties':U
    10785       ,input  'object':U
    10786       ,input  v-cntxt-host-code-obj
    10787       ,input  v-cntxt-obj-type
    10788       ,input  v-cntxt-obj-code
    10789       ,input  0
    10790       ,input  0
    10791       ,input  0
    10792       ,input  true
    10793       ,output g#log
    10794       )  .
    10795   end.
    10796     if not g#log then return .
    10797   define variable rec-list as char no-undo.
    10798   define variable num-rec as integer no-undo.
    10799   if input frame d-pr-doc increase-pc < - 100 then do:
    10800     message "Наценка не может быть меньше - 100 % !"
    10801             view-as alert-box error.
    10802     apply "entry" to br-list in frame d-pr-doc.
    10803     return no-apply.
    10804   end.
    10805   if not available ub.price-list or
    10806      ub.gds-prt.upper-code <> ub.goods.prt-root then do:
    10807     message "Неправильно выбрана строка. Должна быть указана главная цена."
    10808             view-as alert-box error.
    10809     return no-apply.
    10810   end.
    10811   run ref/bas-cds.w (parParentProc, v-cntxt-obj-type, v-cntxt-obj-code, bas-mode, ub.bar-code.gds-code, output rec-list).
    10812   apply "entry" to br-list in frame d-pr-doc.
    10813   if rec-list = '' then
    10814     return no-apply.
    10815   define variable v-11 as integer   no-undo .
    10816   v-11 = num-entries (rec-list) .
    10817   do num-rec = 1 to v-11 :
    10818     ref-rec = integer (entry (num-rec, rec-list)).
    10819     find ub.bar-code where
    10820          recid (ub.bar-code) = ref-rec no-lock.
    10821     if avail ub.bar-code  and ub.bar-code.part-code = "" and  ub.bar-code.in-code = "" then do:
    10822        run cre-line in this-procedure  (ub.bar-code.b-code) no-error .
    10823         if error-status:error then   next.
    10824     run calc-pr-list in this-procedure
    10825                      (input ub.bar-code.b-code,
    10826                       input p-doc.doc-num,
    10827                       input calc-method,
    10828                       input increase-pc,
    10829                       input round-method,
    10830                       input round-base,
    10831                       input ? ,
    10832                       input ? ,
    10833                       input ? ,
    10834                       input ? ,
    10835                       output line-rec) no-error.
    10836     if error-status:error then do:   next. end.
    10837       if calc-method = 'Отсутствует':U and
    10838         line-mode = 'ПРОСМОТР':U then
    10839       leave.
    10840   end.
    10841   end.
    10842   run upd-disp-tot in this-procedure ("clear").
    10843   doc-mode = 'ИЗМЕНЕНИЕ':U.
    10844   run open-br in this-procedure .
    10845   end procedure.
    10846   procedure value-changed-br-list :
    10847   define variable rt-old like ub.price-list.road-tax no-undo.
    10848   define variable ex-old like ub.price-list.excise   no-undo.
    10849   define variable dn-old like ub.price-list.doc-num  no-undo.
    10850   if not available ub.price-list then
    10851     return.
    10852   if p-doc.status_ = 'акт':U then do:
    10853   define variable vss-include-info125 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    10855     (input  ub.price-list.obj-type
    10856     ,input  ub.price-list.obj-code
    10857     ,input  ub.price-list.b-code
    10858     ,input  0
    10859     ,input  ub.price-list.fact-order
    10860     ,output dn-old
    10861     ,output p-old
    10862     ,output rt-old
    10863     ,output ex-old
    10864     )  .
    10865   end.
    10866   else do:
    10867   define variable vss-include-info126 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    10869     (input  ub.price-list.obj-type
    10870     ,input  ub.price-list.obj-code
    10871     ,input  ub.price-list.b-code
    10872     ,input  0
    10873     ,input  0
    10874     ,output dn-old
    10875     ,output p-old
    10876     ,output rt-old
    10877     ,output ex-old
    10878     )  .
    10879   end.
    10880   disp dn-old @ prev-list.doc-num
    10881        with frame d-pr-doc.
    10882   find ub.gds-obj no-lock where
    10883        ub.gds-obj.gds-code = ub.goods.gds-code and
    10884        ub.gds-obj.obj-type = p-doc.obj-type and
    10885        ub.gds-obj.obj-code = p-doc.obj-code no-error.
    10886   if available ub.gds-obj then
    10887     if ub.goods.gds-type = 'т':U then
    10888       assign
    10889         p-avrg-fact = func-cost-price (ub.price-list.b-code , ub.gds-obj.gds-code , p-doc.status_ , var-pr-r-b)
    10890         p-avrg = if var-pr-r-b = "rubl" then  ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
    10891         p-last = if var-pr-r-b = "rubl" then  ub.gds-obj.last-rubl else ub.gds-obj.last-base
    10892         obj-in-code = ub.gds-obj.in-code
    10893         obj-in-date = ub.gds-obj.in-date
    10894         .
    10895     else
    10896       assign
    10897         p-avrg-fact = func-cost-price (ub.price-list.b-code , ub.gds-obj.gds-code , p-doc.status_ , var-pr-r-b)
    10898         p-avrg = if var-pr-r-b = "rubl" then  ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
    10899         p-last = ?
    10900         obj-in-code = ?
    10901         obj-in-date = ?
    10902         .
    10903   else
    10904     assign
    10905       p-avrg-fact = ?
    10906       p-avrg      = ?
    10907       p-last      = ?
    10908       obj-in-code = ?
    10909       obj-in-date = ?
    10910       .
    10911   assign
    10912     p-new = ub.price-list.price-sale
    10913     p-pc-prev = (p-new / p-old  - 1) * 100
    10914     p-op-avrg = (p-old / p-avrg - 1) * 100
    10915     p-pc-avrg = (p-new / p-avrg - 1) * 100
    10916     p-op-avrg-fact = (p-old / p-avrg-fact - 1) * 100
    10917     p-pc-avrg-fact = (p-new / p-avrg-fact - 1) * 100
    10918     p-op-last = (p-old / p-last - 1) * 100
    10919     p-pc-last = (p-new / p-last - 1) * 100
    10920     p-pc-op-avrg-fact = p-pc-avrg-fact - p-op-avrg-fact
    10921     p-pc-op-avrg = p-pc-avrg - p-op-avrg
    10922     p-pc-op-last = p-pc-last - p-op-last
    10923     p-calc-metod = ub.price-list.calc-method
    10924     .
    10925     if p-pc-prev > 9999 then
    10926       p-pc-prev = ?.
    10927     if p-pc-avrg > 9999 then
    10928       p-pc-avrg = ?.
    10929     if p-op-avrg > 9999 then
    10930       p-op-avrg = ?.
    10931     if p-pc-avrg-fact > 9999 then
    10932       p-pc-avrg-fact = ?.
    10933     if p-op-avrg-fact > 9999 then
    10934       p-op-avrg-fact = ?.
    10935     if p-pc-last > 9999 then
    10936       p-pc-last = ?.
    10937     if p-op-last > 9999 then
    10938       p-op-last = ?.
    10939     if   p-pc-op-avrg > 9999 then
    10940       p-pc-op-avrg = ?.
    10941     if   p-pc-op-avrg-fact > 9999 then
    10942       p-pc-op-avrg-fact = ?.
    10943     if p-pc-op-last > 9999 then
    10944       p-pc-op-last = ?.
    10945   disp p-new p-old
    10946       p-last obj-in-code obj-in-date    p-pc-op-last p-calc-metod
    10947        p-pc-prev   p-op-last p-pc-last
    10948        p-avrg
    10949        p-op-avrg
    10950        p-pc-avrg
    10951        p-pc-op-avrg
    10952        p-avrg-fact
    10953        p-op-avrg-fact
    10954        p-pc-avrg-fact
    10955        p-pc-op-avrg-fact
    10956        with frame d-pr-doc no-error .
    10957    if not available ub.price-list or recid (ub.price-list) <> line-rec then do:
    10958       hide loc-art in frame d-pr-doc.
    10959       loc-art = "".
    10960     end.
    10961   end procedure.
    10962   procedure ch-b-exit.
    10963   define output parameter p-err as logical no-undo .
    10964   p-err = false .
    10965   if doc-mode <> 'ПРОСМОТР':U then do:
    10966   doc-rec = recid(p-doc) no-error .
    10967   if error-status :error then  doc-rec =  ? .
    10968     if can-find (first ub.price-list where ub.price-list.doc-num = p-doc.doc-num
    10969                                     and ub.price-list.price-sale = ? no-lock) then do:
    10970       g#log = no.
    10971       message "В документе есть нерассчитанные строки. Удалить их ?"
    10972               view-as alert-box question buttons yes-no update g#log.
    10973               if g#log then do:
    10974                         for each ub.price-list no-lock  where
    10975                                  ub.price-list.doc-num = p-doc.doc-num and
    10976                                  ub.price-list.price-sale = ? :
    10977                           run del-pr-list in this-procedure
    10978                                          (input ub.price-list.b-code,
    10979                                           input p-doc.doc-num,
    10980                                           input round-method,
    10981                                           input round-base) no-error.
    10982                           if error-status :error then do:
    10983                             message  vss-workfile vss-revision vss-description skip
    10984                             "Ошибка при удалении строки переоценки " skip
    10985                             p-doc.doc-num
    10986                             ub.price-list.b-code
    10987                             skip
    10988                             error-status :get-message(1) view-as alert-box error  .
    10989                             undo, return error .
    10990                             end.
    10991                         end.
    10992                 p-doc.rest-qnty = ?.
    10993               end.
    10994     end.
    10995     run ver-pr-equ-dq in this-procedure ( input p-doc.doc-num, input 1, input "" ) no-error .
    10996     if error-status :error then do:
    10997           message  vss-workfile vss-revision vss-description skip
    10998               "Ошибка при удалении строки переоценки " skip
    10999               p-doc.doc-num  skip
    11000               error-status :get-message(1) view-as alert-box information .
    11001               undo, return error .
    11002     end.
    11003     if doc-code <> "" and par-pr-discm = 'sale-' then do:
    11004        p-doc.out-code = doc-code .
    11005     end.
    11006     run ver-pr-discn in this-procedure ( input "",  input p-doc.doc-num ,input p-doc.out-code , output p-err ) no-error .
    11007     if error-status :error then
    11008        message "Ошибка при проверки процента наценки!"
    11009        view-as alert-box question
    11010        buttons yes-no
    11011        update v-qqq
    11012        .
    11013        if v-qqq then p-err = true .
    11014        else  p-err = false .
    11015     if not can-find (first ub.price-list where ub.price-list.doc-num = p-doc.doc-num no-lock) then do:
    11016       message "В документе нет ни одной строки. Удалять его ?"
    11017               view-as alert-box question buttons yes-no update g#log.
    11018       if g#log then do:
    11019          delete p-doc.
    11020          doc-rec = ? .
    11021       end.
    11022     end.
    11023   end.
    11024   next-prev = ?.
    11025   end procedure.
    11026    procedure ver-conf :
    11027    define variable l-par as logical   no-undo .
    11028      run chec-par in this-procedure (
    11029            output l-par
    11030           ,input  v-cntxt-host-code-obj
    11031           ,input  v-cntxt-obj-type
    11032           ,input  v-cntxt-obj-code
    11033         ) no-error .
    11034     assign
    11035       increase-pc  = decimal (par-pr-incpc)
    11036       round-method = par-pr-rndmt
    11037       round-base   = decimal (par-pr-rndbs)
    11038       no-error.
    11039     case par-pr-rndmt:
    11040       when "pr-round-9end" then
    11041         round-method = '9-окончание':U.
    11042       when "pr-round-9-99end" then
    11043         round-method = '9-99окончание':U.
    11044       when "pr-round-integer" then
    11045         round-method = 'Без-дробных':U.
    11046       when "pr-round-select" then
    11047         round-method = 'Произвольно':U.
    11048       when "pr-round-up" then
    11049         round-method = 'Вверх':U.
    11050       when "pr-round-coef" then
    11051         round-method = 'Коэффициент':U.
    11052       when "pr-round-off" then
    11053         round-method = 'Отключено':U.
    11054       otherwise
    11055         round-method = 'Отключено':U.
    11056     end case.
    11057     end procedure.
    11058   procedure  cre-line-temp :
    11059   define input parameter p-mode as character no-undo .
    11060   define input parameter p-gds-code  like ub.bar-code.gds-code    no-undo .
    11061   define input parameter p-node-code like ub.bar-code.node-code   no-undo .
    11062   if p-mode = "gds-list":u then do:
    11063     for each temp-gds-list : delete temp-gds-list. end.
    11064     for each gds-list no-lock where by  recid(gds-list) :
    11065         find  first ub.gds-prt no-lock where
    11066                   ub.gds-prt.upper-code = gds-list.prt-root no-error .
    11067         find  first ub.bar-code no-lock where
    11068                   ub.bar-code.gds-code  = gds-list.gds-code and
    11069                   ub.bar-code.node-code = ub.gds-prt.node-code and
    11070                   ub.bar-code.in-code   = "" and
    11071                   ub.bar-code.part-code = "" and
    11072                   ub.bar-code.unit-cli  = gds-list.unit-base
    11073                   no-error .
    11074       if avail ub.bar-code  and avail ub.gds-prt then do :
    11075           create temp-gds-list.
    11076           assign
    11077               v-n-n = v-n-n + 1
    11078               temp-gds-list.gds-code  = ub.bar-code.gds-code
    11079               temp-gds-list.node-code = ub.bar-code.node-code
    11080               temp-gds-list.n-n = v-n-n.
    11081       end.
    11082     end.
    11083   end.
    11084   if p-mode = "one":u then do:
    11085       create temp-gds-list.
    11086       assign
    11087           v-n-n = v-n-n + 1
    11088           temp-gds-list.gds-code  = p-gds-code
    11089           temp-gds-list.node-code = p-node-code
    11090           temp-gds-list.n-n = v-n-n.
    11091   end.
    11092   end procedure.
    11093   def var vss-include-info127 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11094   procedure tax-name:
    11095   define input  parameter pardef-tax  as character           no-undo.
    11096   define output parameter parname-tax as character initial ? no-undo.
    11097   define buffer bf_tax for ub.tax.
    11098   do on error undo, return error :
    11099      case pardef-tax:
    11100         when 'vat':U then do:
    11101                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
    11102         end.
    11103         when 'slt':U then do:
    11104                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
    11105         end.
    11106         when 'rdt':U then do:
    11107                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
    11108         end.
    11109         when 'exc':U then do:
    11110                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
    11111         end.
    11112         otherwise do:
    11113            return error "Задан неверный параметр " + pardef-tax + " .".
    11114         end.
    11115      end case.
    11116   end.
    11117   end procedure.
    11118   procedure add-price-line :
    11119   find current p-doc no-error .
    11120   if error-status:error then return no-apply.
    11121   assign
    11122     line-mode = 'ДОБАВЛЕНИЕ':U
    11123     notes = ''
    11124     lns-cnt = 1.
    11125   for each gds-list :
    11126      delete gds-list.
    11127   end.
    11128   if NOT ( calc-method = 'Накладная':U or
    11129         calc-method = 'Накл-безНДС':U or
    11130         calc-method = 'НсП+накл':U or
    11131         calc-method = 'Переоценка':U )
    11132   Then do:
    11133       run str/chsgdsls.w (
    11134           parParentProc ,
    11135           input "price-list" ,
    11136           input "Строка пер. № " + p-doc.doc-num + " " + p-doc.status_  , ? , ? ,
    11137           input p-doc.host-code,
    11138           input-output varschartic,
    11139           output ref-list,
    11140           output table tt-gds-list, false ) no-error.
    11141   end.
    11142   assign lns-cnt = 0.
    11143   run cycle-add in this-procedure .
    11144   run ui-on in this-procedure .
    11145   end procedure.
    11146   procedure cycle-add:
    11147   define buffer ggg_price-list  for ub.price-list .
    11148   define variable stp-cycl as logical no-undo .
    11149   stp-cycl = false .
    11150   for each tt-gds-list no-lock  by tt-gds-list.nn :
    11151     lns-cnt  =  lns-cnt + 1 .
    11152     if lns-cnt > 1 then assign line-mode = "ЦИКЛ":u.
    11153     find ub.goods where ub.goods.gds-code = tt-gds-list.gds-code no-lock.
    11154     find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
    11155     find ub.bar-code no-lock where
    11156          ub.bar-code.gds-code  = ub.goods.gds-code and
    11157          ub.bar-code.node-code = ub.gds-prt.node-code and
    11158          ub.bar-code.part-code = "" and
    11159          ub.bar-code.in-code   = "" and
    11160          ub.bar-code.unit-cli  = ub.goods.unit-base.
    11161     run cre-line in this-procedure (ub.bar-code.b-code) no-error.
    11162     if error-status:error then do:   next.     end.
    11163     doc-rec = recid(p-doc) .
    11164     find first ggg_price-list where recid(GGG_price-list) =  new-pr-recid  no-lock no-error .
    11165      if error-status :error then next .
    11166     if avail ggg_price-list then do :
    11167     run calc-pr-list in this-procedure (input ub.bar-code.b-code,
    11168                       input p-doc.doc-num,
    11169                       input calc-method,
    11170                       input increase-pc,
    11171                       input round-method,
    11172                       input round-base,
    11173                       input ? ,
    11174                       input ? ,
    11175                       input ? ,
    11176                       input ? ,
    11177                       output line-rec) no-error.
    11178                if error-status:error then   next.
    11179     end.
    11180     if  ( calc-method = 'Отсутствует':U
    11181           or
    11182         ( calc-method <> 'Отсутствует':U
    11183           and ggg_price-list.price-sale = ?
    11184           and calc-method <> 'Не-считать':U  ))
    11185         then do:
    11186           run str/pr-form.w (
    11187                         input  parParentProc ,
    11188                         input  line-mode   ,
    11189                         input  doc-rec    ,
    11190                         input  new-pr-recid ,
    11191                         input increase-pc ,
    11192                         input round-method,
    11193                         input round-base,
    11194                         input calc-method,
    11195                         output stp-cycl ) no-error .
    11196                         if error-status :error then message error-status :error error-status :get-message(1) 111.
    11197                         if return-value = "error" then do:
    11198                                     find first ggg_price-list where recid(ggg_price-list) = new-pr-recid no-error .
    11199                                     if avail ggg_price-list then
    11200                                        run del-pr-list in this-procedure ( input ggg_price-list.b-code,
    11201                                                           input ggg_price-list.doc-num,
    11202                                                           input round-method,
    11203                                                           input round-base) no-error.
    11204                         end.
    11205           find p-doc where recid(p-doc) = doc-rec no-error .
    11206           if  stp-cycl = true then leave.
    11207     end.
    11208     assign lns-cnt = lns-cnt + 1 .
    11209   end.
    11210   end procedure.
    11211   procedure cr-button :
    11212    do
    11213    on error undo, return error return-value
    11214    :
    11215   define variable  but1  as widget-handle.
    11216      create button but1
    11217      assign
    11218         row = 1
    11219         column = 53
    11220         HEIGHT-CHARS = 1
    11221         WIDTH-CHARS = 8
    11222         label = "СортПН"
    11223         tooltip = "Сортировка по порядку ввода накладной"
    11224         frame = frame d-pr-doc:handle
    11225         sensitive = true
    11226         visible = true
    11227           triggers:
    11228             on choose persistent run op.
    11229           end triggers.
    11230    end.
    11231   end procedure.
    11232   procedure op :
    11233    do
    11234    on error undo, return error return-value
    11235    :
    11236   define buffer temp-doc-line   for ub.doc-line .
    11237   define buffer temp-price-list for ub.price-list .
    11238   define variable number-trn-doc as character no-undo .
    11239   define variable t-ok as logical no-undo .
    11240    number-trn-doc  = p-doc.out-code .
    11241    if number-trn-doc = "" or number-trn-doc = ? then do:
    11242       message "Невозможно определить номер ПН для сортировки товаров !!! " .
    11243       return.
    11244       end.
    11245    t-ok = true .
    11246    message "Хотите отсортировать переоценку по порядку ввода накладной № " number-trn-doc
    11247            " ?" view-as alert-box question  buttons yes-no update t-ok .
    11248    if t-ok = false then return.
    11249   define variable n-num as integer no-undo .
    11250   n-num = 0 .
    11251   for each temp-doc-line no-lock where temp-doc-line.doc-code = number-trn-doc by temp-doc-line.line-num :
    11252       for each  temp-price-list  exclusive-lock
    11253                       where temp-price-list.doc-num    = p-doc.doc-num and
    11254                             temp-price-list.price-type = "" and
    11255                             temp-price-list.artic = temp-doc-line.artic and
    11256                             temp-price-list.prod-type = temp-doc-line.prod-type and
    11257                             temp-price-list.prod-code = temp-doc-line.prod-code
    11258                             by temp-price-list.main-price DESCENDIN
    11259                             by temp-price-list.b-code
    11260                             :
    11261           n-num = n-num + 1 .
    11262           assign
    11263             temp-price-list.line-num  = n-num
    11264           .
    11265       end.
    11266   end.
    11267    open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code
    11268               by ub.price-list.line-num .
    11269   run value-changed-br-list.
    11270    end.
    11271   end procedure.
    11272   procedure run-help :
    11273    do
    11274    on error undo, return error return-value
    11275    :
    11276    define variable v-message-text as character no-undo .
    11277    define variable t-m  as character no-undo .
    11278   case calc-method :
    11279     when 'Учетная':U then  assign  t-m =
    11280      chr(10) + "для товара: средняя учетная цена товара на фирме                                " +
    11281      chr(10) + "            (с учетом товара зарезервированного за незакрытыми документами)     " +
    11282      chr(10) + "для услуги: учетная цена услуги на фирме неопределена                           "
    11283     .
    11284     when  'Учет-объект':U  then  assign  t-m =
    11285      chr(10) + "для товара: средняя учетная цена товара на объекте                               " +
    11286      chr(10) + "            (c учетом товара зарезервированного                                  " +
    11287      chr(10) + "            за незакрытыми документами -                                         " +
    11288      chr(10) + "             и партии свободной зоны, и резерв документов)                       " +
    11289      chr(10) + "для услуги: возвращается учетная цена по объекту                                 "
    11290     .
    11291     when 'Учет-резерв':U     then  assign  t-m =
    11292      chr(10) + "для товара: средняя учетная цена товара на объекте                                " +
    11293      chr(10) + "            (без учета товара зарезервированного                                  " +
    11294      chr(10) + "            за незакрытыми документами - только партии свободной зоны)            " +
    11295      chr(10) + "для услуги: возвращается учетная цена по объекту                                  "
    11296     .
    11297     when 'Приходная':U     then  assign  t-m =
    11298      chr(10) + "для товара: цену последнего прихода по фирме                                       " +
    11299      chr(10) + "для услуги: цена последнего прихода услуги по фирме не определена                  "
    11300     .
    11301     when 'Прих-объект':U  then  assign  t-m =
    11302      chr(10) + "для товара: цену последнего прихода по объекту                                     " +
    11303      chr(10) + "для услуги: цена последнего прихода услуги по объекту не определена                "
    11304     .
    11305        otherwise do:
    11306           assign  t-m =  "МЕТОД НЕ ОПИСАН !!!!"       .
    11307        end.
    11308   end case.
    11309    v-message-text ="Название метода :  -" + calc-method + "-" + chr(10) +
    11310    "Описание : " + chr(10)   + t-m
    11311      .
    11312    run gbl/d-prompt.w (
    11313       'title=Описание метода расчета\'
    11314     + 'type=editor\'
    11315     + 'fillin_width=96\'
    11316     + 'fillin_height=15\'
    11317     + 'readonly=yes\'
    11318     , input-output v-message-text).
    11319    end.
    11320   end procedure.
    11321   procedure proc-cost-price-fact :
    11322    do
    11323    on error undo, return error return-value
    11324    :
    11325   define input parameter  p-bar-code as integer   no-undo .
    11326   define input parameter  p-gds-code as integer   no-undo .
    11327   define input parameter  p-status_  as character no-undo .
    11328   define input parameter  p-r-b      as character no-undo .
    11329   define output parameter par-summa  as decimal   no-undo .
    11330   define variable v-total-avrg-base  as decimal no-undo .
    11331   define variable v-total-avrg-rubl  as decimal no-undo .
    11332   define variable v-total-avrg-qnty  as decimal no-undo .
    11333   define buffer buf_goods for ub.goods.
    11334   define buffer buf_parts for ub.parts.
    11335   define variable p-price-base as decimal no-undo .
    11336   define variable p-price-rubl as decimal no-undo .
    11337   find first buf_goods no-lock where
    11338              buf_goods.gds-code = p-gds-code no-error .
    11339    if p-status_ <> 'акт':U then do:
    11340         for each buf_parts no-lock
    11341           where  buf_parts.obj-type  = p-doc.obj-type
    11342             and buf_parts.obj-code   = p-doc.obj-code
    11343             and buf_parts.artic      = buf_goods.artic
    11344             and buf_parts.prod-type  = buf_goods.prod-type
    11345             and buf_parts.prod-code  = buf_goods.prod-code
    11346             and buf_parts.status_    = no
    11347             and ( buf_parts.out-code  = 'free-zone':U )
    11348         on error undo, return error
    11349         :
    11350           assign
    11351             v-total-avrg-base = v-total-avrg-base
    11352                               + (buf_parts.price-base * buf_parts.qnty)
    11353             v-total-avrg-rubl = v-total-avrg-rubl
    11354                               + (buf_parts.price-rubl * buf_parts.qnty)
    11355             v-total-avrg-qnty = v-total-avrg-qnty
    11356                               + buf_parts.qnty
    11357           .
    11358         end.
    11359         if v-total-avrg-qnty > 0 then do:
    11360           assign
    11361             p-price-base = ( v-total-avrg-base / v-total-avrg-qnty )
    11362             p-price-rubl = ( v-total-avrg-rubl / v-total-avrg-qnty )
    11363           .
    11364         end.
    11365         else do:
    11366           assign
    11367             p-price-base = ?
    11368             p-price-rubl = ?
    11369           .
    11370         end.
    11371    end.
    11372    else do:
    11373    define variable p-attr-value as character no-undo .
    11374          run view-price-list-attr in this-procedure (
    11375               input   'cost-price-fact':U  ,
    11376               input   p-bar-code          ,
    11377               input   p-doc.doc-num       ,
    11378               input   ""                  ,
    11379               output  p-attr-value   )
    11380               .
    11381              if not ( p-attr-value = ? or p-attr-value = "" )  then
    11382                 assign
    11383                   p-price-rubl = decimal(p-attr-value)
    11384                   p-price-base = decimal(p-attr-value)
    11385                 .
    11386    end.
    11387    if p-r-b = "rubl":u then
    11388       par-summa = p-price-rubl.
    11389       else
    11390       par-summa = p-price-base.
    11391    end.
    11392   end procedure.
