      967       find first buf_gds-grp-obj no-lock
      968           where buf_gds-grp-obj.node-code = p-node-code
      969             and buf_gds-grp-obj.host-code = v-host-code
      970             and buf_gds-grp-obj.obj-type  = p-obj-type
      971             and buf_gds-grp-obj.obj-code  = p-obj-code
      972       no-error .
      973     end.
      974     if v-range = 3 or not available buf_gds-grp-obj
      975     then do:
      976        if v-range <> 2 then do:
      977           find first buf_gds-grp-obj no-lock
      978               where buf_gds-grp-obj.node-code = p-node-code
      979                 and buf_gds-grp-obj.host-code = v-host-code
      980                 and buf_gds-grp-obj.obj-type  = ""
      981                 and buf_gds-grp-obj.obj-code  = 0
      982           no-error .
      983         end.
      984         if v-range = 2 or not available buf_gds-grp-obj
      985         then do:
      986             if v-range <> 1 then do:
      987               find first buf_gds-grp-obj no-lock
      988                   where buf_gds-grp-obj.node-code = p-node-code
      989                   and buf_gds-grp-obj.host-code = 0
      990                   and buf_gds-grp-obj.obj-type  = ""
      991                   and buf_gds-grp-obj.obj-code  = 0
      992               no-error .
      993             end.
      994             if v-range = 1 or not available buf_gds-grp-obj
      995             then do:
      996                 assign
      997                     v-exists = no
      998                 .
      999             end.
     1000             else do:
     1001                 assign
     1002                     v-exists = yes
     1003                     v-range = 1
     1004                 .
     1005             end.
     1006         end.
     1007         else do:
     1008             assign
     1009                 v-exists = yes
     1010                 v-range  = 2
     1011             .
     1012         end.
     1013     end.
     1014     else do:
     1015         assign
     1016             v-exists = yes
     1017             v-range  = 3
     1018         .
     1019     end.
     1020     if available buf_gds-grp-obj
     1021     then do:
     1022       assign
     1023       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1024       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1025       .
     1026       assign
     1027       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1028                           then yes
     1029                           else p-exists-income-cli)
     1030       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1031                         then v-range
     1032                         else p-range-income-cli
     1033       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1034                         then v-cli-type-value
     1035                         else p-cli-type
     1036       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1037                         then v-cli-code-value
     1038                         else p-cli-code
     1039       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1040       jj = jj + 1
     1041       .
     1042     end.
     1043     else do:
     1044       assign
     1045       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1046       jj = jj + 1
     1047       .
     1048     end.
     1049   end.
     1050   end.
     1051   end procedure.
