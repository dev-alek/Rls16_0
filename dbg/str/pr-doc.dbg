     9209   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9210   PROCEDURE VER-PR-EQU-DQ :
     9211   define input parameter  l-doc-num    like ub.price-list.doc-num    no-undo .
     9212   define input parameter  l-num       as integer no-undo .
     9213   define input parameter  l-b-code    as integer   no-undo .
     9214   define variable  l-doc-num2    like ub.price-list.doc-num    no-undo .
     9215   define buffer l-price-list  for ub.price-list .
     9216   define buffer pp_price-list for ub.price-list .
     9217   define buffer p2_price-list for ub.price-list .
     9218   define buffer main_price-list for ub.price-list .
     9219   define buffer alt_price-list  for ub.price-list .
     9220   define buffer buf1-bar-code for ub.bar-code .
     9221   define buffer buf2-bar-code for ub.bar-code .
     9222   define variable v-num as integer init 0 no-undo .
     9223   define variable bbb as logical no-undo .
     9224   define variable  l-price-sale like ub.price-list.price-sale no-undo .
     9225   define variable  l-road-tax   like ub.price-list.road-tax   no-undo .
     9226   define variable  l-excise     like ub.price-list.excise     no-undo .
     9227   define variable  l-ok         as logical no-undo .
     9228   define variable  check-par    as logical no-undo .
     9229   for each l-price-list where l-price-list.doc-num = l-doc-num     and
     9230                               l-price-list.main-price = true
     9231                               exclusive-lock  :
     9232     find first ub.goods where ub.goods.artic    = l-price-list.artic and
     9233                           ub.goods.prod-type = l-price-list.prod-type and
     9234                           ub.goods.prod-code = l-price-list.prod-code no-lock   .
     9235         check-par = false .
     9236         if l-num = 2 then do:
     9237           find first buf2-bar-code where buf2-bar-code.b-code = l-b-code no-lock no-error .
     9238           if ub.goods.gds-code <> buf2-bar-code.gds-code then next.
     9239         end.
     9240   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     9242     (input  l-price-list.obj-type
     9243     ,input  l-price-list.obj-code
     9244     ,input  l-price-list.b-code
     9245     ,input  0
     9246     ,input  0
     9247     ,output l-doc-num2
     9248     ,output l-price-sale
     9249     ,output l-road-tax
     9250     ,output l-excise
     9251     ) no-error .
     9252         if l-doc-num2 <> ? then do :
     9253           if l-price-sale = l-price-list.price-sale
     9254           then do:
     9255             if par-pr-equ-dq >= 2 then do:
     9256               check-par = false .
     9257                  for each pp_price-list no-lock where pp_price-list.doc-num = l-doc-num   and
     9258                     pp_price-list.artic       =  l-price-list.artic      and
     9259                     pp_price-list.prod-type   =  l-price-list.prod-type  and
     9260                     pp_price-list.prod-code   =  l-price-list.prod-code  and
     9261                     pp_price-list.main-price  =  no  :
     9262                       check-par = true  .
     9263                       leave.
     9264                   end.
     9265               if  check-par = true then NEXT .
     9266               if par-pr-equ-dq = 2 then do:
     9267                 if  ( v-num <= 2  and check-par = false ) then
     9268                 run gbl/d-askw.w
     9269                   (input "Удалить строку?"
     9270                   ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     9271                               + " Объект "  + l-price-list.obj-type + " " + String(l-price-list.obj-code) + chr(10)
     9272                               + " Артикул " + l-price-list.artic    + " " +  ub.goods.gds-name + chr(10)
     9273                               + " Бар-код " + string(l-price-list.b-code)
     9274                               + " Цена по предыдущему документу № " + l-doc-num + " "
     9275                               + string(l-price-sale) + chr(10)
     9276                               + string(l-price-list.price-sale)
     9277                               + " Удалить строку? "
     9278                   ,input "|^"
     9279                   ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     9280                   ,input "Удалить строку|"
     9281                       + "Не удалять строку|"
     9282                       + "Удалять у всех товаров, цена на которые не изменилась|"
     9283                       + "Не удалять у всех товаров, цена на которые не изменилась"
     9284                   ,input 1
     9285                   ,input 2
     9286                   ,output v-num
     9287                   ).
     9288                 end.
     9289                 else do:
     9290                   v-num = 3 .
     9291                 end.
     9292                   if v-num = 1 then do:
     9293                     run del-pr-list (input l-price-list.b-code,
     9294                                     input l-price-list.doc-num,
     9295                                     input ?,
     9296                                     input ?) no-error.
     9297                                     if error-status :error then do:
     9298                                             message  vss-workfile vss-revision vss-description skip
     9299                                             "Ошибка при удаление строки переоценки "
     9300                                             l-price-list.b-code skip
     9301                                             error-status :get-message(1) .
     9302                                             return error.
     9303                                     end.
     9304                   end.
     9305                   if v-num = 3  then do:
     9306                      run del-pr-list (input l-price-list.b-code,
     9307                                       input l-price-list.doc-num,
     9308                                       input ?,
     9309                                       input ?)
     9310                                       no-error.
     9311                   end.
     9312             end.
     9313           end.
     9314          end.
     9315   end.
     9316     if par-pr-equ-dq >= 2 then do:
     9317        for each main_price-list no-lock where
     9318                 main_price-list.doc-num         = l-doc-num   and
     9319                 main_price-list.main-price      = true ,
     9320           first ub.goods where ub.goods.artic   = main_price-list.artic and
     9321                           ub.goods.prod-type = main_price-list.prod-type and
     9322                           ub.goods.prod-code = main_price-list.prod-code no-lock   :
     9323                if l-num = 2 then do:
     9324                   find first buf2-bar-code where buf2-bar-code.b-code = l-b-code no-lock no-error .
     9325                   if ub.goods.gds-code <> buf2-bar-code.gds-code then next.
     9326                end.
     9327                   for each pp_price-list no-lock where
     9328                     pp_price-list.doc-num         = main_price-list.doc-num    and
     9329                     pp_price-list.artic           = main_price-list.artic      and
     9330                     pp_price-list.prod-type       = main_price-list.prod-type  and
     9331                     pp_price-list.prod-code       = main_price-list.prod-code  and
     9332                     pp_price-list.main-price      = no and
     9333                     pp_price-list.price-sale      = main_price-list.price-sale  ,
     9334                       first buf1-bar-code no-lock where
     9335                         buf1-bar-code.b-code    = pp_price-list.b-code and
     9336                         buf1-bar-code.unit-cli  = ub.goods.unit-base break by buf1-bar-code.b-code :
     9337                             if first-of( buf1-bar-code.b-code ) then do:
     9338                             bbb = false.
     9339                                      for each alt_price-list where
     9340                                             pp_price-list.doc-num         = alt_price-list.doc-num    and
     9341                                             pp_price-list.artic           = alt_price-list.artic      and
     9342                                             pp_price-list.prod-type       = alt_price-list.prod-type  and
     9343                                             pp_price-list.prod-code       = alt_price-list.prod-code  and
     9344                                             pp_price-list.main-price      = no  no-lock :
     9345                                           if pp_price-list.b-code   =  fnc-base-code (alt_price-list.b-code) and
     9346                                             alt_price-list.b-code = pp_price-list.b-code then next.
     9347                                             if fnc-base-code (alt_price-list.b-code) = pp_price-list.b-code
     9348                                             then do:
     9349                                                   bbb = true .
     9350                                                   leave.
     9351                                              end.
     9352                                      end.
     9353                                       if bbb = false then do:
     9354                                           run del-pr-list ( input pp_price-list.b-code  ,
     9355                                                             input pp_price-list.doc-num ,
     9356                                                             input ? ,
     9357                                                             input ? ) no-error.
     9358                                           if error-status :error then do:
     9359                                             message  vss-workfile vss-revision vss-description skip
     9360                                             " Нельзя удалить " pp_price-list.b-code skip
     9361                                             error-status :get-message(1) .
     9362                                             end.
     9363                                       end.
     9364                             end.
     9365                   end.
     9366        end.
     9367    end.
     9368   end procedure.
