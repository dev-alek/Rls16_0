     5769     find ub.price-doc where ub.price-doc.doc-num = input frame d-pr-doc doc-code no-lock no-error.
     5770     g#log = available ub.price-doc.
     5771   end.
     5772   if g#log then
     5773     assign doc-code.
     5774   else
     5775     if input doc-code <> "" then
     5776       message "Нет такого документа!"
     5777               view-as alert-box error.
     5778   disp doc-code with frame d-pr-doc.
     5779   end.
     5780   on leave of round-base in frame d-pr-doc do:
     5781   if input frame d-pr-doc round-base = 0 then do:
     5782     if input frame d-pr-doc round-method = 'Произвольно':U then
     5783       message "Такое округление невозможно - деление на 0."
     5784               view-as alert-box error.
     5785     else
     5786       message "Пересчет по нулевому коэффициенту невозможен - получится 0."
     5787               view-as alert-box error.
     5788   end.
     5789   else
     5790     assign
     5791       round-base.
     5792   disp round-base with frame d-pr-doc.
     5793   end.
     5794   on leave of common-price in frame d-pr-doc do:
     5795      assign common-price.
     5796   disp common-price with frame d-pr-doc.
     5797   end.
     5798   ON CHOOSE OF b-next IN FRAME d-pr-doc
     5799   DO:
     5800   if valid-handle (br-handle) then do:
     5801     g#log = br-handle:select-next-row().
     5802     if not g#log then message "Это последний документ списка.".
     5803   end.
     5804   doc-rec = recid (p-doc).
     5805   next-prev = yes.
     5806   END.
     5807   ON CHOOSE OF b-prev IN FRAME d-pr-doc
     5808   DO:
     5809   if valid-handle (br-handle) then do:
     5810     g#log = br-handle:select-prev-row().
     5811     if not g#log then message "Это первый документ списка.".
     5812   end.
     5813   doc-rec = recid (p-doc).
     5814   next-prev = yes.
     5815   END.
     5816   if valid-handle(active-window) and frame d-pr-doc:parent eq ? then
     5817     frame d-pr-doc:parent = active-window.
     5818   on window-close of frame d-pr-doc apply "end-error":u to self.
     5819   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5820   on help of frame d-pr-doc
     5821   do:
     5822     run gbl/app_help.p
     5823       (input this-procedure :file-name
     5824       ,input ''
     5825       ,input ?
     5826       ) no-error.
     5827     if error-status :error then do:
     5828       message
     5829         "Ошибка при вызове помощи"
     5830         error-status :get-message(1)
     5831         view-as alert-box .
     5832     end.
     5833   end.
     5834   run minbtn-set in this-procedure .
     5835   on choose of b-help in frame d-pr-doc
     5836   do:
     5837     apply "help":u to frame d-pr-doc .
     5838   end.
     5839   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5840   procedure minbtn-set :
     5841       do
     5842           on error undo, return error return-value
     5843           :
     5844           define variable ii              as integer       no-undo .
     5845           define variable fh              as widget-handle no-undo .
     5846           define variable hh              as widget-handle no-undo .
     5847           define variable v-h             as handle        extent 4 no-undo .
     5848           define variable v-name-button   as character     no-undo .
     5849           define variable v-help-old-x    as decimal       no-undo .
     5850           define variable v-help-old-y    as decimal       no-undo .
     5851           define variable v-help-old-size as decimal       no-undo .
     5852           define variable v-frame-width   as decimal       no-undo .
     5853           define variable jj              as integer       no-undo .
     5854           do
     5855               on error undo, return error
     5856               :
     5857               assign
     5858                   v-frame-width = frame d-pr-doc:width - 0.3
     5859                   fh            = frame d-pr-doc:first-child
     5860                   hh            = fh:first-child
     5861                   ii            = 1
     5862                   .
     5863               do while valid-handle(hh):
     5864                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5865                   do:
     5866                       case lc(hh:name) :
     5867                           when "b-help" then
     5868                               do:
     5869                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5870                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5871                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5872                                   hh:TOOLTIP = "Помощь" .
     5873                                   v-help-old-x = hh:column .
     5874                                   v-help-old-y = hh:row    .
     5875                                   v-help-old-size = hh:width .
     5876                                   hh:width-chars = 2.5 .
     5877                               end.
     5878                           when "b-print" then
     5879                               do:
     5880                                   hh:load-image("cmp/b-print.bmp":u) .
     5881                                   hh:TOOLTIP = "Печать" .
     5882                                   v-h[ii] = hh:handle .
     5883                                   ii = ii + 1 .
     5884                                   hh:width-chars = 3 .
     5885                               end.
     5886                           when "b-history" or
     5887                           when "b-hist" then
     5888                               do:
     5889                                   hh:load-image("cmp/b-hist.bmp":u) .
     5890                                   hh:TOOLTIP = "История" .
     5891                                   v-h[ii] = hh:handle .
     5892                                   ii = ii + 1 .
     5893                                   hh:width-chars = 3 .
     5894                               end.
     5895                           when "b-sch" then
     5896                               do:
     5897                                   hh:load-image("cmp/b-sch.bmp":u) .
     5898                                   hh:TOOLTIP = "Установка Фильтра" .
     5899                                   v-h[ii] = hh:handle .
     5900                                   ii = ii + 1 .
     5901                                   hh:width-chars = 3 .
     5902                               end.
     5903                           when "b-hist-user" then
     5904                               do:
     5905                                   hh:load-image("cmp/b-hist.bmp":u) .
     5906                                   hh:TOOLTIP = "История пользователя" .
     5907                                   ii = ii + 1 .
     5908                               end.
     5909                       end case.
     5910                   end.
     5911                   hh = hh:next-sibling.
     5912               end.
     5913               b-help:column = v-frame-width - b-help:width-chars.
     5914               jj = 0.
     5915               repeat ii = 4 to 1 by -1 :
     5916                   if valid-handle (v-h[ii] ) then
     5917                   do:
     5918                       jj  = jj + 1 .
     5919                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5920                       v-h[ii]:row    = v-help-old-y .
     5921                   end.
     5922               end.
     5923           end.
     5924       end.
     5925   end procedure.
     5926   next-prev = yes.
     5927   n-p:
     5928   do while next-prev :
     5929   main-block:
     5930   do on error   undo main-block, leave main-block
     5931      on end-key undo main-block, leave main-block:
     5932     run ver-conf in this-procedure no-error .
     5933     run mode-on in this-procedure no-error.
     5934     if error-status:error    then do: undo, return error. end.
     5935     if doc-mode <> 'ПРОСМОТР':U then do:
     5936        line-rec = ?.
     5937        text-i = "Исходная" .
     5938        enable b-quest with frame d-pr-doc .
     5939        display text-i with frame d-pr-doc .
     5940        end.
     5941     hide b-quest in frame d-pr-doc .
     5942     run open-br in this-procedure .
     5943     run ui-on in this-procedure .
     5944     run cr-button in this-procedure .
     5945     run tax-name in this-procedure ( input 'rdt':U, output  dor-nal) .
     5946     assign ub.price-list.road-tax :label = dor-nal .
     5947      calc-name:RESIZABLE  in browse br-list  = true .
     5948   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5949   DEF VAR cur-clmn-numbr-list as INT EXTENT 15 no-undo.
     5950   DEF VAR varmvibr-list       as INT no-undo.
     5951   DEF VAR varmvjbr-list       as INT no-undo.
     5952   DEF VAR varmvkbr-list       as INT no-undo.
     5953   DEF VAR varmvlbr-list       as INT no-undo.
     5954   DEF VAR move-elementbr-list as INT no-undo.
     5955   def var jjbr-list           as int no-undo.
     5956   do varmvibr-list = 1 to EXTENT(cur-clmn-numbr-list):
     5957     ASSIGN cur-clmn-numbr-list[varmvibr-list] = varmvibr-list.
     5958   END.
     5959   RUN start-mv-clmnbr-list.
     5960   PROCEDURE start-mv-clmnbr-list:
     5961   def var old-session as logical no-undo.
     5962      old-session = SESSION:IMMEDIATE-DISPLAY.
     5963      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5964      SESSION:IMMEDIATE-DISPLAY = old-session.
     5965   END.
     5966   ON ctrl-cursor-right OF BROWSE br-list do:
     5967     RUN re-move-clmnbr-list ( 6, 15).
     5968   END.
     5969   ON ctrl-cursor-left OF BROWSE br-list do:
     5970     RUN re-move-clmnbr-list (15, 6).
     5971   END.
     5972   PROCEDURE re-move-clmnbr-list:
     5973     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5974     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5975     DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     5976       if cur-clmn-numbr-list[varmvibr-list] = source-column THEN cur-clmn-numbr-list[varmvibr-list] = -1.
     5977     END.
     5978     if br-list:MOVE-COLUMN(source-column, target-column) IN FRAME d-pr-doc then.
     5979     if source-column > target-column THEN
     5980     DO varmvjbr-list = source-column - 1 to target-column BY -1:
     5981       DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     5982           if cur-clmn-numbr-list[varmvibr-list] = varmvjbr-list THEN DO:
     5983             cur-clmn-numbr-list[varmvibr-list] = cur-clmn-numbr-list[varmvibr-list] + 1.
     5984           END.
     5985       END.
     5986     END.
     5987     ELSE
     5988     DO varmvjbr-list = source-column + 1 to target-column:
     5989       DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     5990         if cur-clmn-numbr-list[varmvibr-list] = varmvjbr-list THEN DO:
     5991           cur-clmn-numbr-list[varmvibr-list] = cur-clmn-numbr-list[varmvibr-list] - 1.
     5992         END.
     5993       END.
     5994     END.
     5995     DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     5996       if cur-clmn-numbr-list[varmvibr-list] = -1 THEN cur-clmn-numbr-list[varmvibr-list] = target-column.
     5997     END.
     5998   END PROCEDURE.
     5999   PROCEDURE ch-clmnbr-list:
     6000     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     6001     if cur-clmn-loc <= 6 then do:
     6002       return .
     6003     end.
     6004     DO varmvibr-list = 1 TO EXTENT(cur-clmn-numbr-list):
     6005       if cur-clmn-numbr-list[varmvibr-list] = cur-clmn-loc THEN move-elementbr-list = varmvibr-list.
     6006     END.
     6007     RUN re-move-clmnbr-list (cur-clmn-loc, 6).
     6008           if CAN-DO("7,8", STRING(move-elementbr-list)) THEN DO:
     6009             ASSIGN varmvkbr-list = 6.
     6010             DO varmvlbr-list = 1 to NUM-ENTRIES("7,8"):
     6011                 if move-elementbr-list = INTEGER(ENTRY (varmvlbr-list,"7,8")) THEN NEXT.
     6012                 varmvkbr-list = varmvkbr-list + 1.
     6013                 RUN re-move-clmnbr-list (cur-clmn-numbr-list[INTEGER(ENTRY(varmvlbr-list,"7,8"))], varmvkbr-list).
     6014             END.
     6015           END.
     6016           if CAN-DO("9,10", STRING(move-elementbr-list)) THEN DO:
     6017             ASSIGN varmvkbr-list = 6.
     6018             DO varmvlbr-list = 1 to NUM-ENTRIES("9,10"):
     6019                 if move-elementbr-list = INTEGER(ENTRY (varmvlbr-list,"9,10")) THEN NEXT.
     6020                 varmvkbr-list = varmvkbr-list + 1.
     6021                 RUN re-move-clmnbr-list (cur-clmn-numbr-list[INTEGER(ENTRY(varmvlbr-list,"9,10"))], varmvkbr-list).
     6022             END.
     6023           END.
     6024           if CAN-DO("11,12", STRING(move-elementbr-list)) THEN DO:
     6025             ASSIGN varmvkbr-list = 6.
     6026             DO varmvlbr-list = 1 to NUM-ENTRIES("11,12"):
     6027                 if move-elementbr-list = INTEGER(ENTRY (varmvlbr-list,"11,12")) THEN NEXT.
     6028                 varmvkbr-list = varmvkbr-list + 1.
     6029                 RUN re-move-clmnbr-list (cur-clmn-numbr-list[INTEGER(ENTRY(varmvlbr-list,"11,12"))], varmvkbr-list).
     6030             END.
     6031           END.
     6032           if CAN-DO("13,14", STRING(move-elementbr-list)) THEN DO:
     6033             ASSIGN varmvkbr-list = 6.
     6034             DO varmvlbr-list = 1 to NUM-ENTRIES("13,14"):
     6035                 if move-elementbr-list = INTEGER(ENTRY (varmvlbr-list,"13,14")) THEN NEXT.
     6036                 varmvkbr-list = varmvkbr-list + 1.
     6037                 RUN re-move-clmnbr-list (cur-clmn-numbr-list[INTEGER(ENTRY(varmvlbr-list,"13,14"))], varmvkbr-list).
     6038             END.
     6039           END.
     6040   END PROCEDURE.
     6041   PROCEDURE mv-brw-defaultbr-list:
     6042   def var old-session as logical no-undo.
     6043     old-session = SESSION:IMMEDIATE-DISPLAY.
     6044     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     6045     do varmvlbr-list = 6 to EXTENT(cur-clmn-numbr-list):
     6046       RUN re-move-clmnbr-list (cur-clmn-numbr-list[varmvlbr-list], varmvlbr-list).
     6047     END.
     6048     RUN start-mv-clmnbr-list.
     6049     SESSION:IMMEDIATE-DISPLAY = old-session.
     6050   END PROCEDURE.
     6051   .
     6052       wait-for go of frame d-pr-doc focus br-list.
     6053   end.
     6054   end.
     6055   run disable_ui in this-procedure .
     6056   FUNCTION fnc-base-code RETURN integer (local-bc as integer).
     6057   define variable local-base-code like ub.bar-code.b-code no-undo.
     6058   run prc-base-code in this-procedure ( input local-bc, output local-base-code ).
     6059   return (local-base-code).
     6060   END FUNCTION.
     6061   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6062   PROCEDURE calc-pr-list :
     6063   define input  parameter bc          like ub.price-list.b-code   no-undo .
     6064   define input  parameter d-num       like ub.price-doc.doc-num   no-undo .
     6065   define input  parameter calc-method             as character    no-undo .
     6066   define input  parameter increase-pc             as decimal      no-undo .
     6067   define input  parameter round-method            as character    no-undo .
     6068   define input  parameter round-base              as decimal      no-undo .
     6069   define input  parameter p-doc-price-rubl        as decimal      no-undo .
     6070   define input  parameter p-doc-price-base        as decimal      no-undo .
     6071   define input  parameter p-doc-price-rubl-novat  as decimal      no-undo .
     6072   define input  parameter p-doc-price-base-novat  as decimal      no-undo .
     6073   define output parameter calc-rec                as recid        no-undo .
     6074   define buffer buf-price-list for ub.price-list.
     6075   define buffer buf-price-doc  for ub.price-doc.
     6076   define buffer buf-bar-code   for ub.bar-code.
     6077   define buffer buf-goods      for ub.goods.
     6078   define buffer buf-gds-prt    for ub.gds-prt.
     6079   define buffer buf-gds-grp    for ub.gds-grp.
     6080   define buffer buf_contract   for ub.contract .
     6081   define buffer buf_contract-specif for ub.contract-specif .
     6082   define variable cur-pr like ub.price-list.price-sale no-undo .
     6083   define variable cur-rt like ub.price-list.road-tax   no-undo .
     6084   define variable cur-ex like ub.price-list.excise     no-undo .
     6085   define variable cur-dn like ub.price-list.doc-num    no-undo .
     6086   define variable loc-ret        as logical            no-undo .
     6087   define variable old-price-sale as decimal            no-undo .
     6088   define variable v-bonus        as decimal            no-undo .
     6089   assign
     6090     loc-ret = true
     6091   .
     6092   calc-pr:
     6093   do on error undo calc-pr, return error:
     6094     find  buf-bar-code no-lock where
     6095           buf-bar-code.b-code = bc.
     6096     find  buf-goods no-lock where
     6097           buf-goods.gds-code = buf-bar-code.gds-code.
     6098     find  buf-gds-prt no-lock where
     6099           buf-gds-prt.node-code = buf-bar-code.node-code.
     6100     find  buf-price-list where
     6101           buf-price-list.doc-num    = d-num and
     6102           buf-price-list.b-code     = bc and
     6103           buf-price-list.price-type = "".
     6104     find  buf-price-doc where
     6105           buf-price-doc.doc-num = d-num.
     6106     g#log = yes.
     6107     define variable loc-increase-pc      like  ub.goods.increase-pc no-undo .
     6108     define variable loc-grp-increase-pc  like  ub.goods.increase-pc no-undo .
     6109   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-increase-pc in g#library
     6111     (input  buf-goods.gds-code
     6112     ,input  buf-price-list.obj-type
     6113     ,input  buf-price-list.obj-code
     6114     ,output  loc-increase-pc
     6115     ) no-error .
     6116     if error-status :error then do:
     6117        message vss-workfile vss-revision vss-description skip
     6118        "Ошибка метода поиска наценки товара на объекте" skip
     6119        error-status :get-message(1) .
     6120     end.
     6121   define variable p-prc-min        as decimal   no-undo .
     6122   define variable p-prc-max        as decimal   no-undo .
     6123   define variable p-round-method   as character no-undo .
     6124   define variable p-base           as decimal   no-undo .
     6125   define variable p-value-margin   as integer   no-undo .
     6126   define variable p-type-margin    as logical   no-undo .
     6127   define variable p-value-increase as integer   no-undo .
     6128   define variable p-type-increase  as logical   no-undo .
     6129   define variable p-value-rmethod  as integer   no-undo .
     6130   define variable p-type-rmethod   as logical   no-undo .
     6131   run gds-attr-margin-value
     6132   (
     6133     input   buf-goods.gds-code ,
     6134     input   buf-price-list.obj-type  ,
     6135     input   buf-price-list.obj-code  ,
     6136     output  p-prc-min  ,
     6137     output  p-prc-max  ,
     6138     output  loc-grp-increase-pc,
     6139     output  p-round-method   ,
     6140     output  p-base           ,
     6141     output  p-value-margin    ,
     6142     output  p-type-margin     ,
     6143     output  p-value-increase    ,
     6144     output  p-type-increase   ,
     6145     output  p-value-rmethod    ,
     6146     output  p-type-rmethod
     6147     ) no-error .
     6148     if error-status :error then do:
     6149        message vss-workfile vss-revision vss-description skip
     6150        "Ошибка процедуры поиска наценки по группе товара на объекте" skip
     6151        error-status :get-message(1) skip
     6152        return-value .
     6153     end.
     6154     define variable g-g as logical no-undo .
     6155     g-g = false .
     6156     case calc-method:
     6157       when 'Товар':U then do:
     6158         case buf-goods.calc-method:
     6159           when 'Группа':U then do:
     6160             find buf-gds-grp no-lock where
     6161                 buf-gds-grp.node-code = buf-goods.grp-code.
     6162             case buf-gds-grp.calc-method:
     6163      when 'Накл-безНДС':U  then do:
     6164         if available ub.trn-doc then do:
     6165           if ub.trn-doc.doc-type = 'при':U and
     6166            ( ub.trn-doc.ext-doc-type = 'ie':U  ) then do:
     6167             find ub.doc-line where ub.doc-line.doc-code = doc-code
     6168                             and ub.doc-line.artic     = buf-price-list.artic
     6169                             and ub.doc-line.prod-type = buf-price-list.prod-type
     6170                             and ub.doc-line.prod-code = buf-price-list.prod-code no-lock no-error.
     6171             if available ub.doc-line then DO:
     6172                 run str/gdsnovat.p
     6173                    ('Накл-безНДС':U,
     6174                     buf-price-list.obj-type          ,
     6175                     buf-price-list.obj-code          ,
     6176                     buf-price-doc.host-code         ,
     6177                     buf-price-list.artic             ,
     6178                     buf-price-list.prod-type         ,
     6179                     buf-price-list.prod-code         ,
     6180                     loc-grp-increase-pc                   ,
     6181                     doc-code              ,
     6182                     input p-doc-price-rubl-novat   ,
     6183                     input p-doc-price-base-novat   ,
     6184                     output cost-base      ,
     6185                     output cost-rubl      ,
     6186                     output v-price-base   ,
     6187                     output v-price-rubl   ,
     6188                     output cur-rt-base    ,
     6189                     output cur-rt-rubl   )
     6190                     .
     6191                 assign
     6192                   cur-rt =  if var-pr-r-b = "rubl" then cur-rt-rubl else cur-rt-base
     6193                   buf-price-list.calc-method = 'Накл-безНДС':U + " " + doc-code
     6194                   buf-price-list.price-calc  =  if var-pr-r-b = "rubl" then  ub.doc-line.price-rubl  else ub.doc-line.price-base
     6195                   buf-price-list.price-sale  =  if var-pr-r-b = "rubl" then  v-price-rubl         else  v-price-base
     6196                   buf-price-list.road-tax    = cur-rt
