     2068   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2069   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     2070                                           local-doc-num as char).
     2071   define buffer base-price        for ub.price-list.
     2072   define variable local-main-code like ub.bar-code.b-code no-undo.
     2073   define variable local-base-code like ub.bar-code.b-code no-undo.
     2074     run prc-base-code (input local-bc, output local-base-code).
     2075     find base-price no-lock where
     2076          base-price.doc-num = local-doc-num and
     2077          base-price.b-code  = local-base-code and
     2078          base-price.price-type = "" no-error.
     2079     if not available base-price then do:
     2080       run prc-main-code (input local-bc, output local-main-code).
     2081       find  base-price no-lock where
     2082             base-price.doc-num = local-doc-num and
     2083             base-price.b-code  = local-main-code and
     2084             base-price.price-type = "" no-error.
     2085     end.
     2086     if available base-price then
     2087       return (base-price.price-sale).
     2088     else
     2089       return (?).
     2090   END FUNCTION.
     2091   procedure prc-main-code:
     2092   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     2093   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     2094   define buffer local-bar-code        for ub.bar-code.
     2095   define buffer local-goods           for ub.goods.
     2096   define buffer main-code             for ub.bar-code.
     2097   define buffer main-prt              for ub.gds-prt.
     2098     local-main-code = ?.
     2099     find local-bar-code no-lock where
     2100          local-bar-code.b-code = local-bc no-error.
     2101     if not available local-bar-code then
     2102       return.
     2103     find local-goods no-lock where
     2104          local-goods.gds-code = local-bar-code.gds-code.
     2105     find first  main-prt no-lock where
     2106                 main-prt.upper-code = local-goods.prt-root.
     2107     find  main-code no-lock where
     2108           main-code.gds-code  = local-bar-code.gds-code and
     2109           main-code.in-code   = "" and
     2110           main-code.part-code = "" and
     2111           main-code.unit-cli  = local-goods.unit-base and
     2112           main-code.node-code = main-prt.node-code.
     2113     local-main-code = main-code.b-code.
     2114   end procedure.
     2115   procedure prc-base-code:
     2116   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     2117   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     2118   define buffer local-bar-code for ub.bar-code.
     2119   define buffer local-goods    for ub.goods.
     2120   define buffer base-code      for ub.bar-code.
     2121     local-base-code = ?.
     2122     find local-bar-code no-lock where
     2123          local-bar-code.b-code = local-bc no-error.
     2124     if not available local-bar-code then
     2125       return.
     2126     find local-goods no-lock where
     2127          local-goods.gds-code = local-bar-code.gds-code.
     2128     find base-code no-lock where
     2129          base-code.gds-code  = local-bar-code.gds-code and
     2130          base-code.node-code = local-bar-code.node-code and
     2131          base-code.in-code   = local-bar-code.in-code and
     2132          base-code.part-code = local-bar-code.part-code and
     2133          base-code.unit-cli  = local-goods.unit-base.
     2134     local-base-code = base-code.b-code.
     2135   end procedure.
     2136   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2137   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2138   procedure prcreate-new-price-doc :
     2139   do
     2140   on error undo, return error return-value
     2141   :
     2142   define input  parameter p-curr-db-num  as integer   no-undo .
