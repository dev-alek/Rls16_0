      226   function cross-list returns logical (
      227     input parfirst-stream  as character,
      228     input parsecond-stream as character,
      229     input pardelim         as character).
      230     if pardelim = ""
      231     or pardelim = ?
      232     then do:
      233       assign
      234         pardelim = ","
      235       .
      236     end.
      237     define variable vari            as integer no-undo .
      238     define variable varresult-cross as logical no-undo .
      239     assign
      240       varresult-cross = no
      241     .
      242     def var v-num-parfirst-stream as integer no-undo .
      243     assign
      244       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      245     .
      246     do vari = 1 to v-num-parfirst-stream
      247     :
      248       if lookup(entry(vari, parfirst-stream, pardelim)
      249                ,parsecond-stream
      250                ,pardelim
      251                ) > 0 then do:
      252         assign
      253           varresult-cross = yes
      254         .
      255         leave.
      256       end.
      257     end.
      258     return varresult-cross .
      259   end function.
