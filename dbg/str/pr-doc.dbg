      693   procedure grp-obj-write :
      694   do
      695   on error undo, return error
      696   :
      697   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      698   define input parameter p-host-code  as integer                          no-undo.
      699   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      700   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      701   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      702   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      703   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      704   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      705   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      706   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      707   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      708   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      709   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      710       find first buf_gds-grp-obj exclusive-lock
      711            where buf_gds-grp-obj.node-code  = p-node-code
      712              and buf_gds-grp-obj.host-code  = p-host-code
      713              and buf_gds-grp-obj.obj-type   = p-obj-type
      714              and buf_gds-grp-obj.obj-code   = p-obj-code
      715       no-error.
      716       if not available buf_gds-grp-obj
      717       then do:
      718           create buf_gds-grp-obj.
      719           assign
      720                   buf_gds-grp-obj.node-code  = p-node-code
      721                   buf_gds-grp-obj.host-code  = p-host-code
      722                   buf_gds-grp-obj.obj-type   = p-obj-type
      723                   buf_gds-grp-obj.obj-code   = p-obj-code
      724           .
      725       end.
      726       assign
      727       buf_gds-grp-obj.min-increase = p-min-increase
      728       buf_gds-grp-obj.max-increase = p-max-increase
      729       buf_gds-grp-obj.increase-pc = p-increase-pc
      730       buf_gds-grp-obj.calc-method = p-calc-method
      731       buf_gds-grp-obj.round-method = p-round-method
      732       buf_gds-grp-obj.round-coef = p-round-coef
      733       buf_gds-grp-obj.cli-type   = p-cli-type
      734       buf_gds-grp-obj.cli-code   = p-cli-code
      735       .
      736   end.
      737   end procedure.
      738   procedure grp-obj-margin-value :
      739   do
      740   on error undo, return error
      741   :
      742   define input parameter p-node-code as integer      no-undo.
      743   define input parameter p-obj-type  as character    no-undo.
      744   define input parameter p-obj-code  as integer      no-undo.
      745   define output parameter p-min-value as decimal      no-undo init ?.
      746   define output parameter p-max-value as decimal      no-undo init ?.
      747   define output parameter p-increase-pc as decimal      no-undo init ?.
      748   define output parameter p-round-method as character no-undo init "":U.
      749   define output parameter p-base as decimal no-undo init ?.
      750   define output parameter p-range-margin     as integer      no-undo.
      751   define output parameter p-exists-margin    as logical      no-undo.
      752   define output parameter p-range-increase     as integer      no-undo.
      753   define output parameter p-exists-increase    as logical      no-undo.
      754   define output parameter p-range-rmethod     as integer no-undo .
      755   define output parameter p-exists-rmethod    as logical no-undo .
      756   define variable v-host-code as integer      no-undo.
      757   DEFINE VARIABLE v-found as logical no-undo .
      758   DEFINE VARIABLE v-exists as logical no-undo .
      759   DEFINE VARIABLE v-range as integer no-undo .
      760   DEFINE VARIABLE jj as integer no-undo .
      761   DEFINE VARIABLE v-margin-found as logical no-undo .
      762   DEFINE VARIABLE v-increase-found as logical no-undo .
      763   DEFINE VARIABLE v-min-value as decimal      no-undo.
      764   DEFINE VARIABLE v-max-value as decimal      no-undo.
      765   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      766   define variable v-round-method as character no-undo .
      767   define variable v-base as decimal no-undo .
      768   define variable v-print-code as character no-undo .
      769   define buffer buf_gds-grp for ub.gds-grp.
      770   find first buf_gds-grp no-lock where
      771              buf_gds-grp.node-code = p-node-code no-error .
      772   if not avail buf_gds-grp and p-node-code <> 0 then do:
      773     message
      774       vss-workfile vss-revision vss-description
      775       skip "Не удалось найти группу товаров с кодом" p-node-code
      776       view-as alert-box error .
      777     undo, return error .
      778   end.
      779   if p-obj-type <> '' then do:
      780   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      782     (input  p-obj-type
      783     ,input  p-obj-code
      784     ,output v-host-code
      785     ) no-error .
      786     if error-status :error
      787     then do:
      788         message
      789           vss-workfile vss-revision vss-description
      790           skip "Не удалось найти фирму объекта"
      791           skip p-obj-type p-obj-code
      792           skip return-value
      793           skip trim(error-status :get-message(1))
      794               trim(error-status :get-message(2))
      795               trim(error-status :get-message(3))
      796               trim(error-status :get-message(4))
      797               trim(error-status :get-message(5))
      798         view-as alert-box error.
      799         undo, return error .
      800     end.
      801   end.
      802   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      803   do while v-found = no and jj < 2:
      804     if v-range <> 3 then do:
      805       find first buf_gds-grp-obj no-lock
      806           where buf_gds-grp-obj.node-code = p-node-code
      807             and buf_gds-grp-obj.host-code = v-host-code
      808             and buf_gds-grp-obj.obj-type  = p-obj-type
      809             and buf_gds-grp-obj.obj-code  = p-obj-code
      810       no-error .
      811     end.
      812     if v-range = 3 or not available buf_gds-grp-obj
      813     then do:
      814        if v-range <> 2 then do:
      815           find first buf_gds-grp-obj no-lock
      816               where buf_gds-grp-obj.node-code = p-node-code
      817                 and buf_gds-grp-obj.host-code = v-host-code
      818                 and buf_gds-grp-obj.obj-type  = ""
      819                 and buf_gds-grp-obj.obj-code  = 0
      820           no-error .
      821         end.
      822         if v-range = 2 or not available buf_gds-grp-obj
      823         then do:
      824             if v-range <> 1 then do:
      825               find first buf_gds-grp-obj no-lock
      826                   where buf_gds-grp-obj.node-code = p-node-code
      827                   and buf_gds-grp-obj.host-code = 0
      828                   and buf_gds-grp-obj.obj-type  = ""
      829                   and buf_gds-grp-obj.obj-code  = 0
      830               no-error .
      831             end.
      832             if v-range = 1 or not available buf_gds-grp-obj
      833             then do:
      834                 assign
      835                     v-exists = no
      836                 .
      837             end.
      838             else do:
      839                 assign
      840                     v-exists = yes
      841                     v-range = 1
      842                 .
      843             end.
      844         end.
      845         else do:
      846             assign
      847                 v-exists = yes
      848                 v-range  = 2
      849             .
      850         end.
      851     end.
      852     else do:
      853         assign
      854             v-exists = yes
      855             v-range  = 3
      856         .
      857     end.
      858     if available buf_gds-grp-obj
      859     then do:
      860       assign
      861       v-min-value    = buf_gds-grp-obj.min-increase
      862       v-max-value    = buf_gds-grp-obj.max-increase
      863       v-increase-pc  = buf_gds-grp-obj.increase-pc
      864       v-round-method = buf_gds-grp-obj.round-method
      865       v-base         = buf_gds-grp-obj.round-coef
      866       .
      867       assign
      868       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      869                           then yes
      870                           else p-exists-margin)
      871       p-range-margin = if p-exists-margin and p-min-value = ?
      872                         then v-range
      873                         else p-range-margin
      874       p-min-value   =  if p-exists-margin and  p-min-value = ?
      875                         then v-min-value
      876                         else p-min-value
      877       p-max-value   =  if p-exists-margin and  p-max-value = ?
      878                         then v-max-value
      879                         else p-max-value
      880       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      881                           then yes
      882                           else p-exists-increase)
      883       p-range-increase = if p-exists-increase and p-increase-pc = ?
      884                         then v-range
      885                         else p-range-increase
      886       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      887                         then v-increase-pc
      888                         else p-increase-pc)
      889       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      890                           then yes
      891                           else p-exists-rmethod
      892       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      893                           then v-range
      894                           else p-range-rmethod)
      895       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      896                           then v-round-method
      897                           else p-round-method)
      898       p-base          = (if p-exists-rmethod and p-base = ?
      899                           then v-base
      900                           else p-base)
      901       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      902       jj = jj + 1
      903       .
      904     end.
      905     else do:
      906       assign
      907       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      908       jj = jj + 1
      909       .
      910     end.
      911   end.
      912   end.
      913   end procedure.
      914   procedure grp-obj-income-cli-value :
      915   do
      916   on error undo, return error
      917   :
      918   define input parameter p-node-code as integer      no-undo.
      919   define input parameter p-obj-type  as character    no-undo.
