     8708     end case.
     8709   run main-road-tax
     8710     ( input buf-price-list.obj-type ,
     8711       input buf-price-list.obj-code ,
     8712       input buf-price-list.artic    ,
     8713       input buf-price-list.prod-type,
     8714       input buf-price-list.prod-code,
     8715       input-output cur-rt-base,
     8716       input-output cur-rt-rubl )
     8717       .
     8718       if var-pr-r-b = "rubl" then do:
     8719           if ( cur-rt-rubl <> ? )   then
     8720             assign
     8721               buf-price-list.road-tax  = cur-rt-rubl
     8722               .
     8723               else
     8724                   assign
     8725                     buf-price-list.road-tax  = 0
     8726                     .
     8727      end.
     8728      else do:
     8729           if ( cur-rt-base <> ? )   then
     8730             assign
     8731               buf-price-list.road-tax  = cur-rt-base
     8732               .
     8733               else
     8734                   assign
     8735                     buf-price-list.road-tax  = 0
     8736                     .
     8737      end.
     8738   case round-method :
     8739     when '9-окончание':U then do:
     8740       if buf-price-list.price-sale < 29 then do:
     8741         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     8742           assign
     8743             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     8744           .
     8745         end.
     8746       end.
     8747       else do:
     8748         if (buf-price-list.price-sale modulo 10) < 3 then do:
     8749           assign
     8750             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     8751                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     8752                   - 1 ) * 10
     8753                 + 9
     8754           .
     8755         end.
     8756         else do:
     8757           assign
     8758             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     8759                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     8760                   ) * 10
     8761                 + 9
     8762           .
     8763         end.
     8764         assign
     8765           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     8766         .
     8767       end.
     8768     end.
     8769     when '9-99окончание':U then do:
     8770       if buf-price-list.price-sale < round-base then do:
     8771         assign
     8772           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     8773         .
     8774       end.
     8775       else do:
     8776         assign
     8777           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     8778         .
     8779       end.
     8780     end.
     8781     when 'Без-дробных':U then do:
     8782       assign
     8783         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     8784       .
     8785     end.
     8786     when 'Произвольно':U then do:
     8787       if round-base <> 0 then do:
     8788         assign
     8789           buf-price-list.price-sale = round (buf-price-list.price-sale / round-base, 0) * round-base
     8790         .
     8791         if buf-price-list.price-sale = 0 then do:
     8792           assign
     8793             buf-price-list.price-sale = round-base
     8794           .
     8795         end.
     8796       end.
     8797     end.
     8798     when 'Вверх':U then do:
     8799       if round-base <> 0 then do:
     8800         if truncate ( buf-price-list.price-sale / round-base, 0 ) <> (buf-price-list.price-sale / round-base) then do:
     8801           assign
     8802             buf-price-list.price-sale = truncate (buf-price-list.price-sale / round-base, 0) * round-base + round-base
     8803           .
     8804         end.
     8805       end.
     8806       if buf-price-list.price-sale = 0 then do:
     8807         assign
     8808           buf-price-list.price-sale = round-base
     8809         .
     8810       end.
     8811     end.
     8812     when 'Коэффициент':U then do:
     8813       if round-base <> 0 then do:
     8814         assign
     8815           buf-price-list.price-sale = buf-price-list.price-sale * round-base
     8816         .
     8817       end.
     8818     end.
     8819     when 'Отключено':U then do:
     8820     end.
     8821     otherwise do:
     8822       message
     8823         vss-workfile vss-revision vss-description skip
     8824         "Неизвестный метод округления продажной цены" skip
     8825         "round-method" round-method skip
     8826         "round-base"   round-base   skip
     8827         "price"        buf-price-list.price-sale             skip
     8828         view-as alert-box error .
     8829     end.
     8830   end.
     8831     calc-rec = recid (buf-price-list).
     8832     run calc-pr-sub (input  buf-bar-code.b-code,
     8833                      input  buf-price-list.doc-num,
     8834                      input  calc-method,
     8835                      input  increase-pc,
     8836                      input  round-method,
     8837                      input  round-base,
     8838                      output calc-rec) no-error.
     8839     if error-status :error then
     8840       undo calc-pr, return error.
     8841       old-price-sale = buf-price-list.price-sale .
     8842      if line-mode = "calc":u then do:
     8843           run calc-sigma (input buf-price-list.b-code,
     8844                           input-output buf-price-list.price-sale,
     8845                           input buf-price-doc.host-code,
     8846                           input buf-price-doc.obj-code,
     8847                           input buf-price-doc.obj-type,
     8848                           output loc-ret).
     8849           if loc-ret = false then
     8850             message "Цена товара :" SKIP
     8851             "артикул :" buf-price-list.artic buf-price-list.prod-type buf-price-list.prod-code skip
     8852             "бар-код :" buf-price-list.b-code skip
     8853               "не изменилась из-за заданного максимально допустимого отклонения! " skip
     8854               " Рассчитанная цена "  old-price-sale skip
     8855               " Действующая цена "   buf-price-list.price-sale
     8856               view-as alert-box .
     8857      end.
     8858   end.
     8859   END PROCEDURE.
     8860   procedure calc-sigma :
     8861    do
     8862    on error undo, return error return-value
     8863    :
     8864   define input parameter l-bcode like ub.price-list.b-code no-undo .
     8865   define input-output parameter new-price as decimal no-undo .
     8866   define input parameter l-host as integer no-undo .
     8867   define input parameter l-code as integer no-undo .
     8868   define input parameter l-type as character no-undo .
     8869   define output parameter p-ret as logical no-undo .
     8870   define variable conf-par     as character no-undo.
     8871   define variable par-type     as character no-undo.
     8872   define variable i-sigma as decimal no-undo .
     8873   define variable cur-pr like ub.price-list.price-sale no-undo.
     8874   define variable cur-rt like ub.price-list.road-tax   no-undo.
     8875   define variable cur-ex like ub.price-list.excise     no-undo.
     8876   define variable cur-dn like ub.price-list.doc-num    no-undo.
     8877   define variable old-price as decimal no-undo .
     8878   define variable v-value-character as character no-undo .
     8879   define variable v-value-date      as date      no-undo .
     8880   define variable v-value-decimal   as decimal   no-undo .
     8881   define variable v-value-integer   as integer   no-undo .
     8882   define variable v-value-logical   as logical   no-undo .
     8883   p-ret = true  .
     8884   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     8885   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8887     (input  l-type
     8888     ,input  l-code
     8889     ,input  l-bcode
     8890     ,input  0
     8891     ,input  0
     8892     ,output cur-dn
     8893     ,output cur-pr
     8894     ,output cur-rt
     8895     ,output cur-ex
     8896     )  .
     8897   old-price = cur-pr .
     8898   if old-price =  new-price then do:
     8899      p-ret = true .
     8900      return.
     8901   end.
     8902      i-sigma = decimal(par-pr-sigma) .
     8903      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     8904          assign
     8905            p-ret = false
     8906            new-price = old-price
     8907          .
     8908          end.
     8909      else p-ret = true .
     8910     end.
     8911    end.
     8912   end procedure.
     8913   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8914   define new global shared variable g#lib-trn  as handle no-undo .
     8915   define new global shared variable g#lib-trn2 as handle no-undo .
     8916   define new global shared variable g#lib-trn3 as handle no-undo .
     8917   define new global shared variable g#lib-trn4 as handle no-undo .
     8918   procedure main-road-tax :
     8919   define input parameter p-obj-type  like ub.gds-obj.obj-type  no-undo .
     8920   define input parameter p-obj-code  like ub.gds-obj.obj-code  no-undo .
     8921   define input parameter p-artic     like ub.gds-obj.artic     no-undo .
     8922   define input parameter p-prod-type like ub.gds-obj.prod-type no-undo .
     8923   define input parameter p-prod-code like ub.gds-obj.prod-code no-undo .
     8924   define input-output parameter p-road-tax-base as decimal no-undo .
     8925   define input-output parameter p-road-tax-rubl as decimal no-undo .
     8926   define variable v-doc-code as character no-undo .
     8927   define buffer     buff-goods    for ub.goods      .
     8928   define buffer     buf_gds-obj   for ub.gds-obj .
     8929   define buffer     buf_parts     for ub.parts   .
     8930   define buffer b-td_trn-doc for ub.trn-doc  .
     8931   define buffer b-dl_doc-line for ub.doc-line .
     8932   define variable is-petrolium              as logical no-undo .
     8933   define variable is-pieces                 as logical no-undo .
     8934   define variable is-hold-td                as logical no-undo .
     8935   define variable v-rec                     as recid   no-undo .
     8936   define variable t-ret                     as logical no-undo .
     8937   define variable v-total-avrg-base         as decimal no-undo .
     8938   define variable v-total-avrg-rubl         as decimal no-undo .
     8939   define variable v-total-avrg-qnty         as decimal no-undo .
     8940   define variable v-total-road-tax-base     as decimal no-undo .
     8941   define variable v-total-road-tax-rubl     as decimal no-undo .
     8942   define variable v-all-total-road-tax-base as decimal no-undo .
     8943   define variable v-all-total-road-tax-rubl as decimal no-undo .
     8944   assign
     8945     p-road-tax-base = ?
     8946     p-road-tax-rubl = ?
     8947     .
     8948     Find first buff-goods no-lock where
     8949           buff-goods.artic     = p-artic and
     8950           buff-goods.prod-type = p-prod-type and
     8951           buff-goods.prod-code = p-prod-code
     8952           no-error .
     8953         If avail buff-goods Then DO:
     8954              v-rec = recid (buff-goods).
     8955              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     8956   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     8957     (
     8958        input p-artic
     8959     ,  input p-prod-type
     8960     ,  input p-prod-code
     8961     , output is-petrolium
     8962     , output is-pieces
     8963     ) .
     8964              t-ret =  session:set-wait-state("") .
     8965              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     8966                   assign
     8967                     p-road-tax-base = ?
     8968                     p-road-tax-rubl = ?
     8969                     .
     8970                   return.
     8971              end.
     8972         end.
     8973         assign
     8974             v-total-avrg-qnty = 0
     8975             v-total-road-tax-base =  0
     8976             v-total-road-tax-rubl =  0
     8977             v-all-total-road-tax-base =  0
     8978             v-all-total-road-tax-rubl =  0
     8979             .
     8980         for each buf_parts no-lock
     8981           where buf_parts.obj-type  = p-obj-type
     8982             and buf_parts.obj-code  = p-obj-code
     8983             and buf_parts.artic     = p-artic
     8984             and buf_parts.prod-type = p-prod-type
     8985             and buf_parts.prod-code = p-prod-code
     8986             and buf_parts.status_   = no
     8987             and buf_parts.out-code  = 'free-zone':U
     8988             and buf_parts.qnty      > 0
     8989         on error undo, return error
     8990         :
     8991            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     8992   assign
     8993     price-rubl-with-tax-loc = buf_parts.price-rubl
     8994     price-base-with-tax-loc = buf_parts.price-base
     8995   .
     8996   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8998     (output varinvprb
     8999     )  .
     9000     if buf_parts.out-code = 'free-zone':U     or
     9001        buf_parts.out-code = 'out-zone':U   or
     9002        buf_parts.doc-type = 'акт':U then do:
     9003       assign
     9004         in-vatp-have-vat-slt = yes.
     9005     end.
     9006     else do:
     9007       find first in-vatp_doc-attr no-lock
     9008         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     9009           and in-vatp_doc-attr.attr-code = 'envd':U
     9010         no-error .
     9011       if not available in-vatp_doc-attr then do:
     9012         assign
     9013           in-vatp-have-vat-slt = yes.
     9014       end.
     9015       else do:
     9016            in-vatp-have-vat-slt = no.
     9017       end.
     9018     end.
     9019     assign
     9020      price-cli-with-tax-loc = buf_parts.price-cli
     9021      cli-base-rate          = buf_parts.cli-base-rate.
     9022     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     9023              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     9024     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     9025             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     9026             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     9027             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     9028             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     9029             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     9030             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     9031       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     9032     assign
     9033       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     9034     assign
     9035       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     9036       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     9037       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     9038       transport-cli-loc  = 0
     9039       other-cli-loc      = 0
     9040     .
     9041   ASSIGN
     9042             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     9043       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     9044   .
     9045           assign
     9046             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     9047             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     9048            .
     9049         end.
     9050             if v-total-avrg-qnty > 0 then  do :
     9051                 assign
     9052                     p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     9053                     p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     9054                     .
     9055              end.
     9056               if v-total-avrg-qnty <= 0 then do :
     9057                 find first buf_gds-obj no-lock
     9058                   where buf_gds-obj.obj-type  = p-obj-type
     9059                     and buf_gds-obj.obj-code  = p-obj-code
     9060                     and buf_gds-obj.artic     = p-artic
     9061                     and buf_gds-obj.prod-type = p-prod-type
     9062                     and buf_gds-obj.prod-code = p-prod-code
     9063                   no-error .
     9064                       if available buf_gds-obj then do :
     9065                         if buf_gds-obj.in-code <> "" then
     9066                              v-doc-code = buf_gds-obj.in-code.
     9067                         else do:
     9068                           if available ub.price-doc then  v-doc-code = ub.price-doc.out-code.
     9069                         end.
     9070   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9071   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     9072     (input  v-doc-code
     9073     ,output is-hold-td
     9074     )  .
     9075                         if is-hold-td = true then do:
     9076                           assign
     9077                               p-road-tax-rubl = 0
     9078                               p-road-tax-base = 0
     9079                               .
     9080                         end.
     9081                         else do:
     9082                             find b-td_trn-doc  where b-td_trn-doc.doc-code   = v-doc-code no-lock no-error .
     9083                             find b-dl_doc-line where b-dl_doc-line.doc-code  = b-td_trn-doc.doc-code
     9084                                             and b-dl_doc-line.artic     = p-artic
     9085                                             and b-dl_doc-line.prod-type = p-prod-type
     9086                                             and b-dl_doc-line.prod-code = p-prod-code no-lock no-error.
     9087                                   if available b-dl_doc-line then do :
     9088   assign
     9089     price-rubl-with-tax-loc = b-dl_doc-line.price-rubl
     9090     price-base-with-tax-loc = b-dl_doc-line.price-base
     9091   .
     9092   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9093   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9094     (output varinvprb
     9095     )  .
     9096      find first in-vatp_doc-attr no-lock
     9097       where in-vatp_doc-attr.doc-code  = b-td_trn-doc.doc-code
     9098         and in-vatp_doc-attr.attr-code = 'envd':U
     9099       no-error .
     9100       if available in-vatp_doc-attr
     9101          then do:
     9102          assign
     9103            in-vatp-have-vat-slt = no.
     9104      end.
     9105      else do:
     9106        assign
     9107          in-vatp-have-vat-slt = yes.
     9108      end.
     9109      find first in-vatp-goods where in-vatp-goods.artic     = b-dl_doc-line.artic     and
     9110                                        in-vatp-goods.prod-type = b-dl_doc-line.prod-type and
     9111                                        in-vatp-goods.prod-code = b-dl_doc-line.prod-code no-lock.
     9112      if (not b-td_trn-doc.internal and
     9113              b-td_trn-doc.doc-type = 'при':U) or
     9114         in-vatp-goods.gds-type = 'у':U then do:
     9115         if varinvprb = "base":u then do:
     9116           assign
     9117             road-tax-base-loc = b-dl_doc-line.road-tax
     9118             road-tax-rubl-loc = b-dl_doc-line.road-tax * b-td_trn-doc.base-rate / b-td_trn-doc.base-scale.
     9119         end.
     9120         else do:
     9121           ASSIGN
     9122             road-tax-rubl-loc = b-dl_doc-line.road-tax
     9123             road-tax-base-loc = b-dl_doc-line.road-tax / b-td_trn-doc.base-rate * b-td_trn-doc.base-scale.
