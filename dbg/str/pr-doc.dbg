     3042   procedure grp-obj-notcorr-value :
     3043   do
     3044   on error undo, return error
     3045   :
     3046   define input parameter p-node-code             as integer      no-undo.
     3047   define input parameter p-obj-type              as character    no-undo.
     3048   define input parameter p-obj-code              as integer      no-undo.
     3049   define output parameter p-notcorr              as character    no-undo init ?.
     3050   define output parameter p-range-notcorr     as integer      no-undo.
     3051   define output parameter p-exists-notcorr    as logical      no-undo.
     3052   define variable v-host-code as integer      no-undo.
     3053   DEFINE VARIABLE v-found as logical no-undo .
     3054   DEFINE VARIABLE v-exists as logical no-undo .
     3055   DEFINE VARIABLE v-range as integer no-undo .
     3056   DEFINE VARIABLE jj as integer no-undo .
     3057   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     3058   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     3059   define buffer buf_gds-grp for ub.gds-grp.
     3060   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     3061   find first buf_gds-grp no-lock where
     3062              buf_gds-grp.node-code = p-node-code no-error .
     3063   if not avail buf_gds-grp and p-node-code <> 0 then do:
     3064     message
     3065       vss-workfile vss-revision vss-description
     3066       skip "Не удалось найти группу товаров с кодом" p-node-code
     3067       view-as alert-box error .
     3068     undo, return error .
     3069   end.
     3070   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3071   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3072     (input  p-obj-type
     3073     ,input  p-obj-code
     3074     ,output v-host-code
     3075     ) no-error .
     3076   if error-status :error
     3077   then do:
     3078       message
     3079         vss-workfile vss-revision vss-description
     3080         skip "Не удалось найти фирму объекта"
     3081         skip p-obj-type p-obj-code
     3082         skip return-value
     3083         skip trim(error-status :get-message(1))
     3084       view-as alert-box error.
     3085       undo, return error .
     3086   end.
     3087   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     3088   do while v-found = no and jj < 2:
     3089     if v-range <> 3 then do:
     3090       find first buf_gds-grp-obj no-lock
     3091           where buf_gds-grp-obj.node-code = p-node-code
     3092             and buf_gds-grp-obj.host-code = v-host-code
     3093             and buf_gds-grp-obj.obj-type  = p-obj-type
     3094             and buf_gds-grp-obj.obj-code  = p-obj-code
     3095       no-error .
     3096     end.
     3097     if v-range = 3 or not available buf_gds-grp-obj
     3098     then do:
     3099        if v-range <> 2 then do:
     3100           find first buf_gds-grp-obj no-lock
     3101               where buf_gds-grp-obj.node-code = p-node-code
     3102                 and buf_gds-grp-obj.host-code = v-host-code
     3103                 and buf_gds-grp-obj.obj-type  = ""
     3104                 and buf_gds-grp-obj.obj-code  = 0
     3105           no-error .
     3106         end.
     3107         if v-range = 2 or not available buf_gds-grp-obj
     3108         then do:
     3109             if v-range <> 1 then do:
     3110               find first buf_gds-grp-obj no-lock
     3111                   where buf_gds-grp-obj.node-code = p-node-code
     3112                   and buf_gds-grp-obj.host-code = 0
     3113                   and buf_gds-grp-obj.obj-type  = ""
     3114                   and buf_gds-grp-obj.obj-code  = 0
     3115               no-error .
     3116             end.
     3117             if v-range = 1 or not available buf_gds-grp-obj
     3118             then do:
     3119                 assign
     3120                     v-exists = no
     3121                 .
     3122             end.
     3123             else do:
     3124                 assign
     3125                     v-exists = yes
     3126                     v-range = 1
     3127                 .
     3128             end.
     3129         end.
     3130         else do:
     3131             assign
     3132                 v-exists = yes
     3133                 v-range  = 2
     3134             .
     3135         end.
     3136     end.
     3137     else do:
     3138         assign
     3139             v-exists = yes
     3140             v-range  = 3
     3141         .
     3142     end.
     3143     if available buf_gds-grp-obj
     3144     then do:
     3145       find first buf_gds-grp-obj-attr no-lock
     3146         where buf_gds-grp-obj-attr.node-code   = p-node-code
     3147           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     3148           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     3149           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     3150           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     3151         no-error .
     3152       if available buf_gds-grp-obj-attr then do:
     3153         assign
     3154           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     3155         .
     3156       end.
     3157       else do:
     3158         assign
     3159           v-notcorr-value = ?
     3160         .
     3161       end.
     3162       assign
     3163       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     3164                           then yes
     3165                           else p-exists-notcorr)
     3166       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     3167                         then v-range
     3168                         else p-range-notcorr
     3169       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     3170                         then v-notcorr-value
     3171                         else p-notcorr
     3172       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     3173       jj = jj + 1
     3174       .
     3175     end.
     3176     else do:
     3177       assign
     3178       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     3179       jj = jj + 1
     3180       .
     3181     end.
     3182   end.
     3183   end.
     3184   end procedure.
     3185   define variable vss-include-info37 as character format "X(65)" no-undo
     3186   initial "@(#)$Workfile$ $Revision$".
     3187   procedure grplib-get-full-name :
     3188      define input parameter p-node-code  as integer      no-undo.
     3189      define output parameter p-full-name as character    no-undo.
     3190      do
     3191   on error undo, return error
     3192   :
     3193       define variable v-upper-code    as integer           no-undo.
     3194       define buffer buf_gds-grp       for ub.gds-grp.
     3195       define buffer buf_upper_gds-grp for ub.gds-grp.
     3196       find first buf_gds-grp no-lock
     3197            where buf_gds-grp.node-code = p-node-code
     3198       no-error.
     3199       if not available buf_gds-grp
     3200       then do:
     3201           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3202       end.
     3203       assign
     3204           p-full-name  = ""
     3205           v-upper-code = 1
     3206       .
     3207       do while buf_gds-grp.upper-code <> 0
     3208       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3209       :
     3210           assign
     3211               p-full-name  = buf_gds-grp.node-name
     3212                            + (if p-full-name <> "" then chr(47) else "")
     3213                            + p-full-name
     3214               v-upper-code = buf_gds-grp.upper-code
     3215           .
     3216           find first buf_gds-grp no-lock
     3217                where buf_gds-grp.node-code = v-upper-code
     3218           no-error.
     3219           if not available buf_gds-grp
     3220           then do:
     3221               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3222                                   + string( v-upper-code )
     3223                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3224           end.
     3225       end.
     3226       assign
     3227       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3228       .
     3229   end.
     3230   end .
     3231   procedure grplib-get-node-from-full-name :
     3232   define input parameter p-full-name as character no-undo .
     3233   define output parameter p-node-code as integer no-undo .
     3234   define variable v-ii as integer no-undo .
     3235   define variable v-upper-code as integer no-undo .
     3236   define variable v-root-code as integer no-undo .
     3237   define variable v-entry as character no-undo .
     3238   define buffer buf_gds-grp       for ub.gds-grp.
     3239   do
     3240   on error undo, return error
     3241   :
     3242     find first buf_gds-grp no-lock
     3243         where buf_gds-grp.upper-code = 0
     3244     no-error .
     3245     if not available buf_gds-grp
     3246     then do:
     3247         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3248     end.
     3249     else do:
     3250       assign
     3251       v-root-code = buf_gds-grp.node-code
     3252       .
     3253     end.
     3254     v-upper-code = v-root-code.
     3255     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3256       assign
     3257       v-entry = entry(v-ii, p-full-name, chr(47)).
     3258       if v-entry = '' then leave.
     3259       find first buf_gds-grp no-lock where
     3260                 buf_gds-grp.node-name = v-entry
     3261             and buf_gds-grp.upper-code = v-upper-code
     3262             no-error.
     3263       if not available buf_gds-grp then do:
     3264         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3265       end.
     3266       else do:
     3267         p-node-code = buf_gds-grp.node-code.
     3268         v-upper-code = buf_gds-grp.node-code.
     3269       end.
     3270     end.
     3271   end.
     3272   end .
     3273   procedure  chec-par :
     3274   define output parameter l-par as logical no-undo .
     3275   define input parameter l-host like ub.clients.obj-code no-undo .
     3276   define input parameter l-type like ub.clients.obj-type no-undo .
     3277   define input parameter l-code like ub.clients.obj-code no-undo .
     3278   define variable par-type          as character no-undo.
     3279   define variable v-value-character as character no-undo .
     3280   define variable v-value-date      as date      no-undo .
     3281   define variable v-value-decimal   as decimal   no-undo .
     3282   define variable v-value-integer   as integer   no-undo .
     3283   define variable v-value-logical   as logical   no-undo .
     3284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
