      945     (input  p-obj-type
      946     ,input  p-obj-code
      947     ,output v-host-code
      948     ) no-error .
      949   if error-status :error
      950   then do:
      951       message
      952         vss-workfile vss-revision vss-description
      953         skip "Не удалось найти фирму объекта"
      954         skip p-obj-type p-obj-code
      955         skip return-value
      956         skip trim(error-status :get-message(1))
      957              trim(error-status :get-message(2))
      958              trim(error-status :get-message(3))
      959              trim(error-status :get-message(4))
      960              trim(error-status :get-message(5))
