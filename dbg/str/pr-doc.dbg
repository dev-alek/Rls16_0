     4685       with view-as dialog-box keep-tab-order
     4686            side-labels no-underline three-d  scrollable
     4687            title "Приказ переоценки".
     4688   assign
     4689     frame d-pr-doc:scrollable = false
     4690     br-list   :num-locked-columns in frame d-pr-doc = 5
     4691     b-chg     :popup-menu in frame d-pr-doc         = menu m-chg  :handle
     4692     b-chg     :menu-mouse                                = 1
     4693     b-del     :popup-menu in frame d-pr-doc         = menu m-del  :handle
     4694     b-del     :menu-mouse                                = 1
     4695     .
     4696   br-list :set-repositioned-row (5, "always").
     4697   run str/pr-listv.p
     4698       (input 'Товар,Учетная,Учет-объект,Учет-резерв,Приходная,Прих-объект,Старая,Новая,Объект,Накладная,Переоценка,Накл-безНДС,Учет-безНДС,Стар-безНДС,Единая,НсП,НсП+накл,Откат_цен,Отсутствует,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U ,
     4699        input 'Не-считать':U,
     4700        output p-list
     4701        ) .
     4702   calc-method:list-items in frame d-pr-doc  = p-list .
     4703   def var sort-labelbr-list   as character no-undo .
     4704   def var sort-clmnbr-list    as handle    no-undo .
     4705   def var cur-clmnbr-list     as handle    no-undo .
     4706   def var cur-clmn-locbr-list as integer   no-undo .
     4707   def var re-querybr-list     as logical   initial no no-undo .
     4708   on start-search, ctrl-o of br-list in frame d-pr-doc do:
     4709      run sort-brbr-list
     4710        (input (if available ub.price-list
     4711                then recid(ub.price-list)
     4712                else ?
     4713               )
     4714        ).
     4715   end.
     4716   PROCEDURE sort-brbr-list :
     4717     define input parameter p-recid as recid no-undo .
     4718     if re-querybr-list = no then do:
     4719       assign
     4720          cur-clmnbr-list = br-list:current-column in frame d-pr-doc
     4721       .
     4722       if sort-clmnbr-list <> ? then sort-clmnbr-list:column-fgcolor = 0.
     4723       if cur-clmnbr-list = sort-clmnbr-list then do:
     4724         assign
     4725            sort-labelbr-list = ""
     4726            sort-clmnbr-list = ?
     4727         .
     4728        end.
     4729        else do:
     4730          assign
     4731            sort-labelbr-list = cur-clmnbr-list:label
     4732            sort-clmnbr-list  = cur-clmnbr-list
     4733            sort-clmnbr-list:column-fgcolor = 4
     4734          .
     4735        end.
     4736      end.
     4737     assign
     4738       cur-clmn-locbr-list = 1
     4739     .
     4740     def var column-handle as handle no-undo .
     4741     column-handle = br-list:first-column.
     4742     do while valid-handle(column-handle) :
     4743       if column-handle = cur-clmnbr-list then do:
     4744         leave .
     4745       end.
     4746       column-handle = column-handle:NEXT-COLUMN.
     4747       assign
     4748         cur-clmn-locbr-list = cur-clmn-locbr-list + 1
     4749       .
     4750     end.
     4751     case sort-labelbr-list:
     4752           when 'Тип'  then DO:   assign     sort-clmn-name = "if ub.gds-prt.upper-code = ub.goods.prt-root then         if ub.bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by if ub.gds-prt.upper-code = ub.goods.prt-root then         if ub.bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U.   . END.
     4753           when 'Код'  then DO:   assign     sort-clmn-name = "ub.bar-code.b-code"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by ub.bar-code.b-code.   . END.
     4754           when 'Артикул'  then DO:   assign     sort-clmn-name = "ub.price-list.artic"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by ub.price-list.artic.   . END.
     4755           when 'Название'  then DO:   assign     sort-clmn-name = "if ub.gds-prt.upper-code = ub.goods.prt-root then         if ub.bar-code.in-code = '' then           ub.goods.gds-name         else            ub.bar-code.part-code  + '  ПН ' + ub.bar-code.in-code       else         '    ' + ub.gds-prt.f-name"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by if ub.gds-prt.upper-code = ub.goods.prt-root then         if ub.bar-code.in-code = '' then           ub.goods.gds-name         else            ub.bar-code.part-code  + '  ПН ' + ub.bar-code.in-code       else         '    ' + ub.gds-prt.f-name.   . END.
     4756           when 'Новая цена'  then DO:   assign     sort-clmn-name = "ub.price-list.price-sale"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by ub.price-list.price-sale.   . END.
     4757           when 'Старая'  then DO:   assign     sort-clmn-name = "fnc-old-price (buffer ub.price-list)"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by fnc-old-price (buffer ub.price-list).   . END.
     4758           when '%.'  then DO:   assign     sort-clmn-name = "fnc-old-pc  (buffer ub.price-list)"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by fnc-old-pc  (buffer ub.price-list).   . END.
     4759           when 'Исходная'  then DO:   assign     sort-clmn-name = "fnc-arg-price (buffer ub.price-list)"   .   open query br-list         for each ub.price-list no-lock where                  ub.price-list.doc-num = p-doc.doc-num and                  ub.price-list.price-type = '',             each ub.bar-code no-lock where                  ub.bar-code.b-code = ub.price-list.b-code,             each ub.goods no-lock where                  ub.goods.gds-code = ub.bar-code.gds-code and                  ub.goods.unit-base = ub.bar-code.unit-cli,             each ub.gds-prt no-lock where                  ub.gds-prt.node-code = ub.bar-code.node-code by fnc-arg-price (buffer ub.price-list).   . END.
