     4131   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4132   (  input  p-b-code
     4133    , input  p-obj-type
     4134    , input  p-obj-code
     4135    , output v-PriceWithoutVat
     4136    , output v-PriceWithVat
     4137    , output v-prod-vat
     4138    , output v-part-code
     4139    , output v-in-code
     4140           ) no-error .
     4141         if error-status :error then do:
     4142           return error "Нет цены производителя!".
     4143         end.
     4144   find first buf_bar-code no-lock where
     4145              buf_bar-code.b-code = p-b-code
     4146              no-error .
     4147   find first buf_goods no-lock where
     4148              buf_goods.gds-code = buf_bar-code.gds-code
     4149              no-error .
     4150   find first buf_parts no-lock where
     4151              buf_parts.artic      = buf_goods.artic        and
     4152              buf_parts.prod-type  = buf_goods.prod-type    and
     4153              buf_parts.prod-code  = buf_goods.prod-code    and
     4154              buf_parts.in-code    = buf_bar-code.in-code   and
     4155              buf_parts.out-code   = buf_bar-code.in-code   and
     4156              buf_parts.part-code  = buf_bar-code.part-code
     4157              no-error .
     4158               if error-status :error then do:
     4159                   find first buf_parts no-lock where
     4160                             buf_parts.artic      = buf_goods.artic        and
     4161                             buf_parts.prod-type  = buf_goods.prod-type    and
     4162                             buf_parts.prod-code  = buf_goods.prod-code    and
     4163                             buf_parts.in-code    = v-in-code              and
     4164                             buf_parts.out-code   = v-in-code              and
     4165                             buf_parts.part-code  = v-part-code
     4166                             no-error .
     4167                   if error-status :error then do:
     4168                      message
     4169                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     4170                                   v-in-code,
     4171                                   v-part-code ,
     4172                                   buf_goods.artic   ,
     4173                                   buf_goods.prod-type,
     4174                                   buf_goods.prod-code ) .
     4175                      return error "Нет цены производителя !!!".
     4176                   end.
     4177               end.
     4178   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     4179   define variable v-postWithoutVat-rubl as decimal   no-undo .
     4180   define variable v-postWithoutVat-base as decimal   no-undo .
     4181      case p-mode :
     4182       when 1 then do:
     4183          if p-rb = "rubl" then do:
     4184             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     4185          end.
     4186          else do:
     4187             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     4188          end.
     4189       end.
     4190       when 2 then do:
     4191         if p-rb = "rubl" then do:
     4192           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     4193           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     4194         end.
     4195         else do:
     4196           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     4197           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     4198         end.
     4199       end.
     4200      end case.
     4201   p-descript-calc =
     4202     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     4203     buf_goods.gds-name                  +  chr(10) +
     4204     buf_goods.artic +
     4205     buf_goods.prod-type +
     4206     string(buf_goods.prod-code)         + chr(10) +
     4207     "бар-код " +  string(p-b-code)      + chr(10)  +
     4208     'ПН    ' + v-in-code  +
     4209     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     4210     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     4211     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     4212     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     4213     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     4214     chr(10) +
     4215     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     4216     chr(10) +
     4217     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     4218     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     4219     chr(10) +
     4220     string(p-price-sale)                                                               +  chr(10) +
     4221     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     4222     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     4223   .
     4224     end.
     4225   end procedure.
