      932   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      933   define buffer buf_gds-grp for ub.gds-grp.
      934   find first buf_gds-grp no-lock where
      935              buf_gds-grp.node-code = p-node-code no-error .
      936   if not avail buf_gds-grp and p-node-code <> 0 then do:
      937     message
      938       vss-workfile vss-revision vss-description
      939       skip "Не удалось найти группу товаров с кодом" p-node-code
      940       view-as alert-box error .
      941     undo, return error .
      942   end.
