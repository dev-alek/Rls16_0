        1   block-level on error undo, throw.
        2   define input parameter parparentproc           as   widget-handle no-undo .
        3   define input parameter p-new-price-doc-status_ like ub.price-doc.status_ no-undo .
        4   define input parameter p-doc-num               like ub.price-doc.doc-num no-undo .
        5   define input parameter p-obj-type              like ub.price-doc.obj-type no-undo .
        6   define input parameter p-obj-code              like ub.price-doc.obj-code no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: pr-cash.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/pr-cash.p $":U .
       12   define variable vss-description as character no-undo init "Проверки и взаимодействие с кассой при закрытии переоценки".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2',p-new-price-doc-status_,p-doc-num)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable v-mes as character no-undo .
       86   define variable v-param-type as character no-undo .
       87   define variable v-value-character as character no-undo .
       88   define variable v-value-date as date no-undo .
       89   define variable v-value-decimal as decimal no-undo .
       90   define variable v-value-integer as INTEGER no-undo .
       91   define variable v-value-logical AS LOGICAL no-undo .
       92   define variable v-tth as handle no-undo .
       93   if p-obj-type <> 'маг':U then do:
       94     return .
       95   end.
       96   run adm/shattri.p (
       97        input "get":U
       98       ,input  p-obj-type
       99       ,input  p-obj-code
      100       ,input  'autosale':U
      101       ,input  'prcl-spl':U
      102       ,output v-value-character
      103       ,output v-value-date
      104       ,output v-value-decimal
      105       ,output v-value-integer
      106       ,output v-value-logical
      107       ,output v-param-type
      108       ,INPUT-OUTPUT table-handle v-tth
      109       ) no-error .
      110   if error-status:error then do:
      111     delete object v-tth.
      112     return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
      113   end.
      114   delete object v-tth.
      115   if v-value-logical <> yes then do:
      116     return.
      117   end.
      118   run str/diallog.w (  input parparentproc
      119                 , input this-procedure
      120                 , input ('str/get-chkf.p':U + chr(4) + string(0) + chr(4) + string(1) + chr(4) + string(1))
      121                 , input (p-obj-type + chr(4) + string(p-obj-code) + chr(4) + string(0))
      122                 , input yes
      123                 , input '':U
      124                 , input 'Прием чеков с касс') no-error .
      125   if error-status:error then return error.
      126   find ub.price-doc no-lock
      127     where ub.price-doc.doc-num = p-doc-num
      128     .
      129   define buffer buf_bar-code for ub.bar-code .
      130   for each ub.price-list no-lock
      131     where ub.price-list.doc-num = ub.price-doc.doc-num
      132   ,first buf_bar-code no-lock
      133     where buf_bar-code.b-code = ub.price-list.b-code
      134   :
      135      if not ub.price-list.main-price then NEXT.
      136     _chk-doc:
      137     FOR EACH ub.chk-doc No-lock
      138       where ub.chk-doc.obj-type = ub.price-list.obj-type
      139         AND ub.chk-doc.obj-code = ub.price-list.obj-code
      140         AND ub.chk-doc.out-code = ?,
      141             EACH  ub.chk-gds where
      142                   ub.chk-gds.doc-code = ub.chk-doc.doc-code,
      143             FIRST ub.bar-code where
      144                   ub.bar-code.b-code = ub.chk-gds.b-code no-lock :
      145       if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
      146       or lookup(string(ub.chk-doc.chk-type), '11,111,201,206':U) > 0
      147       then next _chk-doc.
      148       if ub.bar-code.gds-code = buf_bar-code.gds-code then do:
      149         assign
      150         v-mes = substitute("Найден неучтенный чек №  &1 от &2,&3"  +
      151                             "содержащий переоцениваемый товар: &4 бар-код: &5&3&3" +
      152                             "В соответствии с настройкой  <Значение цены в продаже брать из прайс-листа>&3" +
      153                             "требуется закрыть продажу с этим чеком до переоценки."
      154                             ,ub.chk-doc.doc-code
      155                             ,ub.chk-doc.chk-date
      156                             ,chr(10)
      157                             , substitute("&1 &2 &3"
      158                                         , ub.price-list.artic
      159                                         , ub.price-list.prod-type
      160                                         , ub.price-list.prod-code)
      161                             , ub.chk-gds.b-code ).
      162         if not g#auto then do:
      163           message v-mes
      164           view-as alert-box.
      165           return error .
      166         end.
      167         else do:
      168           return error v-mes.
      169         end.
      170       end.
      171     END.
      172     for each ub.inkas where ub.inkas.obj-type = p-obj-type and
      173                            ub.inkas.obj-code = p-obj-code and
      174                            ub.inkas.status_ = 'новый':U,
      175         EACH ub.chk-gds  NO-LOCK where
      176                ub.chk-gds.out-code = ub.inkas.inkas-code,
      177           FIRST ub.bar-code No-LOCK where
      178                 ub.bar-code.b-code = ub.chk-gds.b-code:
      179         IF ub.bar-code.gds-code = buf_bar-code.gds-code then do:
      180           find ub.chk-doc where ub.chk-doc.doc-code = ub.chk-gds.doc-code no-lock.
      181           v-mes = substitute("Найден чек № &1, входящий в продажу № &2,&3"  +
      182                              "содержащий переоцениваемый товар: &4 бар-код:&3&3" +
      183                              "В соответствии с настройкой  <Значение цены в продаже брать из прайс-листа>&3" +
      184                              "требуется закрыть продажу с этим чеком до переоценки."
      185                              ,ub.chk-doc.doc-code
      186                               ,ub.inkas.inkas-code
      187                               , chr(10)
      188                               ,substitute("&1 &2 &3"
      189                                           ,ub.price-list.artic
      190                                           ,ub.price-list.prod-type
      191                                           ,ub.price-list.prod-code)
      192                               ,ub.chk-gds.b-code).
      193           if not g#auto then do:
      194             message v-mes
      195             view-as alert-box .
      196             return error .
      197           end.
      198           else do:
      199             return error v-mes.
      200            end.
      201         end.
      202     end.
      203   end.
