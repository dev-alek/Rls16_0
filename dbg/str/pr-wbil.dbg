        1   block-level on error undo, throw.
        2   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   def var vss-author      as character no-undo init "$Author: expertek $":U .
        4   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   def var vss-workfile    as character no-undo init "$Workfile: pr-wbil.p $":U .
        6   def var vss-archive     as character no-undo init "$Archive: str/pr-wbil.p $":U .
        7   def var vss-description as character no-undo init "Методы расчета переоценки".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
       70   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
       71   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
       72   ASSIGN
       73      v-S_CONTRACT                = "Contract":U
       74      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
       75      v-DELIM_CHR_3               = ","
       76      .
       77   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
       78   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
       79   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       80   FUNCTION Can-Find-Spec RETURN LOGICAL (
       81      INPUT iHost-Code    AS INTEGER,
       82      INPUT iContract-Num AS INTEGER,
       83      INPUT iGds-Code     AS INTEGER ):
       84      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
       85      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
       86      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
       87      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
       88      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
       89      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
       90          INPUT  iHost-Code,
       91          INPUT  iContract-Num,
       92          OUTPUT iTmp-Extent3
       93          ).
       94      IF iTmp-Extent3[1] = 2 THEN DO:
       95         ASSIGN
       96            iTmp-Host-Code      = iTmp-Extent3[2]
       97            iTmp-Contract-Num   = iTmp-Extent3[3]
       98            .
       99      END. ELSE DO:
      100         ASSIGN
      101            iTmp-Host-Code      = iHost-Code
      102            iTmp-Contract-Num   = iContract-Num
      103            .
      104      END.
      105      IF iGds-Code = ? THEN DO:
      106         ASSIGN
      107            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      108                                  buf_Spec.Host-Code     = iTmp-Host-Code
      109                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      110                           ).
      111      END. ELSE DO:
      112            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      113                                  buf_Spec.Host-Code     = iTmp-Host-Code
      114                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      115                              AND buf_Spec.Gds-Code      = iGds-Code
      116                            ).
      117      END.
      118      RETURN (lRet).
      119   END FUNCTION.
      120   PROCEDURE MS-Contract-EXTENT-3:
      121      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      122      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      123      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      124      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      125      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      126      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      127      FIND FIRST buf_Cont-2 WHERE
      128                 buf_Cont-2.Host-Code      = i-Host-Code
      129             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      130           NO-LOCK NO-ERROR.
      131      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      132         RETURN.
      133      END.
      134      FOR FIRST buf_Ext-Classif WHERE
      135                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      136           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      137                                               STRING(i-Contract-code)
      138           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      139          NO-LOCK,
      140          EACH buf_Cont WHERE
      141               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      142           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      143          NO-LOCK:
      144          ASSIGN
      145             i-Ret[1] = 1
      146             i-Ret[2] = buf_Cont.Host-code
      147             i-Ret[3] = buf_Cont.Contract-code
      148             .
      149          LEAVE.
      150      END.
      151      IF i-Ret[1] <> 1 THEN DO:
      152         FOR FIRST buf_Ext-Classif WHERE
      153                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      154              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      155                                                  STRING(i-Contract-code)
      156              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      157             NO-LOCK,
      158             EACH buf_Cont WHERE
      159                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      160              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      161             NO-LOCK:
      162             ASSIGN
      163                i-Ret[1] = 2
      164                i-Ret[2] = buf_Cont.Host-code
      165                i-Ret[3] = buf_Cont.Contract-code
      166                .
      167             LEAVE.
      168         END.
      169      END.
      170      RETURN.
      171   END PROCEDURE.
      172   define input parameter  p-type          as character no-undo .
      173   define input parameter  p-met           as character no-undo .
      174   define input parameter  rec-id-trn-doc  as recid no-undo .
      175   define input parameter  rec-id-doc-line as recid no-undo .
      176   define input parameter  rec-id-gds-dtl  as recid no-undo .
      177   define input parameter  doc-code     as character no-undo .
      178   define input parameter  v-gds-name   as character no-undo .
      179   define input parameter  v-gds-code   as integer no-undo .
      180   define input parameter  v-artic      as character no-undo .
      181   define input parameter  v-prod-type  as character no-undo .
      182   define input parameter  v-prod-code  as integer no-undo .
      183   define input parameter  v-node-code  as integer no-undo .
      184   define input parameter  p-pc         as decimal no-undo .
      185   define input  parameter p-doc-price-rubl as decimal   no-undo .
      186   define input  parameter p-doc-price-base as decimal   no-undo .
      187   define output parameter v-price-calc as decimal no-undo .
      188   define output parameter v-price-sale as decimal no-undo .
      189   define variable var-pr-r-b as character no-undo .
      190   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      192     (output var-pr-r-b
      193     )  .
      194   define variable g#log as logical   no-undo .
      195   find first trn-doc no-lock where recid(trn-doc) = rec-id-trn-doc no-error .
      196   if p-met = 'НсП+накл':U then do:
      197   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      199     (input  v-gds-code
      200     ,input  '2':U
      201     ,input  ?
      202     ,input  trn-doc.host-code
      203     ,input  trn-doc.obj-type
      204     ,input  trn-doc.obj-code
      205     ,output p-pc
      206     ) no-error .
      207   end.
      208    if p-type = "pr-doc" then do:
      209         if available trn-doc then do:
      210           if trn-doc.doc-type = 'при':U and
      211            ( trn-doc.ext-doc-type = 'ie':U  ) then do:
      212             find doc-line where doc-line.doc-code = doc-code
      213                             and doc-line.artic     = v-artic
      214                             and doc-line.prod-type = v-prod-type
      215                             and doc-line.prod-code = v-prod-code no-lock no-error.
      216                   if available doc-line then
      217                     assign
      218                       v-price-calc =  if var-pr-r-b = "rubl"  then doc-line.price-rubl else doc-line.price-base
      219                       v-price-sale =  v-price-calc * (1 + p-pc / 100)
      220                       .
      221                   else
      222                     message "Нет строки в накладной :" doc-code "для товара :" v-artic  v-gds-name
      223                             "- расчет невозможен."
      224                             view-as alert-box question buttons OK-Cancel update g#log.
      225           end.
      226           else do:
      227             find gds-dtl where gds-dtl.doc-code  = doc-code
      228                            and gds-dtl.artic     =  v-artic
      229                            and gds-dtl.prod-type =  v-prod-type
      230                            and gds-dtl.prod-code =  v-prod-code
      231                            and gds-dtl.prt-code  =  v-node-code no-lock no-error.
      232             if not available gds-dtl then
      233               find first gds-dtl where gds-dtl.doc-code = doc-code
      234                                    and gds-dtl.artic =  v-artic
      235                                    and gds-dtl.prod-type =  v-prod-type
      236                                    and gds-dtl.prod-code =  v-prod-code no-lock no-error.
      237             if available gds-dtl then
      238               assign
      239                  v-price-calc = if var-pr-r-b = "rubl"  then gds-dtl.price-rubl else gds-dtl.price-base
      240                  v-price-sale = v-price-calc * (1 + p-pc / 100)
      241                 .
      242             else
      243               message "Нет строки в накладной :" doc-code "для товара :" v-artic v-gds-name
      244                       "- расчет невозможен."
      245                       view-as alert-box question buttons OK-Cancel update g#log.
      246           end.
      247         end.
      248         else
      249           message "Не прочитана накладная с номером" doc-code
      250                   "- расчет невозможен."
      251                   view-as alert-box question buttons OK-Cancel update g#log.
      252    end.
      253    else do:
      254    define variable v-bonus as decimal   no-undo .
      255    v-bonus = 0.0 .
      256    define buffer buf_contract-specif-attr for ub.contract-specif-attr  .
      257    define buffer buf_goods for ub.goods  .
      258   find first buf_goods no-lock where
      259              buf_goods.artic  =  v-artic and
      260              buf_goods.prod-type =  v-prod-type and
      261              buf_goods.prod-code =  v-prod-code no-error .
      262   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   ASSIGN
      264      i-gl-Host-Code      = 0
      265      i-gl-Contract-Code  = 0
      266      i-gl-Extent3        = 0
      267      .
      268   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      269       INPUT  trn-doc.host-code,
      270       INPUT  trn-doc.contract-code,
      271       OUTPUT i-gl-Extent3
      272      ).
      273   IF i-gl-Extent3[1] = 2 THEN DO:
      274      ASSIGN
      275         i-gl-Host-Code      = i-gl-Extent3[2]
      276         i-gl-Contract-Code  = i-gl-Extent3[3]
      277         .
      278   END. ELSE DO:
      279      ASSIGN
      280         i-gl-Host-Code      = trn-doc.host-code
      281         i-gl-Contract-Code  = trn-doc.contract-code
      282         .
      283   END.
      284       FIND FIRST buf_contract-specif-attr
      285              NO-LOCK
      286              WHERE
      287                  buf_contract-specif-attr.Host-code    = i-gl-Host-Code
      288              AND buf_contract-specif-attr.Contract-num = i-gl-Contract-Code
      289              AND buf_contract-specif-attr.Gds-code     = buf_goods.gds-code
      290              AND buf_contract-specif-attr.Attr-code    = 'bonus':U
      291              NO-ERROR
      292              .
      293       if available buf_contract-specif-attr
      294          then v-bonus = decimal (buf_contract-specif-attr.attr-value) .
      295          else v-bonus = 0.0 .
      296         if trn-doc.doc-type = 'при':U and
      297            ( trn-doc.ext-doc-type = 'ie':U   ) then do:
      298           find first doc-line no-lock where recid(doc-line) = rec-id-doc-line no-error .
      299           if available doc-line    then
      300               assign
      301                 v-price-calc =  if var-pr-r-b = "rubl"  then doc-line.price-rubl else doc-line.price-base
      302                 v-price-sale = v-price-calc * (1 + v-bonus / 100) * (1 + p-pc / 100)
      303                 .
      304               else
      305               assign
      306                 v-price-calc =  if var-pr-r-b = "rubl"  then p-doc-price-rubl else p-doc-price-base
      307                 v-price-sale = v-price-calc * (1 + v-bonus / 100) * (1 + p-pc / 100)
      308                 .
      309         end.
      310         else do:
      311             find first gds-dtl no-lock where recid(gds-dtl) = rec-id-gds-dtl no-error .
      312             if available gds-dtl then
      313               assign
      314                 v-price-calc =  if var-pr-r-b = "rubl"  then gds-dtl.price-rubl else gds-dtl.price-base
      315                 v-price-sale = v-price-calc * (1 + v-bonus / 100) * (1 + p-pc / 100)
      316                 .
      317               else
      318               assign
      319                 v-price-calc =  if var-pr-r-b = "rubl"  then p-doc-price-rubl else p-doc-price-base
      320                 v-price-sale = v-price-calc * (1 + v-bonus / 100) * (1 + p-pc / 100)
      321                 .
      322        end.
      323    end.
