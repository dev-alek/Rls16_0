      438   procedure fbrglib-get-sort-name :
      439   do
      440   on error undo, return error
      441   :
      442   define input parameter p-obj-type   as character    no-undo.
      443   define input parameter p-obj-code   as integer      no-undo.
      444   define input parameter p-node-code  as integer      no-undo.
      445   define output parameter p-sort-name as character    no-undo.
      446       define variable v-upper-code    as integer           no-undo.
      447       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      448       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      449       find first buf_fbr-gds-grp no-lock
      450            where buf_fbr-gds-grp.obj-type  = p-obj-type
      451              and buf_fbr-gds-grp.obj-code  = p-obj-code
      452              and buf_fbr-gds-grp.node-code = p-node-code
      453       no-error.
      454       if not available buf_fbr-gds-grp
      455       then do:
      456           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      457       end.
      458       assign
      459           p-sort-name  = ""
      460           v-upper-code = 1
      461       .
      462       do while true
      463       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      464       :
      465           assign
      466               p-sort-name  = buf_fbr-gds-grp.node-name
      467                            + (if p-sort-name <> "" then chr(2) else "")
      468                            + p-sort-name
      469               v-upper-code = buf_fbr-gds-grp.upper-code
      470           .
      471           if buf_fbr-gds-grp.upper-code = 1
      472           then do:
      473               leave.
      474           end.
      475           find first buf_fbr-gds-grp no-lock
      476                where buf_fbr-gds-grp.obj-type  = p-obj-type
      477                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      478                  and buf_fbr-gds-grp.node-code = v-upper-code
      479           no-error.
      480           if not available buf_fbr-gds-grp
      481           then do:
      482               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      483                                   + string( v-upper-code )
      484                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      485           end.
      486       end.
      487   end.
      488   end procedure.
      489   procedure fbrglib-get-full-name :
      490   do
      491   on error undo, return error
      492   :
      493   define input parameter p-obj-type   as character    no-undo.
      494   define input parameter p-obj-code   as integer      no-undo.
      495   define input parameter p-node-code  as integer      no-undo.
      496   define output parameter p-full-name as character    no-undo.
      497       define variable v-upper-code    as integer           no-undo.
      498       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      499       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      500       if p-node-code = 1
      501       then do:
      502           assign
      503               p-full-name = ""
      504           .
      505       end.
      506       else do:
      507           find first buf_fbr-gds-grp no-lock
      508                where buf_fbr-gds-grp.obj-type  = p-obj-type
      509                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      510                  and buf_fbr-gds-grp.node-code = p-node-code
      511           no-error.
      512           if not available buf_fbr-gds-grp
      513           then do:
      514               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      515           end.
      516           assign
      517               p-full-name  = ""
      518               v-upper-code = 1
      519           .
      520           do while true
      521           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      522           :
      523               assign
      524                   p-full-name  = buf_fbr-gds-grp.node-name
      525                               + (if p-full-name <> "" then chr(47) else "")
      526                               + p-full-name
      527                   v-upper-code = buf_fbr-gds-grp.upper-code
      528               .
      529               if buf_fbr-gds-grp.upper-code = 1
      530               then do:
      531                   leave.
      532               end.
      533               find first buf_fbr-gds-grp no-lock
      534                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      535                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      536                      and buf_fbr-gds-grp.node-code = v-upper-code
      537               no-error.
      538               if not available buf_fbr-gds-grp
      539               then do:
      540                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      541                                       + string( v-upper-code )
      542                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      543               end.
      544           end.
      545           assign
      546               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      547           .
      548       end.
      549   end.
      550   end procedure.
      551   procedure fbrglib-get-root-code :
      552   do
      553   on error undo, return error
      554   :
      555   define output parameter p-root-code as integer      no-undo.
      556       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      557       find first buf_fbr-gds-grp no-lock
      558            where buf_fbr-gds-grp.upper-code = 0
      559       no-error .
      560       if not available buf_fbr-gds-grp
      561       then do:
      562           undo, return error .
      563       end.
      564       else do:
      565           assign
      566               p-root-code = buf_fbr-gds-grp.node-code
      567           .
      568       end.
      569   end.
      570   end procedure.
      571   procedure fbrglib-find-grp-by-full-name :
      572   do
      573   on error undo, return error
      574   :
      575   define input parameter p-obj-type     as character    no-undo.
      576   define input parameter p-obj-code     as integer      no-undo.
      577   define input parameter p-search-name  as character    no-undo.
      578   define input parameter p-fill-path    as logical      no-undo.
      579       define variable v-upper-code    as integer          no-undo.
      580       define variable v-not-found     as logical init yes no-undo.
      581       define variable v-counter       as integer           no-undo.
      582       define variable v-level         as integer           no-undo.
      583       define variable v-full-name     as character         no-undo.
      584       define variable v-sort-name     as character         no-undo.
      585       define variable v-node-name     as character      no-undo.
      586       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      587       assign
      588           p-search-name = replace( p-search-name, chr(47), chr(2) )
      589       .
      590       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      591       if error-status :error
      592       then do:
      593           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      594       end.
      595       assign
      596           v-full-name  = ""
      597           v-level      = num-entries( p-search-name, chr(2) )
      598       .
      599       for each temp_fbrglib_found-grp
      600       :
      601           delete temp_fbrglib_found-grp.
      602       end.
      603       start-name-analyze:
      604       do v-counter = 1 to v-level
      605       :
      606           if v-counter < v-level
      607           then do:
      608               assign
      609                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      610               .
      611               find first buf_fbr-gds-grp no-lock
      612                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      613                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      614                      and buf_fbr-gds-grp.upper-code = v-upper-code
      615                      and buf_fbr-gds-grp.node-name  = v-node-name
      616               no-error .
      617               if not available buf_fbr-gds-grp
      618               then do:
      619                   assign
      620                       v-full-name  = p-search-name
      621                       v-sort-name  = p-search-name
      622                   .
      623                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      624               end.
      625               else do:
      626                   assign
      627                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      628                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      629                       v-upper-code = buf_fbr-gds-grp.node-code
      630                   .
      631                   if p-fill-path = yes
      632                   then do:
      633                       create temp_fbrglib_found-grp.
      634                       assign
      635                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      636                           temp_fbrglib_found-grp.sort-name = v-sort-name
      637                           temp_fbrglib_found-grp.node-code = v-upper-code
      638                           temp_fbrglib_found-grp.level     = v-counter
      639                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      640                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      641                       .
      642                   end.
      643               end.
      644           end.
      645           else do:
      646               for each buf_fbr-gds-grp no-lock
      647                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      648                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      649                    and buf_fbr-gds-grp.upper-code = v-upper-code
      650                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      651               :
      652                   assign
      653                       v-not-found = no
      654                   .
      655                   create temp_fbrglib_found-grp.
      656                   assign
      657                       temp_fbrglib_found-grp.full-name = v-full-name
      658                                                           + (if v-full-name = "" then "" else chr(47) )
      659                                                           + buf_fbr-gds-grp.node-name + chr(47)
      660                       temp_fbrglib_found-grp.sort-name = v-sort-name
      661                                                           + ( if v-sort-name = "" then "" else chr(2) )
      662                                                           + buf_fbr-gds-grp.node-name
      663                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      664                       temp_fbrglib_found-grp.level     = v-level
      665                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      666                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      667                   .
      668               end.
      669               if v-not-found = yes
      670               then do:
      671                   assign
      672                       v-full-name  = p-search-name
      673                       v-sort-name  = p-search-name
      674                   .
      675                   for each temp_fbrglib_found-grp
      676                   :
      677                       delete temp_fbrglib_found-grp.
      678                   end.
      679                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      680               end.
      681           end.
      682       end.
      683   end.
      684   end procedure.
      685   procedure fbrglib-find-all-subgroup :
      686   do
      687   on error undo, return error
      688   :
      689   define input parameter p-start-obj-type     as character    no-undo.
      690   define input parameter p-start-obj-code     as integer      no-undo.
      691   define input parameter p-start-node-code    as integer      no-undo.
      692   define input parameter p-terminal-only      as logical      no-undo.
      693       define variable v-start-full-name   as character     no-undo.
      694       define variable v-start-sort-name   as character     no-undo.
      695       define variable v-not-found         as logical       no-undo.
      696       define variable v-is-terminal       as logical       no-undo.
      697       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      698       create temp_found-result-nodelist.
      699       assign
      700           temp_found-result-nodelist.node-code = p-start-node-code
      701           temp_found-result-nodelist.processed = no
      702       .
      703       run fbrglib-get-full-name in this-procedure (
      704             input p-start-obj-type
      705           , input p-start-obj-code
      706           , input p-start-node-code
      707           , output v-start-full-name
      708       ).
      709       run fbrglib-get-full-name in this-procedure (
      710             input p-start-obj-type
      711           , input p-start-obj-code
      712           , input p-start-node-code
      713           , output v-start-sort-name
      714       ).
      715       process-nodes:
      716       do while yes
      717       :
      718           find first temp_found-result-nodelist
      719                where temp_found-result-nodelist.node-code = p-start-node-code
      720           .
      721           assign
      722               temp_found-result-nodelist.processed = yes
      723           .
      724           for each buf_fbr-gds-grp no-lock
      725              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      726                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      727                and buf_fbr-gds-grp.upper-code = p-start-node-code
      728           on error undo, return error
      729           :
      730               run fbrglib-is-terminal in this-procedure (
      731                     input buf_fbr-gds-grp.obj-type
      732                   , input buf_fbr-gds-grp.obj-code
      733                   , input buf_fbr-gds-grp.node-code
      734                   , output v-is-terminal
      735               ).
      736               if v-is-terminal = yes
      737               then do:
      738                   create temp_fbrglib_found-grp.
      739                   assign
      740                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      741                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      742                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      743                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      744                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      745                       temp_fbrglib_found-grp.is-terminal = yes
      746                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      747                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      748                   .
      749               end.
      750               else do:
      751                   create temp_found-result-nodelist.
      752                   assign
      753                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      754                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      755                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      756                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      757                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      758                       temp_found-result-nodelist.processed = no
      759                   .
      760                   if p-terminal-only = no
      761                   then do:
      762                       create temp_fbrglib_found-grp.
      763                       assign
      764                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      765                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      766                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      767                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      768                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      769                           temp_fbrglib_found-grp.is-terminal = no
      770                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      771                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      772                       .
      773                   end.
      774               end.
      775           end.
      776           find first temp_found-result-nodelist
      777                where temp_found-result-nodelist.processed = no
      778           no-error.
      779           if not available temp_found-result-nodelist
      780           then do:
      781               leave process-nodes.
      782           end.
      783           else do:
      784               assign
      785                   p-start-node-code = temp_found-result-nodelist.node-code
      786                   v-start-full-name = temp_found-result-nodelist.full-name
      787                   v-start-sort-name = temp_found-result-nodelist.sort-name
      788               .
      789           end.
      790       end.
      791   end.
      792   end procedure.
      793   procedure fbrglib-expand-name :
      794   do
      795   on error undo, return error
      796   :
      797   define input parameter p-obj-type   as character    no-undo.
      798   define input parameter p-obj-code   as integer      no-undo.
      799   define input parameter p-start-name as character    no-undo.
      800   define output parameter p-end-name  as character    no-undo.
      801       define variable v-is-terminal     as logical           no-undo.
      802       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      803       run fbrglib-find-grp-by-full-name in this-procedure (
      804             input p-obj-type
      805           , input p-obj-code
      806           , input p-start-name
      807           , input no
      808       ) no-error.
      809       run fbrglib-get-max-substring in this-procedure (
      810              input p-obj-type
      811           ,  input p-obj-code
      812           ,  input length( p-start-name )
      813           , output p-end-name
      814       ) no-error .
      815       if error-status :error
      816       then do:
      817           assign
      818               p-end-name = ""
      819           .
      820       end.
      821       else do:
      822           find first temp_fbrglib_found-grp
      823                where temp_fbrglib_found-grp.full-name = p-end-name
      824                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      825                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      826                        no-error.
      827           if available temp_fbrglib_found-grp
      828           then do:
      829               find first buf_temp_fbrglib_found-grp
      830                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      831                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      832                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      833                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      834               no-error.
      835               if not available buf_temp_fbrglib_found-grp
      836               then do:
      837                   run fbrglib-is-terminal in this-procedure (
      838                         input p-obj-type
      839                       , input p-obj-code
      840                       , input temp_fbrglib_found-grp.node-code
      841                       , output v-is-terminal
      842                   ).
      843               end.
      844           end.
      845       end.
      846   end.
      847   end procedure.
      848   procedure fbrglib-get-max-substring :
      849   do
      850   on error undo, return error
      851   :
      852   define input parameter p-obj-type as character no-undo .
      853   define input parameter p-obj-code as integer no-undo .
      854   define input parameter p-min-substring-length   as integer      no-undo.
      855   define output parameter p-substring             as character    no-undo.
      856           define variable v-char-counter  as integer           no-undo.
      857           define variable v-current-char  as character         no-undo.
      858           define variable v-names-counter  as integer           no-undo.
      859           define variable v-base-string   as character         no-undo.
      860           assign
      861               v-char-counter  = p-min-substring-length
      862           .
      863           find first temp_fbrglib_found-grp  where
      864                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      865                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      866           no-error.
      867           if not available temp_fbrglib_found-grp
      868           then do:
      869               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      870           end.
      871           else do:
      872               assign
      873                   v-base-string = temp_fbrglib_found-grp.full-name
      874               .
      875               counter-block:
      876               do while yes
      877               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      878               :
      879                   assign
      880                       v-char-counter  = v-char-counter + 1
      881                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      882                       v-names-counter = 0
      883                   .
      884                   compare-block:
      885                   for each temp_fbrglib_found-grp
      886                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      887                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      888                   :
      889                       assign
      890                           v-names-counter = v-names-counter + 1
      891                       .
      892                       if v-names-counter = 1
      893                       then do:
      894                           next compare-block.
      895                       end.
      896                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      897                       then do:
      898                           leave counter-block.
      899                       end.
      900                   end.
      901                   if v-names-counter = 1
      902                   then do:
      903                       assign
      904                           p-substring = v-base-string
      905                       .
      906                       return.
      907                   end.
      908               end.
      909               assign
      910                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      911               .
      912           end.
      913   end.
      914   end procedure.
      915   procedure fbrglib-is-terminal :
      916   do
      917   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      918   :
      919   define input parameter p-obj-type       as character    no-undo.
      920   define input parameter p-obj-code       as integer      no-undo.
      921   define input parameter p-node-code      as integer      no-undo.
      922   define output parameter p-is-terminal   as logical      no-undo.
      923       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      924       find first buf_fbr-gds-grp no-lock
      925            where buf_fbr-gds-grp.obj-type   = p-obj-type
      926              and buf_fbr-gds-grp.obj-code   = p-obj-code
      927              and buf_fbr-gds-grp.upper-code = p-node-code
      928       no-error .
      929       if not available buf_fbr-gds-grp
      930       then do:
      931           assign
      932               p-is-terminal = yes
      933           .
      934       end.
      935       else do:
      936           assign
      937               p-is-terminal = no
      938           .
      939       end.
      940   end.
      941   end procedure.
      942   procedure fbrglib-have-goods :
      943   do
      944   on error undo, return error
      945   :
      946   define input parameter p-obj-type           as character    no-undo.
      947   define input parameter p-obj-code           as integer      no-undo.
      948   define input parameter p-node-code          as integer      no-undo.
      949   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      950       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      951       find first buf_fbr-gds-obj no-lock
      952            where buf_fbr-gds-obj.obj-type     = p-obj-type
      953              and buf_fbr-gds-obj.obj-code     = p-obj-code
      954              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      955       no-error .
      956       if available buf_fbr-gds-obj
      957       then do:
      958           assign
      959               p-have-fbr-gds-obj = yes
      960           .
      961       end.
      962       else do:
      963           assign
      964               p-have-fbr-gds-obj = no
      965           .
      966       end.
      967   end.
      968   end procedure.
      969   procedure fbrglib-find-by-substring :
      970   do
      971   on error undo, return error
      972   :
      973   define input parameter p-start-obj-type     as character    no-undo.
      974   define input parameter p-start-obj-code     as integer      no-undo.
      975   define input parameter p-start-code         as integer      no-undo.
      976   define input parameter p-full-search-string as character    no-undo.
      977   define output parameter p-found-code        as integer      no-undo.
      978   define output parameter p-full-name         as character    no-undo.
      979       define variable v-start-code     as integer           no-undo.
      980       define variable v-found          as logical  init no  no-undo.
      981       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      982       search-grp:
      983       for each buf_fbr-gds-grp no-lock
      984           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
      985             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
      986             and buf_fbr-gds-grp.node-code > p-start-code
      987       :
      988           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
      989           then do:
      990               assign
      991                   p-found-code = buf_fbr-gds-grp.node-code
      992                   v-found      = yes
      993               .
      994               run fbrglib-get-full-name in this-procedure (
      995                     input p-start-obj-type
      996                   , input p-start-obj-code
      997                   , input p-found-code
      998                   , output p-full-name
      999               ) no-error .
     1000               if error-status :error
     1001               then do:
     1002                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1003               end.
     1004               leave search-grp.
     1005           end.
     1006       end.
     1007       if v-found = yes
     1008       then do:
     1009       end.
     1010       else do:
     1011           assign
     1012               p-full-name  = ""
     1013               p-found-code = 0
     1014           .
     1015       end.
     1016   end.
     1017   end procedure.
     1018   procedure fbrglib-analyze-grp-name :
     1019   do
     1020   on error undo, return error
     1021   :
     1022   define input parameter p-grp-name       as character            no-undo.
     1023   define input parameter p-obj-type       as character            no-undo.
     1024   define input parameter p-obj-code       as integer              no-undo.
     1025   define input parameter p-upper-code     as integer              no-undo.
     1026   define output parameter p-error-message as character init ""    no-undo.
     1027       define variable v-char-list     as character    no-undo.
     1028       define variable v-char-counter  as integer      no-undo.
     1029       define variable v-full-name     as character    no-undo.
     1030       if p-grp-name = "" then do:
     1031           assign
     1032               p-error-message = "Название группы не может быть пустым.".
     1033           .
     1034       end.
     1035       else do:
     1036           assign
     1037               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1038           .
     1039           do v-char-counter = 1 to num-entries( v-char-list )
     1040           :
     1041               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1042               then do:
     1043                   assign
     1044                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1045                   .
     1046                   return.
     1047               end.
     1048           end.
     1049           run fbrglib-get-full-name in this-procedure (
     1050                 input p-obj-type
     1051               , input p-obj-code
     1052               , input p-upper-code
     1053               , output v-full-name
     1054           ) no-error .
     1055           if error-status :error
     1056           then do:
     1057               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1058           end.
     1059           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1060           then do:
     1061               assign
     1062                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1063               .
     1064           end.
     1065       end.
     1066   end.
     1067   end procedure.
     1068   procedure fbrglib-delete-grp :
     1069   do
     1070   on error undo, return error
     1071   :
     1072   define input parameter p-obj-type   as character    no-undo.
     1073   define input parameter p-obj-code   as integer      no-undo.
     1074   define input parameter p-node-code  as integer      no-undo.
     1075   define output parameter p-deleted   as logical      no-undo.
     1076       define variable v-have-goods    as logical        no-undo.
     1077       define variable v-yesno         as logical        no-undo.
     1078       define variable v-upper-code    as integer        no-undo.
     1079       define variable v-root-code     as integer        no-undo.
     1080       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1081       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1082       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1083       run fbrglib-get-root-code in this-procedure (
     1084           output v-root-code
     1085       ) no-error.
     1086       if error-status :error
     1087       then do:
     1088           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1089       end.
     1090       if p-node-code = v-root-code
     1091       then do:
     1092           message
     1093               "Корневую группу удалить невозможно."
     1094           view-as alert-box error.
     1095           assign
     1096               p-deleted = no
     1097           .
     1098           undo, return.
     1099       end.
     1100       find first buf_fbr-gds-grp no-lock
     1101            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1102              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1103              and buf_fbr-gds-grp.upper-code   = p-node-code
     1104       no-error.
     1105       if available buf_fbr-gds-grp
     1106       then do:
     1107           message
     1108               "Не терминальную группу удалить невозможно."
     1109           view-as alert-box error.
     1110           assign
     1111               p-deleted = no
     1112           .
     1113           undo, return.
     1114       end.
     1115       find first buf_fbr-gds-grp no-lock
     1116            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1117              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1118              and buf_fbr-gds-grp.node-code    = p-node-code
     1119       .
     1120       assign
     1121           v-upper-code = buf_fbr-gds-grp.upper-code
     1122       .
     1123       run fbrglib-have-goods in this-procedure (
     1124             input p-obj-type
     1125           , input p-obj-code
     1126           , input p-node-code
     1127           , output v-have-goods
     1128       ).
     1129       if v-have-goods = yes
     1130       then do:
     1131           find first buf_second_fbr-gds-grp no-lock
     1132                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1133                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1134                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1135                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1136           no-error.
     1137           if available buf_second_fbr-gds-grp
     1138           then do:
     1139               message
     1140                   "В группе есть товары,"
     1141                   skip "которые нельзя перенести в родительскую группу,"
     1142                   skip "потому что у родительской группы есть еще одна подгруппа."
     1143                   skip(1)
     1144                   skip "Перенесите товары в другую группу"
     1145                   skip "или удалите все остальные подгруппы родительской группы."
     1146               view-as alert-box error.
     1147               assign
     1148                   p-deleted = no
     1149               .
     1150               undo, return.
     1151           end.
     1152           message
     1153               "В группе есть товары."
     1154               skip "После удаления группы"
     1155               skip "все ее товары будут привязаны"
     1156               skip "к ее родительской группе."
     1157               skip(1)
     1158               skip "Удалить группу?"
     1159           view-as alert-box warning
     1160           buttons yes-no
     1161           title "Удаление группы"
     1162           update v-yesno
     1163           .
     1164           if v-yesno = yes
     1165           then do:
     1166               do transaction
     1167               on error undo, return error
     1168               :
     1169                   for each buf_fbr-gds-obj exclusive-lock
     1170                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1171                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1172                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1173                   on error undo, return error
     1174                   :
     1175                       assign
     1176                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1177                       .
     1178                   end.
     1179               end.
     1180               do transaction
     1181               on error undo, return error
     1182               :
     1183                   find current buf_fbr-gds-grp exclusive-lock .
     1184                   delete buf_fbr-gds-grp no-error .
     1185                   if error-status:error then do:
     1186                     undo, return error return-value .
     1187                   end.
     1188               end.
     1189           end.
     1190       end.
     1191       else do:
     1192           message
     1193               "Имя группы: " buf_fbr-gds-grp.node-name
     1194               "Код группы: " buf_fbr-gds-grp.node-code
     1195               skip(1)
     1196               skip "Удалить группу?"
     1197           view-as alert-box warning
     1198           buttons yes-no
     1199           title "Удаление группы"
     1200           update v-yesno
     1201           .
     1202           if v-yesno = yes
     1203           then do:
     1204               do transaction
     1205               on error undo, return error
     1206               :
     1207                   find current buf_fbr-gds-grp exclusive-lock .
     1208                   delete buf_fbr-gds-grp no-error.
     1209                   if error-status:error then do:
     1210                     undo, return error return-value .
     1211                   end.
     1212               end.
     1213           end.
     1214       end.
     1215   end.
     1216   end procedure.
     1217   procedure fbrglib-add-grp :
     1218   do
     1219   on error undo, return error
     1220   :
     1221   define input parameter p-obj-type       as character    no-undo.
     1222   define input parameter p-obj-code       as integer      no-undo.
     1223   define input parameter p-node-code      as integer      no-undo.
     1224   define input parameter p-interface      as logical      no-undo.
     1225   define input parameter p-node-name      as character    no-undo.
     1226   define input parameter p-out-code       as integer      no-undo.
     1227   define input parameter p-global-code    as integer      no-undo.
     1228   define output parameter p-new-node-code as integer      no-undo.
     1229   define output parameter p-cancel        as logical      no-undo.
     1230       define variable v-have-goods    as logical  no-undo.
     1231       define variable v-host-code     as integer        no-undo.
     1232       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1233       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1234       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1235       run fbrglib-have-goods in this-procedure (
     1236             input p-obj-type
     1237           , input p-obj-code
     1238           , input p-node-code
     1239           , output v-have-goods
     1240       ) no-error .
     1241       if error-status :error
     1242       then do:
     1243           message
     1244                    vss-workfile vss-revision vss-description
     1245               skip "Ошибка определения наличия товаров в группе."
     1246               skip return-value
     1247               skip trim(error-status :get-message(1))
     1248                    trim(error-status :get-message(2))
     1249                    trim(error-status :get-message(3))
     1250           view-as alert-box error.
     1251           undo, return error .
     1252       end.
     1253   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1255     (input  p-obj-type
     1256     ,input  p-obj-code
     1257     ,output v-host-code
     1258     )  .
     1259       find first buf_fbr-gds-grp no-lock where
     1260                 buf_fbr-gds-grp.upper-code = p-node-code
     1261             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1262             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1263             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1264       if available buf_fbr-gds-grp then do:
     1265           if p-node-code <> 1 then do:
     1266             find first buf_fbr-gds-grp no-lock where
     1267                       buf_fbr-gds-grp.node-code = p-node-code
     1268                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1269                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1270           end.
     1271                   message
     1272           "Для объекта" p-obj-type p-obj-code
     1273           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1274           view-as alert-box error .
     1275           undo, return error .
     1276       end.
     1277       do transaction
     1278       on error undo, return error
     1279       :
     1280           create buf_fbr-gds-grp.
     1281           assign
     1282               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1283               p-new-node-code             = buf_fbr-gds-grp.node-code
     1284               buf_fbr-gds-grp.upper-code  = p-node-code
     1285               buf_fbr-gds-grp.host-code   = v-host-code
     1286               buf_fbr-gds-grp.obj-type    = p-obj-type
     1287               buf_fbr-gds-grp.obj-code    = p-obj-code
     1288               buf_fbr-gds-grp.node-name    = ""
     1289               buf_fbr-gds-grp.out-code    = 0
     1290           .
     1291           if p-interface then do:
     1292             run ref/fbrggrpd.w (
     1293                   input parparentproc
     1294                 , input 'ИЗМЕНЕНИЕ':U
     1295                 , input p-obj-type
     1296                 , input p-obj-code
     1297                 , input buf_fbr-gds-grp.node-code
     1298                 , input buf_fbr-gds-grp.upper-code
     1299                 , input buf_fbr-gds-grp.node-name
     1300                 , input buf_fbr-gds-grp.out-code
     1301                 , output buf_fbr-gds-grp.node-name
     1302                 , output buf_fbr-gds-grp.out-code
     1303                 , output p-cancel
     1304             ).
     1305             if p-cancel = yes
     1306             then do:
     1307                 delete buf_fbr-gds-grp.
     1308                 undo, return.
     1309             end.
     1310           end.
     1311           else do:
     1312             find first bf_fbr-gds-grp no-lock
     1313                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1314                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1315                   and bf_fbr-gds-grp.out-code   = p-out-code
     1316             no-error.
     1317             assign
     1318             buf_fbr-gds-grp.node-name    = p-node-name
     1319             buf_fbr-gds-grp.global-code  = p-global-code
     1320             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1321             .
     1322           end.
     1323           if v-have-goods = yes
     1324           then do:
     1325               for each buf_fbr-gds-obj exclusive-lock
     1326                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1327                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1328                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1329               on error undo, return error
     1330               :
     1331                   assign
     1332                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1333                   .
     1334               end.
     1335           end.
     1336       end.
     1337   end.
     1338   end procedure.
     1339   do
     1340   on error undo, return error
     1341   :
     1342   FOR EACH gds-list:
     1343     DELETE gds-list.
     1344   END.
     1345   assign
     1346   ii0 = num-entries(p-rid-list)
     1347   .
     1348   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1350     (input  p-curr-obj-type
     1351     ,input  p-curr-obj-code
     1352     ,output v-host-code
     1353     )  .
     1354   _ii:
     1355   DO ii = 1 TO ii0:
     1356   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357      FIND FIRST buf_cd-plu Exclusive-lock WHERE
     1358               RECID(buf_cd-plu) = INTEGER(ENTRY(ii, p-rid-list)) NO-ERROR.
     1359      IF not AVAILABLE  buf_cd-plu  THEN do:
     1360         run write-log-and-file in p-log-handle (
     1361               input 1
     1362             , input log-file-name
     1363             , input 1
     1364             , input substitute("Не найдена или занята запись товара на кассе R-keeper c recid &1", INTEGER(ENTRY(ii, p-rid-list)))).
     1365         assign
     1366         v-view-log = yes.
     1367         next _ii.
     1368      end.
     1369      if buf_cd-plu.b-code = 0 then do:
     1370         run write-log-and-file in p-log-handle (
     1371               input 1
     1372             , input log-file-name
     1373             , input 1
     1374             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не сопоставлен товар в системе IBS TH"
     1375                                 , buf_cd-plu.plu-code
     1376                                 , buf_cd-plu.key#_one
     1377                                 , buf_cd-plu.charkey_one
     1378                                 , chr(10)
     1379                               )).
     1380         assign
     1381         v-view-log = yes.
     1382         next _ii.
     1383      end.
     1384      find first buf_bar-code no-lock where
     1385               buf_bar-code.b-code =  buf_cd-plu.b-code no-error.
     1386      if not available buf_bar-code then do:
     1387         run write-log-and-file in p-log-handle (
     1388               input 1
     1389             , input log-file-name
     1390             , input 1
     1391             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с бар-кодом &5 в системе IBS TH"
     1392                                 , buf_cd-plu.plu-code
     1393                                 , buf_cd-plu.key#_one
     1394                                 , buf_cd-plu.charkey_one
     1395                                 , chr(10)
     1396                                 , buf_cd-plu.b-code
     1397                               )).
     1398         assign
     1399         v-view-log = yes.
     1400         next _ii.
     1401      end.
     1402      find first buf_goods no-lock where
     1403               buf_goods.gds-code = buf_bar-code.gds-code  no-error no-wait.
     1404      if not available buf_goods and not locked buf_goods then do:
     1405         run write-log-and-file in p-log-handle (
     1406               input 1
     1407             , input log-file-name
     1408             , input 1
     1409             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4 - не найден товар с кодом &5 для бар-кода &6 в системе IBS TH"
     1410                                 , buf_cd-plu.plu-code
     1411                                 , buf_cd-plu.key#_one
     1412                                 , buf_cd-plu.charkey_one
     1413                                 , chr(10)
     1414                                 , buf_cd-plu.b-code
     1415                                 , buf_bar-code.gds-code
     1416                               )).
     1417         assign
     1418         v-view-log = yes.
     1419         next _ii.
     1420      end.
     1421     find first buf_fbr-gds-obj exclusive-lock where
     1422               buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     1423           AND buf_fbr-gds-obj.obj-type = p-curr-obj-type
     1424           AND buf_fbr-gds-obj.obj-code = p-curr-obj-code no-wait no-error.
     1425     if locked buf_fbr-gds-obj then do:
     1426       run write-log-and-file in p-log-handle (
     1427             input 1
     1428           , input log-file-name
     1429           , input 1
     1430           , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1431                                 " - атрибуты РЕСТОРАН для товара с кодом &5 - запись ЗАНЯТА"
     1432                               , buf_cd-plu.plu-code
     1433                               , buf_cd-plu.key#_one
     1434                               , buf_cd-plu.charkey_one
     1435                               , chr(10)
     1436                               , buf_cd-plu.b-code
     1437                             )).
     1438       assign
     1439       v-view-log = yes.
     1440       next _ii.
     1441     end.
     1442     if available buf_Fbr-gds-obj then do:
     1443       assign
     1444       v-rid = recid(buf_Fbr-gds-obj)
     1445       .
     1446     end.
     1447     find last buf_cd-doc-line NO-LOCK WHERE
     1448               buf_cd-doc-line.obj-type = buf_cd-plu.obj-type
     1449           and buf_cd-doc-line.obj-code = buf_cd-plu.obj-code
     1450           and buf_cd-doc-line.pos-type = buf_cd-plu.pos-type
     1451           and buf_cd-doc-line.doc-type = 'переоценка':U
     1452           and buf_cd-doc-line.plu-type = '':U
     1453           and buf_cd-doc-line.plu-code = buf_cd-plu.plu-code use-index pi.
     1454     if not available buf_cd-doc-line
     1455     and buf_cd-plu.charkey_two <> "M":U
     1456     then do:
     1457       run write-log-and-file in p-log-handle (
     1458             input 1
     1459           , input log-file-name
     1460           , input 1
     1461           , input substitute( "!!!Блюдо меню на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1462                                 " - товар с кодом &5 - не найдена цена на кассе - синхронизация по атрибутам РЕСТОРАН НЕВОЗМОЖНА"
     1463                               , buf_cd-plu.plu-code
     1464                               , buf_cd-plu.key#_one
     1465                               , buf_cd-plu.charkey_one
     1466                               , chr(10)
     1467                               , buf_cd-plu.b-code
     1468                             )).
     1469       assign
     1470       v-view-log = yes.
     1471       next _ii.
     1472     end.
     1473     if not available buf_fbr-gds-obj
     1474     or not buf_fbr-gds-obj.is-modificator
     1475     or not buf_fbr-gds-obj.is-null-price then do:
     1476       run ref/fgdsobj1.p (
     1477                       input-output    v-rid
     1478                       ,input (if available buf_fbr-gds-obj then 'ИЗМЕНЕНИЕ':U else 'ДОБАВЛЕНИЕ':U)
     1479                       ,input yes
     1480                       ,input buf_goods.gds-code
     1481                       ,input p-curr-obj-type
     1482                       ,input p-curr-obj-code
     1483                       ,input (if available buf_fbr-gds-obj
     1484                             then buf_fbr-gds-obj.fbr-grp-code
     1485                             else 0)
     1486                       ,input (if available buf_fbr-gds-obj
     1487                             then buf_fbr-gds-obj.fbr-obj-type
     1488                             else "":U)
     1489                       ,input (if available buf_fbr-gds-obj
     1490                               then buf_fbr-gds-obj.fbr-obj-code
     1491                               else 0)
     1492                       ,input yes
     1493                       ,input (if available buf_fbr-gds-obj
     1494                               then buf_fbr-gds-obj.is-menu
     1495                               else no)
     1496                       ,input (if  buf_cd-plu.charkey_two = "M":U
     1497                               then yes
     1498                               else no)
     1499                       ,input (if buf_cd-plu.charkey_two = "M":U
     1500                               then yes
     1501                               else (if available buf_cd-doc-line
     1502                                   and buf_cd-doc-line.deckey_one <> 0.0
     1503                                   then no
     1504                                   else yes
     1505                                   )
     1506                             )
     1507                       ,input (if available buf_fbr-gds-obj
     1508                               then buf_fbr-gds-obj.is-season
     1509                               else no)
     1510                       ,input (if available buf_fbr-gds-obj
     1511                               then buf_fbr-gds-obj.is-semi-finished
     1512                               else no)
     1513                       ) no-error .
     1514       if error-status:error then do:
     1515         run write-log-and-file in p-log-handle (
     1516               input 1
     1517             , input log-file-name
     1518             , input 1
     1519             , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3>&4" +
     1520                               " - не удалось синхронизировать с товар с кодом &5 по признакам МОДИФИКАТОр и НУЛЕВАЯ ЦЕНА:&4&6 &7"
     1521                                 , buf_cd-plu.plu-code
     1522                                 , buf_cd-plu.key#_one
     1523                                 , buf_cd-plu.charkey_one
     1524                                 , chr(10)
     1525                                 , buf_cd-plu.b-code
     1526                                 , error-status:get-message(1)
     1527                                 , return-value
     1528                               )).
     1529         assign
     1530         v-view-log = yes.
     1531         next _ii.
     1532       end.
     1533     end.
     1534     buf_cd-plu.logkey_three = no.
     1535     ii-ok = ii-ok + 1.
     1536     run show-counter in p-log-handle .
     1537     run write-counter in p-log-handle (substitute("Обработано &1 блюд, из них упешно &2"
     1538                                       , ii
     1539                                       , ii-ok
     1540                                       )) no-error.
     1541     run get-stop-state in p-log-handle(output v-stop-state).
     1542     if v-stop-state then do:
     1543       run write-log-and-file in p-log-handle (
     1544             input 1
     1545           , input log-file-name
     1546           , input 1
     1547           , input substitute( "!!!Процесс прерван пользователем"
     1548                             )).
     1549       assign
     1550       v-view-log = yes.
     1551       LEAVE _II.
     1552     end.
     1553   END.
     1554   run write-log-and-file in p-log-handle (
     1555         input 1
     1556       , input log-file-name
     1557       , input 1
     1558       , input substitute( "!!!Из &1 товаров успешно по названию синхронизировано &2"
     1559                           , ii0
     1560                           , ii-ok
     1561                         )).
     1562   end.
