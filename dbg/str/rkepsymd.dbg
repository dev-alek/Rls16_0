      175   function get-rkgTH-price returns decimal(input p-obj-type as character
      176                                          , input p-obj-code as integer
      177                                          , input p-b-code as integer
      178                                          , output p-doc-num as character):
      179   define variable v-price-sale as decimal   no-undo init ?.
      180   define variable v-road-tax   as decimal   no-undo .
      181   define variable v-excise     as decimal   no-undo .
      182   define variable v-vat-pc     as decimal   no-undo .
      183   define variable v-slt-pc     as decimal   no-undo .
      184   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
      186     (input  p-obj-type
      187     ,input  p-obj-code
      188     ,input  p-b-code
      189     ,input  0
      190     ,input  0
      191     ,output p-doc-num
      192     ,output v-price-sale
      193     ,output v-road-tax
      194     ,output v-excise
      195     ,output v-vat-pc
      196     ,output v-slt-pc
      197     ) no-error .
      198   if not error-status:error then return v-price-sale.
      199   END FUNCTION.
      200   function get-rkgTH-name returns character(input p-obj-type as character
      201                                             ,input p-obj-code as integer
      202                                             ,input p-b-code as integer
      203                                             , buffer buf_goods for ub.goods):
      204   define variable v-gds-name as character no-undo .
      205   define VARIABLE varresult   as character                no-undo.
      206   define VARIABLE vartype-bc  as character                no-undo.
      207   define VARIABLE varweight   as decimal                  no-undo.
      208   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
      209   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
      210   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
      211   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
      212   DEFINE BUFFER buf_place FOR ub.place.
      213   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
      214   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      215   (
      216    input  parparentproc
      217   ,input  STRING(p-b-code)
      218   ,input  0
      219   ,input  p-obj-type
      220   ,input  p-obj-code
      221   ,input  NO
      222   ,input  YES
      223   ,input  varscales-pref2
      224   ,input  varpgscales-pref2
      225   ,output varresult
      226   ,output vartype-bc
      227   ,output varweight
      228   ,buffer buf_bar-code
      229   ,buffer buf_prod-bc
      230   ,buffer buf_place
      231   ) no-error.
      232   if not available buf_bar-code then
      233   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      234   FIND FIRST buf_goods NO-LOCK WHERE
      235             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
      236   IF NOT AVAILABLE buf_goods THEN DO:
      237     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
      238   END.
      239   else do:
      240     assign
      241     v-gds-name = buf_goods.chk-name
      242     .
      243   end.
      244   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
      245     ASSIGN
      246     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
      247   END.
      248   FIND FIRST buf_gds-prt NO-LOCK WHERE
      249             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
      250   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
      251       FIND FIRST buf_gds-prt NO-LOCK WHERE
      252                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
      253   END.
      254   ASSIGN
      255   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
      256   ASSIGN
      257   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
      258   return v-gds-name.
      259   END FUNCTION.
      260   function get-rkgTH-group returns integer(input p-obj-type as character
      261                                           , input p-obj-code  as integer
      262                                           , input p-gds-code as integer
      263                                           , output p-grp-name as character
      264                                           ):
      265   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      266   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      267   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      268           buf_fbr-gds-obj.obj-type = p-obj-type
      269       AND buf_fbr-gds-obj.obj-code = p-obj-code
      270       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      271   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      272     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
      273                                                 input p-obj-type
      274                                                 ,INPUT p-obj-code
      275                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
      276                                                 ,OUTPUT p-grp-name) NO-ERROR.
      277     return buf_fbr-gds-obj.fbr-grp-code.
      278   END.
      279   return ?.
      280   END FUNCTION.
      281   function get-rkgTH-modificator returns logical(input p-obj-type as character
      282                                           , input p-obj-code  as integer
      283                                           , input p-gds-code as integer
      284                                           , output p-is-null-price as logical
      285                                           ):
      286   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
      287   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
      288           buf_fbr-gds-obj.obj-type = p-obj-type
      289       AND buf_fbr-gds-obj.obj-code = p-obj-code
      290       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
      291   IF AVAILABLE buf_fbr-gds-obj THEN DO:
      292     assign
      293     p-is-null-price = buf_fbr-gds-obj.is-null-price
      294     .
      295     return buf_fbr-gds-obj.is-modificator.
      296   END.
      297   assign
      298   p-is-null-price = no.
      299   return no.
      300   END FUNCTION.
      301   function get-rkgTH-group-name returns character(input p-obj-type as character
      302                                                 , input p-obj-code  as integer
      303                                                 , input p-out-code as integer):
      304   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      305   find first buf_fbr-gds-grp no-lock where
      306             buf_fbr-gds-grp.obj-type = p-obj-type
      307         AND buf_fbr-gds-grp.obj-code = p-obj-code
      308         and buf_fbr-gds-grp.out-code = p-out-code no-error .
      309   if not available buf_fbr-gds-grp then return ?.
      310   return buf_fbr-gds-grp.node-name.
      311   END FUNCTION.
      312   function get-rkgTH-parent returns integer(input p-obj-type as character
      313                                             , input p-obj-code  as integer
      314                                             , input p-out-code as integer):
      315   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
      316   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
      317   find first buf_fbr-gds-grp no-lock where
      318             buf_fbr-gds-grp.obj-type = p-obj-type
      319         AND buf_fbr-gds-grp.obj-code = p-obj-code
      320         and buf_fbr-gds-grp.out-code = p-out-code no-error .
      321   if not available buf_fbr-gds-grp then return ?.
      322   find first upper_fbr-gds-grp no-lock where
      323             upper_fbr-gds-grp.obj-type = p-obj-type
      324         AND upper_fbr-gds-grp.obj-code = p-obj-code
      325         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
      326   if not available upper_fbr-gds-grp then return ?.
      327   return upper_fbr-gds-grp.out-code.
      328   END FUNCTION.
      329   procedure get-rkep-full-grp-name :
      330   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      331   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
      332   define output parameter p-full-name as character    no-undo.
      333   define variable v-upper-code    as integer  no-undo.
      334   define buffer buf_cd-grp       for ub.cd-grp.
      335   define buffer buf_upper_cd-grp for ub.cd-grp.
      336   do
      337   on error undo, return error
      338   :
      339       if P-grp-code = 0
      340       then do:
      341           assign
      342               p-full-name = ""
      343           .
      344       end.
      345       else do:
      346           find first buf_cd-grp no-lock where
      347                  buf_cd-grp.obj-type = 'маг':U
      348              and buf_cd-grp.obj-code = p-obj-code
      349              and buf_cd-grp.pos-type = 'r-keeper':U
      350              and buf_cd-grp.grp-type = '':U
      351              and buf_cd-grp.grp-code = p-grp-code
      352           no-error.
      353           if not available buf_cd-grp
      354           then do:
      355               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
      356           end.
      357           assign
      358               p-full-name  = ""
      359               v-upper-code = 0
      360           .
      361           do while true
      362           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
      363           :
      364               assign
      365               p-full-name  = buf_cd-grp.grp-name
      366                           + (if p-full-name <> "" then chr(47) else "")
      367                           + p-full-name
      368               v-upper-code = buf_cd-grp.upper-grp-code
      369               .
      370               if buf_cd-grp.grp-code = 0
      371               then do:
      372                   leave.
      373               end.
      374               find first buf_cd-grp no-lock where
      375                         buf_cd-grp.obj-type = 'маг':U
      376                     and buf_cd-grp.obj-code = p-obj-code
      377                     and buf_cd-grp.pos-type = 'r-keeper':U
      378                     and buf_cd-grp.grp-type = '':U
      379                     and buf_cd-grp.grp-code = v-upper-code no-error.
      380               if not available buf_cd-grp
      381               then do:
      382                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
      383                                       + string( v-upper-code )
      384                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
      385               end.
      386           end.
      387           assign
      388               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      389           .
      390       end.
      391   end.
      392   end procedure.
      393   function get-price-id-from-int returns character ( input p-file-num as integer):
      394     return ('price-list':U + chr(32) +  string(p-file-num)).
      395   end function.
      396   define variable vss-include-info4 as character format "X(65)" no-undo
      397   initial "@(#)$Workfile$ $Revision$".
