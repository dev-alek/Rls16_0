      111   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      112   assign
      113   v-tth = buffer thbjattr_thbj-attr:table-handle .
      114   define stream   IBMStream .
      115   define temp-table temp-cd no-undo like ub.cash-desk .
      116   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure alienini-getkey :
      119   define input parameter i-filename as char.
      120   define input parameter i-section as char.
      121   define input parameter i-key as char.
      122   define output parameter o-value as char.
      123   define variable EntryPointer as integer no-undo.
      124   define variable mem1 as memptr no-undo.
      125   define variable mem2 as memptr no-undo.
      126   define variable mem1size as integer no-undo.
      127   define variable mem2size as integer no-undo.
      128   define variable ii       as integer    no-undo.
      129   define variable cbReturnSize  as integer    no-undo.
      130   assign
      131   set-size(mem1)  = 4000
      132   mem1size = 4000.
      133   if i-key = "" then EntryPointer = 0.
      134   else do:
      135     assign
      136     set-size(mem2) = 128
      137     mem2size = 128
      138     EntryPointer = get-pointer-value(mem2)
      139     put-string(mem2, 1) = i-key.
      140   end.
      141   run getprivateprofilestringA
      142                                 (i-section,
      143                                  EntryPointer,
      144                                  "",
      145                                  get-pointer-value(mem1),
      146                                  input mem1size,
      147                                  i-filename,
      148                                  output cbReturnSize).
      149   do ii = 1 to cbReturnSize:
      150     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      151                  then o-value + ","
      152                  else o-value + chr(get-byte(mem1, ii)).
      153   end.
      154     set-size(mem1) = 0.
      155     set-size(mem2) = 0.
      156   end procedure.
      157   procedure alienini-putkey :
      158   define input parameter i-filename as char.
      159   define input parameter i-section as char.
      160   define input parameter i-key as char.
      161   define input parameter i-value as char.
      162   define variable cbReturnSize as integer.
      163   run writeprivateprofilestringA
      164                                  (i-section,
      165                                   i-key,
      166                                   i-value,
      167                                   i-filename,
      168                                   output cbReturnSize ).
      169   end procedure.
      170   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      171     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      172     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      173     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      174     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      175     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      176     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      177     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      178   END PROCEDURE.
      179   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      180     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      181     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      182     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      183     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      184     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      185   END PROCEDURE.
      186   define   temp-table temp-tekka-tsk no-undo
      187   field filename      as character
      188   field obj-num       as integer
      189   field obj-name      as character
      190   field num-records   as integer
      191   field max-records   as integer
      192   field min-plu       as integer
      193   field max-plu       as integer
      194   field num-fields    as integer
      195   field task-num      as character
      196   field by-record     as logical
      197   field send-get      as character
      198   field cash-num      as integer
      199   field cash-num-char as character
      200   field port-num      as character
      201   field way           as character
      202   field is-script     as logical
      203   field pswd          as character
      204   field waiting-sek   as integer
      205   field other-info    as character
      206   field order-num     as integer
      207   field secondary     as integer
      208   field shift-fields  as integer
      209   field binary        as logical
      210   field range         as integer
      211   index pi is unique primary
      212   filename
      213   range
      214   index lpi
      215   filename
      216   min-plu
      217   index gpi
      218   filename
      219   max-plu
      220   index iorder
      221   order-num
      222   .
      223   define   temp-table temp-tekka-schema no-undo
      224   field obj-num as integer
      225   field obj-name as character
      226   field field-num as integer
      227   field field-name as character
      228   field num-records as integer
      229   field size_ as integer
      230   field host as character
      231   field progress-type as character
      232   field custom-type as character
      233   field start-pos as integer
      234   field end-pos as integer
      235   field bin-group as character
      236   index pi is unique primary
      237   host obj-num field-num
      238   .
      239   define temp-table temp-tekka-record no-undo
      240   field obj-num as integer
      241   field plu as integer
      242   field body as character
      243   field shift as integer
      244   index pi is unique primary obj-num plu.
      245   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      246   define variable v-is-closed-shift-journal as integer no-undo .
      247   assign
      248   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      249                               +
      250                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      251                               +
      252                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      253   .
      254   return v-is-closed-shift-journal.
      255   END FUNCTION.
      256   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      257   define variable v-is-first-journal as logical no-undo .
      258   assign
      259   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      260                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      261                     or (p-journal-num =  integer(entry(1, '17':U)))
      262                     or (p-journal-num = integer(entry(1, '16':U)))
      263   .
      264   return v-is-first-journal.
      265   END FUNCTION.
      266   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      267   define variable v-is-petrol-journal as logical no-undo .
      268   assign
      269   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      270   return v-is-petrol-journal.
      271   END FUNCTION.
      272   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      273   define variable v-max-record-num as integer no-undo .
      274   assign
      275   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      276                       then 1489
      277                       else 2340).
      278   return v-max-record-num.
      279   END FUNCTION.
      280   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      281   define variable v-max-record-num as integer no-undo .
      282   assign
      283   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      284                       then 1489 * num-entries('30,31,32,33':U)
      285                       else 2340 * num-entries('17':U)).
      286   return v-max-record-num.
      287   END FUNCTION.
      288   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      289                                           ,input p-rec-no as integer):
      290   define variable v-num-recs as integer no-undo .
      291   if tekka-is-petrol-journal (p-journal-num) then do:
      292     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      293       assign
      294       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      295       .
      296     end.
      297     else do:
      298       assign
      299       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      300       .
      301     end.
      302   end.
      303   else do:
      304     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      305       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      306         assign
      307         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      308         .
      309       end.
      310       else do:
      311         assign
      312         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      313         .
      314       end.
      315     end.
      316     else do:
      317       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      318         assign
      319         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      320         .
      321       end.
      322       else do:
      323         assign
      324         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      325         .
      326       end.
      327     end.
      328   end.
      329   return v-num-recs.
      330   END FUNCTION.
      331   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      332                                              ,input p-is-petrol as logical
      333                                              ,input p-is-current as logical
      334                                              ,output p-rec-no as decimal
      335                                              ):
      336   define variable v-obj-num0 as integer no-undo .
      337   define variable v-obj-num as integer no-undo .
      338   define variable v-obj-num2 as integer no-undo .
      339   define variable p-num-recs2 as integer no-undo .
      340   define variable p-rec-no2 as integer no-undo .
      341   if p-is-petrol then do:
      342     assign
      343     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      344     .
      345     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      346     then
      347     assign
      348     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      349     p-rec-no = p-num-recs modulo 1489
      350     .
      351     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      352     then
      353     assign
      354     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      355     p-rec-no = p-num-recs modulo 1489
      356     .
      357   end.
      358   else do:
      359     assign
      360     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      361     p-num-recs = trunc(p-num-recs, 0)
      362     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      363     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      364     .
      365     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      366     then
      367     assign
      368     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      369     p-rec-no = p-num-recs modulo 2340
      370     .
      371     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      372     then
      373     assign
      374     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      375     p-rec-no = p-num-recs modulo 2340
      376     .
      377     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      378     then
      379     assign
      380     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      381     p-rec-no2 = p-num-recs2 modulo 2978
      382     .
      383     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      384     then
      385     assign
      386     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      387     p-rec-no2 = p-num-recs2 modulo 2978
      388     .
      389     assign
      390     p-rec-no = p-rec-no + p-rec-no2 / 10000
      391     .
      392   end.
      393   if v-obj-num = 0 then v-obj-num = 100.
      394   return v-obj-num.
      395   END FUNCTION.
      396   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      397   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      398   if lookup (string(p-obj-num), '17':U) > 0 then do:
      399      if p-is-ptrl then
      400      return integer(entry(1, '26,27,28,29':U)).
      401      if not p-is-ptrl then
      402      return integer(entry(1, '16':U)).
      403   end.
      404   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      405   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      406   return 0.
      407   END FUNCTION.
      408   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      409   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      410   if lookup (string(p-obj-num), '17':U) > 0 then do:
      411     if p-is-ptrl then
      412     return integer(entry(1, '26,27,28,29':U)).
      413     if not p-is-ptrl then
      414     return integer(entry(1, '16':U)).
      415   end.
      416   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      417   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      418   return 0.
      419   END FUNCTION.
      420   PROCEDURE maria-put:
      421   define parameter buffer buf_cash-desk for ub.cash-desk.
      422   define input parameter p-out    as character no-undo .
      423   define input parameter p-fname as character no-undo .
      424   define input parameter p-by-record as logical no-undo .
      425   define input parameter p-shift-fields as integer no-undo .
      426   define input parameter p-binary as logical no-undo .
      427   define input parameter p-obj-num as integer no-undo .
      428   define input parameter p-max-records as integer no-undo .
      429   define input parameter p-plu as integer no-undo .
      430   define input parameter p-value as character no-undo .
      431   define variable v-file-name as character no-undo .
      432   define variable v-create as logical no-undo .
      433   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      434   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      435   output stream IBMSTREAM
      436   to value(v-file-name) append .
      437   Put  stream IBMSTREAM unformatted
      438   p-plu
      439   chr(3)
      440   p-value
      441   skip.
      442   output stream IBMSTREAM
      443   close.
      444   if not p-by-record then do:
      445     find first buf_temp-tekka-tsk where
      446               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      447     if not available buf_temp-tekka-tsk then do:
      448       v-create = yes.
      449     end.
      450   end.
      451   else do:
      452     find first buf_temp-tekka-tsk where
      453               buf_temp-tekka-tsk.filename  = v-file-name
      454           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      455     if not available buf_temp-tekka-tsk
      456     then do:
      457       find first buf_temp-tekka-tsk where
      458                 buf_temp-tekka-tsk.filename  = v-file-name
      459             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      460       if not available buf_temp-tekka-tsk
      461       then do:
      462         v-create = yes.
      463       end.
      464     end.
      465   end.
      466   if v-create then do:
      467     create buf_temp-tekka-tsk.
      468     assign
      469     buf_temp-tekka-tsk.filename = v-file-name
      470     buf_temp-tekka-tsk.range    = p-plu
      471     buf_temp-tekka-tsk.obj-num = p-obj-num
      472     buf_temp-tekka-tsk.obj-name = '':U
      473     buf_temp-tekka-tsk.num-records = 0
      474     buf_temp-tekka-tsk.max-records = p-max-records
      475     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      476     buf_temp-tekka-tsk.task-num = p-fname
      477     buf_temp-tekka-tsk.by-record = p-by-record
      478     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      479     buf_temp-tekka-tsk.binary = p-binary
      480     buf_temp-tekka-tsk.send-get = 'send'
      481     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      482     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      483     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      484     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      485                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      486                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      487                                 then 'local'
      488                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      489     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      490     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      491     buf_temp-tekka-tsk.waiting-sek = 30
      492     buf_temp-tekka-tsk.min-plu     = p-plu
      493     buf_temp-tekka-tsk.max-plu     = p-plu
      494     .
      495   end.
      496   assign
      497   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      498   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      499   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      500   .
      501   END PROCEDURE.
      502   PROCEDURE maria-get:
      503   define parameter buffer buf_cash-desk for ub.cash-desk.
      504   define input parameter p-out    as character no-undo .
      505   define input parameter p-fname as character no-undo .
      506   define input parameter p-by-record as logical no-undo .
      507   define input parameter p-obj-num as integer no-undo .
      508   define input parameter p-num-fields as integer no-undo .
      509   define input parameter p-max-records as integer no-undo .
      510   define input parameter p-min-plu as integer no-undo .
      511   define input parameter p-max-plu as integer no-undo .
      512   define input parameter p-other as character no-undo .
      513   define input parameter p-order-num as integer no-undo .
      514   define variable v-file-name as character no-undo .
      515   define variable v-secondary-obj-num as character no-undo .
      516   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      517   if p-by-record then do:
      518     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      519   end.
      520   else do:
      521     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      522   end.
      523   find first buf_temp-tekka-tsk where
      524             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      525   if not available buf_temp-tekka-tsk then do:
      526     create buf_temp-tekka-tsk.
      527     assign
      528     buf_temp-tekka-tsk.filename = v-file-name
      529     buf_temp-tekka-tsk.obj-num = p-obj-num
      530     buf_temp-tekka-tsk.obj-name = '':U
      531     buf_temp-tekka-tsk.max-records = p-max-records
      532     buf_temp-tekka-tsk.num-fields = p-num-fields
      533     buf_temp-tekka-tsk.task-num = p-fname
      534     buf_temp-tekka-tsk.by-record = p-by-record
      535     buf_temp-tekka-tsk.send-get = 'get'
      536     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      537     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      538     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      539     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      540                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      541                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      542                                   then 'local'
      543                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      544     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      545     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      546     buf_temp-tekka-tsk.waiting-sek = 30
      547     buf_temp-tekka-tsk.min-plu     = p-min-plu
      548     buf_temp-tekka-tsk.max-plu     = p-max-plu
      549     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      550                                       and p-max-plu <> ?
      551                                       then p-max-plu - p-min-plu + 1
      552                                       else 0)
      553     buf_temp-tekka-tsk.other-info = p-other
      554     buf_temp-tekka-tsk.order-num = p-order-num
      555     .
      556     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      557       assign
      558       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      559       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      560       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      561       no-error
      562       .
      563       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      564     end.
      565   end.
      566   END PROCEDURE.
      567   PROCEDURE maria-task:
      568   define parameter buffer buf_cash-desk for ub.cash-desk.
      569   define input parameter p-fname as character no-undo .
      570   define input parameter p-obj-num-list as character no-undo .
      571   define input parameter p-parameters as character no-undo .
      572   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      573   find first buf_temp-tekka-tsk where
      574             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      575   if not available buf_temp-tekka-tsk then do:
      576     create buf_temp-tekka-tsk.
      577     assign
      578     buf_temp-tekka-tsk.filename = ''
      579     buf_temp-tekka-tsk.range = 1
      580     buf_temp-tekka-tsk.obj-num = 0
      581     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      582     buf_temp-tekka-tsk.task-num = p-fname
      583     buf_temp-tekka-tsk.by-record = no
      584     buf_temp-tekka-tsk.send-get = 'task'
      585     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      586     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      587     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      588     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      589                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      590                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      591                                   then 'local'
      592                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      593     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      594     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      595     buf_temp-tekka-tsk.waiting-sek = 30
      596     buf_temp-tekka-tsk.other-info = p-parameters
      597     buf_temp-tekka-tsk.order-num = 0
      598     .
      599   end.
      600   END PROCEDURE.
      601   procedure tekkatsk-verify-schema :
      602   define input parameter p-obj-list as character no-undo .
      603   define input parameter p-dir-path as character no-undo .
      604   define variable v-obj-num as integer no-undo .
      605   define variable v-obj-name as character no-undo .
      606   define variable v-num-records as integer no-undo .
      607   define variable v-size_ as integer no-undo .
      608   define variable v-value as character no-undo .
      609   define variable ii as integer no-undo .
      610   define variable jj as integer no-undo .
      611   define variable ii-ibs as integer no-undo .
      612   define variable ii-tekka as integer no-undo .
      613   define variable v-result as character no-undo .
      614   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      615   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      616     do
      617     on error undo, return error
      618     :
      619        for each buf_temp-tekka-schema:
      620          delete buf_temp-tekka-schema.
      621        end.
      622        input from value('tekkasch.d').
      623        repeat :
      624          create buf_temp-tekka-schema.
      625          import buf_temp-tekka-schema.
      626          assign
      627          buf_temp-tekka-schema.host = 'IBS'
      628          ii = ii + 1.
      629          .
      630        end.
      631        input close.
      632        ii-ibs = ii.
      633         _ii:
      634         do ii = 1 to 256:
      635           if p-obj-list = "ALL"
      636           or lookup(string(ii), p-obj-list) > 0 then do:
      637             assign
      638             v-obj-num = 0
      639             v-obj-name = ''
      640             v-num-records = 0
      641             v-size_ = 0
      642             .
      643             run alienini-getkey in this-procedure (
      644                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      645                                                     ,input ('obj' + string(ii, '999'))
      646                                                     ,input 'oname'
      647                                                     ,output v-value) no-error .
      648             if v-value = ? then next _ii.
      649             assign
      650             v-obj-num = ii
      651             v-obj-name = v-value
      652             .
      653             run alienini-getkey in this-procedure (
      654                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      655                                                     ,input ('obj' + string(ii, '999'))
      656                                                     ,input 'size'
      657                                                     ,output v-value) no-error .
      658             assign
      659             v-num-records = integer(v-value) no-error  .
      660             if error-status:error
      661             or v-num-records = 0 then next _ii.
      662             run alienini-getkey in this-procedure (
      663                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      664                                                     ,input 'obj' + string(ii, '999')
      665                                                     ,input 'f000'
      666                                                     ,output v-value) no-error .
      667             assign
      668             v-size_ = integer(v-value) no-error  .
      669             if error-status:error
      670             or v-size_ = 0 then next _ii.
      671             _jj:
      672             do jj = 1 to 256:
      673               run alienini-getkey in this-procedure (
      674                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      675                                                       ,input 'obj' + string(ii, '999')
      676                                                       ,input 'f' + string(jj, '999')
      677                                                       ,output v-value) no-error .
      678               if v-value = ? then next _ii.
      679               create buf_temp-tekka-schema.
      680               assign
      681               buf_temp-tekka-schema.host = 'tekka'
      682               buf_temp-tekka-schema.obj-num = v-obj-num
      683               buf_temp-tekka-schema.obj-name = v-obj-name
      684               buf_temp-tekka-schema.num-records = v-num-records
      685               buf_temp-tekka-schema.size_ = v-size_
      686               buf_temp-tekka-schema.field-num = jj
      687               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      688               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      689                                                  then entry(2, entry(2, v-value, '#'), ':')
      690                                                  else '':U)
      691               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      692               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      693               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      694                                                           , 'C,I,I,I,D,D,D,D,D':U)
      695               no-error
      696               .
      697               if error-status:error then do:
      698                 delete buf_temp-tekka-schema.
      699                 next _jj.
      700               end.
      701               run alienini-getkey in this-procedure (
      702                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      703                                                       ,input 'obj' + string(ii, '999') + 'name'
      704                                                       ,input 'n' + string(jj, '999')
      705                                                       ,output v-value) no-error .
      706               if v-value <> ? then
      707               buf_temp-tekka-schema.field-name = v-value.
      708             end.
      709           end.
      710         end.
      711         ii-tekka = ii - 1.
      712        if p-obj-list <> 'ALL' then do:
      713         if ii-tekka <> ii-ibs then do:
      714           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      715                                   , ii-ibs
      716                                   , ii-tekka).
      717         end.
      718        end.
      719        for each buf_temp-tekka-schema where
      720               buf_temp-tekka-schema.host = 'tekka':
      721          find first buf2_temp-tekka-schema where
      722                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      723                AND buf2_temp-tekka-schema.host = 'ibs'
      724                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      725          if not available buf2_temp-tekka-schema then do:
      726           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      727                                   , buf_temp-tekka-schema.field-num
      728                                   , buf_temp-tekka-schema.obj-num).
      729          end.
      730          buffer-compare buf_temp-tekka-schema
      731          to buf2_temp-tekka-schema
      732          save result in v-result.
      733          if v-result <> '':U then do:
      734           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      735                                   , buf_temp-tekka-schema.field-num
      736                                   , buf_temp-tekka-schema.obj-num).
      737          end.
      738        end.
      739     end.
      740   end procedure.
      741   FUNCTION set-Sx returns character (input p-string as character):
      742   return p-string.
      743   END FUNCTION.
      744   FUNCTION get-Sx returns character (input p-string  as character):
      745   return p-string.
      746   END FUNCTION.
      747   FUNCTION set-B returns character (input p-string  as character):
      748   return chr(integer(p-string)).
      749   END FUNCTION.
      750   FUNCTION get-B returns character (input p-string  as character):
      751   return string(asc(p-string)).
      752   END FUNCTION.
      753   FUNCTION set-BF returns character (input p-string  as character):
      754   define variable v-dopi as integer no-undo .
      755   define variable ii as integer no-undo .
      756   do ii = 1 to 8:
      757     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      758   end.
      759   return chr(v-dopi).
      760   END FUNCTION.
      761   FUNCTION get-BF returns character (input p-string  as character):
      762   define variable v-dopi as integer no-undo .
      763   define variable v-dops as character no-undo .
      764   define variable ii as integer no-undo .
      765   v-dopi = asc(p-string).
      766   do ii = 8 to 1 BY -1:
      767     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      768   end.
      769   return v-dops.
      770   END FUNCTION.
      771   FUNCTION set-BN returns character (input p-string  as character
      772                                     ,input p-bin-group as character):
      773   define variable v-dopi as integer no-undo .
      774   define variable ii as integer no-undo .
      775   define variable jj as integer no-undo .
      776   define variable v-grp-nums as integer no-undo .
      777   define variable v-dopi2 as integer no-undo .
      778   v-grp-nums = num-entries(p-bin-group).
      779   do jj = 0 to v-grp-nums - 1:
      780     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      781     do ii = 1 to 8:
      782       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      783     end.
      784   end.
      785   return chr(v-dopi).
      786   END FUNCTION.
      787   FUNCTION get-BN returns character (input p-string  as character
      788                                     ,input p-bin-group as character):
      789   define variable v-dopi as integer no-undo .
      790   define variable v-dops as character no-undo .
      791   define variable v-grp-nums as integer no-undo .
      792   define variable ii as integer no-undo .
      793   define variable jj as integer no-undo .
      794   v-dopi = asc(p-string).
      795   v-grp-nums = num-entries(p-bin-group).
      796   do jj = 1 to v-grp-nums:
      797   do ii = 8 to 1 BY -1:
      798     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      799   end.
      800   end.
      801   return v-dops.
      802   END FUNCTION.
      803   procedure fill-temp-cd :
      804   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
      805   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      806   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      807   define input parameter p-clear-table as logical no-undo .
      808   define buffer buf_temp-cd for temp-cd.
      809   define buffer buf_cash-desk for ub.cash-desk.
      810     do
      811     on error undo, return error
      812     :
      813        if p-clear-table  then do:
      814          for each buf_temp-cd:
      815            delete buf_temp-cd.
      816          end.
      817        end.
      818        for each buf_cash-desk no-lock where
      819               buf_cash-desk.db-num = p-db-num
      820           AND buf_cash-desk.obj-code = p-obj-code
      821           and buf_cash-desk.cash-on  = yes
      822        BREAK by buf_cash-desk.pos-type:
      823          if first-of(buf_cash-desk.pos-type) then do:
      824            create buf_temp-cd.
      825            buffer-copy buf_cash-desk to buf_temp-cd.
      826          end.
      827        end.
      828     end.
      829   end procedure.
      830   define variable p-dir as character no-undo .
      831   define variable p-resend as logical no-undo .
      832   define variable file_ as character no-undo .
      833   define variable path as character no-undo .
      834   define variable atr as character no-undo .
      835   define variable v-entry as character no-undo .
      836   define variable ii as integer no-undo .
      837   define variable v-cd-num as character no-undo .
      838   define variable v-shop-code as character no-undo .
      839   define variable ss as character no-undo .
      840   define variable p-encoding as character no-undo init "windows-1251":U.
      841   define variable vss-include-info4 as character format "X(65)" no-undo
      842   initial "@(#)$Workfile$ $Revision$".
      843   procedure xmlchar-test :
      844   define input parameter p-in-string          as character        no-undo.
      845   define output parameter p-out-string-enc    as character        no-undo.
      846   define output parameter p-out-string-dec    as character        no-undo.
      847   do
      848   on error undo, return error
      849   :
      850          run xmlchar-encode in this-procedure
      851       (
      852             input p-in-string
      853           , output p-out-string-enc
      854       ).
      855          run xmlchar-decode in this-procedure
      856       (
      857             input p-out-string-enc
      858           , output p-out-string-dec
      859       ).
      860   end.
      861   end .
      862   procedure xmlchar-encode :
      863   define input parameter p-in-string      as character        no-undo.
      864   define output parameter p-out-string    as character        no-undo.
      865       define variable v-position      as integer      no-undo.
      866       define variable v-current-char  as character    no-undo.
      867   do
      868   on error undo, return error
      869   :
      870       assign
      871           p-out-string = "":U
      872       .
      873       case p-in-string
      874       :
      875           when ?
      876           then do:
      877               assign
      878                   p-out-string = "?":U
      879               .
      880           end.
      881           when "?":U
      882           then do:
      883               assign
      884                   p-out-string = "&#63;":U
      885               .
      886           end.
      887           otherwise do:
      888               do v-position = 1 to length( p-in-string )
      889               :
      890                   assign
      891                       v-current-char = substring( p-in-string, v-position, 1 )
      892                   .
      893                   case v-current-char
      894                   :
      895                       when "&":U
      896                       then do:
      897                           assign
      898                               p-out-string = p-out-string + "&amp;":U
      899                           .
      900                       end.
      901                       when ">":U
      902                       then do:
      903                           assign
      904                               p-out-string = p-out-string + "&gt;":U
      905                           .
      906                       end.
      907                       when "<":U
      908                       then do:
      909                           assign
      910                               p-out-string = p-out-string + "&lt;":U
      911                           .
      912                       end.
      913                       when "'":U
      914                       then do:
      915                           assign
      916                               p-out-string = p-out-string + "&apos;":U
      917                           .
      918                       end.
      919                       when '"':U
      920                       then do:
      921                           assign
      922                               p-out-string = p-out-string + "&quot;":U
      923                           .
      924                       end.
      925                       when chr(1)
      926                       then do:
      927                           assign
      928                               p-out-string = p-out-string + "":U
      929                           .
      930                       end.
      931                       when chr(2)
      932                       then do:
      933                           assign
      934                               p-out-string = p-out-string + "":U
      935                           .
      936                       end.
      937                       when chr(3)
      938                       then do:
      939                           assign
      940                               p-out-string = p-out-string + "":U
      941                           .
      942                       end.
      943                       when chr(4)
      944                       then do:
      945                           assign
      946                               p-out-string = p-out-string + "":U
      947                           .
      948                       end.
      949                       when chr(5)
      950                       then do:
      951                           assign
      952                               p-out-string = p-out-string + "":U
      953                           .
      954                       end.
      955                       when chr(6)
      956                       then do:
      957                           assign
      958                               p-out-string = p-out-string + "":U
      959                           .
      960                       end.
      961                       when chr(7)
      962                       then do:
      963                           assign
      964                               p-out-string = p-out-string + "":U
      965                           .
      966                       end.
      967                       when chr(8)
      968                       then do:
      969                           assign
      970                               p-out-string = p-out-string + "":U
      971                           .
      972                       end.
      973                       when chr(9)
      974                       then do:
      975                           assign
      976                               p-out-string = p-out-string + "":U
      977                           .
      978                       end.
      979                       when chr(29)
      980                       then do:
      981                           assign
      982                               p-out-string = p-out-string + "":U
      983                           .
      984                       end.
      985                       when chr(10)
      986                       then do:
      987                           assign
      988                               p-out-string = p-out-string + "&#10;":U
      989                           .
      990                       end.
      991                       when chr(13)
      992                       then do:
      993                           assign
      994                               p-out-string = p-out-string + "&#13;":U
      995                           .
      996                       end.
      997                       otherwise do:
      998                           assign
      999                               p-out-string = p-out-string + v-current-char
     1000                           .
     1001                       end.
     1002                   end case.
     1003               end.
     1004           end.
     1005       end case.
     1006   end.
     1007   end .
     1008   procedure xmlchar-encode-1c :
     1009   define input parameter p-in-string      as character        no-undo.
     1010   define output parameter p-out-string    as character        no-undo.
     1011       define variable v-position      as integer      no-undo.
     1012       define variable v-current-char  as character    no-undo.
     1013   do
     1014   on error undo, return error
     1015   :
     1016       assign
     1017           p-out-string = "":U
     1018       .
     1019       case p-in-string
     1020       :
     1021           when ?
     1022           then do:
     1023               assign
     1024                   p-out-string = "?":U
     1025               .
     1026           end.
     1027           otherwise do:
     1028               do v-position = 1 to length( p-in-string )
     1029               :
     1030                   assign
     1031                       v-current-char = substring( p-in-string, v-position, 1 )
     1032                   .
     1033                   case v-current-char
     1034                   :
     1035                       when chr(1)
     1036                       then do:
     1037                           assign
     1038                               p-out-string = p-out-string + " ":U
     1039                           .
     1040                       end.
     1041                       when chr(2)
     1042                       then do:
     1043                           assign
     1044                               p-out-string = p-out-string + " ":U
     1045                           .
     1046                       end.
     1047                       when chr(3)
     1048                       then do:
     1049                           assign
     1050                               p-out-string = p-out-string + " ":U
     1051                           .
     1052                       end.
     1053                       when chr(4)
     1054                       then do:
     1055                           assign
     1056                               p-out-string = p-out-string + " ":U
     1057                           .
     1058                       end.
     1059                       when chr(5)
     1060                       then do:
     1061                           assign
     1062                               p-out-string = p-out-string + " ":U
     1063                           .
     1064                       end.
     1065                       when chr(6)
     1066                       then do:
     1067                           assign
     1068                               p-out-string = p-out-string + " ":U
     1069                           .
     1070                       end.
     1071                       when chr(7)
     1072                       then do:
     1073                           assign
     1074                               p-out-string = p-out-string + " ":U
     1075                           .
     1076                       end.
     1077                       when chr(8)
     1078                       then do:
     1079                           assign
     1080                               p-out-string = p-out-string + " ":U
     1081                           .
     1082                       end.
     1083                       when chr(9)
     1084                       then do:
     1085                           assign
     1086                               p-out-string = p-out-string + " ":U
     1087                           .
     1088                       end.
     1089                       when chr(29)
     1090                       then do:
     1091                           assign
     1092                               p-out-string = p-out-string + " ":U
     1093                           .
     1094                       end.
     1095                       when chr(10)
     1096                       then do:
     1097                           assign
     1098                               p-out-string = p-out-string + " ":U
     1099                           .
     1100                       end.
     1101                       when chr(13)
     1102                       then do:
     1103                           assign
     1104                               p-out-string = p-out-string + " ":U
     1105                           .
     1106                       end.
     1107                       otherwise do:
     1108                           assign
     1109                               p-out-string = p-out-string + v-current-char
     1110                           .
     1111                       end.
     1112                   end case.
     1113               end.
     1114           end.
     1115       end case.
     1116   end.
     1117   end .
     1118   procedure xmlchar-decode :
     1119   define input parameter p-in-string      as character        no-undo.
     1120   define output parameter p-out-string    as character        no-undo.
     1121       define variable v-position      as integer      no-undo.
     1122       define variable v-last-position as integer      no-undo.
     1123       define variable v-temp-integer  as integer      no-undo.
     1124       define variable v-current-char  as character    no-undo.
     1125       define variable v-next-char     as character    no-undo.
     1126       define variable v-success       as logical      no-undo.
     1127   do
     1128   on error undo, return error
     1129   :
     1130       assign
     1131           p-out-string = "":U
     1132           v-position   = 0
     1133       .
     1134       replace-cycle:
     1135       do while yes
     1136       on error undo, return error
     1137       :
     1138           assign
     1139               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1140           .
     1141           if v-last-position <= v-position
     1142           then do:
     1143               if v-position = 0
     1144               then do:
     1145                   assign
     1146                       p-out-string = p-in-string
     1147                   .
     1148               end.
     1149               else do:
     1150                   assign
     1151                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1152                   .
     1153               end.
     1154               leave replace-cycle.
     1155           end.
     1156           else do:
     1157               assign
     1158                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1159                   v-position      = v-last-position
     1160                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1161               .
     1162               if v-current-char = "#":U
     1163               then do:
     1164                   assign
     1165                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1166                   .
     1167                   if v-last-position > 0
     1168                   then do:
     1169                       run xmlchar-read-integer in this-procedure
     1170                        (
     1171                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1172                           , output v-temp-integer
     1173                           , output v-success
     1174                       ).
     1175                       if v-success = yes
     1176                       and v-temp-integer >= 1
     1177                       and v-temp-integer <= 255
     1178                       then do:
     1179                           assign
     1180                               p-out-string = p-out-string + chr( v-temp-integer )
     1181                               v-position   = v-last-position + 1
     1182                           .
     1183                       end.
     1184                       else do:
     1185                           assign
     1186                               p-out-string = p-out-string + "&":U
     1187                               v-position   = v-position   + 1
     1188                           .
     1189                       end.
     1190                   end.
     1191                   else do:
     1192                       assign
     1193                           p-out-string = p-out-string + "&":U
     1194                           v-position   = v-position   + 1
     1195                       .
     1196                   end.
     1197               end.
     1198               else do:
     1199                   case substring( p-in-string, v-position + 1, 3 )
     1200                   :
     1201                       when "lt;":U
     1202                       then do:
     1203                           assign
     1204                               p-out-string = p-out-string + "<":U
     1205                               v-position   = v-position   + 3
     1206                           .
     1207                       end.
     1208                       when "gt;":U
     1209                       then do:
     1210                           assign
     1211                               p-out-string = p-out-string + ">":U
     1212                               v-position   = v-position   + 3
     1213                           .
     1214                       end.
     1215                       otherwise do:
     1216                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1217                           then do:
     1218                               assign
     1219                                   p-out-string = p-out-string + "&":U
     1220                                   v-position   = v-position   + 4
     1221                               .
     1222                           end.
     1223                           else do:
     1224                               case substring( p-in-string, v-position + 1, 5 )
     1225                               :
     1226                                   when "quot;":U
     1227                                   then do:
     1228                                       assign
     1229                                           p-out-string = p-out-string + '"':U
     1230                                           v-position   = v-position   + 5
     1231                                       .
     1232                                   end.
     1233                                   when "apos;":U
     1234                                   then do:
     1235                                       assign
     1236                                           p-out-string = p-out-string + "'":U
     1237                                           v-position   = v-position   + 5
     1238                                       .
     1239                                   end.
     1240                                   otherwise do:
     1241                                       assign
     1242                                           p-out-string = p-out-string + "&":U
     1243                                       .
     1244                                   end.
     1245                               end case.
     1246                           end.
     1247                       end.
     1248                   end case.
     1249               end.
     1250           end.
     1251       end.
     1252   end.
     1253   end .
     1254   procedure xmlchar-read-integer :
     1255   define input parameter p-input-string      as character        no-undo.
     1256   define output parameter p-output-integer   as integer          no-undo.
     1257   define output parameter p-success       as logical          no-undo.
     1258   do
     1259   on error undo, return error
     1260   :
     1261       assign
     1262           p-output-integer = integer( p-input-string )
     1263       no-error.
     1264       if error-status :error
     1265       then do:
     1266           assign
     1267               p-success           = no
     1268               p-output-integer    = 0
     1269           .
     1270       end.
     1271       else do:
     1272           assign
     1273               p-success           = yes
     1274           .
     1275       end.
     1276   end.
     1277   end.
     1278   define variable vss-include-info5 as character format "X(65)" no-undo
     1279   initial "@(#)$Workfile$ $Revision$".
     1280   define temp-table temp_xmlparse-attrs no-undo
     1281   field field-name as character
     1282   field attr-code as character
     1283   field attr-value as character
     1284   index pi is unique primary
     1285   field-name attr-code
     1286   .
     1287   procedure xmlparse :
     1288   define input parameter p-handle         as handle           no-undo.
     1289   define input parameter p-XML-buffer     as character        no-undo.
     1290   define input parameter p-call-mode      as character        no-undo.
     1291       define variable v-procedure-type        as character    no-undo.
     1292       define variable v-procedure-name        as character    no-undo.
     1293       define variable v-temp-string           as character    no-undo.
     1294       define variable v-current-position      as integer      no-undo.
     1295       define variable v-end-position          as integer      no-undo.
     1296       define variable v-text-position         as integer      no-undo.
     1297       define variable v-input-buffer-length   as integer      no-undo.
     1298       define variable v-handle                as handle       no-undo.
     1299       define variable v-call-mode             as character    no-undo.
     1300       define variable v-proc-type             as character    no-undo.
     1301       define variable v-proc-name             as character    no-undo.
     1302       define variable v-decode-string         as character    no-undo.
     1303   do
     1304   on error undo, return error
     1305   :
     1306       if not valid-handle( p-handle )
     1307       then do:
     1308           return.
     1309       end.
     1310       assign
     1311           v-end-position          = 1
     1312           v-current-position      = 1
     1313           v-input-buffer-length   = length( p-XML-buffer )
     1314       .
     1315       do
     1316       while v-end-position < v-input-buffer-length
     1317       :
     1318           assign
     1319               v-current-position = index( p-XML-buffer, "<":U, v-end-position )
     1320           .
     1321           if v-current-position = 0
     1322           then do:
     1323               assign
     1324                   v-decode-string = substring( p-XML-buffer, v-end-position )
     1325               .
     1326               run xmlchar-decode in this-procedure (
     1327                     input v-decode-string
     1328                   , output v-temp-string
     1329               ).
     1330               assign
     1331                   v-handle     = p-handle
     1332                   v-call-mode  = p-call-mode
     1333                   v-proc-type  = 'text':U
     1334                   v-proc-name  = '':U
     1335               .
     1336               run run-callback-procedure in this-procedure (
     1337                     input v-handle
     1338                   , input v-call-mode
     1339                   , input v-proc-type
     1340                   , input v-proc-name
     1341                   , input v-temp-string
     1342               ).
     1343               assign
     1344                   v-end-position = v-input-buffer-length
     1345               .
     1346           end.
     1347           else do:
     1348               if v-current-position > v-end-position
     1349               then do:
     1350                   assign
     1351                       v-decode-string = substring( p-XML-buffer, v-end-position, v-current-position - v-end-position )
     1352                   .
     1353                   run xmlchar-decode in this-procedure (
     1354                         input v-decode-string
     1355                       , output v-temp-string
     1356                   ).
     1357                   assign
     1358                       v-end-position = v-current-position
     1359                   .
     1360                   assign
     1361                       v-handle     = p-handle
     1362                       v-call-mode  = p-call-mode
     1363                       v-proc-type  = 'text':U
     1364                       v-proc-name  = '':U
     1365                   .
     1366                   run run-callback-procedure in this-procedure (
     1367                         input v-handle
     1368                       , input v-call-mode
     1369                       , input v-proc-type
     1370                       , input v-proc-name
     1371                       , input v-temp-string
     1372                   ).
     1373               end.
     1374               assign
     1375                   v-decode-string = substring( p-XML-buffer, v-end-position + 1, 1 )
     1376               .
     1377               if v-decode-string = "/":U
     1378               then do:
     1379                   assign
     1380                       v-procedure-type    = "tag-end":U
     1381                       v-end-position      = v-current-position + 1
     1382                   .
     1383               end.
     1384               else do:
     1385                   assign
     1386                       v-procedure-type    = "tag-start":U
     1387                       v-end-position      = v-current-position
     1388                   .
     1389               end.
     1390               assign
     1391                   v-current-position  = index(p-XML-buffer, "/>":U, v-end-position)
     1392               .
     1393               if v-current-position <= v-end-position
     1394               then do:
     1395                   assign
     1396                       v-current-position  = index(p-XML-buffer, ">":U, v-end-position)
     1397                   .
     1398               end.
     1399               assign
     1400                   v-end-position      = v-end-position + 1
     1401               .
     1402               if v-current-position <= v-end-position
     1403               then do:
     1404                   run run-cb-xmlparse-error in this-procedure
     1405                                           (   input p-handle
     1406                                           ,   input 'Ошибка: знак < без завершающего > на той же строке'
     1407                                           ).
     1408                   assign
     1409                       v-temp-string   = "<":U + substring(p-XML-buffer, v-end-position)
     1410                       v-end-position  = v-input-buffer-length
     1411                   .
     1412                   assign
     1413                       v-handle     = p-handle
     1414                       v-call-mode  = p-call-mode
     1415                       v-proc-type  = 'text':U
     1416                       v-proc-name  = '':U
     1417                   .
     1418                   run run-callback-procedure in this-procedure (
     1419                         input v-handle
     1420                       , input v-call-mode
     1421                       , input v-proc-type
     1422                       , input v-proc-name
     1423                       , input v-temp-string
     1424                   ).
     1425               end.
     1426               else do:
     1427                   assign
     1428                       v-temp-string   = trim( substring(      p-XML-buffer
     1429                                                           ,   v-end-position
     1430                                                           ,   v-current-position - v-end-position
     1431                                             )          )
     1432                       v-text-position = index( v-temp-string, " ":U )
     1433                   .
     1434                   if v-text-position <> 0
     1435                   then do:
     1436                       assign
     1437                           v-procedure-name    =   trim( substring(      v-temp-string
     1438                                                                       ,   1
     1439                                                                       ,   v-text-position
     1440                                                         )          )
     1441                           v-temp-string       =   trim( substring(    v-temp-string
     1442                                                                   ,   v-text-position + 1
     1443                                                       )          )
     1444                       .
     1445                   end.
     1446                   else do:
     1447                       assign
     1448                           v-procedure-name    =   v-temp-string
     1449                           v-temp-string       =   "":U
     1450                       .
     1451                   end.
     1452                   assign
     1453                       v-end-position      = v-current-position + 1
     1454                   .
     1455                   assign
     1456                       v-handle          = p-handle
     1457                       v-call-mode       = p-call-mode
     1458                   .
     1459                   run run-callback-procedure in this-procedure (
     1460                         input v-handle
     1461                       , input v-call-mode
     1462                       , input v-procedure-type
     1463                       , input v-procedure-name
     1464                       , input v-temp-string
     1465                   ).
     1466               end.
     1467           end.
     1468       end.
     1469   end.
     1470   end procedure.
     1471   procedure run-callback-procedure :
     1472   define input parameter p-handle             as handle           no-undo.
     1473   define input parameter p-call-mode          as character        no-undo.
     1474   define input parameter p-procedure-type     as character        no-undo.
     1475   define input parameter p-procedure-name     as character        no-undo.
     1476   define input parameter p-param-value        as character        no-undo.
     1477       define variable v-data-type         as character            no-undo.
     1478       define variable v-data-value        as character            no-undo.
     1479       define variable v-procedure-name    as character            no-undo.
     1480       define variable v-procedure-exists  as logical      no-undo.
     1481   do
     1482   on error undo, return error
     1483   :
     1484       if p-call-mode = "call-all":U
     1485       or p-call-mode = "call-named":U
     1486       then do:
     1487           case p-procedure-type :
     1488               when "text":U
     1489               then do:
     1490                   assign
     1491                       v-procedure-name = "cb-xmlparse-text":U
     1492                   .
     1493               end.
     1494               when "tag-end":U
     1495               then do:
     1496                   assign
     1497                       v-procedure-name = "cb-xmlparse-tag-end-":U + p-procedure-name
     1498                   .
     1499               end.
     1500               when "tag-start":U
     1501               then do:
     1502                   assign
     1503                       v-procedure-name = "cb-xmlparse-tag-start-":U + p-procedure-name
     1504                   .
     1505               end.
     1506               otherwise do:
     1507                   assign
     1508                       v-procedure-name = p-procedure-name
     1509                   .
     1510               end.
     1511           end case.
     1512           if p-handle :get-signature( v-procedure-name ) = "":U
     1513           then do:
     1514               assign
     1515                   v-procedure-exists = no
     1516               .
     1517           end.
     1518           else do:
     1519               assign
     1520                   v-procedure-exists = yes
     1521               .
     1522           end.
     1523           if v-procedure-exists = yes
     1524           then do:
     1525               run value(v-procedure-name) in p-handle (input p-param-value) no-error.
     1526               if error-status :error
     1527               then do:
     1528                   run run-cb-xmlparse-error in this-procedure (
     1529                       input p-handle
     1530                       , input "Ошибка при вызове программы " + v-procedure-name
     1531                   ).
     1532               end.
     1533           end.
     1534       end.
     1535       if ( p-call-mode = "call-all":U
     1536           and v-procedure-exists <> yes )
     1537       or p-call-mode = "call-unnamed":U
     1538       then do:
     1539           case p-procedure-type :
     1540               when 'text':U
     1541               then do:
     1542                   assign
     1543                       v-data-type     = 'text':U
     1544                       v-data-value    = p-param-value
     1545                   .
     1546               end.
     1547               when 'tag-end':U
     1548               then do:
     1549                   assign
     1550                       v-data-type     = 'tag-end':U
     1551                       v-data-value    = p-procedure-name
     1552                   .
     1553               end.
     1554               when 'tag-start':U
     1555               then do:
     1556                   assign
     1557                       v-data-type     = 'tag-start':U
     1558                       v-data-value    = p-procedure-name
     1559                   .
     1560               end.
     1561               otherwise do:
     1562                   assign
     1563                       v-data-type     = 'text':U
     1564                       v-data-value    = p-procedure-name
     1565                   .
     1566               end.
     1567           end case.
     1568           run run-cb-xmlparse-procedure-not-found in this-procedure (
     1569                 input p-handle
     1570               , input v-data-type
     1571               , input v-data-value
     1572               , input p-param-value
     1573           ).
     1574       end.
     1575   end.
     1576   end procedure.
     1577   procedure run-cb-xmlparse-error :
     1578   do
     1579   on error undo, return error
     1580   :
     1581       def input parameter p-handle            as handle no-undo.
     1582       def input parameter p-error-message as char no-undo.
     1583       if lookup("cb-xmlparse-error", p-handle :internal-entries) > 0
     1584       then do:
     1585           run cb-xmlparse-error in p-handle  (input p-error-message).
     1586       end.
     1587   end.
     1588   end procedure.
     1589   procedure run-cb-xmlparse-procedure-not-found :
     1590   do
     1591   on error undo, return error
     1592   :
     1593       def input parameter p-handle            as handle no-undo.
     1594       def input parameter p-data-type         as char no-undo.
     1595       def input parameter p-data-value        as char no-undo.
     1596       def input parameter p-param-value       as char no-undo.
     1597       if lookup("cb-xmlparse-procedure-not-found", p-handle :internal-entries) > 0
     1598       then do:
     1599           run cb-xmlparse-procedure-not-found in p-handle    (   input p-data-type
     1600                                                             , input p-data-value
     1601                                                             , input p-param-value
     1602                                                           ) no-error.
     1603           if error-status :error
     1604           then do:
     1605               run run-cb-xmlparse-error in this-procedure
     1606                                       (   input p-handle
     1607                                       ,   input "Ошибка при вызове программы cb-xmlparse-procedure-not-found"
     1608                                       ).
     1609           end.
     1610       end.
     1611       else do:
     1612           run run-cb-xmlparse-error in this-procedure
     1613                                   (   input p-handle
     1614                                   ,   input "Ошибка: Не определена программа cb-xmlparse-procedure-not-found"
     1615                                   ).
     1616       end.
     1617   end.
     1618   end procedure.
     1619   procedure cb-xmlparse-attributes :
     1620   define input  parameter p-handle            as handle no-undo.
     1621   define input  parameter p-field-name        as character no-undo .
     1622   define input  parameter p-field-value       as character no-undo .
     1623   define variable ii as integer no-undo init 1.
     1624   define variable v-input-buffer-length   as integer no-undo.
     1625   define variable v-dc as logical no-undo .
     1626   define variable v-sc as logical no-undo .
     1627   define variable v-eq as logical no-undo .
     1628   define variable v-char as character no-undo .
     1629   define variable v-code as character no-undo .
     1630   define variable v-value as character no-undo .
     1631   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
     1632     do
     1633     on error undo, return error
     1634     :
     1635       if index(p-field-value, '>':U) > 0 then do:
     1636         run run-cb-xmlparse-error in this-procedure
     1637                                 (   input p-handle
     1638                                 ,   input substitute("Ошибка: тэг &1 содержит другие тэги", p-field-name)
     1639                                 ).
     1640       end.
     1641       assign
     1642       p-field-value = trim(p-field-value)
     1643       .
     1644       for each buf_temp_xmlparse-attrs where
     1645               buf_temp_xmlparse-attrs.field-name = p-field-name:
     1646         delete buf_temp_xmlparse-attrs.
     1647       end.
     1648       assign
     1649       v-input-buffer-length = length( p-field-value )
     1650       .
     1651       do while ii <= v-input-buffer-length:
     1652         assign
     1653         v-char = substr(p-field-value, ii, 1)
     1654         ii = ii + 1
     1655         .
     1656         CASE v-char:
     1657           when "=":U then do:
     1658             if v-eq
     1659             and not v-dc
     1660             and not v-sc then do:
     1661               return error.
     1662             end.
     1663             assign
     1664             v-eq = yes
     1665             .
     1666           end.
     1667           when chr(34) then do:
     1668           if v-eq then
     1669           assign
     1670           v-dc = not(v-dc)
     1671           .
     1672           else return error.
     1673           end.
     1674           when chr(39) then do:
     1675           if v-eq then
     1676           assign
     1677           v-sc = not(v-sc)
     1678           .
     1679           else return error.
     1680           end.
     1681           when chr(32) then do:
     1682             if not v-dc
     1683             and not v-sc
     1684             then do:
     1685               assign
     1686               v-sc = no
     1687               v-dc = no
     1688               v-eq = no
     1689               .
     1690               create buf_temp_xmlparse-attrs.
     1691               assign
     1692               buf_temp_xmlparse-attrs.field-name = p-field-name
     1693               buf_temp_xmlparse-attrs.attr-code  = v-code
     1694               buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
     1695               v-code = "":U
     1696               v-value = "":U
     1697               .
     1698             end.
     1699           end.
     1700         END CASE.
     1701         if not v-eq
     1702         then do:
     1703           if not v-char = chr(32) then
     1704           assign
     1705           v-code = v-code + v-char
     1706           .
     1707         end.
     1708         else do:
     1709           if v-char <> "=":U
     1710           then
     1711           assign
     1712           v-value = v-value + v-char
     1713           .
     1714         end.
     1715       end.
     1716       if v-code <> "":U then do:
     1717         create buf_temp_xmlparse-attrs.
     1718         assign
     1719         buf_temp_xmlparse-attrs.field-name = p-field-name
     1720         buf_temp_xmlparse-attrs.attr-code  = v-code
     1721         buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
     1722         .
     1723       end.
     1724     end.
     1725   end procedure.
     1726   FUNCTION cb-xmlparse-get-attr returns character (
     1727         input p-handle        as handle
     1728       , input p-field-name    as character
     1729       , input p-field-value   as character
     1730       , input p-attr-code     as character
     1731       , input p-reparse       as logical
     1732   ) :
     1733   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
     1734     do
     1735     on error undo, return error
     1736     :
     1737       if p-reparse then do:
     1738         run cb-xmlparse-attributes in this-procedure (
     1739                                                       input p-handle
     1740                                                     , input p-field-name
     1741                                                     , input p-field-value) no-error .
     1742         if error-status:error then return ? .
     1743       end.
     1744       find first buf_temp_xmlparse-attrs no-lock where
     1745                 buf_temp_xmlparse-attrs.field-name = p-field-name
     1746             AND buf_temp_xmlparse-attrs.attr-code   = p-attr-code no-error .
     1747       if not avail buf_temp_xmlparse-attrs then return ?.
     1748       return buf_temp_xmlparse-attrs.attr-value.
     1749     end.
     1750   end FUNCTION.
     1751   FUNCTION cb-xmlparse-get-date returns date (
     1752                                               input p-string as character):
     1753   define variable v-date as date.
     1754   if index(p-string, "-":U) = 0
     1755   or NOT (length(p-string) = 10
     1756           or
     1757           length(p-string) = 19)
     1758   then return error.
     1759   assign
     1760   v-date =  date(
     1761             int( substr( p-string, 6, 2 ) ) ,
     1762             int( substr( p-string, 9, 2 ) ),
     1763             int( substr( p-string, 1, 4 ) )
     1764               )
     1765   no-error .
     1766   if error-status:error then return error.
     1767   return v-date.
     1768   END FUNCTION.
     1769   FUNCTION cb-xmlparse-get-time returns integer (input p-string as character):
     1770   define variable v-time as integer no-undo .
     1771   define variable v-shift as integer no-undo .
     1772   if index(p-string, ":":U) = 0
     1773   or not (
     1774           length(p-string) = 19
     1775           or
     1776           length(p-string) = 8
     1777           )
     1778   then return error.
     1779   if length(p-string) = 19 then v-shift = 11.
     1780   assign
     1781   v-time =  int( substr( p-string, v-shift + 1, 2 ) ) * 3600 +
     1782             int( substr( p-string, v-shift + 4, 2 ) ) * 60  +
     1783             int( substr( p-string, v-shift + 7, 2) )
     1784   no-error .
     1785   if error-status:error then return error.
     1786   return v-time.
     1787   END FUNCTION.
     1788   define variable vss-include-info6 as character format "X(65)" no-undo
     1789   initial "@(#)$Workfile$ $Revision$".
     1790   define variable v-xmlvalid-error-mode       as character    no-undo.
     1791   define variable v-xmlvalid-tag-value        as character    no-undo.
     1792   define variable v-xmlvalid-current-level    as integer      no-undo.
     1793   define variable v-xmlvalid-in-tag           as logical      no-undo.
     1794   define variable v-xmlvalid-read-vartype     as logical      no-undo.
     1795   define temp-table temp_xmlvalid-taglist no-undo
     1796       field level-num as integer
     1797       field tag-name  as character
     1798       index lv  is primary unique level-num
     1799   .
     1800   define temp-table temp_xmlvalid-field-types no-undo
     1801       field field-name as character
     1802       field field-type as character
     1803       index fn is primary unique field-name
     1804   .
     1805   procedure xmlvalid :
     1806     do
     1807     on error undo, return error
     1808     :
     1809       def input parameter p-handle                as handle   no-undo.
     1810       def input parameter p-buffer-string         as char     no-undo.
     1811       def input parameter p-xmlvalid-error-mode   as char     no-undo.
     1812       assign
     1813           v-xmlvalid-error-mode   = p-xmlvalid-error-mode
     1814       .
     1815       run xmlparse in this-procedure (
     1816                 input p-handle
     1817               , input p-buffer-string
     1818               , input "call-all":U
     1819       ).
     1820     end.
     1821   end procedure.
     1822   procedure cb-xmlparse-tag-start-varType :
     1823   do
     1824   on error undo, return error
     1825   :
     1826   define input parameter p-param as character    no-undo.
     1827       assign
     1828           v-xmlvalid-read-vartype = yes
     1829       .
     1830       run cb-xmlparse-procedure-not-found in this-procedure (
     1831             input "tag-start":U
     1832           , input "varType":U
     1833           , input p-param
     1834       ).
     1835   end.
     1836   end procedure.
     1837   procedure cb-xmlparse-tag-end-varType :
     1838   do
     1839   on error undo, return error
     1840   :
     1841   define input parameter p-param as character    no-undo.
     1842       assign
     1843           v-xmlvalid-read-vartype = no
     1844       .
     1845       define variable v-vartype-list     as character         no-undo.
     1846       for each temp_xmlvalid-field-types
     1847       :
     1848           if index( "character,integer,decimal,date,logical", temp_xmlvalid-field-types.field-type ) = 0
     1849           then do:
     1850               run run-cb-xmlvalid-error  in this-procedure
     1851                                           (     input this-procedure :handle
     1852                                               , input "Замечание: Тип переменной в секции varType определен неверно. "
     1853                                                       + "Тэг " + temp_xmlvalid-field-types.field-name
     1854                                                       + " не будет проверен на соответствие типу данных"
     1855                                           ).
     1856               delete temp_xmlvalid-field-types.
     1857           end.
     1858           else do:
     1859                                           assign
     1860                                               v-vartype-list = v-vartype-list + temp_xmlvalid-field-types.field-name
     1861                                               + temp_xmlvalid-field-types.field-type + chr(10)
     1862                                           .
     1863           end.
     1864       end.
     1865       run cb-xmlparse-procedure-not-found in this-procedure (
     1866                                           input "tag-end":U
     1867                                           , input "varType":U
     1868                                           , input p-param
     1869                                                           ).
     1870   end.
     1871   end procedure.
     1872   procedure cb-xmlparse-procedure-not-found :
     1873   do
     1874   on error undo, return error
     1875   :
     1876   def input parameter p-tag-type      as char no-undo.
     1877   def input parameter p-tag-value     as char no-undo.
     1878   def input parameter p-param-value   as char no-undo.
     1879   def buffer buf_temp_xmlvalid-taglist for temp_xmlvalid-taglist.
     1880   def var v-found    as logical  no-undo.
     1881   if p-tag-type = "tag-start"
     1882   then do:
     1883       assign
     1884           v-xmlvalid-current-level = v-xmlvalid-current-level + 1
     1885           v-xmlvalid-in-tag        = yes
     1886       .
     1887       find first temp_xmlvalid-taglist
     1888            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1889       no-error.
     1890       if not available temp_xmlvalid-taglist
     1891       then do:
     1892           create temp_xmlvalid-taglist.
     1893           assign
     1894               temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1895           .
     1896       end.
     1897       assign
     1898           temp_xmlvalid-taglist.tag-name = p-tag-value
     1899           v-xmlvalid-tag-value = ""
     1900       .
     1901       if v-xmlvalid-read-vartype = yes and p-tag-value <> "varType":U
     1902       then do:
     1903           find first temp_xmlvalid-field-types
     1904                where temp_xmlvalid-field-types.field-name = p-tag-value
     1905           no-error.
     1906           if available temp_xmlvalid-field-types
     1907           then do:
     1908               run run-cb-xmlvalid-error  in this-procedure
     1909                                           (     input this-procedure :handle
     1910                                               , input "Замечание: Тип переменной в секции varType определен повторно"
     1911                                           ).
     1912           end.
     1913           else do:
     1914               create temp_xmlvalid-field-types.
     1915               assign
     1916                   temp_xmlvalid-field-types.field-name = p-tag-value
     1917               .
     1918           end.
     1919       end.
     1920   end.
     1921   if p-tag-type = "tag-end"
     1922   then do:
     1923       find first temp_xmlvalid-taglist
     1924            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1925              and temp_xmlvalid-taglist.tag-name  = p-tag-value
     1926       no-error.
     1927       if available temp_xmlvalid-taglist
     1928       then do:
     1929           assign
     1930               v-xmlvalid-current-level = v-xmlvalid-current-level - 1
     1931               v-xmlvalid-in-tag        = no
     1932           .
     1933       end.
     1934       else do:
     1935           if v-xmlvalid-error-mode = 'fatal'
     1936           then do:
     1937               run run-cb-xmlvalid-error  in this-procedure
     1938                                           (     input this-procedure :handle
     1939                                               , input "Ошибка: Попытка закрыть не открытый тэг"
     1940                                           ).
     1941           end.
     1942           else do:
     1943               find first temp_xmlvalid-taglist
     1944                    where temp_xmlvalid-taglist.tag-name = p-tag-value
     1945               no-error.
     1946               if not available temp_xmlvalid-taglist
     1947               then do:
     1948                   assign
     1949                       v-xmlvalid-tag-value = v-xmlvalid-tag-value + "</" + p-tag-value + ">" + chr(10)
     1950                   .
     1951               end.
     1952               else do:
     1953                   for each buf_temp_xmlvalid-taglist
     1954                      where buf_temp_xmlvalid-taglist.level-num > temp_xmlvalid-taglist.level-num
     1955                   :
     1956                       assign
     1957                           v-xmlvalid-tag-value = "<" + buf_temp_xmlvalid-taglist.tag-name + ">" + chr(10) + v-xmlvalid-tag-value
     1958                           v-xmlvalid-current-level = temp_xmlvalid-taglist.level-num - 1
     1959                       .
     1960                   end.
     1961               end.
     1962           end.
     1963       end.
     1964   end.
     1965   if p-tag-type = "text"
     1966   then do:
     1967       if v-xmlvalid-read-vartype = yes
     1968       then do:
     1969           if available temp_xmlvalid-field-types
     1970           then do:
     1971               assign
     1972                   temp_xmlvalid-field-types.field-type = v-xmlvalid-tag-value
     1973               .
     1974           end.
     1975       end.
     1976       else do:
     1977           find first temp_xmlvalid-field-types
     1978               where temp_xmlvalid-field-types.field-name = temp_xmlvalid-taglist.tag-name
     1979           no-error.
     1980           if available temp_xmlvalid-field-types
     1981           then do:
     1982           end.
     1983           else do:
     1984           end.
     1985       end.
     1986       assign
     1987           v-xmlvalid-tag-value = v-xmlvalid-tag-value + p-tag-value
     1988       .
     1989   end.
     1990   run run-cb-xmlvalid-procedure-not-found in this-procedure
     1991                                           (     input this-procedure :handle
     1992                                               , input p-tag-type
     1993                                               , input p-tag-value
     1994                                               , input p-param-value
     1995                                           ).
     1996   end.
     1997   end procedure.
     1998   procedure run-cb-xmlvalid-procedure-not-found :
     1999   do
     2000   on error undo, return error
     2001   :
     2002       def input parameter p-handle            as handle   no-undo.
     2003       def input parameter p-data-type         as char     no-undo.
     2004       def input parameter p-data-value        as char     no-undo.
     2005       def input parameter p-param-value       as char     no-undo.
     2006       if lookup("cb-xmlvalid-procedure-not-found", p-handle :internal-entries) > 0
     2007       then do:
     2008           run cb-xmlvalid-procedure-not-found in p-handle (   input p-data-type
     2009                                                             , input p-data-value
     2010                                                             , input p-param-value
     2011                                                           ) no-error.
     2012           if error-status :error
     2013           then do:
     2014               run run-cb-xmlvalid-error in this-procedure
     2015                                       (   input p-handle
     2016                                       ,   input "Ошибка при вызове программы cb-xmlvalid-procedure-not-found"
     2017                                       ).
     2018           end.
     2019       end.
     2020       else do:
     2021           run run-cb-xmlvalid-error in this-procedure
     2022                                   (   input p-handle
     2023                                   ,   input "Ошибка: Не определена программа cb-xmlvalid-procedure-not-found"
     2024                                   ).
     2025       end.
     2026   end.
     2027   end procedure.
     2028   procedure run-cb-xmlvalid-error :
     2029   do
     2030   on error undo, return error
     2031   :
     2032       def input parameter p-handle            as handle no-undo.
     2033       def input parameter p-error-message as char no-undo.
     2034       if lookup("cb-xmlvalid-error", p-handle :internal-entries) > 0
     2035       then do:
     2036           run cb-xmlvalid-error in p-handle  (input p-error-message).
     2037       end.
     2038   end.
     2039   end procedure.
     2040   procedure run-cb-xmlvalid-procedure :
     2041   do
     2042   on error undo, return error
     2043   :
     2044   def input parameter p-handle            as handle no-undo.
     2045   def input parameter p-procedure-name    as char no-undo.
     2046   def var v-data-type     as char no-undo.
     2047   def var v-data-value    as char no-undo.
     2048   def var v-param-value   as char no-undo.
     2049       if lookup( p-procedure-name, p-handle :internal-entries) > 0
     2050       then do:
     2051           run value(p-procedure-name) in p-handle no-error.
     2052           if error-status :error
     2053           then do:
     2054               run run-cb-xmlvalid-error in this-procedure
     2055                                       (   input p-handle
     2056                                       ,   input "Ошибка при вызове программы " + p-procedure-name
     2057                                       ).
     2058           end.
     2059       end.
     2060       else do:
     2061           if substring(p-procedure-name, 1, 20) = "cb-xmlvalid-tag-end-"
     2062           then do:
     2063               assign
     2064                   v-data-type     = "tag-end"
     2065                   v-data-value    = substring(p-procedure-name, 21)
     2066               .
     2067           end.
     2068           else do:
     2069               if substring(p-procedure-name, 1, 22) = "cb-xmlvalid-tag-start-"
     2070               then do:
     2071                   assign
     2072                       v-data-type     = "tag-start"
     2073                       v-data-value    = substring(p-procedure-name, 23)
     2074                   .
     2075               end.
     2076               else do:
     2077                   assign
     2078                       v-data-type     = "text"
     2079                       v-data-value    = p-procedure-name
     2080                   .
     2081               end.
     2082           end.
     2083           run run-cb-xmlvalid-procedure-not-found in this-procedure
     2084                                                  (   input p-handle
     2085                                                     , input v-data-type
     2086                                                     , input v-data-value
     2087                                                     , input v-param-value
     2088                                                   ).
     2089       end.
     2090   end.
     2091   end procedure.
     2092   define stream stmXMLOut.
     2093   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2094   define variable v-xml-file-name     as character            no-undo.
     2095   define variable v-xml-file-name-path as character            no-undo.
     2096   define variable v-log-file-name     as character            no-undo.
     2097   define variable v-locked            as logical              no-undo.
     2098   define variable v-log-string        as character            no-undo.
     2099   define variable v-oper-num          as integer              no-undo.
     2100   define variable v-obj-list          as character            no-undo.
     2101   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2102   DEF VAR intRep      AS INT NO-UNDO.
     2103   define variable hEDT             AS HANDLE NO-UNDO.
     2104   define variable hCNT             AS HANDLE NO-UNDO.
     2105   procedure xml-cd-write-header:
     2106   do
     2107   on error undo, return error
     2108   :
     2109   define input parameter p-xml-file-name       as character    no-undo.
     2110   define input parameter p-xml-file-name-path  as character    no-undo.
     2111   define input parameter p-doc-name            as character    no-undo.
     2112   define input parameter p-version             as character    no-undo.
     2113   define input parameter p-obj-list            as character    no-undo.
     2114   define input parameter p-correspondent       as character    no-undo .
     2115   define input parameter p-write-header        as logical      no-undo .
     2116   define variable OS-time as character no-undo .
     2117   define variable id as character no-undo .
     2118   define buffer buf_db for ub.db.
     2119   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2120   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2121   assign
     2122   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2123   .
     2124   run bgelib-tag-open in this-procedure (
     2125                                        1
     2126                                       ,p-doc-name
     2127                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2128                                         ).
     2129   if p-write-header then do:
     2130     run bgelib-tag-open(2, "Header","").
     2131     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2132     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2133     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2134     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2135     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2136     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2137     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2138     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2139     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2140     run bgelib-tag-close( 2, "Header" ).
     2141   end.
     2142   output stream stmXMLOut close.
     2143   end.
     2144   end procedure.
     2145   procedure xml-cd-write-footer:
     2146   do
     2147   on error undo, return error
     2148   :
     2149   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2150   define input parameter p-xml-file-name as character    no-undo.
     2151   define input parameter p-doc-name      as character    no-undo .
     2152   define variable v-error-num     as integer           no-undo.
     2153   define variable v-md5-signature as character no-undo .
     2154   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2155   run bgelib-tag-close( 0, p-doc-name ).
     2156   put stream stmXMLOut unformatted skip.
     2157   output stream stmXMLOut close.
     2158   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2159   if v-error-num > 0
     2160   then do:
     2161      return error.
     2162   end.
     2163   if opsys = "unix"
     2164   then do:
     2165       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2166   end.
     2167   end.
     2168   end procedure.
     2169   procedure xml-cd-filename :
     2170   do
     2171   on error undo, return error
     2172   :
     2173   define input parameter  p-out               as character no-undo .
     2174   define output parameter p-xml-file-name     as character    no-undo.
     2175   define output parameter p-xml-file-name-path   as character    no-undo.
     2176   define output parameter p-log-file-name     as character    no-undo.
     2177   define output parameter p-locked            as logical      no-undo.
     2178   define variable v-out as character     no-undo.
     2179   define variable loc#log as logical no-undo .
     2180   define variable BadFlag as logical no-undo .
     2181   define variable fq as integer no-undo .
     2182   define variable v-remote as character no-undo .
     2183   assign
     2184   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2185   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2186   p-log-file-name = p-out + "actions.log"
     2187   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2188   .
     2189   end.
     2190   end procedure.
     2191   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2192   define variable v-date-str as character no-undo .
     2193   assign
     2194   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2195                string(Month(p-date), "99":U) + "-":U +
     2196                string(DAY(p-date), "99":U).
     2197   return v-date-str.
     2198   END FUNCTION.
     2199   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2200   define variable v-date-str as character no-undo .
     2201   assign
     2202   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2203                string(Month(p-date), "99":U) + "-":U +
     2204                string(DAY(p-date), "99":U) + chr(32) +
     2205                string(p-time, "HH:MM:SS").
     2206   return v-date-str.
     2207   END FUNCTION.
     2208   function string-to-date returns date ( input p-string  as character):
     2209     define variable v-date as date no-undo .
     2210     assign
     2211     v-date = date(integer(substring(p-string, 4, 2))
     2212                   ,integer(substring(p-string, 1, 2))
     2213                   ,integer(substring(p-string, 7, 4))
     2214                  ) no-error .
     2215     if error-status:error then return ?.
     2216     return v-date.
     2217   END FUNCTION.
     2218   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2219   define variable v-time as integer no-undo init ?.
     2220   define variable v-dop1 as character no-undo .
     2221   define variable v-dop2 as character no-undo .
     2222   assign
     2223   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2224   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2225   no-error .
     2226   if error-status:error then return ?.
     2227   assign
     2228   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2229             integer(entry(2, v-dop2, ";":U)) * 60 +
     2230             integer(entry(3, v-dop2, ";":U)) no-error .
     2231   return v-time.
     2232   END FUNCTION.
     2233   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     2235   def var vl_bin as char no-undo init "".
     2236   if vl_int < 0 OR vl_int = ? then return ?.
     2237   do while vl_int > 0:
     2238     assign
     2239     vl_bin = (if vl_int modulo 2 = 0
     2240                 then "0":U
     2241                 else "1":U) + vl_bin
     2242     vl_int = truncate(vl_int / 2,0).
     2243   end.
     2244   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     2245   END FUNCTION.
     2246   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     2247                                    input vl_binm as character):
     2248   DEFINE VARIABLE vl_bin as character no-undo.
     2249   DEFINE VARIABLE ii as integer no-undo.
     2250   DEFINE VARIABLE ii-len as integer no-undo.
     2251   DEFINE VARIABLE ii-lenm as integer no-undo.
     2252   DEFINE VARIABLE mchar as character no-undo.
     2253   DEFINE VARIABLE ichar as character no-undo.
     2254   if vl_binm = ? then return ?.
     2255   vl_bin = CIntBinS(vl_int).
     2256   if vl_bin = ? then return ?.
     2257   assign
     2258   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     2259   ii-lenm = LENGTH(vl_binm)
     2260   ii-len = LENGTH(vl_bin) - ii-lenm
     2261   .
     2262   if II-LENM > 32 THEN RETURN ?.
     2263   DO II = 1 to II-LENm:
     2264     assign
     2265     mchar = SUBSTR(vl_binm, ii, 1)
     2266     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     2267     .
     2268     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     2269     IF ichar <> mchar AND mchar <> "X":U then return no.
     2270   END.
     2271   return yes.
     2272   END FUNCTION.
