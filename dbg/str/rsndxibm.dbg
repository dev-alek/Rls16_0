     2890   define variable ErrorMessage as character no-undo.
     2891   define variable mOk as logical no-undo.
     2892   define variable mtagbeg as int64  no-undo.
     2893   define variable mtagend as int64 no-undo.
     2894   procedure get-xml-ibm-c-buff-or-file.
     2895      define input parameter p-Type as character  no-undo.
     2896      define input parameter p-str  as longchar   no-undo.
     2897      define variable hParser as handle no-undo.
     2898      mtagbeg = 0.
     2899      mtagend = 0.
     2900      create sax-reader hParser.
     2901      if p-Type eq "file"
     2902      then
     2903         hParser:set-input-source(p-Type, string(p-str)).
     2904      else do:
     2905         if p-Type = "longchar"
     2906         then do:
     2907            define variable vmemptr as memptr no-undo.
     2908            copy-lob p-str to vmemptr.
     2909            hParser:set-input-source("memptr", vmemptr).
     2910         end.
     2911         else
     2912            hParser:set-input-source(p-Type, p-str).
     2913      end.
     2914      hParser:sax-parse () no-error.
     2915      if error-status:error then do:
     2916         delete object hParser.
     2917         if error-status:num-messages > 0
     2918         then do:
     2919             run write-log-and-file in p-log-handle (
     2920              input 1
     2921            , input log-file-name
     2922            , input 1
     2923            , input substitute( "!!!При  произошла ошибка при получении полного пути файлу: &1 &2"
     2924                                , ErrorMessage
     2925                                , return-value
     2926                              )
     2927                                        ).
     2928             return error error-status:get-message(1).
     2929         end.
     2930         else do:
     2931              return error return-value.
     2932         end.
     2933      end.
     2934      delete object hParser.
     2935      if ErrorMessage <> ""
     2936      then do:
     2937         run write-log-and-file in p-log-handle (
     2938              input 1
     2939            , input log-file-name
     2940            , input 1
     2941            , input substitute( "!!!При  произошла ошибка при получении полного пути файлу: &1 "
     2942                                , ErrorMessage
     2943                              )
     2944                                        ).
     2945         return error ErrorMessage .
     2946      end.
     2947   end.
     2948   procedure StartDocument:
     2949   end procedure.
     2950   procedure StartElement:
     2951      define input parameter namespaceURI as character.
     2952      define input parameter localName    as character.
     2953      define input parameter qname        as character.
     2954      define input parameter ihAttributes as handle.
     2955      define variable v-attr-num    as integer   no-undo.
     2956      define variable v-temp-string as character no-undo.
     2957      do v-attr-num = 1 to ihAttributes:num-items:
     2958         v-temp-string = substitute ('&1 &2="&3"',
     2959                                     v-temp-string,
     2960                                     ihAttributes:get-qname-by-index(v-attr-num),
     2961                                     ihAttributes:get-value-by-index(v-attr-num)).
     2962      end.
     2963      v-temp-string = trim(v-temp-string).
     2964        mtagbeg =  mtagbeg + 1.
     2965       run run-callback-procedure in this-procedure (
     2966                         input this-procedure:handle
     2967                       , input "call-all":U
     2968                       , input "tag-start"
     2969                       , input qname
     2970                       , input v-temp-string
     2971                   ).
     2972   end procedure.
     2973   define variable mcurrentContent as character no-undo.
     2974   procedure Characters:
     2975       define input parameter charData as memptr.
     2976       define input parameter numChars as integer.
     2977       define variable mcurrentContent as character no-undo.
     2978       mcurrentContent = get-string(charData, 1, get-size(charData)).
     2979       run run-callback-procedure in this-procedure (
     2980                         input this-procedure:handle
     2981                       , input "call-all":U
     2982                       , input "text"
     2983                       , input ""
     2984                       , input mcurrentContent
     2985                   ).
     2986   end procedure.
     2987   procedure EndElement:
     2988   define input parameter name_     as character.
     2989   define input parameter localName as character.
     2990   define input parameter qName     as character.
     2991       if qname = "ErrorMessage" then do:
     2992         ErrorMessage = mcurrentContent.
     2993         self:stop-parsing ().
     2994       end.
     2995       mtagend = mtagend + 1.
     2996       if mtagend mod 100 = 0 or qName eq "check"
     2997       then do:
     2998         run show-counter in p-log-handle .
     2999         run write-counter in p-log-handle (substitute("Прочитано открытых тегов &1 из них закрытых &2", mtagbeg, mtagend)).
     3000       end.
     3001       run run-callback-procedure in this-procedure (
     3002                         input this-procedure:handle
     3003                       , input "call-all":U
     3004                       , input "tag-end"
     3005                       , input qname
     3006                       , input ""
     3007                   ).
     3008   end procedure.
     3009   procedure EndDocument:
     3010       run hide-counter in p-log-handle .
     3011       mOk = true.
     3012   end procedure.
     3013   procedure Warning:
     3014       define input parameter ErrMessage as character no-undo.
     3015       message "The following WARNING was generated:~n" + ErrMessage
     3016           view-as alert-box information buttons ok.
     3017   end procedure.
     3018   procedure Error:
     3019       define input parameter ErrMessage as character no-undo.
     3020       mOk = false.
     3021       message "The following NONFATAL ERROR was generated:~n" + ErrMessage
     3022           view-as alert-box information buttons ok.
     3023   end procedure.
     3024   procedure FatalError:
     3025       define input parameter ErrMessage as character no-undo.
     3026       mOk = false.
     3027       return error "The following FATAL ERROR was generated:~n" + ErrMessage.
     3028   end procedure.
     3029   PROCEDURE get-xml-ibm-c.
     3030   define input parameter p-filename as char no-undo.
     3031   define variable v-new-filename-full     as character         no-undo.
     3032   define variable v-xml-buffer as character no-undo.
     3033   define variable v-my-string as character no-undo .
     3034   define variable v-read-char as character no-undo .
     3035   define buffer buf_cash-desk for ub.cash-desk.
     3036   error-status:error = FALSE.
     3037   run gbl/fileapnd.p
     3038     ( input p-filename
     3039      ,input ""
     3040      ,input 5
     3041     ) no-error .
     3042   if error-status:error then do:
     3043      run write-log-and-file in p-log-handle (
     3044          input 1
     3045        , input log-file-name
     3046        , input 1
     3047        , input return-value
     3048        ).
     3049      assign
     3050         p-view-log = yes
     3051         .
     3052      undo, return.
     3053   end.
     3054   if p-encoding = "utf-8":U  then  do:
     3055     input stream ChkStream from value( p-filename ) convert source "utf-8".
     3056   end.
     3057   else do:
     3058     input stream ChkStream from value( p-filename ) .
     3059   end.
     3060   _repeat:
     3061   REPEAT :
     3062     if v-exit-processing then leave _repeat.
     3063     _line:
     3064     DO TRANSACTION:
     3065       import stream Chkstream unformatted  v-xml-buffer  .
     3066       if v-xml-buffer = "":U then do:
     3067         NEXT _repeat.
     3068       end.
     3069       assign
     3070       var-file-line-num = var-file-line-num + 1
     3071       .
     3072       if left-trim(v-xml-buffer)  begins "<?xml":U then do:
     3073         assign
     3074         v-encoding = cb-xmlparse-get-attr(
     3075                                 input this-procedure:handle
     3076                                ,input "xml":U
     3077                                ,input trim(v-xml-buffer, "?>")
     3078                                ,input "encoding":U
     3079                                ,input yes)
     3080        .
     3081        if v-encoding <> p-encoding
     3082        then do:
     3083           run write-log-and-file in p-log-handle (
     3084                 input 1
     3085               , input log-file-name
     3086               , input 1
     3087               , input substitute( "!!!Ошибка чтения файла &1: кодировка НЕ &2"
     3088                                   , p-filename
     3089                                   , p-encoding
     3090                                 )
     3091                                               ).
     3092         assign
     3093         p-view-log = yes
     3094         .
     3095         undo, return .
     3096        end.
     3097       end.
     3098       run xmlvalid in this-procedure (
     3099             input this-procedure:handle
     3100           , input v-xml-buffer
     3101           , input 'fatal':u
     3102       ) no-error .
     3103       if error-status:error  then do:
     3104           run write-log-and-file in p-log-handle (
     3105                 input 1
     3106               , input log-file-name
     3107               , input 1
     3108               , input substitute( "!!!Ошибка импорта файла &1: &2"
     3109                                   , p-filename
     3110                                   , return-value
     3111                                 )
     3112                                               ).
     3113         assign
     3114         p-view-log = yes
     3115         .
     3116         undo, return .
     3117       end.
     3118       if v-cd-fatal-error then do:
     3119         run write-log-and-file in p-log-handle (
     3120               input 1
     3121             , input log-file-name
     3122             , input 1
     3123             , input substitute( "!!!Файл &1 строка &2 фатальные ошибки: &3 - импорт прекращен"
     3124                                 , p-filename
     3125                                 , var-file-line-num
     3126                                 , v-cd-fatal-message
     3127                               )
     3128                                             ).
     3129         assign
     3130         p-view-log = yes
     3131         .
     3132         undo, return.
     3133       end.
     3134       if var-file-line-num modulo 100 = 0 then do:
     3135         run show-counter in p-log-handle .
     3136         run write-counter in p-log-handle (substitute("Файл &1: прочитано строк &2", p-filename, var-file-line-num)).
     3137       end.
     3138     END .
     3139   end.
     3140   input stream ChkStream close.
     3141   END PROCEDURE.
     3142   procedure cb-xmlparse-tag-start-Header :
     3143   do
     3144   on error undo, return error
     3145   :
     3146     assign
     3147         v-mail-parameters-start = yes
     3148     .
     3149   end.
     3150   end procedure.
     3151   procedure cb-xmlparse-tag-end-Header :
     3152   do
     3153   on error undo, return error
     3154   :
     3155     assign
     3156         v-mail-parameters-start = no
     3157     .
     3158   end.
     3159   end procedure.
     3160   procedure cb-xmlparse-tag-start-ignoriruem :
     3161   define input parameter p-parameter as character no-undo .
     3162   define variable v-file-type as character no-undo .
     3163   define variable v-adresat as character no-undo .
     3164   define variable v-FO-version as character no-undo .
     3165   define variable v-OptVersion as character no-undo .
     3166   define variable v-OptVersion1 as character no-undo .
     3167   define variable v-OptVersion2 as character no-undo .
     3168   define variable v-OptVersion3 as character no-undo .
     3169   define variable v-OptVersion4 as character no-undo .
     3170   define variable v-OptVer      as character no-undo .
     3171   define variable v-old-fo-version as character no-undo .
     3172   define variable v-pay-desk as integer no-undo .
     3173   define variable v-dop as character no-undo .
     3174   define buffer cash-desk for ub.cash-desk.
     3175   define variable v-date as date no-undo .
     3176   define variable v-decimal as decimal no-undo .
     3177   define variable v-integer as integer no-undo .
     3178   define variable v-logical as logical no-undo .
     3179   define variable v-err-message as character no-undo .
     3180   do
     3181   on error undo, return error
     3182   :
     3183     if v-is-spool-file = no then do:
     3184       IF INDEX(p-parameter,"OptVersion") > 0 THEN v-OptVer = 'OptVer'.
     3185       assign
     3186       v-file-type = cb-xmlparse-get-attr(
     3187                                 input this-procedure:handle
     3188                                ,input p-spool-or-data
     3189                                ,input p-parameter
     3190                                ,input "type":U
     3191                                ,input yes)
     3192       v-adresat =  cb-xmlparse-get-attr(
     3193                                 input this-procedure:handle
     3194                                ,input p-spool-or-data
     3195                                ,input p-parameter
     3196                                ,input "to":U
     3197                                ,input no)
     3198       .
     3199       if v-file-type = "REPLY":U AND
     3200       (v-adresat begins ('маг':U + string(p-obj-code))
     3201       )
     3202       then do:
     3203         assign
     3204         v-is-spool-file = yes
     3205         .
     3206         if v-from begins ('маг':U + string(p-obj-code) + "_" + "касса") then do:
     3207           v-pay-desk = ?.
     3208           v-pay-desk = integer(replace(v-from, ('маг':U + string(p-obj-code) + "_" + "касса"), "")) no-error.
     3209           assign
     3210              m-head-db-num    = ?
     3211              m-head-obj-code  = ?
     3212              m-head-pos-type  = ?
     3213              m-head-cash-num  = ?
     3214           .
     3215           find first cash-desk where
     3216                            cash-desk.db-num = g#db-num
     3217                        and cash-desk.obj-code = p-obj-code
     3218                        and cash-desk.cash-num = v-pay-desk
     3219           no-lock no-error.
     3220           if available cash-desk
     3221           then do transaction :
     3222              assign
     3223                 m-head-db-num    = cash-desk.db-num
     3224                 m-head-obj-code  = cash-desk.obj-code
     3225                 m-head-pos-type  = cash-desk.pos-type
     3226                 m-head-cash-num  = cash-desk.cash-num
     3227              .
     3228             if p-pos-type = 'IBM-XML':U then
     3229             do:
     3230               run cd-attr-write in this-procedure (
     3231                 input cash-desk.db-num
     3232                 ,input cash-desk.obj-code
     3233                 ,input cash-desk.pos-type
     3234                 ,input cash-desk.cash-num
     3235                 ,input  (if p-pos-type = 'IBM-XML':U
     3236                 then 'IBM-XML_operative':U
     3237                 else 'AUTOTANK_operative':U)
     3238                 ,input 'last-date-polls':U
     3239                 ,input string (today,"99.99.9999")
     3240                 ,input ?
     3241                 ,input 0
     3242                 ,input 0
     3243                 ,input no
     3244                 ) .
     3245               run cd-attr-write in this-procedure (
     3246                 input cash-desk.db-num
     3247                 ,input cash-desk.obj-code
     3248                 ,input cash-desk.pos-type
     3249                 ,input cash-desk.cash-num
     3250                 ,input  (if p-pos-type = 'IBM-XML':U
     3251                 then 'IBM-XML_operative':U
     3252                 else 'AUTOTANK_operative':U)
     3253                 ,input 'last-time-polls':U
     3254                 ,input string (time,"HH:MM:SS")
     3255                 ,input ?
     3256                 ,input 0
     3257                 ,input 0
     3258                 ,input no
     3259                 ) .
     3260             end.
     3261             IF v-OptVer = 'OptVer' THEN DO:
     3262               v-OptVer = "".
     3263               IF v-OptVersion  <> ? THEN v-OptVer = TRIM(v-OptVersion," ").
     3264               IF v-OptVersion1 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion1," ")) .
     3265               IF v-OptVersion2 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion2," ")) .
     3266               IF v-OptVersion3 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion3," ")) .
     3267               IF v-OptVersion4 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion4," ")) .
     3268               v-OptVer = TRIM(v-OptVer,",").
     3269                   IF v-OptVer = "" THEN v-OptVer = "?" .
     3270                       run cd-attr-write in this-procedure (
     3271                                                      input cash-desk.db-num
     3272                                                     ,input cash-desk.obj-code
     3273                                                     ,input cash-desk.pos-type
     3274                                                     ,input cash-desk.cash-num
     3275                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     3276                                                              then 'IBM-XML_operative':U
     3277                                                              else 'AUTOTANK_operative':U)
     3278                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     3279                                                          then 'OptVer':U
     3280                                                          else 'OptVer':U)
     3281                                                     ,input v-OptVer
     3282                                                     ,input no
     3283                                                     ,input no
     3284                                                     ,input no
     3285                                                     ,input no
     3286                                                     ) no-error.
     3287                  v-OptVer = '' .
     3288              END.
     3289             if error-status:error then do :
     3290                 v-err-message = return-value .
     3291                 run write-log-and-file in p-log-handle (
     3292               input 1
     3293             , input log-file-name
     3294             , input 1
     3295             , input v-err-message
     3296                                             ).
     3297                 p-view-log = yes .
     3298               end .
     3299              run cd-attr-value in this-procedure (
     3300                                                  input cash-desk.db-num
     3301                                                 ,input cash-desk.obj-code
     3302                                                 ,input cash-desk.pos-type
     3303                                                 ,input cash-desk.cash-num
     3304                                                 ,input  (if cash-desk.pos-type = 'IBM-XML':U
     3305                                                         then 'IBM-XML_operative':U
     3306                                                         else 'AUTOTANK_operative':U)
     3307                                                 ,input  (if cash-desk.pos-type = 'IBM-XML':U
     3308                                                          then 'fo-version':U
     3309                                                          else 'fo-version':U)
     3310                                                 ,output v-old-fo-version
     3311                                                 ,output v-date
     3312                                                 ,output v-decimal
     3313                                                 ,output v-integer
     3314                                                 ,output v-logical
     3315                                                 ,output v-dop) no-error.
     3316              if     v-old-fo-version <> v-fo-version
     3317                 and v-FO-version <> ?
     3318              then do:
     3319                 run cd-attr-write in this-procedure (
     3320                                                      input cash-desk.db-num
     3321                                                     ,input cash-desk.obj-code
     3322                                                     ,input cash-desk.pos-type
     3323                                                     ,input cash-desk.cash-num
     3324                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     3325                                                              then 'IBM-XML_operative':U
     3326                                                              else 'AUTOTANK_operative':U)
     3327                                                     ,input (if cash-desk.pos-type = 'IBM-XML':U
     3328                                                             then 'fo-version':U
     3329                                                             else 'fo-version':U)
     3330                                                     ,input v-fo-version
     3331                                                     ,input ?
     3332                                                     ,input 0
     3333                                                     ,input 0
     3334                                                     ,input no
     3335                                                     ) no-error.
     3336               if error-status:error then do :
     3337                 v-err-message = return-value .
     3338                 run write-log-and-file in p-log-handle (
     3339               input 1
     3340             , input log-file-name
     3341             , input 1
     3342             , input v-err-message
     3343                                             ).
     3344                 p-view-log = yes .
     3345               end .
     3346             end.
     3347           end.
     3348         end.
     3349       end.
     3350       else do:
     3351         run write-log-and-file in p-log-handle (
     3352               input 1
     3353             , input log-file-name
     3354             , input 1
     3355             , input substitute( "!!!В директории приема файлов обнаружен файл с неизвестным адресатом: &1 и/или неизвестного типа: &2"
     3356                                 , v-adresat
     3357                                 , v-file-type
     3358                               )
     3359                                             ).
     3360         assign
     3361         p-view-log = yes
     3362         v-exit-processing = yes
     3363         .
     3364       end.
     3365     end.
     3366     else do:
     3367         run write-log-and-file in p-log-handle (
     3368               input 1
     3369             , input log-file-name
     3370             , input 1
     3371             , input substitute( "!!!Нарушение протокола обмена : тэг <&1>", p-spool-or-data
     3372                               )
     3373                                             ).
     3374         assign
     3375         p-view-log = yes
     3376         .
     3377     end.
     3378   end.
     3379   end procedure.
     3380   procedure cb-xmlparse-tag-start-config :
     3381   define input parameter p-parameter as character no-undo .
     3382     run cb-xmlparse-tag-start-ignoriruem in this-procedure ( input p-parameter) no-error.
     3383     if error-status:error then return error return-value .
     3384   end procedure.
     3385   procedure cb-xmlparse-tag-start-control :
     3386   define input parameter p-parameter as character no-undo .
     3387     run cb-xmlparse-tag-start-ignoriruem in this-procedure ( input p-parameter) no-error.
     3388     if error-status:error then return error return-value .
     3389   end procedure.
     3390   procedure cb-xmlparse-tag-end-ignoriruem :
     3391   define input parameter p-parameter as character no-undo .
     3392   do
     3393   on error undo, return error
     3394   :
     3395     assign
     3396     v-is-spool-file = no
     3397     .
     3398     end.
     3399   end procedure.
     3400   procedure cb-xmlparse-tag-end-config :
     3401   define input parameter p-parameter as character no-undo .
     3402   run cb-xmlparse-tag-end-ignoriruem  in this-procedure ( input p-parameter) no-error.
     3403   if error-status:error then return error return-value .
     3404   end procedure.
     3405   procedure cb-xmlparse-tag-end-control :
     3406   define input parameter p-parameter as character no-undo .
     3407   run cb-xmlparse-tag-end-ignoriruem  in this-procedure ( input p-parameter) no-error.
     3408   if error-status:error then return error return-value .
     3409   end procedure.
     3410   procedure cb-xmlparse-tag-start-spool :
     3411   define input parameter p-parameter as character no-undo .
     3412   do
     3413   on error undo, return error
     3414   :
     3415     if v-is-spool-file = yes then do:
     3416         run write-log-and-file in p-log-handle (
     3417               input 1
     3418             , input log-file-name
     3419             , input 1
     3420             , input substitute( "!!!Нарушение протокола обмена : тэг <&1>",
     3421    "spool":U
     3422                              )
     3423                                             ).
     3424         assign
     3425         p-view-log = yes
     3426         .
     3427     end.
     3428     else do:
     3429       assign
     3430       v-exit-processing = yes
     3431       .
     3432     end.
     3433   end.
     3434   end procedure.
     3435   procedure cb-xmlparse-tag-end-spool :
     3436   define input parameter p-parameter as character no-undo .
     3437   do
     3438   on error undo, return error
     3439   :
     3440   end.
     3441   end procedure.
     3442   procedure cb-xmlparse-tag-start-error:
     3443   define input parameter p-parameter as character no-undo .
     3444   run cb-xmlparse-tag-start-err in this-procedure ( input p-parameter)  .
     3445   end procedure .
     3446   procedure cb-xmlparse-tag-end-error :
     3447   define input parameter p-parameter as character no-undo .
     3448   run cb-xmlparse-tag-end-err in this-procedure ( input p-parameter)  .
     3449   end procedure .
     3450   procedure cb-xmlparse-tag-end-ErrorMessage :
     3451   define input parameter p-parameter as character no-undo .
     3452   assign
     3453   v-ErrorMessage = v-xmlvalid-tag-value
     3454   .
     3455   if p-pos-type = 'IBM-XML':U
     3456   or p-pos-type = 'Autotank':U
     3457   then do:
     3458       run write-log-and-file in p-log-handle (
     3459             input 1
     3460           , input log-file-name
     3461           , input 1
     3462           , input substitute( "!!!&1"
     3463                               ,v-ErrorMessage
     3464                             )
     3465                                           ).
     3466       assign
     3467       p-view-log = yes
     3468       .
     3469   end.
     3470   end procedure .
     3471   procedure cb-xmlparse-tag-end-ErrorSeverity :
     3472   define input parameter p-parameter as character no-undo .
     3473   assign
     3474   v-Errorseverity = integer(v-xmlvalid-tag-value)
     3475   no-error
     3476   .
     3477   if p-pos-type = 'IBM-XML':U
     3478   or p-pos-type = 'Autotank':U
     3479   then do:
     3480       run write-log-and-file in p-log-handle (
     3481             input 1
     3482           , input log-file-name
     3483           , input 1
     3484           , input substitute( "!!!&1"
     3485                             , (if v-errorseverity = 0
     3486                                 then "Информация"
     3487                                 else (if v-Errorseverity = 1
     3488                                       then "Предупреждение"
     3489                                       else "Ошибка"
     3490                                       )
     3491                                 ))
     3492                                 ).
     3493       assign
     3494       p-view-log = yes
     3495       .
     3496   end.
     3497   end procedure .
     3498   procedure cb-xmlparse-tag-start-err:
     3499   define input parameter p-parameter as character no-undo .
     3500   do
     3501   on error undo, return error
     3502   :
     3503     if v-is-spool-file
     3504     then do:
     3505       assign
     3506       v-start-err = v-start-err + 1
     3507       v-num-errors = v-num-errors + 1
     3508       v-errormessage = '':U
     3509       v-errorseverity = 0
     3510       v-errornum = '':U
     3511       .
     3512       if p-pos-type = 'MAGIA-XML':U then do:
     3513         assign
     3514         v-ErrorMessage = cb-xmlparse-get-attr(
     3515                                   input this-procedure:handle
     3516                                 ,input p-spool-or-data
     3517                                 ,input p-parameter
     3518                                 ,input "ErrorMessage":U
     3519                                 ,input yes)
     3520         v-ErrorNum =  cb-xmlparse-get-attr(
     3521                                   input this-procedure:handle
     3522                                 ,input p-spool-or-data
     3523                                 ,input p-parameter
     3524                                 ,input "Error":U
     3525                                 ,input no)
     3526         v-ErrorSeverity =  integer(cb-xmlparse-get-attr(
     3527                                   input this-procedure:handle
     3528                                 ,input p-spool-or-data
     3529                                 ,input p-parameter
     3530                                 ,input "ErrorSeverity":U
     3531                                 ,input no))
     3532         no-error
     3533         .
     3534         run write-log-and-file in p-log-handle (
     3535               input 1
     3536             , input log-file-name
     3537             , input 1
     3538             , input substitute( "!!!&1: &2 &3                   Код &4"
     3539                                 , (if v-errorseverity = 0
     3540                                   then "Информация"
     3541                                   else (if v-Errorseverity = 1
     3542                                         then "Предупреждение"
     3543                                         else "Ошибка"
     3544                                         )
     3545                                   )
     3546                                 , v-ErrorMessage
     3547                                 , chr(10)
     3548                                 , v-ErrorNum
     3549                               )
     3550                                             ).
     3551         assign
     3552         p-view-log = yes
     3553         .
     3554       end.
     3555     end.
     3556     else do:
     3557         run write-log-and-file in p-log-handle (
     3558               input 1
     3559             , input log-file-name
     3560             , input 1
     3561             , input substitute( "!!!Нарушение протокола обмена : тэг Err", p-spool-or-data
     3562                               )
     3563                                             ).
     3564         assign
     3565         p-view-log = yes
     3566         .
     3567     end.
     3568   end.
     3569   end procedure.
     3570   procedure cb-xmlparse-tag-end-err :
     3571   define input parameter p-parameter as character no-undo .
     3572   do
     3573   on error undo, return error
     3574   :
     3575     if p-pos-type = 'MAGIA-XML':U then do:
     3576       if v-start-err =  1 then do:
     3577         assign
     3578         v-start-err = 0
     3579         .
     3580       end.
     3581       else do:
     3582         assign
     3583         v-start-err = v-start-err - 1
     3584         .
     3585       end.
     3586     end.
     3587     if p-pos-type = 'IBM-XML':U
     3588     or p-pos-type = 'Autotank':U
     3589     then do:
     3590       assign
     3591       v-errornum = v-xmlvalid-tag-value
     3592       no-error .
     3593       run write-log-and-file in p-log-handle (
     3594             input 1
     3595           , input log-file-name
     3596           , input 1
     3597           , input substitute( "!!!           Код &1"
     3598                               , v-ErrorNum  )
     3599                                           ).
     3600       assign
     3601       p-view-log = yes
     3602       .
     3603     end.
     3604   end.
     3605   end procedure.
     3606   PROCEDURE fill-doc-property :
     3607   do
     3608   on error undo, return error
     3609   :
     3610   define input parameter p-tag-name   as character    no-undo.
     3611   define input parameter p-tag-value  as character    no-undo.
     3612   define buffer buf_db for ub.db.
     3613   if v-mail-parameters-start = yes
     3614   then do:
     3615     CASE p-tag-name:
     3616       when "DocumentName":U
     3617       then do:
     3618         if p-tag-value = p-spool-or-data then do:
     3619         end.
     3620         else do:
     3621         end.
     3622       end.
     3623       when "DateFormat":U
     3624       then do:
     3625         assign
     3626         v-date-format = p-tag-value
     3627         .
     3628       end.
     3629       when "DocumentVersion":U
     3630       then do:
     3631         assign
     3632         v-version = p-tag-value
     3633         .
     3634       end.
     3635       when "DecimalSeparator":U
     3636       then do:
     3637         assign
     3638         v-dec-sep = p-tag-value
     3639         .
     3640       end.
     3641       when "objList":U then do:
     3642       end.
     3643       when "dbEncKey":U then do:
     3644         assign
     3645         v-db-key-enc = p-tag-value
     3646         .
     3647         find first buf_db where buf_db.db-num = g#db-num no-lock.
     3648         if buf_db.db-key-enc = v-db-key-enc then do:
     3649           return error
     3650           substitute("Кодир. значение ключа БД-приемника &1 совпадает с кодир. значением ключа БД-источника &2&3- импорт данных со своей БД на свою БД невозможен"
     3651                      , buf_Db.db-key-enc
     3652                      , v-db-key-enc
     3653                      , chr(10)).
     3654         end.
     3655       end.
     3656     end case.
     3657   end.
     3658   end.
     3659   end PROCEDURE.
     3660   procedure create-temp-table-record :
     3661   define input parameter p-record-name as character no-undo .
     3662   define input parameter p-field-name as character no-undo .
     3663   define input parameter p-field-value as character no-undo .
     3664     do
     3665     on error undo, return error
     3666     :
     3667       if p-record-name = "Param" or p-record-name = "FuelPump" then do:
     3668       find first temp-param where
     3669                  temp-param.cr = cri + 1 no-error .
     3670       if not avail temp-param then do:
     3671         create
     3672         temp-param.
     3673         assign
     3674         temp-param.cr = cri + 1
     3675         .
     3676       end.
     3677       assign
     3678       temp-param.record-name = p-record-name
     3679       temp-param.field-name  = p-field-name
     3680       temp-param.field-value = p-field-value
     3681       temp-param.desk        = m-head-cash-num
     3682       temp-param.key-name    = v-key
     3683       temp-param.group-name  = v-group
     3684       cri                   = cri + 1
     3685       .
     3686       end.
     3687       else do:
     3688       find first temp-temp where
     3689                  temp-temp.cr = cri + 1 no-error .
     3690       if not avail temp-temp then do:
     3691         create
     3692         temp-temp.
     3693         assign
     3694         temp-temp.cr = cri + 1
     3695         .
     3696       end.
     3697       assign
     3698       temp-temp.record-name = p-record-name
     3699       temp-temp.field-name  = p-field-name
     3700       temp-temp.field-value = p-field-value
     3701       temp-temp.id          = v-id
     3702       temp-temp.ctime       = v-time
     3703       cri                   = cri + 1
     3704       .
     3705       end.
     3706     end.
     3707   end procedure.
     3708   define stream dirstream.
     3709   define stream PrnLibStream.
     3710   define buffer buf_cash-desk for ub.cash-desk.
     3711   assign
     3712   p-dir = entry(1, p-parameter, chr(4) )
     3713   p-resend = (if num-entries(p-parameter, chr(4) ) > 1
     3714               then logical(entry(2, p-parameter, chr(4) ))
     3715               else no).
     3716   input stream DirStream from os-dir(p-dir) .
     3717   _file:
     3718   REPEAT :
     3719     import stream DirStream file_ path atr.
     3720     if length(file_) > 3
     3721     AND substring( file_, length(file_) - 2, 3 ) = "xml":u
     3722     AND can-do( "f", atr )  then do:
     3723       if v-first then do:
     3724         run write-log-and-file in p-log-handle (
     3725               input 1
     3726             , input log-file-name
     3727             , input 1
     3728             , input substitute( "!!!В директории &1 обнаружены файлы, недошедшие до кассы:&2            посылаются заново......."
     3729                                 , p-dir
     3730                                 , chr(10))
     3731                                             ).
     3732         v-first = no.
     3733       end.
     3734       process events.
     3735       assign
     3736       v-adresat = '':U
     3737       v-shop-code = '':U
     3738       v-cd-num = '':U
     3739       v-exit-processing = no
     3740       .
     3741       RUN get-xml-ibm-c(input path ) no-error .
     3742       if error-status :error
     3743       then do:
     3744           run write-log-and-file in p-log-handle (
     3745                 input 1
     3746               , input log-file-name
     3747               , input 1
     3748               , input substitute( "!!!Ошибка при обработке файла &1: &2"
     3749                                   , file_
     3750                                   , return-value
     3751                                 )
     3752                                               ).
     3753         assign
     3754         v-view-log = yes
     3755         .
     3756         next _file .
     3757       end.
     3758       if v-adresat <> '':U  then do:
     3759          assign
     3760          v-entry = trim(substring(v-adresat, 4)
     3761                      , chr(39)).
     3762          v-shop-code = entry(1, v-entry, "_").
     3763          v-cd-num    = entry(2, v-entry, "_").
     3764         .
     3765         find first buf_cash-desk where
     3766                   buf_cash-desk.pos-type = 'IBM-XML':U
     3767               and buf_cash-desk.db-num = g#db-num
     3768               and buf_cash-desk.obj-code = integer(trim(v-shop-code, 'маг':U))
     3769               and buf_cash-desk.cash-num = integer(trim(v-cd-num, 'касса'))           no-error .
     3770         if available buf_cash-desk then do:
     3771             run str/get-inis.p (
     3772                             input 'маг':U
     3773                           , input buf_cash-desk.obj-code
     3774                           , input buf_cash-desk.pos-type
     3775                           , input buf_cash-desk.remote
     3776                           , input "get":U
     3777                           , output out
     3778                           , output out2
     3779                           , output in_
     3780                           , output spl
     3781                           , output sav
     3782                           , output v-remote
     3783                           )  no-error .
     3784             if error-status:error then do:
     3785               run write-log-and-file in p-log-handle (
     3786                     input 1
     3787                   , input log-file-name
     3788                   , input 1
     3789                   , input substitute(
     3790                                     "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3791                                     , buf_cash-desk.pos-type
     3792                                     , buf_cash-desk.obj-code
     3793                                     , chr(10)
     3794                                     , error-status:get-message(1)
     3795                                     , return-value
     3796                                     )).
     3797               assign
     3798               v-view-log = yes.
     3799               next _file.
     3800             end.
     3801             run str/post-xml.p
     3802               (
     3803               input parparentproc
     3804               ,input parparentproc
     3805               ,input p-log-handle
     3806               ,input (if p-resend then ? else g#news)
     3807               ,input (if p-resend then ? else g#auto)
     3808               ,input 'send'
     3809               ,input log-file-name
     3810               ,input (entry(1, buf_cash-desk.addr-path, chr(4)) + '://' + entry(2, buf_cash-desk.addr-path, chr(4)))
     3811               ,input replace( path, "/", "\" )
     3812               ,input (replace(in_  + spl  + "/" + file_, "/", "\" ))
     3813               ,input 30
     3814               ,input substitute("Маг&1 касса&2 &3", buf_cash-desk.obj-code, buf_cash-desk.cash-num, file_)
     3815               ) no-error .
     3816           end.
     3817           else do:
     3818             run write-log-and-file in p-log-handle (
     3819                   input 1
     3820                 , input log-file-name
     3821                 , input 1
     3822                 , input substitute(
     3823                                   "!!!Неизвестная касса-адресат в файле &1: &2&3 касса &4"
     3824                                   , path
     3825                                   , 'маг':U
     3826                                   , v-shop-code
     3827                                   , v-cd-num
     3828                                   )).
     3829             assign
     3830             v-view-log = yes.
     3831             next _file.
     3832           end.
     3833       end.
     3834     end.
     3835   end.
     3836   input stream Dirstream close.
     3837   procedure cb-xmlparse-tag-start-Data :
     3838   define input parameter p-parameter as character no-undo .
     3839   do
     3840   on error undo, return error
     3841   :
     3842     assign
     3843     v-adresat = cb-xmlparse-get-attr(
     3844                             input this-procedure:handle
     3845                             ,input "data":U
     3846                             ,input p-parameter
     3847                             ,input "to":U
     3848                             ,input yes)
     3849     .
     3850     assign
     3851     v-exit-processing = yes
     3852     .
     3853   end.
     3854   END PROCEDURE.
     3855        .
