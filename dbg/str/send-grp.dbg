     1522   field max-plu       as integer
     1523   field num-fields    as integer
     1524   field task-num      as character
     1525   field by-record     as logical
     1526   field send-get      as character
     1527   field cash-num      as integer
     1528   field cash-num-char as character
     1529   field port-num      as character
     1530   field way           as character
     1531   field is-script     as logical
     1532   field pswd          as character
     1533   field waiting-sek   as integer
     1534   field other-info    as character
     1535   field order-num     as integer
     1536   field secondary     as integer
     1537   field shift-fields  as integer
     1538   field binary        as logical
