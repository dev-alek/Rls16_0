      609   procedure xmlchar-decode :
      610   define input parameter p-in-string      as character        no-undo.
      611   define output parameter p-out-string    as character        no-undo.
      612       define variable v-position      as integer      no-undo.
      613       define variable v-last-position as integer      no-undo.
      614       define variable v-temp-integer  as integer      no-undo.
      615       define variable v-current-char  as character    no-undo.
      616       define variable v-next-char     as character    no-undo.
      617       define variable v-success       as logical      no-undo.
      618   do
      619   on error undo, return error
      620   :
      621       assign
      622           p-out-string = "":U
      623           v-position   = 0
      624       .
      625       replace-cycle:
      626       do while yes
      627       on error undo, return error
      628       :
      629           assign
      630               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      631           .
      632           if v-last-position <= v-position
      633           then do:
      634               if v-position = 0
      635               then do:
      636                   assign
      637                       p-out-string = p-in-string
      638                   .
      639               end.
      640               else do:
      641                   assign
      642                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      643                   .
      644               end.
      645               leave replace-cycle.
      646           end.
      647           else do:
      648               assign
      649                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      650                   v-position      = v-last-position
      651                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      652               .
      653               if v-current-char = "#":U
      654               then do:
      655                   assign
      656                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      657                   .
      658                   if v-last-position > 0
      659                   then do:
      660                       run xmlchar-read-integer in this-procedure
      661                        (
      662                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      663                           , output v-temp-integer
      664                           , output v-success
      665                       ).
      666                       if v-success = yes
      667                       and v-temp-integer >= 1
      668                       and v-temp-integer <= 255
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + chr( v-temp-integer )
      672                               v-position   = v-last-position + 1
      673                           .
      674                       end.
      675                       else do:
      676                           assign
      677                               p-out-string = p-out-string + "&":U
      678                               v-position   = v-position   + 1
      679                           .
      680                       end.
      681                   end.
      682                   else do:
      683                       assign
      684                           p-out-string = p-out-string + "&":U
      685                           v-position   = v-position   + 1
      686                       .
      687                   end.
      688               end.
      689               else do:
      690                   case substring( p-in-string, v-position + 1, 3 )
      691                   :
      692                       when "lt;":U
      693                       then do:
      694                           assign
      695                               p-out-string = p-out-string + "<":U
      696                               v-position   = v-position   + 3
      697                           .
      698                       end.
      699                       when "gt;":U
      700                       then do:
      701                           assign
      702                               p-out-string = p-out-string + ">":U
      703                               v-position   = v-position   + 3
      704                           .
      705                       end.
      706                       otherwise do:
      707                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      708                           then do:
      709                               assign
      710                                   p-out-string = p-out-string + "&":U
      711                                   v-position   = v-position   + 4
      712                               .
      713                           end.
      714                           else do:
      715                               case substring( p-in-string, v-position + 1, 5 )
      716                               :
      717                                   when "quot;":U
      718                                   then do:
      719                                       assign
      720                                           p-out-string = p-out-string + '"':U
      721                                           v-position   = v-position   + 5
      722                                       .
      723                                   end.
      724                                   when "apos;":U
      725                                   then do:
      726                                       assign
      727                                           p-out-string = p-out-string + "'":U
      728                                           v-position   = v-position   + 5
      729                                       .
      730                                   end.
      731                                   otherwise do:
      732                                       assign
      733                                           p-out-string = p-out-string + "&":U
      734                                       .
      735                                   end.
      736                               end case.
      737                           end.
      738                       end.
      739                   end case.
      740               end.
      741           end.
      742       end.
      743   end.
      744   end .
      745   procedure xmlchar-read-integer :
      746   define input parameter p-input-string      as character        no-undo.
      747   define output parameter p-output-integer   as integer          no-undo.
      748   define output parameter p-success       as logical          no-undo.
      749   do
      750   on error undo, return error
      751   :
      752       assign
      753           p-output-integer = integer( p-input-string )
      754       no-error.
      755       if error-status :error
      756       then do:
      757           assign
      758               p-success           = no
      759               p-output-integer    = 0
      760           .
      761       end.
      762       else do:
      763           assign
      764               p-success           = yes
      765           .
      766       end.
      767   end.
      768   end.
      769   define variable v-bgelib-bgeclall           as logical      no-undo.
      770   define variable v-bgelib-bgedict            as logical      no-undo.
      771   define temp-table temp_ext-doc-type no-undo
      772       field edt-key               as integer
      773       field ext-doc-type          as character
      774       field ext-doc-type-label    as character
      775       index pi is primary unique
      776           edt-key
      777   .
      778   define temp-table temp_bgelib_goods no-undo
      779       field gds-code as integer
      780       index pi is primary unique
      781           gds-code
      782   .
      783   define temp-table temp_bgelib_clients no-undo
      784       field obj-type as character
      785       field obj-code as integer
      786       index pi is primary unique
      787           obj-type
      788           obj-code
      789   .
      790   define temp-table temp_bgelib_dis-card no-undo
      791       field d-card as character
      792       index pi is primary unique
      793           d-card
      794   .
      795   define temp-table temp_bgelib_trn-doc no-undo
      796       field doc-code as integer
      797   .
      798   procedure bgelib-tag-open:
      799   do
      800   on error undo, return error
      801   :
      802   define input parameter v-tag-level  as integer      no-undo.
      803   define input parameter v-tag-name   as character    no-undo.
      804   define input parameter v-tag-value  as character    no-undo.
      805       put stream stmXMLOut unformatted
      806           chr(10)
      807           + fill(" ", 4 * v-tag-level)
      808           + "<" + v-tag-name
      809           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      810           + v-tag-value + ">"
      811       .
      812   end.
      813   end procedure.
      814   procedure bgelib-tag-put:
      815   do
      816   on error undo, return error
      817   :
      818   define input parameter v-tag-level      as integer      no-undo.
      819   define input parameter v-tag-name       as character    no-undo.
      820   define input parameter v-tag-value      as character    no-undo.
      821   define input parameter v-empty-mode     as integer      no-undo.
      822       v-tag-name = trim(v-tag-name).
      823       if  v-empty-mode = 1
      824       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      825       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      826       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      827       then do:
      828           run xmlchar-encode in this-procedure (
      829                 input v-tag-value
      830               , output v-tag-value
      831           ).
      832           put stream stmXMLOut unformatted
      833               chr(10) + fill(" ", 4 * v-tag-level)
      834                           + '<' + v-tag-name + '>'
      835                           + v-tag-value
      836                           + '</' + v-tag-name + '>'
      837           .
      838       end.
      839   end.
      840   end procedure.
      841   procedure bgelib-tag-close:
      842   do
      843   on error undo, return error
      844   :
      845   define input parameter v-tag-level as integer      no-undo.
      846   define input parameter v-tag-name  as character    no-undo.
      847       put stream stmXMLOut unformatted
      848           chr(10)
      849           + fill( " ", 4 * v-tag-level)
      850           + '</' + v-tag-name + '>'
      851       .
      852   end.
      853   end procedure.
      854   procedure bgelib-write-log:
      855   do
      856   on error undo, return error
      857   :
      858   define input parameter v-filename   as character    no-undo.
      859   define input parameter v-log-level  as integer      no-undo.
      860   define input parameter v-out-string as character    no-undo.
      861       output stream stmXMLLog to value( v-filename ) append.
      862       put stream stmXMLLog unformatted
      863           chr(10)
      864       .
      865       put stream stmXMLLog unformatted
      866           ( if v-log-level = 0
      867             or v-out-string = "&DLine"
      868             or v-out-string = "&Line"
      869             then ""
      870             else cur-time-string-sec() + " " )
      871       .
      872       put stream stmXMLLog unformatted
      873           ( if v-out-string = "&Line"
      874             then fill( "-", 80 )
      875             else if v-out-string = "&DLine"
      876                  then fill( "=", 80 )
      877                  else v-out-string )
      878       .
      879       output stream stmXMLLog close.
      880   end.
      881   end procedure.
      882   procedure bgelib-write-edt:
      883   do
      884   on error undo, return error
      885   :
      886   define input parameter v-editor-handle    as handle       no-undo.
      887   define input parameter v-log-level        as integer      no-undo.
      888   define input parameter v-out-string       as character    no-undo.
      889       if valid-handle ( v-editor-handle )
      890       then do:
      891           v-editor-handle :move-to-eof().
      892           v-editor-handle :insert-string( ( if v-log-level = 0
      893                                             or v-out-string = "&DLine"
      894                                             or v-out-string = "&Line"
      895                                             then ""
      896                                             else cur-time-string-sec() + " "
      897                                         ) ).
      898           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      899                                             then fill( "-", 80 )
      900                                             else if v-out-string = "&DLine" then fill("=", 80)
      901                                             else fill( " ", v-log-level) + v-out-string
      902                                         ) ).
      903           v-editor-handle :insert-string( chr(10) ).
      904       end.
      905       process events.
      906       output to 'bgescn.txt' append.
      907           put unformatted
      908               chr(10)
      909               string( ( if v-log-level = 0
      910                         or v-out-string = "&DLine"
      911                         or v-out-string = "&Line"
      912                         then ""
      913                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      914                     ) )
      915               string( ( if v-out-string = "&Line"
      916                         then fill( "-", 80 )
      917                         else if v-out-string = "&DLine"
      918                              then fill( "=", 80 )
      919                              else fill( " ", v-log-level ) + v-out-string
      920                     ) )
      921           .
      922       output close.
      923   end.
      924   end procedure.
      925   procedure bgelib-show-cnt:
      926   do
      927   on error undo, return error
      928   :
      929   define input parameter v-fillin-handle     as handle   no-undo.
      930       if valid-handle( v-fillin-handle )
      931       then do:
      932           assign
      933               v-fillin-handle :visible = true
      934           .
      935       end.
      936   end.
      937   end procedure.
      938   procedure bgelib-hide-cnt:
      939   do
      940   on error undo, return error
      941   :
      942   define input parameter v-fillin-handle     as handle   no-undo.
      943       if valid-handle( v-fillin-handle )
      944       then do:
      945           assign v-fillin-handle :visible = false.
      946       end.
      947   end.
      948   end procedure.
      949   procedure bgelib-write-cnt:
      950   do
      951   on error undo, return error
      952   :
      953   define input parameter v-fillin-handle    as handle       no-undo.
      954   define input parameter v-fillin-string    as character    no-undo.
      955       if valid-handle( v-fillin-handle )
      956       then do:
      957           assign
      958               v-fillin-handle :SCREEN-value = v-fillin-string
      959           .
      960       end.
      961   end.
      962   end procedure.
      963   procedure bgelib-write-header:
      964   do
      965   on error undo, return error
      966   :
      967   define input parameter p-first-file     as logical      no-undo.
      968   define input parameter p-xml-file-name  as character    no-undo.
      969   define input parameter p-list-file-name as character    no-undo.
      970   define input parameter p-file-number    as integer      no-undo.
      971   define input parameter p-have-prev      as logical      no-undo.
      972   define input parameter p-prev-filename  as character    no-undo.
      973   define input parameter p-obj-list       as character    no-undo.
      974   define input parameter p-doc-type-list  as character    no-undo.
      975   define input parameter p-parameter-list as character    no-undo.
      976       define variable v-counter    as integer        no-undo.
      977       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      978       put stream stmXMLOut unformatted
      979           "<?xml version='1.0' encoding='windows-1251'?>"
      980       .
      981       run bgelib-tag-open( input 0, input "root"  , input "" ).
      982       run bgelib-tag-open( input 0, input "header", input "" ).
      983       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      984       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      985       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      986       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      987       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      988       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      989       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      990       :
      991           run bgelib-tag-put(
      992                 input 1
      993               , input entry( 2 * v-counter, p-parameter-list )
      994               , input entry( 2 * v-counter + 1, p-parameter-list )
      995               , input 0
      996           ).
      997       end.
      998       run bgelib-tag-close( input 0, input "header" ).
      999       output stream stmXMLOut close.
     1000       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1001       if p-first-file = yes
     1002       then do:
     1003           put stream stmXMLOut unformatted
     1004               "<?xml version='1.0' encoding='windows-1251'?>"
     1005           .
     1006           run bgelib-tag-open( input 0, input "export", input "" ).
     1007       end.
     1008       run bgelib-tag-open( input 1, input "file", input "" ).
     1009       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1010       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1011       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1012       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1013       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1014       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1015       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1016       :
     1017           run bgelib-tag-put(
     1018                 input 2
     1019               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1020               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1021               , input 0
     1022           ).
     1023       end.
     1024       run bgelib-tag-close( input 1, input "file" ).
     1025       output stream stmXMLOut close.
     1026   end.
     1027   end procedure.
     1028   procedure bgelib-write-footer:
     1029   do
     1030   on error undo, return error
     1031   :
     1032   define input parameter p-last-file      as logical      no-undo.
     1033   define input parameter p-xml-file-name  as character    no-undo.
     1034   define input parameter p-list-file-name as character    no-undo.
     1035   define input parameter p-have-next      as logical      no-undo.
     1036   define input parameter p-next-file-name as character    no-undo.
     1037       define variable v-error-num     as integer           no-undo.
     1038       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1039       if p-have-next = yes
     1040       then do:
     1041           run bgelib-tag-open( input 0, input "footer", "" ).
     1042           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1043           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1044           run bgelib-tag-close( input 0, input "footer" ).
     1045       end.
     1046       run bgelib-tag-close( input 0, input "root" ).
     1047       output stream stmXMLOut close.
     1048       run bge/os_copy.p (
     1049             input "M"
     1050           , input p-xml-file-name + "tmp"
     1051           , input p-xml-file-name + "xml"
     1052           , output v-error-num
     1053       ).
     1054       if p-last-file = yes
     1055       then do:
     1056           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1057               run bgelib-tag-close( input 0, input "export" ).
     1058           output stream stmXMLOut close.
     1059           run bge/os_copy.p (
     1060                 input "M"
     1061               , input p-list-file-name + "tmp"
     1062               , input p-list-file-name + "xml"
     1063               , output v-error-num
     1064           ).
     1065       end.
     1066   end.
     1067   end procedure.
     1068   procedure bgelib-filename :
     1069   do
     1070   on error undo, return error
     1071   :
     1072   define input parameter p-prefix             as character    no-undo.
     1073   define output parameter p-xml-file-name     as character    no-undo.
     1074   define output parameter p-log-file-name     as character    no-undo.
     1075   define output parameter p-list-file-name    as character    no-undo.
     1076       define variable v-home-dir  as character    no-undo.
     1077       define variable v-error-num as integer      no-undo.
     1078       get-key-value section "BGE" key "outdir" value v-home-dir.
     1079       if v-home-dir = ?
     1080       then do:
     1081           message
     1082             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1083             skip(1)
     1084             skip "Обратитесь к администратору."
     1085           view-as alert-box error.
     1086           undo, return error .
     1087       end.
     1088       run gbl/dir-cre.p (
     1089           input v-home-dir
     1090       ) no-error.
     1091       if error-status :error
     1092       then do:
     1093           message
     1094             skip "Неверно задан каталог экспорта."
     1095             skip(1)
     1096             skip "Обратитесь к администратору."
     1097           view-as alert-box error.
     1098           undo, return error .
     1099       end.
     1100       run bge/genfname.p (
     1101             input v-home-dir
     1102           , input p-prefix
     1103           , input ""
     1104           , input "xml"
     1105           , input "tmp"
     1106           , output p-xml-file-name
     1107       ).
     1108       assign
     1109           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1110           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1111           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1112       .
     1113   end.
     1114   end procedure.
     1115   procedure bgelib-read-config :
     1116   do
     1117   on error undo, return error
     1118   :
     1119   define variable v-par-type as character     no-undo.
     1120     define variable v-param-type      as character  no-undo .
     1121     define variable v-value-character as character  no-undo .
     1122     define variable v-value-date      as date       no-undo .
     1123     define variable v-value-decimal   as decimal    no-undo .
     1124     define variable v-value-integer   as integer    no-undo .
     1125     define variable v-value-logical   as logical    no-undo .
     1126     define variable v-tth             as handle     no-undo .
     1127       assign
     1128           v-bgelib-bgeclall = no
     1129           v-bgelib-bgedict  = no
     1130       .
     1131       run adm/shattri.p ( input "get":U
     1132                         , input  '':u
     1133                         , input  0
     1134                         , input  'bge-export':U
     1135                         , input  'bgeclall':U
     1136                         , output v-value-character
     1137                         , output v-value-date
     1138                         , output v-value-decimal
     1139                         , output v-value-integer
     1140                         , output v-value-logical
     1141                         , output v-param-type
     1142                         , input-output table-handle v-tth
     1143                         ) no-error .
     1144       if error-status :error
     1145       then do:
     1146         assign
     1147           v-bgelib-bgeclall = no
     1148         .
     1149       end.
     1150       else do:
     1151         assign
     1152           v-bgelib-bgeclall = v-value-logical
     1153         .
     1154       end.
     1155       delete object v-tth.
     1156       run adm/shattri.p ( input "get":U
     1157                         , input  '':u
     1158                         , input  0
     1159                         , input  'bge-export':U
     1160                         , input  'bgedict':U
     1161                         , output v-value-character
     1162                         , output v-value-date
     1163                         , output v-value-decimal
     1164                         , output v-value-integer
     1165                         , output v-value-logical
     1166                         , output v-param-type
     1167                         , input-output table-handle v-tth
     1168                         ) no-error .
     1169       if error-status :error
     1170       then do:
     1171         assign
     1172           v-bgelib-bgedict = no
     1173         .
     1174       end.
     1175       else do:
     1176         assign
     1177           v-bgelib-bgedict = v-value-logical
     1178         .
     1179       end.
     1180       delete object v-tth.
     1181       run adm/shattri.p ( input "get":U
     1182                         , input  '':u
     1183                         , input  0
     1184                         , input  'bge-export':U
     1185                         , input  'bgefmt':U
     1186                         , output v-value-character
     1187                         , output v-value-date
     1188                         , output v-value-decimal
     1189                         , output v-value-integer
     1190                         , output v-value-logical
     1191                         , output v-param-type
     1192                         , input-output table-handle v-tth
     1193                         ) no-error .
     1194       if error-status :error
     1195       then do:
     1196         assign
     1197           v-bgelib-bgefmt  = "xml":U
     1198         .
     1199       end.
     1200       else do:
     1201         assign
     1202           v-bgelib-bgefmt  = v-value-character
     1203         .
     1204       end.
     1205       delete object v-tth.
     1206       run adm/shattri.p ( input "get":U
     1207                         , input  '':u
     1208                         , input  0
     1209                         , input  'bge-export':U
     1210                         , input  'bgeflold':U
     1211                         , output v-value-character
     1212                         , output v-value-date
     1213                         , output v-value-decimal
     1214                         , output v-value-integer
     1215                         , output v-value-logical
     1216                         , output v-param-type
     1217                         , input-output table-handle v-tth
     1218                         ) no-error .
     1219       if error-status :error
     1220       then do:
     1221         assign
     1222           v-bgelib-bgeflold  = "old":U
     1223         .
     1224       end.
     1225       else do:
     1226         assign
     1227           v-bgelib-bgeflold  = v-value-character
     1228         .
     1229       end.
     1230       delete object v-tth.
     1231   end.
     1232   end procedure.
     1233   procedure bgelib-check-file-size :
     1234   do
     1235   on error undo, return error
     1236   :
     1237   define input parameter p-out-filename   as character    no-undo.
     1238   define output parameter p-is-big        as logical      no-undo.
     1239       define variable v-current-position    as integer        no-undo.
     1240       assign
     1241           v-current-position = seek( stmXMLOut )
     1242       .
     1243       if v-current-position / 1024 / 1024  >= 100
     1244       then do:
     1245           assign
     1246               p-is-big = yes
     1247           .
     1248       end.
     1249   end.
     1250   end procedure.
     1251   procedure bgelib-init-ext-doc-type :
     1252       define variable v-counter    as integer      no-undo.
     1253       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1254   do
     1255   for buf_temp_ext-doc-type
     1256   on error undo, return error
     1257   :
     1258       empty temp-table buf_temp_ext-doc-type.
     1259       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1260       :
     1261           create buf_temp_ext-doc-type.
     1262           assign
     1263               buf_temp_ext-doc-type.edt-key               = v-counter
     1264               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1265               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1266           .
     1267       end.
     1268   end.
     1269   end procedure.
