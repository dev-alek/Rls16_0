     2378   define buffer buf2_dis-rule for ub.dis-rule.
     2379   define temp-table cash-dis-grp-rule no-undo like ub.dis-grp-rule.
     2380   define stream plucash.
     2381   define stream bar.
     2382   assign
     2383   log-file-name = p-log-file-name
     2384   .
     2385   CASE p-subject:
     2386     when '':U then do:
     2387       assign
     2388       is-bo-name = "группы товара на кассе и/или скидки на группу товара"
