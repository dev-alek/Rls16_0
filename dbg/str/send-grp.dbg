     2264   procedure disrules-get-interface-form :
     2265   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     2266   define output parameter p-form-name as character no-undo .
     2267   define buffer buf_temp-drt-prop for temp-drt-prop.
     2268   define buffer buf_drt-prop for ub.drt-prop.
     2269   find first buf_temp-drt-prop where
     2270             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     2271         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     2272         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     2273   if not available buf_temp-drt-prop then do:
     2274     find first buf_drt-prop where
     2275               buf_drt-prop.templ-rl-root = p-templ-rl-root
     2276           and buf_drt-prop.upper-prop-code = "InputForm"
     2277           and buf_drt-prop.prop-code = "FormName" no-error.
     2278     if available buf_drt-prop then do:
     2279       p-form-name = buf_drt-prop.property-value.
     2280     end.
     2281     else do:
     2282       p-form-name = "ref/dis-ruli.w".
     2283     end.
     2284   end.
     2285   else do:
     2286     p-form-name = buf_temp-drt-prop.property-value.
     2287   end.
     2288   end procedure.
     2289   ~
     2290   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2291   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     2292   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     2293   procedure create-dis-rule :
     2294   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     2295   define input parameter p-tree as logical no-undo .
     2296   define buffer buf_dis-rule for ub.dis-rule.
     2297   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2298   define buffer term_dis-rule for ub.dis-rule.
     2299   define buffer term_dis-time-rule for ub.dis-time-rule.
     2300   define buffer root_cash-dis-rule for cash-dis-rule.
     2301   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     2302   define buffer term_cash-dis-rule for cash-dis-rule.
     2303   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     2304     do
     2305     on error undo, return error
     2306     :
     2307       find first root_cash-dis-rule no-lock where                                                         ~
     2308                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     2309       if not available root_cash-dis-rule then do:
     2310         find first buf_dis-rule no-lock where
     2311                   buf_dis-rule.rule-num = p-rule-num no-error.
     2312         if available buf_dis-rule then do:
     2313           if buf_dis-rule.time-rule-num <> 0 then do:
     2314             find first buf_dis-time-rule no-lock where
     2315                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     2316           end.
     2317           create root_cash-dis-rule.
     2318           buffer-copy buf_dis-rule to root_cash-dis-rule.
     2319           if available buf_dis-time-rule then do:
     2320             find first root_cash-dis-time-rule no-lock where
     2321                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     2322             if not available root_cash-dis-time-rule then do:
     2323               create root_cash-dis-time-rule.
     2324               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     2325             end.
     2326           end.
     2327           else do:
     2328             assign
     2329             root_cash-dis-rule.time-rule-num = 0.
     2330           end.
     2331           if buf_dis-rule.uniq-field <> "":U then do:
     2332             for each term_dis-rule no-lock where
     2333                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     2334               if term_dis-rule.time-rule-num <> 0 then do:
     2335                 find first term_dis-time-rule no-lock where
     2336                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     2337               end.
     2338               create term_cash-dis-rule.
     2339               buffer-copy term_dis-rule to term_cash-dis-rule.
     2340               if term_dis-rule.time-rule-num = 0
     2341               or available term_dis-time-rule
     2342               or root_cash-dis-rule.time-rule-num = 0
     2343               then do:
     2344                 if available term_dis-time-rule then do:
     2345                   find first term_cash-dis-time-rule no-lock where
     2346                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     2347                   if not available term_cash-dis-time-rule then do:
     2348                     create term_cash-dis-time-rule.
     2349                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     2350                   end.
     2351                 end.
     2352               end.
     2353             end.
     2354           end.
     2355         end.
     2356       end.
     2357     end.
     2358   end procedure.
