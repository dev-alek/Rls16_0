     3892   procedure create-ncr-kat-discnt :
     3893   define input parameter p-subject-code as character no-undo .
     3894   define input parameter p-cd-subject-code as character no-undo .
     3895   define input parameter p-subject-name as character no-undo .
     3896   define input parameter p-dis-rule-num like ub.dis-rule.rule-num no-undo .
     3897   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     3898   define input parameter p-tree as character no-undo .
     3899   define input parameter p-node-code as integer no-undo .
     3900   define input parameter p-discnt as decimal no-undo .
     3901   define variable h_buffer as handle no-undo .
     3902   define buffer buf_cash-dis-rule for cash-dis-rule.
     3903   define buffer buf_cash-dis-time-rule for cash-dis-time-rule.
     3904   define buffer buf_dis-rule for dis-rule.
     3905     do
     3906     on error undo, return error
     3907     :
     3908       if p-dis-rule-num > 0 then do:
     3909         find first buf_cash-dis-rule no-lock where
     3910                   buf_cash-dis-rule.rule-num = p-dis-rule-num no-error.
     3911         if not available buf_cash-dis-rule
     3912         or buf_cash-dis-rule.templ-rl-root <> p-templ-rl-root
     3913         then do:
     3914           return error .
     3915         end.
     3916         if buf_cash-dis-rule.time-rule-num > 0 then do:
     3917           find first buf_cash-dis-time-rule no-lock where
     3918                   buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
     3919           if not available buf_cash-dis-time-rule then do:
     3920             return error .
     3921           end.
     3922         end.
     3923         if p-templ-rl-root = 37 then do:
     3924             find first buf_dis-rule no-lock
     3925             where buf_dis-rule.rule-num = buf_cash-dis-rule.upper-rule-num no-error.
     3926             if avail buf_dis-rule then do:
     3927                 assign buf_cash-dis-rule.dis-kat = buf_dis-rule.dis-kat .
     3928             end.
     3929         end.
     3930         _for:
     3931         for each buf_cash-dis-rule no-lock where
     3932                 buf_cash-dis-rule.rule-num = p-dis-rule-num:
     3933           if buf_cash-dis-rule.time-rule-num > 0 then do:
     3934             find first buf_cash-dis-time-rule no-lock where
     3935                       buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
     3936             if not available buf_cash-dis-time-rule then next _for.
     3937           end.
     3938           find first cash-grp no-lock where cash-grp.grp-code = p-node-code no-error.
     3939           if not available cash-grp then do:
     3940             next _for.
     3941           end.
     3942           FIND FIRST cash-ncr-dis-kat where
     3943                   cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
     3944           if not avail cash-ncr-dis-kat then do:
     3945             create cash-ncr-dis-kat.
     3946             error-status:error = false.
     3947           end.
     3948           cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
     3949           cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
     3950           assign
     3951           cash-ncr-dis-kat.subject-code  =  string(p-node-code)
     3952           cash-ncr-dis-kat.cd-subject-code  =  ( if p-templ-rl-root = 37
     3953                                                  then ('SI' + fill( chr(32) , 10) + string(p-node-code, '>>>9'))
     3954                                                  else ('DP' + fill( chr(32) , 10) + string(p-node-code, '9999')) )
     3955           cash-ncr-dis-kat.cd-subject-name  = SUBSTRING(buf_cash-dis-rule.des, 1, 20) +
     3956                                             ( if length(buf_cash-dis-rule.des) < 20 then fill( chr(32) , 20 - length(buf_cash-dis-rule.des) ) else '' )
     3957           cash-ncr-dis-kat.dis-kat =  (if buf_cash-dis-rule.dis-kat < 0 then 0 else buf_cash-dis-rule.dis-kat)
     3958           cash-ncr-dis-kat.rule-num = buf_cash-dis-rule.rule-num
     3959           cash-ncr-dis-kat.time-rule-num = buf_cash-dis-time-rule.time-rule-num
     3960           cash-ncr-dis-kat.cd-disc-string   = "****":U  +
     3961                                            (if buf_cash-dis-rule.discnt-value > 0 then '80':U else '00':U)
     3962           .
     3963           if p-tree = 'time-rule-num':U and available buf_cash-dis-time-rule then do:
     3964             assign
     3965             cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
     3966                                            (if buf_cash-dis-time-rule.value-type = '2':U
     3967                                             then
     3968                                             ("D":U + substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 9, 2) +
     3969                                                     substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 4, 2) +
     3970                                                     substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 1, 2) +
     3971                                                     "-":U +
     3972                                                     substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 9, 2) +
     3973                                                     substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 4, 2) +
     3974                                                     substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 1, 2)
     3975                                             )
     3976                                             else
     3977                                             ("T00":U +
     3978                                                       (if buf_cash-dis-time-rule.week-day-0  then "0" else "":U) +
     3979                                                       (if buf_cash-dis-time-rule.week-day-1  then "2" else "":U) +
     3980                                                       (if buf_cash-dis-time-rule.week-day-2  then "3" else "":U) +
     3981                                                       (if buf_cash-dis-time-rule.week-day-3  then "4" else "":U) +
     3982                                                       (if buf_cash-dis-time-rule.week-day-4  then "5" else "":U) +
     3983                                                       (if buf_cash-dis-time-rule.week-day-5  then "6" else "":U) +
     3984                                                       (if buf_cash-dis-time-rule.week-day-6  then "7" else "":U) +
     3985                                                       (if buf_cash-dis-time-rule.week-day-7  then "1" else "":U) +
     3986                                                     chr(47) +
     3987                                                     replace(string(buf_cash-dis-time-rule.time-from, "HH:MM"), ':':U, '':U) + "-":U +
     3988                                                     replace(string(buf_cash-dis-time-rule.time-to, "HH:MM"), ':':U, '':U)
     3989                                             )
     3990                                           )
     3991           .
     3992           assign
     3993           cash-ncr-dis-kat.cd-other =   fill(chr(32), 10) +  "xx ":U +  "%":U +                                                                                             ~
     3994                                         replace(string(abs(buf_cash-dis-rule.discnt-value),"9999999.9"), '.':U, '':U)
     3995           .
     3996           end.
     3997         end.
     3998       end.
     3999       else do:
     4000         FIND FIRST cash-ncr-dis-kat where
     4001                 cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
     4002         if not avail cash-ncr-dis-kat then do:
     4003         create cash-ncr-dis-kat.
     4004         error-status:error = false.
     4005         end.
     4006         cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
     4007         cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
     4008         assign
     4009         cash-ncr-dis-kat.subject-code  = p-subject-code
     4010         cash-ncr-dis-kat.cd-subject-code  = p-cd-subject-code
     4011         cash-ncr-dis-kat.cd-subject-name  = p-subject-name
     4012         cash-ncr-dis-kat.dis-kat =  - 1
     4013         cash-ncr-dis-kat.rule-num = 0
     4014         cash-ncr-dis-kat.time-rule-num = 0
     4015         .
     4016       end.
     4017     end.
     4018   end procedure.
     4019   procedure fill-cash-dis-grp-rule.
     4020       define buffer buf_Dis-grp-rule for ub.dis-grp-rule.
     4021       define buffer buf2_dis-thbj-rule for ub.dis-thbj-rule.
     4022       do ii = 1 to 3:
     4023         CASE ii:
     4024           when 3 then do:
     4025             assign
     4026             vc-obj-code = i-obj-code
     4027             vc-obj-type = 'маг':U
     4028             vc-host-code = v-host-code
     4029             vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
     4030             .
     4031           end.
     4032           when 2 then do:
     4033             assign
     4034             vc-obj-code = 0
     4035             vc-obj-type = '':U
     4036             vc-host-code = v-host-code
     4037             vc-region    = substitute("Фирма &1&2", vc-host-code)
     4038             .
     4039           end.
     4040           when 1 then do:
     4041             assign
     4042             vc-obj-code = 0
     4043             vc-obj-type = '':U
     4044             vc-host-code = 0
     4045             vc-region    = "Глобально"
     4046             .
     4047           end.
     4048         END CASE.
     4049         for each buf_dis-grp-rule no-lock where
     4050                 buf_Dis-grp-rule.pos-type = dflt-cd
     4051             and buf_Dis-grp-rule.host-code = vc-host-code
     4052             AND buf_dis-grp-rule.obj-type = vc-obj-type
     4053             AND buf_dis-grp-rule.obj-code = vc-obj-code
     4054             and buf_dis-grp-rule.classif-type = 'sum-grp':U
     4055             and buf_dis-grp-rule.discnt-role = 'gds-grp-pcnt':U,
     4056            first buf_dis-rule no-lock where
     4057                       buf_dis-rule.rule-num = buf_Dis-grp-rule.rule-num
     4058                   AND buf_dis-rule.sts = integer('0':U):
     4059           find first cash-dis-grp-rule where
     4060                 cash-Dis-grp-rule.pos-type = dflt-cd
     4061             and cash-Dis-grp-rule.host-code = v-host-code
     4062             AND cash-dis-grp-rule.obj-type = 'маг':U
     4063             AND cash-dis-grp-rule.obj-code = i-obj-code
     4064             and cash-dis-grp-rule.classif-type = 'sum-grp':U
     4065             and cash-dis-grp-rule.discnt-role = 'gds-grp-pcnt':U
     4066             and cash-dis-grp-rule.node-code = buf_dis-grp-rule.node-code no-error.
     4067           if not available cash-dis-grp-rule then do:
     4068             create cash-dis-grp-rule.
     4069             buffer-copy buf_dis-grp-rule
     4070             except host-code obj-type obj-code
     4071             to cash-dis-grp-rule
     4072             assign
     4073             cash-Dis-grp-rule.host-code = v-host-code
     4074             cash-dis-grp-rule.obj-type = 'маг':U
     4075             cash-dis-grp-rule.obj-code = i-obj-code
     4076             .
     4077           end.
     4078           assign
     4079           cash-Dis-grp-rule.rule-num = buf_Dis-rule.rule-num
     4080           .
     4081           release cash-dis-grp-rule.
     4082           v-found = yes.
     4083           run create-dis-rule in this-procedure (buf_dis-rule.rule-num, yes) no-error .
     4084         end.
     4085         for each buf2_dis-thbj-rule no-lock where
     4086                     buf2_dis-thbj-rule.pos-type = dflt-cd
     4087                 and buf2_dis-thbj-rule.host-code = vc-host-code
     4088                 AND buf2_dis-thbj-rule.obj-type = vc-obj-type
     4089                 AND buf2_dis-thbj-rule.obj-code = vc-obj-code
     4090                 and buf2_dis-thbj-rule.discnt-role = 'kat-gds-grp':U,
     4091            each buf2_dis-rule no-lock where
     4092                       buf2_dis-rule.upper-rule-num = buf2_Dis-thbj-rule.rule-num,
     4093               first buf_dis-grp-rule no-lock where
     4094                     buf_dis-grp-rule.host-code = buf2_dis-rule.host-code
     4095                and  buf_dis-grp-rule.obj-type = buf2_dis-rule.obj-type
     4096                and  buf_dis-grp-rule.obj-code = buf2_dis-rule.obj-code
     4097                and  buf_dis-grp-rule.rule-num = buf2_dis-rule.rule-num
     4098                and buf_dis-grp-rule.node-code = buf2_dis-rule.key#_one
     4099                and buf_dis-grp-rule.pos-type = dflt-cd
     4100                and buf_dis-grp-rule.classif-type = 'sum-grp':U
     4101                and buf_dis-grp-rule.discnt-role = 'gds-grp-pcnt-kat':U
     4102                  :
     4103           find first cash-dis-grp-rule where
     4104                 cash-Dis-grp-rule.pos-type = dflt-cd
     4105             and cash-Dis-grp-rule.host-code = v-host-code
     4106             AND cash-dis-grp-rule.obj-type = 'маг':U
     4107             AND cash-dis-grp-rule.obj-code = i-obj-code
     4108             and cash-dis-grp-rule.classif-type = 'sum-grp':U
     4109             and cash-dis-grp-rule.discnt-role = 'gds-grp-pcnt-kat':U
     4110             and cash-dis-grp-rule.node-code = buf_dis-grp-rule.node-code no-error.
     4111           if not available cash-dis-grp-rule then do:
     4112             create cash-dis-grp-rule.
     4113             buffer-copy buf_dis-grp-rule
     4114             except host-code obj-type obj-code
     4115             to cash-dis-grp-rule
     4116             assign
     4117             cash-Dis-grp-rule.host-code = v-host-code
     4118             cash-dis-grp-rule.obj-type = 'маг':U
     4119             cash-dis-grp-rule.obj-code = i-obj-code
     4120             .
     4121           end.
     4122           assign
     4123           cash-Dis-grp-rule.rule-num = buf2_Dis-rule.rule-num
     4124           .
     4125           release cash-dis-grp-rule.
     4126           v-found = yes.
     4127           run create-dis-rule in this-procedure (buf2_dis-rule.rule-num, yes) no-error .
     4128         end.
     4129       end.
     4130   end procedure.
