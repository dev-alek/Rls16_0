     2190   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2191   procedure dr-code :
     2192     do
     2193     on error undo, return error
     2194     :
     2195       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
     2196       define output parameter  p-des               like ub.dis-rule.des               no-undo .
     2197       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     2198       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
     2199       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
     2200       define output parameter  p-level-1           as character no-undo .
     2201       define output parameter  p-level-2           as character no-undo .
     2202       define output parameter  p-global             as integer no-undo .
     2203       define output parameter  p-host               as integer no-undo .
     2204       define output parameter  p-object             as integer no-undo .
     2205       define output parameter  p-output-display as logical   no-undo .
     2206       define output parameter  p-tree           as char  no-undo .
     2207       define output parameter  p-other          as character no-undo .
     2208       define variable v-other as character no-undo .
     2209       define buffer buf_dis-rule for ub.dis-rule .
     2210       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2211       find first buf_dis-rule no-lock where
     2212                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
     2213       find first buf_dis-cfg-rule no-lock where
     2214               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     2215           and buf_dis-cfg-rule.pos-type = '':U
     2216           and buf_dis-cfg-rule.table-name = '':U
     2217           and buf_dis-cfg-rule.discnt-role = '':U
     2218           and buf_dis-cfg-rule.self-nonunique = '':U
     2219               no-error.
     2220       if not available buf_Dis-cfg-rule then do:
     2221           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
     2222       end.
     2223       assign
     2224       p-des = buf_dis-rule.des
     2225       p-discnt-type = buf_dis-rule.discnt-type
     2226       p-subject-type = buf_dis-rule.subject-type
     2227       p-value-type = buf_dis-rule.value-type
     2228       p-global = (if available buf_dis-cfg-rule
     2229                   then buf_dis-cfg-rule.has-global
     2230                   else 0)
     2231       p-host = (if available buf_dis-cfg-rule
     2232                 then buf_dis-cfg-rule.has-host
     2233                 else 0)
     2234       p-object = (if available buf_dis-cfg-rule
     2235                 then buf_dis-cfg-rule.has-obj
     2236                 else 0)
     2237       p-output-display = (buf_dis-rule.sts = integer('0':U))
     2238       p-tree = buf_Dis-rule.uniq-field
     2239       p-other = buf_dis-rule.other-inf
     2240       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
     2241       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
     2242                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
     2243                    else '')
     2244       .
     2245     end.
     2246   end procedure.
     2247   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     2248   procedure disrules-fill-properties:
     2249   define input  parameter p-templ-rl-root as integer   no-undo .
     2250   define buffer buf_drt-prop for ub.drt-prop.
     2251   define buffer buf_temp-drt-prop for temp-drt-prop.
     2252   do
     2253   on error undo, return error return-value
     2254   :
     2255     for each buf_temp-drt-prop:
     2256       delete buf_temp-drt-prop.
     2257     end.
     2258     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     2259       create buf_temp-drt-prop.
     2260       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     2261     end.
     2262   end.
