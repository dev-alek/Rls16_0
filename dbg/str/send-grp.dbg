     1447   procedure alienini-getkey :
     1448   define input parameter i-filename as char.
     1449   define input parameter i-section as char.
     1450   define input parameter i-key as char.
     1451   define output parameter o-value as char.
     1452   define variable EntryPointer as integer no-undo.
     1453   define variable mem1 as memptr no-undo.
     1454   define variable mem2 as memptr no-undo.
     1455   define variable mem1size as integer no-undo.
     1456   define variable mem2size as integer no-undo.
     1457   define variable ii       as integer    no-undo.
     1458   define variable cbReturnSize  as integer    no-undo.
     1459   assign
     1460   set-size(mem1)  = 4000
     1461   mem1size = 4000.
     1462   if i-key = "" then EntryPointer = 0.
     1463   else do:
     1464     assign
     1465     set-size(mem2) = 128
     1466     mem2size = 128
     1467     EntryPointer = get-pointer-value(mem2)
     1468     put-string(mem2, 1) = i-key.
     1469   end.
     1470   run getprivateprofilestringA
     1471                                 (i-section,
     1472                                  EntryPointer,
     1473                                  "",
     1474                                  get-pointer-value(mem1),
     1475                                  input mem1size,
     1476                                  i-filename,
     1477                                  output cbReturnSize).
     1478   do ii = 1 to cbReturnSize:
     1479     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1480                  then o-value + ","
     1481                  else o-value + chr(get-byte(mem1, ii)).
     1482   end.
     1483     set-size(mem1) = 0.
     1484     set-size(mem2) = 0.
     1485   end procedure.
     1486   procedure alienini-putkey :
     1487   define input parameter i-filename as char.
     1488   define input parameter i-section as char.
     1489   define input parameter i-key as char.
     1490   define input parameter i-value as char.
     1491   define variable cbReturnSize as integer.
     1492   run writeprivateprofilestringA
     1493                                  (i-section,
     1494                                   i-key,
     1495                                   i-value,
     1496                                   i-filename,
     1497                                   output cbReturnSize ).
     1498   end procedure.
     1499   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1500     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1501     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1502     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1503     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1504     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1505     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1506     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1507   END PROCEDURE.
     1508   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1509     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1510     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1511     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1512     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1513     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1514   END PROCEDURE.
