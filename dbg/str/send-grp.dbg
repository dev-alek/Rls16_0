     2412   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2413   PROCEDURE putc-8.
     2414   define parameter buffer buf_cash-desk for ub.cash-desk.
     2415   define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     2416   define input parameter pos-type   like ub.cash-desk.pos-type no-undo.
     2417   define variable ii  as  integer   no-undo.
     2418   define variable v-ii as integer no-undo .
     2419   define variable v-record as character no-undo .
     2420   define variable v-maria-discnt-value as character no-undo .
     2421   define variable v-group-rule-num as integer no-undo .
     2422   define variable v-prev-grp-code as integer no-undo .
     2423   define variable v-dop as character no-undo .
     2424   define variable v-maria-rule-num as integer no-undo .
     2425   define variable v-shift-fields as integer no-undo .
     2426   DEFINE variable v-image-group as character no-undo .
     2427   DEFINE variable v-image-Visible as character no-undo .
     2428   DEFINE BUFFER buf_sum-grp-attr for ub.sum-grp-attr .
     2429   CASE pos-type:
     2430       when 'IBM':U
     2431       then do:
     2432           FOR EACH cash-grp NO-LOCK use-index pi:
     2433               PUT stream IBMstream unformatted
     2434               '8':U chr(32)
     2435               chr(34) string((if cash-grp.news-action
     2436                               then "D":U
     2437                               else action
     2438                               ), "x(1)" ) chr(34)  chr(32)
     2439               cash-grp.grp-code format ">>9" chr(32)
     2440               chr(34)
     2441               cash-grp.grp-name format "X(15)"
     2442               chr(34)  chr(32)
     2443               OS2-time
     2444               SKIP.
     2445           END.
     2446       end.
     2447       when
     2448       'IBM-XML':U
     2449       or
     2450       when
     2451       'InfoKiosk':U
     2452       then do:
     2453         CASE p-subject:
     2454           when '':U
     2455           or when "group-BO":U then do:
     2456             FOR EACH cash-grp NO-LOCK use-index pi:
     2457               run bgelib-tag-open in this-procedure ( input 2, input "Group", input substitute("ctrl='&1' tms='&2' code='&3'"
     2458                                                                                             , (if cash-grp.news-action
     2459                                                                                                 then "DEL":U
     2460                                                                                                 else (if action = "U":U
     2461                                                                                                       then "ADD":U
     2462                                                                                                       else "DEL":U
     2463                                                                                                     )
     2464                                                                                                 )
     2465                                                                                                   , OS2-time
     2466                                                                                                   , cash-grp.grp-code)).
     2467               if p-subject = 'group-BO':U
     2468               and pos-type = 'InfoKiosk':U
     2469               then do:
     2470                 run bgelib-tag-put in this-procedure ( input 3, input "GroupUpperCode"    , input string(cash-grp.upper-code), input 1 ).
     2471               end.
     2472               run bgelib-tag-put in this-procedure ( input 3, input "GroupName"         , input cash-grp.grp-name, input 1 ).
     2473               if p-subject = '':u then do:
     2474                 run bgelib-tag-put in this-procedure ( input 3, input "GroupLock"         , input cash-grp.stts, input 1 ).
     2475               end.
     2476                 for each buf_sum-grp-attr where buf_sum-grp-attr.grp-code = cash-grp.grp-code:
     2477                     if buf_sum-grp-attr.attr-code = "grp-image" then
     2478                     do:
     2479                        if buf_sum-grp-attr.attr-value = "yes" then v-image-Visible = "1".
     2480                        else v-image-Visible = "0" .
     2481                       run bgelib-tag-put in this-procedure ( input 3, input "GroupVisible"         , input v-image-Visible, input 1 ).
     2482                     end.
     2483                     if buf_sum-grp-attr.attr-code = "image-list" then
     2484                     do:
     2485                      v-image-group = "grp" + "/" + buf_sum-grp-attr.attr-value .
     2486                         run bgelib-tag-put in this-procedure ( input 3, input "GroupImage"         , input v-image-group, input 1 ).
     2487                     end.
     2488                 end.
     2489               run bgelib-tag-close in this-procedure ( input 2, input "Group").
     2490             END.
     2491           end.
     2492           when "units" then do:
     2493             if pos-type = 'InfoKiosk':U then do:
     2494               for each cash-units no-lock:
     2495                 run bgelib-tag-open in this-procedure ( input 2, input "Unit", input substitute("ctrl='&1' tms='&2' name='&3'"
     2496                                                                                               ,
     2497                                                                                                   (if action = "U":U
     2498                                                                                                         then "ADD":U
     2499                                                                                                         else "DEL":U
     2500                                                                                                       )
     2501                                                                                                     , OS2-time
     2502                                                                                                     , cash-units.unit-name)).
     2503                 run bgelib-tag-put in this-procedure ( input 3, input "UnitLongName"         , input cash-units.long-name, input 1 ).
     2504                 run bgelib-tag-close in this-procedure ( input 2, input "Unit").
     2505               end.
     2506             end.
     2507           end.
     2508           when "gds-prt" then do:
     2509             if pos-type = 'InfoKiosk':U then do:
     2510               for each cash-gds-prt no-lock:
     2511                 run bgelib-tag-open in this-procedure ( input 2, input "SizeColor", input substitute("ctrl='&1' tms='&2' code='&3'"
     2512                                                                                               ,
     2513                                                                                                   (if action = "U":U
     2514                                                                                                         then "ADD":U
     2515                                                                                                         else "DEL":U
     2516                                                                                                       )
     2517                                                                                                     , OS2-time
     2518                                                                                                     , cash-gds-prt.node-code)).
     2519                 run bgelib-tag-put in this-procedure ( input 3, input "SCUpperCode"         , input cash-gds-prt.upper-code, input 1 ).
     2520                 run bgelib-tag-put in this-procedure ( input 3, input "SCName"              , input cash-gds-prt.node-name, input 1 ).
     2521                 run bgelib-tag-put in this-procedure ( input 3, input "SCFullName"          , input cash-gds-prt.f-name, input 1 ).
     2522                 run bgelib-tag-close in this-procedure ( input 2, input "SizeColor").
     2523               end.
     2524             end.
     2525           end.
     2526           when "country" then do:
     2527             if pos-type = 'InfoKiosk':U then do:
     2528               for each cash-country no-lock:
     2529                 run bgelib-tag-open in this-procedure ( input 2, input "Country", input substitute("ctrl='&1' tms='&2' code='&3'"
     2530                                                                                               ,
     2531                                                                                                   (if action = "U":U
     2532                                                                                                         then "ADD":U
     2533                                                                                                         else "DEL":U
     2534                                                                                                       )
     2535                                                                                                     , OS2-time
     2536                                                                                                     , cash-country.alpha1)).
     2537                 run bgelib-tag-put in this-procedure ( input 3, input "CountryAlpha2"             , input cash-country.alpha2, input 1 ).
     2538                 run bgelib-tag-put in this-procedure ( input 3, input "CountryCode"             , input string(cash-country.num-code), input 1 ).
     2539                 run bgelib-tag-put in this-procedure ( input 3, input "CountryName"             , input cash-country.short-name, input 1 ).
     2540                 run bgelib-tag-put in this-procedure ( input 3, input "CountryLongName"         , input cash-country.long-name, input 1 ).
