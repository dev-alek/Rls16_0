        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения соответствия ТРК-пистолет":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer bf_cli for ub.clients.
      113   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      114   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      115   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      116   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      117   define frame fr-D-pump-8
      118     ub.c-pump-nozzle.nozzle-code at row  1.25 col 11.00 colon-aligned view-as fill-in    size-chars 10.50 by 1.00    label "Пистолет" fgcolor  4
      119     ub.c-pump-nozzle.pump-code   at row  2.50 col 11.00 colon-aligned view-as fill-in    size-chars  3.50 by 1.00    label "ТРК"      fgcolor  4
      120     ub.c-pump-nozzle.obj-type    at row  3.75 col 11.00 colon-aligned view-as fill-in    size-chars  4.50 by 1.00    label "Объект"
      121     ub.c-pump-nozzle.obj-code    at row  3.75 col 18.00          view-as fill-in    size-chars 10.50 by 1.00 no-label
      122       bf_cli.obj-name    at row  3.75 col 29.00          view-as fill-in    size-chars 70.00 by 1.00 no-label            fgcolor  4
      123     ub.c-pump-nozzle.is-meas     at row  5.00 col  2.50          view-as toggle-box size-chars  23.50 by 1.00
      124     ub.c-pump-nozzle.status_     at row  6.25 col 11.00 colon-aligned view-as fill-in    size-chars  9.50 by 1.00
      125     ub.c-pump-nozzle.PS          at row  7.50 col  1.50          view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical size-chars 98.25 by 3.50 format "x(512)":U                no-label            bgcolor 15
      126     r-rect-0             at row 11.25 col  1.50
      127       Btn_Exit           at row 11.50 col  2.50
      128       Btn_OK             at row 11.50 col 78.00
      129     b-help          at row 11.50 col 88.75
      130   with view-as dialog-box side-labels no-underline three-d scrollable
      131        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      132   assign frame fr-D-pump-8 :scrollable = no.
      133   on choose of Btn_OK in frame fr-D-pump-8 do:
      134   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   if lookup(self :type
      136            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      137            ) = 0
      138   then do:
      139     message
      140       "$Workfile$"
      141       "Указанному интерфейсному элементу фокус не может быть передан" skip
      142       "Интерфейсный элемент" self :name  skip
      143       "Тип" self :type  skip
      144       "Процедура" this-procedure :file-name skip
      145       view-as alert-box .
      146   end.
      147   else do:
      148     apply "entry":u to self  .
      149     if focus :handle <> self :handle  then do:
      150       return no-apply .
      151     end.
      152   end.
      153     apply "GO":U to frame fr-D-pump-8.
      154   end.
      155   on choose of Btn_Exit in frame fr-D-pump-8 do:
      156   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   if lookup(self :type
      158            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      159            ) = 0
      160   then do:
      161     message
      162       "$Workfile$"
      163       "Указанному интерфейсному элементу фокус не может быть передан" skip
      164       "Интерфейсный элемент" self :name  skip
      165       "Тип" self :type  skip
      166       "Процедура" this-procedure :file-name skip
      167       view-as alert-box .
      168   end.
      169   else do:
      170     apply "entry":u to self  .
      171     if focus :handle <> self :handle  then do:
      172       return no-apply .
      173     end.
      174   end.
      175   end.
      176   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   on F1 of frame fr-D-pump-8 anywhere do:
      178     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      179     return no-apply.
      180   end.
      181   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      182   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      183   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      184   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   on help of frame fr-D-pump-8
      186   do:
      187     run gbl/app_help.p
      188       (input this-procedure :file-name
      189       ,input ''
      190       ,input ?
      191       ) no-error.
      192     if error-status :error then do:
      193       message
      194         "Ошибка при вызове помощи"
      195         error-status :get-message(1)
      196         view-as alert-box .
      197     end.
      198   end.
      199   run minbtn-set in this-procedure .
      200   on choose of b-help in frame fr-D-pump-8
      201   do:
      202     apply "help":u to frame fr-D-pump-8 .
      203   end.
      204   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   procedure minbtn-set :
      206       do
      207           on error undo, return error return-value
      208           :
      209           define variable ii              as integer       no-undo .
      210           define variable fh              as widget-handle no-undo .
      211           define variable hh              as widget-handle no-undo .
      212           define variable v-h             as handle        extent 4 no-undo .
      213           define variable v-name-button   as character     no-undo .
      214           define variable v-help-old-x    as decimal       no-undo .
      215           define variable v-help-old-y    as decimal       no-undo .
      216           define variable v-help-old-size as decimal       no-undo .
      217           define variable v-frame-width   as decimal       no-undo .
      218           define variable jj              as integer       no-undo .
      219           do
      220               on error undo, return error
      221               :
      222               assign
      223                   v-frame-width = frame fr-D-pump-8:width - 0.3
      224                   fh            = frame fr-D-pump-8:first-child
      225                   hh            = fh:first-child
      226                   ii            = 1
      227                   .
      228               do while valid-handle(hh):
      229                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      230                   do:
      231                       case lc(hh:name) :
      232                           when "b-help" then
      233                               do:
      234                                   hh:load-image-up("cmp/b-help.bmp":u) .
      235                                   hh:load-image-down("cmp/b-help.bmp":u) .
      236                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      237                                   hh:TOOLTIP = "Помощь" .
      238                                   v-help-old-x = hh:column .
      239                                   v-help-old-y = hh:row    .
      240                                   v-help-old-size = hh:width .
      241                                   hh:width-chars = 2.5 .
      242                               end.
      243                           when "b-print" then
      244                               do:
      245                                   hh:load-image("cmp/b-print.bmp":u) .
      246                                   hh:TOOLTIP = "Печать" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-history" or
      252                           when "b-hist" then
      253                               do:
      254                                   hh:load-image("cmp/b-hist.bmp":u) .
      255                                   hh:TOOLTIP = "История" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-sch" then
      261                               do:
      262                                   hh:load-image("cmp/b-sch.bmp":u) .
      263                                   hh:TOOLTIP = "Установка Фильтра" .
      264                                   v-h[ii] = hh:handle .
      265                                   ii = ii + 1 .
      266                                   hh:width-chars = 3 .
      267                               end.
      268                           when "b-hist-user" then
      269                               do:
      270                                   hh:load-image("cmp/b-hist.bmp":u) .
      271                                   hh:TOOLTIP = "История пользователя" .
      272                                   ii = ii + 1 .
      273                               end.
      274                       end case.
      275                   end.
      276                   hh = hh:next-sibling.
      277               end.
      278               b-help:column = v-frame-width - b-help:width-chars.
      279               jj = 0.
      280               repeat ii = 4 to 1 by -1 :
      281                   if valid-handle (v-h[ii] ) then
      282                   do:
      283                       jj  = jj + 1 .
      284                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      285                       v-h[ii]:row    = v-help-old-y .
      286                   end.
      287               end.
      288           end.
      289       end.
      290   end procedure.
      291   Main-Block:
      292   do on error   undo Main-Block, leave Main-Block
      293      on end-key undo Main-Block, leave Main-Block :
      294     if p-mode <> 'ПРОСМОТР':U then do:
      295       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      296               "Неверное значение параметра вызова p-mode:" p-mode
      297       view-as alert-box error.
      298       undo Main-Block, return error.
      299     end.
      300     find ub.c-pump-nozzle no-lock where recid( ub.c-pump-nozzle ) = p-rec-id no-error.
      301     if not available ub.c-pump-nozzle then do:
      302       message "Карточка истории соответствия пистолет-ТРК не найдена!" view-as alert-box error.
      303       undo Main-Block, leave Main-Block.
      304     end.
      305     find bf_cli   no-lock where
      306          bf_cli.obj-type   = ub.c-pump-nozzle.obj-type and
      307          bf_cli.obj-code   = ub.c-pump-nozzle.obj-code no-error.
      308     assign frame fr-D-pump-8 :title = substitute(
      309       'Карточка изменения соответствия ТРК &1 - пистолет &2 (объект &3 &4 "&5") -- &6',
      310       ub.c-pump-nozzle.pump-code, ub.c-pump-nozzle.nozzle-code, ub.c-pump-nozzle.obj-type, ub.c-pump-nozzle.obj-code, bf_cli.obj-name, p-mode ).
      311     display ub.c-pump-nozzle.nozzle-code
      312             ub.c-pump-nozzle.pump-code
      313             ub.c-pump-nozzle.obj-type
      314             ub.c-pump-nozzle.obj-code
      315             ub.c-pump-nozzle.is-meas
      316             ub.c-pump-nozzle.status_
      317             ub.c-pump-nozzle.PS
      318     with frame fr-D-pump-8.
      319     if available bf_cli then do: display bf_cli.obj-name with frame fr-D-pump-8. end.
      320     enable ub.c-pump-nozzle.PS Btn_Exit b-help with frame fr-D-pump-8.
      321     assign ub.c-pump-nozzle.PS :read-only in frame fr-D-pump-8 = yes.
      322     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pump-8. end.
      323     wait-for go of frame fr-D-pump-8.
      324   end.
      325   hide frame fr-D-pump-8 no-pause.
