        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define parameter buffer goods for goods.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "История изменения цен товара по объекту".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-help
      115        LABEL "&Помощь"
      116        SIZE 8.75 BY 1.17.
      117   DEFINE BUTTON b-lkp
      118        LABEL "&Акт"
      119        SIZE 8.75 BY 1.17.
      120   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      121        LABEL "&Выход "
      122        SIZE 10 BY 1.17
      123        BGCOLOR 8 .
      124   DEFINE QUERY br-pr FOR
      125         price-list,
      126         price-doc SCROLLING.
      127   DEFINE BROWSE br-pr
      128     QUERY br-pr NO-LOCK DISPLAY
      129         price-doc.fact-date
      130         price-list.doc-num
      131         price-list.price-sale
      132         price-list.doc-qnty
      133         string (price-doc.plt-id ) + "." +
      134         string (price-doc.plt-db-num ) + "." +
      135         string (price-doc.pdf-id ) + "." +
      136         string (price-doc.pdf-db ) COLUMN-LABEL "Номер ТПЛ и ДНЦ"  format "x(100)"
      137       WITH SEPARATORS SIZE 93 BY 15.
      138   DEFINE FRAME DIALOG-1
      139        b-quit AT ROW 1.5 COL 1
      140        b-lkp AT ROW 1.5 COL 11
      141        b-help AT ROW 1.5 COL 81
      142        br-pr AT ROW 3.5 COL 1
      143       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      144            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      145            TITLE ""
      146            CANCEL-BUTTON b-quit.
      147   ASSIGN
      148          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      149   ON CHOOSE OF b-lkp IN FRAME DIALOG-1
      150   DO:
      151   find price-doc where price-doc.doc-num = price-list.doc-num no-error.
      152   if available price-doc then run str/pr-lkp.p ( parparentproc , recid(price-doc)).
      153   apply "entry" to br-pr.
      154   END.
      155   ON MOUSE-SELECT-DBLCLICK OF br-pr IN FRAME DIALOG-1
      156   DO:
      157   find price-doc where price-doc.doc-num = price-list.doc-num.
      158   run str/pr-lkp.p ( parparentproc , recid(price-doc)).
      159   apply "entry" to br-pr.
      160   END.
      161   ON RETURN OF br-pr IN FRAME DIALOG-1
      162   DO:
      163   find price-doc where price-doc.doc-num = price-list.doc-num.
      164   run str/pr-lkp.p ( parparentproc , recid(price-doc)).
      165   apply "entry" to br-pr.
      166   END.
      167   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      168   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      169   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   on help of frame DIALOG-1
      171   do:
      172     run gbl/app_help.p
      173       (input this-procedure :file-name
      174       ,input ''
      175       ,input ?
      176       ) no-error.
      177     if error-status :error then do:
      178       message
      179         "Ошибка при вызове помощи"
      180         error-status :get-message(1)
      181         view-as alert-box .
      182     end.
      183   end.
      184   run minbtn-set in this-procedure .
      185   on choose of b-help in frame DIALOG-1
      186   do:
      187     apply "help":u to frame DIALOG-1 .
      188   end.
      189   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   procedure minbtn-set :
      191       do
      192           on error undo, return error return-value
      193           :
      194           define variable ii              as integer       no-undo .
      195           define variable fh              as widget-handle no-undo .
      196           define variable hh              as widget-handle no-undo .
      197           define variable v-h             as handle        extent 4 no-undo .
      198           define variable v-name-button   as character     no-undo .
      199           define variable v-help-old-x    as decimal       no-undo .
      200           define variable v-help-old-y    as decimal       no-undo .
      201           define variable v-help-old-size as decimal       no-undo .
      202           define variable v-frame-width   as decimal       no-undo .
      203           define variable jj              as integer       no-undo .
      204           do
      205               on error undo, return error
      206               :
      207               assign
      208                   v-frame-width = frame DIALOG-1:width - 0.3
      209                   fh            = frame DIALOG-1:first-child
      210                   hh            = fh:first-child
      211                   ii            = 1
      212                   .
      213               do while valid-handle(hh):
      214                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      215                   do:
      216                       case lc(hh:name) :
      217                           when "b-help" then
      218                               do:
      219                                   hh:load-image-up("cmp/b-help.bmp":u) .
      220                                   hh:load-image-down("cmp/b-help.bmp":u) .
      221                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      222                                   hh:TOOLTIP = "Помощь" .
      223                                   v-help-old-x = hh:column .
      224                                   v-help-old-y = hh:row    .
      225                                   v-help-old-size = hh:width .
      226                                   hh:width-chars = 2.5 .
      227                               end.
      228                           when "b-print" then
      229                               do:
      230                                   hh:load-image("cmp/b-print.bmp":u) .
      231                                   hh:TOOLTIP = "Печать" .
      232                                   v-h[ii] = hh:handle .
      233                                   ii = ii + 1 .
      234                                   hh:width-chars = 3 .
      235                               end.
      236                           when "b-history" or
      237                           when "b-hist" then
      238                               do:
      239                                   hh:load-image("cmp/b-hist.bmp":u) .
      240                                   hh:TOOLTIP = "История" .
      241                                   v-h[ii] = hh:handle .
      242                                   ii = ii + 1 .
      243                                   hh:width-chars = 3 .
      244                               end.
      245                           when "b-sch" then
      246                               do:
      247                                   hh:load-image("cmp/b-sch.bmp":u) .
      248                                   hh:TOOLTIP = "Установка Фильтра" .
      249                                   v-h[ii] = hh:handle .
      250                                   ii = ii + 1 .
      251                                   hh:width-chars = 3 .
      252                               end.
      253                           when "b-hist-user" then
      254                               do:
      255                                   hh:load-image("cmp/b-hist.bmp":u) .
      256                                   hh:TOOLTIP = "История пользователя" .
      257                                   ii = ii + 1 .
      258                               end.
      259                       end case.
      260                   end.
      261                   hh = hh:next-sibling.
      262               end.
      263               b-help:column = v-frame-width - b-help:width-chars.
      264               jj = 0.
      265               repeat ii = 4 to 1 by -1 :
      266                   if valid-handle (v-h[ii] ) then
      267                   do:
      268                       jj  = jj + 1 .
      269                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      270                       v-h[ii]:row    = v-help-old-y .
      271                   end.
      272               end.
      273           end.
      274       end.
      275   end procedure.
      276   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      277   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      278   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      279   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      280   define variable v-diasize-current-frame-width  as decimal   no-undo .
      281   define variable v-diasize-current-frame-height as decimal   no-undo .
      282   define variable v-diasize-change-size          as logical   no-undo .
      283   define variable v-diasize-resize-button        as handle    no-undo .
      284   define variable v-diasize-wndmax               as logical   no-undo .
      285   define variable v-diasize-wndstore             as logical   no-undo .
      286   define variable v-diasize-proc-name            as character no-undo .
      287   define variable v-diasize-browse-handle        as handle    no-undo .
      288   define variable v-diasize-browse-number        as integer   no-undo .
      289   define variable v-diasize-need-full-display    as logical   no-undo init false .
      290   define temp-table temp-diasize-handle no-undo
      291     field handle-value  as handle
      292     field save-position as decimal
      293     index xpk is primary unique handle-value
      294     .
      295   define temp-table temp-browse-handle no-undo
      296     field browse-type   as character
      297     field browse-number as integer
      298     field browse-handle as handle
      299     field original-size as decimal
      300     index xpk is primary unique browse-type browse-number
      301     index xie browse-type browse-handle
      302   .
      303   procedure diasize_change-height :
      304     define input  parameter p-change-value  as decimal   no-undo .
      305     define input  parameter p-move-resize   as logical   no-undo .
      306     define variable v-field-group-handle    as handle    no-undo .
      307     define variable v-object-handle         as handle    no-undo .
      308     define variable v-frame-height          as decimal   no-undo .
      309     define variable v-frame-virtual-height  as decimal   no-undo .
      310     define variable v-browse-height         as decimal   no-undo .
      311     define variable v-window-height         as decimal   no-undo .
      312     define variable v-window-virtual-height as decimal   no-undo .
      313     define variable v-change-sign           as integer   no-undo .
      314     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      315     define buffer buf_temp-browse-handle  for temp-browse-handle .
      316     if p-change-value > 0
      317     then do:
      318       if frame DIALOG-1 :height + p-change-value
      319           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      320       then do:
      321         assign
      322           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      323                           - (frame DIALOG-1 :height-chars)
      324         .
      325         if p-change-value <= 0
      326         then do:
      327           run diasize_position-resize-button in this-procedure .
      328           return .
      329         end.
      330       end.
      331     end.
      332     if p-change-value < 0
      333     then do:
      334       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
      335       then do:
      336         assign
      337           p-change-value = v-diasize-orig-frame-height
      338                          - (frame DIALOG-1 :height-chars)
      339         .
      340         if p-change-value >= 0
      341         then do:
      342           run diasize_position-resize-button in this-procedure .
      343           return .
      344         end.
      345       end.
      346     end.
      347     if p-change-value >= 0
      348     then do:
      349       assign
      350         v-change-sign = 1
      351       .
      352     end.
      353     else do:
      354       assign
      355         v-change-sign = -1
      356       .
      357     end.
      358     assign
      359       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      360     .
      361     if p-change-value = 0
      362     then do:
      363       run diasize_position-resize-button in this-procedure .
      364       return .
      365     end.
      366     move_block:
      367     do
      368     on error undo move_block, retry move_block
      369     :
      370       if retry
      371       then do:
      372         do
      373         on error undo move_block, leave move_block
      374         :
      375           if p-change-value > 0
      376           then do:
      377             for each buf_temp-diasize-handle
      378             on error undo, next
      379             :
      380               assign
      381                 v-object-handle = buf_temp-diasize-handle.handle-value
      382               .
      383               if v-object-handle <> v-diasize-resize-button
      384               then do:
      385                 assign
      386                   v-object-handle :row = buf_temp-diasize-handle.save-position
      387                 .
      388               end.
      389             end.
      390             assign
      391               v-diasize-browse-handle :height = v-browse-height
      392             .
      393             for each buf_temp-browse-handle
      394               where buf_temp-browse-handle.browse-type = 'height':u
      395             on error undo, next
      396             :
      397               assign
      398                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      399               .
      400             end.
      401             assign
      402               frame DIALOG-1 :height = v-frame-height
      403             .
      404             if frame DIALOG-1 :scrollable = true
      405             then do:
      406               assign
      407                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      408               .
      409             end.
      410             run diasize_position-resize-button in this-procedure .
      411           end.
      412           else do:
      413             if frame DIALOG-1 :scrollable = true
      414             then do:
      415               assign
      416                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      417               .
      418             end.
      419             assign
      420               frame DIALOG-1 :height = v-frame-height
      421             .
      422             assign
      423               v-diasize-browse-handle :height = v-browse-height
      424             .
      425             for each buf_temp-browse-handle
      426               where buf_temp-browse-handle.browse-type = 'height':u
      427             on error undo, next
      428             :
      429               assign
      430                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      431               .
      432             end.
      433             for each buf_temp-diasize-handle
      434             on error undo, next
      435             :
      436               assign
      437                 v-object-handle = buf_temp-diasize-handle.handle-value
      438               .
      439               if v-object-handle <> v-diasize-resize-button
      440               then do:
      441                 assign
      442                   v-object-handle :row = buf_temp-diasize-handle.save-position
      443                 .
      444               end.
      445             end.
      446             run diasize_position-resize-button in this-procedure .
      447           end.
      448           assign
      449             v-diasize-change-size = false
      450           .
      451           leave move_block .
      452         end.
      453       end.
      454       assign
      455         v-diasize-need-full-display = true
      456       .
      457       if v-diasize-change-size = false
      458       then do:
      459         assign
      460           v-diasize-change-size = true
      461         .
      462       end.
      463       else do:
      464         return .
      465       end.
      466       assign
      467         v-frame-height = frame DIALOG-1 :height
      468         v-frame-virtual-height = frame DIALOG-1 :virtual-height
      469         v-browse-height = v-diasize-browse-handle :height
      470       .
      471       for each buf_temp-browse-handle
      472         where buf_temp-browse-handle.browse-type = 'height':u
      473       :
      474         assign
      475           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      476         .
      477       end.
      478       for each buf_temp-diasize-handle
      479       :
      480         delete buf_temp-diasize-handle .
      481       end.
      482       assign
      483         v-field-group-handle = frame DIALOG-1 :first-child
      484       .
      485       do while valid-handle(v-field-group-handle)
      486       :
      487         assign
      488           v-object-handle = v-field-group-handle :first-child
      489         .
      490         do while valid-handle(v-object-handle)
      491         :
      492           if  v-object-handle <> v-diasize-browse-handle :handle
      493           and can-query(v-object-handle, "row")
      494           and can-query(v-object-handle, "height")
      495           and ( v-object-handle :row > v-diasize-browse-handle :row )
      496           then do:
      497             find first buf_temp-browse-handle
      498               where buf_temp-browse-handle.browse-type   = 'height':u
      499                 and buf_temp-browse-handle.browse-handle = v-object-handle
      500               no-error .
      501             if available buf_temp-browse-handle
      502             then do:
      503             end.
      504             else do:
      505               create buf_temp-diasize-handle .
      506               assign
      507                 buf_temp-diasize-handle.handle-value  = v-object-handle
      508                 buf_temp-diasize-handle.save-position = v-object-handle :row
      509               .
      510             end.
      511           end.
      512           assign
      513             v-object-handle = v-object-handle :next-sibling
      514           .
      515         end.
      516         assign
      517           v-field-group-handle = v-field-group-handle :next-sibling
      518         .
      519       end.
      520       do with frame DIALOG-1
      521       :
      522         hide v-diasize-resize-button .
      523         assign
      524           v-diasize-resize-button :row    = 1
      525           v-diasize-resize-button :column = 1
      526         .
      527       end.
      528       if p-change-value > 0
      529       then do:
      530         if frame DIALOG-1 :scrollable = true
      531         then do:
      532           assign
      533             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
      534             no-error .
      535           if error-status :error
      536           or error-status :get-message(1) <> ""
      537           then do:
      538             undo move_block, retry move_block .
      539           end.
      540         end.
      541         assign
      542           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
      543           no-error .
      544         if error-status :error
      545         or error-status :get-message(1) <> ""
      546         then do:
      547           undo move_block, retry move_block .
      548         end.
      549         assign
      550           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      551           no-error .
      552         if error-status :error
      553         or error-status :get-message(1) <> ""
      554         then do:
      555           undo move_block, retry move_block .
      556         end.
      557         for each buf_temp-browse-handle
      558           where buf_temp-browse-handle.browse-type = 'height':u
      559         on error undo move_block, retry move_block
      560         :
      561           assign
      562             buf_temp-browse-handle.browse-handle :height
      563               = buf_temp-browse-handle.browse-handle :height + p-change-value
      564             no-error .
      565           if error-status :error
      566           or error-status :get-message(1) <> ""
      567           then do:
      568             undo move_block, retry move_block .
      569           end.
      570         end.
      571         for each buf_temp-diasize-handle
      572         on error undo move_block, retry move_block
      573         :
      574           assign
      575             v-object-handle = buf_temp-diasize-handle.handle-value
      576           .
      577           if v-object-handle <> v-diasize-resize-button
      578           then do:
      579             assign
      580               v-object-handle :row = v-object-handle :row + p-change-value
      581               no-error .
      582             if error-status :error
      583             or error-status :get-message(1) <> ""
      584             then do:
      585               undo move_block, retry move_block .
      586             end.
      587           end.
      588         end.
      589       end.
      590       else do:
      591         for each buf_temp-diasize-handle
      592         on error undo move_block, retry move_block
      593         :
      594           assign
      595             v-object-handle = buf_temp-diasize-handle.handle-value
      596           .
      597           if v-object-handle <> v-diasize-resize-button
      598           then do:
      599             assign
      600               v-object-handle :row = v-object-handle :row + p-change-value
      601               no-error .
      602             if error-status :error
      603             or error-status :get-message(1) <> ""
      604             then do:
      605               undo move_block, retry move_block .
      606             end.
      607           end.
      608         end.
      609         assign
      610           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      611           no-error .
      612         if error-status :error
      613         or error-status :get-message(1) <> ""
      614         then do:
      615           undo move_block, retry move_block .
      616         end.
      617         for each buf_temp-browse-handle
      618           where buf_temp-browse-handle.browse-type = 'height':u
      619         on error undo move_block, retry move_block
      620         :
      621           assign
      622             buf_temp-browse-handle.browse-handle :height
      623               = buf_temp-browse-handle.browse-handle :height + p-change-value
      624             no-error .
      625           if error-status :error
      626           or error-status :get-message(1) <> ""
      627           then do:
      628             undo move_block, retry move_block .
      629           end.
      630         end.
      631         assign
      632           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
      633           no-error .
      634         if error-status :error
      635         or error-status :get-message(1) <> ""
      636         then do:
      637           undo move_block, retry move_block .
      638         end.
      639         if frame DIALOG-1 :scrollable = true
      640         then do:
      641           assign
      642             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
      643             no-error .
      644           if error-status :error
      645           or error-status :get-message(1) <> ""
      646           then do:
      647             undo move_block, retry move_block .
      648           end.
      649         end.
      650       end.
      651       if p-move-resize = true
      652       then do:
      653         run diasize_position-resize-button in this-procedure .
      654       end.
      655       if v-diasize-wndstore = true
      656       then do:
      657         if connected("ub") = true
      658         then do:
      659           define variable v-cntxt-db-num        as integer   no-undo .
      660           define variable v-cntxt-userid        as character no-undo .
      661           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      662                                             , OUTPUT v-cntxt-userid
      663                                             ) .
      664           run gbl/wndsizew.p
      665             (input  v-cntxt-db-num
      666             ,input  v-cntxt-userid
      667             ,input  v-diasize-proc-name
      668             ,input  'height':u
      669             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
      670             ) .
      671         end.
      672       end.
      673     end.
      674     assign
      675       v-diasize-change-size = false
      676     .
      677   end procedure.
      678   procedure diasize_set-height :
      679     define input  parameter p-new-height  as decimal   no-undo .
      680     define input  parameter p-move-resize as logical   no-undo .
      681     do
      682     on error undo, return error return-value
      683     :
      684       run diasize_change-height in this-procedure
      685         (input  (p-new-height - frame DIALOG-1 :height)
      686         ,input  p-move-resize
      687         ) .
      688     end.
      689   end procedure.
      690   procedure diasize_change-width :
      691     define input  parameter p-change-value as decimal   no-undo .
      692     define input  parameter p-move-resize  as logical   no-undo .
      693     define variable v-field-group-handle   as handle    no-undo .
      694     define variable v-object-handle        as handle    no-undo .
      695     define variable v-frame-width          as decimal   no-undo .
      696     define variable v-frame-virtual-width  as decimal   no-undo .
      697     define variable v-browse-width         as decimal   no-undo .
      698     define variable v-window-width         as decimal   no-undo .
      699     define variable v-window-virtual-width as decimal   no-undo .
      700     define variable v-change-sign          as integer   no-undo .
      701     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      702     define buffer buf_temp-browse-handle  for temp-browse-handle .
      703     if p-change-value > 0
      704     then do:
      705       if frame DIALOG-1 :width + p-change-value >
      706           session :width-chars
      707       then do:
      708         assign
      709           p-change-value = session :width-chars - frame DIALOG-1 :width
      710         .
      711         if p-change-value <= 0
      712         then do:
      713           run diasize_position-resize-button in this-procedure .
      714           return .
      715         end.
      716       end.
      717     end.
      718     if p-change-value < 0
      719     then do:
      720       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
      721       then do:
      722         assign
      723           p-change-value = v-diasize-orig-frame-width
      724                          - frame DIALOG-1 :width
      725         .
      726         if p-change-value >= 0
      727         then do:
      728           run diasize_position-resize-button in this-procedure .
      729           return .
      730         end.
      731       end.
      732     end.
      733     if p-change-value >= 0
      734     then do:
      735       assign
      736         v-change-sign = 1
      737       .
      738     end.
      739     else do:
      740       assign
      741         v-change-sign = -1
      742       .
      743     end.
      744     assign
      745       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      746     .
      747     if p-change-value = 0
      748     then do:
      749       run diasize_position-resize-button in this-procedure .
      750       return .
      751     end.
      752     move_block:
      753     do
      754     on error undo move_block, leave move_block
      755     :
      756       if retry
      757       then do:
      758         do
      759         on error undo move_block, leave move_block
      760         :
      761           if p-change-value > 0
      762           then do:
      763             for each buf_temp-diasize-handle
      764             on error undo, next
      765             :
      766               assign
      767                 v-object-handle = buf_temp-diasize-handle.handle-value
      768               .
      769               if v-object-handle <> v-diasize-resize-button
      770               then do:
      771                 assign
      772                   v-object-handle :col = buf_temp-diasize-handle.save-position
      773                 .
      774               end.
      775             end.
      776             assign
      777               v-diasize-browse-handle :width = v-browse-width
      778             .
      779             for each buf_temp-browse-handle
      780               where buf_temp-browse-handle.browse-type = 'width':u
      781             on error undo, next
      782             :
      783               assign
      784                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      785               .
      786             end.
      787             assign
      788               frame DIALOG-1 :width = v-frame-width
      789             .
      790             if frame DIALOG-1 :scrollable = true
      791             then do:
      792               assign
      793                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
      794               .
      795             end.
      796             run diasize_position-resize-button in this-procedure .
      797           end.
      798           else do:
      799             if frame DIALOG-1 :scrollable = true
      800             then do:
      801               assign
      802                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
      803               .
      804             end.
      805             assign
      806               frame DIALOG-1 :width = v-frame-width
      807             .
      808             for each buf_temp-browse-handle
      809               where buf_temp-browse-handle.browse-type = 'width':u
      810             on error undo, next
      811             :
      812               assign
      813                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      814               .
      815             end.
      816             assign
      817               v-diasize-browse-handle :width = v-browse-width
      818             .
      819             for each buf_temp-diasize-handle
      820             on error undo, next
      821             :
      822               assign
      823                 v-object-handle = buf_temp-diasize-handle.handle-value
      824               .
      825               if v-object-handle <> v-diasize-resize-button
      826               then do:
      827                 assign
      828                   v-object-handle :col = buf_temp-diasize-handle.save-position
      829                 .
      830               end.
      831             end.
      832             run diasize_position-resize-button in this-procedure .
      833           end.
      834           assign
      835             v-diasize-change-size = false
      836           .
      837           leave move_block .
      838         end.
      839       end.
      840       assign
      841         v-diasize-need-full-display = true
      842       .
      843       if v-diasize-change-size = false
      844       then do:
      845         assign
      846           v-diasize-change-size = true
      847         .
      848       end.
      849       else do:
      850         return .
      851       end.
      852       assign
      853         v-frame-width = frame DIALOG-1 :width
      854         v-frame-virtual-width = frame DIALOG-1 :virtual-width
      855         v-browse-width = v-diasize-browse-handle :width
      856       .
      857       for each buf_temp-browse-handle
      858         where buf_temp-browse-handle.browse-type = 'width':u
      859       :
      860         assign
      861           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      862         .
      863       end.
      864       for each buf_temp-diasize-handle
      865       :
      866         delete buf_temp-diasize-handle .
      867       end.
      868       assign
      869         v-field-group-handle = frame DIALOG-1 :first-child
      870       .
      871       do while valid-handle(v-field-group-handle)
      872       :
      873         assign
      874           v-object-handle = v-field-group-handle :first-child
      875         .
      876         do while valid-handle(v-object-handle)
      877         :
      878           if  v-object-handle <> v-diasize-browse-handle :handle
      879           and v-object-handle <> v-diasize-resize-button
      880           and can-query(v-object-handle, "row")
      881           and can-query(v-object-handle, "height")
      882           and ( v-object-handle :col + v-object-handle :width
      883                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      884               )
      885           then do:
      886             find first buf_temp-browse-handle
      887               where buf_temp-browse-handle.browse-type   = 'width':u
      888                 and buf_temp-browse-handle.browse-handle = v-object-handle
      889               no-error .
      890             if available buf_temp-browse-handle
      891             then do:
      892             end.
      893             else do:
      894               create buf_temp-diasize-handle .
      895               assign
      896                 buf_temp-diasize-handle.handle-value  = v-object-handle
      897                 buf_temp-diasize-handle.save-position = v-object-handle :col
      898               .
      899             end.
      900           end.
      901           assign
      902             v-object-handle = v-object-handle :next-sibling
      903           .
      904         end.
      905         assign
      906           v-field-group-handle = v-field-group-handle :next-sibling
      907         .
      908       end.
      909       do with frame DIALOG-1
      910       :
      911         hide v-diasize-resize-button .
      912         v-diasize-resize-button :row = 1.
      913         v-diasize-resize-button :column = 1.
      914       end.
      915       if p-change-value > 0
      916       then do:
      917         if frame DIALOG-1 :scrollable = true
      918         then do:
      919           assign
      920             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
      921             no-error .
      922           if error-status :error
      923           or error-status :get-message(1) <> ""
      924           then do:
      925             undo move_block, retry move_block.
      926           end.
      927         end.
      928         assign
      929           frame DIALOG-1 :width = v-frame-width + p-change-value
      930           no-error .
      931         if error-status :error
      932         or error-status :get-message(1) <> ""
      933         then do:
      934           undo move_block, retry move_block.
      935         end.
      936         assign
      937           v-diasize-browse-handle :width = v-browse-width + p-change-value
      938         no-error .
      939         if error-status :error
      940         or error-status :get-message(1) <> ""
      941         then do:
      942           undo move_block, retry move_block.
      943         end.
      944         for each buf_temp-browse-handle
      945           where buf_temp-browse-handle.browse-type = 'width':u
      946         on error undo move_block, retry move_block
      947         :
      948           assign
      949             buf_temp-browse-handle.browse-handle :width
      950               = buf_temp-browse-handle.browse-handle :width + p-change-value
      951             no-error .
      952           if error-status :error
      953           or error-status :get-message(1) <> ""
      954           then do:
      955             undo move_block, retry move_block .
      956           end.
      957         end.
      958         for each buf_temp-diasize-handle
      959         on error undo move_block, retry move_block
      960         :
      961           assign
      962             v-object-handle = buf_temp-diasize-handle.handle-value
      963           .
      964           if v-object-handle <> v-diasize-resize-button
      965           then do:
      966             assign
      967               v-object-handle :col = v-object-handle :col + p-change-value
      968               no-error .
      969             if error-status :error
      970             or error-status :get-message(1) <> ""
      971             then do:
      972               undo move_block, retry move_block .
      973             end.
      974           end.
      975         end.
      976       end.
      977       else do:
      978         for each buf_temp-diasize-handle
      979         on error undo move_block, retry move_block
      980         :
      981           assign
      982             v-object-handle = buf_temp-diasize-handle.handle-value
      983           .
      984           if v-object-handle <> v-diasize-resize-button
      985           then do:
      986             assign
      987               v-object-handle :col = v-object-handle :col + p-change-value
      988               no-error .
      989             if error-status :error
      990             or error-status :get-message(1) <> ""
      991             then do:
      992               undo move_block, retry move_block .
      993             end.
      994           end.
      995         end.
      996         for each buf_temp-browse-handle
      997           where buf_temp-browse-handle.browse-type = 'width':u
      998         on error undo move_block, retry move_block
      999         :
     1000           assign
     1001             buf_temp-browse-handle.browse-handle :width
     1002               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1003             no-error .
     1004           if error-status :error
     1005           or error-status :get-message(1) <> ""
     1006           then do:
     1007             undo move_block, retry move_block .
     1008           end.
     1009         end.
     1010         assign
     1011           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1012           no-error .
     1013         if error-status :error
     1014         or error-status :get-message(1) <> ""
     1015         then do:
     1016           undo move_block, retry move_block.
     1017         end.
     1018         assign
     1019           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     1020         no-error .
     1021         if error-status :error
     1022         or error-status :get-message(1) <> ""
     1023         then do:
     1024           undo move_block, retry move_block.
     1025         end.
     1026         if frame DIALOG-1 :scrollable = true
     1027         then do:
     1028           assign
     1029             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1030           no-error .
     1031           if error-status :error
     1032           or error-status :get-message(1) <> ""
     1033           then do:
     1034             undo move_block, retry move_block.
     1035           end.
     1036         end.
     1037       end.
     1038       if p-move-resize
     1039       then do:
     1040         run diasize_position-resize-button in this-procedure .
     1041       end.
     1042       if v-diasize-wndstore = true
     1043       then do:
     1044         if connected("ub") = true
     1045         then do:
     1046           define variable v-cntxt-db-num        as integer   no-undo .
     1047           define variable v-cntxt-userid        as character no-undo .
     1048           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1049                                             , OUTPUT v-cntxt-userid
     1050                                             ) .
     1051           run gbl/wndsizew.p
     1052             (input  v-cntxt-db-num
     1053             ,input  v-cntxt-userid
     1054             ,input  v-diasize-proc-name
     1055             ,input  'width':u
     1056             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     1057             ) .
     1058         end.
     1059       end.
     1060     end.
     1061     assign
     1062       v-diasize-change-size = false
     1063     .
     1064   end procedure.
     1065   procedure diasize_set-width :
     1066     define input  parameter p-new-width  as decimal   no-undo .
     1067     define input  parameter p-move-resize as logical   no-undo .
     1068     do
     1069     on error undo, return error return-value
     1070     :
     1071       run diasize_change-width in this-procedure
     1072         (input  (p-new-width - frame DIALOG-1 :width)
     1073         ,input  p-move-resize
     1074         ) .
     1075     end.
     1076   end procedure.
     1077   procedure diasize_position-resize-button :
     1078     do with frame DIALOG-1
     1079     :
     1080       hide v-diasize-resize-button .
     1081       assign
     1082         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     1083                     - 1
     1084                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     1085         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     1086                     - 1
     1087                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     1088       .
     1089       view v-diasize-resize-button .
     1090     end.
     1091   end procedure.
     1092   on alt-right anywhere
     1093   do:
     1094     run diasize_change-width in this-procedure
     1095       (input 1
     1096       ,input true
     1097       ) .
     1098     return no-apply .
     1099   end.
     1100   on alt-left anywhere
     1101   do:
     1102     run diasize_change-width in this-procedure
     1103       (input -1
     1104       ,input true
     1105       ) .
     1106     return no-apply .
     1107   end.
     1108   on alt-down anywhere
     1109   do:
     1110     run diasize_change-height in this-procedure
     1111       (input 1
     1112       ,input true
     1113       ) .
     1114     return no-apply .
     1115   end.
     1116   on alt-up anywhere
     1117   do:
     1118     run diasize_change-height in this-procedure
     1119       (input -1
     1120       ,input true
     1121       ) .
     1122     return no-apply .
     1123   end.
     1124   on alt-enter of frame DIALOG-1
     1125   do:
     1126     run diasize_maximize in this-procedure
     1127       (input  ?
     1128       ).
     1129     return no-apply .
     1130   end.
     1131   procedure diasize_end-move :
     1132     do
     1133     on error undo, return error return-value
     1134     :
     1135       define variable v-row-delta as decimal   no-undo .
     1136       define variable v-col-delta as decimal   no-undo .
     1137       define variable v-new-row as decimal   no-undo .
     1138       define variable v-new-col as decimal   no-undo .
     1139       assign
     1140         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1141         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1142       .
     1143       assign
     1144         v-row-delta = v-new-row - frame DIALOG-1 :height
     1145         v-col-delta = v-new-col - frame DIALOG-1 :width
     1146       .
     1147       run diasize_change-height in this-procedure
     1148         (input v-row-delta
     1149         ,input true
     1150         ) .
     1151       run diasize_change-width in this-procedure
     1152         (input v-col-delta
     1153         ,input true
     1154         ) .
     1155     end.
     1156   end procedure.
     1157   procedure diasize_maximize :
     1158     define input  parameter p-action as logical   no-undo .
     1159     do
     1160     on error undo, return error return-value
     1161     :
     1162       if p-action = ?
     1163       then do:
     1164         if v-diasize-need-maximize = true
     1165         then do:
     1166           assign
     1167             p-action = true
     1168           .
     1169         end.
     1170         else do:
     1171           assign
     1172             p-action = false
     1173           .
     1174         end.
     1175       end.
     1176       if p-action = true
     1177       then do:
     1178         run diasize_change-height in this-procedure
     1179           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1180               - frame DIALOG-1 :height-chars
     1181           ,input true
     1182           ) .
     1183         run diasize_change-width in this-procedure
     1184           (input session :width-chars
     1185               - frame DIALOG-1 :width-chars
     1186           ,input true
     1187           ) .
     1188         assign
     1189           v-diasize-need-maximize = false
     1190         .
     1191       end.
     1192       else do:
     1193         run diasize_change-width in this-procedure
     1194           (input v-diasize-orig-frame-width
     1195               - frame DIALOG-1 :width-chars
     1196           ,input true
     1197           ) .
     1198         run diasize_change-height in this-procedure
     1199           (input v-diasize-orig-frame-height
     1200               - frame DIALOG-1 :height-chars
     1201           ,input true
     1202           ) .
     1203         assign
     1204           v-diasize-need-maximize = true
     1205         .
     1206       end.
     1207     end.
     1208   end procedure.
     1209   procedure diasize_restore-orig-size :
     1210     do
     1211     on error undo, return error return-value
     1212     :
     1213       assign
     1214         v-diasize-current-frame-width  = frame DIALOG-1 :width
     1215         v-diasize-current-frame-height = frame DIALOG-1 :height
     1216       .
     1217       run diasize_set-height in this-procedure
     1218         (input  v-diasize-orig-frame-height
     1219         ,input  true
     1220         ) .
     1221       run diasize_set-width in this-procedure
     1222         (input  v-diasize-orig-frame-width
     1223         ,input  true
     1224         ) .
     1225     end.
     1226   end procedure.
     1227   procedure diasize_restore-current-size :
     1228     do
     1229     on error undo, return error return-value
     1230     :
     1231       run diasize_set-height in this-procedure
     1232         (input  v-diasize-current-frame-height
     1233         ,input  true
     1234         ) .
     1235       run diasize_set-width in this-procedure
     1236         (input  v-diasize-current-frame-width
     1237         ,input  true
     1238         ) .
     1239     end.
     1240   end procedure.
     1241   procedure diasize_set-browse-handle :
     1242     define input  parameter p-browse-handle as handle   no-undo .
     1243     define buffer buf_temp-browse-handle for temp-browse-handle .
     1244     do
     1245     on error undo, return error return-value
     1246     :
     1247       assign
     1248         v-diasize-browse-handle = p-browse-handle
     1249       .
     1250       for each buf_temp-browse-handle
     1251       on error undo, return error return-value
     1252       :
     1253         delete buf_temp-browse-handle .
     1254       end.
     1255     end.
     1256   end procedure.
     1257   procedure diasize_add_browse :
     1258     define input  parameter p-browse-type   as character no-undo .
     1259     define input  parameter p-browse-handle as handle    no-undo .
     1260     define buffer buf_temp-browse-handle for temp-browse-handle .
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       assign
     1265         v-diasize-browse-number = v-diasize-browse-number + 1
     1266       .
     1267       create buf_temp-browse-handle .
     1268       assign
     1269         buf_temp-browse-handle.browse-type   = p-browse-type
     1270         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1271         buf_temp-browse-handle.browse-handle = p-browse-handle
     1272       .
     1273     end.
     1274   end procedure.
     1275   procedure diasize_init :
     1276     define variable v-default-value    as logical   no-undo .
     1277     define variable v-restore-saved    as logical   no-undo .
     1278     define variable v-resize-value-str as character no-undo .
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       do with frame DIALOG-1
     1283       :
     1284         assign
     1285           v-diasize-orig-frame-height = frame DIALOG-1 :height
     1286           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     1287           v-diasize-browse-handle     = browse br-pr :handle
     1288         .
     1289         create button v-diasize-resize-button
     1290         assign
     1291           parent        = frame DIALOG-1 :first-child
     1292           label         = "s"
     1293           height-pixels = 16
     1294           width-pixels  = 16
     1295           visible       = true
     1296           sensitive     = true
     1297           movable       = true
     1298           triggers:
     1299             on end-move persistent run diasize_end-move in this-procedure .
     1300           end triggers.
     1301         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1302         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1303         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1304         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1305         assign
     1306           v-diasize-wndmax = false
     1307         .
     1308         if connected("ub") = true
     1309         then do:
     1310           define variable v-cntxt-db-num        as integer   no-undo .
     1311           define variable v-cntxt-userid        as character no-undo .
     1312           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1313                                             , OUTPUT v-cntxt-userid
     1314                                             ) .
     1315           run gbl/wndpar_r.p
     1316             (input  v-cntxt-db-num
     1317             ,input  v-cntxt-userid
     1318             ,input  'wndmax':U
     1319             ,output v-diasize-wndmax
     1320             ,output v-default-value
     1321             ) .
     1322         end.
     1323         assign
     1324           v-diasize-wndstore = false
     1325         .
     1326         if connected("ub") = true
     1327         then do:
     1328           run gbl/wndpar_r.p
     1329             (input  v-cntxt-db-num
     1330             ,input  v-cntxt-userid
     1331             ,input  'wndstore':U
     1332             ,output v-diasize-wndstore
     1333             ,output v-default-value
     1334             ) .
     1335         end.
     1336         assign
     1337           v-diasize-proc-name = entry(1, program-name(2), '.')
     1338         .
     1339         if v-diasize-wndstore = true
     1340         then do:
     1341           assign
     1342             v-restore-saved = false
     1343           .
     1344           if connected("ub") = true
     1345           then do:
     1346             run gbl/wndsizer.p
     1347               (input  v-cntxt-db-num
     1348               ,input  v-cntxt-userid
     1349               ,input  v-diasize-proc-name
     1350               ,input  'height':u
     1351               ,output v-resize-value-str
     1352               ) .
     1353             if v-resize-value-str <> '':U
     1354             then do:
     1355               run diasize_change-height in this-procedure
     1356                 (input  integer(v-resize-value-str)
     1357                 ,input  true
     1358                 ) .
     1359               assign
     1360                 v-restore-saved = true
     1361               .
     1362             end.
     1363           end.
     1364           if connected("ub") = true
     1365           then do:
     1366             run gbl/wndsizer.p
     1367               (input  v-cntxt-db-num
     1368               ,input  v-cntxt-userid
     1369               ,input  v-diasize-proc-name
     1370               ,input  'width':u
     1371               ,output v-resize-value-str
     1372               ) .
     1373             if v-resize-value-str <> '':U
     1374             then do:
     1375               run diasize_change-width in this-procedure
     1376                 (input  integer(v-resize-value-str)
     1377                 ,input  true
     1378                 ) .
     1379               assign
     1380                 v-restore-saved = true
     1381               .
     1382             end.
     1383           end.
     1384           if v-restore-saved <> true
     1385           then do:
     1386             if v-diasize-wndmax = true
     1387             then do:
     1388               run diasize_maximize in this-procedure
     1389                 (input  true
     1390                 ) .
     1391             end.
     1392           end.
     1393         end.
     1394         else do:
     1395           if v-diasize-wndmax = true
     1396           then do:
     1397             run diasize_maximize in this-procedure
     1398               (input  true
     1399               ) .
     1400           end.
     1401         end.
     1402       end.
     1403     end.
     1404   end procedure.
     1405   procedure diasize_need-full-display :
     1406     define output parameter p-need-full-display as logical   no-undo .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410       assign
     1411         p-need-full-display = v-diasize-need-full-display
     1412       .
     1413       assign
     1414         v-diasize-need-full-display = false
     1415       .
     1416     end.
     1417   end procedure.
     1418   procedure get-context :
     1419      define output parameter p-db-num as integer          no-undo.
     1420      define output parameter p-user-id as character        no-undo.
     1421      define variable v-login               as character    no-undo.
     1422      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1423      define buffer buf_user-login  for ub.user-login .
     1424      do
     1425      on error undo, return error
     1426      :
     1427            FIND FIRST buf_sys-ctrl no-lock.
     1428            ASSIGN
     1429               v-login = USERID("ub")
     1430               p-db-num = buf_sys-ctrl.db-num
     1431            .
     1432            FIND FIRST buf_user-login
     1433                 WHERE buf_user-login.db-num = p-db-num
     1434                   AND buf_user-login.user-login = v-login
     1435                 no-lock
     1436                 no-error
     1437                 .
     1438            IF AVAILABLE buf_user-login
     1439            THEN DO:
     1440               assign
     1441                  p-user-id = buf_user-login.user-id
     1442               .
     1443            END.
     1444      end.
     1445   end procedure.
     1446       run diasize_init in this-procedure .
     1447   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1448   MAIN-BLOCK:
     1449   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1450      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1451     frame DIALOG-1:title = "Цены на объекте : " + p-curr-obj-type + " "  + string (p-curr-obj-code) +
     1452                                   "   для товара : " + goods.artic     + " " + goods.gds-name.
     1453     find first gds-prt no-lock where
     1454                gds-prt.upper-code = goods.prt-root.
     1455     find bar-code no-lock where
     1456          bar-code.gds-code = goods.gds-code and
     1457          bar-code.unit-cli = goods.unit-base and
     1458          bar-code.node-code = gds-prt.node-code and
     1459          bar-code.in-code  = "" and
     1460          bar-code.part-code = "".
     1461     RUN enable_UI.
     1462     WAIT-FOR GO OF FRAME DIALOG-1.
     1463   END.
     1464   RUN disable_UI.
     1465   PROCEDURE disable_UI :
     1466     HIDE FRAME DIALOG-1.
     1467   END PROCEDURE.
     1468   PROCEDURE enable_UI :
     1469     ENABLE b-quit b-lkp b-help br-pr
     1470         WITH FRAME DIALOG-1.
     1471     OPEN QUERY br-pr FOR EACH price-list       WHERE price-list.obj-type = p-curr-obj-type and price-list.obj-code = p-curr-obj-code and price-list.b-code = bar-code.b-code and price-list.fact-order <> 0 and price-list.main-price = yes NO-LOCK,       EACH price-doc WHERE price-doc.doc-num = price-list.doc-num NO-LOCK     BY price-list.fact-order DESCENDING.
     1472   END PROCEDURE.
