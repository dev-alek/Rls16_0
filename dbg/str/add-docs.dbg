     2105           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2106         .
     2107         assign
     2108           self :screen-value = string(v-new-sv-date) .
     2109         .
     2110       end.
     2111     end.
     2112     return no-apply .
     2113   end.
     2114   on ctrl-e of sch-fact in frame Dialog-Frame
     2115   do:
     2116     if (can-query (self, "sensitive")
     2117        and
     2118        self :sensitive = true
     2119        )
     2120     or (can-query (self, "read-only")
     2121        and
     2122        self :read-only = false
     2123        )
     2124     then do:
     2125       if self :handle <> focus :handle
     2126       then do:
     2127         apply "entry":u to self .
     2128       end.
     2129       define variable v-curr-sv-date as date no-undo .
     2130       define variable v-new-sv-date  as date no-undo .
     2131       assign
     2132         v-curr-sv-date = date(self :screen-value) no-error
     2133       .
     2134       if v-curr-sv-date = ?
     2135       then do:
     2136         run gbl/getcurdt.p
     2137           (output v-curr-sv-date
     2138           ) .
     2139       end.
     2140       if v-curr-sv-date <> ?
     2141       then do:
     2142         run gbl/lastdate.p
     2143           (input  v-curr-sv-date
     2144           ,output v-new-sv-date
     2145           ).
     2146         assign
     2147           self :screen-value = string(v-new-sv-date) .
     2148         .
     2149       end.
     2150     end.
     2151     return no-apply .
     2152   end.
     2153   on ctrl-f of sch-fact in frame Dialog-Frame
     2154   do:
     2155     if (can-query (self, "sensitive")
     2156        and
     2157        self :sensitive = true
     2158        )
     2159     or (can-query (self, "read-only")
     2160        and
     2161        self :read-only = false
     2162        )
     2163     then do:
     2164       if self :handle <> focus :handle
     2165       then do:
     2166         apply "entry":u to self .
     2167       end.
     2168       define variable v-ok            as logical   no-undo .
     2169       define variable v-curr-sv-date  as date      no-undo .
     2170       define variable v-description   as character no-undo .
     2171       assign
     2172         v-curr-sv-date = date(self :screen-value) no-error
     2173       .
     2174       if v-curr-sv-date = ?
     2175       then do:
     2176         run gbl/getcurdt.p
     2177           (output v-curr-sv-date
     2178           ) .
     2179       end.
     2180       if v-curr-sv-date <> ?
     2181       then do:
     2182         run gbl/d-inpday.w
     2183           (input ?
     2184           ,input "Выбор даты"
     2185           ,input v-description
     2186           ,input ""
     2187           ,input-output v-curr-sv-date
     2188           ,output v-ok
     2189           ).
     2190         if v-ok = true
     2191         then do:
     2192           assign
     2193             self :screen-value = string(v-curr-sv-date) .
     2194           .
     2195         end.
     2196       end.
     2197     end.
     2198     return no-apply .
     2199   end.
