     1937        and
     1938        self :read-only = false
     1939        )
     1940     then do:
     1941       if self :handle <> focus :handle
     1942       then do:
     1943         apply "entry":u to self .
     1944       end.
     1945       define variable v-ok            as logical   no-undo .
     1946       define variable v-curr-sv-date  as date      no-undo .
     1947       define variable v-description   as character no-undo .
     1948       assign
     1949         v-curr-sv-date = date(self :screen-value) no-error
     1950       .
