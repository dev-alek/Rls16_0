      133   define new global shared variable g#library  as handle no-undo .
      134   define new global shared variable g#library2 as handle no-undo .
      135   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define variable c-point  as character no-undo .
      137   define variable tbl      as character no-undo .
      138   define variable join-tbl as character no-undo .
      139   define variable fld      as character no-undo .
      140   define variable lab      as character no-undo .
      141   define variable spr      as character no-undo .
      142   define variable dim      as character no-undo .
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   procedure cur-time :
      145      define output parameter p-today as date      no-undo .
      146      define output parameter p-time  as integer   no-undo .
      147     do
      148     on error undo, return error
      149     :
      150       define variable v-date1 as date      no-undo .
      151       define variable v-date2 as date      no-undo .
      152       define variable v-time  as integer   no-undo .
      153       assign
      154         v-date1 = today
      155         v-time  = time
      156         v-date2 = today
      157       .
      158       if v-date1 <> v-date2
      159       then do:
      160         assign
      161           v-date1 = today
      162           v-time  = v-time
      163         .
      164       end.
      165       assign
      166         p-today = v-date1
      167         p-time  = v-time
      168       .
      169     end.
      170   end.
      171   function cur-time-date returns character
      172   :
      173     return string(today, '99/99/9999':U) .
      174   end.
      175   function cur-time-mjd returns decimal
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return integer(v-date) - 2400002 + (v-time / 86400) .
      184   end.
      185   function cur-time-get-ending-index returns integer
      186   (input p-number as integer
      187   )
      188   :
      189     if p-number < 0
      190     or p-number = ?
      191     then do:
      192       return 1 .
      193     end.
      194     define variable v-rest as integer   no-undo .
      195     assign
      196       p-number = p-number modulo 100
      197     .
      198     if p-number < 20
      199     then do:
      200       assign
      201         v-rest = p-number
      202       .
      203     end.
      204     else do:
      205       assign
      206         v-rest = p-number modulo 10
      207       .
      208     end.
      209     case v-rest :
      210       when 1
      211       then do:
      212         return 2 .
      213       end.
      214       when 2 or
      215       when 3 or
      216       when 4
      217       then do:
      218         return 3 .
      219       end.
      220       otherwise do:
      221         return 1 .
      222       end.
      223     end case .
      224   end.
      225   procedure cur-time-mjd-to-date :
      226      define input  parameter i-mjd-diff as decimal no-undo.
      227      define output parameter o-Date     as date    no-undo.
      228      define output parameter o-Time     as integer no-undo.
      229      define variable v-day-number as integer   no-undo .
      230      if    i-mjd-diff < 0
      231         or i-mjd-diff = ?
      232      then do:
      233         return "?" .
      234      end.
      235      assign
      236         v-day-number = truncate(i-mjd-diff,0).
      237         o-Date = date(v-day-number + 2400002).
      238         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240   end.
      241   function cur-time-mjd-to-string returns character
      242   (input p-mjd-diff as decimal
      243   )
      244   :
      245     define variable v-day-number as integer   no-undo .
      246     define variable v-seconds    as integer   no-undo .
      247     define variable v-hour       as integer   no-undo .
      248     define variable v-min        as integer   no-undo .
      249     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      250     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      251     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      252     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      253     if p-mjd-diff < 0
      254     or p-mjd-diff = ?
      255     then do:
      256       return "?" .
      257     end.
      258     assign
      259       v-day-number = integer(truncate(p-mjd-diff,0))
      260       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262     if v-seconds > 86400
      263     then do:
      264       assign
      265         v-seconds = 86400 - 1
      266       .
      267     end.
      268     if v-seconds < 0
      269     then do:
      270       assign
      271         v-seconds = 0
      272       .
      273     end.
      274     assign
      275       v-hour = truncate(v-seconds / 3600, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 3600
      279     .
      280     assign
      281       v-min = truncate(v-seconds / 60, 0)
      282     .
      283     assign
      284       v-seconds = v-seconds modulo 60
      285     .
      286     return
      287         (if v-day-number <> 0
      288           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0
      292           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      296           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      297           else ""
      298         )
      299       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      300       .
      301   end.
      302   function cur-time-string returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-string-sec returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      321   end.
      322   function cur-time-custom  returns character
      323   (input p-prefix as character
      324   ,input p-date-format as character
      325   ,input p-delimiter as character
      326   ,input p-time-format as character
      327   ,input p-suffix as character
      328   )
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return
      337       p-prefix
      338       + string(v-date, p-date-format)
      339       + p-delimiter
      340       + string(v-time, p-time-format)
      341       + p-suffix
      342       .
      343   end.
      344   function cur-time-print  returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-datetime returns datetime
      355   :
      356     define variable v-char as character no-undo .
      357     define variable v-datetime as datetime no-undo .
      358     v-char = cur-time-string().
      359     v-datetime = datetime(v-char).
      360     return  v-datetime.
      361   end.
      362   function cur-time-string-msec returns character
      363   :
      364     define variable v-date as datetime  no-undo .
      365     v-date = now.
      366     return string(v-date) .
      367   end.
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      370   define new shared variable RepPathName        as character no-undo .
      371   define new shared variable PrintRubl          as logical   no-undo .
      372   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   procedure fltfield-clear :
      374     define output parameter loc-fld as character no-undo.
      375     define output parameter loc-lab as character no-undo .
      376     define output parameter loc-spr as character no-undo .
      377     define output parameter loc-dim as character no-undo .
      378     assign
      379       loc-fld = ""
      380       loc-lab = ""
      381       loc-spr = ""
      382       loc-dim = "0"
      383     .
      384   end procedure .
      385   procedure fltfield-add :
      386     define input        parameter par-fld as character no-undo.
      387     define input        parameter par-lab as character no-undo .
      388     define input        parameter par-spr as character no-undo .
      389     define input-output parameter loc-fld as character no-undo.
      390     define input-output parameter loc-lab as character no-undo .
      391     define input-output parameter loc-spr as character no-undo .
      392     define input-output parameter loc-dim as character no-undo .
      393     do
      394     on error undo, return error
      395     :
      396       assign
      397       loc-fld = if loc-dim = '0'
      398                 then par-fld
      399                 else (loc-fld + chr(44) + par-fld)
      400       loc-lab = if loc-dim = '0'
      401                 then par-lab
      402                 else (loc-lab + chr(44) + par-lab)
      403       loc-spr = if loc-dim = '0'
      404                 then par-spr
      405                 else (loc-spr + chr(44) + par-spr)
      406       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      407                 string(integer(if num-entries(loc-dim) > 1
      408                               then entry(2, loc-dim)
      409                               else entry(1, loc-dim)
      410                               ) + 1)
      411       no-error
      412       .
      413     end.
      414   end procedure.
      415   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      416   define  stream PrnLibStream.
      417   procedure prn-lib-prn-file :
      418     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      419     define input parameter p-DIsabledoptions as integer no-undo .
      420     define variable v-report-name as character no-undo .
      421     define variable v-user-action as character no-undo .
      422     define variable v-printed     as logical   no-undo .
      423     define variable v-exist       as logical   no-undo .
      424     do
      425       on error undo, return error
      426       :
      427       run prn-lib-get-report-name  in this-procedure (
      428         input parParentProc
      429         ,output v-report-name
      430         ).
      431   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      433     (input  v-report-name
      434     ,input  2
      435     ,output v-exist
      436     )  .
      437       if NOT v-exist then
      438       DO:
      439         Message
      440           "Нет заданий на печать ! "
      441           view-as alert-box .
      442         Return  .
      443       End.
      444       run gbl/prnfilen.w
      445         (input  ""
      446         ,input  p-DisabledOptions
      447         ,input  string(v-report-name )
      448         ,input  7
      449         ,output v-user-action
      450         ,output v-printed
      451         ) .
      452       if v-printed then
      453       do:
      454         return "YES" .
      455       end.
      456       else
      457       do:
      458         return "NO" .
      459       end.
      460     end.
      461   end procedure.
      462   procedure prn-lib-open-stream :
      463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      464     define input parameter p-page-size    as integer no-undo .
      465     define input parameter p-is-stream    as logical no-undo .
      466     define input parameter p-append       as logical no-undo .
      467     define variable v-report-name as character no-undo .
      468     do
      469       on error undo, return error
      470       :
      471       run prn-lib-get-report-name  in this-procedure (
      472         input parParentProc
      473         ,output v-report-name
      474         ).
      475       if p-is-stream then
      476       do:
      477         if p-append then
      478         do:
      479           output stream PrnLibStream to value( v-report-name )
      480             page-size value(p-page-size) append .
      481         end.
      482         if not p-append then
      483         do:
      484           output stream PrnLibStream to value( v-report-name )
      485             page-size value(p-page-size) .
      486         end.
      487       end.
      488       if not p-is-stream then
      489       do:
      490         if p-append then
      491         do:
      492           output to value( v-report-name )
      493             page-size value(p-page-size) append .
      494         end.
      495         if not p-append then
      496         do:
      497           output to value( v-report-name )
      498             page-size value(p-page-size) .
      499         end.
      500       end.
      501     end.
      502   end procedure.
      503   procedure prn-lib-open-exp :
      504     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      505     define input parameter p-is-stream    as logical no-undo .
      506     define input parameter p-is-append    as logical no-undo .
      507     define output parameter p-ReportFileName as char init "report" no-undo.
      508     define output parameter p-process as logical no-undo .
      509     define variable glog as logical no-undo .
      510     do
      511       on error undo, return error
      512       :
      513       SYSTEM-DIALOG GET-FILE p-ReportFileName
      514         TITLE      "Укажите путь"
      515         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      516         ASK-OVERWRITE
      517         CREATE-TEST-FILE
      518         SAVE-AS
      519         USE-FILENAME
      520         DEFAULT-EXTENSION "txt"
      521         UPDATE glog
      522         .
      523       if not glog then  return.
      524       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      525       if p-is-stream then
      526       do:
      527         if p-is-append then
      528         do:
      529           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      530         end.
      531         else
      532         do:
      533           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      534         end.
      535       end.
      536       else
      537       do:
      538         if p-is-append then
      539         do:
      540           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      541         end.
      542         else
      543         do:
      544           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      545         end.
      546       end.
      547       p-process = yes.
      548     end.
      549   end procedure.
      550   procedure prn-lib-get-report-name :
      551     define input parameter parParentProc  as widget-handle no-undo.
      552     define output parameter p-report-name as character no-undo .
      553     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      554   end procedure.
      555   procedure prn-lib-reportviewer-report-name :
