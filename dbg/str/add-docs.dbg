     2239   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2240   on help of frame Dialog-Frame
     2241   do:
     2242     run gbl/app_help.p
     2243       (input this-procedure :file-name
     2244       ,input ''
     2245       ,input ?
     2246       ) no-error.
     2247     if error-status :error then do:
     2248       message
     2249         "Ошибка при вызове помощи"
     2250         error-status :get-message(1)
     2251         view-as alert-box .
