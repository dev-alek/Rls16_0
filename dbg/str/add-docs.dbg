      909   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      911   procedure fltopend_fltopend :
      912   define input parameter p-parent-handle as handle no-undo .
      913   define input parameter p-qh as handle no-undo .
      914   define input parameter p-flt-open-open-query  as character no-undo .
      915   define input parameter p-where-cond as character no-undo .
      916   define input parameter p-use-indFIRST-query-tail as character no-undo .
      917   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      918   define input parameter p-indexed-reposition as character no-undo .
      919     do
      920     on error undo, return error
      921     :
      922   define variable v-prepare-string as character no-undo .
      923   define variable glog as logical no-undo .
      924   assign
      925   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      926                      p-where-cond + chr(32)  +
      927                      p-use-indFIRST-query-tail + chr(32) +
      928                      p-use-ind-sort-clmn-by + chr(32) +
      929                      p-indexed-reposition
      930   .
      931   assign
      932   glog = p-qh:query-prepare(v-prepare-string) no-error .
      933   if not glog
      934   or error-status:error then do:
      935     message error-status:get-message(1) view-as alert-box .
      936     undo, return error .
      937   end.
      938   assign
      939   glog = p-qh:query-open no-error .
      940   if not glog
      941   or error-status:error then do:
      942     message error-status:get-message(1) view-as alert-box .
      943     undo, return error .
      944   end.
      945     end.
      946   end procedure.
      947   procedure fltopend_fltfindd :
      948   define input parameter p-parent-handle as handle no-undo .
      949   define input parameter p-qh as handle no-undo .
      950   define input parameter p-rowid as rowid no-undo .
      951   define input parameter p-next as logical no-undo .
      952   define input parameter p-lock as integer no-undo .
      953   define input parameter p-bh as handle no-undo .
      954   define input parameter p-where-cond as character no-undo .
      955   define input parameter p-use-index-phrase as character no-undo .
      956   define variable glog as logical no-undo .
      957   define variable v-qh as handle no-undo .
      958   define variable v-bh as handle no-undo .
      959   define variable v-recid as recid no-undo .
      960   define variable v-prepare-string as character no-undo .
      961   do
      962   on error undo, return error
      963   on stop undo, return error
      964   :
      965     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      966     create buffer v-bh for table p-bh buffer-name p-bh:name.
      967     create query v-qh.
      968     v-qh:set-buffers(v-bh).
      969     v-prepare-string = substitute("for each &1 &2 &3"
      970                                     ,v-bh:name
      971                                     ,p-where-cond
      972                                     ,p-use-index-phrase).
      973     glog = v-qh:query-prepare(v-prepare-string) no-error.
      974     if not glog then do:
      975       delete object v-qh.
      976       delete object v-bh.
      977       undo, return error .
      978     end.
      979     glog = v-qh:query-open no-error .
      980     if not glog then do:
      981       delete object v-qh.
      982       delete object v-bh.
      983       undo, return error .
      984     end.
      985     if p-next then do:
      986       v-qh:reposition-to-rowid(p-rowid) no-error .
      987       glog = v-qh:get-next( p-lock) no-error .
      988       glog = v-qh:get-next( p-lock) no-error .
      989       if not glog or v-qh:query-off-end = yes then do:
      990         glog = v-qh:get-first( p-lock) no-error .
      991       end.
      992     end.
      993     else do:
      994       glog = v-qh:get-first( p-lock) no-error .
      995     end.
      996     v-recid = v-bh:recid no-error .
      997     delete object v-qh.
      998     delete object v-bh.
      999     return string(v-recid) .
     1000   end.
     1001   end procedure.
     1002   procedure fltopend_fltfindq :
     1003   define input parameter p-parent-handle as handle no-undo .
     1004   define input parameter p-qh as handle no-undo .
     1005   define input parameter p-next as logical no-undo .
     1006   define input parameter p-lock as integer no-undo .
     1007   define input parameter p-flt-open-open-query  as character no-undo .
     1008   define input parameter p-where-cond as character no-undo .
     1009   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1010   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1011   define input parameter p-indexed-reposition as character no-undo .
     1012   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1013   define variable glog as logical no-undo .
     1014   define variable v-qh as handle no-undo .
     1015   define variable v-bh as handle no-undo extent 18.
     1016   define variable v-rowid as rowid no-undo extent 18.
     1017   define variable v-ii as integer no-undo .
     1018   define variable v-prepare-string as character no-undo .
     1019   do
     1020   on error undo, return error
     1021   on stop undo, return error
     1022   :
     1023     create query v-qh.
     1024     do v-ii = 1 to p-qh:num-buffers:
     1025       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1026       assign
     1027       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1028       no-error.
     1029       v-qh:add-buffer(v-bh[v-ii]).
     1030     end.
     1031     assign
     1032     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1033                       p-where-cond + chr(32)  +
     1034                       p-use-indFIRST-query-tail + chr(32) +
     1035                       p-use-ind-sort-clmn-by + chr(32) +
     1036                       p-indexed-reposition
     1037     .
     1038     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1039     if not glog then do:
     1040       delete object v-qh.
     1041       do v-ii = 1 to p-qh:num-buffers:
     1042         delete object v-bh[v-ii].
     1043       end.
     1044       undo, return error .
     1045     end.
     1046     glog = v-qh:query-open no-error .
     1047     if not glog then do:
     1048       delete object v-qh.
     1049       do v-ii = 1 to p-qh:num-buffers:
     1050         delete object v-bh[v-ii].
     1051       end.
     1052       undo, return error .
     1053     end.
     1054     if p-next then do:
     1055       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1056       glog = v-qh:get-next( p-lock) no-error .
     1057       glog = v-qh:get-next( p-lock) no-error .
     1058       if not glog or v-qh:query-off-end = yes then do:
     1059         glog = v-qh:get-first( p-lock) no-error .
     1060       end.
     1061     end.
     1062     else do:
     1063       glog = v-qh:get-first( p-lock) no-error .
     1064     end.
     1065     do v-ii = 1 to p-qh:num-buffers:
     1066       assign
     1067       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1068       no-error.
     1069     end.
     1070     delete object v-qh.
     1071     do v-ii = 1 to p-qh:num-buffers:
     1072       delete object v-bh[v-ii].
     1073     end.
     1074   end.
     1075   end procedure.
     1076   define variable pp as character no-undo .
     1077   define variable ff as character no-undo .
     1078   define buffer buf_sysconf for ub.sysconf  .
     1079   find first buf_sysconf where buf_sysconf.host-code = par-host-code no-lock.
     1080   define variable v-cntxt-cash-pay  as integer   no-undo .
     1081   define variable v-cntxt-in-ov     as logical   no-undo .
     1082   define variable v-cntxt-base-code as integer   no-undo .
     1083   define variable v-cntxt-rsrv-time as integer   no-undo .
     1084   define variable v-cntxt-load-time as integer   no-undo .
     1085   define variable v-cntxt-holidays  as character no-undo .
     1086   define variable g#log as logical  no-undo .
     1087   assign
     1088     v-cntxt-cash-pay   = buf_sysconf.cash-pay
     1089     v-cntxt-base-code  = buf_sysconf.base-code
     1090     v-cntxt-in-ov      = buf_sysconf.in-ov
     1091     v-cntxt-rsrv-time  = buf_sysconf.rsrv-time
     1092     v-cntxt-load-time  = buf_sysconf.load-time
     1093     v-cntxt-holidays   = buf_sysconf.holidays
     1094   .
     1095   p-doc-type = 'при':U .
     1096   define variable filter-point as character no-undo init "Список Дополнительных расходов" .
     1097   define variable filter-point0 as character no-undo init "Дополнительные расходы" .
     1098   define variable sort-column-name as character no-undo .
     1099   define variable print-type as character no-undo.
     1100   define variable del-type as character no-undo.
     1101   define variable deleted as logical no-undo init no.
     1102   DEFINE VARIABLE change-type as character init "" no-undo .
     1103   define new shared variable br-handle as handle  no-undo .
     1104   DEFINE new SHARED VARIABLE Sort-gr AS LOGICAL
     1105        LABEL "Сортировать по группам товаров"
     1106        VIEW-AS TOGGLE-BOX
     1107        size 42.25 by 0.75 NO-UNDO init false .
     1108   DEFINE new Shared VARIABLE print-graft AS LOGICAL
     1109        LABEL "Отладочная печать"
     1110        VIEW-AS TOGGLE-BOX
     1111        size 42.25 by 0.75 NO-UNDO init true .
     1112   function fo-postavka return character (input p-rec as recid ).
     1113   define buffer loc-t-doc for ub.add-doc  .
     1114   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error .
     1115   if error-status :error then return '' .
     1116    if loc-t-doc.cr-incfo = yes then do:
     1117      return string (loc-t-doc.incfo-date, '99/99/99').
     1118    end.
     1119    else do:
     1120      if loc-t-doc.need-incfo = 0 then do:
     1121        return '--------'.
     1122      end.
     1123      if loc-t-doc.need-incfo = 1 then do:
     1124        return ''.
     1125      end.
     1126      if loc-t-doc.need-incfo = 2 then do:
     1127        return 'не опред'.
     1128      end.
     1129    end.
     1130   end function.
     1131   function sfactur return character (input p-rec as recid).
     1132   define buffer loc-t-doc for ub.add-doc  .
     1133   find  first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error .
     1134   if error-status :error then return '' .
     1135    if loc-t-doc.cr-factur = yes then do:
     1136      return string (loc-t-doc.factur-date, "99/99/99").
     1137    end.
     1138    else do:
     1139      if loc-t-doc.need-factur = 0 then do:
     1140        return "--------".
     1141      end.
     1142      if loc-t-doc.need-factur = 1 then do:
     1143        return "".
     1144      end.
     1145      if loc-t-doc.need-factur = 2 then do:
     1146        return "не опред".
     1147      end.
     1148    end.
     1149   end function.
     1150   DEFINE MENU m-fo
     1151          MENU-ITEM m_lookupFO     LABEL "Просмотр ФО"
     1152          MENU-ITEM m_gen-1        LABEL "Генерация ФО"
     1153          MENU-ITEM m_gen-2        LABEL "Отказаться от генерации ФО"
     1154          MENU-ITEM m_gen-3        LABEL "Снять признак - есть генерация ФО"
     1155          MENU-ITEM m_gen-4        LABEL "Снять 'не опред'".
     1156   DEFINE MENU m-sf
     1157          MENU-ITEM m_lookupsf     LABEL "Просмотр счетов-фактур"
     1158          MENU-ITEM m_gen-10       LABEL "Генерация счетов-фактур"
     1159          MENU-ITEM m_gen-20       LABEL "Отказаться от генерации"
     1160          MENU-ITEM m_gen-30       LABEL "Снять признак - есть генерация"
     1161          MENU-ITEM m_gen-40       LABEL "Снять 'не опред'".
     1162   DEFINE BUTTON b-add
     1163        LABEL "&Добавить":L
     1164        SIZE 9 BY 1 TOOLTIP "Добавить новый документ ДопРасх".
     1165   DEFINE BUTTON b-chg
     1166        LABEL "&Изменить":L
     1167        SIZE 12 BY 1 TOOLTIP "Корректировка документа ДопРасх".
     1168   DEFINE BUTTON b-close
     1169        LABEL "&Закрыть":L
     1170        SIZE 12 BY 1 TOOLTIP "Закрыть документ ДопРасх".
     1171   DEFINE BUTTON B-close-trn
     1172        LABEL "Закр&ыть ПН"
     1173        SIZE 14.38 BY 1 TOOLTIP "Закрыть Приходную накладную".
     1174   DEFINE BUTTON B-close-trn-all
     1175        LABEL "Закр&ыть ПН"
     1176        SIZE 14.38 BY 1 TOOLTIP "Закрыть связанные Приходные накладные".
     1177   DEFINE BUTTON b-del
     1178        LABEL "&Удалить":L
     1179        SIZE 12 BY 1 TOOLTIP "Удалитиь документ ДопРасх".
     1180   DEFINE BUTTON b-export
     1181        LABEL "&Экспорт":L
     1182        SIZE 12 BY 1 TOOLTIP "Экспорт в XML".
     1183   DEFINE BUTTON B-fo
     1184        LABEL "ФинОбяз"
     1185        SIZE 11 BY 1 TOOLTIP "Финансовые обязательства".
     1186   DEFINE BUTTON b-help
     1187        LABEL "Помо&щь":L
     1188        SIZE 2.38 BY 1.
     1189   DEFINE BUTTON b-lkp
     1190        LABEL "&Просмотр":L
     1191        SIZE 12 BY 1 TOOLTIP "Просмотр документа ДопРасх без корректировки".
     1192   DEFINE BUTTON B-lkp-2
     1193        LABEL "Просмо&тр ПН"
     1194        SIZE 12.5 BY 1 TOOLTIP "Просмотр приходной накладной".
     1195   DEFINE BUTTON b-mark
     1196        LABEL "&*":L
     1197        SIZE 3 BY 1.
     1198   DEFINE BUTTON b-open
     1199        LABEL "&Открыть":L
     1200        SIZE 12 BY 1 TOOLTIP "Открыть".
     1201   DEFINE BUTTON b-print
     1202        LABEL "Пе&ч":L
     1203        SIZE 3 BY 1 TOOLTIP "Печать документа ДопРасх".
     1204   DEFINE BUTTON b-quit AUTO-GO
     1205        LABEL "&Выход ":L
     1206        SIZE 12 BY 1 TOOLTIP "Выход из режима".
     1207   DEFINE BUTTON b-rep
     1208        LABEL "О&тчеты":L
     1209        SIZE 12 BY 1 TOOLTIP "Список отчетов по документам ДопРасх".
     1210   DEFINE BUTTON b-sch
     1211        LABEL "&Ф":L
     1212        SIZE 3 BY 1 TOOLTIP "Фильтр по списку документов ДопРасх".
     1213   DEFINE BUTTON b-sel
     1214        LABEL "Вы&бор ":L
     1215        SIZE 12 BY 1 TOOLTIP "Выход из режима и выбор текущего номера  документа ДопРасх".
     1216   DEFINE BUTTON b-sf
     1217        LABEL "&СчетФакт":L
     1218        SIZE 11 BY 1 TOOLTIP "Счета-фактуры".
     1219   DEFINE VARIABLE loc-creid AS CHARACTER FORMAT "X(256)":U
     1220        LABEL "Создал"
     1221         VIEW-AS TEXT
     1222        SIZE 16.38 BY .67
     1223        FGCOLOR 4  NO-UNDO.
     1224   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "x(12)"
     1225        LABEL "&Начало номера"
     1226        VIEW-AS FILL-IN
     1227        SIZE 12 BY 1 NO-UNDO.
     1228   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999"
     1229        LABEL "Д&ата"
     1230        VIEW-AS FILL-IN
     1231        SIZE 12 BY 1 NO-UNDO.
     1232   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999"
     1233        LABEL "Фа&кт"
     1234        VIEW-AS FILL-IN
     1235        SIZE 12 BY 1 NO-UNDO.
     1236   DEFINE VARIABLE sch-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1237         VIEW-AS TEXT
     1238        SIZE 9.63 BY .67 NO-UNDO.
     1239   DEFINE QUERY br-docs FOR
     1240         buf_add-doc SCROLLING.
     1241   DEFINE QUERY br-nakl FOR
     1242         buf_add-trn,
     1243         buf_trn-doc SCROLLING.
     1244   DEFINE BROWSE br-docs
     1245     QUERY br-docs NO-LOCK DISPLAY
     1246         mark-string(recid(buf_add-doc),rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
     1247         buf_add-doc.status_ COLUMN-LABEL 'Статус' Format "X(6)"
     1248         buf_add-doc.doc-code COLUMN-LABEL '№ док-та'
     1249         buf_add-doc.doc-date COLUMN-LABEL 'Создан' FORMAT "99/99/99"
     1250         buf_add-doc.fact-date COLUMN-LABEL 'Факт' FORMAT "99/99/99"
     1251         buf_add-doc.obj-code COLUMN-LABEL 'Объект' format ">>>>9"
     1252         buf_add-doc.obj-type COLUMN-LABEL 'Тип' format "x(3)"
     1253         buf_add-doc.sum-rubl COLUMN-LABEL 'Сумма (руб)' format ">>>>>>>>>9.99"
     1254         fo-postavka(recid(buf_add-doc))  @ pp  COLUMN-LABEL 'ФО'  format "X(11)"
     1255         sfactur(recid(buf_add-doc)) @ ff COLUMN-LABEL 'Счет-фактура' format "X(11)"
     1256     ENABLE
     1257          buf_add-doc.status_
     1258       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.38 BY 9.83
     1259            BGCOLOR 15 .
     1260   DEFINE BROWSE br-nakl
     1261     QUERY br-nakl NO-LOCK DISPLAY
     1262         buf_trn-doc.doc-code
     1263         buf_trn-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)"
     1264         buf_trn-doc.flag_ COLUMN-LABEL "Ок" FORMAT "+/-"
     1265         buf_trn-doc.cli-type + string(buf_trn-doc.cli-code)  COLUMN-LABEL "Контрагент"
     1266         buf_trn-doc.obj-type + string(buf_trn-doc.obj-code)  COLUMN-LABEL "Объект"
     1267         buf_trn-doc.doc-date
     1268         buf_trn-doc.fact-date
     1269         buf_trn-doc.tot-lines
     1270         buf_trn-doc.fact-qnty COLUMN-LABEL "Количество" FORMAT ">>>>>>>>9.<<<"
     1271         buf_trn-doc.tot-rubl  COLUMN-LABEL "Сумма (руб)" FORMAT ">>>>>>>>>9.99"
     1272         buf_trn-doc.contract-code COLUMN-LABEL "Вн.№ дог."
     1273         buf_trn-doc.out-code COLUMN-LABEL "Ссылка"
     1274       WITH NO-ROW-MARKERS SEPARATORS SIZE 94.75 BY 8.46.
     1275   DEFINE FRAME Dialog-Frame
     1276        b-quit AT ROW 1 COL 2
     1277        b-sel AT ROW 1 COL 14
     1278        b-rep AT ROW 1 COL 26
     1279        b-close AT ROW 1 COL 38
     1280        b-open AT ROW 1 COL 50
     1281        B-close-trn-all AT ROW 1 COL 62 WIDGET-ID 2
     1282        B-fo AT ROW 1 COL 76.5 WIDGET-ID 4
     1283        b-help AT ROW 1 COL 94
     1284        b-mark AT ROW 2 COL 2
     1285        b-add AT ROW 2 COL 5
     1286        b-lkp AT ROW 2 COL 14
     1287        b-chg AT ROW 2 COL 26
     1288        b-del AT ROW 2 COL 38
     1289        b-export AT ROW 2 COL 50 WIDGET-ID 6
     1290        b-sf AT ROW 2 COL 76.5 WIDGET-ID 8
     1291        b-print AT ROW 2 COL 93
     1292        b-sch AT ROW 3 COL 93
     1293        sch-code AT ROW 3.08 COL 26 COLON-ALIGNED
     1294        sch-date AT ROW 3.08 COL 47 COLON-ALIGNED
     1295        sch-fact AT ROW 3.08 COL 65.75 COLON-ALIGNED
     1296        br-docs AT ROW 4.21 COL 1
     1297        B-lkp-2 AT ROW 14.21 COL 1.5
     1298        B-close-trn AT ROW 14.21 COL 14.13
     1299        br-nakl AT ROW 15.25 COL 1.5
     1300        sch-num AT ROW 3.25 COL 80.38 COLON-ALIGNED NO-LABEL
     1301        loc-creid AT ROW 14.33 COL 78 COLON-ALIGNED
     1302        " Поиск по:" VIEW-AS TEXT
     1303             SIZE 10.13 BY .67 AT ROW 3.25 COL 1.63
     1304             BGCOLOR 3 FGCOLOR 15
     1305        SPACE(84.62) SKIP(19.79)
     1306       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1307            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1308            TITLE "Список Дополнительных расходов".
     1309   ASSIGN
     1310          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1311          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1312   ASSIGN
     1313          B-close-trn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1314   ASSIGN
     1315          B-fo:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-fo:HANDLE.
     1316   ASSIGN
     1317          b-sf:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-sf:HANDLE.
     1318   ASSIGN
     1319          br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     1320   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1321   DO:
     1322     delete widget-pool "my-pool" no-error  .
     1323     APPLY "END-ERROR":U TO SELF.
     1324   END.
     1325   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1326   DO:
     1327     run proc-add in this-procedure .
     1328   END.
     1329   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1330   DO:
     1331   do on stop undo, return no-apply :
     1332     find current buf_add-doc exclusive-lock no-error .
     1333   end.
     1334   define variable rr as recid no-undo .
     1335   define buffer buf_clients for ub.clients.
     1336   define buffer obj_clients for ub.clients.
     1337    if not available buf_add-doc then return.
     1338   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   do:
     1340     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1341       (input  v-cntxt-db-num
     1342       ,input  v-cntxt-userid
     1343       ,input  0
     1344       ,input  'actn_add-d_update':U
     1345       ,input  'object':U
     1346       ,input  buf_add-doc.host-code
     1347       ,input  buf_add-doc.obj-type
     1348       ,input  buf_add-doc.obj-code
     1349       ,input  0
     1350       ,input  0
     1351       ,input  0
     1352       ,input  true
     1353       ,output g-log
     1354       )  .
     1355   end.
     1356     if not g-log then  return .
     1357      if not ( buf_add-doc.status_ = 'новый':U  ) then do:
     1358         message "Нельзя корректировать документ ДопРасх! " view-as alert-box  .
     1359         return.
     1360     end.
     1361     if   buf_add-doc.status_ = 'новый':U  and
     1362           not (p-obj-code = buf_add-doc.obj-code and
     1363                p-obj-type = buf_add-doc.obj-type ) then do:
     1364       message "Корректирование в этом статусе возможно на объекте: "
     1365           buf_add-doc.obj-code
     1366           buf_add-doc.obj-type
     1367           view-as alert-box error .
     1368           return .
     1369     end.
     1370     rr = recid(buf_add-doc) .
     1371     run str/add-docu.w
     1372       ( input parparentproc,
     1373         input-output rr ,
     1374         input 'ИЗМЕНЕНИЕ':U,
     1375         input "" ) .
     1376     v-doc-rec = rr .
     1377     g#log =  br-docs:refresh() .
     1378     apply "value-changed" to br-docs in frame dialog-frame.
     1379     apply "entry" to br-docs in frame dialog-frame.
     1380   END.
     1381   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     1382   DO:
     1383   define variable rr as recid no-undo .
     1384     if not available buf_add-doc then return.
     1385     rr = recid(buf_add-doc) .
     1386     run proc-close-add-doc in this-procedure  .
     1387     run openbr in this-procedure (yes, no, '':u).
     1388     reposition br-docs to recid rr no-error.
     1389     apply "value-changed" to br-docs in frame dialog-frame.
     1390     apply "entry" to br-docs in frame dialog-frame.
     1391   END.
     1392   ON CHOOSE OF B-close-trn IN FRAME Dialog-Frame
     1393   DO:
     1394    if not available buf_trn-doc   then return.
     1395    message "Закрыть накладную ?"
     1396     view-as alert-box question
     1397     buttons yes-no
     1398     update g-log
     1399     .
     1400     if g-log = false then return no-apply.
     1401     run close-nakl in this-procedure ( input buf_trn-doc.doc-code ) .
     1402     OPEN QUERY br-nakl FOR EACH buf_add-trn WHERE                   buf_add-trn.doc-code = buf_add-doc.doc-code NO-LOCK,              EACH buf_trn-doc  where                  buf_trn-doc.doc-code =  buf_add-trn.trn-doc-code NO-LOCK.
     1403   END.
     1404   ON CHOOSE OF B-close-trn-all IN FRAME Dialog-Frame
     1405   DO:
     1406    define variable rr as recid no-undo .
     1407    if not available buf_add-doc then return.
     1408    if buf_add-doc.status_ <> 'факт':U then do:
     1409       message 'Документ ДопРасходов должен быть закрыт на факт' view-as alert-box information .
     1410       return no-apply.
     1411    end.
     1412     message "Закрыть накладные по документу ДопРасходов ?"
     1413       view-as alert-box question
     1414       buttons yes-no
     1415       update g-log
     1416       .
     1417     if g-log = false then return no-apply.
     1418     rr = recid(buf_add-doc) .
     1419     run close-all ( buf_add-doc.doc-code ) no-error .
     1420     if error-status :error then
     1421        message 'Не удалось закрыть ПН !' view-as alert-box information .
     1422     else do:
     1423     run openbr in this-procedure (yes, no, '':u).
     1424     reposition br-docs to recid rr no-error.
     1425     OPEN QUERY br-nakl FOR EACH buf_add-trn WHERE                   buf_add-trn.doc-code = buf_add-doc.doc-code NO-LOCK,              EACH buf_trn-doc  where                  buf_trn-doc.doc-code =  buf_add-trn.trn-doc-code NO-LOCK.
     1426     end.
     1427   END.
     1428   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1429   DO:
     1430   if not available buf_add-doc then return.
     1431   do on stop undo, return no-apply :
     1432     find current buf_add-doc exclusive-lock .
     1433   end.
     1434     if   not (p-obj-code = buf_add-doc.obj-code and
     1435               p-obj-type = buf_add-doc.obj-type ) then do:
     1436       message "Удалить этом статусе возможно на объекте: "
     1437         buf_add-doc.obj-code
     1438         buf_add-doc.obj-type
     1439         view-as alert-box error .
     1440         return .
     1441     end.
     1442     define buffer bufs_add-trn for ub.add-trn  .
     1443     define variable v-i as integer   no-undo .
     1444     define variable v-s as character no-undo .
     1445     v-i = 0.
     1446     v-s = "" .
     1447     for each  bufs_add-trn no-lock where
     1448               bufs_add-trn.doc-code = buf_add-doc.doc-code :
     1449         v-i = v-i + 1.
     1450         v-s = v-s + bufs_add-trn.trn-doc-code + ',' .
     1451     end.
     1452     v-s = trim(v-s ,',') .
     1453     if v-i > 1 then do:
     1454        message
     1455         substitute("К ДопРасх № &1 прикреплены &2 ПН : &3. Удалеем ? " ,buf_add-doc.doc-code , v-i, v-s )
     1456         view-as alert-box question
     1457         buttons yes-no
     1458         update vok as log
     1459        .
     1460        if vok = false then return .
     1461     end.
     1462     run ord-del in this-procedure ( recid ( buf_add-doc ) ) no-error .
     1463     if error-status :error then message
     1464       vss-workfile vss-revision vss-description skip
     1465       error-status :get-message(1) skip
     1466       return-value skip
     1467       "Ошибка из ord-del"
     1468       view-as alert-box error
     1469     .
     1470   END.
     1471   ON CHOOSE OF b-export IN FRAME Dialog-Frame
     1472   DO:
     1473     if not available buf_add-doc then return.
     1474     run export-doc in this-procedure ( buf_add-doc.doc-code ) .
     1475   END.
     1476   ON CHOOSE OF B-fo IN FRAME Dialog-Frame
     1477   DO:
     1478   END.
     1479   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1480   DO:
     1481    if not available buf_add-doc then return .
     1482    define variable rr as recid no-undo .
     1483    rr = recid(buf_add-doc) .
     1484         br-handle = br-docs:handle in frame Dialog-Frame .
     1485         next-prev = no.
     1486         do while next-prev <> ?:
     1487           if not available buf_add-doc then do:
     1488             message "Неправильный выбор документа.".
     1489             return no-apply.
     1490           end.
     1491             run str/add-docu.w
     1492                ( input parparentproc,
     1493                  input-output rr ,
     1494                  input 'ПРОСМОТР':U ,
     1495                  input "" ).
     1496             v-doc-rec = rr .
     1497             next-prev = ?.
     1498           if br-handle = ? then reposition br-docs to recid rr no-error.
     1499         end.
     1500   apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1501   END.
     1502   ON CHOOSE OF B-lkp-2 IN FRAME Dialog-Frame
     1503   DO:
     1504      if not available buf_trn-doc then return .
     1505         run str/showdoc.p
     1506             (input parparentproc
     1507             ,input buf_trn-doc.doc-code
     1508             ,input ""
     1509             ,input ""
     1510             ,input 0
     1511             ,input true
     1512             ) no-error .
     1513             if error-status :error then message
     1514               vss-workfile vss-revision vss-description skip
     1515               error-status :get-message(1) skip
     1516               return-value skip
     1517               "Ошибка из showdoc.p"
     1518               view-as alert-box error
     1519             .
     1520   END.
     1521   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1522   DO:
     1523           if available buf_add-doc then do:
     1524   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   define variable v-str-recid17 as character no-undo .
     1526   define variable v-num-entry17 as integer   no-undo .
     1527   assign
     1528     v-str-recid17 = trim( string( recid( buf_add-doc ) , "->>>>>>>>>>>9":U ) )
     1529     v-num-entry17 = lookup( v-str-recid17 , rid-list )
     1530   .
     1531   if v-num-entry17 > 0 then do:
     1532     assign
     1533       entry( v-num-entry17, rid-list ) = "":U
     1534       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1535     .
     1536   end.
     1537   else do:
     1538     assign
