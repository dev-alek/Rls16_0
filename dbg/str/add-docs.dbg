     1876           (output v-curr-sv-date
     1877           ) .
     1878       end.
     1879       if v-curr-sv-date <> ?
     1880       then do:
     1881         assign
     1882           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1883         .
     1884         assign
     1885           self :screen-value = string(v-new-sv-date) .
     1886         .
     1887       end.
     1888     end.
     1889     return no-apply .
     1890   end.
     1891   on ctrl-e of sch-date in frame Dialog-Frame
     1892   do:
     1893     if (can-query (self, "sensitive")
     1894        and
