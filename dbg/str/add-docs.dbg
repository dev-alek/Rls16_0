     1596     OPEN QUERY br-nakl FOR EACH buf_add-trn WHERE                   buf_add-trn.doc-code = buf_add-doc.doc-code NO-LOCK,              EACH buf_trn-doc  where                  buf_trn-doc.doc-code =  buf_add-trn.trn-doc-code NO-LOCK.
     1597   END.
     1598   ON CHOOSE OF MENU-ITEM m_gen-1
     1599   DO:
     1600   define variable rr as recid no-undo .
     1601   define variable vari as integer   no-undo .
     1602   define variable vardoc-code as character no-undo .
     1603   if rid-list = "" then do:
     1604     if available buf_add-doc then do:
     1605       assign
     1606         rid-list = string(recid(buf_add-doc)).
     1607     end.
     1608   end.
     1609   vari-cycle:
     1610   do vari = 1 to num-entries (rid-list):
     1611     assign
     1612       vardoc-code = entry (vari, rid-list).
     1613       find first buf_add-doc no-lock where
     1614                  recid(buf_add-doc) = int(vardoc-code) no-error .
     1615    if error-status :error then do:
     1616       next.
     1617    end.
     1618    if buf_add-doc.status_ <> 'факт':U then do:
     1619       message 'Документ ДопРасходов должен быть закрыт на факт' view-as alert-box information .
     1620       return no-apply.
     1621    end.
     1622     message "Сгенерить ФО по документу ДопРасходов " buf_add-doc.doc-code " ?  "
     1623       view-as alert-box question
     1624       buttons yes-no
     1625       update g-log
     1626       .
     1627     if g-log = false then next.
     1628     rr = recid (buf_add-doc) .
     1629     run make-fo  no-error .
     1630       if error-status :error then do:
     1631         message 'Не удалось создать ФО!' view-as alert-box information .
     1632       end.
     1633    end.
