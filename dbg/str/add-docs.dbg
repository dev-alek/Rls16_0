     5204       ,input  buf_add-doc.obj-type
     5205       ,input  buf_add-doc.obj-code
     5206       ,input  0
     5207       ,input  0
     5208       ,input  0
     5209       ,input  true
     5210       ,output g-log
     5211       )  .
