     4708         .
     4709       end.
     4710       if l-filter-open-34 = false then do:
     4711         message
     4712           "Ошибка при фильтрации / сортировке" skip
     4713           "Будут показаны записи без учета фильтра" skip
     4714           view-as alert-box .
     4715       end.
     4716       else do:
     4717           assign
     4718             l-query-was-opened = true
     4719           .
     4720       end.
     4721     end.
