      560   procedure prn-lib-reportviewer :
      561     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      562     define input parameter p-report-name-html as character no-undo .
      563     define input parameter p-param        as character no-undo .
      564     define variable v-excel           as character no-undo init 'TRUE' .
      565     define variable v-value-character as character no-undo .
      566     define variable v-value-integer   as character no-undo .
      567     define variable v-value-date      as date      no-undo .
      568     define variable v-value-decimal   as decimal   no-undo .
      569     define variable rep-excel         as logical   no-undo .
      570     define variable excel-string      as character no-undo .
      571     define variable v-param-type      as character no-undo .
      572     define variable v-tth             as handle    no-undo .
      573     run adm/shattri.p (
      574       input "get":U
      575       ,input  ""
      576       ,input  0
      577       ,input  'report-glob':U
      578       ,input  'rep-excel':U
      579       ,output v-value-character
      580       ,output v-value-date
      581       ,output v-value-decimal
      582       ,output v-value-integer
      583       ,output rep-excel
      584       ,output v-param-type
      585       ,INPUT-OUTPUT table-handle v-tth
      586       )  .
      587     if rep-excel then v-excel = "TRUE" .
      588     else v-excel = "FALSE" .
      589     if p-param eq ""
      590     then
      591        p-param = "EXCEL:" + v-excel.
      592     else
      593        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      594     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      595   end procedure.
      596   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   define variable v-waitfram-action01         as character   no-undo .
      598   define variable v-waitfram-action02         as character   no-undo .
      599   define variable v-waitfram-action03         as character   no-undo .
      600   define variable mWaitFramTextBeg            as character   no-undo.
      601   define variable mWaitFramTextEnd            as character   no-undo.
      602   define variable mWaitFramView               as logical     no-undo.
      603   define variable mWaitProcEvent              as logical     no-undo init yes.
      604   define variable mWaitFramInterval           as integer     no-undo init 1 .
      605   define variable mWaitFramStop               as logical     no-undo.
      606   define variable mWaitFramStopUser           as logical     no-undo.
      607   define variable mWaitFramStopTimeOut        as logical     no-undo.
      608   define variable mWaitFramStartProc          as datetime-tz no-undo.
      609   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      610   define button B-WaitFramStop auto-end-key
      611        label "Стоп"
      612        size 10 by 1 tooltip "Остоновить процесс".
      613   define button B-viewProcInfo
      614        label "Информация"
      615        size 15 by 1 tooltip "Информация о процесс".
      616   define frame waitfram
      617     v-waitfram-action01 format "x(72)" no-label skip
      618     v-waitfram-action02 format "x(72)" no-label skip
      619     v-waitfram-action03 format "x(72)" no-label skip
      620     B-viewProcInfo
      621     B-WaitFramStop at row 4 col 30
      622     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      623     .
      624   define new global shared variable mBatchMode as logical no-undo init ?.
      625   define variable mFramBachModHandle as handle no-undo.
      626   mFramBachModHandle = frame waitfram:handle.
      627   define variable mFameOldVis as logical no-undo.
      628   define variable mVisCUrentVin as logical no-undo.
      629   if session:batch-mode
      630   then
      631      mBatchMode = yes.
      632   if mBatchMode = ? then do:
      633     mVisCUrentVin = current-window:visible.
      634     mFameOldVis = mFramBachModHandle:visible.
      635     mFramBachModHandle:visible  = yes.
      636     mBatchMode = mFramBachModHandle:visible ne yes.
      637     mFramBachModHandle:visible = mFameOldVis.
      638     current-window:visible = mVisCUrentVin.
      639   end.
      640    if  log-manager:logfile-name ne ?
      641     then DO:
      642         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      643         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      644         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      645     end.
      646   on choose of B-WaitFramStop in frame waitfram
      647   do:
      648     mWaitFramStop = yes.
      649     mWaitFramStopUser = yes.
      650   end.
      651   function waitfram-check-timeout returns logical():
      652      define variable vtime as int64 no-undo.
      653      if mWaitFramStopTimeOut
      654      then
      655         return yes.
      656      vtime = ( now - mWaitFramStartProc ) / 1000 .
      657      if     mWaitFramTimeOut ne ?
      658         and mWaitFramTimeOut ne 0
      659         and mWaitFramTimeOut lt vtime
      660      then do:
      661         mWaitFramStopTimeOut = yes.
      662      end.
      663      return mWaitFramStopTimeOut.
      664   end.
      665   procedure waitfram-hide :
      666     if not session:batch-mode
      667     then do
      668     on error undo, return error return-value
      669     :
      670       pause 0 before-hide .
      671       if not mBatchMode then
      672         hide frame waitfram .
      673     if     not mWaitFramView
      674        and mWaitProcEvent
      675     then
      676       process events .
      677     end.
      678   end procedure.
      679   procedure waitfram-show :
      680     define input  parameter p-message as character no-undo .
      681     define variable v-left-margin as integer   no-undo .
      682     if not session:batch-mode
      683     then do
      684     on error undo, return error return-value
      685     :
      686       if length(p-message) <= 70 then do:
      687         assign
      688           v-left-margin = integer((70 - length(p-message)) / 2)
      689         .
      690         assign
      691           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      692         .
      693         assign
      694           v-waitfram-action01 = " "
      695           v-waitfram-action02 = " "
      696                                    + fill(" ", v-left-margin)
      697                                    + p-message
      698           v-waitfram-action03 = " "
      699         .
      700       end.
      701       else do:
      702         define variable vRindex1 as integer no-undo.
      703         define variable vRindex2 as integer no-undo.
      704         vRindex1 = r-index(p-message," ",70).
      705         if vRindex1 = 0
      706         then
      707            vRindex1 = 70.
      708         if length(p-message)  <= vRindex1 + 70 then do:
      709           assign
      710             v-waitfram-action01 = " "
      711             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      712             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      713           .
      714         end.
      715         else do:
      716           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      717           if vRindex2 <= vRindex1
      718           then
      719              vRindex2 = vRindex1 + 70.
      720           assign
      721             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      722             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      723             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      724           .
      725         end.
      726       end.
      727       B-viewProcInfo:visible   in frame waitfram = no.
      728       B-viewProcInfo:sensitive in frame waitfram = no.
      729       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      730       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      731       if  (   mWaitFramView
      732          or  mWaitProcEvent)
      733          and not mBatchMode
      734       then
      735          display
      736             v-waitfram-action01 skip
      737             v-waitfram-action02 skip
      738             v-waitfram-action03 skip
      739          with frame waitfram .
      740       if     mWaitFramView
      741          then do:
      742             if     mWaitFramInterval ne ?
      743                and not mBatchMode
      744             then
      745                wait-for go of frame waitfram pause mWaitFramInterval.
      746          end.
      747          else
      748             if     mWaitProcEvent
      749                and not mBatchMode
      750             then
      751                process events .
      752     end.
      753   end procedure.
      754      procedure waitfram-show-this:
      755         define input  parameter iInterval as int64 no-undo.
      756         define variable vtime as int64 no-undo.
      757         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      758         mWaitFramInterval = iInterval.
      759         run waitfram-show (substitute("&1&2 &3&4" ,
      760                                       mWaitFramTextBeg ,
      761                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      762                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      763                                       mWaitFramTextEnd
      764                                      )
      765                           ).
      766      end.
      767      procedure WaitFramRunPause:
      768         define input  parameter iInterval as dec no-undo.
      769         define variable vStart  as datetime-tz no-undo.
      770         define variable vend    as datetime-tz no-undo.
      771         define variable vint as int64 no-undo.
      772         define variable vOk as logical no-undo.
      773         vStart = now.
      774         vend   = vStart.
      775         publish "WaitFramPause" (iInterval,output vOk).
      776         vend   =  now.
      777         vint = vend - vStart.
      778         vint = iInterval - vint / 1000.
      779         if     not mWaitFramStop
      780            and (   vint > 0
      781                 or (    not vOk
      782                     and iInterval eq ?
      783                     )
      784                 )
      785         then
      786            run waitfram-show-this (iInterval).
      787         vend   =  now.
      788         vint = vend - vStart.
      789         vint = iInterval - vint / 1000.
      790         if     not mWaitFramStop
      791            and vint > 0
      792         then do:
      793            run gbl/pause.p (vint * 1000).
      794         end.
      795         if iInterval ne ?
      796         then
      797            publish "WaitFramStop".
      798         waitfram-check-timeout().
      799      end.
      800      procedure WaitFramWaitFor:
      801         define input  parameter iInterval as dec no-undo.
      802         assign
      803            mWaitFramStartProc   = now
      804            mWaitFramStopUser    = no
      805            mWaitFramStopTimeOut = no
      806         .
      807         block-wait:
      808         do while not mWaitFramStop:
      809            run WaitFramRunPause (iInterval).
      810            if  waitfram-check-timeout()
      811            then do:
      812               leave block-wait.
      813            end.
      814         end.
      815         run waitfram-hide.
      816      end.
      817   procedure waitfram-join :
      818     define input  parameter p-line-1  as character no-undo .
      819     define input  parameter p-line-2  as character no-undo .
      820     define input  parameter p-line-3  as character no-undo .
      821     define output parameter p-message as character no-undo .
      822     do
      823     on error undo, return error return-value
      824     :
      825       assign
      826         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      827                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      828                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      829       .
      830     end.
      831   end procedure.
      832   function waitfram-join-function returns character
      833     (input p-line-1 as character
      834     ,input p-line-2 as character
      835     ,input p-line-3 as character
      836     ).
      837     define variable v-message as character no-undo .
      838     run waitfram-join in this-procedure
      839       (input  p-line-1
      840       ,input  p-line-2
      841       ,input  p-line-3
      842       ,output v-message
      843       ) .
      844     return v-message .
      845   end function .
