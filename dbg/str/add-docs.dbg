     1794   on ' ' of sch-date in frame Dialog-Frame
     1795   do:
     1796     if (can-query (self, "sensitive")
     1797        and
     1798        self :sensitive = true
     1799        )
     1800     or (can-query (self, "read-only")
     1801        and
     1802        self :read-only = false
     1803        )
     1804     then do:
     1805       assign
     1806         self :screen-value = ?
     1807       .
     1808     end.
     1809     return no-apply.
     1810   end.
     1811   on delete-character of sch-date in frame Dialog-Frame
     1812   do:
     1813     if (can-query (self, "sensitive")
     1814        and
     1815        self :sensitive = true
     1816        )
     1817     or (can-query (self, "read-only")
     1818        and
