     5217   define buffer buf_add-trn for ub.add-trn .
     5218   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5220     (input  buf_add-doc.obj-type
     5221     ,input  buf_add-doc.obj-code
     5222     ,output v-db-num
     5223     )  .
     5224   if v-db-num  <> v-cntxt-db-num then  do:
     5225       message 'Удаление возможно в БД ' v-db-num view-as alert-box information .
     5226       return .
     5227   end.
     5228   message "Удалить запись ?"
     5229   view-as alert-box question
     5230   buttons yes-no
     5231   update g-log.
     5232   if g-log = false then return no-apply.
     5233   run waitfram-show ("Ждите! Удаление ДопРасходов и накладных закрытых на факт") .
     5234   dtr:
     5235   do transaction
     5236      ON ERROR   UNDO dtr, LEAVE
     5237      ON END-KEY UNDO dtr, LEAVE
     5238      ON STOP    UNDO dtr, LEAVE
     5239      :
     5240     find current buf_add-doc  exclusive-lock   no-error .
     5241     if error-status :error then do:
     5242        message
     5243          vss-workfile vss-revision vss-description skip
     5244          error-status :get-message(1) skip
     5245          return-value skip
     5246          ""
     5247          view-as alert-box error
     5248        .
     5249        undo dtr, leave.
     5250     end.
     5251     empty temp-table x_add-trn .
     5252     for each buf_add-trn no-lock where
     5253             buf_add-trn.doc-code = buf_add-doc.doc-code :
     5254         create x_add-trn .
     5255         buffer-copy buf_add-trn to x_add-trn.
     5256     end.
     5257     delete buf_add-doc no-error .
     5258     if error-status :error then do:
     5259     message
     5260       vss-workfile vss-revision vss-description skip
     5261       error-status :get-message(1) skip
     5262       return-value skip
     5263       ""
     5264       view-as alert-box error
     5265     .
     5266     undo dtr, leave.
     5267     end.
     5268     for each x_add-trn :
     5269         for each buf_trn-doc no-lock where
     5270                  buf_trn-doc.doc-code = x_add-trn.trn-doc-code and
     5271                  buf_trn-doc.status_  = 'факт':U :
     5272                 run str/del-doc.p
     5273                   ( input  parParentProc,
     5274                     input  buf_trn-doc.doc-code,
     5275                     input  v-cntxt-db-num,
     5276                     input  "del-doc.err",
     5277                     input  ?,
     5278                     input  ?,
     5279                     input  v-cntxt-userid,
     5280                     input  buf_trn-doc.doc-code,
     5281                     input  ?,
     5282                     output varchip-code ) no-error .
     5283                     if error-status :error then do:
     5284                        message
     5285                          vss-workfile vss-revision vss-description skip
     5286                          error-status :get-message(1) skip
     5287                          return-value skip
     5288                          "Ошибки удаления можно посмотреть в файле del-doc.err"
     5289                          view-as alert-box error
     5290                        .
     5291                           undo dtr, leave .
     5292                     end.
     5293         end.
     5294     end.
     5295   end.
     5296   run waitfram-hide .
     5297   run openbr in this-procedure (yes, no, '':u).
     5298     end.
     5299   END PROCEDURE.
     5300   PROCEDURE ord-open :
     5301    do
     5302    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5303    :
     5304   define input parameter p-loc-recid as recid no-undo .
     5305   message "Открыть Документ ДопРасх ?"
     5306   view-as alert-box question
     5307   buttons yes-no
     5308   update g-log.
     5309   if g-log = false then return no-apply.
     5310   if not available buf_add-doc then return.
     5311   if buf_add-doc.status_ = 'новый':U then do:
     5312     message 'Документ ДопРасходов уже открыт' view-as alert-box information .
     5313     return no-apply.
     5314   end.
     5315   if buf_add-doc.status_ = 'факт':U then do:
     5316     message 'Документ уже закрыт на ФАКТ !' view-as alert-box information .
     5317     return no-apply.
     5318   end.
     5319   define variable o-db-num as integer   no-undo .
     5320   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5322     (input  buf_add-doc.obj-type
     5323     ,input  buf_add-doc.obj-code
     5324     ,output o-db-num
     5325     )  .
     5326     if o-db-num <> v-cntxt-db-num then do:
     5327       message 'Открыть можно на активной стороне!' view-as alert-box information .
     5328       return no-apply.
     5329     end.
     5330   define variable v-i as integer   no-undo .
     5331   v-i = 0.
     5332   for each ub.add-trn no-lock where
     5333            ub.add-trn.doc-code = buf_add-doc.doc-code ,
     5334       first ub.trn-doc no-lock where ub.trn-doc.doc-code = ub.add-trn.trn-doc-code and
     5335             ub.trn-doc.status_ = 'закрыт':U :
     5336        v-i = v-i + 1.
     5337   end.
     5338   if v-i > 0 then do:
     5339     message 'Есть привязанные приходные накладные закрытые на факт ! '
     5340     view-as alert-box information .
     5341     return .
     5342   end.
     5343   find current buf_add-doc exclusive-lock no-error .
     5344   if available buf_add-doc then do:
     5345       buf_add-doc.status_ = 'новый':U .
     5346   end.
     5347     end.
     5348   END PROCEDURE.
     5349   PROCEDURE proc-add :
     5350    do
     5351    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5352    :
     5353    define variable obj-db-num as integer   no-undo .
     5354   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5356     (input  v-cntxt-obj-type
     5357     ,input  v-cntxt-obj-code
     5358     ,output obj-db-num
     5359     )  .
     5360       if obj-db-num <> v-cntxt-db-num then do:
     5361         message 'Создание ДопРасхода  только на активной стороне' view-as alert-box information .
     5362         return .
     5363       end.
     5364   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5365   do:
     5366     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5367       (input  v-cntxt-db-num
     5368       ,input  v-cntxt-userid
     5369       ,input  0
     5370       ,input  'actn_add-d_add-def':U
     5371       ,input  'object':U
     5372       ,input  par-host-code
     5373       ,input  p-obj-type
     5374       ,input  p-obj-code
     5375       ,input  0
     5376       ,input  0
     5377       ,input  0
     5378       ,input  true
     5379       ,output g-log
     5380       )  .
     5381   end.
     5382   if not g-log then  return .
     5383   define variable rr as recid no-undo .
     5384     rr = ? .
     5385     run str/add-docu.w
     5386        (input parparentproc,
     5387         input-output rr ,
     5388         input 'ДОБАВЛЕНИЕ':U ,
     5389         input ""  ).
     5390     v-doc-rec = rr .
     5391     run openbr in this-procedure ( yes, no, '':u).
     5392     reposition br-docs to recid v-doc-rec no-error .
     5393     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     5394     end.
     5395   END PROCEDURE.
     5396   PROCEDURE proc-b-sch :
     5397    do
     5398    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5399    :
     5400   assign
     5401     tbl = 'add-doc'
     5402     join-tbl = 'buf_add-doc'
     5403     fld = ""
     5404     lab = ""
     5405     spr = ""
     5406     dim = '0'
     5407     .
     5408   run fltfield-add in this-procedure('doc-code', '№ Документа ДопРасх', '',
     5409   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5410   run fltfield-add in this-procedure('status_', 'Статус', '',
     5411   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5412   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     5413   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5414   run fltfield-add in this-procedure('fact-date', 'Дата факт', '',
     5415   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5416   run fltfield-add in this-procedure('creid', 'Создал', 'usr',
     5417   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5418   run fltfield-add in this-procedure('user-name', 'Правил', 'usr',
     5419   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5420   Filter-Block:
     5421   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5422       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5423       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5424     run gbl/filter.w ( input parparentproc, input filter-point, input tbl, input join-tbl, input fld, input lab, input spr, input dim ).
     5425     run openbr in this-procedure (yes, no, '':u).
     5426   END.
     5427     end.
     5428   END PROCEDURE.
     5429   PROCEDURE proc-close-add-doc :
     5430    do
     5431    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5432    :
     5433   if not available buf_add-doc then return.
     5434   define variable g-log as logical   no-undo .
     5435   g-log = false .
     5436   message "Закрыть Документ ДопРасходов ?"
     5437     view-as alert-box question
     5438     buttons yes-no
     5439     update g-log
     5440     .
     5441   if g-log = false then return .
     5442   if buf_add-doc.status_ = 'закрыт':U then do:
     5443     g-log = true .
     5444     message
     5445     substitute("При закрытии Документа ДопРасходов &1  на ФАКТ автоматически будут закрыты его ПН . Закрывать ДопРасход ?  " , buf_add-doc.doc-code )
     5446       view-as alert-box question
     5447       buttons yes-no
     5448       update g-log
     5449       .
     5450     if g-log = false then return .
     5451   end.
     5452       run str/addclos.p
     5453       ( input Parparentproc,
     5454         recid(buf_add-doc)
     5455       ) .
     5456     end.
     5457   END PROCEDURE.
     5458   PROCEDURE proc-print :
     5459   define variable sym1  as char format "X(1)" init ":".
     5460   define variable sym2  as char format "X(1)" init ":".
     5461   define variable sym3  as char format "X(1)" init ":".
     5462   define variable sym4  as char format "X(1)" init ":".
     5463   define variable sym5  as char format "X(1)" init ":".
     5464   define variable sym6  as char format "X(1)" init ":".
     5465   define variable sym7  as char format "X(1)" init ":".
     5466   define variable sym8  as char format "X(1)" init ":".
     5467   define variable sym9  as char format "X(1)" init ":".
     5468   define variable sym10 as char format "X(1)" init ":".
     5469   define variable sym11 as char format "X(1)" init ":".
     5470   define variable sym12 as char format "X(1)" init ":".
     5471   define variable date_string     as      char    no-undo.
     5472   define variable Line                as      char    no-undo.
     5473   define variable for-time as char.
     5474   define variable vv-val as character no-undo .
     5475   define variable v-i as integer   no-undo .
     5476   define variable v-kol as integer   no-undo .
     5477   define variable p-delta as decimal format "->,>>>,>>>,>>>,>>9.99"  no-undo .
     5478   DEFINE FRAME prt-frame
     5479     buf_add-doc.status_ COLUMN-LABEL 'Статус' Format "X(6)"
     5480     buf_add-doc.doc-code COLUMN-LABEL '№ док-та'
     5481     buf_add-doc.doc-date COLUMN-LABEL 'Создан' FORMAT "99/99/99"
     5482     buf_add-doc.fact-date COLUMN-LABEL 'Факт' FORMAT "99/99/99"
     5483     buf_add-doc.obj-code COLUMN-LABEL 'Объект' format ">>>>9"
     5484     buf_add-doc.obj-type COLUMN-LABEL 'Тип' format "x(3)"
     5485     buf_add-doc.sum-rubl COLUMN-LABEL 'Сумма (руб)' format ">>>>>>>>>9.99"
     5486    HEADER  date_string AT 5 format "X(35)"
     5487           string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     5488           Line format "X(157)" AT 1
     5489       with width 232 down stream-io use-text    .
     5490       Line = fill("-", 157).
     5491       date_string = cur-time-print() .
     5492       run prn-lib-open-stream in this-procedure
     5493       (  input parParentProc
     5494         ,input 43
     5495         ,input yes
     5496         ,input no
     5497         ).
     5498       PUT  STREAM PrnLibStream
     5499       SPACE(25) ( frame Dialog-Frame:title )
     5500       format "x(157)" SKIP(1) .
     5501       FORM HEADER
     5502         Line format "X(177)" AT 1 SKIP
     5503         "Продолжение - на следующей странице" AT 30 SKIP
     5504         with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5505       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5506       FORM with FRAME prt-frame  .
     5507       run waitfram-show in this-procedure ("Ждите печатаю...").
     5508       run OpenBR in this-procedure (yes, no, '':U).
     5509        DO WHILE available buf_add-doc :
     5510          v-kol    = v-kol   + 1 .
     5511           Display STREAM PrnLibStream
     5512                buf_add-doc.status_
     5513                buf_add-doc.doc-code
     5514                buf_add-doc.doc-date
     5515                buf_add-doc.fact-date
     5516                buf_add-doc.obj-code
     5517                buf_add-doc.obj-type
     5518                buf_add-doc.sum-rubl
     5519               with FRAME prt-frame .
     5520               DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     5521               GET next br-docs.
     5522         END.
     5523         UNDERLINE  STREAM PrnLibStream
     5524           buf_add-doc.status_
     5525           buf_add-doc.doc-code
     5526           buf_add-doc.doc-date
     5527           buf_add-doc.fact-date
     5528           buf_add-doc.obj-code
     5529           buf_add-doc.obj-type
     5530           buf_add-doc.sum-rubl
     5531       with FRAME prt-frame .
     5532           Display STREAM PrnLibStream
     5533           "Итого"    @  buf_add-doc.status_
     5534           "док.шт."  @  buf_add-doc.doc-code
     5535            v-kol     @  buf_add-doc.doc-date
     5536           with FRAME prt-frame .
     5537         DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     5538         UNDERLINE  STREAM PrnLibStream
     5539           buf_add-doc.status_
     5540           buf_add-doc.doc-code
     5541           buf_add-doc.doc-date
     5542           buf_add-doc.fact-date
     5543           buf_add-doc.obj-code
     5544           buf_add-doc.obj-type
     5545           buf_add-doc.sum-rubl
     5546       with FRAME prt-frame .
     5547       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5548       HIDE  STREAM PrnLibStream FRAME CheckList.
     5549       output  STREAM PrnLibStream CLOSE.
     5550       run waitfram-hide in this-procedure .
     5551       run prn-lib-prn-file in this-procedure (
     5552           input parParentProc
     5553          ,input 8
     5554           ).
     5555   END PROCEDURE.
     5556   PROCEDURE proc-sch-code :
     5557    do
     5558    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5559    :
     5560   define input parameter par-next as logical no-undo.
     5561   define input parameter pardoc-code as character no-undo.
     5562   display "" @ sch-date with frame Dialog-Frame.
     5563   display "" @ sch-fact with frame Dialog-Frame.
     5564   assign
     5565     pardoc-code = chr(34) + pardoc-code + chr(34) .
     5566   run OpenBr in this-procedure
     5567       (input false
     5568       ,input par-next
     5569       ,input substitute("and buf_add-doc.doc-code begins &1 "
     5570         , pardoc-code)
     5571       ).
     5572    apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     5573     end.
     5574   END PROCEDURE.
     5575   PROCEDURE proc-sch-date :
     5576    do
     5577    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5578    :
     5579   define input parameter par-next as logical no-undo.
     5580   define input parameter pardoc-code as date no-undo.
     5581   define variable ppp as character no-undo .
     5582   display "" @ sch-fact with frame Dialog-Frame.
     5583   display "" @ sch-code with frame Dialog-Frame.
     5584   ppp =  string( month(pardoc-code)) + "/" +  string( day(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     5585   run OpenBr in this-procedure
     5586       (input false
     5587       ,input par-next
     5588       ,input substitute("and buf_add-doc.doc-date = &1 "
     5589         , ppp )
     5590       ) no-error .
     5591       if error-status :error then
     5592          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     5593   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     5594     end.
     5595   END PROCEDURE.
     5596   PROCEDURE proc-sch-fact :
     5597    do
     5598    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5599    :
     5600   define input parameter par-next as logical no-undo.
     5601   define input parameter pardoc-code as date no-undo.
     5602   define variable ppp as character no-undo .
     5603   display "" @ sch-date with frame Dialog-Frame.
     5604   display "" @ sch-code with frame Dialog-Frame.
     5605   ppp =  string( month(pardoc-code)) + "/" +  string( day(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     5606   run OpenBr in this-procedure
     5607       (input false
     5608       ,input par-next
     5609       ,input substitute("and buf_add-doc.fact-date = &1 "
     5610         , ppp )
     5611       ) no-error .
     5612       if error-status :error then
     5613          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     5614   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     5615     end.
     5616   END PROCEDURE.
     5617   PROCEDURE run-rep :
     5618   define input parameter j as integer no-undo .
     5619   END PROCEDURE.
     5620   PROCEDURE UI-on :
     5621    do
     5622    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     5623    :
     5624    run openbr in this-procedure (yes, no, '':u).
     5625     end.
     5626   END PROCEDURE.
