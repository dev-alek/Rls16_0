      905   FUNCTION mark-string RETURNS CHARACTER
      906     ( input p-recid as recid, input mark-list as character  ) :
      907     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
