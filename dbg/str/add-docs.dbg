     4637   define variable  sort-phrase-rus-34  as character no-undo .
     4638   run gbl/flt-get.p
     4639     (input filter-point
     4640     ,output flt-rec-34
     4641     ,output filter-name-34
     4642     ,output where-phrase-34
     4643     ,output sort-phrase-34
     4644     ,output where-phrase-rus-34
     4645     ,output sort-phrase-rus-34
     4646     ).
     4647   if p-open-query then do:
     4648       run set-filter-name in this-procedure
     4649         (INPUT filter-name-34
     4650         ) no-error .
     4651     assign
     4652       l-filter-open-34 = false
     4653     .
     4654     if flt-rec-34 <> ?
     4655       or sort-column-phrase > ""
     4656     then do:
     4657       define variable  parameter-2-34 as character no-undo .
     4658       define variable  parameter-3-34 as character no-undo .
     4659       define variable  parameter-4-34 as character no-undo .
     4660       define variable  parameter-5-34 as character no-undo .
     4661       define variable  parameter-6-34 as character no-undo .
     4662       define variable  parameter-7-34 as character no-undo .
     4663         assign
     4664         parameter-3-34 =
     4665                                 "FOR EACH buf_add-doc"
     4666         parameter-4-34 =
     4667           (
     4668             if (" buf_add-doc.host-code = par-host-code and buf_add-doc.obj-code = p-obj-code and buf_add-doc.obj-type = p-obj-type and buf_add-doc.doc-type = p-doc-type  and buf_add-doc.status_= p-status_ " + " " + where-phrase-34) <> ""
     4669             then  substitute(' buf_add-doc.host-code = &2 and buf_add-doc.obj-code = &3 and buf_add-doc.obj-type = &1&4&1  and buf_add-doc.doc-type = &1&5&1 and buf_add-doc.status_ = &1&6&1 ', chr(34), par-host-code, p-obj-code, p-obj-type, p-doc-type, p-status_) + " " + where-phrase-34
     4670             else "true"
     4671           )
     4672         parameter-5-34 = (" " + "" + " " + "")
     4673         parameter-6-34 = if sort-phrase-34 = ''
     4674                              then
     4675           (
     4676           " " + "  " +
     4677             " " + sort-column-phrase +
     4678           " " + "  "
     4679           )
     4680                              else
     4681           (
     4682           " " + "  " +
     4683             " " + sort-column-phrase +
     4684           " " + sort-phrase-34
     4685           )
     4686         parameter-7-34 =
     4687           "   "
     4688       .
     4689       do
     4690       on stop undo, leave
     4691       on error undo, leave
     4692       :
     4693         assign
     4694           l-disable-where-34 =
     4695             (" buf_add-doc.host-code = par-host-code and buf_add-doc.obj-code = p-obj-code and buf_add-doc.obj-type = p-obj-type and buf_add-doc.doc-type = p-doc-type  and buf_add-doc.status_= p-status_ " + " " + where-phrase-34 = "")
     4696         .
     4697         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4698                             ,input query br-docs:handle
     4699                             ,input parameter-3-34
     4700                             ,input parameter-4-34
     4701                             ,input parameter-5-34
     4702                             ,input parameter-6-34
     4703                             ,input parameter-7-34
     4704                             )
     4705         .
     4706         assign
