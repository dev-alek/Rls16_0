     1961           ,input "Выбор даты"
     1962           ,input v-description
     1963           ,input ""
     1964           ,input-output v-curr-sv-date
     1965           ,output v-ok
     1966           ).
     1967         if v-ok = true
     1968         then do:
     1969           assign
     1970             self :screen-value = string(v-curr-sv-date) .
     1971           .
     1972         end.
     1973       end.
     1974     end.
