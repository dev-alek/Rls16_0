     4160   PROCEDURE gen-4 :
     4161   define buffer bf_sysconf for ub.sysconf.
     4162   define buffer bf_add-doc for ub.add-doc.
     4163   define variable vari as integer no-undo.
     4164   define variable vardoc-code as integer no-undo.
     4165   define variable varneed-incfo as logical no-undo.
     4166   define buffer bf_add-line    for ub.add-line.
     4167   define buffer bf_contract for ub.contract.
     4168   do
     4169   on error undo, return error return-value
     4170   :
     4171   if rid-list = "" then do:
     4172     if available buf_add-doc then do:
     4173       assign
     4174         rid-list = string(recid(buf_add-doc)).
     4175     end.
     4176   end.
     4177   vari-cycle:
     4178   do vari = 1 to num-entries (rid-list):
     4179     assign
     4180       vardoc-code = integer(entry (vari, rid-list)).
     4181     find first bf_add-doc where recid(bf_add-doc) = vardoc-code exclusive-lock.
     4182     find first bf_sysconf where bf_sysconf.host-code = bf_add-doc.host-code no-lock.
     4183     if bf_add-doc.status_ <> 'факт':U then do:
     4184       message "Документ " bf_add-doc.status_ " не в статусе " 'факт':U " . Пропускаем."
     4185       view-as alert-box.
     4186       next.
     4187     end.
     4188     if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     4189       message "Главная БД для фирмы по документу с кодом " bf_add-doc.doc-code " не является текущей БД." skip
     4190               "Текущая БД: " v-cntxt-db-num skip
     4191               "Главная БД фирмы: " bf_sysconf.firm-db-num
     4192       view-as alert-box error.
     4193       return error.
     4194     end.
     4195     if bf_add-doc.need-incfo = 2 then do:
     4196       assign
     4197         varneed-incfo = no.
     4198       for each bf_add-line where bf_add-line.doc-code = bf_add-doc.doc-code on error undo, return error return-value :
     4199         if bf_add-line.contract-code <> 0 then do:
     4200           find first bf_contract where bf_contract.host-code     = bf_add-line.host-code   and
     4201                                        bf_contract.contract-code = bf_add-line.contract-code no-lock no-error.
     4202           if available bf_contract then do:
     4203             if lookup (bf_contract.usl-opl, 'По факту поставки,Отсрочка платежа (по поставке)') > 0 then do:
     4204               assign
     4205                 varneed-incfo = yes.
     4206             end.
     4207           end.
     4208         end.
     4209       end.
     4210       if varneed-incfo then do:
     4211         assign
     4212           bf_add-doc.need-incfo      = 1
     4213         .
     4214         reposition br-docs to recid recid(bf_add-doc) no-error.
     4215         if not error-status:error then do:
     4216            display fo-postavka (recid( bf_add-doc)) @ pp with browse br-docs.
     4217         end.
     4218       end.
     4219       else do:
     4220         message "По документу " bf_add-doc.doc-code " нет договоров для генерации ФО по поставке."
     4221         view-as alert-box.
     4222       end.
     4223     end.
     4224     else do:
     4225       message "Документ " bf_add-doc.doc-code "не имеет признака 'не опред' генерация ФО по поставке."
     4226       view-as alert-box.
     4227       next vari-cycle.
     4228     end.
     4229   end.
     4230   assign
     4231     rid-list = "".
     4232   end.
     4233   END PROCEDURE.
     4234   PROCEDURE gen-40 :
     4235   define buffer bf_sysconf for ub.sysconf.
     4236   define buffer bf_add-doc for ub.add-doc.
     4237   define variable vari as integer no-undo.
     4238   define variable vardoc-code as integer no-undo.
     4239   define variable varneed-factur as logical no-undo.
     4240   define buffer bf_add-line    for ub.add-line.
     4241   define buffer bf_contract for ub.contract.
     4242   do
     4243   on error undo, return error return-value
     4244   :
     4245   if rid-list = "" then do:
     4246     if available buf_add-doc then do:
     4247       assign
     4248         rid-list = string(recid(buf_add-doc)).
     4249     end.
     4250   end.
     4251   vari-cycle:
     4252   do vari = 1 to num-entries (rid-list):
     4253     assign
     4254       vardoc-code = integer(entry (vari, rid-list)).
     4255     find first bf_add-doc where recid(bf_add-doc) = vardoc-code exclusive-lock.
     4256     find first bf_sysconf where bf_sysconf.host-code = bf_add-doc.host-code no-lock.
     4257     if bf_add-doc.status_ <> 'факт':U then do:
     4258       message "Документ " bf_add-doc.status_ " не в статусе " 'факт':U " . Пропускаем."
     4259       view-as alert-box.
     4260       next.
     4261     end.
     4262     if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     4263       message "Главная БД для фирмы по документу с кодом " bf_add-doc.doc-code " не является текущей БД." skip
     4264               "Текущая БД: " v-cntxt-db-num skip
     4265               "Главная БД фирмы: " bf_sysconf.firm-db-num
     4266       view-as alert-box error.
     4267       return error.
     4268     end.
     4269     if bf_add-doc.need-factur = 2 then do:
     4270       assign
     4271         varneed-factur = no.
     4272       for each bf_add-line where bf_add-line.doc-code = bf_add-doc.doc-code on error undo, return error return-value :
     4273         if bf_add-line.contract-code <> 0 then do:
     4274           find first bf_contract where bf_contract.host-code     = bf_add-line.host-code   and
     4275                                        bf_contract.contract-code = bf_add-line.contract-code no-lock no-error.
     4276           if available bf_contract then do:
     4277             if lookup (bf_contract.usl-opl, 'По факту поставки,Отсрочка платежа (по поставке)') > 0 then do:
     4278               assign
     4279                 varneed-factur = yes.
     4280             end.
     4281           end.
     4282         end.
     4283       end.
     4284       if varneed-factur then do:
     4285         assign
     4286           bf_add-doc.need-factur      = 1
     4287         .
     4288         reposition br-docs to recid recid(bf_add-doc) no-error.
     4289         if not error-status:error then do:
     4290           display sfactur (recid( bf_add-doc)) @ ff with browse br-docs.
     4291         end.
     4292       end.
     4293       else do:
     4294         message "По документу " bf_add-doc.doc-code " нет договоров для генерации счетов-фактур."
     4295         view-as alert-box.
     4296       end.
     4297     end.
     4298     else do:
     4299       message "Документ " bf_add-doc.doc-code "не имеет признака 'не опред' генерация Счетов-фактур."
     4300       view-as alert-box.
     4301       next vari-cycle.
     4302     end.
     4303   end.
     4304   assign
     4305     rid-list = "".
     4306   end.
     4307   END PROCEDURE.
     4308   PROCEDURE make-fo :
     4309    if num-entries(rid-list) = 0 then do:
     4310       message "Не выделено ни одного документа для генерации финансовых обязательств !".
     4311       return error .
     4312    end.
     4313    run str/gen-fl.w (
     4314       input parparentproc,
     4315       input v-cntxt-host-code-obj ,
     4316       input rid-list,
     4317       input "add"
     4318    )   .
     4319     assign
     4320       rid-list = ""
     4321       .
     4322   END PROCEDURE.
     4323   PROCEDURE make-sf :
     4324   define buffer buf1_add-doc for ub.add-doc  .
     4325   define variable v-list as character no-undo .
     4326    if num-entries(rid-list) = 0 then do:
     4327       message "Не выделено ни одного документа для генерации счетов-фактур !".
     4328       return error .
     4329    end.
     4330   define variable v-9 as integer   no-undo .
     4331   define variable vari as integer   no-undo .
     4332   v-9 = num-entries (rid-list).
     4333   do vari = 1 to v-9 :
     4334    find first buf1_add-doc exclusive-lock where
     4335               recid(buf1_add-doc) = int(entry(vari, rid-list)) no-error  .
     4336    if available buf1_add-doc then
     4337    run str/gen-scf.p ( input parParentProc, input recid(buf1_add-doc), input "add-doc", output v-list) no-error .
     4338    if error-status :error then message
     4339      vss-workfile vss-revision vss-description skip
     4340      error-status :get-message(1) skip
     4341      return-value skip
     4342      "Ошибка из str/gen-scf.p"
     4343      view-as alert-box error
     4344    .
     4345   end.
     4346     assign
     4347       rid-list = ""
     4348       .
     4349   END PROCEDURE.
     4350   PROCEDURE many-add-docs :
     4351   define output parameter p-reply as logical   no-undo .
     4352   p-reply = true .
     4353   END PROCEDURE.
     4354   PROCEDURE my-enable_UI :
     4355    do
     4356    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4357    :
     4358    define variable is-finvalue as character no-undo .
     4359    define variable is-fintype as character no-undo .
     4360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4361     (input  'is-fin'
     4362     ,input  ''
     4363     ,input  ''
     4364     ,input  0
     4365     ,input  ''
     4366     ,input  ''
     4367     ,input  ''
     4368     ,input  no
     4369     ,output is-finvalue
     4370     ,output is-fintype
     4371     ) no-error .
     4372      if error-status :error then is-finvalue = 'no' .
     4373     DISPLAY
     4374         sch-code
     4375         sch-date
     4376         sch-fact
     4377         WITH FRAME Dialog-Frame.
     4378     ENABLE b-quit
     4379            b-mark       when ( lookup("b-mark":U,  bttns) > 0  or is-finvalue = 'yes' )
     4380            b-sel        when lookup("b-sel":U,   bttns) > 0
     4381            b-sch
     4382            b-help
     4383            b-add        when lookup("b-add":U,  bttns) > 0
     4384            b-lkp
     4385            b-lkp-2
     4386            b-chg        when lookup("b-chg":U,  bttns) > 0
     4387            b-del        when lookup("b-del":U,  bttns) > 0
     4388            b-close
     4389            b-open
     4390            b-print
     4391            sch-code
     4392            sch-date
     4393            sch-fact
     4394            br-docs
     4395            br-nakl
     4396            b-rep
     4397            b-export
     4398            b-fo  when (v-cntxt-db-num = 0  and is-finvalue = 'yes' )
     4399            b-sf  when ( is-finvalue = 'yes' )
     4400         WITH FRAME Dialog-Frame.
     4401     VIEW FRAME Dialog-Frame.
     4402   define variable  m-i-rc  as widget-handle.
     4403   define variable  m-i-rc2  as widget-handle.
     4404   create widget-pool "my-pool" persistent no-error .
     4405   hide B-close-trn-all in frame Dialog-Frame .
     4406     end.
     4407   END PROCEDURE.
     4408   PROCEDURE OpenBr :
     4409    do
     4410    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4411    :
     4412   define input  parameter p-open-query     as logical   no-undo .
     4413   define input  parameter p-find-next      as logical   no-undo .
     4414   define input  parameter p-find-condition as character no-undo .
     4415   define variable l-query-was-opened as logical no-undo .
     4416   define variable title0 as character no-undo.
     4417   define variable p-file-label as character no-undo .
     4418   p-file-label = "Документы Дополнительных расходов".
     4419   title0 = caps(p-file-label) + chr(32).
     4420   define variable sort-column-phrase as character no-undo .
     4421   case sort-column-name :
     4422     when "" then do:
     4423       assign
     4424         sort-column-phrase = ""
     4425       .
     4426     end.
     4427     otherwise do:
     4428       assign
     4429         sort-column-phrase = "by " + sort-column-name
     4430       .
     4431     end.
     4432   end case.
     4433   define variable l-open-query as logical   no-undo .
     4434   find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     4435   if not available buf_clients then return .
     4436   filter-point = filter-point0 + par-mode.
     4437     CASE par-mode :
     4438       WHEN 'объ':U THEN DO:
     4439          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name
     4440                                             + " Объект: " +  p-obj-type
     4441                                             + "  " +   string (p-obj-code)
     4442                                             .
     4443   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4444   define variable  l-disable-where-32  as logical   no-undo .
     4445   define variable  l-filter-open-32    as logical   .
     4446   define variable  flt-rec-32       as recid     no-undo .
     4447   define variable  filter-name-32      as character no-undo .
     4448   define variable  where-phrase-32     as character no-undo .
     4449   define variable  sort-phrase-32      as character no-undo .
     4450   define variable  where-phrase-rus-32 as character no-undo .
     4451   define variable  sort-phrase-rus-32  as character no-undo .
     4452   run gbl/flt-get.p
     4453     (input filter-point
     4454     ,output flt-rec-32
     4455     ,output filter-name-32
     4456     ,output where-phrase-32
     4457     ,output sort-phrase-32
     4458     ,output where-phrase-rus-32
     4459     ,output sort-phrase-rus-32
     4460     ).
     4461   if p-open-query then do:
     4462       run set-filter-name in this-procedure
     4463         (INPUT filter-name-32
     4464         ) no-error .
     4465     assign
     4466       l-filter-open-32 = false
     4467     .
     4468     if flt-rec-32 <> ?
     4469       or sort-column-phrase > ""
     4470     then do:
     4471       define variable  parameter-2-32 as character no-undo .
     4472       define variable  parameter-3-32 as character no-undo .
     4473       define variable  parameter-4-32 as character no-undo .
     4474       define variable  parameter-5-32 as character no-undo .
     4475       define variable  parameter-6-32 as character no-undo .
     4476       define variable  parameter-7-32 as character no-undo .
     4477         assign
     4478         parameter-3-32 =
     4479                                 "FOR EACH buf_add-doc"
     4480         parameter-4-32 =
     4481           (
     4482             if (" buf_add-doc.host-code = par-host-code and buf_add-doc.obj-code = p-obj-code and buf_add-doc.obj-type = p-obj-type and buf_add-doc.doc-type = p-doc-type " + " " + where-phrase-32) <> ""
     4483             then substitute(' buf_add-doc.host-code = &2 and buf_add-doc.obj-code = &3 and buf_add-doc.obj-type = &1&4&1  and buf_add-doc.doc-type = &1&5&1 ', chr(34), par-host-code, p-obj-code, p-obj-type, p-doc-type) + " " + where-phrase-32
     4484             else "true"
     4485           )
     4486         parameter-5-32 = (" " + "" + " " + "")
     4487         parameter-6-32 = if sort-phrase-32 = ''
     4488                              then
     4489           (
     4490           " " + " " +
     4491             " " + sort-column-phrase +
     4492           " " + " "
     4493           )
     4494                              else
     4495           (
     4496           " " + " " +
     4497             " " + sort-column-phrase +
     4498           " " + sort-phrase-32
     4499           )
     4500         parameter-7-32 =
     4501           "   "
     4502       .
     4503       do
     4504       on stop undo, leave
     4505       on error undo, leave
     4506       :
     4507         assign
     4508           l-disable-where-32 =
     4509             (" buf_add-doc.host-code = par-host-code and buf_add-doc.obj-code = p-obj-code and buf_add-doc.obj-type = p-obj-type and buf_add-doc.doc-type = p-doc-type " + " " + where-phrase-32 = "")
     4510         .
     4511         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4512                             ,input query br-docs:handle
     4513                             ,input parameter-3-32
     4514                             ,input parameter-4-32
     4515                             ,input parameter-5-32
     4516                             ,input parameter-6-32
     4517                             ,input parameter-7-32
     4518                             )
     4519         .
     4520         assign
     4521           l-filter-open-32 = true
     4522         .
     4523       end.
     4524       if l-filter-open-32 = false then do:
     4525         message
     4526           "Ошибка при фильтрации / сортировке" skip
     4527           "Будут показаны записи без учета фильтра" skip
     4528           view-as alert-box .
     4529       end.
     4530       else do:
     4531           assign
     4532             l-query-was-opened = true
     4533           .
     4534       end.
     4535     end.
     4536     if l-filter-open-32 = false then do:
     4537       OPEN QUERY br-docs FOR EACH buf_add-doc
     4538         where  buf_add-doc.host-code = par-host-code and buf_add-doc.obj-code = p-obj-code and buf_add-doc.obj-type = p-obj-type and buf_add-doc.doc-type = p-doc-type
     4539     .
     4540         assign
     4541           l-query-was-opened = true
     4542         .
     4543     end.
     4544   end.
     4545   else do:
     4546     assign
     4547       doc-rec = recid( buf_add-doc )
     4548     .
     4549     do
     4550     on stop undo, leave
     4551     on error undo, leave
     4552     :
     4553       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_add-doc:handle) then do:
     4554         assign
     4555         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     4556         parameter-4-32 =
     4557           "where ":u + substitute(' buf_add-doc.host-code = &2 and buf_add-doc.obj-code = &3 and buf_add-doc.obj-type = &1&4&1  and buf_add-doc.doc-type = &1&5&1 ', chr(34), par-host-code, p-obj-code, p-obj-type, p-doc-type) + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     4558         parameter-5-32 = " "
     4559       .
     4560         run fltopend_fltfindd in this-procedure  (
     4561                             input this-procedure:handle
     4562                             ,input query br-docs:handle
     4563                             ,input rowid(buf_add-doc)
     4564                             ,input logical(parameter-2-32)
     4565                             ,input no-lock
     4566                             ,input (buffer buf_add-doc:handle)
     4567                             ,input parameter-4-32
     4568                             ,input parameter-5-32
     4569                             ) no-error.
     4570         .
     4571         assign
     4572           doc-rec = integer(return-value)
     4573           v-fltopend-rowid[1] = ?
     4574         .
     4575       end.
     4576       else do:
     4577         assign
     4578         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     4579         parameter-3-32 =  "FOR EACH buf_add-doc"
     4580         parameter-4-32 =
     4581           (
     4582             if (" buf_add-doc.host-code = par-host-code and buf_add-doc.obj-code = p-obj-code and buf_add-doc.obj-type = p-obj-type and buf_add-doc.doc-type = p-doc-type " + " " + where-phrase-32) <> ""
     4583             then substitute(' buf_add-doc.host-code = &2 and buf_add-doc.obj-code = &3 and buf_add-doc.obj-type = &1&4&1  and buf_add-doc.doc-type = &1&5&1 ', chr(34), par-host-code, p-obj-code, p-obj-type, p-doc-type) + " " + where-phrase-32
     4584             else "true"
     4585           )
     4586         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     4587         parameter-6-32 = if sort-phrase-32 = ''
     4588                              then
     4589           (
     4590           " " + " " +
     4591             " " + sort-column-phrase +
     4592           " " + " "
     4593           )
     4594                              else
     4595           (
     4596           " " + " " +
     4597             " " + sort-column-phrase +
     4598           " " + sort-phrase-32
     4599           )
     4600         parameter-7-32 =
     4601           "   "
     4602       .
     4603         run fltopend_fltfindq in this-procedure  (
     4604                             input this-procedure:handle
     4605                             ,input query br-docs:handle
     4606                             ,input logical(parameter-2-32)
     4607                             ,input no-lock
     4608                             ,input parameter-3-32
     4609                             ,input parameter-4-32
     4610                             ,input parameter-5-32
     4611                             ,input parameter-6-32
     4612                             ,input parameter-7-32
     4613                             ,output v-fltopend-rowid
     4614                             ) no-error.
     4615         .
     4616         doc-rec = ?.
     4617       end.
     4618       assign
     4619         l-query-was-opened = true
     4620       .
     4621     end.
     4622   end.
     4623       END.
     4624       WHEN "status":U THEN DO:
     4625          ASSIGN frame Dialog-Frame:TITLE = title0 + "  ФИРМА: " + buf_clients.obj-name
     4626                                             + " Объект: " +  p-obj-type
     4627                                             + "  " +   string (p-obj-code)
     4628                                             + "   Статус: " +  string(p-status_) .
     4629   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4630   define variable  l-disable-where-34  as logical   no-undo .
     4631   define variable  l-filter-open-34    as logical   .
     4632   define variable  flt-rec-34       as recid     no-undo .
