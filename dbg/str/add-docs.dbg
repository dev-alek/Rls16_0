     1820        )
     1821     then do:
     1822       assign
     1823         self :screen-value = ?
     1824       .
     1825     end.
     1826     return no-apply.
     1827   end.
     1828   on ctrl-d of sch-date in frame Dialog-Frame
     1829   do:
     1830     define variable v-curr-sv-date as date no-undo .
     1831     if (can-query (self, "sensitive")
     1832        and
     1833        self :sensitive = true
     1834        )
     1835     or (can-query (self, "read-only")
     1836        and
     1837        self :read-only = false
     1838        )
     1839     then do:
     1840       if self :handle <> focus :handle
     1841       then do:
     1842         apply "entry":u to self .
     1843       end.
     1844       run gbl/getcurdt.p
     1845         (output v-curr-sv-date
     1846         ) .
     1847       assign
     1848         self :screen-value = string(v-curr-sv-date) .
     1849       .
     1850     end.
     1851     return no-apply.
     1852   end.
     1853   on ctrl-b of sch-date in frame Dialog-Frame
     1854   do:
     1855     if (can-query (self, "sensitive")
     1856        and
     1857        self :sensitive = true
     1858        )
     1859     or (can-query (self, "read-only")
     1860        and
     1861        self :read-only = false
     1862        )
     1863     then do:
     1864       if self :handle <> focus :handle
     1865       then do:
     1866         apply "entry":u to self .
     1867       end.
     1868       define variable v-curr-sv-date as date no-undo .
     1869       define variable v-new-sv-date  as date no-undo .
     1870       assign
     1871         v-curr-sv-date = date(self :screen-value) no-error
     1872       .
     1873       if v-curr-sv-date = ?
     1874       then do:
