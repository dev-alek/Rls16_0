     2259   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2260   procedure minbtn-set :
     2261       do
     2262           on error undo, return error return-value
     2263           :
     2264           define variable ii              as integer       no-undo .
     2265           define variable fh              as widget-handle no-undo .
     2266           define variable hh              as widget-handle no-undo .
     2267           define variable v-h             as handle        extent 4 no-undo .
     2268           define variable v-name-button   as character     no-undo .
     2269           define variable v-help-old-x    as decimal       no-undo .
     2270           define variable v-help-old-y    as decimal       no-undo .
     2271           define variable v-help-old-size as decimal       no-undo .
     2272           define variable v-frame-width   as decimal       no-undo .
     2273           define variable jj              as integer       no-undo .
     2274           do
     2275               on error undo, return error
     2276               :
     2277               assign
     2278                   v-frame-width = frame Dialog-Frame:width - 0.3
     2279                   fh            = frame Dialog-Frame:first-child
     2280                   hh            = fh:first-child
     2281                   ii            = 1
     2282                   .
     2283               do while valid-handle(hh):
     2284                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2285                   do:
     2286                       case lc(hh:name) :
     2287                           when "b-help" then
     2288                               do:
     2289                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2290                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2291                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2292                                   hh:TOOLTIP = "Помощь" .
     2293                                   v-help-old-x = hh:column .
     2294                                   v-help-old-y = hh:row    .
     2295                                   v-help-old-size = hh:width .
     2296                                   hh:width-chars = 2.5 .
     2297                               end.
     2298                           when "b-print" then
     2299                               do:
     2300                                   hh:load-image("cmp/b-print.bmp":u) .
     2301                                   hh:TOOLTIP = "Печать" .
     2302                                   v-h[ii] = hh:handle .
     2303                                   ii = ii + 1 .
     2304                                   hh:width-chars = 3 .
     2305                               end.
     2306                           when "b-history" or
     2307                           when "b-hist" then
     2308                               do:
     2309                                   hh:load-image("cmp/b-hist.bmp":u) .
     2310                                   hh:TOOLTIP = "История" .
     2311                                   v-h[ii] = hh:handle .
     2312                                   ii = ii + 1 .
     2313                                   hh:width-chars = 3 .
     2314                               end.
     2315                           when "b-sch" then
     2316                               do:
     2317                                   hh:load-image("cmp/b-sch.bmp":u) .
     2318                                   hh:TOOLTIP = "Установка Фильтра" .
     2319                                   v-h[ii] = hh:handle .
     2320                                   ii = ii + 1 .
     2321                                   hh:width-chars = 3 .
     2322                               end.
     2323                           when "b-hist-user" then
     2324                               do:
     2325                                   hh:load-image("cmp/b-hist.bmp":u) .
     2326                                   hh:TOOLTIP = "История пользователя" .
     2327                                   ii = ii + 1 .
     2328                               end.
     2329                       end case.
     2330                   end.
     2331                   hh = hh:next-sibling.
     2332               end.
     2333               b-help:column = v-frame-width - b-help:width-chars.
     2334               jj = 0.
     2335               repeat ii = 4 to 1 by -1 :
     2336                   if valid-handle (v-h[ii] ) then
     2337                   do:
     2338                       jj  = jj + 1 .
     2339                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2340                       v-h[ii]:row    = v-help-old-y .
     2341                   end.
     2342               end.
     2343           end.
     2344       end.
     2345   end procedure.
     2346   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2347   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2348   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2349   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2350   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2351   define variable v-diasize-current-frame-height as decimal   no-undo .
     2352   define variable v-diasize-change-size          as logical   no-undo .
     2353   define variable v-diasize-resize-button        as handle    no-undo .
     2354   define variable v-diasize-wndmax               as logical   no-undo .
     2355   define variable v-diasize-wndstore             as logical   no-undo .
     2356   define variable v-diasize-proc-name            as character no-undo .
     2357   define variable v-diasize-browse-handle        as handle    no-undo .
     2358   define variable v-diasize-browse-number        as integer   no-undo .
     2359   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2360   define temp-table temp-diasize-handle no-undo
     2361     field handle-value  as handle
     2362     field save-position as decimal
     2363     index xpk is primary unique handle-value
     2364     .
     2365   define temp-table temp-browse-handle no-undo
     2366     field browse-type   as character
     2367     field browse-number as integer
     2368     field browse-handle as handle
     2369     field original-size as decimal
     2370     index xpk is primary unique browse-type browse-number
     2371     index xie browse-type browse-handle
     2372   .
     2373   procedure diasize_change-height :
     2374     define input  parameter p-change-value  as decimal   no-undo .
     2375     define input  parameter p-move-resize   as logical   no-undo .
     2376     define variable v-field-group-handle    as handle    no-undo .
     2377     define variable v-object-handle         as handle    no-undo .
     2378     define variable v-frame-height          as decimal   no-undo .
     2379     define variable v-frame-virtual-height  as decimal   no-undo .
     2380     define variable v-browse-height         as decimal   no-undo .
     2381     define variable v-window-height         as decimal   no-undo .
     2382     define variable v-window-virtual-height as decimal   no-undo .
     2383     define variable v-change-sign           as integer   no-undo .
     2384     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2385     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2386     if p-change-value > 0
     2387     then do:
     2388       if frame Dialog-Frame :height + p-change-value
     2389           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2390       then do:
     2391         assign
     2392           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2393                           - (frame Dialog-Frame :height-chars)
     2394         .
     2395         if p-change-value <= 0
     2396         then do:
     2397           run diasize_position-resize-button in this-procedure .
     2398           return .
     2399         end.
     2400       end.
     2401     end.
     2402     if p-change-value < 0
     2403     then do:
     2404       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2405       then do:
     2406         assign
     2407           p-change-value = v-diasize-orig-frame-height
     2408                          - (frame Dialog-Frame :height-chars)
     2409         .
     2410         if p-change-value >= 0
     2411         then do:
     2412           run diasize_position-resize-button in this-procedure .
     2413           return .
     2414         end.
     2415       end.
     2416     end.
     2417     if p-change-value >= 0
     2418     then do:
     2419       assign
     2420         v-change-sign = 1
     2421       .
     2422     end.
     2423     else do:
     2424       assign
     2425         v-change-sign = -1
     2426       .
     2427     end.
     2428     assign
     2429       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2430     .
     2431     if p-change-value = 0
     2432     then do:
     2433       run diasize_position-resize-button in this-procedure .
     2434       return .
     2435     end.
     2436     move_block:
     2437     do
     2438     on error undo move_block, retry move_block
     2439     :
     2440       if retry
     2441       then do:
     2442         do
     2443         on error undo move_block, leave move_block
     2444         :
     2445           if p-change-value > 0
     2446           then do:
     2447             for each buf_temp-diasize-handle
     2448             on error undo, next
     2449             :
     2450               assign
     2451                 v-object-handle = buf_temp-diasize-handle.handle-value
     2452               .
     2453               if v-object-handle <> v-diasize-resize-button
     2454               then do:
     2455                 assign
     2456                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2457                 .
     2458               end.
     2459             end.
     2460             assign
     2461               v-diasize-browse-handle :height = v-browse-height
     2462             .
     2463             for each buf_temp-browse-handle
     2464               where buf_temp-browse-handle.browse-type = 'height':u
     2465             on error undo, next
     2466             :
     2467               assign
     2468                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2469               .
     2470             end.
     2471             assign
     2472               frame Dialog-Frame :height = v-frame-height
     2473             .
     2474             if frame Dialog-Frame :scrollable = true
     2475             then do:
     2476               assign
     2477                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2478               .
     2479             end.
     2480             run diasize_position-resize-button in this-procedure .
     2481           end.
     2482           else do:
     2483             if frame Dialog-Frame :scrollable = true
     2484             then do:
     2485               assign
     2486                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2487               .
     2488             end.
     2489             assign
     2490               frame Dialog-Frame :height = v-frame-height
     2491             .
     2492             assign
     2493               v-diasize-browse-handle :height = v-browse-height
     2494             .
     2495             for each buf_temp-browse-handle
     2496               where buf_temp-browse-handle.browse-type = 'height':u
     2497             on error undo, next
     2498             :
     2499               assign
     2500                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2501               .
     2502             end.
     2503             for each buf_temp-diasize-handle
     2504             on error undo, next
     2505             :
     2506               assign
     2507                 v-object-handle = buf_temp-diasize-handle.handle-value
     2508               .
     2509               if v-object-handle <> v-diasize-resize-button
     2510               then do:
     2511                 assign
     2512                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2513                 .
     2514               end.
     2515             end.
     2516             run diasize_position-resize-button in this-procedure .
     2517           end.
     2518           assign
     2519             v-diasize-change-size = false
     2520           .
     2521           leave move_block .
     2522         end.
     2523       end.
     2524       assign
     2525         v-diasize-need-full-display = true
     2526       .
     2527       if v-diasize-change-size = false
     2528       then do:
     2529         assign
     2530           v-diasize-change-size = true
     2531         .
     2532       end.
     2533       else do:
     2534         return .
     2535       end.
     2536       assign
     2537         v-frame-height = frame Dialog-Frame :height
     2538         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2539         v-browse-height = v-diasize-browse-handle :height
     2540       .
     2541       for each buf_temp-browse-handle
     2542         where buf_temp-browse-handle.browse-type = 'height':u
     2543       :
     2544         assign
     2545           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2546         .
     2547       end.
     2548       for each buf_temp-diasize-handle
     2549       :
     2550         delete buf_temp-diasize-handle .
     2551       end.
     2552       assign
     2553         v-field-group-handle = frame Dialog-Frame :first-child
     2554       .
     2555       do while valid-handle(v-field-group-handle)
     2556       :
     2557         assign
     2558           v-object-handle = v-field-group-handle :first-child
     2559         .
     2560         do while valid-handle(v-object-handle)
     2561         :
     2562           if  v-object-handle <> v-diasize-browse-handle :handle
     2563           and can-query(v-object-handle, "row")
     2564           and can-query(v-object-handle, "height")
     2565           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2566           then do:
     2567             find first buf_temp-browse-handle
     2568               where buf_temp-browse-handle.browse-type   = 'height':u
     2569                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2570               no-error .
     2571             if available buf_temp-browse-handle
     2572             then do:
     2573             end.
     2574             else do:
     2575               create buf_temp-diasize-handle .
     2576               assign
     2577                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2578                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2579               .
     2580             end.
     2581           end.
     2582           assign
     2583             v-object-handle = v-object-handle :next-sibling
     2584           .
     2585         end.
     2586         assign
     2587           v-field-group-handle = v-field-group-handle :next-sibling
     2588         .
     2589       end.
     2590       do with frame Dialog-Frame
     2591       :
     2592         hide v-diasize-resize-button .
     2593         assign
     2594           v-diasize-resize-button :row    = 1
     2595           v-diasize-resize-button :column = 1
     2596         .
     2597       end.
     2598       if p-change-value > 0
     2599       then do:
     2600         if frame Dialog-Frame :scrollable = true
     2601         then do:
     2602           assign
     2603             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2604             no-error .
     2605           if error-status :error
     2606           or error-status :get-message(1) <> ""
     2607           then do:
     2608             undo move_block, retry move_block .
     2609           end.
     2610         end.
     2611         assign
     2612           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2613           no-error .
     2614         if error-status :error
     2615         or error-status :get-message(1) <> ""
     2616         then do:
     2617           undo move_block, retry move_block .
     2618         end.
     2619         assign
     2620           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2621           no-error .
     2622         if error-status :error
     2623         or error-status :get-message(1) <> ""
     2624         then do:
     2625           undo move_block, retry move_block .
     2626         end.
     2627         for each buf_temp-browse-handle
     2628           where buf_temp-browse-handle.browse-type = 'height':u
     2629         on error undo move_block, retry move_block
     2630         :
     2631           assign
     2632             buf_temp-browse-handle.browse-handle :height
     2633               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2634             no-error .
     2635           if error-status :error
     2636           or error-status :get-message(1) <> ""
     2637           then do:
     2638             undo move_block, retry move_block .
     2639           end.
     2640         end.
     2641         for each buf_temp-diasize-handle
     2642         on error undo move_block, retry move_block
     2643         :
     2644           assign
     2645             v-object-handle = buf_temp-diasize-handle.handle-value
     2646           .
     2647           if v-object-handle <> v-diasize-resize-button
     2648           then do:
     2649             assign
     2650               v-object-handle :row = v-object-handle :row + p-change-value
     2651               no-error .
     2652             if error-status :error
     2653             or error-status :get-message(1) <> ""
     2654             then do:
     2655               undo move_block, retry move_block .
     2656             end.
     2657           end.
     2658         end.
     2659       end.
     2660       else do:
     2661         for each buf_temp-diasize-handle
     2662         on error undo move_block, retry move_block
     2663         :
     2664           assign
     2665             v-object-handle = buf_temp-diasize-handle.handle-value
     2666           .
     2667           if v-object-handle <> v-diasize-resize-button
     2668           then do:
     2669             assign
     2670               v-object-handle :row = v-object-handle :row + p-change-value
     2671               no-error .
     2672             if error-status :error
     2673             or error-status :get-message(1) <> ""
     2674             then do:
     2675               undo move_block, retry move_block .
     2676             end.
     2677           end.
     2678         end.
     2679         assign
     2680           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2681           no-error .
     2682         if error-status :error
     2683         or error-status :get-message(1) <> ""
     2684         then do:
     2685           undo move_block, retry move_block .
     2686         end.
     2687         for each buf_temp-browse-handle
     2688           where buf_temp-browse-handle.browse-type = 'height':u
     2689         on error undo move_block, retry move_block
     2690         :
     2691           assign
     2692             buf_temp-browse-handle.browse-handle :height
     2693               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2694             no-error .
     2695           if error-status :error
     2696           or error-status :get-message(1) <> ""
     2697           then do:
     2698             undo move_block, retry move_block .
     2699           end.
     2700         end.
     2701         assign
     2702           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2703           no-error .
     2704         if error-status :error
     2705         or error-status :get-message(1) <> ""
     2706         then do:
     2707           undo move_block, retry move_block .
     2708         end.
     2709         if frame Dialog-Frame :scrollable = true
     2710         then do:
     2711           assign
     2712             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2713             no-error .
     2714           if error-status :error
     2715           or error-status :get-message(1) <> ""
     2716           then do:
     2717             undo move_block, retry move_block .
     2718           end.
     2719         end.
     2720       end.
     2721       if p-move-resize = true
     2722       then do:
     2723         run diasize_position-resize-button in this-procedure .
     2724       end.
     2725       if v-diasize-wndstore = true
     2726       then do:
     2727         if connected("ub") = true
     2728         then do:
     2729           define variable v-cntxt-db-num        as integer   no-undo .
     2730           define variable v-cntxt-userid        as character no-undo .
     2731           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2732                                             , OUTPUT v-cntxt-userid
     2733                                             ) .
     2734           run gbl/wndsizew.p
     2735             (input  v-cntxt-db-num
     2736             ,input  v-cntxt-userid
     2737             ,input  v-diasize-proc-name
     2738             ,input  'height':u
     2739             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2740             ) .
     2741         end.
     2742       end.
     2743     end.
     2744     assign
     2745       v-diasize-change-size = false
     2746     .
     2747   end procedure.
     2748   procedure diasize_set-height :
     2749     define input  parameter p-new-height  as decimal   no-undo .
     2750     define input  parameter p-move-resize as logical   no-undo .
     2751     do
     2752     on error undo, return error return-value
     2753     :
     2754       run diasize_change-height in this-procedure
     2755         (input  (p-new-height - frame Dialog-Frame :height)
     2756         ,input  p-move-resize
     2757         ) .
     2758     end.
     2759   end procedure.
     2760   procedure diasize_change-width :
     2761     define input  parameter p-change-value as decimal   no-undo .
     2762     define input  parameter p-move-resize  as logical   no-undo .
     2763     define variable v-field-group-handle   as handle    no-undo .
     2764     define variable v-object-handle        as handle    no-undo .
     2765     define variable v-frame-width          as decimal   no-undo .
     2766     define variable v-frame-virtual-width  as decimal   no-undo .
     2767     define variable v-browse-width         as decimal   no-undo .
     2768     define variable v-window-width         as decimal   no-undo .
     2769     define variable v-window-virtual-width as decimal   no-undo .
     2770     define variable v-change-sign          as integer   no-undo .
     2771     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2772     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2773     if p-change-value > 0
     2774     then do:
     2775       if frame Dialog-Frame :width + p-change-value >
     2776           session :width-chars
     2777       then do:
     2778         assign
     2779           p-change-value = session :width-chars - frame Dialog-Frame :width
     2780         .
     2781         if p-change-value <= 0
     2782         then do:
     2783           run diasize_position-resize-button in this-procedure .
     2784           return .
     2785         end.
     2786       end.
     2787     end.
     2788     if p-change-value < 0
     2789     then do:
     2790       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2791       then do:
     2792         assign
     2793           p-change-value = v-diasize-orig-frame-width
     2794                          - frame Dialog-Frame :width
     2795         .
     2796         if p-change-value >= 0
     2797         then do:
     2798           run diasize_position-resize-button in this-procedure .
     2799           return .
     2800         end.
     2801       end.
     2802     end.
     2803     if p-change-value >= 0
     2804     then do:
     2805       assign
     2806         v-change-sign = 1
     2807       .
     2808     end.
     2809     else do:
     2810       assign
     2811         v-change-sign = -1
     2812       .
     2813     end.
     2814     assign
     2815       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2816     .
     2817     if p-change-value = 0
     2818     then do:
     2819       run diasize_position-resize-button in this-procedure .
     2820       return .
     2821     end.
     2822     move_block:
     2823     do
     2824     on error undo move_block, leave move_block
     2825     :
     2826       if retry
     2827       then do:
     2828         do
     2829         on error undo move_block, leave move_block
     2830         :
     2831           if p-change-value > 0
     2832           then do:
     2833             for each buf_temp-diasize-handle
     2834             on error undo, next
     2835             :
     2836               assign
     2837                 v-object-handle = buf_temp-diasize-handle.handle-value
     2838               .
     2839               if v-object-handle <> v-diasize-resize-button
     2840               then do:
     2841                 assign
     2842                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2843                 .
     2844               end.
     2845             end.
     2846             assign
     2847               v-diasize-browse-handle :width = v-browse-width
     2848             .
     2849             for each buf_temp-browse-handle
     2850               where buf_temp-browse-handle.browse-type = 'width':u
     2851             on error undo, next
     2852             :
     2853               assign
     2854                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2855               .
     2856             end.
     2857             assign
     2858               frame Dialog-Frame :width = v-frame-width
     2859             .
     2860             if frame Dialog-Frame :scrollable = true
     2861             then do:
     2862               assign
     2863                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2864               .
     2865             end.
     2866             run diasize_position-resize-button in this-procedure .
     2867           end.
     2868           else do:
     2869             if frame Dialog-Frame :scrollable = true
     2870             then do:
     2871               assign
     2872                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2873               .
     2874             end.
     2875             assign
     2876               frame Dialog-Frame :width = v-frame-width
     2877             .
     2878             for each buf_temp-browse-handle
     2879               where buf_temp-browse-handle.browse-type = 'width':u
     2880             on error undo, next
     2881             :
     2882               assign
     2883                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2884               .
     2885             end.
     2886             assign
     2887               v-diasize-browse-handle :width = v-browse-width
     2888             .
     2889             for each buf_temp-diasize-handle
     2890             on error undo, next
     2891             :
     2892               assign
     2893                 v-object-handle = buf_temp-diasize-handle.handle-value
     2894               .
     2895               if v-object-handle <> v-diasize-resize-button
     2896               then do:
     2897                 assign
     2898                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2899                 .
     2900               end.
     2901             end.
     2902             run diasize_position-resize-button in this-procedure .
     2903           end.
     2904           assign
     2905             v-diasize-change-size = false
     2906           .
     2907           leave move_block .
     2908         end.
     2909       end.
     2910       assign
     2911         v-diasize-need-full-display = true
     2912       .
     2913       if v-diasize-change-size = false
     2914       then do:
     2915         assign
     2916           v-diasize-change-size = true
     2917         .
     2918       end.
     2919       else do:
     2920         return .
     2921       end.
     2922       assign
     2923         v-frame-width = frame Dialog-Frame :width
     2924         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2925         v-browse-width = v-diasize-browse-handle :width
     2926       .
     2927       for each buf_temp-browse-handle
     2928         where buf_temp-browse-handle.browse-type = 'width':u
     2929       :
     2930         assign
     2931           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2932         .
     2933       end.
     2934       for each buf_temp-diasize-handle
     2935       :
     2936         delete buf_temp-diasize-handle .
     2937       end.
     2938       assign
     2939         v-field-group-handle = frame Dialog-Frame :first-child
     2940       .
     2941       do while valid-handle(v-field-group-handle)
     2942       :
     2943         assign
     2944           v-object-handle = v-field-group-handle :first-child
     2945         .
     2946         do while valid-handle(v-object-handle)
     2947         :
     2948           if  v-object-handle <> v-diasize-browse-handle :handle
     2949           and v-object-handle <> v-diasize-resize-button
     2950           and can-query(v-object-handle, "row")
     2951           and can-query(v-object-handle, "height")
     2952           and ( v-object-handle :col + v-object-handle :width
     2953                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2954               )
     2955           then do:
     2956             find first buf_temp-browse-handle
     2957               where buf_temp-browse-handle.browse-type   = 'width':u
     2958                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2959               no-error .
     2960             if available buf_temp-browse-handle
     2961             then do:
     2962             end.
     2963             else do:
     2964               create buf_temp-diasize-handle .
     2965               assign
     2966                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2967                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2968               .
     2969             end.
     2970           end.
     2971           assign
     2972             v-object-handle = v-object-handle :next-sibling
     2973           .
     2974         end.
     2975         assign
     2976           v-field-group-handle = v-field-group-handle :next-sibling
     2977         .
     2978       end.
     2979       do with frame Dialog-Frame
     2980       :
     2981         hide v-diasize-resize-button .
     2982         v-diasize-resize-button :row = 1.
     2983         v-diasize-resize-button :column = 1.
     2984       end.
     2985       if p-change-value > 0
     2986       then do:
     2987         if frame Dialog-Frame :scrollable = true
     2988         then do:
     2989           assign
     2990             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2991             no-error .
     2992           if error-status :error
     2993           or error-status :get-message(1) <> ""
     2994           then do:
     2995             undo move_block, retry move_block.
     2996           end.
     2997         end.
     2998         assign
     2999           frame Dialog-Frame :width = v-frame-width + p-change-value
     3000           no-error .
     3001         if error-status :error
     3002         or error-status :get-message(1) <> ""
     3003         then do:
     3004           undo move_block, retry move_block.
     3005         end.
     3006         assign
     3007           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3008         no-error .
     3009         if error-status :error
     3010         or error-status :get-message(1) <> ""
     3011         then do:
     3012           undo move_block, retry move_block.
     3013         end.
     3014         for each buf_temp-browse-handle
     3015           where buf_temp-browse-handle.browse-type = 'width':u
     3016         on error undo move_block, retry move_block
     3017         :
     3018           assign
     3019             buf_temp-browse-handle.browse-handle :width
     3020               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3021             no-error .
     3022           if error-status :error
     3023           or error-status :get-message(1) <> ""
     3024           then do:
     3025             undo move_block, retry move_block .
     3026           end.
     3027         end.
     3028         for each buf_temp-diasize-handle
     3029         on error undo move_block, retry move_block
     3030         :
     3031           assign
     3032             v-object-handle = buf_temp-diasize-handle.handle-value
     3033           .
     3034           if v-object-handle <> v-diasize-resize-button
     3035           then do:
     3036             assign
     3037               v-object-handle :col = v-object-handle :col + p-change-value
     3038               no-error .
     3039             if error-status :error
     3040             or error-status :get-message(1) <> ""
     3041             then do:
     3042               undo move_block, retry move_block .
     3043             end.
     3044           end.
     3045         end.
     3046       end.
     3047       else do:
     3048         for each buf_temp-diasize-handle
     3049         on error undo move_block, retry move_block
     3050         :
     3051           assign
     3052             v-object-handle = buf_temp-diasize-handle.handle-value
     3053           .
     3054           if v-object-handle <> v-diasize-resize-button
     3055           then do:
     3056             assign
     3057               v-object-handle :col = v-object-handle :col + p-change-value
     3058               no-error .
     3059             if error-status :error
     3060             or error-status :get-message(1) <> ""
     3061             then do:
     3062               undo move_block, retry move_block .
     3063             end.
     3064           end.
     3065         end.
     3066         for each buf_temp-browse-handle
     3067           where buf_temp-browse-handle.browse-type = 'width':u
     3068         on error undo move_block, retry move_block
     3069         :
     3070           assign
     3071             buf_temp-browse-handle.browse-handle :width
     3072               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3073             no-error .
     3074           if error-status :error
     3075           or error-status :get-message(1) <> ""
     3076           then do:
     3077             undo move_block, retry move_block .
     3078           end.
     3079         end.
     3080         assign
     3081           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3082           no-error .
     3083         if error-status :error
     3084         or error-status :get-message(1) <> ""
     3085         then do:
     3086           undo move_block, retry move_block.
     3087         end.
     3088         assign
     3089           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3090         no-error .
     3091         if error-status :error
     3092         or error-status :get-message(1) <> ""
     3093         then do:
     3094           undo move_block, retry move_block.
     3095         end.
     3096         if frame Dialog-Frame :scrollable = true
     3097         then do:
     3098           assign
     3099             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3100           no-error .
     3101           if error-status :error
     3102           or error-status :get-message(1) <> ""
     3103           then do:
     3104             undo move_block, retry move_block.
     3105           end.
     3106         end.
     3107       end.
     3108       if p-move-resize
     3109       then do:
     3110         run diasize_position-resize-button in this-procedure .
     3111       end.
     3112       if v-diasize-wndstore = true
     3113       then do:
     3114         if connected("ub") = true
     3115         then do:
     3116           define variable v-cntxt-db-num        as integer   no-undo .
     3117           define variable v-cntxt-userid        as character no-undo .
     3118           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3119                                             , OUTPUT v-cntxt-userid
     3120                                             ) .
     3121           run gbl/wndsizew.p
     3122             (input  v-cntxt-db-num
     3123             ,input  v-cntxt-userid
     3124             ,input  v-diasize-proc-name
     3125             ,input  'width':u
     3126             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3127             ) .
     3128         end.
     3129       end.
     3130     end.
     3131     assign
     3132       v-diasize-change-size = false
     3133     .
     3134   end procedure.
     3135   procedure diasize_set-width :
     3136     define input  parameter p-new-width  as decimal   no-undo .
     3137     define input  parameter p-move-resize as logical   no-undo .
     3138     do
     3139     on error undo, return error return-value
     3140     :
     3141       run diasize_change-width in this-procedure
     3142         (input  (p-new-width - frame Dialog-Frame :width)
     3143         ,input  p-move-resize
     3144         ) .
     3145     end.
     3146   end procedure.
     3147   procedure diasize_position-resize-button :
     3148     do with frame Dialog-Frame
     3149     :
     3150       hide v-diasize-resize-button .
     3151       assign
     3152         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3153                     - 1
     3154                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3155         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3156                     - 1
     3157                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3158       .
     3159       view v-diasize-resize-button .
     3160     end.
     3161   end procedure.
     3162   on alt-right anywhere
     3163   do:
     3164     run diasize_change-width in this-procedure
     3165       (input 1
     3166       ,input true
     3167       ) .
     3168     return no-apply .
     3169   end.
     3170   on alt-left anywhere
     3171   do:
     3172     run diasize_change-width in this-procedure
     3173       (input -1
     3174       ,input true
     3175       ) .
     3176     return no-apply .
     3177   end.
     3178   on alt-down anywhere
     3179   do:
     3180     run diasize_change-height in this-procedure
     3181       (input 1
     3182       ,input true
     3183       ) .
     3184     return no-apply .
     3185   end.
     3186   on alt-up anywhere
     3187   do:
     3188     run diasize_change-height in this-procedure
     3189       (input -1
     3190       ,input true
     3191       ) .
     3192     return no-apply .
     3193   end.
     3194   on alt-enter of frame Dialog-Frame
     3195   do:
     3196     run diasize_maximize in this-procedure
     3197       (input  ?
     3198       ).
     3199     return no-apply .
     3200   end.
     3201   procedure diasize_end-move :
     3202     do
     3203     on error undo, return error return-value
     3204     :
     3205       define variable v-row-delta as decimal   no-undo .
     3206       define variable v-col-delta as decimal   no-undo .
     3207       define variable v-new-row as decimal   no-undo .
     3208       define variable v-new-col as decimal   no-undo .
     3209       assign
     3210         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3211         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3212       .
     3213       assign
     3214         v-row-delta = v-new-row - frame Dialog-Frame :height
     3215         v-col-delta = v-new-col - frame Dialog-Frame :width
     3216       .
     3217       run diasize_change-height in this-procedure
     3218         (input v-row-delta
     3219         ,input true
     3220         ) .
     3221       run diasize_change-width in this-procedure
     3222         (input v-col-delta
     3223         ,input true
     3224         ) .
     3225     end.
     3226   end procedure.
     3227   procedure diasize_maximize :
     3228     define input  parameter p-action as logical   no-undo .
     3229     do
     3230     on error undo, return error return-value
     3231     :
     3232       if p-action = ?
     3233       then do:
     3234         if v-diasize-need-maximize = true
     3235         then do:
     3236           assign
     3237             p-action = true
     3238           .
     3239         end.
     3240         else do:
     3241           assign
     3242             p-action = false
     3243           .
     3244         end.
     3245       end.
     3246       if p-action = true
     3247       then do:
     3248         run diasize_change-height in this-procedure
     3249           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3250               - frame Dialog-Frame :height-chars
     3251           ,input true
     3252           ) .
     3253         run diasize_change-width in this-procedure
     3254           (input session :width-chars
     3255               - frame Dialog-Frame :width-chars
     3256           ,input true
     3257           ) .
     3258         assign
     3259           v-diasize-need-maximize = false
     3260         .
     3261       end.
     3262       else do:
     3263         run diasize_change-width in this-procedure
     3264           (input v-diasize-orig-frame-width
     3265               - frame Dialog-Frame :width-chars
     3266           ,input true
     3267           ) .
     3268         run diasize_change-height in this-procedure
     3269           (input v-diasize-orig-frame-height
     3270               - frame Dialog-Frame :height-chars
     3271           ,input true
     3272           ) .
     3273         assign
     3274           v-diasize-need-maximize = true
     3275         .
     3276       end.
     3277     end.
     3278   end procedure.
     3279   procedure diasize_restore-orig-size :
     3280     do
     3281     on error undo, return error return-value
     3282     :
     3283       assign
     3284         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3285         v-diasize-current-frame-height = frame Dialog-Frame :height
     3286       .
     3287       run diasize_set-height in this-procedure
     3288         (input  v-diasize-orig-frame-height
     3289         ,input  true
     3290         ) .
     3291       run diasize_set-width in this-procedure
     3292         (input  v-diasize-orig-frame-width
     3293         ,input  true
     3294         ) .
     3295     end.
     3296   end procedure.
     3297   procedure diasize_restore-current-size :
     3298     do
     3299     on error undo, return error return-value
     3300     :
     3301       run diasize_set-height in this-procedure
     3302         (input  v-diasize-current-frame-height
     3303         ,input  true
     3304         ) .
     3305       run diasize_set-width in this-procedure
     3306         (input  v-diasize-current-frame-width
     3307         ,input  true
     3308         ) .
     3309     end.
     3310   end procedure.
     3311   procedure diasize_set-browse-handle :
     3312     define input  parameter p-browse-handle as handle   no-undo .
     3313     define buffer buf_temp-browse-handle for temp-browse-handle .
     3314     do
     3315     on error undo, return error return-value
     3316     :
     3317       assign
     3318         v-diasize-browse-handle = p-browse-handle
     3319       .
     3320       for each buf_temp-browse-handle
     3321       on error undo, return error return-value
     3322       :
     3323         delete buf_temp-browse-handle .
     3324       end.
     3325     end.
     3326   end procedure.
     3327   procedure diasize_add_browse :
     3328     define input  parameter p-browse-type   as character no-undo .
     3329     define input  parameter p-browse-handle as handle    no-undo .
     3330     define buffer buf_temp-browse-handle for temp-browse-handle .
     3331     do
     3332     on error undo, return error return-value
     3333     :
     3334       assign
     3335         v-diasize-browse-number = v-diasize-browse-number + 1
     3336       .
     3337       create buf_temp-browse-handle .
     3338       assign
     3339         buf_temp-browse-handle.browse-type   = p-browse-type
     3340         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3341         buf_temp-browse-handle.browse-handle = p-browse-handle
     3342       .
     3343     end.
     3344   end procedure.
     3345   procedure diasize_init :
     3346     define variable v-default-value    as logical   no-undo .
     3347     define variable v-restore-saved    as logical   no-undo .
     3348     define variable v-resize-value-str as character no-undo .
     3349     do
     3350     on error undo, return error return-value
     3351     :
     3352       do with frame Dialog-Frame
     3353       :
     3354         assign
     3355           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3356           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3357           v-diasize-browse-handle     = browse BR-docs :handle
     3358         .
     3359         create button v-diasize-resize-button
     3360         assign
     3361           parent        = frame Dialog-Frame :first-child
     3362           label         = "s"
     3363           height-pixels = 16
     3364           width-pixels  = 16
     3365           visible       = true
     3366           sensitive     = true
     3367           movable       = true
     3368           triggers:
     3369             on end-move persistent run diasize_end-move in this-procedure .
     3370           end triggers.
     3371         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3372         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3373         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3374         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3375         assign
     3376           v-diasize-wndmax = false
     3377         .
     3378         if connected("ub") = true
     3379         then do:
     3380           define variable v-cntxt-db-num        as integer   no-undo .
     3381           define variable v-cntxt-userid        as character no-undo .
     3382           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3383                                             , OUTPUT v-cntxt-userid
     3384                                             ) .
     3385           run gbl/wndpar_r.p
     3386             (input  v-cntxt-db-num
     3387             ,input  v-cntxt-userid
     3388             ,input  'wndmax':U
     3389             ,output v-diasize-wndmax
     3390             ,output v-default-value
     3391             ) .
     3392         end.
     3393         assign
     3394           v-diasize-wndstore = false
     3395         .
     3396         if connected("ub") = true
     3397         then do:
     3398           run gbl/wndpar_r.p
     3399             (input  v-cntxt-db-num
     3400             ,input  v-cntxt-userid
     3401             ,input  'wndstore':U
     3402             ,output v-diasize-wndstore
     3403             ,output v-default-value
     3404             ) .
     3405         end.
     3406         assign
     3407           v-diasize-proc-name = entry(1, program-name(2), '.')
     3408         .
     3409         if v-diasize-wndstore = true
     3410         then do:
     3411           assign
     3412             v-restore-saved = false
     3413           .
     3414           if connected("ub") = true
     3415           then do:
     3416             run gbl/wndsizer.p
     3417               (input  v-cntxt-db-num
     3418               ,input  v-cntxt-userid
     3419               ,input  v-diasize-proc-name
     3420               ,input  'height':u
     3421               ,output v-resize-value-str
     3422               ) .
     3423             if v-resize-value-str <> '':U
     3424             then do:
     3425               run diasize_change-height in this-procedure
     3426                 (input  integer(v-resize-value-str)
     3427                 ,input  true
     3428                 ) .
     3429               assign
     3430                 v-restore-saved = true
     3431               .
     3432             end.
     3433           end.
     3434           if connected("ub") = true
     3435           then do:
     3436             run gbl/wndsizer.p
     3437               (input  v-cntxt-db-num
     3438               ,input  v-cntxt-userid
     3439               ,input  v-diasize-proc-name
     3440               ,input  'width':u
     3441               ,output v-resize-value-str
     3442               ) .
     3443             if v-resize-value-str <> '':U
     3444             then do:
     3445               run diasize_change-width in this-procedure
     3446                 (input  integer(v-resize-value-str)
     3447                 ,input  true
     3448                 ) .
     3449               assign
     3450                 v-restore-saved = true
     3451               .
     3452             end.
     3453           end.
     3454           if v-restore-saved <> true
     3455           then do:
     3456             if v-diasize-wndmax = true
     3457             then do:
     3458               run diasize_maximize in this-procedure
     3459                 (input  true
     3460                 ) .
     3461             end.
     3462           end.
     3463         end.
     3464         else do:
     3465           if v-diasize-wndmax = true
     3466           then do:
     3467             run diasize_maximize in this-procedure
     3468               (input  true
     3469               ) .
     3470           end.
     3471         end.
     3472       end.
     3473     end.
     3474   end procedure.
     3475   procedure diasize_need-full-display :
     3476     define output parameter p-need-full-display as logical   no-undo .
     3477     do
     3478     on error undo, return error return-value
     3479     :
     3480       assign
     3481         p-need-full-display = v-diasize-need-full-display
     3482       .
     3483       assign
     3484         v-diasize-need-full-display = false
     3485       .
     3486     end.
     3487   end procedure.
     3488   procedure get-context :
     3489      define output parameter p-db-num as integer          no-undo.
     3490      define output parameter p-user-id as character        no-undo.
     3491      define variable v-login               as character    no-undo.
     3492      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3493      define buffer buf_user-login  for ub.user-login .
     3494      do
     3495      on error undo, return error
     3496      :
     3497            FIND FIRST buf_sys-ctrl no-lock.
     3498            ASSIGN
     3499               v-login = USERID("ub")
     3500               p-db-num = buf_sys-ctrl.db-num
     3501            .
     3502            FIND FIRST buf_user-login
     3503                 WHERE buf_user-login.db-num = p-db-num
     3504                   AND buf_user-login.user-login = v-login
     3505                 no-lock
     3506                 no-error
     3507                 .
     3508            IF AVAILABLE buf_user-login
     3509            THEN DO:
     3510               assign
     3511                  p-user-id = buf_user-login.user-id
     3512               .
     3513            END.
     3514      end.
     3515   end procedure.
     3516   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3517   DEF VAR cur-clmn-numbr-docs as INT EXTENT 10 no-undo.
     3518   DEF VAR varmvibr-docs       as INT no-undo.
     3519   DEF VAR varmvjbr-docs       as INT no-undo.
     3520   DEF VAR varmvkbr-docs       as INT no-undo.
     3521   DEF VAR varmvlbr-docs       as INT no-undo.
     3522   DEF VAR move-elementbr-docs as INT no-undo.
     3523   def var jjbr-docs           as int no-undo.
     3524   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3525     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3526   END.
     3527   RUN start-mv-clmnbr-docs.
     3528   PROCEDURE start-mv-clmnbr-docs:
     3529   def var old-session as logical no-undo.
     3530      old-session = SESSION:IMMEDIATE-DISPLAY.
     3531      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3532      SESSION:IMMEDIATE-DISPLAY = old-session.
     3533   END.
     3534   ON ctrl-cursor-right OF BROWSE br-docs do:
     3535     RUN re-move-clmnbr-docs ( 5, 10).
     3536   END.
     3537   ON ctrl-cursor-left OF BROWSE br-docs do:
     3538     RUN re-move-clmnbr-docs (10, 5).
     3539   END.
     3540   PROCEDURE re-move-clmnbr-docs:
     3541     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3542     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3543     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3544       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3545     END.
     3546     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3547     if source-column > target-column THEN
     3548     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3549       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3550           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3551             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3552           END.
     3553       END.
     3554     END.
     3555     ELSE
     3556     DO varmvjbr-docs = source-column + 1 to target-column:
     3557       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3558         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3559           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3560         END.
     3561       END.
     3562     END.
     3563     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3564       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3565     END.
     3566   END PROCEDURE.
     3567   PROCEDURE ch-clmnbr-docs:
     3568     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3569     if cur-clmn-loc <= 5 then do:
     3570       return .
     3571     end.
     3572     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3573       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3574     END.
     3575     RUN re-move-clmnbr-docs (cur-clmn-loc, 5).
     3576   END PROCEDURE.
     3577   PROCEDURE mv-brw-defaultbr-docs:
     3578   def var old-session as logical no-undo.
     3579     old-session = SESSION:IMMEDIATE-DISPLAY.
     3580     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3581     do varmvlbr-docs = 5 to EXTENT(cur-clmn-numbr-docs):
     3582       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3583     END.
     3584     RUN start-mv-clmnbr-docs.
     3585     SESSION:IMMEDIATE-DISPLAY = old-session.
     3586   END PROCEDURE.
     3587   .
     3588   def var sort-labelbr-docs   as character no-undo .
     3589   def var sort-clmnbr-docs    as handle    no-undo .
     3590   def var cur-clmnbr-docs     as handle    no-undo .
     3591   def var cur-clmn-locbr-docs as integer   no-undo .
     3592   def var re-querybr-docs     as logical   initial no no-undo .
     3593   on start-search, ctrl-o of br-docs in frame Dialog-Frame do:
     3594      run sort-brbr-docs
     3595        (input (if available buf_add-doc
     3596                then recid(buf_add-doc)
     3597                else ?
     3598               )
     3599        ).
     3600   end.
     3601   PROCEDURE sort-brbr-docs :
     3602     define input parameter p-recid as recid no-undo .
     3603     if re-querybr-docs = no then do:
     3604       assign
     3605          cur-clmnbr-docs = br-docs:current-column in frame Dialog-Frame
     3606       .
     3607       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     3608       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     3609         assign
     3610            sort-labelbr-docs = ""
     3611            sort-clmnbr-docs = ?
     3612         .
     3613        end.
     3614        else do:
     3615          assign
     3616            sort-labelbr-docs = cur-clmnbr-docs:label
     3617            sort-clmnbr-docs  = cur-clmnbr-docs
     3618            sort-clmnbr-docs:column-fgcolor = 4
     3619          .
     3620        end.
     3621      end.
     3622     assign
     3623       cur-clmn-locbr-docs = 1
     3624     .
     3625     def var column-handle as handle no-undo .
     3626     column-handle = br-docs:first-column.
     3627     do while valid-handle(column-handle) :
     3628       if column-handle = cur-clmnbr-docs then do:
     3629         leave .
     3630       end.
     3631       column-handle = column-handle:NEXT-COLUMN.
     3632       assign
     3633         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     3634       .
     3635     end.
     3636     case sort-labelbr-docs:
     3637           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_add-doc), &1&2&1)', chr(34), rid-list)     .     run OpenBr(yes, no, '':U).   . END.
     3638           when 'Статус'  then DO:    assign       sort-column-name = "buf_add-doc.status_"     .     run OpenBr(yes, no, '':U).   . END.
     3639           when 'ФО'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-postavka&1,recid(buf_add-doc))',chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3640           when '№ док-та'  then DO:    assign       sort-column-name = "buf_add-doc.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3641           when 'Создан'  then DO:    assign       sort-column-name = "buf_add-doc.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     3642           when 'Факт'  then DO:    assign       sort-column-name = "buf_add-doc.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3643           when 'Объект'  then DO:    assign       sort-column-name = "buf_add-doc.obj-code"     .     run OpenBr(yes, no, '':U).   . END.
     3644           when 'Тип'  then DO:    assign       sort-column-name = "buf_add-doc.obj-type"     .     run OpenBr(yes, no, '':U).   . END.
     3645           when 'Сумма (руб)'  then DO:    assign       sort-column-name = "buf_add-doc.sum-rubl"     .     run OpenBr(yes, no, '':U).   . END.
     3646           when 'Счет-фактура'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1sfactur&1, recid(buf_add-doc))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3647       otherwise do:
     3648         assign
     3649           sort-column-name = ""
     3650         .
     3651         run OpenBr(yes, no, '':U).
     3652           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     3653             run mv-brw-defaultbr-docs.
     3654           end.
     3655         if sort-labelbr-docs <> "" then do:
     3656           assign
     3657             cur-clmnbr-docs:column-fgcolor = 0
     3658           .
     3659         end.
     3660         assign
     3661           cur-clmn-locbr-docs = ?
     3662         .
     3663       end.
     3664     end case.
     3665       if cur-clmn-locbr-docs <> ? then do:
     3666         if can-do( this-procedure:internal-entries, 'ch-clmnbr-docs') then do:
     3667           run ch-clmnbr-docs in this-procedure (cur-clmn-locbr-docs).
     3668         end.
     3669       end.
     3670     if p-recid <> ? then do:
     3671       reposition br-docs to recid p-recid no-error.
     3672       apply "value-changed" to br-docs in frame Dialog-Frame.
     3673     end.
     3674     apply "entry" to br-docs in frame Dialog-Frame.
     3675   END PROCEDURE.
     3676   procedure re-open-query-srt-clmnbr-docs:
     3677   if cur-clmnbr-docs = ? then do:
     3678      run OpenBr(yes, no, '':U).
     3679   end.
     3680   else do:
     3681      assign re-querybr-docs = yes.
     3682      run sort-brbr-docs
     3683        (input (if available buf_add-doc
     3684                then recid(buf_add-doc)
     3685                else ?
     3686               )
     3687        ).
     3688      assign re-querybr-docs = no.
     3689   end.
     3690   end.
     3691   MAIN-BLOCK:
     3692   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3693      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3694      buf_add-doc.status_:read-only in browse br-docs = true .
     3695      disable  b-rep with frame Dialog-Frame .
     3696      define buffer find_code for ub.add-doc.
     3697         if pardoc-rec <> ? then do:
     3698         FIND FIRST find_code No-LOCK where
     3699                    recid(find_code) = pardoc-rec No-ERROR.
     3700         if not avail find_code then do:
     3701           message
     3702           vss-workfile vss-revision vss-description skip
     3703           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3704           view-as alert-box error .
     3705           return error.
     3706         end.
     3707         doc-rec = pardoc-rec.
     3708       end.
     3709     run my-enable_ui in this-procedure .
     3710     run openbr in this-procedure (yes, no, '':u).
     3711     if pardoc-rec <> ? then
     3712     reposition br-docs to recid doc-rec no-error.
     3713     run diasize_add_browse in this-procedure
     3714         (input  'width':u
     3715         ,input  browse br-nakl :handle
     3716         ) .
     3717     run diasize_init in this-procedure .
     3718     WAIT-FOR GO OF FRAME Dialog-Frame focus br-docs.
     3719   END.
     3720   run disable_ui in this-procedure .
     3721   PROCEDURE close-all :
     3722   define input  parameter  p-doc-code as character no-undo .
     3723   define variable varcheck-return as logical no-undo .
     3724   define variable varchg-inv as logical no-undo .
     3725   define buffer buf_trn-doc for ub.trn-doc  .
     3726   tr:
     3727   do transaction
     3728      ON ERROR   UNDO tr, LEAVE
     3729      ON END-KEY UNDO tr, LEAVE
     3730      ON STOP    UNDO tr , LEAVE :
     3731   for each ub.add-trn no-lock where
     3732            ub.add-trn.doc-code = p-doc-code :
     3733        find first  buf_trn-doc no-lock where
     3734                    buf_trn-doc.doc-code = ub.add-trn.trn-doc-code
     3735                    no-error .
     3736        if not available buf_trn-doc then do:
     3737           message 'Не найдена ПН с №' ub.add-trn.trn-doc-code
     3738           view-as alert-box information .
     3739           undo, return error return-value .
     3740        end.
     3741        if buf_trn-doc.tot-other  <> 0 or
     3742           buf_trn-doc.tot-transp <> 0 then do:
     3743             run str/add-exp.p (input parparentproc,
     3744                             input buf_trn-doc.doc-code ,
     3745                             input buf_trn-doc.tot-other  * buf_trn-doc.exch-rate / buf_trn-doc.exch-scale,
     3746                             input buf_trn-doc.tot-transp * buf_trn-doc.exch-rate / buf_trn-doc.exch-scale) no-error.
     3747             if error-status :error
     3748             then do:
     3749               undo, return error substitute ( "Ошибка при установке дополнительных расходов &1 .", return-value ).
     3750             end.
     3751        end.
     3752   end.
     3753   run str/addsuper.p (parparentproc , p-doc-code ) no-error .
     3754   if error-status :error then do:
     3755      message
     3756        vss-workfile vss-revision vss-description skip
     3757        error-status :get-message(1) skip
     3758        return-value skip
     3759        "Ошибка размазывания ДопРасходов в учетную цену  (addsuper.p)"
     3760        view-as alert-box error
     3761      .
     3762      undo, return error return-value .
     3763   end.
     3764   for each ub.add-trn no-lock where
     3765            ub.add-trn.doc-code = p-doc-code:
     3766        find first  buf_trn-doc no-lock where
     3767                    buf_trn-doc.doc-code = ub.add-trn.trn-doc-code no-error .
     3768        if available buf_trn-doc then do:
     3769              run str/trn-stat.p (
     3770                   input  parparentproc ,
     3771                   input  this-procedure  ,
     3772                   input  (if buf_trn-doc.flag_  then  '<закрытие документа>':U else  '<закрытие документа на факт>':U) ,
     3773                   input  buf_trn-doc.doc-code,
     3774                   input  varcheck-return  ,
     3775                   input  v-cntxt-db-num   ,
     3776                   input  v-cntxt-in-ov    ,
     3777                   input  v-cntxt-rsrv-time,
     3778                   input  v-cntxt-load-time,
     3779                   input  v-cntxt-holidays ,
     3780                   input  yes ,
     3781                   output varchg-inv ,
     3782                   output table gds-list) no-error .
     3783             if error-status:error then do:
     3784               message
     3785                 vss-workfile vss-revision vss-description skip
     3786                 "Ошибка при принудительном закрытии документа " buf_trn-doc.doc-code skip
     3787                 return-value skip
     3788                 error-status :get-message(1)
     3789                 view-as alert-box error.
     3790               undo, return error return-value .
     3791             end.
     3792        end.
     3793   end.
     3794   end.
     3795   END PROCEDURE.
     3796   PROCEDURE close-nakl :
     3797    do
     3798    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3799    :
     3800   define input parameter p-trn-code as character no-undo .
     3801   define buffer buf_s-trn-doc for ub.trn-doc.
     3802   define variable varmode            as   character           no-undo.
     3803   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3804   define variable varflag            like ub.trn-doc.flag     no-undo.
     3805   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3806   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3807   define variable varcheck-return as logical no-undo .
     3808   define variable varchg-inv as logical no-undo .
     3809   assign
     3810     varmode         = '<закрытие документа>':U
     3811     varstatus       = 'новый':U
     3812     varflag         = false
     3813     varcopystatus   = 'новый':U
     3814     varcopyflag     = true
     3815     varcheck-return = true
     3816     varchg-inv      = true
     3817     .
     3818   run str/trn-graf.p
     3819       (input  p-trn-code,
     3820       input  v-cntxt-db-num,
     3821       input  varmode,
     3822       output varstatus,
     3823       output varflag,
     3824       output varcopystatus,
     3825       output varcopyflag
     3826     ) no-error.
     3827   if error-status:error then do:
     3828      if error-status :get-message(1) <> "" or
     3829         return-value = ""                  then do:
     3830        message "Ошибка при вызове trn-graf.p." skip
     3831        error-status :get-meSSAGE(1) skip
     3832        return-value skip
     3833        view-as alert-box error.
     3834      end.
     3835      else do:
     3836        message return-value
     3837        view-as alert-box error.
     3838      end.
     3839      return error.
     3840   end.
     3841   run str/trn-stat.p (
     3842       input  parparentproc ,
     3843       input  this-procedure  ,
     3844       input  varmode,
     3845       input  p-trn-code,
     3846       input  varcheck-return,
     3847       input  v-cntxt-db-num,
     3848       input  v-cntxt-in-ov,
     3849       input  v-cntxt-rsrv-time,
     3850       input  v-cntxt-load-time,
     3851       input  v-cntxt-holidays,
     3852       input  yes,
     3853       output varchg-inv,
     3854       output table gds-list)
     3855   no-error.
     3856   if error-status:error then do:
     3857      message
     3858        vss-workfile vss-revision vss-description skip
     3859        "Ошибка при принудительном закрытии документа " p-trn-code skip
     3860        return-value skip
     3861        trim(error-status :get-message(1))
     3862        trim(error-status :get-message(2))
     3863        trim(error-status :get-message(3))
     3864        trim(error-status :get-message(4))
     3865        trim(error-status :get-message(5)) skip
     3866        view-as alert-box error.
     3867      return error.
     3868   end.
     3869     end.
     3870   END PROCEDURE.
     3871   PROCEDURE disable_UI :
     3872     HIDE FRAME Dialog-Frame.
     3873   END PROCEDURE.
     3874   PROCEDURE enable_UI :
     3875     DISPLAY sch-code sch-date sch-fact sch-num loc-creid
     3876         WITH FRAME Dialog-Frame.
     3877     ENABLE b-quit b-sel b-rep b-close b-open B-close-trn-all B-fo b-help b-mark
     3878            b-add b-lkp b-chg b-del b-export b-sf b-print b-sch sch-code sch-date
     3879            sch-fact br-docs B-lkp-2 br-nakl sch-num loc-creid
     3880         WITH FRAME Dialog-Frame.
     3881     VIEW FRAME Dialog-Frame.
     3882     OPEN QUERY br-docs FOR EACH buf_add-doc NO-LOCK by buf_add-doc.doc-date desc                                                      by buf_add-doc.doc-code desc .    OPEN QUERY br-nakl FOR EACH buf_add-trn WHERE                   buf_add-trn.doc-code = buf_add-doc.doc-code NO-LOCK,              EACH buf_trn-doc  where                  buf_trn-doc.doc-code =  buf_add-trn.trn-doc-code NO-LOCK.
     3883   END PROCEDURE.
     3884   PROCEDURE export-doc :
     3885   define input  parameter par-doc-code as character no-undo .
     3886   define variable varxmldocfl      as character no-undo.
     3887   define variable varxmldocfl-type as character no-undo.
     3888   define variable v-file-name as character no-undo .
     3889   define variable for-dir as character no-undo .
     3890   define variable accum-count as integer no-undo init 0.
     3891   define variable accum-count-ok as integer no-undo init 0 .
     3892   define variable loclog as logical no-undo .
     3893   define variable ii as integer no-undo .
     3894   define variable ii0 as integer no-undo .
     3895   if not available buf_add-doc then do:
     3896     message "Неправильный выбор документа.".
     3897     return no-apply.
     3898   end.
     3899   assign
     3900   v-file-name =  ?
     3901   .
     3902   run bge/xmladd.p ( input buf_add-doc.host-code, buf_add-doc.doc-code, input-output v-file-name, yes, yes) no-error .
     3903   define variable v-sys-key   as character         no-undo.
     3904   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     3905   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     3906     (output v-sys-key
     3907     ) no-error .
     3908   if search ("exmldoc.bat") <> ? then do:
     3909     os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     3910   end.
     3911   else do:
     3912     if search (v-file-name ) <> ? then do:
     3913       if accum-count-ok  > 1 then
     3914          message "ДопРасходы выгружены в файл " v-file-name view-as alert-box.
     3915       else
     3916         message "ДопРасход выгружен в файл " v-file-name view-as alert-box.
     3917     end.
     3918   end.
     3919   END PROCEDURE.
     3920   PROCEDURE gen-2 :
     3921   define buffer bf_sysconf for ub.sysconf.
     3922   define buffer bf_add-doc for ub.add-doc.
     3923   define variable vari as integer no-undo.
     3924   define variable vardoc-code as integer no-undo.
     3925   do
     3926   on error undo, return error return-value
     3927   :
     3928   if rid-list = "" then do:
     3929     if available buf_add-doc then do:
     3930       assign
     3931         rid-list = string(recid(buf_add-doc)).
     3932     end.
     3933   end.
     3934   vari-cycle:
     3935   do vari = 1 to num-entries (rid-list):
     3936     assign
     3937       vardoc-code = integer(entry (vari, rid-list)).
     3938     find first bf_add-doc where recid(bf_add-doc) = vardoc-code exclusive-lock.
     3939     if bf_add-doc.status_ <> 'факт':U then do:
     3940       message "Документ " bf_add-doc.status_ " не в статусе " 'факт':U " . Пропускаем."
     3941       view-as alert-box.
     3942       next vari-cycle.
     3943     end.
     3944     find first bf_sysconf where bf_sysconf.host-code = bf_add-doc.host-code no-lock.
     3945     if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
     3946       message "Главная БД для фирмы по документу с кодом " bf_add-doc.doc-code " не является текущей БД." skip
     3947               "Текущая БД: " v-cntxt-db-num skip
     3948               "Главная БД фирмы: " bf_sysconf.firm-db-num
     3949       view-as alert-box error.
     3950       next vari-cycle.
     3951     end.
     3952     if bf_add-doc.cr-incfo = yes then do:
     3953       message "По документу " bf_add-doc.doc-code " уже генерилось финансовое обязательство от " bf_add-doc.incfo-date " числа."
     3954       view-as alert-box.
     3955       next vari-cycle.
     3956     end.
     3957     else do:
     3958       if bf_add-doc.need-incfo = 1 or
     3959          bf_add-doc.need-incfo = 2 then do:
     3960         assign
     3961           bf_add-doc.need-incfo = 0.
     3962       end.
     3963       else do:
     3964         message "Данный документ не нуждался в генерации финобязательств по поставке."
     3965         view-as alert-box.
     3966         next vari-cycle.
     3967       end.
     3968       reposition br-docs to recid recid(bf_add-doc) no-error.
     3969       if not error-status:error then do:
     3970         display fo-postavka(recid( bf_add-doc)) @ pp with browse br-docs.
     3971       end.
     3972     end.
     3973   end.
     3974   assign
     3975     rid-list = "".
     3976   end.
     3977   END PROCEDURE.
