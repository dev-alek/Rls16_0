        1   DEFINE TEMP-TABLE temp-schedule-attr NO-UNDO LIKE ub.schedule-attr.
        2   define input  parameter parparentproc as widget-handle   no-undo.
        3   define input  parameter p-cre-db-num  as integer   no-undo .
        4   define input  parameter p-task-type   as character no-undo .
        5   define input  parameter p-task-num    as integer   no-undo .
        6   define output parameter p-cancel      as logical      no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Выбор параметров для автоматическиго обработки документов продаж по расписанию.".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   procedure cur-time :
      120      define output parameter p-today as date      no-undo .
      121      define output parameter p-time  as integer   no-undo .
      122     do
      123     on error undo, return error
      124     :
      125       define variable v-date1 as date      no-undo .
      126       define variable v-date2 as date      no-undo .
      127       define variable v-time  as integer   no-undo .
      128       assign
      129         v-date1 = today
      130         v-time  = time
      131         v-date2 = today
      132       .
      133       if v-date1 <> v-date2
      134       then do:
      135         assign
      136           v-date1 = today
      137           v-time  = v-time
      138         .
      139       end.
      140       assign
      141         p-today = v-date1
      142         p-time  = v-time
      143       .
      144     end.
      145   end.
      146   function cur-time-date returns character
      147   :
      148     return string(today, '99/99/9999':U) .
      149   end.
      150   function cur-time-mjd returns decimal
      151   :
      152     define variable v-date as date      no-undo .
      153     define variable v-time as integer   no-undo .
      154     run cur-time in this-procedure
      155       (output v-date
      156       ,output v-time
      157       ) .
      158     return integer(v-date) - 2400002 + (v-time / 86400) .
      159   end.
      160   function cur-time-get-ending-index returns integer
      161   (input p-number as integer
      162   )
      163   :
      164     if p-number < 0
      165     or p-number = ?
      166     then do:
      167       return 1 .
      168     end.
      169     define variable v-rest as integer   no-undo .
      170     assign
      171       p-number = p-number modulo 100
      172     .
      173     if p-number < 20
      174     then do:
      175       assign
      176         v-rest = p-number
      177       .
      178     end.
      179     else do:
      180       assign
      181         v-rest = p-number modulo 10
      182       .
      183     end.
      184     case v-rest :
      185       when 1
      186       then do:
      187         return 2 .
      188       end.
      189       when 2 or
      190       when 3 or
      191       when 4
      192       then do:
      193         return 3 .
      194       end.
      195       otherwise do:
      196         return 1 .
      197       end.
      198     end case .
      199   end.
      200   procedure cur-time-mjd-to-date :
      201      define input  parameter i-mjd-diff as decimal no-undo.
      202      define output parameter o-Date     as date    no-undo.
      203      define output parameter o-Time     as integer no-undo.
      204      define variable v-day-number as integer   no-undo .
      205      if    i-mjd-diff < 0
      206         or i-mjd-diff = ?
      207      then do:
      208         return "?" .
      209      end.
      210      assign
      211         v-day-number = truncate(i-mjd-diff,0).
      212         o-Date = date(v-day-number + 2400002).
      213         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215   end.
      216   function cur-time-mjd-to-string returns character
      217   (input p-mjd-diff as decimal
      218   )
      219   :
      220     define variable v-day-number as integer   no-undo .
      221     define variable v-seconds    as integer   no-undo .
      222     define variable v-hour       as integer   no-undo .
      223     define variable v-min        as integer   no-undo .
      224     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      225     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      226     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      227     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      228     if p-mjd-diff < 0
      229     or p-mjd-diff = ?
      230     then do:
      231       return "?" .
      232     end.
      233     assign
      234       v-day-number = integer(truncate(p-mjd-diff,0))
      235       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237     if v-seconds > 86400
      238     then do:
      239       assign
      240         v-seconds = 86400 - 1
      241       .
      242     end.
      243     if v-seconds < 0
      244     then do:
      245       assign
      246         v-seconds = 0
      247       .
      248     end.
      249     assign
      250       v-hour = truncate(v-seconds / 3600, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 3600
      254     .
      255     assign
      256       v-min = truncate(v-seconds / 60, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 60
      260     .
      261     return
      262         (if v-day-number <> 0
      263           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0
      267           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      271           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      272           else ""
      273         )
      274       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      275       .
      276   end.
      277   function cur-time-string returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-string-sec returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      296   end.
      297   function cur-time-custom  returns character
      298   (input p-prefix as character
      299   ,input p-date-format as character
      300   ,input p-delimiter as character
      301   ,input p-time-format as character
      302   ,input p-suffix as character
      303   )
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return
      312       p-prefix
      313       + string(v-date, p-date-format)
      314       + p-delimiter
      315       + string(v-time, p-time-format)
      316       + p-suffix
      317       .
      318   end.
      319   function cur-time-print  returns character
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      328   end.
      329   function cur-time-datetime returns datetime
      330   :
      331     define variable v-char as character no-undo .
      332     define variable v-datetime as datetime no-undo .
      333     v-char = cur-time-string().
      334     v-datetime = datetime(v-char).
      335     return  v-datetime.
      336   end.
      337   function cur-time-string-msec returns character
      338   :
      339     define variable v-date as datetime  no-undo .
      340     v-date = now.
      341     return string(v-date) .
      342   end.
      343   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344   define temp-table temp-schedule-free no-undo
      345   field free-id as character
      346   field free-task-name as character
      347   field proc-run-name as character
      348   field proc-param-edit-name as character
      349   field conf-param as character
      350   field is-gbd as logical
      351   field is-ubd as logical
      352   field enable-concurrent-0 as logical
      353   field enable-concurrent-db as logical
      354   field other-info as character
      355   field enc-key as character
      356   field is-rum as logical
      357   index pi is unique primary
      358   free-id.
      359   procedure schedule-attr-name :
      360   do
      361     on error undo, return error
      362     :
      363     define input  parameter p-code           as character no-undo .
      364     define output parameter p-type           as character no-undo .
      365     define output parameter p-format         as character no-undo .
      366     define output parameter p-label          as character no-undo .
      367     define output parameter p-user-can-edit  as logical   no-undo .
      368     define output parameter p-output-display as logical   no-undo .
      369     define output parameter p-other          as character no-undo .
      370       if index(p-code, chr(4)) > 0 then do:
      371         p-code = entry(1, p-code, chr(4)).
      372       end.
      373       case p-code :
      374               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      375               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      376               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      377               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      378               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      379               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      380               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      381               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      382               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      383         otherwise do:
      384           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      385         end.
      386       end.
      387     end.
      388   end procedure.
      389   procedure schedule-attr-tooltip :
      390   do
      391     on error undo, return error
      392     :
      393       define input  parameter p-code    as character no-undo .
      394       define output parameter p-tooltip as character no-undo .
      395       define output parameter p-label   as character no-undo .
      396       if index(p-code, chr(4)) > 0 then do:
      397         p-code = entry(1, p-code, chr(4)).
      398       end.
      399       case p-code :
      400               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      401               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      402               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      403               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      404               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      405               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      406               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      407               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      408               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      409         otherwise do:
      410               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      411         end.
      412       end.
      413     end.
      414   end procedure.
      415   procedure schedule-attr-value :
      416   do
      417   on error undo, return error return-value
      418   :
      419   define input parameter  p-cre-db-num as integer    no-undo.
      420   define input parameter  p-task-type  as character  no-undo.
      421   define input parameter  p-task-num   as integer    no-undo.
      422   define input parameter  p-code       as character  no-undo.
      423   define output parameter p-value      as character  no-undo.
      424   define output parameter p-type       as character  no-undo.
      425       define variable v-format         as character no-undo .
      426       define variable v-label          as character no-undo .
      427       define variable v-user-can-edit  as logical   no-undo .
      428       define variable v-output-display as logical   no-undo .
      429       define variable v-other          as character no-undo .
      430       define buffer buf_schedule-attr for ub.schedule-attr.
      431       run schedule-attr-name in this-procedure (
      432             input  p-code
      433           , output p-type
      434           , output v-format
      435           , output v-label
      436           , output v-user-can-edit
      437           , output v-output-display
      438           , output v-other
      439       ) no-error .
      440       if error-status :error
      441       then do:
      442           undo, return error return-value .
      443       end.
      444       if p-code begins ('schd-free-id':U + chr(4))
      445       and entry(2, p-code, chr(4)) = '':U then do:
      446         find first buf_schedule-attr no-lock
      447             where buf_schedule-attr.cre-db-num = p-cre-db-num
      448               and buf_schedule-attr.task-type  = p-task-type
      449               and buf_schedule-attr.task-num   = p-task-num
      450               and buf_schedule-attr.attr-code  begins p-code
      451         no-error .
      452       end.
      453       else do:
      454         find first buf_schedule-attr no-lock
      455             where buf_schedule-attr.cre-db-num = p-cre-db-num
      456               and buf_schedule-attr.task-type  = p-task-type
      457               and buf_schedule-attr.task-num   = p-task-num
      458               and buf_schedule-attr.attr-code  = p-code
      459         no-error .
      460       end.
      461       if available buf_schedule-attr
      462       then do:
      463           assign
      464               p-value = buf_schedule-attr.attr-value
      465           .
      466       end.
      467       else do:
      468         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      469            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      470         end.
      471         else do:
      472           assign
      473               p-value = if p-type = 'L':U then "no":U else ""
      474           .
      475         end.
      476       end.
      477   end.
      478   end procedure.
      479   procedure schedule-attr-write :
      480   do
      481   on error undo, return error
      482   :
      483   define input parameter p-cre-db-num  as integer   no-undo.
      484   define input parameter p-task-type   as character no-undo.
      485   define input parameter p-task-num    as integer   no-undo.
      486   define input parameter p-code        as character no-undo.
      487   define input parameter p-value       as character no-undo.
      488       define variable v-type              as character                no-undo.
      489       define variable v-format            as character                no-undo.
      490       define variable v-label             as character                no-undo.
      491       define variable v-user-can-edit     as logical                  no-undo.
      492       define variable v-output-display    as logical                  no-undo.
      493       define variable v-other             as character                no-undo.
      494       define buffer buf_schedule-attr for ub.schedule-attr .
      495       run schedule-attr-name in this-procedure (
      496             input  p-code
      497           , output v-type
      498           , output v-format
      499           , output v-label
      500           , output v-user-can-edit
      501           , output v-output-display
      502           , output v-other
      503       ) no-error.
      504       if error-status :error
      505       then do:
      506           undo, return error return-value.
      507       end.
      508       find first buf_schedule-attr exclusive-lock
      509            where buf_schedule-attr.cre-db-num = p-cre-db-num
      510              and buf_schedule-attr.task-type  = p-task-type
      511              and buf_schedule-attr.task-num   = p-task-num
      512              and buf_schedule-attr.attr-code  = p-code
      513       no-error.
      514       if not available buf_schedule-attr
      515       then do:
      516           create buf_schedule-attr.
      517           assign
      518             buf_schedule-attr.cre-db-num = p-cre-db-num
      519             buf_schedule-attr.task-type  = p-task-type
      520             buf_schedule-attr.task-num   = p-task-num
      521             buf_schedule-attr.attr-code  = p-code
      522             buf_schedule-attr.attr-value = p-value
      523           .
      524       end.
      525       else do:
      526           assign
      527               buf_schedule-attr.attr-value = p-value
      528           .
      529       end.
      530   end.
      531   end procedure.
      532   procedure schedule-attr-delete :
      533   do
      534   on error undo, return error
      535   :
      536   define input  parameter p-cre-db-num  as integer   no-undo.
      537   define input  parameter p-task-type   as character no-undo.
      538   define input  parameter p-task-num    as integer   no-undo.
      539   define input  parameter p-code        as character no-undo.
      540   define output parameter p-deleted     as logical   no-undo.
      541       define buffer buf_schedule-attr for ub.schedule-attr .
      542       define variable v-type              as character                no-undo.
      543       define variable v-format            as character                no-undo.
      544       define variable v-label             as character                no-undo.
      545       define variable v-user-can-edit     as logical                  no-undo.
      546       define variable v-output-display    as logical                  no-undo.
      547       define variable v-other             as character                no-undo.
      548       run schedule-attr-name in this-procedure (
      549             input p-code
      550           , output v-type
      551           , output v-format
      552           , output v-label
      553           , output v-user-can-edit
      554           , output v-output-display
      555           , output v-other
      556       ) no-error .
      557       if error-status :error
      558       then do:
      559           undo, return error return-value .
      560       end.
      561       find first buf_schedule-attr exclusive-lock
      562            where buf_schedule-attr.cre-db-num = p-cre-db-num
      563              and buf_schedule-attr.task-type  = p-task-type
      564              and buf_schedule-attr.task-num   = p-task-num
      565              and buf_schedule-attr.attr-code  = p-code
      566       no-error.
      567       if not available buf_schedule-attr
      568       then do:
      569           assign
      570               p-deleted = no
      571           .
      572       end.
      573       else do:
      574           delete buf_schedule-attr.
      575           assign
      576               p-deleted = yes
      577           .
      578       end.
      579   end.
      580   end procedure.
      581   procedure schedule-attr-news :
      582   do
      583   on error undo, return error
      584   :
      585       define input  parameter p-code           as character no-undo .
      586       define output parameter p-news           as logical   no-undo .
      587       if index(p-code, chr(4)) > 0 then do:
      588         p-code = entry(1, p-code, chr(4)).
      589       end.
      590       case p-code :
      591               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      592               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      593               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      594               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      595               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      596               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      597               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      598               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      599               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      600         otherwise do:
      601           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      602         end.
      603       end.
      604   end.
      605   end procedure.
      606   procedure schedule-attr-extract-logical :
      607   do
      608   on error undo, return error
      609   :
      610   define input  parameter p-parameter-number   as integer      no-undo.
      611   define input  parameter p-parameter-list     as character    no-undo.
      612   define output parameter p-parameter-value   as logical      no-undo.
      613       if num-entries( p-parameter-list ) > p-parameter-number - 1
      614       then do:
      615           assign
      616               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      617           .
      618       end.
      619       else do:
      620           assign
      621               p-parameter-value   = no
      622           .
      623       end.
      624   end.
      625   end procedure.
      626   procedure schedule-attr-get-free-id :
      627   do
      628   on error undo, return error return-value
      629   :
      630     define input  parameter p-cre-db-num  as integer   no-undo.
      631     define input  parameter p-task-type   as character no-undo.
      632     define input  parameter p-task-num    as integer   no-undo.
      633     define output parameter p-free-id     as character no-undo.
      634     define buffer buf_schedule-attr for ub.schedule-attr.
      635     find first buf_schedule-attr no-lock
      636         where buf_schedule-attr.cre-db-num = p-cre-db-num
      637           and buf_schedule-attr.task-type  = p-task-type
      638           and buf_schedule-attr.task-num   = p-task-num
      639           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      640     no-error .
      641     if available buf_schedule-attr then
      642     assign
      643     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      644     no-error
      645     .
      646   end.
      647   end procedure.
      648   procedure schedule-attr-get-free-props :
      649     define input parameter p-free-id as character no-undo .
      650     define output parameter p-value as character no-undo .
      651     define buffer buf_temp-schedule-free for temp-schedule-free.
      652     do
      653     on error undo, return error return-value
      654     :
      655       find first buf_temp-schedule-free no-lock no-error .
      656       if not available buf_temp-schedule-free then do:
      657         run schedule-attr-fill-free-props in this-procedure .
      658       end.
      659       find first buf_temp-schedule-free where
      660               buf_temp-schedule-free.free-id = p-free-id no-error.
      661       if available buf_temp-schedule-free then do:
      662         assign
      663         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      664                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      665                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      666                   buf_temp-schedule-free.conf-param           + chr(4) +
      667                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      668                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      669                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      670                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      671                   buf_temp-schedule-free.other-info
      672         .
      673       end.
      674       else do:
      675        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      676                              "id произвольной задачи - &5"
      677                              ,vss-workfile
      678                              ,vss-revision
      679                              ,vss-description
      680                              ,chr(10)
      681                              ,p-free-id).
      682       end.
      683     end.
      684   end procedure.
      685   procedure schedule-attr-is-rum-free-id :
      686   define input parameter p-free-id as character no-undo .
      687   define output parameter p-is-rum as logical no-undo .
      688   define buffer buf_temp-schedule-free for temp-schedule-free.
      689   do
      690   on error undo, return error
      691   :
      692       find first buf_temp-schedule-free no-lock no-error .
      693       if not available buf_temp-schedule-free then do:
      694         run schedule-attr-fill-free-props in this-procedure .
      695       end.
      696       find first buf_temp-schedule-free where
      697               buf_temp-schedule-free.free-id = p-free-id no-error.
      698       if available buf_temp-schedule-free
      699       and buf_temp-schedule-free.is-rum
      700       then do:
      701         p-is-rum = yes.
      702       end.
      703   end.
      704   end procedure.
      705   procedure schedule-attr-fill-free-props :
      706   define variable v-path                    as character                no-undo .
      707   DEFINE VARIABLE v-full-path               as character                no-undo .
      708   DEFINE VARIABLE v-file-name               as character                no-undo .
      709   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      710   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      711   define buffer buf_temp-schedule-free for temp-schedule-free.
      712   define variable v-answer as logical no-undo .
      713     do
      714     on error undo, return error substitute("&1 &2 &3&4&5&4"
      715                                           ,vss-workfile
      716                                           ,vss-revision
      717                                           ,vss-description
      718                                           ,chr(10)
      719                                           ,error-status:get-message(1) )
      720     :
      721       run gbl/filename.p (
      722                       input 'cmp/shd-free.d'
      723                     ,output v-full-path
      724                     ,output v-path
      725                     ,output v-file-name
      726                     ,output v-file-name-no-ext
      727                     ,output v-file-name-ext
      728                     ) .
      729       input from value(v-full-path).
      730       repeat :
      731         create buf_temp-schedule-free.
      732         import buf_temp-schedule-free.
      733       END.
      734       input close.
      735       _ff:
      736       for each buf_temp-schedule-free :
      737         if buf_temp-schedule-free.free-id = '':U then do:
      738            delete buf_temp-schedule-free.
      739            next _ff.
      740          end.
      741          run schedule-attr-check-enc in this-procedure (
      742                                                       input  buf_temp-schedule-free.free-id
      743                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      744                                                               buf_temp-schedule-free.proc-param-edit-name +
      745                                                               buf_temp-schedule-free.conf-param +
      746                                                               string(buf_temp-schedule-free.is-gbd) +
      747                                                               string(buf_temp-schedule-free.is-ubd) +
      748                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      749                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      750                                                               string(buf_temp-schedule-free.other-info)
      751                                                               )
      752                                                       ,input  buf_temp-schedule-free.enc-key
      753                                                       ,output v-answer    ) no-error .
      754          if error-status:error
      755          or not v-answer then delete buf_temp-schedule-free.
      756        end.
      757     end.
      758   end procedure.
      759   Function schedule-attr-reverse returns character (str as character).
      760      define variable rev_incl_s as character init "" no-undo .
      761      define variable rev_incl_i as integer no-undo .
      762      define variable rev_incl_l as integer no-undo .
      763      rev_incl_l = length(str).
      764      do rev_incl_i = 1 to rev_incl_l:
      765         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      766      end.
      767      return rev_incl_s.
      768   end.
      769   procedure schedule-attr-check-enc.
      770     define input  parameter p-free-id   as character no-undo .
      771     define input  parameter p-value     as character no-undo .
      772     define input  parameter p-enc-value as character no-undo .
      773     define output parameter p-answer    as logical   no-undo .
      774     define variable tmp         as character no-undo .
      775     define variable v-enc-value as character no-undo .
      776     assign
      777     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      778     .
      779     run schedule-attr-pswd-enc in this-procedure
      780       ( input tmp
      781        ,output v-enc-value
      782       ) no-error .
      783     if error-status:error then do:
      784       message
      785         vss-workfile vss-revision vss-description skip
      786         "Ошибка при вызове процедуры pswd-enc" skip
      787         return-value skip
      788         error-status :get-message(1) skip
      789         view-as alert-box error .
      790       undo, return error .
      791     end.
      792     if v-enc-value = p-enc-value then do:
      793       assign
      794         p-answer = true
      795       .
      796     end.
      797     else do:
      798       assign
      799         p-answer = false
      800       .
      801     end.
      802   end.
      803   procedure schedule-attr-conf-enc.
      804     define input  parameter p-free-id   as character no-undo .
      805     define input  parameter p-value     as character no-undo .
      806     define output parameter p-enc-value as character no-undo .
      807     define variable tmp         as character no-undo .
      808     assign
      809       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      810     .
      811     run schedule-attr-pswd-enc in this-procedure
      812       ( input tmp
      813        ,output p-enc-value
      814       ) no-error .
      815     if error-status:error then do:
      816       message
      817         vss-workfile vss-revision vss-description skip
      818         "Ошибка при вызове процедуры pswd-enc" skip
      819         return-value skip
      820         error-status :get-message(1) skip
      821         view-as alert-box error .
      822       undo, return error .
      823     end.
      824   end procedure.
      825   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   procedure schedule-attr-pswd-enc :
      827     define input parameter  pswd     as character no-undo .
      828     define output parameter enc-pswd as character no-undo .
      829     do
      830     on error undo, return error return-value
      831     :
      832       assign
      833         enc-pswd = encode(pswd + string(index(pswd, "k")))
      834       .
      835     end.
      836   end procedure.
      837   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   define variable c-point  as character no-undo .
      839   define variable tbl      as character no-undo .
      840   define variable join-tbl as character no-undo .
      841   define variable fld      as character no-undo .
      842   define variable lab      as character no-undo .
      843   define variable spr      as character no-undo .
      844   define variable dim      as character no-undo .
      845   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   procedure fltfield-clear :
      847     define output parameter loc-fld as character no-undo.
      848     define output parameter loc-lab as character no-undo .
      849     define output parameter loc-spr as character no-undo .
      850     define output parameter loc-dim as character no-undo .
      851     assign
      852       loc-fld = ""
      853       loc-lab = ""
      854       loc-spr = ""
      855       loc-dim = "0"
      856     .
      857   end procedure .
      858   procedure fltfield-add :
      859     define input        parameter par-fld as character no-undo.
      860     define input        parameter par-lab as character no-undo .
      861     define input        parameter par-spr as character no-undo .
      862     define input-output parameter loc-fld as character no-undo.
      863     define input-output parameter loc-lab as character no-undo .
      864     define input-output parameter loc-spr as character no-undo .
      865     define input-output parameter loc-dim as character no-undo .
      866     do
      867     on error undo, return error
      868     :
      869       assign
      870       loc-fld = if loc-dim = '0'
      871                 then par-fld
      872                 else (loc-fld + chr(44) + par-fld)
      873       loc-lab = if loc-dim = '0'
      874                 then par-lab
      875                 else (loc-lab + chr(44) + par-lab)
      876       loc-spr = if loc-dim = '0'
      877                 then par-spr
      878                 else (loc-spr + chr(44) + par-spr)
      879       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      880                 string(integer(if num-entries(loc-dim) > 1
      881                               then entry(2, loc-dim)
      882                               else entry(1, loc-dim)
      883                               ) + 1)
      884       no-error
      885       .
      886     end.
      887   end procedure.
      888   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889     define variable v-cntxt-db-num        as integer   no-undo .
      890     define variable v-cntxt-userid        as character no-undo .
      891     define variable v-cntxt-level         as character no-undo .
      892     define variable v-cntxt-host-code-obj as integer   no-undo .
      893     define variable v-cntxt-obj-type      as character no-undo .
      894     define variable v-cntxt-obj-code      as integer   no-undo .
      895     define variable v-cntxt-db-num-obj    as integer   no-undo .
      896     define variable v-cntxt-is-admin      as logical   no-undo .
      897   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   define temp-table userobjs_temp-user-obj no-undo
      899     field obj-type as character
      900     field obj-code as integer
      901     index xpk is primary unique obj-type obj-code
      902     .
      903   procedure userobjs_clear :
      904     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      905     do
      906     on error undo, return error return-value
      907     :
      908       for each buf_userobjs_temp-user-obj
      909       on error undo, return error return-value
      910       :
      911         delete buf_userobjs_temp-user-obj .
      912       end.
      913     end.
      914   end .
      915   procedure userobjs_object-count :
      916     define output parameter p-total-count as integer   no-undo .
      917     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      918     do
      919     on error undo, return error return-value
      920     :
      921       assign
      922         p-total-count = 0
      923       .
      924       for each buf_userobjs_temp-user-obj
      925       on error undo, return error return-value
      926       :
      927         assign
      928           p-total-count = p-total-count + 1
      929         .
      930       end.
      931     end.
      932   end.
      933   procedure userobjs_append :
      934      define input  parameter p-obj-type as character no-undo .
      935      define input  parameter p-obj-code as integer   no-undo .
      936     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      937     do
      938     on error undo, return error return-value
      939     :
      940       find first buf_userobjs_temp-user-obj
      941         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      942           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      943         no-error .
      944       if not available buf_userobjs_temp-user-obj
      945       then do:
      946         create buf_userobjs_temp-user-obj .
      947         assign
      948           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      949           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      950         .
      951       end.
      952     end.
      953   end.
      954   procedure userobjs_object-exist :
      955     define output parameter p-object-exist as logical   no-undo .
      956     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      957     do
      958     on error undo, return error return-value
      959     :
      960       find first buf_userobjs_temp-user-obj
      961         no-error .
      962       if not available buf_userobjs_temp-user-obj
      963       then do:
      964         assign
      965           p-object-exist = false
      966         .
      967       end.
      968       else do:
      969         assign
      970           p-object-exist = true
      971         .
      972       end.
      973     end.
      974   end.
      975   procedure userobjs_transfer :
      976     define input  parameter p-callback-handle as handle no-undo .
      977     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      978     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      979     do
      980     on error undo, return error return-value
      981     :
      982       if valid-handle(p-callback-handle) <> true
      983       then do:
      984         message
      985           vss-workfile vss-revision vss-description skip
      986           "Ошибка задания входных параметров" skip
      987           "Неизвестный указатель на процедуру" skip
      988           view-as alert-box error .
      989         undo, return error return-value .
      990       end.
      991       if p-callback-handle :get-signature("userobjs_append") = ""
      992       then do:
      993         message
      994           vss-workfile vss-revision vss-description skip
      995           "Ошибка задания входных параметров" skip
      996           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      997                     ,p-callback-handle :file-name
      998                     ) skip
      999           view-as alert-box error .
     1000         undo, return error return-value .
     1001       end.
     1002       for each buf_userobjs_temp-user-obj
     1003       on error undo, return error return-value
     1004       :
     1005         run userobjs_append in p-callback-handle
     1006           (input  buf_userobjs_temp-user-obj.obj-type
     1007           ,input  buf_userobjs_temp-user-obj.obj-code
     1008           ) .
     1009       end.
     1010     end.
     1011   end procedure.
     1012   procedure userobjs_select-one :
     1013      define input  parameter parparentproc     as widget-handle no-undo .
     1014      define input  parameter p-db-num          as integer   no-undo .
     1015      define input  parameter p-user-id         as character no-undo .
     1016      define input  parameter p-host-code-obj   as integer   no-undo .
     1017      define input  parameter p-obj-type        as character no-undo .
     1018      define input  parameter p-obj-code        as integer   no-undo .
     1019      define output parameter p-user-select     as logical   no-undo .
     1020      define output parameter p-select-obj-type as character no-undo .
     1021      define output parameter p-select-obj-code as character no-undo .
     1022     do
     1023     on error undo, return error return-value
     1024     :
     1025       run gbl/userobjs.w
     1026         (input  parparentproc
     1027         ,input  this-procedure :handle
     1028         ,input  p-db-num
     1029         ,input  p-user-id
     1030         ,input  p-host-code-obj
     1031         ,input  p-obj-type
     1032         ,input  p-obj-code
     1033         ,INPUT  "b-sel"
     1034         ,output p-user-select
     1035         ,output p-select-obj-type
     1036         ,output p-select-obj-code
     1037         ) .
     1038     end.
     1039   end.
     1040   procedure userobjs_select-many :
     1041     define input  parameter parparentproc   as widget-handle no-undo .
     1042     define input  parameter p-db-num        as integer   no-undo .
     1043     define input  parameter p-user-id       as character no-undo .
     1044     define input  parameter p-host-code-obj as integer   no-undo .
     1045     define input  parameter p-obj-type      as character no-undo .
     1046     define input  parameter p-obj-code      as integer   no-undo .
     1047     define output parameter p-user-select   as logical   no-undo .
     1048     define variable v-select-obj-type as character no-undo .
     1049     define variable v-select-obj-code as integer   no-undo .
     1050     do
     1051     on error undo, return error return-value
     1052     :
     1053       run gbl/userobjs.w
     1054         (input  parparentproc
     1055         ,input  this-procedure :handle
     1056         ,input  p-db-num
     1057         ,input  p-user-id
     1058         ,input  p-host-code-obj
     1059         ,input  p-obj-type
     1060         ,input  p-obj-code
     1061         ,INPUT  "b-sel,b-mark"
     1062         ,output p-user-select
     1063         ,output v-select-obj-type
     1064         ,output v-select-obj-code
     1065         ) .
     1066     end.
     1067   end.
     1068   procedure thobjs :
     1069      define input        parameter parparentproc     as widget-handle no-undo .
     1070      define input        parameter i-bttns           as character     no-undo .
     1071      define input        parameter i-list-mode       as character     no-undo.
     1072      define input        parameter i-obj-type        as character     no-undo.
     1073      define input        parameter i-db-num          as integer       no-undo.
     1074      define input        parameter i-host-code       as integer       no-undo.
     1075      define input-output parameter p-rid-list        as character     no-undo .
     1076   run ref/thobjs.p
     1077           ( input parparentproc
     1078            ,input  this-procedure :handle
     1079           , input i-bttns
     1080           , input i-list-mode
     1081           , input i-obj-type
     1082           , input i-db-num
     1083           , input i-host-code
     1084           , input-output p-rid-list ) no-error .
     1085   end.
     1086   define variable v-obj-list              as character    no-undo.
     1087   define variable v-host-code             as integer      no-undo.
     1088   define variable v-host-name             as character    no-undo.
     1089   dEFINE variable v-param-type            as character    no-undo.
     1090   define variable filter-point0 as character no-undo init "Обработка продаж" .
     1091   define variable filter-point as character no-undo init "Обработка продаж" .
     1092   DEFINE VARIABLE kl AS INTEGER INITIAL 0.
     1093   define variable MethodReturn AS LOGICAL.
     1094   define variable id as recid no-undo .
     1095   define variable IDENT AS RECID no-undo .
     1096   define temp-table temp_obj-list no-undo
     1097       field obj-type as character
     1098       field obj-code as integer
     1099       index pi is primary unique obj-type obj-code
     1100   .
     1101   DEFINE TEMP-TABLE temp-inkas NO-UNDO
     1102       FIELD inkas-code LIKE ub.inkas.inkas-code
     1103       FIELD shift-date LIKE ub.inkas.shift-date
     1104       FIELD shift-num  LIKE ub.inkas.shift-num
     1105       FIELD num-flt    AS INTEGER
     1106       INDEX pi IS PRIMARY UNIQUE inkas-code
     1107   .
     1108   FUNCTION octal-to-char RETURNS CHARACTER
     1109   ( p-string as character )  FORWARD.
     1110   DEFINE BUTTON b-help
     1111        LABEL "Помо&щь"
     1112        SIZE 10 BY 1.
     1113   DEFINE BUTTON bt-sel-obj
     1114        IMAGE-UP FILE "btn-down-arrow":U
     1115        IMAGE-DOWN FILE "btn-down-arrow":U
     1116        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1117        LABEL "..."
     1118        SIZE 3.63 BY 1.04.
     1119   DEFINE BUTTON btn-add
     1120        LABEL "&Добавить":L
     1121        SIZE 10 BY 1 TOOLTIP "Добавить новый фильтр".
     1122   DEFINE BUTTON btn-del
     1123        LABEL "&Удалить":L
     1124        SIZE 10 BY 1 TOOLTIP "Удалить ранее существующий фильтр".
     1125   DEFINE BUTTON btn-update
     1126        LABEL "&Фильтр по чекам":L
     1127        SIZE 20 BY 1 TOOLTIP "Изменить установки фильтра по чекам".
     1128   DEFINE BUTTON btn-update-main
     1129        LABEL "&Изменить":L
     1130        SIZE 10 BY 1 TOOLTIP "Изменить установки шаблона".
     1131   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1132        LABEL "&Отмена"
     1133        SIZE 10 BY 1
     1134        BGCOLOR 8 .
     1135   DEFINE BUTTON Btn_OK DEFAULT
     1136        LABEL "&Ввод"
     1137        SIZE 10 BY 1
     1138        BGCOLOR 8 .
     1139   DEFINE VARIABLE ED-FILTER AS CHARACTER
     1140        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1141        SIZE 39 BY 3.83 NO-UNDO.
     1142   DEFINE VARIABLE ed-object AS CHARACTER
     1143        VIEW-AS EDITOR NO-BOX
     1144        SIZE 40.75 BY 3.38
     1145        FGCOLOR 1  NO-UNDO.
     1146   DEFINE VARIABLE F-shift-date AS CHARACTER FORMAT "X(20)":U
     1147        LABEL "Дата смены(учета)"
     1148        VIEW-AS FILL-IN
     1149        SIZE 21 BY 1
     1150        FGCOLOR 4  NO-UNDO.
     1151   DEFINE VARIABLE F-shift-name AS CHARACTER FORMAT "X(2)":U
     1152        LABEL "№ смены (может игнор.)"
     1153        VIEW-AS FILL-IN
     1154        SIZE 3 BY 1
     1155        FGCOLOR 4  NO-UNDO.
     1156   DEFINE VARIABLE F-shift-num AS CHARACTER FORMAT "X(2)":U
     1157        LABEL "Порядок смен(может игнор.)"
     1158        VIEW-AS FILL-IN
     1159        SIZE 3 BY 1
     1160        FGCOLOR 4  NO-UNDO.
     1161   DEFINE VARIABLE rs-1 AS INTEGER
     1162        VIEW-AS RADIO-SET VERTICAL
     1163        RADIO-BUTTONS
     1164             "все объекты БД", 1,
     1165   "все объекты БД по фирме", 2,
     1166   "объекты выборочно", 3
     1167        SIZE 28 BY 3.25 NO-UNDO.
     1168   DEFINE VARIABLE rs-end AS INTEGER
     1169        VIEW-AS RADIO-SET VERTICAL
     1170        RADIO-BUTTONS
     1171             "0", 0,
     1172   "100", 100,
     1173   "200", 200,
     1174   "300", 300,
     1175   "400", 400
     1176        SIZE 38 BY 5.5 NO-UNDO.
     1177   DEFINE VARIABLE rs-start AS INTEGER
     1178        VIEW-AS RADIO-SET VERTICAL
     1179        RADIO-BUTTONS
     1180             "0", 0,
     1181   "100", 100,
     1182   "200", 200,
     1183   "300", 300,
     1184   "400", 400
     1185        SIZE 38 BY 5.5 NO-UNDO.
     1186   DEFINE RECTANGLE rct-obj
     1187        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1188        SIZE 79 BY 4.25.
     1189   DEFINE RECTANGLE RECT-6
     1190        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1191        SIZE 97 BY 7.
     1192   DEFINE VARIABLE T-finalize-100 AS LOGICAL INITIAL no
     1193        LABEL ""
     1194        VIEW-AS TOGGLE-BOX
     1195        SIZE 3 BY .75 NO-UNDO.
     1196   DEFINE VARIABLE T-finalize-200 AS LOGICAL INITIAL no
     1197        LABEL ""
     1198        VIEW-AS TOGGLE-BOX
     1199        SIZE 3 BY .75 NO-UNDO.
     1200   DEFINE QUERY br-template FOR
     1201         temp-schedule-attr SCROLLING.
     1202   DEFINE BROWSE br-template
     1203     QUERY br-template NO-LOCK DISPLAY
     1204         entry(2, temp-schedule-attr.attr-code, chr(4)) COLUMN-LABEL "№" FORMAT "X(2)":U
     1205         entry(3, temp-schedule-attr.attr-value, chr(4)) COLUMN-LABEL "Название шаблона" FORMAT "X(50)":U
     1206       WITH NO-ROW-MARKERS SEPARATORS SIZE 56 BY 6.25
     1207            TITLE "Список шаблонов" ROW-HEIGHT-CHARS .67.
     1208   DEFINE FRAME Dialog-Frame
     1209        Btn_OK AT ROW 1 COL 1
     1210        Btn_Cancel AT ROW 1 COL 11
     1211        b-help AT ROW 1 COL 71
     1212        rs-1 AT ROW 3 COL 3.5 NO-LABEL
     1213        ed-object AT ROW 3 COL 38 NO-LABEL
     1214        bt-sel-obj AT ROW 5.25 COL 33
     1215        rs-start AT ROW 7.75 COL 3 NO-LABEL
     1216        rs-end AT ROW 7.75 COL 42 NO-LABEL
     1217        T-finalize-100 AT ROW 9.25 COL 81.5
     1218        T-finalize-200 AT ROW 10.25 COL 81.5
     1219        F-shift-date AT ROW 13.25 COL 75.5 COLON-ALIGNED
     1220        btn-add AT ROW 13.75 COL 2
     1221        btn-del AT ROW 13.75 COL 12
     1222        btn-update-main AT ROW 13.75 COL 22
     1223        btn-update AT ROW 13.75 COL 32
     1224        F-shift-name AT ROW 14.5 COL 89 COLON-ALIGNED
     1225        br-template AT ROW 15 COL 1.5
     1226        F-shift-num AT ROW 15.5 COL 89 COLON-ALIGNED
     1227        ED-FILTER AT ROW 17.5 COL 59 NO-LABEL
     1228        "Начальная стадия обработки" VIEW-AS TEXT
     1229             SIZE 37 BY 1 AT ROW 6.75 COL 3
     1230             FGCOLOR 4
     1231        "Дополнительный фильтр по чекам" VIEW-AS TEXT
     1232             SIZE 39 BY .67 AT ROW 16.75 COL 59
     1233             BGCOLOR 1 FGCOLOR 15
     1234        "Пометить как заверш." VIEW-AS TEXT
     1235             SIZE 20.5 BY 1 AT ROW 6.75 COL 78.5
     1236             FGCOLOR 4
     1237        "Конечная стадия обработки" VIEW-AS TEXT
     1238             SIZE 33 BY 1 AT ROW 6.75 COL 41.5
     1239             FGCOLOR 4
     1240        rct-obj AT ROW 2.25 COL 2
     1241        RECT-6 AT ROW 6.5 COL 2
     1242        SPACE(0.00) SKIP(7.83)
     1243       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1244            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1245            TITLE "Параметры обработки документов продаж по расписанию"
     1246            CANCEL-BUTTON Btn_Cancel.
     1247   ASSIGN
     1248          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1249          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1250   ASSIGN
     1251          ED-FILTER:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1252   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1253   DO:
     1254     APPLY "END-ERROR":U TO SELF.
     1255   END.
     1256   ON VALUE-CHANGED OF br-template IN FRAME Dialog-Frame
     1257   DO:
     1258     assign
     1259     f-shift-DATE:screen-value = ""
     1260     f-shift-num:screen-value = ""
     1261     f-shift-name:screen-value = ""
     1262     ED-FILTER:screen-value = ""
     1263     .
     1264     IF AVAILABLE(temp-schedule-attr) THEN DO:
     1265       RUN proc-value-changed IN THIS-PROCEDURE NO-ERROR.
     1266     END.
     1267   END.
     1268   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     1269   DO:
     1270       define variable v-exclude-obj-list     as character     no-undo.
     1271       assign
     1272           rs-1 :screen-value  = "3"
     1273       .
     1274   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   run userobjs_clear in this-procedure  .
     1276       for each temp_obj-list:
     1277   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   run userobjs_append in this-procedure
     1279     (input  temp_obj-list.obj-type
     1280     ,input  temp_obj-list.obj-code
     1281     )  .
     1282       end.
     1283       define variable v-user-select as logical   no-undo .
     1284   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285   run userobjs_select-many in this-procedure
     1286     (input  parparentproc
     1287     ,input  v-cntxt-db-num
     1288     ,input  v-cntxt-userid
     1289     ,input  v-cntxt-host-code-obj
     1290     ,input  v-cntxt-obj-type
     1291     ,input  v-cntxt-obj-code
     1292     ,output v-user-select
     1293     )  .
     1294       if v-user-select <> true
     1295       then do:
     1296         message
     1297           "Объект не выбран"
     1298           view-as alert-box information .
     1299         return NO-APPLY .
     1300       end.
     1301       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1302       define variable v-skip-store as integer   no-undo .
     1303       assign
     1304         v-skip-store = 0
     1305       .
     1306       for each temp_obj-list :
     1307         delete temp_obj-list.
     1308       end.
     1309       for each buf_userobjs_temp-user-obj
     1310       on error undo, return no-apply
     1311       :
     1312         if buf_userobjs_temp-user-obj.obj-type = 'скл':U
     1313         then do:
     1314           assign
     1315             v-skip-store = v-skip-store + 1
     1316           .
     1317         end.
     1318         find first temp_obj-list no-lock where
     1319                   temp_obj-list.obj-type  = buf_userobjs_temp-user-obj.obj-type
     1320               and temp_obj-list.obj-code  = buf_userobjs_temp-user-obj.obj-code no-error .
     1321         if not available temp_obj-list then do:
     1322           create temp_obj-list.
     1323           assign
     1324             temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1325             temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     1326           .
     1327           release temp_obj-list.
     1328         end.
     1329       end.
     1330       if v-skip-store <> 0
     1331       then do:
     1332         message
     1333           substitute("Среди выбранных были объекты типа &1", 'скл':U) skip
     1334           "Они были исключены из списка" skip
     1335           substitute("Всего было исключено &1 объектов", v-skip-store) skip
     1336           view-as alert-box information .
     1337       end.
     1338       run select-objects-only-this-db in this-procedure
     1339         (output v-obj-list
     1340         ,output v-exclude-obj-list
     1341         ).
     1342       if v-exclude-obj-list <> ""
     1343       then do:
     1344           message
     1345               "Из списка выбранных объектов исключены"
     1346               skip "объекты, не принадлежащие БД, указанной в расписании:"
     1347               skip(1)
     1348               skip v-exclude-obj-list
     1349           view-as alert-box information.
     1350       end.
     1351       assign
     1352           ed-object :screen-value = v-obj-list
     1353       .
     1354   END.
     1355   ON CHOOSE OF btn-add IN FRAME Dialog-Frame
     1356   DO:
     1357     define buffer buf_temp-schedule-attr for temp-schedule-attr.
     1358     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1359     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1360     APPLY "VALUE-CHANGED" TO br-template.
     1361     apply "entry" to br-template.
     1362     APPLY "CHOOSE" TO btn-update-main.
     1363   END.
     1364   ON CHOOSE OF btn-del IN FRAME Dialog-Frame
     1365   do:
     1366   IF NOT available temp-schedule-attr THEN RETURN NO-APPLY.
     1367   RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1368   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1369   END.
     1370   ON CHOOSE OF btn-update IN FRAME Dialog-Frame
     1371   DO:
     1372    IF NOT AVAILABLE temp-schedule-attr THEN RETURN NO-APPLY.
     1373    RUN proc-filter IN THIS-PROCEDURE NO-ERROR.
     1374    IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1375   END.
     1376   ON CHOOSE OF btn-update-main IN FRAME Dialog-Frame
     1377   DO:
     1378   DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     1379   define variable v-str as character no-undo .
     1380   define variable v-str-rus as character no-undo .
     1381   define variable v-str-int as character no-undo .
     1382   define variable v-str-rus-int as character no-undo .
     1383   define variable v-str-int-shift-name as character no-undo .
     1384   define variable v-str-rus-int-shift-name as character no-undo .
     1385   define variable v-flt-rec as recid no-undo .
     1386   IF NOT AVAILABLE temp-schedule-attr THEN RETURN NO-APPLY.
     1387   ASSIGN
     1388   v-flt-rec = recid(temp-schedule-attr)
     1389   v-name = ENTRY(3, temp-schedule-attr.attr-VALUE, chr(4))
     1390   v-str = entry(1, ENTRY(1, temp-schedule-attr.attr-VALUE, chr(4)))
     1391   v-str-rus = entry(1, ENTRY(2, temp-schedule-attr.attr-VALUE, chr(4)))
     1392   v-str-int = entry(2, ENTRY(1, temp-schedule-attr.attr-VALUE, chr(4)))
     1393   v-str-rus-int = entry(2, ENTRY(2, temp-schedule-attr.attr-VALUE, chr(4)))
     1394   .
     1395   if num-entries(ENTRY(1, temp-schedule-attr.attr-VALUE, chr(4))) > 2 then
     1396   assign
     1397   v-str-int-shift-name = entry(3, ENTRY(1, temp-schedule-attr.attr-VALUE, chr(4)))
     1398   v-str-rus-int-shift-name = entry(3, ENTRY(2, temp-schedule-attr.attr-VALUE, chr(4)))
     1399   .
     1400     run str/asltmpl0.w ( parparentproc
     1401                    ,INPUT-OUTPUT v-name
     1402                    ,INPUT-OUTPUT v-str
     1403                    ,INPUT-OUTPUT v-str-rus
     1404                    ,INPUT-OUTPUT v-str-int
     1405                    ,INPUT-OUTPUT v-str-rus-int
     1406                    ,INPUT-OUTPUT v-str-rus-int-shift-name
     1407                    ,INPUT-OUTPUT v-str-rus-int-shift-name
     1408                    ) No-error.
     1409     IF NOT ERROR-STATUS:error
     1410     and v-name > ''
     1411     THEN DO:
     1412      RUN temp-schedule-attr-write  IN THIS-PROCEDURE(
     1413                                                input p-cre-db-num
     1414                                               ,input p-task-type
     1415                                               ,input p-task-num
     1416                                               ,input temp-schedule-attr.attr-code
     1417                                               ,input (v-str + chr(44) +
     1418                                                       v-str-int + chr(44) +
     1419                                                       v-str-int-shift-name +
     1420                                                       chr(4) +
     1421                                                      v-str-rus + chr(44) +
     1422                                                      v-str-rus-int + chr(44) +
     1423                                                      v-str-rus-int-shift-name +
     1424                                                       chr(4) + v-name)).
     1425        OPEN QUERY br-template FOR EACH temp-schedule-attr       WHERE temp-schedule-attr.cre-db-num = p-cre-db-num  AND temp-schedule-attr.task-type = p-task-type  AND temp-schedule-attr.task-num = p-task-num  AND temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4)) NO-LOCK.
     1426         reposition br-template to recid v-flt-rec no-error.
     1427        APPLY "VALUE-CHANGED" TO br-template.
     1428        apply "entry" to br-template.
     1429    END.
     1430    if v-name = '' then do:
     1431      apply "CHOOSE" to btn-del.
     1432    end.
     1433   END.
     1434   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1435   DO:
     1436       assign
     1437           p-cancel = yes
     1438       .
     1439   END.
     1440   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1441   DO:
     1442       define variable v-obj-list as character     no-undo.
     1443       define variable v-deleted as logical     no-undo.
     1444       DEFINE BUFFER buf_schedule-attr FOR ub.schedule-attr.
     1445       DEFINE BUFFER buf_temp-schedule-attr FOR temp-schedule-attr.
     1446       ASSIGN
     1447           rs-1
     1448           rs-start
     1449           rs-end
     1450           t-finalize-100
     1451           t-finalize-200
     1452       .
     1453       case rs-1
     1454       :
     1455       when 1
     1456       then do:
     1457           assign
     1458               v-obj-list = ""
     1459           .
     1460       end.
     1461       when 2
     1462       then do:
     1463           assign
     1464               v-obj-list = ""
     1465           .
     1466       end.
     1467       when 3
     1468       then do:
     1469           assign
     1470               v-obj-list = ""
     1471           .
     1472           for each temp_obj-list
     1473           :
     1474               assign
     1475                   v-obj-list = v-obj-list
     1476                           + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     1477                           + "," + string( temp_obj-list.obj-code )
     1478               .
     1479           end.
     1480       end.
     1481       end case.
     1482       find first temp_obj-list no-error.
     1483       if not available temp_obj-list
     1484       and rs-1 = 3
     1485       then do:
     1486           message
     1487               "Не выбраны объекты для обработкаи документов продаж."
     1488           view-as alert-box warning.
     1489           undo, return no-apply.
     1490       end.
     1491       run attach-attr-to-schedule-line in this-procedure (
     1492             input rs-1
     1493           , input v-obj-list
     1494           , INPUT rs-start
     1495           , INPUT rs-end
     1496           , INPUT t-finalize-100
     1497           , INPUT t-finalize-200
     1498       ).
     1499        if rs-start = 0 then do:
     1500         find first buf_temp-schedule-attr NO-LOCK WHERE
     1501                   buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     1502                AND buf_temp-schedule-attr.task-type = p-task-type
     1503                AND buf_temp-schedule-attr.task-num = p-task-num
     1504                AND buf_temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4))  no-error.
     1505           if not available buf_temp-schedule-attr then do:
     1506             message
     1507             "Не определено ни одного шаблона для создания документов продаж" skip
     1508             "Расписание не может быть сохранено"
     1509             view-as alert-box .
     1510             return no-apply.
     1511           end.
     1512           RUN save-table IN THIS-PROCEDURE.
     1513         end.
     1514         else DO:
     1515          RUN save-table IN THIS-PROCEDURE.
     1516       END.
     1517       APPLY "GO" TO FRAME Dialog-Frame.
     1518   END.
     1519   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
     1520   DO:
     1521       assign
     1522           rs-1
     1523       .
     1524       run object-select in this-procedure (
     1525           input rs-1
     1526       ) .
     1527   END.
     1528   ON VALUE-CHANGED OF rs-end IN FRAME Dialog-Frame
     1529   DO:
     1530     DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1531     DEFINE VARIABLE v-label AS character NO-UNDO.
     1532     DEFINE VARIABLE v-value AS integer NO-UNDO.
     1533     ASSIGN
     1534     rs-end.
     1535     IF NOT (rs-start <= 100 AND rs-end >= 100) THEN DO:
     1536      ASSIGN
     1537      t-finalize-100 = NO
     1538      .
     1539      DISPLAY
     1540      t-finalize-100
     1541      WITH FRAME Dialog-Frame.
     1542      DISPLAY
     1543      t-finalize-100
     1544      WITH FRAME Dialog-Frame.
     1545     END.
     1546     IF NOT (rs-start <= 200 AND rs-end >= 200) THEN DO:
     1547      ASSIGN
     1548      t-finalize-200 = NO
     1549      .
     1550      DISPLAY
     1551      t-finalize-200
     1552      WITH FRAME Dialog-Frame.
     1553      DISPLAY
     1554      t-finalize-200
     1555      WITH FRAME Dialog-Frame.
     1556     END.
     1557   _ii:
     1558   DO ii = 1 TO NUM-ENTRIES("0,100,200,300,400"):
     1559      ASSIGN
     1560      v-label = trim(ENTRY(ii, "Создавать продажи по шаблонам,                            Закачивать чеки в продажу,                            Резервировать товары продажи,                            Закрывать документ продажи на факт,                            Удалять пустые (без чеков) продажи"))
     1561      v-value = integer(ENTRY(ii, "0,100,200,300,400"))
     1562      .
     1563      IF v-value < rs-start THEN DO:
     1564         NEXT _ii.
     1565      END.
     1566      IF v-value > rs-end THEN DO:
     1567          leave _ii.
     1568      END.
     1569      IF v-value >= rs-start
     1570      AND v-value <= rs-end  THEN DO:
     1571          CASE v-value:
     1572              WHEN 100 THEN DO:
     1573                  ENABLE
     1574                  t-finalize-100
     1575                  WITH FRAME Dialog-Frame.
     1576              END.
     1577                 WHEN 200 THEN DO:
     1578                  ENABLE
     1579                  t-finalize-200
     1580                  WITH FRAME Dialog-Frame.
     1581              END.
     1582          END CASE.
     1583      END.
     1584   END.
     1585   END.
     1586   ON VALUE-CHANGED OF rs-start IN FRAME Dialog-Frame
     1587   DO:
     1588     ASSIGN
     1589     rs-start.
     1590     RUN proc-start IN THIS-PROCEDURE (rs-start) NO-ERROR.
     1591     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1592   END.
     1593   ON VALUE-CHANGED OF T-finalize-100 IN FRAME Dialog-Frame
     1594   DO:
     1595     ASSIGN
     1596     t-finalize-100.
     1597   END.
     1598   ON VALUE-CHANGED OF T-finalize-200 IN FRAME Dialog-Frame
     1599   DO:
     1600       ASSIGN
     1601     t-finalize-200.
     1602   END.
     1603   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1604   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1605   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   on help of frame Dialog-Frame
     1607   do:
     1608     run gbl/app_help.p
     1609       (input this-procedure :file-name
     1610       ,input ''
     1611       ,input ?
     1612       ) no-error.
     1613     if error-status :error then do:
     1614       message
     1615         "Ошибка при вызове помощи"
     1616         error-status :get-message(1)
     1617         view-as alert-box .
     1618     end.
     1619   end.
     1620   run minbtn-set in this-procedure .
     1621   on choose of b-help in frame Dialog-Frame
     1622   do:
     1623     apply "help":u to frame Dialog-Frame .
     1624   end.
     1625   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   procedure minbtn-set :
     1627       do
     1628           on error undo, return error return-value
     1629           :
     1630           define variable ii              as integer       no-undo .
     1631           define variable fh              as widget-handle no-undo .
     1632           define variable hh              as widget-handle no-undo .
     1633           define variable v-h             as handle        extent 4 no-undo .
     1634           define variable v-name-button   as character     no-undo .
     1635           define variable v-help-old-x    as decimal       no-undo .
     1636           define variable v-help-old-y    as decimal       no-undo .
     1637           define variable v-help-old-size as decimal       no-undo .
     1638           define variable v-frame-width   as decimal       no-undo .
     1639           define variable jj              as integer       no-undo .
     1640           do
     1641               on error undo, return error
     1642               :
     1643               assign
     1644                   v-frame-width = frame Dialog-Frame:width - 0.3
     1645                   fh            = frame Dialog-Frame:first-child
     1646                   hh            = fh:first-child
     1647                   ii            = 1
     1648                   .
     1649               do while valid-handle(hh):
     1650                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1651                   do:
     1652                       case lc(hh:name) :
     1653                           when "b-help" then
     1654                               do:
     1655                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1656                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1657                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1658                                   hh:TOOLTIP = "Помощь" .
     1659                                   v-help-old-x = hh:column .
     1660                                   v-help-old-y = hh:row    .
     1661                                   v-help-old-size = hh:width .
     1662                                   hh:width-chars = 2.5 .
     1663                               end.
     1664                           when "b-print" then
     1665                               do:
     1666                                   hh:load-image("cmp/b-print.bmp":u) .
     1667                                   hh:TOOLTIP = "Печать" .
     1668                                   v-h[ii] = hh:handle .
     1669                                   ii = ii + 1 .
     1670                                   hh:width-chars = 3 .
     1671                               end.
     1672                           when "b-history" or
     1673                           when "b-hist" then
     1674                               do:
     1675                                   hh:load-image("cmp/b-hist.bmp":u) .
     1676                                   hh:TOOLTIP = "История" .
     1677                                   v-h[ii] = hh:handle .
     1678                                   ii = ii + 1 .
     1679                                   hh:width-chars = 3 .
     1680                               end.
     1681                           when "b-sch" then
     1682                               do:
     1683                                   hh:load-image("cmp/b-sch.bmp":u) .
     1684                                   hh:TOOLTIP = "Установка Фильтра" .
     1685                                   v-h[ii] = hh:handle .
     1686                                   ii = ii + 1 .
     1687                                   hh:width-chars = 3 .
     1688                               end.
     1689                           when "b-hist-user" then
     1690                               do:
     1691                                   hh:load-image("cmp/b-hist.bmp":u) .
     1692                                   hh:TOOLTIP = "История пользователя" .
     1693                                   ii = ii + 1 .
     1694                               end.
     1695                       end case.
     1696                   end.
     1697                   hh = hh:next-sibling.
     1698               end.
     1699               b-help:column = v-frame-width - b-help:width-chars.
     1700               jj = 0.
     1701               repeat ii = 4 to 1 by -1 :
     1702                   if valid-handle (v-h[ii] ) then
     1703                   do:
     1704                       jj  = jj + 1 .
     1705                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1706                       v-h[ii]:row    = v-help-old-y .
     1707                   end.
     1708               end.
     1709           end.
     1710       end.
     1711   end procedure.
     1712   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1713   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1714   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1715   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1716   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1717   define variable v-diasize-current-frame-height as decimal   no-undo .
     1718   define variable v-diasize-change-size          as logical   no-undo .
     1719   define variable v-diasize-resize-button        as handle    no-undo .
     1720   define variable v-diasize-wndmax               as logical   no-undo .
     1721   define variable v-diasize-wndstore             as logical   no-undo .
     1722   define variable v-diasize-proc-name            as character no-undo .
     1723   define variable v-diasize-browse-handle        as handle    no-undo .
     1724   define variable v-diasize-browse-number        as integer   no-undo .
     1725   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1726   define temp-table temp-diasize-handle no-undo
     1727     field handle-value  as handle
     1728     field save-position as decimal
     1729     index xpk is primary unique handle-value
     1730     .
     1731   define temp-table temp-browse-handle no-undo
     1732     field browse-type   as character
     1733     field browse-number as integer
     1734     field browse-handle as handle
     1735     field original-size as decimal
     1736     index xpk is primary unique browse-type browse-number
     1737     index xie browse-type browse-handle
     1738   .
     1739   procedure diasize_change-height :
     1740     define input  parameter p-change-value  as decimal   no-undo .
     1741     define input  parameter p-move-resize   as logical   no-undo .
     1742     define variable v-field-group-handle    as handle    no-undo .
     1743     define variable v-object-handle         as handle    no-undo .
     1744     define variable v-frame-height          as decimal   no-undo .
     1745     define variable v-frame-virtual-height  as decimal   no-undo .
     1746     define variable v-browse-height         as decimal   no-undo .
     1747     define variable v-window-height         as decimal   no-undo .
     1748     define variable v-window-virtual-height as decimal   no-undo .
     1749     define variable v-change-sign           as integer   no-undo .
     1750     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1751     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1752     if p-change-value > 0
     1753     then do:
     1754       if frame Dialog-Frame :height + p-change-value
     1755           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1756       then do:
     1757         assign
     1758           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1759                           - (frame Dialog-Frame :height-chars)
     1760         .
     1761         if p-change-value <= 0
     1762         then do:
     1763           run diasize_position-resize-button in this-procedure .
     1764           return .
     1765         end.
     1766       end.
     1767     end.
     1768     if p-change-value < 0
     1769     then do:
     1770       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1771       then do:
     1772         assign
     1773           p-change-value = v-diasize-orig-frame-height
     1774                          - (frame Dialog-Frame :height-chars)
     1775         .
     1776         if p-change-value >= 0
     1777         then do:
     1778           run diasize_position-resize-button in this-procedure .
     1779           return .
     1780         end.
     1781       end.
     1782     end.
     1783     if p-change-value >= 0
     1784     then do:
     1785       assign
     1786         v-change-sign = 1
     1787       .
     1788     end.
     1789     else do:
     1790       assign
     1791         v-change-sign = -1
     1792       .
     1793     end.
     1794     assign
     1795       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1796     .
     1797     if p-change-value = 0
     1798     then do:
     1799       run diasize_position-resize-button in this-procedure .
     1800       return .
     1801     end.
     1802     move_block:
     1803     do
     1804     on error undo move_block, retry move_block
     1805     :
     1806       if retry
     1807       then do:
     1808         do
     1809         on error undo move_block, leave move_block
     1810         :
     1811           if p-change-value > 0
     1812           then do:
     1813             for each buf_temp-diasize-handle
     1814             on error undo, next
     1815             :
     1816               assign
     1817                 v-object-handle = buf_temp-diasize-handle.handle-value
     1818               .
     1819               if v-object-handle <> v-diasize-resize-button
     1820               then do:
     1821                 assign
     1822                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1823                 .
     1824               end.
     1825             end.
     1826             assign
     1827               v-diasize-browse-handle :height = v-browse-height
     1828             .
     1829             for each buf_temp-browse-handle
     1830               where buf_temp-browse-handle.browse-type = 'height':u
     1831             on error undo, next
     1832             :
     1833               assign
     1834                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1835               .
     1836             end.
     1837             assign
     1838               frame Dialog-Frame :height = v-frame-height
     1839             .
     1840             if frame Dialog-Frame :scrollable = true
     1841             then do:
     1842               assign
     1843                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1844               .
     1845             end.
     1846             run diasize_position-resize-button in this-procedure .
     1847           end.
     1848           else do:
     1849             if frame Dialog-Frame :scrollable = true
     1850             then do:
     1851               assign
     1852                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1853               .
     1854             end.
     1855             assign
     1856               frame Dialog-Frame :height = v-frame-height
     1857             .
     1858             assign
     1859               v-diasize-browse-handle :height = v-browse-height
     1860             .
     1861             for each buf_temp-browse-handle
     1862               where buf_temp-browse-handle.browse-type = 'height':u
     1863             on error undo, next
     1864             :
     1865               assign
     1866                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1867               .
     1868             end.
     1869             for each buf_temp-diasize-handle
     1870             on error undo, next
     1871             :
     1872               assign
     1873                 v-object-handle = buf_temp-diasize-handle.handle-value
     1874               .
     1875               if v-object-handle <> v-diasize-resize-button
     1876               then do:
     1877                 assign
     1878                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1879                 .
     1880               end.
     1881             end.
     1882             run diasize_position-resize-button in this-procedure .
     1883           end.
     1884           assign
     1885             v-diasize-change-size = false
     1886           .
     1887           leave move_block .
     1888         end.
     1889       end.
     1890       assign
     1891         v-diasize-need-full-display = true
     1892       .
     1893       if v-diasize-change-size = false
     1894       then do:
     1895         assign
     1896           v-diasize-change-size = true
     1897         .
     1898       end.
     1899       else do:
     1900         return .
     1901       end.
     1902       assign
     1903         v-frame-height = frame Dialog-Frame :height
     1904         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1905         v-browse-height = v-diasize-browse-handle :height
     1906       .
     1907       for each buf_temp-browse-handle
     1908         where buf_temp-browse-handle.browse-type = 'height':u
     1909       :
     1910         assign
     1911           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1912         .
     1913       end.
     1914       for each buf_temp-diasize-handle
     1915       :
     1916         delete buf_temp-diasize-handle .
     1917       end.
     1918       assign
     1919         v-field-group-handle = frame Dialog-Frame :first-child
     1920       .
     1921       do while valid-handle(v-field-group-handle)
     1922       :
     1923         assign
     1924           v-object-handle = v-field-group-handle :first-child
     1925         .
     1926         do while valid-handle(v-object-handle)
     1927         :
     1928           if  v-object-handle <> v-diasize-browse-handle :handle
     1929           and can-query(v-object-handle, "row")
     1930           and can-query(v-object-handle, "height")
     1931           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1932           then do:
     1933             find first buf_temp-browse-handle
     1934               where buf_temp-browse-handle.browse-type   = 'height':u
     1935                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1936               no-error .
     1937             if available buf_temp-browse-handle
     1938             then do:
     1939             end.
     1940             else do:
     1941               create buf_temp-diasize-handle .
     1942               assign
     1943                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1944                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1945               .
     1946             end.
     1947           end.
     1948           assign
     1949             v-object-handle = v-object-handle :next-sibling
     1950           .
     1951         end.
     1952         assign
     1953           v-field-group-handle = v-field-group-handle :next-sibling
     1954         .
     1955       end.
     1956       do with frame Dialog-Frame
     1957       :
     1958         hide v-diasize-resize-button .
     1959         assign
     1960           v-diasize-resize-button :row    = 1
     1961           v-diasize-resize-button :column = 1
     1962         .
     1963       end.
     1964       if p-change-value > 0
     1965       then do:
     1966         if frame Dialog-Frame :scrollable = true
     1967         then do:
     1968           assign
     1969             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1970             no-error .
     1971           if error-status :error
     1972           or error-status :get-message(1) <> ""
     1973           then do:
     1974             undo move_block, retry move_block .
     1975           end.
     1976         end.
     1977         assign
     1978           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1979           no-error .
     1980         if error-status :error
     1981         or error-status :get-message(1) <> ""
     1982         then do:
     1983           undo move_block, retry move_block .
     1984         end.
     1985         assign
     1986           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1987           no-error .
     1988         if error-status :error
     1989         or error-status :get-message(1) <> ""
     1990         then do:
     1991           undo move_block, retry move_block .
     1992         end.
     1993         for each buf_temp-browse-handle
     1994           where buf_temp-browse-handle.browse-type = 'height':u
     1995         on error undo move_block, retry move_block
     1996         :
     1997           assign
     1998             buf_temp-browse-handle.browse-handle :height
     1999               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2000             no-error .
     2001           if error-status :error
     2002           or error-status :get-message(1) <> ""
     2003           then do:
     2004             undo move_block, retry move_block .
     2005           end.
     2006         end.
     2007         for each buf_temp-diasize-handle
     2008         on error undo move_block, retry move_block
     2009         :
     2010           assign
     2011             v-object-handle = buf_temp-diasize-handle.handle-value
     2012           .
     2013           if v-object-handle <> v-diasize-resize-button
     2014           then do:
     2015             assign
     2016               v-object-handle :row = v-object-handle :row + p-change-value
     2017               no-error .
     2018             if error-status :error
     2019             or error-status :get-message(1) <> ""
     2020             then do:
     2021               undo move_block, retry move_block .
     2022             end.
     2023           end.
     2024         end.
     2025       end.
     2026       else do:
     2027         for each buf_temp-diasize-handle
     2028         on error undo move_block, retry move_block
     2029         :
     2030           assign
     2031             v-object-handle = buf_temp-diasize-handle.handle-value
     2032           .
     2033           if v-object-handle <> v-diasize-resize-button
     2034           then do:
     2035             assign
     2036               v-object-handle :row = v-object-handle :row + p-change-value
     2037               no-error .
     2038             if error-status :error
     2039             or error-status :get-message(1) <> ""
     2040             then do:
     2041               undo move_block, retry move_block .
     2042             end.
     2043           end.
     2044         end.
     2045         assign
     2046           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2047           no-error .
     2048         if error-status :error
     2049         or error-status :get-message(1) <> ""
     2050         then do:
     2051           undo move_block, retry move_block .
     2052         end.
     2053         for each buf_temp-browse-handle
     2054           where buf_temp-browse-handle.browse-type = 'height':u
     2055         on error undo move_block, retry move_block
     2056         :
     2057           assign
     2058             buf_temp-browse-handle.browse-handle :height
     2059               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2060             no-error .
     2061           if error-status :error
     2062           or error-status :get-message(1) <> ""
     2063           then do:
     2064             undo move_block, retry move_block .
     2065           end.
     2066         end.
     2067         assign
     2068           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2069           no-error .
     2070         if error-status :error
     2071         or error-status :get-message(1) <> ""
     2072         then do:
     2073           undo move_block, retry move_block .
     2074         end.
     2075         if frame Dialog-Frame :scrollable = true
     2076         then do:
     2077           assign
     2078             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2079             no-error .
     2080           if error-status :error
     2081           or error-status :get-message(1) <> ""
     2082           then do:
     2083             undo move_block, retry move_block .
     2084           end.
     2085         end.
     2086       end.
     2087       if p-move-resize = true
     2088       then do:
     2089         run diasize_position-resize-button in this-procedure .
     2090       end.
     2091       if v-diasize-wndstore = true
     2092       then do:
     2093         if connected("ub") = true
     2094         then do:
     2095           define variable v-cntxt-db-num        as integer   no-undo .
     2096           define variable v-cntxt-userid        as character no-undo .
     2097           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2098                                             , OUTPUT v-cntxt-userid
     2099                                             ) .
     2100           run gbl/wndsizew.p
     2101             (input  v-cntxt-db-num
     2102             ,input  v-cntxt-userid
     2103             ,input  v-diasize-proc-name
     2104             ,input  'height':u
     2105             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2106             ) .
     2107         end.
     2108       end.
     2109     end.
     2110     assign
     2111       v-diasize-change-size = false
     2112     .
     2113   end procedure.
     2114   procedure diasize_set-height :
     2115     define input  parameter p-new-height  as decimal   no-undo .
     2116     define input  parameter p-move-resize as logical   no-undo .
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       run diasize_change-height in this-procedure
     2121         (input  (p-new-height - frame Dialog-Frame :height)
     2122         ,input  p-move-resize
     2123         ) .
     2124     end.
     2125   end procedure.
     2126   procedure diasize_change-width :
     2127     define input  parameter p-change-value as decimal   no-undo .
     2128     define input  parameter p-move-resize  as logical   no-undo .
     2129     define variable v-field-group-handle   as handle    no-undo .
     2130     define variable v-object-handle        as handle    no-undo .
     2131     define variable v-frame-width          as decimal   no-undo .
     2132     define variable v-frame-virtual-width  as decimal   no-undo .
     2133     define variable v-browse-width         as decimal   no-undo .
     2134     define variable v-window-width         as decimal   no-undo .
     2135     define variable v-window-virtual-width as decimal   no-undo .
     2136     define variable v-change-sign          as integer   no-undo .
     2137     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2138     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2139     if p-change-value > 0
     2140     then do:
     2141       if frame Dialog-Frame :width + p-change-value >
     2142           session :width-chars
     2143       then do:
     2144         assign
     2145           p-change-value = session :width-chars - frame Dialog-Frame :width
     2146         .
     2147         if p-change-value <= 0
     2148         then do:
     2149           run diasize_position-resize-button in this-procedure .
     2150           return .
     2151         end.
     2152       end.
     2153     end.
     2154     if p-change-value < 0
     2155     then do:
     2156       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2157       then do:
     2158         assign
     2159           p-change-value = v-diasize-orig-frame-width
     2160                          - frame Dialog-Frame :width
     2161         .
     2162         if p-change-value >= 0
     2163         then do:
     2164           run diasize_position-resize-button in this-procedure .
     2165           return .
     2166         end.
     2167       end.
     2168     end.
     2169     if p-change-value >= 0
     2170     then do:
     2171       assign
     2172         v-change-sign = 1
     2173       .
     2174     end.
     2175     else do:
     2176       assign
     2177         v-change-sign = -1
     2178       .
     2179     end.
     2180     assign
     2181       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2182     .
     2183     if p-change-value = 0
     2184     then do:
     2185       run diasize_position-resize-button in this-procedure .
     2186       return .
     2187     end.
     2188     move_block:
     2189     do
     2190     on error undo move_block, leave move_block
     2191     :
     2192       if retry
     2193       then do:
     2194         do
     2195         on error undo move_block, leave move_block
     2196         :
     2197           if p-change-value > 0
     2198           then do:
     2199             for each buf_temp-diasize-handle
     2200             on error undo, next
     2201             :
     2202               assign
     2203                 v-object-handle = buf_temp-diasize-handle.handle-value
     2204               .
     2205               if v-object-handle <> v-diasize-resize-button
     2206               then do:
     2207                 assign
     2208                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2209                 .
     2210               end.
     2211             end.
     2212             assign
     2213               v-diasize-browse-handle :width = v-browse-width
     2214             .
     2215             for each buf_temp-browse-handle
     2216               where buf_temp-browse-handle.browse-type = 'width':u
     2217             on error undo, next
     2218             :
     2219               assign
     2220                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2221               .
     2222             end.
     2223             assign
     2224               frame Dialog-Frame :width = v-frame-width
     2225             .
     2226             if frame Dialog-Frame :scrollable = true
     2227             then do:
     2228               assign
     2229                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2230               .
     2231             end.
     2232             run diasize_position-resize-button in this-procedure .
     2233           end.
     2234           else do:
     2235             if frame Dialog-Frame :scrollable = true
     2236             then do:
     2237               assign
     2238                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2239               .
     2240             end.
     2241             assign
     2242               frame Dialog-Frame :width = v-frame-width
     2243             .
     2244             for each buf_temp-browse-handle
     2245               where buf_temp-browse-handle.browse-type = 'width':u
     2246             on error undo, next
     2247             :
     2248               assign
     2249                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2250               .
     2251             end.
     2252             assign
     2253               v-diasize-browse-handle :width = v-browse-width
     2254             .
     2255             for each buf_temp-diasize-handle
     2256             on error undo, next
     2257             :
     2258               assign
     2259                 v-object-handle = buf_temp-diasize-handle.handle-value
     2260               .
     2261               if v-object-handle <> v-diasize-resize-button
     2262               then do:
     2263                 assign
     2264                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2265                 .
     2266               end.
     2267             end.
     2268             run diasize_position-resize-button in this-procedure .
     2269           end.
     2270           assign
     2271             v-diasize-change-size = false
     2272           .
     2273           leave move_block .
     2274         end.
     2275       end.
     2276       assign
     2277         v-diasize-need-full-display = true
     2278       .
     2279       if v-diasize-change-size = false
     2280       then do:
     2281         assign
     2282           v-diasize-change-size = true
     2283         .
     2284       end.
     2285       else do:
     2286         return .
     2287       end.
     2288       assign
     2289         v-frame-width = frame Dialog-Frame :width
     2290         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2291         v-browse-width = v-diasize-browse-handle :width
     2292       .
     2293       for each buf_temp-browse-handle
     2294         where buf_temp-browse-handle.browse-type = 'width':u
     2295       :
     2296         assign
     2297           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2298         .
     2299       end.
     2300       for each buf_temp-diasize-handle
     2301       :
     2302         delete buf_temp-diasize-handle .
     2303       end.
     2304       assign
     2305         v-field-group-handle = frame Dialog-Frame :first-child
     2306       .
     2307       do while valid-handle(v-field-group-handle)
     2308       :
     2309         assign
     2310           v-object-handle = v-field-group-handle :first-child
     2311         .
     2312         do while valid-handle(v-object-handle)
     2313         :
     2314           if  v-object-handle <> v-diasize-browse-handle :handle
     2315           and v-object-handle <> v-diasize-resize-button
     2316           and can-query(v-object-handle, "row")
     2317           and can-query(v-object-handle, "height")
     2318           and ( v-object-handle :col + v-object-handle :width
     2319                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2320               )
     2321           then do:
     2322             find first buf_temp-browse-handle
     2323               where buf_temp-browse-handle.browse-type   = 'width':u
     2324                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2325               no-error .
     2326             if available buf_temp-browse-handle
     2327             then do:
     2328             end.
     2329             else do:
     2330               create buf_temp-diasize-handle .
     2331               assign
     2332                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2333                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2334               .
     2335             end.
     2336           end.
     2337           assign
     2338             v-object-handle = v-object-handle :next-sibling
     2339           .
     2340         end.
     2341         assign
     2342           v-field-group-handle = v-field-group-handle :next-sibling
     2343         .
     2344       end.
     2345       do with frame Dialog-Frame
     2346       :
     2347         hide v-diasize-resize-button .
     2348         v-diasize-resize-button :row = 1.
     2349         v-diasize-resize-button :column = 1.
     2350       end.
     2351       if p-change-value > 0
     2352       then do:
     2353         if frame Dialog-Frame :scrollable = true
     2354         then do:
     2355           assign
     2356             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2357             no-error .
     2358           if error-status :error
     2359           or error-status :get-message(1) <> ""
     2360           then do:
     2361             undo move_block, retry move_block.
     2362           end.
     2363         end.
     2364         assign
     2365           frame Dialog-Frame :width = v-frame-width + p-change-value
     2366           no-error .
     2367         if error-status :error
     2368         or error-status :get-message(1) <> ""
     2369         then do:
     2370           undo move_block, retry move_block.
     2371         end.
     2372         assign
     2373           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2374         no-error .
     2375         if error-status :error
     2376         or error-status :get-message(1) <> ""
     2377         then do:
     2378           undo move_block, retry move_block.
     2379         end.
     2380         for each buf_temp-browse-handle
     2381           where buf_temp-browse-handle.browse-type = 'width':u
     2382         on error undo move_block, retry move_block
     2383         :
     2384           assign
     2385             buf_temp-browse-handle.browse-handle :width
     2386               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2387             no-error .
     2388           if error-status :error
     2389           or error-status :get-message(1) <> ""
     2390           then do:
     2391             undo move_block, retry move_block .
     2392           end.
     2393         end.
     2394         for each buf_temp-diasize-handle
     2395         on error undo move_block, retry move_block
     2396         :
     2397           assign
     2398             v-object-handle = buf_temp-diasize-handle.handle-value
     2399           .
     2400           if v-object-handle <> v-diasize-resize-button
     2401           then do:
     2402             assign
     2403               v-object-handle :col = v-object-handle :col + p-change-value
     2404               no-error .
     2405             if error-status :error
     2406             or error-status :get-message(1) <> ""
     2407             then do:
     2408               undo move_block, retry move_block .
     2409             end.
     2410           end.
     2411         end.
     2412       end.
     2413       else do:
     2414         for each buf_temp-diasize-handle
     2415         on error undo move_block, retry move_block
     2416         :
     2417           assign
     2418             v-object-handle = buf_temp-diasize-handle.handle-value
     2419           .
     2420           if v-object-handle <> v-diasize-resize-button
     2421           then do:
     2422             assign
     2423               v-object-handle :col = v-object-handle :col + p-change-value
     2424               no-error .
     2425             if error-status :error
     2426             or error-status :get-message(1) <> ""
     2427             then do:
     2428               undo move_block, retry move_block .
     2429             end.
     2430           end.
     2431         end.
     2432         for each buf_temp-browse-handle
     2433           where buf_temp-browse-handle.browse-type = 'width':u
     2434         on error undo move_block, retry move_block
     2435         :
     2436           assign
     2437             buf_temp-browse-handle.browse-handle :width
     2438               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2439             no-error .
     2440           if error-status :error
     2441           or error-status :get-message(1) <> ""
     2442           then do:
     2443             undo move_block, retry move_block .
     2444           end.
     2445         end.
     2446         assign
     2447           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2448           no-error .
     2449         if error-status :error
     2450         or error-status :get-message(1) <> ""
     2451         then do:
     2452           undo move_block, retry move_block.
     2453         end.
     2454         assign
     2455           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2456         no-error .
     2457         if error-status :error
     2458         or error-status :get-message(1) <> ""
     2459         then do:
     2460           undo move_block, retry move_block.
     2461         end.
     2462         if frame Dialog-Frame :scrollable = true
     2463         then do:
     2464           assign
     2465             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2466           no-error .
     2467           if error-status :error
     2468           or error-status :get-message(1) <> ""
     2469           then do:
     2470             undo move_block, retry move_block.
     2471           end.
     2472         end.
     2473       end.
     2474       if p-move-resize
     2475       then do:
     2476         run diasize_position-resize-button in this-procedure .
     2477       end.
     2478       if v-diasize-wndstore = true
     2479       then do:
     2480         if connected("ub") = true
     2481         then do:
     2482           define variable v-cntxt-db-num        as integer   no-undo .
     2483           define variable v-cntxt-userid        as character no-undo .
     2484           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2485                                             , OUTPUT v-cntxt-userid
     2486                                             ) .
     2487           run gbl/wndsizew.p
     2488             (input  v-cntxt-db-num
     2489             ,input  v-cntxt-userid
     2490             ,input  v-diasize-proc-name
     2491             ,input  'width':u
     2492             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2493             ) .
     2494         end.
     2495       end.
     2496     end.
     2497     assign
     2498       v-diasize-change-size = false
     2499     .
     2500   end procedure.
     2501   procedure diasize_set-width :
     2502     define input  parameter p-new-width  as decimal   no-undo .
     2503     define input  parameter p-move-resize as logical   no-undo .
     2504     do
     2505     on error undo, return error return-value
     2506     :
     2507       run diasize_change-width in this-procedure
     2508         (input  (p-new-width - frame Dialog-Frame :width)
     2509         ,input  p-move-resize
     2510         ) .
     2511     end.
     2512   end procedure.
     2513   procedure diasize_position-resize-button :
     2514     do with frame Dialog-Frame
     2515     :
     2516       hide v-diasize-resize-button .
     2517       assign
     2518         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2519                     - 1
     2520                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2521         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2522                     - 1
     2523                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2524       .
     2525       view v-diasize-resize-button .
     2526     end.
     2527   end procedure.
     2528   on alt-right anywhere
     2529   do:
     2530     run diasize_change-width in this-procedure
     2531       (input 1
     2532       ,input true
     2533       ) .
     2534     return no-apply .
     2535   end.
     2536   on alt-left anywhere
     2537   do:
     2538     run diasize_change-width in this-procedure
     2539       (input -1
     2540       ,input true
     2541       ) .
     2542     return no-apply .
     2543   end.
     2544   on alt-down anywhere
     2545   do:
     2546     run diasize_change-height in this-procedure
     2547       (input 1
     2548       ,input true
     2549       ) .
     2550     return no-apply .
     2551   end.
     2552   on alt-up anywhere
     2553   do:
     2554     run diasize_change-height in this-procedure
     2555       (input -1
     2556       ,input true
     2557       ) .
     2558     return no-apply .
     2559   end.
     2560   on alt-enter of frame Dialog-Frame
     2561   do:
     2562     run diasize_maximize in this-procedure
     2563       (input  ?
     2564       ).
     2565     return no-apply .
     2566   end.
     2567   procedure diasize_end-move :
     2568     do
     2569     on error undo, return error return-value
     2570     :
     2571       define variable v-row-delta as decimal   no-undo .
     2572       define variable v-col-delta as decimal   no-undo .
     2573       define variable v-new-row as decimal   no-undo .
     2574       define variable v-new-col as decimal   no-undo .
     2575       assign
     2576         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2577         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2578       .
     2579       assign
     2580         v-row-delta = v-new-row - frame Dialog-Frame :height
     2581         v-col-delta = v-new-col - frame Dialog-Frame :width
     2582       .
     2583       run diasize_change-height in this-procedure
     2584         (input v-row-delta
     2585         ,input true
     2586         ) .
     2587       run diasize_change-width in this-procedure
     2588         (input v-col-delta
     2589         ,input true
     2590         ) .
     2591     end.
     2592   end procedure.
     2593   procedure diasize_maximize :
     2594     define input  parameter p-action as logical   no-undo .
     2595     do
     2596     on error undo, return error return-value
     2597     :
     2598       if p-action = ?
     2599       then do:
     2600         if v-diasize-need-maximize = true
     2601         then do:
     2602           assign
     2603             p-action = true
     2604           .
     2605         end.
     2606         else do:
     2607           assign
     2608             p-action = false
     2609           .
     2610         end.
     2611       end.
     2612       if p-action = true
     2613       then do:
     2614         run diasize_change-height in this-procedure
     2615           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2616               - frame Dialog-Frame :height-chars
     2617           ,input true
     2618           ) .
     2619         run diasize_change-width in this-procedure
     2620           (input session :width-chars
     2621               - frame Dialog-Frame :width-chars
     2622           ,input true
     2623           ) .
     2624         assign
     2625           v-diasize-need-maximize = false
     2626         .
     2627       end.
     2628       else do:
     2629         run diasize_change-width in this-procedure
     2630           (input v-diasize-orig-frame-width
     2631               - frame Dialog-Frame :width-chars
     2632           ,input true
     2633           ) .
     2634         run diasize_change-height in this-procedure
     2635           (input v-diasize-orig-frame-height
     2636               - frame Dialog-Frame :height-chars
     2637           ,input true
     2638           ) .
     2639         assign
     2640           v-diasize-need-maximize = true
     2641         .
     2642       end.
     2643     end.
     2644   end procedure.
     2645   procedure diasize_restore-orig-size :
     2646     do
     2647     on error undo, return error return-value
     2648     :
     2649       assign
     2650         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2651         v-diasize-current-frame-height = frame Dialog-Frame :height
     2652       .
     2653       run diasize_set-height in this-procedure
     2654         (input  v-diasize-orig-frame-height
     2655         ,input  true
     2656         ) .
     2657       run diasize_set-width in this-procedure
     2658         (input  v-diasize-orig-frame-width
     2659         ,input  true
     2660         ) .
     2661     end.
     2662   end procedure.
     2663   procedure diasize_restore-current-size :
     2664     do
     2665     on error undo, return error return-value
     2666     :
     2667       run diasize_set-height in this-procedure
     2668         (input  v-diasize-current-frame-height
     2669         ,input  true
     2670         ) .
     2671       run diasize_set-width in this-procedure
     2672         (input  v-diasize-current-frame-width
     2673         ,input  true
     2674         ) .
     2675     end.
     2676   end procedure.
     2677   procedure diasize_set-browse-handle :
     2678     define input  parameter p-browse-handle as handle   no-undo .
     2679     define buffer buf_temp-browse-handle for temp-browse-handle .
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       assign
     2684         v-diasize-browse-handle = p-browse-handle
     2685       .
     2686       for each buf_temp-browse-handle
     2687       on error undo, return error return-value
     2688       :
     2689         delete buf_temp-browse-handle .
     2690       end.
     2691     end.
     2692   end procedure.
     2693   procedure diasize_add_browse :
     2694     define input  parameter p-browse-type   as character no-undo .
     2695     define input  parameter p-browse-handle as handle    no-undo .
     2696     define buffer buf_temp-browse-handle for temp-browse-handle .
     2697     do
     2698     on error undo, return error return-value
     2699     :
     2700       assign
     2701         v-diasize-browse-number = v-diasize-browse-number + 1
     2702       .
     2703       create buf_temp-browse-handle .
     2704       assign
     2705         buf_temp-browse-handle.browse-type   = p-browse-type
     2706         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2707         buf_temp-browse-handle.browse-handle = p-browse-handle
     2708       .
     2709     end.
     2710   end procedure.
     2711   procedure diasize_init :
     2712     define variable v-default-value    as logical   no-undo .
     2713     define variable v-restore-saved    as logical   no-undo .
     2714     define variable v-resize-value-str as character no-undo .
     2715     do
     2716     on error undo, return error return-value
     2717     :
     2718       do with frame Dialog-Frame
     2719       :
     2720         assign
     2721           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2722           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2723           v-diasize-browse-handle     = browse br-template :handle
     2724         .
     2725         create button v-diasize-resize-button
     2726         assign
     2727           parent        = frame Dialog-Frame :first-child
     2728           label         = "s"
     2729           height-pixels = 16
     2730           width-pixels  = 16
     2731           visible       = true
     2732           sensitive     = true
     2733           movable       = true
     2734           triggers:
     2735             on end-move persistent run diasize_end-move in this-procedure .
     2736           end triggers.
     2737         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2738         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2739         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2740         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2741         assign
     2742           v-diasize-wndmax = false
     2743         .
     2744         if connected("ub") = true
     2745         then do:
     2746           define variable v-cntxt-db-num        as integer   no-undo .
     2747           define variable v-cntxt-userid        as character no-undo .
     2748           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2749                                             , OUTPUT v-cntxt-userid
     2750                                             ) .
     2751           run gbl/wndpar_r.p
     2752             (input  v-cntxt-db-num
     2753             ,input  v-cntxt-userid
     2754             ,input  'wndmax':U
     2755             ,output v-diasize-wndmax
     2756             ,output v-default-value
     2757             ) .
     2758         end.
     2759         assign
     2760           v-diasize-wndstore = false
     2761         .
     2762         if connected("ub") = true
     2763         then do:
     2764           run gbl/wndpar_r.p
     2765             (input  v-cntxt-db-num
     2766             ,input  v-cntxt-userid
     2767             ,input  'wndstore':U
     2768             ,output v-diasize-wndstore
     2769             ,output v-default-value
     2770             ) .
     2771         end.
     2772         assign
     2773           v-diasize-proc-name = entry(1, program-name(2), '.')
     2774         .
     2775         if v-diasize-wndstore = true
     2776         then do:
     2777           assign
     2778             v-restore-saved = false
     2779           .
     2780           if connected("ub") = true
     2781           then do:
     2782             run gbl/wndsizer.p
     2783               (input  v-cntxt-db-num
     2784               ,input  v-cntxt-userid
     2785               ,input  v-diasize-proc-name
     2786               ,input  'height':u
     2787               ,output v-resize-value-str
     2788               ) .
     2789             if v-resize-value-str <> '':U
     2790             then do:
     2791               run diasize_change-height in this-procedure
     2792                 (input  integer(v-resize-value-str)
     2793                 ,input  true
     2794                 ) .
     2795               assign
     2796                 v-restore-saved = true
     2797               .
     2798             end.
     2799           end.
     2800           if connected("ub") = true
     2801           then do:
     2802             run gbl/wndsizer.p
     2803               (input  v-cntxt-db-num
     2804               ,input  v-cntxt-userid
     2805               ,input  v-diasize-proc-name
     2806               ,input  'width':u
     2807               ,output v-resize-value-str
     2808               ) .
     2809             if v-resize-value-str <> '':U
     2810             then do:
     2811               run diasize_change-width in this-procedure
     2812                 (input  integer(v-resize-value-str)
     2813                 ,input  true
     2814                 ) .
     2815               assign
     2816                 v-restore-saved = true
     2817               .
     2818             end.
     2819           end.
     2820           if v-restore-saved <> true
     2821           then do:
     2822             if v-diasize-wndmax = true
     2823             then do:
     2824               run diasize_maximize in this-procedure
     2825                 (input  true
     2826                 ) .
     2827             end.
     2828           end.
     2829         end.
     2830         else do:
     2831           if v-diasize-wndmax = true
     2832           then do:
     2833             run diasize_maximize in this-procedure
     2834               (input  true
     2835               ) .
     2836           end.
     2837         end.
     2838       end.
     2839     end.
     2840   end procedure.
     2841   procedure diasize_need-full-display :
     2842     define output parameter p-need-full-display as logical   no-undo .
     2843     do
     2844     on error undo, return error return-value
     2845     :
     2846       assign
     2847         p-need-full-display = v-diasize-need-full-display
     2848       .
     2849       assign
     2850         v-diasize-need-full-display = false
     2851       .
     2852     end.
     2853   end procedure.
     2854   procedure get-context :
     2855      define output parameter p-db-num as integer          no-undo.
     2856      define output parameter p-user-id as character        no-undo.
     2857      define variable v-login               as character    no-undo.
     2858      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2859      define buffer buf_user-login  for ub.user-login .
     2860      do
     2861      on error undo, return error
     2862      :
     2863            FIND FIRST buf_sys-ctrl no-lock.
     2864            ASSIGN
     2865               v-login = USERID("ub")
     2866               p-db-num = buf_sys-ctrl.db-num
     2867            .
     2868            FIND FIRST buf_user-login
     2869                 WHERE buf_user-login.db-num = p-db-num
     2870                   AND buf_user-login.user-login = v-login
     2871                 no-lock
     2872                 no-error
     2873                 .
     2874            IF AVAILABLE buf_user-login
     2875            THEN DO:
     2876               assign
     2877                  p-user-id = buf_user-login.user-id
     2878               .
     2879            END.
     2880      end.
     2881   end procedure.
     2882       run diasize_init in this-procedure .
     2883   MAIN-BLOCK:
     2884   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2885      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2886   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2887     run mainmenu_getcntxt in parparentproc
     2888       (output v-cntxt-db-num
     2889       ,output v-cntxt-userid
     2890       ,output v-cntxt-level
     2891       ,output v-cntxt-host-code-obj
     2892       ,output v-cntxt-obj-type
     2893       ,output v-cntxt-obj-code
     2894       ,output v-cntxt-db-num-obj
     2895       ,output v-cntxt-is-admin
     2896       ) .
     2897       assign
     2898       frame Dialog-Frame :title = frame Dialog-Frame :title +
     2899                           substitute(". &1: Задача номер &2"
     2900                           , p-task-type
     2901                           , p-task-num )
     2902       .
     2903   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2905     (input  v-cntxt-obj-type
     2906     ,input  v-cntxt-obj-code
     2907     ,output v-host-code
     2908     ) no-error .
     2909       if error-status :error
     2910       then do:
     2911           message
     2912             vss-workfile vss-revision vss-description
     2913             skip "Ошибка при определении кода фирмы текущего объекта"
     2914             skip "Тип объекта:" v-cntxt-obj-type
     2915             skip "Код объекта:" v-cntxt-obj-code
     2916             skip "Обработка документов продаж невозможна"
     2917             skip return-value
     2918             skip trim(error-status :get-message(1))
     2919                  trim(error-status :get-message(2))
     2920                  trim(error-status :get-message(3))
     2921           view-as alert-box error.
     2922           undo, return error.
     2923       end.
     2924       run get-host-name in this-procedure ( output v-host-name ) no-error .
     2925       if error-status :error
     2926       then do:
     2927           message
     2928             vss-workfile vss-revision vss-description
     2929             skip "Ошибка при определении имени фирмы"
     2930             skip "Код фирмы:" v-host-code
     2931             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-host-code ) + "'"
     2932             skip return-value
     2933             skip trim(error-status :get-message(1))
     2934                  trim(error-status :get-message(2))
     2935                  trim(error-status :get-message(3))
     2936           view-as alert-box warning.
     2937           assign
     2938               v-host-name = 'орг':U + string( v-host-code )
     2939           .
     2940       end.
     2941       run init-param-values in this-procedure (
     2942             input p-cre-db-num
     2943           , input p-task-type
     2944           , input p-task-num
     2945           , output v-obj-list
     2946           , output rs-1
     2947           , OUTPUT rs-start
     2948           , OUTPUT rs-end
     2949           , OUTPUT t-finalize-100
     2950           , OUTPUT t-finalize-200
     2951       ).
     2952       RUN fill-table IN THIS-PROCEDURE.
     2953       run MYenable.
     2954       run object-select in this-procedure (
     2955           input rs-1
     2956       ).
     2957       run init-fields in this-procedure .
     2958       WAIT-FOR GO OF FRAME Dialog-Frame.
     2959   END.
     2960   RUN disable_UI.
     2961   PROCEDURE attach-attr-to-schedule-line :
     2962   do
     2963   on error undo, return error
     2964   :
     2965       define input parameter p-rs-1               as integer      no-undo.
     2966       define input parameter p-object-list        as character    no-undo.
     2967       define input parameter p-rs-start           as integer      no-undo.
     2968       define input parameter p-rs-end             as integer      no-undo.
     2969       define input parameter p-finalize-100       as logical      no-undo.
     2970       define input parameter p-finalize-200       as logical      no-undo.
     2971       define variable v-attr-value as character     no-undo.
     2972       define buffer buf_schedule      for ub.schedule.
     2973       define buffer buf_schedule-attr for ub.schedule-attr.
     2974       find first buf_schedule no-lock
     2975            where buf_schedule.cre-db-num = p-cre-db-num
     2976              and buf_schedule.task-type  = p-task-type
     2977              and buf_schedule.task-num   = p-task-num
     2978       no-error.
     2979       if not available buf_schedule
     2980       and (  p-task-type   <> 'autosale':U
     2981           or p-task-num    <> -1 )
     2982       then do:
     2983           message
     2984             vss-workfile vss-revision vss-description
     2985             skip "Не найдена строка расписания."
     2986             skip return-value
     2987             skip trim(error-status :get-message(1))
     2988                  trim(error-status :get-message(2))
     2989                  trim(error-status :get-message(3))
     2990           view-as alert-box error.
     2991           undo, return error .
     2992       end.
     2993       assign
     2994           v-attr-value = string( p-rs-1 )
     2995                          + "," + string( v-cntxt-host-code-obj )
     2996                          + "," + string( p-rs-start )
     2997                          + "," + string( p-rs-end )
     2998                          + "," + string( p-finalize-100 )
     2999                          + "," + string( p-finalize-200 )
     3000       .
     3001       run schedule-attr-write in this-procedure (
     3002             input p-cre-db-num
     3003           , input p-task-type
     3004           , input p-task-num
     3005           , input 'schedule-param-list':U
     3006           , input v-attr-value
     3007       ).
     3008       run schedule-attr-write in this-procedure (
     3009             input p-cre-db-num
     3010           , input p-task-type
     3011           , input p-task-num
     3012           , input 'schedule-obj-list':U
     3013           , input p-object-list
     3014       ).
     3015       for each buf_schedule-attr
     3016       on error undo, return error
     3017       :
     3018           if buf_schedule-attr.task-type  <> 'autosale':U
     3019           or buf_schedule-attr.cre-db-num <> p-cre-db-num
     3020           or buf_schedule-attr.task-num   <> -1
     3021           or (
     3022                   buf_schedule-attr.attr-code <> 'schedule-param-list':U
     3023               and buf_schedule-attr.attr-code <> 'schedule-obj-list':U
     3024               and buf_schedule-attr.attr-code <> 'schedule-date-list':U
     3025               and buf_schedule-attr.attr-code <> 'schedule-filter':U
     3026   )
     3027           then do:
     3028               find first buf_schedule
     3029                    where buf_schedule.cre-db-num = buf_schedule-attr.cre-db-num
     3030                      and buf_schedule.task-type  = buf_schedule-attr.task-type
     3031                      and buf_schedule.task-num   = buf_schedule-attr.task-num
     3032               no-error.
     3033               if not available buf_schedule
     3034               then do:
     3035                   delete buf_schedule-attr.
     3036               end.
     3037           end.
     3038       end.
     3039   end.
     3040   END PROCEDURE.
     3041   PROCEDURE disable_UI :
     3042     HIDE FRAME Dialog-Frame.
     3043   END PROCEDURE.
     3044   PROCEDURE enable_UI :
     3045     DISPLAY rs-1 ed-object rs-start rs-end T-finalize-100 T-finalize-200
     3046             F-shift-date F-shift-name F-shift-num ED-FILTER
     3047         WITH FRAME Dialog-Frame.
     3048     ENABLE Btn_OK Btn_Cancel b-help rct-obj RECT-6 rs-1 bt-sel-obj rs-start
     3049            rs-end T-finalize-100 T-finalize-200 btn-add btn-del btn-update-main
     3050            btn-update br-template ED-FILTER
     3051         WITH FRAME Dialog-Frame.
     3052     VIEW FRAME Dialog-Frame.
     3053     OPEN QUERY br-template FOR EACH temp-schedule-attr       WHERE temp-schedule-attr.cre-db-num = p-cre-db-num  AND temp-schedule-attr.task-type = p-task-type  AND temp-schedule-attr.task-num = p-task-num  AND temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4)) NO-LOCK.
     3054   END PROCEDURE.
     3055   PROCEDURE extract-parameter :
     3056   do
     3057   on error undo, return error
     3058   :
     3059   end.
     3060   END PROCEDURE.
     3061   PROCEDURE fill-table :
     3062   DEFINE BUFFER buf_schedule-attr FOR ub.schedule-attr.
     3063   DEFINE BUFFER buf_temp-schedule-attr FOR temp-schedule-attr.
     3064   FOR EACH buf_temp-schedule-attr:
     3065       DELETE buf_temp-schedule-attr.
     3066   END.
     3067   FOR EACH buf_schedule-attr WHERE
     3068           buf_schedule-attr.cre-db-num = p-cre-db-num
     3069       AND buf_schedule-attr.task-type = p-task-type
     3070       AND buf_schedule-attr.task-num = p-task-num:
     3071     IF buf_schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4))
     3072     or buf_schedule-attr.attr-code BEGINS ('schedule-filter':U  + chr(4)) THEN DO:
     3073       CREATE buf_temp-schedule-attr.
     3074       BUFFER-COPY buf_schedule-attr
     3075       TO
     3076       buf_temp-schedule-attr.
     3077     END.
     3078   END.
     3079   END PROCEDURE.
     3080   PROCEDURE filter-get :
     3081   DEFINE INPUT PARAMETER p-where-ysl AS CHARACTER NO-UNDO.
     3082   DEFINE INPUT PARAMETER p-where-ysl-rus AS CHARACTER NO-UNDO.
     3083   DEFINE OUTPUT PARAMETER p-where-phrase AS CHARACTER NO-UNDO.
     3084   DEFINE OUTPUT PARAMETER p-where-phrase-rus AS CHARACTER NO-UNDO.
     3085   define variable  ind as integer no-undo.
     3086   define variable  v-new-where-phrase as character no-undo .
     3087   define variable  v-sub-phrase as character no-undo .
     3088   assign
     3089   p-where-phrase     = ""
     3090   p-where-phrase-rus = ""
     3091   .
     3092   if num-entries(p-where-ysl) > 0 then do:
     3093     assign
     3094     p-where-phrase = p-where-phrase
     3095                     + ' and ('
     3096     .
     3097     do ind = 1 to num-entries(p-where-ysl):
     3098       assign
     3099       p-where-phrase = p-where-phrase
     3100                     + " " + (if ind = 1 then left-trim(left-trim(entry(ind, p-where-ysl)), 'and':U)
     3101                              else entry(ind, p-where-ysl))
     3102       .
     3103     end.
     3104     assign
     3105     p-where-phrase = p-where-phrase
     3106                     + ')'
     3107     .
     3108   end.
     3109   if num-entries(p-where-phrase, "^") > 1 then do:
     3110     assign
     3111     v-new-where-phrase = entry(1, p-where-phrase, "^")
     3112     .
     3113     do ind = 2 to num-entries(p-where-phrase, "^")
     3114     :
     3115       assign
     3116       v-sub-phrase = entry(ind, p-where-phrase, "^")
     3117       .
     3118       if octal-to-char(substring(v-sub-phrase, 1, 3)) <> ? then do:
     3119         assign
     3120         v-new-where-phrase = v-new-where-phrase
     3121                             + octal-to-char(substring(v-sub-phrase, 1, 3))
     3122                             + substring(v-sub-phrase, 4)
     3123         .
     3124       end.
     3125       else do:
     3126         assign
     3127         v-new-where-phrase = v-new-where-phrase
     3128                             + "^"
     3129                             + v-sub-phrase
     3130         .
     3131       end.
     3132     end.
     3133     assign
     3134     p-where-phrase = v-new-where-phrase
     3135     .
     3136   end.
     3137   assign
     3138   p-where-phrase-rus = p-where-ysl-rus
     3139   .
     3140   END PROCEDURE.
     3141   PROCEDURE get-host-name :
     3142   do
     3143   on error undo, return error
     3144   :
     3145   define output parameter p-host-name as character    no-undo.
     3146   define buffer buf_clients   for ub.clients.
     3147       find first buf_clients no-lock
     3148            where buf_clients.obj-type = 'орг':U
     3149              and buf_clients.obj-code = v-host-code
     3150       no-error.
     3151       if not available buf_clients
     3152       then do:
     3153           message
     3154             vss-workfile vss-revision vss-description
     3155             skip "Не удалось найти текущую фирму"
     3156             skip return-value
     3157             skip trim(error-status :get-message(1))
     3158                  trim(error-status :get-message(2))
     3159                  trim(error-status :get-message(3))
     3160                  trim(error-status :get-message(4))
     3161                  trim(error-status :get-message(5))
     3162           view-as alert-box error.
     3163           undo, return error .
     3164       end.
     3165       else do:
     3166           assign
     3167               p-host-name = buf_clients.obj-name
     3168           .
     3169       end.
     3170   end.
     3171   END PROCEDURE.
     3172   PROCEDURE init-fields :
     3173   do
     3174   on error undo, return error
     3175   :
     3176       define variable v-oper-num     as integer           no-undo.
     3177       run manage-options          in this-procedure.
     3178   end.
     3179   END PROCEDURE.
     3180   PROCEDURE init-param-values :
     3181   do
     3182   on error undo, return error
     3183   :
     3184   define input parameter p-cre-db-num             as integer      no-undo .
     3185   define input parameter p-task-type              as character    no-undo.
     3186   define input parameter p-task-num               as integer      no-undo.
     3187   define output parameter p-obj-list              as character    no-undo.
     3188   define output parameter p-rs-1                  as integer      no-undo.
     3189   define output parameter p-rs-start              as integer      no-undo.
     3190   define output parameter p-rs-end                as integer      no-undo.
     3191   define output parameter p-finalize-100          as LOGICAL      no-undo.
     3192   define output parameter p-finalize-200          as LOGICAL      no-undo.
     3193       define variable v-counter       as integer       no-undo.
     3194       define variable v-param-list    as character     no-undo.
     3195       run schedule-attr-value in this-procedure (
     3196             input p-cre-db-num
     3197           , input p-task-type
     3198           , input p-task-num
     3199           , input 'schedule-obj-list':U
     3200           , output p-obj-list
     3201           , output v-param-type
     3202       ) .
     3203       for each temp_obj-list
     3204       :
     3205           delete temp_obj-list.
     3206       end.
     3207       do v-counter = 1 to num-entries( p-obj-list ) / 2
     3208       :
     3209           create temp_obj-list.
     3210           assign
     3211               temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-obj-list )
     3212               temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-obj-list ) )
     3213           .
     3214       end.
     3215       run schedule-attr-value in this-procedure (
     3216             input p-cre-db-num
     3217           , input p-task-type
     3218           , input p-task-num
     3219           , input 'schedule-param-list':U
     3220           , output v-param-list
     3221           , output v-param-type
     3222       ) .
     3223       if v-param-list = ""
     3224       then do:
     3225           assign
     3226               p-rs-1                  = 1
     3227               p-rs-start             = 0
     3228               p-rs-end               = 300
     3229               t-finalize-100         = NO
     3230               t-finalize-200         = NO
     3231           .
     3232       end.
     3233       else do:
     3234           assign
     3235               p-rs-1 = integer( entry( 1, v-param-list ) )
     3236               p-rs-start = integer( entry( 3, v-param-list ) )
     3237               p-rs-end = integer( entry( 4, v-param-list ) )
     3238               p-finalize-100 = LOGICAL (entry( 5, v-param-list ) )
     3239               p-finalize-200 = LOGICAL (entry( 6, v-param-list ) )
     3240           .
     3241       end.
     3242   end.
     3243   END PROCEDURE.
     3244   PROCEDURE manage-options :
     3245   do
     3246   on error undo, return error
     3247   :
     3248   assign
     3249       rct-obj             :visible in frame Dialog-Frame = yes
     3250       rs-1                :visible in frame Dialog-Frame = yes
     3251       bt-sel-obj          :visible in frame Dialog-Frame = yes
     3252       ed-object           :visible in frame Dialog-Frame = yes
     3253   .
     3254   run object-select in this-procedure (
     3255       input rs-1
     3256   ).
     3257   end.
     3258   END PROCEDURE.
     3259   PROCEDURE MyEnable :
     3260   dEFINE variable ii                      as INTEGER       no-undo.
     3261   DO ii =  1 TO NUM-ENTRIES("0,100,200,300,400"):
     3262       ASSIGN
     3263       rs-start:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3264       (IF ii = 1
     3265       THEN (trim(ENTRY(ii, "Создавать продажи по шаблонам,                            Закачивать чеки в продажу,                            Резервировать товары продажи,                            Закрывать документ продажи на факт,                            Удалять пустые (без чеков) продажи")) + chr(44) + ENTRY(ii, "0,100,200,300,400"))
     3266       ELSE (rs-start:RADIO-BUTTONS IN FRAME Dialog-Frame + chr(44) +
     3267            (trim(ENTRY(ii, "Создавать продажи по шаблонам,                            Закачивать чеки в продажу,                            Резервировать товары продажи,                            Закрывать документ продажи на факт,                            Удалять пустые (без чеков) продажи")) + chr(44) + ENTRY(ii, "0,100,200,300,400"))
     3268            )
     3269       ).
     3270   END.
     3271   ASSIGN
     3272   rs-end:RADIO-BUTTONS IN FRAME Dialog-Frame = rs-start:RADIO-BUTTONS IN FRAME Dialog-Frame
     3273   .
     3274   ASSIGN
     3275   filter-point = filter-point + chr(32) + STRING(p-task-num)
     3276   .
     3277   DISPLAY
     3278   rs-1
     3279   ed-object
     3280   rs-start
     3281   rs-end
     3282   t-finalize-100
     3283   t-finalize-200
     3284   WITH FRAME Dialog-Frame.
     3285   ENABLE
     3286   rct-obj
     3287   RECT-6
     3288   Btn_OK
     3289   Btn_Cancel
     3290   b-help
     3291   rs-1
     3292   bt-sel-obj
     3293   rs-start
     3294   rs-end
     3295   WITH FRAME Dialog-Frame.
     3296   VIEW FRAME Dialog-Frame.
     3297   APPLY "VALUE-CHANGED" TO rs-start IN FRAME Dialog-Frame.
     3298   OPEN QUERY br-template FOR EACH temp-schedule-attr       WHERE temp-schedule-attr.cre-db-num = p-cre-db-num  AND temp-schedule-attr.task-type = p-task-type  AND temp-schedule-attr.task-num = p-task-num  AND temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4)) NO-LOCK.
     3299   APPLY "VALUE-CHANGED" TO br-template IN FRAME Dialog-Frame.
     3300   END PROCEDURE.
     3301   PROCEDURE object-select :
     3302   do
     3303   on error undo, return error
     3304   :
     3305   define input parameter p-rs-1   as integer      no-undo.
     3306   case p-rs-1
     3307   :
     3308       when 1
     3309       then do:
     3310           assign
     3311               ed-object :screen-value in frame Dialog-frame = "Все объекты БД"
     3312           .
     3313       end.
     3314       when 2
     3315       then do:
     3316           assign
     3317               ed-object :screen-value = v-host-name
     3318           .
     3319       end.
     3320       when 3
     3321       then do:
     3322           assign
     3323               ed-object :screen-value = ""
     3324           .
     3325           for each temp_obj-list
     3326           :
     3327               assign
     3328                   ed-object :screen-value = ed-object :screen-value
     3329                       + ( if ed-object :screen-value = "" then "" else ", " )
     3330                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code )
     3331               .
     3332           end.
     3333       end.
     3334   end case.
     3335   end.
     3336   END PROCEDURE.
     3337   PROCEDURE proc-b-add :
     3338   define variable v-flt-rec as recid  no-undo .
     3339   DEFINE BUFFER buf_temp-schedule-attr FOR temp-schedule-attr.
     3340   FIND LAST buf_temp-schedule-attr NO-LOCK WHERE
     3341           buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3342       AND buf_temp-schedule-attr.task-type = p-task-type
     3343       AND buf_temp-schedule-attr.task-num = p-task-num
     3344       AND buf_temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4)) NO-ERROR.
     3345     IF NOT AVAILABLE buf_temp-schedule-attr THEN Kl = 1.
     3346     ELSE kl = integer(ENTRY(2, buf_temp-schedule-attr.attr-code, chr(4))) + 1.
     3347     RUN temp-schedule-attr-write  IN THIS-PROCEDURE(
     3348                                                input p-cre-db-num
     3349                                               ,input p-task-type
     3350                                               ,input p-task-num
     3351                                               ,input ('schedule-date-list':U + chr(4) + STRING(kl))
     3352                                               ,input ("(TODAY - 1),0" + chr(4) +
     3353                                                      "(TODAY - 1),0" + chr(4))
     3354                                               ).
     3355     FIND first buf_temp-schedule-attr NO-LOCK WHERE
     3356             buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3357         AND buf_temp-schedule-attr.task-type = p-task-type
     3358         AND buf_temp-schedule-attr.task-num = p-task-num
     3359         AND buf_temp-schedule-attr.attr-code = ('schedule-date-list':U + chr(4) + STRING(kl)) .
     3360     v-flt-rec = RECID(buf_temp-schedule-attr).
     3361     OPEN QUERY br-template FOR EACH temp-schedule-attr       WHERE temp-schedule-attr.cre-db-num = p-cre-db-num  AND temp-schedule-attr.task-type = p-task-type  AND temp-schedule-attr.task-num = p-task-num  AND temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4)) NO-LOCK.
     3362     REPOSITION br-template TO RECID v-flt-rec no-error.
     3363   END PROCEDURE.
     3364   PROCEDURE proc-b-del :
     3365   DEFINE VARIABLE v-deleted AS LOGICAL NO-UNDO.
     3366   define variable v-flt-rec as recid no-undo .
     3367   do on stop  undo, return:
     3368    f-shift-DATE = "".
     3369    f-shift-name = "".
     3370    f-shift-num = "".
     3371    ED-FILTER = "".
     3372    v-flt-rec = recid(temp-schedule-attr).
     3373    kl = INTEGER(ENTRY(2, temp-schedule-attr.attr-code, chr(4))).
     3374    RUN temp-schedule-attr-delete IN THIS-PROCEDURE (
     3375                                                    input p-cre-db-num
     3376                                                   ,input p-task-type
     3377                                                   ,input p-task-num
     3378                                                   ,input 'schedule-date-list':U + chr(4) + string(Kl)
     3379                                                   ,output v-deleted       ) NO-ERROR.
     3380    IF ERROR-STATUS:ERROR or NOT v-deleted THEN UNDO, RETURN error.
     3381    RUN temp-schedule-attr-delete IN THIS-PROCEDURE (
     3382                                                    input p-cre-db-num
     3383                                                   ,input p-task-type
     3384                                                   ,input p-task-num
     3385                                                   ,input 'schedule-filter':U + chr(4) + string(Kl)
     3386                                                   ,output v-deleted       ) NO-ERROR.
     3387   IF ERROR-STATUS:ERROR THEN UNDO, RETURN error.
     3388    OPEN QUERY br-template FOR EACH temp-schedule-attr       WHERE temp-schedule-attr.cre-db-num = p-cre-db-num  AND temp-schedule-attr.task-type = p-task-type  AND temp-schedule-attr.task-num = p-task-num  AND temp-schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4)) NO-LOCK.
     3389    REPOSITION br-template TO RECID v-flt-rec no-error.
     3390    APPLY "VALUE-CHANGED" TO br-template IN FRAME Dialog-Frame.
     3391    apply "entry" to br-template.
     3392   end.
     3393   END PROCEDURE.
     3394   PROCEDURE proc-b-sch :
     3395   END PROCEDURE.
     3396   PROCEDURE proc-b-template :
     3397   assign
     3398     tbl = 'chk-doc'
     3399     join-tbl = 'X_chk-doc'
     3400     fld = ""
     3401     lab = ""
     3402     spr = ""
     3403     dim = '0'
     3404     .
     3405   run fltfield-add in this-procedure('doc-code', 'Номер в базе', '',
     3406   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3407   run fltfield-add in this-procedure('chk-date', '', '',
     3408   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3409   run fltfield-add in this-procedure('chk-time', '', 'time',
     3410   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3411   run fltfield-add in this-procedure('chk-type', 'Тип чека', 'receipt-code',
     3412   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3413   run fltfield-add in this-procedure('office', 'Т или у', 'gds-type',
     3414   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3415   run fltfield-add in this-procedure('shift-date', 'Дата смены(учета)', '',
     3416   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3417   run fltfield-add in this-procedure('shift-num', 'Порядок смен', '',
     3418   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3419   run fltfield-add in this-procedure('shift-name', '№ смены', '',
     3420   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3421   run fltfield-add in this-procedure('chk-num', 'Номер по кассе', '',
     3422   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3423   run fltfield-add in this-procedure('pay-desk', '', '',
     3424   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3425   run fltfield-add in this-procedure('cashier', '', '',
     3426   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3427   run fltfield-add in this-procedure('sales-man', '', '',
     3428   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3429   run fltfield-add in this-procedure('tot-doc', '', '',
     3430   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3431   run fltfield-add in this-procedure('discnt', '', '',
     3432   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3433   run fltfield-add in this-procedure('sub-discnt', 'Списания', '',
     3434   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3435   run fltfield-add in this-procedure('netto', 'Нетто сумма (выручка)', '',
     3436   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3437   run fltfield-add in this-procedure('d-card', 'N дис.карты', '',
     3438   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3439   END PROCEDURE.
     3440   PROCEDURE proc-filter :
     3441   define variable v-rid as recid no-undo .
     3442   define variable v-naim like ubflt.filter.naim no-undo .
     3443   define variable v-where-ysl as character no-undo .
     3444   define variable v-where-ysl-rus as character no-undo .
     3445   define variable where-phrase as character no-undo .
     3446   define variable where-phrase-rus as character no-undo .
     3447   define variable v-fields-sort as character no-undo .
     3448   define variable v-fields-sort-rus as character no-undo .
     3449   define variable p-lst-cend        as character no-undo .
     3450   define variable v-doc-rec        as  recid no-undo .
     3451   define buffer buf_temp-schedule-attr for temp-schedule-attr.
     3452   FIND FIRST buf_temp-schedule-attr NO-LOCK WHERE
     3453             buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3454       AND   buf_temp-schedule-attr.task-type  = p-task-type
     3455       and   buf_temp-schedule-attr.task-num = p-task-num
     3456       and buf_temp-schedule-attr.attr-code = 'schedule-filter':U + chr(4) +
     3457                                         string(integer(entry(2, temp-schedule-attr.attr-code, chr(4))))   no-error.
     3458   if available buf_temp-schedule-attr then do:
     3459     assign
     3460     v-where-ysl = entry(1, buf_temp-schedule-attr.attr-value, chr(4))
     3461     v-where-ysl-rus = entry(2, buf_temp-schedule-attr.attr-value, chr(4))
     3462     v-naim          = entry(3, temp-schedule-attr.attr-value, chr(4))
     3463     v-doc-rec       = recid(temp-schedule-attr)
     3464     .
     3465   end.
     3466   else do:
     3467   end.
     3468   v-naim = entry(3, temp-schedule-attr.attr-value, chr(4)).
     3469     Kl = 0.
     3470     run gbl/updf.w  (
     3471                   input parparentproc
     3472                 , input "Обработка продаж"
     3473                 , input-output v-naim
     3474                 , input no
     3475                 , input no
     3476                 , input no
     3477                 , input no
     3478                 , input Tbl
     3479                 , input join-tbl
     3480                 , input Fld
     3481                 , input Lab
     3482                 , input Spr
     3483                 , input Dim
     3484                 , input-output v-where-ysl
     3485                 , input-output v-where-ysl-rus
     3486                 , input-output v-fields-sort
     3487                 , input-output v-fields-sort-rus
     3488                 , input-output p-lst-cend
     3489                 , input Kl
     3490                 , output v-rID).
     3491     IF v-rid = ? THEN ID = IDENT.
     3492     else do:
     3493         run filter-get in this-procedure (
     3494                                             input  v-where-ysl
     3495                                            ,input  v-where-ysl-rus
     3496                                            ,output where-phrase
     3497                                            ,output where-phrase-rus
     3498                                          ).
     3499       if not available buf_temp-schedule-attr then do:
     3500         create buf_temp-schedule-attr.
     3501         buffer-copy temp-schedule-attr
     3502         except attr-code attr-value
     3503         to buf_temp-schedule-attr
     3504         assign
     3505         buf_temp-schedule-attr.attr-code = 'schedule-filter':U + chr(4) +
     3506                                         string(integer(entry(2, temp-schedule-attr.attr-code, chr(4))))
     3507         .
     3508       end.
     3509       assign
     3510         buf_temp-schedule-attr.attr-value = where-phrase + chr(4) +
     3511                                        where-phrase-rus
     3512         .
     3513     end.
     3514     RUN MYenable.
     3515     run object-select in this-procedure (
     3516           input rs-1
     3517       ).
     3518     REPOSITION br-template TO RECID v-doc-rec no-error.
     3519     APPLY "VALUE-CHANGED" TO br-template in frame Dialog-Frame.
     3520     apply "entry" to br-template.
     3521   END PROCEDURE.
     3522   PROCEDURE proc-start :
     3523   DEFINE INPUT PARAMETER p-start AS INTEGER NO-UNDO.
     3524   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3525   DEFINE VARIABLE v-label AS character NO-UNDO.
     3526   DEFINE VARIABLE v-value AS INTEGER NO-UNDO.
     3527   DO ii = 1 TO NUM-ENTRIES("0,100,200,300,400"):
     3528       ASSIGN
     3529       v-label = trim(ENTRY(ii, "Создавать продажи по шаблонам,                            Закачивать чеки в продажу,                            Резервировать товары продажи,                            Закрывать документ продажи на факт,                            Удалять пустые (без чеков) продажи"))
     3530       v-value = integer(ENTRY(ii, "0,100,200,300,400"))
     3531       .
     3532      rs-end:enable(v-label) IN FRAME Dialog-Frame.
     3533   END.
     3534   DO ii = 1 TO NUM-ENTRIES("0,100,200,300,400"):
     3535       ASSIGN
     3536       v-label = trim(ENTRY(ii, "Создавать продажи по шаблонам,                            Закачивать чеки в продажу,                            Резервировать товары продажи,                            Закрывать документ продажи на факт,                            Удалять пустые (без чеков) продажи"))
     3537       v-value = integer(ENTRY(ii, "0,100,200,300,400"))
     3538       .
     3539       IF v-value < p-start  THEN DO:
     3540          rs-end:disable(v-label) IN FRAME Dialog-Frame.
     3541       END.
     3542   END.
     3543   IF p-start = 0 THEN dO:
     3544       ENABLE
     3545       br-template
     3546       btn-add
     3547       btn-del
     3548       btn-update-main
     3549       btn-update
     3550       WITH FRAME Dialog-Frame.
     3551       RUN proc-b-template IN THIS-PROCEDURE NO-ERROR.
     3552   END.
     3553   ELSE DO:
     3554      if p-start > 100 then do:
     3555       disable
     3556       t-finalize-100
     3557       with frame Dialog-Frame .
     3558      end.
     3559      else do:
     3560       enable
     3561       t-finalize-100
     3562       with frame Dialog-Frame .
     3563      end.
     3564      if p-start > 200 then do:
     3565       disable
     3566       t-finalize-200
     3567       with frame Dialog-Frame .
     3568      end.
     3569      else do:
     3570       enable
     3571       t-finalize-200
     3572       with frame Dialog-Frame .
     3573      end.
     3574      disable
     3575      br-template
     3576      btn-add
     3577      btn-del
     3578      btn-update-main
     3579      btn-update
     3580   WITH FRAME Dialog-Frame.
     3581   END.
     3582   APPLY "VALUE-CHANGED" to rs-end.
     3583   END PROCEDURE.
     3584   PROCEDURE proc-value-changed :
     3585   DEFINE VARIABLE ii as integer no-undo.
     3586   DEFINE VARIABLE v-str as character no-undo.
     3587   DEFINE BUFFER buf_temp-schedule-attr FOR temp-schedule-attr.
     3588   Kl = integer(entry(2, temp-schedule-attr.attr-code, chr(4))).
     3589   assign
     3590     f-shift-date :screen-value IN FRAME Dialog-Frame = ""
     3591     f-shift-num :screen-value IN FRAME Dialog-Frame = ""
     3592     f-shift-name :screen-value IN FRAME Dialog-Frame = ""
     3593     ED-FILTER:screen-value = "".
     3594   assign
     3595   ED-FILTER.
     3596   ASSIGN
     3597   f-shift-date = ENTRY(1, (entry(2, temp-schedule-attr.attr-value, chr(4))))
     3598   f-shift-num = ENTRY(2, (entry(2, temp-schedule-attr.attr-value, chr(4)))).
     3599   if num-entries(entry(2, temp-schedule-attr.attr-value, chr(4))) > 2 then do:
     3600     f-shift-name = ENTRY(3, (entry(2, temp-schedule-attr.attr-value, chr(4)))).
     3601   end.
     3602   FIND FIRST buf_temp-schedule-attr NO-LOCK WHERE
     3603           buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3604     AND   buf_temp-schedule-attr.task-type = p-task-type
     3605     AND   buf_temp-schedule-attr.task-num = p-task-num
     3606     AND   buf_temp-schedule-attr.attr-code = ('schedule-filter':U + chr(4) + STRING(kl)) NO-ERROR.
     3607   IF AVAILABLE buf_temp-schedule-attr THEN DO:
     3608     ASSIGN
     3609     v-str = entry(2, buf_temp-schedule-attr.attr-value, chr(4)).
     3610     DO ii = 1 TO NUM-ENTRIES(v-str):
     3611         MethodReturn = ED-FILTER:insert-string(entry(ii, v-str) + chr(10)).
     3612         assign ED-FILTER.
     3613     END.
     3614   END.
     3615   IDENT = RECID(temp-schedule-attr).
     3616   DISPLAY
     3617   f-shift-date
     3618   f-shift-num
     3619   f-shift-name
     3620   ED-FILTER
     3621   WITH FRAME Dialog-Frame.
     3622   END PROCEDURE.
     3623   PROCEDURE save-table :
     3624   DEFINE VARIABLE v-deleted AS LOGICAL NO-UNDO.
     3625   DEFINE BUFFER buf_temp-schedule-attr FOR temp-schedule-attr.
     3626   DEFINE BUFFER buf_schedule-attr FOR ub.schedule-attr.
     3627   do ON ERROR UNDO, RETURN ERROR RETURN-VALUE:
     3628   FOR EACH buf_temp-schedule-attr :
     3629       RUN  schedule-attr-write  IN THIS-PROCEDURE(
     3630                                                        input buf_temp-schedule-attr.cre-db-num
     3631                                                       ,input buf_temp-schedule-attr.task-type
     3632                                                       ,input buf_temp-schedule-attr.task-num
     3633                                                       ,input buf_temp-schedule-attr.attr-code
     3634                                                       ,input buf_temp-schedule-attr.attr-value).
     3635   END.
     3636   FOR EACH buf_schedule-attr NO-LOCK where
     3637           buf_schedule-attr.task-type = p-task-type
     3638       and buf_schedule-attr.cre-db-num = p-cre-db-num
     3639       and buf_schedule-attr.task-num = p-task-num:
     3640     IF buf_schedule-attr.attr-code BEGINS ('schedule-date-list':U + chr(4))
     3641     or buf_schedule-attr.attr-code BEGINS ('schedule-filter':U  + chr(4)) THEN DO:
     3642       FIND FIRST buf_temp-schedule-attr NO-LOCK WHERE
     3643                 buf_temp-schedule-attr.cre-db-num = buf_schedule-attr.cre-db-num
     3644           and   buf_temp-schedule-attr.task-type = buf_schedule-attr.task-type
     3645           and   buf_temp-schedule-attr.task-num = buf_schedule-attr.task-num
     3646            and   buf_temp-schedule-attr.attr-code = buf_schedule-attr.ATTR-code NO-ERROR.
     3647       IF NOT AVAILABLE buf_temp-schedule-attr  THEN DO:
     3648           RUN  schedule-attr-delete  IN THIS-PROCEDURE(
     3649                                                            input buf_schedule-attr.cre-db-num
     3650                                                           ,input buf_schedule-attr.task-type
     3651                                                           ,input buf_schedule-attr.task-num
     3652                                                           ,input buf_schedule-attr.attr-code
     3653                                                           ,output v-deleted).
     3654          IF NOT v-deleted THEN UNDO, RETURN ERROR.
     3655       END.
     3656     end.
     3657   END.
     3658   END.
     3659   END PROCEDURE.
     3660   PROCEDURE select-objects-only-this-db :
     3661   do
     3662   on error undo, return error
     3663   :
     3664   define output parameter p-only-this-db-obj-list as character    no-undo.
     3665   define output parameter p-exclude-obj-list      as character    no-undo.
     3666     define variable v-db-num                as integer       no-undo.
     3667     define variable v-obj-type              as character     no-undo.
     3668     define variable v-obj-code              as integer       no-undo.
     3669     define buffer buf_clients       for ub.clients.
     3670     define buffer buf_temp_obj-list for temp_obj-list.
     3671     define buffer buf_schedule for ub.schedule.
     3672     assign
     3673         p-only-this-db-obj-list = ""
     3674         p-exclude-obj-list      = ""
     3675     .
     3676     if p-task-num > 0 then do:
     3677       find first buf_schedule no-lock where
     3678                 buf_schedule.cre-db-num = p-cre-db-num
     3679             and buf_schedule.task-type = p-task-type
     3680             and buf_schedule.task-num = p-task-num no-error.
     3681       if not available buf_schedule then do:
     3682          undo, return error .
     3683       end.
     3684       assign
     3685       v-db-num = ( if buf_schedule.db-num-char = "*" then -10 else integer( buf_schedule.db-num-char ) )
     3686       .
     3687     end.
     3688     else do:
     3689       v-db-num = v-cntxt-db-num.
     3690     end.
     3691       for each buf_temp_obj-list:
     3692           find first buf_clients no-lock
     3693                   where buf_clients.obj-type = buf_temp_obj-list.obj-type
     3694                   and buf_clients.obj-code = buf_temp_obj-list.obj-code
     3695           .
     3696           if v-db-num = -10
     3697           or buf_clients.db-num = v-db-num
     3698           then do:
     3699               assign
     3700                   p-only-this-db-obj-list = p-only-this-db-obj-list
     3701                                           + ( if p-only-this-db-obj-list <> "" then ", " else "" )
     3702                                           + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3703               .
     3704           end.
     3705           else do:
     3706               assign
     3707                   p-exclude-obj-list = p-exclude-obj-list
     3708                                           + ( if p-exclude-obj-list <> "" then ", " else "" )
     3709                                           + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3710               .
     3711               delete buf_temp_obj-list.
     3712           end.
     3713       end.
     3714   end.
     3715   END PROCEDURE.
     3716   PROCEDURE temp-schedule-attr-delete :
     3717   do
     3718   on error undo, return error
     3719   :
     3720   define input parameter p-cre-db-num    as integer    no-undo .
     3721   define input parameter p-task-type     as character  no-undo.
     3722   define input parameter p-task-num      as integer    no-undo.
     3723   define input parameter p-code          as character  no-undo.
     3724   define output parameter p-deleted      as logical    no-undo.
     3725       define buffer buf_temp-schedule-attr for temp-schedule-attr .
     3726       define variable v-type              as character                no-undo.
     3727       define variable v-format            as character                no-undo.
     3728       define variable v-label             as character                no-undo.
     3729       define variable v-user-can-edit     as logical                  no-undo.
     3730       define variable v-output-display    as logical                  no-undo.
     3731       define variable v-other             as character                no-undo.
     3732       run schedule-attr-name in this-procedure (
     3733             input p-code
     3734           , output v-type
     3735           , output v-format
     3736           , output v-label
     3737           , output v-user-can-edit
     3738           , output v-output-display
     3739           , output v-other
     3740       ) no-error .
     3741       if error-status :error
     3742       then do:
     3743           undo, return error return-value .
     3744       end.
     3745       find first buf_temp-schedule-attr exclusive-lock
     3746            where buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3747              and buf_temp-schedule-attr.task-type  = p-task-type
     3748              and buf_temp-schedule-attr.task-num   = p-task-num
     3749              and buf_temp-schedule-attr.attr-code  = p-code
     3750       no-error.
     3751       if not available buf_temp-schedule-attr
     3752       then do:
     3753           assign
     3754               p-deleted = no
     3755           .
     3756       end.
     3757       else do:
     3758           delete buf_temp-schedule-attr.
     3759           assign
     3760               p-deleted = yes
     3761           .
     3762       end.
     3763   end.
     3764   END PROCEDURE.
     3765   PROCEDURE temp-schedule-attr-write :
     3766   do
     3767   on error undo, return error
     3768   :
     3769   define input parameter p-cre-db-num as integer   no-undo .
     3770   define input parameter p-task-type  as character no-undo.
     3771   define input parameter p-task-num   as integer   no-undo.
     3772   define input parameter p-code       as character no-undo.
     3773   define input parameter p-value      as character no-undo.
     3774       define variable v-type              as character                no-undo.
     3775       define variable v-format            as character                no-undo.
     3776       define variable v-label             as character                no-undo.
     3777       define variable v-user-can-edit     as logical                  no-undo.
     3778       define variable v-output-display    as logical                  no-undo.
     3779       define variable v-other             as character                no-undo.
     3780       define buffer buf_temp-schedule-attr for temp-schedule-attr .
     3781       run schedule-attr-name in this-procedure (
     3782             input  p-code
     3783           , output v-type
     3784           , output v-format
     3785           , output v-label
     3786           , output v-user-can-edit
     3787           , output v-output-display
     3788           , output v-other
     3789       ) no-error.
     3790       if error-status :error
     3791       then do:
     3792           undo, return error return-value.
     3793       end.
     3794       find first buf_temp-schedule-attr exclusive-lock
     3795            where buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3796              and buf_temp-schedule-attr.task-type  = p-task-type
     3797              and buf_temp-schedule-attr.task-num   = p-task-num
     3798              and buf_temp-schedule-attr.attr-code  = p-code
     3799       no-error.
     3800       if not available buf_temp-schedule-attr
     3801       then do:
     3802           create buf_temp-schedule-attr.
     3803           assign
     3804                   buf_temp-schedule-attr.cre-db-num = p-cre-db-num
     3805                   buf_temp-schedule-attr.task-type  = p-task-type
     3806                   buf_temp-schedule-attr.task-num   = p-task-num
     3807                   buf_temp-schedule-attr.attr-code  = p-code
     3808                   buf_temp-schedule-attr.attr-value = p-value
     3809           .
     3810       end.
     3811       else do:
     3812           assign
     3813               buf_temp-schedule-attr.attr-value = p-value
     3814           .
     3815       end.
     3816   end.
     3817   END PROCEDURE.
     3818   FUNCTION octal-to-char RETURNS CHARACTER
     3819   ( p-string as character ) :
     3820     def var v-asc     as integer no-undo .
     3821     def var v-new-asc as integer no-undo .
     3822     def var ind       as integer no-undo .
     3823     if length(p-string) <> 3 then do:
     3824       return ? .
     3825     end.
     3826     assign
     3827       v-asc = 0
     3828     .
     3829     do ind = 1 to length(p-string)
     3830     :
     3831       assign
     3832         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     3833       .
     3834       if v-new-asc < 0 or v-new-asc >= 8 then do:
     3835         return ? .
     3836       end.
     3837       assign
     3838         v-asc = v-asc * 8 + v-new-asc
     3839       .
     3840     end.
     3841     return chr(v-asc) .
     3842   end function .
