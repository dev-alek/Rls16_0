      508     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      509     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      510     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      511     define variable v-cntxp-db-num          as integer   no-undo .
      512     define variable v-cntxp-userid          as character no-undo .
      513     define variable v-cntxp-level           as character no-undo .
      514     define variable v-cntxp-db-num-obj      as integer   no-undo .
      515     define variable v-cntxp-is-admin        as logical   no-undo .
      516     define buffer bf-cntxp_store for ub.store.
      517     define buffer bf-cntxp_shop  for ub.shop.
      518     define buffer bf-cntxp_sysconf for ub.sysconf.
      519   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      521   procedure fltopend_fltopend :
      522   define input parameter p-parent-handle as handle no-undo .
      523   define input parameter p-qh as handle no-undo .
      524   define input parameter p-flt-open-open-query  as character no-undo .
      525   define input parameter p-where-cond as character no-undo .
      526   define input parameter p-use-indFIRST-query-tail as character no-undo .
      527   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      528   define input parameter p-indexed-reposition as character no-undo .
      529     do
      530     on error undo, return error
      531     :
      532   define variable v-prepare-string as character no-undo .
      533   define variable glog as logical no-undo .
      534   assign
      535   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      536                      p-where-cond + chr(32)  +
      537                      p-use-indFIRST-query-tail + chr(32) +
      538                      p-use-ind-sort-clmn-by + chr(32) +
      539                      p-indexed-reposition
      540   .
      541   assign
      542   glog = p-qh:query-prepare(v-prepare-string) no-error .
      543   if not glog
      544   or error-status:error then do:
      545     message error-status:get-message(1) view-as alert-box .
      546     undo, return error .
      547   end.
      548   assign
      549   glog = p-qh:query-open no-error .
      550   if not glog
      551   or error-status:error then do:
      552     message error-status:get-message(1) view-as alert-box .
      553     undo, return error .
      554   end.
      555     end.
      556   end procedure.
      557   procedure fltopend_fltfindd :
      558   define input parameter p-parent-handle as handle no-undo .
      559   define input parameter p-qh as handle no-undo .
      560   define input parameter p-rowid as rowid no-undo .
      561   define input parameter p-next as logical no-undo .
      562   define input parameter p-lock as integer no-undo .
      563   define input parameter p-bh as handle no-undo .
      564   define input parameter p-where-cond as character no-undo .
      565   define input parameter p-use-index-phrase as character no-undo .
      566   define variable glog as logical no-undo .
      567   define variable v-qh as handle no-undo .
      568   define variable v-bh as handle no-undo .
      569   define variable v-recid as recid no-undo .
      570   define variable v-prepare-string as character no-undo .
      571   do
      572   on error undo, return error
      573   on stop undo, return error
      574   :
      575     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      576     create buffer v-bh for table p-bh buffer-name p-bh:name.
      577     create query v-qh.
      578     v-qh:set-buffers(v-bh).
      579     v-prepare-string = substitute("for each &1 &2 &3"
      580                                     ,v-bh:name
      581                                     ,p-where-cond
      582                                     ,p-use-index-phrase).
      583     glog = v-qh:query-prepare(v-prepare-string) no-error.
      584     if not glog then do:
      585       delete object v-qh.
      586       delete object v-bh.
      587       undo, return error .
      588     end.
      589     glog = v-qh:query-open no-error .
      590     if not glog then do:
      591       delete object v-qh.
      592       delete object v-bh.
      593       undo, return error .
      594     end.
      595     if p-next then do:
      596       v-qh:reposition-to-rowid(p-rowid) no-error .
      597       glog = v-qh:get-next( p-lock) no-error .
      598       glog = v-qh:get-next( p-lock) no-error .
      599       if not glog or v-qh:query-off-end = yes then do:
      600         glog = v-qh:get-first( p-lock) no-error .
      601       end.
      602     end.
      603     else do:
      604       glog = v-qh:get-first( p-lock) no-error .
      605     end.
      606     v-recid = v-bh:recid no-error .
      607     delete object v-qh.
      608     delete object v-bh.
      609     return string(v-recid) .
      610   end.
      611   end procedure.
      612   procedure fltopend_fltfindq :
      613   define input parameter p-parent-handle as handle no-undo .
      614   define input parameter p-qh as handle no-undo .
      615   define input parameter p-next as logical no-undo .
      616   define input parameter p-lock as integer no-undo .
      617   define input parameter p-flt-open-open-query  as character no-undo .
      618   define input parameter p-where-cond as character no-undo .
      619   define input parameter p-use-indFIRST-query-tail as character no-undo .
      620   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      621   define input parameter p-indexed-reposition as character no-undo .
      622   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      623   define variable glog as logical no-undo .
      624   define variable v-qh as handle no-undo .
      625   define variable v-bh as handle no-undo extent 18.
      626   define variable v-rowid as rowid no-undo extent 18.
      627   define variable v-ii as integer no-undo .
      628   define variable v-prepare-string as character no-undo .
      629   do
      630   on error undo, return error
      631   on stop undo, return error
      632   :
      633     create query v-qh.
      634     do v-ii = 1 to p-qh:num-buffers:
      635       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      636       assign
      637       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      638       no-error.
      639       v-qh:add-buffer(v-bh[v-ii]).
      640     end.
      641     assign
      642     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      643                       p-where-cond + chr(32)  +
      644                       p-use-indFIRST-query-tail + chr(32) +
      645                       p-use-ind-sort-clmn-by + chr(32) +
      646                       p-indexed-reposition
      647     .
      648     glog = v-qh:query-prepare( v-prepare-string) no-error .
      649     if not glog then do:
      650       delete object v-qh.
      651       do v-ii = 1 to p-qh:num-buffers:
      652         delete object v-bh[v-ii].
      653       end.
      654       undo, return error .
      655     end.
      656     glog = v-qh:query-open no-error .
      657     if not glog then do:
      658       delete object v-qh.
      659       do v-ii = 1 to p-qh:num-buffers:
      660         delete object v-bh[v-ii].
      661       end.
      662       undo, return error .
      663     end.
      664     if p-next then do:
      665       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      666       glog = v-qh:get-next( p-lock) no-error .
      667       glog = v-qh:get-next( p-lock) no-error .
      668       if not glog or v-qh:query-off-end = yes then do:
      669         glog = v-qh:get-first( p-lock) no-error .
      670       end.
      671     end.
      672     else do:
      673       glog = v-qh:get-first( p-lock) no-error .
      674     end.
      675     do v-ii = 1 to p-qh:num-buffers:
      676       assign
      677       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      678       no-error.
      679     end.
      680     delete object v-qh.
      681     do v-ii = 1 to p-qh:num-buffers:
      682       delete object v-bh[v-ii].
      683     end.
      684   end.
      685   end procedure.
      686   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   function octal-to-char return character
      688   ( p-string as character ) :
      689     def var v-asc     as integer no-undo .
      690     def var v-new-asc as integer no-undo .
      691     def var ind       as integer no-undo .
      692     if length(p-string) <> 3 then do:
      693       return ? .
      694     end.
      695     assign
      696       v-asc = 0
      697     .
      698     do ind = 1 to length(p-string)
      699     :
      700       assign
      701         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      702       .
      703       if v-new-asc < 0 or v-new-asc >= 8 then do:
      704         return ? .
      705       end.
      706       assign
      707         v-asc = v-asc * 8 + v-new-asc
      708       .
      709     end.
      710     return chr(v-asc) .
      711   end function .
      712   function char-to-octal return character
      713   ( p-chr as character ) :
      714     def var v-asc    as integer   no-undo .
      715     def var ind      as integer   no-undo .
      716     def var v-string as character no-undo .
      717     if length(p-chr) <> 1 then do:
      718       return ? .
      719     end.
      720     assign
      721       v-asc    = asc(p-chr)
      722       v-string = ""
      723     .
      724     do ind = 1 to 3
      725     :
      726       assign
      727         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      728       .
      729       assign
      730         v-asc = truncate(v-asc / 8, 0)
      731       .
      732     end.
      733     return v-string .
      734   end.
      735   function str-encode return character
      736   (   p-init-string       as character
      737     , p-encode-char       as character
      738     , p-special-char-list as character
      739   ) :
      740     def var p-encode-string as character no-undo .
      741     def var ind                as integer no-undo .
      742     def var v-num-special-char as integer no-undo .
      743     def var v-special-char     as character no-undo .
      744     if p-encode-char = ?
      745     or p-encode-char = "" then do:
      746       assign
      747         p-encode-char = "~~"
      748       .
      749     end.
      750     if p-init-string = ? then do:
      751       return "?" .
      752     end.
      753     if p-init-string = "?" then do:
      754       return p-encode-char + char-to-octal("?") .
      755     end.
      756     assign
      757       v-num-special-char = length(p-special-char-list)
      758       p-encode-string    = replace(p-init-string
      759                                   ,p-encode-char
      760                                   ,p-encode-char + char-to-octal(p-encode-char)
      761                                   )
      762     .
      763     do ind = 1 to v-num-special-char
      764     :
      765       assign
      766         v-special-char = substring(p-special-char-list, ind, 1)
      767       .
      768       if v-special-char <> p-encode-char then do:
      769         assign
      770           p-encode-string = replace (p-encode-string
      771                                     ,v-special-char
      772                                     ,p-encode-char + char-to-octal(v-special-char)
      773                                     )
      774         .
      775       end.
      776     end.
      777     return p-encode-string .
      778   end.
      779   function str-decode returns character
      780     (p-init-string   as character
      781     ,p-encode-char   as character
      782     ) :
      783     def var p-decode-string as character no-undo .
      784     def var ind                       as integer no-undo .
      785     def var v-num-entries-init-string as integer no-undo .
      786     def var v-sub-phrase              as character no-undo .
      787     def var v-special-char            as character no-undo .
      788     if p-encode-char = ?
      789     or p-encode-char = "" then do:
      790       assign
      791         p-encode-char = "~~"
      792       .
      793     end.
      794     if p-init-string = "?" then do:
      795       return ? .
      796     end.
      797     assign
      798       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      799     .
      800     if v-num-entries-init-string > 1 then do:
      801       assign
      802         p-decode-string = entry(1, p-init-string, p-encode-char)
      803       .
      804       do ind = 2 to v-num-entries-init-string
      805       :
      806         assign
      807           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      808         .
      809         assign
      810           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      811         .
      812         if v-special-char <> ? then do:
      813           assign
      814             p-decode-string = p-decode-string
      815                             + v-special-char
      816                             + substring(v-sub-phrase, 4)
      817           .
      818         end.
      819         else do:
      820           assign
      821             p-decode-string = p-decode-string
      822                             + p-encode-char
      823                             + v-sub-phrase
      824           .
      825         end.
      826       end.
      827     end.
      828     else do:
      829       assign
      830         p-decode-string = p-init-string
      831       .
      832     end.
      833     return p-decode-string .
      834   end.
