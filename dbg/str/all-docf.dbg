     5490                                               output table gds-list) no-error.
     5491                                br-docs:refresh() in frame d-all-docs.
     5492                               if error-status:error then do:
     5493                                 message
     5494                                   vss-workfile vss-revision vss-description skip
     5495                                   "Ошибка при закрытии документа " t-doc.doc-code skip
     5496                                   return-value skip
     5497                                   trim(error-status :get-message(1)) skip
     5498                                   view-as alert-box error.
     5499                                 find t-doc where recid (t-doc) = doc-rec no-lock.
     5500                                 return error.
     5501                               end.
     5502                       end.
     5503                       if t-doc.status_ = 'разрешен':U then do:
     5504                               run str/trn-stat.p (input parParentProc,
     5505                               input this-procedure ,
     5506                                               input  '<закрытие документа>':U,
     5507                                               input  t-doc.doc-code,
     5508                                               input  varcheck-return,
     5509                                               input  v-cntxt-db-num,
     5510                                               input  v-cntxp-in-ov,
     5511                                               input  v-cntxp-rsrv-time,
     5512                                               input  v-cntxp-load-time,
     5513                                               input  v-cntxp-holidays,
     5514                                               input  yes,
     5515                                               output varchg-inv,
     5516                                               output table gds-list) no-error.
     5517                                br-docs:refresh() in frame d-all-docs.
     5518                               if error-status:error then do:
     5519                                 message
     5520                                   vss-workfile vss-revision vss-description skip
     5521                                   "Ошибка при закрытии документа " t-doc.doc-code skip
     5522                                   return-value skip
     5523                                   trim(error-status :get-message(1)) skip
     5524                                   view-as alert-box error.
     5525                                 find t-doc where recid (t-doc) = doc-rec no-lock.
     5526                                 return error.
