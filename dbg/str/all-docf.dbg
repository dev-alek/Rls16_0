     2219   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220   procedure minbtn-set :
     2221       do
     2222           on error undo, return error return-value
     2223           :
     2224           define variable ii              as integer       no-undo .
     2225           define variable fh              as widget-handle no-undo .
     2226           define variable hh              as widget-handle no-undo .
     2227           define variable v-h             as handle        extent 4 no-undo .
     2228           define variable v-name-button   as character     no-undo .
     2229           define variable v-help-old-x    as decimal       no-undo .
     2230           define variable v-help-old-y    as decimal       no-undo .
     2231           define variable v-help-old-size as decimal       no-undo .
     2232           define variable v-frame-width   as decimal       no-undo .
     2233           define variable jj              as integer       no-undo .
     2234           do
     2235               on error undo, return error
     2236               :
     2237               assign
     2238                   v-frame-width = frame d-all-docs:width - 0.3
     2239                   fh            = frame d-all-docs:first-child
     2240                   hh            = fh:first-child
     2241                   ii            = 1
     2242                   .
     2243               do while valid-handle(hh):
     2244                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2245                   do:
     2246                       case lc(hh:name) :
     2247                           when "b-help" then
     2248                               do:
     2249                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2250                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2251                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2252                                   hh:TOOLTIP = "Помощь" .
     2253                                   v-help-old-x = hh:column .
     2254                                   v-help-old-y = hh:row    .
     2255                                   v-help-old-size = hh:width .
     2256                                   hh:width-chars = 2.5 .
     2257                               end.
     2258                           when "b-print" then
     2259                               do:
     2260                                   hh:load-image("cmp/b-print.bmp":u) .
     2261                                   hh:TOOLTIP = "Печать" .
     2262                                   v-h[ii] = hh:handle .
     2263                                   ii = ii + 1 .
     2264                                   hh:width-chars = 3 .
     2265                               end.
     2266                           when "b-history" or
     2267                           when "b-hist" then
     2268                               do:
     2269                                   hh:load-image("cmp/b-hist.bmp":u) .
     2270                                   hh:TOOLTIP = "История" .
     2271                                   v-h[ii] = hh:handle .
     2272                                   ii = ii + 1 .
     2273                                   hh:width-chars = 3 .
     2274                               end.
     2275                           when "b-sch" then
     2276                               do:
     2277                                   hh:load-image("cmp/b-sch.bmp":u) .
     2278                                   hh:TOOLTIP = "Установка Фильтра" .
     2279                                   v-h[ii] = hh:handle .
     2280                                   ii = ii + 1 .
     2281                                   hh:width-chars = 3 .
     2282                               end.
     2283                           when "b-hist-user" then
     2284                               do:
     2285                                   hh:load-image("cmp/b-hist.bmp":u) .
     2286                                   hh:TOOLTIP = "История пользователя" .
     2287                                   ii = ii + 1 .
     2288                               end.
     2289                       end case.
     2290                   end.
     2291                   hh = hh:next-sibling.
     2292               end.
     2293               b-help:column = v-frame-width - b-help:width-chars.
     2294               jj = 0.
     2295               repeat ii = 4 to 1 by -1 :
     2296                   if valid-handle (v-h[ii] ) then
     2297                   do:
     2298                       jj  = jj + 1 .
     2299                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2300                       v-h[ii]:row    = v-help-old-y .
     2301                   end.
     2302               end.
     2303           end.
     2304       end.
     2305   end procedure.
     2306   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2307   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2308   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2309   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2310   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2311   define variable v-diasize-current-frame-height as decimal   no-undo .
     2312   define variable v-diasize-change-size          as logical   no-undo .
     2313   define variable v-diasize-resize-button        as handle    no-undo .
     2314   define variable v-diasize-wndmax               as logical   no-undo .
     2315   define variable v-diasize-wndstore             as logical   no-undo .
     2316   define variable v-diasize-proc-name            as character no-undo .
     2317   define variable v-diasize-browse-handle        as handle    no-undo .
     2318   define variable v-diasize-browse-number        as integer   no-undo .
     2319   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2320   define temp-table temp-diasize-handle no-undo
     2321     field handle-value  as handle
     2322     field save-position as decimal
     2323     index xpk is primary unique handle-value
     2324     .
     2325   define temp-table temp-browse-handle no-undo
     2326     field browse-type   as character
     2327     field browse-number as integer
     2328     field browse-handle as handle
     2329     field original-size as decimal
     2330     index xpk is primary unique browse-type browse-number
     2331     index xie browse-type browse-handle
     2332   .
     2333   procedure diasize_change-height :
     2334     define input  parameter p-change-value  as decimal   no-undo .
     2335     define input  parameter p-move-resize   as logical   no-undo .
     2336     define variable v-field-group-handle    as handle    no-undo .
     2337     define variable v-object-handle         as handle    no-undo .
     2338     define variable v-frame-height          as decimal   no-undo .
     2339     define variable v-frame-virtual-height  as decimal   no-undo .
     2340     define variable v-browse-height         as decimal   no-undo .
     2341     define variable v-window-height         as decimal   no-undo .
     2342     define variable v-window-virtual-height as decimal   no-undo .
     2343     define variable v-change-sign           as integer   no-undo .
     2344     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2345     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2346     if p-change-value > 0
     2347     then do:
     2348       if frame d-all-docs :height + p-change-value
     2349           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2350       then do:
     2351         assign
     2352           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2353                           - (frame d-all-docs :height-chars)
     2354         .
     2355         if p-change-value <= 0
     2356         then do:
     2357           run diasize_position-resize-button in this-procedure .
     2358           return .
     2359         end.
     2360       end.
     2361     end.
     2362     if p-change-value < 0
     2363     then do:
     2364       if frame d-all-docs :height + p-change-value < v-diasize-orig-frame-height
     2365       then do:
     2366         assign
     2367           p-change-value = v-diasize-orig-frame-height
     2368                          - (frame d-all-docs :height-chars)
     2369         .
     2370         if p-change-value >= 0
     2371         then do:
     2372           run diasize_position-resize-button in this-procedure .
     2373           return .
     2374         end.
     2375       end.
     2376     end.
     2377     if p-change-value >= 0
     2378     then do:
     2379       assign
     2380         v-change-sign = 1
     2381       .
     2382     end.
     2383     else do:
     2384       assign
     2385         v-change-sign = -1
     2386       .
     2387     end.
     2388     assign
     2389       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2390     .
     2391     if p-change-value = 0
     2392     then do:
     2393       run diasize_position-resize-button in this-procedure .
     2394       return .
     2395     end.
     2396     move_block:
     2397     do
     2398     on error undo move_block, retry move_block
     2399     :
     2400       if retry
     2401       then do:
     2402         do
     2403         on error undo move_block, leave move_block
     2404         :
     2405           if p-change-value > 0
     2406           then do:
     2407             for each buf_temp-diasize-handle
     2408             on error undo, next
     2409             :
     2410               assign
     2411                 v-object-handle = buf_temp-diasize-handle.handle-value
     2412               .
     2413               if v-object-handle <> v-diasize-resize-button
     2414               then do:
     2415                 assign
     2416                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2417                 .
     2418               end.
     2419             end.
     2420             assign
     2421               v-diasize-browse-handle :height = v-browse-height
     2422             .
     2423             for each buf_temp-browse-handle
     2424               where buf_temp-browse-handle.browse-type = 'height':u
     2425             on error undo, next
     2426             :
     2427               assign
     2428                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2429               .
     2430             end.
     2431             assign
     2432               frame d-all-docs :height = v-frame-height
     2433             .
     2434             if frame d-all-docs :scrollable = true
     2435             then do:
     2436               assign
     2437                 frame d-all-docs :virtual-height = v-frame-virtual-height
     2438               .
     2439             end.
     2440             run diasize_position-resize-button in this-procedure .
     2441           end.
     2442           else do:
     2443             if frame d-all-docs :scrollable = true
     2444             then do:
     2445               assign
     2446                 frame d-all-docs :virtual-height = v-frame-virtual-height
     2447               .
     2448             end.
     2449             assign
     2450               frame d-all-docs :height = v-frame-height
     2451             .
     2452             assign
     2453               v-diasize-browse-handle :height = v-browse-height
     2454             .
     2455             for each buf_temp-browse-handle
     2456               where buf_temp-browse-handle.browse-type = 'height':u
     2457             on error undo, next
     2458             :
     2459               assign
     2460                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2461               .
     2462             end.
     2463             for each buf_temp-diasize-handle
     2464             on error undo, next
     2465             :
     2466               assign
     2467                 v-object-handle = buf_temp-diasize-handle.handle-value
     2468               .
     2469               if v-object-handle <> v-diasize-resize-button
     2470               then do:
     2471                 assign
     2472                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2473                 .
     2474               end.
     2475             end.
     2476             run diasize_position-resize-button in this-procedure .
     2477           end.
     2478           assign
     2479             v-diasize-change-size = false
     2480           .
     2481           leave move_block .
     2482         end.
     2483       end.
     2484       assign
     2485         v-diasize-need-full-display = true
     2486       .
     2487       if v-diasize-change-size = false
     2488       then do:
     2489         assign
     2490           v-diasize-change-size = true
     2491         .
     2492       end.
     2493       else do:
     2494         return .
     2495       end.
     2496       assign
     2497         v-frame-height = frame d-all-docs :height
     2498         v-frame-virtual-height = frame d-all-docs :virtual-height
     2499         v-browse-height = v-diasize-browse-handle :height
     2500       .
     2501       for each buf_temp-browse-handle
     2502         where buf_temp-browse-handle.browse-type = 'height':u
     2503       :
     2504         assign
     2505           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2506         .
     2507       end.
     2508       for each buf_temp-diasize-handle
     2509       :
     2510         delete buf_temp-diasize-handle .
     2511       end.
     2512       assign
     2513         v-field-group-handle = frame d-all-docs :first-child
     2514       .
     2515       do while valid-handle(v-field-group-handle)
     2516       :
     2517         assign
     2518           v-object-handle = v-field-group-handle :first-child
     2519         .
     2520         do while valid-handle(v-object-handle)
     2521         :
     2522           if  v-object-handle <> v-diasize-browse-handle :handle
     2523           and can-query(v-object-handle, "row")
     2524           and can-query(v-object-handle, "height")
     2525           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2526           then do:
     2527             find first buf_temp-browse-handle
     2528               where buf_temp-browse-handle.browse-type   = 'height':u
     2529                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2530               no-error .
     2531             if available buf_temp-browse-handle
     2532             then do:
     2533             end.
     2534             else do:
     2535               create buf_temp-diasize-handle .
     2536               assign
     2537                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2538                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2539               .
     2540             end.
     2541           end.
     2542           assign
     2543             v-object-handle = v-object-handle :next-sibling
     2544           .
     2545         end.
     2546         assign
     2547           v-field-group-handle = v-field-group-handle :next-sibling
     2548         .
     2549       end.
     2550       do with frame d-all-docs
     2551       :
     2552         hide v-diasize-resize-button .
     2553         assign
     2554           v-diasize-resize-button :row    = 1
     2555           v-diasize-resize-button :column = 1
     2556         .
     2557       end.
     2558       if p-change-value > 0
     2559       then do:
     2560         if frame d-all-docs :scrollable = true
     2561         then do:
     2562           assign
     2563             frame d-all-docs :virtual-height = frame d-all-docs :virtual-height + p-change-value
     2564             no-error .
     2565           if error-status :error
     2566           or error-status :get-message(1) <> ""
     2567           then do:
     2568             undo move_block, retry move_block .
     2569           end.
     2570         end.
     2571         assign
     2572           frame d-all-docs :height = frame d-all-docs :height + p-change-value
     2573           no-error .
     2574         if error-status :error
     2575         or error-status :get-message(1) <> ""
     2576         then do:
     2577           undo move_block, retry move_block .
     2578         end.
     2579         assign
     2580           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2581           no-error .
     2582         if error-status :error
     2583         or error-status :get-message(1) <> ""
     2584         then do:
     2585           undo move_block, retry move_block .
     2586         end.
     2587         for each buf_temp-browse-handle
     2588           where buf_temp-browse-handle.browse-type = 'height':u
     2589         on error undo move_block, retry move_block
     2590         :
     2591           assign
     2592             buf_temp-browse-handle.browse-handle :height
     2593               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2594             no-error .
     2595           if error-status :error
     2596           or error-status :get-message(1) <> ""
     2597           then do:
     2598             undo move_block, retry move_block .
     2599           end.
     2600         end.
     2601         for each buf_temp-diasize-handle
     2602         on error undo move_block, retry move_block
     2603         :
     2604           assign
     2605             v-object-handle = buf_temp-diasize-handle.handle-value
     2606           .
     2607           if v-object-handle <> v-diasize-resize-button
     2608           then do:
     2609             assign
     2610               v-object-handle :row = v-object-handle :row + p-change-value
     2611               no-error .
     2612             if error-status :error
     2613             or error-status :get-message(1) <> ""
     2614             then do:
     2615               undo move_block, retry move_block .
     2616             end.
     2617           end.
     2618         end.
     2619       end.
     2620       else do:
     2621         for each buf_temp-diasize-handle
     2622         on error undo move_block, retry move_block
     2623         :
     2624           assign
     2625             v-object-handle = buf_temp-diasize-handle.handle-value
     2626           .
     2627           if v-object-handle <> v-diasize-resize-button
     2628           then do:
     2629             assign
     2630               v-object-handle :row = v-object-handle :row + p-change-value
     2631               no-error .
     2632             if error-status :error
     2633             or error-status :get-message(1) <> ""
     2634             then do:
     2635               undo move_block, retry move_block .
     2636             end.
     2637           end.
     2638         end.
     2639         assign
     2640           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2641           no-error .
     2642         if error-status :error
     2643         or error-status :get-message(1) <> ""
     2644         then do:
     2645           undo move_block, retry move_block .
     2646         end.
     2647         for each buf_temp-browse-handle
     2648           where buf_temp-browse-handle.browse-type = 'height':u
     2649         on error undo move_block, retry move_block
     2650         :
     2651           assign
     2652             buf_temp-browse-handle.browse-handle :height
     2653               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2654             no-error .
     2655           if error-status :error
     2656           or error-status :get-message(1) <> ""
     2657           then do:
     2658             undo move_block, retry move_block .
     2659           end.
     2660         end.
     2661         assign
     2662           frame d-all-docs :height = frame d-all-docs :height + p-change-value
     2663           no-error .
     2664         if error-status :error
     2665         or error-status :get-message(1) <> ""
     2666         then do:
     2667           undo move_block, retry move_block .
     2668         end.
     2669         if frame d-all-docs :scrollable = true
     2670         then do:
     2671           assign
     2672             frame d-all-docs :virtual-height = frame d-all-docs :virtual-height + p-change-value
     2673             no-error .
     2674           if error-status :error
     2675           or error-status :get-message(1) <> ""
     2676           then do:
     2677             undo move_block, retry move_block .
     2678           end.
     2679         end.
     2680       end.
     2681       if p-move-resize = true
     2682       then do:
     2683         run diasize_position-resize-button in this-procedure .
     2684       end.
     2685       if v-diasize-wndstore = true
     2686       then do:
     2687         if connected("ub") = true
     2688         then do:
     2689           define variable v-cntxt-db-num        as integer   no-undo .
     2690           define variable v-cntxt-userid        as character no-undo .
     2691           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2692                                             , OUTPUT v-cntxt-userid
     2693                                             ) .
     2694           run gbl/wndsizew.p
     2695             (input  v-cntxt-db-num
     2696             ,input  v-cntxt-userid
     2697             ,input  v-diasize-proc-name
     2698             ,input  'height':u
     2699             ,input  string(frame d-all-docs :height - v-diasize-orig-frame-height)
     2700             ) .
     2701         end.
     2702       end.
     2703     end.
     2704     assign
     2705       v-diasize-change-size = false
     2706     .
     2707   end procedure.
     2708   procedure diasize_set-height :
     2709     define input  parameter p-new-height  as decimal   no-undo .
     2710     define input  parameter p-move-resize as logical   no-undo .
     2711     do
     2712     on error undo, return error return-value
     2713     :
     2714       run diasize_change-height in this-procedure
     2715         (input  (p-new-height - frame d-all-docs :height)
     2716         ,input  p-move-resize
     2717         ) .
     2718     end.
     2719   end procedure.
     2720   procedure diasize_change-width :
     2721     define input  parameter p-change-value as decimal   no-undo .
     2722     define input  parameter p-move-resize  as logical   no-undo .
     2723     define variable v-field-group-handle   as handle    no-undo .
     2724     define variable v-object-handle        as handle    no-undo .
     2725     define variable v-frame-width          as decimal   no-undo .
     2726     define variable v-frame-virtual-width  as decimal   no-undo .
     2727     define variable v-browse-width         as decimal   no-undo .
     2728     define variable v-window-width         as decimal   no-undo .
     2729     define variable v-window-virtual-width as decimal   no-undo .
     2730     define variable v-change-sign          as integer   no-undo .
     2731     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2732     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2733     if p-change-value > 0
     2734     then do:
     2735       if frame d-all-docs :width + p-change-value >
     2736           session :width-chars
     2737       then do:
     2738         assign
     2739           p-change-value = session :width-chars - frame d-all-docs :width
     2740         .
     2741         if p-change-value <= 0
     2742         then do:
     2743           run diasize_position-resize-button in this-procedure .
     2744           return .
     2745         end.
     2746       end.
     2747     end.
     2748     if p-change-value < 0
     2749     then do:
     2750       if frame d-all-docs :width + p-change-value < v-diasize-orig-frame-width
     2751       then do:
     2752         assign
     2753           p-change-value = v-diasize-orig-frame-width
     2754                          - frame d-all-docs :width
     2755         .
     2756         if p-change-value >= 0
     2757         then do:
     2758           run diasize_position-resize-button in this-procedure .
     2759           return .
     2760         end.
     2761       end.
     2762     end.
     2763     if p-change-value >= 0
     2764     then do:
     2765       assign
     2766         v-change-sign = 1
     2767       .
     2768     end.
     2769     else do:
     2770       assign
     2771         v-change-sign = -1
     2772       .
     2773     end.
     2774     assign
     2775       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2776     .
     2777     if p-change-value = 0
     2778     then do:
     2779       run diasize_position-resize-button in this-procedure .
     2780       return .
     2781     end.
     2782     move_block:
     2783     do
     2784     on error undo move_block, leave move_block
     2785     :
     2786       if retry
     2787       then do:
     2788         do
     2789         on error undo move_block, leave move_block
     2790         :
     2791           if p-change-value > 0
     2792           then do:
     2793             for each buf_temp-diasize-handle
     2794             on error undo, next
     2795             :
     2796               assign
     2797                 v-object-handle = buf_temp-diasize-handle.handle-value
     2798               .
     2799               if v-object-handle <> v-diasize-resize-button
     2800               then do:
     2801                 assign
     2802                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2803                 .
     2804               end.
     2805             end.
     2806             assign
     2807               v-diasize-browse-handle :width = v-browse-width
     2808             .
     2809             for each buf_temp-browse-handle
     2810               where buf_temp-browse-handle.browse-type = 'width':u
     2811             on error undo, next
     2812             :
     2813               assign
     2814                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2815               .
     2816             end.
     2817             assign
     2818               frame d-all-docs :width = v-frame-width
     2819             .
     2820             if frame d-all-docs :scrollable = true
     2821             then do:
     2822               assign
     2823                 frame d-all-docs :virtual-width = v-frame-virtual-width
     2824               .
     2825             end.
     2826             run diasize_position-resize-button in this-procedure .
     2827           end.
     2828           else do:
     2829             if frame d-all-docs :scrollable = true
     2830             then do:
     2831               assign
     2832                 frame d-all-docs :virtual-width = v-frame-virtual-width
     2833               .
     2834             end.
     2835             assign
     2836               frame d-all-docs :width = v-frame-width
     2837             .
     2838             for each buf_temp-browse-handle
     2839               where buf_temp-browse-handle.browse-type = 'width':u
     2840             on error undo, next
     2841             :
     2842               assign
     2843                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2844               .
     2845             end.
     2846             assign
     2847               v-diasize-browse-handle :width = v-browse-width
     2848             .
     2849             for each buf_temp-diasize-handle
     2850             on error undo, next
     2851             :
     2852               assign
     2853                 v-object-handle = buf_temp-diasize-handle.handle-value
     2854               .
     2855               if v-object-handle <> v-diasize-resize-button
     2856               then do:
     2857                 assign
     2858                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2859                 .
     2860               end.
     2861             end.
     2862             run diasize_position-resize-button in this-procedure .
     2863           end.
     2864           assign
     2865             v-diasize-change-size = false
     2866           .
     2867           leave move_block .
     2868         end.
     2869       end.
     2870       assign
     2871         v-diasize-need-full-display = true
     2872       .
     2873       if v-diasize-change-size = false
     2874       then do:
     2875         assign
     2876           v-diasize-change-size = true
     2877         .
     2878       end.
     2879       else do:
     2880         return .
     2881       end.
     2882       assign
     2883         v-frame-width = frame d-all-docs :width
     2884         v-frame-virtual-width = frame d-all-docs :virtual-width
     2885         v-browse-width = v-diasize-browse-handle :width
     2886       .
     2887       for each buf_temp-browse-handle
     2888         where buf_temp-browse-handle.browse-type = 'width':u
     2889       :
     2890         assign
     2891           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2892         .
     2893       end.
     2894       for each buf_temp-diasize-handle
     2895       :
     2896         delete buf_temp-diasize-handle .
     2897       end.
     2898       assign
     2899         v-field-group-handle = frame d-all-docs :first-child
     2900       .
     2901       do while valid-handle(v-field-group-handle)
     2902       :
     2903         assign
     2904           v-object-handle = v-field-group-handle :first-child
     2905         .
     2906         do while valid-handle(v-object-handle)
     2907         :
     2908           if  v-object-handle <> v-diasize-browse-handle :handle
     2909           and v-object-handle <> v-diasize-resize-button
     2910           and can-query(v-object-handle, "row")
     2911           and can-query(v-object-handle, "height")
     2912           and ( v-object-handle :col + v-object-handle :width
     2913                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2914               )
     2915           then do:
     2916             find first buf_temp-browse-handle
     2917               where buf_temp-browse-handle.browse-type   = 'width':u
     2918                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2919               no-error .
     2920             if available buf_temp-browse-handle
     2921             then do:
     2922             end.
     2923             else do:
     2924               create buf_temp-diasize-handle .
     2925               assign
     2926                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2927                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2928               .
     2929             end.
     2930           end.
     2931           assign
     2932             v-object-handle = v-object-handle :next-sibling
     2933           .
     2934         end.
     2935         assign
     2936           v-field-group-handle = v-field-group-handle :next-sibling
     2937         .
     2938       end.
     2939       do with frame d-all-docs
     2940       :
     2941         hide v-diasize-resize-button .
     2942         v-diasize-resize-button :row = 1.
     2943         v-diasize-resize-button :column = 1.
     2944       end.
     2945       if p-change-value > 0
     2946       then do:
     2947         if frame d-all-docs :scrollable = true
     2948         then do:
     2949           assign
     2950             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     2951             no-error .
     2952           if error-status :error
     2953           or error-status :get-message(1) <> ""
     2954           then do:
     2955             undo move_block, retry move_block.
     2956           end.
     2957         end.
     2958         assign
     2959           frame d-all-docs :width = v-frame-width + p-change-value
     2960           no-error .
     2961         if error-status :error
     2962         or error-status :get-message(1) <> ""
     2963         then do:
     2964           undo move_block, retry move_block.
     2965         end.
     2966         assign
     2967           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2968         no-error .
     2969         if error-status :error
     2970         or error-status :get-message(1) <> ""
     2971         then do:
     2972           undo move_block, retry move_block.
     2973         end.
     2974         for each buf_temp-browse-handle
     2975           where buf_temp-browse-handle.browse-type = 'width':u
     2976         on error undo move_block, retry move_block
     2977         :
     2978           assign
     2979             buf_temp-browse-handle.browse-handle :width
     2980               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2981             no-error .
     2982           if error-status :error
     2983           or error-status :get-message(1) <> ""
     2984           then do:
     2985             undo move_block, retry move_block .
     2986           end.
     2987         end.
     2988         for each buf_temp-diasize-handle
     2989         on error undo move_block, retry move_block
     2990         :
     2991           assign
     2992             v-object-handle = buf_temp-diasize-handle.handle-value
     2993           .
     2994           if v-object-handle <> v-diasize-resize-button
     2995           then do:
     2996             assign
     2997               v-object-handle :col = v-object-handle :col + p-change-value
     2998               no-error .
     2999             if error-status :error
     3000             or error-status :get-message(1) <> ""
     3001             then do:
     3002               undo move_block, retry move_block .
     3003             end.
     3004           end.
     3005         end.
     3006       end.
     3007       else do:
     3008         for each buf_temp-diasize-handle
     3009         on error undo move_block, retry move_block
     3010         :
     3011           assign
     3012             v-object-handle = buf_temp-diasize-handle.handle-value
     3013           .
     3014           if v-object-handle <> v-diasize-resize-button
     3015           then do:
     3016             assign
     3017               v-object-handle :col = v-object-handle :col + p-change-value
     3018               no-error .
     3019             if error-status :error
     3020             or error-status :get-message(1) <> ""
     3021             then do:
     3022               undo move_block, retry move_block .
     3023             end.
     3024           end.
     3025         end.
     3026         for each buf_temp-browse-handle
     3027           where buf_temp-browse-handle.browse-type = 'width':u
     3028         on error undo move_block, retry move_block
     3029         :
     3030           assign
     3031             buf_temp-browse-handle.browse-handle :width
     3032               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3033             no-error .
     3034           if error-status :error
     3035           or error-status :get-message(1) <> ""
     3036           then do:
     3037             undo move_block, retry move_block .
     3038           end.
     3039         end.
     3040         assign
     3041           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3042           no-error .
     3043         if error-status :error
     3044         or error-status :get-message(1) <> ""
     3045         then do:
     3046           undo move_block, retry move_block.
     3047         end.
     3048         assign
     3049           frame d-all-docs :width = frame d-all-docs :width + p-change-value
     3050         no-error .
     3051         if error-status :error
     3052         or error-status :get-message(1) <> ""
     3053         then do:
     3054           undo move_block, retry move_block.
     3055         end.
     3056         if frame d-all-docs :scrollable = true
     3057         then do:
     3058           assign
     3059             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     3060           no-error .
     3061           if error-status :error
     3062           or error-status :get-message(1) <> ""
     3063           then do:
     3064             undo move_block, retry move_block.
     3065           end.
     3066         end.
     3067       end.
     3068       if p-move-resize
     3069       then do:
     3070         run diasize_position-resize-button in this-procedure .
     3071       end.
     3072       if v-diasize-wndstore = true
     3073       then do:
     3074         if connected("ub") = true
     3075         then do:
     3076           define variable v-cntxt-db-num        as integer   no-undo .
     3077           define variable v-cntxt-userid        as character no-undo .
     3078           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3079                                             , OUTPUT v-cntxt-userid
     3080                                             ) .
     3081           run gbl/wndsizew.p
     3082             (input  v-cntxt-db-num
     3083             ,input  v-cntxt-userid
     3084             ,input  v-diasize-proc-name
     3085             ,input  'width':u
     3086             ,input  string(frame d-all-docs :width - v-diasize-orig-frame-width)
     3087             ) .
     3088         end.
     3089       end.
     3090     end.
     3091     assign
     3092       v-diasize-change-size = false
     3093     .
     3094   end procedure.
     3095   procedure diasize_set-width :
     3096     define input  parameter p-new-width  as decimal   no-undo .
     3097     define input  parameter p-move-resize as logical   no-undo .
     3098     do
     3099     on error undo, return error return-value
     3100     :
     3101       run diasize_change-width in this-procedure
     3102         (input  (p-new-width - frame d-all-docs :width)
     3103         ,input  p-move-resize
     3104         ) .
     3105     end.
     3106   end procedure.
     3107   procedure diasize_position-resize-button :
     3108     do with frame d-all-docs
     3109     :
     3110       hide v-diasize-resize-button .
     3111       assign
     3112         v-diasize-resize-button :row = frame d-all-docs :height - v-diasize-resize-button :height
     3113                     - 1
     3114                     - (frame d-all-docs :border-bottom-pixels / session :pixels-per-row)
     3115         v-diasize-resize-button :col = frame d-all-docs :width - v-diasize-resize-button :width
     3116                     - 1
     3117                     - (frame d-all-docs :border-right-pixels / session :pixels-per-column)
     3118       .
     3119       view v-diasize-resize-button .
     3120     end.
     3121   end procedure.
     3122   on alt-right anywhere
     3123   do:
     3124     run diasize_change-width in this-procedure
     3125       (input 1
     3126       ,input true
     3127       ) .
     3128     return no-apply .
     3129   end.
     3130   on alt-left anywhere
     3131   do:
     3132     run diasize_change-width in this-procedure
     3133       (input -1
     3134       ,input true
     3135       ) .
     3136     return no-apply .
     3137   end.
     3138   on alt-down anywhere
     3139   do:
     3140     run diasize_change-height in this-procedure
     3141       (input 1
     3142       ,input true
     3143       ) .
     3144     return no-apply .
     3145   end.
     3146   on alt-up anywhere
     3147   do:
     3148     run diasize_change-height in this-procedure
     3149       (input -1
     3150       ,input true
     3151       ) .
     3152     return no-apply .
     3153   end.
     3154   on alt-enter of frame d-all-docs
     3155   do:
     3156     run diasize_maximize in this-procedure
     3157       (input  ?
     3158       ).
     3159     return no-apply .
     3160   end.
     3161   procedure diasize_end-move :
     3162     do
     3163     on error undo, return error return-value
     3164     :
     3165       define variable v-row-delta as decimal   no-undo .
     3166       define variable v-col-delta as decimal   no-undo .
     3167       define variable v-new-row as decimal   no-undo .
     3168       define variable v-new-col as decimal   no-undo .
     3169       assign
     3170         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3171         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3172       .
     3173       assign
     3174         v-row-delta = v-new-row - frame d-all-docs :height
     3175         v-col-delta = v-new-col - frame d-all-docs :width
     3176       .
     3177       run diasize_change-height in this-procedure
     3178         (input v-row-delta
     3179         ,input true
     3180         ) .
     3181       run diasize_change-width in this-procedure
     3182         (input v-col-delta
     3183         ,input true
     3184         ) .
     3185     end.
     3186   end procedure.
     3187   procedure diasize_maximize :
     3188     define input  parameter p-action as logical   no-undo .
     3189     do
     3190     on error undo, return error return-value
     3191     :
     3192       if p-action = ?
     3193       then do:
     3194         if v-diasize-need-maximize = true
     3195         then do:
     3196           assign
     3197             p-action = true
     3198           .
     3199         end.
     3200         else do:
     3201           assign
     3202             p-action = false
     3203           .
     3204         end.
     3205       end.
     3206       if p-action = true
     3207       then do:
     3208         run diasize_change-height in this-procedure
     3209           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3210               - frame d-all-docs :height-chars
     3211           ,input true
     3212           ) .
     3213         run diasize_change-width in this-procedure
     3214           (input session :width-chars
     3215               - frame d-all-docs :width-chars
     3216           ,input true
     3217           ) .
     3218         assign
     3219           v-diasize-need-maximize = false
     3220         .
     3221       end.
     3222       else do:
     3223         run diasize_change-width in this-procedure
     3224           (input v-diasize-orig-frame-width
     3225               - frame d-all-docs :width-chars
     3226           ,input true
     3227           ) .
     3228         run diasize_change-height in this-procedure
     3229           (input v-diasize-orig-frame-height
     3230               - frame d-all-docs :height-chars
     3231           ,input true
     3232           ) .
     3233         assign
     3234           v-diasize-need-maximize = true
     3235         .
     3236       end.
     3237     end.
     3238   end procedure.
     3239   procedure diasize_restore-orig-size :
     3240     do
     3241     on error undo, return error return-value
     3242     :
     3243       assign
     3244         v-diasize-current-frame-width  = frame d-all-docs :width
     3245         v-diasize-current-frame-height = frame d-all-docs :height
     3246       .
     3247       run diasize_set-height in this-procedure
     3248         (input  v-diasize-orig-frame-height
     3249         ,input  true
     3250         ) .
     3251       run diasize_set-width in this-procedure
     3252         (input  v-diasize-orig-frame-width
     3253         ,input  true
     3254         ) .
     3255     end.
     3256   end procedure.
     3257   procedure diasize_restore-current-size :
     3258     do
     3259     on error undo, return error return-value
     3260     :
     3261       run diasize_set-height in this-procedure
     3262         (input  v-diasize-current-frame-height
     3263         ,input  true
     3264         ) .
     3265       run diasize_set-width in this-procedure
     3266         (input  v-diasize-current-frame-width
     3267         ,input  true
     3268         ) .
     3269     end.
     3270   end procedure.
     3271   procedure diasize_set-browse-handle :
     3272     define input  parameter p-browse-handle as handle   no-undo .
     3273     define buffer buf_temp-browse-handle for temp-browse-handle .
     3274     do
     3275     on error undo, return error return-value
     3276     :
     3277       assign
     3278         v-diasize-browse-handle = p-browse-handle
     3279       .
     3280       for each buf_temp-browse-handle
     3281       on error undo, return error return-value
     3282       :
     3283         delete buf_temp-browse-handle .
     3284       end.
     3285     end.
     3286   end procedure.
     3287   procedure diasize_add_browse :
     3288     define input  parameter p-browse-type   as character no-undo .
     3289     define input  parameter p-browse-handle as handle    no-undo .
     3290     define buffer buf_temp-browse-handle for temp-browse-handle .
     3291     do
     3292     on error undo, return error return-value
     3293     :
     3294       assign
     3295         v-diasize-browse-number = v-diasize-browse-number + 1
     3296       .
     3297       create buf_temp-browse-handle .
     3298       assign
     3299         buf_temp-browse-handle.browse-type   = p-browse-type
     3300         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3301         buf_temp-browse-handle.browse-handle = p-browse-handle
     3302       .
     3303     end.
     3304   end procedure.
     3305   procedure diasize_init :
     3306     define variable v-default-value    as logical   no-undo .
     3307     define variable v-restore-saved    as logical   no-undo .
     3308     define variable v-resize-value-str as character no-undo .
     3309     do
     3310     on error undo, return error return-value
     3311     :
     3312       do with frame d-all-docs
     3313       :
     3314         assign
     3315           v-diasize-orig-frame-height = frame d-all-docs :height
     3316           v-diasize-orig-frame-width  = frame d-all-docs :width
     3317           v-diasize-browse-handle     = browse br-docs :handle
     3318         .
     3319         create button v-diasize-resize-button
     3320         assign
     3321           parent        = frame d-all-docs :first-child
     3322           label         = "s"
     3323           height-pixels = 16
     3324           width-pixels  = 16
     3325           visible       = true
     3326           sensitive     = true
     3327           movable       = true
     3328           triggers:
     3329             on end-move persistent run diasize_end-move in this-procedure .
     3330           end triggers.
     3331         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3332         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3333         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3334         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3335         assign
     3336           v-diasize-wndmax = false
     3337         .
     3338         if connected("ub") = true
     3339         then do:
     3340           define variable v-cntxt-db-num        as integer   no-undo .
     3341           define variable v-cntxt-userid        as character no-undo .
     3342           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3343                                             , OUTPUT v-cntxt-userid
     3344                                             ) .
     3345           run gbl/wndpar_r.p
     3346             (input  v-cntxt-db-num
     3347             ,input  v-cntxt-userid
     3348             ,input  'wndmax':U
     3349             ,output v-diasize-wndmax
     3350             ,output v-default-value
     3351             ) .
     3352         end.
     3353         assign
     3354           v-diasize-wndstore = false
     3355         .
     3356         if connected("ub") = true
     3357         then do:
     3358           run gbl/wndpar_r.p
     3359             (input  v-cntxt-db-num
     3360             ,input  v-cntxt-userid
     3361             ,input  'wndstore':U
     3362             ,output v-diasize-wndstore
     3363             ,output v-default-value
     3364             ) .
     3365         end.
     3366         assign
     3367           v-diasize-proc-name = entry(1, program-name(2), '.')
     3368         .
     3369         if v-diasize-wndstore = true
     3370         then do:
     3371           assign
     3372             v-restore-saved = false
     3373           .
     3374           if connected("ub") = true
     3375           then do:
     3376             run gbl/wndsizer.p
     3377               (input  v-cntxt-db-num
     3378               ,input  v-cntxt-userid
     3379               ,input  v-diasize-proc-name
     3380               ,input  'height':u
     3381               ,output v-resize-value-str
     3382               ) .
     3383             if v-resize-value-str <> '':U
     3384             then do:
     3385               run diasize_change-height in this-procedure
     3386                 (input  integer(v-resize-value-str)
     3387                 ,input  true
     3388                 ) .
     3389               assign
     3390                 v-restore-saved = true
     3391               .
     3392             end.
     3393           end.
     3394           if connected("ub") = true
     3395           then do:
     3396             run gbl/wndsizer.p
     3397               (input  v-cntxt-db-num
     3398               ,input  v-cntxt-userid
     3399               ,input  v-diasize-proc-name
     3400               ,input  'width':u
     3401               ,output v-resize-value-str
     3402               ) .
     3403             if v-resize-value-str <> '':U
     3404             then do:
     3405               run diasize_change-width in this-procedure
     3406                 (input  integer(v-resize-value-str)
     3407                 ,input  true
     3408                 ) .
     3409               assign
     3410                 v-restore-saved = true
     3411               .
     3412             end.
     3413           end.
     3414           if v-restore-saved <> true
     3415           then do:
     3416             if v-diasize-wndmax = true
     3417             then do:
     3418               run diasize_maximize in this-procedure
     3419                 (input  true
     3420                 ) .
     3421             end.
     3422           end.
     3423         end.
     3424         else do:
     3425           if v-diasize-wndmax = true
     3426           then do:
     3427             run diasize_maximize in this-procedure
     3428               (input  true
     3429               ) .
     3430           end.
     3431         end.
     3432       end.
     3433     end.
     3434   end procedure.
     3435   procedure diasize_need-full-display :
     3436     define output parameter p-need-full-display as logical   no-undo .
     3437     do
     3438     on error undo, return error return-value
     3439     :
     3440       assign
     3441         p-need-full-display = v-diasize-need-full-display
     3442       .
     3443       assign
     3444         v-diasize-need-full-display = false
     3445       .
     3446     end.
     3447   end procedure.
     3448   procedure get-context :
     3449      define output parameter p-db-num as integer          no-undo.
     3450      define output parameter p-user-id as character        no-undo.
     3451      define variable v-login               as character    no-undo.
     3452      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3453      define buffer buf_user-login  for ub.user-login .
     3454      do
     3455      on error undo, return error
     3456      :
     3457            FIND FIRST buf_sys-ctrl no-lock.
     3458            ASSIGN
     3459               v-login = USERID("ub")
     3460               p-db-num = buf_sys-ctrl.db-num
     3461            .
     3462            FIND FIRST buf_user-login
     3463                 WHERE buf_user-login.db-num = p-db-num
     3464                   AND buf_user-login.user-login = v-login
     3465                 no-lock
     3466                 no-error
     3467                 .
     3468            IF AVAILABLE buf_user-login
     3469            THEN DO:
     3470               assign
     3471                  p-user-id = buf_user-login.user-id
     3472               .
     3473            END.
     3474      end.
     3475   end procedure.
     3476       run diasize_init in this-procedure .
     3477   sch-code   :TOOLTIP = "Поиск по началу номера документа".
     3478   sch-date   :TOOLTIP = "Поиск по дате создания документа".
     3479   sch-order  :TOOLTIP = "Поиск по дате заказа".
     3480   sch-fact   :TOOLTIP = "Поиск по дате закрытия док-та на факт".
     3481   sch-objtype:TOOLTIP = "Поиск по типу контрагента".
     3482   sch-objcode:TOOLTIP = "Поиск по номеру контрагента ".
     3483   sch-sum    :TOOLTIP = "Поиск по сумме".
     3484   sch-num    :TOOLTIP = "Поиск по началу номера документа".
     3485   main-block:
     3486   do on error   undo main-block, leave main-block
     3487      on end-key undo main-block, leave main-block:
     3488     run local-conf-rd    in this-procedure.
     3489     run local-enable     in this-procedure.
     3490   run UI-on ("open").
     3491   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3492   DEF VAR cur-clmn-numbr-docs as INT EXTENT 37 no-undo.
     3493   DEF VAR varmvibr-docs       as INT no-undo.
     3494   DEF VAR varmvjbr-docs       as INT no-undo.
     3495   DEF VAR varmvkbr-docs       as INT no-undo.
     3496   DEF VAR varmvlbr-docs       as INT no-undo.
     3497   DEF VAR move-elementbr-docs as INT no-undo.
     3498   def var jjbr-docs           as int no-undo.
     3499   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3500     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3501   END.
     3502   RUN start-mv-clmnbr-docs.
     3503   PROCEDURE start-mv-clmnbr-docs:
     3504   def var old-session as logical no-undo.
     3505      old-session = SESSION:IMMEDIATE-DISPLAY.
     3506      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3507      SESSION:IMMEDIATE-DISPLAY = old-session.
     3508   END.
     3509   ON ctrl-cursor-right OF BROWSE br-docs do:
     3510     RUN re-move-clmnbr-docs ( 6, 37).
     3511   END.
     3512   ON ctrl-cursor-left OF BROWSE br-docs do:
     3513     RUN re-move-clmnbr-docs (37, 6).
     3514   END.
     3515   PROCEDURE re-move-clmnbr-docs:
     3516     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3517     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3518     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3519       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3520     END.
     3521     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME d-all-docs then.
     3522     if source-column > target-column THEN
     3523     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3524       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3525           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3526             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3527           END.
     3528       END.
     3529     END.
     3530     ELSE
     3531     DO varmvjbr-docs = source-column + 1 to target-column:
     3532       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3533         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3534           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3535         END.
     3536       END.
     3537     END.
     3538     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3539       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3540     END.
     3541   END PROCEDURE.
     3542   PROCEDURE ch-clmnbr-docs:
     3543     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3544     if cur-clmn-loc <= 6 then do:
     3545       return .
     3546     end.
     3547     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3548       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3549     END.
     3550     RUN re-move-clmnbr-docs (cur-clmn-loc, 6).
     3551   END PROCEDURE.
     3552   PROCEDURE mv-brw-defaultbr-docs:
     3553   def var old-session as logical no-undo.
     3554     old-session = SESSION:IMMEDIATE-DISPLAY.
     3555     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3556     do varmvlbr-docs = 6 to EXTENT(cur-clmn-numbr-docs):
     3557       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3558     END.
     3559     RUN start-mv-clmnbr-docs.
     3560     SESSION:IMMEDIATE-DISPLAY = old-session.
     3561   END PROCEDURE.
     3562   .
     3563   WAIT-FOR GO OF FRAME d-all-docs focus br-docs.
     3564   end.
     3565   RUN disable_UI.
     3566   PROCEDURE disable_UI :
     3567     HIDE FRAME d-all-docs.
     3568   END PROCEDURE.
     3569   PROCEDURE UI-on :
     3570   define  input param fnc as char no-undo.
     3571   assign t-doc.acc-date:read-only in browse br-docs = yes.
     3572   hide b-close in frame d-all-docs .
     3573   if fnc = "open" then do:
     3574     frame d-all-docs:title = "ВСЕ  заказы на исполнение".
     3575     sch-num = 0.
     3576     hide sch-num in frame d-all-docs.
     3577   end.
     3578   else
     3579   assign
     3580     doc-rec = ?
     3581     pardoc-rec = ?
     3582   .
     3583   if lookup (list-mode , 'is-flor':U + ","  + 'is-flor':U + 'объект':U + ","  + 'is-flor':U + 'статус':U   )  > 0 then do:
     3584     run enb-1 (fnc).
     3585   end.
     3586   else message "Неверный вызов процедуры all-docf.w" .
     3587   if fnc <> "open"   and
     3588      available t-d-b then do:
     3589     assign
     3590       doc-rec = recid (t-d-b)
     3591       pardoc-rec = recid (t-d-b).
     3592   end.
     3593   run openbr( yes, no, '':U, fnc).
     3594   end procedure.
     3595   PROCEDURE local-mark:
     3596     if not available t-doc then do:
     3597       message "Неправильный выбор строки.".
     3598       return error.
     3599     end.
     3600   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3601   define variable v-str-recid36 as character no-undo .
     3602   define variable v-num-entry36 as integer   no-undo .
     3603   assign
     3604     v-str-recid36 = trim( string( recid( t-doc ) , "->>>>>>>>>>>9":U ) )
     3605     v-num-entry36 = lookup( v-str-recid36 , mark-list )
     3606   .
     3607   if v-num-entry36 > 0 then do:
     3608     assign
     3609       entry( v-num-entry36, mark-list ) = "":U
     3610       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3611     .
     3612   end.
     3613   else do:
     3614     assign
     3615       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid36
     3616     .
     3617   end.
     3618     br-docs:refresh() in frame d-all-docs.
     3619   END PROCEDURE.
