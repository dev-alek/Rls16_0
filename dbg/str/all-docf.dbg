     2199   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2200   on help of frame d-all-docs
     2201   do:
     2202     run gbl/app_help.p
     2203       (input this-procedure :file-name
     2204       ,input ''
     2205       ,input ?
     2206       ) no-error.
     2207     if error-status :error then do:
     2208       message
     2209         "Ошибка при вызове помощи"
     2210         error-status :get-message(1)
     2211         view-as alert-box .
