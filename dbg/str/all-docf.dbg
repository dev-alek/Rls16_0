     4741                 (input  "Ошибки при удалении документа"
     4742                 ,input  0
     4743                 ,input  "del-doc.err"
     4744                 ,input  7
     4745                 ,output v-user-action
     4746                 ,output v-printed
     4747                 ).
     4748             end.
     4749             return error.
