      100   procedure fltfield-clear :
      101     define output parameter loc-fld as character no-undo.
      102     define output parameter loc-lab as character no-undo .
      103     define output parameter loc-spr as character no-undo .
      104     define output parameter loc-dim as character no-undo .
      105     assign
      106       loc-fld = ""
      107       loc-lab = ""
      108       loc-spr = ""
      109       loc-dim = "0"
      110     .
      111   end procedure .
      112   procedure fltfield-add :
      113     define input        parameter par-fld as character no-undo.
      114     define input        parameter par-lab as character no-undo .
      115     define input        parameter par-spr as character no-undo .
      116     define input-output parameter loc-fld as character no-undo.
      117     define input-output parameter loc-lab as character no-undo .
      118     define input-output parameter loc-spr as character no-undo .
      119     define input-output parameter loc-dim as character no-undo .
      120     do
      121     on error undo, return error
      122     :
      123       assign
      124       loc-fld = if loc-dim = '0'
      125                 then par-fld
      126                 else (loc-fld + chr(44) + par-fld)
      127       loc-lab = if loc-dim = '0'
      128                 then par-lab
      129                 else (loc-lab + chr(44) + par-lab)
      130       loc-spr = if loc-dim = '0'
      131                 then par-spr
      132                 else (loc-spr + chr(44) + par-spr)
      133       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      134                 string(integer(if num-entries(loc-dim) > 1
      135                               then entry(2, loc-dim)
      136                               else entry(1, loc-dim)
      137                               ) + 1)
      138       no-error
      139       .
      140     end.
      141   end procedure.
      142     define temp-table  tt-tax no-undo
      143   field tax-code    like ub.tax.tax-code
      144   FIELD individual  like ub.tax.individual
      145   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      146   field rate-code   like ub.tax-rate.rate-code
      147   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      148   FIELD tax-type    like ub.tax.tax-type
      149   field rate-value  like ub.tax-rate-value.rate-value
      150   FIELD tax-rate-gds-rc  as recid
      151   FIELD to-cashdesk like ub.tax.to-cashdesk
      152   index tax-code is unique primary tax-code.
      153   define new global shared variable g#lib-trn  as handle no-undo .
      154   define new global shared variable g#lib-trn2 as handle no-undo .
      155   define new global shared variable g#lib-trn3 as handle no-undo .
      156   define new global shared variable g#lib-trn4 as handle no-undo .
      157   define new global shared variable g#lib-farh as handle no-undo .
      158   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   define variable v-waitfram-action01         as character   no-undo .
      160   define variable v-waitfram-action02         as character   no-undo .
      161   define variable v-waitfram-action03         as character   no-undo .
      162   define variable mWaitFramTextBeg            as character   no-undo.
      163   define variable mWaitFramTextEnd            as character   no-undo.
      164   define variable mWaitFramView               as logical     no-undo.
      165   define variable mWaitProcEvent              as logical     no-undo init yes.
      166   define variable mWaitFramInterval           as integer     no-undo init 1 .
      167   define variable mWaitFramStop               as logical     no-undo.
      168   define variable mWaitFramStopUser           as logical     no-undo.
      169   define variable mWaitFramStopTimeOut        as logical     no-undo.
      170   define variable mWaitFramStartProc          as datetime-tz no-undo.
      171   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      172   define button B-WaitFramStop auto-end-key
      173        label "Стоп"
      174        size 10 by 1 tooltip "Остоновить процесс".
      175   define button B-viewProcInfo
      176        label "Информация"
      177        size 15 by 1 tooltip "Информация о процесс".
      178   define frame waitfram
      179     v-waitfram-action01 format "x(72)" no-label skip
      180     v-waitfram-action02 format "x(72)" no-label skip
      181     v-waitfram-action03 format "x(72)" no-label skip
      182     B-viewProcInfo
      183     B-WaitFramStop at row 4 col 30
      184     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      185     .
      186   define new global shared variable mBatchMode as logical no-undo init ?.
      187   define variable mFramBachModHandle as handle no-undo.
      188   mFramBachModHandle = frame waitfram:handle.
      189   define variable mFameOldVis as logical no-undo.
      190   define variable mVisCUrentVin as logical no-undo.
      191   if session:batch-mode
      192   then
      193      mBatchMode = yes.
      194   if mBatchMode = ? then do:
      195     mVisCUrentVin = current-window:visible.
      196     mFameOldVis = mFramBachModHandle:visible.
      197     mFramBachModHandle:visible  = yes.
      198     mBatchMode = mFramBachModHandle:visible ne yes.
      199     mFramBachModHandle:visible = mFameOldVis.
      200     current-window:visible = mVisCUrentVin.
      201   end.
      202    if  log-manager:logfile-name ne ?
      203     then DO:
      204         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      205         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      206         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      207     end.
      208   on choose of B-WaitFramStop in frame waitfram
      209   do:
      210     mWaitFramStop = yes.
      211     mWaitFramStopUser = yes.
      212   end.
      213   function waitfram-check-timeout returns logical():
      214      define variable vtime as int64 no-undo.
      215      if mWaitFramStopTimeOut
      216      then
      217         return yes.
      218      vtime = ( now - mWaitFramStartProc ) / 1000 .
      219      if     mWaitFramTimeOut ne ?
      220         and mWaitFramTimeOut ne 0
      221         and mWaitFramTimeOut lt vtime
      222      then do:
      223         mWaitFramStopTimeOut = yes.
      224      end.
      225      return mWaitFramStopTimeOut.
      226   end.
      227   procedure waitfram-hide :
      228     if not session:batch-mode
      229     then do
      230     on error undo, return error return-value
      231     :
      232       pause 0 before-hide .
      233       if not mBatchMode then
      234         hide frame waitfram .
      235     end.
      236   end procedure.
      237   procedure waitfram-show :
      238     define input  parameter p-message as character no-undo .
      239     define variable v-left-margin as integer   no-undo .
      240     if not session:batch-mode
      241     then do
      242     on error undo, return error return-value
      243     :
      244       if length(p-message) <= 70 then do:
      245         assign
      246           v-left-margin = integer((70 - length(p-message)) / 2)
      247         .
      248         assign
      249           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      250         .
      251         assign
      252           v-waitfram-action01 = " "
      253           v-waitfram-action02 = " "
      254                                    + fill(" ", v-left-margin)
      255                                    + p-message
      256           v-waitfram-action03 = " "
      257         .
      258       end.
      259       else do:
      260         define variable vRindex1 as integer no-undo.
      261         define variable vRindex2 as integer no-undo.
      262         vRindex1 = r-index(p-message," ",70).
      263         if vRindex1 = 0
      264         then
      265            vRindex1 = 70.
      266         if length(p-message)  <= vRindex1 + 70 then do:
      267           assign
      268             v-waitfram-action01 = " "
      269             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      270             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      271           .
      272         end.
      273         else do:
      274           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      275           if vRindex2 <= vRindex1
      276           then
      277              vRindex2 = vRindex1 + 70.
      278           assign
      279             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      280             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      281             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      282           .
      283         end.
      284       end.
      285       B-viewProcInfo:visible   in frame waitfram = no.
      286       B-viewProcInfo:sensitive in frame waitfram = no.
      287       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      288       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      289       if  (   mWaitFramView
      290          or  mWaitProcEvent)
      291          and not mBatchMode
      292       then
      293          display
      294             v-waitfram-action01 skip
      295             v-waitfram-action02 skip
      296             v-waitfram-action03 skip
      297          with frame waitfram .
      298     end.
      299   end procedure.
      300      procedure waitfram-show-this:
      301         define input  parameter iInterval as int64 no-undo.
      302         define variable vtime as int64 no-undo.
      303         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      304         mWaitFramInterval = iInterval.
      305         run waitfram-show (substitute("&1&2 &3&4" ,
      306                                       mWaitFramTextBeg ,
      307                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      308                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      309                                       mWaitFramTextEnd
      310                                      )
      311                           ).
      312      end.
      313      procedure WaitFramRunPause:
      314         define input  parameter iInterval as dec no-undo.
      315         define variable vStart  as datetime-tz no-undo.
      316         define variable vend    as datetime-tz no-undo.
      317         define variable vint as int64 no-undo.
      318         define variable vOk as logical no-undo.
      319         vStart = now.
      320         vend   = vStart.
      321         publish "WaitFramPause" (iInterval,output vOk).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and (   vint > 0
      327                 or (    not vOk
      328                     and iInterval eq ?
      329                     )
      330                 )
      331         then
      332            run waitfram-show-this (iInterval).
      333         vend   =  now.
      334         vint = vend - vStart.
      335         vint = iInterval - vint / 1000.
      336         if     not mWaitFramStop
      337            and vint > 0
      338         then do:
      339            run gbl/pause.p (vint * 1000).
      340         end.
      341         if iInterval ne ?
      342         then
      343            publish "WaitFramStop".
      344         waitfram-check-timeout().
      345      end.
      346      procedure WaitFramWaitFor:
      347         define input  parameter iInterval as dec no-undo.
      348         assign
      349            mWaitFramStartProc   = now
      350            mWaitFramStopUser    = no
      351            mWaitFramStopTimeOut = no
      352         .
      353         block-wait:
      354         do while not mWaitFramStop:
      355            run WaitFramRunPause (iInterval).
      356            if  waitfram-check-timeout()
      357            then do:
      358               leave block-wait.
      359            end.
      360         end.
      361         run waitfram-hide.
      362      end.
      363   procedure waitfram-join :
      364     define input  parameter p-line-1  as character no-undo .
      365     define input  parameter p-line-2  as character no-undo .
      366     define input  parameter p-line-3  as character no-undo .
      367     define output parameter p-message as character no-undo .
      368     do
      369     on error undo, return error return-value
      370     :
      371       assign
      372         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      373                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      374                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      375       .
      376     end.
      377   end procedure.
      378   function waitfram-join-function returns character
      379     (input p-line-1 as character
      380     ,input p-line-2 as character
      381     ,input p-line-3 as character
      382     ).
      383     define variable v-message as character no-undo .
      384     run waitfram-join in this-procedure
      385       (input  p-line-1
      386       ,input  p-line-2
      387       ,input  p-line-3
      388       ,output v-message
      389       ) .
      390     return v-message .
      391   end function .
