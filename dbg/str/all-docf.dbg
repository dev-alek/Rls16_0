     1986       if available (ub.inv-doc-attr) and t-doc.status_ = 'разрешен':U then return no-apply .
     1987   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1988   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
     1989     (input  parparentproc
     1990     ,input  t-doc.doc-code
     1991     ,output table gds-list
     1992     ) no-error .
     1993       if error-status :error
     1994         then
     1995       do:
     1996         find t-doc no-lock
     1997           where recid( t-doc) = pardoc-rec
     1998           .
     1999         return no-apply.
     2000       end.
     2001       find t-doc
     2002         no-lock where recid( t-doc ) = pardoc-rec.
     2003       if t-doc.status_ = 'факт':U then
     2004       do:
     2005         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     2006           ub.inv-doc-attr.attr-code = 'ItogInv' no-error .
     2007         if available(ub.inv-doc-attr) then
     2008         do:
     2009           for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code begins ub.inv-doc-attr.attr-value:
     2010             if entry(2,ub.trn-doc.doc-code,"/") = "и" then next .
     2011             delete ub.trn-doc .
     2012           end.
     2013         for each del_inv-doc-attr exclusive-lock where del_inv-doc-attr.attr-value = t-doc.doc-code and
     2014         del_inv-doc-attr.attr-code = "MultiTSD":
     2015          find first ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = del_inv-doc-attr.doc-code no-error .
     2016          if available (ub.trn-doc) then delete ub.trn-doc .
     2017         end.
     2018         end.
     2019         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     2020           ub.inv-doc-attr.attr-code = 'ItogInvManual' no-error .
     2021         if available(ub.inv-doc-attr) then
     2022         do:
     2023           for each bf_inv-doc-attr no-LOCK where bf_inv-doc-attr.attr-value = t-doc.doc-code and
     2024             bf_inv-doc-attr.attr-code = 'ManualTSD':
     2025             for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = bf_inv-doc-attr.doc-code:
     2026               if docCode = "" then docCode = ub.trn-doc.doc-code .
     2027               else docCode = docCode + ";" + ub.trn-doc.doc-code .
     2028               delete ub.trn-doc .
     2029               for first curr_inv-doc-attr EXCLUSIVE-LOCK where curr_inv-doc-attr.attr-code = bf_inv-doc-attr.attr-code and
     2030               curr_inv-doc-attr.doc-code = bf_inv-doc-attr.doc-code:
     2031               delete bf_inv-doc-attr .
     2032               end.
     2033             end.
     2034           end.
     2035           define variable dd as integer no-undo .
     2036           do dd = 1 to num-entries(docCode,";"):
     2037                 for first bf_inv-doc-attr no-lock where bf_inv-doc-attr.attr-code = 'isManualError' and
     2038                     bf_inv-doc-attr.doc-code = entry(dd,docCode,";") + "-M" :
     2039                     message "В системе есть ошибочные накладные инвентаризации." skip
     2040                         "Удалить их?"  view-as alert-box question buttons yes-no update v-ok as logical .
     2041                     if v-ok then
     2042                     do:
     2043                         for each ub.trn-doc exclusive-lock where ub.trn-doc.doc-code = bf_inv-doc-attr.doc-code:
     2044                             delete ub.trn-doc .
     2045                         end.
     2046                     end.
     2047                 end.
     2048             end.
     2049         end.
     2050       end.
     2051       if t-doc.status_ = 'разрешен':U then
     2052       do:
     2053         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     2054           ub.inv-doc-attr.attr-code = 'ItogInvManual' no-error .
     2055         if available(ub.inv-doc-attr) then
     2056         do:
     2057           do ii = 1 to num-entries(ub.inv-doc-attr.attr-value):
     2058             create bf_inv-doc-attr .
     2059             assign
     2060               bf_inv-doc-attr.attr-code  = 'ManualTSD'
     2061               bf_inv-doc-attr.doc-code   = entry(ii,ub.inv-doc-attr.attr-value)
     2062               bf_inv-doc-attr.attr-value = t-doc.doc-code
     2063               .
     2064           end.
     2065         end.
     2066       end.
     2067       run UI-on in this-procedure ( input "open" ) .
     2068       reposition br-docs to recid pardoc-rec no-error.
     2069     END.
     2070   procedure plgdsfnd :
     2071     define input  parameter p-chk-and-chs    as logical               no-undo .
     2072     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     2073     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     2074     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     2075     define output parameter p-reserv-pl-code as   logical             no-undo .
     2076     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     2077     define buffer buf_goods         for ub.goods .
     2078     define buffer buf_pl-gds        for ub.pl-gds .
     2079     define buffer buf_second_pl-gds for ub.pl-gds .
     2080     find first buf_goods no-lock where
     2081                buf_goods.gds-code = p-gds-code no-error .
     2082     if not available buf_goods
     2083     then do:
     2084       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     2085     end.
     2086   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2088     (input  p-obj-type
     2089     ,input  p-obj-code
     2090     ,input  buf_goods.artic
     2091     ,input  buf_goods.prod-type
     2092     ,input  buf_goods.prod-code
     2093     ,input  'place-rsrv=request'
     2094     ,output p-reserv-pl-code
     2095     ) no-error .
     2096     if error-status :error
     2097     then do:
     2098       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     2099     end.
     2100     if p-reserv-pl-code = no
     2101     then do:
     2102       return .
     2103     end.
     2104     if p-chk-and-chs <> yes
     2105     then do:
     2106       return .
     2107     end.
     2108     find first buf_pl-gds no-lock where
     2109                buf_pl-gds.obj-type = p-obj-type and
     2110                buf_pl-gds.obj-code = p-obj-code and
     2111                buf_pl-gds.gds-code = p-gds-code no-error .
     2112     if not available buf_pl-gds
     2113     then do:
     2114       return error "К товару не привязано ни одного места хранения" .
     2115     end.
     2116     find first buf_second_pl-gds no-lock where
     2117                buf_second_pl-gds.obj-type  = p-obj-type          and
     2118                buf_second_pl-gds.obj-code  = p-obj-code          and
     2119                buf_second_pl-gds.gds-code  = p-gds-code          and
     2120                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     2121     if not available buf_second_pl-gds
     2122     then do:
     2123       assign
     2124         p-pl-code = buf_pl-gds.pl-code
     2125       .
     2126     end.
     2127     else do:
     2128       if not valid-handle( parparentproc )
     2129       then do:
     2130         return error "Не выбрано место хранения " + chr(10) .
     2131       end.
     2132       run str/plgdssel.p
     2133         (
     2134            input parparentproc
     2135         ,  input p-obj-type
     2136         ,  input p-obj-code
     2137         ,  input p-gds-code
     2138         , output p-pl-code
     2139         ) no-error .
     2140       if error-status :error
     2141       then do:
     2142         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     2143                                , 'plgdssel.p':U
     2144                                , chr(10)
     2145                                , error-status :get-message( 1 )
     2146                                , return-value
     2147                                ) .
     2148       end.
     2149       if p-pl-code = ? or
     2150          p-pl-code = 0
     2151       then do:
     2152         return error "Не выбрано место хранения " + chr(10) .
     2153       end.
     2154     end.
     2155   end procedure.
