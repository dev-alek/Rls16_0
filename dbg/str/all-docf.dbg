     5408     (input  parparentproc
     5409     ,input  t-doc.doc-code
     5410     ,output table gds-list
     5411     ) no-error .
     5412                       br-docs:refresh() in frame d-all-docs.
     5413                       if error-status:error then do:
     5414                         find t-doc where recid (t-doc) = doc-rec no-lock.
     5415                         return error.
     5416                       end.
     5417                       if t-doc.status_ = 'накл':U and t-doc.flag_ = true then do:
     5418                               run str/trn-stat.p (input parParentProc,
     5419                                               input this-procedure ,
     5420                                               input  '<закрытие документа>':U,
     5421                                               input  t-doc.doc-code,
     5422                                               input  varcheck-return,
     5423                                               input  v-cntxt-db-num,
     5424                                               input  v-cntxp-in-ov,
     5425                                               input  v-cntxp-rsrv-time,
     5426                                               input  v-cntxp-load-time,
     5427                                               input  v-cntxp-holidays,
     5428                                               input  yes,
     5429                                               output varchg-inv,
     5430                                               output table gds-list) no-error.
     5431                                br-docs:refresh() in frame d-all-docs.
     5432                               if error-status:error then do:
     5433                                 message
     5434                                   vss-workfile vss-revision vss-description skip
     5435                                   "Ошибка при закрытии документа " t-doc.doc-code skip
     5436                                   return-value skip
     5437                                   trim(error-status :get-message(1)) skip
     5438                                   view-as alert-box error.
     5439                                 find t-doc where recid (t-doc) = doc-rec no-lock.
     5440                                 return error.
     5441                               end.
     5442                       end.
     5443                 end.
     5444                 when 2
     5445                 then do:
     5446   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5447   do:
     5448     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
