     4914   procedure proc-b-ext :
     4915    do
     4916    on error undo, return error return-value
     4917    :
     4918       define variable v-list-index     as integer           no-undo.
     4919       define variable v-trn-doc-recid  as recid             no-undo.
     4920       for each temp_recid-list
     4921       :
     4922           delete temp_recid-list.
     4923       end.
     4924       if available t-doc
     4925       then do:
     4926           assign
     4927               v-trn-doc-recid = recid( t-doc )
     4928               v-nn = num-entries( mark-list )
     4929           .
     4930           do v-list-index = 1 to v-nn :
     4931               create temp_recid-list .
     4932               assign
     4933                   temp_recid-list.string-trn-doc-recid = entry( v-list-index, mark-list )
     4934               .
     4935           end.
     4936       end.
     4937       else do:
     4938           assign
     4939               v-trn-doc-recid = 0
     4940           .
     4941       end.
     4942       run str/run-ext.p ( input v-trn-doc-recid
     4943                     , input table temp_recid-list
     4944                     , input 'документы':U
     4945                     , input ""
     4946                     , output v-ext-button-label
     4947                     ) no-error.
     4948       if error-status :error
     4949       then do:
     4950           return error .
     4951       end.
     4952    end.
     4953   end procedure.
     4954   procedure proc-b-chg :
     4955   define variable varrecid as recid no-undo.
     4956    do
     4957    on error undo, return error return-value
     4958    :
     4959   if not available t-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (t-doc). pardoc-rec = recid (t-doc). do on stop undo, return no-apply :   find t-doc where recid (t-doc) = doc-rec exclusive.   end. if t-doc.status_      = 'факт':U                     or          t-doc.status_      = 'готов':U                    or          t-doc.status_      = 'отказ':U                 or          t-doc.status_      = 'нередакт':U                or          t-doc.status_      = 'прво':U                         then do:    find t-doc where recid (t-doc) = doc-rec no-lock.    message "Данный документ закрыт по факту или не может быть обработан в этом списке.".    return no-apply. end.
     4960   define variable vss-include-info44 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4961   do:
     4962     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4963       (input  v-cntxt-db-num
     4964       ,input  v-cntxt-userid
     4965       ,input  0
     4966       ,input  'actn_expense_preparation':U
     4967       ,input  'object':U
     4968       ,input  t-doc.host-code
     4969       ,input  t-doc.obj-type
     4970       ,input  t-doc.obj-code
     4971       ,input  0
     4972       ,input  0
     4973       ,input  0
     4974       ,input  true
     4975       ,output v-log
     4976       )  .
     4977   end.
     4978   if not v-log then do:   find t-doc where recid (t-doc) = doc-rec no-lock.   return no-apply. end.
     4979   if t-doc.status_ = 'запрос':U then do:
     4980     run gbl/calc-trn.p (input parParentProc, input recid(t-doc)).
     4981     assign
     4982       varrecid = recid(t-doc).
     4983     run str/out-doc.w (
     4984            input         parparentproc
     4985          , input-output  varrecid
     4986          , input         'ИЗМЕНЕНИЕ':U
     4987          , input         list-mode
     4988          , input         'рас':U
     4989          , input         false
     4990          , input-output  next-prev
     4991          , input         'ee':U
     4992          , input         false
     4993          , input-output  line-rec
     4994          , input         br-handle
     4995          , input (buffer t-doc :handle in frame d-all-docs )
     4996          , input         t-doc.status_
     4997          ).
     4998   end.
     4999   else
     5000   run str/out-docf.w (
     5001         input parParentProc ,
     5002         input 'ИЗМЕНЕНИЕ':U ,
     5003         input t-doc.status_ ,
     5004         input (br-docs:handle in frame d-all-docs) ,
     5005         input (buffer t-doc :handle in frame d-all-docs )
     5006         ).
     5007   apply "entry" to br-docs in frame d-all-docs.
     5008   if error-status:error then do:
     5009     find t-doc where recid (t-doc) = doc-rec no-lock.
     5010     return error.
     5011   end.
     5012   else run UI-on ("open").
     5013    end.
     5014   end procedure.
