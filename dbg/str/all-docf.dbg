     1260   end function.
     1261   function total-dsc-fact return decimal
     1262   ( input p-rec as recid  ) :
     1263   def buffer t-d for ub.trn-doc .
     1264   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return ? .
     1265     return ( if t-d.print-rubl = yes then t-d.discnt-rubl else t-d.tot-calc ).
     1266   end function.
     1267   function fn-time return char
     1268   (input p-rec as recid ) .
     1269   define buffer loc-t-doc for ub.trn-doc.
     1270   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return '' .
     1271   define variable v-val as character no-undo init "".
     1272   define variable v-type as character no-undo .
     1273   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input loc-t-doc.doc-code ,
     1274                           input '1ord_time':U ,
     1275                          output v-val ,
     1276                          output v-type ) no-error .
     1277     if error-status :error then v-val = "" .
     1278     return ( v-val ) .
     1279   end function.
     1280   function fn-deliv return logical
     1281   (input p-rec as recid ) .
     1282   define buffer loc-t-doc for ub.trn-doc.
     1283   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return false  .
     1284   define variable v-val1 as character no-undo  .
     1285   define variable v-val  as logical   no-undo  initial false .
     1286   define variable v-type as character no-undo .
     1287   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input loc-t-doc.doc-code ,
     1288                           input '4ord_dl':U ,
     1289                          output v-val1 ,
     1290                          output v-type ) no-error .
     1291     if not error-status :error and  v-val1 = "yes" then v-val = true .
     1292     return ( v-val ) .
     1293   end function.
     1294   function fn-ord-itogo return decimal
     1295   (input p-rec as recid ) .
     1296   define buffer loc-t-doc for ub.trn-doc.
     1297   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return 0 .
     1298   define variable v-val  as character no-undo initial "".
     1299   define variable v-type as character no-undo .
     1300   define variable v-dec  as decimal   no-undo .
     1301   if loc-t-doc.status_ = 'факт':U then do:
     1302      v-dec = decimal(total-pay-fact (recid( loc-t-doc))) .
     1303      return v-dec   .
     1304      end.
     1305   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input loc-t-doc.doc-code ,
     1306                           input 'discnt-stop':U ,
     1307                          output v-val ,
     1308                          output v-type ) no-error .
     1309     if error-status :error then v-val = "" .
     1310     return (decimal(v-val) ) .
     1311   end function.
     1312   define browse br-docs query br-docs no-lock display
     1313         mark-string (recid( t-doc))  column-label '*'  format "x(1)"
     1314         t-doc.status_  column-label 'Стат'  format "x(4)"
     1315         t-doc.flag_  column-label 'OK'  format "+/-"
     1316         t-doc.doc-code  column-label 'Номер'
     1317         t-doc.doc-date  column-label 'Дата'  format "99/99/99"
     1318         t-doc.fact-date  column-label 'Факт'
     1319         fcli-name (recid(t-doc))  column-label 'Контрагент'  format "x(26)"
     1320         t-doc.flora-order-date  column-label 'Дата заказа'  format "99/99/9999"
     1321         fn-time (recid(t-doc))  column-label 'Время'  format "x(5)"
     1322         fn-deliv (recid(t-doc)) column-label 'Д' format "+/-"
     1323         total-sum (recid(t-doc)) column-label 'Сумма по док' format "->>>,>>>,>>9.99"
     1324         fn-ord-itogo (recid(t-doc)) column-label 'К оплате факт' format "->>>,>>>,>>9.99"
     1325         t-doc.doc-qnty column-label 'Кол-во по док.'
     1326         t-doc.fact-qnty column-label 'Кол-во факт'
     1327         t-doc.print-rubl column-label '$'  format "+/-"
     1328         object-label (recid(t-doc)) column-label 'Объект'  format "x(9)"
     1329         total-dsc (recid(t-doc)) column-label 'Скидка по док'  format "->>>,>>>,>>9.99"
     1330         total-dsc-fact (recid(t-doc)) column-label 'Скидка факт'  format "->>>,>>>,>>9.99"
     1331         total-vat (recid(t-doc)) column-label 'НДС'  format "->,>>>,>>>,>>9.99"
     1332         t-doc.discnt-pc column-label 'Скидка (%)'  format "->,>>9.99"
     1333         t-doc.discnt-type column-label 'Тип скидки'
     1334         t-doc.base-rate column-label 'Курс'
     1335         t-doc.ov column-label 'А'
     1336         t-doc.tot-ov column-label 'Авт. переоц. (прод.)'
     1337         t-doc.inv-num column-label 'Инвойс'
     1338         t-doc.out-code column-label 'На док-т'
     1339         t-doc.acc-date column-label 'Проводка'
     1340         t-doc.bge-date column-label 'Экспорт'
     1341         shift-day-month (recid(t-doc)) column-label 'Смена'
     1342         shift-name (recid(t-doc)) column-label '№' format "x(6)"
     1343         t-doc.tot-transp column-label 'Трансп.расх.(Доставка)'
     1344         t-doc.flora-pay-date column-label 'Дата оплаты'
     1345       enable t-doc.acc-date with size 98 by 13.5 separators.
     1346   DEFINE FRAME d-all-docs
     1347        b-quit AT ROW 1 COL 2
     1348        b-mark AT ROW 1 COL 10
     1349        b-sel  AT ROW 1 COL 14
     1350        b-rep  AT ROW 1 COL 22
     1351        b-bc   AT ROW 1 COL 32
     1352        b-akt  AT ROW 1 COL 42
     1353        b-ext  AT ROW 1 COL 52
     1354        b-exp  at row 1 col 62
     1355        b-sch  AT ROW 1 COL 32
     1356        b-help AT ROW 1 COL 86
     1357        b-add    AT ROW 2.3 COL 2
     1358        b-lkp    AT ROW 2.3 COL 12
     1359        b-chg    AT ROW 2.3 COL 22
     1360        b-del    AT ROW 2.3 COL 32
     1361        b-close-new  AT ROW 2.3 COL 42
     1362        b-open   AT ROW 2.3 COL 52
     1363        b-print  AT ROW 2.3 COL 86
     1364        br-docs  AT ROW 3.5 COL 1
     1365        sch-code at row 19 col 2 label "&Начало номера"
     1366        sch-date at row 19 col 33 label "Д&ата"
     1367        sch-fact at row 19 col 52 label "Фа&кт"
     1368        sch-objcode at row 19 col 71 label "&Контрагент"
     1369        sch-objtype at row 19 col 94 no-label
     1370        sch-order at row 20 col 33 label "Дата заказа"
     1371        sch-sum at row 20 col 2 label "&Сумма факт   "
     1372        sch-num at row 19 col 80 label "Найдено" fgcolor 12
     1373        ub.pay-type.obj-name at row 17 col 5 COLON-ALIGNED LABEL "Опл" VIEW-AS FILL-IN SIZE 34 BY 1 fgcolor 4
     1374        obj-name at row 17 col 55 COLON-ALIGNED LABEL "Объект" VIEW-AS FILL-IN SIZE 34 BY 1 fgcolor 4
     1375        boss-name at row 18 col 5 COLON-ALIGNED LABEL "М-р" VIEW-AS FILL-IN SIZE 14 BY 1 fgcolor 4
     1376        agnt-name at row 18 col 30 COLON-ALIGNED LABEL "Исп" VIEW-AS FILL-IN SIZE 14 BY 1 fgcolor 4
     1377        wrkr-name at row 18 col 55 COLON-ALIGNED LABEL "Кл-к" VIEW-AS FILL-IN SIZE 14 BY 1 fgcolor 4
     1378        v-user-name at row 18 col 80 COLON-ALIGNED LABEL "Опер" VIEW-AS FILL-IN SIZE 16 BY 1 fgcolor 4
     1379        ed-notes AT ROW 21 COL 1 no-label bgcolor 8 fgcolor 4
     1380        b-close AT ROW 21 COL 1
     1381        SPACE(0) SKIP(0.5)
     1382       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1383            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     1384            DEFAULT-BUTTON b-quit.
     1385   def var sort-labelbr-docs   as character no-undo .
     1386   def var sort-clmnbr-docs    as handle    no-undo .
     1387   def var cur-clmnbr-docs     as handle    no-undo .
     1388   def var cur-clmn-locbr-docs as integer   no-undo .
     1389   def var re-querybr-docs     as logical   initial no no-undo .
     1390   on start-search, ctrl-o of br-docs in frame d-all-docs do:
     1391      run sort-brbr-docs
     1392        (input (if available t-doc
     1393                then recid(t-doc)
     1394                else ?
     1395               )
     1396        ).
     1397   end.
     1398   PROCEDURE sort-brbr-docs :
     1399     define input parameter p-recid as recid no-undo .
     1400     if re-querybr-docs = no then do:
     1401       assign
     1402          cur-clmnbr-docs = br-docs:current-column in frame d-all-docs
     1403       .
     1404       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     1405       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     1406         assign
     1407            sort-labelbr-docs = ""
     1408            sort-clmnbr-docs = ?
     1409         .
     1410        end.
     1411        else do:
     1412          assign
     1413            sort-labelbr-docs = cur-clmnbr-docs:label
     1414            sort-clmnbr-docs  = cur-clmnbr-docs
     1415            sort-clmnbr-docs:column-fgcolor = 4
     1416          .
     1417        end.
     1418      end.
     1419     assign
     1420       cur-clmn-locbr-docs = 1
     1421     .
     1422     def var column-handle as handle no-undo .
     1423     column-handle = br-docs:first-column.
     1424     do while valid-handle(column-handle) :
     1425       if column-handle = cur-clmnbr-docs then do:
     1426         leave .
     1427       end.
     1428       column-handle = column-handle:NEXT-COLUMN.
     1429       assign
     1430         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     1431       .
     1432     end.
     1433     case sort-labelbr-docs:
     1434           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1435           when 'Стат'  then DO:    assign       sort-column-name = "t-doc.status_"     .     run ui-on ('open').   . END.
     1436           when 'OK'  then DO:    assign       sort-column-name = "t-doc.flag_"     .     run ui-on ('open').   . END.
     1437           when 'Номер'  then DO:    assign       sort-column-name = "t-doc.doc-code"     .     run ui-on ('open').   . END.
     1438           when 'Дата'  then DO:    assign       sort-column-name = "t-doc.doc-date"     .     run ui-on ('open').   . END.
     1439           when 'Факт'  then DO:    assign       sort-column-name = "t-doc.fact-date"     .     run ui-on ('open').   . END.
     1440           when 'Контрагент'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fcli-name&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1441           when 'Дата заказа'  then DO:    assign       sort-column-name = "t-doc.flora-order-date"     .     run ui-on ('open').   . END.
     1442           when 'Время'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fn-time&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1443           when 'Д'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fn-deliv&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1444           when 'Объект'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fobject-label&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1445           when 'Кол-во по док.'  then DO:    assign       sort-column-name = "t-doc.doc-qnty"     .     run ui-on ('open').   . END.
     1446           when 'Кол-во факт'  then DO:    assign       sort-column-name = "t-doc.fact-qnty"     .     run ui-on ('open').   . END.
     1447           when '$'  then DO:    assign       sort-column-name = "t-doc.print-rubl"     .     run ui-on ('open').   . END.
     1448           when 'Сумма по док'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-sum&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1449           when 'Скидка по док'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-dsc&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1450           when 'Сумма факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1451           when 'Скидка факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-dsc-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1452           when 'К оплате факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fn-ord-itogo&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1453           when 'НДС'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-vat&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1454           when 'Налог прод.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-slt&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1455           when 'Скидка (%)'  then DO:    assign       sort-column-name = "t-doc.discnt-pc"     .     run ui-on ('open').   . END.
     1456           when 'Тип скидки'  then DO:    assign       sort-column-name = "t-doc.discnt-type"     .     run ui-on ('open').   . END.
     1457           when 'Курс'  then DO:    assign       sort-column-name = "t-doc.base-rate"     .     run ui-on ('open').   . END.
     1458           when 'А'  then DO:    assign       sort-column-name = "t-doc.ov"     .     run ui-on ('open').   . END.
     1459           when 'Авт. переоц. (прод.)'  then DO:    assign       sort-column-name = "t-doc.tot-ov"     .     run ui-on ('open').   . END.
     1460           when 'Инвойс'  then DO:    assign       sort-column-name = "t-doc.inv-num"     .     run ui-on ('open').   . END.
     1461           when 'Заказ'  then DO:    assign       sort-column-name = "t-doc.ord-num"     .     run ui-on ('open').   . END.
     1462           when 'Отгрузка приход'  then DO:    assign       sort-column-name = "t-doc.ship-num"     .     run ui-on ('open').   . END.
     1463           when 'Дата'  then DO:    assign       sort-column-name = "t-doc.ship-date"     .     run ui-on ('open').   . END.
     1464           when 'На док-т'  then DO:    assign       sort-column-name = "t-doc.out-code"     .     run ui-on ('open').   . END.
     1465           when 'Проводка'  then DO:    assign       sort-column-name = "t-doc.acc-date"     .     run ui-on ('open').   . END.
     1466           when 'Экспорт'  then DO:    assign       sort-column-name = "t-doc.bge-date"     .     run ui-on ('open').   . END.
     1467           when 'Смена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-day-month&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1468           when '№'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-name&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
     1469           when 'Трансп.расх.(Доставка)'  then DO:    assign       sort-column-name = "t-doc.tot-transp"     .     run ui-on ('open').   . END.
     1470           when 'Дата оплаты'  then DO:    assign       sort-column-name = "t-doc.flora-pay-date"     .     run ui-on ('open').   . END.
     1471       otherwise do:
     1472         assign
     1473           sort-column-name = ""
     1474         .
     1475         run ui-on ('open').
     1476         if sort-labelbr-docs <> "" then do:
     1477           assign
     1478             cur-clmnbr-docs:column-fgcolor = 0
     1479           .
     1480         end.
     1481         assign
     1482           cur-clmn-locbr-docs = ?
     1483         .
     1484       end.
     1485     end case.
     1486     if p-recid <> ? then do:
     1487       reposition br-docs to recid p-recid no-error.
     1488       apply "value-changed" to br-docs in frame d-all-docs.
     1489     end.
     1490     apply "entry" to br-docs in frame d-all-docs.
     1491   END PROCEDURE.
     1492   procedure re-open-query-srt-clmnbr-docs:
     1493   if cur-clmnbr-docs = ? then do:
     1494      run ui-on ('open').
     1495   end.
     1496   else do:
     1497      assign re-querybr-docs = yes.
     1498      run sort-brbr-docs
     1499        (input (if available t-doc
     1500                then recid(t-doc)
     1501                else ?
     1502               )
     1503        ).
     1504      assign re-querybr-docs = no.
     1505   end.
     1506   end.
     1507   ASSIGN
     1508     FRAME d-all-docs :SCROLLABLE       = FALSE
     1509     br-docs :NUM-LOCKED-COLUMNS IN FRAME d-all-docs = 5.
     1510   ASSIGN b-rep :POPUP-MENU IN FRAME d-all-docs = MENU m-rep :HANDLE.
     1511   ASSIGN b-rep :MENU-MOUSE = 1.
     1512   ON CHOOSE OF MENU-ITEM m-rep-1 in menu m-rep DO:
     1513     define variable buf-handle as handle no-undo .
     1514     define variable q-handle as handle no-undo .
     1515     buf-handle = buffer t-doc :handle .
     1516     q-handle   = query br-docs :handle .
     1517     run rep/rep-par.w (input  parparentproc , input   frame d-all-docs:title , input  q-handle , input buf-handle ).
     1518     choice = ?.
     1519   END.
     1520   ON CHOOSE OF MENU-ITEM m-rep-2 in menu m-rep DO:
     1521     run rep/g-flora.p (input parparentproc ).
     1522     choice = ?.
     1523   END.
     1524   on choose of b-mark in frame d-all-docs do:
     1525     RUN local-mark.
     1526     v-log = br-docs:select-next-row ().
     1527     apply "entry" to br-docs in frame d-all-docs.
     1528   end.
     1529   on any-printable of br-docs in frame d-all-docs do:
     1530     assign
     1531       sch-code:screen-value = sch-code:screen-value + last-event:label.
     1532     apply "entry" to sch-code in frame d-all-docs.
     1533   end.
     1534   on ctrl-j of sch-code in frame d-all-docs
     1535   do:
     1536     run proc-find-code in this-procedure(yes, input frame d-all-docs sch-code).
     1537   end.
     1538   on return of sch-code in frame d-all-docs
     1539   do:
     1540     run proc-find-code in this-procedure(no, input frame d-all-docs sch-code).
     1541     return no-apply.
     1542   end.
     1543   on ctrl-j of sch-date in frame d-all-docs
     1544   do:
     1545     run proc-find-date in this-procedure(yes, input frame d-all-docs sch-date, "doc-date").
     1546   end.
     1547   on return of sch-date in frame d-all-docs
     1548   DO:
     1549     run proc-find-date in this-procedure(no, input frame d-all-docs sch-date, "doc-date":U).
     1550     return no-apply.
     1551   END.
     1552   on ctrl-j of sch-fact in frame d-all-docs
     1553   do:
     1554     run proc-find-date in this-procedure(yes, input frame d-all-docs sch-fact, "fact-date":u).
     1555   end.
     1556   on return of sch-fact in frame d-all-docs
     1557   do:
     1558     run proc-find-date in this-procedure(no, input frame d-all-docs sch-fact, "fact-date":u).
     1559     return no-apply.
     1560   end.
     1561   on ctrl-j of sch-objtype in frame d-all-docs
     1562   do:
     1563     run proc-find-cli in this-procedure(input frame d-all-docs sch-objtype, input frame d-all-docs sch-objcode).
     1564   end.
     1565   on return of sch-objtype in frame d-all-docs
     1566   do:
     1567     run proc-find-cli in this-procedure(input frame d-all-docs sch-objtype, input frame d-all-docs sch-objcode).
     1568     return no-apply.
     1569   end.
     1570   on return of sch-objcode in frame d-all-docs
     1571   do:
     1572     run proc-find-cli in this-procedure(input frame d-all-docs sch-objtype, input frame d-all-docs sch-objcode).
     1573     return no-apply.
     1574   end.
     1575   on ctrl-j of sch-sum in frame d-all-docs
     1576   do:
     1577     run proc-find-sum in this-procedure(input frame d-all-docs sch-sum).
     1578   end.
     1579   on return of sch-sum in frame d-all-docs
     1580   do:
     1581     run proc-find-sum in this-procedure(input frame d-all-docs sch-sum).
     1582     return no-apply.
     1583   end.
     1584   on ctrl-j of sch-order in frame d-all-docs
     1585   do:
     1586     run proc-find-order in this-procedure(yes, input frame d-all-docs sch-order).
     1587   end.
     1588   on return of sch-order in frame d-all-docs
     1589   DO:
     1590     run proc-find-order in this-procedure(no, input frame d-all-docs sch-order).
     1591     return no-apply.
     1592   END.
     1593   ON CHOOSE OF b-close-new IN FRAME d-all-docs
     1594   DO:
     1595   define variable v-err as logical no-undo .
     1596   define variable v-recid as recid no-undo .
     1597   if not available t-doc then return.
     1598   v-recid = recid(t-doc) .
     1599   run str/fl-cls.p ( input parParentProc ,
     1600                      input  t-doc.doc-code ,
     1601                      output v-err ) .
     1602   if v-err = false then return .
     1603   if t-doc.status_ = 'накл':U and t-doc.flag_  = false  then do:
     1604      run proc-close no-error .
     1605      if error-status :error then return no-apply.
     1606   end.
     1607   else do:
     1608      if t-doc.status_ = 'запрос':U and  t-doc.flag_  = false  then do:
     1609          run proc-close-zapr no-error.
     1610          if error-status:error then return no-apply.
     1611      end.
     1612      else do:
     1613   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1614   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
     1615     (input  parparentproc
     1616     ,input  t-doc.doc-code
     1617     ,output table gds-list
     1618     ) no-error .
     1619         br-docs:refresh() in frame d-all-docs.
     1620      end.
     1621   end.
     1622   find t-doc where recid (t-doc) = v-recid no-lock.
     1623   run UI-on ("open").
     1624   reposition br-docs to recid v-recid no-error.
     1625   END.
     1626   on choose of b-add in frame d-all-docs
     1627   do:
     1628   define variable  v-recid as recid no-undo .
     1629     run local-add in this-procedure no-error.
     1630     v-recid = pardoc-rec.
     1631     if pardoc-rec <> ? then do:
     1632       run UI-on ("open").
     1633       reposition br-docs to recid v-recid no-error.
     1634     end.
     1635   end.
     1636   ON CHOOSE OF b-chg IN FRAME d-all-docs
     1637   DO:
     1638     run proc-b-chg in this-procedure.
     1639   END.
     1640   ON CHOOSE OF b-del IN FRAME d-all-docs  DO:
     1641     run proc-b-del no-error .
     1642     if error-status :error then return no-apply.
     1643     run UI-on ("open").
     1644   end.
     1645   on choose of b-sch in frame d-all-docs do:
     1646     run proc-b-sch in this-procedure.
     1647   end.
     1648   ON CHOOSE OF b-akt IN FRAME d-all-docs
     1649   DO:
     1650     run proc-b-akt no-error.
     1651     if error-status:error then return no-apply.
     1652   END.
     1653   ON CHOOSE OF b-lkp IN FRAME d-all-docs
     1654   DO:
     1655     run proc-b-lkp no-error.
     1656     if error-status:error then return no-apply.
     1657   END.
     1658   ON CHOOSE OF b-print IN FRAME d-all-docs
     1659   DO:
     1660     run proc-b-print no-error.
     1661     if error-status:error then return no-apply.
     1662   END.
     1663   ON CHOOSE OF b-bc IN FRAME d-all-docs
     1664   DO:
     1665     if not available t-doc then do:
     1666       message "Неправильный выбор документа.".
     1667       return no-apply.
     1668     end.
     1669     assign
     1670       doc-rec    = recid (t-doc)
     1671       pardoc-rec = recid (t-doc)
     1672     .
     1673     run rep/tick-doc.p (parParentProc, doc-rec, "trn", 1, no, no).
     1674     apply "entry" to br-docs in frame d-all-docs.
     1675   END.
     1676   ON CHOOSE OF b-ext IN FRAME d-all-docs
     1677   DO:
     1678     run proc-b-ext no-error .
     1679     if error-status :error then return no-apply.
     1680   END.
     1681   ON CHOOSE OF b-rep IN FRAME d-all-docs
     1682   DO:
     1683     if choice = ? then do:
     1684       run gbl/pop-up.p (self:handle, no) no-error.
     1685       if error-status:error then return no-apply.
     1686     end.
     1687   END.
     1688   on choose of b-exp in frame d-all-docs
     1689   do:
     1690     run local-export.
     1691   end.
     1692   ON CHOOSE OF b-sel IN FRAME d-all-docs
     1693   DO:
     1694    run local-sel in this-procedure.
     1695   END.
     1696   ON CHOOSE OF b-quit IN FRAME d-all-docs
     1697   DO:
     1698     assign
     1699       doc-rec = ?
     1700       pardoc-rec = ?
     1701     .
     1702   END.
     1703   on entry of ed-notes in frame d-all-docs
     1704   do:
     1705     run entry-notes in this-procedure.
     1706   end.
     1707   on leave of ed-notes in frame d-all-docs
     1708   do:
     1709     run local-notes.
     1710   end.
     1711   on return, mouse-select-dblclick of ed-notes in frame d-all-docs do:
     1712     apply "entry" to br-docs in frame d-all-docs.
     1713     return no-apply.
     1714   end.
     1715   on return, mouse-select-dblclick of br-docs in frame d-all-docs do:
     1716     apply "choose" to b-lkp in frame d-all-docs.
     1717   end.
     1718   on value-changed of br-docs do:
     1719     run local-value-changed.
     1720   end.
     1721   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile: trn-clos.i $ $Revision: aea5316774be, 0, rls $".
     1722   on choose of b-open in frame d-all-docs
     1723     do:
     1724       define buffer bf_inv-doc-attr for ub.inv-doc-attr .
     1725       define buffer buf_doc-line-attr for doc-line-attr.
     1726       DEFINE buffer curr_inv-doc-attr for ub.inv-doc-attr .
     1727       if not available t-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (t-doc). pardoc-rec = recid (t-doc). do on stop undo, return no-apply :   find t-doc where recid (t-doc) = doc-rec exclusive.   end. if t-doc.status_      = 'факт':U                     or          t-doc.status_      = 'готов':U                    or          t-doc.status_      = 'отказ':U                 or          t-doc.status_      = 'нередакт':U                or          t-doc.status_      = 'прво':U                         then do:    find t-doc where recid (t-doc) = doc-rec no-lock.    message "Данный документ закрыт по факту или не может быть обработан в этом списке.".    return no-apply. end.
     1728       assign
     1729         pardoc-rec = recid (t-doc)
     1730         .
     1731       if t-doc.status_ = 'разрешен':U then
     1732       do:
     1733         find first ub.inv-doc-attr no-lock where (ub.inv-doc-attr.attr-code = "ItogInv" or ub.inv-doc-attr.attr-code = "ItogInvManual")and
     1734           ub.inv-doc-attr.doc-code = t-doc.doc-code no-error .
     1735         if available (ub.inv-doc-attr) then
     1736         do:
     1737           message "Этот документ запрещено открывать!" skip
     1738             "Номер документа" t-doc.doc-code
     1739             view-as alert-box information .
     1740           return .
     1741         end.
     1742         find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = t-doc.doc-code and
     1743         ub.inv-doc-attr.attr-code = 'invMultDevice' no-error .
