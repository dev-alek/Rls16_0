     1091   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1092   function total-fact return decimal  ~
     1093   ( input p-rec as recid  ) . ~
     1094   def buffer t-d for ub.trn-doc . ~
     1095   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return ? . ~
     1096   return (if t-d.print-rubl then t-d.tot-sale else t-d.tot-fact). ~
     1097   end function. ~
     1098   function first-symb-type return char  ~
     1099   ( input p-rec as recid  ) . ~
     1100   def buffer t-d for ub.trn-doc . ~
     1101   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     1102   return (substring (t-d.doc-type, 1, 1)).                    ~
     1103   end function. ~
     1104   function day-month return char ~
     1105   ( input p-rec as recid  ) . ~
     1106   def buffer t-d for ub.trn-doc . ~
     1107   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     1108   return (substring ((string (t-d.doc-date)), 1, 5)).        ~
     1109   end function.  ~
     1110   function shift-day-month return char ~
     1111   ( input p-rec as recid  ) . ~
     1112   def buffer t-d for ub.trn-doc . ~
     1113   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     1114   return (substring ((string (t-d.shift-date)), 1, 5)).      ~
     1115   end function.  ~
     1116   function object-label return char  ~
     1117   ( input p-rec as recid  ) . ~
     1118   def buffer t-d for ub.trn-doc . ~
     1119   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     1120   return (trim (t-d.obj-type)  + string (t-d.obj-code)). ~
     1121   end function.  ~
     1122   function fcli-name return character   ~
     1123   ( input p-rec as recid  ) . ~
     1124   def buffer t-d for ub.trn-doc . ~
     1125   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return chr(1) . ~
     1126   return t-d.cli-name .  ~
     1127   end function.
     1128   function total-pay-fact return character
     1129   ( input p-rec as recid  ) .
     1130   def buffer loc-t-doc for ub.trn-doc .
     1131   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return chr(1) .
     1132   if loc-t-doc.doc-type = 'инв':U then return "" .
     1133   if (loc-t-doc.ext-doc-type = 'es':U or loc-t-doc.ext-doc-type = 'rs':U) and v-sale <> yes then return "?" .
     1134   if loc-t-doc.doc-type = 'при':U and
     1135      loc-t-doc.internal = no        then do:
     1136     return string ( loc-t-doc.tot-calc , "->,>>>,>>>,>>>,>>9.99" ).
     1137   end.
     1138   else do:
     1139     return string( ( if loc-t-doc.print-rubl then (loc-t-doc.tot-sale - loc-t-doc.discnt-rubl) else (loc-t-doc.tot-fact - loc-t-doc.tot-calc) ) , "->,>>>,>>>,>>>,>>9.99" ).
     1140   end.
     1141   end function.
     1142   function total-acc return decimal
     1143   ( input p-rec as recid  ) .
     1144   def buffer loc-t-doc for ub.trn-doc .
     1145   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return ? .
     1146     if (loc-t-doc.ext-doc-type = 'es':U or loc-t-doc.ext-doc-type = 'rs':U) and v-sale <> yes then return ?.
     1147     return (if loc-t-doc.print-rubl then loc-t-doc.fact-rubl else loc-t-doc.fact-base).
     1148   end function.
     1149   function shift-name return character
     1150   ( input p-rec as recid  ) .
     1151   def buffer loc-t-doc for ub.trn-doc .
     1152   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return ? .
     1153     if loc-t-doc.shift-date = ? then do:
     1154       return "":u.
     1155     end.
     1156     else do:
     1157       if loc-t-doc.shift-num = integer(loc-t-doc.shift-name) then do:
     1158         return loc-t-doc.shift-name.
     1159       end.
     1160       else do:
     1161         return loc-t-doc.shift-name + "(" + string(loc-t-doc.shift-num) + ")".
     1162       end.
     1163     end.
     1164   end function.
     1165   function closed-backdated return character
     1166   ( input p-rec as recid ) .
     1167   def buffer loc-t-doc for ub.trn-doc .
     1168   find first loc-t-doc no-lock where recid(loc-t-doc) = p-rec no-error . if error-status :error then return ?.
     1169     return ( if loc-t-doc.is-back-date then "+" else "" ).
     1170   end function.
     1171   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   function mark-string return character
     1173   ( input p-rec as recid  ) .
     1174   def buffer t-d for ub.trn-doc .
     1175   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return '' .
     1176   return ( if lookup(string(recid(t-d)),mark-list) > 0 then '*' else '' ).
     1177   end function.
     1178   function factur return char
     1179   ( input p-rec as recid  ) .
     1180   def buffer t-d for ub.trn-doc .
     1181   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return '' .
     1182    if t-d.cr-factur = yes then do:
     1183      return string(t-d.factur-date).
     1184    end.
     1185    else do:
     1186      if t-d.need-factur = 0 then  return '0'.
     1187      if t-d.need-factur = 1 then  return '1'.
     1188      if t-d.need-factur = 2 then  return '2'.
     1189    end.
     1190   end function.
     1191   function fo-buyer return char
     1192   ( input p-rec as recid  ) .
     1193   def buffer t-d for ub.trn-doc .
     1194   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return '' .
     1195    if t-d.cr-fo-buyer = yes then do:
     1196      return string (t-d.buyer-fo-date).
     1197    end.
     1198    else do:
     1199      if t-d.need-buyer = 0 then return '0'.
     1200      if t-d.need-buyer = 1 then return '1'.
     1201      if t-d.need-buyer = 2 then return '2'.
     1202    end.
     1203   end function.
     1204   function fo-realiz return integer
     1205   ( input p-rec as recid  ) .
     1206   def buffer t-d for ub.trn-doc .
     1207   find first t-d no-lock where recid(t-d) = p-rec no-error . if error-status :error then return ? .
     1208    if t-d.cr-expfo = yes then do:
     1209      return int (t-d.expfo-date).
     1210    end.
     1211    else do:
     1212      if t-d.need-expfo = 0 then return 0.
     1213      if t-d.need-expfo = 1 then return 1.
     1214      if t-d.need-expfo = 2 then return 2.
     1215    end.
     1216   end function.
