      897             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      898             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      899             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      900             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      901             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      902             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      903             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      904             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      905             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      906             .
      907         end.
