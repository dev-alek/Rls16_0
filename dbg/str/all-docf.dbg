     4218       define variable  parameter-7-42 as character no-undo .
     4219         assign
     4220         parameter-3-42 =
     4221                                 "FOR EACH t-doc"
     4222         parameter-4-42 =
     4223           (
     4224             if ("t-doc.is-flora = yes
     4225                          and t-doc.status_ = g#stat
     4226                          and t-doc.obj-type = v-cntxt-obj-type
     4227                          and t-doc.obj-code = v-cntxt-obj-code  " + " " + where-phrase-42) <> ""
     4228             then              substitute('                    t-doc.is-flora = yes               and t-doc.obj-type = &1&2&1               and t-doc.obj-code = &3                  and t-doc.status_ = &1&4&1                ', chr(34), v-cntxt-obj-type , v-cntxt-obj-code ,  g#stat )                  + " " + where-phrase-42
     4229             else "true"
     4230           )
     4231         parameter-5-42 = (" " + "" + " " + "")
     4232         parameter-6-42 = if sort-phrase-42 = ''
     4233                              then
     4234           (
     4235           " " + " " +
     4236             " " + sort-column-phrase +
     4237           " " + ""
     4238           )
     4239                              else
     4240           (
     4241           " " + " " +
     4242             " " + sort-column-phrase +
     4243           " " + sort-phrase-42
     4244           )
     4245         parameter-7-42 =
     4246           "   "
     4247       .
     4248       do
     4249       on stop undo, leave
     4250       on error undo, leave
     4251       :
     4252         assign
     4253           l-disable-where-42 =
     4254             ("t-doc.is-flora = yes
     4255                          and t-doc.status_ = g#stat
     4256                          and t-doc.obj-type = v-cntxt-obj-type
     4257                          and t-doc.obj-code = v-cntxt-obj-code  " + " " + where-phrase-42 = "")
     4258         .
     4259         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4260                             ,input query br-docs:handle
     4261                             ,input parameter-3-42
     4262                             ,input parameter-4-42
     4263                             ,input parameter-5-42
     4264                             ,input parameter-6-42
     4265                             ,input parameter-7-42
     4266                             )
     4267         .
     4268         assign
     4269           l-filter-open-42 = true
     4270         .
     4271       end.
     4272       if l-filter-open-42 = false then do:
     4273         message
     4274           "Ошибка при фильтрации / сортировке" skip
     4275           "Будут показаны записи без учета фильтра" skip
     4276           view-as alert-box .
     4277       end.
     4278       else do:
     4279           assign
     4280             l-query-was-opened = true
     4281           .
     4282       end.
     4283     end.
     4284     if l-filter-open-42 = false then do:
     4285       open query br-docs for each t-doc  use-index obj-date
     4286         where t-doc.is-flora = yes
     4287                          and t-doc.status_ = g#stat
     4288                          and t-doc.obj-type = v-cntxt-obj-type
     4289                          and t-doc.obj-code = v-cntxt-obj-code
     4290     .
     4291         assign
     4292           l-query-was-opened = true
     4293         .
     4294     end.
     4295   end.
     4296   else do:
     4297     assign
     4298       doc-rec = recid( t-doc )
     4299     .
     4300     do
     4301     on stop undo, leave
     4302     on error undo, leave
     4303     :
     4304       if query br-docs:handle:get-buffer-handle(1) = (buffer t-doc:handle) then do:
     4305         assign
     4306         parameter-2-42 = (if p-find-next then "true":u else "false":u )
     4307         parameter-4-42 =
     4308           "where ":u +              substitute('                    t-doc.is-flora = yes               and t-doc.obj-type = &1&2&1               and t-doc.obj-code = &3                  and t-doc.status_ = &1&4&1                ', chr(34), v-cntxt-obj-type , v-cntxt-obj-code ,  g#stat )                  + " ":u + where-phrase-42 + " ":u + p-find-condition + " " + ""
     4309         parameter-5-42 = " "
     4310       .
     4311         run fltopend_fltfindd in this-procedure  (
     4312                             input this-procedure:handle
     4313                             ,input query br-docs:handle
     4314                             ,input rowid(t-doc)
     4315                             ,input logical(parameter-2-42)
     4316                             ,input no-lock
     4317                             ,input (buffer t-doc:handle)
     4318                             ,input parameter-4-42
     4319                             ,input parameter-5-42
     4320                             ) no-error.
     4321         .
     4322         assign
     4323           doc-rec = integer(return-value)
     4324           v-fltopend-rowid[1] = ?
     4325         .
     4326       end.
     4327       else do:
     4328         assign
     4329         parameter-2-42 = (if p-find-next then "true":u else "false":u )
     4330         parameter-3-42 =  "FOR EACH t-doc"
     4331         parameter-4-42 =
     4332           (
     4333             if ("t-doc.is-flora = yes
     4334                          and t-doc.status_ = g#stat
     4335                          and t-doc.obj-type = v-cntxt-obj-type
     4336                          and t-doc.obj-code = v-cntxt-obj-code  " + " " + where-phrase-42) <> ""
     4337             then              substitute('                    t-doc.is-flora = yes               and t-doc.obj-type = &1&2&1               and t-doc.obj-code = &3                  and t-doc.status_ = &1&4&1                ', chr(34), v-cntxt-obj-type , v-cntxt-obj-code ,  g#stat )                  + " " + where-phrase-42
     4338             else "true"
     4339           )
     4340         parameter-5-42 = (" " + "" + " " + "" + " " + p-find-condition)
     4341         parameter-6-42 = if sort-phrase-42 = ''
     4342                              then
     4343           (
     4344           " " + " " +
     4345             " " + sort-column-phrase +
     4346           " " + ""
     4347           )
     4348                              else
     4349           (
     4350           " " + " " +
     4351             " " + sort-column-phrase +
     4352           " " + sort-phrase-42
     4353           )
     4354         parameter-7-42 =
     4355           "   "
     4356       .
     4357         run fltopend_fltfindq in this-procedure  (
     4358                             input this-procedure:handle
     4359                             ,input query br-docs:handle
     4360                             ,input logical(parameter-2-42)
     4361                             ,input no-lock
     4362                             ,input parameter-3-42
     4363                             ,input parameter-4-42
     4364                             ,input parameter-5-42
     4365                             ,input parameter-6-42
     4366                             ,input parameter-7-42
     4367                             ,output v-fltopend-rowid
     4368                             ) no-error.
     4369         .
     4370         doc-rec = ?.
     4371       end.
     4372       assign
     4373         l-query-was-opened = true
     4374       .
     4375     end.
     4376   end.
     4377           end.
     4378         end.
     4379         otherwise do:
     4380           message "ошибка!" list-mode  view-as alert-box error .
     4381         end.
     4382       end case.
     4383   if not p-open-query and v-fltopend-rowid[1] <> ? then do:
     4384      query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     4385   end.
     4386   end procedure.
     4387   PROCEDURE enb-1 :
     4388   define  input param fnc as char no-undo.
     4389     if fnc = "open" then do:
     4390         enable b-chg b-del b-add b-close-new b-open  WITH FRAME d-all-docs.
     4391     end.
     4392   end procedure.
     4393   PROCEDURE proc-find-code :
     4394   define input parameter par-next as logical no-undo.
     4395   define input parameter pardoc-code like ub.inkas.inkas-code no-undo.
     4396   display
     4397   "  /  /":U @ sch-date
     4398   "  /  /":U @ sch-fact
     4399   '' @ sch-objtype
     4400   '' @ sch-objcode
     4401   '' @ sch-sum
     4402   '' @ sch-order
     4403   with frame d-all-docs.
     4404   assign
     4405   pardoc-code = chr(34) + pardoc-code + chr(34).
     4406   run OpenBr in this-procedure
     4407     (input false
     4408     ,input par-next
     4409     ,input substitute("and t-doc.doc-code   begins &1 ", pardoc-code)
     4410     ,input "open"
     4411     ).
     4412   apply "entry":u to sch-code in frame d-all-docs .
     4413   end procedure.
     4414   procedure proc-find-date :
     4415   define input parameter par-next as logical no-undo.
     4416   define input parameter par-date like ub.inkas.doc-date no-undo.
     4417   define input parameter parwhat-date as character no-undo.
     4418   define variable var-datechr as character no-undo.
     4419   display
     4420   '':u @ sch-code
     4421   '':u @ sch-objcode
     4422   '':u @ sch-objtype
     4423   '':u @ sch-sum
     4424   '':u @ sch-order
     4425   with frame d-all-docs.
     4426   assign
     4427   var-datechr = string(day(par-date)) + chr(47) +
     4428                  string(month(par-date)) + chr(47) +
     4429                 string(year(par-date)).
     4430   case parwhat-date:
     4431     when "doc-date":u then do:
     4432       display
     4433       "  /  /":u @ sch-fact
     4434       with frame d-all-docs.
     4435       run openbr in this-procedure
     4436       (input false
     4437       ,input true
     4438       ,input substitute("and t-doc.doc-date = &1 "
     4439         , var-datechr)
     4440       , "open"
     4441       ).
     4442       apply "entry":u to sch-date in frame d-all-docs.
     4443     end.
     4444     when "fact-date":u then do:
     4445       display
     4446       "  /  /":u @ sch-date
     4447       with frame d-all-docs.
     4448       run openbr in this-procedure
     4449         (input false
     4450         ,input true
     4451         ,input substitute("and t-doc.fact-date = &1 "
     4452         , var-datechr)
     4453         , "open"
     4454         ).
     4455       apply "entry":u to sch-fact in frame d-all-docs.
     4456     end.
     4457   end.
     4458   end procedure.
     4459   PROCEDURE proc-find-cli :
     4460   define input parameter parcli-type like ub.clients.obj-type no-undo.
     4461   define input parameter parcli-code like ub.clients.obj-code no-undo.
     4462   display
     4463   '':u @ sch-code
     4464   "  /  /":U @ sch-date
     4465   "  /  /":U @ sch-fact
     4466   '':u  @ sch-sum
     4467   '':u  @ sch-order
     4468   with frame d-all-docs.
     4469   run OpenBr in this-procedure
     4470     (input false
     4471     ,input yes
     4472     ,input substitute("and t-doc.cli-type = '&1' and t-doc.cli-code = &2", parcli-type, parcli-code)
     4473     ,input "open"
     4474     ) no-error .
     4475   apply "entry":u to sch-objtype in frame d-all-docs .
     4476   end procedure.
     4477   PROCEDURE proc-find-sum :
     4478   define input parameter parsum as decimal no-undo.
     4479   display
     4480   '':u @ sch-code
     4481   "  /  /":U @ sch-date
     4482   "  /  /":U @ sch-fact
     4483   '':u @ sch-objtype
     4484   '':u @ sch-objcode
     4485   with frame d-all-docs.
     4486   run OpenBr in this-procedure
     4487     (input false
     4488     ,input yes
     4489     ,input substitute("and (t-doc.print-rubl = yes and round(t-doc.tot-sale, 2) = &1 or t-doc.print-rubl = no and round(t-doc.tot-fact, 2) = &1)", parsum)
     4490     ,input "open"
     4491     ).
     4492   apply "entry":u to sch-sum in frame d-all-docs .
     4493   end procedure.
     4494   procedure proc-find-order :
     4495   define input parameter par-next as logical no-undo.
     4496   define input parameter par-date like ub.inkas.doc-date no-undo.
     4497   define variable v-recid     as recid     no-undo .
     4498   define variable var-datechr as character no-undo .
     4499   var-datechr = string(day(par-date)) + chr(47) +
     4500                 string(month(par-date)) + chr(47) +
     4501                 string(year(par-date)).
     4502   display
     4503   '':u @ sch-code
     4504   '':u @ sch-objcode
     4505   '':u @ sch-objtype
     4506   '':u @ sch-sum
     4507   '':u @ sch-date
     4508   '':u @ sch-fact
     4509   with frame d-all-docs.
     4510       run openbr in this-procedure
     4511         (input false
     4512         ,input true
     4513         ,input substitute(" and t-doc.flora-order-date = &1 "
     4514         , var-datechr)
     4515         , "open"
     4516         ).
     4517       apply "entry":u to sch-order in frame d-all-docs.
     4518   end procedure.
     4519   PROCEDURE set-filter-name :
     4520     define input parameter p-filter-name as character no-undo .
     4521     do with frame d-all-docs:
     4522       if p-filter-name > "" then do:
     4523         assign
     4524           frame d-all-docs:title
     4525             = frame d-all-docs:title + "   ФИЛЬТР: " + p-filter-name.
     4526         .
     4527         assign
     4528           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     4529         .
     4530       end.
     4531       else do:
     4532         assign
     4533           b-sch :TOOLTIP = ""
     4534         .
     4535       end.
     4536     end.
     4537   END PROCEDURE.
     4538   procedure local-add:
     4539   define buffer bf_clients for ub.clients.
     4540   define buffer bf_sysconf for ub.sysconf.
     4541   define variable varis-active as logical no-undo.
     4542   define variable v-dead-doc   as character initial no no-undo.
     4543   define variable v-type       as character initial ? no-undo.
     4544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4545     (input  'dead-doc'
     4546     ,input  ''
     4547     ,input  ''
     4548     ,input  0
     4549     ,input  ''
     4550     ,input  ''
     4551     ,input  ''
     4552     ,input  no
     4553     ,output v-dead-doc
     4554     ,output v-type
     4555     ) no-error .
     4556   if  error-status :error  = false then do:
     4557       if v-dead-doc = "yes"  then  do:
     4558         message "В системе установлен запрет на ввод документов!"
     4559         view-as alert-box error .
     4560         return error  .
     4561       end.
     4562   end.
     4563   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4564   do:
     4565     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4566       (input  v-cntxt-db-num
     4567       ,input  v-cntxt-userid
     4568       ,input  0
     4569       ,input  'actn_expense_preparation':U
     4570       ,input  'object':U
     4571       ,input  v-cntxt-host-code-obj
     4572       ,input  v-cntxt-obj-type
     4573       ,input  v-cntxt-obj-code
     4574       ,input  0
     4575       ,input  0
     4576       ,input  0
     4577       ,input  true
     4578       ,output v-log
     4579       )  .
     4580   end.
     4581   if not v-log then return error.
     4582     if g#stat = ? then do:
     4583       if (v-cntxt-db-num-obj = v-cntxt-db-num) or
     4584          not (v-cntxt-db-num-obj <> 0) then do:
     4585         assign
     4586           g#stat = 'запрос':U.
     4587       end.
     4588       else do:
     4589         assign
     4590           g#stat = 'запрос':U.
     4591       end.
     4592     end.
     4593     if g#stat = 'запрос':U then do:
     4594       v-log = yes.
     4595       message "Внимание !  Создаю новый ЗАПРОС !" skip (2)
     4596                       "Продолжать ?" view-as alert-box question buttons OK-Cancel update v-log.
     4597       if not v-log then return no-apply.
     4598       run str/out-doc.w (
     4599            input         parparentproc
     4600          , input-output  pardoc-rec
     4601          , input         'ДОБАВЛЕНИЕ':U
     4602          , input         list-mode
     4603          , input         'рас':U
     4604          , input         false
     4605          , input-output next-prev
     4606          , input        'ee':U
     4607          , input        false
     4608          , input-output line-rec
     4609          , input (br-docs:handle in frame d-all-docs)
     4610          , input (buffer t-doc :handle in frame d-all-docs )
     4611          , input        g#stat
     4612          ).
     4613     end.
     4614     else do:
     4615       message "Добавление нового документа не работает в этом списке" view-as alert-box information .
     4616       return no-apply.
     4617     end.
     4618   if doc-rec = ? then do:
     4619     return error.
     4620   end.
     4621   run UI-on ("open").
     4622   end procedure.
     4623   procedure proc-b-del :
     4624   do on error undo, return error return-value :
     4625   define variable del-rec          as recid     no-undo.
     4626   define variable unrv-qnty        as decimal   no-undo.
     4627   define variable varmes           as character no-undo.
     4628   define variable v-user-action    as character no-undo.
     4629   define variable v-printed        as logical   no-undo.
     4630   define variable varchip-num-main as integer   no-undo.
     4631   define variable varchip-num      as integer   no-undo.
     4632   define buffer bf-acp_trn-doc for ub.trn-doc.
     4633   define buffer bf-pri_trn-doc for ub.trn-doc.
     4634   define buffer bf-vzv_trn-doc for ub.trn-doc.
     4635   define buffer bf_clients     for ub.clients.
     4636   define buffer bf-c_clients   for ub.clients.
     4637   define variable vardel-rec as recid no-undo.
     4638   define variable vardel-doc-code like ub.trn-doc.doc-code no-undo.
     4639   if not available t-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (t-doc). pardoc-rec = recid (t-doc). do on stop undo, return no-apply :   find t-doc where recid (t-doc) = doc-rec exclusive.   end. if t-doc.status_      = 'нередакт':U        or          t-doc.status_      = 'прво':U                 then do:    find t-doc where recid (t-doc) = doc-rec no-lock.    message "Данный документ не может быть удален.".    return no-apply. end.
     4640   if can-do ('накл,запрос':U, t-doc.status_) and t-doc.flag_ then do:
     4641       v-log = no.
     4642       message "Редактирование документа уже закончено. Вы уверены, что хотите удалить его?"
     4643                       view-as alert-box question buttons OK-Cancel update v-log.
     4644       if not v-log then do:   find t-doc where recid (t-doc) = doc-rec no-lock.   return no-apply. end.
     4645   end.
     4646   else do:
     4647     if t-doc.status_ = 'факт':U then do:
     4648       assign
     4649       v-log = no.
     4650       message "Документ закрыт на 'ФАКТ'." skip
     4651               "Удаление документа повлечет за собой пересчет данных, связанных с данным документом."
     4652               "Удалить документ №" t-doc.doc-code "?   Вы уверены ?"
     4653               view-as alert-box question buttons OK-Cancel update v-log.
     4654       if not v-log then do:   find t-doc where recid (t-doc) = doc-rec no-lock.   return no-apply. end.
     4655     end.
     4656     else do:
     4657       assign
     4658       v-log = no.
     4659       message "Удалить документ №" t-doc.doc-code "?   Вы уверены ?"
     4660               view-as alert-box question buttons OK-Cancel update v-log.
     4661       if not v-log then do:   find t-doc where recid (t-doc) = doc-rec no-lock.   return no-apply. end.
     4662     end.
     4663   end.
     4664   br-handle = br-docs:handle in frame d-all-docs .
     4665   assign
     4666     vardel-rec = recid (t-doc).
     4667   if valid-handle (br-handle) then do:
     4668     v-log = br-handle:select-next-row().
     4669     if not v-log then v-log = br-handle:select-prev-row().
     4670     assign
     4671       doc-rec    = recid(t-doc)
     4672       pardoc-rec = recid(t-doc)
     4673     .
     4674   end.
     4675   if search ("del-doc.err") <> ? then do:
     4676     os-delete "del-doc.err".
     4677   end.
     4678   assign
     4679     varchip-num-main = next-value (s-corr-chip, ub).
     4680   find first t-doc where recid(t-doc) = vardel-rec.
     4681   define buffer bufd_doc-line for ub.doc-line  .
     4682   define buffer bufd_gds-dtl  for ub.gds-dtl   .
     4683   if t-doc.ext-doc-type = 'ee':U and
     4684      t-doc.status_      = 'накл':U            and
     4685      t-doc.flag_        = false           then do:
     4686   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_delnabor in g#lib-trn3
     4687   ( input parParentProc ,
     4688     input t-doc.doc-code
     4689   ) no-error
     4690   .
     4691   end.
     4692   assign
     4693     vardel-doc-code = t-doc.doc-code.
     4694   if t-doc.ext-doc-type = 'ev':U and
     4695      t-doc.status_      = 'факт':U            then do:
     4696     find first bf_clients where bf_clients.obj-type = t-doc.obj-type and
     4697                                 bf_clients.obj-code = t-doc.obj-code no-lock.
