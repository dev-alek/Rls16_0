     3702                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3703   run fltfield-add in this-procedure('ship-date', 'Дата отгрузки', '',
     3704                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3705   run fltfield-add in this-procedure('ov', 'Акт', '',
     3706                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3707   run fltfield-add in this-procedure('tot-ov', 'Сумма акта', '',
     3708                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3709   run fltfield-add in this-procedure('exch-code', 'Валюта', 'cur',
     3710                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3711   run fltfield-add in this-procedure('fact-num', 'Порядок закрытия', '',
     3712                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3713   run fltfield-add in this-procedure('PS', 'Примечание', '',
     3714                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3715   run fltfield-add in this-procedure('purch-code', 'Тип приобретения', 'purch-code',
     3716                                                           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3717   run fltfield-add in this-procedure('flora-order-date', 'Дата заказа БУКЕТЫ', '',
     3718                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3719   run fltfield-add in this-procedure('flora-pay-date', 'Оплата заказа БУКЕТЫ', '',
     3720                                       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3721   Filter-Block:
     3722   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3723      ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3724      ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3725   run gbl/filter.w ( parParentProc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3726   RUN OpenBr( yes, no, '':U, 'open':U).
     3727   END.
     3728   end procedure.
     3729   procedure OpenBr :
     3730   define input parameter p-open-query     as logical   no-undo .
     3731   define input parameter p-find-next      as logical   no-undo .
     3732   define input parameter p-find-condition as character no-undo .
     3733   define input parameter fnc              as character no-undo.
     3734   case sort-column-name :
     3735   when "" then do:
     3736   assign
     3737     sort-column-phrase = ""
     3738   .
     3739   end.
     3740   otherwise do:
     3741   assign
     3742     sort-column-phrase = "by " + sort-column-name
     3743   .
     3744   end.
     3745   end case.
     3746   assign
     3747     parschdoc-code  = (if available sch-inv  then sch-inv.doc-code   else ?)
     3748     parschcurr-code = (if available sch-curr then sch-curr.curr-code else ?)
     3749     parschobj-code  = (if available sch-pay  then sch-pay.obj-code   else ?)
     3750     parschcli-type  = (if available sch-cli  then sch-cli.obj-type   else ?)
     3751     parschcli-code  = (if available sch-cli  then sch-cli.obj-code   else ?)
     3752   .
     3753   define variable l-open-query as logical   no-undo .
     3754         run modes-3 (
     3755           p-open-query     ,
     3756           p-find-next      ,
     3757           p-find-condition ,
     3758           fnc
     3759           ).
     3760   if doc-rec <> ? then do:
     3761     if fnc <> "open" then do:
     3762       assign sch-num = sch-num + 1.
     3763       disp sch-num with frame d-all-docs.
     3764     end.
     3765     reposition br-docs to recid doc-rec no-error.
     3766   end.
     3767   else do:
     3768     if fnc <> "open" then do:
     3769       message "Документ не найден.".
     3770       assign sch-num = 0.
     3771     end.
     3772   end.
     3773   run waitfram-hide in this-procedure .
     3774   apply "value-changed" to br-docs in frame d-all-docs.
     3775   apply "entry" to br-docs.
     3776   end procedure.
     3777   procedure modes-3:
     3778   define input parameter p-open-query     as logical   no-undo .
     3779   define input parameter p-find-next      as logical   no-undo .
     3780   define input parameter p-find-condition as character no-undo .
     3781   define input parameter fnc              as character no-undo.
     3782       case list-mode :
     3783         when 'is-flor':U then do:
     3784           if fnc = "open" then do:
     3785             assign
     3786             frame d-all-docs:title = "Заказы на исполнение ВСЕ " .
     3787             assign
     3788              filter-point = "Заказы на исполнение".
     3789   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3790   define variable  l-disable-where-38  as logical   no-undo .
     3791   define variable  l-filter-open-38    as logical   .
     3792   define variable  flt-rec-38       as recid     no-undo .
     3793   define variable  filter-name-38      as character no-undo .
     3794   define variable  where-phrase-38     as character no-undo .
     3795   define variable  sort-phrase-38      as character no-undo .
     3796   define variable  where-phrase-rus-38 as character no-undo .
     3797   define variable  sort-phrase-rus-38  as character no-undo .
     3798   run gbl/flt-get.p
     3799     (input filter-point
     3800     ,output flt-rec-38
     3801     ,output filter-name-38
     3802     ,output where-phrase-38
     3803     ,output sort-phrase-38
     3804     ,output where-phrase-rus-38
     3805     ,output sort-phrase-rus-38
     3806     ).
     3807   if p-open-query then do:
     3808       run set-filter-name in this-procedure
     3809         (INPUT filter-name-38
     3810         ) no-error .
     3811     assign
     3812       l-filter-open-38 = false
     3813     .
     3814     if flt-rec-38 <> ?
     3815       or sort-column-phrase > ""
     3816     then do:
     3817       define variable  parameter-2-38 as character no-undo .
     3818       define variable  parameter-3-38 as character no-undo .
     3819       define variable  parameter-4-38 as character no-undo .
     3820       define variable  parameter-5-38 as character no-undo .
     3821       define variable  parameter-6-38 as character no-undo .
     3822       define variable  parameter-7-38 as character no-undo .
     3823         assign
     3824         parameter-3-38 =
     3825                                 "FOR EACH t-doc"
     3826         parameter-4-38 =
     3827           (
     3828             if (" t-doc.is-flora = yes  " + " " + where-phrase-38) <> ""
     3829             then  't-doc.is-flora = yes'   + " " + where-phrase-38
     3830             else "true"
     3831           )
     3832         parameter-5-38 = (" " + "" + " " + "")
     3833         parameter-6-38 = if sort-phrase-38 = ''
     3834                              then
     3835           (
     3836           " " + " " +
     3837             " " + sort-column-phrase +
     3838           " " + ""
     3839           )
     3840                              else
     3841           (
     3842           " " + " " +
     3843             " " + sort-column-phrase +
     3844           " " + sort-phrase-38
     3845           )
     3846         parameter-7-38 =
     3847           "   "
     3848       .
     3849       do
     3850       on stop undo, leave
     3851       on error undo, leave
     3852       :
     3853         assign
     3854           l-disable-where-38 =
     3855             (" t-doc.is-flora = yes  " + " " + where-phrase-38 = "")
     3856         .
     3857         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3858                             ,input query br-docs:handle
     3859                             ,input parameter-3-38
     3860                             ,input parameter-4-38
     3861                             ,input parameter-5-38
     3862                             ,input parameter-6-38
     3863                             ,input parameter-7-38
     3864                             )
     3865         .
     3866         assign
     3867           l-filter-open-38 = true
     3868         .
     3869       end.
     3870       if l-filter-open-38 = false then do:
     3871         message
     3872           "Ошибка при фильтрации / сортировке" skip
     3873           "Будут показаны записи без учета фильтра" skip
     3874           view-as alert-box .
     3875       end.
     3876       else do:
     3877           assign
     3878             l-query-was-opened = true
     3879           .
     3880       end.
     3881     end.
     3882     if l-filter-open-38 = false then do:
     3883       open query br-docs for each t-doc  use-index obj-date
     3884         where  t-doc.is-flora = yes
     3885     .
     3886         assign
     3887           l-query-was-opened = true
     3888         .
     3889     end.
     3890   end.
     3891   else do:
     3892     assign
     3893       doc-rec = recid( t-doc )
     3894     .
     3895     do
     3896     on stop undo, leave
     3897     on error undo, leave
     3898     :
     3899       if query br-docs:handle:get-buffer-handle(1) = (buffer t-doc:handle) then do:
     3900         assign
     3901         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     3902         parameter-4-38 =
     3903           "where ":u +  't-doc.is-flora = yes'   + " ":u + where-phrase-38 + " ":u + p-find-condition + " " + ""
     3904         parameter-5-38 = " "
     3905       .
     3906         run fltopend_fltfindd in this-procedure  (
     3907                             input this-procedure:handle
     3908                             ,input query br-docs:handle
     3909                             ,input rowid(t-doc)
     3910                             ,input logical(parameter-2-38)
     3911                             ,input no-lock
     3912                             ,input (buffer t-doc:handle)
     3913                             ,input parameter-4-38
     3914                             ,input parameter-5-38
     3915                             ) no-error.
     3916         .
     3917         assign
     3918           doc-rec = integer(return-value)
     3919           v-fltopend-rowid[1] = ?
     3920         .
     3921       end.
     3922       else do:
     3923         assign
     3924         parameter-2-38 = (if p-find-next then "true":u else "false":u )
     3925         parameter-3-38 =  "FOR EACH t-doc"
     3926         parameter-4-38 =
     3927           (
     3928             if (" t-doc.is-flora = yes  " + " " + where-phrase-38) <> ""
     3929             then  't-doc.is-flora = yes'   + " " + where-phrase-38
     3930             else "true"
     3931           )
     3932         parameter-5-38 = (" " + "" + " " + "" + " " + p-find-condition)
     3933         parameter-6-38 = if sort-phrase-38 = ''
     3934                              then
     3935           (
     3936           " " + " " +
     3937             " " + sort-column-phrase +
     3938           " " + ""
     3939           )
     3940                              else
     3941           (
     3942           " " + " " +
     3943             " " + sort-column-phrase +
     3944           " " + sort-phrase-38
     3945           )
     3946         parameter-7-38 =
     3947           "   "
     3948       .
     3949         run fltopend_fltfindq in this-procedure  (
     3950                             input this-procedure:handle
