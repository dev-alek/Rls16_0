      916             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      917             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      918             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      919             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      920             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      921             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      922             v-cntxp-load-time       = bf-cntxp_shop.load-time
      923             v-cntxp-holidays        = bf-cntxp_shop.holidays
      924             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
