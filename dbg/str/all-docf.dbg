     5171   procedure local-export :
     5172   define variable varxmldocfl      as character no-undo.
     5173   define variable varxmldocfl-type as character no-undo.
     5174   define variable v-file-name as character no-undo .
     5175   if not available t-doc then do:
     5176     message "Неправильный выбор документа.".
     5177     return no-apply.
     5178   end.
     5179   run str/xml-doc.p (input t-doc.doc-code, input ?) no-error .
     5180   if error-status :error
     5181   then do:
     5182     if error-status :get-message(1) <> ""
     5183     then do:
     5184       message
     5185         vss-workfile vss-revision vss-description skip
     5186         "Ошибка при вызове программы xml-doc.p" skip
     5187         error-status :get-message(1) skip
     5188         return-value
     5189         view-as alert-box error .
     5190     end.
     5191     else do:
     5192       message
     5193         return-value
     5194         view-as alert-box information .
     5195     end.
     5196     return no-apply .
     5197   end.
     5198   define variable v-sys-key   as character         no-undo.
     5199   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     5200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     5201     (output v-sys-key
     5202     ) no-error .
     5203   assign
     5204   v-file-name =  str-encode ( replace(t-doc.doc-code , "*", "$")
     5205                             , ""
     5206                             , '\/:*?"<>|':U
     5207                             ) + ".xml".
     5208   if search ("xml-doc.bat") <> ? then do:
     5209     os-command silent value(search ("xml-doc.bat") + chr(32) + chr(34) +  v-file-name + chr(34) + chr(32) + v-sys-key + chr(32) + v-cntxt-userid ).
     5210   end.
     5211   else do:
     5212     if search (v-file-name ) <> ? then do:
     5213       message
     5214       substitute("Документ выгружен в файл &1"
     5215                  ,v-file-name
     5216                  )
     5217       view-as alert-box.
     5218     end.
     5219   end.
     5220   end procedure.
     5221   procedure entry-notes :
     5222   if not available t-doc then do:
     5223     message "Неправильный выбор документа.".
     5224     return no-apply.
     5225   end.
     5226   assign
     5227     pardoc-rec = recid (t-doc)
     5228     doc-rec    = recid (t-doc)
     5229   .
     5230   if t-doc.status_ <> 'факт':U and t-doc.discnt-type <> 'касс':U and substring (t-doc.PS, 1, 1) = "@" then
     5231     message "Чтобы программа не могла заново переписать Ваше примечание, удалите знак @.".
     5232   end.
     5233   procedure local-notes:
     5234   do on stop undo, return no-apply:
     5235     find t-d-b where recid (t-d-b) = doc-rec exclusive no-error no-wait.
     5236     if not available t-d-b then do:
     5237        message "Запись захвачена другим пользователем." skip
     5238                "Редактирование запрещено."
     5239        view-as alert-box.
     5240     end.
     5241     else t-d-b.PS = input frame d-all-docs ed-notes.
     5242   end.
     5243   end procedure.
     5244   procedure local-value-changed :
     5245   if available t-doc then do:
     5246     find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = t-doc.boss no-lock no-error.
     5247     if available cli-buf then boss-name = cli-buf.obj-name. else boss-name = ?.
     5248     find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = t-doc.agnt no-lock no-error.
     5249     if available cli-buf then agnt-name = cli-buf.obj-name. else agnt-name = ?.
     5250     find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = t-doc.wrkr no-lock no-error.
     5251     if available cli-buf then wrkr-name = cli-buf.obj-name. else wrkr-name = ?.
     5252   define variable vss-include-info49 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5253   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     5254     (input  t-doc.creid
     5255     ,output v-user-name
     5256     )  .
     5257     find ub.pay-type where ub.pay-type.obj-code = t-doc.pay-code no-lock no-error.
     5258     if available ub.pay-type then disp ub.pay-type.obj-name with frame d-all-docs.
     5259     else disp ? @ ub.pay-type.obj-name with frame d-all-docs.
     5260     ed-notes = t-doc.PS.
     5261     find cli-buf where cli-buf.obj-type = t-doc.obj-type and cli-buf.obj-code = t-doc.obj-code no-lock no-error.
     5262     if available cli-buf then obj-name = cli-buf.obj-name. else obj-name = ?.
     5263     display ed-notes obj-name boss-name agnt-name wrkr-name v-user-name with frame d-all-docs.
     5264     if doc-rec <> recid (t-doc) then do:
     5265       sch-num = 0.
     5266       hide sch-num in frame d-all-docs.
     5267     end.
     5268   end.
     5269   end procedure.
     5270   procedure local-sel :
     5271   if not available t-doc then do:
     5272     message "Неправильный выбор документа.".
     5273     return error.
     5274   end.
     5275   if mark-list <> "" then do:
     5276     assign
     5277       pardoc-rec = recid (t-doc)
     5278       doc-rec = recid (t-doc)
     5279     .
     5280   end.
     5281   else do:
     5282     assign
     5283       mark-list = string(recid(t-doc))
     5284       pardoc-rec = recid (t-doc)
     5285       doc-rec = recid (t-doc)
     5286       .
     5287   end.
     5288   apply "go" to frame d-all-docs.
     5289   end procedure.
     5290   procedure local-conf-rd:
     5291   define buffer bf_clients for ub.clients.
     5292   define buffer bf_shop    for ub.shop.
     5293   define buffer bf_store   for ub.store.
     5294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5295     (input  'holding'
     5296     ,input  ''
     5297     ,input  ''
     5298     ,input  0
     5299     ,input  ''
     5300     ,input  ''
     5301     ,input  ''
     5302     ,input  no
     5303     ,output varhold
     5304     ,output varhold-type
     5305     ) no-error .
     5306   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     5307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     5308     (output v-sys-key
     5309     ) no-error .
     5310   if v-cntxt-obj-type <> "" and
     5311      v-cntxt-obj-code <> 0  then do:
     5312     find first bf_clients where bf_clients.obj-type = v-cntxt-obj-type and
     5313                                 bf_clients.obj-code = v-cntxt-obj-code no-lock.
     5314     if bf_clients.obj-type = 'маг':U then do:
     5315       find first bf_shop where bf_shop.obj-code = bf_clients.obj-code no-lock.
     5316       assign
     5317         v_shift = string(bf_shop.shift-on).
     5318     end.
     5319     else do:
     5320       find first bf_store where bf_store.obj-code = bf_clients.obj-code no-lock.
     5321       assign
     5322         v_shift = string(bf_store.shift-on).
     5323     end.
     5324   end.
     5325   else do:
     5326     assign
     5327       v_shift = "no":u.
     5328   end.
     5329   end procedure.
     5330   procedure local-enable :
     5331   ENABLE
     5332   b-mark when lookup("b-mark":U, bttns) > 0
     5333   b-sel when lookup("b-sel":U, bttns) > 0
     5334   b-quit b-lkp b-print b-exp b-sch b-help br-docs b-rep sch-code sch-date sch-order sch-fact sch-objtype sch-objcode sch-sum ed-notes
     5335   WITH FRAME d-all-docs.
     5336   hide b-akt in frame d-all-docs .
     5337   if v-cntxt-obj-type = 'скл':U or v-cntxt-obj-type = 'маг':U  then do:
     5338     enable b-bc WITH FRAME d-all-docs.
     5339   end.
     5340   run str/run-ext.p ( input ?
     5341                   , input table temp_recid-list
     5342                   , input 'документы':U
     5343                   , input "init"
     5344                   , output v-ext-button-label
     5345                   ) no-error.
     5346   if error-status :error
     5347   then do:
     5348       assign
     5349           b-ext :visible   = no
     5350       .
     5351   end.
     5352   else do:
     5353       assign
     5354           b-ext :label     = v-ext-button-label
     5355           b-ext :visible   = yes
     5356           b-ext :sensitive = yes
     5357       .
     5358   end.
     5359   end procedure.
     5360   procedure proc-close :
     5361     do
     5362     on error undo, return error return-value
     5363     :
     5364     define variable v-close-type as integer   no-undo .
     5365     define variable varchg-inv as logical   no-undo .
     5366               run gbl/d-askw.w
     5367                 (input "Вопрос"
     5368                 ,input "Закрытие запроса на исполнение" + chr(10)
     5369                   + substitute("РН        &1", t-doc.doc-code) + chr(10)
     5370                   + substitute("Дата      &1", string(t-doc.doc-date, '99/99/9999':u)) + chr(10)
     5371                   + (if t-doc.fact-date <> ? then substitute("Факт дата &1", string(t-doc.fact-date, '99/99/9999':u)) else "") + chr(10)
     5372                   + substitute("Оператор  &1", t-doc.user-name)
     5373                 ,input "|^"
     5374                 ,input "Разр+" + '|':u
     5375                     + "Факт+" + '|':u
     5376                     + "Отмена"
     5377                 ,input "Возможно открыть заказ на корректировку до накл- и изменить фактическое количество в разр+|"
     5378                     + "Закрыть заказ без возможности корректировки |"
     5379                     + "Отмена закрытия заказа на исполнение"
     5380                 ,input 1
     5381                 ,input 3
     5382                 ,output v-close-type
     5383                 ).
