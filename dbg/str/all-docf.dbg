     5587     ) no-error .
     5588                       br-docs:refresh() in frame d-all-docs.
     5589                       if error-status:error then do:
     5590                         find t-doc where recid (t-doc) = doc-rec no-lock.
     5591                         return error.
     5592                       end.
     5593               end.
     5594               when 2 then do:
     5595   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5596   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_int-clos in g#lib-trn4
     5597     (input  parparentproc
     5598     ,input  t-doc.doc-code
     5599     ,output table gds-list
     5600     ) no-error .
     5601                       br-docs:refresh() in frame d-all-docs.
     5602                       if error-status:error then do:
     5603                         find t-doc where recid (t-doc) = doc-rec no-lock.
     5604                         return error.
     5605                       end.
     5606                       if t-doc.status_ = 'запрос':U and t-doc.flag_ = true then do:
     5607                               run str/trn-stat.p (input parParentProc,
     5608                                               input this-procedure ,
     5609                                               input  '<закрытие документа>':U,
     5610                                               input  t-doc.doc-code,
     5611                                               input  varcheck-return,
     5612                                               input  v-cntxt-db-num,
     5613                                               input  v-cntxp-in-ov,
     5614                                               input  v-cntxp-rsrv-time,
     5615                                               input  v-cntxp-load-time,
     5616                                               input  v-cntxp-holidays,
     5617                                               input  yes,
     5618                                               output varchg-inv,
     5619                                               output table gds-list) no-error.
     5620                                br-docs:refresh() in frame d-all-docs.
     5621                               if error-status:error then do:
     5622                                 message
     5623                                   vss-workfile vss-revision vss-description skip
     5624                                   "Ошибка при закрытии документа " t-doc.doc-code skip
     5625                                   return-value skip
     5626                                   trim(error-status :get-message(1)) skip
     5627                                   view-as alert-box error.
     5628                                 find t-doc where recid (t-doc) = doc-rec no-lock.
     5629                                 return error.
     5630                               end.
     5631                       end.
     5632               end.
     5633               end case.
     5634     end.
     5635   end procedure.
     5636   procedure get-browse-buffer-handle :
     5637   define output parameter p-browse-buffer-handle      as handle           no-undo.
     5638   do
     5639   on error undo, return error
     5640   :
     5641       assign
     5642           p-browse-buffer-handle = buffer t-doc :handle in frame d-all-docs
     5643       .
     5644   end.
     5645   end procedure.
     5646   procedure get-browse-query-handle :
     5647   define output parameter p-browse-query-handle      as handle           no-undo.
     5648   do
     5649   on error undo, return error
     5650   :
     5651       assign
     5652           p-browse-query-handle = query br-docs :handle in frame d-all-docs
     5653       .
     5654   end.
     5655   end procedure.
