     3954                             ,input parameter-3-38
     3955                             ,input parameter-4-38
     3956                             ,input parameter-5-38
     3957                             ,input parameter-6-38
     3958                             ,input parameter-7-38
     3959                             ,output v-fltopend-rowid
     3960                             ) no-error.
     3961         .
     3962         doc-rec = ?.
     3963       end.
     3964       assign
     3965         l-query-was-opened = true
     3966       .
     3967     end.
     3968   end.
     3969           end.
     3970         end.
     3971         when 'is-flor':U + 'объект':U then do:
     3972           if fnc = "open" then do:
     3973             assign
     3974               frame d-all-docs:title = "Заказы на исполнение  по " + v-cntxt-obj-type + " " + string (v-cntxt-obj-code)
     3975               objects = 2
     3976               .
     3977             assign
     3978               filter-point = list-mode.
