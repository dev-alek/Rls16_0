    16570     tt-fr-doc-line.alc-ref-ab-path           ,
    16571     tt-fr-doc-line.alc-quality-certif-path   ,
    16572     tt-fr-doc-line.alc-imp-type              ,
    16573     tt-fr-doc-line.alc-imp-code              ,
    16574     tt-fr-doc-line.alc-certif-path           ) no-error. if error-status:error then do: return error return-value. end.
    16575       if error-status :error then do:
    16576          message "Ошибка при вызове процедуры сохранения линии."
    16577                  return-value
    16578                  view-as alert-box.
    16579          t-doc.flag_ = false.
    16580          return error.
    16581       end.
    16582       t-doc.flag_ = false.
