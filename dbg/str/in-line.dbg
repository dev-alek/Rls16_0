    11053   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11054   on ' ' of tt-fr-doc-line.last-date in frame d-in-line
    11055   do:
    11056     if (can-query (self, "sensitive")
    11057        and
    11058        self :sensitive = true
    11059        )
    11060     or (can-query (self, "read-only")
    11061        and
    11062        self :read-only = false
    11063        )
    11064     then do:
    11065       assign
