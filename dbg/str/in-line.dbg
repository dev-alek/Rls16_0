     2087   procedure lineattr-exist-flora-gds :
     2088     do
     2089     on error undo, return error return-value
     2090     :
     2091       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2092       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2093       define input  parameter p-prt-code    as integer   no-undo .
     2094       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     2095       define output parameter p-exist as logical   no-undo .
