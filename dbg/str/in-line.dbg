     9278     define variable error-string            as character no-undo.
     9279     define variable v-is-meas               as logical no-undo.
     9280     define variable v-mm-density            as decimal no-undo.
     9281     define variable v-proc as character no-undo.
     9282     define variable vAutomationDegree as integer no-undo extent 3 init [2,1,3].
     9283     define variable v-com-tanks    as character no-undo init "":U .
     9284     define variable v-pl-code-list as character no-undo init "":U .
     9285     define variable ii             as integer   no-undo .
     9286     define variable v-avg-temp     as decimal   no-undo .
     9287     define variable v-ok as logical no-undo .
     9288     define variable v-sec as character no-undo .
     9289     define variable infoSecObj as class ibs.th.str.InfoSection no-undo .
     9290     define variable v-value as character no-undo .
     9291     define variable vErr as character no-undo .
     9292     define variable vWrn as character no-undo .
     9293     define variable vDllVersion as character no-undo .
     9294     define variable V_total1   as decimal no-undo .
     9295     define variable V_total2   as decimal no-undo .
     9296     define variable V_water1   as decimal no-undo .
     9297     define variable V_water2   as decimal no-undo .
     9298     define variable Delta_V1   as decimal no-undo .
     9299     define variable Delta_V2   as decimal no-undo .
     9300     define variable M          as decimal no-undo .
     9301     define variable DeltaOtn_M as decimal no-undo .
     9302     define variable v-warnings as character no-undo .
     9303     _trpomi :
     9304     do on error undo, return error :
     9305       infoSecObj = infoSectionTotal:GetInfoSectionProp(p-sec-num) .
     9306       v-sec = infoSecObj:SectionName .
     9307       find first bf_bef_rvs-doc no-lock where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     9308                                           and bf_bef_rvs-doc.out-code = p-doc-code
     9309                                           and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 3
     9310                                           and entry(2, bf_bef_rvs-doc.rvs-code, "-") = v-sec
     9311                                           no-error .
     9312       if not available bf_bef_rvs-doc
     9313       then do :
     9314         find first bf_bef_rvs-doc no-lock where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     9315                                             and bf_bef_rvs-doc.out-code = p-doc-code
     9316                                             and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 2
     9317                                             no-error .
     9318       end .
     9319       find first bf_aft_rvs-doc no-lock where bf_aft_rvs-doc.rvs-type = 'после_док':U
     9320                                           and bf_aft_rvs-doc.out-code = p-doc-code
     9321                                           and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 3
     9322                                           and entry(2, bf_aft_rvs-doc.rvs-code, "-") = v-sec
     9323                                           no-error .
     9324       if not available bf_aft_rvs-doc
     9325       then do :
     9326         find first bf_aft_rvs-doc no-lock where bf_aft_rvs-doc.rvs-type = 'после_док':U
     9327                                             and bf_aft_rvs-doc.out-code = p-doc-code
     9328                                             and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 2
     9329                                             no-error .
     9330       end .
     9331       if not available bf_bef_rvs-doc
     9332       or not available bf_aft_rvs-doc
     9333       then do :
     9334         if infoSecObj:AccMeth = 1
     9335         and index(this-procedure:name, "in-ladd") > 0
     9336         then do :
     9337           message "Не найдены сверки по документу!" view-as alert-box error .
     9338         end .
     9339         undo _trpomi, return error .
     9340       end .
     9341       find first buf_place no-lock where buf_place.obj-type = infoSectionTotal:ObjType
     9342                                      and buf_place.obj-code = infoSectionTotal:ObjCode
     9343                                      and buf_place.loc1     = infoSecObj:ListTank
     9344                                      and buf_place.status_  = ""
     9345                                      no-error .
     9346       if not available buf_place
     9347       then do :
     9348         message substitute("Не найден текущий резервуар с кодом &1!", infoSecObj:ListTank) view-as alert-box error .
     9349         undo _trpomi, return error .
     9350       end .
     9351       assign v-pl-code-list = v-pl-code-list + string(buf_place.pl-code) + "," .
     9352       run placelib_get-attr  ( input "place-com-tanks"
     9353                               ,input buf_place.obj-code
     9354                               ,input buf_place.obj-type
     9355                               ,input buf_place.pl-code
     9356                               ,output v-value
     9357                               ,output v-ok      )
     9358                               no-error.
     9359       if v-ok then v-com-tanks = v-value .
     9360       if v-com-tanks > ""
     9361       then do :
     9362         do ii = 1 to num-entries(v-com-tanks) :
     9363           find first buf2_place no-lock where buf2_place.obj-type = buf_place.obj-type
     9364                                           and buf2_place.obj-code = buf_place.obj-code
     9365                                           and buf2_place.loc1     = entry(ii, v-com-tanks)
     9366                                           and buf2_place.status_  = ""
     9367                                           no-error .
     9368           if available buf2_place
     9369           then do :
     9370             assign v-pl-code-list = v-pl-code-list + string(buf2_place.pl-code) + "," .
     9371           end .
     9372         end .
     9373       end .
     9374       assign v-pl-code-list = trim(v-pl-code-list, ",") .
     9375       assign
     9376         p-tank-weight-rvs   = 0.0
     9377         p-tank-vol-pomi-rvs = 0.0
     9378       .
     9379       place_ :
     9380       do ii = 1 to num-entries(v-pl-code-list) :
     9381         find first buf_place no-lock where buf_place.pl-code = integer(entry(ii, v-pl-code-list)) no-error .
     9382         if not available buf_place
     9383         then do :
     9384           undo _trpomi, return error .
     9385         end .
     9386         run placelib_get-attr  ( input "place-type"
     9387                                 ,input buf_place.obj-code
     9388                                 ,input buf_place.obj-type
     9389                                 ,input buf_place.pl-code
     9390                                 ,output v-value
     9391                                 ,output v-ok      )
     9392                                 no-error.
     9393         if v-ok then v-place-type = integer(v-value) .
     9394         assign
     9395           v-proc = "CMethodOfMetering7"
     9396         .
     9397         if v-ok
     9398         and v-place-type = 1
     9399         then
     9400         assign
     9401           v-proc = "CMethodOfMetering14"
     9402         .
     9403         run placelib_get-attr  ( input "place-SI"
     9404                                 ,input buf_place.obj-code
     9405                                 ,input buf_place.obj-type
     9406                                 ,input buf_place.pl-code
     9407                                 ,output v-value
     9408                                 ,output v-ok      ) no-error.
     9409         if v-ok
     9410         then place-si = integer(v-value) .
     9411         else place-si = ? .
     9412         find first bf_bef_rvs-line no-lock where bf_bef_rvs-line.rvs-code = bf_bef_rvs-doc.rvs-code
     9413                                              and bf_bef_rvs-line.obj-type = bf_bef_rvs-doc.obj-type
     9414                                              and bf_bef_rvs-line.obj-code = bf_bef_rvs-doc.obj-code
     9415                                              and bf_bef_rvs-line.pl-code  = buf_place.pl-code
     9416                                              and bf_bef_rvs-line.gds-code = p-gds-code
     9417                                              no-error .
     9418         if not available bf_bef_rvs-line
     9419         then do :
     9420           if infoSecObj:AccMeth = 1
     9421           and index(this-procedure:name, "in-ladd") > 0
     9422           then do :
     9423             message "Не заполнена сверка До!" view-as alert-box error .
     9424           end .
     9425           undo _trpomi, return error .
     9426         end .
     9427         if bf_bef_rvs-line.state-measure-qnty = ?
     9428         or bf_bef_rvs-line.state-measure-qnty <= 0
     9429         or bf_bef_rvs-line.state-measure-cli-qnty = ?
     9430         or bf_bef_rvs-line.state-measure-cli-qnty <= 0
     9431         or bf_bef_rvs-line.state-level-total = ?
     9432         or bf_bef_rvs-line.state-level-total <= 0
     9433         or bf_bef_rvs-line.state-level-water = ?
     9434         or bf_bef_rvs-line.state-temperature = ?
     9435         then do :
     9436           if infoSecObj:AccMeth = 1
     9437           and index(this-procedure:name, "in-ladd") > 0
     9438           then do :
     9439             message "Не заполнена сверка До!" view-as alert-box error .
     9440           end .
     9441           undo _trpomi, return error .
     9442         end .
     9443         for first bf_rvs-line-attr no-lock where bf_rvs-line-attr.rvs-code  = bf_bef_rvs-line.rvs-code
     9444                                              and bf_rvs-line-attr.obj-code  = bf_bef_rvs-line.obj-code
     9445                                              and bf_rvs-line-attr.obj-type  = bf_bef_rvs-line.obj-type
     9446                                              and bf_rvs-line-attr.gds-code  = bf_bef_rvs-line.gds-code
     9447                                              and bf_rvs-line-attr.pl-code   = bf_bef_rvs-line.pl-code
     9448                                              and bf_rvs-line-attr.attr-code = "temp-izm-vol"
     9449         :
     9450           v-temp-izm-vol1 = decimal(bf_rvs-line-attr.attr-value) .
     9451         end .
     9452         find first bf_aft_rvs-line no-lock where bf_aft_rvs-line.rvs-code = bf_aft_rvs-doc.rvs-code
     9453                                              and bf_aft_rvs-line.obj-type = bf_aft_rvs-doc.obj-type
     9454                                              and bf_aft_rvs-line.obj-code = bf_aft_rvs-doc.obj-code
     9455                                              and bf_aft_rvs-line.pl-code  = buf_place.pl-code
     9456                                              and bf_aft_rvs-line.gds-code = p-gds-code
     9457                                              no-error .
     9458         if not available bf_aft_rvs-line
     9459         then do :
     9460           if infoSecObj:AccMeth = 1
     9461           and index(this-procedure:name, "in-ladd") > 0
     9462           then do :
     9463             message "Не заполнена сверка После!" view-as alert-box error .
     9464           end .
     9465           undo _trpomi, return error .
     9466         end .
     9467         if bf_aft_rvs-line.state-measure-qnty = ?
     9468         or bf_aft_rvs-line.state-measure-qnty <= 0
     9469         or bf_aft_rvs-line.state-measure-cli-qnty = ?
     9470         or bf_aft_rvs-line.state-measure-cli-qnty <= 0
     9471         or bf_aft_rvs-line.state-level-total = ?
     9472         or bf_aft_rvs-line.state-level-total <= 0
     9473         or bf_aft_rvs-line.state-level-water = ?
     9474         or bf_aft_rvs-line.state-temperature = ?
     9475         then do :
     9476           if infoSecObj:AccMeth = 1
     9477           and index(this-procedure:name, "in-ladd") > 0
     9478           then do :
     9479             message "Не заполнена сверка После!" view-as alert-box error .
     9480           end .
     9481           undo _trpomi, return error .
     9482         end .
     9483         if bf_bef_rvs-line.state-measure-cli-qnty = bf_aft_rvs-line.state-measure-cli-qnty
     9484         then do :
     9485           next place_ .
     9486         end .
     9487         for first bf_rvs-line-attr no-lock where bf_rvs-line-attr.rvs-code  = bf_aft_rvs-line.rvs-code
     9488                                              and bf_rvs-line-attr.obj-code  = bf_aft_rvs-line.obj-code
     9489                                              and bf_rvs-line-attr.obj-type  = bf_aft_rvs-line.obj-type
     9490                                              and bf_rvs-line-attr.gds-code  = bf_aft_rvs-line.gds-code
     9491                                              and bf_rvs-line-attr.pl-code   = bf_aft_rvs-line.pl-code
     9492                                              and bf_rvs-line-attr.attr-code = "temp-izm-vol"
     9493         :
     9494           v-temp-izm-vol2 = decimal(bf_rvs-line-attr.attr-value) .
     9495         end .
     9496         if bf_bef_rvs-line.state-level-water > 0
     9497         then do :
     9498           find last water1_pl-level no-lock where water1_pl-level.pl-code  = bf_bef_rvs-line.pl-code
     9499                                               and water1_pl-level.obj-code = bf_bef_rvs-line.obj-code
     9500                                               and water1_pl-level.obj-type = bf_bef_rvs-line.obj-type
     9501                                               and water1_pl-level.pl-level <= bf_bef_rvs-line.state-level-water
     9502                                               no-error .
     9503           if available water1_pl-level
     9504           then do :
     9505             WaterDeltaV1 = ? .
     9506             for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water1_pl-level.pl-code
     9507                                                   and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     9508                                                   and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     9509                                                   and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     9510                                                   and buf_pl-level-attr.attr-code = "deltaV"
     9511                                                   :
     9512               WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     9513             end .
     9514           end .
     9515           if (available water1_pl-level
     9516           and water1_pl-level.pl-level <> bf_bef_rvs-line.state-level-water)
     9517           or bf_bef_rvs-line.state-level-water < 1
     9518           then do :
     9519             find first water2_pl-level no-lock where water2_pl-level.pl-code  = bf_bef_rvs-line.pl-code
     9520                                                  and water2_pl-level.obj-code = bf_bef_rvs-line.obj-code
     9521                                                  and water2_pl-level.obj-type = bf_bef_rvs-line.obj-type
     9522                                                  and water2_pl-level.pl-level >= bf_bef_rvs-line.state-level-water
     9523                                                  no-error .
     9524             if available water2_pl-level
     9525             then do :
     9526               WaterDeltaV2 = ? .
     9527               for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water2_pl-level.pl-code
     9528                                                     and buf_pl-level-attr.obj-code = water2_pl-level.obj-code
     9529                                                     and buf_pl-level-attr.obj-type = water2_pl-level.obj-type
     9530                                                     and buf_pl-level-attr.pl-level = water2_pl-level.pl-level
     9531                                                     and buf_pl-level-attr.attr-code = "deltaV"
     9532                                                     :
     9533                 WaterDeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     9534               end .
     9535             end .
     9536           end .
     9537         end .
     9538         find last total1_pl-level no-lock where total1_pl-level.pl-code  = bf_bef_rvs-line.pl-code
     9539                                             and total1_pl-level.obj-code = bf_bef_rvs-line.obj-code
     9540                                             and total1_pl-level.obj-type = bf_bef_rvs-line.obj-type
     9541                                             and total1_pl-level.pl-level <= bf_bef_rvs-line.state-level-total
     9542                                             no-error .
     9543         if not available total1_pl-level
     9544         then do :
     9545           if bf_bef_rvs-line.state-level-total >= 1
     9546           then do :
     9547             find first bf_goods no-lock where bf_goods.gds-code = bf_bef_rvs-line.gds-code no-error .
     9548             message
     9549               substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     9550                          ,(if available buf_place then buf_place.loc1 else "?")
     9551                          ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     9552                          ,(if available bf_goods then bf_goods.gds-name else "?") )
     9553             view-as alert-box .
     9554             undo _trpomi, return .
     9555           end .
     9556         end .
     9557         DeltaOtn_K = ? .
     9558         for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     9559                                               and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     9560                                               and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     9561                                               and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     9562                                               and buf_pl-level-attr.attr-code = "tarir-delta"
     9563                                               :
     9564           DeltaOtn_K = decimal(buf_pl-level-attr.attr-value) .
     9565         end .
     9566         if DeltaOtn_K = ? then DeltaOtn_K = 0.25 .
     9567         DeltaV1 = ? .
     9568         for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total1_pl-level.pl-code
     9569                                               and buf_pl-level-attr.obj-code = total1_pl-level.obj-code
     9570                                               and buf_pl-level-attr.obj-type = total1_pl-level.obj-type
     9571                                               and buf_pl-level-attr.pl-level = total1_pl-level.pl-level
     9572                                               and buf_pl-level-attr.attr-code = "deltaV"
     9573                                               :
     9574           DeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     9575         end .
     9576         find first total2_pl-level no-lock where total2_pl-level.pl-code  = bf_bef_rvs-line.pl-code
     9577                                             and total2_pl-level.obj-code = bf_bef_rvs-line.obj-code
     9578                                             and total2_pl-level.obj-type = bf_bef_rvs-line.obj-type
     9579                                             and total2_pl-level.pl-level > bf_bef_rvs-line.state-level-total
     9580                                             no-error .
     9581         if not available total2_pl-level
     9582         then do :
     9583           find first bf_goods no-lock where bf_goods.gds-code = bf_bef_rvs-line.gds-code no-error .
     9584           message
     9585             substitute( 'Для резервуара &1 (&2 &3) не заполнена градуировочная таблица. Запуск ПОкМИ невозможен.'
     9586                        ,(if available buf_place then buf_place.loc1 else "?")
     9587                        ,(if available bf_goods then string(bf_goods.gds-code) else "?")
     9588                        ,(if available bf_goods then bf_goods.gds-name else "?") )
     9589           view-as alert-box .
     9590           undo _trpomi, return .
     9591         end .
     9592         DeltaV2 = ? .
     9593         for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = total2_pl-level.pl-code
     9594                                               and buf_pl-level-attr.obj-code = total2_pl-level.obj-code
     9595                                               and buf_pl-level-attr.obj-type = total2_pl-level.obj-type
     9596                                               and buf_pl-level-attr.pl-level = total2_pl-level.pl-level
     9597                                               and buf_pl-level-attr.attr-code = "deltaV"
     9598                                               :
     9599           DeltaV2 = decimal(buf_pl-level-attr.attr-value) no-error .
     9600         end .
     9601         if available water2_pl-level
     9602         then do :
     9603           CalibTable = Substitute("&1=&2", water2_pl-level.pl-level, (water2_pl-level.pl-qnty / 1000)) + (if WaterDeltaV2 > 0 then ("=" + trim(string(WaterDeltaV2, ">>9.9999"))) else "") + chr(10) + CalibTable .
     9604         end .
     9605         if available water1_pl-level
     9606         then do :
     9607           CalibTable = Substitute("&1=&2", water1_pl-level.pl-level, (water1_pl-level.pl-qnty / 1000)) + (if WaterDeltaV1 > 0 then ("=" + trim(string(WaterDeltaV1, ">>9.9999"))) else "") + chr(10) + CalibTable .
     9608         end .
     9609         if available total1_pl-level
     9610         then do :
     9611           CalibTable = CalibTable + Substitute("&1=&2", total1_pl-level.pl-level, (total1_pl-level.pl-qnty / 1000)) + (if DeltaV1 > 0 then ("=" + trim(string(DeltaV1, ">>9.9999"))) else "") + chr(10) .
     9612         end .
     9613         CalibTable = CalibTable + Substitute("&1=&2", total2_pl-level.pl-level, (total2_pl-level.pl-qnty / 1000)) + (if DeltaV2 > 0 then ("=" + trim(string(DeltaV2, ">>9.9999"))) else "") + chr(10) .
     9614         if bf_bef_rvs-line.state-level-total < 1
     9615         or bf_bef_rvs-line.state-level-water < 1
     9616         then do :
     9617           find first buf_pl-level no-lock where buf_pl-level.pl-code  = bf_bef_rvs-line.pl-code
     9618                                            and buf_pl-level.obj-code = bf_bef_rvs-line.obj-code
     9619                                            and buf_pl-level.obj-type = bf_bef_rvs-line.obj-type
     9620                                            and buf_pl-level.pl-level = 0
     9621                                            no-error .
     9622           if not available buf_pl-level
     9623           then do :
     9624             CalibTable = "0=0" + chr(10) + CalibTable .
     9625           end .
     9626         end .
     9627         if bf_aft_rvs-line.state-level-water > 0
     9628         and bf_aft_rvs-line.state-level-water <> bf_bef_rvs-line.state-level-water
     9629         then do :
     9630           find last water1_pl-level no-lock where water1_pl-level.pl-code  = bf_aft_rvs-line.pl-code
     9631                                               and water1_pl-level.obj-code = bf_aft_rvs-line.obj-code
     9632                                               and water1_pl-level.obj-type = bf_aft_rvs-line.obj-type
     9633                                               and water1_pl-level.pl-level <= bf_aft_rvs-line.state-level-water
     9634                                               no-error .
     9635           if available water1_pl-level
     9636           then do :
     9637             WaterDeltaV1 = ? .
     9638             for first buf_pl-level-attr no-lock where buf_pl-level-attr.pl-code  = water1_pl-level.pl-code
     9639                                                   and buf_pl-level-attr.obj-code = water1_pl-level.obj-code
     9640                                                   and buf_pl-level-attr.obj-type = water1_pl-level.obj-type
     9641                                                   and buf_pl-level-attr.pl-level = water1_pl-level.pl-level
     9642                                                   and buf_pl-level-attr.attr-code = "deltaV"
     9643                                                   :
     9644               WaterDeltaV1 = decimal(buf_pl-level-attr.attr-value) no-error .
     9645             end .
     9646           end .
     9647           if (available water1_pl-level
     9648           and water1_pl-level.pl-level <> bf_aft_rvs-line.state-level-water)
     9649           or bf_aft_rvs-line.state-level-water < 1
     9650           then do :
     9651             find first water2_pl-level no-lock where water2_pl-level.pl-code  = bf_aft_rvs-line.pl-code
