     4069       define temp-table tt-rvs-line-pump-delta no-undo like ub.rvs-line-pump
     4070         field deltaVol as decimal
     4071         field density as decimal
     4072         field is-err as logical
     4073         field find-pair as logical
     4074       .
     4075       define variable infoSectionsTotal       as class InfoSectionsTotal no-undo.
     4076       define variable tanksForm               as class ibs.th.str.ptrl.forms.tanksections no-undo.
     4077       define variable v-prt-autoent-obj-type as character    no-undo .
     4078       define variable v-prt-autoent-obj-code as character    no-undo .
     4079       define variable v-prt-start-real-date  like ub.rvs-line.real-date    no-undo .
     4080       define variable v-prt-start-real-time  like ub.rvs-line.real-time    no-undo .
     4081       define variable v-prt-end-real-date    like ub.rvs-line.real-date    no-undo .
     4082       define variable v-prt-end-real-time    like ub.rvs-line.real-time    no-undo .
     4083       define variable v-prt-fio              as character    no-undo .
     4084       define variable v-prt-ptbotype         as character    no-undo .
     4085       define variable v-prt-ptbocode         as character    no-undo .
     4086       define variable was_setting            as logical      no-undo initial no .
     4087       define variable ptoldfilvalue          as character    no-undo.
     4088       define variable ptoldfiltype           as character    no-undo.
     4089       define variable stfactplvalue          as character    no-undo initial ? .
     4090       define variable stfactpltype           as character    no-undo initial ? .
     4091       define variable varupd-fact-qnty       as logical      no-undo initial yes .
     4092       define variable varrevision            as logical      no-undo initial no  .
     4093       define variable varpercrev             as decimal      no-undo initial ?   .
     4094       define variable varauto-tank           as logical      no-undo initial no  .
     4095       define variable varpercauto            as decimal      no-undo initial ?   .
     4096       define variable varinv                 as logical      no-undo initial no  .
     4097       define variable varpercinv             as decimal      no-undo initial ?   .
     4098       define variable varinv-set             as logical      no-undo initial no  .
     4099       define variable varrn-algo             as logical      no-undo initial no  .
     4100       define variable varrn-acc-ship         as decimal      no-undo .
     4101       define variable varcar-num             as character    no-undo .
     4102       define variable is-vir as logical no-undo.
     4103       define variable v-value as character no-undo.
     4104       define variable v-value2 as character no-undo.
     4105       define variable v-ok as logical no-undo.
     4106       define variable pl-rvd-dens as logical no-undo .
     4107       define variable pl-rvd-lvl as logical no-undo .
     4108       define variable pl-rvd-temp as logical no-undo .
     4109       procedure return-rvs-qnty :
     4110         define  input parameter p-doc-code            like ub.trn-doc.doc-code            no-undo .
     4111         define  input parameter p-gds-code            like ub.goods.gds-code              no-undo .
     4112         define  input parameter p-pl-code             like ub.rvs-line.pl-code            no-undo .
     4113         define output parameter p-rvs-qnty-before     like ub.rvs-line.state-measure-qnty no-undo .
     4114         define output parameter p-rvs-qnty-after      like ub.rvs-line.state-measure-qnty no-undo .
     4115         define output parameter p-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     4116         define output parameter p-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     4117         define output parameter p-delta-mass-qnty     as decimal no-undo .
     4118         define output parameter p-trk-err             as logical no-undo .
     4119         define buffer bf_bef_rvs-doc  for ub.rvs-doc  .
     4120         define buffer bf_aft_rvs-doc  for ub.rvs-doc  .
     4121         define buffer bf_bef_rvs-line for ub.rvs-line .
     4122         define buffer bf_aft_rvs-line for ub.rvs-line .
     4123         define buffer bf_rvs-line-attr for ub.rvs-line-attr .
     4124         define buffer buf_rvs-line-pump for ub.rvs-line-pump .
     4125         assign
     4126           p-rvs-qnty-before     = 0.0
     4127           p-rvs-qnty-after      = 0.0
     4128           p-rvs-cli-qnty-before = 0.0
     4129           p-rvs-cli-qnty-after  = 0.0
     4130         .
     4131         empty temp-table tt-rvs-line-pump-delta .
     4132         for each bf_bef_rvs-doc no-lock
     4133           where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     4134             and bf_bef_rvs-doc.out-code = p-doc-code
     4135         :
     4136           for each bf_bef_rvs-line no-lock
     4137             where bf_bef_rvs-line.rvs-code = bf_bef_rvs-doc.rvs-code
     4138               and bf_bef_rvs-line.obj-type = bf_bef_rvs-doc.obj-type
     4139               and bf_bef_rvs-line.obj-code = bf_bef_rvs-doc.obj-code
     4140               and bf_bef_rvs-line.gds-code = p-gds-code
     4141           :
     4142             if p-pl-code <> ?
     4143               and p-pl-code <> bf_bef_rvs-line.pl-code
     4144             then do:
     4145               next .
     4146             end.
     4147             assign
     4148               p-rvs-qnty-before     = p-rvs-qnty-before     + bf_bef_rvs-line.state-measure-qnty
     4149               p-rvs-cli-qnty-before = p-rvs-cli-qnty-before + bf_bef_rvs-line.state-measure-cli-qnty
     4150             .
     4151             for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code = bf_bef_rvs-line.rvs-code
     4152                                                  and buf_rvs-line-pump.obj-type = bf_bef_rvs-line.obj-type
     4153                                                  and buf_rvs-line-pump.obj-code = bf_bef_rvs-line.obj-code
     4154                                                  and buf_rvs-line-pump.pl-code  = bf_bef_rvs-line.pl-code
     4155                                                  and buf_rvs-line-pump.gds-code = bf_bef_rvs-line.gds-code
     4156             :
     4157               create tt-rvs-line-pump-delta .
     4158               buffer-copy buf_rvs-line-pump to tt-rvs-line-pump-delta
     4159               assign
     4160                 tt-rvs-line-pump-delta.rvs-code = "before-doc" + entry(2, buf_rvs-line-pump.rvs-code, "-")
     4161                 tt-rvs-line-pump-delta.density = (bf_bef_rvs-line.state-density / 2)
     4162               .
     4163               if tt-rvs-line-pump-delta.state-el-cnt = ?
     4164               or tt-rvs-line-pump-delta.state-el-cnt <= 0
     4165               then do :
     4166                 tt-rvs-line-pump-delta.is-err = yes .
     4167               end .
     4168             end.
     4169           end.
     4170         end.
     4171         for each bf_aft_rvs-doc no-lock
     4172           where bf_aft_rvs-doc.rvs-type = 'после_док':U
     4173             and bf_aft_rvs-doc.out-code = p-doc-code
     4174         :
     4175           for each bf_aft_rvs-line no-lock
     4176             where bf_aft_rvs-line.rvs-code = bf_aft_rvs-doc.rvs-code
     4177               and bf_aft_rvs-line.obj-type = bf_aft_rvs-doc.obj-type
     4178               and bf_aft_rvs-line.obj-code = bf_aft_rvs-doc.obj-code
     4179               and bf_aft_rvs-line.gds-code = p-gds-code
     4180           :
     4181             if p-pl-code <> ?
     4182               and p-pl-code <> bf_aft_rvs-line.pl-code
     4183             then do:
     4184               next .
     4185             end.
     4186             find first bf_rvs-line-attr no-lock
     4187               where bf_rvs-line-attr.rvs-code = bf_aft_rvs-line.rvs-code
     4188                 and bf_rvs-line-attr.obj-type = bf_aft_rvs-line.obj-type
     4189                 and bf_rvs-line-attr.obj-code = bf_aft_rvs-line.obj-code
     4190                 and bf_rvs-line-attr.pl-code = bf_aft_rvs-line.pl-code
     4191                 and bf_rvs-line-attr.gds-code = p-gds-code
     4192                 and bf_rvs-line-attr.attr-code = "delta-mass-qnty"
     4193                 no-error.
     4194             if available (bf_rvs-line-attr)
     4195             then p-delta-mass-qnty = decimal (bf_rvs-line-attr.attr-value).
     4196             else p-delta-mass-qnty = 0.65.
     4197             assign
     4198               p-rvs-qnty-after     = p-rvs-qnty-after     + bf_aft_rvs-line.state-measure-qnty
     4199               p-rvs-cli-qnty-after = p-rvs-cli-qnty-after + bf_aft_rvs-line.state-measure-cli-qnty
     4200             .
     4201             release bf_rvs-line-attr.
     4202             for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code = bf_aft_rvs-line.rvs-code
     4203                                                  and buf_rvs-line-pump.obj-type = bf_aft_rvs-line.obj-type
     4204                                                  and buf_rvs-line-pump.obj-code = bf_aft_rvs-line.obj-code
     4205                                                  and buf_rvs-line-pump.pl-code  = bf_aft_rvs-line.pl-code
     4206                                                  and buf_rvs-line-pump.gds-code = bf_aft_rvs-line.gds-code
     4207             :
     4208               find first tt-rvs-line-pump-delta where tt-rvs-line-pump-delta.rvs-code    = "before-doc" + entry(2, buf_rvs-line-pump.rvs-code, "-")
     4209                                                   and tt-rvs-line-pump-delta.obj-type    = buf_rvs-line-pump.obj-type
     4210                                                   and tt-rvs-line-pump-delta.obj-code    = buf_rvs-line-pump.obj-code
     4211                                                   and tt-rvs-line-pump-delta.pl-code     = buf_rvs-line-pump.pl-code
     4212                                                   and tt-rvs-line-pump-delta.gds-code    = buf_rvs-line-pump.gds-code
     4213                                                   and tt-rvs-line-pump-delta.pump-code   = buf_rvs-line-pump.pump-code
     4214                                                   and tt-rvs-line-pump-delta.nozzle-code = buf_rvs-line-pump.nozzle-code
     4215                                                   no-error .
     4216               if not available tt-rvs-line-pump-delta
     4217               then do :
     4218                 create tt-rvs-line-pump-delta .
     4219                 buffer-copy buf_rvs-line-pump to tt-rvs-line-pump-delta
     4220                 assign
     4221                   tt-rvs-line-pump-delta.rvs-code = "after-doc" + entry(2, buf_rvs-line-pump.rvs-code, "-")
     4222                   tt-rvs-line-pump-delta.is-err = yes
     4223                 .
     4224               end .
     4225               else do :
     4226                 tt-rvs-line-pump-delta.find-pair = yes .
     4227                 if tt-rvs-line-pump-delta.state-el-cnt > buf_rvs-line-pump.state-el-cnt
     4228                 then do :
     4229                   tt-rvs-line-pump-delta.is-err = yes .
     4230                 end .
     4231                 else do :
     4232                   tt-rvs-line-pump-delta.deltaVol = buf_rvs-line-pump.state-el-cnt - tt-rvs-line-pump-delta.state-el-cnt .
     4233                   tt-rvs-line-pump-delta.density = tt-rvs-line-pump-delta.density + (bf_aft_rvs-line.state-density / 2) .
     4234                 end .
     4235               end .
     4236             end .
     4237           end.
     4238         end.
     4239         p-trk-err = no .
     4240         find first tt-rvs-line-pump-delta where tt-rvs-line-pump-delta.is-err no-error .
     4241         if available tt-rvs-line-pump-delta
     4242         then do :
     4243           p-trk-err = yes .
     4244           return .
     4245         end .
     4246         for each tt-rvs-line-pump-delta :
     4247           assign
     4248             p-rvs-qnty-after     = p-rvs-qnty-after     + tt-rvs-line-pump-delta.deltaVol
     4249             p-rvs-cli-qnty-after = p-rvs-cli-qnty-after + (tt-rvs-line-pump-delta.deltaVol * tt-rvs-line-pump-delta.density)
     4250           .
     4251         end .
     4252       end procedure.
     4253       procedure return-rvs-sec-qnty :
     4254         define  input parameter p-doc-code            like ub.trn-doc.doc-code            no-undo .
     4255         define  input parameter p-gds-code            like ub.goods.gds-code              no-undo .
     4256         define  input parameter p-sec-name            as character                        no-undo .
     4257         define  input parameter p-loc1                as character                        no-undo .
     4258         define output parameter p-rvs-qnty-before     like ub.rvs-line.state-measure-qnty no-undo .
     4259         define output parameter p-rvs-qnty-after      like ub.rvs-line.state-measure-qnty no-undo .
     4260         define output parameter p-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     4261         define output parameter p-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     4262         define buffer bf_bef_rvs-doc  for ub.rvs-doc  .
     4263         define buffer bf_aft_rvs-doc  for ub.rvs-doc  .
     4264         define buffer bf_bef_rvs-line for ub.rvs-line .
     4265         define buffer bf_aft_rvs-line for ub.rvs-line .
     4266         define buffer bf_place        for ub.place .
     4267         assign
     4268           p-rvs-qnty-before     = 0.0
     4269           p-rvs-qnty-after      = 0.0
     4270           p-rvs-cli-qnty-before = 0.0
     4271           p-rvs-cli-qnty-after  = 0.0
     4272         .
     4273         find first bf_bef_rvs-doc no-lock where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     4274                                             and bf_bef_rvs-doc.out-code = p-doc-code
     4275                                             and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 3
     4276                                             and entry(2, bf_bef_rvs-doc.rvs-code, "-") = p-sec-name
     4277                                             no-error .
     4278         if not available bf_bef_rvs-doc
     4279         then do :
     4280           find first bf_bef_rvs-doc no-lock where bf_bef_rvs-doc.rvs-type = 'перед_док':U
     4281                                               and bf_bef_rvs-doc.out-code = p-doc-code
     4282                                               and num-entries(bf_bef_rvs-doc.rvs-code, "-") = 2
     4283                                               no-error .
     4284         end .
     4285         if available bf_bef_rvs-doc
     4286         then do :
     4287           for first bf_place no-lock where bf_place.obj-type = bf_bef_rvs-doc.obj-type
     4288                                        and bf_place.obj-code = bf_bef_rvs-doc.obj-code
     4289                                        and bf_place.loc1     = p-loc1
     4290                                        and bf_place.status_  = "",
     4291           each bf_bef_rvs-line no-lock
     4292             where bf_bef_rvs-line.rvs-code = bf_bef_rvs-doc.rvs-code
     4293               and bf_bef_rvs-line.obj-type = bf_bef_rvs-doc.obj-type
     4294               and bf_bef_rvs-line.obj-code = bf_bef_rvs-doc.obj-code
     4295               and bf_bef_rvs-line.gds-code = p-gds-code
     4296               and bf_bef_rvs-line.pl-code  = bf_place.pl-code
     4297           :
     4298             assign
     4299               p-rvs-qnty-before     = p-rvs-qnty-before     + bf_bef_rvs-line.state-measure-qnty
     4300               p-rvs-cli-qnty-before = p-rvs-cli-qnty-before + bf_bef_rvs-line.state-measure-cli-qnty
     4301             .
     4302           end.
     4303         end.
     4304         find first bf_aft_rvs-doc no-lock where bf_aft_rvs-doc.rvs-type = 'после_док':U
     4305                                             and bf_aft_rvs-doc.out-code = p-doc-code
     4306                                             and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 3
     4307                                             and entry(2, bf_aft_rvs-doc.rvs-code, "-") = p-sec-name
     4308                                             no-error .
     4309         if not available bf_aft_rvs-doc
     4310         then do :
     4311           find first bf_aft_rvs-doc no-lock where bf_aft_rvs-doc.rvs-type = 'после_док':U
     4312                                               and bf_aft_rvs-doc.out-code = p-doc-code
     4313                                               and num-entries(bf_aft_rvs-doc.rvs-code, "-") = 2
     4314                                               no-error .
     4315         end .
     4316         if available bf_aft_rvs-doc
     4317         then do :
     4318           for first bf_place no-lock where bf_place.obj-type = bf_aft_rvs-doc.obj-type
     4319                                        and bf_place.obj-code = bf_aft_rvs-doc.obj-code
     4320                                        and bf_place.loc1     = p-loc1
     4321                                        and bf_place.status_  = "",
     4322           each bf_aft_rvs-line no-lock
     4323             where bf_aft_rvs-line.rvs-code = bf_aft_rvs-doc.rvs-code
     4324               and bf_aft_rvs-line.obj-type = bf_aft_rvs-doc.obj-type
     4325               and bf_aft_rvs-line.obj-code = bf_aft_rvs-doc.obj-code
     4326               and bf_aft_rvs-line.gds-code = p-gds-code
     4327               and bf_aft_rvs-line.pl-code  = bf_place.pl-code
     4328           :
     4329             assign
     4330               p-rvs-qnty-after     = p-rvs-qnty-after     + bf_aft_rvs-line.state-measure-qnty
     4331               p-rvs-cli-qnty-after = p-rvs-cli-qnty-after + bf_aft_rvs-line.state-measure-cli-qnty
     4332             .
     4333           end.
     4334         end.
     4335       end procedure.
     4336       procedure check-before :
     4337         define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     4338         define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     4339         define input  parameter p-pl-code  like ub.doc-pl.pl-code   no-undo .
     4340         define buffer buf_goods         for ub.goods .
     4341         define buffer bf_after_rvs-doc  for ub.rvs-doc  .
     4342         define buffer bf_after_rvs-line for ub.rvs-line .
     4343         do
     4344         on error undo, return error substitute( "&1 (check-before). &2&3&4", vss-include-info30, return-value, chr(10), error-status :get-message ( 1 ) )
     4345         :
     4346           find first buf_goods no-lock
     4347             where buf_goods.gds-code = p-gds-code
     4348             .
     4349           find first bf_after_rvs-doc no-lock
     4350             where bf_after_rvs-doc.rvs-type = 'после_док':U
     4351               and bf_after_rvs-doc.out-code = p-doc-code
     4352             no-error .
     4353           if available bf_after_rvs-doc then do:
     4354             for each tt-doc-pl no-lock
     4355             :
     4356               if p-pl-code <> ?
     4357                 and tt-doc-pl.pl-code <> p-pl-code
     4358               then do:
     4359                 next.
     4360               end.
     4361               find first bf_after_rvs-line no-lock
     4362                 where bf_after_rvs-line.rvs-code = bf_after_rvs-doc.rvs-code
     4363                   and bf_after_rvs-line.obj-type = bf_after_rvs-doc.obj-type
     4364                   and bf_after_rvs-line.obj-code = bf_after_rvs-doc.obj-code
     4365                   and bf_after_rvs-line.pl-code  = tt-doc-pl.pl-code
     4366                   and bf_after_rvs-line.gds-code = p-gds-code
     4367                 no-error .
     4368               if not available bf_after_rvs-line then do:
     4369                 message
     4370                   "По данному товару нет заготовки для сверки <<после налива топлива>>"
     4371                   "по резервуару" tt-doc-pl.pl-code "."
     4372                   view-as alert-box error .
     4373                 return error .
     4374               end.
     4375               if bf_after_rvs-line.state-measure-qnty <> ? then do:
     4376                 message
     4377                   "Уже задан фактический остаток в сверке <<после налива топлива>>"
     4378                   "по резервуару" tt-doc-pl.pl-code "."
     4379                   "Следует удалить сверки и создать их снова."
     4380                   view-as alert-box error .
     4381                 return error .
     4382               end.
     4383               if ptrlprop-olddens <> true
     4384                 and bf_after_rvs-line.state-density <> ?
     4385                 and buf_goods.unit-base <> buf_goods.unit-cli
     4386               then do:
     4387                 message
     4388                   "Уже задана фактическая плотность в сверке <<после налива топлива>>"
     4389                   "по резервуару" tt-doc-pl.pl-code "."
     4390                   "Следует удалить сверки и создать их снова."
     4391                   view-as alert-box error .
     4392                 return error .
     4393               end.
     4394             end.
     4395           end.
     4396           else do:
     4397             message "Не создана сверка <<после налива топлива>>." view-as alert-box error .
     4398             return error .
     4399           end.
     4400         end.
     4401       end procedure.
     4402       procedure check-after :
     4403         define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     4404         define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     4405         define input  parameter p-pl-code  like ub.doc-pl.pl-code   no-undo .
     4406         define buffer buf_before_rvs-doc  for ub.rvs-doc  .
     4407         define buffer buf_before_rvs-line for ub.rvs-line .
     4408         define buffer buf_place           for ub.place .
     4409         define variable ii as integer no-undo .
     4410         do
     4411         on error undo, return error return-value
     4412         :
     4413           find first buf_before_rvs-doc no-lock
     4414             where buf_before_rvs-doc.rvs-type = 'перед_док':U
     4415               and buf_before_rvs-doc.out-code = p-doc-code
     4416             no-error .
     4417           if available buf_before_rvs-doc then do:
     4418             for each tt-doc-pl no-lock
     4419             on error undo, return error return-value
     4420             :
     4421               if is-gas(p-gds-code) then next.
     4422               run placelib_get-attr(input "place-virtual"
     4423                                    ,input tt-doc-pl.obj-code
     4424                                    ,input tt-doc-pl.obj-type
     4425                                    ,input tt-doc-pl.pl-code
     4426                                    ,output v-value
     4427                                    ,output v-ok) no-error.
     4428               is-vir = if (v-ok and logical(v-value)) then true else false.
     4429               if is-vir then next.
     4430               find first buf_place no-lock where buf_place.obj-type = tt-doc-pl.obj-type
     4431                                              and buf_place.obj-code = tt-doc-pl.obj-code
     4432                                              and buf_place.pl-code  = tt-doc-pl.pl-code
     4433                                              no-error .
     4434               run placelib_get-attr  (
     4435                  input "place-com-tanks"
     4436                 ,input tt-doc-pl.obj-code
     4437                 ,input tt-doc-pl.obj-type
     4438                 ,input tt-doc-pl.pl-code
     4439                 ,output v-value
     4440                 ,output v-ok      )
     4441               no-error.
     4442               if  v-ok
     4443               and v-value > ""
     4444               then do :
     4445                 v-value = v-value + "," + buf_place.loc1 .
     4446                 do ii = 1 to num-entries(v-value) :
     4447                   find first buf_place no-lock where buf_place.obj-type = tt-doc-pl.obj-type
     4448                                                  and buf_place.obj-code = tt-doc-pl.obj-code
     4449                                                  and buf_place.loc1     = entry(ii, v-value)
     4450                                                  and buf_place.status_  = ""
     4451                                                  no-error .
     4452                   if available buf_place
     4453                   then do :
     4454                     find first buf_before_rvs-line no-lock
     4455                       where buf_before_rvs-line.rvs-code = buf_before_rvs-doc.rvs-code
     4456                         and buf_before_rvs-line.obj-type = buf_before_rvs-doc.obj-type
     4457                         and buf_before_rvs-line.obj-code = buf_before_rvs-doc.obj-code
     4458                         and buf_before_rvs-line.pl-code  = buf_place.pl-code
     4459                         and buf_before_rvs-line.gds-code = p-gds-code
     4460                       no-error .
     4461                     if not available buf_before_rvs-line then do:
     4462                       message
     4463                         "По данному товару нет заготовки для сверки <<до налива топлива>>"
     4464                         "по резервуару" buf_place.pl-code "."
     4465                         view-as alert-box error .
     4466                       return error .
     4467                     end.
     4468                     if buf_before_rvs-line.state-measure-qnty = ?
     4469                     then do:
     4470                       message
     4471                         "Не заполнены данные по резервуару №" buf_place.loc1
     4472                         " в документе сверки «До»!"
     4473                         view-as alert-box error .
     4474                       return error .
     4475                     end.
     4476                   end .
     4477                 end .
     4478               end .
     4479               else do :
     4480                 if p-pl-code <> ?
     4481                 and tt-doc-pl.pl-code <> p-pl-code
     4482                 then do:
     4483                   next.
     4484                 end.
     4485                 find first buf_before_rvs-line no-lock
     4486                   where buf_before_rvs-line.rvs-code = buf_before_rvs-doc.rvs-code
     4487                     and buf_before_rvs-line.obj-type = buf_before_rvs-doc.obj-type
     4488                     and buf_before_rvs-line.obj-code = buf_before_rvs-doc.obj-code
     4489                     and buf_before_rvs-line.pl-code  = tt-doc-pl.pl-code
     4490                     and buf_before_rvs-line.gds-code = p-gds-code
     4491                   no-error .
     4492                 if not available buf_before_rvs-line then do:
     4493                   message
     4494                     "По данному товару нет заготовки для сверки <<до налива топлива>>"
     4495                     "по резервуару" tt-doc-pl.pl-code "."
     4496                     view-as alert-box error .
     4497                   return error .
     4498                 end.
     4499                 if buf_before_rvs-line.state-measure-qnty = ?
     4500                 then do:
     4501                   message
     4502                     "Не задан фактический остаток в сверке <<до налива топлива>>"
     4503                     "по резервуару" tt-doc-pl.pl-code "." skip
     4504                     "Следует удалить сверки и создать их снова."
     4505                     view-as alert-box error .
     4506                   return error .
     4507                 end.
     4508                 if buf_before_rvs-line.state-density = ?
     4509                 then do:
     4510                   message
     4511                     "Не задана фактическая плотность в сверке <<до налива топлива>>"
     4512                     "по резервуару" tt-doc-pl.pl-code "." skip
     4513                     "Следует удалить сверки и создать их снова."
     4514                     view-as alert-box error .
     4515                   return error .
     4516                 end.
     4517               end .
     4518             end.
     4519           end.
     4520           else do:
     4521             message "Не создана сверка <<до налива топлива>>." view-as alert-box error .
     4522             return error .
     4523           end.
     4524         end.
     4525       end procedure.
     4526       procedure action-rvs-line :
     4527         define input parameter p-action      as   character           no-undo .
     4528         define input parameter p-action-type as   character           no-undo .
     4529         define input parameter p-rvs-type    like ub.rvs-doc.rvs-type no-undo .
     4530         define output parameter p-pl-code      like ub.place.pl-code    no-undo .
     4531         define buffer buf_doc-line for ub.doc-line.
     4532         block_tr:
     4533         do transaction
     4534         on error  undo block_tr, return error substitute( "&1 (action-rvs-line). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4535         on stop   undo block_tr, return error substitute( "&1 (action-rvs-line). stop", vss-workfile )
     4536         on endkey undo block_tr, return error substitute( "&1 (action-rvs-line). endkey", vss-workfile )
     4537         :
     4538           define variable v-rvs-code     like ub.rvs-doc.rvs-code no-undo .
     4539           define variable v-act-name     as   character           no-undo .
     4540           define variable v-log          as   logical             no-undo .
     4541           define variable is-rvs-place   as   logical             no-undo .
     4542           define variable varnum         as   integer             no-undo.
     4543           define variable varcur-rvs     as   integer             no-undo.
     4544           define variable v-today        as   date                no-undo.
     4545           define variable v-time         as   integer             no-undo.
     4546           define variable v-value        as character no-undo .
     4547           define variable v-value2       as character no-undo .
     4548           define variable v-ok           as logical   no-undo .
     4549           define variable ii             as integer   no-undo .
     4550           define variable v-com-vessel-rvs as logical no-undo init no .
     4551           define variable v-com-vessel-is-meas as logical no-undo init no .
     4552           define variable v-code         as character    no-undo.
     4553           define variable is-com-tanks   as logical no-undo init no .
     4554           define variable v-pump-err     as character no-undo init "":U .
     4555           define variable v-pl-list      as character no-undo init "":U .
     4556           define buffer buf_rvs-doc       for ub.rvs-doc .
     4557           define buffer buf_rvs-line      for ub.rvs-line .
     4558           define buffer buf_rvs-line-pump for ub.rvs-line-pump .
     4559           define buffer buf_place         for ub.place .
     4560           define buffer bf_pump-nozzle    for ub.pump-nozzle.
     4561           define buffer bf_pl-pump-nozzle for ub.pl-pump-nozzle.
     4562           define buffer bf_pl-gds         for ub.pl-gds.
     4563           define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     4564           define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     4565           define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     4566           define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     4567           define variable v-rvs-density         like ub.rvs-line.state-density          no-undo .
     4568           define variable v-com-tank-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     4569           define variable v-com-tank-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     4570           define variable v-com-tank-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     4571           define variable v-com-tank-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     4572           define variable v-attr-type           as character no-undo .
     4573           define variable v-attr-value          as character   no-undo .
     4574           define variable v-delta-mass-qnty as decimal   no-undo .
     4575           define variable v-com-tank-delta-mass-qnty as decimal   no-undo .
     4576           define variable v-asi-ip  as character no-undo .
     4577           define variable v-asi-port as character no-undo .
     4578           define variable v-asi-type as character no-undo .
     4579           define variable infoSecObj        as class InfoSection no-undo .
     4580           define variable v-KPrvs-secs      as character no-undo .
     4581           define variable v-KPrvs-doc-pl    as logical   no-undo .
     4582           define variable v-trk-err         as logical   no-undo .
     4583           define variable v-com-tanks-not-filled as logical no-undo init no .
     4584           assign
     4585             p-pl-code = ?
     4586           .
     4587           find first buf_rvs-doc exclusive-lock
     4588             where buf_rvs-doc.rvs-type = p-rvs-type
     4589               and buf_rvs-doc.out-code = t-doc.doc-code
     4590             no-error .
     4591           if not available buf_rvs-doc then do:
     4592             message
     4593               "Не зафиксированы книжные кол-ва и не созданы документы сверки по складскому документу." skip
     4594               view-as alert-box error .
     4595             undo block_tr, return error .
     4596           end.
     4597           if p-rvs-type <> 'после_док':U
     4598             and p-rvs-type <> 'перед_док':U
     4599           then do:
     4600             message
     4601               "Ошибка задания параметров." skip
     4602               "Неизвестный для документа прихода тип сверки." skip
     4603               "Тип сверки" p-rvs-type skip
     4604               "Код сверки" buf_rvs-doc.rvs-code skip
     4605               view-as alert-box error .
     4606             undo block_tr, return error .
     4607           end.
     4608           find first tt-doc-pl no-lock
     4609             no-error .
     4610           if not available tt-doc-pl then do:
     4611             message
     4612               substitute( "Товар &1 не распределен по местам хранения.", buf_goods.gds-code ) skip
     4613               view-as alert-box error .
     4614             undo block_tr, return error .
     4615           end.
     4616           assign
     4617             p-pl-code      = ?
     4618           .
     4619           if p-action = 'ПРОСМОТР':U
     4620           then do :
     4621             for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4622                                             and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4623                                             and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4624                                             and buf_rvs-line.gds-code = tt-doc-pl.gds-code
     4625             :
     4626               assign
     4627                 p-pl-code      = buf_rvs-line.pl-code
     4628                 v-pl-list      = v-pl-list + string(buf_rvs-line.pl-code) + ","
     4629               .
     4630             end .
     4631             if p-pl-code = ?
     4632             then do :
     4633               message
     4634                 "Не найдена строка сверки:" skip
     4635                 substitute( "товар &1", tt-doc-pl.gds-code ) skip
     4636                 substitute( "место хранения &1", tt-doc-pl.pl-code ) skip
     4637                 view-as alert-box error .
     4638               undo block_tr, return error .
     4639             end .
     4640           end .
     4641           else do :
     4642             tt-doc-pl_ :
     4643             for each tt-doc-pl no-lock
     4644             on error undo block_tr, return error return-value
     4645             :
     4646               if not is-sug(tt-doc-pl.gds-code)
     4647               then do :
     4648                 v-KPrvs-secs = "" .
     4649                 v-KPrvs-doc-pl = no .
     4650                 find first buf_place no-lock where buf_place.obj-type = t-doc.obj-type
     4651                                                and buf_place.obj-code = t-doc.obj-code
     4652                                                and buf_place.pl-code  = tt-doc-pl.pl-code
     4653                                                .
     4654                 do ii = 1 to infoSectionsTotal:SectionNum :
     4655                   infoSecObj = infoSectionsTotal:GetInfoSectionProp(ii) .
     4656                   if infoSecObj:ListTank = buf_place.loc1
     4657                   then do :
     4658                     if infoSecObj:IsKP
     4659                     then do :
     4660                       v-KPrvs-doc-pl = yes .
     4661                     end .
     4662                     v-KPrvs-secs = v-KPrvs-secs + "," + infoSecObj:SectionName .
     4663                   end .
     4664                 end .
     4665                 v-KPrvs-secs = trim(v-KPrvs-secs, ",") .
     4666                 if v-KPrvs-doc-pl
     4667                 and num-entries(v-KPrvs-secs) >= 1
     4668                 then do :
     4669                   next tt-doc-pl_ .
     4670                 end .
     4671               end .
     4672               find first buf_rvs-line no-lock
     4673                 where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4674                   and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4675                   and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4676                   and buf_rvs-line.pl-code  = tt-doc-pl.pl-code
     4677                   and buf_rvs-line.gds-code = tt-doc-pl.gds-code
     4678                 no-error .
     4679               if not available buf_rvs-line then do:
     4680                 message
     4681                   "Не найдена строка сверки:" skip
     4682                   substitute( "товар &1", tt-doc-pl.gds-code ) skip
     4683                   substitute( "место хранения &1", tt-doc-pl.pl-code ) skip
     4684                   view-as alert-box error .
     4685                 undo block_tr, return error .
     4686               end.
     4687               assign
     4688                 p-pl-code      = buf_rvs-line.pl-code
     4689                 v-pl-list      = v-pl-list + string(buf_rvs-line.pl-code) + "," .
     4690               .
     4691               run placelib_get-attr  (
     4692                  input "place-com-tanks"
     4693                 ,input t-doc.obj-code
     4694                 ,input t-doc.obj-type
     4695                 ,input tt-doc-pl.pl-code
     4696                 ,output v-value
     4697                 ,output v-ok      )
     4698               no-error.
     4699               if  v-ok
     4700               and v-value > ""
     4701               and p-action-type = "edit"
     4702               then do :
     4703                 is-com-tanks = yes .
     4704                 find first buf_place no-lock
     4705                   where buf_place.obj-type = t-doc.obj-type
     4706                     and buf_place.obj-code = t-doc.obj-code
     4707                     and buf_place.pl-code  = tt-doc-pl.pl-code
     4708                 .
     4709                 do ii = 1 to num-entries(v-value) :
     4710                   find first buf_place no-lock where buf_place.obj-type = tt-doc-pl.obj-type
     4711                                                  and buf_place.obj-code = tt-doc-pl.obj-code
     4712                                                  and buf_place.loc1     = entry(ii, v-value)
     4713                                                  and buf_place.status_  = ""
     4714                                                  no-error .
     4715                   if available buf_place
     4716                   then do :
     4717                     find first buf_rvs-line no-lock
     4718                       where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4719                         and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4720                         and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4721                         and buf_rvs-line.pl-code  = buf_place.pl-code
     4722                         and buf_rvs-line.gds-code = tt-doc-pl.gds-code
     4723                       no-error .
     4724                     if not available buf_rvs-line
     4725                     then do:
     4726                       if t-doc.status_ <> 'факт':U
     4727                       then do :
     4728                         message
     4729                           "Не найдена строка сверки:" skip
     4730                           substitute( "товар &1", tt-doc-pl.gds-code ) skip
     4731                           substitute( "место хранения &1", buf_place.pl-code ) skip
     4732                           view-as alert-box error .
     4733                         undo block_tr, return error .
     4734                       end .
     4735                     end.
     4736                     else do :
     4737                       assign
     4738                         p-pl-code      = buf_rvs-line.pl-code
     4739                         v-pl-list      = v-pl-list + string(buf_rvs-line.pl-code) + ","
     4740                       .
     4741                     end .
     4742                   end .
     4743                 end .
     4744               end .
     4745             end.
     4746           end .
     4747           assign v-pl-list = trim(v-pl-list, ",") .
     4748           if num-entries(v-pl-list) > 1
     4749           or p-pl-code = ?
     4750           then do:
     4751             run ref/pl-gds-list.w
     4752               ( input v-pl-list
     4753               , output p-pl-code
     4754               ) no-error .
     4755             if p-pl-code = ?
     4756             or p-pl-code = 0
     4757             then do:
     4758               message "Не выбрано место хранения " view-as alert-box .
     4759               undo block_tr, return error .
     4760             end.
     4761             if error-status :error then do:
     4762               message
     4763                 substitute( "Ошибка при выборе места хранения по товару &1.", buf_goods.gds-code ) skip
     4764                 return-value skip
     4765                 error-status :get-message(1) skip
     4766                 view-as alert-box error .
     4767               undo block_tr, return error .
     4768             end.
     4769           end.
     4770           find first buf_rvs-line
     4771             where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4772               and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     4773               and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     4774               and buf_rvs-line.pl-code  = p-pl-code
     4775               and buf_rvs-line.gds-code = buf_goods.gds-code
     4776             no-error.
     4777           if not available buf_rvs-line then do:
     4778             message
