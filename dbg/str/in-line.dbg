    16532        ub.doc-line-attr.attr-code = "tot-cli".
    16533     end.
    16534     if available ub.doc-line-attr then ASSIGN ub.doc-line-attr.attr-value = STRING(tt-fr-doc-line.tot-cli).
    16535   end.
    16536   run str/cor-line.p
