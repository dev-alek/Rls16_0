    12394     define variable v-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
    12395     define variable v-new-density          like ub.doc-line.fact-density no-undo .
    12396     define variable v-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
    12397     define variable v-edit-doc-pl-mode as character no-undo .
    12398     define variable d_fact-qnty     as decimal   no-undo initial 0.00 .
    12399     define variable d_doc-qnty      as decimal   no-undo initial 0.00 .
    12400     define variable d_cli-fact-qnty as decimal   no-undo initial 0.00 .
    12401     define variable d_cli-doc-qnty  as decimal   no-undo initial 0.00 .
    12402     define variable pl_fact-qnty     as decimal   no-undo initial 0.00 .
    12403     define variable pl_doc-qnty      as decimal   no-undo initial 0.00 .
    12404     define variable pl_cli-qnty      as decimal   no-undo initial 0.00 .
    12405     define variable pl_doc-density   as decimal   no-undo initial 0.00 .
    12406     define variable pl_fact-density  as decimal   no-undo initial 0.00 .
    12407     define variable pl-list          as character no-undo initial "" .
    12408     define variable v-log            as logical   no-undo .
    12409     define variable pl-setted        as logical no-undo init false .
    12410     define variable ii               as integer no-undo .
    12411     define variable pl               as integer no-undo .
    12412     define buffer tmp_doc-line-attr for ub.doc-line-attr .
    12413     assign
    12414       v-new-fact-qnty     = tt-fr-doc-line.fact-qnty
    12415       v-new-density       = tt-fr-doc-line.fact-density
