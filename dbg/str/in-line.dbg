    10729   define rectangle rect-tax2 edge-pixels 2 graphic-edge size 61 by 2.9 bgcolor 8 dcolor 5.
    10730   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
    10731   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
    10732   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
    10733   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
    10734   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
    10735   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
    10736   define variable v-param-types   as character  no-undo.
    10737   define variable v-value-char    as character  no-undo.
    10738   define variable v-val-date      as date       no-undo.
    10739   define variable v-val-decimal   as decimal    no-undo.
    10740   define variable v-val-integer   as integer    no-undo.
    10741   define variable v-val-logical   as logical    no-undo.
    10742   define variable v-tthd          as handle     no-undo.
    10743   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
    10744   PROCEDURE imagelist_loaddef:
    10745       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
    10746       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
    10747       ASSIGN
    10748           vPar-val  = "":U
    10749           vPar-type = "":U
    10750           .
    10751   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10752     (input  'photo':u
    10753     ,input  '':u
    10754     ,input  '':u
    10755     ,input  0
    10756     ,input  '':u
    10757     ,input  '':u
    10758     ,input  '':u
    10759     ,input  no
    10760     ,output vPar-val
    10761     ,output vPar-type
    10762     ) no-error .
    10763           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
    10764       IF mImagePh THEN .
    10765       ELSE RETURN.
    10766       ASSIGN
    10767           vPar-val  = "":U
    10768           vPar-type = "":U
    10769           .
    10770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10771     (input  'ph-dir':u
    10772     ,input  '':u
    10773     ,input  '':u
    10774     ,input  0
    10775     ,input  '':u
    10776     ,input  '':u
    10777     ,input  '':u
    10778     ,input  NO
    10779     ,output vPar-val
    10780     ,output vPar-type
    10781     ) no-error .
    10782       IF LENGTH (vPar-val) = 0 THEN
    10783           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
    10784       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
    10785       ASSIGN
    10786           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
    10787           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
    10788           mImagePreDir = mImagePath
    10789           mImageDir    = mImagePreDir
    10790           mImageTrash  = mImagePath + "trash\":U
    10791           .
    10792       ASSIGN
    10793           vPar-val  = "":U
    10794           vPar-type = "":U
    10795           .
    10796               run adm/shattri.p (
    10797           input "get":U
    10798           ,input  '':U
    10799           ,input  0
    10800           ,input  'gds-ref':U
    10801           ,input  'shema-foto':U
    10802           ,output v-value-char
    10803           ,output v-val-date
    10804           ,output v-val-decimal
    10805           ,output v-val-integer
    10806           ,output v-val-logical
    10807           ,output v-param-types
    10808           ,INPUT-OUTPUT table-handle v-tthd
    10809           ) no-error.
    10810           delete object v-tthd.
    10811           mPhotomgd = IF v-val-integer = 2 then yes else no.
    10812   END PROCEDURE.
    10813   PROCEDURE imagelist_decode:
    10814       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
    10815       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
    10816       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
    10817       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
    10818       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
    10819       ASSIGN
    10820           oImageList = iImageList
    10821           .
    10822       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
    10823           vCh =ENTRY (vInt, iImageList, ",":U).
    10824           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
    10825           ELSE
    10826           DO:
    10827               ASSIGN
    10828                   vCh = REPLACE (vCh, "~/":U, "\":U)
    10829                   vCh = REPLACE (vCh, "~\":U, "\":U)
    10830                   .
    10831               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
    10832               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
    10833               ENTRY (vInt, oImageList, ",":U) = vCh.
    10834           END.
    10835       END.
    10836   END PROCEDURE.
    10837   PROCEDURE imagelist_encode:
    10838       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
    10839       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
    10840       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
    10841       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
    10842       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
    10843       ASSIGN
    10844           oImageList = iImageList
    10845           vLen       = LENGTH (mImageDir)
    10846           .
    10847       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
    10848           vCh =ENTRY (vInt, iImageList, ",":U).
    10849           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
    10850               ENTRY (vInt, oImageList, ",":U) =
    10851                   SUBSTRING (vCh, vLen + 1).
    10852       END.
    10853   END PROCEDURE.
