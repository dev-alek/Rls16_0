      214   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   procedure tax-name:
      216   define input  parameter pardef-tax  as character           no-undo.
      217   define output parameter parname-tax as character initial ? no-undo.
      218   define buffer bf_tax for ub.tax.
      219   do on error undo, return error :
      220      case pardef-tax:
      221         when 'vat':U then do:
      222                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      223         end.
      224         when 'slt':U then do:
      225                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      226         end.
      227         when 'rdt':U then do:
      228                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      229         end.
      230         when 'exc':U then do:
      231                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      232         end.
      233         otherwise do:
      234            return error "Задан неверный параметр " + pardef-tax + " .".
      235         end.
      236      end case.
      237   end.
      238   end procedure.
      239   function cross-list returns logical (
      240     input parfirst-stream  as character,
      241     input parsecond-stream as character,
      242     input pardelim         as character).
      243     if pardelim = ""
      244     or pardelim = ?
      245     then do:
      246       assign
      247         pardelim = ","
      248       .
      249     end.
      250     define variable vari            as integer no-undo .
      251     define variable varresult-cross as logical no-undo .
      252     assign
      253       varresult-cross = no
      254     .
      255     def var v-num-parfirst-stream as integer no-undo .
      256     assign
      257       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      258     .
      259     do vari = 1 to v-num-parfirst-stream
      260     :
      261       if lookup(entry(vari, parfirst-stream, pardelim)
      262                ,parsecond-stream
      263                ,pardelim
      264                ) > 0 then do:
      265         assign
      266           varresult-cross = yes
      267         .
      268         leave.
      269       end.
      270     end.
      271     return varresult-cross .
      272   end function.
      273   function hvrdtax return logical (input parrecid as recid):
      274   define variable varresult as logical no-undo.
      275   run hvrdtax-proc (input parrecid, output varresult).
      276   return varresult.
      277   end function.
      278   procedure hvrdtax-proc:
      279   define input  parameter parrecid  as recid   no-undo.
      280   define output parameter parresult as logical no-undo.
      281   define buffer bf_goods for ub.goods.
      282   define buffer bf_units for ub.units.
      283   define buffer rt_tax   for ub.tax.
      284   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      285   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      286   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      287   if available rt_tax and
      288       can-find(first ub.tax-units No-LOCK WHERE
      289                      ub.tax-units.tax-code = rt_tax.tax-code AND
      290                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      291                                                       else assign parresult = no.
      292   end procedure.
      293   define new global shared variable g#lib-trn  as handle no-undo .
      294   define new global shared variable g#lib-trn2 as handle no-undo .
      295   define new global shared variable g#lib-trn3 as handle no-undo .
      296   define new global shared variable g#lib-trn4 as handle no-undo .
      297   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   procedure cur-time :
      299      define output parameter p-today as date      no-undo .
      300      define output parameter p-time  as integer   no-undo .
      301     do
      302     on error undo, return error
      303     :
      304       define variable v-date1 as date      no-undo .
      305       define variable v-date2 as date      no-undo .
      306       define variable v-time  as integer   no-undo .
      307       assign
      308         v-date1 = today
      309         v-time  = time
      310         v-date2 = today
      311       .
      312       if v-date1 <> v-date2
      313       then do:
      314         assign
      315           v-date1 = today
      316           v-time  = v-time
      317         .
      318       end.
      319       assign
      320         p-today = v-date1
      321         p-time  = v-time
      322       .
      323     end.
      324   end.
      325   function cur-time-date returns character
      326   :
      327     return string(today, '99/99/9999':U) .
      328   end.
      329   function cur-time-mjd returns decimal
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return integer(v-date) - 2400002 + (v-time / 86400) .
      338   end.
      339   function cur-time-get-ending-index returns integer
      340   (input p-number as integer
      341   )
      342   :
      343     if p-number < 0
      344     or p-number = ?
      345     then do:
      346       return 1 .
      347     end.
      348     define variable v-rest as integer   no-undo .
      349     assign
      350       p-number = p-number modulo 100
      351     .
      352     if p-number < 20
      353     then do:
      354       assign
      355         v-rest = p-number
      356       .
      357     end.
      358     else do:
      359       assign
      360         v-rest = p-number modulo 10
      361       .
      362     end.
      363     case v-rest :
      364       when 1
      365       then do:
      366         return 2 .
      367       end.
      368       when 2 or
      369       when 3 or
      370       when 4
      371       then do:
      372         return 3 .
      373       end.
      374       otherwise do:
      375         return 1 .
      376       end.
      377     end case .
      378   end.
      379   procedure cur-time-mjd-to-date :
      380      define input  parameter i-mjd-diff as decimal no-undo.
      381      define output parameter o-Date     as date    no-undo.
      382      define output parameter o-Time     as integer no-undo.
      383      define variable v-day-number as integer   no-undo .
      384      if    i-mjd-diff < 0
      385         or i-mjd-diff = ?
      386      then do:
      387         return "?" .
      388      end.
      389      assign
      390         v-day-number = truncate(i-mjd-diff,0).
      391         o-Date = date(v-day-number + 2400002).
      392         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      393     .
      394   end.
      395   function cur-time-mjd-to-string returns character
      396   (input p-mjd-diff as decimal
      397   )
      398   :
      399     define variable v-day-number as integer   no-undo .
      400     define variable v-seconds    as integer   no-undo .
      401     define variable v-hour       as integer   no-undo .
      402     define variable v-min        as integer   no-undo .
      403     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      404     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      405     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      406     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      407     if p-mjd-diff < 0
      408     or p-mjd-diff = ?
      409     then do:
      410       return "?" .
      411     end.
      412     assign
      413       v-day-number = integer(truncate(p-mjd-diff,0))
      414       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      415     .
      416     if v-seconds > 86400
      417     then do:
      418       assign
      419         v-seconds = 86400 - 1
      420       .
      421     end.
      422     if v-seconds < 0
      423     then do:
      424       assign
      425         v-seconds = 0
      426       .
      427     end.
      428     assign
      429       v-hour = truncate(v-seconds / 3600, 0)
      430     .
      431     assign
      432       v-seconds = v-seconds modulo 3600
      433     .
      434     assign
      435       v-min = truncate(v-seconds / 60, 0)
      436     .
      437     assign
      438       v-seconds = v-seconds modulo 60
      439     .
      440     return
      441         (if v-day-number <> 0
      442           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      443           else ""
      444         )
      445       + (if v-day-number <> 0 or v-hour <> 0
      446           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      447           else ""
      448         )
      449       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      450           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      451           else ""
      452         )
      453       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      454       .
      455   end.
      456   function cur-time-string returns character
      457   :
      458     define variable v-date as date      no-undo .
      459     define variable v-time as integer   no-undo .
      460     run cur-time in this-procedure
      461       (output v-date
      462       ,output v-time
      463       ) .
      464     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      465   end.
      466   function cur-time-string-sec returns character
      467   :
      468     define variable v-date as date      no-undo .
      469     define variable v-time as integer   no-undo .
      470     run cur-time in this-procedure
      471       (output v-date
      472       ,output v-time
      473       ) .
      474     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      475   end.
      476   function cur-time-custom  returns character
      477   (input p-prefix as character
      478   ,input p-date-format as character
      479   ,input p-delimiter as character
      480   ,input p-time-format as character
      481   ,input p-suffix as character
      482   )
      483   :
      484     define variable v-date as date      no-undo .
      485     define variable v-time as integer   no-undo .
      486     run cur-time in this-procedure
      487       (output v-date
      488       ,output v-time
      489       ) .
      490     return
      491       p-prefix
      492       + string(v-date, p-date-format)
      493       + p-delimiter
      494       + string(v-time, p-time-format)
      495       + p-suffix
      496       .
      497   end.
      498   function cur-time-print  returns character
      499   :
      500     define variable v-date as date      no-undo .
      501     define variable v-time as integer   no-undo .
      502     run cur-time in this-procedure
      503       (output v-date
      504       ,output v-time
      505       ) .
      506     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      507   end.
      508   function cur-time-datetime returns datetime
      509   :
      510     define variable v-char as character no-undo .
      511     define variable v-datetime as datetime no-undo .
      512     v-char = cur-time-string().
      513     v-datetime = datetime(v-char).
      514     return  v-datetime.
      515   end.
      516   function cur-time-string-msec returns character
      517   :
      518     define variable v-date as datetime  no-undo .
      519     v-date = now.
      520     return string(v-date) .
      521   end.
      522   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   procedure factord :
      524     define input  parameter p-fact-date            as date    no-undo .
      525     define input  parameter p-fact-time            as integer no-undo .
      526     define input  parameter p-fact-num             as integer no-undo .
      527     define input  parameter p-shift-date           as date    no-undo .
      528     define input  parameter p-shift-num            as integer no-undo .
      529     define input  parameter p-shift-on             as logical no-undo .
      530     define output parameter p-fact-order           as decimal no-undo .
      531     define output parameter p-shift-end-fact-order as decimal no-undo .
      532     define output parameter p-day-end-fact-order   as decimal no-undo .
      533     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      534     if p-fact-date = ?
      535     then do:
      536       return error "Не указана фактическая дата" .
      537     end.
      538     define variable v-fact-date-num as integer no-undo .
      539     assign
      540       v-fact-date-num = integer(p-fact-date)
      541     .
      542     if p-fact-num = ?
      543     or p-fact-num = 0
      544     then do:
      545       return error "Не задан p-fact-num " + string(p-fact-num) .
      546     end.
      547     if p-fact-num < 0
      548     then do:
      549       return error "Отрицательный fact-num " + string(p-fact-num) .
      550     end.
      551     if p-fact-num >= 100000000
      552     then do:
      553       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      554     end.
      555     if p-shift-on = true
      556     then do:
      557       if p-shift-date = ?
      558       then do:
      559         return error "Не задана дата смены" .
      560       end.
      561       if p-shift-num = ?
      562       or p-shift-num = 0
      563       then do:
      564         return error "Не задан номер смены" .
      565       end.
      566     end.
      567     else do:
      568       assign
      569         p-shift-date = p-fact-date
      570         p-shift-num  = 24
      571       .
      572     end.
      573     define variable v-shift-offset as integer no-undo .
      574     if p-shift-date = p-fact-date
      575     then do:
      576       assign
      577         v-shift-offset = 1
      578       .
      579     end.
      580     if p-shift-date < p-fact-date
      581     then do:
      582       assign
      583         v-shift-offset = 0
      584       .
      585     end.
      586     if p-shift-date > p-fact-date
      587     then do:
      588       message
      589         vss-workfile vss-revision vss-description skip
      590         "Неправильная дата закрытия смены" skip
      591         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      592         view-as alert-box error .
      593       undo, return error
      594         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      595           ,string(p-fact-date, '99/99/9999':U)
      596           ,string(p-shift-date, '99/99/9999':U)
      597           )
      598       .
      599     end.
      600     if p-shift-num < 1
      601     or p-shift-num > 24
      602     then do:
      603       message
      604         vss-workfile vss-revision vss-description skip
      605         "Неправильный номер смены" skip
      606         "p-shift-num" p-shift-num skip
      607         view-as alert-box error .
      608       undo, return error return-value .
      609     end.
      610     assign
      611       p-fact-order           = v-fact-date-num
      612                              + v-shift-offset * 0.5
      613                              + p-shift-num    * 0.02 - 0.01
      614                              + p-fact-num     * 0.0000000001
      615       p-shift-end-fact-order = v-fact-date-num
      616                              + v-shift-offset * 0.5
      617                              + p-shift-num    * 0.02
      618       p-day-end-fact-order   = v-fact-date-num
      619                              + 0.99
      620     .
      621     if p-fact-order           <= v-fact-date-num
      622     or p-shift-end-fact-order <= v-fact-date-num
      623     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      624     or p-shift-end-fact-order >= p-day-end-fact-order
      625     then do:
      626       message
      627         vss-workfile vss-revision vss-description skip
      628         "Внутренняя ошибка при генерации фактического номера" skip
      629         "p-fact-date"            p-fact-date            skip
      630         "p-fact-time"            p-fact-time            skip
      631         "p-fact-num"             p-fact-num             skip
      632         "p-shift-date"           p-shift-date           skip
      633         "p-shift-num"            p-shift-num            skip
      634         "p-shift-on"             p-shift-on             skip
      635         "p-shift-end-fact-order" p-shift-end-fact-order skip
      636         "p-day-end-fact-order"   p-day-end-fact-order   skip
      637         "v-fact-date-num"        v-fact-date-num        skip
      638         view-as alert-box error .
      639       undo, return error return-value .
      640     end.
      641   end procedure.
      642   procedure day-begin-fact-order :
      643     define input  parameter p-fact-date            as date    no-undo .
      644     define output parameter p-day-begin-fact-order as decimal no-undo .
      645     do
      646     on error undo, return error return-value
      647     :
      648       if p-fact-date = ?
      649       then do:
      650         assign
      651           p-day-begin-fact-order = 0
      652         .
      653       end.
      654       else do:
      655         assign
      656           p-day-begin-fact-order = integer(p-fact-date)
      657         .
      658       end.
      659     end.
      660   end procedure.
      661   procedure factord-max-fact-order :
      662     define output parameter p-max-fact-order as decimal   no-undo .
      663     do
      664     on error undo, return error return-value
      665     :
      666       run day-begin-fact-order in this-procedure
      667         (input  date(1, 1, 5000)
      668         ,output p-max-fact-order
      669         ) .
      670     end.
      671   end procedure.
      672   procedure factord-cut-archive :
      673     define input  parameter p-obj-type             as character no-undo .
      674     define input  parameter p-obj-code             as integer   no-undo .
      675     define input  parameter p-fact-date            as date      no-undo .
      676     define output parameter p-shift-on             as logical   no-undo .
      677     define output parameter p-shift-date           as date      no-undo .
      678     define output parameter p-shift-num            as integer   no-undo .
      679     define output parameter p-day-end-fact-order   as decimal   no-undo .
      680     define output parameter p-shift-end-fact-order as decimal   no-undo .
      681     define variable v-fact-order as decimal   no-undo .
      682     define buffer buf_shift-obj for ub.shift-obj .
      683     do
      684     on error undo, return error return-value
      685     :
      686   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      688     (input  p-obj-type
      689     ,input  p-obj-code
      690     ,input  'shift-on=request'
      691     ,output p-shift-on
      692     ) no-error .
      693       if error-status :error
      694       then do:
      695         message
      696           vss-workfile vss-revision vss-description skip
      697           "Ошибка при определении атрибута объекта" skip
      698           "Объект" p-obj-type p-obj-code skip
      699           error-status :get-message(1) skip
      700           return-value skip
      701           view-as alert-box error .
      702         undo, return error return-value .
      703       end.
      704       if p-shift-on = false
      705       then do:
      706         assign
      707           p-shift-date               = ?
      708           p-shift-num                = 0
      709         .
      710       end.
      711       else do:
      712         find first buf_shift-obj share-lock
      713           where buf_shift-obj.obj-type   = p-obj-type
      714             and buf_shift-obj.obj-code   = p-obj-code
      715             and buf_shift-obj.shift-date > p-fact-date
      716           use-index pi
      717           no-error .
      718         if not available buf_shift-obj
      719         or buf_shift-obj.status_ <> 'зкр':U
      720         then do:
      721           message
      722             vss-workfile vss-revision vss-description skip
      723             "Невозможно вычислить последнюю смену" skip
      724             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      725             "Объект" p-obj-type p-obj-code skip
      726             "Дата" p-fact-date skip
      727             view-as alert-box error .
      728           undo, return error return-value .
      729         end.
      730         find last buf_shift-obj share-lock
      731           where buf_shift-obj.obj-type = p-obj-type
      732             and buf_shift-obj.obj-code = p-obj-code
      733             and buf_shift-obj.shift-date <= p-fact-date
      734           use-index pi
      735           no-error .
      736         if available buf_shift-obj
      737         then do:
      738           if  buf_shift-obj.status_ = 'зкр':U
      739           then do:
      740             assign
      741               p-shift-date = buf_shift-obj.shift-date
      742               p-shift-num  = buf_shift-obj.shift-num
      743             .
      744           end.
      745           else do:
      746             message
      747               vss-workfile vss-revision vss-description skip
      748               "Невозможно вычислить последнюю смену" skip
      749               "Статус смены отличен от статуса" 'зкр':U skip
      750               "Объект" p-obj-type p-obj-code skip
      751               "Дата" p-fact-date skip
      752               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      753               view-as alert-box error .
      754             undo, return error return-value .
      755           end.
      756         end.
      757         else do:
      758           assign
      759             p-shift-date = p-fact-date - 1
      760             p-shift-num  = 1
      761           .
      762         end.
      763       end.
      764       run factord in this-procedure
      765         (input  p-fact-date
      766         ,input  1
      767         ,input  1
      768         ,input  p-shift-date
      769         ,input  p-shift-num
      770         ,input  p-shift-on
      771         ,output v-fact-order
      772         ,output p-shift-end-fact-order
      773         ,output p-day-end-fact-order
      774         ) no-error .
      775       if error-status :error
      776       then do:
      777         message
      778           vss-workfile vss-revision vss-description skip
      779           "Ошибка при вызове процедуры factord"
      780           error-status :get-message(1) skip
      781           return-value skip
      782           view-as alert-box error .
      783         undo, return error return-value .
      784       end.
      785     end.
      786   end procedure.
      787   procedure factord-lock-shift :
      788     define input  parameter p-obj-type  as character no-undo .
      789     define input  parameter p-obj-code  as integer   no-undo .
      790     define input  parameter p-fact-date as date      no-undo .
      791     define parameter buffer buf_shift-obj for ub.shift-obj .
      792     define variable v-shift-on      as logical   no-undo .
      793     define variable v-extra-message as character no-undo .
      794     define variable v-error as character no-undo .
      795     do
      796     on error undo, return error return-value
      797     :
      798   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      800     (input  p-obj-type
      801     ,input  p-obj-code
      802     ,input  'shift-on=request'
      803     ,output v-shift-on
      804     ) no-error .
      805       if error-status :error
      806       then do:
      807         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      808         undo, return error v-error .
      809       end.
      810       if v-shift-on = true
      811       then do:
      812         find first buf_shift-obj share-lock
      813           where buf_shift-obj.obj-type   = p-obj-type
      814             and buf_shift-obj.obj-code   = p-obj-code
      815             and buf_shift-obj.shift-date > p-fact-date
      816           use-index pi
      817           no-error .
      818         if not available buf_shift-obj
      819         or buf_shift-obj.status_ <> 'зкр':U
      820         then do:
      821           find last buf_shift-obj
      822             where buf_shift-obj.obj-type = p-obj-type
      823               and buf_shift-obj.obj-code = p-obj-code
      824               and buf_shift-obj.status_  = 'зкр':U
      825             use-index stts
      826             no-error .
      827           if available buf_shift-obj
      828           then do:
      829             assign
      830               v-extra-message =
      831                     substitute("Дата начала последеней закрытой смены на объекте &1"
      832                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      833                               )
      834             .
      835           end.
      836           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      837           undo, return error v-error .
      838         end.
      839       end.
      840     end.
      841   end procedure.
      842   procedure factord-end-day :
      843     define input  parameter p-fact-date            as date    no-undo .
      844     define output parameter p-day-end-fact-order   as decimal no-undo .
      845     do
      846     on error undo, return error return-value
      847     :
      848       if p-fact-date = ?
      849       then do:
      850         return error "Не указана фактическая дата" .
      851       end.
      852       assign
      853         p-day-end-fact-order = integer(p-fact-date) + 0.99
      854       .
      855     end.
      856   end procedure.
      857   procedure factord-to-date :
      858     define input  parameter p-fact-order as decimal no-undo .
      859     define output parameter p-fact-date  as date    no-undo .
      860     define variable v-ref-date  as date      no-undo .
      861     define variable v-ref-delta as integer   no-undo .
      862     do
      863     on error undo, return error return-value
      864     :
      865       if p-fact-order = ?
      866       or p-fact-order = 0
      867       then do:
      868         return error "Не указан fact-order" .
      869       end.
      870       assign
      871         v-ref-date  = date(1, 1, 2000)
      872       .
      873       assign
      874         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      875       .
      876       assign
      877         p-fact-date = v-ref-date + v-ref-delta
      878       .
      879     end.
      880   end procedure.
      881   procedure factord-to-fact-num :
      882     define input  parameter p-fact-order as decimal no-undo .
      883     define output parameter p-fact-num   as integer no-undo .
      884     define variable v-fact-order-trunc as decimal no-undo .
      885     do
      886     on error undo, return error return-value
      887     :
      888       if p-fact-order = ?
      889       or p-fact-order = 0
      890       then do:
      891         return error "Не указан fact-order" .
      892       end.
      893       assign
      894        v-fact-order-trunc = truncate(p-fact-order, 2)
      895       .
      896       assign
      897         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      898       .
      899     end.
      900   end procedure.
      901   procedure factord-to-shift-num :
      902     define input  parameter p-fact-order as decimal no-undo .
      903     define output parameter p-shift-num   as integer no-undo .
      904     define variable  p-shift-numd  as decimal   no-undo .
      905     define variable v-fact-order-trunc as decimal no-undo .
      906     do
      907     on error undo, return error return-value
      908     :
      909       if p-fact-order = ?
      910       or p-fact-order = 0
      911       then do:
      912         return error "Не указан fact-order" .
      913       end.
      914       assign
      915        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      916       .
      917       if v-fact-order-trunc < 0.5 then do:
      918         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      919       end.
      920       assign
      921         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      922         .
      923        assign
      924         p-shift-num = truncate (p-shift-numd , 0)
      925       .
      926     end.
      927   end procedure.
      928   define temp-table  tt-tax no-undo
      929     field tax-code    like ub.tax.tax-code
      930     field individual  like ub.tax.individual
      931     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      932     field rate-code   like ub.tax-rate.rate-code
      933     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      934     field tax-type    like ub.tax.tax-type
      935     field rate-value  like ub.tax-rate-value.rate-value
      936     field tax-rate-gds-rc  as recid
      937     field to-cashdesk like ub.tax.to-cashdesk
      938     index tax-code is unique primary tax-code
      939     .
      940   procedure tax-val :
      941     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      942     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      943     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      944     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      945     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      946     define input  parameter       parunits-type like ub.units.type         no-undo.
      947     define input  parameter       parrec-id     as recid                   no-undo.
      948     define input  parameter       paris-log     as logical                 no-undo.
      949     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      950     define input  parameter       vattaxcdvalue as integer                 no-undo.
      951     define input  parameter       exctaxcdvalue as integer                 no-undo.
      952     define input  parameter       only-check    as logical                 no-undo.
      953     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      954     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      955     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      956     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      957     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      958     define output parameter       parerr-mes    as character               no-undo.
      959     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      960     do
      961     on error undo, return error return-value
      962     :
      963   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      965   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      966   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      967   define variable gp-excise     like ub.price-list.excise     no-undo.
      968   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      969   define variable gp-fact-order as decimal   no-undo .
      970   define variable gp-price-sale-parts as decimal   no-undo .
      971       define buffer buf_tax          for ub.tax .
      972       define buffer buf_tax-rate     for ub.tax-rate .
      973       define buffer buf_tax-units    for ub.tax-units .
      974       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      975       define buffer buf_goods        for ub.goods .
      976       define buffer buf_bar-code     for ub.bar-code .
      977       define buffer buf_prod-bc      for ub.prod-bc .
      978       define buffer buf_units        for ub.units .
      979       define buffer buf_shop         for ub.shop .
      980       define buffer buf_store        for ub.store .
      981       define buffer buf_gds-prt      for ub.gds-prt .
      982       define buffer buf_tt-tax       for tt-tax .
      983       define variable varrate-value    as decimal   initial ? no-undo.
      984       define variable pr-list-recid    as recid     initial ? no-undo.
      985       define variable varmes           as character no-undo.
      986       define variable varfactorrtvalue as char      initial ? no-undo.
      987       define variable varfactorrttype  as char      initial ? no-undo.
      988       define variable is-petrolium     as logical no-undo.
      989       define variable is-pieces        as logical no-undo.
      990       define variable vargds-code      like ub.goods.gds-code no-undo.
      991       define variable pargds-code      like ub.goods.gds-code no-undo.
      992       define variable var-fact-order   as decimal no-undo .
      993       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      994       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      995       define variable currate-gds-rc   as recid no-undo .
      996       define variable v-today          as date no-undo .
      997       define variable v-time           as integer no-undo .
      998       for each buf_tt-tax:
      999         delete buf_tt-tax.
     1000       end.
     1001       run cur-time in this-procedure(output v-today, output v-time).
     1002       run factord-end-day in this-procedure (input v-today, output var-fact-order).
     1003       if parartic     = ?
     1004       or parprod-type = ?
     1005       or parprod-code = ?
     1006       or parunit-base = ?
     1007       then do:
     1008         find first buf_goods no-lock
     1009           where recid(buf_goods) = parrec-id
     1010           no-error .
     1011       end.
     1012       else do:
     1013         find first buf_goods no-lock
     1014           where buf_goods.artic = parartic
     1015             and buf_goods.prod-type = parprod-type
     1016             and buf_goods.prod-code = parprod-code
     1017           no-error .
     1018       end.
     1019       if not available buf_goods then do:
     1020         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
     1021         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1022       end.
     1023       assign
     1024         parartic     = buf_goods.artic
     1025         parprod-type = buf_goods.prod-type
     1026         parprod-code = buf_goods.prod-code
     1027         parunit-base = buf_goods.unit-base
     1028         pargds-code  = buf_goods.gds-code
     1029       .
     1030       if parunits-type = ?
     1031       then do:
     1032         find buf_units no-lock
     1033           where buf_units.unit-name = parunit-base
