    14752                and tt-fr-doc-line.doc-density :sensitive in frame d-in-line
    14753                and ( tt-fr-doc-line.doc-density = 0.0
    14754                      or tt-fr-doc-line.doc-density = ?
    14755                    )
    14756              then do:
    14757                wait-for go of frame d-in-line focus tt-fr-doc-line.doc-density.
    14758              end.
    14759              else do:
    14760                wait-for go of frame d-in-line focus tt-fr-doc-line.cli-qnty.
    14761              end.
    14762            end.
    14763            else do:
    14764              if tt-fr-doc-line.doc-qnty :sensitive in frame d-in-line then do:
