    18999                                                               and buf_c-pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19000                                                               and buf_c-pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19001                                                               and buf_c-pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
