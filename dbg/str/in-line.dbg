    16359     ,output  varprice-other-exp-rubl-dt
    16360     ,output  varprice-transport-exp-rubl-dt
    16361     ,output  varprice-without-abs-rubl-dt
    16362     ,output  varprice-slt-rubl-dt
    16363     ,output  varprice-no-slt-rubl-dt
    16364     ,output  varprice-vat-rubl-dt
