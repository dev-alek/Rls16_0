    14005               infoSectionsTotal:RNAlgo (integer(infoSectionObj:SectionName), output v-new-sec-fact-qnty-kg).
    14006               infoSectionObj:FactQnty = v-new-sec-fact-qnty-kg / v-calc-density .
    14007               infoSectionObj:FactDensity = v-calc-density .
