     5957           define variable v-new-density       like ub.doc-line.fact-density no-undo .
     5958           define variable v-new-cli-fact-qnty like ub.doc-line.fact-qnty    no-undo .
     5959           define variable v-chg               as   logical                  no-undo .
     5960           define variable v-log               as   logical                  no-undo .
     5961           define variable v-st-doc            as   logical                  no-undo .
     5962           define variable v-setting           as   logical                  no-undo .
     5963           define variable v-need-message      as   logical                  no-undo init yes .
     5964           block_tr:
     5965           do transaction
     5966           on error  undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5967           on stop   undo block_tr, return error substitute( "&1. stop", vss-workfile )
     5968           on endkey undo block_tr, return error substitute( "&1. endkey", vss-workfile )
     5969           :
     5970             find first buf_goods no-lock
     5971               where buf_goods.gds-code = p-gds-code
     5972               .
     5973             p-infoSectionsTotal:CalculateTotal().
     5974             if p-prt-start-real-date = ?
     5975               or p-prt-start-real-time = ?
     5976             then do:
     5977               find first buf_rvs-doc
     5978                 where buf_rvs-doc.rvs-type = 'перед_док':U
     5979                   and buf_rvs-doc.out-code = p-doc-code
     5980                 no-error .
     5981               if available buf_rvs-doc then do:
     5982                 for each buf_rvs-line
     5983                   where buf_rvs-line.gds-code = p-gds-code
     5984                     and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-type
     5985                     and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     5986                     and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     5987                 on error undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5988                 :
     5989                   if buf_rvs-line.real-date <> ?
     5990                     and buf_rvs-line.real-time <> ?
     5991                     and ( p-prt-start-real-date > buf_rvs-line.real-date
     5992                           or ( p-prt-start-real-date = buf_rvs-line.real-date
     5993                               and p-prt-start-real-time > buf_rvs-line.real-time
     5994                             )
     5995                         )
     5996                   then do:
     5997                     assign
     5998                       p-prt-start-real-date = buf_rvs-line.real-date
     5999                       p-prt-start-real-time = buf_rvs-line.real-time
     6000                     .
     6001                   end.
     6002                 end.
     6003               end.
     6004             end.
     6005             if p-prt-end-real-date = ?
     6006               or p-prt-end-real-time = ?
     6007             then do:
     6008               find first buf_rvs-doc
     6009                 where buf_rvs-doc.rvs-type = 'после_док':U
     6010                   and buf_rvs-doc.out-code = p-doc-code
     6011                 no-error .
     6012               if available buf_rvs-doc then do:
     6013                 for each buf_rvs-line
     6014                   where buf_rvs-line.gds-code = p-gds-code
     6015                     and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     6016                     and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     6017                     and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     6018                 on error undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6019                 :
     6020                   if buf_rvs-line.real-date <> ?
     6021                     and buf_rvs-line.real-time <> ?
     6022                     and ( p-prt-end-real-date < buf_rvs-line.real-date
     6023                           or ( p-prt-end-real-date = buf_rvs-line.real-date
     6024                               and p-prt-end-real-time < buf_rvs-line.real-time
     6025                             )
     6026                         )
     6027                   then do:
     6028                     assign
     6029                       p-prt-end-real-date = buf_rvs-line.real-date
     6030                       p-prt-end-real-time = buf_rvs-line.real-time
     6031                     .
     6032                   end.
     6033                 end.
     6034               end.
     6035             end.
     6036             tanksForm = new ibs.th.str.ptrl.forms.tanksections(infoSectionsTotal).
     6037             wait-for tanksForm:ShowDialog().
     6038             def var ii as int no-undo.
     6039             def var infoSectionObj as class InfoSection no-undo.
     6040             if p-infoSectionsTotal:RdcDnstvalue = 'not'
     6041             then do:
     6042               do ii = 1 to p-infoSectionsTotal:SectionNum :
     6043                 infoSectionObj = p-infoSectionsTotal:GetInfoSectionProp(ii).
     6044                 if p-mode ne 'ПРОСМОТР':U
     6045                 then do:
     6046                    infoSectionObj:FactQnty = infoSectionObj:TankVol.
     6047                    infoSectionObj:FactDensity = infoSectionObj:TankDensity.
     6048                    p-infoSectionsTotal:SaveDb().
     6049                 end.
     6050                 p-infoSectionsTotal:GetDBAllAttr().
     6051                 p-infoSectionsTotal:CalculateTotal().
     6052               end.
     6053             end.
     6054             if p-infoSectionsTotal:WasSetting = false then p-infoSectionsTotal:GetDBAllAttr().
     6055               if p-infoSectionsTotal:WasSetting = true
     6056                 and p-mode <> 'ПРОСМОТР':U
     6057                 and p-stfactplvalue <> "":U
     6058                 and (p-auto-tank = true or p-infoSectionsTotal:IsRNAlgo)
     6059                 then
     6060               do:
     6061                 assign
     6062                   v-new-fact-qnty = p-new-fact-qnty
     6063                   .
     6064               do ii = 1 to p-infoSectionsTotal:SectionNum :
     6065                 define variable v-calc-density like ub.rvs-line.state-density no-undo .
     6066                 define variable v-new-sec-fact-qnty         as decimal no-undo.
     6067                 define variable v-new-sec-fact-qnty-kg      as decimal no-undo.
     6068                 define variable v-chg-temp                  as logical no-undo.
     6069                 define variable v-st-doc-temp               as logical no-undo.
     6070                 define variable v-rvs-sec-qnty-before       as decimal no-undo.
     6071                 define variable v-rvs-sec-qnty-after        as decimal no-undo.
     6072                 define variable v-rvs-sec-cli-qnty-before   as decimal no-undo.
     6073                 define variable v-rvs-sec-cli-qnty-after    as decimal no-undo.
     6074                 infoSectionObj = p-infoSectionsTotal:GetInfoSectionProp(ii).
     6075                 v-new-sec-fact-qnty = if infoSectionObj:FactQnty = 0 or infoSectionObj:FactQnty = ? then infoSectionObj:DocQnty else infoSectionObj:FactQnty.
     6076                 v-calc-density = ? .
     6077                 if infoSectionObj:TankWeight > 0
     6078                 and infoSectionObj:TankVol > 0
     6079                 then
     6080                   v-calc-density = infoSectionObj:TankWeight / infoSectionObj:TankVol
     6081                 .
     6082                 if infoSectionObj:AccMeth = 1
     6083                 and infoSectionObj:TankWeightRvs > 0
     6084                 and infoSectionObj:TankVolPomiRvs > 0
     6085                 then
     6086                   v-calc-density = infoSectionObj:TankWeightRvs / infoSectionObj:TankVolPomiRvs
     6087                 .
     6088                 if not p-infoSectionsTotal:IsSGDKK
     6089                 then do :
     6090                   if p-infoSectionsTotal:IsRNAlgo
     6091                   then do:
     6092                     assign
     6093                       v-calc-density = infoSectionObj:TankDensityPomi when not p-infoSectionsTotal:RdcDnstvalue = 'not'
     6094                       v-calc-density = infoSectionObj:TankDensity when p-infoSectionsTotal:RdcDnstvalue = 'not'
     6095                     .
     6096                     if infoSectionObj:AccMeth = 1
     6097                     then do :
     6098                       assign v-calc-density = infoSectionObj:TankWeightRvs / infoSectionObj:TankVolPomiRvs .
     6099                     end .
     6100                     if (v-calc-density = ? or v-calc-density <= 0 or v-calc-density > 1)
     6101                     and infoSectionObj:KPnoMeas
     6102                     then do :
     6103                       assign v-need-message = no .
     6104                     end .
     6105                     p-infoSectionsTotal:RNAlgo (integer(infoSectionObj:SectionName), output v-new-sec-fact-qnty-kg).
     6106                     if v-new-sec-fact-qnty-kg <> infoSectionObj:DocQnty * infoSectionObj:DocDensity
     6107                     then do:
     6108                       v-new-sec-fact-qnty = v-new-sec-fact-qnty-kg / v-calc-density.
     6109                       v-chg-temp = true.
     6110                       v-st-doc-temp = false.
     6111                     end.
     6112                     else do:
     6113                       v-st-doc-temp = true.
     6114                       v-chg-temp = false.
     6115                     end.
     6116                   end.
     6117                   else do:
     6118   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_stfactqt in g#lib-calc
     6119     ( input        p-stfactplvalue
     6120     , input        infoSectionObj:DocQnty
     6121     , input        infoSectionObj:DocDensity
     6122     , input        0.00
     6123     , input        0.00
     6124     , input        infoSectionObj:TankVol
     6125     , input        v-calc-density
     6126     , input        no
     6127     , input-output v-new-sec-fact-qnty
     6128     ,       output v-chg-temp
     6129     ,       output v-st-doc-temp
     6130     )              no-error
     6131   .
     6132                     if error-status :error then do:
     6133                       undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
     6134                     end.
     6135                   end.
     6136                 end .
     6137                 else do :
     6138                   if infoSectionObj:IsKP
     6139                   then do :
     6140                     if p-infoSectionsTotal:IsRNAlgo
     6141                     then do:
     6142                       assign
     6143                         v-calc-density = infoSectionObj:TankDensityPomi when not p-infoSectionsTotal:RdcDnstvalue = 'not'
     6144                         v-calc-density = infoSectionObj:TankDensity when p-infoSectionsTotal:RdcDnstvalue = 'not'
     6145                       .
     6146                       if infoSectionObj:AccMeth = 1
     6147                       then do :
     6148                         assign v-calc-density = infoSectionObj:TankWeightRvs / infoSectionObj:TankVolPomiRvs .
     6149                       end .
     6150                       if (v-calc-density = ? or v-calc-density <= 0 or v-calc-density > 1)
     6151                       and infoSectionObj:Alarm-SGDKK
     6152                       then do :
     6153                         assign v-need-message = no .
     6154                       end .
     6155                       p-infoSectionsTotal:RNAlgo (integer(infoSectionObj:SectionName), output v-new-sec-fact-qnty-kg).
     6156                       if v-new-sec-fact-qnty-kg <> infoSectionObj:DocQnty * infoSectionObj:DocDensity
     6157                       then do:
     6158                         v-new-sec-fact-qnty = v-new-sec-fact-qnty-kg / v-calc-density.
     6159                         v-chg-temp = true.
     6160                         v-st-doc-temp = false.
     6161                       end.
     6162                       else do:
     6163                         v-st-doc-temp = true.
     6164                         v-chg-temp = false.
     6165                       end.
     6166                     end.
     6167                     else do:
     6168   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_stfactqt in g#lib-calc
     6169     ( input        p-stfactplvalue
     6170     , input        infoSectionObj:DocQnty
     6171     , input        infoSectionObj:DocDensity
     6172     , input        0.00
     6173     , input        0.00
     6174     , input        infoSectionObj:TankVol
     6175     , input        v-calc-density
     6176     , input        no
     6177     , input-output v-new-sec-fact-qnty
     6178     ,       output v-chg-temp
     6179     ,       output v-st-doc-temp
     6180     )              no-error
     6181   .
     6182                       if error-status :error then do:
     6183                         undo block_tr, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
     6184                       end.
     6185                     end.
     6186                   end .
     6187                   else do :
     6188                     p-infoSectionsTotal:CalcTP() .
     6189                     v-st-doc-temp = true.
     6190                     v-chg-temp = false.
     6191                   end .
     6192                 end .
     6193                 if v-chg-temp
     6194                 then do:
     6195                   infoSectionObj:FactQnty = v-new-sec-fact-qnty.
     6196                   v-chg = v-chg-temp.
     6197                   if v-st-doc-temp
     6198                   then do:
     6199                     infoSectionObj:FactDensity = infoSectionObj:DocDensity.
     6200                     v-st-doc = v-st-doc-temp.
     6201                   end.
     6202                   else do:
     6203                     infoSectionObj:FactDensity = v-calc-density.
     6204                   end.
     6205                 end.
     6206                 else do:
     6207                   infoSectionObj:FactQnty = infoSectionObj:DocQnty.
     6208                   infoSectionObj:FactDensity = infoSectionObj:DocDensity.
     6209                 end.
     6210               end.
     6211               if p-mode ne 'ПРОСМОТР':U
     6212               then
     6213                  p-infoSectionsTotal:SaveDb().
     6214               p-infoSectionsTotal:GetDBAllAttr().
     6215               p-infoSectionsTotal:CalculateTotal().
     6216               v-calc-density = p-infoSectionsTotal:FactKgQntyTotal / p-infoSectionsTotal:FactQntyTotal.
     6217               v-new-fact-qnty = p-infoSectionsTotal:FactQntyTotal.
     6218               if p-new-fact-qnty <> v-new-fact-qnty
     6219               and absolute(p-new-fact-qnty - v-new-fact-qnty) < 0.0011
     6220               then do :
     6221                 p-infoSectionsTotal:FactQntyTotal = p-new-fact-qnty .
     6222                 v-new-fact-qnty = p-infoSectionsTotal:FactQntyTotal .
     6223                 v-calc-density = p-new-density .
     6224                 p-infoSectionsTotal:FactKgQntyTotal = p-infoSectionsTotal:FactQntyTotal * v-calc-density .
     6225               end .
     6226               if (absolute (v-calc-density - p-new-density ) > 0.0000000001
     6227                 or absolute (p-infoSectionsTotal:FactQntyTotal - p-new-fact-qnty ) > 0.001)
     6228                 or ((v-calc-density = ? and p-new-density <> ?) or (p-infoSectionsTotal:FactQntyTotal = ? and p-new-fact-qnty <> ?))
     6229               then do:
     6230                 v-chg =  yes.
     6231               end.
     6232               if v-calc-density = ?
     6233               and not infoSectionsTotal:isFlagKPChg
     6234               then do:
     6235                 return.
     6236               end.
     6237               if (p-new-fact-qnty <> v-new-fact-qnty
     6238                 or v-chg       =  yes
     6239                 or v-st-doc    =  yes) and not infoSectionsTotal:isFlagKPChg
     6240               then do:
     6241                 assign
     6242                   v-new-density = v-calc-density
     6243                   v-log         = yes
     6244                 .
     6245                 if v-new-fact-qnty <> p-new-fact-qnty
     6246                   or v-new-density <> p-new-density
     6247                 then do:
     6248                   if p-fact-edit = true then do:
     6249                     if infoSectionsTotal:isKPrvs
     6250                     then do :
     6251                       message
     6252                         substitute( "По результатам измерения в резервуаре фактическое кол-во необходимо изменить." ) skip
     6253                         substitute( "Будем менять фактические" ) skip
     6254                         substitute( "количество на &1 (&2),", (v-new-fact-qnty * v-new-density), "кг" ) skip
     6255                         substitute( "плотность на &1 ?", v-new-density ) skip
     6256                       view-as alert-box question buttons yes-no update v-log .
     6257                     end .
     6258                     else do :
     6259                       message
     6260                         substitute( "По результатам измерения автоцистерны фактическое кол-во необходимо изменить." ) skip
     6261                         substitute( "Будем менять фактические" ) skip
     6262                         substitute( "количество на &1 (&2),", (v-new-fact-qnty * v-new-density), "кг" ) skip
     6263                         substitute( "плотность на &1 ?", v-new-density ) skip
     6264                       view-as alert-box question buttons yes-no update v-log .
     6265                     end .
     6266                   end.
     6267                   else do:
     6268                     if infoSectionsTotal:isKPrvs
     6269                     then do :
     6270                       message
     6271                         substitute( "По результатам измерения в резервуаре фактическое кол-во товара изменяется на &1 (&2),", (v-new-fact-qnty * v-new-density), "кг" ) skip
     6272                         substitute( "фактическая плотность на &1.", v-new-density ) skip
     6273                       view-as alert-box information .
     6274                     end .
     6275                     else do :
     6276                       message
     6277                         substitute( "По результатам измерения автоцистерны фактическое кол-во товара изменяется на &1 (&2),", (v-new-fact-qnty * v-new-density), "кг" ) skip
     6278                         substitute( "фактическая плотность на &1.", v-new-density ) skip
     6279                       view-as alert-box information .
     6280                     end .
     6281                   end.
     6282                 end.
     6283                 if v-log = yes then do:
     6284                   assign
     6285                     p-new-fact-qnty     = v-new-fact-qnty
     6286                     p-new-density       = v-new-density
     6287                     p-new-cli-fact-qnty = p-new-fact-qnty * p-new-density
     6288                   .
     6289                 end.
     6290               end.
     6291             end.
     6292           end.
     6293         end.
     6294       end procedure.
     6295       procedure chkdcrvs :
     6296         define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     6297         define input  parameter p-gds-code like ub.goods.gds-code   no-undo .
     6298         define output parameter p-ok       as   logical             no-undo .
     6299         do
     6300         on error undo, return error return-value
     6301         :
     6302           define variable v-found as logical no-undo .
     6303           define buffer buf-before_rvs-doc  for ub.rvs-doc  .
     6304           define buffer buf-before_rvs-line for ub.rvs-line .
     6305           define buffer buf-after_rvs-doc   for ub.rvs-doc  .
     6306           define buffer buf-after_rvs-line  for ub.rvs-line .
     6307           assign
     6308             p-ok = false
     6309           .
     6310           find first tt-doc-pl no-lock
     6311             no-error .
     6312           if not available tt-doc-pl then do:
     6313             return error substitute( 'Документ "&1", товар &2: нет разбивки по местам хранения.', p-doc-code, p-gds-code ) .
     6314           end.
     6315           find first buf-before_rvs-doc no-lock
     6316             where buf-before_rvs-doc.rvs-type = 'перед_док':U
     6317               and buf-before_rvs-doc.out-code = p-doc-code
     6318             no-error .
     6319           if not available buf-before_rvs-doc then do:
     6320             return substitute( 'По документу "&1" нет сверки <<до налива топлива>>.', p-doc-code ).
     6321           end.
     6322           find first buf-after_rvs-doc no-lock
     6323             where buf-after_rvs-doc.rvs-type = 'после_док':U
     6324               and buf-after_rvs-doc.out-code = p-doc-code
     6325             no-error .
     6326           if not available buf-after_rvs-doc then do:
     6327             return substitute( 'По документу "&1" нет сверки <<после налива топлива>>.', p-doc-code ).
     6328           end.
     6329           for each tt-doc-pl no-lock
     6330           on error undo, return error return-value
     6331           :
     6332             find first buf-before_rvs-line no-lock
     6333               where buf-before_rvs-line.rvs-code = buf-before_rvs-doc.rvs-code
     6334                 and buf-before_rvs-line.obj-type = buf-before_rvs-doc.obj-type
     6335                 and buf-before_rvs-line.obj-code = buf-before_rvs-doc.obj-code
     6336                 and buf-before_rvs-line.pl-code  = tt-doc-pl.pl-code
     6337                 and buf-before_rvs-line.gds-code = tt-doc-pl.gds-code
     6338               no-error .
     6339             if not available buf-before_rvs-line then do:
     6340               assign v-found = no .
     6341               for each buf-before_rvs-doc no-lock
     6342                 where buf-before_rvs-doc.rvs-type = 'перед_док':U
     6343                   and buf-before_rvs-doc.out-code = p-doc-code
     6344               :
     6345                 find first buf-before_rvs-line no-lock
     6346                   where buf-before_rvs-line.rvs-code = buf-before_rvs-doc.rvs-code
     6347                     and buf-before_rvs-line.obj-type = buf-before_rvs-doc.obj-type
     6348                     and buf-before_rvs-line.obj-code = buf-before_rvs-doc.obj-code
     6349                     and buf-before_rvs-line.pl-code  = tt-doc-pl.pl-code
     6350                     and buf-before_rvs-line.gds-code = tt-doc-pl.gds-code
     6351                   no-error .
     6352                 if available buf-before_rvs-line
     6353                 then do :
     6354                   assign v-found = yes .
     6355                   leave .
     6356                 end .
     6357               end .
     6358               if not v-found
     6359               then
     6360               return substitute( 'По документу "&1" для товара &2 на месте хранения &3 нет строки сверки <<до налива топлива>>.'
     6361                                  ,p-doc-code
     6362                                  ,p-gds-code
     6363                                  ,tt-doc-pl.pl-code
     6364                                ).
     6365             end.
     6366             find first buf-after_rvs-line no-lock
     6367               where buf-after_rvs-line.rvs-code = buf-after_rvs-doc.rvs-code
     6368                 and buf-after_rvs-line.obj-type = buf-after_rvs-doc.obj-type
     6369                 and buf-after_rvs-line.obj-code = buf-after_rvs-doc.obj-code
     6370                 and buf-after_rvs-line.pl-code  = tt-doc-pl.pl-code
     6371                 and buf-after_rvs-line.gds-code = tt-doc-pl.gds-code
     6372               no-error .
     6373             if not available buf-after_rvs-line then do:
     6374               assign v-found = no .
     6375               for each buf-after_rvs-doc no-lock
     6376                 where buf-after_rvs-doc.rvs-type = 'после_док':U
     6377                   and buf-after_rvs-doc.out-code = p-doc-code
     6378               :
     6379                 find first buf-after_rvs-line no-lock
     6380                   where buf-after_rvs-line.rvs-code = buf-after_rvs-doc.rvs-code
     6381                     and buf-after_rvs-line.obj-type = buf-after_rvs-doc.obj-type
     6382                     and buf-after_rvs-line.obj-code = buf-after_rvs-doc.obj-code
     6383                     and buf-after_rvs-line.pl-code  = tt-doc-pl.pl-code
     6384                     and buf-after_rvs-line.gds-code = tt-doc-pl.gds-code
     6385                   no-error .
     6386                 if available buf-after_rvs-line
     6387                 then do :
     6388                   assign v-found = yes .
     6389                   leave .
     6390                 end .
     6391               end .
     6392               if not v-found
     6393               then
     6394               return substitute( 'По документу "&1" для товара &2 на месте хранения &3 нет строки сверки <<после налива топлива>>.'
     6395                                  ,p-doc-code
     6396                                  ,p-gds-code
     6397                                  ,tt-doc-pl.pl-code
     6398                                ).
     6399             end.
     6400             if is-gas(buf-after_rvs-line.gds-code) then next.
     6401             run placelib_get-attr(input "place-virtual"
     6402                                    ,input buf-after_rvs-line.obj-code
     6403                                    ,input buf-after_rvs-line.obj-type
     6404                                    ,input buf-after_rvs-line.pl-code
     6405                                    ,output v-value
     6406                                    ,output v-ok) no-error.
     6407             is-vir = if (v-ok and logical(v-value)) then true else false.
     6408             if is-vir then next.
     6409             if buf-before_rvs-line.state-measure-qnty = ? then do:
     6410               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<до налива топлива>>.'
     6411                                  ,p-doc-code
     6412                                  ,p-gds-code
     6413                                  ,tt-doc-pl.pl-code
     6414                                  ,chr(10)
     6415                                  ,buf_goods.unit-base
     6416                                ).
     6417             end.
     6418             if buf-before_rvs-line.state-measure-cli-qnty = ? then do:
     6419               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<до налива топлива>>.'
     6420                                  ,p-doc-code
     6421                                  ,p-gds-code
     6422                                  ,tt-doc-pl.pl-code
     6423                                  ,chr(10)
     6424                                  ,buf_goods.unit-cli
     6425                                ).
     6426             end.
     6427             if buf-before_rvs-line.state-density = ? then do:
     6428               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задана плотность в сверке <<до налива топлива>>.'
     6429                                       ,p-doc-code
     6430                                       ,p-gds-code
     6431                                       ,tt-doc-pl.pl-code
     6432                                       ,chr(10)
     6433                                     ).
     6434             end.
     6435             if buf-after_rvs-line.state-measure-qnty = ? then do:
     6436               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<после налива топлива>>.'
     6437                                       ,p-doc-code
     6438                                       ,p-gds-code
     6439                                       ,tt-doc-pl.pl-code
     6440                                       ,chr(10)
     6441                                       ,buf_goods.unit-base
     6442                                     ).
     6443             end.
     6444             if buf-after_rvs-line.state-measure-cli-qnty = ? then do:
     6445               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задан фактический остаток (&5) в сверке <<после налива топлива>>.'
     6446                                       ,p-doc-code
     6447                                       ,p-gds-code
     6448                                       ,tt-doc-pl.pl-code
     6449                                       ,chr(10)
     6450                                       ,buf_goods.unit-cli
     6451                                     ).
     6452             end.
     6453             if buf-after_rvs-line.state-density = ? then do:
     6454               return substitute( 'Документ "&1", товар &2, резервуар &3.&4Не задана плотность в сверке <<после налива топлива>>.'
     6455                                       ,p-doc-code
     6456                                       ,p-gds-code
     6457                                       ,tt-doc-pl.pl-code
     6458                                       ,chr(10)
     6459                                     ).
     6460             end.
     6461           end.
     6462           assign
     6463             p-ok = true
     6464           .
     6465         end.
     6466       end procedure.
     6467       procedure local-state-fact-rvs :
     6468         define input        parameter p-doc-code             like ub.trn-doc.doc-code      no-undo .
     6469         define input        parameter p-gds-code             like ub.goods.gds-code        no-undo .
     6470         define input        parameter p-stfactplvalue        as   character                no-undo .
     6471         define input        parameter p-revision             as   logical                  no-undo .
     6472         define input        parameter p-fact-edit            as   logical                  no-undo .
     6473         define input        parameter p-doc-qnty             like ub.doc-line.doc-qnty     no-undo .
     6474         define input        parameter p-doc-density          like ub.doc-line.doc-density  no-undo .
     6475         define input-output parameter p-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     6476         define input-output parameter p-new-density          like ub.doc-line.fact-density no-undo .
     6477         define input-output parameter p-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     6478         do
     6479         on error undo, return error return-value
     6480         :
     6481           define variable v-new-fact-qnty       like ub.doc-line.fact-qnty              no-undo .
     6482           define variable v-new-density         like ub.doc-line.doc-density            no-undo .
     6483           define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     6484           define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     6485           define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     6486           define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     6487           define variable v-log                 as   logical                            no-undo .
     6488           define variable v-chg                 as   logical                            no-undo .
     6489           define variable v-st-doc              as   logical                            no-undo .
     6490           define variable v-delta-mass-qnty as decimal   no-undo .
     6491           define variable v-trk-err         as logical   no-undo .
     6492           if p-stfactplvalue <> "":U
     6493             and p-revision = true
     6494           then do:
     6495             assign
     6496               v-new-fact-qnty = p-new-fact-qnty
     6497             .
     6498             run return-rvs-qnty in this-procedure
     6499               (  input p-doc-code
     6500                 ,input p-gds-code
     6501                 ,input ?
     6502                 ,output v-rvs-qnty-before
     6503                 ,output v-rvs-qnty-after
     6504                 ,output v-rvs-cli-qnty-before
     6505                 ,output v-rvs-cli-qnty-after
     6506                 ,output v-delta-mass-qnty
     6507                 ,output v-trk-err
     6508               ) no-error .
     6509             if error-status :error then do:
     6510               return error return-value .
     6511             end.
     6512             assign
     6513               v-new-density = ( v-rvs-cli-qnty-after - v-rvs-cli-qnty-before ) / ( v-rvs-qnty-after - v-rvs-qnty-before )
     6514             .
     6515   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_stfactqt in g#lib-calc
     6516     ( input        p-stfactplvalue
     6517     , input        p-doc-qnty
     6518     , input        p-doc-density
     6519     , input        v-rvs-qnty-before
     6520     , input        v-rvs-qnty-after
     6521     , input        0.00
     6522     , input        0.00
     6523     , input        no
     6524     , input-output v-new-fact-qnty
     6525     ,       output v-chg
     6526     ,       output v-st-doc
     6527     )              no-error
     6528   .
     6529             if error-status :error then do:
     6530               return error return-value .
     6531             end.
     6532             if v-new-fact-qnty <> p-new-fact-qnty
     6533               or v-chg = true
     6534               or v-st-doc = true
     6535             then do:
     6536               if v-st-doc = true
     6537                 or v-new-density = ?
     6538               then do:
     6539                 assign
     6540                   v-new-density = p-doc-density
     6541                 .
     6542               end.
     6543               if v-new-fact-qnty <> p-new-fact-qnty
     6544                 or v-new-density <> p-new-density
     6545               then do:
     6546                 assign
     6547                   v-log = true
     6548                 .
     6549                 if p-fact-edit = true then do:
     6550                   message
     6551                     substitute( "По результатам измерения в резервуаре фактическое кол-во необходимо изменить." ) skip
     6552                     substitute( "Будем менять фактические" ) skip
     6553                     substitute( "количество на &1 (&2),", v-new-fact-qnty, buf_goods.unit-base ) skip
     6554                     substitute( "плотность на &1 ?", v-new-density ) skip
     6555                     view-as alert-box question buttons yes-no update v-log .
     6556                 end.
     6557                 else do:
     6558                   message
     6559                     substitute( "По результатам измерения фактическое кол-во товара изменяется на &1 (&2),", v-new-fact-qnty, buf_goods.unit-base ) skip
     6560                     substitute( "фактическая плотность на &1.", v-new-density ) skip
     6561                     view-as alert-box information .
     6562                 end.
     6563                 if v-log = true then do:
     6564                   assign
     6565                     p-new-fact-qnty     = v-new-fact-qnty
     6566                     p-new-density       = v-new-density
     6567                     p-new-cli-fact-qnty = p-new-fact-qnty * p-new-density
     6568                   .
     6569                 end.
     6570               end.
     6571             end.
     6572           end.
     6573         end.
     6574       end procedure.
     6575       procedure eq-qnty-rvs-pl :
     6576         define input        parameter p-doc-code             like ub.trn-doc.doc-code      no-undo .
     6577         define input        parameter p-gds-code             like ub.goods.gds-code        no-undo .
     6578         define input        parameter p-fact-edit            as   logical                  no-undo .
     6579         define input-output parameter p-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     6580         define input-output parameter p-new-density          like ub.doc-line.fact-density no-undo .
     6581         define input-output parameter p-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     6582         define output       parameter p-ok                   as   logical                  no-undo .
     6583         do
     6584         on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6585         on stop   undo, return error substitute( "&1. stop", vss-workfile )
     6586         on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     6587         :
     6588           define buffer buf-after_rvs-doc   for ub.rvs-doc  .
     6589           define buffer buf_place           for ub.place .
     6590           define variable v-rvs-qnty-before     like ub.rvs-line.state-measure-qnty     no-undo .
     6591           define variable v-rvs-qnty-after      like ub.rvs-line.state-measure-qnty     no-undo .
     6592           define variable v-rvs-cli-qnty-before like ub.rvs-line.state-measure-cli-qnty no-undo .
     6593           define variable v-rvs-cli-qnty-after  like ub.rvs-line.state-measure-cli-qnty no-undo .
     6594           define variable v-count-pl      as integer   no-undo .
     6595           define variable v-message       as character no-undo .
     6596           define variable v-tot-qnty-pl   as decimal   no-undo .
     6597           define variable v-tot-qnty-rvs  as decimal   no-undo .
     6598           define variable v-tot-cli-qnty-rvs  as decimal   no-undo .
     6599           define variable v-add-option-bt as character no-undo .
     6600           define variable v-add-option-ps as character no-undo .
     6601           define variable v-answ-num      as integer   no-undo .
     6602           define variable v-edit-doc-pl   as integer   no-undo .
     6603           define variable v-set-doc-pl    as integer   no-undo .
     6604           define variable v-delta-mass-qnty as decimal no-undo.
     6605           define variable rdc-dnstvalue   as character no-undo.
     6606           define variable rdc-dnsttype    as character no-undo.
     6607           define variable v-attr-type     as character no-undo .
     6608           define variable v-attr-value    as character no-undo .
     6609           define variable v-place-trk-err as character no-undo .
     6610           define variable v-trk-err       as logical no-undo .
     6611           define variable ii              as integer no-undo .
     6612           define buffer buf_goods for ub.goods .
     6613           run gds-attr-value in this-procedure
     6614             (  input p-gds-code
     6615               ,input 'fuel-type':U
     6616               ,output v-attr-value
     6617               ,output v-attr-type
     6618              ) .
     6619           if v-attr-value = "lgas"
     6620           then do:
     6621             p-ok = true.
     6622             return.
     6623           end.
     6624           find first buf_goods no-lock
     6625             where buf_goods.gds-code = p-gds-code
     6626             .
     6627           assign
     6628             p-ok           = true
     6629             v-message      = "":U
     6630             v-count-pl     = 0
     6631             v-tot-qnty-rvs = 0.0
     6632             v-tot-qnty-pl  = 0.0
     6633             v-tot-cli-qnty-rvs = 0.0
     6634           .
     6635           for each tt-doc-pl no-lock
     6636           on error undo, return error return-value
     6637           :
     6638             v-place-trk-err = "" .
     6639             run return-rvs-qnty in this-procedure
     6640               ( input  p-doc-code
     6641                ,input  p-gds-code
     6642                ,input  tt-doc-pl.pl-code
     6643                ,output v-rvs-qnty-before
     6644                ,output v-rvs-qnty-after
     6645                ,output v-rvs-cli-qnty-before
     6646                ,output v-rvs-cli-qnty-after
     6647                ,output v-delta-mass-qnty
     6648                ,output v-trk-err
     6649               ) no-error .
     6650             if error-status :error then do:
     6651               return error return-value .
     6652             end.
     6653             if v-trk-err
     6654             then do :
     6655               assign v-place-trk-err = v-place-trk-err + string(tt-doc-pl.pl-code) + ',' .
     6656             end .
     6657             assign
     6658               v-count-pl     = v-count-pl + 1
     6659               v-tot-qnty-rvs = v-tot-qnty-rvs + ( v-rvs-qnty-after - v-rvs-qnty-before )
     6660               v-tot-cli-qnty-rvs = v-tot-cli-qnty-rvs + ( v-rvs-cli-qnty-after - v-rvs-cli-qnty-before )
     6661               v-tot-qnty-pl  = v-tot-qnty-pl  + tt-doc-pl.fact-qnty
     6662             .
     6663             run placelib_get-attr  (
     6664                input "place-com-tanks"
     6665               ,input t-doc.obj-code
     6666               ,input t-doc.obj-type
     6667               ,input tt-doc-pl.pl-code
     6668               ,output v-value
     6669               ,output v-ok      )
     6670             no-error.
     6671             if  v-ok
     6672             and v-value > ""
     6673             then do :
     6674               do ii = 1 to num-entries(v-value) :
     6675                 find first buf_place no-lock where buf_place.obj-type = tt-doc-pl.obj-type
     6676                                                and buf_place.obj-code = tt-doc-pl.obj-code
     6677                                                and buf_place.loc1     = entry(ii, v-value)
     6678                                                and buf_place.status_  = ""
     6679                                                no-error .
     6680                 if available buf_place
     6681                 then do :
     6682                   run return-rvs-qnty in this-procedure
     6683                     ( input  p-doc-code
     6684                      ,input  p-gds-code
     6685                      ,input  buf_place.pl-code
     6686                      ,output v-rvs-qnty-before
     6687                      ,output v-rvs-qnty-after
     6688                      ,output v-rvs-cli-qnty-before
     6689                      ,output v-rvs-cli-qnty-after
     6690                      ,output v-delta-mass-qnty
     6691                      ,output v-trk-err
     6692                     ) no-error .
     6693                   if error-status :error then do:
     6694                     return error return-value .
     6695                   end.
     6696                   if v-trk-err
     6697                   then do :
     6698                     assign v-place-trk-err = v-place-trk-err + string(buf_place.pl-code) + ',' .
     6699                   end .
     6700                   assign
     6701                     v-count-pl     = v-count-pl + 1
     6702                     v-tot-qnty-rvs = v-tot-qnty-rvs + ( v-rvs-qnty-after - v-rvs-qnty-before )
     6703                     v-tot-cli-qnty-rvs = v-tot-cli-qnty-rvs + ( v-rvs-cli-qnty-after - v-rvs-cli-qnty-before )
     6704                   .
     6705                 end .
     6706               end .
     6707             end .
     6708             assign v-place-trk-err = trim(v-place-trk-err, ",") .
     6709             if v-place-trk-err > ""
     6710             then do :
     6711               assign v-trk-err = yes .
     6712             end .
     6713             run gbl/conf-rd.p ("rdc-dnst", "", "", 0, "", "", "", no, output rdc-dnstvalue, output rdc-dnsttype) no-error.
     6714             if error-status:error
     6715             then do:
     6716               rdc-dnstvalue = 'not'.
     6717             end.
     6718             else do:
     6719               rdc-dnstvalue = rdc-dnstvalue.
     6720             end.
     6721             if not (varauto-tank and rdc-dnstvalue = "pomi-rn")
     6722             then do:
     6723               if absolute( v-tot-qnty-rvs - tt-doc-pl.fact-qnty ) > tt-doc-pl.fact-qnty * 0.0065 then do:
     6724                 if v-message = "":U then do:
     6725                   assign
     6726                     v-message = "Факт. кол-во по местам хранения и по сверкам:".
     6727                   .
     6728                 end.
     6729                 assign
     6730                   v-message = v-message
     6731                               + chr(10)
     6732                               + substitute( "по месту хр. &1 (&4): &2, по сверкам: &3"
     6733                                           ,tt-doc-pl.pl-code
     6734                                           ,tt-doc-pl.fact-qnty
     6735                                           ,v-tot-qnty-rvs
     6736                                           ,buf_goods.unit-base
     6737                                           )
     6738                 .
     6739                 if v-trk-err
     6740                 then do :
     6741                   v-message = substitute("Масса реализации при расчете расхождения не была учтена из-за ошибок при получении данных с ТРК по месту хр. &1", tt-doc-pl.pl-code)
     6742                             + chr(10)
     6743                             + v-message
     6744                   .
     6745                 end .
     6746               end.
     6747             end.
     6748             else do:
     6749               v-delta-mass-qnty = tt-doc-pl.cli-fact-qnty * v-delta-mass-qnty / 100.
     6750               if absolute( v-tot-cli-qnty-rvs - tt-doc-pl.cli-fact-qnty ) > v-delta-mass-qnty
     6751               then do:
     6752                 if v-message = "":U then do:
     6753                   assign
     6754                     v-message = substitute ("Факт. кол-во по сверкам не совпадает с факт. кол-вом по местам хранения :").
     6755                   .
     6756                 end.
     6757                 assign
     6758                   v-message = v-message
     6759                               + chr(10)
     6760                               + substitute( "по месту хр. &1 (&4): &2, по сверкам: &3, погрешность измерения: &5."
     6761                                           ,tt-doc-pl.pl-code
     6762                                           ,tt-doc-pl.cli-fact-qnty
     6763                                           ,v-tot-cli-qnty-rvs
     6764                                           ,buf_goods.unit-cli
     6765                                           ,round (v-delta-mass-qnty, 3)
     6766                                           )
     6767                 .
     6768                 if v-trk-err
     6769                 then do :
     6770                   v-message = substitute("Масса реализации при расчете расхождения не была учтена из-за ошибок при получении данных с ТРК по месту хр. &1", tt-doc-pl.pl-code)
     6771                             + chr(10)
     6772                             + v-message
     6773                   .
     6774                 end .
     6775                 message v-message view-as alert-box warning title "Внимание!".
     6776                 v-message = "".
     6777               end.
     6778             end.
     6779           end.
     6780           if v-message <> "":U
     6781             then return.
     6782           if v-message <> "":U
     6783             and ( v-count-pl > 1
     6784                   or ( v-count-pl = 1
     6785                         and p-fact-edit = true
     6786                       )
     6787                 )
     6788           then do:
     6789             assign
     6790               v-edit-doc-pl = ?
     6791               v-set-doc-pl  = ?
     6792             .
     6793             if p-fact-edit = true
     6794               or ( p-fact-edit = false
     6795                    and v-tot-qnty-pl  = p-new-fact-qnty
     6796                    and v-tot-qnty-rvs = p-new-fact-qnty
     6797                  )
     6798             then do:
     6799               assign
     6800                 v-add-option-bt = v-add-option-bt + "|Редактировать"
     6801                 v-add-option-ps = v-add-option-ps + "|Редактировать товар на местах хранения"
     6802                 v-edit-doc-pl   = 3
     6803               .
     6804             end.
     6805             if p-fact-edit = true
     6806               or ( p-fact-edit = false
     6807                    and v-tot-qnty-rvs = p-new-fact-qnty
     6808                   )
     6809             then do:
     6810               assign
     6811                 v-add-option-bt = v-add-option-bt + "|Установить"
     6812                 v-add-option-ps = v-add-option-ps + "|Установить по местам хранения кол-вo из сверок (плотность по документу)"
     6813               .
     6814               if v-edit-doc-pl = ? then do:
     6815                 assign
     6816                   v-set-doc-pl = 3
     6817                 .
     6818               end.
     6819               else do:
     6820                 assign
     6821                   v-set-doc-pl = 4
     6822                 .
     6823               end.
     6824             end.
     6825   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6826   run get-ptrl-prop in this-procedure
     6827     ( input t-doc.obj-type
     6828     , input t-doc.obj-code
     6829     ) .
     6830             run gbl/d-askw.w
     6831               ( input "Расхождение значений по местам хранения с показаниями сверок"
     6832                ,input substitute( "&1", v-message ) + chr(10) + "Это вызовет расхождение фактических и расчетно-книжных остатков"
     6833                ,input "|^"
     6834                ,input "Сохранить|Отмена" + v-add-option-bt
     6835                ,input "Сохранить, игнорируя это расхождение|Отмена сохранения" + v-add-option-ps
     6836                ,input 1
     6837                ,input 2
     6838                ,output v-answ-num
     6839               ) .
     6840             if v-answ-num = 2 then do:
     6841               return error .
     6842             end.
     6843             if v-edit-doc-pl <> ?
     6844               and v-answ-num = v-edit-doc-pl
     6845             then do:
     6846               assign
     6847                 p-ok = false
     6848               .
     6849               run edit-doc-pl in this-procedure
     6850                 ( input 'ИЗМЕНЕНИЕ':U
     6851                 ).
     6852               return .
     6853             end.
     6854             if v-set-doc-pl <> ?
     6855               and v-answ-num = v-set-doc-pl
     6856             then do:
     6857               assign
     6858                 p-ok = false
     6859                 p-new-fact-qnty     = 0.0
     6860                 p-new-cli-fact-qnty = 0.0
     6861               .
     6862               for each tt-doc-pl
     6863               on error undo, return error return-value
     6864               :
     6865                 run return-rvs-qnty in this-procedure
     6866                   ( input  p-doc-code
     6867                    ,input  p-gds-code
     6868                    ,input  tt-doc-pl.pl-code
     6869                    ,output v-rvs-qnty-before
     6870                    ,output v-rvs-qnty-after
     6871                    ,output v-rvs-cli-qnty-before
     6872                    ,output v-rvs-cli-qnty-after
     6873                    ,output v-delta-mass-qnty
     6874                    ,output v-trk-err
     6875                   ) no-error .
     6876                 if error-status :error then do:
     6877                   return error return-value .
     6878                 end.
     6879                 assign
     6880                   tt-doc-pl.fact-qnty     = v-rvs-qnty-after - v-rvs-qnty-before
     6881                   tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * p-new-density
     6882                   p-new-fact-qnty         = p-new-fact-qnty    + tt-doc-pl.fact-qnty
     6883                   p-new-cli-fact-qnty     = p-new-cli-fact-qnty + tt-doc-pl.cli-fact-qnty
     6884                 .
     6885               end.
     6886               assign
     6887                 p-new-density = p-new-cli-fact-qnty / p-new-fact-qnty
     6888               .
     6889               return .
     6890             end.
     6891           end.
     6892         end.
     6893       end procedure.
     6894       PROCEDURE block-nozzle:
     6895         define input parameter parparentproc  as handle    no-undo.
     6896         define input parameter obj-type       as character no-undo.
     6897         define input parameter obj-code       as integer   no-undo.
     6898         define input parameter list-pl        as character no-undo.
     6899         run str/diallog.w ( input parparentproc
     6900            ,input this-procedure
     6901            ,input 'str/get-block-nozzle.p':U
     6902            ,input (obj-type + chr(4) +
     6903            string(obj-code) + chr(4) +
     6904            string(0) + chr(4) +
     6905            string(0) + chr(4) +
     6906            chr(4) +
     6907            chr(4) +
     6908            chr(4) +
     6909            substitute("&1,&2"
     6910            ,"block"
     6911            ,list-pl))
     6912            ,input yes
     6913            ,input ''
     6914            ,input 'Блокировка пистолетов') .
     6915         if not error-status:error then
     6916         do:
     6917            if return-value begins "Для кассы" then
     6918            do:
     6919               message return-value
     6920                  view-as alert-box question buttons yes-no update v-ok as logical  .
     6921               if v-ok then run block-nozzle ( parparentproc, obj-type, obj-code, list-pl ).
     6922               else message "Сообщите в службу поддержки о неуспешной попытке блокировки пистолетов"
     6923                     view-as alert-box.
     6924            end.
     6925            else
     6926            do:
     6927               message "Блокировка пистолетов прошла успешно"
     6928                  view-as alert-box.
     6929            end.
     6930         end.
     6931         else
     6932         do:
     6933            message return-value
     6934               view-as alert-box question buttons yes-no update v-ok .
     6935            if v-ok then run block-nozzle .
     6936            else                   message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     6937                  view-as alert-box.
     6938         end.
     6939       END PROCEDURE .
     6940       PROCEDURE unblock-nozzle:
     6941         define input parameter parparentproc  as handle    no-undo.
     6942         define input parameter obj-type       as character no-undo.
     6943         define input parameter obj-code       as integer   no-undo.
     6944         define input parameter list-pl        as character no-undo.
     6945         run str/diallog.w ( input parparentproc
     6946           ,input this-procedure
     6947           ,input 'str/get-block-nozzle.p':U
     6948           ,input (obj-type + chr(4) +
     6949           string(obj-code) + chr(4) +
     6950           string(0) + chr(4) +
     6951           string(0) + chr(4) +
     6952           chr(4) +
     6953           chr(4) +
     6954           chr(4) +
     6955           substitute("&1,&2"
     6956           ,"unblock"
     6957           ,list-pl))
     6958           ,input yes
     6959           ,input ''
     6960           ,input 'Разблокировка пистолетов') .
     6961         if not error-status:error then
     6962         do:
     6963            if return-value begins "Для кассы" then
     6964            do:
     6965               message return-value
     6966                  view-as alert-box question buttons yes-no update v-ok as logical  .
     6967               if v-ok then run unblock-nozzle( parparentproc, obj-type, obj-code, list-pl ).
     6968               else message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     6969                     view-as alert-box.
     6970            end.
     6971            else
     6972            do:
     6973               message "Разблокировка пистолетов прошла успешно"
     6974                  view-as alert-box.
     6975            end.
     6976         end.
     6977         else
     6978         do:
     6979           message return-value
     6980              view-as alert-box question buttons yes-no update v-ok .
     6981           if v-ok then run unblock-nozzle .
     6982           else                   message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     6983                 view-as alert-box.
     6984            end.
     6985       END PROCEDURE.
