    10558           p-tank-weight-rvs   = p-tank-weight-rvs + M
    10559           p-tank-vol-pomi-rvs = p-tank-vol-pomi-rvs + (((V_total2 - V_water2) - (V_total1 - V_water1)) * 1000)
    10560           v-avg-temp          = v-avg-temp + ((bf_bef_rvs-line.state-temperature + bf_aft_rvs-line.state-temperature) / 2)
    10561         .
    10562         assign v-warnings = (if v-warnings = "" then vWrn else v-warnings + chr(10) + vWrn) .
    10563       end .
    10564       assign v-avg-temp = v-avg-temp / num-entries(v-pl-code-list) .
    10565       infoSecObj:TankWeightRvs = p-tank-weight-rvs .
