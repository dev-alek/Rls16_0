     2028         where buf_doc-line-attr.doc-code  = p-doc-code
     2029           and buf_doc-line-attr.gds-code  = p-gds-code
     2030           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2031         no-error .
     2032       if not available buf_doc-line-attr then do:
     2033         create buf_doc-line-attr .
     2034         assign
     2035           buf_doc-line-attr.doc-code  = p-doc-code
     2036           buf_doc-line-attr.gds-code  = p-gds-code
     2037           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2038         .
     2039       end.
     2040       assign
     2041         buf_doc-line-attr.attr-value = string( p-value )
     2042       .
     2043     end.
     2044   end procedure.
