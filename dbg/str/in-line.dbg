    16366     ,output  varprice-base-dt
    16367     ,output  varprice-road-tax-base-dt
    16368     ,output  varprice-other-exp-base-dt
    16369     ,output  varprice-transport-exp-base-dt
    16370     ,output  varprice-without-abs-base-dt
    16371     ,output  varprice-slt-base-dt
    16372     ,output  varprice-no-slt-base-dt
    16373     ,output  varprice-vat-base-dt
    16374     ,output  varprice-no-vat-slt-base-dt
    16375     ) no-error.
    16376     if error-status :error then do:
    16377       return error substitute ("Ошибка при пересчете линии документа: &1", return-value).
    16378     end.
    16379     assign sum-vat = varprice-vat-dt * tt-fr-doc-line.cli-qnty.
    16380     display sum-vat with frame d-in-line.
    16381     if vat-sumvalue = "yes" then do:
    16382       if v-round-vat-sum and sum-vat <> 0 then do:
    16383         assign
    16384           sum-vat = round(varprice-vat-dt * tt-fr-doc-line.cli-qnty, 2 )
    16385         .
    16386         run calc-vat-pc in this-procedure.
    16387       end.
    16388     end.
    16389     run new-price-s in this-procedure .
    16390     run new-price-prod in this-procedure .
    16391   end procedure.
    16392   procedure save-action:
    16393     define input parameter partype-check as character no-undo.
    16394     zap:
    16395     do transaction
    16396     on error  undo zap, return error return-value
    16397     on stop   undo zap, return error return-value
    16398     on endkey undo zap, return error return-value
    16399     :
    16400       define variable v-ok as logical   no-undo .
    16401       if parline-mode <> 'ПРОСМОТР':U then do:
    16402         assign
    16403           frame d-in-line
    16404           tt-fr-doc-line.price-prod
    16405           tt-fr-doc-line.price-prod-vat
    16406           tt-fr-doc-line.new-price-sale
    16407         .
    16408         assign
    16409           v-ok = false
    16410         .
    16411         block_save:
    16412         do while v-ok <> true
    16413         on error  undo zap, return error return-value
    16414         on stop   undo zap, return error return-value
    16415         on endkey undo zap, return error return-value
    16416         :
    16417           run save-price-prod in this-procedure
    16418             no-error.
    16419           if error-status :error then do:
    16420             undo zap, return error return-value.
    16421           end.
    16422           run check-frame in this-procedure
    16423             ( input partype-check
    16424             ) no-error.
    16425           if error-status :error then do:
    16426             undo zap, return error return-value.
    16427           end.
    16428           run save-place-rsrv in this-procedure
    16429             ( input partype-check
    16430              ,output v-ok
    16431             ) no-error.
    16432           if error-status :error then do:
    16433             undo zap, return error return-value.
    16434           end.
    16435           if v-ok = true then do:
    16436             run local-cor-line in this-procedure
    16437               no-error.
    16438             if error-status :error then do:
    16439               undo zap, return error return-value.
    16440             end.
    16441             run save-country-code in this-procedure
    16442               no-error.
    16443             if error-status :error then do:
    16444               undo zap, return error return-value.
    16445             end.
    16446             run init-tt-doc-pl in this-procedure
    16447               no-error.
    16448             if error-status :error then do:
    16449               undo zap, return error return-value.
    16450             end.
    16451           end.
    16452         end.
    16453       end.
    16454     end.
    16455     if parline-mode <> 'ПРОСМОТР':U then do: assign parline-mode = 'ИЗМЕНЕНИЕ':U. end.
    16456     find t-doc where recid( t-doc ) = pardoc-rec.
    16457   end procedure.
    16458   procedure local-cor-line:
    16459     define variable v-part-code as character no-undo.
    16460     define buffer lc_doc-line for ub.doc-line.
    16461     if tt-fr-doc-line.alc-prod and
    16462       (tt-fr-doc-line.alc-part-code = ?)
