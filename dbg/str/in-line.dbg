     1208     ,input  parobj-type
     1209     ,input  parobj-code
     1210     ,output varrate-value
     1211     ) no-error .
     1212           if error-status:error or varrate-value = ? then do:
     1213             assign varmes = "Не найдена величина ставки налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name + " " + string(buf_tt-tax.rate-code) +
     1214                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1215                             " фирма: " + string(parhost-code) +
     1216                             " объект: " + parobj-type + " " + string(parobj-code) + chr(10).
     1217             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1218           end.
     1219           assign
     1220           buf_tt-tax.rate-value  = varrate-value
     1221           .
     1222         end.
     1223         else do:
     1224           if not avail buf_gds-prt then
     1225           FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
     1226   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1227     (
     1228        input buf_goods.artic
     1229     ,  input buf_goods.prod-type
     1230     ,  input buf_goods.prod-code
     1231     , output is-petrolium
     1232     , output is-pieces
     1233     ) no-error.
     1234           if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U then do:
     1235             find FIRST buf_prod-bc where
     1236                         buf_prod-bc.b-code     = buf_goods.gds-code     and
     1237                         buf_prod-bc.bc-on = yes no-lock no-error.
     1238             if not available buf_prod-bc then do:
     1239               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1240                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1241               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1242             end.
     1243           end.
     1244           else do:
     1245             find buf_bar-code where
     1246                   buf_bar-code.gds-code  = vargds-code     and
     1247                   buf_bar-code.node-code = buf_gds-prt.node-code and
     1248                   buf_bar-code.part-code = ""           and
     1249                   buf_bar-code.in-code   = ""           and
     1250                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
     1251             if not available buf_bar-code then do:
     1252               assign varmes = "Не найден бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
     1253                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
     1254               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
     1255             end.
     1256           end.
     1257           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
     1258             ASSIGN
     1259             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1260                                   then integer(buf_prod-bc.b-str)
     1261                                   else buf_bar-code.b-code
     1262             buf_tt-tax.rate-value  = parroad-tax
     1263             buf_tt-tax.tax-rate-gds-rc  = ?
     1264             NO-ERROR.
     1265           end.
     1266           if buf_tt-tax.tax-code = exctaxcdvalue then do:
     1267             ASSIGN
     1268             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
     1269                                   then integer(buf_prod-bc.b-str)
     1270                                   else buf_bar-code.b-code
     1271             buf_tt-tax.rate-value  = parexcise
     1272             buf_tt-tax.tax-rate-gds-rc  = ?
     1273             NO-ERROR.
     1274           end.
     1275         end.
     1276       end.
     1277     end.
     1278   end procedure.
     1279   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   define new global shared variable g#lib-calc as handle no-undo .
     1281   define variable vss-include-info13 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1282   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1283   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1284   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1285   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1286   ASSIGN
     1287      v-S_CONTRACT                = "Contract":U
     1288      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1289      v-DELIM_CHR_3               = ","
     1290      .
     1291   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1292   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1293   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1294   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1295      INPUT iHost-Code    AS INTEGER,
     1296      INPUT iContract-Num AS INTEGER,
     1297      INPUT iGds-Code     AS INTEGER ):
     1298      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1299      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1300      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1301      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1302      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1303      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1304          INPUT  iHost-Code,
     1305          INPUT  iContract-Num,
     1306          OUTPUT iTmp-Extent3
     1307          ).
     1308      IF iTmp-Extent3[1] = 2 THEN DO:
     1309         ASSIGN
     1310            iTmp-Host-Code      = iTmp-Extent3[2]
     1311            iTmp-Contract-Num   = iTmp-Extent3[3]
     1312            .
     1313      END. ELSE DO:
     1314         ASSIGN
     1315            iTmp-Host-Code      = iHost-Code
     1316            iTmp-Contract-Num   = iContract-Num
     1317            .
     1318      END.
     1319      IF iGds-Code = ? THEN DO:
     1320         ASSIGN
     1321            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1322                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1323                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1324                           ).
     1325      END. ELSE DO:
     1326            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1327                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1328                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1329                              AND buf_Spec.Gds-Code      = iGds-Code
     1330                            ).
     1331      END.
     1332      RETURN (lRet).
     1333   END FUNCTION.
     1334   PROCEDURE MS-Contract-EXTENT-3:
     1335      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1336      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1337      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1338      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1339      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1340      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1341      FIND FIRST buf_Cont-2 WHERE
     1342                 buf_Cont-2.Host-Code      = i-Host-Code
     1343             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1344           NO-LOCK NO-ERROR.
     1345      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1346         RETURN.
     1347      END.
     1348      FOR FIRST buf_Ext-Classif WHERE
     1349                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1350           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1351                                               STRING(i-Contract-code)
     1352           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1353          NO-LOCK,
     1354          EACH buf_Cont WHERE
     1355               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1356           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1357          NO-LOCK:
     1358          ASSIGN
     1359             i-Ret[1] = 1
     1360             i-Ret[2] = buf_Cont.Host-code
     1361             i-Ret[3] = buf_Cont.Contract-code
     1362             .
     1363          LEAVE.
     1364      END.
     1365      IF i-Ret[1] <> 1 THEN DO:
     1366         FOR FIRST buf_Ext-Classif WHERE
     1367                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1368              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1369                                                  STRING(i-Contract-code)
     1370              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1371             NO-LOCK,
     1372             EACH buf_Cont WHERE
     1373                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1374              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1375             NO-LOCK:
     1376             ASSIGN
     1377                i-Ret[1] = 2
     1378                i-Ret[2] = buf_Cont.Host-code
     1379                i-Ret[3] = buf_Cont.Contract-code
     1380                .
     1381             LEAVE.
     1382         END.
     1383      END.
     1384      RETURN.
     1385   END PROCEDURE.
     1386   procedure cpprclig :
     1387     define input        parameter pardoc-code       as   character                  no-undo.
     1388     define input        parameter parcli-code       like ub.trn-doc.cli-code        no-undo.
     1389     define input        parameter parcli-type       like ub.trn-doc.cli-type        no-undo.
     1390     define input        parameter parhost-code      like ub.trn-doc.host-code       no-undo.
     1391     define input        parameter parbase-rate      like ub.trn-doc.base-rate       no-undo.
     1392     define input        parameter parbase-scale     like ub.trn-doc.base-scale      no-undo.
     1393     define input        parameter parexch-rate      like ub.trn-doc.exch-rate       no-undo.
     1394     define input        parameter parexch-scale     like ub.trn-doc.exch-scale      no-undo.
     1395     define input        parameter parvat-type       like ub.trn-doc.vat-type        no-undo.
     1396     define input        parameter parslt-type       like ub.trn-doc.slt-type        no-undo.
     1397     define input        parameter parartic          like ub.doc-line.artic          no-undo.
     1398     define input        parameter parprod-type      like ub.doc-line.prod-type      no-undo.
     1399     define input        parameter parprod-code      like ub.doc-line.prod-code      no-undo.
     1400     define input        parameter paris-cli-tax     as   logical                    no-undo.
     1401     define input        parameter parcli-base-rate  like ub.doc-line.cli-base-rate  no-undo.
     1402     define input        parameter partransport-rubl like ub.doc-line.transport-rubl no-undo.
     1403     define input        parameter parother-rubl     like ub.doc-line.other-rubl     no-undo.
     1404     define output       parameter parprice-cli      like ub.doc-line.price-cli      no-undo.
     1405     define output       parameter parprice-base     like ub.doc-line.price-base     no-undo.
     1406     define output       parameter parprice-rubl     like ub.doc-line.price-rubl     no-undo.
     1407     define input-output parameter parvat-pc         like ub.doc-line.vat-pc         no-undo.
     1408     define input-output parameter parslt-pc         like ub.doc-line.slt-pc         no-undo.
     1409     define input-output parameter parroad-tax       like ub.doc-line.road-tax       no-undo.
     1410     define input-output parameter parexcise         like ub.doc-line.excise         no-undo.
     1411     define variable varprice-cli                like ub.doc-line.price-rubl no-undo.
     1412     define variable varprice-cli-unit-base      like ub.doc-line.price-rubl no-undo.
     1413     define variable varprice-road-tax           like ub.doc-line.price-rubl no-undo.
     1414     define variable varprice-other-exp          like ub.doc-line.price-rubl no-undo.
     1415     define variable varprice-transport-exp      like ub.doc-line.price-rubl no-undo.
     1416     define variable varprice-without-abs        like ub.doc-line.price-rubl no-undo.
     1417     define variable varprice-slt                like ub.doc-line.price-rubl no-undo.
     1418     define variable varprice-no-slt             like ub.doc-line.price-rubl no-undo.
     1419     define variable varprice-vat                like ub.doc-line.price-rubl no-undo.
     1420     define variable varprice-no-vat-slt         like ub.doc-line.price-rubl no-undo.
     1421     define variable varprice-rubl               like ub.doc-line.price-rubl no-undo.
     1422     define variable varprice-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
     1423     define variable varprice-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
     1424     define variable varprice-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
     1425     define variable varprice-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
     1426     define variable varprice-slt-rubl           like ub.doc-line.price-rubl no-undo.
     1427     define variable varprice-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
     1428     define variable varprice-vat-rubl           like ub.doc-line.price-rubl no-undo.
     1429     define variable varprice-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
     1430     define variable varprice-base               like ub.doc-line.price-base no-undo.
     1431     define variable varprice-road-tax-base      like ub.doc-line.price-base no-undo.
     1432     define variable varprice-other-exp-base     like ub.doc-line.price-base no-undo.
     1433     define variable varprice-transport-exp-base like ub.doc-line.price-base no-undo.
     1434     define variable varprice-without-abs-base   like ub.doc-line.price-base no-undo.
     1435     define variable varprice-slt-base           like ub.doc-line.price-base no-undo.
     1436     define variable varprice-no-slt-base        like ub.doc-line.price-base no-undo.
     1437     define variable varprice-vat-base           like ub.doc-line.price-base no-undo.
     1438     define variable varprice-no-vat-slt-base    like ub.doc-line.price-base no-undo.
     1439     define variable v-specif-found              as   logical                no-undo.
     1440     define variable v-rcv-found                 as   logical                no-undo .
     1441     define buffer bf_cli-gds         for ub.cli-gds .
     1442     define buffer bf_doc-line        for ub.doc-line.
     1443     define buffer bf_trn-doc         for ub.trn-doc.
     1444     define buffer bf_goods           for ub.goods.
     1445     define buffer bf_contract-specif for ub.contract-specif.
     1446     define buffer buf_ord-chain      for ub.ord-chain .
     1447     define buffer buf_ord-doc-rcv    for ub.ord-doc-rcv .
     1448     define buffer buf_ord-line-rcv   for ub.ord-line-rcv .
     1449     do
     1450     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message ( 1 ) )
     1451     on stop   undo, return error substitute( "&1. stop", vss-include-info13 )
     1452     on endkey undo, return error substitute( "&1. endkey", vss-include-info13 )
     1453     :
     1454       assign
     1455         v-rcv-found    = false
     1456         v-specif-found = false
     1457       .
     1458       find first buf_ord-chain no-lock
     1459         where buf_ord-chain.rel-doc-code =  pardoc-code
     1460           and buf_ord-chain.rel-doc-type = 'trn':u
     1461         no-error .
     1462       if available buf_ord-chain then do:
     1463         find first buf_ord-doc-rcv no-lock
     1464           where buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code
     1465         no-error .
     1466         if available buf_ord-doc-rcv then do:
     1467           find first buf_ord-line-rcv no-lock
     1468             where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
     1469               and buf_ord-line-rcv.artic     = parartic
     1470               and buf_ord-line-rcv.prod-type = parprod-type
     1471               and buf_ord-line-rcv.prod-code = parprod-code
     1472             no-error .
     1473           if available buf_ord-line-rcv then do:
     1474             find first bf_trn-doc  no-lock
     1475               where bf_trn-doc.doc-code = pardoc-code
     1476             .
     1477             assign
     1478               parprice-cli = buf_ord-line-rcv.price-cli
     1479               parroad-tax  = buf_ord-line-rcv.road-tax
     1480               parexcise    = buf_ord-line-rcv.excise
     1481               v-rcv-found  = true
     1482               .
     1483             if parslt-type <> 'без':U then do:
     1484               if bf_trn-doc.slt-type <> 'без':U then do:
     1485                 assign
     1486                   parslt-pc = buf_ord-line-rcv.slt-pc
     1487                 .
     1488               end.
     1489             end.
     1490             else do:
     1491               assign
     1492                 parslt-pc = 0
     1493               .
     1494             end.
     1495             if parvat-type <> 'без':U then do:
     1496               if bf_trn-doc.vat-type <> 'без':U then do:
     1497                 assign
     1498                   parvat-pc = buf_ord-line-rcv.vat-pc
     1499                 .
     1500               end.
     1501             end.
     1502             else do:
     1503               assign
     1504                 parvat-pc = 0
     1505               .
     1506             end.
     1507           end.
     1508         end.
     1509       end.
     1510       if v-rcv-found = false then do:
     1511         find first bf_trn-doc no-lock
     1512           where bf_trn-doc.doc-code = pardoc-code
     1513           no-error.
     1514         if available bf_trn-doc
     1515           and bf_trn-doc.contract-code <> 0
     1516         then do:
     1517           find first bf_goods no-lock
     1518             where bf_goods.artic     = parartic
     1519               and bf_goods.prod-code = parprod-code
     1520               and bf_goods.prod-type = parprod-type
     1521             no-error.
     1522           if available bf_goods then do:
     1523   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1524   ASSIGN
     1525      i-gl-Host-Code      = 0
     1526      i-gl-Contract-Code  = 0
     1527      i-gl-Extent3        = 0
     1528      .
     1529   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1530       INPUT  bf_trn-doc.host-code,
     1531       INPUT  bf_trn-doc.contract-code,
     1532       OUTPUT i-gl-Extent3
     1533      ).
     1534   IF i-gl-Extent3[1] = 2 THEN DO:
     1535      ASSIGN
     1536         i-gl-Host-Code      = i-gl-Extent3[2]
     1537         i-gl-Contract-Code  = i-gl-Extent3[3]
     1538         .
     1539   END. ELSE DO:
     1540      ASSIGN
     1541         i-gl-Host-Code      = bf_trn-doc.host-code
     1542         i-gl-Contract-Code  = bf_trn-doc.contract-code
     1543         .
     1544   END.
     1545       FIND FIRST bf_contract-specif
     1546              NO-LOCK
     1547              WHERE
     1548                  bf_contract-specif.Host-code    = i-gl-Host-Code
     1549              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
     1550              AND bf_contract-specif.Gds-code     = bf_goods.gds-code
     1551              NO-ERROR
     1552              .
     1553             if available bf_contract-specif then do:
     1554               assign
     1555                 parprice-cli   = (bf_contract-specif.price-cli / bf_contract-specif.cli-base-rate)  * parcli-base-rate
     1556                 parvat-type    = bf_contract-specif.vat-type
     1557                 parvat-pc      = bf_contract-specif.vat-pc
     1558                 v-specif-found = yes
     1559               .
     1560             end.
     1561           end.
     1562         end.
     1563         find first bf_cli-gds no-lock
     1564           where bf_cli-gds.cli-code  = parcli-code
     1565             and bf_cli-gds.cli-type  = parcli-type
     1566             and bf_cli-gds.host-code = parhost-code
     1567             and bf_cli-gds.artic     = parartic
     1568             and bf_cli-gds.prod-code = parprod-code
     1569             and bf_cli-gds.prod-type = parprod-type
     1570           no-error.
     1571         if available bf_cli-gds then do:
     1572           if v-specif-found = false then do:
     1573             assign
     1574               parprice-cli = bf_cli-gds.price-cli
     1575             .
     1576           end.
     1577           if paris-cli-tax then do:
     1578             find first bf_doc-line no-lock
     1579               where bf_doc-line.doc-code  = bf_cli-gds.in-code
     1580                 and bf_doc-line.artic     = bf_cli-gds.artic
     1581                 and bf_doc-line.prod-type = bf_cli-gds.prod-type
     1582                 and bf_doc-line.prod-code = bf_cli-gds.prod-code
     1583               no-error.
     1584             if available bf_doc-line then do:
     1585               find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1586               assign
     1587                 parroad-tax = bf_doc-line.road-tax
     1588                 parexcise   = bf_doc-line.excise
     1589               .
     1590               if parslt-type <> 'без':U then do:
     1591                 if bf_trn-doc.slt-type <> 'без':U then do:
     1592                   assign
     1593                     parslt-pc = bf_doc-line.slt-pc
     1594                   .
     1595                 end.
     1596               end.
     1597               else do:
     1598                 assign
     1599                   parslt-pc = 0
     1600                 .
     1601               end.
     1602               if parvat-type <> 'без':U then do:
     1603                 if bf_trn-doc.vat-type <> 'без':U then do:
     1604                   if v-specif-found = false then do:
     1605                     assign
     1606                       parvat-pc = bf_doc-line.vat-pc
     1607                     .
     1608                   end.
     1609                 end.
     1610               end.
     1611               else do:
     1612                 assign
     1613                   parvat-pc = 0
     1614                 .
     1615               end.
     1616             end.
     1617           end.
     1618         end.
     1619       end.
     1620   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
     1621     (
     1622      input   pardoc-code
     1623     ,input   parbase-rate
     1624     ,input   parbase-scale
     1625     ,input   parexch-rate
     1626     ,input   parexch-scale
     1627     ,input   parvat-type
     1628     ,input   parslt-type
     1629     ,input   parartic
     1630     ,input   parprod-type
     1631     ,input   parprod-code
     1632     ,input   parprice-cli
     1633     ,input   parcli-base-rate
     1634     ,input   parprice-rubl
     1635     ,input   parvat-pc
     1636     ,input   parslt-pc
     1637     ,input   parroad-tax
     1638     ,input   partransport-rubl
     1639     ,input   parother-rubl
     1640     ,output  varprice-cli
     1641     ,output  varprice-cli-unit-base
     1642     ,output  varprice-road-tax
     1643     ,output  varprice-other-exp
     1644     ,output  varprice-transport-exp
     1645     ,output  varprice-without-abs
     1646     ,output  varprice-slt
     1647     ,output  varprice-no-slt
     1648     ,output  varprice-vat
     1649     ,output  varprice-no-vat-slt
     1650     ,output  varprice-rubl
     1651     ,output  varprice-road-tax-rubl
     1652     ,output  varprice-other-exp-rubl
     1653     ,output  varprice-transport-exp-rubl
     1654     ,output  varprice-without-abs-rubl
     1655     ,output  varprice-slt-rubl
     1656     ,output  varprice-no-slt-rubl
     1657     ,output  varprice-vat-rubl
     1658     ,output  varprice-no-vat-slt-rubl
     1659     ,output  varprice-base
     1660     ,output  varprice-road-tax-base
     1661     ,output  varprice-other-exp-base
     1662     ,output  varprice-transport-exp-base
     1663     ,output  varprice-without-abs-base
     1664     ,output  varprice-slt-base
     1665     ,output  varprice-no-slt-base
     1666     ,output  varprice-vat-base
     1667     ,output  varprice-no-vat-slt-base
     1668     ) no-error.
     1669       if error-status:error then do:
     1670         return error "Ошибка при пересчете линии документа".
     1671       end.
     1672       assign
     1673         parprice-cli  = varprice-cli
     1674         parprice-rubl = varprice-rubl
     1675         parprice-base = varprice-base
     1676       .
     1677     end.
     1678   end procedure.
     1679   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1680   procedure godendo-date-to-offset :
     1681     define input  parameter p-today  as date      no-undo .
     1682     define input  parameter p-date   as date      no-undo .
     1683     define output parameter p-offset as integer   no-undo .
     1684     do
     1685     on error undo, return error return-value
     1686     :
     1687       if p-date  = ?
     1688       or p-today = ?
     1689       then do:
     1690         assign
     1691           p-offset = ?
     1692         .
     1693       end.
     1694       else do:
     1695         assign
     1696           p-offset = p-date - p-today + 1
     1697         .
     1698       end.
     1699     end.
     1700   end procedure.
     1701   procedure godendo-offset-to-date :
     1702     define input  parameter p-today  as date      no-undo .
     1703     define input  parameter p-offset as integer   no-undo .
     1704     define output parameter p-date   as date      no-undo .
     1705     do
     1706     on error undo, return error return-value
     1707     :
     1708       if p-today  = ?
     1709       or p-offset = ?
     1710       then do:
     1711         assign
     1712           p-date = ?
     1713         .
     1714       end.
     1715       else do:
     1716         assign
     1717           p-date = p-offset + p-today - 1
     1718         .
     1719       end.
     1720     end.
     1721   end procedure.
     1722   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1723   procedure sel-date :
     1724     define input  parameter p-date-handle as handle    no-undo .
     1725     define input  parameter p-description as character no-undo .
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729       if (can-query (p-date-handle, "sensitive")
     1730         and
     1731         p-date-handle :sensitive = true
     1732         )
     1733       or (can-query (p-date-handle, "read-only")
     1734         and
     1735         p-date-handle :read-only = false
     1736         )
     1737       then do:
     1738         if p-date-handle :handle <> focus :handle
     1739         then do:
     1740           apply "entry":u to p-date-handle .
     1741         end.
     1742         define variable v-ok            as logical no-undo .
     1743         define variable v-curr-sv-date as date no-undo .
     1744         assign
     1745           v-curr-sv-date = date(p-date-handle :screen-value) no-error
     1746         .
     1747         if v-curr-sv-date = ?
     1748         then do:
     1749           run gbl/getcurdt.p
     1750             (output v-curr-sv-date
     1751             ) .
     1752         end.
     1753         if v-curr-sv-date <> ?
     1754         then do:
     1755           run gbl/d-inpday.w
     1756             (input ?
     1757             ,input "Выбор даты"
     1758             ,input p-description
     1759             ,input ""
     1760             ,input-output v-curr-sv-date
     1761             ,output v-ok
     1762             ).
     1763           if v-ok = true
     1764           then do:
     1765             assign
     1766               p-date-handle :screen-value = string(v-curr-sv-date) .
     1767             .
     1768           end.
     1769         end.
     1770       end.
     1771     end.
     1772   end procedure.
     1773   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1774   procedure lineattr-value :
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1779       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1780       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1781       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1782       define output parameter p-type     as character no-undo .
     1783       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1784       def var v-format         as character no-undo .
     1785       def var v-fillin_width   as integer   no-undo .
     1786       def var v-fillin_height  as integer   no-undo .
     1787       def var v-label          as character no-undo .
     1788       def var v-user-can-edit  as logical   no-undo .
     1789       def var v-output-display as logical   no-undo .
     1790       def var v-other          as character no-undo .
     1791       run lineattr-code in this-procedure
     1792         (input  p-code
     1793         ,output p-type
     1794         ,output v-format
     1795         ,output v-fillin_width
     1796         ,output v-fillin_height
     1797         ,output v-label
     1798         ,output v-user-can-edit
     1799         ,output v-output-display
     1800         ,output v-other
     1801         ) no-error .
     1802       if error-status :error then do:
     1803         undo, return error return-value .
     1804       end.
     1805       find first buf_doc-line-attr no-lock
     1806         where buf_doc-line-attr.doc-code  = p-doc-code
     1807           and buf_doc-line-attr.gds-code  = p-gds-code
     1808           and buf_doc-line-attr.attr-code = p-code
     1809         no-error .
     1810       if avail buf_doc-line-attr then do:
     1811         assign
     1812           p-value =  buf_doc-line-attr.attr-value
     1813         .
     1814       end.
     1815       else do:
     1816         assign
     1817           p-value = if p-type = 'L':U then "no":U else ""
     1818         .
     1819       end.
     1820     end.
     1821   end procedure.
     1822   procedure lineattr-write :
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1827       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1828       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1829       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1830       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1831       def var v-type           as character no-undo .
     1832       def var v-format         as character no-undo .
     1833       def var v-fillin_width   as integer   no-undo .
     1834       def var v-fillin_height  as integer   no-undo .
     1835       def var v-label          as character no-undo .
     1836       def var v-user-can-edit  as logical   no-undo .
     1837       def var v-output-display as logical   no-undo .
     1838       def var v-other          as character no-undo .
     1839       run lineattr-code in this-procedure
     1840         (input  p-code
     1841         ,output v-type
     1842         ,output v-format
     1843         ,output v-fillin_width
     1844         ,output v-fillin_height
     1845         ,output v-label
     1846         ,output v-user-can-edit
     1847         ,output v-output-display
     1848         ,output v-other
     1849         ) no-error .
     1850       if error-status :error then do:
     1851         undo, return error return-value .
     1852       end.
     1853       find first buf_doc-line-attr exclusive-lock
     1854         where buf_doc-line-attr.doc-code  = p-doc-code
     1855           and buf_doc-line-attr.gds-code  = p-gds-code
     1856           and buf_doc-line-attr.attr-code = p-code
     1857         no-error .
     1858       if not available buf_doc-line-attr then do:
     1859         create buf_doc-line-attr .
     1860         assign
     1861           buf_doc-line-attr.doc-code  = p-doc-code
     1862           buf_doc-line-attr.gds-code = p-gds-code
     1863           buf_doc-line-attr.attr-code = p-code
     1864         .
     1865       end.
     1866       assign
     1867         buf_doc-line-attr.attr-value = p-value
     1868       .
     1869        release buf_doc-line-attr.
     1870     end.
     1871   end procedure.
     1872   procedure lineattr-exist :
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1877       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1878       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1879       define output parameter p-exist   as logical  no-undo .
     1880       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1881       def var v-type           as character no-undo .
     1882       def var v-format         as character no-undo .
     1883       def var v-fillin_width   as integer   no-undo .
     1884       def var v-fillin_height  as integer   no-undo .
     1885       def var v-label          as character no-undo .
     1886       def var v-user-can-edit  as logical   no-undo .
     1887       def var v-output-display as logical   no-undo .
     1888       def var v-other          as character no-undo .
     1889       run lineattr-code in this-procedure
     1890         (input  p-code
     1891         ,output v-type
     1892         ,output v-format
     1893         ,output v-fillin_width
     1894         ,output v-fillin_height
     1895         ,output v-label
     1896         ,output v-user-can-edit
     1897         ,output v-output-display
     1898         ,output v-other
     1899         ) no-error .
     1900       if error-status :error then do:
     1901         undo, return error return-value .
     1902       end.
     1903       find first buf_doc-line-attr no-lock
     1904         where buf_doc-line-attr.doc-code  = p-doc-code
     1905           and buf_doc-line-attr.gds-code = p-gds-code
     1906           and buf_doc-line-attr.attr-code = p-code
     1907         no-error .
     1908       if  available buf_doc-line-attr then do:
     1909         p-exist = yes.
     1910       end.
     1911     end.
     1912   end procedure.
     1913   procedure lineattr-delete :
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1918       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1919       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1920       define output parameter p-deleted  as logical no-undo.
     1921       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1922       def var v-type           as character no-undo .
     1923       def var v-format         as character no-undo .
     1924       def var v-fillin_width   as integer   no-undo .
     1925       def var v-fillin_height  as integer   no-undo .
     1926       def var v-label          as character no-undo .
     1927       def var v-user-can-edit  as logical   no-undo .
     1928       def var v-output-display as logical   no-undo .
     1929       def var v-other          as character no-undo .
     1930       run lineattr-code in this-procedure
     1931         (input  p-code
     1932         ,output v-type
     1933         ,output v-format
     1934         ,output v-fillin_width
     1935         ,output v-fillin_height
     1936         ,output v-label
     1937         ,output v-user-can-edit
     1938         ,output v-output-display
     1939         ,output v-other
     1940         ) no-error .
     1941       if error-status :error then do:
     1942         undo, return error return-value .
     1943       end.
     1944       find first buf_doc-line-attr exclusive-lock
     1945         where buf_doc-line-attr.doc-code  = p-doc-code
     1946           and buf_doc-line-attr.gds-code  = p-gds-code
     1947           and buf_doc-line-attr.attr-code = p-code
     1948         no-error NO-WAIT.
     1949       if not available buf_doc-line-attr then do:
     1950         p-deleted = no.
     1951       end.
     1952       else do:
     1953         delete buf_doc-line-attr.
     1954         p-deleted = yes.
     1955       end.
     1956     end.
     1957   end procedure.
     1958   procedure lineattr-code :
     1959     do on error undo, return error return-value
     1960     :
     1961       define input  parameter p-code           as character no-undo .
     1962       define output parameter p-type           as character no-undo .
     1963       define output parameter p-format         as character no-undo .
     1964       define output parameter p-fillin_width   as integer   no-undo .
     1965       define output parameter p-fillin_height  as integer   no-undo .
     1966       define output parameter p-label          as character no-undo .
     1967       define output parameter p-user-can-edit  as logical   no-undo .
     1968       define output parameter p-output-display as logical   no-undo .
     1969       define output parameter p-other          as character no-undo .
     1970       case p-code :
     1971               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1972               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1973               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1974               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1975               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1976               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1977               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1978               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1979               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1980               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1981               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1982         otherwise do:
     1983           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     1984         end.
     1985       end.
     1986     end.
     1987   end procedure.
     1988   procedure lineattr-value-flora-gds :
     1989     do
     1990     on error undo, return error return-value
     1991     :
     1992       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1993       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1994       define input  parameter p-prt-code    as integer   no-undo .
     1995       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     1996       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     1997       define output parameter p-value       as    decimal   no-undo .
     1998       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1999       find first buf_doc-line-attr no-lock
     2000         where buf_doc-line-attr.doc-code  = p-doc-code
     2001           and buf_doc-line-attr.gds-code  = p-gds-code
     2002           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2003         no-error .
     2004       if avail buf_doc-line-attr then do:
     2005         assign
     2006           p-value = decimal( buf_doc-line-attr.attr-value)
     2007         .
     2008       end.
     2009       else do:
     2010         assign
     2011           p-value = 0
     2012         .
     2013       end.
     2014     end.
     2015   end procedure.
     2016   procedure lineattr-write-flora-gds :
     2017     do
     2018     on error undo, return error return-value
     2019     :
     2020       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2021       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2022       define input parameter p-prt-code    as integer   no-undo .
