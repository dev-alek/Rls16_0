    14766                  and tt-fr-doc-line.doc-qnty <> 0.0
    14767                  and tt-fr-doc-line.doc-density :sensitive in frame d-in-line
    14768                  and ( tt-fr-doc-line.doc-density = 0.0
    14769                        or tt-fr-doc-line.doc-density = ?
    14770                      )
    14771                then do:
    14772                  wait-for go of frame d-in-line focus tt-fr-doc-line.doc-density.
