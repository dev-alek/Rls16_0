    19017                       if available buf_c-pl-gds-pump
    19018                       then do :
    19019                         find first buf2_c-pl-gds-pump no-lock where buf2_c-pl-gds-pump.obj-type = buf_c-pl-gds-pump.obj-type
    19020                                                                 and buf2_c-pl-gds-pump.obj-code = buf_c-pl-gds-pump.obj-code
    19021                                                                 and buf2_c-pl-gds-pump.pl-code  = buf_c-pl-gds-pump.pl-code
    19022                                                                 and buf2_c-pl-gds-pump.gds-code = buf_c-pl-gds-pump.gds-code
    19023                                                                 and buf2_c-pl-gds-pump.pump-code = buf_c-pl-gds-pump.pump-code
    19024                                                                 and buf2_c-pl-gds-pump.chip-num > buf_c-pl-gds-pump.chip-num
    19025                                                                 no-error .
