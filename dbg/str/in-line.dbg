    12208     define buffer bf_rvs-doc     for ub.rvs-doc .
    12209     define buffer bf_rvs-line    for ub.rvs-line .
    12210     define variable v-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
    12211     define variable v-new-density          like ub.doc-line.fact-density no-undo .
    12212     define variable v-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
    12213     define variable ii as integer no-undo .
    12214     define variable choice as integer no-undo .
    12215     define variable v-kpsecs as character no-undo .
    12216     define variable v-kpsecs-nomeas as character no-undo .
    12217     define variable vAccMethChoosed as logical no-undo .
    12218     define variable v-need-measure as logical no-undo init no .
    12219     assign
    12220       v-new-fact-qnty     = tt-fr-doc-line.fact-qnty
    12221       v-new-density       = tt-fr-doc-line.fact-density
    12222       v-new-cli-fact-qnty = tt-fr-doc-line.fact-qnty-kg
    12223     .
    12224     infoSectionsTotal:DocQntyLine = tt-fr-doc-line.doc-qnty.
    12225     infoSectionsTotal:DocDensLine = tt-fr-doc-line.doc-density.
    12226     infoSectionsTotal:DocCliLine = tt-fr-doc-line.cli-qnty.
    12227     infoSectionsTotal:FlagTrn = t-doc.flag_.
    12228     if infoSectionsTotal:IsKP
    12229     and parline-mode <> 'ПРОСМОТР':U
    12230     then do :
    12231       vAccMethChoosed = yes .
    12232       do ii = 1 to infoSectionsTotal:SectionNum :
    12233         infoSecObj = infoSectionsTotal:GetInfoSectionProp(ii) .
    12234         if infoSecObj:IsKP
    12235         then do :
    12236           if infoSecObj:AccMeth = ?
    12237           then do :
    12238             vAccMethChoosed = no .
    12239           end .
    12240           assign v-kpsecs = v-kpsecs + infoSecObj:SectionName + " с " + buf_goods.gds-name + ", " .
    12241         end .
    12242         if infoSecObj:KPnoMeas
    12243         then do :
    12244           assign v-kpsecs-nomeas = v-kpsecs-nomeas + infoSecObj:SectionName + " с " + buf_goods.gds-name + ", " .
    12245         end .
    12246         if infoSectionsTotal:IsSGDKK
    12247         then do :
    12248           v-need-measure = no .
    12249         end .
    12250         else do :
    12251           if not infoSecObj:KPnoMeas
    12252           and (not (infoSecObj:TankWeight > 0)
    12253           or infoSecObj:TankWeight = ?
    12254           or infoSecObj:TankDensity = ?)
    12255           then do :
    12256             v-need-measure = yes .
    12257           end .
    12258         end .
    12259       end .
    12260       assign
    12261         v-kpsecs = trim(v-kpsecs, ", ")
    12262         v-kpsecs-nomeas = trim(v-kpsecs-nomeas, ", ")
    12263       .
    12264       if not vAccMethChoosed
    12265       and infoSectionsTotal:IsActnComm
    12266       then do :
    12267         if v-kpsecs > ""
    12268         then do :
    12269           run gbl/d-askw.w (
    12270              input "Выбор способа выполнения комиссионного приёма"
    12271             ,input ("Для секций " + v-kpsecs + " требуется комиссионный прием. Каким способом будет выполняться комиссионный прием?")
    12272             ,input "|^"
    12273             ,input "Замеры в АЦ" + (if v-kpsecs-nomeas > "" then "^disable" else "") + "|По сверкам|Отмена"
    12274             ,input "Выполнение комиссионного приёма стандартным способом по замерам в автоцистерне|Выполнение комиссионного приёма по данным сверок в резервуаре|Отказ от выбора способа"
    12275             ,input 1
    12276             ,input 3
    12277             ,output choice).
    12278           case choice :
    12279             when 1
    12280             then do :
    12281               kpsecs_ :
    12282               do ii = 1 to infoSectionsTotal:SectionNum :
    12283                 infoSecObj = infoSectionsTotal:GetInfoSectionProp(ii) .
    12284                 if infoSecObj:isKP
    12285                 then do :
    12286                   infoSecObj:AccMeth = 0 .
    12287                 end .
    12288               end .
    12289             end .
    12290             when 2
    12291             then do :
    12292               kpsecs_ :
    12293               do ii = 1 to infoSectionsTotal:SectionNum :
    12294                 infoSecObj = infoSectionsTotal:GetInfoSectionProp(ii) .
    12295                 if infoSecObj:isKP
    12296                 then do :
    12297                   infoSecObj:AccMeth = 1 .
    12298                   infoSectionsTotal:IsKPrvs = yes .
    12299                 end .
    12300               end .
    12301             end .
    12302             when 3
    12303             then do :
    12304               return no-apply .
    12305             end .
    12306           end case .
    12307         end .
    12308         infoSectionsTotal:SaveDB() .
    12309         find first buf_rvs-doc no-lock where buf_rvs-doc.out-code = t-doc.doc-code no-error.
    12310         if not available buf_rvs-doc
    12311         and not v-need-measure
    12312         then do :
    12313           run cr-rvs-doc in this-procedure:instantiating-procedure
    12314             ( input parparentproc
    12315              ,input t-doc.doc-code
    12316             ) no-error .
    12317           if error-status :error then do:
    12318             message
    12319               vss-workfile vss-revision vss-description skip
    12320               substitute("Ошибка при создании документов сверок.") skip
    12321               error-status :get-message(1) skip
    12322               return-value skip
    12323               view-as alert-box error .
    12324           end.
    12325         end .
    12326       end .
    12327     end .
    12328     run proc-b-addinfo in this-procedure
    12329       ( input        parparentproc
    12330        ,input        ( if parline-mode <> 'ПРОСМОТР':U then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U )
    12331        ,input        tt-fr-doc-line.doc-code
    12332        ,input        buf_goods.gds-code
    12333        ,input        stfactplvalue
    12334        ,input        varauto-tank
    12335        ,input        varupd-fact-qnty
    12336        ,input        tt-fr-doc-line.doc-qnty
    12337        ,input        tt-fr-doc-line.doc-density
    12338        ,input-output v-new-fact-qnty
    12339        ,input-output v-new-density
    12340        ,input-output v-new-cli-fact-qnty
    12341        ,input-output infoSectionsTotal
    12342        ,input-output v-prt-start-real-date
    12343        ,input-output v-prt-start-real-time
    12344        ,input-output v-prt-end-real-date
    12345        ,input-output v-prt-end-real-time
    12346       ) no-error .
    12347     if error-status :error then do:
    12348       message
    12349         substitute("Ошибка при изменении дополнительной информации.") skip
    12350         error-status :get-message(1) skip
    12351         return-value skip
    12352         view-as alert-box error .
    12353       return no-apply .
    12354     end.
    12355     if tt-fr-doc-line.fact-qnty <> v-new-fact-qnty
    12356       or tt-fr-doc-line.fact-qnty-kg <> v-new-cli-fact-qnty
    12357     then do:
