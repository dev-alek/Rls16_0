     2100           and buf_doc-line-attr.gds-code  = p-gds-code
     2101           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2102         no-error .
     2103       if avail buf_doc-line-attr then do:
