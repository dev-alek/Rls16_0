    14682             return error.
    14683          end.
    14684        end.
    14685      end.
    14686      assign frame d-in-line:title = "Строка накладной № " + t-doc.doc-code + "    - " + parline-mode.
    14687     if t-doc.contract-code > 0 and not is-petrolium then do :
    14688       find first buf_contract-specif no-lock
    14689            where buf_contract-specif.host-code    = t-doc.host-code
    14690              and buf_contract-specif.contract-num = t-doc.contract-code
    14691              and buf_contract-specif.gds-code     = buf_goods.gds-code no-error .
    14692       if available buf_contract-specif then assign
