     3828   procedure placelib_write-attr:
     3829   define input  parameter p-code     like ub.place-attr.attr-code .
     3830   define input  parameter p-obj-code like ub.place-attr.obj-code .
     3831   define input  parameter p-obj-type like ub.place-attr.obj-type .
     3832   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     3833   define input  parameter p-value    like ub.place-attr.attr-value .
     3834   define output parameter p-ok       as logical.
     3835   define buffer buf_place-attr for ub.place-attr .
     3836     do on error undo, return error return-value :
     3837        p-ok = false.
     3838        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     3839                                                   and buf_place-attr.obj-code    = p-obj-code
     3840                                                   and buf_place-attr.obj-type    = p-obj-type
     3841                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     3842        if not available buf_place-attr then do :
     3843           create buf_place-attr.
     3844           assign
     3845             buf_place-attr.attr-code   = p-code
     3846             buf_place-attr.attr-value  = p-value
     3847             buf_place-attr.obj-code    = p-obj-code
     3848             buf_place-attr.obj-type    = p-obj-type
     3849             buf_place-attr.pl-code     = p-pl-code
     3850           .
     3851           p-ok = true.
     3852        end.
     3853        else do:
     3854           buf_place-attr.attr-value  = p-value .
     3855           p-ok = true.
     3856        end.
     3857     end.
     3858   end.
     3859   procedure placelib_get-attr:
     3860   define input  parameter  p-code     like ub.place-attr.attr-code .
     3861   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     3862   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     3863   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     3864   define output parameter  p-value    like ub.place-attr.attr-value .
     3865   define output parameter  p-ok       as logical.
     3866   define buffer buf_place-attr for ub.place-attr .
     3867     do on error undo, return error return-value :
     3868        p-ok = false.
     3869        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     3870                                                   and buf_place-attr.obj-code    = p-obj-code
     3871                                                   and buf_place-attr.obj-type    = p-obj-type
     3872                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     3873        if available buf_place-attr then do :
     3874          p-value = buf_place-attr.attr-value.
     3875          p-ok = true.
     3876        end.
     3877        else do :
     3878          p-ok = false.
     3879        end.
     3880     end.
     3881   end.
     3882   procedure placelib_del-attr:
     3883   define input parameter  p-code     like ub.place-attr.attr-code .
     3884   define input parameter  p-obj-code like ub.place-attr.obj-code .
     3885   define input parameter  p-obj-type like ub.place-attr.obj-type .
     3886   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     3887   define input parameter  p-value    like ub.place-attr.attr-value .
     3888   define output parameter p-ok       as logical.
     3889   define buffer buf_place-attr for ub.place-attr .
     3890     do on error undo, return error return-value :
     3891        p-ok = false.
     3892        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     3893                                                   and buf_place-attr.obj-code    = p-obj-code
     3894                                                   and buf_place-attr.obj-type    = p-obj-type
     3895                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     3896        if available buf_place-attr then do :
     3897           delete buf_place-attr.
     3898           p-ok = true.
     3899        end.
     3900     end.
     3901   end.
