    10515         .
    10516         output stream outstream close.
    10517         if trim(vErr) > "" then do :
    10518           error-string = vErr .
    10519           output stream outstream to value ("pomi.log")  append.
    10520           put stream outstream error-string format "X(1024)" skip.
    10521           error-string = replace(error-string, ";", (";" + chr(10))) .
    10522           message
    10523           substitute('Ошибка работы библиотеки ПОкМИ. &1&2', chr(10), error-string)
    10524           view-as alert-box error.
    10525           output stream outstream close .
