    16845     assign
    16846       tt-fr-doc-line.doc-code      = t-doc.doc-code
    16847       tt-fr-doc-line.obj-type      = t-doc.obj-type
    16848       tt-fr-doc-line.obj-code      = t-doc.obj-code
    16849       tt-fr-doc-line.artic         = buf_goods.artic
