     2227       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2228       define output parameter p-value       as    decimal   no-undo .
     2229       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2230       find first buf_doc-line-attr no-lock
     2231         where buf_doc-line-attr.doc-code  = p-doc-code
     2232           and buf_doc-line-attr.gds-code  = p-gds-code
     2233           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2234         no-error .
     2235       if avail buf_doc-line-attr then do:
     2236         assign
     2237           p-value = decimal( buf_doc-line-attr.attr-value)
     2238         .
     2239       end.
     2240       else do:
     2241         assign
     2242           p-value = 0
     2243         .
     2244       end.
     2245     end.
     2246   end procedure.
     2247   procedure lineattr-write-parts :
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2252       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2253       define input parameter p-part-code  as character no-undo .
     2254       define input parameter p_in-code    as character no-undo .
     2255       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     2256       define input parameter p-value      as decimal   no-undo .
     2257       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2258       find first buf_doc-line-attr exclusive-lock
     2259         where buf_doc-line-attr.doc-code  = p-doc-code
     2260           and buf_doc-line-attr.gds-code  = p-gds-code
     2261           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2262         no-error .
     2263       if not available buf_doc-line-attr then do:
     2264         create buf_doc-line-attr .
     2265         assign
     2266           buf_doc-line-attr.doc-code  = p-doc-code
     2267           buf_doc-line-attr.gds-code  = p-gds-code
     2268           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2269         .
     2270       end.
     2271       assign
     2272         buf_doc-line-attr.attr-value = string( p-value )
     2273       .
     2274     end.
     2275   end procedure.
