    16856       tt-fr-doc-line.prt-root      = buf_goods.prt-root
    16857       tt-fr-doc-line.type-inp-sum  = (if parinplnsum = yes then yes else no)
    16858     .
    16859     if parmode = "create" then do:
    16860       assign
    16861         tt-fr-doc-line.unit-cli      = (if v-specif-unit-list > "" then v-specif-unit-list     else buf_goods.unit-cli)
    16862         tt-fr-doc-line.cli-base-rate = (if v-specif-unit-list > "" then (v-specif-cli-base-rate) else buf_goods.cli-base-rate)
    16863         tt-fr-doc-line.doc-density   = ?
    16864         tt-fr-doc-line.fact-density  = ?
    16865         tt-fr-doc-line.temperature   = ?
    16866       .
    16867       if is-petrolium = true
    16868         and is-pieces = false
    16869       then do:
    16870         assign
    16871           tt-fr-doc-line.cli-base-rate = 1 / tt-fr-doc-line.doc-density
    16872         .
    16873         if ptrlprop-olddens = true
    16874           and vardensity-input = true
    16875         then do:
    16876           find last prev_doc-line
    16877             where prev_doc-line.obj-type     = t-doc.obj-type
    16878               and prev_doc-line.obj-code     = t-doc.obj-code
    16879               and prev_doc-line.prod-type    = buf_goods.prod-type
    16880               and prev_doc-line.prod-code    = buf_goods.prod-code
    16881               and prev_doc-line.artic        = buf_goods.artic
    16882               and prev_doc-line.ext-doc-type = t-doc.ext-doc-type
    16883               and prev_doc-line.status_      = 'факт':U
    16884             no-lock
    16885           use-index dt-fo no-error.
    16886           if available prev_doc-line then do:
    16887             assign
    16888               tt-fr-doc-line.doc-density   = prev_doc-line.fact-density
    16889               tt-fr-doc-line.cli-base-rate = 1 / tt-fr-doc-line.doc-density
    16890               tt-fr-doc-line.fact-density  = tt-fr-doc-line.doc-density
    16891               tt-fr-doc-line.temperature   = prev_doc-line.temperature
    16892             .
    16893             display
    16894               tt-fr-doc-line.doc-density
    16895               tt-fr-doc-line.temperature
    16896               with frame d-in-line.
    16897           end.
    16898         end.
    16899       end.
    16900     end.
    16901     else do:
    16902       assign
    16903         tt-fr-doc-line.cli-base-rate = bf-doc-line.cli-base-rate
    16904         tt-fr-doc-line.unit-cli      = bf-doc-line.unit-cli
    16905       .
    16906     end.
    16907     assign
    16908       tt-fr-doc-line.vat-pc = (if t-doc.vat-type = 'без':U then 0 else (if parmode = "create" then v-clcdoc-vat-pc else bf-doc-line.vat-pc))
    16909       tt-fr-doc-line.slt-pc = (if t-doc.slt-type = 'без':U then 0 else (if parmode = "create" then v-clcdoc-slt-pc else bf-doc-line.slt-pc))
    16910     .
    16911     .
    16912      if parmode = "create" then do:
    16913   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16914   run find-new-price-sale in this-procedure (
    16915      input  pr-genmrg
    16916     ,input  pr-naklvalue
    16917     ,input  t-doc.doc-code
    16918     ,input  buf_goods.artic
    16919     ,input  buf_goods.prod-type
    16920     ,input  buf_goods.prod-code
    16921     ,input  tt-fr-doc-line.price-rubl
    16922     ,input  tt-fr-doc-line.price-base
    16923     ,input  tt-fr-doc-line.price-rubl
    16924     ,input  tt-fr-doc-line.price-base
    16925     ,input-output tt-fr-doc-line.new-price-sale
    16926       )
    16927       no-error .
    16928         if error-status :error then
    16929         message
    16930           error-status :get-message(1) skip
    16931           return-value skip
    16932           "Нельзя рассчитать новую цену продажи(2)"
    16933           view-as alert-box error
    16934         .
    16935      end.
    16936      else do:
    16937       assign
    16938         tt-fr-doc-line.new-price-sale = bf-doc-line.new-price-sale
    16939       .
    16940      end.
    16941   define variable v-type as character no-undo .
    16942     run lineattr-value in this-procedure (
    16943         input   t-doc.doc-code  ,
    16944         input   buf_goods.gds-code  ,
    16945         input   'price-prod':U ,
    16946         output  tt-fr-doc-line.price-prod ,
    16947         output  v-type       )
    16948         no-error .
    16949     run lineattr-value in this-procedure (
    16950         input   t-doc.doc-code  ,
    16951         input   buf_goods.gds-code  ,
    16952         input   'price-prodvat':U ,
    16953         output  tt-fr-doc-line.price-prod-vat ,
    16954         output  v-type       )
    16955         no-error .
    16956     v-alcohol-prod = no.
    16957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    16958     (input  'alcohol':u
    16959     ,input  0
    16960     ,input  ''
    16961     ,input  0
    16962     ,input  ''
    16963     ,input  ''
    16964     ,input  ''
    16965     ,input  no
    16966     ,output v-alcohol-value
    16967     ,output v-alcohol-type
    16968     ) no-error .
    16969     if lookup(v-alcohol-value, 'true,yes':u) > 0 then do:
    16970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
    16971     (input  buf_goods.gds-code
    16972     ,input  'alcohol-prod=request':u
    16973     ,output v-alcohol-prod
    16974     )  .
    16975     end.
    16976     assign
    16977       tt-fr-doc-line.alc-prod = v-alcohol-prod
    16978       varalc-prod             = string (v-alcohol-prod,
    16979                                         substring("Алкоголь", 1, 1) + "/")
    16980     .
    16981     release buf_goods.
    16982     find first buf_goods no-lock
    16983       where recid(buf_goods) = pargds-rec
    16984     .
    16985     release ub.units.
    16986     find ub.clients where ub.clients.obj-type = tt-fr-doc-line.prod-type
    16987                       and ub.clients.obj-code = tt-fr-doc-line.prod-code no-lock.
    16988     assign tt-fr-doc-line.obj-name = ub.clients.obj-name.
    16989     release ub.clients.
    16990     find first  ub.ext-artic where  ub.ext-artic.cli-type   = t-doc.cli-type
    16991                           and  ub.ext-artic.cli-code   = t-doc.cli-code
    16992                           and  ub.ext-artic.gds-code   = buf_goods.gds-code
    16993                           and  ub.ext-artic.status_    <> 'удал':U
    16994                           no-lock no-error.
    16995     assign tt-fr-doc-line.cli-art = (if available  ub.ext-artic then  ub.ext-artic.ext-artic else ?).
    16996     if available  ub.ext-artic then release  ub.ext-artic.
    16997     find first ub.currency where ub.currency.curr-code = t-doc.exch-code no-lock.
    16998     assign tt-fr-doc-line.curr-abbr = ub.currency.curr-abbr.
    16999     release ub.currency.
    17000     if parmode <> "create" then release bf-doc-line.
    17001     if parmode = "create" then do:
    17002       assign
    17003         tt-fr-doc-line.type-inp-vat = yes
    17004       .
    17005     end.
    17006     else do:
    17007       find first type-inp-vat-attr no-lock
    17008         where type-inp-vat-attr.doc-code   = t-doc.doc-code
    17009           and type-inp-vat-attr.gds-code   = buf_goods.gds-code
    17010           and type-inp-vat-attr.attr-code  = "type-inp-vat"
    17011         no-error.
    17012       if available type-inp-vat-attr then do:
    17013         assign
    17014           tt-fr-doc-line.type-inp-vat = (if type-inp-vat-attr.attr-value = "yes" then yes else no)
    17015         .
    17016       end.
    17017       else do:
    17018         assign
    17019           tt-fr-doc-line.type-inp-vat = yes
    17020         .
    17021       end.
    17022     end.
    17023     display
    17024       tt-fr-doc-line.artic
    17025       tt-fr-doc-line.prod-type
    17026       tt-fr-doc-line.prod-code
    17027       tt-fr-doc-line.gds-name
    17028       v-goods-ms-base
    17029       tt-fr-doc-line.obj-name
    17030       tt-fr-doc-line.unit-base
    17031       tt-fr-doc-line.unit-cli
    17032       tt-fr-doc-line.cli-art
    17033       tt-fr-doc-line.curr-abbr
    17034       tt-fr-doc-line.unit-cli
    17035       tt-fr-doc-line.cli-base-rate
    17036       tt-fr-doc-line.vat-pc
    17037       tt-fr-doc-line.slt-pc
    17038       varalc-prod
    17039       with frame d-in-line.
    17040    if v-cntxp-inout-price = true
    17041      and v-insalepr = false
    17042      and vat-sumvalue = "yes"
    17043    then do:
    17044      display
    17045        tt-fr-doc-line.type-inp-vat
    17046        with frame d-in-line.
    17047    end.
    17048   end procedure.
    17049   procedure proc-quit:
    17050     define buffer bf_doc-pl for ub.doc-pl.
    17051     define buffer tmp_doc-line-attr for ub.doc-line-attr .
    17052     do transaction
    17053     on error undo, return error
    17054     :
    17055       find first ub.doc-line
    17056         where recid( ub.doc-line ) = line-rec
    17057         no-error .
    17058       if available ub.doc-line
    17059         and ( ub.doc-line.cli-qnty = 0
    17060               or ub.doc-line.cli-qnty = ?
    17061             )
    17062       then do:
    17063         run delete-doc-line in this-procedure no-error .
    17064         if error-status :error
    17065         then do:
    17066           undo, return error .
    17067         end.
    17068         message
    17069           "Строка имеет нулевое кол-во по ТТН и удаляется!!!"
    17070           view-as alert-box information .
    17071         assign
    17072           pardoc-rec = recid( t-doc )
    17073         .
    17074         delete ub.doc-line .
    17075         find first t-doc where
    17076             recid( t-doc ) = pardoc-rec .
    17077       end.
    17078       if parline-mode = "ЦИКЛ":U
    17079         or parline-mode = 'ДОБАВЛЕНИЕ':U
    17080       then do:
    17081         find first t-doc
    17082           where recid( t-doc ) = pardoc-rec
    17083         .
    17084         for each tt-doc-pl
    17085         :
    17086           for each bf_doc-pl
    17087             where bf_doc-pl.obj-type = t-doc.obj-type
    17088               and bf_doc-pl.obj-code = t-doc.obj-code
    17089               and bf_doc-pl.out-code = t-doc.doc-code
    17090               and bf_doc-pl.gds-code = buf_goods.gds-code
    17091           :
    17092             delete bf_doc-pl.
    17093           end.
    17094           delete tt-doc-pl.
    17095         end.
    17096       end.
    17097       if valid-object(infoSectionsTotal)
    17098       and infoSectionsTotal:PlChanged
    17099       then do :
    17100         for each tmp_doc-line-attr exclusive-lock where tmp_doc-line-attr.doc-code = t-doc.doc-code
    17101                                                     and tmp_doc-line-attr.gds-code = buf_goods.gds-code
    17102                                                     and tmp_doc-line-attr.attr-code begins "list-tank" :
    17103           delete tmp_doc-line-attr .
    17104         end .
    17105         for each tt-old-list-tank :
    17106           create tmp_doc-line-attr .
    17107           buffer-copy tt-old-list-tank to tmp_doc-line-attr .
    17108         end .
    17109         empty temp-table tt-old-list-tank .
    17110       end .
    17111     end.
    17112   end procedure.
    17113   procedure calc-all :
    17114     define input parameter parmode-on as character no-undo .
    17115     define variable varbase-rate-ca                like ub.trn-doc.base-rate    no-undo .
    17116     define variable varbase-scale-ca               like ub.trn-doc.base-scale   no-undo .
    17117     define variable varexch-rate-ca                like ub.trn-doc.exch-rate    no-undo .
    17118     define variable varexch-scale-ca               like ub.trn-doc.exch-scale   no-undo .
    17119     define variable varvat-type-ca                 like ub.parts.vat-type       no-undo .
    17120     define variable varslt-type-ca                 like ub.parts.slt-type       no-undo .
    17121     define variable varartic-ca                    like ub.parts.artic          no-undo .
    17122     define variable varprod-type-ca                like ub.parts.prod-type      no-undo .
    17123     define variable varprod-code-ca                like ub.parts.prod-code      no-undo .
    17124     define variable varpr-cli-ca                   like ub.parts.price-cli      no-undo .
    17125     define variable varcli-base-rate-ca            like ub.parts.cli-base-rate  no-undo .
    17126     define variable varpr-rubl-ca                  like ub.parts.price-rubl     no-undo .
    17127     define variable varvat-pc-ca                   like ub.parts.slt-pc         no-undo .
    17128     define variable varslt-pc-ca                   like ub.parts.slt-pc         no-undo .
    17129     define variable varroad-tax-ca                 like ub.parts.road-tax-rubl  no-undo .
    17130     define variable vartransport-rubl-ca           like ub.parts.transport-rubl no-undo .
    17131     define variable varother-rubl-ca               like ub.parts.other-rubl     no-undo .
    17132     define variable varprice-cli-ca                like ub.doc-line.price-rubl  no-undo .
    17133     define variable varprice-cli-unit-base-ca      like ub.doc-line.price-rubl  no-undo .
    17134     define variable varprice-road-tax-ca           like ub.doc-line.price-rubl  no-undo .
    17135     define variable varprice-other-exp-ca          like ub.doc-line.price-rubl  no-undo .
    17136     define variable varprice-transport-exp-ca      like ub.doc-line.price-rubl  no-undo .
    17137     define variable varprice-without-abs-ca        like ub.doc-line.price-rubl  no-undo .
    17138     define variable varprice-slt-ca                like ub.doc-line.price-rubl  no-undo .
    17139     define variable varprice-no-slt-ca             like ub.doc-line.price-rubl  no-undo .
    17140     define variable varprice-vat-ca                like ub.doc-line.price-rubl  no-undo .
    17141     define variable varprice-no-vat-slt-ca         like ub.doc-line.price-rubl  no-undo .
    17142     define variable varprice-rubl-ca               like ub.doc-line.price-rubl  no-undo .
    17143     define variable varprice-road-tax-rubl-ca      like ub.doc-line.price-rubl  no-undo .
    17144     define variable varprice-other-exp-rubl-ca     like ub.doc-line.price-rubl  no-undo .
    17145     define variable varprice-transport-exp-rubl-ca like ub.doc-line.price-rubl  no-undo .
    17146     define variable varprice-without-abs-rubl-ca   like ub.doc-line.price-rubl  no-undo .
    17147     define variable varprice-slt-rubl-ca           like ub.doc-line.price-rubl  no-undo .
    17148     define variable varprice-no-slt-rubl-ca        like ub.doc-line.price-rubl  no-undo .
    17149     define variable varprice-vat-rubl-ca           like ub.doc-line.price-rubl  no-undo .
    17150     define variable varprice-no-vat-slt-rubl-ca    like ub.doc-line.price-rubl  no-undo .
    17151     define variable varprice-base-ca               like ub.doc-line.price-base  no-undo .
    17152     define variable varprice-road-tax-base-ca      like ub.doc-line.price-base  no-undo .
    17153     define variable varprice-other-exp-base-ca     like ub.doc-line.price-base  no-undo .
    17154     define variable varprice-transport-exp-base-ca like ub.doc-line.price-base  no-undo .
    17155     define variable varprice-without-abs-base-ca   like ub.doc-line.price-base  no-undo .
    17156     define variable varprice-slt-base-ca           like ub.doc-line.price-base  no-undo .
    17157     define variable varprice-no-slt-base-ca        like ub.doc-line.price-base  no-undo .
    17158     define variable varprice-vat-base-ca           like ub.doc-line.price-base  no-undo .
    17159     define variable varprice-no-vat-slt-base-ca    like ub.doc-line.price-base  no-undo .
    17160     define variable varcli-base-rate like ub.doc-line.cli-base-rate no-undo .
    17161     define variable vardensity       like ub.doc-line.doc-density   no-undo .
    17162     define variable varcli-qnty      like ub.doc-line.cli-qnty      no-undo .
    17163     define variable vardoc-qnty      like ub.doc-line.doc-qnty      no-undo .
    17164     define variable varroad-tax      like ub.doc-line.road-tax      no-undo .
    17165     define variable varmode-on       as   character                 no-undo .
    17166     define variable vari             as   integer                   no-undo .
    17167     do vari = 1 to num-entries( parmode-on ) :
    17168       assign
    17169         varmode-on = entry( vari, parmode-on )
    17170       .
    17171       if varmode-on <> "doc-qnty":u      and
    17172          varmode-on <> "acc-price":u     and
    17173          varmode-on <> "density":u       and
    17174          varmode-on <> "cli-base-rate":u and
    17175          varmode-on <> "cli-price":u     and
    17176          varmode-on <> "road-tax":u      and
    17177          varmode-on <> "cli-qnty":u
    17178       then do:
    17179         message "Неверный параметр пересчета для процедуры calc-all: "
    17180                 parmode-on " ."
    17181         view-as alert-box error .
    17182         return error .
    17183       end.
    17184     end.
    17185     if lookup( "cli-qnty", parmode-on ) > 0
    17186     then do:
    17187   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_clccliqt in g#lib-calc
    17188     (
    17189      input   varext-gds-type
    17190     ,input   tt-fr-doc-line.doc-qnty
    17191     ,input   tt-fr-doc-line.cli-base-rate
    17192     ,input   tt-fr-doc-line.doc-density
    17193     ,input   varround
    17194     ,output  varcli-qnty
    17195     ) no-error.
    17196       if error-status :error
    17197       then do:
    17198         message "Ошибка при пересчете клиентского количества." skip( 0 )
    17199                 return-value                                   skip( 0 )
    17200                 error-status :get-message( 1 )                 skip( 0 )
    17201                 error-status :get-message( 2 )
    17202         view-as alert-box error .
    17203         return error .
    17204       end.
    17205       assign
    17206         tt-fr-doc-line.cli-qnty = varcli-qnty
    17207       .
    17208       display tt-fr-doc-line.cli-qnty with frame d-in-line .
    17209     end.
    17210     if lookup( "density", parmode-on ) > 0
    17211     then do:
    17212       if tt-fr-doc-line.cli-qnty <> ?
    17213         and tt-fr-doc-line.doc-qnty <> ?
    17214       then do:
    17215   define variable vss-include-info89 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
    17216   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_clcdens in g#lib-calc
    17217     (
    17218      input   varext-gds-type
    17219     ,input   tt-fr-doc-line.cli-qnty
    17220     ,input   tt-fr-doc-line.doc-qnty
    17221     ,output  vardensity
    17222     ) no-error.
    17223         if error-status :error
    17224         then do:
    17225           message "Ошибка при пересчете плотности." skip( 0 )
    17226                   return-value                                   skip( 0 )
    17227                   error-status :get-message( 1 )                 skip( 0 )
    17228                   error-status :get-message( 2 )
    17229           view-as alert-box error .
    17230           return error .
    17231         end.
    17232         assign
    17233           tt-fr-doc-line.doc-density  = vardensity
    17234           tt-fr-doc-line.fact-density = tt-fr-doc-line.doc-density
    17235         .
    17236         display tt-fr-doc-line.doc-density with frame d-in-line .
    17237       end.
    17238     end.
    17239     if lookup( "doc-qnty", parmode-on ) > 0
    17240     then do:
    17241   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_clcdocqt in g#lib-calc
    17242     ( input  varext-gds-type
    17243      ,input  tt-fr-doc-line.cli-qnty
    17244      ,input  tt-fr-doc-line.cli-base-rate
    17245      ,input  tt-fr-doc-line.doc-density
    17246      ,output vardoc-qnty
    17247     ) no-error.
    17248       if error-status :error
    17249       then do:
    17250         message "Ошибка при пересчете количества в базовых единицах." skip( 0 )
    17251                 return-value                                          skip( 0 )
    17252                 error-status :get-message( 1 )                        skip( 0 )
    17253                 error-status :get-message( 2 )
    17254         view-as alert-box .
    17255         return error .
    17256       end.
    17257       assign
    17258         tt-fr-doc-line.doc-qnty = vardoc-qnty
    17259       .
    17260       display tt-fr-doc-line.doc-qnty with frame d-in-line .
    17261     end.
    17262     if lookup( "cli-base-rate", parmode-on ) > 0
    17263     then do:
    17264       if ( ( varext-gds-type = 'lp':U
    17265              or varext-gds-type = 'kp':U
    17266            )
    17267           and tt-fr-doc-line.doc-density <> ?
    17268          )
    17269         or ( varext-gds-type <> 'lp':U
    17270              and varext-gds-type <> 'kp':U
    17271            )
    17272       then do:
    17273   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_clcclirt in g#lib-calc
    17274     (
    17275      input  varext-gds-type
    17276     ,input  tt-fr-doc-line.cli-qnty
    17277     ,input  tt-fr-doc-line.doc-qnty
    17278     ,input  tt-fr-doc-line.doc-density
    17279     ,input  varround
    17280     ,output varcli-base-rate
    17281     ) no-error.
    17282         if error-status :error
    17283         then do:
    17284           message "Ошибка при расчете коэффициента поставщика." skip( 0 )
    17285                   return-value                                  skip( 0 )
    17286                   error-status :get-message( 1 )                skip( 0 )
    17287                   error-status :get-message( 2 )
    17288           view-as alert-box error .
    17289           return error .
    17290         end.
    17291         assign
    17292           tt-fr-doc-line.cli-base-rate = varcli-base-rate
    17293         .
    17294         if tt-fr-doc-line.doc-density = ?
    17295         then
    17296         display tt-fr-doc-line.cli-base-rate with frame d-in-line .
    17297       end.
    17298     end.
    17299     if lookup( "road-tax", parmode-on ) > 0
    17300     then do:
    17301   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_clcrdtax in g#lib-calc
    17302     (
    17303      input   buf_goods.gds-code
    17304     ,input   varext-gds-type
    17305     ,input   tt-fr-doc-line.cli-base-rate
    17306     ,input   tt-fr-doc-line.doc-qnty
    17307     ,input   tt-fr-doc-line.doc-density
    17308     ,input   road-tax-cli
    17309     ,input   t-doc.base-rate
    17310     ,input   t-doc.base-scale
    17311     ,input   t-doc.exch-rate
    17312     ,input   t-doc.exch-scale
    17313     ,output  varroad-tax
    17314     ) no-error .
    17315       if error-status :error
    17316       then do:
    17317         message "Ошибка при пересчете дорожного налога" skip( 0 )
    17318                 return-value                            skip( 0 )
    17319                 error-status :get-message( 1 )          skip( 0 )
    17320                 error-status :get-message( 2 )
    17321         view-as alert-box error .
    17322         return error .
    17323       end.
    17324       assign
    17325         tt-fr-doc-line.road-tax = varroad-tax
    17326       .
    17327       display tt-fr-doc-line.road-tax with frame d-in-line .
    17328     end.
    17329     if ( lookup( "cli-price", parmode-on ) > 0
    17330         or lookup( "acc-price", parmode-on ) > 0
    17331        )
    17332        and tt-fr-doc-line.cli-base-rate <> ?
    17333     then do:
    17334       if v-insalepr = true then do:
    17335         run calc-price-sale in this-procedure no-error .
    17336         if error-status :error
    17337         then do:
    17338           message "Ошибка при установке продажной цены." skip( 0 )
    17339                   return-value
    17340           view-as alert-box .
    17341           return error .
    17342         end.
    17343       end.
    17344       else do:
    17345         if varbase-price-input = true then do:
    17346           assign
    17347             tt-fr-doc-line.price-cli = tt-fr-doc-line.price-rubl / t-doc.exch-rate * t-doc.exch-scale * tt-fr-doc-line.cli-base-rate
    17348           .
    17349         end.
    17350       end.
    17351   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
    17352     (
    17353      input   t-doc.doc-code
    17354     ,input   t-doc.base-rate
    17355     ,input   t-doc.base-scale
    17356     ,input   t-doc.exch-rate
    17357     ,input   t-doc.exch-scale
    17358     ,input   t-doc.vat-type
    17359     ,input   t-doc.slt-type
    17360     ,input   tt-fr-doc-line.artic
    17361     ,input   tt-fr-doc-line.prod-type
    17362     ,input   tt-fr-doc-line.prod-code
    17363     ,input   tt-fr-doc-line.price-cli
    17364     ,input   tt-fr-doc-line.cli-base-rate
    17365     ,input   tt-fr-doc-line.price-rubl
    17366     ,input   tt-fr-doc-line.vat-pc
    17367     ,input   tt-fr-doc-line.slt-pc
    17368     ,input   tt-fr-doc-line.road-tax
    17369     ,input   tt-fr-doc-line.transport-rubl
    17370     ,input   tt-fr-doc-line.other-rubl
    17371     ,output  varprice-cli-ca
    17372     ,output  varprice-cli-unit-base-ca
    17373     ,output  varprice-road-tax-ca
    17374     ,output  varprice-other-exp-ca
    17375     ,output  varprice-transport-exp-ca
    17376     ,output  varprice-without-abs-ca
    17377     ,output  varprice-slt-ca
    17378     ,output  varprice-no-slt-ca
    17379     ,output  varprice-vat-ca
    17380     ,output  varprice-no-vat-slt-ca
    17381     ,output  varprice-rubl-ca
    17382     ,output  varprice-road-tax-rubl-ca
    17383     ,output  varprice-other-exp-rubl-ca
    17384     ,output  varprice-transport-exp-rubl-ca
    17385     ,output  varprice-without-abs-rubl-ca
    17386     ,output  varprice-slt-rubl-ca
    17387     ,output  varprice-no-slt-rubl-ca
    17388     ,output  varprice-vat-rubl-ca
    17389     ,output  varprice-no-vat-slt-rubl-ca
    17390     ,output  varprice-base-ca
    17391     ,output  varprice-road-tax-base-ca
    17392     ,output  varprice-other-exp-base-ca
    17393     ,output  varprice-transport-exp-base-ca
    17394     ,output  varprice-without-abs-base-ca
    17395     ,output  varprice-slt-base-ca
    17396     ,output  varprice-no-slt-base-ca
    17397     ,output  varprice-vat-base-ca
    17398     ,output  varprice-no-vat-slt-base-ca
    17399     ) no-error.
    17400       if error-status :error
    17401       then do:
    17402         message "Ошибка при расчете цен."      skip( 0 )
    17403                 return-value                   skip( 0 )
    17404                 error-status :get-message( 1 ) skip( 0 )
    17405                 error-status :get-message( 2 )
    17406         view-as alert-box error .
    17407         return error .
    17408       end.
    17409       assign
    17410         tt-fr-doc-line.price-cli  = varprice-cli-ca
    17411         tt-fr-doc-line.price-base = varprice-base-ca
    17412         tt-fr-doc-line.price-rubl = varprice-rubl-ca
    17413       .
    17414       display tt-fr-doc-line.price-cli
    17415               tt-fr-doc-line.price-base
    17416               tt-fr-doc-line.price-rubl
    17417       with frame d-in-line .
    17418     end.
    17419     if parmode-on = vardensity-calc then do:
    17420       for each tt-doc-pl
    17421       on error undo, return error return-value
    17422       :
    17423         if tt-fr-doc-line.doc-qnty :sensitive in frame d-in-line then do:
    17424           assign
    17425             tt-doc-pl.cli-qnty      = tt-doc-pl.doc-qnty  / tt-fr-doc-line.cli-base-rate
    17426             tt-doc-pl.cli-doc-qnty  = tt-doc-pl.doc-qnty  * tt-fr-doc-line.doc-density
    17427             tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * tt-fr-doc-line.fact-density
    17428           .
    17429         end.
    17430         if tt-fr-doc-line.cli-qnty :sensitive in frame d-in-line then do:
    17431           assign
    17432             tt-doc-pl.doc-qnty      = tt-doc-pl.cli-doc-qnty  / tt-fr-doc-line.doc-density
    17433             tt-doc-pl.fact-qnty     = tt-doc-pl.cli-fact-qnty / tt-fr-doc-line.fact-density
    17434           .
    17435         end.
    17436         if tt-fr-doc-line.fact-qnty :sensitive in frame d-in-line then do:
    17437           assign
    17438             tt-doc-pl.cli-fact-qnty = tt-doc-pl.fact-qnty * tt-fr-doc-line.fact-density
    17439           .
    17440         end.
    17441         if tt-fr-doc-line.fact-qnty-kg :sensitive in frame d-in-line then do:
    17442           assign
    17443             tt-doc-pl.fact-qnty     = tt-doc-pl.cli-fact-qnty / tt-fr-doc-line.fact-density
    17444           .
    17445         end.
    17446       end.
    17447     end.
    17448    if  pr-naklvalue = true  and pr-genmrg = 'before-margin':U and is-petrolium = false  then do:
    17449     if not (( tt-fr-doc-line.price-rubl = 0  or tt-fr-doc-line.price-rubl = ? ) and
    17450           ( parmode-on = "cli-qnty " or parmode-on = "doc-qnty" )) then do:
    17451       run save-action in this-procedure
    17452         ( input "light-super":U
    17453         ) no-error .
    17454       if error-status :error then do:
    17455         return no-apply .
    17456       end.
    17457   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17458   run find-new-price-sale in this-procedure (
    17459      input  pr-genmrg
    17460     ,input  pr-naklvalue
    17461     ,input  t-doc.doc-code
    17462     ,input  buf_goods.artic
    17463     ,input  buf_goods.prod-type
    17464     ,input  buf_goods.prod-code
    17465     ,input  tt-fr-doc-line.price-rubl
    17466     ,input  tt-fr-doc-line.price-base
    17467     ,input  varprice-no-vat-slt-rubl-ca
    17468     ,input  varprice-no-vat-slt-base-ca
    17469     ,input-output tt-fr-doc-line.new-price-sale
    17470       )
    17471       no-error .
    17472         if error-status :error then
    17473         message
    17474           error-status :get-message(1) skip
    17475           return-value skip
    17476           "Нельзя рассчитать новую цену продажи(4)"
    17477           view-as alert-box error
    17478         .
    17479      end.
    17480     end.
    17481     run disp-total in this-procedure no-error .
    17482     if error-status :error
    17483     then do:
    17484       return error .
    17485     end.
    17486   end procedure.
    17487   procedure proc-units:
    17488   // 20/IX-2018 в приходе и в спецификации можно указывать любую ЕИ, для которой на товаре задан коэфф.пересчёта к базовой ЕИ
    17489   // 28/IX-2018 в приходе по договору можно указать либо базовую ЕИ, либо ЕИ из спецификации договора
    17490   define buffer bf-r-units for ub.units.
    17491   define variable v-ret-unit-name  as character no-undo .
    17492   define variable v-ret-unit-coeff as decimal no-undo .
    17493     run ref/alt-units.w (input parparentproc,
    17494                          input 'ВЫБОР':U,
    17495                          input buf_goods.gds-code,
    17496                          input v-specif-unit-list,
    17497                         output v-ret-unit-name,
    17498                         output v-ret-unit-coeff) .
    17499     if v-ret-unit-name > "" then do :
    17500       if can-find (first bf-r-units where bf-r-units.unit-name = v-ret-unit-name) then do :
    17501         tt-fr-doc-line.unit-cli      = v-ret-unit-name .
    17502         tt-fr-doc-line.cli-base-rate = v-ret-unit-coeff .
    17503         display
    17504           tt-fr-doc-line.unit-cli
    17505           tt-fr-doc-line.cli-base-rate
    17506         with frame d-in-line.
    17507       end .
    17508     end .
    17509     else return error .
    17510   end procedure.
    17511   procedure v-c-type-inp-vat:
    17512   do on error undo, return error return-value:
    17513   assign frame d-in-line tt-fr-doc-line.type-inp-vat.
    17514   if tt-fr-doc-line.type-inp-vat = yes then do:
    17515      enable  tt-fr-doc-line.vat-pc when t-doc.vat-type <> 'без':U with frame d-in-line.
    17516      disable sum-vat with frame d-in-line.
    17517      apply "leave" to tt-fr-doc-line.vat-pc in frame d-in-line.
    17518   end.
    17519   else do:
    17520      enable sum-vat when t-doc.vat-type <> 'без':U with frame d-in-line.
    17521      disable tt-fr-doc-line.vat-pc with frame d-in-line.
    17522      apply "leave" to sum-vat in frame d-in-line.
    17523   end.
    17524   end.
    17525   end procedure.
    17526   procedure chg-unit:
    17527   define variable v-unit-name as character no-undo .
    17528   define buffer buf_units    for ub.units .
    17529   define buffer buf_contract for ub.contract .
    17530   define buffer buf_contract-specif for ub.contract-specif .
    17531     v-unit-name = input frame d-in-line tt-fr-doc-line.unit-cli .
    17532     if not can-find (first buf_units where buf_units.unit-name = v-unit-name) then do:
    17533       message
    17534         substitute("Единица измерения поставщика [&1] отсутствует в справочнике единиц измерения", v-unit-name)
    17535         view-as alert-box.
    17536       display tt-fr-doc-line.unit-cli with frame d-in-line.
    17537       apply "choose" to r-units.
    17538       return no-apply.
    17539     end.
    17540     // 28/IX-2018 при создании ПН с договором можно указывать только базовую или ед. измерения по договору
    17541     if t-doc.contract-code > 0 then do :
    17542       if (buf_goods.unit-base = v-unit-name) or (v-specif-unit-list  = v-unit-name) then .
    17543       else do :
    17544         message
    17545         substitute("Единицей измерения поставщика [&1] может быть или [&2] - базовая для товара, или [&3] - указанная в договоре",
    17546                    v-unit-name, buf_goods.unit-base, v-specif-unit-list)
    17547         view-as alert-box.
    17548       display tt-fr-doc-line.unit-cli with frame d-in-line.
    17549       apply "choose" to r-units.
    17550       return no-apply.
    17551       end .
    17552     end .
    17553     assign frame d-in-line tt-fr-doc-line.unit-cli.
    17554   end procedure.
    17555   procedure chs-dog :
    17556   do on error undo, return error return-value :
    17557   define variable varrid-list as character no-undo.
    17558   define variable varrecid    as recid     no-undo.
    17559   define buffer bf_contract for ub.contract.
    17560   run str/cont-all.w (input parparentproc,
    17561                   input t-doc.host-code,
    17562                   input "b-sel",
    17563                   input "firm-curr" ,
    17564                   input t-doc.cli-type,
    17565                   input t-doc.cli-code,
    17566                   input ?,
    17567                   input ?,
    17568                   input "current":u,
    17569                   input 'при':U,
    17570                   input-output varrid-list ) no-error.
    17571   assign
    17572     varrecid = integer(entry(1, varrid-list)).
    17573   find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
    17574   if available bf_contract then do:
    17575     if bf_contract.doc-type <> 'при':U then do:
    17576       message "Неверный тип контракта." view-as alert-box.
    17577       return error.
    17578     end.
    17579     if bf_contract.cli-type <> t-doc.cli-type or
    17580        bf_contract.cli-code <> t-doc.cli-code then do:
    17581       message "Накладная оформляется на контрагента: " t-doc.cli-type " " t-doc.cli-code " ." skip
    17582               "Договор по контрагенту: " bf_contract.cli-type " " bf_contract.cli-code " ."
    17583       view-as alert-box error.
    17584       return error.
    17585     end.
    17586     assign tt-fr-doc-line.contract-prn-code = bf_contract.contract-prn-code.
    17587     assign tt-fr-doc-line.contract-code = bf_contract.contract-code.
    17588   end.
    17589   end.
    17590   end procedure.
    17591   procedure calc-price-sale:
    17592     assign parprice-sale = ?.
    17593     run tax-val in this-procedure
    17594       (input tt-fr-doc-line.artic,
    17595       input tt-fr-doc-line.prod-type,
    17596       input tt-fr-doc-line.prod-code,
    17597       input tt-fr-doc-line.unit-base,
    17598       input ?,
    17599       input tt-fr-doc-line.unit-type,
    17600       input ?,
    17601       input no,
    17602       input integer(rdtaxcdvalue),
    17603       input integer(vattaxcdvalue),
    17604       input integer(exctaxcdvalue),
    17605       input no,
    17606       input t-doc.host-code,
    17607       input t-doc.obj-type,
    17608       input t-doc.obj-code,
    17609       input ?,
    17610       input ?,
    17611       output temp-mes,
    17612       input-output parprice-sale) no-error.
    17613     if error-status :error or return-value = "error" then do:
    17614        message "Ошибка при вызове процедуры налогов." view-as alert-box.
    17615        return error.
    17616     end.
    17617     if parprice-sale = ? then do:
    17618        message "Нельзя найти продажную цену товара по объекту. " +
    17619                "Артикул " +  tt-fr-doc-line.artic + " Производитель " +
    17620                tt-fr-doc-line.prod-type + " " + string(tt-fr-doc-line.prod-code) " ."
    17621        view-as alert-box.
    17622        return error.
    17623     end.
    17624     find first tt-tax where tt-tax.tax-code = integer(rdtaxcdvalue) no-error.
    17625     if available tt-tax then do:
    17626        assign  tt-fr-doc-line.road-tax = tt-tax.rate-value.
    17627        display tt-fr-doc-line.road-tax with frame d-in-line.
    17628     end.
    17629     find first tt-tax where tt-tax.tax-code = integer(exctaxcdvalue) no-error.
    17630     if available tt-tax then do:
    17631        assign tt-fr-doc-line.excise = tt-tax.rate-value.
    17632        display tt-fr-doc-line.excise with frame d-in-line.
    17633     end.
    17634     if varr-b = "rubl":u then do:
    17635       assign
    17636         tt-fr-doc-line.price-rubl = parprice-sale
    17637         tt-fr-doc-line.price-base = tt-fr-doc-line.price-rubl / t-doc.base-rate * t-doc.base-scale
    17638       .
    17639     end.
    17640     else do:
    17641       assign
    17642         tt-fr-doc-line.price-base = parprice-sale
    17643         tt-fr-doc-line.price-rubl = tt-fr-doc-line.price-base * t-doc.base-rate /  t-doc.base-scale
    17644       .
    17645     end.
    17646     assign
    17647       tt-fr-doc-line.price-cli  = tt-fr-doc-line.price-rubl / t-doc.exch-rate * t-doc.exch-scale * tt-fr-doc-line.cli-base-rate
    17648       tt-fr-doc-line.type-inp-sum = no
    17649     .
    17650     display
    17651       tt-fr-doc-line.price-cli
    17652       tt-fr-doc-line.price-base
    17653       tt-fr-doc-line.price-rubl
    17654       with frame d-in-line.
    17655   end.
    17656   procedure proc-country-code :
    17657     do
    17658     on error undo, return error return-value
    17659     :
    17660   define variable varrid-list as character no-undo.
    17661   define variable varrecid    as recid     no-undo.
    17662   define buffer bf_country for ub.country.
    17663   run ref/countris.w  (  input parparentproc
    17664                    , input "b-sel"
    17665                    , input-output varrid-list ) no-error.
    17666     if error-status :error then do:
    17667        message vss-workfile vss-revision vss-description skip
    17668                error-status :get-message( 1 )
    17669        view-as alert-box.
    17670        return .
    17671        end.
    17672   if varrid-list = '' then return no-apply.
    17673   assign
    17674     varrecid = integer(entry(1, varrid-list)).
    17675   find first bf_country no-lock where recid(bf_country) = varrecid no-error.
    17676   if available bf_country then do:
    17677     assign tt-fr-doc-line.country-code  = bf_country.num-code
    17678            tt-fr-doc-line.alpha1        = bf_country.alpha1
    17679            tt-fr-doc-line.short-name    = bf_country.short-name
    17680            .
    17681     display
    17682        tt-fr-doc-line.alpha1
    17683        tt-fr-doc-line.short-name
    17684        with frame d-in-line.
    17685   end.
    17686     end.
    17687   end procedure.
    17688   procedure save-country-code :
    17689     do
    17690     on error undo, return error return-value
    17691     :
    17692   run lineattr-write in this-procedure (
    17693     input   t-doc.doc-code  ,
    17694     input   buf_goods.gds-code  ,
    17695     input   'country-code':U ,
    17696     input   string(tt-fr-doc-line.country-code) )
    17697     no-error .
    17698       if error-status :error then do:
    17699          message vss-workfile vss-revision vss-description skip
    17700                  error-status :get-message( 1 )
    17701                  return-value
    17702          view-as alert-box error .
    17703          return error.
    17704       end.
    17705   end.
    17706   end procedure.
    17707   procedure edit-doc-pl :
    17708     define input  parameter p-edit-doc-pl-mode as character no-undo .
    17709     define variable d_fact-qnty     as decimal   no-undo initial 0.00 .
    17710     define variable d_doc-qnty      as decimal   no-undo initial 0.00 .
    17711     define variable d_cli-fact-qnty as decimal   no-undo initial 0.00 .
    17712     define variable d_cli-doc-qnty  as decimal   no-undo initial 0.00 .
    17713     define variable v-log           as logical   no-undo .
    17714     define variable v-tmp-pl-code as integer no-undo .
    17715     if varrvs-place = false then do:
    17716       message
    17717         substitute( "Товар &1 не привязывается к местам хранения.", buf_goods.gds-code )
    17718         view-as alert-box.
    17719       return .
    17720     end.
    17721     if parline-mode = 'ПРОСМОТР':U then do:
    17722       assign
    17723         p-edit-doc-pl-mode = 'ПРОСМОТР':U
    17724       .
    17725     end.
    17726     else do:
    17727       if t-doc.status_ = 'накл':U
    17728         and t-doc.flag_ = false
    17729       then do:
    17730         if tt-fr-doc-line.cli-base-rate = 0
    17731           or tt-fr-doc-line.cli-base-rate = ?
    17732           or tt-fr-doc-line.doc-density = 0
    17733           or tt-fr-doc-line.doc-density = ?
    17734         then do:
    17735           if tt-fr-doc-line.doc-density :sensitive in frame d-in-line then do:
    17736             message
    17737               "Не указана плотность"
    17738               view-as alert-box information.
    17739             apply "entry" to tt-fr-doc-line.doc-density in frame d-in-line .
    17740             return error .
    17741           end.
    17742           else do:
    17743             if tt-fr-doc-line.cli-base-rate :sensitive in frame d-in-line then do:
    17744               message
    17745                 "Не указан коэффициент единиц измерения поставщика."
    17746                 view-as alert-box information.
    17747                 apply "entry" to tt-fr-doc-line.cli-base-rate in frame d-in-line .
    17748               return error .
    17749             end.
    17750           end.
    17751         end.
    17752       end.
    17753     end.
    17754     if v-lgas-gds
    17755     then
    17756       for first tt-doc-pl :
    17757         assign v-tmp-pl-code = tt-doc-pl.pl-code no-error .
    17758       end .
    17759     run str/doc-pls.w
    17760       ( input parparentproc
    17761        ,input p-edit-doc-pl-mode
    17762        ,input (if t-doc.status_ = 'накл':U and t-doc.flag_ = false then "doc":U else "fact":U )
    17763        ,input ( if varcli-qnty-input = true then "cli":U else "base":U )
    17764        ,input t-doc.doc-code
    17765        ,input buf_goods.gds-code
    17766        ,input tt-fr-doc-line.unit-cli
    17767        ,input tt-fr-doc-line.cli-base-rate
    17768        ,input tt-fr-doc-line.doc-density
    17769        ,input tt-fr-doc-line.fact-density
    17770        ,input tt-fr-doc-line.cli-qnty
    17771        ,input tt-fr-doc-line.doc-qnty
    17772        ,input tt-fr-doc-line.fact-qnty
    17773        ,input tt-fr-doc-line.doc-qnty  * tt-fr-doc-line.doc-density
    17774        ,input tt-fr-doc-line.fact-qnty * tt-fr-doc-line.fact-density
    17775        ,input ?
    17776        ,input ?
    17777        ,input ?
    17778       ) no-error .
    17779     if error-status :error then do:
    17780       message
    17781         vss-workfile vss-revision vss-description skip
    17782         "Ошибка при разбиении кол-ва по местам хранения." skip
    17783         error-status :get-message(1) skip
    17784         return-value skip
    17785         view-as alert-box error .
    17786     end.
    17787     if parline-mode <> 'ПРОСМОТР':U then do:
    17788       for each tt-doc-pl no-lock
    17789       on error undo, return error return-value
    17790       :
    17791         assign
    17792           d_fact-qnty     = d_fact-qnty     + tt-doc-pl.fact-qnty
    17793           d_doc-qnty      = d_doc-qnty      + tt-doc-pl.doc-qnty
    17794           d_cli-fact-qnty = d_cli-fact-qnty + tt-doc-pl.cli-fact-qnty
    17795           d_cli-doc-qnty  = d_cli-doc-qnty  + tt-doc-pl.cli-doc-qnty
    17796         .
    17797       end.
    17798       assign
    17799         v-log = true
    17800       .
    17801       if tt-fr-doc-line.doc-qnty <> d_doc-qnty
    17802         or
    17803         ( tt-fr-doc-line.doc-qnty :sensitive in frame d-in-line = true
    17804            and absolute( tt-fr-doc-line.cli-qnty - d_cli-doc-qnty ) > 0.001
    17805         )
    17806         or
    17807         ( tt-fr-doc-line.cli-qnty :sensitive in frame d-in-line = true
    17808           and tt-fr-doc-line.cli-qnty <> d_cli-doc-qnty
    17809         )
    17810       then do:
    17811         message
    17812           substitute( "Документарная сумма по местам хранения: &1 &2 (&3 &4)", d_doc-qnty, buf_goods.unit-base, d_cli-doc-qnty, buf_goods.unit-cli ) skip
    17813           substitute( "Документарное кол-во по строке документа: &1 &2 (&3 &4)", tt-fr-doc-line.doc-qnty, buf_goods.unit-base, tt-fr-doc-line.doc-qnty * tt-fr-doc-line.doc-density, buf_goods.unit-cli ) skip(1)
    17814           substitute( "Будем менять документарное количество по строке на &1 &2 (&3 &4)?", d_doc-qnty, buf_goods.unit-base, d_cli-doc-qnty, buf_goods.unit-cli )
    17815           view-as alert-box question buttons yes-no update v-log.
    17816         if v-log = true then do:
    17817           assign
    17818             tt-fr-doc-line.doc-qnty = d_doc-qnty
    17819             tt-fr-doc-line.cli-qnty = d_cli-doc-qnty
    17820             tt-fr-doc-line.doc-density = tt-fr-doc-line.cli-qnty / tt-fr-doc-line.doc-qnty
    17821           .
    17822           display
    17823             tt-fr-doc-line.doc-qnty
    17824             tt-fr-doc-line.cli-qnty
    17825             tt-fr-doc-line.doc-density
    17826             with frame d-in-line .
    17827         end.
    17828       end.
    17829       if varupd-fact-qnty = true
    17830         and not( t-doc.status_ = 'накл':U
    17831                  and t-doc.flag_ = false
    17832                )
    17833       then do :
    17834         if absolute( tt-fr-doc-line.fact-qnty - d_fact-qnty ) <= 0.001
    17835         then do :
    17836           tt-fr-doc-line.fact-qnty = d_fact-qnty .
    17837         end .
    17838       end .
    17839       if varupd-fact-qnty = true
    17840         and not( t-doc.status_ = 'накл':U
    17841                  and t-doc.flag_ = false
    17842                )
    17843         and ( tt-fr-doc-line.fact-qnty <> d_fact-qnty
    17844               or absolute( tt-fr-doc-line.fact-qnty-kg - d_cli-fact-qnty ) > 0.001
    17845             )
    17846       then do:
    17847         message
    17848           substitute( "Фактическая сумма по местам хранения: &1 &2 (&3 &4)", d_fact-qnty, buf_goods.unit-base, d_cli-fact-qnty, buf_goods.unit-cli ) skip
    17849           substitute( "Фактическое кол-во по строке документа: &1 &2 (&3 &4)", tt-fr-doc-line.fact-qnty, buf_goods.unit-base, tt-fr-doc-line.fact-qnty * tt-fr-doc-line.fact-density, buf_goods.unit-cli ) skip(1)
    17850           substitute( "Будем менять фактическое количество по строке на &1 &2 (&3 &4)?", d_fact-qnty, buf_goods.unit-base, d_cli-fact-qnty, buf_goods.unit-cli )
    17851           view-as alert-box question buttons yes-no update v-log.
    17852         if v-log = true then do:
    17853           assign
    17854             tt-fr-doc-line.fact-qnty    = d_fact-qnty
    17855             tt-fr-doc-line.fact-qnty-kg = d_cli-fact-qnty
    17856             tt-fr-doc-line.fact-density = tt-fr-doc-line.fact-qnty-kg / tt-fr-doc-line.fact-qnty
    17857           .
    17858           display
    17859             tt-fr-doc-line.fact-qnty
    17860             tt-fr-doc-line.fact-qnty-kg
    17861             tt-fr-doc-line.fact-density
    17862             with frame d-in-line
    17863           .
    17864         end.
    17865       end.
    17866       run check-place-rsrv in this-procedure
    17867         no-error .
    17868       if error-status :error then do:
    17869         return error  .
    17870       end.
    17871       if v-lgas-gds
    17872       then do :
    17873         for first tt-doc-pl :
    17874           if v-tmp-pl-code <> tt-doc-pl.pl-code
    17875           then do :
    17876             assign
    17877               cb-connect-hoses = "empty"
    17878             .
    17879             display cb-connect-hoses with frame d-in-line .
    17880           end .
    17881           find first bf_place-attr no-lock where bf_place-attr.obj-type  = tt-doc-pl.obj-type
    17882                                              and bf_place-attr.obj-code  = tt-doc-pl.obj-code
    17883                                              and bf_place-attr.pl-code   = tt-doc-pl.pl-code
    17884                                              and bf_place-attr.attr-code = "place-gate-valve"
    17885                                              no-error .
    17886           if available bf_place-attr
    17887           and logical(bf_place-attr.attr-value)
    17888           then do :
    17889             enable cb-connect-hoses with frame d-in-line .
    17890           end .
    17891           else do :
    17892             disable cb-connect-hoses with frame d-in-line .
    17893           end .
    17894         end .
    17895       end .
    17896     end.
    17897   end procedure.
    17898   procedure check-place-rsrv :
    17899     define variable d_fact-qnty     as decimal no-undo initial 0.00 .
    17900     define variable d_doc-qnty      as decimal no-undo initial 0.00 .
    17901     define variable d_cli-qnty      as decimal no-undo initial 0.00 .
    17902     define variable d_cli-fact-qnty as decimal no-undo initial 0.00 .
    17903     define variable d_cli-doc-qnty  as decimal no-undo initial 0.00 .
    17904     define variable d_density       as decimal no-undo              .
    17905     define variable j_pl-code       as integer no-undo              .
    17906     do
    17907     on error undo, return error return-value
    17908     :
    17909       if varrvs-place <> true
    17910         or b-place :sensitive in frame d-in-line <> true
    17911       then do:
    17912         return .
    17913       end.
    17914       assign
    17915         d_fact-qnty     = 0.00
    17916         d_doc-qnty      = 0.00
    17917         d_cli-qnty      = 0.00
    17918         d_cli-fact-qnty = 0.00
    17919         d_cli-doc-qnty  = 0.00
    17920       .
    17921       for each tt-doc-pl no-lock
    17922       on error undo, return error return-value
    17923       :
    17924         assign
    17925           d_cli-qnty      = d_cli-qnty      + tt-doc-pl.cli-qnty
    17926           d_fact-qnty     = d_fact-qnty     + tt-doc-pl.fact-qnty
    17927           d_doc-qnty      = d_doc-qnty      + tt-doc-pl.doc-qnty
    17928           d_cli-fact-qnty = d_cli-fact-qnty + tt-doc-pl.cli-fact-qnty
    17929           d_cli-doc-qnty  = d_cli-doc-qnty  + tt-doc-pl.cli-doc-qnty
    17930         .
    17931       end.
    17932       if tt-fr-doc-line.doc-qnty <> d_doc-qnty then do:
    17933         message
    17934           substitute( 'Количество по документу в строке накладной: &1 &3'
    17935                       + 'НЕ СОВПАДАЕТ с суммарным количеством по местам хранения: &2.&3'
    17936                       , tt-fr-doc-line.doc-qnty
    17937                       , d_doc-qnty
    17938                       , chr(10)
    17939                     )
    17940           view-as alert-box error .
    17941         undo, return error .
    17942       end.
    17943       if ( tt-fr-doc-line.cli-qnty :sensitive in frame d-in-line = true
    17944            and tt-fr-doc-line.cli-qnty <> d_cli-doc-qnty
    17945          )
    17946          or
    17947          ( tt-fr-doc-line.cli-qnty :sensitive in frame d-in-line = false
    17948            and absolute( tt-fr-doc-line.cli-qnty - d_cli-doc-qnty ) > 0.001
    17949          )
    17950       then do:
    17951         message
    17952           substitute( 'Количество по ТТН в ед.пост-ка в строке накладной: &1 &3'
    17953                       + 'НЕ СОВПАДАЕТ с суммарным количеством в ед.пост-ка по местам хранения: &2.&3'
    17954                       + 'Нажмите кнопку "&4" и исправьте количества по местам хранения&3'
    17955                       + 'или исправьте количество по ТТН в строке накладной.'
    17956                       , tt-fr-doc-line.cli-qnty
    17957                       , d_cli-doc-qnty
    17958                       , chr(10)
    17959                       , replace( b-place :label in frame d-in-line, "&", "":U )
    17960                     )
    17961           view-as alert-box error .
    17962         undo, return error .
    17963       end.
    17964       if not( t-doc.status_ = 'накл':U
    17965               and t-doc.flag_ = false
    17966             )
    17967         and tt-fr-doc-line.fact-qnty <> d_fact-qnty
    17968       then do:
    17969         message
    17970           substitute( 'Фактическое количество в строке накладной: &1 &3'
    17971                       + 'НЕ СОВПАДАЕТ &3 с суммарным фактическим количеством по местам хранения: &2.&3'
    17972                       + 'Нажмите кнопку "&4" и исправьте количества по местам хранения&3'
    17973                       + 'или исправьте фактическое количество в строке накладной.'
    17974                       , tt-fr-doc-line.fact-qnty
    17975                       , d_fact-qnty
    17976                       , chr(10)
    17977                       , replace( b-place :label in frame d-in-line, "&", "":U )
    17978                     )
    17979           view-as alert-box error .
    17980         undo, return error .
    17981       end.
    17982       if not( t-doc.status_ = 'накл':U
    17983               and t-doc.flag_ = false
    17984             )
    17985         and absolute( tt-fr-doc-line.fact-qnty-kg - d_cli-fact-qnty ) > 0.001
    17986       then do:
    17987         message
    17988           substitute( 'Фактическое количество в ед.пост-ка в строке накладной: &1 &3'
    17989                       + 'НЕ СОВПАДАЕТ &3 с суммарным фактическим количеством в ед.пост-ка по местам хранения: &2.&3'
    17990                       + 'Нажмите кнопку "&4" и исправьте фактические количества в ед.пост-ка по местам хранения&3'
    17991                       + 'или исправьте фактическое количество в ед.пост-ка в строке накладной.'
    17992                       , tt-fr-doc-line.fact-qnty-kg
    17993                       , d_cli-fact-qnty
    17994                       , chr(10)
    17995                       , replace( b-place :label in frame d-in-line, "&", "":U )
    17996                     )
    17997           view-as alert-box error .
    17998         undo, return error .
    17999       end.
    18000       if buf_goods.unit-base <> buf_goods.unit-cli then do:
    18001         assign
    18002           d_density = d_cli-doc-qnty / d_doc-qnty
    18003         .
    18004         if Valid-Density( d_density, (buf_goods.unit-base = buf_goods.unit-cli)  ) <> true
    18005           and ( tt-fr-doc-line.doc-qnty :sensitive in frame d-in-line
    18006                 or tt-fr-doc-line.cli-qnty :sensitive in frame d-in-line
    18007               )
    18008         then do:
    18009           message
    18010             substitute( 'Заявленная плотность топлива (&1) не соответствует ожидаемому. Кол-во: &2л и &3кг.'
    18011                         , d_density
    18012                         , d_doc-qnty
    18013                         , d_cli-doc-qnty
    18014                       )
    18015             view-as alert-box error .
    18016           undo, return error .
    18017         end.
    18018         if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
    18019           if d_density < v-min-dens
    18020           or d_density > v-max-dens
    18021           then do:
    18022               message
    18023                 substitute("Заявленная плотность топлива (&1) находится вне заданного диапазона: &2."
    18024                 , d_density
    18025                 , v-gds-ptrl-densities )
    18026                 view-as alert-box error .
    18027               undo, return error .
    18028           end.
    18029         end.
    18030         assign
    18031           d_density = d_cli-fact-qnty / d_fact-qnty
    18032         .
    18033         if Valid-Density( d_density, (buf_goods.unit-base = buf_goods.unit-cli)  ) <> true
    18034           and tt-fr-doc-line.fact-qnty :sensitive in frame d-in-line
    18035         then do:
    18036           message
    18037             substitute( 'Фактическая плотность топлива (&1) не соответствует ожидаемому. Кол-во: &2л и &3кг.'
    18038                       , d_density
    18039                       , d_fact-qnty
    18040                       , d_cli-fact-qnty
    18041                       )
    18042             view-as alert-box error .
    18043           undo, return error .
    18044         end.
    18045         if v-gds-ptrl-densities <> "" and v-gds-ptrl-densities <> ? then do:
    18046           if d_density < v-min-dens
    18047           or d_density > v-max-dens
    18048           then do:
    18049               message
    18050                 substitute("Фактическая плотность топлива (&1) находится вне заданного диапазона: &2."
    18051                 , d_density
    18052                 , v-gds-ptrl-densities )
    18053                 view-as alert-box error .
    18054               undo, return error .
    18055           end.
    18056         end.
    18057       end.
    18058     end.
    18059   end procedure.
    18060   procedure display-b-rvs :
    18061     if lookup(v-ptrl-without-rvs, 'true,yes':u) = 0 and not v-is-lgas-corr then do:
    18062       enable
    18063         b-rvs-bf
    18064         b-rvs-af
    18065         with frame d-in-line.
    18066       if infoSectionsTotal:IsKP
    18067       then do :
    18068         for each tt-doc-pl,
    18069           first bf_place no-lock where bf_place.pl-code = tt-doc-pl.pl-code
    18070         :
    18071           v-KPrvs-secs = "" .
    18072           v-KPrvs-doc-pl = no .
    18073           disable-rvs = no .
    18074           do ii = 1 to infoSectionsTotal:SectionNum :
    18075             if infoSectionsTotal:GetInfoSectionProp(ii):ListTank = bf_place.loc1
    18076             then do :
    18077               if infoSectionsTotal:GetInfoSectionProp(ii):IsKP
    18078               then do :
    18079                 v-KPrvs-doc-pl = yes .
    18080               end .
    18081               v-KPrvs-secs = v-KPrvs-secs + "," + infoSectionsTotal:GetInfoSectionProp(ii):SectionName .
    18082             end .
    18083           end .
    18084           v-KPrvs-secs = trim(v-KPrvs-secs, ",") .
    18085           if not v-KPrvs-doc-pl
    18086           then do :
    18087             disable-rvs = no .
    18088             leave .
    18089           end .
    18090           if v-KPrvs-doc-pl
    18091           and num-entries(v-KPrvs-secs) >= 1
    18092           then do :
    18093             disable-rvs = yes .
    18094           end .
    18095         end .
    18096         if disable-rvs
    18097         then do :
    18098           disable
    18099             b-rvs-bf
    18100             b-rvs-af
    18101           with frame d-in-line.
    18102         end .
    18103       end .
    18104     end.
    18105   end procedure .
    18106   procedure display-measure :
    18107     do
    18108     on error undo, return error return-value
    18109     :
    18110       define buffer bef_rvs-doc  for ub.rvs-doc  .
    18111       define buffer aft_rvs-doc  for ub.rvs-doc  .
    18112       define buffer bef_rvs-line for ub.rvs-line .
    18113       define buffer aft_rvs-line for ub.rvs-line .
    18114       define buffer bef2_rvs-line for ub.rvs-line .
    18115       define buffer aft2_rvs-line for ub.rvs-line .
    18116       define buffer buf_rvs-line-pump for ub.rvs-line-pump .
    18117       define buffer bf2_place    for ub.place .
    18118       define buffer buf_c-place-attr for ub.c-place-attr .
    18119       define buffer buf2_c-place-attr for ub.c-place-attr .
    18120       define buffer buf_pl-gds-pump   for ub.pl-gds-pump .
    18121       define buffer buf_c-pl-gds-pump for ub.c-pl-gds-pump .
    18122       define buffer buf2_c-pl-gds-pump for ub.c-pl-gds-pump .
    18123       define variable v-old-qnty as decimal no-undo .
    18124       define variable v-old-cli-qnty as decimal no-undo .
    18125       define variable v-trk-err as logical no-undo .
    18126       define variable jj as integer no-undo .
    18127       define variable v-pl-gds-pump-status_ as character no-undo .
    18128       assign
    18129         v-old-qnty = tt-fr-doc-line.state-measure-qnty
    18130         v-old-cli-qnty = tt-fr-doc-line.state-measure-cli-qnty
    18131       .
    18132       assign
    18133         tt-fr-doc-line.state-measure-qnty     = 0.00
    18134         tt-fr-doc-line.measure-qnty           = 0.00
    18135         tt-fr-doc-line.state-measure-cli-qnty = 0.00
    18136         tt-fr-doc-line.measure-cli-qnty       = 0.00
    18137         tt-fr-doc-line.trk-cli-qnty           = 0.00
    18138       .
    18139       empty temp-table tt-rvs-line-pump-delta .
    18140       if infoSectionsTotal:IsKP
    18141       then do :
    18142         block-clc-rvs:
    18143         for each tt-doc-pl
    18144         on error undo, return error return-value
    18145         :
    18146           for each bef_rvs-doc no-lock
    18147             where bef_rvs-doc.out-code  = t-doc.doc-code
    18148               and bef_rvs-doc.rvs-type  = 'перед_док':U
    18149           :
    18150             for each bef_rvs-line no-lock
    18151               where bef_rvs-line.rvs-code = bef_rvs-doc.rvs-code
    18152                 and bef_rvs-line.obj-type = bef_rvs-doc.obj-type
    18153                 and bef_rvs-line.obj-code = bef_rvs-doc.obj-code
    18154                 and bef_rvs-line.pl-code  = tt-doc-pl.pl-code
    18155                 and bef_rvs-line.gds-code = tt-doc-pl.gds-code
    18156             :
    18157               assign
    18158                 tt-fr-doc-line.state-measure-qnty     = tt-fr-doc-line.state-measure-qnty     - bef_rvs-line.state-measure-qnty
    18159                 tt-fr-doc-line.measure-qnty           = tt-fr-doc-line.measure-qnty           - bef_rvs-line.measure-qnty
    18160                 tt-fr-doc-line.state-measure-cli-qnty = tt-fr-doc-line.state-measure-cli-qnty - bef_rvs-line.state-measure-cli-qnty
    18161                 tt-fr-doc-line.measure-cli-qnty       = tt-fr-doc-line.measure-cli-qnty       - bef_rvs-line.measure-cli-qnty
    18162               .
    18163               for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code = bef_rvs-line.rvs-code
    18164                                                    and buf_rvs-line-pump.obj-type = bef_rvs-line.obj-type
    18165                                                    and buf_rvs-line-pump.obj-code = bef_rvs-line.obj-code
    18166                                                    and buf_rvs-line-pump.pl-code  = bef_rvs-line.pl-code
    18167                                                    and buf_rvs-line-pump.gds-code = bef_rvs-line.gds-code
    18168               :
    18169                 if t-doc.status_ = 'факт':U
    18170                 then do :
    18171                   find last buf_c-pl-gds-pump no-lock where buf_c-pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    18172                                                         and buf_c-pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    18173                                                         and buf_c-pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    18174                                                         and buf_c-pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    18175                                                         and buf_c-pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    18176                                                         and (buf_c-pl-gds-pump.corr-date < t-doc.fact-date
    18177                                                           or buf_c-pl-gds-pump.corr-date = t-doc.fact-date and buf_c-pl-gds-pump.corr-time < t-doc.fact-time)
    18178                                                         no-error .
    18179                 end .
    18180                 else do :
    18181                   find last buf_c-pl-gds-pump no-lock where buf_c-pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    18182                                                         and buf_c-pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    18183                                                         and buf_c-pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    18184                                                         and buf_c-pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    18185                                                         and buf_c-pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    18186                                                         and (buf_c-pl-gds-pump.corr-date < t-doc.sys-date
    18187                                                           or buf_c-pl-gds-pump.corr-date = t-doc.sys-date and buf_c-pl-gds-pump.corr-time < t-doc.sys-time-int)
    18188                                                         no-error .
    18189                 end .
    18190                 if available buf_c-pl-gds-pump
    18191                 then do :
    18192                   find first buf2_c-pl-gds-pump no-lock where buf2_c-pl-gds-pump.obj-type = buf_c-pl-gds-pump.obj-type
    18193                                                           and buf2_c-pl-gds-pump.obj-code = buf_c-pl-gds-pump.obj-code
    18194                                                           and buf2_c-pl-gds-pump.pl-code  = buf_c-pl-gds-pump.pl-code
    18195                                                           and buf2_c-pl-gds-pump.gds-code = buf_c-pl-gds-pump.gds-code
    18196                                                           and buf2_c-pl-gds-pump.pump-code = buf_c-pl-gds-pump.pump-code
    18197                                                           and buf2_c-pl-gds-pump.chip-num > buf_c-pl-gds-pump.chip-num
    18198                                                           no-error .
    18199                   if available buf2_c-pl-gds-pump
    18200                   then do :
    18201                     v-pl-gds-pump-status_ = buf2_c-pl-gds-pump.status_ .
    18202                   end .
    18203                   else do :
    18204                     for first buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    18205                                                         and buf_pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    18206                                                         and buf_pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    18207                                                         and buf_pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    18208                                                         and buf_pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    18209                     :
    18210                       v-pl-gds-pump-status_ = buf_pl-gds-pump.status_ .
    18211                     end .
    18212                   end .
    18213                 end .
    18214                 else do :
    18215                   for first buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    18216                                                       and buf_pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    18217                                                       and buf_pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    18218                                                       and buf_pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    18219                                                       and buf_pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    18220                   :
    18221                     v-pl-gds-pump-status_ = buf_pl-gds-pump.status_ .
    18222                   end .
    18223                 end .
    18224                 if v-pl-gds-pump-status_ = 'тек':U
    18225                 then do :
    18226                   create tt-rvs-line-pump-delta .
    18227                   buffer-copy buf_rvs-line-pump to tt-rvs-line-pump-delta
    18228                   assign
    18229                     tt-rvs-line-pump-delta.rvs-code = "before-doc" + entry(2, buf_rvs-line-pump.rvs-code, "-")
    18230                     tt-rvs-line-pump-delta.density = (bef_rvs-line.state-density / 2)
    18231                   .
    18232                   if tt-rvs-line-pump-delta.state-el-cnt = ?
    18233                   or tt-rvs-line-pump-delta.state-el-cnt <= 0
    18234                   then do :
    18235                     tt-rvs-line-pump-delta.is-err = yes .
    18236                   end .
    18237                 end .
    18238               end.
    18239             end .
    18240             if t-doc.status_ = 'факт':U
    18241             then do :
    18242               find last buf_c-place-attr no-lock where buf_c-place-attr.obj-type  = tt-doc-pl.obj-type
    18243                                                    and buf_c-place-attr.obj-code  = tt-doc-pl.obj-code
    18244                                                    and buf_c-place-attr.pl-code   = tt-doc-pl.pl-code
    18245                                                    and buf_c-place-attr.attr-code = "place-com-tanks"
    18246                                                    and (buf_c-place-attr.corr-date < t-doc.fact-date
    18247                                                      or buf_c-place-attr.corr-date = t-doc.fact-date and buf_c-place-attr.corr-time < t-doc.fact-time)
    18248                                                    no-error .
    18249             end .
    18250             else do :
    18251               find last buf_c-place-attr no-lock where buf_c-place-attr.obj-type  = tt-doc-pl.obj-type
    18252                                                    and buf_c-place-attr.obj-code  = tt-doc-pl.obj-code
    18253                                                    and buf_c-place-attr.pl-code   = tt-doc-pl.pl-code
    18254                                                    and buf_c-place-attr.attr-code = "place-com-tanks"
    18255                                                    and (buf_c-place-attr.corr-date < t-doc.sys-date
    18256                                                      or buf_c-place-attr.corr-date = t-doc.sys-date and buf_c-place-attr.corr-time < t-doc.sys-time-int)
    18257                                                    no-error .
    18258             end .
    18259             if available buf_c-place-attr
    18260             then do :
    18261               find first buf2_c-place-attr no-lock where buf2_c-place-attr.obj-type = buf_c-place-attr.obj-type
    18262                                                      and buf2_c-place-attr.obj-code = buf_c-place-attr.obj-code
    18263                                                      and buf2_c-place-attr.pl-code  = buf_c-place-attr.pl-code
    18264                                                      and buf2_c-place-attr.attr-code = buf_c-place-attr.attr-code
    18265                                                      and buf2_c-place-attr.chip-num > buf_c-place-attr.chip-num
    18266                                                      no-error .
    18267               if available buf2_c-place-attr
    18268               then do :
    18269                 if buf2_c-place-attr.attr-value > ""
    18270                 then do :
    18271                   assign
    18272                     v-ok = yes
    18273                     varvalue = buf2_c-place-attr.attr-value
    18274                   .
    18275                 end .
