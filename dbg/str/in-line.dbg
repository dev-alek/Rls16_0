    15916           if not cross-list('2ед':U, tt-fr-doc-line.unit-type, ?) and
    15917              vat-sumvalue = "yes" then do:
    15918               enable tt-fr-doc-line.type-inp-vat when t-doc.vat-type <> 'без':U with frame d-in-line.
    15919               if tt-fr-doc-line.type-inp-vat then do:
    15920                 enable tt-fr-doc-line.vat-pc when t-doc.vat-type <> 'без':U with frame d-in-line.
    15921               end.
    15922               else do:
    15923                 enable sum-vat when t-doc.vat-type <> 'без':U with frame d-in-line.
    15924                 apply "leave" to sum-vat in frame d-in-line.
    15925               end.
    15926            end.
    15927            else do:
    15928              enable tt-fr-doc-line.vat-pc when t-doc.vat-type <> 'без':U with frame d-in-line.
    15929            end.
    15930            enable tt-fr-doc-line.slt-pc when t-doc.slt-type <> 'без':U with frame d-in-line.
    15931        end.
    15932        if custvalue = "yes" then do:
    15933           enable tt-fr-doc-line.wt-brutto tt-fr-doc-line.wt-place tt-fr-doc-line.num-place with frame d-in-line.
    15934        end.
    15935        if varprice-cli-input = true
    15936          and v-insalepr = false
    15937        then do:
    15938           if tt-fr-doc-line.type-inp-sum = yes then do:
    15939             enable tt-fr-doc-line.tot-cli  with frame d-in-line.
    15940           end.
    15941           else do:
    15942             enable tt-fr-doc-line.price-cli  with frame d-in-line.
    15943           end.
    15944        end.
    15945        if varbase-price-input = true
    15946          and v-insalepr = false
    15947        then do:
    15948          enable tt-fr-doc-line.price-rubl with frame d-in-line.
    15949        end.
    15950        if v-cntxp-unit-cli-perm then do:
    15951           if varcli-base-rate-input then do:
    15952             enable tt-fr-doc-line.cli-base-rate with frame d-in-line.
    15953           end.
    15954           if varext-gds-type <> 'bg':U and
    15955              varext-gds-type <> 'gg':U   and
    15956              varext-gds-type <> 'pp':U and
    15957              varext-gds-type <> 'kp':U and
    15958              varext-gds-type <> 'lp':U  and
    15959              varext-gds-type <> 'sg':U then do:
    15960                enable tt-fr-doc-line.unit-cli r-units with frame d-in-line.
    15961           end.
    15962        end.
    15963        if is-petrolium = yes
    15964          and is-pieces = no
    15965        then do:
    15966          enable tt-fr-doc-line.temperature with frame d-in-line.
    15967        end.
    15968        if varcli-qnty-input   then enable tt-fr-doc-line.cli-qnty with frame d-in-line.
    15969        if vardensity-input    then enable tt-fr-doc-line.doc-density with frame d-in-line.
    15970        if vardoc-qnty-input   then enable tt-fr-doc-line.doc-qnty with frame d-in-line.
    15971        if vartax-3-input      then enable road-tax-cli with frame d-in-line.
    15972        if varcli-qnty-input then do:
    15973          apply "entry" to tt-fr-doc-line.cli-qnty in frame d-in-line.
    15974        end.
    15975        else do:
    15976           if varcli-base-rate-input then apply "entry" to tt-fr-doc-line.cli-base-rate in frame d-in-line.
    15977           else do:
    15978              if vardensity-input then apply "entry" to tt-fr-doc-line.doc-density in frame d-in-line.
    15979              else do:
    15980                 if vardoc-qnty-input then do:
    15981                   apply "entry" to tt-fr-doc-line.doc-qnty  in frame d-in-line.
    15982                 end.
    15983                 else do:
    15984                   if tt-fr-doc-line.price-cli:sensitive in frame d-in-line then do:
    15985                     apply "entry" to tt-fr-doc-line.price-cli in frame d-in-line.
    15986                   end.
    15987                   if tt-fr-doc-line.tot-cli:sensitive in frame d-in-line then do:
    15988                     apply "entry" to tt-fr-doc-line.tot-cli in frame d-in-line.
    15989                   end.
    15990                 end.
    15991              end.
    15992           end.
    15993        end.
    15994     end.
    15995     else do:
    15996        if varfact-qnty-input then enable tt-fr-doc-line.fact-qnty with frame d-in-line.
    15997     end.
    15998   end.
    15999   if v-edit-fact-wayb
    16000     then enable tt-fr-doc-line.fact-qnty with frame d-in-line.
    16001   enable b-quit b-help with frame d-in-line.
    16002         assign
    16003           frame d-in-line tt-fr-doc-line.fact-qnty
    16004         .
    16005   run disp-total in this-procedure.
    16006   end.
    16007   if is-petrolium = yes and is-pieces = no and not v-lgas-gds then do:
    16008     disable
    16009       tt-fr-doc-line.doc-density
    16010       tt-fr-doc-line.fact-qnty
    16011       tt-fr-doc-line.fact-qnty-kg
    16012       tt-fr-doc-line.doc-qnty
    16013       tt-fr-doc-line.cli-qnty
    16014       tt-fr-doc-line.temperature
    16015       tt-fr-doc-line.doc-density
    16016       tt-fr-doc-line.fact-density
    16017       with frame d-in-line.
    16018     hide tt-fr-doc-line.cli-base-rate tt-fr-doc-line.temperature tt-fr-doc-line.doc-density in frame d-in-line.
    16019   end.
    16020   end procedure.
    16021   procedure check-frame:
    16022   define input parameter kind-check as character no-undo.
    16023   if tt-fr-doc-line.cli-art          :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.cli-art         <> tt-fr-doc-line.cli-art        then apply "leave" to tt-fr-doc-line.cli-art        in frame d-in-line.
    16024   if tt-fr-doc-line.cst-code         :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.cst-code        <> tt-fr-doc-line.cst-code       then apply "leave" to tt-fr-doc-line.cst-code       in frame d-in-line.
    16025   if tt-fr-doc-line.cli-qnty         :sensitive in frame d-in-line then do :
    16026     if input frame d-in-line tt-fr-doc-line.cli-qnty = 0
    16027     or input frame d-in-line tt-fr-doc-line.cli-qnty = ?
    16028     then do:
    16029       message "Не указано количество в единицах измерения поставщика." view-as alert-box error .
    16030       display tt-fr-doc-line.type-inp-vat with frame d-in-line .
    16031       apply "entry" to tt-fr-doc-line.cli-qnty in frame d-in-line .
    16032       return error .
    16033     end.
    16034     if input frame d-in-line tt-fr-doc-line.cli-qnty <> tt-fr-doc-line.cli-qnty then
    16035       apply "leave" to tt-fr-doc-line.cli-qnty       in frame d-in-line.
    16036   end .
    16037   if tt-fr-doc-line.unit-cli         :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.unit-cli        <> tt-fr-doc-line.unit-cli       then apply "leave" to tt-fr-doc-line.unit-cli       in frame d-in-line.
    16038   if tt-fr-doc-line.doc-density      :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.doc-density     <> tt-fr-doc-line.doc-density    then apply "leave" to tt-fr-doc-line.doc-density    in frame d-in-line.
    16039   if tt-fr-doc-line.temperature      :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.temperature     <> tt-fr-doc-line.temperature    then apply "leave" to tt-fr-doc-line.temperature    in frame d-in-line.
    16040   if tt-fr-doc-line.cli-base-rate    :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.cli-base-rate   <> tt-fr-doc-line.cli-base-rate  then apply "leave" to tt-fr-doc-line.cli-base-rate  in frame d-in-line.
    16041   if tt-fr-doc-line.doc-qnty         :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.doc-qnty        <> tt-fr-doc-line.doc-qnty       then apply "leave" to tt-fr-doc-line.doc-qnty       in frame d-in-line.
    16042   if tt-fr-doc-line.fact-qnty        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.doc-qnty        <> tt-fr-doc-line.doc-qnty       then apply "leave" to tt-fr-doc-line.doc-qnty       in frame d-in-line.
    16043   if tt-fr-doc-line.unit-base        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.unit-base       <> tt-fr-doc-line.unit-base      then apply "leave" to tt-fr-doc-line.unit-base      in frame d-in-line.
    16044   if tt-fr-doc-line.fact-qnty        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.fact-qnty       <> tt-fr-doc-line.fact-qnty      then apply "leave" to tt-fr-doc-line.fact-qnty      in frame d-in-line.
    16045   if tt-fr-doc-line.vat-pc           :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.vat-pc          <> tt-fr-doc-line.vat-pc         then apply "leave" to tt-fr-doc-line.vat-pc         in frame d-in-line.
    16046   if tt-fr-doc-line.slt-pc           :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.slt-pc          <> tt-fr-doc-line.slt-pc         then apply "leave" to tt-fr-doc-line.slt-pc         in frame d-in-line.
    16047   if tt-fr-doc-line.price-cli        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.price-cli       <> tt-fr-doc-line.price-cli      then apply "leave" to tt-fr-doc-line.price-cli      in frame d-in-line.
    16048   if tt-fr-doc-line.tot-cli          :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.tot-cli         <> tt-fr-doc-line.tot-cli        then apply "leave" to tt-fr-doc-line.tot-cli        in frame d-in-line.
    16049   if tt-fr-doc-line.num-place        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.num-place       <> tt-fr-doc-line.num-place      then apply "leave" to tt-fr-doc-line.num-place      in frame d-in-line.
    16050   if tt-fr-doc-line.wt-brutto        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.wt-brutto       <> tt-fr-doc-line.wt-brutto      then apply "leave" to tt-fr-doc-line.wt-brutto      in frame d-in-line.
    16051   if tt-fr-doc-line.road-tax         :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.road-tax        <> tt-fr-doc-line.road-tax       then apply "leave" to tt-fr-doc-line.road-tax       in frame d-in-line.
    16052   if tt-fr-doc-line.excise           :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.excise          <> tt-fr-doc-line.excise         then apply "leave" to tt-fr-doc-line.excise         in frame d-in-line.
    16053   if road-tax-cli                    :sensitive in frame d-in-line and input frame d-in-line road-tax-cli                   <> road-tax-cli                  then apply "leave" to road-tax-cli                  in frame d-in-line.
    16054   if tt-fr-doc-line.last-date        :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.last-date       <> tt-fr-doc-line.last-date      then apply "leave" to tt-fr-doc-line.last-date      in frame d-in-line.
    16055   if tt-fr-doc-line.last-num-day     :sensitive in frame d-in-line and input frame d-in-line tt-fr-doc-line.last-num-day    <> tt-fr-doc-line.last-num-day   then apply "leave" to tt-fr-doc-line.last-num-day   in frame d-in-line.
    16056   define buffer bf-units-cli for ub.units.
    16057     if not (kind-check begins "light" and lookup('сер':U, tt-fr-doc-line.unit-type) > 0) and
    16058        (tt-fr-doc-line.cli-qnty = 0 or tt-fr-doc-line.cli-qnty = ?) and not t-doc.flag_ then do:
    16059       if kind-check <> "light-super" then
    16060          message "Не указано количество в единицах поставщика." view-as alert-box error.
    16061       if tt-fr-doc-line.cli-qnty:sensitive then apply "entry" to tt-fr-doc-line.cli-qnty in frame d-in-line.
    16062                                         else apply "entry" to b-quit               in frame d-in-line.
    16063       return error.
    16064     end.
    16065     if not (kind-check begins "light" and lookup('сер':U, tt-fr-doc-line.unit-type) > 0) and
    16066        (tt-fr-doc-line.doc-qnty = 0 or tt-fr-doc-line.doc-qnty = ?) and not t-doc.flag_ then do:
    16067       if kind-check <> "light-super" then
    16068       message "Не указано количество по накладной в учетных единицах." view-as alert-box error.
    16069       return error.
    16070     end.
    16071     if (tt-fr-doc-line.fact-qnty < 0 or tt-fr-doc-line.fact-qnty = ?) and t-doc.flag_ then do:
    16072       if kind-check <> "light-super" then
    16073       message "Неправильное факт. количество в учетных единицах." view-as alert-box error.
    16074       apply "entry" to tt-fr-doc-line.fact-qnty in frame d-in-line.
    16075       return error.
    16076     end.
    16077     if (tt-fr-doc-line.fact-qnty > tt-fr-doc-line.doc-qnty and
    16078         v-hold-doc = true  ) then do:
    16079       message "Данный документ был автоматически создан по перемещению от своей фирмы." skip
    16080               "Нельзя указывать фактическое количество больше документарного."
    16081       view-as alert-box error.
    16082       apply "entry" to tt-fr-doc-line.fact-qnty in frame d-in-line.
    16083       return error.
    16084     end.
    16085     find t-doc where recid( t-doc ) = pardoc-rec.
    16086     if t-doc.flag_ = yes                                          and
    16087        lookup( 'шту':U, tt-fr-doc-line.unit-type ) > 0          and
    16088        truncate( tt-fr-doc-line.fact-qnty, 0 ) <> tt-fr-doc-line.fact-qnty
    16089     then do:
    16090         message "Базовая единица товара " tt-fr-doc-line.unit-base " - штучная." skip
    16091                 "Кол-во по факту должно быть целым."
    16092         view-as alert-box error buttons ok.
    16093         return error.
    16094     end.
    16095     find bf-units-cli where bf-units-cli.unit-name = tt-fr-doc-line.unit-cli no-lock no-error.
    16096     if not available bf-units-cli then do:
    16097       message "Неправильная единица измерения." view-as alert-box error.
    16098       return error.
    16099     end.
    16100     if lookup('шту':U, bf-units-cli.type) > 0  and
    16101         trunc(tt-fr-doc-line.cli-qnty, 0) <> tt-fr-doc-line.cli-qnty then do:
    16102         message "Единица поставщика " tt-fr-doc-line.unit-cli " - штучная." skip
    16103                 "Должно быть указано целое количество в единицах поставщика."
    16104         view-as alert-box error buttons ok.
    16105         return error.
    16106     end.
    16107     release bf-units-cli.
    16108     if tt-fr-doc-line.cli-base-rate = 0 or tt-fr-doc-line.cli-base-rate = ? then do:
    16109       message "Не указан коэффициент пересчета единиц измерения." view-as alert-box error.
    16110       return error.
    16111     end.
    16112     if tt-fr-doc-line.unit-cli = tt-fr-doc-line.unit-base and tt-fr-doc-line.cli-base-rate <> 1 then do:
    16113       message "Коэффициент пересчета единиц измерения должен быть 1, т.к. единицы совпадают." view-as alert-box error.
    16114       return error.
    16115     end.
    16116     if lookup('шту':U, tt-fr-doc-line.unit-type) > 0           and
    16117        trunc(tt-fr-doc-line.doc-qnty, 0) <> tt-fr-doc-line.doc-qnty then do:
    16118        message "Базовая единица товара " tt-fr-doc-line.unit-base " - штучная." skip
    16119                "Кол-во по документу должно быть целым."
    16120        view-as alert-box error buttons ok.
    16121        return error.
    16122     end.
    16123     run gds-attr-value in this-procedure (input  buf_goods.gds-code
    16124                                            ,input 'null-price':U
    16125                                            ,output v-gds-null-price
    16126                                            ,output v-attr-type ) no-error .
    16127     if t-doc.status_ <> 'запрос':U and  not v-gds-null-price then do:
    16128       if tt-fr-doc-line.price-cli = 0 or tt-fr-doc-line.price-cli = ? then do:
    16129         message "Не указана цена в валюте поставщика." view-as alert-box error.
    16130         return error.
    16131       end.
    16132       if tt-fr-doc-line.price-base = 0 or tt-fr-doc-line.price-base = ? then do:
    16133         message "Не указана цена в базовой валюте." view-as alert-box error.
    16134         return error.
    16135       end.
    16136       if tt-fr-doc-line.price-rubl = 0 or tt-fr-doc-line.price-rubl = ? then do:
    16137         message "Не указана цена в рублях." view-as alert-box error.
    16138         return error.
    16139       end.
    16140     end.
    16141     if v-lgas-gds
    16142     then do :
    16143       assign tt-fr-doc-line.propan-perc cb-connect-hoses .
    16144       if tt-fr-doc-line.propan-perc <= 0
    16145       or tt-fr-doc-line.propan-perc >= 100
    16146       or tt-fr-doc-line.propan-perc = ?
    16147       then do :
    16148         message "Укажите массовую долю пропана в смеси, % из паспорта качества. Данная информация является обязательной!"
    16149         view-as alert-box .
    16150         return error .
    16151       end .
    16152       for first tt-doc-pl :
    16153         find first bf_place-attr no-lock where bf_place-attr.obj-type  = tt-doc-pl.obj-type
    16154                                            and bf_place-attr.obj-code  = tt-doc-pl.obj-code
    16155                                            and bf_place-attr.pl-code   = tt-doc-pl.pl-code
    16156                                            and bf_place-attr.attr-code = "place-gate-valve"
    16157                                            no-error .
    16158         if available bf_place-attr
    16159         and logical(bf_place-attr.attr-value)
    16160         then do :
    16161           if cb-connect-hoses = "empty"
    16162           then do :
    16163             message "Внимание! Укажите Подключение рукавов при приеме СУГ!"
    16164             view-as alert-box .
    16165             return error .
    16166           end .
    16167         end .
    16168       end .
    16169     end .
    16170   end procedure.
    16171   procedure check-price:
    16172     define variable p-same-price as  logical no-undo.
    16173     run trg/doclnupd.p ( input  tt-fr-doc-line.doc-code,
    16174                      input  t-doc.obj-type,
    16175                      input  t-doc.obj-code,
    16176                      input  tt-fr-doc-line.artic,
    16177                      input  tt-fr-doc-line.prod-type,
    16178                      input  tt-fr-doc-line.prod-code,
    16179                      output p-same-price) no-error.
    16180     if error-status :error then do:
    16181        message "Ошибка при просмотре учетных цен в партиях." view-as alert-box error.
    16182        display tt-fr-doc-line.price-rubl with frame d-in-line.
    16183        return error.
    16184     end.
    16185     if p-same-price = false then do:
    16186        message "Нельзя изменять цены в строке, т.к. имеются разные учетные в партиях."
    16187        view-as alert-box error.
    16188        return error.
    16189     end.
    16190   end procedure.
    16191   procedure delete-doc-line:
    16192   do transaction
    16193      on error   undo , return error
    16194      on end-key undo , return error
    16195      on stop    undo , return error :
    16196   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
    16197     (
    16198      input parparentproc
    16199     ,input ?
    16200     ,input ub.doc-line.doc-code
    16201     ,input ub.doc-line.artic
    16202     ,input ub.doc-line.prod-type
    16203     ,input ub.doc-line.prod-code
    16204     ,input ub.doc-line.price-cli
    16205     ,input ub.doc-line.price-rubl
    16206     ,input ub.doc-line.price-base
    16207     ,input ub.doc-line.cli-qnty
    16208     ,input ub.doc-line.cli-base-rate
    16209     ,input ub.doc-line.fact-qnty
    16210     ,input ub.doc-line.doc-qnty
    16211     ,input ub.doc-line.vat-pc
    16212     ,input ub.doc-line.slt-pc
    16213     ,input ub.doc-line.road-tax
    16214     ,input ub.doc-line.excise
    16215     ,input ub.doc-line.transport-rubl
    16216     ,input ub.doc-line.other-rubl
    16217     ,input 'delete'
    16218     ,input ''
    16219     ) no-error.
    16220   end.
    16221   end procedure.
    16222   procedure update-doc-line:
    16223   do transaction  on error   undo , return error
    16224      :
    16225      find ub.doc-line where recid(ub.doc-line) = line-rec.
    16226   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
    16227     (
    16228      input parparentproc
    16229     ,input recid(ub.doc-line)
    16230     ,input ub.doc-line.doc-code
    16231     ,input ub.doc-line.artic
    16232     ,input ub.doc-line.prod-type
    16233     ,input ub.doc-line.prod-code
    16234     ,input old-doc-line.price-cli
