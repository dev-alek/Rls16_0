    16674                                    ub.doc-line-attr.gds-code  = buf_goods.gds-code      and
    16675                                    ub.doc-line-attr.attr-code = "type-inp-vat"                   no-error.
    16676     if not available ub.doc-line-attr and
    16677        STRING(tt-fr-doc-line.type-inp-vat) <> ?    and
    16678        STRING(tt-fr-doc-line.type-inp-vat) <> ""   then do:
    16679        CREATE ub.doc-line-attr.
    16680        ASSIGN
