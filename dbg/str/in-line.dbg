    11280   function f-chekval RETURNS logical (input p-canval as char, input p-chkval as dec ):
    11281     def var i as int.
    11282     do i = 1 to num-entries(p-canval):
    11283       if round(decimal(entry(i,p-canval)),1) = round(p-chkval,1) then return true.
    11284     end.
    11285     return no.
    11286   end function.
    11287   FUNCTION chk-asi-polling RETURNS logical
    11288     ( is-bef as log ) :
    11289     def buffer bf_rvs-doc for ub.rvs-doc .
    11290     find first bf_rvs-doc no-lock
    11291       where bf_rvs-doc.rvs-type = (if is-bef then 'перед_док':U else 'после_док':U)
    11292         and bf_rvs-doc.out-code = t-doc.doc-code
    11293         and num-entries(bf_rvs-doc.rvs-code, "-") = 2
    11294         and bf_rvs-doc.state-measure-qnty <> ?
    11295         no-error .
    11296     if available (bf_rvs-doc) and not l-repeat-asi
    11297       then
    11298     do:
    11299       message
    11300         m-repeat-asi
    11301         view-as alert-box information title "".
    11302       return no .
    11303     end.
    11304     else return yes.
    11305   end.
