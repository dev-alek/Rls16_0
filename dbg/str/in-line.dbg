    16464       run alc-lib_get-new-part-code in this-procedure
    16465         (input  t-doc.obj-type
    16466         ,input  t-doc.obj-code
    16467         ,input  tt-fr-doc-line.prod-type
    16468         ,input  tt-fr-doc-line.prod-code
    16469         ,input  tt-fr-doc-line.artic
    16470         ,input  t-doc.doc-code
    16471         ,output v-part-code
    16472         ) no-error .
    16473       if error-status :error
    16474       then do:
    16475         message
    16476           vss-workfile vss-revision vss-description skip
    16477           "Ошибка при вызове процедуры alc-lib_get-new-part-code" skip
    16478           error-status :get-message(1) skip
    16479           return-value skip
    16480           view-as alert-box error .
    16481         undo, return error.
    16482       end.
    16483       assign
