     2070   procedure lineattr-delete-flora-all :
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2075       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
