     3988     define output parameter p-exist    as logical  no-undo .
     3989     do
     3990     on error undo, return error
     3991     :
     3992           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
     3993         (input  p-db-num
     3994         ,input  p-code
     3995         ,output p-exist
     3996         ) no-error .
     3997       if error-status :error
     3998       then do:
     3999         undo, return error return-value .
     4000       end.
     4001     end.
     4002   end procedure.
