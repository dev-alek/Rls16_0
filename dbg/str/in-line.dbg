    16516        ASSIGN
    16517        ub.doc-line-attr.doc-code  = t-doc.doc-code
    16518        ub.doc-line-attr.gds-code  = buf_goods.gds-code
    16519        ub.doc-line-attr.attr-code = "type-inp-vat".
    16520     end.
    16521     if available ub.doc-line-attr then ASSIGN ub.doc-line-attr.attr-value = STRING(tt-fr-doc-line.type-inp-vat).
    16522     find first ub.doc-line-attr where ub.doc-line-attr.doc-code  = t-doc.doc-code          and
    16523                                    ub.doc-line-attr.gds-code  = buf_goods.gds-code      and
    16524                                    ub.doc-line-attr.attr-code = "tot-cli"                   no-error.
    16525     if not available ub.doc-line-attr and
