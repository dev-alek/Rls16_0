    12419     or v-is-looksec
    12420     then
    12421       infoSectionsTotal:GetDBAllAttr().
    12422     empty temp-table tt-old-list-tank .
    12423     for each tmp_doc-line-attr no-lock where tmp_doc-line-attr.doc-code = t-doc.doc-code
    12424                                          and tmp_doc-line-attr.gds-code = buf_goods.gds-code
    12425                                          and tmp_doc-line-attr.attr-code begins "list-tank" :
    12426       create tt-old-list-tank .
    12427       buffer-copy tmp_doc-line-attr to tt-old-list-tank .
    12428     end .
    12429     infoSectionsTotal:PlChanged = no .
    12430     if not valid-object(tanksForm)
    12431     then
    12432       tanksForm = new ibs.th.str.ptrl.forms.tanksections(infoSectionsTotal).
    12433     wait-for tanksForm:ShowDialog().
    12434     if v-is-looksec
    12435     then do :
    12436       if parline-mode ne 'ПРОСМОТР':U
    12437       then
    12438          infoSectionsTotal:SaveDBNoCheck() .
    12439       infoSectionsTotal:WasSetting = true .
    12440     end .
    12441     if infoSectionsTotal:WasSetting = false
    12442     then infoSectionsTotal:GetDBAllAttr().
    12443     else do:
    12444       do ii = 1 to infoSectionsTotal:SectionNum :
    12445         infoSectionsTotal:GetInfoSectionProp (ii).
    12446         if infoSectionsTotal:FlagTrn = no
    12447         then do :
    12448           infoSectionsTotal:InfoSectionCurr:FactQnty = infoSectionsTotal:InfoSectionCurr:DocQnty.
    12449           infoSectionsTotal:InfoSectionCurr:FactDensity = infoSectionsTotal:InfoSectionCurr:DocDensity.
    12450         end .
