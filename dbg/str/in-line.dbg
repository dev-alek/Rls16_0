     3065   define variable vss-include-info30 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     3066     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     3067       define variable v-answ as logical no-undo .
     3068       if ( p-unit-base-cli-eq = true
     3069            and p-density = 1.0
     3070          )
     3071         or ( p-unit-base-cli-eq = false
     3072              and p-density <> ?
     3073              and p-density > 0.0
     3074              and p-density < 1.0
     3075            )
     3076       then do:
     3077         assign
     3078           v-answ = true
     3079         .
     3080       end.
     3081       else do:
     3082         assign
     3083           v-answ = false
     3084         .
     3085       end.
     3086       return v-answ.
     3087     end function.
     3088   procedure plgdsfnd :
     3089     define input  parameter p-chk-and-chs    as logical               no-undo .
     3090     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     3091     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     3092     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     3093     define output parameter p-reserv-pl-code as   logical             no-undo .
     3094     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     3095     define buffer buf_goods         for ub.goods .
     3096     define buffer buf_pl-gds        for ub.pl-gds .
     3097     define buffer buf_second_pl-gds for ub.pl-gds .
     3098     find first buf_goods no-lock where
     3099                buf_goods.gds-code = p-gds-code no-error .
     3100     if not available buf_goods
     3101     then do:
     3102       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     3103     end.
     3104   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     3106     (input  p-obj-type
     3107     ,input  p-obj-code
     3108     ,input  buf_goods.artic
     3109     ,input  buf_goods.prod-type
     3110     ,input  buf_goods.prod-code
     3111     ,input  'place-rsrv=request'
     3112     ,output p-reserv-pl-code
     3113     ) no-error .
     3114     if error-status :error
     3115     then do:
     3116       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     3117     end.
     3118     if p-reserv-pl-code = no
     3119     then do:
     3120       return .
     3121     end.
     3122     if p-chk-and-chs <> yes
     3123     then do:
     3124       return .
     3125     end.
     3126     find first buf_pl-gds no-lock where
     3127                buf_pl-gds.obj-type = p-obj-type and
     3128                buf_pl-gds.obj-code = p-obj-code and
     3129                buf_pl-gds.gds-code = p-gds-code no-error .
     3130     if not available buf_pl-gds
     3131     then do:
     3132       return error "К товару не привязано ни одного места хранения" .
     3133     end.
     3134     find first buf_second_pl-gds no-lock where
     3135                buf_second_pl-gds.obj-type  = p-obj-type          and
     3136                buf_second_pl-gds.obj-code  = p-obj-code          and
     3137                buf_second_pl-gds.gds-code  = p-gds-code          and
     3138                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     3139     if not available buf_second_pl-gds
     3140     then do:
     3141       assign
     3142         p-pl-code = buf_pl-gds.pl-code
     3143       .
     3144     end.
     3145     else do:
     3146       run str/plgdssel.p
     3147         (
     3148            input parparentproc
     3149         ,  input p-obj-type
     3150         ,  input p-obj-code
     3151         ,  input p-gds-code
     3152         , output p-pl-code
     3153         ) no-error .
     3154       if error-status :error
     3155       then do:
     3156         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     3157                                , 'plgdssel.p':U
     3158                                , chr(10)
     3159                                , error-status :get-message( 1 )
     3160                                , return-value
     3161                                ) .
     3162       end.
     3163       if p-pl-code = ? or
     3164          p-pl-code = 0
     3165       then do:
     3166         return error "Не выбрано место хранения " + chr(10) .
     3167       end.
     3168     end.
     3169   end procedure.
     3170     define new global shared variable g#lib-rvs as handle no-undo.
