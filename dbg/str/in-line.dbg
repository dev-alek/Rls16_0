    12452         then do :
    12453           pl-list = pl-list + "," + infoSectionsTotal:InfoSectionCurr:ListTank .
    12454         end .
    12455       end .
    12456       pl-list = trim(pl-list, ",") .
    12457       if infoSectionsTotal:PlChanged
    12458       then do :
    12459         for each tt-doc-pl :
    12460           delete tt-doc-pl .
    12461         end .
    12462       end .
    12463       infoSectionsTotal:CalculateTotal().
    12464       if not infoSectionsTotal:CliQntyInput then do:
    12465         tt-fr-doc-line.doc-density:screen-value = string (infoSectionsTotal:DocDensityAvg).
    12466         tt-fr-doc-line.doc-qnty:screen-value = string (infoSectionsTotal:DocQntyTotal).
    12467         if input frame d-in-line tt-fr-doc-line.doc-qnty <> tt-fr-doc-line.doc-qnty
    12468         then do:
    12469           assign
    12470             frame d-in-line tt-fr-doc-line.doc-qnty
    12471           .
