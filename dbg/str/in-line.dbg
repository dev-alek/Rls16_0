    16284   procedure disp-total:
    16285   define variable varprice-cli-dt                like ub.doc-line.price-rubl no-undo.
    16286   define variable varprice-cli-unit-base-dt      like ub.doc-line.price-rubl no-undo.
    16287   define variable varprice-road-tax-dt           like ub.doc-line.price-rubl no-undo.
    16288   define variable varprice-other-exp-dt          like ub.doc-line.price-rubl no-undo.
    16289   define variable varprice-transport-exp-dt      like ub.doc-line.price-rubl no-undo.
    16290   define variable varprice-without-abs-dt        like ub.doc-line.price-rubl no-undo.
    16291   define variable varprice-slt-dt                like ub.doc-line.price-rubl no-undo.
    16292   define variable varprice-no-slt-dt             like ub.doc-line.price-rubl no-undo.
    16293   define variable varprice-vat-dt                like ub.doc-line.price-rubl no-undo.
    16294   define variable varprice-no-vat-slt-dt         like ub.doc-line.price-rubl no-undo.
    16295   define variable varprice-rubl-dt               like ub.doc-line.price-rubl no-undo.
    16296   define variable varprice-road-tax-rubl-dt      like ub.doc-line.price-rubl no-undo.
    16297   define variable varprice-other-exp-rubl-dt     like ub.doc-line.price-rubl no-undo.
    16298   define variable varprice-transport-exp-rubl-dt like ub.doc-line.price-rubl no-undo.
    16299   define variable varprice-without-abs-rubl-dt   like ub.doc-line.price-rubl no-undo.
    16300   define variable varprice-slt-rubl-dt           like ub.doc-line.price-rubl no-undo.
    16301   define variable varprice-no-slt-rubl-dt        like ub.doc-line.price-rubl no-undo.
    16302   define variable varprice-vat-rubl-dt           like ub.doc-line.price-rubl no-undo.
    16303   define variable varprice-no-vat-slt-rubl-dt    like ub.doc-line.price-rubl no-undo.
    16304   define variable varprice-base-dt               like ub.doc-line.price-base no-undo.
    16305   define variable varprice-road-tax-base-dt      like ub.doc-line.price-base no-undo.
    16306   define variable varprice-other-exp-base-dt     like ub.doc-line.price-base no-undo.
    16307   define variable varprice-transport-exp-base-dt like ub.doc-line.price-base no-undo.
    16308   define variable varprice-without-abs-base-dt   like ub.doc-line.price-base no-undo.
    16309   define variable varprice-slt-base-dt           like ub.doc-line.price-base no-undo.
    16310   define variable varprice-no-slt-base-dt        like ub.doc-line.price-base no-undo.
    16311   define variable varprice-vat-base-dt           like ub.doc-line.price-base no-undo.
    16312   define variable varprice-no-vat-slt-base-dt    like ub.doc-line.price-base no-undo.
    16313     assign
    16314     tot-base = tt-fr-doc-line.price-base * (if t-doc.flag_ or t-doc.status_ = 'факт':U then tt-fr-doc-line.fact-qnty else tt-fr-doc-line.doc-qnty)
    16315     tot-rubl = tt-fr-doc-line.price-rubl * (if t-doc.flag_ or t-doc.status_ = 'факт':U then tt-fr-doc-line.fact-qnty else tt-fr-doc-line.doc-qnty).
    16316     display tot-rubl tot-base with frame d-in-line.
    16317     if tt-fr-doc-line.type-inp-sum = no then do:
    16318       assign
    16319         tt-fr-doc-line.tot-cli  = tt-fr-doc-line.cli-qnty   * tt-fr-doc-line.price-cli.
    16320       display tt-fr-doc-line.tot-cli with frame d-in-line.
    16321     end.
    16322     else do:
    16323       assign
    16324         tt-fr-doc-line.price-cli = tt-fr-doc-line.tot-cli / tt-fr-doc-line.cli-qnty.
    16325       display tt-fr-doc-line.tot-cli tt-fr-doc-line.price-cli with frame d-in-line.
    16326     end.
    16327   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
    16328     (
    16329      input   t-doc.doc-code
    16330     ,input   t-doc.base-rate
    16331     ,input   t-doc.base-scale
    16332     ,input   t-doc.exch-rate
    16333     ,input   t-doc.exch-scale
    16334     ,input   t-doc.vat-type
    16335     ,input   t-doc.slt-type
