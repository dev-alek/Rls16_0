    16766   procedure calc-vat-pc:
    16767     if tt-fr-doc-line.tot-cli:sensitive in frame d-in-line then do:
    16768       if  integer(tt-fr-doc-line.tot-cli:screen-value) <> 0
    16769       then do :
    16770           assign tt-fr-doc-line.vat-pc = (sum-vat / (tt-fr-doc-line.tot-cli
    16771                    * ( 1 - (if t-doc.slt-type = 'в т. ч.':U then (tt-fr-doc-line.slt-pc / (100 + tt-fr-doc-line.slt-pc)) else 0))
    16772                   - (if t-doc.vat-type =  'в т. ч.':U then sum-vat else 0))) * 100.
    16773           if tt-fr-doc-line.vat-pc = ? then
    16774           assign
    16775             tt-fr-doc-line.vat-pc = v-clcdoc-vat-pc
    16776             sum-vat = 0
    16777           .
    16778       end.
    16779     end.
    16780     else do:
    16781       assign tt-fr-doc-line.vat-pc = (sum-vat / (tt-fr-doc-line.cli-qnty * tt-fr-doc-line.price-cli
    16782                * ( 1 - (if t-doc.slt-type = 'в т. ч.':U then (tt-fr-doc-line.slt-pc / (100 + tt-fr-doc-line.slt-pc)) else 0))
    16783               - (if t-doc.vat-type =  'в т. ч.':U then sum-vat else 0))) * 100.
    16784       if tt-fr-doc-line.vat-pc = ? then tt-fr-doc-line.vat-pc = v-clcdoc-vat-pc.
    16785     end.
    16786     display tt-fr-doc-line.vat-pc sum-vat with frame d-in-line.
    16787   end procedure.
    16788   procedure cr-tt-fr-doc-line private:
    16789     define input parameter parmode        as character no-undo.
    16790     define input parameter parrecdoc-line as recid     no-undo.
    16791     define variable v-alcohol-prod        as logical   no-undo.
    16792     define variable v-alcohol-value       as character no-undo.
    16793     define variable v-alcohol-type        as character no-undo.
    16794     define variable v-new-price-sale      as decimal   no-undo.
