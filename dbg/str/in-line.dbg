     2865   procedure get-ptrl-prop :
     2866     define input  parameter p-obj-type as character no-undo .
     2867     define input  parameter p-obj-code as integer   no-undo .
     2868     do
     2869     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2870     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     2871     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     2872     :
     2873       define variable par-type          as character no-undo.
     2874       define variable v-value-character as character no-undo .
     2875       define variable v-value-date      as date      no-undo .
     2876       define variable v-value-decimal   as decimal   no-undo .
     2877       define variable v-value-integer   as integer   no-undo .
     2878       define variable v-value-logical   as logical   no-undo .
     2879       for each thbjattr_thbj-attr
     2880       :
