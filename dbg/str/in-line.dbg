     7609     do
     7610     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7611     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     7612     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     7613     :
     7614       define variable fh               as handle    no-undo .
     7615       define variable v-ok             as logical   no-undo .
     7616       define variable v-inform         as character no-undo .
     7617       define variable v-ind            as integer   no-undo .
     7618       define variable v-idx-field-qnty as integer   no-undo .
     7619       if p-tbl-name = ?
     7620         or p-tbl-name = "":U
     7621       then do:
     7622         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info41 ).
     7623       end.
     7624       if not p-bh_tbl-name:available then do:
     7625         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info41, p-tbl-name ).
     7626       end.
     7627       assign
     7628         p-key-rec = p-tbl-name
     7629         v-inform  = p-bh_tbl-name:index-information(1)
     7630         v-ind     = 2
     7631       .
     7632       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     7633       on error undo, return error
     7634       :
     7635         assign
     7636           v-inform = p-bh_tbl-name:index-information( v-ind )
     7637           v-ind    = v-ind + 1
     7638         .
     7639       end.
     7640       if v-inform = ?
     7641         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     7642         or entry( 3, v-inform, ",":U ) <> "1":U
     7643       then do:
     7644         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info41, p-tbl-name ).
     7645       end.
     7646       else do:
     7647         assign
     7648           v-idx-field-qnty = num-entries( v-inform ) - 4
     7649         .
     7650         if v-idx-field-qnty < 2 then do:
     7651           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, p-tbl-name ).
     7652         end.
     7653         do v-ind = 1 to v-idx-field-qnty by 2
     7654         on error undo, return error
     7655         :
     7656           assign
     7657             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     7658             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     7659           .
     7660         end.
     7661       end.
     7662       if p-key-rec = ? then do:
     7663         assign
     7664           p-key-rec = "":U
     7665         .
     7666         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info41, p-tbl-name ).
     7667       end.
     7668     end.
     7669     return.
     7670   end procedure.
     7671   procedure gen-where-keyr-tab :
     7672     define input  parameter i-tableSerach as character no-undo.
     7673     define input  parameter i-tablekey   as character  no-undo.
     7674     define input  parameter p-key-rec    as character  no-undo.
     7675     define input  parameter p-key-handle as handle     no-undo .
     7676     define input  parameter p-db-name    as character  no-undo .
     7677     define input  parameter p-tt-handle  as handle     no-undo .
     7678     define output parameter o-Where      as character  no-undo.
     7679     do
     7680     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7681     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     7682     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     7683     :
     7684       define variable v-full-tbl-name  as character no-undo .
     7685       define variable bh_tbl-name      as handle    no-undo .
     7686       define variable fh_key           as handle    no-undo .
     7687       define variable fh_search        as handle    no-undo .
     7688       define variable v-field-num      as integer   no-undo .
     7689       define variable v-count-fld      as integer   no-undo .
     7690       define variable v-inform         as character no-undo .
     7691       define variable v-ind            as integer   no-undo .
     7692       define variable v-idx-field-qnty as integer   no-undo .
     7693       define variable v-field-name     as character no-undo .
     7694       define variable v-field-val      as character no-undo .
     7695       define variable v-word-link      as character no-undo .
     7696       define variable vTable           as character no-undo.
     7697       define variable bh_tbl-key       as handle    no-undo .
     7698       assign
     7699         p-key-rec = trim( p-key-rec )
     7700       .
     7701       if p-key-handle <> ? then do:
     7702         if not valid-handle(p-key-handle)
     7703            or p-key-handle:type <> "buffer"
     7704         then do:
     7705           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info41 ).
     7706         end.
     7707         if num-entries( p-key-rec, chr(3) ) > 1
     7708           or p-key-rec = ?
     7709           or p-key-rec = "":U
     7710         then do:
     7711           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info41, p-key-rec ).
     7712         end.
     7713       end.
     7714       else do:
     7715         if p-key-rec = ?
     7716           or p-key-rec = "":U
     7717         then do:
     7718           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info41 ).
     7719         end.
     7720       end.
     7721       assign
     7722         vTable = entry( 1 , p-key-rec, chr(3) )
     7723       .
     7724       if p-tt-handle <> ?
     7725         and ( not valid-handle(p-tt-handle)
     7726               or p-tt-handle:type <> "buffer"
     7727             )
     7728       then do:
     7729         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info41, vTable, chr(10) ).
     7730       end.
     7731       if p-tt-handle = ? then do:
     7732         assign
     7733           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     7734         .
     7735         create buffer bh_tbl-name for table v-full-tbl-name .
     7736       end.
     7737       else do:
     7738         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     7739       end.
     7740       assign
     7741         v-inform = bh_tbl-name:index-information(1)
     7742         v-ind    = 2
     7743       .
     7744       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     7745       on error undo, return error
     7746       :
     7747         assign
     7748           v-inform = bh_tbl-name:index-information( v-ind )
     7749           v-ind    = v-ind + 1
     7750         .
     7751       end.
     7752       if v-inform = ?
     7753         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     7754         or entry( 3, v-inform, ",":U ) <> "1":U
     7755       then do:
     7756         delete object bh_tbl-name no-error.
     7757         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info41, vTable ).
     7758       end.
     7759       assign
     7760         v-idx-field-qnty = num-entries( v-inform ) - 4
     7761       .
     7762       if v-idx-field-qnty < 2 then do:
     7763         delete object bh_tbl-name no-error.
     7764         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, vTable ).
     7765       end.
     7766       assign
     7767         o-where     = "where":U
     7768         v-word-link = "":U
     7769         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     7770         v-count-fld = 0
     7771       .
     7772       if i-tablekey ne "" and i-tablekey ne ?
     7773       then do:
     7774         assign
     7775           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     7776         .
     7777         create buffer bh_tbl-key for table v-full-tbl-name .
     7778       end.
     7779       if i-tableSerach ne "" and i-tableSerach ne ?
     7780       then do:
     7781         delete object bh_tbl-name no-error.
     7782         assign
     7783           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     7784         .
     7785         create buffer bh_tbl-name for table v-full-tbl-name .
     7786       end.
     7787       block_where:
     7788       do v-ind = 1 to v-idx-field-qnty by 2
     7789       on error undo, return error
     7790       :
     7791         assign
     7792           v-count-fld = v-count-fld + 1
     7793         .
     7794         if p-key-handle = ?
     7795           and v-count-fld > v-field-num
     7796         then do:
     7797           leave block_where.
     7798         end.
     7799         define variable VfieldKeyTable as handle no-undo.
     7800         assign
     7801           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     7802           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     7803         .
     7804         if     bh_tbl-key ne ?
     7805         then do:
     7806            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     7807            if VfieldKeyTable eq ?
     7808            then next block_where.
     7809         end.
     7810         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     7811         then
     7812            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     7813         else
     7814            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     7815         if p-key-handle = ? then do:
     7816           assign
     7817             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     7818           .
     7819         end.
     7820         else do:
     7821           assign
     7822             fh_key = p-key-handle:buffer-field( v-field-name )
     7823           .
     7824           if fh_key = ?
     7825             or not valid-handle( fh_key )
     7826           then do:
     7827             delete object bh_tbl-name.
     7828             if     bh_tbl-key ne ?
     7829             then
     7830                delete object bh_tbl-key.
     7831             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info41, p-key-handle:name, v-field-name ).
     7832           end.
     7833           assign
     7834             v-field-val = fh_key:buffer-value
     7835           .
     7836         end.
     7837         if fh_search:data-type ="character":U then do:
     7838           assign
     7839             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     7840             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     7841             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     7842             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     7843             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     7844             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     7845             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     7846             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     7847             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     7848             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     7849             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     7850             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     7851             v-field-val = substitute( '"&1"', v-field-val )
     7852           .
     7853         end.
     7854         assign
     7855           o-where = substitute( "&1 &2", o-where, v-field-val )
     7856         .
     7857         if v-word-link = "":U then do:
     7858           assign
     7859             v-word-link = "and":U
     7860           .
     7861         end.
     7862       end.
     7863       delete object bh_tbl-name.
     7864       if     bh_tbl-key ne ?
     7865       then
     7866          delete object bh_tbl-key.
     7867       if p-key-handle = ?
     7868         and v-count-fld <> v-field-num
     7869       then do:
     7870         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info41, vTable ).
     7871       end.
     7872     end.
     7873   end procedure.
     7874   procedure gen-hn-keyr-tab :
     7875     define input  parameter i-tableSerach as character no-undo.
     7876     define input  parameter i-tablekey   as character no-undo.
     7877     define input  parameter p-key-rec    as character no-undo.
     7878     define input  parameter p-key-handle as handle    no-undo .
     7879     define input  parameter p-db-name    as character no-undo .
     7880     define input  parameter p-tt-handle  as handle    no-undo .
     7881     define input  parameter p-stts-lock  as integer   no-undo .
     7882     define output parameter o-hn         as handle    no-undo.
     7883     define variable v-full-tbl-name as character no-undo.
     7884     define variable v-where         as character no-undo.
     7885     define variable bh_tbl-name     as handle    no-undo.
     7886     define variable vTable          as character no-undo.
     7887     do
     7888     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7889     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     7890     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     7891         run gen-where-keyr-tab(i-tableSerach,
     7892                                i-tablekey,
     7893                                p-key-rec,
     7894                                p-key-handle,
     7895                                p-db-name,
     7896                                p-tt-handle,
     7897                                output v-where).
     7898         if i-tableSerach ne "" and i-tableSerach ne ?
     7899         then do:
     7900            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     7901            create buffer bh_tbl-name for table v-full-tbl-name .
     7902         end.
     7903         else do:
     7904            if p-tt-handle = ? then do:
     7905               assign
     7906                  vTable = entry( 1 , p-key-rec, chr(3) )
     7907               .
     7908               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     7909               create buffer bh_tbl-name for table v-full-tbl-name .
     7910            end.
     7911            else do:
     7912               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     7913            end.
     7914         end.
     7915         if p-tt-handle = ? then do:
     7916            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     7917         end.
     7918         else do:
     7919            bh_tbl-name:find-first( v-where ) no-error .
     7920         end.
     7921         o-hn = bh_tbl-name.
     7922      end.
     7923   end procedure.
     7924   procedure gen-hn-keyr :
     7925     define input  parameter p-key-rec    as character no-undo.
     7926     define input  parameter p-key-handle as handle    no-undo .
     7927     define input  parameter p-db-name    as character no-undo .
     7928     define input  parameter p-tt-handle  as handle    no-undo .
     7929     define input  parameter p-stts-lock  as integer   no-undo .
     7930     define output parameter o-hn         as handle    no-undo.
     7931     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     7932   end.
     7933   procedure gen-row-keyr :
     7934     define input  parameter p-key-rec    as character no-undo.
     7935     define input  parameter p-key-handle as handle    no-undo .
     7936     define input  parameter p-db-name    as character no-undo .
     7937     define input  parameter p-tt-handle  as handle    no-undo .
     7938     define input  parameter p-stts-lock  as integer   no-undo .
     7939     define output parameter p-tbl-row    as rowid     no-undo.
     7940     define output parameter p-tbl-name   as character no-undo.
     7941     define variable vHn as handle no-undo.
     7942       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     7943       p-tbl-row = if vHn:available then vHn:rowid else ?.
     7944       p-tbl-name =  vHn:table.
     7945       delete object vHn no-error.
     7946     if p-tbl-row = ? then do:
     7947       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info41, p-tbl-name, p-key-rec ).
     7948     end.
     7949     else do:
     7950       return.
     7951     end.
     7952   end procedure.
     7953   procedure gen-key-fv :
     7954     define input  parameter p-key-rec    as character no-undo .
     7955     define output parameter p-field-list as character no-undo .
     7956     define output parameter p-value-list as character no-undo.
     7957     do
     7958     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7959     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     7960     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     7961     :
     7962       define variable v-full-tbl-name  as character no-undo .
     7963       define variable bh_tbl-name      as handle    no-undo .
     7964       define variable v-tbl-name       as character no-undo .
     7965       define variable v-field-num      as integer   no-undo .
     7966       define variable v-count-fld      as integer   no-undo .
     7967       define variable v-inform         as character no-undo .
     7968       define variable v-ind            as integer   no-undo .
     7969       define variable v-idx-field-qnty as integer   no-undo .
     7970       define variable v-delim-key      as character no-undo .
     7971       if p-key-rec = ?
     7972         or p-key-rec = "":U
     7973       then do:
     7974         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info41 ).
     7975       end.
     7976       assign
     7977         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     7978         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     7979       .
     7980       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     7981       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info41 ).
     7982       assign
     7983         v-inform = bh_tbl-name:index-information(1)
     7984         v-ind    = 2
     7985       .
     7986       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     7987       on error undo, return error
     7988       :
     7989         assign
     7990           v-inform = bh_tbl-name:index-information( v-ind )
     7991           v-ind    = v-ind + 1
     7992         .
     7993       end.
     7994       if v-inform = ?
     7995         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     7996         or entry( 3, v-inform, ",":U ) <> "1":U
     7997       then do:
     7998         delete object bh_tbl-name no-error.
     7999         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info41, v-tbl-name ).
     8000       end.
     8001       assign
     8002         v-idx-field-qnty = num-entries( v-inform ) - 4
     8003       .
     8004       if v-idx-field-qnty < 2 then do:
     8005         delete object bh_tbl-name no-error.
     8006         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, v-tbl-name ).
     8007       end.
     8008       assign
     8009         p-field-list = "":U
     8010         p-value-list = "":U
     8011         v-delim-key  = "":U
     8012         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     8013         v-count-fld  = 0
     8014       .
     8015       block_where:
     8016       do v-ind = 1 to v-idx-field-qnty by 2
     8017       on error undo, return error
     8018       :
     8019         assign
     8020           v-count-fld = v-count-fld + 1
     8021         .
     8022         if v-count-fld > v-field-num then do:
     8023           leave block_where.
     8024         end.
     8025         assign
     8026           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     8027           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     8028         .
     8029         if v-ind = 1 then do:
     8030           assign
     8031             v-delim-key = chr(3)
     8032           .
     8033         end.
     8034       end.
     8035       delete object bh_tbl-name.
     8036       if v-count-fld <> v-field-num then do:
     8037         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info41, v-tbl-name ).
     8038       end.
     8039     end.
     8040   end procedure.
     8041   procedure gen-key-field :
     8042     define input  parameter p-table      as character no-undo .
     8043     define output parameter p-field-list as character no-undo .
     8044     do
     8045     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     8046     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     8047     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     8048     :
     8049       define variable v-full-tbl-name  as character no-undo .
     8050       define variable bh_tbl-name      as handle    no-undo .
     8051       define variable v-tbl-name       as character no-undo .
     8052       define variable v-field-num      as integer   no-undo .
     8053       define variable v-count-fld      as integer   no-undo .
     8054       define variable v-inform         as character no-undo .
     8055       define variable v-ind            as integer   no-undo .
     8056       define variable v-idx-field-qnty as integer   no-undo .
     8057       define variable v-delim-key      as character no-undo .
     8058       if p-table = ?
     8059         or p-table = "":U
     8060       then do:
     8061         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info41 ).
     8062       end.
     8063       assign
     8064         v-tbl-name      = p-table
     8065         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     8066       .
     8067       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     8068       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info41 ).
     8069       assign
     8070         v-inform = bh_tbl-name:index-information(1)
     8071         v-ind    = 2
     8072       .
     8073       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     8074       on error undo, return error
     8075       :
     8076         assign
     8077           v-inform = bh_tbl-name:index-information( v-ind )
     8078           v-ind    = v-ind + 1
     8079         .
     8080       end.
     8081       if v-inform = ?
     8082         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     8083         or entry( 3, v-inform, ",":U ) <> "1":U
     8084       then do:
     8085         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info41, v-tbl-name ).
     8086       end.
     8087       assign
     8088         v-idx-field-qnty = num-entries( v-inform ) - 4
     8089       .
     8090       if v-idx-field-qnty < 2 then do:
     8091         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info41, v-inform, v-tbl-name ).
     8092       end.
     8093       assign
     8094         p-field-list = "":U
     8095         v-delim-key  = "":U
     8096         v-count-fld  = 0
     8097       .
     8098       block_where:
     8099       do v-ind = 1 to v-idx-field-qnty by 2
     8100       on error undo, return error
     8101       :
     8102         assign
     8103           v-count-fld = v-count-fld + 1
     8104         .
     8105         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     8106         if v-ind = 1 then do:
     8107           assign
     8108             v-delim-key = chr(3)
     8109           .
     8110         end.
     8111       end.
     8112       delete object bh_tbl-name.
     8113     end.
     8114   end procedure.
     8115   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8116   PROCEDURE verify-ini-entry:
     8117   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     8118   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     8119   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     8120   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     8121   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     8122   define variable v-mess as character no-undo .
     8123   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     8124   if ini-entry-value = ? and ini-key-name begins "spl"
     8125   then
     8126   get-key-value section ini-section-name key "splall" value ini-entry-value.
     8127   if ini-entry-value = ? and ini-key-name begins "sav"
     8128   then
     8129   get-key-value section ini-section-name key "savall" value ini-entry-value.
     8130   if ini-entry-value = ? then do:
     8131     assign
     8132     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     8133                       , chr(10)
     8134                       , ini-section-name
     8135                       , ini-key-name
     8136                       , error-msg-text).
     8137       if not silence then do:
     8138         message
     8139         v-mess
     8140         view-as alert-box ERROR  .
     8141         return error.
     8142       end.
     8143       else do:
     8144         return error v-mess.
     8145       end.
     8146   end.
     8147   END PROCEDURE.
     8148   PROCEDURE verify-file:
     8149   DEFINE INPUT  PARAMETER filename       as character no-undo.
     8150   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     8151   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     8152   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     8153   file-info:file-name = filename.
     8154   found = NOT (file-info:full-pathname = ?).
     8155   if NOT found  then do:
     8156     if not silence then do:
     8157       message error-msg-text
     8158       view-as alert-box ERROR.
     8159       return error.
     8160     end.
     8161     else return error error-msg-text.
     8162   end.
     8163   END PROCEDURE.
     8164   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
