     2110   procedure lineattr-write-add-line-cli :
     2111   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2112   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2113   define input  parameter p-cli-type      as character no-undo .
     2114   define input  parameter p-cli-code      as integer   no-undo .
     2115   define input  parameter p-contract-code as integer   no-undo .
     2116   define input  parameter p-host-code     as integer   no-undo .
     2117   define input  parameter p-exch-code     as integer   no-undo .
     2118   define input  parameter p-exch-rate     as decimal   no-undo .
     2119   define input  parameter p-exch-scale    as integer   no-undo .
     2120   define input  parameter p-sum-cli       as decimal   no-undo .
     2121   define input  parameter p-sum-vat       as decimal   no-undo .
     2122   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       find first buf_doc-line-attr exclusive-lock
     2127         where buf_doc-line-attr.doc-code  = p-doc-code
     2128           and buf_doc-line-attr.gds-code  = p-gds-code
     2129           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2130                                             chr(4) + p-cli-type +
     2131                                             chr(4) + string(p-cli-code) +
     2132                                             chr(4) + string(p-contract-code) +
     2133                                             chr(4) + string(p-host-code)
     2134         no-error .
     2135       if not available buf_doc-line-attr then do:
     2136         create buf_doc-line-attr .
     2137         assign
     2138           buf_doc-line-attr.doc-code  = p-doc-code
     2139           buf_doc-line-attr.gds-code  = p-gds-code
     2140           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     2141                                         chr(4) + p-cli-type +
     2142                                         chr(4) + string(p-cli-code) +
     2143                                         chr(4) + string(p-contract-code) +
     2144                                         chr(4) + string(p-host-code)
     2145         .
     2146       end.
     2147       assign
     2148         buf_doc-line-attr.attr-value =
     2149         string(p-exch-code)  + chr(4) +
     2150         string(p-exch-rate)  + chr(4) +
     2151         string(p-exch-scale) + chr(4) +
     2152         string(p-sum-cli)    + chr(4) +
     2153         string(p-sum-vat)
     2154         .
     2155     end.
     2156   end procedure.
     2157   procedure lineattr-value-add-line-cli :
     2158   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2159   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2160   define input   parameter p-cli-type      as character no-undo .
     2161   define input   parameter p-cli-code      as integer   no-undo .
     2162   define input   parameter p-contract-code as integer   no-undo .
     2163   define input   parameter p-host-code     as integer   no-undo .
     2164   define output  parameter p-exch-code     as integer   no-undo .
     2165   define output  parameter p-exch-rate     as decimal   no-undo .
     2166   define output  parameter p-exch-scale    as integer   no-undo .
     2167   define output  parameter p-sum-cli       as decimal   no-undo .
     2168   define output  parameter p-sum-vat       as decimal   no-undo .
     2169   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       find first buf_doc-line-attr exclusive-lock
     2174         where buf_doc-line-attr.doc-code  = p-doc-code
     2175           and buf_doc-line-attr.gds-code  = p-gds-code
     2176           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2177                                             chr(4) + p-cli-type +
     2178                                             chr(4) + string(p-cli-code) +
     2179                                             chr(4) + string(p-contract-code) +
     2180                                             chr(4) + string(p-host-code)
     2181         no-error .
     2182       if available buf_doc-line-attr then do:
     2183        assign
     2184           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     2185           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     2186           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     2187           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     2188           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     2189          .
     2190        end.
     2191     end.
     2192   end procedure.
     2193   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     2194     define variable v-code as character no-undo .
     2195     define variable v-type as character no-undo .
     2196     define variable v-gds-code as integer   no-undo .
     2197   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2199     (input  local-doc-line.artic
     2200     ,input  local-doc-line.prod-type
     2201     ,input  local-doc-line.prod-code
     2202     ,output v-gds-code
     2203     )  .
     2204     run lineattr-value (
     2205         input   local-doc-line.doc-code ,
     2206         input   v-gds-code              ,
     2207         input   'reason-code':U ,
     2208         output  v-code                  ,
     2209         output  v-type ) .
     2210     find first ub.trn-reason no-lock where
     2211                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     2212     if not available ub.trn-reason then do:
     2213        return "" .
     2214     end.
     2215     else do:
     2216        return ub.trn-reason.reason-name .
     2217     end.
     2218   end function.
     2219   procedure lineattr-value-parts :
     2220     do
     2221     on error undo, return error return-value
     2222     :
     2223       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2224       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
