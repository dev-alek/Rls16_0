    19009                                                               and buf_c-pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19010                                                               and buf_c-pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19011                                                               and buf_c-pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19012                                                               and buf_c-pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
