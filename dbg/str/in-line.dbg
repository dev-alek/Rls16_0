     2413   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2414   function octal-to-char return character
     2415   ( p-string as character ) :
     2416     def var v-asc     as integer no-undo .
     2417     def var v-new-asc as integer no-undo .
     2418     def var ind       as integer no-undo .
     2419     if length(p-string) <> 3 then do:
     2420       return ? .
     2421     end.
     2422     assign
     2423       v-asc = 0
     2424     .
     2425     do ind = 1 to length(p-string)
     2426     :
     2427       assign
     2428         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2429       .
     2430       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2431         return ? .
     2432       end.
     2433       assign
     2434         v-asc = v-asc * 8 + v-new-asc
     2435       .
     2436     end.
     2437     return chr(v-asc) .
     2438   end function .
     2439   function char-to-octal return character
     2440   ( p-chr as character ) :
     2441     def var v-asc    as integer   no-undo .
     2442     def var ind      as integer   no-undo .
     2443     def var v-string as character no-undo .
     2444     if length(p-chr) <> 1 then do:
     2445       return ? .
     2446     end.
     2447     assign
     2448       v-asc    = asc(p-chr)
     2449       v-string = ""
     2450     .
     2451     do ind = 1 to 3
     2452     :
     2453       assign
     2454         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2455       .
     2456       assign
     2457         v-asc = truncate(v-asc / 8, 0)
     2458       .
     2459     end.
     2460     return v-string .
     2461   end.
     2462   function str-encode return character
     2463   (   p-init-string       as character
     2464     , p-encode-char       as character
     2465     , p-special-char-list as character
     2466   ) :
     2467     def var p-encode-string as character no-undo .
     2468     def var ind                as integer no-undo .
     2469     def var v-num-special-char as integer no-undo .
     2470     def var v-special-char     as character no-undo .
     2471     if p-encode-char = ?
     2472     or p-encode-char = "" then do:
     2473       assign
     2474         p-encode-char = "~~"
     2475       .
     2476     end.
     2477     if p-init-string = ? then do:
     2478       return "?" .
     2479     end.
     2480     if p-init-string = "?" then do:
     2481       return p-encode-char + char-to-octal("?") .
     2482     end.
     2483     assign
     2484       v-num-special-char = length(p-special-char-list)
     2485       p-encode-string    = replace(p-init-string
     2486                                   ,p-encode-char
     2487                                   ,p-encode-char + char-to-octal(p-encode-char)
     2488                                   )
     2489     .
     2490     do ind = 1 to v-num-special-char
     2491     :
     2492       assign
     2493         v-special-char = substring(p-special-char-list, ind, 1)
     2494       .
     2495       if v-special-char <> p-encode-char then do:
     2496         assign
     2497           p-encode-string = replace (p-encode-string
     2498                                     ,v-special-char
     2499                                     ,p-encode-char + char-to-octal(v-special-char)
     2500                                     )
     2501         .
     2502       end.
     2503     end.
     2504     return p-encode-string .
     2505   end.
     2506   function str-decode returns character
     2507     (p-init-string   as character
     2508     ,p-encode-char   as character
     2509     ) :
     2510     def var p-decode-string as character no-undo .
     2511     def var ind                       as integer no-undo .
     2512     def var v-num-entries-init-string as integer no-undo .
     2513     def var v-sub-phrase              as character no-undo .
     2514     def var v-special-char            as character no-undo .
     2515     if p-encode-char = ?
     2516     or p-encode-char = "" then do:
     2517       assign
     2518         p-encode-char = "~~"
     2519       .
     2520     end.
     2521     if p-init-string = "?" then do:
     2522       return ? .
     2523     end.
     2524     assign
     2525       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2526     .
     2527     if v-num-entries-init-string > 1 then do:
     2528       assign
     2529         p-decode-string = entry(1, p-init-string, p-encode-char)
     2530       .
     2531       do ind = 2 to v-num-entries-init-string
     2532       :
     2533         assign
     2534           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2535         .
     2536         assign
     2537           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2538         .
     2539         if v-special-char <> ? then do:
     2540           assign
     2541             p-decode-string = p-decode-string
     2542                             + v-special-char
     2543                             + substring(v-sub-phrase, 4)
     2544           .
     2545         end.
     2546         else do:
     2547           assign
     2548             p-decode-string = p-decode-string
     2549                             + p-encode-char
     2550                             + v-sub-phrase
     2551           .
     2552         end.
     2553       end.
     2554     end.
     2555     else do:
     2556       assign
     2557         p-decode-string = p-init-string
     2558       .
     2559     end.
     2560     return p-decode-string .
     2561   end.
     2562   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2563   procedure integerm :
     2564     define input  parameter p-string      as character no-undo .
     2565     define input  parameter p-allow-sign  as logical   no-undo .
     2566     define input  parameter p-allow-comma as logical   no-undo .
     2567     define output parameter p-value       as integer   no-undo .
     2568     define output parameter p-data-valid  as logical   no-undo .
     2569     define output parameter p-message     as character no-undo .
     2570     define variable v-replace-string as character no-undo .
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       if p-string = ?
     2575       then do:
     2576         assign
     2577           p-value      = ?
     2578           p-data-valid = false
     2579           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
     2580         .
     2581         return .
     2582       end.
     2583       if p-string = ""
     2584       then do:
     2585         assign
     2586           p-value      = ?
     2587           p-data-valid = false
     2588           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
     2589         .
     2590         return .
     2591       end.
     2592       assign
     2593         p-value = integer(p-string) no-error
     2594       .
     2595       if error-status :error = true
     2596       then do:
     2597         assign
     2598           p-value      = ?
     2599           p-data-valid = false
     2600           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
     2601                                    ,p-string
     2602                                    )
     2603         .
     2604         return .
     2605       end.
     2606       if index(p-string, ' ':u) > 0
     2607       then do:
     2608         assign
     2609           p-value      = ?
     2610           p-data-valid = false
     2611           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2612                                    + "Строка содержит символы пробела"
     2613                                    ,p-string
     2614                                    )
     2615         .
     2616         return .
     2617       end.
     2618       assign
     2619         v-replace-string = p-string
     2620         v-replace-string = replace(v-replace-string, '0':u, '9':u)
     2621         v-replace-string = replace(v-replace-string, '1':u, '9':u)
     2622         v-replace-string = replace(v-replace-string, '2':u, '9':u)
     2623         v-replace-string = replace(v-replace-string, '3':u, '9':u)
     2624         v-replace-string = replace(v-replace-string, '4':u, '9':u)
     2625         v-replace-string = replace(v-replace-string, '5':u, '9':u)
     2626         v-replace-string = replace(v-replace-string, '6':u, '9':u)
     2627         v-replace-string = replace(v-replace-string, '7':u, '9':u)
     2628         v-replace-string = replace(v-replace-string, '8':u, '9':u)
     2629       .
     2630       if p-allow-sign = true
     2631       then do:
     2632         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
     2633         then do:
     2634           assign
     2635             v-replace-string = substring(v-replace-string, 2)
     2636           .
     2637         end.
     2638       end.
     2639       else do:
     2640         if substring(v-replace-string, 1, 1) = '+':u
     2641         then do:
     2642           assign
     2643             p-value      = ?
     2644             p-data-valid = false
     2645             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2646                                     + "Задан параметр недопустимости знака челого числа. "
     2647                                     + "Строка содержит символ плюс. "
     2648                                     ,p-string
     2649                                     )
     2650           .
     2651           return .
     2652         end.
     2653         if substring(v-replace-string, 1, 1) = '-':u
     2654         then do:
     2655           assign
     2656             p-value      = ?
     2657             p-data-valid = false
     2658             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2659                                     + "Задан параметр недопустимости знака челого числа. "
     2660                                     + "Строка содержит символ минус. "
     2661                                     ,p-string
     2662                                     )
     2663           .
     2664           return .
     2665         end.
     2666       end.
     2667       if p-allow-comma = true
     2668       then do:
     2669         assign
     2670           v-replace-string = replace(v-replace-string, ',', '')
     2671         .
     2672       end.
     2673       else do:
     2674         if index(v-replace-string, ',') > 0
     2675         then do:
     2676           assign
     2677             p-value      = ?
     2678             p-data-valid = false
     2679             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2680                                     + "Задан параметр недопустимости знака разделителя тысяч."
     2681                                     + "Строка содержит знак разделителя тысяч. "
     2682                                     ,p-string
     2683                                     )
     2684           .
     2685           return .
     2686         end.
     2687       end.
     2688       if index(p-string, '.') > 0
     2689       then do:
     2690         assign
     2691           p-value      = ?
     2692           p-data-valid = false
     2693           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2694                                    + "Строка содержит знак десятичной точки"
     2695                                    ,p-string
     2696                                    )
     2697         .
     2698         return .
     2699       end.
     2700       if v-replace-string <> fill('9', length(v-replace-string))
     2701       then do:
     2702         assign
     2703           p-value      = ?
     2704           p-data-valid = false
     2705           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
     2706                                    + "Встречены символы, недопустимые для целого числа '&2'"
     2707                                    ,p-string
     2708                                    ,replace(v-replace-string, '9', '')
     2709                                    )
     2710         .
     2711         return .
     2712       end.
     2713       assign
     2714         p-data-valid = true
     2715         p-message    = ""
     2716       .
     2717     end.
     2718   end procedure.
     2719   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2720   procedure alc-lib_mark-name :
     2721     define input  parameter p-mark-db-num   as integer   no-undo .
     2722     define input  parameter p-mark-code     as integer   no-undo .
     2723     define output parameter p-mark-name     as character no-undo .
     2724     define buffer buf_ex-mark for ub.ex-mark .
     2725     do
     2726     on error undo, return error return-value
     2727     :
     2728       if p-mark-db-num = ?
     2729       or p-mark-code   = ?
     2730       then do:
     2731         assign
     2732           p-mark-name = '?':u
     2733         .
     2734         return .
     2735       end.
     2736       if  p-mark-db-num = 0
     2737       and p-mark-code   = 0
     2738       then do:
     2739         assign
     2740           p-mark-name = ""
     2741         .
     2742         return .
     2743       end.
     2744       find first buf_ex-mark no-lock
     2745         where buf_ex-mark.db-num    = p-mark-db-num
     2746           and buf_ex-mark.mark-code = p-mark-code
     2747         no-error .
     2748       if available buf_ex-mark
     2749       then do:
     2750         assign
     2751           p-mark-name = substitute('&1':u
     2752                                   ,buf_ex-mark.mark-name
     2753                                   )
     2754         .
     2755       end.
     2756     end.
     2757   end procedure.
     2758   procedure alc-lib_get-new-part-code :
     2759     define input  parameter p-obj-type       as character no-undo .
     2760     define input  parameter p-obj-code       as integer   no-undo .
     2761     define input  parameter p-prod-type      as character no-undo .
     2762     define input  parameter p-prod-code      as integer   no-undo .
     2763     define input  parameter p-artic          as character no-undo .
     2764     define input  parameter p-doc-code       as character no-undo .
     2765     define output parameter p-new-part-code  as character no-undo .
     2766     define variable v-cur-part-code as integer no-undo.
     2767     define variable v-max-part-code as integer no-undo.
     2768     define variable i               as integer no-undo.
     2769     define buffer bf_parts for ub.parts .
     2770     do
     2771     on error undo, return error return-value
     2772     :
     2773       assign
     2774         v-max-part-code = 0
     2775       .
     2776       for each bf_parts no-lock
     2777             where bf_parts.obj-type  = p-obj-type  and
     2778                   bf_parts.obj-code  = p-obj-code  and
     2779                   bf_parts.prod-type = p-prod-type and
     2780                   bf_parts.prod-code = p-prod-code and
     2781                   bf_parts.artic     = p-artic     and
     2782                   bf_parts.out-code  = p-doc-code
     2783         :
     2784         assign
     2785           v-cur-part-code = integer(bf_parts.part-code)
     2786           no-error.
     2787         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     2788           assign
     2789             v-max-part-code = v-cur-part-code
     2790           .
     2791         end.
     2792       end.
     2793       assign
     2794         p-new-part-code = string (v-max-part-code + 1)
     2795       .
     2796     end.
     2797   end procedure.
     2798   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
