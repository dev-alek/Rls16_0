    16667     then do:
    16668       tt-fr-doc-line.fact-qnty:screen-value in frame d-in-line = fq.
    16669       assign
    16670         tt-fr-doc-line.fact-qnty.
    16671       t-doc.flag_ = true.
    16672   if not t-doc.flag_ then do:
