    16485       .
    16486     end.
    16487     if v-edit-fact-wayb
    16488     then do:
    16489       fq = tt-fr-doc-line.fact-qnty:screen-value in frame d-in-line.
    16490     end.
    16491     def var ndq as character no-undo.
    16492     if v-edit-fact-wayb and not t-doc.flag_
    16493     then do:
    16494       t-doc.flag_ = true.
    16495       ndq = tt-fr-doc-line.doc-qnty:screen-value in frame d-in-line.
    16496       tt-fr-doc-line.fact-qnty:screen-value in frame d-in-line = string (dec (cq) * tt-fr-doc-line.cli-base-rate).
    16497       tt-fr-doc-line.cli-qnty:screen-value in frame d-in-line = cq.
    16498       assign
    16499         tt-fr-doc-line.fact-qnty
    16500         tt-fr-doc-line.cli-qnty
    16501         .
    16502       run calc-all in this-procedure
