     9156   function getCalibrationBelt returns character
     9157     (
     9158     input iObjType as character,
     9159     input iObjCode as integer,
     9160     input iPlCode  as integer,
     9161     input iLevelNP as decimal,
     9162     input iLevelWater as decimal
     9163     )
     9164   :
     9165     define variable vCalibBelt      as  character         no-undo.
     9166     define buffer   buf_pl-level-mm for ub.pl-level-mm.
     9167     for each buf_pl-level-mm where
     9168              buf_pl-level-mm.obj-type = iObjType
     9169          and buf_pl-level-mm.obj-code = iObjCode
     9170          and buf_pl-level-mm.pl-code  = iPlCode
     9171          and ((buf_pl-level-mm.min-level <= iLevelNP and buf_pl-level-mm.max-level >= iLevelNP) or
     9172               (buf_pl-level-mm.min-level <= iLevelWater and buf_pl-level-mm.max-level >= iLevelWater))
     9173         no-lock
     9174         break by buf_pl-level-mm.zone by buf_pl-level-mm.level:
     9175       if first-of(buf_pl-level-mm.zone) then do:
     9176         vCalibBelt = substitute("&1&2;&3=",vCalibBelt, buf_pl-level-mm.min-level,buf_pl-level-mm.max-level).
     9177       end.
     9178       vCalibBelt = substitute("&1&2&3",vCalibBelt, if buf_pl-level-mm.level = 1 then "" else ";", trim(string(buf_pl-level-mm.capacity / 1000, ">>>>>9.999"))).
     9179       if last-of(buf_pl-level-mm.zone) and not last(buf_pl-level-mm.zone) then
     9180         vCalibBelt = substitute("&1&2",vCalibBelt, chr(10)).
     9181     end.
     9182     return vCalibBelt.
     9183   end.
