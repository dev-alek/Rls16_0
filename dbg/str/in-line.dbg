     5546                         ,input "Запускается программа для обращения к датчикам резервуаров|Берутся уже сохраненные данные из файла|Ничего не делаем"
     5547                         ,input 1
     5548                         ,input 3
     5549                         ,output varnum
     5550                         ) .
     5551                       case varnum :
     5552                         when 1 then do:
     5553                           assign
     5554                             varcur-rvs = 1
     5555                           .
     5556                         end.
     5557                         when 2  then do:
     5558                           assign
     5559                             varcur-rvs = 0
     5560                           .
     5561                         end.
     5562                         when 3 then do:
     5563                           assign
     5564                             varcur-rvs = 3
     5565                           .
     5566                         end.
     5567                       end case.
     5568                     end.
     5569                     else do:
     5570                       assign
     5571                         varcur-rvs = 1
     5572                       .
     5573                     end.
     5574                   end .
     5575                   if varcur-rvs <> 3
     5576                   then do :
     5577                     if varcur-rvs = 1
     5578                     or ptoldfilvalue <> "yes":u
     5579                     then do :
     5580   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              parParentProc ,
     5581                         input              t-doc.obj-type ,
     5582                         input              t-doc.obj-code ,
     5583                         input              yes ,
     5584                         input-output table tt-pump-nozzle-file ,
     5585                         input-output table tt-pump-nozzle ,
     5586                         input              yes ,
     5587                         input              ? ,
     5588                         input              no) no-error .
     5589                     end.
     5590                     else do :
     5591   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              parParentProc ,
     5592                         input              t-doc.obj-type ,
     5593                         input              t-doc.obj-code ,
     5594                         input              yes ,
     5595                         input-output table tt-pump-nozzle-file ,
     5596                         input-output table tt-pump-nozzle ,
     5597                         input              no ,
     5598                         input              ? ,
     5599                         input              no) no-error .
     5600                     end.
     5601                     for each tt-pump-nozzle :
     5602                       find first tt-pump-nozzle-file where
     5603                                  tt-pump-nozzle-file.obj-type    = tt-pump-nozzle.obj-type    and
     5604                                  tt-pump-nozzle-file.obj-code    = tt-pump-nozzle.obj-code    and
     5605                                  tt-pump-nozzle-file.pump-code   = tt-pump-nozzle.pump-code   and
     5606                                  tt-pump-nozzle-file.nozzle-code = tt-pump-nozzle.nozzle-code no-error .
     5607                       if available tt-pump-nozzle-file
     5608                       then
     5609                       assign
     5610                         tt-pump-nozzle.meas-el-cnt = tt-pump-nozzle-file.meas-el-cnt
     5611                         tt-pump-nozzle.meas-am-cnt = tt-pump-nozzle-file.meas-am-cnt
     5612                         tt-pump-nozzle.meas-cf-cnt = tt-pump-nozzle-file.meas-cf-cnt
     5613                       .
     5614                     end.
     5615                     for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.obj-type = buf_rvs-line.obj-type
     5616                                                          and buf_rvs-line-pump.obj-code = buf_rvs-line.obj-code
     5617                                                          and buf_rvs-line-pump.rvs-code = buf_rvs-line.rvs-code
     5618                                                          and buf_rvs-line-pump.pl-code  = buf_rvs-line.pl-code
     5619                                                          and buf_rvs-line-pump.gds-code = buf_rvs-line.gds-code
     5620                     :
     5621   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_fill1pmp in g#lib-rvs ( input       recid( buf_rvs-line-pump ) ,
     5622                         input table tt-pump-nozzle )  .
     5623                     end .
     5624                   end .
     5625                   for each buf_rvs-line-pump exclusive-lock where buf_rvs-line-pump.obj-type = buf_rvs-line.obj-type
     5626                                                               and buf_rvs-line-pump.obj-code = buf_rvs-line.obj-code
     5627                                                               and buf_rvs-line-pump.rvs-code = buf_rvs-line.rvs-code
     5628                                                               and buf_rvs-line-pump.pl-code  = buf_rvs-line.pl-code
     5629                                                               and buf_rvs-line-pump.gds-code = buf_rvs-line.gds-code
     5630                   :
     5631                     assign
     5632                       buf_rvs-line-pump.state-el-cnt    = 0 when buf_rvs-line-pump.state-el-cnt = ?
     5633                       buf_rvs-line-pump.state-mh-cnt    = 0 when buf_rvs-line-pump.state-mh-cnt = ?
     5634                     .
     5635                   end .
     5636                 end .
     5637               end.
     5638               if error-status :error then do:
     5639                 message
     5640                   "Ошибка при редактировании строки сверки." skip
     5641                   return-value skip
     5642                   error-status :get-message(1) skip
     5643                   view-as alert-box error .
     5644                 undo block_tr, return error .
     5645               end.
     5646               if return-value = "cancel":U
     5647                 and p-action <> 'ПРОСМОТР':U
     5648               then do:
     5649                 undo block_tr, return error .
     5650               end.
     5651             end.
     5652           end case.
     5653           if not p-action = 'ПРОСМОТР':U
     5654           then do :
     5655             find first buf_place no-lock
     5656                 where buf_place.obj-type = t-doc.obj-type
     5657                   and buf_place.obj-code = t-doc.obj-code
     5658                   and buf_place.pl-code  = p-pl-code
     5659               .
     5660             do ii = 1 to infoSectionsTotal:SectionNum :
     5661               infoSectionsTotal:GetInfoSectionProp(ii).
     5662               if infoSectionsTotal:InfoSectionCurr:ListTank <> buf_place.loc1 then next .
     5663               if p-rvs-type = 'перед_док':U
     5664               then do:
     5665                 infoSectionsTotal:InfoSectionCurr:DateStart = v-prt-start-real-date .
     5666                 infoSectionsTotal:InfoSectionCurr:TimeStart = v-prt-start-real-time .
     5667               end .
     5668               else do :
     5669                 infoSectionsTotal:InfoSectionCurr:DateEnd   = v-prt-end-real-date .
     5670                 infoSectionsTotal:InfoSectionCurr:TimeEnd   = v-prt-end-real-time .
     5671               end .
     5672               infoSectionsTotal:InfoSectionCurr:TankWeightRvs = ? .
     5673               infoSectionsTotal:InfoSectionCurr:TankVolPomiRvs = ? .
     5674               infoSectionsTotal:InfoSectionCurr:AvgTempRvs = ? .
     5675             end.
     5676           infoSectionsTotal:SaveDB().
     5677           end .
     5678           run placelib_get-attr(input "place-virtual"
     5679                                ,input t-doc.obj-code
     5680                                ,input t-doc.obj-type
     5681                                ,input p-pl-code
     5682                                ,output v-value
     5683                                ,output v-ok) no-error.
     5684           is-vir = if (v-ok and logical(v-value)) then true else false.
     5685           if not is-gas(buf_goods.gds-code)
     5686           and not is-vir then do:
     5687               if not available buf_rvs-line
     5688               then do :
     5689                 find first buf_rvs-line exclusive-lock
     5690                 where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     5691                   and buf_rvs-line.obj-type = t-doc.obj-type
     5692                   and buf_rvs-line.obj-code = t-doc.obj-code
     5693                   and buf_rvs-line.pl-code  = p-pl-code
     5694                   and buf_rvs-line.gds-code = buf_goods.gds-code
     5695                 .
     5696               end .
     5697               if p-action = 'ИЗМЕНЕНИЕ':U then do:
     5698                 if p-action-type = "meas":U then do:
     5699   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclcln in g#lib-rvs ( input recid(buf_rvs-line) ) no-error .
     5700                   if error-status :error then do:
     5701                     message
     5702                       "Ошибка при пересчете строки документа сверки." skip
     5703                       return-value skip
     5704                       error-status :get-message(1) skip
     5705                       view-as alert-box error .
     5706                     undo block_tr, return error .
     5707                   end.
     5708                 end.
     5709   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_rvsclchd in g#lib-rvs ( input recid(buf_rvs-doc) ,
     5710                         input false ) no-error .
     5711                 if error-status :error then do:
     5712                   message
     5713                     "Ошибка при пересчете документа сверки." skip
     5714                     return-value skip
     5715                     error-status :get-message(1) skip
     5716                     view-as alert-box error .
     5717                   undo block_tr, return error .
     5718                 end.
     5719                 run return-rvs-qnty in this-procedure
     5720                   ( input t-doc.doc-code
     5721                    ,input buf_goods.gds-code
     5722                    ,input p-pl-code
     5723                    ,output v-rvs-qnty-before
     5724                    ,output v-rvs-qnty-after
     5725                    ,output v-rvs-cli-qnty-before
     5726                    ,output v-rvs-cli-qnty-after
     5727                    ,output v-delta-mass-qnty
     5728                    ,output v-trk-err
     5729                   ) no-error .
     5730                 if error-status :error then do:
     5731                   undo block_tr, return error return-value .
     5732                 end.
     5733                 run placelib_get-attr  (
     5734                    input "place-com-tanks"
     5735                   ,input t-doc.obj-code
     5736                   ,input t-doc.obj-type
     5737                   ,input p-pl-code
     5738                   ,output v-value
     5739                   ,output v-ok      )
     5740                 no-error.
     5741                 if v-ok
     5742                 and v-value > ""
     5743                 then do :
     5744                   do ii = 1 to num-entries(v-value) :
     5745                     find first buf_place no-lock where buf_place.obj-type = t-doc.obj-type
     5746                                                    and buf_place.obj-code = t-doc.obj-code
     5747                                                    and buf_place.loc1     = entry(ii, v-value)
     5748                                                    and buf_place.status_  = ""
     5749                                                    no-error .
     5750                     if available buf_place
     5751                     then do :
     5752                       run return-rvs-qnty in this-procedure
     5753                         ( input t-doc.doc-code
     5754                          ,input buf_goods.gds-code
     5755                          ,input buf_place.pl-code
     5756                          ,output v-com-tank-rvs-qnty-before
     5757                          ,output v-com-tank-rvs-qnty-after
     5758                          ,output v-com-tank-rvs-cli-qnty-before
     5759                          ,output v-com-tank-rvs-cli-qnty-after
     5760                          ,output v-com-tank-delta-mass-qnty
     5761                          ,output v-trk-err
     5762                         ) no-error .
     5763                       if error-status :error then do:
     5764                         undo block_tr, return error return-value .
     5765                       end.
     5766                       if v-com-tank-rvs-qnty-after = ?
     5767                       then do :
     5768                         assign
     5769                           v-com-tank-rvs-qnty-after = 0
     5770                           v-com-tank-rvs-cli-qnty-after = 0
     5771                           v-com-tanks-not-filled = yes
     5772                         .
     5773                       end .
     5774                       assign
     5775                         v-rvs-qnty-before     = v-rvs-qnty-before     + v-com-tank-rvs-qnty-before
     5776                         v-rvs-qnty-after      = v-rvs-qnty-after      + v-com-tank-rvs-qnty-after
     5777                         v-rvs-cli-qnty-before = v-rvs-cli-qnty-before + v-com-tank-rvs-cli-qnty-before
     5778                         v-rvs-cli-qnty-after  = v-rvs-cli-qnty-after  + v-com-tank-rvs-cli-qnty-after
     5779                       .
     5780                     end.
     5781                   end .
     5782                 end .
     5783                 if p-rvs-type = 'после_док':U then do:
     5784                   if v-rvs-qnty-after = ?
     5785                     or v-rvs-qnty-after = 0
     5786                   then do:
     5787                     message
     5788                       "Не задано количество по сверке <<после_док>>"
     5789                       "по резервуару" p-pl-code "."
     5790                       view-as alert-box error .
     5791                     undo block_tr, return error .
     5792                   end.
     5793                   if v-rvs-cli-qnty-after = ?
     5794                     or v-rvs-cli-qnty-after = 0
     5795                   then do:
     5796                     if is-sug(buf_goods.gds-code)
     5797                     then do :
     5798                       message
     5799                         "Не задана масса в сверке <<после_док>>"
     5800                         "по резервуару" p-pl-code "."
     5801                         view-as alert-box error .
     5802                     end.
     5803                     else do :
     5804                       message
     5805                         "Масса не рассчитана. Не задана плотность в сверке <<после_док>>"
     5806                         "по резервуару" p-pl-code "."
     5807                         view-as alert-box error .
     5808                     end.
     5809                     undo block_tr, return error .
     5810                   end.
     5811                 end.
     5812                 if v-rvs-qnty-after <> ?
     5813                 and v-rvs-qnty-after <> 0
     5814                 and not v-com-tanks-not-filled
     5815                 then do:
     5816                   if v-rvs-qnty-after - v-rvs-qnty-before <= 0
     5817                     or v-rvs-qnty-after - v-rvs-qnty-before = ?
     5818                   then do:
     5819                     message
     5820                       substitute( "Ошибка по результатам сверки." ) skip
     5821                       substitute( "Место хранения: &1 .", p-pl-code ) skip
     5822                       substitute( "Количество залитого топлива: &1 (&2).", v-rvs-qnty-after - v-rvs-qnty-before, buf_goods.unit-base ) skip
     5823                       substitute( "Объем в сверке до: &1 ", v-rvs-qnty-before ) skip
     5824                       substitute( "Объем в сверке после: &1 ", v-rvs-qnty-after ) skip
     5825                       view-as alert-box .
     5826                     undo block_tr, return error .
     5827                   end.
     5828                   if v-rvs-cli-qnty-after - v-rvs-cli-qnty-before <= 0
     5829                     or v-rvs-cli-qnty-after - v-rvs-cli-qnty-before = ?
     5830                   then do:
     5831                     message
     5832                       substitute( "Ошибка по результатам сверки." ) skip
     5833                       substitute( "Место хранения: &1 .", p-pl-code ) skip
     5834                       substitute( "Количество залитого топлива: &1 (&2).", v-rvs-cli-qnty-after - v-rvs-cli-qnty-before, buf_goods.unit-cli ) skip
     5835                       substitute( "Масса в сверке до: &1 ", v-rvs-cli-qnty-before ) skip
     5836                       substitute( "Масса в сверке после: &1 ", v-rvs-cli-qnty-after ) skip
     5837                       view-as alert-box .
     5838                     undo block_tr, return error .
     5839                   end.
     5840                   if not is-sug(buf_goods.gds-code)
     5841                   then do :
     5842                     assign
     5843                       v-rvs-density = (v-rvs-cli-qnty-after - v-rvs-cli-qnty-before) / (v-rvs-qnty-after - v-rvs-qnty-before)
     5844                     .
     5845                     if Valid-Density( v-rvs-density, (buf_goods.unit-base = buf_goods.unit-cli)  ) <> true then do:
     5846                       message
     5847                         substitute( "Ошибка по результатам сверки." ) skip
     5848                         substitute( "Место хранения: &1 .", p-pl-code ) skip
     5849                         substitute( "Плотность залитого топлива: &1.", v-rvs-density ) skip
     5850                         view-as alert-box .
     5851                       undo block_tr, return error .
     5852                     end.
     5853                   end.
     5854                   if is-sug(buf_goods.gds-code) then
     5855                   do:
     5856                     def var dmdop as decimal no-undo.
     5857                     def var dM    as decimal no-undo.
     5858                     define variable v-value-character as character no-undo .
     5859                     define variable v-value-date as date no-undo .
     5860                     define variable v-value-integer as integer no-undo .
     5861                     define variable v-value-logical as logical no-undo .
     5862                     define variable v-param-type as character no-undo .
     5863                     define variable v-tth as handle no-undo .
     5864                     def var v-cardifLgas as decimal no-undo.
     5865                     def var infoSectionObj as class infosection no-undo.
     5866                     find first buf_doc-line no-lock where buf_doc-line.doc-code = t-doc.doc-code
     5867                         and buf_goods.artic = buf_doc-line.artic
     5868                         and buf_goods.prod-type = buf_doc-line.prod-type
     5869                         and buf_goods.prod-code = buf_doc-line.prod-code no-error.
     5870                     run adm/shattri.p (
     5871                         input "get":U
     5872                         ,input  buf_doc-line.obj-type
     5873                         ,input  buf_doc-line.obj-code
     5874                         ,input  'petrol':U
     5875                         ,input  'CriticalDifInLgas':U
     5876                         ,output v-value-character
     5877                         ,output v-value-date
     5878                         ,output v-cardifLgas
     5879                         ,output v-value-integer
     5880                         ,output v-value-logical
     5881                         ,output v-param-type
     5882                         ,INPUT-OUTPUT table-handle v-tth
     5883                     ) no-error .
     5884                     if v-cardifLgas = ?
     5885                       then v-cardifLgas = 0.
     5886                     dM = buf_doc-line.cli-qnty - (v-rvs-cli-qnty-after - v-rvs-cli-qnty-before).
     5887                     dmdop = SQRT ((v-rvs-cli-qnty-after *  v-cardifLgas) * (v-rvs-cli-qnty-after *  v-cardifLgas) + (v-rvs-cli-qnty-before *  v-cardifLgas) * (v-rvs-cli-qnty-before *  v-cardifLgas)) / 100.
     5888                     if absolute (dM) <= dmdop
     5889                     then do:
     5890                       infoSectionObj = infoSectionsTotal:GetInfoSectionProp(1).
     5891                       infoSectionObj:AccPOMI = dmdop.
     5892                       infoSectionObj:FactKgQnty = buf_doc-line.doc-qnty * buf_doc-line.doc-density.
     5893                       infoSectionObj:FactQnty = (v-rvs-qnty-after - v-rvs-qnty-before).
     5894                       infoSectionObj:FactDensity = infoSectionObj:FactKgQnty / infoSectionObj:FactQnty.
     5895                       infoSectionsTotal:SaveDB().
     5896                       run correct-fact-qnty in this-procedure
     5897                         ( input buf_doc-line.doc-qnty
     5898                          ,input buf_doc-line.doc-density
     5899                         ) no-error .
     5900                     end.
     5901                     else do:
     5902                       infoSectionObj = infoSectionsTotal:GetInfoSectionProp(1).
     5903                       infoSectionObj:FactKgQnty = (v-rvs-cli-qnty-after - v-rvs-cli-qnty-before).
     5904                       infoSectionObj:FactQnty = (v-rvs-qnty-after - v-rvs-qnty-before).
     5905                       infoSectionObj:FactDensity = infoSectionObj:FactKgQnty / infoSectionObj:FactQnty.
     5906                       infoSectionsTotal:SaveDB().
     5907                       run correct-fact-qnty in this-procedure
     5908                         ( input infoSectionObj:FactQnty
     5909                          ,input infoSectionObj:FactDensity
     5910                         ) no-error.
     5911                       message
     5912                         substitute( "По результатам слива Газовоза фактическое кол-во товара изменяется на &1 (&2),", infoSectionObj:FactQnty, buf_goods.unit-base ) skip
     5913                         substitute( "фактическая плотность на &1.", infoSectionObj:FactDensity ) skip
     5914                         view-as alert-box information
     5915                       .
     5916                       run save-action in this-procedure
     5917                         ( input "hard":U
     5918                         ) no-error .
     5919                       if error-status :error then do:
     5920                         message return-value view-as alert-box error .
     5921                         undo block_tr, return error .
     5922                       end.
     5923                     end.
     5924                   end.
     5925                 end.
     5926               end.
     5927           end.
     5928         end.
     5929       end procedure.
     5930       procedure proc-b-addinfo :
     5931         define input        parameter parParentProc          as   handle                   no-undo .
     5932         define input        parameter p-mode                 as   character                no-undo .
     5933         define input        parameter p-doc-code             like ub.doc-line.doc-code     no-undo .
     5934         define input        parameter p-gds-code             like ub.goods.gds-code        no-undo .
     5935         define input        parameter p-stfactplvalue        as   character                no-undo .
     5936         define input        parameter p-auto-tank            as   logical                  no-undo .
     5937         define input        parameter p-fact-edit            as   logical                  no-undo .
     5938         define input        parameter p-doc-qnty             like ub.doc-line.doc-qnty     no-undo .
     5939         define input        parameter p-doc-density          like ub.doc-line.doc-density  no-undo .
     5940         define input-output parameter p-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
     5941         define input-output parameter p-new-density          like ub.doc-line.fact-density no-undo .
     5942         define input-output parameter p-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
     5943         define input-output parameter p-infoSectionsTotal    as class InfoSectionsTotal    no-undo .
     5944         define input-output parameter p-prt-start-real-date  like ub.rvs-line.real-date    no-undo .
     5945         define input-output parameter p-prt-start-real-time  like ub.rvs-line.real-time    no-undo .
     5946         define input-output parameter p-prt-end-real-date    like ub.rvs-line.real-date    no-undo .
     5947         define input-output parameter p-prt-end-real-time    like ub.rvs-line.real-time    no-undo .
     5948         do
     5949         on error  undo, return error substitute( "&1 (proc-b-addinfo). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5950         on stop   undo, return error substitute( "&1 (proc-b-addinfo). stop", vss-workfile )
     5951         on endkey undo, return error substitute( "&1 (proc-b-addinfo). endkey", vss-workfile )
     5952         :
     5953           define buffer buf_rvs-doc  for ub.rvs-doc   .
     5954           define buffer buf_rvs-line for ub.rvs-line  .
     5955           define buffer buf_goods    for ub.goods .
