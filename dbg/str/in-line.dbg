    19029                         end .
    19030                         else do :
    19031                           for first buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    19032                                                               and buf_pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19033                                                               and buf_pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19034                                                               and buf_pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    19035                                                               and buf_pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19036                           :
    19037                             v-pl-gds-pump-status_ = buf_pl-gds-pump.status_ .
    19038                           end .
    19039                         end .
    19040                       end .
    19041                       else do :
    19042                         for first buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    19043                                                             and buf_pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19044                                                             and buf_pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19045                                                             and buf_pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    19046                                                             and buf_pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19047                         :
    19048                           v-pl-gds-pump-status_ = buf_pl-gds-pump.status_ .
    19049                         end .
    19050                       end .
    19051                       if v-pl-gds-pump-status_ = 'тек':U
    19052                       then do :
    19053                         create tt-rvs-line-pump-delta .
    19054                         buffer-copy buf_rvs-line-pump to tt-rvs-line-pump-delta
    19055                         assign
    19056                           tt-rvs-line-pump-delta.rvs-code = "before-doc"
    19057                           tt-rvs-line-pump-delta.density = (bef_rvs-line.state-density / 2)
    19058                         .
    19059                         if tt-rvs-line-pump-delta.state-el-cnt = ?
    19060                         or tt-rvs-line-pump-delta.state-el-cnt <= 0
    19061                         then do :
    19062                           tt-rvs-line-pump-delta.is-err = yes .
    19063                         end .
    19064                       end .
    19065                     end.
    19066                     for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code = aft2_rvs-line.rvs-code
    19067                                                          and buf_rvs-line-pump.obj-type = aft2_rvs-line.obj-type
    19068                                                          and buf_rvs-line-pump.obj-code = aft2_rvs-line.obj-code
    19069                                                          and buf_rvs-line-pump.pl-code  = aft2_rvs-line.pl-code
    19070                                                          and buf_rvs-line-pump.gds-code = aft2_rvs-line.gds-code
    19071                     :
    19072                       if t-doc.status_ = 'факт':U
    19073                       then do :
    19074                         find last buf_c-pl-gds-pump no-lock where buf_c-pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    19075                                                               and buf_c-pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19076                                                               and buf_c-pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19077                                                               and buf_c-pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19078                                                               and buf_c-pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    19079                                                               and (buf_c-pl-gds-pump.corr-date < t-doc.fact-date
    19080                                                                 or buf_c-pl-gds-pump.corr-date = t-doc.fact-date and buf_c-pl-gds-pump.corr-time < t-doc.fact-time)
    19081                                                               no-error .
    19082                       end .
    19083                       else do :
    19084                         find last buf_c-pl-gds-pump no-lock where buf_c-pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    19085                                                               and buf_c-pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19086                                                               and buf_c-pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19087                                                               and buf_c-pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19088                                                               and buf_c-pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    19089                                                               and (buf_c-pl-gds-pump.corr-date < t-doc.sys-date
    19090                                                                 or buf_c-pl-gds-pump.corr-date = t-doc.sys-date and buf_c-pl-gds-pump.corr-time < t-doc.sys-time-int)
    19091                                                               no-error .
    19092                       end .
    19093                       if available buf_c-pl-gds-pump
    19094                       then do :
    19095                         find first buf2_c-pl-gds-pump no-lock where buf2_c-pl-gds-pump.obj-type = buf_c-pl-gds-pump.obj-type
    19096                                                                 and buf2_c-pl-gds-pump.obj-code = buf_c-pl-gds-pump.obj-code
    19097                                                                 and buf2_c-pl-gds-pump.pl-code  = buf_c-pl-gds-pump.pl-code
    19098                                                                 and buf2_c-pl-gds-pump.gds-code = buf_c-pl-gds-pump.gds-code
    19099                                                                 and buf2_c-pl-gds-pump.pump-code = buf_c-pl-gds-pump.pump-code
    19100                                                                 and buf2_c-pl-gds-pump.chip-num > buf_c-pl-gds-pump.chip-num
    19101                                                                 no-error .
    19102                         if available buf2_c-pl-gds-pump
    19103                         then do :
    19104                           v-pl-gds-pump-status_ = buf2_c-pl-gds-pump.status_ .
    19105                         end .
    19106                         else do :
    19107                           for first buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    19108                                                               and buf_pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19109                                                               and buf_pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19110                                                               and buf_pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    19111                                                               and buf_pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19112                           :
    19113                             v-pl-gds-pump-status_ = buf_pl-gds-pump.status_ .
    19114                           end .
    19115                         end .
    19116                       end .
    19117                       else do :
    19118                         for first buf_pl-gds-pump no-lock where buf_pl-gds-pump.obj-type = buf_rvs-line-pump.obj-type
    19119                                                             and buf_pl-gds-pump.obj-code = buf_rvs-line-pump.obj-code
    19120                                                             and buf_pl-gds-pump.gds-code = buf_rvs-line-pump.gds-code
    19121                                                             and buf_pl-gds-pump.pump-code = buf_rvs-line-pump.pump-code
    19122                                                             and buf_pl-gds-pump.pl-code  = buf_rvs-line-pump.pl-code
    19123                         :
    19124                           v-pl-gds-pump-status_ = buf_pl-gds-pump.status_ .
    19125                         end .
    19126                       end .
    19127                       if v-pl-gds-pump-status_ = 'тек':U
    19128                       then do :
    19129                         find first tt-rvs-line-pump-delta where tt-rvs-line-pump-delta.rvs-code    = "before-doc"
    19130                                                             and tt-rvs-line-pump-delta.obj-type    = buf_rvs-line-pump.obj-type
    19131                                                             and tt-rvs-line-pump-delta.obj-code    = buf_rvs-line-pump.obj-code
    19132                                                             and tt-rvs-line-pump-delta.pl-code     = buf_rvs-line-pump.pl-code
    19133                                                             and tt-rvs-line-pump-delta.gds-code    = buf_rvs-line-pump.gds-code
    19134                                                             and tt-rvs-line-pump-delta.pump-code   = buf_rvs-line-pump.pump-code
    19135                                                             and tt-rvs-line-pump-delta.nozzle-code = buf_rvs-line-pump.nozzle-code
    19136                                                             no-error .
    19137                         if not available tt-rvs-line-pump-delta
    19138                         then do :
    19139                           create tt-rvs-line-pump-delta .
    19140                           buffer-copy buf_rvs-line-pump to tt-rvs-line-pump-delta
    19141                           assign
    19142                             tt-rvs-line-pump-delta.rvs-code = "after-doc"
    19143                             tt-rvs-line-pump-delta.is-err = yes
    19144                           .
    19145                         end .
    19146                         else do :
    19147                           tt-rvs-line-pump-delta.find-pair = yes .
    19148                           if tt-rvs-line-pump-delta.state-el-cnt > buf_rvs-line-pump.state-el-cnt
    19149                           then do :
    19150                             tt-rvs-line-pump-delta.is-err = yes .
    19151                           end .
    19152                           else do :
    19153                             tt-rvs-line-pump-delta.deltaVol = buf_rvs-line-pump.state-el-cnt - tt-rvs-line-pump-delta.state-el-cnt .
    19154                             tt-rvs-line-pump-delta.density = tt-rvs-line-pump-delta.density + (aft_rvs-line.state-density / 2) .
    19155                           end .
    19156                         end .
    19157                       end .
    19158                     end .
    19159                   end .
    19160                 end .
    19161               end .
    19162             end .
    19163           end.
    19164           else do:
    19165             assign
    19166               tt-fr-doc-line.state-measure-qnty     = ?
    19167               tt-fr-doc-line.measure-qnty           = ?
    19168               tt-fr-doc-line.state-measure-cli-qnty = ?
    19169               tt-fr-doc-line.measure-cli-qnty       = ?
    19170             .
    19171             if available bef_rvs-doc
    19172               and available aft_rvs-doc
    19173               and lookup(v-ptrl-without-rvs, 'true,yes':u) = 0
    19174             then do:
    19175               message
    19176                 vss-workfile vss-revision vss-description skip
    19177                 "Сверки по документу созданы неверно!" skip
    19178                 "Необходимо удалить сверки и создать из заново." skip
    19179                 view-as alert-box error .
    19180             end.
    19181             leave block-clc-rvs .
    19182           end.
    19183         end.
    19184       end .
    19185       v-trk-err = no .
    19186       find first tt-rvs-line-pump-delta where tt-rvs-line-pump-delta.is-err no-error .
    19187       if available tt-rvs-line-pump-delta
    19188       then do :
    19189         v-trk-err = yes .
    19190         tt-fr-doc-line.trk-cli-qnty = ? .
    19191       end .
    19192       else do :
    19193         for each tt-rvs-line-pump-delta :
    19194           assign
    19195             tt-fr-doc-line.trk-cli-qnty = tt-fr-doc-line.trk-cli-qnty + (tt-rvs-line-pump-delta.deltaVol * tt-rvs-line-pump-delta.density)
    19196           .
    19197         end .
    19198       end .
    19199       display
    19200         tt-fr-doc-line.state-measure-qnty
    19201         tt-fr-doc-line.measure-qnty
    19202         tt-fr-doc-line.state-measure-cli-qnty
    19203         tt-fr-doc-line.trk-cli-qnty
    19204       with frame d-in-line .
    19205     end.
    19206   end procedure.
    19207   procedure init-tt-doc-pl :
    19208     define buffer buf_doc-pl for ub.doc-pl .
    19209     for each tt-doc-pl
    19210     on error undo, return error error-status :get-message(1)
    19211     :
    19212       delete tt-doc-pl .
    19213     end.
    19214     for each buf_doc-pl no-lock
    19215       where buf_doc-pl.obj-type = t-doc.obj-type
    19216         and buf_doc-pl.obj-code = t-doc.obj-code
    19217         and buf_doc-pl.out-code = t-doc.doc-code
    19218         and buf_doc-pl.gds-code = buf_goods.gds-code
    19219     on error undo, return error error-status :get-message(1)
    19220     :
    19221       create tt-doc-pl .
    19222       buffer-copy buf_doc-pl to tt-doc-pl .
    19223     end.
    19224   end procedure.
    19225   procedure new-price-s :
    19226     do
    19227     on error undo, return error return-value
    19228     :
    19229   if not ( pr-naklvalue = yes and pr-genmrg = 'before-margin':U and is-petrolium = false  ) then do:
    19230      hide  tt-fr-doc-line.new-price-sale  in frame d-in-line
    19231            abr-rb in frame d-in-line
    19232            b-corr-price-sale in frame d-in-line
    19233            .
    19234      return.
    19235   end.
    19236   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    19237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
    19238     (input  t-doc.host-code
    19239     ,output abr-rb
    19240     )  .
    19241   if parline-mode = 'ПРОСМОТР':U then do:
    19242   end.
    19243   else do:
    19244     define variable l-ok as logical   no-undo .
    19245   define variable vss-include-info92 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19246   do:
    19247     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    19248       (input  v-cntxt-db-num
    19249       ,input  v-cntxt-userid
    19250       ,input  0
    19251       ,input  'actn_income_price-sale':U
    19252       ,input  'object':U
    19253       ,input  t-doc.host-code
    19254       ,input  t-doc.obj-type
    19255       ,input  t-doc.obj-code
    19256       ,input  0
    19257       ,input  0
    19258       ,input  0
    19259       ,input  false
    19260       ,output l-ok
    19261       )  .
    19262   end.
    19263       if l-ok = true
    19264       then do:
    19265         enable tt-fr-doc-line.new-price-sale  with frame d-in-line .
    19266       end.
    19267   end.
    19268   define variable p-exist   as logical  no-undo .
    19269   run lineattr-exist in this-procedure (
    19270       input t-doc.doc-code  ,
    19271       input buf_goods.gds-code    ,
    19272       input 'corr-price-sale':U ,
    19273       output p-exist ) .
    19274   if p-exist then display b-corr-price-sale with frame d-in-line .
    19275              else hide    b-corr-price-sale in frame d-in-line .
    19276   tt-fr-doc-line.new-price-sale:tooltip = "Цена будет перенесена в переоценку до закрытия этой накладной до ФАКТ" .
    19277   display tt-fr-doc-line.new-price-sale abr-rb with frame d-in-line .
    19278     end.
    19279   end procedure.
    19280   procedure save-place-rsrv :
    19281     define input  parameter kind-check as character no-undo.
    19282     define output parameter p-ok       as logical   no-undo .
    19283     do
    19284     on error  undo, return error substitute( "&1 (save-place-rsrv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    19285     on stop   undo, return error substitute( "&1 (save-place-rsrv). stop", vss-workfile )
    19286     on endkey undo, return error substitute( "&1 (save-place-rsrv). endkey", vss-workfile )
    19287     :
    19288       define buffer buf_doc-pl for ub.doc-pl .
    19289       define variable v-new-fact-qnty        like ub.doc-line.fact-qnty    no-undo .
    19290       define variable v-new-density          like ub.doc-line.fact-density no-undo .
    19291       define variable v-new-cli-fact-qnty    like ub.doc-line.fact-qnty    no-undo .
    19292       assign
    19293         p-ok = true
    19294       .
    19295       if is-petrolium = yes
    19296         and is-pieces = no
    19297         and kind-check = "hard":U
    19298         and not( t-doc.status_ = 'накл':U
    19299                  and t-doc.flag_ = false
    19300                )
    19301       then do:
    19302         run chkdcrvs in this-procedure
    19303           ( input  tt-fr-doc-line.doc-code
    19304            ,input  buf_goods.gds-code
    19305            ,output p-ok
    19306           ) no-error .
    19307         if error-status :error then do:
    19308           return error return-value .
    19309         end.
    19310         if p-ok = true then do:
    19311           assign
    19312             v-new-fact-qnty     = tt-fr-doc-line.fact-qnty
    19313             v-new-density       = tt-fr-doc-line.fact-density
    19314             v-new-cli-fact-qnty = tt-fr-doc-line.fact-qnty-kg
    19315           .
    19316           run local-state-fact-rvs in this-procedure
    19317             ( input        tt-fr-doc-line.doc-code
    19318              ,input        buf_goods.gds-code
    19319              ,input        stfactplvalue
    19320              ,input        varrevision
    19321              ,input        varupd-fact-qnty
    19322              ,input        tt-fr-doc-line.doc-qnty
    19323              ,input        tt-fr-doc-line.doc-density
    19324              ,input-output v-new-fact-qnty
    19325              ,input-output v-new-density
    19326              ,input-output v-new-cli-fact-qnty
    19327             ) no-error .
    19328           if error-status :error then do:
    19329             message
    19330               "Ошибка при установке факт кол-ва (revision)." skip
    19331               return-value
    19332               view-as alert-box error .
    19333             undo, return error .
    19334           end.
    19335           if tt-fr-doc-line.fact-qnty <> v-new-fact-qnty
    19336             or tt-fr-doc-line.fact-qnty-kg <> v-new-cli-fact-qnty
    19337           then do:
    19338             run correct-fact-qnty in this-procedure
    19339               ( input v-new-fact-qnty
    19340                ,input v-new-density
    19341               ) no-error .
    19342           end.
    19343           display
    19344             tt-fr-doc-line.fact-qnty
    19345             tt-fr-doc-line.fact-qnty-kg when tt-fr-doc-line.fact-qnty-kg :visible = true
    19346             tt-fr-doc-line.fact-density when tt-fr-doc-line.fact-density :visible = true
    19347             with frame d-in-line .
    19348           run eq-qnty-rvs-pl in this-procedure
    19349             ( input        tt-fr-doc-line.doc-code
    19350              ,input        buf_goods.gds-code
    19351              ,input        varupd-fact-qnty
    19352              ,input-output v-new-fact-qnty
    19353              ,input-output v-new-density
    19354              ,input-output v-new-cli-fact-qnty
    19355              ,output p-ok
    19356             ) no-error .
    19357           if error-status :error then do:
    19358             message
    19359               "Ошибка при установке факт кол-ва по местам хранения." skip
    19360               return-value
    19361               view-as alert-box error .
    19362             undo, return error .
    19363           end.
    19364           if tt-fr-doc-line.fact-qnty <> v-new-fact-qnty
    19365             or tt-fr-doc-line.fact-qnty-kg <> v-new-cli-fact-qnty
    19366           then do:
    19367             assign
    19368               tt-fr-doc-line.fact-qnty    = v-new-fact-qnty
    19369               tt-fr-doc-line.fact-density = v-new-density
    19370               tt-fr-doc-line.fact-qnty-kg = v-new-cli-fact-qnty
    19371             .
    19372             display
    19373               tt-fr-doc-line.fact-qnty
    19374               tt-fr-doc-line.fact-qnty-kg when tt-fr-doc-line.fact-qnty-kg :visible = true
    19375               tt-fr-doc-line.fact-density when tt-fr-doc-line.fact-density :visible = true
    19376               with frame d-in-line .
    19377           end.
    19378           if p-ok = false then do:
    19379             return .
    19380           end.
    19381         end.
    19382         else do:
    19383           assign
    19384             p-ok = true
    19385           .
    19386         end.
    19387       end.
    19388       run check-place-rsrv in this-procedure
    19389         no-error.
    19390       if error-status :error then do:
    19391         return error substitute( "&1 (save-place-rsrv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ) .
    19392       end.
    19393       for each buf_doc-pl
    19394         where buf_doc-pl.obj-type = tt-fr-doc-line.obj-type
    19395           and buf_doc-pl.obj-code = tt-fr-doc-line.obj-code
    19396           and buf_doc-pl.out-code = tt-fr-doc-line.doc-code
    19397           and buf_doc-pl.gds-code = buf_goods.gds-code
    19398       on error undo, return error substitute( "&1 (save-place-rsrv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    19399       :
    19400         delete buf_doc-pl .
    19401       end.
    19402       for each tt-doc-pl
    19403       on error undo, return error substitute( "&1 (save-place-rsrv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    19404       :
    19405         create buf_doc-pl .
    19406         buffer-copy tt-doc-pl to buf_doc-pl .
    19407       end.
    19408       if b-addinf :sensitive in frame d-in-line = true then do:
    19409       end.
    19410     end.
    19411     return .
    19412   end procedure.
    19413   procedure correct-fact-qnty :
    19414     define input parameter p-newfact-qnty like ub.doc-line.fact-qnty   no-undo .
    19415     define input parameter p-density      like ub.doc-line.doc-density no-undo .
    19416     define variable infoSecObj  as class ibs.th.str.InfoSection no-undo .
    19417     define variable ii          as integer no-undo .
    19418     define variable v-correct-cli-fact-qnty as decimal no-undo .
    19419     define variable v-correct-fact-qnty as decimal no-undo .
    19420     do
    19421     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    19422     on stop   undo, return error substitute( "&1. stop", vss-workfile )
    19423     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
    19424     :
    19425       define buffer buf-next_tt-doc-pl for tt-doc-pl .
    19426       define buffer buf_place for ub.place .
    19427       assign
    19428         tt-fr-doc-line.fact-qnty    = p-newfact-qnty
    19429         tt-fr-doc-line.fact-density = p-density
    19430         tt-fr-doc-line.fact-qnty-kg = p-newfact-qnty * p-density
    19431       .
    19432       display
    19433         tt-fr-doc-line.fact-qnty
    19434         tt-fr-doc-line.fact-qnty-kg when tt-fr-doc-line.fact-qnty-kg :visible = true
    19435         tt-fr-doc-line.fact-density when tt-fr-doc-line.fact-density :visible = true
    19436         with frame d-in-line .
    19437       find first tt-doc-pl no-lock
    19438       .
    19439       find first buf-next_tt-doc-pl no-lock
    19440         where buf-next_tt-doc-pl.obj-type =  tt-doc-pl.obj-type
    19441           and buf-next_tt-doc-pl.obj-code =  tt-doc-pl.obj-code
    19442           and buf-next_tt-doc-pl.pl-code  <> tt-doc-pl.pl-code
    19443         no-error .
    19444       if available buf-next_tt-doc-pl then do:
    19445         for each tt-doc-pl,
    19446         first buf_place no-lock where buf_place.pl-code = tt-doc-pl.pl-code
    19447         on error undo, return error return-value
    19448         :
    19449           tt-doc-pl.fact-qnty = 0 .
    19450           tt-doc-pl.cli-fact-qnty = 0 .
    19451           do ii = 1 to infoSectionsTotal:SectionNum :
    19452             infoSecObj = infoSectionsTotal:GetInfoSectionProp(ii) .
    19453             if infoSecObj:ListTank = buf_place.loc1
    19454             then do :
    19455               tt-doc-pl.fact-qnty = tt-doc-pl.fact-qnty + infoSecObj:FactQnty .
    19456               tt-doc-pl.cli-fact-qnty = tt-doc-pl.cli-fact-qnty + (infoSecObj:FactQnty * infoSecObj:FactDensity) .
    19457             end .
    19458           end .
    19459         end.
    19460         v-correct-cli-fact-qnty = tt-fr-doc-line.fact-qnty-kg .
    19461         v-correct-fact-qnty = tt-fr-doc-line.fact-qnty .
    19462         for each tt-doc-pl :
    19463           assign
    19464             v-correct-cli-fact-qnty = v-correct-cli-fact-qnty - tt-doc-pl.cli-fact-qnty
    19465             v-correct-fact-qnty = v-correct-fact-qnty - tt-doc-pl.fact-qnty
    19466           .
    19467           if absolute( v-correct-cli-fact-qnty ) <= 0.001 then do:
    19468             assign
    19469               tt-doc-pl.cli-fact-qnty = tt-doc-pl.cli-fact-qnty + v-correct-cli-fact-qnty
    19470             .
    19471           end.
    19472           if absolute( v-correct-fact-qnty ) <= 0.001 then do:
    19473             assign
    19474               tt-doc-pl.fact-qnty = tt-doc-pl.fact-qnty + v-correct-fact-qnty
    19475             .
    19476           end.
    19477         end .
    19478         run edit-doc-pl in this-procedure
    19479           ( input 'АВТОИЗМЕНЕНИЕ':U
    19480           ) no-error .
    19481         if error-status :error then do:
    19482           return error return-value .
    19483         end.
    19484       end.
    19485       else do:
    19486         assign
    19487           tt-doc-pl.fact-qnty     = tt-fr-doc-line.fact-qnty
    19488           tt-doc-pl.cli-fact-qnty = tt-fr-doc-line.fact-qnty-kg
    19489         .
    19490       end.
    19491     end.
    19492   end procedure.
    19493   procedure new-price-prod :
    19494   define variable par-is-pharm  as character no-undo .
    19495   define variable par-type as character no-undo .
    19496     do
    19497     on error undo, return error return-value
    19498     :
    19499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    19500     (input  'is-pharm'
    19501     ,input  v-cntxt-host-code-obj
    19502     ,input  v-cntxt-obj-type
    19503     ,input  v-cntxt-obj-code
    19504     ,input  ''
    19505     ,input  ''
    19506     ,input  ''
    19507     ,input  no
    19508     ,output par-is-pharm
    19509     ,output par-type
    19510     ) no-error .
    19511     .
    19512   if par-is-pharm <> "yes"  then par-is-pharm = "no" .
    19513   else do:
    19514   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$workfile: $ $revision: $".
    19515   define variable v-o-pharm    as character no-undo .
    19516   define variable v-o-var-type as character no-undo .
    19517     run clntattr-value in this-procedure
    19518       ( input   v-cntxt-obj-type ,
    19519         input   v-cntxt-obj-code ,
    19520         input  'pharm':U,
    19521         output v-o-pharm    ,
    19522         output v-o-var-type )
    19523        no-error .
    19524     if v-o-pharm <> "yes":u or error-status :error then do:
    19525        par-is-pharm = "no"  .
    19526     end.
    19527   end.
    19528   if par-is-pharm <> "yes"   then do:
    19529      hide  tt-fr-doc-line.price-prod     in frame d-in-line
    19530            tt-fr-doc-line.price-prod-vat in frame d-in-line
    19531            abr-rb2 in frame d-in-line
    19532            .
    19533      return.
    19534   end.
    19535   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    19536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
    19537     (input  t-doc.host-code
    19538     ,output abr-rb2
    19539     )  .
    19540   if parline-mode = 'ПРОСМОТР':U then do:
    19541   end.
    19542   else do:
    19543     define variable l-ok as logical   no-undo .
    19544   define variable vss-include-info95 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19545   do:
    19546     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    19547       (input  v-cntxt-db-num
    19548       ,input  v-cntxt-userid
    19549       ,input  0
    19550       ,input  'actn_income_price-prod':U
    19551       ,input  'object':U
    19552       ,input  t-doc.host-code
    19553       ,input  t-doc.obj-type
    19554       ,input  t-doc.obj-code
    19555       ,input  0
    19556       ,input  0
    19557       ,input  0
    19558       ,input  false
    19559       ,output l-ok
    19560       )  .
    19561   end.
    19562      if l-ok = true
    19563       then do:
    19564         enable tt-fr-doc-line.price-prod  tt-fr-doc-line.price-prod-vat with frame d-in-line .
    19565       end.
    19566   end.
    19567      tt-fr-doc-line.price-prod:tooltip = "Цена Производителя товаров медицинского назначения" .
    19568      tt-fr-doc-line.price-prod-vat:tooltip = "Цена Производителя С НДС товаров медицинского назначения" .
    19569   display tt-fr-doc-line.price-prod tt-fr-doc-line.price-prod-vat abr-rb2 with frame d-in-line .
    19570     end.
    19571   end procedure.
    19572   procedure save-price-prod :
    19573     do
    19574     on error undo, return error return-value
    19575     :
    19576   run lineattr-write in this-procedure (
    19577     input   t-doc.doc-code  ,
    19578     input   buf_goods.gds-code  ,
    19579     input   'price-prod':U ,
    19580     input   string(tt-fr-doc-line.price-prod) )
    19581     no-error .
    19582       if error-status :error then do:
    19583          message vss-workfile vss-revision vss-description skip
    19584                  error-status :get-message( 1 ) skip
    19585                  return-value skip
    19586                  "№1"
    19587          view-as alert-box error .
    19588          return error.
    19589       end.
    19590   run lineattr-write in this-procedure (
    19591     input   t-doc.doc-code  ,
    19592     input   buf_goods.gds-code  ,
    19593     input   'price-prodvat':U ,
    19594     input   string(tt-fr-doc-line.price-prod-vat) )
    19595     no-error .
    19596       if error-status :error then do:
    19597          message vss-workfile vss-revision vss-description skip
    19598                  error-status :get-message( 1 ) skip
    19599                  return-value skip
    19600                  "№2"
    19601          view-as alert-box error .
    19602          return error.
    19603       end.
    19604   end.
    19605   end procedure.
    19606   procedure p-chk-vat private:
    19607   define input parameter p-new-vat-pc as decimal no-undo .
    19608         if dops > '' and not f-chekval(input dops, input p-new-vat-pc) then do:
    19609            message "Неверное значение НДС:" p-new-vat-pc skip
    19610                    "Разрешенные значения: " replace(dops, ",", "%, ") + "%."
    19611                    view-as alert-box.
    19612            display tt-fr-doc-line.vat-pc with frame d-in-line.
    19613            return error.
    19614         end.
    19615         if  dop-slt > '' and not f-chekval(input dop-slt , input tt-fr-doc-line.slt-pc) then do:
    19616            message "Неверное значение НсП."   skip
    19617                    "Разрешенные значения: " dop-slt "."
    19618                    view-as alert-box.
    19619            display tt-fr-doc-line.slt-pc with frame d-in-line.
    19620            return error.
    19621         end.
    19622   end procedure.
