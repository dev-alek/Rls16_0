    16337     ,input   tt-fr-doc-line.prod-type
    16338     ,input   tt-fr-doc-line.prod-code
    16339     ,input   tt-fr-doc-line.price-cli
    16340     ,input   tt-fr-doc-line.cli-base-rate
    16341     ,input   tt-fr-doc-line.price-rubl
    16342     ,input   tt-fr-doc-line.vat-pc
    16343     ,input   tt-fr-doc-line.slt-pc
