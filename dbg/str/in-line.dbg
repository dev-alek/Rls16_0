    14785                end.
    14786                else do:
    14787                  wait-for go of frame d-in-line.
    14788                end.
    14789              end.
    14790            end.
    14791          end.
    14792          else do:
    14793            if isEgais
    14794            then do:
    14795              disable tt-fr-doc-line.unit-cli r-units tt-fr-doc-line.cli-qnty tt-fr-doc-line.doc-qnty tt-fr-doc-line.cli-base-rate with frame d-in-line.
    14796            end.
    14797            if varupd-fact-qnty = no then do:
