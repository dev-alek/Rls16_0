     2905               .
     2906             end.
     2907           end.
     2908           when 'expptrl':U then do:
     2909             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     2910               and thbjattr_thbj-attr.prop-value-type = 'character':U
     2911             then do:
