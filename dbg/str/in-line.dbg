      115   define new global shared variable g#vssrevis-logger as handle    no-undo .
      116   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      117   define variable v-vssrevis-logger                   as handle    no-undo .
      118   procedure vss-logevent :
      119     define input  parameter p-extra-paramters as character no-undo .
      120     define variable v-vssrevis-parameters as character no-undo .
      121     do
      122     on error undo, return error return-value
      123     :
      124       if  valid-handle(v-vssrevis-logger)
      125       and v-vssrevis-logger :get-signature("logevent") <> ""
      126       then do:
      127         run vss-get-parameters in this-procedure
      128           (output v-vssrevis-parameters
      129           ).
      130         run logevent in v-vssrevis-logger
      131           (input vss-workfile
      132           ,input vss-revision
      133           ,input v-vssrevis-parameters
      134           ,input p-extra-paramters
      135           ).
      136       end.
      137     end.
      138   end procedure.
      139   assign
      140     v-vssrevis-logger = g#vssrevis-logger
      141   .
      142   if  valid-handle(v-vssrevis-logger)
      143   and v-vssrevis-logger :get-signature("logevent") <> ""
      144   then do:
      145     assign
      146       v-vssrevis-logevent = true
      147     .
      148     run vss-logevent in this-procedure (input vss-description) .
      149   end.
      150   define new global shared variable g#language as character no-undo .
      151   if g#language <> '' and g#language <> 'rus':U then do:
      152     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      153   end.
