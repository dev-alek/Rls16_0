    18986                       tt-fr-doc-line.measure-qnty           = tt-fr-doc-line.measure-qnty           + aft2_rvs-line.measure-qnty            - bef2_rvs-line.measure-qnty
    18987                       tt-fr-doc-line.state-measure-cli-qnty = tt-fr-doc-line.state-measure-cli-qnty + aft2_rvs-line.state-measure-cli-qnty  - bef2_rvs-line.state-measure-cli-qnty
    18988                       tt-fr-doc-line.measure-cli-qnty       = tt-fr-doc-line.measure-cli-qnty       + aft2_rvs-line.measure-cli-qnty        - bef2_rvs-line.measure-cli-qnty
    18989                     .
    18990                     for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code = bef2_rvs-line.rvs-code
    18991                                                          and buf_rvs-line-pump.obj-type = bef2_rvs-line.obj-type
    18992                                                          and buf_rvs-line-pump.obj-code = bef2_rvs-line.obj-code
    18993                                                          and buf_rvs-line-pump.pl-code  = bef2_rvs-line.pl-code
    18994                                                          and buf_rvs-line-pump.gds-code = bef2_rvs-line.gds-code
    18995                     :
