    16685     if available ub.doc-line-attr then ASSIGN ub.doc-line-attr.attr-value = STRING(tt-fr-doc-line.type-inp-vat).
    16686     find first ub.doc-line-attr where ub.doc-line-attr.doc-code  = t-doc.doc-code          and
    16687                                    ub.doc-line-attr.gds-code  = buf_goods.gds-code      and
    16688                                    ub.doc-line-attr.attr-code = "tot-cli"                   no-error.
    16689     if not available ub.doc-line-attr and
    16690        STRING(tt-fr-doc-line.tot-cli) <> ?    and
    16691        STRING(tt-fr-doc-line.tot-cli) <> ""   then do:
    16692        CREATE ub.doc-line-attr.
    16693        ASSIGN
    16694        ub.doc-line-attr.doc-code  = t-doc.doc-code
    16695        ub.doc-line-attr.gds-code  = buf_goods.gds-code
    16696        ub.doc-line-attr.attr-code = "tot-cli".
    16697     end.
    16698     if available ub.doc-line-attr then ASSIGN ub.doc-line-attr.attr-value = STRING(tt-fr-doc-line.tot-cli).
    16699   end.
    16700   run str/cor-line.p
    16701   (input        parparentproc,
    16702    input-output line-rec,
    16703     tt-fr-doc-line.doc-code                  ,
    16704     tt-fr-doc-line.prod-type                 ,
    16705     tt-fr-doc-line.prod-code                 ,
