    14304   on choose of b-help in frame d-in-line
    14305   do:
    14306     apply "help":u to frame d-in-line .
    14307   end.
    14308   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14309   procedure minbtn-set :
    14310       do
    14311           on error undo, return error return-value
    14312           :
    14313           define variable ii              as integer       no-undo .
    14314           define variable fh              as widget-handle no-undo .
    14315           define variable hh              as widget-handle no-undo .
    14316           define variable v-h             as handle        extent 4 no-undo .
    14317           define variable v-name-button   as character     no-undo .
    14318           define variable v-help-old-x    as decimal       no-undo .
    14319           define variable v-help-old-y    as decimal       no-undo .
    14320           define variable v-help-old-size as decimal       no-undo .
    14321           define variable v-frame-width   as decimal       no-undo .
    14322           define variable jj              as integer       no-undo .
    14323           do
    14324               on error undo, return error
    14325               :
    14326               assign
    14327                   v-frame-width = frame d-in-line:width - 0.3
    14328                   fh            = frame d-in-line:first-child
    14329                   hh            = fh:first-child
    14330                   ii            = 1
    14331                   .
    14332               do while valid-handle(hh):
    14333                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    14334                   do:
    14335                       case lc(hh:name) :
    14336                           when "b-help" then
    14337                               do:
    14338                                   hh:load-image-up("cmp/b-help.bmp":u) .
    14339                                   hh:load-image-down("cmp/b-help.bmp":u) .
    14340                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    14341                                   hh:TOOLTIP = "Помощь" .
    14342                                   v-help-old-x = hh:column .
    14343                                   v-help-old-y = hh:row    .
    14344                                   v-help-old-size = hh:width .
    14345                                   hh:width-chars = 2.5 .
    14346                               end.
    14347                           when "b-print" then
    14348                               do:
    14349                                   hh:load-image("cmp/b-print.bmp":u) .
    14350                                   hh:TOOLTIP = "Печать" .
    14351                                   v-h[ii] = hh:handle .
    14352                                   ii = ii + 1 .
    14353                                   hh:width-chars = 3 .
    14354                               end.
    14355                           when "b-history" or
    14356                           when "b-hist" then
    14357                               do:
    14358                                   hh:load-image("cmp/b-hist.bmp":u) .
    14359                                   hh:TOOLTIP = "История" .
    14360                                   v-h[ii] = hh:handle .
    14361                                   ii = ii + 1 .
    14362                                   hh:width-chars = 3 .
    14363                               end.
    14364                           when "b-sch" then
    14365                               do:
    14366                                   hh:load-image("cmp/b-sch.bmp":u) .
    14367                                   hh:TOOLTIP = "Установка Фильтра" .
    14368                                   v-h[ii] = hh:handle .
    14369                                   ii = ii + 1 .
    14370                                   hh:width-chars = 3 .
    14371                               end.
    14372                           when "b-hist-user" then
    14373                               do:
    14374                                   hh:load-image("cmp/b-hist.bmp":u) .
    14375                                   hh:TOOLTIP = "История пользователя" .
    14376                                   ii = ii + 1 .
    14377                               end.
    14378                       end case.
    14379                   end.
    14380                   hh = hh:next-sibling.
    14381               end.
    14382               b-help:column = v-frame-width - b-help:width-chars.
    14383               jj = 0.
    14384               repeat ii = 4 to 1 by -1 :
    14385                   if valid-handle (v-h[ii] ) then
    14386                   do:
    14387                       jj  = jj + 1 .
    14388                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    14389                       v-h[ii]:row    = v-help-old-y .
    14390                   end.
    14391               end.
    14392           end.
    14393       end.
    14394   end procedure.
    14395   on window-close of frame d-in-line apply "end-error":u to self.
