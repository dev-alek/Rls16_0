      211   field num-records   as integer
      212   field max-records   as integer
      213   field min-plu       as integer
      214   field max-plu       as integer
      215   field num-fields    as integer
      216   field task-num      as character
      217   field by-record     as logical
      218   field send-get      as character
      219   field cash-num      as integer
      220   field cash-num-char as character
      221   field port-num      as character
      222   field way           as character
      223   field is-script     as logical
      224   field pswd          as character
      225   field waiting-sek   as integer
      226   field other-info    as character
      227   field order-num     as integer
      228   field secondary     as integer
      229   field shift-fields  as integer
      230   field binary        as logical
      231   field range         as integer
      232   index pi is unique primary
      233   filename
      234   range
      235   index lpi
      236   filename
      237   min-plu
      238   index gpi
      239   filename
      240   max-plu
      241   index iorder
      242   order-num
      243   .
