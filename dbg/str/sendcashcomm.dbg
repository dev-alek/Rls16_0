      266   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      267   define variable v-is-closed-shift-journal as integer no-undo .
      268   assign
      269   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      270                               +
      271                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      272                               +
      273                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      274   .
      275   return v-is-closed-shift-journal.
      276   END FUNCTION.
      277   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      278   define variable v-is-first-journal as logical no-undo .
      279   assign
      280   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      281                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      282                     or (p-journal-num =  integer(entry(1, '17':U)))
      283                     or (p-journal-num = integer(entry(1, '16':U)))
      284   .
      285   return v-is-first-journal.
      286   END FUNCTION.
      287   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      288   define variable v-is-petrol-journal as logical no-undo .
      289   assign
      290   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      291   return v-is-petrol-journal.
      292   END FUNCTION.
      293   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      294   define variable v-max-record-num as integer no-undo .
      295   assign
      296   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      297                       then 1489
      298                       else 2340).
      299   return v-max-record-num.
      300   END FUNCTION.
      301   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      302   define variable v-max-record-num as integer no-undo .
      303   assign
      304   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      305                       then 1489 * num-entries('30,31,32,33':U)
      306                       else 2340 * num-entries('17':U)).
      307   return v-max-record-num.
      308   END FUNCTION.
      309   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      310                                           ,input p-rec-no as integer):
      311   define variable v-num-recs as integer no-undo .
      312   if tekka-is-petrol-journal (p-journal-num) then do:
      313     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      314       assign
      315       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      316       .
      317     end.
      318     else do:
      319       assign
      320       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      321       .
      322     end.
      323   end.
      324   else do:
      325     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      326       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      327         assign
      328         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      329         .
      330       end.
      331       else do:
      332         assign
      333         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      334         .
      335       end.
      336     end.
      337     else do:
      338       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      339         assign
      340         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      341         .
      342       end.
      343       else do:
      344         assign
      345         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      346         .
      347       end.
      348     end.
      349   end.
      350   return v-num-recs.
      351   END FUNCTION.
      352   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      353                                              ,input p-is-petrol as logical
      354                                              ,input p-is-current as logical
      355                                              ,output p-rec-no as decimal
      356                                              ):
      357   define variable v-obj-num0 as integer no-undo .
      358   define variable v-obj-num as integer no-undo .
      359   define variable v-obj-num2 as integer no-undo .
      360   define variable p-num-recs2 as integer no-undo .
      361   define variable p-rec-no2 as integer no-undo .
      362   if p-is-petrol then do:
      363     assign
      364     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      365     .
      366     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      367     then
      368     assign
      369     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      370     p-rec-no = p-num-recs modulo 1489
      371     .
      372     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      373     then
      374     assign
      375     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      376     p-rec-no = p-num-recs modulo 1489
      377     .
      378   end.
      379   else do:
      380     assign
      381     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      382     p-num-recs = trunc(p-num-recs, 0)
      383     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      384     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      385     .
      386     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      387     then
      388     assign
      389     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      390     p-rec-no = p-num-recs modulo 2340
      391     .
      392     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      393     then
      394     assign
      395     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      396     p-rec-no = p-num-recs modulo 2340
      397     .
      398     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      399     then
      400     assign
      401     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      402     p-rec-no2 = p-num-recs2 modulo 2978
      403     .
      404     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      405     then
      406     assign
      407     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      408     p-rec-no2 = p-num-recs2 modulo 2978
      409     .
      410     assign
      411     p-rec-no = p-rec-no + p-rec-no2 / 10000
      412     .
      413   end.
      414   if v-obj-num = 0 then v-obj-num = 100.
      415   return v-obj-num.
      416   END FUNCTION.
      417   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      418   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      419   if lookup (string(p-obj-num), '17':U) > 0 then do:
      420      if p-is-ptrl then
      421      return integer(entry(1, '26,27,28,29':U)).
      422      if not p-is-ptrl then
      423      return integer(entry(1, '16':U)).
      424   end.
      425   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      426   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      427   return 0.
      428   END FUNCTION.
      429   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      430   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      431   if lookup (string(p-obj-num), '17':U) > 0 then do:
      432     if p-is-ptrl then
      433     return integer(entry(1, '26,27,28,29':U)).
      434     if not p-is-ptrl then
      435     return integer(entry(1, '16':U)).
      436   end.
      437   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      438   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      439   return 0.
      440   END FUNCTION.
      441   PROCEDURE maria-put:
      442   define parameter buffer buf_cash-desk for ub.cash-desk.
      443   define input parameter p-out    as character no-undo .
      444   define input parameter p-fname as character no-undo .
      445   define input parameter p-by-record as logical no-undo .
      446   define input parameter p-shift-fields as integer no-undo .
      447   define input parameter p-binary as logical no-undo .
      448   define input parameter p-obj-num as integer no-undo .
      449   define input parameter p-max-records as integer no-undo .
      450   define input parameter p-plu as integer no-undo .
      451   define input parameter p-value as character no-undo .
      452   define variable v-file-name as character no-undo .
      453   define variable v-create as logical no-undo .
      454   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      455   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      456   output stream IBMSTREAM
      457   to value(v-file-name) append .
      458   Put  stream IBMSTREAM unformatted
      459   p-plu
      460   chr(3)
      461   p-value
      462   skip.
      463   output stream IBMSTREAM
      464   close.
      465   if not p-by-record then do:
      466     find first buf_temp-tekka-tsk where
      467               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      468     if not available buf_temp-tekka-tsk then do:
      469       v-create = yes.
      470     end.
      471   end.
      472   else do:
      473     find first buf_temp-tekka-tsk where
      474               buf_temp-tekka-tsk.filename  = v-file-name
      475           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      476     if not available buf_temp-tekka-tsk
      477     then do:
      478       find first buf_temp-tekka-tsk where
      479                 buf_temp-tekka-tsk.filename  = v-file-name
      480             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      481       if not available buf_temp-tekka-tsk
      482       then do:
      483         v-create = yes.
      484       end.
      485     end.
      486   end.
      487   if v-create then do:
      488     create buf_temp-tekka-tsk.
      489     assign
      490     buf_temp-tekka-tsk.filename = v-file-name
      491     buf_temp-tekka-tsk.range    = p-plu
      492     buf_temp-tekka-tsk.obj-num = p-obj-num
      493     buf_temp-tekka-tsk.obj-name = '':U
      494     buf_temp-tekka-tsk.num-records = 0
      495     buf_temp-tekka-tsk.max-records = p-max-records
      496     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      497     buf_temp-tekka-tsk.task-num = p-fname
      498     buf_temp-tekka-tsk.by-record = p-by-record
      499     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      500     buf_temp-tekka-tsk.binary = p-binary
      501     buf_temp-tekka-tsk.send-get = 'send'
      502     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      503     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      504     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      505     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      506                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      507                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      508                                 then 'local'
      509                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      510     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      511     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      512     buf_temp-tekka-tsk.waiting-sek = 30
      513     buf_temp-tekka-tsk.min-plu     = p-plu
      514     buf_temp-tekka-tsk.max-plu     = p-plu
      515     .
      516   end.
      517   assign
      518   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      519   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      520   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      521   .
      522   END PROCEDURE.
      523   PROCEDURE maria-get:
      524   define parameter buffer buf_cash-desk for ub.cash-desk.
      525   define input parameter p-out    as character no-undo .
      526   define input parameter p-fname as character no-undo .
      527   define input parameter p-by-record as logical no-undo .
      528   define input parameter p-obj-num as integer no-undo .
      529   define input parameter p-num-fields as integer no-undo .
      530   define input parameter p-max-records as integer no-undo .
      531   define input parameter p-min-plu as integer no-undo .
      532   define input parameter p-max-plu as integer no-undo .
      533   define input parameter p-other as character no-undo .
      534   define input parameter p-order-num as integer no-undo .
      535   define variable v-file-name as character no-undo .
      536   define variable v-secondary-obj-num as character no-undo .
      537   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      538   if p-by-record then do:
      539     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      540   end.
      541   else do:
      542     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      543   end.
      544   find first buf_temp-tekka-tsk where
      545             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      546   if not available buf_temp-tekka-tsk then do:
      547     create buf_temp-tekka-tsk.
      548     assign
      549     buf_temp-tekka-tsk.filename = v-file-name
      550     buf_temp-tekka-tsk.obj-num = p-obj-num
      551     buf_temp-tekka-tsk.obj-name = '':U
      552     buf_temp-tekka-tsk.max-records = p-max-records
      553     buf_temp-tekka-tsk.num-fields = p-num-fields
      554     buf_temp-tekka-tsk.task-num = p-fname
      555     buf_temp-tekka-tsk.by-record = p-by-record
      556     buf_temp-tekka-tsk.send-get = 'get'
      557     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      558     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      559     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      560     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      561                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      562                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      563                                   then 'local'
      564                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      565     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      566     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      567     buf_temp-tekka-tsk.waiting-sek = 30
      568     buf_temp-tekka-tsk.min-plu     = p-min-plu
      569     buf_temp-tekka-tsk.max-plu     = p-max-plu
      570     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      571                                       and p-max-plu <> ?
      572                                       then p-max-plu - p-min-plu + 1
      573                                       else 0)
      574     buf_temp-tekka-tsk.other-info = p-other
      575     buf_temp-tekka-tsk.order-num = p-order-num
      576     .
      577     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      578       assign
      579       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      580       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      581       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      582       no-error
      583       .
      584       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      585     end.
      586   end.
      587   END PROCEDURE.
      588   PROCEDURE maria-task:
      589   define parameter buffer buf_cash-desk for ub.cash-desk.
      590   define input parameter p-fname as character no-undo .
      591   define input parameter p-obj-num-list as character no-undo .
      592   define input parameter p-parameters as character no-undo .
      593   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      594   find first buf_temp-tekka-tsk where
      595             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      596   if not available buf_temp-tekka-tsk then do:
      597     create buf_temp-tekka-tsk.
      598     assign
      599     buf_temp-tekka-tsk.filename = ''
      600     buf_temp-tekka-tsk.range = 1
      601     buf_temp-tekka-tsk.obj-num = 0
      602     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      603     buf_temp-tekka-tsk.task-num = p-fname
      604     buf_temp-tekka-tsk.by-record = no
      605     buf_temp-tekka-tsk.send-get = 'task'
      606     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      607     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      608     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      609     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      610                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      611                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      612                                   then 'local'
      613                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      614     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      615     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      616     buf_temp-tekka-tsk.waiting-sek = 30
      617     buf_temp-tekka-tsk.other-info = p-parameters
      618     buf_temp-tekka-tsk.order-num = 0
      619     .
      620   end.
      621   END PROCEDURE.
      622   procedure tekkatsk-verify-schema :
      623   define input parameter p-obj-list as character no-undo .
      624   define input parameter p-dir-path as character no-undo .
      625   define variable v-obj-num as integer no-undo .
      626   define variable v-obj-name as character no-undo .
      627   define variable v-num-records as integer no-undo .
      628   define variable v-size_ as integer no-undo .
      629   define variable v-value as character no-undo .
      630   define variable ii as integer no-undo .
      631   define variable jj as integer no-undo .
      632   define variable ii-ibs as integer no-undo .
      633   define variable ii-tekka as integer no-undo .
      634   define variable v-result as character no-undo .
      635   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      636   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      637     do
      638     on error undo, return error
      639     :
      640        for each buf_temp-tekka-schema:
      641          delete buf_temp-tekka-schema.
      642        end.
      643        input from value('tekkasch.d').
      644        repeat :
      645          create buf_temp-tekka-schema.
      646          import buf_temp-tekka-schema.
      647          assign
      648          buf_temp-tekka-schema.host = 'IBS'
      649          ii = ii + 1.
      650          .
      651        end.
      652        input close.
      653        ii-ibs = ii.
      654         _ii:
      655         do ii = 1 to 256:
      656           if p-obj-list = "ALL"
      657           or lookup(string(ii), p-obj-list) > 0 then do:
      658             assign
      659             v-obj-num = 0
      660             v-obj-name = ''
      661             v-num-records = 0
      662             v-size_ = 0
      663             .
      664             run alienini-getkey in this-procedure (
      665                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      666                                                     ,input ('obj' + string(ii, '999'))
      667                                                     ,input 'oname'
      668                                                     ,output v-value) no-error .
      669             if v-value = ? then next _ii.
      670             assign
      671             v-obj-num = ii
      672             v-obj-name = v-value
      673             .
      674             run alienini-getkey in this-procedure (
      675                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      676                                                     ,input ('obj' + string(ii, '999'))
      677                                                     ,input 'size'
      678                                                     ,output v-value) no-error .
      679             assign
      680             v-num-records = integer(v-value) no-error  .
      681             if error-status:error
      682             or v-num-records = 0 then next _ii.
      683             run alienini-getkey in this-procedure (
      684                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      685                                                     ,input 'obj' + string(ii, '999')
      686                                                     ,input 'f000'
      687                                                     ,output v-value) no-error .
      688             assign
      689             v-size_ = integer(v-value) no-error  .
      690             if error-status:error
      691             or v-size_ = 0 then next _ii.
      692             _jj:
      693             do jj = 1 to 256:
      694               run alienini-getkey in this-procedure (
      695                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      696                                                       ,input 'obj' + string(ii, '999')
      697                                                       ,input 'f' + string(jj, '999')
      698                                                       ,output v-value) no-error .
      699               if v-value = ? then next _ii.
      700               create buf_temp-tekka-schema.
      701               assign
      702               buf_temp-tekka-schema.host = 'tekka'
      703               buf_temp-tekka-schema.obj-num = v-obj-num
      704               buf_temp-tekka-schema.obj-name = v-obj-name
      705               buf_temp-tekka-schema.num-records = v-num-records
      706               buf_temp-tekka-schema.size_ = v-size_
      707               buf_temp-tekka-schema.field-num = jj
      708               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      709               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      710                                                  then entry(2, entry(2, v-value, '#'), ':')
      711                                                  else '':U)
      712               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      713               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      714               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      715                                                           , 'C,I,I,I,D,D,D,D,D':U)
      716               no-error
      717               .
      718               if error-status:error then do:
      719                 delete buf_temp-tekka-schema.
      720                 next _jj.
      721               end.
      722               run alienini-getkey in this-procedure (
      723                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      724                                                       ,input 'obj' + string(ii, '999') + 'name'
      725                                                       ,input 'n' + string(jj, '999')
      726                                                       ,output v-value) no-error .
      727               if v-value <> ? then
      728               buf_temp-tekka-schema.field-name = v-value.
      729             end.
      730           end.
      731         end.
      732         ii-tekka = ii - 1.
      733        if p-obj-list <> 'ALL' then do:
      734         if ii-tekka <> ii-ibs then do:
      735           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      736                                   , ii-ibs
      737                                   , ii-tekka).
      738         end.
      739        end.
      740        for each buf_temp-tekka-schema where
      741               buf_temp-tekka-schema.host = 'tekka':
      742          find first buf2_temp-tekka-schema where
      743                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      744                AND buf2_temp-tekka-schema.host = 'ibs'
      745                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      746          if not available buf2_temp-tekka-schema then do:
      747           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      748                                   , buf_temp-tekka-schema.field-num
      749                                   , buf_temp-tekka-schema.obj-num).
      750          end.
      751          buffer-compare buf_temp-tekka-schema
      752          to buf2_temp-tekka-schema
      753          save result in v-result.
      754          if v-result <> '':U then do:
      755           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      756                                   , buf_temp-tekka-schema.field-num
      757                                   , buf_temp-tekka-schema.obj-num).
      758          end.
      759        end.
      760     end.
      761   end procedure.
      762   FUNCTION set-Sx returns character (input p-string as character):
      763   return p-string.
      764   END FUNCTION.
      765   FUNCTION get-Sx returns character (input p-string  as character):
      766   return p-string.
      767   END FUNCTION.
      768   FUNCTION set-B returns character (input p-string  as character):
      769   return chr(integer(p-string)).
      770   END FUNCTION.
      771   FUNCTION get-B returns character (input p-string  as character):
      772   return string(asc(p-string)).
      773   END FUNCTION.
      774   FUNCTION set-BF returns character (input p-string  as character):
      775   define variable v-dopi as integer no-undo .
      776   define variable ii as integer no-undo .
      777   do ii = 1 to 8:
      778     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      779   end.
      780   return chr(v-dopi).
      781   END FUNCTION.
      782   FUNCTION get-BF returns character (input p-string  as character):
      783   define variable v-dopi as integer no-undo .
      784   define variable v-dops as character no-undo .
      785   define variable ii as integer no-undo .
      786   v-dopi = asc(p-string).
      787   do ii = 8 to 1 BY -1:
      788     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      789   end.
      790   return v-dops.
      791   END FUNCTION.
      792   FUNCTION set-BN returns character (input p-string  as character
      793                                     ,input p-bin-group as character):
      794   define variable v-dopi as integer no-undo .
      795   define variable ii as integer no-undo .
      796   define variable jj as integer no-undo .
      797   define variable v-grp-nums as integer no-undo .
      798   define variable v-dopi2 as integer no-undo .
      799   v-grp-nums = num-entries(p-bin-group).
      800   do jj = 0 to v-grp-nums - 1:
      801     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      802     do ii = 1 to 8:
      803       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      804     end.
      805   end.
      806   return chr(v-dopi).
      807   END FUNCTION.
      808   FUNCTION get-BN returns character (input p-string  as character
      809                                     ,input p-bin-group as character):
      810   define variable v-dopi as integer no-undo .
      811   define variable v-dops as character no-undo .
      812   define variable v-grp-nums as integer no-undo .
      813   define variable ii as integer no-undo .
      814   define variable jj as integer no-undo .
      815   v-dopi = asc(p-string).
      816   v-grp-nums = num-entries(p-bin-group).
      817   do jj = 1 to v-grp-nums:
      818   do ii = 8 to 1 BY -1:
      819     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      820   end.
      821   end.
      822   return v-dops.
      823   END FUNCTION.
      824   procedure fill-temp-cd :
      825   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
      826   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      827   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      828   define input parameter p-clear-table as logical no-undo .
      829   define buffer buf_temp-cd for temp-cd.
      830   define buffer buf_cash-desk for ub.cash-desk.
      831     do
      832     on error undo, return error
      833     :
      834        if p-clear-table  then do:
      835          for each buf_temp-cd:
      836            delete buf_temp-cd.
      837          end.
      838        end.
      839        for each buf_cash-desk no-lock where
      840               buf_cash-desk.db-num = p-db-num
      841           AND buf_cash-desk.obj-code = p-obj-code
      842           and buf_cash-desk.cash-on  = yes
      843        BREAK by buf_cash-desk.pos-type:
      844          if first-of(buf_cash-desk.pos-type) then do:
      845            create buf_temp-cd.
      846            buffer-copy buf_cash-desk to buf_temp-cd.
      847          end.
      848        end.
      849     end.
      850   end procedure.
      851   define variable vss-include-info6 as character format "X(65)" no-undo
      852   initial "@(#)$Workfile$ $Revision$".
      853   define variable v-bgelib-bgefmt        as character         no-undo.
      854   define variable v-bgelib-bgeflold      as character         no-undo.
      855   define stream stmXMLOut.
      856   define stream stmXMLLog.
      857   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   procedure cur-time :
      859      define output parameter p-today as date      no-undo .
      860      define output parameter p-time  as integer   no-undo .
      861     do
      862     on error undo, return error
      863     :
      864       define variable v-date1 as date      no-undo .
      865       define variable v-date2 as date      no-undo .
      866       define variable v-time  as integer   no-undo .
      867       assign
      868         v-date1 = today
      869         v-time  = time
      870         v-date2 = today
      871       .
      872       if v-date1 <> v-date2
      873       then do:
      874         assign
      875           v-date1 = today
      876           v-time  = v-time
      877         .
      878       end.
      879       assign
      880         p-today = v-date1
      881         p-time  = v-time
      882       .
      883     end.
      884   end.
      885   function cur-time-date returns character
      886   :
      887     return string(today, '99/99/9999':U) .
      888   end.
      889   function cur-time-mjd returns decimal
      890   :
      891     define variable v-date as date      no-undo .
      892     define variable v-time as integer   no-undo .
      893     run cur-time in this-procedure
      894       (output v-date
      895       ,output v-time
      896       ) .
      897     return integer(v-date) - 2400002 + (v-time / 86400) .
      898   end.
      899   function cur-time-get-ending-index returns integer
      900   (input p-number as integer
      901   )
      902   :
      903     if p-number < 0
      904     or p-number = ?
      905     then do:
      906       return 1 .
      907     end.
      908     define variable v-rest as integer   no-undo .
      909     assign
      910       p-number = p-number modulo 100
      911     .
      912     if p-number < 20
      913     then do:
      914       assign
      915         v-rest = p-number
      916       .
      917     end.
      918     else do:
      919       assign
      920         v-rest = p-number modulo 10
      921       .
      922     end.
      923     case v-rest :
      924       when 1
      925       then do:
      926         return 2 .
      927       end.
      928       when 2 or
      929       when 3 or
      930       when 4
      931       then do:
      932         return 3 .
      933       end.
      934       otherwise do:
      935         return 1 .
      936       end.
      937     end case .
      938   end.
      939   procedure cur-time-mjd-to-date :
      940      define input  parameter i-mjd-diff as decimal no-undo.
      941      define output parameter o-Date     as date    no-undo.
      942      define output parameter o-Time     as integer no-undo.
      943      define variable v-day-number as integer   no-undo .
      944      if    i-mjd-diff < 0
      945         or i-mjd-diff = ?
      946      then do:
      947         return "?" .
      948      end.
      949      assign
      950         v-day-number = truncate(i-mjd-diff,0).
      951         o-Date = date(v-day-number + 2400002).
      952         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      953     .
      954   end.
      955   function cur-time-mjd-to-string returns character
      956   (input p-mjd-diff as decimal
      957   )
      958   :
      959     define variable v-day-number as integer   no-undo .
      960     define variable v-seconds    as integer   no-undo .
      961     define variable v-hour       as integer   no-undo .
      962     define variable v-min        as integer   no-undo .
      963     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      964     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      965     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      966     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      967     if p-mjd-diff < 0
      968     or p-mjd-diff = ?
      969     then do:
      970       return "?" .
      971     end.
      972     assign
      973       v-day-number = integer(truncate(p-mjd-diff,0))
      974       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      975     .
      976     if v-seconds > 86400
      977     then do:
      978       assign
      979         v-seconds = 86400 - 1
      980       .
      981     end.
      982     if v-seconds < 0
      983     then do:
      984       assign
      985         v-seconds = 0
      986       .
      987     end.
      988     assign
      989       v-hour = truncate(v-seconds / 3600, 0)
      990     .
      991     assign
      992       v-seconds = v-seconds modulo 3600
      993     .
      994     assign
      995       v-min = truncate(v-seconds / 60, 0)
      996     .
      997     assign
      998       v-seconds = v-seconds modulo 60
      999     .
     1000     return
     1001         (if v-day-number <> 0
     1002           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1003           else ""
     1004         )
     1005       + (if v-day-number <> 0 or v-hour <> 0
     1006           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1007           else ""
     1008         )
     1009       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1010           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1011           else ""
     1012         )
     1013       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1014       .
     1015   end.
     1016   function cur-time-string returns character
     1017   :
     1018     define variable v-date as date      no-undo .
     1019     define variable v-time as integer   no-undo .
     1020     run cur-time in this-procedure
     1021       (output v-date
     1022       ,output v-time
     1023       ) .
     1024     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1025   end.
     1026   function cur-time-string-sec returns character
     1027   :
     1028     define variable v-date as date      no-undo .
     1029     define variable v-time as integer   no-undo .
     1030     run cur-time in this-procedure
     1031       (output v-date
     1032       ,output v-time
     1033       ) .
     1034     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1035   end.
     1036   function cur-time-custom  returns character
     1037   (input p-prefix as character
     1038   ,input p-date-format as character
     1039   ,input p-delimiter as character
     1040   ,input p-time-format as character
     1041   ,input p-suffix as character
     1042   )
     1043   :
     1044     define variable v-date as date      no-undo .
     1045     define variable v-time as integer   no-undo .
     1046     run cur-time in this-procedure
     1047       (output v-date
     1048       ,output v-time
     1049       ) .
     1050     return
     1051       p-prefix
     1052       + string(v-date, p-date-format)
     1053       + p-delimiter
     1054       + string(v-time, p-time-format)
     1055       + p-suffix
     1056       .
     1057   end.
     1058   function cur-time-print  returns character
     1059   :
     1060     define variable v-date as date      no-undo .
     1061     define variable v-time as integer   no-undo .
     1062     run cur-time in this-procedure
     1063       (output v-date
     1064       ,output v-time
     1065       ) .
     1066     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1067   end.
     1068   function cur-time-datetime returns datetime
     1069   :
     1070     define variable v-char as character no-undo .
     1071     define variable v-datetime as datetime no-undo .
     1072     v-char = cur-time-string().
     1073     v-datetime = datetime(v-char).
     1074     return  v-datetime.
     1075   end.
     1076   function cur-time-string-msec returns character
     1077   :
     1078     define variable v-date as datetime  no-undo .
     1079     v-date = now.
     1080     return string(v-date) .
     1081   end.
     1082   define variable vss-include-info8 as character format "X(65)" no-undo
     1083   initial "@(#)$Workfile$ $Revision$".
     1084   procedure xmlchar-test :
     1085   define input parameter p-in-string          as character        no-undo.
     1086   define output parameter p-out-string-enc    as character        no-undo.
     1087   define output parameter p-out-string-dec    as character        no-undo.
     1088   do
     1089   on error undo, return error
     1090   :
     1091          run xmlchar-encode in this-procedure
     1092       (
     1093             input p-in-string
     1094           , output p-out-string-enc
     1095       ).
     1096          run xmlchar-decode in this-procedure
     1097       (
     1098             input p-out-string-enc
     1099           , output p-out-string-dec
     1100       ).
     1101   end.
     1102   end .
     1103   procedure xmlchar-encode :
     1104   define input parameter p-in-string      as character        no-undo.
     1105   define output parameter p-out-string    as character        no-undo.
     1106       define variable v-position      as integer      no-undo.
     1107       define variable v-current-char  as character    no-undo.
     1108   do
     1109   on error undo, return error
     1110   :
     1111       assign
     1112           p-out-string = "":U
     1113       .
     1114       case p-in-string
     1115       :
     1116           when ?
     1117           then do:
     1118               assign
     1119                   p-out-string = "?":U
     1120               .
     1121           end.
     1122           when "?":U
     1123           then do:
     1124               assign
     1125                   p-out-string = "&#63;":U
     1126               .
     1127           end.
     1128           otherwise do:
     1129               do v-position = 1 to length( p-in-string )
     1130               :
     1131                   assign
     1132                       v-current-char = substring( p-in-string, v-position, 1 )
     1133                   .
     1134                   case v-current-char
     1135                   :
     1136                       when "&":U
     1137                       then do:
     1138                           assign
     1139                               p-out-string = p-out-string + "&amp;":U
     1140                           .
     1141                       end.
     1142                       when ">":U
     1143                       then do:
     1144                           assign
     1145                               p-out-string = p-out-string + "&gt;":U
     1146                           .
     1147                       end.
     1148                       when "<":U
     1149                       then do:
     1150                           assign
     1151                               p-out-string = p-out-string + "&lt;":U
     1152                           .
     1153                       end.
     1154                       when "'":U
     1155                       then do:
     1156                           assign
     1157                               p-out-string = p-out-string + "&apos;":U
     1158                           .
     1159                       end.
     1160                       when '"':U
     1161                       then do:
     1162                           assign
     1163                               p-out-string = p-out-string + "&quot;":U
     1164                           .
     1165                       end.
     1166                       when chr(1)
     1167                       then do:
     1168                           assign
     1169                               p-out-string = p-out-string + "":U
     1170                           .
     1171                       end.
     1172                       when chr(2)
     1173                       then do:
     1174                           assign
     1175                               p-out-string = p-out-string + "":U
     1176                           .
     1177                       end.
     1178                       when chr(3)
     1179                       then do:
     1180                           assign
     1181                               p-out-string = p-out-string + "":U
     1182                           .
     1183                       end.
     1184                       when chr(4)
     1185                       then do:
     1186                           assign
     1187                               p-out-string = p-out-string + "":U
     1188                           .
     1189                       end.
     1190                       when chr(5)
     1191                       then do:
     1192                           assign
     1193                               p-out-string = p-out-string + "":U
     1194                           .
     1195                       end.
     1196                       when chr(6)
     1197                       then do:
     1198                           assign
     1199                               p-out-string = p-out-string + "":U
     1200                           .
     1201                       end.
     1202                       when chr(7)
     1203                       then do:
     1204                           assign
     1205                               p-out-string = p-out-string + "":U
     1206                           .
     1207                       end.
     1208                       when chr(8)
     1209                       then do:
     1210                           assign
     1211                               p-out-string = p-out-string + "":U
     1212                           .
     1213                       end.
     1214                       when chr(9)
     1215                       then do:
     1216                           assign
     1217                               p-out-string = p-out-string + "":U
     1218                           .
     1219                       end.
     1220                       when chr(29)
     1221                       then do:
     1222                           assign
     1223                               p-out-string = p-out-string + "":U
     1224                           .
     1225                       end.
     1226                       when chr(10)
     1227                       then do:
     1228                           assign
     1229                               p-out-string = p-out-string + "&#10;":U
     1230                           .
     1231                       end.
     1232                       when chr(13)
     1233                       then do:
     1234                           assign
     1235                               p-out-string = p-out-string + "&#13;":U
     1236                           .
     1237                       end.
     1238                       otherwise do:
     1239                           assign
     1240                               p-out-string = p-out-string + v-current-char
     1241                           .
     1242                       end.
     1243                   end case.
     1244               end.
     1245           end.
     1246       end case.
     1247   end.
     1248   end .
     1249   procedure xmlchar-encode-1c :
     1250   define input parameter p-in-string      as character        no-undo.
     1251   define output parameter p-out-string    as character        no-undo.
     1252       define variable v-position      as integer      no-undo.
     1253       define variable v-current-char  as character    no-undo.
     1254   do
     1255   on error undo, return error
     1256   :
     1257       assign
     1258           p-out-string = "":U
     1259       .
     1260       case p-in-string
     1261       :
     1262           when ?
     1263           then do:
     1264               assign
     1265                   p-out-string = "?":U
     1266               .
     1267           end.
     1268           otherwise do:
     1269               do v-position = 1 to length( p-in-string )
     1270               :
     1271                   assign
     1272                       v-current-char = substring( p-in-string, v-position, 1 )
     1273                   .
     1274                   case v-current-char
     1275                   :
     1276                       when chr(1)
     1277                       then do:
     1278                           assign
     1279                               p-out-string = p-out-string + " ":U
     1280                           .
     1281                       end.
     1282                       when chr(2)
     1283                       then do:
     1284                           assign
     1285                               p-out-string = p-out-string + " ":U
     1286                           .
     1287                       end.
     1288                       when chr(3)
     1289                       then do:
     1290                           assign
     1291                               p-out-string = p-out-string + " ":U
     1292                           .
     1293                       end.
     1294                       when chr(4)
     1295                       then do:
     1296                           assign
     1297                               p-out-string = p-out-string + " ":U
     1298                           .
     1299                       end.
     1300                       when chr(5)
     1301                       then do:
     1302                           assign
     1303                               p-out-string = p-out-string + " ":U
     1304                           .
     1305                       end.
     1306                       when chr(6)
     1307                       then do:
     1308                           assign
     1309                               p-out-string = p-out-string + " ":U
     1310                           .
     1311                       end.
     1312                       when chr(7)
     1313                       then do:
     1314                           assign
     1315                               p-out-string = p-out-string + " ":U
     1316                           .
     1317                       end.
     1318                       when chr(8)
     1319                       then do:
     1320                           assign
     1321                               p-out-string = p-out-string + " ":U
     1322                           .
     1323                       end.
     1324                       when chr(9)
     1325                       then do:
     1326                           assign
     1327                               p-out-string = p-out-string + " ":U
     1328                           .
     1329                       end.
     1330                       when chr(29)
     1331                       then do:
     1332                           assign
     1333                               p-out-string = p-out-string + " ":U
     1334                           .
     1335                       end.
     1336                       when chr(10)
     1337                       then do:
     1338                           assign
     1339                               p-out-string = p-out-string + " ":U
     1340                           .
     1341                       end.
     1342                       when chr(13)
     1343                       then do:
     1344                           assign
     1345                               p-out-string = p-out-string + " ":U
     1346                           .
     1347                       end.
     1348                       otherwise do:
     1349                           assign
     1350                               p-out-string = p-out-string + v-current-char
     1351                           .
     1352                       end.
     1353                   end case.
     1354               end.
     1355           end.
     1356       end case.
     1357   end.
     1358   end .
     1359   procedure xmlchar-decode :
     1360   define input parameter p-in-string      as character        no-undo.
     1361   define output parameter p-out-string    as character        no-undo.
     1362       define variable v-position      as integer      no-undo.
     1363       define variable v-last-position as integer      no-undo.
     1364       define variable v-temp-integer  as integer      no-undo.
     1365       define variable v-current-char  as character    no-undo.
     1366       define variable v-next-char     as character    no-undo.
     1367       define variable v-success       as logical      no-undo.
     1368   do
     1369   on error undo, return error
     1370   :
     1371       assign
     1372           p-out-string = "":U
     1373           v-position   = 0
     1374       .
     1375       replace-cycle:
     1376       do while yes
     1377       on error undo, return error
     1378       :
     1379           assign
     1380               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1381           .
     1382           if v-last-position <= v-position
     1383           then do:
     1384               if v-position = 0
     1385               then do:
     1386                   assign
     1387                       p-out-string = p-in-string
     1388                   .
     1389               end.
     1390               else do:
     1391                   assign
     1392                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1393                   .
     1394               end.
     1395               leave replace-cycle.
     1396           end.
     1397           else do:
     1398               assign
     1399                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1400                   v-position      = v-last-position
     1401                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1402               .
     1403               if v-current-char = "#":U
     1404               then do:
     1405                   assign
     1406                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1407                   .
     1408                   if v-last-position > 0
     1409                   then do:
     1410                       run xmlchar-read-integer in this-procedure
     1411                        (
     1412                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1413                           , output v-temp-integer
     1414                           , output v-success
     1415                       ).
     1416                       if v-success = yes
     1417                       and v-temp-integer >= 1
     1418                       and v-temp-integer <= 255
     1419                       then do:
     1420                           assign
     1421                               p-out-string = p-out-string + chr( v-temp-integer )
     1422                               v-position   = v-last-position + 1
     1423                           .
     1424                       end.
     1425                       else do:
     1426                           assign
     1427                               p-out-string = p-out-string + "&":U
     1428                               v-position   = v-position   + 1
     1429                           .
     1430                       end.
     1431                   end.
     1432                   else do:
     1433                       assign
     1434                           p-out-string = p-out-string + "&":U
     1435                           v-position   = v-position   + 1
     1436                       .
     1437                   end.
     1438               end.
     1439               else do:
     1440                   case substring( p-in-string, v-position + 1, 3 )
     1441                   :
     1442                       when "lt;":U
     1443                       then do:
     1444                           assign
     1445                               p-out-string = p-out-string + "<":U
     1446                               v-position   = v-position   + 3
     1447                           .
     1448                       end.
     1449                       when "gt;":U
     1450                       then do:
     1451                           assign
     1452                               p-out-string = p-out-string + ">":U
     1453                               v-position   = v-position   + 3
     1454                           .
     1455                       end.
     1456                       otherwise do:
     1457                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1458                           then do:
     1459                               assign
     1460                                   p-out-string = p-out-string + "&":U
     1461                                   v-position   = v-position   + 4
     1462                               .
     1463                           end.
     1464                           else do:
     1465                               case substring( p-in-string, v-position + 1, 5 )
     1466                               :
     1467                                   when "quot;":U
     1468                                   then do:
     1469                                       assign
     1470                                           p-out-string = p-out-string + '"':U
     1471                                           v-position   = v-position   + 5
     1472                                       .
     1473                                   end.
     1474                                   when "apos;":U
     1475                                   then do:
     1476                                       assign
     1477                                           p-out-string = p-out-string + "'":U
     1478                                           v-position   = v-position   + 5
     1479                                       .
     1480                                   end.
     1481                                   otherwise do:
     1482                                       assign
     1483                                           p-out-string = p-out-string + "&":U
     1484                                       .
     1485                                   end.
     1486                               end case.
     1487                           end.
     1488                       end.
     1489                   end case.
     1490               end.
     1491           end.
     1492       end.
     1493   end.
     1494   end .
     1495   procedure xmlchar-read-integer :
     1496   define input parameter p-input-string      as character        no-undo.
     1497   define output parameter p-output-integer   as integer          no-undo.
     1498   define output parameter p-success       as logical          no-undo.
     1499   do
     1500   on error undo, return error
     1501   :
     1502       assign
     1503           p-output-integer = integer( p-input-string )
     1504       no-error.
     1505       if error-status :error
     1506       then do:
     1507           assign
     1508               p-success           = no
     1509               p-output-integer    = 0
     1510           .
     1511       end.
     1512       else do:
     1513           assign
     1514               p-success           = yes
     1515           .
     1516       end.
     1517   end.
     1518   end.
     1519   define variable v-bgelib-bgeclall           as logical      no-undo.
     1520   define variable v-bgelib-bgedict            as logical      no-undo.
     1521   define temp-table temp_ext-doc-type no-undo
     1522       field edt-key               as integer
     1523       field ext-doc-type          as character
     1524       field ext-doc-type-label    as character
     1525       index pi is primary unique
     1526           edt-key
     1527   .
     1528   define temp-table temp_bgelib_goods no-undo
     1529       field gds-code as integer
     1530       index pi is primary unique
     1531           gds-code
     1532   .
     1533   define temp-table temp_bgelib_clients no-undo
     1534       field obj-type as character
     1535       field obj-code as integer
     1536       index pi is primary unique
     1537           obj-type
     1538           obj-code
     1539   .
     1540   define temp-table temp_bgelib_dis-card no-undo
     1541       field d-card as character
     1542       index pi is primary unique
     1543           d-card
     1544   .
     1545   define temp-table temp_bgelib_trn-doc no-undo
     1546       field doc-code as integer
     1547   .
     1548   procedure bgelib-tag-open:
     1549   do
     1550   on error undo, return error
     1551   :
     1552   define input parameter v-tag-level  as integer      no-undo.
     1553   define input parameter v-tag-name   as character    no-undo.
     1554   define input parameter v-tag-value  as character    no-undo.
     1555       put stream stmXMLOut unformatted
     1556           chr(10)
     1557           + fill(" ", 4 * v-tag-level)
     1558           + "<" + v-tag-name
     1559           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1560           + v-tag-value + ">"
     1561       .
     1562   end.
     1563   end procedure.
     1564   procedure bgelib-tag-put:
     1565   do
     1566   on error undo, return error
     1567   :
     1568   define input parameter v-tag-level      as integer      no-undo.
     1569   define input parameter v-tag-name       as character    no-undo.
     1570   define input parameter v-tag-value      as character    no-undo.
     1571   define input parameter v-empty-mode     as integer      no-undo.
     1572       v-tag-name = trim(v-tag-name).
     1573       if  v-empty-mode = 1
     1574       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1575       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1576       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1577       then do:
     1578           run xmlchar-encode in this-procedure (
     1579                 input v-tag-value
     1580               , output v-tag-value
     1581           ).
     1582           put stream stmXMLOut unformatted
     1583               chr(10) + fill(" ", 4 * v-tag-level)
     1584                           + '<' + v-tag-name + '>'
     1585                           + v-tag-value
     1586                           + '</' + v-tag-name + '>'
     1587           .
     1588       end.
     1589   end.
     1590   end procedure.
     1591   procedure bgelib-tag-close:
     1592   do
     1593   on error undo, return error
     1594   :
     1595   define input parameter v-tag-level as integer      no-undo.
     1596   define input parameter v-tag-name  as character    no-undo.
     1597       put stream stmXMLOut unformatted
     1598           chr(10)
     1599           + fill( " ", 4 * v-tag-level)
     1600           + '</' + v-tag-name + '>'
     1601       .
     1602   end.
     1603   end procedure.
     1604   procedure bgelib-write-log:
     1605   do
     1606   on error undo, return error
     1607   :
     1608   define input parameter v-filename   as character    no-undo.
     1609   define input parameter v-log-level  as integer      no-undo.
     1610   define input parameter v-out-string as character    no-undo.
     1611       output stream stmXMLLog to value( v-filename ) append.
     1612       put stream stmXMLLog unformatted
     1613           chr(10)
     1614       .
     1615       put stream stmXMLLog unformatted
     1616           ( if v-log-level = 0
     1617             or v-out-string = "&DLine"
     1618             or v-out-string = "&Line"
     1619             then ""
     1620             else cur-time-string-sec() + " " )
     1621       .
     1622       put stream stmXMLLog unformatted
     1623           ( if v-out-string = "&Line"
     1624             then fill( "-", 80 )
     1625             else if v-out-string = "&DLine"
     1626                  then fill( "=", 80 )
     1627                  else v-out-string )
     1628       .
     1629       output stream stmXMLLog close.
     1630   end.
     1631   end procedure.
     1632   procedure bgelib-write-edt:
     1633   do
     1634   on error undo, return error
     1635   :
     1636   define input parameter v-editor-handle    as handle       no-undo.
     1637   define input parameter v-log-level        as integer      no-undo.
     1638   define input parameter v-out-string       as character    no-undo.
     1639       if valid-handle ( v-editor-handle )
     1640       then do:
     1641           v-editor-handle :move-to-eof().
     1642           v-editor-handle :insert-string( ( if v-log-level = 0
     1643                                             or v-out-string = "&DLine"
     1644                                             or v-out-string = "&Line"
     1645                                             then ""
     1646                                             else cur-time-string-sec() + " "
     1647                                         ) ).
     1648           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1649                                             then fill( "-", 80 )
     1650                                             else if v-out-string = "&DLine" then fill("=", 80)
     1651                                             else fill( " ", v-log-level) + v-out-string
     1652                                         ) ).
     1653           v-editor-handle :insert-string( chr(10) ).
     1654       end.
     1655       process events.
     1656       output to 'bgescn.txt' append.
     1657           put unformatted
     1658               chr(10)
     1659               string( ( if v-log-level = 0
     1660                         or v-out-string = "&DLine"
     1661                         or v-out-string = "&Line"
     1662                         then ""
     1663                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1664                     ) )
     1665               string( ( if v-out-string = "&Line"
     1666                         then fill( "-", 80 )
     1667                         else if v-out-string = "&DLine"
     1668                              then fill( "=", 80 )
     1669                              else fill( " ", v-log-level ) + v-out-string
     1670                     ) )
     1671           .
     1672       output close.
     1673   end.
     1674   end procedure.
     1675   procedure bgelib-show-cnt:
     1676   do
     1677   on error undo, return error
     1678   :
     1679   define input parameter v-fillin-handle     as handle   no-undo.
     1680       if valid-handle( v-fillin-handle )
     1681       then do:
     1682           assign
     1683               v-fillin-handle :visible = true
     1684           .
     1685       end.
     1686   end.
     1687   end procedure.
     1688   procedure bgelib-hide-cnt:
     1689   do
     1690   on error undo, return error
     1691   :
     1692   define input parameter v-fillin-handle     as handle   no-undo.
     1693       if valid-handle( v-fillin-handle )
     1694       then do:
     1695           assign v-fillin-handle :visible = false.
     1696       end.
     1697   end.
     1698   end procedure.
     1699   procedure bgelib-write-cnt:
     1700   do
     1701   on error undo, return error
     1702   :
     1703   define input parameter v-fillin-handle    as handle       no-undo.
     1704   define input parameter v-fillin-string    as character    no-undo.
     1705       if valid-handle( v-fillin-handle )
     1706       then do:
     1707           assign
     1708               v-fillin-handle :SCREEN-value = v-fillin-string
     1709           .
     1710       end.
     1711   end.
     1712   end procedure.
     1713   procedure bgelib-write-header:
     1714   do
     1715   on error undo, return error
     1716   :
     1717   define input parameter p-first-file     as logical      no-undo.
     1718   define input parameter p-xml-file-name  as character    no-undo.
     1719   define input parameter p-list-file-name as character    no-undo.
     1720   define input parameter p-file-number    as integer      no-undo.
     1721   define input parameter p-have-prev      as logical      no-undo.
     1722   define input parameter p-prev-filename  as character    no-undo.
     1723   define input parameter p-obj-list       as character    no-undo.
     1724   define input parameter p-doc-type-list  as character    no-undo.
     1725   define input parameter p-parameter-list as character    no-undo.
     1726       define variable v-counter    as integer        no-undo.
     1727       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1728       put stream stmXMLOut unformatted
     1729           "<?xml version='1.0' encoding='windows-1251'?>"
     1730       .
     1731       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1732       run bgelib-tag-open( input 0, input "header", input "" ).
     1733       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1734       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1735       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1736       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1737       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1738       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1739       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1740       :
     1741           run bgelib-tag-put(
     1742                 input 1
     1743               , input entry( 2 * v-counter, p-parameter-list )
     1744               , input entry( 2 * v-counter + 1, p-parameter-list )
     1745               , input 0
     1746           ).
     1747       end.
     1748       run bgelib-tag-close( input 0, input "header" ).
     1749       output stream stmXMLOut close.
     1750       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1751       if p-first-file = yes
     1752       then do:
     1753           put stream stmXMLOut unformatted
     1754               "<?xml version='1.0' encoding='windows-1251'?>"
     1755           .
     1756           run bgelib-tag-open( input 0, input "export", input "" ).
     1757       end.
     1758       run bgelib-tag-open( input 1, input "file", input "" ).
     1759       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1760       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1761       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1762       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1763       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1764       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1765       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1766       :
     1767           run bgelib-tag-put(
     1768                 input 2
     1769               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1770               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1771               , input 0
     1772           ).
     1773       end.
     1774       run bgelib-tag-close( input 1, input "file" ).
     1775       output stream stmXMLOut close.
     1776   end.
     1777   end procedure.
     1778   procedure bgelib-write-footer:
     1779   do
     1780   on error undo, return error
     1781   :
     1782   define input parameter p-last-file      as logical      no-undo.
     1783   define input parameter p-xml-file-name  as character    no-undo.
     1784   define input parameter p-list-file-name as character    no-undo.
     1785   define input parameter p-have-next      as logical      no-undo.
     1786   define input parameter p-next-file-name as character    no-undo.
     1787       define variable v-error-num     as integer           no-undo.
     1788       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1789       if p-have-next = yes
     1790       then do:
     1791           run bgelib-tag-open( input 0, input "footer", "" ).
     1792           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1793           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1794           run bgelib-tag-close( input 0, input "footer" ).
     1795       end.
     1796       run bgelib-tag-close( input 0, input "root" ).
     1797       output stream stmXMLOut close.
     1798       run bge/os_copy.p (
     1799             input "M"
     1800           , input p-xml-file-name + "tmp"
     1801           , input p-xml-file-name + "xml"
     1802           , output v-error-num
     1803       ).
     1804       if p-last-file = yes
     1805       then do:
     1806           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1807               run bgelib-tag-close( input 0, input "export" ).
     1808           output stream stmXMLOut close.
     1809           run bge/os_copy.p (
     1810                 input "M"
     1811               , input p-list-file-name + "tmp"
     1812               , input p-list-file-name + "xml"
     1813               , output v-error-num
     1814           ).
     1815       end.
     1816   end.
     1817   end procedure.
     1818   procedure bgelib-filename :
     1819   do
     1820   on error undo, return error
     1821   :
     1822   define input parameter p-prefix             as character    no-undo.
     1823   define output parameter p-xml-file-name     as character    no-undo.
     1824   define output parameter p-log-file-name     as character    no-undo.
     1825   define output parameter p-list-file-name    as character    no-undo.
     1826       define variable v-home-dir  as character    no-undo.
     1827       define variable v-error-num as integer      no-undo.
     1828       get-key-value section "BGE" key "outdir" value v-home-dir.
     1829       if v-home-dir = ?
     1830       then do:
     1831           message
     1832             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1833             skip(1)
     1834             skip "Обратитесь к администратору."
     1835           view-as alert-box error.
     1836           undo, return error .
     1837       end.
     1838       run gbl/dir-cre.p (
     1839           input v-home-dir
     1840       ) no-error.
     1841       if error-status :error
     1842       then do:
     1843           message
     1844             skip "Неверно задан каталог экспорта."
     1845             skip(1)
     1846             skip "Обратитесь к администратору."
     1847           view-as alert-box error.
     1848           undo, return error .
     1849       end.
     1850       run bge/genfname.p (
     1851             input v-home-dir
     1852           , input p-prefix
     1853           , input ""
     1854           , input "xml"
     1855           , input "tmp"
     1856           , output p-xml-file-name
     1857       ).
     1858       assign
     1859           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1860           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1861           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1862       .
     1863   end.
     1864   end procedure.
     1865   procedure bgelib-read-config :
     1866   do
     1867   on error undo, return error
     1868   :
     1869   define variable v-par-type as character     no-undo.
     1870     define variable v-param-type      as character  no-undo .
     1871     define variable v-value-character as character  no-undo .
     1872     define variable v-value-date      as date       no-undo .
     1873     define variable v-value-decimal   as decimal    no-undo .
     1874     define variable v-value-integer   as integer    no-undo .
     1875     define variable v-value-logical   as logical    no-undo .
     1876     define variable v-tth             as handle     no-undo .
     1877       assign
     1878           v-bgelib-bgeclall = no
     1879           v-bgelib-bgedict  = no
     1880       .
     1881       run adm/shattri.p ( input "get":U
     1882                         , input  '':u
     1883                         , input  0
     1884                         , input  'bge-export':U
     1885                         , input  'bgeclall':U
     1886                         , output v-value-character
     1887                         , output v-value-date
     1888                         , output v-value-decimal
     1889                         , output v-value-integer
     1890                         , output v-value-logical
     1891                         , output v-param-type
     1892                         , input-output table-handle v-tth
     1893                         ) no-error .
     1894       if error-status :error
     1895       then do:
     1896         assign
     1897           v-bgelib-bgeclall = no
     1898         .
     1899       end.
     1900       else do:
     1901         assign
     1902           v-bgelib-bgeclall = v-value-logical
     1903         .
     1904       end.
     1905       delete object v-tth.
     1906       run adm/shattri.p ( input "get":U
     1907                         , input  '':u
     1908                         , input  0
     1909                         , input  'bge-export':U
     1910                         , input  'bgedict':U
     1911                         , output v-value-character
     1912                         , output v-value-date
     1913                         , output v-value-decimal
     1914                         , output v-value-integer
     1915                         , output v-value-logical
     1916                         , output v-param-type
     1917                         , input-output table-handle v-tth
     1918                         ) no-error .
     1919       if error-status :error
     1920       then do:
     1921         assign
     1922           v-bgelib-bgedict = no
     1923         .
     1924       end.
     1925       else do:
     1926         assign
     1927           v-bgelib-bgedict = v-value-logical
     1928         .
     1929       end.
     1930       delete object v-tth.
     1931       run adm/shattri.p ( input "get":U
     1932                         , input  '':u
     1933                         , input  0
     1934                         , input  'bge-export':U
     1935                         , input  'bgefmt':U
     1936                         , output v-value-character
     1937                         , output v-value-date
     1938                         , output v-value-decimal
     1939                         , output v-value-integer
     1940                         , output v-value-logical
     1941                         , output v-param-type
     1942                         , input-output table-handle v-tth
     1943                         ) no-error .
     1944       if error-status :error
     1945       then do:
     1946         assign
     1947           v-bgelib-bgefmt  = "xml":U
     1948         .
     1949       end.
     1950       else do:
     1951         assign
     1952           v-bgelib-bgefmt  = v-value-character
     1953         .
     1954       end.
     1955       delete object v-tth.
     1956       run adm/shattri.p ( input "get":U
     1957                         , input  '':u
     1958                         , input  0
     1959                         , input  'bge-export':U
     1960                         , input  'bgeflold':U
     1961                         , output v-value-character
     1962                         , output v-value-date
     1963                         , output v-value-decimal
     1964                         , output v-value-integer
     1965                         , output v-value-logical
     1966                         , output v-param-type
     1967                         , input-output table-handle v-tth
     1968                         ) no-error .
     1969       if error-status :error
     1970       then do:
     1971         assign
     1972           v-bgelib-bgeflold  = "old":U
     1973         .
     1974       end.
     1975       else do:
     1976         assign
     1977           v-bgelib-bgeflold  = v-value-character
     1978         .
     1979       end.
     1980       delete object v-tth.
     1981   end.
     1982   end procedure.
     1983   procedure bgelib-check-file-size :
     1984   do
     1985   on error undo, return error
     1986   :
     1987   define input parameter p-out-filename   as character    no-undo.
     1988   define output parameter p-is-big        as logical      no-undo.
     1989       define variable v-current-position    as integer        no-undo.
     1990       assign
     1991           v-current-position = seek( stmXMLOut )
     1992       .
     1993       if v-current-position / 1024 / 1024  >= 100
     1994       then do:
     1995           assign
     1996               p-is-big = yes
     1997           .
     1998       end.
     1999   end.
     2000   end procedure.
     2001   procedure bgelib-init-ext-doc-type :
     2002       define variable v-counter    as integer      no-undo.
     2003       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2004   do
     2005   for buf_temp_ext-doc-type
     2006   on error undo, return error
     2007   :
     2008       empty temp-table buf_temp_ext-doc-type.
     2009       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2010       :
     2011           create buf_temp_ext-doc-type.
     2012           assign
     2013               buf_temp_ext-doc-type.edt-key               = v-counter
     2014               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2015               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2016           .
     2017       end.
     2018   end.
     2019   end procedure.
     2020   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2021   define variable v-xml-file-name     as character            no-undo.
     2022   define variable v-xml-file-name-path as character            no-undo.
     2023   define variable v-log-file-name     as character            no-undo.
     2024   define variable v-locked            as logical              no-undo.
     2025   define variable v-log-string        as character            no-undo.
     2026   define variable v-oper-num          as integer              no-undo.
     2027   define variable v-obj-list          as character            no-undo.
     2028   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2029   DEF VAR intRep      AS INT NO-UNDO.
     2030   define variable hEDT             AS HANDLE NO-UNDO.
     2031   define variable hCNT             AS HANDLE NO-UNDO.
     2032   procedure xml-cd-write-header:
     2033   do
     2034   on error undo, return error
     2035   :
     2036   define input parameter p-xml-file-name       as character    no-undo.
     2037   define input parameter p-xml-file-name-path  as character    no-undo.
     2038   define input parameter p-doc-name            as character    no-undo.
     2039   define input parameter p-version             as character    no-undo.
     2040   define input parameter p-obj-list            as character    no-undo.
     2041   define input parameter p-correspondent       as character    no-undo .
     2042   define input parameter p-write-header        as logical      no-undo .
     2043   define variable OS-time as character no-undo .
     2044   define variable id as character no-undo .
     2045   define buffer buf_db for ub.db.
     2046   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2047   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2048   assign
     2049   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2050   .
     2051   run bgelib-tag-open in this-procedure (
     2052                                        1
     2053                                       ,p-doc-name
     2054                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2055                                         ).
     2056   if p-write-header then do:
     2057     run bgelib-tag-open(2, "Header","").
     2058     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2059     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2060     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2061     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2062     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2063     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2064     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2065     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2066     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2067     run bgelib-tag-close( 2, "Header" ).
     2068   end.
     2069   output stream stmXMLOut close.
     2070   end.
     2071   end procedure.
     2072   procedure xml-cd-write-footer:
     2073   do
     2074   on error undo, return error
     2075   :
     2076   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2077   define input parameter p-xml-file-name as character    no-undo.
     2078   define input parameter p-doc-name      as character    no-undo .
     2079   define variable v-error-num     as integer           no-undo.
     2080   define variable v-md5-signature as character no-undo .
     2081   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2082   run bgelib-tag-close( 0, p-doc-name ).
     2083   put stream stmXMLOut unformatted skip.
     2084   output stream stmXMLOut close.
     2085   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2086   if v-error-num > 0
     2087   then do:
     2088      return error.
     2089   end.
     2090   if opsys = "unix"
     2091   then do:
     2092       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2093   end.
     2094   end.
     2095   end procedure.
     2096   procedure xml-cd-filename :
     2097   do
     2098   on error undo, return error
     2099   :
     2100   define input parameter  p-out               as character no-undo .
     2101   define output parameter p-xml-file-name     as character    no-undo.
     2102   define output parameter p-xml-file-name-path   as character    no-undo.
     2103   define output parameter p-log-file-name     as character    no-undo.
     2104   define output parameter p-locked            as logical      no-undo.
     2105   define variable v-out as character     no-undo.
     2106   define variable loc#log as logical no-undo .
     2107   define variable BadFlag as logical no-undo .
     2108   define variable fq as integer no-undo .
     2109   define variable v-remote as character no-undo .
     2110   assign
     2111   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2112   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2113   p-log-file-name = p-out + "actions.log"
     2114   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2115   .
     2116   end.
     2117   end procedure.
     2118   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2119   define variable v-date-str as character no-undo .
     2120   assign
     2121   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2122                string(Month(p-date), "99":U) + "-":U +
     2123                string(DAY(p-date), "99":U).
     2124   return v-date-str.
     2125   END FUNCTION.
     2126   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2127   define variable v-date-str as character no-undo .
     2128   assign
     2129   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2130                string(Month(p-date), "99":U) + "-":U +
     2131                string(DAY(p-date), "99":U) + chr(32) +
     2132                string(p-time, "HH:MM:SS").
     2133   return v-date-str.
     2134   END FUNCTION.
     2135   function string-to-date returns date ( input p-string  as character):
     2136     define variable v-date as date no-undo .
     2137     assign
     2138     v-date = date(integer(substring(p-string, 4, 2))
     2139                   ,integer(substring(p-string, 1, 2))
     2140                   ,integer(substring(p-string, 7, 4))
     2141                  ) no-error .
     2142     if error-status:error then return ?.
     2143     return v-date.
     2144   END FUNCTION.
     2145   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2146   define variable v-time as integer no-undo init ?.
     2147   define variable v-dop1 as character no-undo .
     2148   define variable v-dop2 as character no-undo .
     2149   assign
     2150   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2151   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2152   no-error .
     2153   if error-status:error then return ?.
     2154   assign
     2155   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2156             integer(entry(2, v-dop2, ";":U)) * 60 +
     2157             integer(entry(3, v-dop2, ";":U)) no-error .
     2158   return v-time.
     2159   END FUNCTION.
     2160   procedure   for-cash-cycle:
     2161   define input  parameter i-obj-code as integer   no-undo.
     2162   define input  parameter iPostType  as character no-undo.
     2163   define input  parameter iAction    as character no-undo.
     2164   define variable fname-list as character no-undo .
     2165   define variable out-list as character no-undo .
     2166   define variable var-file-num as integer no-undo .
     2167   define variable v-dir-remote as character no-undo .
     2168   define variable v-dir-remote-tmp as character no-undo .
     2169   define variable v-plu as character no-undo .
     2170   define variable ss  as character no-undo .
     2171   define variable ss0  as character no-undo .
     2172   define variable v-temp-kat-file as character no-undo .
     2173   define variable v-kat-file as character no-undo .
     2174   define variable v-kat-file-save as character no-undo .
     2175   define variable v-updated-subject-dis-kat as logical no-undo .
     2176   define variable v-next as logical no-undo .
     2177   define variable v-cd-subject-code as character no-undo .
     2178   define variable v-cd-disc-string as character no-undo .
     2179   define variable v-versiond as decimal no-undo .
     2180   define variable vText as character no-undo.
     2181   define buffer for-cash-desk for ub.cash-desk.
     2182   _for:
     2183   for each for-cash-desk no-lock where
     2184           for-cash-desk.db-num = g#db-num and
     2185           for-cash-desk.pos-type = iPostType and
     2186           for-cash-desk.obj-code = i-obj-code and
     2187           for-cash-desk.cash-on  = yes
     2188       break
     2189       by for-cash-desk.db-num
     2190       by for-cash-desk.obj-code
     2191       by for-cash-desk.pos-type
     2192       by for-cash-desk.cash-on
     2193       :
     2194     if mListrec ne ?
     2195        and not can-do (mListrec,string(recid(for-cash-desk)))
     2196     then
     2197        next.
     2198     if lookup(for-cash-desk.pos-type,
     2199               ('NCR-GM':U + chr(44) +
     2200                'IBM-XML':U + chr(44) +
     2201                'MAGIA-XML':U + chr(44) +
     2202                'NCR-AS@R':U + chr(44)
     2203                  )) > 0
     2204     and for-cash-desk.autonomy = integer('1':U) then next.
     2205     run write-log-and-file in p-log-handle (
     2206           input 1
     2207         , input log-file-name
     2208         , input 1
     2209         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2210                           )
     2211                                           ).
     2212     vtext = substitute( "Начата '&2' ", (if iAction = "U" then mTitle-add else mTitle-del)).
     2213   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2214   case for-cash-desk.pos-type:
     2215       when 'IBM-XML':U or when 'Autotank':U
     2216     then do:
     2217   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2218   run xml-cd-filename in this-procedure (
     2219         input out
     2220       , output v-xml-file-name
     2221       , output v-xml-file-name-path
     2222       , output v-log-file-name
     2223       , output v-locked
     2224   ).
     2225   run write-log-and-file in p-log-handle (
     2226         input 1
     2227       , input log-file-name
     2228       , input 1
     2229       , input substitute( ("vtext" + " &1")
     2230                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2231                         )
     2232                                         ).
     2233   run write-log-and-file in p-log-handle (
     2234         input 1
     2235       , input log-file-name
     2236       , input 1
     2237       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2238                                         ).
     2239   assign
     2240   v-obj-list = 'маг':U + string(i-obj-code)
     2241   .
     2242   run xml-cd-write-header in this-procedure (
     2243         input v-xml-file-name
     2244       , input v-xml-file-name-path
     2245       , input 'control'
     2246       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2247       , input v-obj-list
     2248       , input (
     2249                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2250                   then (if for-cash-desk.autonomy = integer('0':U)
     2251                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2252                         else ("КМ"   )
     2253                         )
     2254                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2255                   )
     2256               )
     2257       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2258   ).
     2259   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2260   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2261     end.
     2262   END CASE.
     2263     run putc-obj in this-procedure
     2264                  ( input for-cash-desk.pos-type
     2265                   ,input for-cash-desk.version
     2266                   ,input for-cash-desk.cash-os
     2267                   ,input for-cash-desk.cash-num
     2268                   ,input iAction eq "U":U
     2269                   ).
     2270     vtext = substitute( "Завершено '&2' ", (if iAction = "U" then mTitle-add else mTitle-del)).
     2271   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2272   case for-cash-desk.pos-type:
     2273       when 'IBM-XML':U or when 'Autotank':U
     2274     then do:
     2275   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   output stream stmxmlout close.
     2277   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2278       , input 'control'
     2279   ).
     2280   run write-log-and-file in p-log-handle (
     2281         input 1
     2282       , input log-file-name
     2283       , input 1
     2284       , input substitute( "Данные выгружены в файл &1"
     2285                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2286                         )
     2287                                          ).
     2288   if (
     2289   not (g#news or g#auto or g#esys )
     2290   or
     2291   (
     2292   for-cash-desk.pos-type = 'MAGIA-XML':U
     2293   or
     2294     (for-cash-desk.pos-type = 'IBM-XML':U
     2295   or (for-cash-desk.pos-type = 'Autotank':U
     2296     and
     2297     for-cash-desk.autonomy = integer('2':U))
     2298     )))
     2299   then do:
     2300     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2301     end.
     2302     if (for-cash-desk.pos-type = 'IBM-XML':U
     2303     and for-cash-desk.autonomy = integer('0':U))
     2304     or (for-cash-desk.pos-type = 'Autotank':U
     2305     and for-cash-desk.autonomy = integer('2':U))
     2306     then do:
     2307       run str/post-xml.p
     2308         (
     2309          input parparentproc
     2310         ,input p-parent-handle
     2311         ,input p-log-handle
     2312         ,input g#news or g#esys
     2313         ,input g#auto
     2314         ,input 'send'
     2315         ,input log-file-name
     2316         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2317         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2318         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2319         ,input 30
     2320         ,input   ( if action = 'U'
     2321                     then ('Ждите - ' + vtext)
     2322                     else ('Ждите - ' + vtext) ) +
     2323                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2324         ) no-error .
     2325       if error-status:error
     2326       or return-value = "error" then do:
     2327         run write-log-and-file in p-log-handle (
     2328               input 1
     2329             , input log-file-name
     2330             , input 1
     2331             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2332                                   ,for-cash-desk.obj-code
     2333                                   ,for-cash-desk.cash-num
     2334                                   , chr(10)
     2335                                   , error-status:get-message(1)
     2336                                   , return-value
     2337                               )
     2338                                               ).
     2339         assign
     2340         v-view-log = yes
     2341         .
     2342       end.
     2343     end.
     2344     if not available ub.shop then do:
     2345       find first ub.shop no-lock where
     2346                 ub.shop.obj-code = for-cash-desk.obj-code.
     2347     end.
     2348     if
     2349     not (g#news or g#esys)
     2350     then do:
     2351       run str/getxibmf.p (
     2352                       input parparentproc
     2353                     ,input p-log-handle
     2354                     ,input 'маг':U
     2355                     ,input for-cash-desk.obj-code
     2356                     ,input ub.shop.host-code
     2357                     ,input in_
     2358                     ,input spl
     2359                     ,input (in_ + sav)
     2360                     ,input for-cash-desk.pos-type
     2361                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2362                             and for-cash-desk.autonomy = integer('0':U))
     2363                             or (for-cash-desk.pos-type = 'Autotank':U
     2364                             and for-cash-desk.autonomy = integer('2':U))
     2365                             then "utf-8":U
     2366                             else "windows-1251")
     2367                     ,input log-file-name
     2368                     ,input "data":U
     2369                     ,input v-xml-file-name
     2370                     ,input-output v-view-log
     2371                     ) no-error .
     2372       if error-status:error then do:
     2373         run write-log-and-file in p-log-handle (
     2374               input 1
     2375             , input log-file-name
     2376             , input 1
     2377             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2378                                   ,for-cash-desk.obj-code
     2379                                   ,for-cash-desk.cash-num
     2380                               )
     2381                                               ).
     2382         assign
     2383         v-view-log = yes
     2384         .
     2385       end.
     2386     end.
     2387   end.
     2388   if g#news
     2389   or g#auto
     2390   or g#esys
     2391   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2392   then do:
     2393   end.
     2394     end.
     2395   END CASE.
     2396   end .
     2397   end procedure.
     2398   procedure SENDING:
     2399      define input  parameter i-obj-code as integer no-undo.
     2400      define input  parameter iAction    as character no-undo.
     2401   _cash-desk:
     2402   for each ub.cash-desk  where ub.cash-desk.db-num   = g#db-num
     2403                            and ub.cash-desk.obj-code = i-obj-code
     2404                            and ub.cash-desk.cash-on
     2405   no-lock
     2406   break
     2407   by ub.cash-desk.pos-type :
     2408     if first-of(ub.cash-desk.pos-type) then do:
     2409   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2410   define variable dflt-cd14 as character no-undo .
     2411   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2412   define variable v-param-type15 as character no-undo .
     2413   define variable v-value-date15 as date no-undo .
     2414   define variable v-value-decimal15 as decimal no-undo .
     2415   define variable v-value-integer15 as INTEGER no-undo .
     2416   define variable v-value-logical15 AS LOGICAL no-undo .
     2417   define variable v-tth15 as handle no-undo .
     2418   run adm/shattri.p (
     2419       input "get":U
     2420       ,input  'маг':U
     2421       ,input  ub.cash-desk.obj-code
     2422       ,input  'cd-sending':U
     2423       ,input  'dflt-cd':U
     2424       ,output dflt-cd14
     2425       ,output v-value-date15
     2426       ,output v-value-decimal15
     2427       ,output v-value-integer15
     2428       ,output v-value-logical15
     2429       ,output v-param-type15
     2430       ,INPUT-OUTPUT table-handle v-tth15
     2431       ) no-error .
     2432   delete object v-tth15 no-error.
     2433   case ub.cash-desk.pos-type:
     2434       when 'IBM-XML':U or when 'Autotank':U
     2435     then do:
     2436   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2437   run str/get-inis.p (
     2438                   input 'маг':U
     2439                 , input ub.cash-desk.obj-code
     2440                 , input ub.cash-desk.pos-type
     2441                 , input cash-desk.remote
     2442                 , input "send":U
     2443                 , output out
     2444                 , output out2
     2445                 , output in_
     2446                 , output spl
     2447                 , output sav
     2448                 , output v-remote
     2449                 )  no-error .
     2450   if error-status:error then do:
     2451     run write-log-and-file in p-log-handle (
     2452           input 1
     2453         , input log-file-name
     2454         , input 1
     2455         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2456                             , ub.cash-desk.pos-type
     2457                             , ub.cash-desk.obj-code
     2458                             , chr(10)
     2459                             , error-status:get-message(1)
     2460                             , return-value )).
     2461     assign
     2462     v-view-log = yes.
     2463     return error.
     2464   end.
     2465   if ub.cash-desk.pos-type = 'IBM-XML':U
     2466   or ub.cash-desk.pos-type = 'Autotank':U
     2467   then do:
     2468     file-info:file-name = (out  + "undelivered").
     2469     if file-info:FULL-PATHNAME <> ? then do:
     2470       run str/rsndxibm.p ( input parparentproc
     2471                           ,input p-parent-handle
     2472                           ,input p-log-handle
     2473                           ,input out  + "undelivered" ) no-error.
     2474     end.
     2475   end.
     2476     end.
     2477   END CASE.
     2478       run for-cash-cycle (i-obj-code,ub.cash-desk.pos-type,iAction) no-error.
     2479       if error-status:error then do:
     2480         run write-log-and-file in p-log-handle (
     2481               input 1
     2482             , input log-file-name
     2483             , input 1
     2484             , input substitute("&1 &2", error-status:get-message(1), return-value)
     2485                                                 ).
     2486         assign
     2487         v-view-log = yes
     2488         .
     2489       end.
     2490     end.
     2491     if last-of(ub.cash-desk.pos-type) then do:
     2492   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2493   case ub.cash-desk.pos-type:
     2494   END CASE.
     2495     end.
     2496   end.
     2497   end procedure.
     2498   assign
     2499   mPostType      = 'IBM-XML':U
     2500   mTitle         = "Передача сигнала "
     2501   mTitle-add     = "Передача 'сигнала резервнго копирования базы чеков и очистки базы чеков' "
     2502   mTitle-del     = "Передача 'сигнала резервнго копирования базы чеков и очистки базы чеков' "
     2503   mObj-type      =         entry(1, p-parameter, chr(4))
     2504   mObj-code      = integer(entry(2, p-parameter, chr(4)))
     2505   action         =         entry(3, p-parameter, chr(4))
     2506   mListrec       = iRECLIST
     2507   no-error
     2508   .
     2509   if error-status:error then do:
     2510     run write-log-and-file in p-log-handle (
     2511           input 1
     2512         , input log-file-name
     2513         , input 1
     2514         , input substitute("Ошибка входных параметров &1:&2&3"
     2515                            , p-parameter
     2516                            , chr(10)
     2517                            , error-status:get-message(1)
     2518                            )).
     2519     v-view-log = yes.
     2520     undo, return error .
     2521   end .
     2522   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2523   find first ub.cash-desk where ub.cash-desk.db-num    = g#db-num
     2524                             and ub.cash-desk.obj-code  = mObj-code
     2525                             and can-do(mPostType,ub.cash-desk.pos-type)
     2526   no-lock no-error.
     2527   if not avail(cash-desk) then do:
     2528     run write-log-and-file in p-log-handle (
     2529           input 1
     2530         , input log-file-name
     2531         , input 1
     2532         , input substitute( "!!!&1  реализуется только для касс  &2 "
     2533                             , (if action = "U" then mTitle-add else mTitle-del)
     2534                             , mPostType
     2535                           )
     2536                                           ).
     2537     return.
     2538   end.
     2539   run SENDING (mObj-code,action) no-error.
     2540   if error-status:error then do:
     2541     run write-log-and-file in p-log-handle (
     2542           input 1
     2543         , input log-file-name
     2544         , input 1
     2545         , input substitute( "!!!Ошибки при '&1' на кассы &2&3"
     2546                            ,mTitle, mObj-type, mObj-code
     2547                           )
     2548                                           ).
     2549   end.
     2550     finally :
     2551       run write-log-and-file in p-log-handle (
     2552           input 1
     2553         , input log-file-name
     2554         , input 1
     2555         , input substitute("&1", chr(10))
     2556       ).
     2557       define variable v-save-file-name as character no-undo .
     2558       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     2559       os-append value(log-file-name) value(v-save-file-name).
     2560       os-delete value(log-file-name).
     2561     end finally .
     2562   procedure putc-obj :
     2563   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
     2564   define input parameter p-version like ub.cash-desk.version no-undo .
     2565   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
     2566   define input parameter p-cash-num like ub.cash-desk.cash-num  no-undo .
     2567   define input parameter p-is-del as logical no-undo .
     2568   define buffer buf_ext-classif for ub.ext-classif.
     2569   define variable ii as integer no-undo.
     2570     do
     2571     on error undo, return error
     2572     :
     2573       run bgelib-tag-open in this-procedure  ( input 2, input "Command", input substitute("ctrl='&1'", "ADD":u)).
     2574       run bgelib-tag-put in this-procedure   ( input 3, input "CommType":U,  iCommandType , input 1 ).
     2575       run bgelib-tag-put in this-procedure   ( input 3, input "CommValue":U, iCommandValue, input 1 ).
     2576       run bgelib-tag-close in this-procedure ( input 2, input "Command").
     2577     end.
     2578   end procedure.
