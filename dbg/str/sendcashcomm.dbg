      139   procedure alienini-getkey :
      140   define input parameter i-filename as char.
      141   define input parameter i-section as char.
      142   define input parameter i-key as char.
      143   define output parameter o-value as char.
      144   define variable EntryPointer as integer no-undo.
      145   define variable mem1 as memptr no-undo.
      146   define variable mem2 as memptr no-undo.
      147   define variable mem1size as integer no-undo.
      148   define variable mem2size as integer no-undo.
      149   define variable ii       as integer    no-undo.
      150   define variable cbReturnSize  as integer    no-undo.
      151   assign
      152   set-size(mem1)  = 4000
      153   mem1size = 4000.
      154   if i-key = "" then EntryPointer = 0.
      155   else do:
      156     assign
      157     set-size(mem2) = 128
      158     mem2size = 128
      159     EntryPointer = get-pointer-value(mem2)
      160     put-string(mem2, 1) = i-key.
      161   end.
      162   run getprivateprofilestringA
      163                                 (i-section,
      164                                  EntryPointer,
      165                                  "",
      166                                  get-pointer-value(mem1),
      167                                  input mem1size,
      168                                  i-filename,
      169                                  output cbReturnSize).
      170   do ii = 1 to cbReturnSize:
      171     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      172                  then o-value + ","
      173                  else o-value + chr(get-byte(mem1, ii)).
      174   end.
      175     set-size(mem1) = 0.
      176     set-size(mem2) = 0.
      177   end procedure.
      178   procedure alienini-putkey :
      179   define input parameter i-filename as char.
      180   define input parameter i-section as char.
      181   define input parameter i-key as char.
      182   define input parameter i-value as char.
      183   define variable cbReturnSize as integer.
      184   run writeprivateprofilestringA
      185                                  (i-section,
      186                                   i-key,
      187                                   i-value,
      188                                   i-filename,
      189                                   output cbReturnSize ).
      190   end procedure.
      191   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      192     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      193     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      194     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      195     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      196     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      197     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      198     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      199   END PROCEDURE.
      200   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      201     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      202     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      203     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      204     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      205     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      206   END PROCEDURE.
      207   define   temp-table temp-tekka-tsk no-undo
