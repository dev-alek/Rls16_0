      173   define new global shared variable g#language as character no-undo .
      174   if g#language <> '' and g#language <> 'rus':U then do:
      175     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      176   end.
      177   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   procedure tax-name:
      179   define input  parameter pardef-tax  as character           no-undo.
      180   define output parameter parname-tax as character initial ? no-undo.
      181   define buffer bf_tax for ub.tax.
      182   do on error undo, return error :
      183      case pardef-tax:
      184         when 'vat':U then do:
      185                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      186         end.
      187         when 'slt':U then do:
      188                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      189         end.
      190         when 'rdt':U then do:
      191                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      192         end.
      193         when 'exc':U then do:
      194                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      195         end.
      196         otherwise do:
      197            return error "Задан неверный параметр " + pardef-tax + " .".
      198         end.
      199      end case.
      200   end.
      201   end procedure.
      202   procedure proc-alt-shift-f2:
      203     if not ibs.th.gbl.gbl-var:rcode
      204   then
      205     run gbl\inidebug.p .
      206   end.
      207   procedure proc-alt-shift-f3:
      208     run gbl/prvssinf.p
      209       ( input this-procedure
      210       ) .
      211   end.
      212   define variable v-inform-launched as logical no-undo initial false .
      213   procedure proc-alt-shift-f4:
      214     define variable v-action as character no-undo .
      215     if v-inform-launched = false then do:
      216       assign
      217         v-inform-launched = true
      218       .
      219       run gbl/d-inform.w
      220         (  input self
      221         ,  input this-procedure
      222         , output v-action
      223         ) no-error .
      224       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      225       assign
      226         v-inform-launched = false
      227       .
      228     end.
      229   end.
      230   procedure proc-alt-f1:
      231     run gbl/corrhelp.p
      232       (input this-procedure
      233       ) .
      234   end .
      235   on alt-shift-f2 anywhere do:
      236     run proc-alt-shift-f2.
      237   end.
      238   on alt-shift-f3 anywhere do:
      239     run proc-alt-shift-f3 in this-procedure .
      240   end.
      241   on alt-shift-f4 anywhere do:
      242     run proc-alt-shift-f4 in this-procedure.
      243   end.
      244   on alt-f1 anywhere do:
      245     run proc-alt-f1 in this-procedure .
      246   end.
