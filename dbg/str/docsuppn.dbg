      435   DEFINE FRAME Dialog-Frame
      436        b-exit AT ROW 1 COL 1
      437        b-add AT ROW 1 COL 9
      438        b-sp AT ROW 1 COL 21.5
      439        b-cont AT ROW 1 COL 34
      440        inv-type AT ROW 1 COL 46 NO-LABEL
      441        b-help AT ROW 1 COL 91
