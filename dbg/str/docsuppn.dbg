     1976   RUN disable_UI.
     1977   PROCEDURE calc-title :
     1978   assign
     1979   varacc-base = 0.00
     1980   varacc-rubl = 0.00
     1981   varvat-acc-base = 0.00
     1982   varvat-acc-rubl = 0.00
     1983   varno-vat-base = 0.00
     1984   varno-vat-rubl = 0.00
     1985   varov-base = 0.00
     1986   varov-vat = 0.00
     1987   varpay-base = 0.00
     1988   varpay-rubl = 0.00
     1989   varsale-base = 0.00
     1990   varvat-base = 0.00
     1991   varvat-rubl = 0.00
     1992   varroad-tax = 0.00
     1993   varexcise = 0.00
     1994   .
     1995   define variable v-curr-r-b as character no-undo .
     1996   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1998     (output v-curr-r-b
     1999     )  .
     2000   for each tt-title:
     2001   assign
     2002   varacc-base = varacc-base + tt-title.acc-base
     2003   varacc-rubl = varacc-rubl + tt-title.acc-rubl
     2004   varvat-acc-base = varvat-acc-base + tt-title.acc-vat-base
     2005   varvat-acc-rubl = varvat-acc-rubl + tt-title.acc-vat-rubl
     2006   varno-vat-base = varno-vat-base + tt-title.no-vat-base
     2007   varno-vat-rubl = varno-vat-rubl + tt-title.no-vat-rubl
     2008   varov-base = varov-base + tt-title.ov-base
     2009   varov-vat = varov-vat + tt-title.ov-vat
     2010   varpay-base = varpay-base + tt-title.pay-base
     2011   varpay-rubl = varpay-rubl + tt-title.pay-rubl
     2012   varvat-base = varvat-base + tt-title.vat-base
     2013   varvat-rubl = varvat-rubl + tt-title.vat-rubl
     2014   varroad-tax = varroad-tax + tt-title.road-tax
     2015   varexcise = varexcise + tt-title.excise
     2016   .
     2017   if v-curr-r-b = 'base':U then
     2018       assign
     2019           varsale-base = varsale-base + tt-title.sale-base
     2020           .
     2021   else
     2022     assign
     2023       varsale-base = varsale-base + tt-title.sale-rubl
     2024       .
     2025   end.
     2026   END PROCEDURE.
     2027   PROCEDURE disable_UI :
     2028     HIDE FRAME Dialog-Frame.
     2029   END PROCEDURE.
     2030   PROCEDURE enable_UI :
     2031     DISPLAY varacc-base varacc-rubl varsale-base varvat-acc-base varvat-acc-rubl
     2032             varov-base varpay-base varpay-rubl varov-vat varno-vat-base
     2033             varno-vat-rubl varexcise varvat-base varvat-rubl varroad-tax FILL-rub
     2034         WITH FRAME Dialog-Frame.
     2035     ENABLE b-exit b-add b-sp b-cont b-help b-title b-d-supp b-d-supp-grp FILL-rub
     2036         WITH FRAME Dialog-Frame.
     2037     VIEW FRAME Dialog-Frame.
     2038     OPEN QUERY b-d-supp FOR EACH d-supp.    OPEN QUERY b-d-supp-grp FOR EACH d-supp-grp.    OPEN QUERY b-title FOR EACH tt-title.
     2039   END PROCEDURE.
