      443        varacc-rubl AT ROW 2.79 COL 29.5 COLON-ALIGNED NO-LABEL
      444        varsale-base AT ROW 2.79 COL 81.25 COLON-ALIGNED
      445        varvat-acc-base AT ROW 3.71 COL 12 COLON-ALIGNED
      446        varvat-acc-rubl AT ROW 3.71 COL 29.5 COLON-ALIGNED NO-LABEL
      447        varov-base AT ROW 3.71 COL 81.25 COLON-ALIGNED
      448        varpay-base AT ROW 4.67 COL 12 COLON-ALIGNED
      449        varpay-rubl AT ROW 4.67 COL 29.5 COLON-ALIGNED NO-LABEL
      450        varov-vat AT ROW 4.67 COL 81.25 COLON-ALIGNED
