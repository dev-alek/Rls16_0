      459        b-d-supp-grp AT ROW 18.04 COL 1
      460        FILL-rub AT ROW 2.13 COL 29.88 COLON-ALIGNED NO-LABEL
      461        "Валюта" VIEW-AS TEXT
      462             SIZE 6.63 BY .67 AT ROW 2.13 COL 14.5
      463             BGCOLOR 3 FGCOLOR 15
      464        SPACE(78.24) SKIP(21.11)
      465       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      466            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      467            TITLE "Учет"
      468            DEFAULT-BUTTON b-exit.
      469   ASSIGN
      470          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      471          FRAME Dialog-Frame:HIDDEN           = TRUE.
      472   ASSIGN
      473          b-d-supp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 4.
      474   ASSIGN
      475          b-d-supp-grp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 5.
      476   ASSIGN
      477          b-title:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      478   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      479   DO:
      480     APPLY "END-ERROR":U TO SELF.
      481   END.
      482   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      483   DO:
      484     run str/docspadd.w .
      485   END.
      486   ON CHOOSE OF b-cont IN FRAME Dialog-Frame
      487   DO:
      488     run str/calc-sup.p ( INPUT pardoc-rec, INPUT varfin-table-list, INPUT YES, INPUT ?, INPUT YES ) NO-ERROR.
      489     IF ERROR-STATUS :ERROR THEN DO:
      490       MESSAGE "Ошибка в расчетах." VIEW-AS ALERT-BOX ERROR.
      491       RETURN NO-APPLY.
      492     END.
      493     run str/docspcon.w .
      494     run str/calc-sup.p ( INPUT pardoc-rec, INPUT varuse-table-list, INPUT YES, INPUT ?, INPUT YES ) NO-ERROR.
      495     IF ERROR-STATUS :ERROR THEN DO: MESSAGE "Ошибка в расчетах." VIEW-AS ALERT-BOX ERROR. END.
      496     OPEN QUERY b-d-supp FOR EACH d-supp.    OPEN QUERY b-d-supp-grp FOR EACH d-supp-grp.    OPEN QUERY b-title FOR EACH tt-title.
      497     RUN calc-title IN THIS-PROCEDURE.
      498     DISPLAY varacc-base
      499             varacc-rubl
      500             varvat-acc-base
      501             varvat-acc-rubl
      502             varno-vat-base
      503             varno-vat-rubl
      504             varov-base
      505             varov-vat
      506             varpay-base
      507             varpay-rubl
      508             varsale-base
      509             varvat-base
      510             varvat-rubl
      511             varroad-tax
      512             varexcise
      513     WITH FRAME Dialog-Frame.
      514   END.
      515   ON CHOOSE OF b-sp IN FRAME Dialog-Frame
      516   DO:
      517     run str/docspprt.w .
      518   END.
      519   ON VALUE-CHANGED OF inv-type IN FRAME Dialog-Frame
      520   DO:
      521     for each d-supp :
      522       delete d-supp .
      523     end.
      524     for each d-slt-vat :
      525       delete d-slt-vat .
      526     end.
      527     for each d-slt-vat-cons :
      528       delete d-slt-vat-cons .
      529     end.
      530     assign inv-type.
      531     run str/calc-sup.p ( input pardoc-rec, input varuse-table-list, input yes, input inv-type, input yes ) no-error.
      532     if error-status :error then do: message "Ошибка в расчетах." view-as alert-box error. end.
      533     OPEN QUERY b-d-supp FOR EACH d-supp.    OPEN QUERY b-d-supp-grp FOR EACH d-supp-grp.    OPEN QUERY b-title FOR EACH tt-title.
      534     run calc-title in this-procedure.
      535     display varacc-base
      536             varacc-rubl
      537             varvat-acc-base
      538             varvat-acc-rubl
      539             varno-vat-base
      540             varno-vat-rubl
      541             varov-base
      542             varov-vat
      543             varpay-base
      544             varpay-rubl
      545             varsale-base
      546             varvat-base
      547             varvat-rubl
      548             varroad-tax
      549             varexcise
      550     with frame Dialog-Frame.
      551   END.
      552   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      553   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      554   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   on F1 of frame Dialog-Frame anywhere do:
      556     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame Dialog-Frame. END.
      557     return no-apply.
      558   end.
      559   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   on help of frame Dialog-Frame
      561   do:
      562     run gbl/app_help.p
      563       (input this-procedure :file-name
      564       ,input ''
      565       ,input ?
      566       ) no-error.
      567     if error-status :error then do:
      568       message
      569         "Ошибка при вызове помощи"
      570         error-status :get-message(1)
      571         view-as alert-box .
      572     end.
      573   end.
      574   run minbtn-set in this-procedure .
      575   on choose of b-help in frame Dialog-Frame
      576   do:
      577     apply "help":u to frame Dialog-Frame .
      578   end.
      579   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   procedure minbtn-set :
      581       do
      582           on error undo, return error return-value
      583           :
      584           define variable ii              as integer       no-undo .
      585           define variable fh              as widget-handle no-undo .
      586           define variable hh              as widget-handle no-undo .
      587           define variable v-h             as handle        extent 4 no-undo .
      588           define variable v-name-button   as character     no-undo .
      589           define variable v-help-old-x    as decimal       no-undo .
      590           define variable v-help-old-y    as decimal       no-undo .
      591           define variable v-help-old-size as decimal       no-undo .
      592           define variable v-frame-width   as decimal       no-undo .
      593           define variable jj              as integer       no-undo .
      594           do
      595               on error undo, return error
      596               :
      597               assign
      598                   v-frame-width = frame Dialog-Frame:width - 0.3
      599                   fh            = frame Dialog-Frame:first-child
      600                   hh            = fh:first-child
      601                   ii            = 1
      602                   .
      603               do while valid-handle(hh):
      604                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      605                   do:
      606                       case lc(hh:name) :
      607                           when "b-help" then
      608                               do:
      609                                   hh:load-image-up("cmp/b-help.bmp":u) .
      610                                   hh:load-image-down("cmp/b-help.bmp":u) .
      611                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      612                                   hh:TOOLTIP = "Помощь" .
      613                                   v-help-old-x = hh:column .
      614                                   v-help-old-y = hh:row    .
      615                                   v-help-old-size = hh:width .
      616                                   hh:width-chars = 2.5 .
      617                               end.
      618                           when "b-print" then
      619                               do:
      620                                   hh:load-image("cmp/b-print.bmp":u) .
      621                                   hh:TOOLTIP = "Печать" .
      622                                   v-h[ii] = hh:handle .
      623                                   ii = ii + 1 .
      624                                   hh:width-chars = 3 .
      625                               end.
      626                           when "b-history" or
      627                           when "b-hist" then
      628                               do:
      629                                   hh:load-image("cmp/b-hist.bmp":u) .
      630                                   hh:TOOLTIP = "История" .
      631                                   v-h[ii] = hh:handle .
      632                                   ii = ii + 1 .
      633                                   hh:width-chars = 3 .
      634                               end.
      635                           when "b-sch" then
      636                               do:
      637                                   hh:load-image("cmp/b-sch.bmp":u) .
      638                                   hh:TOOLTIP = "Установка Фильтра" .
      639                                   v-h[ii] = hh:handle .
      640                                   ii = ii + 1 .
      641                                   hh:width-chars = 3 .
      642                               end.
      643                           when "b-hist-user" then
      644                               do:
      645                                   hh:load-image("cmp/b-hist.bmp":u) .
      646                                   hh:TOOLTIP = "История пользователя" .
      647                                   ii = ii + 1 .
      648                               end.
      649                       end case.
      650                   end.
      651                   hh = hh:next-sibling.
      652               end.
      653               b-help:column = v-frame-width - b-help:width-chars.
      654               jj = 0.
      655               repeat ii = 4 to 1 by -1 :
      656                   if valid-handle (v-h[ii] ) then
      657                   do:
      658                       jj  = jj + 1 .
      659                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      660                       v-h[ii]:row    = v-help-old-y .
      661                   end.
      662               end.
      663           end.
      664       end.
      665   end procedure.
      666   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      667   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      668   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      669   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      670   define variable v-diasize-current-frame-width  as decimal   no-undo .
      671   define variable v-diasize-current-frame-height as decimal   no-undo .
      672   define variable v-diasize-change-size          as logical   no-undo .
      673   define variable v-diasize-resize-button        as handle    no-undo .
      674   define variable v-diasize-wndmax               as logical   no-undo .
      675   define variable v-diasize-wndstore             as logical   no-undo .
      676   define variable v-diasize-proc-name            as character no-undo .
      677   define variable v-diasize-browse-handle        as handle    no-undo .
      678   define variable v-diasize-browse-number        as integer   no-undo .
      679   define variable v-diasize-need-full-display    as logical   no-undo init false .
      680   define temp-table temp-diasize-handle no-undo
      681     field handle-value  as handle
      682     field save-position as decimal
      683     index xpk is primary unique handle-value
      684     .
      685   define temp-table temp-browse-handle no-undo
      686     field browse-type   as character
      687     field browse-number as integer
      688     field browse-handle as handle
      689     field original-size as decimal
      690     index xpk is primary unique browse-type browse-number
      691     index xie browse-type browse-handle
      692   .
      693   procedure diasize_change-height :
      694     define input  parameter p-change-value  as decimal   no-undo .
      695     define input  parameter p-move-resize   as logical   no-undo .
      696     define variable v-field-group-handle    as handle    no-undo .
      697     define variable v-object-handle         as handle    no-undo .
      698     define variable v-frame-height          as decimal   no-undo .
      699     define variable v-frame-virtual-height  as decimal   no-undo .
      700     define variable v-browse-height         as decimal   no-undo .
      701     define variable v-window-height         as decimal   no-undo .
      702     define variable v-window-virtual-height as decimal   no-undo .
      703     define variable v-change-sign           as integer   no-undo .
      704     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      705     define buffer buf_temp-browse-handle  for temp-browse-handle .
      706     if p-change-value > 0
      707     then do:
      708       if frame Dialog-Frame :height + p-change-value
      709           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      710       then do:
      711         assign
      712           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      713                           - (frame Dialog-Frame :height-chars)
      714         .
      715         if p-change-value <= 0
      716         then do:
      717           run diasize_position-resize-button in this-procedure .
      718           return .
      719         end.
      720       end.
      721     end.
      722     if p-change-value < 0
      723     then do:
      724       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      725       then do:
      726         assign
      727           p-change-value = v-diasize-orig-frame-height
      728                          - (frame Dialog-Frame :height-chars)
      729         .
      730         if p-change-value >= 0
      731         then do:
      732           run diasize_position-resize-button in this-procedure .
      733           return .
      734         end.
      735       end.
      736     end.
      737     if p-change-value >= 0
      738     then do:
      739       assign
      740         v-change-sign = 1
      741       .
      742     end.
      743     else do:
      744       assign
      745         v-change-sign = -1
      746       .
      747     end.
      748     assign
      749       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      750     .
      751     if p-change-value = 0
      752     then do:
      753       run diasize_position-resize-button in this-procedure .
      754       return .
      755     end.
      756     move_block:
      757     do
      758     on error undo move_block, retry move_block
      759     :
      760       if retry
      761       then do:
      762         do
      763         on error undo move_block, leave move_block
      764         :
      765           if p-change-value > 0
      766           then do:
      767             for each buf_temp-diasize-handle
      768             on error undo, next
      769             :
      770               assign
      771                 v-object-handle = buf_temp-diasize-handle.handle-value
      772               .
      773               if v-object-handle <> v-diasize-resize-button
      774               then do:
      775                 assign
      776                   v-object-handle :row = buf_temp-diasize-handle.save-position
      777                 .
      778               end.
      779             end.
      780             assign
      781               v-diasize-browse-handle :height = v-browse-height
      782             .
      783             for each buf_temp-browse-handle
      784               where buf_temp-browse-handle.browse-type = 'height':u
      785             on error undo, next
      786             :
      787               assign
      788                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      789               .
      790             end.
      791             assign
      792               frame Dialog-Frame :height = v-frame-height
      793             .
      794             if frame Dialog-Frame :scrollable = true
      795             then do:
      796               assign
      797                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      798               .
      799             end.
      800             run diasize_position-resize-button in this-procedure .
      801           end.
      802           else do:
      803             if frame Dialog-Frame :scrollable = true
      804             then do:
      805               assign
      806                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      807               .
      808             end.
      809             assign
      810               frame Dialog-Frame :height = v-frame-height
      811             .
      812             assign
      813               v-diasize-browse-handle :height = v-browse-height
      814             .
      815             for each buf_temp-browse-handle
      816               where buf_temp-browse-handle.browse-type = 'height':u
      817             on error undo, next
      818             :
      819               assign
      820                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      821               .
      822             end.
      823             for each buf_temp-diasize-handle
      824             on error undo, next
      825             :
      826               assign
      827                 v-object-handle = buf_temp-diasize-handle.handle-value
      828               .
      829               if v-object-handle <> v-diasize-resize-button
      830               then do:
      831                 assign
      832                   v-object-handle :row = buf_temp-diasize-handle.save-position
      833                 .
      834               end.
      835             end.
      836             run diasize_position-resize-button in this-procedure .
      837           end.
      838           assign
      839             v-diasize-change-size = false
      840           .
      841           leave move_block .
      842         end.
      843       end.
      844       assign
      845         v-diasize-need-full-display = true
      846       .
      847       if v-diasize-change-size = false
      848       then do:
      849         assign
      850           v-diasize-change-size = true
      851         .
      852       end.
      853       else do:
      854         return .
      855       end.
      856       assign
      857         v-frame-height = frame Dialog-Frame :height
      858         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      859         v-browse-height = v-diasize-browse-handle :height
      860       .
      861       for each buf_temp-browse-handle
      862         where buf_temp-browse-handle.browse-type = 'height':u
      863       :
      864         assign
      865           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      866         .
      867       end.
      868       for each buf_temp-diasize-handle
      869       :
      870         delete buf_temp-diasize-handle .
      871       end.
      872       assign
      873         v-field-group-handle = frame Dialog-Frame :first-child
      874       .
      875       do while valid-handle(v-field-group-handle)
      876       :
      877         assign
      878           v-object-handle = v-field-group-handle :first-child
      879         .
      880         do while valid-handle(v-object-handle)
      881         :
      882           if  v-object-handle <> v-diasize-browse-handle :handle
      883           and can-query(v-object-handle, "row")
      884           and can-query(v-object-handle, "height")
      885           and ( v-object-handle :row > v-diasize-browse-handle :row )
      886           then do:
      887             find first buf_temp-browse-handle
      888               where buf_temp-browse-handle.browse-type   = 'height':u
      889                 and buf_temp-browse-handle.browse-handle = v-object-handle
      890               no-error .
      891             if available buf_temp-browse-handle
      892             then do:
      893             end.
      894             else do:
      895               create buf_temp-diasize-handle .
      896               assign
      897                 buf_temp-diasize-handle.handle-value  = v-object-handle
      898                 buf_temp-diasize-handle.save-position = v-object-handle :row
      899               .
      900             end.
      901           end.
      902           assign
      903             v-object-handle = v-object-handle :next-sibling
      904           .
      905         end.
      906         assign
      907           v-field-group-handle = v-field-group-handle :next-sibling
      908         .
      909       end.
      910       do with frame Dialog-Frame
      911       :
      912         hide v-diasize-resize-button .
      913         assign
      914           v-diasize-resize-button :row    = 1
      915           v-diasize-resize-button :column = 1
      916         .
      917       end.
      918       if p-change-value > 0
      919       then do:
      920         if frame Dialog-Frame :scrollable = true
      921         then do:
      922           assign
      923             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      924             no-error .
      925           if error-status :error
      926           or error-status :get-message(1) <> ""
      927           then do:
      928             undo move_block, retry move_block .
      929           end.
      930         end.
      931         assign
      932           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      933           no-error .
      934         if error-status :error
      935         or error-status :get-message(1) <> ""
      936         then do:
      937           undo move_block, retry move_block .
      938         end.
      939         assign
      940           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      941           no-error .
      942         if error-status :error
      943         or error-status :get-message(1) <> ""
      944         then do:
      945           undo move_block, retry move_block .
      946         end.
      947         for each buf_temp-browse-handle
      948           where buf_temp-browse-handle.browse-type = 'height':u
      949         on error undo move_block, retry move_block
      950         :
      951           assign
      952             buf_temp-browse-handle.browse-handle :height
      953               = buf_temp-browse-handle.browse-handle :height + p-change-value
      954             no-error .
      955           if error-status :error
      956           or error-status :get-message(1) <> ""
      957           then do:
      958             undo move_block, retry move_block .
      959           end.
      960         end.
      961         for each buf_temp-diasize-handle
      962         on error undo move_block, retry move_block
      963         :
      964           assign
      965             v-object-handle = buf_temp-diasize-handle.handle-value
      966           .
      967           if v-object-handle <> v-diasize-resize-button
      968           then do:
      969             assign
      970               v-object-handle :row = v-object-handle :row + p-change-value
      971               no-error .
      972             if error-status :error
      973             or error-status :get-message(1) <> ""
      974             then do:
      975               undo move_block, retry move_block .
      976             end.
      977           end.
      978         end.
      979       end.
      980       else do:
      981         for each buf_temp-diasize-handle
      982         on error undo move_block, retry move_block
      983         :
      984           assign
      985             v-object-handle = buf_temp-diasize-handle.handle-value
      986           .
      987           if v-object-handle <> v-diasize-resize-button
      988           then do:
      989             assign
      990               v-object-handle :row = v-object-handle :row + p-change-value
      991               no-error .
      992             if error-status :error
      993             or error-status :get-message(1) <> ""
      994             then do:
      995               undo move_block, retry move_block .
      996             end.
      997           end.
      998         end.
      999         assign
     1000           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1001           no-error .
     1002         if error-status :error
     1003         or error-status :get-message(1) <> ""
     1004         then do:
     1005           undo move_block, retry move_block .
     1006         end.
     1007         for each buf_temp-browse-handle
     1008           where buf_temp-browse-handle.browse-type = 'height':u
     1009         on error undo move_block, retry move_block
     1010         :
     1011           assign
     1012             buf_temp-browse-handle.browse-handle :height
     1013               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1014             no-error .
     1015           if error-status :error
     1016           or error-status :get-message(1) <> ""
     1017           then do:
     1018             undo move_block, retry move_block .
     1019           end.
     1020         end.
     1021         assign
     1022           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1023           no-error .
     1024         if error-status :error
     1025         or error-status :get-message(1) <> ""
     1026         then do:
     1027           undo move_block, retry move_block .
     1028         end.
     1029         if frame Dialog-Frame :scrollable = true
     1030         then do:
     1031           assign
     1032             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1033             no-error .
     1034           if error-status :error
     1035           or error-status :get-message(1) <> ""
     1036           then do:
     1037             undo move_block, retry move_block .
     1038           end.
     1039         end.
     1040       end.
     1041       if p-move-resize = true
     1042       then do:
     1043         run diasize_position-resize-button in this-procedure .
     1044       end.
     1045       if v-diasize-wndstore = true
     1046       then do:
     1047         if connected("ub") = true
     1048         then do:
     1049           define variable v-cntxt-db-num        as integer   no-undo .
     1050           define variable v-cntxt-userid        as character no-undo .
     1051           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1052                                             , OUTPUT v-cntxt-userid
     1053                                             ) .
     1054           run gbl/wndsizew.p
     1055             (input  v-cntxt-db-num
     1056             ,input  v-cntxt-userid
     1057             ,input  v-diasize-proc-name
     1058             ,input  'height':u
     1059             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1060             ) .
     1061         end.
     1062       end.
     1063     end.
     1064     assign
     1065       v-diasize-change-size = false
     1066     .
     1067   end procedure.
     1068   procedure diasize_set-height :
     1069     define input  parameter p-new-height  as decimal   no-undo .
     1070     define input  parameter p-move-resize as logical   no-undo .
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       run diasize_change-height in this-procedure
     1075         (input  (p-new-height - frame Dialog-Frame :height)
     1076         ,input  p-move-resize
     1077         ) .
     1078     end.
     1079   end procedure.
     1080   procedure diasize_change-width :
     1081     define input  parameter p-change-value as decimal   no-undo .
     1082     define input  parameter p-move-resize  as logical   no-undo .
     1083     define variable v-field-group-handle   as handle    no-undo .
     1084     define variable v-object-handle        as handle    no-undo .
     1085     define variable v-frame-width          as decimal   no-undo .
     1086     define variable v-frame-virtual-width  as decimal   no-undo .
     1087     define variable v-browse-width         as decimal   no-undo .
     1088     define variable v-window-width         as decimal   no-undo .
     1089     define variable v-window-virtual-width as decimal   no-undo .
     1090     define variable v-change-sign          as integer   no-undo .
     1091     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1092     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1093     if p-change-value > 0
     1094     then do:
     1095       if frame Dialog-Frame :width + p-change-value >
     1096           session :width-chars
     1097       then do:
     1098         assign
     1099           p-change-value = session :width-chars - frame Dialog-Frame :width
     1100         .
     1101         if p-change-value <= 0
     1102         then do:
     1103           run diasize_position-resize-button in this-procedure .
     1104           return .
     1105         end.
     1106       end.
     1107     end.
     1108     if p-change-value < 0
     1109     then do:
     1110       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1111       then do:
     1112         assign
     1113           p-change-value = v-diasize-orig-frame-width
     1114                          - frame Dialog-Frame :width
     1115         .
     1116         if p-change-value >= 0
     1117         then do:
     1118           run diasize_position-resize-button in this-procedure .
     1119           return .
     1120         end.
     1121       end.
     1122     end.
     1123     if p-change-value >= 0
     1124     then do:
     1125       assign
     1126         v-change-sign = 1
     1127       .
     1128     end.
     1129     else do:
     1130       assign
     1131         v-change-sign = -1
     1132       .
     1133     end.
     1134     assign
     1135       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1136     .
     1137     if p-change-value = 0
     1138     then do:
     1139       run diasize_position-resize-button in this-procedure .
     1140       return .
     1141     end.
     1142     move_block:
     1143     do
     1144     on error undo move_block, leave move_block
     1145     :
     1146       if retry
     1147       then do:
     1148         do
     1149         on error undo move_block, leave move_block
     1150         :
     1151           if p-change-value > 0
     1152           then do:
     1153             for each buf_temp-diasize-handle
     1154             on error undo, next
     1155             :
     1156               assign
     1157                 v-object-handle = buf_temp-diasize-handle.handle-value
     1158               .
     1159               if v-object-handle <> v-diasize-resize-button
     1160               then do:
     1161                 assign
     1162                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1163                 .
     1164               end.
     1165             end.
     1166             assign
     1167               v-diasize-browse-handle :width = v-browse-width
     1168             .
     1169             for each buf_temp-browse-handle
     1170               where buf_temp-browse-handle.browse-type = 'width':u
     1171             on error undo, next
     1172             :
     1173               assign
     1174                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1175               .
     1176             end.
     1177             assign
     1178               frame Dialog-Frame :width = v-frame-width
     1179             .
     1180             if frame Dialog-Frame :scrollable = true
     1181             then do:
     1182               assign
     1183                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1184               .
     1185             end.
     1186             run diasize_position-resize-button in this-procedure .
     1187           end.
     1188           else do:
     1189             if frame Dialog-Frame :scrollable = true
     1190             then do:
     1191               assign
     1192                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1193               .
     1194             end.
     1195             assign
     1196               frame Dialog-Frame :width = v-frame-width
     1197             .
     1198             for each buf_temp-browse-handle
     1199               where buf_temp-browse-handle.browse-type = 'width':u
     1200             on error undo, next
     1201             :
     1202               assign
     1203                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1204               .
     1205             end.
     1206             assign
     1207               v-diasize-browse-handle :width = v-browse-width
     1208             .
     1209             for each buf_temp-diasize-handle
     1210             on error undo, next
     1211             :
     1212               assign
     1213                 v-object-handle = buf_temp-diasize-handle.handle-value
     1214               .
     1215               if v-object-handle <> v-diasize-resize-button
     1216               then do:
     1217                 assign
     1218                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1219                 .
     1220               end.
     1221             end.
     1222             run diasize_position-resize-button in this-procedure .
     1223           end.
     1224           assign
     1225             v-diasize-change-size = false
     1226           .
     1227           leave move_block .
     1228         end.
     1229       end.
     1230       assign
     1231         v-diasize-need-full-display = true
     1232       .
     1233       if v-diasize-change-size = false
     1234       then do:
     1235         assign
     1236           v-diasize-change-size = true
     1237         .
     1238       end.
     1239       else do:
     1240         return .
     1241       end.
     1242       assign
     1243         v-frame-width = frame Dialog-Frame :width
     1244         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1245         v-browse-width = v-diasize-browse-handle :width
     1246       .
     1247       for each buf_temp-browse-handle
     1248         where buf_temp-browse-handle.browse-type = 'width':u
     1249       :
     1250         assign
     1251           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1252         .
     1253       end.
     1254       for each buf_temp-diasize-handle
     1255       :
     1256         delete buf_temp-diasize-handle .
     1257       end.
     1258       assign
     1259         v-field-group-handle = frame Dialog-Frame :first-child
     1260       .
     1261       do while valid-handle(v-field-group-handle)
     1262       :
     1263         assign
     1264           v-object-handle = v-field-group-handle :first-child
     1265         .
     1266         do while valid-handle(v-object-handle)
     1267         :
     1268           if  v-object-handle <> v-diasize-browse-handle :handle
     1269           and v-object-handle <> v-diasize-resize-button
     1270           and can-query(v-object-handle, "row")
     1271           and can-query(v-object-handle, "height")
     1272           and ( v-object-handle :col + v-object-handle :width
     1273                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1274               )
     1275           then do:
     1276             find first buf_temp-browse-handle
     1277               where buf_temp-browse-handle.browse-type   = 'width':u
     1278                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1279               no-error .
     1280             if available buf_temp-browse-handle
     1281             then do:
     1282             end.
     1283             else do:
     1284               create buf_temp-diasize-handle .
     1285               assign
     1286                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1287                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1288               .
     1289             end.
     1290           end.
     1291           assign
     1292             v-object-handle = v-object-handle :next-sibling
     1293           .
     1294         end.
     1295         assign
     1296           v-field-group-handle = v-field-group-handle :next-sibling
     1297         .
     1298       end.
     1299       do with frame Dialog-Frame
     1300       :
     1301         hide v-diasize-resize-button .
     1302         v-diasize-resize-button :row = 1.
     1303         v-diasize-resize-button :column = 1.
     1304       end.
     1305       if p-change-value > 0
     1306       then do:
     1307         if frame Dialog-Frame :scrollable = true
     1308         then do:
     1309           assign
     1310             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1311             no-error .
     1312           if error-status :error
     1313           or error-status :get-message(1) <> ""
     1314           then do:
     1315             undo move_block, retry move_block.
     1316           end.
     1317         end.
     1318         assign
     1319           frame Dialog-Frame :width = v-frame-width + p-change-value
     1320           no-error .
     1321         if error-status :error
     1322         or error-status :get-message(1) <> ""
     1323         then do:
     1324           undo move_block, retry move_block.
     1325         end.
     1326         assign
     1327           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1328         no-error .
     1329         if error-status :error
     1330         or error-status :get-message(1) <> ""
     1331         then do:
     1332           undo move_block, retry move_block.
     1333         end.
     1334         for each buf_temp-browse-handle
     1335           where buf_temp-browse-handle.browse-type = 'width':u
     1336         on error undo move_block, retry move_block
     1337         :
     1338           assign
     1339             buf_temp-browse-handle.browse-handle :width
     1340               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1341             no-error .
     1342           if error-status :error
     1343           or error-status :get-message(1) <> ""
     1344           then do:
     1345             undo move_block, retry move_block .
     1346           end.
     1347         end.
     1348         for each buf_temp-diasize-handle
     1349         on error undo move_block, retry move_block
     1350         :
     1351           assign
     1352             v-object-handle = buf_temp-diasize-handle.handle-value
     1353           .
     1354           if v-object-handle <> v-diasize-resize-button
     1355           then do:
     1356             assign
     1357               v-object-handle :col = v-object-handle :col + p-change-value
     1358               no-error .
     1359             if error-status :error
     1360             or error-status :get-message(1) <> ""
     1361             then do:
     1362               undo move_block, retry move_block .
     1363             end.
     1364           end.
     1365         end.
     1366       end.
     1367       else do:
     1368         for each buf_temp-diasize-handle
     1369         on error undo move_block, retry move_block
     1370         :
     1371           assign
     1372             v-object-handle = buf_temp-diasize-handle.handle-value
     1373           .
     1374           if v-object-handle <> v-diasize-resize-button
     1375           then do:
     1376             assign
     1377               v-object-handle :col = v-object-handle :col + p-change-value
     1378               no-error .
     1379             if error-status :error
     1380             or error-status :get-message(1) <> ""
     1381             then do:
     1382               undo move_block, retry move_block .
     1383             end.
     1384           end.
     1385         end.
     1386         for each buf_temp-browse-handle
     1387           where buf_temp-browse-handle.browse-type = 'width':u
     1388         on error undo move_block, retry move_block
     1389         :
     1390           assign
     1391             buf_temp-browse-handle.browse-handle :width
     1392               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1393             no-error .
     1394           if error-status :error
     1395           or error-status :get-message(1) <> ""
     1396           then do:
     1397             undo move_block, retry move_block .
     1398           end.
     1399         end.
     1400         assign
     1401           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1402           no-error .
     1403         if error-status :error
     1404         or error-status :get-message(1) <> ""
     1405         then do:
     1406           undo move_block, retry move_block.
     1407         end.
     1408         assign
     1409           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1410         no-error .
     1411         if error-status :error
     1412         or error-status :get-message(1) <> ""
     1413         then do:
     1414           undo move_block, retry move_block.
     1415         end.
     1416         if frame Dialog-Frame :scrollable = true
     1417         then do:
     1418           assign
     1419             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1420           no-error .
     1421           if error-status :error
     1422           or error-status :get-message(1) <> ""
     1423           then do:
     1424             undo move_block, retry move_block.
     1425           end.
     1426         end.
     1427       end.
     1428       if p-move-resize
     1429       then do:
     1430         run diasize_position-resize-button in this-procedure .
     1431       end.
     1432       if v-diasize-wndstore = true
     1433       then do:
     1434         if connected("ub") = true
     1435         then do:
     1436           define variable v-cntxt-db-num        as integer   no-undo .
     1437           define variable v-cntxt-userid        as character no-undo .
     1438           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1439                                             , OUTPUT v-cntxt-userid
     1440                                             ) .
     1441           run gbl/wndsizew.p
     1442             (input  v-cntxt-db-num
     1443             ,input  v-cntxt-userid
     1444             ,input  v-diasize-proc-name
     1445             ,input  'width':u
     1446             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1447             ) .
     1448         end.
     1449       end.
     1450     end.
     1451     assign
     1452       v-diasize-change-size = false
     1453     .
     1454   end procedure.
     1455   procedure diasize_set-width :
     1456     define input  parameter p-new-width  as decimal   no-undo .
     1457     define input  parameter p-move-resize as logical   no-undo .
     1458     do
     1459     on error undo, return error return-value
     1460     :
     1461       run diasize_change-width in this-procedure
     1462         (input  (p-new-width - frame Dialog-Frame :width)
     1463         ,input  p-move-resize
     1464         ) .
     1465     end.
     1466   end procedure.
     1467   procedure diasize_position-resize-button :
     1468     do with frame Dialog-Frame
     1469     :
     1470       hide v-diasize-resize-button .
     1471       assign
     1472         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1473                     - 1
     1474                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1475         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1476                     - 1
     1477                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1478       .
     1479       view v-diasize-resize-button .
     1480     end.
     1481   end procedure.
     1482   on alt-right anywhere
     1483   do:
     1484     run diasize_change-width in this-procedure
     1485       (input 1
     1486       ,input true
     1487       ) .
     1488     return no-apply .
     1489   end.
     1490   on alt-left anywhere
     1491   do:
     1492     run diasize_change-width in this-procedure
     1493       (input -1
     1494       ,input true
     1495       ) .
     1496     return no-apply .
     1497   end.
     1498   on alt-down anywhere
     1499   do:
     1500     run diasize_change-height in this-procedure
     1501       (input 1
     1502       ,input true
     1503       ) .
     1504     return no-apply .
     1505   end.
     1506   on alt-up anywhere
     1507   do:
     1508     run diasize_change-height in this-procedure
     1509       (input -1
     1510       ,input true
     1511       ) .
     1512     return no-apply .
     1513   end.
     1514   on alt-enter of frame Dialog-Frame
     1515   do:
     1516     run diasize_maximize in this-procedure
     1517       (input  ?
     1518       ).
     1519     return no-apply .
     1520   end.
     1521   procedure diasize_end-move :
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       define variable v-row-delta as decimal   no-undo .
     1526       define variable v-col-delta as decimal   no-undo .
     1527       define variable v-new-row as decimal   no-undo .
     1528       define variable v-new-col as decimal   no-undo .
     1529       assign
     1530         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1531         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1532       .
     1533       assign
     1534         v-row-delta = v-new-row - frame Dialog-Frame :height
     1535         v-col-delta = v-new-col - frame Dialog-Frame :width
     1536       .
     1537       run diasize_change-height in this-procedure
     1538         (input v-row-delta
     1539         ,input true
     1540         ) .
     1541       run diasize_change-width in this-procedure
     1542         (input v-col-delta
     1543         ,input true
     1544         ) .
     1545     end.
     1546   end procedure.
     1547   procedure diasize_maximize :
     1548     define input  parameter p-action as logical   no-undo .
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552       if p-action = ?
     1553       then do:
     1554         if v-diasize-need-maximize = true
     1555         then do:
     1556           assign
     1557             p-action = true
     1558           .
     1559         end.
     1560         else do:
     1561           assign
     1562             p-action = false
     1563           .
     1564         end.
     1565       end.
     1566       if p-action = true
     1567       then do:
     1568         run diasize_change-height in this-procedure
     1569           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1570               - frame Dialog-Frame :height-chars
     1571           ,input true
     1572           ) .
     1573         run diasize_change-width in this-procedure
     1574           (input session :width-chars
     1575               - frame Dialog-Frame :width-chars
     1576           ,input true
     1577           ) .
     1578         assign
     1579           v-diasize-need-maximize = false
     1580         .
     1581       end.
     1582       else do:
     1583         run diasize_change-width in this-procedure
     1584           (input v-diasize-orig-frame-width
     1585               - frame Dialog-Frame :width-chars
     1586           ,input true
     1587           ) .
     1588         run diasize_change-height in this-procedure
     1589           (input v-diasize-orig-frame-height
     1590               - frame Dialog-Frame :height-chars
     1591           ,input true
     1592           ) .
     1593         assign
     1594           v-diasize-need-maximize = true
     1595         .
     1596       end.
     1597     end.
     1598   end procedure.
     1599   procedure diasize_restore-orig-size :
     1600     do
     1601     on error undo, return error return-value
     1602     :
     1603       assign
     1604         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1605         v-diasize-current-frame-height = frame Dialog-Frame :height
     1606       .
     1607       run diasize_set-height in this-procedure
     1608         (input  v-diasize-orig-frame-height
     1609         ,input  true
     1610         ) .
     1611       run diasize_set-width in this-procedure
     1612         (input  v-diasize-orig-frame-width
     1613         ,input  true
     1614         ) .
     1615     end.
     1616   end procedure.
     1617   procedure diasize_restore-current-size :
     1618     do
     1619     on error undo, return error return-value
     1620     :
     1621       run diasize_set-height in this-procedure
     1622         (input  v-diasize-current-frame-height
     1623         ,input  true
     1624         ) .
     1625       run diasize_set-width in this-procedure
     1626         (input  v-diasize-current-frame-width
     1627         ,input  true
     1628         ) .
     1629     end.
     1630   end procedure.
     1631   procedure diasize_set-browse-handle :
     1632     define input  parameter p-browse-handle as handle   no-undo .
     1633     define buffer buf_temp-browse-handle for temp-browse-handle .
     1634     do
     1635     on error undo, return error return-value
     1636     :
     1637       assign
     1638         v-diasize-browse-handle = p-browse-handle
     1639       .
     1640       for each buf_temp-browse-handle
     1641       on error undo, return error return-value
     1642       :
     1643         delete buf_temp-browse-handle .
     1644       end.
     1645     end.
     1646   end procedure.
     1647   procedure diasize_add_browse :
     1648     define input  parameter p-browse-type   as character no-undo .
     1649     define input  parameter p-browse-handle as handle    no-undo .
     1650     define buffer buf_temp-browse-handle for temp-browse-handle .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       assign
     1655         v-diasize-browse-number = v-diasize-browse-number + 1
     1656       .
     1657       create buf_temp-browse-handle .
     1658       assign
     1659         buf_temp-browse-handle.browse-type   = p-browse-type
     1660         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1661         buf_temp-browse-handle.browse-handle = p-browse-handle
     1662       .
     1663     end.
     1664   end procedure.
     1665   procedure diasize_init :
     1666     define variable v-default-value    as logical   no-undo .
     1667     define variable v-restore-saved    as logical   no-undo .
     1668     define variable v-resize-value-str as character no-undo .
     1669     do
     1670     on error undo, return error return-value
     1671     :
     1672       do with frame Dialog-Frame
     1673       :
     1674         assign
     1675           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1676           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1677           v-diasize-browse-handle     = browse b-title :handle
     1678         .
     1679         create button v-diasize-resize-button
     1680         assign
     1681           parent        = frame Dialog-Frame :first-child
     1682           label         = "s"
     1683           height-pixels = 16
     1684           width-pixels  = 16
     1685           visible       = true
     1686           sensitive     = true
     1687           movable       = true
     1688           triggers:
     1689             on end-move persistent run diasize_end-move in this-procedure .
     1690           end triggers.
     1691         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1692         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1693         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1694         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1695         assign
     1696           v-diasize-wndmax = false
     1697         .
     1698         if connected("ub") = true
     1699         then do:
     1700           define variable v-cntxt-db-num        as integer   no-undo .
     1701           define variable v-cntxt-userid        as character no-undo .
     1702           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1703                                             , OUTPUT v-cntxt-userid
     1704                                             ) .
     1705           run gbl/wndpar_r.p
     1706             (input  v-cntxt-db-num
     1707             ,input  v-cntxt-userid
     1708             ,input  'wndmax':U
     1709             ,output v-diasize-wndmax
     1710             ,output v-default-value
     1711             ) .
     1712         end.
     1713         assign
     1714           v-diasize-wndstore = false
     1715         .
     1716         if connected("ub") = true
     1717         then do:
     1718           run gbl/wndpar_r.p
     1719             (input  v-cntxt-db-num
     1720             ,input  v-cntxt-userid
     1721             ,input  'wndstore':U
     1722             ,output v-diasize-wndstore
     1723             ,output v-default-value
     1724             ) .
     1725         end.
     1726         assign
     1727           v-diasize-proc-name = entry(1, program-name(2), '.')
     1728         .
     1729         if v-diasize-wndstore = true
     1730         then do:
     1731           assign
     1732             v-restore-saved = false
     1733           .
     1734           if connected("ub") = true
     1735           then do:
     1736             run gbl/wndsizer.p
     1737               (input  v-cntxt-db-num
     1738               ,input  v-cntxt-userid
     1739               ,input  v-diasize-proc-name
     1740               ,input  'height':u
     1741               ,output v-resize-value-str
     1742               ) .
     1743             if v-resize-value-str <> '':U
     1744             then do:
     1745               run diasize_change-height in this-procedure
     1746                 (input  integer(v-resize-value-str)
     1747                 ,input  true
     1748                 ) .
     1749               assign
     1750                 v-restore-saved = true
     1751               .
     1752             end.
     1753           end.
     1754           if connected("ub") = true
     1755           then do:
     1756             run gbl/wndsizer.p
     1757               (input  v-cntxt-db-num
     1758               ,input  v-cntxt-userid
     1759               ,input  v-diasize-proc-name
     1760               ,input  'width':u
     1761               ,output v-resize-value-str
     1762               ) .
     1763             if v-resize-value-str <> '':U
     1764             then do:
     1765               run diasize_change-width in this-procedure
     1766                 (input  integer(v-resize-value-str)
     1767                 ,input  true
     1768                 ) .
     1769               assign
     1770                 v-restore-saved = true
     1771               .
     1772             end.
     1773           end.
     1774           if v-restore-saved <> true
     1775           then do:
     1776             if v-diasize-wndmax = true
     1777             then do:
     1778               run diasize_maximize in this-procedure
     1779                 (input  true
     1780                 ) .
     1781             end.
     1782           end.
     1783         end.
     1784         else do:
     1785           if v-diasize-wndmax = true
     1786           then do:
     1787             run diasize_maximize in this-procedure
     1788               (input  true
     1789               ) .
     1790           end.
     1791         end.
     1792       end.
     1793     end.
     1794   end procedure.
     1795   procedure diasize_need-full-display :
     1796     define output parameter p-need-full-display as logical   no-undo .
     1797     do
     1798     on error undo, return error return-value
     1799     :
     1800       assign
     1801         p-need-full-display = v-diasize-need-full-display
     1802       .
     1803       assign
     1804         v-diasize-need-full-display = false
     1805       .
     1806     end.
     1807   end procedure.
     1808   procedure get-context :
     1809      define output parameter p-db-num as integer          no-undo.
     1810      define output parameter p-user-id as character        no-undo.
     1811      define variable v-login               as character    no-undo.
     1812      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1813      define buffer buf_user-login  for ub.user-login .
     1814      do
     1815      on error undo, return error
     1816      :
     1817            FIND FIRST buf_sys-ctrl no-lock.
     1818            ASSIGN
     1819               v-login = USERID("ub")
     1820               p-db-num = buf_sys-ctrl.db-num
     1821            .
     1822            FIND FIRST buf_user-login
     1823                 WHERE buf_user-login.db-num = p-db-num
     1824                   AND buf_user-login.user-login = v-login
     1825                 no-lock
     1826                 no-error
     1827                 .
     1828            IF AVAILABLE buf_user-login
     1829            THEN DO:
     1830               assign
     1831                  p-user-id = buf_user-login.user-id
     1832               .
     1833            END.
     1834      end.
     1835   end procedure.
     1836   run diasize_add_browse in this-procedure
     1837     (input  'width':u
     1838     ,input  browse b-d-supp :handle
     1839     ) .
