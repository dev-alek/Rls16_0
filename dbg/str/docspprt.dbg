      276   define new global shared variable g#language as character no-undo .
      277   if g#language <> '' and g#language <> 'rus':U then do:
      278     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      279   end.
      280   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   procedure tax-name:
      282   define input  parameter pardef-tax  as character           no-undo.
      283   define output parameter parname-tax as character initial ? no-undo.
      284   define buffer bf_tax for ub.tax.
      285   do on error undo, return error :
      286      case pardef-tax:
      287         when 'vat':U then do:
      288                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      289         end.
      290         when 'slt':U then do:
      291                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      292         end.
      293         when 'rdt':U then do:
      294                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      295         end.
      296         when 'exc':U then do:
      297                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      298         end.
      299         otherwise do:
      300            return error "Задан неверный параметр " + pardef-tax + " .".
      301         end.
      302      end case.
      303   end.
      304   end procedure.
      305   define new global shared variable g#library  as handle no-undo .
      306   define new global shared variable g#library2 as handle no-undo .
      307   define variable varr-b-value as character no-undo.
      308   define variable varroad-tax-label as character no-undo.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
