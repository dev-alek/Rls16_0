     1851   MAIN-BLOCK:
     1852   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1853      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1854     RUN enable_UI.
     1855     WAIT-FOR GO OF FRAME Dialog-Frame.
     1856   END.
     1857   RUN disable_UI.
     1858   PROCEDURE disable_UI :
     1859     HIDE FRAME Dialog-Frame.
     1860   END PROCEDURE.
     1861   PROCEDURE enable_UI :
     1862     ENABLE b-exit b-help b-slt-vat b-slt-vat-cons b-supp-slt-vat-cons
     1863            b-slt-vat-cons-grp
     1864         WITH FRAME Dialog-Frame.
     1865     VIEW FRAME Dialog-Frame.
     1866     OPEN QUERY b-slt-vat FOR EACH d-slts-vats.    OPEN QUERY b-slt-vat-cons FOR EACH d-slts-vats-cons.    OPEN QUERY b-slt-vat-cons-grp FOR EACH d-slts-vats-cons-grp.    OPEN QUERY b-supp-slt-vat-cons FOR EACH d-supp-slts-vats-cons.
     1867   END PROCEDURE.
