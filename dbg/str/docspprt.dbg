      458   END.
      459   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      460   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      461   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      462   on help of frame Dialog-Frame
      463   do:
      464     run gbl/app_help.p
      465       (input this-procedure :file-name
      466       ,input ''
      467       ,input ?
      468       ) no-error.
      469     if error-status :error then do:
      470       message
      471         "Ошибка при вызове помощи"
      472         error-status :get-message(1)
      473         view-as alert-box .
      474     end.
      475   end.
      476   run minbtn-set in this-procedure .
