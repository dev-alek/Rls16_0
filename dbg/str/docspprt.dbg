      478   do:
      479     apply "help":u to frame Dialog-Frame .
      480   end.
      481   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   procedure minbtn-set :
      483       do
      484           on error undo, return error return-value
      485           :
      486           define variable ii              as integer       no-undo .
      487           define variable fh              as widget-handle no-undo .
      488           define variable hh              as widget-handle no-undo .
      489           define variable v-h             as handle        extent 4 no-undo .
      490           define variable v-name-button   as character     no-undo .
      491           define variable v-help-old-x    as decimal       no-undo .
      492           define variable v-help-old-y    as decimal       no-undo .
      493           define variable v-help-old-size as decimal       no-undo .
      494           define variable v-frame-width   as decimal       no-undo .
      495           define variable jj              as integer       no-undo .
      496           do
      497               on error undo, return error
      498               :
      499               assign
      500                   v-frame-width = frame Dialog-Frame:width - 0.3
      501                   fh            = frame Dialog-Frame:first-child
      502                   hh            = fh:first-child
      503                   ii            = 1
      504                   .
      505               do while valid-handle(hh):
      506                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      507                   do:
      508                       case lc(hh:name) :
      509                           when "b-help" then
      510                               do:
      511                                   hh:load-image-up("cmp/b-help.bmp":u) .
      512                                   hh:load-image-down("cmp/b-help.bmp":u) .
      513                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      514                                   hh:TOOLTIP = "Помощь" .
      515                                   v-help-old-x = hh:column .
      516                                   v-help-old-y = hh:row    .
      517                                   v-help-old-size = hh:width .
      518                                   hh:width-chars = 2.5 .
      519                               end.
      520                           when "b-print" then
      521                               do:
      522                                   hh:load-image("cmp/b-print.bmp":u) .
      523                                   hh:TOOLTIP = "Печать" .
      524                                   v-h[ii] = hh:handle .
      525                                   ii = ii + 1 .
      526                                   hh:width-chars = 3 .
      527                               end.
      528                           when "b-history" or
      529                           when "b-hist" then
      530                               do:
      531                                   hh:load-image("cmp/b-hist.bmp":u) .
      532                                   hh:TOOLTIP = "История" .
      533                                   v-h[ii] = hh:handle .
      534                                   ii = ii + 1 .
      535                                   hh:width-chars = 3 .
      536                               end.
      537                           when "b-sch" then
      538                               do:
      539                                   hh:load-image("cmp/b-sch.bmp":u) .
      540                                   hh:TOOLTIP = "Установка Фильтра" .
      541                                   v-h[ii] = hh:handle .
      542                                   ii = ii + 1 .
      543                                   hh:width-chars = 3 .
      544                               end.
      545                           when "b-hist-user" then
      546                               do:
      547                                   hh:load-image("cmp/b-hist.bmp":u) .
      548                                   hh:TOOLTIP = "История пользователя" .
      549                                   ii = ii + 1 .
      550                               end.
      551                       end case.
      552                   end.
      553                   hh = hh:next-sibling.
      554               end.
      555               b-help:column = v-frame-width - b-help:width-chars.
      556               jj = 0.
      557               repeat ii = 4 to 1 by -1 :
      558                   if valid-handle (v-h[ii] ) then
      559                   do:
      560                       jj  = jj + 1 .
      561                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      562                       v-h[ii]:row    = v-help-old-y .
      563                   end.
      564               end.
      565           end.
      566       end.
      567   end procedure.
      568   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      569   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      570   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      571   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      572   define variable v-diasize-current-frame-width  as decimal   no-undo .
      573   define variable v-diasize-current-frame-height as decimal   no-undo .
      574   define variable v-diasize-change-size          as logical   no-undo .
      575   define variable v-diasize-resize-button        as handle    no-undo .
      576   define variable v-diasize-wndmax               as logical   no-undo .
      577   define variable v-diasize-wndstore             as logical   no-undo .
      578   define variable v-diasize-proc-name            as character no-undo .
      579   define variable v-diasize-browse-handle        as handle    no-undo .
      580   define variable v-diasize-browse-number        as integer   no-undo .
      581   define variable v-diasize-need-full-display    as logical   no-undo init false .
      582   define temp-table temp-diasize-handle no-undo
      583     field handle-value  as handle
      584     field save-position as decimal
      585     index xpk is primary unique handle-value
      586     .
      587   define temp-table temp-browse-handle no-undo
      588     field browse-type   as character
      589     field browse-number as integer
      590     field browse-handle as handle
      591     field original-size as decimal
      592     index xpk is primary unique browse-type browse-number
      593     index xie browse-type browse-handle
      594   .
      595   procedure diasize_change-height :
      596     define input  parameter p-change-value  as decimal   no-undo .
      597     define input  parameter p-move-resize   as logical   no-undo .
      598     define variable v-field-group-handle    as handle    no-undo .
      599     define variable v-object-handle         as handle    no-undo .
      600     define variable v-frame-height          as decimal   no-undo .
      601     define variable v-frame-virtual-height  as decimal   no-undo .
      602     define variable v-browse-height         as decimal   no-undo .
      603     define variable v-window-height         as decimal   no-undo .
      604     define variable v-window-virtual-height as decimal   no-undo .
      605     define variable v-change-sign           as integer   no-undo .
      606     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      607     define buffer buf_temp-browse-handle  for temp-browse-handle .
      608     if p-change-value > 0
      609     then do:
      610       if frame Dialog-Frame :height + p-change-value
      611           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      612       then do:
      613         assign
      614           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      615                           - (frame Dialog-Frame :height-chars)
      616         .
      617         if p-change-value <= 0
      618         then do:
      619           run diasize_position-resize-button in this-procedure .
      620           return .
      621         end.
      622       end.
      623     end.
      624     if p-change-value < 0
      625     then do:
      626       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      627       then do:
      628         assign
      629           p-change-value = v-diasize-orig-frame-height
      630                          - (frame Dialog-Frame :height-chars)
      631         .
      632         if p-change-value >= 0
      633         then do:
      634           run diasize_position-resize-button in this-procedure .
      635           return .
      636         end.
      637       end.
      638     end.
      639     if p-change-value >= 0
      640     then do:
      641       assign
      642         v-change-sign = 1
      643       .
      644     end.
      645     else do:
      646       assign
      647         v-change-sign = -1
      648       .
      649     end.
      650     assign
      651       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      652     .
      653     if p-change-value = 0
      654     then do:
      655       run diasize_position-resize-button in this-procedure .
      656       return .
      657     end.
      658     move_block:
      659     do
      660     on error undo move_block, retry move_block
      661     :
      662       if retry
      663       then do:
      664         do
      665         on error undo move_block, leave move_block
      666         :
      667           if p-change-value > 0
      668           then do:
      669             for each buf_temp-diasize-handle
      670             on error undo, next
      671             :
      672               assign
      673                 v-object-handle = buf_temp-diasize-handle.handle-value
      674               .
      675               if v-object-handle <> v-diasize-resize-button
      676               then do:
      677                 assign
      678                   v-object-handle :row = buf_temp-diasize-handle.save-position
      679                 .
      680               end.
      681             end.
      682             assign
      683               v-diasize-browse-handle :height = v-browse-height
      684             .
      685             for each buf_temp-browse-handle
      686               where buf_temp-browse-handle.browse-type = 'height':u
      687             on error undo, next
      688             :
      689               assign
      690                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      691               .
      692             end.
      693             assign
      694               frame Dialog-Frame :height = v-frame-height
      695             .
      696             if frame Dialog-Frame :scrollable = true
      697             then do:
      698               assign
      699                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      700               .
      701             end.
      702             run diasize_position-resize-button in this-procedure .
      703           end.
      704           else do:
      705             if frame Dialog-Frame :scrollable = true
      706             then do:
      707               assign
      708                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      709               .
      710             end.
      711             assign
      712               frame Dialog-Frame :height = v-frame-height
      713             .
      714             assign
      715               v-diasize-browse-handle :height = v-browse-height
      716             .
      717             for each buf_temp-browse-handle
      718               where buf_temp-browse-handle.browse-type = 'height':u
      719             on error undo, next
      720             :
      721               assign
      722                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      723               .
      724             end.
      725             for each buf_temp-diasize-handle
      726             on error undo, next
      727             :
      728               assign
      729                 v-object-handle = buf_temp-diasize-handle.handle-value
      730               .
      731               if v-object-handle <> v-diasize-resize-button
      732               then do:
      733                 assign
      734                   v-object-handle :row = buf_temp-diasize-handle.save-position
      735                 .
      736               end.
      737             end.
      738             run diasize_position-resize-button in this-procedure .
      739           end.
      740           assign
      741             v-diasize-change-size = false
      742           .
      743           leave move_block .
      744         end.
      745       end.
      746       assign
      747         v-diasize-need-full-display = true
      748       .
      749       if v-diasize-change-size = false
      750       then do:
      751         assign
      752           v-diasize-change-size = true
      753         .
      754       end.
      755       else do:
      756         return .
      757       end.
      758       assign
      759         v-frame-height = frame Dialog-Frame :height
      760         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      761         v-browse-height = v-diasize-browse-handle :height
      762       .
      763       for each buf_temp-browse-handle
      764         where buf_temp-browse-handle.browse-type = 'height':u
      765       :
      766         assign
      767           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      768         .
      769       end.
      770       for each buf_temp-diasize-handle
      771       :
      772         delete buf_temp-diasize-handle .
      773       end.
      774       assign
      775         v-field-group-handle = frame Dialog-Frame :first-child
      776       .
      777       do while valid-handle(v-field-group-handle)
      778       :
      779         assign
      780           v-object-handle = v-field-group-handle :first-child
      781         .
      782         do while valid-handle(v-object-handle)
      783         :
      784           if  v-object-handle <> v-diasize-browse-handle :handle
      785           and can-query(v-object-handle, "row")
      786           and can-query(v-object-handle, "height")
      787           and ( v-object-handle :row > v-diasize-browse-handle :row )
      788           then do:
      789             find first buf_temp-browse-handle
      790               where buf_temp-browse-handle.browse-type   = 'height':u
      791                 and buf_temp-browse-handle.browse-handle = v-object-handle
      792               no-error .
      793             if available buf_temp-browse-handle
      794             then do:
      795             end.
      796             else do:
      797               create buf_temp-diasize-handle .
      798               assign
      799                 buf_temp-diasize-handle.handle-value  = v-object-handle
      800                 buf_temp-diasize-handle.save-position = v-object-handle :row
      801               .
      802             end.
      803           end.
      804           assign
      805             v-object-handle = v-object-handle :next-sibling
      806           .
      807         end.
      808         assign
      809           v-field-group-handle = v-field-group-handle :next-sibling
      810         .
      811       end.
      812       do with frame Dialog-Frame
      813       :
      814         hide v-diasize-resize-button .
      815         assign
      816           v-diasize-resize-button :row    = 1
      817           v-diasize-resize-button :column = 1
      818         .
      819       end.
      820       if p-change-value > 0
      821       then do:
      822         if frame Dialog-Frame :scrollable = true
      823         then do:
      824           assign
      825             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      826             no-error .
      827           if error-status :error
      828           or error-status :get-message(1) <> ""
      829           then do:
      830             undo move_block, retry move_block .
      831           end.
      832         end.
      833         assign
      834           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      835           no-error .
      836         if error-status :error
      837         or error-status :get-message(1) <> ""
      838         then do:
      839           undo move_block, retry move_block .
      840         end.
      841         assign
      842           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      843           no-error .
      844         if error-status :error
      845         or error-status :get-message(1) <> ""
      846         then do:
      847           undo move_block, retry move_block .
      848         end.
      849         for each buf_temp-browse-handle
      850           where buf_temp-browse-handle.browse-type = 'height':u
      851         on error undo move_block, retry move_block
      852         :
      853           assign
      854             buf_temp-browse-handle.browse-handle :height
      855               = buf_temp-browse-handle.browse-handle :height + p-change-value
      856             no-error .
      857           if error-status :error
      858           or error-status :get-message(1) <> ""
      859           then do:
      860             undo move_block, retry move_block .
      861           end.
      862         end.
      863         for each buf_temp-diasize-handle
      864         on error undo move_block, retry move_block
      865         :
      866           assign
      867             v-object-handle = buf_temp-diasize-handle.handle-value
      868           .
      869           if v-object-handle <> v-diasize-resize-button
      870           then do:
      871             assign
      872               v-object-handle :row = v-object-handle :row + p-change-value
      873               no-error .
      874             if error-status :error
      875             or error-status :get-message(1) <> ""
      876             then do:
      877               undo move_block, retry move_block .
      878             end.
      879           end.
      880         end.
      881       end.
      882       else do:
      883         for each buf_temp-diasize-handle
      884         on error undo move_block, retry move_block
      885         :
      886           assign
      887             v-object-handle = buf_temp-diasize-handle.handle-value
      888           .
      889           if v-object-handle <> v-diasize-resize-button
      890           then do:
      891             assign
      892               v-object-handle :row = v-object-handle :row + p-change-value
      893               no-error .
      894             if error-status :error
      895             or error-status :get-message(1) <> ""
      896             then do:
      897               undo move_block, retry move_block .
      898             end.
      899           end.
      900         end.
      901         assign
      902           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      903           no-error .
      904         if error-status :error
      905         or error-status :get-message(1) <> ""
      906         then do:
      907           undo move_block, retry move_block .
      908         end.
      909         for each buf_temp-browse-handle
      910           where buf_temp-browse-handle.browse-type = 'height':u
      911         on error undo move_block, retry move_block
      912         :
      913           assign
      914             buf_temp-browse-handle.browse-handle :height
      915               = buf_temp-browse-handle.browse-handle :height + p-change-value
      916             no-error .
      917           if error-status :error
      918           or error-status :get-message(1) <> ""
      919           then do:
      920             undo move_block, retry move_block .
      921           end.
      922         end.
      923         assign
      924           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      925           no-error .
      926         if error-status :error
      927         or error-status :get-message(1) <> ""
      928         then do:
      929           undo move_block, retry move_block .
      930         end.
      931         if frame Dialog-Frame :scrollable = true
      932         then do:
      933           assign
      934             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      935             no-error .
      936           if error-status :error
      937           or error-status :get-message(1) <> ""
      938           then do:
      939             undo move_block, retry move_block .
      940           end.
      941         end.
      942       end.
      943       if p-move-resize = true
      944       then do:
      945         run diasize_position-resize-button in this-procedure .
      946       end.
      947       if v-diasize-wndstore = true
      948       then do:
      949         if connected("ub") = true
      950         then do:
      951           define variable v-cntxt-db-num        as integer   no-undo .
      952           define variable v-cntxt-userid        as character no-undo .
      953           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      954                                             , OUTPUT v-cntxt-userid
      955                                             ) .
      956           run gbl/wndsizew.p
      957             (input  v-cntxt-db-num
      958             ,input  v-cntxt-userid
      959             ,input  v-diasize-proc-name
      960             ,input  'height':u
      961             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      962             ) .
      963         end.
      964       end.
      965     end.
      966     assign
      967       v-diasize-change-size = false
      968     .
      969   end procedure.
      970   procedure diasize_set-height :
      971     define input  parameter p-new-height  as decimal   no-undo .
      972     define input  parameter p-move-resize as logical   no-undo .
      973     do
      974     on error undo, return error return-value
      975     :
      976       run diasize_change-height in this-procedure
      977         (input  (p-new-height - frame Dialog-Frame :height)
      978         ,input  p-move-resize
      979         ) .
      980     end.
      981   end procedure.
      982   procedure diasize_change-width :
      983     define input  parameter p-change-value as decimal   no-undo .
      984     define input  parameter p-move-resize  as logical   no-undo .
      985     define variable v-field-group-handle   as handle    no-undo .
      986     define variable v-object-handle        as handle    no-undo .
      987     define variable v-frame-width          as decimal   no-undo .
      988     define variable v-frame-virtual-width  as decimal   no-undo .
      989     define variable v-browse-width         as decimal   no-undo .
      990     define variable v-window-width         as decimal   no-undo .
      991     define variable v-window-virtual-width as decimal   no-undo .
      992     define variable v-change-sign          as integer   no-undo .
      993     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      994     define buffer buf_temp-browse-handle  for temp-browse-handle .
      995     if p-change-value > 0
      996     then do:
      997       if frame Dialog-Frame :width + p-change-value >
      998           session :width-chars
      999       then do:
     1000         assign
     1001           p-change-value = session :width-chars - frame Dialog-Frame :width
     1002         .
     1003         if p-change-value <= 0
     1004         then do:
     1005           run diasize_position-resize-button in this-procedure .
     1006           return .
     1007         end.
     1008       end.
     1009     end.
     1010     if p-change-value < 0
     1011     then do:
     1012       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1013       then do:
     1014         assign
     1015           p-change-value = v-diasize-orig-frame-width
     1016                          - frame Dialog-Frame :width
     1017         .
     1018         if p-change-value >= 0
     1019         then do:
     1020           run diasize_position-resize-button in this-procedure .
     1021           return .
     1022         end.
     1023       end.
     1024     end.
     1025     if p-change-value >= 0
     1026     then do:
     1027       assign
     1028         v-change-sign = 1
     1029       .
     1030     end.
     1031     else do:
     1032       assign
     1033         v-change-sign = -1
     1034       .
     1035     end.
     1036     assign
     1037       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1038     .
     1039     if p-change-value = 0
     1040     then do:
     1041       run diasize_position-resize-button in this-procedure .
     1042       return .
     1043     end.
     1044     move_block:
     1045     do
     1046     on error undo move_block, leave move_block
     1047     :
     1048       if retry
     1049       then do:
     1050         do
     1051         on error undo move_block, leave move_block
     1052         :
     1053           if p-change-value > 0
     1054           then do:
     1055             for each buf_temp-diasize-handle
     1056             on error undo, next
     1057             :
     1058               assign
     1059                 v-object-handle = buf_temp-diasize-handle.handle-value
     1060               .
     1061               if v-object-handle <> v-diasize-resize-button
     1062               then do:
     1063                 assign
     1064                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1065                 .
     1066               end.
     1067             end.
     1068             assign
     1069               v-diasize-browse-handle :width = v-browse-width
     1070             .
     1071             for each buf_temp-browse-handle
     1072               where buf_temp-browse-handle.browse-type = 'width':u
     1073             on error undo, next
     1074             :
     1075               assign
     1076                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1077               .
     1078             end.
     1079             assign
     1080               frame Dialog-Frame :width = v-frame-width
     1081             .
     1082             if frame Dialog-Frame :scrollable = true
     1083             then do:
     1084               assign
     1085                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1086               .
     1087             end.
     1088             run diasize_position-resize-button in this-procedure .
     1089           end.
     1090           else do:
     1091             if frame Dialog-Frame :scrollable = true
     1092             then do:
     1093               assign
     1094                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1095               .
     1096             end.
     1097             assign
     1098               frame Dialog-Frame :width = v-frame-width
     1099             .
     1100             for each buf_temp-browse-handle
     1101               where buf_temp-browse-handle.browse-type = 'width':u
     1102             on error undo, next
     1103             :
     1104               assign
     1105                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1106               .
     1107             end.
     1108             assign
     1109               v-diasize-browse-handle :width = v-browse-width
     1110             .
     1111             for each buf_temp-diasize-handle
     1112             on error undo, next
     1113             :
     1114               assign
     1115                 v-object-handle = buf_temp-diasize-handle.handle-value
     1116               .
     1117               if v-object-handle <> v-diasize-resize-button
     1118               then do:
     1119                 assign
     1120                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1121                 .
     1122               end.
     1123             end.
     1124             run diasize_position-resize-button in this-procedure .
     1125           end.
     1126           assign
     1127             v-diasize-change-size = false
     1128           .
     1129           leave move_block .
     1130         end.
     1131       end.
     1132       assign
     1133         v-diasize-need-full-display = true
     1134       .
     1135       if v-diasize-change-size = false
     1136       then do:
     1137         assign
     1138           v-diasize-change-size = true
     1139         .
     1140       end.
     1141       else do:
     1142         return .
     1143       end.
     1144       assign
     1145         v-frame-width = frame Dialog-Frame :width
     1146         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1147         v-browse-width = v-diasize-browse-handle :width
     1148       .
     1149       for each buf_temp-browse-handle
     1150         where buf_temp-browse-handle.browse-type = 'width':u
     1151       :
     1152         assign
     1153           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1154         .
     1155       end.
     1156       for each buf_temp-diasize-handle
     1157       :
     1158         delete buf_temp-diasize-handle .
     1159       end.
     1160       assign
     1161         v-field-group-handle = frame Dialog-Frame :first-child
     1162       .
     1163       do while valid-handle(v-field-group-handle)
     1164       :
     1165         assign
     1166           v-object-handle = v-field-group-handle :first-child
     1167         .
     1168         do while valid-handle(v-object-handle)
     1169         :
     1170           if  v-object-handle <> v-diasize-browse-handle :handle
     1171           and v-object-handle <> v-diasize-resize-button
     1172           and can-query(v-object-handle, "row")
     1173           and can-query(v-object-handle, "height")
     1174           and ( v-object-handle :col + v-object-handle :width
     1175                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1176               )
     1177           then do:
     1178             find first buf_temp-browse-handle
     1179               where buf_temp-browse-handle.browse-type   = 'width':u
     1180                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1181               no-error .
     1182             if available buf_temp-browse-handle
     1183             then do:
     1184             end.
     1185             else do:
     1186               create buf_temp-diasize-handle .
     1187               assign
     1188                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1189                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1190               .
     1191             end.
     1192           end.
     1193           assign
     1194             v-object-handle = v-object-handle :next-sibling
     1195           .
     1196         end.
     1197         assign
     1198           v-field-group-handle = v-field-group-handle :next-sibling
     1199         .
     1200       end.
     1201       do with frame Dialog-Frame
     1202       :
     1203         hide v-diasize-resize-button .
     1204         v-diasize-resize-button :row = 1.
     1205         v-diasize-resize-button :column = 1.
     1206       end.
     1207       if p-change-value > 0
     1208       then do:
     1209         if frame Dialog-Frame :scrollable = true
     1210         then do:
     1211           assign
     1212             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1213             no-error .
     1214           if error-status :error
     1215           or error-status :get-message(1) <> ""
     1216           then do:
     1217             undo move_block, retry move_block.
     1218           end.
     1219         end.
     1220         assign
     1221           frame Dialog-Frame :width = v-frame-width + p-change-value
     1222           no-error .
     1223         if error-status :error
     1224         or error-status :get-message(1) <> ""
     1225         then do:
     1226           undo move_block, retry move_block.
     1227         end.
     1228         assign
     1229           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1230         no-error .
     1231         if error-status :error
     1232         or error-status :get-message(1) <> ""
     1233         then do:
     1234           undo move_block, retry move_block.
     1235         end.
     1236         for each buf_temp-browse-handle
     1237           where buf_temp-browse-handle.browse-type = 'width':u
     1238         on error undo move_block, retry move_block
     1239         :
     1240           assign
     1241             buf_temp-browse-handle.browse-handle :width
     1242               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1243             no-error .
     1244           if error-status :error
     1245           or error-status :get-message(1) <> ""
     1246           then do:
     1247             undo move_block, retry move_block .
     1248           end.
     1249         end.
     1250         for each buf_temp-diasize-handle
     1251         on error undo move_block, retry move_block
     1252         :
     1253           assign
     1254             v-object-handle = buf_temp-diasize-handle.handle-value
     1255           .
     1256           if v-object-handle <> v-diasize-resize-button
     1257           then do:
     1258             assign
     1259               v-object-handle :col = v-object-handle :col + p-change-value
     1260               no-error .
     1261             if error-status :error
     1262             or error-status :get-message(1) <> ""
     1263             then do:
     1264               undo move_block, retry move_block .
     1265             end.
     1266           end.
     1267         end.
     1268       end.
     1269       else do:
     1270         for each buf_temp-diasize-handle
     1271         on error undo move_block, retry move_block
     1272         :
     1273           assign
     1274             v-object-handle = buf_temp-diasize-handle.handle-value
     1275           .
     1276           if v-object-handle <> v-diasize-resize-button
     1277           then do:
     1278             assign
     1279               v-object-handle :col = v-object-handle :col + p-change-value
     1280               no-error .
     1281             if error-status :error
     1282             or error-status :get-message(1) <> ""
     1283             then do:
     1284               undo move_block, retry move_block .
     1285             end.
     1286           end.
     1287         end.
     1288         for each buf_temp-browse-handle
     1289           where buf_temp-browse-handle.browse-type = 'width':u
     1290         on error undo move_block, retry move_block
     1291         :
     1292           assign
     1293             buf_temp-browse-handle.browse-handle :width
     1294               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1295             no-error .
     1296           if error-status :error
     1297           or error-status :get-message(1) <> ""
     1298           then do:
     1299             undo move_block, retry move_block .
     1300           end.
     1301         end.
     1302         assign
     1303           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1304           no-error .
     1305         if error-status :error
     1306         or error-status :get-message(1) <> ""
     1307         then do:
     1308           undo move_block, retry move_block.
     1309         end.
     1310         assign
     1311           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1312         no-error .
     1313         if error-status :error
     1314         or error-status :get-message(1) <> ""
     1315         then do:
     1316           undo move_block, retry move_block.
     1317         end.
     1318         if frame Dialog-Frame :scrollable = true
     1319         then do:
     1320           assign
     1321             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1322           no-error .
     1323           if error-status :error
     1324           or error-status :get-message(1) <> ""
     1325           then do:
     1326             undo move_block, retry move_block.
     1327           end.
     1328         end.
     1329       end.
     1330       if p-move-resize
     1331       then do:
     1332         run diasize_position-resize-button in this-procedure .
     1333       end.
     1334       if v-diasize-wndstore = true
     1335       then do:
     1336         if connected("ub") = true
     1337         then do:
     1338           define variable v-cntxt-db-num        as integer   no-undo .
     1339           define variable v-cntxt-userid        as character no-undo .
     1340           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1341                                             , OUTPUT v-cntxt-userid
     1342                                             ) .
     1343           run gbl/wndsizew.p
     1344             (input  v-cntxt-db-num
     1345             ,input  v-cntxt-userid
     1346             ,input  v-diasize-proc-name
     1347             ,input  'width':u
     1348             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1349             ) .
     1350         end.
     1351       end.
     1352     end.
     1353     assign
     1354       v-diasize-change-size = false
     1355     .
     1356   end procedure.
     1357   procedure diasize_set-width :
     1358     define input  parameter p-new-width  as decimal   no-undo .
     1359     define input  parameter p-move-resize as logical   no-undo .
     1360     do
     1361     on error undo, return error return-value
     1362     :
     1363       run diasize_change-width in this-procedure
     1364         (input  (p-new-width - frame Dialog-Frame :width)
     1365         ,input  p-move-resize
     1366         ) .
     1367     end.
     1368   end procedure.
     1369   procedure diasize_position-resize-button :
     1370     do with frame Dialog-Frame
     1371     :
     1372       hide v-diasize-resize-button .
     1373       assign
     1374         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1375                     - 1
     1376                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1377         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1378                     - 1
     1379                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1380       .
     1381       view v-diasize-resize-button .
     1382     end.
     1383   end procedure.
     1384   on alt-right anywhere
     1385   do:
     1386     run diasize_change-width in this-procedure
     1387       (input 1
     1388       ,input true
     1389       ) .
     1390     return no-apply .
     1391   end.
     1392   on alt-left anywhere
     1393   do:
     1394     run diasize_change-width in this-procedure
     1395       (input -1
     1396       ,input true
     1397       ) .
     1398     return no-apply .
     1399   end.
     1400   on alt-down anywhere
     1401   do:
     1402     run diasize_change-height in this-procedure
     1403       (input 1
     1404       ,input true
     1405       ) .
     1406     return no-apply .
     1407   end.
     1408   on alt-up anywhere
     1409   do:
     1410     run diasize_change-height in this-procedure
     1411       (input -1
     1412       ,input true
     1413       ) .
     1414     return no-apply .
     1415   end.
     1416   on alt-enter of frame Dialog-Frame
     1417   do:
     1418     run diasize_maximize in this-procedure
     1419       (input  ?
     1420       ).
     1421     return no-apply .
     1422   end.
     1423   procedure diasize_end-move :
     1424     do
     1425     on error undo, return error return-value
     1426     :
     1427       define variable v-row-delta as decimal   no-undo .
     1428       define variable v-col-delta as decimal   no-undo .
     1429       define variable v-new-row as decimal   no-undo .
     1430       define variable v-new-col as decimal   no-undo .
     1431       assign
     1432         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1433         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1434       .
     1435       assign
     1436         v-row-delta = v-new-row - frame Dialog-Frame :height
     1437         v-col-delta = v-new-col - frame Dialog-Frame :width
     1438       .
     1439       run diasize_change-height in this-procedure
     1440         (input v-row-delta
     1441         ,input true
     1442         ) .
     1443       run diasize_change-width in this-procedure
     1444         (input v-col-delta
     1445         ,input true
     1446         ) .
     1447     end.
     1448   end procedure.
     1449   procedure diasize_maximize :
     1450     define input  parameter p-action as logical   no-undo .
     1451     do
     1452     on error undo, return error return-value
     1453     :
     1454       if p-action = ?
     1455       then do:
     1456         if v-diasize-need-maximize = true
     1457         then do:
     1458           assign
     1459             p-action = true
     1460           .
     1461         end.
     1462         else do:
     1463           assign
     1464             p-action = false
     1465           .
     1466         end.
     1467       end.
     1468       if p-action = true
     1469       then do:
     1470         run diasize_change-height in this-procedure
     1471           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1472               - frame Dialog-Frame :height-chars
     1473           ,input true
     1474           ) .
     1475         run diasize_change-width in this-procedure
     1476           (input session :width-chars
     1477               - frame Dialog-Frame :width-chars
     1478           ,input true
     1479           ) .
     1480         assign
     1481           v-diasize-need-maximize = false
     1482         .
     1483       end.
     1484       else do:
     1485         run diasize_change-width in this-procedure
     1486           (input v-diasize-orig-frame-width
     1487               - frame Dialog-Frame :width-chars
     1488           ,input true
     1489           ) .
     1490         run diasize_change-height in this-procedure
     1491           (input v-diasize-orig-frame-height
     1492               - frame Dialog-Frame :height-chars
     1493           ,input true
     1494           ) .
     1495         assign
     1496           v-diasize-need-maximize = true
     1497         .
     1498       end.
     1499     end.
     1500   end procedure.
     1501   procedure diasize_restore-orig-size :
     1502     do
     1503     on error undo, return error return-value
     1504     :
     1505       assign
     1506         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1507         v-diasize-current-frame-height = frame Dialog-Frame :height
     1508       .
     1509       run diasize_set-height in this-procedure
     1510         (input  v-diasize-orig-frame-height
     1511         ,input  true
     1512         ) .
     1513       run diasize_set-width in this-procedure
     1514         (input  v-diasize-orig-frame-width
     1515         ,input  true
     1516         ) .
     1517     end.
     1518   end procedure.
     1519   procedure diasize_restore-current-size :
     1520     do
     1521     on error undo, return error return-value
     1522     :
     1523       run diasize_set-height in this-procedure
     1524         (input  v-diasize-current-frame-height
     1525         ,input  true
     1526         ) .
     1527       run diasize_set-width in this-procedure
     1528         (input  v-diasize-current-frame-width
     1529         ,input  true
     1530         ) .
     1531     end.
     1532   end procedure.
     1533   procedure diasize_set-browse-handle :
     1534     define input  parameter p-browse-handle as handle   no-undo .
     1535     define buffer buf_temp-browse-handle for temp-browse-handle .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       assign
     1540         v-diasize-browse-handle = p-browse-handle
     1541       .
     1542       for each buf_temp-browse-handle
     1543       on error undo, return error return-value
     1544       :
     1545         delete buf_temp-browse-handle .
     1546       end.
     1547     end.
     1548   end procedure.
     1549   procedure diasize_add_browse :
     1550     define input  parameter p-browse-type   as character no-undo .
     1551     define input  parameter p-browse-handle as handle    no-undo .
     1552     define buffer buf_temp-browse-handle for temp-browse-handle .
     1553     do
     1554     on error undo, return error return-value
     1555     :
     1556       assign
     1557         v-diasize-browse-number = v-diasize-browse-number + 1
     1558       .
     1559       create buf_temp-browse-handle .
     1560       assign
     1561         buf_temp-browse-handle.browse-type   = p-browse-type
     1562         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1563         buf_temp-browse-handle.browse-handle = p-browse-handle
     1564       .
     1565     end.
     1566   end procedure.
     1567   procedure diasize_init :
     1568     define variable v-default-value    as logical   no-undo .
     1569     define variable v-restore-saved    as logical   no-undo .
     1570     define variable v-resize-value-str as character no-undo .
     1571     do
     1572     on error undo, return error return-value
     1573     :
     1574       do with frame Dialog-Frame
     1575       :
     1576         assign
     1577           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1578           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1579           v-diasize-browse-handle     = browse b-slt-vat :handle
     1580         .
     1581         create button v-diasize-resize-button
     1582         assign
     1583           parent        = frame Dialog-Frame :first-child
     1584           label         = "s"
     1585           height-pixels = 16
     1586           width-pixels  = 16
     1587           visible       = true
     1588           sensitive     = true
     1589           movable       = true
     1590           triggers:
     1591             on end-move persistent run diasize_end-move in this-procedure .
     1592           end triggers.
     1593         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1594         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1595         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1596         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1597         assign
     1598           v-diasize-wndmax = false
     1599         .
     1600         if connected("ub") = true
     1601         then do:
     1602           define variable v-cntxt-db-num        as integer   no-undo .
     1603           define variable v-cntxt-userid        as character no-undo .
     1604           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1605                                             , OUTPUT v-cntxt-userid
     1606                                             ) .
     1607           run gbl/wndpar_r.p
     1608             (input  v-cntxt-db-num
     1609             ,input  v-cntxt-userid
     1610             ,input  'wndmax':U
     1611             ,output v-diasize-wndmax
     1612             ,output v-default-value
     1613             ) .
     1614         end.
     1615         assign
     1616           v-diasize-wndstore = false
     1617         .
     1618         if connected("ub") = true
     1619         then do:
     1620           run gbl/wndpar_r.p
     1621             (input  v-cntxt-db-num
     1622             ,input  v-cntxt-userid
     1623             ,input  'wndstore':U
     1624             ,output v-diasize-wndstore
     1625             ,output v-default-value
     1626             ) .
     1627         end.
     1628         assign
     1629           v-diasize-proc-name = entry(1, program-name(2), '.')
     1630         .
     1631         if v-diasize-wndstore = true
     1632         then do:
     1633           assign
     1634             v-restore-saved = false
     1635           .
     1636           if connected("ub") = true
     1637           then do:
     1638             run gbl/wndsizer.p
     1639               (input  v-cntxt-db-num
     1640               ,input  v-cntxt-userid
     1641               ,input  v-diasize-proc-name
     1642               ,input  'height':u
     1643               ,output v-resize-value-str
     1644               ) .
     1645             if v-resize-value-str <> '':U
     1646             then do:
     1647               run diasize_change-height in this-procedure
     1648                 (input  integer(v-resize-value-str)
     1649                 ,input  true
     1650                 ) .
     1651               assign
     1652                 v-restore-saved = true
     1653               .
     1654             end.
     1655           end.
     1656           if connected("ub") = true
     1657           then do:
     1658             run gbl/wndsizer.p
     1659               (input  v-cntxt-db-num
     1660               ,input  v-cntxt-userid
     1661               ,input  v-diasize-proc-name
     1662               ,input  'width':u
     1663               ,output v-resize-value-str
     1664               ) .
     1665             if v-resize-value-str <> '':U
     1666             then do:
     1667               run diasize_change-width in this-procedure
     1668                 (input  integer(v-resize-value-str)
     1669                 ,input  true
     1670                 ) .
     1671               assign
     1672                 v-restore-saved = true
     1673               .
     1674             end.
     1675           end.
     1676           if v-restore-saved <> true
     1677           then do:
     1678             if v-diasize-wndmax = true
     1679             then do:
     1680               run diasize_maximize in this-procedure
     1681                 (input  true
     1682                 ) .
     1683             end.
     1684           end.
     1685         end.
     1686         else do:
     1687           if v-diasize-wndmax = true
     1688           then do:
     1689             run diasize_maximize in this-procedure
     1690               (input  true
     1691               ) .
     1692           end.
     1693         end.
     1694       end.
     1695     end.
     1696   end procedure.
     1697   procedure diasize_need-full-display :
     1698     define output parameter p-need-full-display as logical   no-undo .
     1699     do
     1700     on error undo, return error return-value
     1701     :
     1702       assign
     1703         p-need-full-display = v-diasize-need-full-display
     1704       .
     1705       assign
     1706         v-diasize-need-full-display = false
     1707       .
     1708     end.
     1709   end procedure.
     1710   procedure get-context :
     1711      define output parameter p-db-num as integer          no-undo.
     1712      define output parameter p-user-id as character        no-undo.
     1713      define variable v-login               as character    no-undo.
     1714      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1715      define buffer buf_user-login  for ub.user-login .
     1716      do
     1717      on error undo, return error
     1718      :
     1719            FIND FIRST buf_sys-ctrl no-lock.
     1720            ASSIGN
     1721               v-login = USERID("ub")
     1722               p-db-num = buf_sys-ctrl.db-num
     1723            .
     1724            FIND FIRST buf_user-login
     1725                 WHERE buf_user-login.db-num = p-db-num
     1726                   AND buf_user-login.user-login = v-login
     1727                 no-lock
     1728                 no-error
     1729                 .
     1730            IF AVAILABLE buf_user-login
     1731            THEN DO:
     1732               assign
     1733                  p-user-id = buf_user-login.user-id
     1734               .
     1735            END.
     1736      end.
     1737   end procedure.
     1738   run diasize_add_browse in this-procedure
     1739     (input  'width':u
     1740     ,input  browse b-slt-vat-cons :handle
     1741     ) .
     1742   run diasize_add_browse in this-procedure
     1743     (input  'width':u
     1744     ,input  browse b-slt-vat-cons-grp:handle
     1745     ) .
     1746   run diasize_add_browse in this-procedure
     1747     (input  'width':u
     1748     ,input  browse b-supp-slt-vat-cons:handle
     1749     ) .
     1750   run diasize_init in this-procedure .
     1751   run tax-name (input 'rdt':U, output varroad-tax-label) no-error.
     1752   assign
     1753   d-slts-vats.vat-pc:label in browse b-slt-vat = "НДС"
     1754   d-slts-vats.slt-pc:label in browse b-slt-vat = "НП"
     1755   d-slts-vats.fact-qnty:label in browse b-slt-vat = "Факт. кол-во"
     1756   d-slts-vats.acc-base:label in browse b-slt-vat = "Учет.цены (вал)"
     1757   d-slts-vats.acc-rubl:label in browse b-slt-vat = "Учет. цены (руб)"
     1758   d-slts-vats.acc-vat-base:label in browse b-slt-vat = "НДС Уч.цены (вал)"
     1759   d-slts-vats.acc-vat-rubl:label in browse b-slt-vat = "НДС Уч. цены (руб)"
     1760   d-slts-vats.sale-base:label in browse b-slt-vat  = "Продаж.цены"
     1761   d-slts-vats.ov-base:label in browse b-slt-vat = "Переоценка"
     1762   d-slts-vats.ov-vat:label in browse b-slt-vat = "НДС по переоценке"
     1763   d-slts-vats.pay-base:label in browse b-slt-vat = "К оплате (вал)"
