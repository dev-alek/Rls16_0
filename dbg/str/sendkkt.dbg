     1561   .
     1562   define temp-table temp_bgelib_trn-doc no-undo
     1563       field doc-code as integer
     1564   .
     1565   procedure bgelib-tag-open:
     1566   do
     1567   on error undo, return error
     1568   :
     1569   define input parameter v-tag-level  as integer      no-undo.
     1570   define input parameter v-tag-name   as character    no-undo.
     1571   define input parameter v-tag-value  as character    no-undo.
     1572       put stream stmXMLOut unformatted
     1573           chr(10)
     1574           + fill(" ", 4 * v-tag-level)
     1575           + "<" + v-tag-name
     1576           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1577           + v-tag-value + ">"
     1578       .
     1579   end.
     1580   end procedure.
     1581   procedure bgelib-tag-put:
     1582   do
     1583   on error undo, return error
     1584   :
     1585   define input parameter v-tag-level      as integer      no-undo.
     1586   define input parameter v-tag-name       as character    no-undo.
     1587   define input parameter v-tag-value      as character    no-undo.
     1588   define input parameter v-empty-mode     as integer      no-undo.
     1589       v-tag-name = trim(v-tag-name).
     1590       if  v-empty-mode = 1
     1591       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1592       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1593       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1594       then do:
     1595           run xmlchar-encode in this-procedure (
     1596                 input v-tag-value
     1597               , output v-tag-value
     1598           ).
     1599           put stream stmXMLOut unformatted
     1600               chr(10) + fill(" ", 4 * v-tag-level)
     1601                           + '<' + v-tag-name + '>'
     1602                           + v-tag-value
     1603                           + '</' + v-tag-name + '>'
     1604           .
     1605       end.
     1606   end.
     1607   end procedure.
     1608   procedure bgelib-tag-close:
     1609   do
     1610   on error undo, return error
     1611   :
     1612   define input parameter v-tag-level as integer      no-undo.
     1613   define input parameter v-tag-name  as character    no-undo.
     1614       put stream stmXMLOut unformatted
     1615           chr(10)
     1616           + fill( " ", 4 * v-tag-level)
     1617           + '</' + v-tag-name + '>'
     1618       .
     1619   end.
     1620   end procedure.
     1621   procedure bgelib-write-log:
     1622   do
     1623   on error undo, return error
     1624   :
     1625   define input parameter v-filename   as character    no-undo.
     1626   define input parameter v-log-level  as integer      no-undo.
     1627   define input parameter v-out-string as character    no-undo.
     1628       output stream stmXMLLog to value( v-filename ) append.
     1629       put stream stmXMLLog unformatted
     1630           chr(10)
     1631       .
     1632       put stream stmXMLLog unformatted
     1633           ( if v-log-level = 0
     1634             or v-out-string = "&DLine"
     1635             or v-out-string = "&Line"
     1636             then ""
     1637             else cur-time-string-sec() + " " )
     1638       .
     1639       put stream stmXMLLog unformatted
     1640           ( if v-out-string = "&Line"
     1641             then fill( "-", 80 )
     1642             else if v-out-string = "&DLine"
     1643                  then fill( "=", 80 )
     1644                  else v-out-string )
     1645       .
     1646       output stream stmXMLLog close.
     1647   end.
     1648   end procedure.
     1649   procedure bgelib-write-edt:
     1650   do
     1651   on error undo, return error
     1652   :
     1653   define input parameter v-editor-handle    as handle       no-undo.
     1654   define input parameter v-log-level        as integer      no-undo.
     1655   define input parameter v-out-string       as character    no-undo.
     1656       if valid-handle ( v-editor-handle )
     1657       then do:
     1658           v-editor-handle :move-to-eof().
     1659           v-editor-handle :insert-string( ( if v-log-level = 0
     1660                                             or v-out-string = "&DLine"
     1661                                             or v-out-string = "&Line"
     1662                                             then ""
     1663                                             else cur-time-string-sec() + " "
     1664                                         ) ).
     1665           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1666                                             then fill( "-", 80 )
     1667                                             else if v-out-string = "&DLine" then fill("=", 80)
     1668                                             else fill( " ", v-log-level) + v-out-string
     1669                                         ) ).
     1670           v-editor-handle :insert-string( chr(10) ).
     1671       end.
     1672       process events.
     1673       output to 'bgescn.txt' append.
     1674           put unformatted
     1675               chr(10)
     1676               string( ( if v-log-level = 0
     1677                         or v-out-string = "&DLine"
     1678                         or v-out-string = "&Line"
     1679                         then ""
     1680                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1681                     ) )
     1682               string( ( if v-out-string = "&Line"
     1683                         then fill( "-", 80 )
     1684                         else if v-out-string = "&DLine"
     1685                              then fill( "=", 80 )
     1686                              else fill( " ", v-log-level ) + v-out-string
     1687                     ) )
     1688           .
     1689       output close.
     1690   end.
     1691   end procedure.
     1692   procedure bgelib-show-cnt:
     1693   do
     1694   on error undo, return error
     1695   :
     1696   define input parameter v-fillin-handle     as handle   no-undo.
     1697       if valid-handle( v-fillin-handle )
     1698       then do:
     1699           assign
     1700               v-fillin-handle :visible = true
     1701           .
     1702       end.
     1703   end.
     1704   end procedure.
     1705   procedure bgelib-hide-cnt:
     1706   do
     1707   on error undo, return error
     1708   :
     1709   define input parameter v-fillin-handle     as handle   no-undo.
     1710       if valid-handle( v-fillin-handle )
     1711       then do:
     1712           assign v-fillin-handle :visible = false.
     1713       end.
     1714   end.
     1715   end procedure.
     1716   procedure bgelib-write-cnt:
     1717   do
     1718   on error undo, return error
     1719   :
     1720   define input parameter v-fillin-handle    as handle       no-undo.
     1721   define input parameter v-fillin-string    as character    no-undo.
     1722       if valid-handle( v-fillin-handle )
     1723       then do:
     1724           assign
     1725               v-fillin-handle :SCREEN-value = v-fillin-string
     1726           .
     1727       end.
     1728   end.
     1729   end procedure.
     1730   procedure bgelib-write-header:
     1731   do
     1732   on error undo, return error
     1733   :
     1734   define input parameter p-first-file     as logical      no-undo.
     1735   define input parameter p-xml-file-name  as character    no-undo.
     1736   define input parameter p-list-file-name as character    no-undo.
     1737   define input parameter p-file-number    as integer      no-undo.
     1738   define input parameter p-have-prev      as logical      no-undo.
     1739   define input parameter p-prev-filename  as character    no-undo.
     1740   define input parameter p-obj-list       as character    no-undo.
     1741   define input parameter p-doc-type-list  as character    no-undo.
     1742   define input parameter p-parameter-list as character    no-undo.
     1743       define variable v-counter    as integer        no-undo.
     1744       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1745       put stream stmXMLOut unformatted
     1746           "<?xml version='1.0' encoding='windows-1251'?>"
     1747       .
     1748       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1749       run bgelib-tag-open( input 0, input "header", input "" ).
     1750       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1751       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1752       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1753       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1754       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1755       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1756       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1757       :
     1758           run bgelib-tag-put(
     1759                 input 1
     1760               , input entry( 2 * v-counter, p-parameter-list )
     1761               , input entry( 2 * v-counter + 1, p-parameter-list )
     1762               , input 0
     1763           ).
     1764       end.
     1765       run bgelib-tag-close( input 0, input "header" ).
     1766       output stream stmXMLOut close.
     1767       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1768       if p-first-file = yes
     1769       then do:
     1770           put stream stmXMLOut unformatted
     1771               "<?xml version='1.0' encoding='windows-1251'?>"
     1772           .
     1773           run bgelib-tag-open( input 0, input "export", input "" ).
     1774       end.
     1775       run bgelib-tag-open( input 1, input "file", input "" ).
     1776       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1777       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1778       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1779       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1780       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1781       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1782       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1783       :
     1784           run bgelib-tag-put(
     1785                 input 2
     1786               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1787               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1788               , input 0
     1789           ).
     1790       end.
     1791       run bgelib-tag-close( input 1, input "file" ).
     1792       output stream stmXMLOut close.
     1793   end.
     1794   end procedure.
     1795   procedure bgelib-write-footer:
     1796   do
     1797   on error undo, return error
     1798   :
     1799   define input parameter p-last-file      as logical      no-undo.
     1800   define input parameter p-xml-file-name  as character    no-undo.
     1801   define input parameter p-list-file-name as character    no-undo.
     1802   define input parameter p-have-next      as logical      no-undo.
     1803   define input parameter p-next-file-name as character    no-undo.
     1804       define variable v-error-num     as integer           no-undo.
     1805       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1806       if p-have-next = yes
     1807       then do:
     1808           run bgelib-tag-open( input 0, input "footer", "" ).
     1809           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1810           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1811           run bgelib-tag-close( input 0, input "footer" ).
     1812       end.
     1813       run bgelib-tag-close( input 0, input "root" ).
     1814       output stream stmXMLOut close.
     1815       run bge/os_copy.p (
     1816             input "M"
     1817           , input p-xml-file-name + "tmp"
     1818           , input p-xml-file-name + "xml"
     1819           , output v-error-num
     1820       ).
     1821       if p-last-file = yes
     1822       then do:
     1823           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1824               run bgelib-tag-close( input 0, input "export" ).
     1825           output stream stmXMLOut close.
     1826           run bge/os_copy.p (
     1827                 input "M"
     1828               , input p-list-file-name + "tmp"
     1829               , input p-list-file-name + "xml"
     1830               , output v-error-num
     1831           ).
     1832       end.
     1833   end.
     1834   end procedure.
     1835   procedure bgelib-filename :
     1836   do
     1837   on error undo, return error
     1838   :
     1839   define input parameter p-prefix             as character    no-undo.
     1840   define output parameter p-xml-file-name     as character    no-undo.
     1841   define output parameter p-log-file-name     as character    no-undo.
     1842   define output parameter p-list-file-name    as character    no-undo.
     1843       define variable v-home-dir  as character    no-undo.
     1844       define variable v-error-num as integer      no-undo.
     1845       get-key-value section "BGE" key "outdir" value v-home-dir.
     1846       if v-home-dir = ?
     1847       then do:
     1848           message
     1849             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1850             skip(1)
     1851             skip "Обратитесь к администратору."
     1852           view-as alert-box error.
     1853           undo, return error .
     1854       end.
     1855       run gbl/dir-cre.p (
     1856           input v-home-dir
     1857       ) no-error.
     1858       if error-status :error
     1859       then do:
     1860           message
     1861             skip "Неверно задан каталог экспорта."
     1862             skip(1)
     1863             skip "Обратитесь к администратору."
     1864           view-as alert-box error.
     1865           undo, return error .
     1866       end.
     1867       run bge/genfname.p (
     1868             input v-home-dir
     1869           , input p-prefix
     1870           , input ""
     1871           , input "xml"
     1872           , input "tmp"
     1873           , output p-xml-file-name
     1874       ).
     1875       assign
     1876           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1877           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1878           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1879       .
     1880   end.
     1881   end procedure.
     1882   procedure bgelib-read-config :
     1883   do
     1884   on error undo, return error
     1885   :
     1886   define variable v-par-type as character     no-undo.
     1887     define variable v-param-type      as character  no-undo .
     1888     define variable v-value-character as character  no-undo .
     1889     define variable v-value-date      as date       no-undo .
     1890     define variable v-value-decimal   as decimal    no-undo .
     1891     define variable v-value-integer   as integer    no-undo .
     1892     define variable v-value-logical   as logical    no-undo .
     1893     define variable v-tth             as handle     no-undo .
     1894       assign
     1895           v-bgelib-bgeclall = no
     1896           v-bgelib-bgedict  = no
     1897       .
     1898       run adm/shattri.p ( input "get":U
     1899                         , input  '':u
     1900                         , input  0
     1901                         , input  'bge-export':U
     1902                         , input  'bgeclall':U
     1903                         , output v-value-character
     1904                         , output v-value-date
     1905                         , output v-value-decimal
     1906                         , output v-value-integer
     1907                         , output v-value-logical
     1908                         , output v-param-type
     1909                         , input-output table-handle v-tth
     1910                         ) no-error .
     1911       if error-status :error
     1912       then do:
     1913         assign
     1914           v-bgelib-bgeclall = no
     1915         .
     1916       end.
     1917       else do:
     1918         assign
     1919           v-bgelib-bgeclall = v-value-logical
     1920         .
     1921       end.
     1922       delete object v-tth.
     1923       run adm/shattri.p ( input "get":U
     1924                         , input  '':u
     1925                         , input  0
     1926                         , input  'bge-export':U
     1927                         , input  'bgedict':U
     1928                         , output v-value-character
     1929                         , output v-value-date
     1930                         , output v-value-decimal
     1931                         , output v-value-integer
     1932                         , output v-value-logical
     1933                         , output v-param-type
     1934                         , input-output table-handle v-tth
     1935                         ) no-error .
     1936       if error-status :error
     1937       then do:
     1938         assign
     1939           v-bgelib-bgedict = no
     1940         .
     1941       end.
     1942       else do:
     1943         assign
     1944           v-bgelib-bgedict = v-value-logical
     1945         .
     1946       end.
     1947       delete object v-tth.
     1948       run adm/shattri.p ( input "get":U
     1949                         , input  '':u
     1950                         , input  0
     1951                         , input  'bge-export':U
     1952                         , input  'bgefmt':U
     1953                         , output v-value-character
     1954                         , output v-value-date
     1955                         , output v-value-decimal
     1956                         , output v-value-integer
     1957                         , output v-value-logical
     1958                         , output v-param-type
     1959                         , input-output table-handle v-tth
     1960                         ) no-error .
     1961       if error-status :error
     1962       then do:
     1963         assign
     1964           v-bgelib-bgefmt  = "xml":U
     1965         .
     1966       end.
     1967       else do:
     1968         assign
     1969           v-bgelib-bgefmt  = v-value-character
     1970         .
     1971       end.
     1972       delete object v-tth.
     1973       run adm/shattri.p ( input "get":U
     1974                         , input  '':u
     1975                         , input  0
     1976                         , input  'bge-export':U
     1977                         , input  'bgeflold':U
     1978                         , output v-value-character
     1979                         , output v-value-date
     1980                         , output v-value-decimal
     1981                         , output v-value-integer
     1982                         , output v-value-logical
     1983                         , output v-param-type
     1984                         , input-output table-handle v-tth
     1985                         ) no-error .
     1986       if error-status :error
     1987       then do:
     1988         assign
     1989           v-bgelib-bgeflold  = "old":U
     1990         .
     1991       end.
     1992       else do:
     1993         assign
     1994           v-bgelib-bgeflold  = v-value-character
     1995         .
     1996       end.
     1997       delete object v-tth.
     1998   end.
     1999   end procedure.
     2000   procedure bgelib-check-file-size :
     2001   do
     2002   on error undo, return error
     2003   :
     2004   define input parameter p-out-filename   as character    no-undo.
     2005   define output parameter p-is-big        as logical      no-undo.
     2006       define variable v-current-position    as integer        no-undo.
     2007       assign
     2008           v-current-position = seek( stmXMLOut )
     2009       .
     2010       if v-current-position / 1024 / 1024  >= 100
     2011       then do:
     2012           assign
     2013               p-is-big = yes
     2014           .
     2015       end.
     2016   end.
     2017   end procedure.
     2018   procedure bgelib-init-ext-doc-type :
     2019       define variable v-counter    as integer      no-undo.
     2020       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2021   do
     2022   for buf_temp_ext-doc-type
     2023   on error undo, return error
     2024   :
     2025       empty temp-table buf_temp_ext-doc-type.
     2026       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2027       :
     2028           create buf_temp_ext-doc-type.
     2029           assign
     2030               buf_temp_ext-doc-type.edt-key               = v-counter
     2031               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2032               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2033           .
     2034       end.
     2035   end.
     2036   end procedure.
     2037   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2038   define variable v-xml-file-name     as character            no-undo.
     2039   define variable v-xml-file-name-path as character            no-undo.
     2040   define variable v-log-file-name     as character            no-undo.
     2041   define variable v-locked            as logical              no-undo.
     2042   define variable v-log-string        as character            no-undo.
     2043   define variable v-oper-num          as integer              no-undo.
     2044   define variable v-obj-list          as character            no-undo.
     2045   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2046   DEF VAR intRep      AS INT NO-UNDO.
     2047   define variable hEDT             AS HANDLE NO-UNDO.
     2048   define variable hCNT             AS HANDLE NO-UNDO.
     2049   procedure xml-cd-write-header:
     2050   do
     2051   on error undo, return error
     2052   :
     2053   define input parameter p-xml-file-name       as character    no-undo.
     2054   define input parameter p-xml-file-name-path  as character    no-undo.
     2055   define input parameter p-doc-name            as character    no-undo.
     2056   define input parameter p-version             as character    no-undo.
     2057   define input parameter p-obj-list            as character    no-undo.
     2058   define input parameter p-correspondent       as character    no-undo .
     2059   define input parameter p-write-header        as logical      no-undo .
     2060   define variable OS-time as character no-undo .
     2061   define variable id as character no-undo .
     2062   define buffer buf_db for ub.db.
     2063   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2064   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2065   assign
     2066   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2067   .
     2068   run bgelib-tag-open in this-procedure (
     2069                                        1
     2070                                       ,p-doc-name
     2071                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2072                                         ).
     2073   if p-write-header then do:
     2074     run bgelib-tag-open(2, "Header","").
     2075     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2076     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2077     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2078     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2079     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2080     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2081     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2082     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2083     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2084     run bgelib-tag-close( 2, "Header" ).
     2085   end.
     2086   output stream stmXMLOut close.
     2087   end.
     2088   end procedure.
     2089   procedure xml-cd-write-footer:
     2090   do
     2091   on error undo, return error
     2092   :
     2093   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2094   define input parameter p-xml-file-name as character    no-undo.
     2095   define input parameter p-doc-name      as character    no-undo .
     2096   define variable v-error-num     as integer           no-undo.
     2097   define variable v-md5-signature as character no-undo .
     2098   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2099   run bgelib-tag-close( 0, p-doc-name ).
     2100   put stream stmXMLOut unformatted skip.
     2101   output stream stmXMLOut close.
     2102   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2103   if v-error-num > 0
     2104   then do:
     2105      return error.
     2106   end.
     2107   if opsys = "unix"
     2108   then do:
     2109       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2110   end.
     2111   end.
     2112   end procedure.
     2113   procedure xml-cd-filename :
     2114   do
     2115   on error undo, return error
     2116   :
     2117   define input parameter  p-out               as character no-undo .
     2118   define output parameter p-xml-file-name     as character    no-undo.
     2119   define output parameter p-xml-file-name-path   as character    no-undo.
     2120   define output parameter p-log-file-name     as character    no-undo.
     2121   define output parameter p-locked            as logical      no-undo.
     2122   define variable v-out as character     no-undo.
     2123   define variable loc#log as logical no-undo .
     2124   define variable BadFlag as logical no-undo .
     2125   define variable fq as integer no-undo .
     2126   define variable v-remote as character no-undo .
     2127   assign
     2128   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2129   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2130   p-log-file-name = p-out + "actions.log"
     2131   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2132   .
     2133   end.
     2134   end procedure.
     2135   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2136   define variable v-date-str as character no-undo .
     2137   assign
     2138   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2139                string(Month(p-date), "99":U) + "-":U +
     2140                string(DAY(p-date), "99":U).
     2141   return v-date-str.
     2142   END FUNCTION.
     2143   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2144   define variable v-date-str as character no-undo .
     2145   assign
     2146   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2147                string(Month(p-date), "99":U) + "-":U +
     2148                string(DAY(p-date), "99":U) + chr(32) +
     2149                string(p-time, "HH:MM:SS").
     2150   return v-date-str.
     2151   END FUNCTION.
     2152   function string-to-date returns date ( input p-string  as character):
     2153     define variable v-date as date no-undo .
     2154     assign
     2155     v-date = date(integer(substring(p-string, 4, 2))
     2156                   ,integer(substring(p-string, 1, 2))
     2157                   ,integer(substring(p-string, 7, 4))
     2158                  ) no-error .
     2159     if error-status:error then return ?.
     2160     return v-date.
     2161   END FUNCTION.
     2162   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2163   define variable v-time as integer no-undo init ?.
     2164   define variable v-dop1 as character no-undo .
     2165   define variable v-dop2 as character no-undo .
     2166   assign
     2167   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2168   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2169   no-error .
     2170   if error-status:error then return ?.
     2171   assign
     2172   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2173             integer(entry(2, v-dop2, ";":U)) * 60 +
     2174             integer(entry(3, v-dop2, ";":U)) no-error .
     2175   return v-time.
     2176   END FUNCTION.
