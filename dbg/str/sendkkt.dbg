      156   procedure alienini-getkey :
      157   define input parameter i-filename as char.
      158   define input parameter i-section as char.
      159   define input parameter i-key as char.
      160   define output parameter o-value as char.
      161   define variable EntryPointer as integer no-undo.
      162   define variable mem1 as memptr no-undo.
      163   define variable mem2 as memptr no-undo.
      164   define variable mem1size as integer no-undo.
      165   define variable mem2size as integer no-undo.
      166   define variable ii       as integer    no-undo.
      167   define variable cbReturnSize  as integer    no-undo.
      168   assign
      169   set-size(mem1)  = 4000
      170   mem1size = 4000.
      171   if i-key = "" then EntryPointer = 0.
      172   else do:
      173     assign
      174     set-size(mem2) = 128
      175     mem2size = 128
      176     EntryPointer = get-pointer-value(mem2)
      177     put-string(mem2, 1) = i-key.
      178   end.
      179   run getprivateprofilestringA
      180                                 (i-section,
      181                                  EntryPointer,
      182                                  "",
      183                                  get-pointer-value(mem1),
      184                                  input mem1size,
      185                                  i-filename,
      186                                  output cbReturnSize).
      187   do ii = 1 to cbReturnSize:
      188     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      189                  then o-value + ","
      190                  else o-value + chr(get-byte(mem1, ii)).
      191   end.
      192     set-size(mem1) = 0.
      193     set-size(mem2) = 0.
      194   end procedure.
      195   procedure alienini-putkey :
      196   define input parameter i-filename as char.
      197   define input parameter i-section as char.
      198   define input parameter i-key as char.
      199   define input parameter i-value as char.
      200   define variable cbReturnSize as integer.
      201   run writeprivateprofilestringA
      202                                  (i-section,
      203                                   i-key,
      204                                   i-value,
      205                                   i-filename,
      206                                   output cbReturnSize ).
      207   end procedure.
      208   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      209     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      210     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      211     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      212     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      213     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      214     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      215     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      216   END PROCEDURE.
      217   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      218     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      219     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      220     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      221     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      222     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      223   END PROCEDURE.
