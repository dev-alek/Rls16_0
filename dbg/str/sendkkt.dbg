      283   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      284   define variable v-is-closed-shift-journal as integer no-undo .
      285   assign
      286   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      287                               +
      288                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      289                               +
      290                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      291   .
      292   return v-is-closed-shift-journal.
      293   END FUNCTION.
      294   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      295   define variable v-is-first-journal as logical no-undo .
      296   assign
      297   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      298                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      299                     or (p-journal-num =  integer(entry(1, '17':U)))
      300                     or (p-journal-num = integer(entry(1, '16':U)))
      301   .
      302   return v-is-first-journal.
      303   END FUNCTION.
      304   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      305   define variable v-is-petrol-journal as logical no-undo .
      306   assign
      307   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      308   return v-is-petrol-journal.
      309   END FUNCTION.
      310   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      311   define variable v-max-record-num as integer no-undo .
      312   assign
      313   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      314                       then 1489
      315                       else 2340).
      316   return v-max-record-num.
      317   END FUNCTION.
      318   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      319   define variable v-max-record-num as integer no-undo .
      320   assign
      321   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      322                       then 1489 * num-entries('30,31,32,33':U)
      323                       else 2340 * num-entries('17':U)).
      324   return v-max-record-num.
      325   END FUNCTION.
      326   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      327                                           ,input p-rec-no as integer):
      328   define variable v-num-recs as integer no-undo .
      329   if tekka-is-petrol-journal (p-journal-num) then do:
      330     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      331       assign
      332       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      333       .
      334     end.
      335     else do:
      336       assign
      337       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      338       .
      339     end.
      340   end.
      341   else do:
      342     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      343       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      344         assign
      345         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      346         .
      347       end.
      348       else do:
      349         assign
      350         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      351         .
      352       end.
      353     end.
      354     else do:
      355       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      356         assign
      357         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      358         .
      359       end.
      360       else do:
      361         assign
      362         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      363         .
      364       end.
      365     end.
      366   end.
      367   return v-num-recs.
      368   END FUNCTION.
      369   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      370                                              ,input p-is-petrol as logical
      371                                              ,input p-is-current as logical
      372                                              ,output p-rec-no as decimal
      373                                              ):
      374   define variable v-obj-num0 as integer no-undo .
      375   define variable v-obj-num as integer no-undo .
      376   define variable v-obj-num2 as integer no-undo .
      377   define variable p-num-recs2 as integer no-undo .
      378   define variable p-rec-no2 as integer no-undo .
      379   if p-is-petrol then do:
      380     assign
      381     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      382     .
      383     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      384     then
      385     assign
      386     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      387     p-rec-no = p-num-recs modulo 1489
      388     .
      389     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      390     then
      391     assign
      392     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      393     p-rec-no = p-num-recs modulo 1489
      394     .
      395   end.
      396   else do:
      397     assign
      398     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      399     p-num-recs = trunc(p-num-recs, 0)
      400     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      401     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      402     .
      403     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      404     then
      405     assign
      406     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      407     p-rec-no = p-num-recs modulo 2340
      408     .
      409     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      410     then
      411     assign
      412     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      413     p-rec-no = p-num-recs modulo 2340
      414     .
      415     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      416     then
      417     assign
      418     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      419     p-rec-no2 = p-num-recs2 modulo 2978
      420     .
      421     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      422     then
      423     assign
      424     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      425     p-rec-no2 = p-num-recs2 modulo 2978
      426     .
      427     assign
      428     p-rec-no = p-rec-no + p-rec-no2 / 10000
      429     .
      430   end.
      431   if v-obj-num = 0 then v-obj-num = 100.
      432   return v-obj-num.
      433   END FUNCTION.
      434   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      435   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      436   if lookup (string(p-obj-num), '17':U) > 0 then do:
      437      if p-is-ptrl then
      438      return integer(entry(1, '26,27,28,29':U)).
      439      if not p-is-ptrl then
      440      return integer(entry(1, '16':U)).
      441   end.
      442   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      443   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      444   return 0.
      445   END FUNCTION.
      446   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      447   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      448   if lookup (string(p-obj-num), '17':U) > 0 then do:
      449     if p-is-ptrl then
      450     return integer(entry(1, '26,27,28,29':U)).
      451     if not p-is-ptrl then
      452     return integer(entry(1, '16':U)).
      453   end.
      454   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      455   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      456   return 0.
      457   END FUNCTION.
      458   PROCEDURE maria-put:
      459   define parameter buffer buf_cash-desk for ub.cash-desk.
      460   define input parameter p-out    as character no-undo .
      461   define input parameter p-fname as character no-undo .
      462   define input parameter p-by-record as logical no-undo .
      463   define input parameter p-shift-fields as integer no-undo .
      464   define input parameter p-binary as logical no-undo .
      465   define input parameter p-obj-num as integer no-undo .
      466   define input parameter p-max-records as integer no-undo .
      467   define input parameter p-plu as integer no-undo .
      468   define input parameter p-value as character no-undo .
      469   define variable v-file-name as character no-undo .
      470   define variable v-create as logical no-undo .
      471   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      472   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      473   output stream IBMSTREAM
      474   to value(v-file-name) append .
      475   Put  stream IBMSTREAM unformatted
      476   p-plu
      477   chr(3)
      478   p-value
      479   skip.
      480   output stream IBMSTREAM
      481   close.
      482   if not p-by-record then do:
      483     find first buf_temp-tekka-tsk where
      484               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      485     if not available buf_temp-tekka-tsk then do:
      486       v-create = yes.
      487     end.
      488   end.
      489   else do:
      490     find first buf_temp-tekka-tsk where
      491               buf_temp-tekka-tsk.filename  = v-file-name
      492           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      493     if not available buf_temp-tekka-tsk
      494     then do:
      495       find first buf_temp-tekka-tsk where
      496                 buf_temp-tekka-tsk.filename  = v-file-name
      497             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      498       if not available buf_temp-tekka-tsk
      499       then do:
      500         v-create = yes.
      501       end.
      502     end.
      503   end.
      504   if v-create then do:
      505     create buf_temp-tekka-tsk.
      506     assign
      507     buf_temp-tekka-tsk.filename = v-file-name
      508     buf_temp-tekka-tsk.range    = p-plu
      509     buf_temp-tekka-tsk.obj-num = p-obj-num
      510     buf_temp-tekka-tsk.obj-name = '':U
      511     buf_temp-tekka-tsk.num-records = 0
      512     buf_temp-tekka-tsk.max-records = p-max-records
      513     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      514     buf_temp-tekka-tsk.task-num = p-fname
      515     buf_temp-tekka-tsk.by-record = p-by-record
      516     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      517     buf_temp-tekka-tsk.binary = p-binary
      518     buf_temp-tekka-tsk.send-get = 'send'
      519     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      520     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      521     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      522     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      523                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      524                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      525                                 then 'local'
      526                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      527     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      528     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      529     buf_temp-tekka-tsk.waiting-sek = 30
      530     buf_temp-tekka-tsk.min-plu     = p-plu
      531     buf_temp-tekka-tsk.max-plu     = p-plu
      532     .
      533   end.
      534   assign
      535   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      536   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      537   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      538   .
      539   END PROCEDURE.
      540   PROCEDURE maria-get:
      541   define parameter buffer buf_cash-desk for ub.cash-desk.
      542   define input parameter p-out    as character no-undo .
      543   define input parameter p-fname as character no-undo .
      544   define input parameter p-by-record as logical no-undo .
      545   define input parameter p-obj-num as integer no-undo .
      546   define input parameter p-num-fields as integer no-undo .
      547   define input parameter p-max-records as integer no-undo .
      548   define input parameter p-min-plu as integer no-undo .
      549   define input parameter p-max-plu as integer no-undo .
      550   define input parameter p-other as character no-undo .
      551   define input parameter p-order-num as integer no-undo .
      552   define variable v-file-name as character no-undo .
      553   define variable v-secondary-obj-num as character no-undo .
      554   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      555   if p-by-record then do:
      556     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      557   end.
      558   else do:
      559     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      560   end.
      561   find first buf_temp-tekka-tsk where
      562             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      563   if not available buf_temp-tekka-tsk then do:
      564     create buf_temp-tekka-tsk.
      565     assign
      566     buf_temp-tekka-tsk.filename = v-file-name
      567     buf_temp-tekka-tsk.obj-num = p-obj-num
      568     buf_temp-tekka-tsk.obj-name = '':U
      569     buf_temp-tekka-tsk.max-records = p-max-records
      570     buf_temp-tekka-tsk.num-fields = p-num-fields
      571     buf_temp-tekka-tsk.task-num = p-fname
      572     buf_temp-tekka-tsk.by-record = p-by-record
      573     buf_temp-tekka-tsk.send-get = 'get'
      574     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      575     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      576     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      577     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      578                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      579                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      580                                   then 'local'
      581                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      582     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      583     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      584     buf_temp-tekka-tsk.waiting-sek = 30
      585     buf_temp-tekka-tsk.min-plu     = p-min-plu
      586     buf_temp-tekka-tsk.max-plu     = p-max-plu
      587     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      588                                       and p-max-plu <> ?
      589                                       then p-max-plu - p-min-plu + 1
      590                                       else 0)
      591     buf_temp-tekka-tsk.other-info = p-other
      592     buf_temp-tekka-tsk.order-num = p-order-num
      593     .
      594     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      595       assign
      596       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      597       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      598       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      599       no-error
      600       .
      601       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      602     end.
      603   end.
      604   END PROCEDURE.
      605   PROCEDURE maria-task:
      606   define parameter buffer buf_cash-desk for ub.cash-desk.
      607   define input parameter p-fname as character no-undo .
      608   define input parameter p-obj-num-list as character no-undo .
      609   define input parameter p-parameters as character no-undo .
      610   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      611   find first buf_temp-tekka-tsk where
      612             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      613   if not available buf_temp-tekka-tsk then do:
      614     create buf_temp-tekka-tsk.
      615     assign
      616     buf_temp-tekka-tsk.filename = ''
      617     buf_temp-tekka-tsk.range = 1
      618     buf_temp-tekka-tsk.obj-num = 0
      619     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      620     buf_temp-tekka-tsk.task-num = p-fname
      621     buf_temp-tekka-tsk.by-record = no
      622     buf_temp-tekka-tsk.send-get = 'task'
      623     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      624     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      625     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      626     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      627                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      628                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      629                                   then 'local'
      630                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      631     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      632     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      633     buf_temp-tekka-tsk.waiting-sek = 30
      634     buf_temp-tekka-tsk.other-info = p-parameters
      635     buf_temp-tekka-tsk.order-num = 0
      636     .
      637   end.
      638   END PROCEDURE.
      639   procedure tekkatsk-verify-schema :
      640   define input parameter p-obj-list as character no-undo .
      641   define input parameter p-dir-path as character no-undo .
      642   define variable v-obj-num as integer no-undo .
      643   define variable v-obj-name as character no-undo .
      644   define variable v-num-records as integer no-undo .
      645   define variable v-size_ as integer no-undo .
      646   define variable v-value as character no-undo .
      647   define variable ii as integer no-undo .
      648   define variable jj as integer no-undo .
      649   define variable ii-ibs as integer no-undo .
      650   define variable ii-tekka as integer no-undo .
      651   define variable v-result as character no-undo .
      652   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      653   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      654     do
      655     on error undo, return error
      656     :
      657        for each buf_temp-tekka-schema:
      658          delete buf_temp-tekka-schema.
      659        end.
      660        input from value('tekkasch.d').
      661        repeat :
      662          create buf_temp-tekka-schema.
      663          import buf_temp-tekka-schema.
      664          assign
      665          buf_temp-tekka-schema.host = 'IBS'
      666          ii = ii + 1.
      667          .
      668        end.
      669        input close.
      670        ii-ibs = ii.
      671         _ii:
      672         do ii = 1 to 256:
      673           if p-obj-list = "ALL"
      674           or lookup(string(ii), p-obj-list) > 0 then do:
      675             assign
      676             v-obj-num = 0
      677             v-obj-name = ''
      678             v-num-records = 0
      679             v-size_ = 0
      680             .
      681             run alienini-getkey in this-procedure (
      682                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      683                                                     ,input ('obj' + string(ii, '999'))
      684                                                     ,input 'oname'
      685                                                     ,output v-value) no-error .
      686             if v-value = ? then next _ii.
      687             assign
      688             v-obj-num = ii
      689             v-obj-name = v-value
      690             .
      691             run alienini-getkey in this-procedure (
      692                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      693                                                     ,input ('obj' + string(ii, '999'))
      694                                                     ,input 'size'
      695                                                     ,output v-value) no-error .
      696             assign
      697             v-num-records = integer(v-value) no-error  .
      698             if error-status:error
      699             or v-num-records = 0 then next _ii.
      700             run alienini-getkey in this-procedure (
      701                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      702                                                     ,input 'obj' + string(ii, '999')
      703                                                     ,input 'f000'
      704                                                     ,output v-value) no-error .
      705             assign
      706             v-size_ = integer(v-value) no-error  .
      707             if error-status:error
      708             or v-size_ = 0 then next _ii.
      709             _jj:
      710             do jj = 1 to 256:
      711               run alienini-getkey in this-procedure (
      712                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      713                                                       ,input 'obj' + string(ii, '999')
      714                                                       ,input 'f' + string(jj, '999')
      715                                                       ,output v-value) no-error .
      716               if v-value = ? then next _ii.
      717               create buf_temp-tekka-schema.
      718               assign
      719               buf_temp-tekka-schema.host = 'tekka'
      720               buf_temp-tekka-schema.obj-num = v-obj-num
      721               buf_temp-tekka-schema.obj-name = v-obj-name
      722               buf_temp-tekka-schema.num-records = v-num-records
      723               buf_temp-tekka-schema.size_ = v-size_
      724               buf_temp-tekka-schema.field-num = jj
      725               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      726               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      727                                                  then entry(2, entry(2, v-value, '#'), ':')
      728                                                  else '':U)
      729               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      730               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      731               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      732                                                           , 'C,I,I,I,D,D,D,D,D':U)
      733               no-error
      734               .
      735               if error-status:error then do:
      736                 delete buf_temp-tekka-schema.
      737                 next _jj.
      738               end.
      739               run alienini-getkey in this-procedure (
      740                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      741                                                       ,input 'obj' + string(ii, '999') + 'name'
      742                                                       ,input 'n' + string(jj, '999')
      743                                                       ,output v-value) no-error .
      744               if v-value <> ? then
      745               buf_temp-tekka-schema.field-name = v-value.
      746             end.
      747           end.
      748         end.
      749         ii-tekka = ii - 1.
      750        if p-obj-list <> 'ALL' then do:
      751         if ii-tekka <> ii-ibs then do:
      752           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      753                                   , ii-ibs
      754                                   , ii-tekka).
      755         end.
      756        end.
      757        for each buf_temp-tekka-schema where
      758               buf_temp-tekka-schema.host = 'tekka':
      759          find first buf2_temp-tekka-schema where
      760                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      761                AND buf2_temp-tekka-schema.host = 'ibs'
      762                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      763          if not available buf2_temp-tekka-schema then do:
      764           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      765                                   , buf_temp-tekka-schema.field-num
      766                                   , buf_temp-tekka-schema.obj-num).
      767          end.
      768          buffer-compare buf_temp-tekka-schema
      769          to buf2_temp-tekka-schema
      770          save result in v-result.
      771          if v-result <> '':U then do:
      772           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      773                                   , buf_temp-tekka-schema.field-num
      774                                   , buf_temp-tekka-schema.obj-num).
      775          end.
      776        end.
      777     end.
      778   end procedure.
      779   FUNCTION set-Sx returns character (input p-string as character):
      780   return p-string.
      781   END FUNCTION.
      782   FUNCTION get-Sx returns character (input p-string  as character):
      783   return p-string.
      784   END FUNCTION.
      785   FUNCTION set-B returns character (input p-string  as character):
      786   return chr(integer(p-string)).
      787   END FUNCTION.
      788   FUNCTION get-B returns character (input p-string  as character):
      789   return string(asc(p-string)).
      790   END FUNCTION.
      791   FUNCTION set-BF returns character (input p-string  as character):
      792   define variable v-dopi as integer no-undo .
      793   define variable ii as integer no-undo .
      794   do ii = 1 to 8:
      795     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      796   end.
      797   return chr(v-dopi).
      798   END FUNCTION.
      799   FUNCTION get-BF returns character (input p-string  as character):
      800   define variable v-dopi as integer no-undo .
      801   define variable v-dops as character no-undo .
      802   define variable ii as integer no-undo .
      803   v-dopi = asc(p-string).
      804   do ii = 8 to 1 BY -1:
      805     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      806   end.
      807   return v-dops.
      808   END FUNCTION.
      809   FUNCTION set-BN returns character (input p-string  as character
      810                                     ,input p-bin-group as character):
      811   define variable v-dopi as integer no-undo .
      812   define variable ii as integer no-undo .
      813   define variable jj as integer no-undo .
      814   define variable v-grp-nums as integer no-undo .
      815   define variable v-dopi2 as integer no-undo .
      816   v-grp-nums = num-entries(p-bin-group).
      817   do jj = 0 to v-grp-nums - 1:
      818     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      819     do ii = 1 to 8:
      820       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      821     end.
      822   end.
      823   return chr(v-dopi).
      824   END FUNCTION.
      825   FUNCTION get-BN returns character (input p-string  as character
      826                                     ,input p-bin-group as character):
      827   define variable v-dopi as integer no-undo .
      828   define variable v-dops as character no-undo .
      829   define variable v-grp-nums as integer no-undo .
      830   define variable ii as integer no-undo .
      831   define variable jj as integer no-undo .
      832   v-dopi = asc(p-string).
      833   v-grp-nums = num-entries(p-bin-group).
      834   do jj = 1 to v-grp-nums:
      835   do ii = 8 to 1 BY -1:
      836     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      837   end.
      838   end.
      839   return v-dops.
      840   END FUNCTION.
      841   procedure fill-temp-cd :
      842   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
      843   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      844   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      845   define input parameter p-clear-table as logical no-undo .
      846   define buffer buf_temp-cd for temp-cd.
      847   define buffer buf_cash-desk for ub.cash-desk.
      848     do
      849     on error undo, return error
      850     :
      851        if p-clear-table  then do:
      852          for each buf_temp-cd:
      853            delete buf_temp-cd.
      854          end.
      855        end.
      856        for each buf_cash-desk no-lock where
      857               buf_cash-desk.db-num = p-db-num
      858           AND buf_cash-desk.obj-code = p-obj-code
      859           and buf_cash-desk.cash-on  = yes
      860        BREAK by buf_cash-desk.pos-type:
      861          if first-of(buf_cash-desk.pos-type) then do:
      862            create buf_temp-cd.
      863            buffer-copy buf_cash-desk to buf_temp-cd.
      864          end.
      865        end.
      866     end.
      867   end procedure.
      868   define variable vss-include-info6 as character format "X(65)" no-undo
      869   initial "@(#)$Workfile$ $Revision$".
      870   define variable v-bgelib-bgefmt        as character         no-undo.
      871   define variable v-bgelib-bgeflold      as character         no-undo.
      872   define stream stmXMLOut.
      873   define stream stmXMLLog.
      874   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   procedure cur-time :
      876      define output parameter p-today as date      no-undo .
      877      define output parameter p-time  as integer   no-undo .
      878     do
      879     on error undo, return error
      880     :
      881       define variable v-date1 as date      no-undo .
      882       define variable v-date2 as date      no-undo .
      883       define variable v-time  as integer   no-undo .
      884       assign
      885         v-date1 = today
      886         v-time  = time
      887         v-date2 = today
      888       .
      889       if v-date1 <> v-date2
      890       then do:
      891         assign
      892           v-date1 = today
      893           v-time  = v-time
      894         .
      895       end.
      896       assign
      897         p-today = v-date1
      898         p-time  = v-time
      899       .
      900     end.
      901   end.
      902   function cur-time-date returns character
      903   :
      904     return string(today, '99/99/9999':U) .
      905   end.
      906   function cur-time-mjd returns decimal
      907   :
      908     define variable v-date as date      no-undo .
      909     define variable v-time as integer   no-undo .
      910     run cur-time in this-procedure
      911       (output v-date
      912       ,output v-time
      913       ) .
      914     return integer(v-date) - 2400002 + (v-time / 86400) .
      915   end.
      916   function cur-time-get-ending-index returns integer
      917   (input p-number as integer
      918   )
      919   :
      920     if p-number < 0
      921     or p-number = ?
      922     then do:
      923       return 1 .
      924     end.
      925     define variable v-rest as integer   no-undo .
      926     assign
      927       p-number = p-number modulo 100
      928     .
      929     if p-number < 20
      930     then do:
      931       assign
      932         v-rest = p-number
      933       .
      934     end.
      935     else do:
      936       assign
      937         v-rest = p-number modulo 10
      938       .
      939     end.
      940     case v-rest :
      941       when 1
      942       then do:
      943         return 2 .
      944       end.
      945       when 2 or
      946       when 3 or
      947       when 4
      948       then do:
      949         return 3 .
      950       end.
      951       otherwise do:
      952         return 1 .
      953       end.
      954     end case .
      955   end.
      956   procedure cur-time-mjd-to-date :
      957      define input  parameter i-mjd-diff as decimal no-undo.
      958      define output parameter o-Date     as date    no-undo.
      959      define output parameter o-Time     as integer no-undo.
      960      define variable v-day-number as integer   no-undo .
      961      if    i-mjd-diff < 0
      962         or i-mjd-diff = ?
      963      then do:
      964         return "?" .
      965      end.
      966      assign
      967         v-day-number = truncate(i-mjd-diff,0).
      968         o-Date = date(v-day-number + 2400002).
      969         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      970     .
      971   end.
      972   function cur-time-mjd-to-string returns character
      973   (input p-mjd-diff as decimal
      974   )
      975   :
      976     define variable v-day-number as integer   no-undo .
      977     define variable v-seconds    as integer   no-undo .
      978     define variable v-hour       as integer   no-undo .
      979     define variable v-min        as integer   no-undo .
      980     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      981     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      982     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      983     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      984     if p-mjd-diff < 0
      985     or p-mjd-diff = ?
      986     then do:
      987       return "?" .
      988     end.
      989     assign
      990       v-day-number = integer(truncate(p-mjd-diff,0))
      991       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      992     .
      993     if v-seconds > 86400
      994     then do:
      995       assign
      996         v-seconds = 86400 - 1
      997       .
      998     end.
      999     if v-seconds < 0
     1000     then do:
     1001       assign
     1002         v-seconds = 0
     1003       .
     1004     end.
     1005     assign
     1006       v-hour = truncate(v-seconds / 3600, 0)
     1007     .
     1008     assign
     1009       v-seconds = v-seconds modulo 3600
     1010     .
     1011     assign
     1012       v-min = truncate(v-seconds / 60, 0)
     1013     .
     1014     assign
     1015       v-seconds = v-seconds modulo 60
     1016     .
     1017     return
     1018         (if v-day-number <> 0
     1019           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1020           else ""
     1021         )
     1022       + (if v-day-number <> 0 or v-hour <> 0
     1023           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1024           else ""
     1025         )
     1026       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1027           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1028           else ""
     1029         )
     1030       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1031       .
     1032   end.
     1033   function cur-time-string returns character
     1034   :
     1035     define variable v-date as date      no-undo .
     1036     define variable v-time as integer   no-undo .
     1037     run cur-time in this-procedure
     1038       (output v-date
     1039       ,output v-time
     1040       ) .
     1041     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1042   end.
     1043   function cur-time-string-sec returns character
     1044   :
     1045     define variable v-date as date      no-undo .
     1046     define variable v-time as integer   no-undo .
     1047     run cur-time in this-procedure
     1048       (output v-date
     1049       ,output v-time
     1050       ) .
     1051     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1052   end.
     1053   function cur-time-custom  returns character
     1054   (input p-prefix as character
     1055   ,input p-date-format as character
     1056   ,input p-delimiter as character
     1057   ,input p-time-format as character
     1058   ,input p-suffix as character
     1059   )
     1060   :
     1061     define variable v-date as date      no-undo .
     1062     define variable v-time as integer   no-undo .
     1063     run cur-time in this-procedure
     1064       (output v-date
     1065       ,output v-time
     1066       ) .
     1067     return
     1068       p-prefix
     1069       + string(v-date, p-date-format)
     1070       + p-delimiter
     1071       + string(v-time, p-time-format)
     1072       + p-suffix
     1073       .
     1074   end.
     1075   function cur-time-print  returns character
     1076   :
     1077     define variable v-date as date      no-undo .
     1078     define variable v-time as integer   no-undo .
     1079     run cur-time in this-procedure
     1080       (output v-date
     1081       ,output v-time
     1082       ) .
     1083     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1084   end.
     1085   function cur-time-datetime returns datetime
     1086   :
     1087     define variable v-char as character no-undo .
     1088     define variable v-datetime as datetime no-undo .
     1089     v-char = cur-time-string().
     1090     v-datetime = datetime(v-char).
     1091     return  v-datetime.
     1092   end.
     1093   function cur-time-string-msec returns character
     1094   :
     1095     define variable v-date as datetime  no-undo .
     1096     v-date = now.
     1097     return string(v-date) .
     1098   end.
     1099   define variable vss-include-info8 as character format "X(65)" no-undo
     1100   initial "@(#)$Workfile$ $Revision$".
     1101   procedure xmlchar-test :
     1102   define input parameter p-in-string          as character        no-undo.
     1103   define output parameter p-out-string-enc    as character        no-undo.
     1104   define output parameter p-out-string-dec    as character        no-undo.
     1105   do
     1106   on error undo, return error
     1107   :
     1108          run xmlchar-encode in this-procedure
     1109       (
     1110             input p-in-string
     1111           , output p-out-string-enc
     1112       ).
     1113          run xmlchar-decode in this-procedure
     1114       (
     1115             input p-out-string-enc
     1116           , output p-out-string-dec
     1117       ).
     1118   end.
     1119   end .
     1120   procedure xmlchar-encode :
     1121   define input parameter p-in-string      as character        no-undo.
     1122   define output parameter p-out-string    as character        no-undo.
     1123       define variable v-position      as integer      no-undo.
     1124       define variable v-current-char  as character    no-undo.
     1125   do
     1126   on error undo, return error
     1127   :
     1128       assign
     1129           p-out-string = "":U
     1130       .
     1131       case p-in-string
     1132       :
     1133           when ?
     1134           then do:
     1135               assign
     1136                   p-out-string = "?":U
     1137               .
     1138           end.
     1139           when "?":U
     1140           then do:
     1141               assign
     1142                   p-out-string = "&#63;":U
     1143               .
     1144           end.
     1145           otherwise do:
     1146               do v-position = 1 to length( p-in-string )
     1147               :
     1148                   assign
     1149                       v-current-char = substring( p-in-string, v-position, 1 )
     1150                   .
     1151                   case v-current-char
     1152                   :
     1153                       when "&":U
     1154                       then do:
     1155                           assign
     1156                               p-out-string = p-out-string + "&amp;":U
     1157                           .
     1158                       end.
     1159                       when ">":U
     1160                       then do:
     1161                           assign
     1162                               p-out-string = p-out-string + "&gt;":U
     1163                           .
     1164                       end.
     1165                       when "<":U
     1166                       then do:
     1167                           assign
     1168                               p-out-string = p-out-string + "&lt;":U
     1169                           .
     1170                       end.
     1171                       when "'":U
     1172                       then do:
     1173                           assign
     1174                               p-out-string = p-out-string + "&apos;":U
     1175                           .
     1176                       end.
     1177                       when '"':U
     1178                       then do:
     1179                           assign
     1180                               p-out-string = p-out-string + "&quot;":U
     1181                           .
     1182                       end.
     1183                       when chr(1)
     1184                       then do:
     1185                           assign
     1186                               p-out-string = p-out-string + "":U
     1187                           .
     1188                       end.
     1189                       when chr(2)
     1190                       then do:
     1191                           assign
     1192                               p-out-string = p-out-string + "":U
     1193                           .
     1194                       end.
     1195                       when chr(3)
     1196                       then do:
     1197                           assign
     1198                               p-out-string = p-out-string + "":U
     1199                           .
     1200                       end.
     1201                       when chr(4)
     1202                       then do:
     1203                           assign
     1204                               p-out-string = p-out-string + "":U
     1205                           .
     1206                       end.
     1207                       when chr(5)
     1208                       then do:
     1209                           assign
     1210                               p-out-string = p-out-string + "":U
     1211                           .
     1212                       end.
     1213                       when chr(6)
     1214                       then do:
     1215                           assign
     1216                               p-out-string = p-out-string + "":U
     1217                           .
     1218                       end.
     1219                       when chr(7)
     1220                       then do:
     1221                           assign
     1222                               p-out-string = p-out-string + "":U
     1223                           .
     1224                       end.
     1225                       when chr(8)
     1226                       then do:
     1227                           assign
     1228                               p-out-string = p-out-string + "":U
     1229                           .
     1230                       end.
     1231                       when chr(9)
     1232                       then do:
     1233                           assign
     1234                               p-out-string = p-out-string + "":U
     1235                           .
     1236                       end.
     1237                       when chr(29)
     1238                       then do:
     1239                           assign
     1240                               p-out-string = p-out-string + "":U
     1241                           .
     1242                       end.
     1243                       when chr(10)
     1244                       then do:
     1245                           assign
     1246                               p-out-string = p-out-string + "&#10;":U
     1247                           .
     1248                       end.
     1249                       when chr(13)
     1250                       then do:
     1251                           assign
     1252                               p-out-string = p-out-string + "&#13;":U
     1253                           .
     1254                       end.
     1255                       otherwise do:
     1256                           assign
     1257                               p-out-string = p-out-string + v-current-char
     1258                           .
     1259                       end.
     1260                   end case.
     1261               end.
     1262           end.
     1263       end case.
     1264   end.
     1265   end .
     1266   procedure xmlchar-encode-1c :
     1267   define input parameter p-in-string      as character        no-undo.
     1268   define output parameter p-out-string    as character        no-undo.
     1269       define variable v-position      as integer      no-undo.
     1270       define variable v-current-char  as character    no-undo.
     1271   do
     1272   on error undo, return error
     1273   :
     1274       assign
     1275           p-out-string = "":U
     1276       .
     1277       case p-in-string
     1278       :
     1279           when ?
     1280           then do:
     1281               assign
     1282                   p-out-string = "?":U
     1283               .
     1284           end.
     1285           otherwise do:
     1286               do v-position = 1 to length( p-in-string )
     1287               :
     1288                   assign
     1289                       v-current-char = substring( p-in-string, v-position, 1 )
     1290                   .
     1291                   case v-current-char
     1292                   :
     1293                       when chr(1)
     1294                       then do:
     1295                           assign
     1296                               p-out-string = p-out-string + " ":U
     1297                           .
     1298                       end.
     1299                       when chr(2)
     1300                       then do:
     1301                           assign
     1302                               p-out-string = p-out-string + " ":U
     1303                           .
     1304                       end.
     1305                       when chr(3)
     1306                       then do:
     1307                           assign
     1308                               p-out-string = p-out-string + " ":U
     1309                           .
     1310                       end.
     1311                       when chr(4)
     1312                       then do:
     1313                           assign
     1314                               p-out-string = p-out-string + " ":U
     1315                           .
     1316                       end.
     1317                       when chr(5)
     1318                       then do:
     1319                           assign
     1320                               p-out-string = p-out-string + " ":U
     1321                           .
     1322                       end.
     1323                       when chr(6)
     1324                       then do:
     1325                           assign
     1326                               p-out-string = p-out-string + " ":U
     1327                           .
     1328                       end.
     1329                       when chr(7)
     1330                       then do:
     1331                           assign
     1332                               p-out-string = p-out-string + " ":U
     1333                           .
     1334                       end.
     1335                       when chr(8)
     1336                       then do:
     1337                           assign
     1338                               p-out-string = p-out-string + " ":U
     1339                           .
     1340                       end.
     1341                       when chr(9)
     1342                       then do:
     1343                           assign
     1344                               p-out-string = p-out-string + " ":U
     1345                           .
     1346                       end.
     1347                       when chr(29)
     1348                       then do:
     1349                           assign
     1350                               p-out-string = p-out-string + " ":U
     1351                           .
     1352                       end.
     1353                       when chr(10)
     1354                       then do:
     1355                           assign
     1356                               p-out-string = p-out-string + " ":U
     1357                           .
     1358                       end.
     1359                       when chr(13)
     1360                       then do:
     1361                           assign
     1362                               p-out-string = p-out-string + " ":U
     1363                           .
     1364                       end.
     1365                       otherwise do:
     1366                           assign
     1367                               p-out-string = p-out-string + v-current-char
     1368                           .
     1369                       end.
     1370                   end case.
     1371               end.
     1372           end.
     1373       end case.
     1374   end.
     1375   end .
     1376   procedure xmlchar-decode :
     1377   define input parameter p-in-string      as character        no-undo.
     1378   define output parameter p-out-string    as character        no-undo.
     1379       define variable v-position      as integer      no-undo.
     1380       define variable v-last-position as integer      no-undo.
     1381       define variable v-temp-integer  as integer      no-undo.
     1382       define variable v-current-char  as character    no-undo.
     1383       define variable v-next-char     as character    no-undo.
     1384       define variable v-success       as logical      no-undo.
     1385   do
     1386   on error undo, return error
     1387   :
     1388       assign
     1389           p-out-string = "":U
     1390           v-position   = 0
     1391       .
     1392       replace-cycle:
     1393       do while yes
     1394       on error undo, return error
     1395       :
     1396           assign
     1397               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1398           .
     1399           if v-last-position <= v-position
     1400           then do:
     1401               if v-position = 0
     1402               then do:
     1403                   assign
     1404                       p-out-string = p-in-string
     1405                   .
     1406               end.
     1407               else do:
     1408                   assign
     1409                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1410                   .
     1411               end.
     1412               leave replace-cycle.
     1413           end.
     1414           else do:
     1415               assign
     1416                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1417                   v-position      = v-last-position
     1418                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1419               .
     1420               if v-current-char = "#":U
     1421               then do:
     1422                   assign
     1423                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1424                   .
     1425                   if v-last-position > 0
     1426                   then do:
     1427                       run xmlchar-read-integer in this-procedure
     1428                        (
     1429                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1430                           , output v-temp-integer
     1431                           , output v-success
     1432                       ).
     1433                       if v-success = yes
     1434                       and v-temp-integer >= 1
     1435                       and v-temp-integer <= 255
     1436                       then do:
     1437                           assign
     1438                               p-out-string = p-out-string + chr( v-temp-integer )
     1439                               v-position   = v-last-position + 1
     1440                           .
     1441                       end.
     1442                       else do:
     1443                           assign
     1444                               p-out-string = p-out-string + "&":U
     1445                               v-position   = v-position   + 1
     1446                           .
     1447                       end.
     1448                   end.
     1449                   else do:
     1450                       assign
     1451                           p-out-string = p-out-string + "&":U
     1452                           v-position   = v-position   + 1
     1453                       .
     1454                   end.
     1455               end.
     1456               else do:
     1457                   case substring( p-in-string, v-position + 1, 3 )
     1458                   :
     1459                       when "lt;":U
     1460                       then do:
     1461                           assign
     1462                               p-out-string = p-out-string + "<":U
     1463                               v-position   = v-position   + 3
     1464                           .
     1465                       end.
     1466                       when "gt;":U
     1467                       then do:
     1468                           assign
     1469                               p-out-string = p-out-string + ">":U
     1470                               v-position   = v-position   + 3
     1471                           .
     1472                       end.
     1473                       otherwise do:
     1474                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1475                           then do:
     1476                               assign
     1477                                   p-out-string = p-out-string + "&":U
     1478                                   v-position   = v-position   + 4
     1479                               .
     1480                           end.
     1481                           else do:
     1482                               case substring( p-in-string, v-position + 1, 5 )
     1483                               :
     1484                                   when "quot;":U
     1485                                   then do:
     1486                                       assign
     1487                                           p-out-string = p-out-string + '"':U
     1488                                           v-position   = v-position   + 5
     1489                                       .
     1490                                   end.
     1491                                   when "apos;":U
     1492                                   then do:
     1493                                       assign
     1494                                           p-out-string = p-out-string + "'":U
     1495                                           v-position   = v-position   + 5
     1496                                       .
     1497                                   end.
     1498                                   otherwise do:
     1499                                       assign
     1500                                           p-out-string = p-out-string + "&":U
     1501                                       .
     1502                                   end.
     1503                               end case.
     1504                           end.
     1505                       end.
     1506                   end case.
     1507               end.
     1508           end.
     1509       end.
     1510   end.
     1511   end .
     1512   procedure xmlchar-read-integer :
     1513   define input parameter p-input-string      as character        no-undo.
     1514   define output parameter p-output-integer   as integer          no-undo.
     1515   define output parameter p-success       as logical          no-undo.
     1516   do
     1517   on error undo, return error
     1518   :
     1519       assign
     1520           p-output-integer = integer( p-input-string )
     1521       no-error.
     1522       if error-status :error
     1523       then do:
     1524           assign
     1525               p-success           = no
     1526               p-output-integer    = 0
     1527           .
     1528       end.
     1529       else do:
     1530           assign
     1531               p-success           = yes
     1532           .
     1533       end.
     1534   end.
     1535   end.
     1536   define variable v-bgelib-bgeclall           as logical      no-undo.
     1537   define variable v-bgelib-bgedict            as logical      no-undo.
     1538   define temp-table temp_ext-doc-type no-undo
     1539       field edt-key               as integer
     1540       field ext-doc-type          as character
     1541       field ext-doc-type-label    as character
     1542       index pi is primary unique
     1543           edt-key
     1544   .
