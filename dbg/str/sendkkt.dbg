     2745   FIND FIRST ub.cash-desk NO-LOCK WHERE
     2746              ub.cash-desk.db-num = g#db-num AND
     2747              ub.cash-desk.pos-type = 'IBM-XML':U AND
     2748              ub.cash-desk.obj-code = i-obj-code
     2749               No-error.
     2750   IF not avail(cash-desk) then do:
     2751     run write-log-and-file in p-log-handle (
     2752           input 1
     2753         , input log-file-name
     2754         , input 1
     2755         , input substitute( "!!!&1 схемы интеграции ККТ реализуется только для касс &3 "
     2756                             , (if action = "U" then "Передача" else "Удаление")
     2757                             , 'IBM-XML':U
     2758                           )
     2759                           ).
     2760     return.
     2761   end.
     2762   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2763   procedure putc-kkt :
     2764   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
     2765   define input parameter p-version like ub.cash-desk.version no-undo .
     2766   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
     2767   define input parameter p-cash-num like ub.cash-desk.cash-num  no-undo .
     2768   define input parameter p-value   as character no-undo .
     2769   define input parameter p-is-del as logical no-undo .
     2770   define variable ii as integer no-undo.
     2771     do
     2772     on error undo, return error
     2773     :
     2774           run bgelib-tag-open in this-procedure ( input 2, input "Param", input substitute("ctrl='&2' group='&1' key='&3'", "OFD":u, "ADD":u, "KKT_SCHEMA":u)).
     2775             run bgelib-tag-put in this-procedure ( input 3, input "ParamValue", input p-value, input 1 ).
     2776             run bgelib-tag-put in this-procedure ( input 3, input "ParamDesc", input "Схема интеграции ККТ. 0-с ожиданием ответа; 1-без ожидания ответа", input 1 ).
     2777           run bgelib-tag-close in this-procedure ( input 2, input "Param").
     2778     end.
     2779   end procedure.
     2780   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2781   PROCEDURE   for-cash-cycle:
     2782   DEFINE VARIABLE fname-list as character no-undo .
     2783   DEFINE VARIABLE out-list as character no-undo .
     2784   DEFINE VARIABLE var-file-num as integer no-undo .
     2785   DEFINE VARIABLE v-dir-remote as character no-undo .
     2786   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2787   define variable v-plu as character no-undo .
     2788   define variable ss  as character no-undo .
     2789   define variable ss0  as character no-undo .
     2790   define variable v-temp-kat-file as character no-undo .
     2791   define variable v-kat-file as character no-undo .
     2792   define variable v-kat-file-save as character no-undo .
     2793   define variable v-updated-subject-dis-kat as logical no-undo .
     2794   define variable v-next as logical no-undo .
     2795   define variable v-cd-subject-code as character no-undo .
     2796   define variable v-cd-disc-string as character no-undo .
     2797   define variable v-versiond as decimal no-undo .
     2798   define buffer for-cash-desk for ub.cash-desk.
     2799   _for:
     2800   FOR EACH for-cash-desk NO-LOCK WHERE
     2801           for-cash-desk.db-num = g#db-num AND
     2802           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2803           for-cash-desk.obj-code = i-obj-code AND
     2804           for-cash-desk.cash-on  = yes
     2805       BREAK
     2806       BY for-cash-desk.db-num
     2807       BY for-cash-desk.obj-code
     2808       BY for-cash-desk.pos-type
     2809       BY for-cash-desk.cash-on
     2810       :
     2811     if LOOKUP(ub.cash-desk.pos-type,
     2812               ('NCR-GM':U + chr(44) +
     2813                'IBM-XML':U + chr(44) +
     2814                'MAGIA-XML':U + chr(44) +
     2815                'NCR-AS@R':U + chr(44)
     2816                  )) > 0
     2817     and for-cash-desk.autonomy = integer('1':U) then NEXT.
     2818     assign
     2819     v-versiond = decimal(for-cash-desk.version)
     2820     no-error .
     2821     if error-status:error
     2822     or for-cash-desk.pos-type <> 'IBM-XML':U
     2823     then do:
     2824       run write-log-and-file in p-log-handle (
     2825             input 1
     2826           , input log-file-name
     2827           , input 1
     2828           , input substitute( "Невозможно передать на кассу &1 &2&3&4" +
     2829                               "Данный функционал доступен только для POS &5"
     2830                             ,  for-cash-desk.cash-num
     2831                             , 'маг':U
     2832                             , for-cash-desk.obj-code
     2833                             , chr(10)
     2834                             , 'IBM-XML':U
     2835                             )
     2836                                             ).
     2837        next _for.
     2838     end.
     2839     run write-log-and-file in p-log-handle (
     2840           input 1
     2841         , input log-file-name
     2842         , input 1
     2843         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2844                           )
     2845                                           ).
     2846   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2847   case for-cash-desk.pos-type:
     2848       when 'IBM-XML':U or when 'Autotank':U
     2849     then do:
     2850   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2851   run xml-cd-filename in this-procedure (
     2852         input out
     2853       , output v-xml-file-name
     2854       , output v-xml-file-name-path
     2855       , output v-log-file-name
     2856       , output v-locked
     2857   ).
     2858   run write-log-and-file in p-log-handle (
     2859         input 1
     2860       , input log-file-name
     2861       , input 1
     2862       , input substitute( ("'Пересылка схемы интеграции ККТ '" + " &1")
     2863                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2864                         )
     2865                                         ).
     2866   run write-log-and-file in p-log-handle (
     2867         input 1
     2868       , input log-file-name
     2869       , input 1
     2870       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2871                                         ).
     2872   assign
     2873   v-obj-list = 'маг':U + string(i-obj-code)
     2874   .
     2875   run xml-cd-write-header in this-procedure (
     2876         input v-xml-file-name
     2877       , input v-xml-file-name-path
     2878       , input 'config'
     2879       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2880       , input v-obj-list
     2881       , input (
     2882                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2883                   then (if for-cash-desk.autonomy = integer('0':U)
     2884                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2885                         else ("КМ"   )
     2886                         )
     2887                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2888                   )
     2889               )
     2890       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2891   ).
     2892   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2893   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2894     end.
     2895     when 'IBM':U
     2896     then do:
     2897   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2898   if for-cash-desk.cash-os = ""
     2899   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2900   then NEXT.
     2901   assign
     2902   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     2903               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2904   Cash-DOS = NOT CASH-OS2
     2905   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     2906   v-dir-remote-tmp = v-remote + "tmp":U
     2907   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     2908   .
     2909   if for-cash-desk.remote = 1 then do:
     2910     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     2911       if error-status:error then do:
     2912         run write-log-and-file in p-log-handle (
     2913               input 1
     2914             , input log-file-name
     2915             , input 1
     2916             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2917                               "и/или попытка его создания не удалась"
     2918                               ,v-dir-remote-tmp
     2919                               ,for-cash-desk.cash-num
     2920                               ,chr(10)
     2921                               )
     2922                                               ).
     2923         NEXT.
     2924     end.
     2925     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     2926       if error-status:error then do:
     2927         run write-log-and-file in p-log-handle (
     2928               input 1
     2929             , input log-file-name
     2930             , input 1
     2931             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2932                               "и/или попытка его создания не удалась"
     2933                               ,v-dir-remote
     2934                               ,for-cash-desk.cash-num
     2935                               ,chr(10)
     2936                               )
     2937                                               ).
     2938         NEXT.
     2939       end.
     2940   end.
     2941   output stream IBMStream
     2942   to value( (if for-cash-desk.remote = 1
     2943               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2944               else out) + fname + '.dat' ) convert target "ibm866".
     2945   OS2-time =       ( if Cash-OS2 then
     2946                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2947                         else "" )
     2948   .
     2949     end.
     2950   END CASE.
     2951     RUN putc-kkt in this-procedure
     2952                  ( input for-cash-desk.pos-type
     2953                   ,input for-cash-desk.version
     2954                   ,input for-cash-desk.cash-os
     2955                   ,input for-cash-desk.cash-num
     2956                   ,input p-value
     2957                   ,input true
     2958                   ).
     2959   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2960   case for-cash-desk.pos-type:
     2961       when 'IBM-XML':U or when 'Autotank':U
     2962     then do:
     2963   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2964   output stream stmxmlout close.
     2965   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2966       , input 'config'
     2967   ).
     2968   run write-log-and-file in p-log-handle (
     2969         input 1
     2970       , input log-file-name
     2971       , input 1
     2972       , input substitute( "Данные выгружены в файл &1"
     2973                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2974                         )
     2975                                          ).
     2976   if (
     2977   not (g#news or g#auto or g#esys )
     2978   or
     2979   (
     2980   for-cash-desk.pos-type = 'MAGIA-XML':U
     2981   or
     2982     (for-cash-desk.pos-type = 'IBM-XML':U
     2983   or (for-cash-desk.pos-type = 'Autotank':U
     2984     and
     2985     for-cash-desk.autonomy = integer('2':U))
     2986     )))
     2987   then do:
     2988     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2989     end.
     2990     if (for-cash-desk.pos-type = 'IBM-XML':U
     2991     and for-cash-desk.autonomy = integer('0':U))
     2992     or (for-cash-desk.pos-type = 'Autotank':U
     2993     and for-cash-desk.autonomy = integer('2':U))
     2994     then do:
     2995       run str/post-xml.p
     2996         (
     2997          input parparentproc
     2998         ,input p-parent-handle
     2999         ,input p-log-handle
     3000         ,input g#news or g#esys
     3001         ,input g#auto
     3002         ,input 'send'
     3003         ,input log-file-name
     3004         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     3005         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     3006         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     3007         ,input 30
     3008         ,input   ( if action = 'U'
     3009                     then ('Ждите - ' + 'изменение схемы интеграции ККТ ')
     3010                     else ('Ждите - ' + 'удаление схемы интеграции ККТ ') ) +
     3011                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     3012         ) no-error .
     3013       if error-status:error
     3014       or return-value = "error" then do:
     3015         run write-log-and-file in p-log-handle (
     3016               input 1
     3017             , input log-file-name
     3018             , input 1
     3019             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     3020                                   ,for-cash-desk.obj-code
     3021                                   ,for-cash-desk.cash-num
     3022                                   , chr(10)
     3023                                   , error-status:get-message(1)
     3024                                   , return-value
     3025                               )
     3026                                               ).
     3027         assign
     3028         v-view-log = yes
     3029         .
     3030       end.
     3031     end.
     3032     if not available ub.shop then do:
     3033       find first ub.shop no-lock where
     3034                 ub.shop.obj-code = for-cash-desk.obj-code.
     3035     end.
     3036     if
     3037     not (g#news or g#esys)
     3038     then do:
     3039       run str/getxibmf.p (
     3040                       input parparentproc
     3041                     ,input p-log-handle
     3042                     ,input 'маг':U
     3043                     ,input for-cash-desk.obj-code
     3044                     ,input ub.shop.host-code
     3045                     ,input in_
     3046                     ,input spl
     3047                     ,input (in_ + sav)
     3048                     ,input for-cash-desk.pos-type
     3049                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     3050                             and for-cash-desk.autonomy = integer('0':U))
     3051                             or (for-cash-desk.pos-type = 'Autotank':U
     3052                             and for-cash-desk.autonomy = integer('2':U))
     3053                             then "utf-8":U
     3054                             else "windows-1251")
     3055                     ,input log-file-name
     3056                     ,input "data":U
     3057                     ,input v-xml-file-name
     3058                     ,input-output v-view-log
     3059                     ) no-error .
     3060       if error-status:error then do:
     3061         run write-log-and-file in p-log-handle (
     3062               input 1
     3063             , input log-file-name
     3064             , input 1
     3065             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     3066                                   ,for-cash-desk.obj-code
     3067                                   ,for-cash-desk.cash-num
     3068                               )
     3069                                               ).
     3070         assign
     3071         v-view-log = yes
     3072         .
     3073       end.
     3074     end.
     3075   end.
     3076   if g#news
     3077   or g#auto
     3078   or g#esys
     3079   and for-cash-desk.pos-type = 'MAGIA-XML':U
     3080   then do:
     3081   end.
     3082     end.
     3083     when 'IBM':U
     3084     then do:
     3085   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3086   output stream IBMStream close.
     3087   output stream IBMStream
     3088   to value( (if for-cash-desk.remote = 1
     3089               then (v-dir-remote-tmp + chr(47) + "fl":U)
     3090               else out) + fname + '.ad0' ) convert target "ibm866".
     3091   put stream IBMStream ' ' skip(1).
     3092    put stream IBMStream unformatted '  ' for-cash-desk.addr-path ' plu' skip.
     3093   output stream IBMStream close.
     3094   OS-RENAME
     3095   VALUE((if for-cash-desk.remote = 1
     3096           then (v-dir-remote-tmp + chr(47) + "fl":U)
     3097           else out) + fname + '.ad0')
     3098   VALUE((if for-cash-desk.remote = 1
     3099           then (v-dir-remote + chr(47) + "fl":U)
     3100           else out) + fname + '.adr').
     3101   os-er = OS-ERROR.
     3102   run write-log-and-file in p-log-handle (
     3103         input 1
     3104       , input log-file-name
     3105       , input 1
     3106       , input substitute( "Данные выгружены в файл &1, файл адреса &2"
     3107                           , ((if for-cash-desk.remote = 1
     3108                               then (v-dir-remote + chr(47) + "fl":U)
     3109                               else out) + fname + '.dat')
     3110                           , ((if for-cash-desk.remote = 1
     3111                               then (v-dir-remote + chr(47) + "fl":U)
     3112                               else out) + fname + '.adr')
     3113                           )
     3114                                          ).
     3115   if os-er <> 0 then do:
     3116     run write-log-and-file in p-log-handle (
     3117           input 1
     3118         , input log-file-name
     3119         , input 1
     3120         , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     3121                               for-cash-desk.cash-num
     3122                           )
     3123                                           ).
     3124         assign
     3125         v-view-log = yes
     3126         .
     3127         return "error":U.
     3128   end.
     3129   if for-cash-desk.remote = 1 then do:
     3130     OS-RENAME
     3131     VALUE(v-dir-remote-tmp + chr(47) + "fl":U + fname + '.dat')
     3132     VALUE(v-dir-remote  + chr(47) + "fl":U + fname + '.dat').
     3133     os-er = OS-ERROR.
     3134     if os-er <> 0 then do:
     3135         run write-log-and-file in p-log-handle (
     3136               input 1
     3137             , input log-file-name
     3138             , input 1
     3139             , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     3140                                   for-cash-desk.cash-num
     3141                               )
     3142                                               ).
     3143         assign
     3144         v-view-log = yes
     3145         .
     3146         return "error":U.
     3147     end.
     3148     run write-log-and-file in p-log-handle (
     3149           input 1
     3150         , input log-file-name
     3151         , input 1
     3152         , input substitute( "Данные выгружены в файл &1",
     3153                               (v-dir-remote  + chr(47) + "fl":U + fname + '.dat')
     3154                           )
     3155                                           ).
     3156   end.
     3157   else do:
     3158     if not g#news
     3159     and not g#auto
     3160     and not g#esys
     3161     then do:
     3162     end.
     3163   end.
     3164     end.
     3165   END CASE.
     3166   END .
     3167   END PROCEDURE.
     3168   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3169   PROCEDURE SENDING:
     3170   _cash-desk:
     3171   FOR EACH ub.cash-desk NO-LOCK WHERE
     3172            ub.cash-desk.db-num = g#db-num AND
     3173            ub.cash-desk.obj-code = i-obj-code AND
     3174           ub.cash-desk.cash-on
     3175   BREAK
     3176   By ub.cash-desk.pos-type :
     3177               if p-value = "0" then
     3178               do:
     3179                  put stream str-log unformatted
     3180                     today " " string(time,"HH:MM:SS")  " Изменена схема интеграции ККТ на 0 - с ожиданием ответа для кассы "  string(ub.cash-desk.cash-num) skip .
     3181               end.
     3182               else
     3183               do:
     3184                  put stream str-log unformatted
     3185                     today " " string(time,"HH:MM:SS")  " Изменена схема интеграции ККТ на 1 - без ожидания ответа для кассы "  string(ub.cash-desk.cash-num)   skip .
     3186               end.
     3187     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     3188   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3189   define variable dflt-cd22 as character no-undo .
     3190   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3191   define variable v-param-type23 as character no-undo .
     3192   define variable v-value-date23 as date no-undo .
     3193   define variable v-value-decimal23 as decimal no-undo .
     3194   define variable v-value-integer23 as INTEGER no-undo .
     3195   define variable v-value-logical23 AS LOGICAL no-undo .
     3196   define variable v-tth23 as handle no-undo .
     3197   run adm/shattri.p (
     3198       input "get":U
     3199       ,input  'маг':U
     3200       ,input  ub.cash-desk.obj-code
     3201       ,input  'cd-sending':U
     3202       ,input  'dflt-cd':U
     3203       ,output dflt-cd22
     3204       ,output v-value-date23
     3205       ,output v-value-decimal23
     3206       ,output v-value-integer23
     3207       ,output v-value-logical23
     3208       ,output v-param-type23
     3209       ,INPUT-OUTPUT table-handle v-tth23
     3210       ) no-error .
     3211   delete object v-tth23 no-error.
     3212   case ub.cash-desk.pos-type:
     3213       when 'IBM-XML':U or when 'Autotank':U
     3214     then do:
     3215   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3216   run str/get-inis.p (
     3217                   input 'маг':U
     3218                 , input ub.cash-desk.obj-code
     3219                 , input ub.cash-desk.pos-type
     3220                 , input cash-desk.remote
     3221                 , input "send":U
     3222                 , output out
     3223                 , output out2
     3224                 , output in_
     3225                 , output spl
     3226                 , output sav
     3227                 , output v-remote
     3228                 )  no-error .
     3229   if error-status:error then do:
     3230     run write-log-and-file in p-log-handle (
     3231           input 1
     3232         , input log-file-name
     3233         , input 1
     3234         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3235                             , ub.cash-desk.pos-type
     3236                             , ub.cash-desk.obj-code
     3237                             , chr(10)
     3238                             , error-status:get-message(1)
     3239                             , return-value )).
     3240     assign
     3241     v-view-log = yes.
     3242     return error.
     3243   end.
     3244   if ub.cash-desk.pos-type = 'IBM-XML':U
     3245   or ub.cash-desk.pos-type = 'Autotank':U
     3246   then do:
     3247     file-info:file-name = (out  + "undelivered").
     3248     if file-info:FULL-PATHNAME <> ? then do:
     3249       run str/rsndxibm.p ( input parparentproc
     3250                           ,input p-parent-handle
     3251                           ,input p-log-handle
     3252                           ,input out  + "undelivered" ) no-error.
     3253     end.
     3254   end.
     3255     end.
     3256     when 'IBM':U
     3257     then do:
     3258   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3259   run str/get-inis.p (
     3260                   input 'маг':U
     3261                 , input ub.cash-desk.obj-code
     3262                 , input ub.cash-desk.pos-type
     3263                 , input cash-desk.remote
     3264                 , input "send":U
     3265                 , output out
     3266                 , output out2
     3267                 , output in_
     3268                 , output spl
     3269                 , output sav
     3270                 , output v-remote
     3271                 )  no-error .
     3272   if error-status:error then do:
     3273     run write-log-and-file in p-log-handle (
     3274           input 1
     3275         , input log-file-name
     3276         , input 1
     3277         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3278                             , ub.cash-desk.pos-type
     3279                             , ub.cash-desk.obj-code
     3280                             , chr(10)
     3281                             , error-status:get-message(1)
     3282                             , return-value )).
     3283     assign
     3284     v-view-log = yes.
     3285     return error.
     3286   end.
     3287     end.
     3288   END CASE.
     3289       RUN for-cash-cycle no-error.
     3290       if error-status:error then do:
     3291         run write-log-and-file in p-log-handle (
     3292               input 1
     3293             , input log-file-name
     3294             , input 1
     3295             , input substitute("&1 &2", error-status:get-message(1), return-value)
     3296                                                 ).
     3297         assign
     3298         v-view-log = yes
     3299         .
     3300       end.
     3301     END.
     3302     IF LAST-OF(ub.cash-desk.pos-type) then do:
     3303   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3304   case ub.cash-desk.pos-type:
     3305   END CASE.
     3306     END.
     3307   END.
     3308   END PROCEDURE.
     3309   RUN SENDING no-error.
     3310   if error-status:error then do:
     3311     run write-log-and-file in p-log-handle (
     3312           input 1
     3313         , input log-file-name
     3314         , input 1
     3315         , input substitute( "!!!Ошибки при отсылке схемы интеграции ККТ на кассы &1&2"
     3316                            , p-obj-type, i-obj-code
     3317                           )
     3318                                           ).
     3319   end.
     3320   output stream str-log close.
