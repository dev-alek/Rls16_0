        1   CREATE WIDGET-POOL.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   define input  parameter parobj-type like ub.clients.obj-type no-undo.
      109   define input  parameter parobj-code like ub.clients.obj-code no-undo.
      110   define output parameter parrec-id   as recid              no-undo.
      111   DEFINE VARIABLE h_b-nozzle AS HANDLE NO-UNDO.
      112   DEFINE BUTTON b-cancel AUTO-END-KEY
      113        LABEL "&Отмена"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "&Помощь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON b-sel AUTO-GO
      121        LABEL "&Выбор"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE FRAME D-Dialog
      125        b-help AT ROW 1.25 COL 23.5 WIDGET-ID 2
      126        b-sel AT ROW 1.33 COL 2
      127        b-cancel AT ROW 1.33 COL 12.63
      128        SPACE(26.11) SKIP(11.41)
      129       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      130            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      131            TITLE "Выбор пистолета ТРК"
      132            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-cancel.
      133   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      134   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      135   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      136   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      137   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      138   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      139   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      140   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      141       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      142   RUN ensure-broker.
      143   THIS-PROCEDURE:ADM-DATA =
      144        'ADM1.1~`':U +
      145        'SmartDialog~`':U +
      146        'DIALOG-BOX~`':U +
      147        'NO ~`':U +
      148        '~`':U +
      149        '~`':U +
      150        '~`':U +
      151        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      152           + "~`":U +
      153        'Layout,Hide-on-Init~`':U +
      154        '~`':U +
      155        '~`':U +
      156        '~`~`~`~`~`~`~`~`~`~`~`':U +
      157        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      158            THEN "^^":U
      159        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      160             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      161   PROCEDURE adm-apply-entry :
      162     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      163   END PROCEDURE.
      164   PROCEDURE adm-destroy :
      165    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      166   END PROCEDURE.
      167   PROCEDURE adm-disable :
      168       DISABLE b-help b-sel b-cancel WITH FRAME D-Dialog.
      169       RUN dispatch ('disable-fields':U).
      170       RUN set-attribute-list ('ENABLED=no':U).
      171       RETURN.
      172   END PROCEDURE.
      173   PROCEDURE adm-edit-attribute-list :
      174         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      175         RETURN.
      176   END PROCEDURE.
      177   PROCEDURE adm-enable :
      178       ENABLE UNLESS-HIDDEN b-help b-sel b-cancel WITH FRAME D-Dialog.
      179       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      180       RUN set-attribute-list ('ENABLED=yes':U).
      181       RETURN.
      182   END PROCEDURE.
      183   PROCEDURE adm-exit :
      184        RUN notify ('exit':U).
      185     RETURN.
      186   END PROCEDURE.
      187   PROCEDURE adm-hide :
      188     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      189   END PROCEDURE.
      190   PROCEDURE adm-initialize :
      191     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      192   END PROCEDURE.
      193   PROCEDURE adm-show-errors :
      194       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      195       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      196           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      197       END.
      198       RETURN.
      199   END PROCEDURE.
      200   PROCEDURE adm-UIB-mode :
      201     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      202   END PROCEDURE.
      203   PROCEDURE adm-view :
      204     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      205   END PROCEDURE.
      206   PROCEDURE dispatch :
      207       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      208       RUN broker-dispatch IN adm-broker-hdl
      209           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      210       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      211   END PROCEDURE.
      212   PROCEDURE ensure-broker :
      213   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      214   IF RETURN-VALUE NE "ADM-Broker":U THEN
      215   DO:
      216       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      217       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      218   END.
      219   END PROCEDURE.
      220   PROCEDURE get-attribute :
      221     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      222     RUN broker-get-attribute IN adm-broker-hdl
      223         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      224     RETURN RETURN-VALUE.
      225   END PROCEDURE.
      226   PROCEDURE get-attribute-list :
      227     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      228     RUN broker-get-attribute-list IN adm-broker-hdl
      229         (INPUT THIS-PROCEDURE,
      230          INPUT ?,
      231          OUTPUT p-attr-list) NO-ERROR.
      232     RETURN.
      233   END PROCEDURE.
      234   PROCEDURE new-state :
      235     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      236     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      237     RETURN.
      238   END PROCEDURE.
      239   PROCEDURE notify :
      240     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      241     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      242     IF RETURN-VALUE = "ADM-ERROR":U THEN
      243         RETURN "ADM-ERROR":U.
      244     RETURN.
      245   END PROCEDURE.
      246   PROCEDURE set-attribute-list :
      247     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      248     RUN ensure-broker.
      249     RUN broker-set-attribute-list IN adm-broker-hdl
      250         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      251     RETURN.
      252   END PROCEDURE.
      253   PROCEDURE set-position :
      254       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      255       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      256       IF VALID-HANDLE(adm-object-hdl) THEN
      257       DO:
      258           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      259           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      260           DO:
      261             IF p-row = 0 THEN p-row =
      262               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      263             IF p-col = 0 THEN p-col =
      264               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      265           END.
      266           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      267           DO:
      268             parent-hdl = adm-object-hdl:PARENT.
      269             IF p-row = 0 THEN p-row =
      270               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      271                 parent-hdl:ROW.
      272             IF p-col = 0 THEN p-col =
      273               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      274                 parent-hdl:COL.
      275           END.
      276           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      277           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      278         ASSIGN adm-object-hdl:ROW    =   p-row
      279                adm-object-hdl:COLUMN =   p-col.
      280       END.
      281       RETURN.
      282   END PROCEDURE.
      283   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      284       STRING(adm-object-hdl)).
      285   PAUSE 0 BEFORE-HIDE.
      286   PROCEDURE adm-change-page :
      287     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      288     END PROCEDURE.
      289   PROCEDURE delete-page :
      290     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      291     RUN broker-delete-page IN adm-broker-hdl
      292         (INPUT THIS-PROCEDURE, INPUT p-page#).
      293     END PROCEDURE.
      294   PROCEDURE init-object :
      295     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      296     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      297     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      298     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      299     RUN broker-init-object IN adm-broker-hdl
      300         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      301          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      302     RETURN.
      303   END PROCEDURE.
      304   PROCEDURE init-pages :
      305     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      306     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      307         INPUT p-page-list) NO-ERROR.
      308     END PROCEDURE.
      309   PROCEDURE select-page :
      310     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      311     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      312         INPUT p-page#) NO-ERROR.
      313     END PROCEDURE.
      314   PROCEDURE view-page :
      315     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      316     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      317         INPUT p-page#).
      318     END PROCEDURE.
      319   ASSIGN
      320          FRAME D-Dialog:SCROLLABLE       = FALSE
      321          FRAME D-Dialog:HIDDEN           = TRUE.
      322   ON WINDOW-CLOSE OF FRAME D-Dialog
      323   DO:
      324     APPLY "END-ERROR":U TO SELF.
      325   END.
      326   run set-attribute-list ('parparentproc='  + string(parparentproc)).
      327   run set-attribute-list ('obj-type=' + string(parobj-type)).
      328   run set-attribute-list ('obj-code=' + string(parobj-code)).
      329   run set-attribute-list ('buttons=b-help').
      330   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      331       MESSAGE "A SmartDialog is not intended ":U SKIP
      332               "to be run Persistent or to be placed ":U SKIP
      333               "in another SmartObject at UIB design time.":U
      334               VIEW-AS ALERT-BOX ERROR.
      335       RUN disable_UI.
      336       DELETE PROCEDURE THIS-PROCEDURE.
      337       RETURN.
      338   END.
      339   RUN dispatch ('create-objects':U).
      340   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      341   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      342   MAIN-BLOCK:
      343   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      344      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      345     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      346     WAIT-FOR GO OF FRAME D-Dialog.
      347   END.
      348   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      349   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   on help of frame D-Dialog
      351   do:
      352     run gbl/app_help.p
      353       (input this-procedure :file-name
      354       ,input ''
      355       ,input ?
      356       ) no-error.
      357     if error-status :error then do:
      358       message
      359         "Ошибка при вызове помощи"
      360         error-status :get-message(1)
      361         view-as alert-box .
      362     end.
      363   end.
      364   run minbtn-set in this-procedure .
      365   on choose of b-help in frame D-Dialog
      366   do:
      367     apply "help":u to frame D-Dialog .
      368   end.
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   procedure minbtn-set :
      371       do
      372           on error undo, return error return-value
      373           :
      374           define variable ii              as integer       no-undo .
      375           define variable fh              as widget-handle no-undo .
      376           define variable hh              as widget-handle no-undo .
      377           define variable v-h             as handle        extent 4 no-undo .
      378           define variable v-name-button   as character     no-undo .
      379           define variable v-help-old-x    as decimal       no-undo .
      380           define variable v-help-old-y    as decimal       no-undo .
      381           define variable v-help-old-size as decimal       no-undo .
      382           define variable v-frame-width   as decimal       no-undo .
      383           define variable jj              as integer       no-undo .
      384           do
      385               on error undo, return error
      386               :
      387               assign
      388                   v-frame-width = frame D-Dialog:width - 0.3
      389                   fh            = frame D-Dialog:first-child
      390                   hh            = fh:first-child
      391                   ii            = 1
      392                   .
      393               do while valid-handle(hh):
      394                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      395                   do:
      396                       case lc(hh:name) :
      397                           when "b-help" then
      398                               do:
      399                                   hh:load-image-up("cmp/b-help.bmp":u) .
      400                                   hh:load-image-down("cmp/b-help.bmp":u) .
      401                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      402                                   hh:TOOLTIP = "Помощь" .
      403                                   v-help-old-x = hh:column .
      404                                   v-help-old-y = hh:row    .
      405                                   v-help-old-size = hh:width .
      406                                   hh:width-chars = 2.5 .
      407                               end.
      408                           when "b-print" then
      409                               do:
      410                                   hh:load-image("cmp/b-print.bmp":u) .
      411                                   hh:TOOLTIP = "Печать" .
      412                                   v-h[ii] = hh:handle .
      413                                   ii = ii + 1 .
      414                                   hh:width-chars = 3 .
      415                               end.
      416                           when "b-history" or
      417                           when "b-hist" then
      418                               do:
      419                                   hh:load-image("cmp/b-hist.bmp":u) .
      420                                   hh:TOOLTIP = "История" .
      421                                   v-h[ii] = hh:handle .
      422                                   ii = ii + 1 .
      423                                   hh:width-chars = 3 .
      424                               end.
      425                           when "b-sch" then
      426                               do:
      427                                   hh:load-image("cmp/b-sch.bmp":u) .
      428                                   hh:TOOLTIP = "Установка Фильтра" .
      429                                   v-h[ii] = hh:handle .
      430                                   ii = ii + 1 .
      431                                   hh:width-chars = 3 .
      432                               end.
      433                           when "b-hist-user" then
      434                               do:
      435                                   hh:load-image("cmp/b-hist.bmp":u) .
      436                                   hh:TOOLTIP = "История пользователя" .
      437                                   ii = ii + 1 .
      438                               end.
      439                       end case.
      440                   end.
      441                   hh = hh:next-sibling.
      442               end.
      443               b-help:column = v-frame-width - b-help:width-chars.
      444               jj = 0.
      445               repeat ii = 4 to 1 by -1 :
      446                   if valid-handle (v-h[ii] ) then
      447                   do:
      448                       jj  = jj + 1 .
      449                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      450                       v-h[ii]:row    = v-help-old-y .
      451                   end.
      452               end.
      453           end.
      454       end.
      455   end procedure.
      456   PROCEDURE adm-create-objects :
      457     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
      458     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
      459     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
      460     CASE adm-current-page:
      461       WHEN 0 THEN DO:
      462          RUN init-object IN THIS-PROCEDURE (
      463                INPUT  'str/b-nozzle.w':U ,
      464                INPUT  FRAME D-Dialog:HANDLE ,
      465                INPUT  'Layout = ':U ,
      466                OUTPUT h_b-nozzle ).
      467          RUN set-position IN h_b-nozzle ( 2.83 , 2.13 ) NO-ERROR.
      468          RUN set-size IN h_b-nozzle ( 10.54 , 46.25 ) NO-ERROR.
      469          RUN add-link IN adm-broker-hdl ( h_b-nozzle , 'recid-nozzle':U , THIS-PROCEDURE ).
      470          RUN adjust-tab-order IN adm-broker-hdl ( h_b-nozzle ,
      471                b-cancel:HANDLE , 'AFTER':U ).
      472       END.
      473     END CASE.
      474   END PROCEDURE.
      475   PROCEDURE adm-row-available :
      476     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      477     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      478     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      479     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      480     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      481     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      482     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      483     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      484     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      485     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      486     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      487     IF adm-updating-record THEN RETURN.
      488     RUN get-attribute ('FIELDS-ENABLED':U).
      489     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      490     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      491         OUTPUT link-handle) NO-ERROR.
      492     IF link-handle = "":U THEN
      493         RETURN.
      494     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      495     IF NUM-ENTRIES(link-handle) > 1 THEN
      496         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      497             "encountered more than one RECORD-SOURCE.":U SKIP
      498             "The first - ":U record-source-hdl:file-name " - will be used.":U
      499                VIEW-AS ALERT-BOX ERROR.
      500     RUN get-attribute ('Key-Name':U).
      501     key-name = RETURN-VALUE.
      502     IF key-name = "":U THEN key-name = ?.
      503     IF key-name NE ? THEN DO:
      504       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      505         NO-ERROR.
      506       IF key-value NE ? THEN
      507         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      508     END.
      509   IF VALID-HANDLE (adm-object-hdl) THEN
      510       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      511   RUN notify IN THIS-PROCEDURE ('row-available':U).
      512   END PROCEDURE.
      513   PROCEDURE disable_UI :
      514     HIDE FRAME D-Dialog.
      515   END PROCEDURE.
      516   PROCEDURE enable_UI :
      517     ENABLE b-help b-sel b-cancel
      518         WITH FRAME D-Dialog.
      519     VIEW FRAME D-Dialog.
      520   END PROCEDURE.
      521   PROCEDURE recid-nozzle :
      522     RUN get-attribute IN h_b-nozzle (INPUT 'recid-nozzle':U).
      523     assign parrec-id = integer(return-value).
      524    END PROCEDURE.
      525   PROCEDURE send-records :
      526   END PROCEDURE.
      527   PROCEDURE state-changed :
      528     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      529     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      530   END PROCEDURE.
