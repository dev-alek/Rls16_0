        1   block-level on error undo, throw.
        2   define input  parameter iobj-type as character no-undo.
        3   define input  parameter iobj-code as integer no-undo.
        4   define input  parameter igds-code as integer no-undo.
        5   define input  parameter idoc-code as character no-undo.
        6   define output parameter oquantity as decimal no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: c16f204c84f9, 2642, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        9   define variable vss-date        as character no-undo init "$Date: Пт окт 23 21:03:38 2020 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: getost.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: str/getost.p $":U .
       12   define variable vss-description as character no-undo init "Остаток наначало смены".
       13   define new global shared variable g#language as character no-undo .
       14   if g#language <> '' and g#language <> 'rus':U then do:
       15     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       16   end.
       17   define new global shared variable g#library  as handle no-undo .
       18   define new global shared variable g#library2 as handle no-undo .
       19   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       20   procedure factord :
       21     define input  parameter p-fact-date            as date    no-undo .
       22     define input  parameter p-fact-time            as integer no-undo .
       23     define input  parameter p-fact-num             as integer no-undo .
       24     define input  parameter p-shift-date           as date    no-undo .
       25     define input  parameter p-shift-num            as integer no-undo .
       26     define input  parameter p-shift-on             as logical no-undo .
       27     define output parameter p-fact-order           as decimal no-undo .
       28     define output parameter p-shift-end-fact-order as decimal no-undo .
       29     define output parameter p-day-end-fact-order   as decimal no-undo .
       30     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       31     if p-fact-date = ?
       32     then do:
       33       return error "Не указана фактическая дата" .
       34     end.
       35     define variable v-fact-date-num as integer no-undo .
       36     assign
       37       v-fact-date-num = integer(p-fact-date)
       38     .
       39     if p-fact-num = ?
       40     or p-fact-num = 0
       41     then do:
       42       return error "Не задан p-fact-num " + string(p-fact-num) .
       43     end.
       44     if p-fact-num < 0
       45     then do:
       46       return error "Отрицательный fact-num " + string(p-fact-num) .
       47     end.
       48     if p-fact-num >= 100000000
       49     then do:
       50       return error "Недопустимо большой fact-num " + string(p-fact-num) .
       51     end.
       52     if p-shift-on = true
       53     then do:
       54       if p-shift-date = ?
       55       then do:
       56         return error "Не задана дата смены" .
       57       end.
       58       if p-shift-num = ?
       59       or p-shift-num = 0
       60       then do:
       61         return error "Не задан номер смены" .
       62       end.
       63     end.
       64     else do:
       65       assign
       66         p-shift-date = p-fact-date
       67         p-shift-num  = 24
       68       .
       69     end.
       70     define variable v-shift-offset as integer no-undo .
       71     if p-shift-date = p-fact-date
       72     then do:
       73       assign
       74         v-shift-offset = 1
       75       .
       76     end.
       77     if p-shift-date < p-fact-date
       78     then do:
       79       assign
       80         v-shift-offset = 0
       81       .
       82     end.
       83     if p-shift-date > p-fact-date
       84     then do:
       85       message
       86         vss-workfile vss-revision vss-description skip
       87         "Неправильная дата закрытия смены" skip
       88         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
       89         view-as alert-box error .
       90       undo, return error
       91         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
       92           ,string(p-fact-date, '99/99/9999':U)
       93           ,string(p-shift-date, '99/99/9999':U)
       94           )
       95       .
       96     end.
       97     if p-shift-num < 1
       98     or p-shift-num > 24
       99     then do:
      100       message
      101         vss-workfile vss-revision vss-description skip
      102         "Неправильный номер смены" skip
      103         "p-shift-num" p-shift-num skip
      104         view-as alert-box error .
      105       undo, return error return-value .
      106     end.
      107     assign
      108       p-fact-order           = v-fact-date-num
      109                              + v-shift-offset * 0.5
      110                              + p-shift-num    * 0.02 - 0.01
      111                              + p-fact-num     * 0.0000000001
      112       p-shift-end-fact-order = v-fact-date-num
      113                              + v-shift-offset * 0.5
      114                              + p-shift-num    * 0.02
      115       p-day-end-fact-order   = v-fact-date-num
      116                              + 0.99
      117     .
      118     if p-fact-order           <= v-fact-date-num
      119     or p-shift-end-fact-order <= v-fact-date-num
      120     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      121     or p-shift-end-fact-order >= p-day-end-fact-order
      122     then do:
      123       message
      124         vss-workfile vss-revision vss-description skip
      125         "Внутренняя ошибка при генерации фактического номера" skip
      126         "p-fact-date"            p-fact-date            skip
      127         "p-fact-time"            p-fact-time            skip
      128         "p-fact-num"             p-fact-num             skip
      129         "p-shift-date"           p-shift-date           skip
      130         "p-shift-num"            p-shift-num            skip
      131         "p-shift-on"             p-shift-on             skip
      132         "p-shift-end-fact-order" p-shift-end-fact-order skip
      133         "p-day-end-fact-order"   p-day-end-fact-order   skip
      134         "v-fact-date-num"        v-fact-date-num        skip
      135         view-as alert-box error .
      136       undo, return error return-value .
      137     end.
      138   end procedure.
      139   procedure day-begin-fact-order :
      140     define input  parameter p-fact-date            as date    no-undo .
      141     define output parameter p-day-begin-fact-order as decimal no-undo .
      142     do
      143     on error undo, return error return-value
      144     :
      145       if p-fact-date = ?
      146       then do:
      147         assign
      148           p-day-begin-fact-order = 0
      149         .
      150       end.
      151       else do:
      152         assign
      153           p-day-begin-fact-order = integer(p-fact-date)
      154         .
      155       end.
      156     end.
      157   end procedure.
      158   procedure factord-max-fact-order :
      159     define output parameter p-max-fact-order as decimal   no-undo .
      160     do
      161     on error undo, return error return-value
      162     :
      163       run day-begin-fact-order in this-procedure
      164         (input  date(1, 1, 5000)
      165         ,output p-max-fact-order
      166         ) .
      167     end.
      168   end procedure.
      169   procedure factord-cut-archive :
      170     define input  parameter p-obj-type             as character no-undo .
      171     define input  parameter p-obj-code             as integer   no-undo .
      172     define input  parameter p-fact-date            as date      no-undo .
      173     define output parameter p-shift-on             as logical   no-undo .
      174     define output parameter p-shift-date           as date      no-undo .
      175     define output parameter p-shift-num            as integer   no-undo .
      176     define output parameter p-day-end-fact-order   as decimal   no-undo .
      177     define output parameter p-shift-end-fact-order as decimal   no-undo .
      178     define variable v-fact-order as decimal   no-undo .
      179     define buffer buf_shift-obj for ub.shift-obj .
      180     do
      181     on error undo, return error return-value
      182     :
      183   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      185     (input  p-obj-type
      186     ,input  p-obj-code
      187     ,input  'shift-on=request'
      188     ,output p-shift-on
      189     ) no-error .
      190       if error-status :error
      191       then do:
      192         message
      193           vss-workfile vss-revision vss-description skip
      194           "Ошибка при определении атрибута объекта" skip
      195           "Объект" p-obj-type p-obj-code skip
      196           error-status :get-message(1) skip
      197           return-value skip
      198           view-as alert-box error .
      199         undo, return error return-value .
      200       end.
      201       if p-shift-on = false
      202       then do:
      203         assign
      204           p-shift-date               = ?
      205           p-shift-num                = 0
      206         .
      207       end.
      208       else do:
      209         find first buf_shift-obj share-lock
      210           where buf_shift-obj.obj-type   = p-obj-type
      211             and buf_shift-obj.obj-code   = p-obj-code
      212             and buf_shift-obj.shift-date > p-fact-date
      213           use-index pi
      214           no-error .
      215         if not available buf_shift-obj
      216         or buf_shift-obj.status_ <> 'зкр':U
      217         then do:
      218           message
      219             vss-workfile vss-revision vss-description skip
      220             "Невозможно вычислить последнюю смену" skip
      221             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      222             "Объект" p-obj-type p-obj-code skip
      223             "Дата" p-fact-date skip
      224             view-as alert-box error .
      225           undo, return error return-value .
      226         end.
      227         find last buf_shift-obj share-lock
      228           where buf_shift-obj.obj-type = p-obj-type
      229             and buf_shift-obj.obj-code = p-obj-code
      230             and buf_shift-obj.shift-date <= p-fact-date
      231           use-index pi
      232           no-error .
      233         if available buf_shift-obj
      234         then do:
      235           if  buf_shift-obj.status_ = 'зкр':U
      236           then do:
      237             assign
      238               p-shift-date = buf_shift-obj.shift-date
      239               p-shift-num  = buf_shift-obj.shift-num
      240             .
      241           end.
      242           else do:
      243             message
      244               vss-workfile vss-revision vss-description skip
      245               "Невозможно вычислить последнюю смену" skip
      246               "Статус смены отличен от статуса" 'зкр':U skip
      247               "Объект" p-obj-type p-obj-code skip
      248               "Дата" p-fact-date skip
      249               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      250               view-as alert-box error .
      251             undo, return error return-value .
      252           end.
      253         end.
      254         else do:
      255           assign
      256             p-shift-date = p-fact-date - 1
      257             p-shift-num  = 1
      258           .
      259         end.
      260       end.
      261       run factord in this-procedure
      262         (input  p-fact-date
      263         ,input  1
      264         ,input  1
      265         ,input  p-shift-date
      266         ,input  p-shift-num
      267         ,input  p-shift-on
      268         ,output v-fact-order
      269         ,output p-shift-end-fact-order
      270         ,output p-day-end-fact-order
      271         ) no-error .
      272       if error-status :error
      273       then do:
      274         message
      275           vss-workfile vss-revision vss-description skip
      276           "Ошибка при вызове процедуры factord"
      277           error-status :get-message(1) skip
      278           return-value skip
      279           view-as alert-box error .
      280         undo, return error return-value .
      281       end.
      282     end.
      283   end procedure.
      284   procedure factord-lock-shift :
      285     define input  parameter p-obj-type  as character no-undo .
      286     define input  parameter p-obj-code  as integer   no-undo .
      287     define input  parameter p-fact-date as date      no-undo .
      288     define parameter buffer buf_shift-obj for ub.shift-obj .
      289     define variable v-shift-on      as logical   no-undo .
      290     define variable v-extra-message as character no-undo .
      291     define variable v-error as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      297     (input  p-obj-type
      298     ,input  p-obj-code
      299     ,input  'shift-on=request'
      300     ,output v-shift-on
      301     ) no-error .
      302       if error-status :error
      303       then do:
      304         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      305         undo, return error v-error .
      306       end.
      307       if v-shift-on = true
      308       then do:
      309         find first buf_shift-obj share-lock
      310           where buf_shift-obj.obj-type   = p-obj-type
      311             and buf_shift-obj.obj-code   = p-obj-code
      312             and buf_shift-obj.shift-date > p-fact-date
      313           use-index pi
      314           no-error .
      315         if not available buf_shift-obj
      316         or buf_shift-obj.status_ <> 'зкр':U
      317         then do:
      318           find last buf_shift-obj
      319             where buf_shift-obj.obj-type = p-obj-type
      320               and buf_shift-obj.obj-code = p-obj-code
      321               and buf_shift-obj.status_  = 'зкр':U
      322             use-index stts
      323             no-error .
      324           if available buf_shift-obj
      325           then do:
      326             assign
      327               v-extra-message =
      328                     substitute("Дата начала последеней закрытой смены на объекте &1"
      329                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      330                               )
      331             .
      332           end.
      333           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      334           undo, return error v-error .
      335         end.
      336       end.
      337     end.
      338   end procedure.
      339   procedure factord-end-day :
      340     define input  parameter p-fact-date            as date    no-undo .
      341     define output parameter p-day-end-fact-order   as decimal no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       if p-fact-date = ?
      346       then do:
      347         return error "Не указана фактическая дата" .
      348       end.
      349       assign
      350         p-day-end-fact-order = integer(p-fact-date) + 0.99
      351       .
      352     end.
      353   end procedure.
      354   procedure factord-to-date :
      355     define input  parameter p-fact-order as decimal no-undo .
      356     define output parameter p-fact-date  as date    no-undo .
      357     define variable v-ref-date  as date      no-undo .
      358     define variable v-ref-delta as integer   no-undo .
      359     do
      360     on error undo, return error return-value
      361     :
      362       if p-fact-order = ?
      363       or p-fact-order = 0
      364       then do:
      365         return error "Не указан fact-order" .
      366       end.
      367       assign
      368         v-ref-date  = date(1, 1, 2000)
      369       .
      370       assign
      371         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      372       .
      373       assign
      374         p-fact-date = v-ref-date + v-ref-delta
      375       .
      376     end.
      377   end procedure.
      378   procedure factord-to-fact-num :
      379     define input  parameter p-fact-order as decimal no-undo .
      380     define output parameter p-fact-num   as integer no-undo .
      381     define variable v-fact-order-trunc as decimal no-undo .
      382     do
      383     on error undo, return error return-value
      384     :
      385       if p-fact-order = ?
      386       or p-fact-order = 0
      387       then do:
      388         return error "Не указан fact-order" .
      389       end.
      390       assign
      391        v-fact-order-trunc = truncate(p-fact-order, 2)
      392       .
      393       assign
      394         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      395       .
      396     end.
      397   end procedure.
      398   procedure factord-to-shift-num :
      399     define input  parameter p-fact-order as decimal no-undo .
      400     define output parameter p-shift-num   as integer no-undo .
      401     define variable  p-shift-numd  as decimal   no-undo .
      402     define variable v-fact-order-trunc as decimal no-undo .
      403     do
      404     on error undo, return error return-value
      405     :
      406       if p-fact-order = ?
      407       or p-fact-order = 0
      408       then do:
      409         return error "Не указан fact-order" .
      410       end.
      411       assign
      412        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      413       .
      414       if v-fact-order-trunc < 0.5 then do:
      415         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      416       end.
      417       assign
      418         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      419         .
      420        assign
      421         p-shift-num = truncate (p-shift-numd , 0)
      422       .
      423     end.
      424   end procedure.
      425   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   def
      427   temp-table  obj-list no-undo
      428     field obj-type like ub.clients.obj-type
      429     field obj-code like ub.clients.obj-code
      430     field obj-name like ub.clients.obj-name
      431     field obj-id   as integer
      432     field db-num   as integer
      433     index pi is primary unique obj-id
      434     index ie1 obj-type obj-code
      435     index ie2 obj-name
      436   .
      437   define variable quantity as decimal no-undo.
      438   define variable coast_r  as decimal no-undo.
      439   define variable coast_v  as decimal no-undo.
      440   define variable vat_r    as decimal no-undo.
      441   define variable vat_v    as decimal no-undo.
      442   define variable slt_r    as decimal no-undo.
      443   define variable slt_v    as decimal no-undo.
      444   procedure ost-line :
      445     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
      446     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
      447     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
      448     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
      449     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
      450     define input  parameter x-tog-shift  as logical no-undo .
      451     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
      452     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
      453     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
      454     define input  parameter xtog-obj     as logical no-undo .
      455     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
      456     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
      457     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
      458     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
      459     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
      460     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
      461     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
      462     define buffer buff-obj-list  for obj-list .
      463     define buffer buff-stk-line  for ub.stk-line .
      464     assign
      465       Quantity = 0
      466       Coast_R  = 0
      467       Coast_V  = 0
      468       VAT_R    = 0
      469       VAT_V    = 0
      470       SLT_R    = 0
      471       SLT_V    = 0
      472     .
      473     if  x-tog-shift = false then do:
      474       for each buff-obj-list no-lock
      475         where xtog-obj = false
      476            or (buff-obj-list.obj-type = x-store-type
      477               and buff-obj-list.obj-code = x-store-code
      478               )
      479       on error undo, return error
      480       :
      481         find last buff-stk-line no-lock
      482           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      483             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      484             and buff-stk-line.artic      = x-artic
      485             and buff-stk-line.prod-type  = x-prod-type
      486             and buff-stk-line.prod-code  = x-prod-code
      487             and buff-stk-line.sum-type   = x-sum-type
      488             and buff-stk-line.cat-id     = '##,##':U
      489             and buff-stk-line.fact-order <= x-fact-order
      490             and buff-stk-line.shift-num  = 0
      491           use-index category
      492           no-error .
      493         if available buff-stk-line then do:
      494           assign
      495             Quantity = Quantity +  buff-stk-line.fact-qnty
      496             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      497             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      498             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      499             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      500             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      501             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      502           .
      503         end.
      504       end.
      505     end.
      506     else do:
      507       for each buff-obj-list no-lock
      508         where xtog-obj = false
      509            or (buff-obj-list.obj-type = x-store-type
      510               and buff-obj-list.obj-code = x-store-code
      511               )
      512       on error undo, return error
      513       :
      514         find last buff-stk-line no-lock
      515           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      516             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      517             and buff-stk-line.artic      = x-artic
      518             and buff-stk-line.prod-type  = x-prod-type
      519             and buff-stk-line.prod-code  = x-prod-code
      520             and buff-stk-line.sum-type   = x-sum-type
      521             and buff-stk-line.cat-id     = '##,##':U
      522             and buff-stk-line.fact-order <= x-fact-order
      523             and buff-stk-line.shift-num  > 0
      524           use-index category
      525           no-error .
      526         if available buff-stk-line then do:
      527           assign
      528             Quantity = Quantity +  buff-stk-line.fact-qnty
      529             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      530             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      531             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      532             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      533             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      534             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      535           .
      536         end.
      537       end.
      538     end.
      539   end procedure.
      540   procedure ost-lineother-tax :
      541     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
      542     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
      543     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
      544     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
      545     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
      546     define input  parameter x-tog-shift  as logical no-undo .
      547     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
      548     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
      549     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
      550     define input  parameter xTog-obj     as logical no-undo .
      551     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
      552     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
      553     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
      554     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
      555     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
      556     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
      557     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
      558     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
      559     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
      560     define buffer buff-obj-list  for obj-list .
      561     define buffer buff-stk-line  for ub.stk-line .
      562     assign
      563       Quantity = 0
      564       Coast_R  = 0
      565       Coast_V  = 0
      566       VAT_R    = 0
      567       VAT_V    = 0
      568       SLT_R    = 0
      569       SLT_V    = 0
      570       other_R  = 0
      571       other_V  = 0
      572     .
      573     if  x-tog-shift = false then do:
      574       for each buff-obj-list no-lock
      575         where xtog-obj = false
      576            or (buff-obj-list.obj-type = x-store-type
      577               and buff-obj-list.obj-code = x-store-code
      578               )
      579       on error undo, return error
      580       :
      581         find last buff-stk-line no-lock
      582           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      583             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      584             and buff-stk-line.artic      = x-artic
      585             and buff-stk-line.prod-type  = x-prod-type
      586             and buff-stk-line.prod-code  = x-prod-code
      587             and buff-stk-line.sum-type   = x-sum-type
      588             and buff-stk-line.cat-id     = '##,##':U
      589             and buff-stk-line.fact-order <= x-fact-order
      590             and buff-stk-line.shift-num  = 0
      591           use-index category
      592           no-error .
      593         if available buff-stk-line then do:
      594           assign
      595             Quantity = Quantity +  buff-stk-line.fact-qnty
      596             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      597             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      598             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      599             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      600             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      601             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      602             other_R  = other_R  +  buff-stk-line.other-rubl
      603             other_V  = other_V  +  buff-stk-line.other-base
      604           .
      605         end.
      606       end.
      607     end.
      608     else do:
      609       for each buff-obj-list no-lock
      610         where xtog-obj = false
      611            or (buff-obj-list.obj-type = x-store-type
      612               and buff-obj-list.obj-code = x-store-code
      613               )
      614       on error undo, return error
      615       :
      616         find last buff-stk-line no-lock
      617           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      618             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      619             and buff-stk-line.artic      = x-artic
      620             and buff-stk-line.prod-type  = x-prod-type
      621             and buff-stk-line.prod-code  = x-prod-code
      622             and buff-stk-line.sum-type   = x-sum-type
      623             and buff-stk-line.cat-id     = '##,##':U
      624             and buff-stk-line.fact-order <= x-fact-order
      625             and buff-stk-line.shift-num  > 0
      626           use-index category
      627           no-error .
      628         if available buff-stk-line then do:
      629           assign
      630             Quantity = Quantity +  buff-stk-line.fact-qnty
      631             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      632             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      633             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      634             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      635             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      636             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      637             other_R = other_R   +  buff-stk-line.other-rubl
      638             other_V = other_V   +  buff-stk-line.other-base
      639           .
      640         end.
      641       end.
      642     end.
      643   end procedure.
      644   procedure ost-line-kg :
      645     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
      646     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
      647     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
      648     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
      649     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
      650     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
      651     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
      652     define buffer buff-obj-list  for obj-list .
      653     define buffer buf_doc-line for ub.doc-line .
      654     define buffer buf_inv-line for ub.inv-line .
      655     do
      656     on error undo, return error
      657     :
      658       for each buf_doc-line no-lock where
      659                buf_doc-line.obj-type    = p-obj-type   and
      660                buf_doc-line.obj-code    = p-obj-code   and
      661                buf_doc-line.prod-type   = p-prod-type  and
      662                buf_doc-line.prod-code   = p-prod-code  and
      663                buf_doc-line.artic       = p-artic      and
      664                buf_doc-line.status_     = 'факт':U      and
      665                buf_doc-line.fact-order <= p-fact-order
      666             by buf_doc-line.fact-order    descending
      667       :
      668         find first buf_inv-line no-lock where
      669                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
      670                    buf_inv-line.artic     = buf_doc-line.artic     and
      671                    buf_inv-line.prod-type = buf_doc-line.prod-type and
      672                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
      673         if available buf_inv-line
      674         then do:
      675           if buf_inv-line.after-cli-qnty <> ?
      676           then do:
      677             assign
      678               p-quantity-kg = buf_inv-line.after-cli-qnty
      679             .
      680             leave .
      681           end.
      682         end.
      683       end.
      684       if p-quantity-kg = ?
      685       then do:
      686         assign
      687           p-quantity-kg = 0
      688         .
      689       end.
      690     end.
      691   end procedure.
      692   PROCEDURE ostatok :
      693   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      694   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      695   def input parameter x-tog-shift   as   logical             no-undo.
      696   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      697   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      698   def input parameter x-shift-start as integer               no-undo.
      699   def input parameter x-shift-end   as integer               no-undo.
      700   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      701   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      702   def input parameter xTog-obj   as log no-undo.
      703   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      704   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      705   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      706   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      707   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      708   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      709   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      710   def var              Fact-orderS   as char  no-undo.
      711   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      712      Assign
      713         Fact-order   = 0
      714         Quantity     = 0
      715         Coast_R      = 0
      716         Coast_V      = 0
      717         VAT_R        = 0
      718         VAT_V        = 0 .
      719    x-date-start-t  = x-date-start + 1 .
      720   IF x-date-end = date('') then DO:
      721      Fact-order = 0 .
      722      for each obj-list
      723          where  ( not xtog-obj or
      724                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      725                 no-lock :
      726         if  x-tog-shift = false then do:
      727                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      728                               ub.stk-tot.Fact-date <=  x-date-start
      729                               and ub.stk-tot.shift-num = 0
      730                               USE-INDEX fact-date no-lock no-error .
      731              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      732         End.
      733         Else  DO :
      734             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      735              (ub.stk-tot.shift-date  = x-date-start-t and
      736               ub.stk-tot.shift-num  < x-shift-start or
      737               ub.stk-tot.shift-date  < x-date-start-t  )
      738               and ub.stk-tot.shift-num  > 0
      739               USE-INDEX Shift-num no-lock no-error .
      740            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      741           END.
      742       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      743     End.
      744   End.
      745   Else DO:
      746     For each obj-list  WHERE
      747        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      748         no-lock :
      749      IF  x-TOG-Shift = False Then DO:
      750          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      751               ub.stk-tot.Fact-date <= x-date-end
      752               and ub.stk-tot.shift-num = 0
      753               USE-INDEX fact-date no-lock no-error.
      754          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      755      END.
      756      Else DO:
      757           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      758               (ub.stk-tot.shift-date  = x-date-end and
      759               ub.stk-tot.shift-num  <= x-shift-end or
      760               ub.stk-tot.shift-date  < x-date-end       ) and
      761               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      762               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      763       End.
      764       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      765     End.
      766   End.
      767   END PROCEDURE.
      768   create obj-list.
      769   assign
      770      obj-list.obj-type = iobj-type
      771      obj-list.obj-code = iobj-code
      772      obj-list.obj-id   = iobj-code
      773      obj-list.obj-name = string(iobj-code) + iobj-type
      774      .
      775   find first trn-doc where trn-doc.doc-code eq idoc-code no-lock no-error.
      776   if available trn-doc
      777   then do:
      778      find first shift-obj where shift-obj.obj-type   eq iobj-type
      779                             and shift-obj.obj-code   eq iobj-code
      780                             and shift-obj.shift-date eq trn-doc.shift-date
      781                             and shift-obj.shift-num  eq trn-doc.shift-num
      782      no-lock no-error.
      783      if available shift-obj
      784      then do:
      785          define variable v-fact-order-1           as decimal no-undo .
      786          run ostatok (
      787           input shift-obj.obj-code  ,
      788           input shift-obj.obj-type  ,
      789           input yes,
      790           input shift-obj.shift-date - 1 ,
      791           input date('')      ,  shift-obj.shift-num,shift-obj.shift-num,
      792           input 'crsa':U   ,
      793           input '##,##':U,
      794           input yes ,
      795           output  Quantity  ,
      796           output  Coast_R   ,
      797           output  Coast_V   ,
      798           output  VAT_R     ,
      799           output  VAT_V     ,
      800           output  v-Fact-order-1 ).
      801           define variable v-date-start as date no-undo.
      802           define variable v-date-end as date no-undo.
      803           v-date-start = shift-obj.shift-date.
      804           v-date-end = shift-obj.shift-date.
      805           define variable v-archive-ok as logical no-undo.
      806           define variable v-comment    as character no-undo.
      807           define variable v-can-print  as logical no-undo.
      808         run rep/chk-ahz.p
      809           (input        shift-obj.obj-type
      810           ,input        shift-obj.obj-code
      811           ,input        no
      812           ,input        yes
      813           ,input        no
      814           ,input        no
      815           ,input        no
      816           ,input        ibs.th.gbl.gbl-var:g#db-num
      817           ,input        ibs.th.gbl.gbl-var:g#userid
      818           ,input-output v-date-start
      819           ,input-output v-date-end
      820           ,output       v-archive-ok
      821           ,output       v-comment
      822           ,output       v-can-print
      823           ) .
      824         if v-archive-ok = false
      825         then do:
      826           if v-can-print = false
      827           then do:
      828             message
      829               "ВНИМАНИЕ !!!" skip
      830               "Отчет не может быть сформирован!" skip
      831               "На запрошенную дату нет архивов или они сжаты" skip
      832               v-comment skip
      833               view-as alert-box information .
      834           end.
      835         end.
      836         find first goods where goods.gds-code eq igds-code
      837         no-lock no-error.
      838         if available goods
      839         then do:
      840            run ost-line (
      841                                 input   iobj-code
      842                                ,input   iobj-type
      843                                ,input   goods.artic
      844                                ,input   goods.prod-code
      845                                ,input   goods.prod-type
      846                                ,input   true
      847                                ,input   v-fact-order-1
      848                                ,input   'cost':U
      849                                ,input   '##,##':U
      850                                ,input   true
      851                                ,output  quantity
      852                                ,output  coast_r
      853                                ,output  coast_v
      854                                ,output  vat_r
      855                                ,output  vat_v
      856                                ,output  slt_r
      857                                ,output  slt_v
      858                                ).
      859         end.
      860      end.
      861   end.
      862   oquantity = quantity.
