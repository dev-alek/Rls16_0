        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения хранения товара на складском месте":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer bf_obj   for ub.clients.
      113   define buffer bf_cli   for ub.clients.
      114   define buffer bf_place for ub.place.
      115   define buffer bf_goods for ub.goods.
      116   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      117   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      118   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      119   define variable v-header as character no-undo initial " И Н Ф О Р М А Ц И Я   О   Т О В А Р Е ".
      120   define variable v-label  as character no-undo initial " К О Л И Ч Е С Т В Е Н Н Ы Е   Х А Р А К Т Е Р И С Т И К И ".
      121   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      122   define rectangle r-rect-1 edge-pixels 2 graphic-edge no-fill size-chars 98.25 by 4.50.
      123   define rectangle r-rect-2 edge-pixels 2 graphic-edge no-fill size-chars 98.25 by 3.75.
      124   define frame fr-D-pump-8
      125     ub.c-pl-gds.pl-code     at row  1.25 col 18.00 colon-aligned view-as fill-in    size-chars 10.50 by 1.00    label "Складское место"
      126     bf_place.pl-name     at row  1.25 col 31.00          view-as fill-in    size-chars 68.50 by 1.00 no-label format "x(80)":U   fgcolor  4
      127     ub.c-pl-gds.obj-type    at row  2.50 col 18.00 colon-aligned view-as combo-box inner-lines 5 list-items "":U, 'орг':U, 'чел':U, 'скл':U, 'маг':U size-chars    6.00 by 1.00    label "Объект"
      128     ub.c-pl-gds.obj-code    at row  2.50 col 26.50          view-as fill-in    size-chars 10.50 by 1.00 no-label
      129       bf_obj.obj-name    at row  2.50 col 37.50          view-as fill-in    size-chars 62.00 by 1.00 no-label format "x(80)":U   fgcolor  4
      130     r-rect-1             at row  4.50 col  1.50
      131     v-header             at row  4.00 col 29.00          view-as fill-in    size-chars 40.25 by 1.00 no-label format "x(40)":U   fgcolor 15 bgcolor 3
      132     ub.c-pl-gds.gds-code    at row  5.00 col 18.00 colon-aligned view-as fill-in    size-chars 10.50 by 1.00    label "Код"              fgcolor  4
      133     bf_goods.artic       at row  5.00 col 38.50          view-as fill-in    size-chars 17.50 by 1.00    label "Артикул"
      134     bf_goods.prod-type   at row  6.25 col 18.00 colon-aligned view-as combo-box inner-lines 5 list-items "":U, 'орг':U, 'чел':U, 'скл':U, 'маг':U size-chars    6.00 by 1.00    label "Производитель"
      135     bf_goods.prod-code   at row  6.25 col 26.50          view-as fill-in    size-chars 10.50 by 1.00 no-label
      136       bf_cli.obj-name    at row  6.25 col 37.50          view-as fill-in    size-chars 62.00 by 1.00 no-label format "x(80)":U   fgcolor  4
      137     bf_goods.gds-name    at row  7.50 col 18.00 colon-aligned view-as fill-in    size-chars 61.50 by 1.00    label "Название"         fgcolor  4
      138     r-rect-2             at row  8.92 col  1.50
      139     v-label              at row  8.58 col 19.00          view-as fill-in    size-chars 60.25 by 1.00 no-label format "x(60)":U   fgcolor 15 bgcolor 3
      140     ub.c-pl-gds.fact-qnty   at row 10.00 col 18.00 colon-aligned view-as fill-in    size-chars 16.50 by 1.00    label "Факт"             fgcolor 12
      141     ub.c-pl-gds.free-qnty   at row 10.00 col 37.50          view-as fill-in    size-chars 16.50 by 1.00    label "Свободно"         fgcolor 12
      142     ub.c-pl-gds.tolerance   at row 10.00 col 58.00          view-as fill-in    size-chars 13.50 by 1.00                             fgcolor 12
      143     ub.c-pl-gds.cli-qnty    at row 11.25 col 18.00 colon-aligned view-as fill-in    size-chars 16.50 by 1.00                             fgcolor 12
      144     ub.c-pl-gds.max-qnty    at row 11.25 col 56.00          view-as fill-in    size-chars 16.50 by 1.00                             fgcolor 12
      145     "СВЕРКА:"            at row 13.25 col 11.50                                                               fgcolor 15 bgcolor 3
      146     ub.c-pl-gds.rvs-on      at row 13.25 col 20.50          view-as toggle-box size-chars  16.50 by 1.00    label "включена"
      147     ub.c-pl-gds.rvs-code    at row 13.25 col 40.50          view-as fill-in    size-chars 17.50 by 1.00    label "номер"
      148     ub.c-pl-gds.status_     at row 14.75 col 18.00 colon-aligned view-as fill-in    size-chars  9.50 by 1.00
      149     ub.c-pl-gds.PS          at row 16.25 col  1.50          view-as editor no-word-wrap scrollbar-horizontal scrollbar-vertical size-chars 98.25 by 3.50 format "x(512)":U                no-label                    bgcolor 15
      150       r-rect-0           at row 20.25 col  1.50
      151       Btn_Exit           at row 20.50 col  2.50
      152       Btn_OK             at row 20.50 col 78.00
      153     b-help          at row 20.50 col 88.75
      154   with view-as dialog-box side-labels no-underline three-d scrollable
      155        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      156   assign frame fr-D-pump-8 :scrollable = no.
      157   on choose of Btn_OK in frame fr-D-pump-8 do:
      158   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   if lookup(self :type
      160            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      161            ) = 0
      162   then do:
      163     message
      164       "$Workfile$"
      165       "Указанному интерфейсному элементу фокус не может быть передан" skip
      166       "Интерфейсный элемент" self :name  skip
      167       "Тип" self :type  skip
      168       "Процедура" this-procedure :file-name skip
      169       view-as alert-box .
      170   end.
      171   else do:
      172     apply "entry":u to self  .
      173     if focus :handle <> self :handle  then do:
      174       return no-apply .
      175     end.
      176   end.
      177     apply "GO":U to frame fr-D-pump-8.
      178   end.
      179   on choose of Btn_Exit in frame fr-D-pump-8 do:
      180   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   if lookup(self :type
      182            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      183            ) = 0
      184   then do:
      185     message
      186       "$Workfile$"
      187       "Указанному интерфейсному элементу фокус не может быть передан" skip
      188       "Интерфейсный элемент" self :name  skip
      189       "Тип" self :type  skip
      190       "Процедура" this-procedure :file-name skip
      191       view-as alert-box .
      192   end.
      193   else do:
      194     apply "entry":u to self  .
      195     if focus :handle <> self :handle  then do:
      196       return no-apply .
      197     end.
      198   end.
      199   end.
      200   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   on F1 of frame fr-D-pump-8 anywhere do:
      202     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-pump-8. END.
      203     return no-apply.
      204   end.
      205   if valid-handle( active-window ) and frame fr-D-pump-8 :parent = ? then frame fr-D-pump-8 :parent = active-window.
      206   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      207   on window-close of frame fr-D-pump-8 do: apply "END-ERROR":U to self. end.
      208   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   on help of frame fr-D-pump-8
      210   do:
      211     run gbl/app_help.p
      212       (input this-procedure :file-name
      213       ,input ''
      214       ,input ?
      215       ) no-error.
      216     if error-status :error then do:
      217       message
      218         "Ошибка при вызове помощи"
      219         error-status :get-message(1)
      220         view-as alert-box .
      221     end.
      222   end.
      223   run minbtn-set in this-procedure .
      224   on choose of b-help in frame fr-D-pump-8
      225   do:
      226     apply "help":u to frame fr-D-pump-8 .
      227   end.
      228   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   procedure minbtn-set :
      230       do
      231           on error undo, return error return-value
      232           :
      233           define variable ii              as integer       no-undo .
      234           define variable fh              as widget-handle no-undo .
      235           define variable hh              as widget-handle no-undo .
      236           define variable v-h             as handle        extent 4 no-undo .
      237           define variable v-name-button   as character     no-undo .
      238           define variable v-help-old-x    as decimal       no-undo .
      239           define variable v-help-old-y    as decimal       no-undo .
      240           define variable v-help-old-size as decimal       no-undo .
      241           define variable v-frame-width   as decimal       no-undo .
      242           define variable jj              as integer       no-undo .
      243           do
      244               on error undo, return error
      245               :
      246               assign
      247                   v-frame-width = frame fr-D-pump-8:width - 0.3
      248                   fh            = frame fr-D-pump-8:first-child
      249                   hh            = fh:first-child
      250                   ii            = 1
      251                   .
      252               do while valid-handle(hh):
      253                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      254                   do:
      255                       case lc(hh:name) :
      256                           when "b-help" then
      257                               do:
      258                                   hh:load-image-up("cmp/b-help.bmp":u) .
      259                                   hh:load-image-down("cmp/b-help.bmp":u) .
      260                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      261                                   hh:TOOLTIP = "Помощь" .
      262                                   v-help-old-x = hh:column .
      263                                   v-help-old-y = hh:row    .
      264                                   v-help-old-size = hh:width .
      265                                   hh:width-chars = 2.5 .
      266                               end.
      267                           when "b-print" then
      268                               do:
      269                                   hh:load-image("cmp/b-print.bmp":u) .
      270                                   hh:TOOLTIP = "Печать" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-history" or
      276                           when "b-hist" then
      277                               do:
      278                                   hh:load-image("cmp/b-hist.bmp":u) .
      279                                   hh:TOOLTIP = "История" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-sch" then
      285                               do:
      286                                   hh:load-image("cmp/b-sch.bmp":u) .
      287                                   hh:TOOLTIP = "Установка Фильтра" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-hist-user" then
      293                               do:
      294                                   hh:load-image("cmp/b-hist.bmp":u) .
      295                                   hh:TOOLTIP = "История пользователя" .
      296                                   ii = ii + 1 .
      297                               end.
      298                       end case.
      299                   end.
      300                   hh = hh:next-sibling.
      301               end.
      302               b-help:column = v-frame-width - b-help:width-chars.
      303               jj = 0.
      304               repeat ii = 4 to 1 by -1 :
      305                   if valid-handle (v-h[ii] ) then
      306                   do:
      307                       jj  = jj + 1 .
      308                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      309                       v-h[ii]:row    = v-help-old-y .
      310                   end.
      311               end.
      312           end.
      313       end.
      314   end procedure.
      315   Main-Block:
      316   do on error   undo Main-Block, leave Main-Block
      317      on end-key undo Main-Block, leave Main-Block :
      318     if p-mode <> 'ПРОСМОТР':U then do:
      319       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      320               "Неверное значение параметра вызова p-mode:" p-mode
      321       view-as alert-box error.
      322       undo Main-Block, return error.
      323     end.
      324     find ub.c-pl-gds no-lock where recid( ub.c-pl-gds ) = p-rec-id no-error.
      325     if not available ub.c-pl-gds then do:
      326       message "Карточка истории хранения товара на складском месте не найдена!" view-as alert-box error.
      327       undo Main-Block, leave Main-Block.
      328     end.
      329     find first bf_goods no-lock where bf_goods.gds-code = ub.c-pl-gds.gds-code no-error.
      330     find first bf_place no-lock where
      331                bf_place.obj-type = ub.c-pl-gds.obj-type and
      332                bf_place.obj-code = ub.c-pl-gds.obj-code and
      333                bf_place.pl-code  = ub.c-pl-gds.pl-code  no-error.
      334     find first bf_obj   no-lock where
      335                bf_obj.obj-type   = ub.c-pl-gds.obj-type and
      336                bf_obj.obj-code   = ub.c-pl-gds.obj-code no-error.
      337     find first bf_cli   no-lock where
      338                bf_cli.obj-type   = bf_goods.prod-type and
      339                bf_cli.obj-code   = bf_goods.prod-code no-error.
      340     assign frame fr-D-pump-8 :title = substitute(
      341       'Карточка изменения хранения товара &1 "&2" на складском месте &3 "&4" (объект &5 &6 "&7") -- &8',
      342       ub.c-pl-gds.gds-code,
      343       bf_goods.gds-name,
      344       ub.c-pl-gds.pl-code,
      345       bf_place.pl-name,
      346       ub.c-pl-gds.obj-type,
      347       ub.c-pl-gds.obj-code,
      348       bf_obj.obj-name,
      349       p-mode ).
      350     display ub.c-pl-gds.pl-code
      351             ub.c-pl-gds.gds-code
      352             ub.c-pl-gds.obj-type  when ub.c-pl-gds.obj-type <> ?
      353             ub.c-pl-gds.obj-code
      354             ub.c-pl-gds.status_
      355             ub.c-pl-gds.fact-qnty
      356             ub.c-pl-gds.free-qnty
      357             ub.c-pl-gds.tolerance
      358             ub.c-pl-gds.cli-qnty
      359             ub.c-pl-gds.max-qnty
      360             ub.c-pl-gds.rvs-on
      361             ub.c-pl-gds.rvs-code  when ub.c-pl-gds.rvs-on = yes and ub.c-pl-gds.rvs-code <> ?
      362             ub.c-pl-gds.PS
      363             v-header
      364             v-label
      365     with frame fr-D-pump-8.
      366     if ub.c-pl-gds.rvs-on <> yes then do: hide ub.c-pl-gds.rvs-code in frame fr-D-pump-8. end.
      367     if available bf_goods then do:
      368       display bf_goods.artic
      369               bf_goods.prod-type when bf_goods.prod-type <> ?
      370               bf_goods.prod-code
      371               bf_goods.gds-name
      372       with frame fr-D-pump-8.
      373     end.
      374     if available bf_cli   then do: display bf_cli.obj-name  with frame fr-D-pump-8. end.
      375     if available bf_obj   then do: display bf_obj.obj-name  with frame fr-D-pump-8. end.
      376     if available bf_place then do: display bf_place.pl-name with frame fr-D-pump-8. end.
      377     enable ub.c-pl-gds.PS Btn_Exit b-help with frame fr-D-pump-8.
      378     assign ub.c-pl-gds.PS :read-only in frame fr-D-pump-8 = yes.
      379     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-pump-8. end.
      380     wait-for go of frame fr-D-pump-8.
      381   end.
      382   hide frame fr-D-pump-8 no-pause.
