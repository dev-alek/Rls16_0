        1   using ibs.th.str.mercury.*.
        2   define input parameter vsdsubObj as class vsdsub.
        3   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
        4        LABEL "Выход"
        5        SIZE 15 BY 1.13
        6        BGCOLOR 8 .
        7   DEFINE QUERY BROWSE-2 FOR
        8         vsd-attr SCROLLING.
        9   DEFINE BROWSE BROWSE-2
       10     QUERY BROWSE-2 NO-LOCK DISPLAY
       11         vsd-attr.attr-code FORMAT "x(8)":U WIDTH 26
       12         vsd-attr.attr-value FORMAT "x(8)":U WIDTH 50.13
       13       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.5 BY 11.75 ROW-HEIGHT-CHARS .58 FIT-LAST-COLUMN.
       14   DEFINE FRAME Dialog-Frame
       15        Btn_Cancel AT ROW 1.38 COL 2
       16        BROWSE-2 AT ROW 3 COL 2 WIDGET-ID 200
       17        SPACE(0.49) SKIP(0.20)
       18       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       19            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       20            TITLE "Служебные"
       21            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       22   ASSIGN
       23          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       24          FRAME Dialog-Frame:HIDDEN           = TRUE.
       25   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       26   DO:
       27     APPLY "END-ERROR":U TO SELF.
       28   END.
       29   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       30   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       31   MAIN-BLOCK:
       32   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       33      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       34     RUN enable_UI.
       35     WAIT-FOR GO OF FRAME Dialog-Frame.
       36   END.
       37   RUN disable_UI.
       38   PROCEDURE disable_UI :
       39     HIDE FRAME Dialog-Frame.
       40   END PROCEDURE.
       41   PROCEDURE enable_UI :
       42     ENABLE Btn_Cancel BROWSE-2
       43         WITH FRAME Dialog-Frame.
       44     VIEW FRAME Dialog-Frame.
       45     OPEN QUERY BROWSE-2 FOR EACH vsd-attr       WHERE vsd-attr.db-num = vsdsubObj:DbNum  AND vsd-attr.ID = vsdsubObj:ID NO-LOCK INDEXED-REPOSITION.
       46   END PROCEDURE.
