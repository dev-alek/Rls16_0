        1   define shared temp-table tt-dens no-undo
        2     field ii as integer
        3     field key_ as character
        4     field density as decimal format "9.9999999999"
        5     index pi
        6       as primary unique
        7       ii
        8   .
        9   define input parameter p-sr-izm-type as integer no-undo .
       10   define input parameter p-place-type as integer no-undo .
       11   define input parameter p-diameter   as decimal no-undo .
       12   define input parameter p-fuel-level as decimal no-undo .
       13   define input-output parameter p-calc-type as integer no-undo .
       14   define output parameter p-avg-density as decimal no-undo .
       15   define output parameter p-ok as logical no-undo .
       16   define variable v-num-izm     as integer no-undo .
       17   define variable v-dens-sum   as decimal no-undo .
       18   procedure proc-alt-shift-f2:
       19     if not ibs.th.gbl.gbl-var:rcode
       20   then
       21     run gbl\inidebug.p .
       22   end.
       23   procedure proc-alt-shift-f3:
       24     run gbl/prvssinf.p
       25       ( input this-procedure
       26       ) .
       27   end.
       28   define variable v-inform-launched as logical no-undo initial false .
       29   procedure proc-alt-shift-f4:
       30     define variable v-action as character no-undo .
       31     if v-inform-launched = false then do:
       32       assign
       33         v-inform-launched = true
       34       .
       35       run gbl/d-inform.w
       36         (  input self
       37         ,  input this-procedure
       38         , output v-action
       39         ) no-error .
       40       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       41       assign
       42         v-inform-launched = false
       43       .
       44     end.
       45   end.
       46   procedure proc-alt-f1:
       47     run gbl/corrhelp.p
       48       (input this-procedure
       49       ) .
       50   end .
       51   on alt-shift-f2 anywhere do:
       52     run proc-alt-shift-f2.
       53   end.
       54   on alt-shift-f3 anywhere do:
       55     run proc-alt-shift-f3 in this-procedure .
       56   end.
       57   on alt-shift-f4 anywhere do:
       58     run proc-alt-shift-f4 in this-procedure.
       59   end.
       60   on alt-f1 anywhere do:
       61     run proc-alt-f1 in this-procedure .
       62   end.
       63   DEFINE BUTTON b-cancel AUTO-END-KEY
       64        LABEL "Отмена"
       65        SIZE 15 BY 1.14
       66        BGCOLOR 8 .
       67   DEFINE BUTTON b-ok AUTO-GO
       68        LABEL "Ввод"
       69        SIZE 15 BY 1.14
       70        BGCOLOR 8 .
       71   define variable v-calc-type-label as character init "Способ расчета средней p:" format "X(30)"
       72     view-as text
       73     size 25 by 1 no-undo .
       74   DEFINE VARIABLE cb-calc-type AS integer init 1
       75        LABEL ""
       76        VIEW-AS COMBO-BOX INNER-LINES 3
       77        LIST-ITEM-PAIRS "Расчет",1,
       78                        "Ввод среднего значения",2,
       79                        "Расчет по алгоритму СИ",3
       80        DROP-DOWN-LIST
       81        SIZE 27 BY 1 NO-UNDO.
       82   define variable v-calc-num-izm as integer
       83     label "Число точечных проб"
       84     view-as fill-in
       85     size 7 by 1 no-undo .
       86   define button b-fill-empty
       87       label "Заполнить пустые"
       88       size 18 by 1 .
       89   define query br-dens for tt-dens .
       90   define browse br-dens query br-dens exclusive-lock
       91     display
       92       tt-dens.key_        label "Уровень " format "X(8)"
       93       tt-dens.density     label "Значение,г/см3" format "9.9999"
       94     enable
       95       tt-dens.density
       96     with size 30 by 10 separators
       97   .
       98   DEFINE FRAME Dialog-Frame
       99        b-ok AT ROW 1.1 COL 2
      100        b-cancel AT ROW 1.1 COL 17
      101        v-calc-type-label at row 2.2 col 2 no-label
      102        cb-calc-type at row 3.2 col 2 no-label
      103        v-calc-num-izm at row 4.2 col 2
      104        br-dens at row 5.5 col 1
      105        b-fill-empty at row 16 col 2
      106        SPACE(1) SKIP(1)
      107       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      108            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      109            TITLE "Таблица измерений плотности"
      110            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      111   ASSIGN
      112          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      113          FRAME Dialog-Frame:HIDDEN           = TRUE.
      114   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      115   DO:
      116     APPLY "END-ERROR":U TO SELF.
      117   END.
      118   on choose of b-ok in frame Dialog-Frame
      119   do :
      120     define buffer buf_tt-dens for tt-dens .
      121     define buffer buf1_tt-dens for tt-dens .
      122     define buffer buf2_tt-dens for tt-dens .
      123     define buffer buf3_tt-dens for tt-dens .
      124     for first tt-dens no-lock where tt-dens.density = 0
      125                                  or tt-dens.density = ?
      126                                  :
      127       message "Необходимо заполнить значения на всех уровнях!" view-as alert-box .
      128       return no-apply .
      129     end .
      130     case p-place-type :
      131       when 1
      132       then do :
      133         case p-sr-izm-type :
      134           when 0
      135           then do :
      136             v-dens-sum = 0 .
      137             for each buf_tt-dens :
      138               v-dens-sum = v-dens-sum + buf_tt-dens.density .
      139             end .
      140             if cb-calc-type = 3
      141             then do :
      142               p-avg-density = v-dens-sum / v-calc-num-izm .
      143             end .
      144             else do :
      145               p-avg-density = v-dens-sum / v-num-izm .
      146             end .
      147           end .
      148           when 1
      149           then do :
      150             find first buf1_tt-dens where buf1_tt-dens.ii = 1 .
      151             find first buf2_tt-dens where buf2_tt-dens.ii = 2 no-error .
      152             find first buf3_tt-dens where buf3_tt-dens.ii = 3 no-error .
      153             p-avg-density = buf1_tt-dens.density .
      154             if available buf2_tt-dens
      155             and not available buf3_tt-dens
      156             then
      157               p-avg-density = (buf1_tt-dens.density + buf2_tt-dens.density) / 2 .
      158             if available buf2_tt-dens
      159             and available buf3_tt-dens
      160             then
      161               p-avg-density = (buf1_tt-dens.density + (3 * buf2_tt-dens.density) + buf3_tt-dens.density) / 5 .
      162           end .
      163         end case .
      164       end .
      165       when 2
      166       then do :
      167         case p-sr-izm-type :
      168           when 0
      169           then do :
      170             v-dens-sum = 0 .
      171             for each buf_tt-dens :
      172               v-dens-sum = v-dens-sum + buf_tt-dens.density .
      173             end .
      174             p-avg-density = v-dens-sum / v-num-izm .
      175           end .
      176           when 1
      177           then do :
      178             find first buf1_tt-dens where buf1_tt-dens.ii = 1 .
      179             find first buf2_tt-dens where buf2_tt-dens.ii = 2 no-error .
      180             find first buf3_tt-dens where buf3_tt-dens.ii = 3 no-error .
      181             p-avg-density = buf1_tt-dens.density .
      182             if available buf2_tt-dens
      183             and not available buf3_tt-dens
      184             then
      185               p-avg-density = (buf1_tt-dens.density + (3 * buf2_tt-dens.density)) / 4 .
      186             if available buf2_tt-dens
      187             and available buf3_tt-dens
      188             then
      189               p-avg-density = (buf1_tt-dens.density + (6 * buf2_tt-dens.density) + buf3_tt-dens.density) / 8 .
      190           end .
      191         end case .
      192       end .
      193     end case .
      194     p-calc-type = cb-calc-type .
      195     p-ok = true .
      196   end .
      197   on value-changed of cb-calc-type in frame Dialog-Frame
      198   do :
      199     assign cb-calc-type .
      200     empty temp-table tt-dens .
      201     if cb-calc-type = 3
      202     then do :
      203       enable v-calc-num-izm with FRAME Dialog-Frame.
      204     end .
      205     else do :
      206       hide v-calc-num-izm in FRAME Dialog-Frame.
      207     end .
      208     run fill-tt .
      209     open query br-dens for each tt-dens .
      210   end .
      211   on return of v-calc-num-izm in frame Dialog-Frame
      212   do :
      213     apply "leave" to self .
      214   end .
      215   on leave of v-calc-num-izm in frame Dialog-Frame
      216   do :
      217     if input frame Dialog-Frame v-calc-num-izm <> v-calc-num-izm
      218     then do :
      219       assign v-calc-num-izm .
      220       empty temp-table tt-dens .
      221       run fill-tt .
      222       open query br-dens for each tt-dens .
      223     end .
      224   end .
      225   on return of tt-dens.density in browse br-dens
      226   do :
      227     apply "leave" to self .
      228   end .
      229   on leave of tt-dens.density in browse br-dens
      230   do :
      231     define variable is-empty as logical no-undo .
      232     define buffer buf_tt-dens for tt-dens .
      233     if decimal(tt-dens.density:screen-value in browse br-dens) >= 1
      234     then do :
      235       message "Неверное значение плотности!" view-as alert-box .
      236       return no-apply .
      237     end .
      238     assign tt-dens.density = decimal(tt-dens.density:screen-value in browse br-dens) .
      239   end .
      240   on choose of b-fill-empty in frame Dialog-Frame
      241   do :
      242     define buffer buf_tt-dens for tt-dens .
      243     if available tt-dens
      244     and tt-dens.density > 0
      245     then do :
      246       for each buf_tt-dens :
      247         if buf_tt-dens.density = ?
      248         or buf_tt-dens.density = 0
      249         then do :
      250           buf_tt-dens.density = tt-dens.density .
      251         end .
      252       end .
      253       br-dens:refresh() in frame Dialog-Frame .
      254     end .
      255   end .
      256   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      257   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      258   MAIN-BLOCK:
      259   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      260      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      261     define variable jj as integer no-undo .
      262     p-ok = false .
      263     cb-calc-type = p-calc-type .
      264     if cb-calc-type = 3
      265     and p-place-type = 1
      266     then do :
      267       jj = 0 .
      268       for each tt-dens :
      269         jj = jj + 1 .
      270       end .
      271       v-calc-num-izm = jj .
      272     end .
      273     run fill-tt .
      274     RUN enable_UI.
      275     WAIT-FOR GO OF FRAME Dialog-Frame.
      276   END.
      277   RUN disable_UI.
      278   procedure fill-tt :
      279     define variable ii as integer no-undo .
      280     case p-place-type :
      281       when 1
      282       then do :
      283         case p-sr-izm-type :
      284           when 0
      285           then do :
      286             find first tt-dens where tt-dens.key_ = "Pн" no-error .
      287             if available tt-dens
      288             then do :
      289               empty temp-table tt-dens .
      290             end .
      291             if cb-calc-type = 1
      292             then do :
      293               if p-fuel-level > 5000
      294               then do :
      295                 v-num-izm = integer(truncate((p-fuel-level / 1000), 0)) .
      296               end .
      297               else do :
      298                 v-num-izm = integer(truncate((p-fuel-level / 500), 0)) .
      299               end .
      300               if v-num-izm = 0 then v-num-izm = 1 .
      301               find first tt-dens no-error .
      302               if not available tt-dens
      303               then do ii = 1 to v-num-izm :
      304                 create tt-dens .
      305                 assign
      306                   tt-dens.ii = ii
      307                   tt-dens.key_ = "P" + string(ii) + (if ii = 1 then "(низ)" else "")
      308                 .
      309               end .
      310             end .
      311             if cb-calc-type = 2
      312             then do :
      313               v-num-izm = 1 .
      314               find first tt-dens no-error .
      315               if not available tt-dens
      316               then do :
      317                 create tt-dens .
      318                 assign
      319                   tt-dens.ii = 1
      320                   tt-dens.key_ = "P1(низ)"
      321                 .
      322               end .
      323             end .
      324             if cb-calc-type = 3
      325             then do :
      326               find first tt-dens no-error .
      327               if not available tt-dens
      328               then do ii = 1 to v-calc-num-izm :
      329                 create tt-dens .
      330                 assign
      331                   tt-dens.ii = ii
      332                   tt-dens.key_ = "P" + string(ii) + (if ii = 1 then "(низ)" else "")
      333                 .
      334               end .
      335             end .
      336           end .
      337           when 1
      338           then do :
      339             find first tt-dens where tt-dens.key_ begins "P1" no-error .
      340             if available tt-dens
      341             then do :
      342               empty temp-table tt-dens .
      343             end .
      344             find first tt-dens no-error .
      345             if not available tt-dens
      346             then do :
      347               create tt-dens .
      348               assign
      349                 tt-dens.ii = 1
      350                 tt-dens.key_ = "Pн"
      351               .
      352               if p-fuel-level > 1000
      353               then do :
      354                 create tt-dens .
      355                 assign
      356                   tt-dens.ii = 2
      357                   tt-dens.key_ = "Pв"
      358                 .
      359               end .
      360               if p-fuel-level > 2000
      361               then do :
      362                 tt-dens.key_ = "Pср" .
      363                 create tt-dens .
      364                 assign
      365                   tt-dens.ii = 3
      366                   tt-dens.key_ = "Pв"
      367                 .
      368               end .
      369             end .
      370           end .
      371         end case .
      372       end .
      373       when 2
      374       then do :
      375         case p-sr-izm-type :
      376           when 0
      377           then do :
      378             v-num-izm = integer(truncate((p-fuel-level / 500), 0)) .
      379             if v-num-izm = 0 then v-num-izm = 1 .
      380             find first tt-dens where tt-dens.key_ = "Pн" no-error .
      381             if available tt-dens
      382             then do :
      383               empty temp-table tt-dens .
      384             end .
      385             find first tt-dens no-error .
      386             if not available tt-dens
      387             then do ii = 1 to v-num-izm :
      388               create tt-dens .
      389               assign
      390                 tt-dens.ii = ii
      391                 tt-dens.key_ = "P" + string(ii) + (if ii = 1 then "(низ)" else "")
      392               .
      393             end .
      394           end .
      395           when 1
      396           then do :
      397             find first tt-dens where tt-dens.key_ begins "P1" no-error .
      398             if available tt-dens
      399             then do :
      400               empty temp-table tt-dens .
      401             end .
      402             find first tt-dens no-error .
      403             if not available tt-dens
      404             then do :
      405               create tt-dens .
      406               assign
      407                 tt-dens.ii = 1
      408                 tt-dens.key_ = "Pн"
      409               .
      410               if (p-diameter >= 2500 and p-fuel-level >= (p-diameter / 2))
      411               or (p-diameter < 2500 and p-fuel-level >= 500)
      412               or (p-fuel-level >= 500 and p-fuel-level <= (p-diameter / 2))
      413               then do :
      414                 create tt-dens .
      415                 assign
      416                   tt-dens.ii = 2
      417                   tt-dens.key_ = "Pср"
      418                 .
      419               end .
      420               if (p-diameter >= 2500 and p-fuel-level >= (p-diameter / 2))
      421               then do :
      422                 create tt-dens .
      423                 assign
      424                   tt-dens.ii = 3
      425                   tt-dens.key_ = "Pв"
      426                 .
      427               end .
      428             end .
      429           end .
      430         end case .
      431       end .
      432     end case .
      433   end procedure .
      434   PROCEDURE disable_UI :
      435     HIDE FRAME Dialog-Frame.
      436   END PROCEDURE.
      437   PROCEDURE enable_UI :
      438     ENABLE b-ok b-cancel br-dens b-fill-empty
      439         WITH FRAME Dialog-Frame.
      440     VIEW FRAME Dialog-Frame.
      441     if p-place-type = 1
      442     and p-sr-izm-type = 0
      443     then do :
      444       display v-calc-type-label cb-calc-type with FRAME Dialog-Frame.
      445       enable cb-calc-type with FRAME Dialog-Frame.
      446       if cb-calc-type = 3
      447       then do :
      448         display v-calc-num-izm with FRAME Dialog-Frame.
      449         enable v-calc-num-izm with FRAME Dialog-Frame.
      450       end .
      451       else do :
      452         hide v-calc-num-izm in FRAME Dialog-Frame.
      453       end .
      454     end .
      455     else do :
      456       br-dens:row = 2.4 .
      457       b-fill-empty:row = 12.9 .
      458       hide
      459         v-calc-type-label
      460         cb-calc-type
      461         v-calc-num-izm
      462       in FRAME Dialog-Frame.
      463     end .
      464     open query br-dens for each tt-dens .
      465   END PROCEDURE.
