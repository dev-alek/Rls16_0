      528   procedure prn-lib-reportviewer :
      529     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      530     define input parameter p-report-name-html as character no-undo .
      531     define input parameter p-param        as character no-undo .
      532     define variable v-excel           as character no-undo init 'TRUE' .
      533     define variable v-value-character as character no-undo .
      534     define variable v-value-integer   as character no-undo .
      535     define variable v-value-date      as date      no-undo .
      536     define variable v-value-decimal   as decimal   no-undo .
      537     define variable rep-excel         as logical   no-undo .
      538     define variable excel-string      as character no-undo .
      539     define variable v-param-type      as character no-undo .
      540     define variable v-tth             as handle    no-undo .
      541     run adm/shattri.p (
      542       input "get":U
      543       ,input  ""
      544       ,input  0
      545       ,input  'report-glob':U
      546       ,input  'rep-excel':U
      547       ,output v-value-character
      548       ,output v-value-date
      549       ,output v-value-decimal
      550       ,output v-value-integer
      551       ,output rep-excel
      552       ,output v-param-type
      553       ,INPUT-OUTPUT table-handle v-tth
      554       )  .
      555     if rep-excel then v-excel = "TRUE" .
      556     else v-excel = "FALSE" .
      557     if p-param eq ""
      558     then
      559        p-param = "EXCEL:" + v-excel.
      560     else
      561        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      562     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      563   end procedure.
      564   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure cur-time :
      566      define output parameter p-today as date      no-undo .
      567      define output parameter p-time  as integer   no-undo .
      568     do
      569     on error undo, return error
      570     :
      571       define variable v-date1 as date      no-undo .
      572       define variable v-date2 as date      no-undo .
      573       define variable v-time  as integer   no-undo .
      574       assign
      575         v-date1 = today
      576         v-time  = time
      577         v-date2 = today
      578       .
      579       if v-date1 <> v-date2
      580       then do:
      581         assign
      582           v-date1 = today
      583           v-time  = v-time
      584         .
      585       end.
      586       assign
      587         p-today = v-date1
      588         p-time  = v-time
      589       .
      590     end.
      591   end.
      592   function cur-time-date returns character
      593   :
      594     return string(today, '99/99/9999':U) .
      595   end.
      596   function cur-time-mjd returns decimal
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return integer(v-date) - 2400002 + (v-time / 86400) .
      605   end.
      606   function cur-time-get-ending-index returns integer
      607   (input p-number as integer
      608   )
      609   :
      610     if p-number < 0
      611     or p-number = ?
      612     then do:
      613       return 1 .
      614     end.
      615     define variable v-rest as integer   no-undo .
      616     assign
      617       p-number = p-number modulo 100
      618     .
      619     if p-number < 20
      620     then do:
      621       assign
      622         v-rest = p-number
      623       .
      624     end.
      625     else do:
      626       assign
      627         v-rest = p-number modulo 10
      628       .
      629     end.
      630     case v-rest :
      631       when 1
      632       then do:
      633         return 2 .
      634       end.
      635       when 2 or
      636       when 3 or
      637       when 4
      638       then do:
      639         return 3 .
      640       end.
      641       otherwise do:
      642         return 1 .
      643       end.
      644     end case .
      645   end.
      646   procedure cur-time-mjd-to-date :
      647      define input  parameter i-mjd-diff as decimal no-undo.
      648      define output parameter o-Date     as date    no-undo.
      649      define output parameter o-Time     as integer no-undo.
      650      define variable v-day-number as integer   no-undo .
      651      if    i-mjd-diff < 0
      652         or i-mjd-diff = ?
      653      then do:
      654         return "?" .
      655      end.
      656      assign
      657         v-day-number = truncate(i-mjd-diff,0).
      658         o-Date = date(v-day-number + 2400002).
      659         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      660     .
      661   end.
      662   function cur-time-mjd-to-string returns character
      663   (input p-mjd-diff as decimal
      664   )
      665   :
      666     define variable v-day-number as integer   no-undo .
      667     define variable v-seconds    as integer   no-undo .
      668     define variable v-hour       as integer   no-undo .
      669     define variable v-min        as integer   no-undo .
      670     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      671     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      672     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      673     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      674     if p-mjd-diff < 0
      675     or p-mjd-diff = ?
      676     then do:
      677       return "?" .
      678     end.
      679     assign
      680       v-day-number = integer(truncate(p-mjd-diff,0))
      681       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      682     .
      683     if v-seconds > 86400
      684     then do:
      685       assign
      686         v-seconds = 86400 - 1
      687       .
      688     end.
      689     if v-seconds < 0
      690     then do:
      691       assign
      692         v-seconds = 0
      693       .
      694     end.
      695     assign
      696       v-hour = truncate(v-seconds / 3600, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 3600
      700     .
      701     assign
      702       v-min = truncate(v-seconds / 60, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 60
      706     .
      707     return
      708         (if v-day-number <> 0
      709           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0
      713           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      714           else ""
      715         )
      716       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      717           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      718           else ""
      719         )
      720       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      721       .
      722   end.
      723   function cur-time-string returns character
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      732   end.
      733   function cur-time-string-sec returns character
      734   :
      735     define variable v-date as date      no-undo .
      736     define variable v-time as integer   no-undo .
      737     run cur-time in this-procedure
      738       (output v-date
      739       ,output v-time
      740       ) .
      741     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      742   end.
      743   function cur-time-custom  returns character
      744   (input p-prefix as character
      745   ,input p-date-format as character
      746   ,input p-delimiter as character
      747   ,input p-time-format as character
      748   ,input p-suffix as character
      749   )
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return
      758       p-prefix
      759       + string(v-date, p-date-format)
      760       + p-delimiter
      761       + string(v-time, p-time-format)
      762       + p-suffix
      763       .
      764   end.
      765   function cur-time-print  returns character
      766   :
      767     define variable v-date as date      no-undo .
      768     define variable v-time as integer   no-undo .
      769     run cur-time in this-procedure
      770       (output v-date
      771       ,output v-time
      772       ) .
      773     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      774   end.
      775   function cur-time-datetime returns datetime
      776   :
      777     define variable v-char as character no-undo .
      778     define variable v-datetime as datetime no-undo .
      779     v-char = cur-time-string().
      780     v-datetime = datetime(v-char).
      781     return  v-datetime.
      782   end.
      783   function cur-time-string-msec returns character
      784   :
      785     define variable v-date as datetime  no-undo .
      786     v-date = now.
      787     return string(v-date) .
      788   end.
      789   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   function usrfulnf returns character ( input p-user-id as character):
      791   define variable v-user-name as character no-undo .
      792   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      794     (input  p-user-id
      795     ,output v-user-name
      796     ) no-error .
      797   if error-status:error
      798   or v-user-name = ""
      799   then do:
      800     return p-user-id.
      801   end.
      802   else do:
      803     return v-user-name.
      804   end.
      805   end function.
      806   define variable v-doc-rec as recid no-undo.
      807   define variable sort-column-name as character no-undo .
      808   define variable v-db-num LIKE ub.db.db-num no-undo.
      809   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   define  temp-table temp-changes no-undo
      811   field f_name as character
      812   field l_name as character
      813   field v_old as character
      814   field v_new as character
      815   field t_name as character
      816   field num_ as integer
      817   field uniq-key-rec as character
      818   field action as integer
      819   field fNotChange as logical
      820   index pi is unique primary
      821   num_
      822   t_name
      823   f_name
      824   index
      825   Chan
      826   fnotChange
      827   t_name
      828   f_name
      829   index imain uniq-key-rec
      830   .
      831   FUNCTION get-all-fields returns character (p-file-name as character ):
      832   define variable v-dop as character no-undo .
      833     find first _file no-lock where _file._file-name = p-file-name no-error .
      834     if not available _file then return "":U.
      835     for each _field no-lock where
      836              _field._file-recid = recid(_file) :
      837       assign
      838       v-dop = v-dop + _field._field-name + chr(44)
      839       .
      840     end.
      841     return trim(v-dop).
      842   END FUNCTION.
      843   PROCEDURE proc-full-temp-changes :
      844     define input  parameter p-hst-handle as handle    no-undo .
      845     define input  parameter p-main-table as character no-undo .
      846     define input  parameter p-field-list as character no-undo .
      847     define input  parameter p-label-form as character no-undo .
      848     define variable h-new-buf         as handle    no-undo .
      849     define variable h-main-buf        as handle    no-undo .
      850     define variable h-for-comp        as handle    no-undo .
      851     define variable v-inform          as character no-undo .
      852     define variable v-ind             as integer   no-undo .
      853     define variable v-idx-field-qnty  as integer   no-undo .
      854     define variable v-num-entries     as integer   no-undo .
      855     define variable fh                as handle    no-undo .
      856     define variable fh-main           as handle    no-undo .
      857     define variable fh-old            as handle    no-undo .
      858     define variable fh-new            as handle    no-undo .
      859     define variable v-field-name      as character no-undo .
      860     define variable v-field-lvl       as character no-undo .
      861     define variable v-field-form      as character no-undo .
      862     define variable v-search-exp      as character no-undo .
      863     define variable v-srch-main       as character no-undo .
      864     define variable v-word-link       as character no-undo .
      865     define variable v-av-chip-num     as logical   no-undo .
      866     define variable v-main-pi-fld-lst as character no-undo .
      867     define variable v-main-fld-lst    as character no-undo .
      868     define variable v-delim-list      as character no-undo .
      869     define variable v-label           as character no-undo .
      870     define variable v-old-value       as character no-undo case-sensitive.
      871     define variable v-new-value       as character no-undo case-sensitive.
      872     define variable v-chg-fields as character no-undo.
      873     for each temp-changes:
      874       delete temp-changes.
      875     end.
      876     if not p-hst-handle:available then do:
      877       return .
      878     end.
      879     create buffer h-new-buf  for table p-hst-handle .
      880     create buffer h-main-buf for table p-main-table .
      881     assign
      882       v-inform = h-main-buf:index-information(1)
      883       v-ind    = 2
      884     .
      885     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      886     on error undo, return error
      887     :
      888       assign
      889         v-inform = h-main-buf:index-information( v-ind )
      890         v-ind    = v-ind + 1
      891       .
      892     end.
      893     if v-inform = ?
      894       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      895       or entry( 3, v-inform, ",":U ) <> "1":U
      896     then do:
      897       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      898     end.
      899     assign
      900       v-idx-field-qnty = num-entries( v-inform ) - 4
      901     .
      902     if v-idx-field-qnty < 2 then do:
      903       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      904     end.
      905     assign
      906       v-srch-main   = "where":U
      907       v-word-link   = "":U
      908       v-av-chip-num = false
      909       v-delim-list  = "":U
      910     .
      911     do v-ind = 1 to v-idx-field-qnty by 2
      912     on error undo, return error
      913     :
      914       assign
      915         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      916         fh                = p-hst-handle:buffer-field( v-field-name )
      917         fh-main           = h-main-buf:buffer-field( v-field-name )
      918         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      919         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      920       .
      921       if fh:data-type ="character":U then do:
      922         assign
      923           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      924         .
      925       end.
      926       else do:
      927         assign
      928           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      929         .
      930       end.
      931       if v-delim-list = "":U then do:
      932         assign
      933           v-delim-list = ",":U
      934         .
      935       end.
      936       if v-word-link = "":U then do:
      937         assign
      938           v-word-link = "and":U
      939         .
      940       end.
      941     end.
      942     assign
      943       v-delim-list  = "":U
      944     .
      945     do v-ind = 1 to h-main-buf:num-fields
      946     on error undo, return error
      947     :
      948       assign
      949         fh-main      = h-main-buf:buffer-field( v-ind )
      950         v-field-name = fh-main:name
      951       .
      952         assign
      953           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      954         .
      955         if v-delim-list = "":U then do:
      956           assign
      957             v-delim-list = ",":U
      958           .
      959         end.
      960     end.
      961     assign
      962       v-inform = p-hst-handle:index-information(1)
      963       v-ind    = 2
      964     .
      965     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      966     on error undo, return error
      967     :
      968       assign
      969         v-inform = p-hst-handle:index-information( v-ind )
      970         v-ind    = v-ind + 1
      971       .
      972     end.
      973     if v-inform = ?
      974       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      975       or entry( 3, v-inform, ",":U ) <> "1":U
      976     then do:
      977       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      978     end.
      979     assign
      980       v-idx-field-qnty = num-entries( v-inform ) - 4
      981     .
      982     if v-idx-field-qnty < 2 then do:
      983       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      984     end.
      985     assign
      986       v-search-exp  = "where":U
      987       v-word-link   = "":U
      988       v-av-chip-num = false
      989     .
      990     do v-ind = 1 to v-idx-field-qnty by 2
      991     on error undo, return error
      992     :
      993       assign
      994         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      995         fh           = p-hst-handle:buffer-field( v-field-name )
      996         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      997       .
      998       if v-field-name = "chip-num":U then do:
      999         assign
     1000           v-search-exp  = substitute( "&1 >", v-search-exp )
     1001           v-av-chip-num = true
     1002         .
     1003       end.
     1004       else do:
     1005         assign
     1006           v-search-exp = substitute( "&1 =", v-search-exp )
     1007         .
     1008       end.
     1009       if fh:data-type ="character":U then do:
     1010         assign
     1011           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1012         .
     1013       end.
     1014       else do:
     1015         assign
     1016           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1017         .
     1018       end.
     1019       if v-word-link = "":U then do:
     1020         assign
     1021           v-word-link = "and":U
     1022         .
     1023       end.
     1024     end.
     1025     if v-av-chip-num = false then do:
     1026       message
     1027         vss-workfile vss-revision vss-description skip
     1028         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1029         "Использование данной процедуры невозможно!" skip
     1030         view-as alert-box error .
     1031       return error .
     1032     end.
     1033     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1034     if not h-new-buf:available then do:
     1035       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1036       if not h-main-buf:available then do:
     1037         assign
     1038           h-for-comp = ?
     1039         .
     1040       end.
     1041       else do:
     1042         assign
     1043           h-for-comp = h-main-buf
     1044         .
     1045       end.
     1046     end.
     1047     else do:
     1048       assign
     1049         h-for-comp = h-new-buf
     1050       .
     1051     end.
     1052     assign
     1053       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1054     .
     1055     do v-ind = 1 to v-num-entries
     1056     on error undo, return error return-value
     1057     :
     1058       assign
     1059         v-field-name = entry( v-ind, v-main-fld-lst )
     1060         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1061         v-old-value  = fh-old:buffer-value()
     1062         v-label      = trim( fh-old:label )
     1063       .
     1064       if ( trim( p-field-list ) <> "":U
     1065            and lookup( v-field-name, p-field-list ) > 0
     1066          )
     1067          or trim( p-field-list ) = "":U
     1068       then do:
     1069         if h-for-comp <> ? then do:
     1070           assign
     1071             fh-new      = h-for-comp:buffer-field( v-field-name )
     1072             v-new-value = fh-new:buffer-value()
     1073           .
     1074         end.
     1075         else do:
     1076           assign
     1077             v-new-value = "":U
     1078           .
     1079         end.
     1080         if v-old-value <> v-new-value
     1081         then do:
     1082           create temp-changes.
     1083           assign
     1084             temp-changes.t_name = p-main-table
     1085             temp-changes.f_name = v-field-name
     1086             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1087             temp-changes.v_old  = trim( v-old-value )
     1088             temp-changes.v_new  = trim( v-new-value )
     1089             temp-changes.num_   = 0
     1090             temp-changes.fNotChange = v-old-value eq v-new-value
     1091           .
     1092         end.
     1093       end.
     1094     end.
     1095     assign
     1096       v-num-entries = num-entries( p-label-form, chr(8) )
     1097     .
     1098     do v-ind = 1 to v-num-entries
     1099     on error undo, return error return-value
     1100     :
     1101       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1102         assign
     1103           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1104           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1105           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1106         .
     1107         find first temp-changes
     1108           where temp-changes.f_name = v-field-name
     1109           no-error .
     1110         if available temp-changes then do:
     1111           if trim( v-field-lvl ) <> "":U then do:
     1112             assign
     1113               temp-changes.l_name = v-field-lvl
     1114             .
     1115           end.
     1116           if trim( v-field-form ) <> "":U then do:
     1117             assign
     1118               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1119             .
     1120             if h-for-comp <> ? then do:
     1121               assign
     1122                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1123               .
     1124             end.
     1125           end.
     1126         end.
     1127       end.
     1128       else do:
     1129         message
     1130           vss-workfile vss-revision vss-description skip
     1131           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1132           substitute( "список для поля '&1': '&2'"
     1133                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1134                       ,entry( v-ind, p-label-form, chr(8) )
     1135                     ) skip
     1136           substitute( "полный список: &2", p-label-form ) skip
     1137           view-as alert-box error .
     1138       end.
     1139     end.
     1140     delete object h-new-buf .
     1141     delete object h-main-buf .
     1142   END PROCEDURE.
     1143   FUNCTION mark-string RETURNS CHARACTER
     1144     ( BUFFER loc-c-assortment-matrix FOR c-assortment-matrix, input mark-list as character )  FORWARD.
     1145   DEFINE BUTTON B-Help
     1146        LABEL "Помо&щь"
     1147        SIZE 10 BY 1
     1148        BGCOLOR 8 .
     1149   DEFINE BUTTON B-lookup
     1150        LABEL "&Просмотр"
     1151        SIZE 1 BY 1.
     1152   DEFINE BUTTON B-mark
     1153        LABEL "&Просмотр"
     1154        SIZE 1 BY 1.
     1155   DEFINE BUTTON b-quit AUTO-END-KEY
     1156        LABEL "&Выход"
     1157        SIZE 10 BY 1
     1158        BGCOLOR 8 .
     1159   DEFINE BUTTON B-sel
     1160        LABEL "&Просмотр"
     1161        SIZE 1 BY 1.
     1162   DEFINE QUERY BR-changes FOR
     1163         temp-changes SCROLLING.
     1164   DEFINE QUERY br-condkeep FOR
     1165         x_c-assortment-matrix SCROLLING.
     1166   DEFINE BROWSE BR-changes
     1167     QUERY BR-changes DISPLAY
     1168         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(15)"
     1169   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
     1170   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
     1171       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.54.
     1172   DEFINE BROWSE br-condkeep
     1173     QUERY br-condkeep NO-LOCK DISPLAY
     1174         x_c-assortment-matrix.asmt-name
     1175         x_c-assortment-matrix.asmt-type
     1176         x_c-assortment-matrix.obj-type
     1177         x_c-assortment-matrix.obj-code
     1178         x_c-assortment-matrix.asmt-date-update COLUMN-LABEL "Дата посл.!изменения" FORMAT "99/99/99":U
     1179               WIDTH 11
     1180         string(x_c-assortment-matrix.asmt-time-update, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1181         x_c-assortment-matrix.asmt-db-num-update COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
     1182               WIDTH 3
     1183         x_c-assortment-matrix.asmt-who-update COLUMN-LABEL "Кто!изменил" FORMAT "X(8)":U
     1184         usrfulnf(x_c-assortment-matrix.asmt-who-update) COLUMN-LABEL "Кто изменил!ФИО" FORMAT "X(18)":U
     1185         x_c-assortment-matrix.casm-date-his COLUMN-LABEL "Создание!истории" FORMAT "99/99/99":U
     1186               WIDTH 11
     1187         string(x_c-assortment-matrix.casm-time-his, "HH:MM") COLUMN-LABEL "Время!созд" FORMAT "x(5)":U
     1188         x_c-assortment-matrix.corr-user-db-num COLUMN-LABEL "БД!соз" FORMAT ">>>>9":U
     1189               WIDTH 3
     1190         x_c-assortment-matrix.corr-user-name COLUMN-LABEL "Кто!создал" FORMAT "X(8)":U
     1191         usrfulnf(x_c-assortment-matrix.corr-user-name) COLUMN-LABEL "Кто создал!ФИО" FORMAT "X(18)":U
     1192       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10 ROW-HEIGHT-CHARS .75 EXPANDABLE.
     1193   DEFINE FRAME Dialog-Frame
     1194        b-quit AT ROW 1 COL 1
     1195        B-lookup AT ROW 1 COL 20.5
     1196        B-sel AT ROW 1 COL 21.5
     1197        B-mark AT ROW 1 COL 22.5
     1198        B-Help AT ROW 1 COL 89
     1199        br-condkeep AT ROW 2.25 COL 1
     1200        BR-changes AT ROW 12.5 COL 1
     1201        SPACE(0.12) SKIP(0.00)
     1202       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1203            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1204            TITLE "История ассортиментной матрицы"
     1205            CANCEL-BUTTON b-quit.
     1206   ASSIGN
     1207          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1208          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1209   ASSIGN
     1210          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1211   ASSIGN
     1212          B-mark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1213   ASSIGN
     1214          B-sel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1215   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1216   DO:
     1217     APPLY "END-ERROR":U TO SELF.
     1218   END.
     1219   ON RETURN OF br-condkeep IN FRAME Dialog-Frame
     1220   or MOUSE-SELECT-DBLCLICK OF br-condkeep IN FRAME Dialog-Frame
     1221       DO:
     1222       run proc-br-condkeep in this-procedure no-error.
     1223     if error-status:error then return no-apply.
     1224   END.
     1225   ON VALUE-CHANGED OF br-condkeep IN FRAME Dialog-Frame
     1226   DO:
     1227     run proc-view-changes in this-procedure no-error.
     1228   END.
     1229   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1230   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1231   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1232   on help of frame Dialog-Frame
     1233   do:
     1234     run gbl/app_help.p
     1235       (input this-procedure :file-name
     1236       ,input ''
     1237       ,input ?
     1238       ) no-error.
     1239     if error-status :error then do:
     1240       message
     1241         "Ошибка при вызове помощи"
     1242         error-status :get-message(1)
     1243         view-as alert-box .
     1244     end.
     1245   end.
     1246   run minbtn-set in this-procedure .
     1247   on choose of b-help in frame Dialog-Frame
     1248   do:
     1249     apply "help":u to frame Dialog-Frame .
     1250   end.
     1251   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   procedure minbtn-set :
     1253       do
     1254           on error undo, return error return-value
     1255           :
     1256           define variable ii              as integer       no-undo .
     1257           define variable fh              as widget-handle no-undo .
     1258           define variable hh              as widget-handle no-undo .
     1259           define variable v-h             as handle        extent 4 no-undo .
     1260           define variable v-name-button   as character     no-undo .
     1261           define variable v-help-old-x    as decimal       no-undo .
     1262           define variable v-help-old-y    as decimal       no-undo .
     1263           define variable v-help-old-size as decimal       no-undo .
     1264           define variable v-frame-width   as decimal       no-undo .
     1265           define variable jj              as integer       no-undo .
     1266           do
     1267               on error undo, return error
     1268               :
     1269               assign
     1270                   v-frame-width = frame Dialog-Frame:width - 0.3
     1271                   fh            = frame Dialog-Frame:first-child
     1272                   hh            = fh:first-child
     1273                   ii            = 1
     1274                   .
     1275               do while valid-handle(hh):
     1276                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1277                   do:
     1278                       case lc(hh:name) :
     1279                           when "b-help" then
     1280                               do:
     1281                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1282                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1283                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1284                                   hh:TOOLTIP = "Помощь" .
     1285                                   v-help-old-x = hh:column .
     1286                                   v-help-old-y = hh:row    .
     1287                                   v-help-old-size = hh:width .
     1288                                   hh:width-chars = 2.5 .
     1289                               end.
     1290                           when "b-print" then
     1291                               do:
     1292                                   hh:load-image("cmp/b-print.bmp":u) .
     1293                                   hh:TOOLTIP = "Печать" .
     1294                                   v-h[ii] = hh:handle .
     1295                                   ii = ii + 1 .
     1296                                   hh:width-chars = 3 .
     1297                               end.
     1298                           when "b-history" or
     1299                           when "b-hist" then
     1300                               do:
     1301                                   hh:load-image("cmp/b-hist.bmp":u) .
     1302                                   hh:TOOLTIP = "История" .
     1303                                   v-h[ii] = hh:handle .
     1304                                   ii = ii + 1 .
     1305                                   hh:width-chars = 3 .
     1306                               end.
     1307                           when "b-sch" then
     1308                               do:
     1309                                   hh:load-image("cmp/b-sch.bmp":u) .
     1310                                   hh:TOOLTIP = "Установка Фильтра" .
     1311                                   v-h[ii] = hh:handle .
     1312                                   ii = ii + 1 .
     1313                                   hh:width-chars = 3 .
     1314                               end.
     1315                           when "b-hist-user" then
     1316                               do:
     1317                                   hh:load-image("cmp/b-hist.bmp":u) .
     1318                                   hh:TOOLTIP = "История пользователя" .
     1319                                   ii = ii + 1 .
     1320                               end.
     1321                       end case.
     1322                   end.
     1323                   hh = hh:next-sibling.
     1324               end.
     1325               b-help:column = v-frame-width - b-help:width-chars.
     1326               jj = 0.
     1327               repeat ii = 4 to 1 by -1 :
     1328                   if valid-handle (v-h[ii] ) then
     1329                   do:
     1330                       jj  = jj + 1 .
     1331                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1332                       v-h[ii]:row    = v-help-old-y .
     1333                   end.
     1334               end.
     1335           end.
     1336       end.
     1337   end procedure.
     1338   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1339   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1340   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1341   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1342   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1343   define variable v-diasize-current-frame-height as decimal   no-undo .
     1344   define variable v-diasize-change-size          as logical   no-undo .
     1345   define variable v-diasize-resize-button        as handle    no-undo .
     1346   define variable v-diasize-wndmax               as logical   no-undo .
     1347   define variable v-diasize-wndstore             as logical   no-undo .
     1348   define variable v-diasize-proc-name            as character no-undo .
     1349   define variable v-diasize-browse-handle        as handle    no-undo .
     1350   define variable v-diasize-browse-number        as integer   no-undo .
     1351   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1352   define temp-table temp-diasize-handle no-undo
     1353     field handle-value  as handle
     1354     field save-position as decimal
     1355     index xpk is primary unique handle-value
     1356     .
     1357   define temp-table temp-browse-handle no-undo
     1358     field browse-type   as character
     1359     field browse-number as integer
     1360     field browse-handle as handle
     1361     field original-size as decimal
     1362     index xpk is primary unique browse-type browse-number
     1363     index xie browse-type browse-handle
     1364   .
     1365   procedure diasize_change-height :
     1366     define input  parameter p-change-value  as decimal   no-undo .
     1367     define input  parameter p-move-resize   as logical   no-undo .
     1368     define variable v-field-group-handle    as handle    no-undo .
     1369     define variable v-object-handle         as handle    no-undo .
     1370     define variable v-frame-height          as decimal   no-undo .
     1371     define variable v-frame-virtual-height  as decimal   no-undo .
     1372     define variable v-browse-height         as decimal   no-undo .
     1373     define variable v-window-height         as decimal   no-undo .
     1374     define variable v-window-virtual-height as decimal   no-undo .
     1375     define variable v-change-sign           as integer   no-undo .
     1376     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1377     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1378     if p-change-value > 0
     1379     then do:
     1380       if frame Dialog-Frame :height + p-change-value
     1381           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1382       then do:
     1383         assign
     1384           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1385                           - (frame Dialog-Frame :height-chars)
     1386         .
     1387         if p-change-value <= 0
     1388         then do:
     1389           run diasize_position-resize-button in this-procedure .
     1390           return .
     1391         end.
     1392       end.
     1393     end.
     1394     if p-change-value < 0
     1395     then do:
     1396       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1397       then do:
     1398         assign
     1399           p-change-value = v-diasize-orig-frame-height
     1400                          - (frame Dialog-Frame :height-chars)
     1401         .
     1402         if p-change-value >= 0
     1403         then do:
     1404           run diasize_position-resize-button in this-procedure .
     1405           return .
     1406         end.
     1407       end.
     1408     end.
     1409     if p-change-value >= 0
     1410     then do:
     1411       assign
     1412         v-change-sign = 1
     1413       .
     1414     end.
     1415     else do:
     1416       assign
     1417         v-change-sign = -1
     1418       .
     1419     end.
     1420     assign
     1421       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1422     .
     1423     if p-change-value = 0
     1424     then do:
     1425       run diasize_position-resize-button in this-procedure .
     1426       return .
     1427     end.
     1428     move_block:
     1429     do
     1430     on error undo move_block, retry move_block
     1431     :
     1432       if retry
     1433       then do:
     1434         do
     1435         on error undo move_block, leave move_block
     1436         :
     1437           if p-change-value > 0
     1438           then do:
     1439             for each buf_temp-diasize-handle
     1440             on error undo, next
     1441             :
     1442               assign
     1443                 v-object-handle = buf_temp-diasize-handle.handle-value
     1444               .
     1445               if v-object-handle <> v-diasize-resize-button
     1446               then do:
     1447                 assign
     1448                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1449                 .
     1450               end.
     1451             end.
     1452             assign
     1453               v-diasize-browse-handle :height = v-browse-height
     1454             .
     1455             for each buf_temp-browse-handle
     1456               where buf_temp-browse-handle.browse-type = 'height':u
     1457             on error undo, next
     1458             :
     1459               assign
     1460                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1461               .
     1462             end.
     1463             assign
     1464               frame Dialog-Frame :height = v-frame-height
     1465             .
     1466             if frame Dialog-Frame :scrollable = true
     1467             then do:
     1468               assign
     1469                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1470               .
     1471             end.
     1472             run diasize_position-resize-button in this-procedure .
     1473           end.
     1474           else do:
     1475             if frame Dialog-Frame :scrollable = true
     1476             then do:
     1477               assign
     1478                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1479               .
     1480             end.
     1481             assign
     1482               frame Dialog-Frame :height = v-frame-height
     1483             .
     1484             assign
     1485               v-diasize-browse-handle :height = v-browse-height
     1486             .
     1487             for each buf_temp-browse-handle
     1488               where buf_temp-browse-handle.browse-type = 'height':u
     1489             on error undo, next
     1490             :
     1491               assign
     1492                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1493               .
     1494             end.
     1495             for each buf_temp-diasize-handle
     1496             on error undo, next
     1497             :
     1498               assign
     1499                 v-object-handle = buf_temp-diasize-handle.handle-value
     1500               .
     1501               if v-object-handle <> v-diasize-resize-button
     1502               then do:
     1503                 assign
     1504                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1505                 .
     1506               end.
     1507             end.
     1508             run diasize_position-resize-button in this-procedure .
     1509           end.
     1510           assign
     1511             v-diasize-change-size = false
     1512           .
     1513           leave move_block .
     1514         end.
     1515       end.
     1516       assign
     1517         v-diasize-need-full-display = true
     1518       .
     1519       if v-diasize-change-size = false
     1520       then do:
     1521         assign
     1522           v-diasize-change-size = true
     1523         .
     1524       end.
     1525       else do:
     1526         return .
     1527       end.
     1528       assign
     1529         v-frame-height = frame Dialog-Frame :height
     1530         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1531         v-browse-height = v-diasize-browse-handle :height
     1532       .
     1533       for each buf_temp-browse-handle
     1534         where buf_temp-browse-handle.browse-type = 'height':u
     1535       :
     1536         assign
     1537           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1538         .
     1539       end.
     1540       for each buf_temp-diasize-handle
     1541       :
     1542         delete buf_temp-diasize-handle .
     1543       end.
     1544       assign
     1545         v-field-group-handle = frame Dialog-Frame :first-child
     1546       .
     1547       do while valid-handle(v-field-group-handle)
     1548       :
     1549         assign
     1550           v-object-handle = v-field-group-handle :first-child
     1551         .
     1552         do while valid-handle(v-object-handle)
     1553         :
     1554           if  v-object-handle <> v-diasize-browse-handle :handle
     1555           and can-query(v-object-handle, "row")
     1556           and can-query(v-object-handle, "height")
     1557           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1558           then do:
     1559             find first buf_temp-browse-handle
     1560               where buf_temp-browse-handle.browse-type   = 'height':u
     1561                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1562               no-error .
     1563             if available buf_temp-browse-handle
     1564             then do:
     1565             end.
     1566             else do:
     1567               create buf_temp-diasize-handle .
     1568               assign
     1569                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1570                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1571               .
     1572             end.
     1573           end.
     1574           assign
     1575             v-object-handle = v-object-handle :next-sibling
     1576           .
     1577         end.
     1578         assign
     1579           v-field-group-handle = v-field-group-handle :next-sibling
     1580         .
     1581       end.
     1582       do with frame Dialog-Frame
     1583       :
     1584         hide v-diasize-resize-button .
     1585         assign
     1586           v-diasize-resize-button :row    = 1
     1587           v-diasize-resize-button :column = 1
     1588         .
     1589       end.
     1590       if p-change-value > 0
     1591       then do:
     1592         if frame Dialog-Frame :scrollable = true
     1593         then do:
     1594           assign
     1595             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1596             no-error .
     1597           if error-status :error
     1598           or error-status :get-message(1) <> ""
     1599           then do:
     1600             undo move_block, retry move_block .
     1601           end.
     1602         end.
     1603         assign
     1604           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1605           no-error .
     1606         if error-status :error
     1607         or error-status :get-message(1) <> ""
     1608         then do:
     1609           undo move_block, retry move_block .
     1610         end.
     1611         assign
     1612           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1613           no-error .
     1614         if error-status :error
     1615         or error-status :get-message(1) <> ""
     1616         then do:
     1617           undo move_block, retry move_block .
     1618         end.
     1619         for each buf_temp-browse-handle
     1620           where buf_temp-browse-handle.browse-type = 'height':u
     1621         on error undo move_block, retry move_block
     1622         :
     1623           assign
     1624             buf_temp-browse-handle.browse-handle :height
     1625               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1626             no-error .
     1627           if error-status :error
     1628           or error-status :get-message(1) <> ""
     1629           then do:
     1630             undo move_block, retry move_block .
     1631           end.
     1632         end.
     1633         for each buf_temp-diasize-handle
     1634         on error undo move_block, retry move_block
     1635         :
     1636           assign
     1637             v-object-handle = buf_temp-diasize-handle.handle-value
     1638           .
     1639           if v-object-handle <> v-diasize-resize-button
     1640           then do:
     1641             assign
     1642               v-object-handle :row = v-object-handle :row + p-change-value
     1643               no-error .
     1644             if error-status :error
     1645             or error-status :get-message(1) <> ""
     1646             then do:
     1647               undo move_block, retry move_block .
     1648             end.
     1649           end.
     1650         end.
     1651       end.
     1652       else do:
     1653         for each buf_temp-diasize-handle
     1654         on error undo move_block, retry move_block
     1655         :
     1656           assign
     1657             v-object-handle = buf_temp-diasize-handle.handle-value
     1658           .
     1659           if v-object-handle <> v-diasize-resize-button
     1660           then do:
     1661             assign
     1662               v-object-handle :row = v-object-handle :row + p-change-value
     1663               no-error .
     1664             if error-status :error
     1665             or error-status :get-message(1) <> ""
     1666             then do:
     1667               undo move_block, retry move_block .
     1668             end.
     1669           end.
     1670         end.
     1671         assign
     1672           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1673           no-error .
     1674         if error-status :error
     1675         or error-status :get-message(1) <> ""
     1676         then do:
     1677           undo move_block, retry move_block .
     1678         end.
     1679         for each buf_temp-browse-handle
     1680           where buf_temp-browse-handle.browse-type = 'height':u
     1681         on error undo move_block, retry move_block
     1682         :
     1683           assign
     1684             buf_temp-browse-handle.browse-handle :height
     1685               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1686             no-error .
     1687           if error-status :error
     1688           or error-status :get-message(1) <> ""
     1689           then do:
     1690             undo move_block, retry move_block .
     1691           end.
     1692         end.
     1693         assign
     1694           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1695           no-error .
     1696         if error-status :error
     1697         or error-status :get-message(1) <> ""
     1698         then do:
     1699           undo move_block, retry move_block .
     1700         end.
     1701         if frame Dialog-Frame :scrollable = true
     1702         then do:
     1703           assign
     1704             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1705             no-error .
     1706           if error-status :error
     1707           or error-status :get-message(1) <> ""
     1708           then do:
     1709             undo move_block, retry move_block .
     1710           end.
     1711         end.
     1712       end.
     1713       if p-move-resize = true
     1714       then do:
     1715         run diasize_position-resize-button in this-procedure .
     1716       end.
     1717       if v-diasize-wndstore = true
     1718       then do:
     1719         if connected("ub") = true
     1720         then do:
     1721           define variable v-cntxt-db-num        as integer   no-undo .
     1722           define variable v-cntxt-userid        as character no-undo .
     1723           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1724                                             , OUTPUT v-cntxt-userid
     1725                                             ) .
     1726           run gbl/wndsizew.p
     1727             (input  v-cntxt-db-num
     1728             ,input  v-cntxt-userid
     1729             ,input  v-diasize-proc-name
     1730             ,input  'height':u
     1731             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1732             ) .
     1733         end.
     1734       end.
     1735     end.
     1736     assign
     1737       v-diasize-change-size = false
     1738     .
     1739   end procedure.
     1740   procedure diasize_set-height :
     1741     define input  parameter p-new-height  as decimal   no-undo .
     1742     define input  parameter p-move-resize as logical   no-undo .
     1743     do
     1744     on error undo, return error return-value
     1745     :
     1746       run diasize_change-height in this-procedure
     1747         (input  (p-new-height - frame Dialog-Frame :height)
     1748         ,input  p-move-resize
     1749         ) .
     1750     end.
     1751   end procedure.
     1752   procedure diasize_change-width :
     1753     define input  parameter p-change-value as decimal   no-undo .
     1754     define input  parameter p-move-resize  as logical   no-undo .
     1755     define variable v-field-group-handle   as handle    no-undo .
     1756     define variable v-object-handle        as handle    no-undo .
     1757     define variable v-frame-width          as decimal   no-undo .
     1758     define variable v-frame-virtual-width  as decimal   no-undo .
     1759     define variable v-browse-width         as decimal   no-undo .
     1760     define variable v-window-width         as decimal   no-undo .
     1761     define variable v-window-virtual-width as decimal   no-undo .
     1762     define variable v-change-sign          as integer   no-undo .
     1763     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1764     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1765     if p-change-value > 0
     1766     then do:
     1767       if frame Dialog-Frame :width + p-change-value >
     1768           session :width-chars
     1769       then do:
     1770         assign
     1771           p-change-value = session :width-chars - frame Dialog-Frame :width
     1772         .
     1773         if p-change-value <= 0
     1774         then do:
     1775           run diasize_position-resize-button in this-procedure .
     1776           return .
     1777         end.
     1778       end.
     1779     end.
     1780     if p-change-value < 0
     1781     then do:
     1782       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1783       then do:
     1784         assign
     1785           p-change-value = v-diasize-orig-frame-width
     1786                          - frame Dialog-Frame :width
     1787         .
     1788         if p-change-value >= 0
     1789         then do:
     1790           run diasize_position-resize-button in this-procedure .
     1791           return .
     1792         end.
     1793       end.
     1794     end.
     1795     if p-change-value >= 0
     1796     then do:
     1797       assign
     1798         v-change-sign = 1
     1799       .
     1800     end.
     1801     else do:
     1802       assign
     1803         v-change-sign = -1
     1804       .
     1805     end.
     1806     assign
     1807       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1808     .
     1809     if p-change-value = 0
     1810     then do:
     1811       run diasize_position-resize-button in this-procedure .
     1812       return .
     1813     end.
     1814     move_block:
     1815     do
     1816     on error undo move_block, leave move_block
     1817     :
     1818       if retry
     1819       then do:
     1820         do
     1821         on error undo move_block, leave move_block
     1822         :
     1823           if p-change-value > 0
     1824           then do:
     1825             for each buf_temp-diasize-handle
     1826             on error undo, next
     1827             :
     1828               assign
     1829                 v-object-handle = buf_temp-diasize-handle.handle-value
     1830               .
     1831               if v-object-handle <> v-diasize-resize-button
     1832               then do:
     1833                 assign
     1834                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1835                 .
     1836               end.
     1837             end.
     1838             assign
     1839               v-diasize-browse-handle :width = v-browse-width
     1840             .
     1841             for each buf_temp-browse-handle
     1842               where buf_temp-browse-handle.browse-type = 'width':u
     1843             on error undo, next
     1844             :
     1845               assign
     1846                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1847               .
     1848             end.
     1849             assign
     1850               frame Dialog-Frame :width = v-frame-width
     1851             .
     1852             if frame Dialog-Frame :scrollable = true
     1853             then do:
     1854               assign
     1855                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1856               .
     1857             end.
     1858             run diasize_position-resize-button in this-procedure .
     1859           end.
     1860           else do:
     1861             if frame Dialog-Frame :scrollable = true
     1862             then do:
     1863               assign
     1864                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1865               .
     1866             end.
     1867             assign
     1868               frame Dialog-Frame :width = v-frame-width
     1869             .
     1870             for each buf_temp-browse-handle
     1871               where buf_temp-browse-handle.browse-type = 'width':u
     1872             on error undo, next
     1873             :
     1874               assign
     1875                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1876               .
     1877             end.
     1878             assign
     1879               v-diasize-browse-handle :width = v-browse-width
     1880             .
     1881             for each buf_temp-diasize-handle
     1882             on error undo, next
     1883             :
     1884               assign
     1885                 v-object-handle = buf_temp-diasize-handle.handle-value
     1886               .
     1887               if v-object-handle <> v-diasize-resize-button
     1888               then do:
     1889                 assign
     1890                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1891                 .
     1892               end.
     1893             end.
     1894             run diasize_position-resize-button in this-procedure .
     1895           end.
     1896           assign
     1897             v-diasize-change-size = false
     1898           .
     1899           leave move_block .
     1900         end.
     1901       end.
     1902       assign
     1903         v-diasize-need-full-display = true
     1904       .
     1905       if v-diasize-change-size = false
     1906       then do:
     1907         assign
     1908           v-diasize-change-size = true
     1909         .
     1910       end.
     1911       else do:
     1912         return .
     1913       end.
     1914       assign
     1915         v-frame-width = frame Dialog-Frame :width
     1916         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1917         v-browse-width = v-diasize-browse-handle :width
     1918       .
     1919       for each buf_temp-browse-handle
     1920         where buf_temp-browse-handle.browse-type = 'width':u
     1921       :
     1922         assign
     1923           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1924         .
     1925       end.
     1926       for each buf_temp-diasize-handle
     1927       :
     1928         delete buf_temp-diasize-handle .
     1929       end.
     1930       assign
     1931         v-field-group-handle = frame Dialog-Frame :first-child
     1932       .
     1933       do while valid-handle(v-field-group-handle)
     1934       :
     1935         assign
     1936           v-object-handle = v-field-group-handle :first-child
     1937         .
     1938         do while valid-handle(v-object-handle)
     1939         :
     1940           if  v-object-handle <> v-diasize-browse-handle :handle
     1941           and v-object-handle <> v-diasize-resize-button
     1942           and can-query(v-object-handle, "row")
     1943           and can-query(v-object-handle, "height")
     1944           and ( v-object-handle :col + v-object-handle :width
     1945                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1946               )
     1947           then do:
     1948             find first buf_temp-browse-handle
     1949               where buf_temp-browse-handle.browse-type   = 'width':u
     1950                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1951               no-error .
     1952             if available buf_temp-browse-handle
     1953             then do:
     1954             end.
     1955             else do:
     1956               create buf_temp-diasize-handle .
     1957               assign
     1958                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1959                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1960               .
     1961             end.
     1962           end.
     1963           assign
     1964             v-object-handle = v-object-handle :next-sibling
     1965           .
     1966         end.
     1967         assign
     1968           v-field-group-handle = v-field-group-handle :next-sibling
     1969         .
     1970       end.
     1971       do with frame Dialog-Frame
     1972       :
     1973         hide v-diasize-resize-button .
     1974         v-diasize-resize-button :row = 1.
     1975         v-diasize-resize-button :column = 1.
     1976       end.
     1977       if p-change-value > 0
     1978       then do:
     1979         if frame Dialog-Frame :scrollable = true
     1980         then do:
     1981           assign
     1982             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1983             no-error .
     1984           if error-status :error
     1985           or error-status :get-message(1) <> ""
     1986           then do:
     1987             undo move_block, retry move_block.
     1988           end.
     1989         end.
     1990         assign
     1991           frame Dialog-Frame :width = v-frame-width + p-change-value
     1992           no-error .
     1993         if error-status :error
     1994         or error-status :get-message(1) <> ""
     1995         then do:
     1996           undo move_block, retry move_block.
     1997         end.
     1998         assign
     1999           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2000         no-error .
     2001         if error-status :error
     2002         or error-status :get-message(1) <> ""
     2003         then do:
     2004           undo move_block, retry move_block.
     2005         end.
     2006         for each buf_temp-browse-handle
     2007           where buf_temp-browse-handle.browse-type = 'width':u
     2008         on error undo move_block, retry move_block
     2009         :
     2010           assign
     2011             buf_temp-browse-handle.browse-handle :width
     2012               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2013             no-error .
     2014           if error-status :error
     2015           or error-status :get-message(1) <> ""
     2016           then do:
     2017             undo move_block, retry move_block .
     2018           end.
     2019         end.
     2020         for each buf_temp-diasize-handle
     2021         on error undo move_block, retry move_block
     2022         :
     2023           assign
     2024             v-object-handle = buf_temp-diasize-handle.handle-value
     2025           .
     2026           if v-object-handle <> v-diasize-resize-button
     2027           then do:
     2028             assign
     2029               v-object-handle :col = v-object-handle :col + p-change-value
     2030               no-error .
     2031             if error-status :error
     2032             or error-status :get-message(1) <> ""
     2033             then do:
     2034               undo move_block, retry move_block .
     2035             end.
     2036           end.
     2037         end.
     2038       end.
     2039       else do:
     2040         for each buf_temp-diasize-handle
     2041         on error undo move_block, retry move_block
     2042         :
     2043           assign
     2044             v-object-handle = buf_temp-diasize-handle.handle-value
     2045           .
     2046           if v-object-handle <> v-diasize-resize-button
     2047           then do:
     2048             assign
     2049               v-object-handle :col = v-object-handle :col + p-change-value
     2050               no-error .
     2051             if error-status :error
     2052             or error-status :get-message(1) <> ""
     2053             then do:
     2054               undo move_block, retry move_block .
     2055             end.
     2056           end.
     2057         end.
     2058         for each buf_temp-browse-handle
     2059           where buf_temp-browse-handle.browse-type = 'width':u
     2060         on error undo move_block, retry move_block
     2061         :
     2062           assign
     2063             buf_temp-browse-handle.browse-handle :width
     2064               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2065             no-error .
     2066           if error-status :error
     2067           or error-status :get-message(1) <> ""
     2068           then do:
     2069             undo move_block, retry move_block .
     2070           end.
     2071         end.
     2072         assign
     2073           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2074           no-error .
     2075         if error-status :error
     2076         or error-status :get-message(1) <> ""
     2077         then do:
     2078           undo move_block, retry move_block.
     2079         end.
     2080         assign
     2081           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2082         no-error .
     2083         if error-status :error
     2084         or error-status :get-message(1) <> ""
     2085         then do:
     2086           undo move_block, retry move_block.
     2087         end.
     2088         if frame Dialog-Frame :scrollable = true
     2089         then do:
     2090           assign
     2091             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2092           no-error .
     2093           if error-status :error
     2094           or error-status :get-message(1) <> ""
     2095           then do:
     2096             undo move_block, retry move_block.
     2097           end.
     2098         end.
     2099       end.
     2100       if p-move-resize
     2101       then do:
     2102         run diasize_position-resize-button in this-procedure .
     2103       end.
     2104       if v-diasize-wndstore = true
     2105       then do:
     2106         if connected("ub") = true
     2107         then do:
     2108           define variable v-cntxt-db-num        as integer   no-undo .
     2109           define variable v-cntxt-userid        as character no-undo .
     2110           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2111                                             , OUTPUT v-cntxt-userid
     2112                                             ) .
     2113           run gbl/wndsizew.p
     2114             (input  v-cntxt-db-num
     2115             ,input  v-cntxt-userid
     2116             ,input  v-diasize-proc-name
     2117             ,input  'width':u
     2118             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2119             ) .
     2120         end.
     2121       end.
     2122     end.
     2123     assign
     2124       v-diasize-change-size = false
     2125     .
     2126   end procedure.
     2127   procedure diasize_set-width :
     2128     define input  parameter p-new-width  as decimal   no-undo .
     2129     define input  parameter p-move-resize as logical   no-undo .
     2130     do
     2131     on error undo, return error return-value
     2132     :
     2133       run diasize_change-width in this-procedure
     2134         (input  (p-new-width - frame Dialog-Frame :width)
     2135         ,input  p-move-resize
     2136         ) .
     2137     end.
     2138   end procedure.
     2139   procedure diasize_position-resize-button :
     2140     do with frame Dialog-Frame
     2141     :
     2142       hide v-diasize-resize-button .
     2143       assign
     2144         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2145                     - 1
     2146                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2147         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2148                     - 1
     2149                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2150       .
     2151       view v-diasize-resize-button .
     2152     end.
     2153   end procedure.
     2154   on alt-right anywhere
     2155   do:
     2156     run diasize_change-width in this-procedure
     2157       (input 1
     2158       ,input true
     2159       ) .
     2160     return no-apply .
     2161   end.
     2162   on alt-left anywhere
     2163   do:
     2164     run diasize_change-width in this-procedure
     2165       (input -1
     2166       ,input true
     2167       ) .
     2168     return no-apply .
     2169   end.
     2170   on alt-down anywhere
     2171   do:
     2172     run diasize_change-height in this-procedure
     2173       (input 1
     2174       ,input true
     2175       ) .
     2176     return no-apply .
     2177   end.
     2178   on alt-up anywhere
     2179   do:
     2180     run diasize_change-height in this-procedure
     2181       (input -1
     2182       ,input true
     2183       ) .
     2184     return no-apply .
     2185   end.
     2186   on alt-enter of frame Dialog-Frame
     2187   do:
     2188     run diasize_maximize in this-procedure
     2189       (input  ?
     2190       ).
     2191     return no-apply .
     2192   end.
     2193   procedure diasize_end-move :
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       define variable v-row-delta as decimal   no-undo .
     2198       define variable v-col-delta as decimal   no-undo .
     2199       define variable v-new-row as decimal   no-undo .
     2200       define variable v-new-col as decimal   no-undo .
     2201       assign
     2202         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2203         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2204       .
     2205       assign
     2206         v-row-delta = v-new-row - frame Dialog-Frame :height
     2207         v-col-delta = v-new-col - frame Dialog-Frame :width
     2208       .
     2209       run diasize_change-height in this-procedure
     2210         (input v-row-delta
     2211         ,input true
     2212         ) .
     2213       run diasize_change-width in this-procedure
     2214         (input v-col-delta
     2215         ,input true
     2216         ) .
     2217     end.
     2218   end procedure.
     2219   procedure diasize_maximize :
     2220     define input  parameter p-action as logical   no-undo .
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       if p-action = ?
     2225       then do:
     2226         if v-diasize-need-maximize = true
     2227         then do:
     2228           assign
     2229             p-action = true
     2230           .
     2231         end.
     2232         else do:
     2233           assign
     2234             p-action = false
     2235           .
     2236         end.
     2237       end.
     2238       if p-action = true
     2239       then do:
     2240         run diasize_change-height in this-procedure
     2241           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2242               - frame Dialog-Frame :height-chars
     2243           ,input true
     2244           ) .
     2245         run diasize_change-width in this-procedure
     2246           (input session :width-chars
     2247               - frame Dialog-Frame :width-chars
     2248           ,input true
     2249           ) .
     2250         assign
     2251           v-diasize-need-maximize = false
     2252         .
     2253       end.
     2254       else do:
     2255         run diasize_change-width in this-procedure
     2256           (input v-diasize-orig-frame-width
     2257               - frame Dialog-Frame :width-chars
     2258           ,input true
     2259           ) .
     2260         run diasize_change-height in this-procedure
     2261           (input v-diasize-orig-frame-height
     2262               - frame Dialog-Frame :height-chars
     2263           ,input true
     2264           ) .
     2265         assign
     2266           v-diasize-need-maximize = true
     2267         .
     2268       end.
     2269     end.
     2270   end procedure.
     2271   procedure diasize_restore-orig-size :
     2272     do
     2273     on error undo, return error return-value
     2274     :
     2275       assign
     2276         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2277         v-diasize-current-frame-height = frame Dialog-Frame :height
     2278       .
     2279       run diasize_set-height in this-procedure
     2280         (input  v-diasize-orig-frame-height
     2281         ,input  true
     2282         ) .
     2283       run diasize_set-width in this-procedure
     2284         (input  v-diasize-orig-frame-width
     2285         ,input  true
     2286         ) .
     2287     end.
     2288   end procedure.
     2289   procedure diasize_restore-current-size :
     2290     do
     2291     on error undo, return error return-value
     2292     :
     2293       run diasize_set-height in this-procedure
     2294         (input  v-diasize-current-frame-height
     2295         ,input  true
     2296         ) .
     2297       run diasize_set-width in this-procedure
     2298         (input  v-diasize-current-frame-width
     2299         ,input  true
     2300         ) .
     2301     end.
     2302   end procedure.
     2303   procedure diasize_set-browse-handle :
     2304     define input  parameter p-browse-handle as handle   no-undo .
     2305     define buffer buf_temp-browse-handle for temp-browse-handle .
     2306     do
     2307     on error undo, return error return-value
     2308     :
     2309       assign
     2310         v-diasize-browse-handle = p-browse-handle
     2311       .
     2312       for each buf_temp-browse-handle
     2313       on error undo, return error return-value
     2314       :
     2315         delete buf_temp-browse-handle .
     2316       end.
     2317     end.
     2318   end procedure.
     2319   procedure diasize_add_browse :
     2320     define input  parameter p-browse-type   as character no-undo .
     2321     define input  parameter p-browse-handle as handle    no-undo .
     2322     define buffer buf_temp-browse-handle for temp-browse-handle .
     2323     do
     2324     on error undo, return error return-value
     2325     :
     2326       assign
     2327         v-diasize-browse-number = v-diasize-browse-number + 1
     2328       .
     2329       create buf_temp-browse-handle .
     2330       assign
     2331         buf_temp-browse-handle.browse-type   = p-browse-type
     2332         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2333         buf_temp-browse-handle.browse-handle = p-browse-handle
     2334       .
     2335     end.
     2336   end procedure.
     2337   procedure diasize_init :
     2338     define variable v-default-value    as logical   no-undo .
     2339     define variable v-restore-saved    as logical   no-undo .
     2340     define variable v-resize-value-str as character no-undo .
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       do with frame Dialog-Frame
     2345       :
     2346         assign
     2347           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2348           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2349           v-diasize-browse-handle     = browse BR-changes :handle
     2350         .
     2351         create button v-diasize-resize-button
     2352         assign
     2353           parent        = frame Dialog-Frame :first-child
     2354           label         = "s"
     2355           height-pixels = 16
     2356           width-pixels  = 16
     2357           visible       = true
     2358           sensitive     = true
     2359           movable       = true
     2360           triggers:
     2361             on end-move persistent run diasize_end-move in this-procedure .
     2362           end triggers.
     2363         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2364         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2365         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2366         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2367         assign
     2368           v-diasize-wndmax = false
     2369         .
     2370         if connected("ub") = true
     2371         then do:
     2372           define variable v-cntxt-db-num        as integer   no-undo .
     2373           define variable v-cntxt-userid        as character no-undo .
     2374           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2375                                             , OUTPUT v-cntxt-userid
     2376                                             ) .
     2377           run gbl/wndpar_r.p
     2378             (input  v-cntxt-db-num
     2379             ,input  v-cntxt-userid
     2380             ,input  'wndmax':U
     2381             ,output v-diasize-wndmax
     2382             ,output v-default-value
     2383             ) .
     2384         end.
     2385         assign
     2386           v-diasize-wndstore = false
     2387         .
     2388         if connected("ub") = true
     2389         then do:
     2390           run gbl/wndpar_r.p
     2391             (input  v-cntxt-db-num
     2392             ,input  v-cntxt-userid
     2393             ,input  'wndstore':U
     2394             ,output v-diasize-wndstore
     2395             ,output v-default-value
     2396             ) .
     2397         end.
     2398         assign
     2399           v-diasize-proc-name = entry(1, program-name(2), '.')
     2400         .
     2401         if v-diasize-wndstore = true
     2402         then do:
     2403           assign
     2404             v-restore-saved = false
     2405           .
     2406           if connected("ub") = true
     2407           then do:
     2408             run gbl/wndsizer.p
     2409               (input  v-cntxt-db-num
     2410               ,input  v-cntxt-userid
     2411               ,input  v-diasize-proc-name
     2412               ,input  'height':u
     2413               ,output v-resize-value-str
     2414               ) .
     2415             if v-resize-value-str <> '':U
     2416             then do:
     2417               run diasize_change-height in this-procedure
     2418                 (input  integer(v-resize-value-str)
     2419                 ,input  true
     2420                 ) .
     2421               assign
     2422                 v-restore-saved = true
     2423               .
     2424             end.
     2425           end.
     2426           if connected("ub") = true
     2427           then do:
     2428             run gbl/wndsizer.p
     2429               (input  v-cntxt-db-num
     2430               ,input  v-cntxt-userid
     2431               ,input  v-diasize-proc-name
     2432               ,input  'width':u
     2433               ,output v-resize-value-str
     2434               ) .
     2435             if v-resize-value-str <> '':U
     2436             then do:
     2437               run diasize_change-width in this-procedure
     2438                 (input  integer(v-resize-value-str)
     2439                 ,input  true
     2440                 ) .
     2441               assign
     2442                 v-restore-saved = true
     2443               .
     2444             end.
     2445           end.
     2446           if v-restore-saved <> true
     2447           then do:
     2448             if v-diasize-wndmax = true
     2449             then do:
     2450               run diasize_maximize in this-procedure
     2451                 (input  true
     2452                 ) .
     2453             end.
     2454           end.
     2455         end.
     2456         else do:
     2457           if v-diasize-wndmax = true
     2458           then do:
     2459             run diasize_maximize in this-procedure
     2460               (input  true
     2461               ) .
     2462           end.
     2463         end.
     2464       end.
     2465     end.
     2466   end procedure.
     2467   procedure diasize_need-full-display :
     2468     define output parameter p-need-full-display as logical   no-undo .
     2469     do
     2470     on error undo, return error return-value
     2471     :
     2472       assign
     2473         p-need-full-display = v-diasize-need-full-display
     2474       .
     2475       assign
     2476         v-diasize-need-full-display = false
     2477       .
     2478     end.
     2479   end procedure.
     2480   procedure get-context :
     2481      define output parameter p-db-num as integer          no-undo.
     2482      define output parameter p-user-id as character        no-undo.
     2483      define variable v-login               as character    no-undo.
     2484      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2485      define buffer buf_user-login  for ub.user-login .
     2486      do
     2487      on error undo, return error
     2488      :
     2489            FIND FIRST buf_sys-ctrl no-lock.
     2490            ASSIGN
     2491               v-login = USERID("ub")
     2492               p-db-num = buf_sys-ctrl.db-num
     2493            .
     2494            FIND FIRST buf_user-login
     2495                 WHERE buf_user-login.db-num = p-db-num
     2496                   AND buf_user-login.user-login = v-login
     2497                 no-lock
     2498                 no-error
     2499                 .
     2500            IF AVAILABLE buf_user-login
     2501            THEN DO:
     2502               assign
     2503                  p-user-id = buf_user-login.user-id
     2504               .
     2505            END.
     2506      end.
     2507   end procedure.
     2508       run diasize_init in this-procedure .
     2509   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2510   do:
     2511     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2512   end.
     2513   MAIN-BLOCK:
     2514   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2515      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2516     find first X_assortment-matrix no-lock where
     2517                X_assortment-matrix.db-num = p-db-num and
     2518                X_assortment-matrix.asmt-id = p-asmt-id
     2519                no-error.
     2520       if not available X_assortment-matrix then do:
     2521           message
     2522           "Нет истории по товару asmt-id "  p-asmt-id skip
     2523             p-db-num
     2524           view-as alert-box ERROR.
     2525           return.
     2526       end.
     2527   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2529     (output v-db-num
     2530     )  .
     2531     run myenable in this-procedure .
     2532     run openbr in this-procedure .
     2533     if v-doc-rec <> ? then
     2534     reposition br-condkeep to recid v-doc-rec no-error.
     2535   wait-for go of frame Dialog-Frame.
     2536   end.
     2537   run disable_ui in this-procedure .
     2538   PROCEDURE disable_UI :
     2539     HIDE FRAME Dialog-Frame.
     2540   END PROCEDURE.
     2541   PROCEDURE enable_UI :
     2542     ENABLE b-quit B-Help br-condkeep BR-changes
     2543         WITH FRAME Dialog-Frame.
     2544     VIEW FRAME Dialog-Frame.
     2545     OPEN QUERY br-condkeep FOR EACH x_c-assortment-matrix NO-LOCK INDEXED-REPOSITION.
     2546   END PROCEDURE.
     2547   PROCEDURE MyEnable :
     2548   ENABLE
     2549   b-quit
     2550   B-Help
     2551   br-condkeep
     2552   with FRAME Dialog-Frame.
     2553   VIEW FRAME Dialog-Frame.
     2554   END PROCEDURE.
     2555   PROCEDURE OpenBr :
     2556   OPEN QUERY br-condkeep FOR EACH X_c-assortment-matrix NO-LOCK where
     2557                                   X_c-assortment-matrix.asmt-id = p-asmt-id and
     2558                                   X_c-assortment-matrix.db-num  = p-db-num
     2559                                 INDEXED-REPOSITION.
     2560   APPLY "VALUE-CHANGED" TO br-condkeep in frame Dialog-Frame.
     2561   APPLY "ENTRY" TO br-condkeep.
     2562   END PROCEDURE.
     2563   PROCEDURE proc-br-condkeep :
     2564   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2565   if b-sel:sensitive in frame Dialog-Frame then dO:
     2566       if b-mark:sensitive then do:
     2567           apply "choose" to b-mark in frame Dialog-Frame.
     2568       end.
     2569       else do:
     2570           apply "choose" to b-sel in frame Dialog-Frame.
     2571       end.
     2572   end.
     2573   else do:
     2574       if b-lookup:sensitive then
     2575       apply "choose" to b-lookup in frame Dialog-Frame.
     2576   end.
     2577   END PROCEDURE.
     2578   PROCEDURE proc-view-changes :
     2579   define buffer new_c-assortment-matrix for ub.c-assortment-matrix.
     2580   define buffer current_assortment-matrix for ub.assortment-matrix.
     2581   define variable v-chg-fields as character no-undo.
     2582   define variable v-old-fields as character no-undo.
     2583   define variable v-new-fields as character no-undo.
     2584   define variable ii as integer no-undo.
     2585   for each temp-changes:
     2586       delete temp-changes.
     2587   END.
     2588   if not available X_c-assortment-matrix then do:
     2589     Open QUery br-changes for each temp-changes.
     2590     return.
     2591   end.
     2592   find first new_c-assortment-matrix no-lock where
     2593               new_c-assortment-matrix.asmt-id = X_c-assortment-matrix.asmt-id
     2594           and new_c-assortment-matrix.db-num = X_c-assortment-matrix.db-num
     2595           AND new_c-assortment-matrix.chip-num > X_c-assortment-matrix.chip-num
     2596           AND new_c-assortment-matrix.corr-user-db-num >= X_c-assortment-matrix.corr-user-db-num
     2597       no-error.
     2598   if not available new_c-assortment-matrix then do:
     2599       find first current_assortment-matrix no-lock where
     2600                  current_assortment-matrix.asmt-id = X_c-assortment-matrix.asmt-id
     2601              and current_assortment-matrix.db-num = X_c-assortment-matrix.db-num
     2602              no-error.
     2603       if not available current_assortment-matrix then do:
     2604            return error.
     2605       end.
     2606       buffer-compare current_assortment-matrix to X_c-assortment-matrix
     2607       save result in v-chg-fields.
     2608   end.
     2609   else do:
     2610       buffer-compare new_c-assortment-matrix except chip-num casm-date-his corr-user-db-num casm-time-his corr-user-name to X_c-assortment-matrix
     2611       save result in v-chg-fields.
     2612   end.
     2613   define variable v-nn as integer   no-undo .
     2614   v-nn = num-entries(v-chg-fields).
     2615   do ii = 1 to v-nn :
     2616   CASE entry(ii, v-chg-fields):
     2617   when "asmt-date-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-date-update":U     temp-changes.l_name = "Дата изменения"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-date-update)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-date-update)                               else string(current_assortment-matrix.asmt-date-update))     .   end.
     2618   when "asmt-db-num-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-db-num-update":U     temp-changes.l_name = "БД изм"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-db-num-update)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-db-num-update)                               else string(current_assortment-matrix.asmt-db-num-update))     .   end.
     2619   when "asmt-time-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-time-update":U     temp-changes.l_name = "Время изменения"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-time-update)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-time-update)                               else string(current_assortment-matrix.asmt-time-update))     .   end.
     2620   when "asmt-who-update":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-who-update":U     temp-changes.l_name = "Кто"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-who-update)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-who-update)                               else string(current_assortment-matrix.asmt-who-update))     .   end.
     2621   when "asmt-type":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-type":U     temp-changes.l_name = "Тип"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-type)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-type)                               else string(current_assortment-matrix.asmt-type))     .   end.
     2622   when "obj-type":U then do:     create temp-changes.     assign     temp-changes.f_name = "obj-type":U     temp-changes.l_name = "Тип объекта"     temp-changes.v_old = string(X_c-assortment-matrix.obj-type)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.obj-type)                               else string(current_assortment-matrix.obj-type))     .   end.
     2623   when "obj-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "obj-code":U     temp-changes.l_name = "Код объекта"     temp-changes.v_old = string(X_c-assortment-matrix.obj-code)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.obj-code)                               else string(current_assortment-matrix.obj-code))     .   end.
     2624   when "asmt-name":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-name":U     temp-changes.l_name = "Наименование"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-name)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-name)                               else string(current_assortment-matrix.asmt-name))     .   end.
     2625   when "asmt-status":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-status":U     temp-changes.l_name = "Статус"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-status)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-status)                               else string(current_assortment-matrix.asmt-status))     .   end.
     2626   when "asmt-des":U then do:     create temp-changes.     assign     temp-changes.f_name = "asmt-des":U     temp-changes.l_name = "Комментарий"     temp-changes.v_old = string(X_c-assortment-matrix.asmt-des)     temp-changes.v_new = (if available new_c-assortment-matrix                               then string(new_c-assortment-matrix.asmt-des)                               else string(current_assortment-matrix.asmt-des))     .   end.
     2627   END CASE.
     2628   end.
     2629   Open QUery br-changes for each temp-changes.
     2630   END PROCEDURE.
     2631   FUNCTION mark-string RETURNS CHARACTER
     2632     ( BUFFER loc-c-assortment-matrix FOR c-assortment-matrix, input mark-list as character ) :
     2633   RETURN ( IF LOOKUP( STRING( RECID( loc-c-assortment-matrix ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2634   END FUNCTION.
