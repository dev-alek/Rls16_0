      355   define  stream PrnLibStream.
      356   procedure prn-lib-prn-file :
      357     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      358     define input parameter p-DIsabledoptions as integer no-undo .
      359     define variable v-report-name as character no-undo .
      360     define variable v-user-action as character no-undo .
      361     define variable v-printed     as logical   no-undo .
      362     define variable v-exist       as logical   no-undo .
      363     do
      364       on error undo, return error
      365       :
      366       run prn-lib-get-report-name  in this-procedure (
      367         input parParentProc
      368         ,output v-report-name
      369         ).
      370   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      372     (input  v-report-name
      373     ,input  2
      374     ,output v-exist
      375     )  .
      376       if NOT v-exist then
      377       DO:
      378         Message
      379           "Нет заданий на печать ! "
      380           view-as alert-box .
      381         Return  .
      382       End.
      383       run gbl/prnfilen.w
      384         (input  ""
      385         ,input  p-DisabledOptions
      386         ,input  string(v-report-name )
      387         ,input  7
      388         ,output v-user-action
      389         ,output v-printed
      390         ) .
      391       if v-printed then
      392       do:
      393         return "YES" .
      394       end.
      395       else
      396       do:
      397         return "NO" .
      398       end.
      399     end.
      400   end procedure.
      401   procedure prn-lib-open-stream :
      402     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      403     define input parameter p-page-size    as integer no-undo .
      404     define input parameter p-is-stream    as logical no-undo .
      405     define input parameter p-append       as logical no-undo .
      406     define variable v-report-name as character no-undo .
      407     do
      408       on error undo, return error
      409       :
      410       run prn-lib-get-report-name  in this-procedure (
      411         input parParentProc
      412         ,output v-report-name
      413         ).
      414       if p-is-stream then
      415       do:
      416         if p-append then
      417         do:
      418           output stream PrnLibStream to value( v-report-name )
      419             page-size value(p-page-size) append .
      420         end.
      421         if not p-append then
      422         do:
      423           output stream PrnLibStream to value( v-report-name )
      424             page-size value(p-page-size) .
      425         end.
      426       end.
      427       if not p-is-stream then
      428       do:
      429         if p-append then
      430         do:
      431           output to value( v-report-name )
      432             page-size value(p-page-size) append .
      433         end.
      434         if not p-append then
      435         do:
      436           output to value( v-report-name )
      437             page-size value(p-page-size) .
      438         end.
      439       end.
      440     end.
      441   end procedure.
      442   procedure prn-lib-open-exp :
      443     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      444     define input parameter p-is-stream    as logical no-undo .
      445     define input parameter p-is-append    as logical no-undo .
      446     define output parameter p-ReportFileName as char init "report" no-undo.
      447     define output parameter p-process as logical no-undo .
      448     define variable glog as logical no-undo .
      449     do
      450       on error undo, return error
      451       :
      452       SYSTEM-DIALOG GET-FILE p-ReportFileName
      453         TITLE      "Укажите путь"
      454         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      455         ASK-OVERWRITE
      456         CREATE-TEST-FILE
      457         SAVE-AS
      458         USE-FILENAME
      459         DEFAULT-EXTENSION "txt"
      460         UPDATE glog
      461         .
      462       if not glog then  return.
      463       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      464       if p-is-stream then
      465       do:
      466         if p-is-append then
      467         do:
      468           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      469         end.
      470         else
      471         do:
      472           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      473         end.
      474       end.
      475       else
      476       do:
      477         if p-is-append then
      478         do:
      479           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      480         end.
      481         else
      482         do:
      483           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      484         end.
      485       end.
      486       p-process = yes.
      487     end.
      488   end procedure.
      489   procedure prn-lib-get-report-name :
      490     define input parameter parParentProc  as widget-handle no-undo.
      491     define output parameter p-report-name as character no-undo .
      492     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      493   end procedure.
      494   procedure prn-lib-reportviewer-report-name :
      495     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      496     define input parameter p-report-name-html as character no-undo .
      497     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      498   end procedure.
      499   procedure prn-lib-reportviewer :
      500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      501     define input parameter p-report-name-html as character no-undo .
      502     define input parameter p-param        as character no-undo .
      503     define variable v-excel           as character no-undo init 'TRUE' .
      504     define variable v-value-character as character no-undo .
      505     define variable v-value-integer   as character no-undo .
      506     define variable v-value-date      as date      no-undo .
      507     define variable v-value-decimal   as decimal   no-undo .
      508     define variable rep-excel         as logical   no-undo .
      509     define variable excel-string      as character no-undo .
      510     define variable v-param-type      as character no-undo .
      511     define variable v-tth             as handle    no-undo .
      512     run adm/shattri.p (
      513       input "get":U
      514       ,input  ""
      515       ,input  0
      516       ,input  'report-glob':U
      517       ,input  'rep-excel':U
      518       ,output v-value-character
      519       ,output v-value-date
      520       ,output v-value-decimal
      521       ,output v-value-integer
      522       ,output rep-excel
      523       ,output v-param-type
      524       ,INPUT-OUTPUT table-handle v-tth
      525       )  .
      526     if rep-excel then v-excel = "TRUE" .
      527     else v-excel = "FALSE" .
      528     if p-param eq ""
      529     then
      530        p-param = "EXCEL:" + v-excel.
      531     else
      532        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      533     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      534   end procedure.
      535   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   procedure fltfield-clear :
      537     define output parameter loc-fld as character no-undo.
      538     define output parameter loc-lab as character no-undo .
      539     define output parameter loc-spr as character no-undo .
      540     define output parameter loc-dim as character no-undo .
      541     assign
      542       loc-fld = ""
      543       loc-lab = ""
      544       loc-spr = ""
      545       loc-dim = "0"
      546     .
      547   end procedure .
      548   procedure fltfield-add :
      549     define input        parameter par-fld as character no-undo.
      550     define input        parameter par-lab as character no-undo .
      551     define input        parameter par-spr as character no-undo .
      552     define input-output parameter loc-fld as character no-undo.
      553     define input-output parameter loc-lab as character no-undo .
      554     define input-output parameter loc-spr as character no-undo .
      555     define input-output parameter loc-dim as character no-undo .
      556     do
      557     on error undo, return error
      558     :
      559       assign
      560       loc-fld = if loc-dim = '0'
      561                 then par-fld
      562                 else (loc-fld + chr(44) + par-fld)
      563       loc-lab = if loc-dim = '0'
      564                 then par-lab
      565                 else (loc-lab + chr(44) + par-lab)
      566       loc-spr = if loc-dim = '0'
      567                 then par-spr
      568                 else (loc-spr + chr(44) + par-spr)
      569       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      570                 string(integer(if num-entries(loc-dim) > 1
      571                               then entry(2, loc-dim)
      572                               else entry(1, loc-dim)
      573                               ) + 1)
      574       no-error
      575       .
      576     end.
      577   end procedure.
      578   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define variable v-waitfram-action01         as character   no-undo .
      580   define variable v-waitfram-action02         as character   no-undo .
      581   define variable v-waitfram-action03         as character   no-undo .
      582   define variable mWaitFramTextBeg            as character   no-undo.
      583   define variable mWaitFramTextEnd            as character   no-undo.
      584   define variable mWaitFramView               as logical     no-undo.
      585   define variable mWaitProcEvent              as logical     no-undo init yes.
      586   define variable mWaitFramInterval           as integer     no-undo init 1 .
      587   define variable mWaitFramStop               as logical     no-undo.
      588   define variable mWaitFramStopUser           as logical     no-undo.
      589   define variable mWaitFramStopTimeOut        as logical     no-undo.
      590   define variable mWaitFramStartProc          as datetime-tz no-undo.
      591   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      592   define button B-WaitFramStop auto-end-key
      593        label "Стоп"
      594        size 10 by 1 tooltip "Остоновить процесс".
      595   define button B-viewProcInfo
      596        label "Информация"
      597        size 15 by 1 tooltip "Информация о процесс".
      598   define frame waitfram
      599     v-waitfram-action01 format "x(72)" no-label skip
      600     v-waitfram-action02 format "x(72)" no-label skip
      601     v-waitfram-action03 format "x(72)" no-label skip
      602     B-viewProcInfo
      603     B-WaitFramStop at row 4 col 30
      604     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      605     .
      606   define new global shared variable mBatchMode as logical no-undo init ?.
      607   define variable mFramBachModHandle as handle no-undo.
      608   mFramBachModHandle = frame waitfram:handle.
      609   define variable mFameOldVis as logical no-undo.
      610   define variable mVisCUrentVin as logical no-undo.
      611   if session:batch-mode
      612   then
      613      mBatchMode = yes.
      614   if mBatchMode = ? then do:
      615     mVisCUrentVin = current-window:visible.
      616     mFameOldVis = mFramBachModHandle:visible.
      617     mFramBachModHandle:visible  = yes.
      618     mBatchMode = mFramBachModHandle:visible ne yes.
      619     mFramBachModHandle:visible = mFameOldVis.
      620     current-window:visible = mVisCUrentVin.
      621   end.
      622    if  log-manager:logfile-name ne ?
      623     then DO:
      624         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      625         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      626         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      627     end.
      628   on choose of B-WaitFramStop in frame waitfram
      629   do:
      630     mWaitFramStop = yes.
      631     mWaitFramStopUser = yes.
      632   end.
      633   function waitfram-check-timeout returns logical():
      634      define variable vtime as int64 no-undo.
      635      if mWaitFramStopTimeOut
      636      then
      637         return yes.
      638      vtime = ( now - mWaitFramStartProc ) / 1000 .
      639      if     mWaitFramTimeOut ne ?
      640         and mWaitFramTimeOut ne 0
      641         and mWaitFramTimeOut lt vtime
      642      then do:
      643         mWaitFramStopTimeOut = yes.
      644      end.
      645      return mWaitFramStopTimeOut.
      646   end.
      647   procedure waitfram-hide :
      648     if not session:batch-mode
      649     then do
      650     on error undo, return error return-value
      651     :
      652       pause 0 before-hide .
      653       if not mBatchMode then
      654         hide frame waitfram .
      655     if     not mWaitFramView
      656        and mWaitProcEvent
      657     then
      658       process events .
      659     end.
      660   end procedure.
      661   procedure waitfram-show :
      662     define input  parameter p-message as character no-undo .
      663     define variable v-left-margin as integer   no-undo .
      664     if not session:batch-mode
      665     then do
      666     on error undo, return error return-value
      667     :
      668       if length(p-message) <= 70 then do:
      669         assign
      670           v-left-margin = integer((70 - length(p-message)) / 2)
      671         .
      672         assign
      673           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      674         .
      675         assign
      676           v-waitfram-action01 = " "
      677           v-waitfram-action02 = " "
      678                                    + fill(" ", v-left-margin)
      679                                    + p-message
      680           v-waitfram-action03 = " "
      681         .
      682       end.
      683       else do:
      684         define variable vRindex1 as integer no-undo.
      685         define variable vRindex2 as integer no-undo.
      686         vRindex1 = r-index(p-message," ",70).
      687         if vRindex1 = 0
      688         then
      689            vRindex1 = 70.
      690         if length(p-message)  <= vRindex1 + 70 then do:
      691           assign
      692             v-waitfram-action01 = " "
      693             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      694             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      695           .
      696         end.
      697         else do:
      698           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      699           if vRindex2 <= vRindex1
      700           then
      701              vRindex2 = vRindex1 + 70.
      702           assign
      703             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      704             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      705             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      706           .
      707         end.
      708       end.
      709       B-viewProcInfo:visible   in frame waitfram = no.
      710       B-viewProcInfo:sensitive in frame waitfram = no.
      711       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      712       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      713       if  (   mWaitFramView
      714          or  mWaitProcEvent)
      715          and not mBatchMode
      716       then
      717          display
      718             v-waitfram-action01 skip
      719             v-waitfram-action02 skip
      720             v-waitfram-action03 skip
      721          with frame waitfram .
      722       if     mWaitFramView
      723          then do:
      724             if     mWaitFramInterval ne ?
      725                and not mBatchMode
      726             then
      727                wait-for go of frame waitfram pause mWaitFramInterval.
      728          end.
      729          else
      730             if     mWaitProcEvent
      731                and not mBatchMode
      732             then
      733                process events .
      734     end.
      735   end procedure.
      736      procedure waitfram-show-this:
      737         define input  parameter iInterval as int64 no-undo.
      738         define variable vtime as int64 no-undo.
      739         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      740         mWaitFramInterval = iInterval.
      741         run waitfram-show (substitute("&1&2 &3&4" ,
      742                                       mWaitFramTextBeg ,
      743                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      744                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      745                                       mWaitFramTextEnd
      746                                      )
      747                           ).
      748      end.
      749      procedure WaitFramRunPause:
      750         define input  parameter iInterval as dec no-undo.
      751         define variable vStart  as datetime-tz no-undo.
      752         define variable vend    as datetime-tz no-undo.
      753         define variable vint as int64 no-undo.
      754         define variable vOk as logical no-undo.
      755         vStart = now.
      756         vend   = vStart.
      757         publish "WaitFramPause" (iInterval,output vOk).
      758         vend   =  now.
      759         vint = vend - vStart.
      760         vint = iInterval - vint / 1000.
      761         if     not mWaitFramStop
      762            and (   vint > 0
      763                 or (    not vOk
      764                     and iInterval eq ?
      765                     )
      766                 )
      767         then
      768            run waitfram-show-this (iInterval).
      769         vend   =  now.
      770         vint = vend - vStart.
      771         vint = iInterval - vint / 1000.
      772         if     not mWaitFramStop
      773            and vint > 0
      774         then do:
      775            run gbl/pause.p (vint * 1000).
      776         end.
      777         if iInterval ne ?
      778         then
      779            publish "WaitFramStop".
      780         waitfram-check-timeout().
      781      end.
      782      procedure WaitFramWaitFor:
      783         define input  parameter iInterval as dec no-undo.
      784         assign
      785            mWaitFramStartProc   = now
      786            mWaitFramStopUser    = no
      787            mWaitFramStopTimeOut = no
      788         .
      789         block-wait:
      790         do while not mWaitFramStop:
      791            run WaitFramRunPause (iInterval).
      792            if  waitfram-check-timeout()
      793            then do:
      794               leave block-wait.
      795            end.
      796         end.
      797         run waitfram-hide.
      798      end.
      799   procedure waitfram-join :
      800     define input  parameter p-line-1  as character no-undo .
      801     define input  parameter p-line-2  as character no-undo .
      802     define input  parameter p-line-3  as character no-undo .
      803     define output parameter p-message as character no-undo .
      804     do
      805     on error undo, return error return-value
      806     :
      807       assign
      808         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      809                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      810                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      811       .
      812     end.
      813   end procedure.
      814   function waitfram-join-function returns character
      815     (input p-line-1 as character
      816     ,input p-line-2 as character
      817     ,input p-line-3 as character
      818     ).
      819     define variable v-message as character no-undo .
      820     run waitfram-join in this-procedure
      821       (input  p-line-1
      822       ,input  p-line-2
      823       ,input  p-line-3
      824       ,output v-message
      825       ) .
      826     return v-message .
      827   end function .
