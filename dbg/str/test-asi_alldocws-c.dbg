     1085        SIZE 3 BY 1
     1086        BGCOLOR 8 .
     1087   DEFINE BUTTON b-lkp
     1088        LABEL "&Просм"
     1089        SIZE 10 BY 1.
     1090   DEFINE BUTTON B-print
     1091        LABEL "Пе&чать"
     1092        SIZE 3 BY 1.
     1093   DEFINE BUTTON b-quit AUTO-GO
     1094        LABEL "&Выход"
     1095        SIZE 8 BY 1
     1096        BGCOLOR 8 .
     1097   DEFINE BUTTON B-sch
     1098        LABEL "&Фильтр"
     1099        SIZE 3 BY 1.
     1100   DEFINE VARIABLE ED-notes AS CHARACTER
     1101        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1102        SIZE 98 BY 2
     1103        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1104   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1105         VIEW-AS TEXT
     1106        SIZE 6 BY 1
     1107        FGCOLOR 4  NO-UNDO.
     1108   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(14)":U
     1109        LABEL "номеру"
     1110        VIEW-AS FILL-IN
     1111        SIZE 12.5 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1112   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999":U
     1113        LABEL "дате"
     1114        VIEW-AS FILL-IN
     1115        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1116   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999":U
     1117        LABEL "дате факт"
     1118        VIEW-AS FILL-IN
     1119        SIZE 11.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1120   DEFINE VARIABLE sch-num AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
     1121        VIEW-AS FILL-IN
     1122        SIZE 12 BY 1
     1123        FGCOLOR 4  NO-UNDO.
     1124   DEFINE VARIABLE v_creid AS CHARACTER FORMAT "X(256)":U
     1125        LABEL "Опер"
     1126         VIEW-AS TEXT
     1127        SIZE 14 BY .71
     1128        FGCOLOR 4  NO-UNDO.
     1129   DEFINE VARIABLE v_deliver AS CHARACTER FORMAT "X(256)":U
     1130        LABEL "Передал"
     1131         VIEW-AS TEXT
     1132        SIZE 14 BY .71
     1133        FGCOLOR 4  NO-UNDO.
     1134   DEFINE VARIABLE v_operator AS CHARACTER FORMAT "X(256)":U
     1135        LABEL "Исп"
     1136         VIEW-AS TEXT
     1137        SIZE 14 BY .71
     1138        FGCOLOR 4  NO-UNDO.
     1139   DEFINE VARIABLE v_receiver AS CHARACTER FORMAT "X(256)":U
     1140        LABEL "Получил"
     1141         VIEW-AS TEXT
     1142        SIZE 14 BY .79
     1143        FGCOLOR 4  NO-UNDO.
     1144   DEFINE QUERY BR-docs FOR
     1145         X_c-rvs-doc SCROLLING.
     1146   DEFINE BROWSE BR-docs
     1147     QUERY BR-docs NO-LOCK DISPLAY
     1148         mark-string( recid(X_c-rvs-doc), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1149   X_c-rvs-doc.rvs-type COLUMN-LABEL "Т" FORMAT "X(1)":U
     1150   X_c-rvs-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)":U
     1151   X_c-rvs-doc.rvs-code FORMAT "X(14)":U
     1152   X_c-rvs-doc.fact-date FORMAT "99/99/99":U
     1153   shift-name-no-err (buffer X_c-rvs-doc) COLUMN-LABEL "№" FORMAT "X(6)":U
     1154   (substring ((string (X_c-rvs-doc.doc-date)), 1, 5)) COLUMN-LABEL "Дата" FORMAT "X(5)":U
     1155   (trim (X_c-rvs-doc.obj-type) + " " + string (X_c-rvs-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1156   usrfulnf(X_c-rvs-doc.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1157   X_c-rvs-doc.corr-date COLUMN-LABEL "Дата измен" FORMAT "99/99/9999":U
     1158   string(X_c-rvs-doc.corr-time, "HH:mm:ss") COLUMN-LABEL "Время измен." FORMAT "X(8)":U
     1159       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.
     1160   DEFINE FRAME Dialog-Frame
     1161        b-quit AT ROW 1 COL 1.13
     1162        b-lkp AT ROW 1 COL 38
     1163        B-print AT ROW 1 COL 89
     1164        B-sch AT ROW 1 COL 92
     1165        B-Help AT ROW 1 COL 95
     1166        BR-docs AT ROW 2.5 COL 1.13
     1167        ED-notes AT ROW 19.92 COL 1 NO-LABEL
     1168        sch-code AT ROW 22.54 COL 17.63 COLON-ALIGNED
     1169        sch-date AT ROW 22.54 COL 40.75 COLON-ALIGNED
     1170        sch-fact AT ROW 22.58 COL 65.63 COLON-ALIGNED
     1171        sch-num AT ROW 22.58 COL 80.63 COLON-ALIGNED NO-LABEL
     1172        mark-num AT ROW 1 COL 10 COLON-ALIGNED NO-LABEL
     1173        v_operator AT ROW 18.88 COL 4 COLON-ALIGNED
     1174        v_deliver AT ROW 18.88 COL 29 COLON-ALIGNED
     1175        v_receiver AT ROW 18.88 COL 54 COLON-ALIGNED
     1176        v_creid AT ROW 18.92 COL 79 COLON-ALIGNED
     1177        "ПОИСК ПО" VIEW-AS TEXT
     1178             SIZE 9.25 BY 1 AT ROW 22.54 COL 1.5
     1179             FGCOLOR 4
     1180        SPACE(88.38) SKIP(0.06)
     1181       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1182            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1183            TITLE "История документов проверки корректности работы АСИ в резервуаре"
     1184            DEFAULT-BUTTON b-lkp.
     1185   ASSIGN
     1186          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1187          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1188   ASSIGN
     1189          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1190   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1191   DO:
     1192     APPLY "END-ERROR":U TO SELF.
     1193   END.
     1194   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1195   DO:
     1196         define variable next-prev as character no-undo .
     1197        IF NOT AVAIL x_c-rvs-doc THEN RETURN NO-apply.
     1198       br-handle = BR-docs:handle.
     1199     ASSIGN
     1200     rvs-rec = RECID( x_c-rvs-doc )
     1201     next-prev = '':U
     1202     .
     1203       DO WHILE next-prev = '':U:
     1204            if NOT available x_c-rvs-doc then do:
     1205           message "Неправильно выбран документ проверки корректности работы АСИ в резервуаре." view-as alert-box ERROR.
     1206           return no-apply.
     1207         end.
     1208               run str/rvs-c-doc.w
     1209                   ( input        parparentproc
     1210                   ,input        'ПРОСМОТР':U
     1211                   ,input        x_c-rvs-doc.rvs-type
     1212                   ,input        no
     1213                   ,input-output rvs-rec
     1214                   ,input-output next-prev
     1215                   ,input this-procedure:handle
     1216                   ) no-error.
     1217               if error-status :error then
     1218               do:
     1219                   return no-apply.
     1220               end.
     1221       end.
     1222       RUN OpenBr in this-procedure ( input  yes, input no, input '':U).
     1223       reposition BR-docs  to recid rvs-rec no-error.
     1224       apply "entry" to BR-docs in frame Dialog-Frame.
     1225       apply "value-changed" to BR-docs in frame Dialog-Frame.
     1226   END.
     1227   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1228   DO:
     1229     if not avail X_c-rvs-doc then return no-apply.
     1230     if print-option = '':U then do:
     1231           run gbl/pop-up.p ( input self:handle, input no) no-error.
     1232     end.
     1233     if print-option = '':U then return no-apply.
     1234     run proc-b-print in this-procedure ( input print-option) no-error.
     1235     if error-status:error then do:
     1236       print-option = '':U.
     1237       return no-apply.
     1238     end.
     1239     APPLY "ENTRY" to br-docs.
     1240   END.
     1241   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1242   DO:
     1243   run proc-b-sch in this-procedure no-error.
     1244   if error-status:error then return no-apply.
     1245   END.
     1246   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     1247   DO:
     1248      sch-code:screen-value = sch-code:screen-value + last-event:label.
     1249       apply "entry" to sch-code in frame Dialog-Frame.
     1250   apply "end" to sch-code in frame Dialog-Frame.
     1251   END.
     1252   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1253   or MOUSE-SELECT-DBLCLICK OF br-docs IN FRAME Dialog-Frame DO:
     1254     apply "choose" to b-lkp in frame Dialog-Frame.
     1255       return no-apply.
     1256   END.
     1257   ON CHOOSE OF MENU-ITEM m_list
     1258   DO:
     1259    assign
     1260     print-option = 'LIST':U.
     1261     APPLY "CHOOSE" to b-print in frame Dialog-Frame.
     1262   END.
     1263   ON CHOOSE OF MENU-ITEM m_one
     1264   DO:
     1265    assign
     1266     print-option = 'ONE':U.
     1267     APPLY "CHOOSE" to b-print  in frame Dialog-Frame.
     1268   END.
     1269   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1270   DO:
     1271      run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1272     if error-status:error then return no-apply.
     1273   END.
     1274   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1275   DO:
     1276      run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1277     if error-status:error then return no-apply.
     1278   END.
     1279   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     1280   DO:
     1281      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date, "doc-date") no-error.
     1282     if error-status:error then return no-apply.
     1283   END.
     1284   ON RETURN OF sch-date IN FRAME Dialog-Frame
     1285   DO:
     1286       run proc-find-date in  this-procedure ( input no, input frame Dialog-Frame sch-date, "doc-date":U) no-error.
     1287     if error-status:error then return no-apply.
     1288   END.
     1289   ON CTRL-J OF sch-fact IN FRAME Dialog-Frame
     1290   DO:
     1291      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     1292     if error-status:error then return no-apply.
     1293   END.
     1294   ON RETURN OF sch-fact IN FRAME Dialog-Frame
     1295   DO:
     1296     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     1297     if error-status:error then return no-apply.
     1298   END.
     1299   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1300   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1301   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1302   on help of frame Dialog-Frame
     1303   do:
     1304     run gbl/app_help.p
     1305       (input this-procedure :file-name
     1306       ,input ''
     1307       ,input ?
     1308       ) no-error.
     1309     if error-status :error then do:
     1310       message
     1311         "Ошибка при вызове помощи"
     1312         error-status :get-message(1)
     1313         view-as alert-box .
     1314     end.
     1315   end.
     1316   run minbtn-set in this-procedure .
     1317   on choose of b-help in frame Dialog-Frame
     1318   do:
     1319     apply "help":u to frame Dialog-Frame .
     1320   end.
     1321   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   procedure minbtn-set :
     1323       do
     1324           on error undo, return error return-value
     1325           :
     1326           define variable ii              as integer       no-undo .
     1327           define variable fh              as widget-handle no-undo .
     1328           define variable hh              as widget-handle no-undo .
     1329           define variable v-h             as handle        extent 4 no-undo .
     1330           define variable v-name-button   as character     no-undo .
     1331           define variable v-help-old-x    as decimal       no-undo .
     1332           define variable v-help-old-y    as decimal       no-undo .
     1333           define variable v-help-old-size as decimal       no-undo .
     1334           define variable v-frame-width   as decimal       no-undo .
     1335           define variable jj              as integer       no-undo .
     1336           do
     1337               on error undo, return error
     1338               :
     1339               assign
     1340                   v-frame-width = frame Dialog-Frame:width - 0.3
     1341                   fh            = frame Dialog-Frame:first-child
     1342                   hh            = fh:first-child
     1343                   ii            = 1
     1344                   .
     1345               do while valid-handle(hh):
     1346                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1347                   do:
     1348                       case lc(hh:name) :
     1349                           when "b-help" then
     1350                               do:
     1351                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1352                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1353                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1354                                   hh:TOOLTIP = "Помощь" .
     1355                                   v-help-old-x = hh:column .
     1356                                   v-help-old-y = hh:row    .
     1357                                   v-help-old-size = hh:width .
     1358                                   hh:width-chars = 2.5 .
     1359                               end.
     1360                           when "b-print" then
     1361                               do:
     1362                                   hh:load-image("cmp/b-print.bmp":u) .
     1363                                   hh:TOOLTIP = "Печать" .
     1364                                   v-h[ii] = hh:handle .
     1365                                   ii = ii + 1 .
     1366                                   hh:width-chars = 3 .
     1367                               end.
     1368                           when "b-history" or
     1369                           when "b-hist" then
     1370                               do:
     1371                                   hh:load-image("cmp/b-hist.bmp":u) .
     1372                                   hh:TOOLTIP = "История" .
     1373                                   v-h[ii] = hh:handle .
     1374                                   ii = ii + 1 .
     1375                                   hh:width-chars = 3 .
     1376                               end.
     1377                           when "b-sch" then
     1378                               do:
     1379                                   hh:load-image("cmp/b-sch.bmp":u) .
     1380                                   hh:TOOLTIP = "Установка Фильтра" .
     1381                                   v-h[ii] = hh:handle .
     1382                                   ii = ii + 1 .
     1383                                   hh:width-chars = 3 .
     1384                               end.
     1385                           when "b-hist-user" then
     1386                               do:
     1387                                   hh:load-image("cmp/b-hist.bmp":u) .
     1388                                   hh:TOOLTIP = "История пользователя" .
     1389                                   ii = ii + 1 .
     1390                               end.
     1391                       end case.
     1392                   end.
     1393                   hh = hh:next-sibling.
     1394               end.
     1395               b-help:column = v-frame-width - b-help:width-chars.
     1396               jj = 0.
     1397               repeat ii = 4 to 1 by -1 :
     1398                   if valid-handle (v-h[ii] ) then
     1399                   do:
     1400                       jj  = jj + 1 .
     1401                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1402                       v-h[ii]:row    = v-help-old-y .
     1403                   end.
     1404               end.
     1405           end.
     1406       end.
     1407   end procedure.
     1408   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1409   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1410   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1411   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1412   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1413   define variable v-diasize-current-frame-height as decimal   no-undo .
     1414   define variable v-diasize-change-size          as logical   no-undo .
     1415   define variable v-diasize-resize-button        as handle    no-undo .
     1416   define variable v-diasize-wndmax               as logical   no-undo .
     1417   define variable v-diasize-wndstore             as logical   no-undo .
     1418   define variable v-diasize-proc-name            as character no-undo .
     1419   define variable v-diasize-browse-handle        as handle    no-undo .
     1420   define variable v-diasize-browse-number        as integer   no-undo .
     1421   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1422   define temp-table temp-diasize-handle no-undo
     1423     field handle-value  as handle
     1424     field save-position as decimal
     1425     index xpk is primary unique handle-value
     1426     .
     1427   define temp-table temp-browse-handle no-undo
     1428     field browse-type   as character
     1429     field browse-number as integer
     1430     field browse-handle as handle
     1431     field original-size as decimal
     1432     index xpk is primary unique browse-type browse-number
     1433     index xie browse-type browse-handle
     1434   .
     1435   procedure diasize_change-height :
     1436     define input  parameter p-change-value  as decimal   no-undo .
     1437     define input  parameter p-move-resize   as logical   no-undo .
     1438     define variable v-field-group-handle    as handle    no-undo .
     1439     define variable v-object-handle         as handle    no-undo .
     1440     define variable v-frame-height          as decimal   no-undo .
     1441     define variable v-frame-virtual-height  as decimal   no-undo .
     1442     define variable v-browse-height         as decimal   no-undo .
     1443     define variable v-window-height         as decimal   no-undo .
     1444     define variable v-window-virtual-height as decimal   no-undo .
     1445     define variable v-change-sign           as integer   no-undo .
     1446     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1447     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1448     if p-change-value > 0
     1449     then do:
     1450       if frame Dialog-Frame :height + p-change-value
     1451           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1452       then do:
     1453         assign
     1454           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1455                           - (frame Dialog-Frame :height-chars)
     1456         .
     1457         if p-change-value <= 0
     1458         then do:
     1459           run diasize_position-resize-button in this-procedure .
     1460           return .
     1461         end.
     1462       end.
     1463     end.
     1464     if p-change-value < 0
     1465     then do:
     1466       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1467       then do:
     1468         assign
     1469           p-change-value = v-diasize-orig-frame-height
     1470                          - (frame Dialog-Frame :height-chars)
     1471         .
     1472         if p-change-value >= 0
     1473         then do:
     1474           run diasize_position-resize-button in this-procedure .
     1475           return .
     1476         end.
     1477       end.
     1478     end.
     1479     if p-change-value >= 0
     1480     then do:
     1481       assign
     1482         v-change-sign = 1
     1483       .
     1484     end.
     1485     else do:
     1486       assign
     1487         v-change-sign = -1
     1488       .
     1489     end.
     1490     assign
     1491       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1492     .
     1493     if p-change-value = 0
     1494     then do:
     1495       run diasize_position-resize-button in this-procedure .
     1496       return .
     1497     end.
     1498     move_block:
     1499     do
     1500     on error undo move_block, retry move_block
     1501     :
     1502       if retry
     1503       then do:
     1504         do
     1505         on error undo move_block, leave move_block
     1506         :
     1507           if p-change-value > 0
     1508           then do:
     1509             for each buf_temp-diasize-handle
     1510             on error undo, next
     1511             :
     1512               assign
     1513                 v-object-handle = buf_temp-diasize-handle.handle-value
     1514               .
     1515               if v-object-handle <> v-diasize-resize-button
     1516               then do:
     1517                 assign
     1518                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1519                 .
     1520               end.
     1521             end.
     1522             assign
     1523               v-diasize-browse-handle :height = v-browse-height
     1524             .
     1525             for each buf_temp-browse-handle
     1526               where buf_temp-browse-handle.browse-type = 'height':u
     1527             on error undo, next
     1528             :
     1529               assign
     1530                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1531               .
     1532             end.
     1533             assign
     1534               frame Dialog-Frame :height = v-frame-height
     1535             .
     1536             if frame Dialog-Frame :scrollable = true
     1537             then do:
     1538               assign
     1539                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1540               .
     1541             end.
     1542             run diasize_position-resize-button in this-procedure .
     1543           end.
     1544           else do:
     1545             if frame Dialog-Frame :scrollable = true
     1546             then do:
     1547               assign
     1548                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1549               .
     1550             end.
     1551             assign
     1552               frame Dialog-Frame :height = v-frame-height
     1553             .
     1554             assign
     1555               v-diasize-browse-handle :height = v-browse-height
     1556             .
     1557             for each buf_temp-browse-handle
