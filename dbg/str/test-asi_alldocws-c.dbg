     2175       then do:
     2176         if connected("ub") = true
     2177         then do:
     2178           define variable v-cntxt-db-num        as integer   no-undo .
     2179           define variable v-cntxt-userid        as character no-undo .
     2180           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2181                                             , OUTPUT v-cntxt-userid
     2182                                             ) .
     2183           run gbl/wndsizew.p
     2184             (input  v-cntxt-db-num
     2185             ,input  v-cntxt-userid
     2186             ,input  v-diasize-proc-name
     2187             ,input  'width':u
     2188             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2189             ) .
     2190         end.
     2191       end.
     2192     end.
     2193     assign
     2194       v-diasize-change-size = false
     2195     .
     2196   end procedure.
     2197   procedure diasize_set-width :
     2198     define input  parameter p-new-width  as decimal   no-undo .
     2199     define input  parameter p-move-resize as logical   no-undo .
     2200     do
     2201     on error undo, return error return-value
     2202     :
     2203       run diasize_change-width in this-procedure
     2204         (input  (p-new-width - frame Dialog-Frame :width)
     2205         ,input  p-move-resize
     2206         ) .
     2207     end.
     2208   end procedure.
     2209   procedure diasize_position-resize-button :
     2210     do with frame Dialog-Frame
     2211     :
     2212       hide v-diasize-resize-button .
     2213       assign
     2214         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2215                     - 1
     2216                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2217         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2218                     - 1
     2219                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2220       .
     2221       view v-diasize-resize-button .
     2222     end.
     2223   end procedure.
     2224   on alt-right anywhere
     2225   do:
     2226     run diasize_change-width in this-procedure
     2227       (input 1
     2228       ,input true
     2229       ) .
     2230     return no-apply .
     2231   end.
     2232   on alt-left anywhere
     2233   do:
     2234     run diasize_change-width in this-procedure
     2235       (input -1
     2236       ,input true
     2237       ) .
     2238     return no-apply .
     2239   end.
     2240   on alt-down anywhere
     2241   do:
     2242     run diasize_change-height in this-procedure
     2243       (input 1
     2244       ,input true
     2245       ) .
     2246     return no-apply .
     2247   end.
     2248   on alt-up anywhere
     2249   do:
     2250     run diasize_change-height in this-procedure
     2251       (input -1
     2252       ,input true
     2253       ) .
     2254     return no-apply .
     2255   end.
     2256   on alt-enter of frame Dialog-Frame
     2257   do:
     2258     run diasize_maximize in this-procedure
     2259       (input  ?
     2260       ).
     2261     return no-apply .
     2262   end.
     2263   procedure diasize_end-move :
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       define variable v-row-delta as decimal   no-undo .
     2268       define variable v-col-delta as decimal   no-undo .
     2269       define variable v-new-row as decimal   no-undo .
     2270       define variable v-new-col as decimal   no-undo .
     2271       assign
     2272         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2273         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2274       .
     2275       assign
     2276         v-row-delta = v-new-row - frame Dialog-Frame :height
     2277         v-col-delta = v-new-col - frame Dialog-Frame :width
     2278       .
     2279       run diasize_change-height in this-procedure
     2280         (input v-row-delta
     2281         ,input true
     2282         ) .
     2283       run diasize_change-width in this-procedure
     2284         (input v-col-delta
     2285         ,input true
     2286         ) .
     2287     end.
     2288   end procedure.
     2289   procedure diasize_maximize :
     2290     define input  parameter p-action as logical   no-undo .
     2291     do
     2292     on error undo, return error return-value
     2293     :
     2294       if p-action = ?
     2295       then do:
     2296         if v-diasize-need-maximize = true
     2297         then do:
     2298           assign
     2299             p-action = true
     2300           .
     2301         end.
     2302         else do:
     2303           assign
     2304             p-action = false
     2305           .
     2306         end.
     2307       end.
     2308       if p-action = true
     2309       then do:
     2310         run diasize_change-height in this-procedure
     2311           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2312               - frame Dialog-Frame :height-chars
     2313           ,input true
     2314           ) .
     2315         run diasize_change-width in this-procedure
     2316           (input session :width-chars
     2317               - frame Dialog-Frame :width-chars
     2318           ,input true
     2319           ) .
     2320         assign
     2321           v-diasize-need-maximize = false
     2322         .
     2323       end.
     2324       else do:
     2325         run diasize_change-width in this-procedure
     2326           (input v-diasize-orig-frame-width
     2327               - frame Dialog-Frame :width-chars
     2328           ,input true
     2329           ) .
     2330         run diasize_change-height in this-procedure
     2331           (input v-diasize-orig-frame-height
     2332               - frame Dialog-Frame :height-chars
     2333           ,input true
     2334           ) .
     2335         assign
     2336           v-diasize-need-maximize = true
     2337         .
     2338       end.
     2339     end.
     2340   end procedure.
     2341   procedure diasize_restore-orig-size :
     2342     do
     2343     on error undo, return error return-value
     2344     :
     2345       assign
     2346         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2347         v-diasize-current-frame-height = frame Dialog-Frame :height
     2348       .
     2349       run diasize_set-height in this-procedure
     2350         (input  v-diasize-orig-frame-height
     2351         ,input  true
     2352         ) .
     2353       run diasize_set-width in this-procedure
     2354         (input  v-diasize-orig-frame-width
     2355         ,input  true
     2356         ) .
     2357     end.
     2358   end procedure.
     2359   procedure diasize_restore-current-size :
     2360     do
     2361     on error undo, return error return-value
     2362     :
     2363       run diasize_set-height in this-procedure
     2364         (input  v-diasize-current-frame-height
     2365         ,input  true
     2366         ) .
     2367       run diasize_set-width in this-procedure
     2368         (input  v-diasize-current-frame-width
     2369         ,input  true
     2370         ) .
     2371     end.
     2372   end procedure.
     2373   procedure diasize_set-browse-handle :
     2374     define input  parameter p-browse-handle as handle   no-undo .
     2375     define buffer buf_temp-browse-handle for temp-browse-handle .
     2376     do
     2377     on error undo, return error return-value
     2378     :
     2379       assign
     2380         v-diasize-browse-handle = p-browse-handle
     2381       .
     2382       for each buf_temp-browse-handle
     2383       on error undo, return error return-value
     2384       :
     2385         delete buf_temp-browse-handle .
     2386       end.
     2387     end.
     2388   end procedure.
     2389   procedure diasize_add_browse :
     2390     define input  parameter p-browse-type   as character no-undo .
     2391     define input  parameter p-browse-handle as handle    no-undo .
     2392     define buffer buf_temp-browse-handle for temp-browse-handle .
     2393     do
     2394     on error undo, return error return-value
     2395     :
     2396       assign
     2397         v-diasize-browse-number = v-diasize-browse-number + 1
     2398       .
     2399       create buf_temp-browse-handle .
     2400       assign
     2401         buf_temp-browse-handle.browse-type   = p-browse-type
     2402         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2403         buf_temp-browse-handle.browse-handle = p-browse-handle
     2404       .
     2405     end.
     2406   end procedure.
     2407   procedure diasize_init :
     2408     define variable v-default-value    as logical   no-undo .
     2409     define variable v-restore-saved    as logical   no-undo .
     2410     define variable v-resize-value-str as character no-undo .
     2411     do
     2412     on error undo, return error return-value
     2413     :
     2414       do with frame Dialog-Frame
     2415       :
     2416         assign
     2417           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2418           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2419           v-diasize-browse-handle     = browse BR-docs :handle
     2420         .
     2421         create button v-diasize-resize-button
     2422         assign
     2423           parent        = frame Dialog-Frame :first-child
     2424           label         = "s"
     2425           height-pixels = 16
     2426           width-pixels  = 16
     2427           visible       = true
     2428           sensitive     = true
     2429           movable       = true
     2430           triggers:
     2431             on end-move persistent run diasize_end-move in this-procedure .
     2432           end triggers.
     2433         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2434         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2435         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2436         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2437         assign
     2438           v-diasize-wndmax = false
     2439         .
     2440         if connected("ub") = true
     2441         then do:
     2442           define variable v-cntxt-db-num        as integer   no-undo .
     2443           define variable v-cntxt-userid        as character no-undo .
     2444           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2445                                             , OUTPUT v-cntxt-userid
     2446                                             ) .
     2447           run gbl/wndpar_r.p
     2448             (input  v-cntxt-db-num
     2449             ,input  v-cntxt-userid
     2450             ,input  'wndmax':U
     2451             ,output v-diasize-wndmax
     2452             ,output v-default-value
     2453             ) .
     2454         end.
     2455         assign
     2456           v-diasize-wndstore = false
     2457         .
     2458         if connected("ub") = true
     2459         then do:
     2460           run gbl/wndpar_r.p
     2461             (input  v-cntxt-db-num
     2462             ,input  v-cntxt-userid
     2463             ,input  'wndstore':U
     2464             ,output v-diasize-wndstore
     2465             ,output v-default-value
     2466             ) .
     2467         end.
     2468         assign
     2469           v-diasize-proc-name = entry(1, program-name(2), '.')
     2470         .
     2471         if v-diasize-wndstore = true
     2472         then do:
     2473           assign
     2474             v-restore-saved = false
     2475           .
     2476           if connected("ub") = true
     2477           then do:
     2478             run gbl/wndsizer.p
     2479               (input  v-cntxt-db-num
     2480               ,input  v-cntxt-userid
     2481               ,input  v-diasize-proc-name
     2482               ,input  'height':u
     2483               ,output v-resize-value-str
     2484               ) .
     2485             if v-resize-value-str <> '':U
     2486             then do:
     2487               run diasize_change-height in this-procedure
     2488                 (input  integer(v-resize-value-str)
     2489                 ,input  true
     2490                 ) .
     2491               assign
     2492                 v-restore-saved = true
     2493               .
     2494             end.
     2495           end.
     2496           if connected("ub") = true
     2497           then do:
     2498             run gbl/wndsizer.p
     2499               (input  v-cntxt-db-num
     2500               ,input  v-cntxt-userid
     2501               ,input  v-diasize-proc-name
     2502               ,input  'width':u
     2503               ,output v-resize-value-str
     2504               ) .
     2505             if v-resize-value-str <> '':U
     2506             then do:
     2507               run diasize_change-width in this-procedure
     2508                 (input  integer(v-resize-value-str)
     2509                 ,input  true
     2510                 ) .
     2511               assign
     2512                 v-restore-saved = true
     2513               .
     2514             end.
     2515           end.
     2516           if v-restore-saved <> true
     2517           then do:
     2518             if v-diasize-wndmax = true
     2519             then do:
     2520               run diasize_maximize in this-procedure
     2521                 (input  true
     2522                 ) .
     2523             end.
     2524           end.
     2525         end.
     2526         else do:
     2527           if v-diasize-wndmax = true
     2528           then do:
     2529             run diasize_maximize in this-procedure
     2530               (input  true
     2531               ) .
     2532           end.
     2533         end.
     2534       end.
     2535     end.
     2536   end procedure.
     2537   procedure diasize_need-full-display :
     2538     define output parameter p-need-full-display as logical   no-undo .
     2539     do
     2540     on error undo, return error return-value
     2541     :
     2542       assign
     2543         p-need-full-display = v-diasize-need-full-display
     2544       .
     2545       assign
     2546         v-diasize-need-full-display = false
     2547       .
     2548     end.
     2549   end procedure.
     2550   procedure get-context :
     2551      define output parameter p-db-num as integer          no-undo.
     2552      define output parameter p-user-id as character        no-undo.
     2553      define variable v-login               as character    no-undo.
     2554      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2555      define buffer buf_user-login  for ub.user-login .
     2556      do
     2557      on error undo, return error
     2558      :
     2559            FIND FIRST buf_sys-ctrl no-lock.
     2560            ASSIGN
     2561               v-login = USERID("ub")
     2562               p-db-num = buf_sys-ctrl.db-num
     2563            .
     2564            FIND FIRST buf_user-login
     2565                 WHERE buf_user-login.db-num = p-db-num
     2566                   AND buf_user-login.user-login = v-login
     2567                 no-lock
     2568                 no-error
     2569                 .
     2570            IF AVAILABLE buf_user-login
     2571            THEN DO:
     2572               assign
     2573                  p-user-id = buf_user-login.user-id
     2574               .
     2575            END.
     2576      end.
     2577   end procedure.
     2578       run diasize_init in this-procedure .
     2579   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2580   procedure set-filter-name :
     2581   define input parameter p-filter-name as character no-undo .
     2582     do with frame Dialog-Frame:
     2583       if p-filter-name > "" then do:
     2584         assign
     2585           frame Dialog-Frame:title
     2586             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2587         .
     2588         assign
     2589           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2590         .
     2591       end.
     2592       else do:
     2593         assign
     2594           b-sch :tooltip = ""
     2595         .
     2596       end.
     2597     end.
     2598   end procedure.
     2599   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2600   on F3 of frame Dialog-Frame anywhere do:
     2601     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2602     return no-apply.
     2603   end.
     2604   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2605   on F2 of frame Dialog-Frame anywhere do:
     2606     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2607     return no-apply.
     2608   end.
     2609   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2610   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2611     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2612     return no-apply.
     2613   end.
     2614   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2615   on f5 of frame Dialog-Frame anywhere
     2616   do:
     2617      v-doc-rec = recid(X_c-rvs-doc). run openbr in this-procedure ( input yes, input no, input '':U).                reposition br-docS to recid v-doc-rec no-error.                APPLY 'ENTRY' to br-docs. APPLY 'VALUE-CHANGED' to br-docS.
     2618       apply "VALUE-CHANGED" to BR-docs.
     2619   end.
     2620   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2621   do:
     2622     BR-docs :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2623   end.
     2624   MAIN-BLOCK:
     2625   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2626      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2627   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2628     run mainmenu_getcntxt in parparentproc
     2629       (output v-cntxt-db-num
     2630       ,output v-cntxt-userid
     2631       ,output v-cntxt-level
     2632       ,output v-cntxt-host-code-obj
     2633       ,output v-cntxt-obj-type
     2634       ,output v-cntxt-obj-code
     2635       ,output v-cntxt-db-num-obj
     2636       ,output v-cntxt-is-admin
     2637       ) .
     2638     FIND FIRST ub.sys-ctrl NO-LOCK.
     2639     if avail sys-ctrl then do:
     2640       FIND FIRST db no-LOCK where
     2641                 db.db-num = sys-ctrl.db-num NO-ERROR.
     2642       if not avail db then do:
     2643         message "Отсутствует запись о БД (db)"
     2644         view-as alert-box ERROR.
     2645         return error.
     2646       end.
     2647     END.
     2648     FIND FIRST buf_obj No-LOCK WHERE
     2649                     buf_obj.obj-type = v-cntxt-obj-type and
     2650                     buf_obj.obj-code = v-cntxt-obj-code No-ERROR.
     2651       if parlist-mode =  'объект':U then dO:
     2652           FIND FIRST buf_cli No-LOCK WHERE
     2653                           buf_cli.obj-type = v-cntxt-obj-type and
     2654                           buf_cli.obj-code = v-cntxt-obj-code No-ERROR.
     2655           if not avail buf_cli then do:
     2656               message vss-workfile vss-revision vss-description skip
     2657               view-as alert-box ERROR.
     2658               return.
     2659           end.
     2660       end.
     2661   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     2663     (input  buf_obj.host-code
     2664     ,output v-r-b-abbr
     2665     )  .
     2666     v-rid-list = string(out-rec).
     2667     RUN MyEnable in this-procedure .
     2668     HIDE mark-num in frame Dialog-Frame .
     2669     WAIT-FOR GO OF FRAME Dialog-Frame.
     2670   END.
     2671   RUN disable_UI in this-procedure .
     2672   PROCEDURE disable_UI :
     2673     HIDE FRAME Dialog-Frame.
     2674   END PROCEDURE.
     2675   PROCEDURE enable_UI :
     2676     DISPLAY ED-notes sch-code sch-date sch-fact sch-num mark-num v_operator
     2677             v_deliver v_receiver v_creid
     2678         WITH FRAME Dialog-Frame.
     2679     ENABLE b-quit b-lkp B-print B-sch B-Help BR-docs ED-notes
     2680            sch-code sch-date sch-fact sch-num mark-num v_operator v_deliver
     2681            v_receiver v_creid
     2682         WITH FRAME Dialog-Frame.
     2683     VIEW FRAME Dialog-Frame.
     2684   END PROCEDURE.
     2685   PROCEDURE Myenable :
     2686     ASSIGN
     2687     br-docs:NUM-LOCKED-COLUMNS IN FRAME  Dialog-Frame  = 4
     2688     b-print:MENU-MOUSE = 1
     2689   .
     2690   DISPLAY
     2691   ED-notes
     2692   sch-code
     2693   sch-date
     2694   sch-fact
     2695   sch-num
     2696   mark-num
     2697   v_operator
     2698   v_deliver
     2699   v_receiver
     2700   v_creid
     2701   WITH FRAME Dialog-Frame .
     2702   ENABLE
     2703   b-quit
     2704   b-lkp
     2705   B-sch
     2706   B-print
     2707   B-Help
     2708   BR-docs
     2709   ED-notes
     2710   sch-code
     2711   sch-date
     2712   sch-fact
     2713   sch-num
     2714   mark-num
     2715   v_operator
     2716   v_deliver
     2717   v_receiver
     2718   v_creid
     2719   WITH FRAME Dialog-Frame .
     2720   VIEW FRAME Dialog-Frame .
     2721   RUn openbr in this-procedure ( input  yes, input no, input '':U).
     2722   END PROCEDURE.
     2723   PROCEDURE OpenBr :
     2724   define input  parameter p-open-query     as logical   no-undo .
     2725   define input  parameter p-find-next      as logical   no-undo .
     2726   define input  parameter p-find-condition as character no-undo .
     2727   define variable l-query-was-opened as logical no-undo .
     2728   define variable title0 as character no-undo.
     2729   title0 = "История документов проверки корректности работы АСИ в резервуаре".
     2730   define variable sort-column-phrase as character no-undo .
     2731   case sort-column-name :
     2732   when "" then do:
     2733   assign
     2734     sort-column-phrase = ""
     2735   .
     2736   end.
     2737   otherwise do:
     2738   assign
     2739     sort-column-phrase = "by " + sort-column-name
     2740   .
     2741   end.
     2742   end case.
     2743   define variable l-open-query as logical   no-undo .
     2744   define variable vartest-asi like ub.rvs-doc.rvs-type no-undo .
     2745   assign vartest-asi = 'проверка':U .
     2746   CASE parlist-mode :
     2747   WHEN 'объект':U THEN DO:
     2748     if p-open-query then do:
     2749       ASSIGN
     2750       frame Dialog-Frame:TITLE = title0 + " Удаленные документы: Объект: " + v-cntxt-obj-type + string(v-cntxt-obj-code).
     2751     end.
     2752       filter-label = substitute("&1 Удаленные документы по одному объекту", filter-label0)
     2753       .
     2754   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2755   define variable  l-disable-where-28  as logical   no-undo .
     2756   define variable  l-filter-open-28    as logical   .
     2757   define variable  flt-rec-28       as recid     no-undo .
     2758   define variable  filter-name-28      as character no-undo .
     2759   define variable  where-phrase-28     as character no-undo .
     2760   define variable  sort-phrase-28      as character no-undo .
     2761   define variable  where-phrase-rus-28 as character no-undo .
     2762   define variable  sort-phrase-rus-28  as character no-undo .
     2763     run waitfram-show in this-procedure
     2764       (input "ЖДИТЕ ..."
     2765       ).
     2766   run gbl/flt-get.p
     2767     (input filter-point
     2768     ,output flt-rec-28
     2769     ,output filter-name-28
     2770     ,output where-phrase-28
     2771     ,output sort-phrase-28
     2772     ,output where-phrase-rus-28
     2773     ,output sort-phrase-rus-28
     2774     ).
     2775   if p-open-query then do:
     2776       run set-filter-name in this-procedure
     2777         (INPUT filter-name-28
     2778         ) no-error .
     2779     assign
     2780       l-filter-open-28 = false
     2781     .
     2782     if flt-rec-28 <> ?
     2783       or sort-column-phrase > ""
     2784     then do:
     2785       define variable  parameter-2-28 as character no-undo .
     2786       define variable  parameter-3-28 as character no-undo .
     2787       define variable  parameter-4-28 as character no-undo .
     2788       define variable  parameter-5-28 as character no-undo .
     2789       define variable  parameter-6-28 as character no-undo .
     2790       define variable  parameter-7-28 as character no-undo .
     2791         assign
     2792         parameter-3-28 =
     2793                                 "FOR EACH X_c-rvs-doc"
     2794         parameter-4-28 =
     2795           (
     2796             if ("       X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type  = vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2797          " + " " + where-phrase-28) <> ""
     2798             then  substitute(' X_c-rvs-doc.host-code = &1 AND       X_c-rvs-doc.obj-type  = &2&3&2  AND       X_c-rvs-doc.obj-code  = &4  AND        X_c-rvs-doc.rvs-type  = &2&5&2
     2799         X_c-rvs-doc.is-del = yes ', v-cntxt-host-code-obj, chr(34), v-cntxt-obj-type, v-cntxt-obj-code, vartest-asi )   + " " + where-phrase-28
     2800             else "true"
     2801           )
     2802         parameter-5-28 = (" " + "" + " " + "")
     2803         parameter-6-28 = if sort-phrase-28 = ''
     2804                              then
     2805           (
     2806           " " + " USE-INDEX stat-fact " +
     2807             " " + sort-column-phrase +
     2808           " " + "  "
     2809           )
     2810                              else
     2811           (
     2812           " " + " USE-INDEX stat-fact " +
     2813             " " + sort-column-phrase +
     2814           " " + sort-phrase-28
     2815           )
     2816         parameter-7-28 =
     2817           " indexed-reposition  "
     2818       .
     2819       do
     2820       on stop undo, leave
     2821       on error undo, leave
     2822       :
     2823         assign
     2824           l-disable-where-28 =
     2825             ("       X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type  = vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2826          " + " " + where-phrase-28 = "")
     2827         .
     2828         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2829                             ,input QUERY br-docs:handle
     2830                             ,input parameter-3-28
     2831                             ,input parameter-4-28
     2832                             ,input parameter-5-28
     2833                             ,input parameter-6-28
     2834                             ,input parameter-7-28
     2835                             )
     2836         .
     2837         assign
     2838           l-filter-open-28 = true
     2839         .
     2840       end.
     2841       if l-filter-open-28 = false then do:
     2842         message
     2843           "Ошибка при фильтрации / сортировке" skip
     2844           "Будут показаны записи без учета фильтра" skip
     2845           view-as alert-box .
     2846       end.
     2847       else do:
     2848           assign
     2849             l-query-was-opened = true
     2850           .
     2851       end.
     2852     end.
     2853     if l-filter-open-28 = false then do:
     2854       OPEN QUERY br-docs FOR EACH X_c-rvs-doc
     2855         where        X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type  = vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2856          USE-INDEX stat-fact
     2857         indexed-reposition
     2858     .
     2859         assign
     2860           l-query-was-opened = true
     2861         .
     2862     end.
     2863   end.
     2864   else do:
     2865     assign
     2866       v-doc-rec = recid( X_c-rvs-doc )
     2867     .
     2868     do
     2869     on stop undo, leave
     2870     on error undo, leave
     2871     :
     2872       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer X_c-rvs-doc:handle) then do:
     2873         assign
     2874         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     2875         parameter-4-28 =
     2876           "where ":u +  substitute(' X_c-rvs-doc.host-code = &1 AND       X_c-rvs-doc.obj-type  = &2&3&2  AND       X_c-rvs-doc.obj-code  = &4  AND        X_c-rvs-doc.rvs-type  = &2&5&2
     2877         X_c-rvs-doc.is-del = yes ', v-cntxt-host-code-obj, chr(34), v-cntxt-obj-type, v-cntxt-obj-code, vartest-asi )   + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     2878         parameter-5-28 = " USE-INDEX stat-fact "
     2879       .
     2880         run fltopend_fltfindd in this-procedure  (
     2881                             input this-procedure:handle
     2882                             ,input QUERY br-docs:handle
     2883                             ,input rowid(X_c-rvs-doc)
     2884                             ,input logical(parameter-2-28)
     2885                             ,input no-lock
     2886                             ,input (buffer X_c-rvs-doc:handle)
     2887                             ,input parameter-4-28
     2888                             ,input parameter-5-28
     2889                             ) no-error.
     2890         .
     2891         assign
     2892           v-doc-rec = integer(return-value)
     2893           v-fltopend-rowid[1] = ?
     2894         .
     2895       end.
     2896       else do:
     2897         assign
     2898         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     2899         parameter-3-28 =  "FOR EACH X_c-rvs-doc"
     2900         parameter-4-28 =
     2901           (
     2902             if ("       X_c-rvs-doc.host-code = v-cntxt-host-code-obj AND       X_c-rvs-doc.obj-type  = v-cntxt-obj-type  AND       X_c-rvs-doc.obj-code  = v-cntxt-obj-code  AND       X_c-rvs-doc.rvs-type  = vartest-asi       AND       X_c-rvs-doc.is-del = yes and      x_c-rvs-doc.action = integer('99':U)
     2903          " + " " + where-phrase-28) <> ""
     2904             then  substitute(' X_c-rvs-doc.host-code = &1 AND       X_c-rvs-doc.obj-type  = &2&3&2  AND       X_c-rvs-doc.obj-code  = &4  AND        X_c-rvs-doc.rvs-type  = &2&5&2
     2905         X_c-rvs-doc.is-del = yes ', v-cntxt-host-code-obj, chr(34), v-cntxt-obj-type, v-cntxt-obj-code, vartest-asi )   + " " + where-phrase-28
     2906             else "true"
     2907           )
     2908         parameter-5-28 = (" " + "" + " " + "" + " " + p-find-condition)
     2909         parameter-6-28 = if sort-phrase-28 = ''
     2910                              then
     2911           (
     2912           " " + " USE-INDEX stat-fact " +
     2913             " " + sort-column-phrase +
     2914           " " + "  "
     2915           )
     2916                              else
     2917           (
     2918           " " + " USE-INDEX stat-fact " +
     2919             " " + sort-column-phrase +
     2920           " " + sort-phrase-28
     2921           )
     2922         parameter-7-28 =
     2923           " indexed-reposition  "
     2924       .
     2925         run fltopend_fltfindq in this-procedure  (
     2926                             input this-procedure:handle
     2927                             ,input QUERY br-docs:handle
     2928                             ,input logical(parameter-2-28)
     2929                             ,input no-lock
     2930                             ,input parameter-3-28
     2931                             ,input parameter-4-28
     2932                             ,input parameter-5-28
     2933                             ,input parameter-6-28
     2934                             ,input parameter-7-28
     2935                             ,output v-fltopend-rowid
     2936                             ) no-error.
     2937         .
     2938         v-doc-rec = ?.
     2939       end.
     2940       assign
     2941         l-query-was-opened = true
     2942       .
     2943     end.
     2944   end.
     2945     run waitfram-hide in this-procedure .
     2946   END.
     2947   END CASE.
     2948   if not p-open-query and v-doc-rec <> ? then
     2949   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     2950   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2951   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2952   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2953   APPLY "ENTRY" TO br-docs.
     2954   END PROCEDURE.
     2955   PROCEDURE proc-b-print :
     2956   DEFINE INPUT PARAMETER loc-option as character no-undo.
     2957   define variable glog as logical no-undo .
     2958   if loc-option = '':U then return error.
     2959   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2960   do:
     2961     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2962       (input  v-cntxt-db-num
     2963       ,input  v-cntxt-userid
     2964       ,input  0
     2965       ,input  'actn_rvs-doc_print':U
     2966       ,input  'object':U
     2967       ,input  v-cntxt-host-code-obj
     2968       ,input  v-cntxt-obj-type
     2969       ,input  v-cntxt-obj-code
     2970       ,input  0
     2971       ,input  0
     2972       ,input  0
     2973       ,input  true
     2974       ,output glog
     2975       )  .
     2976   end.
     2977   IF glog <> YES
     2978   THEN DO:
     2979   RETURN ERROR.
     2980   END.
     2981   loc-option = ''.
     2982   END PROCEDURE.
     2983   PROCEDURE proc-find-code :
     2984   define input parameter par-next as logical no-undo.
     2985   define input parameter pardoc-code like ub.add-line.doc-code no-undo.
     2986   display
     2987   "  /  /":U @ sch-date
     2988   "  /  /":U @ sch-fact
     2989   with frame Dialog-Frame.
     2990   assign
     2991   pardoc-code = chr(34) + pardoc-code + chr(34).
     2992   run OpenBr in this-procedure
     2993     (input false
     2994     ,input par-next
     2995     ,input substitute("and X_c-rvs-doc.rvs-code   begins &1 "
     2996       , pardoc-code)
     2997     ).
     2998   apply "entry":u to sch-code in frame Dialog-Frame .
     2999   END PROCEDURE.
     3000   PROCEDURE proc-find-date :
     3001   define input parameter par-next as logical no-undo.
     3002   define input parameter par-date like ub.c-rvs-doc.doc-date no-undo.
     3003   define input parameter parwhat-date as character no-undo.
     3004   define variable var-datechr as character no-undo.
     3005   display
     3006   '':U @ sch-code
     3007   with frame Dialog-Frame.
     3008   assign
     3009   var-datechr = string(day(par-date)) + chr(47) +
     3010                 string(month(par-date)) + chr(47) +
     3011                 string(year(par-date)).
     3012   case parwhat-date:
     3013     when "doc-date":U then do:
     3014       display
     3015       "  /  /":U @ sch-fact
     3016       with frame Dialog-Frame.
     3017       run OpenBr in this-procedure
     3018       (input false
     3019       ,input true
     3020       ,input substitute("and X_c-rvs-doc.doc-date = &1 "
     3021         , var-datechr)
     3022       ).
     3023       apply "entry":u to sch-date in frame Dialog-Frame.
     3024     end.
     3025     when "fact-date":U then do:
     3026       display
     3027       "  /  /":U @ sch-date
     3028       with frame Dialog-Frame.
     3029       run OpenBr in this-procedure
     3030         (input false
     3031         ,input true
     3032         ,input substitute("and X_c-rvs-doc.fact-date = &1 "
     3033         , var-datechr)
     3034         ).
     3035       apply "entry":u to sch-fact in frame Dialog-Frame.
     3036     end.
     3037   END case.
     3038   END PROCEDURE.
     3039   PROCEDURE reposition-c-rvs-doc :
     3040   define input  parameter p-direction   as character no-undo .
     3041   define output parameter p-rvs-doc-recid as recid no-undo .
     3042     case p-direction :
     3043       when "first":U
     3044       then do:
     3045         get first br-docs.
     3046       end.
     3047       when "last":U
     3048       then do:
     3049         get last br-docs.
     3050       end.
     3051       when "prev":U
     3052       then do:
     3053         get prev br-docs.
     3054         if not available X_c-rvs-doc then do:
     3055           message
     3056           "Это первый документ списка"
     3057           view-as alert-box.
     3058         end.
     3059       end.
     3060       when "next":U
     3061       then do:
     3062         get next br-docs.
     3063         if not available X_c-rvs-doc then do:
     3064           message
     3065           "Это последний документ списка"
     3066           view-as alert-box.
     3067         end.
     3068       end.
     3069     end case .
     3070     assign
     3071     p-rvs-doc-recid = recid(X_c-rvs-doc)
     3072     .
     3073     run reposition-query in this-procedure
     3074       (input p-rvs-doc-recid
     3075       ).
     3076   END PROCEDURE.
     3077   PROCEDURE reposition-query :
     3078   define input parameter p-recid as recid no-undo .
     3079     if p-recid <> ?
     3080     then do:
     3081       reposition br-docs to recid p-recid no-error.
     3082     end.
     3083     do with frame Dialog-Frame:
     3084       apply "entry":u to browse BR-docs .
     3085       apply "VALUE-CHANGED":u to browse BR-docs .
     3086     end.
     3087   END PROCEDURE.
