        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-user-id     AS CHARACTER     NO-UNDO.
        3   DEFINE INPUT PARAMETER p-db-num      AS integer       NO-UNDO.
        4   DEFINE INPUT PARAMETER p-obj-type      AS CHARACTER        NO-UNDO.
        5   DEFINE INPUT PARAMETER p-obj-code      AS integer       NO-UNDO.
        6   DEFINE TEMP-TABLE tt-work-place NO-UNDO
        7       FIELD wp-code AS INTEGER   column-label "№"             FORMAT ">>>>9"
        8       FIELD wp-type AS CHARACTER column-label "тип"           FORMAT "x(3)"
        9       FIELD wp-host AS INTEGER   column-label "фирма"         FORMAT ">>>>9"
       10       FIELD wp-name AS CHARACTER column-label "наименование"  FORMAT "x(40)"
       11       FIELD context AS CHARACTER column-label "привязка"
       12       FIELD db-num  AS INTEGER   column-label "БД"            FORMAT ">>>>9"
       13   INDEX i-code-type IS PRIMARY UNIQUE
       14         wp-code
       15         wp-type
       16   INDEX i-host
       17         wp-host
       18   index i-context
       19         context
       20   .
       21   define temp-table temp_filter-fields no-undo
       22       field action-role-code as integer
       23       field record-on        as logical
       24       index pi is primary unique
       25           action-role-code
       26   .
       27   define temp-table temp_filter-fields-item no-undo
       28       field action-item-code as integer
       29       field record-on        as logical
       30       index pi is primary unique
       31           action-item-code
       32   .
       33   define buffer br_tt-work-place            for tt-work-place.
       34   define buffer br_user-login-action-role   for user-login-action-role.
       35   define buffer buf_user-login-action-role  for user-login-action-role.
       36   define buffer br_action-role             for action-role.
       37   define buffer br_action-role-item        for action-role-item.
       38   define buffer br_action-item             for action-item.
       39   define buffer br_temp_filter-fields-item for temp_filter-fields-item .
       40   define variable vss-revision    as character no-undo init "$Revision$":U .
       41   define variable vss-author      as character no-undo init "$Author$":U .
       42   define variable vss-date        as character no-undo init "$Date$":U .
       43   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       44   define variable vss-archive     as character no-undo init "$Archive$":U .
       45   define variable vss-description as character no-undo init "Редактирование привязки группы прав к пользователю из списка объектов или фирм".
       46   procedure vss-get-info :
       47     define output parameter p-vss-revision    like vss-revision    no-undo .
       48     define output parameter p-vss-author      like vss-author      no-undo .
       49     define output parameter p-vss-date        like vss-date        no-undo .
       50     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       51     define output parameter p-vss-archive     like vss-archive     no-undo .
       52     define output parameter p-vss-description like vss-description no-undo .
       53     assign
       54       p-vss-revision    = vss-revision
       55       p-vss-author      = vss-author
       56       p-vss-date        = vss-date
       57       p-vss-workfile    = vss-workfile
       58       p-vss-archive     = vss-archive
       59       p-vss-description = vss-description
       60     .
       61   end procedure.
       62   procedure vss-get-parameters :
       63     define output parameter p-vss-parameters as character no-undo .
       64   end procedure.
       65   define new global shared variable g#vssrevis-logger as handle    no-undo .
       66   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       67   define variable v-vssrevis-logger                   as handle    no-undo .
       68   procedure vss-logevent :
       69     define input  parameter p-extra-paramters as character no-undo .
       70     define variable v-vssrevis-parameters as character no-undo .
       71     do
       72     on error undo, return error return-value
       73     :
       74       if  valid-handle(v-vssrevis-logger)
       75       and v-vssrevis-logger :get-signature("logevent") <> ""
       76       then do:
       77         run vss-get-parameters in this-procedure
       78           (output v-vssrevis-parameters
       79           ).
       80         run logevent in v-vssrevis-logger
       81           (input vss-workfile
       82           ,input vss-revision
       83           ,input v-vssrevis-parameters
       84           ,input p-extra-paramters
       85           ).
       86       end.
       87     end.
       88   end procedure.
       89   assign
       90     v-vssrevis-logger = g#vssrevis-logger
       91   .
       92   if  valid-handle(v-vssrevis-logger)
       93   and v-vssrevis-logger :get-signature("logevent") <> ""
       94   then do:
       95     assign
       96       v-vssrevis-logevent = true
       97     .
       98     run vss-logevent in this-procedure (input vss-description) .
       99   end.
      100   define new global shared variable g#language as character no-undo .
      101   if g#language <> '' and g#language <> 'rus':U then do:
      102     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      103   end.
      104   define new global shared variable g#library  as handle no-undo .
      105   define new global shared variable g#library2 as handle no-undo .
      106   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107     define variable v-cntxt-db-num        as integer   no-undo .
      108     define variable v-cntxt-userid        as character no-undo .
      109     define variable v-cntxt-level         as character no-undo .
      110     define variable v-cntxt-host-code-obj as integer   no-undo .
      111     define variable v-cntxt-obj-type      as character no-undo .
      112     define variable v-cntxt-obj-code      as integer   no-undo .
      113     define variable v-cntxt-db-num-obj    as integer   no-undo .
      114     define variable v-cntxt-is-admin      as logical   no-undo .
      115   procedure proc-alt-shift-f2:
      116     if not ibs.th.gbl.gbl-var:rcode
      117   then
      118     run gbl\inidebug.p .
      119   end.
      120   procedure proc-alt-shift-f3:
      121     run gbl/prvssinf.p
      122       ( input this-procedure
      123       ) .
      124   end.
      125   define variable v-inform-launched as logical no-undo initial false .
      126   procedure proc-alt-shift-f4:
      127     define variable v-action as character no-undo .
      128     if v-inform-launched = false then do:
      129       assign
      130         v-inform-launched = true
      131       .
      132       run gbl/d-inform.w
      133         (  input self
      134         ,  input this-procedure
      135         , output v-action
      136         ) no-error .
      137       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      138       assign
      139         v-inform-launched = false
      140       .
      141     end.
      142   end.
      143   procedure proc-alt-f1:
      144     run gbl/corrhelp.p
      145       (input this-procedure
      146       ) .
      147   end .
      148   on alt-shift-f2 anywhere do:
      149     run proc-alt-shift-f2.
      150   end.
      151   on alt-shift-f3 anywhere do:
      152     run proc-alt-shift-f3 in this-procedure .
      153   end.
      154   on alt-shift-f4 anywhere do:
      155     run proc-alt-shift-f4 in this-procedure.
      156   end.
      157   on alt-f1 anywhere do:
      158     run proc-alt-f1 in this-procedure .
      159   end.
      160   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   function usrnickf returns character ( input p-user-id as character):
      162      define variable v-nick      as character    no-undo.
      163      if p-user-id = ?
      164      OR p-user-id = "":U
      165      then do:
      166         return '':U .
      167      end.
      168   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
      170     (input  p-user-id
      171     ,output v-nick
      172     ) no-error .
      173      if error-status :error
      174      then do:
      175         return p-user-id.
      176      end.
      177      else do:
      178         return v-nick.
      179      end.
      180   end function.
      181   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      183   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      184   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      185   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      186   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      187   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      188   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      189   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      190   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      191   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      192   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      193   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      194   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      195   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      196   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      197   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      198   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      199   define variable v-context  as character no-undo format "x(8)" column-label "Привязка".
      200   define variable v-state    as character no-undo format "x(3)" column-label "Вкл" .
      201   DEFINE VARIABLE g#log      AS LOGICAL   NO-UNDO.
      202   define variable v-flt-role    as character    no-undo.
      203   define variable v-flt-item    as character    no-undo.
      204   define variable v-on-gbl    as logical      no-undo.
      205   FUNCTION get-item-state RETURNS CHARACTER
      206     ( BUFFER buf_action-item FOR action-item )  FORWARD.
      207   FUNCTION get-role-context RETURNS CHARACTER
      208     ( BUFFER buf_user-login-action-role FOR user-login-action-role )  FORWARD.
      209   DEFINE BUTTON b-add
      210        LABEL "Добавить"
      211        SIZE 10 BY 1.
      212   DEFINE BUTTON b-del
      213        LABEL "Удалить"
      214        SIZE 10 BY 1.
      215   DEFINE BUTTON b-exit AUTO-GO
      216        LABEL "&Выход"
      217        SIZE 10 BY 1
      218        BGCOLOR 8 .
      219   DEFINE BUTTON b-filter
      220        LABEL "ФПоиск"
      221        SIZE 10 BY 1.
      222   DEFINE BUTTON b-help
      223        LABEL "&Помощь"
      224        SIZE 10 BY 1
      225        BGCOLOR 8 .
      226   DEFINE VARIABLE item-EDITOR AS CHARACTER
      227        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      228        SIZE 47.5 BY 1.58 TOOLTIP "Описание права" NO-UNDO.
      229   DEFINE VARIABLE role-EDITOR AS CHARACTER
      230        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      231        SIZE 49.5 BY 1.5 TOOLTIP "Описание группы" NO-UNDO.
      232   DEFINE VARIABLE v-filter AS CHARACTER FORMAT "X(256)":U
      233        VIEW-AS FILL-IN
      234        SIZE 44.5 BY 1 NO-UNDO.
      235   DEFINE VARIABLE tb-filter AS LOGICAL INITIAL no
      236        LABEL ""
      237        VIEW-AS TOGGLE-BOX
      238        SIZE 3 BY .83 NO-UNDO.
      239   DEFINE VARIABLE tg-detail AS LOGICAL INITIAL yes
      240        LABEL "Детализировать по группам"
      241        VIEW-AS TOGGLE-BOX
      242        SIZE 27.5 BY .75 NO-UNDO.
      243   DEFINE QUERY browse-action-item FOR
      244         buf_user-login-action-role,
      245         br_action-role-item,
      246         br_temp_filter-fields-item,
      247         br_action-item SCROLLING.
      248   DEFINE QUERY browse-br_user-login-action-role FOR
      249         br_user-login-action-role,
      250         br_action-role,
      251         temp_filter-fields SCROLLING.
      252   DEFINE BROWSE browse-action-item
      253     QUERY browse-action-item DISPLAY
      254            br_action-item.action-item-name
      255            br_action-item.action-item-id
      256       WITH NO-ROW-MARKERS SEPARATORS SIZE 47.5 BY 15.5.
      257   DEFINE BROWSE browse-br_user-login-action-role
      258     QUERY browse-br_user-login-action-role DISPLAY
      259         get-role-context(BUFFER br_user-login-action-role) @ v-context column-label "Привязка"
      260         br_action-role.action-role-name                                column-label "Название группы прав"
      261       WITH NO-ROW-MARKERS SEPARATORS SIZE 49.5 BY 15.5.
      262   DEFINE FRAME Dialog-Frame
      263        b-exit AT ROW 1 COL 1
      264        b-add AT ROW 1 COL 11 WIDGET-ID 6
      265        b-del AT ROW 1 COL 21 WIDGET-ID 8
      266        b-help AT ROW 1 COL 89.5
      267        tg-detail AT ROW 1.08 COL 31.5 WIDGET-ID 14
      268        b-filter AT ROW 2 COL 1 WIDGET-ID 16
      269        v-filter AT ROW 2 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 18 NO-TAB-STOP
      270        tb-filter AT ROW 2 COL 57 WIDGET-ID 20
      271        browse-br_user-login-action-role AT ROW 3.25 COL 1.5 WIDGET-ID 200
      272        browse-action-item AT ROW 3.25 COL 51.75 WIDGET-ID 300
      273        role-EDITOR AT ROW 19 COL 1.5 NO-LABEL WIDGET-ID 22
      274        item-EDITOR AT ROW 19 COL 52 NO-LABEL WIDGET-ID 24
      275        SPACE(0.00) SKIP(0.08)
      276       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      277            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      278            TITLE "Права пользователя"
      279            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      280   ASSIGN
      281          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      282          FRAME Dialog-Frame:HIDDEN           = TRUE.
      283   ASSIGN
      284          item-EDITOR:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      285   ASSIGN
      286          role-EDITOR:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      287   ASSIGN
      288          v-filter:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      289   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      290   DO:
      291     APPLY "END-ERROR":U TO SELF.
      292   END.
      293   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      294   DO:
      295      IF available br_tt-work-place THEN do:
      296         RUN add-action-roles in this-procedure no-error.
      297         IF ERROR-STATUS:ERROR THEN DO:
      298            MESSAGE RETURN-VALUE SKIP
      299                     ERROR-STATUS:GET-MESSAGE(1)
      300            VIEW-AS ALERT-BOX.
      301            UNDO, RETURN NO-APPLY.
      302         END.
      303         run assign-filter-mark in this-procedure (
      304               input v-flt-role
      305            , input v-flt-item
      306         ).
      307         run refresh-action-role in this-procedure .
      308         run post_enable_UI IN THIS-PROCEDURE.
      309      end.
      310   END.
      311   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      312   DO:
      313      IF AVAILABLE br_action-role THEN DO:
      314         MESSAGE SUBSTITUTE( "Отключить группу прав (&1) для пользователя &2?"
      315                           , br_action-role.action-role-name
      316                           , usrnickf( p-user-id )
      317                           )
      318         VIEW-AS ALERT-BOX
      319         BUTTONS YES-NO
      320         UPDATE v-yes AS LOGICAL
      321         .
      322         IF v-yes THEN DO:
      323            RUN delete-user-role.
      324         END.
      325         run refresh-action-role in this-procedure .
      326         run post_enable_UI IN THIS-PROCEDURE.
      327      END.
      328   END.
      329   ON CHOOSE OF b-filter IN FRAME Dialog-Frame
      330   DO:
      331      define variable v-ok    as logical      no-undo.
      332         run adm/actnrolf.w (
      333             input-output v-flt-role
      334           , input-output v-flt-item
      335           , output v-ok
      336       ) no-error.
      337      if error-status :error
      338      then do:
      339         message
      340                  vss-workfile vss-revision vss-description
      341            skip(1)
      342            skip "Ошибка изменения фильтра."
      343            skip return-value
      344            skip trim( error-status :get-message( 1 ) )
      345                  trim( error-status :get-message( 2 ) )
      346                  trim( error-status :get-message( 3 ) )
      347         view-as alert-box error.
      348         undo, return no-apply.
      349      end.
      350      IF NOT v-ok then do:
      351         RETURN NO-APPLY.
      352      end.
      353      IF v-flt-role <> "":U THEN DO:
      354         IF v-flt-item <> "":U THEN DO:
      355         assign
      356            v-filter = SUBSTITUTE("В группе: &1, в правах: &2", v-flt-role, v-flt-item)
      357         .
      358         END.
      359         else do:
      360         assign
      361            v-filter = SUBSTITUTE("В группе: &1", v-flt-role)
      362         .
      363         end.
      364      end.
      365      else do:
      366         IF v-flt-item <> "":U THEN DO:
      367         assign
      368            v-filter = SUBSTITUTE("В правах: &1", v-flt-item)
      369         .
      370         END.
      371         else do:
      372         assign
      373            v-filter = "":U
      374         .
      375         end.
      376      end.
      377      if v-filter = "":U
      378      then do:
      379         assign
      380               tb-filter               = no
      381               tb-filter :sensitive    = no
      382         .
      383         assign
      384               v-filter :bgcolor   = GREY_COLOR
      385               b-filter :bgcolor = GREY_COLOR
      386         .
      387      end.
      388      else do:
      389         assign
      390               tb-filter = yes
      391               tb-filter :sensitive    = yes
      392         .
      393         assign
      394               v-filter :bgcolor = RED_COLOR
      395               b-filter :bgcolor = RED_COLOR
      396         .
      397      end.
      398      display
      399         v-filter
      400         tb-filter
      401      with frame Dialog-Frame.
      402   if session :set-wait-state( "compiler" ) then.
      403      run assign-filter-mark in this-procedure (
      404            input v-flt-role
      405         , input v-flt-item
      406      ).
      407      RUN enable_UI.
      408      RUN post_enable_UI IN THIS-PROCEDURE.
      409   if session :set-wait-state( "" ) then.
      410   END.
      411   ON VALUE-CHANGED OF browse-action-item IN FRAME Dialog-Frame
      412   DO:
      413      if available br_action-item then do:
      414       assign
      415           item-editor = br_action-item.action-item-description
      416       .
      417       display
      418         item-editor
      419       with frame Dialog-Frame.
      420     end.
      421   END.
      422   ON VALUE-CHANGED OF browse-br_user-login-action-role IN FRAME Dialog-Frame
      423   DO:
      424     run refresh-action-item in this-procedure .
      425     if available br_action-role then do:
      426         assign
      427             role-editor = br_action-role.action-role-description
      428         .
      429         display
      430            role-editor
      431         with frame Dialog-Frame.
      432       end.
      433   END.
      434   ON VALUE-CHANGED OF tb-filter IN FRAME Dialog-Frame
      435   DO:
      436       assign
      437           tb-filter
      438       .
      439       if tb-filter = yes
      440       then do:
      441           assign
      442               v-filter :bgcolor = RED_COLOR
      443               b-filter :bgcolor = RED_COLOR
      444           .
      445            run assign-filter-mark in this-procedure (
      446                  input v-flt-role
      447               , input v-flt-item
      448            ).
      449       end.
      450       else do:
      451           assign
      452               v-filter :bgcolor = GREY_COLOR
      453               b-filter :bgcolor = GREY_COLOR
      454           .
      455            run assign-filter-mark in this-procedure (
      456                  input "":U
      457                , input "":U
      458            ).
      459       end.
      460      RUN enable_UI.
      461      RUN post_enable_UI IN THIS-PROCEDURE.
      462   END.
      463   ON VALUE-CHANGED OF tg-detail IN FRAME Dialog-Frame
      464   DO:
      465     IF LOGICAL(tg-detail:screen-value) then do:
      466         assign
      467            browse-br_user-login-action-role:hidden = FALSE
      468         .
      469         ENABLE
      470            browse-br_user-login-action-role
      471            b-del
      472         WITH FRAME Dialog-Frame.
      473     end.
      474     else do:
      475         assign
      476            browse-br_user-login-action-role:hidden = TRUE
      477         .
      478         disable
      479           browse-br_user-login-action-role
      480           b-del
      481         WITH FRAME Dialog-Frame.
      482     end.
      483      run assign-filter-mark in this-procedure (
      484            input v-flt-role
      485         , input v-flt-item
      486      ).
      487     RUN refresh-action-role IN THIS-PROCEDURE .
      488     run post_enable_UI IN THIS-PROCEDURE.
      489   END.
      490   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      491   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      492   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   on help of frame Dialog-Frame
      494   do:
      495     run gbl/app_help.p
      496       (input this-procedure :file-name
      497       ,input ''
      498       ,input ?
      499       ) no-error.
      500     if error-status :error then do:
      501       message
      502         "Ошибка при вызове помощи"
      503         error-status :get-message(1)
      504         view-as alert-box .
      505     end.
      506   end.
      507   run minbtn-set in this-procedure .
      508   on choose of b-help in frame Dialog-Frame
      509   do:
      510     apply "help":u to frame Dialog-Frame .
      511   end.
      512   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   procedure minbtn-set :
      514       do
      515           on error undo, return error return-value
      516           :
      517           define variable ii              as integer       no-undo .
      518           define variable fh              as widget-handle no-undo .
      519           define variable hh              as widget-handle no-undo .
      520           define variable v-h             as handle        extent 4 no-undo .
      521           define variable v-name-button   as character     no-undo .
      522           define variable v-help-old-x    as decimal       no-undo .
      523           define variable v-help-old-y    as decimal       no-undo .
      524           define variable v-help-old-size as decimal       no-undo .
      525           define variable v-frame-width   as decimal       no-undo .
      526           define variable jj              as integer       no-undo .
      527           do
      528               on error undo, return error
      529               :
      530               assign
      531                   v-frame-width = frame Dialog-Frame:width - 0.3
      532                   fh            = frame Dialog-Frame:first-child
      533                   hh            = fh:first-child
      534                   ii            = 1
      535                   .
      536               do while valid-handle(hh):
      537                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      538                   do:
      539                       case lc(hh:name) :
      540                           when "b-help" then
      541                               do:
      542                                   hh:load-image-up("cmp/b-help.bmp":u) .
      543                                   hh:load-image-down("cmp/b-help.bmp":u) .
      544                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      545                                   hh:TOOLTIP = "Помощь" .
      546                                   v-help-old-x = hh:column .
      547                                   v-help-old-y = hh:row    .
      548                                   v-help-old-size = hh:width .
      549                                   hh:width-chars = 2.5 .
      550                               end.
      551                           when "b-print" then
      552                               do:
      553                                   hh:load-image("cmp/b-print.bmp":u) .
      554                                   hh:TOOLTIP = "Печать" .
      555                                   v-h[ii] = hh:handle .
      556                                   ii = ii + 1 .
      557                                   hh:width-chars = 3 .
      558                               end.
      559                           when "b-history" or
      560                           when "b-hist" then
      561                               do:
      562                                   hh:load-image("cmp/b-hist.bmp":u) .
      563                                   hh:TOOLTIP = "История" .
      564                                   v-h[ii] = hh:handle .
      565                                   ii = ii + 1 .
      566                                   hh:width-chars = 3 .
      567                               end.
      568                           when "b-sch" then
      569                               do:
      570                                   hh:load-image("cmp/b-sch.bmp":u) .
      571                                   hh:TOOLTIP = "Установка Фильтра" .
      572                                   v-h[ii] = hh:handle .
      573                                   ii = ii + 1 .
      574                                   hh:width-chars = 3 .
      575                               end.
      576                           when "b-hist-user" then
      577                               do:
      578                                   hh:load-image("cmp/b-hist.bmp":u) .
      579                                   hh:TOOLTIP = "История пользователя" .
      580                                   ii = ii + 1 .
      581                               end.
      582                       end case.
      583                   end.
      584                   hh = hh:next-sibling.
      585               end.
      586               b-help:column = v-frame-width - b-help:width-chars.
      587               jj = 0.
      588               repeat ii = 4 to 1 by -1 :
      589                   if valid-handle (v-h[ii] ) then
      590                   do:
      591                       jj  = jj + 1 .
      592                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      593                       v-h[ii]:row    = v-help-old-y .
      594                   end.
      595               end.
      596           end.
      597       end.
      598   end procedure.
      599   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      600   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      601   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      602   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      603   define variable v-diasize-current-frame-width  as decimal   no-undo .
      604   define variable v-diasize-current-frame-height as decimal   no-undo .
      605   define variable v-diasize-change-size          as logical   no-undo .
      606   define variable v-diasize-resize-button        as handle    no-undo .
      607   define variable v-diasize-wndmax               as logical   no-undo .
      608   define variable v-diasize-wndstore             as logical   no-undo .
      609   define variable v-diasize-proc-name            as character no-undo .
      610   define variable v-diasize-browse-handle        as handle    no-undo .
      611   define variable v-diasize-browse-number        as integer   no-undo .
      612   define variable v-diasize-need-full-display    as logical   no-undo init false .
      613   define temp-table temp-diasize-handle no-undo
      614     field handle-value  as handle
      615     field save-position as decimal
      616     index xpk is primary unique handle-value
      617     .
      618   define temp-table temp-browse-handle no-undo
      619     field browse-type   as character
      620     field browse-number as integer
      621     field browse-handle as handle
      622     field original-size as decimal
      623     index xpk is primary unique browse-type browse-number
      624     index xie browse-type browse-handle
      625   .
      626   procedure diasize_change-height :
      627     define input  parameter p-change-value  as decimal   no-undo .
      628     define input  parameter p-move-resize   as logical   no-undo .
      629     define variable v-field-group-handle    as handle    no-undo .
      630     define variable v-object-handle         as handle    no-undo .
      631     define variable v-frame-height          as decimal   no-undo .
      632     define variable v-frame-virtual-height  as decimal   no-undo .
      633     define variable v-browse-height         as decimal   no-undo .
      634     define variable v-window-height         as decimal   no-undo .
      635     define variable v-window-virtual-height as decimal   no-undo .
      636     define variable v-change-sign           as integer   no-undo .
      637     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      638     define buffer buf_temp-browse-handle  for temp-browse-handle .
      639     if p-change-value > 0
      640     then do:
      641       if frame Dialog-Frame :height + p-change-value
      642           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      643       then do:
      644         assign
      645           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      646                           - (frame Dialog-Frame :height-chars)
      647         .
      648         if p-change-value <= 0
      649         then do:
      650           run diasize_position-resize-button in this-procedure .
      651           return .
      652         end.
      653       end.
      654     end.
      655     if p-change-value < 0
      656     then do:
      657       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      658       then do:
      659         assign
      660           p-change-value = v-diasize-orig-frame-height
      661                          - (frame Dialog-Frame :height-chars)
      662         .
      663         if p-change-value >= 0
      664         then do:
      665           run diasize_position-resize-button in this-procedure .
      666           return .
      667         end.
      668       end.
      669     end.
      670     if p-change-value >= 0
      671     then do:
      672       assign
      673         v-change-sign = 1
      674       .
      675     end.
      676     else do:
      677       assign
      678         v-change-sign = -1
      679       .
      680     end.
      681     assign
      682       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      683     .
      684     if p-change-value = 0
      685     then do:
      686       run diasize_position-resize-button in this-procedure .
      687       return .
      688     end.
      689     move_block:
      690     do
      691     on error undo move_block, retry move_block
      692     :
      693       if retry
      694       then do:
      695         do
      696         on error undo move_block, leave move_block
      697         :
      698           if p-change-value > 0
      699           then do:
      700             for each buf_temp-diasize-handle
      701             on error undo, next
      702             :
      703               assign
      704                 v-object-handle = buf_temp-diasize-handle.handle-value
      705               .
      706               if v-object-handle <> v-diasize-resize-button
      707               then do:
      708                 assign
      709                   v-object-handle :row = buf_temp-diasize-handle.save-position
      710                 .
      711               end.
      712             end.
      713             assign
      714               v-diasize-browse-handle :height = v-browse-height
      715             .
      716             for each buf_temp-browse-handle
      717               where buf_temp-browse-handle.browse-type = 'height':u
      718             on error undo, next
      719             :
      720               assign
      721                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      722               .
      723             end.
      724             assign
      725               frame Dialog-Frame :height = v-frame-height
      726             .
      727             if frame Dialog-Frame :scrollable = true
      728             then do:
      729               assign
      730                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      731               .
      732             end.
      733             run diasize_position-resize-button in this-procedure .
      734           end.
      735           else do:
      736             if frame Dialog-Frame :scrollable = true
      737             then do:
      738               assign
      739                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      740               .
      741             end.
      742             assign
      743               frame Dialog-Frame :height = v-frame-height
      744             .
      745             assign
      746               v-diasize-browse-handle :height = v-browse-height
      747             .
      748             for each buf_temp-browse-handle
      749               where buf_temp-browse-handle.browse-type = 'height':u
      750             on error undo, next
      751             :
      752               assign
      753                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      754               .
      755             end.
      756             for each buf_temp-diasize-handle
      757             on error undo, next
      758             :
      759               assign
      760                 v-object-handle = buf_temp-diasize-handle.handle-value
      761               .
      762               if v-object-handle <> v-diasize-resize-button
      763               then do:
      764                 assign
      765                   v-object-handle :row = buf_temp-diasize-handle.save-position
      766                 .
      767               end.
      768             end.
      769             run diasize_position-resize-button in this-procedure .
      770           end.
      771           assign
      772             v-diasize-change-size = false
      773           .
      774           leave move_block .
      775         end.
      776       end.
      777       assign
      778         v-diasize-need-full-display = true
      779       .
      780       if v-diasize-change-size = false
      781       then do:
      782         assign
      783           v-diasize-change-size = true
      784         .
      785       end.
      786       else do:
      787         return .
      788       end.
      789       assign
      790         v-frame-height = frame Dialog-Frame :height
      791         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      792         v-browse-height = v-diasize-browse-handle :height
      793       .
      794       for each buf_temp-browse-handle
      795         where buf_temp-browse-handle.browse-type = 'height':u
      796       :
      797         assign
      798           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      799         .
      800       end.
      801       for each buf_temp-diasize-handle
      802       :
      803         delete buf_temp-diasize-handle .
      804       end.
      805       assign
      806         v-field-group-handle = frame Dialog-Frame :first-child
      807       .
      808       do while valid-handle(v-field-group-handle)
      809       :
      810         assign
      811           v-object-handle = v-field-group-handle :first-child
      812         .
      813         do while valid-handle(v-object-handle)
      814         :
      815           if  v-object-handle <> v-diasize-browse-handle :handle
      816           and can-query(v-object-handle, "row")
      817           and can-query(v-object-handle, "height")
      818           and ( v-object-handle :row > v-diasize-browse-handle :row )
      819           then do:
      820             find first buf_temp-browse-handle
      821               where buf_temp-browse-handle.browse-type   = 'height':u
      822                 and buf_temp-browse-handle.browse-handle = v-object-handle
      823               no-error .
      824             if available buf_temp-browse-handle
      825             then do:
      826             end.
      827             else do:
      828               create buf_temp-diasize-handle .
      829               assign
      830                 buf_temp-diasize-handle.handle-value  = v-object-handle
      831                 buf_temp-diasize-handle.save-position = v-object-handle :row
      832               .
      833             end.
      834           end.
      835           assign
      836             v-object-handle = v-object-handle :next-sibling
      837           .
      838         end.
      839         assign
      840           v-field-group-handle = v-field-group-handle :next-sibling
      841         .
      842       end.
      843       do with frame Dialog-Frame
      844       :
      845         hide v-diasize-resize-button .
      846         assign
      847           v-diasize-resize-button :row    = 1
      848           v-diasize-resize-button :column = 1
      849         .
      850       end.
      851       if p-change-value > 0
      852       then do:
      853         if frame Dialog-Frame :scrollable = true
      854         then do:
      855           assign
      856             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      857             no-error .
      858           if error-status :error
      859           or error-status :get-message(1) <> ""
      860           then do:
      861             undo move_block, retry move_block .
      862           end.
      863         end.
      864         assign
      865           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      866           no-error .
      867         if error-status :error
      868         or error-status :get-message(1) <> ""
      869         then do:
      870           undo move_block, retry move_block .
      871         end.
      872         assign
      873           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      874           no-error .
      875         if error-status :error
      876         or error-status :get-message(1) <> ""
      877         then do:
      878           undo move_block, retry move_block .
      879         end.
      880         for each buf_temp-browse-handle
      881           where buf_temp-browse-handle.browse-type = 'height':u
      882         on error undo move_block, retry move_block
      883         :
      884           assign
      885             buf_temp-browse-handle.browse-handle :height
      886               = buf_temp-browse-handle.browse-handle :height + p-change-value
      887             no-error .
      888           if error-status :error
      889           or error-status :get-message(1) <> ""
      890           then do:
      891             undo move_block, retry move_block .
      892           end.
      893         end.
      894         for each buf_temp-diasize-handle
      895         on error undo move_block, retry move_block
      896         :
      897           assign
      898             v-object-handle = buf_temp-diasize-handle.handle-value
      899           .
      900           if v-object-handle <> v-diasize-resize-button
      901           then do:
      902             assign
      903               v-object-handle :row = v-object-handle :row + p-change-value
      904               no-error .
      905             if error-status :error
      906             or error-status :get-message(1) <> ""
      907             then do:
      908               undo move_block, retry move_block .
      909             end.
      910           end.
      911         end.
      912       end.
      913       else do:
      914         for each buf_temp-diasize-handle
      915         on error undo move_block, retry move_block
      916         :
      917           assign
      918             v-object-handle = buf_temp-diasize-handle.handle-value
      919           .
      920           if v-object-handle <> v-diasize-resize-button
      921           then do:
      922             assign
      923               v-object-handle :row = v-object-handle :row + p-change-value
      924               no-error .
      925             if error-status :error
      926             or error-status :get-message(1) <> ""
      927             then do:
      928               undo move_block, retry move_block .
      929             end.
      930           end.
      931         end.
      932         assign
      933           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      934           no-error .
      935         if error-status :error
      936         or error-status :get-message(1) <> ""
      937         then do:
      938           undo move_block, retry move_block .
      939         end.
      940         for each buf_temp-browse-handle
      941           where buf_temp-browse-handle.browse-type = 'height':u
      942         on error undo move_block, retry move_block
      943         :
      944           assign
      945             buf_temp-browse-handle.browse-handle :height
      946               = buf_temp-browse-handle.browse-handle :height + p-change-value
      947             no-error .
      948           if error-status :error
      949           or error-status :get-message(1) <> ""
      950           then do:
      951             undo move_block, retry move_block .
      952           end.
      953         end.
      954         assign
      955           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      956           no-error .
      957         if error-status :error
      958         or error-status :get-message(1) <> ""
      959         then do:
      960           undo move_block, retry move_block .
      961         end.
      962         if frame Dialog-Frame :scrollable = true
      963         then do:
      964           assign
      965             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      966             no-error .
      967           if error-status :error
      968           or error-status :get-message(1) <> ""
      969           then do:
      970             undo move_block, retry move_block .
      971           end.
      972         end.
      973       end.
      974       if p-move-resize = true
      975       then do:
      976         run diasize_position-resize-button in this-procedure .
      977       end.
      978       if v-diasize-wndstore = true
      979       then do:
      980         if connected("ub") = true
      981         then do:
      982           define variable v-cntxt-db-num        as integer   no-undo .
      983           define variable v-cntxt-userid        as character no-undo .
      984           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      985                                             , OUTPUT v-cntxt-userid
      986                                             ) .
      987           run gbl/wndsizew.p
      988             (input  v-cntxt-db-num
      989             ,input  v-cntxt-userid
      990             ,input  v-diasize-proc-name
      991             ,input  'height':u
      992             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      993             ) .
      994         end.
      995       end.
      996     end.
      997     assign
      998       v-diasize-change-size = false
      999     .
     1000   end procedure.
     1001   procedure diasize_set-height :
     1002     define input  parameter p-new-height  as decimal   no-undo .
     1003     define input  parameter p-move-resize as logical   no-undo .
     1004     do
     1005     on error undo, return error return-value
     1006     :
     1007       run diasize_change-height in this-procedure
     1008         (input  (p-new-height - frame Dialog-Frame :height)
     1009         ,input  p-move-resize
     1010         ) .
     1011     end.
     1012   end procedure.
     1013   procedure diasize_change-width :
     1014     define input  parameter p-change-value as decimal   no-undo .
     1015     define input  parameter p-move-resize  as logical   no-undo .
     1016     define variable v-field-group-handle   as handle    no-undo .
     1017     define variable v-object-handle        as handle    no-undo .
     1018     define variable v-frame-width          as decimal   no-undo .
     1019     define variable v-frame-virtual-width  as decimal   no-undo .
     1020     define variable v-browse-width         as decimal   no-undo .
     1021     define variable v-window-width         as decimal   no-undo .
     1022     define variable v-window-virtual-width as decimal   no-undo .
     1023     define variable v-change-sign          as integer   no-undo .
     1024     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1025     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1026     if p-change-value > 0
     1027     then do:
     1028       if frame Dialog-Frame :width + p-change-value >
     1029           session :width-chars
     1030       then do:
     1031         assign
     1032           p-change-value = session :width-chars - frame Dialog-Frame :width
     1033         .
     1034         if p-change-value <= 0
     1035         then do:
     1036           run diasize_position-resize-button in this-procedure .
     1037           return .
     1038         end.
     1039       end.
     1040     end.
     1041     if p-change-value < 0
     1042     then do:
     1043       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1044       then do:
     1045         assign
     1046           p-change-value = v-diasize-orig-frame-width
     1047                          - frame Dialog-Frame :width
     1048         .
     1049         if p-change-value >= 0
     1050         then do:
     1051           run diasize_position-resize-button in this-procedure .
     1052           return .
     1053         end.
     1054       end.
     1055     end.
     1056     if p-change-value >= 0
     1057     then do:
     1058       assign
     1059         v-change-sign = 1
     1060       .
     1061     end.
     1062     else do:
     1063       assign
     1064         v-change-sign = -1
     1065       .
     1066     end.
     1067     assign
     1068       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1069     .
     1070     if p-change-value = 0
     1071     then do:
     1072       run diasize_position-resize-button in this-procedure .
     1073       return .
     1074     end.
     1075     move_block:
     1076     do
     1077     on error undo move_block, leave move_block
     1078     :
     1079       if retry
     1080       then do:
     1081         do
     1082         on error undo move_block, leave move_block
     1083         :
     1084           if p-change-value > 0
     1085           then do:
     1086             for each buf_temp-diasize-handle
     1087             on error undo, next
     1088             :
     1089               assign
     1090                 v-object-handle = buf_temp-diasize-handle.handle-value
     1091               .
     1092               if v-object-handle <> v-diasize-resize-button
     1093               then do:
     1094                 assign
     1095                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1096                 .
     1097               end.
     1098             end.
     1099             assign
     1100               v-diasize-browse-handle :width = v-browse-width
     1101             .
     1102             for each buf_temp-browse-handle
     1103               where buf_temp-browse-handle.browse-type = 'width':u
     1104             on error undo, next
     1105             :
     1106               assign
     1107                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1108               .
     1109             end.
     1110             assign
     1111               frame Dialog-Frame :width = v-frame-width
     1112             .
     1113             if frame Dialog-Frame :scrollable = true
     1114             then do:
     1115               assign
     1116                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1117               .
     1118             end.
     1119             run diasize_position-resize-button in this-procedure .
     1120           end.
     1121           else do:
     1122             if frame Dialog-Frame :scrollable = true
     1123             then do:
     1124               assign
     1125                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1126               .
     1127             end.
     1128             assign
     1129               frame Dialog-Frame :width = v-frame-width
     1130             .
     1131             for each buf_temp-browse-handle
     1132               where buf_temp-browse-handle.browse-type = 'width':u
     1133             on error undo, next
     1134             :
     1135               assign
     1136                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1137               .
     1138             end.
     1139             assign
     1140               v-diasize-browse-handle :width = v-browse-width
     1141             .
     1142             for each buf_temp-diasize-handle
     1143             on error undo, next
     1144             :
     1145               assign
     1146                 v-object-handle = buf_temp-diasize-handle.handle-value
     1147               .
     1148               if v-object-handle <> v-diasize-resize-button
     1149               then do:
     1150                 assign
     1151                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1152                 .
     1153               end.
     1154             end.
     1155             run diasize_position-resize-button in this-procedure .
     1156           end.
     1157           assign
     1158             v-diasize-change-size = false
     1159           .
     1160           leave move_block .
     1161         end.
     1162       end.
     1163       assign
     1164         v-diasize-need-full-display = true
     1165       .
     1166       if v-diasize-change-size = false
     1167       then do:
     1168         assign
     1169           v-diasize-change-size = true
     1170         .
     1171       end.
     1172       else do:
     1173         return .
     1174       end.
     1175       assign
     1176         v-frame-width = frame Dialog-Frame :width
     1177         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1178         v-browse-width = v-diasize-browse-handle :width
     1179       .
     1180       for each buf_temp-browse-handle
     1181         where buf_temp-browse-handle.browse-type = 'width':u
     1182       :
     1183         assign
     1184           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1185         .
     1186       end.
     1187       for each buf_temp-diasize-handle
     1188       :
     1189         delete buf_temp-diasize-handle .
     1190       end.
     1191       assign
     1192         v-field-group-handle = frame Dialog-Frame :first-child
     1193       .
     1194       do while valid-handle(v-field-group-handle)
     1195       :
     1196         assign
     1197           v-object-handle = v-field-group-handle :first-child
     1198         .
     1199         do while valid-handle(v-object-handle)
     1200         :
     1201           if  v-object-handle <> v-diasize-browse-handle :handle
     1202           and v-object-handle <> v-diasize-resize-button
     1203           and can-query(v-object-handle, "row")
     1204           and can-query(v-object-handle, "height")
     1205           and ( v-object-handle :col + v-object-handle :width
     1206                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1207               )
     1208           then do:
     1209             find first buf_temp-browse-handle
     1210               where buf_temp-browse-handle.browse-type   = 'width':u
     1211                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1212               no-error .
     1213             if available buf_temp-browse-handle
     1214             then do:
     1215             end.
     1216             else do:
     1217               create buf_temp-diasize-handle .
     1218               assign
     1219                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1220                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1221               .
     1222             end.
     1223           end.
     1224           assign
     1225             v-object-handle = v-object-handle :next-sibling
     1226           .
     1227         end.
     1228         assign
     1229           v-field-group-handle = v-field-group-handle :next-sibling
     1230         .
     1231       end.
     1232       do with frame Dialog-Frame
     1233       :
     1234         hide v-diasize-resize-button .
     1235         v-diasize-resize-button :row = 1.
     1236         v-diasize-resize-button :column = 1.
     1237       end.
     1238       if p-change-value > 0
     1239       then do:
     1240         if frame Dialog-Frame :scrollable = true
     1241         then do:
     1242           assign
     1243             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1244             no-error .
     1245           if error-status :error
     1246           or error-status :get-message(1) <> ""
     1247           then do:
     1248             undo move_block, retry move_block.
     1249           end.
     1250         end.
     1251         assign
     1252           frame Dialog-Frame :width = v-frame-width + p-change-value
     1253           no-error .
     1254         if error-status :error
     1255         or error-status :get-message(1) <> ""
     1256         then do:
     1257           undo move_block, retry move_block.
     1258         end.
     1259         assign
     1260           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1261         no-error .
     1262         if error-status :error
     1263         or error-status :get-message(1) <> ""
     1264         then do:
     1265           undo move_block, retry move_block.
     1266         end.
     1267         for each buf_temp-browse-handle
     1268           where buf_temp-browse-handle.browse-type = 'width':u
     1269         on error undo move_block, retry move_block
     1270         :
     1271           assign
     1272             buf_temp-browse-handle.browse-handle :width
     1273               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1274             no-error .
     1275           if error-status :error
     1276           or error-status :get-message(1) <> ""
     1277           then do:
     1278             undo move_block, retry move_block .
     1279           end.
     1280         end.
     1281         for each buf_temp-diasize-handle
     1282         on error undo move_block, retry move_block
     1283         :
     1284           assign
     1285             v-object-handle = buf_temp-diasize-handle.handle-value
     1286           .
     1287           if v-object-handle <> v-diasize-resize-button
     1288           then do:
     1289             assign
     1290               v-object-handle :col = v-object-handle :col + p-change-value
     1291               no-error .
     1292             if error-status :error
     1293             or error-status :get-message(1) <> ""
     1294             then do:
     1295               undo move_block, retry move_block .
     1296             end.
     1297           end.
     1298         end.
     1299       end.
     1300       else do:
     1301         for each buf_temp-diasize-handle
     1302         on error undo move_block, retry move_block
     1303         :
     1304           assign
     1305             v-object-handle = buf_temp-diasize-handle.handle-value
     1306           .
     1307           if v-object-handle <> v-diasize-resize-button
     1308           then do:
     1309             assign
     1310               v-object-handle :col = v-object-handle :col + p-change-value
     1311               no-error .
     1312             if error-status :error
     1313             or error-status :get-message(1) <> ""
     1314             then do:
     1315               undo move_block, retry move_block .
     1316             end.
     1317           end.
     1318         end.
     1319         for each buf_temp-browse-handle
     1320           where buf_temp-browse-handle.browse-type = 'width':u
     1321         on error undo move_block, retry move_block
     1322         :
     1323           assign
     1324             buf_temp-browse-handle.browse-handle :width
     1325               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1326             no-error .
     1327           if error-status :error
     1328           or error-status :get-message(1) <> ""
     1329           then do:
     1330             undo move_block, retry move_block .
     1331           end.
     1332         end.
     1333         assign
     1334           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1335           no-error .
     1336         if error-status :error
     1337         or error-status :get-message(1) <> ""
     1338         then do:
     1339           undo move_block, retry move_block.
     1340         end.
     1341         assign
     1342           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1343         no-error .
     1344         if error-status :error
     1345         or error-status :get-message(1) <> ""
     1346         then do:
     1347           undo move_block, retry move_block.
     1348         end.
     1349         if frame Dialog-Frame :scrollable = true
     1350         then do:
     1351           assign
     1352             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1353           no-error .
     1354           if error-status :error
     1355           or error-status :get-message(1) <> ""
     1356           then do:
     1357             undo move_block, retry move_block.
     1358           end.
     1359         end.
     1360       end.
     1361       if p-move-resize
     1362       then do:
     1363         run diasize_position-resize-button in this-procedure .
     1364       end.
     1365       if v-diasize-wndstore = true
     1366       then do:
     1367         if connected("ub") = true
     1368         then do:
     1369           define variable v-cntxt-db-num        as integer   no-undo .
     1370           define variable v-cntxt-userid        as character no-undo .
     1371           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1372                                             , OUTPUT v-cntxt-userid
     1373                                             ) .
     1374           run gbl/wndsizew.p
     1375             (input  v-cntxt-db-num
     1376             ,input  v-cntxt-userid
     1377             ,input  v-diasize-proc-name
     1378             ,input  'width':u
     1379             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1380             ) .
     1381         end.
     1382       end.
     1383     end.
     1384     assign
     1385       v-diasize-change-size = false
     1386     .
     1387   end procedure.
     1388   procedure diasize_set-width :
     1389     define input  parameter p-new-width  as decimal   no-undo .
     1390     define input  parameter p-move-resize as logical   no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       run diasize_change-width in this-procedure
     1395         (input  (p-new-width - frame Dialog-Frame :width)
     1396         ,input  p-move-resize
     1397         ) .
     1398     end.
     1399   end procedure.
     1400   procedure diasize_position-resize-button :
     1401     do with frame Dialog-Frame
     1402     :
     1403       hide v-diasize-resize-button .
     1404       assign
     1405         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1406                     - 1
     1407                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1408         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1409                     - 1
     1410                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1411       .
     1412       view v-diasize-resize-button .
     1413     end.
     1414   end procedure.
     1415   on alt-right anywhere
     1416   do:
     1417     run diasize_change-width in this-procedure
     1418       (input 1
     1419       ,input true
     1420       ) .
     1421     return no-apply .
     1422   end.
     1423   on alt-left anywhere
     1424   do:
     1425     run diasize_change-width in this-procedure
     1426       (input -1
     1427       ,input true
     1428       ) .
     1429     return no-apply .
     1430   end.
     1431   on alt-down anywhere
     1432   do:
     1433     run diasize_change-height in this-procedure
     1434       (input 1
     1435       ,input true
     1436       ) .
     1437     return no-apply .
     1438   end.
     1439   on alt-up anywhere
     1440   do:
     1441     run diasize_change-height in this-procedure
     1442       (input -1
     1443       ,input true
     1444       ) .
     1445     return no-apply .
     1446   end.
     1447   on alt-enter of frame Dialog-Frame
     1448   do:
     1449     run diasize_maximize in this-procedure
     1450       (input  ?
     1451       ).
     1452     return no-apply .
     1453   end.
     1454   procedure diasize_end-move :
     1455     do
     1456     on error undo, return error return-value
     1457     :
     1458       define variable v-row-delta as decimal   no-undo .
     1459       define variable v-col-delta as decimal   no-undo .
     1460       define variable v-new-row as decimal   no-undo .
     1461       define variable v-new-col as decimal   no-undo .
     1462       assign
     1463         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1464         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1465       .
     1466       assign
     1467         v-row-delta = v-new-row - frame Dialog-Frame :height
     1468         v-col-delta = v-new-col - frame Dialog-Frame :width
     1469       .
     1470       run diasize_change-height in this-procedure
     1471         (input v-row-delta
     1472         ,input true
     1473         ) .
     1474       run diasize_change-width in this-procedure
     1475         (input v-col-delta
     1476         ,input true
     1477         ) .
     1478     end.
     1479   end procedure.
     1480   procedure diasize_maximize :
     1481     define input  parameter p-action as logical   no-undo .
     1482     do
     1483     on error undo, return error return-value
     1484     :
     1485       if p-action = ?
     1486       then do:
     1487         if v-diasize-need-maximize = true
     1488         then do:
     1489           assign
     1490             p-action = true
     1491           .
     1492         end.
     1493         else do:
     1494           assign
     1495             p-action = false
     1496           .
     1497         end.
     1498       end.
     1499       if p-action = true
     1500       then do:
     1501         run diasize_change-height in this-procedure
     1502           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1503               - frame Dialog-Frame :height-chars
     1504           ,input true
     1505           ) .
     1506         run diasize_change-width in this-procedure
     1507           (input session :width-chars
     1508               - frame Dialog-Frame :width-chars
     1509           ,input true
     1510           ) .
     1511         assign
     1512           v-diasize-need-maximize = false
     1513         .
     1514       end.
     1515       else do:
     1516         run diasize_change-width in this-procedure
     1517           (input v-diasize-orig-frame-width
     1518               - frame Dialog-Frame :width-chars
     1519           ,input true
     1520           ) .
     1521         run diasize_change-height in this-procedure
     1522           (input v-diasize-orig-frame-height
     1523               - frame Dialog-Frame :height-chars
     1524           ,input true
     1525           ) .
     1526         assign
     1527           v-diasize-need-maximize = true
     1528         .
     1529       end.
     1530     end.
     1531   end procedure.
     1532   procedure diasize_restore-orig-size :
     1533     do
     1534     on error undo, return error return-value
     1535     :
     1536       assign
     1537         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1538         v-diasize-current-frame-height = frame Dialog-Frame :height
     1539       .
     1540       run diasize_set-height in this-procedure
     1541         (input  v-diasize-orig-frame-height
     1542         ,input  true
     1543         ) .
     1544       run diasize_set-width in this-procedure
     1545         (input  v-diasize-orig-frame-width
     1546         ,input  true
     1547         ) .
     1548     end.
     1549   end procedure.
     1550   procedure diasize_restore-current-size :
     1551     do
     1552     on error undo, return error return-value
     1553     :
     1554       run diasize_set-height in this-procedure
     1555         (input  v-diasize-current-frame-height
     1556         ,input  true
     1557         ) .
     1558       run diasize_set-width in this-procedure
     1559         (input  v-diasize-current-frame-width
     1560         ,input  true
     1561         ) .
     1562     end.
     1563   end procedure.
     1564   procedure diasize_set-browse-handle :
     1565     define input  parameter p-browse-handle as handle   no-undo .
     1566     define buffer buf_temp-browse-handle for temp-browse-handle .
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       assign
     1571         v-diasize-browse-handle = p-browse-handle
     1572       .
     1573       for each buf_temp-browse-handle
     1574       on error undo, return error return-value
     1575       :
     1576         delete buf_temp-browse-handle .
     1577       end.
     1578     end.
     1579   end procedure.
     1580   procedure diasize_add_browse :
     1581     define input  parameter p-browse-type   as character no-undo .
     1582     define input  parameter p-browse-handle as handle    no-undo .
     1583     define buffer buf_temp-browse-handle for temp-browse-handle .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       assign
     1588         v-diasize-browse-number = v-diasize-browse-number + 1
     1589       .
     1590       create buf_temp-browse-handle .
     1591       assign
     1592         buf_temp-browse-handle.browse-type   = p-browse-type
     1593         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1594         buf_temp-browse-handle.browse-handle = p-browse-handle
     1595       .
     1596     end.
     1597   end procedure.
     1598   procedure diasize_init :
     1599     define variable v-default-value    as logical   no-undo .
     1600     define variable v-restore-saved    as logical   no-undo .
     1601     define variable v-resize-value-str as character no-undo .
     1602     do
     1603     on error undo, return error return-value
     1604     :
     1605       do with frame Dialog-Frame
     1606       :
     1607         assign
     1608           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1609           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1610           v-diasize-browse-handle     = browse browse-action-item :handle
     1611         .
     1612         create button v-diasize-resize-button
     1613         assign
     1614           parent        = frame Dialog-Frame :first-child
     1615           label         = "s"
     1616           height-pixels = 16
     1617           width-pixels  = 16
     1618           visible       = true
     1619           sensitive     = true
     1620           movable       = true
     1621           triggers:
     1622             on end-move persistent run diasize_end-move in this-procedure .
     1623           end triggers.
     1624         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1625         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1626         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1627         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1628         assign
     1629           v-diasize-wndmax = false
     1630         .
     1631         if connected("ub") = true
     1632         then do:
     1633           define variable v-cntxt-db-num        as integer   no-undo .
     1634           define variable v-cntxt-userid        as character no-undo .
     1635           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1636                                             , OUTPUT v-cntxt-userid
     1637                                             ) .
     1638           run gbl/wndpar_r.p
     1639             (input  v-cntxt-db-num
     1640             ,input  v-cntxt-userid
     1641             ,input  'wndmax':U
     1642             ,output v-diasize-wndmax
     1643             ,output v-default-value
     1644             ) .
     1645         end.
     1646         assign
     1647           v-diasize-wndstore = false
     1648         .
     1649         if connected("ub") = true
     1650         then do:
     1651           run gbl/wndpar_r.p
     1652             (input  v-cntxt-db-num
     1653             ,input  v-cntxt-userid
     1654             ,input  'wndstore':U
     1655             ,output v-diasize-wndstore
     1656             ,output v-default-value
     1657             ) .
     1658         end.
     1659         assign
     1660           v-diasize-proc-name = entry(1, program-name(2), '.')
     1661         .
     1662         if v-diasize-wndstore = true
     1663         then do:
     1664           assign
     1665             v-restore-saved = false
     1666           .
     1667           if connected("ub") = true
     1668           then do:
     1669             run gbl/wndsizer.p
     1670               (input  v-cntxt-db-num
     1671               ,input  v-cntxt-userid
     1672               ,input  v-diasize-proc-name
     1673               ,input  'height':u
     1674               ,output v-resize-value-str
     1675               ) .
     1676             if v-resize-value-str <> '':U
     1677             then do:
     1678               run diasize_change-height in this-procedure
     1679                 (input  integer(v-resize-value-str)
     1680                 ,input  true
     1681                 ) .
     1682               assign
     1683                 v-restore-saved = true
     1684               .
     1685             end.
     1686           end.
     1687           if connected("ub") = true
     1688           then do:
     1689             run gbl/wndsizer.p
     1690               (input  v-cntxt-db-num
     1691               ,input  v-cntxt-userid
     1692               ,input  v-diasize-proc-name
     1693               ,input  'width':u
     1694               ,output v-resize-value-str
     1695               ) .
     1696             if v-resize-value-str <> '':U
     1697             then do:
     1698               run diasize_change-width in this-procedure
     1699                 (input  integer(v-resize-value-str)
     1700                 ,input  true
     1701                 ) .
     1702               assign
     1703                 v-restore-saved = true
     1704               .
     1705             end.
     1706           end.
     1707           if v-restore-saved <> true
     1708           then do:
     1709             if v-diasize-wndmax = true
     1710             then do:
     1711               run diasize_maximize in this-procedure
     1712                 (input  true
     1713                 ) .
     1714             end.
     1715           end.
     1716         end.
     1717         else do:
     1718           if v-diasize-wndmax = true
     1719           then do:
     1720             run diasize_maximize in this-procedure
     1721               (input  true
     1722               ) .
     1723           end.
     1724         end.
     1725       end.
     1726     end.
     1727   end procedure.
     1728   procedure diasize_need-full-display :
     1729     define output parameter p-need-full-display as logical   no-undo .
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733       assign
     1734         p-need-full-display = v-diasize-need-full-display
     1735       .
     1736       assign
     1737         v-diasize-need-full-display = false
     1738       .
     1739     end.
     1740   end procedure.
     1741   procedure get-context :
     1742      define output parameter p-db-num as integer          no-undo.
     1743      define output parameter p-user-id as character        no-undo.
     1744      define variable v-login               as character    no-undo.
     1745      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1746      define buffer buf_user-login  for ub.user-login .
     1747      do
     1748      on error undo, return error
     1749      :
     1750            FIND FIRST buf_sys-ctrl no-lock.
     1751            ASSIGN
     1752               v-login = USERID("ub")
     1753               p-db-num = buf_sys-ctrl.db-num
     1754            .
     1755            FIND FIRST buf_user-login
     1756                 WHERE buf_user-login.db-num = p-db-num
     1757                   AND buf_user-login.user-login = v-login
     1758                 no-lock
     1759                 no-error
     1760                 .
     1761            IF AVAILABLE buf_user-login
     1762            THEN DO:
     1763               assign
     1764                  p-user-id = buf_user-login.user-id
     1765               .
     1766            END.
     1767      end.
     1768   end procedure.
     1769       run diasize_init in this-procedure .
     1770   MAIN-BLOCK:
     1771   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1772      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1773   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1774     run mainmenu_getcntxt in parparentproc
     1775       (output v-cntxt-db-num
     1776       ,output v-cntxt-userid
     1777       ,output v-cntxt-level
     1778       ,output v-cntxt-host-code-obj
     1779       ,output v-cntxt-obj-type
     1780       ,output v-cntxt-obj-code
     1781       ,output v-cntxt-db-num-obj
     1782       ,output v-cntxt-is-admin
     1783       ) .
     1784   define variable vss-include-info8 as character format "X(65)" no-undo
     1785   initial "@(#)$Workfile$ $Revision$".
     1786   do:
     1787     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run actn-gbl in g#library2
     1788       ( output v-on-gbl
     1789       ) no-error .
     1790   end.
     1791     RUN fill-wp IN THIS-PROCEDURE.
     1792     FIND FIRST br_tt-work-place no-lock.
     1793          ASSIGN
     1794           FRAME Dialog-Frame:TITLE = SUBSTITUTE ( "Права пользователя &1 для &2"
     1795                                                 , usrnickf( p-user-id )
     1796                                                 , IF p-obj-type = 'орг':U
     1797                                                   THEN Substitute("фирмы &1", p-obj-code)
     1798                                                   ELSE Substitute(" &1 &2", p-obj-type, p-obj-code)
     1799                                                 )
     1800        .
     1801       run assign-filter-mark in this-procedure (
     1802             input v-flt-role
     1803           , input v-flt-item
     1804       ).
     1805     RUN enable_UI.
     1806     RUN post_enable_UI IN THIS-PROCEDURE.
     1807     WAIT-FOR GO OF FRAME Dialog-Frame.
     1808   END.
     1809   RUN disable_UI.
     1810   PROCEDURE add-action-roles :
     1811     define variable v-action-role-code     as integer   no-undo .
     1812     define variable current-role           as integer   no-undo .
     1813     define variable v-rid-list             as character no-undo .
     1814     define variable v-context              as character no-undo .
     1815     define variable v-obj-code             as integer   no-undo .
     1816     define variable v-obj-type             as character no-undo .
     1817     define variable v-host-code            as integer   no-undo .
     1818     define variable v-user-select          as logical   no-undo .
     1819      do
     1820      on error undo, return error return-value
     1821      :
     1822         ASSIGN
     1823            v-context = br_tt-work-place.context
     1824         .
     1825         run str/actnrole.w ( input parparentproc
     1826                           , input  'b-sel,b-mark':U
     1827                           , input-output v-context
     1828                           , output v-action-role-code
     1829                           , INPUT-OUTPUT v-rid-list
     1830                           , input p-db-num
     1831                           ) .
     1832         IF v-context <> br_tt-work-place.context THEN DO:
     1833            message
     1834               "Выбранное право не соответствует типу объекта"
     1835               skip
     1836            view-as alert-box information.
     1837            RETURN.
     1838         END.
     1839         IF v-rid-list <> "" THEN
     1840         DO current-role = 1 TO NUM-ENTRIES(v-rid-list) :
     1841            case v-context :
     1842               WHEN 'firm':U THEN DO:
     1843                  RUN add-one-action-role ( INPUT ENTRY(current-role, v-rid-list)
     1844                                          , INPUT 0
     1845                                          , INPUT '':U
     1846                                          , INPUT br_tt-work-place.wp-code
     1847                                          ).
     1848               END.
     1849               WHEN 'object':U THEN DO:
     1850                  RUN add-one-action-role ( INPUT ENTRY(current-role, v-rid-list)
     1851                                          , INPUT br_tt-work-place.wp-code
     1852                                          , INPUT br_tt-work-place.wp-type
     1853                                          , INPUT 0
     1854                                          ).
     1855               END.
     1856               OTHERWISE DO:
     1857                  RUN add-one-action-role ( INPUT ENTRY(current-role, v-rid-list)
     1858                                          , INPUT 0
     1859                                          , INPUT '':U
     1860                                          , INPUT 0
     1861                                          ).
     1862               END.
     1863            END.
     1864         END.
     1865      end.
     1866   END PROCEDURE.
     1867   PROCEDURE add-one-action-role :
     1868   DEFINE INPUT PARAMETER p-rid AS CHARACTER NO-UNDO.
     1869   DEFINE INPUT PARAMETER p-obj-code      AS INTEGER   NO-UNDO.
     1870   DEFINE INPUT PARAMETER p-obj-type      AS CHARACTER NO-UNDO.
     1871   DEFINE INPUT PARAMETER p-host-code     AS INTEGER   NO-UNDO.
     1872   DEFINE BUFFER buf_action-role            FOR action-role.
     1873   DEFINE BUFFER buf_user-login-action-role FOR user-login-action-role.
     1874      do
     1875      on error undo, return error return-value
     1876      :
     1877         FIND FIRST buf_action-role WHERE RECID(buf_action-role) = INTEGER(p-rid)
     1878                                    NO-LOCK.
     1879         IF NOT CAN-FIND( FIRST buf_user-login-action-role
     1880                          WHERE buf_user-login-action-role.db-num           = p-db-num
     1881                            AND buf_user-login-action-role.action-head-code = 0
     1882                            AND buf_user-login-action-role.action-role-code = buf_action-role.action-role-code
     1883                            AND buf_user-login-action-role.action-role-context  = buf_action-role.action-role-context
     1884                            AND buf_user-login-action-role.user-id          = p-user-id
     1885                            AND buf_user-login-action-role.host-code            = p-host-code
     1886                            AND buf_user-login-action-role.obj-type             = p-obj-type
     1887                            AND buf_user-login-action-role.obj-code             = p-obj-code
     1888                        )
     1889         THEN DO:
     1890            create buf_user-login-action-role .
     1891            assign
     1892              buf_user-login-action-role.db-num               = p-db-num
     1893              buf_user-login-action-role.action-head-code     = 0
     1894              buf_user-login-action-role.user-login-role-code = NEXT-VALUE(s-user-login-action-role)
     1895              buf_user-login-action-role.user-id              = p-user-id
     1896              buf_user-login-action-role.action-role-code     = buf_action-role.action-role-code
     1897              buf_user-login-action-role.action-role-context  = buf_action-role.action-role-context
     1898              buf_user-login-action-role.host-code            = p-host-code
     1899              buf_user-login-action-role.obj-type             = p-obj-type
     1900              buf_user-login-action-role.obj-code             = p-obj-code
     1901              buf_user-login-action-role.gds-grp-code         = ?
     1902              buf_user-login-action-role.gds-code             = ?
     1903              buf_user-login-action-role.cli-grp-code         = ?
     1904            .
     1905         END.
     1906       END.
     1907   END PROCEDURE.
     1908   PROCEDURE assign-filter-mark :
     1909   define input parameter p-name-filter    as character        no-undo.
     1910   define input parameter p-name2-filter   as character        no-undo.
     1911   define buffer buf_action-role          for action-role .
     1912   define buffer buf_action-role-item     for action-role-item .
     1913   define buffer buf_action-item          for action-item .
     1914   define buffer buf_temp_filter-fields   for temp_filter-fields .
     1915   define buffer buf_user-login-action-role     for user-login-action-role .
     1916   do
     1917   on error undo, return error
     1918   :
     1919      IF available br_tt-work-place THEN DO:
     1920         FOR EACH buf_user-login-action-role WHERE buf_user-login-action-role.db-num           = p-db-num
     1921                                             AND buf_user-login-action-role.action-head-code    = 0
     1922                                             AND buf_user-login-action-role.user-id             = p-user-id
     1923                                             AND buf_user-login-action-role.action-role-context = br_tt-work-place.context
     1924                                             AND (
     1925                                                (br_tt-work-place.context = 'global':U)
     1926                                                OR
     1927                                                (br_tt-work-place.context = 'firm':U
     1928                                                   AND
     1929                                                   buf_user-login-action-role.host-code = br_tt-work-place.wp-code
     1930                                                )
     1931                                                OR
     1932                                                (br_tt-work-place.context = 'object':U
     1933                                                   AND
     1934                                                   buf_user-login-action-role.obj-code = br_tt-work-place.wp-code
     1935                                                   AND
     1936                                                   buf_user-login-action-role.obj-type = br_tt-work-place.wp-type
     1937                                                )
     1938                                                )
     1939               no-lock,
     1940               FIRST buf_action-role        WHERE buf_action-role.db-num                      = (if v-on-gbl then 0 else p-db-num)
     1941                                             AND buf_action-role.action-head-code            = 0
     1942                                             AND buf_action-role.action-role-code            = buf_user-login-action-role.action-role-code
     1943                                             and buf_action-role.action-role-context         = br_tt-work-place.context
     1944                                          NO-LOCK
     1945                                          :
     1946           find first buf_temp_filter-fields
     1947                where buf_temp_filter-fields.action-role-code = buf_action-role.action-role-code
     1948           no-error.
     1949           if not available buf_temp_filter-fields
     1950           then do:
     1951               create buf_temp_filter-fields.
     1952               assign
     1953                   buf_temp_filter-fields.action-role-code = buf_action-role.action-role-code
     1954                   buf_temp_filter-fields.record-on = no
     1955               .
     1956           end.
     1957           if ( p-name-filter = "":U AND p-name2-filter = "":U)
     1958           or (( p-name-filter <> "":U )
     1959           and index(buf_action-role.action-role-name , p-name-filter ) <> 0 )
     1960           or (( p-name-filter <> "":U )
     1961           and index(buf_action-role.action-role-description , p-name-filter ) <> 0 )
     1962           then do:
     1963               assign
     1964                   buf_temp_filter-fields.record-on = yes
     1965               .
     1966           end.
     1967           else do:
     1968               assign
     1969                   buf_temp_filter-fields.record-on = no
     1970               .
     1971               search-in-item:
     1972               for each buf_action-role-item
     1973                   where buf_action-role-item.db-num           = buf_action-role.db-num
     1974                     and buf_action-role-item.action-head-code = buf_action-role.action-head-code
     1975                     and buf_action-role-item.action-role-code = buf_action-role.action-role-code
     1976                   no-lock,
     1977                   first buf_action-item
     1978                   where buf_action-item.action-head-code = buf_action-role.action-head-code
     1979                     and buf_action-item.action-item-code = buf_action-role-item.action-item-code
     1980               :
     1981                   if ( p-name2-filter = "":U AND p-name-filter = "":U)
     1982                   OR index( buf_action-item.action-item-name, p-name2-filter ) <> 0
     1983                   or index( buf_action-item.action-item-description, p-name2-filter ) <> 0
     1984                   then do:
     1985                       assign
     1986                           buf_temp_filter-fields.record-on = yes
     1987                       .
     1988                       leave search-in-item.
     1989                   end.
     1990               end.
     1991           end.
     1992       end.
     1993       end.
     1994   end.
     1995   END PROCEDURE.
     1996   PROCEDURE delete-user-role :
     1997      define buffer buf_user-login-action-role     for user-login-action-role.
     1998      DO
     1999      TRANSACTION
     2000      ON ERROR UNDO, RETURN
     2001      :
     2002         FIND FIRST buf_user-login-action-role
     2003              WHERE RECID(buf_user-login-action-role) = RECID(br_user-login-action-role)
     2004              EXCLUSIVE-LOCK
     2005              .
     2006         DELETE buf_user-login-action-role.
     2007      END.
     2008   END PROCEDURE.
     2009   PROCEDURE disable_UI :
     2010     HIDE FRAME Dialog-Frame.
     2011   END PROCEDURE.
     2012   PROCEDURE enable_UI :
     2013     DISPLAY tg-detail v-filter tb-filter role-EDITOR item-EDITOR
     2014         WITH FRAME Dialog-Frame.
     2015     ENABLE b-exit b-add b-del b-help tg-detail b-filter v-filter tb-filter
     2016            browse-br_user-login-action-role browse-action-item role-EDITOR
     2017            item-EDITOR
     2018         WITH FRAME Dialog-Frame.
     2019     VIEW FRAME Dialog-Frame.
     2020     RUN refresh-action-item .    RUN refresh-action-role IN THIS-PROCEDURE .
     2021   END PROCEDURE.
     2022   PROCEDURE fill-wp :
     2023   DEFINE BUFFER buf_user-obj  FOR user-obj.
     2024   DEFINE BUFFER buf_user-host FOR user-host.
     2025   DEFINE BUFFER buf_clients   FOR clients.
     2026   do
     2027   on error undo, return error
     2028   :
     2029      IF p-obj-type = 'орг':U THEN DO:
     2030         FOR FIRST buf_user-host
     2031             WHERE buf_user-host.db-num  = p-db-num
     2032               AND buf_user-host.USER-ID = p-user-id
     2033               AND buf_user-host.host-code = p-obj-code
     2034            NO-LOCK
     2035            :
     2036            FIND FIRST buf_clients
     2037                  WHERE buf_clients.obj-code = buf_user-host.host-code
     2038                  AND buf_clients.obj-type = 'орг':U
     2039                  NO-LOCK
     2040               .
     2041            CREATE br_tt-work-place.
     2042            ASSIGN
     2043               br_tt-work-place.wp-code = buf_clients.obj-code
     2044               br_tt-work-place.wp-type = buf_clients.obj-type
     2045               br_tt-work-place.wp-host = buf_clients.obj-code
     2046               br_tt-work-place.db-num  = buf_clients.db-num
     2047               br_tt-work-place.context = 'firm':U
     2048               br_tt-work-place.wp-name = buf_clients.obj-name
     2049            .
     2050         END.
     2051      end.
     2052      else do:
     2053         FOR FIRST buf_user-obj
     2054            WHERE buf_user-obj.db-num = p-db-num
     2055            AND buf_user-obj.USER-ID  = p-user-id
     2056            AND buf_user-obj.obj-type = p-obj-type
     2057            AND buf_user-obj.obj-code = p-obj-code
     2058            NO-LOCK
     2059            :
     2060            FIND FIRST buf_clients
     2061               WHERE buf_clients.obj-code = buf_user-obj.obj-code
     2062                  AND buf_clients.obj-type = buf_user-obj.obj-type
     2063               NO-LOCK
     2064               .
     2065            IF  buf_clients.db-num <> p-db-num
     2066            and p-db-num <> 0
     2067            then do:
     2068               next.
     2069            end.
     2070            CREATE br_tt-work-place.
     2071            ASSIGN
     2072               br_tt-work-place.wp-code = buf_clients.obj-code
     2073               br_tt-work-place.wp-type = buf_clients.obj-type
     2074               br_tt-work-place.wp-host = buf_clients.host-code
     2075               br_tt-work-place.db-num  = buf_clients.db-num
     2076               br_tt-work-place.context = 'object':U
     2077               br_tt-work-place.wp-name = buf_clients.obj-name
     2078            .
     2079         END.
     2080      END.
     2081   end.
     2082   END PROCEDURE.
     2083   PROCEDURE filter-for-item :
     2084   define input parameter p-name-filter    as character        no-undo.
     2085   define buffer buf_action-role-item        for action-role-item .
     2086   define buffer buf_temp_filter-fields-item for temp_filter-fields-item .
     2087   define buffer buf_action-item             for action-item .
     2088   define buffer buf_user-login-action-role  for user-login-action-role .
     2089   do
     2090   on error undo, return error
     2091   :
     2092      IF AVAILABLE br_user-login-action-role then do:
     2093         IF LOGICAL(tg-detail:screen-value in FRAME Dialog-Frame) then do:
     2094            FOR EACH buf_action-role-item
     2095                  WHERE buf_action-role-item.db-num = p-db-num
     2096                     AND buf_action-role-item.action-head-code   = 0
     2097                     AND buf_action-role-item.action-role-code   = br_user-login-action-role.action-role-code
     2098                  NO-LOCK,
     2099                  first buf_action-item
     2100                  where buf_action-item.action-head-code     = 0
     2101                     AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
     2102                  no-lock
     2103            :
     2104               find first buf_temp_filter-fields-item
     2105                     where buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     2106               no-error.
     2107               if not available buf_temp_filter-fields-item
     2108               then do:
     2109                     create buf_temp_filter-fields-item.
     2110                     assign
     2111                        buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     2112                        buf_temp_filter-fields-item.record-on = no
     2113                     .
     2114               end.
     2115               if ( p-name-filter = "":U )
     2116               or index( buf_action-item.action-item-name, p-name-filter ) <> 0
     2117               or index( buf_action-item.action-item-description, p-name-filter ) <> 0
     2118               then do:
     2119                  assign
     2120                     buf_temp_filter-fields-item.record-on = yes
     2121                  .
     2122               end.
     2123               else do:
     2124                  assign
     2125                     buf_temp_filter-fields-item.record-on = no
     2126                  .
     2127               end.
     2128            end.
     2129         end.
     2130         else do:
     2131            FOR EACH  buf_user-login-action-role
     2132                WHERE buf_user-login-action-role.db-num             = p-db-num
     2133                 AND  buf_user-login-action-role.action-head-code   = 0
     2134                 AND  buf_user-login-action-role.user-id            = p-user-id
     2135                no-lock
     2136                ,
     2137                EACH buf_action-role-item
     2138                  WHERE buf_action-role-item.db-num = p-db-num
     2139                     AND buf_action-role-item.action-head-code   = 0
     2140                     AND buf_action-role-item.action-role-code   = buf_user-login-action-role.action-role-code
     2141                  NO-LOCK,
     2142                  first buf_action-item
     2143                  where buf_action-item.action-head-code    = 0
     2144                     AND buf_action-item.action-item-code    = buf_action-role-item.action-item-code
     2145                  no-lock
     2146            :
     2147               find first buf_temp_filter-fields-item
     2148                     where buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     2149               no-error.
     2150               if not available buf_temp_filter-fields-item
     2151               then do:
     2152                     create buf_temp_filter-fields-item.
     2153                     assign
     2154                        buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     2155                        buf_temp_filter-fields-item.record-on = no
     2156                     .
     2157               end.
     2158               if ( p-name-filter = "":U )
     2159               or index( buf_action-item.action-item-name, p-name-filter ) <> 0
     2160               or index( buf_action-item.action-item-description, p-name-filter ) <> 0
     2161               then do:
     2162                  assign
     2163                     buf_temp_filter-fields-item.record-on = yes
     2164                  .
     2165               end.
     2166               else do:
     2167                  assign
     2168                     buf_temp_filter-fields-item.record-on = no
     2169                  .
     2170               end.
     2171            end.
     2172         end.
     2173      end.
     2174   end.
     2175   END PROCEDURE.
     2176   PROCEDURE post_enable_UI :
     2177      define buffer buf_tt-work-place     for tt-work-place.
     2178      define variable v-ok    as logical      no-undo.
     2179   do
     2180   on error undo, return error
     2181   :
     2182      IF p-db-num <> v-cntxt-db-num and v-cntxt-db-num <> 0 THEN DO:
     2183         DISABLE
     2184               b-add
     2185               b-del
     2186         WITH FRAME Dialog-Frame.
     2187      END.
     2188      ELSE DO:
     2189         IF AVAILABLE br_action-role THEN DO:
     2190             ENABLE
     2191                   b-add
     2192                   b-del
     2193             WITH FRAME Dialog-Frame.
     2194         END.
     2195         ELSE DO:
     2196             ENABLE
     2197                   b-add
     2198             WITH FRAME Dialog-Frame.
     2199             DISABLE
     2200                   b-del
     2201             WITH FRAME Dialog-Frame.
     2202         END.
     2203      END.
     2204   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2205   do:
     2206     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2207       (input  v-cntxt-db-num
     2208       ,input  v-cntxt-userid
     2209       ,input  0
     2210       ,input  'actn_users-update':U
     2211       ,input  'global':U
     2212       ,input  0
     2213       ,input  '':U
     2214       ,input  0
     2215       ,input  0
     2216       ,input  0
     2217       ,input  0
     2218       ,input  FALSE
     2219       ,output v-ok
     2220       )  .
     2221   end.
     2222       if v-ok = FALSE
     2223       then do:
     2224           disable
     2225               b-add
     2226               b-del
     2227           WITH FRAME Dialog-Frame.
     2228       end.
     2229   end.
     2230   END PROCEDURE.
     2231   PROCEDURE procedure-get-item-state :
     2232     define input  parameter p-action-item-code       as integer   no-undo .
     2233     define output parameter p-state as character no-undo .
     2234     define buffer buf_action-role-item for ub.action-role-item .
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       if available br_user-login-action-role
     2239       then do:
     2240         find first buf_action-role-item no-lock
     2241           where buf_action-role-item.db-num              = br_user-login-action-role.db-num
     2242             and buf_action-role-item.action-head-code    = br_user-login-action-role.action-head-code
     2243             and buf_action-role-item.action-role-code    = br_user-login-action-role.action-role-code
     2244             and buf_action-role-item.action-item-code    = p-action-item-code
     2245           no-error .
     2246         if available buf_action-role-item
     2247         then do:
     2248           assign
     2249             p-state = '*':U
     2250           .
     2251         end.
     2252         else do:
     2253           assign
     2254             p-state = '':U
     2255           .
     2256         end.
     2257       end.
     2258     end.
     2259   END PROCEDURE.
     2260   PROCEDURE procedure-get-role-context :
     2261     define input  parameter p-action-context as character no-undo .
     2262     define output parameter p-action-name    as character no-undo .
     2263     do
     2264     on error undo, return error return-value
     2265     :
     2266       case p-action-context
     2267       :
     2268         when 'global':U
     2269         then do:
     2270           assign
     2271             p-action-name = "Без привязки"
     2272           .
     2273         end.
     2274         when 'firm':U
     2275         then do:
     2276           assign
     2277             p-action-name = "Фирма"
     2278           .
     2279         end.
     2280         when 'object':U
     2281         then do:
     2282           assign
     2283             p-action-name = "Объект"
     2284           .
     2285         end.
     2286         otherwise do:
     2287           message
     2288             vss-workfile vss-revision vss-description skip
     2289             "Незвестное значение контекста" skip
     2290             "p-action-context" p-action-context skip
     2291             view-as alert-box error .
     2292         end.
     2293       end case .
     2294     end.
     2295   END PROCEDURE.
     2296   PROCEDURE query-action-item :
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       if available br_user-login-action-role
     2301       then do:
     2302         if tb-filter = yes then do:
     2303            run filter-for-item IN THIS-PROCEDURE
     2304                           ( input v-flt-item
     2305                           ) .
     2306         end.
     2307         else do:
     2308            run filter-for-item IN THIS-PROCEDURE
     2309                           ( input ""
     2310                           ) .
     2311         end.
     2312         IF LOGICAL(tg-detail:screen-value in FRAME Dialog-Frame) then do:
     2313            open query browse-action-item
     2314               FOR EACH buf_user-login-action-role
     2315                   WHERE RECID(buf_user-login-action-role) = RECID(br_user-login-action-role)
     2316                     NO-LOCK
     2317                     ,
     2318                     EACH  br_action-role-item
     2319                     WHERE br_action-role-item.db-num = p-db-num
     2320                        AND br_action-role-item.action-head-code   = 0
     2321                        AND br_action-role-item.action-role-code   = buf_user-login-action-role.action-role-code
     2322                     NO-LOCK,
     2323                     FIRST br_temp_filter-fields-item
     2324                     WHERE br_temp_filter-fields-item.action-item-code = br_action-role-item.action-item-code
     2325                       and br_temp_filter-fields-item.record-on = YES
     2326                     NO-LOCK
     2327                     ,
     2328                     first br_action-item
     2329                     where br_action-item.action-head-code    = 0
     2330                        AND br_action-item.action-item-code    = br_action-role-item.action-item-code
     2331                        AND br_action-item.action-item-context = br_tt-work-place.context
     2332                     no-lock
     2333                     indexed-reposition .
     2334         end.
     2335         else do:
     2336            open query browse-action-item
     2337               FOR EACH buf_user-login-action-role
     2338                     WHERE buf_user-login-action-role.db-num             = p-db-num
     2339                     AND buf_user-login-action-role.action-head-code     = 0
     2340                     AND buf_user-login-action-role.user-id              = p-user-id
     2341                     AND (
     2342                              (
     2343                              buf_user-login-action-role.action-role-context  = br_tt-work-place.context
     2344                              AND
     2345                              buf_user-login-action-role.action-role-context = 'global':U
     2346                              AND
     2347                              buf_user-login-action-role.host-code = 0
     2348                              AND
     2349                              buf_user-login-action-role.obj-code  = 0
     2350                              AND
     2351                              buf_user-login-action-role.obj-type  = "":U
     2352                              )
     2353                           OR
     2354                              (
     2355                              buf_user-login-action-role.action-role-context  = br_tt-work-place.context
     2356                              AND
     2357                              buf_user-login-action-role.action-role-context = 'firm':U
     2358                              AND
     2359                              buf_user-login-action-role.host-code = br_tt-work-place.wp-code
     2360                              AND
     2361                              buf_user-login-action-role.obj-code  = 0
     2362                              AND
     2363                              buf_user-login-action-role.obj-type  = "":U
     2364                              )
     2365                           OR
     2366                              (
     2367                              buf_user-login-action-role.action-role-context  = br_tt-work-place.context
     2368                              AND
     2369                              buf_user-login-action-role.action-role-context = 'object':U
     2370                              AND
     2371                              buf_user-login-action-role.obj-code = br_tt-work-place.wp-code
     2372                              AND
     2373                              buf_user-login-action-role.obj-type = br_tt-work-place.wp-type
     2374                              )
     2375                           )
     2376                     no-lock
     2377                     ,
     2378                     EACH  br_action-role-item
     2379                     WHERE br_action-role-item.db-num = p-db-num
     2380                        AND br_action-role-item.action-head-code   = 0
     2381                        AND br_action-role-item.action-role-code   = buf_user-login-action-role.action-role-code
     2382                     NO-LOCK
     2383                     ,
     2384                     FIRST br_temp_filter-fields-item
     2385                     WHERE br_temp_filter-fields-item.action-item-code = br_action-role-item.action-item-code
     2386                       and br_temp_filter-fields-item.record-on = YES
     2387                     NO-LOCK
     2388                     ,
     2389                     first br_action-item
     2390                     where br_action-item.action-head-code    = 0
     2391                        AND br_action-item.action-item-code    = br_action-role-item.action-item-code
     2392                        AND br_action-item.action-item-context = br_tt-work-place.context
     2393                     no-lock
     2394                     indexed-reposition .
     2395         end.
     2396       end.
     2397       else do:
     2398         open query browse-action-item
     2399              FOR EACH buf_user-login-action-role
     2400                  WHERE buf_user-login-action-role.db-num           = p-db-num
     2401                    AND buf_user-login-action-role.action-head-code = 0
     2402                    AND buf_user-login-action-role.user-id          = p-user-id
     2403                    AND buf_user-login-action-role.action-role-context = "":U
     2404                  NO-LOCK
     2405                  ,
     2406                  FIRST br_action-role-item
     2407                  WHERE br_action-role-item.db-num = p-db-num
     2408                    AND br_action-role-item.action-head-code            = 0
     2409                    AND br_action-role-item.action-role-code            = buf_user-login-action-role.action-role-code
     2410                  NO-LOCK
     2411                  ,
     2412                  FIRST br_temp_filter-fields-item
     2413                  WHERE br_temp_filter-fields-item.action-item-code = br_action-role-item.action-item-code
     2414                    and br_temp_filter-fields-item.record-on = YES
     2415                  NO-LOCK
     2416                  ,
     2417                  first br_action-item
     2418                  where br_action-item.action-head-code    = 0
     2419                    AND br_action-item.action-item-code    = br_action-role-item.action-item-code
     2420                  no-lock
     2421           indexed-reposition .
     2422       end.
     2423     if available br_action-item then do:
     2424       assign
     2425           item-editor = br_action-item.action-item-description
     2426       .
     2427       display
     2428         item-editor
     2429       with frame Dialog-Frame.
     2430     end.
     2431     end.
     2432   END PROCEDURE.
     2433   PROCEDURE query-action-role :
     2434     DO
     2435     ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     2436     :
     2437       IF available br_tt-work-place THEN DO:
     2438         OPEN QUERY browse-br_user-login-action-role
     2439               FOR EACH br_user-login-action-role WHERE br_user-login-action-role.db-num           = p-db-num
     2440                                                 AND br_user-login-action-role.action-head-code    = 0
     2441                                                 AND br_user-login-action-role.user-id             = p-user-id
     2442                                                 AND br_user-login-action-role.action-role-context = br_tt-work-place.context
     2443                                                 AND (
     2444                                                      (br_tt-work-place.context = 'global':U)
     2445                                                     OR
     2446                                                      (br_tt-work-place.context = 'firm':U
     2447                                                       AND
     2448                                                       br_user-login-action-role.host-code = br_tt-work-place.wp-code
     2449                                                      )
     2450                                                     OR
     2451                                                      (br_tt-work-place.context = 'object':U
     2452                                                       AND
     2453                                                       br_user-login-action-role.obj-code = br_tt-work-place.wp-code
     2454                                                       AND
     2455                                                       br_user-login-action-role.obj-type = br_tt-work-place.wp-type
     2456                                                      )
     2457                                                     )
     2458                   no-lock,
     2459                   FIRST br_action-role        WHERE br_action-role.db-num                      = (if v-on-gbl then 0 else p-db-num)
     2460                                                 AND br_action-role.action-head-code            = 0
     2461                                                 AND br_action-role.action-role-code            = br_user-login-action-role.action-role-code
     2462                                                 and br_action-role.action-role-context         = br_tt-work-place.context
     2463                                               NO-LOCK,
     2464                   first temp_filter-fields
     2465                   where temp_filter-fields.action-role-code = br_action-role.action-role-code
     2466                     AND temp_filter-fields.record-on = YES
     2467                   no-lock
     2468         INDEXED-REPOSITION .
     2469       END.
     2470       if available br_action-role then do:
     2471         assign
     2472             role-editor = br_action-role.action-role-description
     2473         .
     2474         display
     2475            role-editor
     2476         with frame Dialog-Frame.
     2477       end.
     2478     END.
     2479   END PROCEDURE.
     2480   PROCEDURE refresh-action-item :
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484       run query-action-item in this-procedure .
     2485     end.
     2486   END PROCEDURE.
     2487   PROCEDURE refresh-action-role :
     2488     do
     2489     on error undo, return error return-value
     2490     :
     2491       run query-action-role in this-procedure .
     2492       run refresh-action-item in this-procedure .
     2493     end.
     2494   END PROCEDURE.
     2495   FUNCTION get-item-state RETURNS CHARACTER
     2496     ( BUFFER buf_action-item FOR action-item ) :
     2497     define variable v-return-value as character no-undo .
     2498     run procedure-get-item-state in this-procedure
     2499       (input  buf_action-item.action-item-code
     2500       ,output v-return-value
     2501       ) .
     2502     return v-return-value .
     2503   END FUNCTION.
     2504   FUNCTION get-role-context RETURNS CHARACTER
     2505     ( BUFFER buf_user-login-action-role FOR user-login-action-role ) :
     2506     define variable v-return-value as character no-undo .
     2507     run procedure-get-role-context in this-procedure
     2508       (input  buf_user-login-action-role.action-role-context
     2509       ,output v-return-value
     2510       ) .
     2511     return v-return-value .
     2512   END FUNCTION.
