     4772   end.
     4773   run xml-doc_create-parts in this-procedure (input pardoc-code) no-error.
     4774   if error-status :error then do:
     4775     return error substitute( "Ошибка при создании временной таблицы партий документа &1" + chr(10) + "&2", error-status :get-message( 1 ), return-value ).
     4776   end.
     4777   run xml-doc_create-attr in this-procedure (input pardoc-code) no-error.
     4778   if error-status :error then do:
     4779     return error substitute( "Ошибка при создании временной таблицы атрибутов документа &1" + chr(10) + "&2", error-status :get-message( 1 ), return-value ).
     4780   end.
     4781   if paroutput-file = ?  or
     4782      paroutput-file = "" then do:
     4783      output stream trn-out to value ("./" + varfile-name + ".tmp").
     4784      run write-string in this-procedure
     4785        (input '<?xml version="1.0" encoding="windows-1251"?>':u + chr(10) + '<root>':u + chr(10)
     4786        ).
     4787   end.
     4788   else do:
     4789     output stream trn-out to value(paroutput-file) append.
     4790   end.
     4791   run xml-doc_export-doc in this-procedure (input this-procedure,
     4792                                             input "write-string") no-error.
     4793   if error-status :error then do:
