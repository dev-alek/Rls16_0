     2472     end.
     2473   end procedure.
     2474   procedure xml-doc_export-line :
     2475     define input  parameter p-handle-callback as handle    no-undo .
     2476     define input  parameter p-proc-name       as character no-undo .
     2477     define buffer bf_tt-doc-line for tt-doc-line .
     2478     define buffer bf_goods       for ub.goods.
     2479     define variable varis-petrol as logical   no-undo.
     2480     define variable varis-pieces as logical   no-undo.
     2481     define variable custvalue    as character no-undo.
     2482     define variable custtype     as character no-undo.
     2483     define variable v-prefix as character no-undo .
     2484     define variable v-suffix as character no-undo .
     2485     do
     2486     on error undo, return error return-value
     2487     :
     2488       assign
     2489         v-prefix = "    "
     2490         v-suffix = chr(10)
     2491       .
     2492       run gbl/conf-rd.p ("is-custm" , "", "", 0, "", "", "", no, output custvalue, output custtype) no-error.
     2493       for each bf_tt-doc-line on error undo, return error return-value :
     2494         find first bf_goods where bf_goods.artic     = bf_tt-doc-line.artic    and
     2495                                   bf_goods.prod-type = bf_tt-doc-line.ProdType and
     2496                                   bf_goods.prod-code = bf_tt-doc-line.ProdCode no-lock.
     2497   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2498     (
     2499        input bf_goods.artic
     2500     ,  input bf_goods.prod-type
     2501     ,  input bf_goods.prod-code
     2502     , output varis-petrol
     2503     , output varis-pieces
     2504     ) no-error.
     2505         if error-status:error then do:
     2506           return error return-value.
     2507         end.
     2508         run value(p-proc-name) in p-handle-callback
     2509           (input '  <doc-line>' + chr(10)
     2510           ) .
     2511                     run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'DocCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-doc-line.DocCode))) + v-suffix ) .
     2512               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Artic', xml-doc_ReplaceSpecSymbols(string(bf_tt-doc-line.Artic))) + v-suffix ) .
     2513               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ProdType', xml-doc_ReplaceSpecSymbols(string(bf_tt-doc-line.ProdType))) + v-suffix ) .
