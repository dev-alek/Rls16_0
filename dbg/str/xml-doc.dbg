     2654   procedure xml-doc_export-barcode :
     2655     define input  parameter p-handle-callback as handle    no-undo .
     2656     define input  parameter p-proc-name       as character no-undo .
     2657     define buffer bf_tt-barcode for tt-barcode .
     2658     define variable v-prefix as character no-undo .
     2659     define variable v-suffix as character no-undo .
     2660     do
     2661     on error undo, return error return-value
     2662     :
     2663       assign
     2664         v-prefix = "    "
     2665         v-suffix = chr(10)
     2666       .
     2667       for each bf_tt-barcode on error undo, return error return-value :
     2668         run value(p-proc-name) in p-handle-callback
     2669             (input '   <barcodedop>' + chr(10)
     2670             ) .
     2671                     run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'DocCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-barcode.DocCode))) + v-suffix ) .
     2672               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'GdsCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-barcode.GdsCode))) + v-suffix ) .
     2673               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BarCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-barcode.BarCode))) + v-suffix ) .
     2674         run value(p-proc-name) in p-handle-callback
     2675             (input '   </barcodedop>' + chr(10)
     2676             ) .
     2677       end.
     2678     end.
     2679   end procedure.
