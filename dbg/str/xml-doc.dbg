     3901       field min-marg      as character
     3902       field max-marg      as character
     3903       field cli-type      as character
     3904       field cli-code      as integer
     3905       field notcorr      as character
     3906       field name          as character
     3907       field level         as integer
     3908       field mark          as character
     3909       index pi is primary unique sort-name
     3910       index fn full-name
     3911       index nc is unique node-code
     3912       index sl sel
     3913       index uc upper-code
     3914   .
     3915   define temp-table temp_grplib_found-grp no-undo
     3916       field full-name   as character
     3917       field sort-name   as character
     3918       field node-code   as integer
     3919       field level       as integer
     3920       field is-terminal as logical
     3921       index pi is primary unique sort-name
     3922       index fn full-name
     3923       index lv level
     3924       index it is-terminal
     3925   .
     3926   define temp-table temp_found-result-nodelist no-undo
     3927       field node-code     as recid
     3928       field processed     as logical
     3929       field sort-name     as character
     3930       field full-name     as character
     3931       index pi is primary unique node-code
     3932       index ps processed
     3933   .
     3934   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     3935   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     3936   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     3937   procedure grplib-get-parameters :
     3938   define input parameter p-store-type     as character        no-undo.
     3939   define input parameter p-store-code     as integer          no-undo.
     3940   do
     3941   on error undo, return error
     3942   :
     3943       assign
     3944           v-grplib-not-fill-extra-info = no
     3945       .
     3946   end.
     3947   end procedure.
     3948   procedure grplib-get-sort-name :
     3949   do
     3950   on error undo, return error
     3951   :
     3952   define input parameter p-node-code  as integer      no-undo.
     3953   define output parameter p-sort-name as character    no-undo.
     3954       define variable v-upper-code    as integer           no-undo.
     3955       define buffer buf_gds-grp       for ub.gds-grp.
     3956       define buffer buf_upper_gds-grp for ub.gds-grp.
     3957       find first buf_gds-grp no-lock
     3958            where buf_gds-grp.node-code = p-node-code
     3959       no-error.
     3960       if not available buf_gds-grp
     3961       then do:
     3962           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3963       end.
     3964       assign
     3965           p-sort-name  = ""
     3966           v-upper-code = 1
     3967       .
     3968       do while buf_gds-grp.upper-code <> 0
     3969       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     3970       :
     3971           assign
     3972               p-sort-name  = buf_gds-grp.node-name
     3973                            + (if p-sort-name <> "" then chr(2) else "")
     3974                            + p-sort-name
     3975               v-upper-code = buf_gds-grp.upper-code
     3976           .
     3977           find first buf_gds-grp no-lock
     3978                where buf_gds-grp.node-code = v-upper-code
     3979           no-error.
     3980           if not available buf_gds-grp
     3981           then do:
     3982               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     3983                                   + string( v-upper-code )
     3984                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3985           end.
     3986       end.
     3987   end.
     3988   end procedure.
     3989   define variable vss-include-info16 as character format "X(65)" no-undo
     3990   initial "@(#)$Workfile$ $Revision$".
     3991   procedure grplib-get-full-name :
     3992      define input parameter p-node-code  as integer      no-undo.
     3993      define output parameter p-full-name as character    no-undo.
     3994      do
     3995   on error undo, return error
     3996   :
     3997       define variable v-upper-code    as integer           no-undo.
     3998       define buffer buf_gds-grp       for ub.gds-grp.
     3999       define buffer buf_upper_gds-grp for ub.gds-grp.
     4000       find first buf_gds-grp no-lock
     4001            where buf_gds-grp.node-code = p-node-code
     4002       no-error.
     4003       if not available buf_gds-grp
     4004       then do:
     4005           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4006       end.
     4007       assign
     4008           p-full-name  = ""
     4009           v-upper-code = 1
     4010       .
     4011       do while buf_gds-grp.upper-code <> 0
     4012       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4013       :
     4014           assign
     4015               p-full-name  = buf_gds-grp.node-name
     4016                            + (if p-full-name <> "" then chr(47) else "")
     4017                            + p-full-name
     4018               v-upper-code = buf_gds-grp.upper-code
     4019           .
     4020           find first buf_gds-grp no-lock
     4021                where buf_gds-grp.node-code = v-upper-code
     4022           no-error.
     4023           if not available buf_gds-grp
     4024           then do:
     4025               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4026                                   + string( v-upper-code )
     4027                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4028           end.
     4029       end.
     4030       assign
     4031       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4032       .
     4033   end.
     4034   end .
     4035   procedure grplib-get-node-from-full-name :
     4036   define input parameter p-full-name as character no-undo .
     4037   define output parameter p-node-code as integer no-undo .
     4038   define variable v-ii as integer no-undo .
     4039   define variable v-upper-code as integer no-undo .
     4040   define variable v-root-code as integer no-undo .
     4041   define variable v-entry as character no-undo .
     4042   define buffer buf_gds-grp       for ub.gds-grp.
     4043   do
     4044   on error undo, return error
     4045   :
     4046     find first buf_gds-grp no-lock
     4047         where buf_gds-grp.upper-code = 0
     4048     no-error .
     4049     if not available buf_gds-grp
     4050     then do:
     4051         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4052     end.
     4053     else do:
     4054       assign
     4055       v-root-code = buf_gds-grp.node-code
     4056       .
     4057     end.
     4058     v-upper-code = v-root-code.
     4059     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4060       assign
     4061       v-entry = entry(v-ii, p-full-name, chr(47)).
     4062       if v-entry = '' then leave.
     4063       find first buf_gds-grp no-lock where
     4064                 buf_gds-grp.node-name = v-entry
     4065             and buf_gds-grp.upper-code = v-upper-code
     4066             no-error.
     4067       if not available buf_gds-grp then do:
     4068         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4069       end.
     4070       else do:
     4071         p-node-code = buf_gds-grp.node-code.
     4072         v-upper-code = buf_gds-grp.node-code.
     4073       end.
     4074     end.
     4075   end.
     4076   end .
     4077   procedure grplib-get-root-code :
     4078   do
     4079   on error undo, return error
     4080   :
     4081   define output parameter p-root-code as integer      no-undo.
     4082       define buffer buf_gds-grp       for ub.gds-grp.
     4083       find first buf_gds-grp no-lock
     4084           where buf_gds-grp.upper-code = 0
     4085       no-error .
     4086       if not available buf_gds-grp
     4087       then do:
     4088           undo, return error .
     4089       end.
     4090       else do:
     4091           assign
     4092               p-root-code = buf_gds-grp.node-code
     4093           .
     4094       end.
     4095   end.
     4096   end procedure.
     4097   procedure grplib-find-grp-by-full-name :
     4098   do
     4099   on error undo, return error
     4100   :
     4101   define input parameter p-search-name  as character    no-undo.
     4102   define input parameter p-fill-path    as logical      no-undo.
     4103   define output parameter p-found       as logical      no-undo.
     4104       define variable v-upper-code    as integer          no-undo.
     4105       define variable v-counter       as integer           no-undo.
     4106       define variable v-level         as integer           no-undo.
     4107       define variable v-full-name     as character         no-undo.
     4108       define variable v-sort-name     as character         no-undo.
     4109       define buffer buf_gds-grp       for ub.gds-grp.
     4110       assign
     4111           p-search-name = replace( p-search-name, chr(47), chr(2) )
     4112       .
     4113       run grplib-get-root-code ( output v-upper-code ) no-error .
     4114       if error-status :error
     4115       then do:
     4116           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     4117       end.
     4118       assign
     4119           v-full-name  = ""
     4120           v-level      = num-entries( p-search-name, chr(2) )
     4121       .
     4122       for each temp_grplib_found-grp
     4123       :
     4124           delete temp_grplib_found-grp.
     4125       end.
     4126       start-name-analyze:
     4127       do v-counter = 1 to v-level
     4128       :
     4129           if v-counter < v-level
     4130           then do:
     4131               find first buf_gds-grp no-lock
     4132                    where buf_gds-grp.upper-code = v-upper-code
     4133                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     4134               no-error .
     4135               if not available buf_gds-grp
     4136               then do:
     4137                   assign
     4138                       v-full-name  = p-search-name
     4139                       v-sort-name  = p-search-name
     4140                   .
     4141                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     4142               end.
     4143               else do:
     4144                   assign
     4145                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     4146                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     4147                       v-upper-code = buf_gds-grp.node-code
     4148                   .
     4149                   if p-fill-path = yes
     4150                   then do:
     4151                       create temp_grplib_found-grp.
     4152                       assign
     4153                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     4154                           temp_grplib_found-grp.sort-name = v-sort-name
     4155                           temp_grplib_found-grp.node-code = v-upper-code
     4156                           temp_grplib_found-grp.level     = v-counter
     4157                       .
     4158                   end.
     4159               end.
     4160           end.
     4161           else do:
     4162               for each buf_gds-grp no-lock
     4163                  where buf_gds-grp.upper-code = v-upper-code
     4164                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     4165               :
     4166                   assign
     4167                       p-found = yes
     4168                   .
     4169                   create temp_grplib_found-grp.
     4170                   assign
     4171                       temp_grplib_found-grp.full-name = v-full-name
     4172                                                           + (if v-full-name = "" then "" else chr(47) )
     4173                                                           + buf_gds-grp.node-name + chr(47)
     4174                       temp_grplib_found-grp.sort-name = v-sort-name
     4175                                                           + ( if v-sort-name = "" then "" else chr(2) )
     4176                                                           + buf_gds-grp.node-name
     4177                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     4178                       temp_grplib_found-grp.level     = v-level
     4179                   .
     4180               end.
     4181               if p-found = no
     4182               then do:
     4183                   assign
     4184                       v-full-name  = p-search-name
     4185                       v-sort-name  = p-search-name
     4186                   .
     4187                   for each temp_grplib_found-grp
     4188                   :
     4189                       delete temp_grplib_found-grp.
     4190                   end.
     4191                   assign
     4192                       p-found = no
     4193                   .
     4194               end.
     4195           end.
     4196       end.
     4197   end.
     4198   end procedure.
     4199   procedure grplib-find-all-subgroup :
     4200   do
     4201   on error undo, return error
     4202   :
     4203   define input parameter p-start-node-code    as integer      no-undo.
     4204   define input parameter p-terminal-only      as logical      no-undo.
     4205       define variable v-start-full-name   as character     no-undo.
     4206       define variable v-start-sort-name   as character     no-undo.
     4207       define variable v-not-found         as logical       no-undo.
     4208       define variable v-is-terminal       as logical       no-undo.
     4209       define buffer buf_gds-grp           for ub.gds-grp.
     4210       create temp_found-result-nodelist.
     4211       assign
     4212           temp_found-result-nodelist.node-code = p-start-node-code
     4213           temp_found-result-nodelist.processed = no
     4214       .
     4215       run grplib-get-full-name in this-procedure (
     4216             input p-start-node-code
     4217           , output v-start-full-name
     4218       ).
     4219       run grplib-get-full-name in this-procedure (
     4220             input p-start-node-code
     4221           , output v-start-sort-name
     4222       ).
     4223       process-nodes:
     4224       do while yes
     4225       :
     4226           find first temp_found-result-nodelist
     4227                where temp_found-result-nodelist.node-code = p-start-node-code
     4228           .
     4229           assign
     4230               temp_found-result-nodelist.processed = yes
     4231           .
     4232           for each buf_gds-grp no-lock
     4233              where buf_gds-grp.upper-code = p-start-node-code
     4234           on error undo, return error
     4235           :
     4236               run grplib-is-terminal in this-procedure (
     4237                     input buf_gds-grp.node-code
     4238                   , output v-is-terminal
     4239               ).
     4240               if v-is-terminal = yes
     4241               then do:
     4242                   create temp_grplib_found-grp.
     4243                   assign
     4244                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4245                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     4246                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4247                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     4248                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     4249                       temp_grplib_found-grp.is-terminal = yes
     4250                   .
     4251               end.
     4252               else do:
     4253                   create temp_found-result-nodelist.
     4254                   assign
     4255                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     4256                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     4257                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     4258                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     4259                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     4260                       temp_found-result-nodelist.processed = no
     4261                   .
     4262                   if p-terminal-only = no
     4263                   then do:
     4264                       create temp_grplib_found-grp.
     4265                       assign
     4266                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     4267                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     4268                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     4269                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     4270                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     4271                           temp_grplib_found-grp.is-terminal = no
     4272                       .
     4273                   end.
     4274               end.
     4275           end.
     4276           find first temp_found-result-nodelist
     4277                where temp_found-result-nodelist.processed = no
     4278           no-error.
     4279           if not available temp_found-result-nodelist
     4280           then do:
     4281               leave process-nodes.
     4282           end.
     4283           else do:
     4284               assign
     4285                   p-start-node-code = temp_found-result-nodelist.node-code
     4286                   v-start-full-name = temp_found-result-nodelist.full-name
     4287                   v-start-sort-name = temp_found-result-nodelist.sort-name
     4288               .
     4289           end.
     4290       end.
     4291   end.
     4292   end procedure.
     4293   procedure grplib-expand-name :
     4294   define input parameter p-start-name as character        no-undo.
     4295   define output parameter p-end-name  as character        no-undo.
     4296       define variable v-is-terminal   as logical      no-undo.
     4297       define variable v-found         as character    no-undo.
     4298       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     4299   do
     4300   for buf_temp_grplib_found-grp
     4301   on error undo, return error
     4302   :
     4303       run grplib-find-grp-by-full-name in this-procedure (
     4304             input p-start-name
     4305           , input no
     4306           , output v-found
     4307       ) no-error.
     4308       run grplib-get-max-substring in this-procedure (
     4309                   input length( p-start-name )
     4310                 , output p-end-name
     4311       ) no-error .
     4312       if error-status :error
     4313       then do:
     4314           assign
     4315               p-end-name = ""
     4316           .
     4317       end.
     4318       else do:
     4319           find first temp_grplib_found-grp
     4320               where temp_grplib_found-grp.full-name = p-end-name
     4321           no-error.
     4322           if available temp_grplib_found-grp
     4323           then do:
     4324               find first buf_temp_grplib_found-grp
     4325                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     4326                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     4327               no-error.
     4328               if not available buf_temp_grplib_found-grp
     4329               then do:
     4330                   run grplib-is-terminal in this-procedure (
     4331                       input temp_grplib_found-grp.node-code
     4332                       , output v-is-terminal
     4333                   ).
     4334               end.
     4335           end.
     4336       end.
     4337   end.
     4338   end procedure.
     4339   procedure grplib-get-max-substring :
     4340   do
     4341   on error undo, return error
     4342   :
     4343   define input parameter p-min-substring-length   as integer      no-undo.
     4344   define output parameter p-substring             as character    no-undo.
     4345           define variable v-char-counter  as integer           no-undo.
     4346           define variable v-current-char  as character         no-undo.
     4347           define variable v-names-counter  as integer           no-undo.
     4348           define variable v-base-string   as character         no-undo.
     4349           assign
     4350               v-char-counter  = p-min-substring-length
     4351           .
     4352           find first temp_grplib_found-grp no-error.
     4353           if not available temp_grplib_found-grp
     4354           then do:
     4355               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     4356           end.
     4357           else do:
     4358               assign
     4359                   v-base-string  = temp_grplib_found-grp.full-name
     4360                   v-char-counter = 0
     4361               .
     4362               counter-block:
     4363               do while yes
     4364               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     4365               :
     4366                   assign
     4367                       v-char-counter  = v-char-counter + 1
     4368                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     4369                       v-names-counter = 0
     4370                   .
     4371                   compare-block:
     4372                   for each temp_grplib_found-grp
     4373                   :
     4374                       assign
     4375                           v-names-counter = v-names-counter + 1
     4376                       .
     4377                       if v-names-counter = 1
     4378                       then do:
     4379                           next compare-block.
     4380                       end.
     4381                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     4382                       then do:
     4383                           leave counter-block.
     4384                       end.
     4385                   end.
     4386                   if v-names-counter = 1
     4387                   then do:
     4388                       assign
     4389                           p-substring = v-base-string
     4390                       .
     4391                       return.
     4392                   end.
     4393               end.
     4394               assign
     4395                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     4396               .
     4397           end.
     4398   end.
     4399   end procedure.
     4400   procedure grplib-is-terminal :
     4401   do
     4402   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     4403   :
     4404   define input parameter p-node-code      as integer      no-undo.
     4405   define output parameter p-is-terminal   as logical      no-undo.
     4406       define buffer buf_gds-grp       for ub.gds-grp.
     4407       find first buf_gds-grp no-lock
     4408           where buf_gds-grp.upper-code = p-node-code
     4409       no-error .
     4410       if not available buf_gds-grp
     4411       then do:
     4412           assign
     4413               p-is-terminal = yes
     4414           .
     4415       end.
     4416       else do:
     4417           assign
     4418               p-is-terminal = no
     4419           .
     4420       end.
     4421   end.
     4422   end procedure.
     4423   procedure grplib-have-goods :
     4424   do
     4425   on error undo, return error
     4426   :
     4427   define input parameter p-node-code      as integer      no-undo.
     4428   define output parameter p-have-goods   as logical      no-undo.
     4429       define buffer buf_goods         for ub.goods.
     4430       find first buf_goods no-lock
     4431            where buf_goods.grp-code = p-node-code
     4432       no-error .
     4433       if available buf_goods
     4434       then do:
     4435           assign
     4436               p-have-goods = yes
     4437           .
     4438       end.
     4439       else do:
     4440           assign
     4441               p-have-goods = no
     4442           .
     4443       end.
     4444   end.
     4445   end procedure.
     4446   procedure grplib-find-by-substring :
     4447   do
     4448   on error undo, return error
     4449   :
     4450   define input parameter p-start-code         as integer      no-undo.
     4451   define input parameter p-full-search-string as character    no-undo.
     4452   define output parameter p-found-code        as integer      no-undo.
     4453   define output parameter p-full-name         as character    no-undo.
     4454       define variable v-start-code     as integer           no-undo.
     4455       define variable v-found          as logical  init no  no-undo.
     4456       define buffer buf_gds-grp       for ub.gds-grp.
     4457       search-grp:
     4458       for each buf_gds-grp no-lock
     4459           where buf_gds-grp.node-code > p-start-code
     4460       :
     4461           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     4462           then do:
     4463               assign
     4464                   p-found-code = buf_gds-grp.node-code
     4465                   v-found      = yes
     4466               .
     4467               run grplib-get-full-name in this-procedure (
     4468                     input p-found-code
     4469                   , output p-full-name
     4470               ) no-error .
     4471               if error-status :error
     4472               then do:
     4473                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     4474               end.
     4475               leave search-grp.
     4476           end.
     4477       end.
     4478       if v-found = yes
     4479       then do:
     4480       end.
     4481       else do:
     4482           assign
     4483               p-full-name  = ""
     4484               p-found-code = 0
     4485           .
     4486       end.
     4487   end.
     4488   end procedure.
     4489   procedure grplib-analyze-grp-name :
     4490   do
     4491   on error undo, return error
     4492   :
     4493   define input parameter p-grp-name       as character            no-undo.
     4494   define input parameter p-upper-code     as integer              no-undo.
     4495   define output parameter p-error-message as character init ""    no-undo.
     4496       define variable v-char-list     as character    no-undo.
     4497       define variable v-char-counter  as integer      no-undo.
     4498       define variable v-full-name     as character    no-undo.
     4499       if p-grp-name = "" then do:
     4500           assign
     4501               p-error-message = "Название группы не может быть пустым.".
     4502           .
     4503       end.
     4504       else do:
     4505           assign
     4506               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     4507           .
     4508           do v-char-counter = 1 to num-entries( v-char-list )
     4509           :
     4510               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     4511               then do:
     4512                   assign
     4513                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     4514                   .
     4515                   return.
     4516               end.
     4517           end.
     4518           if p-upper-code > 0
     4519           then do:
     4520               run grplib-get-full-name in this-procedure (
     4521                     input p-upper-code
     4522                   , output v-full-name
     4523               ) no-error .
     4524               if error-status :error
     4525               then do:
     4526                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     4527               end.
     4528               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     4529               then do:
     4530                   assign
     4531                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     4532                   .
     4533               end.
     4534           end.
     4535       end.
     4536   end.
     4537   end procedure.
     4538   procedure grplib-get-lvl-num :
     4539   define input parameter p-node-code  as integer      no-undo.
     4540   define output parameter p-lvl-num   as integer      no-undo.
     4541       define variable v-full-name    as character    no-undo.
     4542   do
     4543   on error undo, return error
     4544   :
     4545       run grplib-get-full-name in this-procedure (
     4546             input p-node-code
     4547           , output v-full-name
     4548       ).
     4549       assign
     4550           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     4551       .
     4552       if p-lvl-num = -1
     4553       then do:
     4554           assign
     4555               p-lvl-num = 0
     4556           .
     4557       end.
     4558   end.
     4559   end procedure.
     4560   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4561   function octal-to-char return character
     4562   ( p-string as character ) :
     4563     def var v-asc     as integer no-undo .
     4564     def var v-new-asc as integer no-undo .
     4565     def var ind       as integer no-undo .
     4566     if length(p-string) <> 3 then do:
     4567       return ? .
     4568     end.
     4569     assign
     4570       v-asc = 0
     4571     .
     4572     do ind = 1 to length(p-string)
     4573     :
     4574       assign
     4575         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     4576       .
     4577       if v-new-asc < 0 or v-new-asc >= 8 then do:
     4578         return ? .
     4579       end.
     4580       assign
     4581         v-asc = v-asc * 8 + v-new-asc
     4582       .
     4583     end.
     4584     return chr(v-asc) .
     4585   end function .
     4586   function char-to-octal return character
     4587   ( p-chr as character ) :
     4588     def var v-asc    as integer   no-undo .
     4589     def var ind      as integer   no-undo .
     4590     def var v-string as character no-undo .
     4591     if length(p-chr) <> 1 then do:
     4592       return ? .
     4593     end.
     4594     assign
     4595       v-asc    = asc(p-chr)
     4596       v-string = ""
     4597     .
     4598     do ind = 1 to 3
     4599     :
     4600       assign
     4601         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     4602       .
     4603       assign
     4604         v-asc = truncate(v-asc / 8, 0)
     4605       .
     4606     end.
     4607     return v-string .
     4608   end.
     4609   function str-encode return character
     4610   (   p-init-string       as character
     4611     , p-encode-char       as character
     4612     , p-special-char-list as character
     4613   ) :
     4614     def var p-encode-string as character no-undo .
     4615     def var ind                as integer no-undo .
     4616     def var v-num-special-char as integer no-undo .
     4617     def var v-special-char     as character no-undo .
     4618     if p-encode-char = ?
     4619     or p-encode-char = "" then do:
     4620       assign
     4621         p-encode-char = "~~"
     4622       .
     4623     end.
     4624     if p-init-string = ? then do:
     4625       return "?" .
     4626     end.
     4627     if p-init-string = "?" then do:
     4628       return p-encode-char + char-to-octal("?") .
     4629     end.
     4630     assign
     4631       v-num-special-char = length(p-special-char-list)
     4632       p-encode-string    = replace(p-init-string
     4633                                   ,p-encode-char
     4634                                   ,p-encode-char + char-to-octal(p-encode-char)
     4635                                   )
     4636     .
     4637     do ind = 1 to v-num-special-char
     4638     :
     4639       assign
     4640         v-special-char = substring(p-special-char-list, ind, 1)
     4641       .
     4642       if v-special-char <> p-encode-char then do:
     4643         assign
     4644           p-encode-string = replace (p-encode-string
     4645                                     ,v-special-char
     4646                                     ,p-encode-char + char-to-octal(v-special-char)
     4647                                     )
     4648         .
     4649       end.
     4650     end.
     4651     return p-encode-string .
     4652   end.
     4653   function str-decode returns character
     4654     (p-init-string   as character
     4655     ,p-encode-char   as character
     4656     ) :
     4657     def var p-decode-string as character no-undo .
     4658     def var ind                       as integer no-undo .
     4659     def var v-num-entries-init-string as integer no-undo .
     4660     def var v-sub-phrase              as character no-undo .
     4661     def var v-special-char            as character no-undo .
     4662     if p-encode-char = ?
     4663     or p-encode-char = "" then do:
     4664       assign
     4665         p-encode-char = "~~"
     4666       .
     4667     end.
     4668     if p-init-string = "?" then do:
     4669       return ? .
     4670     end.
     4671     assign
     4672       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     4673     .
     4674     if v-num-entries-init-string > 1 then do:
     4675       assign
     4676         p-decode-string = entry(1, p-init-string, p-encode-char)
     4677       .
     4678       do ind = 2 to v-num-entries-init-string
     4679       :
     4680         assign
     4681           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     4682         .
     4683         assign
     4684           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     4685         .
     4686         if v-special-char <> ? then do:
     4687           assign
     4688             p-decode-string = p-decode-string
     4689                             + v-special-char
     4690                             + substring(v-sub-phrase, 4)
     4691           .
     4692         end.
     4693         else do:
     4694           assign
     4695             p-decode-string = p-decode-string
     4696                             + p-encode-char
     4697                             + v-sub-phrase
     4698           .
     4699         end.
     4700       end.
     4701     end.
     4702     else do:
     4703       assign
     4704         p-decode-string = p-init-string
     4705       .
     4706     end.
     4707     return p-decode-string .
     4708   end.
     4709   define buffer bf_clients for ub.clients.
     4710   define buffer bf_trn-doc for ub.trn-doc.
     4711   define buffer bf_shop    for ub.shop.
     4712   define buffer bf_store   for ub.store.
     4713   define stream trn-out.
     4714   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4716     (output varr-b
     4717     )  .
     4718   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock.
     4719   find first bf_clients where bf_clients.obj-type = bf_trn-doc.obj-type and
     4720                               bf_clients.obj-code = bf_trn-doc.obj-code no-lock.
     4721   if bf_clients.obj-type = 'маг':U then do:
     4722     find first bf_shop where bf_shop.obj-code = bf_clients.obj-code no-lock.
     4723     assign
     4724       varshift = string(bf_shop.shift-on).
     4725   end.
     4726   else do:
     4727     find first bf_store where bf_store.obj-code = bf_clients.obj-code no-lock.
     4728     assign
     4729       varshift = string(bf_store.shift-on).
     4730   end.
     4731   assign
     4732   varfile-name = str-encode( input replace(pardoc-code , "*", "$")
     4733                             ,input ''
     4734                             ,input '\/:*?"<>|':U
     4735                             )
     4736   .
