     3172       else do:
     3173             assign
     3174               v-parts-fact-qnty           = (if buf_trn-doc.doc-type = 'при':U
     3175                                         or buf_trn-doc.doc-type = 'возврат':U
     3176                                         or buf_trn-doc.doc-type = 'инв':U
     3177                                         then buf_doc-line.fact-qnty
     3178                                         else - buf_doc-line.fact-qnty
     3179                                       )
     3180             .
     3181   assign
     3182     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     3183     price-base-with-tax-loc = buf_doc-line.price-base
     3184   .
     3185   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3187     (output varinvprb
     3188     )  .
     3189      find first in-vatp_doc-attr no-lock
     3190       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     3191         and in-vatp_doc-attr.attr-code = 'envd':U
     3192       no-error .
     3193       if available in-vatp_doc-attr
     3194          then do:
     3195          assign
     3196            in-vatp-have-vat-slt = no.
     3197      end.
     3198      else do:
     3199        assign
     3200          in-vatp-have-vat-slt = yes.
     3201      end.
     3202      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     3203                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     3204                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     3205      if (not buf_trn-doc.internal and
     3206              buf_trn-doc.doc-type = 'при':U) or
     3207         in-vatp-goods.gds-type = 'у':U then do:
     3208         if varinvprb = "base":u then do:
     3209           assign
     3210             road-tax-base-loc = buf_doc-line.road-tax
     3211             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     3212         end.
     3213         else do:
     3214           ASSIGN
     3215             road-tax-rubl-loc = buf_doc-line.road-tax
     3216             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     3217         end.
     3218         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     3219         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     3220         assign
     3221           road-tax-cli-loc = ?.
     3222         ASSIGN
     3223           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     3224           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     3225           transport-cli-loc  = 0
     3226           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     3227           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     3228           other-cli-loc      = 0
     3229           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     3230           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     3231                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3232               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3233         assign
     3234           vat-cli-loc            = ?
     3235           slt-cli-loc            = ?
     3236           price-cli-with-tax-loc = ?.
     3237      end.
     3238      else do:
     3239                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     3240                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     3241                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     3242                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     3243                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     3244                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     3245                            use-index out-code no-lock:
     3246             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     3247                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     3248                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     3249                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     3250                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     3251                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     3252                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3253                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3254                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3255                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3256                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     3257                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     3258                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     3259                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     3260                         .
     3261         end.
     3262         ASSIGN
     3263           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     3264           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     3265           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     3266           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     3267           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     3268           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     3269                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     3270           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     3271                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     3272           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     3273           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     3274           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     3275         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     3276         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     3277         if transport-base-loc = ? then transport-base-loc = 0.
     3278         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     3279         if other-base-loc     = ? then other-base-loc     = 0.
     3280         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     3281         assign
     3282           transport-cli-loc      = 0
     3283           other-cli-loc          = 0
     3284           road-tax-cli-loc       = ?
     3285           vat-cli-loc            = ?
     3286           slt-cli-loc            = ?
     3287           price-cli-with-tax-loc = ?.
     3288      end.
     3289   ASSIGN
     3290             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3291       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3292   .
     3293             assign
     3294               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     3295               v-vat-pc              = vat-pc-loc
     3296               v-slt-pc              = slt-pc-loc
     3297               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     3298               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     3299               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     3300               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     3301               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     3302               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     3303               v-road-tax-base       =  0
     3304               v-road-tax-rubl       =  0
     3305               v-excise-base         =  0
     3306               v-excise-rubl         =  0
     3307               v-transport-base      =  0
     3308               v-transport-rubl      =  0
     3309               v-other-base          =  0
     3310               v-other-rubl          =  0
     3311             .
     3312       end.
     3313     end.
     3314   end procedure.
     3315   define variable vss-include-info10 as character format "X(65)" no-undo
     3316   initial "@(#)$Workfile$ $Revision$".
     3317   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3318   procedure r-sale :
     3319     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
     3320     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
     3321     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
     3322     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
     3323     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     3324     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
     3325     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     3326     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     3327     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     3328     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     3329     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     3330     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
     3331     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     3332     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     3333     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     3334     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
     3335     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     3336     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
     3337     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     3338     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     3339     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     3340     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     3341     do
     3342     on error undo, return error
     3343     :
     3344       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     3345       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     3346       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     3347       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     3348       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     3349       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     3350       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     3351       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     3352       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     3353       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     3354       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     3355       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     3356       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     3357       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
