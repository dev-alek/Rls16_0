     3544     ,output varempty-scale
     3545     ) no-error .
     3546   if error-status :error then do:
     3547     message
     3548       vss-workfile vss-revision vss-description skip
     3549       "Ошибка при определении атрибута признака" skip
     3550       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3551       "Признак" varroot-node skip
     3552       "Запрашивался атрибут" "empty-scale=request" skip
     3553       error-status :get-message(1) skip
     3554       return-value skip
     3555       view-as alert-box error .
     3556     undo, return error .
     3557   end.
     3558   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3560     (output varoutvprb
     3561     )  .
     3562   if varoutvprb = "base":u then do:
     3563     assign
     3564           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     3565       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     3566     .
     3567   end.
     3568   else do:
     3569     assign
     3570           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     3571       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     3572     .
     3573   end.
     3574   if varoutvprb = "rubl":u then do:
     3575     assign
     3576           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     3577       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     3578   end.
     3579   else do:
     3580     assign
     3581           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     3582       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     3583   end.
     3584   assign
     3585     varis-cons-parts-have =  no.
     3586   assign
     3587     varfact-qnty       = 0
     3588     varcons-qnty       = 0
     3589     varprice-base-cons = 0
     3590     varprice-rubl-cons = 0.
     3591   find first out-vatp_doc-line where
     3592              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     3593          and out-vatp_doc-line.artic      = buf_doc-line.artic
     3594          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     3595          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     3596   if available out-vatp_doc-line           and
     3597     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     3598     assign
     3599       varfact-qnty = out-vatp_doc-line.fact-qnty.
     3600   end.
     3601   else do:
     3602     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     3603                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     3604                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     3605                                  and out-vatp_parts.artic      = buf_doc-line.artic
     3606                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     3607                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     3608       if out-vatp_parts.purch-code = 2 then do:
     3609   assign
     3610     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     3611     price-base-with-tax-loco = out-vatp_parts.price-base
     3612   .
     3613   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3615     (output varinvprbo
     3616     )  .
     3617     if out-vatp_parts.out-code = 'free-zone':U     or
     3618        out-vatp_parts.out-code = 'out-zone':U   or
     3619        out-vatp_parts.doc-type = 'акт':U then do:
     3620       assign
     3621         in-vatp-have-vat-slto = yes.
     3622     end.
     3623     else do:
     3624       find first in-vatp_doc-attro no-lock
     3625         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     3626           and in-vatp_doc-attro.attr-code = 'envd':U
     3627         no-error .
     3628       if not available in-vatp_doc-attro then do:
     3629         assign
     3630           in-vatp-have-vat-slto = yes.
     3631       end.
     3632       else do:
     3633            in-vatp-have-vat-slto = no.
     3634       end.
     3635     end.
     3636     assign
     3637      price-cli-with-tax-loco = out-vatp_parts.price-cli
     3638      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     3639     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     3640              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     3641     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     3642             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     3643             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     3644             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     3645             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     3646             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     3647             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     3648       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     3649     assign
     3650       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     3651     assign
     3652       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     3653       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     3654       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     3655       transport-cli-loco  = 0
     3656       other-cli-loco      = 0
     3657     .
