      938   define variable v-sort as integer   no-undo .
      939   procedure xml-doc_clear-doc :
      940     define buffer bf_tt-trn-doc     for tt-trn-doc .
      941     define buffer bf_tt-trn-doc-add for tt-trn-doc-add.
      942     do
      943     on error undo, return error return-value
      944     :
      945       for each bf_tt-trn-doc
      946       on error undo, return error return-value
      947       :
      948         delete bf_tt-trn-doc .
      949       end.
      950       for each bf_tt-trn-doc-add
      951       on error undo, return error return-value
      952       :
      953         delete bf_tt-trn-doc-add .
      954       end.
      955     end.
      956   end procedure.
      957   procedure xml-doc_clear-line :
