     1837       end.
     1838       if varis-petrol     and
     1839          not varis-pieces and
     1840          bf_trn-doc.ext-doc-type = 'ie':U  then do:
     1841                           find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "car-num"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.CarNum = bf_doc-line-attr.attr-value.                       end.
     1842                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "car-vol"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.CarVol = bf_doc-line-attr.attr-value.                       end.
     1843                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "tests"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.Tests = bf_doc-line-attr.attr-value.                       end.
     1844                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "autoentobj-type"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.AutoentObjType = bf_doc-line-attr.attr-value.                       end.
     1845                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "autoentobj-code"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.AutoentObjCode = bf_doc-line-attr.attr-value.                       end.
     1846                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "item-pour"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.ItemPour = bf_doc-line-attr.attr-value.                       end.
     1847                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "time-pour"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TimePour = bf_doc-line-attr.attr-value.                       end.
     1848                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "tank-vol"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TankVol = bf_doc-line-attr.attr-value.                       end.
     1849                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "tank-temp"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TankTemp = bf_doc-line-attr.attr-value.                       end.
     1850                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "tank-water"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TankWater = bf_doc-line-attr.attr-value.                       end.
     1851                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "tank-density"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TankDensity = bf_doc-line-attr.attr-value.                       end.
     1852                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "tank-weight"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TankWeight = bf_doc-line-attr.attr-value.                       end.
     1853                     find first bf_doc-line-attr where bf_doc-line-attr.doc-code  = bf_doc-line.doc-code and                                                         bf_doc-line-attr.gds-code  = bf_goods.gds-code    and                                                         bf_doc-line-attr.attr-code = "time-income"     no-lock no-error.                       if available bf_doc-line-attr then do:                         assign                                                                                bf_tt-doc-line.TimeIncome = bf_doc-line-attr.attr-value.                       end.
     1854       end.
     1855   end.
     1856   end.
     1857   end procedure.
     1858   procedure xml-doc_create-barcode :
     1859   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1860   define buffer bf_tt-barcode for tt-barcode.
     1861   define buffer bf_doc-line   for ub.doc-line.
     1862   define buffer bf_goods      for ub.goods.
     1863   define buffer bf_trn-doc    for ub.trn-doc.
     1864   define buffer buf_bar-code  for ub.bar-code  .
     1865   define buffer buf_prod-bc   for ub.prod-bc  .
     1866   do on error undo, return error return-value :
     1867   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     1868   if error-status:error then do:
     1869     return error substitute ("Не найден документ с номером &1.", pardoc-code).
     1870   end.
     1871   for each bf_doc-line where bf_doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1872     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1873                               bf_goods.prod-type = bf_doc-line.prod-type and
     1874                               bf_goods.prod-code = bf_doc-line.prod-code no-lock no-error.
     1875     if not available bf_goods then do:
     1876       return error substitute ("Не найден товар: &1 &2 &3.", bf_doc-line.artic, bf_doc-line.prod-type, bf_doc-line.prod-code).
     1877     end.
     1878     for each buf_bar-code no-lock where
     1879              buf_bar-code.gds-code = bf_goods.gds-code and
     1880              buf_bar-code.unit-cli = bf_goods.unit-base :
     1881               for each buf_prod-bc no-lock where
     1882                        buf_prod-bc.b-code = buf_bar-code.b-code :
     1883                         find first bf_tt-barcode where
     1884                                 bf_tt-barcode.doccode = pardoc-code and
     1885                                 bf_tt-barcode.barcode = buf_prod-bc.b-str and
     1886                                 bf_tt-barcode.gdscode = bf_goods.gds-code no-error .
     1887                         if not available bf_tt-barcode then do:
     1888                             create bf_tt-barcode.
     1889                             assign
     1890                               bf_tt-barcode.doccode = pardoc-code
     1891                               bf_tt-barcode.barcode  = buf_prod-bc.b-str
     1892                               bf_tt-barcode.gdscode = bf_goods.gds-code
     1893                             .
     1894                         end.
     1895               end.
     1896     end.
     1897   end.
     1898   end.
     1899   end procedure.
     1900   procedure xml-doc_create-dtl :
     1901   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1902   define buffer bf_tt-gds-dtl    for tt-gds-dtl.
     1903   define buffer bf_gds-dtl       for ub.gds-dtl.
     1904   define buffer bf_goods         for ub.goods.
     1905   define buffer bf-obj_clients   for ub.clients.
     1906   define buffer bf-prod_clients  for ub.clients.
     1907   define buffer bf_gds-prt       for ub.gds-prt.
     1908   define buffer bf_trn-doc       for ub.trn-doc.
     1909   define variable varb-code like ub.bar-code.b-code no-undo.
     1910   do on error undo, return error return-value :
     1911   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     1912   if error-status:error then do:
     1913     return error substitute ("Не найден документ с номером &1.", pardoc-code).
     1914   end.
     1915   for each bf_gds-dtl where bf_gds-dtl.doc-code = pardoc-code no-lock
     1916                             on error undo, return error return-value :
     1917     find first bf_goods where bf_goods.artic     = bf_gds-dtl.artic     and
     1918                               bf_goods.prod-type = bf_gds-dtl.prod-type and
     1919                               bf_goods.prod-code = bf_gds-dtl.prod-code no-lock no-error.
     1920     if error-status:error then do:
     1921       return error substitute ("Не найдент товар: &1 &2 &3.", bf_gds-dtl.artic, bf_gds-dtl.prod-type, bf_gds-dtl.prod-code).
     1922     end.
     1923     find first bf-prod_clients where bf-prod_clients.obj-type = bf_gds-dtl.prod-type and
     1924                                      bf-prod_clients.obj-code = bf_gds-dtl.prod-code no-lock.
     1925     find first bf-obj_clients  where bf-obj_clients.obj-type = bf_gds-dtl.obj-type and
     1926                                      bf-obj_clients.obj-code = bf_gds-dtl.obj-code no-lock.
     1927     find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
     1928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1929     (input  bf_goods.gds-code
     1930     ,input  bf_gds-prt.node-code
     1931     ,output varb-code
     1932     ) no-error .
     1933     create bf_tt-gds-dtl.
     1934     assign
     1935       bf_tt-gds-dtl.DocCode            = bf_gds-dtl.doc-code
     1936       bf_tt-gds-dtl.ExtDocType         = bf_trn-doc.ext-doc-type
     1937       bf_tt-gds-dtl.Artic              = bf_gds-dtl.artic
     1938       bf_tt-gds-dtl.ProdType           = bf_gds-dtl.prod-type
     1939       bf_tt-gds-dtl.ProdCode           = bf_gds-dtl.prod-code
     1940       bf_tt-gds-dtl.GdsCode            = bf_goods.gds-code
     1941       bf_tt-gds-dtl.ProdName           = bf-prod_clients.obj-name
     1942       bf_tt-gds-dtl.GdsName            = bf_goods.gds-name
     1943       bf_tt-gds-dtl.PrtCode            = bf_gds-dtl.prt-code
     1944       bf_tt-gds-dtl.BarCodeUnitBase    = varb-code
     1945       bf_tt-gds-dtl.FullPrtName        = bf_gds-prt.f-name
     1946       bf_tt-gds-dtl.ObjType            = bf_gds-dtl.obj-type
     1947       bf_tt-gds-dtl.ObjCode            = bf_gds-dtl.obj-code
     1948       bf_tt-gds-dtl.ObjName            = bf-obj_clients.obj-name
     1949       bf_tt-gds-dtl.FactQnty           = bf_gds-dtl.fact-qnty
     1950       bf_tt-gds-dtl.DocQnty            = bf_gds-dtl.doc-qnty
     1951       bf_tt-gds-dtl.PriceRublDoc       = bf_gds-dtl.price-rubl
     1952       bf_tt-gds-dtl.PriceBaseDoc       = bf_gds-dtl.price-base
     1953       bf_tt-gds-dtl.DiscntRublDoc      = bf_gds-dtl.discnt-rubl
     1954       bf_tt-gds-dtl.DiscntBaseDoc      = bf_gds-dtl.discnt-base
     1955       bf_tt-gds-dtl.DiscntType         = bf_gds-dtl.discnt-type
     1956       bf_tt-gds-dtl.DiscntPc           = bf_gds-dtl.discnt-pc
     1957       bf_tt-gds-dtl.PriceBaseSale      = bf_gds-dtl.cur-base
     1958       bf_tt-gds-dtl.Ov                 = bf_gds-dtl.ov                .
     1959     if bf_trn-doc.ext-doc-type = 'vt':U or
     1960        bf_trn-doc.ext-doc-type = 'vp':U         or
     1961        bf_trn-doc.ext-doc-type = 'ap':U   or
     1962        bf_trn-doc.ext-doc-type = 'mp':U or
     1963        bf_trn-doc.ext-doc-type = 'pc':U   then do:
     1964       assign
     1965         bf_tt-gds-dtl.AfterQnty = bf_gds-dtl.fact-qnty.
     1966     end.
     1967   end.
     1968   end.
     1969   end procedure.
     1970   procedure xml-doc_create-parts :
     1971   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1972   define buffer bf_tt-parts      for tt-parts.
     1973   define buffer bf_parts         for ub.parts.
     1974   define buffer bf_trn-doc       for ub.trn-doc.
     1975   define buffer bf-obj_clients   for ub.clients.
     1976   define buffer bf-prod_clients  for ub.clients.
     1977   define buffer bf-suppl_clients for ub.clients.
     1978   define buffer bf_goods         for ub.goods.
     1979   define buffer bf_country       for ub.country.
     1980   define buffer bf_currency      for ub.currency.
     1981   define buffer bf-contract       for ub.contract.
     1982       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1983       define buffer   in-vatp-parts    for ub.parts   .
     1984       define buffer   in-vatp-doc      for ub.trn-doc .
     1985       define buffer   in-vatp-goods    for ub.goods   .
     1986       define buffer   in-vatp-sysconf  for ub.sysconf .
     1987       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1988       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1989       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1990       define variable varinvprb                  as   character              no-undo.
     1991       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1992       define variable cli-base-rate              as   decimal                no-undo.
     1993       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1994       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1995       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1996       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1997       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1998       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1999       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2000       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2001       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2002       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2003       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2004       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2005       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2006       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2007       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2008       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2009       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2010       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2011       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2012       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2013       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2014       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2015       define variable varinvatp-envd             as   character              no-undo.
     2016       define variable varinvatp-type             as   character              no-undo.
     2017   do on error undo, return error return-value :
     2018     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     2019     if error-status:error then do:
     2020       return error substitute ("Не найден документ с номером &1.", pardoc-code).
     2021     end.
     2022     find first bf-obj_clients where bf-obj_clients.obj-type = bf_trn-doc.obj-type and
     2023                                     bf-obj_clients.obj-code = bf_trn-doc.obj-code no-lock.
     2024     for each bf_parts where bf_parts.out-code = pardoc-code no-lock on error undo, return error return-value :
     2025       find first bf_goods where bf_goods.artic     = bf_parts.artic     and
     2026                                 bf_goods.prod-type = bf_parts.prod-type and
     2027                                 bf_goods.prod-code = bf_parts.prod-code no-lock no-error.
     2028       if not available bf_goods then do:
     2029         return error substitute ("Не найден товар &1 &2 &3.", bf_parts.artic, bf_parts.prod-type, bf_parts.prod-code).
     2030       end.
     2031       find first bf_country where bf_country.alpha1 = bf_goods.alpha1 no-lock no-error.
     2032       find first bf-suppl_clients where bf-suppl_clients.obj-type = bf_parts.supp-type and
     2033                                         bf-suppl_clients.obj-code = bf_parts.supp-code no-lock.
     2034       find first bf-prod_clients where bf-prod_clients.obj-type = bf_parts.prod-type and
     2035                                        bf-prod_clients.obj-code = bf_parts.prod-code no-lock.
     2036       find first bf-contract no-lock where bf-contract.contract-code = bf_parts.contract-code and
     2037                                            bf-contract.host-code     = bf_parts.host-code no-error .
     2038       create bf_tt-parts.
     2039       assign
     2040         bf_tt-parts.ObjType            = bf_parts.obj-type
     2041         bf_tt-parts.ObjCode            = bf_parts.obj-code
     2042         bf_tt-parts.ObjName            = bf-obj_clients.obj-name
     2043         bf_tt-parts.Artic              = bf_parts.artic
     2044         bf_tt-parts.ProdType           = bf_parts.prod-type
     2045         bf_tt-parts.ProdCode           = bf_parts.prod-code
     2046         bf_tt-parts.GdsCode            = bf_goods.gds-code
     2047         bf_tt-parts.ProdName           = bf-prod_clients.obj-name
     2048         bf_tt-parts.GdsName            = bf_goods.gds-name
     2049         bf_tt-parts.InCode             = bf_parts.in-code
     2050         bf_tt-parts.OutCode            = bf_parts.out-code
     2051         bf_tt-parts.ExtDocType         = bf_trn-doc.ext-doc-type
     2052         bf_tt-parts.CountryAlphaOne    = (if available bf_country then bf_country.alpha1     else "":U)
     2053         bf_tt-parts.CountryAlphaTwo    = (if available bf_country then bf_country.alpha2     else "":U)
     2054         bf_tt-parts.CountryNumCode     = (if available bf_country then bf_country.num-code   else ?)
     2055         bf_tt-parts.CountryLongName    = (if available bf_country then bf_country.long-name  else "XX неизвестна")
     2056         bf_tt-parts.CountryShortName   = (if available bf_country then bf_country.short-name else "XX неизвестна")
     2057         bf_tt-parts.PartCode           = bf_parts.part-code
     2058         bf_tt-parts.Sign               = (if bf_parts.doc-type = 'при':U or bf_parts.doc-type = 'возврат':U or bf_parts.doc-type = 'инв':U then 1 else -1)
     2059         bf_tt-parts.DocQnty            = bf_parts.qnty
     2060         bf_tt-parts.PriceBaseAcc       = bf_parts.price-base
     2061         bf_tt-parts.PriceRublAcc       = bf_parts.price-rubl
     2062         bf_tt-parts.FactDate           = bf_parts.fact-date
     2063         bf_tt-parts.FactNum            = bf_parts.fact-num
     2064         bf_tt-parts.Sts                = bf_parts.status_
     2065         bf_tt-parts.VatPcAcc           = bf_parts.VAT-pc
     2066         bf_tt-parts.Ps                 = bf_parts.PS
     2067         bf_tt-parts.PayCode            = bf_parts.pay-code
     2068         bf_tt-parts.FactQnty           = bf_parts.fact-qnty
     2069         bf_tt-parts.SupplType          = bf_parts.supp-type
     2070         bf_tt-parts.SupplCode          = bf_parts.supp-code
     2071         bf_tt-parts.SupplName          = bf-suppl_clients.obj-name
     2072         bf_tt-parts.RsrvFree           = bf_parts.rsrv-free
     2073         bf_tt-parts.DocType            = bf_parts.doc-type
     2074         bf_tt-parts.PlCode             = bf_parts.pl-code
     2075         bf_tt-parts.VatType            = bf_parts.VAT-type
     2076         bf_tt-parts.SupplCrcCode       = bf_parts.exch-code
     2077         bf_tt-parts.PriceSuppl         = bf_parts.price-cli
     2078         bf_tt-parts.SupplRate          = bf_parts.cli-base-rate
     2079         bf_tt-parts.SltPcAcc           = bf_parts.SLT-pc
     2080         bf_tt-parts.HostCode           = bf_parts.host-code
     2081         bf_tt-parts.IsSupp             = bf_parts.is-supp
     2082         bf_tt-parts.RealQnty           = bf_parts.real-qnty
     2083         bf_tt-parts.SltType            = bf_parts.SLT-type
     2084         bf_tt-parts.CstCode            = bf_parts.cst-code
     2085         bf_tt-parts.LastDate           = bf_parts.last-date
     2086         bf_tt-parts.TaxThreeBaseAcc        = bf_parts.road-tax-base
     2087         bf_tt-parts.TaxThreeRublAcc        = bf_parts.road-tax-rubl
     2088         bf_tt-parts.TransportBaseAcc   = bf_parts.transport-base
     2089         bf_tt-parts.TransportRublAcc   = bf_parts.transport-rubl
     2090         bf_tt-parts.OtherBaseAcc       = bf_parts.other-base
     2091         bf_tt-parts.OtherRublAcc       = bf_parts.other-rubl
     2092         bf_tt-parts.ContractId         = bf_parts.contract-code
     2093       .
     2094   if available bf-contract then do:
     2095      assign
     2096        bf_tt-parts.ContractNum            = bf-contract.contract-prn-code
     2097        bf_tt-parts.ContractDate           = bf-contract.contract-date
     2098      .
     2099   end.
     2100   else do:
     2101      assign
     2102        bf_tt-parts.ContractNum            = ""
     2103        bf_tt-parts.ContractDate           = ?
     2104      .
     2105   end.
     2106   assign
     2107     price-rubl-with-tax-loc = bf_parts.price-rubl
     2108     price-base-with-tax-loc = bf_parts.price-base
     2109   .
     2110   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2111   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2112     (output varinvprb
     2113     )  .
     2114     if bf_parts.out-code = 'free-zone':U     or
     2115        bf_parts.out-code = 'out-zone':U   or
     2116        bf_parts.doc-type = 'акт':U then do:
     2117       assign
     2118         in-vatp-have-vat-slt = yes.
     2119     end.
     2120     else do:
     2121       find first in-vatp_doc-attr no-lock
     2122         where in-vatp_doc-attr.doc-code  = bf_parts.out-code
     2123           and in-vatp_doc-attr.attr-code = 'envd':U
     2124         no-error .
     2125       if not available in-vatp_doc-attr then do:
     2126         assign
     2127           in-vatp-have-vat-slt = yes.
     2128       end.
     2129       else do:
     2130            in-vatp-have-vat-slt = no.
     2131       end.
     2132     end.
     2133     assign
     2134      price-cli-with-tax-loc = bf_parts.price-cli
     2135      cli-base-rate          = bf_parts.cli-base-rate.
     2136     ASSIGN   road-tax-base-loc  = (if bf_parts.road-tax-base  = ? then 0 else bf_parts.road-tax-base)
     2137              road-tax-rubl-loc  = (if bf_parts.road-tax-rubl  = ? then 0 else bf_parts.road-tax-rubl).
     2138     ASSIGN  transport-base-loc = (if bf_parts.transport-base = ? then 0 else bf_parts.transport-base)
     2139             transport-rubl-loc = (if bf_parts.transport-rubl = ? then 0 else bf_parts.transport-rubl)
     2140             other-base-loc     = (if bf_parts.other-base     = ? then 0 else bf_parts.other-base)
     2141             other-rubl-loc     = (if bf_parts.other-rubl     = ? then 0 else bf_parts.other-rubl)
     2142             vat-pc-loc         = (if bf_parts.vat-pc         = ? then 0 else bf_parts.vat-pc)
     2143             slt-pc-loc         = (if bf_parts.slt-pc         = ? then 0 else bf_parts.slt-pc).
     2144             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2145       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2146     assign
     2147       exch-rate-cli-loc = (bf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if bf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if bf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / bf_parts.price-cli .
     2148     assign
     2149       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2150       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2151       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2152       transport-cli-loc  = 0
     2153       other-cli-loc      = 0
     2154     .
     2155   ASSIGN
     2156             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2157       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2158   .
     2159       assign
     2160         bf_tt-parts.VatBaseAcc = vat-base-loc
     2161         bf_tt-parts.VatRublAcc = vat-rubl-loc
     2162         bf_tt-parts.SltBaseAcc = slt-base-loc
     2163         bf_tt-parts.SltRublAcc = slt-rubl-loc .
     2164       if bf_trn-doc.ext-doc-type = 'ie':U then do:
     2165         find first bf_currency where bf_currency.curr-code = bf_parts.exch-code no-lock.
     2166         assign
     2167           bf_tt-parts.SupplQnty    = bf_parts.cli-qnty
     2168           bf_tt-parts.SupplCrcAbbr = bf_currency.curr-abbr
     2169           bf_tt-parts.SupplCrcName = bf_currency.curr-name .
     2170       end.
     2171     end.
     2172   end.
     2173   end procedure.
     2174   procedure xml-doc_create-attr :
     2175   define input parameter pardoc-code like ub.doc-attr.doc-code no-undo.
     2176   define buffer bf_tt-attr       for tt-attr.
     2177   define buffer bf_attr          for ub.doc-attr.
     2178   define buffer bf_trn-doc       for ub.trn-doc.
     2179   define variable v-type           as character no-undo .
     2180   define variable v-format         as character no-undo .
     2181   define variable v-fillin_width   as integer   no-undo .
     2182   define variable v-fillin_height  as integer   no-undo .
     2183   define variable v-label          as character no-undo .
     2184   define variable v-user-can-edit  as logical   no-undo .
     2185   define variable v-output-display as logical   no-undo .
     2186   define variable v-other          as character no-undo .
     2187   define variable v-proc-attr       as character no-undo .
     2188   define variable v-full-screen-val as character no-undo .
     2189   do on error undo, return error return-value :
     2190     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     2191     if error-status:error then do:
     2192       return error substitute ("Не найден документ с номером &1.", pardoc-code).
     2193     end.
     2194     for each bf_attr where bf_attr.doc-code = pardoc-code no-lock on error undo, return error return-value :
     2195   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-cod in g#trdcalib (  input bf_attr.attr-code ,
     2196                          output v-type ,
     2197                          output v-format ,
     2198                          output v-fillin_width ,
     2199                          output v-fillin_height ,
     2200                          output v-label ,
     2201                          output v-user-can-edit ,
     2202                          output v-output-display ,
     2203                          output v-other  ,
     2204                          output v-proc-attr ,
     2205                          output v-full-screen-val ,
     2206                          output v-sort
     2207                          )  .
     2208       if v-output-display = false then next .
     2209       create bf_tt-attr.
     2210       assign
     2211         bf_tt-attr.DocCode             = bf_attr.doc-code
     2212         bf_tt-attr.attr-code           = bf_attr.attr-code
     2213         bf_tt-attr.attr-value          = bf_attr.attr-value
     2214         bf_tt-attr.attr-type           = v-type
     2215        .
     2216     end.
     2217   end.
     2218   end procedure.
     2219   procedure xml-doc_export-doc :
     2220     define input  parameter p-handle-callback as handle    no-undo .
     2221     define input  parameter p-proc-name       as character no-undo .
     2222     define buffer bf_tt-trn-doc     for tt-trn-doc .
     2223     define buffer bf_tt-trn-doc-add for tt-trn-doc-add.
     2224     define variable par-type as character no-undo.
     2225     define variable v-prefix as character no-undo .
     2226     define variable v-suffix as character no-undo .
     2227     do
     2228     on error undo, return error return-value
     2229     :
     2230       assign
     2231         v-prefix = "    "
     2232         v-suffix = chr(10)
     2233       .
     2234       for each bf_tt-trn-doc
     2235       on error undo, return error return-value
     2236       :
     2237         find first bf_tt-trn-doc-add where bf_tt-trn-doc-add.DocCode = bf_tt-trn-doc.DocCode.
     2238         run value(p-proc-name) in p-handle-callback
     2239           (input '  <trn-doc>' + chr(10)
     2240           ) .
     2241                     run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'DocCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.DocCode))) + v-suffix ) .
     2242               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ExtDocType', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ExtDocType))) + v-suffix ) .
     2243               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ExtDocTypeName', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ExtDocTypeName))) + v-suffix ) .
     2244               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'DocType', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.DocType))) + v-suffix ) .
     2245               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Internal', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Internal))) + v-suffix ) .
     2246               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Sts', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Sts))) + v-suffix ) .
     2247               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Flag', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Flag))) + v-suffix ) .
     2248               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'DocDate', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.DocDate, '99.99.9999':U))) + v-suffix ) .
     2249               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ContractId', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ContractId))) + v-suffix ) .
     2250               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ContractNum', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ContractNum))) + v-suffix ) .
     2251               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ContractDate', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ContractDate, '99.99.9999':U))) + v-suffix ) .
     2252               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BaseCrcRate', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BaseCrcRate))) + v-suffix ) .
     2253               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BaseCrcScale', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BaseCrcScale))) + v-suffix ) .
     2254               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'CliType', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.CliType))) + v-suffix ) .
     2255               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'CliCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.CliCode))) + v-suffix ) .
     2256               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'CliName', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.CliName))) + v-suffix ) .
     2257               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PostIndex', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PostIndex))) + v-suffix ) .
     2258               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'City', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.City))) + v-suffix ) .
     2259               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Address', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Address))) + v-suffix ) .
     2260         if bf_tt-trn-doc.CliType = 'орг':U then do:
     2261                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'AddressAdd', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.AddressAdd))) + v-suffix ) .
     2262                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PostAddress', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PostAddress))) + v-suffix ) .
     2263                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PostAddressAdd', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PostAddressAdd))) + v-suffix ) .
     2264         end.
     2265               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'EMail', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.EMail))) + v-suffix ) .
     2266               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Fax', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Fax))) + v-suffix ) .
     2267               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Phone', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Phone))) + v-suffix ) .
     2268               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PhoneNote', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PhoneNote))) + v-suffix ) .
     2269               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Inn', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Inn))) + v-suffix ) .
     2270               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'KPP', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.KPP))) + v-suffix ) .
     2271               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'OKPO', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.OKPO))) + v-suffix ) .
     2272               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'OKONH', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.OKONH))) + v-suffix ) .
     2273         if bf_tt-trn-doc.CliType = 'орг':U then do:
     2274                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ContactPerson', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ContactPerson))) + v-suffix ) .
     2275                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Director', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Director))) + v-suffix ) .
     2276                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'EnglName', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.EnglName))) + v-suffix ) .
     2277                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'GenAccnt', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.GenAccnt))) + v-suffix ) .
     2278                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Telex', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Telex))) + v-suffix ) .
     2279         end.
     2280         else do:
     2281                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Name', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Name))) + v-suffix ) .
     2282                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Patronymic', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Patronymic))) + v-suffix ) .
     2283                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PassNum', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PassNum))) + v-suffix ) .
     2284                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PassSer', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PassSer))) + v-suffix ) .
     2285                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'GivenBy', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.GivenBy))) + v-suffix ) .
     2286                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'Position', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.Position))) + v-suffix ) .
     2287                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PostBox', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PostBox))) + v-suffix ) .
     2288         end.
     2289         if bf_tt-trn-doc.BankRublIsHave = yes then do:
     2290                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BankNameRubl', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BankNameRubl))) + v-suffix ) .
     2291                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BankCodeRubl', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BankCodeRubl))) + v-suffix ) .
     2292                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BankAccRubl', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BankAccRubl))) + v-suffix ) .
     2293                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'AddressBankRubl', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.AddressBankRubl))) + v-suffix ) .
     2294                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'AddressAddBankRubl', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.AddressAddBankRubl))) + v-suffix ) .
     2295                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PBankAccRubl', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PBankAccRubl))) + v-suffix ) .
     2296         end.
     2297         if bf_tt-trn-doc.BankBaseIsHave = yes then do:
     2298                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BankNameBase', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BankNameBase))) + v-suffix ) .
     2299                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BankCodeBase', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BankCodeBase))) + v-suffix ) .
     2300                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'BankAccBase', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.BankAccBase))) + v-suffix ) .
     2301                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'AddressBankBase', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.AddressBankBase))) + v-suffix ) .
     2302                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'AddressAddBankBase', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.AddressAddBankBase))) + v-suffix ) .
     2303                   run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'PBankAccBase', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.PBankAccBase))) + v-suffix ) .
     2304         end.
     2305               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ObjType', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ObjType))) + v-suffix ) .
     2306               run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ObjCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ObjCode))) + v-suffix ) .
