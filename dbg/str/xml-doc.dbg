     4738   if error-status :error then do:
     4739     return error substitute( "Ошибка при очистке временной таблицы заголовка документа &1 &2.", error-status :get-message( 1 ), return-value ).
     4740   end.
     4741   run xml-doc_clear-line in this-procedure no-error.
     4742   if error-status :error then do:
     4743     return error substitute( "Ошибка при очистке временной таблицы линий документа &1 &2.", error-status :get-message( 1 ), return-value ).
     4744   end.
     4745   run xml-doc_clear-dtl in this-procedure no-error.
     4746   if error-status :error then do:
     4747     return error substitute( "Ошибка при очистке временной таблицы признаков документа &1 &2.", error-status :get-message( 1 ), return-value ).
     4748   end.
