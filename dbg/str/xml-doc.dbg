     2467                     run value(p-proc-name) in p-handle-callback (input v-prefix + substitute('<&1>&2</&1>', 'ReasonCode', xml-doc_ReplaceSpecSymbols(string(bf_tt-trn-doc.ReasonCode))) + v-suffix ) .
