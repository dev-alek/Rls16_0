     1018   define buffer bf-mis_trn-doc-sum     for ub.trn-doc-sum.
     1019   define buffer bf-mis-cli_trn-doc-sum for ub.trn-doc-sum.
     1020   define buffer bf-wst_trn-doc-sum     for ub.trn-doc-sum.
     1021   define buffer bf-bef-cli_trn-doc-sum for ub.trn-doc-sum.
     1022   define buffer bf-aft-cli_trn-doc-sum for ub.trn-doc-sum.
     1023   define buffer bf-host_clients        for ub.clients.
     1024   define buffer bf-obj_clients         for ub.clients.
     1025   define buffer bf_currency            for ub.currency.
     1026   define buffer bf_firm                for ub.firm.
     1027   define buffer bf_person              for ub.person.
     1028   define buffer bf_shop                for ub.shop.
     1029   define buffer bf_store               for ub.store.
     1030   define buffer bf-own_firm            for ub.firm.
     1031   define buffer bf_sysconf             for ub.sysconf.
