     1034   define buffer bf-agnt_clients        for ub.clients.
     1035   define buffer bf-boss_clients        for ub.clients.
     1036   define variable par-type as character no-undo.
     1037   define variable varvalue as character no-undo.
     1038   define variable vartype  as character no-undo.
     1039   do on error undo, return error return-value :
     1040   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     1041   if error-status:error then do:
     1042     return error substitute ("Не найден документ с номером &1.", pardoc-code).
     1043   end.
     1044   find first bf-obj_clients where bf-obj_clients.obj-type = bf_trn-doc.obj-type and
     1045                                   bf-obj_clients.obj-code = bf_trn-doc.obj-code no-lock.
     1046   find first bf-host_clients where bf-host_clients.obj-type = 'орг':U               and
     1047                                    bf-host_clients.obj-code = bf_trn-doc.host-code no-lock.
     1048   find first bf-wrkr_clients where bf-wrkr_clients.obj-type = 'чел':U and
     1049                                    bf-wrkr_clients.obj-code = bf_trn-doc.wrkr no-lock no-error.
     1050   find first bf-agnt_clients where bf-agnt_clients.obj-type = 'чел':U and
     1051                                    bf-agnt_clients.obj-code = bf_trn-doc.agnt no-lock no-error.
     1052   find first bf-boss_clients where bf-boss_clients.obj-type = 'чел':U and
     1053                                    bf-boss_clients.obj-code = bf_trn-doc.boss no-lock no-error.
     1054   if bf_trn-doc.ext-doc-type = 'ie':U then do:
     1055     find first bf_currency where bf_currency.curr-code = bf_trn-doc.exch-code no-lock.
     1056   end.
     1057   if bf_trn-doc.obj-type = 'маг':U then do:
     1058     find first bf_shop where bf_shop.obj-code = bf_trn-doc.obj-code no-lock.
     1059   end.
     1060   else do:
     1061     find first bf_store where bf_store.obj-code = bf_trn-doc.obj-code no-lock.
     1062   end.
     1063   find first bf-own_firm where bf-own_firm.firm-code = bf_trn-doc.host-code no-lock.
     1064   find first bf_sysconf  where bf_sysconf.host-code  = bf_trn-doc.host-code no-lock.
     1065   run fmtcli-get-bank in this-procedure
     1066    (input bf_sysconf.host-code,
     1067     input 'орг':U,
     1068     input bf_sysconf.host-code,
     1069     input 0).
     1070   if v-fmtcli-schet-exists then do:
     1071     assign
     1072       v-own-rubl-fmtcli-schet-exists  = yes
     1073       v-own-rubl-fmtcli-bank-r-schet  = v-fmtcli-bank-r-schet
     1074       v-own-rubl-fmtcli-bank-c-schet  = v-fmtcli-bank-c-schet
     1075       v-own-rubl-fmtcli-bank-bik      = v-fmtcli-bank-bik
