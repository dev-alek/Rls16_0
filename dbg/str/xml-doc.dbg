     4802                                              input "write-string") no-error.
     4803   if error-status:error then do:
     4804     return error "Ошибка при экспорте линии доп.бк.".
     4805   end.
     4806   run xml-doc_export-dtl in this-procedure (input this-procedure,
     4807                                             input "write-string") no-error.
     4808   if error-status :error then do:
     4809     return error "Ошибка при экспорте признаков документа".
     4810   end.
     4811   run xml-doc_export-parts in this-procedure (input this-procedure,
     4812                                               input "write-string") no-error.
     4813   if error-status :error then do:
     4814     return error "Ошибка при экспорте партий документа".
     4815   end.
     4816   run xml-doc_export-attr in this-procedure (input this-procedure,
     4817                                               input "write-string") no-error.
     4818   if error-status :error then do:
     4819     return error "Ошибка при экспорте атрибутов документа".
     4820   end.
     4821   if paroutput-file = ?  or
     4822      paroutput-file = "" then do:
     4823      run write-string in this-procedure
     4824        (input '</root>':u + chr(10)).
     4825   end.
     4826   output stream trn-out close.
     4827   if paroutput-file = ?  or
     4828      paroutput-file = "" then do:
     4829      if search ("./" + varfile-name + ".xml") <> ? then do:
     4830        os-delete value ("./" + varfile-name + ".xml").
     4831      end.
     4832      os-copy value ("./" + varfile-name + ".tmp") value ("./" + varfile-name + ".xml").
     4833      os-delete value ("./" + varfile-name + ".tmp").
     4834   end.
     4835   procedure write-string :
     4836    define input parameter parstring as character no-undo.
     4837    put stream trn-out unformatted parstring.
     4838   end.
