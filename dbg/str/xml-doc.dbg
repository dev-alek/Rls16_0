     1312     bf_tt-trn-doc.Inn       = (if bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'маг':U or bf_trn-doc.cli-type = 'скл':U then bf_firm.inn         else bf_person.inn)
     1313     bf_tt-trn-doc.KPP       = (if bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'маг':U or bf_trn-doc.cli-type = 'скл':U then bf_firm.kpp         else bf_person.kpp)
     1314     bf_tt-trn-doc.OKPO      = (if bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'маг':U or bf_trn-doc.cli-type = 'скл':U then bf_firm.okpo        else bf_person.okpo)
     1315     bf_tt-trn-doc.OKONH     = (if bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'маг':U or bf_trn-doc.cli-type = 'скл':U then bf_firm.okonh       else bf_person.okonh)
     1316   .
     1317   if bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'маг':U or bf_trn-doc.cli-type = 'скл':U then do:
