     1323       bf_tt-trn-doc.Telex         = bf_firm.telex
     1324       .
     1325   end.
     1326   else do:
     1327     assign
     1328       bf_tt-trn-doc.Name       = bf_person.name1
     1329       bf_tt-trn-doc.Patronymic = bf_person.name2
     1330       bf_tt-trn-doc.PassNum    = bf_person.passp-num
     1331       bf_tt-trn-doc.PassSer    = bf_person.passp-ser
     1332       bf_tt-trn-doc.GivenBy    = bf_person.given-by
     1333       bf_tt-trn-doc.Position   = bf_person.position
     1334       bf_tt-trn-doc.PostBox    = bf_person.post-box
     1335     .
     1336   end.
     1337   if v-cli-rubl-fmtcli-schet-exists then do:
     1338     assign
     1339       bf_tt-trn-doc.BankRublIsHave      = yes
     1340       bf_tt-trn-doc.BankNameRubl        = v-cli-rubl-fmtcli-bank-name
     1341       bf_tt-trn-doc.BankCodeRubl        = v-cli-rubl-fmtcli-bank-bik
     1342       bf_tt-trn-doc.BankAccRubl         = v-cli-rubl-fmtcli-bank-r-schet
     1343       bf_tt-trn-doc.AddressBankRubl     = v-cli-rubl-fmtcli-bank-addres
     1344       bf_tt-trn-doc.AddressAddBankRubl  = "":u
     1345       bf_tt-trn-doc.PBankAccRubl        = v-cli-rubl-fmtcli-bank-c-schet
     1346      .
     1347   end.
     1348   else do:
     1349     assign
     1350       bf_tt-trn-doc.BankRublIsHave      = no.
     1351   end.
     1352   if v-cli-base-fmtcli-schet-exists then do:
     1353     assign
     1354       bf_tt-trn-doc.BankBaseIsHave       = yes
     1355       bf_tt-trn-doc.BankNameBase         = v-cli-base-fmtcli-bank-name
     1356       bf_tt-trn-doc.BankCodeBase         = v-cli-base-fmtcli-bank-bik
     1357       bf_tt-trn-doc.BankAccBase          = v-cli-base-fmtcli-bank-r-schet
     1358       bf_tt-trn-doc.AddressBankBase      = v-cli-base-fmtcli-bank-addres
     1359       bf_tt-trn-doc.AddressAddBankBase   = "":u
     1360       bf_tt-trn-doc.PBankAccBase         = v-cli-base-fmtcli-bank-c-schet
     1361     .
     1362   end.
     1363   else do:
     1364     assign
     1365       bf_tt-trn-doc.BankBaseIsHave      = no.
     1366   end.
     1367     assign
     1368       bf_tt-trn-doc.BgeDate = bf_trn-doc.bge-date
     1369       bf_tt-trn-doc.SctDate = bf_trn-doc.scf-date
     1370       bf_tt-trn-doc.AccDate = bf_trn-doc.acc-date
     1371       bf_tt-trn-doc.InvNum  = bf_trn-doc.inv-num    .
     1372   if varshift = "yes" then do:
     1373     assign
     1374       bf_tt-trn-doc.ShiftNum  = bf_trn-doc.shift-num
     1375       bf_tt-trn-doc.ShiftName = bf_trn-doc.shift-name
     1376       bf_tt-trn-doc.ShiftDate = bf_trn-doc.shift-date .
     1377   end.
     1378   if bf_trn-doc.ext-doc-type = 'ie':U then do:
     1379     assign
     1380       bf_tt-trn-doc.SupplCrcCode         = bf_trn-doc.exch-code
     1381       bf_tt-trn-doc.SupplCrcAbbr         = bf_currency.curr-abbr
     1382       bf_tt-trn-doc.SupplCrcName         = bf_currency.curr-name
     1383       bf_tt-trn-doc.SupplCrcDate         = bf_trn-doc.exch-date
     1384       bf_tt-trn-doc.SupplCrcRate         = bf_trn-doc.exch-rate
     1385       bf_tt-trn-doc.SupplCrcScale        = bf_trn-doc.exch-scale
     1386       bf_tt-trn-doc.SumCheckFactSuppl    = bf_trn-doc.tot-cli
     1387       bf_tt-trn-doc.SumFactSuppl         = bf_trn-doc.tot-calc
     1388       bf_tt-trn-doc.VatFactBaseAcc       = bf_trn-doc.vat-base
     1389       bf_tt-trn-doc.VatFactRublAcc       = bf_trn-doc.vat-rubl
     1390       bf_tt-trn-doc.SltFactBaseAcc       = bf_trn-doc.slt-base
     1391       bf_tt-trn-doc.SltFactRublAcc       = bf_trn-doc.slt-rubl
     1392       bf_tt-trn-doc.SumDocBaseAcc        = bf_trn-doc.fact-base
     1393       bf_tt-trn-doc.SumDocRublAcc        = bf_trn-doc.fact-base
     1394       bf_tt-trn-doc.OvervalueFactSaleacc = bf_trn-doc.tot-ov
     1395       bf_tt-trn-doc.TaxThreeFactSaleAcc      = bf_trn-doc.road-tax
     1396       bf_tt-trn-doc.ExciseFactSaleAcc    = bf_trn-doc.excise
     1397       bf_tt-trn-doc.TransportExpSuppl    = bf_trn-doc.tot-transp
     1398       bf_tt-trn-doc.OtherExpSuppl        = bf_trn-doc.tot-other
     1399       bf_tt-trn-doc.SupplQnty            = bf_trn-doc.cli-qnty
     1400       bf_tt-trn-doc.CstCode              = bf_trn-doc.cst-code   .
     1401   end.
     1402   else do:
     1403     assign
     1404       bf_tt-trn-doc.VatFactBaseDoc        = bf_trn-doc.vat-base
     1405       bf_tt-trn-doc.VatFactRublDoc        = bf_trn-doc.vat-rubl
     1406       bf_tt-trn-doc.SltFactBaseDoc        = bf_trn-doc.slt-base
     1407       bf_tt-trn-doc.SltFactRublDoc        = bf_trn-doc.slt-rubl
     1408       bf_tt-trn-doc.SumDocBaseDoc         = bf_trn-doc.tot-doc
     1409       bf_tt-trn-doc.SumDocRublDoc         = bf_trn-doc.tot-rubl
     1410       bf_tt-trn-doc.OvervalueFactSaledoc  = bf_trn-doc.tot-ov    .
     1411   end.
     1412   if bf_trn-doc.out-code <> ? and
     1413      bf_trn-doc.out-code <> "" then do:
     1414     assign
     1415        bf_tt-trn-doc.OutCode = bf_trn-doc.out-code.
     1416   end.
     1417   if bf_trn-doc.ext-doc-type = 'vt':U      or
     1418      bf_trn-doc.ext-doc-type = 'vp':U         or
     1419      bf_trn-doc.ext-doc-type = 'ap':U   or
     1420      bf_trn-doc.ext-doc-type = 'mp':U or
     1421      bf_trn-doc.ext-doc-type = 'pc':U   then do:
     1422   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
     1423                           input 'addsum':U ,
     1424                          output varvalue ,
     1425                          output vartype ) no-error .
     1426     if error-status:error then do:
     1427       return error substitute ("Ошибка при вызове процедуры tdat-val &1 &2.", return-value, error-status:get-message(1)).
     1428     end.
     1429     if lookup ('ext':U, varvalue) <> 0 then do:
     1430       find first bf-ext_trn-doc-sum where bf-ext_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     1431                                           bf-ext_trn-doc-sum.sum-type = 'ext':U    no-lock.
     1432       if not available bf-ext_trn-doc-sum then do:
     1433         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'ext':U, bf-ext_trn-doc-sum.doc-code).
     1434       end.
     1435     end.
     1436     if lookup ('extc':U, varvalue) <> 0 then do:
     1437       find first bf-ext-cli_trn-doc-sum where bf-ext-cli_trn-doc-sum.doc-code = bf_trn-doc.doc-code  and
     1438                                               bf-ext-cli_trn-doc-sum.sum-type = 'extc':U no-lock.
     1439       if not available bf-ext-cli_trn-doc-sum then do:
     1440         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'extc':U, bf-ext-cli_trn-doc-sum.doc-code).
     1441       end.
     1442     end.
     1443     if lookup ('mis':U, varvalue) <> 0 then do:
     1444       find first bf-mis_trn-doc-sum where bf-mis_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     1445                                           bf-mis_trn-doc-sum.sum-type = 'mis':U     no-lock.
     1446       if not available bf-mis_trn-doc-sum then do:
     1447         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'mis':U, bf-mis_trn-doc-sum.doc-code).
     1448       end.
     1449     end.
     1450     if lookup ('misc':U, varvalue) <> 0 then do:
     1451       find first bf-mis-cli_trn-doc-sum where bf-mis-cli_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     1452                                               bf-mis-cli_trn-doc-sum.sum-type = 'misc':U no-lock.
     1453       if not available bf-mis-cli_trn-doc-sum then do:
     1454         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'misc':U, bf-mis-cli_trn-doc-sum.doc-code).
     1455       end.
     1456     end.
     1457     if lookup ('wst':U, varvalue) <> 0 then do:
     1458       find first bf-wst_trn-doc-sum where bf-wst_trn-doc-sum.doc-code = bf_trn-doc.doc-code and
     1459                                           bf-wst_trn-doc-sum.sum-type = 'wst':U  no-lock.
     1460       if not available bf-wst_trn-doc-sum then do:
     1461         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'wst':U, bf-wst_trn-doc-sum.doc-code).
     1462       end.
     1463     end.
     1464     if lookup ('bcd':U, varvalue) <> 0 then do:
     1465       find first bf-bef-cli_trn-doc-sum where bf-bef-cli_trn-doc-sum.doc-code = bf_trn-doc.doc-code   and
     1466                                               bf-bef-cli_trn-doc-sum.sum-type = 'bcd':U no-lock.
     1467       if not available bf-bef-cli_trn-doc-sum then do:
     1468         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'bcd':U, bf-bef-cli_trn-doc-sum.doc-code).
     1469       end.
     1470     end.
     1471     if lookup ('acd':U, varvalue) <> 0 then do:
     1472       find first bf-aft-cli_trn-doc-sum where bf-aft-cli_trn-doc-sum.doc-code = bf_trn-doc.doc-code  and
     1473                                               bf-aft-cli_trn-doc-sum.sum-type = 'acd':U no-lock.
     1474       if not available bf-aft-cli_trn-doc-sum then do:
     1475         return error substitute ("Не найдена сумма с типом &1 по документу &2.", 'acd':U, bf-aft-cli_trn-doc-sum.doc-code).
     1476       end.
     1477     end.
     1478     assign
     1479       bf_tt-trn-doc.BefQnty                = bf_trn-doc.doc-qnty
     1480       bf_tt-trn-doc.CalcSum                = varvalue
     1481       bf_tt-trn-doc.SumBefBaseAcc          = bf_trn-doc.tot-calc
     1482       bf_tt-trn-doc.SumBefRublAcc          = bf_trn-doc.discnt-rubl
     1483       bf_tt-trn-doc.ExtraQnty              = (if available bf-ext_trn-doc-sum     then bf-ext_trn-doc-sum.fact-qnty         else ?)
     1484       bf_tt-trn-doc.ExtraSupplQnty         = (if available bf-ext-cli_trn-doc-sum then bf-ext-cli_trn-doc-sum.fact-qnty     else ?)
     1485       bf_tt-trn-doc.ExtraFactBaseAcc       = (if available bf-ext_trn-doc-sum     then bf-ext_trn-doc-sum.cost-sum-base     else ?)
     1486       bf_tt-trn-doc.ExtraFactRublAcc       = (if available bf-ext_trn-doc-sum     then bf-ext_trn-doc-sum.cost-sum-rubl     else ?)
     1487       bf_tt-trn-doc.ExtraFactSale          = (if available bf-ext_trn-doc-sum     then (if varr-b = "base" then bf-ext_trn-doc-sum.sale-sum-base else bf-ext_trn-doc-sum.sale-sum-rubl) else ?)
     1488       bf_tt-trn-doc.MissQnty               = (if available bf-mis_trn-doc-sum     then bf-mis_trn-doc-sum.fact-qnty         else ?)
     1489       bf_tt-trn-doc.MissCliQnty            = (if available bf-mis-cli_trn-doc-sum then bf-mis-cli_trn-doc-sum.fact-qnty     else ?)
     1490       bf_tt-trn-doc.MissFactBaseAcc        = (if available bf-mis_trn-doc-sum     then bf-mis_trn-doc-sum.cost-sum-base     else ?)
     1491       bf_tt-trn-doc.MissFactRublAcc        = (if available bf-mis_trn-doc-sum     then bf-mis_trn-doc-sum.cost-sum-rubl     else ?)
     1492       bf_tt-trn-doc.MissFactSale           = (if available bf-mis_trn-doc-sum     then (if varr-b = "base" then bf-mis_trn-doc-sum.sale-sum-base else bf-mis_trn-doc-sum.sale-sum-rubl) else ?)
     1493       bf_tt-trn-doc.WastageFactSale        = (if available bf-wst_trn-doc-sum     then (if varr-b = "base" then bf-wst_trn-doc-sum.sale-sum-base else bf-wst_trn-doc-sum.sale-sum-rubl) else ?)
     1494       bf_tt-trn-doc.BefSupplQnty           = (if available bf-bef-cli_trn-doc-sum then bf-bef-cli_trn-doc-sum.fact-qnty     else ?)
     1495       bf_tt-trn-doc.AftSupplQnty           = (if available bf-aft-cli_trn-doc-sum then bf-aft-cli_trn-doc-sum.fact-qnty     else ?)
     1496       .
     1497   end.
     1498   else do:
     1499     assign
     1500       bf_tt-trn-doc.DocQnty = bf_trn-doc.doc-qnty.
     1501   end.
     1502   if bf_trn-doc.ext-doc-type <> 'ie':U and
     1503      bf_trn-doc.ext-doc-type <> 'vt':U and
     1504      bf_trn-doc.ext-doc-type <> 'vp':U         and
     1505      bf_trn-doc.ext-doc-type <> 'ap':U   and
     1506      bf_trn-doc.ext-doc-type <> 'mp':U and
     1507      bf_trn-doc.ext-doc-type <> 'pc':U   then do:
     1508      assign
     1509        bf_tt-trn-doc.DscFactBaseDoc = bf_trn-doc.tot-calc
     1510        bf_tt-trn-doc.SumFactBaseDoc = bf_trn-doc.tot-fact
     1511        bf_tt-trn-doc.SumFactRublDoc = bf_trn-doc.tot-sale
     1512        bf_tt-trn-doc.DscFactRublDoc = bf_trn-doc.discnt-rubl
     1513        bf_tt-trn-doc.DiscntType     = bf_trn-doc.discnt-type
     1514        bf_tt-trn-doc.DiscntPc       = bf_trn-doc.discnt-pc   .
     1515   end.
     1516   assign
     1517    bf_tt-trn-doc-add.DocCode       = bf_trn-doc.doc-code
     1518    bf_tt-trn-doc-add.AddressObj    = (if bf_trn-doc.obj-type = 'маг':U then bf_shop.addres1 else bf_store.addres1)
     1519    bf_tt-trn-doc-add.AddressAddObj = (if bf_trn-doc.obj-type = 'маг':U then bf_shop.addres2 else bf_store.addres2)
     1520   .
     1521   if bf_trn-doc.obj-type = 'маг':U then do:
     1522     assign
     1523       bf_tt-trn-doc-add.AcctObj     = entry(1,bf_shop.acct,"|")
     1524       bf_tt-trn-doc-add.DirectorObj = bf_shop.director
     1525       bf_tt-trn-doc-add.GoodsManObj = bf_shop.goods-man
     1526     .
     1527   end.
     1528   assign
     1529     bf_tt-trn-doc-add.PhoneObj     = (if bf_trn-doc.obj-type = 'маг':U then bf_shop.phone      else bf_store.phone)
     1530     bf_tt-trn-doc-add.StoreBossObj = (if bf_trn-doc.obj-type = 'маг':U then bf_shop.store-boss else bf_store.store-boss)
     1531     bf_tt-trn-doc-add.StoreManObj  = (if bf_trn-doc.obj-type = 'маг':U then bf_shop.store-man  else bf_store.store-man)
     1532   .
     1533   end.
     1534   if bf_trn-doc.ext-doc-type = 'ie':U then do:
     1535   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf_trn-doc.doc-code ,
     1536                           input 'expense_own':U ,
     1537                          output varvalue ,
     1538                          output vartype ) no-error .
     1539     if error-status:error then do:
     1540       return error substitute ("Ошибка при вызове процедуры tdat-val &1 &2.", return-value, error-status:get-message(1)).
     1541     end.
     1542     assign
     1543       bf_tt-trn-doc.ExpenseOwn = decimal(varvalue).
     1544   end.
     1545   end procedure.
     1546   procedure xml-doc_create-line :
     1547   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1548   define buffer bf_tt-doc-line          for tt-doc-line.
     1549   define buffer bf_doc-line             for ub.doc-line.
     1550   define buffer bf-ext_doc-line-sum     for ub.doc-line-sum.
     1551   define buffer bf-ext-cli_doc-line-sum for ub.doc-line-sum.
     1552   define buffer bf-mis_doc-line-sum     for ub.doc-line-sum.
     1553   define buffer bf-mis-cli_doc-line-sum for ub.doc-line-sum.
     1554   define buffer bf-wst_doc-line-sum     for ub.doc-line-sum.
     1555   define buffer bf-bef-cli_doc-line-sum for ub.doc-line-sum.
     1556   define buffer bf-aft-cli_doc-line-sum for ub.doc-line-sum.
     1557   define buffer bf-bef_doc-line-sum     for ub.doc-line-sum.
     1558   define buffer bf-aft_doc-line-sum     for ub.doc-line-sum.
     1559   define buffer bf_doc-line-attr        for ub.doc-line-attr.
     1560   define buffer bf_goods                for ub.goods.
     1561   define buffer bf-obj_clients          for ub.clients.
     1562   define buffer bf-prod_clients         for ub.clients.
     1563   define buffer bf_trn-doc              for ub.trn-doc.
     1564   define buffer bf_gds-grp              for ub.gds-grp.
     1565   define variable varis-petrol     as   logical               no-undo.
     1566   define variable varis-pieces     as   logical               no-undo.
     1567   define variable custvalue        as   character             no-undo.
     1568   define variable custtype         as   character             no-undo.
     1569   define variable varfact-qnty     like ub.doc-line.fact-qnty no-undo.
     1570   define variable varvat-pc        like ub.doc-line.vat-pc    no-undo.
     1571   define variable varslt-pc        like ub.doc-line.slt-pc    no-undo.
     1572   define variable varvalue         as   character             no-undo.
     1573   define variable vartype          as   character             no-undo.
     1574   define variable varfull-grp-name as   character             no-undo.
