     1307   assign
     1308     bf_tt-trn-doc.EMail     = (if bf_trn-doc.cli-type = 'орг':U or bf_trn-doc.cli-type = 'маг':U or bf_trn-doc.cli-type = 'скл':U then bf_firm.e-mail      else bf_person.e-mail)
