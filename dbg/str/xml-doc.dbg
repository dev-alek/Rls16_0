     1011   procedure xml-doc_create-doc :
     1012   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1013   define buffer bf_tt-trn-doc          for tt-trn-doc.
     1014   define buffer bf_tt-trn-doc-add      for tt-trn-doc-add.
     1015   define buffer bf_trn-doc             for ub.trn-doc.
