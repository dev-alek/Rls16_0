     3442       define buffer buf_trn-doc  for ub.trn-doc .
     3443       define buffer buf_doc-line for ub.doc-line .
     3444       find first buf_doc-line no-lock
     3445         where buf_doc-line.doc-code  = p-doc-code
     3446           and buf_doc-line.artic     = p-artic
     3447           and buf_doc-line.prod-type = p-prod-type
     3448           and buf_doc-line.prod-code = p-prod-code
     3449         no-error .
     3450       if not available buf_doc-line then do:
     3451         message
     3452           vss-workfile vss-revision vss-description skip
     3453           vss-include-info11 skip
     3454           "Ошибка задания входных параметров" skip
     3455           "Не найдена строка документа" skip
     3456           "Документ" p-doc-code skip
     3457           "Артикул" p-artic p-prod-type p-prod-code skip
     3458           view-as alert-box error .
     3459         undo, return error .
     3460       end.
     3461       find first buf_trn-doc no-lock
     3462         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     3463         no-error .
     3464       if not available buf_trn-doc then do:
     3465         message
     3466           vss-workfile vss-revision vss-description skip
     3467           vss-include-info11 skip
     3468           "Не найден документ" skip
     3469           "Документ" p-doc-code skip
     3470           "Артикул" p-artic p-prod-type p-prod-code skip
     3471           view-as alert-box error .
     3472         undo, return error .
     3473       end.
     3474       for each buf_gds-dtl no-lock
     3475         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     3476           and buf_gds-dtl.artic     = buf_doc-line.artic
     3477           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     3478           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     3479       on error undo, return error
     3480       :
     3481           if buf_trn-doc.doc-type <> 'инв':U
     3482           then do:
     3483               if buf_trn-doc.doc-type = 'при':U
     3484               or buf_trn-doc.doc-type = 'возврат':U
     3485               then do:
     3486                   assign
     3487                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     3488                   .
     3489               end.
     3490               else do:
     3491                   assign
     3492                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     3493                   .
     3494               end.
     3495           end.
     3496           else do:
     3497               assign
     3498                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     3499               .
     3500           end.
     3501           if v-gds-dtl-fact-qnty <> 0
     3502           then do:
     3503   if buf_trn-doc.ext-doc-type = 'ot':U or
     3504      buf_trn-doc.ext-doc-type = ?                 then do:
     3505     assign
     3506      out-vatp-have-vat-slt = yes.
     3507   end.
     3508   else do:
     3509     find first out-vatp_doc-attr no-lock
     3510       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     3511         and out-vatp_doc-attr.attr-code = 'envd':U
     3512         no-error .
     3513     if not available out-vatp_doc-attr then do:
     3514       assign
     3515         out-vatp-have-vat-slt = yes.
     3516     end.
     3517     else do:
     3518        out-vatp-have-vat-slt = no.
     3519     end.
     3520   end.
     3521   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     3522                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     3523                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     3524   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3526     (input  buf_doc-line.artic
     3527     ,input  buf_doc-line.prod-type
     3528     ,input  buf_doc-line.prod-code
     3529     ,output varroot-node
     3530     ) no-error .
     3531   if error-status :error then do:
     3532     message
     3533       vss-workfile vss-revision vss-description skip
     3534       "Ошибка при определении корневого признака товара" skip
     3535       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3536       error-status :get-message(1) skip
     3537       return-value skip
     3538       view-as alert-box error .
     3539     undo, return error .
     3540   end.
     3541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3542     (input  varroot-node
