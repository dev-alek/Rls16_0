     3326     define buffer buf_PromoAction for ub.PromoAction .
     3327     define buffer buf_PromoSched  for ub.promo-schedule .
     3328     define buffer buf_promogoods  for ub.PromoGoods .
     3329     define variable v-attr-emrc as character no-undo .
     3330     define variable v-attr-type as character no-undo .
     3331     do
     3332       on error undo, return error
     3333       :
     3334       if selective = 0 then
     3335       do:
     3336         if action = "D" then
     3337         do:
     3338           FOR EACH ub.PromoAction
     3339             EXCLUSIVE-LOCK where ub.PromoAction.Status_ <> 3
     3340             :
     3341             v-promo-action = new PromoActionSub(i-obj-code).
     3342             v-promo-action:ID = ub.PromoAction.id .
     3343             m-storage = new ibs.th.gbl.storage.promoactionstorage () . // создать экземпляр, который работает с БД
     3344             m-storage:refreshObj(v-promo-action, i-obj-code) . // прочесть коллекцию акций (все акции)
     3345             v-promo-action:refreshChildObj() . // возвращает
     3346             if ub.PromoAction.typecond = 4 then
     3347   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3348   assign
     3349     v-version-dec = decimal(p-pos-version)
     3350       no-error .
     3351   for each ub.PromoGoods no-lock where ub.PromoGoods.db-num = ub.PromoAction.db-num and
     3352     ub.PromoGoods.idAction = ub.PromoAction.id and
     3353     ub.PromoGoods.gds-code <> 0:
     3354     find first ub.PromoAttr no-lock where ub.PromoAttr.tablename = "PromoGoods" and
     3355       ub.PromoAttr.attr-code = "bc-code" and
     3356       ub.PromoGoods.idAction = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     3357       ub.PromoGoods.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
     3358       ub.PromoGoods.gds-code = integer(entry(3,ub.PromoAttr.p-key,chr(3))) no-error .
     3359     if available (ub.PromoAttr) then
     3360     do:
     3361       find first ub.goods no-lock where ub.goods.gds-code = ub.PromoGoods.gds-code no-error .
     3362       for first ub.bar-code no-lock where ub.bar-code.gds-code = ub.goods.gds-code and ub.bar-code.b-code = ub.goods.gds-code :
     3363         producer-int = (if ub.goods.prod-type = 'орг':U then 1000000 else 0 ) + ub.goods.prod-code .
     3364         run gds-attr-value in this-procedure (
     3365           input ub.goods.gds-code
     3366           ,input 'emrc-type':U
     3367           ,output v-attr-emrc
     3368           ,output v-attr-type) no-error.
     3369         run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     3370           , "DEL":U
     3371           , OS2-time
     3372           , string(ub.PromoAttr.attr-value))).
     3373         run bgelib-tag-put in this-procedure ( input 3, input "IBCCode"
     3374           , input string( ub.bar-code.b-code )
     3375           , input 1 ).
     3376         run bgelib-tag-put in this-procedure ( input 3, input "IBCProducer"
     3377           , input string(producer-int), input 1 ).
     3378         run bgelib-tag-put in this-procedure ( input 3, input "IBCIngredient"
     3379           , input trim(string( ub.goods.struct, "X(40)")), input 1 ).
     3380         find first country no-lock where country.alpha1 = ub.goods.alpha1 no-error.
     3381         if available country then
     3382           run bgelib-tag-put in this-procedure ( input 3, input "IBCCountry"
     3383             , input country.short-name, input 1 ).
     3384         find last ub.price-all no-lock where ub.price-all.gds-code = ub.goods.gds-code and
     3385           ub.price-all.obj-code = i-obj-code and
     3386           ub.price-all.obj-type = 'маг':U and
     3387           ub.price-all.main-indication = 0 and
     3388           ub.price-all.type-price = 0 no-error .
     3389         if available (ub.price-all) then
     3390         do:
     3391           run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
     3392             , input string(ub.price-all.price-sale)
     3393             , input 1 ).
     3394         end.
     3395         else
     3396         do:
     3397           run bgelib-tag-put in this-procedure ( input 3, input "IBCPrice"
     3398             , input string(0)
     3399             , input 1 ).
     3400         end.
     3401         run bgelib-tag-put in this-procedure ( input 3, input "IBCType"
     3402           , input string( 0 ), input 1 ).
     3403         run bgelib-tag-put in this-procedure ( input 3, input "IBC_EMRC"                                        ~
     3404           , input  v-attr-emrc, input 1 ).
     3405         run bgelib-tag-put in this-procedure ( input 3, input "IBCUnitFactor"                                   ~
     3406           , input  string(ub.bar-code.cli-base-rate), input 1 ).
     3407         run bgelib-tag-close in this-procedure ( input 2, input "ItemBarCode") .
     3408       end.
     3409     end.
     3410   end.
     3411     .
     3412   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3413   assign
     3414     v-version-dec = decimal(p-pos-version)
     3415       no-error .
     3416   run bgelib-tag-open in this-procedure ( input 2, input "PromoAction"
     3417     , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     3418     then "ADD":U
     3419     else "DEL":U),
     3420     OS2-time, v-promo-action:ID)).
     3421           find first ub.promoAttr where
     3422             ub.promoAttr.attr-code = "charge-BL" and
     3423             ub.promoAttr.tablename = "PromoPay" and
     3424             v-promo-action:ID = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     3425             v-promo-action:db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3)))
     3426             no-error.
     3427           if available (ub.PromoAttr) then do:
     3428             if logical(ub.PromoAttr.attr-value) = true then change-BL = 1 .
     3429             else change-BL = 0 .
     3430           end.
     3431           else change-BL = 0 .
     3432   run bgelib-tag-put in this-procedure ( input 3, input "PAName":U
     3433     , input string(v-promo-action:NameAction), input 1 ).
     3434   run bgelib-tag-put in this-procedure ( input 3, input "PAType":U
     3435     , input string(v-promo-action:TypeDiscont), input 1 ).
     3436   run bgelib-tag-put in this-procedure ( input 3, input "PABeg":U
     3437     , input Xml-CD-DateTimetoString(v-promo-action:beg-date,0), input 1 ).
     3438   run bgelib-tag-put in this-procedure ( input 3, input "PAEnd":U
     3439     , input Xml-CD-DateTimetoString(if v-promo-action:changeDate <> ? then v-promo-action:changeDate else v-promo-action:end-date,86399), input 1 ).
     3440   run bgelib-tag-put in this-procedure ( input 3, input "PAPriority":U
     3441     , input string(v-promo-action:priority), input 1 ).
     3442   run bgelib-tag-put in this-procedure ( input 3, input "PALoyalRest":U
     3443     , input string(change-BL), input 1 ).
     3444   vTypePay = "".
     3445   do vIp = 1 to num-entries(v-promo-action:paymenttype,chr(4)):
     3446     vTypePay = vTypePay + "," + LEFT-TRIM(entry(1,
     3447       entry(vIp,
     3448       v-promo-action:paymenttype,
     3449       chr(4)
     3450       ),
     3451       chr(3)
     3452       ),
     3453       "0").
     3454   end.
     3455   vTypePay = substring(vTypePay,2).
     3456   run bgelib-tag-put in this-procedure ( input 3, input "PAPayment":U
     3457     , input vTypePay, input 0 ).
     3458   run bgelib-tag-put in this-procedure ( input 3, input "PACalcMethod":U
     3459     , input string(v-promo-action:methodCalc), input 1 ).
     3460   run bgelib-tag-put in this-procedure ( input 3, input "PACondType":U
     3461     , input string(v-promo-action:typecond), input 1 ).
     3462   v-subShedWs = v-promo-action:ScheduleWeek .
     3463   v-lengthSh = v-subShedWs:iCounter .
     3464   do v-i = 1 to v-lengthSh:
     3465     v-size = v-subShedWs:GetItem(v-i) .
     3466     v-subShedW = v-subShedWs:promoSchedwObjCurr .
     3467     do v-ii = 1 to num-entries(v-subShedW:wdaylist):
     3468       if v-subShedW:wdaylist = "0"
     3469         then
     3470       do v-j = 1 to 7:
     3471         run bgelib-tag-open in this-procedure ( input 3, input "PASched","").
     3472         run bgelib-tag-put in this-procedure ( input 4, input "PASId":U
     3473           , input string(v-promo-action:id), input 1 ).
     3474         run bgelib-tag-put in this-procedure ( input 4, input "PASDay":U
     3475           , input string(v-j), input 1 ).
     3476         run bgelib-tag-put in this-procedure ( input 4, input "PASBeg":U
     3477             , input Xml-CD-DateTimetoString(12/31/1989,v-subShedW:timebeg), input 1 ).
     3478           run bgelib-tag-put in this-procedure ( input 4, input "PASEnd":U
     3479             , input Xml-CD-DateTimetoString(12/31/9999,v-subShedW:timeend), input 1 ).
     3480         run bgelib-tag-close in this-procedure ( input 3, input "PASched").
     3481       end.
     3482       else
     3483       do:
     3484         run bgelib-tag-open in this-procedure ( input 3, input "PASched","").
     3485         run bgelib-tag-put in this-procedure ( input 4, input "PASId":U
     3486           , input string(v-promo-action:id), input 1 ).
     3487         run bgelib-tag-put in this-procedure ( input 4, input "PASDay":U
     3488           , input string(entry(v-ii,v-subShedW:wdaylist)), input 1 ).
     3489         run bgelib-tag-put in this-procedure ( input 4, input "PASBeg":U
     3490            , input Xml-CD-DateTimetoString(12/31/1989,v-subShedW:timebeg), input 1 ).
     3491         run bgelib-tag-put in this-procedure ( input 4, input "PASEnd":U
     3492           , input Xml-CD-DateTimetoString(12/31/9999,v-subShedW:timeend), input 1 ).
     3493         run bgelib-tag-close in this-procedure ( input 3, input "PASched").
     3494       end.
     3495     end.
     3496   end.
     3497   v-subGoods = v-promo-action:GoodsAppl .
     3498   if valid-object (v-subGoods) then
     3499   do:
     3500     v-lengthGd = v-subGoods:iCounter .
     3501     if v-lengthGd eq 0
     3502       then
     3503     do:
     3504       run bgelib-tag-open in this-procedure ( input 3, input "PAGoods","").
     3505       run bgelib-tag-close in this-procedure ( input 3, input "PAGoods").
     3506     end.
     3507     else
     3508     do v-i = 1 to v-lengthGD:
     3509       v-size = v-subGoods:GetItem(v-i) .
     3510       v-subGood = v-subGoods:promoGoodsObjCurr .
     3511       run bgelib-tag-open in this-procedure ( input 3, input "PAGoods","").
     3512       run bgelib-tag-put in this-procedure ( input 4, input "PAGId":U
     3513         , input string(v-promo-action:id), input 1 ).
     3514       if v-promo-action:typecond <> 4 then
     3515       do:
     3516         run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     3517           , input if v-subGood:dtSeason = "" then string(v-subGood:GdsCode) else v-subGood:dtSeason, input 1 ).
     3518       end.
     3519       else
     3520       do:
     3521         if v-subGood:dtSeason <> "" then
     3522         do:
     3523           run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     3524             , input v-subGood:dtSeason, input 1 ).
     3525         end.
     3526         else
     3527         do:
     3528           find first ub.PromoAttr no-lock where ub.PromoAttr.tablename = "PromoGoods" and
     3529             ub.PromoAttr.attr-code = "bc-code" and
     3530             ub.PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     3531             ub.PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
     3532             v-subGood:GdsCode = integer(entry(3,ub.PromoAttr.p-key,chr(3))) no-error .
     3533           if available (ub.PromoAttr) then run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     3534               , input string(ub.PromoAttr.attr-value), input 1 ).
     3535           else run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     3536               , input string(v-subGood:GdsCode), input 1 ).
     3537         end.
     3538       end.
     3539       run bgelib-tag-put in this-procedure ( input 4, input "PAGPrice":U
     3540         , input string(v-subGood:price), input 0 ).
     3541       run bgelib-tag-close in this-procedure ( input 3, input "PAGoods").
     3542       if v-promo-action:typecond <> 4 then
     3543       do:
     3544         for each bar-code where bar-code.gds-code      eq v-subGood:GdsCode
     3545           and bar-code.b-code                       ne v-subGood:GdsCode
     3546           and bar-code.in-code                      eq ""
     3547           and bar-code.part-code                    eq ""
     3548           no-lock:
     3549           run bgelib-tag-open in this-procedure ( input 3, input "PAGoods","").
     3550           run bgelib-tag-put in this-procedure ( input 4, input "PAGId":U
     3551             , input string(v-promo-action:id), input 1 ).
     3552           run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     3553             , input string(bar-code.b-code), input 1 ).
     3554           if (    v-subGood:price ne 0
     3555             and v-subGood:price ne ?)
     3556             then
     3557           do:
     3558             run bgelib-tag-put in this-procedure ( input 4, input "PAGPrice":U
     3559               , input string(v-subGood:price * bar-code.cli-base-rate), input 0 ).
     3560           end.
     3561           run bgelib-tag-close in this-procedure ( input 3, input "PAGoods").
     3562         end.
     3563       end.
     3564     end.
     3565   end.
     3566   v-subGdCrs = v-promo-action:GoodsCrits .
     3567   if valid-object (v-subGdCrs) then
