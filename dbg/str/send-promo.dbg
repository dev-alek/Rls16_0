     2462   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2463   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2464   FUNCTION cp-isuse returns logical ( input p-cdpay-code as integer
     2465                                      ,input p-curr-code as integer
     2466                                      ,input p-host-code as integer
     2467                                      ,input p-obj-type as character
     2468                                      ,input p-obj-code as integer
     2469                                      ,input p-cp-is-use as logical
     2470                                      ,input p-cash-num as integer
     2471                                      ,input p-pos-type as character
     2472                                      ):
     2473   define variable v-value as character no-undo .
     2474   define variable v-type as character no-undo .
     2475   if p-cp-is-use then do:
     2476     run cp-attr-value  in this-procedure (
     2477                                              input p-cdpay-code
     2478                                             ,input p-curr-code
     2479                                             ,input p-host-code
     2480                                             ,input p-obj-type
     2481                                             ,input p-obj-code
     2482                                             ,input 'is-use':U
     2483                                             ,output v-value
     2484                                             ,output v-type) no-error .
     2485     if error-status:error
     2486     or v-value = '':u then do:
     2487       run cp-attr-value  in this-procedure (
     2488                                                input p-cdpay-code
     2489                                               ,input p-curr-code
     2490                                               ,input p-host-code
     2491                                               ,input '':U
     2492                                               ,input  0
     2493                                               ,input 'is-use':U
     2494                                               ,output v-value
     2495                                               ,output v-type) no-error .
     2496       if error-status:error
     2497       or v-value = '':u then do:
     2498         run cp-attr-value  in this-procedure (
     2499                                                 input  p-cdpay-code
     2500                                                 ,input p-curr-code
     2501                                                 ,input  0
     2502                                                 ,input  '':U
     2503                                                 ,input  0
     2504                                                 ,input  'is-use':U
     2505                                                 ,output v-value
     2506                                                 ,output v-type) no-error .
     2507       end.
     2508     end.
     2509     if v-value <> '*':U
     2510     and lookup(string(p-cash-num) + chr(44) + p-pos-type, v-value, chr(4)) = 0 then do:
     2511       return no.
     2512     end.
     2513   end.
     2514   return yes.
     2515   END FUNCTION.
