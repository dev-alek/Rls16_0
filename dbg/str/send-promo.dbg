     4963             ub.PromoAttr.attr-code = "bc-code" and
     4964             ub.PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     4965             ub.PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
