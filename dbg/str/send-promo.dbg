     3610       run bgelib-tag-put in this-procedure ( input 4, input "PAFGCode":U
     3611         , input string(v-subCardBin:nameset), input 1 ).
     3612       run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     3613     end.
     3614   end.
     3615   if  valid-object (v-subGdCrs)    and v-subGdCrs   :iCounter eq 0
     3616     and valid-object (v-subcardbins) and v-subcardbins:iCounter eq 0
     3617     then
     3618   do:
     3619     run bgelib-tag-open in this-procedure ( input 3, input "PAFreeGoods","").
     3620     run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     3621   end.
     3622   v-subGifts = v-promo-action:Gifts .
