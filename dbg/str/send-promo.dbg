     4871     , input Xml-CD-DateTimetoString(v-promo-action:beg-date,0), input 1 ).
     4872   run bgelib-tag-put in this-procedure ( input 3, input "PAEnd":U
     4873     , input Xml-CD-DateTimetoString(if v-promo-action:changeDate <> ? then v-promo-action:changeDate else v-promo-action:end-date,86399), input 1 ).
     4874   run bgelib-tag-put in this-procedure ( input 3, input "PAPriority":U
     4875     , input string(v-promo-action:priority), input 1 ).
     4876   run bgelib-tag-put in this-procedure ( input 3, input "PALoyalRest":U
     4877     , input string(change-BL), input 1 ).
     4878   vTypePay = "".
     4879   do vIp = 1 to num-entries(v-promo-action:paymenttype,chr(4)):
     4880     vTypePay = vTypePay + "," + LEFT-TRIM(entry(1,
     4881       entry(vIp,
     4882       v-promo-action:paymenttype,
     4883       chr(4)
     4884       ),
     4885       chr(3)
     4886       ),
     4887       "0").
     4888   end.
     4889   vTypePay = substring(vTypePay,2).
     4890   run bgelib-tag-put in this-procedure ( input 3, input "PAPayment":U
     4891     , input vTypePay, input 0 ).
     4892   run bgelib-tag-put in this-procedure ( input 3, input "PACalcMethod":U
     4893     , input string(v-promo-action:methodCalc), input 1 ).
     4894   run bgelib-tag-put in this-procedure ( input 3, input "PACondType":U
     4895     , input string(v-promo-action:typecond), input 1 ).
     4896   v-subShedWs = v-promo-action:ScheduleWeek .
     4897   v-lengthSh = v-subShedWs:iCounter .
     4898   do v-i = 1 to v-lengthSh:
     4899     v-size = v-subShedWs:GetItem(v-i) .
     4900     v-subShedW = v-subShedWs:promoSchedwObjCurr .
     4901     do v-ii = 1 to num-entries(v-subShedW:wdaylist):
     4902       if v-subShedW:wdaylist = "0"
     4903         then
     4904       do v-j = 1 to 7:
     4905         run bgelib-tag-open in this-procedure ( input 3, input "PASched","").
     4906         run bgelib-tag-put in this-procedure ( input 4, input "PASId":U
     4907           , input string(v-promo-action:id), input 1 ).
