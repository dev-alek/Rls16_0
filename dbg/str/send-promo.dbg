     5237     if available (ub.PromoAttr) then
     5238     do:
     5239       find first ub.goods no-lock where ub.goods.gds-code = ub.PromoGoods.gds-code no-error .
     5240       for first ub.bar-code no-lock where ub.bar-code.gds-code = ub.goods.gds-code and ub.bar-code.b-code = ub.goods.gds-code:
     5241         producer-int = (if ub.goods.prod-type = 'орг':U then 1000000 else 0 ) + ub.goods.prod-code .
     5242         run gds-attr-value in this-procedure (
     5243           input ub.goods.gds-code
     5244           ,input 'emrc-type':U
     5245           ,output v-attr-emrc
     5246           ,output v-attr-type) no-error.
     5247         run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     5248            , "ADD":U
