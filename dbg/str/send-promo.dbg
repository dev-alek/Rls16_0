     1442   procedure alienini-getkey :
     1443   define input parameter i-filename as char.
     1444   define input parameter i-section as char.
     1445   define input parameter i-key as char.
     1446   define output parameter o-value as char.
     1447   define variable EntryPointer as integer no-undo.
     1448   define variable mem1 as memptr no-undo.
     1449   define variable mem2 as memptr no-undo.
     1450   define variable mem1size as integer no-undo.
     1451   define variable mem2size as integer no-undo.
     1452   define variable ii       as integer    no-undo.
     1453   define variable cbReturnSize  as integer    no-undo.
     1454   assign
     1455   set-size(mem1)  = 4000
     1456   mem1size = 4000.
     1457   if i-key = "" then EntryPointer = 0.
     1458   else do:
     1459     assign
     1460     set-size(mem2) = 128
     1461     mem2size = 128
     1462     EntryPointer = get-pointer-value(mem2)
     1463     put-string(mem2, 1) = i-key.
     1464   end.
     1465   run getprivateprofilestringA
     1466                                 (i-section,
     1467                                  EntryPointer,
     1468                                  "",
     1469                                  get-pointer-value(mem1),
     1470                                  input mem1size,
     1471                                  i-filename,
     1472                                  output cbReturnSize).
     1473   do ii = 1 to cbReturnSize:
     1474     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1475                  then o-value + ","
     1476                  else o-value + chr(get-byte(mem1, ii)).
     1477   end.
     1478     set-size(mem1) = 0.
     1479     set-size(mem2) = 0.
     1480   end procedure.
     1481   procedure alienini-putkey :
     1482   define input parameter i-filename as char.
     1483   define input parameter i-section as char.
     1484   define input parameter i-key as char.
     1485   define input parameter i-value as char.
     1486   define variable cbReturnSize as integer.
     1487   run writeprivateprofilestringA
     1488                                  (i-section,
     1489                                   i-key,
     1490                                   i-value,
     1491                                   i-filename,
     1492                                   output cbReturnSize ).
     1493   end procedure.
     1494   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1495     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1496     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1497     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1498     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1499     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1500     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1501     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1502   END PROCEDURE.
     1503   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1504     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1505     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1506     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1507     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1508     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1509   END PROCEDURE.
