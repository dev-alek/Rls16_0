     3579       run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     3580       for each bar-code where bar-code.gds-code       eq v-subGdCr:GdsCode
     3581         and bar-code.b-code         ne v-subGdCr:GdsCode
     3582         and bar-code.in-code        eq ""
