     4622     if v-subGDCrites:iCounter eq 0
     4623       then
     4624     do:
     4625       run bgelib-tag-open in this-procedure ( input 3, input "PACond","").
     4626       run bgelib-tag-close in this-procedure ( input 3, input "PACond").
     4627     end.
     4628     else
     4629     do v-ii = 1 to v-subGDCrites:iCounter:
     4630       v-subGDCrites:GetItem(v-ii) .
     4631       v-subGDCrite = v-subGDCrites:promoCriterionObjCurr .
     4632       v-subGDCrite:refreshChildObj() .
     4633       v-subCrGifts = v-subGDCrite:Gifts .
     4634       if VALID-OBJECT (v-subCrGifts) then
     4635       do:
     4636         do v-i = 1 to v-subCrGifts:iCounter:
     4637           vgift = yes.
     4638           v-subCrGifts:GetItem(v-i) .
     4639           v-subCrGift = v-subCrGifts:promoGiftObjCurr .
     4640           if v-i = 1 then do:
     4641           if v-subCrGift:mess <> "" or v-subCrGift:mess <> ? then v-mess = v-subCrGift:mess .
     4642           if v-subCrGift:mess-gks <> "" or v-subCrGift:mess-gks <> ? then v-mess-gks = v-subCrGift:mess-gks .
     4643           end.
     4644           if v-subCrGift:GdsCode <> 0 then
     4645           do:
     4646             run bgelib-tag-open in this-procedure ( input 3, input "PAGiftGoods","").
     4647             run bgelib-tag-put in this-procedure ( input 4, input "PAGGId":U
     4648               , input string(v-promo-action:id), input 1 ).
     4649             run bgelib-tag-put in this-procedure ( input 4, input "PAGGNum":U
     4650               , input string(v-subGDCrite:id), input 1 ).
     4651             run bgelib-tag-put in this-procedure ( input 4, input "PAGGCode":U
     4652               , input if v-subCrGift:dtSeason = "" then string(v-subCrGift:GdsCode) else v-subCrGift:dtSeason, input 1 ).
     4653             run bgelib-tag-put in this-procedure ( input 4, input "PAGGAmount":U
     4654               , input string(v-subCrGift:qnty), input 1 ).
     4655             run bgelib-tag-close in this-procedure ( input 3, input "PAGiftGoods").
     4656           end.
     4657         end.
     4658       end.
     4659       vPricePromoSets = v-subGDCrite:discont .
     4660       if v-promo-action:typecond <> 4 then
     4661       do:
     4662         run bgelib-tag-open in this-procedure ( input 3, input "PACond","").
     4663         run bgelib-tag-put in this-procedure ( input 4, input "PACId":U
     4664           , input string(v-promo-action:id), input 1 ).
     4665         run bgelib-tag-put in this-procedure ( input 4, input "PACNum":U
     4666           , input string(v-subGDCrite:id), input 1 ).
     4667         run bgelib-tag-put in this-procedure ( input 4, input "PACAmount":U
     4668           , input string(v-subGDCrite:mincrit), input 1 ).
     4669         run bgelib-tag-put in this-procedure ( input 4, input "PACUPAmount":U
     4670           , input string(v-subGDCrite:maxcrit), input 1 ).
     4671         run bgelib-tag-put in this-procedure ( input 4, input "PACDiscount":U
     4672           , input string(v-subGDCrite:discont), input 1 ).
     4673         run bgelib-tag-put in this-procedure ( input 4, input "PACMessage":U
     4674           , input string(v-mess), input 0 ).
     4675         run bgelib-tag-put in this-procedure ( input 4, input "PACMessage-GKS":U
     4676           , input string(v-mess-gks), input 0 ).
     4677         run bgelib-tag-close in this-procedure ( input 3, input "PACond").
     4678       end.
     4679       else
     4680       do:
     4681         if (v-promo-action:methodCalc = 2 or v-promo-action:methodCalc = 1) and v-ii = 1 then
     4682         do:
     4683           run bgelib-tag-open in this-procedure ( input 3, input "PACond","").
     4684           run bgelib-tag-put in this-procedure ( input 4, input "PACId":U
     4685             , input string(v-promo-action:id), input 1 ).
     4686           run bgelib-tag-put in this-procedure ( input 4, input "PACDiscount":U
     4687             , input string(v-subGDCrite:discont), input 1 ).
     4688           run bgelib-tag-close in this-procedure ( input 3, input "PACond").
     4689         end.
     4690       end.
     4691     end.
     4692   end.
     4693   v-subPromoSets = v-promo-action:PromoSet .
     4694   if valid-object (v-subPromoSets) then
     4695   do:
     4696     if v-promo-action:typecond <> 4 then
     4697     do:
     4698       run bgelib-tag-put in this-procedure ( input 3, input "PASetPrice":U
     4699         , input string(vPricePromoSets), input 1 ).
     4700     end.
     4701     if v-subPromoSets:iCounter eq 0
     4702       then
     4703     do:
     4704       run bgelib-tag-open in this-procedure ( input 3, input "PASetSection","").
     4705       run bgelib-tag-close in this-procedure ( input 3, input "PASetSection").
     4706     end.
     4707     else
     4708     do v-i = 1 to v-subPromoSets:iCounter:
     4709       v-subPromoSets:GetItem(v-i).
     4710       v-subPromoSet = v-subPromoSets:promoGoodsObjCurr .
     4711       run bgelib-tag-open in this-procedure ( input 3, input "PASetSection","").
     4712       run bgelib-tag-put in this-procedure ( input 4, input "PASSId":U
     4713         , input string(v-subPromoSet:idaction), input 1 ).
     4714       run bgelib-tag-put in this-procedure ( input 4, input "PASSAmount":U
     4715         , input string(v-subPromoSet:qnty), input 1 ).
     4716       run bgelib-tag-put in this-procedure ( input 4, input "PASSDiscount":U
     4717         , input string(v-subPromoSet:price), input 1 ).
     4718       run bgelib-tag-put in this-procedure ( input 4, input "PASSNum":U
     4719         , input string(v-subPromoSet:id), input 1 ).
     4720       run bgelib-tag-close in this-procedure ( input 3, input "PASetSection").
     4721     end.
     4722     do v-i = 1 to v-subPromoSets:iCounter:
     4723       v-subPromoSets:GetItem(v-i).
     4724       v-subPromoSet = v-subPromoSets:promoGoodsObjCurr .
     4725       v-subPromoSet:refreshChildObj().
     4726       v-subPromoSetGoods = v-subPromoSet:promoSetGoods.
     4727       do v-j = 1 to v-subPromoSetGoods:iCounter:
     4728         vsetgoods = yes.
     4729         v-subPromoSetGoods:GetItem(v-j).
     4730         v-subPromoSetGood = v-subPromoSetGoods:promoGoodsObjCurr.
     4731         run bgelib-tag-open in this-procedure ( input 3, input "PASetGoods","").
     4732         run bgelib-tag-put in this-procedure ( input 4, input "PASGId":U
     4733           , input string(v-subPromoSetGood:idaction), input 1 ).
     4734         run bgelib-tag-put in this-procedure ( input 4, input "PASGCode":U
     4735           , input if v-subPromoSetGood:dtSeason = "" then string(v-subPromoSetGood:GdsCode) else v-subPromoSetGood:dtSeason, input 1 ).
     4736         run bgelib-tag-put in this-procedure ( input 4, input "PASGNum":U
     4737           , input string(v-subPromoSetGood:idSet), input 1 ).
     4738         run bgelib-tag-close in this-procedure ( input 3, input "PASetGoods").
     4739         for each bar-code where bar-code.gds-code       eq v-subPromoSetGood:GdsCode
     4740           and bar-code.b-code         ne v-subPromoSetGood:GdsCode
     4741           and bar-code.in-code        eq ""
     4742           and bar-code.part-code      eq ""
     4743           no-lock:
     4744           run bgelib-tag-open in this-procedure ( input 3, input "PASetGoods","").
     4745           run bgelib-tag-put in this-procedure ( input 4, input "PASGId":U
     4746             , input string(v-subPromoSetGood:idaction), input 1 ).
     4747           run bgelib-tag-put in this-procedure ( input 4, input "PASGCode":U
     4748             , input string(bar-code.b-code), input 1 ).
     4749           run bgelib-tag-put in this-procedure ( input 4, input "PASGNum":U
     4750             , input string(v-subPromoSetGood:idSet), input 1 ).
     4751           run bgelib-tag-close in this-procedure ( input 3, input "PASetGoods").
     4752         end.
     4753       end.
     4754     end.
     4755   end.
     4756   if not vGift
     4757     then
     4758   do:
     4759     run bgelib-tag-open in this-procedure ( input 3, input "PAGiftGoods","").
     4760     run bgelib-tag-close in this-procedure ( input 3, input "PAGiftGoods").
     4761   end.
     4762   if not vSetgoods
     4763     then
     4764   do:
     4765     run bgelib-tag-open in this-procedure ( input 3, input "PASetGoods","").
     4766     run bgelib-tag-close in this-procedure ( input 3, input "PASetGoods").
     4767   end.
     4768   run bgelib-tag-close in this-procedure ( input 2, input "PromoAction").
     4769             end.
     4770           end.
     4771           else
     4772           do:
     4773             FIND FIRST ub.PromoAction No-LOCK WHERE
     4774               ub.PromoAction.id = v-promo-action:ID and ub.PromoAction.Status_ = 1 No-ERROR.
     4775             IF avail ub.PromoAction then
     4776             do:
     4777               m-storage = new ibs.th.gbl.storage.promoactionstorage () . // создать экземпляр, который работает с БД
     4778               m-storage:refreshObj(v-promo-action, i-obj-code) . // прочесть коллекцию акций (все акции)
     4779               v-promo-action:refreshChildObj() . // возвращает
     4780               if ub.PromoAction.typecond = 4 then
     4781   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4782   assign
     4783     v-version-dec = decimal(p-pos-version)
     4784       no-error .
     4785   for each ub.PromoGoods no-lock where ub.PromoGoods.db-num = ub.PromoAction.db-num and
     4786     ub.PromoGoods.idAction = ub.PromoAction.id and
     4787     ub.PromoGoods.gds-code <> 0:
     4788     find first ub.PromoAttr no-lock where ub.PromoAttr.tablename = "PromoGoods" and
     4789       ub.PromoAttr.attr-code = "bc-code" and
     4790       ub.PromoGoods.idAction = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     4791       ub.PromoGoods.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
     4792       ub.PromoGoods.gds-code = integer(entry(3,ub.PromoAttr.p-key,chr(3))) no-error .
     4793     if available (ub.PromoAttr) then
     4794     do:
     4795       find first ub.goods no-lock where ub.goods.gds-code = ub.PromoGoods.gds-code no-error .
     4796       for first ub.bar-code no-lock where ub.bar-code.gds-code = ub.goods.gds-code and ub.bar-code.b-code = ub.goods.gds-code :
     4797         producer-int = (if ub.goods.prod-type = 'орг':U then 1000000 else 0 ) + ub.goods.prod-code .
     4798         run gds-attr-value in this-procedure (
     4799           input ub.goods.gds-code
     4800           ,input 'emrc-type':U
     4801           ,output v-attr-emrc
     4802           ,output v-attr-type) no-error.
     4803         run bgelib-tag-open in this-procedure ( input 2, input "ItemBarCode", input substitute("ctrl='&1' tms='&2' code='&3'"
     4804           , "DEL":U
     4805           , OS2-time
     4806           , string(ub.PromoAttr.attr-value))).
     4807         run bgelib-tag-put in this-procedure ( input 3, input "IBCCode"
     4808           , input string( ub.bar-code.b-code )
     4809           , input 1 ).
     4810         run bgelib-tag-put in this-procedure ( input 3, input "IBCProducer"
     4811           , input string(producer-int), input 1 ).
     4812         run bgelib-tag-put in this-procedure ( input 3, input "IBCIngredient"
     4813           , input trim(string( ub.goods.struct, "X(40)")), input 1 ).
