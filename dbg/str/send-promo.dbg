     4426     vTypePay = vTypePay + "," + LEFT-TRIM(entry(1,
     4427       entry(vIp,
     4428       v-promo-action:paymenttype,
     4429       chr(4)
     4430       ),
     4431       chr(3)
     4432       ),
     4433       "0").
     4434   end.
     4435   vTypePay = substring(vTypePay,2).
     4436   run bgelib-tag-put in this-procedure ( input 3, input "PAPayment":U
     4437     , input vTypePay, input 0 ).
     4438   run bgelib-tag-put in this-procedure ( input 3, input "PACalcMethod":U
     4439     , input string(v-promo-action:methodCalc), input 1 ).
     4440   run bgelib-tag-put in this-procedure ( input 3, input "PACondType":U
     4441     , input string(v-promo-action:typecond), input 1 ).
     4442   v-subShedWs = v-promo-action:ScheduleWeek .
     4443   v-lengthSh = v-subShedWs:iCounter .
     4444   do v-i = 1 to v-lengthSh:
     4445     v-size = v-subShedWs:GetItem(v-i) .
     4446     v-subShedW = v-subShedWs:promoSchedwObjCurr .
     4447     do v-ii = 1 to num-entries(v-subShedW:wdaylist):
     4448       if v-subShedW:wdaylist = "0"
     4449         then
     4450       do v-j = 1 to 7:
     4451         run bgelib-tag-open in this-procedure ( input 3, input "PASched","").
     4452         run bgelib-tag-put in this-procedure ( input 4, input "PASId":U
     4453           , input string(v-promo-action:id), input 1 ).
     4454         run bgelib-tag-put in this-procedure ( input 4, input "PASDay":U
     4455           , input string(v-j), input 1 ).
     4456         run bgelib-tag-put in this-procedure ( input 4, input "PASBeg":U
     4457             , input Xml-CD-DateTimetoString(12/31/1989,v-subShedW:timebeg), input 1 ).
     4458           run bgelib-tag-put in this-procedure ( input 4, input "PASEnd":U
     4459             , input Xml-CD-DateTimetoString(12/31/9999,v-subShedW:timeend), input 1 ).
     4460         run bgelib-tag-close in this-procedure ( input 3, input "PASched").
     4461       end.
     4462       else
     4463       do:
     4464         run bgelib-tag-open in this-procedure ( input 3, input "PASched","").
     4465         run bgelib-tag-put in this-procedure ( input 4, input "PASId":U
     4466           , input string(v-promo-action:id), input 1 ).
     4467         run bgelib-tag-put in this-procedure ( input 4, input "PASDay":U
     4468           , input string(entry(v-ii,v-subShedW:wdaylist)), input 1 ).
     4469         run bgelib-tag-put in this-procedure ( input 4, input "PASBeg":U
     4470            , input Xml-CD-DateTimetoString(12/31/1989,v-subShedW:timebeg), input 1 ).
     4471         run bgelib-tag-put in this-procedure ( input 4, input "PASEnd":U
     4472           , input Xml-CD-DateTimetoString(12/31/9999,v-subShedW:timeend), input 1 ).
     4473         run bgelib-tag-close in this-procedure ( input 3, input "PASched").
     4474       end.
     4475     end.
     4476   end.
     4477   v-subGoods = v-promo-action:GoodsAppl .
     4478   if valid-object (v-subGoods) then
     4479   do:
     4480     v-lengthGd = v-subGoods:iCounter .
     4481     if v-lengthGd eq 0
     4482       then
     4483     do:
     4484       run bgelib-tag-open in this-procedure ( input 3, input "PAGoods","").
     4485       run bgelib-tag-close in this-procedure ( input 3, input "PAGoods").
     4486     end.
     4487     else
     4488     do v-i = 1 to v-lengthGD:
     4489       v-size = v-subGoods:GetItem(v-i) .
     4490       v-subGood = v-subGoods:promoGoodsObjCurr .
     4491       run bgelib-tag-open in this-procedure ( input 3, input "PAGoods","").
     4492       run bgelib-tag-put in this-procedure ( input 4, input "PAGId":U
     4493         , input string(v-promo-action:id), input 1 ).
     4494       if v-promo-action:typecond <> 4 then
     4495       do:
     4496         run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     4497           , input if v-subGood:dtSeason = "" then string(v-subGood:GdsCode) else v-subGood:dtSeason, input 1 ).
     4498       end.
     4499       else
     4500       do:
     4501         if v-subGood:dtSeason <> "" then
     4502         do:
