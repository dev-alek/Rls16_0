     3627       v-subGifts:GetItem(v-i).
     3628       v-subGift = v-subGifts:promoGiftObjCurr .
     3629       run bgelib-tag-open in this-procedure ( input 3, input "PAGiftGoods","").
     3630       run bgelib-tag-put in this-procedure ( input 4, input "PAGGId":U
     3631         , input string(v-promo-action:id), input 1 ).
