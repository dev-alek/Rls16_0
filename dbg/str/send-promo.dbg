     5222   run bgelib-tag-close in this-procedure ( input 2, input "PromoAction").
     5223               if ub.PromoAction.typecond = 4 and action = "U":U then
     5224               do:
     5225   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
