     5647                     ,input "data":U
     5648                     ,input v-xml-file-name
     5649                     ,input-output v-view-log
     5650                     ) no-error .
     5651       if error-status:error then do:
     5652         run write-log-and-file in p-log-handle (
     5653               input 1
     5654             , input log-file-name
     5655             , input 1
     5656             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     5657                                   ,for-cash-desk.obj-code
     5658                                   ,for-cash-desk.cash-num
     5659                               )
     5660                                               ).
     5661         assign
     5662         v-view-log = yes
     5663         .
     5664       end.
     5665     end.
     5666   end.
     5667   if g#news
     5668   or g#auto
     5669   or g#esys
     5670   and for-cash-desk.pos-type = 'MAGIA-XML':U
     5671   then do:
     5672   end.
     5673     end.
     5674   END CASE.
     5675   END .
     5676   END PROCEDURE.
     5677   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5678   PROCEDURE SENDING:
     5679   DEFINE VARIABLE fq as integer no-undo .
     5680   define variable glog as logical no-undo .
     5681   FOR EACH ub.cash-desk NO-LOCK WHERE
     5682            ub.cash-desk.db-num = g#db-num
     5683        AND ub.cash-desk.obj-code = i-obj-code
     5684        and ub.cash-desk.pos-type = 'IBM-XML':U
     5685        AND ub.cash-desk.cash-on
     5686   BREAK
     5687   By ub.cash-desk.pos-type :
     5688     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     5689   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5690   define variable dflt-cd35 as character no-undo .
     5691   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5692   define variable v-param-type36 as character no-undo .
     5693   define variable v-value-date36 as date no-undo .
     5694   define variable v-value-decimal36 as decimal no-undo .
     5695   define variable v-value-integer36 as INTEGER no-undo .
     5696   define variable v-value-logical36 AS LOGICAL no-undo .
     5697   define variable v-tth36 as handle no-undo .
     5698   run adm/shattri.p (
     5699       input "get":U
     5700       ,input  'маг':U
     5701       ,input  ub.cash-desk.obj-code
     5702       ,input  'cd-sending':U
     5703       ,input  'dflt-cd':U
     5704       ,output dflt-cd35
     5705       ,output v-value-date36
     5706       ,output v-value-decimal36
     5707       ,output v-value-integer36
     5708       ,output v-value-logical36
     5709       ,output v-param-type36
     5710       ,INPUT-OUTPUT table-handle v-tth36
     5711       ) no-error .
     5712   delete object v-tth36 no-error.
     5713   case ub.cash-desk.pos-type:
     5714       when 'IBM-XML':U or when 'Autotank':U
     5715     then do:
     5716   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5717   run str/get-inis.p (
     5718                   input 'маг':U
     5719                 , input ub.cash-desk.obj-code
     5720                 , input ub.cash-desk.pos-type
     5721                 , input cash-desk.remote
     5722                 , input "send":U
     5723                 , output out
     5724                 , output out2
     5725                 , output in_
     5726                 , output spl
     5727                 , output sav
     5728                 , output v-remote
     5729                 )  no-error .
     5730   if error-status:error then do:
     5731     run write-log-and-file in p-log-handle (
     5732           input 1
     5733         , input log-file-name
     5734         , input 1
     5735         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     5736                             , ub.cash-desk.pos-type
     5737                             , ub.cash-desk.obj-code
     5738                             , chr(10)
     5739                             , error-status:get-message(1)
     5740                             , return-value )).
     5741     assign
     5742     v-view-log = yes.
     5743     return error.
     5744   end.
     5745   if ub.cash-desk.pos-type = 'IBM-XML':U
     5746   or ub.cash-desk.pos-type = 'Autotank':U
     5747   then do:
     5748     file-info:file-name = (out  + "undelivered").
     5749     if file-info:FULL-PATHNAME <> ? then do:
     5750       run str/rsndxibm.p ( input parparentproc
     5751                           ,input p-parent-handle
     5752                           ,input p-log-handle
     5753                           ,input out  + "undelivered" ) no-error.
     5754     end.
     5755   end.
     5756     if ub.cash-desk.pos-type = 'IBM-XML':U
     5757     then do:
     5758     run adm/shattri.p (
     5759         input "get":U
     5760         ,input  'маг':U
     5761         ,input  ub.cash-desk.obj-code
     5762         ,input  'cd-type-IBM-XML':U
     5763         ,input  'ibmrubc':U
     5764         ,output v-value-character
     5765         ,output v-value-date
     5766         ,output v-value-decimal
     5767         ,output v-value-integer
     5768         ,output v-value-logical
     5769         ,output v-param-type
     5770         ,INPUT-OUTPUT table-handle v-tth
     5771         ) no-error .
     5772       IF not error-status:error then do:
     5773         delete object v-tth.
     5774         kassa-rub-code = v-value-integer.
     5775       end.
     5776       else do:
     5777         delete object v-tth.
     5778         return error return-value .
     5779       end.
     5780     end.
     5781     else do:
     5782       kassa-rub-code = 0.
     5783     end.
     5784     if ub.cash-desk.pos-type = 'IBM-XML':U then do:
     5785       run adm/shattri.p (
     5786           input "get":U
     5787           ,input  'маг':U
     5788           ,input  ub.cash-desk.obj-code
     5789           ,input  'cd-type-IBM-XML':U
     5790           ,input  'ibmnalc':U
     5791           ,output v-value-character
     5792           ,output v-value-date
     5793           ,output v-value-decimal
     5794           ,output v-value-integer
     5795           ,output v-value-logical
     5796           ,output v-param-type
     5797           ,INPUT-OUTPUT table-handle v-tth
     5798           ) no-error .
     5799       IF not error-status:error then do:
     5800         delete object v-tth.
     5801         ibmnalc = v-value-integer.
     5802       end.
     5803       else do:
     5804         delete object v-tth.
     5805         return error return-value .
     5806       end.
     5807       multicurr = no.
     5808       run adm/shattri.p (
     5809           input "get":U
     5810           ,input  'маг':U
     5811           ,input  ub.cash-desk.obj-code
     5812           ,input  'cd-type-IBM-XML':U
     5813           ,input  'multicurr':U
     5814           ,output v-value-character
     5815           ,output v-value-date
     5816           ,output v-value-decimal
     5817           ,output v-value-integer
     5818           ,output v-value-logical
     5819           ,output v-param-type
     5820           ,INPUT-OUTPUT table-handle v-tth
     5821           ) no-error .
     5822         delete object v-tth.
     5823         multicurr = v-value-logical.
     5824     end.
     5825     end.
     5826   END CASE.
     5827       RUN for-cash-cycle no-error.
     5828     END.
     5829     IF LAST-OF(ub.cash-desk.pos-type) then do:
     5830   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5831   case ub.cash-desk.pos-type:
     5832   END CASE.
     5833     END.
     5834   END.
     5835   END PROCEDURE.
     5836   assign
     5837     log-file-name = p-log-file-name
     5838     .
     5839   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5841     (input  'маг':U
     5842     ,input  i-obj-code
     5843     ,output v-host-code
     5844     )  .
     5845   if action = "D" and not g#esys and not g#news and selective <> 1
     5846     then
     5847   do:
     5848     message
     5849       "Вы действительно хотите удалить с кассы записи промоакций?"
     5850       view-as alert-box QUESTION buttons YES-NO update glog.
     5851     if not glog then return.
     5852   end.
     5853   if action = 'D':U then
     5854   do:
     5855     assign
     5856       v-cp-is-use = no.
     5857   end.
     5858   if action <> 'D':U then
     5859   do:
     5860   end.
     5861   RUN SENDING no-error.
     5862   if error-status:error then
     5863   do:
     5864     run write-log-and-file in p-log-handle (
     5865       input 1
     5866       , input log-file-name
     5867       , input 1
     5868       , input substitute( "!!!Ошибки при отсылке промоакций на кассы  маг&1:&2&3 &4"
     5869       , i-obj-code
     5870       , chr(10)
     5871       , error-status:get-message(1)
     5872       , return-value
     5873       )
     5874       ).
     5875     assign
     5876       v-view-log = yes
     5877       .
     5878   end.
     5879   run write-log-and-file in p-log-handle (
     5880     input 1
     5881     , input log-file-name
     5882     , input 1
     5883     , input substitute("Сформированы файлы для касс объекта &1&2", 'маг':U, i-obj-code)
     5884     ).
