     2331       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2332       define output parameter p-exist   as logical  no-undo .
     2333       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2334       define variable v-type           as character no-undo .
     2335       define variable v-format         as character no-undo .
     2336       define variable v-label          as character no-undo .
     2337       define variable v-range          as integer   no-undo .
     2338       define variable v-user-can-edit  as logical   no-undo .
     2339       define variable v-output-display as logical   no-undo .
     2340       define variable v-other          as character no-undo .
     2341       run cp-attr-code in this-procedure
     2342         (input  p-code
     2343         ,output v-type
     2344         ,output v-format
     2345         ,output v-label
     2346         ,output v-range
     2347         ,output v-user-can-edit
     2348         ,output v-output-display
     2349         ,output v-other
     2350         ) no-error .
     2351       if error-status :error then do:
     2352         undo, return error return-value .
     2353       end.
     2354       find first buf_cash-pay-attr exclusive-lock
     2355         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2356           and buf_cash-pay-attr.curr-code  = p-curr-code
     2357           and buf_cash-pay-attr.host-code  = p-host-code
     2358           and buf_cash-pay-attr.obj-type   = p-obj-type
     2359           and buf_cash-pay-attr.obj-code   = p-obj-code
     2360           and buf_cash-pay-attr.attr-code = p-code
     2361         no-error .
     2362       if  available buf_cash-pay-attr then do:
     2363         p-exist = yes.
     2364       end.
     2365     end.
     2366   end procedure.
     2367   procedure cp-attr-delete :
     2368     do
     2369     on error undo, return error
     2370     :
     2371       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2372       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2373       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2374       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2375       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2376       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2377       define output parameter p-deleted  as logical no-undo.
     2378       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2379       define variable v-type           as character no-undo .
     2380       define variable v-format         as character no-undo .
     2381       define variable v-label          as character no-undo .
     2382       define variable v-range          as integer   no-undo .
     2383       define variable v-user-can-edit  as logical   no-undo .
     2384       define variable v-output-display as logical   no-undo .
     2385       define variable v-other          as character no-undo .
     2386       run cp-attr-code in this-procedure
     2387         (input  p-code
     2388         ,output v-type
     2389         ,output v-format
     2390         ,output v-label
     2391         ,output v-range
     2392         ,output v-user-can-edit
     2393         ,output v-output-display
     2394         ,output v-other
     2395         ) no-error .
     2396       if error-status :error then do:
     2397         undo, return error return-value .
     2398       end.
     2399       find first buf_cash-pay-attr exclusive-lock
     2400         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2401           and buf_cash-pay-attr.curr-code  = p-curr-code
     2402           and buf_cash-pay-attr.host-code  = p-host-code
     2403           and buf_cash-pay-attr.obj-type   = p-obj-type
     2404           and buf_cash-pay-attr.obj-code   = p-obj-code
     2405           and buf_cash-pay-attr.attr-code = p-code
     2406         no-error NO-WAIT.
     2407       if not available buf_cash-pay-attr then do:
     2408         p-deleted = no.
     2409       end.
     2410       else do:
     2411         delete buf_cash-pay-attr no-error .
     2412         if error-status:error then do:
     2413           undo, return error return-value .
     2414         end.
     2415         p-deleted = yes.
     2416       end.
     2417     end.
     2418   end procedure.
     2419   procedure cp-attr-news :
     2420     do
     2421     on error undo, return error
     2422     :
     2423       define input  parameter p-code           as character no-undo .
     2424       define output parameter p-news           as logical   no-undo .
     2425       case p-code :
     2426               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     2427               when 'grp-code':U then do:     assign     p-news = true.   end.
     2428               when 'is-use':U then do:     assign     p-news = true.   end.
     2429               when 'dop-doc':U then do:     assign     p-news = true.   end.
     2430               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     2431               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     2432               when 'form_km3':U then do:     assign     p-news = false.   end.
     2433               when 'bal_malina':U then do:     assign     p-news = false.   end.
     2434               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     2435               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     2436         otherwise do:
     2437           p-news = no.
     2438         end.
     2439       end.
     2440     end.
     2441   end procedure.
