     1569   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1570   define variable v-is-closed-shift-journal as integer no-undo .
     1571   assign
     1572   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1573                               +
     1574                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1575                               +
     1576                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1577   .
     1578   return v-is-closed-shift-journal.
     1579   END FUNCTION.
     1580   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1581   define variable v-is-first-journal as logical no-undo .
     1582   assign
     1583   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1584                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1585                     or (p-journal-num =  integer(entry(1, '17':U)))
     1586                     or (p-journal-num = integer(entry(1, '16':U)))
     1587   .
     1588   return v-is-first-journal.
     1589   END FUNCTION.
     1590   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1591   define variable v-is-petrol-journal as logical no-undo .
     1592   assign
     1593   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1594   return v-is-petrol-journal.
     1595   END FUNCTION.
     1596   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1597   define variable v-max-record-num as integer no-undo .
     1598   assign
     1599   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1600                       then 1489
     1601                       else 2340).
     1602   return v-max-record-num.
     1603   END FUNCTION.
     1604   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1605   define variable v-max-record-num as integer no-undo .
     1606   assign
     1607   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1608                       then 1489 * num-entries('30,31,32,33':U)
     1609                       else 2340 * num-entries('17':U)).
     1610   return v-max-record-num.
     1611   END FUNCTION.
     1612   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1613                                           ,input p-rec-no as integer):
     1614   define variable v-num-recs as integer no-undo .
     1615   if tekka-is-petrol-journal (p-journal-num) then do:
     1616     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1617       assign
     1618       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1619       .
     1620     end.
     1621     else do:
     1622       assign
     1623       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1624       .
     1625     end.
     1626   end.
     1627   else do:
     1628     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1629       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1630         assign
     1631         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1632         .
     1633       end.
     1634       else do:
     1635         assign
     1636         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1637         .
     1638       end.
     1639     end.
     1640     else do:
     1641       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1642         assign
     1643         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1644         .
     1645       end.
     1646       else do:
     1647         assign
     1648         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1649         .
     1650       end.
     1651     end.
     1652   end.
     1653   return v-num-recs.
     1654   END FUNCTION.
     1655   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1656                                              ,input p-is-petrol as logical
     1657                                              ,input p-is-current as logical
     1658                                              ,output p-rec-no as decimal
     1659                                              ):
     1660   define variable v-obj-num0 as integer no-undo .
     1661   define variable v-obj-num as integer no-undo .
     1662   define variable v-obj-num2 as integer no-undo .
     1663   define variable p-num-recs2 as integer no-undo .
     1664   define variable p-rec-no2 as integer no-undo .
     1665   if p-is-petrol then do:
     1666     assign
     1667     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1668     .
     1669     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1670     then
     1671     assign
     1672     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1673     p-rec-no = p-num-recs modulo 1489
     1674     .
     1675     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1676     then
     1677     assign
     1678     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1679     p-rec-no = p-num-recs modulo 1489
     1680     .
     1681   end.
     1682   else do:
     1683     assign
     1684     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1685     p-num-recs = trunc(p-num-recs, 0)
     1686     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1687     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1688     .
     1689     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1690     then
     1691     assign
     1692     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1693     p-rec-no = p-num-recs modulo 2340
     1694     .
     1695     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1696     then
     1697     assign
     1698     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1699     p-rec-no = p-num-recs modulo 2340
     1700     .
     1701     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1702     then
     1703     assign
     1704     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1705     p-rec-no2 = p-num-recs2 modulo 2978
     1706     .
     1707     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1708     then
     1709     assign
     1710     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1711     p-rec-no2 = p-num-recs2 modulo 2978
     1712     .
     1713     assign
     1714     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1715     .
     1716   end.
     1717   if v-obj-num = 0 then v-obj-num = 100.
     1718   return v-obj-num.
     1719   END FUNCTION.
     1720   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1721   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1722   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1723      if p-is-ptrl then
     1724      return integer(entry(1, '26,27,28,29':U)).
     1725      if not p-is-ptrl then
     1726      return integer(entry(1, '16':U)).
     1727   end.
     1728   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1729   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1730   return 0.
     1731   END FUNCTION.
     1732   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1733   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1734   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1735     if p-is-ptrl then
     1736     return integer(entry(1, '26,27,28,29':U)).
     1737     if not p-is-ptrl then
     1738     return integer(entry(1, '16':U)).
     1739   end.
     1740   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1741   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1742   return 0.
     1743   END FUNCTION.
     1744   PROCEDURE maria-put:
     1745   define parameter buffer buf_cash-desk for ub.cash-desk.
     1746   define input parameter p-out    as character no-undo .
     1747   define input parameter p-fname as character no-undo .
     1748   define input parameter p-by-record as logical no-undo .
     1749   define input parameter p-shift-fields as integer no-undo .
     1750   define input parameter p-binary as logical no-undo .
     1751   define input parameter p-obj-num as integer no-undo .
     1752   define input parameter p-max-records as integer no-undo .
     1753   define input parameter p-plu as integer no-undo .
     1754   define input parameter p-value as character no-undo .
     1755   define variable v-file-name as character no-undo .
     1756   define variable v-create as logical no-undo .
     1757   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1758   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1759   output stream IBMSTREAM
     1760   to value(v-file-name) append .
     1761   Put  stream IBMSTREAM unformatted
     1762   p-plu
     1763   chr(3)
     1764   p-value
     1765   skip.
     1766   output stream IBMSTREAM
     1767   close.
     1768   if not p-by-record then do:
     1769     find first buf_temp-tekka-tsk where
     1770               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1771     if not available buf_temp-tekka-tsk then do:
     1772       v-create = yes.
     1773     end.
     1774   end.
     1775   else do:
     1776     find first buf_temp-tekka-tsk where
     1777               buf_temp-tekka-tsk.filename  = v-file-name
     1778           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1779     if not available buf_temp-tekka-tsk
     1780     then do:
     1781       find first buf_temp-tekka-tsk where
     1782                 buf_temp-tekka-tsk.filename  = v-file-name
     1783             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1784       if not available buf_temp-tekka-tsk
     1785       then do:
     1786         v-create = yes.
     1787       end.
     1788     end.
     1789   end.
     1790   if v-create then do:
     1791     create buf_temp-tekka-tsk.
     1792     assign
     1793     buf_temp-tekka-tsk.filename = v-file-name
     1794     buf_temp-tekka-tsk.range    = p-plu
     1795     buf_temp-tekka-tsk.obj-num = p-obj-num
     1796     buf_temp-tekka-tsk.obj-name = '':U
     1797     buf_temp-tekka-tsk.num-records = 0
     1798     buf_temp-tekka-tsk.max-records = p-max-records
     1799     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1800     buf_temp-tekka-tsk.task-num = p-fname
     1801     buf_temp-tekka-tsk.by-record = p-by-record
     1802     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1803     buf_temp-tekka-tsk.binary = p-binary
     1804     buf_temp-tekka-tsk.send-get = 'send'
     1805     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1806     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1807     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1808     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1809                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1810                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1811                                 then 'local'
     1812                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1813     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1814     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1815     buf_temp-tekka-tsk.waiting-sek = 30
     1816     buf_temp-tekka-tsk.min-plu     = p-plu
     1817     buf_temp-tekka-tsk.max-plu     = p-plu
     1818     .
     1819   end.
     1820   assign
     1821   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1822   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1823   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1824   .
     1825   END PROCEDURE.
     1826   PROCEDURE maria-get:
     1827   define parameter buffer buf_cash-desk for ub.cash-desk.
     1828   define input parameter p-out    as character no-undo .
     1829   define input parameter p-fname as character no-undo .
     1830   define input parameter p-by-record as logical no-undo .
     1831   define input parameter p-obj-num as integer no-undo .
     1832   define input parameter p-num-fields as integer no-undo .
     1833   define input parameter p-max-records as integer no-undo .
     1834   define input parameter p-min-plu as integer no-undo .
     1835   define input parameter p-max-plu as integer no-undo .
     1836   define input parameter p-other as character no-undo .
     1837   define input parameter p-order-num as integer no-undo .
     1838   define variable v-file-name as character no-undo .
     1839   define variable v-secondary-obj-num as character no-undo .
     1840   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1841   if p-by-record then do:
     1842     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1843   end.
     1844   else do:
     1845     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1846   end.
     1847   find first buf_temp-tekka-tsk where
     1848             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1849   if not available buf_temp-tekka-tsk then do:
     1850     create buf_temp-tekka-tsk.
     1851     assign
     1852     buf_temp-tekka-tsk.filename = v-file-name
     1853     buf_temp-tekka-tsk.obj-num = p-obj-num
     1854     buf_temp-tekka-tsk.obj-name = '':U
     1855     buf_temp-tekka-tsk.max-records = p-max-records
     1856     buf_temp-tekka-tsk.num-fields = p-num-fields
     1857     buf_temp-tekka-tsk.task-num = p-fname
     1858     buf_temp-tekka-tsk.by-record = p-by-record
     1859     buf_temp-tekka-tsk.send-get = 'get'
     1860     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1861     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1862     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1863     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1864                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1865                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1866                                   then 'local'
     1867                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1868     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1869     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1870     buf_temp-tekka-tsk.waiting-sek = 30
     1871     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1872     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1873     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1874                                       and p-max-plu <> ?
     1875                                       then p-max-plu - p-min-plu + 1
     1876                                       else 0)
     1877     buf_temp-tekka-tsk.other-info = p-other
     1878     buf_temp-tekka-tsk.order-num = p-order-num
     1879     .
     1880     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1881       assign
     1882       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1883       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1884       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1885       no-error
     1886       .
     1887       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1888     end.
     1889   end.
     1890   END PROCEDURE.
     1891   PROCEDURE maria-task:
     1892   define parameter buffer buf_cash-desk for ub.cash-desk.
     1893   define input parameter p-fname as character no-undo .
     1894   define input parameter p-obj-num-list as character no-undo .
     1895   define input parameter p-parameters as character no-undo .
     1896   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1897   find first buf_temp-tekka-tsk where
     1898             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1899   if not available buf_temp-tekka-tsk then do:
     1900     create buf_temp-tekka-tsk.
     1901     assign
     1902     buf_temp-tekka-tsk.filename = ''
     1903     buf_temp-tekka-tsk.range = 1
     1904     buf_temp-tekka-tsk.obj-num = 0
     1905     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1906     buf_temp-tekka-tsk.task-num = p-fname
     1907     buf_temp-tekka-tsk.by-record = no
     1908     buf_temp-tekka-tsk.send-get = 'task'
     1909     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1910     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1911     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1912     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1913                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1914                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1915                                   then 'local'
     1916                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1917     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1918     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1919     buf_temp-tekka-tsk.waiting-sek = 30
     1920     buf_temp-tekka-tsk.other-info = p-parameters
     1921     buf_temp-tekka-tsk.order-num = 0
     1922     .
     1923   end.
     1924   END PROCEDURE.
     1925   procedure tekkatsk-verify-schema :
     1926   define input parameter p-obj-list as character no-undo .
     1927   define input parameter p-dir-path as character no-undo .
     1928   define variable v-obj-num as integer no-undo .
     1929   define variable v-obj-name as character no-undo .
     1930   define variable v-num-records as integer no-undo .
     1931   define variable v-size_ as integer no-undo .
     1932   define variable v-value as character no-undo .
     1933   define variable ii as integer no-undo .
     1934   define variable jj as integer no-undo .
     1935   define variable ii-ibs as integer no-undo .
     1936   define variable ii-tekka as integer no-undo .
     1937   define variable v-result as character no-undo .
     1938   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1939   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1940     do
     1941     on error undo, return error
     1942     :
     1943        for each buf_temp-tekka-schema:
     1944          delete buf_temp-tekka-schema.
     1945        end.
     1946        input from value('tekkasch.d').
     1947        repeat :
     1948          create buf_temp-tekka-schema.
     1949          import buf_temp-tekka-schema.
     1950          assign
     1951          buf_temp-tekka-schema.host = 'IBS'
     1952          ii = ii + 1.
     1953          .
     1954        end.
     1955        input close.
     1956        ii-ibs = ii.
     1957         _ii:
     1958         do ii = 1 to 256:
     1959           if p-obj-list = "ALL"
     1960           or lookup(string(ii), p-obj-list) > 0 then do:
     1961             assign
     1962             v-obj-num = 0
     1963             v-obj-name = ''
     1964             v-num-records = 0
     1965             v-size_ = 0
     1966             .
     1967             run alienini-getkey in this-procedure (
     1968                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1969                                                     ,input ('obj' + string(ii, '999'))
     1970                                                     ,input 'oname'
     1971                                                     ,output v-value) no-error .
     1972             if v-value = ? then next _ii.
     1973             assign
     1974             v-obj-num = ii
     1975             v-obj-name = v-value
     1976             .
     1977             run alienini-getkey in this-procedure (
     1978                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1979                                                     ,input ('obj' + string(ii, '999'))
     1980                                                     ,input 'size'
     1981                                                     ,output v-value) no-error .
     1982             assign
     1983             v-num-records = integer(v-value) no-error  .
     1984             if error-status:error
     1985             or v-num-records = 0 then next _ii.
     1986             run alienini-getkey in this-procedure (
     1987                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1988                                                     ,input 'obj' + string(ii, '999')
     1989                                                     ,input 'f000'
     1990                                                     ,output v-value) no-error .
     1991             assign
     1992             v-size_ = integer(v-value) no-error  .
     1993             if error-status:error
     1994             or v-size_ = 0 then next _ii.
     1995             _jj:
     1996             do jj = 1 to 256:
     1997               run alienini-getkey in this-procedure (
     1998                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1999                                                       ,input 'obj' + string(ii, '999')
     2000                                                       ,input 'f' + string(jj, '999')
     2001                                                       ,output v-value) no-error .
     2002               if v-value = ? then next _ii.
     2003               create buf_temp-tekka-schema.
     2004               assign
     2005               buf_temp-tekka-schema.host = 'tekka'
     2006               buf_temp-tekka-schema.obj-num = v-obj-num
     2007               buf_temp-tekka-schema.obj-name = v-obj-name
     2008               buf_temp-tekka-schema.num-records = v-num-records
     2009               buf_temp-tekka-schema.size_ = v-size_
     2010               buf_temp-tekka-schema.field-num = jj
     2011               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2012               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2013                                                  then entry(2, entry(2, v-value, '#'), ':')
     2014                                                  else '':U)
     2015               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2016               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2017               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2018                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2019               no-error
     2020               .
     2021               if error-status:error then do:
     2022                 delete buf_temp-tekka-schema.
     2023                 next _jj.
     2024               end.
     2025               run alienini-getkey in this-procedure (
     2026                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2027                                                       ,input 'obj' + string(ii, '999') + 'name'
     2028                                                       ,input 'n' + string(jj, '999')
     2029                                                       ,output v-value) no-error .
     2030               if v-value <> ? then
     2031               buf_temp-tekka-schema.field-name = v-value.
     2032             end.
     2033           end.
     2034         end.
     2035         ii-tekka = ii - 1.
     2036        if p-obj-list <> 'ALL' then do:
     2037         if ii-tekka <> ii-ibs then do:
     2038           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2039                                   , ii-ibs
     2040                                   , ii-tekka).
     2041         end.
     2042        end.
     2043        for each buf_temp-tekka-schema where
     2044               buf_temp-tekka-schema.host = 'tekka':
     2045          find first buf2_temp-tekka-schema where
     2046                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2047                AND buf2_temp-tekka-schema.host = 'ibs'
     2048                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2049          if not available buf2_temp-tekka-schema then do:
     2050           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2051                                   , buf_temp-tekka-schema.field-num
     2052                                   , buf_temp-tekka-schema.obj-num).
     2053          end.
     2054          buffer-compare buf_temp-tekka-schema
     2055          to buf2_temp-tekka-schema
     2056          save result in v-result.
     2057          if v-result <> '':U then do:
     2058           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2059                                   , buf_temp-tekka-schema.field-num
     2060                                   , buf_temp-tekka-schema.obj-num).
     2061          end.
     2062        end.
     2063     end.
     2064   end procedure.
     2065   FUNCTION set-Sx returns character (input p-string as character):
     2066   return p-string.
     2067   END FUNCTION.
     2068   FUNCTION get-Sx returns character (input p-string  as character):
     2069   return p-string.
     2070   END FUNCTION.
     2071   FUNCTION set-B returns character (input p-string  as character):
     2072   return chr(integer(p-string)).
     2073   END FUNCTION.
     2074   FUNCTION get-B returns character (input p-string  as character):
     2075   return string(asc(p-string)).
     2076   END FUNCTION.
     2077   FUNCTION set-BF returns character (input p-string  as character):
     2078   define variable v-dopi as integer no-undo .
     2079   define variable ii as integer no-undo .
     2080   do ii = 1 to 8:
     2081     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2082   end.
     2083   return chr(v-dopi).
     2084   END FUNCTION.
     2085   FUNCTION get-BF returns character (input p-string  as character):
     2086   define variable v-dopi as integer no-undo .
     2087   define variable v-dops as character no-undo .
     2088   define variable ii as integer no-undo .
     2089   v-dopi = asc(p-string).
     2090   do ii = 8 to 1 BY -1:
     2091     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2092   end.
     2093   return v-dops.
     2094   END FUNCTION.
     2095   FUNCTION set-BN returns character (input p-string  as character
     2096                                     ,input p-bin-group as character):
     2097   define variable v-dopi as integer no-undo .
     2098   define variable ii as integer no-undo .
     2099   define variable jj as integer no-undo .
     2100   define variable v-grp-nums as integer no-undo .
     2101   define variable v-dopi2 as integer no-undo .
     2102   v-grp-nums = num-entries(p-bin-group).
     2103   do jj = 0 to v-grp-nums - 1:
     2104     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2105     do ii = 1 to 8:
     2106       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2107     end.
     2108   end.
     2109   return chr(v-dopi).
     2110   END FUNCTION.
     2111   FUNCTION get-BN returns character (input p-string  as character
     2112                                     ,input p-bin-group as character):
     2113   define variable v-dopi as integer no-undo .
     2114   define variable v-dops as character no-undo .
     2115   define variable v-grp-nums as integer no-undo .
     2116   define variable ii as integer no-undo .
     2117   define variable jj as integer no-undo .
     2118   v-dopi = asc(p-string).
     2119   v-grp-nums = num-entries(p-bin-group).
     2120   do jj = 1 to v-grp-nums:
     2121   do ii = 8 to 1 BY -1:
     2122     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2123   end.
     2124   end.
     2125   return v-dops.
     2126   END FUNCTION.
     2127   procedure fill-temp-cd :
     2128   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2129   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2130   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2131   define input parameter p-clear-table as logical no-undo .
     2132   define buffer buf_temp-cd for temp-cd.
     2133   define buffer buf_cash-desk for ub.cash-desk.
     2134     do
     2135     on error undo, return error
     2136     :
     2137        if p-clear-table  then do:
     2138          for each buf_temp-cd:
     2139            delete buf_temp-cd.
     2140          end.
     2141        end.
     2142        for each buf_cash-desk no-lock where
     2143               buf_cash-desk.db-num = p-db-num
     2144           AND buf_cash-desk.obj-code = p-obj-code
     2145           and buf_cash-desk.cash-on  = yes
     2146        BREAK by buf_cash-desk.pos-type:
     2147          if first-of(buf_cash-desk.pos-type) then do:
     2148            create buf_temp-cd.
     2149            buffer-copy buf_cash-desk to buf_temp-cd.
     2150          end.
     2151        end.
     2152     end.
     2153   end procedure.
     2154   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2155   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2156   procedure cp-attr-code :
     2157     do
     2158     on error undo, return error
     2159     :
     2160       define input  parameter p-code           as character no-undo .
     2161       define output parameter p-type           as character no-undo .
     2162       define output parameter p-format         as character no-undo .
     2163       define output parameter p-label          as character no-undo .
     2164       define output parameter p-range          as integer   no-undo .
     2165       define output parameter p-user-can-edit  as logical   no-undo .
     2166       define output parameter p-output-display as logical   no-undo .
     2167       define output parameter p-other          as character no-undo .
     2168       case p-code :
     2169               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2170               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     2171               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     2172               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     2173               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2174               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     2175               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2176               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2177               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2178               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     2179         otherwise do:
     2180           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     2181         end.
     2182       end.
     2183     end.
     2184   end procedure.
     2185   procedure cp-attr-tooltip :
     2186     do
     2187     on error undo, return error
     2188     :
     2189       define input  parameter p-code    as character no-undo .
