     1277   procedure xml-cd-write-header:
     1278   do
     1279   on error undo, return error
     1280   :
     1281   define input parameter p-xml-file-name       as character    no-undo.
     1282   define input parameter p-xml-file-name-path  as character    no-undo.
     1283   define input parameter p-doc-name            as character    no-undo.
     1284   define input parameter p-version             as character    no-undo.
     1285   define input parameter p-obj-list            as character    no-undo.
     1286   define input parameter p-correspondent       as character    no-undo .
     1287   define input parameter p-write-header        as logical      no-undo .
     1288   define variable OS-time as character no-undo .
     1289   define variable id as character no-undo .
     1290   define buffer buf_db for ub.db.
     1291   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1292   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1293   assign
     1294   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1295   .
     1296   run bgelib-tag-open in this-procedure (
     1297                                        1
     1298                                       ,p-doc-name
     1299                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1300                                         ).
     1301   if p-write-header then do:
     1302     run bgelib-tag-open(2, "Header","").
     1303     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1304     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1305     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1306     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1307     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1308     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1309     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1310     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1311     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1312     run bgelib-tag-close( 2, "Header" ).
     1313   end.
     1314   output stream stmXMLOut close.
     1315   end.
     1316   end procedure.
     1317   procedure xml-cd-write-footer:
     1318   do
     1319   on error undo, return error
     1320   :
     1321   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1322   define input parameter p-xml-file-name as character    no-undo.
     1323   define input parameter p-doc-name      as character    no-undo .
     1324   define variable v-error-num     as integer           no-undo.
     1325   define variable v-md5-signature as character no-undo .
     1326   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1327   run bgelib-tag-close( 0, p-doc-name ).
     1328   put stream stmXMLOut unformatted skip.
     1329   output stream stmXMLOut close.
     1330   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1331   if v-error-num > 0
     1332   then do:
     1333      return error.
     1334   end.
     1335   if opsys = "unix"
     1336   then do:
     1337       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1338   end.
     1339   end.
     1340   end procedure.
     1341   procedure xml-cd-filename :
     1342   do
     1343   on error undo, return error
     1344   :
     1345   define input parameter  p-out               as character no-undo .
     1346   define output parameter p-xml-file-name     as character    no-undo.
     1347   define output parameter p-xml-file-name-path   as character    no-undo.
     1348   define output parameter p-log-file-name     as character    no-undo.
     1349   define output parameter p-locked            as logical      no-undo.
     1350   define variable v-out as character     no-undo.
     1351   define variable loc#log as logical no-undo .
     1352   define variable BadFlag as logical no-undo .
     1353   define variable fq as integer no-undo .
     1354   define variable v-remote as character no-undo .
     1355   assign
     1356   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1357   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1358   p-log-file-name = p-out + "actions.log"
     1359   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1360   .
     1361   end.
     1362   end procedure.
     1363   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1364   define variable v-date-str as character no-undo .
     1365   assign
     1366   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1367                string(Month(p-date), "99":U) + "-":U +
     1368                string(DAY(p-date), "99":U).
     1369   return v-date-str.
     1370   END FUNCTION.
     1371   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1372   define variable v-date-str as character no-undo .
     1373   assign
     1374   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1375                string(Month(p-date), "99":U) + "-":U +
     1376                string(DAY(p-date), "99":U) + chr(32) +
     1377                string(p-time, "HH:MM:SS").
     1378   return v-date-str.
     1379   END FUNCTION.
     1380   function string-to-date returns date ( input p-string  as character):
     1381     define variable v-date as date no-undo .
     1382     assign
     1383     v-date = date(integer(substring(p-string, 4, 2))
     1384                   ,integer(substring(p-string, 1, 2))
     1385                   ,integer(substring(p-string, 7, 4))
     1386                  ) no-error .
     1387     if error-status:error then return ?.
     1388     return v-date.
     1389   END FUNCTION.
     1390   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1391   define variable v-time as integer no-undo init ?.
     1392   define variable v-dop1 as character no-undo .
     1393   define variable v-dop2 as character no-undo .
     1394   assign
     1395   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1396   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1397   no-error .
     1398   if error-status:error then return ?.
     1399   assign
     1400   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1401             integer(entry(2, v-dop2, ";":U)) * 60 +
     1402             integer(entry(3, v-dop2, ";":U)) no-error .
     1403   return v-time.
     1404   END FUNCTION.
