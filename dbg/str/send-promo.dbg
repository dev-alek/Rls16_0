     4504             , input v-subGood:dtSeason, input 1 ).
     4505         end.
     4506         else
     4507         do:
     4508           find first ub.PromoAttr no-lock where ub.PromoAttr.tablename = "PromoGoods" and
     4509             ub.PromoAttr.attr-code = "bc-code" and
     4510             ub.PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     4511             ub.PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3))) and
     4512             v-subGood:GdsCode = integer(entry(3,ub.PromoAttr.p-key,chr(3))) no-error .
     4513           if available (ub.PromoAttr) then run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     4514               , input string(ub.PromoAttr.attr-value), input 1 ).
     4515           else run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     4516               , input string(v-subGood:GdsCode), input 1 ).
     4517         end.
     4518       end.
     4519       run bgelib-tag-put in this-procedure ( input 4, input "PAGPrice":U
     4520         , input string(v-subGood:price), input 0 ).
     4521       run bgelib-tag-close in this-procedure ( input 3, input "PAGoods").
     4522       if v-promo-action:typecond <> 4 then
     4523       do:
     4524         for each bar-code where bar-code.gds-code      eq v-subGood:GdsCode
     4525           and bar-code.b-code                       ne v-subGood:GdsCode
     4526           and bar-code.in-code                      eq ""
     4527           and bar-code.part-code                    eq ""
     4528           no-lock:
     4529           run bgelib-tag-open in this-procedure ( input 3, input "PAGoods","").
     4530           run bgelib-tag-put in this-procedure ( input 4, input "PAGId":U
     4531             , input string(v-promo-action:id), input 1 ).
     4532           run bgelib-tag-put in this-procedure ( input 4, input "PAGCode":U
     4533             , input string(bar-code.b-code), input 1 ).
     4534           if (    v-subGood:price ne 0
     4535             and v-subGood:price ne ?)
     4536             then
     4537           do:
     4538             run bgelib-tag-put in this-procedure ( input 4, input "PAGPrice":U
     4539               , input string(v-subGood:price * bar-code.cli-base-rate), input 0 ).
     4540           end.
     4541           run bgelib-tag-close in this-procedure ( input 3, input "PAGoods").
     4542         end.
     4543       end.
     4544     end.
     4545   end.
     4546   v-subGdCrs = v-promo-action:GoodsCrits .
