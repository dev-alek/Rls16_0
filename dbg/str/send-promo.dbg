     4558         , input if v-subGdCr:dtSeason = "" then string(v-subGdCr:GdsCode) else v-subGdCr:dtSeason, input 1 ).
     4559       run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     4560       for each bar-code where bar-code.gds-code       eq v-subGdCr:GdsCode
     4561         and bar-code.b-code         ne v-subGdCr:GdsCode
     4562         and bar-code.in-code        eq ""
     4563         and bar-code.part-code      eq ""
     4564         no-lock:
     4565         run bgelib-tag-open in this-procedure ( input 3, input "PAFreeGoods","").
     4566         run bgelib-tag-put in this-procedure ( input 4, input "PAFGId":U
     4567           , input string(v-promo-action:id), input 1 ).
     4568         run bgelib-tag-put in this-procedure ( input 4, input "PAFGCode":U
     4569           , input string(bar-code.b-code), input 1 ).
     4570         run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     4571       end.
     4572     end.
     4573     else
     4574     do:
     4575       run bgelib-tag-open in this-procedure ( input 3, input "PAFreeGoods","").
     4576       run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     4577     end.
     4578   end.
     4579   v-subcardbins= v-promo-action:CardsBin .
     4580   if valid-object (v-subcardbins) then
     4581   do:
     4582     if v-subcardbins:iCounter ne 0
     4583       then
     4584     do v-i = 1 to v-subcardbins:iCounter:
     4585       v-subcardbins:GetItem(v-i) .
     4586       v-subCardBin = v-subcardbins:promoGoodsObjCurr .
     4587       run bgelib-tag-open in this-procedure ( input 3, input "PAFreeGoods","").
     4588       run bgelib-tag-put in this-procedure ( input 4, input "PAFGId":U
     4589         , input string(v-promo-action:id), input 1 ).
     4590       run bgelib-tag-put in this-procedure ( input 4, input "PAFGCode":U
     4591         , input string(v-subCardBin:nameset), input 1 ).
     4592       run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     4593     end.
     4594   end.
     4595   if  valid-object (v-subGdCrs)    and v-subGdCrs   :iCounter eq 0
     4596     and valid-object (v-subcardbins) and v-subcardbins:iCounter eq 0
     4597     then
     4598   do:
     4599     run bgelib-tag-open in this-procedure ( input 3, input "PAFreeGoods","").
     4600     run bgelib-tag-close in this-procedure ( input 3, input "PAFreeGoods").
     4601   end.
     4602   v-subGifts = v-promo-action:Gifts .
     4603   if VALID-OBJECT (v-subGifts) then
     4604   do:
     4605     do v-i = 1 to v-subGifts:iCounter:
     4606       vgift = yes.
     4607       v-subGifts:GetItem(v-i).
     4608       v-subGift = v-subGifts:promoGiftObjCurr .
     4609       run bgelib-tag-open in this-procedure ( input 3, input "PAGiftGoods","").
     4610       run bgelib-tag-put in this-procedure ( input 4, input "PAGGId":U
     4611         , input string(v-promo-action:id), input 1 ).
     4612       run bgelib-tag-put in this-procedure ( input 4, input "PAGGCode":U
     4613         , input if v-subGift:dtSeason = "" then string(v-subGift:GdsCode) else v-subGift:dtSeason, input 1 ).
     4614       run bgelib-tag-put in this-procedure ( input 4, input "PAGGAmount":U
