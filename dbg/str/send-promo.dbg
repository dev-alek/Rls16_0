     5282           , input  string(ub.bar-code.cli-base-rate), input 1 ).
     5283         run bgelib-tag-close in this-procedure ( input 2, input "ItemBarCode") .
     5284       end.
     5285     end.
     5286   end.
     5287               end.
     5288             end.
     5289           end.
     5290         END.
     5291       end.
     5292     end.
