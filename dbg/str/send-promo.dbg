     5294   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5295   PROCEDURE   for-cash-cycle:
     5296      DEFINE VARIABLE v-dir-remote     as character no-undo .
