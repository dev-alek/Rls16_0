     4553       v-subGdCr = v-subGdCrs:promoGoodsObjCurr .
     4554       run bgelib-tag-open in this-procedure ( input 3, input "PAFreeGoods","").
     4555       run bgelib-tag-put in this-procedure ( input 4, input "PAFGId":U
     4556         , input string(v-promo-action:id), input 1 ).
