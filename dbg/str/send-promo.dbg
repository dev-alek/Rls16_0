     2201               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     2202               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     2203         otherwise do:
     2204           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     2205         end.
     2206       end.
     2207     end.
     2208   end procedure.
     2209   procedure cp-attr-value :
     2210     do
     2211     on error undo, return error
     2212     :
     2213       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2214       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2215       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2216       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2217       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2218       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     2219       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     2220       define output parameter p-type        as character no-undo .
     2221       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2222       define variable v-format         as character no-undo .
     2223       define variable v-label          as character no-undo .
     2224       define variable v-range          as integer   no-undo .
     2225       define variable v-user-can-edit  as logical   no-undo .
     2226       define variable v-output-display as logical   no-undo .
     2227       define variable v-other          as character no-undo .
     2228       run cp-attr-code in this-procedure
     2229         (input  p-code
     2230         ,output p-type
     2231         ,output v-format
     2232         ,output v-label
     2233         ,output v-range
     2234         ,output v-user-can-edit
     2235         ,output v-output-display
     2236         ,output v-other
     2237         ) no-error .
     2238       if error-status :error then do:
     2239         undo, return error return-value .
     2240       end.
     2241       find first buf_cash-pay-attr no-lock
     2242         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2243           and buf_cash-pay-attr.curr-code  = p-curr-code
     2244           and buf_cash-pay-attr.host-code  = p-host-code
     2245           and buf_cash-pay-attr.obj-type   = p-obj-type
     2246           and buf_cash-pay-attr.obj-code   = p-obj-code
     2247           and buf_cash-pay-attr.attr-code  = p-code
     2248         no-error .
     2249       if avail buf_cash-pay-attr then do:
     2250         assign
     2251           p-value =  buf_cash-pay-attr.attr-value
     2252         .
     2253       end.
     2254       else do:
     2255         assign
     2256           p-value = if p-type = 'L':U then "no":U else ""
     2257         .
     2258       end.
     2259     end.
     2260   end procedure.
     2261   procedure cp-attr-write :
     2262     do
     2263     on error undo, return error
     2264     :
     2265       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2266       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2267       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2268       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2269       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2270       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2271       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     2272       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2273       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     2274       define variable v-type           as character no-undo .
     2275       define variable v-format         as character no-undo .
     2276       define variable v-label          as character no-undo .
     2277       define variable v-range          as integer   no-undo .
     2278       define variable v-user-can-edit  as logical   no-undo .
     2279       define variable v-output-display as logical   no-undo .
     2280       define variable v-other          as character no-undo .
     2281       run cp-attr-code in this-procedure
     2282         (input  p-code
     2283         ,output v-type
     2284         ,output v-format
     2285         ,output v-label
     2286         ,output v-range
     2287         ,output v-user-can-edit
     2288         ,output v-output-display
     2289         ,output v-other
     2290         ) no-error .
     2291       if error-status :error then do:
     2292         undo, return error return-value .
     2293       end.
     2294       find first buf_cash-pay-attr exclusive-lock
     2295         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2296           and buf_cash-pay-attr.curr-code  = p-curr-code
     2297           and buf_cash-pay-attr.host-code  = p-host-code
     2298           and buf_cash-pay-attr.obj-type   = p-obj-type
     2299           and buf_cash-pay-attr.obj-code   = p-obj-code
     2300           and buf_cash-pay-attr.attr-code = p-code
     2301         no-error .
     2302       if not available buf_cash-pay-attr then do:
     2303         create buf_cash-pay-attr .
     2304         assign
     2305         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2306         buf_cash-pay-attr.curr-code  = p-curr-code
     2307         buf_cash-pay-attr.host-code  = p-host-code
     2308         buf_cash-pay-attr.obj-type   = p-obj-type
     2309         buf_cash-pay-attr.obj-code   = p-obj-code
     2310         buf_cash-pay-attr.attr-code = p-code
     2311         .
     2312       end.
     2313       assign
     2314         buf_cash-pay-attr.attr-value = p-value
     2315       .
     2316       release buf_cash-pay-attr no-error .
     2317       if error-status:error then do:
     2318         undo, return error return-value .
     2319       end.
     2320     end.
     2321   end procedure.
     2322   procedure cp-attr-exist :
     2323     do
     2324     on error undo, return error
     2325     :
     2326       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2327       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2328       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
