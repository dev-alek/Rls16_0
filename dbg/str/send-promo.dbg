     5257            , input trim(string( ub.goods.struct, "X(40)")), input 1 ).
     5258         find first country no-lock where country.alpha1 = ub.goods.alpha1 no-error.
     5259         if available country then
     5260            run bgelib-tag-put in this-procedure ( input 3, input "IBCCountry"
     5261               , input country.short-name, input 1 ).
