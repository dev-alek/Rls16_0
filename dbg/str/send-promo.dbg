     1517   field max-plu       as integer
     1518   field num-fields    as integer
     1519   field task-num      as character
     1520   field by-record     as logical
     1521   field send-get      as character
     1522   field cash-num      as integer
     1523   field cash-num-char as character
     1524   field port-num      as character
     1525   field way           as character
     1526   field is-script     as logical
     1527   field pswd          as character
     1528   field waiting-sek   as integer
     1529   field other-info    as character
     1530   field order-num     as integer
     1531   field secondary     as integer
     1532   field shift-fields  as integer
     1533   field binary        as logical
     1534   field range         as integer
