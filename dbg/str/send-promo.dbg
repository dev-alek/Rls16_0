     5193         for each bar-code where bar-code.gds-code       eq v-subPromoSetGood:GdsCode
     5194           and bar-code.b-code         ne v-subPromoSetGood:GdsCode
     5195           and bar-code.in-code        eq ""
     5196           and bar-code.part-code      eq ""
     5197           no-lock:
     5198           run bgelib-tag-open in this-procedure ( input 3, input "PASetGoods","").
     5199           run bgelib-tag-put in this-procedure ( input 4, input "PASGId":U
     5200             , input string(v-subPromoSetGood:idaction), input 1 ).
     5201           run bgelib-tag-put in this-procedure ( input 4, input "PASGCode":U
     5202             , input string(bar-code.b-code), input 1 ).
     5203           run bgelib-tag-put in this-procedure ( input 4, input "PASGNum":U
