        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: defc-gds.i $ $Revision: 47e5c2a27e63, 2885, rls $".
        3   DEFINE  TEMP-TABLE cash-gds no-undo
        4   FIELD gds-code          like ub.goods.gds-code
        5   FIELD artic             like ub.goods.artic
        6   FIELD producer-int      as integer
        7   FIELD b-code            like ub.bar-code.b-code
        8   FIELD b-str             like ub.prod-bc.b-str
        9   FIELD bc-on              like ub.prod-bc.bc-on
       10   FIELD gds-name          like ub.goods.gds-name
       11   FIELD gds-namelong      like ub.goods.gds-name
       12   FIELD gds-name1         like ub.goods.gds-name
       13   FIELD f-name            like ub.gds-prt.f-name
       14   FIELD unit-base         like ub.goods.unit-base
       15   FIELD unit-cli          like ub.bar-code.unit-cli
       16   FIELD cli-base-rate     like ub.bar-code.cli-base-rate
       17   FIELD std-discnt-rule   as integer
       18   FIELD temp-discnt-rule  as integer
       19   FIELD temp-discnt-method as character
       20   FIELD VAT-pc            like ub.doc-line.VAT-pc
       21   FIELD vat-code          like ub.tax-rate-gds.rate-code
       22   FIELD SLT-pc            like ub.doc-line.SLT-pc
       23   FIELD grp-code          like ub.goods.grp-code
       24   FIELD gds-stat          as integer FORMAT "999"
       25   FIELD wd-rule          as integer
       26   FIELD wgd-rule         as integer
       27   FIELD fp               as logical
       28   FIELD zp               as integer
       29   FIELD pp               as integer
       30   FIELD need-auth        as integer
       31   FIELD is-menu          as integer
       32   FIELD is-semi-finished as integer
       33   FIELD is-modificator   as integer
       34   FIELD DepartId         as integer
       35   FIELD fbr-grp-code-0   as integer
       36   FIELD fbr-grp-code     as integer
       37   FIELD office           as integer
       38   field office-type      as character
       39   FIELD CalculationMethod      as integer
       40   FIELD CalculationMethodRestr as integer
       41   FIELD price-sale       like ub.price-list.price-sale
       42   FIELD unit-type        like ub.units.type
       43   FIELD unit-cli-type    like ub.units.type
       44   FIELD tax-string       as char FORMAT "X(255)"
       45   FIELD qnty-discnt-rule as integer
       46   FIELD kat-discnt-rule  as integer
       47   FIELD kat-discnt-method as character
       48   FIELD date-discnt-rule as integer
       49   FIELD abs-discnt-rule  as integer
       50   FIELD tot-discnt-rule  as integer
       51   FIELD fact-qnty        like ub.gds-obj.fact-qnty
       52   FIELD free-qnty        like ub.gds-obj.free-qnty
       53   FIELD producer         as character format "X(40)"
       54   FIELD ingredient       as character format "X(40)"
       55   FIELD GTD              as character format "X(31)"
       56   FIELD alpha1           like ub.goods.alpha
       57   FIELD node-code        like ub.bar-code.node-code
       58   FIELD okei             like ub.units.okei
       59   FIELD kkt              as integer
       60   FIELD is-gas           as logical
       61   FIELD ptrl-as-good     as logical
       62   FIELD taracode         as character
       63   FIELD crf              as integer
       64   FIELD new-good         as logical
       65   FIELD rc               as recid
       66   FIELD obj-type         as character
       67   FIELD obj-code         as integer
       68   field is-main-code     as logical
       69   field bc-on-type       as character
       70   field main-prt-b-code  as integer
       71   field ean-lz as character
       72   field ean-rz as character
       73   field code-short as  character
       74   index pi is unique primary crf
       75   index bc b-code
       76   index pbc b-str
       77   index igds gds-code
       78   index mbc obj-type obj-code main-prt-b-code
       79   .
       80   define temp-table temp-dis-gds-rule no-undo
       81   like ub.dis-gds-rule.
       82   define temp-table cash-gds-discnt
       83   FIELD crf              as integer
       84   FIELD b-code            like ub.bar-code.b-code
       85   field discnt-value as decimal
       86   FIELD rule-num     as integer
       87   field obj-type     as character
       88   field obj-code     as integer
       89   index pi is unique primary crf
       90   index bc
       91   b-code
       92   obj-type
       93   obj-code
       94   rule-num
       95   .
       96   define input  parameter p-parameter   as character no-undo .
       97   define output parameter table for cash-gds .
       98   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       99   define variable vss-author      as character no-undo init "$Author: expertek $":U .
      100   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
      101   define variable vss-workfile    as character no-undo init "$Workfile: sendirst.p $":U .
      102   define variable vss-archive     as character no-undo init "$Archive: str/sendirst.p $":U .
      103   define variable vss-description as character no-undo init "Подготовка остатков по основному БК":U.
      104   procedure vss-get-info :
      105     define output parameter p-vss-revision    like vss-revision    no-undo .
      106     define output parameter p-vss-author      like vss-author      no-undo .
      107     define output parameter p-vss-date        like vss-date        no-undo .
      108     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      109     define output parameter p-vss-archive     like vss-archive     no-undo .
      110     define output parameter p-vss-description like vss-description no-undo .
      111     assign
      112       p-vss-revision    = vss-revision
      113       p-vss-author      = vss-author
      114       p-vss-date        = vss-date
      115       p-vss-workfile    = vss-workfile
      116       p-vss-archive     = vss-archive
      117       p-vss-description = vss-description
      118     .
      119   end procedure.
      120   procedure vss-get-parameters :
      121     define output parameter p-vss-parameters as character no-undo .
      122   end procedure.
      123   define new global shared variable g#vssrevis-logger as handle    no-undo .
      124   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      125   define variable v-vssrevis-logger                   as handle    no-undo .
      126   procedure vss-logevent :
      127     define input  parameter p-extra-paramters as character no-undo .
      128     define variable v-vssrevis-parameters as character no-undo .
      129     do
      130     on error undo, return error return-value
      131     :
      132       if  valid-handle(v-vssrevis-logger)
      133       and v-vssrevis-logger :get-signature("logevent") <> ""
      134       then do:
      135         run vss-get-parameters in this-procedure
      136           (output v-vssrevis-parameters
      137           ).
      138         run logevent in v-vssrevis-logger
      139           (input vss-workfile
      140           ,input vss-revision
      141           ,input v-vssrevis-parameters
      142           ,input p-extra-paramters
      143           ).
      144       end.
      145     end.
      146   end procedure.
      147   assign
      148     v-vssrevis-logger = g#vssrevis-logger
      149   .
      150   if  valid-handle(v-vssrevis-logger)
      151   and v-vssrevis-logger :get-signature("logevent") <> ""
      152   then do:
      153     assign
      154       v-vssrevis-logevent = true
      155     .
      156     run vss-logevent in this-procedure (input vss-description) .
      157   end.
      158   define new global shared variable g#language as character no-undo .
      159   if g#language <> '' and g#language <> 'rus':U then do:
      160     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      161   end.
      162   define new global shared variable g#library  as handle no-undo .
      163   define new global shared variable g#library2 as handle no-undo .
      164   define   shared variable g#auto as logical no-undo.
      165   define   shared variable g#news as logical no-undo.
      166   define   shared variable g#oxml as logical no-undo.
      167   define   shared variable g#esys as logical no-undo.
      168   define   shared variable g#news-source-db as integer no-undo.
      169   define   shared variable g#esys-source-esys as integer no-undo.
      170   define   shared variable g#db-num as integer   no-undo .
      171   define   shared variable g#userid as character no-undo .
      172   define   shared variable g#passwd as character no-undo .
      173   define variable inp-b-code as integer no-undo .
      174   define variable p-obj-code as integer no-undo .
      175   define variable cr as integer no-undo .
      176   define variable l-terminal-prt as logical no-undo .
      177   define buffer buf_bar-code for ub.bar-code.
      178   define buffer buf_goods    for ub.goods.
      179   define buffer buf_gds-prt  for ub.gds-prt.
      180   define buffer buf_clients  for ub.clients.
      181   assign
      182   inp-b-code = integer(entry(1, p-parameter, chr(4)))
      183   p-obj-code = integer(entry(2, p-parameter, chr(4)))
      184   no-error
      185   .
      186   if error-status:error then return error substitute("Неверно задан входной параметр").
      187   FIND buf_bar-code WHERE buf_bar-code.b-code = inp-b-code NO-LOCK no-error .
      188   if not available buf_bar-code then do:
      189     undo, return error substitute("Не найден бар-код &1"
      190                                  , inp-b-code).
      191   end.
      192   find first buf_goods no-lock where
      193             buf_goods.gds-code = buf_bar-code.gds-code no-error.
      194   if not available buf_goods then do:
      195     undo, return error substitute("Не найден товар для бар-кода &1 (код товара &2)"
      196                                   , inp-b-code
      197                                   , buf_bar-code.gds-code).
      198   end.
      199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      200     (input  buf_bar-code.node-code
      201     ,input  'terminal-prt=request':u
      202     ,output l-terminal-prt
      203     ) no-error .
      204   if error-status :error
      205   then do:
      206     undo, return error substitute("Ошибка при определении терминальности признака")
      207       .
      208   end.
      209   if not l-terminal-prt then do:
      210     undo, return error substitute("Запрошен нетерминальный бар-код &1 (код признака &2)"
      211                                   , inp-b-code
      212                                   , buf_bar-code.node-code).
      213   end.
      214   _shop:
      215   FOR EACH buf_clients no-lock where
      216           buf_Clients.db-num = G#db-num
      217       and buf_clients.obj-type = 'маг':U
      218      and
      219      (p-obj-code = 0
      220      or
      221      buf_clients.obj-code = p-obj-code):
      222      run term-prt in this-procedure ( buffer buf_bar-code
      223                                      ,input buf_clients.obj-type
      224                                      ,input buf_clients.obj-code
      225                                      ,input buf_goods.artic
      226                                      ,input buf_goods.prod-type
      227                                      ,input buf_goods.prod-code) no-error.
      228   end.
      229   PROCEDURE term-prt.
      230   define parameter buffer buf_bar-code for ub.bar-code.
      231   define input parameter p-obj-type as character no-undo .
      232   define input parameter p-obj-code as integer no-undo .
      233   define input parameter p-artic as character no-undo .
      234   define input parameter p-prod-type as character no-undo .
      235   define input parameter p-prod-code as integer no-undo .
      236   define variable for-fact-qnty as decimal no-undo .
      237   define variable for-free-qnty as decimal no-undo .
      238   define buffer b-g-p for ub.gds-prt.
      239   define buffer buf_prt-obj for ub.prt-obj.
      240   FIND FIRST buf_prt-obj WHERE
      241           buf_prt-obj.obj-type = 'маг':U
      242       AND buf_prt-obj.obj-code = p-obj-code
      243       AND buf_prt-obj.prod-type = p-prod-type
      244       AND buf_prt-obj.prod-code = p-prod-code
      245       AND buf_prt-obj.artic = p-artic
      246       AND buf_prt-obj.prt-code = buf_bar-code.node-code NO-LOCK NO-ERROR .
      247   if available buf_prt-obj then do:
      248     assign
      249     for-fact-qnty  = buf_prt-obj.fact-qnty
      250     for-free-qnty  = buf_prt-obj.free-qnty
      251     .
      252   end.
      253   else do:
      254     assign
      255     for-fact-qnty  = 0
      256     for-free-qnty  = 0
      257     .
      258   end.
      259   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
      260   if not avail cash-gds then do:
      261     create cash-gds.
      262     assign
      263     cash-gds.crf = cr + 1
      264     cr = cr + 1
      265     cash-gds.gds-code = buf_bar-code.gds-code
      266     cash-gds.b-code = buf_bar-code.b-code
      267     cash-gds.fact-qnty = for-fact-qnty
      268     cash-gds.free-qnty = for-free-qnty
      269     cash-gds.obj-type = p-obj-type
      270     cash-gds.obj-code = p-obj-code
      271     .
      272   end.
      273   END PROCEDURE.
