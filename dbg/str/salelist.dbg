     2563           v-vid-action = 59 .
     2564           run trg/userlog.p (
     2565                 input 'delete_err':U
     2566               , input 'inkas':U
     2567               , input ( buffer ink-doc:handle )
     2568               , input v-vid-action
     2569               , input v-vid-param
     2570           ) no-error.
     2571         end.
     2572         message
