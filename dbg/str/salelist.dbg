     4683   PROCEDURE PrintListProc.
     4684   define input parameter p-curr-r-b as character no-undo .
     4685   define input parameter p-base-type as character no-undo .
     4686   define variable date_string     as      char    no-undo.
     4687   define variable Line                as      char    no-undo.
     4688   define variable for-time as char.
     4689   define variable accum-count as integer.
     4690   define variable accum-tot-doc as decimal.
     4691   define variable accum-discnt as decima.
     4692   define variable accum-sub-discnt as decimal.
     4693   define variable accum-netto as decimal.
     4694   define variable accum-qnty as decimal.
     4695   define variable accum-num-chk as integer.
     4696   define variable for-pcnt as decimal.
     4697   DEFINE VARIABLE jj as integer no-undo .
     4698   define variable v-header-base-curr as character no-undo .
     4699   define variable v-flag as logical no-undo .
     4700   define variable v-shift-name-num as character no-undo.
     4701   define variable v-base-code like ub.sysconf.base-code no-undo .
     4702   define variable v-base-type like ub.currency.curr-abbr no-undo .
     4703   define buffer buf_trn-doc for ub.trn-doc.
     4704   if p-curr-r-b = 'base':U and p-base-type <> '':U then do:
     4705     assign
     4706     v-header-base-curr = string( "( Б.Вал. - " + caps( p-base-type ) + " )" )
     4707     .
     4708   end.
     4709   DEFINE FRAME Chk-List
     4710   ink-doc.office       column-label "У" format "+/-"
     4711   ink-doc.inkas-code FORMAT "X(12)"
     4712   ink-doc.doc-date FORMAT "99/99/9999"
     4713   ink-doc.fact-date COLUMN-LABEL "Факт.дата" FORMAT "99/99/9999"
     4714   ink-doc.netto COLUMN-LABEL "Нетто" FORMAT "->>>,>>>,>>>,>>9.99"
     4715   ink-doc.tot-doc COLUMN-LABEL "Сумма_товар."
     4716   ink-doc.discnt FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Скидка_общ"
     4717   for-pcnt COLUMN-LABEL "%" FORMAT "->>>9.9"
     4718   ink-doc.sub-discnt FORMAT "->,>>>,>>>,>>9.99" COLUMN-LABEL "Списания"
     4719   ink-doc.qnty COLUMN-LABEL "Кол_товара"
     4720   ink-doc.num-chk FORMAT ">>>,>>9" COLUMN-LABEL "Кол._чеков"
     4721   ink-doc.shift-date COLUMn-LABEL "Дата_смены"
     4722   v-shift-name-num COLUmn-LABEL "№ см." FORMAT "X(6)"
     4723   ink-doc.obj-code FORMAT "99999" COLUMn-LABEL "Маг-н"
     4724   ink-doc.status_ FORMAT "X(8)":U
     4725   v-flag COLUMN-LABEL "ОК" FORMAT "+/":U
     4726   HEADER  date_string AT 5 format "X(35)"
     4727   v-header-base-curr        format "X(20)" AT 42
     4728   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4729   Line format "X(177)" AT 1
     4730       with width 232 down stream-io use-text    .
     4731   Line = fill("-", 177).
     4732   date_string = cur-time-print() .
     4733   run prn-lib-open-stream  in this-procedure (
     4734                                                input parParentProc
     4735                                               ,input 43
     4736                                               ,input yes
     4737                                               ,input no
     4738                                               ).
     4739   PUT  STREAM PrnLibStream
     4740   SPACE(25) ( frame Dialog-Frame:title )
     4741   format "x(90)" SKIP(1) .
     4742   FORM HEADER
     4743           Line format "X(177)" AT 1 SKIP
     4744           "Продолжение - на следующей странице" AT 30 SKIP
     4745           with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4746   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4747   FORM with FRAME Chk-List  .
     4748   run waitfram-show in this-procedure ("Ждите...").
     4749   GET next br-docs.
     4750   jj = 0 .
     4751   DO WHILE available ink-doc :
     4752     find first buf_trn-doc no-lock where
     4753                 buf_trn-doc.doc-code = ink-doc.inkas-code no-error.
     4754     Display STREAM PrnLibStream
     4755     ink-doc.office
     4756     ink-doc.inkas-code
     4757     ink-doc.doc-date
     4758     ink-doc.fact-date
     4759     ink-doc.netto
     4760     ink-doc.tot-doc
     4761     ink-doc.discnt
     4762     (ink-doc.discnt / ink-doc.tot-doc * 100) @ for-pcnt
     4763     ink-doc.sub-discnt
     4764     ink-doc.qnty
     4765     ink-doc.num-chk
     4766     ink-doc.shift-date
     4767     shift-name-no-err(buffer ink-doc) @ v-shift-name-num
     4768     ink-doc.obj-code
     4769     ink-doc.status_
     4770     (if available buf_trn-doc then buf_trn-doc.flag else ?) @ v-flag
     4771     with FRAME Chk-List .
     4772     DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     4773     assign
     4774     accum-count = accum-count + 1
     4775     accum-tot-doc = accum-tot-doc + ink-doc.tot-doc
     4776     accum-discnt = accum-discnt + ink-doc.discnt
     4777     accum-sub-discnt = accum-sub-discnt + ink-doc.sub-discnt
     4778     accum-netto = accum-netto + ink-doc.netto
     4779     accum-qnty = accum-qnty + ink-doc.qnty
     4780     accum-num-chk = accum-num-chk + ink-doc.num-chk.
     4781     GET next br-docs.
     4782   END.
     4783   UNDERLINE  STREAM PrnLibStream
     4784   ink-doc.office
     4785   ink-doc.inkas-code
     4786   ink-doc.doc-date
     4787   ink-doc.fact-date
     4788   ink-doc.netto
     4789   ink-doc.tot-doc
     4790   ink-doc.discnt
     4791   for-pcnt
     4792   ink-doc.sub-discnt
     4793   ink-doc.qnty
     4794   ink-doc.num-chk
     4795   ink-doc.shift-date
     4796   v-shift-name-num
     4797   ink-doc.obj-code
     4798   ink-doc.status_
     4799   v-flag
     4800   with FRAME Chk-List .
     4801   DISPLAY STREAM PrnLibStream
     4802   "ИТОГО " @ ink-doc.inkas-code
     4803   string(accum-count) @ ink-doc.doc-date
     4804   "отчетов" @ ink-doc.fact-date
     4805   accum-netto @ ink-doc.netto
     4806   accum-tot-doc @ ink-doc.tot-doc
     4807   accum-discnt @ ink-doc.discnt
     4808   (accum-discnt / accum-tot-doc * 100) @ for-pcnt
     4809   accum-sub-discnt @ ink-doc.sub-discnt
     4810   accum-qnty @ ink-doc.qnty
     4811   accum-num-chk @ ink-doc.num-chk
     4812   with frame Chk-List.
     4813   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4814   HIDE  STREAM PrnLibStream FRAME Chk-List.
     4815   output  STREAM PrnLibStream CLOSE.
     4816   run waitfram-hide in this-procedure .
     4817   run prn-lib-prn-file in this-procedure (
     4818                                             input parParentProc
     4819                                             ,input 8
     4820                                             ).
     4821   END PROCEDURE.
     4822   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4823   procedure set-filter-name :
     4824   define input parameter p-filter-name as character no-undo .
     4825     do with frame Dialog-Frame:
     4826       if p-filter-name > "" then do:
     4827         assign
     4828           frame Dialog-Frame:title
     4829             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     4830         .
     4831         assign
     4832           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     4833         .
     4834       end.
     4835       else do:
     4836         assign
     4837           b-sch :tooltip = ""
     4838         .
     4839       end.
     4840     end.
     4841   end procedure.
     4842   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4843   do:
     4844     BR-docs :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     4845   end.
     4846   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4847   on f5 of frame Dialog-Frame anywhere
     4848   do:
     4849     RUN reopen-query IN THIS-PROCEDURE.
     4850       apply "VALUE-CHANGED" to BR-docs.
     4851   end.
     4852   MAIN-BLOCK:
     4853   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4854      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4855   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4856     run mainmenu_getcntxt in parparentproc
     4857       (output v-cntxt-db-num
     4858       ,output v-cntxt-userid
     4859       ,output v-cntxt-level
     4860       ,output v-cntxt-host-code-obj
     4861       ,output v-cntxt-obj-type
     4862       ,output v-cntxt-obj-code
     4863       ,output v-cntxt-db-num-obj
     4864       ,output v-cntxt-is-admin
     4865       ) .
     4866   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4868     (output v-curr-r-b
     4869     )  .
     4870     v-rid-list = p-rid-list.
     4871     FIND FIRST ub.sys-ctrl NO-LOCK.
     4872     if avail sys-ctrl then do:
     4873       FIND FIRST db no-LOCK where
     4874                 db.db-num = sys-ctrl.db-num NO-ERROR.
     4875       if not avail db then do:
     4876         message "Отсутствует запись о БД (db)"
     4877         view-as alert-box ERROR.
     4878         return error.
     4879       end.
     4880     END.
     4881     FIND FIRST buf_obj No-LOCK WHERE
     4882                     buf_obj.obj-type = parobj-type and
     4883                     buf_obj.obj-code = parobj-code No-ERROR.
     4884     if not avail buf_obj then do:
     4885         message vss-workfile vss-revision vss-description skip
     4886         "Неверное значение параметров вызова parobj-type и/или parobj-code"
     4887         parobj-type parobj-code
     4888         view-as alert-box ERROR.
     4889         return.
     4890     end.
     4891   CASE par-mode:
     4892      WHEN 'все':U        THEN DO:
     4893       END.
     4894       WHEN 'фирма':U or
     4895       when 'bge-run' then dO:
     4896           FIND FIRST ub.sysconf No-LOCK WHERE
     4897                             ub.sysconf.host-code = parhost-code No-ERROR.
     4898           if not avail ub.sysconf then do:
     4899               message vss-workfile vss-revision vss-description skip
     4900                          "Неверное значение параметра вызова parhost-code" parhost-code
     4901               view-as alert-box ERROR.
     4902               return.
     4903           end.
     4904           find first buf_host no-lock where
     4905                      buf_host.obj-type = 'орг':U
     4906                  AND buf_host.obj-code = parhost-code.
     4907           assign varhost-name = buf_host.obj-name.
     4908       END.
     4909       WHEN 'объект':U or
     4910       WHEN 'новый':U OR
     4911       when 'bge-run'  or
     4912       when "object-all" OR
     4913       when 'запрос':U
     4914       then dO:
     4915           FIND FIRST buf_obj No-LOCK WHERE
     4916                           buf_obj.obj-type = parobj-type and
     4917                           buf_obj.obj-code = parobj-code No-ERROR.
     4918           if not avail buf_obj then do:
     4919               message vss-workfile vss-revision vss-description skip
     4920               view-as alert-box ERROR.
     4921               return.
     4922           end.
     4923       end.
     4924       otherwise do:
     4925           message vss-workfile vss-revision vss-description skip
     4926           "Неверный вызов - par-mode=" par-mode
     4927           view-as alert-box ERROR.
     4928           return.
     4929       end.
     4930     end CASE.
     4931     if par-mode = 'объект':U or
     4932     par-mode = 'bge-run' or
     4933     par-mode = 'новый':U   or
     4934     par-mode = 'запрос':U
     4935     then dO:
     4936       run get-params in this-procedure ( input parobj-type, input parobj-code) .
     4937     end.
     4938     if v-rid-list <> "":U then do:
     4939       assign
     4940       v-doc-rec = integer(entry(1, v-rid-list))
     4941       .
     4942     end.
     4943     run MyEnable IN THIS-PROCEDURE .
     4944     RUn openbr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     4945   Hide mark-num in frame Dialog-Frame .
     4946     WAIT-FOR GO OF FRAME Dialog-Frame.
     4947   END.
     4948   run disable_UI.
     4949   PROCEDURE disable_UI :
     4950     HIDE FRAME Dialog-Frame.
     4951   END PROCEDURE.
     4952   PROCEDURE enable_UI :
     4953     DISPLAY ED-notes sch-code sch-date sch-fact mark-num qnty shop-name num-chk
     4954         WITH FRAME Dialog-Frame.
     4955     ENABLE b-quit B-mark B-sel B-export B-chk B-print B-sch B-hist B-Help B-add
     4956            b-lkp B-chg B-del B-close B-Open BR-docs ED-notes sch-code sch-date
     4957            sch-fact mark-num qnty shop-name num-chk
     4958         WITH FRAME Dialog-Frame.
     4959     VIEW FRAME Dialog-Frame.
     4960   END PROCEDURE.
     4961   PROCEDURE Get-params :
     4962   define input parameter locparobj-type like ub.clients.obj-type no-undo.
     4963   define input parameter locparobj-code like ub.clients.obj-code no-undo.
     4964   define variable v-param-type as character no-undo .
     4965   define variable v-value-character as character no-undo .
     4966   define variable v-value-date as date no-undo .
     4967   define variable v-value-decimal as decimal no-undo .
     4968   define variable v-value-integer as INTEGER no-undo .
     4969   define variable v-value-logical AS LOGICAL no-undo .
     4970   define variable v-tth as handle no-undo .
     4971   assign
     4972   v-tth = buffer thbjattr_thbj-attr:table-handle .
     4973   find first ub.shop No-LOCK WHERE
     4974   ub.shop.obj-code = locparobj-code No-ERROR.
     4975   if not available ub.shop then return.
     4976   for each thbjattr_thbj-attr:
     4977     delete thbjattr_thbj-attr.
     4978   end.
     4979   run adm/shattri.p (
     4980       input "get":U
     4981       ,input  locparobj-type
     4982       ,input  locparobj-code
     4983       ,input  'get-chk':U
     4984       ,input  'cas-shft':U
     4985       ,output v-value-character
     4986       ,output v-value-date
     4987       ,output v-value-decimal
     4988       ,output v-value-integer
     4989       ,output v-value-logical
     4990       ,output v-param-type
     4991       ,INPUT-OUTPUT table-handle v-tth
     4992       ) no-error .
     4993   IF error-status:error then do:
     4994     message
     4995     substitute("Ошибка при получении опций закачки чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
     4996               , locparobj-type
     4997               , locparobj-code
     4998               , chr(10)
     4999               , error-status:get-message(1)
     5000               , return-value )
     5001     view-as alert-box error .
     5002     return error.
     5003   end.
     5004   cas-shft = v-value-logical.
     5005   ASSIGN
     5006   v-is-fbr-obj = ub.shop.is-catering.
     5007   run gbl/tpsi-obj.p (
     5008                 input locparobj-type
     5009               , input locparobj-code
     5010               , output v-is-tpsi-obj) no-error .
     5011   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5012   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5013     (input  locparobj-type
     5014     ,input  locparobj-code
     5015     ,input  'shift-on=request'
     5016     ,output l-shift-on
     5017     )  .
     5018   END PROCEDURE.
     5019   PROCEDURE MyEnable :
     5020   define variable main-tpsi as logical no-undo .
     5021   define variable v-param-type as character no-undo .
     5022   define variable v-value-character as character no-undo .
     5023   define variable v-value-date as date no-undo .
     5024   define variable v-value-decimal as decimal no-undo .
     5025   define variable v-value-integer as INTEGER no-undo .
     5026   define variable v-value-logical AS LOGICAL no-undo .
     5027   define variable v-tth as handle no-undo .
     5028   br-docs:num-locked-columns in frame Dialog-Frame = 7.
     5029   ASSIGN
     5030   v-tab-order = "b-quit,b-mark,b-sel,b-export,b-chk,b-sch,b-print,b-hist,b-help," +
     5031                 "b-add,b-lkp,b-chg,b-del,b-close,b-open,br-docs,sch-code,sch-date,sch-fact".
     5032   ASSIGN
     5033   b-print:MENU-MOUSE in frame Dialog-Frame = 1
     5034   b-export:MENU-MOUSE = 1
     5035   b-hist:MENU-MOUSE in frame Dialog-Frame = 1
     5036   .
     5037   IF v-is-tpsi-obj
     5038   AND par-mode = 'новый':U
     5039   and lookup("b-add":U, bttns) > 0  THEN DO:
     5040     for each thbjattr_thbj-attr:
     5041       delete thbjattr_thbj-attr.
     5042     end.
     5043     assign
     5044     v-tth = buffer thbjattr_thbj-attr:table-handle .
     5045     run adm/shattri.p (
     5046         input "get":U
     5047         ,input  parobj-type
     5048         ,input  parobj-code
     5049         ,input  'autosale':U
     5050         ,input  "":U
     5051         ,output v-value-character
     5052         ,output v-value-date
     5053         ,output v-value-decimal
     5054         ,output v-value-integer
     5055         ,output v-value-logical
     5056         ,output v-param-type
     5057         ,INPUT-OUTPUT table-handle v-tth
     5058         ) no-error .
     5059     IF error-status:error then do:
     5060       message
     5061       substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     5062                 , parobj-type
     5063                 , parobj-code
     5064                 , chr(10)
     5065                 , error-status:get-message(1)
     5066                 , return-value )
     5067       view-as alert-box error .
     5068       return error.
     5069     end.
     5070     for each  thbjattr_thbj-attr where
     5071               thbjattr_thbj-attr.obj-type = parobj-type
     5072           and thbjattr_thbj-attr.obj-code = parobj-code
     5073           and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     5074     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     5075     case thbjattr_thbj-attr.prop-code:
     5076       when 'tpsi-mode':U then do:
     5077         assign
     5078         tpsi-mode = thbjattr_thbj-attr.property-value-integer.
     5079       end.
     5080       when 'main-tpsi':U then do:
     5081         assign
     5082         main-tpsi = thbjattr_thbj-attr.property-value-logical.
     5083       end.
     5084     end case.
     5085     end.
     5086     if tpsi-mode = 2 then do:
     5087      ASSIGN
     5088      b-add:MENU-MOUSE = 1.
     5089     end.
     5090     assign
     5091     menu-item m_inquiry:sensitive in menu menu-b-add = main-tpsi
     5092     .
     5093   END.
     5094   ELSE DO:
     5095      add-option = 'касс':U.
     5096      b-add:popup-menu = ?.
     5097   END.
     5098   DISPLAY
     5099   ED-notes
     5100   sch-code
     5101   sch-date
     5102   sch-fact
     5103   qnty
     5104   shop-name when (par-mode <> 'объект':U and par-mode <> 'новый':U)
     5105   num-chk
     5106   WITH FRAME Dialog-Frame.
     5107   IF par-mode = 'bge-run' THEN b-export :LABEL = "&Экспорт".
     5108   ENABLE
     5109   b-quit
     5110   B-mark when lookup("b-mark":U, bttns) > 0
     5111   B-sel when lookup("b-sel":U, bttns) > 0
     5112   b-add WHEN (par-mode = 'новый':U and lookup("b-add":U, bttns) > 0 )
     5113   b-chg WHEN (par-mode = 'новый':U and lookup("b-add":U, bttns) > 0 )
     5114   b-close WHEN (par-mode = 'новый':U and lookup("b-add":U, bttns) > 0 )
     5115   b-open WHEN (par-mode = 'новый':U and lookup("b-add":U, bttns) > 0 )
     5116   b-lkp
     5117   b-del when ((par-mode = 'новый':U and lookup("b-add":U, bttns) > 0 )
     5118               or
     5119               (par-mode <> 'новый':U and ub.db.db-num = buf_obj.db-num)
     5120               )
     5121   B-export when lookup("b-export":U, bttns) > 0 or lookup("prov":U, bttns) > 0
     5122   B-chk
     5123   B-sch
     5124   B-print
     5125   B-hist
     5126   B-Help
     5127   BR-docs
     5128   ED-notes
     5129   sch-code
     5130   sch-date
     5131   sch-fact
     5132   mark-num
     5133   WITH FRAME Dialog-Frame.
     5134   VIEW FRAME Dialog-Frame.
     5135   IF par-mode = 'новый':U THEN DO:
     5136       DISABLE
     5137       b-export
     5138      with FRAME Dialog-Frame.
     5139   END.
     5140   IF NOT v-is-fbr-obj = YES THEN DO:
     5141       ASSIGN
     5142       ink-doc.AUTO-fbr:VISIBLE IN BROWSE br-docs = NO
     5143       ink-doc.rest-dish:VISIBLE IN BROWSE br-docs = NO
     5144       ink-doc.rest-ingr:VISIBLE IN BROWSE br-docs = NO
     5145       .
     5146   END.
     5147   IF NOT v-is-tpsi-obj = YES THEN DO:
     5148       ASSIGN
     5149       ink-doc.AUTO-tpsi:VISIBLE IN BROWSE br-docs = NO
     5150       ink-doc.rest-tpsi:VISIBLE IN BROWSE br-docs = NO
     5151       .
     5152   END.
     5153   END PROCEDURE.
     5154   PROCEDURE OpenBr :
     5155   define input  parameter p-open-query     as logical   no-undo .
     5156   define input  parameter p-find-next      as logical   no-undo .
     5157   define input  parameter p-find-condition as character no-undo .
     5158   define variable l-query-was-opened as logical no-undo .
     5159   define variable title0 as character no-undo.
     5160   title0 = "Продажи".
     5161   run waitfram-show in this-procedure ( input "Ждите...").
     5162   define variable sort-column-phrase as character no-undo .
     5163   case sort-column-name :
     5164   when "" then do:
     5165   assign
     5166     sort-column-phrase = ""
     5167   .
     5168   end.
     5169   otherwise do:
     5170   assign
     5171     sort-column-phrase = "by " + sort-column-name
     5172   .
     5173   end.
     5174   end case.
     5175   define variable l-open-query as logical   no-undo .
     5176   filter-point = filter-point0 + par-mode.
     5177   CASE par-mode :
     5178   WHEN 'все':U        THEN DO:
     5179     assign
     5180     filter-label = substitute("&1", filter-label0)
     5181     .
     5182   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5183   define variable  l-disable-where-56  as logical   no-undo .
     5184   define variable  l-filter-open-56    as logical   .
     5185   define variable  flt-rec-56       as recid     no-undo .
     5186   define variable  filter-name-56      as character no-undo .
     5187   define variable  where-phrase-56     as character no-undo .
     5188   define variable  sort-phrase-56      as character no-undo .
     5189   define variable  where-phrase-rus-56 as character no-undo .
     5190   define variable  sort-phrase-rus-56  as character no-undo .
     5191     run waitfram-show in this-procedure
     5192       (input "ЖДИТЕ ..."
     5193       ).
     5194   run gbl/flt-get.p
     5195     (input filter-point
     5196     ,output flt-rec-56
     5197     ,output filter-name-56
     5198     ,output where-phrase-56
     5199     ,output sort-phrase-56
     5200     ,output where-phrase-rus-56
     5201     ,output sort-phrase-rus-56
     5202     ).
     5203   if p-open-query then do:
     5204       run set-filter-name in this-procedure
     5205         (INPUT filter-name-56
     5206         ) no-error .
     5207     assign
     5208       l-filter-open-56 = false
     5209     .
     5210     if flt-rec-56 <> ?
     5211       or sort-column-phrase > ""
     5212     then do:
     5213       define variable  parameter-2-56 as character no-undo .
     5214       define variable  parameter-3-56 as character no-undo .
     5215       define variable  parameter-4-56 as character no-undo .
     5216       define variable  parameter-5-56 as character no-undo .
     5217       define variable  parameter-6-56 as character no-undo .
     5218       define variable  parameter-7-56 as character no-undo .
     5219         assign
     5220         parameter-3-56 =
     5221                                 "FOR EACH ink-doc"
     5222         parameter-4-56 =
     5223           (
     5224             if (" ink-doc.status_ = 'факт':U " + " " + where-phrase-56) <> ""
     5225             then " ink-doc.status_ = 'факт':U " + " " + where-phrase-56
     5226             else "true"
     5227           )
     5228         parameter-5-56 = (" " + "" + " " + "")
     5229         parameter-6-56 = if sort-phrase-56 = ''
     5230                              then
     5231           (
     5232           " " + " USE-INDEX host-date " +
     5233             " " + sort-column-phrase +
     5234           " " + "  "
     5235           )
     5236                              else
     5237           (
     5238           " " + " USE-INDEX host-date " +
     5239             " " + sort-column-phrase +
     5240           " " + sort-phrase-56
     5241           )
     5242         parameter-7-56 =
     5243           " indexed-reposition  "
     5244       .
     5245       do
     5246       on stop undo, leave
     5247       on error undo, leave
     5248       :
     5249         assign
     5250           l-disable-where-56 =
     5251             (" ink-doc.status_ = 'факт':U " + " " + where-phrase-56 = "")
     5252         .
     5253         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5254                             ,input QUERY br-docs:handle
     5255                             ,input parameter-3-56
     5256                             ,input parameter-4-56
     5257                             ,input parameter-5-56
     5258                             ,input parameter-6-56
     5259                             ,input parameter-7-56
     5260                             )
     5261         .
     5262         assign
     5263           l-filter-open-56 = true
     5264         .
     5265       end.
     5266       if l-filter-open-56 = false then do:
     5267         message
     5268           "Ошибка при фильтрации / сортировке" skip
     5269           "Будут показаны записи без учета фильтра" skip
     5270           view-as alert-box .
     5271       end.
     5272       else do:
     5273           assign
     5274             l-query-was-opened = true
     5275           .
     5276       end.
     5277     end.
     5278     if l-filter-open-56 = false then do:
     5279       OPEN QUERY br-docs FOR EACH ink-doc
     5280         where  ink-doc.status_ = 'факт':U
     5281          USE-INDEX host-date
     5282         indexed-reposition
     5283     .
     5284         assign
     5285           l-query-was-opened = true
     5286         .
     5287     end.
     5288   end.
     5289   else do:
     5290     assign
     5291       v-doc-rec = recid( ink-doc )
     5292     .
     5293     do
     5294     on stop undo, leave
     5295     on error undo, leave
     5296     :
     5297       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer ink-doc:handle) then do:
     5298         assign
     5299         parameter-2-56 = (if p-find-next then "true":u else "false":u )
     5300         parameter-4-56 =
     5301           "where ":u + " ink-doc.status_ = 'факт':U " + " ":u + where-phrase-56 + " ":u + p-find-condition + " " + ""
     5302         parameter-5-56 = " USE-INDEX host-date "
     5303       .
     5304         run fltopend_fltfindd in this-procedure  (
     5305                             input this-procedure:handle
     5306                             ,input QUERY br-docs:handle
     5307                             ,input rowid(ink-doc)
     5308                             ,input logical(parameter-2-56)
     5309                             ,input no-lock
     5310                             ,input (buffer ink-doc:handle)
     5311                             ,input parameter-4-56
     5312                             ,input parameter-5-56
     5313                             ) no-error.
     5314         .
     5315         assign
     5316           v-doc-rec = integer(return-value)
     5317           v-fltopend-rowid[1] = ?
     5318         .
     5319       end.
     5320       else do:
     5321         assign
     5322         parameter-2-56 = (if p-find-next then "true":u else "false":u )
     5323         parameter-3-56 =  "FOR EACH ink-doc"
     5324         parameter-4-56 =
     5325           (
     5326             if (" ink-doc.status_ = 'факт':U " + " " + where-phrase-56) <> ""
     5327             then " ink-doc.status_ = 'факт':U " + " " + where-phrase-56
     5328             else "true"
     5329           )
     5330         parameter-5-56 = (" " + "" + " " + "" + " " + p-find-condition)
     5331         parameter-6-56 = if sort-phrase-56 = ''
     5332                              then
     5333           (
     5334           " " + " USE-INDEX host-date " +
     5335             " " + sort-column-phrase +
     5336           " " + "  "
     5337           )
     5338                              else
     5339           (
     5340           " " + " USE-INDEX host-date " +
     5341             " " + sort-column-phrase +
     5342           " " + sort-phrase-56
     5343           )
     5344         parameter-7-56 =
     5345           " indexed-reposition  "
     5346       .
     5347         run fltopend_fltfindq in this-procedure  (
     5348                             input this-procedure:handle
     5349                             ,input QUERY br-docs:handle
     5350                             ,input logical(parameter-2-56)
     5351                             ,input no-lock
     5352                             ,input parameter-3-56
     5353                             ,input parameter-4-56
     5354                             ,input parameter-5-56
     5355                             ,input parameter-6-56
     5356                             ,input parameter-7-56
     5357                             ,output v-fltopend-rowid
     5358                             ) no-error.
     5359         .
     5360         v-doc-rec = ?.
     5361       end.
     5362       assign
     5363         l-query-was-opened = true
     5364       .
     5365     end.
     5366   end.
     5367     run waitfram-hide in this-procedure .
     5368   END.
