      434   procedure create_obj-list :
      435      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      436      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      437      do
      438      on error undo, return error return-value
      439      :
      440         define buffer cli-obj for ub.clients .
      441         define variable p-var as integer no-undo .
      442         define buffer buf_obj-list for obj-list .
      443         find last buf_obj-list  use-index pi no-error .
      444         if available buf_obj-list
      445         then
      446            p-var = buf_obj-list.obj-id + 1.
      447         else
      448            p-var = 1.
      449         find first cli-obj where
      450                   cli-obj.obj-type = p-obj-type
      451               and cli-obj.obj-code = p-obj-code
      452         no-lock no-error.
      453         if available cli-obj
      454         then do:
      455            create buf_obj-list.
      456            assign
      457               buf_obj-list.obj-id   = p-var
      458               buf_obj-list.obj-code = cli-obj.obj-code
      459               buf_obj-list.obj-type = cli-obj.obj-type
      460               buf_obj-list.obj-name = cli-obj.obj-name
      461               buf_obj-list.db-num   = cli-obj.db-num
      462            .
      463         end.
      464      end.
      465   end.
