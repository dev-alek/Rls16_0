     2195     QUERY BR-docs NO-LOCK DISPLAY
     2196         mark-string( recid(ink-doc), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     2197         ink-doc.inkas-code FORMAT "X(14)":U
