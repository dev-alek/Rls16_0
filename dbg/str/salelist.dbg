     4277       then do:
     4278         run gbl/getcurdt.p
     4279           (output v-curr-sv-date
     4280           ) .
     4281       end.
     4282       if v-curr-sv-date <> ?
     4283       then do:
     4284         assign
     4285           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     4286         .
     4287         assign
     4288           self :screen-value = string(v-new-sv-date) .
     4289         .
     4290       end.
     4291     end.
     4292     return no-apply .
     4293   end.
