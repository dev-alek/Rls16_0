     2474       return no-apply .
     2475     end.
     2476     ri = recid(ink-doc).
     2477     IF par-mode = 'новый':U THEN DO:
     2478       assign
     2479       v-parameter = string(1)                 + chr(4) +
     2480                     ink-doc.obj-type          + chr(4) +
     2481                     string(ink-doc.obj-code)  + chr(4) +
     2482                     string(not v-normal-call) + chr(4) +
     2483                     v-inkas-code.
     2484       run str/diallog.w (
     2485             input parParentProc
     2486           , input this-procedure
     2487           , input ("str/del-sale.p":U + chr(4) +
     2488                   "1":U  + chr(4) +
     2489                   "1":U + chr(4) +
     2490                   "1":U)
     2491           , input v-parameter
     2492           , input no
     2493           , input "":U
     2494           , input substitute("Удаление продажи &1 &2&3", Ink-doc.inkas-code, ink-doc.obj-type, ink-doc.obj-code)
     2495       ) no-error.
     2496       if error-status:error
     2497       and return-value <> "error"
     2498       and return-value <> ""
     2499       then do:
     2500         message
     2501         substitute("&1 &2"
     2502                   , error-status:get-message(1)
     2503                   , return-value )
     2504         view-as alert-box error .
     2505         return no-apply .
     2506       end.
     2507       if return-value = "error":U then do:
     2508         return no-apply .
     2509       end.
     2510       else do:
     2511         run Openbr in this-procedure ( input yes, input no, input '':U).
     2512         reposition br-docs to recid ri no-error.
     2513       end.
     2514     END.
     2515     ELSE DO:
     2516       v-parameter = ink-doc.inkas-code.
     2517         find first buf_trn-doc no-lock where
