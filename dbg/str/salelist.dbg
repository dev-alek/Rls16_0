     6679             if (" ink-doc.host-code = parhost-code AND                       ink-doc.status_ = 'факт':U AND                       ink-doc.bge-date = ?                                     " + " " + where-phrase-70) <> ""
     6680             then  substitute('ink-doc.host-code = &1 AND                       ink-doc.status_ = &1&3&1 AND                       ink-doc.bge-date = ? ', parhost-code, chr(34), 'факт':U)  + " " + where-phrase-70
     6681             else "true"
     6682           )
     6683         parameter-5-70 = (" " + "" + " " + "" + " " + p-find-condition)
     6684         parameter-6-70 = if sort-phrase-70 = ''
     6685                              then
     6686           (
     6687           " " + " USE-INDEX bge-host  " +
     6688             " " + sort-column-phrase +
     6689           " " + "  "
     6690           )
     6691                              else
     6692           (
     6693           " " + " USE-INDEX bge-host  " +
     6694             " " + sort-column-phrase +
     6695           " " + sort-phrase-70
     6696           )
     6697         parameter-7-70 =
     6698           " indexed-reposition  "
     6699       .
     6700         run fltopend_fltfindq in this-procedure  (
     6701                             input this-procedure:handle
     6702                             ,input QUERY br-docs:handle
     6703                             ,input logical(parameter-2-70)
     6704                             ,input no-lock
     6705                             ,input parameter-3-70
     6706                             ,input parameter-4-70
     6707                             ,input parameter-5-70
     6708                             ,input parameter-6-70
     6709                             ,input parameter-7-70
     6710                             ,output v-fltopend-rowid
     6711                             ) no-error.
     6712         .
     6713         v-doc-rec = ?.
     6714       end.
     6715       assign
     6716         l-query-was-opened = true
     6717       .
     6718     end.
     6719   end.
     6720     run waitfram-hide in this-procedure .
     6721   END.
     6722   END CASE.
     6723   if not p-open-query and v-doc-rec <> ? then
     6724   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     6725   if not p-open-query and v-fltopend-rowid[1] <> ? then
     6726   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     6727   run waitfram-hide in this-procedure .
     6728   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     6729   APPLY "ENTRY" TO br-docs.
     6730   END PROCEDURE.
     6731   PROCEDURE proc-b-add :
     6732   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     6733   define variable v-normal-call as logical no-undo .
     6734   define variable v-inkas-code as character no-undo .
     6735   CASE p-mode:
     6736     WHEN 'касс':U THEN DO:
     6737       v-normal-call = can-do("CHOOSE,ENTER":U, last-event:label) .
     6738       if not v-normal-call
     6739       and not l-shift-on then return no-apply.
     6740       run str/cre-sale.p (
     6741                         INPUT parparentproc
     6742                       , INPUT parobj-type
     6743                       , INPUT parobj-code
     6744                       , INPUT 'ДОБАВЛЕНИЕ':U
     6745                       , input '':U
     6746                       , input (if not v-normal-call and l-shift-on
     6747                                then  'ВЫБОР':U
     6748                                else '':U)
     6749                       , INPUT-output v-inkas-code
     6750                       , INPUT 'касс':U ) no-error .
     6751       if error-status:error then do:
     6752         if return-value <> "cancell":U then do:
     6753           message
     6754           substitute("Ошибка при создании продажи:&1&2 &3", chr(10), error-status:get-message(1) , return-value )
     6755           view-as alert-box .
     6756           return no-apply.
     6757         end.
     6758       end.
     6759     END.
     6760     WHEN 'запрос':U  THEN DO:
     6761        add-option = ''.
     6762        run str/cre-sale.p (
     6763                         INPUT parparentproc
     6764                       , INPUT parobj-type
     6765                       , INPUT parobj-code
     6766                       , INPUT 'ДОБАВЛЕНИЕ':U
     6767                       , input '':U
     6768                       , input '':U
     6769                       , INPUT-output v-inkas-code
     6770                       , INPUT 'запрос':U ) no-error .
     6771        if error-status:error then do:
     6772          if return-value <> "cancell":U then do:
     6773           message
     6774           substitute("Ошибка при создании запроса продажи:&1&2 &3", chr(10), error-status:get-message(1) , return-value )
     6775           view-as alert-box .
     6776           return no-apply.
     6777          end.
     6778        end.
     6779     END.
     6780   END CASE.
     6781   RUn openbr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     6782   APPLY "VALUE-CHANGED" to BR-docs IN FRAME Dialog-Frame.
     6783   END PROCEDURE.
     6784   PROCEDURE proc-b-export :
     6785   define input parameter loc-option as character no-undo.
     6786   define variable glog as logical no-undo .
     6787   if loc-option = "":U then return error.
     6788   CASE loc-option :
     6789       when "m_gen-3":u
     6790       then do:
     6791         ASSIGN
     6792         glog = ERROR-STATUS :ERROR.
     6793         APPLY "ENTRY":U TO br-docs IN FRAME Dialog-Frame.
     6794         IF glog = yes THEN DO:
     6795           RETURN NO-APPLY.
     6796         END.
     6797         IF LOOKUP( par-mode, 'bge-run' + chr(44) + 'bge-run-host' ) > 0 THEN DO:
     6798           RUn openbr in this-procedure ( input yes, input no, input '':U ).
     6799         end.
     6800       end.
     6801   END CASE.
     6802   END PROCEDURE.
     6803   PROCEDURE proc-b-hist :
     6804   define variable varrid-list as character no-undo .
     6805   if not  available ink-doc THEN return error.
     6806       run str/salclist.w (
     6807                       input parparentproc
     6808                      ,input '':U
     6809                      ,input 'one':U
     6810                      ,input ink-doc.inkas-code
     6811                      ,input ink-doc.host-code
     6812                      ,input ink-doc.obj-type
     6813                      ,input ink-doc.obj-code
     6814                      ,input-output varrid-list    ) no-error .
     6815   apply "entry" to br-docs in frame Dialog-Frame.
     6816   END PROCEDURE.
     6817   PROCEDURE proc-b-print :
     6818   DEFINE INPUT PARAMETER loc-option as character no-undo.
     6819   DEFINE VARIABLE v-frame-width as integer no-undo .
     6820   if loc-option = '':U then return error.
     6821   CASE loc-option:
     6822   when 'ONE':U then do:
     6823       print-type = "".
     6824       run rep/sale-prn.p (  input parparentproc
     6825                       ,input recid(ink-doc)
     6826                       ,input ?).
     6827       print-type = "".
     6828   end.
     6829   when 'LIST':U then do:
     6830     print-type = "".
     6831     define variable v-curr-r-b as character no-undo .
     6832     define variable v-base-type like ub.currency.curr-abbr no-undo .
     6833     define variable v-base-code like ub.currency.curr-code no-undo .
     6834     define buffer buf_currency for ub.currency.
     6835   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6836   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6837     (output v-curr-r-b
     6838     )  .
     6839     if v-curr-r-b = 'base':U then do:
     6840       if par-mode = 'все':U then do:
     6841       end.
     6842       else do:
     6843   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6844   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6845     (input  parhost-code
     6846     ,output v-base-code
     6847     )  .
     6848         find first buf_currency where
     6849                 buf_currency.curr-code = v-base-code.
     6850         assign
     6851         v-base-type = buf_currency.curr-abbr.
     6852       end.
     6853     end.
     6854     v-doc-rec = recid( ink-doc ).
     6855     DO WHILE available ink-doc :
     6856       GET prev br-docs.
     6857     END.
     6858     run PrintListProc in this-procedure ( input v-curr-r-b, input v-base-type) no-error.
     6859     reposition br-docs to recid v-doc-rec no-error.
     6860     apply "entry" to br-docs in frame Dialog-Frame.
     6861   end.
     6862   end case.
     6863   loc-option = ''.
     6864   END PROCEDURE.
     6865   PROCEDURE proc-b-sch :
     6866   define variable l-shift-on as logical no-undo .
     6867   define variable cas-shft as logical no-undo .
     6868   define variable v-param-type as character no-undo .
     6869   define variable v-value-character as character no-undo .
     6870   define variable v-value-date as date no-undo .
     6871   define variable v-value-decimal as decimal no-undo .
     6872   define variable v-value-integer as INTEGER no-undo .
     6873   define variable v-value-logical AS LOGICAL no-undo .
     6874   define variable v-tth as handle no-undo .
     6875   assign
     6876   tbl = 'inkas'
     6877   join-tbl = 'ink-doc'
     6878   fld = ""
     6879   lab = ""
     6880   spr = ""
     6881   dim = '0'
     6882   .
     6883   run fltfield-add in this-procedure('inkas-code', '', '',
     6884   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6885   run fltfield-add in this-procedure('doc-date', '', '',
     6886   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6887   CASE par-mode:
     6888     WHEN  'все':U
     6889     or
     6890     when 'фирма':U
     6891     THEN DO:
     6892       run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     6893       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6894       run fltfield-add in this-procedure('obj-type*obj-code*shift-date*shift-num'
     6895                                         , 'Объект/Дата смены/№ смены'
     6896                                         , ('sht' + chr(4) +
     6897                                            '':U + chr(4) +
     6898                                            string(0) + chr(4) +
     6899                                            'no'),
     6900       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6901     end.
     6902     otherwise do:
     6903   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6905     (input  'маг':U
     6906     ,input  parobj-code
     6907     ,input  'shift-on=request'
     6908     ,output l-shift-on
     6909     )  .
     6910       if not l-shift-on then do:
     6911         for each thbjattr_thbj-attr:
     6912           delete thbjattr_thbj-attr.
     6913         end.
     6914         assign
     6915         v-tth = buffer thbjattr_thbj-attr:table-handle .
     6916         run adm/shattri.p (
     6917              input "get":U
     6918             ,input  parobj-type
     6919             ,input  parobj-code
     6920             ,input  'get-chk':U
     6921             ,input  'cas-shft':U
     6922             ,output v-value-character
     6923             ,output v-value-date
     6924             ,output v-value-decimal
     6925             ,output v-value-integer
     6926             ,output v-value-logical
     6927             ,output v-param-type
     6928             ,INPUT-OUTPUT table-handle v-tth
     6929             ) no-error .
     6930         IF error-status:error then do:
     6931           message
     6932           substitute("Ошибка при получении опций закачки чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
     6933                     , parobj-type
     6934                     , parobj-code
     6935                     , chr(10)
     6936                     , error-status:get-message(1)
     6937                     , return-value )
     6938           view-as alert-box error .
     6939           return error.
     6940         end.
     6941         assign
     6942         cas-shft = v-value-logical.
     6943       end.
     6944       if l-shift-on
     6945       or cas-shft then do:
     6946         run fltfield-add in this-procedure('shift-date*shift-num'
     6947                                           , 'Дата смены/№ смены'
     6948                                           , ('sht' + chr(4) +
     6949                                             parobj-type + chr(4) +
     6950                                             string(parobj-code) + chr(4) +
     6951                                             (if l-shift-on then 'yes' else 'no')),
     6952         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6953       end.
     6954     END.
     6955   END CASE.
     6956   run fltfield-add in this-procedure('shift-date', '', 'Дата смены(учета)',
     6957   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6958   run fltfield-add in this-procedure('shift-num', 'Порядок Смен', '',
     6959   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6960   run fltfield-add in this-procedure('shift-name', '№ Смены', '',
     6961   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6962   run fltfield-add in this-procedure('tot-doc', '', '',
     6963   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6964   run fltfield-add in this-procedure('discnt', '', '',
     6965   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6966   run fltfield-add in this-procedure('sub-discnt', 'Списания', '',
     6967   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6968   run fltfield-add in this-procedure('acc-date', '', '',
     6969   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6970   run fltfield-add in this-procedure('num-chk', '', '',
     6971   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6972   run fltfield-add in this-procedure('qnty', 'Кол-во', '',
     6973   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6974   run fltfield-add in this-procedure('status_', '', '',
     6975   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6976   run fltfield-add in this-procedure('fact-date', '', '',
     6977   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6978   run fltfield-add in this-procedure('office', 'Услуги(для <старых> продаж)', '',
     6979   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6980   run fltfield-add in this-procedure('host-code', '', '',
     6981   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6982   run fltfield-add in this-procedure('netto', '', '',
     6983   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6984   run fltfield-add in this-procedure('user-name', 'Посл.изменил', 'usr',
     6985   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6986   Filter-Block:
     6987   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6988     ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6989     ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6990   run gbl/filter.w (
     6991                    INPUT parparentproc
     6992                  , INPUT (filter-point + chr(4) +
     6993                           filter-label + chr(4)  + string(yes))
     6994                  , INPUT tbl
     6995                  , INPUT join-tbl
     6996                  , INPUT fld
     6997                  , INPUT lab
     6998                  , INPUT spr
     6999                  , INPUT dim ).
     7000   run OpenBr  in this-procedure ( input yes, input no, input '':U).
     7001   END.
     7002   END PROCEDURE.
     7003   PROCEDURE proc-close :
     7004   define input parameter p-direction as logical no-undo .
     7005   define input parameter p-close-type as integer no-undo .
     7006   define input parameter p-status_ like ub.inkas.status_ no-undo .
     7007   define input parameter p-flag_   like ub.trn-doc.flag_ no-undo .
     7008   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
     7009   DEFINE VARIABLE auto-comp AS LOGICAL NO-UNDO.
     7010   DEFINE VARIABLE autofbr AS LOGICAL NO-UNDO.
     7011   DEFINE VARIABLE one-curs AS LOGICAL NO-UNDO.
     7012   DEFINE VARIABLE restdish AS LOGICAL NO-UNDO.
     7013   DEFINE VARIABLE restingr AS LOGICAL NO-UNDO.
     7014   DEFINE VARIABLE resttpsi AS LOGICAL NO-UNDO.
     7015   define variable neg-tpsi-weight as logical no-undo .
     7016   define variable neg-tpsi-oper as logical no-undo .
     7017   define variable neg-tpsi-qnty as decimal no-undo .
     7018   define variable close-in-rfsl as integer no-undo .
     7019   define variable pay-gds-algo as character no-undo .
     7020   DEFINE VARIABLE v-is-tpsi-obj AS LOGICAL NO-UNDO.
     7021   define variable v-loc-rec as recid no-undo .
     7022   define variable v-parameter as character no-undo .
     7023   define variable v-param-type as character no-undo .
     7024   define variable v-value-character as character no-undo .
     7025   define variable v-value-date as date no-undo .
     7026   define variable v-value-decimal as decimal no-undo .
     7027   define variable v-value-integer as INTEGER no-undo .
     7028   define variable v-value-logical AS LOGICAL no-undo .
     7029   define variable v-tth as handle no-undo .
     7030   DEFINE BUFFER buf_shop FOR ub.shop.
     7031   v-loc-rec = recid(ink-doc).
     7032   CASE p-close-type:
     7033     when 1 then do:
     7034       run str/salestat.p (
     7035                           input parparentproc
     7036                         , input ink-doc.inkas-code
     7037                         , input (if p-direction then '<закрытие документа>':U else '<открытие документа>':U)
     7038                         , input p-status_
     7039                         , input p-flag_
     7040                         , input no  ) no-error .
     7041       if error-status:error then do:
     7042         message
     7043         substitute("Ошибка при переводе статуса продажи &1:&2&3 &4"
     7044                    , ink-doc.inkas-code
     7045                    , chr(10)
     7046                    , error-status:get-message(1)
     7047                    , return-value )
     7048         view-as alert-box error .
     7049         undo, return error .
     7050       end.
     7051       run Openbr in this-procedure ( input yes, input no, input '':U).
     7052     end.
     7053     when 2 then do:
     7054       FIND FIRST buf_shop NO-LOCK WHERE
     7055                 buf_shop.obj-code = ink-doc.obj-code .
     7056       run gbl/tpsi-obj.p ( input ink-doc.obj-type, input ink-doc.obj-code, output v-is-tpsi-obj) no-error .
     7057       v-tth = buffer thbjattr_thbj-attr:table-handle .
     7058       for each thbjattr_thbj-attr:
     7059         delete thbjattr_thbj-attr.
     7060       end.
     7061       run adm/shattri.p (
     7062           input "get":U
     7063           ,input  ink-doc.obj-type
     7064           ,input  ink-doc.obj-code
     7065           ,input  'autosale':U
     7066           ,input  "":U
     7067           ,output v-value-character
     7068           ,output v-value-date
     7069           ,output v-value-decimal
     7070           ,output v-value-integer
     7071           ,output v-value-logical
     7072           ,output v-param-type
     7073           ,INPUT-OUTPUT table-handle v-tth
     7074           ) no-error .
     7075       IF error-status:error then do:
     7076         message
     7077         substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     7078                 , ink-doc.obj-type
     7079                 , ink-doc.obj-code
     7080                 , chr(10)
     7081                 , error-status:get-message(1)
     7082                 , return-value )
     7083         view-as alert-box error .
     7084         undo, return error .
     7085       end.
     7086       for each  thbjattr_thbj-attr where
     7087                 thbjattr_thbj-attr.obj-type = ink-doc.obj-type
     7088             and thbjattr_thbj-attr.obj-code = ink-doc.obj-code
     7089             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     7090       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     7091         case thbjattr_thbj-attr.prop-code:
     7092           when 'autocomp':U then do:
     7093             auto-comp = thbjattr_thbj-attr.property-value-logical.
     7094           end.
     7095           when 'autofbr':U then do:
     7096             autofbr = thbjattr_thbj-attr.property-value-logical.
     7097           end.
     7098           when 'one-curs':U then do:
     7099             one-curs = thbjattr_thbj-attr.property-value-logical.
     7100           end.
     7101           when 'restdish':U then do:
     7102             restdish = thbjattr_thbj-attr.property-value-logical.
     7103           end.
     7104           when 'restingr':U then do:
     7105             restingr = thbjattr_thbj-attr.property-value-logical.
     7106           end.
     7107           when 'resttpsi':U then do:
     7108             resttpsi = thbjattr_thbj-attr.property-value-logical.
     7109           end.
     7110           when 'neg-tpsi-weight':U then do:
     7111             neg-tpsi-weight = thbjattr_thbj-attr.property-value-logical.
     7112           end.
     7113           when 'neg-tpsi-oper':U then do:
     7114             neg-tpsi-oper = thbjattr_thbj-attr.property-value-logical.
     7115           end.
     7116           when 'neg-tpsi-qnty':U then do:
     7117             neg-tpsi-qnty = thbjattr_thbj-attr.property-value-decimal.
     7118           end.
     7119           when 'close-in-rfsl':U then do:
     7120             close-in-rfsl = thbjattr_thbj-attr.property-value-integer.
     7121           end.
     7122           when 'pay-gds-algo':U then do:
     7123             pay-gds-algo = thbjattr_thbj-attr.property-value-character.
     7124           end.
     7125         end case.
     7126         assign
     7127         restdish = restdish and autofbr
     7128         restingr = restingr and autofbr
     7129         resttpsi = resttpsi and v-is-tpsi-obj
     7130         .
     7131       end.
     7132       assign
     7133       v-parameter =     v-curr-r-b                      + chr(4) +
     7134                         ink-doc.inkas-code              + chr(4) +
     7135                       string(1)              + chr(4) +
     7136                       string(YES)        + chr(4) +
     7137                       string(no)     + chr(4) +
     7138                       string(auto-comp)                + chr(4) +
     7139                       string(autofbr)                  + chr(4) +
     7140                       string(one-curs)                 + chr(4) +
     7141                       string(buf_shop.is-catering)     + chr(4) +
     7142                       string(v-is-tpsi-obj)            + chr(4) +
     7143                       string(restdish)                 + chr(4) +
     7144                       string(restingr)                 + chr(4) +
     7145                       string(resttpsi)                 + chr(4) +
     7146                       string(neg-tpsi-weight)          + chr(4) +
     7147                       string(neg-tpsi-qnty)            + chr(4) +
     7148                       string(neg-tpsi-oper)            + chr(4) +
     7149                       string(close-in-rfsl)            + chr(4) +
     7150                       pay-gds-algo
     7151       .
     7152       run str/diallog.w (
     7153             input parParentProc
     7154           , input this-procedure
     7155           , input ("str/saleclos.p":U + chr(4) +
     7156                   "1":U  + chr(4) +
     7157                   "1":U + chr(4) +
     7158                   "1":U)
     7159           , input v-parameter
     7160           , input no
     7161           , input "":U
     7162           , input substitute("Закрытие продажи &1 &2&3", Ink-doc.inkas-code, ink-doc.obj-type, ink-doc.obj-code)
     7163       ) no-error.
     7164       if error-status:error
     7165       and return-value <> "error"
     7166       then do:
     7167         message
     7168         substitute("&1 &2"
     7169                   , error-status:get-message(1)
     7170                   , return-value )
     7171         view-as alert-box error .
     7172         return error .
     7173       end.
     7174       if return-value = "error":U then do:
     7175         return error .
     7176       end.
     7177       else do:
     7178         run Openbr in this-procedure ( input yes, input no, input '':U).
     7179       end.
     7180     end.
     7181   END CASE.
     7182   reposition br-docs to recid v-loc-rec no-error.
     7183   apply "entry" to br-docs in frame Dialog-Frame .
     7184   Apply "value-changed" to br-docs in frame Dialog-Frame .
     7185   END PROCEDURE.
     7186   PROCEDURE Proc-find-code :
     7187   define input parameter par-next as logical no-undo.
     7188   define input parameter pardoc-code like ub.inkas.inkas-code no-undo.
     7189   display
     7190   "  /  /":U @ sch-date
     7191   "  /  /":U @ sch-fact
     7192   with frame Dialog-Frame.
     7193   assign
     7194   pardoc-code = chr(34) + pardoc-code + chr(34).
     7195   run OpenBr in this-procedure
     7196     (input false
     7197     ,input par-next
     7198     ,input substitute("and ink-doc.inkas-code   begins &1 "
     7199       , pardoc-code)
     7200     ).
     7201   apply "entry":u to sch-code in frame Dialog-Frame .
     7202   END PROCEDURE.
     7203   PROCEDURE proc-find-date :
     7204   define input parameter par-next as logical no-undo.
     7205   define input parameter par-date like ub.inkas.doc-date no-undo.
     7206   define input parameter parwhat-date as character no-undo.
     7207   define variable var-datechr as character no-undo.
     7208   display
     7209   '':U @ sch-code
     7210   with frame Dialog-Frame.
     7211   assign
     7212   var-datechr = string(day(par-date)) + chr(47) +
     7213                 string(month(par-date)) + chr(47) +
     7214                 string(year(par-date)).
     7215   case parwhat-date:
     7216     when "doc-date":U then do:
     7217       display
     7218       "  /  /":U @ sch-fact
     7219       with frame Dialog-Frame.
     7220       run OpenBr in this-procedure
     7221       (input false
     7222       ,input par-next
     7223       ,input substitute("and ink-doc.doc-date = &1 "
     7224         , var-datechr)
     7225       ).
     7226       apply "entry":u to sch-date in frame Dialog-Frame.
     7227     end.
     7228     when "fact-date":U then do:
     7229       display
     7230       "  /  /":U @ sch-date
     7231       with frame Dialog-Frame.
     7232       run OpenBr in this-procedure
     7233         (input false
     7234         ,input par-next
     7235         ,input substitute("and ink-doc.fact-date = &1 "
     7236         , var-datechr)
     7237         ).
     7238       apply "entry":u to sch-fact in frame Dialog-Frame.
     7239     end.
     7240   END.
     7241   END PROCEDURE.
     7242   PROCEDURE reopen-query :
     7243   if available ink-doc then v-doc-rec = recid(ink-doc).
     7244   run OpenBr in this-procedure ( input  yes, input no, input '':U).
     7245   reposition br-docs to recid v-doc-rec no-error.
     7246   END PROCEDURE.
     7247   PROCEDURE reposition-inkas :
     7248   define input  parameter p-direction   as character no-undo .
     7249   define output parameter p-inkas-recid as recid no-undo .
     7250     case p-direction :
     7251       when "first":U
     7252       then do:
     7253         get first br-docs.
     7254       end.
     7255       when "last":U
     7256       then do:
     7257         get last br-docs.
     7258       end.
     7259       when "prev":U
     7260       then do:
     7261         get prev br-docs.
     7262         if not available ink-doc then do:
     7263           message
     7264           "Это первый документ списка"
     7265           view-as alert-box.
     7266         end.
     7267       end.
     7268       when "next":U
     7269       then do:
     7270         get next br-docs.
     7271         if not available ink-doc then do:
     7272           message
     7273           "Это последний документ списка"
     7274           view-as alert-box.
     7275         end.
     7276       end.
     7277     end case .
     7278     assign
     7279     p-inkas-recid = recid(ink-doc)
     7280     .
     7281     run reposition-query in this-procedure
     7282       (input p-inkas-recid
     7283       ).
     7284   END PROCEDURE.
     7285   PROCEDURE reposition-query :
     7286   define input parameter p-recid as recid no-undo .
     7287     if p-recid <> ?
     7288     then do:
     7289       reposition br-docs to recid p-recid no-error.
     7290     end.
     7291     do with frame Dialog-Frame:
     7292       apply "entry":u to browse BR-docs .
     7293       apply "VALUE-CHANGED":u to browse BR-docs .
     7294     end.
     7295   END PROCEDURE.
