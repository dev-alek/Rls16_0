     2616   ON CHOOSE OF B-export IN FRAME Dialog-Frame
     2617   DO:
     2618   if not avail ink-doc then return no-apply.
     2619     if export-option = '':U then do:
     2620           run gbl/pop-up.p ( input self:handle, input no) no-error.
     2621     end.
     2622     if export-option = '':U then return no-apply.
     2623     run proc-b-export in this-procedure ( input export-option) no-error.
     2624     if error-status:error then do:
     2625       export-option = '':U.
     2626       return no-apply.
     2627     end.
     2628     APPLY "ENTRY" to br-docs.
     2629   END.
     2630   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     2631   DO:
     2632    if not available ink-doc then return no-apply.
     2633     run proc-b-hist in this-procedure no-error.
     2634     if error-status:error then do:
     2635       hist-option = '':U.
     2636       return no-apply.
     2637     end.
     2638     APPLY "ENTRY" to br-docs.
     2639   END.
     2640   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     2641   DO:
     2642   define variable glog as logical no-undo .
     2643   define variable v-handle as handle no-undo .
     2644   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2645   do:
     2646     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2647       (input  v-cntxt-db-num
     2648       ,input  v-cntxt-userid
     2649       ,input  0
     2650       ,input  'actn_sale_lookup':U
     2651       ,input  'object':U
     2652       ,input  ink-doc.host-code
     2653       ,input  ink-doc.obj-type
     2654       ,input  ink-doc.obj-code
     2655       ,input  0
     2656       ,input  0
     2657       ,input  0
     2658       ,input  true
     2659       ,output glog
     2660       )  .
     2661   end.
     2662    if NOT glog then  return no-apply.
     2663      assign
     2664      next-prev = '':U.
     2665      v-handle = this-procedure :handle.
     2666     DO WHILE next-prev = '':U:
     2667       if NOT available ink-doc then do:
     2668           message "Неправильный выбор кассового отчета."
     2669                           view-as alert-box WARNING .
     2670           return no-apply.
