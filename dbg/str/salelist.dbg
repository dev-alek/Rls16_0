      883   function breakstr returns character ( input        for-name    as character,
      884                                         input        line-length as integer,
      885                                         input-output line1       as character,
      886                                         input-output line2       as character ) :
      887     define variable ii as integer no-undo.
      888     if length( for-name ) > line-length then do:
      889       assign ii    = 1
      890              line1 = "":u
      891              line2 = "":u.
      892       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      893         assign line1 =       substring( for-name, 1, line-length     )
      894                line2 = trim( substring( for-name,    line-length + 1 ) ).
      895       end.                                                     else do:
      896         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      897           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      898                  ii    = ii    + 1.
      899           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      900             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      901           end.
      902         end.
      903         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      904       end.
      905     end.                                else do:
      906       assign line1 = for-name
      907              line2 = "":u.
      908     end.
      909     return ( line1 ).
      910   end function.
      911   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      912   procedure fltfield-clear :
      913     define output parameter loc-fld as character no-undo.
      914     define output parameter loc-lab as character no-undo .
      915     define output parameter loc-spr as character no-undo .
      916     define output parameter loc-dim as character no-undo .
      917     assign
      918       loc-fld = ""
      919       loc-lab = ""
      920       loc-spr = ""
      921       loc-dim = "0"
      922     .
      923   end procedure .
      924   procedure fltfield-add :
      925     define input        parameter par-fld as character no-undo.
      926     define input        parameter par-lab as character no-undo .
      927     define input        parameter par-spr as character no-undo .
      928     define input-output parameter loc-fld as character no-undo.
      929     define input-output parameter loc-lab as character no-undo .
      930     define input-output parameter loc-spr as character no-undo .
      931     define input-output parameter loc-dim as character no-undo .
      932     do
      933     on error undo, return error
      934     :
      935       assign
      936       loc-fld = if loc-dim = '0'
      937                 then par-fld
      938                 else (loc-fld + chr(44) + par-fld)
      939       loc-lab = if loc-dim = '0'
      940                 then par-lab
      941                 else (loc-lab + chr(44) + par-lab)
      942       loc-spr = if loc-dim = '0'
      943                 then par-spr
      944                 else (loc-spr + chr(44) + par-spr)
      945       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      946                 string(integer(if num-entries(loc-dim) > 1
      947                               then entry(2, loc-dim)
      948                               else entry(1, loc-dim)
      949                               ) + 1)
      950       no-error
      951       .
      952     end.
      953   end procedure.
      954   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   define variable v-waitfram-action01         as character   no-undo .
      956   define variable v-waitfram-action02         as character   no-undo .
      957   define variable v-waitfram-action03         as character   no-undo .
      958   define variable mWaitFramTextBeg            as character   no-undo.
      959   define variable mWaitFramTextEnd            as character   no-undo.
      960   define variable mWaitFramView               as logical     no-undo.
      961   define variable mWaitProcEvent              as logical     no-undo init yes.
      962   define variable mWaitFramInterval           as integer     no-undo init 1 .
      963   define variable mWaitFramStop               as logical     no-undo.
      964   define variable mWaitFramStopUser           as logical     no-undo.
      965   define variable mWaitFramStopTimeOut        as logical     no-undo.
      966   define variable mWaitFramStartProc          as datetime-tz no-undo.
      967   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      968   define button B-WaitFramStop auto-end-key
      969        label "Стоп"
      970        size 10 by 1 tooltip "Остоновить процесс".
      971   define button B-viewProcInfo
      972        label "Информация"
      973        size 15 by 1 tooltip "Информация о процесс".
      974   define frame waitfram
      975     v-waitfram-action01 format "x(72)" no-label skip
      976     v-waitfram-action02 format "x(72)" no-label skip
      977     v-waitfram-action03 format "x(72)" no-label skip
      978     B-viewProcInfo
      979     B-WaitFramStop at row 4 col 30
      980     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      981     .
      982   define new global shared variable mBatchMode as logical no-undo init ?.
      983   define variable mFramBachModHandle as handle no-undo.
      984   mFramBachModHandle = frame waitfram:handle.
      985   define variable mFameOldVis as logical no-undo.
      986   define variable mVisCUrentVin as logical no-undo.
      987   if session:batch-mode
      988   then
      989      mBatchMode = yes.
      990   if mBatchMode = ? then do:
      991     mVisCUrentVin = current-window:visible.
      992     mFameOldVis = mFramBachModHandle:visible.
      993     mFramBachModHandle:visible  = yes.
      994     mBatchMode = mFramBachModHandle:visible ne yes.
      995     mFramBachModHandle:visible = mFameOldVis.
      996     current-window:visible = mVisCUrentVin.
      997   end.
      998    if  log-manager:logfile-name ne ?
      999     then DO:
     1000         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1001         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1002         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1003     end.
     1004   on choose of B-WaitFramStop in frame waitfram
     1005   do:
     1006     mWaitFramStop = yes.
     1007     mWaitFramStopUser = yes.
     1008   end.
     1009   function waitfram-check-timeout returns logical():
     1010      define variable vtime as int64 no-undo.
     1011      if mWaitFramStopTimeOut
     1012      then
     1013         return yes.
     1014      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1015      if     mWaitFramTimeOut ne ?
     1016         and mWaitFramTimeOut ne 0
     1017         and mWaitFramTimeOut lt vtime
     1018      then do:
     1019         mWaitFramStopTimeOut = yes.
     1020      end.
     1021      return mWaitFramStopTimeOut.
     1022   end.
     1023   procedure waitfram-hide :
     1024     if not session:batch-mode
     1025     then do
     1026     on error undo, return error return-value
     1027     :
     1028       pause 0 before-hide .
     1029       if not mBatchMode then
     1030         hide frame waitfram .
     1031     if     not mWaitFramView
     1032        and mWaitProcEvent
     1033     then
     1034       process events .
     1035     end.
     1036   end procedure.
     1037   procedure waitfram-show :
     1038     define input  parameter p-message as character no-undo .
     1039     define variable v-left-margin as integer   no-undo .
     1040     if not session:batch-mode
     1041     then do
     1042     on error undo, return error return-value
     1043     :
     1044       if length(p-message) <= 70 then do:
     1045         assign
     1046           v-left-margin = integer((70 - length(p-message)) / 2)
     1047         .
     1048         assign
     1049           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1050         .
     1051         assign
     1052           v-waitfram-action01 = " "
     1053           v-waitfram-action02 = " "
     1054                                    + fill(" ", v-left-margin)
     1055                                    + p-message
     1056           v-waitfram-action03 = " "
     1057         .
     1058       end.
     1059       else do:
     1060         define variable vRindex1 as integer no-undo.
     1061         define variable vRindex2 as integer no-undo.
     1062         vRindex1 = r-index(p-message," ",70).
     1063         if vRindex1 = 0
     1064         then
     1065            vRindex1 = 70.
     1066         if length(p-message)  <= vRindex1 + 70 then do:
     1067           assign
     1068             v-waitfram-action01 = " "
     1069             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1070             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1071           .
     1072         end.
     1073         else do:
     1074           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1075           if vRindex2 <= vRindex1
     1076           then
     1077              vRindex2 = vRindex1 + 70.
     1078           assign
     1079             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1080             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1081             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1082           .
     1083         end.
     1084       end.
     1085       B-viewProcInfo:visible   in frame waitfram = no.
     1086       B-viewProcInfo:sensitive in frame waitfram = no.
     1087       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1088       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1089       if  (   mWaitFramView
     1090          or  mWaitProcEvent)
     1091          and not mBatchMode
     1092       then
     1093          display
     1094             v-waitfram-action01 skip
     1095             v-waitfram-action02 skip
     1096             v-waitfram-action03 skip
     1097          with frame waitfram .
     1098       if     mWaitFramView
     1099          then do:
     1100             if     mWaitFramInterval ne ?
     1101                and not mBatchMode
     1102             then
     1103                wait-for go of frame waitfram pause mWaitFramInterval.
     1104          end.
     1105          else
     1106             if     mWaitProcEvent
     1107                and not mBatchMode
     1108             then
     1109                process events .
     1110     end.
     1111   end procedure.
     1112      procedure waitfram-show-this:
     1113         define input  parameter iInterval as int64 no-undo.
     1114         define variable vtime as int64 no-undo.
     1115         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1116         mWaitFramInterval = iInterval.
     1117         run waitfram-show (substitute("&1&2 &3&4" ,
     1118                                       mWaitFramTextBeg ,
     1119                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1120                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1121                                       mWaitFramTextEnd
     1122                                      )
     1123                           ).
     1124      end.
     1125      procedure WaitFramRunPause:
     1126         define input  parameter iInterval as dec no-undo.
     1127         define variable vStart  as datetime-tz no-undo.
     1128         define variable vend    as datetime-tz no-undo.
     1129         define variable vint as int64 no-undo.
     1130         define variable vOk as logical no-undo.
     1131         vStart = now.
     1132         vend   = vStart.
     1133         publish "WaitFramPause" (iInterval,output vOk).
     1134         vend   =  now.
     1135         vint = vend - vStart.
     1136         vint = iInterval - vint / 1000.
     1137         if     not mWaitFramStop
     1138            and (   vint > 0
     1139                 or (    not vOk
     1140                     and iInterval eq ?
     1141                     )
     1142                 )
     1143         then
     1144            run waitfram-show-this (iInterval).
     1145         vend   =  now.
     1146         vint = vend - vStart.
     1147         vint = iInterval - vint / 1000.
     1148         if     not mWaitFramStop
     1149            and vint > 0
     1150         then do:
     1151            run gbl/pause.p (vint * 1000).
     1152         end.
     1153         if iInterval ne ?
     1154         then
     1155            publish "WaitFramStop".
     1156         waitfram-check-timeout().
     1157      end.
     1158      procedure WaitFramWaitFor:
     1159         define input  parameter iInterval as dec no-undo.
     1160         assign
     1161            mWaitFramStartProc   = now
     1162            mWaitFramStopUser    = no
     1163            mWaitFramStopTimeOut = no
     1164         .
     1165         block-wait:
     1166         do while not mWaitFramStop:
     1167            run WaitFramRunPause (iInterval).
     1168            if  waitfram-check-timeout()
     1169            then do:
     1170               leave block-wait.
     1171            end.
     1172         end.
     1173         run waitfram-hide.
     1174      end.
     1175   procedure waitfram-join :
     1176     define input  parameter p-line-1  as character no-undo .
     1177     define input  parameter p-line-2  as character no-undo .
     1178     define input  parameter p-line-3  as character no-undo .
     1179     define output parameter p-message as character no-undo .
     1180     do
     1181     on error undo, return error return-value
     1182     :
     1183       assign
     1184         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1185                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1186                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1187       .
     1188     end.
     1189   end procedure.
     1190   function waitfram-join-function returns character
     1191     (input p-line-1 as character
     1192     ,input p-line-2 as character
     1193     ,input p-line-3 as character
     1194     ).
     1195     define variable v-message as character no-undo .
     1196     run waitfram-join in this-procedure
     1197       (input  p-line-1
     1198       ,input  p-line-2
     1199       ,input  p-line-3
     1200       ,output v-message
     1201       ) .
     1202     return v-message .
     1203   end function .
