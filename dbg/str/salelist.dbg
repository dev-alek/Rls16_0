     1900   FUNCTION mark-string RETURNS CHARACTER
     1901     ( input p-recid as recid, input mark-list as character  ) :
     1902     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1903   END FUNCTION.
     1904   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1905   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1906   procedure fltopend_fltopend :
     1907   define input parameter p-parent-handle as handle no-undo .
     1908   define input parameter p-qh as handle no-undo .
     1909   define input parameter p-flt-open-open-query  as character no-undo .
     1910   define input parameter p-where-cond as character no-undo .
     1911   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1912   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1913   define input parameter p-indexed-reposition as character no-undo .
     1914     do
     1915     on error undo, return error
     1916     :
     1917   define variable v-prepare-string as character no-undo .
     1918   define variable glog as logical no-undo .
     1919   assign
     1920   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1921                      p-where-cond + chr(32)  +
     1922                      p-use-indFIRST-query-tail + chr(32) +
     1923                      p-use-ind-sort-clmn-by + chr(32) +
     1924                      p-indexed-reposition
     1925   .
     1926   assign
     1927   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1928   if not glog
     1929   or error-status:error then do:
     1930     message error-status:get-message(1) view-as alert-box .
     1931     undo, return error .
     1932   end.
     1933   assign
     1934   glog = p-qh:query-open no-error .
     1935   if not glog
     1936   or error-status:error then do:
     1937     message error-status:get-message(1) view-as alert-box .
     1938     undo, return error .
     1939   end.
     1940     end.
     1941   end procedure.
     1942   procedure fltopend_fltfindd :
     1943   define input parameter p-parent-handle as handle no-undo .
     1944   define input parameter p-qh as handle no-undo .
     1945   define input parameter p-rowid as rowid no-undo .
     1946   define input parameter p-next as logical no-undo .
     1947   define input parameter p-lock as integer no-undo .
     1948   define input parameter p-bh as handle no-undo .
     1949   define input parameter p-where-cond as character no-undo .
     1950   define input parameter p-use-index-phrase as character no-undo .
     1951   define variable glog as logical no-undo .
     1952   define variable v-qh as handle no-undo .
     1953   define variable v-bh as handle no-undo .
     1954   define variable v-recid as recid no-undo .
     1955   define variable v-prepare-string as character no-undo .
     1956   do
     1957   on error undo, return error
     1958   on stop undo, return error
     1959   :
     1960     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1961     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1962     create query v-qh.
     1963     v-qh:set-buffers(v-bh).
     1964     v-prepare-string = substitute("for each &1 &2 &3"
     1965                                     ,v-bh:name
     1966                                     ,p-where-cond
     1967                                     ,p-use-index-phrase).
     1968     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1969     if not glog then do:
     1970       delete object v-qh.
     1971       delete object v-bh.
     1972       undo, return error .
     1973     end.
     1974     glog = v-qh:query-open no-error .
     1975     if not glog then do:
     1976       delete object v-qh.
     1977       delete object v-bh.
     1978       undo, return error .
     1979     end.
     1980     if p-next then do:
     1981       v-qh:reposition-to-rowid(p-rowid) no-error .
     1982       glog = v-qh:get-next( p-lock) no-error .
     1983       glog = v-qh:get-next( p-lock) no-error .
     1984       if not glog or v-qh:query-off-end = yes then do:
     1985         glog = v-qh:get-first( p-lock) no-error .
     1986       end.
     1987     end.
     1988     else do:
     1989       glog = v-qh:get-first( p-lock) no-error .
     1990     end.
     1991     v-recid = v-bh:recid no-error .
     1992     delete object v-qh.
     1993     delete object v-bh.
     1994     return string(v-recid) .
     1995   end.
     1996   end procedure.
     1997   procedure fltopend_fltfindq :
     1998   define input parameter p-parent-handle as handle no-undo .
     1999   define input parameter p-qh as handle no-undo .
     2000   define input parameter p-next as logical no-undo .
     2001   define input parameter p-lock as integer no-undo .
     2002   define input parameter p-flt-open-open-query  as character no-undo .
     2003   define input parameter p-where-cond as character no-undo .
     2004   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2005   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2006   define input parameter p-indexed-reposition as character no-undo .
     2007   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2008   define variable glog as logical no-undo .
     2009   define variable v-qh as handle no-undo .
     2010   define variable v-bh as handle no-undo extent 18.
     2011   define variable v-rowid as rowid no-undo extent 18.
     2012   define variable v-ii as integer no-undo .
     2013   define variable v-prepare-string as character no-undo .
     2014   do
     2015   on error undo, return error
     2016   on stop undo, return error
     2017   :
     2018     create query v-qh.
     2019     do v-ii = 1 to p-qh:num-buffers:
     2020       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2021       assign
     2022       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2023       no-error.
     2024       v-qh:add-buffer(v-bh[v-ii]).
     2025     end.
     2026     assign
     2027     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2028                       p-where-cond + chr(32)  +
     2029                       p-use-indFIRST-query-tail + chr(32) +
     2030                       p-use-ind-sort-clmn-by + chr(32) +
     2031                       p-indexed-reposition
     2032     .
     2033     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2034     if not glog then do:
     2035       delete object v-qh.
     2036       do v-ii = 1 to p-qh:num-buffers:
     2037         delete object v-bh[v-ii].
     2038       end.
     2039       undo, return error .
     2040     end.
     2041     glog = v-qh:query-open no-error .
     2042     if not glog then do:
     2043       delete object v-qh.
     2044       do v-ii = 1 to p-qh:num-buffers:
     2045         delete object v-bh[v-ii].
     2046       end.
     2047       undo, return error .
     2048     end.
     2049     if p-next then do:
     2050       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2051       glog = v-qh:get-next( p-lock) no-error .
     2052       glog = v-qh:get-next( p-lock) no-error .
     2053       if not glog or v-qh:query-off-end = yes then do:
     2054         glog = v-qh:get-first( p-lock) no-error .
     2055       end.
     2056     end.
     2057     else do:
     2058       glog = v-qh:get-first( p-lock) no-error .
     2059     end.
     2060     do v-ii = 1 to p-qh:num-buffers:
     2061       assign
     2062       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2063       no-error.
     2064     end.
     2065     delete object v-qh.
     2066     do v-ii = 1 to p-qh:num-buffers:
     2067       delete object v-bh[v-ii].
     2068     end.
     2069   end.
     2070   end procedure.
     2071   define variable filter-label as character no-undo init "Продажи " .
