      422   def
      423   new shared
      424   temp-table  obj-list no-undo
      425     field obj-type like ub.clients.obj-type
      426     field obj-code like ub.clients.obj-code
      427     field obj-name like ub.clients.obj-name
      428     field obj-id   as integer
