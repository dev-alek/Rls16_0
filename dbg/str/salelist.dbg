     2672       run str/sale.w ( input parparentproc
     2673                       , input 'ПРОСМОТР':U
     2674                       , input-output v-doc-rec
     2675                       , input-output v-handle
     2676                       , input-output next-prev
     2677                       , buffer ink-doc
     2678                       ).
     2679     end.
     2680     apply "entry" to br-docs in frame Dialog-Frame.
     2681     apply "iteration-changed" to br-docs in frame Dialog-Frame.
     2682   END.
     2683   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2684   DO:
     2685   define variable glog as logical no-undo .
     2686     if available ink-doc then do:
     2687   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   define variable v-str-recid32 as character no-undo .
     2689   define variable v-num-entry32 as integer   no-undo .
     2690   assign
     2691     v-str-recid32 = trim( string( recid( ink-doc ) , "->>>>>>>>>>>9":U ) )
     2692     v-num-entry32 = lookup( v-str-recid32 , v-rid-list )
     2693   .
     2694   if v-num-entry32 > 0 then do:
     2695     assign
     2696       entry( v-num-entry32, v-rid-list ) = "":U
     2697       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2698     .
     2699   end.
     2700   else do:
     2701     assign
     2702       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid32
     2703     .
     2704   end.
     2705       glog = br-docs:refresh() .
     2706       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2707           glog = br-docs:select-next-row ().
     2708           apply "iteration-changed" to br-docs in frame Dialog-Frame.
     2709       end.
     2710       if num-entries( v-rid-list ) = 0
     2711       then
     2712           hide mark-num in frame Dialog-Frame.
     2713       else
     2714           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2715     end.
     2716     apply "entry" to br-docs in frame Dialog-Frame.
     2717   END.
     2718   ON CHOOSE OF B-Open IN FRAME Dialog-Frame
     2719   DO:
     2720    IF NOT AVAILABLE ink-doc THEN RETURN NO-APPLY.
     2721    define variable v-close-type as integer no-undo .
     2722    define variable v-status_ like ub.inkas.status_ no-undo .
     2723    define variable v-flag_ like ub.trn-doc.flag_ no-undo .
     2724    define variable v-ask-message as character no-undo .
     2725    define buffer buf_trn-doc for ub.trn-doc.
     2726    find first buf_trn-doc where
     2727              buf_trn-doc.doc-code = ink-doc.inkas-code.
     2728    run str/salegraf.p (
     2729                   input ink-doc.inkas-code
     2730                  ,input '<открытие документа>':U
     2731                  ,input buf_trn-doc.status_
     2732                  ,input buf_trn-doc.flag_
     2733                  ,output v-status_
     2734                  ,output v-flag_
     2735                  ,output v-ask-message) no-error .
     2736     if error-status:error then do:
     2737       message
     2738       error-status:get-message(1)  skip
     2739       return-value
     2740       view-as alert-box error .
     2741       return no-apply.
     2742     end.
     2743     run gbl/d-askw.w
     2744       (input "Вопрос"
     2745       ,input substitute("Открыть ОТЧЕТ О ПРОДАЖЕ &1&2" +
     2746                         "Дата учета &3&2" +
     2747                         "Ожидаемая факт дата &4"
     2748                        , ink-doc.inkas-code
     2749                        , chr(10)
     2750                        , string(ink-doc.shift-date, '99/99/9999':u)
     2751                        , string(ink-doc.fact-date, '99/99/9999':u)
     2752                        )
     2753       ,input "|^"
     2754       ,input (v-status_ + string(v-flag_, "+/-") + '|':u
     2755             + "Отмена" )
     2756       ,input v-ask-message + "|"
     2757           + "Отмена действия"
     2758       ,input 1
     2759       ,input 2
     2760       ,output v-close-type
     2761       ).
     2762    if v-close-type = 2 then return no-apply.
     2763    run proc-close IN THIS-PROCEDURE ( input no, input v-close-type, input v-status_, input v-flag_) NO-ERROR.
     2764    IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2765   END.
     2766   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2767   DO:
     2768     if not avail ink-doc then return no-apply.
     2769     if print-type = '':U then do:
     2770       run gbl/pop-up.p ( input self:handle, input no) no-error.
     2771     end.
     2772     if print-type = '':U then return no-apply.
     2773     run proc-b-print in this-procedure ( input print-type) no-error.
     2774     if error-status:error then do:
     2775       print-type = '':U.
     2776       return no-apply.
     2777     end.
     2778     APPLY "ENTRY" to br-docs.
     2779   END.
     2780   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2781   DO:
     2782     run proc-b-sch in this-procedure no-error.
     2783     if error-status:error then return no-apply.
     2784   END.
     2785   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     2786   DO:
     2787      if ( available ink-doc ) AND ( v-rid-list = ""
     2788      or
     2789      b-mark:sensitive = no
     2790      ) then
     2791       v-rid-list = string( recid( ink-doc ) ) .
     2792   END.
     2793   ON ANY-PRINTABLE OF BR-docs IN FRAME Dialog-Frame
     2794   DO:
     2795     sch-code:screen-value = sch-code:screen-value + last-event:label.
     2796       apply "entry" to sch-code in frame Dialog-Frame.
     2797   apply "end" to sch-code in frame Dialog-Frame.
     2798   END.
     2799   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     2800   DO:
     2801     if b-mark:sensitive in frame Dialog-Frame then
     2802     APPLY "CHOOSE" to b-mark.
     2803   END.
     2804   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     2805   DO:
     2806     if b-mark:sensitive in frame Dialog-Frame then
     2807     APPLY "CHOOSE" to b-mark.
     2808       else do:
     2809         if b-sel:sensitive in frame Dialog-Frame then
     2810         APPLY "CHOOSE" to b-sel.
     2811       end.
     2812   END.
     2813   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     2814   or MOUSE-SELECT-DBLCLICK OF br-docs IN FRAME Dialog-Frame DO:
     2815     apply "choose" to b-lkp in frame Dialog-Frame.
     2816       return no-apply.
     2817   END.
     2818   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     2819   DO:
     2820   define buffer buf_clients for ub.clients.
     2821     if available ink-doc then do:
     2822       assign
     2823       num-chk = ink-doc.num-chk
     2824       qnty = ink-doc.qnty
     2825       ed-notes = replace(ink-doc.PS, chr(4), chr(32)).
     2826       FIND FIRST buf_clients where
     2827                             buf_clients.obj-type = ink-doc.obj-type AND
     2828                    buf_clients.obj-code = ink-doc.obj-code NO-LOCK NO-ERROR.
     2829       IF avail buf_clients then assign
     2830       shop-name = buf_clients.obj-name.
     2831       else shop-name = string(ink-doc.obj-code).
     2832       display
     2833       ed-notes
     2834       num-chk
     2835       qnty
     2836       shop-name when (par-mode <> 'объект':U and par-mode <> 'новый':U)
     2837       with frame Dialog-Frame .
     2838      end.
     2839      else do:
     2840         ed-notes:screen-value = '':U.
     2841         display
     2842         '':U @ num-chk
     2843         '':U @ qnty
     2844         '':U shop-name
     2845         with frame Dialog-Frame .
     2846      end.
     2847   END.
     2848   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     2849   DO:
     2850   END.
     2851   ON CHOOSE OF MENU-ITEM m-list
     2852   DO:
     2853     assign
     2854     print-type = 'LIST':U.
     2855     APPLY "CHOOSE" to b-print in frame Dialog-Frame.
     2856   END.
     2857   ON CHOOSE OF MENU-ITEM m-one
     2858   DO:
     2859      assign
     2860     print-type = 'ONE':U.
     2861     APPLY "CHOOSE" to b-print in frame Dialog-Frame.
     2862   END.
     2863   ON CHOOSE OF MENU-ITEM m_gen-3
     2864   DO:
     2865   export-option = "m_gen-3".
     2866   run proc-b-export in this-procedure ( input export-option) no-error.
     2867   if error-status:error then do:
     2868     export-option = '':U.
     2869     return no-apply.
     2870   end.
     2871   END.
     2872   ON CHOOSE OF MENU-ITEM m_inquiry
     2873   DO:
     2874       ASSIGN
     2875     add-option = 'запрос':U.
     2876     run proc-b-add IN THIS-PROCEDURE ( INPUT add-option) NO-ERROR.
     2877     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2878   END.
     2879   ON CHOOSE OF MENU-ITEM m_sale
     2880   DO:
     2881       ASSIGN
     2882     add-option = 'касс':U.
     2883     run proc-b-add IN THIS-PROCEDURE ( INPUT add-option) NO-ERROR.
     2884     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2885   END.
     2886   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     2887   DO:
     2888      run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     2889     if error-status:error then return no-apply.
     2890   END.
     2891   ON RETURN OF sch-code IN FRAME Dialog-Frame
     2892   DO:
     2893      run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     2894     if error-status:error then return no-apply.
     2895   END.
     2896   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
     2897   DO:
     2898      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-date, "doc-date") no-error.
     2899     if error-status:error then return no-apply.
     2900   END.
     2901   ON RETURN OF sch-date IN FRAME Dialog-Frame
     2902   DO:
     2903       run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-date, "doc-date":U) no-error.
     2904     if error-status:error then return no-apply.
     2905   END.
     2906   ON CTRL-J OF sch-fact IN FRAME Dialog-Frame
     2907   DO:
     2908      run proc-find-date in this-procedure ( input yes, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     2909     if error-status:error then return no-apply.
     2910   END.
     2911   ON RETURN OF sch-fact IN FRAME Dialog-Frame
     2912   DO:
     2913     run proc-find-date in this-procedure ( input no, input frame Dialog-Frame sch-fact, "fact-date":U) no-error.
     2914     if error-status:error then return no-apply.
     2915   END.
     2916   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2917   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2918   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2919   on help of frame Dialog-Frame
     2920   do:
     2921     run gbl/app_help.p
     2922       (input this-procedure :file-name
     2923       ,input ''
     2924       ,input ?
     2925       ) no-error.
     2926     if error-status :error then do:
     2927       message
     2928         "Ошибка при вызове помощи"
     2929         error-status :get-message(1)
     2930         view-as alert-box .
     2931     end.
     2932   end.
     2933   run minbtn-set in this-procedure .
     2934   on choose of b-help in frame Dialog-Frame
     2935   do:
     2936     apply "help":u to frame Dialog-Frame .
     2937   end.
     2938   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2939   procedure minbtn-set :
     2940       do
     2941           on error undo, return error return-value
     2942           :
     2943           define variable ii              as integer       no-undo .
     2944           define variable fh              as widget-handle no-undo .
     2945           define variable hh              as widget-handle no-undo .
     2946           define variable v-h             as handle        extent 4 no-undo .
     2947           define variable v-name-button   as character     no-undo .
     2948           define variable v-help-old-x    as decimal       no-undo .
     2949           define variable v-help-old-y    as decimal       no-undo .
     2950           define variable v-help-old-size as decimal       no-undo .
     2951           define variable v-frame-width   as decimal       no-undo .
     2952           define variable jj              as integer       no-undo .
     2953           do
     2954               on error undo, return error
     2955               :
     2956               assign
     2957                   v-frame-width = frame Dialog-Frame:width - 0.3
     2958                   fh            = frame Dialog-Frame:first-child
     2959                   hh            = fh:first-child
     2960                   ii            = 1
     2961                   .
     2962               do while valid-handle(hh):
     2963                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2964                   do:
     2965                       case lc(hh:name) :
     2966                           when "b-help" then
     2967                               do:
     2968                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2969                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2970                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2971                                   hh:TOOLTIP = "Помощь" .
     2972                                   v-help-old-x = hh:column .
     2973                                   v-help-old-y = hh:row    .
     2974                                   v-help-old-size = hh:width .
     2975                                   hh:width-chars = 2.5 .
     2976                               end.
     2977                           when "b-print" then
     2978                               do:
     2979                                   hh:load-image("cmp/b-print.bmp":u) .
     2980                                   hh:TOOLTIP = "Печать" .
     2981                                   v-h[ii] = hh:handle .
     2982                                   ii = ii + 1 .
     2983                                   hh:width-chars = 3 .
     2984                               end.
     2985                           when "b-history" or
     2986                           when "b-hist" then
     2987                               do:
     2988                                   hh:load-image("cmp/b-hist.bmp":u) .
     2989                                   hh:TOOLTIP = "История" .
     2990                                   v-h[ii] = hh:handle .
     2991                                   ii = ii + 1 .
     2992                                   hh:width-chars = 3 .
     2993                               end.
     2994                           when "b-sch" then
     2995                               do:
     2996                                   hh:load-image("cmp/b-sch.bmp":u) .
     2997                                   hh:TOOLTIP = "Установка Фильтра" .
     2998                                   v-h[ii] = hh:handle .
     2999                                   ii = ii + 1 .
     3000                                   hh:width-chars = 3 .
     3001                               end.
     3002                           when "b-hist-user" then
     3003                               do:
     3004                                   hh:load-image("cmp/b-hist.bmp":u) .
     3005                                   hh:TOOLTIP = "История пользователя" .
     3006                                   ii = ii + 1 .
     3007                               end.
     3008                       end case.
     3009                   end.
     3010                   hh = hh:next-sibling.
     3011               end.
     3012               b-help:column = v-frame-width - b-help:width-chars.
     3013               jj = 0.
     3014               repeat ii = 4 to 1 by -1 :
     3015                   if valid-handle (v-h[ii] ) then
     3016                   do:
     3017                       jj  = jj + 1 .
     3018                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3019                       v-h[ii]:row    = v-help-old-y .
     3020                   end.
     3021               end.
     3022           end.
     3023       end.
     3024   end procedure.
     3025   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3026   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3027   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3028   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3029   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3030   define variable v-diasize-current-frame-height as decimal   no-undo .
     3031   define variable v-diasize-change-size          as logical   no-undo .
     3032   define variable v-diasize-resize-button        as handle    no-undo .
     3033   define variable v-diasize-wndmax               as logical   no-undo .
     3034   define variable v-diasize-wndstore             as logical   no-undo .
     3035   define variable v-diasize-proc-name            as character no-undo .
     3036   define variable v-diasize-browse-handle        as handle    no-undo .
     3037   define variable v-diasize-browse-number        as integer   no-undo .
     3038   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3039   define temp-table temp-diasize-handle no-undo
     3040     field handle-value  as handle
     3041     field save-position as decimal
     3042     index xpk is primary unique handle-value
     3043     .
     3044   define temp-table temp-browse-handle no-undo
     3045     field browse-type   as character
     3046     field browse-number as integer
     3047     field browse-handle as handle
     3048     field original-size as decimal
     3049     index xpk is primary unique browse-type browse-number
     3050     index xie browse-type browse-handle
     3051   .
     3052   procedure diasize_change-height :
     3053     define input  parameter p-change-value  as decimal   no-undo .
     3054     define input  parameter p-move-resize   as logical   no-undo .
     3055     define variable v-field-group-handle    as handle    no-undo .
     3056     define variable v-object-handle         as handle    no-undo .
     3057     define variable v-frame-height          as decimal   no-undo .
     3058     define variable v-frame-virtual-height  as decimal   no-undo .
     3059     define variable v-browse-height         as decimal   no-undo .
     3060     define variable v-window-height         as decimal   no-undo .
     3061     define variable v-window-virtual-height as decimal   no-undo .
     3062     define variable v-change-sign           as integer   no-undo .
     3063     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3064     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3065     if p-change-value > 0
     3066     then do:
     3067       if frame Dialog-Frame :height + p-change-value
     3068           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3069       then do:
     3070         assign
     3071           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3072                           - (frame Dialog-Frame :height-chars)
     3073         .
     3074         if p-change-value <= 0
     3075         then do:
     3076           run diasize_position-resize-button in this-procedure .
     3077           return .
     3078         end.
     3079       end.
     3080     end.
     3081     if p-change-value < 0
     3082     then do:
     3083       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3084       then do:
     3085         assign
     3086           p-change-value = v-diasize-orig-frame-height
     3087                          - (frame Dialog-Frame :height-chars)
     3088         .
     3089         if p-change-value >= 0
     3090         then do:
     3091           run diasize_position-resize-button in this-procedure .
     3092           return .
     3093         end.
     3094       end.
     3095     end.
     3096     if p-change-value >= 0
     3097     then do:
     3098       assign
     3099         v-change-sign = 1
     3100       .
     3101     end.
     3102     else do:
     3103       assign
     3104         v-change-sign = -1
     3105       .
     3106     end.
     3107     assign
     3108       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3109     .
     3110     if p-change-value = 0
     3111     then do:
     3112       run diasize_position-resize-button in this-procedure .
     3113       return .
     3114     end.
     3115     move_block:
     3116     do
     3117     on error undo move_block, retry move_block
     3118     :
     3119       if retry
     3120       then do:
     3121         do
     3122         on error undo move_block, leave move_block
     3123         :
     3124           if p-change-value > 0
     3125           then do:
     3126             for each buf_temp-diasize-handle
     3127             on error undo, next
     3128             :
     3129               assign
     3130                 v-object-handle = buf_temp-diasize-handle.handle-value
     3131               .
     3132               if v-object-handle <> v-diasize-resize-button
     3133               then do:
     3134                 assign
     3135                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3136                 .
     3137               end.
     3138             end.
     3139             assign
     3140               v-diasize-browse-handle :height = v-browse-height
     3141             .
     3142             for each buf_temp-browse-handle
     3143               where buf_temp-browse-handle.browse-type = 'height':u
     3144             on error undo, next
     3145             :
     3146               assign
     3147                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3148               .
     3149             end.
     3150             assign
     3151               frame Dialog-Frame :height = v-frame-height
     3152             .
     3153             if frame Dialog-Frame :scrollable = true
     3154             then do:
     3155               assign
     3156                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3157               .
     3158             end.
     3159             run diasize_position-resize-button in this-procedure .
     3160           end.
     3161           else do:
     3162             if frame Dialog-Frame :scrollable = true
     3163             then do:
     3164               assign
     3165                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3166               .
     3167             end.
     3168             assign
     3169               frame Dialog-Frame :height = v-frame-height
     3170             .
     3171             assign
     3172               v-diasize-browse-handle :height = v-browse-height
     3173             .
     3174             for each buf_temp-browse-handle
     3175               where buf_temp-browse-handle.browse-type = 'height':u
     3176             on error undo, next
     3177             :
     3178               assign
     3179                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3180               .
     3181             end.
     3182             for each buf_temp-diasize-handle
     3183             on error undo, next
     3184             :
     3185               assign
     3186                 v-object-handle = buf_temp-diasize-handle.handle-value
     3187               .
     3188               if v-object-handle <> v-diasize-resize-button
     3189               then do:
     3190                 assign
     3191                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3192                 .
     3193               end.
     3194             end.
     3195             run diasize_position-resize-button in this-procedure .
     3196           end.
     3197           assign
     3198             v-diasize-change-size = false
     3199           .
     3200           leave move_block .
     3201         end.
     3202       end.
     3203       assign
     3204         v-diasize-need-full-display = true
     3205       .
     3206       if v-diasize-change-size = false
     3207       then do:
     3208         assign
     3209           v-diasize-change-size = true
     3210         .
     3211       end.
     3212       else do:
     3213         return .
     3214       end.
     3215       assign
     3216         v-frame-height = frame Dialog-Frame :height
     3217         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3218         v-browse-height = v-diasize-browse-handle :height
     3219       .
     3220       for each buf_temp-browse-handle
     3221         where buf_temp-browse-handle.browse-type = 'height':u
     3222       :
     3223         assign
     3224           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3225         .
     3226       end.
     3227       for each buf_temp-diasize-handle
     3228       :
     3229         delete buf_temp-diasize-handle .
     3230       end.
     3231       assign
     3232         v-field-group-handle = frame Dialog-Frame :first-child
     3233       .
     3234       do while valid-handle(v-field-group-handle)
     3235       :
     3236         assign
     3237           v-object-handle = v-field-group-handle :first-child
     3238         .
     3239         do while valid-handle(v-object-handle)
     3240         :
     3241           if  v-object-handle <> v-diasize-browse-handle :handle
     3242           and can-query(v-object-handle, "row")
     3243           and can-query(v-object-handle, "height")
     3244           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3245           then do:
     3246             find first buf_temp-browse-handle
     3247               where buf_temp-browse-handle.browse-type   = 'height':u
     3248                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3249               no-error .
     3250             if available buf_temp-browse-handle
     3251             then do:
     3252             end.
     3253             else do:
     3254               create buf_temp-diasize-handle .
     3255               assign
     3256                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3257                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3258               .
     3259             end.
     3260           end.
     3261           assign
     3262             v-object-handle = v-object-handle :next-sibling
     3263           .
     3264         end.
     3265         assign
     3266           v-field-group-handle = v-field-group-handle :next-sibling
     3267         .
     3268       end.
     3269       do with frame Dialog-Frame
     3270       :
     3271         hide v-diasize-resize-button .
     3272         assign
     3273           v-diasize-resize-button :row    = 1
     3274           v-diasize-resize-button :column = 1
     3275         .
     3276       end.
     3277       if p-change-value > 0
     3278       then do:
     3279         if frame Dialog-Frame :scrollable = true
     3280         then do:
     3281           assign
     3282             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3283             no-error .
     3284           if error-status :error
     3285           or error-status :get-message(1) <> ""
     3286           then do:
     3287             undo move_block, retry move_block .
     3288           end.
     3289         end.
     3290         assign
     3291           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3292           no-error .
     3293         if error-status :error
     3294         or error-status :get-message(1) <> ""
     3295         then do:
     3296           undo move_block, retry move_block .
     3297         end.
     3298         assign
     3299           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3300           no-error .
     3301         if error-status :error
     3302         or error-status :get-message(1) <> ""
     3303         then do:
     3304           undo move_block, retry move_block .
     3305         end.
     3306         for each buf_temp-browse-handle
     3307           where buf_temp-browse-handle.browse-type = 'height':u
     3308         on error undo move_block, retry move_block
     3309         :
     3310           assign
     3311             buf_temp-browse-handle.browse-handle :height
     3312               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3313             no-error .
     3314           if error-status :error
     3315           or error-status :get-message(1) <> ""
     3316           then do:
     3317             undo move_block, retry move_block .
     3318           end.
     3319         end.
     3320         for each buf_temp-diasize-handle
     3321         on error undo move_block, retry move_block
     3322         :
     3323           assign
     3324             v-object-handle = buf_temp-diasize-handle.handle-value
     3325           .
     3326           if v-object-handle <> v-diasize-resize-button
     3327           then do:
     3328             assign
     3329               v-object-handle :row = v-object-handle :row + p-change-value
     3330               no-error .
     3331             if error-status :error
     3332             or error-status :get-message(1) <> ""
     3333             then do:
     3334               undo move_block, retry move_block .
     3335             end.
     3336           end.
     3337         end.
     3338       end.
     3339       else do:
     3340         for each buf_temp-diasize-handle
     3341         on error undo move_block, retry move_block
     3342         :
     3343           assign
     3344             v-object-handle = buf_temp-diasize-handle.handle-value
     3345           .
     3346           if v-object-handle <> v-diasize-resize-button
     3347           then do:
     3348             assign
     3349               v-object-handle :row = v-object-handle :row + p-change-value
     3350               no-error .
     3351             if error-status :error
     3352             or error-status :get-message(1) <> ""
     3353             then do:
     3354               undo move_block, retry move_block .
     3355             end.
     3356           end.
     3357         end.
     3358         assign
     3359           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3360           no-error .
     3361         if error-status :error
     3362         or error-status :get-message(1) <> ""
     3363         then do:
     3364           undo move_block, retry move_block .
     3365         end.
     3366         for each buf_temp-browse-handle
     3367           where buf_temp-browse-handle.browse-type = 'height':u
     3368         on error undo move_block, retry move_block
     3369         :
     3370           assign
     3371             buf_temp-browse-handle.browse-handle :height
     3372               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3373             no-error .
     3374           if error-status :error
     3375           or error-status :get-message(1) <> ""
     3376           then do:
     3377             undo move_block, retry move_block .
     3378           end.
     3379         end.
     3380         assign
     3381           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3382           no-error .
     3383         if error-status :error
     3384         or error-status :get-message(1) <> ""
     3385         then do:
     3386           undo move_block, retry move_block .
     3387         end.
     3388         if frame Dialog-Frame :scrollable = true
     3389         then do:
     3390           assign
     3391             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3392             no-error .
     3393           if error-status :error
     3394           or error-status :get-message(1) <> ""
     3395           then do:
     3396             undo move_block, retry move_block .
     3397           end.
     3398         end.
     3399       end.
     3400       if p-move-resize = true
     3401       then do:
     3402         run diasize_position-resize-button in this-procedure .
     3403       end.
     3404       if v-diasize-wndstore = true
     3405       then do:
     3406         if connected("ub") = true
     3407         then do:
     3408           define variable v-cntxt-db-num        as integer   no-undo .
     3409           define variable v-cntxt-userid        as character no-undo .
     3410           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3411                                             , OUTPUT v-cntxt-userid
     3412                                             ) .
     3413           run gbl/wndsizew.p
     3414             (input  v-cntxt-db-num
     3415             ,input  v-cntxt-userid
     3416             ,input  v-diasize-proc-name
     3417             ,input  'height':u
     3418             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3419             ) .
     3420         end.
     3421       end.
     3422     end.
     3423     assign
     3424       v-diasize-change-size = false
     3425     .
     3426   end procedure.
     3427   procedure diasize_set-height :
     3428     define input  parameter p-new-height  as decimal   no-undo .
     3429     define input  parameter p-move-resize as logical   no-undo .
     3430     do
     3431     on error undo, return error return-value
     3432     :
     3433       run diasize_change-height in this-procedure
     3434         (input  (p-new-height - frame Dialog-Frame :height)
     3435         ,input  p-move-resize
     3436         ) .
     3437     end.
     3438   end procedure.
     3439   procedure diasize_change-width :
     3440     define input  parameter p-change-value as decimal   no-undo .
     3441     define input  parameter p-move-resize  as logical   no-undo .
     3442     define variable v-field-group-handle   as handle    no-undo .
     3443     define variable v-object-handle        as handle    no-undo .
     3444     define variable v-frame-width          as decimal   no-undo .
     3445     define variable v-frame-virtual-width  as decimal   no-undo .
     3446     define variable v-browse-width         as decimal   no-undo .
     3447     define variable v-window-width         as decimal   no-undo .
     3448     define variable v-window-virtual-width as decimal   no-undo .
     3449     define variable v-change-sign          as integer   no-undo .
     3450     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3451     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3452     if p-change-value > 0
     3453     then do:
     3454       if frame Dialog-Frame :width + p-change-value >
     3455           session :width-chars
     3456       then do:
     3457         assign
     3458           p-change-value = session :width-chars - frame Dialog-Frame :width
     3459         .
     3460         if p-change-value <= 0
     3461         then do:
     3462           run diasize_position-resize-button in this-procedure .
     3463           return .
     3464         end.
     3465       end.
     3466     end.
     3467     if p-change-value < 0
     3468     then do:
     3469       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3470       then do:
     3471         assign
     3472           p-change-value = v-diasize-orig-frame-width
     3473                          - frame Dialog-Frame :width
     3474         .
     3475         if p-change-value >= 0
     3476         then do:
     3477           run diasize_position-resize-button in this-procedure .
     3478           return .
     3479         end.
     3480       end.
     3481     end.
     3482     if p-change-value >= 0
     3483     then do:
     3484       assign
     3485         v-change-sign = 1
     3486       .
     3487     end.
     3488     else do:
     3489       assign
     3490         v-change-sign = -1
     3491       .
     3492     end.
     3493     assign
     3494       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3495     .
     3496     if p-change-value = 0
     3497     then do:
     3498       run diasize_position-resize-button in this-procedure .
     3499       return .
     3500     end.
     3501     move_block:
     3502     do
     3503     on error undo move_block, leave move_block
     3504     :
     3505       if retry
     3506       then do:
     3507         do
     3508         on error undo move_block, leave move_block
     3509         :
     3510           if p-change-value > 0
     3511           then do:
     3512             for each buf_temp-diasize-handle
     3513             on error undo, next
     3514             :
     3515               assign
     3516                 v-object-handle = buf_temp-diasize-handle.handle-value
     3517               .
     3518               if v-object-handle <> v-diasize-resize-button
     3519               then do:
     3520                 assign
     3521                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3522                 .
     3523               end.
     3524             end.
     3525             assign
     3526               v-diasize-browse-handle :width = v-browse-width
     3527             .
     3528             for each buf_temp-browse-handle
     3529               where buf_temp-browse-handle.browse-type = 'width':u
     3530             on error undo, next
     3531             :
     3532               assign
     3533                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3534               .
     3535             end.
     3536             assign
     3537               frame Dialog-Frame :width = v-frame-width
     3538             .
     3539             if frame Dialog-Frame :scrollable = true
     3540             then do:
     3541               assign
     3542                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3543               .
     3544             end.
     3545             run diasize_position-resize-button in this-procedure .
     3546           end.
     3547           else do:
     3548             if frame Dialog-Frame :scrollable = true
     3549             then do:
     3550               assign
     3551                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3552               .
     3553             end.
     3554             assign
     3555               frame Dialog-Frame :width = v-frame-width
     3556             .
     3557             for each buf_temp-browse-handle
     3558               where buf_temp-browse-handle.browse-type = 'width':u
     3559             on error undo, next
     3560             :
     3561               assign
     3562                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3563               .
     3564             end.
     3565             assign
     3566               v-diasize-browse-handle :width = v-browse-width
     3567             .
     3568             for each buf_temp-diasize-handle
     3569             on error undo, next
     3570             :
     3571               assign
     3572                 v-object-handle = buf_temp-diasize-handle.handle-value
     3573               .
     3574               if v-object-handle <> v-diasize-resize-button
     3575               then do:
     3576                 assign
     3577                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3578                 .
     3579               end.
     3580             end.
     3581             run diasize_position-resize-button in this-procedure .
     3582           end.
     3583           assign
     3584             v-diasize-change-size = false
     3585           .
     3586           leave move_block .
     3587         end.
     3588       end.
     3589       assign
     3590         v-diasize-need-full-display = true
     3591       .
     3592       if v-diasize-change-size = false
     3593       then do:
     3594         assign
     3595           v-diasize-change-size = true
     3596         .
     3597       end.
     3598       else do:
     3599         return .
     3600       end.
     3601       assign
     3602         v-frame-width = frame Dialog-Frame :width
     3603         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3604         v-browse-width = v-diasize-browse-handle :width
     3605       .
     3606       for each buf_temp-browse-handle
     3607         where buf_temp-browse-handle.browse-type = 'width':u
     3608       :
     3609         assign
     3610           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3611         .
     3612       end.
     3613       for each buf_temp-diasize-handle
     3614       :
     3615         delete buf_temp-diasize-handle .
     3616       end.
     3617       assign
     3618         v-field-group-handle = frame Dialog-Frame :first-child
     3619       .
     3620       do while valid-handle(v-field-group-handle)
     3621       :
     3622         assign
     3623           v-object-handle = v-field-group-handle :first-child
     3624         .
     3625         do while valid-handle(v-object-handle)
     3626         :
     3627           if  v-object-handle <> v-diasize-browse-handle :handle
     3628           and v-object-handle <> v-diasize-resize-button
     3629           and can-query(v-object-handle, "row")
     3630           and can-query(v-object-handle, "height")
     3631           and ( v-object-handle :col + v-object-handle :width
     3632                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3633               )
     3634           then do:
     3635             find first buf_temp-browse-handle
     3636               where buf_temp-browse-handle.browse-type   = 'width':u
     3637                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3638               no-error .
     3639             if available buf_temp-browse-handle
     3640             then do:
     3641             end.
     3642             else do:
     3643               create buf_temp-diasize-handle .
     3644               assign
     3645                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3646                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3647               .
     3648             end.
     3649           end.
     3650           assign
     3651             v-object-handle = v-object-handle :next-sibling
     3652           .
     3653         end.
     3654         assign
     3655           v-field-group-handle = v-field-group-handle :next-sibling
     3656         .
     3657       end.
     3658       do with frame Dialog-Frame
     3659       :
     3660         hide v-diasize-resize-button .
     3661         v-diasize-resize-button :row = 1.
     3662         v-diasize-resize-button :column = 1.
     3663       end.
     3664       if p-change-value > 0
     3665       then do:
     3666         if frame Dialog-Frame :scrollable = true
     3667         then do:
     3668           assign
     3669             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3670             no-error .
     3671           if error-status :error
     3672           or error-status :get-message(1) <> ""
     3673           then do:
     3674             undo move_block, retry move_block.
     3675           end.
     3676         end.
     3677         assign
     3678           frame Dialog-Frame :width = v-frame-width + p-change-value
     3679           no-error .
     3680         if error-status :error
     3681         or error-status :get-message(1) <> ""
     3682         then do:
     3683           undo move_block, retry move_block.
     3684         end.
     3685         assign
     3686           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3687         no-error .
     3688         if error-status :error
     3689         or error-status :get-message(1) <> ""
     3690         then do:
     3691           undo move_block, retry move_block.
     3692         end.
     3693         for each buf_temp-browse-handle
     3694           where buf_temp-browse-handle.browse-type = 'width':u
     3695         on error undo move_block, retry move_block
     3696         :
     3697           assign
     3698             buf_temp-browse-handle.browse-handle :width
     3699               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3700             no-error .
     3701           if error-status :error
     3702           or error-status :get-message(1) <> ""
     3703           then do:
     3704             undo move_block, retry move_block .
     3705           end.
     3706         end.
     3707         for each buf_temp-diasize-handle
     3708         on error undo move_block, retry move_block
     3709         :
     3710           assign
     3711             v-object-handle = buf_temp-diasize-handle.handle-value
     3712           .
     3713           if v-object-handle <> v-diasize-resize-button
     3714           then do:
     3715             assign
     3716               v-object-handle :col = v-object-handle :col + p-change-value
     3717               no-error .
     3718             if error-status :error
     3719             or error-status :get-message(1) <> ""
     3720             then do:
     3721               undo move_block, retry move_block .
     3722             end.
     3723           end.
     3724         end.
     3725       end.
     3726       else do:
     3727         for each buf_temp-diasize-handle
     3728         on error undo move_block, retry move_block
     3729         :
     3730           assign
     3731             v-object-handle = buf_temp-diasize-handle.handle-value
     3732           .
     3733           if v-object-handle <> v-diasize-resize-button
     3734           then do:
     3735             assign
     3736               v-object-handle :col = v-object-handle :col + p-change-value
     3737               no-error .
     3738             if error-status :error
     3739             or error-status :get-message(1) <> ""
     3740             then do:
     3741               undo move_block, retry move_block .
     3742             end.
     3743           end.
     3744         end.
     3745         for each buf_temp-browse-handle
     3746           where buf_temp-browse-handle.browse-type = 'width':u
     3747         on error undo move_block, retry move_block
     3748         :
     3749           assign
     3750             buf_temp-browse-handle.browse-handle :width
     3751               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3752             no-error .
     3753           if error-status :error
     3754           or error-status :get-message(1) <> ""
     3755           then do:
     3756             undo move_block, retry move_block .
     3757           end.
     3758         end.
     3759         assign
     3760           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3761           no-error .
     3762         if error-status :error
     3763         or error-status :get-message(1) <> ""
     3764         then do:
     3765           undo move_block, retry move_block.
     3766         end.
     3767         assign
     3768           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3769         no-error .
     3770         if error-status :error
     3771         or error-status :get-message(1) <> ""
     3772         then do:
     3773           undo move_block, retry move_block.
     3774         end.
     3775         if frame Dialog-Frame :scrollable = true
     3776         then do:
     3777           assign
     3778             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3779           no-error .
     3780           if error-status :error
     3781           or error-status :get-message(1) <> ""
     3782           then do:
     3783             undo move_block, retry move_block.
     3784           end.
     3785         end.
     3786       end.
     3787       if p-move-resize
     3788       then do:
     3789         run diasize_position-resize-button in this-procedure .
     3790       end.
     3791       if v-diasize-wndstore = true
     3792       then do:
     3793         if connected("ub") = true
     3794         then do:
     3795           define variable v-cntxt-db-num        as integer   no-undo .
     3796           define variable v-cntxt-userid        as character no-undo .
     3797           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3798                                             , OUTPUT v-cntxt-userid
     3799                                             ) .
     3800           run gbl/wndsizew.p
     3801             (input  v-cntxt-db-num
     3802             ,input  v-cntxt-userid
     3803             ,input  v-diasize-proc-name
     3804             ,input  'width':u
     3805             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3806             ) .
     3807         end.
     3808       end.
     3809     end.
     3810     assign
     3811       v-diasize-change-size = false
     3812     .
     3813   end procedure.
     3814   procedure diasize_set-width :
     3815     define input  parameter p-new-width  as decimal   no-undo .
     3816     define input  parameter p-move-resize as logical   no-undo .
     3817     do
     3818     on error undo, return error return-value
     3819     :
     3820       run diasize_change-width in this-procedure
     3821         (input  (p-new-width - frame Dialog-Frame :width)
     3822         ,input  p-move-resize
     3823         ) .
     3824     end.
     3825   end procedure.
     3826   procedure diasize_position-resize-button :
     3827     do with frame Dialog-Frame
     3828     :
     3829       hide v-diasize-resize-button .
     3830       assign
     3831         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3832                     - 1
     3833                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3834         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3835                     - 1
     3836                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3837       .
     3838       view v-diasize-resize-button .
     3839     end.
     3840   end procedure.
     3841   on alt-right anywhere
     3842   do:
     3843     run diasize_change-width in this-procedure
     3844       (input 1
     3845       ,input true
     3846       ) .
     3847     return no-apply .
     3848   end.
     3849   on alt-left anywhere
     3850   do:
     3851     run diasize_change-width in this-procedure
     3852       (input -1
     3853       ,input true
     3854       ) .
     3855     return no-apply .
     3856   end.
     3857   on alt-down anywhere
     3858   do:
     3859     run diasize_change-height in this-procedure
     3860       (input 1
     3861       ,input true
     3862       ) .
     3863     return no-apply .
     3864   end.
     3865   on alt-up anywhere
     3866   do:
     3867     run diasize_change-height in this-procedure
     3868       (input -1
     3869       ,input true
     3870       ) .
     3871     return no-apply .
     3872   end.
     3873   on alt-enter of frame Dialog-Frame
     3874   do:
     3875     run diasize_maximize in this-procedure
     3876       (input  ?
     3877       ).
     3878     return no-apply .
     3879   end.
     3880   procedure diasize_end-move :
     3881     do
     3882     on error undo, return error return-value
     3883     :
     3884       define variable v-row-delta as decimal   no-undo .
     3885       define variable v-col-delta as decimal   no-undo .
     3886       define variable v-new-row as decimal   no-undo .
     3887       define variable v-new-col as decimal   no-undo .
     3888       assign
     3889         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3890         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3891       .
     3892       assign
     3893         v-row-delta = v-new-row - frame Dialog-Frame :height
     3894         v-col-delta = v-new-col - frame Dialog-Frame :width
     3895       .
     3896       run diasize_change-height in this-procedure
     3897         (input v-row-delta
     3898         ,input true
     3899         ) .
     3900       run diasize_change-width in this-procedure
     3901         (input v-col-delta
     3902         ,input true
     3903         ) .
     3904     end.
     3905   end procedure.
     3906   procedure diasize_maximize :
     3907     define input  parameter p-action as logical   no-undo .
     3908     do
     3909     on error undo, return error return-value
     3910     :
     3911       if p-action = ?
     3912       then do:
     3913         if v-diasize-need-maximize = true
     3914         then do:
     3915           assign
     3916             p-action = true
     3917           .
     3918         end.
     3919         else do:
     3920           assign
     3921             p-action = false
     3922           .
     3923         end.
     3924       end.
     3925       if p-action = true
     3926       then do:
     3927         run diasize_change-height in this-procedure
     3928           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3929               - frame Dialog-Frame :height-chars
     3930           ,input true
     3931           ) .
     3932         run diasize_change-width in this-procedure
     3933           (input session :width-chars
     3934               - frame Dialog-Frame :width-chars
     3935           ,input true
     3936           ) .
     3937         assign
     3938           v-diasize-need-maximize = false
     3939         .
     3940       end.
     3941       else do:
     3942         run diasize_change-width in this-procedure
     3943           (input v-diasize-orig-frame-width
     3944               - frame Dialog-Frame :width-chars
     3945           ,input true
     3946           ) .
     3947         run diasize_change-height in this-procedure
     3948           (input v-diasize-orig-frame-height
     3949               - frame Dialog-Frame :height-chars
     3950           ,input true
     3951           ) .
     3952         assign
     3953           v-diasize-need-maximize = true
     3954         .
     3955       end.
     3956     end.
     3957   end procedure.
     3958   procedure diasize_restore-orig-size :
     3959     do
     3960     on error undo, return error return-value
     3961     :
     3962       assign
     3963         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3964         v-diasize-current-frame-height = frame Dialog-Frame :height
     3965       .
     3966       run diasize_set-height in this-procedure
     3967         (input  v-diasize-orig-frame-height
     3968         ,input  true
     3969         ) .
     3970       run diasize_set-width in this-procedure
     3971         (input  v-diasize-orig-frame-width
     3972         ,input  true
     3973         ) .
     3974     end.
     3975   end procedure.
     3976   procedure diasize_restore-current-size :
     3977     do
     3978     on error undo, return error return-value
     3979     :
     3980       run diasize_set-height in this-procedure
     3981         (input  v-diasize-current-frame-height
     3982         ,input  true
     3983         ) .
     3984       run diasize_set-width in this-procedure
     3985         (input  v-diasize-current-frame-width
     3986         ,input  true
     3987         ) .
     3988     end.
     3989   end procedure.
     3990   procedure diasize_set-browse-handle :
     3991     define input  parameter p-browse-handle as handle   no-undo .
     3992     define buffer buf_temp-browse-handle for temp-browse-handle .
     3993     do
     3994     on error undo, return error return-value
     3995     :
     3996       assign
     3997         v-diasize-browse-handle = p-browse-handle
     3998       .
     3999       for each buf_temp-browse-handle
     4000       on error undo, return error return-value
     4001       :
     4002         delete buf_temp-browse-handle .
     4003       end.
     4004     end.
     4005   end procedure.
     4006   procedure diasize_add_browse :
     4007     define input  parameter p-browse-type   as character no-undo .
     4008     define input  parameter p-browse-handle as handle    no-undo .
     4009     define buffer buf_temp-browse-handle for temp-browse-handle .
     4010     do
     4011     on error undo, return error return-value
     4012     :
     4013       assign
     4014         v-diasize-browse-number = v-diasize-browse-number + 1
     4015       .
     4016       create buf_temp-browse-handle .
     4017       assign
     4018         buf_temp-browse-handle.browse-type   = p-browse-type
     4019         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4020         buf_temp-browse-handle.browse-handle = p-browse-handle
     4021       .
     4022     end.
     4023   end procedure.
     4024   procedure diasize_init :
     4025     define variable v-default-value    as logical   no-undo .
     4026     define variable v-restore-saved    as logical   no-undo .
     4027     define variable v-resize-value-str as character no-undo .
     4028     do
     4029     on error undo, return error return-value
     4030     :
     4031       do with frame Dialog-Frame
     4032       :
     4033         assign
     4034           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4035           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4036           v-diasize-browse-handle     = browse BR-docs :handle
     4037         .
     4038         create button v-diasize-resize-button
     4039         assign
     4040           parent        = frame Dialog-Frame :first-child
     4041           label         = "s"
     4042           height-pixels = 16
     4043           width-pixels  = 16
     4044           visible       = true
     4045           sensitive     = true
     4046           movable       = true
     4047           triggers:
     4048             on end-move persistent run diasize_end-move in this-procedure .
     4049           end triggers.
     4050         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4051         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4052         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4053         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4054         assign
     4055           v-diasize-wndmax = false
     4056         .
     4057         if connected("ub") = true
     4058         then do:
     4059           define variable v-cntxt-db-num        as integer   no-undo .
     4060           define variable v-cntxt-userid        as character no-undo .
     4061           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4062                                             , OUTPUT v-cntxt-userid
     4063                                             ) .
     4064           run gbl/wndpar_r.p
     4065             (input  v-cntxt-db-num
     4066             ,input  v-cntxt-userid
     4067             ,input  'wndmax':U
     4068             ,output v-diasize-wndmax
     4069             ,output v-default-value
     4070             ) .
     4071         end.
     4072         assign
     4073           v-diasize-wndstore = false
     4074         .
     4075         if connected("ub") = true
     4076         then do:
     4077           run gbl/wndpar_r.p
     4078             (input  v-cntxt-db-num
     4079             ,input  v-cntxt-userid
     4080             ,input  'wndstore':U
     4081             ,output v-diasize-wndstore
     4082             ,output v-default-value
     4083             ) .
     4084         end.
     4085         assign
     4086           v-diasize-proc-name = entry(1, program-name(2), '.')
     4087         .
     4088         if v-diasize-wndstore = true
     4089         then do:
     4090           assign
     4091             v-restore-saved = false
     4092           .
     4093           if connected("ub") = true
     4094           then do:
     4095             run gbl/wndsizer.p
     4096               (input  v-cntxt-db-num
     4097               ,input  v-cntxt-userid
     4098               ,input  v-diasize-proc-name
     4099               ,input  'height':u
     4100               ,output v-resize-value-str
     4101               ) .
     4102             if v-resize-value-str <> '':U
     4103             then do:
     4104               run diasize_change-height in this-procedure
     4105                 (input  integer(v-resize-value-str)
     4106                 ,input  true
     4107                 ) .
     4108               assign
     4109                 v-restore-saved = true
     4110               .
     4111             end.
     4112           end.
     4113           if connected("ub") = true
     4114           then do:
     4115             run gbl/wndsizer.p
     4116               (input  v-cntxt-db-num
     4117               ,input  v-cntxt-userid
     4118               ,input  v-diasize-proc-name
     4119               ,input  'width':u
     4120               ,output v-resize-value-str
     4121               ) .
     4122             if v-resize-value-str <> '':U
     4123             then do:
     4124               run diasize_change-width in this-procedure
     4125                 (input  integer(v-resize-value-str)
     4126                 ,input  true
     4127                 ) .
     4128               assign
     4129                 v-restore-saved = true
     4130               .
     4131             end.
     4132           end.
     4133           if v-restore-saved <> true
     4134           then do:
     4135             if v-diasize-wndmax = true
     4136             then do:
     4137               run diasize_maximize in this-procedure
     4138                 (input  true
     4139                 ) .
     4140             end.
     4141           end.
     4142         end.
     4143         else do:
     4144           if v-diasize-wndmax = true
     4145           then do:
     4146             run diasize_maximize in this-procedure
     4147               (input  true
     4148               ) .
     4149           end.
     4150         end.
     4151       end.
     4152     end.
     4153   end procedure.
     4154   procedure diasize_need-full-display :
     4155     define output parameter p-need-full-display as logical   no-undo .
     4156     do
     4157     on error undo, return error return-value
     4158     :
     4159       assign
     4160         p-need-full-display = v-diasize-need-full-display
     4161       .
     4162       assign
     4163         v-diasize-need-full-display = false
     4164       .
     4165     end.
     4166   end procedure.
     4167   procedure get-context :
     4168      define output parameter p-db-num as integer          no-undo.
     4169      define output parameter p-user-id as character        no-undo.
     4170      define variable v-login               as character    no-undo.
     4171      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4172      define buffer buf_user-login  for ub.user-login .
     4173      do
     4174      on error undo, return error
     4175      :
     4176            FIND FIRST buf_sys-ctrl no-lock.
     4177            ASSIGN
     4178               v-login = USERID("ub")
     4179               p-db-num = buf_sys-ctrl.db-num
     4180            .
     4181            FIND FIRST buf_user-login
     4182                 WHERE buf_user-login.db-num = p-db-num
     4183                   AND buf_user-login.user-login = v-login
     4184                 no-lock
     4185                 no-error
     4186                 .
     4187            IF AVAILABLE buf_user-login
     4188            THEN DO:
     4189               assign
     4190                  p-user-id = buf_user-login.user-id
     4191               .
     4192            END.
     4193      end.
     4194   end procedure.
     4195       run diasize_init in this-procedure .
     4196   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4197   on ' ' of sch-date in frame Dialog-Frame
     4198   do:
     4199     if (can-query (self, "sensitive")
     4200        and
     4201        self :sensitive = true
     4202        )
     4203     or (can-query (self, "read-only")
     4204        and
     4205        self :read-only = false
     4206        )
     4207     then do:
     4208       assign
     4209         self :screen-value = ?
     4210       .
     4211     end.
     4212     return no-apply.
     4213   end.
     4214   on delete-character of sch-date in frame Dialog-Frame
     4215   do:
     4216     if (can-query (self, "sensitive")
     4217        and
     4218        self :sensitive = true
     4219        )
     4220     or (can-query (self, "read-only")
     4221        and
     4222        self :read-only = false
     4223        )
     4224     then do:
     4225       assign
     4226         self :screen-value = ?
     4227       .
     4228     end.
     4229     return no-apply.
     4230   end.
     4231   on ctrl-d of sch-date in frame Dialog-Frame
     4232   do:
     4233     define variable v-curr-sv-date as date no-undo .
     4234     if (can-query (self, "sensitive")
     4235        and
     4236        self :sensitive = true
     4237        )
     4238     or (can-query (self, "read-only")
     4239        and
     4240        self :read-only = false
     4241        )
     4242     then do:
     4243       if self :handle <> focus :handle
     4244       then do:
     4245         apply "entry":u to self .
     4246       end.
     4247       run gbl/getcurdt.p
     4248         (output v-curr-sv-date
     4249         ) .
     4250       assign
     4251         self :screen-value = string(v-curr-sv-date) .
     4252       .
     4253     end.
     4254     return no-apply.
     4255   end.
     4256   on ctrl-b of sch-date in frame Dialog-Frame
     4257   do:
     4258     if (can-query (self, "sensitive")
     4259        and
     4260        self :sensitive = true
     4261        )
     4262     or (can-query (self, "read-only")
     4263        and
     4264        self :read-only = false
     4265        )
     4266     then do:
     4267       if self :handle <> focus :handle
     4268       then do:
     4269         apply "entry":u to self .
     4270       end.
     4271       define variable v-curr-sv-date as date no-undo .
     4272       define variable v-new-sv-date  as date no-undo .
     4273       assign
     4274         v-curr-sv-date = date(self :screen-value) no-error
     4275       .
