     1829   procedure prn-lib-reportviewer :
     1830     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1831     define input parameter p-report-name-html as character no-undo .
     1832     define input parameter p-param        as character no-undo .
     1833     define variable v-excel           as character no-undo init 'TRUE' .
     1834     define variable v-value-character as character no-undo .
     1835     define variable v-value-integer   as character no-undo .
     1836     define variable v-value-date      as date      no-undo .
     1837     define variable v-value-decimal   as decimal   no-undo .
     1838     define variable rep-excel         as logical   no-undo .
     1839     define variable excel-string      as character no-undo .
     1840     define variable v-param-type      as character no-undo .
     1841     define variable v-tth             as handle    no-undo .
     1842     run adm/shattri.p (
     1843       input "get":U
     1844       ,input  ""
     1845       ,input  0
     1846       ,input  'report-glob':U
     1847       ,input  'rep-excel':U
     1848       ,output v-value-character
     1849       ,output v-value-date
     1850       ,output v-value-decimal
     1851       ,output v-value-integer
     1852       ,output rep-excel
     1853       ,output v-param-type
     1854       ,INPUT-OUTPUT table-handle v-tth
     1855       )  .
     1856     if rep-excel then v-excel = "TRUE" .
     1857     else v-excel = "FALSE" .
     1858     if p-param eq ""
     1859     then
     1860        p-param = "EXCEL:" + v-excel.
     1861     else
     1862        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1863     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1864   end procedure.
