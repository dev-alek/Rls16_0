     2230        B-sch AT ROW 1 COL 89
     2231        B-hist AT ROW 1 COL 92
     2232        B-Help AT ROW 1 COL 95
     2233        B-add AT ROW 2 COL 21
     2234        b-lkp AT ROW 2 COL 31
     2235        B-chg AT ROW 2 COL 41
     2236        B-del AT ROW 2 COL 51
     2237        B-close AT ROW 2 COL 61
     2238        B-Open AT ROW 2 COL 71
     2239        BR-docs AT ROW 3 COL 1
     2240        ED-notes AT ROW 18.58 COL 1 NO-LABEL
     2241        sch-code AT ROW 22.58 COL 17.63 COLON-ALIGNED
     2242        sch-date AT ROW 22.58 COL 40.75 COLON-ALIGNED
     2243        sch-fact AT ROW 22.58 COL 65.63 COLON-ALIGNED
     2244        mark-num AT ROW 1 COL 14 NO-LABEL
     2245        qnty AT ROW 21.5 COL 52.63 COLON-ALIGNED NO-LABEL
     2246        shop-name AT ROW 21.5 COL 69.88 COLON-ALIGNED NO-LABEL
     2247        num-chk AT ROW 21.58 COL 15.63 COLON-ALIGNED NO-LABEL
     2248        "количество товара" VIEW-AS TEXT
     2249             SIZE 19.5 BY .88 AT ROW 21.46 COL 34.5
     2250        "число чеков" VIEW-AS TEXT
     2251             SIZE 16 BY .88 AT ROW 21.46 COL 1.38
     2252        "ПОИСК ПО" VIEW-AS TEXT
     2253             SIZE 9.25 BY 1 AT ROW 22.58 COL 1.5
     2254             FGCOLOR 4
     2255        SPACE(88.25) SKIP(0.02)
     2256       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2257            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2258            TITLE "Продажи"
     2259            DEFAULT-BUTTON b-lkp CANCEL-BUTTON b-quit.
     2260   ASSIGN
     2261          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2262          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2263   ASSIGN
     2264          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     2265   ASSIGN
     2266          B-export:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-export:HANDLE.
     2267   ASSIGN
     2268          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-print:HANDLE.
     2269   ON END-ERROR OF FRAME Dialog-Frame
     2270   OR ENDKEY OF FRAME Dialog-Frame DO:
     2271     run gbl/markqwa.p (
     2272                   input b-mark:sensitive
     2273                  ,input v-rid-list
     2274                   ) no-error.
     2275       if error-status:error then return no-apply.
     2276   END.
     2277   ON GO OF FRAME Dialog-Frame
     2278   DO:
     2279     p-rid-list = v-rid-list.
     2280   END.
     2281   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2282   DO:
     2283     APPLY "END-ERROR":U TO SELF.
     2284   END.
     2285   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     2286   or Right-Mouse-CLICK OF b-add IN FRAME Dialog-Frame
     2287   DO:
     2288    IF tpsi-mode = 2
     2289    and add-option = '':U THEN DO:
     2290        run gbl/pop-up.p ( INPUT SELF:HANDLE, INPUT NO) NO-ERROR.
     2291        IF add-option = '':U THEN RETURN NO-APPLY.
     2292     END.
     2293     run proc-b-add IN THIS-PROCEDURE ( INPUT (if tpsi-mode = 2 then add-option else 'касс':U)) NO-ERROR.
     2294     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2295   END.
     2296   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2297   DO:
     2298     define variable v-inkas-code as character no-undo .
     2299     IF NOT AVAILABLE ink-doc THEN RETURN NO-APPLY.
     2300     assign
     2301     v-doc-rec = recid(ink-doc).
     2302     v-inkas-code = ink-doc.inkas-code.
     2303     run str/cre-sale.p ( INPUT parparentproc
     2304                         ,INPUT parobj-type
     2305                         ,INPUT parobj-code
     2306                         ,INPUT 'ИЗМЕНЕНИЕ':U
     2307                         ,input '':U
     2308                         ,input '':U
     2309                         ,INPUT-output v-inkas-code
     2310                         ,INPUT '':U) NO-ERROR.
     2311     IF ERROR-STATUS:ERROR THEN do:
     2312       message
     2313       substitute("Ошибка при редактировании продажи:&1&2 &3", chr(10), error-status:get-message(1) , return-value )
     2314       view-as alert-box ERROR .
     2315       return no-apply.
     2316     end.
     2317   RUn openbr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     2318   reposition br-docs to recid v-doc-rec no-error.
     2319   APPLY "VALUE-CHANGED" to BR-docs.
     2320   END.
     2321   ON CHOOSE OF B-chk IN FRAME Dialog-Frame
     2322   DO:
     2323   DEFINE VARIABLE rid-list as character no-undo .
     2324   define variable loc#log as logical no-undo.
     2325   def buffer t-clients for ub.clients.
     2326   if available ink-doc THEN  do:
     2327   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2328   loc#log = yes.
     2329   FIND FIRST t-clients NO-LOCK WHERE
     2330                       t-clients.obj-code = ink-doc.obj-code AND
     2331                       t-clients.obj-type = ink-doc.obj-type
     2332       No-ERROR.
     2333   IF t-clients.db-num <> ub.db.db-num and ub.db.db-num <> 0 then do:
     2334       if YES then
     2335       message "Нельзя получить информацию по чекам объекта "  ink-doc.obj-code ink-doc.obj-type
     2336       "в базе данных N " ub.db.db-num
     2337       view-as alert-box.
     2338       loc#log = no.
     2339   end.
     2340   else if ub.db.db-num = 0 AND t-clients.db-num <> ub.db.db-num then do:
     2341       FIND FIRST db No-LOCK WHERE db.db-num = t-clients.db-num No-ERROR.
     2342       if NOT db.send-check then do:
     2343           if YES then
     2344           message "Нельзя получить информацию по чекам объекта "  ink-doc.obj-code ink-doc.obj-type
     2345           "в базе данных N " ub.db.db-num
     2346           view-as alert-box.
     2347           loc#log = no.
     2348       end.
     2349   end.
     2350       if NOT loc#log then return no-apply.
     2351       run str/chk-docs.w (
     2352                        input parparentproc
     2353                       ,input '':U
     2354                       ,input 'продажа':U
     2355                       ,input ?
     2356                       ,input ink-doc.obj-type
     2357                       ,input ink-doc.obj-code
     2358                       ,input ink-doc.inkas-code
     2359                       ,input '':U
     2360                       ,input 0
     2361                       ,input  ?
     2362                       ,input  ?
     2363                       ,input 0
     2364                       ,output rid-list) no-error.
     2365   end.
     2366   apply "entry" to br-docs.
     2367   END.
     2368   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     2369   DO:
     2370    IF NOT AVAILABLE ink-doc THEN RETURN NO-APPLY.
     2371    define variable v-close-type as integer no-undo .
     2372    define variable v-status_ like ub.inkas.status_ no-undo .
     2373    define variable v-flag_ like ub.trn-doc.flag_ no-undo .
     2374    define variable v-ask-message as character no-undo .
     2375    define buffer buf_trn-doc for ub.trn-doc.
     2376    find first buf_trn-doc where
     2377              buf_trn-doc.doc-code = ink-doc.inkas-code.
     2378    run str/salegraf.p (
     2379                   input ink-doc.inkas-code
     2380                  ,input '<закрытие документа>':U
     2381                  ,input buf_trn-doc.status_
     2382                  ,input buf_trn-doc.flag_
     2383                  ,output v-status_
     2384                  ,output v-flag_
     2385                  ,output v-ask-message) no-error .
     2386     if error-status:error then do:
     2387       message
     2388       error-status:get-message(1)  skip
     2389       return-value
     2390       view-as alert-box error .
     2391       return no-apply.
     2392     end.
     2393     run gbl/d-askw.w
     2394       (input "Вопрос"
     2395       ,input substitute("Закрыть ОТЧЕТ О ПРОДАЖЕ &1&2" +
     2396                         "Дата учета &3&2" +
     2397                         "Ожидаемая факт дата &4"
     2398                        , ink-doc.inkas-code
     2399                        , chr(10)
     2400                        , string(ink-doc.shift-date, '99/99/9999':u)
     2401                        , string(ink-doc.fact-date, '99/99/9999':u)
     2402                        )
     2403       ,input "|^"
     2404       ,input (if v-status_ = 'факт':U
     2405               then ("Факт" + '|':u + "Отмена" )
     2406               else (v-status_ + string(v-flag_, "+/") + '|':u
     2407             + "Факт" + '|':u
     2408             + "Отмена" )
     2409               )
     2410       ,input (if v-status_ = 'факт':U
     2411               then ("Окончательное закрытие без последующего редактирования|"
     2412                     + "Отмена действия")
     2413               else (
     2414                    v-ask-message + "|"
     2415                     + "Окончательное закрытие без последующего редактирования|"
     2416                     + "Отмена действия")
     2417              )
     2418       ,input 1
     2419       ,input (if v-status_ = 'факт':U
     2420               then 2
     2421               else 3)
     2422       ,output v-close-type
     2423       ).
     2424    if (v-status_ = 'факт':U
     2425    and v-close-type = 2)
     2426    or v-close-type = 3 then do:
     2427      return no-apply.
     2428    end.
     2429    run proc-close IN THIS-PROCEDURE ( input yes, input (if v-status_ = 'факт':U then 2 else v-close-type), input v-status_, input v-flag_) NO-ERROR.
     2430    IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2431   END.
