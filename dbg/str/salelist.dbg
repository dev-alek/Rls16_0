     1257   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1258   define variable v-ps as character no-undo .
     1259   assign
     1260   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     1261                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     1262                     , buf_sale-doc.out-code
     1263                     , buf_sale-doc.obj-type
     1264                     , buf_sale-doc.obj-code
     1265                     , chr(4)
     1266                     , buf_sale-doc.tot-lines
     1267                     , buf_sale-doc.tot-dtl
     1268                     ).
     1269   return v-Ps.
     1270   END FUNCTION.
     1271   procedure create-tt0-doc-line-gds-dtl :
     1272   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     1273   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     1274   define input parameter p-ext-doc-type        as character no-undo .
     1275   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     1276   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     1277   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     1278   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     1279   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     1280   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     1281   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1282   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1283   define parameter buffer b-doc-line           for ub.doc-line.
     1284   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     1285   define parameter buffer buf_sale-doc for ub.sale-doc.
     1286   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     1287   define buffer other_doc-line for ub.doc-line.
     1288   define buffer other_gds-dtl for ub.gds-dtl.
     1289     do
     1290     on error undo, return error return-value
     1291     :
     1292       find first tt0-doc-line where
     1293                 tt0-doc-line.obj-type = p-proprietor-obj-type
     1294             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     1295             AND tt0-doc-line.prod-type = p-prod-type
     1296             AND tt0-doc-line.prod-code = p-prod-code
     1297             AND tt0-doc-line.artic     = p-artic
     1298             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     1299             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     1300       if not available tt0-doc-line then do:
     1301         create tt0-doc-line.
     1302         buffer-copy b-doc-line
     1303         except
     1304         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     1305         to tt0-doc-line
     1306         assign
     1307         tt0-doc-line.status_ = 'нередакт':U
     1308         tt0-doc-line.ext-doc-type = p-ext-doc-type
     1309         tt0-doc-line.obj-type = p-proprietor-obj-type
     1310         tt0-doc-line.obj-code = p-proprietor-obj-code
     1311         tt0-doc-line.doc-code = p-doc-code
     1312         .
     1313       end.
     1314       if p-doc-code <> "":U then do:
     1315         find first other_doc-line no-lock where
     1316                 other_doc-line.doc-code = p-doc-code
     1317             AND  other_doc-line.artic    = p-artic
     1318             AND  other_doc-line.prod-type = p-prod-type
     1319             AND  other_doc-line.prod-code = p-prod-code no-error .
     1320         if available other_doc-line then do:
     1321           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     1322           assign
     1323           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     1324           .
     1325         end.
     1326         else do:
     1327           assign
     1328           tt0-doc-line.doc-code = '':U
     1329           .
     1330         end.
     1331       end.
     1332       find first tt0-gds-dtl where
     1333               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1334           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1335           AND tt0-gds-dtl.prod-type = p-prod-type
     1336           AND tt0-gds-dtl.prod-code = p-prod-code
     1337           AND tt0-gds-dtl.artic     = p-artic
     1338           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     1339       if not available tt0-gds-dtl then do:
     1340         create tt0-gds-dtl.
     1341         buffer-copy b-gds-dtl
     1342         except
     1343         obj-type obj-code doc-code doc-qnty fact-qnty
     1344         to tt0-gds-dtl
     1345         assign
     1346         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1347         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1348         tt0-gds-dtl.doc-code = p-doc-code
     1349         .
     1350       end.
     1351       if p-doc-code <> "":U then do:
     1352           find first other_gds-dtl no-lock where
     1353                   other_gds-dtl.doc-code = p-doc-code
     1354               AND  other_gds-dtl.artic    = p-artic
     1355               AND  other_gds-dtl.prod-type    = p-prod-type
     1356               AND  other_gds-dtl.prod-code    = p-prod-code
     1357               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     1358           if available other_gds-dtl then do:
     1359             assign
     1360             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     1361             .
     1362           end.
     1363           else do:
     1364             assign
     1365             tt0-gds-dtl.doc-code = '':U
     1366             .
     1367           end.
     1368       end.
     1369       assign
     1370       old-qnty = tt0-gds-dtl.doc-qnty
     1371       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     1372       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     1373       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     1374       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     1375       .
     1376     end.
     1377   end procedure.
     1378   procedure fill-tt-tpsi-table :
     1379   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     1380   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     1381   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     1382   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     1383   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     1384   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     1385   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     1386   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     1387   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     1388   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     1389   define buffer buf_goods for ub.goods.
     1390   define buffer buf_doc-line for ub.doc-line.
     1391   define buffer buf_gds-dtl for ub.gds-dtl.
     1392   define buffer buf_sale-doc for ub.sale-doc.
     1393     do
     1394     on error undo, return error
     1395     :
     1396       _doc-line:
     1397       for each buf_Doc-line no-lock where
     1398             buf_doc-line.doc-code = p-doc-code,
     1399         first buf_goods no-lock where
     1400             buf_goods.artic = buf_doc-line.artic
     1401        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     1402        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     1403           each buf_gds-dtl no-lock where
     1404             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     1405         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     1406         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1407         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1408         assign
     1409         v-ext-doc-type = "":U.
     1410         run tpsi-preselect-gds-proprietor in this-procedure (
     1411                                                     input buf_goods.gds-code
     1412                                                   ,input g#db-num
     1413                                                   ,output v-proprietor-host-code
     1414                                                   ,output v-proprietor-obj-type
     1415                                                   ,output v-proprietor-obj-code ) no-error .
     1416         if v-proprietor-host-code = p-host-code then do:
     1417           assign
     1418           v-ext-doc-type = 'ev':U .
     1419         end.
     1420         else do:
     1421           assign
     1422           v-ext-doc-type =  'ee':U .
     1423         end.
     1424         if  (v-proprietor-obj-type = p-obj-type
     1425         AND v-proprietor-obj-code = p-obj-code)
     1426         OR (v-proprietor-obj-type = "":U
     1427         AND v-proprietor-obj-code = 0)
     1428         OR v-proprietor-obj-code = ?
     1429         then next _doc-line.
     1430         find first buf_sale-doc no-lock where
     1431                   buf_sale-doc.inkas-code = p-doc-code
     1432              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     1433              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     1434              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     1435              no-error .
     1436         run create-tt0-doc-line-gds-dtl  in this-procedure (
     1437                                                              input v-proprietor-obj-type
     1438                                                             ,input v-proprietor-obj-code
     1439                                                             ,input v-ext-doc-type
     1440                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     1441                                                             ,input buf_doc-line.artic
     1442                                                             ,input buf_Doc-line.prod-type
     1443                                                             ,input buf_doc-line.prod-code
     1444                                                             ,input buf_gds-dtl.prt-code
     1445                                                             ,input 0
     1446                                                             ,output v-was-gds-dtl-fact-qnty
     1447                                                             ,output v-gds-dtl-fact-qnty
     1448                                                             ,buffer buf_doc-line
     1449                                                             ,buffer buf_gds-dtl
     1450                                                             ,buffer buf_sale-doc
     1451                                                           ).
     1452       end.
     1453     end.
     1454   end procedure.
     1455   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1456   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1457   procedure get-alias-type-price-obj :
     1458   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1459   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1460   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1461   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     1462   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     1463   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     1464   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     1465   define output parameter p-alias-type-price as character no-undo .
     1466   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     1467   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     1468   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     1469   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     1470   define variable v-mediat-objf               as character no-undo .
     1471   define variable v-param-type as character no-undo .
     1472   define variable v-value-character as character no-undo .
     1473   define variable v-value-date as date no-undo .
     1474   define variable v-value-decimal as decimal no-undo .
     1475   define variable v-value-integer as INTEGER no-undo .
     1476   define variable v-value-logical AS LOGICAL no-undo .
     1477   define variable v-tth as handle no-undo .
     1478   assign
     1479   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1480   define buffer buf_trn-doc for ub.trn-doc.
     1481     _main:
     1482     do
     1483     on error undo, return error return-value
     1484     :
     1485       run adm/shattri.p (
     1486         input "get":U
     1487         ,input  p-prop-obj-type
     1488         ,input  p-prop-obj-code
     1489         ,input  'alias-tpsi':U
     1490         ,input  '':U
     1491         ,output v-value-character
     1492         ,output v-value-date
     1493         ,output v-value-decimal
     1494         ,output v-value-integer
     1495         ,output v-value-logical
     1496         ,output v-param-type
     1497         ,INPUT-OUTPUT table-handle v-tth
     1498         ) no-error .
     1499       if error-status:error
     1500       then do:
     1501         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1502                                 , p-prop-obj-type
     1503                                 , p-prop-obj-code).
     1504       end.
     1505       find first thbjattr_thbj-attr where
     1506                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1507             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1508             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1509             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1510       if not available thbjattr_thbj-attr
     1511       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1512         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1513                                 , p-prop-obj-type
     1514                                 , p-prop-obj-code).
     1515       end.
     1516       assign
     1517       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1518       if p-prop-host-code = p-host-code
     1519       and (p-alias-type-price = '':U
     1520       or   p-alias-type-price <> '5':U)
     1521       then  do:
     1522         assign
     1523         p-ext-doc-type = 'ev':U
     1524         p-price-obj-type = p-obj-type
     1525         p-price-obj-code = p-obj-code
     1526         p-alias-type-price = '3':U
     1527         .
     1528       end.
     1529       else do:
     1530         if p-prop-host-code = p-host-code  then do:
     1531           assign
     1532           p-ext-doc-type = 'ev':U
     1533           p-price-obj-type = p-obj-type
     1534           p-price-obj-code = p-obj-code
     1535           .
     1536         end.
     1537         else do:
     1538           assign
     1539           p-ext-doc-type = 'ee':U.
     1540           assign
     1541           v-mediat-obj-type = "":U
     1542           v-mediat-obj-code = 0
     1543           v-mediat-objf = "":U
     1544           .
     1545           if p-alias-type-price = '4':U then do:
     1546             find first thbjattr_thbj-attr where
     1547                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1548                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1549                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1550                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     1551             if not available thbjattr_thbj-attr
     1552             or thbjattr_thbj-attr.property-value-character = "":U then do:
     1553               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     1554                                       , p-prop-obj-type
     1555                                       , p-prop-obj-code).
     1556             end.
     1557             assign
     1558             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     1559             v-mediat-obj-type = entry(1, v-mediat-objf)
     1560             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     1561             no-error
     1562             .
     1563             if error-status:error then do:
     1564               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     1565                                       , p-prop-obj-type
     1566                                       , p-prop-obj-code).
     1567             end.
     1568           end.
     1569           CASE p-alias-type-price:
     1570             when '1':U then do:
     1571               assign
     1572               p-price-obj-type = p-prop-obj-type
     1573               p-price-obj-code = p-prop-obj-code
     1574               .
     1575             end.
     1576             when '2':U then do:
     1577               assign
     1578               p-price-obj-type = p-prop-obj-type
     1579               p-price-obj-code = p-prop-obj-code
     1580               .
     1581             end.
     1582             when '3':U
     1583             or
     1584             when '5':U
     1585             then do:
     1586               assign
     1587               p-price-obj-type = p-obj-type
     1588               p-price-obj-code = p-obj-code
     1589               .
     1590             end.
     1591             when '4':U then do:
     1592               assign
     1593               p-price-obj-type = v-mediat-obj-type
     1594               p-price-obj-code = v-mediat-obj-code
     1595               .
     1596             end.
     1597           END CASE.
     1598         end.
     1599       end.
     1600     end.
     1601   end procedure.
     1602   procedure write-tt0-info:
     1603   define input parameter p-artic as character no-undo .
     1604   define input parameter p-prod-type as character no-undo .
     1605   define input parameter p-prod-code as integer no-undo .
     1606   define input parameter p-prt-code as integer no-undo .
     1607   define input parameter p-obj-type as character no-undo .
     1608   define input parameter p-obj-code as integer no-undo .
     1609   define input parameter p-doc-code as character no-undo .
     1610   define input parameter p-from-tpsi as logical no-undo .
     1611   define input parameter p-all-qnty as decimal no-undo .
     1612   define input parameter p-was-res as decimal no-undo .
     1613   define input parameter p-to-res as decimal no-undo .
     1614   define input parameter p-is-res as decimal no-undo .
     1615   define input parameter p-o-was-res as decimal no-undo .
     1616   define input parameter p-o-to-res as decimal no-undo .
     1617   define input parameter p-o-is-res as decimal no-undo .
     1618   define input parameter p-mess   as character no-undo .
     1619   define buffer buf_tt0-info for tt0-info.
     1620     do
     1621     on error undo, return error return-value
     1622     :
     1623       find first buf_tt0-info where
     1624                buf_tt0-info.artic = p-artic
     1625            and buf_tt0-info.prod-type = p-prod-type
     1626            and buf_tt0-info.prod-code = p-prod-code
     1627            and buf_tt0-info.prt-code = p-prt-code
     1628            no-error .
     1629       if not available buf_tt0-info then do:
     1630         create buf_tt0-info.
     1631         assign
     1632         buf_tt0-info.artic = p-artic
     1633         buf_tt0-info.prod-type = p-prod-type
     1634         buf_tt0-info.prod-code = p-prod-code
     1635         buf_tt0-info.prt-code  = p-prt-code
     1636         buf_tt0-info.obj-type  = p-obj-type
     1637         buf_tt0-info.obj-code  = p-obj-code
     1638         buf_tt0-info.a-to-res  = ?
     1639         buf_tt0-info.to-res    = ?
     1640         buf_tt0-info.was-res   = ?
     1641         buf_tt0-info.o-was-res = ?
     1642         buf_tt0-info.o-to-res  = ?
     1643         buf_tt0-info.o-is-res  = ?
     1644         buf_tt0-info.is-res    = ?
     1645         .
     1646       end.
     1647       assign
     1648       buf_tt0-info.a-to-res  =
     1649                                 (if buf_tt0-info.a-to-res <> ?
     1650                                 and p-all-qnty = ?
     1651                                 then buf_tt0-info.a-to-res
     1652                                 else p-all-qnty)
     1653       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     1654                                 and p-was-res = ?
     1655                                 then buf_tt0-info.was-res
     1656                                 else p-was-res)
     1657       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     1658                                 and p-to-res = ?
     1659                                 then buf_tt0-info.to-res
     1660                                 else p-to-res)
     1661       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     1662                                 and p-is-res = ?
     1663                                 then buf_tt0-info.is-res
     1664                                 else p-is-res)
     1665       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     1666                                 and p-o-was-res = ?
     1667                                 then buf_tt0-info.o-was-res
     1668                                 else p-o-was-res)
     1669       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     1670                                 and p-o-to-res = ?
     1671                                 then buf_tt0-info.o-to-res
     1672                                 else p-o-to-res)
     1673       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     1674                                 and p-o-is-res = ?
     1675                                 then buf_tt0-info.o-is-res
     1676                                 else p-o-is-res)
     1677       .
     1678       assign
     1679       buf_tt0-info.doc-code  = p-doc-code
     1680       buf_tt0-info.error-message   = p-mess
     1681       .
     1682     end.
     1683   end procedure.
     1684   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   define  stream PrnLibStream.
     1686   procedure prn-lib-prn-file :
     1687     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1688     define input parameter p-DIsabledoptions as integer no-undo .
     1689     define variable v-report-name as character no-undo .
     1690     define variable v-user-action as character no-undo .
     1691     define variable v-printed     as logical   no-undo .
     1692     define variable v-exist       as logical   no-undo .
     1693     do
     1694       on error undo, return error
     1695       :
     1696       run prn-lib-get-report-name  in this-procedure (
     1697         input parParentProc
     1698         ,output v-report-name
     1699         ).
     1700   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1702     (input  v-report-name
     1703     ,input  2
     1704     ,output v-exist
     1705     )  .
     1706       if NOT v-exist then
     1707       DO:
     1708         Message
     1709           "Нет заданий на печать ! "
     1710           view-as alert-box .
     1711         Return  .
     1712       End.
     1713       run gbl/prnfilen.w
     1714         (input  ""
     1715         ,input  p-DisabledOptions
     1716         ,input  string(v-report-name )
     1717         ,input  7
     1718         ,output v-user-action
     1719         ,output v-printed
     1720         ) .
     1721       if v-printed then
     1722       do:
     1723         return "YES" .
     1724       end.
     1725       else
     1726       do:
     1727         return "NO" .
     1728       end.
     1729     end.
     1730   end procedure.
     1731   procedure prn-lib-open-stream :
     1732     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1733     define input parameter p-page-size    as integer no-undo .
     1734     define input parameter p-is-stream    as logical no-undo .
     1735     define input parameter p-append       as logical no-undo .
     1736     define variable v-report-name as character no-undo .
     1737     do
     1738       on error undo, return error
     1739       :
     1740       run prn-lib-get-report-name  in this-procedure (
     1741         input parParentProc
     1742         ,output v-report-name
     1743         ).
     1744       if p-is-stream then
     1745       do:
     1746         if p-append then
     1747         do:
     1748           output stream PrnLibStream to value( v-report-name )
     1749             page-size value(p-page-size) append .
     1750         end.
     1751         if not p-append then
     1752         do:
     1753           output stream PrnLibStream to value( v-report-name )
     1754             page-size value(p-page-size) .
     1755         end.
     1756       end.
     1757       if not p-is-stream then
     1758       do:
     1759         if p-append then
     1760         do:
     1761           output to value( v-report-name )
     1762             page-size value(p-page-size) append .
     1763         end.
     1764         if not p-append then
     1765         do:
     1766           output to value( v-report-name )
     1767             page-size value(p-page-size) .
     1768         end.
     1769       end.
     1770     end.
     1771   end procedure.
     1772   procedure prn-lib-open-exp :
     1773     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1774     define input parameter p-is-stream    as logical no-undo .
     1775     define input parameter p-is-append    as logical no-undo .
     1776     define output parameter p-ReportFileName as char init "report" no-undo.
     1777     define output parameter p-process as logical no-undo .
     1778     define variable glog as logical no-undo .
     1779     do
     1780       on error undo, return error
     1781       :
     1782       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1783         TITLE      "Укажите путь"
     1784         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1785         ASK-OVERWRITE
     1786         CREATE-TEST-FILE
     1787         SAVE-AS
     1788         USE-FILENAME
     1789         DEFAULT-EXTENSION "txt"
     1790         UPDATE glog
     1791         .
     1792       if not glog then  return.
     1793       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1794       if p-is-stream then
     1795       do:
     1796         if p-is-append then
     1797         do:
     1798           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1799         end.
     1800         else
     1801         do:
     1802           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1803         end.
     1804       end.
     1805       else
     1806       do:
     1807         if p-is-append then
     1808         do:
     1809           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1810         end.
     1811         else
     1812         do:
     1813           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1814         end.
     1815       end.
     1816       p-process = yes.
     1817     end.
     1818   end procedure.
     1819   procedure prn-lib-get-report-name :
     1820     define input parameter parParentProc  as widget-handle no-undo.
     1821     define output parameter p-report-name as character no-undo .
     1822     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1823   end procedure.
     1824   procedure prn-lib-reportviewer-report-name :
     1825     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1826     define input parameter p-report-name-html as character no-undo .
     1827     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
