     2201         shift-name-no-err(BUFFER ink-doc) COLUMN-LABEL "N см." FORMAT "X(6)":U
     2202         ink-doc.netto COLUMN-LABEL "Нетто" FORMAT "->>>,>>>,>>>,>>9.99":U
     2203         ink-doc.tot-doc COLUMN-LABEL "Сумма товарная" FORMAT "->>>,>>>,>>>,>>9.99":U
     2204         ink-doc.discnt FORMAT "->,>>>,>>>,>>9.99":U
