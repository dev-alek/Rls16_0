     2532                         "SHOP_NUM=" + string(ink-doc.obj-code) + chr(4) +
     2533                         "Contractor=" + buf_trn-doc.cli-name + chr(4) +
     2534                         "DocNum=" + string(ink-doc.inkas-code) + chr(4) +
     2535                         "FactDate=" + (if string(ink-doc.fact-date) = ? then '' else string(ink-doc.fact-date)) + chr(4) +
     2536                         "DocType=" + "Продажа" + chr(4) +
     2537                         "SHIFT_NUM_DOC=" + (if string(ink-doc.shift-num) = ? then '' else string(ink-doc.shift-num)) + (if string(ink-doc.shift-date) = ? then '' else string(ink-doc.shift-date, "99999999")) + chr(4) +
     2538                         "SHIFT_NUM=" + (if string(varobj-shift-num) = ? then '' else string(varobj-shift-num)) + (if string(varobj-shift-date) = ? then '' else string(varobj-shift-date, "99999999")) + chr(4) +
     2539                         "Status=" + string(ink-doc.status_) no-error.
     2540       end.
     2541       run str/diallog.w (
     2542             input parParentProc
     2543           , input this-procedure
     2544           , input ("str/delfsale.p":U + chr(4) +
     2545                   "1":U  + chr(4) +
     2546                   "1":U + chr(4) +
     2547                   "1":U)
     2548           , input v-parameter
     2549           , input no
     2550           , input "":U
     2551           , input substitute("Удаление продажи &1 &2&3, закрытой до статуса факт", Ink-doc.inkas-code, ink-doc.obj-type, ink-doc.obj-code)
     2552       ) no-error.
     2553       if error-status:error
     2554       and return-value <> "error"
     2555       and return-value <> ""
     2556       then do:
     2557         v-mess = substitute("&1 &2"
     2558                   , error-status:get-message(1)
     2559                   , return-value ).
