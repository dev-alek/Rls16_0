        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-r-b as character no-undo .
        4   define parameter buffer X_chk-doc for ub.chk-doc.
        5   define variable vss-revision    as character no-undo init "$Revision: 18022dc3b171, 1949, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        7   define variable vss-date        as character no-undo init "$Date: Fri Jul 26 11:38:58 2019 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: exclwchk.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/exclwchk.p $":U .
       10   define variable vss-description as character no-undo init "Исключения чека МЦ из незакрытой продажи".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
