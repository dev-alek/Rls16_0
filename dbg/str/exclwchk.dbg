       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   FUNCTION calc-excise RETURNS DECIMAL(input  parprice-sale as decimal,
       81                                        input  parroad-tax   as decimal,
       82                                        input  parvat-pc     as decimal,
       83                                        input  parfactorrd   as decimal,
       84                                        output parexcise     as decimal):
       85   ASSIGN parexcise = (parprice-sale - parroad-tax) * parvat-pc / (100 + parvat-pc) -
       86                      1 / parfactorrd * parroad-tax.
       87   RETURN parexcise.
       88   END FUNCTION.
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define variable v-waitfram-action01         as character   no-undo .
       91   define variable v-waitfram-action02         as character   no-undo .
       92   define variable v-waitfram-action03         as character   no-undo .
       93   define variable mWaitFramTextBeg            as character   no-undo.
       94   define variable mWaitFramTextEnd            as character   no-undo.
       95   define variable mWaitFramView               as logical     no-undo.
       96   define variable mWaitProcEvent              as logical     no-undo init yes.
       97   define variable mWaitFramInterval           as integer     no-undo init 1 .
       98   define variable mWaitFramStop               as logical     no-undo.
       99   define variable mWaitFramStopUser           as logical     no-undo.
      100   define variable mWaitFramStopTimeOut        as logical     no-undo.
      101   define variable mWaitFramStartProc          as datetime-tz no-undo.
      102   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      103   define button B-WaitFramStop auto-end-key
      104        label "Стоп"
      105        size 10 by 1 tooltip "Остоновить процесс".
      106   define button B-viewProcInfo
      107        label "Информация"
      108        size 15 by 1 tooltip "Информация о процесс".
      109   define frame waitfram
      110     v-waitfram-action01 format "x(72)" no-label skip
      111     v-waitfram-action02 format "x(72)" no-label skip
      112     v-waitfram-action03 format "x(72)" no-label skip
      113     B-viewProcInfo
      114     B-WaitFramStop at row 4 col 30
      115     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      116     .
      117   define new global shared variable mBatchMode as logical no-undo init ?.
      118   define variable mFramBachModHandle as handle no-undo.
      119   mFramBachModHandle = frame waitfram:handle.
      120   define variable mFameOldVis as logical no-undo.
      121   define variable mVisCUrentVin as logical no-undo.
      122   if session:batch-mode
      123   then
      124      mBatchMode = yes.
      125   if mBatchMode = ? then do:
      126     mVisCUrentVin = current-window:visible.
      127     mFameOldVis = mFramBachModHandle:visible.
      128     mFramBachModHandle:visible  = yes.
      129     mBatchMode = mFramBachModHandle:visible ne yes.
      130     mFramBachModHandle:visible = mFameOldVis.
      131     current-window:visible = mVisCUrentVin.
      132   end.
      133    if  log-manager:logfile-name ne ?
      134     then DO:
      135         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      136         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      137         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      138     end.
      139   on choose of B-WaitFramStop in frame waitfram
      140   do:
      141     mWaitFramStop = yes.
      142     mWaitFramStopUser = yes.
      143   end.
      144   function waitfram-check-timeout returns logical():
      145      define variable vtime as int64 no-undo.
      146      if mWaitFramStopTimeOut
      147      then
      148         return yes.
      149      vtime = ( now - mWaitFramStartProc ) / 1000 .
      150      if     mWaitFramTimeOut ne ?
      151         and mWaitFramTimeOut ne 0
      152         and mWaitFramTimeOut lt vtime
      153      then do:
      154         mWaitFramStopTimeOut = yes.
      155      end.
      156      return mWaitFramStopTimeOut.
      157   end.
      158   procedure waitfram-hide :
      159     if not session:batch-mode
      160     then do
      161     on error undo, return error return-value
      162     :
      163       pause 0 before-hide .
      164       if not mBatchMode then
      165         hide frame waitfram .
      166     if     not mWaitFramView
      167        and mWaitProcEvent
      168     then
      169       process events .
      170     end.
      171   end procedure.
      172   procedure waitfram-show :
      173     define input  parameter p-message as character no-undo .
      174     define variable v-left-margin as integer   no-undo .
      175     if not session:batch-mode
      176     then do
      177     on error undo, return error return-value
      178     :
      179       if length(p-message) <= 70 then do:
      180         assign
      181           v-left-margin = integer((70 - length(p-message)) / 2)
      182         .
      183         assign
      184           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      185         .
      186         assign
      187           v-waitfram-action01 = " "
      188           v-waitfram-action02 = " "
      189                                    + fill(" ", v-left-margin)
      190                                    + p-message
      191           v-waitfram-action03 = " "
      192         .
      193       end.
      194       else do:
      195         define variable vRindex1 as integer no-undo.
      196         define variable vRindex2 as integer no-undo.
      197         vRindex1 = r-index(p-message," ",70).
      198         if vRindex1 = 0
      199         then
      200            vRindex1 = 70.
      201         if length(p-message)  <= vRindex1 + 70 then do:
      202           assign
      203             v-waitfram-action01 = " "
      204             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      205             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      206           .
      207         end.
      208         else do:
      209           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      210           if vRindex2 <= vRindex1
      211           then
      212              vRindex2 = vRindex1 + 70.
      213           assign
      214             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      215             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      216             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      217           .
      218         end.
      219       end.
      220       B-viewProcInfo:visible   in frame waitfram = no.
      221       B-viewProcInfo:sensitive in frame waitfram = no.
      222       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      223       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      224       if  (   mWaitFramView
      225          or  mWaitProcEvent)
      226          and not mBatchMode
      227       then
      228          display
      229             v-waitfram-action01 skip
      230             v-waitfram-action02 skip
      231             v-waitfram-action03 skip
      232          with frame waitfram .
      233       if     mWaitFramView
      234          then do:
      235             if     mWaitFramInterval ne ?
      236                and not mBatchMode
      237             then
      238                wait-for go of frame waitfram pause mWaitFramInterval.
      239          end.
      240          else
      241             if     mWaitProcEvent
      242                and not mBatchMode
      243             then
      244                process events .
      245     end.
      246   end procedure.
      247      procedure waitfram-show-this:
      248         define input  parameter iInterval as int64 no-undo.
      249         define variable vtime as int64 no-undo.
      250         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      251         mWaitFramInterval = iInterval.
      252         run waitfram-show (substitute("&1&2 &3&4" ,
      253                                       mWaitFramTextBeg ,
      254                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      255                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      256                                       mWaitFramTextEnd
      257                                      )
      258                           ).
      259      end.
      260      procedure WaitFramRunPause:
      261         define input  parameter iInterval as dec no-undo.
      262         define variable vStart  as datetime-tz no-undo.
      263         define variable vend    as datetime-tz no-undo.
      264         define variable vint as int64 no-undo.
      265         define variable vOk as logical no-undo.
      266         vStart = now.
      267         vend   = vStart.
      268         publish "WaitFramPause" (iInterval,output vOk).
      269         vend   =  now.
      270         vint = vend - vStart.
      271         vint = iInterval - vint / 1000.
      272         if     not mWaitFramStop
      273            and (   vint > 0
      274                 or (    not vOk
      275                     and iInterval eq ?
      276                     )
      277                 )
      278         then
      279            run waitfram-show-this (iInterval).
      280         vend   =  now.
      281         vint = vend - vStart.
      282         vint = iInterval - vint / 1000.
      283         if     not mWaitFramStop
      284            and vint > 0
      285         then do:
      286            run gbl/pause.p (vint * 1000).
      287         end.
      288         if iInterval ne ?
      289         then
      290            publish "WaitFramStop".
      291         waitfram-check-timeout().
      292      end.
      293      procedure WaitFramWaitFor:
      294         define input  parameter iInterval as dec no-undo.
      295         assign
      296            mWaitFramStartProc   = now
      297            mWaitFramStopUser    = no
      298            mWaitFramStopTimeOut = no
      299         .
      300         block-wait:
      301         do while not mWaitFramStop:
      302            run WaitFramRunPause (iInterval).
      303            if  waitfram-check-timeout()
      304            then do:
      305               leave block-wait.
      306            end.
      307         end.
      308         run waitfram-hide.
      309      end.
      310   procedure waitfram-join :
      311     define input  parameter p-line-1  as character no-undo .
      312     define input  parameter p-line-2  as character no-undo .
      313     define input  parameter p-line-3  as character no-undo .
      314     define output parameter p-message as character no-undo .
      315     do
      316     on error undo, return error return-value
      317     :
      318       assign
      319         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      320                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      321                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      322       .
      323     end.
      324   end procedure.
      325   function waitfram-join-function returns character
      326     (input p-line-1 as character
      327     ,input p-line-2 as character
      328     ,input p-line-3 as character
      329     ).
      330     define variable v-message as character no-undo .
      331     run waitfram-join in this-procedure
      332       (input  p-line-1
      333       ,input  p-line-2
      334       ,input  p-line-3
      335       ,output v-message
      336       ) .
      337     return v-message .
      338   end function .
      339   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      341   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      342     field cst-code                like ub.trn-doc.cst-code
      343     field part-code               like ub.parts.part-code
      344     .
      345   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      346   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      347   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      348   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   define new global shared variable g#trdcalib as handle no-undo.
      350   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   FUNCTION set-inkas-PS returns character(    input p-ps as character,
      352                                               input p-chk-amount as integer,
      353                                               input p-gds-amount as integer,
      354                                               input p-line-out as integer,
      355                                               input p-dtl-out as integer,
      356                                               input p-line-ret as integer,
      357                                               input p-dtl-ret as integer,
      358                                               input p-nf-chk-amount as integer,
      359                                               input p-nf-gds-amount as integer,
      360                                               input p-ps-where-rus as character
      361                                               ):
      362   define variable v-ps as character no-undo .
      363   define variable v-other as character no-undo .
      364   v-other = p-ps.
      365   entry(1, v-other, "@") = ''.
      366   v-other = trim(v-other, "@").
      367   v-PS = substitute('Кол-во_чеков &2&1строк_чеков &3&1товаров_расход &4&1признаков_расход &5&1товаров_возврат &6&1признаков_возврат &7&1'
      368                       , chr(4)
      369                       , p-chk-amount
      370                       , p-gds-amount
      371                       , p-line-out
      372                       , p-dtl-out
      373                       , p-line-ret
      374                       , p-dtl-ret).
      375   v-ps = v-ps +  substitute("без_докум_чеков &1&2без_докум_строк_чеков &3&2&4@&5"
      376                               , p-nf-chk-amount
      377                               , chr(4)
      378                               , p-nf-gds-amount
      379                               , p-ps-where-rus
      380                               , v-other)
      381                       .
      382   return v-ps.
      383   END FUNCTION.
      384   FUNCTION set-inkas-PS-simple returns character(
      385                                               input p-chk-amount as integer,
      386                                               input p-gds-amount as integer,
      387                                               input p-line-out as integer,
      388                                               input p-dtl-out as integer,
      389                                               input p-line-ret as integer,
      390                                               input p-dtl-ret as integer,
      391                                               input p-nf-chk-amount as integer,
      392                                               input p-nf-gds-amount as integer
      393                                               ):
      394   define variable v-ps as character no-undo .
      395   define variable v-str1 as character no-undo .
      396   assign
      397     v-ps = fill( chr(32) +  chr(4), 9).
      398     v-str1 = ENTRY(1, v-PS, chr(4)).
      399     entry(2, v-str1, chr(32))  = string(p-chk-amount).
      400     ENTRY(1, v-PS, chr(4)) = v-str1.
      401     v-str1 = ENTRY(2, v-PS, chr(4)).
      402     entry(2, v-str1, chr(32))  = string(p-gds-amount).
      403     ENTRY(2, v-PS, chr(4)) = v-str1.
      404     v-str1 = ENTRY(3, v-PS, chr(4)).
      405     entry(2, v-str1, chr(32))  = string(p-line-out).
      406     ENTRY(3, v-PS, chr(4)) = v-str1.
      407     v-str1 = ENTRY(4, v-PS, chr(4)).
      408     entry(2, v-str1, chr(32))  = string(p-dtl-out).
      409     ENTRY(4, v-PS, chr(4)) = v-str1.
      410     v-str1 = ENTRY(5, v-PS, chr(4)).
      411     entry(2, v-str1, chr(32))  = string(p-line-ret).
      412     ENTRY(5, v-PS, chr(4)) = v-str1.
      413     v-str1 = ENTRY(6, v-PS, chr(4)).
      414     entry(2, v-str1, chr(32))  = string(p-dtl-ret).
      415     ENTRY(5, v-PS, chr(4)) = v-str1.
      416     v-str1 = ENTRY(7, v-PS, chr(4)).
      417     entry(2, v-str1, chr(32))  = string(p-nf-chk-amount).
      418     ENTRY(5, v-PS, chr(4)) = v-str1.
      419     v-str1 = ENTRY(8, v-PS, chr(4)).
      420     entry(2, v-str1, chr(32))  = string(p-nf-gds-amount).
      421     ENTRY(5, v-PS, chr(4)) = v-str1.
      422   return v-ps.
      423   END FUNCTION.
      424   FUNCTION get-inkas-nf-PS-simple returns logical (
      425                                                input p-ps as character
      426                                               ,output p-gds-amount as integer
      427                                               ,output p-nf-gds-amount as integer
      428                                               ):
      429   if num-entries(p-ps, chr(4)) >= 8 then do:
      430     assign
      431     p-gds-amount = integer(entry(2, ENTRY(2, p-PS, chr(4)), chr(32)))
      432     p-nf-gds-amount = integer(entry(2, ENTRY(8, p-PS, chr(4)), chr(32)))
      433     no-error .
      434   end.
      435   return not error-status:error .
      436   END FUNCTION.
      437   PROCEDURE get-inkas-PS:
      438   define parameter buffer buf_inkas for ub.inkas.
      439   define output parameter p-chk-amount as integer no-undo .
      440   define output parameter p-gds-amount as integer no-undo .
      441   define output parameter p-line-out as integer no-undo .
      442   define output parameter p-dtl-out as integer no-undo .
      443   define output parameter p-line-ret as integer no-undo .
      444   define output parameter p-dtl-ret as integer no-undo .
      445   define output parameter p-nf-chk-amount as integer no-undo .
      446   define output parameter p-nf-gds-amount as integer no-undo .
      447   define output parameter p-ps-where-rus as character no-undo .
      448   define variable v-gds-amount as integer no-undo .
      449   define variable v-nf-gds-amount as integer no-undo .
      450   define buffer buf_sale-doc for ub.sale-doc.
      451   for each buf_sale-doc no-lock where
      452           buf_sale-doc.inkas-code = buf_inkas.inkas-code
      453       and buf_sale-doc.order > 0:
      454     assign
      455     p-gds-amount = p-gds-amount + (if buf_sale-doc.in-inkas = yes
      456                                    or buf_sale-doc.doc-kind = 'trf':U
      457                                    then buf_sale-doc.gds-amount
      458                                    else 0)
      459     p-line-out = p-line-out  + (if buf_sale-doc.in-inkas = yes
      460                                 and buf_sale-doc.dir = 1
      461                                 then buf_sale-doc.tot-lines
      462                                 else 0)
      463     p-dtl-out = p-dtl-out + (if buf_sale-doc.in-inkas = yes
      464                             and buf_sale-doc.dir = 1
      465                             then buf_sale-doc.tot-dtl
      466                             else 0)
      467     p-line-ret = p-line-ret  + (if buf_sale-doc.in-inkas = yes
      468                                 and buf_sale-doc.dir = -1
      469                                 then buf_sale-doc.tot-lines
      470                                 else 0)
      471     p-dtl-ret = p-dtl-ret + (if buf_sale-doc.in-inkas = yes
      472                              and buf_sale-doc.dir = -1
      473                             then buf_sale-doc.tot-dtl
      474                             else 0)
      475     .
      476   end.
      477   if get-inkas-nf-PS-simple( input buf_inkas.ps
      478                             ,output v-gds-amount
      479                             ,output v-nf-gds-amount) then do:
      480     assign
      481     p-gds-amount = v-gds-amount
      482     p-nf-gds-amount = v-nf-gds-amount
      483     .
      484   end.
      485   assign
      486   p-ps-where-rus = buf_inkas.sale-filter-rus
      487   p-nf-chk-amount = buf_inkas.num-chk-nf
      488   p-chk-amount = buf_inkas.num-chk
      489   .
      490   END PROCEDURE.
      491   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      493   define variable v-ps as character no-undo .
      494   if available buf_sale-doc then
      495   assign
      496   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      497                       , chr(4)
      498                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
      499                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      500                       , buf_sale-doc.chk-amount
      501                       , buf_sale-doc.gds-amount
      502                       , buf_sale-doc.tot-lines
      503                       , buf_sale-doc.tot-dtl
      504                       ).
      505   else  do:
      506   assign
      507   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
      508                       , chr(4)
      509                       , '':U
      510                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
      511                       , 0
      512                       , 0
      513                       , 0
      514                       , 0
      515                       ).
      516   end.
      517   return v-ps.
      518   END FUNCTION.
      519   FUNCTION get-sale-doc-kind returns character (
      520                                                input p-doc-kind as character
      521                                              , input p-ext-doc-type as character
      522                                              , output p-order as integer
      523                                              , output p-msign as integer
      524                                              , output p-main as logical
      525                                              , output p-in-inkas as logical
      526                                              , output p-dir_ as integer
      527                                              ):
      528   define variable v-doc-kind as character no-undo.
      529   define variable v-type as character no-undo .
      530   define variable v-value as character no-undo .
      531   CASE p-doc-kind:
      532     when 'es':U then do:
      533       assign
      534       p-order = 100
      535       p-msign = 1
      536       p-main = yes
      537       p-in-inkas = yes
      538       p-dir_ = 1
      539       .
      540       return p-ext-doc-type.
      541     end.
      542     when  'rs':U then do:
      543       assign
      544       p-order = 200
      545       p-msign = - 1
      546       p-main = no
      547       p-in-inkas = yes
      548       p-dir_ = - 1
      549       .
      550       return p-ext-doc-type.
      551     end.
      552     when 'rwo':U then do:
      553       assign
      554       p-msign = - 1
      555       p-main = no
      556       p-in-inkas = no
      557       p-order = 300
      558       p-dir_ = 1
      559       .
      560       return 'rwo':U.
      561     end.
      562     when 'trf':U then do:
      563       assign
      564       p-msign = 1
      565       p-main = no
      566       p-in-inkas = no
      567       p-order = 400
      568       p-dir_ = 1
      569       .
      570       return 'trf':U.
      571     end.
      572     when 'swo':U then do:
      573      assign
      574      p-msign = 1
      575      p-main = no
      576      p-in-inkas = no
      577      p-order =  500
      578      p-dir_ = 1
      579      .
      580      return 'swo':U.
      581    end.
      582    when 'vir':U then do:
      583      assign
      584      p-msign = 1
      585      p-main = no
      586      p-in-inkas = no
      587      p-order = 600
      588      p-dir_ = 1
      589      .
      590      return 'vir':U.
      591    end.
      592    when 'itr':U then do:
      593      assign
      594      p-msign = 1
      595      p-main = no
      596      p-in-inkas = no
      597      p-order = -1
      598      p-dir_ = -1
      599      .
      600     return 'itr':U.
      601    end.
      602    when 'ngs':U then do:
      603      assign
      604      p-msign = 1
      605      p-main = no
      606      p-in-inkas = no
      607      p-order = 700
      608      p-dir_ = 1
      609      .
      610      return 'ngs':U.
      611    end.
      612    when 'rgs':U then do:
      613      assign
      614      p-msign = -1
      615      p-main = no
      616      p-in-inkas = no
      617      p-order = 701
      618      p-dir_ = -1
      619      .
      620      return 'rgs':U.
      621    end.
      622    otherwise do:
      623       assign
      624       p-msign = 1
      625       p-main = no
      626       p-in-inkas = no
      627       p-order = -1.
      628       return p-ext-doc-type.
      629     end.
      630   END CASE.
      631   END FUNCTION.
      632   procedure saledoc-create :
      633   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      634   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      635   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      636   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      637   define input parameter p-doc-kind as character no-undo .
      638   define input parameter p-office as character no-undo .
      639   define input parameter p-tpsidoc as logical no-undo .
      640   define input parameter p-alias-type-price as character no-undo .
      641   define input parameter p-price-obj-type as character no-undo .
      642   define input parameter p-price-obj-code as integer no-undo .
      643   define parameter buffer buf_trn-doc for ub.trn-doc.
      644   define variable v-order as integer no-undo.
      645   define variable v-main as logical no-undo .
      646   define variable v-in-inkas as logical no-undo .
      647   define variable v-msign as integer no-undo .
      648   define variable v-dir_ as integer no-undo .
      649   define variable v-trn-doc-code as character no-undo .
      650   define buffer buf_sale-doc for ub.sale-doc.
      651   main-block:
      652   do
      653   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      654   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      655   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      656   :
      657      if available buf_trn-doc then do:
      658        v-trn-doc-code = buf_trn-doc.doc-code.
      659      end.
      660      find first buf_sale-doc where
      661               buf_sale-doc.inkas-code = p-inkas-code
      662           and buf_sale-doc.doc-kind = p-doc-kind
      663           and buf_sale-doc.chr-office = p-office
      664           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
      665           no-error .
      666      if not available buf_sale-doc  then do:
      667         create buf_sale-doc.
      668         assign
      669         buf_sale-doc.inkas-code = p-inkas-code
      670         buf_sale-doc.storage =  'trn-doc':U
      671         buf_sale-doc.host-code = p-host-code
      672         buf_sale-doc.obj-type = p-obj-type
      673         buf_sale-doc.obj-code = p-obj-code
      674         buf_sale-doc.doc-kind  = p-doc-kind
      675         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
      676         buf_sale-doc.chr-office = p-office
      677         buf_sale-doc.doc-code = v-trn-doc-code
      678         .
      679      end.
      680      if available buf_trn-doc then
      681      buffer-copy buf_trn-doc
      682      to buf_sale-doc
      683      .
      684     assign
      685     buf_sale-doc.doc-kind = get-sale-doc-kind (
      686                                                input p-doc-kind
      687                                               ,input buf_sale-doc.ext-doc-type
      688                                               ,output v-order
      689                                               ,output v-msign
      690                                               ,output v-main
      691                                               ,output v-in-inkas
      692                                               ,output v-dir_).
      693     assign
      694     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
      695     buf_sale-doc.main-doc = v-main
      696     buf_sale-doc.in-inkas = v-in-inkas
      697     buf_sale-doc.msign = v-msign
      698     buf_sale-doc.dir = v-dir_
      699     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
      700     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
      701     buf_sale-doc.poss-wro-codes = '':U
      702     buf_sale-doc.chr-office = p-office
      703     buf_sale-doc.tpsidoc = p-tpsidoc
      704     buf_sale-doc.alias-type-price = p-alias-type-price
      705     buf_sale-doc.price-obj-type = (if p-tpsidoc
      706                                    then p-price-obj-type
      707                                    else '':U)
      708     buf_sale-doc.price-obj-code = (if p-tpsidoc
      709                                    then p-price-obj-code
      710                                    else 0)
      711     .
      712     assign
      713     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
      714     no-error.
      715   end.
      716   END.
      717   procedure fbr-saledoc-create :
      718   define input parameter p-inkas-code as character no-undo .
      719   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
      720   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
      721   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
      722   define buffer buf_fbr-doc for ub.fbr-doc.
      723   define buffer buf_trn-doc for ub.trn-doc.
      724   define buffer buf_sale-doc for ub.sale-doc.
      725   define buffer buf2_sale-doc for ub.sale-doc.
      726   define buffer buf2_trn-doc for ub.trn-doc.
      727   define buffer buf_doc-line for ub.doc-line.
      728   define buffer buf_gds-dtl for ub.gds-dtl.
      729   define buffer buf_chk-gds for ub.chk-gds.
      730   define buffer buf_chk-doc for ub.chk-doc.
      731   do
      732   on error undo, return error
      733   :
      734     for each buf_fbr-doc no-lock where
      735           buf_fbr-doc.out-code = p-inkas-code:
      736       for each buf_trn-doc no-lock where
      737             buf_trn-doc.out-code = buf_fbr-doc.doc-code
      738       by buf_trn-doc.fact-order
      739       on error undo, return error:
      740         if buf_trn-doc.ext-doc-type = 'em':U
      741         or buf_trn-doc.ext-doc-type = 'im':U
      742         or buf_trn-doc.ext-doc-type = 'wm':U
      743         or buf_trn-doc.ext-doc-type = 'ev':U
      744         or buf_trn-doc.ext-doc-type = 'iv':U
      745         then do:
      746           find first buf_sale-doc where
      747                   buf_sale-doc.inkas-code = p-inkas-code
      748               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
      749               AND buf_sale-doc.storage  = 'trn-doc':U
      750                   no-error .
      751           if not available buf_sale-doc then do:
      752           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
      753           end.
      754           if buf_trn-doc.ext-doc-type = 'im':U then do:
      755             assign
      756             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
      757             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
      758             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
      759             .
      760           end.
      761           for each buf2_trn-doc no-lock where
      762                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
      763             find first buf2_sale-doc where
      764                     buf2_sale-doc.inkas-code = p-inkas-code
      765                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
      766                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
      767             if not available buf2_sale-doc then do:
      768               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
      769             end.
      770           end.
      771         end.
      772       end.
      773       find first buf_sale-doc where
      774                 buf_sale-doc.inkas-code = p-inkas-code
      775             AND buf_sale-doc.storage = 'fbr-doc':U
      776             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
      777       if not available buf_sale-doc then do:
      778         create buf_sale-doc.
      779         assign
      780         buf_sale-doc.storage       =  'fbr-doc':U
      781         buf_sale-doc.doc-type      = 'производство':U
      782         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
      783         buf_sale-doc.ext-doc-type  = 'производство':U
      784         buf_sale-doc.doc-kind      = 'производство':U
      785         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
      786         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
      787         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
      788         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
      789         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
      790         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
      791         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
      792         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
      793         buf_sale-doc.fbrsale       = yes
      794         buf_sale-doc.inkas-code    = p-inkas-code
      795         .
      796       end.
      797     end.
      798   end.
      799   end procedure.
      800   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   FUNCTION get-inc-sal returns integer(input p-chk-type as character
      802                                      , input p-netto as decimal
      803                                      , input p-chk-doc as logical
      804                                      , input p-office as character
      805                                      , input p-write-off-code  as character
      806                                      , output p-add as logical
      807                                      , output p-office-to-reserv as character
      808                                      , output p-kind-to-reserv as character
      809                                      , output p-add-nf-amount as integer
      810                                      ):
      811   define variable v-docs-to-reserv as integer no-undo.
      812   if lookup(p-chk-type , '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
      813   then do:
      814       assign
      815       v-docS-to-reserv = 0
      816       p-kind-to-reserv = '':U
      817       p-add-nf-amount = 1
      818       .
      819       return v-docs-to-reserv.
      820   end.
      821   p-add = no.
      822   if p-chk-doc then do:
      823     if p-chk-type = ? then do:
      824       if p-netto >= 0 then do:
      825         assign
      826         p-chk-type = '1':U.
      827       end.
      828       if p-netto < 0 then do:
      829         assign
      830         p-chk-type = '6':U.
      831       end.
      832     end.
      833     CASE p-chk-type:
      834       when '1':U then do:
      835         assign
      836         p-kind-to-reserv = 'es':U
      837         v-docs-to-reserv = 1
      838         .
      839       end.
      840       when '6':U then do:
      841         assign
      842         p-kind-to-reserv = 'rs':U
      843         v-docs-to-reserv = 1
      844         .
      845       end.
      846       when '17':U then do:
      847         assign
      848         p-kind-to-reserv = 'trf':U
      849         v-docs-to-reserv = 1
      850         .
      851       end.
      852       when '96':U then do:
      853         assign
      854         p-kind-to-reserv = 'rs':U + chr(44) + 'rwo':U
      855         v-docs-to-reserv = 2
      856         .
      857       end.
      858       when '69':U then do:
      859         assign
      860         p-kind-to-reserv = 'swo':U
      861         v-docs-to-reserv = 1
      862         .
      863       end.
      864       otherwise do:
      865         assign
      866         p-kind-to-reserv = '':U
      867         v-docs-to-reserv = 0
      868         .
      869       End.
      870     END CASE.
      871     ASSIGN
      872     p-add-nf-amount = 0.
      873     if p-office = 'т':U
      874     or p-office = 'у':U then do:
      875       p-office-to-reserv = (if v-docs-to-reserv = 0
      876                             then '':U
      877                             else trim(fill((p-office + chr(44)), v-docs-to-reserv), chr(44))).
      878     end.
      879     else do:
      880       assign
      881       p-office-to-reserv  = (if v-docs-to-reserv = 0
      882                              then '':U
      883                              else (trim(fill(entry(1, p-office) + chr(44), v-docs-to-reserv), chr(44)) +
      884                                   chr(44) +
      885                                    trim(fill(entry(2, p-office) + chr(44), v-docs-to-reserv), chr(44))))
      886       v-docs-to-reserv = v-docs-to-reserv * 2
      887       p-kind-to-reserv = (if p-kind-to-reserv = '':U
      888                           then  '':U
      889                           else (p-kind-to-reserv + chr(44) + p-kind-to-reserv)) .
      890     end.
      891     return v-docs-to-reserv.
      892   end.
      893   else do:
      894     ASSIGN
      895     P-kind-to-reserv = '':U
      896     p-add-nf-amount = 0
      897     p-add = yes
      898     p-office-to-reserv = '':U
      899     .
      900     if p-write-off-code = '0':U
      901     or p-write-off-code = ? then do:
      902       return 0.
      903     end.
      904     CASE p-chk-type:
      905       when '1':U
      906       then do:
      907          if p-write-off-code = '1':U
      908          or p-write-off-code = '3':U
      909          then do:
      910             assign
      911             p-kind-to-reserv = 'swo':U
      912             v-docs-to-reserv = 1
      913             p-add = no
      914             p-office-to-reserv = p-office
      915             .
      916          end.
      917       end.
      918       when '6':U then do:
      919          if p-write-off-code = '-6':U
      920          or p-write-off-code = '-3':U
      921          then do:
      922             assign
      923             p-kind-to-reserv = 'rwo':U
      924             v-docs-to-reserv = 1
      925             p-add = no
      926             p-office-to-reserv = p-office
      927             .
      928          end.
      929       end.
      930     END CASE.
      931     return v-docs-to-reserv.
      932   end.
      933   END FUNCTION.
      934   define new global shared variable g#lib-trn  as handle no-undo .
      935   define new global shared variable g#lib-trn2 as handle no-undo .
      936   define new global shared variable g#lib-trn3 as handle no-undo .
      937   define new global shared variable g#lib-trn4 as handle no-undo .
      938   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   define new global shared variable g#attr-lib  as handle no-undo .
      940   define variable v-attr-lib-variable as handle no-undo .
      941   procedure gds-attr-name :
      942     define input  parameter p-code           as character no-undo .
      943     define output parameter p-type           as character no-undo .
      944     define output parameter p-format         as character no-undo .
      945     define output parameter p-label          as character no-undo .
      946     define output parameter p-user-can-edit  as logical   no-undo .
      947     define output parameter p-output-display as logical   no-undo .
      948     define output parameter p-other          as character no-undo .
      949     do
      950     on error undo, return error
