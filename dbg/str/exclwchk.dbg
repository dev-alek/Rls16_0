     1560   function cross-list returns logical (
     1561     input parfirst-stream  as character,
     1562     input parsecond-stream as character,
     1563     input pardelim         as character).
     1564     if pardelim = ""
     1565     or pardelim = ?
     1566     then do:
     1567       assign
     1568         pardelim = ","
     1569       .
     1570     end.
     1571     define variable vari            as integer no-undo .
     1572     define variable varresult-cross as logical no-undo .
     1573     assign
     1574       varresult-cross = no
     1575     .
     1576     def var v-num-parfirst-stream as integer no-undo .
     1577     assign
     1578       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
     1579     .
     1580     do vari = 1 to v-num-parfirst-stream
     1581     :
     1582       if lookup(entry(vari, parfirst-stream, pardelim)
     1583                ,parsecond-stream
     1584                ,pardelim
     1585                ) > 0 then do:
     1586         assign
     1587           varresult-cross = yes
     1588         .
     1589         leave.
     1590       end.
     1591     end.
     1592     return varresult-cross .
     1593   end function.
     1594   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1595   function octal-to-char return character
     1596   ( p-string as character ) :
     1597     def var v-asc     as integer no-undo .
     1598     def var v-new-asc as integer no-undo .
     1599     def var ind       as integer no-undo .
     1600     if length(p-string) <> 3 then do:
     1601       return ? .
     1602     end.
     1603     assign
     1604       v-asc = 0
     1605     .
     1606     do ind = 1 to length(p-string)
     1607     :
     1608       assign
     1609         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     1610       .
     1611       if v-new-asc < 0 or v-new-asc >= 8 then do:
     1612         return ? .
     1613       end.
     1614       assign
     1615         v-asc = v-asc * 8 + v-new-asc
     1616       .
     1617     end.
     1618     return chr(v-asc) .
     1619   end function .
     1620   function char-to-octal return character
     1621   ( p-chr as character ) :
     1622     def var v-asc    as integer   no-undo .
     1623     def var ind      as integer   no-undo .
     1624     def var v-string as character no-undo .
     1625     if length(p-chr) <> 1 then do:
     1626       return ? .
     1627     end.
     1628     assign
     1629       v-asc    = asc(p-chr)
     1630       v-string = ""
     1631     .
     1632     do ind = 1 to 3
     1633     :
     1634       assign
     1635         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     1636       .
     1637       assign
     1638         v-asc = truncate(v-asc / 8, 0)
     1639       .
     1640     end.
     1641     return v-string .
     1642   end.
     1643   function str-encode return character
     1644   (   p-init-string       as character
     1645     , p-encode-char       as character
     1646     , p-special-char-list as character
     1647   ) :
     1648     def var p-encode-string as character no-undo .
     1649     def var ind                as integer no-undo .
     1650     def var v-num-special-char as integer no-undo .
     1651     def var v-special-char     as character no-undo .
     1652     if p-encode-char = ?
     1653     or p-encode-char = "" then do:
     1654       assign
     1655         p-encode-char = "~~"
     1656       .
     1657     end.
     1658     if p-init-string = ? then do:
     1659       return "?" .
     1660     end.
     1661     if p-init-string = "?" then do:
     1662       return p-encode-char + char-to-octal("?") .
     1663     end.
     1664     assign
     1665       v-num-special-char = length(p-special-char-list)
     1666       p-encode-string    = replace(p-init-string
     1667                                   ,p-encode-char
     1668                                   ,p-encode-char + char-to-octal(p-encode-char)
     1669                                   )
     1670     .
     1671     do ind = 1 to v-num-special-char
     1672     :
     1673       assign
     1674         v-special-char = substring(p-special-char-list, ind, 1)
     1675       .
     1676       if v-special-char <> p-encode-char then do:
     1677         assign
     1678           p-encode-string = replace (p-encode-string
     1679                                     ,v-special-char
     1680                                     ,p-encode-char + char-to-octal(v-special-char)
     1681                                     )
     1682         .
     1683       end.
     1684     end.
     1685     return p-encode-string .
     1686   end.
     1687   function str-decode returns character
     1688     (p-init-string   as character
     1689     ,p-encode-char   as character
     1690     ) :
     1691     def var p-decode-string as character no-undo .
     1692     def var ind                       as integer no-undo .
     1693     def var v-num-entries-init-string as integer no-undo .
     1694     def var v-sub-phrase              as character no-undo .
     1695     def var v-special-char            as character no-undo .
     1696     if p-encode-char = ?
     1697     or p-encode-char = "" then do:
     1698       assign
     1699         p-encode-char = "~~"
     1700       .
     1701     end.
     1702     if p-init-string = "?" then do:
     1703       return ? .
     1704     end.
     1705     assign
     1706       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     1707     .
     1708     if v-num-entries-init-string > 1 then do:
     1709       assign
     1710         p-decode-string = entry(1, p-init-string, p-encode-char)
     1711       .
     1712       do ind = 2 to v-num-entries-init-string
     1713       :
     1714         assign
     1715           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     1716         .
     1717         assign
     1718           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     1719         .
     1720         if v-special-char <> ? then do:
     1721           assign
     1722             p-decode-string = p-decode-string
     1723                             + v-special-char
     1724                             + substring(v-sub-phrase, 4)
     1725           .
     1726         end.
     1727         else do:
     1728           assign
     1729             p-decode-string = p-decode-string
     1730                             + p-encode-char
     1731                             + v-sub-phrase
     1732           .
     1733         end.
     1734       end.
     1735     end.
     1736     else do:
     1737       assign
     1738         p-decode-string = p-init-string
     1739       .
     1740     end.
     1741     return p-decode-string .
     1742   end.
     1743   function is-gas returns logical
