     1789     ,input  inkas.obj-code
     1790     ,output v-host-code
     1791     )  .
     1792       run get-inkas-ps in this-procedure (
     1793                                           buffer inkas
     1794                                         , output chk-amount
     1795                                         , output gds-amount
     1796                                         , output line-out
     1797                                         , output dtl-out
     1798                                         , output line-ret
     1799                                         , output dtl-ret
     1800                                         , output nf-chk-amount
     1801                                         , output nf-gds-amount
     1802                                         , output p-filter-rus
     1803                                         ).
     1804     FIND FIRST buf0_trn-doc exclusive-lock WHERE
     1805              buf0_trn-doc.doc-code = X_chk-doc.out-code no-wait NO-ERROR.
     1806     if not avail buf0_trn-doc then do:
     1807         message
     1808         substitute("Не найдена или не занята накладная &1!", X_chk-doc.out-code)  view-as alert-box ERROR.
     1809         undo, return error.
     1810     end.
     1811   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1813     (output v-curr-r-b
     1814     )  .
     1815     for each buf_sale-doc where
     1816             buf_Sale-doc.inkas-code = inkas.inkas-code
     1817     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1818     :
     1819       buf_sale-doc.chk-doc-code = '':U.
     1820     end.
     1821     f-del:
     1822     DO on ERROR undo, return error
     1823     on STOP undo, return error :
     1824     run waitfram-show in this-procedure ( substitute("Освобождаю чек МЦ &1...", X_chk-doc.doc-code)).
     1825     FOR  EACH buf_chk-pay WHERE
     1826               buf_chk-pay.doc-code = X_chk-doc.doc-code
     1827     BREAK
     1828     BY buf_chk-pay.doc-code
     1829     BY buf_chk-pay.pay-code
     1830     BY buf_chk-pay.curr-code
     1831     on ERROR undo, return error error-status:get-message(1):
     1832       find first buf_inkas-pay-wth where
     1833                 buf_inkas-pay-wth.inkas-code = X_chk-doc.out-code
     1834             and buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     1835             and buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     1836             and buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     1837             and buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     1838             and buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     1839             and buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     1840             and buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type no-error.
     1841       if not available  buf_inkas-pay-wth then do:
     1842         create buf_inkas-pay-wth.
     1843         assign
     1844         buf_inkas-pay-wth.inkas-code = X_chk-doc.out-code
     1845         buf_inkas-pay-wth.pay-code = buf_chk-pay.pay-code
     1846         buf_inkas-pay-wth.curr-code = buf_chk-pay.curr-code
     1847         buf_inkas-pay-wth.wth-code = buf_chk-pay.wth-code
     1848         buf_inkas-pay-wth.par-code = buf_chk-pay.par-code
     1849         buf_inkas-pay-wth.pay-desk = X_chk-doc.pay-desk
     1850         buf_inkas-pay-wth.cashier = X_chk-doc.cashier
     1851         buf_inkas-pay-wth.chk-type = X_chk-doc.chk-type
     1852         buf_inkas-pay-wth.par-val = buf_chk-pay.par-val
     1853         .
     1854       end.
     1855       assign
     1856       buf_inkas-pay-wth.tot-sum = buf_inkas-pay-wth.tot-sum - buf_chk-pay.tot-sum
     1857       buf_inkas-pay-wth.tot-base = buf_inkas-pay-wth.tot-base - buf_chk-pay.tot-base
     1858       buf_inkas-pay-wth.tot-rubl = buf_inkas-pay-wth.tot-rubl - buf_chk-pay.tot-rubl
     1859       buf_inkas-pay-wth.doc-qnty = buf_inkas-pay-wth.doc-qnty - buf_chk-pay.doc-qnty
     1860       buf_inkas-pay-wth.tot-lines = buf_inkas-pay-wth.tot-lines - 1
     1861       .
     1862       if buf_inkas-pay-wth.tot-sum = 0 then delete buf_inkas-pay-wth.
     1863       buf_chk-pay.out-code = ? .
     1864     end.
     1865     FOR EACH buf_chk-doc-attr where buf_chk-doc-attr.doc-code = X_chk-doc.doc-code
     1866     on error undo, return error error-status:get-message(1)
     1867     :
     1868         buf_chk-doc-attr.out-code = ?.
     1869     END.
     1870     for each buf_c-chk-doc where
     1871             buf_c-chk-doc.doc-code = X_chk-doc.doc-code
     1872      on error undo, return error error-status:get-message(1) :
     1873       assign
     1874       buf_c-chk-doc.out-code = ?
     1875       .
     1876     end.
     1877     for each buf_c-chk-pay where
     1878             buf_c-chk-pay.doc-code = X_chk-doc.doc-code
     1879      on error undo, return error error-status:get-message(1)
     1880             :
     1881       assign
     1882       buf_c-chk-pay.out-code = ?
     1883       .
     1884     end.
     1885     for each buf_c-chk-doc-attr where
     1886             buf_c-chk-doc-attr.doc-code = X_chk-doc.doc-code
     1887     on error undo, return error error-status:get-message(1)
     1888             :
     1889       assign
     1890       buf_c-chk-doc-attr.out-code = ?
     1891       .
     1892     end.
     1893     run waitfram-show in this-procedure ( substitute("Пересчитываю общие суммы по накладным после исключения чека &1...", X_chk-doc.doc-code)).
     1894     assign
     1895     inkas.num-chk = inkas.num-chk  - 1
     1896     inkas.num-chk-nf = inkas.num-chk-nf - 1
     1897     .
     1898     assign
     1899     inkas.PS = set-inkas-ps(input inkas.ps
     1900                           , input chk-amount
     1901                           , input gds-amount
     1902                           , input line-out
     1903                           , input dtl-out
     1904                           , input line-ret
     1905                           , input dtl-ret
     1906                           , input inkas.num-chk
     1907                           , input inkas.num-chk-nf
     1908                           , input p-filter-rus
     1909                           )
     1910     .
     1911     X_chk-doc.out-code = ? .
     1912     run waitfram-hide in this-procedure .
     1913   END.
     1914   end.
