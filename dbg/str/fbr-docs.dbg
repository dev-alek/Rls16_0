     6118               where buf_temp-browse-handle.browse-type   = 'height':u
     6119                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6120               no-error .
     6121             if available buf_temp-browse-handle
     6122             then do:
     6123             end.
     6124             else do:
     6125               create buf_temp-diasize-handle .
     6126               assign
     6127                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6128                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6129               .
     6130             end.
     6131           end.
     6132           assign
     6133             v-object-handle = v-object-handle :next-sibling
     6134           .
     6135         end.
     6136         assign
