      714   end procedure.
      715   procedure fbrhist-read-conf :
      716   do
      717   on error undo, return error
      718   :
      719      define variable v-value-character as character  no-undo .
      720      define variable v-value-date      as date       no-undo .
      721      define variable v-value-decimal   as decimal    no-undo .
      722      define variable v-value-logical   as logical    no-undo .
      723      define variable v-tth             as handle     no-undo .
      724      define variable v-param-type            as character no-undo .
      725      run adm/shattri.p ( input "get":U
      726                        , input  '':u
      727                        , input  0
      728                        , input  'fbrattr':U
      729                        , input  'fbrhstlv':U
      730                        , output v-value-character
      731                        , output v-value-date
      732                        , output v-value-decimal
      733                        , output v-fbrhist-history-level
      734                        , output v-value-logical
      735                        , output v-param-type
      736                        , input-output table-handle v-tth
      737                        ) no-error .
      738      if error-status :error then do:
      739         assign
      740            v-fbrhist-history-level = 0
      741         .
      742      end.
      743   end.
      744   end procedure.
      745   procedure fbrhist-table-to-base :
      746       define buffer buf_fbr-history       for ub.fbr-history.
      747       define buffer buf_temp_fbr-history  for temp_fbr-history.
      748   do
      749   for buf_fbr-history
      750     , buf_temp_fbr-history
      751   on error undo, return error
      752   :
      753       for each buf_temp_fbr-history
      754       on error undo, return error
      755       :
      756           create buf_fbr-history.
      757           buffer-copy buf_temp_fbr-history to buf_fbr-history.
      758       end.
      759   end.
      760   end procedure.
      761   procedure fbrhist-init :
      762       define buffer buf_temp_fbr-history      for temp_fbr-history.
      763   do
      764   for buf_temp_fbr-history
      765   on error undo, return error
      766   :
      767       for each buf_temp_fbr-history
      768       :
      769           delete buf_temp_fbr-history.
      770       end.
