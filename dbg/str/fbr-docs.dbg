     6298   procedure diasize_set-height :
     6299     define input  parameter p-new-height  as decimal   no-undo .
     6300     define input  parameter p-move-resize as logical   no-undo .
     6301     do
     6302     on error undo, return error return-value
     6303     :
     6304       run diasize_change-height in this-procedure
     6305         (input  (p-new-height - frame d-fbr-docs :height)
     6306         ,input  p-move-resize
     6307         ) .
     6308     end.
     6309   end procedure.
     6310   procedure diasize_change-width :
     6311     define input  parameter p-change-value as decimal   no-undo .
     6312     define input  parameter p-move-resize  as logical   no-undo .
     6313     define variable v-field-group-handle   as handle    no-undo .
     6314     define variable v-object-handle        as handle    no-undo .
     6315     define variable v-frame-width          as decimal   no-undo .
     6316     define variable v-frame-virtual-width  as decimal   no-undo .
     6317     define variable v-browse-width         as decimal   no-undo .
     6318     define variable v-window-width         as decimal   no-undo .
     6319     define variable v-window-virtual-width as decimal   no-undo .
     6320     define variable v-change-sign          as integer   no-undo .
     6321     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6322     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6323     if p-change-value > 0
     6324     then do:
     6325       if frame d-fbr-docs :width + p-change-value >
     6326           session :width-chars
     6327       then do:
     6328         assign
     6329           p-change-value = session :width-chars - frame d-fbr-docs :width
     6330         .
     6331         if p-change-value <= 0
     6332         then do:
     6333           run diasize_position-resize-button in this-procedure .
     6334           return .
     6335         end.
     6336       end.
     6337     end.
     6338     if p-change-value < 0
     6339     then do:
     6340       if frame d-fbr-docs :width + p-change-value < v-diasize-orig-frame-width
     6341       then do:
     6342         assign
     6343           p-change-value = v-diasize-orig-frame-width
     6344                          - frame d-fbr-docs :width
     6345         .
     6346         if p-change-value >= 0
     6347         then do:
     6348           run diasize_position-resize-button in this-procedure .
     6349           return .
     6350         end.
     6351       end.
     6352     end.
     6353     if p-change-value >= 0
     6354     then do:
     6355       assign
     6356         v-change-sign = 1
     6357       .
     6358     end.
     6359     else do:
     6360       assign
     6361         v-change-sign = -1
     6362       .
     6363     end.
     6364     assign
     6365       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6366     .
     6367     if p-change-value = 0
     6368     then do:
     6369       run diasize_position-resize-button in this-procedure .
     6370       return .
     6371     end.
     6372     move_block:
     6373     do
     6374     on error undo move_block, leave move_block
     6375     :
     6376       if retry
     6377       then do:
     6378         do
     6379         on error undo move_block, leave move_block
     6380         :
     6381           if p-change-value > 0
     6382           then do:
     6383             for each buf_temp-diasize-handle
     6384             on error undo, next
     6385             :
     6386               assign
     6387                 v-object-handle = buf_temp-diasize-handle.handle-value
     6388               .
     6389               if v-object-handle <> v-diasize-resize-button
     6390               then do:
     6391                 assign
