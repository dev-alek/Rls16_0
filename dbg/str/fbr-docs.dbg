     6393                 .
     6394               end.
     6395             end.
     6396             assign
     6397               v-diasize-browse-handle :width = v-browse-width
     6398             .
     6399             for each buf_temp-browse-handle
     6400               where buf_temp-browse-handle.browse-type = 'width':u
     6401             on error undo, next
     6402             :
     6403               assign
     6404                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6405               .
     6406             end.
     6407             assign
     6408               frame d-fbr-docs :width = v-frame-width
     6409             .
