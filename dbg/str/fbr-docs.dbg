      701                       + chr(2)  + string( buf_temp_fbr-history.obj-type )
      702                                               + "-":U + string( buf_temp_fbr-history.obj-code )
      703                                               + "-":U + string( buf_temp_fbr-history.hst-code )
      704           .
      705       end.
      706       else do:
      707           assign
      708               buf_temp_fbr-history.hst-node-path = string( buf_temp_fbr-history.obj-type )
      709                                  + "-":U + string( buf_temp_fbr-history.obj-code )
      710                                  + "-":U + string( buf_temp_fbr-history.hst-code )
      711           .
      712       end.
