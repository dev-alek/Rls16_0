     6207           end.
     6208         end.
     6209       end.
     6210       else do:
     6211         for each buf_temp-diasize-handle
     6212         on error undo move_block, retry move_block
     6213         :
     6214           assign
     6215             v-object-handle = buf_temp-diasize-handle.handle-value
     6216           .
     6217           if v-object-handle <> v-diasize-resize-button
     6218           then do:
     6219             assign
