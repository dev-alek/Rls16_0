     7818     )  .
     7819   define variable vss-include-info87 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7820   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     7821     (input  f-doc.creid
     7822     ,output v-fbr-docs-oper-nik
     7823     )  .
     7824   end.
     7825   else do:
     7826       assign
     7827           v-fbr-docs-nik      = "":U
     7828           v-fbr-docs-oper-nik = "":U
     7829       .
     7830   end.
     7831   display
     7832       v-fbr-docs-nik
     7833       v-fbr-docs-oper-nik
     7834   with frame d-fbr-docs .
     7835   END PROCEDURE.
     7836   PROCEDURE open-fbr-doc :
     7837   define input parameter p-fbr-doc-doc-code as character    no-undo.
     7838       define variable v-fbroperator-string    as character    no-undo.
     7839       define variable v-par-type              as character    no-undo.
     7840       define variable varchip-code like ub.c-trn-doc.chip-num no-undo .
     7841       define variable varchip-code2 like ub.c-trn-doc.chip-num no-undo .
     7842       define buffer buf_fbr-line      for fbr-line.
     7843       define buffer buf_del_fbr-line  for fbr-line.
     7844       define buffer buf_fbr-doc       for fbr-doc.
     7845   do
     7846   for buf_fbr-line
     7847     , buf_del_fbr-line
     7848     , buf_fbr-doc
     7849   on error undo, return error
     7850   :
     7851       run fbrattr-value in this-procedure (
     7852             input 'fbr-doc':U
     7853           , input p-fbr-doc-doc-code
     7854           , input 'fbroperator':U
     7855           , output v-fbroperator-string
     7856       ).
     7857       run fbrlib-del-trn-doc in this-procedure (
     7858             input parparentproc
     7859           , input p-fbr-doc-doc-code
     7860           , input 'рас':U
     7861           , input ?
     7862           , output varchip-code
     7863       ) no-error.
     7864       if error-status:error then do:
     7865         message
     7866         substitute("Ошибка при удалении складского документа, созданного по документу производства &1&2&3&2&4"
     7867                     , f-doc.doc-code
     7868                     , chr(10)
     7869                     , error-status:get-message(1)
     7870                     , return-value
     7871                     )
     7872         view-as alert-box error .
     7873       end.
     7874       run fbrlib-del-trn-doc in this-procedure (
     7875             input parparentproc
     7876           , input p-fbr-doc-doc-code
     7877           , input 'спи':U
     7878           , input varchip-code
     7879           , output varchip-code2
     7880       ) no-error.
     7881       if error-status:error then do:
     7882         message
     7883         substitute("Ошибка при удалении складского документа, созданного по документу производства &1&2&3&2&4"
     7884                     , f-doc.doc-code
     7885                     , chr(10)
     7886                     , error-status:get-message(1)
     7887                     , return-value
     7888                     )
     7889         view-as alert-box error .
     7890       end.
     7891       do transaction
     7892       on error undo, return error
     7893       :
     7894           for each buf_fbr-line no-lock
     7895              where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     7896           on error undo, return error
     7897           :
     7898               find first buf_del_fbr-line exclusive-lock
     7899                   where recid( buf_del_fbr-line ) = recid( buf_fbr-line )
     7900               .
     7901               if buf_del_fbr-line.rsrv-qnty <> ?
     7902               then do:
     7903                   assign
     7904                       buf_del_fbr-line.rsrv-qnty = 0
     7905                   .
     7906               end.
     7907               assign
     7908                   buf_del_fbr-line.price-base = ?
     7909                   buf_del_fbr-line.price-rubl = ?
     7910                   buf_del_fbr-line.price-sum-base = ?
     7911                   buf_del_fbr-line.price-sum-rubl = ?
     7912                   buf_del_fbr-line.price-sum-vat-base = ?
     7913                   buf_del_fbr-line.price-sum-vat-rubl = ?
     7914                   buf_del_fbr-line.fix-cost = no
     7915               .
     7916           end.
     7917           find first buf_fbr-doc exclusive-lock
     7918               where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     7919           .
     7920           assign
     7921               buf_fbr-doc.status_     = 'новый':U
     7922               buf_fbr-doc.in-qnty     = 0
     7923               buf_fbr-doc.out-qnty    = 0
     7924               buf_fbr-doc.in-sale     = ?
     7925               buf_fbr-doc.out-sale    = ?
     7926               buf_fbr-doc.in-base     = 0
     7927               buf_fbr-doc.in-rubl     = 0
     7928               buf_fbr-doc.in-vat-base = 0
     7929               buf_fbr-doc.in-vat-rubl = 0
     7930           .
     7931       end.
     7932       if v-fbroperator-string <> "":U
     7933       and v-fbroperator-string <> ?
     7934       and v-fbroperator-string <> "0":U
     7935       then do:
     7936           run fbrattr-write in this-procedure (
     7937                 input 'fbr-doc':U
     7938               , input p-fbr-doc-doc-code
     7939               , input 'fbroperator':U
     7940               , input v-fbroperator-string
     7941           ) no-error.
     7942           if error-status :error
     7943           then do:
     7944               message
     7945                       vss-workfile vss-revision vss-description
     7946                   skip(1)
     7947                   skip "Не удалось создать запись оператора производства."
     7948                   skip return-value
     7949                   skip trim(error-status :get-message(1))
     7950                       trim(error-status :get-message(2))
     7951                       trim(error-status :get-message(3))
     7952               view-as alert-box warning.
     7953           end.
     7954       end.
     7955   end.
     7956   END PROCEDURE.
     7957   PROCEDURE init-flt :
     7958   do
     7959   on error undo, return error
     7960   :
     7961       assign
     7962           tbl         = "fbr-doc":U
     7963           join-tbl    = "f-doc":U
     7964           fld         = "status_,doc-code,doc-date,fact-date,obj-type*obj-code,creid":U
     7965           lab         = "Статус,,Дата,Факт,Объект,":U
     7966           spr         = "fbr-stat,,,,cli,":U
     7967           dim         = "6":U
     7968       .
     7969       run fltfield-clear in this-procedure (
     7970             output fld
     7971           , output lab
     7972           , output spr
     7973           , output dim
     7974       )  no-error.
     7975       run fltfield-add in this-procedure ( 'out-code'                       , 'Номер план-меню/продажи'   , ''        , input-output fld, input-output lab, input-output spr, input-output dim )  no-error.
     7976       run fltfield-add in this-procedure ( 'doc-code'                       , 'Номер'                     , ''        , input-output fld, input-output lab, input-output spr, input-output dim )  no-error.
     7977       run fltfield-add in this-procedure ( 'status_'                        , 'Статус'                    , ''        , input-output fld, input-output lab, input-output spr, input-output dim )  no-error.
     7978       run fltfield-add in this-procedure ( 'in-qnty'                        , 'Кол.при'                   , ''        , input-output fld, input-output lab, input-output spr, input-output dim )  no-error.
     7979       run fltfield-add in this-procedure ( 'out-qnty'                       , 'Кол.рас'                   , ''        , input-output fld, input-output lab, input-output spr, input-output dim )  no-error.
     7980       run fltfield-add in this-procedure ( 'fact-date'                      , 'Дата факт'                 , ''        , input-output fld, input-output lab, input-output spr, input-output dim )  no-error.
     7981   end.
     7982   END PROCEDURE.
     7983   PROCEDURE UI-on-empty :
     7984   do
     7985   on error undo, return error
     7986   :
     7987     define input  parameter p-open-query     as logical   no-undo .
     7988     define variable v-query-was-opened as logical no-undo .
     7989     define buffer buf_goods for ub.goods .
     7990     assign
     7991         v-fbr-docs-where-cond = " false ":U
     7992     .
     7993   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7994   define variable  l-disable-where-89  as logical   no-undo .
     7995   define variable  l-filter-open-89    as logical   .
     7996   define variable  flt-rec-89       as recid     no-undo .
     7997   define variable  filter-name-89      as character no-undo .
     7998   define variable  where-phrase-89     as character no-undo .
     7999   define variable  sort-phrase-89      as character no-undo .
     8000   define variable  where-phrase-rus-89 as character no-undo .
     8001   define variable  sort-phrase-rus-89  as character no-undo .
     8002     run waitfram-show in this-procedure
     8003       (input "ЖДИТЕ ..."
     8004       ).
     8005   run gbl/flt-get.p
     8006     (input c-point
     8007     ,output flt-rec-89
     8008     ,output filter-name-89
     8009     ,output where-phrase-89
     8010     ,output sort-phrase-89
     8011     ,output where-phrase-rus-89
     8012     ,output sort-phrase-rus-89
     8013     ).
     8014       run set-filter-name in this-procedure
     8015         (INPUT filter-name-89
     8016         ) no-error .
     8017     assign
     8018       l-filter-open-89 = false
     8019     .
     8020     if flt-rec-89 <> ?
     8021     then do:
     8022       define variable  parameter-2-89 as character no-undo .
     8023       define variable  parameter-3-89 as character no-undo .
     8024       define variable  parameter-4-89 as character no-undo .
     8025       define variable  parameter-5-89 as character no-undo .
     8026       define variable  parameter-6-89 as character no-undo .
     8027       define variable  parameter-7-89 as character no-undo .
     8028         assign
     8029         parameter-3-89 =
     8030                                 "for each f-doc"
     8031         parameter-4-89 =
     8032           (
     8033             if (" false" + " " + where-phrase-89) <> ""
     8034             then " false" + " " + where-phrase-89
     8035             else "true"
     8036           )
     8037         parameter-5-89 = (" " + "" + " " + "")
     8038         parameter-6-89 = if sort-phrase-89 = ''
     8039                              then
     8040           (
     8041           " " + " " +
     8042           " " + " "
     8043           )
     8044                              else
     8045           (
     8046           " " + " " +
     8047           " " + sort-phrase-89
     8048           )
     8049         parameter-7-89 =
     8050           " indexed-reposition  "
     8051       .
     8052       do
     8053       on stop undo, leave
     8054       on error undo, leave
     8055       :
     8056         assign
     8057           l-disable-where-89 =
     8058             (" false" + " " + where-phrase-89 = "")
     8059         .
     8060         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     8061                             ,input query br-docs:handle
     8062                             ,input parameter-3-89
     8063                             ,input parameter-4-89
     8064                             ,input parameter-5-89
     8065                             ,input parameter-6-89
     8066                             ,input parameter-7-89
     8067                             )
     8068         .
     8069         assign
     8070           l-filter-open-89 = true
     8071         .
     8072       end.
     8073       if l-filter-open-89 = false then do:
     8074         message
     8075           "Ошибка при фильтрации / сортировке" skip
     8076           "Будут показаны записи без учета фильтра" skip
     8077           view-as alert-box .
     8078       end.
     8079       else do:
     8080           assign
     8081             v-query-was-opened = true
     8082           .
     8083       end.
     8084     end.
     8085     if l-filter-open-89 = false then do:
     8086       open query br-docs for each f-doc no-lock
     8087         where  false
     8088         indexed-reposition
     8089     .
     8090         assign
     8091           v-query-was-opened = true
     8092         .
     8093     end.
     8094     run waitfram-hide in this-procedure .
     8095   end.
     8096   END PROCEDURE.
     8097   PROCEDURE get-recid :
     8098   define input parameter p-query-string           as character        no-undo.
     8099   define input parameter p-num-rec                as integer          no-undo.
     8100   define input parameter p-field-name             as character        no-undo.
     8101   define input parameter p-field-value            as character        no-undo.
     8102   define output parameter p-reposition-recid      as recid            no-undo.
     8103       define variable v-query-handle          as handle       no-undo.
     8104       define variable v-buffer-handle         as handle       no-undo.
     8105       define variable v-query-string          as character    no-undo.
     8106       define variable v-by-position           as integer      no-undo.
     8107       define variable v-use-index-position    as integer      no-undo.
     8108       define variable v-by-string             as character    no-undo.
     8109       define variable v-sch-counter           as integer      no-undo.
     8110   do
     8111   on error undo, return error
     8112   :
     8113       assign
     8114           v-query-string = replace( p-query-string, "indexed-reposition", "" )
     8115       .
     8116       assign
     8117           v-use-index-position    = index( v-query-string, " use-index ":U )
     8118           v-by-position           = index( v-query-string, " by ":U )
     8119       .
     8120       assign
     8121           v-by-position = minimum( v-use-index-position, v-by-position )
     8122       .
     8123       if v-by-position > 0
     8124       then do:
     8125           assign
     8126               v-by-string     = substring( v-query-string, v-by-position )
     8127               v-query-string  = substring( v-query-string, 1, v-by-position - 1 )
     8128           .
     8129       end.
     8130       else do:
     8131           assign
     8132               v-by-string = "":U
     8133           .
     8134       end.
     8135       if p-field-name = "doc-code":U
     8136       then do:
     8137           assign
     8138               v-query-string = substitute( " &1 and f-doc.&2 begins '&3' &4"
     8139                                       , v-query-string
     8140                                       , p-field-name
     8141                                       , p-field-value
     8142                                       , v-by-string           )
     8143           .
     8144       end.
     8145       else do:
     8146           assign
     8147               v-query-string = substitute( " &1 and f-doc.&2 <= &3 &4 by f-doc.&2 descending"
     8148                                       , v-query-string
     8149                                       , p-field-name
     8150                                       , p-field-value
     8151                                       , v-by-string           )
     8152           .
     8153       end.
     8154       assign
     8155           v-query-string = replace( v-query-string , "f-doc":U, "buf_code_fbr-doc":U )
     8156       .
     8157       create buffer v-buffer-handle   for table "fbr-doc":U buffer-name "buf_code_fbr-doc":U .
     8158       create query v-query-handle .
     8159       v-query-handle :set-buffers( v-buffer-handle ).
     8160       v-query-handle :query-prepare( v-query-string ) .
     8161       v-query-handle :query-open().
     8162       v-query-handle :get-first().
     8163       if not v-query-handle :query-off-end
     8164       then do:
     8165           v-query-handle :get-first().
     8166           go-next-rec:
     8167           do v-sch-counter = 1 to p-num-rec
     8168           :
     8169               v-query-handle :get-next().
     8170               if v-query-handle :query-off-end
     8171               then do:
     8172                   assign
     8173                      sch-num = v-sch-counter
     8174                   .
     8175                   leave go-next-rec.
     8176               end.
     8177           end.
     8178           if not v-query-handle :query-off-end
     8179           then do:
     8180               assign
     8181                   p-reposition-recid = v-buffer-handle :recid
     8182               .
     8183           end.
     8184       end.
     8185       delete object v-query-handle.
     8186       delete object v-buffer-handle.
     8187   end.
     8188   END PROCEDURE.
