        1   define input parameter parparentproc    as widget-handle    no-undo.
        2   define input parameter p-status-available   as character        no-undo.
        3   define input parameter p-list-mode          as character        no-undo.
        4   define input-output    parameter p-rid-list as character         no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision$":U .
        6   define variable vss-author      as character no-undo initial "$Author$":U .
        7   define variable vss-date        as character no-undo initial "$Date$":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        9   define variable vss-archive     as character no-undo initial "$Archive$":U .
       10   define variable vss-description as character no-undo initial "Список документов производства":U .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define new global shared variable g#lib-trn  as handle no-undo .
       72   define new global shared variable g#lib-trn2 as handle no-undo .
       73   define new global shared variable g#lib-trn3 as handle no-undo .
       74   define new global shared variable g#lib-trn4 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301       def var log-file-name as char no-undo.
      302       if search('fbr.log') = ?
      303       then do:
      304           assign
      305               log-file-name = ""
      306           .
      307       end.
      308       else do:
      309           assign
      310               log-file-name = 'fbr.log'
      311           .
      312       end.
      313       DEF STREAM stm-log.
      314       PROCEDURE writelog:
      315       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      316       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      317       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      318       if p-file-name <> ""
      319       then do:
      320       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      321           PUT STREAM stm-log UNFORMATTED chr(10).
      322           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      323                                           OR p-log-string = "&Line") THEN "" ELSE
      324                                           cur-time-string-sec() + " ").
      325           PUT STREAM stm-log UNFORMATTED
      326                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      327                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      328                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      329       OUTPUT STREAM stm-log CLOSE.
      330       end.
      331       END PROCEDURE.
      332   define variable vss-include-info2 as character format "X(65)" no-undo
      333   initial "@(#)$Workfile$ $Revision$".
      334   define temp-table temp_fbrcode-doc-code no-undo
      335       field rec-type      as character
      336       field doc-code      as character
      337       field obj-type      as character
      338       field obj-code      as integer
      339       field cli-type      as character
      340       field cli-code      as integer
      341       field ext-doc-type  as character
      342       field doc-type      as character
      343       field order         as integer
      344       index pi is primary unique rec-type doc-code
      345       index od order
      346   .
      347   procedure fbrcode-gen-recipe-code :
      348   do
      349   on error undo, return error
      350   :
      351   define input parameter p-obj-type           as character    no-undo.
      352   define input parameter p-obj-code           as integer      no-undo.
      353   define output parameter p-recipe-code       as character    no-undo.
      354       assign
      355           p-recipe-code   = string( next-value( s-recipe, ub ) )
      356                               + "-"
      357                               + trim( string( p-obj-code, ">>>>9" ) )
      358                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      359       .
      360   end.
      361   end procedure.
      362   procedure fbrcode-is-from-object :
      363   do
      364   on error undo, return error
      365   :
      366   define input parameter p-doc-code           as character    no-undo.
      367   define input parameter p-obj-type           as character    no-undo.
      368   define input parameter p-obj-code           as integer      no-undo.
      369   define output parameter p-is-from-object    as logical      no-undo.
      370       if num-entries( p-doc-code, "-" ) < 2
      371       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      372                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      373       then do:
      374           assign
      375               p-is-from-object = no
      376           .
      377       end.
      378       else do:
      379           assign
      380               p-is-from-object = yes
      381           .
      382       end.
      383   end.
      384   end procedure.
      385   procedure fbrcode-trn-doc :
      386   do
      387   on error undo, return error
      388   :
      389       define input parameter p-out-doc-type       as character    no-undo.
      390       define input parameter p-out-code           as character    no-undo.
      391       define input parameter p-trn-doc-out-type   as character    no-undo.
      392       define output parameter p-trn-doc-doc-code  as character   no-undo.
      393       case p-out-doc-type:
      394           when 'производство':U
      395           then do:
      396               case p-trn-doc-out-type :
      397                   when 'рас':U
      398                   then do:
      399                       assign
      400                           p-trn-doc-doc-code = p-out-code
      401                       .
      402                   end.
      403                   when 'при':U
      404                   then do:
      405                       assign
      406                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      407                       .
      408                   end.
      409                   when 'спи':U
      410                   then do:
      411                       assign
      412                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      413                       .
      414                   end.
      415                   otherwise do:
      416                       assign
      417                           p-trn-doc-doc-code = ""
      418                       .
      419                       undo, return error "Не может быть обработан тип складского документа '"
      420                                           + p-trn-doc-out-type + "' во входных параметрах".
      421                   end.
      422               end case.
      423           end.
      424           otherwise do:
      425               assign
      426                   p-trn-doc-doc-code = ""
      427               .
      428               undo, return error "Не может быть обработан тип внешнего документа '"
      429                                   + p-out-doc-type + "' во входных параметрах".
      430           end.
      431       end case.
      432   end.
      433   end procedure.
      434   procedure fbrcode-fill-fbr-by-sale-or-pln :
      435   define input parameter p-main-doc-code      as character        no-undo.
      436       define variable v-order    as integer      no-undo.
      437       define buffer buf_fbr-doc               for ub.fbr-doc.
      438       define buffer buf_trn-doc               for ub.trn-doc.
      439       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      440   do
      441   for buf_fbr-doc
      442     , buf_trn-doc
      443     , buf_temp_fbrcode-doc-code
      444   on error undo, return error
      445   :
      446       for each buf_temp_fbrcode-doc-code
      447       on error undo, return error
      448       :
      449           delete buf_temp_fbrcode-doc-code.
      450       end.
      451       assign
      452           v-order = 0
      453       .
      454       for each buf_fbr-doc no-lock
      455          where buf_fbr-doc.out-code = p-main-doc-code
      456       on error undo, return error
      457       :
      458           create buf_temp_fbrcode-doc-code.
      459           assign
      460               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      461               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      462               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      463               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      464               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      465               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      466               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      467               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      468           .
      469           for each buf_trn-doc no-lock
      470              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      471           by buf_trn-doc.fact-order
      472           on error undo, return error
      473           :
      474               if buf_trn-doc.ext-doc-type = 'em':U
      475               or buf_trn-doc.ext-doc-type = 'im':U
      476               or buf_trn-doc.ext-doc-type = 'wm':U
      477               or buf_trn-doc.ext-doc-type = 'ev':U
      478               then do:
      479                   assign
      480                       v-order = v-order + 1
      481                   .
      482                   create buf_temp_fbrcode-doc-code.
      483                   assign
      484                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      485                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      486                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      487                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      488                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      489                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      490                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      491                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      492                       buf_temp_fbrcode-doc-code.order         = v-order
      493                   .
      494               end.
      495           end.
      496           assign
      497               v-order  = v-order + 1
      498           .
      499           find first buf_temp_fbrcode-doc-code
      500                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      501                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      502           .
      503           assign
      504               buf_temp_fbrcode-doc-code.order = v-order
      505           .
      506       end.
      507       for each buf_trn-doc no-lock
      508          where buf_trn-doc.out-code = p-main-doc-code
      509       by buf_trn-doc.fact-order
      510       on error undo, return error
      511       :
      512           assign
      513               v-order = v-order + 1
      514           .
      515           create buf_temp_fbrcode-doc-code.
      516           assign
      517               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      518               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      519               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      520               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      521               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      522               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      523               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      524               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      525               buf_temp_fbrcode-doc-code.order         = v-order
      526           .
      527       end.
      528   end.
      529   end procedure.
      530   procedure fbrcode-get-final-doc :
      531   define input parameter p-main-doc-code      as character        no-undo.
      532   define output parameter p-income-doc-code   as character        no-undo.
      533       define variable v-main-obj-type    as character    no-undo.
      534       define variable v-main-obj-code    as integer      no-undo.
      535       define buffer buf_trn-doc               for ub.trn-doc.
      536       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      537   do
      538   for buf_trn-doc
      539   on error undo, return error
      540   :
      541       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      542           input p-main-doc-code
      543       ).
      544       find first buf_trn-doc no-lock
      545            where buf_trn-doc.doc-code = p-main-doc-code
      546       .
      547       assign
      548           v-main-obj-type = buf_trn-doc.obj-type
      549           v-main-obj-code = buf_trn-doc.obj-code
      550       .
      551       find first buf_temp_fbrcode-doc-code
      552            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      553              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      554              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      555       no-error.
      556       if available buf_temp_fbrcode-doc-code
      557       then do:
      558           find first buf_trn-doc no-lock
      559                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      560                  and buf_trn-doc.ext-doc-type = 'iv':U
      561           .
      562           assign
      563               p-income-doc-code = buf_trn-doc.doc-code
      564           .
      565       end.
      566       else do:
      567           find first buf_temp_fbrcode-doc-code
      568                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      569                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      570                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      571           no-error.
      572           if available buf_temp_fbrcode-doc-code
      573           then do:
      574               assign
      575                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      576               .
      577           end.
      578           else do:
      579               assign
      580                   p-income-doc-code = "":U
      581               .
      582           end.
      583       end.
      584   end.
      585   end procedure.
