     3848   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3849     define variable v-cntxt-db-num        as integer   no-undo .
     3850     define variable v-cntxt-userid        as character no-undo .
     3851     define variable v-cntxt-level         as character no-undo .
     3852     define variable v-cntxt-host-code-obj as integer   no-undo .
     3853     define variable v-cntxt-obj-type      as character no-undo .
     3854     define variable v-cntxt-obj-code      as integer   no-undo .
     3855     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3856     define variable v-cntxt-is-admin      as logical   no-undo .
     3857   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3858   define variable v-waitfram-action01         as character   no-undo .
     3859   define variable v-waitfram-action02         as character   no-undo .
     3860   define variable v-waitfram-action03         as character   no-undo .
     3861   define variable mWaitFramTextBeg            as character   no-undo.
     3862   define variable mWaitFramTextEnd            as character   no-undo.
     3863   define variable mWaitFramView               as logical     no-undo.
     3864   define variable mWaitProcEvent              as logical     no-undo init yes.
     3865   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3866   define variable mWaitFramStop               as logical     no-undo.
     3867   define variable mWaitFramStopUser           as logical     no-undo.
     3868   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3869   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3870   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3871   define button B-WaitFramStop auto-end-key
     3872        label "Стоп"
     3873        size 10 by 1 tooltip "Остоновить процесс".
     3874   define button B-viewProcInfo
     3875        label "Информация"
     3876        size 15 by 1 tooltip "Информация о процесс".
     3877   define frame waitfram
     3878     v-waitfram-action01 format "x(72)" no-label skip
     3879     v-waitfram-action02 format "x(72)" no-label skip
     3880     v-waitfram-action03 format "x(72)" no-label skip
     3881     B-viewProcInfo
     3882     B-WaitFramStop at row 4 col 30
     3883     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3884     .
     3885   define new global shared variable mBatchMode as logical no-undo init ?.
     3886   define variable mFramBachModHandle as handle no-undo.
     3887   mFramBachModHandle = frame waitfram:handle.
     3888   define variable mFameOldVis as logical no-undo.
     3889   define variable mVisCUrentVin as logical no-undo.
     3890   if session:batch-mode
     3891   then
     3892      mBatchMode = yes.
     3893   if mBatchMode = ? then do:
     3894     mVisCUrentVin = current-window:visible.
     3895     mFameOldVis = mFramBachModHandle:visible.
     3896     mFramBachModHandle:visible  = yes.
     3897     mBatchMode = mFramBachModHandle:visible ne yes.
     3898     mFramBachModHandle:visible = mFameOldVis.
     3899     current-window:visible = mVisCUrentVin.
     3900   end.
     3901    if  log-manager:logfile-name ne ?
     3902     then DO:
     3903         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3904         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3905         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3906     end.
     3907   on choose of B-WaitFramStop in frame waitfram
     3908   do:
     3909     mWaitFramStop = yes.
     3910     mWaitFramStopUser = yes.
     3911   end.
     3912   function waitfram-check-timeout returns logical():
     3913      define variable vtime as int64 no-undo.
     3914      if mWaitFramStopTimeOut
     3915      then
     3916         return yes.
     3917      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3918      if     mWaitFramTimeOut ne ?
     3919         and mWaitFramTimeOut ne 0
     3920         and mWaitFramTimeOut lt vtime
     3921      then do:
     3922         mWaitFramStopTimeOut = yes.
     3923      end.
     3924      return mWaitFramStopTimeOut.
     3925   end.
     3926   procedure waitfram-hide :
     3927     if not session:batch-mode
     3928     then do
     3929     on error undo, return error return-value
     3930     :
     3931       pause 0 before-hide .
     3932       if not mBatchMode then
     3933         hide frame waitfram .
     3934     if     not mWaitFramView
     3935        and mWaitProcEvent
     3936     then
     3937       process events .
     3938     end.
     3939   end procedure.
     3940   procedure waitfram-show :
     3941     define input  parameter p-message as character no-undo .
     3942     define variable v-left-margin as integer   no-undo .
     3943     if not session:batch-mode
     3944     then do
     3945     on error undo, return error return-value
     3946     :
     3947       if length(p-message) <= 70 then do:
     3948         assign
     3949           v-left-margin = integer((70 - length(p-message)) / 2)
     3950         .
     3951         assign
     3952           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3953         .
     3954         assign
     3955           v-waitfram-action01 = " "
     3956           v-waitfram-action02 = " "
     3957                                    + fill(" ", v-left-margin)
     3958                                    + p-message
     3959           v-waitfram-action03 = " "
     3960         .
     3961       end.
     3962       else do:
     3963         define variable vRindex1 as integer no-undo.
     3964         define variable vRindex2 as integer no-undo.
     3965         vRindex1 = r-index(p-message," ",70).
     3966         if vRindex1 = 0
     3967         then
     3968            vRindex1 = 70.
     3969         if length(p-message)  <= vRindex1 + 70 then do:
     3970           assign
     3971             v-waitfram-action01 = " "
     3972             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3973             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3974           .
     3975         end.
     3976         else do:
     3977           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3978           if vRindex2 <= vRindex1
     3979           then
     3980              vRindex2 = vRindex1 + 70.
     3981           assign
     3982             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3983             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3984             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3985           .
     3986         end.
     3987       end.
     3988       B-viewProcInfo:visible   in frame waitfram = no.
     3989       B-viewProcInfo:sensitive in frame waitfram = no.
     3990       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3991       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3992       if  (   mWaitFramView
     3993          or  mWaitProcEvent)
     3994          and not mBatchMode
     3995       then
     3996          display
     3997             v-waitfram-action01 skip
     3998             v-waitfram-action02 skip
     3999             v-waitfram-action03 skip
     4000          with frame waitfram .
     4001       if     mWaitFramView
     4002          then do:
     4003             if     mWaitFramInterval ne ?
     4004                and not mBatchMode
     4005             then
     4006                wait-for go of frame waitfram pause mWaitFramInterval.
     4007          end.
     4008          else
     4009             if     mWaitProcEvent
     4010                and not mBatchMode
     4011             then
     4012                process events .
     4013     end.
     4014   end procedure.
     4015      procedure waitfram-show-this:
     4016         define input  parameter iInterval as int64 no-undo.
     4017         define variable vtime as int64 no-undo.
     4018         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     4019         mWaitFramInterval = iInterval.
     4020         run waitfram-show (substitute("&1&2 &3&4" ,
     4021                                       mWaitFramTextBeg ,
     4022                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     4023                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     4024                                       mWaitFramTextEnd
     4025                                      )
     4026                           ).
     4027      end.
     4028      procedure WaitFramRunPause:
     4029         define input  parameter iInterval as dec no-undo.
     4030         define variable vStart  as datetime-tz no-undo.
     4031         define variable vend    as datetime-tz no-undo.
     4032         define variable vint as int64 no-undo.
     4033         define variable vOk as logical no-undo.
     4034         vStart = now.
     4035         vend   = vStart.
     4036         publish "WaitFramPause" (iInterval,output vOk).
     4037         vend   =  now.
     4038         vint = vend - vStart.
     4039         vint = iInterval - vint / 1000.
     4040         if     not mWaitFramStop
     4041            and (   vint > 0
     4042                 or (    not vOk
     4043                     and iInterval eq ?
     4044                     )
     4045                 )
     4046         then
     4047            run waitfram-show-this (iInterval).
     4048         vend   =  now.
     4049         vint = vend - vStart.
     4050         vint = iInterval - vint / 1000.
     4051         if     not mWaitFramStop
     4052            and vint > 0
     4053         then do:
     4054            run gbl/pause.p (vint * 1000).
     4055         end.
     4056         if iInterval ne ?
     4057         then
     4058            publish "WaitFramStop".
     4059         waitfram-check-timeout().
     4060      end.
     4061      procedure WaitFramWaitFor:
     4062         define input  parameter iInterval as dec no-undo.
     4063         assign
     4064            mWaitFramStartProc   = now
     4065            mWaitFramStopUser    = no
     4066            mWaitFramStopTimeOut = no
     4067         .
     4068         block-wait:
     4069         do while not mWaitFramStop:
     4070            run WaitFramRunPause (iInterval).
     4071            if  waitfram-check-timeout()
     4072            then do:
     4073               leave block-wait.
     4074            end.
     4075         end.
     4076         run waitfram-hide.
     4077      end.
     4078   procedure waitfram-join :
     4079     define input  parameter p-line-1  as character no-undo .
     4080     define input  parameter p-line-2  as character no-undo .
     4081     define input  parameter p-line-3  as character no-undo .
     4082     define output parameter p-message as character no-undo .
     4083     do
     4084     on error undo, return error return-value
     4085     :
     4086       assign
     4087         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     4088                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     4089                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     4090       .
     4091     end.
     4092   end procedure.
     4093   function waitfram-join-function returns character
     4094     (input p-line-1 as character
     4095     ,input p-line-2 as character
     4096     ,input p-line-3 as character
     4097     ).
     4098     define variable v-message as character no-undo .
     4099     run waitfram-join in this-procedure
     4100       (input  p-line-1
     4101       ,input  p-line-2
     4102       ,input  p-line-3
     4103       ,output v-message
     4104       ) .
     4105     return v-message .
     4106   end function .
     4107   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4108   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     4109   procedure fltopend_fltopend :
     4110   define input parameter p-parent-handle as handle no-undo .
     4111   define input parameter p-qh as handle no-undo .
     4112   define input parameter p-flt-open-open-query  as character no-undo .
     4113   define input parameter p-where-cond as character no-undo .
     4114   define input parameter p-use-indFIRST-query-tail as character no-undo .
     4115   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     4116   define input parameter p-indexed-reposition as character no-undo .
     4117     do
     4118     on error undo, return error
     4119     :
     4120   define variable v-prepare-string as character no-undo .
     4121   define variable glog as logical no-undo .
     4122   assign
     4123   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     4124                      p-where-cond + chr(32)  +
     4125                      p-use-indFIRST-query-tail + chr(32) +
     4126                      p-use-ind-sort-clmn-by + chr(32) +
     4127                      p-indexed-reposition
     4128   .
     4129   assign
     4130   glog = p-qh:query-prepare(v-prepare-string) no-error .
     4131   if not glog
     4132   or error-status:error then do:
     4133     message error-status:get-message(1) view-as alert-box .
     4134     undo, return error .
     4135   end.
     4136   assign
     4137   glog = p-qh:query-open no-error .
     4138   if not glog
     4139   or error-status:error then do:
     4140     message error-status:get-message(1) view-as alert-box .
     4141     undo, return error .
     4142   end.
     4143     end.
     4144   end procedure.
     4145   procedure fltopend_fltfindd :
     4146   define input parameter p-parent-handle as handle no-undo .
     4147   define input parameter p-qh as handle no-undo .
     4148   define input parameter p-rowid as rowid no-undo .
     4149   define input parameter p-next as logical no-undo .
     4150   define input parameter p-lock as integer no-undo .
     4151   define input parameter p-bh as handle no-undo .
     4152   define input parameter p-where-cond as character no-undo .
     4153   define input parameter p-use-index-phrase as character no-undo .
     4154   define variable glog as logical no-undo .
     4155   define variable v-qh as handle no-undo .
     4156   define variable v-bh as handle no-undo .
     4157   define variable v-recid as recid no-undo .
     4158   define variable v-prepare-string as character no-undo .
     4159   do
     4160   on error undo, return error
     4161   on stop undo, return error
     4162   :
     4163     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     4164     create buffer v-bh for table p-bh buffer-name p-bh:name.
     4165     create query v-qh.
     4166     v-qh:set-buffers(v-bh).
     4167     v-prepare-string = substitute("for each &1 &2 &3"
     4168                                     ,v-bh:name
     4169                                     ,p-where-cond
     4170                                     ,p-use-index-phrase).
     4171     glog = v-qh:query-prepare(v-prepare-string) no-error.
     4172     if not glog then do:
     4173       delete object v-qh.
     4174       delete object v-bh.
     4175       undo, return error .
     4176     end.
     4177     glog = v-qh:query-open no-error .
     4178     if not glog then do:
     4179       delete object v-qh.
     4180       delete object v-bh.
     4181       undo, return error .
     4182     end.
     4183     if p-next then do:
     4184       v-qh:reposition-to-rowid(p-rowid) no-error .
     4185       glog = v-qh:get-next( p-lock) no-error .
     4186       glog = v-qh:get-next( p-lock) no-error .
     4187       if not glog or v-qh:query-off-end = yes then do:
     4188         glog = v-qh:get-first( p-lock) no-error .
     4189       end.
     4190     end.
     4191     else do:
     4192       glog = v-qh:get-first( p-lock) no-error .
     4193     end.
     4194     v-recid = v-bh:recid no-error .
     4195     delete object v-qh.
     4196     delete object v-bh.
     4197     return string(v-recid) .
     4198   end.
     4199   end procedure.
     4200   procedure fltopend_fltfindq :
     4201   define input parameter p-parent-handle as handle no-undo .
     4202   define input parameter p-qh as handle no-undo .
     4203   define input parameter p-next as logical no-undo .
     4204   define input parameter p-lock as integer no-undo .
     4205   define input parameter p-flt-open-open-query  as character no-undo .
     4206   define input parameter p-where-cond as character no-undo .
     4207   define input parameter p-use-indFIRST-query-tail as character no-undo .
     4208   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     4209   define input parameter p-indexed-reposition as character no-undo .
     4210   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     4211   define variable glog as logical no-undo .
     4212   define variable v-qh as handle no-undo .
     4213   define variable v-bh as handle no-undo extent 18.
     4214   define variable v-rowid as rowid no-undo extent 18.
     4215   define variable v-ii as integer no-undo .
     4216   define variable v-prepare-string as character no-undo .
     4217   do
     4218   on error undo, return error
     4219   on stop undo, return error
     4220   :
     4221     create query v-qh.
     4222     do v-ii = 1 to p-qh:num-buffers:
     4223       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     4224       assign
     4225       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     4226       no-error.
     4227       v-qh:add-buffer(v-bh[v-ii]).
     4228     end.
     4229     assign
     4230     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     4231                       p-where-cond + chr(32)  +
     4232                       p-use-indFIRST-query-tail + chr(32) +
     4233                       p-use-ind-sort-clmn-by + chr(32) +
     4234                       p-indexed-reposition
     4235     .
     4236     glog = v-qh:query-prepare( v-prepare-string) no-error .
     4237     if not glog then do:
     4238       delete object v-qh.
     4239       do v-ii = 1 to p-qh:num-buffers:
     4240         delete object v-bh[v-ii].
     4241       end.
     4242       undo, return error .
     4243     end.
     4244     glog = v-qh:query-open no-error .
     4245     if not glog then do:
     4246       delete object v-qh.
     4247       do v-ii = 1 to p-qh:num-buffers:
     4248         delete object v-bh[v-ii].
     4249       end.
     4250       undo, return error .
     4251     end.
     4252     if p-next then do:
     4253       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     4254       glog = v-qh:get-next( p-lock) no-error .
     4255       glog = v-qh:get-next( p-lock) no-error .
     4256       if not glog or v-qh:query-off-end = yes then do:
     4257         glog = v-qh:get-first( p-lock) no-error .
     4258       end.
     4259     end.
     4260     else do:
     4261       glog = v-qh:get-first( p-lock) no-error .
     4262     end.
     4263     do v-ii = 1 to p-qh:num-buffers:
     4264       assign
     4265       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     4266       no-error.
     4267     end.
     4268     delete object v-qh.
     4269     do v-ii = 1 to p-qh:num-buffers:
     4270       delete object v-bh[v-ii].
     4271     end.
     4272   end.
     4273   end procedure.
     4274   procedure proc-alt-shift-f2:
     4275     if not ibs.th.gbl.gbl-var:rcode
     4276   then
     4277     run gbl\inidebug.p .
     4278   end.
     4279   procedure proc-alt-shift-f3:
     4280     run gbl/prvssinf.p
     4281       ( input this-procedure
     4282       ) .
     4283   end.
     4284   define variable v-inform-launched as logical no-undo initial false .
     4285   procedure proc-alt-shift-f4:
     4286     define variable v-action as character no-undo .
     4287     if v-inform-launched = false then do:
     4288       assign
     4289         v-inform-launched = true
     4290       .
     4291       run gbl/d-inform.w
     4292         (  input self
     4293         ,  input this-procedure
     4294         , output v-action
     4295         ) no-error .
     4296       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     4297       assign
     4298         v-inform-launched = false
     4299       .
     4300     end.
     4301   end.
     4302   procedure proc-alt-f1:
     4303     run gbl/corrhelp.p
     4304       (input this-procedure
     4305       ) .
     4306   end .
     4307   on alt-shift-f2 anywhere do:
     4308     run proc-alt-shift-f2.
     4309   end.
     4310   on alt-shift-f3 anywhere do:
     4311     run proc-alt-shift-f3 in this-procedure .
     4312   end.
     4313   on alt-shift-f4 anywhere do:
     4314     run proc-alt-shift-f4 in this-procedure.
     4315   end.
     4316   on alt-f1 anywhere do:
     4317     run proc-alt-f1 in this-procedure .
     4318   end.
     4319   define variable v-fbr-log-file-name as character no-undo init 'fbr-rsrv-errors.txt'.
     4320   define variable v-fbr-tt-log-file-name as character no-undo init 'fbr-rsrv-errors-tt.txt'.
     4321   define temp-table tt-rsrv-err no-undo
     4322     field artic like ub.goods.artic
     4323     field gds-name like ub.goods.gds-name
     4324     field rsrv-qnty like ub.gds-obj.fact-qnty
     4325     field req-qnty like ub.gds-obj.fact-qnty
     4326   .
     4327   define stream stm.
     4328   os-delete value('fbr-rsrv-errors.txt') no-error.
     4329   os-delete value('fbr-rsrv-errors-tt.txt') no-error.
     4330   define variable doc-rec                 as recid        no-undo.
     4331   define variable v-yesno                 as logical      no-undo.
     4332   define variable gds-rec                 as recid        no-undo.
     4333   define variable v-fbr-docs-nik          as character    no-undo.
     4334   define variable v-fbr-docs-oper-nik     as character    no-undo.
     4335   define variable v-fbr-docs-where-cond   as character    no-undo.
     4336   define variable v-user-action           as character    no-undo .
     4337   define variable v-printed               as logical      no-undo .
     4338   define new shared variable br-handle as handle no-undo.
     4339   define new shared buffer f-doc for fbr-doc.
     4340   define buffer f-d-b for fbr-doc.
     4341   define variable sch-field as character no-undo.
     4342   define variable chg-qnty as dec no-undo.
     4343   define variable cost-base as dec no-undo.
     4344   define variable cost-rubl as dec no-undo.
     4345   DEFINE new shared QUERY br-docs FOR f-doc SCROLLING.
     4346   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4347   define variable c-point  as character no-undo .
     4348   define variable tbl      as character no-undo .
     4349   define variable join-tbl as character no-undo .
     4350   define variable fld      as character no-undo .
     4351   define variable lab      as character no-undo .
     4352   define variable spr      as character no-undo .
     4353   define variable dim      as character no-undo .
     4354   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4355   procedure fltfield-clear :
     4356     define output parameter loc-fld as character no-undo.
     4357     define output parameter loc-lab as character no-undo .
     4358     define output parameter loc-spr as character no-undo .
     4359     define output parameter loc-dim as character no-undo .
     4360     assign
     4361       loc-fld = ""
     4362       loc-lab = ""
     4363       loc-spr = ""
     4364       loc-dim = "0"
     4365     .
     4366   end procedure .
     4367   procedure fltfield-add :
     4368     define input        parameter par-fld as character no-undo.
     4369     define input        parameter par-lab as character no-undo .
     4370     define input        parameter par-spr as character no-undo .
     4371     define input-output parameter loc-fld as character no-undo.
     4372     define input-output parameter loc-lab as character no-undo .
     4373     define input-output parameter loc-spr as character no-undo .
     4374     define input-output parameter loc-dim as character no-undo .
     4375     do
     4376     on error undo, return error
     4377     :
     4378       assign
     4379       loc-fld = if loc-dim = '0'
     4380                 then par-fld
     4381                 else (loc-fld + chr(44) + par-fld)
     4382       loc-lab = if loc-dim = '0'
     4383                 then par-lab
     4384                 else (loc-lab + chr(44) + par-lab)
     4385       loc-spr = if loc-dim = '0'
     4386                 then par-spr
     4387                 else (loc-spr + chr(44) + par-spr)
     4388       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     4389                 string(integer(if num-entries(loc-dim) > 1
     4390                               then entry(2, loc-dim)
     4391                               else entry(1, loc-dim)
     4392                               ) + 1)
     4393       no-error
     4394       .
     4395     end.
     4396   end procedure.
     4397   define variable old-list        as character no-undo.
     4398   define variable old-stat        as character no-undo.
     4399   define variable flt-rec         as recid        no-undo.
     4400   define variable g#report-num    as integer      no-undo.
     4401   define variable g#quest-print   as logical      no-undo.
     4402   define variable g#log           as logical      no-undo.
