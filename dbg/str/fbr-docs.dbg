     5624   ON RETURN, MOUSE-SELECT-DBLCLICK, ctrl-j OF sch-code IN FRAME d-fbr-docs DO:
     5625       define variable v-reposition-recid      as recid        no-undo.
     5626       define variable v-prepare-string        as character    no-undo.
     5627       if sch-code <> input frame d-fbr-docs sch-code
     5628       or sch-field <> "doc-code"
     5629       then do:
     5630           assign
     5631               sch-num = 0
     5632           .
     5633           hide sch-num in frame d-fbr-docs.
     5634       end.
     5635       assign
     5636           sch-field   = "doc-code":U
     5637           sch-code    = input frame d-fbr-docs sch-code
     5638           sch-date    = ?
     5639           sch-fact    = ?
     5640       .
     5641       if browse br-docs :query :dynamic = yes
     5642       then do:
     5643           assign
     5644               v-prepare-string = browse br-docs :query :prepare-string
     5645           .
     5646       end.
     5647       else do:
     5648           assign
     5649               v-prepare-string = substitute( "for each f-doc where &1 ", v-fbr-docs-where-cond )
     5650           .
     5651       end.
     5652       if sch-code <> ?
     5653       and trim( sch-code ) <> "":U
     5654       then do:
     5655           run get-recid in this-procedure (
     5656                 input v-prepare-string
     5657               , input sch-num
     5658               , input "doc-code":U
     5659               , input trim( sch-code )
     5660               , output v-reposition-recid
     5661           ) no-error.
     5662           if not error-status :error
     5663           and v-reposition-recid <> ?
     5664           and v-reposition-recid <> 0
     5665           then do:
     5666               assign
     5667                   sch-num = sch-num + 1
     5668                   doc-rec = v-reposition-recid
     5669               .
     5670               reposition br-docs to recid v-reposition-recid no-error.
     5671               display
     5672                   sch-num
     5673                   sch-date
     5674                   sch-fact
     5675               with frame d-fbr-docs .
     5676           end.
     5677       end.
     5678   END.
