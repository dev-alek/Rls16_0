     6585           then do:
     6586             assign
     6587               v-object-handle :col = v-object-handle :col + p-change-value
     6588               no-error .
     6589             if error-status :error
     6590             or error-status :get-message(1) <> ""
     6591             then do:
     6592               undo move_block, retry move_block .
     6593             end.
     6594           end.
     6595         end.
     6596       end.
     6597       else do:
     6598         for each buf_temp-diasize-handle
     6599         on error undo move_block, retry move_block
     6600         :
     6601           assign
     6602             v-object-handle = buf_temp-diasize-handle.handle-value
     6603           .
     6604           if v-object-handle <> v-diasize-resize-button
     6605           then do:
     6606             assign
     6607               v-object-handle :col = v-object-handle :col + p-change-value
     6608               no-error .
     6609             if error-status :error
     6610             or error-status :get-message(1) <> ""
     6611             then do:
     6612               undo move_block, retry move_block .
     6613             end.
     6614           end.
     6615         end.
     6616         for each buf_temp-browse-handle
     6617           where buf_temp-browse-handle.browse-type = 'width':u
     6618         on error undo move_block, retry move_block
     6619         :
     6620           assign
     6621             buf_temp-browse-handle.browse-handle :width
     6622               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6623             no-error .
     6624           if error-status :error
     6625           or error-status :get-message(1) <> ""
     6626           then do:
     6627             undo move_block, retry move_block .
     6628           end.
     6629         end.
     6630         assign
     6631           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6632           no-error .
     6633         if error-status :error
     6634         or error-status :get-message(1) <> ""
     6635         then do:
