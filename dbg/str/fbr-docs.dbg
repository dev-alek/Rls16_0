     6560         or error-status :get-message(1) <> ""
     6561         then do:
     6562           undo move_block, retry move_block.
     6563         end.
     6564         for each buf_temp-browse-handle
     6565           where buf_temp-browse-handle.browse-type = 'width':u
     6566         on error undo move_block, retry move_block
     6567         :
     6568           assign
     6569             buf_temp-browse-handle.browse-handle :width
     6570               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6571             no-error .
     6572           if error-status :error
     6573           or error-status :get-message(1) <> ""
     6574           then do:
