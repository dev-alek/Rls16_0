     6171           no-error .
     6172         if error-status :error
     6173         or error-status :get-message(1) <> ""
     6174         then do:
     6175           undo move_block, retry move_block .
     6176         end.
     6177         for each buf_temp-browse-handle
     6178           where buf_temp-browse-handle.browse-type = 'height':u
     6179         on error undo move_block, retry move_block
     6180         :
     6181           assign
     6182             buf_temp-browse-handle.browse-handle :height
     6183               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6184             no-error .
     6185           if error-status :error
     6186           or error-status :get-message(1) <> ""
     6187           then do:
     6188             undo move_block, retry move_block .
     6189           end.
     6190         end.
