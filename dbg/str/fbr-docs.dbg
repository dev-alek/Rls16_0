     6271       if p-move-resize = true
     6272       then do:
     6273         run diasize_position-resize-button in this-procedure .
     6274       end.
     6275       if v-diasize-wndstore = true
     6276       then do:
     6277         if connected("ub") = true
     6278         then do:
     6279           define variable v-cntxt-db-num        as integer   no-undo .
     6280           define variable v-cntxt-userid        as character no-undo .
