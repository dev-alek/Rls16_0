      663       create buf_temp_fbr-history.
      664       assign
      665           buf_temp_fbr-history.obj-type                = p-obj-type
      666           buf_temp_fbr-history.obj-code                = p-obj-code
      667           buf_temp_fbr-history.hst-code                = next-value( s-fbr-num, ub)
