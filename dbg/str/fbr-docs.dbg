      608   define input parameter p-doc-type               as character        no-undo.
      609   define input parameter p-status_                as character        no-undo.
      610   define input parameter p-is-free                as logical          no-undo.
      611   define input parameter p-recipe-code            as character        no-undo.
      612   define input parameter p-recipe-type            as character        no-undo.
      613   define input parameter p-gds-code               as integer          no-undo.
      614   define input parameter p-trn-type               as character        no-undo.
      615   define input parameter p-qnty                   as decimal          no-undo.
