      617   define input parameter p-is-error               as logical          no-undo.
      618       define variable v-today                         as date         no-undo.
      619       define variable v-obj-date                      as date         no-undo.
      620       define variable v-time                          as integer      no-undo.
      621       define variable v-host-code                     as integer      no-undo.
      622       define variable v-db-num                        as integer      no-undo.
      623       define buffer buf_temp_fbr-history       for temp_fbr-history.
      624       define buffer buf_upper_temp_fbr-history for temp_fbr-history.
      625   do
      626   for buf_temp_fbr-history
      627     , buf_upper_temp_fbr-history
      628   on error undo, return error
      629   :
      630       if v-fbrhist-history-level = 0
      631       or v-fbrhist-history-level < p-hst-level
      632       then do:
      633           undo, return .
      634       end.
      635       if v-fbrhist-upper-code <> 0
      636       then do:
      637           find first buf_upper_temp_fbr-history no-lock
      638                where buf_upper_temp_fbr-history.obj-type = v-fbrhist-upper-obj-type
      639                  and buf_upper_temp_fbr-history.obj-code = v-fbrhist-upper-obj-code
      640                  and buf_upper_temp_fbr-history.hst-code = v-fbrhist-upper-code
      641           no-error.
      642       end.
