     6533         v-diasize-resize-button :column = 1.
     6534       end.
     6535       if p-change-value > 0
     6536       then do:
     6537         if frame d-fbr-docs :scrollable = true
     6538         then do:
     6539           assign
     6540             frame d-fbr-docs :virtual-width = frame d-fbr-docs :virtual-width + p-change-value
     6541             no-error .
     6542           if error-status :error
     6543           or error-status :get-message(1) <> ""
     6544           then do:
     6545             undo move_block, retry move_block.
     6546           end.
     6547         end.
     6548         assign
     6549           frame d-fbr-docs :width = v-frame-width + p-change-value
     6550           no-error .
     6551         if error-status :error
     6552         or error-status :get-message(1) <> ""
     6553         then do:
     6554           undo move_block, retry move_block.
     6555         end.
     6556         assign
     6557           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6558         no-error .
