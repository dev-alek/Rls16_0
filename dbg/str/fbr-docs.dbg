     4411        size 10.00 by 1.00 TOOLTIP "Коррекция текущего документа".
     4412   DEFINE BUTTON b-close
     4413        LABEL "&Закрыть"
     4414        size 10.00 by 1.00 TOOLTIP "Установка следующего статуса для текущего документа".
     4415   DEFINE BUTTON b-open
     4416        LABEL "&Открыть"
     4417        size 10.00 by 1.00 TOOLTIP "Установка предыдущего статуса для текущего документа".
     4418   DEFINE BUTTON b-del
     4419        LABEL "&Удалить"
     4420        size 10.00 by 1.00 TOOLTIP "Удаление текущего документа".
     4421   DEFINE BUTTON b-quit AUTO-GO
     4422        LABEL "&Выход "
     4423        size 10.00 by 1.00 TOOLTIP "Выход из списка документов".
     4424   DEFINE BUTTON b-help
     4425        LABEL "Помо&щь"
     4426        size 10.00 by 1.00 TOOLTIP "Помощь".
     4427   DEFINE BUTTON b-hist
