     6684   end procedure.
     6685   procedure diasize_set-width :
     6686     define input  parameter p-new-width  as decimal   no-undo .
     6687     define input  parameter p-move-resize as logical   no-undo .
     6688     do
     6689     on error undo, return error return-value
     6690     :
     6691       run diasize_change-width in this-procedure
     6692         (input  (p-new-width - frame d-fbr-docs :width)
     6693         ,input  p-move-resize
     6694         ) .
     6695     end.
     6696   end procedure.
     6697   procedure diasize_position-resize-button :
     6698     do with frame d-fbr-docs
     6699     :
     6700       hide v-diasize-resize-button .
     6701       assign
     6702         v-diasize-resize-button :row = frame d-fbr-docs :height - v-diasize-resize-button :height
     6703                     - 1
     6704                     - (frame d-fbr-docs :border-bottom-pixels / session :pixels-per-row)
     6705         v-diasize-resize-button :col = frame d-fbr-docs :width - v-diasize-resize-button :width
     6706                     - 1
     6707                     - (frame d-fbr-docs :border-right-pixels / session :pixels-per-column)
     6708       .
     6709       view v-diasize-resize-button .
     6710     end.
     6711   end procedure.
     6712   on alt-right anywhere
     6713   do:
     6714     run diasize_change-width in this-procedure
     6715       (input 1
     6716       ,input true
     6717       ) .
     6718     return no-apply .
     6719   end.
     6720   on alt-left anywhere
     6721   do:
     6722     run diasize_change-width in this-procedure
     6723       (input -1
     6724       ,input true
     6725       ) .
     6726     return no-apply .
     6727   end.
     6728   on alt-down anywhere
     6729   do:
     6730     run diasize_change-height in this-procedure
     6731       (input 1
     6732       ,input true
     6733       ) .
     6734     return no-apply .
     6735   end.
     6736   on alt-up anywhere
     6737   do:
     6738     run diasize_change-height in this-procedure
     6739       (input -1
     6740       ,input true
     6741       ) .
     6742     return no-apply .
     6743   end.
     6744   on alt-enter of frame d-fbr-docs
     6745   do:
     6746     run diasize_maximize in this-procedure
     6747       (input  ?
     6748       ).
     6749     return no-apply .
     6750   end.
     6751   procedure diasize_end-move :
     6752     do
     6753     on error undo, return error return-value
     6754     :
     6755       define variable v-row-delta as decimal   no-undo .
     6756       define variable v-col-delta as decimal   no-undo .
     6757       define variable v-new-row as decimal   no-undo .
     6758       define variable v-new-col as decimal   no-undo .
     6759       assign
     6760         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6761         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6762       .
     6763       assign
     6764         v-row-delta = v-new-row - frame d-fbr-docs :height
     6765         v-col-delta = v-new-col - frame d-fbr-docs :width
     6766       .
     6767       run diasize_change-height in this-procedure
     6768         (input v-row-delta
     6769         ,input true
     6770         ) .
     6771       run diasize_change-width in this-procedure
     6772         (input v-col-delta
     6773         ,input true
     6774         ) .
     6775     end.
     6776   end procedure.
     6777   procedure diasize_maximize :
     6778     define input  parameter p-action as logical   no-undo .
     6779     do
     6780     on error undo, return error return-value
     6781     :
     6782       if p-action = ?
     6783       then do:
     6784         if v-diasize-need-maximize = true
     6785         then do:
     6786           assign
     6787             p-action = true
     6788           .
     6789         end.
     6790         else do:
     6791           assign
     6792             p-action = false
     6793           .
     6794         end.
     6795       end.
     6796       if p-action = true
     6797       then do:
     6798         run diasize_change-height in this-procedure
     6799           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6800               - frame d-fbr-docs :height-chars
     6801           ,input true
     6802           ) .
     6803         run diasize_change-width in this-procedure
     6804           (input session :width-chars
     6805               - frame d-fbr-docs :width-chars
     6806           ,input true
     6807           ) .
     6808         assign
     6809           v-diasize-need-maximize = false
     6810         .
     6811       end.
     6812       else do:
     6813         run diasize_change-width in this-procedure
     6814           (input v-diasize-orig-frame-width
     6815               - frame d-fbr-docs :width-chars
     6816           ,input true
     6817           ) .
     6818         run diasize_change-height in this-procedure
     6819           (input v-diasize-orig-frame-height
     6820               - frame d-fbr-docs :height-chars
     6821           ,input true
     6822           ) .
     6823         assign
     6824           v-diasize-need-maximize = true
     6825         .
     6826       end.
     6827     end.
     6828   end procedure.
     6829   procedure diasize_restore-orig-size :
     6830     do
     6831     on error undo, return error return-value
     6832     :
     6833       assign
     6834         v-diasize-current-frame-width  = frame d-fbr-docs :width
     6835         v-diasize-current-frame-height = frame d-fbr-docs :height
     6836       .
     6837       run diasize_set-height in this-procedure
     6838         (input  v-diasize-orig-frame-height
     6839         ,input  true
     6840         ) .
     6841       run diasize_set-width in this-procedure
     6842         (input  v-diasize-orig-frame-width
     6843         ,input  true
     6844         ) .
     6845     end.
     6846   end procedure.
     6847   procedure diasize_restore-current-size :
     6848     do
     6849     on error undo, return error return-value
     6850     :
     6851       run diasize_set-height in this-procedure
     6852         (input  v-diasize-current-frame-height
     6853         ,input  true
     6854         ) .
     6855       run diasize_set-width in this-procedure
     6856         (input  v-diasize-current-frame-width
     6857         ,input  true
     6858         ) .
     6859     end.
     6860   end procedure.
     6861   procedure diasize_set-browse-handle :
     6862     define input  parameter p-browse-handle as handle   no-undo .
     6863     define buffer buf_temp-browse-handle for temp-browse-handle .
     6864     do
     6865     on error undo, return error return-value
     6866     :
     6867       assign
     6868         v-diasize-browse-handle = p-browse-handle
     6869       .
     6870       for each buf_temp-browse-handle
     6871       on error undo, return error return-value
     6872       :
     6873         delete buf_temp-browse-handle .
     6874       end.
     6875     end.
     6876   end procedure.
     6877   procedure diasize_add_browse :
     6878     define input  parameter p-browse-type   as character no-undo .
     6879     define input  parameter p-browse-handle as handle    no-undo .
     6880     define buffer buf_temp-browse-handle for temp-browse-handle .
     6881     do
     6882     on error undo, return error return-value
     6883     :
     6884       assign
     6885         v-diasize-browse-number = v-diasize-browse-number + 1
     6886       .
     6887       create buf_temp-browse-handle .
     6888       assign
     6889         buf_temp-browse-handle.browse-type   = p-browse-type
     6890         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6891         buf_temp-browse-handle.browse-handle = p-browse-handle
     6892       .
     6893     end.
     6894   end procedure.
     6895   procedure diasize_init :
     6896     define variable v-default-value    as logical   no-undo .
     6897     define variable v-restore-saved    as logical   no-undo .
     6898     define variable v-resize-value-str as character no-undo .
     6899     do
     6900     on error undo, return error return-value
     6901     :
     6902       do with frame d-fbr-docs
     6903       :
     6904         assign
     6905           v-diasize-orig-frame-height = frame d-fbr-docs :height
     6906           v-diasize-orig-frame-width  = frame d-fbr-docs :width
     6907           v-diasize-browse-handle     = browse br-docs :handle
     6908         .
     6909         create button v-diasize-resize-button
     6910         assign
     6911           parent        = frame d-fbr-docs :first-child
     6912           label         = "s"
     6913           height-pixels = 16
     6914           width-pixels  = 16
     6915           visible       = true
     6916           sensitive     = true
     6917           movable       = true
     6918           triggers:
     6919             on end-move persistent run diasize_end-move in this-procedure .
     6920           end triggers.
     6921         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6922         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6923         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6924         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6925         assign
     6926           v-diasize-wndmax = false
     6927         .
     6928         if connected("ub") = true
     6929         then do:
     6930           define variable v-cntxt-db-num        as integer   no-undo .
     6931           define variable v-cntxt-userid        as character no-undo .
     6932           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6933                                             , OUTPUT v-cntxt-userid
     6934                                             ) .
     6935           run gbl/wndpar_r.p
     6936             (input  v-cntxt-db-num
     6937             ,input  v-cntxt-userid
     6938             ,input  'wndmax':U
     6939             ,output v-diasize-wndmax
     6940             ,output v-default-value
     6941             ) .
     6942         end.
     6943         assign
     6944           v-diasize-wndstore = false
     6945         .
     6946         if connected("ub") = true
     6947         then do:
     6948           run gbl/wndpar_r.p
     6949             (input  v-cntxt-db-num
     6950             ,input  v-cntxt-userid
     6951             ,input  'wndstore':U
     6952             ,output v-diasize-wndstore
     6953             ,output v-default-value
     6954             ) .
     6955         end.
     6956         assign
     6957           v-diasize-proc-name = entry(1, program-name(2), '.')
     6958         .
     6959         if v-diasize-wndstore = true
     6960         then do:
     6961           assign
     6962             v-restore-saved = false
     6963           .
     6964           if connected("ub") = true
     6965           then do:
     6966             run gbl/wndsizer.p
     6967               (input  v-cntxt-db-num
     6968               ,input  v-cntxt-userid
     6969               ,input  v-diasize-proc-name
     6970               ,input  'height':u
     6971               ,output v-resize-value-str
     6972               ) .
     6973             if v-resize-value-str <> '':U
     6974             then do:
     6975               run diasize_change-height in this-procedure
     6976                 (input  integer(v-resize-value-str)
     6977                 ,input  true
     6978                 ) .
     6979               assign
     6980                 v-restore-saved = true
     6981               .
     6982             end.
     6983           end.
     6984           if connected("ub") = true
     6985           then do:
     6986             run gbl/wndsizer.p
     6987               (input  v-cntxt-db-num
     6988               ,input  v-cntxt-userid
     6989               ,input  v-diasize-proc-name
     6990               ,input  'width':u
     6991               ,output v-resize-value-str
     6992               ) .
     6993             if v-resize-value-str <> '':U
     6994             then do:
     6995               run diasize_change-width in this-procedure
     6996                 (input  integer(v-resize-value-str)
     6997                 ,input  true
     6998                 ) .
     6999               assign
     7000                 v-restore-saved = true
     7001               .
     7002             end.
     7003           end.
     7004           if v-restore-saved <> true
     7005           then do:
     7006             if v-diasize-wndmax = true
     7007             then do:
     7008               run diasize_maximize in this-procedure
     7009                 (input  true
     7010                 ) .
     7011             end.
     7012           end.
     7013         end.
     7014         else do:
     7015           if v-diasize-wndmax = true
     7016           then do:
     7017             run diasize_maximize in this-procedure
     7018               (input  true
     7019               ) .
     7020           end.
     7021         end.
     7022       end.
     7023     end.
     7024   end procedure.
     7025   procedure diasize_need-full-display :
     7026     define output parameter p-need-full-display as logical   no-undo .
     7027     do
     7028     on error undo, return error return-value
     7029     :
     7030       assign
     7031         p-need-full-display = v-diasize-need-full-display
     7032       .
     7033       assign
     7034         v-diasize-need-full-display = false
     7035       .
     7036     end.
     7037   end procedure.
     7038   procedure get-context :
     7039      define output parameter p-db-num as integer          no-undo.
     7040      define output parameter p-user-id as character        no-undo.
     7041      define variable v-login               as character    no-undo.
     7042      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7043      define buffer buf_user-login  for ub.user-login .
     7044      do
     7045      on error undo, return error
     7046      :
     7047            FIND FIRST buf_sys-ctrl no-lock.
     7048            ASSIGN
     7049               v-login = USERID("ub")
     7050               p-db-num = buf_sys-ctrl.db-num
     7051            .
     7052            FIND FIRST buf_user-login
     7053                 WHERE buf_user-login.db-num = p-db-num
     7054                   AND buf_user-login.user-login = v-login
     7055                 no-lock
     7056                 no-error
     7057                 .
     7058            IF AVAILABLE buf_user-login
     7059            THEN DO:
     7060               assign
     7061                  p-user-id = buf_user-login.user-id
     7062               .
     7063            END.
     7064      end.
     7065   end procedure.
     7066       run diasize_init in this-procedure .
     7067   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7068   procedure set-filter-name :
     7069   define input parameter p-filter-name as character no-undo .
     7070     do with frame d-fbr-docs:
     7071       if p-filter-name > "" then do:
     7072         assign
     7073           frame d-fbr-docs:title
     7074             = frame d-fbr-docs:title + "   ФИЛЬТР: " + p-filter-name.
     7075         .
     7076         assign
     7077           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     7078         .
     7079       end.
     7080       else do:
     7081         assign
     7082           b-sch :tooltip = ""
     7083         .
     7084       end.
     7085     end.
     7086   end procedure.
     7087   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7088   on f5 of frame d-fbr-docs anywhere
     7089   do:
     7090     if available f-doc then doc-rec = recid(f-doc). run UI-on in this-procedure ( input yes ) .
     7091   end.
     7092   cStsMark = ObjSrv:Env:Marking:Sts:Mark.
     7093   MAIN-BLOCK:
     7094   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7095      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     7096   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7097     run mainmenu_getcntxt in parparentproc
     7098       (output v-cntxt-db-num
     7099       ,output v-cntxt-userid
     7100       ,output v-cntxt-level
     7101       ,output v-cntxt-host-code-obj
     7102       ,output v-cntxt-obj-type
     7103       ,output v-cntxt-obj-code
     7104       ,output v-cntxt-db-num-obj
     7105       ,output v-cntxt-is-admin
     7106       ) .
     7107       run get-report-num in parparentproc (
     7108           output g#report-num
     7109       ).
     7110       run get-quest-print in parparentproc (
     7111           output g#quest-print
     7112       ).
     7113   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     7115     (input  v-cntxt-obj-type
     7116     ,input  v-cntxt-obj-code
     7117     ,output v-host-code
     7118     ,output v-host-name
     7119     )  .
     7120       if p-rid-list <> '':U then do:
     7121         assign
     7122         doc-rec = integer(entry(1, p-rid-list)).
     7123       end.
     7124       enable
     7125           b-quit
     7126           b-lkp
     7127           b-print
     7128           b-sch
     7129           b-help
     7130           b-hist
     7131           br-docs
     7132           sch-code
     7133           sch-date
     7134           sch-fact
     7135           ed-notes
     7136           b-sel
     7137           b-gds
     7138       with frame d-fbr-docs.
     7139     run UI-on in this-procedure ( input yes ).
     7140     if not( v-cntxt-db-num-obj = v-cntxt-db-num )
     7141       and ( v-cntxt-db-num-obj <> 0 )
     7142       then do:
     7143           disable
     7144               b-add
     7145               b-del
     7146               b-chg
     7147               b-open
     7148               b-close
     7149               b-sel
     7150               with frame d-fbr-docs.
     7151       end.
     7152     WAIT-FOR GO OF FRAME d-fbr-docs focus br-docs.
     7153   END.
     7154   RUN disable_UI.
     7155   PROCEDURE disable_UI :
     7156     HIDE FRAME d-fbr-docs.
     7157   END PROCEDURE.
     7158   PROCEDURE UI-on :
     7159   define input  parameter p-open-query     as logical   no-undo .
     7160   if p-open-query = yes
     7161   then do:
     7162       frame d-fbr-docs:title = "ВСЕ  АКТЫ ПРОИЗВОДСТВА".
     7163       assign
     7164           sch-num = 0
     7165       .
     7166       hide sch-num in frame d-fbr-docs.
     7167   end.
     7168   else do:
     7169       assign
     7170           doc-rec = ?
     7171       .
     7172   end.
     7173   define variable v-query-was-opened as logical no-undo .
     7174   assign
     7175     v-query-was-opened = false
     7176   .
     7177   case p-list-mode
     7178   :
     7179       when 'работа':U
     7180       then do:
     7181           if p-open-query = yes
     7182           then do:
     7183               assign
     7184                   v-fbr-docs-where-cond = " true ":U
     7185               .
     7186               assign
     7187                   c-point = "пр-во " + p-list-mode
     7188               .
     7189   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7190   define variable  l-disable-where-77  as logical   no-undo .
     7191   define variable  l-filter-open-77    as logical   .
     7192   define variable  flt-rec-77       as recid     no-undo .
     7193   define variable  filter-name-77      as character no-undo .
     7194   define variable  where-phrase-77     as character no-undo .
     7195   define variable  sort-phrase-77      as character no-undo .
     7196   define variable  where-phrase-rus-77 as character no-undo .
     7197   define variable  sort-phrase-rus-77  as character no-undo .
     7198     run waitfram-show in this-procedure
     7199       (input "ЖДИТЕ ..."
     7200       ).
     7201   run gbl/flt-get.p
     7202     (input c-point
     7203     ,output flt-rec-77
     7204     ,output filter-name-77
     7205     ,output where-phrase-77
     7206     ,output sort-phrase-77
     7207     ,output where-phrase-rus-77
     7208     ,output sort-phrase-rus-77
     7209     ).
     7210       run set-filter-name in this-procedure
     7211         (INPUT filter-name-77
     7212         ) no-error .
     7213     assign
     7214       l-filter-open-77 = false
     7215     .
     7216     if flt-rec-77 <> ?
     7217     then do:
     7218       define variable  parameter-2-77 as character no-undo .
     7219       define variable  parameter-3-77 as character no-undo .
     7220       define variable  parameter-4-77 as character no-undo .
     7221       define variable  parameter-5-77 as character no-undo .
     7222       define variable  parameter-6-77 as character no-undo .
     7223       define variable  parameter-7-77 as character no-undo .
     7224         assign
     7225         parameter-3-77 =
     7226                                 "for each f-doc"
     7227         parameter-4-77 =
     7228           (
     7229             if (" true" + " " + where-phrase-77) <> ""
     7230             then " true" + " " + where-phrase-77
     7231             else "true"
     7232           )
     7233         parameter-5-77 = (" " + "" + " " + "")
     7234         parameter-6-77 = if sort-phrase-77 = ''
     7235                              then
     7236           (
     7237           " " + " " +
     7238           " " + " "
     7239           )
     7240                              else
     7241           (
     7242           " " + " " +
     7243           " " + sort-phrase-77
     7244           )
     7245         parameter-7-77 =
     7246           " indexed-reposition  "
     7247       .
     7248       do
     7249       on stop undo, leave
     7250       on error undo, leave
     7251       :
     7252         assign
     7253           l-disable-where-77 =
     7254             (" true" + " " + where-phrase-77 = "")
     7255         .
     7256         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7257                             ,input query br-docs:handle
     7258                             ,input parameter-3-77
     7259                             ,input parameter-4-77
     7260                             ,input parameter-5-77
     7261                             ,input parameter-6-77
     7262                             ,input parameter-7-77
     7263                             )
     7264         .
     7265         assign
     7266           l-filter-open-77 = true
     7267         .
     7268       end.
     7269       if l-filter-open-77 = false then do:
     7270         message
     7271           "Ошибка при фильтрации / сортировке" skip
     7272           "Будут показаны записи без учета фильтра" skip
     7273           view-as alert-box .
     7274       end.
     7275       else do:
     7276           assign
     7277             v-query-was-opened = true
     7278           .
     7279       end.
     7280     end.
     7281     if l-filter-open-77 = false then do:
     7282       open query br-docs for each f-doc no-lock
     7283         where  true
     7284         indexed-reposition
     7285     .
     7286         assign
     7287           v-query-was-opened = true
     7288         .
     7289     end.
     7290     run waitfram-hide in this-procedure .
     7291           end.
     7292       end.
     7293       when 'фирма':U
     7294       then do:
     7295           if p-open-query = yes
     7296           then do:
     7297               frame d-fbr-docs :title = substitute( "Документы производства. Фирма : &1", v-host-name ).
     7298               assign
     7299                   v-fbr-docs-where-cond = substitute(' f-doc.host-code = &1', v-cntxt-host-code-obj )
     7300               .
     7301               assign
     7302                   c-point = "пр-во " + 'работа':U
