     4429        size 10.00 by 1.00 TOOLTIP "История действий пользователей для документа".
     4430   DEFINE BUTTON b-lkp
     4431        LABEL "&Просмотр"
     4432        size 10.00 by 1.00 TOOLTIP "Просмотр текущего документа".
     4433   DEFINE BUTTON b-print
     4434        LABEL "Пе&чать"
     4435        size 10.00 by 1.00 TOOLTIP "Печать текущего документа".
     4436   DEFINE BUTTON b-sch
     4437        LABEL "&Фильтр"
     4438        size 10.00 by 1.00 TOOLTIP "Работа со списком фильтров, установка или отмена фильтра в списке документов".
     4439   DEFINE BUTTON b-sel
     4440        LABEL "Вы&бор "
     4441        size 10.00 by 1.00 TOOLTIP "Выбор (запоминание) текущего документа".
     4442   DEFINE BUTTON b-gds
     4443        LABEL "Товар&ы "
     4444        size 10.00 by 1.00 TOOLTIP "Просмотр документа производства по товарам".
     4445   DEFINE VARIABLE ed-notes AS CHARACTER
     4446        VIEW-AS EDITOR
     4447        size 96.5 by 1.58 TOOLTIP "Примечание текущего документа, при редактировании удалите @"
     4448        NO-UNDO.
     4449   DEFINE NEW SHARED VARIABLE sch-code AS CHARACTER FORMAT "X(12)":U INITIAL ?
     4450        LABEL "&Начало номера"
     4451        VIEW-AS FILL-IN
     4452        size 15 by 1 TOOLTIP "Поиск по началу номера документа"
     4453        NO-UNDO.
     4454   DEFINE NEW SHARED VARIABLE sch-date AS DATE FORMAT "99/99/99":U
     4455        LABEL "Д&ата"
     4456        VIEW-AS FILL-IN
     4457        size 9.38 by 1 TOOLTIP "Поиск по дате документа"
     4458        NO-UNDO.
     4459   DEFINE NEW SHARED VARIABLE sch-fact AS DATE FORMAT "99/99/99":U
     4460        LABEL "Фа&кт"
