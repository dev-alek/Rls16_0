     5804   run minbtn-set in this-procedure .
     5805   on choose of b-help in frame d-fbr-docs
     5806   do:
     5807     apply "help":u to frame d-fbr-docs .
     5808   end.
     5809   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5810   procedure minbtn-set :
     5811       do
     5812           on error undo, return error return-value
     5813           :
     5814           define variable ii              as integer       no-undo .
     5815           define variable fh              as widget-handle no-undo .
     5816           define variable hh              as widget-handle no-undo .
     5817           define variable v-h             as handle        extent 4 no-undo .
     5818           define variable v-name-button   as character     no-undo .
     5819           define variable v-help-old-x    as decimal       no-undo .
     5820           define variable v-help-old-y    as decimal       no-undo .
     5821           define variable v-help-old-size as decimal       no-undo .
     5822           define variable v-frame-width   as decimal       no-undo .
     5823           define variable jj              as integer       no-undo .
     5824           do
     5825               on error undo, return error
     5826               :
     5827               assign
     5828                   v-frame-width = frame d-fbr-docs:width - 0.3
     5829                   fh            = frame d-fbr-docs:first-child
     5830                   hh            = fh:first-child
     5831                   ii            = 1
     5832                   .
     5833               do while valid-handle(hh):
     5834                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5835                   do:
     5836                       case lc(hh:name) :
     5837                           when "b-help" then
     5838                               do:
     5839                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5840                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5841                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5842                                   hh:TOOLTIP = "Помощь" .
     5843                                   v-help-old-x = hh:column .
     5844                                   v-help-old-y = hh:row    .
     5845                                   v-help-old-size = hh:width .
     5846                                   hh:width-chars = 2.5 .
     5847                               end.
     5848                           when "b-print" then
     5849                               do:
     5850                                   hh:load-image("cmp/b-print.bmp":u) .
     5851                                   hh:TOOLTIP = "Печать" .
     5852                                   v-h[ii] = hh:handle .
     5853                                   ii = ii + 1 .
     5854                                   hh:width-chars = 3 .
     5855                               end.
     5856                           when "b-history" or
     5857                           when "b-hist" then
     5858                               do:
     5859                                   hh:load-image("cmp/b-hist.bmp":u) .
     5860                                   hh:TOOLTIP = "История" .
     5861                                   v-h[ii] = hh:handle .
     5862                                   ii = ii + 1 .
     5863                                   hh:width-chars = 3 .
     5864                               end.
     5865                           when "b-sch" then
     5866                               do:
     5867                                   hh:load-image("cmp/b-sch.bmp":u) .
     5868                                   hh:TOOLTIP = "Установка Фильтра" .
     5869                                   v-h[ii] = hh:handle .
     5870                                   ii = ii + 1 .
     5871                                   hh:width-chars = 3 .
     5872                               end.
     5873                           when "b-hist-user" then
     5874                               do:
     5875                                   hh:load-image("cmp/b-hist.bmp":u) .
     5876                                   hh:TOOLTIP = "История пользователя" .
     5877                                   ii = ii + 1 .
     5878                               end.
     5879                       end case.
     5880                   end.
     5881                   hh = hh:next-sibling.
     5882               end.
     5883               b-help:column = v-frame-width - b-help:width-chars.
     5884               jj = 0.
     5885               repeat ii = 4 to 1 by -1 :
     5886                   if valid-handle (v-h[ii] ) then
     5887                   do:
     5888                       jj  = jj + 1 .
     5889                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5890                       v-h[ii]:row    = v-help-old-y .
     5891                   end.
     5892               end.
     5893           end.
     5894       end.
     5895   end procedure.
     5896   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5897   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5898   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5899   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5900   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5901   define variable v-diasize-current-frame-height as decimal   no-undo .
     5902   define variable v-diasize-change-size          as logical   no-undo .
     5903   define variable v-diasize-resize-button        as handle    no-undo .
     5904   define variable v-diasize-wndmax               as logical   no-undo .
     5905   define variable v-diasize-wndstore             as logical   no-undo .
     5906   define variable v-diasize-proc-name            as character no-undo .
     5907   define variable v-diasize-browse-handle        as handle    no-undo .
     5908   define variable v-diasize-browse-number        as integer   no-undo .
     5909   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5910   define temp-table temp-diasize-handle no-undo
     5911     field handle-value  as handle
     5912     field save-position as decimal
     5913     index xpk is primary unique handle-value
     5914     .
     5915   define temp-table temp-browse-handle no-undo
     5916     field browse-type   as character
     5917     field browse-number as integer
     5918     field browse-handle as handle
     5919     field original-size as decimal
     5920     index xpk is primary unique browse-type browse-number
     5921     index xie browse-type browse-handle
     5922   .
     5923   procedure diasize_change-height :
     5924     define input  parameter p-change-value  as decimal   no-undo .
     5925     define input  parameter p-move-resize   as logical   no-undo .
     5926     define variable v-field-group-handle    as handle    no-undo .
     5927     define variable v-object-handle         as handle    no-undo .
     5928     define variable v-frame-height          as decimal   no-undo .
     5929     define variable v-frame-virtual-height  as decimal   no-undo .
     5930     define variable v-browse-height         as decimal   no-undo .
     5931     define variable v-window-height         as decimal   no-undo .
     5932     define variable v-window-virtual-height as decimal   no-undo .
     5933     define variable v-change-sign           as integer   no-undo .
     5934     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5935     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5936     if p-change-value > 0
     5937     then do:
     5938       if frame d-fbr-docs :height + p-change-value
     5939           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5940       then do:
     5941         assign
     5942           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5943                           - (frame d-fbr-docs :height-chars)
     5944         .
     5945         if p-change-value <= 0
     5946         then do:
     5947           run diasize_position-resize-button in this-procedure .
     5948           return .
     5949         end.
     5950       end.
     5951     end.
     5952     if p-change-value < 0
     5953     then do:
     5954       if frame d-fbr-docs :height + p-change-value < v-diasize-orig-frame-height
     5955       then do:
     5956         assign
     5957           p-change-value = v-diasize-orig-frame-height
     5958                          - (frame d-fbr-docs :height-chars)
     5959         .
     5960         if p-change-value >= 0
     5961         then do:
     5962           run diasize_position-resize-button in this-procedure .
     5963           return .
     5964         end.
     5965       end.
     5966     end.
     5967     if p-change-value >= 0
     5968     then do:
     5969       assign
     5970         v-change-sign = 1
     5971       .
     5972     end.
     5973     else do:
     5974       assign
     5975         v-change-sign = -1
     5976       .
     5977     end.
     5978     assign
     5979       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5980     .
     5981     if p-change-value = 0
     5982     then do:
     5983       run diasize_position-resize-button in this-procedure .
     5984       return .
     5985     end.
     5986     move_block:
     5987     do
     5988     on error undo move_block, retry move_block
     5989     :
     5990       if retry
     5991       then do:
     5992         do
     5993         on error undo move_block, leave move_block
     5994         :
     5995           if p-change-value > 0
     5996           then do:
     5997             for each buf_temp-diasize-handle
     5998             on error undo, next
     5999             :
     6000               assign
     6001                 v-object-handle = buf_temp-diasize-handle.handle-value
     6002               .
     6003               if v-object-handle <> v-diasize-resize-button
     6004               then do:
     6005                 assign
     6006                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6007                 .
     6008               end.
     6009             end.
     6010             assign
     6011               v-diasize-browse-handle :height = v-browse-height
     6012             .
     6013             for each buf_temp-browse-handle
     6014               where buf_temp-browse-handle.browse-type = 'height':u
     6015             on error undo, next
     6016             :
     6017               assign
     6018                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6019               .
     6020             end.
     6021             assign
     6022               frame d-fbr-docs :height = v-frame-height
     6023             .
     6024             if frame d-fbr-docs :scrollable = true
     6025             then do:
     6026               assign
     6027                 frame d-fbr-docs :virtual-height = v-frame-virtual-height
     6028               .
     6029             end.
     6030             run diasize_position-resize-button in this-procedure .
     6031           end.
     6032           else do:
     6033             if frame d-fbr-docs :scrollable = true
     6034             then do:
     6035               assign
     6036                 frame d-fbr-docs :virtual-height = v-frame-virtual-height
     6037               .
     6038             end.
     6039             assign
     6040               frame d-fbr-docs :height = v-frame-height
     6041             .
     6042             assign
     6043               v-diasize-browse-handle :height = v-browse-height
     6044             .
     6045             for each buf_temp-browse-handle
     6046               where buf_temp-browse-handle.browse-type = 'height':u
     6047             on error undo, next
     6048             :
     6049               assign
     6050                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6051               .
     6052             end.
     6053             for each buf_temp-diasize-handle
     6054             on error undo, next
     6055             :
     6056               assign
     6057                 v-object-handle = buf_temp-diasize-handle.handle-value
     6058               .
     6059               if v-object-handle <> v-diasize-resize-button
     6060               then do:
     6061                 assign
     6062                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6063                 .
     6064               end.
     6065             end.
     6066             run diasize_position-resize-button in this-procedure .
     6067           end.
     6068           assign
     6069             v-diasize-change-size = false
     6070           .
     6071           leave move_block .
     6072         end.
     6073       end.
     6074       assign
     6075         v-diasize-need-full-display = true
     6076       .
     6077       if v-diasize-change-size = false
     6078       then do:
     6079         assign
     6080           v-diasize-change-size = true
     6081         .
     6082       end.
     6083       else do:
     6084         return .
     6085       end.
     6086       assign
     6087         v-frame-height = frame d-fbr-docs :height
     6088         v-frame-virtual-height = frame d-fbr-docs :virtual-height
     6089         v-browse-height = v-diasize-browse-handle :height
     6090       .
     6091       for each buf_temp-browse-handle
     6092         where buf_temp-browse-handle.browse-type = 'height':u
     6093       :
     6094         assign
     6095           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6096         .
     6097       end.
     6098       for each buf_temp-diasize-handle
     6099       :
     6100         delete buf_temp-diasize-handle .
     6101       end.
     6102       assign
     6103         v-field-group-handle = frame d-fbr-docs :first-child
     6104       .
     6105       do while valid-handle(v-field-group-handle)
     6106       :
     6107         assign
     6108           v-object-handle = v-field-group-handle :first-child
     6109         .
     6110         do while valid-handle(v-object-handle)
     6111         :
     6112           if  v-object-handle <> v-diasize-browse-handle :handle
     6113           and can-query(v-object-handle, "row")
     6114           and can-query(v-object-handle, "height")
     6115           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6116           then do:
