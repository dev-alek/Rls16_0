     4470   DEFINE NEW SHARED BROWSE br-docs
     4471     QUERY br-docs DISPLAY
     4472         f-doc.status_ COLUMN-LABEL "Статус" format "x(8)"
     4473         f-doc.doc-code format "x(12)"
     4474         (substring ((string (f-doc.doc-date)), 1, 5)) format "x(5)" column-label "Дата"
     4475         f-doc.fact-date COLUMN-LABEL "Факт"
     4476         (trim (f-doc.obj-type) + " " + string (f-doc.obj-code, ">>>>9")) COLUMN-LABEL "Объект" FORMAT "x(9)"
     4477         f-doc.in-qnty COLUMN-LABEL "Приход"
     4478         f-doc.out-qnty COLUMN-LABEL "Списано"
     4479         f-doc.in-sale COLUMN-LABEL "Прих. цены прод."
     4480         f-doc.out-sale COLUMN-LABEL "Спис. цены прод."
     4481         f-doc.in-base COLUMN-LABEL "Cумма учет (б.в.)"
     4482         f-doc.in-rubl COLUMN-LABEL "Cумма учет (руб.)"
     4483         f-doc.in-vat-base COLUMN-LABEL "Cумма уч. НДС (баз)"
     4484         f-doc.in-vat-rubl COLUMN-LABEL "Cумма уч. НДС (руб)"
     4485         f-doc.shift-date COLUMN-LABEL "Смена"
     4486         (if f-doc.shift-num = 0 then ? else f-doc.shift-num) COLUMN-LABEL "№" format ">9"
     4487       WITH NO-ROW-MARKERS SEPARATORS size 96.5 by 14.08.
     4488   DEFINE FRAME d-fbr-docs
     4489        b-quit   at row 1.08 col 1.63
     4490        b-sel    at row 1.08 col 11.63
     4491        b-gds    at row 1.08 col 21.63
     4492        b-sch    at row 1.08 col 31.63
     4493        b-hist   at row 1.08 col 41.63
     4494        b-help   at row 1.08 col 51.63
     4495        b-add    at row 2.25 col 1.63
     4496        b-lkp    at row 2.25 col 11.63
     4497        b-chg    at row 2.25 col 21.63
     4498        b-del    at row 2.25 col 31.63
     4499        b-close  at row 2.25 col 51.63
     4500        b-open   at row 2.25 col 61.63
     4501        b-print  at row 2.25 col 71.63
     4502        br-docs  at row 3.57 col 1.63
     4503        ed-notes at row 17.7 col 1.5 NO-LABEL      bgcolor 8 fgcolor 4
     4504        sch-code at row 19.66 col 14.13 COLON-ALIGNED
     4505        sch-date at row 19.66 col 35.88 COLON-ALIGNED
     4506        sch-fact at row 19.66 col 51.88 COLON-ALIGNED
     4507        sch-num  at row 19.66 col 74.75 COLON-ALIGNED fgcolor 12
     4508        v-fbr-docs-nik         at row 20.83 col 1.13  format "X(17)" label "Имя" fgcolor 4
     4509        f-doc.sys-date         at row 20.83 col 24.75 label "Дата изм." fgcolor 4
     4510        f-doc.sys-time         at row 20.83 col 48 label "Время изм." fgcolor 4
     4511        v-fbr-docs-oper-nik    at row 20.83 col 71 format "X(17)" label "Опер." fgcolor 4
     4512       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4513            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     4514            size 98.88 by 22.63.
     4515   ASSIGN
     4516          FRAME d-fbr-docs:SCROLLABLE = FALSE
     4517          br-docs:NUM-LOCKED-COLUMNS IN FRAME d-fbr-docs = 3
     4518          .
     4519   ON Shift-Alt-F6 of frame d-fbr-docs anywhere
     4520   do:
     4521       define variable v-message-text      as character    no-undo.
     4522       define variable v-should-replace    as logical      no-undo.
     4523       assign
     4524           v-message-text = "Запись событий в файл fbr.log. "
     4525       .
     4526       if search("fbr.log") <> ?
     4527       then do:
     4528           assign
     4529               v-message-text = v-message-text + " Удалить старый файл?"
     4530                           + chr(10) + chr(10) + "Yes - удалить старый LOG-файл, начать запись в новый"
     4531                           + chr(10) + "No - переименовать старый LOG-файл, начать запись в новый"
     4532                           + chr(10) + "Cancel - переименовать LOG-файл, остановить запись"
     4533           .
     4534           message
     4535               v-message-text
     4536           view-as alert-box buttons yes-no-cancel title "Журнал событий"
     4537           update v-should-replace.
     4538           if v-should-replace = ?
     4539           then do:
     4540                   os-delete "fbr-old.log".
     4541                   os-rename "fbr.log" "fbr-old.log".
     4542           end.
     4543           else do:
     4544               if v-should-replace = yes
     4545               then do:
     4546                   os-delete "fbr.log".
     4547               end.
     4548               else do:
     4549                   os-delete "fbr-old.log".
     4550                   os-rename "fbr.log" "fbr-old.log".
     4551               end.
     4552               output to "fbr.log".
     4553               output close.
     4554           end.
     4555       end.
     4556       else do:
     4557           message
     4558               v-message-text
     4559           view-as alert-box.
     4560           output to "fbr.log".
     4561           output close.
     4562       end.
     4563   end.
     4564   ON CHOOSE OF b-hist IN FRAME d-fbr-docs
     4565   DO:
     4566   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4567   if lookup(self :type
     4568            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4569            ) = 0
     4570   then do:
     4571     message
     4572       "$Workfile$"
     4573       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4574       "Интерфейсный элемент" self :name  skip
     4575       "Тип" self :type  skip
     4576       "Процедура" this-procedure :file-name skip
     4577       view-as alert-box .
     4578   end.
     4579   else do:
     4580     apply "entry":u to self  .
     4581     if focus :handle <> self :handle  then do:
     4582       return no-apply .
     4583     end.
     4584   end.
     4585   if not available f-doc then do:
     4586     message "Неправильно выбран документ."
     4587             view-as alert-box error.
     4588     return no-apply.
     4589   end.
     4590   doc-rec = recid (f-doc).
     4591   run str/fbrdocsh.w (
     4592         input parparentproc
     4593       , input f-doc.doc-code
     4594   ).
     4595   END.
     4596   ON CHOOSE OF b-close IN FRAME d-fbr-docs DO:
     4597   define variable same-sale   like fbr-line.price-sale    no-undo.
     4598   define variable is-waste    as logical                  no-undo.
     4599   define variable fix-price   like fbr-line.is-calc       no-undo.
     4600   define variable v-reserved  as logical                  no-undo.
     4601   define variable varchip-code like ub.c-trn-doc.chip-num no-undo.
     4602   define variable varchip-code2 like ub.c-trn-doc.chip-num no-undo.
     4603   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4604   if lookup(self :type
     4605            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4606            ) = 0
     4607   then do:
     4608     message
     4609       "$Workfile$"
     4610       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4611       "Интерфейсный элемент" self :name  skip
     4612       "Тип" self :type  skip
     4613       "Процедура" this-procedure :file-name skip
     4614       view-as alert-box .
     4615   end.
     4616   else do:
     4617     apply "entry":u to self  .
     4618     if focus :handle <> self :handle  then do:
     4619       return no-apply .
     4620     end.
     4621   end.
     4622   if not available f-doc then do:   message "Неправильно выбран документ." view-as alert-box error.   return no-apply. end. doc-rec = recid (f-doc). do on stop undo, return no-apply :   find f-doc where recid (f-doc) = doc-rec exclusive.   end.
     4623   if f-doc.status_ = 'нередакт':U
     4624   then do:
     4625       find first f-doc no-lock
     4626            where recid (f-doc) = doc-rec
     4627       .
     4628       message
     4629           "Документ в статусе 'Нередактируемый' не может быть закрыт."
     4630       view-as alert-box error.
     4631       return no-apply.
     4632   end.
     4633   if f-doc.status_ = 'факт':U
     4634   then do:
     4635     find first f-doc no-lock
     4636          where recid (f-doc) = doc-rec
     4637     .
     4638     message "Документ уже закрыт."
     4639             view-as alert-box error.
     4640     return no-apply.
     4641   end.
     4642   if f-doc.status_ = 'новый':U
     4643   then do:
     4644       assign
     4645           v-yesno = no
     4646       .
     4647       message "Документ :" f-doc.status_ "№" f-doc.doc-code
     4648           skip "Завершить ввод и редактирование?"
     4649       view-as alert-box question
     4650       buttons OK-Cancel
