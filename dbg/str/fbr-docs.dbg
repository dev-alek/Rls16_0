     6507               where buf_temp-browse-handle.browse-type   = 'width':u
     6508                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6509               no-error .
     6510             if available buf_temp-browse-handle
     6511             then do:
     6512             end.
     6513             else do:
     6514               create buf_temp-diasize-handle .
     6515               assign
     6516                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6517                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6518               .
     6519             end.
     6520           end.
     6521           assign
     6522             v-object-handle = v-object-handle :next-sibling
     6523           .
     6524         end.
     6525         assign
     6526           v-field-group-handle = v-field-group-handle :next-sibling
     6527         .
     6528       end.
     6529       do with frame d-fbr-docs
