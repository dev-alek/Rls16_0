      986   buf_fbr-doc.PS        = "@"
      987   buf_fbr-doc.status_   = 'новый':U
      988   buf_fbr-doc.user-db-num = v-obj-db-num
      989   buf_fbr-doc.user-name   = p-userid
      990   .
      991   run fbrlib_get-default-pay-code in this-procedure (
      992         input buf_fbr-doc.obj-type
      993       , input buf_fbr-doc.obj-code
      994       , output fi-pay-code
      995   ).
      996   buf_fbr-doc.pay-code = fi-pay-code.
      997   p-recid = recid(buf_fbr-doc).
      998   p-fbr-doc-code = buf_fbr-doc.doc-code.
      999   end.
     1000   end procedure.
     1001   procedure fbrlib_get-default-pay-code :
     1002   define input parameter p-obj-type   as character        no-undo.
     1003   define input parameter p-obj-code   as integer          no-undo.
     1004   define output parameter p-pay-code  as integer          no-undo.
     1005   define variable v-host-code as integer no-undo .
     1006   define buffer buf_shop          for ub.shop.
     1007   define buffer buf_store         for ub.store.
     1008   define buffer buf_sysconf       for ub.sysconf.
     1009   do
     1010   for buf_shop
     1011     , buf_store
     1012     , buf_sysconf
     1013   on error undo, return error
     1014   :
     1015     case p-obj-type  :
     1016       when 'маг':U then do:
     1017           find first buf_shop no-lock
     1018                 where buf_shop.obj-code = p-obj-code
     1019           no-error.
     1020           if available buf_shop
     1021           then do:
     1022               assign
     1023                   p-pay-code = buf_shop.fbr-pay
     1024               .
     1025           end.
     1026       end.
     1027       when 'скл':U then do:
     1028           find first buf_store no-lock
     1029                 where buf_store.obj-code = p-obj-code
     1030           no-error.
     1031           if available buf_store
     1032           then do:
     1033               assign
     1034                   p-pay-code = buf_store.fbr-pay
     1035               .
     1036           end.
     1037       end.
     1038     end case.
     1039     if p-pay-code = ?
     1040     or p-pay-code = 0
     1041     then do:
     1042   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1044     (input  p-obj-type
     1045     ,input  p-obj-code
     1046     ,output v-host-code
     1047     )  .
     1048         find first buf_sysconf no-lock
     1049               where buf_sysconf.host-code = v-host-code
     1050         no-error.
     1051         if available buf_sysconf
     1052         then do:
     1053             assign
     1054                 p-pay-code = buf_sysconf.fbr-pay
     1055             .
     1056         end.
     1057     end.
     1058     if p-pay-code = ?
     1059     or p-pay-code = 0
     1060     then do:
     1061   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1063     (input  p-obj-type
     1064     ,input  p-obj-code
     1065     ,output p-pay-code
     1066     )  .
     1067     end.
     1068   end.
     1069   end procedure.
     1070   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1071   do
     1072   on error undo, return error
     1073   :
     1074   define input parameter p-fbr-doc-code as character    no-undo.
     1075       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1076       define variable v-gds-name      as character    no-undo.
     1077       define buffer buf_fbr-doc               for ub.fbr-doc.
     1078       define buffer buf_fbr-line              for ub.fbr-line.
     1079       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1080       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1081       find first buf_fbr-doc no-lock
     1082            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1083       .
     1084       for each buf_temp_fbrlib_recipe
     1085       :
     1086           delete buf_temp_fbrlib_recipe.
     1087       end.
     1088       for each buf_fbr-line no-lock
     1089          where buf_fbr-line.doc-code = p-fbr-doc-code
     1090       :
     1091           find first buf_temp_fbrlib_recipe
     1092                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1093           no-error.
     1094           if not available buf_temp_fbrlib_recipe
     1095           then do:
     1096               create buf_temp_fbrlib_recipe.
     1097               assign
     1098                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1099                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1100               .
     1101           end.
     1102       end.
     1103       for each buf_temp_fbrlib_recipe
     1104       :
     1105           assign
     1106               buf_temp_fbrlib_recipe.count-income                = 0
     1107               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1108               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1109               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1110               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1111               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1112               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1113               buf_temp_fbrlib_recipe.count-write-off             = 0
     1114               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1115               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1116               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1117               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1118               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1119               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1120           .
     1121           for each buf_fbr-line no-lock
     1122              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1123                and buf_fbr-line.trn-type     = 'при':U
     1124                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1125           :
     1126               if ( buf_fbr-line.price-base   = ?
     1127                   or buf_fbr-line.price-rubl = ?
     1128                   or buf_fbr-line.price-base <= 0
     1129                   or buf_fbr-line.price-rubl <= 0 )
     1130               and buf_fbr-line.fact-qnty <> 0
     1131               and buf_fbr-line.rsrv-qnty <> ?
     1132               and buf_fbr-doc.is-free    = no
     1133               then do:
     1134   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1136     (input  buf_fbr-line.artic
     1137     ,input  buf_fbr-line.prod-type
     1138     ,input  buf_fbr-line.prod-code
     1139     ,output v-gds-name
     1140     ) no-error .
     1141                   if error-status :error
     1142                   then do:
     1143                       assign
     1144                           v-gds-name = ""
     1145                       .
     1146                   end.
     1147                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1148                                                 ,vss-description
     1149                                                 ,buf_fbr-doc.doc-code
     1150                                                 ,chr(10)
     1151                                                 ,buf_fbr-line.recipe-code
     1152                                                 ,buf_fbr-line.artic
     1153                                                 ,v-gds-name).
     1154               end.
     1155               assign
     1156                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1157                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1158                                                                   + buf_fbr-line.fact-qnty
     1159                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1160                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1161               .
     1162               if buf_fbr-line.is-waste = no
     1163               then do:
     1164                   assign
     1165                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1166                                                                       + buf_fbr-line.price-sum-base
     1167                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1168                                                                       + buf_fbr-line.price-sum-rubl
     1169                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1170                                                                       + buf_fbr-line.price-sum-vat-base
     1171                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1172                                                                       + buf_fbr-line.price-sum-vat-rubl
     1173                   .
     1174               end.
     1175           end.
     1176           for each buf_fbr-line no-lock
     1177              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1178                and buf_fbr-line.trn-type     = 'спи':U
     1179                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1180           :
     1181               if ( buf_fbr-line.price-base   = ?
     1182                   or buf_fbr-line.price-rubl = ?
     1183                   or buf_fbr-line.price-base <= 0
     1184                   or buf_fbr-line.price-rubl <= 0 )
     1185               and buf_fbr-line.fact-qnty <> 0
     1186               and buf_fbr-line.rsrv-qnty <> ?
     1187               and buf_fbr-doc.is-free    = no
     1188               and buf_fbr-doc.status_    = 'разрешен':U
     1189               then do:
     1190   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1192     (input  buf_fbr-line.artic
     1193     ,input  buf_fbr-line.prod-type
     1194     ,input  buf_fbr-line.prod-code
     1195     ,output v-gds-name
     1196     ) no-error .
     1197                   if error-status :error
     1198                   then do:
     1199                       assign
     1200                           v-gds-name = ""
     1201                       .
     1202                   end.
     1203                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1204                                                 ,vss-description
     1205                                                 ,buf_fbr-doc.doc-code
     1206                                                 ,chr(10)
     1207                                                 ,buf_fbr-line.recipe-code
     1208                                                 ,buf_fbr-line.artic
     1209                                                 ,v-gds-name).
     1210               end.
     1211               assign
     1212                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1213                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1214                                                                   + buf_fbr-line.fact-qnty
     1215                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1216                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1217               .
     1218               if buf_fbr-line.is-waste = no
     1219               then do:
     1220                   assign
     1221                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1222                                                                       + buf_fbr-line.price-sum-base
     1223                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1224                                                                       + buf_fbr-line.price-sum-rubl
     1225                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1226                                                                       + buf_fbr-line.price-sum-vat-base
     1227                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1228                                                                       + buf_fbr-line.price-sum-vat-rubl
     1229                   .
     1230               end.
     1231           end.
     1232           if buf_fbr-doc.status_    = 'разрешен':U
     1233           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1234           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1235           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1236           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1237               )
     1238           then do:
     1239            undo, return error
     1240               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1241                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1242                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1243                           "Сумма в &9.&4&7&4&4&8&2"
     1244                          , buf_fbr-doc.doc-code
     1245                          , chr(10)
     1246                          , buf_temp_fbrlib_recipe.recipe-code
     1247                          , chr(9)
     1248                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1249                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1250                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1251                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1252                          , "руб"
     1253                          )
     1254              +
     1255              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1256                         "НДС в &7.&1&5&1&1&6&4"
     1257                        ,  chr(9)
     1258                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1259                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1260                        ,chr(10)
     1261                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1262                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1263                        ,"руб"
     1264                        )       .
     1265           end.
     1266       end.
     1267   end.
     1268   end procedure.
     1269   procedure fbrlib-fill-sum-fbr-doc :
     1270   do
     1271   on error undo, return error
     1272   :
     1273   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1274   define input parameter p-mode           as character    no-undo.
     1275       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1276       define buffer buf_fbr-doc           for ub.fbr-doc.
     1277       define buffer buf_fbr-line          for ub.fbr-line.
     1278       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1279       define variable v-in-count          as integer       no-undo.
     1280       define variable v-out-count         as integer       no-undo.
     1281       find first buf_fbr-doc exclusive-lock
     1282            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1283       .
     1284       find first buf_temp_fbrlib_recipe no-error.
     1285       if not available buf_temp_fbrlib_recipe
     1286       then do:
     1287           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1288               input buf_fbr-doc.doc-code
     1289           ) no-error.
     1290           if error-status :error
     1291           then do:
     1292               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1293                                              , vss-description
     1294                                              , chr(10)
     1295                                              , error-status:get-message(1)
     1296                                              , return-value ).
     1297           end.
     1298       end.
     1299       assign
     1300           v-in-count                  = 0
     1301           buf_fbr-doc.in-qnty         = 0
     1302           buf_fbr-doc.in-sale         = 0
     1303           buf_fbr-doc.in-base         = 0
     1304           buf_fbr-doc.in-rubl         = 0
     1305           buf_fbr-doc.in-vat-base     = 0
     1306           buf_fbr-doc.in-vat-rubl     = 0
     1307           v-out-count                 = 0
     1308           buf_fbr-doc.out-qnty        = 0
     1309           buf_fbr-doc.out-sale        = 0
     1310           buf_fbr-doc.out-base        = 0
     1311           buf_fbr-doc.out-rubl        = 0
     1312           buf_fbr-doc.out-vat-base    = 0
     1313           buf_fbr-doc.out-vat-rubl    = 0
     1314       .
     1315       for each buf_temp_fbrlib_recipe
     1316       :
     1317           assign
     1318               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1319               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1320               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1321               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1322               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1323               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1324               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1325               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1326               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1327               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1328               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1329               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1330               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1331               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1332           .
     1333       end.
     1334       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1335       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1336       or p-mode <> 'факт':U
     1337       then do:
     1338           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1339           then do:
     1340               assign
     1341                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1342                                   + string( v-out-count, ">>>,>>9" )
     1343                                   + chr(10) + "Строк исходных товаров : "
     1344                                   + string( v-in-count, ">>>,>>9" )
     1345               .
     1346           end.
     1347       end.
     1348       else do:
     1349         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1350                                       "Сумма списанных товаров в &3 - &4&2" +
     1351                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1352                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1353                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1354                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1355                                       , buf_fbr-doc.doc-code
     1356                                       , chr(10)
     1357                                       , "рублях"
     1358                                       , round( buf_fbr-doc.out-rubl, 2 )
     1359                                       , round( buf_fbr-doc.in-rubl,  2 )
     1360                                       , round( buf_fbr-doc.in-rubl,  2 )
     1361                                       , round( buf_fbr-doc.out-base, 2 )
     1362                                       , round( buf_fbr-doc.in-base,  2 )).
     1363       end.
     1364   end.
     1365   end procedure.
     1366   procedure fbrlib-calc-prices :
     1367   do
     1368   on error undo, return error
     1369   :
     1370   define input parameter p-fbr-line-recid as recid        no-undo.
     1371   define input parameter p-price-obj-type as character    no-undo.
     1372   define input parameter p-price-obj-code as integer      no-undo.
     1373   define output parameter p-current-price as decimal      no-undo.
     1374       define variable v-void          as decimal       no-undo.
     1375       define variable v-void-char     as character     no-undo.
     1376       define variable v-gds-code      as integer       no-undo.
     1377       define variable v-b-code        as integer       no-undo.
     1378       define buffer buf_fbr-doc   for ub.fbr-doc.
     1379       define buffer buf_fbr-line  for ub.fbr-line.
     1380       define buffer buf_gds-prt   for ub.gds-prt.
     1381       define buffer buf_bar-code  for ub.bar-code.
     1382       find first buf_fbr-line no-lock
     1383           where recid( buf_fbr-line ) = p-fbr-line-recid
     1384       .
     1385   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1387     (input  buf_fbr-line.artic
     1388     ,input  buf_fbr-line.prod-type
     1389     ,input  buf_fbr-line.prod-code
     1390     ,output v-gds-code
     1391     ) no-error .
     1392       if error-status :error
     1393       then do:
     1394         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1395                                         ,vss-workfile
     1396                                         ,vss-revision
     1397                                         ,vss-description
     1398                                         ,chr(10)
     1399                                         , error-status:get-message(1)
     1400                                         , return-value
     1401                                         , buf_fbr-line.artic
     1402                                         ).
     1403       end.
     1404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1405     (input  v-gds-code
     1406     ,input  ?
     1407     ,output v-b-code
     1408     ) no-error .
     1409       if error-status :error
     1410       then do:
     1411         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1412                                         ,vss-workfile
     1413                                         ,vss-revision
     1414                                         ,vss-description
     1415                                         ,chr(10)
     1416                                         , error-status:get-message(1)
     1417                                         , return-value
     1418                                         , v-gds-code
     1419                                         ).
     1420       end.
     1421       if buf_fbr-line.is-calc = no
     1422       then do:
     1423   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1425     (input  p-price-obj-type
     1426     ,input  p-price-obj-code
     1427     ,input  v-b-code
     1428     ,input  0
     1429     ,input  0
     1430     ,output v-void-char
     1431     ,output p-current-price
     1432     ,output v-void
     1433     ,output v-void
     1434     ) no-error .
     1435           if error-status :error
     1436           then do:
     1437             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1438                                             ,vss-workfile
     1439                                             ,vss-revision
     1440                                             ,vss-description
     1441                                             ,chr(10)
     1442                                             , error-status:get-message(1)
     1443                                             , return-value
     1444                                             , v-gds-code
     1445                                             ).
     1446           end.
     1447       end.
     1448       else do:
     1449           assign
     1450               p-current-price = buf_fbr-line.price-sale
     1451           .
     1452       end.
     1453   end.
     1454   end procedure.
     1455   procedure fbrlib-put-in-order-recipe :
     1456   do
     1457   on error undo, return error
     1458   :
     1459   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1460       define variable v-recipe-counter    as integer          no-undo.
     1461       define variable v-recipe-amount     as integer init 0   no-undo.
     1462       define variable v-child-counter     as integer          no-undo.
     1463       define variable v-is-call-cycle     as logical          no-undo.
     1464       define variable v-str as character     no-undo.
     1465       define buffer buf_in_fbr-line       for ub.fbr-line.
     1466       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1467       define buffer buf_fbr-line          for ub.fbr-line.
     1468       define buffer buf_recipe-gds        for ub.recipe-gds.
     1469       define buffer buf_recipe            for ub.recipe.
     1470       for each temp_recipe-childs-qnty
     1471       :
     1472           delete temp_recipe-childs-qnty.
     1473       end.
     1474       for each temp_recipe-childs
     1475       :
     1476           delete temp_recipe-childs.
     1477       end.
     1478       for each temp_recipe-order
     1479       :
     1480           delete temp_recipe-order.
     1481       end.
     1482       for each buf_fbr-line no-lock
     1483          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1484       on error undo, return error
     1485       :
     1486           find first temp_recipe-childs-qnty
     1487                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1488           no-error.
     1489           if not available temp_recipe-childs-qnty
     1490           then do:
     1491               create temp_recipe-childs-qnty.
     1492               assign
     1493                   v-recipe-amount                     = v-recipe-amount + 1
     1494                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1495                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1496                   temp_recipe-childs-qnty.childs-qnty = 0
     1497                   v-child-counter                     = 0
     1498               .
     1499           end.
     1500       end.
     1501       for each buf_in_fbr-line no-lock
     1502          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1503            and buf_in_fbr-line.trn-type = 'спи':U
     1504       on error undo, return error
     1505       :
     1506           for each buf_dress_fbr-line no-lock
     1507              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1508                and buf_dress_fbr-line.trn-type    = 'при':U
     1509                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1510                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1511                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1512           on error undo, return error
     1513           :
     1514               find first buf_recipe no-lock
     1515                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1516               .
     1517               if buf_in_fbr-line.is-comp = yes
     1518               then do:
     1519                   find last temp_recipe-childs-qnty
     1520                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1521                   .
     1522                   assign
     1523                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1524                   .
     1525                   create temp_recipe-childs.
     1526                   assign
     1527                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1528                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1529                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1530                   .
     1531               end.
     1532               else do:
     1533               end.
     1534           end.
     1535       end.
     1536       for each buf_in_fbr-line no-lock
     1537          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1538            and buf_in_fbr-line.trn-type = 'при':U
     1539       on error undo, return error
     1540       :
     1541           find first buf_recipe no-lock
     1542                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1543           no-error.
     1544           if buf_in_fbr-line.is-comp = no
     1545           then do:
     1546           end.
     1547           else do:
     1548               for each buf_recipe-gds no-lock
     1549               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1550               :
     1551                   for each buf_fbr-line no-lock
     1552                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1553                       and buf_fbr-line.trn-type    = 'при':U
     1554                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1555                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1556                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1557                   on error undo, return error
     1558                   :
     1559                       find first buf_recipe no-lock
     1560                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1561                       .
     1562                       if buf_recipe.recipe-type = 'разделка':U
     1563                       then do:
     1564                       end.
     1565                       else do:
     1566                           find last temp_recipe-childs-qnty
     1567                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1568                           .
     1569                           assign
     1570                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1571                           .
     1572                           create temp_recipe-childs.
     1573                           assign
     1574                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1575                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1576                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1577                           .
     1578                       end.
     1579                   end.
     1580               end.
     1581           end.
     1582       end.
     1583       for each temp_recipe-order
     1584       on error undo, return error
     1585       :
     1586           delete temp_recipe-order.
     1587       end.
     1588       assign
     1589           v-fbrlib-recipe-order = 0
     1590       .
     1591       do v-recipe-counter = 1 to v-recipe-amount
     1592       on error undo, return error
     1593       :
     1594           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1595                 input v-recipe-counter
     1596               , input 0
     1597               , output v-is-call-cycle
     1598           ).
     1599           if v-is-call-cycle = yes
     1600           then do:
     1601               message
     1602                       "Достигнут максимальный уровень вложенности рецептов."
     1603                   skip(1)
     1604                   skip "Невозможно упорядочить рецепты."
     1605                   skip(1)
     1606                   skip "Необходимо изменить структуру рецептов,"
     1607                   skip "используемых при формировании"
     1608                   skip "данного документа производства."
     1609               view-as alert-box error
     1610               title "Невозможно рассчитать документ производства".
     1611               for each temp_recipe-childs-qnty
     1612               :
     1613                   delete temp_recipe-childs-qnty.
     1614               end.
     1615               for each temp_recipe-childs
     1616               :
     1617                   delete temp_recipe-childs.
     1618               end.
     1619               for each temp_recipe-order
     1620               :
     1621                   delete temp_recipe-order.
     1622               end.
     1623               for each temp_recipe-order
     1624               on error undo, return error
     1625               :
     1626                   delete temp_recipe-order.
     1627               end.
     1628               for each temp_fbrlib_recipe
     1629               on error undo, return error
     1630               :
     1631                   delete temp_recipe-order.
     1632               end.
     1633               undo, return error.
     1634           end.
     1635       end.
     1636   end.
     1637   end procedure.
     1638   procedure fbrlib-add-recipe-in-tmp-order :
     1639   do
     1640   on error undo, return error
     1641   :
     1642   define input parameter p-order              as integer      no-undo.
     1643   define input parameter p-call-counter       as integer      no-undo.
     1644   define output parameter p-is-call-cycle     as logical      no-undo.
     1645       define variable v-nodes-counter     as integer       no-undo.
     1646       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1647       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1648       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1649       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1650       assign
     1651           p-call-counter = p-call-counter + 1
     1652       .
     1653       if p-call-counter > 50
     1654       then do:
     1655           assign
     1656               p-is-call-cycle = yes
     1657           .
     1658       end.
     1659       else do:
     1660           find first buf_temp_recipe-childs-qnty
     1661                where buf_temp_recipe-childs-qnty.order = p-order
     1662           .
     1663           find first buf_temp_recipe-order
     1664                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1665           no-error.
     1666           if not available buf_temp_recipe-order
     1667           then do:
     1668               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1669               :
     1670                   find first buf_temp_recipe-childs
     1671                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1672                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1673                   .
     1674                   find first buf_c_temp_recipe-childs-qnty
     1675                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1676                   .
     1677                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1678                         input buf_c_temp_recipe-childs-qnty.order
     1679                       , input p-call-counter
     1680                       , output p-is-call-cycle
     1681                   ).
     1682                   if p-is-call-cycle = yes
     1683                   then do:
     1684                       return.
     1685                   end.
     1686               end.
     1687               assign
     1688                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1689               .
     1690               create buf_temp_recipe-order.
     1691               assign
     1692                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1693                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1694               .
     1695           end.
     1696       end.
     1697   end.
     1698   end procedure.
     1699   procedure fbrlib-get-trn-type :
     1700   define input parameter p-recipe-code    as character    no-undo.
     1701   define input parameter p-goods-recid    as recid        no-undo.
     1702   define input parameter p-is-integration as logical      no-undo.
     1703   define output parameter p-is-comp       as logical      no-undo.
     1704   define output parameter p-trn-type      as character    no-undo.
     1705   define buffer buf_recipe    for ub.recipe.
     1706   define buffer buf_goods     for ub.goods.
     1707   do
     1708   for buf_recipe
     1709     , buf_goods
     1710   on error undo, return error
     1711   :
     1712       find first buf_goods no-lock
     1713            where recid( buf_goods ) = p-goods-recid
     1714       .
     1715       find first buf_recipe no-lock
     1716            where buf_recipe.recipe-code = p-recipe-code
     1717       no-error.
     1718       if not available buf_recipe
     1719       then do:
     1720           assign
     1721               p-is-comp = no
     1722               p-trn-type = "":U
     1723           .
     1724           undo, return.
     1725       end.
     1726       if  buf_recipe.artic        = buf_goods.artic
     1727       and buf_recipe.prod-type    = buf_goods.prod-type
     1728       and buf_recipe.prod-code    = buf_goods.prod-code
     1729       then do:
     1730           assign
     1731               p-is-comp = yes
     1732           .
     1733       end.
     1734       else do:
     1735           assign
     1736               p-is-comp = no
     1737           .
     1738       end.
     1739       case buf_recipe.recipe-type
     1740       :
     1741           when 'производство':U
     1742           then do:
     1743               if p-is-comp = yes
     1744               then do:
     1745                   assign
     1746                       p-trn-type = 'при':U
     1747                   .
     1748               end.
     1749               else do:
     1750                   assign
     1751                       p-trn-type = 'спи':U
     1752                   .
     1753               end.
     1754           end.
     1755           when 'альтернатива':U
     1756           then do:
     1757               if p-is-comp = yes
     1758               then do:
     1759                   assign
     1760                       p-trn-type = 'при':U
     1761                   .
     1762               end.
     1763               else do:
     1764                   assign
     1765                       p-trn-type = 'спи':U
     1766                   .
     1767               end.
     1768           end.
     1769           when 'разделка':U
     1770           then do:
     1771               if p-is-comp = no
     1772               then do:
     1773                   assign
     1774                       p-trn-type = 'при':U
     1775                   .
     1776               end.
     1777               else do:
     1778                   assign
     1779                       p-trn-type = 'спи':U
     1780                   .
     1781               end.
     1782           end.
     1783           when 'комплектация':U
     1784           then do:
     1785               if p-is-integration = ?
     1786               then do:
     1787                   message
     1788                       "Выберите тип операции по рецепту комплектации:"
     1789                       skip (2) "YES - комплектация"
     1790                       skip     "NO - разукомплектация"
     1791                   view-as alert-box question
     1792                   buttons YES-NO
     1793                   update p-is-integration.
     1794               end.
     1795               if p-is-integration = yes
     1796               then do:
     1797                   if p-is-comp = yes
     1798                   then do:
     1799                       assign
     1800                           p-trn-type = 'при':U
     1801                       .
     1802                   end.
     1803                   else do:
     1804                       assign
     1805                           p-trn-type = 'спи':U
     1806                       .
     1807                   end.
     1808               end.
     1809               else do:
     1810                   if p-is-comp = yes
     1811                   then do:
     1812                       assign
     1813                           p-trn-type = 'спи':U
     1814                       .
     1815                   end.
     1816                   else do:
     1817                       assign
     1818                           p-trn-type = 'при':U
     1819                       .
     1820                   end.
     1821               end.
     1822           end.
     1823       end case.
     1824   end.
     1825   end procedure.
     1826   procedure fbrlib-get-mark :
     1827   define input parameter p-recipe-code    as character    no-undo.
     1828   define output parameter p-mark          as logical    no-undo.
     1829   define buffer buf_goods-attr     for ub.goods-attr.
     1830   define buffer buf_recipe-gds for ub.recipe-gds .
     1831       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     1832            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     1833                                               buf_goods-attr.attr-code = 'mark-type':U:
     1834            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     1835               p-mark = true .
     1836               return .
     1837            end.
     1838       end.
     1839   end procedure.
     1840   procedure fbrlib-check-temp-tables :
     1841   do
     1842   on error undo, return error
     1843   :
     1844   define input parameter p-title  as character    no-undo.
     1845       define variable v-str               as character        no-undo.
     1846       assign
     1847           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     1848       .
     1849       for each temp_recipe-childs-qnty
     1850       on error undo, return error
     1851       :
     1852           assign
     1853               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     1854                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     1855                       + "   " + string( temp_recipe-childs-qnty.order )
     1856                       + chr(10)
     1857           .
     1858       end.
     1859       assign
     1860           v-str = v-str + "temp_recipe-childs:" + chr(10)
     1861       .
     1862       for each temp_recipe-childs
     1863       on error undo, return error
     1864       :
     1865           assign
     1866               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     1867                       + "   " + string( temp_recipe-childs.child-code )
     1868                       + "   " + string( temp_recipe-childs.child-recipe-code )
     1869                       + chr(10)
     1870           .
     1871       end.
     1872       assign
     1873           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     1874       .
     1875       for each temp_recipe-order
     1876       on error undo, return error
     1877       :
     1878           assign
     1879               v-str   = v-str + string( temp_recipe-order.recipe-code )
     1880                       + "   " + string( temp_recipe-order.order )
     1881                       + chr(10)
     1882           .
     1883       end.
     1884       assign
     1885           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     1886       .
     1887       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     1888       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1889       for each temp_fbrlib_recipe
     1890       on error undo, return error
     1891       :
     1892           assign
     1893               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     1894                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     1895                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     1896                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     1897                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     1898                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     1899                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     1900                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     1901                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     1902                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     1903                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     1904                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     1905                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     1906                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     1907                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     1908                       + chr(10)
     1909           .
     1910           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1911       end.
     1912   end.
     1913   end procedure.
     1914   procedure fbrlib-s-coeff-value :
     1915   define input  parameter p-gds-code    as integer        no-undo.
     1916   define input  parameter p-date        as date           no-undo.
     1917   define input  parameter p-obj-type    as character      no-undo.
     1918   define input  parameter p-obj-code    as integer        no-undo.
     1919   define output parameter p-coeff-value as decimal        no-undo.
     1920   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     1921       define variable v-date          as date         no-undo.
     1922       define variable v-host-code     as integer      no-undo.
     1923       define buffer buf_goods       for ub.goods.
     1924       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     1925       define buffer buf_clients     for ub.clients.
     1926       define buffer buf_s-coeff     for ub.s-coeff.
     1927   do
     1928   for buf_goods
     1929     , buf_fbr-gds-obj
     1930     , buf_clients
     1931     , buf_s-coeff
     1932   on error undo, return error return-value
     1933   :
     1934       find first buf_goods no-lock
     1935            where buf_goods.gds-code = p-gds-code
     1936       no-error .
     1937       if not available buf_goods
     1938       then do:
     1939          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     1940       end.
     1941       find first buf_clients no-lock
     1942            where buf_clients.obj-type = p-obj-type
     1943              and buf_clients.obj-code = p-obj-code
     1944       no-error.
     1945       if not available buf_clients
     1946       then do:
     1947          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     1948       end.
     1949       assign
     1950           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     1951       .
     1952       find first buf_fbr-gds-obj no-lock
     1953            where buf_fbr-gds-obj.gds-code = p-gds-code
     1954              and buf_fbr-gds-obj.obj-type = p-obj-type
     1955              and buf_fbr-gds-obj.obj-code = p-obj-code
     1956       no-error.
     1957       if not available buf_fbr-gds-obj
     1958       or buf_fbr-gds-obj.is-season = no
     1959       then do:
     1960           assign
     1961               p-coeff-value = 0
     1962           .
     1963           return.
     1964       end.
     1965   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1966   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1967     (input  p-obj-type
     1968     ,input  p-obj-code
     1969     ,output v-host-code
     1970     )  .
     1971       find last buf_s-coeff no-lock
     1972           where buf_s-coeff.gds-code = p-gds-code
     1973             and buf_s-coeff.host-code = v-host-code
     1974             and buf_s-coeff.obj-type = p-obj-type
     1975             and buf_s-coeff.obj-code = p-obj-code
     1976             and buf_s-coeff.s-date <= v-date
     1977       no-error.
     1978       if available buf_s-coeff
     1979       then do:
     1980           assign
     1981               p-coeff-value = buf_s-coeff.coeff-value
     1982           .
     1983           return.
     1984       end.
     1985       find last buf_s-coeff no-lock
     1986           where buf_s-coeff.gds-code = p-gds-code
     1987             and buf_s-coeff.host-code = v-host-code
     1988             and buf_s-coeff.obj-type = "":U
     1989             and buf_s-coeff.obj-code = 0
     1990             and buf_s-coeff.s-date <= v-date
     1991       no-error.
     1992       if available buf_s-coeff
     1993       then do:
     1994           assign
     1995               p-coeff-value = buf_s-coeff.coeff-value
     1996           .
     1997           return.
     1998       end.
     1999       find last buf_s-coeff no-lock
     2000           where buf_s-coeff.gds-code = p-gds-code
     2001             and buf_s-coeff.host-code = 0
     2002             and buf_s-coeff.obj-type = "":U
     2003             and buf_s-coeff.obj-code = 0
     2004             and buf_s-coeff.s-date <= v-date
     2005       no-error.
     2006       if available buf_s-coeff
     2007       then do:
     2008           assign
     2009               p-coeff-value = buf_s-coeff.coeff-value
     2010           .
     2011       end.
     2012       else do:
     2013           assign
     2014               p-coeff-value = 0
     2015           .
     2016       end.
     2017   end.
     2018   end procedure.
     2019   procedure fbrlib_create-fbr-recipe-gds :
     2020   define input parameter p-doc-code         as character      no-undo.
     2021   define input parameter p-recipe-code      as character      no-undo.
     2022   define input parameter p-prod-type        as character      no-undo.
     2023   define input parameter p-prod-code        as integer        no-undo.
     2024   define input parameter p-artic            as character      no-undo.
     2025   define input parameter p-gds-code         as integer        no-undo.
     2026   define input parameter p-is-waste         as logical        no-undo.
     2027   define input parameter p-proc-number      as integer        no-undo.
     2028   define input parameter p-obj-date         as date           no-undo.
     2029   define input parameter p-obj-type         as character      no-undo.
     2030   define input parameter p-obj-code         as integer        no-undo.
     2031   define input parameter p-calc-method      as decimal        no-undo.
     2032   define input parameter p-coeff-waste      as decimal        no-undo.
     2033   define input parameter p-orig-qnty        as decimal        no-undo.
     2034   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2035       define variable v-coeff-season  as decimal      no-undo.
     2036       define variable v-void-decimal  as decimal      no-undo.
     2037       define variable v-void-integer  as integer      no-undo.
     2038       define variable v-recipe-type   as character    no-undo.
     2039       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2040       define buffer buf_goods             for ub.goods.
     2041       define buffer buf_recipe            for ub.recipe.
     2042   do
     2043   for buf_fbr-recipe-gds
     2044     , buf_recipe
     2045     , buf_goods
     2046   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2047   :
     2048       find first buf_fbr-recipe-gds exclusive-lock
     2049            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2050              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2051              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2052              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2053              and buf_fbr-recipe-gds.artic       = p-artic
     2054       no-error.
     2055       if not available buf_fbr-recipe-gds
     2056       then do:
     2057           create buf_fbr-recipe-gds.
     2058           assign
     2059               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2060               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2061               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2062               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2063               buf_fbr-recipe-gds.artic              = p-artic
     2064               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2065               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2066               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2067               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2068               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2069           .
     2070           find first buf_goods no-lock
     2071                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2072                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2073                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2074           .
     2075           run fbrlib-s-coeff-value in this-procedure (
     2076                 input buf_goods.gds-code
     2077               , input p-obj-date
     2078               , input p-obj-type
     2079               , input p-obj-code
     2080               , output v-coeff-season
     2081           ) no-error.
     2082           if error-status:error
     2083           then do:
     2084               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2085           end.
     2086           assign
     2087               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2088               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2089               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2090           .
     2091           run fbrlib-get-recipe-type in this-procedure (
     2092                 input buf_fbr-recipe-gds.doc-code
     2093               , input buf_fbr-recipe-gds.recipe-code
     2094               , output v-recipe-type
     2095           ).
     2096           if v-recipe-type <> 'производство':U
     2097           then do:
     2098               assign
     2099                   buf_fbr-recipe-gds.coeff-value  = 0
     2100                   buf_fbr-recipe-gds.coeff-waste  = 0
     2101                   buf_fbr-recipe-gds.calc-method  = 1
     2102                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2103               .
     2104           end.
     2105           else do:
     2106               run fbrlib-calc-brutto in this-procedure (
     2107                     input v-recipe-type
     2108                   , input buf_fbr-recipe-gds.qnty
     2109                   , input buf_fbr-recipe-gds.coeff-value
     2110                   , input buf_fbr-recipe-gds.coeff-waste
     2111                   , input 0
     2112                   , input 3
     2113                   , output v-void-decimal
     2114                   , output v-void-decimal
     2115                   , output buf_fbr-recipe-gds.brutto-qnty
     2116                   , output v-void-integer
     2117               ).
     2118               assign
     2119                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2120               .
     2121               run fbrlib-calc-brutto in this-procedure (
     2122                     input v-recipe-type
     2123                   , input buf_fbr-recipe-gds.qnty
     2124                   , input buf_fbr-recipe-gds.coeff-value
     2125                   , input buf_fbr-recipe-gds.coeff-waste
     2126                   , input buf_fbr-recipe-gds.brutto-qnty
     2127                   , input buf_fbr-recipe-gds.calc-method
     2128                   , output buf_fbr-recipe-gds.qnty
     2129                   , output v-void-decimal
     2130                   , output v-void-decimal
     2131                   , output v-void-integer
     2132               ).
     2133           end.
     2134       end.
     2135   end.
     2136   end procedure.
     2137   procedure fbrlib-set-default-recipe :
     2138   define input parameter p-obj-type   as character    no-undo.
     2139   define input parameter p-obj-code   as integer      no-undo.
     2140   define input parameter p-gds-code   as integer      no-undo.
     2141       define variable v-artic             as character    no-undo.
     2142       define variable v-prod-type         as character    no-undo.
     2143       define variable v-prod-code         as character    no-undo.
     2144       define variable v-recipe-code       as character    no-undo.
     2145       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2146       define variable v-recipe-found      as logical      no-undo.
     2147       define buffer buf_recipe        for ub.recipe.
     2148       define buffer buf_other_recipe  for ub.recipe.
     2149       define buffer buf_goods         for ub.goods.
     2150       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2151   do
     2152   for buf_recipe
     2153     , buf_goods
     2154     , buf_fbr-gds-obj
     2155   on error undo, return error
     2156   :
     2157       find first buf_goods no-lock
     2158            where buf_goods.gds-code = p-gds-code
     2159       .
     2160       run fbrlib-get-obj-recipe in this-procedure (
     2161             input p-obj-type
     2162           , input p-obj-code
     2163           , input p-gds-code
     2164           , output v-recipe-code
     2165       ).
     2166       if v-recipe-code <> ""
     2167       then do:
     2168           find first buf_recipe no-lock
     2169               where buf_recipe.recipe-code = v-recipe-code
     2170           no-error.
     2171           if not available buf_recipe
     2172           then do:
     2173               assign
     2174                   v-recipe-code = ""
     2175               .
     2176           end.
     2177       end.
     2178       if v-recipe-code = ""
     2179       then do:
     2180           find first buf_fbr-gds-obj exclusive-lock
     2181                where buf_fbr-gds-obj.obj-type = p-obj-type
     2182                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2183                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2184           no-error.
     2185           if not available buf_fbr-gds-obj
     2186           then do:
     2187               run ref/fgdsobj1.p (
     2188                     input-output v-fbr-gds-obj-recid
     2189                   , input 'ДОБАВЛЕНИЕ':U
     2190                   , input no
     2191                   , input p-gds-code
     2192                   , input p-obj-type
     2193                   , input p-obj-code
     2194                   , input 0
     2195                   , input ""
     2196                   , input 0
     2197                   , input no
     2198                   , input no
     2199                   , input no
     2200                   , input no
     2201                   , input no
     2202                   , input no
     2203               ) no-error.
     2204               if error-status:error
     2205               then do:
     2206                   message
     2207                           vss-workfile vss-revision vss-description
     2208                       skip "Ошибка изменения атрибутов товара на объекте"
     2209                       skip return-value
     2210                       skip trim(error-status :get-message(1))
     2211                               trim(error-status :get-message(2))
     2212                               trim(error-status :get-message(3))
     2213                   view-as alert-box error.
     2214                   undo, return error .
     2215               end.
     2216               find first buf_fbr-gds-obj exclusive-lock
     2217                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2218               .
     2219           end.
     2220           assign
     2221               v-recipe-found = no
     2222           .
     2223           for first buf_recipe no-lock
     2224               where buf_recipe.obj-type    = p-obj-type
     2225                 and buf_recipe.obj-code    = p-obj-code
     2226                 and buf_recipe.artic       = buf_goods.artic
     2227                 and buf_recipe.prod-type   = buf_goods.prod-type
     2228                 and buf_recipe.prod-code   = buf_goods.prod-code
     2229                 and buf_recipe.recipe-type = 'производство':U
     2230                 or (
     2231                     buf_recipe.obj-type    = ""
     2232                 and buf_recipe.obj-code    = 0
     2233                 and buf_recipe.artic       = buf_goods.artic
     2234                 and buf_recipe.prod-type   = buf_goods.prod-type
     2235                 and buf_recipe.prod-code   = buf_goods.prod-code
     2236                 and buf_recipe.recipe-type = 'производство':U
     2237                     )
     2238           :
     2239               assign
     2240                   v-recipe-found = yes
     2241                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2242               .
     2243           end.
     2244           if v-recipe-found = no
     2245           then do:
     2246               for first buf_recipe no-lock
     2247                   where buf_recipe.obj-type    = p-obj-type
     2248                     and buf_recipe.obj-code    = p-obj-code
     2249                     and buf_recipe.artic       = buf_goods.artic
     2250                     and buf_recipe.prod-type   = buf_goods.prod-type
     2251                     and buf_recipe.prod-code   = buf_goods.prod-code
     2252                     and buf_recipe.recipe-type <> 'альтернатива':U
     2253                     or (
     2254                         buf_recipe.obj-type    = ""
     2255                     and buf_recipe.obj-code    = 0
     2256                     and buf_recipe.artic       = buf_goods.artic
     2257                     and buf_recipe.prod-type   = buf_goods.prod-type
     2258                     and buf_recipe.prod-code   = buf_goods.prod-code
     2259                     and buf_recipe.recipe-type <> 'альтернатива':U
     2260                         )
     2261               :
     2262                   assign
     2263                       v-recipe-found = yes
     2264                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2265                   .
     2266               end.
     2267               if v-recipe-found = no
     2268               then do:
     2269                   for first buf_recipe no-lock
     2270                       where buf_recipe.obj-type    = p-obj-type
     2271                         and buf_recipe.obj-code    = p-obj-code
     2272                         and buf_recipe.artic       = buf_goods.artic
     2273                         and buf_recipe.prod-type   = buf_goods.prod-type
     2274                         and buf_recipe.prod-code   = buf_goods.prod-code
     2275                         or (
     2276                             buf_recipe.obj-type    = ""
     2277                         and buf_recipe.obj-code    = 0
     2278                         and buf_recipe.artic       = buf_goods.artic
     2279                         and buf_recipe.prod-type   = buf_goods.prod-type
     2280                         and buf_recipe.prod-code   = buf_goods.prod-code
     2281                             )
     2282                   :
     2283                       assign
     2284                           v-recipe-found = yes
     2285                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2286                       .
     2287                   end.
     2288                   if v-recipe-found = no
     2289                   then do:
     2290                       assign
     2291                           buf_fbr-gds-obj.default-recipe-code = ""
     2292                       .
     2293                   end.
     2294               end.
     2295           end.
     2296       end.
     2297   end.
     2298   end procedure.
     2299   procedure fbrlib-get-obj-recipe :
     2300   define input parameter p-obj-type       as character    no-undo.
     2301   define input parameter p-obj-code       as integer      no-undo.
     2302   define input parameter p-gds-code       as integer      no-undo.
     2303   define output parameter p-recipe-code   as character    no-undo.
     2304       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2305   do
     2306   for buf_fbr-gds-obj
     2307   on error undo, return error
     2308   :
     2309       find first buf_fbr-gds-obj no-lock
     2310            where buf_fbr-gds-obj.obj-type = p-obj-type
     2311              and buf_fbr-gds-obj.obj-code = p-obj-code
     2312              and buf_fbr-gds-obj.gds-code = p-gds-code
     2313       no-error.
     2314       if available buf_fbr-gds-obj
     2315       then do:
     2316           assign
     2317               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2318           .
     2319       end.
     2320       else do:
     2321           assign
     2322               p-recipe-code = ""
     2323           .
     2324       end.
     2325   end.
     2326   end procedure.
     2327   procedure fbrlib-create-or-update-recipe-gds :
     2328   define input parameter p-recipe-code    as character        no-undo.
     2329   define input parameter p-gds-code       as integer          no-undo.
     2330   define input parameter p-is-waste       as logical          no-undo.
     2331   define input parameter p-qnty           as decimal          no-undo.
     2332   define input parameter p-proc-number    as integer          no-undo.
     2333   define input parameter p-nws-self       as logical          no-undo.
     2334       define variable v-max-proc-num  as integer      no-undo.
     2335       define variable v-recipe-type   as character    no-undo.
     2336       define buffer buf_goods             for ub.goods.
     2337       define buffer buf_recipe-gds        for ub.recipe-gds.
     2338       define buffer buf_recipe            for ub.recipe.
     2339       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2340   do
     2341   for buf_goods
     2342     , buf_recipe-gds
     2343     , buf_recipe
     2344     , buf_proc_recipe-gds
     2345   on error undo, return error
     2346   :
     2347       find first buf_recipe no-lock
     2348            where buf_recipe.recipe-code = p-recipe-code
     2349       .
     2350       find first buf_goods no-lock
     2351            where buf_goods.gds-code = p-gds-code
     2352       .
     2353       find first buf_recipe-gds
     2354            where buf_recipe-gds.recipe-code = p-recipe-code
     2355              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2356              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2357              and buf_recipe-gds.artic       = buf_goods.artic
     2358       no-error.
     2359       if not available buf_recipe-gds
     2360       then do:
     2361           create buf_recipe-gds.
     2362           assign
     2363               buf_recipe-gds.recipe-code = p-recipe-code
     2364               buf_recipe-gds.gds-code    = p-gds-code
     2365               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2366               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2367               buf_recipe-gds.artic       = buf_goods.artic
     2368           .
     2369           assign
     2370               buf_recipe-gds.is-waste    = no
     2371               buf_recipe-gds.qnty        = 0
     2372               buf_recipe-gds.coeff-waste = 0
     2373               buf_recipe-gds.brutto-qnty = 0
     2374               buf_recipe-gds.proc-number = 0
     2375               buf_recipe-gds.nws-self    = no
     2376           .
     2377       end.
     2378       assign
     2379           buf_recipe-gds.is-waste    = p-is-waste
     2380       .
     2381       run fbrlib-get-recipe-type in this-procedure (
     2382             input "":U
     2383           , input buf_recipe-gds.recipe-code
     2384           , output v-recipe-type
     2385       ).
     2386       if v-recipe-type <> 'производство':U
     2387       then do:
     2388           assign
     2389               buf_recipe-gds.calc-method = 1
     2390               buf_recipe-gds.qnty        = p-qnty
     2391               buf_recipe-gds.brutto-qnty = p-qnty
     2392               buf_recipe-gds.coeff-waste = 0
     2393           .
     2394       end.
     2395       else do:
     2396           assign
     2397               buf_recipe-gds.calc-method = 1
     2398               buf_recipe-gds.brutto-qnty = p-qnty
     2399           .
     2400           run fbrlib-calc-brutto in this-procedure (
     2401                 input v-recipe-type
     2402               , input 0
     2403               , input 0
     2404               , input buf_recipe-gds.coeff-waste
     2405               , input buf_recipe-gds.brutto-qnty
     2406               , input 1
     2407               , output buf_recipe-gds.qnty
     2408               , output buf_recipe-gds.coeff-waste
     2409               , output buf_recipe-gds.brutto-qnty
     2410               , output buf_recipe-gds.calc-method
     2411           ).
     2412       end.
     2413       assign
     2414           buf_recipe-gds.nws-self    = p-nws-self
     2415       .
     2416       if buf_recipe.recipe-type = 'альтернатива':U
     2417       and buf_recipe-gds.proc-number <> 0
     2418       then do:
     2419       end.
     2420       else do:
     2421           if p-proc-number <> 0
     2422           then do:
     2423               assign
     2424                   buf_recipe-gds.proc-number = p-proc-number
     2425               .
     2426           end.
     2427           else do:
     2428               assign
     2429                   v-max-proc-num = 0
     2430               .
     2431               for each buf_proc_recipe-gds no-lock
     2432                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2433               :
     2434                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2435                   then do:
     2436                       assign
     2437                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2438                       .
     2439                   end.
     2440               end.
     2441               assign
     2442                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2443               .
     2444           end.
     2445       end.
     2446   end.
     2447   end procedure.
     2448   PROCEDURE fbrlib-create-or-update-recipe :
     2449   define input parameter p-mode               as character    no-undo.
     2450   define input parameter p-obj-type           as character    no-undo.
     2451   define input parameter p-obj-code           as integer      no-undo.
     2452   define input parameter p-recipe-code        as character    no-undo.
     2453   define input parameter p-recipe-type        as character    no-undo.
     2454   define input parameter p-gds-code           as integer      no-undo.
     2455   define input parameter p-name               as character    no-undo.
     2456   define input parameter p-design             as character    no-undo.
     2457   define input parameter p-order              as integer      no-undo.
     2458   define input parameter p-quality            as character    no-undo.
     2459   define input parameter p-ref-num            as character    no-undo.
     2460   define input parameter p-technique          as character    no-undo.
     2461   define input parameter p-template           as character    no-undo.
     2462   define input parameter p-qnty               as decimal      no-undo.
     2463   define input parameter p-portion-qnty       as integer      no-undo.
     2464   define input parameter p-portion-weight     as decimal      no-undo.
     2465   define output parameter p-new-recipe-code   as character    no-undo.
     2466       define variable v-host-code         as integer      no-undo.
     2467       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2468       define buffer buf_recipe    for ub.recipe.
     2469       define buffer buf_goods     for ub.goods.
     2470   do
     2471   for buf_recipe
     2472     , buf_goods
     2473   on error undo, return error
     2474   :
     2475       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2476       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2477       then do:
     2478           message
     2479               skip "Ошибка задания типа операции для создания или измения рецепта."
     2480               skip (1)
     2481               skip "Задан тип операции:" p-mode
     2482           view-as alert-box error.
     2483           undo, return error .
     2484       end.
     2485       if p-recipe-code = ""
     2486       then do:
     2487   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2489     (input  p-obj-type
     2490     ,input  p-obj-code
     2491     ,output v-host-code
     2492     )  .
     2493           find first buf_goods no-lock
     2494                where buf_goods.gds-code = p-gds-code
     2495           .
     2496           create buf_recipe .
     2497           run fbrcode-gen-recipe-code in this-procedure (
     2498                 input p-obj-type
     2499               , input p-obj-code
     2500               , output buf_recipe.recipe-code
     2501           ).
     2502           assign
     2503               buf_recipe.artic               = buf_goods.artic
     2504               buf_recipe.prod-type           = buf_goods.prod-type
     2505               buf_recipe.prod-code           = buf_goods.prod-code
     2506               buf_recipe.recipe-type         = p-recipe-type
     2507               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2508               buf_recipe.gds-code            = p-gds-code
     2509               buf_recipe.host-code           = v-host-code
     2510               buf_recipe.obj-type            = p-obj-type
     2511               buf_recipe.obj-code            = p-obj-code
     2512               buf_recipe.recipe-design       = ""
     2513               buf_recipe.recipe-order        = 0
     2514               buf_recipe.recipe-quality      = ""
     2515               buf_recipe.recipe-ref-num      = ""
     2516               buf_recipe.recipe-technique    = ""
     2517               buf_recipe.recipe-template     = ""
     2518               buf_recipe.qnty                = 1.0
     2519               buf_recipe.portion-qnty        = 1
     2520               buf_recipe.portion-weight      = 0
     2521           .
     2522       end.
     2523       if p-name <> ""
     2524       then do:
     2525           assign
     2526               buf_recipe.recipe-name = p-name
     2527           .
     2528       end.
     2529       assign
     2530           buf_recipe.recipe-design       = p-design
     2531           buf_recipe.recipe-order        = p-order
     2532           buf_recipe.recipe-quality      = p-quality
     2533           buf_recipe.recipe-ref-num      = p-ref-num
     2534           buf_recipe.recipe-technique    = p-technique
     2535           buf_recipe.recipe-template     = p-template
     2536           buf_recipe.qnty                = p-qnty
     2537           buf_recipe.portion-qnty        = p-portion-qnty
     2538           buf_recipe.portion-weight      = p-portion-weight
     2539       .
     2540       assign
     2541           p-new-recipe-code = buf_recipe.recipe-code
     2542       .
     2543       run fbrlib-set-default-recipe in this-procedure (
     2544             input p-obj-type
     2545           , input p-obj-code
     2546           , input buf_goods.gds-code
     2547       ).
     2548   end.
     2549   END PROCEDURE.
     2550   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2551   define input parameter parparentproc-handle as widget-handle no-undo .
     2552   define input parameter p-doc-code   as character no-undo.
     2553   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2554       define variable v-shift-on      as logical      no-undo.
     2555       define variable v-shift-date    as date         no-undo.
     2556       define variable v-shift-num     as integer      no-undo.
     2557       define variable v-shift-name    as character    no-undo.
     2558       define variable v-obj-date      as date         no-undo.
     2559       define variable v-chip-num      as integer      no-undo.
     2560       define buffer buf_fbr-doc       for ub.fbr-doc.
     2561       define buffer buf_fbr-line      for ub.fbr-line.
     2562       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2563       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2564       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2565       define buffer buf_marking-lines for ub.marking-lines .
     2566       define buffer buf_marking       for ub.marking .
     2567       define buffer buf_goods         for ub.goods .
     2568   do
     2569   for buf_fbr-doc
     2570     , buf_fbr-line
     2571     , buf_c-fbr-doc
     2572     , buf_fbr-recipe
     2573     , buf_fbr-recipe-gds
     2574     , buf_goods
     2575     , buf_marking
     2576     , buf_marking-lines
     2577   on error undo, return error
     2578   :
     2579   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2580     define variable v-cntxt-db-num        as integer   no-undo .
     2581     define variable v-cntxt-userid        as character no-undo .
     2582     define variable v-cntxt-level         as character no-undo .
     2583     define variable v-cntxt-host-code-obj as integer   no-undo .
     2584     define variable v-cntxt-obj-type      as character no-undo .
     2585     define variable v-cntxt-obj-code      as integer   no-undo .
     2586     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2587     define variable v-cntxt-is-admin      as logical   no-undo .
     2588   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2589     run mainmenu_getcntxt in parparentproc-handle
     2590       (output v-cntxt-db-num
     2591       ,output v-cntxt-userid
     2592       ,output v-cntxt-level
     2593       ,output v-cntxt-host-code-obj
     2594       ,output v-cntxt-obj-type
     2595       ,output v-cntxt-obj-code
     2596       ,output v-cntxt-db-num-obj
     2597       ,output v-cntxt-is-admin
     2598       ) .
     2599       if search ("delfbr.err") <> ?
     2600       then do:
     2601           os-delete "delfbr.err".
     2602       end.
     2603     _del-block:
     2604       do transaction
     2605     on error undo _del-block, return error return-value
     2606     on endkey undo _del-block , return error return-value
     2607     on stop undo _del-block , return error return-value
     2608       :
     2609           find first buf_fbr-doc exclusive-lock
     2610                where buf_fbr-doc.doc-code = p-doc-code
     2611           no-error.
     2612           if not available buf_fbr-doc
     2613           then do:
     2614         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2615                                           ,vss-workfile
     2616                                           ,vss-revision
     2617                                           ,vss-description
     2618                                           ,chr(10)
     2619                                           , p-doc-code).
     2620           end.
     2621           run fbrlib-delete-fact-trn-doc in this-procedure (
     2622               input parparentproc-handle
     2623              ,input p-doc-code
     2624              ,input 'при':U
     2625              ,input p-chip-num
     2626              ,output v-chip-num
     2627           ) no-error.
     2628           if error-status :error
     2629           then do:
     2630               run fbrlib-print-del-error-message in this-procedure .
     2631         undo _del-block, return error.
     2632           end.
     2633           assign
     2634           p-chip-num = (if p-chip-num = ?
     2635                         then v-chip-num
     2636                         else p-chip-num).
     2637           run fbrlib-delete-fact-trn-doc in this-procedure (
     2638               input parparentproc-handle
     2639              ,input p-doc-code
     2640              ,input 'рас':U
     2641              ,input p-chip-num
     2642              ,output v-chip-num
     2643           ) no-error.
     2644           if error-status :error
     2645           then do:
     2646               run fbrlib-print-del-error-message in this-procedure .
     2647         undo _del-block, return error.
     2648           end.
     2649           run fbrlib-delete-fact-trn-doc in this-procedure (
     2650               input parparentproc-handle
     2651              ,input p-doc-code
     2652              ,input 'спи':U
     2653              ,input p-chip-num
     2654              ,output v-chip-num
     2655           ) no-error.
     2656           if error-status :error
     2657           then do:
     2658               run fbrlib-print-del-error-message in this-procedure .
     2659         undo _del-block, return error.
     2660           end.
     2661           create buf_c-fbr-doc.
     2662           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2663   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2664   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2665     (input  buf_fbr-doc.obj-type
     2666     ,input  buf_fbr-doc.obj-code
     2667     ,output v-obj-date
     2668     ) no-error .
     2669           if error-status :error
     2670           or v-obj-date = ?
     2671           then do:
     2672         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2673           end.
     2674   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2676     (input  buf_fbr-doc.obj-type
     2677     ,input  buf_fbr-doc.obj-code
     2678     ,input  'shift-on=request'
     2679     ,output v-shift-on
     2680     )  .
     2681           if v-shift-on
     2682           then do:
     2683   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2685     (input  buf_fbr-doc.obj-type
     2686     ,input  buf_fbr-doc.obj-code
     2687     ,output v-shift-date
     2688     ,output v-shift-num
     2689     ,output v-shift-name
     2690     ) no-error .
     2691               if error-status :error
     2692               then do:
     2693           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2694               end.
     2695           end.
     2696           else do:
     2697               assign
     2698                   v-shift-date = ?
     2699                   v-shift-num  = ?
     2700                   v-shift-name = ?
     2701               .
     2702           end.
     2703           define variable v-today       as date         no-undo.
     2704           define variable v-time        as integer      no-undo.
     2705           run cur-time in this-procedure (
     2706                 output v-today
     2707               , output v-time
     2708           ).
     2709           assign
     2710               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2711               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2712               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2713               buf_c-fbr-doc.corr-date        = v-today
     2714               buf_c-fbr-doc.corr-time        = v-time
     2715               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2716               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2717               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2718               buf_c-fbr-doc.is-del           = yes
     2719           .
     2720           assign
     2721               buf_fbr-doc.is-del = yes
     2722           .
     2723           for each buf_fbr-line exclusive-lock
     2724              where buf_fbr-line.doc-code = p-doc-code
     2725       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2726       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2727       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2728           :
     2729               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2730                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2731                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2732               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2733                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2734                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2735                                                       and buf_marking-lines.in-code  = "manufacturing"
     2736                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2737                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2738                                                       and buf_marking-lines.prt-code = 0
     2739               :
     2740                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2741                   assign
     2742                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2743                   .
     2744                 end .
     2745                 delete buf_marking-lines.
     2746               end .
     2747               delete buf_fbr-line.
     2748           end.
     2749           for each buf_fbr-recipe exclusive-lock
     2750              where buf_fbr-recipe.doc-code = p-doc-code
     2751       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2752       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2753       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2754           :
     2755               delete buf_fbr-recipe.
     2756           end.
     2757           for each buf_fbr-recipe-gds exclusive-lock
     2758              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2759       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2760       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2761       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2762           :
     2763               delete buf_fbr-recipe-gds.
     2764           end.
     2765           delete buf_fbr-doc.
     2766       end.
     2767   end.
     2768   END PROCEDURE.
     2769   PROCEDURE fbrlib-del-trn-doc :
     2770   do
     2771   on error undo, return error
     2772   :
     2773   define input parameter parparentproc        as widget-handle no-undo .
     2774   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2775   define input parameter p-trn-doc-type       as character    no-undo.
     2776   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2777   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     2778       define variable v-trn-doc-doc-code  as character     no-undo.
     2779       define buffer buf_trn-doc       for ub.trn-doc.
     2780   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2781     define variable v-cntxt-db-num        as integer   no-undo .
     2782     define variable v-cntxt-userid        as character no-undo .
     2783     define variable v-cntxt-level         as character no-undo .
     2784     define variable v-cntxt-host-code-obj as integer   no-undo .
     2785     define variable v-cntxt-obj-type      as character no-undo .
     2786     define variable v-cntxt-obj-code      as integer   no-undo .
     2787     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2788     define variable v-cntxt-is-admin      as logical   no-undo .
     2789   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790     run mainmenu_getcntxt in parparentproc
     2791       (output v-cntxt-db-num
     2792       ,output v-cntxt-userid
     2793       ,output v-cntxt-level
     2794       ,output v-cntxt-host-code-obj
     2795       ,output v-cntxt-obj-type
     2796       ,output v-cntxt-obj-code
     2797       ,output v-cntxt-db-num-obj
     2798       ,output v-cntxt-is-admin
     2799       ) .
     2800       run fbrcode-trn-doc in this-procedure (
     2801             input 'производство':U
     2802           , input p-fbr-doc-doc-code
     2803           , input p-trn-doc-type
     2804           , output v-trn-doc-doc-code
     2805       ).
     2806       find first buf_trn-doc no-lock
     2807            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     2808       no-error.
     2809       if available buf_trn-doc
     2810       then do:
     2811           run str/del-doc.p (
     2812                 input parparentproc
     2813               , input buf_trn-doc.doc-code
     2814               , input v-cntxt-db-num
     2815               , input "del-doc.err"
     2816               , input ?
     2817               , input p-fbr-doc-doc-code
     2818               , input v-cntxt-userid
     2819               , input 0
     2820               , input p-phchip-num
     2821               , output p-chip-num
     2822           ) no-error.
     2823           if error-status :error
     2824           then do:
     2825             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     2826                                           ,v-trn-doc-doc-code
     2827                                           ,p-fbr-doc-doc-code
     2828                                           , chr(10)
     2829                                           , error-status:get-message(1)
     2830                                           , return-value ).
     2831           end.
     2832       end.
     2833   end.
     2834   END PROCEDURE.
     2835   PROCEDURE fbrlib-delete-fact-trn-doc :
     2836   define input parameter parparentproc    as widget-handle    no-undo.
     2837   define input parameter p-fbr-doc-code   as character        no-undo.
     2838   define input parameter p-doc-type       as character    no-undo.
     2839   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     2840   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     2841       define variable v-doc-code          as character        no-undo.
     2842       define variable v-ext-doc-type      as character        no-undo.
     2843       define variable v-trn-doc-recid     as recid            no-undo.
     2844       define variable varchip-code        as integer          no-undo.
     2845       define variable varchip-code2       as integer          no-undo.
     2846       define variable v-chip-counter      as integer          no-undo.
     2847       define buffer buf_trn-doc       for ub.trn-doc.
     2848       define buffer buf_pri_trn-doc   for ub.trn-doc.
     2849       define buffer buf_cons_trn-doc  for ub.trn-doc.
     2850   do
     2851   for buf_trn-doc
     2852     , buf_pri_trn-doc
     2853     , buf_cons_trn-doc
     2854   on error undo, return error
     2855   :
     2856   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2857     define variable v-cntxt-db-num        as integer   no-undo .
     2858     define variable v-cntxt-userid        as character no-undo .
     2859     define variable v-cntxt-level         as character no-undo .
     2860     define variable v-cntxt-host-code-obj as integer   no-undo .
     2861     define variable v-cntxt-obj-type      as character no-undo .
     2862     define variable v-cntxt-obj-code      as integer   no-undo .
     2863     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2864     define variable v-cntxt-is-admin      as logical   no-undo .
     2865   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2866     run mainmenu_getcntxt in parparentproc
     2867       (output v-cntxt-db-num
     2868       ,output v-cntxt-userid
     2869       ,output v-cntxt-level
     2870       ,output v-cntxt-host-code-obj
     2871       ,output v-cntxt-obj-type
     2872       ,output v-cntxt-obj-code
     2873       ,output v-cntxt-db-num-obj
     2874       ,output v-cntxt-is-admin
     2875       ) .
     2876       run fbrcode-trn-doc in this-procedure (
     2877             input 'производство':U
     2878           , input p-fbr-doc-code
     2879           , input p-doc-type
     2880           , output v-doc-code
     2881       ).
     2882       find first buf_trn-doc no-lock
     2883            where buf_trn-doc.doc-code = v-doc-code
     2884       no-error.
     2885       if not available buf_trn-doc
     2886       then do:
     2887           if p-doc-type <> 'спи':U
     2888           then do:
     2889               message
     2890                   "Не найден документ '" p-doc-type "'"
     2891                   "по документу производства " p-fbr-doc-code
     2892               view-as alert-box.
     2893               undo, return error.
     2894           end.
     2895           else do:
     2896           end.
     2897       end.
     2898       else do:
     2899           assign
     2900               v-trn-doc-recid = recid( buf_trn-doc )
     2901               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     2902           .
     2903           if v-ext-doc-type = 'ev':U
     2904           then do:
     2905               find first buf_pri_trn-doc no-lock
     2906                    where buf_pri_trn-doc.out-code     = v-doc-code
     2907                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     2908               no-error.
     2909               if available buf_pri_trn-doc
     2910               then do:
     2911                   run str/del-doc.p (
     2912                         input parparentproc
     2913                       , input buf_pri_trn-doc.doc-code
     2914                       , input v-cntxt-db-num
     2915                       , input "delfbr.err"
     2916                       , input ?
     2917                       , input p-fbr-doc-code
     2918                       , input v-cntxt-userid
     2919                       , input 0
     2920                       , input (if p-ph-chip-num <> ?
     2921                               then p-ph-chip-num
     2922                               else (if varchip-code <> 0
     2923                                   then varchip-code
     2924                                   else ?)
     2925                               )
     2926                       , output varchip-code2
     2927                   ) no-error.
     2928                   if error-status :error
     2929                   then do:
     2930                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2931                                                   ,buf_pri_trn-doc.doc-code
     2932                                                   ,p-fbr-doc-code
     2933                                                   , chr(10)
     2934                                                   , error-status:get-message(1)
     2935                                                   , return-value ).
     2936                   end.
     2937               end.
     2938           end.
     2939           define buffer buf_out_trn-doc       for ub.trn-doc.
     2940           if p-doc-type = 'при':U
     2941           then do:
     2942               assign
     2943                   v-chip-counter = 0
     2944               .
     2945               for each buf_out_trn-doc exclusive-lock
     2946                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     2947               on error undo, return error
     2948               :
     2949                   assign
     2950                       v-chip-counter = v-chip-counter + 1
     2951                   .
     2952                   if v-chip-counter > 1
     2953                   then do:
     2954                       assign
     2955                           varchip-code = varchip-code2
     2956                       .
     2957                   end.
     2958                   run str/del-doc.p (
     2959                         input parparentproc
     2960                       , input buf_out_trn-doc.doc-code
     2961                       , input v-cntxt-db-num
     2962                       , input "delfbr.err"
     2963                       , input ?
     2964                       , input p-fbr-doc-code
     2965                       , input v-cntxt-userid
     2966                       , input 0
     2967                       , input (if p-ph-chip-num <> ?
     2968                               then p-ph-chip-num
     2969                               else (if varchip-code <> 0
     2970                                   then varchip-code
     2971                                   else ?)
     2972                               )
     2973                       , output varchip-code2
     2974                   ) no-error.
     2975                   if error-status :error
     2976                   then do:
     2977                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     2978                                                   ,buf_out_trn-doc.doc-code
     2979                                                   ,buf_trn-doc.doc-code
     2980                                                   ,p-fbr-doc-code
     2981                                                   , chr(10)
     2982                                                   , error-status:get-message(1)
     2983                                                   , return-value ).
     2984                   end.
     2985               end.
     2986           end.
     2987           run str/del-doc.p (
     2988                 input parparentproc
     2989               , input buf_trn-doc.doc-code
     2990               , input v-cntxt-db-num
     2991               , input "delfbr.err"
     2992               , input ?
     2993               , input p-fbr-doc-code
     2994               , input v-cntxt-userid
     2995               , input 0
     2996               , input (if p-ph-chip-num <> ?
     2997                        then p-ph-chip-num
     2998                        else (if varchip-code <> 0
     2999                              then varchip-code
     3000                              else ?)
     3001                        )
     3002               , output varchip-code2
     3003           ) no-error.
     3004           if error-status :error
     3005           then do:
     3006               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3007                                             ,buf_trn-doc.doc-code
     3008                                             ,p-fbr-doc-code
     3009                                             , chr(10)
     3010                                             , error-status:get-message(1)
     3011                                             , return-value ).
     3012           end.
     3013           if p-doc-type = 'рас':U
     3014           or p-doc-type = 'спи':U
     3015           then do:
     3016               assign
     3017                   v-chip-counter = 0
     3018               .
     3019               for each buf_cons_trn-doc no-lock
     3020                  where buf_cons_trn-doc.out-code      = v-doc-code
     3021                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3022               :
     3023                   assign
     3024                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3025                       v-chip-counter = v-chip-counter + 1
     3026                   .
     3027                   assign
     3028                   varchip-code = if v-chip-counter = 2
     3029                                  then varchip-code2
     3030                                  else varchip-code.
     3031                   run str/del-doc.p (
     3032                         input parparentproc
     3033                       , input buf_cons_trn-doc.doc-code
     3034                       , input v-cntxt-db-num
     3035                       , input "delfbr.err"
     3036                       , input ?
     3037                       , input ?
     3038                       , input v-cntxt-userid
     3039                       , input 0
     3040                       , input (if p-ph-chip-num <> ?
     3041                                then p-ph-chip-num
     3042                                else ( if v-chip-counter = 1
     3043                                       then ?
     3044                                       else varchip-code )
     3045                                )
     3046                       , output varchip-code2
     3047                   ) no-error.
     3048                   if error-status :error
     3049                   then do:
     3050                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3051                                                     ,buf_cons_trn-doc.doc-code
     3052                                                     ,p-fbr-doc-code
     3053                                                     , chr(10)
     3054                                                     , error-status:get-message(1)
     3055                                                     , return-value ).
     3056                   end.
     3057                   assign
     3058                       p-chip-num = varchip-code2
     3059                   .
     3060               end.
     3061           end.
     3062           assign
     3063               p-chip-num = varchip-code2
     3064           .
     3065       end.
     3066   end.
     3067   END PROCEDURE.
     3068   PROCEDURE fbrlib-print-del-error-message :
     3069   do
     3070   on error undo, return error
     3071   :
     3072       define variable v-user-action   as character    no-undo.
     3073       define variable v-printed       as logical      no-undo.
     3074       message
     3075           vss-workfile vss-revision vss-description
     3076           skip "Ошибка при удалении документа."
     3077           skip return-value
     3078           skip trim(error-status :get-message(1))
     3079           skip trim(error-status :get-message(2))
     3080           skip trim(error-status :get-message(3))
     3081       view-as alert-box error.
     3082       if search ("delfbr.err") <> ?
     3083       then do:
     3084         run gbl/prnfilen.w
     3085           (input  "Ошибки при удалении документа производства"
     3086           ,input  0
     3087           ,input  "delfbr.err"
     3088           ,input  7
     3089           ,output v-user-action
     3090           ,output v-printed
     3091           ).
     3092       end.
     3093   end.
     3094   END PROCEDURE.
     3095   procedure fbrlib-calc-brutto :
     3096   define input parameter p-recipe-type        as character        no-undo.
     3097   define input parameter p-netto              as decimal          no-undo.
     3098   define input parameter p-coeff-value        as decimal          no-undo.
     3099   define input parameter p-coeff-waste        as decimal          no-undo.
     3100   define input parameter p-brutto             as decimal          no-undo.
     3101   define input parameter p-calc-method        as integer          no-undo.
     3102   define output parameter p-new-netto         as decimal          no-undo.
     3103   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3104   define output parameter p-new-brutto        as decimal          no-undo.
     3105   define output parameter p-new-calc-method   as integer          no-undo.
     3106   do
     3107   on error undo, return error
     3108   :
     3109       if p-recipe-type <> 'производство':U
     3110       then do:
     3111           assign
     3112               p-new-coeff-waste = 0
     3113               p-new-calc-method = 1
     3114               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3115               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3116           .
     3117       end.
     3118       else do:
     3119           assign
     3120               p-new-calc-method = p-calc-method
     3121           .
     3122           if p-coeff-waste = 0
     3123           then do:
     3124               assign
     3125                   p-coeff-value = 0
     3126               .
     3127           end.
     3128           case p-calc-method
     3129           :
     3130               when 1
     3131               then do:
     3132                   assign
     3133                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3134                       p-new-coeff-waste   = p-coeff-waste
     3135                       p-new-brutto        = p-brutto
     3136                   .
     3137               end.
     3138               when 2
     3139               then do:
     3140                   assign
     3141                       p-new-netto         = p-netto
     3142                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3143                       p-new-brutto        = p-brutto
     3144                   .
     3145               end.
     3146               when 3
     3147               then do:
     3148                   assign
     3149                       p-new-netto         = p-netto
     3150                       p-new-coeff-waste   = p-coeff-waste
     3151                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3152                   .
     3153               end.
     3154               otherwise do:
     3155                   define variable v-yesno    as logical      no-undo.
     3156                   assign
     3157                       v-yesno = yes
     3158                   .
     3159                   message
     3160                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3161                       skip "Значение метода должно быть 1, 2 или 3."
     3162                       skip(1)
     3163                       skip "Заданное значение:" p-calc-method
     3164                       skip(1)
     3165                       skip "Установить значение метода расчета 1"
     3166                       skip "(расчет нетто по брутто и проценту потерь)?"
     3167                   view-as alert-box warning
     3168                   buttons yes-no
     3169                   title "Неверное значение метода пересчета в строках документа-производства"
     3170                   update v-yesno
     3171                   .
     3172                   if v-yesno = yes
     3173                   then do:
     3174                       assign
     3175                           p-new-calc-method   = 1
     3176                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3177                           p-new-coeff-waste   = p-coeff-waste
     3178                           p-new-brutto        = p-brutto
     3179                       .
     3180                   end.
     3181                   else do:
     3182                       message
     3183                               vss-workfile vss-revision vss-description
     3184                           skip(1)
     3185                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3186                           skip return-value
     3187                           skip trim(error-status :get-message(1))
     3188                               trim(error-status :get-message(2))
     3189                               trim(error-status :get-message(3))
     3190                       view-as alert-box error
     3191                       title "Неверное значение метода расчета"
     3192                       .
     3193                       undo, return error .
     3194                   end.
     3195               end.
     3196           end case.
     3197       end.
     3198   end.
     3199   end procedure.
     3200   procedure fbrlib-check-brutto :
     3201   define input parameter p-recipe-type        as character        no-undo.
     3202   define input parameter p-netto              as decimal          no-undo.
     3203   define input parameter p-coeff-value        as decimal          no-undo.
     3204   define input parameter p-coeff-waste        as decimal          no-undo.
     3205   define input parameter p-brutto             as decimal          no-undo.
     3206   define input parameter p-calc-method        as integer          no-undo.
     3207   define output parameter p-error-message     as character        no-undo.
     3208   define output parameter p-not-good          as logical          no-undo.
     3209   do
     3210   on error undo, return error
     3211   :
     3212       if p-recipe-type <> 'производство':U
     3213       then do:
     3214           if p-netto <> p-brutto
     3215           or p-coeff-waste <> 0
     3216           then do:
     3217               assign
     3218                   p-not-good      = yes
     3219                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3220                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3221               .
     3222           end.
     3223       end.
     3224       else do:
     3225           if p-coeff-waste = 0
     3226           then do:
     3227               assign
     3228                   p-coeff-value = 0
     3229               .
     3230           end.
     3231           case p-calc-method
     3232           :
     3233               when 1
     3234               then do:
     3235                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3236                   then do:
     3237                       assign
     3238                           p-not-good      = yes
     3239                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3240                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3241                       .
     3242                   end.
     3243               end.
     3244               when 2
     3245               then do:
     3246                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3247                   then do:
     3248                       assign
     3249                           p-not-good      = yes
     3250                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3251                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3252                       .
     3253                   end.
     3254               end.
     3255               when 3
     3256               then do:
     3257                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3258                   then do:
     3259                       assign
     3260                           p-not-good      = yes
     3261                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3262                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3263                       .
     3264                   end.
     3265               end.
     3266               otherwise do:
     3267                   assign
     3268                       p-not-good      = yes
     3269                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3270                   .
     3271               end.
     3272           end case.
     3273       end.
     3274   end.
     3275   end procedure.
     3276   procedure fbrlib-check-fbr-recipe :
     3277   define input parameter p-doc-code       as character        no-undo.
     3278   define input parameter p-recipe-code    as character        no-undo.
     3279   define output parameter p-is-correct    as logical          no-undo.
     3280       define variable v-comp-factor    as decimal      no-undo.
     3281       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3282       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3283       define buffer buf_fbr-line          for ub.fbr-line.
     3284   do
     3285   for buf_fbr-recipe
     3286     , buf_fbr-recipe-gds
     3287     , buf_fbr-line
     3288   on error undo, return error
     3289   :
     3290       assign
     3291           p-is-correct = yes
     3292       .
     3293       find first buf_fbr-recipe no-lock
     3294            where buf_fbr-recipe.doc-code    = p-doc-code
     3295              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3296       .
     3297       if not available buf_fbr-recipe then do:
     3298         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3299       end.
     3300       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3301       then do:
     3302       end.
     3303       else do:
     3304           find first buf_fbr-line no-lock
     3305                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3306                  and buf_fbr-line.is-comp     = yes
     3307                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3308                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3309                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3310                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3311           .
     3312           assign
     3313               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3314           .
     3315           recipe-line-cycle:
     3316           for each buf_fbr-recipe-gds no-lock
     3317              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3318                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3319           on error undo, return error
     3320           :
     3321               find first buf_fbr-line no-lock
     3322                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3323                      and buf_fbr-line.is-comp     = no
     3324                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3325                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3326                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3327                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3328               .
     3329               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3330               then do:
     3331                   assign
     3332                       p-is-correct = no
     3333                   .
     3334                   leave recipe-line-cycle.
     3335               end.
     3336           end.
     3337       end.
     3338   end.
     3339   end procedure.
     3340   procedure fbrlib-get-recipe-type :
     3341   define input parameter p-fbr-doc-code   as character        no-undo.
     3342   define input parameter p-recipe-code    as character        no-undo.
     3343   define output parameter p-recipe-type   as character        no-undo.
     3344       define buffer buf_recipe        for ub.recipe.
     3345       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3346   do
     3347   for buf_recipe
     3348     , buf_fbr-recipe
     3349   on error undo, return error
     3350   :
     3351       if p-fbr-doc-code = ""
     3352       then do:
     3353           find first buf_recipe no-lock
     3354                where buf_recipe.recipe-code = p-recipe-code
     3355           no-error.
     3356           if available buf_recipe
     3357           then do:
     3358               assign
     3359                   p-recipe-type = buf_recipe.recipe-type
     3360               .
     3361           end.
     3362           else do:
     3363               assign
     3364                   p-recipe-type = "":U
     3365               .
     3366           end.
     3367       end.
     3368       else do:
     3369           find first buf_fbr-recipe no-lock
     3370                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3371                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3372           no-error.
     3373           if available buf_fbr-recipe
     3374           then do:
     3375               assign
     3376                   p-recipe-type = buf_fbr-recipe.recipe-type
     3377               .
     3378           end.
     3379           else do:
     3380               assign
     3381                   p-recipe-type = "":U
     3382               .
     3383           end.
     3384       end.
     3385   end.
     3386   end procedure.
     3387   PROCEDURE calc-comp-from-ingr :
     3388   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3389   define input parameter p-fact-qnty                          as decimal      no-undo.
     3390   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3391   define output parameter p-comp-qnty                         as decimal      no-undo.
     3392       define variable v-ingr-qnty     as decimal       no-undo.
     3393       define buffer buf_i_fbr-line    for ub.fbr-line.
     3394       define buffer buf_fbr-line      for ub.fbr-line.
     3395       define buffer buf_recipe        for ub.fbr-recipe.
     3396       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3397   do
     3398   for buf_i_fbr-line
     3399     , buf_fbr-line
     3400     , buf_recipe
     3401     , buf_recipe-gds
     3402   on error undo, return error
     3403   :
     3404       find first buf_i_fbr-line no-lock
     3405            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3406       .
     3407       find first buf_recipe no-lock
     3408            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3409              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3410       no-error.
     3411       if not available buf_recipe
     3412       then do:
     3413           message
     3414                   vss-workfile vss-revision vss-description
     3415               skip "В строке производства не указан рецепт."
     3416               skip "Невозможно рассчитать количество составного товара."
     3417               skip return-value
     3418               skip trim(error-status :get-message(1))
     3419                   trim(error-status :get-message(2))
     3420                   trim(error-status :get-message(3))
     3421           view-as alert-box error.
     3422           undo, return error .
     3423       end.
     3424       if buf_recipe.recipe-type = 'альтернатива':U
     3425       then do:
     3426           for each buf_fbr-line no-lock
     3427              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3428                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3429                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3430           on error undo, return error
     3431           :
     3432               find first buf_recipe-gds no-lock
     3433                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3434                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3435                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3436                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3437                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3438               .
     3439               assign
     3440                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3441               .
     3442           end.
     3443           assign
     3444               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3445           .
     3446       end.
     3447       else do:
     3448           find first buf_recipe-gds no-lock
     3449                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3450                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3451                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3452                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3453                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3454           .
     3455           assign
     3456               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3457           .
     3458       end.
     3459       find first buf_fbr-line no-lock
     3460            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3461              and buf_fbr-line.is-comp     = yes
     3462              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3463       .
     3464       assign
     3465           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3466       .
     3467   end.
     3468   END PROCEDURE.
     3469   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3470   define input parameter p-recipe-code    as character    no-undo.
     3471   define input parameter p-gds-code       as integer      no-undo.
     3472   define output parameter p-line-qnty     as decimal      no-undo.
     3473   define output parameter p-used-qnty     as decimal      no-undo.
     3474   define output parameter p-recipe-qnty   as decimal      no-undo.
     3475       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3476   do
     3477   for buf_temp_dressing-ingr
     3478   on error undo, return error
     3479   :
     3480       find first buf_temp_dressing-ingr no-lock
     3481            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3482              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3483       no-error.
     3484       if available buf_temp_dressing-ingr
     3485       then do:
     3486           assign
     3487               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3488               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3489               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3490           .
     3491       end.
     3492       else do:
     3493           assign
     3494               p-line-qnty     = 0
     3495               p-used-qnty     = 0
     3496               p-recipe-qnty   = 0
     3497           .
     3498       end.
     3499   end.
     3500   END PROCEDURE.
     3501   PROCEDURE fbrlib_adjust-recipe :
     3502   do
     3503   on error undo, return error
     3504   :
     3505   define input parameter parparentproc as widget-handle no-undo .
     3506   define input parameter p-fbrhist-handle as handle no-undo .
     3507   define input parameter p-doc-code       as character    no-undo.
     3508   define input parameter p-recipe-code    as character    no-undo.
     3509   define input parameter p-price-sale-obj-type as character no-undo .
     3510   define input parameter p-price-sale-obj-code as integer no-undo .
     3511       define variable v-recipe-qnty       as decimal      no-undo.
     3512       define variable v-comp-qnty         as decimal      no-undo.
     3513       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3514       define variable v-ingr-qnty         as decimal      no-undo.
     3515       define variable v-qnty              as decimal      no-undo.
     3516       define variable v-coeff-waste       as decimal      no-undo.
     3517       define variable v-brutto-qnty       as decimal      no-undo.
     3518       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3519       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3520       define buffer buf_fbr-line          for ub.fbr-line.
     3521       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3522       find first buf_fbr-recipe no-lock
     3523            where buf_fbr-recipe.doc-code      = p-doc-code
     3524              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3525       .
     3526       assign
     3527           v-recipe-qnty = buf_fbr-recipe.qnty
     3528       .
     3529       find first buf_fbr-line no-lock
     3530            where buf_fbr-line.doc-code    = p-doc-code
     3531              and buf_fbr-line.is-comp     = yes
     3532              and buf_fbr-line.recipe-code = p-recipe-code
     3533       .
     3534       assign
     3535           v-comp-qnty = buf_fbr-line.fact-qnty
     3536       .
     3537       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3538       then do:
     3539       end.
     3540       else do:
     3541           for each buf_fbr-recipe-gds no-lock
     3542              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3543                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3544           on error undo, return error
     3545           :
     3546               find first buf_fbr-line no-lock
     3547                    where buf_fbr-line.doc-code    = p-doc-code
     3548                      and buf_fbr-line.is-comp     = no
     3549                      and buf_fbr-line.recipe-code = p-recipe-code
     3550                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3551                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3552                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3553               .
     3554               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3555               then do:
     3556                   do transaction
     3557                   on error undo, return error
     3558                   :
     3559                       find first buf_el_fbr-recipe-gds exclusive-lock
     3560                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3561                       .
     3562                       assign
     3563                           buf_el_fbr-recipe-gds.calc-method   = 1
     3564                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3565                       .
     3566                       run fbrlib-calc-brutto in this-procedure (
     3567                             input buf_fbr-recipe.recipe-type
     3568                           , input 0
     3569                           , input buf_el_fbr-recipe-gds.coeff-value
     3570                           , input buf_el_fbr-recipe-gds.coeff-waste
     3571                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3572                           , input 1
     3573                           , output buf_el_fbr-recipe-gds.qnty
     3574                           , output buf_el_fbr-recipe-gds.coeff-waste
     3575                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3576                           , output buf_el_fbr-recipe-gds.calc-method
     3577                       ).
     3578                   end.
     3579               end.
     3580           end.
     3581           run fbrlib_adjust-doc-lines in this-procedure (
     3582                 input parparentproc
     3583               , input p-fbrhist-handle
     3584               , input p-doc-code
     3585               , input p-recipe-code
     3586               , input p-price-sale-obj-type
     3587               , input p-price-sale-obj-code
     3588           ).
     3589       end.
     3590   end.
     3591   END PROCEDURE.
     3592   PROCEDURE fbrlib_adjust-doc-lines :
     3593   define input parameter parparentproc as widget-handle no-undo .
     3594   define input parameter p-fbrhist-handle as handle no-undo .
     3595   define input parameter p-doc-code       as character    no-undo.
     3596   define input parameter p-recipe-code    as character    no-undo.
     3597   define input parameter p-price-sale-obj-type as character no-undo .
     3598   define input parameter p-price-sale-obj-code as integer no-undo .
     3599   define variable v-comp-qnty         as decimal      no-undo.
     3600   define variable v-trn-type          as character    no-undo.
     3601   define variable v-ingr-qnty         as decimal      no-undo.
     3602   define variable v-recipe-qnty       as decimal      no-undo.
     3603   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3604   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3605   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3606   define buffer buf_fbr-line          for ub.fbr-line.
     3607   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3608   define buffer buf_goods             for ub.goods.
     3609   define buffer buf_fbr-doc           for ub.fbr-doc.
     3610   do
     3611   for buf_fbr-recipe
     3612     , buf_fbr-recipe-gds
     3613     , buf_fbr-line
     3614     , buf_coeff_fbr-line
     3615     , buf_goods
     3616     , buf_fbr-doc
     3617   on error undo, return error
     3618   :
     3619       find first buf_fbr-line no-lock
     3620            where buf_fbr-line.doc-code      = p-doc-code
     3621              and buf_fbr-line.is-comp       = yes
     3622              and buf_fbr-line.recipe-code   = p-recipe-code
     3623       .
     3624       find first buf_fbr-doc no-lock
     3625            where buf_fbr-doc.doc-code      = p-doc-code
     3626       .
     3627       assign
     3628           v-comp-qnty = buf_fbr-line.fact-qnty
     3629           v-trn-type  = buf_fbr-line.trn-type
     3630       .
     3631       find first buf_fbr-recipe no-lock
     3632            where buf_fbr-recipe.doc-code    = p-doc-code
     3633              and buf_fbr-recipe.recipe-code = p-recipe-code
     3634       .
     3635       assign
     3636       v-recipe-qnty = buf_fbr-recipe.qnty
     3637       .
     3638       do transaction
     3639       on error undo, return error
     3640       :
     3641           for each buf_fbr-recipe-gds no-lock
     3642              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3643                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3644           on error undo, return error
     3645           :
     3646               find first buf_fbr-line no-lock
     3647                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3648                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3649                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3650                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3651                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3652               no-error.
     3653               if not available buf_fbr-line
     3654               then do:
     3655                   find first buf_goods no-lock
     3656                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3657                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3658                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3659                   .
     3660                   run str/fbr-crln.p (
     3661                         input parparentproc
     3662                       , input recid( buf_fbr-doc )
     3663                       , input recid( buf_goods )
     3664                       , input buf_fbr-recipe-gds.recipe-code
     3665                       , input v-trn-type
     3666                       , input no
     3667                       , input no
     3668                       , input buf_fbr-doc.obj-type
     3669                       , input buf_fbr-doc.obj-code
     3670                       , output v-fbr-v-fbr-doc-line-recid
     3671                   ).
     3672                   find first buf_fbr-line no-lock
     3673                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3674                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3675                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3676                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3677                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3678                   no-error.
     3679                   if not available buf_fbr-line
     3680                   then do:
     3681                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3682                                                      , p-doc-code
     3683                                                      , buf_fbr-recipe-gds.artic
     3684                                                      , buf_fbr-recipe-gds.prod-type
     3685                                                      , buf_fbr-recipe-gds.prod-code).
     3686                   end.
     3687               end.
     3688               find first buf_coeff_fbr-line exclusive-lock
     3689                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3690               .
     3691               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3692               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3693               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3694               then do:
     3695                   assign
     3696                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3697                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3698                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3699                   .
     3700               end.
     3701           end.
     3702       end.
     3703       define variable v-need-goods    as logical       no-undo.
     3704       define variable v-need-goods-list       as character     no-undo.
     3705       define variable v-need-goods-qnty-list  as character     no-undo.
     3706       find first buf_fbr-line no-lock
     3707            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3708              and buf_fbr-line.is-comp     = yes
     3709              and buf_fbr-line.recipe-code = p-recipe-code
     3710       .
     3711       run str/fbr-qnty.p (
     3712             input parparentproc
     3713           , input p-fbrhist-handle
     3714           , input recid( buf_fbr-doc )
     3715           , input recid( buf_fbr-line )
     3716           , input no
     3717           , input "ingr"
     3718           , input no
     3719           , input p-price-sale-obj-type
     3720           , input p-price-sale-obj-code
     3721           , input no
     3722           , input no
     3723           , input no
     3724           , output v-need-goods
     3725           , output v-need-goods-list
     3726           , output v-need-goods-qnty-list
     3727       ).
     3728   end.
     3729   END PROCEDURE.
     3730   procedure fbrlib_check-before-close :
     3731   define input parameter p-doc-code as character no-undo .
     3732   define variable same-sale as decimal no-undo .
     3733   define variable is-waste as logical no-undo .
     3734   define variable fix-price as logical no-undo .
     3735   define buffer buf_fbr-doc for ub.fbr-doc.
     3736   define buffer buf_fbr-line for ub.fbr-line.
     3737   define buffer buf_goods for ub.goods.
     3738   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3739   do
     3740   on error undo, return error
     3741   :
     3742     for each buf_fbr-line no-lock
     3743         where buf_fbr-line.doc-code = p-doc-code
     3744       , each buf_goods no-lock
     3745         where buf_goods.artic     = buf_fbr-line.artic
     3746           and buf_goods.prod-type = buf_fbr-line.prod-type
     3747           and buf_goods.prod-code = buf_fbr-line.prod-code
     3748     break by buf_fbr-line.prod-type
     3749           by buf_fbr-line.prod-code
     3750           by buf_fbr-line.artic
     3751     :
     3752       if first-of (buf_fbr-line.artic)
     3753       then do:
     3754         assign
     3755         same-sale = buf_fbr-line.price-sale
     3756         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3757         fix-price = buf_fbr-line.is-calc
     3758         .
     3759       end.
     3760       if same-sale <> buf_fbr-line.price-sale
     3761       then do:
     3762           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3763                                         ,p-doc-code
     3764                                         ,buf_goods.artic
     3765                                         ,buf_goods.gds-name
     3766                                         ,chr(10)).
     3767       end.
     3768       if fix-price <> buf_fbr-line.is-calc then do:
     3769           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3770                                         ,p-doc-code
     3771                                         ,buf_goods.artic
     3772                                         ,buf_goods.gds-name
     3773                                         ,chr(10)).
     3774       end.
     3775       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3776       then do:
     3777         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     3778                                         ,p-doc-code
     3779                                         ,buf_goods.artic
     3780                                         ,buf_goods.gds-name
     3781                                         ,chr(10)).
     3782       end.
     3783       if buf_fbr-line.rsrv-qnty <> ?
     3784       and buf_goods.gds-type <> 'у':U
     3785       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     3786       and buf_fbr-line.fact-qnty <> 0
     3787       then do:
     3788         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     3789           if  can-find(first buf_fbr-gds-obj no-lock where
     3790                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3791               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     3792               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     3793               and buf_fbr-gds-obj.is-null-price  )  then .
     3794                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3795                                         ,p-doc-code
     3796                                         ,buf_goods.artic
     3797                                         ,buf_goods.gds-name
     3798                                         ,chr(10)
     3799                                         ,buf_fbr-line.recipe-code
     3800                                         ).
     3801         end.
     3802         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3803                                         ,p-doc-code
     3804                                         ,buf_goods.artic
     3805                                         ,buf_goods.gds-name
     3806                                         ,chr(10)
     3807                                         ,buf_fbr-line.recipe-code
     3808                                         ).
     3809       end.
     3810     end.
     3811   end.
     3812   end procedure.
     3813   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3814   define new global shared variable g#trdcalib as handle no-undo.
     3815   define variable vss-include-info32 as character format "X(65)" no-undo
     3816   initial "@(#)$Workfile$ $Revision$".
     3817   procedure fbrattr-write :
     3818     define input parameter p-doc-type       as character        no-undo.
     3819     define input parameter p-doc-code       as character        no-undo.
     3820     define input parameter p-attr-code      as character        no-undo.
     3821     define input parameter p-attr-value     as character        no-undo.
     3822     do
     3823     on error undo, return error
     3824     :
     3825   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input substitute('&1-&2',p-doc-type,p-doc-code) ,
     3826                          input p-attr-code ,
     3827                          input p-attr-value )  .
     3828     end.
     3829   end procedure.
     3830   procedure fbrattr-value :
     3831     define  input parameter p-doc-type      as character        no-undo.
     3832     define  input parameter p-doc-code      as character        no-undo.
     3833     define  input parameter p-attr-code     as character        no-undo.
     3834     define output parameter p-attr-value    as character        no-undo.
     3835     define variable v-par-value     as character    no-undo.
     3836     define variable v-par-type      as character    no-undo.
