     6156           or error-status :get-message(1) <> ""
     6157           then do:
     6158             undo move_block, retry move_block .
     6159           end.
     6160         end.
     6161         assign
     6162           frame d-fbr-docs :height = frame d-fbr-docs :height + p-change-value
     6163           no-error .
