     6192         on error undo move_block, retry move_block
     6193         :
     6194           assign
     6195             v-object-handle = buf_temp-diasize-handle.handle-value
     6196           .
     6197           if v-object-handle <> v-diasize-resize-button
     6198           then do:
     6199             assign
     6200               v-object-handle :row = v-object-handle :row + p-change-value
     6201               no-error .
     6202             if error-status :error
     6203             or error-status :get-message(1) <> ""
     6204             then do:
     6205               undo move_block, retry move_block .
