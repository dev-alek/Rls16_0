     1963   procedure clcprtsl_calc-ttable :
     1964   define input parameter paris-doc           as   logical                 no-undo.
     1965   define input parameter paris-cur           as   logical                 no-undo.
     1966   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     1967   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     1968   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     1969   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     1970   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     1971   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     1972   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     1973   define input parameter parr-b              as   character               no-undo.
     1974   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     1975   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     1976   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     1977   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     1978   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     1979   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     1980   define buffer bf_tt-allsum      for tt-allsum.
     1981   define buffer bf_tt-clcparts    for tt-clcparts.
     1982   define buffer bf_tt-allsum-line for tt-allsum-line.
     1983   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1984   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1985   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1986   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1987   define variable varexcise          like ub.price-list.excise     no-undo.
     1988   do on error undo, return error return-value :
     1989   for each bf_tt-allsum-line
     1990   on error undo, return error return-value
     1991    :
     1992     delete bf_tt-allsum-line.
     1993   end.
     1994   for each bf_tt-allsum
     1995   on error undo, return error return-value
     1996   :
     1997     delete bf_tt-allsum.
     1998   end.
     1999   for each bf_tt-clcparts
     2000   on error undo, return error return-value
     2001   :
     2002   if v-calcbypart then do:
     2003             assign
     2004             parcur-base =   bf_tt-clcparts.part-cur-base
     2005             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2006             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2007             .
     2008   end.
     2009      run clcprtsl_calc-parts in this-procedure (
     2010        input recid(bf_tt-clcparts),
     2011        input paris-doc,
     2012        input paris-cur,
     2013        input parroad-tax,
     2014        input parexcise,
     2015        input parvat-pc,
     2016        input parcons-vat-pc,
     2017        input parslt-pc,
     2018        input parbase-rate,
     2019        input parbase-scale,
     2020        input parr-b,
     2021        input parcur-base,
     2022        input parcur-road-tax,
     2023        input parcur-excise,
     2024        input parcur-vat-pc,
     2025        input parcurcons-vat-pc,
     2026        input parcurslt-pc
     2027        ) no-error.
     2028     if error-status:error then do:
     2029       message
     2030         vss-workfile vss-revision vss-description skip
     2031         vss-include-info0 skip
     2032         "Ошибка при обсчете партии" skip
     2033         "Документ партии " bf_tt-clcparts.out-code skip
     2034         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2035         return-value skip
     2036         error-status:get-message(1) skip
     2037         error-status:get-message(2) skip
     2038         error-status:get-message(3) skip
     2039         view-as alert-box error .
     2040       undo, return error .
     2041     end.
     2042     for each bf_tt-allsum on error undo, return error return-value :
     2043       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2044       if not available bf_tt-allsum-line then do:
     2045         create bf_tt-allsum-line.
     2046         assign
     2047           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2048       end.
     2049       assign
     2050         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2051         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2052         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2053         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2054         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
