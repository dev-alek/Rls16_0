     2412     (input  p-obj-type
     2413     ,input  p-obj-code
     2414     ,output v-host-code
     2415     )  .
     2416   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2418     (input  p-obj-type
     2419     ,input  p-obj-code
     2420     ,output v-obj-db-num
     2421     )  .
     2422   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2424     (output v-db-num
     2425     )  .
     2426   if v-obj-db-num <> v-db-num then do:
     2427     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     2428                             , chr(10)
     2429                             , p-obj-type
     2430                             , p-obj-code
     2431                             , v-obj-db-num
     2432                             , v-db-num).
     2433   end.
     2434   run cur-time in this-procedure ( output v-today, output v-time).
     2435   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2436   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2437     (input  p-obj-type
     2438     ,input  p-obj-code
     2439     ,output v-today
     2440     )  .
     2441   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2443     (input  v-host-code
     2444     ,output v-base-code
     2445     )  .
     2446   find last buf_curr-accnt no-lock
     2447       where buf_curr-accnt.curr-code = v-base-code
     2448         and buf_curr-accnt.exch-date <= v-today use-index pi
     2449   no-error.
     2450   if not available buf_curr-accnt
     2451   then do:
     2452     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     2453                                     , string(v-today, "99/99/9999")
     2454                                     , v-base-code).
     2455   end.
     2456   run doc-code in this-procedure (
     2457         input  "main"
     2458       , input  p-obj-type
     2459       , input  p-obj-code
     2460       , input  ?
     2461       , output v-doc-code
     2462   ) no-error.
     2463   if error-status:error
     2464   then do:
     2465     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     2466                                   , chr(10)
     2467                                   , error-status:get-message(1)
     2468                                   , return-value ).
     2469   end.
     2470   run trg/chkdocnm.p (
     2471         input v-doc-code
     2472       , input 'fbr-doc':U
     2473       , input ?
     2474   ) no-error.
     2475   if error-status:error
     2476   then do:
     2477     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     2478                                   , chr(10)
     2479                                   , error-status:get-message(1)
     2480                                   , return-value ).
     2481   end.
     2482   create buf_fbr-doc.
     2483   assign
     2484   buf_fbr-doc.doc-code  = v-doc-code
     2485   buf_fbr-doc.creid     = p-userid
     2486   buf_fbr-doc.doc-date  = v-today
     2487   buf_fbr-doc.doc-type  = 'производство':U
     2488   buf_fbr-doc.host-code = v-host-code
     2489   buf_fbr-doc.obj-code  = p-obj-code
     2490   buf_fbr-doc.obj-type  = p-obj-type
     2491   buf_fbr-doc.PS        = "@"
     2492   buf_fbr-doc.status_   = 'новый':U
     2493   buf_fbr-doc.user-db-num = v-obj-db-num
     2494   buf_fbr-doc.user-name   = p-userid
     2495   .
     2496   run fbrlib_get-default-pay-code in this-procedure (
     2497         input buf_fbr-doc.obj-type
     2498       , input buf_fbr-doc.obj-code
     2499       , output fi-pay-code
     2500   ).
     2501   buf_fbr-doc.pay-code = fi-pay-code.
     2502   p-recid = recid(buf_fbr-doc).
     2503   p-fbr-doc-code = buf_fbr-doc.doc-code.
     2504   end.
     2505   end procedure.
     2506   procedure fbrlib_get-default-pay-code :
     2507   define input parameter p-obj-type   as character        no-undo.
     2508   define input parameter p-obj-code   as integer          no-undo.
     2509   define output parameter p-pay-code  as integer          no-undo.
     2510   define variable v-host-code as integer no-undo .
     2511   define buffer buf_shop          for ub.shop.
     2512   define buffer buf_store         for ub.store.
     2513   define buffer buf_sysconf       for ub.sysconf.
     2514   do
     2515   for buf_shop
     2516     , buf_store
     2517     , buf_sysconf
     2518   on error undo, return error
     2519   :
     2520     case p-obj-type  :
     2521       when 'маг':U then do:
     2522           find first buf_shop no-lock
     2523                 where buf_shop.obj-code = p-obj-code
     2524           no-error.
     2525           if available buf_shop
     2526           then do:
     2527               assign
     2528                   p-pay-code = buf_shop.fbr-pay
     2529               .
     2530           end.
     2531       end.
     2532       when 'скл':U then do:
     2533           find first buf_store no-lock
     2534                 where buf_store.obj-code = p-obj-code
     2535           no-error.
     2536           if available buf_store
     2537           then do:
     2538               assign
     2539                   p-pay-code = buf_store.fbr-pay
     2540               .
     2541           end.
     2542       end.
     2543     end case.
     2544     if p-pay-code = ?
     2545     or p-pay-code = 0
     2546     then do:
     2547   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2549     (input  p-obj-type
     2550     ,input  p-obj-code
     2551     ,output v-host-code
     2552     )  .
     2553         find first buf_sysconf no-lock
     2554               where buf_sysconf.host-code = v-host-code
     2555         no-error.
     2556         if available buf_sysconf
     2557         then do:
     2558             assign
     2559                 p-pay-code = buf_sysconf.fbr-pay
     2560             .
     2561         end.
     2562     end.
     2563     if p-pay-code = ?
     2564     or p-pay-code = 0
     2565     then do:
     2566   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     2568     (input  p-obj-type
     2569     ,input  p-obj-code
     2570     ,output p-pay-code
     2571     )  .
     2572     end.
     2573   end.
     2574   end procedure.
     2575   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     2576   do
     2577   on error undo, return error
     2578   :
     2579   define input parameter p-fbr-doc-code as character    no-undo.
     2580       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     2581       define variable v-gds-name      as character    no-undo.
     2582       define buffer buf_fbr-doc               for ub.fbr-doc.
     2583       define buffer buf_fbr-line              for ub.fbr-line.
     2584       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2585       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2586       find first buf_fbr-doc no-lock
     2587            where buf_fbr-doc.doc-code = p-fbr-doc-code
     2588       .
     2589       for each buf_temp_fbrlib_recipe
     2590       :
     2591           delete buf_temp_fbrlib_recipe.
     2592       end.
     2593       for each buf_fbr-line no-lock
     2594          where buf_fbr-line.doc-code = p-fbr-doc-code
     2595       :
     2596           find first buf_temp_fbrlib_recipe
     2597                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2598           no-error.
     2599           if not available buf_temp_fbrlib_recipe
     2600           then do:
     2601               create buf_temp_fbrlib_recipe.
     2602               assign
     2603                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2604                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     2605               .
     2606           end.
     2607       end.
     2608       for each buf_temp_fbrlib_recipe
     2609       :
     2610           assign
     2611               buf_temp_fbrlib_recipe.count-income                = 0
     2612               buf_temp_fbrlib_recipe.qnty-income                 = 0
     2613               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     2614               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     2615               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     2616               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     2617               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     2618               buf_temp_fbrlib_recipe.count-write-off             = 0
     2619               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     2620               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     2621               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     2622               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     2623               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     2624               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     2625           .
     2626           for each buf_fbr-line no-lock
     2627              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2628                and buf_fbr-line.trn-type     = 'при':U
     2629                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2630           :
     2631               if ( buf_fbr-line.price-base   = ?
     2632                   or buf_fbr-line.price-rubl = ?
     2633                   or buf_fbr-line.price-base <= 0
     2634                   or buf_fbr-line.price-rubl <= 0 )
     2635               and buf_fbr-line.fact-qnty <> 0
     2636               and buf_fbr-line.rsrv-qnty <> ?
     2637               and buf_fbr-doc.is-free    = no
     2638               then do:
     2639   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2641     (input  buf_fbr-line.artic
     2642     ,input  buf_fbr-line.prod-type
     2643     ,input  buf_fbr-line.prod-code
     2644     ,output v-gds-name
     2645     ) no-error .
     2646                   if error-status :error
     2647                   then do:
     2648                       assign
     2649                           v-gds-name = ""
     2650                       .
     2651                   end.
     2652                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2653                                                 ,vss-description
     2654                                                 ,buf_fbr-doc.doc-code
     2655                                                 ,chr(10)
     2656                                                 ,buf_fbr-line.recipe-code
     2657                                                 ,buf_fbr-line.artic
     2658                                                 ,v-gds-name).
     2659               end.
     2660               assign
     2661                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     2662                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     2663                                                                   + buf_fbr-line.fact-qnty
     2664                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     2665                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2666               .
     2667               if buf_fbr-line.is-waste = no
     2668               then do:
     2669                   assign
     2670                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     2671                                                                       + buf_fbr-line.price-sum-base
     2672                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2673                                                                       + buf_fbr-line.price-sum-rubl
     2674                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2675                                                                       + buf_fbr-line.price-sum-vat-base
     2676                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2677                                                                       + buf_fbr-line.price-sum-vat-rubl
     2678                   .
     2679               end.
     2680           end.
     2681           for each buf_fbr-line no-lock
     2682              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2683                and buf_fbr-line.trn-type     = 'спи':U
     2684                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2685           :
     2686               if ( buf_fbr-line.price-base   = ?
     2687                   or buf_fbr-line.price-rubl = ?
     2688                   or buf_fbr-line.price-base <= 0
     2689                   or buf_fbr-line.price-rubl <= 0 )
     2690               and buf_fbr-line.fact-qnty <> 0
     2691               and buf_fbr-line.rsrv-qnty <> ?
     2692               and buf_fbr-doc.is-free    = no
     2693               and buf_fbr-doc.status_    = 'разрешен':U
     2694               then do:
     2695   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2697     (input  buf_fbr-line.artic
     2698     ,input  buf_fbr-line.prod-type
     2699     ,input  buf_fbr-line.prod-code
     2700     ,output v-gds-name
     2701     ) no-error .
     2702                   if error-status :error
     2703                   then do:
     2704                       assign
     2705                           v-gds-name = ""
     2706                       .
     2707                   end.
     2708                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2709                                                 ,vss-description
     2710                                                 ,buf_fbr-doc.doc-code
     2711                                                 ,chr(10)
     2712                                                 ,buf_fbr-line.recipe-code
     2713                                                 ,buf_fbr-line.artic
     2714                                                 ,v-gds-name).
     2715               end.
     2716               assign
     2717                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     2718                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     2719                                                                   + buf_fbr-line.fact-qnty
     2720                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     2721                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2722               .
     2723               if buf_fbr-line.is-waste = no
     2724               then do:
     2725                   assign
     2726                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2727                                                                       + buf_fbr-line.price-sum-base
     2728                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2729                                                                       + buf_fbr-line.price-sum-rubl
     2730                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2731                                                                       + buf_fbr-line.price-sum-vat-base
     2732                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2733                                                                       + buf_fbr-line.price-sum-vat-rubl
     2734                   .
     2735               end.
     2736           end.
     2737           if buf_fbr-doc.status_    = 'разрешен':U
     2738           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2739           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2740           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2741           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2742               )
     2743           then do:
     2744            undo, return error
     2745               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2746                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2747                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2748                           "Сумма в &9.&4&7&4&4&8&2"
     2749                          , buf_fbr-doc.doc-code
     2750                          , chr(10)
     2751                          , buf_temp_fbrlib_recipe.recipe-code
     2752                          , chr(9)
     2753                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2754                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2755                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2756                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2757                          , "руб"
     2758                          )
     2759              +
     2760              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2761                         "НДС в &7.&1&5&1&1&6&4"
     2762                        ,  chr(9)
     2763                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2764                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2765                        ,chr(10)
     2766                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2767                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2768                        ,"руб"
     2769                        )       .
     2770           end.
     2771       end.
     2772   end.
     2773   end procedure.
     2774   procedure fbrlib-fill-sum-fbr-doc :
     2775   do
     2776   on error undo, return error
     2777   :
     2778   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2779   define input parameter p-mode           as character    no-undo.
     2780       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2781       define buffer buf_fbr-doc           for ub.fbr-doc.
     2782       define buffer buf_fbr-line          for ub.fbr-line.
     2783       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2784       define variable v-in-count          as integer       no-undo.
     2785       define variable v-out-count         as integer       no-undo.
     2786       find first buf_fbr-doc exclusive-lock
     2787            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2788       .
     2789       find first buf_temp_fbrlib_recipe no-error.
     2790       if not available buf_temp_fbrlib_recipe
     2791       then do:
     2792           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2793               input buf_fbr-doc.doc-code
     2794           ) no-error.
     2795           if error-status :error
     2796           then do:
     2797               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2798                                              , vss-description
     2799                                              , chr(10)
     2800                                              , error-status:get-message(1)
     2801                                              , return-value ).
     2802           end.
     2803       end.
     2804       assign
     2805           v-in-count                  = 0
     2806           buf_fbr-doc.in-qnty         = 0
     2807           buf_fbr-doc.in-sale         = 0
     2808           buf_fbr-doc.in-base         = 0
     2809           buf_fbr-doc.in-rubl         = 0
     2810           buf_fbr-doc.in-vat-base     = 0
     2811           buf_fbr-doc.in-vat-rubl     = 0
     2812           v-out-count                 = 0
     2813           buf_fbr-doc.out-qnty        = 0
     2814           buf_fbr-doc.out-sale        = 0
     2815           buf_fbr-doc.out-base        = 0
     2816           buf_fbr-doc.out-rubl        = 0
     2817           buf_fbr-doc.out-vat-base    = 0
     2818           buf_fbr-doc.out-vat-rubl    = 0
     2819       .
     2820       for each buf_temp_fbrlib_recipe
     2821       :
     2822           assign
     2823               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2824               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2825               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2826               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2827               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2828               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2829               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2830               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2831               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2832               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2833               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2834               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2835               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2836               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2837           .
     2838       end.
     2839       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2840       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2841       or p-mode <> 'факт':U
     2842       then do:
     2843           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2844           then do:
     2845               assign
     2846                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2847                                   + string( v-out-count, ">>>,>>9" )
     2848                                   + chr(10) + "Строк исходных товаров : "
     2849                                   + string( v-in-count, ">>>,>>9" )
     2850               .
     2851           end.
     2852       end.
     2853       else do:
     2854         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2855                                       "Сумма списанных товаров в &3 - &4&2" +
     2856                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2857                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2858                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2859                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2860                                       , buf_fbr-doc.doc-code
     2861                                       , chr(10)
     2862                                       , "рублях"
     2863                                       , round( buf_fbr-doc.out-rubl, 2 )
     2864                                       , round( buf_fbr-doc.in-rubl,  2 )
     2865                                       , round( buf_fbr-doc.in-rubl,  2 )
     2866                                       , round( buf_fbr-doc.out-base, 2 )
     2867                                       , round( buf_fbr-doc.in-base,  2 )).
     2868       end.
     2869   end.
     2870   end procedure.
     2871   procedure fbrlib-calc-prices :
     2872   do
     2873   on error undo, return error
     2874   :
     2875   define input parameter p-fbr-line-recid as recid        no-undo.
     2876   define input parameter p-price-obj-type as character    no-undo.
     2877   define input parameter p-price-obj-code as integer      no-undo.
     2878   define output parameter p-current-price as decimal      no-undo.
     2879       define variable v-void          as decimal       no-undo.
     2880       define variable v-void-char     as character     no-undo.
     2881       define variable v-gds-code      as integer       no-undo.
     2882       define variable v-b-code        as integer       no-undo.
     2883       define buffer buf_fbr-doc   for ub.fbr-doc.
     2884       define buffer buf_fbr-line  for ub.fbr-line.
     2885       define buffer buf_gds-prt   for ub.gds-prt.
     2886       define buffer buf_bar-code  for ub.bar-code.
     2887       find first buf_fbr-line no-lock
     2888           where recid( buf_fbr-line ) = p-fbr-line-recid
     2889       .
     2890   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2891   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2892     (input  buf_fbr-line.artic
     2893     ,input  buf_fbr-line.prod-type
     2894     ,input  buf_fbr-line.prod-code
     2895     ,output v-gds-code
     2896     ) no-error .
     2897       if error-status :error
     2898       then do:
     2899         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2900                                         ,vss-workfile
     2901                                         ,vss-revision
     2902                                         ,vss-description
     2903                                         ,chr(10)
     2904                                         , error-status:get-message(1)
     2905                                         , return-value
     2906                                         , buf_fbr-line.artic
     2907                                         ).
     2908       end.
     2909   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2910     (input  v-gds-code
     2911     ,input  ?
     2912     ,output v-b-code
     2913     ) no-error .
     2914       if error-status :error
     2915       then do:
     2916         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2917                                         ,vss-workfile
     2918                                         ,vss-revision
     2919                                         ,vss-description
     2920                                         ,chr(10)
     2921                                         , error-status:get-message(1)
     2922                                         , return-value
     2923                                         , v-gds-code
     2924                                         ).
     2925       end.
     2926       if buf_fbr-line.is-calc = no
     2927       then do:
     2928   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2929   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2930     (input  p-price-obj-type
     2931     ,input  p-price-obj-code
     2932     ,input  v-b-code
     2933     ,input  0
     2934     ,input  0
     2935     ,output v-void-char
     2936     ,output p-current-price
     2937     ,output v-void
     2938     ,output v-void
     2939     ) no-error .
     2940           if error-status :error
     2941           then do:
     2942             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2943                                             ,vss-workfile
     2944                                             ,vss-revision
     2945                                             ,vss-description
     2946                                             ,chr(10)
     2947                                             , error-status:get-message(1)
     2948                                             , return-value
     2949                                             , v-gds-code
     2950                                             ).
     2951           end.
     2952       end.
     2953       else do:
     2954           assign
     2955               p-current-price = buf_fbr-line.price-sale
     2956           .
     2957       end.
     2958   end.
     2959   end procedure.
     2960   procedure fbrlib-put-in-order-recipe :
     2961   do
     2962   on error undo, return error
     2963   :
     2964   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2965       define variable v-recipe-counter    as integer          no-undo.
     2966       define variable v-recipe-amount     as integer init 0   no-undo.
     2967       define variable v-child-counter     as integer          no-undo.
     2968       define variable v-is-call-cycle     as logical          no-undo.
     2969       define variable v-str as character     no-undo.
     2970       define buffer buf_in_fbr-line       for ub.fbr-line.
     2971       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2972       define buffer buf_fbr-line          for ub.fbr-line.
     2973       define buffer buf_recipe-gds        for ub.recipe-gds.
     2974       define buffer buf_recipe            for ub.recipe.
     2975       for each temp_recipe-childs-qnty
     2976       :
     2977           delete temp_recipe-childs-qnty.
     2978       end.
     2979       for each temp_recipe-childs
     2980       :
     2981           delete temp_recipe-childs.
     2982       end.
     2983       for each temp_recipe-order
     2984       :
     2985           delete temp_recipe-order.
     2986       end.
     2987       for each buf_fbr-line no-lock
     2988          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2989       on error undo, return error
     2990       :
     2991           find first temp_recipe-childs-qnty
     2992                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2993           no-error.
     2994           if not available temp_recipe-childs-qnty
     2995           then do:
     2996               create temp_recipe-childs-qnty.
     2997               assign
     2998                   v-recipe-amount                     = v-recipe-amount + 1
     2999                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     3000                   temp_recipe-childs-qnty.order       = v-recipe-amount
     3001                   temp_recipe-childs-qnty.childs-qnty = 0
     3002                   v-child-counter                     = 0
     3003               .
     3004           end.
     3005       end.
     3006       for each buf_in_fbr-line no-lock
     3007          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     3008            and buf_in_fbr-line.trn-type = 'спи':U
     3009       on error undo, return error
     3010       :
     3011           for each buf_dress_fbr-line no-lock
     3012              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     3013                and buf_dress_fbr-line.trn-type    = 'при':U
     3014                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     3015                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     3016                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     3017           on error undo, return error
     3018           :
     3019               find first buf_recipe no-lock
     3020                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     3021               .
     3022               if buf_in_fbr-line.is-comp = yes
     3023               then do:
     3024                   find last temp_recipe-childs-qnty
     3025                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     3026                   .
     3027                   assign
     3028                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     3029                   .
     3030                   create temp_recipe-childs.
     3031                   assign
     3032                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     3033                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     3034                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     3035                   .
     3036               end.
     3037               else do:
     3038               end.
     3039           end.
     3040       end.
     3041       for each buf_in_fbr-line no-lock
     3042          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     3043            and buf_in_fbr-line.trn-type = 'при':U
     3044       on error undo, return error
     3045       :
     3046           find first buf_recipe no-lock
     3047                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     3048           no-error.
     3049           if buf_in_fbr-line.is-comp = no
     3050           then do:
     3051           end.
     3052           else do:
     3053               for each buf_recipe-gds no-lock
     3054               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     3055               :
     3056                   for each buf_fbr-line no-lock
     3057                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     3058                       and buf_fbr-line.trn-type    = 'при':U
     3059                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     3060                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     3061                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     3062                   on error undo, return error
     3063                   :
     3064                       find first buf_recipe no-lock
     3065                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     3066                       .
     3067                       if buf_recipe.recipe-type = 'разделка':U
     3068                       then do:
     3069                       end.
     3070                       else do:
     3071                           find last temp_recipe-childs-qnty
     3072                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     3073                           .
     3074                           assign
     3075                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     3076                           .
     3077                           create temp_recipe-childs.
     3078                           assign
     3079                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     3080                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     3081                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     3082                           .
     3083                       end.
     3084                   end.
     3085               end.
     3086           end.
     3087       end.
     3088       for each temp_recipe-order
     3089       on error undo, return error
     3090       :
     3091           delete temp_recipe-order.
     3092       end.
     3093       assign
     3094           v-fbrlib-recipe-order = 0
     3095       .
     3096       do v-recipe-counter = 1 to v-recipe-amount
     3097       on error undo, return error
     3098       :
     3099           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     3100                 input v-recipe-counter
     3101               , input 0
     3102               , output v-is-call-cycle
     3103           ).
     3104           if v-is-call-cycle = yes
     3105           then do:
     3106               message
     3107                       "Достигнут максимальный уровень вложенности рецептов."
     3108                   skip(1)
     3109                   skip "Невозможно упорядочить рецепты."
     3110                   skip(1)
     3111                   skip "Необходимо изменить структуру рецептов,"
     3112                   skip "используемых при формировании"
     3113                   skip "данного документа производства."
     3114               view-as alert-box error
     3115               title "Невозможно рассчитать документ производства".
     3116               for each temp_recipe-childs-qnty
     3117               :
     3118                   delete temp_recipe-childs-qnty.
     3119               end.
     3120               for each temp_recipe-childs
     3121               :
     3122                   delete temp_recipe-childs.
     3123               end.
     3124               for each temp_recipe-order
     3125               :
     3126                   delete temp_recipe-order.
     3127               end.
     3128               for each temp_recipe-order
     3129               on error undo, return error
     3130               :
     3131                   delete temp_recipe-order.
     3132               end.
     3133               for each temp_fbrlib_recipe
     3134               on error undo, return error
     3135               :
     3136                   delete temp_recipe-order.
     3137               end.
     3138               undo, return error.
     3139           end.
     3140       end.
     3141   end.
     3142   end procedure.
     3143   procedure fbrlib-add-recipe-in-tmp-order :
     3144   do
     3145   on error undo, return error
     3146   :
     3147   define input parameter p-order              as integer      no-undo.
     3148   define input parameter p-call-counter       as integer      no-undo.
     3149   define output parameter p-is-call-cycle     as logical      no-undo.
     3150       define variable v-nodes-counter     as integer       no-undo.
     3151       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     3152       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     3153       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     3154       define buffer buf_temp_recipe-order         for temp_recipe-order.
     3155       assign
     3156           p-call-counter = p-call-counter + 1
     3157       .
     3158       if p-call-counter > 50
     3159       then do:
     3160           assign
     3161               p-is-call-cycle = yes
     3162           .
     3163       end.
     3164       else do:
     3165           find first buf_temp_recipe-childs-qnty
     3166                where buf_temp_recipe-childs-qnty.order = p-order
     3167           .
     3168           find first buf_temp_recipe-order
     3169                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     3170           no-error.
     3171           if not available buf_temp_recipe-order
     3172           then do:
     3173               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     3174               :
     3175                   find first buf_temp_recipe-childs
     3176                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     3177                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     3178                   .
     3179                   find first buf_c_temp_recipe-childs-qnty
     3180                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     3181                   .
     3182                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     3183                         input buf_c_temp_recipe-childs-qnty.order
     3184                       , input p-call-counter
     3185                       , output p-is-call-cycle
     3186                   ).
     3187                   if p-is-call-cycle = yes
     3188                   then do:
     3189                       return.
     3190                   end.
     3191               end.
     3192               assign
     3193                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     3194               .
     3195               create buf_temp_recipe-order.
     3196               assign
     3197                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     3198                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     3199               .
     3200           end.
     3201       end.
     3202   end.
     3203   end procedure.
     3204   procedure fbrlib-get-trn-type :
     3205   define input parameter p-recipe-code    as character    no-undo.
     3206   define input parameter p-goods-recid    as recid        no-undo.
     3207   define input parameter p-is-integration as logical      no-undo.
     3208   define output parameter p-is-comp       as logical      no-undo.
     3209   define output parameter p-trn-type      as character    no-undo.
     3210   define buffer buf_recipe    for ub.recipe.
     3211   define buffer buf_goods     for ub.goods.
     3212   do
     3213   for buf_recipe
     3214     , buf_goods
     3215   on error undo, return error
     3216   :
     3217       find first buf_goods no-lock
     3218            where recid( buf_goods ) = p-goods-recid
     3219       .
     3220       find first buf_recipe no-lock
     3221            where buf_recipe.recipe-code = p-recipe-code
     3222       no-error.
     3223       if not available buf_recipe
     3224       then do:
     3225           assign
     3226               p-is-comp = no
     3227               p-trn-type = "":U
     3228           .
     3229           undo, return.
     3230       end.
     3231       if  buf_recipe.artic        = buf_goods.artic
     3232       and buf_recipe.prod-type    = buf_goods.prod-type
     3233       and buf_recipe.prod-code    = buf_goods.prod-code
     3234       then do:
     3235           assign
     3236               p-is-comp = yes
     3237           .
     3238       end.
     3239       else do:
     3240           assign
     3241               p-is-comp = no
     3242           .
     3243       end.
     3244       case buf_recipe.recipe-type
     3245       :
     3246           when 'производство':U
     3247           then do:
     3248               if p-is-comp = yes
     3249               then do:
     3250                   assign
     3251                       p-trn-type = 'при':U
     3252                   .
     3253               end.
     3254               else do:
     3255                   assign
     3256                       p-trn-type = 'спи':U
     3257                   .
     3258               end.
     3259           end.
     3260           when 'альтернатива':U
     3261           then do:
     3262               if p-is-comp = yes
     3263               then do:
     3264                   assign
     3265                       p-trn-type = 'при':U
     3266                   .
     3267               end.
     3268               else do:
     3269                   assign
     3270                       p-trn-type = 'спи':U
     3271                   .
     3272               end.
     3273           end.
     3274           when 'разделка':U
     3275           then do:
     3276               if p-is-comp = no
     3277               then do:
     3278                   assign
     3279                       p-trn-type = 'при':U
     3280                   .
     3281               end.
     3282               else do:
     3283                   assign
     3284                       p-trn-type = 'спи':U
     3285                   .
     3286               end.
     3287           end.
     3288           when 'комплектация':U
     3289           then do:
     3290               if p-is-integration = ?
     3291               then do:
     3292                   message
     3293                       "Выберите тип операции по рецепту комплектации:"
     3294                       skip (2) "YES - комплектация"
     3295                       skip     "NO - разукомплектация"
     3296                   view-as alert-box question
     3297                   buttons YES-NO
     3298                   update p-is-integration.
     3299               end.
     3300               if p-is-integration = yes
     3301               then do:
     3302                   if p-is-comp = yes
     3303                   then do:
     3304                       assign
     3305                           p-trn-type = 'при':U
     3306                       .
     3307                   end.
     3308                   else do:
     3309                       assign
     3310                           p-trn-type = 'спи':U
     3311                       .
     3312                   end.
     3313               end.
     3314               else do:
     3315                   if p-is-comp = yes
     3316                   then do:
     3317                       assign
     3318                           p-trn-type = 'спи':U
     3319                       .
     3320                   end.
     3321                   else do:
     3322                       assign
     3323                           p-trn-type = 'при':U
     3324                       .
     3325                   end.
     3326               end.
     3327           end.
     3328       end case.
     3329   end.
     3330   end procedure.
     3331   procedure fbrlib-get-mark :
     3332   define input parameter p-recipe-code    as character    no-undo.
     3333   define output parameter p-mark          as logical    no-undo.
     3334   define buffer buf_goods-attr     for ub.goods-attr.
     3335   define buffer buf_recipe-gds for ub.recipe-gds .
     3336       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     3337            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     3338                                               buf_goods-attr.attr-code = 'mark-type':U:
     3339            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     3340               p-mark = true .
     3341               return .
     3342            end.
     3343       end.
     3344   end procedure.
     3345   procedure fbrlib-check-temp-tables :
     3346   do
     3347   on error undo, return error
     3348   :
     3349   define input parameter p-title  as character    no-undo.
     3350       define variable v-str               as character        no-undo.
     3351       assign
     3352           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     3353       .
     3354       for each temp_recipe-childs-qnty
     3355       on error undo, return error
     3356       :
     3357           assign
     3358               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     3359                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     3360                       + "   " + string( temp_recipe-childs-qnty.order )
     3361                       + chr(10)
     3362           .
     3363       end.
     3364       assign
     3365           v-str = v-str + "temp_recipe-childs:" + chr(10)
     3366       .
     3367       for each temp_recipe-childs
     3368       on error undo, return error
     3369       :
     3370           assign
     3371               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     3372                       + "   " + string( temp_recipe-childs.child-code )
     3373                       + "   " + string( temp_recipe-childs.child-recipe-code )
     3374                       + chr(10)
     3375           .
     3376       end.
     3377       assign
     3378           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     3379       .
     3380       for each temp_recipe-order
     3381       on error undo, return error
     3382       :
     3383           assign
     3384               v-str   = v-str + string( temp_recipe-order.recipe-code )
     3385                       + "   " + string( temp_recipe-order.order )
     3386                       + chr(10)
     3387           .
     3388       end.
     3389       assign
     3390           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     3391       .
     3392       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     3393       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3394       for each temp_fbrlib_recipe
     3395       on error undo, return error
     3396       :
     3397           assign
     3398               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     3399                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     3400                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     3401                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     3402                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     3403                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     3404                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     3405                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     3406                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     3407                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     3408                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     3409                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     3410                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     3411                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     3412                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     3413                       + chr(10)
     3414           .
     3415           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3416       end.
     3417   end.
     3418   end procedure.
     3419   procedure fbrlib-s-coeff-value :
     3420   define input  parameter p-gds-code    as integer        no-undo.
     3421   define input  parameter p-date        as date           no-undo.
     3422   define input  parameter p-obj-type    as character      no-undo.
     3423   define input  parameter p-obj-code    as integer        no-undo.
     3424   define output parameter p-coeff-value as decimal        no-undo.
     3425   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     3426       define variable v-date          as date         no-undo.
     3427       define variable v-host-code     as integer      no-undo.
     3428       define buffer buf_goods       for ub.goods.
     3429       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3430       define buffer buf_clients     for ub.clients.
     3431       define buffer buf_s-coeff     for ub.s-coeff.
     3432   do
     3433   for buf_goods
     3434     , buf_fbr-gds-obj
     3435     , buf_clients
     3436     , buf_s-coeff
     3437   on error undo, return error return-value
     3438   :
     3439       find first buf_goods no-lock
     3440            where buf_goods.gds-code = p-gds-code
     3441       no-error .
     3442       if not available buf_goods
     3443       then do:
     3444          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     3445       end.
     3446       find first buf_clients no-lock
     3447            where buf_clients.obj-type = p-obj-type
     3448              and buf_clients.obj-code = p-obj-code
     3449       no-error.
     3450       if not available buf_clients
     3451       then do:
     3452          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     3453       end.
     3454       assign
     3455           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     3456       .
     3457       find first buf_fbr-gds-obj no-lock
     3458            where buf_fbr-gds-obj.gds-code = p-gds-code
     3459              and buf_fbr-gds-obj.obj-type = p-obj-type
     3460              and buf_fbr-gds-obj.obj-code = p-obj-code
     3461       no-error.
     3462       if not available buf_fbr-gds-obj
     3463       or buf_fbr-gds-obj.is-season = no
     3464       then do:
     3465           assign
     3466               p-coeff-value = 0
     3467           .
     3468           return.
     3469       end.
     3470   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3472     (input  p-obj-type
     3473     ,input  p-obj-code
     3474     ,output v-host-code
     3475     )  .
     3476       find last buf_s-coeff no-lock
     3477           where buf_s-coeff.gds-code = p-gds-code
     3478             and buf_s-coeff.host-code = v-host-code
     3479             and buf_s-coeff.obj-type = p-obj-type
     3480             and buf_s-coeff.obj-code = p-obj-code
     3481             and buf_s-coeff.s-date <= v-date
     3482       no-error.
     3483       if available buf_s-coeff
     3484       then do:
     3485           assign
     3486               p-coeff-value = buf_s-coeff.coeff-value
     3487           .
     3488           return.
     3489       end.
     3490       find last buf_s-coeff no-lock
     3491           where buf_s-coeff.gds-code = p-gds-code
     3492             and buf_s-coeff.host-code = v-host-code
     3493             and buf_s-coeff.obj-type = "":U
     3494             and buf_s-coeff.obj-code = 0
     3495             and buf_s-coeff.s-date <= v-date
     3496       no-error.
     3497       if available buf_s-coeff
     3498       then do:
     3499           assign
     3500               p-coeff-value = buf_s-coeff.coeff-value
     3501           .
     3502           return.
     3503       end.
     3504       find last buf_s-coeff no-lock
     3505           where buf_s-coeff.gds-code = p-gds-code
     3506             and buf_s-coeff.host-code = 0
     3507             and buf_s-coeff.obj-type = "":U
     3508             and buf_s-coeff.obj-code = 0
     3509             and buf_s-coeff.s-date <= v-date
     3510       no-error.
     3511       if available buf_s-coeff
     3512       then do:
     3513           assign
     3514               p-coeff-value = buf_s-coeff.coeff-value
     3515           .
     3516       end.
     3517       else do:
     3518           assign
     3519               p-coeff-value = 0
     3520           .
     3521       end.
     3522   end.
     3523   end procedure.
     3524   procedure fbrlib_create-fbr-recipe-gds :
     3525   define input parameter p-doc-code         as character      no-undo.
     3526   define input parameter p-recipe-code      as character      no-undo.
     3527   define input parameter p-prod-type        as character      no-undo.
     3528   define input parameter p-prod-code        as integer        no-undo.
     3529   define input parameter p-artic            as character      no-undo.
     3530   define input parameter p-gds-code         as integer        no-undo.
     3531   define input parameter p-is-waste         as logical        no-undo.
     3532   define input parameter p-proc-number      as integer        no-undo.
     3533   define input parameter p-obj-date         as date           no-undo.
     3534   define input parameter p-obj-type         as character      no-undo.
     3535   define input parameter p-obj-code         as integer        no-undo.
     3536   define input parameter p-calc-method      as decimal        no-undo.
     3537   define input parameter p-coeff-waste      as decimal        no-undo.
     3538   define input parameter p-orig-qnty        as decimal        no-undo.
     3539   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     3540       define variable v-coeff-season  as decimal      no-undo.
     3541       define variable v-void-decimal  as decimal      no-undo.
     3542       define variable v-void-integer  as integer      no-undo.
     3543       define variable v-recipe-type   as character    no-undo.
     3544       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3545       define buffer buf_goods             for ub.goods.
     3546       define buffer buf_recipe            for ub.recipe.
     3547   do
     3548   for buf_fbr-recipe-gds
     3549     , buf_recipe
     3550     , buf_goods
     3551   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3552   :
     3553       find first buf_fbr-recipe-gds exclusive-lock
     3554            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3555              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3556              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     3557              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     3558              and buf_fbr-recipe-gds.artic       = p-artic
     3559       no-error.
     3560       if not available buf_fbr-recipe-gds
     3561       then do:
     3562           create buf_fbr-recipe-gds.
     3563           assign
     3564               buf_fbr-recipe-gds.doc-code           = p-doc-code
     3565               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     3566               buf_fbr-recipe-gds.prod-type          = p-prod-type
     3567               buf_fbr-recipe-gds.prod-code          = p-prod-code
     3568               buf_fbr-recipe-gds.artic              = p-artic
     3569               buf_fbr-recipe-gds.gds-code           = p-gds-code
     3570               buf_fbr-recipe-gds.is-waste           = p-is-waste
     3571               buf_fbr-recipe-gds.proc-number        = p-proc-number
     3572               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     3573               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     3574           .
     3575           find first buf_goods no-lock
     3576                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     3577                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     3578                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     3579           .
     3580           run fbrlib-s-coeff-value in this-procedure (
     3581                 input buf_goods.gds-code
     3582               , input p-obj-date
     3583               , input p-obj-type
     3584               , input p-obj-code
     3585               , output v-coeff-season
     3586           ) no-error.
     3587           if error-status:error
     3588           then do:
     3589               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     3590           end.
     3591           assign
     3592               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     3593               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     3594               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     3595           .
     3596           run fbrlib-get-recipe-type in this-procedure (
     3597                 input buf_fbr-recipe-gds.doc-code
     3598               , input buf_fbr-recipe-gds.recipe-code
     3599               , output v-recipe-type
     3600           ).
     3601           if v-recipe-type <> 'производство':U
     3602           then do:
     3603               assign
     3604                   buf_fbr-recipe-gds.coeff-value  = 0
     3605                   buf_fbr-recipe-gds.coeff-waste  = 0
     3606                   buf_fbr-recipe-gds.calc-method  = 1
     3607                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     3608               .
     3609           end.
     3610           else do:
     3611               run fbrlib-calc-brutto in this-procedure (
     3612                     input v-recipe-type
     3613                   , input buf_fbr-recipe-gds.qnty
     3614                   , input buf_fbr-recipe-gds.coeff-value
     3615                   , input buf_fbr-recipe-gds.coeff-waste
     3616                   , input 0
     3617                   , input 3
     3618                   , output v-void-decimal
     3619                   , output v-void-decimal
     3620                   , output buf_fbr-recipe-gds.brutto-qnty
     3621                   , output v-void-integer
     3622               ).
     3623               assign
     3624                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     3625               .
     3626               run fbrlib-calc-brutto in this-procedure (
     3627                     input v-recipe-type
     3628                   , input buf_fbr-recipe-gds.qnty
     3629                   , input buf_fbr-recipe-gds.coeff-value
     3630                   , input buf_fbr-recipe-gds.coeff-waste
     3631                   , input buf_fbr-recipe-gds.brutto-qnty
     3632                   , input buf_fbr-recipe-gds.calc-method
     3633                   , output buf_fbr-recipe-gds.qnty
     3634                   , output v-void-decimal
     3635                   , output v-void-decimal
     3636                   , output v-void-integer
     3637               ).
     3638           end.
     3639       end.
     3640   end.
     3641   end procedure.
     3642   procedure fbrlib-set-default-recipe :
     3643   define input parameter p-obj-type   as character    no-undo.
     3644   define input parameter p-obj-code   as integer      no-undo.
     3645   define input parameter p-gds-code   as integer      no-undo.
     3646       define variable v-artic             as character    no-undo.
     3647       define variable v-prod-type         as character    no-undo.
     3648       define variable v-prod-code         as character    no-undo.
     3649       define variable v-recipe-code       as character    no-undo.
     3650       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3651       define variable v-recipe-found      as logical      no-undo.
     3652       define buffer buf_recipe        for ub.recipe.
     3653       define buffer buf_other_recipe  for ub.recipe.
     3654       define buffer buf_goods         for ub.goods.
     3655       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3656   do
     3657   for buf_recipe
     3658     , buf_goods
     3659     , buf_fbr-gds-obj
     3660   on error undo, return error
     3661   :
     3662       find first buf_goods no-lock
     3663            where buf_goods.gds-code = p-gds-code
     3664       .
     3665       run fbrlib-get-obj-recipe in this-procedure (
     3666             input p-obj-type
     3667           , input p-obj-code
     3668           , input p-gds-code
     3669           , output v-recipe-code
     3670       ).
     3671       if v-recipe-code <> ""
     3672       then do:
     3673           find first buf_recipe no-lock
     3674               where buf_recipe.recipe-code = v-recipe-code
     3675           no-error.
     3676           if not available buf_recipe
     3677           then do:
     3678               assign
     3679                   v-recipe-code = ""
     3680               .
     3681           end.
     3682       end.
     3683       if v-recipe-code = ""
     3684       then do:
     3685           find first buf_fbr-gds-obj exclusive-lock
     3686                where buf_fbr-gds-obj.obj-type = p-obj-type
     3687                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3688                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3689           no-error.
     3690           if not available buf_fbr-gds-obj
     3691           then do:
     3692               run ref/fgdsobj1.p (
     3693                     input-output v-fbr-gds-obj-recid
     3694                   , input 'ДОБАВЛЕНИЕ':U
     3695                   , input no
     3696                   , input p-gds-code
     3697                   , input p-obj-type
     3698                   , input p-obj-code
     3699                   , input 0
     3700                   , input ""
     3701                   , input 0
     3702                   , input no
     3703                   , input no
     3704                   , input no
     3705                   , input no
     3706                   , input no
     3707                   , input no
     3708               ) no-error.
     3709               if error-status:error
     3710               then do:
     3711                   message
     3712                           vss-workfile vss-revision vss-description
     3713                       skip "Ошибка изменения атрибутов товара на объекте"
     3714                       skip return-value
     3715                       skip trim(error-status :get-message(1))
     3716                               trim(error-status :get-message(2))
     3717                               trim(error-status :get-message(3))
     3718                   view-as alert-box error.
     3719                   undo, return error .
     3720               end.
     3721               find first buf_fbr-gds-obj exclusive-lock
     3722                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3723               .
     3724           end.
     3725           assign
     3726               v-recipe-found = no
     3727           .
     3728           for first buf_recipe no-lock
     3729               where buf_recipe.obj-type    = p-obj-type
     3730                 and buf_recipe.obj-code    = p-obj-code
     3731                 and buf_recipe.artic       = buf_goods.artic
     3732                 and buf_recipe.prod-type   = buf_goods.prod-type
     3733                 and buf_recipe.prod-code   = buf_goods.prod-code
     3734                 and buf_recipe.recipe-type = 'производство':U
     3735                 or (
     3736                     buf_recipe.obj-type    = ""
     3737                 and buf_recipe.obj-code    = 0
     3738                 and buf_recipe.artic       = buf_goods.artic
     3739                 and buf_recipe.prod-type   = buf_goods.prod-type
     3740                 and buf_recipe.prod-code   = buf_goods.prod-code
     3741                 and buf_recipe.recipe-type = 'производство':U
     3742                     )
     3743           :
     3744               assign
     3745                   v-recipe-found = yes
     3746                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3747               .
     3748           end.
     3749           if v-recipe-found = no
     3750           then do:
     3751               for first buf_recipe no-lock
     3752                   where buf_recipe.obj-type    = p-obj-type
     3753                     and buf_recipe.obj-code    = p-obj-code
     3754                     and buf_recipe.artic       = buf_goods.artic
     3755                     and buf_recipe.prod-type   = buf_goods.prod-type
     3756                     and buf_recipe.prod-code   = buf_goods.prod-code
     3757                     and buf_recipe.recipe-type <> 'альтернатива':U
     3758                     or (
     3759                         buf_recipe.obj-type    = ""
     3760                     and buf_recipe.obj-code    = 0
     3761                     and buf_recipe.artic       = buf_goods.artic
     3762                     and buf_recipe.prod-type   = buf_goods.prod-type
     3763                     and buf_recipe.prod-code   = buf_goods.prod-code
     3764                     and buf_recipe.recipe-type <> 'альтернатива':U
     3765                         )
     3766               :
     3767                   assign
     3768                       v-recipe-found = yes
     3769                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3770                   .
     3771               end.
     3772               if v-recipe-found = no
     3773               then do:
     3774                   for first buf_recipe no-lock
     3775                       where buf_recipe.obj-type    = p-obj-type
     3776                         and buf_recipe.obj-code    = p-obj-code
     3777                         and buf_recipe.artic       = buf_goods.artic
     3778                         and buf_recipe.prod-type   = buf_goods.prod-type
     3779                         and buf_recipe.prod-code   = buf_goods.prod-code
     3780                         or (
     3781                             buf_recipe.obj-type    = ""
     3782                         and buf_recipe.obj-code    = 0
     3783                         and buf_recipe.artic       = buf_goods.artic
     3784                         and buf_recipe.prod-type   = buf_goods.prod-type
     3785                         and buf_recipe.prod-code   = buf_goods.prod-code
     3786                             )
     3787                   :
     3788                       assign
     3789                           v-recipe-found = yes
     3790                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3791                       .
     3792                   end.
     3793                   if v-recipe-found = no
     3794                   then do:
     3795                       assign
     3796                           buf_fbr-gds-obj.default-recipe-code = ""
     3797                       .
     3798                   end.
     3799               end.
     3800           end.
     3801       end.
     3802   end.
     3803   end procedure.
     3804   procedure fbrlib-get-obj-recipe :
     3805   define input parameter p-obj-type       as character    no-undo.
     3806   define input parameter p-obj-code       as integer      no-undo.
     3807   define input parameter p-gds-code       as integer      no-undo.
     3808   define output parameter p-recipe-code   as character    no-undo.
     3809       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3810   do
     3811   for buf_fbr-gds-obj
     3812   on error undo, return error
     3813   :
     3814       find first buf_fbr-gds-obj no-lock
     3815            where buf_fbr-gds-obj.obj-type = p-obj-type
     3816              and buf_fbr-gds-obj.obj-code = p-obj-code
     3817              and buf_fbr-gds-obj.gds-code = p-gds-code
     3818       no-error.
     3819       if available buf_fbr-gds-obj
     3820       then do:
     3821           assign
     3822               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3823           .
     3824       end.
     3825       else do:
     3826           assign
     3827               p-recipe-code = ""
     3828           .
     3829       end.
     3830   end.
     3831   end procedure.
     3832   procedure fbrlib-create-or-update-recipe-gds :
     3833   define input parameter p-recipe-code    as character        no-undo.
     3834   define input parameter p-gds-code       as integer          no-undo.
     3835   define input parameter p-is-waste       as logical          no-undo.
     3836   define input parameter p-qnty           as decimal          no-undo.
     3837   define input parameter p-proc-number    as integer          no-undo.
     3838   define input parameter p-nws-self       as logical          no-undo.
     3839       define variable v-max-proc-num  as integer      no-undo.
     3840       define variable v-recipe-type   as character    no-undo.
     3841       define buffer buf_goods             for ub.goods.
     3842       define buffer buf_recipe-gds        for ub.recipe-gds.
     3843       define buffer buf_recipe            for ub.recipe.
     3844       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3845   do
     3846   for buf_goods
     3847     , buf_recipe-gds
     3848     , buf_recipe
     3849     , buf_proc_recipe-gds
     3850   on error undo, return error
     3851   :
     3852       find first buf_recipe no-lock
     3853            where buf_recipe.recipe-code = p-recipe-code
     3854       .
     3855       find first buf_goods no-lock
     3856            where buf_goods.gds-code = p-gds-code
     3857       .
     3858       find first buf_recipe-gds
     3859            where buf_recipe-gds.recipe-code = p-recipe-code
     3860              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3861              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3862              and buf_recipe-gds.artic       = buf_goods.artic
     3863       no-error.
     3864       if not available buf_recipe-gds
     3865       then do:
     3866           create buf_recipe-gds.
     3867           assign
     3868               buf_recipe-gds.recipe-code = p-recipe-code
     3869               buf_recipe-gds.gds-code    = p-gds-code
     3870               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3871               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3872               buf_recipe-gds.artic       = buf_goods.artic
     3873           .
     3874           assign
     3875               buf_recipe-gds.is-waste    = no
     3876               buf_recipe-gds.qnty        = 0
     3877               buf_recipe-gds.coeff-waste = 0
     3878               buf_recipe-gds.brutto-qnty = 0
     3879               buf_recipe-gds.proc-number = 0
     3880               buf_recipe-gds.nws-self    = no
     3881           .
     3882       end.
     3883       assign
     3884           buf_recipe-gds.is-waste    = p-is-waste
     3885       .
     3886       run fbrlib-get-recipe-type in this-procedure (
     3887             input "":U
     3888           , input buf_recipe-gds.recipe-code
     3889           , output v-recipe-type
     3890       ).
     3891       if v-recipe-type <> 'производство':U
     3892       then do:
     3893           assign
     3894               buf_recipe-gds.calc-method = 1
     3895               buf_recipe-gds.qnty        = p-qnty
     3896               buf_recipe-gds.brutto-qnty = p-qnty
     3897               buf_recipe-gds.coeff-waste = 0
     3898           .
     3899       end.
     3900       else do:
     3901           assign
     3902               buf_recipe-gds.calc-method = 1
     3903               buf_recipe-gds.brutto-qnty = p-qnty
     3904           .
     3905           run fbrlib-calc-brutto in this-procedure (
     3906                 input v-recipe-type
     3907               , input 0
     3908               , input 0
     3909               , input buf_recipe-gds.coeff-waste
     3910               , input buf_recipe-gds.brutto-qnty
     3911               , input 1
     3912               , output buf_recipe-gds.qnty
     3913               , output buf_recipe-gds.coeff-waste
     3914               , output buf_recipe-gds.brutto-qnty
     3915               , output buf_recipe-gds.calc-method
     3916           ).
     3917       end.
     3918       assign
     3919           buf_recipe-gds.nws-self    = p-nws-self
     3920       .
     3921       if buf_recipe.recipe-type = 'альтернатива':U
     3922       and buf_recipe-gds.proc-number <> 0
     3923       then do:
     3924       end.
     3925       else do:
     3926           if p-proc-number <> 0
     3927           then do:
     3928               assign
     3929                   buf_recipe-gds.proc-number = p-proc-number
     3930               .
     3931           end.
     3932           else do:
     3933               assign
     3934                   v-max-proc-num = 0
     3935               .
     3936               for each buf_proc_recipe-gds no-lock
     3937                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3938               :
     3939                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3940                   then do:
     3941                       assign
     3942                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3943                       .
     3944                   end.
     3945               end.
     3946               assign
     3947                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3948               .
     3949           end.
     3950       end.
     3951   end.
     3952   end procedure.
     3953   PROCEDURE fbrlib-create-or-update-recipe :
     3954   define input parameter p-mode               as character    no-undo.
     3955   define input parameter p-obj-type           as character    no-undo.
     3956   define input parameter p-obj-code           as integer      no-undo.
     3957   define input parameter p-recipe-code        as character    no-undo.
     3958   define input parameter p-recipe-type        as character    no-undo.
     3959   define input parameter p-gds-code           as integer      no-undo.
     3960   define input parameter p-name               as character    no-undo.
     3961   define input parameter p-design             as character    no-undo.
     3962   define input parameter p-order              as integer      no-undo.
     3963   define input parameter p-quality            as character    no-undo.
     3964   define input parameter p-ref-num            as character    no-undo.
     3965   define input parameter p-technique          as character    no-undo.
     3966   define input parameter p-template           as character    no-undo.
     3967   define input parameter p-qnty               as decimal      no-undo.
     3968   define input parameter p-portion-qnty       as integer      no-undo.
     3969   define input parameter p-portion-weight     as decimal      no-undo.
     3970   define output parameter p-new-recipe-code   as character    no-undo.
     3971       define variable v-host-code         as integer      no-undo.
     3972       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3973       define buffer buf_recipe    for ub.recipe.
     3974       define buffer buf_goods     for ub.goods.
     3975   do
     3976   for buf_recipe
     3977     , buf_goods
     3978   on error undo, return error
     3979   :
     3980       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3981       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3982       then do:
     3983           message
     3984               skip "Ошибка задания типа операции для создания или измения рецепта."
     3985               skip (1)
     3986               skip "Задан тип операции:" p-mode
     3987           view-as alert-box error.
     3988           undo, return error .
     3989       end.
     3990       if p-recipe-code = ""
     3991       then do:
     3992   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3993   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3994     (input  p-obj-type
     3995     ,input  p-obj-code
     3996     ,output v-host-code
     3997     )  .
     3998           find first buf_goods no-lock
     3999                where buf_goods.gds-code = p-gds-code
     4000           .
     4001           create buf_recipe .
     4002           run fbrcode-gen-recipe-code in this-procedure (
     4003                 input p-obj-type
     4004               , input p-obj-code
     4005               , output buf_recipe.recipe-code
     4006           ).
     4007           assign
     4008               buf_recipe.artic               = buf_goods.artic
     4009               buf_recipe.prod-type           = buf_goods.prod-type
     4010               buf_recipe.prod-code           = buf_goods.prod-code
     4011               buf_recipe.recipe-type         = p-recipe-type
     4012               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     4013               buf_recipe.gds-code            = p-gds-code
     4014               buf_recipe.host-code           = v-host-code
     4015               buf_recipe.obj-type            = p-obj-type
     4016               buf_recipe.obj-code            = p-obj-code
     4017               buf_recipe.recipe-design       = ""
     4018               buf_recipe.recipe-order        = 0
     4019               buf_recipe.recipe-quality      = ""
     4020               buf_recipe.recipe-ref-num      = ""
     4021               buf_recipe.recipe-technique    = ""
     4022               buf_recipe.recipe-template     = ""
     4023               buf_recipe.qnty                = 1.0
     4024               buf_recipe.portion-qnty        = 1
     4025               buf_recipe.portion-weight      = 0
     4026           .
     4027       end.
     4028       if p-name <> ""
     4029       then do:
     4030           assign
     4031               buf_recipe.recipe-name = p-name
     4032           .
     4033       end.
     4034       assign
     4035           buf_recipe.recipe-design       = p-design
     4036           buf_recipe.recipe-order        = p-order
     4037           buf_recipe.recipe-quality      = p-quality
     4038           buf_recipe.recipe-ref-num      = p-ref-num
     4039           buf_recipe.recipe-technique    = p-technique
     4040           buf_recipe.recipe-template     = p-template
     4041           buf_recipe.qnty                = p-qnty
     4042           buf_recipe.portion-qnty        = p-portion-qnty
     4043           buf_recipe.portion-weight      = p-portion-weight
     4044       .
     4045       assign
     4046           p-new-recipe-code = buf_recipe.recipe-code
     4047       .
     4048       run fbrlib-set-default-recipe in this-procedure (
     4049             input p-obj-type
     4050           , input p-obj-code
     4051           , input buf_goods.gds-code
     4052       ).
     4053   end.
     4054   END PROCEDURE.
     4055   PROCEDURE fbrlib-delete-fact-fbr-doc :
     4056   define input parameter parparentproc-handle as widget-handle no-undo .
     4057   define input parameter p-doc-code   as character no-undo.
     4058   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     4059       define variable v-shift-on      as logical      no-undo.
     4060       define variable v-shift-date    as date         no-undo.
     4061       define variable v-shift-num     as integer      no-undo.
     4062       define variable v-shift-name    as character    no-undo.
     4063       define variable v-obj-date      as date         no-undo.
     4064       define variable v-chip-num      as integer      no-undo.
     4065       define buffer buf_fbr-doc       for ub.fbr-doc.
     4066       define buffer buf_fbr-line      for ub.fbr-line.
     4067       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     4068       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     4069       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     4070       define buffer buf_marking-lines for ub.marking-lines .
     4071       define buffer buf_marking       for ub.marking .
     4072       define buffer buf_goods         for ub.goods .
     4073   do
     4074   for buf_fbr-doc
     4075     , buf_fbr-line
     4076     , buf_c-fbr-doc
     4077     , buf_fbr-recipe
     4078     , buf_fbr-recipe-gds
     4079     , buf_goods
     4080     , buf_marking
     4081     , buf_marking-lines
     4082   on error undo, return error
     4083   :
     4084   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4085     define variable v-cntxt-db-num        as integer   no-undo .
     4086     define variable v-cntxt-userid        as character no-undo .
     4087     define variable v-cntxt-level         as character no-undo .
     4088     define variable v-cntxt-host-code-obj as integer   no-undo .
     4089     define variable v-cntxt-obj-type      as character no-undo .
     4090     define variable v-cntxt-obj-code      as integer   no-undo .
     4091     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4092     define variable v-cntxt-is-admin      as logical   no-undo .
     4093   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4094     run mainmenu_getcntxt in parparentproc-handle
     4095       (output v-cntxt-db-num
     4096       ,output v-cntxt-userid
     4097       ,output v-cntxt-level
     4098       ,output v-cntxt-host-code-obj
     4099       ,output v-cntxt-obj-type
     4100       ,output v-cntxt-obj-code
     4101       ,output v-cntxt-db-num-obj
     4102       ,output v-cntxt-is-admin
     4103       ) .
     4104       if search ("delfbr.err") <> ?
     4105       then do:
     4106           os-delete "delfbr.err".
     4107       end.
     4108     _del-block:
     4109       do transaction
     4110     on error undo _del-block, return error return-value
     4111     on endkey undo _del-block , return error return-value
     4112     on stop undo _del-block , return error return-value
     4113       :
     4114           find first buf_fbr-doc exclusive-lock
     4115                where buf_fbr-doc.doc-code = p-doc-code
     4116           no-error.
     4117           if not available buf_fbr-doc
     4118           then do:
     4119         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     4120                                           ,vss-workfile
     4121                                           ,vss-revision
     4122                                           ,vss-description
     4123                                           ,chr(10)
     4124                                           , p-doc-code).
     4125           end.
     4126           run fbrlib-delete-fact-trn-doc in this-procedure (
     4127               input parparentproc-handle
     4128              ,input p-doc-code
     4129              ,input 'при':U
     4130              ,input p-chip-num
     4131              ,output v-chip-num
     4132           ) no-error.
     4133           if error-status :error
     4134           then do:
     4135               run fbrlib-print-del-error-message in this-procedure .
     4136         undo _del-block, return error.
     4137           end.
     4138           assign
     4139           p-chip-num = (if p-chip-num = ?
     4140                         then v-chip-num
     4141                         else p-chip-num).
     4142           run fbrlib-delete-fact-trn-doc in this-procedure (
     4143               input parparentproc-handle
     4144              ,input p-doc-code
     4145              ,input 'рас':U
     4146              ,input p-chip-num
     4147              ,output v-chip-num
     4148           ) no-error.
     4149           if error-status :error
     4150           then do:
     4151               run fbrlib-print-del-error-message in this-procedure .
     4152         undo _del-block, return error.
     4153           end.
     4154           run fbrlib-delete-fact-trn-doc in this-procedure (
     4155               input parparentproc-handle
     4156              ,input p-doc-code
     4157              ,input 'спи':U
     4158              ,input p-chip-num
     4159              ,output v-chip-num
     4160           ) no-error.
     4161           if error-status :error
     4162           then do:
     4163               run fbrlib-print-del-error-message in this-procedure .
     4164         undo _del-block, return error.
     4165           end.
     4166           create buf_c-fbr-doc.
     4167           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     4168   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4170     (input  buf_fbr-doc.obj-type
     4171     ,input  buf_fbr-doc.obj-code
     4172     ,output v-obj-date
     4173     ) no-error .
     4174           if error-status :error
     4175           or v-obj-date = ?
     4176           then do:
     4177         undo _del-block, return error "Нет текущей даты на объекте документа.".
     4178           end.
     4179   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4180   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4181     (input  buf_fbr-doc.obj-type
     4182     ,input  buf_fbr-doc.obj-code
     4183     ,input  'shift-on=request'
     4184     ,output v-shift-on
     4185     )  .
     4186           if v-shift-on
     4187           then do:
     4188   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     4190     (input  buf_fbr-doc.obj-type
     4191     ,input  buf_fbr-doc.obj-code
     4192     ,output v-shift-date
     4193     ,output v-shift-num
     4194     ,output v-shift-name
     4195     ) no-error .
     4196               if error-status :error
     4197               then do:
     4198           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     4199               end.
     4200           end.
     4201           else do:
     4202               assign
     4203                   v-shift-date = ?
     4204                   v-shift-num  = ?
     4205                   v-shift-name = ?
     4206               .
     4207           end.
     4208           define variable v-today       as date         no-undo.
     4209           define variable v-time        as integer      no-undo.
     4210           run cur-time in this-procedure (
     4211                 output v-today
     4212               , output v-time
     4213           ).
     4214           assign
     4215               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     4216               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     4217               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     4218               buf_c-fbr-doc.corr-date        = v-today
     4219               buf_c-fbr-doc.corr-time        = v-time
     4220               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     4221               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     4222               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     4223               buf_c-fbr-doc.is-del           = yes
     4224           .
     4225           assign
     4226               buf_fbr-doc.is-del = yes
     4227           .
     4228           for each buf_fbr-line exclusive-lock
     4229              where buf_fbr-line.doc-code = p-doc-code
     4230       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4231       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     4232       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     4233           :
     4234               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     4235                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     4236                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     4237               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     4238                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     4239                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     4240                                                       and buf_marking-lines.in-code  = "manufacturing"
     4241                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     4242                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     4243                                                       and buf_marking-lines.prt-code = 0
     4244               :
     4245                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     4246                   assign
     4247                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     4248                   .
     4249                 end .
     4250                 delete buf_marking-lines.
     4251               end .
     4252               delete buf_fbr-line.
     4253           end.
     4254           for each buf_fbr-recipe exclusive-lock
     4255              where buf_fbr-recipe.doc-code = p-doc-code
     4256       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4257       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     4258       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     4259           :
     4260               delete buf_fbr-recipe.
     4261           end.
     4262           for each buf_fbr-recipe-gds exclusive-lock
     4263              where buf_fbr-recipe-gds.doc-code = p-doc-code
     4264       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4265       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     4266       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     4267           :
     4268               delete buf_fbr-recipe-gds.
     4269           end.
     4270           delete buf_fbr-doc.
     4271       end.
     4272   end.
     4273   END PROCEDURE.
     4274   PROCEDURE fbrlib-del-trn-doc :
     4275   do
     4276   on error undo, return error
     4277   :
     4278   define input parameter parparentproc        as widget-handle no-undo .
     4279   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4280   define input parameter p-trn-doc-type       as character    no-undo.
     4281   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     4282   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     4283       define variable v-trn-doc-doc-code  as character     no-undo.
     4284       define buffer buf_trn-doc       for ub.trn-doc.
     4285   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4286     define variable v-cntxt-db-num        as integer   no-undo .
     4287     define variable v-cntxt-userid        as character no-undo .
     4288     define variable v-cntxt-level         as character no-undo .
     4289     define variable v-cntxt-host-code-obj as integer   no-undo .
     4290     define variable v-cntxt-obj-type      as character no-undo .
     4291     define variable v-cntxt-obj-code      as integer   no-undo .
     4292     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4293     define variable v-cntxt-is-admin      as logical   no-undo .
     4294   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4295     run mainmenu_getcntxt in parparentproc
     4296       (output v-cntxt-db-num
     4297       ,output v-cntxt-userid
     4298       ,output v-cntxt-level
     4299       ,output v-cntxt-host-code-obj
     4300       ,output v-cntxt-obj-type
     4301       ,output v-cntxt-obj-code
     4302       ,output v-cntxt-db-num-obj
     4303       ,output v-cntxt-is-admin
     4304       ) .
     4305       run fbrcode-trn-doc in this-procedure (
     4306             input 'производство':U
     4307           , input p-fbr-doc-doc-code
     4308           , input p-trn-doc-type
     4309           , output v-trn-doc-doc-code
     4310       ).
     4311       find first buf_trn-doc no-lock
     4312            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     4313       no-error.
     4314       if available buf_trn-doc
     4315       then do:
     4316           run str/del-doc.p (
     4317                 input parparentproc
     4318               , input buf_trn-doc.doc-code
     4319               , input v-cntxt-db-num
     4320               , input "del-doc.err"
     4321               , input ?
     4322               , input p-fbr-doc-doc-code
     4323               , input v-cntxt-userid
     4324               , input 0
     4325               , input p-phchip-num
     4326               , output p-chip-num
     4327           ) no-error.
     4328           if error-status :error
     4329           then do:
     4330             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     4331                                           ,v-trn-doc-doc-code
     4332                                           ,p-fbr-doc-doc-code
     4333                                           , chr(10)
     4334                                           , error-status:get-message(1)
     4335                                           , return-value ).
     4336           end.
     4337       end.
     4338   end.
     4339   END PROCEDURE.
     4340   PROCEDURE fbrlib-delete-fact-trn-doc :
     4341   define input parameter parparentproc    as widget-handle    no-undo.
     4342   define input parameter p-fbr-doc-code   as character        no-undo.
     4343   define input parameter p-doc-type       as character    no-undo.
     4344   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     4345   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     4346       define variable v-doc-code          as character        no-undo.
     4347       define variable v-ext-doc-type      as character        no-undo.
     4348       define variable v-trn-doc-recid     as recid            no-undo.
     4349       define variable varchip-code        as integer          no-undo.
     4350       define variable varchip-code2       as integer          no-undo.
     4351       define variable v-chip-counter      as integer          no-undo.
     4352       define buffer buf_trn-doc       for ub.trn-doc.
     4353       define buffer buf_pri_trn-doc   for ub.trn-doc.
     4354       define buffer buf_cons_trn-doc  for ub.trn-doc.
     4355   do
     4356   for buf_trn-doc
     4357     , buf_pri_trn-doc
     4358     , buf_cons_trn-doc
     4359   on error undo, return error
     4360   :
     4361   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4362     define variable v-cntxt-db-num        as integer   no-undo .
     4363     define variable v-cntxt-userid        as character no-undo .
     4364     define variable v-cntxt-level         as character no-undo .
     4365     define variable v-cntxt-host-code-obj as integer   no-undo .
     4366     define variable v-cntxt-obj-type      as character no-undo .
     4367     define variable v-cntxt-obj-code      as integer   no-undo .
     4368     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4369     define variable v-cntxt-is-admin      as logical   no-undo .
     4370   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4371     run mainmenu_getcntxt in parparentproc
     4372       (output v-cntxt-db-num
     4373       ,output v-cntxt-userid
     4374       ,output v-cntxt-level
     4375       ,output v-cntxt-host-code-obj
     4376       ,output v-cntxt-obj-type
     4377       ,output v-cntxt-obj-code
     4378       ,output v-cntxt-db-num-obj
     4379       ,output v-cntxt-is-admin
     4380       ) .
     4381       run fbrcode-trn-doc in this-procedure (
     4382             input 'производство':U
     4383           , input p-fbr-doc-code
     4384           , input p-doc-type
     4385           , output v-doc-code
     4386       ).
     4387       find first buf_trn-doc no-lock
     4388            where buf_trn-doc.doc-code = v-doc-code
     4389       no-error.
     4390       if not available buf_trn-doc
     4391       then do:
     4392           if p-doc-type <> 'спи':U
     4393           then do:
     4394               message
     4395                   "Не найден документ '" p-doc-type "'"
     4396                   "по документу производства " p-fbr-doc-code
     4397               view-as alert-box.
     4398               undo, return error.
     4399           end.
     4400           else do:
     4401           end.
     4402       end.
     4403       else do:
     4404           assign
     4405               v-trn-doc-recid = recid( buf_trn-doc )
     4406               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     4407           .
     4408           if v-ext-doc-type = 'ev':U
     4409           then do:
     4410               find first buf_pri_trn-doc no-lock
     4411                    where buf_pri_trn-doc.out-code     = v-doc-code
     4412                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     4413               no-error.
     4414               if available buf_pri_trn-doc
     4415               then do:
     4416                   run str/del-doc.p (
     4417                         input parparentproc
     4418                       , input buf_pri_trn-doc.doc-code
     4419                       , input v-cntxt-db-num
     4420                       , input "delfbr.err"
     4421                       , input ?
     4422                       , input p-fbr-doc-code
     4423                       , input v-cntxt-userid
     4424                       , input 0
     4425                       , input (if p-ph-chip-num <> ?
     4426                               then p-ph-chip-num
     4427                               else (if varchip-code <> 0
     4428                                   then varchip-code
     4429                                   else ?)
     4430                               )
     4431                       , output varchip-code2
     4432                   ) no-error.
     4433                   if error-status :error
     4434                   then do:
     4435                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4436                                                   ,buf_pri_trn-doc.doc-code
     4437                                                   ,p-fbr-doc-code
     4438                                                   , chr(10)
     4439                                                   , error-status:get-message(1)
     4440                                                   , return-value ).
     4441                   end.
     4442               end.
     4443           end.
     4444           define buffer buf_out_trn-doc       for ub.trn-doc.
     4445           if p-doc-type = 'при':U
     4446           then do:
     4447               assign
     4448                   v-chip-counter = 0
     4449               .
     4450               for each buf_out_trn-doc exclusive-lock
     4451                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     4452               on error undo, return error
     4453               :
     4454                   assign
     4455                       v-chip-counter = v-chip-counter + 1
     4456                   .
     4457                   if v-chip-counter > 1
     4458                   then do:
     4459                       assign
     4460                           varchip-code = varchip-code2
     4461                       .
     4462                   end.
     4463                   run str/del-doc.p (
     4464                         input parparentproc
     4465                       , input buf_out_trn-doc.doc-code
     4466                       , input v-cntxt-db-num
     4467                       , input "delfbr.err"
     4468                       , input ?
     4469                       , input p-fbr-doc-code
     4470                       , input v-cntxt-userid
     4471                       , input 0
     4472                       , input (if p-ph-chip-num <> ?
     4473                               then p-ph-chip-num
     4474                               else (if varchip-code <> 0
     4475                                   then varchip-code
     4476                                   else ?)
     4477                               )
     4478                       , output varchip-code2
     4479                   ) no-error.
     4480                   if error-status :error
     4481                   then do:
     4482                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     4483                                                   ,buf_out_trn-doc.doc-code
     4484                                                   ,buf_trn-doc.doc-code
     4485                                                   ,p-fbr-doc-code
     4486                                                   , chr(10)
     4487                                                   , error-status:get-message(1)
     4488                                                   , return-value ).
     4489                   end.
     4490               end.
     4491           end.
     4492           run str/del-doc.p (
     4493                 input parparentproc
     4494               , input buf_trn-doc.doc-code
     4495               , input v-cntxt-db-num
     4496               , input "delfbr.err"
     4497               , input ?
     4498               , input p-fbr-doc-code
     4499               , input v-cntxt-userid
     4500               , input 0
     4501               , input (if p-ph-chip-num <> ?
     4502                        then p-ph-chip-num
     4503                        else (if varchip-code <> 0
     4504                              then varchip-code
     4505                              else ?)
     4506                        )
     4507               , output varchip-code2
     4508           ) no-error.
     4509           if error-status :error
     4510           then do:
     4511               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4512                                             ,buf_trn-doc.doc-code
     4513                                             ,p-fbr-doc-code
     4514                                             , chr(10)
     4515                                             , error-status:get-message(1)
     4516                                             , return-value ).
     4517           end.
     4518           if p-doc-type = 'рас':U
     4519           or p-doc-type = 'спи':U
     4520           then do:
     4521               assign
     4522                   v-chip-counter = 0
     4523               .
     4524               for each buf_cons_trn-doc no-lock
     4525                  where buf_cons_trn-doc.out-code      = v-doc-code
     4526                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     4527               :
     4528                   assign
     4529                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     4530                       v-chip-counter = v-chip-counter + 1
     4531                   .
     4532                   assign
     4533                   varchip-code = if v-chip-counter = 2
     4534                                  then varchip-code2
     4535                                  else varchip-code.
     4536                   run str/del-doc.p (
     4537                         input parparentproc
     4538                       , input buf_cons_trn-doc.doc-code
     4539                       , input v-cntxt-db-num
     4540                       , input "delfbr.err"
     4541                       , input ?
     4542                       , input ?
     4543                       , input v-cntxt-userid
     4544                       , input 0
     4545                       , input (if p-ph-chip-num <> ?
     4546                                then p-ph-chip-num
     4547                                else ( if v-chip-counter = 1
     4548                                       then ?
     4549                                       else varchip-code )
     4550                                )
     4551                       , output varchip-code2
     4552                   ) no-error.
     4553                   if error-status :error
     4554                   then do:
     4555                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     4556                                                     ,buf_cons_trn-doc.doc-code
     4557                                                     ,p-fbr-doc-code
     4558                                                     , chr(10)
     4559                                                     , error-status:get-message(1)
     4560                                                     , return-value ).
     4561                   end.
     4562                   assign
     4563                       p-chip-num = varchip-code2
     4564                   .
     4565               end.
     4566           end.
     4567           assign
     4568               p-chip-num = varchip-code2
     4569           .
     4570       end.
     4571   end.
     4572   END PROCEDURE.
     4573   PROCEDURE fbrlib-print-del-error-message :
     4574   do
     4575   on error undo, return error
     4576   :
     4577       define variable v-user-action   as character    no-undo.
     4578       define variable v-printed       as logical      no-undo.
     4579       message
     4580           vss-workfile vss-revision vss-description
     4581           skip "Ошибка при удалении документа."
     4582           skip return-value
     4583           skip trim(error-status :get-message(1))
     4584           skip trim(error-status :get-message(2))
     4585           skip trim(error-status :get-message(3))
     4586       view-as alert-box error.
     4587       if search ("delfbr.err") <> ?
     4588       then do:
     4589         run gbl/prnfilen.w
     4590           (input  "Ошибки при удалении документа производства"
     4591           ,input  0
     4592           ,input  "delfbr.err"
     4593           ,input  7
     4594           ,output v-user-action
     4595           ,output v-printed
     4596           ).
     4597       end.
     4598   end.
     4599   END PROCEDURE.
     4600   procedure fbrlib-calc-brutto :
     4601   define input parameter p-recipe-type        as character        no-undo.
     4602   define input parameter p-netto              as decimal          no-undo.
     4603   define input parameter p-coeff-value        as decimal          no-undo.
     4604   define input parameter p-coeff-waste        as decimal          no-undo.
     4605   define input parameter p-brutto             as decimal          no-undo.
     4606   define input parameter p-calc-method        as integer          no-undo.
     4607   define output parameter p-new-netto         as decimal          no-undo.
     4608   define output parameter p-new-coeff-waste   as decimal          no-undo.
     4609   define output parameter p-new-brutto        as decimal          no-undo.
     4610   define output parameter p-new-calc-method   as integer          no-undo.
     4611   do
     4612   on error undo, return error
     4613   :
     4614       if p-recipe-type <> 'производство':U
     4615       then do:
     4616           assign
     4617               p-new-coeff-waste = 0
     4618               p-new-calc-method = 1
     4619               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     4620               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     4621           .
     4622       end.
     4623       else do:
     4624           assign
     4625               p-new-calc-method = p-calc-method
     4626           .
     4627           if p-coeff-waste = 0
     4628           then do:
     4629               assign
     4630                   p-coeff-value = 0
     4631               .
     4632           end.
     4633           case p-calc-method
     4634           :
     4635               when 1
     4636               then do:
     4637                   assign
     4638                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4639                       p-new-coeff-waste   = p-coeff-waste
     4640                       p-new-brutto        = p-brutto
     4641                   .
     4642               end.
     4643               when 2
     4644               then do:
     4645                   assign
     4646                       p-new-netto         = p-netto
     4647                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     4648                       p-new-brutto        = p-brutto
     4649                   .
     4650               end.
     4651               when 3
     4652               then do:
     4653                   assign
     4654                       p-new-netto         = p-netto
     4655                       p-new-coeff-waste   = p-coeff-waste
     4656                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     4657                   .
     4658               end.
     4659               otherwise do:
     4660                   define variable v-yesno    as logical      no-undo.
     4661                   assign
     4662                       v-yesno = yes
     4663                   .
     4664                   message
     4665                       "Неверный метод для расчета брутто, нетто и процента потерь."
     4666                       skip "Значение метода должно быть 1, 2 или 3."
     4667                       skip(1)
     4668                       skip "Заданное значение:" p-calc-method
     4669                       skip(1)
     4670                       skip "Установить значение метода расчета 1"
     4671                       skip "(расчет нетто по брутто и проценту потерь)?"
     4672                   view-as alert-box warning
     4673                   buttons yes-no
     4674                   title "Неверное значение метода пересчета в строках документа-производства"
     4675                   update v-yesno
     4676                   .
     4677                   if v-yesno = yes
     4678                   then do:
     4679                       assign
     4680                           p-new-calc-method   = 1
     4681                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4682                           p-new-coeff-waste   = p-coeff-waste
     4683                           p-new-brutto        = p-brutto
     4684                       .
     4685                   end.
     4686                   else do:
     4687                       message
     4688                               vss-workfile vss-revision vss-description
     4689                           skip(1)
     4690                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4691                           skip return-value
     4692                           skip trim(error-status :get-message(1))
     4693                               trim(error-status :get-message(2))
     4694                               trim(error-status :get-message(3))
     4695                       view-as alert-box error
     4696                       title "Неверное значение метода расчета"
     4697                       .
     4698                       undo, return error .
     4699                   end.
     4700               end.
     4701           end case.
     4702       end.
     4703   end.
     4704   end procedure.
     4705   procedure fbrlib-check-brutto :
     4706   define input parameter p-recipe-type        as character        no-undo.
     4707   define input parameter p-netto              as decimal          no-undo.
     4708   define input parameter p-coeff-value        as decimal          no-undo.
     4709   define input parameter p-coeff-waste        as decimal          no-undo.
     4710   define input parameter p-brutto             as decimal          no-undo.
     4711   define input parameter p-calc-method        as integer          no-undo.
     4712   define output parameter p-error-message     as character        no-undo.
     4713   define output parameter p-not-good          as logical          no-undo.
     4714   do
     4715   on error undo, return error
     4716   :
     4717       if p-recipe-type <> 'производство':U
     4718       then do:
     4719           if p-netto <> p-brutto
     4720           or p-coeff-waste <> 0
     4721           then do:
     4722               assign
     4723                   p-not-good      = yes
     4724                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4725                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4726               .
     4727           end.
     4728       end.
     4729       else do:
     4730           if p-coeff-waste = 0
     4731           then do:
     4732               assign
     4733                   p-coeff-value = 0
     4734               .
     4735           end.
     4736           case p-calc-method
     4737           :
     4738               when 1
     4739               then do:
     4740                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4741                   then do:
     4742                       assign
     4743                           p-not-good      = yes
     4744                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4745                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4746                       .
     4747                   end.
     4748               end.
     4749               when 2
     4750               then do:
     4751                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4752                   then do:
     4753                       assign
     4754                           p-not-good      = yes
     4755                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4756                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4757                       .
     4758                   end.
     4759               end.
     4760               when 3
     4761               then do:
     4762                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4763                   then do:
     4764                       assign
     4765                           p-not-good      = yes
     4766                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4767                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4768                       .
     4769                   end.
     4770               end.
     4771               otherwise do:
     4772                   assign
     4773                       p-not-good      = yes
     4774                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4775                   .
     4776               end.
     4777           end case.
     4778       end.
     4779   end.
     4780   end procedure.
     4781   procedure fbrlib-check-fbr-recipe :
     4782   define input parameter p-doc-code       as character        no-undo.
     4783   define input parameter p-recipe-code    as character        no-undo.
     4784   define output parameter p-is-correct    as logical          no-undo.
     4785       define variable v-comp-factor    as decimal      no-undo.
     4786       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4787       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4788       define buffer buf_fbr-line          for ub.fbr-line.
     4789   do
     4790   for buf_fbr-recipe
     4791     , buf_fbr-recipe-gds
     4792     , buf_fbr-line
     4793   on error undo, return error
     4794   :
     4795       assign
     4796           p-is-correct = yes
     4797       .
     4798       find first buf_fbr-recipe no-lock
     4799            where buf_fbr-recipe.doc-code    = p-doc-code
     4800              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4801       .
     4802       if not available buf_fbr-recipe then do:
     4803         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4804       end.
     4805       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4806       then do:
     4807       end.
     4808       else do:
     4809           find first buf_fbr-line no-lock
     4810                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4811                  and buf_fbr-line.is-comp     = yes
     4812                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4813                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4814                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4815                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4816           .
     4817           assign
     4818               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4819           .
     4820           recipe-line-cycle:
     4821           for each buf_fbr-recipe-gds no-lock
     4822              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4823                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4824           on error undo, return error
     4825           :
     4826               find first buf_fbr-line no-lock
     4827                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4828                      and buf_fbr-line.is-comp     = no
     4829                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4830                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4831                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4832                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4833               .
     4834               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4835               then do:
     4836                   assign
     4837                       p-is-correct = no
     4838                   .
     4839                   leave recipe-line-cycle.
     4840               end.
     4841           end.
     4842       end.
     4843   end.
     4844   end procedure.
     4845   procedure fbrlib-get-recipe-type :
     4846   define input parameter p-fbr-doc-code   as character        no-undo.
     4847   define input parameter p-recipe-code    as character        no-undo.
     4848   define output parameter p-recipe-type   as character        no-undo.
     4849       define buffer buf_recipe        for ub.recipe.
     4850       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4851   do
     4852   for buf_recipe
     4853     , buf_fbr-recipe
     4854   on error undo, return error
     4855   :
     4856       if p-fbr-doc-code = ""
     4857       then do:
     4858           find first buf_recipe no-lock
     4859                where buf_recipe.recipe-code = p-recipe-code
     4860           no-error.
     4861           if available buf_recipe
     4862           then do:
     4863               assign
     4864                   p-recipe-type = buf_recipe.recipe-type
     4865               .
     4866           end.
     4867           else do:
     4868               assign
     4869                   p-recipe-type = "":U
     4870               .
     4871           end.
     4872       end.
     4873       else do:
     4874           find first buf_fbr-recipe no-lock
     4875                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4876                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4877           no-error.
     4878           if available buf_fbr-recipe
     4879           then do:
     4880               assign
     4881                   p-recipe-type = buf_fbr-recipe.recipe-type
     4882               .
     4883           end.
     4884           else do:
     4885               assign
     4886                   p-recipe-type = "":U
     4887               .
     4888           end.
     4889       end.
     4890   end.
     4891   end procedure.
     4892   PROCEDURE calc-comp-from-ingr :
     4893   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4894   define input parameter p-fact-qnty                          as decimal      no-undo.
     4895   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4896   define output parameter p-comp-qnty                         as decimal      no-undo.
     4897       define variable v-ingr-qnty     as decimal       no-undo.
     4898       define buffer buf_i_fbr-line    for ub.fbr-line.
     4899       define buffer buf_fbr-line      for ub.fbr-line.
     4900       define buffer buf_recipe        for ub.fbr-recipe.
     4901       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4902   do
     4903   for buf_i_fbr-line
     4904     , buf_fbr-line
     4905     , buf_recipe
     4906     , buf_recipe-gds
     4907   on error undo, return error
     4908   :
     4909       find first buf_i_fbr-line no-lock
     4910            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4911       .
     4912       find first buf_recipe no-lock
     4913            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4914              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4915       no-error.
     4916       if not available buf_recipe
     4917       then do:
     4918           message
     4919                   vss-workfile vss-revision vss-description
     4920               skip "В строке производства не указан рецепт."
     4921               skip "Невозможно рассчитать количество составного товара."
     4922               skip return-value
     4923               skip trim(error-status :get-message(1))
     4924                   trim(error-status :get-message(2))
     4925                   trim(error-status :get-message(3))
     4926           view-as alert-box error.
     4927           undo, return error .
     4928       end.
     4929       if buf_recipe.recipe-type = 'альтернатива':U
     4930       then do:
     4931           for each buf_fbr-line no-lock
     4932              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4933                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4934                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4935           on error undo, return error
     4936           :
     4937               find first buf_recipe-gds no-lock
     4938                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4939                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4940                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4941                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4942                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4943               .
     4944               assign
     4945                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4946               .
     4947           end.
     4948           assign
     4949               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4950           .
     4951       end.
     4952       else do:
     4953           find first buf_recipe-gds no-lock
     4954                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4955                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4956                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4957                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4958                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4959           .
     4960           assign
     4961               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4962           .
     4963       end.
     4964       find first buf_fbr-line no-lock
     4965            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4966              and buf_fbr-line.is-comp     = yes
     4967              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4968       .
     4969       assign
     4970           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4971       .
     4972   end.
     4973   END PROCEDURE.
     4974   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4975   define input parameter p-recipe-code    as character    no-undo.
     4976   define input parameter p-gds-code       as integer      no-undo.
     4977   define output parameter p-line-qnty     as decimal      no-undo.
     4978   define output parameter p-used-qnty     as decimal      no-undo.
     4979   define output parameter p-recipe-qnty   as decimal      no-undo.
     4980       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4981   do
     4982   for buf_temp_dressing-ingr
     4983   on error undo, return error
     4984   :
     4985       find first buf_temp_dressing-ingr no-lock
     4986            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4987              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4988       no-error.
     4989       if available buf_temp_dressing-ingr
     4990       then do:
     4991           assign
     4992               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4993               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4994               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4995           .
     4996       end.
     4997       else do:
     4998           assign
     4999               p-line-qnty     = 0
     5000               p-used-qnty     = 0
     5001               p-recipe-qnty   = 0
     5002           .
     5003       end.
     5004   end.
     5005   END PROCEDURE.
     5006   PROCEDURE fbrlib_adjust-recipe :
     5007   do
     5008   on error undo, return error
     5009   :
     5010   define input parameter parparentproc as widget-handle no-undo .
     5011   define input parameter p-fbrhist-handle as handle no-undo .
     5012   define input parameter p-doc-code       as character    no-undo.
     5013   define input parameter p-recipe-code    as character    no-undo.
     5014   define input parameter p-price-sale-obj-type as character no-undo .
     5015   define input parameter p-price-sale-obj-code as integer no-undo .
     5016       define variable v-recipe-qnty       as decimal      no-undo.
     5017       define variable v-comp-qnty         as decimal      no-undo.
     5018       define variable v-recipe-gds-qnty   as decimal      no-undo.
     5019       define variable v-ingr-qnty         as decimal      no-undo.
     5020       define variable v-qnty              as decimal      no-undo.
     5021       define variable v-coeff-waste       as decimal      no-undo.
     5022       define variable v-brutto-qnty       as decimal      no-undo.
     5023       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5024       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5025       define buffer buf_fbr-line          for ub.fbr-line.
     5026       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     5027       find first buf_fbr-recipe no-lock
     5028            where buf_fbr-recipe.doc-code      = p-doc-code
     5029              and buf_fbr-recipe.recipe-code   = p-recipe-code
     5030       .
     5031       assign
     5032           v-recipe-qnty = buf_fbr-recipe.qnty
     5033       .
     5034       find first buf_fbr-line no-lock
     5035            where buf_fbr-line.doc-code    = p-doc-code
     5036              and buf_fbr-line.is-comp     = yes
     5037              and buf_fbr-line.recipe-code = p-recipe-code
     5038       .
     5039       assign
     5040           v-comp-qnty = buf_fbr-line.fact-qnty
     5041       .
     5042       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     5043       then do:
     5044       end.
     5045       else do:
     5046           for each buf_fbr-recipe-gds no-lock
     5047              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     5048                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     5049           on error undo, return error
     5050           :
     5051               find first buf_fbr-line no-lock
     5052                    where buf_fbr-line.doc-code    = p-doc-code
     5053                      and buf_fbr-line.is-comp     = no
     5054                      and buf_fbr-line.recipe-code = p-recipe-code
     5055                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5056                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5057                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5058               .
     5059               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     5060               then do:
     5061                   do transaction
     5062                   on error undo, return error
     5063                   :
     5064                       find first buf_el_fbr-recipe-gds exclusive-lock
     5065                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     5066                       .
     5067                       assign
     5068                           buf_el_fbr-recipe-gds.calc-method   = 1
     5069                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     5070                       .
     5071                       run fbrlib-calc-brutto in this-procedure (
     5072                             input buf_fbr-recipe.recipe-type
     5073                           , input 0
     5074                           , input buf_el_fbr-recipe-gds.coeff-value
     5075                           , input buf_el_fbr-recipe-gds.coeff-waste
     5076                           , input buf_el_fbr-recipe-gds.brutto-qnty
     5077                           , input 1
     5078                           , output buf_el_fbr-recipe-gds.qnty
     5079                           , output buf_el_fbr-recipe-gds.coeff-waste
     5080                           , output buf_el_fbr-recipe-gds.brutto-qnty
     5081                           , output buf_el_fbr-recipe-gds.calc-method
     5082                       ).
     5083                   end.
     5084               end.
     5085           end.
     5086           run fbrlib_adjust-doc-lines in this-procedure (
     5087                 input parparentproc
     5088               , input p-fbrhist-handle
     5089               , input p-doc-code
     5090               , input p-recipe-code
     5091               , input p-price-sale-obj-type
     5092               , input p-price-sale-obj-code
     5093           ).
     5094       end.
     5095   end.
     5096   END PROCEDURE.
     5097   PROCEDURE fbrlib_adjust-doc-lines :
     5098   define input parameter parparentproc as widget-handle no-undo .
     5099   define input parameter p-fbrhist-handle as handle no-undo .
     5100   define input parameter p-doc-code       as character    no-undo.
     5101   define input parameter p-recipe-code    as character    no-undo.
     5102   define input parameter p-price-sale-obj-type as character no-undo .
     5103   define input parameter p-price-sale-obj-code as integer no-undo .
     5104   define variable v-comp-qnty         as decimal      no-undo.
     5105   define variable v-trn-type          as character    no-undo.
     5106   define variable v-ingr-qnty         as decimal      no-undo.
     5107   define variable v-recipe-qnty       as decimal      no-undo.
     5108   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     5109   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5110   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5111   define buffer buf_fbr-line          for ub.fbr-line.
     5112   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     5113   define buffer buf_goods             for ub.goods.
     5114   define buffer buf_fbr-doc           for ub.fbr-doc.
     5115   do
     5116   for buf_fbr-recipe
     5117     , buf_fbr-recipe-gds
     5118     , buf_fbr-line
     5119     , buf_coeff_fbr-line
     5120     , buf_goods
     5121     , buf_fbr-doc
     5122   on error undo, return error
     5123   :
     5124       find first buf_fbr-line no-lock
     5125            where buf_fbr-line.doc-code      = p-doc-code
     5126              and buf_fbr-line.is-comp       = yes
     5127              and buf_fbr-line.recipe-code   = p-recipe-code
     5128       .
     5129       find first buf_fbr-doc no-lock
     5130            where buf_fbr-doc.doc-code      = p-doc-code
     5131       .
     5132       assign
     5133           v-comp-qnty = buf_fbr-line.fact-qnty
     5134           v-trn-type  = buf_fbr-line.trn-type
     5135       .
     5136       find first buf_fbr-recipe no-lock
     5137            where buf_fbr-recipe.doc-code    = p-doc-code
     5138              and buf_fbr-recipe.recipe-code = p-recipe-code
     5139       .
     5140       assign
     5141       v-recipe-qnty = buf_fbr-recipe.qnty
     5142       .
     5143       do transaction
     5144       on error undo, return error
     5145       :
     5146           for each buf_fbr-recipe-gds no-lock
     5147              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     5148                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     5149           on error undo, return error
     5150           :
     5151               find first buf_fbr-line no-lock
     5152                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5153                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5154                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5155                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5156                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5157               no-error.
     5158               if not available buf_fbr-line
     5159               then do:
     5160                   find first buf_goods no-lock
     5161                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5162                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5163                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5164                   .
     5165                   run str/fbr-crln.p (
     5166                         input parparentproc
     5167                       , input recid( buf_fbr-doc )
     5168                       , input recid( buf_goods )
     5169                       , input buf_fbr-recipe-gds.recipe-code
     5170                       , input v-trn-type
     5171                       , input no
     5172                       , input no
     5173                       , input buf_fbr-doc.obj-type
     5174                       , input buf_fbr-doc.obj-code
     5175                       , output v-fbr-v-fbr-doc-line-recid
     5176                   ).
     5177                   find first buf_fbr-line no-lock
     5178                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5179                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5180                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5181                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5182                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5183                   no-error.
     5184                   if not available buf_fbr-line
     5185                   then do:
     5186                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     5187                                                      , p-doc-code
     5188                                                      , buf_fbr-recipe-gds.artic
     5189                                                      , buf_fbr-recipe-gds.prod-type
     5190                                                      , buf_fbr-recipe-gds.prod-code).
     5191                   end.
     5192               end.
     5193               find first buf_coeff_fbr-line exclusive-lock
     5194                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     5195               .
     5196               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     5197               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     5198               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     5199               then do:
     5200                   assign
     5201                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     5202                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     5203                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     5204                   .
     5205               end.
     5206           end.
     5207       end.
     5208       define variable v-need-goods    as logical       no-undo.
     5209       define variable v-need-goods-list       as character     no-undo.
     5210       define variable v-need-goods-qnty-list  as character     no-undo.
     5211       find first buf_fbr-line no-lock
     5212            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     5213              and buf_fbr-line.is-comp     = yes
     5214              and buf_fbr-line.recipe-code = p-recipe-code
     5215       .
     5216       run str/fbr-qnty.p (
     5217             input parparentproc
     5218           , input p-fbrhist-handle
     5219           , input recid( buf_fbr-doc )
     5220           , input recid( buf_fbr-line )
     5221           , input no
     5222           , input "ingr"
     5223           , input no
     5224           , input p-price-sale-obj-type
     5225           , input p-price-sale-obj-code
     5226           , input no
     5227           , input no
     5228           , input no
     5229           , output v-need-goods
     5230           , output v-need-goods-list
     5231           , output v-need-goods-qnty-list
     5232       ).
     5233   end.
     5234   END PROCEDURE.
     5235   procedure fbrlib_check-before-close :
     5236   define input parameter p-doc-code as character no-undo .
     5237   define variable same-sale as decimal no-undo .
     5238   define variable is-waste as logical no-undo .
     5239   define variable fix-price as logical no-undo .
     5240   define buffer buf_fbr-doc for ub.fbr-doc.
     5241   define buffer buf_fbr-line for ub.fbr-line.
     5242   define buffer buf_goods for ub.goods.
     5243   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     5244   do
     5245   on error undo, return error
     5246   :
     5247     for each buf_fbr-line no-lock
     5248         where buf_fbr-line.doc-code = p-doc-code
     5249       , each buf_goods no-lock
     5250         where buf_goods.artic     = buf_fbr-line.artic
     5251           and buf_goods.prod-type = buf_fbr-line.prod-type
     5252           and buf_goods.prod-code = buf_fbr-line.prod-code
     5253     break by buf_fbr-line.prod-type
     5254           by buf_fbr-line.prod-code
     5255           by buf_fbr-line.artic
     5256     :
     5257       if first-of (buf_fbr-line.artic)
     5258       then do:
     5259         assign
     5260         same-sale = buf_fbr-line.price-sale
     5261         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     5262         fix-price = buf_fbr-line.is-calc
     5263         .
     5264       end.
     5265       if same-sale <> buf_fbr-line.price-sale
     5266       then do:
     5267           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     5268                                         ,p-doc-code
     5269                                         ,buf_goods.artic
     5270                                         ,buf_goods.gds-name
     5271                                         ,chr(10)).
     5272       end.
     5273       if fix-price <> buf_fbr-line.is-calc then do:
     5274           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     5275                                         ,p-doc-code
     5276                                         ,buf_goods.artic
     5277                                         ,buf_goods.gds-name
     5278                                         ,chr(10)).
     5279       end.
     5280       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     5281       then do:
     5282         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     5283                                         ,p-doc-code
     5284                                         ,buf_goods.artic
     5285                                         ,buf_goods.gds-name
     5286                                         ,chr(10)).
     5287       end.
     5288       if buf_fbr-line.rsrv-qnty <> ?
     5289       and buf_goods.gds-type <> 'у':U
     5290       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     5291       and buf_fbr-line.fact-qnty <> 0
     5292       then do:
     5293         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     5294           if  can-find(first buf_fbr-gds-obj no-lock where
     5295                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5296               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     5297               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     5298               and buf_fbr-gds-obj.is-null-price  )  then .
     5299                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     5300                                         ,p-doc-code
     5301                                         ,buf_goods.artic
     5302                                         ,buf_goods.gds-name
     5303                                         ,chr(10)
     5304                                         ,buf_fbr-line.recipe-code
     5305                                         ).
     5306         end.
     5307         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     5308                                         ,p-doc-code
     5309                                         ,buf_goods.artic
     5310                                         ,buf_goods.gds-name
     5311                                         ,chr(10)
     5312                                         ,buf_fbr-line.recipe-code
     5313                                         ).
     5314       end.
     5315     end.
     5316   end.
     5317   end procedure.
     5318       define variable v-write-off-sum-price-rubl        as decimal        no-undo.
     5319       define variable v-write-off-sum-price-base        as decimal        no-undo.
     5320       define variable v-write-off-sum-vat-price-rubl    as decimal        no-undo.
     5321       define variable v-write-off-sum-vat-price-base    as decimal        no-undo.
     5322       define buffer buf_doc-line      for doc-line.
     5323       define buffer buf_fbr-line      for fbr-line.
     5324   do
     5325   for buf_doc-line
     5326     , buf_fbr-line
     5327   on error undo, return error
     5328   :
     5329           find first buf_doc-line no-lock
     5330                where buf_doc-line.doc-code    = p-trn-doc-code
     5331                  and buf_doc-line.artic       = p-artic
     5332                  and buf_doc-line.prod-type   = p-prod-type
     5333                  and buf_doc-line.prod-code   = p-prod-code
     5334           .
     5335           run clcprtsl_calc-line in this-procedure (
     5336               input recid( buf_doc-line )
     5337           ).
     5338           find first tt-allsum-line
     5339                where tt-allsum-line.sum-type = 'основная_сумма':U
     5340           .
     5341           find first buf_fbr-line exclusive-lock
     5342                where buf_fbr-line.doc-code    = p-fbr-doc-code
     5343                  and buf_fbr-line.trn-type    = p-trn-type
     5344                  and buf_fbr-line.recipe-code = p-recipe-code
     5345                  and buf_fbr-line.artic       = p-artic
     5346                  and buf_fbr-line.prod-type   = p-prod-type
     5347                  and buf_fbr-line.prod-code   = p-prod-code
     5348           .
     5349           assign
     5350               buf_fbr-line.price-sum-base     = tt-allsum-line.sum-dsc-base-acc - tt-allsum-line.vat-base-acc
     5351               buf_fbr-line.price-sum-rubl     = tt-allsum-line.sum-dsc-rubl-acc - tt-allsum-line.vat-rubl-acc
     5352               buf_fbr-line.price-sum-vat-base = tt-allsum-line.vat-base-acc
     5353               buf_fbr-line.price-sum-vat-rubl = tt-allsum-line.vat-rubl-acc
     5354               buf_fbr-line.price-base         = buf_fbr-line.price-sum-base / buf_fbr-line.fact-qnty
     5355               buf_fbr-line.price-rubl         = buf_fbr-line.price-sum-rubl / buf_fbr-line.fact-qnty
     5356           .
     5357           if p-is-free = yes
     5358           then do:
     5359               assign
     5360                   v-write-off-sum-price-rubl     = 0
     5361                   v-write-off-sum-price-base     = 0
     5362                   v-write-off-sum-vat-price-rubl = 0
     5363                   v-write-off-sum-vat-price-base = 0
     5364               .
     5365               for each buf_fbr-line no-lock
     5366                  where buf_fbr-line.doc-code    = p-fbr-doc-code
     5367                    and buf_fbr-line.trn-type    = 'спи':U
     5368               on error undo, return error
     5369               :
     5370                   assign
     5371                       v-write-off-sum-price-rubl     = v-write-off-sum-price-rubl     + buf_fbr-line.price-sum-rubl
     5372                       v-write-off-sum-price-base     = v-write-off-sum-price-base     + buf_fbr-line.price-sum-base
     5373                       v-write-off-sum-vat-price-rubl = v-write-off-sum-vat-price-rubl + buf_fbr-line.price-sum-vat-rubl
     5374                       v-write-off-sum-vat-price-base = v-write-off-sum-vat-price-base + buf_fbr-line.price-sum-vat-base
     5375                   .
     5376               end.
     5377               run fbrlib-calc-free-doc-in-costs in this-procedure (
     5378                     input p-fbr-doc-code
     5379                   , input v-write-off-sum-price-rubl
     5380                   , input v-write-off-sum-price-base
     5381                   , input v-write-off-sum-vat-price-rubl
     5382                   , input v-write-off-sum-vat-price-base
     5383               ) no-error .
     5384              if error-status:error then do:
     5385                 undo, return error substitute("Ошибка при расчете цен для документа производства &1&2&3&2&4"
     5386                                              , p-fbr-doc-code
     5387                                              , chr(10)
     5388                                              , error-status:get-message(1)
     5389                                              , return-value
     5390               ).
     5391              end.
     5392           end.
     5393           else do:
     5394               run fbrlib-calc-all-cost-prices in this-procedure (
     5395                   input p-fbr-doc-code
     5396               ) no-error.
     5397              if error-status:error then do:
     5398                 undo, return error substitute("Ошибка при расчете учетных цен для документа производства &1&2&3&2&4"
     5399                                              , p-fbr-doc-code
     5400                                              , chr(10)
     5401                                              , error-status:get-message(1)
     5402                                              , return-value
     5403               ).
     5404              end.
     5405           end.
     5406   end.
     5407   procedure fbrlib-calc-all-cost-prices :
     5408       define input parameter p-fbr-doc-code   as character    no-undo.
     5409       define buffer buf_fbr-line      for fbr-line.
     5410       define buffer buf_recipe        for recipe.
     5411       define buffer buf_fbr-doc       for fbr-doc.
     5412   do
     5413   for buf_fbr-line
     5414     , buf_recipe
     5415     , buf_fbr-doc
     5416   on error undo, return error
     5417   :
     5418       find first buf_fbr-doc no-lock
     5419            where buf_fbr-doc.doc-code = p-fbr-doc-code
     5420       .
     5421       for each buf_fbr-line no-lock
     5422          where buf_fbr-line.doc-code = p-fbr-doc-code
     5423            and buf_fbr-line.is-comp  = yes
     5424       :
     5425           find first buf_recipe no-lock
     5426                where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     5427           no-error.
     5428           if ( available buf_recipe
     5429              and ( buf_recipe.recipe-type <> 'разделка':U
     5430              and ( buf_recipe.recipe-type <> 'комплектация':U ) )
     5431           or buf_fbr-line.trn-type  <> 'при':U )
     5432           then do:
     5433               run fbrlib-calc-inc-fbr-ln-costs in this-procedure (
     5434                     input buf_fbr-line.doc-code
     5435                   , input buf_fbr-line.recipe-code
     5436               ) no-error.
     5437              if error-status:error then do:
     5438                 undo, return error substitute("Ошибка при расчете цен для документа производства &1&2&3&2&4"
     5439                                              , p-fbr-doc-code
     5440                                              , chr(10)
     5441                                              , error-status:get-message(1)
     5442                                              , return-value
     5443               ).
     5444           end.
     5445           end.
     5446           else do:
     5447               run fbrlib-calc-w-o-fbr-ln-costs in this-procedure (
     5448                     input buf_fbr-line.doc-code
     5449                   , input buf_fbr-line.recipe-code
     5450               ) no-error .
     5451             undo, return error substitute("Ошибка при расчете цен для компонентов документа производства &1&2&3&2&4"
     5452                                           , p-fbr-doc-code
     5453                                           , chr(10)
     5454                                           , error-status:get-message(1)
     5455                                           , return-value
     5456               ).
     5457           end.
     5458       end.
     5459       run fbrlib-fill-sum-fbr-doc in this-procedure (
     5460             input recid( buf_fbr-doc )
     5461           , input 'reserv':U
     5462       ) no-error.
     5463       if error-status:error then do:
     5464         undo, return error substitute("Ошибка при заполнении сумм по документу производства &1&2&3&2&4"
     5465                                       , p-fbr-doc-code
     5466                                       , chr(10)
     5467                                       , error-status:get-message(1)
     5468                                       , return-value
     5469       ).
     5470   end.
     5471   end.
     5472   end procedure.
     5473   procedure fbrlib-calc-inc-fbr-ln-costs :
     5474   do
     5475   on error undo, return error
     5476   :
     5477   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     5478   define input parameter p-recipe-code        as character    no-undo.
     5479       define variable v-sum-price-rubl     as decimal       no-undo.
     5480       define variable v-sum-price-base     as decimal       no-undo.
     5481       define variable v-sum-vat-price-rubl as decimal       no-undo.
     5482       define variable v-sum-vat-price-base as decimal       no-undo.
     5483       define buffer buf_income_fbr-line     for fbr-line.
     5484       define buffer buf_write-off_fbr-line     for fbr-line.
     5485       for each buf_write-off_fbr-line no-lock
     5486          where buf_write-off_fbr-line.doc-code    = p-fbr-doc-doc-code
     5487            and buf_write-off_fbr-line.trn-type    = 'спи':U
     5488            and buf_write-off_fbr-line.recipe-code = p-recipe-code
     5489       on error undo, return error
     5490       :
     5491           assign
     5492               v-sum-price-rubl     = v-sum-price-rubl     + ( if buf_write-off_fbr-line.price-rubl <> ? then buf_write-off_fbr-line.fact-qnty * buf_write-off_fbr-line.price-rubl else 0 )
     5493               v-sum-price-base     = v-sum-price-base     + ( if buf_write-off_fbr-line.price-base <> ? then buf_write-off_fbr-line.fact-qnty * buf_write-off_fbr-line.price-base else 0 )
     5494               v-sum-vat-price-rubl = v-sum-vat-price-rubl + ( if buf_write-off_fbr-line.price-sum-vat-rubl <> ? then buf_write-off_fbr-line.price-sum-vat-rubl else 0 )
     5495               v-sum-vat-price-base = v-sum-vat-price-base + ( if buf_write-off_fbr-line.price-sum-vat-base <> ? then buf_write-off_fbr-line.price-sum-vat-base else 0 )
     5496           .
     5497       end.
     5498       do transaction
     5499       on error undo, return error
     5500       :
     5501           find first buf_income_fbr-line exclusive-lock
     5502                where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     5503                  and buf_income_fbr-line.trn-type    = 'при':U
     5504                  and buf_income_fbr-line.recipe-code = p-recipe-code
     5505           .
     5506           assign
     5507               buf_income_fbr-line.price-sum-rubl        = v-sum-price-rubl
     5508               buf_income_fbr-line.price-sum-base        = v-sum-price-base
     5509               buf_income_fbr-line.price-sum-vat-rubl    = v-sum-vat-price-rubl
     5510               buf_income_fbr-line.price-sum-vat-base    = v-sum-vat-price-base
     5511               buf_income_fbr-line.price-rubl            = v-sum-price-rubl / buf_income_fbr-line.fact-qnty
     5512               buf_income_fbr-line.price-base            = v-sum-price-base / buf_income_fbr-line.fact-qnty
     5513           .
     5514       end.
     5515   end.
     5516   end procedure.
     5517   procedure fbrlib-calc-w-o-fbr-ln-costs :
     5518   do
     5519   on error undo, return error
     5520   :
     5521   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     5522   define input parameter p-recipe-code        as character    no-undo.
     5523       define variable v-sum-price-sale            as decimal      no-undo.
     5524       define variable v-sum-price-cost-rubl       as decimal      no-undo.
     5525       define variable v-sum-price-cost-base       as decimal      no-undo.
     5526       define variable v-sum-price-vat-cost-rubl   as decimal      no-undo.
     5527       define variable v-sum-price-vat-cost-base   as decimal      no-undo.
     5528       define variable v-cost-factor               as decimal      no-undo.
     5529       define variable v-write-off-qnty            as decimal      no-undo.
     5530       define buffer buf_income_fbr-line     for fbr-line.
     5531       define buffer buf_write-off_fbr-line     for fbr-line.
     5532       for each buf_income_fbr-line no-lock
     5533          where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     5534            and buf_income_fbr-line.trn-type    = 'при':U
     5535            and buf_income_fbr-line.recipe-code = p-recipe-code
     5536            and buf_income_fbr-line.fix-cost    = no
     5537            and buf_income_fbr-line.is-waste    = no
     5538       on error undo, return error
     5539       :
     5540           assign
     5541               v-sum-price-sale = v-sum-price-sale + ( buf_income_fbr-line.price-sale * buf_income_fbr-line.fact-qnty )
     5542           .
     5543       end.
     5544       find first buf_write-off_fbr-line no-lock
     5545            where buf_write-off_fbr-line.doc-code    = p-fbr-doc-doc-code
     5546              and buf_write-off_fbr-line.trn-type    = 'спи':U
     5547              and buf_write-off_fbr-line.recipe-code = p-recipe-code
     5548       .
     5549       assign
     5550           v-write-off-qnty          = buf_write-off_fbr-line.fact-qnty
     5551           v-sum-price-cost-rubl     = buf_write-off_fbr-line.price-sum-rubl
     5552           v-sum-price-cost-base     = buf_write-off_fbr-line.price-sum-base
     5553           v-sum-price-vat-cost-rubl = buf_write-off_fbr-line.price-sum-vat-rubl
     5554           v-sum-price-vat-cost-base = buf_write-off_fbr-line.price-sum-vat-base
     5555       .
     5556       for each buf_income_fbr-line exclusive-lock
     5557          where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     5558            and buf_income_fbr-line.trn-type    = 'при':U
     5559            and buf_income_fbr-line.recipe-code = p-recipe-code
     5560            and ( buf_income_fbr-line.fix-cost    = yes
     5561                   )
     5562       on error undo, return error
     5563       :
     5564           assign
     5565               v-write-off-qnty          = v-write-off-qnty          - buf_income_fbr-line.fact-qnty
     5566               v-sum-price-cost-rubl     = v-sum-price-cost-rubl     - buf_income_fbr-line.price-sum-rubl
     5567               v-sum-price-cost-base     = v-sum-price-cost-base     - buf_income_fbr-line.price-sum-base
     5568               v-sum-price-vat-cost-rubl = v-sum-price-vat-cost-rubl - buf_income_fbr-line.price-sum-vat-rubl
     5569               v-sum-price-vat-cost-base = v-sum-price-vat-cost-base - buf_income_fbr-line.price-sum-vat-base
     5570           .
     5571       end.
     5572       do transaction
     5573       on error undo, return error
     5574       :
     5575           for each buf_income_fbr-line exclusive-lock
     5576              where buf_income_fbr-line.doc-code    = p-fbr-doc-doc-code
     5577                and buf_income_fbr-line.trn-type    = 'при':U
     5578                and buf_income_fbr-line.recipe-code = p-recipe-code
     5579                and buf_income_fbr-line.fix-cost    = no
     5580                and buf_income_fbr-line.is-waste    = no
     5581           on error undo, return error
     5582           :
     5583               assign
     5584                   v-cost-factor                            = buf_income_fbr-line.price-sale * buf_income_fbr-line.fact-qnty / v-sum-price-sale
     5585                   buf_income_fbr-line.price-sum-rubl       = v-sum-price-cost-rubl        * v-cost-factor
     5586                   buf_income_fbr-line.price-sum-base       = v-sum-price-cost-base        * v-cost-factor
     5587                   buf_income_fbr-line.price-sum-vat-rubl   = v-sum-price-vat-cost-rubl    * v-cost-factor
     5588                   buf_income_fbr-line.price-sum-vat-base   = v-sum-price-vat-cost-base    * v-cost-factor
     5589                   buf_income_fbr-line.price-rubl           = buf_income_fbr-line.price-sum-rubl / buf_income_fbr-line.fact-qnty
     5590                   buf_income_fbr-line.price-base           = buf_income_fbr-line.price-sum-base / buf_income_fbr-line.fact-qnty
     5591               .
     5592           end.
     5593       end.
     5594   end.
     5595   end procedure.
     5596   procedure fbrlib-calc-free-doc-in-costs :
     5597   define input parameter p-doc-code                       as character    no-undo.
     5598   define input parameter p-write-off-sum-price-rubl       as decimal      no-undo.
     5599   define input parameter p-write-off-sum-price-base       as decimal      no-undo.
     5600   define input parameter p-write-off-sum-vat-price-rubl   as decimal      no-undo.
     5601   define input parameter p-write-off-sum-vat-price-base   as decimal      no-undo.
     5602       define variable v-fbr-line-cost-coeff   as decimal       no-undo.
     5603       define variable v-income-sum-price-sale as decimal       no-undo.
     5604       define buffer buf_fbr-line      for fbr-line.
     5605   do
     5606   for buf_fbr-line
     5607   on error undo, return error
     5608   :
     5609       for each buf_fbr-line no-lock
     5610          where buf_fbr-line.doc-code = p-doc-code
     5611            and buf_fbr-line.trn-type = 'при':U
     5612       on error undo, return error
     5613       :
     5614           assign
     5615               v-income-sum-price-sale = v-income-sum-price-sale   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     5616           .
     5617       end.
     5618       for each buf_fbr-line exclusive-lock
     5619          where buf_fbr-line.doc-code = p-doc-code
     5620            and buf_fbr-line.trn-type = 'при':U
     5621       on error undo, return error
     5622       :
     5623           assign
     5624               buf_fbr-line.rsrv-qnty          = buf_fbr-line.fact-qnty
     5625               v-fbr-line-cost-coeff           = buf_fbr-line.price-sale * buf_fbr-line.fact-qnty / v-income-sum-price-sale
     5626               buf_fbr-line.price-sum-rubl     = p-write-off-sum-price-rubl     * v-fbr-line-cost-coeff
     5627               buf_fbr-line.price-sum-base     = p-write-off-sum-price-base     * v-fbr-line-cost-coeff
     5628               buf_fbr-line.price-sum-vat-rubl = p-write-off-sum-vat-price-rubl * v-fbr-line-cost-coeff
     5629               buf_fbr-line.price-sum-vat-base = p-write-off-sum-vat-price-base * v-fbr-line-cost-coeff
     5630               buf_fbr-line.price-rubl         = buf_fbr-line.price-sum-rubl / buf_fbr-line.fact-qnty
     5631               buf_fbr-line.price-base         = buf_fbr-line.price-sum-base / buf_fbr-line.fact-qnty
     5632           .
     5633       end.
     5634   end.
     5635   end procedure.
