     1459       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     1460       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     1461       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     1462       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     1463       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     1464       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     1465       .
     1466     assign
     1467       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     1468       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     1469       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     1470       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1471       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     1472       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     1473       bfsacc_tt-allsum.vat-base-doc        = 0
     1474       bfsacc_tt-allsum.vat-rubl-doc        = 0
     1475       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     1476       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     1477       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     1478       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     1479       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     1480       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     1481       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     1482       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     1483       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     1484       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     1485       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     1486       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     1487       bfsacc_tt-allsum.vat-base-cur        = 0
     1488       bfsacc_tt-allsum.vat-rubl-cur        = 0
     1489       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     1490       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     1491       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     1492       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     1493       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     1494       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     1495       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     1496       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     1497       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     1498       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     1499       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     1500       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     1501       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1502       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1503       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1504       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1505       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1506       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1507       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1508       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1509       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1510       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1511       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1512       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1513       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1514       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1515       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1516       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1517       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1518       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1519       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1520       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1521       .
     1522   end.
     1523   otherwise do:
     1524     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1525                              cl_tt-clcparts.purch-code,
     1526                              cl_tt-clcparts.part-code,
     1527                              cl_tt-clcparts.out-code,
     1528                              cl_tt-clcparts.in-code,
     1529                              cl_tt-clcparts.artic,
     1530                              cl_tt-clcparts.prod-type,
     1531                              cl_tt-clcparts.prod-code).
     1532   end.
     1533   end case.
     1534   end.
     1535   end procedure.
     1536   procedure clcprtsl_calc-line :
     1537   define input  parameter parrec-line as recid no-undo.
     1538   define variable v-tax-date         as   date                     no-undo.
     1539   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1540   define variable varr-b             as   character                no-undo.
     1541   define variable varr-btype         as   character                no-undo.
     1542   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1543   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1544   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1545   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1546   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1547   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1548   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1549   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1550   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1551   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1552   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1553   define variable varexcise          like ub.price-list.excise     no-undo.
     1554   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1555   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1556   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1557   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1558   define variable v-varsum           as decimal                  no-undo.
     1559   define variable varprice-salef as decimal   no-undo .
     1560   define buffer bf_trn-doc             for ub.trn-doc.
     1561   define buffer bf_doc-line            for ub.doc-line.
     1562   define buffer bf_gds-dtl             for ub.gds-dtl.
     1563   define buffer bf_goods               for ub.goods.
     1564   define buffer bf_parts               for ub.parts.
     1565   define buffer bf_sysconf             for ub.sysconf.
     1566   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1567   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1568   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1569   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1570   define buffer buf_parts        for ub.parts.
     1571   v-calcbypart = no.
     1572   do on error undo, return error return-value :
     1573   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1575     (output varr-b
     1576     )  .
     1577     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1578     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1579     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1580                               bf_goods.prod-type = bf_doc-line.prod-type and
     1581                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1582     if bf_trn-doc.fact-date <> ?        then do:
     1583       assign v-tax-date = bf_trn-doc.fact-date.
     1584     end.
     1585     else do:
     1586       assign v-tax-date = ?.
     1587     end.
     1588   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1590     (input  bf_goods.gds-code
     1591     ,input  '1':U
     1592     ,input  v-tax-date
     1593     ,input  bf_trn-doc.host-code
     1594     ,input  bf_trn-doc.obj-type
     1595     ,input  bf_trn-doc.obj-code
     1596     ,output v-vat-pc
     1597     ) no-error .
     1598     if error-status :error
     1599     or v-vat-pc = ? then do:
     1600        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1601     end.
     1602     if bf_goods.gds-type = 'у':U or
     1603        bf_trn-doc.status_ = 'запрос':U then do:
     1604       for each bf_tt-allsum-line
     1605       on error undo, return error return-value
     1606        :
     1607         delete bf_tt-allsum-line.
     1608       end.
     1609       create bf_tt-allsum-line.
     1610       assign
     1611        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1612       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1613                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1614                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1615                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1616         assign
     1617           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1618           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1619           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1620           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1621           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1622           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1623           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1624           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1625           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1626           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1627           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1628           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1629           bf_tt-allsum-line.vat-cli-acc          =  ?
     1630           .
     1631       end.
     1632       assign
     1633         bf_tt-allsum-line.cli-qnty             =  ?
     1634         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1635         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1636         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1637         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1638         bf_tt-allsum-line.road-tax-base-doc    =  0
     1639         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1640         bf_tt-allsum-line.excise-base-doc      =  0
     1641         bf_tt-allsum-line.excise-rubl-doc      =  0
     1642         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1643         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1644         bf_tt-allsum-line.dsc-base-cur         =  0
     1645         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1646         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1647         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1648         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1649         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1650         bf_tt-allsum-line.road-tax-base-cur    =  0
     1651         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1652         bf_tt-allsum-line.excise-base-cur      =  0
     1653         bf_tt-allsum-line.excise-rubl-cur      =  0
     1654         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1655         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1656         bf_tt-allsum-line.dsc-base-acc         =  0
     1657         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1658         bf_tt-allsum-line.dsc-cli-acc          =  0
     1659         bf_tt-allsum-line.slt-base-acc         =  0
     1660         bf_tt-allsum-line.slt-rubl-acc         =  0
     1661         bf_tt-allsum-line.slt-cli-acc          =  0
     1662         bf_tt-allsum-line.road-tax-base-acc    =  0
     1663         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1664         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1665         bf_tt-allsum-line.excise-base-acc      =  0
     1666         bf_tt-allsum-line.excise-rubl-acc      =  0
     1667         bf_tt-allsum-line.excise-cli-acc       =  0
     1668         bf_tt-allsum-line.transport-base-acc   =  0
     1669         bf_tt-allsum-line.transport-rubl-acc   =  0
     1670         bf_tt-allsum-line.transport-cli-acc    =  0
     1671         bf_tt-allsum-line.other-base-acc       =  0
     1672         bf_tt-allsum-line.other-rubl-acc       =  0
     1673         bf_tt-allsum-line.other-cli-acc        =  0
     1674         .
     1675       create bfs_tt-allsum-line.
     1676       assign
     1677       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     1678       if bf_trn-doc.doc-type = 'инв':U or
     1679          bf_trn-doc.doc-type = 'при':U    or
     1680          bf_trn-doc.doc-type = 'возврат':U    then do:
     1681          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     1682       end.
     1683       else do:
     1684         assign
     1685           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     1686           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     1687           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     1688           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     1689           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     1690           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     1691           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     1692           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     1693           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     1694           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     1695           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     1696           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     1697           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     1698           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     1699           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     1700           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     1701           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     1702           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
