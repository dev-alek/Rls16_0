     2407   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2408   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2409   :
     2410   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
