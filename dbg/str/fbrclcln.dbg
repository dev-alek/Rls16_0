     2165   procedure cur-time :
     2166      define output parameter p-today as date      no-undo .
     2167      define output parameter p-time  as integer   no-undo .
     2168     do
     2169     on error undo, return error
     2170     :
     2171       define variable v-date1 as date      no-undo .
     2172       define variable v-date2 as date      no-undo .
     2173       define variable v-time  as integer   no-undo .
     2174       assign
     2175         v-date1 = today
     2176         v-time  = time
     2177         v-date2 = today
     2178       .
     2179       if v-date1 <> v-date2
     2180       then do:
     2181         assign
     2182           v-date1 = today
     2183           v-time  = v-time
     2184         .
     2185       end.
     2186       assign
     2187         p-today = v-date1
     2188         p-time  = v-time
     2189       .
     2190     end.
     2191   end.
     2192   function cur-time-date returns character
     2193   :
     2194     return string(today, '99/99/9999':U) .
     2195   end.
     2196   function cur-time-mjd returns decimal
     2197   :
     2198     define variable v-date as date      no-undo .
     2199     define variable v-time as integer   no-undo .
     2200     run cur-time in this-procedure
     2201       (output v-date
     2202       ,output v-time
     2203       ) .
     2204     return integer(v-date) - 2400002 + (v-time / 86400) .
     2205   end.
     2206   function cur-time-get-ending-index returns integer
     2207   (input p-number as integer
     2208   )
     2209   :
     2210     if p-number < 0
     2211     or p-number = ?
     2212     then do:
     2213       return 1 .
     2214     end.
     2215     define variable v-rest as integer   no-undo .
     2216     assign
     2217       p-number = p-number modulo 100
     2218     .
     2219     if p-number < 20
     2220     then do:
     2221       assign
     2222         v-rest = p-number
     2223       .
     2224     end.
     2225     else do:
     2226       assign
     2227         v-rest = p-number modulo 10
     2228       .
     2229     end.
     2230     case v-rest :
     2231       when 1
     2232       then do:
     2233         return 2 .
     2234       end.
     2235       when 2 or
     2236       when 3 or
     2237       when 4
     2238       then do:
     2239         return 3 .
     2240       end.
     2241       otherwise do:
     2242         return 1 .
     2243       end.
     2244     end case .
     2245   end.
     2246   procedure cur-time-mjd-to-date :
     2247      define input  parameter i-mjd-diff as decimal no-undo.
     2248      define output parameter o-Date     as date    no-undo.
     2249      define output parameter o-Time     as integer no-undo.
     2250      define variable v-day-number as integer   no-undo .
     2251      if    i-mjd-diff < 0
     2252         or i-mjd-diff = ?
     2253      then do:
     2254         return "?" .
     2255      end.
     2256      assign
     2257         v-day-number = truncate(i-mjd-diff,0).
     2258         o-Date = date(v-day-number + 2400002).
     2259         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2260     .
     2261   end.
     2262   function cur-time-mjd-to-string returns character
     2263   (input p-mjd-diff as decimal
     2264   )
     2265   :
     2266     define variable v-day-number as integer   no-undo .
     2267     define variable v-seconds    as integer   no-undo .
     2268     define variable v-hour       as integer   no-undo .
     2269     define variable v-min        as integer   no-undo .
     2270     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2271     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2272     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2273     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2274     if p-mjd-diff < 0
     2275     or p-mjd-diff = ?
     2276     then do:
     2277       return "?" .
     2278     end.
     2279     assign
     2280       v-day-number = integer(truncate(p-mjd-diff,0))
     2281       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2282     .
     2283     if v-seconds > 86400
     2284     then do:
     2285       assign
     2286         v-seconds = 86400 - 1
     2287       .
     2288     end.
     2289     if v-seconds < 0
     2290     then do:
     2291       assign
     2292         v-seconds = 0
     2293       .
     2294     end.
     2295     assign
     2296       v-hour = truncate(v-seconds / 3600, 0)
     2297     .
     2298     assign
     2299       v-seconds = v-seconds modulo 3600
     2300     .
     2301     assign
     2302       v-min = truncate(v-seconds / 60, 0)
     2303     .
     2304     assign
     2305       v-seconds = v-seconds modulo 60
     2306     .
     2307     return
     2308         (if v-day-number <> 0
     2309           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2310           else ""
     2311         )
     2312       + (if v-day-number <> 0 or v-hour <> 0
     2313           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2314           else ""
     2315         )
     2316       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2317           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2318           else ""
     2319         )
     2320       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2321       .
     2322   end.
     2323   function cur-time-string returns character
     2324   :
     2325     define variable v-date as date      no-undo .
     2326     define variable v-time as integer   no-undo .
     2327     run cur-time in this-procedure
     2328       (output v-date
     2329       ,output v-time
     2330       ) .
     2331     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2332   end.
     2333   function cur-time-string-sec returns character
     2334   :
     2335     define variable v-date as date      no-undo .
     2336     define variable v-time as integer   no-undo .
     2337     run cur-time in this-procedure
     2338       (output v-date
     2339       ,output v-time
     2340       ) .
     2341     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2342   end.
     2343   function cur-time-custom  returns character
     2344   (input p-prefix as character
     2345   ,input p-date-format as character
     2346   ,input p-delimiter as character
     2347   ,input p-time-format as character
     2348   ,input p-suffix as character
     2349   )
     2350   :
     2351     define variable v-date as date      no-undo .
     2352     define variable v-time as integer   no-undo .
     2353     run cur-time in this-procedure
     2354       (output v-date
     2355       ,output v-time
     2356       ) .
     2357     return
     2358       p-prefix
     2359       + string(v-date, p-date-format)
     2360       + p-delimiter
     2361       + string(v-time, p-time-format)
     2362       + p-suffix
     2363       .
     2364   end.
     2365   function cur-time-print  returns character
     2366   :
     2367     define variable v-date as date      no-undo .
     2368     define variable v-time as integer   no-undo .
     2369     run cur-time in this-procedure
     2370       (output v-date
     2371       ,output v-time
     2372       ) .
     2373     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2374   end.
     2375   function cur-time-datetime returns datetime
     2376   :
     2377     define variable v-char as character no-undo .
     2378     define variable v-datetime as datetime no-undo .
     2379     v-char = cur-time-string().
     2380     v-datetime = datetime(v-char).
     2381     return  v-datetime.
     2382   end.
     2383   function cur-time-string-msec returns character
     2384   :
     2385     define variable v-date as datetime  no-undo .
     2386     v-date = now.
     2387     return string(v-date) .
     2388   end.
     2389   procedure fbrlib_create-fbr-doc :
     2390   define input parameter p-obj-type as character no-undo .
     2391   define input parameter p-obj-code as integer no-undo .
     2392   define input parameter p-userid as character no-undo .
     2393   define output parameter p-fbr-doc-code as character no-undo .
