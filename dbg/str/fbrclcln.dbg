      495   do on error undo, return error return-value :
      496   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      497   for each bf_tt-allsum on error undo, return error return-value :
      498     delete bf_tt-allsum.
      499   end.
      500   assign
      501     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      502     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      503   .
      504   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      505   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      506     (output varinvprbcl
      507     )  .
      508     if cl_tt-clcparts.out-code = 'free-zone':U     or
      509        cl_tt-clcparts.out-code = 'out-zone':U   or
      510        cl_tt-clcparts.doc-type = 'акт':U then do:
      511       assign
      512         in-vatp-have-vat-sltcl = yes.
      513     end.
      514     else do:
      515       find first in-vatp_doc-attrcl no-lock
      516         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      517           and in-vatp_doc-attrcl.attr-code = 'envd':U
      518         no-error .
      519       if not available in-vatp_doc-attrcl then do:
      520         assign
      521           in-vatp-have-vat-sltcl = yes.
      522       end.
      523       else do:
      524            in-vatp-have-vat-sltcl = no.
      525       end.
      526     end.
      527     assign
      528      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      529      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      530     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      531              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      532     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      533             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      534             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      535             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      536             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      537             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      538             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      539       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      540     assign
      541       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      542     assign
      543       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      544       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      545       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      546       transport-cli-loccl  = 0
      547       other-cli-loccl      = 0
      548     .
      549   ASSIGN
      550             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      551       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      552   .
      553   if paris-doc then do:
      554     assign
      555       parartic     = cl_tt-clcparts.artic
      556       parprod-type = cl_tt-clcparts.prod-type
      557       parprod-code = cl_tt-clcparts.prod-code
      558       pardoc-type  = cl_tt-clcparts.doc-type
      559       pardoc-code  = cl_tt-clcparts.out-code
      560       parobj-type  = cl_tt-clcparts.obj-type
      561       parobj-code  = cl_tt-clcparts.obj-code.
      562   if parext-doc-type = 'ot':U or
      563      parext-doc-type = ?                 then do:
      564     assign
      565      out-vatp-have-vat-sltcl = yes.
      566   end.
      567   else do:
      568     find first out-vatp_doc-attrcl no-lock
      569       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      570         and out-vatp_doc-attrcl.attr-code = 'envd':U
      571         no-error .
      572     if not available out-vatp_doc-attrcl then do:
      573       assign
      574         out-vatp-have-vat-sltcl = yes.
      575     end.
      576     else do:
      577        out-vatp-have-vat-sltcl = no.
      578     end.
      579   end.
      580   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      581                                      out-vatp_goodscl.prod-type = parprod-type and
      582                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      583   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      585     (input  parartic
      586     ,input  parprod-type
      587     ,input  parprod-code
      588     ,output varroot-nodecl
      589     ) no-error .
      590   if error-status :error then do:
      591     message
      592       vss-workfile vss-revision vss-description skip
      593       "Ошибка при определении корневого признака товара" skip
      594       "Артикул" parartic parprod-type parprod-code skip
      595       error-status :get-message(1) skip
      596       return-value skip
      597       view-as alert-box error .
      598     undo, return error .
      599   end.
      600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      601     (input  varroot-nodecl
      602     ,input  'empty-scale=request'
      603     ,output varempty-scalecl
      604     ) no-error .
      605   if error-status :error then do:
      606     message
      607       vss-workfile vss-revision vss-description skip
      608       "Ошибка при определении атрибута признака" skip
      609       "Артикул" parartic parprod-type parprod-code skip
      610       "Признак" varroot-nodecl skip
      611       "Запрашивался атрибут" "empty-scale=request" skip
      612       error-status :get-message(1) skip
      613       return-value skip
      614       view-as alert-box error .
      615     undo, return error .
      616   end.
      617   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      619     (output varoutvprbcl
      620     )  .
      621   if varoutvprbcl = "base":u then do:
      622     assign
      623           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      624       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      625     .
      626   end.
      627   else do:
      628     assign
      629           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      630       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      631     .
      632   end.
      633   if varoutvprbcl = "rubl":u then do:
      634     assign
