     1823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1824     (input  bf_trn-doc.obj-type
     1825     ,input  bf_trn-doc.obj-code
     1826     ,input  varb-code
     1827     ,input  0
     1828     ,input  bf_trn-doc.fact-order
     1829     ,output vardoc-num
     1830     ,output varprice-sale
     1831     ,output varroad-tax
     1832     ,output varexcise
     1833     )  .
     1834             if varprice-sale = ?
     1835             then do:
     1836               assign
     1837                 varprice-sale = 0
     1838                 varroad-tax   = 0
     1839                 varexcise     = 0
     1840               .
     1841             end.
     1842             assign
     1843               varlastcur-base     = varprice-sale
     1844               varlastcur-road-tax = varroad-tax
     1845               varlastcur-excise   = varexcise
     1846               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1847               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1848               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1849               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1850             .
     1851         end.
     1852       end.
     1853       if varcur-fact-qnty = 0 then do:
     1854         assign
     1855           varcur-base      = varlastcur-base
     1856           varcur-road-tax  = varlastcur-road-tax
     1857           varcur-excise    = varlastcur-excise
     1858         .
     1859       end.
     1860       else do:
     1861         assign
     1862           varcur-base      = varcur-base      / varcur-fact-qnty
     1863           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1864           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1865         .
     1866       end.
     1867       if varcur-vat-pc = ?
     1868       then do:
     1869         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1870       end.
     1871       if varcur-slt-pc = ?
     1872       then do:
     1873         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1874       end.
