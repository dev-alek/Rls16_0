        1   block-level on error undo, throw.
        2   define input parameter par-line-rec as  recid   no-undo.
        3   define input parameter par-mes      as  logical no-undo.
        4   define parameter buffer t-doc for ub.trn-doc .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: 2014/01/27 14:27:46 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: chk-prt.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: str/chk-prt.p $":U .
       10   def var vss-description as character no-undo init "Проверка того, что признаки соответствует строке документа".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2':u,par-line-rec,par-mes)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   if t-doc.status_ = 'факт':U then do:
       73     return .
       74   end.
       75   find ub.doc-line exclusive-lock
       76     where recid (ub.doc-line) = par-line-rec
       77     .
       78   for each ub.gds-dtl
       79     where ub.gds-dtl.doc-code  = ub.doc-line.doc-code
       80       and ub.gds-dtl.artic     = ub.doc-line.artic
       81       and ub.gds-dtl.prod-type = ub.doc-line.prod-type
       82       and ub.gds-dtl.prod-code = ub.doc-line.prod-code
       83   :
       84     if  ub.gds-dtl.fact-qnty = 0
       85     and ub.gds-dtl.doc-qnty  = 0 then do:
       86       if t-doc.ext-doc-type <> 'ap':U   and
       87          t-doc.ext-doc-type <> 'pc':U   and
       88          t-doc.ext-doc-type <> 'mp':U then do:
       89         delete ub.gds-dtl.
       90       end.
       91     end.
       92     else do:
       93       accumulate
       94         ub.gds-dtl.prt-code (count)
       95         ub.gds-dtl.doc-qnty (total)
       96         ub.gds-dtl.fact-qnty (total)
       97       .
       98     end.
       99   end.
      100   if ( t-doc.flag_ = false
      101        and (accum total ub.gds-dtl.doc-qnty) <> ub.doc-line.doc-qnty
      102      )
      103   or ( t-doc.flag_ = true
      104        and (accum total ub.gds-dtl.fact-qnty) <> ub.doc-line.fact-qnty
      105      ) then do:
      106     if par-mes then do:
      107       message
      108         "Количество по шкале (по всем признакам) не совпадает с количеством по артикулу."
      109         view-as alert-box .
      110     end.
      111     assign
      112       ub.doc-line.prt-ok = false
      113     .
      114   end.
      115   else do:
      116     assign
      117       ub.doc-line.prt-ok = true
      118     .
      119   end.
      120   if  (accum count ub.gds-dtl.prt-code) = 0
      121   and (ub.doc-line.prt-OK = false ) then do:
      122     assign
      123       ub.doc-line.prt-OK = ?
      124     .
      125   end.
