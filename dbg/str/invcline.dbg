     1453           end.
     1454           else do:
     1455             if frame fr-D-inv-line-0 :scrollable = true
     1456             then do:
     1457               assign
     1458                 frame fr-D-inv-line-0 :virtual-height = v-frame-virtual-height
     1459               .
