     1104     v-num-entry9 = lookup( v-str-recid9 , p-rid-list )
     1105   .
     1106   if v-num-entry9 > 0 then do:
     1107     assign
     1108       entry( v-num-entry9, p-rid-list ) = "":U
     1109       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1110     .
     1111   end.
     1112   else do:
     1113     assign
     1114       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1115     .
     1116   end.
     1117       br-inv-lines :refresh( ) in frame fr-D-inv-line-0.
     1118       if last-event :function <> "MOUSE-SELECT-DBLCLICK" then do:
     1119         br-inv-lines :select-next-row( ) in frame fr-D-inv-line-0.
     1120       end.
     1121       apply "VALUE-CHANGED":U to br-inv-lines in frame fr-D-inv-line-0.
     1122       if num-entries( p-rid-list ) = 0 then do: hide                                mark-num   in frame fr-D-inv-line-0. end.
     1123                                        else do: display num-entries( p-rid-list ) @ mark-num with frame fr-D-inv-line-0. end.
     1124     END.
     1125     apply "ENTRY":U to br-inv-lines in frame fr-D-inv-line-0.
     1126   end.
