     1500       then do:
     1501         assign
     1502           v-diasize-change-size = true
     1503         .
     1504       end.
     1505       else do:
     1506         return .
     1507       end.
     1508       assign
     1509         v-frame-height = frame fr-D-inv-line-0 :height
     1510         v-frame-virtual-height = frame fr-D-inv-line-0 :virtual-height
     1511         v-browse-height = v-diasize-browse-handle :height
     1512       .
     1513       for each buf_temp-browse-handle
     1514         where buf_temp-browse-handle.browse-type = 'height':u
     1515       :
     1516         assign
