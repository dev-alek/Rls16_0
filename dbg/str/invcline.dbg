     1573         then do:
     1574           assign
     1575             frame fr-D-inv-line-0 :virtual-height = frame fr-D-inv-line-0 :virtual-height + p-change-value
     1576             no-error .
     1577           if error-status :error
     1578           or error-status :get-message(1) <> ""
     1579           then do:
     1580             undo move_block, retry move_block .
     1581           end.
     1582         end.
     1583         assign
     1584           frame fr-D-inv-line-0 :height = frame fr-D-inv-line-0 :height + p-change-value
     1585           no-error .
     1586         if error-status :error
     1587         or error-status :get-message(1) <> ""
     1588         then do:
     1589           undo move_block, retry move_block .
