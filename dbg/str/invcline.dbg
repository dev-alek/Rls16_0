     1143     end. else IF b-sel :sensitive in frame fr-D-inv-line-0 then do:
     1144         apply "CHOOSE":U to b-sel in frame fr-D-inv-line-0.
     1145     end.
     1146   end.
     1147   on value-changed of br-inv-lines in frame fr-D-inv-line-0 do:
     1148     run proc-view-changes in this-procedure no-error.
     1149   end.
     1150   on entry of sch-code in frame fr-D-inv-line-0 do:
     1151     if sch-field <> self :name then do:
     1152       assign sch-num   = 0
     1153              sch-field = self :name
     1154              FoundRec  = ?.
     1155     end.
     1156     display sch-code  with frame fr-D-inv-line-0.
     1157   end.
     1158   on leave of sch-code in frame fr-D-inv-line-0 do:
     1159     if lookup( last-event :function, "MOUSE-SELECT-DBLCLICK,RETURN" ) = 0 and last-event :label <> "CTRL-J" then do:
     1160       assign FoundRec = ?
     1161              sch-num  = 0.
     1162     end.
     1163     hide sch-num in frame fr-D-inv-line-0.
     1164   end.
     1165   on CTRL-J of sch-code in frame fr-D-inv-line-0 do:
     1166     if input frame fr-D-inv-line-0 sch-code <> sch-code then do:
     1167       assign sch-code.
     1168       assign FoundRec = ?
     1169              sch-num  = 0.
     1170       hide   sch-num  in frame fr-D-inv-line-0.
     1171     end.
     1172     run proc-find-code in this-procedure ( input yes, input sch-code ) no-error.
     1173     if error-status :error then do: return no-apply. end.
     1174   end.
     1175   on return of sch-code in frame fr-D-inv-line-0 do:
     1176     assign sch-code.
     1177     assign FoundRec = ?
     1178            sch-num  = 0.
     1179     hide   sch-num  in frame fr-D-inv-line-0.
     1180     run proc-find-code in this-procedure ( input no,  input sch-code ) no-error.
     1181     if error-status :error then do: return no-apply. end.
     1182   end.
     1183   on mouse-select-dblclick of sch-code in frame fr-D-inv-line-0 do:
     1184     if input frame fr-D-inv-line-0 sch-code <> sch-code then do:
     1185       assign sch-code.
     1186       assign FoundRec = ?
     1187              sch-num  = 0.
     1188       hide   sch-num  in frame fr-D-inv-line-0.
     1189     end.
     1190     run proc-find-code in this-procedure ( input yes, input sch-code ) no-error.
     1191     if error-status :error then do: return no-apply. end.
     1192   end.
     1193   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   on F1 of frame fr-D-inv-line-0 anywhere do:
     1195     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-inv-line-0. END.
     1196     return no-apply.
     1197   end.
     1198   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   on INS of frame fr-D-inv-line-0 anywhere do:
