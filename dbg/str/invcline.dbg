     1518         .
     1519       end.
     1520       for each buf_temp-diasize-handle
     1521       :
     1522         delete buf_temp-diasize-handle .
     1523       end.
     1524       assign
     1525         v-field-group-handle = frame fr-D-inv-line-0 :first-child
     1526       .
