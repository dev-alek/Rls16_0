     1426               then do:
     1427                 assign
     1428                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1429                 .
     1430               end.
     1431             end.
     1432             assign
     1433               v-diasize-browse-handle :height = v-browse-height
     1434             .
     1435             for each buf_temp-browse-handle
     1436               where buf_temp-browse-handle.browse-type = 'height':u
     1437             on error undo, next
     1438             :
     1439               assign
     1440                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1441               .
