     3919     run fltfield-add in this-procedure ( input 'corr-date',        input 'Дата коррекции',                  input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3920     run fltfield-add in this-procedure ( input 'corr-time',        input 'Время в секундах',                input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3921     run fltfield-add in this-procedure ( input 'action',           input 'Описание действия',               input '':U,    input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3922     if num-entries( fld ) <> num-entries( lab ) or num-entries( lab ) <> integer( dim ) or
     3923        num-entries( fld ) <> num-entries( spr ) or num-entries( spr ) <> integer( dim ) or
     3924        num-entries( lab ) <> num-entries( spr ) or num-entries( fld ) <> integer( dim ) then do:
     3925       message "Неверная настройка на фильтры!" view-as alert-box error.
     3926       return no-apply.
     3927     end.
     3928     Filter-Block:
     3929     do on error   undo Filter-Block, leave Filter-Block
     3930        on end-key undo Filter-Block, leave Filter-Block :
     3931       run gbl/filter.w ( input parparentproc,
     3932                      input filter-point,
     3933                      input tbl,
     3934                      input join-tbl,
     3935                      input fld,
     3936                      input lab,
     3937                      input spr,
     3938                      input dim            ).
     3939       if return-value = 'undo':U then do:
     3940         apply "ENTRY":U to browse br-inv-lines.
     3941         return no-apply.
     3942       end.
     3943       assign mark-num = 0
     3944              sch-num  = 0.
     3945       hide   mark-num in frame fr-D-inv-line-0.
     3946       hide   sch-num  in frame fr-D-inv-line-0.
     3947       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3948       assign b-sch :tooltip in frame fr-D-inv-line-0 = "Установить/снять фильтр".
     3949     end.
     3950   end procedure.
     3951   procedure proc-view-changes :
     3952     define buffer new_hist for ub.c-inv-line.
     3953     define buffer buf_srch for ub.inv-line.
     3954     define variable v-chg-fields as character no-undo.
     3955     define variable v-old-fields as character no-undo.
     3956     define variable v-new-fields as character no-undo.
     3957     define variable jj           as integer   no-undo.
     3958     for each temp-changes :
     3959       delete temp-changes.
     3960     end.
     3961     if not available buf_history then do:
     3962       run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     3963       return.
     3964     end.
     3965     find first new_hist no-lock where
     3966                new_hist.doc-code  = buf_history.doc-code  and
     3967                new_hist.artic     = buf_history.artic     and
     3968                new_hist.prod-type = buf_history.prod-type and
     3969                new_hist.prod-code = buf_history.prod-code and
     3970                new_hist.chip-num  > buf_history.chip-num  no-error.
     3971     if not available new_hist then do:
     3972       find buf_srch no-lock where
     3973            buf_srch.doc-code  = buf_history.doc-code  and
     3974            buf_srch.artic     = buf_history.artic     and
     3975            buf_srch.prod-type = buf_history.prod-type and
     3976            buf_srch.prod-code = buf_history.prod-code no-error.
     3977       if not available buf_srch then do: return error. end.
     3978       buffer-compare buf_srch to buf_history save result in v-chg-fields.
     3979     end.
     3980     else do:
     3981       buffer-compare new_hist    except chip-num corr-date corr-time corr-user-name corr-user-db-num action
     3982                   to buf_history save result in v-chg-fields.
     3983     end.
     3984     do jj = 1 to num-entries( v-chg-fields ) :
     3985       case entry( jj, v-chg-fields ) :
     3986                     when "prod-type":U then do:     create temp-changes.     assign temp-changes.f_name = "prod-type":U            temp-changes.l_name = "Тип произв."            temp-changes.v_old  = string( buf_history.prod-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prod-type )                                                          else string( buf_srch.prod-type ) ).   end.
     3987                     when "prod-code":U then do:     create temp-changes.     assign temp-changes.f_name = "prod-code":U            temp-changes.l_name = "Код произв."            temp-changes.v_old  = string( buf_history.prod-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.prod-code )                                                          else string( buf_srch.prod-code ) ).   end.
     3988                     when "artic":U then do:     create temp-changes.     assign temp-changes.f_name = "artic":U            temp-changes.l_name = "Артикул"            temp-changes.v_old  = string( buf_history.artic )            temp-changes.v_new  = ( if available new_hist then string( new_hist.artic )                                                          else string( buf_srch.artic ) ).   end.
     3989                     when "doc-code":U then do:     create temp-changes.     assign temp-changes.f_name = "doc-code":U            temp-changes.l_name = "Номер документа"            temp-changes.v_old  = string( buf_history.doc-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.doc-code )                                                          else string( buf_srch.doc-code ) ).   end.
     3990                     when "before-cli-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "before-cli-qnty":U            temp-changes.l_name = "Кол-во до инв."            temp-changes.v_old  = string( buf_history.before-cli-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.before-cli-qnty )                                                          else string( buf_srch.before-cli-qnty ) ).   end.
     3991                     when "wast-base":U then do:     create temp-changes.     assign temp-changes.f_name = "wast-base":U            temp-changes.l_name = "Учет (б.в.)"            temp-changes.v_old  = string( buf_history.wast-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.wast-base )                                                          else string( buf_srch.wast-base ) ).   end.
     3992                     when "wast-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "wast-rubl":U            temp-changes.l_name = "Учет (руб.)"            temp-changes.v_old  = string( buf_history.wast-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.wast-rubl )                                                          else string( buf_srch.wast-rubl ) ).   end.
     3993                     when "unus-wast-base":U then do:     create temp-changes.     assign temp-changes.f_name = "unus-wast-base":U            temp-changes.l_name = "Учет (б.в.)"            temp-changes.v_old  = string( buf_history.unus-wast-base )            temp-changes.v_new  = ( if available new_hist then string( new_hist.unus-wast-base )                                                          else string( buf_srch.unus-wast-base ) ).   end.
     3994                     when "unus-wast-rubl":U then do:     create temp-changes.     assign temp-changes.f_name = "unus-wast-rubl":U            temp-changes.l_name = "Учет (руб.)"            temp-changes.v_old  = string( buf_history.unus-wast-rubl )            temp-changes.v_new  = ( if available new_hist then string( new_hist.unus-wast-rubl )                                                          else string( buf_srch.unus-wast-rubl ) ).   end.
     3995                     when "after-cli-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "after-cli-qnty":U            temp-changes.l_name = "Кол-во итого"            temp-changes.v_old  = string( buf_history.after-cli-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.after-cli-qnty )                                                          else string( buf_srch.after-cli-qnty ) ).   end.
     3996                     when "wast-cli-qnty":U then do:     create temp-changes.     assign temp-changes.f_name = "wast-cli-qnty":U            temp-changes.l_name = "Факт кол-во"            temp-changes.v_old  = string( buf_history.wast-cli-qnty )            temp-changes.v_new  = ( if available new_hist then string( new_hist.wast-cli-qnty )                                                          else string( buf_srch.wast-cli-qnty ) ).   end.
     3997                     when "obj-type":U then do:     create temp-changes.     assign temp-changes.f_name = "obj-type":U            temp-changes.l_name = "Тип объекта"            temp-changes.v_old  = string( buf_history.obj-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.obj-type )                                                          else string( buf_srch.obj-type ) ).   end.
     3998                     when "obj-code":U then do:     create temp-changes.     assign temp-changes.f_name = "obj-code":U            temp-changes.l_name = "Код объекта"            temp-changes.v_old  = string( buf_history.obj-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.obj-code )                                                          else string( buf_srch.obj-code ) ).   end.
     3999                     when "status_":U then do:     create temp-changes.     assign temp-changes.f_name = "status_":U            temp-changes.l_name = "Статус"            temp-changes.v_old  = string( buf_history.status_ )            temp-changes.v_new  = ( if available new_hist then string( new_hist.status_ )                                                          else string( buf_srch.status_ ) ).   end.
     4000                     when "fact-order":U then do:     create temp-changes.     assign temp-changes.f_name = "fact-order":U            temp-changes.l_name = "Факт ордер"            temp-changes.v_old  = string( buf_history.fact-order )            temp-changes.v_new  = ( if available new_hist then string( new_hist.fact-order )                                                          else string( buf_srch.fact-order ) ).   end.
     4001                     when "host-code":U then do:     create temp-changes.     assign temp-changes.f_name = "host-code":U            temp-changes.l_name = "Своя фирма"            temp-changes.v_old  = string( buf_history.host-code )            temp-changes.v_new  = ( if available new_hist then string( new_hist.host-code )                                                          else string( buf_srch.host-code ) ).   end.
     4002                     when "ext-doc-type":U then do:     create temp-changes.     assign temp-changes.f_name = "ext-doc-type":U            temp-changes.l_name = "Расширенный тип"            temp-changes.v_old  = string( buf_history.ext-doc-type )            temp-changes.v_new  = ( if available new_hist then string( new_hist.ext-doc-type )                                                          else string( buf_srch.ext-doc-type ) ).   end.
     4003                     when "density":U then do:     create temp-changes.     assign temp-changes.f_name = "density":U            temp-changes.l_name = "Плотность"            temp-changes.v_old  = string( buf_history.density )            temp-changes.v_new  = ( if available new_hist then string( new_hist.density )                                                          else string( buf_srch.density ) ).   end.
     4004       end case.
     4005     end.
     4006     run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     4007   end procedure.
     4008   procedure OpenChanges :
     4009     define input parameter p-open-query     as logical   no-undo.
     4010     define input parameter p-find-next      as logical   no-undo.
     4011     define input parameter p-find-condition as character no-undo.
     4012     define variable l-query-was-opened as logical   no-undo.
     4013     define variable sort-change-phrase as character no-undo.
     4014     define variable l-open-query       as logical   no-undo.
     4015     define variable p-proc-hand        as handle    no-undo.
     4016     ASSIGN p-proc-hand = this-procedure :handle.
     4017     case sort-change-name :
     4018       when "":U then do: assign sort-change-phrase = "":U. end.
     4019       otherwise      do: assign sort-change-phrase = "by " + sort-change-name. end.
     4020     end case.
     4021   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4022   define variable  l-disable-where-29  as logical   no-undo .
     4023   define variable  l-filter-open-29    as logical   .
     4024   define variable  flt-rec-29       as recid     no-undo .
     4025   define variable  filter-name-29      as character no-undo .
     4026   define variable  where-phrase-29     as character no-undo .
     4027   define variable  sort-phrase-29      as character no-undo .
     4028   define variable  where-phrase-rus-29 as character no-undo .
     4029   define variable  sort-phrase-rus-29  as character no-undo .
     4030     run waitfram-show in this-procedure
     4031       (input "ЖДИТЕ ..."
     4032       ).
     4033   run gbl/flt-get.p
     4034     (input c-point
     4035     ,output flt-rec-29
     4036     ,output filter-name-29
     4037     ,output where-phrase-29
     4038     ,output sort-phrase-29
     4039     ,output where-phrase-rus-29
     4040     ,output sort-phrase-rus-29
     4041     ).
     4042   if p-open-query then do:
     4043       run set-filter-name in this-procedure
     4044         (INPUT filter-name-29
     4045         ) no-error .
     4046     assign
     4047       l-filter-open-29 = false
     4048     .
     4049     if flt-rec-29 <> ?
     4050       or sort-change-phrase > ""
     4051     then do:
     4052       define variable  parameter-2-29 as character no-undo .
     4053       define variable  parameter-3-29 as character no-undo .
     4054       define variable  parameter-4-29 as character no-undo .
     4055       define variable  parameter-5-29 as character no-undo .
     4056       define variable  parameter-6-29 as character no-undo .
     4057       define variable  parameter-7-29 as character no-undo .
     4058         assign
     4059         parameter-3-29 =
     4060                                 "for each buf_changes"
     4061         parameter-4-29 =
     4062           (
     4063             if (" yes " + " " + where-phrase-29) <> ""
     4064             then  substitute('&1', yes) + " " + where-phrase-29
     4065             else "true"
     4066           )
     4067         parameter-5-29 = (" " + "" + " " + "")
     4068         parameter-6-29 = if sort-phrase-29 = ''
     4069                              then
     4070           (
     4071           " " + "  " +
     4072             " " + sort-change-phrase +
     4073           " " + "  "
     4074           )
     4075                              else
     4076           (
     4077           " " + "  " +
     4078             " " + sort-change-phrase +
     4079           " " + sort-phrase-29
     4080           )
     4081         parameter-7-29 =
     4082           " indexed-reposition  "
     4083       .
     4084       do
     4085       on stop undo, leave
     4086       on error undo, leave
     4087       :
     4088         assign
     4089           l-disable-where-29 =
     4090             (" yes " + " " + where-phrase-29 = "")
     4091         .
     4092         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4093                             ,input query br-changes:handle
     4094                             ,input parameter-3-29
     4095                             ,input parameter-4-29
     4096                             ,input parameter-5-29
     4097                             ,input parameter-6-29
     4098                             ,input parameter-7-29
     4099                             )
     4100         .
     4101         assign
     4102           l-filter-open-29 = true
     4103         .
     4104       end.
     4105       if l-filter-open-29 = false then do:
     4106         message
     4107           "Ошибка при фильтрации / сортировке" skip
     4108           "Будут показаны записи без учета фильтра" skip
     4109           view-as alert-box .
     4110       end.
     4111       else do:
     4112           assign
     4113             l-query-was-opened = true
     4114           .
     4115       end.
     4116     end.
     4117     if l-filter-open-29 = false then do:
     4118       open query br-changes for each buf_changes
     4119         where  yes
     4120         indexed-reposition
     4121     .
     4122         assign
     4123           l-query-was-opened = true
     4124         .
     4125     end.
     4126   end.
     4127   else do:
     4128     assign
     4129       doc-rec = recid( buf_changes )
     4130     .
     4131     do
     4132     on stop undo, leave
     4133     on error undo, leave
     4134     :
     4135       if query br-changes:handle:get-buffer-handle(1) = (buffer buf_changes:handle) then do:
     4136         assign
     4137         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     4138         parameter-4-29 =
     4139           "where ":u +  substitute('&1', yes) + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     4140         parameter-5-29 = "  "
     4141       .
     4142         run fltopend_fltfindd in this-procedure  (
     4143                             input this-procedure:handle
     4144                             ,input query br-changes:handle
     4145                             ,input rowid(buf_changes)
     4146                             ,input logical(parameter-2-29)
     4147                             ,input no-lock
     4148                             ,input (buffer buf_changes:handle)
     4149                             ,input parameter-4-29
     4150                             ,input parameter-5-29
     4151                             ) no-error.
     4152         .
     4153         assign
     4154           doc-rec = integer(return-value)
     4155           v-fltopend-rowid[1] = ?
     4156         .
     4157       end.
     4158       else do:
     4159         assign
     4160         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     4161         parameter-3-29 =  "for each buf_changes"
     4162         parameter-4-29 =
     4163           (
     4164             if (" yes " + " " + where-phrase-29) <> ""
     4165             then  substitute('&1', yes) + " " + where-phrase-29
     4166             else "true"
     4167           )
     4168         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     4169         parameter-6-29 = if sort-phrase-29 = ''
     4170                              then
     4171           (
     4172           " " + "  " +
     4173             " " + sort-change-phrase +
     4174           " " + "  "
     4175           )
     4176                              else
     4177           (
     4178           " " + "  " +
     4179             " " + sort-change-phrase +
     4180           " " + sort-phrase-29
     4181           )
     4182         parameter-7-29 =
     4183           " indexed-reposition  "
     4184       .
     4185         run fltopend_fltfindq in this-procedure  (
     4186                             input this-procedure:handle
     4187                             ,input query br-changes:handle
     4188                             ,input logical(parameter-2-29)
     4189                             ,input no-lock
     4190                             ,input parameter-3-29
     4191                             ,input parameter-4-29
     4192                             ,input parameter-5-29
     4193                             ,input parameter-6-29
     4194                             ,input parameter-7-29
     4195                             ,output v-fltopend-rowid
     4196                             ) no-error.
     4197         .
     4198         doc-rec = ?.
     4199       end.
     4200       assign
     4201         l-query-was-opened = true
     4202       .
     4203     end.
     4204   end.
     4205     run waitfram-hide in this-procedure .
     4206     if p-open-query <> yes then do: reposition br-inv-lines to recid doc-rec no-error. end.
     4207     run WaitFram-Hide in this-procedure.
     4208   end procedure.
     4209   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4210   procedure set-filter-name :
     4211   define input parameter p-filter-name as character no-undo .
     4212     do with frame fr-D-inv-line-0:
     4213       if p-filter-name > "" then do:
     4214         assign
     4215           frame fr-D-inv-line-0:title
     4216             = frame fr-D-inv-line-0:title + "   ФИЛЬТР: " + p-filter-name.
     4217         .
     4218         assign
     4219           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     4220         .
     4221       end.
     4222       else do:
     4223         assign
     4224           b-sch :tooltip = ""
     4225         .
     4226       end.
     4227     end.
     4228   end procedure.
     4229   procedure get-mark-string :
     4230     define        parameter buffer loc-buf for ub.c-inv-line.
     4231     define output parameter        p-sign  as  character no-undo.
     4232     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     4233   end procedure.
     4234   procedure get-action-name :
     4235     define  input parameter p-code as integer   no-undo.
     4236     define output parameter p-name as character no-undo.
     4237     define variable v_code  as character no-undo.
     4238     define variable j_entry as integer   no-undo.
     4239     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     4240     assign v_code  = Int2Char( p-code ).
     4241     assign j_entry = lookup(   v_code, p-act-codes ).
     4242     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     4243   end procedure.
     4244   procedure proc-find-code :
     4245     define input parameter p-next as logical   no-undo.
     4246     define input parameter p-code as character no-undo.
     4247     ASSIGN p-code = REPLACE( p-code, chr(34), chr(34) + chr(34) )
     4248            p-code = REPLACE( p-code, chr(39), chr(39) + chr(39) )
     4249            p-code = chr(34) + p-code + chr(34).
     4250     run OpenBr in this-procedure ( input no, input p-next, input substitute( " and buf_history.artic begins &1 ", p-code ) ).
     4251     if doc-rec <> ? then do:
     4252       if FoundRec = ? then do: assign FoundRec = doc-rec. end.
     4253       if FoundRec = doc-rec then do: assign sch-num = 0. end.
     4254       assign  sch-num = sch-num + 1.
     4255       display sch-num with frame fr-D-inv-line-0.
     4256     end.
     4257     else do:
     4258       assign  sch-num = 0.
     4259       hide    sch-num in frame fr-D-inv-line-0.
     4260     end.
     4261     apply "ENTRY":U to sch-code in frame fr-D-inv-line-0.
     4262   end procedure.
     4263   procedure get-obj-short-name :
     4264     define  input parameter p-type as character no-undo.
     4265     define  input parameter p-code as integer   no-undo.
     4266     define output parameter p-name as character no-undo.
     4267     assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     4268   end procedure.
     4269   procedure get-obj-full-name :
     4270     define  input parameter p-type as character no-undo.
     4271     define  input parameter p-code as integer   no-undo.
     4272     define output parameter p-name as character no-undo.
     4273     define buffer buf_clients for ub.clients.
     4274     find buf_clients no-lock where
     4275          buf_clients.obj-type = p-type and
     4276          buf_clients.obj-code = p-code no-error.
     4277     if available buf_clients then do:
     4278       assign p-name = buf_clients.obj-name.
     4279     end.
     4280     else do:
     4281       assign p-name = ( if p-type = ? or p-code = ? then "":U else ( p-type + " ":U + Int2Char( p-code ) ) ).
     4282     end.
     4283   end procedure.
     4284   procedure get-ext-type :
     4285     define  input parameter p-type as character no-undo.
     4286     define output parameter p-name as character no-undo.
     4287     define variable jndex as integer no-undo.
     4288     assign jndex  = lookup( p-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ).
     4289     assign p-name = ( if jndex = 0 then "":U else entry( jndex, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) ).
     4290   end procedure.
     4291   procedure get-goods-name :
     4292     define  input parameter p-artic     as character no-undo.
     4293     define  input parameter p-prod-type as character no-undo.
     4294     define  input parameter p-prod-code as integer   no-undo.
     4295     define output parameter p-gds-name  as character no-undo.
     4296     define buffer buf_goods for ub.goods.
     4297     find first buf_goods no-lock where
     4298                buf_goods.artic     = p-artic     and
     4299                buf_goods.prod-type = p-prod-type and
     4300                buf_goods.prod-code = p-prod-code no-error.
     4301     assign p-gds-name = ( if available buf_goods then buf_goods.gds-name else "":U ).
     4302   end procedure.
     4303   procedure is-petrolium-goods :
     4304     define  input parameter p-artic     as character no-undo.
     4305     define  input parameter p-prod-type as character no-undo.
     4306     define  input parameter p-prod-code as integer   no-undo.
     4307     define output parameter p-is-petrol as logical   no-undo initial no.
     4308     define variable v_is-petrol as logical no-undo initial no.
     4309     define variable v_is-pieces as logical no-undo initial no.
     4310     define buffer buf_goods for ub.goods.
     4311     define buffer buf_units for ub.units.
     4312     find first buf_goods no-lock where
     4313                buf_goods.artic     = p-artic     and
     4314                buf_goods.prod-type = p-prod-type and
     4315                buf_goods.prod-code = p-prod-code no-error.
     4316     if not available buf_goods then do: return. end.
     4317     find first buf_units no-lock where buf_units.unit-name = buf_goods.unit-base no-error.
     4318     if not available buf_units then do: return. end.
     4319     assign v_is-petrol = ( if lookup( 'топ':U, buf_units.type ) > 0 then yes else no ).
     4320     if lookup( 'шту':U, buf_units.type ) = 0 then do:
     4321       if v_is-petrol = yes and lookup( 'дро':U, buf_units.type ) = 0 then do: return. end.
     4322       assign v_is-pieces = no.
     4323     end.
     4324     else do:
     4325       assign v_is-pieces = yes.
     4326     end.
     4327     assign p-is-petrol = ( ( v_is-petrol = yes ) and ( v_is-pieces = no ) ).
     4328   end procedure.
