     2018       end.
     2019       else do:
     2020         for each buf_temp-diasize-handle
     2021         on error undo move_block, retry move_block
     2022         :
     2023           assign
     2024             v-object-handle = buf_temp-diasize-handle.handle-value
     2025           .
     2026           if v-object-handle <> v-diasize-resize-button
     2027           then do:
     2028             assign
     2029               v-object-handle :col = v-object-handle :col + p-change-value
     2030               no-error .
     2031             if error-status :error
     2032             or error-status :get-message(1) <> ""
     2033             then do:
     2034               undo move_block, retry move_block .
     2035             end.
     2036           end.
     2037         end.
     2038         for each buf_temp-browse-handle
     2039           where buf_temp-browse-handle.browse-type = 'width':u
     2040         on error undo move_block, retry move_block
     2041         :
     2042           assign
     2043             buf_temp-browse-handle.browse-handle :width
     2044               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2045             no-error .
     2046           if error-status :error
     2047           or error-status :get-message(1) <> ""
     2048           then do:
     2049             undo move_block, retry move_block .
     2050           end.
     2051         end.
     2052         assign
     2053           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2054           no-error .
     2055         if error-status :error
     2056         or error-status :get-message(1) <> ""
     2057         then do:
     2058           undo move_block, retry move_block.
     2059         end.
     2060         assign
     2061           frame fr-D-inv-line-0 :width = frame fr-D-inv-line-0 :width + p-change-value
     2062         no-error .
     2063         if error-status :error
     2064         or error-status :get-message(1) <> ""
     2065         then do:
     2066           undo move_block, retry move_block.
     2067         end.
     2068         if frame fr-D-inv-line-0 :scrollable = true
     2069         then do:
     2070           assign
     2071             frame fr-D-inv-line-0 :virtual-width = frame fr-D-inv-line-0 :virtual-width + p-change-value
     2072           no-error .
     2073           if error-status :error
     2074           or error-status :get-message(1) <> ""
     2075           then do:
     2076             undo move_block, retry move_block.
     2077           end.
     2078         end.
     2079       end.
     2080       if p-move-resize
     2081       then do:
     2082         run diasize_position-resize-button in this-procedure .
     2083       end.
     2084       if v-diasize-wndstore = true
     2085       then do:
     2086         if connected("ub") = true
     2087         then do:
     2088           define variable v-cntxt-db-num        as integer   no-undo .
     2089           define variable v-cntxt-userid        as character no-undo .
     2090           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2091                                             , OUTPUT v-cntxt-userid
     2092                                             ) .
     2093           run gbl/wndsizew.p
     2094             (input  v-cntxt-db-num
     2095             ,input  v-cntxt-userid
     2096             ,input  v-diasize-proc-name
     2097             ,input  'width':u
     2098             ,input  string(frame fr-D-inv-line-0 :width - v-diasize-orig-frame-width)
     2099             ) .
     2100         end.
     2101       end.
     2102     end.
     2103     assign
     2104       v-diasize-change-size = false
     2105     .
     2106   end procedure.
     2107   procedure diasize_set-width :
     2108     define input  parameter p-new-width  as decimal   no-undo .
     2109     define input  parameter p-move-resize as logical   no-undo .
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       run diasize_change-width in this-procedure
     2114         (input  (p-new-width - frame fr-D-inv-line-0 :width)
     2115         ,input  p-move-resize
     2116         ) .
     2117     end.
     2118   end procedure.
     2119   procedure diasize_position-resize-button :
     2120     do with frame fr-D-inv-line-0
     2121     :
     2122       hide v-diasize-resize-button .
     2123       assign
     2124         v-diasize-resize-button :row = frame fr-D-inv-line-0 :height - v-diasize-resize-button :height
     2125                     - 1
     2126                     - (frame fr-D-inv-line-0 :border-bottom-pixels / session :pixels-per-row)
     2127         v-diasize-resize-button :col = frame fr-D-inv-line-0 :width - v-diasize-resize-button :width
     2128                     - 1
     2129                     - (frame fr-D-inv-line-0 :border-right-pixels / session :pixels-per-column)
     2130       .
     2131       view v-diasize-resize-button .
     2132     end.
     2133   end procedure.
     2134   on alt-right anywhere
     2135   do:
     2136     run diasize_change-width in this-procedure
     2137       (input 1
     2138       ,input true
     2139       ) .
     2140     return no-apply .
     2141   end.
     2142   on alt-left anywhere
     2143   do:
     2144     run diasize_change-width in this-procedure
     2145       (input -1
     2146       ,input true
     2147       ) .
     2148     return no-apply .
     2149   end.
     2150   on alt-down anywhere
     2151   do:
     2152     run diasize_change-height in this-procedure
     2153       (input 1
     2154       ,input true
     2155       ) .
     2156     return no-apply .
     2157   end.
     2158   on alt-up anywhere
     2159   do:
     2160     run diasize_change-height in this-procedure
     2161       (input -1
     2162       ,input true
     2163       ) .
     2164     return no-apply .
     2165   end.
     2166   on alt-enter of frame fr-D-inv-line-0
     2167   do:
     2168     run diasize_maximize in this-procedure
     2169       (input  ?
     2170       ).
     2171     return no-apply .
     2172   end.
     2173   procedure diasize_end-move :
     2174     do
     2175     on error undo, return error return-value
     2176     :
     2177       define variable v-row-delta as decimal   no-undo .
     2178       define variable v-col-delta as decimal   no-undo .
     2179       define variable v-new-row as decimal   no-undo .
     2180       define variable v-new-col as decimal   no-undo .
     2181       assign
     2182         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2183         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2184       .
     2185       assign
     2186         v-row-delta = v-new-row - frame fr-D-inv-line-0 :height
     2187         v-col-delta = v-new-col - frame fr-D-inv-line-0 :width
     2188       .
     2189       run diasize_change-height in this-procedure
     2190         (input v-row-delta
     2191         ,input true
     2192         ) .
     2193       run diasize_change-width in this-procedure
     2194         (input v-col-delta
     2195         ,input true
     2196         ) .
     2197     end.
     2198   end procedure.
     2199   procedure diasize_maximize :
     2200     define input  parameter p-action as logical   no-undo .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       if p-action = ?
     2205       then do:
     2206         if v-diasize-need-maximize = true
     2207         then do:
     2208           assign
     2209             p-action = true
     2210           .
     2211         end.
     2212         else do:
     2213           assign
     2214             p-action = false
     2215           .
     2216         end.
     2217       end.
     2218       if p-action = true
     2219       then do:
     2220         run diasize_change-height in this-procedure
     2221           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2222               - frame fr-D-inv-line-0 :height-chars
     2223           ,input true
     2224           ) .
     2225         run diasize_change-width in this-procedure
     2226           (input session :width-chars
     2227               - frame fr-D-inv-line-0 :width-chars
     2228           ,input true
     2229           ) .
     2230         assign
     2231           v-diasize-need-maximize = false
     2232         .
     2233       end.
     2234       else do:
     2235         run diasize_change-width in this-procedure
     2236           (input v-diasize-orig-frame-width
     2237               - frame fr-D-inv-line-0 :width-chars
     2238           ,input true
     2239           ) .
     2240         run diasize_change-height in this-procedure
     2241           (input v-diasize-orig-frame-height
     2242               - frame fr-D-inv-line-0 :height-chars
     2243           ,input true
     2244           ) .
     2245         assign
     2246           v-diasize-need-maximize = true
     2247         .
     2248       end.
     2249     end.
     2250   end procedure.
     2251   procedure diasize_restore-orig-size :
     2252     do
     2253     on error undo, return error return-value
     2254     :
     2255       assign
     2256         v-diasize-current-frame-width  = frame fr-D-inv-line-0 :width
     2257         v-diasize-current-frame-height = frame fr-D-inv-line-0 :height
     2258       .
     2259       run diasize_set-height in this-procedure
     2260         (input  v-diasize-orig-frame-height
     2261         ,input  true
     2262         ) .
     2263       run diasize_set-width in this-procedure
     2264         (input  v-diasize-orig-frame-width
     2265         ,input  true
     2266         ) .
     2267     end.
     2268   end procedure.
     2269   procedure diasize_restore-current-size :
     2270     do
     2271     on error undo, return error return-value
     2272     :
     2273       run diasize_set-height in this-procedure
     2274         (input  v-diasize-current-frame-height
     2275         ,input  true
     2276         ) .
     2277       run diasize_set-width in this-procedure
     2278         (input  v-diasize-current-frame-width
     2279         ,input  true
     2280         ) .
     2281     end.
     2282   end procedure.
     2283   procedure diasize_set-browse-handle :
     2284     define input  parameter p-browse-handle as handle   no-undo .
     2285     define buffer buf_temp-browse-handle for temp-browse-handle .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       assign
     2290         v-diasize-browse-handle = p-browse-handle
     2291       .
     2292       for each buf_temp-browse-handle
     2293       on error undo, return error return-value
     2294       :
     2295         delete buf_temp-browse-handle .
     2296       end.
     2297     end.
     2298   end procedure.
     2299   procedure diasize_add_browse :
     2300     define input  parameter p-browse-type   as character no-undo .
     2301     define input  parameter p-browse-handle as handle    no-undo .
     2302     define buffer buf_temp-browse-handle for temp-browse-handle .
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       assign
     2307         v-diasize-browse-number = v-diasize-browse-number + 1
     2308       .
     2309       create buf_temp-browse-handle .
     2310       assign
     2311         buf_temp-browse-handle.browse-type   = p-browse-type
     2312         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2313         buf_temp-browse-handle.browse-handle = p-browse-handle
     2314       .
     2315     end.
     2316   end procedure.
     2317   procedure diasize_init :
     2318     define variable v-default-value    as logical   no-undo .
     2319     define variable v-restore-saved    as logical   no-undo .
     2320     define variable v-resize-value-str as character no-undo .
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       do with frame fr-D-inv-line-0
     2325       :
     2326         assign
     2327           v-diasize-orig-frame-height = frame fr-D-inv-line-0 :height
     2328           v-diasize-orig-frame-width  = frame fr-D-inv-line-0 :width
     2329           v-diasize-browse-handle     = browse br-inv-lines :handle
     2330         .
     2331         create button v-diasize-resize-button
     2332         assign
     2333           parent        = frame fr-D-inv-line-0 :first-child
     2334           label         = "s"
     2335           height-pixels = 16
     2336           width-pixels  = 16
     2337           visible       = true
     2338           sensitive     = true
     2339           movable       = true
     2340           triggers:
     2341             on end-move persistent run diasize_end-move in this-procedure .
     2342           end triggers.
     2343         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2344         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2345         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2346         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2347         assign
     2348           v-diasize-wndmax = false
     2349         .
     2350         if connected("ub") = true
     2351         then do:
     2352           define variable v-cntxt-db-num        as integer   no-undo .
     2353           define variable v-cntxt-userid        as character no-undo .
     2354           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2355                                             , OUTPUT v-cntxt-userid
     2356                                             ) .
     2357           run gbl/wndpar_r.p
     2358             (input  v-cntxt-db-num
     2359             ,input  v-cntxt-userid
     2360             ,input  'wndmax':U
     2361             ,output v-diasize-wndmax
     2362             ,output v-default-value
     2363             ) .
     2364         end.
     2365         assign
     2366           v-diasize-wndstore = false
     2367         .
     2368         if connected("ub") = true
     2369         then do:
     2370           run gbl/wndpar_r.p
     2371             (input  v-cntxt-db-num
     2372             ,input  v-cntxt-userid
     2373             ,input  'wndstore':U
     2374             ,output v-diasize-wndstore
     2375             ,output v-default-value
     2376             ) .
     2377         end.
     2378         assign
     2379           v-diasize-proc-name = entry(1, program-name(2), '.')
     2380         .
     2381         if v-diasize-wndstore = true
     2382         then do:
     2383           assign
     2384             v-restore-saved = false
     2385           .
     2386           if connected("ub") = true
     2387           then do:
     2388             run gbl/wndsizer.p
     2389               (input  v-cntxt-db-num
     2390               ,input  v-cntxt-userid
     2391               ,input  v-diasize-proc-name
     2392               ,input  'height':u
     2393               ,output v-resize-value-str
     2394               ) .
     2395             if v-resize-value-str <> '':U
     2396             then do:
     2397               run diasize_change-height in this-procedure
     2398                 (input  integer(v-resize-value-str)
     2399                 ,input  true
     2400                 ) .
     2401               assign
     2402                 v-restore-saved = true
     2403               .
     2404             end.
     2405           end.
     2406           if connected("ub") = true
     2407           then do:
     2408             run gbl/wndsizer.p
     2409               (input  v-cntxt-db-num
     2410               ,input  v-cntxt-userid
     2411               ,input  v-diasize-proc-name
     2412               ,input  'width':u
     2413               ,output v-resize-value-str
     2414               ) .
     2415             if v-resize-value-str <> '':U
     2416             then do:
     2417               run diasize_change-width in this-procedure
     2418                 (input  integer(v-resize-value-str)
     2419                 ,input  true
     2420                 ) .
     2421               assign
     2422                 v-restore-saved = true
     2423               .
     2424             end.
     2425           end.
     2426           if v-restore-saved <> true
     2427           then do:
     2428             if v-diasize-wndmax = true
     2429             then do:
     2430               run diasize_maximize in this-procedure
     2431                 (input  true
     2432                 ) .
     2433             end.
     2434           end.
     2435         end.
     2436         else do:
     2437           if v-diasize-wndmax = true
     2438           then do:
     2439             run diasize_maximize in this-procedure
     2440               (input  true
     2441               ) .
     2442           end.
     2443         end.
     2444       end.
     2445     end.
     2446   end procedure.
     2447   procedure diasize_need-full-display :
     2448     define output parameter p-need-full-display as logical   no-undo .
     2449     do
     2450     on error undo, return error return-value
     2451     :
     2452       assign
     2453         p-need-full-display = v-diasize-need-full-display
     2454       .
     2455       assign
     2456         v-diasize-need-full-display = false
     2457       .
     2458     end.
     2459   end procedure.
     2460   procedure get-context :
     2461      define output parameter p-db-num as integer          no-undo.
     2462      define output parameter p-user-id as character        no-undo.
     2463      define variable v-login               as character    no-undo.
     2464      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2465      define buffer buf_user-login  for ub.user-login .
     2466      do
     2467      on error undo, return error
     2468      :
     2469            FIND FIRST buf_sys-ctrl no-lock.
     2470            ASSIGN
     2471               v-login = USERID("ub")
     2472               p-db-num = buf_sys-ctrl.db-num
     2473            .
     2474            FIND FIRST buf_user-login
     2475                 WHERE buf_user-login.db-num = p-db-num
     2476                   AND buf_user-login.user-login = v-login
     2477                 no-lock
     2478                 no-error
     2479                 .
     2480            IF AVAILABLE buf_user-login
     2481            THEN DO:
     2482               assign
     2483                  p-user-id = buf_user-login.user-id
     2484               .
     2485            END.
     2486      end.
     2487   end procedure.
     2488       run diasize_init in this-procedure .
     2489   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2490   DEF VAR cur-clmn-numbr-inv-lines as INT EXTENT 25 no-undo.
     2491   DEF VAR varmvibr-inv-lines       as INT no-undo.
     2492   DEF VAR varmvjbr-inv-lines       as INT no-undo.
     2493   DEF VAR varmvkbr-inv-lines       as INT no-undo.
     2494   DEF VAR varmvlbr-inv-lines       as INT no-undo.
     2495   DEF VAR move-elementbr-inv-lines as INT no-undo.
     2496   def var jjbr-inv-lines           as int no-undo.
     2497   do varmvibr-inv-lines = 1 to EXTENT(cur-clmn-numbr-inv-lines):
     2498     ASSIGN cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = varmvibr-inv-lines.
     2499   END.
     2500   RUN start-mv-clmnbr-inv-lines.
     2501   PROCEDURE start-mv-clmnbr-inv-lines:
     2502   def var old-session as logical no-undo.
     2503      old-session = SESSION:IMMEDIATE-DISPLAY.
     2504      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2505      SESSION:IMMEDIATE-DISPLAY = old-session.
     2506   END.
     2507   ON ctrl-cursor-right OF BROWSE br-inv-lines do:
     2508     RUN re-move-clmnbr-inv-lines ( 2, 25).
     2509   END.
     2510   ON ctrl-cursor-left OF BROWSE br-inv-lines do:
     2511     RUN re-move-clmnbr-inv-lines (25, 2).
     2512   END.
     2513   PROCEDURE re-move-clmnbr-inv-lines:
     2514     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2515     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2516     DO varmvibr-inv-lines = 1 TO EXTENT(cur-clmn-numbr-inv-lines):
     2517       if cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = source-column THEN cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = -1.
     2518     END.
     2519     if br-inv-lines:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-inv-line-0 then.
     2520     if source-column > target-column THEN
     2521     DO varmvjbr-inv-lines = source-column - 1 to target-column BY -1:
     2522       DO varmvibr-inv-lines = 1 TO EXTENT(cur-clmn-numbr-inv-lines):
     2523           if cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = varmvjbr-inv-lines THEN DO:
     2524             cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = cur-clmn-numbr-inv-lines[varmvibr-inv-lines] + 1.
     2525           END.
     2526       END.
     2527     END.
     2528     ELSE
     2529     DO varmvjbr-inv-lines = source-column + 1 to target-column:
     2530       DO varmvibr-inv-lines = 1 TO EXTENT(cur-clmn-numbr-inv-lines):
     2531         if cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = varmvjbr-inv-lines THEN DO:
     2532           cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = cur-clmn-numbr-inv-lines[varmvibr-inv-lines] - 1.
     2533         END.
     2534       END.
     2535     END.
     2536     DO varmvibr-inv-lines = 1 TO EXTENT(cur-clmn-numbr-inv-lines):
     2537       if cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = -1 THEN cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = target-column.
     2538     END.
     2539   END PROCEDURE.
     2540   PROCEDURE ch-clmnbr-inv-lines:
     2541     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2542     if cur-clmn-loc <= 2 then do:
     2543       return .
     2544     end.
     2545     DO varmvibr-inv-lines = 1 TO EXTENT(cur-clmn-numbr-inv-lines):
     2546       if cur-clmn-numbr-inv-lines[varmvibr-inv-lines] = cur-clmn-loc THEN move-elementbr-inv-lines = varmvibr-inv-lines.
     2547     END.
     2548     RUN re-move-clmnbr-inv-lines (cur-clmn-loc, 2).
     2549   END PROCEDURE.
     2550   PROCEDURE mv-brw-defaultbr-inv-lines:
     2551   def var old-session as logical no-undo.
     2552     old-session = SESSION:IMMEDIATE-DISPLAY.
     2553     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2554     do varmvlbr-inv-lines = 2 to EXTENT(cur-clmn-numbr-inv-lines):
     2555       RUN re-move-clmnbr-inv-lines (cur-clmn-numbr-inv-lines[varmvlbr-inv-lines], varmvlbr-inv-lines).
     2556     END.
     2557     RUN start-mv-clmnbr-inv-lines.
     2558     SESSION:IMMEDIATE-DISPLAY = old-session.
     2559   END PROCEDURE.
     2560   .
     2561   def var sort-labelbr-inv-lines   as character no-undo .
     2562   def var sort-clmnbr-inv-lines    as handle    no-undo .
     2563   def var cur-clmnbr-inv-lines     as handle    no-undo .
     2564   def var cur-clmn-locbr-inv-lines as integer   no-undo .
     2565   def var re-querybr-inv-lines     as logical   initial no no-undo .
     2566   on start-search, ctrl-o of br-inv-lines in frame fr-D-inv-line-0 do:
     2567      run sort-brbr-inv-lines
     2568        (input (if available buf_history
     2569                then recid(buf_history)
     2570                else ?
     2571               )
     2572        ).
     2573   end.
     2574   PROCEDURE sort-brbr-inv-lines :
     2575     define input parameter p-recid as recid no-undo .
     2576     if re-querybr-inv-lines = no then do:
     2577       assign
     2578          cur-clmnbr-inv-lines = br-inv-lines:current-column in frame fr-D-inv-line-0
     2579       .
     2580       if sort-clmnbr-inv-lines <> ? then sort-clmnbr-inv-lines:column-fgcolor = 0.
     2581       if cur-clmnbr-inv-lines = sort-clmnbr-inv-lines then do:
     2582         assign
     2583            sort-labelbr-inv-lines = ""
     2584            sort-clmnbr-inv-lines = ?
     2585         .
     2586        end.
     2587        else do:
     2588          assign
     2589            sort-labelbr-inv-lines = cur-clmnbr-inv-lines:label
     2590            sort-clmnbr-inv-lines  = cur-clmnbr-inv-lines
     2591            sort-clmnbr-inv-lines:column-fgcolor = 4
     2592          .
     2593        end.
     2594      end.
     2595     assign
     2596       cur-clmn-locbr-inv-lines = 1
     2597     .
     2598     def var column-handle as handle no-undo .
     2599     column-handle = br-inv-lines:first-column.
     2600     do while valid-handle(column-handle) :
     2601       if column-handle = cur-clmnbr-inv-lines then do:
     2602         leave .
     2603       end.
     2604       column-handle = column-handle:NEXT-COLUMN.
     2605       assign
     2606         cur-clmn-locbr-inv-lines = cur-clmn-locbr-inv-lines + 1
     2607       .
     2608     end.
     2609     case sort-labelbr-inv-lines:
     2610           when '*'  then DO:    assign       sort-column-name = "mark-string( buffer buf_history )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2611           when 'Номер документа'  then DO:    assign       sort-column-name = "buf_history.doc-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2612           when 'Артикул'  then DO:    assign       sort-column-name = "buf_history.artic"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2613           when 'Производитель'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-short&1, &1&2&1, &1&3&1)', chr(34), buf_history.prod-type, buf_history.prod-code )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2614           when 'Факт кол-во, кг'  then DO:    assign       sort-column-name = "buf_history.wast-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2615           when 'Итого стало, кг'  then DO:    assign       sort-column-name = "buf_history.after-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2616           when 'Цена продаж / кг (руб.)'  then DO:    assign       sort-column-name = "buf_history.wast-rubl"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2617           when 'Учет. цена / кг (руб.)'  then DO:    assign       sort-column-name = "buf_history.unus-wast-rubl"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2618           when 'Цена продаж / кг (б.в.)'  then DO:    assign       sort-column-name = "buf_history.wast-base"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2619           when 'Учет. цена / кг (б.в.)'  then DO:    assign       sort-column-name = "buf_history.unus-wast-base"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2620           when 'Плотность'  then DO:    assign       sort-column-name = "buf_history.density"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2621           when 'Кол-во до (инв.), кг'  then DO:    assign       sort-column-name = "buf_history.before-cli-qnty"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2622           when 'Название производителя'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-name&1, &1&2&1, &1&3&1)', chr(34), buf_history.prod-type, buf_history.prod-code )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2623           when 'Название товара'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1gds-name&1, &1&2&1, &1&3&1, &1&4&1)', chr(34), buf_history.artic, buf_history.prod-type, buf_history.prod-code )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2624           when 'Код фирмы'  then DO:    assign       sort-column-name = "buf_history.host-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2625           when 'Расширенный тип документа'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ext-type&1, &1&2&1)', chr(34), buf_history.ext-doc-type )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2626           when 'Факт ордер'  then DO:    assign       sort-column-name = "buf_history.fact-order"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2627           when 'Статус'  then DO:    assign       sort-column-name = "buf_history.status_"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2628           when 'Объект'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-short&1, &1&2&1, &1&3&1)', chr(34), buf_history.obj-type, buf_history.obj-code )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2629           when 'Наименование объекта'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1obj-name&1, &1&2&1, &1&3&1)', chr(34), buf_history.obj-type, buf_history.obj-code )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2630           when 'Изменил'  then DO:    assign       sort-column-name = "buf_history.corr-user-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2631           when 'Действие'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ShowAction&1, &1&2&1)', chr(34), buf_history.action )     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2632           when 'Дата корр.'  then DO:    assign       sort-column-name = "buf_history.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2633           when 'Время'  then DO:    assign       sort-column-name = "STRING( buf_history.corr-time, 'HH:MM:SS':U )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2634           when 'Щепка'  then DO:    assign       sort-column-name = "buf_history.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2635       otherwise do:
     2636         assign
     2637           sort-column-name = ""
     2638         .
     2639         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2640           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-inv-lines') then do:
     2641             run mv-brw-defaultbr-inv-lines.
     2642           end.
     2643         if sort-labelbr-inv-lines <> "" then do:
     2644           assign
     2645             cur-clmnbr-inv-lines:column-fgcolor = 0
     2646           .
     2647         end.
     2648         assign
     2649           cur-clmn-locbr-inv-lines = ?
     2650         .
     2651       end.
     2652     end case.
     2653     if p-recid <> ? then do:
     2654       reposition br-inv-lines to recid p-recid no-error.
     2655       apply "value-changed" to br-inv-lines in frame fr-D-inv-line-0.
     2656     end.
     2657     apply "entry" to br-inv-lines in frame fr-D-inv-line-0.
     2658   END PROCEDURE.
     2659   procedure re-open-query-srt-clmnbr-inv-lines:
     2660   if cur-clmnbr-inv-lines = ? then do:
     2661      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2662   end.
     2663   else do:
     2664      assign re-querybr-inv-lines = yes.
     2665      run sort-brbr-inv-lines
     2666        (input (if available buf_history
     2667                then recid(buf_history)
     2668                else ?
     2669               )
     2670        ).
     2671      assign re-querybr-inv-lines = no.
     2672   end.
     2673   end.
     2674   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2675   DEF VAR cur-clmn-numbr-changes as INT EXTENT 3 no-undo.
     2676   DEF VAR varmvibr-changes       as INT no-undo.
     2677   DEF VAR varmvjbr-changes       as INT no-undo.
     2678   DEF VAR varmvkbr-changes       as INT no-undo.
     2679   DEF VAR varmvlbr-changes       as INT no-undo.
     2680   DEF VAR move-elementbr-changes as INT no-undo.
     2681   def var jjbr-changes           as int no-undo.
     2682   do varmvibr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2683     ASSIGN cur-clmn-numbr-changes[varmvibr-changes] = varmvibr-changes.
     2684   END.
     2685   RUN start-mv-clmnbr-changes.
     2686   PROCEDURE start-mv-clmnbr-changes:
     2687   def var old-session as logical no-undo.
     2688      old-session = SESSION:IMMEDIATE-DISPLAY.
     2689      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2690      SESSION:IMMEDIATE-DISPLAY = old-session.
     2691   END.
     2692   ON ctrl-cursor-right OF BROWSE br-changes do:
     2693     RUN re-move-clmnbr-changes ( 1, 3).
     2694   END.
     2695   ON ctrl-cursor-left OF BROWSE br-changes do:
     2696     RUN re-move-clmnbr-changes (3, 1).
     2697   END.
     2698   PROCEDURE re-move-clmnbr-changes:
     2699     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2700     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2701     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2702       if cur-clmn-numbr-changes[varmvibr-changes] = source-column THEN cur-clmn-numbr-changes[varmvibr-changes] = -1.
     2703     END.
     2704     if br-changes:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-inv-line-0 then.
     2705     if source-column > target-column THEN
     2706     DO varmvjbr-changes = source-column - 1 to target-column BY -1:
     2707       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2708           if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2709             cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] + 1.
     2710           END.
     2711       END.
     2712     END.
     2713     ELSE
     2714     DO varmvjbr-changes = source-column + 1 to target-column:
     2715       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2716         if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2717           cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] - 1.
     2718         END.
     2719       END.
     2720     END.
     2721     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2722       if cur-clmn-numbr-changes[varmvibr-changes] = -1 THEN cur-clmn-numbr-changes[varmvibr-changes] = target-column.
     2723     END.
     2724   END PROCEDURE.
     2725   PROCEDURE ch-clmnbr-changes:
     2726     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2727     if cur-clmn-loc <= 1 then do:
     2728       return .
     2729     end.
     2730     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2731       if cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-loc THEN move-elementbr-changes = varmvibr-changes.
     2732     END.
     2733     RUN re-move-clmnbr-changes (cur-clmn-loc, 1).
     2734   END PROCEDURE.
     2735   PROCEDURE mv-brw-defaultbr-changes:
     2736   def var old-session as logical no-undo.
     2737     old-session = SESSION:IMMEDIATE-DISPLAY.
     2738     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2739     do varmvlbr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2740       RUN re-move-clmnbr-changes (cur-clmn-numbr-changes[varmvlbr-changes], varmvlbr-changes).
     2741     END.
     2742     RUN start-mv-clmnbr-changes.
     2743     SESSION:IMMEDIATE-DISPLAY = old-session.
     2744   END PROCEDURE.
     2745   .
     2746   def var sort-labelbr-changes   as character no-undo .
     2747   def var sort-clmnbr-changes    as handle    no-undo .
     2748   def var cur-clmnbr-changes     as handle    no-undo .
     2749   def var cur-clmn-locbr-changes as integer   no-undo .
     2750   def var re-querybr-changes     as logical   initial no no-undo .
     2751   on start-search, ctrl-o of br-changes in frame fr-D-inv-line-0 do:
     2752      run sort-brbr-changes
     2753        (input (if available buf_changes
     2754                then recid(buf_changes)
     2755                else ?
     2756               )
     2757        ).
     2758   end.
     2759   PROCEDURE sort-brbr-changes :
     2760     define input parameter p-recid as recid no-undo .
     2761     if re-querybr-changes = no then do:
     2762       assign
     2763          cur-clmnbr-changes = br-changes:current-column in frame fr-D-inv-line-0
     2764       .
     2765       if sort-clmnbr-changes <> ? then sort-clmnbr-changes:column-fgcolor = 0.
     2766       if cur-clmnbr-changes = sort-clmnbr-changes then do:
     2767         assign
     2768            sort-labelbr-changes = ""
     2769            sort-clmnbr-changes = ?
     2770         .
     2771        end.
     2772        else do:
     2773          assign
     2774            sort-labelbr-changes = cur-clmnbr-changes:label
     2775            sort-clmnbr-changes  = cur-clmnbr-changes
     2776            sort-clmnbr-changes:column-fgcolor = 4
     2777          .
     2778        end.
     2779      end.
     2780     assign
     2781       cur-clmn-locbr-changes = 1
     2782     .
     2783     def var column-handle as handle no-undo .
     2784     column-handle = br-changes:first-column.
     2785     do while valid-handle(column-handle) :
     2786       if column-handle = cur-clmnbr-changes then do:
     2787         leave .
     2788       end.
     2789       column-handle = column-handle:NEXT-COLUMN.
     2790       assign
     2791         cur-clmn-locbr-changes = cur-clmn-locbr-changes + 1
     2792       .
     2793     end.
     2794     case sort-labelbr-changes:
     2795           when 'Изменилось'  then DO:    assign       sort-change-name = "buf_changes.l_name"     .     run OpenChanges in this-procedure ( input yes, input no, input '':U ).   . END.
     2796           when 'Было'  then DO:    assign       sort-change-name = "buf_changes.v_old"     .     run OpenChanges in this-procedure ( input yes, input no, input '':U ).   . END.
     2797           when 'Стало'  then DO:    assign       sort-change-name = "buf_changes.v_new"     .     run OpenChanges in this-procedure ( input yes, input no, input '':U ).   . END.
     2798       otherwise do:
     2799         assign
     2800           sort-change-name = ""
     2801         .
     2802         run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     2803           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-changes') then do:
     2804             run mv-brw-defaultbr-changes.
     2805           end.
     2806         if sort-labelbr-changes <> "" then do:
     2807           assign
     2808             cur-clmnbr-changes:column-fgcolor = 0
     2809           .
     2810         end.
     2811         assign
     2812           cur-clmn-locbr-changes = ?
     2813         .
     2814       end.
     2815     end case.
     2816     if p-recid <> ? then do:
     2817       reposition br-changes to recid p-recid no-error.
     2818       apply "value-changed" to br-changes in frame fr-D-inv-line-0.
     2819     end.
     2820     apply "entry" to br-changes in frame fr-D-inv-line-0.
     2821   END PROCEDURE.
     2822   procedure re-open-query-srt-clmnbr-changes:
     2823   if cur-clmnbr-changes = ? then do:
     2824      run OpenChanges in this-procedure ( input yes, input no, input '':U ).
     2825   end.
     2826   else do:
     2827      assign re-querybr-changes = yes.
     2828      run sort-brbr-changes
     2829        (input (if available buf_changes
     2830                then recid(buf_changes)
     2831                else ?
     2832               )
     2833        ).
     2834      assign re-querybr-changes = no.
     2835   end.
     2836   end.
     2837   Main-Block:
     2838   do on error   undo Main-Block, leave Main-Block
     2839      on end-key undo Main-Block, leave Main-Block :
     2840      p-host-code = v-cntxt-host-code-obj.
     2841     if lookup( p-mode, 'все,obj,doc,gds,one':U ) = 0 then do:
     2842       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2843               "Неверное значение параметра вызова p-mode:" p-mode
     2844       view-as alert-box error.
     2845     end.
     2846     if p-mode = 'obj':U or
     2847        p-mode = 'gds':U then do:
     2848       find first buf_sch_hist no-lock where
     2849                  buf_sch_hist.obj-type = p-obj-type and
     2850                  buf_sch_hist.obj-code = p-obj-code no-error.
     2851       if not available buf_sch_hist then do:
     2852         message
     2853                 'Нет истории по - '
     2854                 '"' + p-obj-type + '"' p-obj-code '.'
     2855         view-as alert-box information.
     2856       end.
     2857     end.
     2858     if p-mode = 'doc':U then do:
     2859       find first buf_sch_hist no-lock where buf_sch_hist.doc-code = p-doc-code no-error.
     2860       if not available buf_sch_hist then do:
     2861         message
     2862                 'Нет истории по' p-doc-code
     2863         view-as alert-box information.
     2864       end.
     2865     end.
     2866     if p-mode = 'gds':U then do:
     2867       find first buf_sch_hist no-lock where
     2868                  buf_sch_hist.obj-type  = p-obj-type  and
     2869                  buf_sch_hist.obj-code  = p-obj-code  and
     2870                  buf_sch_hist.artic     = p-artic     and
     2871                  buf_sch_hist.prod-type = p-prod-type and
     2872                  buf_sch_hist.prod-code = p-prod-code no-error.
     2873       if not available buf_sch_hist then do:
     2874         message
     2875                 'Нет истории по:'
     2876                 p-artic ', ' p-prod-type ' и ' p-prod-code '.'
     2877         view-as alert-box information.
     2878       end.
     2879     end.
     2880     if p-mode = 'one':U then do:
     2881       find first buf_sch_hist no-lock where
     2882                  buf_sch_hist.doc-code  = p-doc-code  and
     2883                  buf_sch_hist.artic     = p-artic     and
     2884                  buf_sch_hist.prod-type = p-prod-type and
     2885                  buf_sch_hist.prod-code = p-prod-code no-error.
     2886       if not available buf_sch_hist then do:
     2887         message
     2888                 'Нет истории по :'
     2889                 p-artic ', ' p-prod-type ' и ' p-prod-code '.'
     2890         view-as alert-box information .
     2891       end.
     2892     end.
     2893     if p-rid-list <> "":U then do:
     2894       find first buf_sch_hist no-lock where recid( buf_sch_hist ) = integer( entry( 1, p-rid-list ) ) no-error.
     2895       if not available buf_sch_hist then do:
     2896       end.
     2897       else do:
     2898         assign doc-rec = recid( buf_sch_hist ).
     2899       end.
     2900     end.
     2901     enable  b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     2902             b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     2903             b-sch b-help b-quit br-inv-lines br-changes sch-code
     2904     with frame fr-D-inv-line-0.
     2905     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2906     hide mark-num in frame fr-D-inv-line-0.
     2907     hide  sch-num in frame fr-D-inv-line-0.
     2908     if p-rid-list <> "":U then do: reposition br-inv-lines to recid doc-rec no-error. end.
     2909     br-inv-lines :set-repositioned-row( 5, "CONDITIONAL" ).
     2910     wait-for go of frame fr-D-inv-line-0.
     2911   end.
     2912   hide frame fr-D-inv-line-0 no-pause.
     2913   procedure OpenBr :
     2914     define input parameter p-open-query     as logical   no-undo.
     2915     define input parameter p-find-next      as logical   no-undo.
     2916     define input parameter p-find-condition as character no-undo.
     2917     define variable l-query-was-opened as logical   no-undo.
     2918     define variable title0             as character no-undo.
     2919     define variable sort-column-phrase as character no-undo.
     2920     define variable p-proc-hand as handle no-undo.
     2921     run WaitFram-Show in this-procedure ( input "Ждите..." ).
     2922     assign title0 = "История" + chr(32).
     2923     assign p-proc-hand = this-procedure :handle.
     2924     case sort-column-name :
     2925       when "":U then do: assign sort-column-phrase = "":U. end.
     2926       otherwise      do: assign sort-column-phrase = "by " + sort-column-name. end.
     2927     end case.
     2928     define variable l-open-query as logical no-undo.
     2929     assign filter-point = filter-point0 + " - " + p-mode.
     2930     case p-mode :
     2931       when 'все':U  then do:
     2932         assign frame fr-D-inv-line-0 :title = title0 + "топливных строк (весовой учет)".
     2933   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2934   define variable  l-disable-where-19  as logical   no-undo .
     2935   define variable  l-filter-open-19    as logical   .
     2936   define variable  flt-rec-19       as recid     no-undo .
     2937   define variable  filter-name-19      as character no-undo .
     2938   define variable  where-phrase-19     as character no-undo .
     2939   define variable  sort-phrase-19      as character no-undo .
     2940   define variable  where-phrase-rus-19 as character no-undo .
     2941   define variable  sort-phrase-rus-19  as character no-undo .
     2942     run waitfram-show in this-procedure
     2943       (input "ЖДИТЕ ..."
     2944       ).
     2945   run gbl/flt-get.p
     2946     (input filter-point
     2947     ,output flt-rec-19
     2948     ,output filter-name-19
     2949     ,output where-phrase-19
