      615   procedure get-last-check-date-time :
      616       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      617       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      618       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      619       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      620       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      621       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      622       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      623       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      624       define variable v-character as character no-undo .
      625       define variable v-date      as date      no-undo .
      626       define variable v-decimal   as decimal   no-undo .
      627       define variable v-integer   as integer   no-undo .
      628       define variable v-logical   as logical   no-undo .
      629       define variable v-attr-type as character no-undo .
      630       define buffer buf_chk-doc     for ub.chk-doc.
      631       define buffer buf_c-cash-desk for ub.c-cash-desk.
      632       do
      633           on error undo, return error
      634           :
      635           run cd-attr-value in this-procedure (
      636               input g#db-num
      637               ,input p-obj-code
      638               ,input p-pos-type
      639               ,input p-cash-num
      640               ,input 'MAGIA-XML_operative':U
      641               ,input 'last-check-date-time':U
      642               ,output v-character
      643               ,output v-date
      644               ,output v-decimal
      645               ,output v-integer
      646               ,output v-logical
      647               ,output v-attr-type     ) no-error.
      648           if v-character = "":U
      649               or v-character = ?
      650               then
      651           do:
      652               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      653                   buf_c-cash-desk.db-num = g#db-num
      654                   AND buf_c-cash-desk.pos-type = p-pos-type
      655                   AND buf_c-cash-desk.cash-num = p-cash-num
      656                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      657                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      658               if available buf_c-cash-desk then
      659               do:
      660                   assign
      661                       p-date = buf_c-cash-desk.corr-date
      662                       p-time = buf_c-cash-desk.corr-time
      663                       .
      664               end.
      665               else
      666               do:
      667                   find first buf_chk-doc no-lock where
      668                       buf_chk-doc.obj-type = 'маг':U
      669                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      670                   if not available buf_chk-doc then
      671                   do:
      672                       return error.
      673                   end.
      674                   assign
      675                       p-date = buf_chk-doc.chk-date - 1
      676                       p-time = buf_chk-doc.chk-time
      677                       .
      678               end.
      679           end.
      680           else
      681           do:
      682               assign
      683                   p-date = cd-attr-parse-date-time( v-character, output p-time )
      684           no-error .
      685               if error-status:error then return error .
      686           end.
      687       end.
      688   end procedure.
      689   procedure get-last-check-params :
      690       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      691       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      692       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      693       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      694       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      695       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      696       define output parameter p-shift-num like ub.chk-doc.shift-num no-undo init 0.
      697       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      698       define output parameter p-chk-num like ub.chk-doc.chk-num no-undo init 0.
      699       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      700       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      701       define variable v-character as character no-undo .
      702       define variable v-date      as date      no-undo .
      703       define variable v-decimal   as decimal   no-undo .
      704       define variable v-integer   as integer   no-undo .
      705       define variable v-logical   as logical   no-undo .
      706       define variable v-attr-type as character no-undo .
      707       define buffer buf_chk-doc     for ub.chk-doc.
      708       define buffer buf_c-cash-desk for ub.c-cash-desk.
      709       do
      710           on error undo, return error
      711           :
      712           run cd-attr-value in this-procedure (
      713               input g#db-num
      714               ,input p-obj-code
      715               ,input p-pos-type
      716               ,input p-cash-num
      717               ,input if p-pos-type eq 'IBM-XML':U
      718               then 'IBM-XML_operative':U
      719               else 'AUTOTANK_operative':U
      720               ,input if p-pos-type = 'IBM-XML':U
      721               then 'last-check-params':U
      722               else 'last-check-params':U
      723               ,output v-character
      724               ,output v-date
      725               ,output v-decimal
      726               ,output v-integer
      727               ,output v-logical
      728               ,output v-attr-type     ) no-error.
      729           if v-character = "":U
      730               or v-character = ?
      731               then
      732           do:
      733               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      734                   buf_c-cash-desk.db-num = g#db-num
      735                   AND buf_c-cash-desk.pos-type = p-pos-type
      736                   AND buf_c-cash-desk.cash-num = p-cash-num
      737                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      738                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      739               if available buf_c-cash-desk then
      740               do:
      741                   assign
      742                       p-date = buf_c-cash-desk.corr-date
      743                       p-time = buf_c-cash-desk.corr-time
      744                       .
      745               end.
      746               else
      747               do:
      748                   find first buf_chk-doc no-lock where
      749                       buf_chk-doc.obj-type = 'маг':U
      750                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      751                   if not available buf_chk-doc then
      752                   do:
      753                       return error.
      754                   end.
      755                   assign
      756                       p-date      = buf_chk-doc.chk-date - 1
      757                       p-time      = buf_chk-doc.chk-time
      758                       p-shift-num = buf_chk-doc.shift-num
      759                       p-z-count   = buf_chk-doc.z-number
      760                       p-chk-num   = buf_chk-doc.chk-num
      761                       .
      762               end.
      763           end.
      764           else
      765           do:
      766               assign
      767                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      768                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      769                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      770                   p-z-count   = integer(entry(4, v-character, chr(32) ))
      771                   p-z-count   = (if p-z-count = ? then 0 else p-z-count)
      772                   p-chk-num   = integer(entry(5, v-character, chr(32) ))
      773           no-error .
      774               if error-status:error then return error .
      775           end.
      776       end.
      777   end procedure.
      778   procedure get-last-report-params :
      779       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      780       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      781       define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
      782       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      783       define output parameter p-date like ub.chk-slip-head.slip-dt no-undo .
      784       define output parameter p-time like ub.chk-doc.chk-time no-undo .
      785       define output parameter p-shift-num like ub.chk-slip-head.CashShiftNum no-undo init 0.
      786       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      787       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      788       define variable v-character as character no-undo .
      789       define variable v-date      as date      no-undo .
      790       define variable v-decimal   as decimal   no-undo .
      791       define variable v-integer   as integer   no-undo .
      792       define variable v-logical   as logical   no-undo .
      793       define variable v-date1     as character no-undo .
      794       define variable v-date2     as character no-undo .
      795       define variable v-attr-type as character no-undo .
      796       define buffer buf_chk-slip-head for ub.chk-slip-head.
      797       define buffer buf_c-cash-desk   for ub.c-cash-desk.
      798       do
      799           on error undo, return error
      800           :
      801           run cd-attr-value in this-procedure (
      802               input g#db-num
      803               ,input p-obj-code
      804               ,input p-pos-type
      805               ,input p-cash-num
      806               ,input if p-pos-type eq 'IBM-XML':U
      807               then 'IBM-XML_operative':U
      808               else 'AUTOTANK_operative':U
      809               ,input if p-pos-type = 'IBM-XML':U
      810               then 'last-report-params':U
      811               else 'last-report-params':U
      812               ,output v-character
      813               ,output v-date
      814               ,output v-decimal
      815               ,output v-integer
      816               ,output v-logical
      817               ,output v-attr-type     ) no-error.
      818           if v-character = "":U
      819               or v-character = ?
      820               then
      821           do:
      822               find last buf_chk-slip-head no-lock where
      823                   buf_chk-slip-head.obj-code = p-obj-code
      824                   and buf_chk-slip-head.cash-num = p-cash-num
      825                   and buf_chk-slip-head.db-num = p-db-num
      826                   and buf_chk-slip-head.is-report = 1 no-error.
      827               if not available buf_chk-slip-head then
      828               do:
      829                   return error.
      830               end.
      831               v-date2 = entry(2,string(buf_chk-slip-head.slip-dt)," ") .
      832               v-date1 = string(substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 7, 4 )) + "-" +
      833                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 4, 2 ) ) + "-" +
      834                   string( substr( entry(1,string(buf_chk-slip-head.slip-dt)," "), 1, 2 ) )
      835                   + " " + entry(1,v-date2,".") .
      836               assign
      837                   p-date      = cd-attr-parse-date-time( string(v-date1), output p-time )
      838                   p-shift-num = buf_chk-slip-head.CashShiftNum
      839                   .
      840           end.
      841           else
      842           do:
      843               assign
      844                   p-date      = cd-attr-parse-date-time( substring(v-character, 1, 19), output p-time )
      845                   p-shift-num = integer(entry(3, v-character, chr(32) ))
      846                   p-shift-num = (if p-shift-num = ? then 0 else p-shift-num)
      847           no-error .
      848               if error-status:error then return error .
      849           end.
      850       end.
      851   end procedure.
      852   procedure get-last-check-maria :
      853       define input parameter p-db-num like ub.cash-desk.db-num no-undo .
      854       define input parameter p-obj-code like ub.cash-desk.obj-code no-undo .
      855       define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
      856       define output parameter p-date like ub.chk-doc.chk-date no-undo .
      857       define output parameter p-z-count like ub.chk-doc.z-number no-undo init 0.
      858       define output parameter p-num-recs as integer no-undo .
      859       define output parameter p-p-date like ub.chk-doc.chk-date no-undo .
      860       define output parameter p-p-z-count like ub.chk-doc.z-number no-undo init 0.
      861       define output parameter p-p-num-recs as integer no-undo .
      862       define variable v-last-date like ub.chk-doc.chk-date no-undo .
      863       define variable v-last-time like ub.chk-doc.chk-date no-undo .
      864       define variable v-character as character no-undo .
      865       define variable v-date      as date      no-undo .
      866       define variable v-decimal   as decimal   no-undo .
      867       define variable v-integer   as integer   no-undo .
      868       define variable v-logical   as logical   no-undo .
      869       define variable v-attr-type as character no-undo .
      870       define buffer buf_chk-doc     for ub.chk-doc.
      871       define buffer buf_c-cash-desk for ub.c-cash-desk.
      872       do
      873           on error undo, return error
      874           :
      875           run cd-attr-value in this-procedure (
      876               input p-db-num
      877               ,input p-obj-code
      878               ,input 'MARIA':U
      879               ,input p-cash-num
      880               ,input 'MARIA_operative':U
      881               ,input 'last-check-maria':U
      882               ,output v-character
      883               ,output v-date
      884               ,output v-decimal
      885               ,output v-integer
      886               ,output v-logical
      887               ,output v-attr-type     ) no-error.
      888           if v-character = "":U
      889               or v-character = ?
      890               then
      891           do:
      892               FIND FIRST BUF_c-CASh-DESK NO-LOCK where
      893                   buf_c-cash-desk.db-num = p-db-num
      894                   AND buf_c-cash-desk.pos-type = 'MARIA':U
      895                   AND buf_c-cash-desk.cash-num = p-cash-num
      896                   AND buf_c-cash-desk.subject  = 'cash-desk':U
      897                   and buf_c-cash-desk.action = integer('1':U) use-index pi no-error .
      898               if available buf_c-cash-desk then
      899               do:
      900                   assign
      901                       p-date   = buf_c-cash-desk.corr-date
      902                       p-p-date = buf_c-cash-desk.corr-date
      903                       .
      904               end.
      905               else
      906               do:
      907                   find first buf_chk-doc no-lock where
      908                       buf_chk-doc.obj-type = 'маг':U
      909                       AND buf_chk-doc.obj-code = p-obj-code no-error.
      910                   if not available buf_chk-doc then
      911                   do:
      912                       assign
      913                           p-date       = 01/01/1990
      914                           p-z-count    = 1
      915                           p-num-recs   = 0
      916                           p-p-date     = 01/01/1990
      917                           p-p-z-count  = 1
      918                           p-p-num-recs = 0
      919                           .
      920                   end.
      921                   assign
      922                       p-date       = buf_chk-doc.chk-date - 1
      923                       p-z-count    = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      924                       p-num-recs   = 0
      925                       p-p-date     = buf_chk-doc.chk-date - 1
      926                       p-p-z-count  = (if buf_chk-doc.z-number = ? then 1 else  buf_chk-doc.z-number)
      927                       p-p-num-recs = 0
      928                       .
      929               end.
      930           end.
      931           else
      932           do:
      933               assign
      934                   p-date       = date( integer(entry(2, entry(1, v-character, chr(32)), '-':U))
      935                         ,integer(entry(3, entry(1, v-character, chr(32)), '-':U))
      936                         ,integer(entry(1, entry(1, v-character, chr(32)), '-':U))
      937                         )
      938                   p-z-count    = integer(entry(2, v-character, chr(32) ))
      939                   p-z-count    = (if p-z-count = ? then 0 else p-z-count)
      940                   p-num-recs   = integer(entry(3, v-character, chr(32) ))
      941                   p-num-recs   = (if p-num-recs = ? then 0 else p-num-recs)
      942                   p-p-date     = date( integer(entry(2, entry(4, v-character, chr(32)), '-':U))
      943                         ,integer(entry(3, entry(4, v-character, chr(32)), '-':U))
      944                         ,integer(entry(1, entry(4, v-character, chr(32)), '-':U))
      945                         )
      946                   p-p-z-count  = integer(entry(5, v-character, chr(32) ))
      947                   p-p-z-count  = (if p-z-count = ? then 0 else p-z-count)
      948                   p-p-num-recs = integer(entry(6, v-character, chr(32) ))
      949                   p-p-num-recs = (if p-p-num-recs = ? then 0 else p-p-num-recs)
      950           no-error .
      951               if error-status:error then return error .
      952           end.
      953       end.
      954   end procedure.
      955   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   PROCEDURE verify-ini-entry:
      957   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      958   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      959   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      960   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      961   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      962   define variable v-mess as character no-undo .
      963   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      964   if ini-entry-value = ? and ini-key-name begins "spl"
      965   then
      966   get-key-value section ini-section-name key "splall" value ini-entry-value.
      967   if ini-entry-value = ? and ini-key-name begins "sav"
      968   then
      969   get-key-value section ini-section-name key "savall" value ini-entry-value.
      970   if ini-entry-value = ? then do:
      971     assign
      972     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      973                       , chr(10)
      974                       , ini-section-name
      975                       , ini-key-name
      976                       , error-msg-text).
      977       if not silence then do:
      978         message
      979         v-mess
      980         view-as alert-box ERROR  .
      981         return error.
      982       end.
      983       else do:
      984         return error v-mess.
      985       end.
      986   end.
      987   END PROCEDURE.
      988   PROCEDURE verify-file:
      989   DEFINE INPUT  PARAMETER filename       as character no-undo.
      990   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      991   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      992   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      993   file-info:file-name = filename.
      994   found = NOT (file-info:full-pathname = ?).
      995   if NOT found  then do:
      996     if not silence then do:
      997       message error-msg-text
      998       view-as alert-box ERROR.
      999       return error.
     1000     end.
     1001     else return error error-msg-text.
     1002   end.
     1003   END PROCEDURE.
     1004   define variable vss-revision3    as character no-undo init "$Revision:$":U .
     1005   define variable vss-author3      as character no-undo init "$Author:$":U .
     1006   define variable vss-date3        as character no-undo init "$Date:$":U .
     1007   define variable vss-workfile3    as character no-undo init "$Workfile:$":U .
     1008   define variable vss-archive3     as character no-undo init "$Archive:$":U .
     1009   define variable vss-description3 as character no-undo init "Работа С сокетом".
     1010   procedure PutMesAsunc:
     1011       define input  parameter Itext as character no-undo.
