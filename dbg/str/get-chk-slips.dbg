     1040   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   define variable v-waitfram-action01         as character   no-undo .
     1042   define variable v-waitfram-action02         as character   no-undo .
     1043   define variable v-waitfram-action03         as character   no-undo .
     1044   define variable mWaitFramTextBeg            as character   no-undo.
     1045   define variable mWaitFramTextEnd            as character   no-undo.
     1046   define variable mWaitFramView               as logical     no-undo.
     1047   define variable mWaitProcEvent              as logical     no-undo init yes.
     1048   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1049   define variable mWaitFramStop               as logical     no-undo.
     1050   define variable mWaitFramStopUser           as logical     no-undo.
     1051   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1052   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1053   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1054   define button B-WaitFramStop auto-end-key
     1055        label "Стоп"
     1056        size 10 by 1 tooltip "Остоновить процесс".
     1057   define button B-viewProcInfo
     1058        label "Информация"
     1059        size 15 by 1 tooltip "Информация о процесс".
     1060   define frame waitfram
     1061     v-waitfram-action01 format "x(72)" no-label skip
     1062     v-waitfram-action02 format "x(72)" no-label skip
     1063     v-waitfram-action03 format "x(72)" no-label skip
     1064     B-viewProcInfo
     1065     B-WaitFramStop at row 4 col 30
     1066     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1067     .
     1068   define new global shared variable mBatchMode as logical no-undo init ?.
     1069   define variable mFramBachModHandle as handle no-undo.
     1070   mFramBachModHandle = frame waitfram:handle.
     1071   define variable mFameOldVis as logical no-undo.
     1072   define variable mVisCUrentVin as logical no-undo.
     1073   if session:batch-mode
     1074   then
     1075      mBatchMode = yes.
     1076   if mBatchMode = ? then do:
     1077     mVisCUrentVin = current-window:visible.
     1078     mFameOldVis = mFramBachModHandle:visible.
     1079     mFramBachModHandle:visible  = yes.
     1080     mBatchMode = mFramBachModHandle:visible ne yes.
     1081     mFramBachModHandle:visible = mFameOldVis.
     1082     current-window:visible = mVisCUrentVin.
     1083   end.
     1084    if  log-manager:logfile-name ne ?
     1085     then DO:
     1086         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1087         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1088         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1089     end.
     1090   on choose of B-WaitFramStop in frame waitfram
     1091   do:
     1092     mWaitFramStop = yes.
     1093     mWaitFramStopUser = yes.
     1094   end.
     1095   function waitfram-check-timeout returns logical():
     1096      define variable vtime as int64 no-undo.
     1097      if mWaitFramStopTimeOut
     1098      then
     1099         return yes.
     1100      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1101      if     mWaitFramTimeOut ne ?
     1102         and mWaitFramTimeOut ne 0
     1103         and mWaitFramTimeOut lt vtime
     1104      then do:
     1105         mWaitFramStopTimeOut = yes.
     1106      end.
     1107      return mWaitFramStopTimeOut.
     1108   end.
     1109   procedure waitfram-hide :
     1110     if not session:batch-mode
     1111     then do
     1112     on error undo, return error return-value
     1113     :
     1114       pause 0 before-hide .
     1115       if not mBatchMode then
     1116         hide frame waitfram .
     1117     if     not mWaitFramView
     1118        and mWaitProcEvent
     1119     then
     1120       process events .
     1121     end.
     1122   end procedure.
     1123   procedure waitfram-show :
     1124     define input  parameter p-message as character no-undo .
     1125     define variable v-left-margin as integer   no-undo .
     1126     if not session:batch-mode
     1127     then do
     1128     on error undo, return error return-value
     1129     :
     1130       if length(p-message) <= 70 then do:
     1131         assign
     1132           v-left-margin = integer((70 - length(p-message)) / 2)
     1133         .
     1134         assign
     1135           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1136         .
     1137         assign
     1138           v-waitfram-action01 = " "
     1139           v-waitfram-action02 = " "
     1140                                    + fill(" ", v-left-margin)
     1141                                    + p-message
     1142           v-waitfram-action03 = " "
     1143         .
     1144       end.
     1145       else do:
     1146         define variable vRindex1 as integer no-undo.
     1147         define variable vRindex2 as integer no-undo.
     1148         vRindex1 = r-index(p-message," ",70).
     1149         if vRindex1 = 0
     1150         then
     1151            vRindex1 = 70.
     1152         if length(p-message)  <= vRindex1 + 70 then do:
     1153           assign
     1154             v-waitfram-action01 = " "
     1155             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1156             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1157           .
     1158         end.
     1159         else do:
     1160           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1161           if vRindex2 <= vRindex1
     1162           then
     1163              vRindex2 = vRindex1 + 70.
     1164           assign
     1165             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1166             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1167             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1168           .
     1169         end.
     1170       end.
     1171       B-viewProcInfo:visible   in frame waitfram = no.
     1172       B-viewProcInfo:sensitive in frame waitfram = no.
     1173       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1174       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1175       if  (   mWaitFramView
     1176          or  mWaitProcEvent)
     1177          and not mBatchMode
     1178       then
     1179          display
     1180             v-waitfram-action01 skip
     1181             v-waitfram-action02 skip
     1182             v-waitfram-action03 skip
     1183          with frame waitfram .
     1184       if     mWaitFramView
     1185          then do:
     1186             if     mWaitFramInterval ne ?
     1187                and not mBatchMode
     1188             then
     1189                wait-for go of frame waitfram pause mWaitFramInterval.
     1190          end.
     1191          else
     1192             if     mWaitProcEvent
     1193                and not mBatchMode
     1194             then
     1195                process events .
     1196     end.
     1197   end procedure.
     1198      procedure waitfram-show-this:
     1199         define input  parameter iInterval as int64 no-undo.
     1200         define variable vtime as int64 no-undo.
     1201         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1202         mWaitFramInterval = iInterval.
     1203         run waitfram-show (substitute("&1&2 &3&4" ,
     1204                                       mWaitFramTextBeg ,
     1205                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1206                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1207                                       mWaitFramTextEnd
     1208                                      )
     1209                           ).
     1210      end.
     1211      procedure WaitFramRunPause:
     1212         define input  parameter iInterval as dec no-undo.
     1213         define variable vStart  as datetime-tz no-undo.
     1214         define variable vend    as datetime-tz no-undo.
     1215         define variable vint as int64 no-undo.
     1216         define variable vOk as logical no-undo.
     1217         vStart = now.
     1218         vend   = vStart.
     1219         publish "WaitFramPause" (iInterval,output vOk).
     1220         vend   =  now.
     1221         vint = vend - vStart.
     1222         vint = iInterval - vint / 1000.
     1223         if     not mWaitFramStop
     1224            and (   vint > 0
     1225                 or (    not vOk
     1226                     and iInterval eq ?
     1227                     )
     1228                 )
     1229         then
     1230            run waitfram-show-this (iInterval).
     1231         vend   =  now.
     1232         vint = vend - vStart.
     1233         vint = iInterval - vint / 1000.
     1234         if     not mWaitFramStop
     1235            and vint > 0
     1236         then do:
     1237            run gbl/pause.p (vint * 1000).
     1238         end.
     1239         if iInterval ne ?
     1240         then
     1241            publish "WaitFramStop".
     1242         waitfram-check-timeout().
     1243      end.
     1244      procedure WaitFramWaitFor:
     1245         define input  parameter iInterval as dec no-undo.
     1246         assign
     1247            mWaitFramStartProc   = now
     1248            mWaitFramStopUser    = no
     1249            mWaitFramStopTimeOut = no
     1250         .
     1251         block-wait:
     1252         do while not mWaitFramStop:
     1253            run WaitFramRunPause (iInterval).
     1254            if  waitfram-check-timeout()
     1255            then do:
     1256               leave block-wait.
     1257            end.
     1258         end.
     1259         run waitfram-hide.
     1260      end.
     1261   procedure waitfram-join :
     1262     define input  parameter p-line-1  as character no-undo .
     1263     define input  parameter p-line-2  as character no-undo .
     1264     define input  parameter p-line-3  as character no-undo .
     1265     define output parameter p-message as character no-undo .
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       assign
     1270         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1271                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1272                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1273       .
     1274     end.
     1275   end procedure.
     1276   function waitfram-join-function returns character
     1277     (input p-line-1 as character
     1278     ,input p-line-2 as character
     1279     ,input p-line-3 as character
     1280     ).
     1281     define variable v-message as character no-undo .
     1282     run waitfram-join in this-procedure
     1283       (input  p-line-1
     1284       ,input  p-line-2
     1285       ,input  p-line-3
     1286       ,output v-message
     1287       ) .
     1288     return v-message .
     1289   end function .
     1290   define variable mHSocket       as handle      no-undo.
     1291   define variable mWebRespHead   as longchar    no-undo.
     1292   define variable mWebResp       as longchar    no-undo.
     1293   define variable mWebRespMptr   as memptr      no-undo.
     1294   define variable OerrMsg        as character   no-undo.
     1295   define variable mFileLogSocet  as character   no-undo.
     1296   define variable mReturnHttp    as logical     no-undo.
     1297   define variable mAddTimeOut    as logical     no-undo init yes.
     1298   define variable mSocetBegTime  as datetime-tz no-undo.
     1299   define variable mSocetEndTime  as dec         no-undo.
     1300   define variable mWriteRespFile as character   no-undo.
     1301   define variable mTypeResponse  as character   no-undo init "POST".
     1302   publish "getSocetLog" (output mFileLogSocet).
     1303   if
     1304      (   mFileLogSocet eq ""
     1305       or mFileLogSocet eq ?)
     1306      and session:debug-alert
     1307   then
     1308      mFileLogSocet = "socet.log".
     1309   procedure ConectSocet:
     1310      define input  parameter iHost       as character no-undo.
     1311      define input  parameter iPort       as character no-undo.
     1312      define input  parameter iUrl        as character no-undo.
     1313      define input  parameter iPostData   as longchar  no-undo.
     1314      define input  parameter iReturnType as character no-undo.
     1315      define input  parameter iTimeOut    as decimal   no-undo.
     1316      define input  parameter iSilent     as logical   no-undo.
     1317      define input  parameter iTextWait   as character no-undo.
     1318      mWaitFramTextBeg = iTextWait.
     1319      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     1320      if OerrMsg eq ""
     1321      then
     1322         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     1323      mSocetEndTime = (now - mSocetBegTime) / 1000.
     1324   end.
     1325   procedure SendReqSocet:
     1326      define input  parameter iHost            as character no-undo.
     1327      define input  parameter iPort            as character no-undo.
     1328      define input  parameter iUrl             as character no-undo.
     1329      define input  parameter iPostData        as longchar  no-undo.
     1330      define input  parameter iReturnType      as character no-undo.
     1331      define input  parameter iProcGetResponse as character no-undo.
     1332      mSocetBegTime = now.
     1333      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     1334      assign
     1335         mWebResp         = ""
     1336         mWebResphead     = ""
     1337         OerrMsg          = ""
     1338         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     1339         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     1340      .
     1341      define variable vPostData as longchar                       no-undo.
     1342      if    iHost eq ""
     1343         or iHost eq ?
     1344      then do:
     1345         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     1346         run writeLogSocet in this-procedure (oErrMsg).
     1347         return oErrMsg.
     1348      end.
     1349      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     1350      create socket mHSocket.
     1351      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     1352      if mHSocket:connected() = false
     1353      then do:
     1354         run waitfram-hide .
     1355         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     1356         run writeLogSocet in this-procedure (oErrMsg).
     1357         delete object mHSocket.
     1358         return oErrMsg.
     1359      end.
     1360      run waitfram-show ("Отправка данных").
     1361      mHSocket:set-read-response-procedure(iProcGetResponse).
     1362      run PostRequest (
     1363       input iUrl,
     1364       input iHost + ":" + iPort,
     1365       input iPostData
     1366       ).
     1367       run waitfram-hide .
     1368   end.
     1369   procedure WaitRespSocet:
     1370      define input  parameter iTimeOut   as decimal   no-undo.
     1371      define input  parameter iSilent    as logical   no-undo.
     1372      define input  parameter iTextWait  as character no-undo.
     1373      if    not valid-handle (mHSocket )
     1374      then do:
     1375         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     1376         return "End connected".
     1377      end.
     1378      if mHSocket:connected() = false
     1379      then do:
     1380         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     1381         oErrMsg = "Not connected".
     1382         return oErrMsg.
     1383      end.
     1384      mWaitFramView = if iSilent ne yes then yes else no.
     1385      mWaitFramTextBeg = iTextWait.
     1386      mWaitFramTimeOut = iTimeOut.
     1387      mWaitFramTextEnd = "".
     1388      mWaitFramStop = no.
     1389      if mAddTimeOut
     1390      then do:
     1391         mWaitFramTimeOut = 300.
     1392         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     1393      end.
     1394      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     1395      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     1396      run WaitFramWaitFor(1).
     1397      unsubscribe "WaitFramStop".
     1398      if mWaitFramStopUser
     1399      then do:
     1400         OerrMsg = substitute("Операция прервана пользователем." ).
     1401         run writeLogSocet in this-procedure (OerrMsg).
     1402      end.
     1403      else if mWaitFramStopTimeOut
     1404      then do:
     1405         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     1406         run writeLogSocet in this-procedure (OerrMsg).
     1407      end.
     1408      run waitfram-hide .
     1409      mHSocket:disconnect() no-error.
     1410      delete object mHSocket.
     1411   end.
     1412   procedure WaitRespTestStop:
     1413      if mWaitFramStopTimeOut
     1414      then
     1415         return.
     1416      if     (mWebResp ne ""
     1417          and mWebResp ne ?)
     1418      then do:
     1419         mWaitFramStop = yes.
     1420         return.
     1421      end.
     1422      else if mHSocket:connected() = false
     1423      then do:
     1424         mWaitFramStop = yes.
     1425         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     1426         oErrMsg = "Not connected".
     1427         return oErrMsg.
     1428      end.
     1429      wait-for read-response of mHSocket pause 0.001.
     1430   end.
     1431   procedure PostRequest:
     1432      define input parameter iPostUrl  as char.
     1433      define input parameter iPostHost as char.
     1434      define input parameter iPostData as longchar.
     1435      define variable vCRequest      as longchar.
     1436      define variable vMRequest       as memptr.
     1437      if iPostUrl ne ?
     1438      then do:
     1439         vCRequest =substitute(
     1440         '&5 /&2 HTTP/1.1&1'                                   +
     1441         'Host: &4&1'                                           +
     1442         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     1443         'Accept: */*&1' +
     1444         'Content-Type: text/xml&1'               +
     1445         'Content-Length: &3&1'                                  +
     1446         '&1'
     1447         ,
     1448         chr(13) + chr(10),
     1449         iPostUrl,
     1450         length(iPostData),
     1451         iPostHost,
     1452         mTypeResponse) + iPostData.
     1453      end.
     1454      else
     1455         vCRequest = iPostData.
     1456      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     1457      run writeLogSocet in this-procedure (vCRequest).
     1458      SET-SIZE(vMRequest)            = 0.
     1459      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     1460      SET-BYTE-ORDER(vMRequest)      = big-endian.
     1461      PUT-STRING(vMRequest,1)        = vCRequest .
     1462      if mHSocket:connected() = false then
     1463      do:
     1464         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     1465         oErrMsg = "Not connected".
     1466         delete object mHSocket no-error.
     1467         return oErrMsg.
     1468      end.
     1469      mHSocket:write(vMRequest, 1, length(vCRequest)).
     1470      run writeLogSocet in this-procedure ("Запрос отправлен.").
     1471   end procedure.
     1472   function hex-to-int returns integer (
     1473     input p-hex-code  as character  ).
     1474     define variable v-int-code as integer   no-undo .
     1475     define variable v-ind      as integer   no-undo .
     1476     define variable v-digit    as integer   no-undo .
     1477     define variable v-letter   as character no-undo .
     1478     do v-ind = 1 to length(p-hex-code)
     1479     :
     1480       assign
     1481         v-letter = caps(substring(p-hex-code, v-ind, 1))
     1482       .
     1483       assign
     1484         v-digit = index('123456789ABCDEF':u, v-letter)
     1485       .
     1486       assign
     1487         v-int-code = v-int-code * 16 + v-digit
     1488       .
     1489     end.
     1490     return v-int-code .
     1491   end function .
     1492   procedure getResponse:
     1493      define variable vFlagTag     as logical          no-undo init no.
     1494      define variable vResponse    as memptr           no-undo.
     1495      define variable vCnt         as int64            no-undo.
     1496      define variable vMessage     as longchar         no-undo.
     1497      define variable v-cont-length as int64 no-undo.
     1498      define variable vi           as integer no-undo.
     1499      define variable v-hd-line    as character no-undo.
     1500      define variable level        as integer no-undo initial 2.
     1501      repeat while program-name(level) <> ?:
     1502        if program-name(level) = program-name(1) then do:
     1503          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     1504          return "".
     1505        end.
     1506        level = level + 1.
     1507      end.
     1508      if mHSocket:connected() = false then
     1509      do:
     1510         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     1511         oErrMsg = "Not connected".
     1512         return oErrMsg.
     1513      end.
     1514      if mAddTimeOut
     1515      then do:
     1516         mWaitFramTimeOut = 1000.
     1517         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     1518      end.
     1519      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     1520      mWaitFramTextEnd = "Получаем ответ".
     1521      define variable vWaitProcEvent as logical no-undo.
     1522      vWaitProcEvent = mWaitProcEvent.
     1523      mWaitProcEvent = no.
     1524      run WaitFramRunPause (?).
     1525      define variable vByte as int64 no-undo.
     1526      define variable vNextMese as int64 no-undo init 100000.
     1527      define variable VFlag as logical no-undo init ? .
     1528      mWaitFramStop = no.
     1529      mWaitFramStopTimeOut = no.
     1530      block-wait:
     1531      do while mHSocket:get-bytes-available() > 0:
     1532         VFlag = no.
     1533         define variable vNumByte as integer no-undo.
     1534         vNumByte =   mHSocket:get-bytes-available().
     1535         if vNumByte > 30000 then vNumByte = 30000.
     1536         SET-SIZE(vResponse) = vNumByte + 1.
     1537         SET-BYTE-ORDER(vResponse) = big-endian.
     1538         mHSocket:read(vResponse,1,vNumByte).
     1539         vMessage = vMessage + GET-STRING(vResponse,1).
     1540         if  mReturnHTTp
     1541         then do:
     1542            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     1543            if vCnt > 0
     1544            then do:
     1545               mReturnHttp = no.
     1546               mWebResphead = substring (vMessage,1,vCnt).
     1547               vMessage     = substring (vMessage,vCnt + 4).
     1548               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     1549               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     1550                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     1551                  if  v-hd-line  begins "Content-Length"  then  do:
     1552                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     1553                  end.
     1554                  else if v-hd-line  begins "Transfer-Encoding"
     1555                  then do :
     1556                     define variable vChunked as logical no-undo.
     1557                     vchunked = index(v-hd-line,"chunked",19) > 0.
     1558                  end.
     1559               end.
     1560            end.
     1561         end.
     1562         vByte = vByte + vNumByte.
     1563         SET-SIZE(vResponse) = 0.
     1564         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     1565         then
     1566            leave block-wait.
     1567         if not mHSocket:get-bytes-available() > 0
     1568         then do:
     1569            VFlag = yes.
     1570            run WaitFramRunPause (?).
     1571            run gbl/pause.p (1000) .
     1572         end.
     1573         else if vByte > vNextMese
     1574         then do:
     1575            vNextMese = vNextMese + 100000.
     1576            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     1577            run WaitFramRunPause (?).
     1578         end.
     1579         if mWaitFramStopTimeOut
     1580         then do:
     1581            mWebResp = "".
     1582            leave block-wait.
     1583         end.
     1584      end.
     1585      if VFlag ne false
     1586      then
     1587         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     1588      mWaitFramStop = yes.
     1589      run writeLogSocet         in this-procedure ("Получен ответ").
     1590      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     1591      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     1592      run writeLogSocetOnlyText in this-procedure (vMessage).
     1593      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     1594      mHSocket:disconnect() no-error.
     1595      if v-cont-length > 0
     1596      then
     1597         mWebResp = substring (vMessage,1,v-cont-length).
     1598      else if vChunked
     1599      then do:
     1600         define variable vByteCopy as int64 no-undo init 1.
     1601         Block-Copy:
     1602         do while length(vMessage) > 0:
     1603            vByteCopy = 1.
     1604            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     1605            vByteCopy = vByteCopy +  vCnt + 2.
     1606            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     1607            if v-cont-length eq 0
     1608            then
     1609               leave Block-copy.
     1610            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     1611            vByteCopy = vByteCopy + v-cont-length + 2.
     1612            vMessage = substring  (vMessage,vByteCopy).
     1613         end.
     1614         run writeLogSocet         in this-procedure ("Заголовок").
     1615         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     1616         run writeLogSocet         in this-procedure ("Тело ответа").
     1617         run writeLogSocetOnlyText in this-procedure (mWebResp).
     1618        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     1619      end.
     1620      else
     1621         mWebResp = vMessage.
     1622      mWaitProcEvent = vWaitProcEvent.
     1623      mSocetEndTime = (now - mSocetBegTime) / 1000.
     1624      copy-lob mWebResp to mWebRespMptr.
     1625      if     mWriteRespFile ne ""
     1626         and mWriteRespFile ne ?
     1627      then
     1628           run gbl/fileapnd.p
     1629                ( mWriteRespFile
     1630                , mWebResp + chr(13) + chr(10)
     1631                ,input 10
     1632                ) no-error .
     1633   end procedure.
     1634   procedure writeLogSocet:
     1635      define input  parameter itext as longchar no-undo.
     1636      if mFileLogSocet eq "Async"
     1637      then
     1638         run PutMesAsunc(itext).
     1639      else if     mFileLogSocet ne ?
     1640              and mFileLogSocet ne ""
     1641      then do:
     1642         run gbl/fileapnd.p
     1643             ( mFileLogSocet
     1644             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     1645             ,input 10
     1646             ) no-error .
     1647         run writeLogSocetOnlyText(itext).
     1648         run gbl/fileapnd.p
     1649             ( mFileLogSocet
     1650             , substitute(" &1&2", chr(13) , chr(10))
     1651             ,input 10
     1652             ) no-error .
     1653      end.
     1654   end.
     1655   procedure writeLogSocetOnlyText:
     1656      define input  parameter itext as longchar no-undo.
     1657      if mFileLogSocet eq "Async"
     1658      then
     1659         run PutMesAsunc(itext).
     1660      else if     mFileLogSocet ne ?
     1661              and mFileLogSocet ne ""
     1662      then do:
     1663         if length(itext) > 32000
     1664         then
     1665            copy-lob
     1666      from object itext
     1667      to file mFileLogSocet append
     1668      no-error
     1669      .
     1670         else
     1671         run gbl/fileapnd.p
     1672             ( mFileLogSocet
     1673             , string(itext)
     1674             ,input 10
     1675             ) no-error .
     1676      end.
     1677   end.
     1678   procedure Disconect:
     1679      mHSocket:disconnect() no-error.
     1680      delete object mHSocket no-error.
     1681   end.
     1682   define variable Mreq as longchar no-undo.
     1683   function fConvetDateTime returns datetime
     1684   (input iTStamp as character):
     1685     define variable vDateTime as datetime no-undo.
     1686     define variable vDate     as date     no-undo.
     1687     define variable vDays     as int64    no-undo.
     1688     define variable vSec      as integer  no-undo.
     1689     vDays = truncate(int64(iTStamp) / 3600 / 24, 0).
     1690     vDate = date("01/01/1970") + vDays.
     1691     vSec = (int64(iTStamp) - vDays * 3600 * 24).
     1692     vDateTime = datetime(string(vDate) + " " + string(vSec, "HH:MM:SS")).
     1693     return vDateTime.
     1694   end function.
     1695   define temp-table tt-chk-slip-head no-undo like chk-slip-head .
     1696   define temp-table tt-chk-slip-string no-undo like chk-slip-string .
     1697   define temp-table tt-one-chk-slip-head no-undo like chk-slip-head .
     1698   define variable v-tth             as handle     no-undo.
     1699   define variable v-Param-Type      as character  no-undo.
     1700   define variable out               as character  no-undo.
     1701   define variable in_               as character  no-undo.
     1702   define variable glog              as logical    no-undo.
     1703   define variable v-value-character as character  no-undo.
     1704   define variable v-value-date      as date       no-undo.
     1705   define variable v-value-decimal   as decimal    no-undo.
     1706   define variable v-value-integer   as integer    no-undo.
     1707   define variable v-value-logical   as logical    no-undo.
     1708   define variable v-no-get-chk      as logical    no-undo.
     1709   define variable m-obj-code           as integer   no-undo.
     1710   define variable m-cash-num           as integer   no-undo.
     1711   define variable m-pos-type           as character no-undo.
     1712   define variable m-post-file-name     as character no-undo.
     1713   define variable m-response-file-name as character no-undo.
     1714   define variable m-xml-file-name      as character no-undo.
     1715   define variable m-obj-list           as character no-undo.
     1716   define variable m-correspondent      as character no-undo.
     1717   define variable m-timestamp          as character no-undo.
     1718   define variable Check-ctrl           as character no-undo.
     1719   define variable ErrorMessage         as character no-undo.
     1720   define variable mElement             as character no-undo.
     1721   define variable mCount               as int64     no-undo.
     1722   define variable m-err-msg            as character no-undo.
     1723   define variable m-textCheq           as longchar  no-undo.
     1724   run adm/shattri.p (
     1725       input "get":U
     1726       ,input  p-obj-type
     1727       ,input  p-obj-code
     1728       ,input  'get-chk':U
     1729       ,input  'no-get-chk':U
     1730       ,output v-value-character
     1731       ,output v-value-date
     1732       ,output v-value-decimal
     1733       ,output v-value-integer
     1734       ,output v-value-logical
     1735       ,output v-param-type
     1736       ,INPUT-OUTPUT table-handle v-tth
     1737       ) no-error .
     1738   v-no-get-chk = v-value-logical.
     1739   if v-no-get-chk then do:
     1740      m-err-msg = substitute( "Согласно настроечным параметрам НЕТ приема чеков в &1&2!!!&3"
     1741                             ,p-obj-type
     1742                             ,p-obj-code
     1743                             ,chr(10)
     1744                            ).
     1745      return error m-err-msg.
     1746   end.
     1747   run verify-ini-entry("in":U,
     1748                         substitute("kassa-&1":U, 'IBM-XML':U),
     1749                         substitute ("отсутствует путь к подкаталогу out" + chr(10) + "для отсылки информации на POS &1", 'IBM-XML':U),
     1750                         yes,
     1751                         output in_) no-error.
     1752   if error-status:error or in_ = ? then return error return-value .
     1753   RUN verify-file in this-procedure
     1754                                     ( in_
     1755                                     , substitute("Не найден каталог &1 параметр in, секция [kassa-&2] ini-файла", in_, 'IBM-XML':U)
     1756                                     ,yes
     1757                                     ,output glog) no-error.
     1758   if error-status:error or not glog then return error return-value .
     1759   run verify-ini-entry("out":U,
     1760                         substitute("kassa-&1":U, 'IBM-XML':U),
     1761                         substitute ("отсутствует путь к подкаталогу out" + chr(10) + "для отсылки информации на POS &1", 'IBM-XML':U),
     1762                         yes,
     1763                         output out) no-error.
     1764   if error-status:error or out = ? then return error return-value .
     1765   run verify-file in this-procedure
     1766                                     ( out
     1767                                     , substitute("Не найден каталог &1 параметр out, секция [kassa-&2] ini-файла", out, 'IBM-XML':U)
     1768                                     , yes
     1769                                     ,output glog) no-error.
     1770   if error-status:error or not glog then return error return-value .
     1771   run gbl/dir-cre.p ( input in_ + 'slips\') no-error .
     1772   if error-status:error then do:
     1773     return error substitute(
     1774                           "!!!Каталог &1 не найден&2" +
     1775                           "и/или попытка его создания не удалась:&2&3 &4"
     1776                           , in_ + 'slips\'
     1777                           , chr(10)
     1778                           , error-status:get-message(1)
     1779                           , return-value
     1780                           ).
     1781   end.
     1782   run gbl/dir-cre.p ( input out + 'slips\') no-error .
     1783   if error-status:error then do:
     1784     return error substitute(
     1785                           "!!!Каталог &1 не найден&2" +
     1786                           "и/или попытка его создания не удалась:&2&3 &4"
     1787                           , out + 'slips\'
     1788                           , chr(10)
     1789                           , error-status:get-message(1)
     1790                           , return-value
     1791                           ).
     1792   end.
     1793   run MainProc no-error.
     1794   if error-status:error then do:
     1795     return error return-value.
     1796   end.
     1797   procedure MainProc:
     1798     define buffer cash-desk for cash-desk.
     1799     define variable vMsg as character no-undo.
     1800     _cash-desk:
     1801     FOR EACH cash-desk WHERE
     1802              cash-desk.db-num   = g#db-num
     1803          and cash-desk.obj-code = p-obj-code
     1804          and cash-desk.pos-type = 'IBM-XML':U
     1805          and cash-desk.cash-on  = yes
     1806     no-lock:
     1807       empty temp-table tt-chk-slip-head.
     1808       empty temp-table tt-chk-slip-string.
     1809       assign
     1810         m-xml-file-name      = substring(string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1811         m-obj-list           = 'маг':U + "_" + string(cash-desk.obj-code)
     1812         m-correspondent      = ("касса_" + string(cash-desk.cash-num) + "_" + m-obj-list)
     1813         m-post-file-name     = replace(out + "slips/" + m-xml-file-name, "/", "\" ) + ".xml":U
     1814         m-response-file-name = replace(in_ + "slips/" + m-xml-file-name, "/", "\" ) + ".xml":U
     1815         m-obj-code           = cash-desk.obj-code
     1816         m-pos-type           = cash-desk.pos-type
     1817         m-cash-num           = cash-desk.cash-num
     1818         mCount               = 0
     1819       .
     1820       run pGetLastTStamp(m-obj-code,
     1821                          m-pos-type,
     1822                          m-cash-num,
     1823                          output m-timestamp).
     1824       run write-log-and-file in p-log-handle (
     1825                         input 1
     1826                       , input p-log-file-name
     1827                       , input 1
     1828                       , input substitute('Получаем данные по слипам с кассы &1://&2'
     1829                                     ,entry(1, cash-desk.addr-path, chr(4))
     1830                                     ,entry(2, cash-desk.addr-path, chr(4))
     1831                                   )
     1832                                                         ).
     1833       run SaxWriter no-error.
     1834       if error-status:error then do:
     1835          return error return-value.
     1836       end.
     1837       mWriteRespFile = m-response-file-name + "sckt".
     1838       run ConectSocet (entry(1,entry(2, cash-desk.addr-path, chr(4)),":"),
     1839                        entry(2,entry(2, cash-desk.addr-path, chr(4)),":"),
     1840                        "",
     1841                        Mreq,
     1842                        "xml",
     1843                        300,
     1844                        no,
     1845                        substitute ("Чтение данных по слипам с кассы &1. ",entry(2, cash-desk.addr-path, chr(4)))
     1846                        ).
     1847       if    mWebResp eq ""
     1848          or OerrMsg  ne ""
     1849       then do:
     1850          run write-log-and-file in p-log-handle (
     1851              input 1
     1852            , input p-log-file-name
     1853            , input 1
     1854            , input substitute( "!!!Касса &1 маг&2 не ответила:&3&4 &5"
     1855                                  ,cash-desk.cash-num
     1856                                  ,cash-desk.obj-code
     1857                                  , chr(10)
     1858                                  , OerrMsg
     1859                              )
     1860                                              ).
     1861           nEXT _cash-desk.
     1862        end.
     1863        else do:
     1864           run write-log-and-file in p-log-handle (
     1865              input 1
     1866            , input p-log-file-name
     1867            , input 1
     1868            , input substitute('Время ожидания выполнения задания на кассе - &1 c',
     1869                          mSocetEndTime
     1870                        )
     1871                                              ).
     1872       end.
     1873       run SaxReader no-error.
     1874       if ErrorMessage <> "" or error-status:error then do:
     1875         return error ErrorMessage + " " + return-value.
     1876       end.
     1877       do transaction:
     1878         for each tt-chk-slip-head where
     1879                  tt-chk-slip-head.cash-num = m-cash-num:
     1880           find first chk-slip-head where
     1881                      chk-slip-head.db-num    = tt-chk-slip-head.db-num
     1882                  and chk-slip-head.ID        = tt-chk-slip-head.ID
     1883                  and chk-slip-head.CheckID   = tt-chk-slip-head.CheckID
     1884                  and chk-slip-head.RRN       = tt-chk-slip-head.RRN
     1885           no-lock no-error.
     1886           if not avail chk-slip-head then do:
     1887             create chk-slip-head .
     1888             buffer-copy tt-chk-slip-head to chk-slip-head .
     1889             for each tt-chk-slip-string no-lock where tt-chk-slip-string.db-num  = tt-chk-slip-head.db-num
     1890                                                   and tt-chk-slip-string.ID      = tt-chk-slip-head.ID
     1891                                                   and tt-chk-slip-string.CheckID = tt-chk-slip-head.CheckID
     1892                                                   and tt-chk-slip-string.RRN     = tt-chk-slip-head.RRN
     1893             :
     1894               find first chk-slip-string where
     1895                          chk-slip-string.db-num    = tt-chk-slip-string.db-num
     1896                      and chk-slip-string.ID        = tt-chk-slip-string.ID
     1897                      and chk-slip-string.CheckID   = tt-chk-slip-string.CheckID
     1898                      and chk-slip-string.RRN       = tt-chk-slip-string.RRN
     1899                      and chk-slip-string.str-num   = tt-chk-slip-string.str-num
     1900               no-lock no-error.
     1901               if not avail chk-slip-string then do:
     1902                 create chk-slip-string .
     1903                 buffer-copy tt-chk-slip-string to chk-slip-string .
     1904               end .
     1905             end .
     1906             mCount = mCount + 1.
     1907           end.
     1908         end.
     1909       end.
     1910       vMsg = "Загружено слипов: " + string(mCount).
     1911       run write-log-and-file in p-log-handle (
     1912             input 1
     1913           , input p-log-file-name
     1914           , input 1
     1915           , input vMsg).
     1916       p-ok = true.
     1917     end.
     1918   end procedure.
     1919   procedure pGetLastTStamp:
     1920      define input  parameter p-obj-code as integer   no-undo.
     1921      define input  parameter p-pos-type as character no-undo.
     1922      define input  parameter p-cash-num as integer   no-undo.
     1923      define output parameter oTStamp    as character no-undo.
     1924      define buffer chk-slip-head for chk-slip-head.
     1925      define variable v-last-date      as date     no-undo .
     1926      define variable v-last-time      as integer  no-undo .
     1927      define variable v-last-shift-num as integer  no-undo .
     1928      define variable v-last-z-count   as integer  no-undo .
     1929      define variable v-last-chk-num   as integer  no-undo .
     1930      run get-last-check-params in this-procedure ( input g#db-num
     1931                                                   ,input p-obj-code
     1932                                                   ,input p-pos-type
     1933                                                   ,input p-cash-num
     1934                                                   ,output v-last-date
     1935                                                   ,output v-last-time
     1936                                                   ,output v-last-shift-num
     1937                                                   ,output v-last-z-count
     1938                                                   ,output v-last-chk-num
     1939                                                   ) no-error.
     1940      if v-last-date <> ? and v-last-time <> ? then
     1941         oTStamp = string( ( v-last-date - date( "01/01/1970" ) ) * 24 * 3600 + v-last-time - Timezone * 60 - 1 * 60 * 60, ">>>>>>>>>9" ).
     1942      else
     1943         oTStamp = "0".
     1944   end procedure.
     1945   procedure SaxWriter:
     1946     define variable hSAXWriter as handle no-undo.
     1947     create sax-writer hSAXWriter.
     1948     hSAXWriter:set-output-destination("longchar", Mreq) no-error.
     1949     hSAXWriter:formatted = true.
     1950     hSAXWriter:encoding = "windows-1251".
     1951     hSAXWriter:start-document() no-error.
     1952     hSAXWriter:start-element("slips") no-error.
     1953       hSAXWriter:insert-attribute("type",   "REQUEST")       no-error.
     1954       hSAXWriter:insert-attribute("id",     m-xml-file-name) no-error.
     1955       hSAXWriter:insert-attribute("from",   m-obj-list)      no-error.
     1956       hSAXWriter:insert-attribute("to",     m-correspondent) no-error.
     1957       hSAXWriter:insert-attribute("tstamp", m-timestamp)     no-error.
     1958     hSAXWriter:end-element("slips") no-error.
     1959     hSAXWriter:end-document() no-error.
     1960     if hSAXWriter:write-status = 7 then do:
     1961       delete object hSAXWriter no-error.
     1962       return error.
     1963     end.
     1964     delete object hSAXWriter no-error.
     1965   end.
     1966   procedure SaxReader:
     1967     define variable hParser as handle no-undo.
     1968     create sax-reader hParser.
     1969     define variable vmemptr as memptr no-undo.
     1970     copy-lob mWebResp to vmemptr.
     1971     hParser:set-input-source("memptr", vmemptr).
     1972     hParser:sax-parse () no-error.
     1973     if error-status:error then do:
     1974         if error-status:num-messages > 0 then
     1975             return error error-status:get-message(1).
     1976         else
     1977              return error return-value.
     1978     end.
     1979     delete object hParser.
     1980   end.
     1981   PROCEDURE StartDocument:
     1982   END PROCEDURE.
     1983   PROCEDURE StartElement:
     1984     DEFINE INPUT PARAMETER namespaceURI AS CHARACTER.
     1985     DEFINE INPUT PARAMETER localName AS CHARACTER.
     1986     DEFINE INPUT PARAMETER qname AS CHARACTER.
     1987     DEFINE INPUT PARAMETER attributes AS HANDLE.
     1988     mElement = qname.
     1989     if mElement = "slip" then do:
     1990       empty temp-table tt-one-chk-slip-head.
     1991       create tt-one-chk-slip-head.
     1992       assign
     1993         tt-one-chk-slip-head.db-num   = g#db-num
     1994         tt-one-chk-slip-head.obj-code = m-obj-code
     1995         tt-one-chk-slip-head.ID = attributes:GET-VALUE-BY-QNAME("code")
     1996         tt-one-chk-slip-head.is-report = 0
     1997       .
     1998     end.
     1999     if mElement = "STextCheq" then do:
     2000       m-textCheq = "" .
     2001     end .
     2002   END PROCEDURE.
     2003   PROCEDURE Characters:
     2004     DEFINE INPUT PARAMETER charData AS MEMPTR.
     2005     DEFINE INPUT PARAMETER numChars AS INTEGER.
     2006     define variable vCurrContent as longchar no-undo.
     2007     define variable vLengthMemptr as int64 no-undo.
     2008     define variable vReadByte as int64 no-undo.
     2009     define variable vRead     as integer no-undo.
     2010     vLengthMemptr = numChars.
     2011     do while vLengthMemptr - vReadByte > 0 :
     2012        vRead = min(vLengthMemptr - vReadByte,30000).
     2013        vCurrContent = vCurrContent + GET-STRING(charData,vReadByte + 1,vRead).
     2014        vReadByte = vReadByte + vRead.
     2015     end.
     2016     if trim(vCurrContent) = "" then return.
     2017     case mElement:
     2018       when "SUuidCheq" then
     2019         tt-one-chk-slip-head.CheckID = vCurrContent .
     2020       when "SRRN" then
     2021         tt-one-chk-slip-head.RRN = vCurrContent .
     2022       when "SDate" then
     2023         tt-one-chk-slip-head.slip-dt = fConvetDateTime(string(vCurrContent)) no-error.
     2024       when "SProc" then
     2025         tt-one-chk-slip-head.proc-type = integer(vCurrContent) no-error.
     2026       when "RSrc" then
     2027         tt-one-chk-slip-head.src_ = integer(vCurrContent) no-error.
     2028       when "RType" then
     2029         tt-one-chk-slip-head.kind = integer(vCurrContent) no-error.
     2030       when "Report" then
     2031         tt-one-chk-slip-head.is-report = integer(vCurrContent) no-error.
     2032       when "KassaNumber" then
     2033         tt-one-chk-slip-head.cash-num = integer(vCurrContent) no-error.
     2034       when "ErrorMessage" then
     2035         ErrorMessage = vCurrContent.
     2036       when "STextCheq"
     2037       then do :
     2038         m-textCheq = vCurrContent .
     2039       end .
     2040     end case.
     2041   END PROCEDURE.
     2042   PROCEDURE EndElement:
     2043     DEFINE INPUT PARAMETER name_ AS CHARACTER.
     2044     DEFINE INPUT PARAMETER localName AS CHARACTER.
     2045     DEFINE INPUT PARAMETER qName AS CHARACTER.
     2046     define variable ii as integer no-undo .
     2047     if qname = "ErrorMessage" then do:
     2048        self:stop-parsing ().
     2049     end.
     2050     else
     2051     if qName = "slip" then do:
     2052       if tt-one-chk-slip-head.ID > ""
     2053       then do :
     2054         find first tt-chk-slip-head where tt-chk-slip-head.db-num    = tt-one-chk-slip-head.db-num
     2055                                       and tt-chk-slip-head.ID        = tt-one-chk-slip-head.ID
     2056                                       and tt-chk-slip-head.CheckID   = tt-one-chk-slip-head.CheckID
     2057                                       and tt-chk-slip-head.RRN       = tt-one-chk-slip-head.RRN
     2058                                       no-error .
     2059         if not available tt-chk-slip-head
     2060         then do :
     2061           create tt-chk-slip-head .
     2062           buffer-copy tt-one-chk-slip-head to tt-chk-slip-head .
     2063         end .
     2064       end .
     2065     end.
     2066     if qName = "STextCheq" then do:
     2067       if tt-one-chk-slip-head.ID > ""
     2068       then do :
     2069         do ii = 1 to num-entries(m-textCheq, chr(10)) :
     2070           create tt-chk-slip-string.
     2071           assign
     2072             tt-chk-slip-string.db-num = tt-one-chk-slip-head.db-num
     2073             tt-chk-slip-string.ID = tt-one-chk-slip-head.ID
     2074             tt-chk-slip-string.CheckID = tt-one-chk-slip-head.CheckID
     2075             tt-chk-slip-string.RRN = tt-one-chk-slip-head.RRN
     2076             tt-chk-slip-string.str-num = ii
     2077             tt-chk-slip-string.str-value = entry(ii, m-textCheq, chr(10))
     2078           .
     2079         end .
     2080       end .
     2081     end .
     2082   END PROCEDURE.
     2083   PROCEDURE EndDocument:
     2084     p-ok = true.
     2085   END PROCEDURE.
     2086   PROCEDURE Warning:
     2087     DEFINE INPUT PARAMETER ErrMessage AS CHARACTER NO-UNDO.
     2088     MESSAGE "The following WARNING was generated:~n" + ErrMessage
     2089          VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2090   END PROCEDURE.
     2091   PROCEDURE Error:
     2092     DEFINE INPUT PARAMETER ErrMessage AS CHARACTER NO-UNDO.
     2093     p-ok = false.
     2094     MESSAGE "The following NONFATAL ERROR was generated:~n" + ErrMessage
     2095          VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2096   END PROCEDURE.
     2097   PROCEDURE FatalError:
     2098     DEFINE INPUT PARAMETER ErrMessage AS CHARACTER NO-UNDO.
     2099     p-ok = false.
     2100     RETURN ERROR "The following FATAL ERROR was generated:~n" + ErrMessage.
     2101   END PROCEDURE.
