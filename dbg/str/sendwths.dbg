        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Передача на кассу масок серийных МЦ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define variable fname                        as character      no-undo .
       83   define variable out                          as character      no-undo .
       84   define variable out2                          as character      no-undo .
       85   DEFINE VARIABLE in_                          as character      no-undo .
       86   DEFINE VARIABLE spl                          as character      no-undo .
       87   DEFINE VARIABLE sav                          as character      no-undo .
       88   DEFINE VARIABLE v-remote                     as character      no-undo .
       89   DEFINE VARIABLE start-paket                  as logical init yes no-undo .
       90   define variable cr as integer no-undo.
       91   define variable Cash-OS2                    as logical        no-undo .
       92   define variable Cash-DOS                     as logical        no-undo .
       93   define variable BadFlag                      as logical        no-undo .
       94   define variable os-er                        as integer        no-undo .
       95   DEFINE VARIABLE OS2-time                     as character      no-undo .
       96   define variable glog as logical no-undo .
       97   define variable log-file-name                as character      no-undo init "send-cd.txt".
       98   define variable v-view-log                   as logical        no-undo .
       99   define variable v-stop                       as logical        no-undo .
      100   define variable v-md5-signature              as character      no-undo .
      101   define variable v-cd-list-update             as character no-undo .
      102   define variable v-cd-list-delete             as character no-undo .
      103   define variable v-param-type as character no-undo .
      104   define variable v-value-character as character no-undo .
      105   define variable v-value-date as date no-undo .
      106   define variable v-value-decimal as decimal no-undo .
      107   define variable v-value-integer as INTEGER no-undo .
      108   define variable v-value-logical AS LOGICAL no-undo .
      109   define variable v-tth as handle no-undo .
      110   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      112   assign
      113   v-tth = buffer thbjattr_thbj-attr:table-handle .
      114   define stream   IBMStream .
      115   define temp-table temp-cd no-undo like ub.cash-desk .
      116   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure alienini-getkey :
      119   define input parameter i-filename as char.
      120   define input parameter i-section as char.
      121   define input parameter i-key as char.
      122   define output parameter o-value as char.
      123   define variable EntryPointer as integer no-undo.
      124   define variable mem1 as memptr no-undo.
      125   define variable mem2 as memptr no-undo.
      126   define variable mem1size as integer no-undo.
      127   define variable mem2size as integer no-undo.
      128   define variable ii       as integer    no-undo.
      129   define variable cbReturnSize  as integer    no-undo.
      130   assign
      131   set-size(mem1)  = 4000
      132   mem1size = 4000.
      133   if i-key = "" then EntryPointer = 0.
      134   else do:
      135     assign
      136     set-size(mem2) = 128
      137     mem2size = 128
      138     EntryPointer = get-pointer-value(mem2)
      139     put-string(mem2, 1) = i-key.
      140   end.
      141   run getprivateprofilestringA
      142                                 (i-section,
      143                                  EntryPointer,
      144                                  "",
      145                                  get-pointer-value(mem1),
      146                                  input mem1size,
      147                                  i-filename,
      148                                  output cbReturnSize).
      149   do ii = 1 to cbReturnSize:
      150     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      151                  then o-value + ","
      152                  else o-value + chr(get-byte(mem1, ii)).
      153   end.
      154     set-size(mem1) = 0.
      155     set-size(mem2) = 0.
      156   end procedure.
      157   procedure alienini-putkey :
      158   define input parameter i-filename as char.
      159   define input parameter i-section as char.
      160   define input parameter i-key as char.
      161   define input parameter i-value as char.
      162   define variable cbReturnSize as integer.
      163   run writeprivateprofilestringA
      164                                  (i-section,
      165                                   i-key,
      166                                   i-value,
      167                                   i-filename,
      168                                   output cbReturnSize ).
      169   end procedure.
      170   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      171     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      172     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      173     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      174     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      175     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      176     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      177     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      178   END PROCEDURE.
      179   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      180     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      181     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      182     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      183     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      184     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      185   END PROCEDURE.
      186   define   temp-table temp-tekka-tsk no-undo
      187   field filename      as character
      188   field obj-num       as integer
      189   field obj-name      as character
      190   field num-records   as integer
      191   field max-records   as integer
      192   field min-plu       as integer
      193   field max-plu       as integer
      194   field num-fields    as integer
      195   field task-num      as character
      196   field by-record     as logical
      197   field send-get      as character
      198   field cash-num      as integer
      199   field cash-num-char as character
      200   field port-num      as character
      201   field way           as character
      202   field is-script     as logical
      203   field pswd          as character
      204   field waiting-sek   as integer
      205   field other-info    as character
      206   field order-num     as integer
      207   field secondary     as integer
      208   field shift-fields  as integer
      209   field binary        as logical
      210   field range         as integer
      211   index pi is unique primary
      212   filename
      213   range
      214   index lpi
      215   filename
      216   min-plu
      217   index gpi
      218   filename
      219   max-plu
      220   index iorder
      221   order-num
      222   .
      223   define   temp-table temp-tekka-schema no-undo
      224   field obj-num as integer
      225   field obj-name as character
      226   field field-num as integer
      227   field field-name as character
      228   field num-records as integer
      229   field size_ as integer
      230   field host as character
      231   field progress-type as character
      232   field custom-type as character
      233   field start-pos as integer
      234   field end-pos as integer
      235   field bin-group as character
      236   index pi is unique primary
      237   host obj-num field-num
      238   .
      239   define temp-table temp-tekka-record no-undo
      240   field obj-num as integer
      241   field plu as integer
      242   field body as character
      243   field shift as integer
      244   index pi is unique primary obj-num plu.
      245   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      246   define variable v-is-closed-shift-journal as integer no-undo .
      247   assign
      248   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      249                               +
      250                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      251                               +
      252                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      253   .
      254   return v-is-closed-shift-journal.
      255   END FUNCTION.
      256   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      257   define variable v-is-first-journal as logical no-undo .
      258   assign
      259   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      260                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      261                     or (p-journal-num =  integer(entry(1, '17':U)))
      262                     or (p-journal-num = integer(entry(1, '16':U)))
      263   .
      264   return v-is-first-journal.
      265   END FUNCTION.
      266   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      267   define variable v-is-petrol-journal as logical no-undo .
      268   assign
      269   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      270   return v-is-petrol-journal.
      271   END FUNCTION.
      272   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      273   define variable v-max-record-num as integer no-undo .
      274   assign
      275   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      276                       then 1489
      277                       else 2340).
      278   return v-max-record-num.
      279   END FUNCTION.
      280   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      281   define variable v-max-record-num as integer no-undo .
      282   assign
      283   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      284                       then 1489 * num-entries('30,31,32,33':U)
      285                       else 2340 * num-entries('17':U)).
      286   return v-max-record-num.
      287   END FUNCTION.
      288   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      289                                           ,input p-rec-no as integer):
      290   define variable v-num-recs as integer no-undo .
      291   if tekka-is-petrol-journal (p-journal-num) then do:
      292     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      293       assign
      294       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      295       .
      296     end.
      297     else do:
      298       assign
      299       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      300       .
      301     end.
      302   end.
      303   else do:
      304     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      305       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      306         assign
      307         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      308         .
      309       end.
      310       else do:
      311         assign
      312         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      313         .
      314       end.
      315     end.
      316     else do:
      317       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      318         assign
      319         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      320         .
      321       end.
      322       else do:
      323         assign
      324         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      325         .
      326       end.
      327     end.
      328   end.
      329   return v-num-recs.
      330   END FUNCTION.
      331   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      332                                              ,input p-is-petrol as logical
      333                                              ,input p-is-current as logical
      334                                              ,output p-rec-no as decimal
      335                                              ):
      336   define variable v-obj-num0 as integer no-undo .
      337   define variable v-obj-num as integer no-undo .
      338   define variable v-obj-num2 as integer no-undo .
      339   define variable p-num-recs2 as integer no-undo .
      340   define variable p-rec-no2 as integer no-undo .
      341   if p-is-petrol then do:
      342     assign
      343     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      344     .
      345     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      346     then
      347     assign
      348     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      349     p-rec-no = p-num-recs modulo 1489
      350     .
      351     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      352     then
      353     assign
      354     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      355     p-rec-no = p-num-recs modulo 1489
      356     .
      357   end.
      358   else do:
      359     assign
      360     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      361     p-num-recs = trunc(p-num-recs, 0)
      362     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      363     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      364     .
      365     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      366     then
      367     assign
      368     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      369     p-rec-no = p-num-recs modulo 2340
      370     .
      371     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      372     then
      373     assign
      374     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      375     p-rec-no = p-num-recs modulo 2340
      376     .
      377     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      378     then
      379     assign
      380     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      381     p-rec-no2 = p-num-recs2 modulo 2978
      382     .
      383     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      384     then
      385     assign
      386     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      387     p-rec-no2 = p-num-recs2 modulo 2978
      388     .
      389     assign
      390     p-rec-no = p-rec-no + p-rec-no2 / 10000
      391     .
      392   end.
      393   if v-obj-num = 0 then v-obj-num = 100.
      394   return v-obj-num.
      395   END FUNCTION.
      396   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      397   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      398   if lookup (string(p-obj-num), '17':U) > 0 then do:
      399      if p-is-ptrl then
      400      return integer(entry(1, '26,27,28,29':U)).
      401      if not p-is-ptrl then
      402      return integer(entry(1, '16':U)).
      403   end.
      404   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      405   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      406   return 0.
      407   END FUNCTION.
      408   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      409   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      410   if lookup (string(p-obj-num), '17':U) > 0 then do:
      411     if p-is-ptrl then
      412     return integer(entry(1, '26,27,28,29':U)).
      413     if not p-is-ptrl then
      414     return integer(entry(1, '16':U)).
      415   end.
      416   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      417   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      418   return 0.
      419   END FUNCTION.
      420   PROCEDURE maria-put:
      421   define parameter buffer buf_cash-desk for ub.cash-desk.
      422   define input parameter p-out    as character no-undo .
      423   define input parameter p-fname as character no-undo .
      424   define input parameter p-by-record as logical no-undo .
      425   define input parameter p-shift-fields as integer no-undo .
      426   define input parameter p-binary as logical no-undo .
      427   define input parameter p-obj-num as integer no-undo .
      428   define input parameter p-max-records as integer no-undo .
      429   define input parameter p-plu as integer no-undo .
      430   define input parameter p-value as character no-undo .
      431   define variable v-file-name as character no-undo .
      432   define variable v-create as logical no-undo .
      433   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      434   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      435   output stream IBMSTREAM
      436   to value(v-file-name) append .
      437   Put  stream IBMSTREAM unformatted
      438   p-plu
      439   chr(3)
      440   p-value
      441   skip.
      442   output stream IBMSTREAM
      443   close.
      444   if not p-by-record then do:
      445     find first buf_temp-tekka-tsk where
      446               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      447     if not available buf_temp-tekka-tsk then do:
      448       v-create = yes.
      449     end.
      450   end.
      451   else do:
      452     find first buf_temp-tekka-tsk where
      453               buf_temp-tekka-tsk.filename  = v-file-name
      454           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      455     if not available buf_temp-tekka-tsk
      456     then do:
      457       find first buf_temp-tekka-tsk where
      458                 buf_temp-tekka-tsk.filename  = v-file-name
      459             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      460       if not available buf_temp-tekka-tsk
      461       then do:
      462         v-create = yes.
      463       end.
      464     end.
      465   end.
      466   if v-create then do:
      467     create buf_temp-tekka-tsk.
      468     assign
      469     buf_temp-tekka-tsk.filename = v-file-name
      470     buf_temp-tekka-tsk.range    = p-plu
      471     buf_temp-tekka-tsk.obj-num = p-obj-num
      472     buf_temp-tekka-tsk.obj-name = '':U
      473     buf_temp-tekka-tsk.num-records = 0
      474     buf_temp-tekka-tsk.max-records = p-max-records
      475     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      476     buf_temp-tekka-tsk.task-num = p-fname
      477     buf_temp-tekka-tsk.by-record = p-by-record
      478     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      479     buf_temp-tekka-tsk.binary = p-binary
      480     buf_temp-tekka-tsk.send-get = 'send'
      481     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      482     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      483     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      484     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      485                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      486                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      487                                 then 'local'
      488                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      489     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      490     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      491     buf_temp-tekka-tsk.waiting-sek = 30
      492     buf_temp-tekka-tsk.min-plu     = p-plu
      493     buf_temp-tekka-tsk.max-plu     = p-plu
      494     .
      495   end.
      496   assign
      497   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      498   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      499   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      500   .
      501   END PROCEDURE.
      502   PROCEDURE maria-get:
      503   define parameter buffer buf_cash-desk for ub.cash-desk.
      504   define input parameter p-out    as character no-undo .
      505   define input parameter p-fname as character no-undo .
      506   define input parameter p-by-record as logical no-undo .
      507   define input parameter p-obj-num as integer no-undo .
      508   define input parameter p-num-fields as integer no-undo .
      509   define input parameter p-max-records as integer no-undo .
      510   define input parameter p-min-plu as integer no-undo .
      511   define input parameter p-max-plu as integer no-undo .
      512   define input parameter p-other as character no-undo .
      513   define input parameter p-order-num as integer no-undo .
      514   define variable v-file-name as character no-undo .
      515   define variable v-secondary-obj-num as character no-undo .
      516   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      517   if p-by-record then do:
      518     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      519   end.
      520   else do:
      521     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      522   end.
      523   find first buf_temp-tekka-tsk where
      524             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      525   if not available buf_temp-tekka-tsk then do:
      526     create buf_temp-tekka-tsk.
      527     assign
      528     buf_temp-tekka-tsk.filename = v-file-name
      529     buf_temp-tekka-tsk.obj-num = p-obj-num
      530     buf_temp-tekka-tsk.obj-name = '':U
      531     buf_temp-tekka-tsk.max-records = p-max-records
      532     buf_temp-tekka-tsk.num-fields = p-num-fields
      533     buf_temp-tekka-tsk.task-num = p-fname
      534     buf_temp-tekka-tsk.by-record = p-by-record
      535     buf_temp-tekka-tsk.send-get = 'get'
      536     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      537     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      538     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      539     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      540                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      541                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      542                                   then 'local'
      543                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      544     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      545     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      546     buf_temp-tekka-tsk.waiting-sek = 30
      547     buf_temp-tekka-tsk.min-plu     = p-min-plu
      548     buf_temp-tekka-tsk.max-plu     = p-max-plu
      549     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      550                                       and p-max-plu <> ?
      551                                       then p-max-plu - p-min-plu + 1
      552                                       else 0)
      553     buf_temp-tekka-tsk.other-info = p-other
      554     buf_temp-tekka-tsk.order-num = p-order-num
      555     .
      556     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      557       assign
      558       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      559       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      560       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      561       no-error
      562       .
      563       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      564     end.
      565   end.
      566   END PROCEDURE.
      567   PROCEDURE maria-task:
      568   define parameter buffer buf_cash-desk for ub.cash-desk.
      569   define input parameter p-fname as character no-undo .
      570   define input parameter p-obj-num-list as character no-undo .
      571   define input parameter p-parameters as character no-undo .
      572   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      573   find first buf_temp-tekka-tsk where
      574             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      575   if not available buf_temp-tekka-tsk then do:
      576     create buf_temp-tekka-tsk.
      577     assign
      578     buf_temp-tekka-tsk.filename = ''
      579     buf_temp-tekka-tsk.range = 1
      580     buf_temp-tekka-tsk.obj-num = 0
      581     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      582     buf_temp-tekka-tsk.task-num = p-fname
      583     buf_temp-tekka-tsk.by-record = no
      584     buf_temp-tekka-tsk.send-get = 'task'
      585     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      586     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      587     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      588     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      589                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      590                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      591                                   then 'local'
      592                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      593     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      594     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      595     buf_temp-tekka-tsk.waiting-sek = 30
      596     buf_temp-tekka-tsk.other-info = p-parameters
      597     buf_temp-tekka-tsk.order-num = 0
      598     .
      599   end.
      600   END PROCEDURE.
      601   procedure tekkatsk-verify-schema :
      602   define input parameter p-obj-list as character no-undo .
      603   define input parameter p-dir-path as character no-undo .
      604   define variable v-obj-num as integer no-undo .
      605   define variable v-obj-name as character no-undo .
      606   define variable v-num-records as integer no-undo .
      607   define variable v-size_ as integer no-undo .
      608   define variable v-value as character no-undo .
      609   define variable ii as integer no-undo .
      610   define variable jj as integer no-undo .
      611   define variable ii-ibs as integer no-undo .
      612   define variable ii-tekka as integer no-undo .
      613   define variable v-result as character no-undo .
      614   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      615   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      616     do
      617     on error undo, return error
      618     :
      619        for each buf_temp-tekka-schema:
      620          delete buf_temp-tekka-schema.
      621        end.
      622        input from value('tekkasch.d').
      623        repeat :
      624          create buf_temp-tekka-schema.
      625          import buf_temp-tekka-schema.
      626          assign
      627          buf_temp-tekka-schema.host = 'IBS'
      628          ii = ii + 1.
      629          .
      630        end.
      631        input close.
      632        ii-ibs = ii.
      633         _ii:
      634         do ii = 1 to 256:
      635           if p-obj-list = "ALL"
      636           or lookup(string(ii), p-obj-list) > 0 then do:
      637             assign
      638             v-obj-num = 0
      639             v-obj-name = ''
      640             v-num-records = 0
      641             v-size_ = 0
      642             .
      643             run alienini-getkey in this-procedure (
      644                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      645                                                     ,input ('obj' + string(ii, '999'))
      646                                                     ,input 'oname'
      647                                                     ,output v-value) no-error .
      648             if v-value = ? then next _ii.
      649             assign
      650             v-obj-num = ii
      651             v-obj-name = v-value
      652             .
      653             run alienini-getkey in this-procedure (
      654                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      655                                                     ,input ('obj' + string(ii, '999'))
      656                                                     ,input 'size'
      657                                                     ,output v-value) no-error .
      658             assign
      659             v-num-records = integer(v-value) no-error  .
      660             if error-status:error
      661             or v-num-records = 0 then next _ii.
      662             run alienini-getkey in this-procedure (
      663                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      664                                                     ,input 'obj' + string(ii, '999')
      665                                                     ,input 'f000'
      666                                                     ,output v-value) no-error .
      667             assign
      668             v-size_ = integer(v-value) no-error  .
      669             if error-status:error
      670             or v-size_ = 0 then next _ii.
      671             _jj:
      672             do jj = 1 to 256:
      673               run alienini-getkey in this-procedure (
      674                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      675                                                       ,input 'obj' + string(ii, '999')
      676                                                       ,input 'f' + string(jj, '999')
      677                                                       ,output v-value) no-error .
      678               if v-value = ? then next _ii.
      679               create buf_temp-tekka-schema.
      680               assign
      681               buf_temp-tekka-schema.host = 'tekka'
      682               buf_temp-tekka-schema.obj-num = v-obj-num
      683               buf_temp-tekka-schema.obj-name = v-obj-name
      684               buf_temp-tekka-schema.num-records = v-num-records
      685               buf_temp-tekka-schema.size_ = v-size_
      686               buf_temp-tekka-schema.field-num = jj
      687               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      688               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      689                                                  then entry(2, entry(2, v-value, '#'), ':')
      690                                                  else '':U)
      691               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      692               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      693               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      694                                                           , 'C,I,I,I,D,D,D,D,D':U)
      695               no-error
      696               .
      697               if error-status:error then do:
      698                 delete buf_temp-tekka-schema.
      699                 next _jj.
      700               end.
      701               run alienini-getkey in this-procedure (
      702                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      703                                                       ,input 'obj' + string(ii, '999') + 'name'
      704                                                       ,input 'n' + string(jj, '999')
      705                                                       ,output v-value) no-error .
      706               if v-value <> ? then
      707               buf_temp-tekka-schema.field-name = v-value.
      708             end.
      709           end.
      710         end.
      711         ii-tekka = ii - 1.
      712        if p-obj-list <> 'ALL' then do:
      713         if ii-tekka <> ii-ibs then do:
      714           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      715                                   , ii-ibs
      716                                   , ii-tekka).
      717         end.
      718        end.
      719        for each buf_temp-tekka-schema where
      720               buf_temp-tekka-schema.host = 'tekka':
      721          find first buf2_temp-tekka-schema where
      722                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      723                AND buf2_temp-tekka-schema.host = 'ibs'
      724                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      725          if not available buf2_temp-tekka-schema then do:
      726           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      727                                   , buf_temp-tekka-schema.field-num
      728                                   , buf_temp-tekka-schema.obj-num).
      729          end.
      730          buffer-compare buf_temp-tekka-schema
      731          to buf2_temp-tekka-schema
      732          save result in v-result.
      733          if v-result <> '':U then do:
      734           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      735                                   , buf_temp-tekka-schema.field-num
      736                                   , buf_temp-tekka-schema.obj-num).
      737          end.
      738        end.
      739     end.
      740   end procedure.
      741   FUNCTION set-Sx returns character (input p-string as character):
      742   return p-string.
      743   END FUNCTION.
      744   FUNCTION get-Sx returns character (input p-string  as character):
      745   return p-string.
      746   END FUNCTION.
      747   FUNCTION set-B returns character (input p-string  as character):
      748   return chr(integer(p-string)).
      749   END FUNCTION.
      750   FUNCTION get-B returns character (input p-string  as character):
      751   return string(asc(p-string)).
      752   END FUNCTION.
      753   FUNCTION set-BF returns character (input p-string  as character):
      754   define variable v-dopi as integer no-undo .
      755   define variable ii as integer no-undo .
      756   do ii = 1 to 8:
      757     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      758   end.
      759   return chr(v-dopi).
      760   END FUNCTION.
      761   FUNCTION get-BF returns character (input p-string  as character):
      762   define variable v-dopi as integer no-undo .
      763   define variable v-dops as character no-undo .
      764   define variable ii as integer no-undo .
      765   v-dopi = asc(p-string).
      766   do ii = 8 to 1 BY -1:
      767     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      768   end.
      769   return v-dops.
      770   END FUNCTION.
      771   FUNCTION set-BN returns character (input p-string  as character
      772                                     ,input p-bin-group as character):
      773   define variable v-dopi as integer no-undo .
      774   define variable ii as integer no-undo .
      775   define variable jj as integer no-undo .
      776   define variable v-grp-nums as integer no-undo .
      777   define variable v-dopi2 as integer no-undo .
      778   v-grp-nums = num-entries(p-bin-group).
      779   do jj = 0 to v-grp-nums - 1:
      780     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      781     do ii = 1 to 8:
      782       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      783     end.
      784   end.
      785   return chr(v-dopi).
      786   END FUNCTION.
      787   FUNCTION get-BN returns character (input p-string  as character
      788                                     ,input p-bin-group as character):
      789   define variable v-dopi as integer no-undo .
      790   define variable v-dops as character no-undo .
      791   define variable v-grp-nums as integer no-undo .
      792   define variable ii as integer no-undo .
      793   define variable jj as integer no-undo .
      794   v-dopi = asc(p-string).
      795   v-grp-nums = num-entries(p-bin-group).
      796   do jj = 1 to v-grp-nums:
      797   do ii = 8 to 1 BY -1:
      798     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      799   end.
      800   end.
      801   return v-dops.
      802   END FUNCTION.
      803   procedure fill-temp-cd :
      804   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
      805   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      806   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      807   define input parameter p-clear-table as logical no-undo .
      808   define buffer buf_temp-cd for temp-cd.
      809   define buffer buf_cash-desk for ub.cash-desk.
      810     do
      811     on error undo, return error
      812     :
      813        if p-clear-table  then do:
      814          for each buf_temp-cd:
      815            delete buf_temp-cd.
      816          end.
      817        end.
      818        for each buf_cash-desk no-lock where
      819               buf_cash-desk.db-num = p-db-num
      820           AND buf_cash-desk.obj-code = p-obj-code
      821           and buf_cash-desk.cash-on  = yes
      822        BREAK by buf_cash-desk.pos-type:
      823          if first-of(buf_cash-desk.pos-type) then do:
      824            create buf_temp-cd.
      825            buffer-copy buf_cash-desk to buf_temp-cd.
      826          end.
      827        end.
      828     end.
      829   end procedure.
      830   define variable vss-include-info4 as character format "X(65)" no-undo
      831   initial "@(#)$Workfile$ $Revision$".
      832   define variable v-bgelib-bgefmt        as character         no-undo.
      833   define variable v-bgelib-bgeflold      as character         no-undo.
      834   define stream stmXMLOut.
      835   define stream stmXMLLog.
      836   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   procedure cur-time :
      838      define output parameter p-today as date      no-undo .
      839      define output parameter p-time  as integer   no-undo .
      840     do
      841     on error undo, return error
      842     :
      843       define variable v-date1 as date      no-undo .
      844       define variable v-date2 as date      no-undo .
      845       define variable v-time  as integer   no-undo .
      846       assign
      847         v-date1 = today
      848         v-time  = time
      849         v-date2 = today
      850       .
      851       if v-date1 <> v-date2
      852       then do:
      853         assign
      854           v-date1 = today
      855           v-time  = v-time
      856         .
      857       end.
      858       assign
      859         p-today = v-date1
      860         p-time  = v-time
      861       .
      862     end.
      863   end.
      864   function cur-time-date returns character
      865   :
      866     return string(today, '99/99/9999':U) .
      867   end.
      868   function cur-time-mjd returns decimal
      869   :
      870     define variable v-date as date      no-undo .
      871     define variable v-time as integer   no-undo .
      872     run cur-time in this-procedure
      873       (output v-date
      874       ,output v-time
      875       ) .
      876     return integer(v-date) - 2400002 + (v-time / 86400) .
      877   end.
      878   function cur-time-get-ending-index returns integer
      879   (input p-number as integer
      880   )
      881   :
      882     if p-number < 0
      883     or p-number = ?
      884     then do:
      885       return 1 .
      886     end.
      887     define variable v-rest as integer   no-undo .
      888     assign
      889       p-number = p-number modulo 100
      890     .
      891     if p-number < 20
      892     then do:
      893       assign
      894         v-rest = p-number
      895       .
      896     end.
      897     else do:
      898       assign
      899         v-rest = p-number modulo 10
      900       .
      901     end.
      902     case v-rest :
      903       when 1
      904       then do:
      905         return 2 .
      906       end.
      907       when 2 or
      908       when 3 or
      909       when 4
      910       then do:
      911         return 3 .
      912       end.
      913       otherwise do:
      914         return 1 .
      915       end.
      916     end case .
      917   end.
      918   procedure cur-time-mjd-to-date :
      919      define input  parameter i-mjd-diff as decimal no-undo.
      920      define output parameter o-Date     as date    no-undo.
      921      define output parameter o-Time     as integer no-undo.
      922      define variable v-day-number as integer   no-undo .
      923      if    i-mjd-diff < 0
      924         or i-mjd-diff = ?
      925      then do:
      926         return "?" .
      927      end.
      928      assign
      929         v-day-number = truncate(i-mjd-diff,0).
      930         o-Date = date(v-day-number + 2400002).
      931         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      932     .
      933   end.
      934   function cur-time-mjd-to-string returns character
      935   (input p-mjd-diff as decimal
      936   )
      937   :
      938     define variable v-day-number as integer   no-undo .
      939     define variable v-seconds    as integer   no-undo .
      940     define variable v-hour       as integer   no-undo .
      941     define variable v-min        as integer   no-undo .
      942     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      943     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      944     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      945     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      946     if p-mjd-diff < 0
      947     or p-mjd-diff = ?
      948     then do:
      949       return "?" .
      950     end.
      951     assign
      952       v-day-number = integer(truncate(p-mjd-diff,0))
      953       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      954     .
      955     if v-seconds > 86400
      956     then do:
      957       assign
      958         v-seconds = 86400 - 1
      959       .
      960     end.
      961     if v-seconds < 0
      962     then do:
      963       assign
      964         v-seconds = 0
      965       .
      966     end.
      967     assign
      968       v-hour = truncate(v-seconds / 3600, 0)
      969     .
      970     assign
      971       v-seconds = v-seconds modulo 3600
      972     .
      973     assign
      974       v-min = truncate(v-seconds / 60, 0)
      975     .
      976     assign
      977       v-seconds = v-seconds modulo 60
      978     .
      979     return
      980         (if v-day-number <> 0
      981           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      982           else ""
      983         )
      984       + (if v-day-number <> 0 or v-hour <> 0
      985           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      986           else ""
      987         )
      988       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      989           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      990           else ""
      991         )
      992       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      993       .
      994   end.
      995   function cur-time-string returns character
      996   :
      997     define variable v-date as date      no-undo .
      998     define variable v-time as integer   no-undo .
      999     run cur-time in this-procedure
     1000       (output v-date
     1001       ,output v-time
     1002       ) .
     1003     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1004   end.
     1005   function cur-time-string-sec returns character
     1006   :
     1007     define variable v-date as date      no-undo .
     1008     define variable v-time as integer   no-undo .
     1009     run cur-time in this-procedure
     1010       (output v-date
     1011       ,output v-time
     1012       ) .
     1013     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1014   end.
     1015   function cur-time-custom  returns character
     1016   (input p-prefix as character
     1017   ,input p-date-format as character
     1018   ,input p-delimiter as character
     1019   ,input p-time-format as character
     1020   ,input p-suffix as character
     1021   )
     1022   :
     1023     define variable v-date as date      no-undo .
     1024     define variable v-time as integer   no-undo .
     1025     run cur-time in this-procedure
     1026       (output v-date
     1027       ,output v-time
     1028       ) .
     1029     return
     1030       p-prefix
     1031       + string(v-date, p-date-format)
     1032       + p-delimiter
     1033       + string(v-time, p-time-format)
     1034       + p-suffix
     1035       .
     1036   end.
     1037   function cur-time-print  returns character
     1038   :
     1039     define variable v-date as date      no-undo .
     1040     define variable v-time as integer   no-undo .
     1041     run cur-time in this-procedure
     1042       (output v-date
     1043       ,output v-time
     1044       ) .
     1045     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1046   end.
     1047   function cur-time-datetime returns datetime
     1048   :
     1049     define variable v-char as character no-undo .
     1050     define variable v-datetime as datetime no-undo .
     1051     v-char = cur-time-string().
     1052     v-datetime = datetime(v-char).
     1053     return  v-datetime.
     1054   end.
     1055   function cur-time-string-msec returns character
     1056   :
     1057     define variable v-date as datetime  no-undo .
     1058     v-date = now.
     1059     return string(v-date) .
     1060   end.
     1061   define variable vss-include-info6 as character format "X(65)" no-undo
     1062   initial "@(#)$Workfile$ $Revision$".
     1063   procedure xmlchar-test :
     1064   define input parameter p-in-string          as character        no-undo.
     1065   define output parameter p-out-string-enc    as character        no-undo.
     1066   define output parameter p-out-string-dec    as character        no-undo.
     1067   do
     1068   on error undo, return error
     1069   :
     1070          run xmlchar-encode in this-procedure
     1071       (
     1072             input p-in-string
     1073           , output p-out-string-enc
     1074       ).
     1075          run xmlchar-decode in this-procedure
     1076       (
     1077             input p-out-string-enc
     1078           , output p-out-string-dec
     1079       ).
     1080   end.
     1081   end .
     1082   procedure xmlchar-encode :
     1083   define input parameter p-in-string      as character        no-undo.
     1084   define output parameter p-out-string    as character        no-undo.
     1085       define variable v-position      as integer      no-undo.
     1086       define variable v-current-char  as character    no-undo.
     1087   do
     1088   on error undo, return error
     1089   :
     1090       assign
     1091           p-out-string = "":U
     1092       .
     1093       case p-in-string
     1094       :
     1095           when ?
     1096           then do:
     1097               assign
     1098                   p-out-string = "?":U
     1099               .
     1100           end.
     1101           when "?":U
     1102           then do:
     1103               assign
     1104                   p-out-string = "&#63;":U
     1105               .
     1106           end.
     1107           otherwise do:
     1108               do v-position = 1 to length( p-in-string )
     1109               :
     1110                   assign
     1111                       v-current-char = substring( p-in-string, v-position, 1 )
     1112                   .
     1113                   case v-current-char
     1114                   :
     1115                       when "&":U
     1116                       then do:
     1117                           assign
     1118                               p-out-string = p-out-string + "&amp;":U
     1119                           .
     1120                       end.
     1121                       when ">":U
     1122                       then do:
     1123                           assign
     1124                               p-out-string = p-out-string + "&gt;":U
     1125                           .
     1126                       end.
     1127                       when "<":U
     1128                       then do:
     1129                           assign
     1130                               p-out-string = p-out-string + "&lt;":U
     1131                           .
     1132                       end.
     1133                       when "'":U
     1134                       then do:
     1135                           assign
     1136                               p-out-string = p-out-string + "&apos;":U
     1137                           .
     1138                       end.
     1139                       when '"':U
     1140                       then do:
     1141                           assign
     1142                               p-out-string = p-out-string + "&quot;":U
     1143                           .
     1144                       end.
     1145                       when chr(1)
     1146                       then do:
     1147                           assign
     1148                               p-out-string = p-out-string + "":U
     1149                           .
     1150                       end.
     1151                       when chr(2)
     1152                       then do:
     1153                           assign
     1154                               p-out-string = p-out-string + "":U
     1155                           .
     1156                       end.
     1157                       when chr(3)
     1158                       then do:
     1159                           assign
     1160                               p-out-string = p-out-string + "":U
     1161                           .
     1162                       end.
     1163                       when chr(4)
     1164                       then do:
     1165                           assign
     1166                               p-out-string = p-out-string + "":U
     1167                           .
     1168                       end.
     1169                       when chr(5)
     1170                       then do:
     1171                           assign
     1172                               p-out-string = p-out-string + "":U
     1173                           .
     1174                       end.
     1175                       when chr(6)
     1176                       then do:
     1177                           assign
     1178                               p-out-string = p-out-string + "":U
     1179                           .
     1180                       end.
     1181                       when chr(7)
     1182                       then do:
     1183                           assign
     1184                               p-out-string = p-out-string + "":U
     1185                           .
     1186                       end.
     1187                       when chr(8)
     1188                       then do:
     1189                           assign
     1190                               p-out-string = p-out-string + "":U
     1191                           .
     1192                       end.
     1193                       when chr(9)
     1194                       then do:
     1195                           assign
     1196                               p-out-string = p-out-string + "":U
     1197                           .
     1198                       end.
     1199                       when chr(29)
     1200                       then do:
     1201                           assign
     1202                               p-out-string = p-out-string + "":U
     1203                           .
     1204                       end.
     1205                       when chr(10)
     1206                       then do:
     1207                           assign
     1208                               p-out-string = p-out-string + "&#10;":U
     1209                           .
     1210                       end.
     1211                       when chr(13)
     1212                       then do:
     1213                           assign
     1214                               p-out-string = p-out-string + "&#13;":U
     1215                           .
     1216                       end.
     1217                       otherwise do:
     1218                           assign
     1219                               p-out-string = p-out-string + v-current-char
     1220                           .
     1221                       end.
     1222                   end case.
     1223               end.
     1224           end.
     1225       end case.
     1226   end.
     1227   end .
     1228   procedure xmlchar-encode-1c :
     1229   define input parameter p-in-string      as character        no-undo.
     1230   define output parameter p-out-string    as character        no-undo.
     1231       define variable v-position      as integer      no-undo.
     1232       define variable v-current-char  as character    no-undo.
     1233   do
     1234   on error undo, return error
     1235   :
     1236       assign
     1237           p-out-string = "":U
     1238       .
     1239       case p-in-string
     1240       :
     1241           when ?
     1242           then do:
     1243               assign
     1244                   p-out-string = "?":U
     1245               .
     1246           end.
     1247           otherwise do:
     1248               do v-position = 1 to length( p-in-string )
     1249               :
     1250                   assign
     1251                       v-current-char = substring( p-in-string, v-position, 1 )
     1252                   .
     1253                   case v-current-char
     1254                   :
     1255                       when chr(1)
     1256                       then do:
     1257                           assign
     1258                               p-out-string = p-out-string + " ":U
     1259                           .
     1260                       end.
     1261                       when chr(2)
     1262                       then do:
     1263                           assign
     1264                               p-out-string = p-out-string + " ":U
     1265                           .
     1266                       end.
     1267                       when chr(3)
     1268                       then do:
     1269                           assign
     1270                               p-out-string = p-out-string + " ":U
     1271                           .
     1272                       end.
     1273                       when chr(4)
     1274                       then do:
     1275                           assign
     1276                               p-out-string = p-out-string + " ":U
     1277                           .
     1278                       end.
     1279                       when chr(5)
     1280                       then do:
     1281                           assign
     1282                               p-out-string = p-out-string + " ":U
     1283                           .
     1284                       end.
     1285                       when chr(6)
     1286                       then do:
     1287                           assign
     1288                               p-out-string = p-out-string + " ":U
     1289                           .
     1290                       end.
     1291                       when chr(7)
     1292                       then do:
     1293                           assign
     1294                               p-out-string = p-out-string + " ":U
     1295                           .
     1296                       end.
     1297                       when chr(8)
     1298                       then do:
     1299                           assign
     1300                               p-out-string = p-out-string + " ":U
     1301                           .
     1302                       end.
     1303                       when chr(9)
     1304                       then do:
     1305                           assign
     1306                               p-out-string = p-out-string + " ":U
     1307                           .
     1308                       end.
     1309                       when chr(29)
     1310                       then do:
     1311                           assign
     1312                               p-out-string = p-out-string + " ":U
     1313                           .
     1314                       end.
     1315                       when chr(10)
     1316                       then do:
     1317                           assign
     1318                               p-out-string = p-out-string + " ":U
     1319                           .
     1320                       end.
     1321                       when chr(13)
     1322                       then do:
     1323                           assign
     1324                               p-out-string = p-out-string + " ":U
     1325                           .
     1326                       end.
     1327                       otherwise do:
     1328                           assign
     1329                               p-out-string = p-out-string + v-current-char
     1330                           .
     1331                       end.
     1332                   end case.
     1333               end.
     1334           end.
     1335       end case.
     1336   end.
     1337   end .
     1338   procedure xmlchar-decode :
     1339   define input parameter p-in-string      as character        no-undo.
     1340   define output parameter p-out-string    as character        no-undo.
     1341       define variable v-position      as integer      no-undo.
     1342       define variable v-last-position as integer      no-undo.
     1343       define variable v-temp-integer  as integer      no-undo.
     1344       define variable v-current-char  as character    no-undo.
     1345       define variable v-next-char     as character    no-undo.
     1346       define variable v-success       as logical      no-undo.
     1347   do
     1348   on error undo, return error
     1349   :
     1350       assign
     1351           p-out-string = "":U
     1352           v-position   = 0
     1353       .
     1354       replace-cycle:
     1355       do while yes
     1356       on error undo, return error
     1357       :
     1358           assign
     1359               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1360           .
     1361           if v-last-position <= v-position
     1362           then do:
     1363               if v-position = 0
     1364               then do:
     1365                   assign
     1366                       p-out-string = p-in-string
     1367                   .
     1368               end.
     1369               else do:
     1370                   assign
     1371                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1372                   .
     1373               end.
     1374               leave replace-cycle.
     1375           end.
     1376           else do:
     1377               assign
     1378                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1379                   v-position      = v-last-position
     1380                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1381               .
     1382               if v-current-char = "#":U
     1383               then do:
     1384                   assign
     1385                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1386                   .
     1387                   if v-last-position > 0
     1388                   then do:
     1389                       run xmlchar-read-integer in this-procedure
     1390                        (
     1391                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1392                           , output v-temp-integer
     1393                           , output v-success
     1394                       ).
     1395                       if v-success = yes
     1396                       and v-temp-integer >= 1
     1397                       and v-temp-integer <= 255
     1398                       then do:
     1399                           assign
     1400                               p-out-string = p-out-string + chr( v-temp-integer )
     1401                               v-position   = v-last-position + 1
     1402                           .
     1403                       end.
     1404                       else do:
     1405                           assign
     1406                               p-out-string = p-out-string + "&":U
     1407                               v-position   = v-position   + 1
     1408                           .
     1409                       end.
     1410                   end.
     1411                   else do:
     1412                       assign
     1413                           p-out-string = p-out-string + "&":U
     1414                           v-position   = v-position   + 1
     1415                       .
     1416                   end.
     1417               end.
     1418               else do:
     1419                   case substring( p-in-string, v-position + 1, 3 )
     1420                   :
     1421                       when "lt;":U
     1422                       then do:
     1423                           assign
     1424                               p-out-string = p-out-string + "<":U
     1425                               v-position   = v-position   + 3
     1426                           .
     1427                       end.
     1428                       when "gt;":U
     1429                       then do:
     1430                           assign
     1431                               p-out-string = p-out-string + ">":U
     1432                               v-position   = v-position   + 3
     1433                           .
     1434                       end.
     1435                       otherwise do:
     1436                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1437                           then do:
     1438                               assign
     1439                                   p-out-string = p-out-string + "&":U
     1440                                   v-position   = v-position   + 4
     1441                               .
     1442                           end.
     1443                           else do:
     1444                               case substring( p-in-string, v-position + 1, 5 )
     1445                               :
     1446                                   when "quot;":U
     1447                                   then do:
     1448                                       assign
     1449                                           p-out-string = p-out-string + '"':U
     1450                                           v-position   = v-position   + 5
     1451                                       .
     1452                                   end.
     1453                                   when "apos;":U
     1454                                   then do:
     1455                                       assign
     1456                                           p-out-string = p-out-string + "'":U
     1457                                           v-position   = v-position   + 5
     1458                                       .
     1459                                   end.
     1460                                   otherwise do:
     1461                                       assign
     1462                                           p-out-string = p-out-string + "&":U
     1463                                       .
     1464                                   end.
     1465                               end case.
     1466                           end.
     1467                       end.
     1468                   end case.
     1469               end.
     1470           end.
     1471       end.
     1472   end.
     1473   end .
     1474   procedure xmlchar-read-integer :
     1475   define input parameter p-input-string      as character        no-undo.
     1476   define output parameter p-output-integer   as integer          no-undo.
     1477   define output parameter p-success       as logical          no-undo.
     1478   do
     1479   on error undo, return error
     1480   :
     1481       assign
     1482           p-output-integer = integer( p-input-string )
     1483       no-error.
     1484       if error-status :error
     1485       then do:
     1486           assign
     1487               p-success           = no
     1488               p-output-integer    = 0
     1489           .
     1490       end.
     1491       else do:
     1492           assign
     1493               p-success           = yes
     1494           .
     1495       end.
     1496   end.
     1497   end.
     1498   define variable v-bgelib-bgeclall           as logical      no-undo.
     1499   define variable v-bgelib-bgedict            as logical      no-undo.
     1500   define temp-table temp_ext-doc-type no-undo
     1501       field edt-key               as integer
     1502       field ext-doc-type          as character
     1503       field ext-doc-type-label    as character
     1504       index pi is primary unique
     1505           edt-key
     1506   .
     1507   define temp-table temp_bgelib_goods no-undo
     1508       field gds-code as integer
     1509       index pi is primary unique
     1510           gds-code
     1511   .
     1512   define temp-table temp_bgelib_clients no-undo
     1513       field obj-type as character
     1514       field obj-code as integer
     1515       index pi is primary unique
     1516           obj-type
     1517           obj-code
     1518   .
     1519   define temp-table temp_bgelib_dis-card no-undo
     1520       field d-card as character
     1521       index pi is primary unique
     1522           d-card
     1523   .
     1524   define temp-table temp_bgelib_trn-doc no-undo
     1525       field doc-code as integer
     1526   .
     1527   procedure bgelib-tag-open:
     1528   do
     1529   on error undo, return error
     1530   :
     1531   define input parameter v-tag-level  as integer      no-undo.
     1532   define input parameter v-tag-name   as character    no-undo.
     1533   define input parameter v-tag-value  as character    no-undo.
     1534       put stream stmXMLOut unformatted
     1535           chr(10)
     1536           + fill(" ", 4 * v-tag-level)
     1537           + "<" + v-tag-name
     1538           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1539           + v-tag-value + ">"
     1540       .
     1541   end.
     1542   end procedure.
     1543   procedure bgelib-tag-put:
     1544   do
     1545   on error undo, return error
     1546   :
     1547   define input parameter v-tag-level      as integer      no-undo.
     1548   define input parameter v-tag-name       as character    no-undo.
     1549   define input parameter v-tag-value      as character    no-undo.
     1550   define input parameter v-empty-mode     as integer      no-undo.
     1551       v-tag-name = trim(v-tag-name).
     1552       if  v-empty-mode = 1
     1553       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1554       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1555       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1556       then do:
     1557           run xmlchar-encode in this-procedure (
     1558                 input v-tag-value
     1559               , output v-tag-value
     1560           ).
     1561           put stream stmXMLOut unformatted
     1562               chr(10) + fill(" ", 4 * v-tag-level)
     1563                           + '<' + v-tag-name + '>'
     1564                           + v-tag-value
     1565                           + '</' + v-tag-name + '>'
     1566           .
     1567       end.
     1568   end.
     1569   end procedure.
     1570   procedure bgelib-tag-close:
     1571   do
     1572   on error undo, return error
     1573   :
     1574   define input parameter v-tag-level as integer      no-undo.
     1575   define input parameter v-tag-name  as character    no-undo.
     1576       put stream stmXMLOut unformatted
     1577           chr(10)
     1578           + fill( " ", 4 * v-tag-level)
     1579           + '</' + v-tag-name + '>'
     1580       .
     1581   end.
     1582   end procedure.
     1583   procedure bgelib-write-log:
     1584   do
     1585   on error undo, return error
     1586   :
     1587   define input parameter v-filename   as character    no-undo.
     1588   define input parameter v-log-level  as integer      no-undo.
     1589   define input parameter v-out-string as character    no-undo.
     1590       output stream stmXMLLog to value( v-filename ) append.
     1591       put stream stmXMLLog unformatted
     1592           chr(10)
     1593       .
     1594       put stream stmXMLLog unformatted
     1595           ( if v-log-level = 0
     1596             or v-out-string = "&DLine"
     1597             or v-out-string = "&Line"
     1598             then ""
     1599             else cur-time-string-sec() + " " )
     1600       .
     1601       put stream stmXMLLog unformatted
     1602           ( if v-out-string = "&Line"
     1603             then fill( "-", 80 )
     1604             else if v-out-string = "&DLine"
     1605                  then fill( "=", 80 )
     1606                  else v-out-string )
     1607       .
     1608       output stream stmXMLLog close.
     1609   end.
     1610   end procedure.
     1611   procedure bgelib-write-edt:
     1612   do
     1613   on error undo, return error
     1614   :
     1615   define input parameter v-editor-handle    as handle       no-undo.
     1616   define input parameter v-log-level        as integer      no-undo.
     1617   define input parameter v-out-string       as character    no-undo.
     1618       if valid-handle ( v-editor-handle )
     1619       then do:
     1620           v-editor-handle :move-to-eof().
     1621           v-editor-handle :insert-string( ( if v-log-level = 0
     1622                                             or v-out-string = "&DLine"
     1623                                             or v-out-string = "&Line"
     1624                                             then ""
     1625                                             else cur-time-string-sec() + " "
     1626                                         ) ).
     1627           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1628                                             then fill( "-", 80 )
     1629                                             else if v-out-string = "&DLine" then fill("=", 80)
     1630                                             else fill( " ", v-log-level) + v-out-string
     1631                                         ) ).
     1632           v-editor-handle :insert-string( chr(10) ).
     1633       end.
     1634       process events.
     1635       output to 'bgescn.txt' append.
     1636           put unformatted
     1637               chr(10)
     1638               string( ( if v-log-level = 0
     1639                         or v-out-string = "&DLine"
     1640                         or v-out-string = "&Line"
     1641                         then ""
     1642                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1643                     ) )
     1644               string( ( if v-out-string = "&Line"
     1645                         then fill( "-", 80 )
     1646                         else if v-out-string = "&DLine"
     1647                              then fill( "=", 80 )
     1648                              else fill( " ", v-log-level ) + v-out-string
     1649                     ) )
     1650           .
     1651       output close.
     1652   end.
     1653   end procedure.
     1654   procedure bgelib-show-cnt:
     1655   do
     1656   on error undo, return error
     1657   :
     1658   define input parameter v-fillin-handle     as handle   no-undo.
     1659       if valid-handle( v-fillin-handle )
     1660       then do:
     1661           assign
     1662               v-fillin-handle :visible = true
     1663           .
     1664       end.
     1665   end.
     1666   end procedure.
     1667   procedure bgelib-hide-cnt:
     1668   do
     1669   on error undo, return error
     1670   :
     1671   define input parameter v-fillin-handle     as handle   no-undo.
     1672       if valid-handle( v-fillin-handle )
     1673       then do:
     1674           assign v-fillin-handle :visible = false.
     1675       end.
     1676   end.
     1677   end procedure.
     1678   procedure bgelib-write-cnt:
     1679   do
     1680   on error undo, return error
     1681   :
     1682   define input parameter v-fillin-handle    as handle       no-undo.
     1683   define input parameter v-fillin-string    as character    no-undo.
     1684       if valid-handle( v-fillin-handle )
     1685       then do:
     1686           assign
     1687               v-fillin-handle :SCREEN-value = v-fillin-string
     1688           .
     1689       end.
     1690   end.
     1691   end procedure.
     1692   procedure bgelib-write-header:
     1693   do
     1694   on error undo, return error
     1695   :
     1696   define input parameter p-first-file     as logical      no-undo.
     1697   define input parameter p-xml-file-name  as character    no-undo.
     1698   define input parameter p-list-file-name as character    no-undo.
     1699   define input parameter p-file-number    as integer      no-undo.
     1700   define input parameter p-have-prev      as logical      no-undo.
     1701   define input parameter p-prev-filename  as character    no-undo.
     1702   define input parameter p-obj-list       as character    no-undo.
     1703   define input parameter p-doc-type-list  as character    no-undo.
     1704   define input parameter p-parameter-list as character    no-undo.
     1705       define variable v-counter    as integer        no-undo.
     1706       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1707       put stream stmXMLOut unformatted
     1708           "<?xml version='1.0' encoding='windows-1251'?>"
     1709       .
     1710       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1711       run bgelib-tag-open( input 0, input "header", input "" ).
     1712       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1713       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1714       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1715       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1716       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1717       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1718       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1719       :
     1720           run bgelib-tag-put(
     1721                 input 1
     1722               , input entry( 2 * v-counter, p-parameter-list )
     1723               , input entry( 2 * v-counter + 1, p-parameter-list )
     1724               , input 0
     1725           ).
     1726       end.
     1727       run bgelib-tag-close( input 0, input "header" ).
     1728       output stream stmXMLOut close.
     1729       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1730       if p-first-file = yes
     1731       then do:
     1732           put stream stmXMLOut unformatted
     1733               "<?xml version='1.0' encoding='windows-1251'?>"
     1734           .
     1735           run bgelib-tag-open( input 0, input "export", input "" ).
     1736       end.
     1737       run bgelib-tag-open( input 1, input "file", input "" ).
     1738       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1739       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1740       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1741       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1742       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1743       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1744       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1745       :
     1746           run bgelib-tag-put(
     1747                 input 2
     1748               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1749               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1750               , input 0
     1751           ).
     1752       end.
     1753       run bgelib-tag-close( input 1, input "file" ).
     1754       output stream stmXMLOut close.
     1755   end.
     1756   end procedure.
     1757   procedure bgelib-write-footer:
     1758   do
     1759   on error undo, return error
     1760   :
     1761   define input parameter p-last-file      as logical      no-undo.
     1762   define input parameter p-xml-file-name  as character    no-undo.
     1763   define input parameter p-list-file-name as character    no-undo.
     1764   define input parameter p-have-next      as logical      no-undo.
     1765   define input parameter p-next-file-name as character    no-undo.
     1766       define variable v-error-num     as integer           no-undo.
     1767       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1768       if p-have-next = yes
     1769       then do:
     1770           run bgelib-tag-open( input 0, input "footer", "" ).
     1771           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1772           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1773           run bgelib-tag-close( input 0, input "footer" ).
     1774       end.
     1775       run bgelib-tag-close( input 0, input "root" ).
     1776       output stream stmXMLOut close.
     1777       run bge/os_copy.p (
     1778             input "M"
     1779           , input p-xml-file-name + "tmp"
     1780           , input p-xml-file-name + "xml"
     1781           , output v-error-num
     1782       ).
     1783       if p-last-file = yes
     1784       then do:
     1785           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1786               run bgelib-tag-close( input 0, input "export" ).
     1787           output stream stmXMLOut close.
     1788           run bge/os_copy.p (
     1789                 input "M"
     1790               , input p-list-file-name + "tmp"
     1791               , input p-list-file-name + "xml"
     1792               , output v-error-num
     1793           ).
     1794       end.
     1795   end.
     1796   end procedure.
     1797   procedure bgelib-filename :
     1798   do
     1799   on error undo, return error
     1800   :
     1801   define input parameter p-prefix             as character    no-undo.
     1802   define output parameter p-xml-file-name     as character    no-undo.
     1803   define output parameter p-log-file-name     as character    no-undo.
     1804   define output parameter p-list-file-name    as character    no-undo.
     1805       define variable v-home-dir  as character    no-undo.
     1806       define variable v-error-num as integer      no-undo.
     1807       get-key-value section "BGE" key "outdir" value v-home-dir.
     1808       if v-home-dir = ?
     1809       then do:
     1810           message
     1811             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1812             skip(1)
     1813             skip "Обратитесь к администратору."
     1814           view-as alert-box error.
     1815           undo, return error .
     1816       end.
     1817       run gbl/dir-cre.p (
     1818           input v-home-dir
     1819       ) no-error.
     1820       if error-status :error
     1821       then do:
     1822           message
     1823             skip "Неверно задан каталог экспорта."
     1824             skip(1)
     1825             skip "Обратитесь к администратору."
     1826           view-as alert-box error.
     1827           undo, return error .
     1828       end.
     1829       run bge/genfname.p (
     1830             input v-home-dir
     1831           , input p-prefix
     1832           , input ""
     1833           , input "xml"
     1834           , input "tmp"
     1835           , output p-xml-file-name
     1836       ).
     1837       assign
     1838           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1839           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1840           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1841       .
     1842   end.
     1843   end procedure.
     1844   procedure bgelib-read-config :
     1845   do
     1846   on error undo, return error
     1847   :
     1848   define variable v-par-type as character     no-undo.
     1849     define variable v-param-type      as character  no-undo .
     1850     define variable v-value-character as character  no-undo .
     1851     define variable v-value-date      as date       no-undo .
     1852     define variable v-value-decimal   as decimal    no-undo .
     1853     define variable v-value-integer   as integer    no-undo .
     1854     define variable v-value-logical   as logical    no-undo .
     1855     define variable v-tth             as handle     no-undo .
     1856       assign
     1857           v-bgelib-bgeclall = no
     1858           v-bgelib-bgedict  = no
     1859       .
     1860       run adm/shattri.p ( input "get":U
     1861                         , input  '':u
     1862                         , input  0
     1863                         , input  'bge-export':U
     1864                         , input  'bgeclall':U
     1865                         , output v-value-character
     1866                         , output v-value-date
     1867                         , output v-value-decimal
     1868                         , output v-value-integer
     1869                         , output v-value-logical
     1870                         , output v-param-type
     1871                         , input-output table-handle v-tth
     1872                         ) no-error .
     1873       if error-status :error
     1874       then do:
     1875         assign
     1876           v-bgelib-bgeclall = no
     1877         .
     1878       end.
     1879       else do:
     1880         assign
     1881           v-bgelib-bgeclall = v-value-logical
     1882         .
     1883       end.
     1884       delete object v-tth.
     1885       run adm/shattri.p ( input "get":U
     1886                         , input  '':u
     1887                         , input  0
     1888                         , input  'bge-export':U
     1889                         , input  'bgedict':U
     1890                         , output v-value-character
     1891                         , output v-value-date
     1892                         , output v-value-decimal
     1893                         , output v-value-integer
     1894                         , output v-value-logical
     1895                         , output v-param-type
     1896                         , input-output table-handle v-tth
     1897                         ) no-error .
     1898       if error-status :error
     1899       then do:
     1900         assign
     1901           v-bgelib-bgedict = no
     1902         .
     1903       end.
     1904       else do:
     1905         assign
     1906           v-bgelib-bgedict = v-value-logical
     1907         .
     1908       end.
     1909       delete object v-tth.
     1910       run adm/shattri.p ( input "get":U
     1911                         , input  '':u
     1912                         , input  0
     1913                         , input  'bge-export':U
     1914                         , input  'bgefmt':U
     1915                         , output v-value-character
     1916                         , output v-value-date
     1917                         , output v-value-decimal
     1918                         , output v-value-integer
     1919                         , output v-value-logical
     1920                         , output v-param-type
     1921                         , input-output table-handle v-tth
     1922                         ) no-error .
     1923       if error-status :error
     1924       then do:
     1925         assign
     1926           v-bgelib-bgefmt  = "xml":U
     1927         .
     1928       end.
     1929       else do:
     1930         assign
     1931           v-bgelib-bgefmt  = v-value-character
     1932         .
     1933       end.
     1934       delete object v-tth.
     1935       run adm/shattri.p ( input "get":U
     1936                         , input  '':u
     1937                         , input  0
     1938                         , input  'bge-export':U
     1939                         , input  'bgeflold':U
     1940                         , output v-value-character
     1941                         , output v-value-date
     1942                         , output v-value-decimal
     1943                         , output v-value-integer
     1944                         , output v-value-logical
     1945                         , output v-param-type
     1946                         , input-output table-handle v-tth
     1947                         ) no-error .
     1948       if error-status :error
     1949       then do:
     1950         assign
     1951           v-bgelib-bgeflold  = "old":U
     1952         .
     1953       end.
     1954       else do:
     1955         assign
     1956           v-bgelib-bgeflold  = v-value-character
     1957         .
     1958       end.
     1959       delete object v-tth.
     1960   end.
     1961   end procedure.
     1962   procedure bgelib-check-file-size :
     1963   do
     1964   on error undo, return error
     1965   :
     1966   define input parameter p-out-filename   as character    no-undo.
     1967   define output parameter p-is-big        as logical      no-undo.
     1968       define variable v-current-position    as integer        no-undo.
     1969       assign
     1970           v-current-position = seek( stmXMLOut )
     1971       .
     1972       if v-current-position / 1024 / 1024  >= 100
     1973       then do:
     1974           assign
     1975               p-is-big = yes
     1976           .
     1977       end.
     1978   end.
     1979   end procedure.
     1980   procedure bgelib-init-ext-doc-type :
     1981       define variable v-counter    as integer      no-undo.
     1982       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1983   do
     1984   for buf_temp_ext-doc-type
     1985   on error undo, return error
     1986   :
     1987       empty temp-table buf_temp_ext-doc-type.
     1988       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1989       :
     1990           create buf_temp_ext-doc-type.
     1991           assign
     1992               buf_temp_ext-doc-type.edt-key               = v-counter
     1993               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1994               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1995           .
     1996       end.
     1997   end.
     1998   end procedure.
     1999   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2000     define variable v-cntxt-db-num        as integer   no-undo .
     2001     define variable v-cntxt-userid        as character no-undo .
     2002     define variable v-cntxt-level         as character no-undo .
     2003     define variable v-cntxt-host-code-obj as integer   no-undo .
     2004     define variable v-cntxt-obj-type      as character no-undo .
     2005     define variable v-cntxt-obj-code      as integer   no-undo .
     2006     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2007     define variable v-cntxt-is-admin      as logical   no-undo .
     2008   define variable v-obj-type like ub.clients.obj-type no-undo .
     2009   define variable v-obj-code like ub.clients.obj-code no-undo .
     2010   define variable v-action as char no-undo .
     2011   define variable choice as integer no-undo.
     2012   define variable rid-list as char no-undo.
     2013   define variable v-host-code like ub.sysconf.host-code no-undo .
     2014   assign
     2015   v-obj-type = entry(1, p-parameter, chr(4))
     2016   v-obj-code = integer(entry(2, p-parameter, chr(4)))
     2017   v-action     = entry(3, p-parameter, chr(4))
     2018   no-error .
     2019   if error-status:error then do:
     2020     run write-log-and-file in p-log-handle (
     2021           input 1
     2022         , input log-file-name
     2023         , input 1
     2024         , input substitute("Ошибка входных параметров &1:&2&3"
     2025                            , p-parameter
     2026                            , chr(10)
     2027                            , error-status:get-message(1)
     2028                            )).
     2029     v-view-log = yes.
     2030     undo, return error .
     2031   end .
     2032   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2033     run mainmenu_getcntxt in parparentproc
     2034       (output v-cntxt-db-num
     2035       ,output v-cntxt-userid
     2036       ,output v-cntxt-level
     2037       ,output v-cntxt-host-code-obj
     2038       ,output v-cntxt-obj-type
     2039       ,output v-cntxt-obj-code
     2040       ,output v-cntxt-db-num-obj
     2041       ,output v-cntxt-is-admin
     2042       ) .
     2043   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2045     (input  v-obj-type
     2046     ,input  v-obj-code
     2047     ,output v-host-code
     2048     )  .
     2049   FIND FIRST ub.cash-desk NO-LOCK WHERE
     2050              ub.cash-desk.db-num = g#db-num AND
     2051              ub.cash-desk.pos-type = 'IBM-XML':U   AND
     2052              ub.cash-desk.obj-code = v-obj-code
     2053               No-error.
     2054   IF not avail(ub.cash-desk) then do:
     2055     run write-log-and-file in p-log-handle (
     2056           input 1
     2057         , input log-file-name
     2058         , input 1
     2059         , input substitute( "!!!&1 масок серийных МЦ реализуется только для касс &2 "
     2060                             , (if v-action = "U" then "Передача" else "Удаление")
     2061                             , 'IBM-XML':U
     2062                           )
     2063                                           ).
     2064         v-view-log = yes.
     2065   //      {&view-log}.
     2066     undo, return .
     2067   end.
     2068   run gbl/d-askw.w (input "Выбор масок серийных МЦ для пересылки",
     2069               input ( (if v-action = "U"
     2070                         then "Переслать на кассу"
     2071                         else "Удалить из кассы" ) + chr(10) +
     2072                                 "информацию о типах кассовых платежей"
     2073                                 ),
     2074               input "|",
     2075               input "Все|Выборочно|Отказ от пересылки",
     2076               input "||",
     2077               input 1,
     2078               input 3,
     2079               output choice).
     2080   CASE choice:
     2081     when 1 then do:
     2082     end.
     2083     when 2 then do:
     2084         run ref/wths-ref.w
     2085           (input parparentproc
     2086           ,input "b-mark,b-sel":U
     2087           ,input v-host-code
     2088           ,input v-obj-type
     2089           ,input v-obj-code
     2090           ,input 'все':U
     2091           ,input 0
     2092           ,input 0
     2093           ,input-output rid-list
     2094           ) no-error .
     2095         if error-status:error then do:
     2096           run write-log-and-file in p-log-handle (
     2097               input 1
     2098             , input log-file-name
     2099             , input 1
     2100             , input substitute("Не определен список масок для пересылки")
     2101                                             ).
     2102         assign
     2103         v-view-log = yes.
     2104   //      {&view-log}.
     2105         undo, return .
     2106         end.
     2107       if rid-list = "" then return.
     2108     end.
     2109     when 3 then do:
     2110       return.
     2111     end.
     2112   END CASE.
     2113   run str/sndwssh.p (parparentproc
     2114                  ,p-parent-handle
     2115                  ,p-log-handle
     2116                  ,v-obj-type
     2117                  ,v-obj-code
     2118                  ,rid-list
     2119                  ,v-action
     2120                     ) no-error.
     2121     if error-status:error then do:
     2122       run write-log-and-file in p-log-handle (
     2123             input 1
     2124           , input log-file-name
     2125           , input 1
     2126           , input substitute( "ошибка при отправке масок серийных МЦ на кассу по магазину &1&2&3&2&4"
     2127                             , v-obj-code
     2128                             , chr(10)
     2129                             , error-status:get-message(1)
     2130                             , return-value
     2131                             )).
     2132       assign
     2133       v-view-log = yes.
     2134     end.
     2135     finally :
     2136   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2137   if v-view-log
     2138   and not g#news
     2139   and not g#auto
     2140   then do:
     2141     message
     2142     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
     2143     "!!!Внимательно прочитайте Log-file!!"
     2144     view-as alert-box error .
     2145        define variable v-user-action11   as character no-undo .
     2146     define variable v-printed11       as logical   no-undo .
     2147     run gbl/prnfilen.w
     2148       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
     2149       ,input  0
     2150       ,input  (string("./":U) + log-file-name)
     2151       ,input  7
     2152       ,output v-user-action11
     2153       ,output v-printed11
     2154       ) .
     2155   end.
     2156   if v-view-log = true
     2157   and (g#news
     2158   or g#auto)
     2159   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     2160   then do:
     2161      run cb_set-view-log in p-parent-handle ( input yes).
     2162   end.
     2163       run write-log-and-file in p-log-handle (
     2164           input 1
     2165         , input log-file-name
     2166         , input 1
     2167         , input substitute("&1", chr(10))
     2168       ).
     2169       define variable v-save-file-name as character no-undo .
     2170       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     2171       OS-APPEND value(log-file-name) value(v-save-file-name).
     2172       OS-DELETE value(log-file-name).
     2173     end finally .
