        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Толкач пересылки типов кассовых платежей на кассу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable p-pos-type as character no-undo .
       91   define variable p-obj-type like ub.clients.obj-type no-undo .
       92   define variable p-obj-code like ub.clients.obj-code no-undo .
       93   define variable action as char no-undo .
       94   define var choice as integer no-undo.
       95   define var rid-list as char no-undo.
       96   define variable glog as logical no-undo .
       97   define variable log-file-name as character no-undo init "send-cd.txt":U .
       98   define variable v-view-log as logical no-undo .
       99   define variable v-host-code like ub.sysconf.host-code no-undo .
      100   assign
      101   p-pos-type = entry(1, p-parameter, chr(4))
      102   p-obj-type = entry(2, p-parameter, chr(4))
      103   p-obj-code = integer(entry(3, p-parameter, chr(4)))
      104   action     = entry(4, p-parameter, chr(4))
      105   no-error .
      106   if error-status:error then do:
      107     run write-log-and-file in p-log-handle (
      108           input 1
      109         , input log-file-name
      110         , input 1
      111         , input substitute("Ошибка входных параметров &1:&2&3"
      112                            , p-parameter
      113                            , chr(10)
      114                            , error-status:get-message(1)
      115                            )).
      116     v-view-log = yes.
      117     undo, return error .
      118   end .
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     run mainmenu_getcntxt in parparentproc
      121       (output v-cntxt-db-num
      122       ,output v-cntxt-userid
      123       ,output v-cntxt-level
      124       ,output v-cntxt-host-code-obj
      125       ,output v-cntxt-obj-type
      126       ,output v-cntxt-obj-code
      127       ,output v-cntxt-db-num-obj
      128       ,output v-cntxt-is-admin
      129       ) .
      130   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      132     (input  p-obj-type
      133     ,input  p-obj-code
      134     ,output v-host-code
      135     )  .
      136   CASE p-pos-type:
      137     when 'IBM':U
      138     or
      139     when 'IBM-XML':U
      140     or
      141     when 'MARIA':U
      142     then do:
      143       FIND FIRST ub.cash-desk NO-LOCK WHERE
      144                 ub.cash-desk.db-num = g#db-num AND
      145                 (ub.cash-desk.pos-type = 'IBM':U
      146                 or ub.cash-desk.pos-type = 'IBM-XML':U
      147                 or ub.cash-desk.pos-type = 'MARIA':U
      148                   )
      149                 No-error.
      150       IF not avail(ub.cash-desk) then do:
      151           run write-log-and-file in p-log-handle (
      152                 input 1
      153               , input log-file-name
      154               , input 1
      155               , input substitute( "!!!&1 типов платежей реализуется только для POS &2 или POS &3 или POS &4"
      156                                   , (if action = "U" then "Передача" else "Удаление")
      157                                   , 'IBM':U
      158                                   , 'IBM-XML':U
      159                                   , 'MARIA':U
      160                                 )
      161                                                 ).
      162         return.
      163       end.
      164       if action = "U"
      165       then do:
      166   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167   do:
      168     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      169       (input  v-cntxt-db-num
      170       ,input  v-cntxt-userid
      171       ,input  0
      172       ,input  'actn_cashdesk-payments_add-def':U
      173       ,input  'object':U
      174       ,input  v-host-code
      175       ,input  p-obj-type
      176       ,input  p-obj-code
      177       ,input  0
      178       ,input  0
      179       ,input  0
      180       ,input  true
      181       ,output glog
      182       )  .
      183   end.
      184       end.
      185       else do:
      186   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187   do:
      188     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      189       (input  v-cntxt-db-num
      190       ,input  v-cntxt-userid
      191       ,input  0
      192       ,input  'actn_cashdesk-payments_deletion':U
      193       ,input  'object':U
      194       ,input  v-host-code
      195       ,input  p-obj-type
      196       ,input  p-obj-code
      197       ,input  0
      198       ,input  0
      199       ,input  0
      200       ,input  true
      201       ,output glog
      202       )  .
      203   end.
      204       end.
      205       if NOT glog then return .
      206     end.
      207     when 'MAGIA-XML':U then do:
      208       FIND FIRST cash-desk NO-LOCK WHERE
      209                 cash-desk.db-num = g#db-num AND
      210                 cash-desk.pos-type = 'MAGIA-XML':U No-error.
      211       IF not avail(cash-desk) then do:
      212           run write-log-and-file in p-log-handle (
      213                 input 1
      214               , input log-file-name
      215               , input 1
      216               , input substitute( "!!!&1 типов платежей реализуется только для POS &2"
      217                                   , (if action = "U" then "Передача" else "Удаление")
      218                                   , 'MAGIA-XML':U
      219                                 )
      220                                                 ).
      221         return.
      222       end.
      223       if not g#news then do:
      224   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   do:
      226     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      227       (input  v-cntxt-db-num
      228       ,input  v-cntxt-userid
      229       ,input  0
      230       ,input  'actn_cashdesk-restaurant_work':U
      231       ,input  'firm':U
      232       ,input  v-host-code
      233       ,input  '':U
      234       ,input  0
      235       ,input  0
      236       ,input  0
      237       ,input  0
      238       ,input  true
      239       ,output glog
      240       )  .
      241   end.
      242         if NOT glog then return .
      243       end.
      244     end.
      245   END CASE.
      246   run gbl/d-askw.w (input "Выбор типов кассовых платежей для пересылки",
      247               input ( (if action = "U"
      248                         then "Переслать на кассу"
      249                         else "Удалить из кассы" ) + chr(10) +
      250                                 "информацию о типах кассовых платежей"
      251                                 ),
      252               input "|",
      253               input "Все|Выборочно|Отказ от пересылки",
      254               input "||",
      255               input 1,
      256               input 3,
      257               output choice).
      258   CASE choice:
      259     when 1 then do:
      260     end.
      261     when 2 then do:
      262       run ref/cashpays.w (
      263                      input parparentproc
      264                     ,input "b-mark,b-sel":U
      265                     ,input 'все':U
      266                     ,input v-host-code
      267                     ,input p-obj-type
      268                     ,input p-obj-code
      269                     ,output rid-list) no-error.
      270       if rid-list = "" then return.
      271     end.
      272     when 3 then do:
      273       return.
      274     end.
      275     when 4 then do:
      276       rid-list = "*".
      277     end.
      278   END CASE.
      279   CASE p-pos-type:
      280     when 'IBM':U
      281     or
      282     when  'IBM-XML':U
      283     or
      284     when 'MARIA':U
      285     then do:
      286       run str/send-pay.p (
      287                       input parparentproc
      288                      ,input p-parent-handle
      289                      ,input p-log-handle
      290                      ,input p-obj-code
      291                      ,input action
      292                      ,input (if rid-list = "":U
      293                              then 0
      294                              else 1)
      295                     , input rid-list
      296                     , input log-file-name
      297                     , input-output v-view-log
      298                     ) no-error .
      299     end.
      300     when 'MAGIA-XML':U then do:
      301       run str/sendcurp.p (
      302                       input parparentproc
      303                      ,input p-parent-handle
      304                      ,input p-log-handle
      305                      ,input g#db-num
      306                      ,input p-obj-type
      307                      ,input p-obj-code
      308                      ,input action
      309                      ,input (if rid-list = "":U
      310                              then 0
      311                              else 1)
      312                      ,input rid-list
      313                      ,input log-file-name
      314                      ,input-output v-view-log
      315                      ) no-error .
      316     end.
      317   end CASE.
      318     finally :
      319       run write-log-and-file in p-log-handle (
      320           input 1
      321         , input log-file-name
      322         , input 1
      323         , input substitute("&1", chr(10))
      324       ).
      325       define variable v-save-file-name as character no-undo .
      326       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
      327       OS-APPEND value(log-file-name) value(v-save-file-name).
      328       OS-DELETE value(log-file-name).
      329     end finally .
