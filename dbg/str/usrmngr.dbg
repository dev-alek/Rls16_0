     1940   END PROCEDURE.
     1941   PROCEDURE fill-menu :
     1942   define buffer buf_menu-group     for menu-group .
     1943   do
     1944   on error undo, return error
     1945   :
     1946      for each  buf_menu-group
     1947          where buf_menu-group.menu-code = 0
     1948          no-lock
     1949          by buf_menu-group.menu-group-name
     1950          :
     1951          IF buf_menu-group.menu-group-id = "all" then do:
     1952             next .
     1953          end.
     1954          create tt-menu-group.
     1955          assign
     1956             tt-menu-group.menu-group-code        = buf_menu-group.menu-group-code
     1957             tt-menu-group.menu-group-id          = buf_menu-group.menu-group-id
     1958             tt-menu-group.menu-group-name        = buf_menu-group.menu-group-name
     1959             tt-menu-group.menu-group-description = buf_menu-group.menu-group-description
     1960          .
     1961      end.
     1962   end.
     1963   END PROCEDURE.
     1964   PROCEDURE fill-wp :
     1965   DEFINE BUFFER buf_user-obj  FOR user-obj.
     1966   DEFINE BUFFER buf_user-host FOR user-host.
     1967   DEFINE BUFFER buf_clients   FOR clients.
     1968   define buffer buf_user-menu-group      for user-menu-group .
     1969   define buffer del_user-menu-group      for user-menu-group .
     1970   define buffer buf_tt-work-place     for tt-work-place .
     1971   if available tt-menu-group then
     1972   do
     1973   on error undo, return error
     1974   :
     1975      user-menu_:
     1976      FOR EACH buf_user-obj
     1977            WHERE buf_user-obj.db-num = p-db-num
     1978            AND buf_user-obj.USER-ID  = p-user-id
     1979         NO-LOCK
     1980         :
     1981            FIND FIRST buf_clients
     1982               WHERE buf_clients.obj-code = buf_user-obj.obj-code
     1983                  AND buf_clients.obj-type = buf_user-obj.obj-type
     1984               NO-LOCK
     1985               .
     1986            CREATE buf_tt-work-place.
     1987            ASSIGN
     1988               buf_tt-work-place.wp-code = buf_clients.obj-code
     1989               buf_tt-work-place.wp-type = buf_clients.obj-type
     1990               buf_tt-work-place.wp-host = buf_clients.host-code
     1991               buf_tt-work-place.db-num  = buf_clients.db-num
     1992               buf_tt-work-place.context = 'object':U
     1993               buf_tt-work-place.wp-name = buf_clients.obj-name
     1994            .
     1995      end.
     1996      FOR EACH buf_user-host
     1997          WHERE buf_user-host.db-num  = p-db-num
     1998            AND buf_user-host.USER-ID = p-user-id
     1999          NO-LOCK
     2000          :
     2001            FIND FIRST buf_clients
     2002               WHERE buf_clients.obj-code = buf_user-host.host-code
     2003                  AND buf_clients.obj-type = 'орг':U
     2004               NO-LOCK
     2005               .
     2006            CREATE buf_tt-work-place.
     2007            ASSIGN
     2008               buf_tt-work-place.wp-code = buf_clients.obj-code
     2009               buf_tt-work-place.wp-type = buf_clients.obj-type
     2010               buf_tt-work-place.wp-host = buf_clients.obj-code
     2011               buf_tt-work-place.db-num  = buf_clients.db-num
     2012               buf_tt-work-place.context = 'firm':U
     2013               buf_tt-work-place.wp-name = buf_clients.obj-name
     2014            .
     2015      end.
     2016   end.
     2017   END PROCEDURE.
     2018   PROCEDURE local-open-query-menu :
     2019   define variable v-ok    as logical      no-undo.
     2020   do
     2021   on error undo, return error return-value
     2022   :
     2023      open query BROWSE-menu
     2024           for each  br_tt-menu-group
     2025           no-lock
     2026           indexed-reposition
     2027           .
     2028   end.
     2029   END PROCEDURE.
     2030   PROCEDURE local-open-query-wp :
     2031   do
     2032   on error undo, return error return-value
     2033   :
     2034       open query browse-wp
     2035       for each br_tt-work-place
     2036           where br_tt-work-place.selected = TRUE
     2037           no-lock
     2038       indexed-reposition
     2039       .
     2040   end.
     2041   END PROCEDURE.
     2042   PROCEDURE mark-wp :
     2043   define buffer buf_user-menu-group      for user-menu-group .
     2044   define buffer buf_tt-work-place     for tt-work-place .
     2045   if available br_tt-menu-group then
     2046   do
     2047   on error undo, return error
     2048   :
     2049      user-menu_:
     2050      FOR EACH buf_tt-work-place
     2051         :
     2052         case buf_tt-work-place.context:
     2053         when 'object':U then do:
     2054            IF CAN-FIND ( FIRST buf_user-menu-group
     2055                 where buf_user-menu-group.db-num             = p-db-num
     2056                   and buf_user-menu-group.user-id            = p-user-id
     2057                   and buf_user-menu-group.menu-code          = 0
     2058                   and buf_user-menu-group.menu-group-code    = br_tt-menu-group.menu-group-code
     2059                   and buf_user-menu-group.obj-code           = buf_tt-work-place.wp-code
     2060                   AND buf_user-menu-group.obj-type           = buf_tt-work-place.wp-type
     2061                   and buf_user-menu-group.host-code          = buf_tt-work-place.wp-host
     2062                   and buf_user-menu-group.menu-group-context = 'object':U
     2063                   and buf_user-menu-group.menu-group-id      = br_tt-menu-group.menu-group-id
     2064               NO-LOCK )
     2065               then do:
     2066                  ASSIGN
     2067                     buf_tt-work-place.selected = TRUE
     2068                  .
     2069               end.
     2070               else do:
     2071                  ASSIGN
     2072                     buf_tt-work-place.selected = FALSE
     2073                  .
     2074               end.
     2075         end.
     2076         when 'firm':U then do:
     2077            IF CAN-FIND ( FIRST buf_user-menu-group
     2078                 where buf_user-menu-group.db-num             = p-db-num
     2079                   and buf_user-menu-group.user-id            = p-user-id
     2080                   and buf_user-menu-group.menu-code          = 0
     2081                   and buf_user-menu-group.menu-group-code    = br_tt-menu-group.menu-group-code
     2082                   and buf_user-menu-group.obj-code           = 0
     2083                   AND buf_user-menu-group.obj-type           = "":U
     2084                   and buf_user-menu-group.host-code          = buf_tt-work-place.wp-host
     2085                   and buf_user-menu-group.menu-group-context = 'firm':U
     2086                   and buf_user-menu-group.menu-group-id      = br_tt-menu-group.menu-group-id
     2087               NO-LOCK )
     2088               then do:
     2089                  ASSIGN
     2090                     buf_tt-work-place.selected = TRUE
     2091                  .
     2092               end.
     2093               else do:
     2094                  ASSIGN
     2095                     buf_tt-work-place.selected = FALSE
     2096                  .
     2097               end.
     2098         end.
     2099         otherwise do:
     2100         end.
     2101         end case.
     2102      end.
     2103   end.
     2104   END PROCEDURE.
     2105   PROCEDURE refresh-query-menu :
     2106     do
     2107     on error undo, return error return-value
     2108     :
     2109       run local-open-query-menu in this-procedure .
     2110     end.
     2111   END PROCEDURE.
     2112   PROCEDURE refresh-query-wp :
     2113     do
     2114     on error undo, return error return-value
     2115     :
     2116       RUN mark-wp IN THIS-PROCEDURE.
     2117       run local-open-query-wp in this-procedure .
     2118     end.
     2119   END PROCEDURE.
     2120   FUNCTION check-user-menu-group RETURNS logical
     2121      ( BUFFER buf_menu-group FOR menu-group ) :
     2122      define variable v-return-value as logical no-undo .
     2123      IF AVAILABLE br_tt-work-place THEN DO:
     2124         case br_tt-work-place.wp-type:
     2125         when 'орг':U THEN DO:
     2126            v-return-value =  CAN-FIND( FIRST user-menu-group
     2127                                        WHERE user-menu-group.db-num          = p-db-num
     2128                                          AND user-menu-group.user-id         = p-user-id
     2129                                          AND user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2130                                          AND user-menu-group.host-code       = br_tt-work-place.wp-code
     2131                                          AND user-menu-group.menu-group-context   = 'firm':U
     2132                                          ).
     2133         END.
     2134         when 'маг':U OR
     2135         WHEN 'скл':U THEN DO:
     2136            v-return-value =  CAN-FIND( FIRST user-menu-group
     2137                                        WHERE user-menu-group.db-num          = p-db-num
     2138                                          AND user-menu-group.user-id         = p-user-id
     2139                                          AND user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2140                                          AND user-menu-group.obj-code        = br_tt-work-place.wp-code
     2141                                          AND user-menu-group.obj-type        = br_tt-work-place.wp-type
     2142                                          AND user-menu-group.menu-group-context   = 'object':U
     2143                                          ).
     2144         END.
     2145         otherwise do:
     2146            v-return-value =  CAN-FIND( FIRST user-menu-group
     2147                                        WHERE user-menu-group.db-num          = p-db-num
     2148                                          AND user-menu-group.user-id         = p-user-id
     2149                                          AND user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2150                                          AND user-menu-group.menu-group-context   = 'global':U
     2151                                          ).
     2152         end.
     2153         end case.
     2154      END.
     2155      return v-return-value .
     2156   END FUNCTION.
     2157   FUNCTION get-context-name RETURNS CHARACTER
     2158     (BUFFER buf_user-menu-group FOR user-menu-group ) :
     2159     define variable v-return-value as character no-undo .
     2160     run procedure-get-context-name in this-procedure
     2161       (input  buf_user-menu-group.menu-group-context
     2162       ,input  buf_user-menu-group.host-code
     2163       ,input  buf_user-menu-group.obj-type
     2164       ,input  buf_user-menu-group.obj-code
     2165       ,output v-return-value
     2166       ) .
     2167     return v-return-value .
     2168   END FUNCTION.
     2169   FUNCTION get-menu-group-name RETURNS CHARACTER
     2170     ( BUFFER buf_user-menu-group FOR user-menu-group ) :
     2171     define variable v-return-value as character no-undo .
     2172     run procedure-get-menu-group-name in this-procedure
     2173       (input  buf_user-menu-group.menu-code
     2174       ,input  buf_user-menu-group.menu-group-code
     2175       ,input  buf_user-menu-group.menu-group-id
     2176       ,output v-return-value
     2177       ) .
     2178     return v-return-value .
     2179   END FUNCTION.
