      233   function usrnickf returns character ( input p-user-id as character):
      234      define variable v-nick      as character    no-undo.
      235      if p-user-id = ?
      236      OR p-user-id = "":U
      237      then do:
      238         return '':U .
      239      end.
      240   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
      242     (input  p-user-id
      243     ,output v-nick
      244     ) no-error .
      245      if error-status :error
      246      then do:
      247         return p-user-id.
      248      end.
      249      else do:
      250         return v-nick.
      251      end.
      252   end function.
      253   define variable v-menu-group-name as character no-undo format "x(30)" column-label "Группа меню" .
      254   define variable v-context-name    as character no-undo format "x(40)" column-label "Контекст"    .
      255   define variable v-user-menu-group as logical   no-undo format "*/ "   column-label "*" .
      256   define variable v-ok              as logical   no-undo.
      257   DEFINE BUFFER br_tt-work-place FOR tt-work-place .
      258   DEFINE buffer br_menu-group    FOR menu-group .
      259   DEFINE buffer br_tt-menu-group FOR tt-menu-group .
      260   define buffer buf_user-login   for user-login.
      261   FUNCTION check-user-menu-group RETURNS logical
      262      ( BUFFER buf_menu-group FOR menu-group )  FORWARD.
      263   FUNCTION get-context-name RETURNS CHARACTER
      264     (BUFFER buf_user-menu-group FOR user-menu-group )  FORWARD.
