     1827                  when 'object':U THEN do:
     1828                     assign
     1829                        v-user-menu-group-code = next-value(s-user-menu-group)
     1830                     .
     1831                     CREATE buf_user-menu-group.
     1832                     assign
     1833                        buf_user-menu-group.db-num               = p-db-num
     1834                        buf_user-menu-group.user-id              = p-user-id
     1835                        buf_user-menu-group.menu-code            = 0
     1836                        buf_user-menu-group.menu-group-code      = br_tt-menu-group.menu-group-code
     1837                        buf_user-menu-group.menu-group-id        = br_tt-menu-group.menu-group-id
     1838                        buf_user-menu-group.menu-group-context   = 'object':U
     1839                        buf_user-menu-group.obj-type             = buf_tt-work-place.wp-type
     1840                        buf_user-menu-group.obj-code             = buf_tt-work-place.wp-code
     1841                        buf_user-menu-group.host-code            = buf_tt-work-place.wp-host
     1842                        buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     1843                     .
     1844                  end.
     1845                  when 'firm':U THEN do:
     1846                     assign
     1847                        v-user-menu-group-code = next-value(s-user-menu-group)
     1848                     .
     1849                     CREATE buf_user-menu-group.
     1850                     assign
     1851                        buf_user-menu-group.db-num               = p-db-num
     1852                        buf_user-menu-group.user-id              = p-user-id
     1853                        buf_user-menu-group.menu-code            = 0
     1854                        buf_user-menu-group.menu-group-code      = br_tt-menu-group.menu-group-code
     1855                        buf_user-menu-group.menu-group-id        = br_tt-menu-group.menu-group-id
     1856                        buf_user-menu-group.menu-group-context   = 'firm':U
     1857                        buf_user-menu-group.obj-type             = "":U
     1858                        buf_user-menu-group.obj-code             = 0
     1859                        buf_user-menu-group.host-code            = buf_tt-work-place.wp-host
     1860                        buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     1861                     .
     1862                  end.
     1863                  otherwise do:
     1864                  end.
     1865                  end case.
     1866               END.
     1867            end.
     1868         end.
     1869         else do:
     1870            if buf_tt-work-place.selected = TRUE then do:
     1871               find first  buf_user-menu-group
     1872               WHERE (buf_user-menu-group.db-num               = p-db-num
     1873                  AND buf_user-menu-group.user-id              = p-user-id
     1874                  and buf_user-menu-group.menu-group-code      = br_tt-menu-group.menu-group-code
     1875                  AND buf_user-menu-group.menu-group-context   = buf_tt-work-place.context
     1876                  AND buf_user-menu-group.menu-group-context   = 'firm':U
     1877                  AND buf_user-menu-group.host-code            = buf_tt-work-place.wp-host)
     1878                  OR
     1879                      (buf_user-menu-group.db-num              = p-db-num
     1880                  AND buf_user-menu-group.user-id              = p-user-id
     1881                  and buf_user-menu-group.menu-group-code      = br_tt-menu-group.menu-group-code
     1882                  AND buf_user-menu-group.menu-group-context   = buf_tt-work-place.context
     1883                  AND buf_user-menu-group.menu-group-context   = 'object':U
     1884                  AND buf_user-menu-group.obj-type             = buf_tt-work-place.wp-type
     1885                  AND buf_user-menu-group.obj-code             = buf_tt-work-place.wp-code)
     1886               exclusive-lock
     1887               no-error
     1888               .
     1889               IF AVAILABLE buf_user-menu-group THEN DO:
     1890                  DELETE buf_user-menu-group.
     1891               END.
     1892            end.
     1893            else do:
     1894               next post-each-wp_ .
     1895            end.
     1896         end.
     1897      end.
     1898   if session :set-wait-state( "" ) then.
     1899   end.
     1900   END PROCEDURE.
     1901   PROCEDURE disable_UI :
     1902     HIDE FRAME Dialog-Frame.
     1903   END PROCEDURE.
     1904   PROCEDURE enable_UI :
     1905     ENABLE b-exit b-chg-menu b-help BROWSE-menu BROWSE-WP
     1906         WITH FRAME Dialog-Frame.
     1907     VIEW FRAME Dialog-Frame.
     1908     RUN refresh-query-menu.    RUN refresh-query-wp .
     1909   END PROCEDURE.
     1910   PROCEDURE post_enable_UI :
     1911   do
     1912   on error undo, return error
     1913   :
     1914   define variable v-ok    as logical      no-undo.
     1915   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1916   do:
     1917     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1918       (input  v-cntxt-db-num
     1919       ,input  v-cntxt-userid
     1920       ,input  0
     1921       ,input  'actn_users-update':U
     1922       ,input  'global':U
     1923       ,input  0
     1924       ,input  '':U
     1925       ,input  0
     1926       ,input  0
     1927       ,input  0
     1928       ,input  0
     1929       ,input  FALSE
     1930       ,output v-ok
     1931       )  .
     1932   end.
     1933       if v-ok = FALSE
     1934       then do:
     1935           disable
     1936                 b-chg-menu
     1937           WITH FRAME Dialog-Frame.
