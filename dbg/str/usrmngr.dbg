     1798                  where temp_twowin_itemsSelected.itmExtKey = SUBSTITUTE( "&2 &1", buf_tt-work-place.wp-code, buf_tt-work-place.wp-type  )
     1799              no-lock
     1800              no-error
     1801              .
     1802         IF available temp_twowin_itemsSelected then do:
     1803            if buf_tt-work-place.selected = TRUE then do:
     1804               next post-each-wp_ .
     1805            end.
     1806            else do:
     1807               find first  buf_user-menu-group
     1808               WHERE (buf_user-menu-group.db-num               = p-db-num
     1809                  AND buf_user-menu-group.user-id              = p-user-id
     1810                  and buf_user-menu-group.menu-group-code      = br_tt-menu-group.menu-group-code
     1811                  AND buf_user-menu-group.menu-group-context   = buf_tt-work-place.context
     1812                  AND buf_user-menu-group.menu-group-context   = 'firm':U
     1813                  AND buf_user-menu-group.host-code            = buf_tt-work-place.wp-host)
     1814                  OR
     1815                     (buf_user-menu-group.db-num              = p-db-num
     1816                  AND buf_user-menu-group.user-id              = p-user-id
     1817                  and buf_user-menu-group.menu-group-code      = br_tt-menu-group.menu-group-code
     1818                  AND buf_user-menu-group.menu-group-context   = buf_tt-work-place.context
     1819                  AND buf_user-menu-group.menu-group-context   = 'object':U
     1820                  AND buf_user-menu-group.obj-type             = buf_tt-work-place.wp-type
     1821                  AND buf_user-menu-group.obj-code             = buf_tt-work-place.wp-code)
     1822               no-lock
     1823               no-error
     1824               .
     1825               IF NOT AVAILABLE buf_user-menu-group THEN DO:
