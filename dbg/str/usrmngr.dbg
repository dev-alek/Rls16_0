     1749            assign
     1750               v-ok = FALSE
     1751            .
     1752   define variable vss-include-info10 as character format "X(65)" no-undo
     1753   initial "@(#)$Workfile$ $Revision$".
     1754   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chkmngr in g#library2
     1755     (input  br_tt-menu-group.menu-group-id
