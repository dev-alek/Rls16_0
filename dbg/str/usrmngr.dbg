      157   define temp-table temp_twowin_items no-undo
      158       field itm-key       as integer
      159       field itmExtKey     as character
      160       field itmName       as character
      161       field itmDesc       as character
      162       field itmSelected   as logical
      163       field selLeft       as logical
      164       field selRight      as logical
      165       index pi is primary unique
      166           itm-key
      167       index ie
      168           itmExtKey
      169   .
      170   define temp-table temp_twowin_itemsSelected no-undo
      171       field its-key   as integer
      172       field itm-key   as integer
      173       field itmExtKey as character
      174       index pi is primary unique
      175           its-key
      176       index im
      177           itm-key
      178   .
      179   define variable v-twowin1-itm-key    as integer      no-undo.
      180   procedure twowin_clear :
      181       define buffer buf_temp_twowin_items        for temp_twowin_items.
      182   do
      183   for buf_temp_twowin_items
      184   on error undo, return error
      185   :
      186       empty temp-table buf_temp_twowin_items.
      187   end.
      188   end procedure.
      189   procedure twowin_add-item :
      190   define input parameter p-ext-key   as character        no-undo.
      191   define input parameter p-item-name as character        no-undo.
      192   define input parameter p-item-desc as character        no-undo.
      193   define input parameter p-selected  as logical          no-undo.
      194       define buffer buf_temp_twowin_items        for temp_twowin_items.
      195   do
      196   for buf_temp_twowin_items
      197   on error undo, return error
      198   :
      199       assign
      200           v-twowin1-itm-key = v-twowin1-itm-key + 1
      201       .
      202       create temp_twowin_items.
      203       assign
      204           temp_twowin_items.itm-key      = v-twowin1-itm-key
      205           temp_twowin_items.itmExtKey    = p-ext-key
      206           temp_twowin_items.itmName      = p-item-name
      207           temp_twowin_items.itmDesc      = p-item-desc
      208           temp_twowin_items.itmSelected  = p-selected
      209           temp_twowin_items.selLeft      = no
      210           temp_twowin_items.selRight     = no
      211       .
      212   end.
      213   end procedure.
      214   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
