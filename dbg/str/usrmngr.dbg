      266     ( BUFFER buf_user-menu-group FOR user-menu-group )  FORWARD.
      267   DEFINE BUTTON b-chg-menu
      268        LABEL "&Изменить"
      269        SIZE 10 BY 1.
      270   DEFINE BUTTON b-desel
      271        LABEL "Снять все"
      272        SIZE 11 BY 1 TOOLTIP "Снять выделение со всех фирм и объектов".
      273   DEFINE BUTTON b-exit AUTO-GO
      274        LABEL "&Выход"
      275        SIZE 10 BY 1
      276        BGCOLOR 8 .
      277   DEFINE BUTTON b-help
      278        LABEL "Помо&щь"
      279        SIZE 10 BY 1
      280        BGCOLOR 8 .
      281   DEFINE BUTTON b-mark
      282        LABEL "&*"
      283        SIZE 3 BY 1.
      284   DEFINE BUTTON b-sel-all
      285        LABEL "Выделить все"
      286        SIZE 14 BY 1 TOOLTIP "Выделить все фирмы и объекты".
      287   DEFINE QUERY BROWSE-menu FOR
      288         br_tt-menu-group SCROLLING.
      289   DEFINE QUERY BROWSE-WP FOR
      290         br_tt-work-place SCROLLING.
      291   DEFINE BROWSE BROWSE-menu
      292     QUERY BROWSE-menu NO-LOCK DISPLAY
      293         br_tt-menu-group.menu-group-name FORMAT "X(32)":U
      294       WITH NO-ROW-MARKERS SEPARATORS SIZE 35.5 BY 16.25 FIT-LAST-COLUMN.
      295   DEFINE BROWSE BROWSE-WP
      296     QUERY BROWSE-WP DISPLAY
      297         br_tt-work-place.wp-code
      298           br_tt-work-place.wp-type
      299           br_tt-work-place.wp-name
      300       WITH NO-ROW-MARKERS SEPARATORS SIZE 60 BY 16.17 ROW-HEIGHT-CHARS .83 FIT-LAST-COLUMN.
      301   DEFINE FRAME Dialog-Frame
      302        b-exit AT ROW 1 COL 2
      303        b-mark AT ROW 1 COL 12 WIDGET-ID 8
      304        b-chg-menu AT ROW 1 COL 12 WIDGET-ID 28
      305        b-sel-all AT ROW 1 COL 15 WIDGET-ID 26
      306        b-desel AT ROW 1 COL 29 WIDGET-ID 30
      307        b-help AT ROW 1 COL 88
      308        BROWSE-menu AT ROW 2.25 COL 2 WIDGET-ID 400
      309        BROWSE-WP AT ROW 2.25 COL 38 WIDGET-ID 300
      310        SPACE(0.37) SKIP(0.36)
      311       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      312            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      313            TITLE "Группы меню для пользователя"
      314            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      315   ASSIGN
      316          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      317          FRAME Dialog-Frame:HIDDEN           = TRUE.
      318   ASSIGN
      319          b-desel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      320   ASSIGN
      321          b-mark:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      322   ASSIGN
      323          b-sel-all:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      324   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      325   DO:
      326     APPLY "END-ERROR":U TO SELF.
      327   END.
      328   ON CHOOSE OF b-chg-menu IN FRAME Dialog-Frame
      329   DO:
      330      IF AVAILABLE br_tt-menu-group
      331      then do:
      332         run change-menu-2 in this-procedure .
      333         RUN refresh-query-wp IN THIS-PROCEDURE.
      334      end.
      335   END.
      336   ON CHOOSE OF b-desel IN FRAME Dialog-Frame
      337   DO:
      338      FOR EACH br_tt-menu-group
      339      ON ERROR UNDO, NEXT
      340      :
      341         assign
      342            br_tt-menu-group.selected = NO
      343         .
      344      END.
      345      run enable_UI in this-procedure .
      346      run post_enable_UI in this-procedure .
      347      RUN refresh-query-menu IN THIS-PROCEDURE .
      348   END.
      349   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      350   DO
      351   :
      352      DEFINE VARIABLE v-log AS LOGICAL NO-UNDO .
      353      IF  AVAILABLE br_tt-work-place
      354      THEN DO
      355      ON ERROR UNDO, RETURN NO-APPLY
      356      :
      357         assign
      358            br_tt-menu-group.selected = NOT br_tt-menu-group.selected
      359         .
      360         v-log = BROWSE-menu:refresh() IN FRAME Dialog-Frame.
      361         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
      362         then do:
      363           v-log = BROWSE-menu:select-next-row ().
      364           apply "iteration-changed" to BROWSE-menu in frame Dialog-Frame.
      365         end.
      366      END.
      367   END.
      368   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
      369   DO:
      370      FOR EACH br_tt-menu-group
      371      ON ERROR UNDO, NEXT
      372      :
      373         assign
      374            br_tt-menu-group.selected = YES
      375         .
      376      END.
      377      run enable_UI in this-procedure .
      378      run post_enable_UI in this-procedure .
      379   END.
      380   ON VALUE-CHANGED OF BROWSE-menu IN FRAME Dialog-Frame
      381   DO:
      382      IF  AVAILABLE br_tt-menu-group
      383      then do:
      384         RUN refresh-query-wp IN THIS-PROCEDURE.
      385      end.
      386   END.
      387   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      388   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      389   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   on help of frame Dialog-Frame
      391   do:
      392     run gbl/app_help.p
      393       (input this-procedure :file-name
      394       ,input ''
      395       ,input ?
      396       ) no-error.
      397     if error-status :error then do:
      398       message
      399         "Ошибка при вызове помощи"
      400         error-status :get-message(1)
      401         view-as alert-box .
      402     end.
      403   end.
      404   run minbtn-set in this-procedure .
      405   on choose of b-help in frame Dialog-Frame
      406   do:
      407     apply "help":u to frame Dialog-Frame .
      408   end.
      409   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      410   procedure minbtn-set :
      411       do
      412           on error undo, return error return-value
      413           :
      414           define variable ii              as integer       no-undo .
      415           define variable fh              as widget-handle no-undo .
      416           define variable hh              as widget-handle no-undo .
      417           define variable v-h             as handle        extent 4 no-undo .
      418           define variable v-name-button   as character     no-undo .
      419           define variable v-help-old-x    as decimal       no-undo .
      420           define variable v-help-old-y    as decimal       no-undo .
      421           define variable v-help-old-size as decimal       no-undo .
      422           define variable v-frame-width   as decimal       no-undo .
      423           define variable jj              as integer       no-undo .
      424           do
      425               on error undo, return error
      426               :
      427               assign
      428                   v-frame-width = frame Dialog-Frame:width - 0.3
      429                   fh            = frame Dialog-Frame:first-child
      430                   hh            = fh:first-child
      431                   ii            = 1
      432                   .
      433               do while valid-handle(hh):
      434                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      435                   do:
      436                       case lc(hh:name) :
      437                           when "b-help" then
      438                               do:
      439                                   hh:load-image-up("cmp/b-help.bmp":u) .
      440                                   hh:load-image-down("cmp/b-help.bmp":u) .
      441                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      442                                   hh:TOOLTIP = "Помощь" .
      443                                   v-help-old-x = hh:column .
      444                                   v-help-old-y = hh:row    .
      445                                   v-help-old-size = hh:width .
      446                                   hh:width-chars = 2.5 .
      447                               end.
      448                           when "b-print" then
      449                               do:
      450                                   hh:load-image("cmp/b-print.bmp":u) .
      451                                   hh:TOOLTIP = "Печать" .
      452                                   v-h[ii] = hh:handle .
      453                                   ii = ii + 1 .
      454                                   hh:width-chars = 3 .
      455                               end.
      456                           when "b-history" or
      457                           when "b-hist" then
      458                               do:
      459                                   hh:load-image("cmp/b-hist.bmp":u) .
      460                                   hh:TOOLTIP = "История" .
      461                                   v-h[ii] = hh:handle .
      462                                   ii = ii + 1 .
      463                                   hh:width-chars = 3 .
      464                               end.
      465                           when "b-sch" then
      466                               do:
      467                                   hh:load-image("cmp/b-sch.bmp":u) .
      468                                   hh:TOOLTIP = "Установка Фильтра" .
      469                                   v-h[ii] = hh:handle .
      470                                   ii = ii + 1 .
      471                                   hh:width-chars = 3 .
      472                               end.
      473                           when "b-hist-user" then
      474                               do:
      475                                   hh:load-image("cmp/b-hist.bmp":u) .
      476                                   hh:TOOLTIP = "История пользователя" .
      477                                   ii = ii + 1 .
      478                               end.
      479                       end case.
      480                   end.
      481                   hh = hh:next-sibling.
      482               end.
      483               b-help:column = v-frame-width - b-help:width-chars.
      484               jj = 0.
      485               repeat ii = 4 to 1 by -1 :
      486                   if valid-handle (v-h[ii] ) then
      487                   do:
      488                       jj  = jj + 1 .
      489                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      490                       v-h[ii]:row    = v-help-old-y .
      491                   end.
      492               end.
      493           end.
      494       end.
      495   end procedure.
      496   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      497   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      498   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      499   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      500   define variable v-diasize-current-frame-width  as decimal   no-undo .
      501   define variable v-diasize-current-frame-height as decimal   no-undo .
      502   define variable v-diasize-change-size          as logical   no-undo .
      503   define variable v-diasize-resize-button        as handle    no-undo .
      504   define variable v-diasize-wndmax               as logical   no-undo .
      505   define variable v-diasize-wndstore             as logical   no-undo .
      506   define variable v-diasize-proc-name            as character no-undo .
      507   define variable v-diasize-browse-handle        as handle    no-undo .
      508   define variable v-diasize-browse-number        as integer   no-undo .
      509   define variable v-diasize-need-full-display    as logical   no-undo init false .
      510   define temp-table temp-diasize-handle no-undo
      511     field handle-value  as handle
      512     field save-position as decimal
      513     index xpk is primary unique handle-value
      514     .
      515   define temp-table temp-browse-handle no-undo
      516     field browse-type   as character
      517     field browse-number as integer
      518     field browse-handle as handle
      519     field original-size as decimal
      520     index xpk is primary unique browse-type browse-number
      521     index xie browse-type browse-handle
      522   .
      523   procedure diasize_change-height :
      524     define input  parameter p-change-value  as decimal   no-undo .
      525     define input  parameter p-move-resize   as logical   no-undo .
      526     define variable v-field-group-handle    as handle    no-undo .
      527     define variable v-object-handle         as handle    no-undo .
      528     define variable v-frame-height          as decimal   no-undo .
      529     define variable v-frame-virtual-height  as decimal   no-undo .
      530     define variable v-browse-height         as decimal   no-undo .
      531     define variable v-window-height         as decimal   no-undo .
      532     define variable v-window-virtual-height as decimal   no-undo .
      533     define variable v-change-sign           as integer   no-undo .
      534     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      535     define buffer buf_temp-browse-handle  for temp-browse-handle .
      536     if p-change-value > 0
      537     then do:
      538       if frame Dialog-Frame :height + p-change-value
      539           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      540       then do:
      541         assign
      542           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      543                           - (frame Dialog-Frame :height-chars)
      544         .
      545         if p-change-value <= 0
      546         then do:
      547           run diasize_position-resize-button in this-procedure .
      548           return .
      549         end.
      550       end.
      551     end.
      552     if p-change-value < 0
      553     then do:
      554       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      555       then do:
      556         assign
      557           p-change-value = v-diasize-orig-frame-height
      558                          - (frame Dialog-Frame :height-chars)
      559         .
      560         if p-change-value >= 0
      561         then do:
      562           run diasize_position-resize-button in this-procedure .
      563           return .
      564         end.
      565       end.
      566     end.
      567     if p-change-value >= 0
      568     then do:
      569       assign
      570         v-change-sign = 1
      571       .
      572     end.
      573     else do:
      574       assign
      575         v-change-sign = -1
      576       .
      577     end.
      578     assign
      579       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      580     .
      581     if p-change-value = 0
      582     then do:
      583       run diasize_position-resize-button in this-procedure .
      584       return .
      585     end.
      586     move_block:
      587     do
      588     on error undo move_block, retry move_block
      589     :
      590       if retry
      591       then do:
      592         do
      593         on error undo move_block, leave move_block
      594         :
      595           if p-change-value > 0
      596           then do:
      597             for each buf_temp-diasize-handle
      598             on error undo, next
      599             :
      600               assign
      601                 v-object-handle = buf_temp-diasize-handle.handle-value
      602               .
      603               if v-object-handle <> v-diasize-resize-button
      604               then do:
      605                 assign
      606                   v-object-handle :row = buf_temp-diasize-handle.save-position
      607                 .
      608               end.
      609             end.
      610             assign
      611               v-diasize-browse-handle :height = v-browse-height
      612             .
      613             for each buf_temp-browse-handle
      614               where buf_temp-browse-handle.browse-type = 'height':u
      615             on error undo, next
      616             :
      617               assign
      618                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      619               .
      620             end.
      621             assign
      622               frame Dialog-Frame :height = v-frame-height
      623             .
      624             if frame Dialog-Frame :scrollable = true
      625             then do:
      626               assign
      627                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      628               .
      629             end.
      630             run diasize_position-resize-button in this-procedure .
      631           end.
      632           else do:
      633             if frame Dialog-Frame :scrollable = true
      634             then do:
      635               assign
      636                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      637               .
      638             end.
      639             assign
      640               frame Dialog-Frame :height = v-frame-height
      641             .
      642             assign
      643               v-diasize-browse-handle :height = v-browse-height
      644             .
      645             for each buf_temp-browse-handle
      646               where buf_temp-browse-handle.browse-type = 'height':u
      647             on error undo, next
      648             :
      649               assign
      650                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      651               .
      652             end.
      653             for each buf_temp-diasize-handle
      654             on error undo, next
      655             :
      656               assign
      657                 v-object-handle = buf_temp-diasize-handle.handle-value
      658               .
      659               if v-object-handle <> v-diasize-resize-button
      660               then do:
      661                 assign
      662                   v-object-handle :row = buf_temp-diasize-handle.save-position
      663                 .
      664               end.
      665             end.
      666             run diasize_position-resize-button in this-procedure .
      667           end.
      668           assign
      669             v-diasize-change-size = false
      670           .
      671           leave move_block .
      672         end.
      673       end.
      674       assign
      675         v-diasize-need-full-display = true
      676       .
      677       if v-diasize-change-size = false
      678       then do:
      679         assign
      680           v-diasize-change-size = true
      681         .
      682       end.
      683       else do:
      684         return .
      685       end.
      686       assign
      687         v-frame-height = frame Dialog-Frame :height
      688         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      689         v-browse-height = v-diasize-browse-handle :height
      690       .
      691       for each buf_temp-browse-handle
      692         where buf_temp-browse-handle.browse-type = 'height':u
      693       :
      694         assign
      695           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      696         .
      697       end.
      698       for each buf_temp-diasize-handle
      699       :
      700         delete buf_temp-diasize-handle .
      701       end.
      702       assign
      703         v-field-group-handle = frame Dialog-Frame :first-child
      704       .
      705       do while valid-handle(v-field-group-handle)
      706       :
      707         assign
      708           v-object-handle = v-field-group-handle :first-child
      709         .
      710         do while valid-handle(v-object-handle)
      711         :
      712           if  v-object-handle <> v-diasize-browse-handle :handle
      713           and can-query(v-object-handle, "row")
      714           and can-query(v-object-handle, "height")
      715           and ( v-object-handle :row > v-diasize-browse-handle :row )
      716           then do:
      717             find first buf_temp-browse-handle
      718               where buf_temp-browse-handle.browse-type   = 'height':u
      719                 and buf_temp-browse-handle.browse-handle = v-object-handle
      720               no-error .
      721             if available buf_temp-browse-handle
      722             then do:
      723             end.
      724             else do:
      725               create buf_temp-diasize-handle .
      726               assign
      727                 buf_temp-diasize-handle.handle-value  = v-object-handle
      728                 buf_temp-diasize-handle.save-position = v-object-handle :row
      729               .
      730             end.
      731           end.
      732           assign
      733             v-object-handle = v-object-handle :next-sibling
      734           .
      735         end.
      736         assign
      737           v-field-group-handle = v-field-group-handle :next-sibling
      738         .
      739       end.
      740       do with frame Dialog-Frame
      741       :
      742         hide v-diasize-resize-button .
      743         assign
      744           v-diasize-resize-button :row    = 1
      745           v-diasize-resize-button :column = 1
      746         .
      747       end.
      748       if p-change-value > 0
      749       then do:
      750         if frame Dialog-Frame :scrollable = true
      751         then do:
      752           assign
      753             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      754             no-error .
      755           if error-status :error
      756           or error-status :get-message(1) <> ""
      757           then do:
      758             undo move_block, retry move_block .
      759           end.
      760         end.
      761         assign
      762           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      763           no-error .
      764         if error-status :error
      765         or error-status :get-message(1) <> ""
      766         then do:
      767           undo move_block, retry move_block .
      768         end.
      769         assign
      770           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      771           no-error .
      772         if error-status :error
      773         or error-status :get-message(1) <> ""
      774         then do:
      775           undo move_block, retry move_block .
      776         end.
      777         for each buf_temp-browse-handle
      778           where buf_temp-browse-handle.browse-type = 'height':u
      779         on error undo move_block, retry move_block
      780         :
      781           assign
      782             buf_temp-browse-handle.browse-handle :height
      783               = buf_temp-browse-handle.browse-handle :height + p-change-value
      784             no-error .
      785           if error-status :error
      786           or error-status :get-message(1) <> ""
      787           then do:
      788             undo move_block, retry move_block .
      789           end.
      790         end.
      791         for each buf_temp-diasize-handle
      792         on error undo move_block, retry move_block
      793         :
      794           assign
      795             v-object-handle = buf_temp-diasize-handle.handle-value
      796           .
      797           if v-object-handle <> v-diasize-resize-button
      798           then do:
      799             assign
      800               v-object-handle :row = v-object-handle :row + p-change-value
      801               no-error .
      802             if error-status :error
      803             or error-status :get-message(1) <> ""
      804             then do:
      805               undo move_block, retry move_block .
      806             end.
      807           end.
      808         end.
      809       end.
      810       else do:
      811         for each buf_temp-diasize-handle
      812         on error undo move_block, retry move_block
      813         :
      814           assign
      815             v-object-handle = buf_temp-diasize-handle.handle-value
      816           .
      817           if v-object-handle <> v-diasize-resize-button
      818           then do:
      819             assign
      820               v-object-handle :row = v-object-handle :row + p-change-value
      821               no-error .
      822             if error-status :error
      823             or error-status :get-message(1) <> ""
      824             then do:
      825               undo move_block, retry move_block .
      826             end.
      827           end.
      828         end.
      829         assign
      830           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      831           no-error .
      832         if error-status :error
      833         or error-status :get-message(1) <> ""
      834         then do:
      835           undo move_block, retry move_block .
      836         end.
      837         for each buf_temp-browse-handle
      838           where buf_temp-browse-handle.browse-type = 'height':u
      839         on error undo move_block, retry move_block
      840         :
      841           assign
      842             buf_temp-browse-handle.browse-handle :height
      843               = buf_temp-browse-handle.browse-handle :height + p-change-value
      844             no-error .
      845           if error-status :error
      846           or error-status :get-message(1) <> ""
      847           then do:
      848             undo move_block, retry move_block .
      849           end.
      850         end.
      851         assign
      852           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      853           no-error .
      854         if error-status :error
      855         or error-status :get-message(1) <> ""
      856         then do:
      857           undo move_block, retry move_block .
      858         end.
      859         if frame Dialog-Frame :scrollable = true
      860         then do:
      861           assign
      862             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      863             no-error .
      864           if error-status :error
      865           or error-status :get-message(1) <> ""
      866           then do:
      867             undo move_block, retry move_block .
      868           end.
      869         end.
      870       end.
      871       if p-move-resize = true
      872       then do:
      873         run diasize_position-resize-button in this-procedure .
      874       end.
      875       if v-diasize-wndstore = true
      876       then do:
      877         if connected("ub") = true
      878         then do:
      879           define variable v-cntxt-db-num        as integer   no-undo .
      880           define variable v-cntxt-userid        as character no-undo .
      881           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      882                                             , OUTPUT v-cntxt-userid
      883                                             ) .
      884           run gbl/wndsizew.p
      885             (input  v-cntxt-db-num
      886             ,input  v-cntxt-userid
      887             ,input  v-diasize-proc-name
      888             ,input  'height':u
      889             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      890             ) .
      891         end.
      892       end.
      893     end.
      894     assign
      895       v-diasize-change-size = false
      896     .
      897   end procedure.
      898   procedure diasize_set-height :
      899     define input  parameter p-new-height  as decimal   no-undo .
      900     define input  parameter p-move-resize as logical   no-undo .
      901     do
      902     on error undo, return error return-value
      903     :
      904       run diasize_change-height in this-procedure
      905         (input  (p-new-height - frame Dialog-Frame :height)
      906         ,input  p-move-resize
      907         ) .
      908     end.
      909   end procedure.
      910   procedure diasize_change-width :
      911     define input  parameter p-change-value as decimal   no-undo .
      912     define input  parameter p-move-resize  as logical   no-undo .
      913     define variable v-field-group-handle   as handle    no-undo .
      914     define variable v-object-handle        as handle    no-undo .
      915     define variable v-frame-width          as decimal   no-undo .
      916     define variable v-frame-virtual-width  as decimal   no-undo .
      917     define variable v-browse-width         as decimal   no-undo .
      918     define variable v-window-width         as decimal   no-undo .
      919     define variable v-window-virtual-width as decimal   no-undo .
      920     define variable v-change-sign          as integer   no-undo .
      921     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      922     define buffer buf_temp-browse-handle  for temp-browse-handle .
      923     if p-change-value > 0
      924     then do:
      925       if frame Dialog-Frame :width + p-change-value >
      926           session :width-chars
      927       then do:
      928         assign
      929           p-change-value = session :width-chars - frame Dialog-Frame :width
      930         .
      931         if p-change-value <= 0
      932         then do:
      933           run diasize_position-resize-button in this-procedure .
      934           return .
      935         end.
      936       end.
      937     end.
      938     if p-change-value < 0
      939     then do:
      940       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      941       then do:
      942         assign
      943           p-change-value = v-diasize-orig-frame-width
      944                          - frame Dialog-Frame :width
      945         .
      946         if p-change-value >= 0
      947         then do:
      948           run diasize_position-resize-button in this-procedure .
      949           return .
      950         end.
      951       end.
      952     end.
      953     if p-change-value >= 0
      954     then do:
      955       assign
      956         v-change-sign = 1
      957       .
      958     end.
      959     else do:
      960       assign
      961         v-change-sign = -1
      962       .
      963     end.
      964     assign
      965       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      966     .
      967     if p-change-value = 0
      968     then do:
      969       run diasize_position-resize-button in this-procedure .
      970       return .
      971     end.
      972     move_block:
      973     do
      974     on error undo move_block, leave move_block
      975     :
      976       if retry
      977       then do:
      978         do
      979         on error undo move_block, leave move_block
      980         :
      981           if p-change-value > 0
      982           then do:
      983             for each buf_temp-diasize-handle
      984             on error undo, next
      985             :
      986               assign
      987                 v-object-handle = buf_temp-diasize-handle.handle-value
      988               .
      989               if v-object-handle <> v-diasize-resize-button
      990               then do:
      991                 assign
      992                   v-object-handle :col = buf_temp-diasize-handle.save-position
      993                 .
      994               end.
      995             end.
      996             assign
      997               v-diasize-browse-handle :width = v-browse-width
      998             .
      999             for each buf_temp-browse-handle
     1000               where buf_temp-browse-handle.browse-type = 'width':u
     1001             on error undo, next
     1002             :
     1003               assign
     1004                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1005               .
     1006             end.
     1007             assign
     1008               frame Dialog-Frame :width = v-frame-width
     1009             .
     1010             if frame Dialog-Frame :scrollable = true
     1011             then do:
     1012               assign
     1013                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1014               .
     1015             end.
     1016             run diasize_position-resize-button in this-procedure .
     1017           end.
     1018           else do:
     1019             if frame Dialog-Frame :scrollable = true
     1020             then do:
     1021               assign
     1022                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1023               .
     1024             end.
     1025             assign
     1026               frame Dialog-Frame :width = v-frame-width
     1027             .
     1028             for each buf_temp-browse-handle
     1029               where buf_temp-browse-handle.browse-type = 'width':u
     1030             on error undo, next
     1031             :
     1032               assign
     1033                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1034               .
     1035             end.
     1036             assign
     1037               v-diasize-browse-handle :width = v-browse-width
     1038             .
     1039             for each buf_temp-diasize-handle
     1040             on error undo, next
     1041             :
     1042               assign
     1043                 v-object-handle = buf_temp-diasize-handle.handle-value
     1044               .
     1045               if v-object-handle <> v-diasize-resize-button
     1046               then do:
     1047                 assign
     1048                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1049                 .
     1050               end.
     1051             end.
     1052             run diasize_position-resize-button in this-procedure .
     1053           end.
     1054           assign
     1055             v-diasize-change-size = false
     1056           .
     1057           leave move_block .
     1058         end.
     1059       end.
     1060       assign
     1061         v-diasize-need-full-display = true
     1062       .
     1063       if v-diasize-change-size = false
     1064       then do:
     1065         assign
     1066           v-diasize-change-size = true
     1067         .
     1068       end.
     1069       else do:
     1070         return .
     1071       end.
     1072       assign
     1073         v-frame-width = frame Dialog-Frame :width
     1074         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1075         v-browse-width = v-diasize-browse-handle :width
     1076       .
     1077       for each buf_temp-browse-handle
     1078         where buf_temp-browse-handle.browse-type = 'width':u
     1079       :
     1080         assign
     1081           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1082         .
     1083       end.
     1084       for each buf_temp-diasize-handle
     1085       :
     1086         delete buf_temp-diasize-handle .
     1087       end.
     1088       assign
     1089         v-field-group-handle = frame Dialog-Frame :first-child
     1090       .
     1091       do while valid-handle(v-field-group-handle)
     1092       :
     1093         assign
     1094           v-object-handle = v-field-group-handle :first-child
     1095         .
     1096         do while valid-handle(v-object-handle)
     1097         :
     1098           if  v-object-handle <> v-diasize-browse-handle :handle
     1099           and v-object-handle <> v-diasize-resize-button
     1100           and can-query(v-object-handle, "row")
     1101           and can-query(v-object-handle, "height")
     1102           and ( v-object-handle :col + v-object-handle :width
     1103                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1104               )
     1105           then do:
     1106             find first buf_temp-browse-handle
     1107               where buf_temp-browse-handle.browse-type   = 'width':u
     1108                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1109               no-error .
     1110             if available buf_temp-browse-handle
     1111             then do:
     1112             end.
     1113             else do:
     1114               create buf_temp-diasize-handle .
     1115               assign
     1116                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1117                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1118               .
     1119             end.
     1120           end.
     1121           assign
     1122             v-object-handle = v-object-handle :next-sibling
     1123           .
     1124         end.
     1125         assign
     1126           v-field-group-handle = v-field-group-handle :next-sibling
     1127         .
     1128       end.
     1129       do with frame Dialog-Frame
     1130       :
     1131         hide v-diasize-resize-button .
     1132         v-diasize-resize-button :row = 1.
     1133         v-diasize-resize-button :column = 1.
     1134       end.
     1135       if p-change-value > 0
     1136       then do:
     1137         if frame Dialog-Frame :scrollable = true
     1138         then do:
     1139           assign
     1140             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1141             no-error .
     1142           if error-status :error
     1143           or error-status :get-message(1) <> ""
     1144           then do:
     1145             undo move_block, retry move_block.
     1146           end.
     1147         end.
     1148         assign
     1149           frame Dialog-Frame :width = v-frame-width + p-change-value
     1150           no-error .
     1151         if error-status :error
     1152         or error-status :get-message(1) <> ""
     1153         then do:
     1154           undo move_block, retry move_block.
     1155         end.
     1156         assign
     1157           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1158         no-error .
     1159         if error-status :error
     1160         or error-status :get-message(1) <> ""
     1161         then do:
     1162           undo move_block, retry move_block.
     1163         end.
     1164         for each buf_temp-browse-handle
     1165           where buf_temp-browse-handle.browse-type = 'width':u
     1166         on error undo move_block, retry move_block
     1167         :
     1168           assign
     1169             buf_temp-browse-handle.browse-handle :width
     1170               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1171             no-error .
     1172           if error-status :error
     1173           or error-status :get-message(1) <> ""
     1174           then do:
     1175             undo move_block, retry move_block .
     1176           end.
     1177         end.
     1178         for each buf_temp-diasize-handle
     1179         on error undo move_block, retry move_block
     1180         :
     1181           assign
     1182             v-object-handle = buf_temp-diasize-handle.handle-value
     1183           .
     1184           if v-object-handle <> v-diasize-resize-button
     1185           then do:
     1186             assign
     1187               v-object-handle :col = v-object-handle :col + p-change-value
     1188               no-error .
     1189             if error-status :error
     1190             or error-status :get-message(1) <> ""
     1191             then do:
     1192               undo move_block, retry move_block .
     1193             end.
     1194           end.
     1195         end.
     1196       end.
     1197       else do:
     1198         for each buf_temp-diasize-handle
     1199         on error undo move_block, retry move_block
     1200         :
     1201           assign
     1202             v-object-handle = buf_temp-diasize-handle.handle-value
     1203           .
     1204           if v-object-handle <> v-diasize-resize-button
     1205           then do:
     1206             assign
     1207               v-object-handle :col = v-object-handle :col + p-change-value
     1208               no-error .
     1209             if error-status :error
     1210             or error-status :get-message(1) <> ""
     1211             then do:
     1212               undo move_block, retry move_block .
     1213             end.
     1214           end.
     1215         end.
     1216         for each buf_temp-browse-handle
     1217           where buf_temp-browse-handle.browse-type = 'width':u
     1218         on error undo move_block, retry move_block
     1219         :
     1220           assign
     1221             buf_temp-browse-handle.browse-handle :width
     1222               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1223             no-error .
     1224           if error-status :error
     1225           or error-status :get-message(1) <> ""
     1226           then do:
     1227             undo move_block, retry move_block .
     1228           end.
     1229         end.
     1230         assign
     1231           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1232           no-error .
     1233         if error-status :error
     1234         or error-status :get-message(1) <> ""
     1235         then do:
     1236           undo move_block, retry move_block.
     1237         end.
     1238         assign
     1239           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1240         no-error .
     1241         if error-status :error
     1242         or error-status :get-message(1) <> ""
     1243         then do:
     1244           undo move_block, retry move_block.
     1245         end.
     1246         if frame Dialog-Frame :scrollable = true
     1247         then do:
     1248           assign
     1249             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1250           no-error .
     1251           if error-status :error
     1252           or error-status :get-message(1) <> ""
     1253           then do:
     1254             undo move_block, retry move_block.
     1255           end.
     1256         end.
     1257       end.
     1258       if p-move-resize
     1259       then do:
     1260         run diasize_position-resize-button in this-procedure .
     1261       end.
     1262       if v-diasize-wndstore = true
     1263       then do:
     1264         if connected("ub") = true
     1265         then do:
     1266           define variable v-cntxt-db-num        as integer   no-undo .
     1267           define variable v-cntxt-userid        as character no-undo .
     1268           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1269                                             , OUTPUT v-cntxt-userid
     1270                                             ) .
     1271           run gbl/wndsizew.p
     1272             (input  v-cntxt-db-num
     1273             ,input  v-cntxt-userid
     1274             ,input  v-diasize-proc-name
     1275             ,input  'width':u
     1276             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1277             ) .
     1278         end.
     1279       end.
     1280     end.
     1281     assign
     1282       v-diasize-change-size = false
     1283     .
     1284   end procedure.
     1285   procedure diasize_set-width :
     1286     define input  parameter p-new-width  as decimal   no-undo .
     1287     define input  parameter p-move-resize as logical   no-undo .
     1288     do
     1289     on error undo, return error return-value
     1290     :
     1291       run diasize_change-width in this-procedure
     1292         (input  (p-new-width - frame Dialog-Frame :width)
     1293         ,input  p-move-resize
     1294         ) .
     1295     end.
     1296   end procedure.
     1297   procedure diasize_position-resize-button :
     1298     do with frame Dialog-Frame
     1299     :
     1300       hide v-diasize-resize-button .
     1301       assign
     1302         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1303                     - 1
     1304                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1305         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1306                     - 1
     1307                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1308       .
     1309       view v-diasize-resize-button .
     1310     end.
     1311   end procedure.
     1312   on alt-right anywhere
     1313   do:
     1314     run diasize_change-width in this-procedure
     1315       (input 1
     1316       ,input true
     1317       ) .
     1318     return no-apply .
     1319   end.
     1320   on alt-left anywhere
     1321   do:
     1322     run diasize_change-width in this-procedure
     1323       (input -1
     1324       ,input true
     1325       ) .
     1326     return no-apply .
     1327   end.
     1328   on alt-down anywhere
     1329   do:
     1330     run diasize_change-height in this-procedure
     1331       (input 1
     1332       ,input true
     1333       ) .
     1334     return no-apply .
     1335   end.
     1336   on alt-up anywhere
     1337   do:
     1338     run diasize_change-height in this-procedure
     1339       (input -1
     1340       ,input true
     1341       ) .
     1342     return no-apply .
     1343   end.
     1344   on alt-enter of frame Dialog-Frame
     1345   do:
     1346     run diasize_maximize in this-procedure
     1347       (input  ?
     1348       ).
     1349     return no-apply .
     1350   end.
     1351   procedure diasize_end-move :
     1352     do
     1353     on error undo, return error return-value
     1354     :
     1355       define variable v-row-delta as decimal   no-undo .
     1356       define variable v-col-delta as decimal   no-undo .
     1357       define variable v-new-row as decimal   no-undo .
     1358       define variable v-new-col as decimal   no-undo .
     1359       assign
     1360         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1361         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1362       .
     1363       assign
     1364         v-row-delta = v-new-row - frame Dialog-Frame :height
     1365         v-col-delta = v-new-col - frame Dialog-Frame :width
     1366       .
     1367       run diasize_change-height in this-procedure
     1368         (input v-row-delta
     1369         ,input true
     1370         ) .
     1371       run diasize_change-width in this-procedure
     1372         (input v-col-delta
     1373         ,input true
     1374         ) .
     1375     end.
     1376   end procedure.
     1377   procedure diasize_maximize :
     1378     define input  parameter p-action as logical   no-undo .
     1379     do
     1380     on error undo, return error return-value
     1381     :
     1382       if p-action = ?
     1383       then do:
     1384         if v-diasize-need-maximize = true
     1385         then do:
     1386           assign
     1387             p-action = true
     1388           .
     1389         end.
     1390         else do:
     1391           assign
     1392             p-action = false
     1393           .
     1394         end.
     1395       end.
     1396       if p-action = true
     1397       then do:
     1398         run diasize_change-height in this-procedure
     1399           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1400               - frame Dialog-Frame :height-chars
     1401           ,input true
     1402           ) .
     1403         run diasize_change-width in this-procedure
     1404           (input session :width-chars
     1405               - frame Dialog-Frame :width-chars
     1406           ,input true
     1407           ) .
     1408         assign
     1409           v-diasize-need-maximize = false
     1410         .
     1411       end.
     1412       else do:
     1413         run diasize_change-width in this-procedure
     1414           (input v-diasize-orig-frame-width
     1415               - frame Dialog-Frame :width-chars
     1416           ,input true
     1417           ) .
     1418         run diasize_change-height in this-procedure
     1419           (input v-diasize-orig-frame-height
     1420               - frame Dialog-Frame :height-chars
     1421           ,input true
     1422           ) .
     1423         assign
     1424           v-diasize-need-maximize = true
     1425         .
     1426       end.
     1427     end.
     1428   end procedure.
     1429   procedure diasize_restore-orig-size :
     1430     do
     1431     on error undo, return error return-value
     1432     :
     1433       assign
     1434         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1435         v-diasize-current-frame-height = frame Dialog-Frame :height
     1436       .
     1437       run diasize_set-height in this-procedure
     1438         (input  v-diasize-orig-frame-height
     1439         ,input  true
     1440         ) .
     1441       run diasize_set-width in this-procedure
     1442         (input  v-diasize-orig-frame-width
     1443         ,input  true
     1444         ) .
     1445     end.
     1446   end procedure.
     1447   procedure diasize_restore-current-size :
     1448     do
     1449     on error undo, return error return-value
     1450     :
     1451       run diasize_set-height in this-procedure
     1452         (input  v-diasize-current-frame-height
     1453         ,input  true
     1454         ) .
     1455       run diasize_set-width in this-procedure
     1456         (input  v-diasize-current-frame-width
     1457         ,input  true
     1458         ) .
     1459     end.
     1460   end procedure.
     1461   procedure diasize_set-browse-handle :
     1462     define input  parameter p-browse-handle as handle   no-undo .
     1463     define buffer buf_temp-browse-handle for temp-browse-handle .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       assign
     1468         v-diasize-browse-handle = p-browse-handle
     1469       .
     1470       for each buf_temp-browse-handle
     1471       on error undo, return error return-value
     1472       :
     1473         delete buf_temp-browse-handle .
     1474       end.
     1475     end.
     1476   end procedure.
     1477   procedure diasize_add_browse :
     1478     define input  parameter p-browse-type   as character no-undo .
     1479     define input  parameter p-browse-handle as handle    no-undo .
     1480     define buffer buf_temp-browse-handle for temp-browse-handle .
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       assign
     1485         v-diasize-browse-number = v-diasize-browse-number + 1
     1486       .
     1487       create buf_temp-browse-handle .
     1488       assign
     1489         buf_temp-browse-handle.browse-type   = p-browse-type
     1490         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1491         buf_temp-browse-handle.browse-handle = p-browse-handle
     1492       .
     1493     end.
     1494   end procedure.
     1495   procedure diasize_init :
     1496     define variable v-default-value    as logical   no-undo .
     1497     define variable v-restore-saved    as logical   no-undo .
     1498     define variable v-resize-value-str as character no-undo .
     1499     do
     1500     on error undo, return error return-value
     1501     :
     1502       do with frame Dialog-Frame
     1503       :
     1504         assign
     1505           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1506           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1507           v-diasize-browse-handle     = browse BROWSE-menu :handle
     1508         .
     1509         create button v-diasize-resize-button
     1510         assign
     1511           parent        = frame Dialog-Frame :first-child
     1512           label         = "s"
     1513           height-pixels = 16
     1514           width-pixels  = 16
     1515           visible       = true
     1516           sensitive     = true
     1517           movable       = true
     1518           triggers:
     1519             on end-move persistent run diasize_end-move in this-procedure .
     1520           end triggers.
     1521         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1522         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1523         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1524         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1525         assign
     1526           v-diasize-wndmax = false
     1527         .
     1528         if connected("ub") = true
     1529         then do:
     1530           define variable v-cntxt-db-num        as integer   no-undo .
     1531           define variable v-cntxt-userid        as character no-undo .
     1532           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1533                                             , OUTPUT v-cntxt-userid
     1534                                             ) .
     1535           run gbl/wndpar_r.p
     1536             (input  v-cntxt-db-num
     1537             ,input  v-cntxt-userid
     1538             ,input  'wndmax':U
     1539             ,output v-diasize-wndmax
     1540             ,output v-default-value
     1541             ) .
     1542         end.
     1543         assign
     1544           v-diasize-wndstore = false
     1545         .
     1546         if connected("ub") = true
     1547         then do:
     1548           run gbl/wndpar_r.p
     1549             (input  v-cntxt-db-num
     1550             ,input  v-cntxt-userid
     1551             ,input  'wndstore':U
     1552             ,output v-diasize-wndstore
     1553             ,output v-default-value
     1554             ) .
     1555         end.
     1556         assign
     1557           v-diasize-proc-name = entry(1, program-name(2), '.')
     1558         .
     1559         if v-diasize-wndstore = true
     1560         then do:
     1561           assign
     1562             v-restore-saved = false
     1563           .
     1564           if connected("ub") = true
     1565           then do:
     1566             run gbl/wndsizer.p
     1567               (input  v-cntxt-db-num
     1568               ,input  v-cntxt-userid
     1569               ,input  v-diasize-proc-name
     1570               ,input  'height':u
     1571               ,output v-resize-value-str
     1572               ) .
     1573             if v-resize-value-str <> '':U
     1574             then do:
     1575               run diasize_change-height in this-procedure
     1576                 (input  integer(v-resize-value-str)
     1577                 ,input  true
     1578                 ) .
     1579               assign
     1580                 v-restore-saved = true
     1581               .
     1582             end.
     1583           end.
     1584           if connected("ub") = true
     1585           then do:
     1586             run gbl/wndsizer.p
     1587               (input  v-cntxt-db-num
     1588               ,input  v-cntxt-userid
     1589               ,input  v-diasize-proc-name
     1590               ,input  'width':u
     1591               ,output v-resize-value-str
     1592               ) .
     1593             if v-resize-value-str <> '':U
     1594             then do:
     1595               run diasize_change-width in this-procedure
     1596                 (input  integer(v-resize-value-str)
     1597                 ,input  true
     1598                 ) .
     1599               assign
     1600                 v-restore-saved = true
     1601               .
     1602             end.
     1603           end.
     1604           if v-restore-saved <> true
     1605           then do:
     1606             if v-diasize-wndmax = true
     1607             then do:
     1608               run diasize_maximize in this-procedure
     1609                 (input  true
     1610                 ) .
     1611             end.
     1612           end.
     1613         end.
     1614         else do:
     1615           if v-diasize-wndmax = true
     1616           then do:
     1617             run diasize_maximize in this-procedure
     1618               (input  true
     1619               ) .
     1620           end.
     1621         end.
     1622       end.
     1623     end.
     1624   end procedure.
     1625   procedure diasize_need-full-display :
     1626     define output parameter p-need-full-display as logical   no-undo .
     1627     do
     1628     on error undo, return error return-value
     1629     :
     1630       assign
     1631         p-need-full-display = v-diasize-need-full-display
     1632       .
     1633       assign
     1634         v-diasize-need-full-display = false
     1635       .
     1636     end.
     1637   end procedure.
     1638   procedure get-context :
     1639      define output parameter p-db-num as integer          no-undo.
     1640      define output parameter p-user-id as character        no-undo.
     1641      define variable v-login               as character    no-undo.
     1642      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1643      define buffer buf_user-login  for ub.user-login .
     1644      do
     1645      on error undo, return error
     1646      :
     1647            FIND FIRST buf_sys-ctrl no-lock.
     1648            ASSIGN
     1649               v-login = USERID("ub")
     1650               p-db-num = buf_sys-ctrl.db-num
     1651            .
     1652            FIND FIRST buf_user-login
     1653                 WHERE buf_user-login.db-num = p-db-num
     1654                   AND buf_user-login.user-login = v-login
     1655                 no-lock
     1656                 no-error
     1657                 .
     1658            IF AVAILABLE buf_user-login
     1659            THEN DO:
     1660               assign
     1661                  p-user-id = buf_user-login.user-id
     1662               .
     1663            END.
     1664      end.
     1665   end procedure.
     1666       run diasize_init in this-procedure .
     1667   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   on INS of frame Dialog-Frame anywhere do:
     1669     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1670     return no-apply.
     1671   end.
     1672   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673     run mainmenu_getcntxt in parparentproc
     1674       (output v-cntxt-db-num
     1675       ,output v-cntxt-userid
     1676       ,output v-cntxt-level
     1677       ,output v-cntxt-host-code-obj
     1678       ,output v-cntxt-obj-type
     1679       ,output v-cntxt-obj-code
     1680       ,output v-cntxt-db-num-obj
     1681       ,output v-cntxt-is-admin
     1682       ) .
     1683   MAIN-BLOCK:
     1684   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1685      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1686      define buffer buf_user-obj    for user-obj .
     1687      define buffer buf_user-host   for user-host .
     1688      FIND FIRST buf_user-login
     1689           where buf_user-login.db-num  = p-db-num
     1690             and buf_user-login.user-id = p-user-id
     1691           no-lock
     1692           no-error
     1693           .
     1694      if not available buf_user-login then do:
     1695         message "У пользователя не задан логин."
     1696            skip "Выбор меню невозможен."
     1697         view-as alert-box information.
     1698         return.
     1699      end.
     1700      IF NOT CAN-FIND (FIRST buf_user-obj where buf_user-obj.db-num  = p-db-num
     1701                                            and buf_user-obj.user-id = p-user-id
     1702                       NO-LOCK)
     1703      AND NOT CAN-FIND (FIRST buf_user-host where buf_user-host.db-num  = p-db-num
     1704                                              and buf_user-host.user-id = p-user-id
     1705                       NO-LOCK)
     1706      THEN DO:
     1707         message "У пользователя не заданы ни объекты ни фирмы."
     1708            skip "Выбор меню невозможен."
     1709         view-as alert-box information.
     1710         return.
     1711      END.
     1712      ASSIGN
     1713           FRAME Dialog-Frame:TITLE = SUBSTITUTE ( "Меню пользователя &1 для БД &2"
     1714                                                 , usrnickf( p-user-id )
     1715                                                 , buf_user-login.db-num
     1716                                                 )
     1717      .
     1718      run fill-menu in this-procedure .
     1719      run fill-wp in this-procedure .
     1720      RUN enable_UI.
     1721      run post_enable_UI in this-procedure .
     1722      WAIT-FOR GO OF FRAME Dialog-Frame.
     1723   END.
     1724   RUN disable_UI.
     1725   PROCEDURE change-menu-2 :
     1726   define buffer buf_tt-work-place    for tt-work-place.
     1727   define buffer buf_user-menu-group      for user-menu-group .
     1728   define variable v-menu-group-code    as integer      no-undo.
     1729   define variable v-ok                 as logical      no-undo.
     1730   define variable v-accepted    as logical      no-undo.
     1731   define variable v-changed    as logical      no-undo.
     1732   define variable v-user-menu-group-code    as integer      no-undo.
     1733   if available br_tt-menu-group then
     1734   DO
     1735   on error undo, return no-apply
     1736      :
     1737   if session :set-wait-state( "compiler" ) then.
     1738      run twowin_clear in this-procedure.
     1739      each-wp_:
     1740      FOR EACH   buf_tt-work-place
     1741          break by buf_tt-work-place.context
     1742         :
     1743         IF  p-db-num <> 0
     1744         AND buf_tt-work-place.db-num <> p-db-num
     1745         and buf_tt-work-place.context = 'object':U
     1746         THEN do:
     1747             next each-wp_ .
