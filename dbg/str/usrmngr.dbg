     1765         run twowin_add-item in this-procedure
     1766            ( input SUBSTITUTE( "&2 &1", buf_tt-work-place.wp-code, buf_tt-work-place.wp-type  )
     1767            , input SUBSTITUTE( "&1 &2 &3", buf_tt-work-place.wp-code, buf_tt-work-place.wp-type, buf_tt-work-place.wp-name )
     1768            , input SUBSTITUTE( "БД: &1 Фирма: &2", buf_tt-work-place.db-num, buf_tt-work-place.wp-host )
     1769            , input buf_tt-work-place.selected
     1770            ) .
     1771      end.
