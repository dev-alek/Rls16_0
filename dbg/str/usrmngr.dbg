     1779         , input table temp_twowin_items
     1780         , output table temp_twowin_itemsSelected
     1781         , output v-changed
     1782         , output v-accepted
     1783         ) .
     1784      IF NOT v-accepted THEN DO:
     1785         RETURN.
     1786      END.
     1787   if session :set-wait-state( "compiler" ) then.
     1788      post-each-wp_:
     1789      FOR EACH buf_tt-work-place
     1790      :
     1791         IF  p-db-num <> 0
     1792         AND buf_tt-work-place.db-num <> p-db-num
