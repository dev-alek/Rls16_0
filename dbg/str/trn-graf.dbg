        1   block-level on error undo, throw.
        2   define input    parameter pardoc-code   like ub.trn-doc.doc-code no-undo.
        3   define input    parameter parcur-db-num like ub.db.db-num        no-undo.
        4   define input    parameter parmode       as   character           no-undo.
        5   define output   parameter parstatus     like ub.trn-doc.status_  no-undo.
        6   define output   parameter parflag       like ub.trn-doc.flag_    no-undo.
        7   define output   parameter parcopystatus like ub.trn-doc.status_  no-undo.
        8   define output   parameter parcopyflag   like ub.trn-doc.flag_    no-undo.
        9   define buffer   bf_cur-db       for  ub.db.
       10   define buffer   bf_db           for  ub.db.
       11   define buffer   bf_trn-doc      for  ub.trn-doc.
       12   define buffer   bf_clients      for  ub.clients.
       13   define buffer   bf_store        for  ub.store.
       14   define variable varactive       like ub.store.active no-undo.
       15   define variable varext-oper     as   character       no-undo.
       16   define variable p-is-hold as logical   no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: trn-graf.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: str/trn-graf.p $":U .
       22   define variable vss-description as character no-undo init "Стандартный граф переходов складских документов".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41       assign
       42         p-vss-parameters = substitute('&1|&2|&3':u,pardoc-code,parcur-db-num,parmode)
       43       .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   do on error undo, return error substitute ("Ошибка при вызове программы trn-graf.p: &1 &2 &3 при работе с документом &4.", error-status:get-message(1), error-status:get-message(2), return-value, pardoc-code):
       87     if parmode <> '<закрытие документа>':U      and
       88        parmode <> '<открытие документа>':U       and
       89        parmode <> '<закрытие документа на факт>':U     and
       90        parmode <> '<резервирование по документу>':U     then do:
       91        return error substitute ("Неверный режим обработки документа &1.", parmode).
       92     end.
       93     if parcur-db-num = ? or
       94        parcur-db-num < 0 then do:
       95        return error substitute ("Неверный номер &1 текущей БД.", parcur-db-num).
       96     end.
       97     find first bf_cur-db where bf_cur-db.db-num = parcur-db-num no-lock no-error.
       98     if not available bf_cur-db then do:
       99        return error substitute ("Не найдена текущая БД с номером &1.", parcur-db-num).
      100     end.
      101     find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
      102     if not available bf_trn-doc then do:
      103        return error substitute ("Не найден документ с номером &1 .", bf_trn-doc.doc-code).
      104     end.
      105     find first bf_clients where bf_clients.obj-type = bf_trn-doc.obj-type and
      106                                 bf_clients.obj-code = bf_trn-doc.obj-code no-lock no-error.
      107     if not available bf_clients then do:
      108        return error substitute ("Не найден объект &1 &2 для документа &3.", bf_trn-doc.obj-type, bf_trn-doc.obj-code, bf_trn-doc.doc-code).
      109     end.
      110     if bf_clients.db-num = ? or
      111        bf_clients.db-num < 0 then do:
      112        return error substitute ("Неверный номер базы данных &1 объекта &2 &3.", bf_clients.db-num, bf_clients.obj-type, bf_clients.obj-code).
      113     end.
      114     find first bf_db where bf_db.db-num = bf_clients.db-num no-lock no-error.
      115     if not available bf_db then do:
      116        return error substitute("Не найдена БД &1 документа &2.", bf_clients.db-num, pardoc-code).
      117     end.
      118     case bf_clients.obj-type:
      119       when 'маг':U then do:
      120          assign varactive = yes.
      121       end.
      122       when 'скл':U then do:
      123         find first bf_store where bf_store.obj-code = bf_clients.obj-code no-lock no-error.
      124         if not available bf_store then do:
      125           return error substitute ("Ошибка при поиске склада с номером &1.", bf_clients.obj-code).
      126         end.
      127         assign varactive = bf_store.active.
      128       end.
      129       otherwise do:
      130         return error substitute ("Неверный тип объекта &1 документа.", bf_trn-doc.obj-type, bf_trn-doc.doc-code).
      131       end.
      132     end case.
      133     if varactive = ? then do:
      134        return error substitute ("Неизвестный признак '?' активности объекта &1 &2", bf_trn-doc.obj-type, bf_trn-doc.obj-code).
      135     end.
      136     if bf_trn-doc.internal = ? then do:
      137         return error substitute ("Неверный указан признак документа внешний/внутренний &1 - '?'.", bf_trn-doc.doc-code).
      138     end.
      139     if bf_trn-doc.flag_ = ? then do:
      140        return error substitute ("Неверный флаг документа &1 - '?'.", bf_trn-doc.doc-code).
      141     end.
      142     if bf_trn-doc.status_ = 'факт':U then do:
      143        return error substitute ("Документ &1 закрыт до факта. " + chr(10) + "Операции с ним не допустимы.", bf_trn-doc.doc-code).
      144     end.
      145   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      147     (input  bf_trn-doc.doc-code
      148     ,output p-is-hold
      149     )  .
      150     run str/trn-grfp.p (input  bf_trn-doc.doc-type,
      151                     input  bf_trn-doc.ext-doc-type,
      152                     input  bf_trn-doc.status_,
      153                     input  bf_trn-doc.flag_,
      154                     input  bf_trn-doc.internal,
      155                     input  parmode,
      156                     input  parcur-db-num,
      157                     input  bf_trn-doc.cr-db-num,
      158                     input  bf_cur-db.db-name,
      159                     input  bf_clients.db-num,
      160                     input  bf_db.db-name,
      161                     input  bf_clients.obj-type,
      162                     input  bf_clients.obj-code,
      163                     input  varactive,
      164                     input  p-is-hold ,
      165                     output parstatus,
      166                     output parflag,
      167                     output parcopystatus,
      168                     output parcopyflag) no-error.
      169     if error-status:error then do:
      170        return error substitute ("Ошибка:  &1"          + chr(10)
      171                                 + "по операции: &2"        + chr(10)
      172                                 + "номер документа &3" + chr(10)
      173                                 + "тип &4"             + chr(10)
      174                                 + "статус &5"          + chr(10)
      175                                 + "флаг &6.",
      176                                 return-value,
      177                                 parmode,
      178                                 bf_trn-doc.doc-code,
      179                                 bf_trn-doc.doc-type,
      180                                 bf_trn-doc.status_,
      181                                 bf_trn-doc.flag_).
      182     end.
      183   end.
