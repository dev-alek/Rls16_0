      202     define output parameter p-format-Naim    as character no-undo .
      203     define output parameter p-use-print-graft as logical   no-undo .
      204     define output parameter p-use-sort-gr   as logical   no-undo .
      205     define output parameter p-use-type-price as logical   no-undo .
