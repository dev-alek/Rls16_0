      194   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      195   procedure uf-name :
      196     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      197     define output parameter p-use-List_     as logical   no-undo .
      198     define output parameter p-type-List_     as character no-undo .
      199     define output parameter p-format-List_   as character no-undo .
      200     define output parameter p-use-Naim      as logical   no-undo .
