     4146      message
     4147        "Не заданы параметры ценообразования!"
     4148        view-as alert-box error
     4149      .
     4150      return error return-value .
     4151   end.
     4152   if buf_global-state.pl-use-shift-date-num = false then do:
     4153      tt_price-all.shift-1:visible in browse BROWSE-3 = false .
     4154      tt_price-all.shift-2:visible in browse BROWSE-3 = false .
