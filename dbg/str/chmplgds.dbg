      281               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      282               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      283               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      284                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      285               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      286         otherwise do:
      287           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      288         end.
      289       end CASE.
      290     end.
      291   end procedure.
      292   procedure uf-get :
      293     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      294     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      295     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      296     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      297     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      298     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      299     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      300     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      301     do
      302     on error undo, return error
      303     :
      304       define buffer buf_usr-flt for ubflt.usr-flt .
      305       define variable v-use-List_     as logical   no-undo .
      306       define variable v-type-List_     as character no-undo .
      307       define variable v-format-List_   as character no-undo .
      308       define variable v-use-Naim      as logical   no-undo .
      309       define variable v-type-Naim      as character no-undo .
      310       define variable v-format-Naim    as character no-undo .
      311       define variable v-use-print-graft as logical   no-undo .
      312       define variable v-use-sort-gr     as logical   no-undo .
      313       define variable v-use-type-price  as logical   no-undo .
      314       define variable v-use-type-val    as logical   no-undo .
      315       define variable v-label          as character no-undo .
      316       define variable v-tooltip        as character no-undo .
      317       define variable v-user-can-edit  as logical   no-undo .
      318       define variable v-output-display as logical   no-undo .
      319       define variable v-other          as character no-undo .
      320       run uf-name in this-procedure
      321          (input  entry(1, p-code, chr(4))
      322         ,output v-use-List_
      323         ,output v-type-List_
      324         ,output v-format-List_
      325         ,output v-use-Naim
      326         ,output v-type-Naim
      327         ,output v-format-Naim
      328         ,output v-use-print-graft
      329         ,output v-use-sort-gr
      330         ,output v-use-type-price
      331         ,output v-use-type-val
      332         ,output v-label
      333         ,output v-tooltip
      334         ,output v-user-can-edit
      335         ,output v-output-display
      336         ,output v-other
      337         ) no-error .
      338       if error-status :error then do:
      339         undo, return error return-value .
      340       end.
      341       find first buf_usr-flt no-lock where
      342                  buf_usr-flt.Call-point     = p-code AND
      343                  buf_usr-flt.user-name       = p-user-name
      344         no-error .
      345       if avail buf_usr-flt then do:
      346         assign
      347         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      348         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      349         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      350         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      351         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      352         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      353         .
      354       end.
      355       else do:
      356         assign
      357         p-List_        = (if v-use-List_       then "":U                    else ?)
      358         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      359         p-print-graft  = (if v-use-print-graft then no                      else ?)
      360         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      361         p-type-price   = (if v-use-type-price  then no                      else ?)
      362         p-type-val     = (if v-use-List_       then no                      else ?)
      363         .
      364       end.
      365     end.
      366   end procedure.
      367   procedure uf-set :
      368     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      369     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      370     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      371     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      372     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      373     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      374     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      375     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      376     do
      377     on error undo, return error
      378     :
      379       define buffer buf_usr-flt for ubflt.usr-flt .
      380       define variable v-use-List_     as logical   no-undo .
      381       define variable v-type-List_     as character no-undo .
      382       define variable v-format-List_   as character no-undo .
      383       define variable v-use-Naim      as logical   no-undo .
      384       define variable v-type-Naim      as character no-undo .
      385       define variable v-format-Naim    as character no-undo .
      386       define variable v-use-print-graft as logical   no-undo .
      387       define variable v-use-sort-gr   as logical   no-undo .
      388       define variable v-use-type-price as logical   no-undo .
      389       define variable v-use-type-val  as logical   no-undo .
      390       define variable v-tooltip        as character no-undo .
      391       define variable v-label          as character no-undo .
      392       define variable v-user-can-edit  as logical   no-undo .
      393       define variable v-output-display as logical   no-undo .
      394       define variable v-other          as character no-undo .
      395       run uf-name in this-procedure
      396         (input  entry(1, p-code, chr(4))
      397         ,output v-use-List_
      398         ,output v-type-List_
      399         ,output v-format-List_
      400         ,output v-use-Naim
      401         ,output v-type-Naim
      402         ,output v-format-Naim
      403         ,output v-use-print-graft
      404         ,output v-use-sort-gr
      405         ,output v-use-type-price
      406         ,output v-use-type-val
      407         ,output v-label
      408         ,output v-tooltip
      409         ,output v-user-can-edit
      410         ,output v-output-display
      411         ,output v-other
      412         ) no-error .
      413       if error-status :error then do:
      414         undo, return error return-value .
      415       end.
      416       find first buf_usr-flt where
      417                  buf_usr-flt.Call-point     = p-code AND
      418                  buf_usr-flt.user-name       = p-user-name
      419         no-error .
      420       if not avail buf_usr-flt then do:
      421           create buf_usr-flt .
      422           assign
      423           buf_usr-flt.call-point = p-code
      424           buf_usr-flt.user-name  = p-user-name
      425           .
      426       end.
      427       if avail buf_usr-flt then do:
      428        assign
      429        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      430        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      431        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      432        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      433        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      434        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      435       .
      436       release buf_usr-flt.
      437       end.
      438       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      439     end.
      440   end procedure.
      441   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   procedure factord :
      443     define input  parameter p-fact-date            as date    no-undo .
      444     define input  parameter p-fact-time            as integer no-undo .
      445     define input  parameter p-fact-num             as integer no-undo .
      446     define input  parameter p-shift-date           as date    no-undo .
      447     define input  parameter p-shift-num            as integer no-undo .
      448     define input  parameter p-shift-on             as logical no-undo .
      449     define output parameter p-fact-order           as decimal no-undo .
      450     define output parameter p-shift-end-fact-order as decimal no-undo .
      451     define output parameter p-day-end-fact-order   as decimal no-undo .
      452     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      453     if p-fact-date = ?
      454     then do:
      455       return error "Не указана фактическая дата" .
      456     end.
      457     define variable v-fact-date-num as integer no-undo .
      458     assign
      459       v-fact-date-num = integer(p-fact-date)
      460     .
      461     if p-fact-num = ?
      462     or p-fact-num = 0
      463     then do:
      464       return error "Не задан p-fact-num " + string(p-fact-num) .
      465     end.
      466     if p-fact-num < 0
      467     then do:
      468       return error "Отрицательный fact-num " + string(p-fact-num) .
      469     end.
      470     if p-fact-num >= 100000000
      471     then do:
      472       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      473     end.
      474     if p-shift-on = true
      475     then do:
      476       if p-shift-date = ?
      477       then do:
      478         return error "Не задана дата смены" .
      479       end.
      480       if p-shift-num = ?
      481       or p-shift-num = 0
      482       then do:
      483         return error "Не задан номер смены" .
      484       end.
      485     end.
      486     else do:
      487       assign
      488         p-shift-date = p-fact-date
      489         p-shift-num  = 24
      490       .
      491     end.
      492     define variable v-shift-offset as integer no-undo .
      493     if p-shift-date = p-fact-date
      494     then do:
      495       assign
      496         v-shift-offset = 1
      497       .
      498     end.
      499     if p-shift-date < p-fact-date
      500     then do:
      501       assign
      502         v-shift-offset = 0
      503       .
      504     end.
      505     if p-shift-date > p-fact-date
      506     then do:
      507       message
      508         vss-workfile vss-revision vss-description skip
      509         "Неправильная дата закрытия смены" skip
      510         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      511         view-as alert-box error .
      512       undo, return error
      513         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      514           ,string(p-fact-date, '99/99/9999':U)
      515           ,string(p-shift-date, '99/99/9999':U)
      516           )
      517       .
      518     end.
      519     if p-shift-num < 1
      520     or p-shift-num > 24
      521     then do:
      522       message
      523         vss-workfile vss-revision vss-description skip
      524         "Неправильный номер смены" skip
      525         "p-shift-num" p-shift-num skip
      526         view-as alert-box error .
      527       undo, return error return-value .
      528     end.
      529     assign
      530       p-fact-order           = v-fact-date-num
      531                              + v-shift-offset * 0.5
      532                              + p-shift-num    * 0.02 - 0.01
      533                              + p-fact-num     * 0.0000000001
      534       p-shift-end-fact-order = v-fact-date-num
      535                              + v-shift-offset * 0.5
      536                              + p-shift-num    * 0.02
      537       p-day-end-fact-order   = v-fact-date-num
      538                              + 0.99
      539     .
      540     if p-fact-order           <= v-fact-date-num
      541     or p-shift-end-fact-order <= v-fact-date-num
      542     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      543     or p-shift-end-fact-order >= p-day-end-fact-order
      544     then do:
      545       message
      546         vss-workfile vss-revision vss-description skip
      547         "Внутренняя ошибка при генерации фактического номера" skip
      548         "p-fact-date"            p-fact-date            skip
      549         "p-fact-time"            p-fact-time            skip
      550         "p-fact-num"             p-fact-num             skip
      551         "p-shift-date"           p-shift-date           skip
      552         "p-shift-num"            p-shift-num            skip
      553         "p-shift-on"             p-shift-on             skip
      554         "p-shift-end-fact-order" p-shift-end-fact-order skip
      555         "p-day-end-fact-order"   p-day-end-fact-order   skip
      556         "v-fact-date-num"        v-fact-date-num        skip
      557         view-as alert-box error .
      558       undo, return error return-value .
      559     end.
      560   end procedure.
      561   procedure day-begin-fact-order :
      562     define input  parameter p-fact-date            as date    no-undo .
      563     define output parameter p-day-begin-fact-order as decimal no-undo .
      564     do
      565     on error undo, return error return-value
      566     :
      567       if p-fact-date = ?
      568       then do:
      569         assign
      570           p-day-begin-fact-order = 0
      571         .
      572       end.
      573       else do:
      574         assign
      575           p-day-begin-fact-order = integer(p-fact-date)
      576         .
      577       end.
      578     end.
      579   end procedure.
      580   procedure factord-max-fact-order :
      581     define output parameter p-max-fact-order as decimal   no-undo .
      582     do
      583     on error undo, return error return-value
      584     :
      585       run day-begin-fact-order in this-procedure
      586         (input  date(1, 1, 5000)
      587         ,output p-max-fact-order
      588         ) .
      589     end.
      590   end procedure.
      591   procedure factord-cut-archive :
      592     define input  parameter p-obj-type             as character no-undo .
      593     define input  parameter p-obj-code             as integer   no-undo .
      594     define input  parameter p-fact-date            as date      no-undo .
      595     define output parameter p-shift-on             as logical   no-undo .
      596     define output parameter p-shift-date           as date      no-undo .
      597     define output parameter p-shift-num            as integer   no-undo .
      598     define output parameter p-day-end-fact-order   as decimal   no-undo .
      599     define output parameter p-shift-end-fact-order as decimal   no-undo .
      600     define variable v-fact-order as decimal   no-undo .
      601     define buffer buf_shift-obj for ub.shift-obj .
      602     do
      603     on error undo, return error return-value
      604     :
      605   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      607     (input  p-obj-type
      608     ,input  p-obj-code
      609     ,input  'shift-on=request'
      610     ,output p-shift-on
      611     ) no-error .
      612       if error-status :error
      613       then do:
      614         message
      615           vss-workfile vss-revision vss-description skip
      616           "Ошибка при определении атрибута объекта" skip
      617           "Объект" p-obj-type p-obj-code skip
      618           error-status :get-message(1) skip
      619           return-value skip
      620           view-as alert-box error .
      621         undo, return error return-value .
      622       end.
      623       if p-shift-on = false
      624       then do:
      625         assign
      626           p-shift-date               = ?
      627           p-shift-num                = 0
      628         .
      629       end.
      630       else do:
      631         find first buf_shift-obj share-lock
      632           where buf_shift-obj.obj-type   = p-obj-type
      633             and buf_shift-obj.obj-code   = p-obj-code
      634             and buf_shift-obj.shift-date > p-fact-date
      635           use-index pi
      636           no-error .
      637         if not available buf_shift-obj
      638         or buf_shift-obj.status_ <> 'зкр':U
      639         then do:
      640           message
      641             vss-workfile vss-revision vss-description skip
      642             "Невозможно вычислить последнюю смену" skip
      643             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      644             "Объект" p-obj-type p-obj-code skip
      645             "Дата" p-fact-date skip
      646             view-as alert-box error .
      647           undo, return error return-value .
      648         end.
      649         find last buf_shift-obj share-lock
      650           where buf_shift-obj.obj-type = p-obj-type
      651             and buf_shift-obj.obj-code = p-obj-code
      652             and buf_shift-obj.shift-date <= p-fact-date
      653           use-index pi
      654           no-error .
      655         if available buf_shift-obj
      656         then do:
      657           if  buf_shift-obj.status_ = 'зкр':U
      658           then do:
      659             assign
      660               p-shift-date = buf_shift-obj.shift-date
      661               p-shift-num  = buf_shift-obj.shift-num
      662             .
      663           end.
      664           else do:
      665             message
      666               vss-workfile vss-revision vss-description skip
      667               "Невозможно вычислить последнюю смену" skip
      668               "Статус смены отличен от статуса" 'зкр':U skip
      669               "Объект" p-obj-type p-obj-code skip
      670               "Дата" p-fact-date skip
      671               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      672               view-as alert-box error .
      673             undo, return error return-value .
      674           end.
      675         end.
      676         else do:
      677           assign
      678             p-shift-date = p-fact-date - 1
      679             p-shift-num  = 1
      680           .
      681         end.
      682       end.
      683       run factord in this-procedure
      684         (input  p-fact-date
      685         ,input  1
      686         ,input  1
      687         ,input  p-shift-date
      688         ,input  p-shift-num
      689         ,input  p-shift-on
      690         ,output v-fact-order
      691         ,output p-shift-end-fact-order
      692         ,output p-day-end-fact-order
      693         ) no-error .
      694       if error-status :error
      695       then do:
      696         message
      697           vss-workfile vss-revision vss-description skip
      698           "Ошибка при вызове процедуры factord"
      699           error-status :get-message(1) skip
      700           return-value skip
      701           view-as alert-box error .
      702         undo, return error return-value .
      703       end.
      704     end.
      705   end procedure.
      706   procedure factord-lock-shift :
      707     define input  parameter p-obj-type  as character no-undo .
      708     define input  parameter p-obj-code  as integer   no-undo .
      709     define input  parameter p-fact-date as date      no-undo .
      710     define parameter buffer buf_shift-obj for ub.shift-obj .
      711     define variable v-shift-on      as logical   no-undo .
      712     define variable v-extra-message as character no-undo .
      713     define variable v-error as character no-undo .
      714     do
      715     on error undo, return error return-value
      716     :
      717   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      719     (input  p-obj-type
      720     ,input  p-obj-code
      721     ,input  'shift-on=request'
      722     ,output v-shift-on
      723     ) no-error .
      724       if error-status :error
      725       then do:
      726         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      727         undo, return error v-error .
      728       end.
      729       if v-shift-on = true
      730       then do:
      731         find first buf_shift-obj share-lock
      732           where buf_shift-obj.obj-type   = p-obj-type
      733             and buf_shift-obj.obj-code   = p-obj-code
      734             and buf_shift-obj.shift-date > p-fact-date
      735           use-index pi
      736           no-error .
      737         if not available buf_shift-obj
      738         or buf_shift-obj.status_ <> 'зкр':U
      739         then do:
      740           find last buf_shift-obj
      741             where buf_shift-obj.obj-type = p-obj-type
      742               and buf_shift-obj.obj-code = p-obj-code
      743               and buf_shift-obj.status_  = 'зкр':U
      744             use-index stts
      745             no-error .
      746           if available buf_shift-obj
      747           then do:
      748             assign
      749               v-extra-message =
      750                     substitute("Дата начала последеней закрытой смены на объекте &1"
      751                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      752                               )
      753             .
      754           end.
      755           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      756           undo, return error v-error .
      757         end.
      758       end.
      759     end.
      760   end procedure.
      761   procedure factord-end-day :
      762     define input  parameter p-fact-date            as date    no-undo .
      763     define output parameter p-day-end-fact-order   as decimal no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       if p-fact-date = ?
      768       then do:
      769         return error "Не указана фактическая дата" .
      770       end.
      771       assign
      772         p-day-end-fact-order = integer(p-fact-date) + 0.99
      773       .
      774     end.
      775   end procedure.
      776   procedure factord-to-date :
      777     define input  parameter p-fact-order as decimal no-undo .
      778     define output parameter p-fact-date  as date    no-undo .
      779     define variable v-ref-date  as date      no-undo .
      780     define variable v-ref-delta as integer   no-undo .
      781     do
      782     on error undo, return error return-value
      783     :
      784       if p-fact-order = ?
      785       or p-fact-order = 0
      786       then do:
      787         return error "Не указан fact-order" .
      788       end.
      789       assign
      790         v-ref-date  = date(1, 1, 2000)
      791       .
      792       assign
      793         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      794       .
      795       assign
      796         p-fact-date = v-ref-date + v-ref-delta
      797       .
      798     end.
      799   end procedure.
      800   procedure factord-to-fact-num :
      801     define input  parameter p-fact-order as decimal no-undo .
      802     define output parameter p-fact-num   as integer no-undo .
      803     define variable v-fact-order-trunc as decimal no-undo .
      804     do
      805     on error undo, return error return-value
      806     :
      807       if p-fact-order = ?
      808       or p-fact-order = 0
      809       then do:
      810         return error "Не указан fact-order" .
      811       end.
      812       assign
      813        v-fact-order-trunc = truncate(p-fact-order, 2)
      814       .
      815       assign
      816         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      817       .
      818     end.
      819   end procedure.
      820   procedure factord-to-shift-num :
      821     define input  parameter p-fact-order as decimal no-undo .
      822     define output parameter p-shift-num   as integer no-undo .
      823     define variable  p-shift-numd  as decimal   no-undo .
      824     define variable v-fact-order-trunc as decimal no-undo .
      825     do
      826     on error undo, return error return-value
      827     :
      828       if p-fact-order = ?
      829       or p-fact-order = 0
      830       then do:
      831         return error "Не указан fact-order" .
      832       end.
      833       assign
      834        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      835       .
      836       if v-fact-order-trunc < 0.5 then do:
      837         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      838       end.
      839       assign
      840         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      841         .
      842        assign
      843         p-shift-num = truncate (p-shift-numd , 0)
      844       .
      845     end.
      846   end procedure.
      847   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   procedure cur-time :
      850      define output parameter p-today as date      no-undo .
      851      define output parameter p-time  as integer   no-undo .
      852     do
      853     on error undo, return error
      854     :
      855       define variable v-date1 as date      no-undo .
      856       define variable v-date2 as date      no-undo .
      857       define variable v-time  as integer   no-undo .
      858       assign
      859         v-date1 = today
      860         v-time  = time
      861         v-date2 = today
      862       .
      863       if v-date1 <> v-date2
      864       then do:
      865         assign
      866           v-date1 = today
      867           v-time  = v-time
      868         .
      869       end.
      870       assign
      871         p-today = v-date1
      872         p-time  = v-time
      873       .
      874     end.
      875   end.
      876   function cur-time-date returns character
      877   :
      878     return string(today, '99/99/9999':U) .
      879   end.
      880   function cur-time-mjd returns decimal
      881   :
      882     define variable v-date as date      no-undo .
      883     define variable v-time as integer   no-undo .
      884     run cur-time in this-procedure
      885       (output v-date
      886       ,output v-time
      887       ) .
      888     return integer(v-date) - 2400002 + (v-time / 86400) .
      889   end.
      890   function cur-time-get-ending-index returns integer
      891   (input p-number as integer
      892   )
      893   :
      894     if p-number < 0
      895     or p-number = ?
      896     then do:
      897       return 1 .
      898     end.
      899     define variable v-rest as integer   no-undo .
      900     assign
      901       p-number = p-number modulo 100
      902     .
      903     if p-number < 20
      904     then do:
      905       assign
      906         v-rest = p-number
      907       .
      908     end.
      909     else do:
      910       assign
      911         v-rest = p-number modulo 10
      912       .
      913     end.
      914     case v-rest :
      915       when 1
      916       then do:
      917         return 2 .
      918       end.
      919       when 2 or
      920       when 3 or
      921       when 4
      922       then do:
      923         return 3 .
      924       end.
      925       otherwise do:
      926         return 1 .
      927       end.
      928     end case .
      929   end.
      930   procedure cur-time-mjd-to-date :
      931      define input  parameter i-mjd-diff as decimal no-undo.
      932      define output parameter o-Date     as date    no-undo.
      933      define output parameter o-Time     as integer no-undo.
      934      define variable v-day-number as integer   no-undo .
      935      if    i-mjd-diff < 0
      936         or i-mjd-diff = ?
      937      then do:
      938         return "?" .
      939      end.
      940      assign
      941         v-day-number = truncate(i-mjd-diff,0).
      942         o-Date = date(v-day-number + 2400002).
      943         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      944     .
      945   end.
      946   function cur-time-mjd-to-string returns character
      947   (input p-mjd-diff as decimal
      948   )
      949   :
      950     define variable v-day-number as integer   no-undo .
      951     define variable v-seconds    as integer   no-undo .
      952     define variable v-hour       as integer   no-undo .
      953     define variable v-min        as integer   no-undo .
      954     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      955     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      956     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      957     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      958     if p-mjd-diff < 0
      959     or p-mjd-diff = ?
      960     then do:
      961       return "?" .
      962     end.
      963     assign
      964       v-day-number = integer(truncate(p-mjd-diff,0))
      965       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      966     .
      967     if v-seconds > 86400
      968     then do:
      969       assign
      970         v-seconds = 86400 - 1
      971       .
      972     end.
      973     if v-seconds < 0
      974     then do:
      975       assign
      976         v-seconds = 0
      977       .
      978     end.
      979     assign
      980       v-hour = truncate(v-seconds / 3600, 0)
      981     .
      982     assign
      983       v-seconds = v-seconds modulo 3600
      984     .
      985     assign
      986       v-min = truncate(v-seconds / 60, 0)
      987     .
      988     assign
      989       v-seconds = v-seconds modulo 60
      990     .
      991     return
      992         (if v-day-number <> 0
      993           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      994           else ""
      995         )
      996       + (if v-day-number <> 0 or v-hour <> 0
      997           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      998           else ""
      999         )
     1000       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1001           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1002           else ""
     1003         )
     1004       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1005       .
     1006   end.
     1007   function cur-time-string returns character
     1008   :
     1009     define variable v-date as date      no-undo .
     1010     define variable v-time as integer   no-undo .
     1011     run cur-time in this-procedure
     1012       (output v-date
     1013       ,output v-time
     1014       ) .
     1015     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1016   end.
     1017   function cur-time-string-sec returns character
     1018   :
     1019     define variable v-date as date      no-undo .
     1020     define variable v-time as integer   no-undo .
     1021     run cur-time in this-procedure
     1022       (output v-date
     1023       ,output v-time
     1024       ) .
     1025     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1026   end.
     1027   function cur-time-custom  returns character
     1028   (input p-prefix as character
     1029   ,input p-date-format as character
     1030   ,input p-delimiter as character
     1031   ,input p-time-format as character
     1032   ,input p-suffix as character
     1033   )
     1034   :
     1035     define variable v-date as date      no-undo .
     1036     define variable v-time as integer   no-undo .
     1037     run cur-time in this-procedure
     1038       (output v-date
     1039       ,output v-time
     1040       ) .
     1041     return
     1042       p-prefix
     1043       + string(v-date, p-date-format)
     1044       + p-delimiter
     1045       + string(v-time, p-time-format)
     1046       + p-suffix
     1047       .
     1048   end.
     1049   function cur-time-print  returns character
     1050   :
     1051     define variable v-date as date      no-undo .
     1052     define variable v-time as integer   no-undo .
     1053     run cur-time in this-procedure
     1054       (output v-date
     1055       ,output v-time
     1056       ) .
     1057     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1058   end.
     1059   function cur-time-datetime returns datetime
     1060   :
     1061     define variable v-char as character no-undo .
     1062     define variable v-datetime as datetime no-undo .
     1063     v-char = cur-time-string().
     1064     v-datetime = datetime(v-char).
     1065     return  v-datetime.
     1066   end.
     1067   function cur-time-string-msec returns character
     1068   :
     1069     define variable v-date as datetime  no-undo .
     1070     v-date = now.
     1071     return string(v-date) .
     1072   end.
     1073   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   procedure fact-order-mpl :
     1075     do
     1076     on error undo, return error return-value
     1077     :
     1078   define input  parameter p-doc-date as date     no-undo .
     1079   define input  parameter p-obj-type as character no-undo .
     1080   define input  parameter p-obj-code as integer   no-undo .
     1081   define output parameter p-fact-order as decimal   no-undo .
     1082   define variable v-fact-date            as date    no-undo .
     1083   define variable v-fact-time            as integer no-undo .
     1084   define variable v-fact-order           as decimal no-undo .
     1085   define variable v-shift-end-fact-order as decimal no-undo .
     1086   define variable v-day-end-fact-order   as decimal no-undo .
     1087   define variable l-shift-on as logical no-undo .
     1088   define variable l-date as date      no-undo .
     1089   define variable l-time as integer   no-undo .
     1090   define variable shift-date as date      no-undo .
     1091   define variable shift-num  as integer   no-undo .
     1092   define variable shift-name as character no-undo .
     1093   define variable max-fact-order as decimal   no-undo .
     1094   define buffer buf_global-state for ub.global-state  .
     1095   find first buf_global-state no-lock no-error .
     1096   if not available buf_global-state then do:
     1097      message
     1098        "Не заданы параметры ценообразования!"
     1099        view-as alert-box error
     1100      .
     1101      return error return-value .
     1102   end.
     1103     run cur-time in this-procedure
     1104     ( output v-fact-date ,
     1105       output v-fact-time  ).
     1106   if p-doc-date = ? then do:
     1107   if buf_global-state.pl-use-sys-date-time  = true then do:
     1108         run factord in this-procedure
     1109           (input  v-fact-date
     1110           ,input  v-fact-time
     1111           ,input  v-fact-time
     1112           ,input  ?
     1113           ,input  ?
     1114           ,input  false
     1115           ,output v-fact-order
     1116           ,output v-shift-end-fact-order
     1117           ,output v-day-end-fact-order
     1118           ) no-error .
     1119         if error-status :error
     1120         or v-fact-order = ?
     1121         or v-fact-order = 0 then do:
     1122           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1123         end.
     1124         p-fact-order = v-fact-order .
     1125   end.
     1126   else do:
     1127   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1129     (input  p-obj-type
     1130     ,input  p-obj-code
     1131     ,input  'shift-on=request'
     1132     ,output l-shift-on
     1133     ) no-error .
     1134         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1135         if p-doc-date <> ? then do:
     1136         end.
     1137          run gbl/factdate.p
     1138          ( input        p-obj-type  ,
     1139            input        p-obj-code  ,
     1140            input-output v-fact-date ,
     1141            input-output v-fact-time ,
     1142            input-output shift-date      ,
     1143            input-output shift-num       ,
     1144            input-output shift-name      ,
     1145            input        yes
     1146            ) no-error .
     1147         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1148         run factord in this-procedure
     1149           (input  v-fact-date
     1150           ,input  v-fact-time
     1151           ,input  v-fact-time
     1152           ,input  shift-date
     1153           ,input  shift-num
     1154           ,input  l-shift-on
     1155           ,output v-fact-order
     1156           ,output v-shift-end-fact-order
     1157           ,output v-day-end-fact-order
     1158           ) no-error .
     1159         if error-status :error
     1160         or v-fact-order = ?
     1161         or v-fact-order = 0 then do:
     1162           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1163         end.
     1164         p-fact-order = v-fact-order .
     1165   end.
     1166   end.
     1167   else do:
     1168          run gbl/factdate.p
     1169          ( input        p-obj-type  ,
     1170            input        p-obj-code  ,
     1171            input-output v-fact-date ,
     1172            input-output v-fact-time ,
     1173            input-output shift-date      ,
     1174            input-output shift-num       ,
     1175            input-output shift-name      ,
     1176            input        yes
     1177            ) no-error .
     1178         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1179         v-fact-date = p-doc-date .
     1180         run factord in this-procedure
     1181           (input  v-fact-date
     1182           ,input  v-fact-time
     1183           ,input  v-fact-time
     1184           ,input  shift-date
     1185           ,input  shift-num
     1186           ,input  l-shift-on
     1187           ,output v-fact-order
     1188           ,output v-shift-end-fact-order
     1189           ,output v-day-end-fact-order
     1190           ) no-error .
     1191         if error-status :error
     1192         or v-fact-order = ?
     1193         or v-fact-order = 0 then do:
     1194           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1195         end.
     1196         p-fact-order = v-fact-order .
     1197   end.
     1198     end.
     1199   end procedure.
     1200   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1201   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202   FUNCTION alg-name RETURNS CHARACTER
     1203     ( buffer loc-table for ub.gds-add-charges ) :
     1204   if not available  loc-table  then return "678" .
     1205   if loc-table.cost-include = no then return "".
     1206   case loc-table.algoritm :
     1207     when "1" then do:
     1208       return "сумме приходных цен".
     1209     end.
     1210     when "2" then do:
     1211       return "количеству(в баз. ед.изм.)".
     1212     end.
     1213     when "3" then do:
     1214       return "количеству(в пост. ед.изм.)" .
     1215     end.
     1216     when "4" then do:
     1217       return "весу".
     1218     end.
     1219   end case.
     1220   END FUNCTION.
     1221   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1222   define temp-table userobjs_temp-user-obj no-undo
     1223     field obj-type as character
