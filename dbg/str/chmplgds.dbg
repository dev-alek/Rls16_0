     4159   end.
     4160   frame Dialog-Frame:TITLE = SUBSTITUTE( "Цены товара : &1 &2 " , buf_goods.artic , buf_goods.gds-name) .
     4161   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4163     (input  p-obj-type
     4164     ,input  p-obj-code
     4165     ,output to-day
     4166     )  .
     4167   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4168   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4169     (input  p-obj-type
     4170     ,input  p-obj-code
     4171     ,output v-host-code
     4172     )  .
     4173   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4175     (input  v-host-code
     4176     ,input  to-day
     4177     ,output v-base-rate0
     4178     ,output v-base-scale0
     4179     )  .
     4180   for each buf_price-all no-lock where
     4181            buf_price-all.gds-code = p-gds-code
     4182            :
     4183            v-grp-name =  "" .
     4184            v-interv = "" .
     4185            v-pay-name = "" .
     4186            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     4187            if buf_price-all.bgr-id > 0 then do:
     4188               v-grp-name =  "" .
     4189               find first buf_buyer-group no-lock where
     4190                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     4191                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     4192               if available buf_buyer-group then
     4193                            v-grp-name = buf_buyer-group.name .
     4194            end.
     4195            if buf_price-all.tog-id > 0 then do:
     4196               v-grp-name = "".
     4197               find first buf_turnover-group no-lock where
     4198                          buf_turnover-group.tog-id     = buf_price-all.tog-id  and
     4199                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     4200               if available buf_turnover-group then
     4201                            v-grp-name = buf_turnover-group.name .
     4202            end.
     4203            if buf_price-all.plt-fix-cource-crc-base = true then do:
     4204               assign
     4205                 v-base-rate  = buf_price-all.pdf-base-rate
     4206                 v-base-scale = buf_price-all.pdf-base-scale
     4207               .
     4208            end.
     4209            else do:
     4210               assign
     4211                 v-base-rate  = v-base-rate0
     4212                 v-base-scale = v-base-scale0
     4213               .
     4214            end.
     4215            if buf_price-all.plt-fix-cource-crc-doc = true then do:
     4216               assign
     4217                 v-exch-rate  = buf_price-all.pdf-exch-rate
     4218                 v-exch-scale = buf_price-all.pdf-exch-scale
     4219               .
     4220            end.
     4221            else do:
     4222   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4223   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4224     (input  buf_price-all.curr-code
     4225     ,input  to-day
     4226     ,output v-exch-rate0
     4227     ,output v-exch-scale0
     4228     ,output v-curr-abbr
     4229     )  .
     4230               assign
     4231                 v-exch-rate  = v-exch-rate0
     4232                 v-exch-scale = v-exch-scale0
     4233                 .
     4234             end.
     4235              v-date-1 = date ( "" )  .
     4236              if buf_price-all.fact-order-sys-from > 0 then do:
     4237                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     4238                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     4239                 if buf_price-all.start-date <> ?      then  v-date-1 = buf_price-all.start-date.
     4240              end.
     4241              v-date-2 =  date ( "" )  .
     4242              if buf_price-all.fact-order-sys-to > 0 then do:
     4243                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     4244                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     4245                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     4246              end.
     4247              if buf_price-all.qnty-from <> ? then do :
     4248                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     4249              end.
     4250              if buf_price-all.sum-from <> ? then do :
     4251                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     4252              end.
     4253              if buf_price-all.turnover-from <> ? then do :
     4254                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     4255              end.
     4256              if buf_price-all.use-pay-type = 1 then do :
     4257                  v-pay-name = 'Оплата':U + ":" + string(buf_price-all.pay-code) .
     4258              end.
     4259              if buf_price-all.use-cash-pay = 1 then do :
     4260                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     4261              end.
     4262             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     4263             create tt_price-all .
     4264             buffer-copy buf_price-all to tt_price-all
     4265             assign
     4266               tt_price-all.price-sale      = buf_price-all.price-sale
     4267               tt_price-all.price-sale-rubl = buf_price-all.price-sale       * v-exch-rate / v-exch-scale
     4268               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     4269               tt_price-all.pdf-exch-rate   = v-exch-rate
     4270               tt_price-all.pdf-exch-scale  = v-exch-scale
     4271               tt_price-all.pdf-base-rate   = v-base-rate
     4272               tt_price-all.pdf-base-scale  = v-base-scale
     4273               tt_price-all.grp-name        = v-grp-name
     4274               tt_price-all.date-1          = v-date-1
     4275               tt_price-all.shift-1         = buf_price-all.start-shift-num
     4276               tt_price-all.time-1          = buf_price-all.start-sys-time
     4277               tt_price-all.date-2          = v-date-2
     4278               tt_price-all.shift-2         = buf_price-all.end-shift-num
     4279               tt_price-all.time-2          = buf_price-all.end-sys-time
     4280               tt_price-all.interv-name     = v-interv
     4281               tt_price-all.pay-name        = v-pay-name
     4282               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     4283               tt_price-all.cli-base-rate   = buf_bar-code.cli-base-rate
     4284             .
     4285   end.
     4286   define variable v-fact-order as decimal   no-undo .
     4287         run fact-order-mpl in this-procedure
     4288         ( input ?          ,
     4289           input v-obj-type ,
     4290           input v-obj-code ,
     4291           output v-fact-order
     4292         )  .
     4293   for each tt_price-all exclusive-lock where
     4294         tt_price-all.plt-priority > 0 and
     4295         tt_price-all.fact-order-sys-from <= v-fact-order and
     4296         tt_price-all.fact-order-sys-to  >= v-fact-order
     4297       break
     4298       by tt_price-all.b-code
     4299       by tt_price-all.plt-priority
     4300       by tt_price-all.grp-name
     4301       by tt_price-all.pay-name
     4302       by tt_price-all.obj-type
     4303       by tt_price-all.obj-code
     4304       by tt_price-all.interv-name
     4305       by tt_price-all.fact-order  DESCENDING
     4306       by tt_price-all.plt-id      DESCENDING
     4307       by tt_price-all.plt-db-num  DESCENDING
     4308       by tt_price-all.pdf-id      DESCENDING
     4309       by tt_price-all.pdf-db      DESCENDING
     4310       :
     4311       if first-of(tt_price-all.interv-name) then do:
     4312          tt_price-all.last-pr = true .
     4313       end.
     4314       else tt_price-all.last-pr = false .
     4315   end.
     4316   END PROCEDURE.
     4317   PROCEDURE openBr :
     4318   assign   frame Dialog-Frame  r-obj r-actual r-main-code .
     4319   define variable v-fact-order as decimal   no-undo .
     4320         run fact-order-mpl in this-procedure
     4321         ( input ?          ,
     4322           input v-obj-type ,
     4323           input v-obj-code ,
     4324           output v-fact-order
     4325         )  .
     4326     case r-actual :
     4327     when 1 then do:
     4328      case r-main-code :
     4329           when 1 then do:
     4330                 open query browse-3 for each tt_price-all  no-lock
     4331                     where ( r-obj = 1 or
     4332                             tt_price-all.obj-type = v-obj-type and
     4333                             tt_price-all.obj-code = v-obj-code ) ,
     4334                     each buf_currency of tt_price-all  no-lock ,
     4335                     each buf_price-doc-forming of tt_price-all  no-lock
     4336                     indexed-reposition.
     4337           end.
     4338           when 2 then do:
     4339                 open query browse-3 for each tt_price-all  no-lock where
     4340                 ( r-obj = 1 OR
     4341                   tt_price-all.obj-type = v-obj-type and
     4342                   tt_price-all.obj-code = v-obj-code )
     4343                   and
     4344                  ( tt_price-all.type-price = integer ('0':U) or
     4345                    tt_price-all.type-price = integer ('2':U)),
     4346                   each buf_currency of tt_price-all  no-lock ,
     4347                   each buf_price-doc-forming of tt_price-all  no-lock
     4348                   indexed-reposition.
     4349           end.
     4350      end case.
     4351     end.
     4352     when 2 then do:
     4353      case r-main-code :
     4354           when 1 then do:
     4355               open query browse-3 for each tt_price-all no-lock use-index pi where
     4356                   ( r-obj = 1 OR
     4357                     tt_price-all.obj-type = v-obj-type and
     4358                     tt_price-all.obj-code = v-obj-code )
     4359                     and
     4360                     tt_price-all.last-pr = true
     4361                    ,
     4362                 each buf_currency of tt_price-all  no-lock ,
     4363                 each buf_price-doc-forming of tt_price-all  no-lock
     4364                 .
     4365           end.
     4366           when 2 then do:
     4367                 open query browse-3 for each tt_price-all  no-lock where
     4368               ( r-obj = 1 or
     4369                 tt_price-all.obj-type = v-obj-type and
     4370                 tt_price-all.obj-code = v-obj-code )
     4371                 and
     4372                   tt_price-all.last-pr = true
     4373                 and
     4374               ( tt_price-all.type-price = int('0':U) or
     4375                 tt_price-all.type-price = int('2':U)  ) ,
     4376                 each buf_currency of tt_price-all  no-lock ,
     4377                 each buf_price-doc-forming of tt_price-all  no-lock
     4378                 indexed-reposition.
     4379           end.
     4380      end case.
     4381     end.
     4382     end case.
     4383   apply "VALUE-CHANGED" TO BROWSE-3 IN FRAME Dialog-Frame.
     4384   END PROCEDURE.
     4385   PROCEDURE proc-print :
     4386   define variable sym1  as char format "X(1)" init ":".
     4387   define variable sym2  as char format "X(1)" init ":".
     4388   define variable sym3  as char format "X(1)" init ":".
     4389   define variable sym4  as char format "X(1)" init ":".
     4390   define variable sym5  as char format "X(1)" init ":".
     4391   define variable sym6  as char format "X(1)" init ":".
     4392   define variable sym7  as char format "X(1)" init ":".
     4393   define variable sym8  as char format "X(1)" init ":".
     4394   define variable sym9  as char format "X(1)" init ":".
     4395   define variable sym10 as char format "X(1)" init ":".
     4396   define variable sym11 as char format "X(1)" init ":".
     4397   define variable sym12 as char format "X(1)" init ":".
     4398   define variable date_string     as      char    no-undo.
     4399   define variable Line                as      char    no-undo.
     4400   define variable for-time as char.
     4401   DEFINE FRAME prt-frame
     4402         tt_price-all.plt-priority               COLUMN-LABEL "Приор!итет" FORMAT ">>>>9":U
     4403         tt_price-all.b-code                     FORMAT "999999999":U
     4404         tt_price-all.unit-cli                   COLUMN-LABEL "Ед!изм" FORMAT "X(3)":U
     4405         buf_currency.curr-abbr                  COLUMN-LABEL "Вал!п/л" FORMAT "X(3)":U
     4406         tt_price-all.obj-type                   COLUMN-LABEL "Объект! " FORMAT "x(13)":U
     4407         tt_price-all.price-sale                 COLUMN-LABEL "Цена в вал!прайс-листа" FORMAT       ">>>>>>>>>>9.99":U
     4408         tt_price-all.price-sale-base            COLUMN-LABEL "Цена в !баз.вал" FORMAT              ">>>>>>>>>>9.99":U
     4409         tt_price-all.price-sale-rubl            COLUMN-LABEL "Цена в !РУБ" FORMAT ">>>>>>>>>>9.99":U
     4410         tt_price-all.date-1                     COLUMN-LABEL "Действие!с " FORMAT "99/99/99":U
     4411         tt_price-all.date-2                     COLUMN-LABEL "Действие!по " FORMAT "99/99/99":U
     4412         tt_price-all.grp-name                   COLUMN-LABEL "Покупатели! " FORMAT "x(20)":U
     4413         tt_price-all.interv-name                COLUMN-LABEL "Интервал!группы" FORMAT "x(25)":U
     4414         tt_price-all.pay-name                   COLUMN-LABEL "Тип платежа! " FORMAT "x(25)":U
     4415    HEADER  date_string AT 5 format "X(35)"
     4416           string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     4417           Line format "X(157)" AT 1
     4418       with width 232 down stream-io use-text    .
     4419       Line = fill("-", 157).
     4420       date_string = cur-time-print() .
     4421       run prn-lib-open-stream in this-procedure
     4422       (  input parParentProc
     4423         ,input 43
     4424         ,input yes
     4425         ,input no
     4426         ).
     4427       PUT  STREAM PrnLibStream
     4428       SPACE(25) ( frame Dialog-Frame:title )
     4429       format "x(157)" SKIP(1) .
     4430       FORM HEADER
     4431         Line format "X(177)" AT 1 SKIP
     4432         "Продолжение - на следующей странице" AT 30 SKIP
     4433         with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4434       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4435       FORM with FRAME prt-frame  .
     4436       run waitfram-show in this-procedure ("Ждите печатаю...").
     4437       run OpenBR in this-procedure .
     4438        DO WHILE available tt_price-all :
     4439           Display STREAM PrnLibStream
     4440           tt_price-all.plt-priority
     4441           tt_price-all.b-code
     4442           tt_price-all.unit-cli
     4443           buf_currency.curr-abbr
     4444           tt_price-all.obj-type + string(tt_price-all.obj-code) @ tt_price-all.obj-type
     4445           tt_price-all.price-sale
     4446           tt_price-all.price-sale-base
     4447           tt_price-all.price-sale-rubl
     4448           tt_price-all.date-1
     4449           tt_price-all.date-2
     4450           tt_price-all.grp-name
     4451           tt_price-all.interv-name
     4452           tt_price-all.pay-name
     4453             with FRAME prt-frame .
     4454             DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     4455            GET next BROWSE-3.
     4456       END.
     4457       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4458       HIDE  STREAM PrnLibStream FRAME CheckList.
     4459       output  STREAM PrnLibStream CLOSE.
     4460       run waitfram-hide in this-procedure .
     4461       run prn-lib-prn-file in this-procedure (
     4462           input parParentProc
     4463          ,input 8
     4464           ).
     4465   END PROCEDURE.
