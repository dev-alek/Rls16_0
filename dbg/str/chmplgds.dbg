     1226     .
     1227   procedure userobjs_clear :
     1228     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1229     do
     1230     on error undo, return error return-value
     1231     :
     1232       for each buf_userobjs_temp-user-obj
     1233       on error undo, return error return-value
     1234       :
     1235         delete buf_userobjs_temp-user-obj .
     1236       end.
     1237     end.
     1238   end .
     1239   procedure userobjs_object-count :
     1240     define output parameter p-total-count as integer   no-undo .
     1241     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1242     do
     1243     on error undo, return error return-value
     1244     :
     1245       assign
     1246         p-total-count = 0
     1247       .
     1248       for each buf_userobjs_temp-user-obj
     1249       on error undo, return error return-value
