     2174   DEFINE QUERY BROWSE-3 FOR
     2175         tt_price-all,
     2176         buf_currency,
     2177         buf_price-doc-forming SCROLLING.
     2178   DEFINE BROWSE BROWSE-3
     2179     QUERY BROWSE-3 NO-LOCK DISPLAY
     2180      tt_price-all.plt-priority COLUMN-LABEL "Приор!итет" FORMAT ">>>>9":U
     2181      tt_price-all.b-code       FORMAT "999999999":U
     2182      tt_price-all.unit-cli     COLUMN-LABEL "Ед!изм" FORMAT "X(3)":U
     2183      buf_currency.curr-abbr    COLUMN-LABEL "Вал!п/л" FORMAT "X(3)":U
     2184      tt_price-all.obj-type + string(tt_price-all.obj-code)  COLUMN-LABEL "Объект! " FORMAT "x(8)":U
     2185      tt_price-all.plt-fix-cource-crc-doc  COLUMN-LABEL "Ф!к" FORMAT "+/-":U
     2186      tt_price-all.pdf-exch-rate           COLUMN-LABEL "Курс!док-та" FORMAT ">>>>9.9999":U
     2187      tt_price-all.price-sale              COLUMN-LABEL "Цена в вал!прайс-листа" FORMAT "->>,>>>,>>>,>>>,>>9.99":U LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     2188      tt_price-all.plt-fix-cource-crc-base COLUMN-LABEL "Ф!б" FORMAT "+/-":U
     2189      tt_price-all.pdf-base-rate   COLUMN-LABEL "Курс!баз.вал" FORMAT ">>>>9.9999":U
     2190      tt_price-all.price-sale-base COLUMN-LABEL "Цена в !баз.вал" FORMAT "->>,>>>,>>>,>>>,>>9.99":U
     2191      tt_price-all.price-sale-rubl COLUMN-LABEL "Цена в !РУБ" FORMAT "->>,>>>,>>>,>>>,>>9.99":U
     2192      tt_price-all.date-1          COLUMN-LABEL "Действие!с " FORMAT "99/99/9999":U
     2193      tt_price-all.shift-1         COLUMN-LABEL "См!с" FORMAT ">9":U
     2194      (if tt_price-all.time-1 = 0 then "" else string(tt_price-all.time-1,"hh:mm")) @ stime-1 COLUMN-LABEL "Время!c" FORMAT "x(5)":U
     2195      tt_price-all.date-2          COLUMN-LABEL "Действие!по " FORMAT "99/99/9999":U
     2196      tt_price-all.shift-2         COLUMN-LABEL "См!по" FORMAT ">9":U
     2197      (if tt_price-all.time-2 = 0 then "" else string(tt_price-all.time-2,"hh:mm")) @ stime-2 COLUMN-LABEL "Время!по" FORMAT "x(5)":U
     2198      tt_price-all.grp-name        COLUMN-LABEL "Покупатели! " FORMAT "x(20)":U
     2199      tt_price-all.interv-name     COLUMN-LABEL "Интервал!группы" FORMAT "x(25)":U
     2200      tt_price-all.pay-name        COLUMN-LABEL "Тип платежа! " FORMAT "x(25)":U
     2201      tt_price-all.plt-id          COLUMN-LABEL "ТПЛ! " FORMAT ">>>>>>>>9":U
     2202      tt_price-all.plt-db-num      COLUMN-LABEL "БД!ТПЛ" FORMAT ">>>>>>9":U
     2203      tt_price-all.pdf-id          COLUMN-LABEL "ДНЦ! " FORMAT ">>>>>>>>>9":U
     2204      tt_price-all.pdf-db          COLUMN-LABEL "БД!ДНЦ" FORMAT ">>>>9":U
     2205      tt_price-all.out-code        COLUMN-LABEL "Переоценка! " FORMAT "x(16)":U
     2206      tt_price-all.status_         COLUMN-LABEL "Статус! " FORMAT "x(6)":U
     2207      tt_price-all.cli-base-rate   COLUMN-LABEL "Крат-!ность" FORMAT ">>9.9":U
     2208    ENABLE tt_price-all.status_
     2209       WITH NO-ROW-MARKERS SEPARATORS SIZE 99 BY 16.04 FIT-LAST-COLUMN.
     2210   DEFINE FRAME Dialog-Frame
     2211        B-quit AT ROW 1 COL 1
     2212        B-save AT ROW 1 COL 11
     2213        B-pdf AT ROW 1 COL 21
     2214        B-price-doc AT ROW 1 COL 32
     2215        B-print AT ROW 1 COL 43
     2216        B-Help AT ROW 1 COL 90
     2217        B-color AT ROW 1.13 COL 86.5
     2218        R-actual AT ROW 2.21 COL 7.25 NO-LABEL
     2219        R-main-code AT ROW 2.21 COL 34.38 NO-LABEL
     2220        R-obj AT ROW 2.21 COL 61.5 NO-LABEL
     2221        BROWSE-3 AT ROW 2.96 COL 1
     2222        v-node-name AT ROW 19.25 COL 9 COLON-ALIGNED WIDGET-ID 2
     2223        v-full-pay-name AT ROW 20.25 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     2224        "Объекты:" VIEW-AS TEXT
     2225             SIZE 8.5 BY .67 AT ROW 2.21 COL 53.13
     2226             FGCOLOR 4
     2227        "Цены:" VIEW-AS TEXT
     2228             SIZE 5.38 BY .67 AT ROW 2.21 COL 1.88
     2229             FGCOLOR 4
     2230        "БКоды:" VIEW-AS TEXT
     2231             SIZE 6.5 BY .67 AT ROW 2.21 COL 27.88
     2232             FGCOLOR 4
     2233        SPACE(65.86) SKIP(18.94)
     2234       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2235            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2236            TITLE "Цены товара"
     2237            DEFAULT-BUTTON B-save CANCEL-BUTTON B-quit.
     2238   ASSIGN
     2239          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2240          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2241   ASSIGN
     2242          v-full-pay-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2243   ASSIGN
     2244          v-node-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2245   ON GO OF FRAME Dialog-Frame
     2246   DO:
     2247     run uf-set in this-procedure(
     2248       input  'color-p':U
     2249       ,input v-cntxt-userid
     2250       ,input string(is-color)
     2251       ,input v-uf-Naim
     2252       ,input v-uf-print-graft
     2253       ,input v-uf-sort-gr
     2254       ,input v-uf-type-price
     2255       ,input v-uf-type-val
     2256   ) no-error    .
     2257   END.
     2258   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2259   DO:
     2260     APPLY "END-ERROR":U TO SELF.
     2261   END.
     2262   ON CHOOSE OF B-color IN FRAME Dialog-Frame
     2263   DO:
     2264     if B-color:IMAGE  = "cmp/nocol.bmp" then
     2265     do:
     2266       B-color:LOAD-IMAGE-UP("cmp/color.bmp") in frame Dialog-Frame  .
     2267       is-color = true .
     2268       run OpenBr in this-procedure .
     2269     end.
     2270     else do:
     2271        B-color:LOAD-IMAGE-UP("cmp/nocol.bmp") in frame Dialog-Frame  .
     2272        is-color = false  .
     2273        run OpenBr in this-procedure .
     2274     end.
     2275   END.
     2276   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
     2277   OR HELP OF FRAME Dialog-Frame
     2278   DO:
     2279   END.
     2280   ON CHOOSE OF B-pdf IN FRAME Dialog-Frame
     2281   DO:
     2282   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     2283   define variable v-rec-id as recid no-undo .
     2284   define variable v-recid as character no-undo .
     2285   define variable v-rec-list as character no-undo .
     2286   define variable br-handle      as handle no-undo.
     2287   define variable buffer-handle  as handle no-undo.
     2288   define variable next-prev      as logical no-undo .
     2289   define variable v-tt-recid as recid no-undo .
     2290   if not available tt_price-all then return .
     2291   if not available buf_price-doc-forming then return .
     2292   find first buf_price-doc-forming-gds where
     2293         buf_price-doc-forming-gds.pdf-db     =  tt_price-all.pdf-db  and
     2294         buf_price-doc-forming-gds.pdf-id     =  tt_price-all.pdf-id  and
     2295         buf_price-doc-forming-gds.plt-db-num =  tt_price-all.plt-db-num and
     2296         buf_price-doc-forming-gds.plt-id     =  tt_price-all.plt-id  and
     2297         buf_price-doc-forming-gds.b-code     =  tt_price-all.b-code
     2298         no-error .
     2299   if not available buf_price-doc-forming-gds then return .
     2300   v-rec-id = recid (buf_price-doc-forming) .
     2301     assign
     2302       v-rec-id      = recid (buf_price-doc-forming)
     2303       next-prev     = yes
     2304       br-handle     = BROWSE-3:handle
     2305       buffer-handle = buffer buf_price-doc-forming :handle .
     2306       .
     2307     do while next-prev = yes :
     2308         if not available buf_price-doc-forming then do:
     2309           message "Неправильно выбран документ ДНЦ." view-as alert-box error.
     2310           return no-apply.
     2311         end.
     2312         run str/df-price.w
     2313           ( input parparentproc,
     2314             input 'ПРОСМОТР':U ,
     2315             input buf_price-doc-forming.plt-id ,
     2316             input buf_price-doc-forming.plt-db-num ,
     2317             input recid(buf_price-doc-forming-gds) ,
     2318             output v-rec-list  ,
     2319             input-output v-rec-id  ,
     2320             input-output br-handle ,
     2321             input-output buffer-handle ,
     2322             input-output next-prev
     2323             ) .
     2324             v-tt-recid = recid(tt_price-all) .
     2325     end.
     2326     assign r-obj.
     2327     run openbr in this-procedure .
     2328     reposition BROWSE-3 to recid v-tt-recid no-error .
     2329   END.
     2330   ON CHOOSE OF B-price-doc IN FRAME Dialog-Frame
     2331   DO:
     2332   if not available tt_price-all then return .
     2333   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     2334   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     2335   define variable v-rec-id as recid no-undo .
     2336   define variable v-recid as character no-undo .
     2337   if not available tt_price-all then return .
     2338   if tt_price-all.out-code = "" then return .
     2339   define variable doc-rec as recid no-undo .
     2340   define variable next-prev as logical   no-undo .
     2341   define buffer buf_price-doc for ub.price-doc  .
     2342   define buffer buf_price-list for ub.price-list  .
     2343   for each  buf_price-doc no-lock where
     2344             buf_price-doc.doc-num     =  tt_price-all.out-code
     2345              :
     2346       find first buf_price-list no-lock where
     2347                 buf_price-list.doc-num = buf_price-doc.doc-num and
     2348                 buf_price-list.price-type = "" and
     2349                 buf_price-list.b-code  = tt_price-all.b-code no-error .
     2350       if available buf_price-list then  do:
     2351         doc-rec = recid(buf_price-doc).
     2352       end.
     2353     run str/pr-lkp.p
     2354     ( input parParentProc   ,
     2355       input doc-rec ) .
     2356      return .
     2357   end.
     2358   END.
     2359   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2360   DO:
     2361     find current tt_price-all no-lock no-error .
     2362     if not available tt_price-all then return .
     2363     run proc-print .
     2364   END.
     2365   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
     2366   DO:
     2367   define variable cur-clmn-loc as integer   no-undo .
     2368   define variable column-handle as handle no-undo .
     2369   define variable v-list as character no-undo .
     2370     assign
     2371       cur-clmn-loc  = 1
     2372       column-handle = BROWSE-3:first-column
     2373       v-list        = column-handle:label + "#"
     2374     .
     2375     do while valid-handle(column-handle) :
     2376       if cur-clmn-loc = BROWSE-3:num-columns then do:
     2377         leave .
     2378       end.
     2379       assign
     2380         column-handle = column-handle:NEXT-COLUMN
     2381         cur-clmn-loc  = cur-clmn-loc + 1
     2382         v-list        = v-list + column-handle:label + "#"
     2383       .
     2384     end.
     2385      v-list = trim(v-list, "#") .
     2386      define variable v-i        as integer   no-undo .
     2387      define variable v-pos      as integer   no-undo .
     2388      define variable v-list-new as character no-undo .
     2389      define variable v-elem     as character no-undo .
     2390      repeat v-i = 1 to BROWSE-3:num-columns :
     2391         v-elem = entry ( v-i , v-list , "#" ) .
     2392         v-pos  = lookup ( v-elem , 'Приор!итет'  + '#' +  'Бар-код'  + '#' +  'Ед!изм'  + '#' +  'Вал!п/л'  + '#' +  'Объект! '  + '#' +  'Ф!к'  + '#' +  'Курс!док-та'  + '#' +  'Цена в вал!прайс-листа'  + '#' +  'Ф!б'  + '#' +  'Курс!баз.вал' + '#' +  'Цена в !баз.вал' + '#' +  'Цена в !РУБ' + '#' +  'Действие!с ' + '#' +  'См!с' + '#' +  'Время!c' + '#' +  'Действие!по ' + '#' +  'См!по' + '#' +  'Время!по' + '#' +  'Покупатели! ' + '#' +  'Интервал!группы' + '#' +  'Тип платежа! ' + '#' +  'ТПЛ! ' + '#' +  'БД!ТПЛ' + '#' +  'ДНЦ! ' + '#' +  'БД!ДНЦ' + '#' +  'Переоценка! ' + '#' +  'Статус! ' + '#' +  'Крат-!ность' , "#") .
     2393         v-list-new = v-list-new + string(v-pos) + "," .
     2394      end.
     2395      define variable v-list-str as character no-undo .
     2396      define variable v-1 as integer   no-undo .
     2397      v-list-str = "" .
     2398      v-1 = num-entries(v-list-new)  .
     2399      repeat v-i = 1 to v-1 :
     2400         v-elem = entry(v-i , v-list-new ) .
     2401         if int(v-elem) > 0 then
     2402         v-list-str  = v-list-str + v-elem + "," .
     2403      end.
     2404      v-list-new = trim(v-list-str ,",")  +  chr(4)
     2405                 + string(decimal( tt_price-all.price-sale     :width in browse BROWSE-3)) +  chr(4)
     2406                 + string(decimal( tt_price-all.price-sale-rubl:width in browse BROWSE-3)) +  chr(4)
     2407                 + string(decimal( tt_price-all.price-sale-base:width in browse BROWSE-3)) +  chr(4)
     2408                 + string(decimal( tt_price-all.grp-name       :width in browse BROWSE-3)) +  chr(4)
     2409                 + string(decimal( tt_price-all.interv-name    :width in browse BROWSE-3)) +  chr(4)
     2410                 + string(decimal( tt_price-all.pay-name       :width in browse BROWSE-3)) +  chr(4)
     2411                 .
     2412   run uf-set in this-procedure(
     2413       input  'mpl-gds-p':U
     2414       ,input v-cntxt-userid
     2415       ,input v-list-new
     2416       ,input v-uf-Naim
     2417       ,input v-uf-print-graft
     2418       ,input v-uf-sort-gr
     2419       ,input v-uf-type-price
     2420       ,input v-uf-type-val
     2421   ) no-error    .
     2422       if error-status :error then
     2423       message
     2424         vss-workfile vss-revision vss-description skip
     2425         error-status :get-message(1) skip
     2426         return-value skip
     2427         "uf-set"
     2428         view-as alert-box error
     2429       .
     2430     run uf-set in this-procedure(
     2431       input  'color-p':U
     2432       ,input v-cntxt-userid
     2433       ,input string(is-color)
     2434       ,input v-uf-Naim
     2435       ,input v-uf-print-graft
     2436       ,input v-uf-sort-gr
     2437       ,input v-uf-type-price
     2438       ,input v-uf-type-val
     2439   ) no-error    .
     2440   END.
     2441   ON ROW-DISPLAY OF BROWSE-3 IN FRAME Dialog-Frame
     2442   DO:
     2443   if is-color = false then return .
     2444   define variable v-color  as integer   no-undo .
     2445   define variable v-color2 as integer   no-undo .
     2446      case tt_price-all.type-price :
     2447           when  integer('0':U) then do:
     2448               v-color = ?.
     2449           end.
     2450           when  integer('2':U) then do:
     2451               v-color = dark_green_color.
     2452           end.
     2453           when  integer('1':U) then do:
     2454               v-color = DARK_GREY_COLOR.
     2455           end.
     2456           when  integer('3':U) then do:
     2457               v-color =  blue_color .
     2458           end.
     2459      end case.
     2460      case tt_price-all.main-indication :
     2461           when  integer('0':U) then do:
     2462               if tt_price-all.plt-priority = 0 then v-color2 = ?.
     2463                                                else v-color2 = 8.
     2464           end.
     2465           when  integer('2':U) then do:
     2466               v-color2 = 11.
     2467           end.
     2468           when  integer('3':U) then do:
     2469               v-color2 = 10.
     2470           end.
     2471           when  integer('4':U) then do:
     2472               v-color2 =  14 .
     2473           end.
     2474      end case.
     2475       tt_price-all.plt-priority :fgcolor in browse BROWSE-3 = v-color.
     2476       tt_price-all.b-code :fgcolor in browse BROWSE-3 = v-color.
     2477       buf_currency.curr-abbr :fgcolor in browse BROWSE-3 = v-color.
     2478       tt_price-all.price-sale:bgcolor in browse BROWSE-3 = v-color2.
     2479   END.
     2480   ON VALUE-CHANGED OF BROWSE-3 IN FRAME Dialog-Frame
     2481   DO:
     2482     v-node-name = "" .
     2483     v-full-pay-name  = "" .
     2484     if available  tt_price-all then do:
     2485           find first buf_bar-code no-lock where buf_bar-code.b-code = tt_price-all.b-code no-error .
     2486           find first buf_gds-prt no-lock where
     2487                      buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     2488           if available buf_gds-prt then
     2489              v-node-name = buf_gds-prt.f-name.
     2490           if num-entries (tt_price-all.pay-name,":") = 2 then do:
     2491              case entry (1, tt_price-all.pay-name,":") :
     2492               when 'Оплата':U then do:
     2493                   find first buf_pay-type no-lock where buf_pay-type.obj-code = int (entry (2, tt_price-all.pay-name,":")) no-error .
     2494                   if available buf_pay-type
     2495                     then v-full-pay-name = 'Оплата':U + ": " +  buf_pay-type.obj-name.
     2496                     else v-full-pay-name = "" .
     2497               end.
     2498               when 'Касс.платеж':U then do:
     2499                   find first buf_cash-pay no-lock where
     2500                              buf_cash-pay.cdpay-code = integer (entry (1,(entry (2, tt_price-all.pay-name,":")),"_" )) and
     2501                              buf_cash-pay.curr-code  = integer (entry (2,(entry (2, tt_price-all.pay-name,":")),"_" ))
     2502                              no-error .
     2503                   if available buf_cash-pay
     2504                     then v-full-pay-name = 'Касс.платеж':U + ": " + buf_cash-pay.obj-name.
     2505                     else v-full-pay-name = "" .
     2506               end.
     2507              end case.
     2508           end.
     2509     end.
     2510     DISPLAY v-node-name v-full-pay-name  WITH FRAME Dialog-Frame.
     2511   END.
     2512   ON VALUE-CHANGED OF R-actual IN FRAME Dialog-Frame
     2513   DO:
     2514       ASSIGN r-obj.
     2515       ASSIGN r-actual.
     2516     run OpenBr in this-procedure .
     2517   END.
     2518   ON VALUE-CHANGED OF R-main-code IN FRAME Dialog-Frame
     2519   DO:
     2520       ASSIGN r-obj.
     2521       ASSIGN r-main-code.
     2522     run OpenBr in this-procedure .
     2523   END.
     2524   ON VALUE-CHANGED OF R-obj IN FRAME Dialog-Frame
     2525   DO:
     2526     define variable  p-user-select as logical   no-undo .
     2527     ASSIGN r-obj.
     2528     v-obj-type = p-obj-type .
     2529     v-obj-code = p-obj-code .
     2530     IF r-obj = 3 THEN DO:
     2531     run userobjs_select-one (
     2532     input parparentproc    ,
     2533     input v-cntxt-db-num   ,
     2534     input v-cntxt-userid  ,
     2535     input v-cntxt-host-code-obj ,
     2536     input p-obj-type ,
     2537     input p-obj-code ,
     2538     output p-user-select ,
     2539     output v-obj-type ,
     2540     output v-obj-code )
     2541     no-error .
     2542     if error-status :error or v-obj-type = "" or v-obj-type = ? then
     2543       assign
     2544         v-obj-type = p-obj-type
     2545         v-obj-code = p-obj-code
     2546       .
     2547     END.
     2548   IF r-obj = 1 then do:
     2549      frame Dialog-Frame:TITLE = SUBSTITUTE( "Цены товара : &1 &2 " , buf_goods.artic , buf_goods.gds-name) .
     2550   end.
     2551   else do:
     2552      frame Dialog-Frame:TITLE = SUBSTITUTE( "Цены товара : &1 &2 на объекте &3 &4 " , buf_goods.artic , buf_goods.gds-name , v-obj-type , v-obj-code) .
     2553   end.
     2554     run OpenBr in this-procedure .
     2555   END.
     2556   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2557   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2558   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2559   on help of frame Dialog-Frame
     2560   do:
     2561     run gbl/app_help.p
     2562       (input this-procedure :file-name
     2563       ,input ''
     2564       ,input ?
     2565       ) no-error.
     2566     if error-status :error then do:
     2567       message
     2568         "Ошибка при вызове помощи"
     2569         error-status :get-message(1)
     2570         view-as alert-box .
     2571     end.
     2572   end.
     2573   run minbtn-set in this-procedure .
     2574   on choose of b-help in frame Dialog-Frame
     2575   do:
     2576     apply "help":u to frame Dialog-Frame .
     2577   end.
     2578   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2579   procedure minbtn-set :
     2580       do
     2581           on error undo, return error return-value
     2582           :
     2583           define variable ii              as integer       no-undo .
     2584           define variable fh              as widget-handle no-undo .
     2585           define variable hh              as widget-handle no-undo .
     2586           define variable v-h             as handle        extent 4 no-undo .
     2587           define variable v-name-button   as character     no-undo .
     2588           define variable v-help-old-x    as decimal       no-undo .
     2589           define variable v-help-old-y    as decimal       no-undo .
     2590           define variable v-help-old-size as decimal       no-undo .
     2591           define variable v-frame-width   as decimal       no-undo .
     2592           define variable jj              as integer       no-undo .
     2593           do
     2594               on error undo, return error
     2595               :
     2596               assign
     2597                   v-frame-width = frame Dialog-Frame:width - 0.3
     2598                   fh            = frame Dialog-Frame:first-child
     2599                   hh            = fh:first-child
     2600                   ii            = 1
     2601                   .
     2602               do while valid-handle(hh):
     2603                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2604                   do:
     2605                       case lc(hh:name) :
     2606                           when "b-help" then
     2607                               do:
     2608                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2609                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2610                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2611                                   hh:TOOLTIP = "Помощь" .
     2612                                   v-help-old-x = hh:column .
     2613                                   v-help-old-y = hh:row    .
     2614                                   v-help-old-size = hh:width .
     2615                                   hh:width-chars = 2.5 .
     2616                               end.
     2617                           when "b-print" then
     2618                               do:
     2619                                   hh:load-image("cmp/b-print.bmp":u) .
     2620                                   hh:TOOLTIP = "Печать" .
     2621                                   v-h[ii] = hh:handle .
     2622                                   ii = ii + 1 .
     2623                                   hh:width-chars = 3 .
     2624                               end.
     2625                           when "b-history" or
     2626                           when "b-hist" then
     2627                               do:
     2628                                   hh:load-image("cmp/b-hist.bmp":u) .
     2629                                   hh:TOOLTIP = "История" .
     2630                                   v-h[ii] = hh:handle .
     2631                                   ii = ii + 1 .
     2632                                   hh:width-chars = 3 .
     2633                               end.
     2634                           when "b-sch" then
     2635                               do:
     2636                                   hh:load-image("cmp/b-sch.bmp":u) .
     2637                                   hh:TOOLTIP = "Установка Фильтра" .
     2638                                   v-h[ii] = hh:handle .
     2639                                   ii = ii + 1 .
     2640                                   hh:width-chars = 3 .
     2641                               end.
     2642                           when "b-hist-user" then
     2643                               do:
     2644                                   hh:load-image("cmp/b-hist.bmp":u) .
     2645                                   hh:TOOLTIP = "История пользователя" .
     2646                                   ii = ii + 1 .
     2647                               end.
     2648                       end case.
     2649                   end.
     2650                   hh = hh:next-sibling.
     2651               end.
     2652               b-help:column = v-frame-width - b-help:width-chars.
     2653               jj = 0.
     2654               repeat ii = 4 to 1 by -1 :
     2655                   if valid-handle (v-h[ii] ) then
     2656                   do:
     2657                       jj  = jj + 1 .
     2658                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2659                       v-h[ii]:row    = v-help-old-y .
     2660                   end.
     2661               end.
     2662           end.
     2663       end.
     2664   end procedure.
     2665   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2666   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2667   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2668   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2669   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2670   define variable v-diasize-current-frame-height as decimal   no-undo .
     2671   define variable v-diasize-change-size          as logical   no-undo .
     2672   define variable v-diasize-resize-button        as handle    no-undo .
     2673   define variable v-diasize-wndmax               as logical   no-undo .
     2674   define variable v-diasize-wndstore             as logical   no-undo .
     2675   define variable v-diasize-proc-name            as character no-undo .
     2676   define variable v-diasize-browse-handle        as handle    no-undo .
     2677   define variable v-diasize-browse-number        as integer   no-undo .
     2678   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2679   define temp-table temp-diasize-handle no-undo
     2680     field handle-value  as handle
     2681     field save-position as decimal
     2682     index xpk is primary unique handle-value
     2683     .
     2684   define temp-table temp-browse-handle no-undo
     2685     field browse-type   as character
     2686     field browse-number as integer
     2687     field browse-handle as handle
     2688     field original-size as decimal
     2689     index xpk is primary unique browse-type browse-number
     2690     index xie browse-type browse-handle
     2691   .
     2692   procedure diasize_change-height :
     2693     define input  parameter p-change-value  as decimal   no-undo .
     2694     define input  parameter p-move-resize   as logical   no-undo .
     2695     define variable v-field-group-handle    as handle    no-undo .
     2696     define variable v-object-handle         as handle    no-undo .
     2697     define variable v-frame-height          as decimal   no-undo .
     2698     define variable v-frame-virtual-height  as decimal   no-undo .
     2699     define variable v-browse-height         as decimal   no-undo .
     2700     define variable v-window-height         as decimal   no-undo .
     2701     define variable v-window-virtual-height as decimal   no-undo .
     2702     define variable v-change-sign           as integer   no-undo .
     2703     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2704     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2705     if p-change-value > 0
     2706     then do:
     2707       if frame Dialog-Frame :height + p-change-value
     2708           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2709       then do:
     2710         assign
     2711           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2712                           - (frame Dialog-Frame :height-chars)
     2713         .
     2714         if p-change-value <= 0
     2715         then do:
     2716           run diasize_position-resize-button in this-procedure .
     2717           return .
     2718         end.
     2719       end.
     2720     end.
     2721     if p-change-value < 0
     2722     then do:
     2723       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2724       then do:
     2725         assign
     2726           p-change-value = v-diasize-orig-frame-height
     2727                          - (frame Dialog-Frame :height-chars)
     2728         .
     2729         if p-change-value >= 0
     2730         then do:
     2731           run diasize_position-resize-button in this-procedure .
     2732           return .
     2733         end.
     2734       end.
     2735     end.
     2736     if p-change-value >= 0
     2737     then do:
     2738       assign
     2739         v-change-sign = 1
     2740       .
     2741     end.
     2742     else do:
     2743       assign
     2744         v-change-sign = -1
     2745       .
     2746     end.
     2747     assign
     2748       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2749     .
     2750     if p-change-value = 0
     2751     then do:
     2752       run diasize_position-resize-button in this-procedure .
     2753       return .
     2754     end.
     2755     move_block:
     2756     do
     2757     on error undo move_block, retry move_block
     2758     :
     2759       if retry
     2760       then do:
     2761         do
     2762         on error undo move_block, leave move_block
     2763         :
     2764           if p-change-value > 0
     2765           then do:
     2766             for each buf_temp-diasize-handle
     2767             on error undo, next
     2768             :
     2769               assign
     2770                 v-object-handle = buf_temp-diasize-handle.handle-value
     2771               .
     2772               if v-object-handle <> v-diasize-resize-button
     2773               then do:
     2774                 assign
     2775                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2776                 .
     2777               end.
     2778             end.
     2779             assign
     2780               v-diasize-browse-handle :height = v-browse-height
     2781             .
     2782             for each buf_temp-browse-handle
     2783               where buf_temp-browse-handle.browse-type = 'height':u
     2784             on error undo, next
     2785             :
     2786               assign
     2787                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2788               .
     2789             end.
     2790             assign
     2791               frame Dialog-Frame :height = v-frame-height
     2792             .
     2793             if frame Dialog-Frame :scrollable = true
     2794             then do:
     2795               assign
     2796                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2797               .
     2798             end.
     2799             run diasize_position-resize-button in this-procedure .
     2800           end.
     2801           else do:
     2802             if frame Dialog-Frame :scrollable = true
     2803             then do:
     2804               assign
     2805                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2806               .
     2807             end.
     2808             assign
     2809               frame Dialog-Frame :height = v-frame-height
     2810             .
     2811             assign
     2812               v-diasize-browse-handle :height = v-browse-height
     2813             .
     2814             for each buf_temp-browse-handle
     2815               where buf_temp-browse-handle.browse-type = 'height':u
     2816             on error undo, next
     2817             :
     2818               assign
     2819                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2820               .
     2821             end.
     2822             for each buf_temp-diasize-handle
     2823             on error undo, next
     2824             :
     2825               assign
     2826                 v-object-handle = buf_temp-diasize-handle.handle-value
     2827               .
     2828               if v-object-handle <> v-diasize-resize-button
     2829               then do:
     2830                 assign
     2831                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2832                 .
     2833               end.
     2834             end.
     2835             run diasize_position-resize-button in this-procedure .
     2836           end.
     2837           assign
     2838             v-diasize-change-size = false
     2839           .
     2840           leave move_block .
     2841         end.
     2842       end.
     2843       assign
     2844         v-diasize-need-full-display = true
     2845       .
     2846       if v-diasize-change-size = false
     2847       then do:
     2848         assign
     2849           v-diasize-change-size = true
     2850         .
     2851       end.
     2852       else do:
     2853         return .
     2854       end.
     2855       assign
     2856         v-frame-height = frame Dialog-Frame :height
     2857         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2858         v-browse-height = v-diasize-browse-handle :height
     2859       .
     2860       for each buf_temp-browse-handle
     2861         where buf_temp-browse-handle.browse-type = 'height':u
     2862       :
     2863         assign
     2864           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2865         .
     2866       end.
     2867       for each buf_temp-diasize-handle
     2868       :
     2869         delete buf_temp-diasize-handle .
     2870       end.
     2871       assign
     2872         v-field-group-handle = frame Dialog-Frame :first-child
     2873       .
     2874       do while valid-handle(v-field-group-handle)
     2875       :
     2876         assign
     2877           v-object-handle = v-field-group-handle :first-child
     2878         .
     2879         do while valid-handle(v-object-handle)
     2880         :
     2881           if  v-object-handle <> v-diasize-browse-handle :handle
     2882           and can-query(v-object-handle, "row")
     2883           and can-query(v-object-handle, "height")
     2884           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2885           then do:
     2886             find first buf_temp-browse-handle
     2887               where buf_temp-browse-handle.browse-type   = 'height':u
     2888                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2889               no-error .
     2890             if available buf_temp-browse-handle
     2891             then do:
     2892             end.
     2893             else do:
     2894               create buf_temp-diasize-handle .
     2895               assign
     2896                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2897                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2898               .
     2899             end.
     2900           end.
     2901           assign
     2902             v-object-handle = v-object-handle :next-sibling
     2903           .
     2904         end.
     2905         assign
     2906           v-field-group-handle = v-field-group-handle :next-sibling
     2907         .
     2908       end.
     2909       do with frame Dialog-Frame
     2910       :
     2911         hide v-diasize-resize-button .
     2912         assign
     2913           v-diasize-resize-button :row    = 1
     2914           v-diasize-resize-button :column = 1
     2915         .
     2916       end.
     2917       if p-change-value > 0
     2918       then do:
     2919         if frame Dialog-Frame :scrollable = true
     2920         then do:
     2921           assign
     2922             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2923             no-error .
     2924           if error-status :error
     2925           or error-status :get-message(1) <> ""
     2926           then do:
     2927             undo move_block, retry move_block .
     2928           end.
     2929         end.
     2930         assign
     2931           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2932           no-error .
     2933         if error-status :error
     2934         or error-status :get-message(1) <> ""
     2935         then do:
     2936           undo move_block, retry move_block .
     2937         end.
     2938         assign
     2939           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2940           no-error .
     2941         if error-status :error
     2942         or error-status :get-message(1) <> ""
     2943         then do:
     2944           undo move_block, retry move_block .
     2945         end.
     2946         for each buf_temp-browse-handle
     2947           where buf_temp-browse-handle.browse-type = 'height':u
     2948         on error undo move_block, retry move_block
     2949         :
     2950           assign
     2951             buf_temp-browse-handle.browse-handle :height
     2952               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2953             no-error .
     2954           if error-status :error
     2955           or error-status :get-message(1) <> ""
     2956           then do:
     2957             undo move_block, retry move_block .
     2958           end.
     2959         end.
     2960         for each buf_temp-diasize-handle
     2961         on error undo move_block, retry move_block
     2962         :
     2963           assign
     2964             v-object-handle = buf_temp-diasize-handle.handle-value
     2965           .
     2966           if v-object-handle <> v-diasize-resize-button
     2967           then do:
     2968             assign
     2969               v-object-handle :row = v-object-handle :row + p-change-value
     2970               no-error .
     2971             if error-status :error
     2972             or error-status :get-message(1) <> ""
     2973             then do:
     2974               undo move_block, retry move_block .
     2975             end.
     2976           end.
     2977         end.
     2978       end.
     2979       else do:
     2980         for each buf_temp-diasize-handle
     2981         on error undo move_block, retry move_block
     2982         :
     2983           assign
     2984             v-object-handle = buf_temp-diasize-handle.handle-value
     2985           .
     2986           if v-object-handle <> v-diasize-resize-button
     2987           then do:
     2988             assign
     2989               v-object-handle :row = v-object-handle :row + p-change-value
     2990               no-error .
     2991             if error-status :error
     2992             or error-status :get-message(1) <> ""
     2993             then do:
     2994               undo move_block, retry move_block .
     2995             end.
     2996           end.
     2997         end.
     2998         assign
     2999           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3000           no-error .
     3001         if error-status :error
     3002         or error-status :get-message(1) <> ""
     3003         then do:
     3004           undo move_block, retry move_block .
     3005         end.
     3006         for each buf_temp-browse-handle
     3007           where buf_temp-browse-handle.browse-type = 'height':u
     3008         on error undo move_block, retry move_block
     3009         :
     3010           assign
     3011             buf_temp-browse-handle.browse-handle :height
     3012               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3013             no-error .
     3014           if error-status :error
     3015           or error-status :get-message(1) <> ""
     3016           then do:
     3017             undo move_block, retry move_block .
     3018           end.
     3019         end.
     3020         assign
     3021           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3022           no-error .
     3023         if error-status :error
     3024         or error-status :get-message(1) <> ""
     3025         then do:
     3026           undo move_block, retry move_block .
     3027         end.
     3028         if frame Dialog-Frame :scrollable = true
     3029         then do:
     3030           assign
     3031             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3032             no-error .
     3033           if error-status :error
     3034           or error-status :get-message(1) <> ""
     3035           then do:
     3036             undo move_block, retry move_block .
     3037           end.
     3038         end.
     3039       end.
     3040       if p-move-resize = true
     3041       then do:
     3042         run diasize_position-resize-button in this-procedure .
     3043       end.
     3044       if v-diasize-wndstore = true
     3045       then do:
     3046         if connected("ub") = true
     3047         then do:
     3048           define variable v-cntxt-db-num        as integer   no-undo .
     3049           define variable v-cntxt-userid        as character no-undo .
     3050           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3051                                             , OUTPUT v-cntxt-userid
     3052                                             ) .
     3053           run gbl/wndsizew.p
     3054             (input  v-cntxt-db-num
     3055             ,input  v-cntxt-userid
     3056             ,input  v-diasize-proc-name
     3057             ,input  'height':u
     3058             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3059             ) .
     3060         end.
     3061       end.
     3062     end.
     3063     assign
     3064       v-diasize-change-size = false
     3065     .
     3066   end procedure.
     3067   procedure diasize_set-height :
     3068     define input  parameter p-new-height  as decimal   no-undo .
     3069     define input  parameter p-move-resize as logical   no-undo .
     3070     do
     3071     on error undo, return error return-value
     3072     :
     3073       run diasize_change-height in this-procedure
     3074         (input  (p-new-height - frame Dialog-Frame :height)
     3075         ,input  p-move-resize
     3076         ) .
     3077     end.
     3078   end procedure.
     3079   procedure diasize_change-width :
     3080     define input  parameter p-change-value as decimal   no-undo .
     3081     define input  parameter p-move-resize  as logical   no-undo .
     3082     define variable v-field-group-handle   as handle    no-undo .
     3083     define variable v-object-handle        as handle    no-undo .
     3084     define variable v-frame-width          as decimal   no-undo .
     3085     define variable v-frame-virtual-width  as decimal   no-undo .
     3086     define variable v-browse-width         as decimal   no-undo .
     3087     define variable v-window-width         as decimal   no-undo .
     3088     define variable v-window-virtual-width as decimal   no-undo .
     3089     define variable v-change-sign          as integer   no-undo .
     3090     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3091     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3092     if p-change-value > 0
     3093     then do:
     3094       if frame Dialog-Frame :width + p-change-value >
     3095           session :width-chars
     3096       then do:
     3097         assign
     3098           p-change-value = session :width-chars - frame Dialog-Frame :width
     3099         .
     3100         if p-change-value <= 0
     3101         then do:
     3102           run diasize_position-resize-button in this-procedure .
     3103           return .
     3104         end.
     3105       end.
     3106     end.
     3107     if p-change-value < 0
     3108     then do:
     3109       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3110       then do:
     3111         assign
     3112           p-change-value = v-diasize-orig-frame-width
     3113                          - frame Dialog-Frame :width
     3114         .
     3115         if p-change-value >= 0
     3116         then do:
     3117           run diasize_position-resize-button in this-procedure .
     3118           return .
     3119         end.
     3120       end.
     3121     end.
     3122     if p-change-value >= 0
     3123     then do:
     3124       assign
     3125         v-change-sign = 1
     3126       .
     3127     end.
     3128     else do:
     3129       assign
     3130         v-change-sign = -1
     3131       .
     3132     end.
     3133     assign
     3134       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3135     .
     3136     if p-change-value = 0
     3137     then do:
     3138       run diasize_position-resize-button in this-procedure .
     3139       return .
     3140     end.
     3141     move_block:
     3142     do
     3143     on error undo move_block, leave move_block
     3144     :
     3145       if retry
     3146       then do:
     3147         do
     3148         on error undo move_block, leave move_block
     3149         :
     3150           if p-change-value > 0
     3151           then do:
     3152             for each buf_temp-diasize-handle
     3153             on error undo, next
     3154             :
     3155               assign
     3156                 v-object-handle = buf_temp-diasize-handle.handle-value
     3157               .
     3158               if v-object-handle <> v-diasize-resize-button
     3159               then do:
     3160                 assign
     3161                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3162                 .
     3163               end.
     3164             end.
     3165             assign
     3166               v-diasize-browse-handle :width = v-browse-width
     3167             .
     3168             for each buf_temp-browse-handle
     3169               where buf_temp-browse-handle.browse-type = 'width':u
     3170             on error undo, next
     3171             :
     3172               assign
     3173                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3174               .
     3175             end.
     3176             assign
     3177               frame Dialog-Frame :width = v-frame-width
     3178             .
     3179             if frame Dialog-Frame :scrollable = true
     3180             then do:
     3181               assign
     3182                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3183               .
     3184             end.
     3185             run diasize_position-resize-button in this-procedure .
     3186           end.
     3187           else do:
     3188             if frame Dialog-Frame :scrollable = true
     3189             then do:
     3190               assign
     3191                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3192               .
     3193             end.
     3194             assign
     3195               frame Dialog-Frame :width = v-frame-width
     3196             .
     3197             for each buf_temp-browse-handle
     3198               where buf_temp-browse-handle.browse-type = 'width':u
     3199             on error undo, next
     3200             :
     3201               assign
     3202                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3203               .
     3204             end.
     3205             assign
     3206               v-diasize-browse-handle :width = v-browse-width
     3207             .
     3208             for each buf_temp-diasize-handle
     3209             on error undo, next
     3210             :
     3211               assign
     3212                 v-object-handle = buf_temp-diasize-handle.handle-value
     3213               .
     3214               if v-object-handle <> v-diasize-resize-button
     3215               then do:
     3216                 assign
     3217                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3218                 .
     3219               end.
     3220             end.
     3221             run diasize_position-resize-button in this-procedure .
     3222           end.
     3223           assign
     3224             v-diasize-change-size = false
     3225           .
     3226           leave move_block .
     3227         end.
     3228       end.
     3229       assign
     3230         v-diasize-need-full-display = true
     3231       .
     3232       if v-diasize-change-size = false
     3233       then do:
     3234         assign
     3235           v-diasize-change-size = true
     3236         .
     3237       end.
     3238       else do:
     3239         return .
     3240       end.
     3241       assign
     3242         v-frame-width = frame Dialog-Frame :width
     3243         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3244         v-browse-width = v-diasize-browse-handle :width
     3245       .
     3246       for each buf_temp-browse-handle
     3247         where buf_temp-browse-handle.browse-type = 'width':u
     3248       :
     3249         assign
     3250           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3251         .
     3252       end.
     3253       for each buf_temp-diasize-handle
     3254       :
     3255         delete buf_temp-diasize-handle .
     3256       end.
     3257       assign
     3258         v-field-group-handle = frame Dialog-Frame :first-child
     3259       .
     3260       do while valid-handle(v-field-group-handle)
     3261       :
     3262         assign
     3263           v-object-handle = v-field-group-handle :first-child
     3264         .
     3265         do while valid-handle(v-object-handle)
     3266         :
     3267           if  v-object-handle <> v-diasize-browse-handle :handle
     3268           and v-object-handle <> v-diasize-resize-button
     3269           and can-query(v-object-handle, "row")
     3270           and can-query(v-object-handle, "height")
     3271           and ( v-object-handle :col + v-object-handle :width
     3272                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3273               )
     3274           then do:
     3275             find first buf_temp-browse-handle
     3276               where buf_temp-browse-handle.browse-type   = 'width':u
     3277                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3278               no-error .
     3279             if available buf_temp-browse-handle
     3280             then do:
     3281             end.
     3282             else do:
     3283               create buf_temp-diasize-handle .
     3284               assign
     3285                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3286                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3287               .
     3288             end.
     3289           end.
     3290           assign
     3291             v-object-handle = v-object-handle :next-sibling
     3292           .
     3293         end.
     3294         assign
     3295           v-field-group-handle = v-field-group-handle :next-sibling
     3296         .
     3297       end.
     3298       do with frame Dialog-Frame
     3299       :
     3300         hide v-diasize-resize-button .
     3301         v-diasize-resize-button :row = 1.
     3302         v-diasize-resize-button :column = 1.
     3303       end.
     3304       if p-change-value > 0
     3305       then do:
     3306         if frame Dialog-Frame :scrollable = true
     3307         then do:
     3308           assign
     3309             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3310             no-error .
     3311           if error-status :error
     3312           or error-status :get-message(1) <> ""
     3313           then do:
     3314             undo move_block, retry move_block.
     3315           end.
     3316         end.
     3317         assign
     3318           frame Dialog-Frame :width = v-frame-width + p-change-value
     3319           no-error .
     3320         if error-status :error
     3321         or error-status :get-message(1) <> ""
     3322         then do:
     3323           undo move_block, retry move_block.
     3324         end.
     3325         assign
     3326           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3327         no-error .
     3328         if error-status :error
     3329         or error-status :get-message(1) <> ""
     3330         then do:
     3331           undo move_block, retry move_block.
     3332         end.
     3333         for each buf_temp-browse-handle
     3334           where buf_temp-browse-handle.browse-type = 'width':u
     3335         on error undo move_block, retry move_block
     3336         :
     3337           assign
     3338             buf_temp-browse-handle.browse-handle :width
     3339               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3340             no-error .
     3341           if error-status :error
     3342           or error-status :get-message(1) <> ""
     3343           then do:
     3344             undo move_block, retry move_block .
     3345           end.
     3346         end.
     3347         for each buf_temp-diasize-handle
     3348         on error undo move_block, retry move_block
     3349         :
     3350           assign
     3351             v-object-handle = buf_temp-diasize-handle.handle-value
     3352           .
     3353           if v-object-handle <> v-diasize-resize-button
     3354           then do:
     3355             assign
     3356               v-object-handle :col = v-object-handle :col + p-change-value
     3357               no-error .
     3358             if error-status :error
     3359             or error-status :get-message(1) <> ""
     3360             then do:
     3361               undo move_block, retry move_block .
     3362             end.
     3363           end.
     3364         end.
     3365       end.
     3366       else do:
     3367         for each buf_temp-diasize-handle
     3368         on error undo move_block, retry move_block
     3369         :
     3370           assign
     3371             v-object-handle = buf_temp-diasize-handle.handle-value
     3372           .
     3373           if v-object-handle <> v-diasize-resize-button
     3374           then do:
     3375             assign
     3376               v-object-handle :col = v-object-handle :col + p-change-value
     3377               no-error .
     3378             if error-status :error
     3379             or error-status :get-message(1) <> ""
     3380             then do:
     3381               undo move_block, retry move_block .
     3382             end.
     3383           end.
     3384         end.
     3385         for each buf_temp-browse-handle
     3386           where buf_temp-browse-handle.browse-type = 'width':u
     3387         on error undo move_block, retry move_block
     3388         :
     3389           assign
     3390             buf_temp-browse-handle.browse-handle :width
     3391               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3392             no-error .
     3393           if error-status :error
     3394           or error-status :get-message(1) <> ""
     3395           then do:
     3396             undo move_block, retry move_block .
     3397           end.
     3398         end.
     3399         assign
     3400           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3401           no-error .
     3402         if error-status :error
     3403         or error-status :get-message(1) <> ""
     3404         then do:
     3405           undo move_block, retry move_block.
     3406         end.
     3407         assign
     3408           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3409         no-error .
     3410         if error-status :error
     3411         or error-status :get-message(1) <> ""
     3412         then do:
     3413           undo move_block, retry move_block.
     3414         end.
     3415         if frame Dialog-Frame :scrollable = true
     3416         then do:
     3417           assign
     3418             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3419           no-error .
     3420           if error-status :error
     3421           or error-status :get-message(1) <> ""
     3422           then do:
     3423             undo move_block, retry move_block.
     3424           end.
     3425         end.
     3426       end.
     3427       if p-move-resize
     3428       then do:
     3429         run diasize_position-resize-button in this-procedure .
     3430       end.
     3431       if v-diasize-wndstore = true
     3432       then do:
     3433         if connected("ub") = true
     3434         then do:
     3435           define variable v-cntxt-db-num        as integer   no-undo .
     3436           define variable v-cntxt-userid        as character no-undo .
     3437           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3438                                             , OUTPUT v-cntxt-userid
     3439                                             ) .
     3440           run gbl/wndsizew.p
     3441             (input  v-cntxt-db-num
     3442             ,input  v-cntxt-userid
     3443             ,input  v-diasize-proc-name
     3444             ,input  'width':u
     3445             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3446             ) .
     3447         end.
     3448       end.
     3449     end.
     3450     assign
     3451       v-diasize-change-size = false
     3452     .
     3453   end procedure.
     3454   procedure diasize_set-width :
     3455     define input  parameter p-new-width  as decimal   no-undo .
     3456     define input  parameter p-move-resize as logical   no-undo .
     3457     do
     3458     on error undo, return error return-value
     3459     :
     3460       run diasize_change-width in this-procedure
     3461         (input  (p-new-width - frame Dialog-Frame :width)
     3462         ,input  p-move-resize
     3463         ) .
     3464     end.
     3465   end procedure.
     3466   procedure diasize_position-resize-button :
     3467     do with frame Dialog-Frame
     3468     :
     3469       hide v-diasize-resize-button .
     3470       assign
     3471         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3472                     - 1
     3473                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3474         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3475                     - 1
     3476                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3477       .
     3478       view v-diasize-resize-button .
     3479     end.
     3480   end procedure.
     3481   on alt-right anywhere
     3482   do:
     3483     run diasize_change-width in this-procedure
     3484       (input 1
     3485       ,input true
     3486       ) .
     3487     return no-apply .
     3488   end.
     3489   on alt-left anywhere
     3490   do:
     3491     run diasize_change-width in this-procedure
     3492       (input -1
     3493       ,input true
     3494       ) .
     3495     return no-apply .
     3496   end.
     3497   on alt-down anywhere
     3498   do:
     3499     run diasize_change-height in this-procedure
     3500       (input 1
     3501       ,input true
     3502       ) .
     3503     return no-apply .
     3504   end.
     3505   on alt-up anywhere
     3506   do:
     3507     run diasize_change-height in this-procedure
     3508       (input -1
     3509       ,input true
     3510       ) .
     3511     return no-apply .
     3512   end.
     3513   on alt-enter of frame Dialog-Frame
     3514   do:
     3515     run diasize_maximize in this-procedure
     3516       (input  ?
     3517       ).
     3518     return no-apply .
     3519   end.
     3520   procedure diasize_end-move :
     3521     do
     3522     on error undo, return error return-value
     3523     :
     3524       define variable v-row-delta as decimal   no-undo .
     3525       define variable v-col-delta as decimal   no-undo .
     3526       define variable v-new-row as decimal   no-undo .
     3527       define variable v-new-col as decimal   no-undo .
     3528       assign
     3529         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3530         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3531       .
     3532       assign
     3533         v-row-delta = v-new-row - frame Dialog-Frame :height
     3534         v-col-delta = v-new-col - frame Dialog-Frame :width
     3535       .
     3536       run diasize_change-height in this-procedure
     3537         (input v-row-delta
     3538         ,input true
     3539         ) .
     3540       run diasize_change-width in this-procedure
     3541         (input v-col-delta
     3542         ,input true
     3543         ) .
     3544     end.
     3545   end procedure.
     3546   procedure diasize_maximize :
     3547     define input  parameter p-action as logical   no-undo .
     3548     do
     3549     on error undo, return error return-value
     3550     :
     3551       if p-action = ?
     3552       then do:
     3553         if v-diasize-need-maximize = true
     3554         then do:
     3555           assign
     3556             p-action = true
     3557           .
     3558         end.
     3559         else do:
     3560           assign
     3561             p-action = false
     3562           .
     3563         end.
     3564       end.
     3565       if p-action = true
     3566       then do:
     3567         run diasize_change-height in this-procedure
     3568           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3569               - frame Dialog-Frame :height-chars
     3570           ,input true
     3571           ) .
     3572         run diasize_change-width in this-procedure
     3573           (input session :width-chars
     3574               - frame Dialog-Frame :width-chars
     3575           ,input true
     3576           ) .
     3577         assign
     3578           v-diasize-need-maximize = false
     3579         .
     3580       end.
     3581       else do:
     3582         run diasize_change-width in this-procedure
     3583           (input v-diasize-orig-frame-width
     3584               - frame Dialog-Frame :width-chars
     3585           ,input true
     3586           ) .
     3587         run diasize_change-height in this-procedure
     3588           (input v-diasize-orig-frame-height
     3589               - frame Dialog-Frame :height-chars
     3590           ,input true
     3591           ) .
     3592         assign
     3593           v-diasize-need-maximize = true
     3594         .
     3595       end.
     3596     end.
     3597   end procedure.
     3598   procedure diasize_restore-orig-size :
     3599     do
     3600     on error undo, return error return-value
     3601     :
     3602       assign
     3603         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3604         v-diasize-current-frame-height = frame Dialog-Frame :height
     3605       .
     3606       run diasize_set-height in this-procedure
     3607         (input  v-diasize-orig-frame-height
     3608         ,input  true
     3609         ) .
     3610       run diasize_set-width in this-procedure
     3611         (input  v-diasize-orig-frame-width
     3612         ,input  true
     3613         ) .
     3614     end.
     3615   end procedure.
     3616   procedure diasize_restore-current-size :
     3617     do
     3618     on error undo, return error return-value
     3619     :
     3620       run diasize_set-height in this-procedure
     3621         (input  v-diasize-current-frame-height
     3622         ,input  true
     3623         ) .
     3624       run diasize_set-width in this-procedure
     3625         (input  v-diasize-current-frame-width
     3626         ,input  true
     3627         ) .
     3628     end.
     3629   end procedure.
     3630   procedure diasize_set-browse-handle :
     3631     define input  parameter p-browse-handle as handle   no-undo .
     3632     define buffer buf_temp-browse-handle for temp-browse-handle .
     3633     do
     3634     on error undo, return error return-value
     3635     :
     3636       assign
     3637         v-diasize-browse-handle = p-browse-handle
     3638       .
     3639       for each buf_temp-browse-handle
     3640       on error undo, return error return-value
     3641       :
     3642         delete buf_temp-browse-handle .
     3643       end.
     3644     end.
     3645   end procedure.
     3646   procedure diasize_add_browse :
     3647     define input  parameter p-browse-type   as character no-undo .
     3648     define input  parameter p-browse-handle as handle    no-undo .
     3649     define buffer buf_temp-browse-handle for temp-browse-handle .
     3650     do
     3651     on error undo, return error return-value
     3652     :
     3653       assign
     3654         v-diasize-browse-number = v-diasize-browse-number + 1
     3655       .
     3656       create buf_temp-browse-handle .
     3657       assign
     3658         buf_temp-browse-handle.browse-type   = p-browse-type
     3659         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3660         buf_temp-browse-handle.browse-handle = p-browse-handle
     3661       .
     3662     end.
     3663   end procedure.
     3664   procedure diasize_init :
     3665     define variable v-default-value    as logical   no-undo .
     3666     define variable v-restore-saved    as logical   no-undo .
     3667     define variable v-resize-value-str as character no-undo .
     3668     do
     3669     on error undo, return error return-value
     3670     :
     3671       do with frame Dialog-Frame
     3672       :
     3673         assign
     3674           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3675           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3676           v-diasize-browse-handle     = browse BROWSE-3 :handle
     3677         .
     3678         create button v-diasize-resize-button
     3679         assign
     3680           parent        = frame Dialog-Frame :first-child
     3681           label         = "s"
     3682           height-pixels = 16
     3683           width-pixels  = 16
     3684           visible       = true
     3685           sensitive     = true
     3686           movable       = true
     3687           triggers:
     3688             on end-move persistent run diasize_end-move in this-procedure .
     3689           end triggers.
     3690         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3691         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3692         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3693         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3694         assign
     3695           v-diasize-wndmax = false
     3696         .
     3697         if connected("ub") = true
     3698         then do:
     3699           define variable v-cntxt-db-num        as integer   no-undo .
     3700           define variable v-cntxt-userid        as character no-undo .
     3701           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3702                                             , OUTPUT v-cntxt-userid
     3703                                             ) .
     3704           run gbl/wndpar_r.p
     3705             (input  v-cntxt-db-num
     3706             ,input  v-cntxt-userid
     3707             ,input  'wndmax':U
     3708             ,output v-diasize-wndmax
     3709             ,output v-default-value
     3710             ) .
     3711         end.
     3712         assign
     3713           v-diasize-wndstore = false
     3714         .
     3715         if connected("ub") = true
     3716         then do:
     3717           run gbl/wndpar_r.p
     3718             (input  v-cntxt-db-num
     3719             ,input  v-cntxt-userid
     3720             ,input  'wndstore':U
     3721             ,output v-diasize-wndstore
     3722             ,output v-default-value
     3723             ) .
     3724         end.
     3725         assign
     3726           v-diasize-proc-name = entry(1, program-name(2), '.')
     3727         .
     3728         if v-diasize-wndstore = true
     3729         then do:
     3730           assign
     3731             v-restore-saved = false
     3732           .
     3733           if connected("ub") = true
     3734           then do:
     3735             run gbl/wndsizer.p
     3736               (input  v-cntxt-db-num
     3737               ,input  v-cntxt-userid
     3738               ,input  v-diasize-proc-name
     3739               ,input  'height':u
     3740               ,output v-resize-value-str
     3741               ) .
     3742             if v-resize-value-str <> '':U
     3743             then do:
     3744               run diasize_change-height in this-procedure
     3745                 (input  integer(v-resize-value-str)
     3746                 ,input  true
     3747                 ) .
     3748               assign
     3749                 v-restore-saved = true
     3750               .
     3751             end.
     3752           end.
     3753           if connected("ub") = true
     3754           then do:
     3755             run gbl/wndsizer.p
     3756               (input  v-cntxt-db-num
     3757               ,input  v-cntxt-userid
     3758               ,input  v-diasize-proc-name
     3759               ,input  'width':u
     3760               ,output v-resize-value-str
     3761               ) .
     3762             if v-resize-value-str <> '':U
     3763             then do:
     3764               run diasize_change-width in this-procedure
     3765                 (input  integer(v-resize-value-str)
     3766                 ,input  true
     3767                 ) .
     3768               assign
     3769                 v-restore-saved = true
     3770               .
     3771             end.
     3772           end.
     3773           if v-restore-saved <> true
     3774           then do:
     3775             if v-diasize-wndmax = true
     3776             then do:
     3777               run diasize_maximize in this-procedure
     3778                 (input  true
     3779                 ) .
     3780             end.
     3781           end.
     3782         end.
     3783         else do:
     3784           if v-diasize-wndmax = true
     3785           then do:
     3786             run diasize_maximize in this-procedure
     3787               (input  true
     3788               ) .
     3789           end.
     3790         end.
     3791       end.
     3792     end.
     3793   end procedure.
     3794   procedure diasize_need-full-display :
     3795     define output parameter p-need-full-display as logical   no-undo .
     3796     do
     3797     on error undo, return error return-value
     3798     :
     3799       assign
     3800         p-need-full-display = v-diasize-need-full-display
     3801       .
     3802       assign
     3803         v-diasize-need-full-display = false
     3804       .
     3805     end.
     3806   end procedure.
     3807   procedure get-context :
     3808      define output parameter p-db-num as integer          no-undo.
     3809      define output parameter p-user-id as character        no-undo.
     3810      define variable v-login               as character    no-undo.
     3811      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3812      define buffer buf_user-login  for ub.user-login .
     3813      do
     3814      on error undo, return error
     3815      :
     3816            FIND FIRST buf_sys-ctrl no-lock.
     3817            ASSIGN
     3818               v-login = USERID("ub")
     3819               p-db-num = buf_sys-ctrl.db-num
     3820            .
     3821            FIND FIRST buf_user-login
     3822                 WHERE buf_user-login.db-num = p-db-num
     3823                   AND buf_user-login.user-login = v-login
     3824                 no-lock
     3825                 no-error
     3826                 .
     3827            IF AVAILABLE buf_user-login
     3828            THEN DO:
     3829               assign
     3830                  p-user-id = buf_user-login.user-id
     3831               .
     3832            END.
     3833      end.
     3834   end procedure.
     3835       run diasize_init in this-procedure .
     3836   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3837   on f5 of frame Dialog-Frame anywhere
     3838   do:
     3839     run OpenBr in this-procedure .
     3840       apply "VALUE-CHANGED" to BROWSE-3.
     3841   end.
     3842   def var sort-labelBROWSE-3   as character no-undo .
     3843   def var sort-clmnBROWSE-3    as handle    no-undo .
     3844   def var cur-clmnBROWSE-3     as handle    no-undo .
     3845   def var cur-clmn-locBROWSE-3 as integer   no-undo .
     3846   def var re-queryBROWSE-3     as logical   initial no no-undo .
     3847   on start-search, ctrl-o of BROWSE-3 in frame Dialog-Frame do:
     3848      run sort-brBROWSE-3
     3849        (input (if available tt_price-all
     3850                then recid(tt_price-all)
     3851                else ?
     3852               )
     3853        ).
     3854   end.
     3855   PROCEDURE sort-brBROWSE-3 :
     3856     define input parameter p-recid as recid no-undo .
     3857     if re-queryBROWSE-3 = no then do:
     3858       assign
     3859          cur-clmnBROWSE-3 = BROWSE-3:current-column in frame Dialog-Frame
     3860       .
     3861       if sort-clmnBROWSE-3 <> ? then sort-clmnBROWSE-3:column-fgcolor = 0.
     3862       if cur-clmnBROWSE-3 = sort-clmnBROWSE-3 then do:
     3863         assign
     3864            sort-labelBROWSE-3 = ""
     3865            sort-clmnBROWSE-3 = ?
     3866         .
     3867        end.
     3868        else do:
     3869          assign
     3870            sort-labelBROWSE-3 = cur-clmnBROWSE-3:label
     3871            sort-clmnBROWSE-3  = cur-clmnBROWSE-3
     3872            sort-clmnBROWSE-3:column-fgcolor = 4
     3873          .
     3874        end.
     3875      end.
     3876     assign
     3877       cur-clmn-locBROWSE-3 = 1
     3878     .
     3879     def var column-handle as handle no-undo .
     3880     column-handle = BROWSE-3:first-column.
     3881     do while valid-handle(column-handle) :
     3882       if column-handle = cur-clmnBROWSE-3 then do:
     3883         leave .
     3884       end.
     3885       column-handle = column-handle:NEXT-COLUMN.
     3886       assign
     3887         cur-clmn-locBROWSE-3 = cur-clmn-locBROWSE-3 + 1
     3888       .
     3889     end.
     3890     case sort-labelBROWSE-3:
     3891           when 'Приор!итет'  then DO:    assign       sort-column-name = "tt_price-all.plt-priority"     .     run OpenBr .   . END.
     3892           when 'Бар-код'  then DO:    assign       sort-column-name = "tt_price-all.b-code"     .     run OpenBr .   . END.
     3893           when 'Ед!изм'  then DO:    assign       sort-column-name = "tt_price-all.unit-cli"     .     run OpenBr .   . END.
     3894           when 'Вал!п/л'  then DO:    assign       sort-column-name = "buf_currency.curr-abbr"     .     run OpenBr .   . END.
     3895           when 'Объект! '  then DO:    assign       sort-column-name = "tt_price-all.obj-code"     .     run OpenBr .   . END.
     3896           when 'Ф!к'  then DO:    assign       sort-column-name = "tt_price-all.plt-fix-cource-crc-doc"     .     run OpenBr .   . END.
     3897           when 'Курс!док-та'  then DO:    assign       sort-column-name = "tt_price-all.pdf-exch-rate"     .     run OpenBr .   . END.
     3898           when 'Цена в вал!прайс-листа'  then DO:    assign       sort-column-name = "tt_price-all.price-sale"     .     run OpenBr .   . END.
     3899           when 'Ф!б'  then DO:    assign       sort-column-name = "tt_price-all.plt-fix-cource-crc-base"     .     run OpenBr .   . END.
     3900           when 'Курс!баз.вал'  then DO:    assign       sort-column-name = "tt_price-all.pdf-base-rate"     .     run OpenBr .   . END.
     3901           when 'Цена в !баз.вал'  then DO:    assign       sort-column-name = "tt_price-all.price-sale-base"     .     run OpenBr .   . END.
     3902           when 'Цена в !РУБ'  then DO:    assign       sort-column-name = "tt_price-all.price-sale-rubl"     .     run OpenBr .   . END.
     3903           when 'Действие!с '  then DO:    assign       sort-column-name = "tt_price-all.date-1"     .     run OpenBr .   . END.
     3904           when 'См!с'  then DO:    assign       sort-column-name = "tt_price-all.shift-1"     .     run OpenBr .   . END.
     3905           when 'Время!c'  then DO:    assign       sort-column-name = "tt_price-all.time-1"     .     run OpenBr .   . END.
     3906           when 'Действие!по '  then DO:    assign       sort-column-name = "tt_price-all.date-2"     .     run OpenBr .   . END.
     3907           when 'См!по'  then DO:    assign       sort-column-name = "tt_price-all.shift-2"     .     run OpenBr .   . END.
     3908           when 'Время!по'  then DO:    assign       sort-column-name = "tt_price-all.time-2"     .     run OpenBr .   . END.
     3909           when 'Покупатели! '  then DO:    assign       sort-column-name = "tt_price-all.grp-name"     .     run OpenBr .   . END.
     3910           when 'Интервал!группы'  then DO:    assign       sort-column-name = "tt_price-all.interv-name"     .     run OpenBr .   . END.
     3911           when 'Тип платежа! '  then DO:    assign       sort-column-name = "tt_price-all.pay-name"     .     run OpenBr .   . END.
     3912           when 'ТПЛ! '  then DO:    assign       sort-column-name = "tt_price-all.plt-id"     .     run OpenBr .   . END.
     3913           when 'БД!ТПЛ'  then DO:    assign       sort-column-name = "tt_price-all.plt-db-num"     .     run OpenBr .   . END.
     3914           when 'ДНЦ! '  then DO:    assign       sort-column-name = "tt_price-all.pdf-id"     .     run OpenBr .   . END.
     3915           when 'БД!ДНЦ'  then DO:    assign       sort-column-name = "tt_price-all.pdf-db"     .     run OpenBr .   . END.
     3916           when 'Переоценка! '  then DO:    assign       sort-column-name = "tt_price-all.out-code"     .     run OpenBr .   . END.
     3917           when 'Статус! '  then DO:    assign       sort-column-name = "tt_price-all.status_"     .     run OpenBr .   . END.
     3918           when 'Крат-!ность'  then DO:    assign       sort-column-name = "tt_price-all.cli-base-rate"     .     run OpenBr .   . END.
     3919       otherwise do:
     3920         assign
     3921           sort-column-name = ""
     3922         .
     3923         run OpenBr .
     3924           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-3') then do:
     3925             run mv-brw-defaultBROWSE-3.
     3926           end.
     3927         if sort-labelBROWSE-3 <> "" then do:
     3928           assign
     3929             cur-clmnBROWSE-3:column-fgcolor = 0
     3930           .
     3931         end.
     3932         assign
     3933           cur-clmn-locBROWSE-3 = ?
     3934         .
     3935       end.
     3936     end case.
     3937       if cur-clmn-locBROWSE-3 <> ? then do:
     3938         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-3') then do:
     3939           run ch-clmnBROWSE-3 in this-procedure (cur-clmn-locBROWSE-3).
     3940         end.
     3941       end.
     3942     if p-recid <> ? then do:
     3943       reposition BROWSE-3 to recid p-recid no-error.
     3944       apply "value-changed" to BROWSE-3 in frame Dialog-Frame.
     3945     end.
     3946     apply "entry" to BROWSE-3 in frame Dialog-Frame.
     3947   END PROCEDURE.
     3948   procedure re-open-query-srt-clmnBROWSE-3:
     3949   if cur-clmnBROWSE-3 = ? then do:
     3950      run OpenBr .
     3951   end.
     3952   else do:
     3953      assign re-queryBROWSE-3 = yes.
     3954      run sort-brBROWSE-3
     3955        (input (if available tt_price-all
     3956                then recid(tt_price-all)
     3957                else ?
     3958               )
     3959        ).
     3960      assign re-queryBROWSE-3 = no.
     3961   end.
     3962   end.
     3963   MAIN-BLOCK:
     3964   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3965      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3966     run init_proc in this-procedure .
     3967     run enable_ui in this-procedure .
     3968     run OpenBr in this-procedure .
     3969     tt_price-all.price-sale:resizable       in browse BROWSE-3 = true .
     3970     tt_price-all.price-sale-rubl:resizable  in browse BROWSE-3 = true .
     3971     tt_price-all.price-sale-base:resizable  in browse BROWSE-3 = true .
     3972     tt_price-all.grp-name:resizable  in browse BROWSE-3 = true .
     3973     tt_price-all.interv-name:resizable  in browse BROWSE-3 = true .
     3974     tt_price-all.pay-name:resizable  in browse BROWSE-3 = true .
     3975     tt_price-all.price-sale     :width     in browse BROWSE-3   = v-size-col1 .
     3976     tt_price-all.price-sale-rubl:width     in browse BROWSE-3   = v-size-col2 .
     3977     tt_price-all.price-sale-base:width     in browse BROWSE-3   = v-size-col3 .
     3978     tt_price-all.grp-name       :width     in browse BROWSE-3   = v-size-col4 .
     3979     tt_price-all.interv-name    :width     in browse BROWSE-3   = v-size-col5 .
     3980     tt_price-all.pay-name       :width     in browse BROWSE-3   = v-size-col6 .
     3981   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3982   DEF VAR cur-clmn-numBROWSE-3 as INT EXTENT 28 no-undo.
     3983   DEF VAR varmviBROWSE-3       as INT no-undo.
     3984   DEF VAR varmvjBROWSE-3       as INT no-undo.
     3985   DEF VAR varmvkBROWSE-3       as INT no-undo.
     3986   DEF VAR varmvlBROWSE-3       as INT no-undo.
     3987   DEF VAR move-elementBROWSE-3 as INT no-undo.
     3988   def var jjBROWSE-3           as int no-undo.
     3989   do varmviBROWSE-3 = 1 to EXTENT(cur-clmn-numBROWSE-3):
     3990     ASSIGN cur-clmn-numBROWSE-3[varmviBROWSE-3] = varmviBROWSE-3.
     3991   END.
     3992   RUN start-mv-clmnBROWSE-3.
     3993   PROCEDURE start-mv-clmnBROWSE-3:
     3994   def var old-session as logical no-undo.
     3995      old-session = SESSION:IMMEDIATE-DISPLAY.
     3996      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3997          IF  true = true   THEN DO:
     3998      DO jjBROWSE-3 = NUM-ENTRIES(v-order-col) TO 1 BY -1:
     3999        RUN re-move-clmnBROWSE-3 ( cur-clmn-numBROWSE-3[INTEGER(ENTRY (jjBROWSE-3, v-order-col))] , 1).
     4000      END.
     4001          END.
     4002      SESSION:IMMEDIATE-DISPLAY = old-session.
     4003   END.
     4004   ON ctrl-cursor-right OF BROWSE BROWSE-3 do:
     4005     RUN re-move-clmnBROWSE-3 ( 1, 28).
     4006   END.
     4007   ON ctrl-cursor-left OF BROWSE BROWSE-3 do:
     4008     RUN re-move-clmnBROWSE-3 (28, 1).
     4009   END.
     4010   PROCEDURE re-move-clmnBROWSE-3:
     4011     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4012     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4013     DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
     4014       if cur-clmn-numBROWSE-3[varmviBROWSE-3] = source-column THEN cur-clmn-numBROWSE-3[varmviBROWSE-3] = -1.
     4015     END.
     4016     if BROWSE-3:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4017     if source-column > target-column THEN
     4018     DO varmvjBROWSE-3 = source-column - 1 to target-column BY -1:
     4019       DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
     4020           if cur-clmn-numBROWSE-3[varmviBROWSE-3] = varmvjBROWSE-3 THEN DO:
     4021             cur-clmn-numBROWSE-3[varmviBROWSE-3] = cur-clmn-numBROWSE-3[varmviBROWSE-3] + 1.
     4022           END.
     4023       END.
     4024     END.
     4025     ELSE
     4026     DO varmvjBROWSE-3 = source-column + 1 to target-column:
     4027       DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
     4028         if cur-clmn-numBROWSE-3[varmviBROWSE-3] = varmvjBROWSE-3 THEN DO:
     4029           cur-clmn-numBROWSE-3[varmviBROWSE-3] = cur-clmn-numBROWSE-3[varmviBROWSE-3] - 1.
     4030         END.
     4031       END.
     4032     END.
     4033     DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
     4034       if cur-clmn-numBROWSE-3[varmviBROWSE-3] = -1 THEN cur-clmn-numBROWSE-3[varmviBROWSE-3] = target-column.
     4035     END.
     4036   END PROCEDURE.
     4037   PROCEDURE ch-clmnBROWSE-3:
     4038     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4039     if cur-clmn-loc <= 1 then do:
     4040       return .
     4041     end.
     4042     DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
     4043       if cur-clmn-numBROWSE-3[varmviBROWSE-3] = cur-clmn-loc THEN move-elementBROWSE-3 = varmviBROWSE-3.
     4044     END.
     4045     RUN re-move-clmnBROWSE-3 (cur-clmn-loc, 1).
     4046   END PROCEDURE.
     4047   PROCEDURE mv-brw-defaultBROWSE-3:
     4048   def var old-session as logical no-undo.
     4049     old-session = SESSION:IMMEDIATE-DISPLAY.
     4050     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4051     do varmvlBROWSE-3 = 1 to EXTENT(cur-clmn-numBROWSE-3):
     4052       RUN re-move-clmnBROWSE-3 (cur-clmn-numBROWSE-3[varmvlBROWSE-3], varmvlBROWSE-3).
     4053     END.
     4054     RUN start-mv-clmnBROWSE-3.
     4055     SESSION:IMMEDIATE-DISPLAY = old-session.
     4056   END PROCEDURE.
     4057   .
     4058     tt_price-all.status_:read-only in browse BROWSE-3 = true .
     4059     hide b-save in frame Dialog-Frame .
     4060     B-quit:label = "Выход"  .
     4061     wait-for go of frame Dialog-Frame.
     4062   end.
     4063   run disable_ui in this-procedure .
     4064   PROCEDURE disable_UI :
     4065     HIDE FRAME Dialog-Frame.
     4066   END PROCEDURE.
     4067   PROCEDURE enable_UI :
     4068     DISPLAY R-actual R-main-code R-obj v-node-name v-full-pay-name
     4069         WITH FRAME Dialog-Frame.
     4070     ENABLE B-quit B-save B-pdf B-price-doc B-print B-Help B-color R-actual
     4071            R-main-code R-obj BROWSE-3 v-node-name v-full-pay-name
     4072         WITH FRAME Dialog-Frame.
     4073     VIEW FRAME Dialog-Frame.
     4074   END PROCEDURE.
     4075   PROCEDURE init_proc :
     4076   define variable glog as logical no-undo .
     4077   v-obj-code = p-obj-code .
     4078   v-obj-type = p-obj-type .
     4079   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4080   do:
     4081     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4082       (input  v-cntxt-db-num
     4083       ,input  v-cntxt-userid
     4084       ,input  0
     4085       ,input  'actn_documents_all':U
