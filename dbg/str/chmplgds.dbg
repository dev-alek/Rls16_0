     1416   procedure prn-lib-prn-file :
     1417     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1418     define input parameter p-DIsabledoptions as integer no-undo .
     1419     define variable v-report-name as character no-undo .
     1420     define variable v-user-action as character no-undo .
     1421     define variable v-printed     as logical   no-undo .
     1422     define variable v-exist       as logical   no-undo .
     1423     do
     1424       on error undo, return error
     1425       :
     1426       run prn-lib-get-report-name  in this-procedure (
     1427         input parParentProc
     1428         ,output v-report-name
     1429         ).
     1430   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1432     (input  v-report-name
     1433     ,input  2
     1434     ,output v-exist
     1435     )  .
     1436       if NOT v-exist then
     1437       DO:
     1438         Message
     1439           "Нет заданий на печать ! "
     1440           view-as alert-box .
     1441         Return  .
     1442       End.
     1443       run gbl/prnfilen.w
     1444         (input  ""
     1445         ,input  p-DisabledOptions
     1446         ,input  string(v-report-name )
     1447         ,input  7
     1448         ,output v-user-action
     1449         ,output v-printed
     1450         ) .
     1451       if v-printed then
     1452       do:
     1453         return "YES" .
     1454       end.
     1455       else
     1456       do:
     1457         return "NO" .
     1458       end.
     1459     end.
     1460   end procedure.
     1461   procedure prn-lib-open-stream :
     1462     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1463     define input parameter p-page-size    as integer no-undo .
     1464     define input parameter p-is-stream    as logical no-undo .
     1465     define input parameter p-append       as logical no-undo .
     1466     define variable v-report-name as character no-undo .
     1467     do
     1468       on error undo, return error
     1469       :
     1470       run prn-lib-get-report-name  in this-procedure (
     1471         input parParentProc
     1472         ,output v-report-name
     1473         ).
     1474       if p-is-stream then
     1475       do:
     1476         if p-append then
     1477         do:
     1478           output stream PrnLibStream to value( v-report-name )
     1479             page-size value(p-page-size) append .
     1480         end.
     1481         if not p-append then
     1482         do:
     1483           output stream PrnLibStream to value( v-report-name )
     1484             page-size value(p-page-size) .
     1485         end.
     1486       end.
     1487       if not p-is-stream then
     1488       do:
     1489         if p-append then
     1490         do:
     1491           output to value( v-report-name )
     1492             page-size value(p-page-size) append .
     1493         end.
     1494         if not p-append then
     1495         do:
     1496           output to value( v-report-name )
     1497             page-size value(p-page-size) .
     1498         end.
     1499       end.
     1500     end.
     1501   end procedure.
     1502   procedure prn-lib-open-exp :
     1503     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1504     define input parameter p-is-stream    as logical no-undo .
     1505     define input parameter p-is-append    as logical no-undo .
     1506     define output parameter p-ReportFileName as char init "report" no-undo.
     1507     define output parameter p-process as logical no-undo .
     1508     define variable glog as logical no-undo .
     1509     do
     1510       on error undo, return error
     1511       :
     1512       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1513         TITLE      "Укажите путь"
     1514         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1515         ASK-OVERWRITE
     1516         CREATE-TEST-FILE
     1517         SAVE-AS
     1518         USE-FILENAME
     1519         DEFAULT-EXTENSION "txt"
     1520         UPDATE glog
     1521         .
     1522       if not glog then  return.
     1523       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1524       if p-is-stream then
     1525       do:
     1526         if p-is-append then
     1527         do:
     1528           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1529         end.
     1530         else
     1531         do:
     1532           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1533         end.
     1534       end.
     1535       else
     1536       do:
     1537         if p-is-append then
     1538         do:
     1539           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1540         end.
     1541         else
     1542         do:
     1543           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1544         end.
     1545       end.
     1546       p-process = yes.
     1547     end.
     1548   end procedure.
     1549   procedure prn-lib-get-report-name :
     1550     define input parameter parParentProc  as widget-handle no-undo.
     1551     define output parameter p-report-name as character no-undo .
     1552     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1553   end procedure.
     1554   procedure prn-lib-reportviewer-report-name :
     1555     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1556     define input parameter p-report-name-html as character no-undo .
     1557     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1558   end procedure.
     1559   procedure prn-lib-reportviewer :
     1560     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1561     define input parameter p-report-name-html as character no-undo .
     1562     define input parameter p-param        as character no-undo .
     1563     define variable v-excel           as character no-undo init 'TRUE' .
     1564     define variable v-value-character as character no-undo .
     1565     define variable v-value-integer   as character no-undo .
     1566     define variable v-value-date      as date      no-undo .
     1567     define variable v-value-decimal   as decimal   no-undo .
     1568     define variable rep-excel         as logical   no-undo .
     1569     define variable excel-string      as character no-undo .
     1570     define variable v-param-type      as character no-undo .
     1571     define variable v-tth             as handle    no-undo .
     1572     run adm/shattri.p (
     1573       input "get":U
     1574       ,input  ""
     1575       ,input  0
     1576       ,input  'report-glob':U
     1577       ,input  'rep-excel':U
     1578       ,output v-value-character
     1579       ,output v-value-date
     1580       ,output v-value-decimal
     1581       ,output v-value-integer
     1582       ,output rep-excel
     1583       ,output v-param-type
     1584       ,INPUT-OUTPUT table-handle v-tth
     1585       )  .
     1586     if rep-excel then v-excel = "TRUE" .
     1587     else v-excel = "FALSE" .
     1588     if p-param eq ""
     1589     then
     1590        p-param = "EXCEL:" + v-excel.
     1591     else
     1592        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1593     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1594   end procedure.
     1595   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   define variable v-waitfram-action01         as character   no-undo .
     1597   define variable v-waitfram-action02         as character   no-undo .
     1598   define variable v-waitfram-action03         as character   no-undo .
     1599   define variable mWaitFramTextBeg            as character   no-undo.
     1600   define variable mWaitFramTextEnd            as character   no-undo.
     1601   define variable mWaitFramView               as logical     no-undo.
     1602   define variable mWaitProcEvent              as logical     no-undo init yes.
     1603   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1604   define variable mWaitFramStop               as logical     no-undo.
     1605   define variable mWaitFramStopUser           as logical     no-undo.
     1606   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1607   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1608   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1609   define button B-WaitFramStop auto-end-key
     1610        label "Стоп"
     1611        size 10 by 1 tooltip "Остоновить процесс".
     1612   define button B-viewProcInfo
     1613        label "Информация"
     1614        size 15 by 1 tooltip "Информация о процесс".
     1615   define frame waitfram
     1616     v-waitfram-action01 format "x(72)" no-label skip
     1617     v-waitfram-action02 format "x(72)" no-label skip
     1618     v-waitfram-action03 format "x(72)" no-label skip
     1619     B-viewProcInfo
     1620     B-WaitFramStop at row 4 col 30
     1621     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1622     .
     1623   define new global shared variable mBatchMode as logical no-undo init ?.
     1624   define variable mFramBachModHandle as handle no-undo.
     1625   mFramBachModHandle = frame waitfram:handle.
     1626   define variable mFameOldVis as logical no-undo.
     1627   define variable mVisCUrentVin as logical no-undo.
     1628   if session:batch-mode
     1629   then
     1630      mBatchMode = yes.
     1631   if mBatchMode = ? then do:
     1632     mVisCUrentVin = current-window:visible.
     1633     mFameOldVis = mFramBachModHandle:visible.
     1634     mFramBachModHandle:visible  = yes.
     1635     mBatchMode = mFramBachModHandle:visible ne yes.
     1636     mFramBachModHandle:visible = mFameOldVis.
     1637     current-window:visible = mVisCUrentVin.
     1638   end.
     1639    if  log-manager:logfile-name ne ?
     1640     then DO:
     1641         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1642         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1643         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1644     end.
     1645   on choose of B-WaitFramStop in frame waitfram
     1646   do:
     1647     mWaitFramStop = yes.
     1648     mWaitFramStopUser = yes.
     1649   end.
     1650   function waitfram-check-timeout returns logical():
     1651      define variable vtime as int64 no-undo.
     1652      if mWaitFramStopTimeOut
     1653      then
     1654         return yes.
     1655      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1656      if     mWaitFramTimeOut ne ?
     1657         and mWaitFramTimeOut ne 0
     1658         and mWaitFramTimeOut lt vtime
     1659      then do:
     1660         mWaitFramStopTimeOut = yes.
     1661      end.
     1662      return mWaitFramStopTimeOut.
     1663   end.
     1664   procedure waitfram-hide :
     1665     if not session:batch-mode
     1666     then do
     1667     on error undo, return error return-value
     1668     :
     1669       pause 0 before-hide .
     1670       if not mBatchMode then
     1671         hide frame waitfram .
     1672     if     not mWaitFramView
     1673        and mWaitProcEvent
     1674     then
     1675       process events .
     1676     end.
     1677   end procedure.
     1678   procedure waitfram-show :
     1679     define input  parameter p-message as character no-undo .
     1680     define variable v-left-margin as integer   no-undo .
     1681     if not session:batch-mode
     1682     then do
     1683     on error undo, return error return-value
     1684     :
     1685       if length(p-message) <= 70 then do:
     1686         assign
     1687           v-left-margin = integer((70 - length(p-message)) / 2)
     1688         .
     1689         assign
     1690           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1691         .
     1692         assign
     1693           v-waitfram-action01 = " "
     1694           v-waitfram-action02 = " "
     1695                                    + fill(" ", v-left-margin)
     1696                                    + p-message
     1697           v-waitfram-action03 = " "
     1698         .
     1699       end.
     1700       else do:
     1701         define variable vRindex1 as integer no-undo.
     1702         define variable vRindex2 as integer no-undo.
     1703         vRindex1 = r-index(p-message," ",70).
     1704         if vRindex1 = 0
     1705         then
     1706            vRindex1 = 70.
     1707         if length(p-message)  <= vRindex1 + 70 then do:
     1708           assign
     1709             v-waitfram-action01 = " "
     1710             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1711             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1712           .
     1713         end.
     1714         else do:
     1715           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1716           if vRindex2 <= vRindex1
     1717           then
     1718              vRindex2 = vRindex1 + 70.
     1719           assign
     1720             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1721             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1722             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1723           .
     1724         end.
     1725       end.
     1726       B-viewProcInfo:visible   in frame waitfram = no.
     1727       B-viewProcInfo:sensitive in frame waitfram = no.
     1728       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1729       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1730       if  (   mWaitFramView
     1731          or  mWaitProcEvent)
     1732          and not mBatchMode
     1733       then
     1734          display
     1735             v-waitfram-action01 skip
     1736             v-waitfram-action02 skip
     1737             v-waitfram-action03 skip
     1738          with frame waitfram .
     1739       if     mWaitFramView
     1740          then do:
     1741             if     mWaitFramInterval ne ?
     1742                and not mBatchMode
     1743             then
     1744                wait-for go of frame waitfram pause mWaitFramInterval.
     1745          end.
     1746          else
     1747             if     mWaitProcEvent
     1748                and not mBatchMode
     1749             then
     1750                process events .
     1751     end.
     1752   end procedure.
     1753      procedure waitfram-show-this:
     1754         define input  parameter iInterval as int64 no-undo.
     1755         define variable vtime as int64 no-undo.
     1756         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1757         mWaitFramInterval = iInterval.
     1758         run waitfram-show (substitute("&1&2 &3&4" ,
     1759                                       mWaitFramTextBeg ,
     1760                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1761                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1762                                       mWaitFramTextEnd
     1763                                      )
     1764                           ).
     1765      end.
     1766      procedure WaitFramRunPause:
     1767         define input  parameter iInterval as dec no-undo.
     1768         define variable vStart  as datetime-tz no-undo.
     1769         define variable vend    as datetime-tz no-undo.
     1770         define variable vint as int64 no-undo.
     1771         define variable vOk as logical no-undo.
     1772         vStart = now.
     1773         vend   = vStart.
     1774         publish "WaitFramPause" (iInterval,output vOk).
     1775         vend   =  now.
     1776         vint = vend - vStart.
     1777         vint = iInterval - vint / 1000.
     1778         if     not mWaitFramStop
     1779            and (   vint > 0
     1780                 or (    not vOk
     1781                     and iInterval eq ?
     1782                     )
     1783                 )
     1784         then
     1785            run waitfram-show-this (iInterval).
     1786         vend   =  now.
     1787         vint = vend - vStart.
     1788         vint = iInterval - vint / 1000.
     1789         if     not mWaitFramStop
     1790            and vint > 0
     1791         then do:
     1792            run gbl/pause.p (vint * 1000).
     1793         end.
     1794         if iInterval ne ?
     1795         then
     1796            publish "WaitFramStop".
     1797         waitfram-check-timeout().
     1798      end.
     1799      procedure WaitFramWaitFor:
     1800         define input  parameter iInterval as dec no-undo.
     1801         assign
     1802            mWaitFramStartProc   = now
     1803            mWaitFramStopUser    = no
     1804            mWaitFramStopTimeOut = no
     1805         .
     1806         block-wait:
     1807         do while not mWaitFramStop:
     1808            run WaitFramRunPause (iInterval).
     1809            if  waitfram-check-timeout()
     1810            then do:
     1811               leave block-wait.
     1812            end.
     1813         end.
     1814         run waitfram-hide.
     1815      end.
     1816   procedure waitfram-join :
     1817     define input  parameter p-line-1  as character no-undo .
     1818     define input  parameter p-line-2  as character no-undo .
     1819     define input  parameter p-line-3  as character no-undo .
     1820     define output parameter p-message as character no-undo .
     1821     do
     1822     on error undo, return error return-value
     1823     :
     1824       assign
     1825         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1826                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1827                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1828       .
     1829     end.
     1830   end procedure.
     1831   function waitfram-join-function returns character
     1832     (input p-line-1 as character
     1833     ,input p-line-2 as character
     1834     ,input p-line-3 as character
     1835     ).
     1836     define variable v-message as character no-undo .
     1837     run waitfram-join in this-procedure
     1838       (input  p-line-1
     1839       ,input  p-line-2
     1840       ,input  p-line-3
     1841       ,output v-message
     1842       ) .
     1843     return v-message .
     1844   end function .
     1845   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1846   define variable c-point  as character no-undo .
     1847   define variable tbl      as character no-undo .
     1848   define variable join-tbl as character no-undo .
     1849   define variable fld      as character no-undo .
     1850   define variable lab      as character no-undo .
     1851   define variable spr      as character no-undo .
     1852   define variable dim      as character no-undo .
     1853   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1854   procedure fltfield-clear :
     1855     define output parameter loc-fld as character no-undo.
     1856     define output parameter loc-lab as character no-undo .
     1857     define output parameter loc-spr as character no-undo .
     1858     define output parameter loc-dim as character no-undo .
     1859     assign
     1860       loc-fld = ""
     1861       loc-lab = ""
     1862       loc-spr = ""
     1863       loc-dim = "0"
     1864     .
     1865   end procedure .
     1866   procedure fltfield-add :
     1867     define input        parameter par-fld as character no-undo.
     1868     define input        parameter par-lab as character no-undo .
     1869     define input        parameter par-spr as character no-undo .
     1870     define input-output parameter loc-fld as character no-undo.
     1871     define input-output parameter loc-lab as character no-undo .
     1872     define input-output parameter loc-spr as character no-undo .
     1873     define input-output parameter loc-dim as character no-undo .
     1874     do
     1875     on error undo, return error
     1876     :
     1877       assign
     1878       loc-fld = if loc-dim = '0'
     1879                 then par-fld
     1880                 else (loc-fld + chr(44) + par-fld)
     1881       loc-lab = if loc-dim = '0'
     1882                 then par-lab
     1883                 else (loc-lab + chr(44) + par-lab)
     1884       loc-spr = if loc-dim = '0'
     1885                 then par-spr
     1886                 else (loc-spr + chr(44) + par-spr)
     1887       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1888                 string(integer(if num-entries(loc-dim) > 1
     1889                               then entry(2, loc-dim)
     1890                               else entry(1, loc-dim)
     1891                               ) + 1)
     1892       no-error
     1893       .
     1894     end.
     1895   end procedure.
     1896   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1897   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1898   procedure fltopend_fltopend :
     1899   define input parameter p-parent-handle as handle no-undo .
     1900   define input parameter p-qh as handle no-undo .
     1901   define input parameter p-flt-open-open-query  as character no-undo .
     1902   define input parameter p-where-cond as character no-undo .
     1903   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1904   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1905   define input parameter p-indexed-reposition as character no-undo .
     1906     do
     1907     on error undo, return error
     1908     :
     1909   define variable v-prepare-string as character no-undo .
     1910   define variable glog as logical no-undo .
     1911   assign
     1912   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1913                      p-where-cond + chr(32)  +
     1914                      p-use-indFIRST-query-tail + chr(32) +
     1915                      p-use-ind-sort-clmn-by + chr(32) +
     1916                      p-indexed-reposition
     1917   .
     1918   assign
     1919   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1920   if not glog
     1921   or error-status:error then do:
     1922     message error-status:get-message(1) view-as alert-box .
     1923     undo, return error .
     1924   end.
     1925   assign
     1926   glog = p-qh:query-open no-error .
     1927   if not glog
     1928   or error-status:error then do:
     1929     message error-status:get-message(1) view-as alert-box .
     1930     undo, return error .
     1931   end.
     1932     end.
     1933   end procedure.
     1934   procedure fltopend_fltfindd :
     1935   define input parameter p-parent-handle as handle no-undo .
     1936   define input parameter p-qh as handle no-undo .
     1937   define input parameter p-rowid as rowid no-undo .
     1938   define input parameter p-next as logical no-undo .
     1939   define input parameter p-lock as integer no-undo .
     1940   define input parameter p-bh as handle no-undo .
     1941   define input parameter p-where-cond as character no-undo .
     1942   define input parameter p-use-index-phrase as character no-undo .
     1943   define variable glog as logical no-undo .
     1944   define variable v-qh as handle no-undo .
     1945   define variable v-bh as handle no-undo .
     1946   define variable v-recid as recid no-undo .
     1947   define variable v-prepare-string as character no-undo .
     1948   do
     1949   on error undo, return error
     1950   on stop undo, return error
     1951   :
     1952     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1953     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1954     create query v-qh.
     1955     v-qh:set-buffers(v-bh).
     1956     v-prepare-string = substitute("for each &1 &2 &3"
     1957                                     ,v-bh:name
     1958                                     ,p-where-cond
     1959                                     ,p-use-index-phrase).
     1960     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1961     if not glog then do:
     1962       delete object v-qh.
     1963       delete object v-bh.
     1964       undo, return error .
     1965     end.
     1966     glog = v-qh:query-open no-error .
     1967     if not glog then do:
     1968       delete object v-qh.
     1969       delete object v-bh.
     1970       undo, return error .
     1971     end.
     1972     if p-next then do:
     1973       v-qh:reposition-to-rowid(p-rowid) no-error .
     1974       glog = v-qh:get-next( p-lock) no-error .
     1975       glog = v-qh:get-next( p-lock) no-error .
     1976       if not glog or v-qh:query-off-end = yes then do:
     1977         glog = v-qh:get-first( p-lock) no-error .
     1978       end.
     1979     end.
     1980     else do:
     1981       glog = v-qh:get-first( p-lock) no-error .
     1982     end.
     1983     v-recid = v-bh:recid no-error .
     1984     delete object v-qh.
     1985     delete object v-bh.
     1986     return string(v-recid) .
     1987   end.
     1988   end procedure.
     1989   procedure fltopend_fltfindq :
     1990   define input parameter p-parent-handle as handle no-undo .
     1991   define input parameter p-qh as handle no-undo .
     1992   define input parameter p-next as logical no-undo .
     1993   define input parameter p-lock as integer no-undo .
     1994   define input parameter p-flt-open-open-query  as character no-undo .
     1995   define input parameter p-where-cond as character no-undo .
     1996   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1997   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1998   define input parameter p-indexed-reposition as character no-undo .
     1999   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2000   define variable glog as logical no-undo .
     2001   define variable v-qh as handle no-undo .
     2002   define variable v-bh as handle no-undo extent 18.
     2003   define variable v-rowid as rowid no-undo extent 18.
     2004   define variable v-ii as integer no-undo .
     2005   define variable v-prepare-string as character no-undo .
     2006   do
     2007   on error undo, return error
     2008   on stop undo, return error
     2009   :
     2010     create query v-qh.
     2011     do v-ii = 1 to p-qh:num-buffers:
     2012       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2013       assign
     2014       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2015       no-error.
     2016       v-qh:add-buffer(v-bh[v-ii]).
     2017     end.
     2018     assign
     2019     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2020                       p-where-cond + chr(32)  +
     2021                       p-use-indFIRST-query-tail + chr(32) +
     2022                       p-use-ind-sort-clmn-by + chr(32) +
     2023                       p-indexed-reposition
     2024     .
     2025     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2026     if not glog then do:
     2027       delete object v-qh.
     2028       do v-ii = 1 to p-qh:num-buffers:
     2029         delete object v-bh[v-ii].
     2030       end.
     2031       undo, return error .
     2032     end.
     2033     glog = v-qh:query-open no-error .
     2034     if not glog then do:
     2035       delete object v-qh.
     2036       do v-ii = 1 to p-qh:num-buffers:
     2037         delete object v-bh[v-ii].
     2038       end.
     2039       undo, return error .
     2040     end.
     2041     if p-next then do:
     2042       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2043       glog = v-qh:get-next( p-lock) no-error .
     2044       glog = v-qh:get-next( p-lock) no-error .
     2045       if not glog or v-qh:query-off-end = yes then do:
     2046         glog = v-qh:get-first( p-lock) no-error .
     2047       end.
     2048     end.
     2049     else do:
     2050       glog = v-qh:get-first( p-lock) no-error .
     2051     end.
     2052     do v-ii = 1 to p-qh:num-buffers:
     2053       assign
     2054       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2055       no-error.
     2056     end.
     2057     delete object v-qh.
     2058     do v-ii = 1 to p-qh:num-buffers:
     2059       delete object v-bh[v-ii].
     2060     end.
     2061   end.
     2062   end procedure.
     2063   define variable stime-1 as character no-undo .
     2064   define variable stime-2 as character no-undo .
     2065   define variable is-color as logical   no-undo .
     2066   define variable v-obj-code as integer   no-undo .
     2067   define variable v-obj-type as character no-undo .
     2068   define variable sort-column-name as character no-undo .
     2069   define variable v-order-col as character no-undo .
     2070   define variable v-size-col1 as decimal   no-undo .
     2071   define variable v-size-col2 as decimal   no-undo .
     2072   define variable v-size-col3 as decimal   no-undo .
     2073   define variable v-size-col4 as decimal   no-undo .
     2074   define variable v-size-col5 as decimal   no-undo .
     2075   define variable v-size-col6 as decimal   no-undo .
     2076   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     2077   define buffer buf_gds-prt  for ub.gds-prt  .
     2078   define buffer buf_bar-code for ub.bar-code  .
