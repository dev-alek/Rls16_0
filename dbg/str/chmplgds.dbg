        1   DEFINE BUFFER buf_currency FOR ub.currency.
        2   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
        3          field price-sale-base as decimal
        4          field price-sale-rubl as decimal
        5          field date-1 as date
        6          field date-2 as date
        7          field shift-1 as int
        8          field shift-2 as int
        9          field time-1 as int
       10          field time-2 as int
       11          field grp-name as char
       12          field interv-name as char
       13          field pay-name as char
       14          field unit-cli as char
       15          field cli-base-rate as decimal
       16          index pi
       17          plt-priority DESCENDING
       18          fact-order DESCENDING
       19          qnty-from DESCENDING
       20          sum-from DESCENDING
       21          turnover-from DESCENDING
       22          date-1 DESCENDING
       23          time-1 DESCENDING
       24          date-2 DESCENDING
       25          time-2 DESCENDING
       26          type-price DESCENDING
       27          .
       28   define input  parameter parparentproc as handle    no-undo .
       29   define input  parameter p-gds-code    as integer   no-undo .
       30   define input  parameter p-obj-type    as character no-undo .
       31   define input  parameter p-obj-code    as integer   no-undo .
       32   define input  parameter p-fact-order  as decimal   no-undo .
       33   define output parameter p-plt-id     as integer   no-undo .
       34   define output parameter p-plt-db-num as integer   no-undo .
       35   define output parameter p-pdf-id     as integer   no-undo .
       36   define output parameter p-pdf-db-num as integer   no-undo .
       37   define output parameter p-sale-price-doc as decimal   no-undo .
       38   define variable vss-revision    as character no-undo init "$Revision$":U .
       39   define variable vss-author      as character no-undo init "$Author$":U .
       40   define variable vss-date        as character no-undo init "$Date$":U .
       41   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       42   define variable vss-archive     as character no-undo init "$Archive$":U .
       43   define variable vss-description as character no-undo init "Просмотр цены в множественных прайс-листах по товару".
       44   procedure vss-get-info :
       45     define output parameter p-vss-revision    like vss-revision    no-undo .
       46     define output parameter p-vss-author      like vss-author      no-undo .
       47     define output parameter p-vss-date        like vss-date        no-undo .
       48     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       49     define output parameter p-vss-archive     like vss-archive     no-undo .
       50     define output parameter p-vss-description like vss-description no-undo .
       51     assign
       52       p-vss-revision    = vss-revision
       53       p-vss-author      = vss-author
       54       p-vss-date        = vss-date
       55       p-vss-workfile    = vss-workfile
       56       p-vss-archive     = vss-archive
       57       p-vss-description = vss-description
       58     .
       59   end procedure.
       60   procedure vss-get-parameters :
       61     define output parameter p-vss-parameters as character no-undo .
       62   end procedure.
       63   define new global shared variable g#vssrevis-logger as handle    no-undo .
       64   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       65   define variable v-vssrevis-logger                   as handle    no-undo .
       66   procedure vss-logevent :
       67     define input  parameter p-extra-paramters as character no-undo .
       68     define variable v-vssrevis-parameters as character no-undo .
       69     do
       70     on error undo, return error return-value
       71     :
       72       if  valid-handle(v-vssrevis-logger)
       73       and v-vssrevis-logger :get-signature("logevent") <> ""
       74       then do:
       75         run vss-get-parameters in this-procedure
       76           (output v-vssrevis-parameters
       77           ).
       78         run logevent in v-vssrevis-logger
       79           (input vss-workfile
       80           ,input vss-revision
       81           ,input v-vssrevis-parameters
       82           ,input p-extra-paramters
       83           ).
       84       end.
       85     end.
       86   end procedure.
       87   assign
       88     v-vssrevis-logger = g#vssrevis-logger
       89   .
       90   if  valid-handle(v-vssrevis-logger)
       91   and v-vssrevis-logger :get-signature("logevent") <> ""
       92   then do:
       93     assign
       94       v-vssrevis-logevent = true
       95     .
       96     run vss-logevent in this-procedure (input vss-description) .
       97   end.
       98   define new global shared variable g#language as character no-undo .
       99   if g#language <> '' and g#language <> 'rus':U then do:
      100     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      101   end.
      102   define new global shared variable g#library  as handle no-undo .
      103   define new global shared variable g#library2 as handle no-undo .
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105     define variable v-cntxt-db-num        as integer   no-undo .
      106     define variable v-cntxt-userid        as character no-undo .
      107     define variable v-cntxt-level         as character no-undo .
      108     define variable v-cntxt-host-code-obj as integer   no-undo .
      109     define variable v-cntxt-obj-type      as character no-undo .
      110     define variable v-cntxt-obj-code      as integer   no-undo .
      111     define variable v-cntxt-db-num-obj    as integer   no-undo .
      112     define variable v-cntxt-is-admin      as logical   no-undo .
      113   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     run mainmenu_getcntxt in parparentproc
      115       (output v-cntxt-db-num
      116       ,output v-cntxt-userid
      117       ,output v-cntxt-level
      118       ,output v-cntxt-host-code-obj
      119       ,output v-cntxt-obj-type
      120       ,output v-cntxt-obj-code
      121       ,output v-cntxt-db-num-obj
      122       ,output v-cntxt-is-admin
      123       ) .
      124   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      126   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      127   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      128   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      129   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      130   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      133   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      134   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      135   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      136   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      137   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
