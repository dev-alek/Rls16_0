     1257   procedure userobjs_append :
     1258      define input  parameter p-obj-type as character no-undo .
     1259      define input  parameter p-obj-code as integer   no-undo .
     1260     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1261     do
     1262     on error undo, return error return-value
     1263     :
     1264       find first buf_userobjs_temp-user-obj
     1265         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1266           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1267         no-error .
     1268       if not available buf_userobjs_temp-user-obj
     1269       then do:
     1270         create buf_userobjs_temp-user-obj .
     1271         assign
     1272           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1273           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1274         .
     1275       end.
     1276     end.
     1277   end.
     1278   procedure userobjs_object-exist :
     1279     define output parameter p-object-exist as logical   no-undo .
     1280     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1281     do
     1282     on error undo, return error return-value
     1283     :
     1284       find first buf_userobjs_temp-user-obj
     1285         no-error .
     1286       if not available buf_userobjs_temp-user-obj
     1287       then do:
     1288         assign
     1289           p-object-exist = false
     1290         .
     1291       end.
     1292       else do:
     1293         assign
     1294           p-object-exist = true
     1295         .
     1296       end.
     1297     end.
     1298   end.
     1299   procedure userobjs_transfer :
     1300     define input  parameter p-callback-handle as handle no-undo .
     1301     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1302     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       if valid-handle(p-callback-handle) <> true
     1307       then do:
     1308         message
     1309           vss-workfile vss-revision vss-description skip
     1310           "Ошибка задания входных параметров" skip
     1311           "Неизвестный указатель на процедуру" skip
     1312           view-as alert-box error .
     1313         undo, return error return-value .
     1314       end.
     1315       if p-callback-handle :get-signature("userobjs_append") = ""
     1316       then do:
     1317         message
     1318           vss-workfile vss-revision vss-description skip
     1319           "Ошибка задания входных параметров" skip
     1320           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1321                     ,p-callback-handle :file-name
     1322                     ) skip
     1323           view-as alert-box error .
     1324         undo, return error return-value .
     1325       end.
     1326       for each buf_userobjs_temp-user-obj
     1327       on error undo, return error return-value
     1328       :
     1329         run userobjs_append in p-callback-handle
     1330           (input  buf_userobjs_temp-user-obj.obj-type
     1331           ,input  buf_userobjs_temp-user-obj.obj-code
     1332           ) .
     1333       end.
     1334     end.
     1335   end procedure.
