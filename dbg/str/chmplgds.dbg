     4106                                                  "Текущий" + chr(44) + string(2) + chr(44) +
     4107                                                  "Выбор" + chr(44) + string(3)
     4108     .
     4109   end.
     4110   run uf-get in this-procedure(
     4111        input  'color-p':U
     4112       ,input  v-cntxt-userid
     4113       ,output v-uf-List_
     4114       ,output v-uf-Naim
     4115       ,output v-uf-print-graft
     4116       ,output v-uf-sort-gr
     4117       ,output v-uf-type-price
     4118       ,output v-uf-type-val
     4119   )  no-error.
     4120   if v-uf-List_ = "yes"  then is-color = true .
     4121   if is-color = true then B-color:LOAD-IMAGE-UP("cmp/color.bmp") in frame Dialog-Frame  .
     4122   if is-color = false then B-color:LOAD-IMAGE-UP("cmp/nocol.bmp") in frame Dialog-Frame  .
     4123   define buffer buf_price-all          for ub.price-all  .
     4124   define buffer buf_global-state       for ub.global-state  .
     4125   define buffer buf_buyer-group        for ub.buyer-group  .
     4126   define buffer buf_turnover-group     for ub.turnover-group  .
     4127   define buffer buf_bar-code           for ub.bar-code  .
     4128   define variable to-day        as date      no-undo .
     4129   define variable v-base-rate0  as decimal   no-undo .
     4130   define variable v-base-scale0 as decimal   no-undo .
     4131   define variable v-exch-rate0  as decimal   no-undo .
     4132   define variable v-exch-scale0 as decimal   no-undo .
     4133   define variable v-base-rate   as decimal   no-undo .
     4134   define variable v-base-scale  as decimal   no-undo .
     4135   define variable v-exch-rate   as decimal   no-undo .
     4136   define variable v-exch-scale  as decimal   no-undo .
     4137   define variable v-host-code as integer   no-undo .
     4138   define variable v-curr-abbr as character no-undo .
     4139   define variable v-grp-name as character no-undo .
     4140   define variable v-date-1   as date      no-undo .
     4141   define variable v-date-2   as date      no-undo .
     4142   define variable v-interv   as character no-undo .
     4143   define variable v-pay-name as character no-undo .
     4144   find first buf_global-state no-lock no-error .
