     3268     (if gds-list-hist.line = 0
     3269      then string(gds-list-hist.id, ">>>>>>>>9")
     3270      else '':U)
     3271     CHR(9)
     3272     (if gds-list-hist.item_ <> '':U
     3273      then gds-list-hist.hist-mode
     3274      else '':U)  CHR(9)
     3275      (if gds-list-hist.item_ <> '':U
     3276      then string(gds-list-hist.num-add, "->>>>>>>>9")
     3277      else '':U)  CHR(9)
     3278     (if gds-list-hist.item_ <> '':U
     3279     then string(gds-list-hist.num-recs, ">>>>>>>>9")
     3280     else '':U)  CHR(9)
     3281     gds-list-hist.des
     3282     skip.
     3283   end.
     3284   run waitfram-hide in this-procedure .
     3285   if Make-Excel then output stream ForExcel close.
     3286   run waitfram-hide in this-procedure .
     3287   if Make-Excel then do:
     3288      run rep/runexcel.p (
     3289                      string( session:temp-directory +
     3290                            "rpt" +
     3291                            string( g#report-num ) + ".txt":U )
     3292                    ) .
     3293   end.
     3294   if Make-Excel then
     3295   RUN CLoseForExcel in this-procedure .
     3296   procedure init-prn-template :
     3297   define variable na                   as integer            no-undo .
     3298   DEFINE VARIABLE vtooltip             as character           no-undo.
     3299   DEFINE VARIABLE vlabel               as character           no-undo .
     3300   DEFINE VARIABLE vtype                as character           no-undo .
     3301   DEFINE VARIABLE vformat              as character           no-undo .
     3302   DEFINE VARIABLE vuser-can-edit       as character           no-undo .
     3303   DEFINE VARIABLE voutput-display      as character           no-undo .
     3304   DEFINE VARIABLE vother               as character           no-undo .
     3305     do
     3306     on error undo, return error
     3307     :
     3308       assign
     3309       join-tbl = 'Товары,Глоб. атрибуты,Атр-ты на объ.,Атр-ты на фирме,Другое'
     3310       tbl = 'goods':U + chr(44) +
     3311             'goods-attr':U + chr(44) +
     3312             'gds-obj-attr':U + chr(44) +
     3313             'gds-host-attr':U + chr(44) +
     3314             'function'
     3315       c-point = "Список товаров" + chr(4) +  "PRNT":u + chr(4) + substitute("Список товаров - &1&2 фирма &3", p-curr-obj-type, p-curr-obj-code, v-host-code)
     3316       fld = ""
     3317       lab = ""
     3318       spr = ""
     3319       dim = '0'
     3320       v-size = "":U
     3321       v-format = "":U
     3322       .
     3323       for each buf_usr-flt_custom-labels where
     3324              buf_usr-flt_custom-labels.call-type = 'add-fields':U
     3325          and buf_usr-flt_custom-labels.call-point = 'gdsreffi':U
     3326          and buf_usr-flt_custom-labels.tbl-name = 'goods':U
     3327       by buf_usr-flt_custom-labels.custom-label
     3328          :
     3329         run prnfield-add in this-procedure(input buf_usr-flt_custom-labels.fld-name
     3330                                           ,input buf_usr-flt_custom-labels.custom-label
     3331                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3332                                                   or buf_usr-flt_custom-labels.fld-name begins "attr-value_"
     3333                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3334                                                   else '')
     3335                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     3336                                           ,input buf_usr-flt_custom-labels.custom-format
     3337                                           ,input-output fld
     3338                                           ,input-output lab
     3339                                           ,input-output spr
     3340                                           ,input-output v-size
     3341                                           ,input-output v-format
     3342                                           ,input-output dim)  no-error.
     3343       end.
     3344       assign
     3345       fld = fld
     3346       lab = lab
     3347       dim = dim + chr(44)
     3348       .
     3349       do na = 1 to num-entries('alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U):
     3350         run gds-attr-name in this-procedure (
     3351                            input entry(na, 'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U)
     3352                           ,output vtype
     3353                           ,output vformat
     3354                           ,output vlabel
     3355                           ,output vuser-can-edit
     3356                           ,output voutput-display
     3357                           ,output vother) no-error.
     3358         if NOT error-status:error and voutput-display = "yes":U then do:
     3359           run prnfield-add in this-procedure(entry(na, 'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U), vlabel, 'ATTR.' + VTYPE, prnfield_get-fsize(vtype, vformat, vlabel), vformat,
     3360           input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3361         end.
     3362       end.
     3363       assign
     3364       fld = fld
     3365       lab = lab
     3366       dim = dim + chr(44)
     3367       .
     3368       do na = 1 to num-entries('scales-code,fbr-cost-rubl,gds-margins,free-price,sum-grp,increase-pc,round-method,petrol-purse,min-zapas,need-auth,proprietor,no-income-goods,taracode,calories-o,protein-o,fat-o,carbohydrate-o,doc-tickets,normal-wastage-o,dop-alt-name-o,dt-seasons,change-dt-seasons,mark-collect-type':u):
     3369         run gdsoattr-name in this-procedure (
     3370                            input entry(na, 'scales-code,fbr-cost-rubl,gds-margins,free-price,sum-grp,increase-pc,round-method,petrol-purse,min-zapas,need-auth,proprietor,no-income-goods,taracode,calories-o,protein-o,fat-o,carbohydrate-o,doc-tickets,normal-wastage-o,dop-alt-name-o,dt-seasons,change-dt-seasons,mark-collect-type':u)
     3371                           ,output vtype
     3372                           ,output vformat
     3373                           ,output vlabel
     3374                           ,output vuser-can-edit
     3375                           ,output voutput-display
     3376                           ,output vother) no-error.
     3377         if NOT error-status:error and voutput-display = "yes":U then do:
     3378           run prnfield-add in this-procedure(entry(na, 'scales-code,fbr-cost-rubl,gds-margins,free-price,sum-grp,increase-pc,round-method,petrol-purse,min-zapas,need-auth,proprietor,no-income-goods,taracode,calories-o,protein-o,fat-o,carbohydrate-o,doc-tickets,normal-wastage-o,dop-alt-name-o,dt-seasons,change-dt-seasons,mark-collect-type':u), vlabel, 'ATTR.' + VTYPE, prnfield_get-fsize(vtype, vformat, vlabel), vformat,
     3379           input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3380         end.
     3381       end.
     3382       assign
     3383       fld = fld
     3384       lab = lab
     3385       dim = dim + chr(44)
     3386       .
     3387       do na = 1 to num-entries('no-envd,':u):
     3388         run gdshattr-name(
     3389                            input entry(na, 'no-envd,':u)
     3390                           ,output vtype
     3391                           ,output vformat
     3392                           ,output vlabel
     3393                           ,output vuser-can-edit
     3394                           ,output voutput-display
     3395                           ,output vother) no-error.
     3396         if NOT error-status:error and voutput-display = "yes":U then do:
     3397           run prnfield-add in this-procedure(entry(na, 'no-envd,':u), vlabel, 'ATTR.' + VTYPE, prnfield_get-fsize(vtype, vformat, vlabel), vformat,
     3398           input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3399         end.
     3400       end.
     3401       assign
     3402       fld = fld
     3403       lab = lab
     3404       dim = dim + chr(44)
     3405       .
     3406       run prnfield-add in this-procedure('iColumn', '№', 'function.integer', 7, ">>>>>>9":U,
     3407       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3408       run prnfield-add in this-procedure('gdsbcode-graphic', 'Главный код товара-штрихкод', 'function.character', 30, "X(30)":U,
     3409       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3410       run prnfield-add in this-procedure('qnty', 'Кол-во', 'function.integer', 12, "->>>,>>9.999":U,
     3411       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3412       run prnfield-add in this-procedure('vat-value', 'НДС', 'function.decimal', 6, "99.99%":U,
     3413       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3414       run prnfield-add in this-procedure('slt-value', 'НП', 'function.decimal', 6, "99.99%":U,
     3415       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3416       run prnfield-add in this-procedure('price-sale', 'Цена', 'function.decimal', 6, ">>>,>>9.99":U,
     3417       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3418       run prnfield-add in this-procedure('last-inv', '№ и дата посл.инв.', 'function.character', 45, "X(45)":U,
     3419       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3420     end.
     3421   end procedure.
