      703   procedure prnfield-clear :
      704     define output parameter loc-fld as character no-undo.
      705     define output parameter loc-lab as character no-undo .
      706     define output parameter loc-spr as character no-undo .
      707     define output parameter loc-dim as character no-undo .
      708     define output parameter loc-size as character no-undo .
      709     define output parameter loc-format as character no-undo .
      710     define output parameter loc-type as character no-undo .
      711     assign
      712       loc-fld = ""
      713       loc-lab = ""
      714       loc-spr = ""
      715       loc-dim = "0"
      716       loc-size = "":U
      717       loc-format = "":U
      718       loc-type = "":U
      719     .
      720   end procedure .
      721   procedure prnfield-add :
      722     define input        parameter par-fld as character no-undo.
      723     define input        parameter par-lab as character no-undo .
      724     define input        parameter par-spr as character no-undo .
      725     define input        parameter par-size as integer no-undo .
      726     define input        parameter par-format as character no-undo .
      727     define input-output parameter loc-fld as character no-undo.
      728     define input-output parameter loc-lab as character no-undo .
      729     define input-output parameter loc-spr as character no-undo .
      730     define input-output parameter loc-size as character no-undo .
      731     define input-output parameter loc-format as character no-undo .
      732     define input-output parameter loc-dim as character no-undo .
      733     do
      734     on error undo, return error
      735     :
      736       assign
      737       loc-fld = if loc-dim = '0'
      738                 then par-fld
      739                 else (loc-fld + chr(44) + par-fld)
      740       loc-lab = if loc-dim = '0'
      741                 then par-lab
      742                 else (loc-lab + chr(44) + par-lab)
      743       loc-spr = if loc-dim = '0'
      744                 then par-spr
      745                 else (loc-spr + chr(44) + par-spr)
      746       loc-size = if loc-dim = '0'
      747                 then string(par-size)
      748                 else (loc-size + chr(44) + string(par-size))
      749       loc-format = if loc-dim = '0'
      750                 then par-format
      751                 else (loc-format + chr(4) + string(par-format))
      752       no-error
      753       .
      754       assign
      755       entry(num-entries(loc-dim), loc-dim) = string(integer(entry(num-entries(loc-dim), loc-dim)) + 1)
      756       no-error
      757       .
      758     end.
      759   end procedure.
      760   FUNCTION prnfield_get-fsize returns integer(
      761   input p-type as character,
      762   input p-format as character,
      763   input p-label as character
      764   ):
      765   define variable ii as integer no-undo .
      766   define variable v-max as integer no-undo .
      767     do
      768     on error undo, return error
      769     :
      770       do ii = 1 to num-entries(p-label, chr(32)):
      771         assign
      772         v-max = maximum(v-max, length(entry(ii, p-label, chr(32))))
      773         .
      774       end.
      775       if p-format = "99:99" then return MAXIMUM(v-max,8).
      776       CASE p-type:
      777          when 'C':U or when 'character':U then do:
      778           if p-format = "99:99" or p-format = "99:99-99:99" then return maximum(v-max, 8).
      779           else
      780           return maximum(v-max, integer(left-trim(right-trim(left-trim(left-trim(p-format, "X":U), "(":U), ")":U),">") )).
      781         end.
      782         when 'I':U or when 'D':U or when 'T':U or
      783         when 'integer':U or when 'decimal':U or when 'date':U
      784         then do:
      785           return maximum(v-max,length(p-format)).
      786         end.
      787         when 'L':U or when 'logical':U then do:
      788           return MAXIMUM(v-max, length(entry(1, p-format, chr(47))), length(entry(2, p-format, chr(47)))).
      789         end.
      790       END CASE.
      791     end.
      792   end FUNCTION.
      793   function prnfield_get-fformat returns character ( input p-data-type as character
      794                                           ,input p-format as character ):
      795   define variable v-excel-format as character no-undo .
      796   case p-data-type:
      797     when 'character':U then do:
      798       v-excel-format = "@".
      799     end.
      800     when 'integer':U then do:
      801       v-excel-format = "0".
      802     end.
      803     when 'decimal':U then do:
      804       v-excel-format = substitute("0.&1", fill("0", length(entry(2, p-format, ".")))) no-error.
      805     end.
      806     when 'date':U then do:
      807       v-excel-format = "d/m/yyyy".
      808     end.
      809     otherwise do:
      810       v-excel-format = "@".
      811     end.
      812   end.
      813   if v-excel-format = '' then
      814   v-excel-format = "@".
      815   return v-excel-format .
      816   end function.
      817   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      818   define variable v-waitfram-action01         as character   no-undo .
      819   define variable v-waitfram-action02         as character   no-undo .
      820   define variable v-waitfram-action03         as character   no-undo .
      821   define variable mWaitFramTextBeg            as character   no-undo.
      822   define variable mWaitFramTextEnd            as character   no-undo.
      823   define variable mWaitFramView               as logical     no-undo.
      824   define variable mWaitProcEvent              as logical     no-undo init yes.
      825   define variable mWaitFramInterval           as integer     no-undo init 1 .
      826   define variable mWaitFramStop               as logical     no-undo.
      827   define variable mWaitFramStopUser           as logical     no-undo.
      828   define variable mWaitFramStopTimeOut        as logical     no-undo.
      829   define variable mWaitFramStartProc          as datetime-tz no-undo.
      830   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      831   define button B-WaitFramStop auto-end-key
      832        label "Стоп"
      833        size 10 by 1 tooltip "Остоновить процесс".
      834   define button B-viewProcInfo
      835        label "Информация"
      836        size 15 by 1 tooltip "Информация о процесс".
      837   define frame waitfram
      838     v-waitfram-action01 format "x(72)" no-label skip
      839     v-waitfram-action02 format "x(72)" no-label skip
      840     v-waitfram-action03 format "x(72)" no-label skip
      841     B-viewProcInfo
      842     B-WaitFramStop at row 4 col 30
      843     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      844     .
      845   define new global shared variable mBatchMode as logical no-undo init ?.
      846   define variable mFramBachModHandle as handle no-undo.
      847   mFramBachModHandle = frame waitfram:handle.
      848   define variable mFameOldVis as logical no-undo.
      849   define variable mVisCUrentVin as logical no-undo.
      850   if session:batch-mode
      851   then
      852      mBatchMode = yes.
      853   if mBatchMode = ? then do:
      854     mVisCUrentVin = current-window:visible.
      855     mFameOldVis = mFramBachModHandle:visible.
      856     mFramBachModHandle:visible  = yes.
      857     mBatchMode = mFramBachModHandle:visible ne yes.
      858     mFramBachModHandle:visible = mFameOldVis.
      859     current-window:visible = mVisCUrentVin.
      860   end.
      861    if  log-manager:logfile-name ne ?
      862     then DO:
      863         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      864         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      865         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      866     end.
      867   on choose of B-WaitFramStop in frame waitfram
      868   do:
      869     mWaitFramStop = yes.
      870     mWaitFramStopUser = yes.
      871   end.
      872   function waitfram-check-timeout returns logical():
      873      define variable vtime as int64 no-undo.
      874      if mWaitFramStopTimeOut
      875      then
      876         return yes.
      877      vtime = ( now - mWaitFramStartProc ) / 1000 .
      878      if     mWaitFramTimeOut ne ?
      879         and mWaitFramTimeOut ne 0
      880         and mWaitFramTimeOut lt vtime
      881      then do:
      882         mWaitFramStopTimeOut = yes.
      883      end.
      884      return mWaitFramStopTimeOut.
      885   end.
      886   procedure waitfram-hide :
      887     if not session:batch-mode
      888     then do
      889     on error undo, return error return-value
      890     :
      891       pause 0 before-hide .
      892       if not mBatchMode then
      893         hide frame waitfram .
      894     if     not mWaitFramView
      895        and mWaitProcEvent
      896     then
      897       process events .
      898     end.
      899   end procedure.
      900   procedure waitfram-show :
      901     define input  parameter p-message as character no-undo .
      902     define variable v-left-margin as integer   no-undo .
      903     if not session:batch-mode
      904     then do
      905     on error undo, return error return-value
      906     :
      907       if length(p-message) <= 70 then do:
      908         assign
      909           v-left-margin = integer((70 - length(p-message)) / 2)
      910         .
      911         assign
      912           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      913         .
      914         assign
      915           v-waitfram-action01 = " "
      916           v-waitfram-action02 = " "
      917                                    + fill(" ", v-left-margin)
      918                                    + p-message
      919           v-waitfram-action03 = " "
      920         .
      921       end.
      922       else do:
      923         define variable vRindex1 as integer no-undo.
      924         define variable vRindex2 as integer no-undo.
      925         vRindex1 = r-index(p-message," ",70).
      926         if vRindex1 = 0
      927         then
      928            vRindex1 = 70.
      929         if length(p-message)  <= vRindex1 + 70 then do:
      930           assign
      931             v-waitfram-action01 = " "
      932             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      933             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      934           .
      935         end.
      936         else do:
      937           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      938           if vRindex2 <= vRindex1
      939           then
      940              vRindex2 = vRindex1 + 70.
      941           assign
      942             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      943             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      944             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      945           .
      946         end.
      947       end.
      948       B-viewProcInfo:visible   in frame waitfram = no.
      949       B-viewProcInfo:sensitive in frame waitfram = no.
      950       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      951       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      952       if  (   mWaitFramView
      953          or  mWaitProcEvent)
      954          and not mBatchMode
      955       then
      956          display
      957             v-waitfram-action01 skip
      958             v-waitfram-action02 skip
      959             v-waitfram-action03 skip
      960          with frame waitfram .
      961       if     mWaitFramView
      962          then do:
      963             if     mWaitFramInterval ne ?
      964                and not mBatchMode
      965             then
      966                wait-for go of frame waitfram pause mWaitFramInterval.
      967          end.
      968          else
      969             if     mWaitProcEvent
      970                and not mBatchMode
      971             then
      972                process events .
      973     end.
      974   end procedure.
      975      procedure waitfram-show-this:
      976         define input  parameter iInterval as int64 no-undo.
      977         define variable vtime as int64 no-undo.
      978         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      979         mWaitFramInterval = iInterval.
      980         run waitfram-show (substitute("&1&2 &3&4" ,
      981                                       mWaitFramTextBeg ,
      982                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      983                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      984                                       mWaitFramTextEnd
      985                                      )
      986                           ).
      987      end.
      988      procedure WaitFramRunPause:
      989         define input  parameter iInterval as dec no-undo.
      990         define variable vStart  as datetime-tz no-undo.
      991         define variable vend    as datetime-tz no-undo.
      992         define variable vint as int64 no-undo.
      993         define variable vOk as logical no-undo.
      994         vStart = now.
      995         vend   = vStart.
      996         publish "WaitFramPause" (iInterval,output vOk).
      997         vend   =  now.
      998         vint = vend - vStart.
      999         vint = iInterval - vint / 1000.
     1000         if     not mWaitFramStop
     1001            and (   vint > 0
     1002                 or (    not vOk
     1003                     and iInterval eq ?
     1004                     )
     1005                 )
     1006         then
     1007            run waitfram-show-this (iInterval).
     1008         vend   =  now.
     1009         vint = vend - vStart.
     1010         vint = iInterval - vint / 1000.
     1011         if     not mWaitFramStop
     1012            and vint > 0
     1013         then do:
     1014            run gbl/pause.p (vint * 1000).
     1015         end.
     1016         if iInterval ne ?
     1017         then
     1018            publish "WaitFramStop".
     1019         waitfram-check-timeout().
     1020      end.
     1021      procedure WaitFramWaitFor:
     1022         define input  parameter iInterval as dec no-undo.
     1023         assign
     1024            mWaitFramStartProc   = now
     1025            mWaitFramStopUser    = no
     1026            mWaitFramStopTimeOut = no
     1027         .
     1028         block-wait:
     1029         do while not mWaitFramStop:
     1030            run WaitFramRunPause (iInterval).
     1031            if  waitfram-check-timeout()
     1032            then do:
     1033               leave block-wait.
     1034            end.
     1035         end.
     1036         run waitfram-hide.
     1037      end.
     1038   procedure waitfram-join :
     1039     define input  parameter p-line-1  as character no-undo .
     1040     define input  parameter p-line-2  as character no-undo .
     1041     define input  parameter p-line-3  as character no-undo .
     1042     define output parameter p-message as character no-undo .
     1043     do
     1044     on error undo, return error return-value
     1045     :
     1046       assign
     1047         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1048                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1049                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1050       .
     1051     end.
     1052   end procedure.
     1053   function waitfram-join-function returns character
     1054     (input p-line-1 as character
     1055     ,input p-line-2 as character
     1056     ,input p-line-3 as character
     1057     ).
     1058     define variable v-message as character no-undo .
     1059     run waitfram-join in this-procedure
     1060       (input  p-line-1
     1061       ,input  p-line-2
     1062       ,input  p-line-3
     1063       ,output v-message
     1064       ) .
     1065     return v-message .
     1066   end function .
