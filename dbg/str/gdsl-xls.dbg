     2176   def new shared var bc-frmt as character no-undo .
     2177   def new shared var bc-pfx  as character no-undo .
     2178   def var bc-par-type as character no-undo .
     2179       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
     2180       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
     2181           do:
     2182               message "Не задан или не верно задан ТИП собственного бар-кода!"
     2183                   view-as alert-box ERROR TITLE "".
     2184               return error.
     2185           end.
     2186       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
     2187       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
     2188           do:
     2189               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
     2190                   view-as alert-box ERROR TITLE "".
     2191               return error.
     2192           end.
     2193   PROCEDURE gen-bc:
     2194     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
     2195     def output parameter full-b-code     as character init ""    no-undo .
     2196   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2197     define variable tmp-str21  as character no-undo.
     2198     define variable tmp-num21  as character no-undo.
     2199     define variable i21        as integer   no-undo.
     2200     define variable sum21      as integer   no-undo.
     2201     define variable len-code21 as integer   no-undo.
     2202     define variable varcont21  as logical   initial yes no-undo.
     2203     CASE bc-frmt :
     2204       WHEN "EAN13" THEN do:
     2205         assign
     2206           tmp-str21 = string( internal-b-code, "999999999999" )
     2207         .
     2208       end.
     2209       WHEN "EAN8" THEN do:
     2210         assign
     2211           tmp-str21 = string( internal-b-code, "9999999" )
     2212         .
     2213       end.
     2214       OTHERWISE DO:
     2215           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     2216           view-as alert-box error.
     2217           return error.
     2218       END.
     2219     END CASE.
     2220     if varcont21 = yes then do:
     2221       if integer( substring( tmp-str21, 1, length( bc-pfx ) ) ) <> 0
     2222       then do:
     2223         message
     2224           "Невозможно сформировать бар-код" SKIP
     2225           "для товара с кодом: " internal-b-code
     2226           view-as alert-box error title "подрезание кода".
     2227         return error.
     2228       end.
     2229       else do:
     2230         assign
     2231           full-b-code = bc-pfx + substring( tmp-str21, length( bc-pfx ) + 1, length( tmp-str21 ) - length( bc-pfx ) )
     2232           len-code21    = length( full-b-code )
     2233         .
     2234         define variable v-sum-char21 as character no-undo .
     2235         assign
     2236           sum21 = 0
     2237         .
     2238         do i21 = 1 to len-code21 by 2
     2239         :
     2240           assign
     2241             v-sum-char21 = substr(full-b-code, len-code21 - i21 + 1, 1)
     2242           .
     2243           if v-sum-char21 < "0"
     2244           or v-sum-char21 > "9"
     2245           then do:
     2246             message
     2247               "Невозможно сформировать бар-код" skip
     2248               "для товара с кодом: " internal-b-code skip
     2249               view-as alert-box error title "подсчет контрольной суммы".
     2250             return error.
     2251           end.
     2252           assign
     2253             sum21 = sum21 + integer(v-sum-char21)
     2254           .
     2255         end.
     2256         if varcont21 = yes then do:
     2257           assign
     2258             sum21 = sum21 * 3
     2259           .
     2260           do i21 = 2 to len-code21 by 2
     2261           :
     2262             assign
     2263               v-sum-char21 = substr(full-b-code, len-code21 - i21 + 1, 1)
     2264             .
     2265             if v-sum-char21 < "0"
     2266             or v-sum-char21 > "9"
     2267             then do:
     2268               message
     2269                 "Невозможно сформировать бар-код" skip
     2270                 "для товара с кодом: " internal-b-code skip
     2271                 view-as alert-box error title "подсчет контрольной суммы".
     2272               return error.
     2273             end.
     2274             assign
     2275               sum21 = sum21 + integer(v-sum-char21)
     2276             .
     2277           end.
     2278           if varcont21 = yes then do:
     2279              if sum21 mod 10 = 0 then do:
     2280                assign
     2281                  full-b-code = full-b-code + '0'
     2282                .
     2283              end.
     2284              else do:
     2285                assign
     2286                  full-b-code = full-b-code + string(10 - sum21 mod 10)
     2287                .
     2288              end.
     2289           end.
     2290         end.
     2291       end.
     2292     end.
     2293   END PROCEDURE.
     2294   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
