     2390               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2391                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2392               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2393         otherwise do:
     2394           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     2395         end.
     2396       end CASE.
     2397     end.
     2398   end procedure.
     2399   procedure uf-get :
     2400     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2401     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2402     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2403     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2404     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2405     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2406     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2407     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2408     do
     2409     on error undo, return error
     2410     :
     2411       define buffer buf_usr-flt for ubflt.usr-flt .
     2412       define variable v-use-List_     as logical   no-undo .
     2413       define variable v-type-List_     as character no-undo .
     2414       define variable v-format-List_   as character no-undo .
     2415       define variable v-use-Naim      as logical   no-undo .
     2416       define variable v-type-Naim      as character no-undo .
     2417       define variable v-format-Naim    as character no-undo .
     2418       define variable v-use-print-graft as logical   no-undo .
     2419       define variable v-use-sort-gr     as logical   no-undo .
     2420       define variable v-use-type-price  as logical   no-undo .
     2421       define variable v-use-type-val    as logical   no-undo .
     2422       define variable v-label          as character no-undo .
     2423       define variable v-tooltip        as character no-undo .
     2424       define variable v-user-can-edit  as logical   no-undo .
     2425       define variable v-output-display as logical   no-undo .
     2426       define variable v-other          as character no-undo .
     2427       run uf-name in this-procedure
     2428          (input  entry(1, p-code, chr(4))
     2429         ,output v-use-List_
     2430         ,output v-type-List_
     2431         ,output v-format-List_
     2432         ,output v-use-Naim
     2433         ,output v-type-Naim
     2434         ,output v-format-Naim
     2435         ,output v-use-print-graft
     2436         ,output v-use-sort-gr
     2437         ,output v-use-type-price
     2438         ,output v-use-type-val
     2439         ,output v-label
     2440         ,output v-tooltip
     2441         ,output v-user-can-edit
     2442         ,output v-output-display
     2443         ,output v-other
     2444         ) no-error .
     2445       if error-status :error then do:
     2446         undo, return error return-value .
     2447       end.
     2448       find first buf_usr-flt no-lock where
     2449                  buf_usr-flt.Call-point     = p-code AND
     2450                  buf_usr-flt.user-name       = p-user-name
     2451         no-error .
     2452       if avail buf_usr-flt then do:
     2453         assign
     2454         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2455         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2456         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2457         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2458         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2459         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2460         .
     2461       end.
     2462       else do:
     2463         assign
     2464         p-List_        = (if v-use-List_       then "":U                    else ?)
     2465         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2466         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2467         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2468         p-type-price   = (if v-use-type-price  then no                      else ?)
     2469         p-type-val     = (if v-use-List_       then no                      else ?)
     2470         .
     2471       end.
     2472     end.
     2473   end procedure.
     2474   procedure uf-set :
     2475     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2476     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2477     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2478     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2479     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2480     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2481     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2482     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2483     do
     2484     on error undo, return error
     2485     :
     2486       define buffer buf_usr-flt for ubflt.usr-flt .
     2487       define variable v-use-List_     as logical   no-undo .
     2488       define variable v-type-List_     as character no-undo .
     2489       define variable v-format-List_   as character no-undo .
     2490       define variable v-use-Naim      as logical   no-undo .
     2491       define variable v-type-Naim      as character no-undo .
     2492       define variable v-format-Naim    as character no-undo .
     2493       define variable v-use-print-graft as logical   no-undo .
     2494       define variable v-use-sort-gr   as logical   no-undo .
     2495       define variable v-use-type-price as logical   no-undo .
     2496       define variable v-use-type-val  as logical   no-undo .
     2497       define variable v-tooltip        as character no-undo .
     2498       define variable v-label          as character no-undo .
     2499       define variable v-user-can-edit  as logical   no-undo .
     2500       define variable v-output-display as logical   no-undo .
     2501       define variable v-other          as character no-undo .
     2502       run uf-name in this-procedure
     2503         (input  entry(1, p-code, chr(4))
     2504         ,output v-use-List_
     2505         ,output v-type-List_
     2506         ,output v-format-List_
     2507         ,output v-use-Naim
     2508         ,output v-type-Naim
     2509         ,output v-format-Naim
     2510         ,output v-use-print-graft
     2511         ,output v-use-sort-gr
     2512         ,output v-use-type-price
     2513         ,output v-use-type-val
     2514         ,output v-label
     2515         ,output v-tooltip
     2516         ,output v-user-can-edit
     2517         ,output v-output-display
     2518         ,output v-other
     2519         ) no-error .
     2520       if error-status :error then do:
     2521         undo, return error return-value .
     2522       end.
     2523       find first buf_usr-flt where
     2524                  buf_usr-flt.Call-point     = p-code AND
     2525                  buf_usr-flt.user-name       = p-user-name
     2526         no-error .
     2527       if not avail buf_usr-flt then do:
     2528           create buf_usr-flt .
     2529           assign
     2530           buf_usr-flt.call-point = p-code
     2531           buf_usr-flt.user-name  = p-user-name
     2532           .
     2533       end.
     2534       if avail buf_usr-flt then do:
     2535        assign
     2536        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2537        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2538        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2539        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2540        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2541        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2542       .
     2543       release buf_usr-flt.
     2544       end.
     2545       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2546     end.
     2547   end procedure.
