     3183     ,output vat-value
     3184     ) no-error .
     3185   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3187     (input  gds-list.gds-code
     3188     ,input  '2':U
     3189     ,input  ?
     3190     ,input  v-host-code
     3191     ,input  p-curr-obj-type
     3192     ,input  p-curr-obj-code
     3193     ,output slt-value
     3194     ) no-error .
     3195     do jj = 1 to j-n:
     3196       assign
     3197       f-value = "":U
     3198       v-dop0 = entry(jj, f-name)
     3199       v-dop1 = entry(1, entry(jj, f-name), ".")
     3200       v-dop2 = entry(2, entry(jj, f-name), ".")
     3201       .
     3202       CASE v-dop1 :
     3203         when "function":U then do:
     3204           if Make-Excel then  put   stream ForExcel unformatted
     3205           get-function(substr(v-dop0 ,10 ), entry(jj, ubflt.filter.Where-ysl-rus, chr(4)))
     3206           (if jj < j-n
     3207           then
     3208           CHR(9)
     3209           else chr(10))
     3210           .
     3211         end.
     3212         otherwise do:
     3213           if index(v-dop0, "*":U) > 0 then do:
     3214             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3215               assign
     3216               f-value-1 = "":U.
     3217               run gds-ref-fi in this-procedure (
     3218                                buffer ub.goods
     3219                               ,buffer ub.gds-obj
     3220                               ,input p-curr-obj-type
     3221                               ,input p-curr-obj-code
     3222                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3223                               ,input yes
     3224                               ,INPUT-OUTPUT f-value-1
     3225                               )  NO-ERROR .
     3226               assign
     3227               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3228               .
     3229             end.
     3230           end.
     3231           else do:
     3232             run gds-ref-fi in this-procedure (
     3233                              buffer ub.goods
     3234                             ,buffer ub.gds-obj
     3235                             ,input p-curr-obj-type
     3236                             ,input p-curr-obj-code
     3237                             ,INPUT v-dop0
     3238                             ,input yes
     3239                             ,INPUT-OUTPUT f-value
     3240                             )  NO-ERROR .
     3241           end.
     3242           if Make-Excel then  put   stream ForExcel unformatted
     3243           if entry(jj, f-name) = "artic" then chr(4) else "":U
     3244           string(replace(f-value, chr(10), ""), substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3245           (if jj < j-n
     3246           then
     3247           CHR(9)
     3248           else chr(10))
     3249           .
     3250         end.
     3251       END CASE.
     3252     end.
     3253   END.
     3254   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     3255   FInd first Sheetf where
     3256              Sheetf.sheet-num = 2 No-ERROR.
