      589   define variable g#report-num as integer no-undo .
      590   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   procedure OpenForExcel :
      592      define variable v-ch#ExcelApplication as com-handle no-undo .
      593      define variable v-ch#Workbook         as com-handle no-undo .
      594      define variable v-ch#Worksheet        as com-handle no-undo .
      595      os-delete value( string( session:temp-directory ) +
      596                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      597      os-delete value( string( session:temp-directory ) +
      598                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      599      os-delete value( string( session:temp-directory ) +
      600                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      601      if Make-Excel
      602      then do:
      603         output stream ForExcel to value( string( session:temp-directory +
      604                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      605         assign
      606            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      607            number-list = 1
      608         .
      609         if make-excel-com
      610         then do:
      611   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   if valid-handle(ch#WorkSheet) then
      613   RELEASE OBJECT ch#WorkSheet no-error.
      614   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   if valid-handle(ch#Workbook) then
      616   RELEASE OBJECT ch#Workbook no-error.
      617   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   if valid-handle(ch#ExcelApplication) then
      619   RELEASE OBJECT ch#ExcelApplication no-error.
      620            create "Excel.Application" ch#excelApplication connect no-error.
      621            if error-status:error
      622            then do :
      623           create "Excel.Application" ch#excelApplication no-error.
      624       if error-status :error then do:
      625           message
      626           "Ошибка при запуске Excel" skip
      627           error-status :get-message(1) skip
      628           view-as alert-box error .
      629           undo, return error .
      630       end.
      631            end.
      632            assign
      633               num#str#  = 0.
      634               v-ch#excelApplication  = ch#excelApplication.
      635               v-ch#excelApplication:Interactive = false.
      636               v-ch#excelApplication:ScreenUpdating = false.
      637               v-ch#excelApplication:Visible = false.
      638               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      639               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      640               v-ch#Worksheet = ch#WorkSheet.
      641               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      642               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      643               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      644               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      645            no-error .
      646            if error-status:error
      647            then do:
      648               Make-Excel-com = false .
      649               Make-Excel = false .
      650               output Stream  ForExcel close.
      651               os-delete value( string( session:temp-directory ) +
      652                              "rpt" + string( g#report-num ) + ".txt":U ) .
      653               os-delete value( string( session:temp-directory ) +
      654                              "rpt" + string( g#report-num ) + ".frm":U ) .
      655               return.
      656            end.
      657         end.
      658      end.
      659   end.
      660   procedure CloseForExcel :
      661      define variable ii as integer no-undo .
      662      define variable vsheet-num as integer no-undo.
      663      if Make-Excel
      664      then  do:
      665         output Stream  ForExcel close.
      666         os-delete value( string( session:temp-directory ) +
      667                                "rpt" + string( g#report-num ) + ".txt":U ) .
      668         os-delete value( string( session:temp-directory ) +
      669                                "rpt" + string( g#report-num ) + ".frm":U ) .
      670         define buffer buf_sheetf for sheetf.
      671         find last buf_sheetf no-error .
      672         if available buf_sheetf
      673         then
      674            vsheet-num = buf_sheetf.sheet-num.
      675         if vsheet-num > 1
      676         then do:
      677            do ii = 2 to vsheet-num:
      678               os-delete value( string( session:temp-directory ) +
      679                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      680            end.
      681         end.
      682   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   if valid-handle(ch#WorkSheet) then
      684   RELEASE OBJECT ch#WorkSheet no-error.
      685   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   if valid-handle(ch#Workbook) then
      687   RELEASE OBJECT ch#Workbook no-error.
      688   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      689   if valid-handle(ch#ExcelApplication) then
      690   RELEASE OBJECT ch#ExcelApplication no-error.
      691      end.
      692   end.
