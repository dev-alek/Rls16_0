     2744   FUNCTION gdsreffi_last-pcnt returns decimal ( buffer buf_goods for ub.goods
     2745                                             ,input p-obj-type as character
     2746                                             ,input p-obj-code as integer):
     2747   define buffer buf_gds-obj for ub.gds-obj.
     2748   define variable v-value as decimal no-undo .
     2749   find first buf_gds-obj no-lock where
     2750               buf_gds-obj.gds-code = buf_goods.gds-code
     2751         AND  buf_gds-obj.obj-type = p-obj-type
     2752         AND  buf_gds-obj.obj-code = p-obj-code no-error .
     2753   if available buf_gds-obj then do:
     2754     assign
     2755     v-value =
     2756               (buf_gds-obj.price-sale / (if v-curr-r-b = 'base':U
     2757                                         then buf_gds-obj.last-base
     2758                                         else buf_gds-obj.last-rubl)
     2759                 * 100 - 100)
     2760     no-error
     2761     .
     2762   end.
     2763   else do:
     2764     v-value = ?  .
     2765   end.
     2766   return v-value.
     2767   end FUNCTION.
     2768   FUNCTION gdsreffi_in-doc-cli-name returns character ( buffer buf_goods for ub.goods
     2769                                             ,input p-obj-type as character
     2770                                             ,input p-obj-code as integer):
     2771   define buffer buf_gds-obj for ub.gds-obj.
     2772   define buffer buf_trn-doc for ub.trn-doc.
     2773   define buffer buf_clients for ub.clients.
     2774   define buffer buf_parts for ub.parts.
     2775   define variable v-value as decimal no-undo .
     2776   for first buf_gds-obj no-lock where
     2777               buf_gds-obj.gds-code = buf_goods.gds-code
     2778         AND  buf_gds-obj.obj-type = p-obj-type
     2779         AND  buf_gds-obj.obj-code = p-obj-code ,
     2780             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_gds-obj.in-code,
     2781             first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and  buf_clients.obj-code = buf_trn-doc.cli-code:
     2782           return buf_clients.obj-name .
     2783   end.
     2784   for first buf_parts no-lock where
     2785              buf_parts.artic = buf_goods.artic
     2786         and  buf_parts.prod-type = buf_goods.prod-type
     2787         and  buf_parts.prod-code = buf_goods.prod-code
     2788         AND  buf_parts.obj-type = p-obj-type
     2789         AND  buf_parts.obj-code = p-obj-code
     2790         and  buf_parts.out-code = 'free-zone':U ,
     2791             first buf_clients no-lock where buf_clients.obj-type = buf_parts.supp-type and  buf_clients.obj-code = buf_parts.supp-code:
     2792           return buf_clients.obj-name .
     2793   end.
     2794   end FUNCTION.
     2795   PROCEDURE gds-ref-fi:
     2796   DEFINE PARAMETER BUFFER fi-goods for ub.goods.
     2797   DEFINE PARAMETER BUFFER fi-gds-obj for ub.gds-obj.
     2798   DEFINE INPUT PARAMETER v-obj-type like ub.clients.obj-type.
     2799   DEFINE INPUT PARAMETER v-obj-code like ub.clients.obj-code.
     2800   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2801   define input parameter p-excel as logical no-undo .
     2802   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     2803   DEFINE VARiable II AS INTEGER NO-UNDO.
     2804   DEFINE BUFFER fi-gds-prt for ub.gds-prt.
     2805   define buffer fi-condition-keeping for ub.condition-keeping .
     2806   DEFINE variable myfi as char no-undo extent 1.
     2807   DEFINE VARiable jj as integer no-undo init 1.
     2808   DEFINE variable Myformat as character no-undo.
     2809   DEFINE VARiable vNum-entries as integer no-undo.
     2810   DEFINE VARiable entry-ii as character no-undo.
     2811   DEFINE VARiable vvalue as character no-undo.
     2812   DEFINE VARiable vtype as character no-undo.
     2813   DEFINE VARiable vlabel as character no-undo.
     2814   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2815     IF v-gds-ref-fi = "" then
     2816     v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2817    if avail fi-goods then do:
     2818         FIND FIRST fi-gds-obj NO-LOCK where
     2819                    fi-gds-obj.gds-code = fi-goods.gds-code AND
     2820                    fi-gds-obj.obj-type = p-curr-obj-type AND
     2821                    fi-gds-obj.obj-code = p-curr-obj-code NO-ERROR.
     2822   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2823     DO ii = 1 to vNum-entries:
     2824       entry-ii = ENTRY(ii, v-gds-ref-fi).
     2825       find first buf_usr-flt_custom-labels where
     2826                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2827            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2828            and  buf_usr-flt_custom-labels.call-point =  'gdsreffi':U
     2829            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2830       if  available buf_usr-flt_custom-labels then do:
     2831         case buf_usr-flt_custom-labels.tbl-name:
     2832           when 'goods':U then do:
     2833             if entry(2, entry-ii, ".") begins "#" then do:
     2834               assign
     2835               myfi[jj] =
     2836                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-goods)
     2837                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2838             end.
     2839             else do:
     2840               myfi[jj] =
     2841                           string(buffer fi-goods:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2842             end.
     2843           end.
     2844           when 'gds-obj':U then do:
     2845             if entry(2, entry-ii, ".") begins "#" then do:
     2846               assign
     2847               myfi[jj] =
     2848                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func
     2849                                         ,buffer fi-goods
     2850                                         ,input v-obj-type
     2851                                         ,input v-obj-code
     2852                                         )
     2853                          , buf_usr-flt_custom-labels.custom-format) no-error .
     2854             end.
     2855             else do:
     2856               if available fi-gds-obj then do:
     2857                 myfi[jj] =
     2858                             string(buffer fi-gds-obj:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2859               end.
     2860               else do:
     2861                 myfi[jj] =
     2862                 ""
     2863                 .
     2864               end.
     2865             end.
     2866           end.
     2867           when 'goods-attr':U then do:
     2868             if entry(2, entry-ii, ".") begins "#" then do:
     2869             end.
     2870             else do:
     2871               vvalue = "[!!Ошибка]".
     2872               run gds-attr-value in this-procedure ( fi-goods.gds-code
     2873                                                     ,input entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2874                                                     ,output vvalue
     2875                                                     ,output vtype) no-error.
     2876               myfi[jj] =
     2877                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2878             end.
     2879           end.
     2880           when 'gds-obj-attr':U then do:
     2881             if entry(2, entry-ii, ".") begins "#" then do:
     2882             end.
     2883             else do:
     2884               vvalue = "[!!Ошибка]".
     2885               run gdsoattr-value in this-procedure (
     2886                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2887                                                    ,input  fi-goods.gds-code
     2888                                                    ,input v-obj-type
     2889                                                    ,input v-obj-code
     2890                                                    ,output vvalue
     2891                                                    ,output vtype
     2892                                                    ) no-error .
     2893               myfi[jj] =
     2894                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2895             end.
     2896           end.
     2897           when 'gds-host-attr':U then do:
     2898             if entry(2, entry-ii, ".") begins "#" then do:
     2899             end.
     2900             else do:
     2901               vvalue = "[!!Ошибка]".
     2902               run gdshattr-value in this-procedure (
     2903                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2904                                                    ,input  fi-goods.gds-code
     2905                                                    ,input v-obj-type
     2906                                                    ,input v-obj-code
     2907                                                    ,output vvalue
     2908                                                    ,output vtype
     2909                                                    ) no-error .
     2910               myfi[jj] =
     2911                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2912             end.
     2913           end.
     2914         end case.
     2915         if p-excel then do:
     2916           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     2917           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     2918           then do:
     2919             myfi[jj] = replace(myfi[jj], chr(44), "").
     2920           end.
     2921         end.
     2922         if jj = 9 then LEAVE.
     2923       end.
     2924         else if entry(1, entry-ii, ".") = 'goods-attr':U then  do:
     2925           vvalue = "[!!Ошибка]".
     2926                   run gds-attr-value in this-procedure ( fi-goods.gds-code
     2927                                                         ,input (SUBSTRING (entry-ii,INDEX(entry-ii,"_") + 1))
     2928                                                         ,output vvalue
     2929                                                         ,output vtype) no-error.
     2930                   myfi[jj] = vvalue.
     2931         end.
     2932     END.
     2933     end.
     2934     assign
     2935     fi-1 = myfi[1]
     2936     .
     2937   END PROCEDURE.
     2938   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2940     (output v-curr-r-b
     2941     )  .
     2942   FUNCTION get-function returns character(
     2943   input p-f-name as character,
     2944   input p-format as character
     2945   ):
     2946   define variable main-b-code like ub.bar-code.b-code no-undo .
     2947   define variable bar_code as character no-undo .
     2948   define variable bar_bar_code as character no-undo .
     2949   define variable price-sale as decimal no-undo .
     2950   define variable for-road as decimal no-undo .
     2951   define variable for-excise as decimal no-undo .
     2952   define variable v-doc-num as character no-undo .
     2953   define variable v-last-inv-date-num as character no-undo.
     2954     do
     2955     on error undo, return error
     2956     :
     2957       CASE p-f-name:
     2958         when "iColumn":U then do:
     2959           return string(iColumn, p-format).
     2960         end.
     2961         when "qnty":U then do:
     2962           return string(gds-list.qnty,  p-format).
     2963         end.
     2964         when "vat-value":U then do:
     2965           return string(vat-value, p-format).
     2966         end.
     2967         when "slt-value":U then do:
     2968           return string(slt-value, p-format).
     2969         end.
     2970         when "price-sale":U then do:
     2971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2972     (input  gds-list.gds-code
     2973     ,input  ?
     2974     ,output main-b-code
     2975     )  .
     2976   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2978     (input  p-curr-obj-type
     2979     ,input  p-curr-obj-code
     2980     ,input  main-b-code
     2981     ,input  main-b-code
     2982     ,input  0
     2983     ,output v-doc-num
     2984     ,output price-sale
     2985     ,output for-road
     2986     ,output for-excise
     2987     ) no-error .
     2988           return string(price-sale, p-format).
     2989         end.
     2990         when "node-name":U then do:
     2991           return string(v-f-name, p-format).
     2992         end.
     2993         when "gdsbcode-graphic":U then do:
     2994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2995     (input  gds-list.gds-code
     2996     ,input  ?
     2997     ,output main-b-code
     2998     )  .
     2999           RUN gen-bc in this-procedure ( input main-b-code, output bar_code ).
     3000           run gbl/bctotext.p (
     3001                           input (if length(bar_code) = 13 then 'ean13':U else 'ean8':U)
     3002                          ,input bar_code
     3003                          ,output bar_bar_code) no-error .
     3004           return (chr(4) + bar_bar_code).
     3005         end.
     3006         when "last-inv" then do :
     3007           find last buf_doc-line no-lock where
     3008                     buf_doc-line.artic = gds-list.artic
     3009                 and buf_doc-line.prod-code = gds-list.prod-code
     3010                 and buf_doc-line.prod-type = gds-list.prod-type
     3011                 and buf_doc-line.obj-code = p-curr-obj-code
     3012                 and buf_doc-line.obj-type = p-curr-obj-type
     3013                 and buf_doc-line.status_ = 'факт':U
     3014                 and buf_doc-line.ext-doc-type = 'vt':U no-error.
     3015           if available buf_doc-line then do :
     3016             find first buf_trn-doc no-lock where
     3017                       buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     3018             if available buf_trn-doc then do :
     3019               assign
     3020                 v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     3021               .
     3022             end.
     3023           end.
     3024           else do :
     3025             assign
     3026               v-last-inv-date-num = "[!!Нет инвентаризаций по данному товару]"
     3027             .
     3028           end.
     3029           return v-last-inv-date-num.
     3030         end.
     3031       END CASE.
     3032     end.
     3033   end FUNCTION.
     3034   for each buf_usr-flt_custom-labels:
     3035     delete buf_usr-flt_custom-labels.
     3036   end.
     3037   for each  buf_custom-labels no-lock where
     3038             buf_custom-labels.call-type = 'add-fields':U
     3039         and buf_custom-labels.call-point = 'gdsreffi':U:
     3040     create buf_usr-flt_custom-labels.
     3041     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3042   end.
     3043   if not valid-handle(my-handle) then do:
     3044     assign
     3045     my-handle = parparentproc.
     3046   end.
     3047   run init-prn-template in this-procedure .
     3048   run gbl/prntput.p (c-point, output v-rec).
     3049   run gbl/prntmpl.w (
     3050                   input parparentproc
     3051                 , input "":U
     3052                 , input c-point
     3053                 , input Tbl
     3054                 , input join-tbl
     3055                 , input Fld
     3056                 , input Lab
     3057                 , input Spr
     3058                 , input v-size
     3059                 , input v-format
     3060                 , input Dim
     3061                 , input-output v-rec
     3062                 , OUTPUT V-LENGTH
     3063                 , OUTPUT V-NUM-CLMN
     3064               ).
     3065   if v-rec = ? then return.
     3066   find first ubflt.filter no-lock where
     3067              recid(ubflt.filter) = v-rec no-error .
     3068   if not avail ubflt.filter then return.
     3069   do jj = 1 to num-entries(ubflt.filter.Fields-sort):
     3070     assign
     3071     f-name-1 = "":U
     3072     v-frm-set = no
     3073     .
     3074     do jj-1 = 1 to num-entries(entry(jj, ubflt.filter.Fields-sort), "*":U):
     3075       if (entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "artic"
     3076           or
     3077           entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "b-str")
     3078       and lookup(string(jj) + "=@":U, v-eng-frm) = 0
     3079       then
     3080       assign
     3081       v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3082       v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3083       sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3084       v-frm-set = yes
     3085       .
     3086       case entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), "."):
     3087         when 'goods':U or when 'gds-obj':U then do:
     3088           assign
     3089           f-n = entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3090           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3091           .
     3092         end.
     3093         when 'gds-obj-attr':U
     3094         or
     3095         when 'gds-host-attr':U
     3096         or
     3097         when 'goods-attr':U
     3098         then do:
     3099           assign
     3100           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3101           entry(1, f-n, ".") = "attr-value_"
     3102           f-n = replace(f-n, ".", "")
     3103           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".").
     3104         end.
     3105         when "function":U then do:
     3106           assign
     3107           t-name = ''
     3108           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3109           .
     3110           if entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = 'gdsbcode-graphic':U
     3111           then do:
     3112             assign
     3113             v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3114             v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3115             v-frm-set = yes
     3116             .
     3117             assign
     3118             sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3119             Sheetf.Bas-File = "exe/anyl-xls.bas"
     3120             Sheetf.Bas-Params = Sheetf.Bas-Params +
     3121                                 (if Sheetf.Bas-Params = '':U
     3122                                  then '':U
     3123                                  else chr(4)) + string(jj)
     3124             .
     3125           end.
     3126         end.
     3127       END CASE.
     3128       assign
     3129       f-name-1 = f-name-1 + (if f-name-1 = "":U then "":U else "*":U) + (if t-name <> '':U then (t-name + ".") else '') + f-n
     3130       .
     3131       if v-frm-set = no then do:
     3132         assign
     3133         v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=" +
     3134                     prnfield_get-fformat(entry(jj, ubflt.filter.lst-cend)
     3135                                ,entry(jj, ubflt.filter.where-ysl-rus, chr(4)))
     3136         .
     3137       end.
     3138     end.
     3139     assign
     3140     f-name = f-name + (if f-name = "":U then "":U else chr(44)) + f-name-1
     3141     .
     3142   end.
     3143   assign
     3144   j-n = num-entries(f-name)
     3145   .
     3146   Sheetf.Bas-Params = string(5) + chr(4) + Sheetf.Bas-Params.
     3147   Make-excel = yes.
     3148   run get-report-num  in parParentProc(output g#report-num).
     3149   if Make-Excel then
     3150   RUN OpenForExcel in this-procedure .
     3151   FOR EACH sheetf where sheetf.sheet-num > 1:
     3152     delete sheetf.
     3153   end.
     3154   FIND FIRST sheetf where
     3155              sheetf.sheet-num = 1 No-ERROR.
     3156   assign
     3157   ReportName = "Список товаров"
     3158   str1 = substitute("(&1&2, фирма &3)", p-curr-obj-type, p-curr-obj-code, v-host-code)
     3159   sheetf.Excel-Column-Lable = ubflt.filter.Fields-sort-rus
     3160   sheetf.sizes = ubflt.filter.Where-ysl
     3161   .
     3162   run waitfram-show in this-procedure ("Экспорт в EXCEL. Ждите ...").
     3163   run rep/extitle.p (1).
     3164   iColumn = 0.
     3165   FOR EACH gds-list no-lock,
     3166       first ub.goods no-lock where
     3167             ub.goods.gds-code = gds-list.gds-code:
     3168     if (iColumn modulo 10) = 0 then
     3169       run waitfram-show in this-procedure ("Экспортировано в EXCEL строк : " + string (iColumn)).
     3170     assign
     3171     iColumn = iColumn + 1
     3172     v-osn-frm = "":U
     3173     v-eng-frm = "":U
     3174     .
     3175   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3177     (input  gds-list.gds-code
     3178     ,input  '1':U
     3179     ,input  ?
     3180     ,input  v-host-code
     3181     ,input  p-curr-obj-type
