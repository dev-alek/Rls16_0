     2591   function native-string returns character ( input p-string as character
     2592                                             ,input p-data-type as character
     2593                                             ,input p-format as character):
     2594   define variable v-string as character no-undo .
     2595   case p-data-type:
     2596     when 'character':U then do:
     2597       assign
     2598       v-string = string(p-string, p-format)
     2599       no-error .
     2600     end.
     2601     when 'date':U then do:
     2602       assign
     2603       v-string = string(date(p-string), p-format)
     2604       no-error .
     2605     end.
     2606     when 'decimal':U then do:
     2607       assign
     2608       v-string = string(decimal(p-string), p-format)
     2609       no-error .
     2610     end.
     2611     when 'integer':U then do:
     2612       assign
     2613       v-string = string(integer(p-string), p-format)
     2614       no-error .
     2615     end.
     2616     when 'logical':U then do:
     2617       assign
     2618       v-string = string(logical(p-string), p-format)
     2619       no-error .
     2620     end.
     2621   end case.
     2622   return v-string.
     2623   end function.
     2624   FUNCTION gdsreffi_cond-keep-name returns character ( buffer buf_goods for ub.goods):
     2625   define buffer buf_condition-keeping for ub.condition-keeping.
     2626   find first buf_condition-keeping no-lock where
     2627            buf_condition-keeping.cond-keep-code = buf_goods.cond-keep-code no-error.
     2628   IF AVAIL buf_condition-keeping then do:
     2629     return buf_condition-keeping.cond-keep-name.
     2630   end.
     2631   return "[!!Неизвестные УСЛОВИЯ ХРАНЕНИЯ]".
     2632   end function.
     2633   function gdsreffi_prod-grp-name returns character ( buffer buf_goods for ub.goods):
     2634   define buffer buf_clients for ub.clients.
     2635   find first buf_clients no-lock WHERE
     2636             buf_clients.obj-type = buf_goods.prod-type
     2637         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2638   if available buf_clients then do:
     2639     return buf_clients.grp-name.
     2640   end.
     2641   return "[!!Неизвестная группа ПРОИЗВОДИТЕЛЯ]".
     2642   end function.
     2643   function gdsreffi_prod-name returns character ( buffer buf_goods for ub.goods):
     2644   define buffer buf_clients for ub.clients.
     2645   find first buf_clients no-lock WHERE
     2646             buf_clients.obj-type = buf_goods.prod-type
     2647         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2648   if available buf_clients then do:
     2649     return buf_clients.obj-name.
     2650   end.
     2651   return "[!!Неизвестный ПРОИЗВОДИТЕЛЬ]".
     2652   end function.
     2653   function gdsreffi_prt-root-name returns character ( buffer buf_goods for ub.goods):
     2654   define buffer buf_gds-prt for ub.gds-prt.
     2655   find first buf_gds-prt no-lock where
     2656           buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     2657   if available buf_gds-prt then do:
     2658     return buf_gds-prt.node-name.
     2659   end.
     2660   return "[!!Неизвестный корень ШКАЛЫ]".
     2661   end function.
     2662   function gdsreffi_last-inv returns character ( buffer buf_goods for ub.goods
     2663                                                 ,input p-obj-type as character
     2664                                                 ,input p-obj-code as integer  ):
     2665   define variable v-last-inv-date-num as character format "X(45)" no-undo.
     2666   define buffer buf_doc-line for ub.doc-line.
     2667   define buffer buf_trn-doc  for ub.trn-doc.
     2668   find last buf_doc-line no-lock where
     2669             buf_doc-line.artic = buf_goods.artic
     2670         and buf_doc-line.prod-code = buf_goods.prod-code
     2671         and buf_doc-line.prod-type = buf_goods.prod-type
     2672         and buf_doc-line.obj-code = p-obj-code
     2673         and buf_doc-line.obj-type = p-obj-type
     2674         and buf_doc-line.status_ = 'факт':U
     2675         and buf_doc-line.ext-doc-type = 'vt':U no-error.
     2676   if available buf_doc-line then do :
     2677     find first buf_trn-doc no-lock where
     2678                buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     2679     if available buf_trn-doc then do :
     2680       assign
     2681         v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     2682       .
     2683       return v-last-inv-date-num.
     2684     end.
     2685   end.
     2686   return "[!!Нет инвентаризаций по данному товару]" .
     2687   end function.
