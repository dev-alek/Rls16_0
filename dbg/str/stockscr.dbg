        1   define input parameter paruser-name as character no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экран продавца".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define temp-table tt-usrstko no-undo
      112   field user-name     as   character
      113   field obj-type      like ub.clients.obj-type
      114   field obj-code      like ub.clients.obj-code
      115   field obj-name      like ub.clients.obj-name
      116   field main-obj-type like ub.clients.obj-type
      117   field main-obj-code like ub.clients.obj-code
      118   field main-obj-name like ub.clients.obj-name
      119   field level         as   integer
      120   field host-code     like ub.clients.obj-code
      121   field host-name     like ub.clients.obj-name
      122   field db-num        like ub.db.db-num
      123   index pi is unique primary user-name obj-type obj-code
      124   index level is unique user-name level.
      125   PROCEDURE loadusr-tt :
      126   define input parameter paruser-name as character no-undo.
      127   define buffer bf_clients      for ub.clients.
      128   define buffer bf_main-clients for ub.clients.
      129   define buffer bf_usr-flt      for ubflt.usr-flt.
      130   define buffer bf_shop         for ub.shop.
      131   define buffer bf_store        for ub.store.
      132   define buffer bf_host-clients for ub.clients.
      133   define buffer bf_db           for ub.db.
      134   for each tt-usrstko:
      135     delete tt-usrstko.
      136   end.
      137   for each bf_usr-flt where bf_usr-flt.user-name  = paruser-name     and
      138                             bf_usr-flt.call-point begins "stockscr"   :
      139     create tt-usrstko.
      140     assign
      141       tt-usrstko.user-name    = paruser-name
      142       tt-usrstko.obj-type      = substring(bf_usr-flt.call-point, 9, 3)
      143       tt-usrstko.obj-code      = integer(substring(bf_usr-flt.call-point, 12))
      144       tt-usrstko.level         = integer(entry(1, bf_usr-flt.naim))
      145       tt-usrstko.main-obj-type = substring(bf_usr-flt.list_, 1, 3)
      146       tt-usrstko.main-obj-code = integer(substring(bf_usr-flt.list_, 4)).
      147     if tt-usrstko.main-obj-code <> ? then do:
      148       find first bf_main-clients where bf_main-clients.obj-type = tt-usrstko.main-obj-type and
      149                                        bf_main-clients.obj-code = tt-usrstko.main-obj-code no-lock.
      150       assign
      151         tt-usrstko.main-obj-name = bf_main-clients.obj-name.
      152     end.
      153     if tt-usrstko.obj-type = 'маг':U then do:
      154       find first bf_shop where bf_shop.obj-code = tt-usrstko.obj-code no-lock.
      155       find first bf_host-clients where bf_host-clients.obj-type = 'орг':U and
      156                                        bf_host-clients.obj-code =  bf_shop.host-code no-lock.
      157     end.
      158     else do:
      159       find first bf_store where bf_store.obj-code = tt-usrstko.obj-code no-lock.
      160       find first bf_host-clients where bf_host-clients.obj-type = 'орг':U             and
      161                                        bf_host-clients.obj-code = bf_store.host-code no-lock.
      162     end.
      163     assign
      164       tt-usrstko.host-code = bf_host-clients.obj-code
      165       tt-usrstko.host-name = bf_host-clients.obj-name.
      166     find first bf_clients where bf_clients.obj-type = tt-usrstko.obj-type and
      167                                 bf_clients.obj-code = tt-usrstko.obj-code no-lock.
      168     find first bf_db where bf_db.db-num = bf_clients.db-num no-lock.
      169     assign
      170       tt-usrstko.obj-name = bf_clients.obj-name
      171       tt-usrstko.db-num   = bf_db.db-num.
      172   end.
      173   END PROCEDURE.
      174   define new global shared variable g#libbcrcn as handle no-undo .
      175   define new global shared variable g#library  as handle no-undo .
      176   define new global shared variable g#library2 as handle no-undo .
      177   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   define variable v-waitfram-action01         as character   no-undo .
      179   define variable v-waitfram-action02         as character   no-undo .
      180   define variable v-waitfram-action03         as character   no-undo .
      181   define variable mWaitFramTextBeg            as character   no-undo.
      182   define variable mWaitFramTextEnd            as character   no-undo.
      183   define variable mWaitFramView               as logical     no-undo.
      184   define variable mWaitProcEvent              as logical     no-undo init yes.
      185   define variable mWaitFramInterval           as integer     no-undo init 1 .
      186   define variable mWaitFramStop               as logical     no-undo.
      187   define variable mWaitFramStopUser           as logical     no-undo.
      188   define variable mWaitFramStopTimeOut        as logical     no-undo.
      189   define variable mWaitFramStartProc          as datetime-tz no-undo.
      190   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      191   define button B-WaitFramStop auto-end-key
      192        label "Стоп"
      193        size 10 by 1 tooltip "Остоновить процесс".
      194   define button B-viewProcInfo
      195        label "Информация"
      196        size 15 by 1 tooltip "Информация о процесс".
      197   define frame waitfram
      198     v-waitfram-action01 format "x(72)" no-label skip
      199     v-waitfram-action02 format "x(72)" no-label skip
      200     v-waitfram-action03 format "x(72)" no-label skip
      201     B-viewProcInfo
      202     B-WaitFramStop at row 4 col 30
      203     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      204     .
      205   define new global shared variable mBatchMode as logical no-undo init ?.
      206   define variable mFramBachModHandle as handle no-undo.
      207   mFramBachModHandle = frame waitfram:handle.
      208   define variable mFameOldVis as logical no-undo.
      209   define variable mVisCUrentVin as logical no-undo.
      210   if session:batch-mode
      211   then
      212      mBatchMode = yes.
      213   if mBatchMode = ? then do:
      214     mVisCUrentVin = current-window:visible.
      215     mFameOldVis = mFramBachModHandle:visible.
      216     mFramBachModHandle:visible  = yes.
      217     mBatchMode = mFramBachModHandle:visible ne yes.
      218     mFramBachModHandle:visible = mFameOldVis.
      219     current-window:visible = mVisCUrentVin.
      220   end.
      221    if  log-manager:logfile-name ne ?
      222     then DO:
      223         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      224         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      225         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      226     end.
      227   on choose of B-WaitFramStop in frame waitfram
      228   do:
      229     mWaitFramStop = yes.
      230     mWaitFramStopUser = yes.
      231   end.
      232   function waitfram-check-timeout returns logical():
      233      define variable vtime as int64 no-undo.
      234      if mWaitFramStopTimeOut
      235      then
      236         return yes.
      237      vtime = ( now - mWaitFramStartProc ) / 1000 .
      238      if     mWaitFramTimeOut ne ?
      239         and mWaitFramTimeOut ne 0
      240         and mWaitFramTimeOut lt vtime
      241      then do:
      242         mWaitFramStopTimeOut = yes.
      243      end.
      244      return mWaitFramStopTimeOut.
      245   end.
      246   procedure waitfram-hide :
      247     if not session:batch-mode
      248     then do
      249     on error undo, return error return-value
      250     :
      251       pause 0 before-hide .
      252       if not mBatchMode then
      253         hide frame waitfram .
      254     if     not mWaitFramView
      255        and mWaitProcEvent
      256     then
      257       process events .
      258     end.
      259   end procedure.
      260   procedure waitfram-show :
      261     define input  parameter p-message as character no-undo .
      262     define variable v-left-margin as integer   no-undo .
      263     if not session:batch-mode
      264     then do
      265     on error undo, return error return-value
      266     :
      267       if length(p-message) <= 70 then do:
      268         assign
      269           v-left-margin = integer((70 - length(p-message)) / 2)
      270         .
      271         assign
      272           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      273         .
      274         assign
      275           v-waitfram-action01 = " "
      276           v-waitfram-action02 = " "
      277                                    + fill(" ", v-left-margin)
      278                                    + p-message
      279           v-waitfram-action03 = " "
      280         .
      281       end.
      282       else do:
      283         define variable vRindex1 as integer no-undo.
      284         define variable vRindex2 as integer no-undo.
      285         vRindex1 = r-index(p-message," ",70).
      286         if vRindex1 = 0
      287         then
      288            vRindex1 = 70.
      289         if length(p-message)  <= vRindex1 + 70 then do:
      290           assign
      291             v-waitfram-action01 = " "
      292             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      293             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      294           .
      295         end.
      296         else do:
      297           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      298           if vRindex2 <= vRindex1
      299           then
      300              vRindex2 = vRindex1 + 70.
      301           assign
      302             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      303             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      304             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      305           .
      306         end.
      307       end.
      308       B-viewProcInfo:visible   in frame waitfram = no.
      309       B-viewProcInfo:sensitive in frame waitfram = no.
      310       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      311       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      312       if  (   mWaitFramView
      313          or  mWaitProcEvent)
      314          and not mBatchMode
      315       then
      316          display
      317             v-waitfram-action01 skip
      318             v-waitfram-action02 skip
      319             v-waitfram-action03 skip
      320          with frame waitfram .
      321       if     mWaitFramView
      322          then do:
      323             if     mWaitFramInterval ne ?
      324                and not mBatchMode
      325             then
      326                wait-for go of frame waitfram pause mWaitFramInterval.
      327          end.
      328          else
      329             if     mWaitProcEvent
      330                and not mBatchMode
      331             then
      332                process events .
      333     end.
      334   end procedure.
      335      procedure waitfram-show-this:
      336         define input  parameter iInterval as int64 no-undo.
      337         define variable vtime as int64 no-undo.
      338         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      339         mWaitFramInterval = iInterval.
      340         run waitfram-show (substitute("&1&2 &3&4" ,
      341                                       mWaitFramTextBeg ,
      342                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      343                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      344                                       mWaitFramTextEnd
      345                                      )
      346                           ).
      347      end.
      348      procedure WaitFramRunPause:
      349         define input  parameter iInterval as dec no-undo.
      350         define variable vStart  as datetime-tz no-undo.
      351         define variable vend    as datetime-tz no-undo.
      352         define variable vint as int64 no-undo.
      353         define variable vOk as logical no-undo.
      354         vStart = now.
      355         vend   = vStart.
      356         publish "WaitFramPause" (iInterval,output vOk).
      357         vend   =  now.
      358         vint = vend - vStart.
      359         vint = iInterval - vint / 1000.
      360         if     not mWaitFramStop
      361            and (   vint > 0
      362                 or (    not vOk
      363                     and iInterval eq ?
      364                     )
      365                 )
      366         then
      367            run waitfram-show-this (iInterval).
      368         vend   =  now.
      369         vint = vend - vStart.
      370         vint = iInterval - vint / 1000.
      371         if     not mWaitFramStop
      372            and vint > 0
      373         then do:
      374            run gbl/pause.p (vint * 1000).
      375         end.
      376         if iInterval ne ?
      377         then
      378            publish "WaitFramStop".
      379         waitfram-check-timeout().
      380      end.
      381      procedure WaitFramWaitFor:
      382         define input  parameter iInterval as dec no-undo.
      383         assign
      384            mWaitFramStartProc   = now
      385            mWaitFramStopUser    = no
      386            mWaitFramStopTimeOut = no
      387         .
      388         block-wait:
      389         do while not mWaitFramStop:
      390            run WaitFramRunPause (iInterval).
      391            if  waitfram-check-timeout()
      392            then do:
      393               leave block-wait.
      394            end.
      395         end.
      396         run waitfram-hide.
      397      end.
      398   procedure waitfram-join :
      399     define input  parameter p-line-1  as character no-undo .
      400     define input  parameter p-line-2  as character no-undo .
      401     define input  parameter p-line-3  as character no-undo .
      402     define output parameter p-message as character no-undo .
      403     do
      404     on error undo, return error return-value
      405     :
      406       assign
      407         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      408                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      409                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      410       .
      411     end.
      412   end procedure.
      413   function waitfram-join-function returns character
      414     (input p-line-1 as character
      415     ,input p-line-2 as character
      416     ,input p-line-3 as character
      417     ).
      418     define variable v-message as character no-undo .
      419     run waitfram-join in this-procedure
      420       (input  p-line-1
      421       ,input  p-line-2
      422       ,input  p-line-3
      423       ,output v-message
      424       ) .
      425     return v-message .
      426   end function .
