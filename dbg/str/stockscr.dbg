      478   procedure full-grp:
      479   def input param n-code like ub.gds-grp.node-code no-undo.
      480   def input-output param name like ub.goods.grp-name no-undo.
      481   def var uc like ub.gds-grp.upper-code no-undo.
      482   name = ''.
      483   find ub.gds-grp where ub.gds-grp.node-code = n-code.
      484   do while ub.gds-grp.upper-code <> 0:
      485     assign
      486       name = if name = '' then ub.gds-grp.node-name
      487                    else ub.gds-grp.node-name + '/' + name
      488       uc = ub.gds-grp.upper-code.
      489     find ub.gds-grp where ub.gds-grp.node-code = uc.
      490   end.
      491   end procedure.
      492   DEFINE BUTTON b-admin
      493        LABEL "Настройка"
      494        SIZE 10 BY 1.
      495   DEFINE BUTTON b-exit AUTO-GO
      496        LABEL "Выход"
      497        SIZE 10 BY 1
      498        BGCOLOR 8 .
      499   DEFINE BUTTON b-help
      500        LABEL "&Помощь"
      501        SIZE 10 BY 1
      502        BGCOLOR 8 .
      503   DEFINE BUTTON b-requery
      504        LABEL "Обновить все"
      505        SIZE 13.5 BY 1.
      506   DEFINE BUTTON b-requery-prt
      507        LABEL "Обновить признак"
      508        SIZE 17 BY 1.
      509   DEFINE VARIABLE varartic AS CHARACTER FORMAT "X(19)":U
      510        LABEL "Артикул"
      511        VIEW-AS FILL-IN
      512        SIZE 20 BY 1 NO-UNDO.
      513   DEFINE VARIABLE varb-c AS CHARACTER FORMAT "X(256)":U
      514        LABEL "Бар-код"
      515        VIEW-AS FILL-IN
      516        SIZE 14 BY 1 NO-UNDO.
      517   DEFINE VARIABLE vargds-cnt AS CHARACTER FORMAT "X(256)":U
      518        LABEL "Начало слова"
      519        VIEW-AS FILL-IN
      520        SIZE 27.63 BY 1 NO-UNDO.
      521   DEFINE VARIABLE vargds-name AS CHARACTER FORMAT "X(256)":U
      522        LABEL "Начало названия"
      523        VIEW-AS FILL-IN
      524        SIZE 27.63 BY 1 NO-UNDO.
      525   DEFINE QUERY b-goods FOR
      526         tt-goods,
      527         tt-cont-goods SCROLLING.
      528   DEFINE QUERY b-stock FOR
      529         tt-stock SCROLLING.
      530   DEFINE BROWSE b-goods
      531     QUERY b-goods DISPLAY
      532         tt-goods.artic                              column-label "Артикул"
      533     tt-goods.gds-name  format "x(20)"  column-label "Название товара"
      534     tt-goods.prt-name  format "x(20)"  column-label "Признак"
      535     tt-goods.unit-base  format "x(3)"               column-label "Изм"
      536     tt-goods.fact-qnty                              column-label "Факт"
      537     tt-goods.free-qnty                              column-label "Свободно"
      538     tt-goods.prod-name  format "x(50)"              column-label "Производитель"
      539     tt-goods.grp-name  format "x(50)"              column-label "Группа"
      540   enable tt-goods.grp-name
      541       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.75 BY 10.63.
      542   DEFINE BROWSE b-stock
      543     QUERY b-stock DISPLAY
      544         tt-stock.obj-code
      545   tt-stock.obj-type
      546   tt-stock.fact-qnty
      547   tt-stock.free-qnty
      548   tt-stock.price-sale
      549   tt-stock.data-date column-label "Дата актуальности"
      550   string-time(tt-stock.data-time) column-label "Время         "
      551       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.75 BY 7.38.
      552   DEFINE FRAME Dialog-Frame
      553        b-goods AT ROW 5.5 COL 1.5
      554        b-exit AT ROW 1 COL 1
      555        b-requery AT ROW 1 COL 11
      556        b-requery-prt AT ROW 1 COL 24.5
      557        b-admin AT ROW 1 COL 41.5
      558        b-help AT ROW 1 COL 51.5
      559        varartic AT ROW 2.5 COL 16 COLON-ALIGNED
      560        vargds-name AT ROW 4 COL 16 COLON-ALIGNED
      561        varb-c AT ROW 2.5 COL 63.5 COLON-ALIGNED
      562        b-stock AT ROW 16.25 COL 1.5
      563        vargds-cnt AT ROW 4 COL 63.5 COLON-ALIGNED
      564        SPACE(6.12) SKIP(18.63)
      565       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      566            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      567            TITLE "Остатки товаров"
      568            DEFAULT-BUTTON b-exit.
      569   ASSIGN
      570          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      571          FRAME Dialog-Frame:HIDDEN           = TRUE.
      572   ON END-ERROR OF FRAME Dialog-Frame
      573   DO:
      574     return no-apply.
      575   END.
      576   ON return OF FRAME Dialog-Frame
      577   DO:
      578     return no-apply.
      579   END.
      580   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      581   DO:
      582     APPLY "END-ERROR":U TO SELF.
      583   END.
      584   ON CHOOSE OF b-admin IN FRAME Dialog-Frame
      585   DO:
      586   define variable varlog as logical no-undo.
      587     run str/stkscrad.w (input paruser-name, output varchg) no-error.
      588     if error-status:error then do:
      589         message "Ошибка при настройке объектов." view-as alert-box.
      590         return no-apply.
      591       end.
      592       if varchg = yes then do:
      593         for each tt-usrstko :
      594           delete tt-usrstko.
      595         end.
      596         run loadusr-tt in this-procedure (input paruser-name) no-error.
      597         if error-status:error then do:
      598           message "Ошибка при работе с объектами пользователя." view-as alert-box.
      599           return no-apply.
      600         end.
      601         message "Набор объектов был изменен."
      602         "Будем обновлять данные?" view-as alert-box question buttons yes-no update varlog.
      603         if varlog = yes then do:
      604           run change-brw in this-procedure no-error.
      605           if error-status:error then do:
      606             message "Ошибка при обновлении информации." view-as alert-box error.
      607             return no-apply.
      608           end.
      609         end.
      610       end.
      611   END.
      612   ON ANY-PRINTABLE OF b-goods IN FRAME Dialog-Frame
      613   DO:
      614       apply "any-printable" to varartic in frame Dialog-Frame.
      615   END.
      616   ON BACKSPACE OF b-goods IN FRAME Dialog-Frame
      617   DO:
      618     apply "any-printable" to varartic in frame Dialog-Frame.
      619     return no-apply.
      620   END.
      621   ON GO OF b-goods IN FRAME Dialog-Frame
      622   DO:
      623     return no-apply.
      624   END.
      625   ON return OF b-goods IN FRAME Dialog-Frame
      626   DO:
      627     return no-apply.
      628   END.
      629   ON VALUE-CHANGED OF b-goods IN FRAME Dialog-Frame
      630   DO:
      631     OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      632     assign
      633        varartic    = ""
      634        varb-c      = ""
      635        vargds-name = ""
      636        .
      637        display varartic varb-c vargds-name with frame Dialog-Frame.
      638   END.
      639   ON CHOOSE OF b-requery IN FRAME Dialog-Frame
      640   DO:
      641     run change-brw in this-procedure.
      642   END.
      643   ON CHOOSE OF b-requery-prt IN FRAME Dialog-Frame
      644   DO:
      645   define variable varobj-type like ub.clients.obj-type no-undo.
      646   define variable varobj-code like ub.clients.obj-code no-undo.
      647   define variable varrec-id as recid no-undo.
      648   define variable parfact-qnty like ub.prt-obj.fact-qnty no-undo.
      649   define variable parfree-qnty like ub.prt-obj.free-qnty no-undo.
      650   define variable varartic like tt-goods.artic no-undo.
      651   define variable varprod-type like tt-goods.prod-type no-undo.
      652   define variable varprod-code like tt-goods.prod-code no-undo.
      653   define variable varprt-code like tt-goods.prt-code no-undo.
      654   define variable varprt-root like tt-goods.prt-root no-undo.
      655   define variable varprt-name like tt-goods.prt-name no-undo.
      656   define buffer bf_tt-goods for tt-goods.
      657   define buffer bf_prt-obj  for ub.prt-obj.
      658   define buffer bf_gds-prt  for ub.gds-prt.
      659   define variable parrec-id as recid no-undo.
      660   if available tt-goods then do:
      661    assign
      662       varartic     = tt-goods.artic
      663       varprod-type = tt-goods.prod-type
      664       varprod-code = tt-goods.prod-code
      665       varprt-code  = tt-goods.prt-code
      666       varprt-root  = tt-goods.prt-root
      667       varprt-name  = tt-goods.prt-name.
      668    if available tt-stock then do:
      669     assign
      670      varobj-type = tt-stock.obj-type
      671      varobj-code = tt-stock.obj-code.
      672    end.
      673    run waitfram-show in this-procedure
      674      (input "Подготовка остатков товаров для просмотра"
      675      ).
      676    for each bf_tt-goods where bf_tt-goods.artic     = tt-goods.artic     and
      677                               bf_tt-goods.prod-type = tt-goods.prod-type and
      678                               bf_tt-goods.prod-code = tt-goods.prod-code and
      679                               bf_tt-goods.prt-root  = tt-goods.prt-root  and
      680                               bf_tt-goods.prt-name  begins tt-goods.prt-name :
      681      for each tt-stock where tt-stock.artic     = bf_tt-goods.artic and
      682                              tt-stock.prod-type = bf_tt-goods.prod-type and
      683                              tt-stock.prod-code = bf_tt-goods.prod-code and
      684                              tt-stock.prt-code  = bf_tt-goods.prt-code :
      685         delete tt-stock.
      686      end.
      687      delete bf_tt-goods.
      688   end.
      689    for each tt-usrstko no-lock,
      690      each bf_prt-obj where bf_prt-obj.obj-type  = tt-usrstko.obj-type and
      691                            bf_prt-obj.obj-code  = tt-usrstko.obj-code and
      692                            bf_prt-obj.artic     = varartic and
      693                            bf_prt-obj.prod-type = varprod-type and
      694                            bf_prt-obj.prod-code = varprod-code no-lock,
      695          first bf_gds-prt where  bf_gds-prt.node-code = bf_prt-obj.prt-code and
      696                                  bf_gds-prt.prt-root = varprt-root and
      697                                  bf_gds-prt.f-name begins varprt-name no-lock
      698                         :
      699      if bf_prt-obj.fact-qnty = 0 and
      700         bf_prt-obj.free-qnty = 0 then next.
      701      run create-tt-goods (input bf_prt-obj.artic,
      702                          input bf_prt-obj.prod-type,
      703                          input bf_prt-obj.prod-code,
      704                          input bf_prt-obj.prt-code,
      705                          output parrec-id) no-error.
      706      if error-status:error then do:
      707        message "Ошибка при создании товарной записи." view-as alert-box.
      708        return no-apply.
      709      end.
      710      find first bf_tt-goods where recid(bf_tt-goods) = parrec-id.
      711      assign
      712        bf_tt-goods.fact-qnty = bf_tt-goods.fact-qnty + bf_prt-obj.fact-qnty
      713        bf_tt-goods.free-qnty = bf_tt-goods.free-qnty + bf_prt-obj.free-qnty.
      714      run calc-stock in this-procedure
      715         (input tt-usrstko.obj-type,
      716          input tt-usrstko.obj-code,
      717          input tt-usrstko.db-num,
      718          input tt-usrstko.main-obj-type,
      719          input tt-usrstko.main-obj-code,
      720          input tt-usrstko.host-code,
      721          input tt-usrstko.host-name,
      722          input tt-usrstko.level,
      723          input bf_tt-goods.artic,
      724          input bf_tt-goods.prod-type,
      725          input bf_tt-goods.prod-code,
      726          input bf_tt-goods.prt-code,
      727          input bf_prt-obj.price-sale,
      728          input bf_prt-obj.fact-qnty,
      729          input bf_prt-obj.free-qnty) no-error.
      730        if error-status:error then do:
      731           message "Ошибка при подсчете остатков." view-as alert-box error.
      732           return no-apply.
      733        end.
      734    end.
      735    OPEN QUERY b-goods FOR EACH tt-goods use-index ford-num,        FIRST tt-cont-goods OUTER-JOIN WHERE TRUE.
      736    find first tt-goods where tt-goods.artic = varartic and
      737                                         tt-goods.prod-type = varprod-type and
      738                                         tt-goods.prod-code = varprod-code and
      739                                         tt-goods.prt-code = varprt-code  no-error.
      740    if available tt-goods then do:
      741      reposition b-goods to recid recid(tt-goods) no-error.
      742    end.
      743    else do:
      744      message "Данного признака(товара) больше нет в наличии." view-as alert-box.
      745    end.
      746    OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      747    find first   tt-stock where tt-stock.obj-type   = varobj-type        and
      748                                tt-stock.obj-code   = varobj-code        and
      749                                tt-stock.artic      = tt-goods.artic     and
      750                                tt-stock.prod-type  = tt-goods.prod-type and
      751                                tt-stock.prod-code  = tt-goods.prod-code and
      752                                tt-stock.prt-code   = tt-goods.prt-code  no-error.
      753    if available tt-stock then do:
      754      reposition b-stock to recid recid(tt-stock) no-error.
      755    end.
      756    run waitfram-hide in this-procedure .
      757   end.
      758   END.
      759   ON GO OF b-stock IN FRAME Dialog-Frame
      760   DO:
      761       return no-apply.
      762   END.
      763   ON return OF b-stock IN FRAME Dialog-Frame
      764   DO:
      765     return no-apply.
      766   END.
      767   ON ANY-PRINTABLE OF varartic IN FRAME Dialog-Frame
      768   DO:
      769     define variable varrec-id as recid no-undo.
      770     display "" @ vargds-name "" @ varb-c with frame Dialog-Frame.
      771     assign frame Dialog-Frame varartic.
      772     if last-event:label = "backspace" then do:
      773         assign varartic = substring (varartic, 1, length(varartic) - 1).
      774       end.
      775       else do:
      776       if last-event:label <> "enter" then do:
      777         assign varartic = varartic + last-event:label.
      778       end.
      779     end.
      780     display varartic with frame Dialog-Frame.
      781     find first tt-goods where tt-goods.artic begins varartic no-error.
      782     if available tt-goods then do:
      783       assign
      784         varrec-id = recid(tt-goods).
      785         reposition b-goods to recid varrec-id no-error.
      786       OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      787       find first   tt-stock where tt-stock.artic      = tt-goods.artic     and
      788                                   tt-stock.prod-type  = tt-goods.prod-type and
      789                                   tt-stock.prod-code  = tt-goods.prod-code and
      790                                   tt-stock.prt-code   = tt-goods.prt-code  no-error.
      791       if available tt-stock then do:
      792         varrec-id = recid(tt-stock).
      793         reposition b-stock to recid varrec-id no-error.
      794       end.
      795     end.
      796     return no-apply.
      797   END.
      798   ON return OF varartic IN FRAME Dialog-Frame
      799   DO:
      800     apply "any-printable" to varartic in frame Dialog-Frame.
      801     return no-apply.
      802   END.
      803   ON GO OF varb-c IN FRAME Dialog-Frame
      804   DO:
      805       return no-apply.
      806   END.
      807   ON return OF varb-c IN FRAME Dialog-Frame
      808   DO:
      809   define buffer bf_bar-code for ub.bar-code.
      810   define buffer bf_prod-bc  for ub.prod-bc.
      811   define buffer bf_place    for ub.place.
      812   define buffer bf_goods    for ub.goods.
      813   define buffer bf_tt-goods for tt-goods.
      814   define variable par-type as character no-undo.
      815   define variable varresult  as character no-undo.
      816   define variable vartype-bc as character no-undo.
      817   define variable varweigth  as decimal   no-undo.
      818   assign frame Dialog-Frame varb-c.
      819   display "" @ vargds-name "" @ varartic with frame Dialog-Frame.
      820   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   define variable varscales-pref as character no-undo .
      822   define variable varpgscales-pref as character no-undo .
      823   define variable varscales-pref-type1 as character no-undo.
      824   varscales-pref  = ?.
      825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      826     (input  'sclspref':u
      827     ,input  '':u
      828     ,input  '':u
      829     ,input  0
      830     ,input  '':u
      831     ,input  '':u
      832     ,input  '':u
      833     ,input  no
      834     ,output varscales-pref
      835     ,output varscales-pref-type1
      836     ) no-error .
      837   if varscales-pref = ? then do:
      838     assign
      839     varscales-pref = '21,23,25':U.
      840   end.
      841   define variable varpgscales-pref-type1 as character no-undo.
      842   varpgscales-pref  = ?.
      843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      844     (input  'scpgpref':u
      845     ,input  '':u
      846     ,input  '':u
      847     ,input  0
      848     ,input  '':u
      849     ,input  '':u
      850     ,input  '':u
      851     ,input  no
      852     ,output varpgscales-pref
      853     ,output varpgscales-pref-type1
      854     ) no-error .
      855   if varpgscales-pref = ? then do:
      856     assign
      857     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
      858   end.
      859   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
      860   (
      861    input  ?
      862   ,input  varb-c
      863   ,input  ?
      864   ,input  ?
      865   ,input  ?
      866   ,input  no
      867   ,input  no
      868   ,input  varscales-pref
      869   ,input  varpgscales-pref
      870   ,output varresult
      871   ,output vartype-bc
      872   ,output varweigth
      873   ,buffer bf_bar-code
      874   ,buffer bf_prod-bc
      875   ,buffer bf_place
      876   ) .
      877   if available bf_bar-code then do:
      878     find first bf_goods where bf_goods.gds-code = bf_bar-code.gds-code no-lock.
      879     find first bf_tt-goods where bf_tt-goods.artic     = bf_goods.artic        and
      880                                  bf_tt-goods.prod-type = bf_goods.prod-type    and
      881                                  bf_tt-goods.prod-code = bf_goods.prod-code    and
      882                                  bf_tt-goods.prt-code  = bf_bar-code.node-code no-error.
      883     reposition b-goods to recid recid(bf_tt-goods) no-error.
      884     OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      885     find first   tt-stock where tt-stock.artic      = bf_tt-goods.artic     and
      886                                 tt-stock.prod-type  = bf_tt-goods.prod-type and
      887                                 tt-stock.prod-code  = bf_tt-goods.prod-code and
      888                                 tt-stock.prt-code   = bf_tt-goods.prt-code  no-error.
      889     if available tt-stock then do:
      890       reposition b-stock to recid recid(tt-stock) no-error.
      891     end.
      892   end.
      893   return no-apply.
      894   END.
      895   ON GO OF vargds-cnt IN FRAME Dialog-Frame
      896   DO:
      897       return no-apply.
      898   END.
      899   ON return OF vargds-cnt IN FRAME Dialog-Frame
      900   DO:
      901     define buffer bf_goods for ub.goods.
      902     assign frame Dialog-Frame vargds-cnt.
      903     if vargds-cnt <> "":u then do:
      904       display "" @ varartic "" @ varb-c "" @ vargds-name with frame Dialog-Frame.
      905       for each tt-cont-goods :
      906         delete tt-cont-goods.
      907       end.
      908       for each bf_goods where bf_goods.gds-name contains vargds-cnt no-lock:
      909         create tt-cont-goods.
      910         buffer-copy bf_goods to tt-cont-goods.
      911       end.
      912       OPEN QUERY b-goods FOR EACH tt-goods, FIRST tt-cont-goods where tt-cont-goods.artic     = tt-goods.artic     AND
      913                                                                       tt-cont-goods.prod-type = tt-goods.prod-type AND
      914                                                                       tt-cont-goods.prod-code = tt-goods.prod-code.
      915       GET FIRST b-goods.
      916       IF not available tt-goods THEN DO:
      917        FIND first tt-cont-goods NO-ERROR.
      918        IF AVAILABLE tt-cont-goods THEN DO:
      919          MESSAGE "Товары имеющие в начале слова <" vargds-cnt "> есть в базе данных. Но по ним нет остатка товара."
      920          VIEW-AS ALERT-BOX.
      921        END.
      922       END.
      923       OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      924     end.
      925     else do:
      926       OPEN QUERY b-goods FOR EACH tt-goods use-index ford-num,        FIRST tt-cont-goods OUTER-JOIN WHERE TRUE.
      927       OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      928     end.
      929     return no-apply.
      930   END.
      931   ON CTRL-J OF vargds-name IN FRAME Dialog-Frame
      932   DO:
      933     define variable varrec-id as recid no-undo.
      934     display "" @ varartic "" @ varb-c with frame Dialog-Frame.
      935     assign frame Dialog-Frame vargds-name.
      936     find next tt-goods where tt-goods.gds-name begins vargds-name use-index gds-name no-error.
      937      if available tt-goods then do:
      938         assign
      939            varrec-id = recid(tt-goods).
      940         reposition b-goods to recid varrec-id no-error.
      941         OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      942         find first tt-stock where   tt-stock.artic      = tt-goods.artic     and
      943                                     tt-stock.prod-type  = tt-goods.prod-type and
      944                                     tt-stock.prod-code  = tt-goods.prod-code and
      945                                     tt-stock.prt-code   = tt-goods.prt-code  no-error.
      946         if available tt-stock then do:
      947           varrec-id = recid(tt-stock).
      948           reposition b-stock to recid varrec-id no-error.
      949         end.
      950      end.
      951   return no-apply.
      952   END.
      953   ON GO OF vargds-name IN FRAME Dialog-Frame
      954   DO:
      955       return no-apply.
      956   END.
      957   ON return OF vargds-name IN FRAME Dialog-Frame
      958   DO:
      959     define variable varrec-id as recid no-undo.
      960     display "" @ varartic "" @ varb-c with frame Dialog-Frame.
      961     assign frame Dialog-Frame vargds-name.
      962     find first tt-goods where tt-goods.gds-name begins vargds-name no-error.
      963      if available tt-goods then do:
      964         assign
      965            varrec-id = recid(tt-goods).
      966         reposition b-goods to recid varrec-id no-error.
      967         OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
      968         find first tt-stock where   tt-stock.artic      = tt-goods.artic     and
      969                                     tt-stock.prod-type  = tt-goods.prod-type and
      970                                     tt-stock.prod-code  = tt-goods.prod-code and
      971                                     tt-stock.prt-code   = tt-goods.prt-code  no-error.
      972         if available tt-stock then do:
      973           varrec-id = recid(tt-stock).
      974           reposition b-stock to recid varrec-id no-error.
      975         end.
      976      end.
      977   return no-apply.
      978   END.
      979   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      980   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      981   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   on help of frame Dialog-Frame
      983   do:
      984     run gbl/app_help.p
      985       (input this-procedure :file-name
      986       ,input ''
      987       ,input ?
      988       ) no-error.
      989     if error-status :error then do:
      990       message
      991         "Ошибка при вызове помощи"
      992         error-status :get-message(1)
      993         view-as alert-box .
      994     end.
      995   end.
      996   run minbtn-set in this-procedure .
      997   on choose of b-help in frame Dialog-Frame
      998   do:
      999     apply "help":u to frame Dialog-Frame .
     1000   end.
     1001   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   procedure minbtn-set :
     1003       do
     1004           on error undo, return error return-value
     1005           :
     1006           define variable ii              as integer       no-undo .
     1007           define variable fh              as widget-handle no-undo .
     1008           define variable hh              as widget-handle no-undo .
     1009           define variable v-h             as handle        extent 4 no-undo .
     1010           define variable v-name-button   as character     no-undo .
     1011           define variable v-help-old-x    as decimal       no-undo .
     1012           define variable v-help-old-y    as decimal       no-undo .
     1013           define variable v-help-old-size as decimal       no-undo .
     1014           define variable v-frame-width   as decimal       no-undo .
     1015           define variable jj              as integer       no-undo .
     1016           do
     1017               on error undo, return error
     1018               :
     1019               assign
     1020                   v-frame-width = frame Dialog-Frame:width - 0.3
     1021                   fh            = frame Dialog-Frame:first-child
     1022                   hh            = fh:first-child
     1023                   ii            = 1
     1024                   .
     1025               do while valid-handle(hh):
     1026                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1027                   do:
     1028                       case lc(hh:name) :
     1029                           when "b-help" then
     1030                               do:
     1031                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1032                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1033                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1034                                   hh:TOOLTIP = "Помощь" .
     1035                                   v-help-old-x = hh:column .
     1036                                   v-help-old-y = hh:row    .
     1037                                   v-help-old-size = hh:width .
     1038                                   hh:width-chars = 2.5 .
     1039                               end.
     1040                           when "b-print" then
     1041                               do:
     1042                                   hh:load-image("cmp/b-print.bmp":u) .
     1043                                   hh:TOOLTIP = "Печать" .
     1044                                   v-h[ii] = hh:handle .
     1045                                   ii = ii + 1 .
     1046                                   hh:width-chars = 3 .
     1047                               end.
     1048                           when "b-history" or
     1049                           when "b-hist" then
     1050                               do:
     1051                                   hh:load-image("cmp/b-hist.bmp":u) .
     1052                                   hh:TOOLTIP = "История" .
     1053                                   v-h[ii] = hh:handle .
     1054                                   ii = ii + 1 .
     1055                                   hh:width-chars = 3 .
     1056                               end.
     1057                           when "b-sch" then
     1058                               do:
     1059                                   hh:load-image("cmp/b-sch.bmp":u) .
     1060                                   hh:TOOLTIP = "Установка Фильтра" .
     1061                                   v-h[ii] = hh:handle .
     1062                                   ii = ii + 1 .
     1063                                   hh:width-chars = 3 .
     1064                               end.
     1065                           when "b-hist-user" then
     1066                               do:
     1067                                   hh:load-image("cmp/b-hist.bmp":u) .
     1068                                   hh:TOOLTIP = "История пользователя" .
     1069                                   ii = ii + 1 .
     1070                               end.
     1071                       end case.
     1072                   end.
     1073                   hh = hh:next-sibling.
     1074               end.
     1075               b-help:column = v-frame-width - b-help:width-chars.
     1076               jj = 0.
     1077               repeat ii = 4 to 1 by -1 :
     1078                   if valid-handle (v-h[ii] ) then
     1079                   do:
     1080                       jj  = jj + 1 .
     1081                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1082                       v-h[ii]:row    = v-help-old-y .
     1083                   end.
     1084               end.
     1085           end.
     1086       end.
     1087   end procedure.
     1088   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1089   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1090   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1091   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1092   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1093   define variable v-diasize-current-frame-height as decimal   no-undo .
     1094   define variable v-diasize-change-size          as logical   no-undo .
     1095   define variable v-diasize-resize-button        as handle    no-undo .
     1096   define variable v-diasize-wndmax               as logical   no-undo .
     1097   define variable v-diasize-wndstore             as logical   no-undo .
     1098   define variable v-diasize-proc-name            as character no-undo .
     1099   define variable v-diasize-browse-handle        as handle    no-undo .
     1100   define variable v-diasize-browse-number        as integer   no-undo .
     1101   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1102   define temp-table temp-diasize-handle no-undo
     1103     field handle-value  as handle
     1104     field save-position as decimal
     1105     index xpk is primary unique handle-value
     1106     .
     1107   define temp-table temp-browse-handle no-undo
     1108     field browse-type   as character
     1109     field browse-number as integer
     1110     field browse-handle as handle
     1111     field original-size as decimal
     1112     index xpk is primary unique browse-type browse-number
     1113     index xie browse-type browse-handle
     1114   .
     1115   procedure diasize_change-height :
     1116     define input  parameter p-change-value  as decimal   no-undo .
     1117     define input  parameter p-move-resize   as logical   no-undo .
     1118     define variable v-field-group-handle    as handle    no-undo .
     1119     define variable v-object-handle         as handle    no-undo .
     1120     define variable v-frame-height          as decimal   no-undo .
     1121     define variable v-frame-virtual-height  as decimal   no-undo .
     1122     define variable v-browse-height         as decimal   no-undo .
     1123     define variable v-window-height         as decimal   no-undo .
     1124     define variable v-window-virtual-height as decimal   no-undo .
     1125     define variable v-change-sign           as integer   no-undo .
     1126     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1127     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1128     if p-change-value > 0
     1129     then do:
     1130       if frame Dialog-Frame :height + p-change-value
     1131           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1132       then do:
     1133         assign
     1134           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1135                           - (frame Dialog-Frame :height-chars)
     1136         .
     1137         if p-change-value <= 0
     1138         then do:
     1139           run diasize_position-resize-button in this-procedure .
     1140           return .
     1141         end.
     1142       end.
     1143     end.
     1144     if p-change-value < 0
     1145     then do:
     1146       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1147       then do:
     1148         assign
     1149           p-change-value = v-diasize-orig-frame-height
     1150                          - (frame Dialog-Frame :height-chars)
     1151         .
     1152         if p-change-value >= 0
     1153         then do:
     1154           run diasize_position-resize-button in this-procedure .
     1155           return .
     1156         end.
     1157       end.
     1158     end.
     1159     if p-change-value >= 0
     1160     then do:
     1161       assign
     1162         v-change-sign = 1
     1163       .
     1164     end.
     1165     else do:
     1166       assign
     1167         v-change-sign = -1
     1168       .
     1169     end.
     1170     assign
     1171       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1172     .
     1173     if p-change-value = 0
     1174     then do:
     1175       run diasize_position-resize-button in this-procedure .
     1176       return .
     1177     end.
     1178     move_block:
     1179     do
     1180     on error undo move_block, retry move_block
     1181     :
     1182       if retry
     1183       then do:
     1184         do
     1185         on error undo move_block, leave move_block
     1186         :
     1187           if p-change-value > 0
     1188           then do:
     1189             for each buf_temp-diasize-handle
     1190             on error undo, next
     1191             :
     1192               assign
     1193                 v-object-handle = buf_temp-diasize-handle.handle-value
     1194               .
     1195               if v-object-handle <> v-diasize-resize-button
     1196               then do:
     1197                 assign
     1198                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1199                 .
     1200               end.
     1201             end.
     1202             assign
     1203               v-diasize-browse-handle :height = v-browse-height
     1204             .
     1205             for each buf_temp-browse-handle
     1206               where buf_temp-browse-handle.browse-type = 'height':u
     1207             on error undo, next
     1208             :
     1209               assign
     1210                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1211               .
     1212             end.
     1213             assign
     1214               frame Dialog-Frame :height = v-frame-height
     1215             .
     1216             if frame Dialog-Frame :scrollable = true
     1217             then do:
     1218               assign
     1219                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1220               .
     1221             end.
     1222             run diasize_position-resize-button in this-procedure .
     1223           end.
     1224           else do:
     1225             if frame Dialog-Frame :scrollable = true
     1226             then do:
     1227               assign
     1228                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1229               .
     1230             end.
     1231             assign
     1232               frame Dialog-Frame :height = v-frame-height
     1233             .
     1234             assign
     1235               v-diasize-browse-handle :height = v-browse-height
     1236             .
     1237             for each buf_temp-browse-handle
     1238               where buf_temp-browse-handle.browse-type = 'height':u
     1239             on error undo, next
     1240             :
     1241               assign
     1242                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1243               .
     1244             end.
     1245             for each buf_temp-diasize-handle
     1246             on error undo, next
     1247             :
     1248               assign
     1249                 v-object-handle = buf_temp-diasize-handle.handle-value
     1250               .
     1251               if v-object-handle <> v-diasize-resize-button
     1252               then do:
     1253                 assign
     1254                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1255                 .
     1256               end.
     1257             end.
     1258             run diasize_position-resize-button in this-procedure .
     1259           end.
     1260           assign
     1261             v-diasize-change-size = false
     1262           .
     1263           leave move_block .
     1264         end.
     1265       end.
     1266       assign
     1267         v-diasize-need-full-display = true
     1268       .
     1269       if v-diasize-change-size = false
     1270       then do:
     1271         assign
     1272           v-diasize-change-size = true
     1273         .
     1274       end.
     1275       else do:
     1276         return .
     1277       end.
     1278       assign
     1279         v-frame-height = frame Dialog-Frame :height
     1280         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1281         v-browse-height = v-diasize-browse-handle :height
     1282       .
     1283       for each buf_temp-browse-handle
     1284         where buf_temp-browse-handle.browse-type = 'height':u
     1285       :
     1286         assign
     1287           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1288         .
     1289       end.
     1290       for each buf_temp-diasize-handle
     1291       :
     1292         delete buf_temp-diasize-handle .
     1293       end.
     1294       assign
     1295         v-field-group-handle = frame Dialog-Frame :first-child
     1296       .
     1297       do while valid-handle(v-field-group-handle)
     1298       :
     1299         assign
     1300           v-object-handle = v-field-group-handle :first-child
     1301         .
     1302         do while valid-handle(v-object-handle)
     1303         :
     1304           if  v-object-handle <> v-diasize-browse-handle :handle
     1305           and can-query(v-object-handle, "row")
     1306           and can-query(v-object-handle, "height")
     1307           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1308           then do:
     1309             find first buf_temp-browse-handle
     1310               where buf_temp-browse-handle.browse-type   = 'height':u
     1311                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1312               no-error .
     1313             if available buf_temp-browse-handle
     1314             then do:
     1315             end.
     1316             else do:
     1317               create buf_temp-diasize-handle .
     1318               assign
     1319                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1320                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1321               .
     1322             end.
     1323           end.
     1324           assign
     1325             v-object-handle = v-object-handle :next-sibling
     1326           .
     1327         end.
     1328         assign
     1329           v-field-group-handle = v-field-group-handle :next-sibling
     1330         .
     1331       end.
     1332       do with frame Dialog-Frame
     1333       :
     1334         hide v-diasize-resize-button .
     1335         assign
     1336           v-diasize-resize-button :row    = 1
     1337           v-diasize-resize-button :column = 1
     1338         .
     1339       end.
     1340       if p-change-value > 0
     1341       then do:
     1342         if frame Dialog-Frame :scrollable = true
     1343         then do:
     1344           assign
     1345             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1346             no-error .
     1347           if error-status :error
     1348           or error-status :get-message(1) <> ""
     1349           then do:
     1350             undo move_block, retry move_block .
     1351           end.
     1352         end.
     1353         assign
     1354           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1355           no-error .
     1356         if error-status :error
     1357         or error-status :get-message(1) <> ""
     1358         then do:
     1359           undo move_block, retry move_block .
     1360         end.
     1361         assign
     1362           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1363           no-error .
     1364         if error-status :error
     1365         or error-status :get-message(1) <> ""
     1366         then do:
     1367           undo move_block, retry move_block .
     1368         end.
     1369         for each buf_temp-browse-handle
     1370           where buf_temp-browse-handle.browse-type = 'height':u
     1371         on error undo move_block, retry move_block
     1372         :
     1373           assign
     1374             buf_temp-browse-handle.browse-handle :height
     1375               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1376             no-error .
     1377           if error-status :error
     1378           or error-status :get-message(1) <> ""
     1379           then do:
     1380             undo move_block, retry move_block .
     1381           end.
     1382         end.
     1383         for each buf_temp-diasize-handle
     1384         on error undo move_block, retry move_block
     1385         :
     1386           assign
     1387             v-object-handle = buf_temp-diasize-handle.handle-value
     1388           .
     1389           if v-object-handle <> v-diasize-resize-button
     1390           then do:
     1391             assign
     1392               v-object-handle :row = v-object-handle :row + p-change-value
     1393               no-error .
     1394             if error-status :error
     1395             or error-status :get-message(1) <> ""
     1396             then do:
     1397               undo move_block, retry move_block .
     1398             end.
     1399           end.
     1400         end.
     1401       end.
     1402       else do:
     1403         for each buf_temp-diasize-handle
     1404         on error undo move_block, retry move_block
     1405         :
     1406           assign
     1407             v-object-handle = buf_temp-diasize-handle.handle-value
     1408           .
     1409           if v-object-handle <> v-diasize-resize-button
     1410           then do:
     1411             assign
     1412               v-object-handle :row = v-object-handle :row + p-change-value
     1413               no-error .
     1414             if error-status :error
     1415             or error-status :get-message(1) <> ""
     1416             then do:
     1417               undo move_block, retry move_block .
     1418             end.
     1419           end.
     1420         end.
     1421         assign
     1422           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1423           no-error .
     1424         if error-status :error
     1425         or error-status :get-message(1) <> ""
     1426         then do:
     1427           undo move_block, retry move_block .
     1428         end.
     1429         for each buf_temp-browse-handle
     1430           where buf_temp-browse-handle.browse-type = 'height':u
     1431         on error undo move_block, retry move_block
     1432         :
     1433           assign
     1434             buf_temp-browse-handle.browse-handle :height
     1435               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1436             no-error .
     1437           if error-status :error
     1438           or error-status :get-message(1) <> ""
     1439           then do:
     1440             undo move_block, retry move_block .
     1441           end.
     1442         end.
     1443         assign
     1444           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1445           no-error .
     1446         if error-status :error
     1447         or error-status :get-message(1) <> ""
     1448         then do:
     1449           undo move_block, retry move_block .
     1450         end.
     1451         if frame Dialog-Frame :scrollable = true
     1452         then do:
     1453           assign
     1454             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1455             no-error .
     1456           if error-status :error
     1457           or error-status :get-message(1) <> ""
     1458           then do:
     1459             undo move_block, retry move_block .
     1460           end.
     1461         end.
     1462       end.
     1463       if p-move-resize = true
     1464       then do:
     1465         run diasize_position-resize-button in this-procedure .
     1466       end.
     1467       if v-diasize-wndstore = true
     1468       then do:
     1469         if connected("ub") = true
     1470         then do:
     1471           define variable v-cntxt-db-num        as integer   no-undo .
     1472           define variable v-cntxt-userid        as character no-undo .
     1473           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1474                                             , OUTPUT v-cntxt-userid
     1475                                             ) .
     1476           run gbl/wndsizew.p
     1477             (input  v-cntxt-db-num
     1478             ,input  v-cntxt-userid
     1479             ,input  v-diasize-proc-name
     1480             ,input  'height':u
     1481             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1482             ) .
     1483         end.
     1484       end.
     1485     end.
     1486     assign
     1487       v-diasize-change-size = false
     1488     .
     1489   end procedure.
     1490   procedure diasize_set-height :
     1491     define input  parameter p-new-height  as decimal   no-undo .
     1492     define input  parameter p-move-resize as logical   no-undo .
     1493     do
     1494     on error undo, return error return-value
     1495     :
     1496       run diasize_change-height in this-procedure
     1497         (input  (p-new-height - frame Dialog-Frame :height)
     1498         ,input  p-move-resize
     1499         ) .
     1500     end.
     1501   end procedure.
     1502   procedure diasize_change-width :
     1503     define input  parameter p-change-value as decimal   no-undo .
     1504     define input  parameter p-move-resize  as logical   no-undo .
     1505     define variable v-field-group-handle   as handle    no-undo .
     1506     define variable v-object-handle        as handle    no-undo .
     1507     define variable v-frame-width          as decimal   no-undo .
     1508     define variable v-frame-virtual-width  as decimal   no-undo .
     1509     define variable v-browse-width         as decimal   no-undo .
     1510     define variable v-window-width         as decimal   no-undo .
     1511     define variable v-window-virtual-width as decimal   no-undo .
     1512     define variable v-change-sign          as integer   no-undo .
     1513     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1514     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1515     if p-change-value > 0
     1516     then do:
     1517       if frame Dialog-Frame :width + p-change-value >
     1518           session :width-chars
     1519       then do:
     1520         assign
     1521           p-change-value = session :width-chars - frame Dialog-Frame :width
     1522         .
     1523         if p-change-value <= 0
     1524         then do:
     1525           run diasize_position-resize-button in this-procedure .
     1526           return .
     1527         end.
     1528       end.
     1529     end.
     1530     if p-change-value < 0
     1531     then do:
     1532       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1533       then do:
     1534         assign
     1535           p-change-value = v-diasize-orig-frame-width
     1536                          - frame Dialog-Frame :width
     1537         .
     1538         if p-change-value >= 0
     1539         then do:
     1540           run diasize_position-resize-button in this-procedure .
     1541           return .
     1542         end.
     1543       end.
     1544     end.
     1545     if p-change-value >= 0
     1546     then do:
     1547       assign
     1548         v-change-sign = 1
     1549       .
     1550     end.
     1551     else do:
     1552       assign
     1553         v-change-sign = -1
     1554       .
     1555     end.
     1556     assign
     1557       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1558     .
     1559     if p-change-value = 0
     1560     then do:
     1561       run diasize_position-resize-button in this-procedure .
     1562       return .
     1563     end.
     1564     move_block:
     1565     do
     1566     on error undo move_block, leave move_block
     1567     :
     1568       if retry
     1569       then do:
     1570         do
     1571         on error undo move_block, leave move_block
     1572         :
     1573           if p-change-value > 0
     1574           then do:
     1575             for each buf_temp-diasize-handle
     1576             on error undo, next
     1577             :
     1578               assign
     1579                 v-object-handle = buf_temp-diasize-handle.handle-value
     1580               .
     1581               if v-object-handle <> v-diasize-resize-button
     1582               then do:
     1583                 assign
     1584                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1585                 .
     1586               end.
     1587             end.
     1588             assign
     1589               v-diasize-browse-handle :width = v-browse-width
     1590             .
     1591             for each buf_temp-browse-handle
     1592               where buf_temp-browse-handle.browse-type = 'width':u
     1593             on error undo, next
     1594             :
     1595               assign
     1596                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1597               .
     1598             end.
     1599             assign
     1600               frame Dialog-Frame :width = v-frame-width
     1601             .
     1602             if frame Dialog-Frame :scrollable = true
     1603             then do:
     1604               assign
     1605                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1606               .
     1607             end.
     1608             run diasize_position-resize-button in this-procedure .
     1609           end.
     1610           else do:
     1611             if frame Dialog-Frame :scrollable = true
     1612             then do:
     1613               assign
     1614                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1615               .
     1616             end.
     1617             assign
     1618               frame Dialog-Frame :width = v-frame-width
     1619             .
     1620             for each buf_temp-browse-handle
     1621               where buf_temp-browse-handle.browse-type = 'width':u
     1622             on error undo, next
     1623             :
     1624               assign
     1625                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1626               .
     1627             end.
     1628             assign
     1629               v-diasize-browse-handle :width = v-browse-width
     1630             .
     1631             for each buf_temp-diasize-handle
     1632             on error undo, next
     1633             :
     1634               assign
     1635                 v-object-handle = buf_temp-diasize-handle.handle-value
     1636               .
     1637               if v-object-handle <> v-diasize-resize-button
     1638               then do:
     1639                 assign
     1640                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1641                 .
     1642               end.
     1643             end.
     1644             run diasize_position-resize-button in this-procedure .
     1645           end.
     1646           assign
     1647             v-diasize-change-size = false
     1648           .
     1649           leave move_block .
     1650         end.
     1651       end.
     1652       assign
     1653         v-diasize-need-full-display = true
     1654       .
     1655       if v-diasize-change-size = false
     1656       then do:
     1657         assign
     1658           v-diasize-change-size = true
     1659         .
     1660       end.
     1661       else do:
     1662         return .
     1663       end.
     1664       assign
     1665         v-frame-width = frame Dialog-Frame :width
     1666         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1667         v-browse-width = v-diasize-browse-handle :width
     1668       .
     1669       for each buf_temp-browse-handle
     1670         where buf_temp-browse-handle.browse-type = 'width':u
     1671       :
     1672         assign
     1673           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1674         .
     1675       end.
     1676       for each buf_temp-diasize-handle
     1677       :
     1678         delete buf_temp-diasize-handle .
     1679       end.
     1680       assign
     1681         v-field-group-handle = frame Dialog-Frame :first-child
     1682       .
     1683       do while valid-handle(v-field-group-handle)
     1684       :
     1685         assign
     1686           v-object-handle = v-field-group-handle :first-child
     1687         .
     1688         do while valid-handle(v-object-handle)
     1689         :
     1690           if  v-object-handle <> v-diasize-browse-handle :handle
     1691           and v-object-handle <> v-diasize-resize-button
     1692           and can-query(v-object-handle, "row")
     1693           and can-query(v-object-handle, "height")
     1694           and ( v-object-handle :col + v-object-handle :width
     1695                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1696               )
     1697           then do:
     1698             find first buf_temp-browse-handle
     1699               where buf_temp-browse-handle.browse-type   = 'width':u
     1700                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1701               no-error .
     1702             if available buf_temp-browse-handle
     1703             then do:
     1704             end.
     1705             else do:
     1706               create buf_temp-diasize-handle .
     1707               assign
     1708                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1709                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1710               .
     1711             end.
     1712           end.
     1713           assign
     1714             v-object-handle = v-object-handle :next-sibling
     1715           .
     1716         end.
     1717         assign
     1718           v-field-group-handle = v-field-group-handle :next-sibling
     1719         .
     1720       end.
     1721       do with frame Dialog-Frame
     1722       :
     1723         hide v-diasize-resize-button .
     1724         v-diasize-resize-button :row = 1.
     1725         v-diasize-resize-button :column = 1.
     1726       end.
     1727       if p-change-value > 0
     1728       then do:
     1729         if frame Dialog-Frame :scrollable = true
     1730         then do:
     1731           assign
     1732             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1733             no-error .
     1734           if error-status :error
     1735           or error-status :get-message(1) <> ""
     1736           then do:
     1737             undo move_block, retry move_block.
     1738           end.
     1739         end.
     1740         assign
     1741           frame Dialog-Frame :width = v-frame-width + p-change-value
     1742           no-error .
     1743         if error-status :error
     1744         or error-status :get-message(1) <> ""
     1745         then do:
     1746           undo move_block, retry move_block.
     1747         end.
     1748         assign
     1749           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1750         no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block.
     1755         end.
     1756         for each buf_temp-browse-handle
     1757           where buf_temp-browse-handle.browse-type = 'width':u
     1758         on error undo move_block, retry move_block
     1759         :
     1760           assign
     1761             buf_temp-browse-handle.browse-handle :width
     1762               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1763             no-error .
     1764           if error-status :error
     1765           or error-status :get-message(1) <> ""
     1766           then do:
     1767             undo move_block, retry move_block .
     1768           end.
     1769         end.
     1770         for each buf_temp-diasize-handle
     1771         on error undo move_block, retry move_block
     1772         :
     1773           assign
     1774             v-object-handle = buf_temp-diasize-handle.handle-value
     1775           .
     1776           if v-object-handle <> v-diasize-resize-button
     1777           then do:
     1778             assign
     1779               v-object-handle :col = v-object-handle :col + p-change-value
     1780               no-error .
     1781             if error-status :error
     1782             or error-status :get-message(1) <> ""
     1783             then do:
     1784               undo move_block, retry move_block .
     1785             end.
     1786           end.
     1787         end.
     1788       end.
     1789       else do:
     1790         for each buf_temp-diasize-handle
     1791         on error undo move_block, retry move_block
     1792         :
     1793           assign
     1794             v-object-handle = buf_temp-diasize-handle.handle-value
     1795           .
     1796           if v-object-handle <> v-diasize-resize-button
     1797           then do:
     1798             assign
     1799               v-object-handle :col = v-object-handle :col + p-change-value
     1800               no-error .
     1801             if error-status :error
     1802             or error-status :get-message(1) <> ""
     1803             then do:
     1804               undo move_block, retry move_block .
     1805             end.
     1806           end.
     1807         end.
     1808         for each buf_temp-browse-handle
     1809           where buf_temp-browse-handle.browse-type = 'width':u
     1810         on error undo move_block, retry move_block
     1811         :
     1812           assign
     1813             buf_temp-browse-handle.browse-handle :width
     1814               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1815             no-error .
     1816           if error-status :error
     1817           or error-status :get-message(1) <> ""
     1818           then do:
     1819             undo move_block, retry move_block .
     1820           end.
     1821         end.
     1822         assign
     1823           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1824           no-error .
     1825         if error-status :error
     1826         or error-status :get-message(1) <> ""
     1827         then do:
     1828           undo move_block, retry move_block.
     1829         end.
     1830         assign
     1831           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1832         no-error .
     1833         if error-status :error
     1834         or error-status :get-message(1) <> ""
     1835         then do:
     1836           undo move_block, retry move_block.
     1837         end.
     1838         if frame Dialog-Frame :scrollable = true
     1839         then do:
     1840           assign
     1841             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1842           no-error .
     1843           if error-status :error
     1844           or error-status :get-message(1) <> ""
     1845           then do:
     1846             undo move_block, retry move_block.
     1847           end.
     1848         end.
     1849       end.
     1850       if p-move-resize
     1851       then do:
     1852         run diasize_position-resize-button in this-procedure .
     1853       end.
     1854       if v-diasize-wndstore = true
     1855       then do:
     1856         if connected("ub") = true
     1857         then do:
     1858           define variable v-cntxt-db-num        as integer   no-undo .
     1859           define variable v-cntxt-userid        as character no-undo .
     1860           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1861                                             , OUTPUT v-cntxt-userid
     1862                                             ) .
     1863           run gbl/wndsizew.p
     1864             (input  v-cntxt-db-num
     1865             ,input  v-cntxt-userid
     1866             ,input  v-diasize-proc-name
     1867             ,input  'width':u
     1868             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1869             ) .
     1870         end.
     1871       end.
     1872     end.
     1873     assign
     1874       v-diasize-change-size = false
     1875     .
     1876   end procedure.
     1877   procedure diasize_set-width :
     1878     define input  parameter p-new-width  as decimal   no-undo .
     1879     define input  parameter p-move-resize as logical   no-undo .
     1880     do
     1881     on error undo, return error return-value
     1882     :
     1883       run diasize_change-width in this-procedure
     1884         (input  (p-new-width - frame Dialog-Frame :width)
     1885         ,input  p-move-resize
     1886         ) .
     1887     end.
     1888   end procedure.
     1889   procedure diasize_position-resize-button :
     1890     do with frame Dialog-Frame
     1891     :
     1892       hide v-diasize-resize-button .
     1893       assign
     1894         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1895                     - 1
     1896                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1897         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1898                     - 1
     1899                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1900       .
     1901       view v-diasize-resize-button .
     1902     end.
     1903   end procedure.
     1904   on alt-right anywhere
     1905   do:
     1906     run diasize_change-width in this-procedure
     1907       (input 1
     1908       ,input true
     1909       ) .
     1910     return no-apply .
     1911   end.
     1912   on alt-left anywhere
     1913   do:
     1914     run diasize_change-width in this-procedure
     1915       (input -1
     1916       ,input true
     1917       ) .
     1918     return no-apply .
     1919   end.
     1920   on alt-down anywhere
     1921   do:
     1922     run diasize_change-height in this-procedure
     1923       (input 1
     1924       ,input true
     1925       ) .
     1926     return no-apply .
     1927   end.
     1928   on alt-up anywhere
     1929   do:
     1930     run diasize_change-height in this-procedure
     1931       (input -1
     1932       ,input true
     1933       ) .
     1934     return no-apply .
     1935   end.
     1936   on alt-enter of frame Dialog-Frame
     1937   do:
     1938     run diasize_maximize in this-procedure
     1939       (input  ?
     1940       ).
     1941     return no-apply .
     1942   end.
     1943   procedure diasize_end-move :
     1944     do
     1945     on error undo, return error return-value
     1946     :
     1947       define variable v-row-delta as decimal   no-undo .
     1948       define variable v-col-delta as decimal   no-undo .
     1949       define variable v-new-row as decimal   no-undo .
     1950       define variable v-new-col as decimal   no-undo .
     1951       assign
     1952         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1953         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1954       .
     1955       assign
     1956         v-row-delta = v-new-row - frame Dialog-Frame :height
     1957         v-col-delta = v-new-col - frame Dialog-Frame :width
     1958       .
     1959       run diasize_change-height in this-procedure
     1960         (input v-row-delta
     1961         ,input true
     1962         ) .
     1963       run diasize_change-width in this-procedure
     1964         (input v-col-delta
     1965         ,input true
     1966         ) .
     1967     end.
     1968   end procedure.
     1969   procedure diasize_maximize :
     1970     define input  parameter p-action as logical   no-undo .
     1971     do
     1972     on error undo, return error return-value
     1973     :
     1974       if p-action = ?
     1975       then do:
     1976         if v-diasize-need-maximize = true
     1977         then do:
     1978           assign
     1979             p-action = true
     1980           .
     1981         end.
     1982         else do:
     1983           assign
     1984             p-action = false
     1985           .
     1986         end.
     1987       end.
     1988       if p-action = true
     1989       then do:
     1990         run diasize_change-height in this-procedure
     1991           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1992               - frame Dialog-Frame :height-chars
     1993           ,input true
     1994           ) .
     1995         run diasize_change-width in this-procedure
     1996           (input session :width-chars
     1997               - frame Dialog-Frame :width-chars
     1998           ,input true
     1999           ) .
     2000         assign
     2001           v-diasize-need-maximize = false
     2002         .
     2003       end.
     2004       else do:
     2005         run diasize_change-width in this-procedure
     2006           (input v-diasize-orig-frame-width
     2007               - frame Dialog-Frame :width-chars
     2008           ,input true
     2009           ) .
     2010         run diasize_change-height in this-procedure
     2011           (input v-diasize-orig-frame-height
     2012               - frame Dialog-Frame :height-chars
     2013           ,input true
     2014           ) .
     2015         assign
     2016           v-diasize-need-maximize = true
     2017         .
     2018       end.
     2019     end.
     2020   end procedure.
     2021   procedure diasize_restore-orig-size :
     2022     do
     2023     on error undo, return error return-value
     2024     :
     2025       assign
     2026         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2027         v-diasize-current-frame-height = frame Dialog-Frame :height
     2028       .
     2029       run diasize_set-height in this-procedure
     2030         (input  v-diasize-orig-frame-height
     2031         ,input  true
     2032         ) .
     2033       run diasize_set-width in this-procedure
     2034         (input  v-diasize-orig-frame-width
     2035         ,input  true
     2036         ) .
     2037     end.
     2038   end procedure.
     2039   procedure diasize_restore-current-size :
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       run diasize_set-height in this-procedure
     2044         (input  v-diasize-current-frame-height
     2045         ,input  true
     2046         ) .
     2047       run diasize_set-width in this-procedure
     2048         (input  v-diasize-current-frame-width
     2049         ,input  true
     2050         ) .
     2051     end.
     2052   end procedure.
     2053   procedure diasize_set-browse-handle :
     2054     define input  parameter p-browse-handle as handle   no-undo .
     2055     define buffer buf_temp-browse-handle for temp-browse-handle .
     2056     do
     2057     on error undo, return error return-value
     2058     :
     2059       assign
     2060         v-diasize-browse-handle = p-browse-handle
     2061       .
     2062       for each buf_temp-browse-handle
     2063       on error undo, return error return-value
     2064       :
     2065         delete buf_temp-browse-handle .
     2066       end.
     2067     end.
     2068   end procedure.
     2069   procedure diasize_add_browse :
     2070     define input  parameter p-browse-type   as character no-undo .
     2071     define input  parameter p-browse-handle as handle    no-undo .
     2072     define buffer buf_temp-browse-handle for temp-browse-handle .
     2073     do
     2074     on error undo, return error return-value
     2075     :
     2076       assign
     2077         v-diasize-browse-number = v-diasize-browse-number + 1
     2078       .
     2079       create buf_temp-browse-handle .
     2080       assign
     2081         buf_temp-browse-handle.browse-type   = p-browse-type
     2082         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2083         buf_temp-browse-handle.browse-handle = p-browse-handle
     2084       .
     2085     end.
     2086   end procedure.
     2087   procedure diasize_init :
     2088     define variable v-default-value    as logical   no-undo .
     2089     define variable v-restore-saved    as logical   no-undo .
     2090     define variable v-resize-value-str as character no-undo .
     2091     do
     2092     on error undo, return error return-value
     2093     :
     2094       do with frame Dialog-Frame
     2095       :
     2096         assign
     2097           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2098           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2099           v-diasize-browse-handle     = browse b-goods :handle
     2100         .
     2101         create button v-diasize-resize-button
     2102         assign
     2103           parent        = frame Dialog-Frame :first-child
     2104           label         = "s"
     2105           height-pixels = 16
     2106           width-pixels  = 16
     2107           visible       = true
     2108           sensitive     = true
     2109           movable       = true
     2110           triggers:
     2111             on end-move persistent run diasize_end-move in this-procedure .
     2112           end triggers.
     2113         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2114         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2115         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2116         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2117         assign
     2118           v-diasize-wndmax = false
     2119         .
     2120         if connected("ub") = true
     2121         then do:
     2122           define variable v-cntxt-db-num        as integer   no-undo .
     2123           define variable v-cntxt-userid        as character no-undo .
     2124           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2125                                             , OUTPUT v-cntxt-userid
     2126                                             ) .
     2127           run gbl/wndpar_r.p
     2128             (input  v-cntxt-db-num
     2129             ,input  v-cntxt-userid
     2130             ,input  'wndmax':U
     2131             ,output v-diasize-wndmax
     2132             ,output v-default-value
     2133             ) .
     2134         end.
     2135         assign
     2136           v-diasize-wndstore = false
     2137         .
     2138         if connected("ub") = true
     2139         then do:
     2140           run gbl/wndpar_r.p
     2141             (input  v-cntxt-db-num
     2142             ,input  v-cntxt-userid
     2143             ,input  'wndstore':U
     2144             ,output v-diasize-wndstore
     2145             ,output v-default-value
     2146             ) .
     2147         end.
     2148         assign
     2149           v-diasize-proc-name = entry(1, program-name(2), '.')
     2150         .
     2151         if v-diasize-wndstore = true
     2152         then do:
     2153           assign
     2154             v-restore-saved = false
     2155           .
     2156           if connected("ub") = true
     2157           then do:
     2158             run gbl/wndsizer.p
     2159               (input  v-cntxt-db-num
     2160               ,input  v-cntxt-userid
     2161               ,input  v-diasize-proc-name
     2162               ,input  'height':u
     2163               ,output v-resize-value-str
     2164               ) .
     2165             if v-resize-value-str <> '':U
     2166             then do:
     2167               run diasize_change-height in this-procedure
     2168                 (input  integer(v-resize-value-str)
     2169                 ,input  true
     2170                 ) .
     2171               assign
     2172                 v-restore-saved = true
     2173               .
     2174             end.
     2175           end.
     2176           if connected("ub") = true
     2177           then do:
     2178             run gbl/wndsizer.p
     2179               (input  v-cntxt-db-num
     2180               ,input  v-cntxt-userid
     2181               ,input  v-diasize-proc-name
     2182               ,input  'width':u
     2183               ,output v-resize-value-str
     2184               ) .
     2185             if v-resize-value-str <> '':U
     2186             then do:
     2187               run diasize_change-width in this-procedure
     2188                 (input  integer(v-resize-value-str)
     2189                 ,input  true
     2190                 ) .
     2191               assign
     2192                 v-restore-saved = true
     2193               .
     2194             end.
     2195           end.
     2196           if v-restore-saved <> true
     2197           then do:
     2198             if v-diasize-wndmax = true
     2199             then do:
     2200               run diasize_maximize in this-procedure
     2201                 (input  true
     2202                 ) .
     2203             end.
     2204           end.
     2205         end.
     2206         else do:
     2207           if v-diasize-wndmax = true
     2208           then do:
     2209             run diasize_maximize in this-procedure
     2210               (input  true
     2211               ) .
     2212           end.
     2213         end.
     2214       end.
     2215     end.
     2216   end procedure.
     2217   procedure diasize_need-full-display :
     2218     define output parameter p-need-full-display as logical   no-undo .
     2219     do
     2220     on error undo, return error return-value
     2221     :
     2222       assign
     2223         p-need-full-display = v-diasize-need-full-display
     2224       .
     2225       assign
     2226         v-diasize-need-full-display = false
     2227       .
     2228     end.
     2229   end procedure.
     2230   procedure get-context :
     2231      define output parameter p-db-num as integer          no-undo.
     2232      define output parameter p-user-id as character        no-undo.
     2233      define variable v-login               as character    no-undo.
     2234      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2235      define buffer buf_user-login  for ub.user-login .
     2236      do
     2237      on error undo, return error
     2238      :
     2239            FIND FIRST buf_sys-ctrl no-lock.
     2240            ASSIGN
     2241               v-login = USERID("ub")
     2242               p-db-num = buf_sys-ctrl.db-num
     2243            .
     2244            FIND FIRST buf_user-login
     2245                 WHERE buf_user-login.db-num = p-db-num
     2246                   AND buf_user-login.user-login = v-login
     2247                 no-lock
     2248                 no-error
     2249                 .
     2250            IF AVAILABLE buf_user-login
     2251            THEN DO:
     2252               assign
     2253                  p-user-id = buf_user-login.user-id
     2254               .
     2255            END.
     2256      end.
     2257   end procedure.
     2258   MAIN-BLOCK:
     2259   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2260      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2261      run gbl/conf-rd.p ("is-slscr", ?, "", 0, "", "", "", no,  output is-slscrvalue, output is-slscrtype) no-error.
     2262      if is-slscrvalue <> "yes" then do:
     2263        message "У Вас нет лицензии на работу с АРМом <Экран продавца>"
     2264        view-as alert-box.
     2265        return error.
     2266      end.
     2267      run gbl/conf-rd.p ("numslscr", ?, "", 0, "", "", "", no,  output numslscrvalue, output numslscrtype) no-error.
     2268      if numslscrvalue = "" then do:
     2269        assign
     2270          numslscrvalue_int = 0.
     2271      end.
     2272      else do:
     2273        assign
     2274          numslscrvalue_int = integer (numslscrvalue).
     2275      end.
     2276      run gbl/lock-usr.p
     2277       (input "test"
     2278       ,input "sal"
     2279       ,input true
     2280       ,input "Достигнуто максимальное количество пользователей &1"
     2281       ,input numslscrvalue_int
     2282       ,buffer buf_batchprocess
     2283       ) no-error.
     2284     if error-status:error then do:
     2285       return error.
     2286     end.
     2287     find first ubflt.usr-flt where ubflt.usr-flt.user-name  = paruser-name and
     2288                              ubflt.usr-flt.call-point begins "stockscr"   no-lock no-error.
     2289      if not available ubflt.usr-flt then do:
     2290       message "У Вас нет ни одного настроенного объекта для получения остатков."
     2291       view-as alert-box.
     2292       run str/stkscrad.w (input paruser-name, output varchg) no-error.
     2293     end.
     2294     run loadusr-tt (input paruser-name) no-error.
     2295     if error-status :error then do:
     2296       message "Ошибка при чтении настроек пользователя." view-as alert-box error.
     2297       return error.
     2298     end.
     2299     run load-tt no-error.
     2300     if error-status:error then do:
     2301       message "Ошибка при чтении остатков из БД." view-as alert-box error.
     2302       return error.
     2303     end.
     2304     RUN enable_UI.
     2305     assign tt-goods.grp-name:read-only in browse b-goods = yes.
     2306     WAIT-FOR GO OF FRAME Dialog-Frame.
     2307   END.
     2308   RUN disable_UI.
     2309   PROCEDURE calc-stock :
     2310   define input parameter parobj-type      like tt-usrstko.obj-type      no-undo.
     2311   define input parameter parobj-code      like tt-usrstko.obj-code      no-undo.
     2312   define input parameter pardb-num        like tt-usrstko.db-num        no-undo.
     2313   define input parameter parmain-obj-type like tt-usrstko.main-obj-type no-undo.
     2314   define input parameter parmain-obj-code like tt-usrstko.main-obj-code no-undo.
     2315   define input parameter parhost-code     like tt-usrstko.host-code     no-undo.
     2316   define input parameter parhost-name     like tt-usrstko.host-name     no-undo.
     2317   define input parameter parlevel         like tt-usrstko.level         no-undo.
     2318   define input parameter parartic         like tt-goods.artic           no-undo.
     2319   define input parameter parprod-type     like tt-goods.prod-type       no-undo.
     2320   define input parameter parprod-code     like tt-goods.prod-code       no-undo.
     2321   define input parameter parprt-code      like tt-goods.prt-code        no-undo.
     2322   define input parameter parprice-sale    like ub.prt-obj.price-sale    no-undo.
     2323   define input parameter parfact-qnty     like ub.prt-obj.fact-qnty     no-undo.
     2324   define input parameter parfree-qnty     like ub.prt-obj.free-qnty     no-undo.
     2325   define buffer bf_db-status    for ub.db-status.
     2326   define buffer bf_tt-usrstko   for tt-usrstko.
     2327   define buffer bf_sys-ctrl     for ub.sys-ctrl.
     2328     find first bf_db-status where bf_db-status.db-num = pardb-num no-lock no-error.
     2329     find first bf_sys-ctrl no-lock.
     2330     if parmain-obj-code <> ? then do:
     2331       find first tt-stock where tt-stock.obj-type  = parmain-obj-type and
     2332                                 tt-stock.obj-code  = parmain-obj-code and
     2333                                 tt-stock.artic     = parartic         and
     2334                                 tt-stock.prod-type = parprod-type     and
     2335                                 tt-stock.prod-code = parprod-code     and
     2336                                 tt-stock.prt-code  = parprt-code      no-error.
     2337       if not available tt-stock then do:
     2338         find first bf_tt-usrstko where bf_tt-usrstko.user-name = paruser-name     and
     2339                                        bf_tt-usrstko.main-obj-type  = parmain-obj-type and
     2340                                        bf_tt-usrstko.main-obj-code  = parmain-obj-code no-error.
     2341         create tt-stock.
     2342         assign
     2343           tt-stock.obj-type   = parmain-obj-type
     2344           tt-stock.obj-code   = parmain-obj-code
     2345           tt-stock.host-code  = bf_tt-usrstko.host-code
     2346           tt-stock.host-name  = bf_tt-usrstko.host-name
     2347           tt-stock.artic      = parartic
     2348           tt-stock.prod-type  = parprod-type
     2349           tt-stock.prod-code  = parprod-code
     2350           tt-stock.prt-code   = parprt-code.
     2351         assign
     2352           tt-stock.data-date  = (if available bf_db-status then (if bf_sys-ctrl.db-num = bf_db-status.db-num then today else bf_db-status.stock-date) else ?)
     2353           tt-stock.data-time  = (if available bf_db-status then (if bf_sys-ctrl.db-num = bf_db-status.db-num then time  else bf_db-status.stock-time) else ?)
     2354           tt-stock.price-sale = ?
     2355           tt-stock.level      = bf_tt-usrstko.level.
     2356         assign
     2357           tt-stock.fact-qnty  = parfact-qnty
     2358           tt-stock.free-qnty  = parfree-qnty.
     2359       end.
     2360       else do:
     2361         assign
     2362           tt-stock.price-sale = parprice-sale
     2363           tt-stock.fact-qnty  = tt-stock.fact-qnty + parfact-qnty
     2364           tt-stock.free-qnty  = tt-stock.free-qnty + parfree-qnty.
     2365         if not available bf_db-status or
     2366            tt-stock.data-date = ? then do:
     2367           assign
     2368             tt-stock.data-date = ?
     2369             tt-stock.data-time = ?.
     2370         end.
     2371         else do:
     2372            if bf_sys-ctrl.db-num <> bf_db-status.db-num then do:
     2373              if integer(bf_db-status.stock-date) * 86400 + bf_db-status.stock-time <
     2374                 integer(tt-stock.data-date) * 86400 + tt-stock.data-time then do:
     2375                 assign
     2376                   tt-stock.data-date = bf_db-status.stock-date
     2377                   tt-stock.data-time = bf_db-status.stock-time.
     2378               end.
     2379            end.
     2380         end.
     2381       end.
     2382     end.
     2383     else do:
     2384       find first tt-stock where tt-stock.obj-type   = parobj-type  and
     2385                                 tt-stock.obj-code   = parobj-code  and
     2386                                 tt-stock.artic      = parartic     and
     2387                                 tt-stock.prod-type  = parprod-type and
     2388                                 tt-stock.prod-code  = parprod-code and
     2389                                 tt-stock.prt-code   = parprt-code  no-error.
     2390       if not available tt-stock then do:
     2391         create tt-stock.
     2392         assign
     2393           tt-stock.obj-type   = parobj-type
     2394           tt-stock.obj-code   = parobj-code
     2395           tt-stock.host-code  = parhost-code
     2396           tt-stock.host-name  = parhost-name
     2397           tt-stock.artic      = parartic
     2398           tt-stock.prod-type  = parprod-type
     2399           tt-stock.prod-code  = parprod-code
     2400           tt-stock.prt-code   = parprt-code
     2401           tt-stock.level      = parlevel.
     2402         assign
     2403           tt-stock.data-date  = (if available bf_db-status then (if bf_sys-ctrl.db-num = bf_db-status.db-num then today else bf_db-status.stock-date) else ?)
     2404           tt-stock.data-time  = (if available bf_db-status then (if bf_sys-ctrl.db-num = bf_db-status.db-num then time  else bf_db-status.stock-time) else ?)
     2405           tt-stock.price-sale = parprice-sale.
     2406       end.
     2407       else do:
     2408         if bf_sys-ctrl.db-num <> bf_db-status.db-num then do:
     2409           if integer(bf_db-status.stock-date) * 86400 + bf_db-status.stock-time <
     2410              integer(tt-stock.data-date) * 86400 + tt-stock.data-time then do:
     2411              assign
     2412                tt-stock.data-date = bf_db-status.stock-date
     2413                tt-stock.data-time = bf_db-status.stock-time.
     2414            end.
     2415         end.
     2416       end.
     2417       assign
     2418         tt-stock.fact-qnty  = tt-stock.fact-qnty + parfact-qnty
     2419         tt-stock.free-qnty  = tt-stock.free-qnty + parfree-qnty.
     2420     end.
     2421   end procedure.
     2422   PROCEDURE change-brw :
     2423   define variable varartic     like ub.goods.artic no-undo.
     2424   define variable varprod-type like ub.goods.prod-type no-undo.
     2425   define variable varprod-code like ub.goods.prod-code no-undo.
     2426   define variable varprt-code  like ub.prt-obj.prt-code no-undo.
     2427   define variable varobj-type  like ub.clients.obj-type no-undo.
     2428   define variable varobj-code  like ub.clients.obj-code no-undo.
     2429   define variable varrec-id as recid no-undo.
     2430   if available tt-goods then do:
     2431     assign
     2432       varartic = tt-goods.artic
     2433       varprod-type = tt-goods.prod-type
     2434       varprod-code = tt-goods.prod-code
     2435       varprt-code = tt-goods.prt-code.
     2436     if available tt-stock then do:
     2437       assign
     2438         varobj-type = tt-stock.obj-type
     2439         varobj-code = tt-stock.obj-code.
     2440     end.
     2441   end.
     2442   run clear-tt in this-procedure no-error.
     2443   if error-status:error then do:
     2444     message "Ошибка при очистке временных таблиц." view-as alert-box error.
     2445     return no-apply.
     2446   end.
     2447   run load-tt in this-procedure no-error.
     2448   if error-status:error then do:
     2449     message "Ошибка при создании временных таблиц." view-as alert-box error.
     2450     return no-apply.
     2451   end.
     2452   OPEN QUERY b-goods FOR EACH tt-goods use-index ford-num,        FIRST tt-cont-goods OUTER-JOIN WHERE TRUE.
     2453   OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
     2454   find first tt-goods where tt-goods.artic     = varartic     and
     2455                             tt-goods.prod-type = varprod-type and
     2456                             tt-goods.prod-code = varprod-code and
     2457                             tt-goods.prt-code  = varprt-code  no-error.
     2458   if available tt-goods then do:
     2459     assign
     2460       varrec-id = recid(tt-goods).
     2461     reposition b-goods to recid varrec-id no-error.
     2462     apply "value-changed" to browse b-goods.
     2463     find first tt-stock where tt-stock.obj-type  = varobj-type  and
     2464                               tt-stock.obj-code  = varobj-code  and
     2465                               tt-stock.artic     = varartic     and
     2466                               tt-stock.prod-type = varprod-type and
     2467                               tt-stock.prod-code = varprod-code and
     2468                               tt-stock.prt-code  = varprt-code  no-error.
     2469     if available tt-stock then do:
     2470       assign
     2471         varrec-id = recid(tt-stock).
     2472       reposition b-stock to recid varrec-id no-error.
     2473     end.
     2474   end.
     2475   END PROCEDURE.
     2476   PROCEDURE clear-tt :
     2477   for each tt-goods:
     2478     delete tt-goods.
     2479   end.
     2480   for each tt-stock:
     2481     delete tt-stock.
     2482   end.
     2483   END PROCEDURE.
     2484   PROCEDURE create-tt-goods :
     2485   define input parameter parartic like  ub.prt-obj.artic  no-undo.
     2486   define input parameter parprod-type like ub.prt-obj.prod-type no-undo.
     2487   define input parameter parprod-code like ub.prt-obj.prod-code no-undo.
     2488   define input parameter parprt-code  like ub.prt-obj.prt-code no-undo.
     2489   define output parameter parrec-id as recid no-undo.
     2490   define buffer bf_client       for ub.clients.
     2491   define buffer bf_gds-grp      for ub.gds-grp.
     2492   define buffer bf_gds-prt      for ub.gds-prt.
     2493   define buffer bf_goods        for ub.goods.
     2494   define buffer bf_prod-clients for ub.clients.
     2495   define variable varupper-code like ub.gds-prt.node-code no-undo.
     2496   define variable vargrp-name as   character           no-undo.
     2497   find first tt-goods where tt-goods.artic     = parartic     and
     2498                             tt-goods.prod-type = parprod-type and
     2499                             tt-goods.prod-code = parprod-code and
     2500                             tt-goods.prt-code  = parprt-code  no-error.
     2501   if not available tt-goods then do:
     2502     create tt-goods.
     2503     assign
     2504     tt-goods.artic     = parartic
     2505     tt-goods.prod-type = parprod-type
     2506     tt-goods.prod-code = parprod-code
     2507     tt-goods.prt-code  = parprt-code .
     2508     find first bf_goods where bf_goods.artic     = tt-goods.artic     and
     2509                               bf_goods.prod-type = tt-goods.prod-type and
     2510                               bf_goods.prod-code = tt-goods.prod-code no-lock.
     2511     find first bf_gds-prt where bf_gds-prt.node-code = parprt-code no-lock.
     2512     assign
     2513        tt-goods.gds-name  = bf_goods.gds-name
     2514        tt-goods.prt-name  = bf_gds-prt.f-name
     2515        tt-goods.unit-base = bf_goods.unit-base
     2516        tt-goods.unit-base = bf_goods.unit-base.
     2517     find first bf_prod-clients where bf_prod-clients.obj-type = bf_goods.prod-type and
     2518                                      bf_prod-clients.obj-code = bf_goods.prod-code no-lock.
     2519     assign
     2520       tt-goods.prod-name = bf_prod-clients.obj-name.
     2521     if bf_gds-prt.node-name <> '_Пустая шкала':U then do:
     2522       assign
     2523         tt-goods.prt-name = bf_gds-prt.f-name.
     2524       if length(tt-goods.prt-name) > 20 then do:
     2525         assign tt-goods.prt-name = "..." + substring(tt-goods.prt-name, 4 + (length(tt-goods.prt-name) - 20)).
     2526       end.
     2527     end.
     2528     assign
     2529       tt-goods.prt-root = bf_gds-prt.prt-root.
     2530     repeat :
     2531       case bf_gds-prt.lvl-num:
     2532         when 0 then do:
     2533           assign tt-goods.ford-num-0 = bf_gds-prt.prt-num.
     2534         end.
     2535         when 1 then do:
     2536           assign tt-goods.ford-num-1 = bf_gds-prt.prt-num.
     2537         end.
     2538         when 2 then do:
     2539           assign tt-goods.ford-num-2 = bf_gds-prt.prt-num.
     2540         end.
     2541       end.
     2542       if bf_gds-prt.lvl-num = 0 then do:
     2543         leave.
     2544       end.
     2545       else do:
     2546         assign varupper-code = bf_gds-prt.upper-code.
     2547         find first bf_gds-prt where bf_gds-prt.node-code  = varupper-code.
     2548       end.
     2549     end.
     2550     find first bf_gds-grp where bf_gds-grp.node-code = bf_goods.grp-code no-lock.
     2551     run full-grp in this-procedure (input bf_gds-grp.node-code, input-output vargrp-name) no-error.
     2552     if error-status :error then do:
     2553       assign
     2554         tt-goods.grp-name = "Ошибка!!!.".
     2555     end.
     2556     assign
     2557       tt-goods.grp-name = vargrp-name.
     2558   end.
     2559   assign
     2560     parrec-id = recid(tt-goods).
     2561   END PROCEDURE.
     2562   PROCEDURE disable_UI :
     2563     HIDE FRAME Dialog-Frame.
     2564   END PROCEDURE.
     2565   PROCEDURE enable_UI :
     2566     DISPLAY varartic vargds-name varb-c vargds-cnt
     2567         WITH FRAME Dialog-Frame.
     2568     ENABLE b-goods b-exit b-requery b-requery-prt b-admin b-help vargds-name
     2569            varb-c b-stock vargds-cnt
     2570         WITH FRAME Dialog-Frame.
     2571     VIEW FRAME Dialog-Frame.
     2572     OPEN QUERY b-goods FOR EACH tt-goods use-index ford-num,        FIRST tt-cont-goods OUTER-JOIN WHERE TRUE.    OPEN QUERY b-stock FOR EACH tt-stock where tt-stock.artic     = tt-goods.artic         and                                                 tt-stock.prod-type = tt-goods.prod-type and                                                 tt-stock.prod-code = tt-goods.prod-code and                                                 tt-stock.prt-code  = tt-goods.prt-code  use-index level indexed-reposition.
     2573   END PROCEDURE.
     2574   PROCEDURE load-tt :
     2575   define variable varobj-type like ub.clients.obj-type no-undo.
     2576   define variable varobj-code like ub.clients.obj-code no-undo.
     2577   define variable parrec-id as recid no-undo.
     2578   define buffer bf_prt-obj      for ub.prt-obj.
     2579   run waitfram-show in this-procedure
     2580     (input "Подготовка остатков товаров для просмотра"
     2581     ).
     2582   for each tt-usrstko no-lock,
     2583      each bf_prt-obj where bf_prt-obj.obj-type = tt-usrstko.obj-type and
     2584                            bf_prt-obj.obj-code = tt-usrstko.obj-code no-lock :
     2585      if bf_prt-obj.fact-qnty = 0 and
     2586         bf_prt-obj.free-qnty = 0 then next.
     2587     run create-tt-goods (input bf_prt-obj.artic,
     2588                                     input bf_prt-obj.prod-type,
     2589                                     input bf_prt-obj.prod-code,
     2590                                     input bf_prt-obj.prt-code,
     2591                                     output parrec-id) no-error.
     2592       if error-status:error then do:
     2593         message "Ошибка при создании товарной записи." view-as alert-box.
     2594         return no-apply.
     2595       end.
     2596     find first tt-goods where recid(tt-goods) = parrec-id.
     2597      assign
     2598        tt-goods.fact-qnty = tt-goods.fact-qnty + bf_prt-obj.fact-qnty
     2599        tt-goods.free-qnty = tt-goods.free-qnty + bf_prt-obj.free-qnty.
     2600     run calc-stock in this-procedure
     2601     (input tt-usrstko.obj-type,
     2602      input tt-usrstko.obj-code,
     2603      input tt-usrstko.db-num,
     2604      input tt-usrstko.main-obj-type,
     2605      input tt-usrstko.main-obj-code,
     2606      input tt-usrstko.host-code,
     2607      input tt-usrstko.host-name,
     2608      input tt-usrstko.level,
     2609      input tt-goods.artic,
     2610      input tt-goods.prod-type,
     2611      input tt-goods.prod-code,
     2612      input tt-goods.prt-code,
     2613      input bf_prt-obj.price-sale,
     2614      input bf_prt-obj.fact-qnty,
     2615      input bf_prt-obj.free-qnty) no-error.
     2616     if error-status:error then do:
     2617       message "Ошибка при подсчете остатков." view-as alert-box error.
     2618       return error.
     2619     end.
     2620   end.
     2621   run waitfram-hide in this-procedure .
     2622   END PROCEDURE.
