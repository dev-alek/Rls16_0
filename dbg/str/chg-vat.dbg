        1   define output parameter parold-vat-pc   like ub.doc-line.vat-pc no-undo.
        2   define output parameter parvat-pc       like ub.doc-line.vat-pc no-undo.
        3   define output parameter parpurch-list   as   character          no-undo.
        4   define output parameter parchange-price as   logical            no-undo.
        5   define output parameter paris-ok        as   logical            no-undo.
        6   define temp-table tt-purch no-undo
        7   field purch-code as integer
        8   field mark as logical format "*/" label "*"
        9   field purch-name as character format "x(30)" label "Тип приобретения"
       10   index pi is unique primary purch-code.
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   procedure proc-alt-shift-f2:
       16     if not ibs.th.gbl.gbl-var:rcode
       17   then
       18     run gbl\inidebug.p .
       19   end.
       20   procedure proc-alt-shift-f3:
       21     run gbl/prvssinf.p
       22       ( input this-procedure
       23       ) .
       24   end.
       25   define variable v-inform-launched as logical no-undo initial false .
       26   procedure proc-alt-shift-f4:
       27     define variable v-action as character no-undo .
       28     if v-inform-launched = false then do:
       29       assign
       30         v-inform-launched = true
       31       .
       32       run gbl/d-inform.w
       33         (  input self
       34         ,  input this-procedure
       35         , output v-action
       36         ) no-error .
       37       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       38       assign
       39         v-inform-launched = false
       40       .
       41     end.
       42   end.
       43   procedure proc-alt-f1:
       44     run gbl/corrhelp.p
       45       (input this-procedure
       46       ) .
       47   end .
       48   on alt-shift-f2 anywhere do:
       49     run proc-alt-shift-f2.
       50   end.
       51   on alt-shift-f3 anywhere do:
       52     run proc-alt-shift-f3 in this-procedure .
       53   end.
       54   on alt-shift-f4 anywhere do:
       55     run proc-alt-shift-f4 in this-procedure.
       56   end.
       57   on alt-f1 anywhere do:
       58     run proc-alt-f1 in this-procedure .
       59   end.
       60   define variable varcount as integer no-undo.
       61   DEFINE BUTTON b-cancel
       62        LABEL "&Отмена"
       63        SIZE 10 BY 1
       64        BGCOLOR 8 .
       65   DEFINE BUTTON b-exit AUTO-GO
       66        LABEL "&Выход"
       67        SIZE 10 BY 1
       68        BGCOLOR 8 .
       69   DEFINE BUTTON b-help
       70        LABEL "&Помощь"
       71        SIZE 10 BY 1
       72        BGCOLOR 8 .
       73   DEFINE BUTTON b-mark
       74        LABEL "&*"
       75        SIZE 4.38 BY 1.
       76   DEFINE VARIABLE varold-vat-pc AS DECIMAL FORMAT ">9.99" INITIAL ?
       77        LABEL "&Старый НДС"
       78        VIEW-AS FILL-IN
       79        SIZE 6 BY 1 NO-UNDO.
       80   DEFINE VARIABLE varvat-pc AS DECIMAL FORMAT ">9.99" INITIAL ?
       81        LABEL "&Новый НДС"
       82        VIEW-AS FILL-IN
       83        SIZE 6 BY 1 NO-UNDO.
       84   DEFINE VARIABLE varchange-price AS LOGICAL INITIAL no
       85        LABEL "Пересчитать цену"
       86        VIEW-AS TOGGLE-BOX
       87        SIZE 20.13 BY .83 NO-UNDO.
       88   DEFINE QUERY BROWSE-1 FOR
       89         tt-purch SCROLLING.
       90   DEFINE BROWSE BROWSE-1
       91     QUERY BROWSE-1 DISPLAY
       92         tt-purch.mark tt-purch.purch-name
       93       WITH NO-ROW-MARKERS SEPARATORS SIZE 34.88 BY 6.46.
       94   DEFINE FRAME Dialog-Frame
       95        b-exit AT ROW 1.13 COL 1
       96        b-cancel AT ROW 1.13 COL 11.38
       97        b-mark AT ROW 1.13 COL 21.75
       98        b-help AT ROW 1.13 COL 26.5
       99        varold-vat-pc AT ROW 2.5 COL 11 COLON-ALIGNED
      100        varvat-pc AT ROW 2.5 COL 28.38 COLON-ALIGNED
      101        varchange-price AT ROW 3.88 COL 1.25
      102        BROWSE-1 AT ROW 5.21 COL 1.25
      103        SPACE(0.74) SKIP(0.20)
      104       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      105            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      106            TITLE "Заведение НДС и типов приобретения"
      107            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      108   ASSIGN
      109          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      110          FRAME Dialog-Frame:HIDDEN           = TRUE.
      111   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      112   DO:
      113     APPLY "END-ERROR":U TO SELF.
      114   END.
      115   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      116   DO:
      117   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   if lookup(self :type
      119            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      120            ) = 0
      121   then do:
      122     message
      123       "$Workfile$"
      124       "Указанному интерфейсному элементу фокус не может быть передан" skip
      125       "Интерфейсный элемент" self :name  skip
      126       "Тип" self :type  skip
      127       "Процедура" this-procedure :file-name skip
      128       view-as alert-box .
      129   end.
      130   else do:
      131     apply "entry":u to self  .
      132     if focus :handle <> self :handle  then do:
      133       return no-apply .
      134     end.
      135   end.
      136     assign
      137       paris-ok = no.
      138     apply "go" to frame Dialog-Frame.
      139   END.
      140   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      141   DO:
      142   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   if lookup(self :type
      144            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      145            ) = 0
      146   then do:
      147     message
      148       "$Workfile$"
      149       "Указанному интерфейсному элементу фокус не может быть передан" skip
      150       "Интерфейсный элемент" self :name  skip
      151       "Тип" self :type  skip
      152       "Процедура" this-procedure :file-name skip
      153       view-as alert-box .
      154   end.
      155   else do:
      156     apply "entry":u to self  .
      157     if focus :handle <> self :handle  then do:
      158       return no-apply .
      159     end.
      160   end.
      161     if varold-vat-pc = ? then do:
      162       message "Вы не установили старый процент НДС." view-as alert-box error.
      163       apply "entry" to varold-vat-pc in frame Dialog-Frame.
      164       return no-apply.
      165     end.
      166     if varvat-pc = ? then do:
      167       message "Вы не установили новый процент НДС." view-as alert-box error.
      168       apply "entry" to varvat-pc in frame Dialog-Frame.
      169       return no-apply.
      170     end.
      171     find first tt-purch where tt-purch.mark = yes no-error.
      172     if not available tt-purch then do:
      173       message "Вы не выбрали типы приобретения товара." view-as alert-box error.
      174       return no-apply.
      175     end.
      176     assign
      177       parold-vat-pc = varold-vat-pc
      178       parvat-pc     = varvat-pc
      179       parchange-price     = varchange-price
      180       paris-ok      = yes.
      181     for each tt-purch on error undo, return no-apply :
      182       if tt-purch.mark = yes then do:
      183         assign
      184           parpurch-list = parpurch-list + min (parpurch-list, ",") + string(tt-purch.purch-code).
      185       end.
      186     end.
      187   END.
      188   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      189   DO:
      190   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   if lookup(self :type
      192            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      193            ) = 0
      194   then do:
      195     message
      196       "$Workfile$"
      197       "Указанному интерфейсному элементу фокус не может быть передан" skip
      198       "Интерфейсный элемент" self :name  skip
      199       "Тип" self :type  skip
      200       "Процедура" this-procedure :file-name skip
      201       view-as alert-box .
      202   end.
      203   else do:
      204     apply "entry":u to self  .
      205     if focus :handle <> self :handle  then do:
      206       return no-apply .
      207     end.
      208   end.
      209     if available tt-purch then do:
      210       assign
      211         tt-purch.mark = not tt-purch.mark.
      212        display tt-purch.mark with browse BROWSE-1.
      213        get next BROWSE-1.
      214        if available tt-purch then do:
      215          reposition BROWSE-1 to recid recid(tt-purch).
      216        end.
      217     end.
      218   END.
      219   ON VALUE-CHANGED OF varchange-price IN FRAME Dialog-Frame
      220   DO:
      221     assign
      222          frame Dialog-Frame varchange-price.
      223   END.
      224   ON LEAVE OF varold-vat-pc IN FRAME Dialog-Frame
      225   DO:
      226     assign
      227       frame Dialog-Frame
      228       varold-vat-pc.
      229   END.
      230   ON LEAVE OF varvat-pc IN FRAME Dialog-Frame
      231   DO:
      232     assign
      233       frame Dialog-Frame
      234       varvat-pc.
      235   END.
      236   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      237   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      238   MAIN-BLOCK:
      239   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      240      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      241   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   on help of frame Dialog-Frame
      243   do:
      244     run gbl/app_help.p
      245       (input this-procedure :file-name
      246       ,input ''
      247       ,input ?
      248       ) no-error.
      249     if error-status :error then do:
      250       message
      251         "Ошибка при вызове помощи"
      252         error-status :get-message(1)
      253         view-as alert-box .
      254     end.
      255   end.
      256   run minbtn-set in this-procedure .
      257   on choose of b-help in frame Dialog-Frame
      258   do:
      259     apply "help":u to frame Dialog-Frame .
      260   end.
      261   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   procedure minbtn-set :
      263       do
      264           on error undo, return error return-value
      265           :
      266           define variable ii              as integer       no-undo .
      267           define variable fh              as widget-handle no-undo .
      268           define variable hh              as widget-handle no-undo .
      269           define variable v-h             as handle        extent 4 no-undo .
      270           define variable v-name-button   as character     no-undo .
      271           define variable v-help-old-x    as decimal       no-undo .
      272           define variable v-help-old-y    as decimal       no-undo .
      273           define variable v-help-old-size as decimal       no-undo .
      274           define variable v-frame-width   as decimal       no-undo .
      275           define variable jj              as integer       no-undo .
      276           do
      277               on error undo, return error
      278               :
      279               assign
      280                   v-frame-width = frame Dialog-Frame:width - 0.3
      281                   fh            = frame Dialog-Frame:first-child
      282                   hh            = fh:first-child
      283                   ii            = 1
      284                   .
      285               do while valid-handle(hh):
      286                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      287                   do:
      288                       case lc(hh:name) :
      289                           when "b-help" then
      290                               do:
      291                                   hh:load-image-up("cmp/b-help.bmp":u) .
      292                                   hh:load-image-down("cmp/b-help.bmp":u) .
      293                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      294                                   hh:TOOLTIP = "Помощь" .
      295                                   v-help-old-x = hh:column .
      296                                   v-help-old-y = hh:row    .
      297                                   v-help-old-size = hh:width .
      298                                   hh:width-chars = 2.5 .
      299                               end.
      300                           when "b-print" then
      301                               do:
      302                                   hh:load-image("cmp/b-print.bmp":u) .
      303                                   hh:TOOLTIP = "Печать" .
      304                                   v-h[ii] = hh:handle .
      305                                   ii = ii + 1 .
      306                                   hh:width-chars = 3 .
      307                               end.
      308                           when "b-history" or
      309                           when "b-hist" then
      310                               do:
      311                                   hh:load-image("cmp/b-hist.bmp":u) .
      312                                   hh:TOOLTIP = "История" .
      313                                   v-h[ii] = hh:handle .
      314                                   ii = ii + 1 .
      315                                   hh:width-chars = 3 .
      316                               end.
      317                           when "b-sch" then
      318                               do:
      319                                   hh:load-image("cmp/b-sch.bmp":u) .
      320                                   hh:TOOLTIP = "Установка Фильтра" .
      321                                   v-h[ii] = hh:handle .
      322                                   ii = ii + 1 .
      323                                   hh:width-chars = 3 .
      324                               end.
      325                           when "b-hist-user" then
      326                               do:
      327                                   hh:load-image("cmp/b-hist.bmp":u) .
      328                                   hh:TOOLTIP = "История пользователя" .
      329                                   ii = ii + 1 .
      330                               end.
      331                       end case.
      332                   end.
      333                   hh = hh:next-sibling.
      334               end.
      335               b-help:column = v-frame-width - b-help:width-chars.
      336               jj = 0.
      337               repeat ii = 4 to 1 by -1 :
      338                   if valid-handle (v-h[ii] ) then
      339                   do:
      340                       jj  = jj + 1 .
      341                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      342                       v-h[ii]:row    = v-help-old-y .
      343                   end.
      344               end.
      345           end.
      346       end.
      347   end procedure.
      348   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      349   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      350   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      351   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      352   define variable v-diasize-current-frame-width  as decimal   no-undo .
      353   define variable v-diasize-current-frame-height as decimal   no-undo .
      354   define variable v-diasize-change-size          as logical   no-undo .
      355   define variable v-diasize-resize-button        as handle    no-undo .
      356   define variable v-diasize-wndmax               as logical   no-undo .
      357   define variable v-diasize-wndstore             as logical   no-undo .
      358   define variable v-diasize-proc-name            as character no-undo .
      359   define variable v-diasize-browse-handle        as handle    no-undo .
      360   define variable v-diasize-browse-number        as integer   no-undo .
      361   define variable v-diasize-need-full-display    as logical   no-undo init false .
      362   define temp-table temp-diasize-handle no-undo
      363     field handle-value  as handle
      364     field save-position as decimal
      365     index xpk is primary unique handle-value
      366     .
      367   define temp-table temp-browse-handle no-undo
      368     field browse-type   as character
      369     field browse-number as integer
      370     field browse-handle as handle
      371     field original-size as decimal
      372     index xpk is primary unique browse-type browse-number
      373     index xie browse-type browse-handle
      374   .
      375   procedure diasize_change-height :
      376     define input  parameter p-change-value  as decimal   no-undo .
      377     define input  parameter p-move-resize   as logical   no-undo .
      378     define variable v-field-group-handle    as handle    no-undo .
      379     define variable v-object-handle         as handle    no-undo .
      380     define variable v-frame-height          as decimal   no-undo .
      381     define variable v-frame-virtual-height  as decimal   no-undo .
      382     define variable v-browse-height         as decimal   no-undo .
      383     define variable v-window-height         as decimal   no-undo .
      384     define variable v-window-virtual-height as decimal   no-undo .
      385     define variable v-change-sign           as integer   no-undo .
      386     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      387     define buffer buf_temp-browse-handle  for temp-browse-handle .
      388     if p-change-value > 0
      389     then do:
      390       if frame Dialog-Frame :height + p-change-value
      391           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      392       then do:
      393         assign
      394           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      395                           - (frame Dialog-Frame :height-chars)
      396         .
      397         if p-change-value <= 0
      398         then do:
      399           run diasize_position-resize-button in this-procedure .
      400           return .
      401         end.
      402       end.
      403     end.
      404     if p-change-value < 0
      405     then do:
      406       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      407       then do:
      408         assign
      409           p-change-value = v-diasize-orig-frame-height
      410                          - (frame Dialog-Frame :height-chars)
      411         .
      412         if p-change-value >= 0
      413         then do:
      414           run diasize_position-resize-button in this-procedure .
      415           return .
      416         end.
      417       end.
      418     end.
      419     if p-change-value >= 0
      420     then do:
      421       assign
      422         v-change-sign = 1
      423       .
      424     end.
      425     else do:
      426       assign
      427         v-change-sign = -1
      428       .
      429     end.
      430     assign
      431       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      432     .
      433     if p-change-value = 0
      434     then do:
      435       run diasize_position-resize-button in this-procedure .
      436       return .
      437     end.
      438     move_block:
      439     do
      440     on error undo move_block, retry move_block
      441     :
      442       if retry
      443       then do:
      444         do
      445         on error undo move_block, leave move_block
      446         :
      447           if p-change-value > 0
      448           then do:
      449             for each buf_temp-diasize-handle
      450             on error undo, next
      451             :
      452               assign
      453                 v-object-handle = buf_temp-diasize-handle.handle-value
      454               .
      455               if v-object-handle <> v-diasize-resize-button
      456               then do:
      457                 assign
      458                   v-object-handle :row = buf_temp-diasize-handle.save-position
      459                 .
      460               end.
      461             end.
      462             assign
      463               v-diasize-browse-handle :height = v-browse-height
      464             .
      465             for each buf_temp-browse-handle
      466               where buf_temp-browse-handle.browse-type = 'height':u
      467             on error undo, next
      468             :
      469               assign
      470                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      471               .
      472             end.
      473             assign
      474               frame Dialog-Frame :height = v-frame-height
      475             .
      476             if frame Dialog-Frame :scrollable = true
      477             then do:
      478               assign
      479                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      480               .
      481             end.
      482             run diasize_position-resize-button in this-procedure .
      483           end.
      484           else do:
      485             if frame Dialog-Frame :scrollable = true
      486             then do:
      487               assign
      488                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      489               .
      490             end.
      491             assign
      492               frame Dialog-Frame :height = v-frame-height
      493             .
      494             assign
      495               v-diasize-browse-handle :height = v-browse-height
      496             .
      497             for each buf_temp-browse-handle
      498               where buf_temp-browse-handle.browse-type = 'height':u
      499             on error undo, next
      500             :
      501               assign
      502                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      503               .
      504             end.
      505             for each buf_temp-diasize-handle
      506             on error undo, next
      507             :
      508               assign
      509                 v-object-handle = buf_temp-diasize-handle.handle-value
      510               .
      511               if v-object-handle <> v-diasize-resize-button
      512               then do:
      513                 assign
      514                   v-object-handle :row = buf_temp-diasize-handle.save-position
      515                 .
      516               end.
      517             end.
      518             run diasize_position-resize-button in this-procedure .
      519           end.
      520           assign
      521             v-diasize-change-size = false
      522           .
      523           leave move_block .
      524         end.
      525       end.
      526       assign
      527         v-diasize-need-full-display = true
      528       .
      529       if v-diasize-change-size = false
      530       then do:
      531         assign
      532           v-diasize-change-size = true
      533         .
      534       end.
      535       else do:
      536         return .
      537       end.
      538       assign
      539         v-frame-height = frame Dialog-Frame :height
      540         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      541         v-browse-height = v-diasize-browse-handle :height
      542       .
      543       for each buf_temp-browse-handle
      544         where buf_temp-browse-handle.browse-type = 'height':u
      545       :
      546         assign
      547           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      548         .
      549       end.
      550       for each buf_temp-diasize-handle
      551       :
      552         delete buf_temp-diasize-handle .
      553       end.
      554       assign
      555         v-field-group-handle = frame Dialog-Frame :first-child
      556       .
      557       do while valid-handle(v-field-group-handle)
      558       :
      559         assign
      560           v-object-handle = v-field-group-handle :first-child
      561         .
      562         do while valid-handle(v-object-handle)
      563         :
      564           if  v-object-handle <> v-diasize-browse-handle :handle
      565           and can-query(v-object-handle, "row")
      566           and can-query(v-object-handle, "height")
      567           and ( v-object-handle :row > v-diasize-browse-handle :row )
      568           then do:
      569             find first buf_temp-browse-handle
      570               where buf_temp-browse-handle.browse-type   = 'height':u
      571                 and buf_temp-browse-handle.browse-handle = v-object-handle
      572               no-error .
      573             if available buf_temp-browse-handle
      574             then do:
      575             end.
      576             else do:
      577               create buf_temp-diasize-handle .
      578               assign
      579                 buf_temp-diasize-handle.handle-value  = v-object-handle
      580                 buf_temp-diasize-handle.save-position = v-object-handle :row
      581               .
      582             end.
      583           end.
      584           assign
      585             v-object-handle = v-object-handle :next-sibling
      586           .
      587         end.
      588         assign
      589           v-field-group-handle = v-field-group-handle :next-sibling
      590         .
      591       end.
      592       do with frame Dialog-Frame
      593       :
      594         hide v-diasize-resize-button .
      595         assign
      596           v-diasize-resize-button :row    = 1
      597           v-diasize-resize-button :column = 1
      598         .
      599       end.
      600       if p-change-value > 0
      601       then do:
      602         if frame Dialog-Frame :scrollable = true
      603         then do:
      604           assign
      605             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      606             no-error .
      607           if error-status :error
      608           or error-status :get-message(1) <> ""
      609           then do:
      610             undo move_block, retry move_block .
      611           end.
      612         end.
      613         assign
      614           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      615           no-error .
      616         if error-status :error
      617         or error-status :get-message(1) <> ""
      618         then do:
      619           undo move_block, retry move_block .
      620         end.
      621         assign
      622           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      623           no-error .
      624         if error-status :error
      625         or error-status :get-message(1) <> ""
      626         then do:
      627           undo move_block, retry move_block .
      628         end.
      629         for each buf_temp-browse-handle
      630           where buf_temp-browse-handle.browse-type = 'height':u
      631         on error undo move_block, retry move_block
      632         :
      633           assign
      634             buf_temp-browse-handle.browse-handle :height
      635               = buf_temp-browse-handle.browse-handle :height + p-change-value
      636             no-error .
      637           if error-status :error
      638           or error-status :get-message(1) <> ""
      639           then do:
      640             undo move_block, retry move_block .
      641           end.
      642         end.
      643         for each buf_temp-diasize-handle
      644         on error undo move_block, retry move_block
      645         :
      646           assign
      647             v-object-handle = buf_temp-diasize-handle.handle-value
      648           .
      649           if v-object-handle <> v-diasize-resize-button
      650           then do:
      651             assign
      652               v-object-handle :row = v-object-handle :row + p-change-value
      653               no-error .
      654             if error-status :error
      655             or error-status :get-message(1) <> ""
      656             then do:
      657               undo move_block, retry move_block .
      658             end.
      659           end.
      660         end.
      661       end.
      662       else do:
      663         for each buf_temp-diasize-handle
      664         on error undo move_block, retry move_block
      665         :
      666           assign
      667             v-object-handle = buf_temp-diasize-handle.handle-value
      668           .
      669           if v-object-handle <> v-diasize-resize-button
      670           then do:
      671             assign
      672               v-object-handle :row = v-object-handle :row + p-change-value
      673               no-error .
      674             if error-status :error
      675             or error-status :get-message(1) <> ""
      676             then do:
      677               undo move_block, retry move_block .
      678             end.
      679           end.
      680         end.
      681         assign
      682           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      683           no-error .
      684         if error-status :error
      685         or error-status :get-message(1) <> ""
      686         then do:
      687           undo move_block, retry move_block .
      688         end.
      689         for each buf_temp-browse-handle
      690           where buf_temp-browse-handle.browse-type = 'height':u
      691         on error undo move_block, retry move_block
      692         :
      693           assign
      694             buf_temp-browse-handle.browse-handle :height
      695               = buf_temp-browse-handle.browse-handle :height + p-change-value
      696             no-error .
      697           if error-status :error
      698           or error-status :get-message(1) <> ""
      699           then do:
      700             undo move_block, retry move_block .
      701           end.
      702         end.
      703         assign
      704           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      705           no-error .
      706         if error-status :error
      707         or error-status :get-message(1) <> ""
      708         then do:
      709           undo move_block, retry move_block .
      710         end.
      711         if frame Dialog-Frame :scrollable = true
      712         then do:
      713           assign
      714             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      715             no-error .
      716           if error-status :error
      717           or error-status :get-message(1) <> ""
      718           then do:
      719             undo move_block, retry move_block .
      720           end.
      721         end.
      722       end.
      723       if p-move-resize = true
      724       then do:
      725         run diasize_position-resize-button in this-procedure .
      726       end.
      727       if v-diasize-wndstore = true
      728       then do:
      729         if connected("ub") = true
      730         then do:
      731           define variable v-cntxt-db-num        as integer   no-undo .
      732           define variable v-cntxt-userid        as character no-undo .
      733           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      734                                             , OUTPUT v-cntxt-userid
      735                                             ) .
      736           run gbl/wndsizew.p
      737             (input  v-cntxt-db-num
      738             ,input  v-cntxt-userid
      739             ,input  v-diasize-proc-name
      740             ,input  'height':u
      741             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      742             ) .
      743         end.
      744       end.
      745     end.
      746     assign
      747       v-diasize-change-size = false
      748     .
      749   end procedure.
      750   procedure diasize_set-height :
      751     define input  parameter p-new-height  as decimal   no-undo .
      752     define input  parameter p-move-resize as logical   no-undo .
      753     do
      754     on error undo, return error return-value
      755     :
      756       run diasize_change-height in this-procedure
      757         (input  (p-new-height - frame Dialog-Frame :height)
      758         ,input  p-move-resize
      759         ) .
      760     end.
      761   end procedure.
      762   procedure diasize_change-width :
      763     define input  parameter p-change-value as decimal   no-undo .
      764     define input  parameter p-move-resize  as logical   no-undo .
      765     define variable v-field-group-handle   as handle    no-undo .
      766     define variable v-object-handle        as handle    no-undo .
      767     define variable v-frame-width          as decimal   no-undo .
      768     define variable v-frame-virtual-width  as decimal   no-undo .
      769     define variable v-browse-width         as decimal   no-undo .
      770     define variable v-window-width         as decimal   no-undo .
      771     define variable v-window-virtual-width as decimal   no-undo .
      772     define variable v-change-sign          as integer   no-undo .
      773     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      774     define buffer buf_temp-browse-handle  for temp-browse-handle .
      775     if p-change-value > 0
      776     then do:
      777       if frame Dialog-Frame :width + p-change-value >
      778           session :width-chars
      779       then do:
      780         assign
      781           p-change-value = session :width-chars - frame Dialog-Frame :width
      782         .
      783         if p-change-value <= 0
      784         then do:
      785           run diasize_position-resize-button in this-procedure .
      786           return .
      787         end.
      788       end.
      789     end.
      790     if p-change-value < 0
      791     then do:
      792       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      793       then do:
      794         assign
      795           p-change-value = v-diasize-orig-frame-width
      796                          - frame Dialog-Frame :width
      797         .
      798         if p-change-value >= 0
      799         then do:
      800           run diasize_position-resize-button in this-procedure .
      801           return .
      802         end.
      803       end.
      804     end.
      805     if p-change-value >= 0
      806     then do:
      807       assign
      808         v-change-sign = 1
      809       .
      810     end.
      811     else do:
      812       assign
      813         v-change-sign = -1
      814       .
      815     end.
      816     assign
      817       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      818     .
      819     if p-change-value = 0
      820     then do:
      821       run diasize_position-resize-button in this-procedure .
      822       return .
      823     end.
      824     move_block:
      825     do
      826     on error undo move_block, leave move_block
      827     :
      828       if retry
      829       then do:
      830         do
      831         on error undo move_block, leave move_block
      832         :
      833           if p-change-value > 0
      834           then do:
      835             for each buf_temp-diasize-handle
      836             on error undo, next
      837             :
      838               assign
      839                 v-object-handle = buf_temp-diasize-handle.handle-value
      840               .
      841               if v-object-handle <> v-diasize-resize-button
      842               then do:
      843                 assign
      844                   v-object-handle :col = buf_temp-diasize-handle.save-position
      845                 .
      846               end.
      847             end.
      848             assign
      849               v-diasize-browse-handle :width = v-browse-width
      850             .
      851             for each buf_temp-browse-handle
      852               where buf_temp-browse-handle.browse-type = 'width':u
      853             on error undo, next
      854             :
      855               assign
      856                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      857               .
      858             end.
      859             assign
      860               frame Dialog-Frame :width = v-frame-width
      861             .
      862             if frame Dialog-Frame :scrollable = true
      863             then do:
      864               assign
      865                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      866               .
      867             end.
      868             run diasize_position-resize-button in this-procedure .
      869           end.
      870           else do:
      871             if frame Dialog-Frame :scrollable = true
      872             then do:
      873               assign
      874                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      875               .
      876             end.
      877             assign
      878               frame Dialog-Frame :width = v-frame-width
      879             .
      880             for each buf_temp-browse-handle
      881               where buf_temp-browse-handle.browse-type = 'width':u
      882             on error undo, next
      883             :
      884               assign
      885                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      886               .
      887             end.
      888             assign
      889               v-diasize-browse-handle :width = v-browse-width
      890             .
      891             for each buf_temp-diasize-handle
      892             on error undo, next
      893             :
      894               assign
      895                 v-object-handle = buf_temp-diasize-handle.handle-value
      896               .
      897               if v-object-handle <> v-diasize-resize-button
      898               then do:
      899                 assign
      900                   v-object-handle :col = buf_temp-diasize-handle.save-position
      901                 .
      902               end.
      903             end.
      904             run diasize_position-resize-button in this-procedure .
      905           end.
      906           assign
      907             v-diasize-change-size = false
      908           .
      909           leave move_block .
      910         end.
      911       end.
      912       assign
      913         v-diasize-need-full-display = true
      914       .
      915       if v-diasize-change-size = false
      916       then do:
      917         assign
      918           v-diasize-change-size = true
      919         .
      920       end.
      921       else do:
      922         return .
      923       end.
      924       assign
      925         v-frame-width = frame Dialog-Frame :width
      926         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      927         v-browse-width = v-diasize-browse-handle :width
      928       .
      929       for each buf_temp-browse-handle
      930         where buf_temp-browse-handle.browse-type = 'width':u
      931       :
      932         assign
      933           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      934         .
      935       end.
      936       for each buf_temp-diasize-handle
      937       :
      938         delete buf_temp-diasize-handle .
      939       end.
      940       assign
      941         v-field-group-handle = frame Dialog-Frame :first-child
      942       .
      943       do while valid-handle(v-field-group-handle)
      944       :
      945         assign
      946           v-object-handle = v-field-group-handle :first-child
      947         .
      948         do while valid-handle(v-object-handle)
      949         :
      950           if  v-object-handle <> v-diasize-browse-handle :handle
      951           and v-object-handle <> v-diasize-resize-button
      952           and can-query(v-object-handle, "row")
      953           and can-query(v-object-handle, "height")
      954           and ( v-object-handle :col + v-object-handle :width
      955                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      956               )
      957           then do:
      958             find first buf_temp-browse-handle
      959               where buf_temp-browse-handle.browse-type   = 'width':u
      960                 and buf_temp-browse-handle.browse-handle = v-object-handle
      961               no-error .
      962             if available buf_temp-browse-handle
      963             then do:
      964             end.
      965             else do:
      966               create buf_temp-diasize-handle .
      967               assign
      968                 buf_temp-diasize-handle.handle-value  = v-object-handle
      969                 buf_temp-diasize-handle.save-position = v-object-handle :col
      970               .
      971             end.
      972           end.
      973           assign
      974             v-object-handle = v-object-handle :next-sibling
      975           .
      976         end.
      977         assign
      978           v-field-group-handle = v-field-group-handle :next-sibling
      979         .
      980       end.
      981       do with frame Dialog-Frame
      982       :
      983         hide v-diasize-resize-button .
      984         v-diasize-resize-button :row = 1.
      985         v-diasize-resize-button :column = 1.
      986       end.
      987       if p-change-value > 0
      988       then do:
      989         if frame Dialog-Frame :scrollable = true
      990         then do:
      991           assign
      992             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      993             no-error .
      994           if error-status :error
      995           or error-status :get-message(1) <> ""
      996           then do:
      997             undo move_block, retry move_block.
      998           end.
      999         end.
     1000         assign
     1001           frame Dialog-Frame :width = v-frame-width + p-change-value
     1002           no-error .
     1003         if error-status :error
     1004         or error-status :get-message(1) <> ""
     1005         then do:
     1006           undo move_block, retry move_block.
     1007         end.
     1008         assign
     1009           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1010         no-error .
     1011         if error-status :error
     1012         or error-status :get-message(1) <> ""
     1013         then do:
     1014           undo move_block, retry move_block.
     1015         end.
     1016         for each buf_temp-browse-handle
     1017           where buf_temp-browse-handle.browse-type = 'width':u
     1018         on error undo move_block, retry move_block
     1019         :
     1020           assign
     1021             buf_temp-browse-handle.browse-handle :width
     1022               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1023             no-error .
     1024           if error-status :error
     1025           or error-status :get-message(1) <> ""
     1026           then do:
     1027             undo move_block, retry move_block .
     1028           end.
     1029         end.
     1030         for each buf_temp-diasize-handle
     1031         on error undo move_block, retry move_block
     1032         :
     1033           assign
     1034             v-object-handle = buf_temp-diasize-handle.handle-value
     1035           .
     1036           if v-object-handle <> v-diasize-resize-button
     1037           then do:
     1038             assign
     1039               v-object-handle :col = v-object-handle :col + p-change-value
     1040               no-error .
     1041             if error-status :error
     1042             or error-status :get-message(1) <> ""
     1043             then do:
     1044               undo move_block, retry move_block .
     1045             end.
     1046           end.
     1047         end.
     1048       end.
     1049       else do:
     1050         for each buf_temp-diasize-handle
     1051         on error undo move_block, retry move_block
     1052         :
     1053           assign
     1054             v-object-handle = buf_temp-diasize-handle.handle-value
     1055           .
     1056           if v-object-handle <> v-diasize-resize-button
     1057           then do:
     1058             assign
     1059               v-object-handle :col = v-object-handle :col + p-change-value
     1060               no-error .
     1061             if error-status :error
     1062             or error-status :get-message(1) <> ""
     1063             then do:
     1064               undo move_block, retry move_block .
     1065             end.
     1066           end.
     1067         end.
     1068         for each buf_temp-browse-handle
     1069           where buf_temp-browse-handle.browse-type = 'width':u
     1070         on error undo move_block, retry move_block
     1071         :
     1072           assign
     1073             buf_temp-browse-handle.browse-handle :width
     1074               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1075             no-error .
     1076           if error-status :error
     1077           or error-status :get-message(1) <> ""
     1078           then do:
     1079             undo move_block, retry move_block .
     1080           end.
     1081         end.
     1082         assign
     1083           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1084           no-error .
     1085         if error-status :error
     1086         or error-status :get-message(1) <> ""
     1087         then do:
     1088           undo move_block, retry move_block.
     1089         end.
     1090         assign
     1091           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1092         no-error .
     1093         if error-status :error
     1094         or error-status :get-message(1) <> ""
     1095         then do:
     1096           undo move_block, retry move_block.
     1097         end.
     1098         if frame Dialog-Frame :scrollable = true
     1099         then do:
     1100           assign
     1101             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1102           no-error .
     1103           if error-status :error
     1104           or error-status :get-message(1) <> ""
     1105           then do:
     1106             undo move_block, retry move_block.
     1107           end.
     1108         end.
     1109       end.
     1110       if p-move-resize
     1111       then do:
     1112         run diasize_position-resize-button in this-procedure .
     1113       end.
     1114       if v-diasize-wndstore = true
     1115       then do:
     1116         if connected("ub") = true
     1117         then do:
     1118           define variable v-cntxt-db-num        as integer   no-undo .
     1119           define variable v-cntxt-userid        as character no-undo .
     1120           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1121                                             , OUTPUT v-cntxt-userid
     1122                                             ) .
     1123           run gbl/wndsizew.p
     1124             (input  v-cntxt-db-num
     1125             ,input  v-cntxt-userid
     1126             ,input  v-diasize-proc-name
     1127             ,input  'width':u
     1128             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1129             ) .
     1130         end.
     1131       end.
     1132     end.
     1133     assign
     1134       v-diasize-change-size = false
     1135     .
     1136   end procedure.
     1137   procedure diasize_set-width :
     1138     define input  parameter p-new-width  as decimal   no-undo .
     1139     define input  parameter p-move-resize as logical   no-undo .
     1140     do
     1141     on error undo, return error return-value
     1142     :
     1143       run diasize_change-width in this-procedure
     1144         (input  (p-new-width - frame Dialog-Frame :width)
     1145         ,input  p-move-resize
     1146         ) .
     1147     end.
     1148   end procedure.
     1149   procedure diasize_position-resize-button :
     1150     do with frame Dialog-Frame
     1151     :
     1152       hide v-diasize-resize-button .
     1153       assign
     1154         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1155                     - 1
     1156                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1157         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1158                     - 1
     1159                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1160       .
     1161       view v-diasize-resize-button .
     1162     end.
     1163   end procedure.
     1164   on alt-right anywhere
     1165   do:
     1166     run diasize_change-width in this-procedure
     1167       (input 1
     1168       ,input true
     1169       ) .
     1170     return no-apply .
     1171   end.
     1172   on alt-left anywhere
     1173   do:
     1174     run diasize_change-width in this-procedure
     1175       (input -1
     1176       ,input true
     1177       ) .
     1178     return no-apply .
     1179   end.
     1180   on alt-down anywhere
     1181   do:
     1182     run diasize_change-height in this-procedure
     1183       (input 1
     1184       ,input true
     1185       ) .
     1186     return no-apply .
     1187   end.
     1188   on alt-up anywhere
     1189   do:
     1190     run diasize_change-height in this-procedure
     1191       (input -1
     1192       ,input true
     1193       ) .
     1194     return no-apply .
     1195   end.
     1196   on alt-enter of frame Dialog-Frame
     1197   do:
     1198     run diasize_maximize in this-procedure
     1199       (input  ?
     1200       ).
     1201     return no-apply .
     1202   end.
     1203   procedure diasize_end-move :
     1204     do
     1205     on error undo, return error return-value
     1206     :
     1207       define variable v-row-delta as decimal   no-undo .
     1208       define variable v-col-delta as decimal   no-undo .
     1209       define variable v-new-row as decimal   no-undo .
     1210       define variable v-new-col as decimal   no-undo .
     1211       assign
     1212         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1213         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1214       .
     1215       assign
     1216         v-row-delta = v-new-row - frame Dialog-Frame :height
     1217         v-col-delta = v-new-col - frame Dialog-Frame :width
     1218       .
     1219       run diasize_change-height in this-procedure
     1220         (input v-row-delta
     1221         ,input true
     1222         ) .
     1223       run diasize_change-width in this-procedure
     1224         (input v-col-delta
     1225         ,input true
     1226         ) .
     1227     end.
     1228   end procedure.
     1229   procedure diasize_maximize :
     1230     define input  parameter p-action as logical   no-undo .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       if p-action = ?
     1235       then do:
     1236         if v-diasize-need-maximize = true
     1237         then do:
     1238           assign
     1239             p-action = true
     1240           .
     1241         end.
     1242         else do:
     1243           assign
     1244             p-action = false
     1245           .
     1246         end.
     1247       end.
     1248       if p-action = true
     1249       then do:
     1250         run diasize_change-height in this-procedure
     1251           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1252               - frame Dialog-Frame :height-chars
     1253           ,input true
     1254           ) .
     1255         run diasize_change-width in this-procedure
     1256           (input session :width-chars
     1257               - frame Dialog-Frame :width-chars
     1258           ,input true
     1259           ) .
     1260         assign
     1261           v-diasize-need-maximize = false
     1262         .
     1263       end.
     1264       else do:
     1265         run diasize_change-width in this-procedure
     1266           (input v-diasize-orig-frame-width
     1267               - frame Dialog-Frame :width-chars
     1268           ,input true
     1269           ) .
     1270         run diasize_change-height in this-procedure
     1271           (input v-diasize-orig-frame-height
     1272               - frame Dialog-Frame :height-chars
     1273           ,input true
     1274           ) .
     1275         assign
     1276           v-diasize-need-maximize = true
     1277         .
     1278       end.
     1279     end.
     1280   end procedure.
     1281   procedure diasize_restore-orig-size :
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       assign
     1286         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1287         v-diasize-current-frame-height = frame Dialog-Frame :height
     1288       .
     1289       run diasize_set-height in this-procedure
     1290         (input  v-diasize-orig-frame-height
     1291         ,input  true
     1292         ) .
     1293       run diasize_set-width in this-procedure
     1294         (input  v-diasize-orig-frame-width
     1295         ,input  true
     1296         ) .
     1297     end.
     1298   end procedure.
     1299   procedure diasize_restore-current-size :
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303       run diasize_set-height in this-procedure
     1304         (input  v-diasize-current-frame-height
     1305         ,input  true
     1306         ) .
     1307       run diasize_set-width in this-procedure
     1308         (input  v-diasize-current-frame-width
     1309         ,input  true
     1310         ) .
     1311     end.
     1312   end procedure.
     1313   procedure diasize_set-browse-handle :
     1314     define input  parameter p-browse-handle as handle   no-undo .
     1315     define buffer buf_temp-browse-handle for temp-browse-handle .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       assign
     1320         v-diasize-browse-handle = p-browse-handle
     1321       .
     1322       for each buf_temp-browse-handle
     1323       on error undo, return error return-value
     1324       :
     1325         delete buf_temp-browse-handle .
     1326       end.
     1327     end.
     1328   end procedure.
     1329   procedure diasize_add_browse :
     1330     define input  parameter p-browse-type   as character no-undo .
     1331     define input  parameter p-browse-handle as handle    no-undo .
     1332     define buffer buf_temp-browse-handle for temp-browse-handle .
     1333     do
     1334     on error undo, return error return-value
     1335     :
     1336       assign
     1337         v-diasize-browse-number = v-diasize-browse-number + 1
     1338       .
     1339       create buf_temp-browse-handle .
     1340       assign
     1341         buf_temp-browse-handle.browse-type   = p-browse-type
     1342         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1343         buf_temp-browse-handle.browse-handle = p-browse-handle
     1344       .
     1345     end.
     1346   end procedure.
     1347   procedure diasize_init :
     1348     define variable v-default-value    as logical   no-undo .
     1349     define variable v-restore-saved    as logical   no-undo .
     1350     define variable v-resize-value-str as character no-undo .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       do with frame Dialog-Frame
     1355       :
     1356         assign
     1357           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1358           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1359           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1360         .
     1361         create button v-diasize-resize-button
     1362         assign
     1363           parent        = frame Dialog-Frame :first-child
     1364           label         = "s"
     1365           height-pixels = 16
     1366           width-pixels  = 16
     1367           visible       = true
     1368           sensitive     = true
     1369           movable       = true
     1370           triggers:
     1371             on end-move persistent run diasize_end-move in this-procedure .
     1372           end triggers.
     1373         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1374         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1375         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1376         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1377         assign
     1378           v-diasize-wndmax = false
     1379         .
     1380         if connected("ub") = true
     1381         then do:
     1382           define variable v-cntxt-db-num        as integer   no-undo .
     1383           define variable v-cntxt-userid        as character no-undo .
     1384           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1385                                             , OUTPUT v-cntxt-userid
     1386                                             ) .
     1387           run gbl/wndpar_r.p
     1388             (input  v-cntxt-db-num
     1389             ,input  v-cntxt-userid
     1390             ,input  'wndmax':U
     1391             ,output v-diasize-wndmax
     1392             ,output v-default-value
     1393             ) .
     1394         end.
     1395         assign
     1396           v-diasize-wndstore = false
     1397         .
     1398         if connected("ub") = true
     1399         then do:
     1400           run gbl/wndpar_r.p
     1401             (input  v-cntxt-db-num
     1402             ,input  v-cntxt-userid
     1403             ,input  'wndstore':U
     1404             ,output v-diasize-wndstore
     1405             ,output v-default-value
     1406             ) .
     1407         end.
     1408         assign
     1409           v-diasize-proc-name = entry(1, program-name(2), '.')
     1410         .
     1411         if v-diasize-wndstore = true
     1412         then do:
     1413           assign
     1414             v-restore-saved = false
     1415           .
     1416           if connected("ub") = true
     1417           then do:
     1418             run gbl/wndsizer.p
     1419               (input  v-cntxt-db-num
     1420               ,input  v-cntxt-userid
     1421               ,input  v-diasize-proc-name
     1422               ,input  'height':u
     1423               ,output v-resize-value-str
     1424               ) .
     1425             if v-resize-value-str <> '':U
     1426             then do:
     1427               run diasize_change-height in this-procedure
     1428                 (input  integer(v-resize-value-str)
     1429                 ,input  true
     1430                 ) .
     1431               assign
     1432                 v-restore-saved = true
     1433               .
     1434             end.
     1435           end.
     1436           if connected("ub") = true
     1437           then do:
     1438             run gbl/wndsizer.p
     1439               (input  v-cntxt-db-num
     1440               ,input  v-cntxt-userid
     1441               ,input  v-diasize-proc-name
     1442               ,input  'width':u
     1443               ,output v-resize-value-str
     1444               ) .
     1445             if v-resize-value-str <> '':U
     1446             then do:
     1447               run diasize_change-width in this-procedure
     1448                 (input  integer(v-resize-value-str)
     1449                 ,input  true
     1450                 ) .
     1451               assign
     1452                 v-restore-saved = true
     1453               .
     1454             end.
     1455           end.
     1456           if v-restore-saved <> true
     1457           then do:
     1458             if v-diasize-wndmax = true
     1459             then do:
     1460               run diasize_maximize in this-procedure
     1461                 (input  true
     1462                 ) .
     1463             end.
     1464           end.
     1465         end.
     1466         else do:
     1467           if v-diasize-wndmax = true
     1468           then do:
     1469             run diasize_maximize in this-procedure
     1470               (input  true
     1471               ) .
     1472           end.
     1473         end.
     1474       end.
     1475     end.
     1476   end procedure.
     1477   procedure diasize_need-full-display :
     1478     define output parameter p-need-full-display as logical   no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       assign
     1483         p-need-full-display = v-diasize-need-full-display
     1484       .
     1485       assign
     1486         v-diasize-need-full-display = false
     1487       .
     1488     end.
     1489   end procedure.
     1490   procedure get-context :
     1491      define output parameter p-db-num as integer          no-undo.
     1492      define output parameter p-user-id as character        no-undo.
     1493      define variable v-login               as character    no-undo.
     1494      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1495      define buffer buf_user-login  for ub.user-login .
     1496      do
     1497      on error undo, return error
     1498      :
     1499            FIND FIRST buf_sys-ctrl no-lock.
     1500            ASSIGN
     1501               v-login = USERID("ub")
     1502               p-db-num = buf_sys-ctrl.db-num
     1503            .
     1504            FIND FIRST buf_user-login
     1505                 WHERE buf_user-login.db-num = p-db-num
     1506                   AND buf_user-login.user-login = v-login
     1507                 no-lock
     1508                 no-error
     1509                 .
     1510            IF AVAILABLE buf_user-login
     1511            THEN DO:
     1512               assign
     1513                  p-user-id = buf_user-login.user-id
     1514               .
     1515            END.
     1516      end.
     1517   end procedure.
     1518       run diasize_init in this-procedure .
     1519     BROWSE-1 :SET-REPOSITIONED-ROW(2, "CONDITIONAL") .
     1520     do varcount = 1 to num-entries('1,2,3,4':U):
     1521       create tt-purch.
     1522       assign
     1523         tt-purch.purch-code = varcount
     1524         tt-purch.mark = no
     1525         tt-purch.purch-name = entry (varcount, 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
     1526     end.
     1527     RUN enable_UI.
     1528     WAIT-FOR GO OF FRAME Dialog-Frame.
     1529   END.
     1530   RUN disable_UI.
     1531   PROCEDURE disable_UI :
     1532     HIDE FRAME Dialog-Frame.
     1533   END PROCEDURE.
     1534   PROCEDURE enable_UI :
     1535     DISPLAY varold-vat-pc varvat-pc varchange-price
     1536         WITH FRAME Dialog-Frame.
     1537     ENABLE b-exit b-cancel b-mark b-help varold-vat-pc varvat-pc varchange-price
     1538            BROWSE-1
     1539         WITH FRAME Dialog-Frame.
     1540     VIEW FRAME Dialog-Frame.
     1541     OPEN QUERY BROWSE-1 FOR EACH tt-purch.
     1542   END PROCEDURE.
