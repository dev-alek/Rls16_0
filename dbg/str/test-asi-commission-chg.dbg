        1   define input-output parameter p-FIO as character no-undo .
        2   define input-output parameter p-position as character no-undo .
        3   DEFINE BUTTON B-Cancel AUTO-END-KEY
        4        LABEL "Отмена"
        5        SIZE 15 BY 1.14
        6        BGCOLOR 8 .
        7   DEFINE BUTTON B-OK AUTO-GO
        8        LABEL "Ввод"
        9        SIZE 15 BY 1.14
       10        BGCOLOR 8 .
       11   DEFINE VARIABLE f-FIO AS CHARACTER FORMAT "X(120)":U
       12        VIEW-AS FILL-IN
       13        SIZE 88 BY 1 NO-UNDO.
       14   DEFINE VARIABLE f-position AS CHARACTER FORMAT "X(120)":U
       15        VIEW-AS FILL-IN
       16        SIZE 88 BY 1 NO-UNDO.
       17   DEFINE FRAME Dialog-Frame
       18        f-FIO AT ROW 2 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 6
       19        f-position AT ROW 4 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 10
       20        B-OK AT ROW 5.1 COL 2.8
       21        B-Cancel AT ROW 5.1 COL 17.8
       22        "ФИО" VIEW-AS TEXT
       23             SIZE 8 BY .62 AT ROW 1.2 COL 3 WIDGET-ID 2
       24        "Должность" VIEW-AS TEXT
       25             SIZE 12.2 BY .62 AT ROW 3.2 COL 3 WIDGET-ID 8
       26        SPACE(77.79) SKIP(2.48)
       27       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       28            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       29            TITLE " "
       30            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
       31   ASSIGN
       32          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       33          FRAME Dialog-Frame:HIDDEN           = TRUE.
       34   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       35   DO:
       36     APPLY "END-ERROR":U TO SELF.
       37   END.
       38   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
       39   DO:
       40     assign
       41       f-FIO
       42       f-position
       43       p-FIO = f-FIO
       44       p-position = f-position
       45     .
       46   END.
       47   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       48   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       49   MAIN-BLOCK:
       50   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       51      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       52     assign
       53       f-FIO = p-FIO
       54       f-position = p-position
       55     .
       56     RUN enable_UI.
       57     WAIT-FOR GO OF FRAME Dialog-Frame.
       58   END.
       59   RUN disable_UI.
       60   PROCEDURE disable_UI :
       61     HIDE FRAME Dialog-Frame.
       62   END PROCEDURE.
       63   PROCEDURE enable_UI :
       64     DISPLAY f-FIO f-position
       65         WITH FRAME Dialog-Frame.
       66     ENABLE f-FIO f-position B-OK B-Cancel
       67         WITH FRAME Dialog-Frame.
       68     VIEW FRAME Dialog-Frame.
       69   END PROCEDURE.
