      132     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      133       define variable v-answ as logical no-undo .
      134       if ( p-unit-base-cli-eq = true
      135            and p-density = 1.0
      136          )
      137         or ( p-unit-base-cli-eq = false
      138              and p-density <> ?
      139              and p-density > 0.0
      140              and p-density < 1.0
      141            )
      142       then do:
      143         assign
      144           v-answ = true
      145         .
      146       end.
      147       else do:
      148         assign
      149           v-answ = false
      150         .
      151       end.
      152       return v-answ.
      153     end function.
