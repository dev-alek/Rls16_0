     3454               ,input-output ub.doc-line.price-base
     3455               ,input-output ub.doc-line.price-rubl
     3456               ,-1
     3457               ,""
     3458             ) no-error.
     3459             if error-status :error then do:
     3460               assign
     3461                 v-err-msg = substitute( "Ошибка при резервировании.&1&2", chr(10), return-value )
     3462               .
     3463             end.
     3464             else do:
     3465               if new-pl-qnty <> ub.doc-pl.doc-qnty then do:
     3466                 assign
     3467                   v-err-msg = substitute( "Не удалось зарезервировать все запрошенное количество.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     3468                                         , chr(10)
     3469                                         , ub.doc-pl.doc-qnty - old-pl-qnty
     3470                                         , new-pl-qnty - old-pl-qnty
     3471                                         )
     3472                 .
     3473               end.
     3474             end.
     3475             if v-err-msg <> "":U then do:
     3476               message
     3477                 vss-workfile vss-revision vss-description skip
     3478                 v-err-msg skip
     3479                 view-as alert-box error .
     3480               undo, return error v-err-msg .
     3481             end.
     3482           end.
     3483           assign
     3484             v-fact-qnty     = v-fact-qnty     + ub.doc-pl.fact-qnty
     3485             v-fact-cli-qnty = v-fact-cli-qnty + ub.doc-pl.cli-fact-qnty
     3486             v-rest-qnty     = v-rest-qnty     + ub.doc-pl.rest-af-qnty
     3487             v-rest-cli-qnty = v-rest-cli-qnty + ub.doc-pl.cli-rest-af-qnty
     3488           .
     3489         end.
     3490         if v-rest-qnty <> 0.0
     3491           and v-rest-cli-qnty <> 0.0
     3492         then do:
     3493           assign
     3494             ub.doc-line.doc-density  = v-rest-cli-qnty / v-rest-qnty
     3495             ub.doc-line.fact-density = ub.doc-line.doc-density
     3496           .
     3497         end.
     3498         assign
     3499           ub.gds-dtl.fact-qnty      = v-rest-qnty
     3500           ub.doc-line.doc-qnty      = v-rest-qnty
     3501           ub.inv-line.wast-cli-qnty = v-rest-cli-qnty
     3502           ub.gds-dtl.doc-qnty       = v-fact-qnty
     3503           ub.doc-line.fact-qnty     = v-fact-qnty
     3504           ub.doc-line.cli-qnty      = v-fact-cli-qnty
     3505         .
     3506       end.
     3507       else do:
     3508         IF ub.trn-doc.flag_ = YES THEN DO:
     3509           assign chg-qnty = input frame d-inv-prt ub.gds-dtl.fact-qnty - ub.gds-dtl.fact-qnty.
     3510           run trg/rsrv-dtl.p ( input        parParentProc,
     3511                           input        'reserv':U,
     3512                           buffer       ub.gds-dtl,
     3513                           input-output chg-qnty,
     3514                           input-output ub.doc-line.price-base,
     3515                           input-output ub.doc-line.price-rubl,
     3516                           input        -1,
     3517                           input ""                         ).
     3518           assign ub.gds-dtl.fact-qnty  = ub.gds-dtl.fact-qnty  + chg-qnty
     3519                 ub.gds-dtl.doc-qnty   = ub.gds-dtl.fact-qnty  - old-val
     3520                 ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty  + chg-qnty
     3521                 ub.doc-line.fact-qnty = ub.doc-line.fact-qnty + chg-qnty.
     3522         END.
     3523         ELSE DO:
     3524           assign chg-qnty = input frame d-inv-prt ub.gds-dtl.doc-qnty - ub.gds-dtl.doc-qnty.
     3525           run trg/rsrv-dtl.p ( input        parParentProc,
     3526                           input        'reserv':U,
     3527                           buffer       ub.gds-dtl,
     3528                           input-output chg-qnty,
     3529                           input-output ub.doc-line.price-base,
     3530                           input-output ub.doc-line.price-rubl,
     3531                           input        -1,
     3532                           input ""                         ).
     3533           assign ub.gds-dtl.fact-qnty  = ub.gds-dtl.fact-qnty  + chg-qnty
     3534                 ub.gds-dtl.doc-qnty   = ub.gds-dtl.doc-qnty   + chg-qnty
     3535                 ub.doc-line.doc-qnty  = ub.doc-line.doc-qnty  + chg-qnty
     3536                 ub.doc-line.fact-qnty = ub.doc-line.fact-qnty + chg-qnty.
     3537         END.
     3538       end.
     3539       assign prt-rec = recid( ub.gds-dtl ).
     3540       if ub.gds-dtl.doc-qnty = 0 then do:
     3541         delete ub.gds-dtl.
     3542         assign prt-rec = ?.
     3543       end.
     3544       assign ub.doc-line.prt-OK = no.
     3545       find ub.gds-prt no-lock where ub.gds-prt.upper-code = ub.goods.prt-root.
     3546       for each ub.gds-dtl where
     3547               ub.gds-dtl.prod-code = ub.goods.prod-code   and
     3548               ub.gds-dtl.prod-type = ub.goods.prod-type   and
     3549               ub.gds-dtl.artic     = ub.goods.artic       and
     3550               ub.gds-dtl.doc-code  = ub.doc-line.doc-code :
     3551         if ub.gds-dtl.doc-qnty <> 0 and ub.gds-dtl.prt-code <> ub.gds-prt.node-code then do:
     3552           assign ub.doc-line.prt-OK = yes.
     3553         end.
     3554       end.
     3555     end.
     3556   END.
     3557   RUN disable_UI IN THIS-PROCEDURE.
     3558   for each tt-doc-pl
     3559   on error undo, return error return-value
     3560   :
     3561     delete tt-doc-pl.
     3562   end.
     3563   if prt-mode = 'ПРОСМОТР':U then do:
     3564     return error.
     3565   end.
     3566   PROCEDURE disable_UI :
     3567     HIDE FRAME d-inv-prt NO-PAUSE.
     3568   END PROCEDURE.
     3569   PROCEDURE UI-on :
     3570     v-inv_peresort = 0 .
     3571     if v-inv-prsr = "yes" then do:
     3572             assign
     3573               v-inv_peresort  = ub.doc-line.inv-peresort
     3574             .
     3575         display v-inv_peresort with frame d-inv-prt.
     3576     end.
     3577     IF ptrlprop-expptrl <> ? THEN DO:
     3578       ASSIGN FRAME d-inv-prt  :HEIGHT-CHARS                        = 13.
     3579       ASSIGN RECT-1               :HEIGHT-CHARS IN FRAME d-inv-prt =  5.50.
     3580     END.
     3581     ELSE DO:
     3582       ASSIGN ub.doc-line.doc-density       :ROW IN FRAME d-inv-prt =
     3583              ub.doc-line.doc-density       :ROW IN FRAME d-inv-prt - 1.25
     3584              ub.inv-line.wast-cli-qnty :ROW IN FRAME d-inv-prt =
     3585              ub.inv-line.wast-cli-qnty :ROW IN FRAME d-inv-prt - 2.50
     3586              ub.doc-line.cli-qnty      :ROW IN FRAME d-inv-prt =
     3587              ub.doc-line.cli-qnty      :ROW IN FRAME d-inv-prt - 2.50
     3588              ub.goods.unit-cli         :ROW IN FRAME d-inv-prt =
     3589              ub.goods.unit-cli         :ROW IN FRAME d-inv-prt - 2.50.
     3590       HIDE   ub.doc-line.doc-density            IN FRAME d-inv-prt
     3591              ub.inv-line.wast-cli-qnty      IN FRAME d-inv-prt
     3592              ub.doc-line.cli-qnty           IN FRAME d-inv-prt
     3593              ub.goods.unit-cli              IN FRAME d-inv-prt.
     3594       ASSIGN FRAME d-inv-prt :HEIGHT-CHARS                        = 13.
     3595       ASSIGN RECT-1              :HEIGHT-CHARS IN FRAME d-inv-prt =  3.00.
     3596     END.
     3597     HIDE RECT-1 IN FRAME d-inv-prt.
     3598     HIDE           FRAME d-inv-prt NO-PAUSE.
     3599     VIEW           FRAME d-inv-prt.   PAUSE 0.
     3600     DISPLAY   WITH FRAME d-inv-prt.
     3601     ASSIGN FRAME d-inv-prt :TITLE = "Инвентаризация №  " + ub.trn-doc.doc-code + ".    'строка':U     " + prt-mode.
     3602     FIND b-c-b NO-LOCK WHERE
     3603          b-c-b.gds-code  = ub.goods.gds-code    AND
     3604          b-c-b.node-code = ub.gds-prt.node-code AND
     3605          b-c-b.in-code   = "":U                 AND
     3606          b-c-b.unit-cli  = ub.goods.unit-base   AND
     3607          b-c-b.part-code = "":U                 NO-ERROR.
     3608     DISPLAY ub.clients.obj-name ub.doc-line.artic  ub.doc-line.prod-type ub.doc-line.prod-code
     3609             ub.goods.gds-name   ub.goods.unit-base RECT-1
     3610     WITH FRAME d-inv-prt.
     3611     IF AVAILABLE b-c-b THEN DO: DISPLAY b-c-b.b-code WITH FRAME d-inv-prt. END.
     3612     IF node-type = 'корн':U THEN DO: HIDE    ub.doc-line.fact-qnty ub.gds-prt.f-name   IN FRAME d-inv-prt. END.
     3613                              ELSE DO: DISPLAY ub.doc-line.fact-qnty ub.gds-prt.f-name WITH FRAME d-inv-prt. END.
     3614     IF AVAILABLE ub.gds-dtl THEN DO:
     3615       DISPLAY ub.gds-dtl.doc-qnty ub.gds-dtl.fact-qnty WITH FRAME d-inv-prt.
     3616     END.
     3617     IF ptrlprop-expptrl <> ? THEN DO:
     3618       DISPLAY ub.doc-line.doc-density ub.inv-line.wast-cli-qnty ub.doc-line.cli-qnty
     3619               ub.goods.unit-cli
     3620       WITH FRAME d-inv-prt.
     3621     END.
     3622     ENABLE b-exit b-help WITH FRAME d-inv-prt.
     3623     IF prt-mode <> 'ПРОСМОТР':U THEN DO:
     3624       IF ptrlprop-expptrl <> ? THEN DO:
     3625         ENABLE
     3626           ub.doc-line.doc-density when v-single-place = true
     3627           WITH FRAME d-inv-prt.
     3628         if v-single-place = true
     3629           and valid-density( ub.doc-line.doc-density, (ub.goods.unit-base = ub.goods.unit-cli) ) = true
     3630         then do:
     3631           apply "leave":u to ub.doc-line.doc-density in frame d-inv-prt.
     3632         end.
     3633       END.
     3634       IF ub.trn-doc.flag_ = YES THEN DO:
     3635         IF ptrlprop-expptrl = 'weight':U THEN DO: ENABLE ub.inv-line.wast-cli-qnty WITH FRAME d-inv-prt. END.
     3636                                              ELSE DO: ENABLE ub.gds-dtl.fact-qnty      WITH FRAME d-inv-prt. END.
     3637       END.
     3638       ELSE DO:
     3639         IF ptrlprop-expptrl = 'weight':U THEN DO: ENABLE ub.doc-line.cli-qnty      WITH FRAME d-inv-prt. END.
     3640                                              ELSE DO: ENABLE ub.gds-dtl.doc-qnty       WITH FRAME d-inv-prt. END.
     3641       END.
     3642     END.
     3643   END PROCEDURE.
     3644   procedure doc-qnty-by-factord :
     3645   define input  parameter par-recid     as recid no-undo .
     3646   define input  parameter par-obj-type  like ub.doc-line.obj-type  no-undo .
     3647   define input  parameter par-obj-code  like ub.doc-line.obj-code  no-undo .
     3648   define input  parameter par-artic     like ub.doc-line.artic     no-undo .
     3649   define input  parameter par-prod-type like ub.doc-line.prod-type no-undo .
     3650   define input  parameter par-prod-code like ub.doc-line.prod-code no-undo .
     3651   define input  parameter par-prt-code  like ub.prt-obj.prt-code no-undo .
     3652   define output parameter v-doc-qnty    as decimal   no-undo .
     3653   define output parameter v-fact-order-end as decimal   no-undo .
     3654   define variable v-shift-on  as logical   no-undo .
     3655   define variable v-shift-end-fact-order as decimal   no-undo .
     3656   define variable v-day-end-fact-order   as decimal   no-undo .
     3657   define buffer buf_trn-doc for ub.trn-doc  .
     3658     do
     3659     on error undo, return error return-value
     3660     :
     3661   find first buf_trn-doc no-lock  where recid(buf_trn-doc) =  par-recid no-error .
     3662   v-doc-qnty = 0 .
     3663   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3664   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3665     (input  buf_trn-doc.obj-type
     3666     ,input  buf_trn-doc.obj-code
     3667     ,input  'shift-on=request'
     3668     ,output v-shift-on
     3669     ) no-error .
     3670       if error-status :error then do:
     3671         message
     3672             vss-workfile vss-revision vss-description
     3673             skip "Ошибка при запросе, включены ли смены"
     3674             skip error-status :get-message(1)
     3675             skip return-value
     3676         view-as alert-box error .
     3677         undo, return error .
     3678       end.
     3679           run factord in this-procedure (
     3680                 input  buf_trn-doc.fact-date
     3681               , input  buf_trn-doc.fact-time
     3682               , input  buf_trn-doc.fact-time
     3683               , input  buf_trn-doc.shift-date
     3684               , input  buf_trn-doc.shift-num
     3685               , input  v-shift-on
     3686               , output v-fact-order-end
     3687               , output v-shift-end-fact-order
     3688               , output v-day-end-fact-order
     3689           ) no-error .
     3690   if v-shift-on = true then  v-fact-order-end = v-shift-end-fact-order .
     3691                        else  v-fact-order-end = v-day-end-fact-order .
     3692     run prdoclib-init-prt-obj-by-factord in this-procedure
     3693       ( input par-obj-type,
     3694         input par-obj-code,
     3695         input par-artic,
     3696         input par-prod-type,
     3697         input par-prod-code,
     3698         input v-fact-order-end,
     3699         input false ) .
     3700     end.
     3701   v-doc-qnty = 0.
     3702   for each temp-prt-obj where temp-prt-obj.prt-code  = par-prt-code :
     3703     v-doc-qnty = v-doc-qnty + temp-prt-obj.fact-qnty .
     3704   end.
     3705   if v-inv-prsr = "yes" then do:
     3706       if prt-mode = 'ШКАЛА':U then do:
     3707         v-inv_peresort:tooltip in frame d-inv-prt = "Пересортица по товару вцелом , без разбивки по шкале" .
     3708       end.
     3709       enable  v-inv_peresort  with frame d-inv-prt.
     3710   end.
     3711   else hide  v-inv_peresort  in frame d-inv-prt.
     3712   end procedure.
