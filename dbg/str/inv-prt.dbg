     2450   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2451   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
     2452   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
     2453   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
     2454   define variable ptrlprop-autopump      as logical   no-undo initial false .
     2455   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
     2456   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
     2457   define variable ptrlprop-olddens       as logical   no-undo initial false .
     2458   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
     2459   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
     2460   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
     2461   define variable ptrlprop-algoincome as integer no-undo init 0.
     2462   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
     2463   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
     2464   define variable ptrlprop-Delta-mass-vert       as character no-undo .
