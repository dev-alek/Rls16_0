      480                 "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      481                 "Корень шкалы товара" v-root-node skip
      482                 view-as alert-box error .
      483               undo, return error .
      484             end.
      485           end.
      486         end.
      487       end.
      488       find first buf_temp-prt-obj
      489         where buf_temp-prt-obj.prt-code = v-root-node
      490         .
      491       assign
      492         buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
      493                                     - v-total-term-fact-qnty
      494       .
      495       if p-check-price-list = true
      496       then do:
      497         if buf_temp-prt-obj.fact-qnty <> buf_temp-prt-obj.price-list-qnty and p-check-price-parts
      498         then do:
      499           message
      500             vss-workfile vss-revision vss-description skip
      501             vss-include-info1 skip
      502             "Ошибка при закрытии переоценки" skip
      503             "Несовпадают текущие количества по корневому признаку" skip
      504             "и количество признака в переоценке" skip
      505             "Переоценка" v-doc-num skip
      506             "Артикул" p-artic p-prod-type p-prod-code skip
      507             "Код признака" buf_temp-prt-obj.prt-code skip
      508             "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
      509             "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      510             view-as alert-box error .
      511           undo, return error .
      512         end.
      513       end.
      514       assign
      515         v-total-fact-sale = v-total-fact-sale
      516                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      517       .
      518       if v-total-fact-sale = ?
      519       then do:
      520         message
      521           vss-workfile vss-revision vss-description skip
      522           vss-include-info1 skip
      523           "Ошибка при вычислении суммы в продажных ценах" skip
      524           "Получено неопределенное значение" skip
      525           "Переоценка" v-doc-num skip
      526           "Артикул" p-artic p-prod-type p-prod-code skip
      527           "Код признака" buf_temp-prt-obj.prt-code skip
      528           "Сумма в продажных ценах" v-total-fact-sale skip
      529           view-as alert-box error .
      530         undo, return error .
      531       end.
      532       define variable v-old-fact-qnty     as decimal   no-undo .
      533       define variable v-old-fact-cli-qnty as decimal   no-undo .
      534       define variable v-old-fact-base     as decimal   no-undo .
      535       define variable v-old-fact-rubl     as decimal   no-undo .
      536       define variable v-old-fact-sale     as decimal   no-undo .
      537       assign
