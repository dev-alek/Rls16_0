      458                                     + buf_temp-prt-obj.fact-qnty
      459               v-total-fact-sale = v-total-fact-sale
      460                                 + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      461             .
      462           end.
      463           if p-check-price-list = true
      464           then do:
      465             if buf_temp-prt-obj.price-list-recid = ?
      466             or buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.price-list-qnty
      467             then do:
      468             end.
      469             else do:
      470               message
      471                 vss-workfile vss-revision vss-description skip
      472                 vss-include-info1 skip
