      616   procedure prdoclib-clear-temp-prt-obj :
      617     define buffer buf_temp-prt-obj for temp-prt-obj .
      618     do
      619     on error undo, return error return-value
      620     :
      621       for each buf_temp-prt-obj
      622       on error undo, return error return-value
      623       :
      624         delete buf_temp-prt-obj .
      625       end.
      626     end.
      627   end procedure.
      628   procedure prdoclib-create-temp-prt-obj :
      629     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
      630     define parameter buffer buf_prt-obj       for ub.prt-obj .
      631     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      632     define buffer buf_gds-prt for ub.gds-prt .
      633     do
      634     on error undo, return error return-value
      635     :
      636       find first buf_temp-prt-obj
      637         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
      638         no-error .
      639       if not available buf_temp-prt-obj
      640       then do:
      641         create buf_temp-prt-obj .
      642         assign
      643           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
      644           buf_temp-prt-obj.price-sale       = ?
      645           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
      646           buf_temp-prt-obj.price-list-qnty  = ?
      647           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
      648           buf_temp-prt-obj.price-list-recid = ?
      649         .
      650         find first buf_gds-prt no-lock
      651           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      652           .
      653         assign
      654           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      655         .
      656         if buf_temp-prt-obj.is-term
      657         then do:
      658           assign
      659             buf_temp-prt-obj.price-sale = p-root-price-sale
      660           .
      661         end.
      662       end.
      663     end.
      664   end procedure.
      665   procedure prdoclib-temp-prt-obj-by-prt-root :
      666     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
      667     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      668     define buffer buf_gds-prt for ub.gds-prt .
      669     do
      670     on error undo, return error return-value
      671     :
      672       find first buf_temp-prt-obj
      673         where buf_temp-prt-obj.prt-code = p-prt-code
      674         no-error .
      675       if not available buf_temp-prt-obj
      676       then do:
      677         create buf_temp-prt-obj .
      678         assign
      679           buf_temp-prt-obj.prt-code         = p-prt-code
      680           buf_temp-prt-obj.price-sale       = ?
      681           buf_temp-prt-obj.fact-qnty        = 0
      682           buf_temp-prt-obj.price-list-qnty  = ?
      683           buf_temp-prt-obj.prt-obj-recid    = ?
      684           buf_temp-prt-obj.price-list-recid = ?
      685         .
      686         find first buf_gds-prt no-lock
      687           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      688           .
      689         assign
      690           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      691         .
      692         if buf_temp-prt-obj.is-term
      693         then do:
      694           assign
      695             buf_temp-prt-obj.price-sale = 0
      696           .
      697         end.
      698       end.
      699     end.
      700   end procedure.
      701   procedure prdoclib-init-temp-prt-obj :
      702     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
      703     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
      704     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
      705     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
      706     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
      707     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
      708     define buffer buf_prt-obj      for ub.prt-obj .
      709     define buffer buf_temp-prt-obj for temp-prt-obj .
      710     do
      711     on error undo, return error return-value
      712     :
      713       run prdoclib-clear-temp-prt-obj in this-procedure .
      714       for each buf_prt-obj
      715         where buf_prt-obj.obj-type  = p-obj-type
      716           and buf_prt-obj.obj-code  = p-obj-code
      717           and buf_prt-obj.artic     = p-artic
      718           and buf_prt-obj.prod-type = p-prod-type
      719           and buf_prt-obj.prod-code = p-prod-code
      720       on error undo, return error return-value
      721       :
      722         run prdoclib-create-temp-prt-obj in this-procedure
      723           (input  p-root-price-sale
      724           ,buffer buf_prt-obj
      725           ,buffer buf_temp-prt-obj
      726           ).
      727       end.
      728     end.
      729   end procedure.
      730   procedure prdoclib-calc-fact-sale :
      731     define input  parameter p-price-list-recid   as recid     no-undo .
      732     define output parameter p-fact-qnty          as decimal   no-undo .
      733     define output parameter p-cur-base           as decimal   no-undo .
      734     define output parameter p-cur-VAT-base       as decimal   no-undo .
      735     define output parameter p-cur-SLT-base       as decimal   no-undo .
      736     define output parameter p-cur-road-tax-base  as decimal   no-undo .
      737     define output parameter p-cur-excise-base    as decimal   no-undo .
      738     define buffer buf_main_price-list for ub.price-list .
      739     define buffer buf_price-list      for ub.price-list .
      740     define buffer buf_goods           for ub.goods .
      741     define buffer buf_gds-obj         for ub.gds-obj .
      742     define buffer buf_bar-code        for ub.bar-code .
      743     define variable l-empty-scale   as logical   no-undo .
      744     do
      745     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
      746     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
      747     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
      748     :
      749       find first buf_main_price-list no-lock
      750         where recid(buf_main_price-list) = p-price-list-recid
      751         no-error .
      752       if not available buf_main_price-list
      753       then do:
      754         message
      755           vss-workfile vss-revision vss-description skip
      756           vss-include-info1 skip
      757           "Ошибка задания входных параметров" skip
      758           "Не найдена строка переоценки" skip
      759           "Код записи (recid)" p-price-list-recid skip
      760           view-as alert-box error .
      761         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
      762       end.
      763       if buf_main_price-list.main-price <> true
      764       then do:
      765         message
      766           vss-workfile vss-revision vss-description skip
      767           vss-include-info1 skip
      768           "Ошибка задания входных параметров" skip
      769           "Строка переоценки не является основной" skip
      770           "Код записи (recid)" p-price-list-recid skip
      771           "Переоценка" buf_main_price-list.doc-num skip
      772           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      773           "Бар-код" buf_main_price-list.b-code skip
      774           view-as alert-box error .
      775         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
      776       end.
      777       find first buf_goods no-lock
      778         where buf_goods.artic     = buf_main_price-list.artic
      779           and buf_goods.prod-type = buf_main_price-list.prod-type
      780           and buf_goods.prod-code = buf_main_price-list.prod-code
      781         no-error .
      782       if not available buf_goods
      783       then do:
      784         message
      785           vss-workfile vss-revision vss-description skip
      786           vss-include-info1 skip
      787           "Не найден товар" skip
      788           "Переоценка" buf_main_price-list.doc-num skip
      789           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      790           view-as alert-box error .
      791         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      792       end.
      793   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      795     (input  buf_main_price-list.artic
