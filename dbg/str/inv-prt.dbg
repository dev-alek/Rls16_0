     1780             ,output vat-rubl-buyer-prl
     1781             ,output slt-base-sale-prl
     1782             ,output slt-rubl-sale-prl
     1783             ,output road-tax-base-sale-prl
     1784             ,output road-tax-rubl-sale-prl
     1785             ,output excise-base-sale-prl
     1786             ,output excise-rubl-sale-prl
     1787             ,output discnt-base-sale-prl
     1788             ,output discnt-rubl-sale-prl
     1789             ) no-error .
     1790           if error-status :error
     1791           then do:
     1792             message
     1793               vss-workfile vss-revision vss-description skip
     1794               "Ошибка при вызове процеды prl-vat" skip
     1795               "Объект" p-obj-type p-obj-code skip
     1796               "Код товара" p-gds-code skip
     1797               "Указатель на запись переоценки" parrecid-prl skip
     1798               error-status :get-message(1) skip
     1799               return-value skip
     1800               view-as alert-box error .
     1801             undo, return error .
     1802           end.
     1803         end.
     1804         else do:
     1805           assign
     1806             price-rubl-with-tax-sale-prl    = 0
     1807             price-base-with-tax-sale-prl    = 0
     1808             price-rubl-without-tax-sale-prl = 0
     1809             price-base-without-tax-sale-prl = 0
     1810             vat-base-sale-prl               = 0
     1811             vat-rubl-sale-prl               = 0
     1812             slt-base-sale-prl               = 0
     1813             slt-rubl-sale-prl               = 0
     1814             road-tax-base-sale-prl          = 0
     1815             road-tax-rubl-sale-prl          = 0
     1816             excise-base-sale-prl            = 0
     1817             excise-rubl-sale-prl            = 0
     1818             discnt-base-sale-prl            = 0
     1819             discnt-rubl-sale-prl            = 0
     1820           .
