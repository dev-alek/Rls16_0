     2466   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
     2467   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
     2468   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
