      831           end.
      832         end.
      833       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
      834       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
      835       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
      836       define variable price-base-without-tax-sale-prl as decimal   no-undo .
      837       define variable vat-base-sale-prl               as decimal   no-undo .
      838       define variable vat-rubl-sale-prl               as decimal   no-undo .
      839       define variable vat-base-buyer-prl              as decimal   no-undo .
      840       define variable vat-rubl-buyer-prl              as decimal   no-undo .
      841       define variable slt-base-sale-prl               as decimal   no-undo .
      842       define variable slt-rubl-sale-prl               as decimal   no-undo .
      843       define variable road-tax-base-sale-prl          as decimal   no-undo .
      844       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
      845       define variable excise-base-sale-prl            as decimal   no-undo .
      846       define variable excise-rubl-sale-prl            as decimal   no-undo .
      847       define variable discnt-base-sale-prl            as decimal   no-undo .
      848       define variable discnt-rubl-sale-prl            as decimal   no-undo .
      849       if buf_main_price-list.doc-qnty <> 0
      850       then do:
      851         run prl-vat in this-procedure
      852           (input  recid(buf_main_price-list)
      853           ,output price-rubl-with-tax-sale-prl
      854           ,output price-base-with-tax-sale-prl
      855           ,output price-rubl-without-tax-sale-prl
      856           ,output price-base-without-tax-sale-prl
      857           ,output vat-base-sale-prl
      858           ,output vat-rubl-sale-prl
      859           ,output vat-base-buyer-prl
      860           ,output vat-rubl-buyer-prl
      861           ,output slt-base-sale-prl
      862           ,output slt-rubl-sale-prl
      863           ,output road-tax-base-sale-prl
      864           ,output road-tax-rubl-sale-prl
      865           ,output excise-base-sale-prl
      866           ,output excise-rubl-sale-prl
      867           ,output discnt-base-sale-prl
      868           ,output discnt-rubl-sale-prl
      869           ) no-error .
      870         if error-status :error
      871         then do:
      872           message
      873             vss-workfile vss-revision vss-description skip
      874             vss-include-info1 skip
      875             "Ошибка при вызове процеды prl-vat" skip
      876             "Документ" buf_main_price-list.doc-num skip
      877             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      878             error-status :get-message(1) skip
      879             return-value skip
      880             view-as alert-box error .
      881           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      882         end.
      883       end.
      884       else do:
      885         assign
      886           price-rubl-with-tax-sale-prl    = 0
      887           price-base-with-tax-sale-prl    = 0
      888           price-rubl-without-tax-sale-prl = 0
      889           price-base-without-tax-sale-prl = 0
      890           vat-base-sale-prl               = 0
      891           vat-rubl-sale-prl               = 0
      892           vat-base-buyer-prl              = 0
      893           vat-rubl-buyer-prl              = 0
      894           slt-base-sale-prl               = 0
      895           slt-rubl-sale-prl               = 0
      896           road-tax-base-sale-prl          = 0
      897           road-tax-rubl-sale-prl          = 0
      898           excise-base-sale-prl            = 0
      899           excise-rubl-sale-prl            = 0
      900           discnt-base-sale-prl            = 0
      901           discnt-rubl-sale-prl            = 0
      902         .
      903       end.
      904       define variable v-curr-r-b as character no-undo .
