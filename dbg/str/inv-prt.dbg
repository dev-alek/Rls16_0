     2473   procedure get-ptrl-prop :
     2474     define input  parameter p-obj-type as character no-undo .
     2475     define input  parameter p-obj-code as integer   no-undo .
     2476     do
     2477     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2478     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     2479     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     2480     :
     2481       define variable par-type          as character no-undo.
     2482       define variable v-value-character as character no-undo .
     2483       define variable v-value-date      as date      no-undo .
     2484       define variable v-value-decimal   as decimal   no-undo .
     2485       define variable v-value-integer   as integer   no-undo .
     2486       define variable v-value-logical   as logical   no-undo .
     2487       for each thbjattr_thbj-attr
     2488       :
     2489         delete thbjattr_thbj-attr .
     2490       end.
     2491       run adm/shattri.p
     2492         ( input "get":U
     2493         , input p-obj-type
     2494         , input p-obj-code
     2495         , input 'petrol':U
     2496         , input  ""
     2497         , output v-value-character
     2498         , output v-value-date
     2499         , output v-value-decimal
     2500         , output v-value-integer
     2501         , output v-value-logical
     2502         , output par-type
     2503         , input-output table thbjattr_thbj-attr
     2504         ) no-error .
     2505       for each thbjattr_thbj-attr
     2506       on error undo, return error return-value
     2507       :
     2508         case thbjattr_thbj-attr.prop-code :
     2509           when 'denstclc':U then do:
     2510             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     2511               assign
     2512                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     2513               .
     2514             end.
     2515           end.
     2516           when 'expptrl':U then do:
     2517             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     2518               and thbjattr_thbj-attr.prop-value-type = 'character':U
     2519             then do:
     2520               assign
     2521                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     2522               .
     2523             end.
     2524           end.
     2525           when 'inpptrl':U then do:
     2526             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     2527               and thbjattr_thbj-attr.prop-value-type = 'character':U
     2528             then do:
     2529               assign
     2530                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     2531               .
     2532             end.
     2533           end.
     2534           when 'autopump':U then do:
     2535             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2536               assign
     2537                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     2538               .
     2539             end.
     2540           end.
     2541           when 'rvsnmter':U then do:
     2542             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2543               assign
     2544                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     2545               .
     2546             end.
     2547           end.
     2548           when 'avtinvpm':U then do:
     2549             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2550               assign
     2551                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     2552               .
     2553             end.
     2554           end.
     2555           when 'invclipt':U then do:
     2556             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2557               assign
     2558                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     2559               .
     2560             end.
     2561           end.
     2562           when 'olddens':U then do:
     2563             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2564               assign
     2565                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     2566               .
     2567             end.
     2568           end.
     2569           when 'algrvspt':U then do:
     2570             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2571               assign
     2572                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
     2573               .
     2574             end.
     2575           end.
     2576           when 'temp-for-pomi':U then do:
     2577             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2578               assign
     2579                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     2580               .
     2581             end.
     2582           end.
     2583           when 'algoincome':U then do:
     2584             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2585               assign
     2586                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
     2587               .
     2588             end.
     2589           end.
     2590           when 'mand-choice-autocar':U then do:
     2591             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2592               assign
     2593                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
     2594               .
     2595             end.
     2596           end.
     2597           when 'block-nozzle':U then do:
     2598             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2599               assign
     2600                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
     2601               .
     2602             end.
     2603           end.
     2604           when 'timeout-block-nozzle':U then do:
     2605             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2606               assign
     2607                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
     2608               .
     2609             end.
     2610           end.
     2611           when 'Delta-mass-horiz':U then do:
     2612             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     2613               assign
     2614                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
     2615               .
     2616             end.
     2617           end.
     2618           when 'Delta-mass-vert':U then do:
     2619             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     2620               assign
     2621                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
     2622               .
     2623             end.
     2624           end.
     2625           when 'calc-free-vol':U then do:
     2626             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2627               assign
     2628                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     2629               .
     2630             end.
     2631           end.
     2632           when 'calc-free-vol-sug':U then do:
     2633             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2634               assign
     2635                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     2636               .
     2637             end.
     2638           end.
     2639           when 'trn-reas-sug':U then do:
     2640             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2641               assign
     2642                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     2643               .
     2644             end.
     2645           end.
     2646                 when 'rvd-own-nb':U then do:
     2647             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     2648               assign
     2649                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     2650               .
     2651             end.
     2652           end.
     2653           when 'qr-scan-time':U then do:
     2654             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2655               assign
     2656                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     2657               .
     2658             end.
     2659           end.
     2660           when 'autopump-skip-time':U then do:
     2661             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     2662               assign
     2663                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     2664               .
     2665             end.
     2666           end.
     2667         end case.
     2668         delete thbjattr_thbj-attr .
     2669       end.
     2670     end.
     2671     return .
     2672   end procedure.
     2673   define new shared temp-table tt-doc-pl no-undo
     2674   field pl-code as integer format "99999999999"
     2675   field pl-code2 as integer format "99999999999"
     2676   field whole-send-news like ub.doc-pl.whole-send-news
     2677   field obj-type like ub.doc-pl.obj-type
     2678   field obj-code like ub.doc-pl.obj-code
     2679   field out-code like ub.doc-pl.out-code
     2680   field fact-qnty like ub.doc-pl.fact-qnty
     2681   field doc-qnty like ub.doc-pl.doc-qnty
     2682   field gds-code as integer format "99999999999"
     2683   field cli-qnty like ub.doc-pl.cli-qnty
     2684   field cli-fact-qnty like ub.doc-pl.cli-fact-qnty
     2685   field cli-doc-qnty like ub.doc-pl.cli-doc-qnty
     2686   field rest-af-qnty like ub.doc-pl.rest-af-qnty
     2687   field cli-rest-af-qnty like ub.doc-pl.cli-rest-af-qnty
     2688   field rest-bf-qnty like ub.doc-pl.rest-bf-qnty
     2689   field cli-rest-bf-qnty like ub.doc-pl.cli-rest-bf-qnty
     2690   index pi obj-type obj-code pl-code out-code gds-code
     2691   index doc out-code gds-code obj-code obj-type pl-code
     2692   index gds-code gds-code
     2693   .
     2694   define buffer b-c-b for ub.bar-code.
     2695   DEFINE BUTTON b-exit AUTO-GO
     2696        LABEL "&Выход"
     2697        SIZE 10 BY 1.
     2698   DEFINE BUTTON b-alcmark
     2699        LABEL "&АлкМарк"
     2700        SIZE 10 BY 1.
     2701   DEFINE BUTTON b-help
     2702        LABEL "Помо&щь"
     2703        SIZE 8.75 BY 1.
     2704   DEFINE RECTANGLE RECT-1
     2705        EDGE-PIXELS 2 GRAPHIC-EDGE
     2706        SIZE 75.50 BY 5.50
     2707        BGCOLOR 8 .
     2708   DEFINE RECTANGLE RECT-2
     2709        EDGE-PIXELS 2 GRAPHIC-EDGE
     2710        SIZE 63.00 BY 3.00
     2711        BGCOLOR 8 .
     2712   DEFINE FRAME d-inv-prt
     2713     b-exit                    AT ROW  1 COL  2.00
     2714     b-alcmark                 AT ROW  2 COL  2.00
     2715     b-help                    AT ROW  1 COL  2.00
     2716     ub.doc-line.artic         AT ROW  2.00 COL 19.00 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS 11.63 BY 1.00
     2717     ub.goods.gds-name         AT ROW  2.00 COL 32.00 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS 41.00 BY 1.00 FGCOLOR 4
     2718     ub.doc-line.prod-code     AT ROW  3.00 COL 12.00 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS  6.00 BY 1.00
     2719     ub.doc-line.prod-type     AT ROW  3.00 COL 19.00 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS 11.63 BY 1.00
     2720     ub.clients.obj-name       AT ROW  3.00 COL 32.00 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS 41.00 BY 1.00 FGCOLOR 4
     2721     ub.doc-line.fact-qnty     AT ROW  5.00 COL 48.00 COLON-ALIGNED    LABEL "Разница по товару"
     2722                                                                             VIEW-AS FILL-IN SIZE-CHARS 14.00 BY 1.00
     2723     b-c-b.b-code              AT ROW  6.00 COL 20.00 COLON-ALIGNED    LABEL "Бар-код"
     2724                                                                             VIEW-AS FILL-IN SIZE-CHARS 10.00 BY 1.00 FGCOLOR 4
     2725     ub.gds-prt.f-name         AT ROW  6.00 COL 33.00 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS 25.00 BY 1.00 FGCOLOR 4
     2726     ub.gds-dtl.fact-qnty      AT ROW  7.50 COL 14.00 COLON-ALIGNED    LABEL "Стало"
     2727                                                                             VIEW-AS FILL-IN SIZE-CHARS 16.00 BY 1.00
     2728     ub.goods.unit-base        AT ROW  7.50 COL 32.50 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS  8.00 BY 1.00
     2729     ub.gds-dtl.doc-qnty       AT ROW  7.50 COL 50.00 COLON-ALIGNED    LABEL "Разница"
     2730                                                                             VIEW-AS FILL-IN SIZE-CHARS 16.00 BY 1.00
     2731     v-inv_peresort            AT ROW  8.50 COL 15.00 COLON-ALIGNED    LABEL "&Пересортица" FORMAT "->>>>>>>>>>9.<<<"
     2732                                                                             VIEW-AS FILL-IN SIZE-CHARS 16.00 BY 1.00
     2733     ub.doc-line.doc-density   AT ROW  8.75 COL 14.00 COLON-ALIGNED    LABEL "Плотность" FORMAT ">>9.9999999999":U
     2734                                                                             VIEW-AS FILL-IN SIZE-CHARS 16.00 BY 1.00 FGCOLOR 4
     2735     ub.goods.unit-cli         AT ROW 10.00 COL 32.50 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE-CHARS  8.00 BY 1.00
     2736     ub.inv-line.wast-cli-qnty AT ROW 10.00 COL 14.00 COLON-ALIGNED    LABEL "Стало"
     2737                                                                             VIEW-AS FILL-IN SIZE-CHARS 16.00 BY 1.00
     2738     ub.doc-line.cli-qnty      AT ROW 10.00 COL 48.00 COLON-ALIGNED    LABEL "Разница"
     2739                                                                             VIEW-AS FILL-IN SIZE-CHARS 16.00 BY 1.00
     2740     RECT-2                    AT ROW  1.50 COL 13.00
     2741     RECT-1                    AT ROW  6.50 COL  1.50 SPACE( 0.58 )    SKIP( 0.54 )
     2742   WITH VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D SCROLLABLE DEFAULT-BUTTON b-exit.
     2743   ASSIGN FRAME d-inv-prt :SCROLLABLE = NO.
     2744   ON CHOOSE OF b-exit IN FRAME d-inv-prt
     2745   DO:
     2746   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2747   if lookup(self :type
     2748            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2749            ) = 0
     2750   then do:
     2751     message
     2752       "$Workfile$"
     2753       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2754       "Интерфейсный элемент" self :name  skip
     2755       "Тип" self :type  skip
     2756       "Процедура" this-procedure :file-name skip
     2757       view-as alert-box .
     2758   end.
     2759   else do:
     2760     apply "entry":u to self  .
     2761     if focus :handle <> self :handle  then do:
     2762       return no-apply .
     2763     end.
     2764   end.
     2765     IF prt-mode <> 'ПРОСМОТР':U THEN DO:
     2766       IF ub.gds-dtl.doc-qnty       :SENSITIVE        IN FRAME d-inv-prt THEN DO:
     2767         FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     2768         IF LOOKUP( 'шту':U, ub.units.type ) > 0 AND
     2769                     INPUT FRAME d-inv-prt ub.gds-dtl.doc-qnty - ub.gds-dtl.doc-qnty + ub.gds-dtl.fact-qnty      <>
     2770           TRUNCATE( INPUT FRAME d-inv-prt ub.gds-dtl.doc-qnty - ub.gds-dtl.doc-qnty + ub.gds-dtl.fact-qnty, 0 ) THEN DO:
     2771           MESSAGE "Данная разница выведет штучный товар в нецелое количество!" VIEW-AS ALERT-BOX ERROR.
     2772           APPLY "ENTRY":U TO ub.gds-dtl.doc-qnty       IN FRAME d-inv-prt.
     2773           RETURN NO-APPLY.
     2774         END.
     2775       END.
     2776       IF ub.gds-dtl.fact-qnty      :SENSITIVE        IN FRAME d-inv-prt THEN DO:
     2777         IF INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty < 0 THEN DO:
     2778           MESSAGE "Отрицательного количества товара не бывает !" VIEW-AS ALERT-BOX ERROR.
     2779           APPLY "ENTRY":U TO ub.gds-dtl.fact-qnty      IN FRAME d-inv-prt.
     2780           RETURN NO-APPLY.
     2781         END.
     2782         FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     2783         IF LOOKUP( 'шту':U, ub.units.type ) > 0 AND
     2784                      INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty      <>
     2785            TRUNCATE( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty, 0 ) THEN DO:
     2786           MESSAGE "Нельзя вводить дробное количество для штучного товара!" VIEW-AS ALERT-BOX ERROR.
     2787           APPLY "ENTRY":U TO ub.gds-dtl.fact-qnty      IN FRAME d-inv-prt.
     2788           RETURN NO-APPLY.
     2789         END.
     2790       END.
     2791       IF ub.inv-line.wast-cli-qnty :SENSITIVE        IN FRAME d-inv-prt THEN DO:
     2792         IF INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty < 0 THEN DO:
     2793           MESSAGE "Отрицательного количества товара не бывает !" VIEW-AS ALERT-BOX ERROR.
     2794           APPLY "ENTRY":U TO ub.inv-line.wast-cli-qnty IN FRAME d-inv-prt.
     2795           RETURN NO-APPLY.
     2796         END.
     2797       END.
     2798       IF ub.doc-line.doc-density       :SENSITIVE        IN FRAME d-inv-prt THEN DO:
     2799         if valid-density( INPUT FRAME d-inv-prt ub.doc-line.doc-density, (ub.goods.unit-base = ub.goods.unit-cli) ) <> true then do:
     2800           MESSAGE "Внимание!" SKIP
     2801                   "Неверное значение плотности для топлива:" INPUT FRAME d-inv-prt ub.doc-line.doc-density "." SKIP
     2802                   "Плотность топлива должна быть в диапазоне: больше 0 и меньше 1."
     2803           VIEW-AS ALERT-BOX ERROR TITLE " О Ш И Б К А ! ! ! ".
     2804           APPLY "ENTRY":U TO ub.doc-line.doc-density     IN FRAME d-inv-prt.
     2805           RETURN NO-APPLY.
     2806         END.
     2807       END.
     2808       assign
     2809         ub.doc-line.doc-density
     2810         ub.doc-line.cli-qnty
     2811       .
     2812       if ub.inv-line.wast-cli-qnty :sensitive in frame d-inv-prt then do:
     2813         assign
     2814           ub.inv-line.wast-cli-qnty
     2815         .
     2816       end.
     2817       assign
     2818         ub.doc-line.fact-density = ub.doc-line.doc-density
     2819       .
     2820       if v-inv-prsr = "yes" then  do:
     2821         assign frame d-inv-prt  v-inv_peresort .
     2822         ub.doc-line.inv-peresort = v-inv_peresort  .
     2823       end.
     2824     END.
     2825   END.
     2826   on leave of b-alcmark IN FRAME d-inv-prt
     2827   do:
     2828   end.
     2829   on leave of v-inv_peresort IN FRAME d-inv-prt
     2830   do:
     2831     assign frame d-inv-prt  v-inv_peresort.
     2832     if prt-mode = 'ШКАЛА':U then do:
     2833         if (ub.doc-line.doc-qnty ) < v-inv_peresort then do:
     2834           message "Значение по пересортице должно быть меньше " ub.doc-line.doc-qnty view-as alert-box information .
     2835           return no-apply .
     2836         end.
     2837     end.
     2838     else do:
     2839     if (INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty ) < v-inv_peresort then do:
     2840       message "Значение по пересортице должно быть меньше " (INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty) view-as alert-box information .
     2841       return no-apply .
     2842     end.
     2843     end.
     2844   end.
     2845   ON LEAVE OF ub.gds-dtl.doc-qnty IN FRAME d-inv-prt
     2846   DO:
     2847     FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     2848     IF LOOKUP( 'шту':U, ub.units.type ) > 0 AND
     2849                  INPUT FRAME d-inv-prt ub.gds-dtl.doc-qnty - ub.gds-dtl.doc-qnty + ub.gds-dtl.fact-qnty      <>
     2850        TRUNCATE( INPUT FRAME d-inv-prt ub.gds-dtl.doc-qnty - ub.gds-dtl.doc-qnty + ub.gds-dtl.fact-qnty, 0 ) THEN DO:
     2851       MESSAGE "Данная разница выведет штучный товар в нецелое количество!" VIEW-AS ALERT-BOX ERROR.
     2852       RETURN NO-APPLY.
     2853     END.
     2854   END.
     2855   ON LEAVE OF ub.gds-dtl.fact-qnty IN FRAME d-inv-prt
     2856   DO:
     2857     IF INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty < 0 THEN DO:
     2858       MESSAGE "Отрицательного количества товара не бывает !" VIEW-AS ALERT-BOX ERROR.
     2859       RETURN NO-APPLY.
     2860     END.
     2861     FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     2862     IF LOOKUP( 'шту':U, ub.units.type ) > 0 AND
     2863        INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty <> TRUNCATE( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty, 0 )
     2864     THEN DO:
     2865       MESSAGE "Нельзя вводить дробное количество для штучного товара!" VIEW-AS ALERT-BOX ERROR.
     2866       RETURN NO-APPLY.
     2867     END.
     2868     DISPLAY
     2869       ( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty        -
     2870                                   ub.gds-dtl.fact-qnty        +
     2871                                   ub.gds-dtl.doc-qnty         ) @ ub.gds-dtl.doc-qnty
     2872     WITH FRAME d-inv-prt.
     2873     IF ptrlprop-expptrl <> ? THEN DO:
     2874       DISPLAY
     2875         ( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty        *
     2876           INPUT FRAME d-inv-prt ub.doc-line.doc-density         ) @ ub.inv-line.wast-cli-qnty
     2877         ( INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty   -
     2878                                     ub.inv-line.before-cli-qnty ) @ ub.doc-line.cli-qnty
     2879       WITH FRAME d-inv-prt.
     2880     END.
     2881   END.
     2882   ON LEAVE OF ub.inv-line.wast-cli-qnty IN FRAME d-inv-prt
     2883   DO:
     2884     IF INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty < 0 THEN DO:
     2885       MESSAGE "Отрицательного количества товара не бывает !" VIEW-AS ALERT-BOX ERROR.
     2886       RETURN NO-APPLY.
     2887     END.
     2888     FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = ub.goods.unit-base.
     2889     IF ptrlprop-expptrl <> ? THEN DO:
     2890       DISPLAY
     2891         ( INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty   /
     2892           INPUT FRAME d-inv-prt ub.doc-line.doc-density         ) @ ub.gds-dtl.fact-qnty
     2893         ( INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty   -
     2894                                     ub.inv-line.before-cli-qnty ) @ ub.doc-line.cli-qnty
     2895       WITH FRAME d-inv-prt.
     2896     END.
     2897     DISPLAY
     2898       ( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty        -
     2899                                   ub.gds-dtl.fact-qnty        +
     2900                                   ub.gds-dtl.doc-qnty         ) @ ub.gds-dtl.doc-qnty
     2901     WITH FRAME d-inv-prt.
     2902   END.
     2903   ON LEAVE OF ub.doc-line.doc-density IN FRAME d-inv-prt
     2904   DO:
     2905     IF ptrlprop-expptrl = ? THEN DO: RETURN. END.
     2906     if valid-density( INPUT FRAME d-inv-prt ub.doc-line.doc-density, (ub.goods.unit-base = ub.goods.unit-cli) ) <> true then do:
     2907       MESSAGE "Внимание!" SKIP
     2908               "Неверное значение плотности для топлива:" INPUT FRAME d-inv-prt ub.doc-line.doc-density "." SKIP
     2909               "Плотность топлива должна быть в диапазоне: больше 0 и меньше 1."
     2910       VIEW-AS ALERT-BOX ERROR TITLE " О Ш И Б К А ! ! ! ".
     2911       APPLY "ENTRY":U TO ub.doc-line.doc-density IN FRAME d-inv-prt.
     2912       RETURN NO-APPLY.
     2913     END.
     2914     IF ptrlprop-expptrl = 'weight':U THEN DO:
     2915         DISPLAY
     2916           ( INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty /
     2917             INPUT FRAME d-inv-prt ub.doc-line.doc-density       ) @ ub.gds-dtl.fact-qnty
     2918           ( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty      -
     2919                                       ub.gds-dtl.fact-qnty      +
     2920                                       ub.gds-dtl.doc-qnty       ) @ ub.gds-dtl.doc-qnty
     2921         WITH FRAME d-inv-prt.
     2922     END.
     2923     ELSE DO:
     2924       DISPLAY
     2925         ( INPUT FRAME d-inv-prt ub.gds-dtl.fact-qnty        *
     2926           INPUT FRAME d-inv-prt ub.doc-line.doc-density         ) @ ub.inv-line.wast-cli-qnty
     2927         ( INPUT FRAME d-inv-prt ub.inv-line.wast-cli-qnty   -
     2928                                     ub.inv-line.before-cli-qnty ) @ ub.doc-line.cli-qnty
     2929       WITH FRAME d-inv-prt.
     2930     END.
     2931   END.
     2932   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-inv-prt:PARENT eq ?
     2933   THEN FRAME d-inv-prt:PARENT = ACTIVE-WINDOW.
     2934   ON WINDOW-CLOSE OF FRAME d-inv-prt APPLY "END-ERROR":U TO SELF.
     2935   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2936   on help of frame d-inv-prt
     2937   do:
     2938     run gbl/app_help.p
     2939       (input this-procedure :file-name
     2940       ,input ''
     2941       ,input ?
     2942       ) no-error.
     2943     if error-status :error then do:
     2944       message
     2945         "Ошибка при вызове помощи"
     2946         error-status :get-message(1)
     2947         view-as alert-box .
     2948     end.
     2949   end.
     2950   run minbtn-set in this-procedure .
     2951   on choose of b-help in frame d-inv-prt
     2952   do:
     2953     apply "help":u to frame d-inv-prt .
     2954   end.
     2955   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2956   procedure minbtn-set :
     2957       do
     2958           on error undo, return error return-value
     2959           :
     2960           define variable ii              as integer       no-undo .
     2961           define variable fh              as widget-handle no-undo .
     2962           define variable hh              as widget-handle no-undo .
     2963           define variable v-h             as handle        extent 4 no-undo .
     2964           define variable v-name-button   as character     no-undo .
     2965           define variable v-help-old-x    as decimal       no-undo .
     2966           define variable v-help-old-y    as decimal       no-undo .
     2967           define variable v-help-old-size as decimal       no-undo .
     2968           define variable v-frame-width   as decimal       no-undo .
     2969           define variable jj              as integer       no-undo .
     2970           do
     2971               on error undo, return error
     2972               :
     2973               assign
     2974                   v-frame-width = frame d-inv-prt:width - 0.3
     2975                   fh            = frame d-inv-prt:first-child
     2976                   hh            = fh:first-child
     2977                   ii            = 1
     2978                   .
     2979               do while valid-handle(hh):
     2980                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2981                   do:
     2982                       case lc(hh:name) :
     2983                           when "b-help" then
     2984                               do:
     2985                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2986                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2987                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2988                                   hh:TOOLTIP = "Помощь" .
     2989                                   v-help-old-x = hh:column .
     2990                                   v-help-old-y = hh:row    .
     2991                                   v-help-old-size = hh:width .
     2992                                   hh:width-chars = 2.5 .
     2993                               end.
     2994                           when "b-print" then
     2995                               do:
     2996                                   hh:load-image("cmp/b-print.bmp":u) .
     2997                                   hh:TOOLTIP = "Печать" .
     2998                                   v-h[ii] = hh:handle .
     2999                                   ii = ii + 1 .
     3000                                   hh:width-chars = 3 .
     3001                               end.
     3002                           when "b-history" or
     3003                           when "b-hist" then
     3004                               do:
     3005                                   hh:load-image("cmp/b-hist.bmp":u) .
     3006                                   hh:TOOLTIP = "История" .
     3007                                   v-h[ii] = hh:handle .
     3008                                   ii = ii + 1 .
     3009                                   hh:width-chars = 3 .
     3010                               end.
     3011                           when "b-sch" then
     3012                               do:
     3013                                   hh:load-image("cmp/b-sch.bmp":u) .
     3014                                   hh:TOOLTIP = "Установка Фильтра" .
     3015                                   v-h[ii] = hh:handle .
     3016                                   ii = ii + 1 .
     3017                                   hh:width-chars = 3 .
     3018                               end.
     3019                           when "b-hist-user" then
     3020                               do:
     3021                                   hh:load-image("cmp/b-hist.bmp":u) .
     3022                                   hh:TOOLTIP = "История пользователя" .
     3023                                   ii = ii + 1 .
     3024                               end.
     3025                       end case.
     3026                   end.
     3027                   hh = hh:next-sibling.
     3028               end.
     3029               b-help:column = v-frame-width - b-help:width-chars.
     3030               jj = 0.
     3031               repeat ii = 4 to 1 by -1 :
     3032                   if valid-handle (v-h[ii] ) then
     3033                   do:
     3034                       jj  = jj + 1 .
     3035                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3036                       v-h[ii]:row    = v-help-old-y .
     3037                   end.
     3038               end.
     3039           end.
     3040       end.
     3041   end procedure.
     3042   MAIN-BLOCK:
     3043   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3044      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK :
     3045     define variable chg-qnty      like ub.gds-dtl.fact-qnty no-undo initial ?.
     3046     define variable v-err-msg     as character no-undo .
     3047     define variable old-pl-qnty   as decimal no-undo.
     3048     define variable new-pl-qnty   as decimal no-undo.
     3049     define variable v-count-place as integer   no-undo .
     3050     define buffer buf_doc-pl for ub.doc-pl .
     3051     for each tt-doc-pl
