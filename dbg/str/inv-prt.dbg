      906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      907     (output v-curr-r-b
      908     )  .
      909       if v-curr-r-b = 'base':U
      910       then do:
      911         assign
      912           p-fact-qnty         = buf_main_price-list.doc-qnty
      913           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
      914           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
      915           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
      916           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
      917           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
      918         .
      919       end.
      920       else do:
      921         assign
      922           p-fact-qnty         = buf_main_price-list.doc-qnty
      923           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
      924           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
      925           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
      926           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
      927           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
      928         .
      929       end.
      930         define variable v-unit-base like ub.goods.unit-base no-undo .
      931   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
      933     (input  buf_goods.gds-code
      934     ,output v-unit-base
      935     ) no-error .
      936         if error-status :error
      937         then do:
      938           message
      939             vss-workfile vss-revision vss-description skip
      940             vss-include-info1 skip
      941             "Ошибка при определении базовой единицы измерения товара" skip
      942             "Код товара" buf_goods.gds-code skip
      943             error-status :get-message(1) skip
      944             return-value skip
      945             view-as alert-box error .
      946           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      947         end.
      948         for each buf_price-list no-lock
      949           where buf_price-list.doc-num    = buf_main_price-list.doc-num
      950             and buf_price-list.main-price = false
      951             and buf_price-list.artic      = buf_main_price-list.artic
      952             and buf_price-list.prod-type  = buf_main_price-list.prod-type
      953             and buf_price-list.prod-code  = buf_main_price-list.prod-code
      954         :
      955           if buf_price-list.doc-qnty = ?
      956           then do:
      957             find first buf_bar-code no-lock
      958               where buf_bar-code.b-code = buf_price-list.b-code
      959               no-error .
      960             if available buf_bar-code
      961             and buf_bar-code.unit-cli = v-unit-base
      962             then do:
      963               message
      964                 vss-workfile vss-revision vss-description skip
      965                 vss-include-info1 skip
      966                 "Ошибка при закрытии переоценки" skip
      967                 "Не задано количество для бар-кода с основной единицей измерения" skip
      968                 "Переоценка" buf_main_price-list.doc-num skip
      969                 "Бар-код" buf_price-list.b-code skip
      970                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
      971                 "Количество" buf_price-list.doc-qnty skip
      972                 "Основная единица измерения" v-unit-base skip
      973                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
      974                 view-as alert-box error .
      975               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      976             end.
      977             next .
      978           end.
      979           if not can-find
      980             (first buf_bar-code
      981             where buf_bar-code.b-code = buf_price-list.b-code
      982             )
      983           then do:
      984             message
      985               vss-workfile vss-revision vss-description skip
      986               vss-include-info1 skip
      987               "В переоценке задан несуществующий бар-код" skip
      988               "Переоценка" buf_price-list.doc-num skip
      989               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
      990               "Бар-код" buf_price-list.b-code skip
      991               view-as alert-box error .
      992             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
      993           end.
      994           if buf_price-list.doc-qnty <> 0
      995           then do:
      996             run prl-vat in this-procedure
      997               (input  recid(buf_price-list)
      998               ,output price-rubl-with-tax-sale-prl
      999               ,output price-base-with-tax-sale-prl
     1000               ,output price-rubl-without-tax-sale-prl
     1001               ,output price-base-without-tax-sale-prl
     1002               ,output vat-base-sale-prl
     1003               ,output vat-rubl-sale-prl
     1004               ,output vat-base-buyer-prl
     1005               ,output vat-rubl-buyer-prl
     1006               ,output slt-base-sale-prl
     1007               ,output slt-rubl-sale-prl
     1008               ,output road-tax-base-sale-prl
     1009               ,output road-tax-rubl-sale-prl
     1010               ,output excise-base-sale-prl
     1011               ,output excise-rubl-sale-prl
     1012               ,output discnt-base-sale-prl
     1013               ,output discnt-rubl-sale-prl
     1014               ) no-error .
     1015             if error-status :error
     1016             then do:
     1017               message
     1018                 vss-workfile vss-revision vss-description skip
     1019                 vss-include-info1 skip
     1020                 "Ошибка при вызове процеды prl-vat" skip
     1021                 "Документ" buf_price-list.doc-num skip
     1022                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1023                 error-status :get-message(1) skip
     1024                 return-value skip
     1025                 view-as alert-box error .
     1026               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1027             end.
     1028           end.
     1029           else do:
     1030             assign
     1031               price-rubl-with-tax-sale-prl    = 0
     1032               price-base-with-tax-sale-prl    = 0
     1033               price-rubl-without-tax-sale-prl = 0
     1034               price-base-without-tax-sale-prl = 0
     1035               vat-base-sale-prl               = 0
     1036               vat-rubl-sale-prl               = 0
     1037               vat-base-buyer-prl              = 0
     1038               vat-rubl-buyer-prl              = 0
     1039               slt-base-sale-prl               = 0
     1040               slt-rubl-sale-prl               = 0
     1041               road-tax-base-sale-prl          = 0
     1042               road-tax-rubl-sale-prl          = 0
     1043               excise-base-sale-prl            = 0
     1044               excise-rubl-sale-prl            = 0
     1045               discnt-base-sale-prl            = 0
     1046               discnt-rubl-sale-prl            = 0
     1047             .
     1048           end.
     1049           if v-curr-r-b = 'base':U
     1050           then do:
     1051             assign
     1052               p-fact-qnty         = p-fact-qnty
     1053                                   + buf_price-list.doc-qnty
     1054               p-cur-base          = p-cur-base
     1055                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1056               p-cur-VAT-base      = p-cur-VAT-base
     1057                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1058               p-cur-SLT-base      = p-cur-SLT-base
     1059                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1060               p-cur-road-tax-base = p-cur-road-tax-base
     1061                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1062               p-cur-excise-base   = p-cur-excise-base
     1063                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1064             .
     1065           end.
     1066           else do:
     1067             assign
     1068               p-fact-qnty         = p-fact-qnty
     1069                                   + buf_price-list.doc-qnty
     1070               p-cur-base          = p-cur-base
     1071                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1072               p-cur-VAT-base      = p-cur-VAT-base
     1073                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1074               p-cur-SLT-base      = p-cur-SLT-base
     1075                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1076               p-cur-road-tax-base = p-cur-road-tax-base
     1077                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1078               p-cur-excise-base   = p-cur-excise-base
     1079                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1080             .
     1081           end.
     1082         end.
     1083     end.
     1084   end procedure.
     1085   procedure prdoclib-calc-prc :
     1086     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1087     define input  parameter p-cons-pay        as   integer                no-undo.
     1088     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1089     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1090     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1091     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1092     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1093     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1094     do
     1095     on error undo, return error return-value
     1096     :
     1097       define buffer buf_price-doc       for ub.price-doc .
     1098       define buffer buf_price-list      for ub.price-list .
     1099       define buffer buf_parts           for ub.parts .
     1100       define variable v-ov-qnty     as decimal   no-undo .
     1101       define variable v-ov-base     as decimal   no-undo .
     1102       define variable v-ov-VAT-base as decimal   no-undo .
     1103       define variable v-ov-SLT-base as decimal   no-undo .
     1104       define variable v-cons-qnty   as decimal   no-undo .
     1105       define variable v-prch-qnty   as decimal   no-undo .
     1106       define variable v-cons-mult   as decimal   no-undo .
     1107       define variable v-prch-mult   as decimal   no-undo .
     1108       find first buf_price-doc no-lock
     1109         where recid(buf_price-doc) = p-price-doc-recid
     1110         no-error .
     1111       if not available buf_price-doc
     1112       then do:
     1113         message
     1114           vss-workfile vss-revision vss-description skip
     1115           vss-include-info1 skip
     1116           "Ошибка задания входных параметров" skip
     1117           "Не найден документ переоценки" skip
     1118           "Код записи (recid)" p-price-doc-recid skip
     1119           view-as alert-box error .
     1120         undo, return error .
     1121       end.
     1122       for each buf_price-list no-lock
     1123         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1124           and buf_price-list.main-price = true
     1125       on error undo, return error return-value
     1126       :
     1127         run prdoclib-calc-ov
     1128           (input recid(buf_price-list)
     1129           ,output v-ov-qnty
     1130           ,output v-ov-base
     1131           ,output v-ov-VAT-base
     1132           ,output v-ov-SLT-base
     1133           ) no-error .
     1134         if error-status :error
     1135         then do:
     1136           if error-status :get-message(1) <> ""
     1137           then do:
     1138             message
     1139               vss-workfile vss-revision vss-description skip
     1140               vss-include-info1 skip
     1141               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1142               error-status :get-message(1) skip
     1143               return-value skip
     1144               view-as alert-box error .
     1145           end.
     1146           undo, return error return-value .
     1147         end.
     1148         assign
     1149           v-cons-qnty = 0
     1150           v-prch-qnty = 0
     1151         .
     1152         for each buf_parts no-lock
     1153           where buf_parts.out-code  = buf_price-list.doc-num
     1154             and buf_parts.obj-type  = buf_price-list.obj-type
     1155             and buf_parts.obj-code  = buf_price-list.obj-code
     1156             and buf_parts.artic     = buf_price-list.artic
     1157             and buf_parts.prod-type = buf_price-list.prod-type
     1158             and buf_parts.prod-code = buf_price-list.prod-code
     1159         on error undo, return error return-value
     1160         :
     1161           if buf_parts.pay-code = p-cons-pay
     1162           then do:
     1163             assign
     1164               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1165             .
     1166           end.
     1167           else do:
     1168             assign
     1169               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1170             .
     1171           end.
     1172         end.
     1173         if (v-cons-qnty + v-prch-qnty) = 0
     1174         then do:
     1175           assign
     1176             v-cons-mult = 0
     1177             v-prch-mult = 1
     1178           .
     1179         end.
     1180         else do:
     1181           assign
     1182             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1183             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1184           .
     1185         end.
     1186         assign
     1187           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1188           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1189           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1190           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1191           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1192           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1193         .
     1194       end.
     1195     end.
     1196   end procedure.
     1197   procedure prdoclib-calc-ov :
     1198     define input  parameter p-price-list-recid as recid     no-undo .
     1199     define output parameter p-fact-qnty        as decimal   no-undo .
     1200     define output parameter p-ov-base          as decimal   no-undo .
     1201     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1202     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1203     do
     1204     on error undo, return error return-value
     1205     :
     1206       define buffer buf_main_price-list    for ub.price-list .
     1207       define buffer buf_prev_price-list    for ub.price-list .
     1208       define buffer buf_special_price-list for ub.price-list .
     1209       define buffer buf_goods              for ub.goods .
     1210       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1211       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1212       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1213       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1214       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1215       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1216       define variable v-prev-price-list-recid as   recid                  no-undo.
     1217       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1218       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1219       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1220       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1221       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1222       find first buf_main_price-list no-lock
     1223         where recid(buf_main_price-list) = p-price-list-recid
     1224         no-error .
     1225       if not available buf_main_price-list
     1226       then do:
     1227         message
     1228           vss-workfile vss-revision vss-description skip
     1229           vss-include-info1 skip
     1230           "Ошибка задания входных параметров" skip
     1231           "Не найдена строка переоценки" skip
     1232           "Код записи (recid)" p-price-list-recid skip
     1233           view-as alert-box error .
     1234         undo, return error .
     1235       end.
     1236       if buf_main_price-list.main-price <> true
     1237       then do:
     1238         message
     1239           vss-workfile vss-revision vss-description skip
     1240           vss-include-info1 skip
     1241           "Ошибка задания входных параметров" skip
     1242           "Строка переоценки не является основной" skip
     1243           "Код записи (recid)" p-price-list-recid skip
     1244           "Переоценка" buf_main_price-list.doc-num skip
     1245           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1246           "Бар-код" buf_main_price-list.b-code skip
     1247           view-as alert-box error .
     1248         undo, return error .
     1249       end.
     1250       run prdoclib-calc-fact-sale in this-procedure
     1251         (input  recid(buf_main_price-list)
     1252         ,output v-fact-qnty
     1253         ,output v-cur-base
     1254         ,output v-cur-VAT-base
     1255         ,output v-cur-SLT-base
     1256         ,output v-cur-road-tax-base
     1257         ,output v-cur-excise-base
     1258         ) no-error.
     1259       if error-status :error
     1260       then do:
     1261         message
     1262           vss-workfile vss-revision vss-description skip
     1263           vss-include-info1 skip
     1264           "Ошибка при расчете сумм переоценки." skip
     1265           "Документ переоценки" buf_main_price-list.doc-num skip
     1266           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1267           error-status :get-message(1) skip
     1268           return-value skip
     1269           view-as alert-box error .
     1270         undo, return error .
     1271       end.
     1272   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1274     (input  buf_main_price-list.obj-type
     1275     ,input  buf_main_price-list.obj-code
     1276     ,input  buf_main_price-list.b-code
     1277     ,input  buf_main_price-list.b-code
     1278     ,input  buf_main_price-list.fact-order
     1279     ,output v-prev-price-list-recid
     1280     ,output v-prev-cli-base-rate
     1281     ) no-error .
     1282       if error-status :error
     1283       then do:
     1284         message
     1285           vss-workfile vss-revision vss-description skip
     1286           vss-include-info1 skip
     1287           "Ошибка при поиске предыдущей переоценки." skip
     1288           "Документ переоценки " buf_main_price-list.doc-num skip
     1289           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1290           error-status :get-message(1) skip
     1291           return-value skip
     1292           view-as alert-box error .
     1293         undo, return error .
     1294       end.
     1295       if v-prev-price-list-recid <> ?
     1296       then do:
     1297         find first buf_prev_price-list no-lock
     1298           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1299           .
     1300         find first buf_special_price-list no-lock
     1301           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1302             and buf_special_price-list.main-price = false
     1303             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1304             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1305             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1306             and buf_special_price-list.doc-qnty   <> ?
     1307           no-error .
     1308         if available buf_special_price-list
     1309         then do:
     1310           message
     1311             "Товар имеет специальные цены на признаки" skip
     1312             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1313             "Переоценка" buf_prev_price-list.doc-num skip
     1314             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1315             view-as alert-box error .
     1316           undo, return error .
     1317         end.
     1318         find first buf_goods no-lock
     1319           where buf_goods.artic     = buf_main_price-list.artic
     1320             and buf_goods.prod-type = buf_main_price-list.prod-type
     1321             and buf_goods.prod-code = buf_main_price-list.prod-code
     1322           no-error .
     1323         if not available buf_goods
     1324         then do:
     1325           message
     1326             vss-workfile vss-revision vss-description skip
     1327             vss-include-info1 skip
     1328             "Не найден товар" skip
     1329             "Переоценка" buf_main_price-list.doc-num skip
     1330             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1331             view-as alert-box error .
     1332           undo, return error .
     1333         end.
     1334         if buf_prev_price-list.vat-pc = ?
     1335         or buf_prev_price-list.slt-pc = ?
     1336         then do:
     1337           message
     1338             "В переоценке не заданы налоги товара" skip
     1339             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1340             "Переоценка" buf_prev_price-list.doc-num skip
     1341             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1342             "НДС" buf_prev_price-list.vat-pc skip
     1343             "НП" buf_prev_price-list.slt-pc skip
     1344             view-as alert-box error .
     1345           undo, return error return-value .
     1346         end.
     1347         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1348         assign
     1349           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1350         .
     1351         assign
     1352           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1353           v-prev-cur-VAT-base = v-fact-qnty
     1354                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1355                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1356           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1357         .
     1358         assign
     1359           p-fact-qnty   = v-fact-qnty
     1360           p-ov-base     = v-cur-base     - v-prev-cur-base
     1361           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1362           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1363         .
     1364       end.
     1365       else do:
     1366         assign
     1367           v-prev-cur-base     = 0
     1368           v-prev-cur-VAT-base = 0
     1369           v-prev-cur-SLT-base = 0
     1370           .
     1371         assign
     1372           p-fact-qnty   = v-fact-qnty
     1373           p-ov-base     = v-cur-base     - v-prev-cur-base
     1374           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1375           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1376         .
     1377       end.
     1378     end.
     1379   end procedure.
     1380   procedure prdoclib-init-prt-obj-by-factord :
     1381     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1382     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1383     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1384     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1385     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1386     define input parameter p-fact-order         as decimal   no-undo .
     1387     define input parameter p-include-fact-order as logical   no-undo .
     1388     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1389     define buffer buf_gds-obj      for ub.gds-obj .
     1390     define buffer buf_doc-line     for ub.doc-line .
     1391     define buffer buf_temp-prt-obj for temp-prt-obj .
     1392     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1393     do
     1394     on error undo, return error return-value
     1395     :
     1396       do transaction
     1397       on error undo, return error return-value
     1398       :
     1399   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1401     (input  p-obj-type
     1402     ,input  p-obj-code
     1403     ,input  p-artic
     1404     ,input  p-prod-type
     1405     ,input  p-prod-code
     1406     ,buffer buf_gds-obj
     1407     ) no-error .
     1408         if error-status :error
     1409         then do:
     1410           message
     1411             vss-workfile vss-revision vss-description skip
     1412             vss-include-info1 skip
     1413             "Невозможно найти gds-obj" skip
     1414             error-status :get-message(1) skip
     1415             return-value skip
     1416             view-as alert-box error .
     1417           undo, return error .
     1418         end.
     1419         find current buf_gds-obj exclusive-lock .
     1420       end.
     1421       run prdoclib-init-temp-prt-obj in this-procedure
     1422         (input p-obj-type
     1423         ,input p-obj-code
     1424         ,input p-artic
     1425         ,input p-prod-type
     1426         ,input p-prod-code
     1427         ,input 0
     1428         ) .
     1429       for each buf_temp-prt-obj
     1430         where buf_temp-prt-obj.is-term <> true
     1431       on error undo, return error return-value
     1432       :
     1433         delete buf_temp-prt-obj .
     1434       end.
     1435       if p-include-fact-order = true
     1436       then do:
     1437         assign
     1438          p-fact-order = p-fact-order - 0.0000000001
     1439         .
     1440       end.
     1441       for each buf_doc-line no-lock
     1442         where buf_doc-line.obj-type   = p-obj-type
     1443           and buf_doc-line.obj-code   = p-obj-code
     1444           and buf_doc-line.artic      = p-artic
     1445           and buf_doc-line.prod-type  = p-prod-type
     1446           and buf_doc-line.prod-code  = p-prod-code
     1447           and buf_doc-line.status_    = 'факт':U
     1448           and buf_doc-line.fact-order >= p-fact-order
     1449       on error undo, return error return-value
     1450       :
     1451         run prdoclib-process-document in this-procedure
     1452           (input  buf_doc-line.doc-code
     1453           ,input  p-obj-type
     1454           ,input  p-obj-code
     1455           ,input  p-artic
     1456           ,input  p-prod-type
     1457           ,input  p-prod-code
     1458           ,output v-total-gds-dtl-qnty
     1459           ) .
     1460       end.
     1461     end.
     1462   end procedure.
     1463   procedure prdoclib-process-document :
     1464     define input  parameter p-doc-code           as character no-undo .
     1465     define input  parameter p-obj-type           as character no-undo .
     1466     define input  parameter p-obj-code           as integer   no-undo .
     1467     define input  parameter p-artic              as character no-undo .
     1468     define input  parameter p-prod-type          as character no-undo .
     1469     define input  parameter p-prod-code          as integer   no-undo .
     1470     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     1471     define buffer buf_trn-doc      for ub.trn-doc .
     1472     define buffer buf_gds-dtl      for ub.gds-dtl .
     1473     define buffer buf_temp-prt-obj for temp-prt-obj .
     1474     do
     1475     on error undo, return error return-value
     1476     :
     1477       find first buf_trn-doc no-lock
     1478         where buf_trn-doc.doc-code = p-doc-code
     1479         no-error .
     1480       if not available buf_trn-doc then do:
     1481         message
     1482           vss-workfile vss-revision vss-description skip
     1483           vss-include-info1 skip
     1484           "Ошибка при поиске документа" skip
     1485           "Документ" p-doc-code skip
     1486           "Объект" p-obj-type p-obj-code skip
     1487           "Артикул" p-artic p-prod-type p-prod-code skip
     1488           view-as alert-box error .
     1489         undo, return error .
     1490       end.
     1491       assign
     1492         p-total-gds-dtl-qnty = 0
     1493       .
     1494       for each buf_gds-dtl no-lock
     1495         where buf_gds-dtl.doc-code  = p-doc-code
     1496           and buf_gds-dtl.artic     = p-artic
     1497           and buf_gds-dtl.prod-type = p-prod-type
     1498           and buf_gds-dtl.prod-code = p-prod-code
     1499       on error undo, return error
     1500       :
     1501         define variable v-term-node as integer   no-undo .
     1502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1503     (input  buf_gds-dtl.prt-code
     1504     ,output v-term-node
     1505     )  .
     1506         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     1507           (input  v-term-node
     1508           ,buffer buf_temp-prt-obj
     1509           ) .
     1510         if buf_temp-prt-obj.is-term <> true then do:
     1511           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     1512                                        ,buf_gds-dtl.prt-code
     1513                                        ) .
     1514         end.
     1515         case buf_trn-doc.doc-type :
     1516           when 'при':U or
     1517           when 'возврат':U
     1518           then do:
     1519             assign
     1520               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1521                                           - buf_gds-dtl.fact-qnty
     1522               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1523                                           - buf_gds-dtl.fact-qnty
     1524             .
     1525           end.
     1526           when 'рас':U or
     1527           when 'спи':U
     1528           then do:
     1529             assign
     1530               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1531                                           + buf_gds-dtl.fact-qnty
     1532               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1533                                           + buf_gds-dtl.fact-qnty
     1534             .
     1535           end.
     1536           when 'инв':U
     1537           then do:
     1538             assign
     1539               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1540                                           - buf_gds-dtl.doc-qnty
     1541               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1542                                           - buf_gds-dtl.doc-qnty
     1543             .
     1544           end.
     1545           otherwise do:
     1546             undo, return error substitute("Неизвестный тип документа &1"
     1547                                          ,buf_trn-doc.doc-type
     1548                                          ) .
     1549           end.
     1550         end.
     1551       end.
     1552     end.
     1553   end procedure.
     1554   procedure prdoclib-prc-pl-document :
     1555     define input  parameter p-doc-code              as character no-undo .
     1556     define input  parameter p-obj-type              as character no-undo .
     1557     define input  parameter p-obj-code              as integer   no-undo .
     1558     define input  parameter p-gds-code              as integer   no-undo .
     1559     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     1560     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     1561     do
     1562     on error undo, return error return-value
     1563     :
     1564       define buffer buf_trn-doc      for ub.trn-doc .
     1565       define buffer buf_doc-pl       for ub.doc-pl .
     1566       define buffer buf_temp-pl-gds for temp-pl-gds .
     1567       define variable v-sign as decimal   no-undo .
     1568       find first buf_trn-doc no-lock
     1569         where buf_trn-doc.doc-code = p-doc-code
     1570         no-error .
     1571       if not available buf_trn-doc then do:
     1572         message
     1573           vss-workfile vss-revision vss-description skip
     1574           vss-include-info1 skip
     1575           "Ошибка при поиске документа" skip
     1576           "Документ" p-doc-code skip
     1577           "Объект" p-obj-type p-obj-code skip
     1578           "Товар" p-gds-code skip
     1579           view-as alert-box error .
     1580         undo, return error .
     1581       end.
     1582       assign
     1583         p-total-pl-gds-qnty     = 0
     1584         p-total-pl-gds-cli-qnty = 0
     1585       .
     1586       for each buf_doc-pl no-lock
     1587         where buf_doc-pl.out-code  = p-doc-code
     1588           and buf_doc-pl.gds-code  = p-gds-code
     1589       on error undo, return error return-value
     1590       :
     1591         find first buf_temp-pl-gds
     1592           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     1593             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     1594             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     1595           .
     1596         case buf_trn-doc.doc-type :
     1597           when 'при':U
     1598           or when 'возврат':U
     1599           or when 'инв':U
     1600           then do:
     1601             assign
     1602               v-sign = -1.0
     1603             .
     1604           end.
     1605           when 'рас':U or
     1606           when 'спи':U
     1607           then do:
     1608             assign
     1609               v-sign = 1.0
     1610             .
     1611           end.
     1612           otherwise do:
     1613             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     1614           end.
     1615         end case.
     1616         assign
     1617           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     1618           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     1619           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     1620           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     1621         .
     1622       end.
     1623     end.
     1624   end procedure.
     1625   procedure prdoclib-init-prt-obj-by-date :
     1626     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     1627     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     1628     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     1629     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     1630     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     1631     define input parameter p-fact-date  as date      no-undo .
     1632     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636       define variable v-fact-order                as decimal   no-undo .
     1637       define variable v-shift-end-fact-order      as decimal   no-undo .
     1638       define variable v-day-end-fact-order        as decimal   no-undo .
     1639       run factord in this-procedure
     1640         (input  p-fact-date
     1641         ,input  1
     1642         ,input  1
     1643         ,input  ?
     1644         ,input  0
     1645         ,input  false
     1646         ,output v-fact-order
     1647         ,output v-shift-end-fact-order
     1648         ,output v-day-end-fact-order
     1649         ) no-error .
     1650       if error-status :error
     1651       then do:
     1652         message
     1653           vss-workfile vss-revision vss-description skip
     1654           vss-include-info1 skip
     1655           "Ошибка при определении момента времени, на который требуется остаток" skip
     1656           "Объект" p-obj-type p-obj-code skip
     1657           "Артикул" p-artic p-prod-type p-prod-code skip
     1658           "Дата" p-fact-date skip
     1659           view-as alert-box error .
     1660         undo, return error .
     1661       end.
     1662       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     1663         (input p-obj-type
     1664         ,input p-obj-code
     1665         ,input p-artic
     1666         ,input p-prod-type
     1667         ,input p-prod-code
     1668         ,input v-day-end-fact-order
     1669         ,input false
     1670         ) no-error .
     1671       if error-status :error
     1672       then do:
     1673         message
     1674           vss-workfile vss-revision vss-description skip
     1675           vss-include-info1 skip
     1676           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     1677           "Объект" p-obj-type p-obj-code skip
     1678           "Артикул" p-artic p-prod-type p-prod-code skip
     1679           "Дата" p-fact-date skip
     1680           view-as alert-box error .
     1681         undo, return error .
     1682       end.
     1683     end.
     1684   end procedure.
     1685   procedure prdoclib-calc-temp-fact-sale :
     1686     define input  parameter p-obj-type           as character no-undo .
     1687     define input  parameter p-obj-code           as integer   no-undo .
     1688     define input  parameter p-gds-code           as integer   no-undo .
     1689     define input  parameter p-day-end-fact-order as decimal   no-undo .
     1690     define input  parameter p-curr-r-b           as character no-undo .
     1691     define output parameter p-fact-qnty          as decimal   no-undo .
     1692     define output parameter p-cur-base           as decimal   no-undo .
     1693     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1694     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1695     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1696     define output parameter p-cur-excise-base    as decimal   no-undo .
     1697     define buffer buf_temp-prt-obj for temp-prt-obj .
     1698     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     1699     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     1700     define variable parrecid-prl        as recid     no-undo .
     1701     define variable v-fact-qnty         as decimal   no-undo .
     1702     define variable v-cur-base          as decimal   no-undo .
     1703     define variable v-cur-VAT-base      as decimal   no-undo .
     1704     define variable v-cur-SLT-base      as decimal   no-undo .
     1705     define variable v-cur-road-tax-base as decimal   no-undo .
     1706     define variable v-cur-excise-base   as decimal   no-undo .
     1707     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1708     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1709     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1710     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1711     define variable vat-base-sale-prl               as decimal   no-undo .
     1712     define variable vat-rubl-sale-prl               as decimal   no-undo .
     1713     define variable vat-base-buyer-prl              as decimal   no-undo .
     1714     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1715     define variable slt-base-sale-prl               as decimal   no-undo .
     1716     define variable slt-rubl-sale-prl               as decimal   no-undo .
     1717     define variable road-tax-base-sale-prl          as decimal   no-undo .
     1718     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1719     define variable excise-base-sale-prl            as decimal   no-undo .
     1720     define variable excise-rubl-sale-prl            as decimal   no-undo .
     1721     define variable discnt-base-sale-prl            as decimal   no-undo .
     1722     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1723     do
     1724     on error undo, return error return-value
     1725     :
     1726       for each buf_temp-prt-obj no-lock
     1727       on error undo, return error return-value
     1728       :
     1729   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1730     (input  p-gds-code
     1731     ,input  buf_temp-prt-obj.prt-code
     1732     ,output v-prt-b-code
     1733     ) no-error .
     1734         if error-status :error
     1735         then do:
