      539         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
      540         v-old-fact-base     = buf_gds-obj.fact-base
      541         v-old-fact-rubl     = buf_gds-obj.fact-rubl
      542         v-old-fact-sale     = buf_gds-obj.fact-sale
      543       .
