     1822         assign
     1823           v-fact-qnty         = v-fact-qnty
     1824                               + buf_temp-prt-obj.fact-qnty
     1825           v-cur-base          = v-cur-base
     1826                               + (if p-curr-r-b = 'base':U
     1827                                   then price-base-with-tax-sale-prl
     1828                                   else price-rubl-with-tax-sale-prl
     1829                                 )
     1830                               * buf_temp-prt-obj.fact-qnty
     1831           v-cur-VAT-base      = v-cur-VAT-base
     1832                               + (if p-curr-r-b = 'base':U
     1833                                   then vat-base-sale-prl
     1834                                   else vat-rubl-sale-prl
     1835                                 )
     1836                               * buf_temp-prt-obj.fact-qnty
     1837           v-cur-SLT-base      = v-cur-SLT-base
     1838                               + (if p-curr-r-b = 'base':U
     1839                                   then slt-base-sale-prl
     1840                                   else slt-rubl-sale-prl
     1841                                 )
     1842                               * buf_temp-prt-obj.fact-qnty
     1843           v-cur-road-tax-base = v-cur-road-tax-base
     1844                               + (if p-curr-r-b = 'base':U
     1845                                   then road-tax-base-sale-prl
     1846                                   else road-tax-rubl-sale-prl
     1847                                 )
     1848                               * buf_temp-prt-obj.fact-qnty
     1849           v-cur-excise-base   = v-cur-excise-base
     1850                               + (if p-curr-r-b = 'base':U
     1851                                   then excise-base-sale-prl
     1852                                   else excise-rubl-sale-prl
     1853                                 )
     1854                               * buf_temp-prt-obj.fact-qnty
     1855         .
     1856       end.
     1857       assign
     1858         p-fact-qnty         = v-fact-qnty
     1859         p-cur-base          = v-cur-base
     1860         p-cur-VAT-base      = v-cur-VAT-base
     1861         p-cur-SLT-base      = v-cur-SLT-base
     1862         p-cur-road-tax-base = v-cur-road-tax-base
     1863         p-cur-excise-base   = v-cur-excise-base
     1864       .
     1865     end.
     1866   end procedure.
     1867   procedure prdoclib-clear-temp-pl-gds :
     1868     define buffer buf_temp-pl-gds for temp-pl-gds .
     1869     do
     1870     on error undo, return error return-value
     1871     :
     1872       for each buf_temp-pl-gds
     1873       on error undo, return error return-value
     1874       :
     1875         delete buf_temp-pl-gds .
     1876       end.
     1877     end.
     1878   end procedure.
     1879   procedure prdoclib-init-temp-pl-gds :
     1880     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     1881     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     1882     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     1883     define buffer buf_pl-gds      for ub.pl-gds .
     1884     define buffer buf_temp-pl-gds for temp-pl-gds .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888       run prdoclib-clear-temp-pl-gds in this-procedure .
     1889       for each buf_pl-gds
     1890         where buf_pl-gds.obj-type = p-obj-type
     1891           and buf_pl-gds.obj-code = p-obj-code
     1892           and buf_pl-gds.gds-code = p-gds-code
     1893       on error undo, return error return-value
     1894       :
     1895         create buf_temp-pl-gds .
     1896         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     1897       end.
     1898     end.
     1899   end procedure.
     1900   procedure prdoclib-init-pl-gds-by-factord :
     1901     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1902     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1903     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1904     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1905     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1906     define input parameter p-fact-order         as decimal   no-undo .
     1907     define input parameter p-include-fact-order as logical   no-undo .
     1908     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     1909     define buffer buf_goods       for ub.goods .
     1910     define buffer buf_gds-obj     for ub.gds-obj .
     1911     define buffer buf_doc-line    for ub.doc-line .
     1912     define buffer buf_temp-pl-gds for temp-pl-gds .
     1913     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     1914     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     1915     do
     1916     on error undo, return error return-value
     1917     :
     1918       do transaction
     1919       on error undo, return error return-value
     1920       :
     1921   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1923     (input  p-obj-type
     1924     ,input  p-obj-code
     1925     ,input  p-artic
     1926     ,input  p-prod-type
     1927     ,input  p-prod-code
     1928     ,buffer buf_gds-obj
     1929     ) no-error .
     1930         if error-status :error
     1931         then do:
     1932           message
     1933             vss-workfile vss-revision vss-description skip
     1934             vss-include-info1 skip
     1935             "Невозможно найти gds-obj" skip
     1936             error-status :get-message(1) skip
     1937             return-value skip
     1938             view-as alert-box error .
     1939           undo, return error return-value .
     1940         end.
     1941         find current buf_gds-obj exclusive-lock .
     1942       end.
     1943       find first buf_goods no-lock
     1944         where buf_goods.artic     = p-artic
     1945           and buf_goods.prod-type = p-prod-type
     1946           and buf_goods.prod-code = p-prod-code
     1947         .
     1948       run prdoclib-init-temp-pl-gds in this-procedure
     1949         (input p-obj-type
     1950         ,input p-obj-code
     1951         ,input buf_goods.gds-code
     1952         ) .
     1953       if p-include-fact-order = true
     1954       then do:
     1955         assign
     1956          p-fact-order = p-fact-order - 0.0000000001
     1957         .
     1958       end.
     1959       for each buf_doc-line no-lock
     1960         where buf_doc-line.obj-type   = p-obj-type
     1961           and buf_doc-line.obj-code   = p-obj-code
     1962           and buf_doc-line.artic      = p-artic
     1963           and buf_doc-line.prod-type  = p-prod-type
     1964           and buf_doc-line.prod-code  = p-prod-code
     1965           and buf_doc-line.status_    = 'факт':U
     1966           and buf_doc-line.fact-order >= p-fact-order
     1967       on error undo, return error return-value
     1968       :
     1969         run prdoclib-prc-pl-document in this-procedure
     1970           ( input  buf_doc-line.doc-code
     1971            ,input  p-obj-type
     1972            ,input  p-obj-code
     1973            ,input  buf_goods.gds-code
     1974            ,output v-total-pl-gds-qnty
     1975            ,output v-total-pl-gds-cli-qnty
     1976           ) .
     1977       end.
     1978     end.
     1979   end procedure.
     1980   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1981   procedure factord :
     1982     define input  parameter p-fact-date            as date    no-undo .
     1983     define input  parameter p-fact-time            as integer no-undo .
     1984     define input  parameter p-fact-num             as integer no-undo .
     1985     define input  parameter p-shift-date           as date    no-undo .
     1986     define input  parameter p-shift-num            as integer no-undo .
     1987     define input  parameter p-shift-on             as logical no-undo .
     1988     define output parameter p-fact-order           as decimal no-undo .
     1989     define output parameter p-shift-end-fact-order as decimal no-undo .
     1990     define output parameter p-day-end-fact-order   as decimal no-undo .
     1991     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1992     if p-fact-date = ?
     1993     then do:
     1994       return error "Не указана фактическая дата" .
     1995     end.
     1996     define variable v-fact-date-num as integer no-undo .
     1997     assign
     1998       v-fact-date-num = integer(p-fact-date)
     1999     .
     2000     if p-fact-num = ?
     2001     or p-fact-num = 0
     2002     then do:
     2003       return error "Не задан p-fact-num " + string(p-fact-num) .
     2004     end.
     2005     if p-fact-num < 0
     2006     then do:
     2007       return error "Отрицательный fact-num " + string(p-fact-num) .
     2008     end.
     2009     if p-fact-num >= 100000000
     2010     then do:
     2011       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2012     end.
     2013     if p-shift-on = true
     2014     then do:
     2015       if p-shift-date = ?
     2016       then do:
     2017         return error "Не задана дата смены" .
     2018       end.
     2019       if p-shift-num = ?
     2020       or p-shift-num = 0
     2021       then do:
     2022         return error "Не задан номер смены" .
     2023       end.
     2024     end.
     2025     else do:
     2026       assign
     2027         p-shift-date = p-fact-date
     2028         p-shift-num  = 24
     2029       .
     2030     end.
     2031     define variable v-shift-offset as integer no-undo .
     2032     if p-shift-date = p-fact-date
     2033     then do:
     2034       assign
     2035         v-shift-offset = 1
     2036       .
     2037     end.
     2038     if p-shift-date < p-fact-date
     2039     then do:
     2040       assign
     2041         v-shift-offset = 0
     2042       .
     2043     end.
     2044     if p-shift-date > p-fact-date
     2045     then do:
     2046       message
     2047         vss-workfile vss-revision vss-description skip
     2048         "Неправильная дата закрытия смены" skip
     2049         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2050         view-as alert-box error .
     2051       undo, return error
     2052         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2053           ,string(p-fact-date, '99/99/9999':U)
     2054           ,string(p-shift-date, '99/99/9999':U)
     2055           )
     2056       .
     2057     end.
     2058     if p-shift-num < 1
     2059     or p-shift-num > 24
     2060     then do:
     2061       message
     2062         vss-workfile vss-revision vss-description skip
     2063         "Неправильный номер смены" skip
     2064         "p-shift-num" p-shift-num skip
     2065         view-as alert-box error .
     2066       undo, return error return-value .
     2067     end.
     2068     assign
     2069       p-fact-order           = v-fact-date-num
     2070                              + v-shift-offset * 0.5
     2071                              + p-shift-num    * 0.02 - 0.01
     2072                              + p-fact-num     * 0.0000000001
     2073       p-shift-end-fact-order = v-fact-date-num
     2074                              + v-shift-offset * 0.5
     2075                              + p-shift-num    * 0.02
     2076       p-day-end-fact-order   = v-fact-date-num
     2077                              + 0.99
     2078     .
     2079     if p-fact-order           <= v-fact-date-num
     2080     or p-shift-end-fact-order <= v-fact-date-num
     2081     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2082     or p-shift-end-fact-order >= p-day-end-fact-order
     2083     then do:
     2084       message
     2085         vss-workfile vss-revision vss-description skip
     2086         "Внутренняя ошибка при генерации фактического номера" skip
     2087         "p-fact-date"            p-fact-date            skip
     2088         "p-fact-time"            p-fact-time            skip
     2089         "p-fact-num"             p-fact-num             skip
     2090         "p-shift-date"           p-shift-date           skip
     2091         "p-shift-num"            p-shift-num            skip
     2092         "p-shift-on"             p-shift-on             skip
     2093         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2094         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2095         "v-fact-date-num"        v-fact-date-num        skip
     2096         view-as alert-box error .
     2097       undo, return error return-value .
     2098     end.
     2099   end procedure.
     2100   procedure day-begin-fact-order :
     2101     define input  parameter p-fact-date            as date    no-undo .
     2102     define output parameter p-day-begin-fact-order as decimal no-undo .
     2103     do
     2104     on error undo, return error return-value
     2105     :
     2106       if p-fact-date = ?
     2107       then do:
     2108         assign
     2109           p-day-begin-fact-order = 0
     2110         .
     2111       end.
     2112       else do:
     2113         assign
     2114           p-day-begin-fact-order = integer(p-fact-date)
     2115         .
     2116       end.
     2117     end.
     2118   end procedure.
     2119   procedure factord-max-fact-order :
     2120     define output parameter p-max-fact-order as decimal   no-undo .
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       run day-begin-fact-order in this-procedure
     2125         (input  date(1, 1, 5000)
     2126         ,output p-max-fact-order
     2127         ) .
     2128     end.
     2129   end procedure.
     2130   procedure factord-cut-archive :
     2131     define input  parameter p-obj-type             as character no-undo .
     2132     define input  parameter p-obj-code             as integer   no-undo .
     2133     define input  parameter p-fact-date            as date      no-undo .
     2134     define output parameter p-shift-on             as logical   no-undo .
     2135     define output parameter p-shift-date           as date      no-undo .
     2136     define output parameter p-shift-num            as integer   no-undo .
     2137     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2138     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2139     define variable v-fact-order as decimal   no-undo .
     2140     define buffer buf_shift-obj for ub.shift-obj .
     2141     do
     2142     on error undo, return error return-value
     2143     :
     2144   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2146     (input  p-obj-type
     2147     ,input  p-obj-code
     2148     ,input  'shift-on=request'
     2149     ,output p-shift-on
     2150     ) no-error .
     2151       if error-status :error
     2152       then do:
     2153         message
     2154           vss-workfile vss-revision vss-description skip
     2155           "Ошибка при определении атрибута объекта" skip
     2156           "Объект" p-obj-type p-obj-code skip
     2157           error-status :get-message(1) skip
     2158           return-value skip
     2159           view-as alert-box error .
     2160         undo, return error return-value .
     2161       end.
     2162       if p-shift-on = false
     2163       then do:
     2164         assign
     2165           p-shift-date               = ?
     2166           p-shift-num                = 0
     2167         .
     2168       end.
     2169       else do:
     2170         find first buf_shift-obj share-lock
     2171           where buf_shift-obj.obj-type   = p-obj-type
     2172             and buf_shift-obj.obj-code   = p-obj-code
     2173             and buf_shift-obj.shift-date > p-fact-date
     2174           use-index pi
     2175           no-error .
     2176         if not available buf_shift-obj
     2177         or buf_shift-obj.status_ <> 'зкр':U
     2178         then do:
     2179           message
     2180             vss-workfile vss-revision vss-description skip
     2181             "Невозможно вычислить последнюю смену" skip
     2182             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2183             "Объект" p-obj-type p-obj-code skip
     2184             "Дата" p-fact-date skip
     2185             view-as alert-box error .
     2186           undo, return error return-value .
     2187         end.
     2188         find last buf_shift-obj share-lock
     2189           where buf_shift-obj.obj-type = p-obj-type
     2190             and buf_shift-obj.obj-code = p-obj-code
     2191             and buf_shift-obj.shift-date <= p-fact-date
     2192           use-index pi
     2193           no-error .
     2194         if available buf_shift-obj
     2195         then do:
     2196           if  buf_shift-obj.status_ = 'зкр':U
     2197           then do:
     2198             assign
     2199               p-shift-date = buf_shift-obj.shift-date
     2200               p-shift-num  = buf_shift-obj.shift-num
     2201             .
     2202           end.
     2203           else do:
     2204             message
     2205               vss-workfile vss-revision vss-description skip
     2206               "Невозможно вычислить последнюю смену" skip
     2207               "Статус смены отличен от статуса" 'зкр':U skip
     2208               "Объект" p-obj-type p-obj-code skip
     2209               "Дата" p-fact-date skip
     2210               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2211               view-as alert-box error .
     2212             undo, return error return-value .
     2213           end.
     2214         end.
     2215         else do:
     2216           assign
     2217             p-shift-date = p-fact-date - 1
     2218             p-shift-num  = 1
     2219           .
     2220         end.
     2221       end.
     2222       run factord in this-procedure
     2223         (input  p-fact-date
     2224         ,input  1
     2225         ,input  1
     2226         ,input  p-shift-date
     2227         ,input  p-shift-num
     2228         ,input  p-shift-on
     2229         ,output v-fact-order
     2230         ,output p-shift-end-fact-order
     2231         ,output p-day-end-fact-order
     2232         ) no-error .
     2233       if error-status :error
     2234       then do:
     2235         message
     2236           vss-workfile vss-revision vss-description skip
     2237           "Ошибка при вызове процедуры factord"
     2238           error-status :get-message(1) skip
     2239           return-value skip
     2240           view-as alert-box error .
     2241         undo, return error return-value .
     2242       end.
     2243     end.
     2244   end procedure.
     2245   procedure factord-lock-shift :
     2246     define input  parameter p-obj-type  as character no-undo .
     2247     define input  parameter p-obj-code  as integer   no-undo .
     2248     define input  parameter p-fact-date as date      no-undo .
     2249     define parameter buffer buf_shift-obj for ub.shift-obj .
     2250     define variable v-shift-on      as logical   no-undo .
     2251     define variable v-extra-message as character no-undo .
     2252     define variable v-error as character no-undo .
     2253     do
     2254     on error undo, return error return-value
     2255     :
     2256   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2258     (input  p-obj-type
     2259     ,input  p-obj-code
     2260     ,input  'shift-on=request'
     2261     ,output v-shift-on
     2262     ) no-error .
     2263       if error-status :error
     2264       then do:
     2265         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2266         undo, return error v-error .
     2267       end.
     2268       if v-shift-on = true
     2269       then do:
     2270         find first buf_shift-obj share-lock
     2271           where buf_shift-obj.obj-type   = p-obj-type
     2272             and buf_shift-obj.obj-code   = p-obj-code
     2273             and buf_shift-obj.shift-date > p-fact-date
     2274           use-index pi
     2275           no-error .
     2276         if not available buf_shift-obj
     2277         or buf_shift-obj.status_ <> 'зкр':U
     2278         then do:
     2279           find last buf_shift-obj
     2280             where buf_shift-obj.obj-type = p-obj-type
     2281               and buf_shift-obj.obj-code = p-obj-code
     2282               and buf_shift-obj.status_  = 'зкр':U
     2283             use-index stts
     2284             no-error .
     2285           if available buf_shift-obj
     2286           then do:
     2287             assign
     2288               v-extra-message =
     2289                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2290                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2291                               )
     2292             .
     2293           end.
     2294           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2295           undo, return error v-error .
     2296         end.
     2297       end.
     2298     end.
     2299   end procedure.
     2300   procedure factord-end-day :
     2301     define input  parameter p-fact-date            as date    no-undo .
     2302     define output parameter p-day-end-fact-order   as decimal no-undo .
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       if p-fact-date = ?
     2307       then do:
     2308         return error "Не указана фактическая дата" .
     2309       end.
     2310       assign
     2311         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2312       .
     2313     end.
     2314   end procedure.
     2315   procedure factord-to-date :
     2316     define input  parameter p-fact-order as decimal no-undo .
     2317     define output parameter p-fact-date  as date    no-undo .
     2318     define variable v-ref-date  as date      no-undo .
     2319     define variable v-ref-delta as integer   no-undo .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       if p-fact-order = ?
     2324       or p-fact-order = 0
     2325       then do:
     2326         return error "Не указан fact-order" .
     2327       end.
     2328       assign
     2329         v-ref-date  = date(1, 1, 2000)
     2330       .
     2331       assign
     2332         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2333       .
     2334       assign
     2335         p-fact-date = v-ref-date + v-ref-delta
     2336       .
     2337     end.
     2338   end procedure.
     2339   procedure factord-to-fact-num :
     2340     define input  parameter p-fact-order as decimal no-undo .
     2341     define output parameter p-fact-num   as integer no-undo .
     2342     define variable v-fact-order-trunc as decimal no-undo .
     2343     do
     2344     on error undo, return error return-value
     2345     :
     2346       if p-fact-order = ?
     2347       or p-fact-order = 0
     2348       then do:
     2349         return error "Не указан fact-order" .
     2350       end.
     2351       assign
     2352        v-fact-order-trunc = truncate(p-fact-order, 2)
     2353       .
     2354       assign
     2355         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2356       .
     2357     end.
     2358   end procedure.
     2359   procedure factord-to-shift-num :
     2360     define input  parameter p-fact-order as decimal no-undo .
     2361     define output parameter p-shift-num   as integer no-undo .
     2362     define variable  p-shift-numd  as decimal   no-undo .
     2363     define variable v-fact-order-trunc as decimal no-undo .
     2364     do
     2365     on error undo, return error return-value
     2366     :
     2367       if p-fact-order = ?
     2368       or p-fact-order = 0
     2369       then do:
     2370         return error "Не указан fact-order" .
     2371       end.
     2372       assign
     2373        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2374       .
     2375       if v-fact-order-trunc < 0.5 then do:
     2376         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2377       end.
     2378       assign
     2379         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2380         .
     2381        assign
     2382         p-shift-num = truncate (p-shift-numd , 0)
     2383       .
     2384     end.
     2385   end procedure.
