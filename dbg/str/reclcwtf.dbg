        1   block-level on error undo, throw.
        2   define input parameter parobj-type like ub.wth-doc.obj-type no-undo .
        3   define input parameter parobj-code like ub.wth-doc.obj-code no-undo .
        4   define input parameter pardelfact-order as decimal no-undo .
        5   define input parameter p-wth-doc-close as logical no-undo .
        6   define input parameter p-hist-action as character no-undo .
        7   define input parameter p-doc-code       like ub.wth-doc.doc-code no-undo .
        8   define input parameter p-fact-date      like ub.wth-doc.fact-date    no-undo .
        9   define input parameter p-user-db-num    like ub.wth-doc.user-db-num  no-undo .
       10   define input parameter p-user-name      like ub.wth-doc.user-name    no-undo .
       11   define input parameter p-sys-date       like ub.wth-doc.sys-date     no-undo .
       12   define input parameter p-sys-time-int   like ub.wth-doc.sys-time-int no-undo .
       13   define input parameter p-sys-time       like ub.wth-doc.sys-time     no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: reclcwtf.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: str/reclcwtf.p $":U .
       19   define variable vss-description as character no-undo init "Пересчет остатков мат ценностей начиная с fact-order предшествующего данному".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure wth-obj-hist :
       91   define parameter buffer buf_wth-obj for ub.wth-obj.
       92   define input parameter p-obj-type like ub.wth-obj.obj-type no-undo .
       93   define input parameter p-obj-code like ub.wth-obj.obj-code no-undo .
       94   define input parameter p-wth-code like ub.wth-obj.wth-code no-undo .
       95   define input parameter p-action-type as character no-undo .
       96   define input  parameter p-source-type        as character no-undo .
       97   define input  parameter p-source-ref         as character no-undo .
       98   define input  parameter p-source-date        as date      no-undo .
       99   define input  parameter p-corr-user-db-num   as integer   no-undo .
      100   define input  parameter p-corr-user-name     as character no-undo .
      101   define input  parameter p-corr-date          as date      no-undo .
      102   define input  parameter p-corr-time          as integer   no-undo .
      103   define input  parameter p-corr-time-str      as character no-undo .
      104   define variable v-new-chip-num as integer   no-undo .
      105   define buffer buf_c-wth-obj for ub.c-wth-obj .
      106     do
      107     for buf_c-wth-obj
      108     transaction
      109     on error undo, return error return-value
      110     :
      111       find last buf_c-wth-obj exclusive-lock
      112         where buf_c-wth-obj.obj-type = buf_wth-obj.obj-type
      113           and buf_c-wth-obj.obj-code = buf_wth-obj.obj-code
      114           and buf_c-wth-obj.wth-code = buf_wth-obj.wth-code
      115           and buf_c-wth-obj.corr-user-db-num = p-corr-user-db-num
      116         use-index pi
      117         no-error .
      118       if available buf_c-wth-obj
      119       then do:
      120         assign
      121           v-new-chip-num = buf_c-wth-obj.chip-num + 1
      122         .
      123       end.
      124       else do:
      125         assign
      126           v-new-chip-num = 1
      127         .
      128       end.
      129       create buf_c-wth-obj .
      130       if p-action-type = 'delete':U
      131       and
      132       not available buf_wth-obj then do:
      133         assign
      134         buf_c-wth-obj.obj-type = p-obj-type
      135         buf_c-wth-obj.obj-code = p-obj-code
      136         buf_c-wth-obj.wth-code = p-wth-code
      137         .
      138       end.
      139       else do:
      140         buffer-copy buf_wth-obj to
      141         buf_c-wth-obj.
      142       end.
      143       assign
      144         buf_c-wth-obj.chip-num          = v-new-chip-num
      145         buf_c-wth-obj.action-type       = p-action-type
      146         buf_c-wth-obj.source-type       = p-source-type
      147         buf_c-wth-obj.source-ref        = p-source-ref
      148         buf_c-wth-obj.source-date       = p-source-date
      149         buf_c-wth-obj.corr-user-db-num  = p-corr-user-db-num
      150         buf_c-wth-obj.corr-user-name    = p-corr-user-name
      151         buf_c-wth-obj.corr-date         = p-corr-date
      152         buf_c-wth-obj.corr-time         = p-corr-time
      153         buf_c-wth-obj.corr-time-str     = p-corr-time-str
      154       .
      155     end.
      156   end procedure.
      157   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   procedure wth-pobj-hist :
      159   define parameter buffer buf_wth-pobj for ub.wth-pobj.
      160   define input parameter p-obj-type like ub.wth-pobj.obj-type no-undo .
      161   define input parameter p-obj-code like ub.wth-pobj.obj-code no-undo .
      162   define input parameter p-wth-code like ub.wth-pobj.wth-code no-undo .
      163   define input parameter p-w-p-code like ub.wth-pobj.w-p-code no-undo .
      164   define input parameter p-action-type as character no-undo .
      165   define input  parameter p-source-type        as character no-undo .
      166   define input  parameter p-source-ref         as character no-undo .
      167   define input  parameter p-source-date        as date      no-undo .
      168   define input  parameter p-corr-user-db-num   as integer   no-undo .
      169   define input  parameter p-corr-user-name     as character no-undo .
      170   define input  parameter p-corr-date          as date      no-undo .
      171   define input  parameter p-corr-time          as integer   no-undo .
      172   define input  parameter p-corr-time-str      as character no-undo .
      173   define variable v-new-chip-num as integer   no-undo .
      174   define buffer buf_c-wth-pobj for ub.c-wth-pobj .
      175     do
      176     for buf_c-wth-pobj
      177     transaction
      178     on error undo, return error return-value
      179     :
      180       find first buf_c-wth-pobj exclusive-lock
      181         where buf_c-wth-pobj.obj-type = buf_wth-pobj.obj-type
      182           and buf_c-wth-pobj.obj-code = buf_wth-pobj.obj-code
      183           and buf_c-wth-pobj.wth-code = buf_wth-pobj.wth-code
      184           and buf_c-wth-pobj.w-p-code = buf_wth-pobj.w-p-code
      185         use-index ishow
      186         no-error .
      187       if available buf_c-wth-pobj
      188       then do:
      189          assign
      190           v-new-chip-num = buf_c-wth-pobj.chip-num + 1
      191         .
      192       end.
      193       else do:
      194         assign
      195           v-new-chip-num = 1
      196         .
      197       end.
      198       create buf_c-wth-pobj .
      199       if p-action-type = 'delete':U
      200       and
      201       not available buf_wth-pobj then do:
      202         assign
      203         buf_c-wth-pobj.obj-type = p-obj-type
      204         buf_c-wth-pobj.obj-code = p-obj-code
      205         buf_c-wth-pobj.wth-code = p-wth-code
      206         buf_c-wth-pobj.w-p-code = p-w-p-code
      207         buf_c-wth-pobj.corr-user-db-num  = p-corr-user-db-num
      208         .
      209       end.
      210       else do:
      211         buffer-copy buf_wth-pobj to buf_c-wth-pobj
      212         assign buf_c-wth-pobj.corr-user-db-num  = p-corr-user-db-num
      213         .
      214       end.
      215       assign
      216         buf_c-wth-pobj.chip-num          = v-new-chip-num
      217         buf_c-wth-pobj.action-type       = p-action-type
      218         buf_c-wth-pobj.source-type       = p-source-type
      219         buf_c-wth-pobj.source-ref        = p-source-ref
      220         buf_c-wth-pobj.source-date       = p-source-date
      221         buf_c-wth-pobj.corr-user-name    = p-corr-user-name
      222         buf_c-wth-pobj.corr-date         = p-corr-date
      223         buf_c-wth-pobj.corr-time         = p-corr-time
      224         buf_c-wth-pobj.corr-time-str     = p-corr-time-str
      225       .
      226     end.
      227   end procedure.
      228   define buffer start_wth-line for ub.wth-line.
      229   define buffer start_wth-obj for ub.wth-obj.
      230   define buffer start_wth-pobj for ub.wth-pobj.
      231   define variable v-host-code as integer   no-undo .
      232   do transaction
      233   on error undo, return error
      234   :
      235   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      237     (input  parobj-type
      238     ,input  parobj-code
      239     ,output v-host-code
      240     )  .
      241     for each start_wth-pobj exclusive-lock
      242       where start_wth-pobj.obj-type = parobj-type
      243         and start_wth-pobj.obj-code = parobj-code
      244     on error undo, return error
      245     :
      246       find last start_wth-line no-lock
      247         where start_wth-line.obj-type = parobj-type
      248           and start_wth-line.obj-code = parobj-code
      249           and start_wth-line.status_ = 'факт':U
      250           and start_wth-line.fact-order <= pardelfact-order
      251           and start_wth-line.wth-code = start_wth-pobj.wth-code
      252           and start_wth-line.w-p-code = start_wth-pobj.w-p-code
      253         no-error .
      254       run wth-pobj-hist in this-procedure (
      255                                             buffer start_wth-pobj
      256                                           ,input start_wth-pobj.obj-type
      257                                           ,input start_wth-pobj.obj-code
      258                                           ,input start_wth-pobj.wth-code
      259                                           ,input start_wth-pobj.w-p-code
      260                                           ,input p-hist-action
      261                                           ,input 'wth-doc':U
      262                                           ,input p-doc-code
      263                                           ,input p-fact-date
      264                                           ,input p-user-db-num
      265                                           ,input p-user-name
      266                                           ,input p-sys-date
      267                                           ,input p-sys-time-int
      268                                           ,input p-sys-time
      269                                           ).
      270       if available start_wth-line
      271       then do:
      272         assign
      273           start_wth-pobj.incass-pl       = start_wth-line.incass-pl
      274           start_wth-pobj.income-pl       = start_wth-line.income-pl
      275           start_wth-pobj.incass-bank-pl  = start_wth-line.incass-bank-pl
      276           start_wth-pobj.incass-other-pl = start_wth-line.incass-other-pl
      277           start_wth-pobj.incass-cassa-pl = start_wth-line.incass-cassa-pl
      278           start_wth-pobj.income-cassa-pl = start_wth-line.income-cassa-pl
      279           start_wth-pobj.income-other-pl = start_wth-line.income-other-pl
      280         .
      281       end.
      282       else do:
      283         assign
      284           start_wth-pobj.incass-pl       = 0
      285           start_wth-pobj.income-pl       = 0
      286           start_wth-pobj.incass-bank-pl  = 0
      287           start_wth-pobj.incass-other-pl = 0
      288           start_wth-pobj.incass-cassa-pl = 0
      289           start_wth-pobj.income-cassa-pl = 0
      290           start_wth-pobj.income-other-pl = 0
      291         .
      292       end.
      293     end.
      294     for each start_wth-obj exclusive-lock
      295       where start_wth-obj.obj-type = parobj-type
      296         and start_wth-obj.obj-code = parobj-code
      297     on error undo, return error
      298     :
      299       find last start_wth-line no-lock
      300         where start_wth-line.obj-type = parobj-type
      301           and start_wth-line.obj-code = parobj-code
      302           and start_wth-line.status_ = 'факт':U
      303           and start_wth-line.fact-order <= pardelfact-order
      304           and start_wth-line.wth-code = start_wth-obj.wth-code
      305         no-error .
      306       run wth-obj-hist in this-procedure (
      307                                            buffer start_wth-obj
      308                                           ,input start_wth-obj.obj-type
      309                                           ,input start_wth-obj.obj-code
      310                                           ,input start_wth-obj.wth-code
      311                                           ,input 'delete':U
      312                                           ,input 'wth-doc':U
      313                                           ,input p-doc-code
      314                                           ,input p-fact-date
      315                                           ,input p-user-db-num
      316                                           ,input p-user-name
      317                                           ,input p-sys-date
      318                                           ,input p-sys-time-int
      319                                           ,input p-sys-time
      320                                           ).
      321       if avail start_wth-line then do:
      322         assign
      323           start_wth-obj.incass           = start_wth-line.incass
      324           start_wth-obj.income           = start_wth-line.income
      325           start_wth-obj.incass-bank      = start_wth-line.incass-bank
      326           start_wth-obj.incass-other     = start_wth-line.incass-other
      327           start_wth-obj.incass-cassa     = start_wth-line.incass-cassa
      328           start_wth-obj.income-cassa     = start_wth-line.income-cassa
      329           start_wth-obj.income-other     = start_wth-line.income-other
      330         .
      331       end.
      332       else do:
      333         assign
      334           start_wth-obj.incass           = 0
      335           start_wth-obj.income           = 0
      336           start_wth-obj.incass-bank      = 0
      337           start_wth-obj.incass-other     = 0
      338           start_wth-obj.incass-cassa     = 0
      339           start_wth-obj.income-cassa     = 0
      340           start_wth-obj.income-other     = 0
      341         .
      342       end.
      343     end.
      344     for each ub.wth-doc
      345       where ub.wth-doc.host-code = v-host-code
      346         and ub.wth-doc.obj-type  = parobj-type
      347         and ub.wth-doc.obj-code  = parobj-code
      348         and ub.wth-doc.status_   = 'факт':U
      349         AND ub.wth-doc.fact-order > pardelfact-order
      350     on error undo, return error
      351     :
      352       run str/stkotwth.p
      353         (input recid(ub.wth-doc)
      354         ,input yes
      355         ,input p-wth-doc-close
      356         ,input 0) no-error.
      357       if error-status :error then do:
      358         undo, return error return-value.
      359       end.
      360     end.
      361   end.
