        1   block-level on error undo, throw.
        2   define input  parameter parParentproc as handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: run-prch.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/run-prch.p $":U .
        8   define variable vss-description as character no-undo init "Толкач выгрузки на прайс-чекер".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
       71     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
       72     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
       73     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
       74     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
       75     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
       76     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
       77     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
       78     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
       79     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
       80     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
       81     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
       82     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
       83     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
       84     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
       85     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
       86     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
       87     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
       88     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
       89     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
       90     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
       91     define variable v-cntxp-conf-par        as   character                no-undo.
       92     define variable v-cntxp-par-type        as   character                no-undo.
       93     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
       94     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
       95     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
       96     define variable v-cntxp-db-num          as integer   no-undo .
       97     define variable v-cntxp-userid          as character no-undo .
       98     define variable v-cntxp-level           as character no-undo .
       99     define variable v-cntxp-db-num-obj      as integer   no-undo .
      100     define variable v-cntxp-is-admin        as logical   no-undo .
      101     define buffer bf-cntxp_store for ub.store.
      102     define buffer bf-cntxp_shop  for ub.shop.
      103     define buffer bf-cntxp_sysconf for ub.sysconf.
      104   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105     define variable v-cntxt-db-num        as integer   no-undo .
      106     define variable v-cntxt-userid        as character no-undo .
      107     define variable v-cntxt-level         as character no-undo .
      108     define variable v-cntxt-host-code-obj as integer   no-undo .
      109     define variable v-cntxt-obj-type      as character no-undo .
      110     define variable v-cntxt-obj-code      as integer   no-undo .
      111     define variable v-cntxt-db-num-obj    as integer   no-undo .
      112     define variable v-cntxt-is-admin      as logical   no-undo .
      113   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     run mainmenu_getcntxt in parparentproc
      115       (output v-cntxt-db-num
      116       ,output v-cntxt-userid
      117       ,output v-cntxt-level
      118       ,output v-cntxt-host-code-obj
      119       ,output v-cntxt-obj-type
      120       ,output v-cntxt-obj-code
      121       ,output v-cntxt-db-num-obj
      122       ,output v-cntxt-is-admin
      123       ) .
      124   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     run mainmenu_getcntxt in parparentproc
      126       (output v-cntxp-db-num
      127       ,output v-cntxp-userid
      128       ,output v-cntxp-level
      129       ,output v-cntxp-curr-host-code
      130       ,output v-cntxp-obj-type
      131       ,output v-cntxp-obj-code
      132       ,output v-cntxp-db-num-obj
      133       ,output v-cntxp-is-admin
      134       ) .
      135     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      136        v-cntxp-obj-code <> 0 then do:
      137   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      138     (input  'is-prt'
      139     ,input  0
      140     ,input  ''
      141     ,input  0
      142     ,input  ''
      143     ,input  ''
      144     ,input  ''
      145     ,input  yes
      146     ,output v-cntxp-conf-par
      147     ,output v-cntxp-par-type
      148     ) no-error .
      149       case v-cntxp-obj-type :
      150         when 'скл':U then do:
      151           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      152           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      153           assign
      154             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      155             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      156             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      157             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      158             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      159             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      160             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      161             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      162             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      163             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      164             v-cntxp-load-time       = bf-cntxp_store.load-time
      165             v-cntxp-holidays        = bf-cntxp_store.holidays
      166             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      167             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      168             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      169             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      170             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      171             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      172             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      173             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      174             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      175             .
      176         end.
      177         when 'маг':U then do:
      178           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      179           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      180           assign
      181             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      182             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      183             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      184             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      185             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      186             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      187             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      188             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      189             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      190             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      191             v-cntxp-load-time       = bf-cntxp_shop.load-time
      192             v-cntxp-holidays        = bf-cntxp_shop.holidays
      193             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      194             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      195             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      196             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      197             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      198             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      199             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      200             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      201             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      202             .
      203         end.
      204       end case.
      205     end.
      206   define variable v-host-code as integer   no-undo .
      207   do
      208   on error undo, return error return-value
      209   :
      210   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      212     (input  v-cntxt-obj-type
      213     ,input  v-cntxt-obj-code
      214     ,output v-host-code
      215     )  .
      216     run str/gds-cash.p (
      217         input parparentproc
      218       , input v-host-code
      219       , input v-cntxt-obj-type
      220       , input v-cntxt-obj-code
      221       , input 'pricecheck-Servis+':U
      222       ) .
      223   end.
