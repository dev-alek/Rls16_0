        1   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        2   define input parameter parParentProc as Widget-handle no-undo .
        3   define input-output parameter p-doc-rec as recid no-undo .
        4   define output parameter p-susp-chk as character no-undo .
        5   define output parameter p-link-chk as character no-undo .
        6   define buffer buf_reportShift for ub.reportShift .
        7   define buffer buf_report      for ub.reportShift .
        8   define variable v-susp as character no-undo .
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   DEFINE BUTTON b-quit AUTO-END-KEY
       14       LABEL "&Выход"
       15       SIZE 10 BY 1 TOOLTIP "Выход"
       16       BGCOLOR 8 .
       17   DEFINE BUTTON BUTTON-susp
       18       IMAGE-DOWN FILE "btn-down-arrow":U
       19       IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       20       LABEL "..."
       21       SIZE 4.13 BY 1 TOOLTIP "Выбор причин".
       22   DEFINE VARIABLE CsuspChk   AS CHARACTER FORMAT "X(150)":U INITIAL "-1"
       23       VIEW-AS COMBO-BOX INNER-LINES 5
       24       LIST-ITEM-PAIRS "Все",-1
       25       DROP-DOWN-LIST
       26       SIZE 87 BY 1 NO-UNDO.
       27   DEFINE VARIABLE v-link-chk AS CHARACTER FORMAT "X(256)":U
       28       LABEL "Ссылка на ~"корректный~" чек"
       29       VIEW-AS FILL-IN
       30       SIZE 44.13 BY 1 NO-UNDO.
       31   DEFINE VARIABLE v-susp-chk AS CHARACTER FORMAT "X(256)":U
       32       VIEW-AS FILL-IN
       33       SIZE 87 BY 1 NO-UNDO.
       34   DEFINE RECTANGLE RECT-2
       35       EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
       36       SIZE 95.5 BY 5.25.
       37   DEFINE FRAME Dialog-Frame
       38       b-quit AT ROW 1.25 COL 1.5 WIDGET-ID 24
       39       CsuspChk AT ROW 3.38 COL 2 COLON-ALIGNED NO-LABEL WIDGET-ID 92
       40       BUTTON-susp AT ROW 3.42 COL 91.88 WIDGET-ID 88
       41       v-susp-chk AT ROW 4.88 COL 2 COLON-ALIGNED NO-LABEL WIDGET-ID 42
       42       v-link-chk AT ROW 6.38 COL 90.01 RIGHT-ALIGNED WIDGET-ID 44
       43       "  Причина подозрительного чека" VIEW-AS TEXT
       44       SIZE 32 BY .67 AT ROW 2.29 COL 32.63 WIDGET-ID 38
       45       RECT-2 AT ROW 2.63 COL 2.5 WIDGET-ID 36
       46       SPACE(2.12) SKIP(0.61)
       47       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       48       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       49       TITLE "Параметры по смене" WIDGET-ID 100.
       50   ASSIGN
       51       FRAME Dialog-Frame:SCROLLABLE = FALSE
       52       FRAME Dialog-Frame:HIDDEN     = TRUE.
       53   ASSIGN
       54       v-susp-chk:HIDDEN IN FRAME Dialog-Frame = TRUE.
       55   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       56       DO:
       57           APPLY "END-ERROR":U TO SELF.
       58       END.
       59   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
       60       DO:
       61           define buffer buf_reason for ub.code .
       62           assign
       63               v-link-chk
       64               v-susp-chk
       65               CsuspChk
       66               .
       67           if v-susp = "" then
       68           do:
       69               find first buf_reason no-lock where buf_reason.parent = 'reasons-suspicious-check':U and
       70                   buf_reason.code = CsuspChk no-error .
       71               if available (buf_reason) then
       72               do:
       73                   v-susp = buf_reason.CodeName .
       74               end.
       75           end.
       76           if v-susp-chk = "" then p-susp-chk = v-susp .
       77           else p-susp-chk = v-susp + ": " + v-susp-chk .
       78           p-link-chk = v-link-chk .
       79           if CsuspChk = "0" and v-susp-chk = "" then
       80           do:
       81               message 'Заполните поле с описанием "иной причины" возникновения подозрительного чека'
       82                   view-as alert-box.
       83               apply "entry" to v-susp-chk IN FRAME Dialog-Frame .
       84               return no-apply .
       85           end.
       86       END.
       87   ON CHOOSE OF BUTTON-susp IN FRAME Dialog-Frame
       88       DO:
       89           define variable v-code as character no-undo .
       90           define buffer buf_reason for ub.code .
       91           do with frame Dialog-Frame:
       92               run ref/reasonSuspCheck.w(parparentproc,'ВЫБОР':U,output v-code).
       93               find first buf_reason no-lock where buf_reason.parent = 'reasons-suspicious-check':U and
       94                   buf_reason.code = v-code no-error .
       95               if available (buf_reason) then
       96               do:
       97                   if buf_reason.code = "0" then
       98                   do:
       99                       v-susp = buf_reason.CodeName .
      100                       v-susp-chk = "" .
      101                       display v-susp-chk .
      102                       CsuspChk = string(buf_reason.code) .
      103                       display CsuspChk .
      104                       v-susp-chk:hidden in frame Dialog-Frame = false .
      105                       enable v-susp-chk with frame Dialog-Frame .
      106                       apply "entry" to v-susp-chk IN FRAME Dialog-Frame .
      107                   end.
      108                   else
      109                   do:
      110                       v-susp = "".
      111                       v-susp-chk = buf_reason.CodeName .
      112                       v-susp-chk:hidden in frame Dialog-Frame = true .
      113                       CsuspChk = string(buf_reason.code) .
      114                       display CsuspChk .
      115                       assign
      116                           v-susp = v-susp-chk
      117                           .
      118                       apply "entry" to v-link-chk IN FRAME Dialog-Frame .
      119                   end.
      120               end.
      121           end.
      122       END.
      123   ON VALUE-CHANGED OF CsuspChk IN FRAME Dialog-Frame
      124       DO:
      125           assign CsuspChk .
      126           if CsuspChk = "0" then
      127           do:
      128               v-susp-chk:hidden in frame Dialog-Frame = false .
      129               enable v-susp-chk with frame Dialog-Frame .
      130               apply "entry" to v-susp-chk IN FRAME Dialog-Frame .
      131           end.
      132           else
      133           do:
      134               v-susp-chk:hidden in frame Dialog-Frame = true .
      135               v-susp-chk = "" .
      136               v-susp-chk:screen-value = "" .
      137               assign v-susp-chk .
      138               apply "entry" to v-link-chk IN FRAME Dialog-Frame .
      139           end.
      140       END.
      141   ON LEAVE OF v-link-chk IN FRAME Dialog-Frame
      142       DO:
      143           assign
      144               v-link-chk.
      145       END.
      146   ON LEAVE OF v-susp-chk IN FRAME Dialog-Frame
      147       DO:
      148           assign v-susp-chk .
      149       END.
      150   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      151       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      152   MAIN-BLOCK:
      153   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      154       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      155       define variable reason_Chk as character no-undo .
      156       define variable null_Code  as character no-undo .
      157       define buffer buf_Code for ub.Code .
      158       reason_Chk = " " + chr(4) + "-1":U .
      159       for each ub.Code no-lock where ub.Code.parent = 'reasons-suspicious-check':U and
      160           ub.Code.status_ = 0  BY ub.Code.Code desc:
      161           if ub.Code.code = "0" then null_Code = ub.Code.CodeName .
      162           reason_Chk = reason_Chk + chr(4) + ub.Code.CodeName + chr(4) + string(ub.Code.code) .
      163       end.
      164       ASSIGN
      165           CsuspChk:delimiter = chr(4) .
      166       CsuspChk:LIST-ITEM-PAIRS  in frame Dialog-Frame = reason_Chk .
      167       find first ub.susp-chk exclusive-lock where recid(ub.susp-chk) = p-doc-rec no-error .
      168       if not available (ub.susp-chk) then return no-apply .
      169       if ub.susp-chk.reason-name <> "" then
      170       do:
      171           if ub.susp-chk.reason-name begins null_Code then
      172           do:
      173               CsuspChk = "0" .
      174               v-susp-chk = replace(ub.susp-chk.reason-name, null_code, "") no-error .
      175               v-susp-chk = trim(v-susp-chk,": ").
      176               assign v-susp-chk .
      177               display v-susp-chk with frame Dialog-Frame .
      178               enable v-susp-chk with frame Dialog-Frame .
      179           end.
      180           else
      181           do:
      182               find first buf_Code no-lock where buf_Code.parent = 'reasons-suspicious-check':U and
      183                   buf_Code.CodeName = ub.susp-chk.reason-name no-error .
      184               if available (buf_Code) then
      185               do:
      186                   CsuspChk = buf_Code.code .
      187               end.
      188           end.
      189       end.
      190       if ub.susp-chk.link-chk <> "" then v-link-chk = ub.susp-chk.link-chk .
      191       RUN enable_UI.
      192       WAIT-FOR GO OF FRAME Dialog-Frame .
      193   END.
      194   RUN disable_UI.
      195   PROCEDURE disable_UI :
      196       HIDE FRAME Dialog-Frame.
      197   END PROCEDURE.
      198   PROCEDURE enable_UI :
      199       DISPLAY CsuspChk v-link-chk
      200           WITH FRAME Dialog-Frame.
      201       ENABLE RECT-2 b-quit CsuspChk BUTTON-susp v-link-chk
      202           WITH FRAME Dialog-Frame.
      203       VIEW FRAME Dialog-Frame.
      204   END PROCEDURE.
