        1   define input  parameter parParentProc as handle no-undo .
        2   define input  parameter v-db-num as integer   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Настройки ценообразования ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define new global shared variable g#library  as handle no-undo .
      113   define new global shared variable g#library2 as handle no-undo .
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115     define variable v-cntxt-db-num        as integer   no-undo .
      116     define variable v-cntxt-userid        as character no-undo .
      117     define variable v-cntxt-level         as character no-undo .
      118     define variable v-cntxt-host-code-obj as integer   no-undo .
      119     define variable v-cntxt-obj-type      as character no-undo .
      120     define variable v-cntxt-obj-code      as integer   no-undo .
      121     define variable v-cntxt-db-num-obj    as integer   no-undo .
      122     define variable v-cntxt-is-admin      as logical   no-undo .
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124     run mainmenu_getcntxt in parparentproc
      125       (output v-cntxt-db-num
      126       ,output v-cntxt-userid
      127       ,output v-cntxt-level
      128       ,output v-cntxt-host-code-obj
      129       ,output v-cntxt-obj-type
      130       ,output v-cntxt-obj-code
      131       ,output v-cntxt-db-num-obj
      132       ,output v-cntxt-is-admin
      133       ) .
      134   define buffer buf_global-state for ub.global-state  .
      135   define buffer buf_global-state-attr for ub.global-state-attr  .
      136   define variable v-val1 as decimal   no-undo .
      137   define variable v-val2 as decimal   no-undo .
      138   define variable v-prc as decimal   no-undo .
      139   DEFINE BUTTON B-Cancel AUTO-END-KEY
      140        LABEL "&Отмена"
      141        SIZE 12 BY 1
      142        BGCOLOR 8 .
      143   DEFINE BUTTON B-Help
      144        LABEL "Помо&щь"
      145        SIZE 5.5 BY 1
      146        BGCOLOR 8 .
      147   DEFINE BUTTON B-OK AUTO-GO
      148        LABEL "&Ввод"
      149        SIZE 12 BY 1
      150        BGCOLOR 8 .
      151   DEFINE VARIABLE R-date AS INTEGER
      152        VIEW-AS RADIO-SET VERTICAL
      153        RADIO-BUTTONS
      154             "Только дата объекта", 0,
      155   "Сменная дата объекта(Смена+№)", 1,
      156   "Дата и время сервера", 2
      157        SIZE 33 BY 2.25 NO-UNDO.
      158   DEFINE VARIABLE T-cash-pay AS LOGICAL INITIAL no
      159        LABEL "По типам кассовых платежей"
      160        VIEW-AS TOGGLE-BOX
      161        SIZE 29 BY .83 NO-UNDO.
      162   DEFINE VARIABLE T-cass AS LOGICAL INITIAL no
      163        LABEL "По кассам"
      164        VIEW-AS TOGGLE-BOX
      165        SIZE 29 BY .83 NO-UNDO.
      166   DEFINE VARIABLE T-child AS LOGICAL INITIAL no
      167        LABEL "Есть подчиненные типы прайс-листов"
      168        VIEW-AS TOGGLE-BOX
      169        SIZE 38 BY .83 NO-UNDO.
      170   DEFINE VARIABLE T-currency AS LOGICAL INITIAL no
      171        LABEL "Валюта"
      172        VIEW-AS TOGGLE-BOX
      173        SIZE 29 BY .83 NO-UNDO.
      174   DEFINE VARIABLE T-date-time-server AS LOGICAL INITIAL no
      175        LABEL "Дата-время сервера"
      176        VIEW-AS TOGGLE-BOX
      177        SIZE 29 BY .83 NO-UNDO.
      178   DEFINE VARIABLE T-group-buer AS LOGICAL INITIAL no
      179        LABEL "Группы покупателей"
      180        VIEW-AS TOGGLE-BOX
      181        SIZE 29 BY .83 NO-UNDO.
      182   DEFINE VARIABLE T-group-qnty AS LOGICAL INITIAL no
      183        LABEL "Количественные группы"
      184        VIEW-AS TOGGLE-BOX
      185        SIZE 29 BY .83 NO-UNDO.
      186   DEFINE VARIABLE T-group-summ AS LOGICAL INITIAL no
      187        LABEL "Суммовые группы"
      188        VIEW-AS TOGGLE-BOX
      189        SIZE 29 BY .83 NO-UNDO.
      190   DEFINE VARIABLE T-main-price-list AS LOGICAL INITIAL no
      191        LABEL "Только главные прайс-листы"
      192        VIEW-AS TOGGLE-BOX
      193        SIZE 29 BY .83 NO-UNDO.
      194   DEFINE VARIABLE T-no-base-edizm AS LOGICAL INITIAL no
      195        LABEL "Не базовая единица"
      196        VIEW-AS TOGGLE-BOX
      197        SIZE 29 BY .83 NO-UNDO.
      198   DEFINE VARIABLE T-pal-nws AS LOGICAL INITIAL no
      199        LABEL "Цены по новостям ходят только в свои УБД"
      200        VIEW-AS TOGGLE-BOX
      201        SIZE 44 BY .83 NO-UNDO.
      202   DEFINE VARIABLE T-pay-type AS LOGICAL INITIAL no
      203        LABEL "По типам оплат"
      204        VIEW-AS TOGGLE-BOX
      205        SIZE 29 BY .83 NO-UNDO.
      206   DEFINE VARIABLE T-shift-obj AS LOGICAL INITIAL no
      207        LABEL "Сменная дата-номер объекта"
      208        VIEW-AS TOGGLE-BOX
      209        SIZE 29 BY .83 NO-UNDO.
      210   DEFINE VARIABLE T-summ-oborot AS LOGICAL INITIAL no
      211        LABEL "Суммарный оборот покупателя"
      212        VIEW-AS TOGGLE-BOX
      213        SIZE 30 BY .83 NO-UNDO.
      214   DEFINE FRAME Dialog-Frame
      215        B-OK AT ROW 1 COL 1
      216        B-Cancel AT ROW 1 COL 13
      217        B-Help AT ROW 1 COL 67.5
      218        T-main-price-list AT ROW 2.25 COL 2
      219        T-group-buer AT ROW 3 COL 2
      220        T-summ-oborot AT ROW 3.75 COL 2
      221        T-group-qnty AT ROW 4.5 COL 2
      222        T-group-summ AT ROW 5.25 COL 2
      223        T-no-base-edizm AT ROW 6 COL 2
      224        R-date AT ROW 6.79 COL 2 NO-LABEL WIDGET-ID 4
      225        T-date-time-server AT ROW 7.5 COL 40.5
      226        T-shift-obj AT ROW 8.25 COL 40.5
      227        T-currency AT ROW 9.08 COL 2
      228        T-cass AT ROW 9.83 COL 2
      229        T-pay-type AT ROW 10.58 COL 2
      230        T-cash-pay AT ROW 11.33 COL 2
      231        T-child AT ROW 12.08 COL 2 WIDGET-ID 2
      232        T-pal-nws AT ROW 13 COL 2 WIDGET-ID 8
      233        SPACE(44.37) SKIP(1.00)
      234       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      235            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      236            TITLE "Глобальные настройки ценообразования"
      237            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
      238   ASSIGN
      239          T-date-time-server:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      240   ASSIGN
      241          T-shift-obj:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      242   ON GO OF FRAME Dialog-Frame
      243   DO:
      244     run save-proc in this-procedure  no-error .
      245     if error-status :error then return no-apply.
      246   END.
      247   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      248   DO:
      249     APPLY "END-ERROR":U TO SELF.
      250   END.
      251   ON VALUE-CHANGED OF R-date IN FRAME Dialog-Frame
      252   DO:
      253     assign r-date.
      254     case r-date :
      255        when 0 then
      256         assign
      257           t-date-time-server  = no
      258           T-shift-obj = no
      259           .
      260        when 1 then
      261          assign
      262           t-date-time-server  = no
      263           T-shift-obj = yes
      264           .
      265        when 2 then
      266          assign
      267            t-date-time-server  = yes
      268            T-shift-obj = no
      269           .
      270     end case.
      271   END.
      272   ON VALUE-CHANGED OF T-main-price-list IN FRAME Dialog-Frame
      273   DO:
      274     ASSIGN t-main-price-list.
      275     IF t-main-price-list THEN DO:
      276         ASSIGN
      277             T-currency          = false
      278             T-date-time-server  = false
      279             T-group-buer        = false
      280             T-group-qnty        = false
      281             T-group-summ        = false
      282             T-shift-obj         = false
      283             T-summ-oborot       = false
      284             T-pay-type          = false
      285             T-cash-pay          = false
      286             T-cass              = false
      287             T-child             = false
      288             r-date              = 0
      289             .
      290         display
      291             T-currency T-group-buer T-group-qnty T-group-summ T-no-base-edizm  T-summ-oborot
      292             T-cass
      293             T-child
      294             T-pay-type
      295             T-cash-pay
      296             r-date
      297             WITH FRAME Dialog-Frame.
      298         DISABLE
      299             T-currency T-date-time-server T-group-buer T-group-qnty T-group-summ  T-shift-obj T-summ-oborot
      300             T-cass
      301             T-child
      302             T-pay-type
      303             T-cash-pay
      304             r-date
      305             WITH FRAME Dialog-Frame.
      306     END.
      307     ELSE DO:
      308         ENABLE
      309             t-child
      310             T-currency  T-group-buer T-group-qnty T-group-summ T-no-base-edizm  T-summ-oborot
      311             T-pay-type
      312             T-cash-pay
      313             r-date
      314             with frame Dialog-Frame .
      315     END.
      316      run enable_sp1 in this-procedure .
      317   END.
      318   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      319   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      320   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   on help of frame Dialog-Frame
      322   do:
      323     run gbl/app_help.p
      324       (input this-procedure :file-name
      325       ,input ''
      326       ,input ?
      327       ) no-error.
      328     if error-status :error then do:
      329       message
      330         "Ошибка при вызове помощи"
      331         error-status :get-message(1)
      332         view-as alert-box .
      333     end.
      334   end.
      335   run minbtn-set in this-procedure .
      336   on choose of b-help in frame Dialog-Frame
      337   do:
      338     apply "help":u to frame Dialog-Frame .
      339   end.
      340   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      341   procedure minbtn-set :
      342       do
      343           on error undo, return error return-value
      344           :
      345           define variable ii              as integer       no-undo .
      346           define variable fh              as widget-handle no-undo .
      347           define variable hh              as widget-handle no-undo .
      348           define variable v-h             as handle        extent 4 no-undo .
      349           define variable v-name-button   as character     no-undo .
      350           define variable v-help-old-x    as decimal       no-undo .
      351           define variable v-help-old-y    as decimal       no-undo .
      352           define variable v-help-old-size as decimal       no-undo .
      353           define variable v-frame-width   as decimal       no-undo .
      354           define variable jj              as integer       no-undo .
      355           do
      356               on error undo, return error
      357               :
      358               assign
      359                   v-frame-width = frame Dialog-Frame:width - 0.3
      360                   fh            = frame Dialog-Frame:first-child
      361                   hh            = fh:first-child
      362                   ii            = 1
      363                   .
      364               do while valid-handle(hh):
      365                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      366                   do:
      367                       case lc(hh:name) :
      368                           when "b-help" then
      369                               do:
      370                                   hh:load-image-up("cmp/b-help.bmp":u) .
      371                                   hh:load-image-down("cmp/b-help.bmp":u) .
      372                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      373                                   hh:TOOLTIP = "Помощь" .
      374                                   v-help-old-x = hh:column .
      375                                   v-help-old-y = hh:row    .
      376                                   v-help-old-size = hh:width .
      377                                   hh:width-chars = 2.5 .
      378                               end.
      379                           when "b-print" then
      380                               do:
      381                                   hh:load-image("cmp/b-print.bmp":u) .
      382                                   hh:TOOLTIP = "Печать" .
      383                                   v-h[ii] = hh:handle .
      384                                   ii = ii + 1 .
      385                                   hh:width-chars = 3 .
      386                               end.
      387                           when "b-history" or
      388                           when "b-hist" then
      389                               do:
      390                                   hh:load-image("cmp/b-hist.bmp":u) .
      391                                   hh:TOOLTIP = "История" .
      392                                   v-h[ii] = hh:handle .
      393                                   ii = ii + 1 .
      394                                   hh:width-chars = 3 .
      395                               end.
      396                           when "b-sch" then
      397                               do:
      398                                   hh:load-image("cmp/b-sch.bmp":u) .
      399                                   hh:TOOLTIP = "Установка Фильтра" .
      400                                   v-h[ii] = hh:handle .
      401                                   ii = ii + 1 .
      402                                   hh:width-chars = 3 .
      403                               end.
      404                           when "b-hist-user" then
      405                               do:
      406                                   hh:load-image("cmp/b-hist.bmp":u) .
      407                                   hh:TOOLTIP = "История пользователя" .
      408                                   ii = ii + 1 .
      409                               end.
      410                       end case.
      411                   end.
      412                   hh = hh:next-sibling.
      413               end.
      414               b-help:column = v-frame-width - b-help:width-chars.
      415               jj = 0.
      416               repeat ii = 4 to 1 by -1 :
      417                   if valid-handle (v-h[ii] ) then
      418                   do:
      419                       jj  = jj + 1 .
      420                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      421                       v-h[ii]:row    = v-help-old-y .
      422                   end.
      423               end.
      424           end.
      425       end.
      426   end procedure.
      427   MAIN-BLOCK:
      428   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      429      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      430     run init-proc in this-procedure .
      431     if v-db-num = 0 then do:
      432       apply "VALUE-CHANGED" to T-main-price-list in frame Dialog-Frame .
      433     end.
      434     else run my-enable in this-procedure  .
      435     T-cass = false .
      436     disable T-cass with frame Dialog-Frame .
      437     WAIT-FOR GO OF FRAME Dialog-Frame.
      438   END.
      439   run disable_ui in this-procedure .
      440   PROCEDURE disable_UI :
      441     HIDE FRAME Dialog-Frame.
      442   END PROCEDURE.
      443   PROCEDURE enable_sp :
      444     DISPLAY T-main-price-list T-group-buer T-summ-oborot T-group-qnty T-group-summ
      445             T-no-base-edizm R-date T-currency T-cass T-pay-type T-cash-pay T-child
      446         WITH FRAME Dialog-Frame.
      447     ENABLE B-OK B-Cancel B-Help
      448            T-main-price-list
      449            T-group-buer
      450            T-no-base-edizm
      451            T-cash-pay
      452         WITH FRAME Dialog-Frame.
      453     disable
      454             T-summ-oborot
      455             T-group-qnty
      456             T-group-summ
      457             R-date
      458             T-currency
      459             T-cass
      460             T-pay-type
      461             T-child
      462         WITH FRAME Dialog-Frame.
      463     VIEW FRAME Dialog-Frame.
      464   END PROCEDURE.
      465   PROCEDURE enable_sp1 :
      466     DISPLAY T-main-price-list T-group-buer T-summ-oborot T-group-qnty T-group-summ
      467             T-no-base-edizm R-date T-currency T-cass T-pay-type T-cash-pay T-child
      468         WITH FRAME Dialog-Frame.
      469     ENABLE B-OK B-Cancel B-Help
      470            T-main-price-list
      471            T-group-buer
      472            T-summ-oborot
      473            T-group-qnty
      474            T-group-summ
      475            T-no-base-edizm
      476             R-date
      477             T-currency
      478             T-pay-type
      479             T-cash-pay
      480             T-child
      481             t-pal-nws
      482         WITH FRAME Dialog-Frame.
      483     disable
      484             T-cass
      485         WITH FRAME Dialog-Frame.
      486     VIEW FRAME Dialog-Frame.
      487   END PROCEDURE.
      488   PROCEDURE enable_UI :
      489     DISPLAY T-main-price-list T-group-buer T-summ-oborot T-group-qnty T-group-summ
      490             T-no-base-edizm R-date T-currency T-cass T-pay-type T-cash-pay T-child
      491             T-pal-nws
      492         WITH FRAME Dialog-Frame.
      493     ENABLE B-OK B-Cancel B-Help T-main-price-list T-group-buer T-summ-oborot
      494            T-group-qnty T-group-summ T-no-base-edizm R-date T-currency T-cass
      495            T-pay-type T-cash-pay T-child T-pal-nws
      496         WITH FRAME Dialog-Frame.
      497     VIEW FRAME Dialog-Frame.
      498   END PROCEDURE.
      499   PROCEDURE init-proc :
      500   define variable loc#log as logical   no-undo .
      501   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   do:
      503     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      504       (input  v-cntxt-db-num
      505       ,input  v-cntxt-userid
      506       ,input  0
      507       ,input  'actn_global-state_lookup':U
      508       ,input  'global':U
      509       ,input  0
      510       ,input  '':U
      511       ,input  0
      512       ,input  0
      513       ,input  0
      514       ,input  0
      515       ,input  true
      516       ,output loc#log
      517       )  .
      518   end.
      519     if loc#log <> yes then do:
      520        return error.
      521     end.
      522    find first  buf_global-state no-lock no-error .
      523    if not available buf_global-state then create buf_global-state .
      524       assign
      525         T-main-price-list  = logical ( buf_global-state.db-num-chg )
      526         T-group-buer       = buf_global-state.pl-use-grp-buy
      527         T-summ-oborot      = buf_global-state.pl-use-oborot-buy
      528         T-group-qnty       = buf_global-state.pl-use-qnty-group
      529         T-group-summ       = buf_global-state.pl-use-sum-group
      530         T-no-base-edizm    = buf_global-state.pl-use-add-code
      531         T-date-time-server = buf_global-state.pl-use-sys-date-time
      532         T-shift-obj        = buf_global-state.pl-use-shift-date-num
      533         T-cass             = buf_global-state.pl-use-cassa
      534         T-child            = buf_global-state.pl-use-child
      535         T-currency         = buf_global-state.pl-use-val
      536         T-pay-type         = buf_global-state.pl-use-pay-type
      537         T-cash-pay         = buf_global-state.pl-use-cash-pay
      538       .
      539       r-date = 0.
      540       if t-date-time-server = true then r-date = 2.
      541       if T-shift-obj = true then r-date = 1.
      542       find first buf_global-state-attr no-lock where
      543                  buf_global-state-attr.gls-id = buf_global-state.gls-id and
      544                  buf_global-state-attr.attr-code = 'pal-nws':U no-error .
      545       if not available buf_global-state-attr then do:
      546                 create buf_global-state-attr.
      547                 assign
      548                   buf_global-state-attr.gls-id  = buf_global-state.gls-id
      549                   buf_global-state-attr.attr-code  = 'pal-nws':U
      550                   buf_global-state-attr.attr-value = 'no'
      551                 .
      552        end.
      553        assign
      554         T-pal-nws = logical(buf_global-state-attr.attr-value) no-error
      555        .
      556        if error-status :error then T-pal-nws = false .
      557   display T-main-price-list
      558           T-group-buer
      559           T-summ-oborot
      560           T-group-qnty
      561           T-group-summ
      562           T-no-base-edizm
      563           T-currency
      564           T-pay-type
      565           T-cash-pay
      566           r-date
      567           T-pal-nws
      568           with frame Dialog-Frame .
      569   END PROCEDURE.
      570   PROCEDURE my-enable :
      571     DISPLAY T-main-price-list T-group-buer
      572             T-summ-oborot T-group-qnty T-group-summ
      573             T-no-base-edizm T-date-time-server
      574             T-shift-obj T-currency t-cass t-child
      575             T-pay-type      T-cash-pay
      576             T-pal-nws
      577         WITH FRAME Dialog-Frame.
      578     ENABLE B-Cancel b-help
      579         WITH FRAME Dialog-Frame.
      580     VIEW FRAME Dialog-Frame.
      581     B-Cancel:label = "Выход" .
      582   END PROCEDURE.
      583   PROCEDURE save-proc :
      584   define variable loc#log as logical   no-undo .
      585   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   do:
      587     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      588       (input  v-cntxt-db-num
      589       ,input  v-cntxt-userid
      590       ,input  0
      591       ,input  'actn_global-state_update':U
      592       ,input  'global':U
      593       ,input  0
      594       ,input  '':U
      595       ,input  0
      596       ,input  0
      597       ,input  0
      598       ,input  0
      599       ,input  true
      600       ,output loc#log
      601       )  .
      602   end.
      603     if loc#log <> yes then do: return error. end.
      604     assign  frame Dialog-Frame
      605       T-main-price-list
      606       T-group-buer
      607       T-summ-oborot
      608       T-group-qnty
      609       T-group-summ
      610       T-no-base-edizm
      611       T-date-time-server
      612       T-shift-obj
      613       T-currency
      614       t-cass
      615       t-child
      616       T-pay-type
      617       T-cash-pay
      618       r-date
      619       T-pal-nws
      620      .
      621        if  T-main-price-list  = true   and
      622             (T-currency         = true or
      623             T-date-time-server  = true or
      624             T-group-buer        = true or
      625             T-group-qnty        = true or
      626             T-group-summ        = true or
      627             T-cass              = true or
      628             T-child             = true or
      629             T-shift-obj         = true or
      630             T-pay-type          = true or
      631             T-cash-pay          = true or
      632             T-summ-oborot       = true  )  then do:
      633               message "Только Главные прайс-листы не могут быть выполнено !!!" view-as alert-box information .
      634               return error return-value .
      635        end.
      636     find current buf_global-state exclusive-lock no-error .
      637     if available buf_global-state then
      638     assign
      639       buf_global-state.pl-use-grp-buy         =  T-group-buer
      640       buf_global-state.pl-use-oborot-buy      =  T-summ-oborot
      641       buf_global-state.pl-use-qnty-group      =  T-group-qnty
      642       buf_global-state.pl-use-sum-group       =  T-group-summ
      643       buf_global-state.pl-use-add-code        =  T-no-base-edizm
      644       buf_global-state.pl-use-val             =  T-currency
      645       buf_global-state.pl-use-cassa           =  T-cass
      646       buf_global-state.pl-use-child           =  T-child
      647       buf_global-state.pl-use-cash-pay        =  T-cash-pay
      648       buf_global-state.pl-use-pay-type        =  T-pay-type
      649       buf_global-state.db-num-chg             =  integer(T-main-price-list)
      650     .
      651     case r-date :
      652         when 0 then
      653             assign
      654           t-date-time-server  = no
      655           T-shift-obj = no
      656           .
      657        when 1 then
      658             assign
      659           t-date-time-server  = no
      660           T-shift-obj = yes
      661           .
      662        when 2 then
      663        assign
      664           t-date-time-server  = yes
      665           T-shift-obj = no
      666           .
      667     end case.
      668       buf_global-state.pl-use-sys-date-time   =  T-date-time-server .
      669       buf_global-state.pl-use-shift-date-num  =  T-shift-obj        .
      670       find first buf_global-state-attr exclusive-lock where
      671                  buf_global-state-attr.gls-id = buf_global-state.gls-id and
      672                  buf_global-state-attr.attr-code = 'pal-nws':U no-error .
      673       if not available buf_global-state-attr then do:
      674                 create buf_global-state-attr.
      675                 assign
      676                   buf_global-state-attr.gls-id  = buf_global-state.gls-id
      677                   buf_global-state-attr.attr-code  = 'pal-nws':U
      678                 .
      679        end.
      680         buf_global-state-attr.attr-value = string(T-pal-nws)
      681         .
      682       for each  buf_global-state-attr          exclusive-lock where
      683                 buf_global-state-attr.gls-id = buf_global-state.gls-id and
      684                 buf_global-state-attr.attr-code begins 'level-discnt':U
      685                 :
      686                 delete buf_global-state-attr.
      687       end.
      688       if buf_global-state.whole-send-news = 0 then buf_global-state.whole-send-news = 1.
      689                                               else buf_global-state.whole-send-news = 0.
      690   END PROCEDURE.
