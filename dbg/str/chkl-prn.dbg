     1568   FOR EACH sheetf where sheetf.sheet-num > 1:
     1569     delete sheetf.
     1570   end.
     1571   FIND FIRST sheetf where
     1572              sheetf.sheet-num = 1 No-ERROR.
     1573   assign
     1574   ReportName = "Список чеков "
     1575   sheetf.Excel-Column-Lable =  ""
     1576   sheetf.sizes = "".
     1577   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1578   l-col-pos = 1.
     1579   Assign l-col-type="CHARACTER" l-col-len=14 l-col-format= "X(14)"     l-col-lable="Номер чека в БД".
