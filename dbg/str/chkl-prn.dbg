     1614             ASSIGN
     1615               FRAME = FRAME Doc:HANDLE
     1616               DATA-TYPE = "CHARACTER"
     1617               FORMAT = "X(":U + string(l-col-len) + ")":U
     1618               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1619               ROW = 1
     1620               COLUMN = l-col-pos
     1621           .
     1622        assign
     1623        l-col-pos =  l-col-pos + l-col-len + 1
