     1096   define variable l-col-len          as integer no-undo .
     1097   define variable l-col-format       as character no-undo .
     1098   define variable l-col-lable        as character no-undo .
     1099   define variable v-dec-sep          as character no-undo init ? .
     1100   define variable v-th-sep           as character no-undo init ? .
     1101   define variable v-r-col-num        as integer no-undo .
     1102   define variable v-reg-replace      as logical no-undo .
     1103   define variable v-date-col-format  as character no-undo .
     1104   DEFINE VARIABLE last-col-num as integer no-undo.
     1105   run gbl/getlocal.p (
     1106                     output v-dec-sep
     1107                    ,output v-th-sep
     1108                    ,output v-sdate
     1109                    ,output v-shortdate
     1110                    ) no-error .
     1111   assign
     1112   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1113                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1114   .
     1115     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1116                                               INPUT p-dec-sep AS CHARACTER  ) :
     1117       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1118       IF TRIM( p-string ) = "0"                    OR
     1119          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1120          TRIM( p-string ) =       p-dec-sep + "00" OR
     1121          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1122          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1123                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1124       RETURN ( TRIM( v-string ) ).
     1125     END FUNCTION.
     1126   FUNCTION reg-output returns character( input p-string as character
     1127                                         ,input p-private-data as character
     1128                                         ,input p-replace as logical
     1129                                         ,input p-supress as logical
     1130                                         ,input p-dec-sep as character
     1131                                         ,input p-th-sep as character
     1132                                         ):
     1133   DEFINE VARIABLE v-reg-output as character no-undo .
     1134   DEFINE VARIABLE v-data-type as character no-undo .
     1135   DEFINE VARIABLE v-progress-format as character no-undo .
     1136   assign
     1137   v-progress-format = entry(1, p-private-data, chr(4))
     1138   v-data-type = entry(2, p-private-data, chr(4))
     1139   .
     1140   if p-string = ? then return chr(63).
     1141   if (v-data-type = "INTEGER"
     1142       OR v-data-type = "DECIMAL" ) THEN DO:
     1143     IF p-replace THEN DO:
     1144       assign
     1145         v-reg-output = replace( p-string
     1146                                         ,chr(44)
     1147                                         ,"":U
     1148                                       )
     1149         v-reg-output = trim(v-reg-output)
     1150       .
     1151     END.
     1152     else do:
     1153       v-reg-output = p-string.
     1154     end.
     1155     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1156     return v-reg-output.
     1157   end.
     1158     return p-string.
     1159   END FUNCTION.
     1160   procedure OpenForExcel :
     1161      define variable v-ch#ExcelApplication as com-handle no-undo .
     1162      define variable v-ch#Workbook         as com-handle no-undo .
     1163      define variable v-ch#Worksheet        as com-handle no-undo .
     1164      os-delete value( string( session:temp-directory ) +
     1165                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1166      os-delete value( string( session:temp-directory ) +
     1167                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1168      os-delete value( string( session:temp-directory ) +
     1169                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1170      if Make-Excel
     1171      then do:
     1172         output stream ForExcel to value( string( session:temp-directory +
     1173                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1174         assign
     1175            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1176            number-list = 1
     1177         .
     1178         if make-excel-com
     1179         then do:
     1180   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   if valid-handle(ch#WorkSheet) then
     1182   RELEASE OBJECT ch#WorkSheet no-error.
     1183   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   if valid-handle(ch#Workbook) then
     1185   RELEASE OBJECT ch#Workbook no-error.
     1186   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   if valid-handle(ch#ExcelApplication) then
     1188   RELEASE OBJECT ch#ExcelApplication no-error.
     1189            create "Excel.Application" ch#excelApplication connect no-error.
     1190            if error-status:error
     1191            then do :
     1192           create "Excel.Application" ch#excelApplication no-error.
     1193       if error-status :error then do:
     1194           message
     1195           "Ошибка при запуске Excel" skip
     1196           error-status :get-message(1) skip
     1197           view-as alert-box error .
     1198           undo, return error .
     1199       end.
     1200            end.
     1201            assign
     1202               num#str#  = 0.
     1203               v-ch#excelApplication  = ch#excelApplication.
     1204               v-ch#excelApplication:Interactive = false.
     1205               v-ch#excelApplication:ScreenUpdating = false.
     1206               v-ch#excelApplication:Visible = false.
     1207               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1208               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1209               v-ch#Worksheet = ch#WorkSheet.
     1210               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1211               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1212               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1213               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1214            no-error .
     1215            if error-status:error
     1216            then do:
     1217               Make-Excel-com = false .
     1218               Make-Excel = false .
     1219               output Stream  ForExcel close.
     1220               os-delete value( string( session:temp-directory ) +
     1221                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1222               os-delete value( string( session:temp-directory ) +
     1223                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1224               return.
     1225            end.
     1226         end.
     1227      end.
     1228   end.
     1229   procedure CloseForExcel :
     1230      define variable ii as integer no-undo .
     1231      define variable vsheet-num as integer no-undo.
     1232      if Make-Excel
     1233      then  do:
     1234         output Stream  ForExcel close.
     1235         os-delete value( string( session:temp-directory ) +
     1236                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1237         os-delete value( string( session:temp-directory ) +
     1238                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1239         define buffer buf_sheetf for sheetf.
     1240         find last buf_sheetf no-error .
     1241         if available buf_sheetf
     1242         then
     1243            vsheet-num = buf_sheetf.sheet-num.
     1244         if vsheet-num > 1
     1245         then do:
     1246            do ii = 2 to vsheet-num:
     1247               os-delete value( string( session:temp-directory ) +
     1248                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1249            end.
     1250         end.
