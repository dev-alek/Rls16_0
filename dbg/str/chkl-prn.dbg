     1596             ASSIGN
     1597               FRAME = FRAME top-Frame:HANDLE
     1598               ROW = 2
     1599               COLUMN = l-col-pos
     1600               screen-value = l-col-lable
     1601               WIDTH-CHARS = l-col-len
     1602               HEIGHT-CHARS = 3
