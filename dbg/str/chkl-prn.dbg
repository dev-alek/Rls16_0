     2700   FORM with FRAME Doc .
     2701   FORM HEADER
     2702   Line format "X(60)" AT 1 SKIP
     2703   string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     2704   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2705   VIEW stream PrnLibStream FRAME NBottomFrame .
     2706   PUT stream PrnLibStream UNFORMATTED
     2707   SPACE(10)
     2708   Reportname chr(10)
     2709   p-notes
     2710   SKIP(1).
     2711   display STREAM PrnLibStream with frame top-Frame .
     2712   run rep/extitle.p (1).
     2713   run waitfram-show in this-procedure ("Ждите...").
     2714   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2715   FOR EACH chk-list No-LOCK
     2716       BREAK
     2717       BY chk-list.doc-code :
     2718       for-chk-type = get-chk-type(chk-list.doc-code, chk-list.chk-type, chk-list.is-wth).
     2719     assign
     2720     accum-count = accum-count + 1
     2721     .
     2722     if use-column[1]
     2723     then  C-for-doc-code:screen-value = string(chk-list.doc-code, entry(1, c-for-doc-code:private-data, chr(4))).
     2724     if use-column[2]
     2725     then  C-for-chk-type:screen-value = string(get-chk-type(chk-list.doc-code, chk-list.chk-type, chk-list.is-wth ), entry(1, c-for-chk-type:private-data, chr(4))).
     2726     if use-column[3]
     2727     then  C-for-obj-code:screen-value = string(chk-list.obj-code, entry(1, c-for-obj-code:private-data, chr(4))).
     2728     if use-column[4]
     2729     then  C-for-obj-type:screen-value = string(chk-list.obj-type, entry(1, c-for-obj-type:private-data, chr(4))).
     2730     if use-column[5]
