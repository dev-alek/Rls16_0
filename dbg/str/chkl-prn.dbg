      350   define  stream PrnLibStream.
      351   procedure prn-lib-prn-file :
      352     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      353     define input parameter p-DIsabledoptions as integer no-undo .
      354     define variable v-report-name as character no-undo .
      355     define variable v-user-action as character no-undo .
      356     define variable v-printed     as logical   no-undo .
      357     define variable v-exist       as logical   no-undo .
      358     do
      359       on error undo, return error
      360       :
      361       run prn-lib-get-report-name  in this-procedure (
      362         input parParentProc
      363         ,output v-report-name
      364         ).
      365   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      367     (input  v-report-name
      368     ,input  2
      369     ,output v-exist
      370     )  .
      371       if NOT v-exist then
      372       DO:
      373         Message
      374           "Нет заданий на печать ! "
      375           view-as alert-box .
      376         Return  .
      377       End.
      378       run gbl/prnfilen.w
      379         (input  ""
      380         ,input  p-DisabledOptions
      381         ,input  string(v-report-name )
      382         ,input  7
      383         ,output v-user-action
      384         ,output v-printed
      385         ) .
      386       if v-printed then
      387       do:
      388         return "YES" .
      389       end.
      390       else
      391       do:
      392         return "NO" .
      393       end.
      394     end.
      395   end procedure.
      396   procedure prn-lib-open-stream :
      397     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      398     define input parameter p-page-size    as integer no-undo .
      399     define input parameter p-is-stream    as logical no-undo .
      400     define input parameter p-append       as logical no-undo .
      401     define variable v-report-name as character no-undo .
      402     do
      403       on error undo, return error
      404       :
      405       run prn-lib-get-report-name  in this-procedure (
      406         input parParentProc
      407         ,output v-report-name
      408         ).
      409       if p-is-stream then
      410       do:
      411         if p-append then
      412         do:
      413           output stream PrnLibStream to value( v-report-name )
      414             page-size value(p-page-size) append .
      415         end.
      416         if not p-append then
      417         do:
      418           output stream PrnLibStream to value( v-report-name )
      419             page-size value(p-page-size) .
      420         end.
      421       end.
      422       if not p-is-stream then
      423       do:
      424         if p-append then
      425         do:
      426           output to value( v-report-name )
      427             page-size value(p-page-size) append .
      428         end.
      429         if not p-append then
      430         do:
      431           output to value( v-report-name )
      432             page-size value(p-page-size) .
      433         end.
      434       end.
      435     end.
      436   end procedure.
      437   procedure prn-lib-open-exp :
      438     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      439     define input parameter p-is-stream    as logical no-undo .
      440     define input parameter p-is-append    as logical no-undo .
      441     define output parameter p-ReportFileName as char init "report" no-undo.
      442     define output parameter p-process as logical no-undo .
      443     define variable glog as logical no-undo .
      444     do
      445       on error undo, return error
      446       :
      447       SYSTEM-DIALOG GET-FILE p-ReportFileName
      448         TITLE      "Укажите путь"
      449         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      450         ASK-OVERWRITE
      451         CREATE-TEST-FILE
      452         SAVE-AS
      453         USE-FILENAME
      454         DEFAULT-EXTENSION "txt"
      455         UPDATE glog
      456         .
      457       if not glog then  return.
      458       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      459       if p-is-stream then
      460       do:
      461         if p-is-append then
      462         do:
      463           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      464         end.
      465         else
      466         do:
      467           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      468         end.
      469       end.
      470       else
      471       do:
      472         if p-is-append then
      473         do:
      474           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      475         end.
      476         else
      477         do:
      478           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      479         end.
      480       end.
      481       p-process = yes.
      482     end.
      483   end procedure.
      484   procedure prn-lib-get-report-name :
      485     define input parameter parParentProc  as widget-handle no-undo.
      486     define output parameter p-report-name as character no-undo .
      487     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      488   end procedure.
      489   procedure prn-lib-reportviewer-report-name :
      490     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      491     define input parameter p-report-name-html as character no-undo .
      492     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      493   end procedure.
      494   procedure prn-lib-reportviewer :
      495     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      496     define input parameter p-report-name-html as character no-undo .
      497     define input parameter p-param        as character no-undo .
      498     define variable v-excel           as character no-undo init 'TRUE' .
      499     define variable v-value-character as character no-undo .
      500     define variable v-value-integer   as character no-undo .
      501     define variable v-value-date      as date      no-undo .
      502     define variable v-value-decimal   as decimal   no-undo .
      503     define variable rep-excel         as logical   no-undo .
      504     define variable excel-string      as character no-undo .
      505     define variable v-param-type      as character no-undo .
      506     define variable v-tth             as handle    no-undo .
      507     run adm/shattri.p (
      508       input "get":U
      509       ,input  ""
      510       ,input  0
      511       ,input  'report-glob':U
      512       ,input  'rep-excel':U
      513       ,output v-value-character
      514       ,output v-value-date
      515       ,output v-value-decimal
      516       ,output v-value-integer
      517       ,output rep-excel
      518       ,output v-param-type
      519       ,INPUT-OUTPUT table-handle v-tth
      520       )  .
      521     if rep-excel then v-excel = "TRUE" .
      522     else v-excel = "FALSE" .
      523     if p-param eq ""
      524     then
      525        p-param = "EXCEL:" + v-excel.
      526     else
      527        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      528     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      529   end procedure.
