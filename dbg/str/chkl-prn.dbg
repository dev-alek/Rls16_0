     1639                                              (if l-col-type = "DATE"
     1640                                               then (
     1641                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1642                                                      then ";":U
     1643                                                      else "":U) +
     1644                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
