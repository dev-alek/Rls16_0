     1584      if l-col-pos > 320 then l-col-pos = 320 .
     1585     if use-column[1] = true then DO:
     1586           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1587             ASSIGN
     1588               FRAME = FRAME top-Frame:HANDLE
     1589               ROW = 1
     1590               COLUMN = l-col-pos
     1591               screen-value = Fill("-", l-col-len)
     1592               WIDTH-CHARS = l-col-len
     1593               HEIGHT-CHARS = 3
