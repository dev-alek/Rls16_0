     1630                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1631                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1632                                )
     1633   sheetf.sizes =  (if sheetf.sizes = ""
     1634                    then (sheetf.sizes + string(l-col-len))
     1635                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1636                   )
     1637   last-col-num = 1
