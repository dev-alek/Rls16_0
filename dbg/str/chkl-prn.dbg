     2971       DISPLAY stream  PrnLibStream with frame Doc.                                      DOWN 1 stream PrnLibStream with frame Doc.
     2972     end.
     2973   END.
     2974   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     2975   FInd first Sheetf where
     2976              Sheetf.sheet-num = 2 No-ERROR.
     2977   if not avail sheetf then
     2978   create sheetf.
     2979   assign
     2980   Sheetf.Sheet-num = 2
     2981   sheetf.Excel-Column-Lable =  "№ п/п,Действие,Множество"
     2982   sheetf.sizes = "3,10,40"
     2983   .
     2984   run rep/extitle.p (2).
     2985   do ii = 1 to num-entries (p-Notes, chr(10)):
     2986     assign
     2987     dopstr = substring (entry (ii, p-notes, chr(10)), 1, 1)
     2988     dopstr1 = substring (entry (ii, p-notes, chr(10)), 3)
     2989     .
     2990     if Make-Excel then  put   stream ForExcel unformatted
     2991     if use-column[1]
     2992     then (reg-output(
     2993                       string(string(ii), entry(1, c-for-doc-code:private-data, chr(4)))
     2994                      ,c-for-doc-code:private-data
     2995                      ,v-reg-replace
     2996                      ,no
     2997                      ,v-dec-sep
     2998                      ,v-th-sep)  +
     2999           (if 1 < last-col-num
     3000            then CHR(9)
     3001            else ""))
     3002     else "":U
     3003     if use-column[2]
     3004     then (reg-output(
     3005                       string(dopstr, entry(1, c-for-chk-type:private-data, chr(4)))
     3006                      ,c-for-chk-type:private-data
     3007                      ,v-reg-replace
     3008                      ,no
     3009                      ,v-dec-sep
     3010                      ,v-th-sep)  +
     3011           (if 2 < last-col-num
     3012            then CHR(9)
     3013            else ""))
     3014     else "":U
     3015     if use-column[3]
     3016     then (reg-output(
     3017                       dopstr1
     3018                      ,c-for-chk-date:private-data
     3019                      ,v-reg-replace
     3020                      ,no
     3021                      ,v-dec-sep
     3022                      ,v-th-sep)  +
     3023           (if 3 < last-col-num
     3024            then CHR(9)
     3025            else ""))
     3026     else "":U
     3027     skip.
     3028   end.
     3029   HIDE STREAM PrnLibStream FRAME DOc .
     3030   HIDE STREAM PrnLibStream FRAME top-Frame .
     3031   HIDE stream PrnLibStream FRAME NBottomFrame .
     3032   output stream PrnLibStream CLOSE .
     3033   if Make-Excel then output stream ForExcel close.
     3034   run waitfram-hide in this-procedure .
     3035   DELETE WIDGET-POOL "My-pool".
     3036   if Make-Excel then do:
     3037      run rep/runexcel.p (
     3038                      string( session:temp-directory +
     3039                            "rpt" +
     3040                            string( g#report-num ) + ".txt":U )
     3041                    ) .
     3042   end.
     3043   if Make-Excel then
     3044   RUN CLoseForExcel in this-procedure .
     3045   FUNCTION get-chk-type RETURNS CHARACTER
     3046     ( LOC-DOC-CODE AS CHARACTER, loc-chk-type as integer, loc-is-wth as logical ) :
     3047   define buffer buf_chk-doc for ub.chk-doc.
     3048   define buffer buf_chk-gds for ub.chk-gds.
     3049   define variable v-str as character no-undo.
     3050   CASE loc-is-wth:
     3051       when yes then do:
     3052       assign
     3053       v-str = entry (lookup (string(loc-chk-type),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U)
     3054       no-error
     3055       .
     3056     end.
     3057     when no then do:
     3058         if loc-chk-type = ?
     3059         or loc-chk-type = 0
     3060         then do:
     3061           find first buf_chk-doc no-lock where
     3062                     buf_chk-doc.doc-code = loc-doc-code no-error .
     3063           if available buf_chk-doc then do:
     3064             assign
     3065             loc-chk-type = integer(if buf_chk-doc.netto >= 0
     3066                     then '1':U
     3067                     else '6':U)
     3068             .
     3069           end.
     3070           if loc-chk-type = integer('6':U) then do:
     3071             for each buf_chk-gds no-lock where
     3072                     buf_Chk-gds.doc-code = buf_chk-doc.doc-code:
     3073               if not (buf_Chk-gds.write-off-code < 0 and
     3074                       (buf_Chk-gds.write-off-code = integer('-9':U)
     3075                       or
     3076                       buf_Chk-gds.write-off-code = integer('-4':U)
     3077                       )
     3078                       )
     3079               then do:
     3080                 leave.
     3081               end.
     3082             end.
     3083           end.
     3084           if not available buf_chk-gds then
     3085           loc-chk-type = integer('96':U).
     3086         end.
     3087         assign
     3088         v-str = entry (lookup (string(loc-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     3089         no-error
     3090         .
     3091     end.
     3092   END CASE.
     3093   RETURN v-str.
     3094   END FUNCTION.
