      591   def
      592   new shared
      593   temp-table  obj-list no-undo
      594     field obj-type like ub.clients.obj-type
      595     field obj-code like ub.clients.obj-code
      596     field obj-name like ub.clients.obj-name
      597     field obj-id   as integer
      598     field db-num   as integer
      599     index pi is primary unique obj-id
      600     index ie1 obj-type obj-code
      601     index ie2 obj-name
      602   .
      603   procedure create_obj-list :
      604      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      605      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      606      do
      607      on error undo, return error return-value
      608      :
      609         define buffer cli-obj for ub.clients .
      610         define variable p-var as integer no-undo .
      611         define buffer buf_obj-list for obj-list .
      612         find last buf_obj-list  use-index pi no-error .
      613         if available buf_obj-list
      614         then
      615            p-var = buf_obj-list.obj-id + 1.
      616         else
      617            p-var = 1.
      618         find first cli-obj where
      619                   cli-obj.obj-type = p-obj-type
      620               and cli-obj.obj-code = p-obj-code
      621         no-lock no-error.
      622         if available cli-obj
      623         then do:
      624            create buf_obj-list.
      625            assign
      626               buf_obj-list.obj-id   = p-var
      627               buf_obj-list.obj-code = cli-obj.obj-code
      628               buf_obj-list.obj-type = cli-obj.obj-type
      629               buf_obj-list.obj-name = cli-obj.obj-name
      630               buf_obj-list.db-num   = cli-obj.db-num
      631            .
      632         end.
      633      end.
      634   end.
