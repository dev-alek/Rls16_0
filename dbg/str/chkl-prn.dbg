     1262   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   define variable v-waitfram-action01         as character   no-undo .
     1264   define variable v-waitfram-action02         as character   no-undo .
     1265   define variable v-waitfram-action03         as character   no-undo .
     1266   define variable mWaitFramTextBeg            as character   no-undo.
     1267   define variable mWaitFramTextEnd            as character   no-undo.
     1268   define variable mWaitFramView               as logical     no-undo.
     1269   define variable mWaitProcEvent              as logical     no-undo init yes.
     1270   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1271   define variable mWaitFramStop               as logical     no-undo.
     1272   define variable mWaitFramStopUser           as logical     no-undo.
     1273   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1274   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1275   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1276   define button B-WaitFramStop auto-end-key
     1277        label "Стоп"
     1278        size 10 by 1 tooltip "Остоновить процесс".
     1279   define button B-viewProcInfo
     1280        label "Информация"
     1281        size 15 by 1 tooltip "Информация о процесс".
     1282   define frame waitfram
     1283     v-waitfram-action01 format "x(72)" no-label skip
     1284     v-waitfram-action02 format "x(72)" no-label skip
     1285     v-waitfram-action03 format "x(72)" no-label skip
     1286     B-viewProcInfo
     1287     B-WaitFramStop at row 4 col 30
     1288     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1289     .
     1290   define new global shared variable mBatchMode as logical no-undo init ?.
     1291   define variable mFramBachModHandle as handle no-undo.
     1292   mFramBachModHandle = frame waitfram:handle.
     1293   define variable mFameOldVis as logical no-undo.
     1294   define variable mVisCUrentVin as logical no-undo.
     1295   if session:batch-mode
     1296   then
     1297      mBatchMode = yes.
     1298   if mBatchMode = ? then do:
     1299     mVisCUrentVin = current-window:visible.
     1300     mFameOldVis = mFramBachModHandle:visible.
     1301     mFramBachModHandle:visible  = yes.
     1302     mBatchMode = mFramBachModHandle:visible ne yes.
     1303     mFramBachModHandle:visible = mFameOldVis.
     1304     current-window:visible = mVisCUrentVin.
     1305   end.
     1306    if  log-manager:logfile-name ne ?
     1307     then DO:
     1308         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1309         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1310         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1311     end.
     1312   on choose of B-WaitFramStop in frame waitfram
     1313   do:
     1314     mWaitFramStop = yes.
     1315     mWaitFramStopUser = yes.
     1316   end.
     1317   function waitfram-check-timeout returns logical():
     1318      define variable vtime as int64 no-undo.
     1319      if mWaitFramStopTimeOut
     1320      then
     1321         return yes.
     1322      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1323      if     mWaitFramTimeOut ne ?
     1324         and mWaitFramTimeOut ne 0
     1325         and mWaitFramTimeOut lt vtime
     1326      then do:
     1327         mWaitFramStopTimeOut = yes.
     1328      end.
     1329      return mWaitFramStopTimeOut.
     1330   end.
     1331   procedure waitfram-hide :
     1332     if not session:batch-mode
     1333     then do
     1334     on error undo, return error return-value
     1335     :
     1336       pause 0 before-hide .
     1337       if not mBatchMode then
     1338         hide frame waitfram .
     1339     if     not mWaitFramView
     1340        and mWaitProcEvent
     1341     then
     1342       process events .
     1343     end.
     1344   end procedure.
     1345   procedure waitfram-show :
     1346     define input  parameter p-message as character no-undo .
     1347     define variable v-left-margin as integer   no-undo .
     1348     if not session:batch-mode
     1349     then do
     1350     on error undo, return error return-value
     1351     :
     1352       if length(p-message) <= 70 then do:
     1353         assign
     1354           v-left-margin = integer((70 - length(p-message)) / 2)
     1355         .
     1356         assign
     1357           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1358         .
     1359         assign
     1360           v-waitfram-action01 = " "
     1361           v-waitfram-action02 = " "
     1362                                    + fill(" ", v-left-margin)
     1363                                    + p-message
     1364           v-waitfram-action03 = " "
     1365         .
     1366       end.
     1367       else do:
     1368         define variable vRindex1 as integer no-undo.
     1369         define variable vRindex2 as integer no-undo.
     1370         vRindex1 = r-index(p-message," ",70).
     1371         if vRindex1 = 0
     1372         then
     1373            vRindex1 = 70.
     1374         if length(p-message)  <= vRindex1 + 70 then do:
     1375           assign
     1376             v-waitfram-action01 = " "
     1377             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1378             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1379           .
     1380         end.
     1381         else do:
     1382           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1383           if vRindex2 <= vRindex1
     1384           then
     1385              vRindex2 = vRindex1 + 70.
     1386           assign
     1387             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1388             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1389             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1390           .
     1391         end.
     1392       end.
     1393       B-viewProcInfo:visible   in frame waitfram = no.
     1394       B-viewProcInfo:sensitive in frame waitfram = no.
     1395       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1396       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1397       if  (   mWaitFramView
     1398          or  mWaitProcEvent)
     1399          and not mBatchMode
     1400       then
     1401          display
     1402             v-waitfram-action01 skip
     1403             v-waitfram-action02 skip
     1404             v-waitfram-action03 skip
     1405          with frame waitfram .
     1406       if     mWaitFramView
     1407          then do:
     1408             if     mWaitFramInterval ne ?
     1409                and not mBatchMode
     1410             then
     1411                wait-for go of frame waitfram pause mWaitFramInterval.
     1412          end.
     1413          else
     1414             if     mWaitProcEvent
     1415                and not mBatchMode
     1416             then
     1417                process events .
     1418     end.
     1419   end procedure.
     1420      procedure waitfram-show-this:
     1421         define input  parameter iInterval as int64 no-undo.
     1422         define variable vtime as int64 no-undo.
     1423         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1424         mWaitFramInterval = iInterval.
     1425         run waitfram-show (substitute("&1&2 &3&4" ,
     1426                                       mWaitFramTextBeg ,
     1427                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1428                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1429                                       mWaitFramTextEnd
     1430                                      )
     1431                           ).
     1432      end.
     1433      procedure WaitFramRunPause:
     1434         define input  parameter iInterval as dec no-undo.
     1435         define variable vStart  as datetime-tz no-undo.
     1436         define variable vend    as datetime-tz no-undo.
     1437         define variable vint as int64 no-undo.
     1438         define variable vOk as logical no-undo.
     1439         vStart = now.
     1440         vend   = vStart.
     1441         publish "WaitFramPause" (iInterval,output vOk).
     1442         vend   =  now.
     1443         vint = vend - vStart.
     1444         vint = iInterval - vint / 1000.
     1445         if     not mWaitFramStop
     1446            and (   vint > 0
     1447                 or (    not vOk
     1448                     and iInterval eq ?
     1449                     )
     1450                 )
     1451         then
     1452            run waitfram-show-this (iInterval).
     1453         vend   =  now.
     1454         vint = vend - vStart.
     1455         vint = iInterval - vint / 1000.
     1456         if     not mWaitFramStop
     1457            and vint > 0
     1458         then do:
     1459            run gbl/pause.p (vint * 1000).
     1460         end.
     1461         if iInterval ne ?
     1462         then
     1463            publish "WaitFramStop".
     1464         waitfram-check-timeout().
     1465      end.
     1466      procedure WaitFramWaitFor:
     1467         define input  parameter iInterval as dec no-undo.
     1468         assign
     1469            mWaitFramStartProc   = now
     1470            mWaitFramStopUser    = no
     1471            mWaitFramStopTimeOut = no
     1472         .
     1473         block-wait:
     1474         do while not mWaitFramStop:
     1475            run WaitFramRunPause (iInterval).
     1476            if  waitfram-check-timeout()
     1477            then do:
     1478               leave block-wait.
     1479            end.
     1480         end.
     1481         run waitfram-hide.
     1482      end.
     1483   procedure waitfram-join :
     1484     define input  parameter p-line-1  as character no-undo .
     1485     define input  parameter p-line-2  as character no-undo .
     1486     define input  parameter p-line-3  as character no-undo .
     1487     define output parameter p-message as character no-undo .
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491       assign
     1492         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1493                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1494                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1495       .
     1496     end.
     1497   end procedure.
     1498   function waitfram-join-function returns character
     1499     (input p-line-1 as character
     1500     ,input p-line-2 as character
     1501     ,input p-line-3 as character
     1502     ).
     1503     define variable v-message as character no-undo .
     1504     run waitfram-join in this-procedure
     1505       (input  p-line-1
     1506       ,input  p-line-2
     1507       ,input  p-line-3
     1508       ,output v-message
     1509       ) .
     1510     return v-message .
     1511   end function .
     1512   FUNCTION get-chk-type RETURNS CHARACTER
     1513     ( input loc-doc-code as character,
     1514       input loc-doc-type as integer,
     1515       input loc-is-wth as logical)  FORWARD.
     1516   DEFINE STREAM PrnLibStream.
     1517   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1518        VIEW-AS EDITOR
     1519        SIZE 1 BY 4 NO-UNDO.
     1520   DEFINE FRAME top-frame
     1521       t-1       AT ROW 1 COL 1 no-label
     1522       HEADER
     1523       cur-time-print() AT 5 format "x(35)"
     1524       string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>9" SKIP
     1525       with width 232 down stream-io use-text NO-BOX.
     1526    DEFINE FRAME Doc
     1527      with width 232 down stream-io use-text NO-BOX.
     1528   CASE pReportOption:
