        1   block-level on error undo, throw.
        2   define new global shared variable g#language as character no-undo .
        3   if g#language <> '' and g#language <> 'rus':U then do:
        4     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        5   end.
        6   define new global shared variable g#library  as handle no-undo .
        7   define new global shared variable g#library2 as handle no-undo .
        8   define   shared variable g#auto as logical no-undo.
        9   define   shared variable g#news as logical no-undo.
       10   define   shared variable g#oxml as logical no-undo.
       11   define   shared variable g#esys as logical no-undo.
       12   define   shared variable g#news-source-db as integer no-undo.
       13   define   shared variable g#esys-source-esys as integer no-undo.
       14   define   shared variable g#db-num as integer   no-undo .
       15   define   shared variable g#userid as character no-undo .
       16   define   shared variable g#passwd as character no-undo .
       17   function fix-unit returns logical (input parunit-base as character):
       18     find first ub.units where ub.units.unit-name = parunit-base no-lock no-error.
       19     if not available ub.units then return ?.
       20     else do:
       21       if lookup('2ед':U,   ub.units.type) > 0 or
       22          lookup('топ':U, ub.units.type) > 0 then return yes.
       23                                                  else return no.
       24     end.
       25   end.
       26   define input parameter parunit-cli             like doc-line.unit-cli            no-undo.
       27   define input parameter pargds-code             like goods.gds-code               no-undo.
       28   define input parameter parobj-type             like clients.obj-type             no-undo.
       29   define input parameter parobj-code             like clients.obj-code             no-undo.
       30   define input parameter parhold-doc-code-parent like trn-doc.hold-doc-code-parent no-undo.
       31   define input parameter parhold-doc-code-child  like trn-doc.hold-doc-code-child  no-undo.
       32   define output parameter paris-error      as   logical             no-undo.
       33   define variable         varis-petrol     as   logical             no-undo.
       34   define variable         varis-pieces     as   logical             no-undo.
       35   define variable         varunit-cli-perm like store.unit-cli-perm no-undo.
       36   assign paris-error = no.
       37   find first goods   where goods.gds-code = pargds-code  no-lock.
       38   if parobj-type =  'скл':U then do:
       39     find first store where store.obj-code = parobj-code no-lock.
       40     assign
       41       varunit-cli-perm = store.unit-cli-perm.
       42   end.
       43   else do:
       44     find first shop where shop.obj-code = parobj-code no-lock.
       45     assign
       46       varunit-cli-perm = shop.unit-cli-perm.
       47   end.
       48   if parunit-cli <> goods.unit-cli then do:
       49     if ( varunit-cli-perm <> yes and
       50          (parhold-doc-code-parent = "" or
       51           parhold-doc-code-parent = "no-hold" or
       52           parhold-doc-code-parent = ?)
       53           and
       54          (parhold-doc-code-child = "" or
       55           parhold-doc-code-child = "no-hold" or
       56           parhold-doc-code-child = ?)
       57        )
       58        or fix-unit(ub.goods.unit-base) then do:
       59        paris-error = yes.
       60     end.
       61   end.
