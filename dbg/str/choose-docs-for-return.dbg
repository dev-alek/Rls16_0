        1   define input parameter p-reason as integer no-undo .
        2   define input parameter p-is-edo as logical no-undo .
        3   define input parameter in-doc-code as character no-undo .
        4   define output parameter p-doc-code as character no-undo .
        5   define temp-table tt-trn-doc no-undo like ub.trn-doc .
        6   define buffer buf_trn-doc for tt-trn-doc .
        7   define buffer in_trn-doc for ub.trn-doc .
        8   define buffer chs_trn-doc for ub.trn-doc .
        9   define buffer buf_utd for ub.utd .
       10   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
       11        LABEL "Выход"
       12        SIZE 15 BY 1.14
       13        BGCOLOR 8 .
       14   DEFINE BUTTON Btn_OK AUTO-GO
       15        LABEL "Выбор"
       16        SIZE 15 BY 1.14
       17        BGCOLOR 8 .
       18   DEFINE QUERY br-docs FOR
       19         buf_trn-doc SCROLLING.
       20   DEFINE BROWSE br-docs
       21     QUERY br-docs NO-LOCK DISPLAY
       22         buf_trn-doc.status_ FORMAT "X(8)":U WIDTH 8.2
       23         buf_trn-doc.flag_ FORMAT "+/-":U
       24         buf_trn-doc.doc-code FORMAT "X(14)":U
       25         buf_trn-doc.doc-date FORMAT "99/99/99":U
       26         buf_trn-doc.fact-date FORMAT "99/99/99":U
       27         buf_trn-doc.shift-date FORMAT "99/99/99":U
       28         buf_trn-doc.shift-name FORMAT "X(2)":U
       29         buf_trn-doc.cli-name FORMAT "X(40)":U
       30         buf_trn-doc.doc-qnty FORMAT "->>,>>>,>>9.<<<":U
       31         buf_trn-doc.fact-qnty FORMAT "->>,>>>,>>9.<<<":U
       32         buf_trn-doc.tot-doc FORMAT "->>>,>>>,>>9.99":U
       33         buf_trn-doc.tot-fact FORMAT "->>>,>>>,>>9.99":U
       34       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 14.05 FIT-LAST-COLUMN.
       35   DEFINE FRAME Dialog-Frame
       36        Btn_Cancel AT ROW 1.24 COL 2
       37        Btn_OK AT ROW 1.24 COL 17
       38        br-docs AT ROW 2.91 COL 3 WIDGET-ID 200
       39        SPACE(2.19) SKIP(0.74)
       40       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       41            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       42            TITLE "Выберите документ-источник"
       43            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
       44   ASSIGN
       45          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       46          FRAME Dialog-Frame:HIDDEN           = TRUE.
       47   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       48   DO:
       49     APPLY "END-ERROR":U TO SELF.
       50   END.
       51   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
       52   DO:
       53     if not available buf_trn-doc
       54     then return no-apply .
       55     p-doc-code = buf_trn-doc.doc-code .
       56   END.
       57   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       58   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       59   MAIN-BLOCK:
       60   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       61      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       62     run fill-tt .
       63     RUN enable_UI.
       64     WAIT-FOR GO OF FRAME Dialog-Frame.
       65   END.
       66   RUN disable_UI.
       67   procedure fill-tt :
       68     empty temp-table tt-trn-doc .
       69     find first in_trn-doc no-lock where in_trn-doc.doc-code = in-doc-code .
       70     for each chs_trn-doc no-lock where chs_trn-doc.cli-type = in_trn-doc.cli-type
       71                                    and chs_trn-doc.cli-code = in_trn-doc.cli-code
       72                                    and chs_trn-doc.host-code = in_trn-doc.host-code
       73                                    and chs_trn-doc.ext-doc-type = "ie"
       74                                    and chs_trn-doc.contract-code = in_trn-doc.contract-code
       75                                    and chs_trn-doc.status_ = "факт"
       76                                    :
       77       if p-is-edo
       78       then do :
       79         if p-reason = 23
       80         then do :
       81           create tt-trn-doc.
       82           buffer-copy chs_trn-doc to tt-trn-doc .
       83         end .
       84         if p-reason = 25
       85         then do :
       86           if can-find(first buf_utd no-lock where buf_utd.doc-code = chs_trn-doc.doc-code)
       87           then do :
       88             create tt-trn-doc.
       89             buffer-copy chs_trn-doc to tt-trn-doc .
       90           end .
       91         end .
       92       end .
       93       else do :
       94         if not can-find(first buf_utd no-lock where buf_utd.doc-code = chs_trn-doc.doc-code)
       95         then do :
       96           create tt-trn-doc.
       97           buffer-copy chs_trn-doc to tt-trn-doc .
       98         end .
       99       end .
      100     end .
      101   end procedure .
      102   PROCEDURE disable_UI :
      103     HIDE FRAME Dialog-Frame.
      104   END PROCEDURE.
      105   PROCEDURE enable_UI :
      106     ENABLE Btn_Cancel Btn_OK br-docs
      107         WITH FRAME Dialog-Frame.
      108     VIEW FRAME Dialog-Frame.
      109     OPEN QUERY br-docs FOR EACH buf_trn-doc no-lock by buf_trn-doc.fact-date desc INDEXED-REPOSITION.
      110   END PROCEDURE.
