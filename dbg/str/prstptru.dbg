        1   DEFINE PARAMETER BUFFER bf_goods FOR ub.goods.
        2   DEFINE PARAMETER BUFFER bf_place FOR ub.place.
        3   DEFINE INPUT  PARAMETER parcalc-petrol-volume AS LOGICAL   NO-UNDO.
        4   DEFINE INPUT  PARAMETER parmode               AS CHARACTER NO-UNDO.
        5   DEFINE INPUT  PARAMETER parwrite-off          AS LOGICAL   NO-UNDO.
        6   DEFINE INPUT  PARAMETER parfact-l             AS DECIMAL   NO-UNDO.
        7   DEFINE INPUT  PARAMETER parfact-kg            AS DECIMAL   NO-UNDO.
        8   DEFINE INPUT  PARAMETER parwork-l             AS DECIMAL   NO-UNDO.
        9   DEFINE INPUT  PARAMETER parwork-kg            AS DECIMAL   NO-UNDO.
       10   DEFINE INPUT  PARAMETER parwrite-off-doc-l    AS DECIMAL   NO-UNDO.
       11   DEFINE INPUT  PARAMETER parwrite-off-doc-kg   AS DECIMAL   NO-UNDO.
       12   DEFINE INPUT  PARAMETER parincome-doc-l       AS DECIMAL   NO-UNDO.
       13   DEFINE INPUT  PARAMETER parincome-doc-kg      AS DECIMAL   NO-UNDO.
       14   DEFINE OUTPUT PARAMETER parstate              AS LOGICAL   NO-UNDO.
       15   DEFINE OUTPUT PARAMETER parqnty-l             AS DECIMAL   NO-UNDO.
       16   DEFINE OUTPUT PARAMETER parqnty-kg            AS DECIMAL   NO-UNDO.
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "Установка значений в топливном товаре в пересортице".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   DEFINE BUTTON b-cancel AUTO-END-KEY
      127        LABEL "&Отмена"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE BUTTON b-help
      131        LABEL "&Помощь"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-save AUTO-GO
      135        LABEL "&Сохранить"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE VARIABLE vardensity AS DECIMAL FORMAT "9.9999999999":U INITIAL 0
      139        LABEL "Плотность"
      140        VIEW-AS FILL-IN
      141        SIZE 14 BY 1 NO-UNDO.
      142   DEFINE VARIABLE varfact-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      143        LABEL "Факт(л)"
      144        VIEW-AS FILL-IN
      145        SIZE 14 BY 1 NO-UNDO.
      146   DEFINE VARIABLE varfree-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      147        LABEL "Свободно(л)"
      148        VIEW-AS FILL-IN
      149        SIZE 14 BY 1 NO-UNDO.
      150   DEFINE VARIABLE varincome-doc-kg AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      151        LABEL "Оприходовано док(кг)"
      152        VIEW-AS FILL-IN
      153        SIZE 14 BY 1 NO-UNDO.
      154   DEFINE VARIABLE varincome-doc-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      155        LABEL "Оприходовано док(л)"
      156        VIEW-AS FILL-IN
      157        SIZE 14 BY 1 NO-UNDO.
      158   DEFINE VARIABLE varwork-kg AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999":U INITIAL 0
      159        LABEL "Кол-во(кг)"
      160        VIEW-AS FILL-IN
      161        SIZE 14 BY 1 NO-UNDO.
      162   DEFINE VARIABLE varwork-l AS DECIMAL FORMAT ">,>>>,>>>,>>9.9999":U INITIAL 0
      163        LABEL "Кол-во(л)"
      164        VIEW-AS FILL-IN
      165        SIZE 14 BY 1 NO-UNDO.
      166   DEFINE VARIABLE varwrite-off-doc-kg AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      167        LABEL "Списано док(кг)"
      168        VIEW-AS FILL-IN
      169        SIZE 14 BY 1 NO-UNDO.
      170   DEFINE VARIABLE varwrite-off-doc-l AS DECIMAL FORMAT "->,>>>,>>>,>>9.9999":U INITIAL 0
      171        LABEL "Списано док(л)"
      172        VIEW-AS FILL-IN
      173        SIZE 14 BY 1 NO-UNDO.
      174   DEFINE FRAME Dialog-Frame
      175        b-save AT ROW 1 COL 1
      176        b-cancel AT ROW 1 COL 11
      177        b-help AT ROW 1 COL 21
      178        varfact-l AT ROW 2.5 COL 20 COLON-ALIGNED
      179        varwork-l AT ROW 4 COL 20 COLON-ALIGNED
      180        vardensity AT ROW 4 COL 46.5 COLON-ALIGNED
      181        varwork-kg AT ROW 4 COL 78.5 COLON-ALIGNED
      182        varwrite-off-doc-l AT ROW 5.5 COL 20 COLON-ALIGNED
      183        varwrite-off-doc-kg AT ROW 5.5 COL 78.5 COLON-ALIGNED
      184        varincome-doc-l AT ROW 7 COL 20 COLON-ALIGNED
      185        varincome-doc-kg AT ROW 7 COL 78.5 COLON-ALIGNED
      186        varfree-l AT ROW 8.5 COL 20 COLON-ALIGNED
      187        SPACE(59.87) SKIP(0.32)
      188       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      189            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      190            TITLE "<insert dialog title>"
      191            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      192   ASSIGN
      193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      194          FRAME Dialog-Frame:HIDDEN           = TRUE.
      195   ON GO OF FRAME Dialog-Frame
      196   DO:
      197     IF parcalc-petrol-volume THEN DO:
      198       IF varwork-l = 0 OR
      199          varwork-l = ? THEN DO:
      200         MESSAGE "У Вас не установлено количество в литрах." VIEW-AS ALERT-BOX ERROR.
      201         APPLY "entry" TO varwork-l IN FRAME Dialog-Frame.
      202         RETURN NO-APPLY.
      203       END.
      204       IF vardensity = 0 OR
      205          vardensity = ? THEN DO:
      206         MESSAGE "У Вас не установлена плотность." VIEW-AS ALERT-BOX ERROR.
      207         APPLY "entry" TO vardensity IN FRAME Dialog-Frame.
      208         RETURN NO-APPLY.
      209       END.
      210     END.
      211     ELSE DO:
      212       IF varwork-kg = 0 OR
      213          varwork-kg = ? THEN DO:
      214         MESSAGE "У Вас не установлено количество в килограммах." VIEW-AS ALERT-BOX ERROR.
      215         APPLY "entry" TO varwork-kg IN FRAME Dialog-Frame.
      216         RETURN NO-APPLY.
      217       END.
      218       IF vardensity = 0 OR
      219          vardensity = ? THEN DO:
      220         MESSAGE "У Вас не установлена плотность." VIEW-AS ALERT-BOX ERROR.
      221         APPLY "entry" TO vardensity IN FRAME Dialog-Frame.
      222         RETURN NO-APPLY.
      223       END.
      224     END.
      225     ASSIGN
      226       parstate   = YES
      227       parqnty-l  = varwork-l
      228       parqnty-kg = varwork-kg.
      229   END.
      230   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      231   DO:
      232     APPLY "END-ERROR":U TO SELF.
      233   END.
      234   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      235   OR HELP OF FRAME Dialog-Frame
      236   DO:
      237     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\str\prstptru.w" VIEW-AS ALERT-BOX INFORMATION.
      238   END.
      239   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      240   DO:
      241   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   if lookup(self :type
      243            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      244            ) = 0
      245   then do:
      246     message
      247       "$Workfile$"
      248       "Указанному интерфейсному элементу фокус не может быть передан" skip
      249       "Интерфейсный элемент" self :name  skip
      250       "Тип" self :type  skip
      251       "Процедура" this-procedure :file-name skip
      252       view-as alert-box .
      253   end.
      254   else do:
      255     apply "entry":u to self  .
      256     if focus :handle <> self :handle  then do:
      257       return no-apply .
      258     end.
      259   end.
      260   END.
      261   ON LEAVE OF vardensity IN FRAME Dialog-Frame
      262   DO:
      263       if keyfunction(lastkey) <> "end-error" and
      264          not ( last-event :event-type   = "progress":u and
      265                last-event :widget-enter = b-cancel :handle ) then do:
      266        IF INPUT FRAME Dialog-Frame vardensity = 0.00 or
      267           INPUT FRAME Dialog-Frame vardensity = ?    THEN DO:
      268           MESSAGE "Вы не установили плотность." VIEW-AS ALERT-BOX.
      269           RETURN NO-APPLY.
      270        END.
      271        ASSIGN
      272          FRAME Dialog-Frame vardensity.
      273        IF parcalc-petrol-volume THEN DO:
      274          IF varwork-l <> 0.00 AND
      275             varwork-l <> ?    THEN DO:
      276            ASSIGN
      277              varwork-kg = vardensity * varwork-l.
      278            DISPLAY varwork-kg WITH FRAME Dialog-Frame.
      279          END.
      280        END.
      281        ELSE DO:
      282          IF varwork-kg <> 0.00 AND
      283             varwork-kg <> ?    THEN DO:
      284            ASSIGN
      285              varwork-l = varwork-kg / vardensity.
      286            DISPLAY varwork-l WITH FRAME Dialog-Frame.
      287          END.
      288        END.
      289     END.
      290   END.
      291   ON LEAVE OF varwork-kg IN FRAME Dialog-Frame
      292   DO:
      293       if keyfunction(lastkey) <> "end-error" and
      294          not ( last-event :event-type   = "progress":u and
      295                last-event :widget-enter = b-cancel :handle ) then do:
      296        IF INPUT FRAME Dialog-Frame varwork-kg = 0.00 or
      297           INPUT FRAME Dialog-Frame varwork-kg = ?    THEN DO:
      298           MESSAGE "Вы не установили количество в килограммах." VIEW-AS ALERT-BOX.
      299           RETURN NO-APPLY.
      300        END.
      301        ASSIGN
      302          FRAME Dialog-Frame varwork-kg.
      303        IF vardensity <> 0.00 AND
      304           vardensity <> ?    THEN DO:
      305          ASSIGN
      306            varwork-l = varwork-l / vardensity.
      307          DISPLAY varwork-l WITH FRAME Dialog-Frame.
      308        END.
      309     END.
      310   END.
      311   ON return OF varwork-kg IN FRAME Dialog-Frame
      312   DO:
      313     APPLY "ENTRY" TO vardensity IN FRAME Dialog-Frame.
      314   END.
      315   ON LEAVE OF varwork-l IN FRAME Dialog-Frame
      316   DO:
      317     if keyfunction(lastkey) <> "end-error" and
      318        not ( last-event :event-type   = "progress":u and
      319              last-event :widget-enter = b-cancel :handle ) then do:
      320      IF INPUT FRAME Dialog-Frame varwork-l = 0.00 or
      321         INPUT FRAME Dialog-Frame varwork-l = ?    THEN DO:
      322         MESSAGE "Вы не установили количество в литрах." VIEW-AS ALERT-BOX.
      323         RETURN NO-APPLY.
      324      END.
      325      ASSIGN
      326        FRAME Dialog-Frame varwork-l.
      327      IF vardensity <> 0.00 AND
      328         vardensity <> ?    THEN DO:
      329        ASSIGN
      330          varwork-kg = vardensity * varwork-l.
      331        DISPLAY varwork-kg WITH FRAME Dialog-Frame.
      332      END.
      333    END.
      334   END.
      335   ON return OF varwork-l IN FRAME Dialog-Frame
      336   DO:
      337     APPLY "ENTRY" TO vardensity IN FRAME Dialog-Frame.
      338   END.
      339   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      340   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      341   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   on help of frame Dialog-Frame
      343   do:
      344     run gbl/app_help.p
      345       (input this-procedure :file-name
      346       ,input ''
      347       ,input ?
      348       ) no-error.
      349     if error-status :error then do:
      350       message
      351         "Ошибка при вызове помощи"
      352         error-status :get-message(1)
      353         view-as alert-box .
      354     end.
      355   end.
      356   run minbtn-set in this-procedure .
      357   on choose of b-help in frame Dialog-Frame
      358   do:
      359     apply "help":u to frame Dialog-Frame .
      360   end.
      361   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   procedure minbtn-set :
      363       do
      364           on error undo, return error return-value
      365           :
      366           define variable ii              as integer       no-undo .
      367           define variable fh              as widget-handle no-undo .
      368           define variable hh              as widget-handle no-undo .
      369           define variable v-h             as handle        extent 4 no-undo .
      370           define variable v-name-button   as character     no-undo .
      371           define variable v-help-old-x    as decimal       no-undo .
      372           define variable v-help-old-y    as decimal       no-undo .
      373           define variable v-help-old-size as decimal       no-undo .
      374           define variable v-frame-width   as decimal       no-undo .
      375           define variable jj              as integer       no-undo .
      376           do
      377               on error undo, return error
      378               :
      379               assign
      380                   v-frame-width = frame Dialog-Frame:width - 0.3
      381                   fh            = frame Dialog-Frame:first-child
      382                   hh            = fh:first-child
      383                   ii            = 1
      384                   .
      385               do while valid-handle(hh):
      386                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      387                   do:
      388                       case lc(hh:name) :
      389                           when "b-help" then
      390                               do:
      391                                   hh:load-image-up("cmp/b-help.bmp":u) .
      392                                   hh:load-image-down("cmp/b-help.bmp":u) .
      393                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      394                                   hh:TOOLTIP = "Помощь" .
      395                                   v-help-old-x = hh:column .
      396                                   v-help-old-y = hh:row    .
      397                                   v-help-old-size = hh:width .
      398                                   hh:width-chars = 2.5 .
      399                               end.
      400                           when "b-print" then
      401                               do:
      402                                   hh:load-image("cmp/b-print.bmp":u) .
      403                                   hh:TOOLTIP = "Печать" .
      404                                   v-h[ii] = hh:handle .
      405                                   ii = ii + 1 .
      406                                   hh:width-chars = 3 .
      407                               end.
      408                           when "b-history" or
      409                           when "b-hist" then
      410                               do:
      411                                   hh:load-image("cmp/b-hist.bmp":u) .
      412                                   hh:TOOLTIP = "История" .
      413                                   v-h[ii] = hh:handle .
      414                                   ii = ii + 1 .
      415                                   hh:width-chars = 3 .
      416                               end.
      417                           when "b-sch" then
      418                               do:
      419                                   hh:load-image("cmp/b-sch.bmp":u) .
      420                                   hh:TOOLTIP = "Установка Фильтра" .
      421                                   v-h[ii] = hh:handle .
      422                                   ii = ii + 1 .
      423                                   hh:width-chars = 3 .
      424                               end.
      425                           when "b-hist-user" then
      426                               do:
      427                                   hh:load-image("cmp/b-hist.bmp":u) .
      428                                   hh:TOOLTIP = "История пользователя" .
      429                                   ii = ii + 1 .
      430                               end.
      431                       end case.
      432                   end.
      433                   hh = hh:next-sibling.
      434               end.
      435               b-help:column = v-frame-width - b-help:width-chars.
      436               jj = 0.
      437               repeat ii = 4 to 1 by -1 :
      438                   if valid-handle (v-h[ii] ) then
      439                   do:
      440                       jj  = jj + 1 .
      441                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      442                       v-h[ii]:row    = v-help-old-y .
      443                   end.
      444               end.
      445           end.
      446       end.
      447   end procedure.
      448   MAIN-BLOCK:
      449   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      450      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      451     assign
      452       frame Dialog-Frame :title = "Товар:  " + bf_goods.artic + " " + bf_goods.prod-type + " " + string(bf_goods.prod-code) + " " + bf_goods.gds-name + " Складское место: " + string(bf_place.pl-code) + "(" + bf_place.loc1 + ")" + " - " + parmode.
      453     .
      454     ASSIGN
      455       varfact-l           = parfact-l
      456       varwork-l           = parwork-l
      457       varwork-kg          = parwork-kg
      458       varwrite-off-doc-l  = parwrite-off-doc-l
      459       varwrite-off-doc-kg = parwrite-off-doc-kg
      460       varincome-doc-l     = parincome-doc-l
      461       varincome-doc-kg    = parincome-doc-kg
      462       varfree-l           = varfact-l  + (IF parwrite-off THEN - varwork-l  ELSE varwork-l)  - parwrite-off-doc-l  + parincome-doc-l
      463     .
      464     IF varwork-l <> 0 AND
      465        varwork-l <> ? THEN DO:
      466       ASSIGN
      467         vardensity = varwork-kg / varwork-l.
      468     END.
      469     RUN enable_UI.
      470     DISPLAY varfact-l  varwork-l varwork-kg varwrite-off-doc-l varwrite-off-doc-kg varincome-doc-l varincome-doc-kg varfree-l  WITH FRAME Dialog-Frame.
      471     IF parmode = 'ИЗМЕНЕНИЕ':U THEN DO:
      472       ENABLE b-save vardensity WITH FRAME Dialog-Frame.
      473       IF parcalc-petrol-volume = YES THEN DO:
      474         ENABLE varwork-l WITH FRAME Dialog-Frame.
      475         WAIT-FOR GO OF FRAME Dialog-Frame FOCUS varwork-l.
      476       END.
      477       ELSE DO:
      478         ENABLE varwork-kg WITH FRAME Dialog-Frame.
      479         WAIT-FOR GO OF FRAME Dialog-Frame FOCUS varwork-kg.
      480       END.
      481     END.
      482     ELSE DO:
      483       WAIT-FOR GO OF FRAME Dialog-Frame FOCUS b-cancel.
      484     END.
      485   END.
      486   RUN disable_UI.
      487   PROCEDURE disable_UI :
      488     HIDE FRAME Dialog-Frame.
      489   END PROCEDURE.
      490   PROCEDURE enable_UI :
      491     DISPLAY varfact-l varwork-l vardensity varwork-kg varwrite-off-doc-l
      492             varwrite-off-doc-kg varincome-doc-l varincome-doc-kg varfree-l
      493         WITH FRAME Dialog-Frame.
      494     ENABLE b-cancel b-help
      495         WITH FRAME Dialog-Frame.
      496     VIEW FRAME Dialog-Frame.
      497   END PROCEDURE.
