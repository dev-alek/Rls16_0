        1    define  temp-table temp-list-buyer no-undo ~
        2   field obj-type as character ~
        3   field obj-code as integer   ~
        4   index pi is primary unique  ~
        5   obj-type ~
        6   obj-code.
        7   define input  parameter p-mode as character no-undo .
        8   define input-output parameter p-sum-1 as decimal   no-undo .
        9   define input-output parameter p-sum-2 as decimal   no-undo .
       10   define output parameter table for temp-list-buyer .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Интервалы сумм ".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure pricing_calc-itogo-buyer :
       77     do
       78     on error undo, return error return-value
       79     :
       80   define input  parameter  p-cli-type as character no-undo .
       81   define input  parameter  p-cli-code as integer   no-undo .
       82   define output parameter  p-itogo-sum-doc-rubl  as decimal   no-undo .
       83   define output parameter  p-itogo-sum-doc-base  as decimal   no-undo .
       84   define output parameter  p-itogo-sum-rash-base as decimal   no-undo .
       85   define output parameter  p-itogo-sum-rash      as decimal   no-undo .
       86   define output parameter  p-itogo-sum-vozv-base as decimal   no-undo .
       87   define output parameter  p-itogo-sum-vozv      as decimal   no-undo .
       88   define output parameter  p-itogo-qnty-doc      as decimal   no-undo .
       89   define output parameter  p-itogo-qnty-check    as decimal   no-undo .
       90   define buffer bb_turnover-buyer      for ub.turnover-buyer.
       91   define buffer bb_turnover-buyer-main for ub.turnover-buyer-main.
       92   assign
       93     p-ITOGO-sum-doc-rubl =  0
       94     p-ITOGO-sum-doc-base =  0
       95     p-ITOGO-sum-rash-base = 0
       96     p-ITOGO-sum-rash      = 0
       97     p-ITOGO-sum-vozv-base = 0
       98     p-ITOGO-sum-vozv      = 0
       99     p-ITOGO-qnty-doc      = 0
      100     p-ITOGO-qnty-check    = 0
      101   .
      102   for each bb_turnover-buyer-main no-lock where
      103            bb_turnover-buyer-main.cli-type = p-cli-type and
      104            bb_turnover-buyer-main.cli-code = p-cli-code
      105            :
      106       p-ITOGO-qnty-doc     = p-ITOGO-qnty-doc     + bb_turnover-buyer-main.qnty-doc-itog .
      107       p-ITOGO-qnty-check   = p-ITOGO-qnty-check   + bb_turnover-buyer-main.qnty-check-itog .
      108       p-ITOGO-sum-doc-rubl = p-ITOGO-sum-doc-rubl + bb_turnover-buyer-main.sum-doc-rubl-itog .
      109       p-ITOGO-sum-doc-base = p-ITOGO-sum-doc-base + bb_turnover-buyer-main.sum-doc-base-itog .
      110   end.
      111   for each bb_turnover-buyer no-lock where
      112            bb_turnover-buyer.cli-type = p-cli-type and
      113            bb_turnover-buyer.cli-code = p-cli-code
      114            :
      115       if bb_turnover-buyer.ext-doc-type = 'ee':U      or
      116          bb_turnover-buyer.ext-doc-type = 'es':U or
      117          bb_turnover-buyer.ext-doc-type = ""
      118          then do:
      119           p-ITOGO-sum-rash      = p-ITOGO-sum-rash      + bb_turnover-buyer.sum-doc-rubl .
      120           p-ITOGO-sum-rash-base = p-ITOGO-sum-rash-base + bb_turnover-buyer.sum-doc-base .
      121       end.
      122       else do:
      123           p-ITOGO-sum-vozv      = p-ITOGO-sum-vozv      + bb_turnover-buyer.sum-doc-rubl .
      124           p-ITOGO-sum-vozv-base = p-ITOGO-sum-vozv-base + bb_turnover-buyer.sum-doc-base .
      125       end.
      126   end.
      127     end.
      128   end procedure.
      129   procedure proc-alt-shift-f2:
      130     if not ibs.th.gbl.gbl-var:rcode
      131   then
      132     run gbl\inidebug.p .
      133   end.
      134   procedure proc-alt-shift-f3:
      135     run gbl/prvssinf.p
      136       ( input this-procedure
      137       ) .
      138   end.
      139   define variable v-inform-launched as logical no-undo initial false .
      140   procedure proc-alt-shift-f4:
      141     define variable v-action as character no-undo .
      142     if v-inform-launched = false then do:
      143       assign
      144         v-inform-launched = true
      145       .
      146       run gbl/d-inform.w
      147         (  input self
      148         ,  input this-procedure
      149         , output v-action
      150         ) no-error .
      151       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      152       assign
      153         v-inform-launched = false
      154       .
      155     end.
      156   end.
      157   procedure proc-alt-f1:
      158     run gbl/corrhelp.p
      159       (input this-procedure
      160       ) .
      161   end .
      162   on alt-shift-f2 anywhere do:
      163     run proc-alt-shift-f2.
      164   end.
      165   on alt-shift-f3 anywhere do:
      166     run proc-alt-shift-f3 in this-procedure .
      167   end.
      168   on alt-shift-f4 anywhere do:
      169     run proc-alt-shift-f4 in this-procedure.
      170   end.
      171   on alt-f1 anywhere do:
      172     run proc-alt-f1 in this-procedure .
      173   end.
      174   DEFINE BUTTON B-Cancel AUTO-END-KEY
      175        LABEL "Отмена"
      176        SIZE 10 BY 1
      177        BGCOLOR 8 .
      178   DEFINE BUTTON B-Help
      179        LABEL "Помощь"
      180        SIZE 10 BY 1
      181        BGCOLOR 8 .
      182   DEFINE BUTTON B-OK AUTO-GO
      183        LABEL "Ввод"
      184        SIZE 10 BY 1
      185        BGCOLOR 8 .
      186   DEFINE VARIABLE v-sum-1 AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99":U INITIAL 0
      187        LABEL "C"
      188        VIEW-AS FILL-IN
      189        SIZE 25.5 BY 1 NO-UNDO.
      190   DEFINE VARIABLE v-sum-2 AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99":U INITIAL 0
      191        LABEL "ПО"
      192        VIEW-AS FILL-IN
      193        SIZE 25.5 BY 1 NO-UNDO.
      194   DEFINE FRAME Dialog-Frame
      195        B-OK AT ROW 1 COL 1
      196        B-Cancel AT ROW 1 COL 11
      197        B-Help AT ROW 1 COL 43.5
      198        v-sum-1 AT ROW 3.75 COL 12.5 COLON-ALIGNED
      199        v-sum-2 AT ROW 5 COL 12.5 COLON-ALIGNED
      200        SPACE(13.74) SKIP(1.16)
      201       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      202            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      203            TITLE "Интервалы сумм"
      204            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
      205   ASSIGN
      206          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      207          FRAME Dialog-Frame:HIDDEN           = TRUE.
      208   ON GO OF FRAME Dialog-Frame
      209   DO:
      210     RUN save-proc no-error .
      211     if error-status :error then do:
      212         message
      213           return-value
      214           view-as alert-box error
      215         .
      216         return no-apply .
      217     end.
      218   END.
      219   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      220   DO:
      221     APPLY "END-ERROR":U TO SELF.
      222   END.
      223   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
      224   DO:
      225     p-sum-2 = ? .
      226     p-sum-1 = ? .
      227   END.
      228   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      229   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      230   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      231   on help of frame Dialog-Frame
      232   do:
      233     run gbl/app_help.p
      234       (input this-procedure :file-name
      235       ,input ''
      236       ,input ?
      237       ) no-error.
      238     if error-status :error then do:
      239       message
      240         "Ошибка при вызове помощи"
      241         error-status :get-message(1)
      242         view-as alert-box .
      243     end.
      244   end.
      245   run minbtn-set in this-procedure .
      246   on choose of b-help in frame Dialog-Frame
      247   do:
      248     apply "help":u to frame Dialog-Frame .
      249   end.
      250   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   procedure minbtn-set :
      252       do
      253           on error undo, return error return-value
      254           :
      255           define variable ii              as integer       no-undo .
      256           define variable fh              as widget-handle no-undo .
      257           define variable hh              as widget-handle no-undo .
      258           define variable v-h             as handle        extent 4 no-undo .
      259           define variable v-name-button   as character     no-undo .
      260           define variable v-help-old-x    as decimal       no-undo .
      261           define variable v-help-old-y    as decimal       no-undo .
      262           define variable v-help-old-size as decimal       no-undo .
      263           define variable v-frame-width   as decimal       no-undo .
      264           define variable jj              as integer       no-undo .
      265           do
      266               on error undo, return error
      267               :
      268               assign
      269                   v-frame-width = frame Dialog-Frame:width - 0.3
      270                   fh            = frame Dialog-Frame:first-child
      271                   hh            = fh:first-child
      272                   ii            = 1
      273                   .
      274               do while valid-handle(hh):
      275                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      276                   do:
      277                       case lc(hh:name) :
      278                           when "b-help" then
      279                               do:
      280                                   hh:load-image-up("cmp/b-help.bmp":u) .
      281                                   hh:load-image-down("cmp/b-help.bmp":u) .
      282                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      283                                   hh:TOOLTIP = "Помощь" .
      284                                   v-help-old-x = hh:column .
      285                                   v-help-old-y = hh:row    .
      286                                   v-help-old-size = hh:width .
      287                                   hh:width-chars = 2.5 .
      288                               end.
      289                           when "b-print" then
      290                               do:
      291                                   hh:load-image("cmp/b-print.bmp":u) .
      292                                   hh:TOOLTIP = "Печать" .
      293                                   v-h[ii] = hh:handle .
      294                                   ii = ii + 1 .
      295                                   hh:width-chars = 3 .
      296                               end.
      297                           when "b-history" or
      298                           when "b-hist" then
      299                               do:
      300                                   hh:load-image("cmp/b-hist.bmp":u) .
      301                                   hh:TOOLTIP = "История" .
      302                                   v-h[ii] = hh:handle .
      303                                   ii = ii + 1 .
      304                                   hh:width-chars = 3 .
      305                               end.
      306                           when "b-sch" then
      307                               do:
      308                                   hh:load-image("cmp/b-sch.bmp":u) .
      309                                   hh:TOOLTIP = "Установка Фильтра" .
      310                                   v-h[ii] = hh:handle .
      311                                   ii = ii + 1 .
      312                                   hh:width-chars = 3 .
      313                               end.
      314                           when "b-hist-user" then
      315                               do:
      316                                   hh:load-image("cmp/b-hist.bmp":u) .
      317                                   hh:TOOLTIP = "История пользователя" .
      318                                   ii = ii + 1 .
      319                               end.
      320                       end case.
      321                   end.
      322                   hh = hh:next-sibling.
      323               end.
      324               b-help:column = v-frame-width - b-help:width-chars.
      325               jj = 0.
      326               repeat ii = 4 to 1 by -1 :
      327                   if valid-handle (v-h[ii] ) then
      328                   do:
      329                       jj  = jj + 1 .
      330                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      331                       v-h[ii]:row    = v-help-old-y .
      332                   end.
      333               end.
      334           end.
      335       end.
      336   end procedure.
      337   MAIN-BLOCK:
      338   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      339      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      340     if lookup(p-mode, ('sums' + chr(44) +
      341                       'calc' + chr(44) +
      342                       'sums-calc')) = 0 then do:
      343       message
      344       vss-workfile vss-revision vss-description skip
      345       "Неверынй параметр вызова p-mode" p-mode
      346       view-as alert-box error .
      347       return error .
      348     end.
      349     for each  temp-list-buyer:
      350        delete temp-list-buyer.
      351     end.
      352     if p-mode = 'sums'
      353     or p-mode = 'sums-calc' then do:
      354       RUN enable_UI.
      355       if p-mode = 'sums-calc'   then do:
      356          RUN proc-calc IN THIS-PROCEDURE NO-ERROR.
      357       end.
      358       WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-sum-1.
      359     end.
      360     if p-mode = 'calc' then do:
      361       RUN proc-calc IN THIS-PROCEDURE NO-ERROR.
      362     end.
      363   END.
      364   RUN disable_UI.
      365   PROCEDURE disable_UI :
      366     HIDE FRAME Dialog-Frame.
      367   END PROCEDURE.
      368   PROCEDURE enable_UI :
      369     DISPLAY v-sum-1 v-sum-2
      370         WITH FRAME Dialog-Frame.
      371     ENABLE B-OK B-Cancel B-Help v-sum-1 v-sum-2
      372         WITH FRAME Dialog-Frame.
      373     VIEW FRAME Dialog-Frame.
      374   END PROCEDURE.
      375   PROCEDURE proc-calc :
      376   define variable p-itogo-sum-doc-rubl  as decimal   no-undo .
      377   define variable p-itogo-sum-doc-base  as decimal   no-undo .
      378   define variable p-itogo-sum-rash-base as decimal   no-undo .
      379   define variable p-itogo-sum-rash      as decimal   no-undo .
      380   define variable p-itogo-sum-vozv-base as decimal   no-undo .
      381   define variable p-itogo-sum-vozv      as decimal   no-undo .
      382   define variable p-itogo-qnty-doc      as decimal   no-undo .
      383   define variable p-itogo-qnty-check    as decimal   no-undo .
      384   empty temp-table temp-list-buyer.
      385   for each  clients no-lock where clients.turnover-buyer = true :
      386         run pricing_calc-itogo-buyer (
      387               input  clients.obj-type            ,
      388               input  clients.obj-code            ,
      389               output p-itogo-sum-doc-rubl  ,
      390               output p-itogo-sum-doc-base  ,
      391               output p-itogo-sum-rash-base ,
      392               output p-itogo-sum-rash      ,
      393               output p-itogo-sum-vozv-base ,
      394               output p-itogo-sum-vozv      ,
      395               output p-itogo-qnty-doc      ,
      396               output p-itogo-qnty-check    ).
      397         if p-itogo-sum-doc-rubl >= p-sum-1 and p-itogo-sum-doc-rubl <= p-sum-2 and p-sum-2 <> ? then do:
      398             create temp-list-buyer.
      399             assign
      400             temp-list-buyer.obj-type =  clients.obj-type
      401             temp-list-buyer.obj-code =  clients.obj-code
      402             .
      403         end.
      404         if p-itogo-sum-doc-rubl >= p-sum-1  and p-sum-2 = ? then do:
      405             create temp-list-buyer.
      406             assign
      407             temp-list-buyer.obj-type =  clients.obj-type
      408             temp-list-buyer.obj-code =  clients.obj-code
      409             .
      410         end.
      411   end.
      412   END PROCEDURE.
      413   PROCEDURE save-proc :
      414   ASSIGN FRAME Dialog-Frame
      415       v-sum-1
      416       v-sum-2
      417       .
      418   if v-sum-2 <> ? then do:
      419      if  v-sum-2 < v-sum-1 then do:
      420      return error "Не верно введен интервал сумм!" .
      421      end.
      422   end.
      423   p-sum-1 =   v-sum-1 .
      424   p-sum-2 =   v-sum-2 .
      425   RUN proc-calc IN THIS-PROCEDURE.
      426   END PROCEDURE.
