     3332   procedure init-prn-template :
     3333   define variable na                   as integer            no-undo .
     3334   DEFINE VARIABLE vtooltip             as character           no-undo.
     3335   DEFINE VARIABLE vlabel               as character           no-undo .
     3336   DEFINE VARIABLE vtype                as character           no-undo .
     3337   DEFINE VARIABLE vformat              as character           no-undo .
     3338   DEFINE VARIABLE vuser-can-edit       as character           no-undo .
     3339   DEFINE VARIABLE voutput-display      as character           no-undo .
     3340   DEFINE VARIABLE vother               as character           no-undo .
     3341     do
     3342     on error undo, return error
     3343     :
     3344       assign
     3345       join-tbl = 'Товары,Глоб. атрибуты,Атр-ты на объ.,Атр-ты на фирме,Другое'
     3346       tbl = 'goods':U + chr(44) +
     3347             'goods-attr':U + chr(44) +
     3348             'gds-obj-attr':U + chr(44) +
     3349             'gds-host-attr':U + chr(44) +
     3350             'function'
     3351       c-point = "Список товаров" + chr(4) +  "PRNT":u + chr(4) + substitute("Список товаров - &1&2 фирма &3", p-curr-obj-type, p-curr-obj-code, v-host-code)
     3352       fld = ""
     3353       lab = ""
     3354       spr = ""
     3355       dim = '0'
     3356       v-size = "":U
     3357       v-format = "":U
     3358       .
     3359       for each buf_usr-flt_custom-labels where
     3360              buf_usr-flt_custom-labels.call-type = 'add-fields':U
     3361          and buf_usr-flt_custom-labels.call-point = 'gdsreffi':U
     3362          and buf_usr-flt_custom-labels.tbl-name = 'goods':U
     3363       by buf_usr-flt_custom-labels.custom-label
     3364          :
     3365         run prnfield-add in this-procedure(input buf_usr-flt_custom-labels.fld-name
     3366                                           ,input buf_usr-flt_custom-labels.custom-label
     3367                                           ,input (if buf_usr-flt_custom-labels.custom-view-func <> ''
     3368                                                   or buf_usr-flt_custom-labels.fld-name begins "attr-value_"
     3369                                                   then substitute("attr.&1", buf_usr-flt_custom-labels.fld-data-type)
     3370                                                   else '')
     3371                                           ,input integer(buf_usr-flt_custom-labels.widget-width)
     3372                                           ,input buf_usr-flt_custom-labels.custom-format
     3373                                           ,input-output fld
     3374                                           ,input-output lab
     3375                                           ,input-output spr
     3376                                           ,input-output v-size
     3377                                           ,input-output v-format
     3378                                           ,input-output dim)  no-error.
     3379       end.
     3380       assign
     3381       fld = fld
     3382       lab = lab
     3383       dim = dim + chr(44)
     3384       .
     3385       do na = 1 to num-entries('alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U):
     3386         run gds-attr-name in this-procedure (
