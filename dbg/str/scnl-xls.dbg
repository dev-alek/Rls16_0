     2212   def new shared var bc-frmt as character no-undo .
     2213   def new shared var bc-pfx  as character no-undo .
     2214   def var bc-par-type as character no-undo .
     2215       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
     2216       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
     2217           do:
     2218               message "Не задан или не верно задан ТИП собственного бар-кода!"
     2219                   view-as alert-box ERROR TITLE "".
     2220               return error.
     2221           end.
     2222       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
     2223       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
     2224           do:
     2225               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
     2226                   view-as alert-box ERROR TITLE "".
     2227               return error.
     2228           end.
     2229   PROCEDURE gen-bc:
     2230     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
     2231     def output parameter full-b-code     as character init ""    no-undo .
     2232   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2233     define variable tmp-str23  as character no-undo.
     2234     define variable tmp-num23  as character no-undo.
     2235     define variable i23        as integer   no-undo.
     2236     define variable sum23      as integer   no-undo.
     2237     define variable len-code23 as integer   no-undo.
     2238     define variable varcont23  as logical   initial yes no-undo.
     2239     CASE bc-frmt :
     2240       WHEN "EAN13" THEN do:
     2241         assign
     2242           tmp-str23 = string( internal-b-code, "999999999999" )
     2243         .
     2244       end.
     2245       WHEN "EAN8" THEN do:
     2246         assign
     2247           tmp-str23 = string( internal-b-code, "9999999" )
     2248         .
     2249       end.
     2250       OTHERWISE DO:
     2251           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     2252           view-as alert-box error.
     2253           return error.
     2254       END.
     2255     END CASE.
     2256     if varcont23 = yes then do:
     2257       if integer( substring( tmp-str23, 1, length( bc-pfx ) ) ) <> 0
     2258       then do:
     2259         message
     2260           "Невозможно сформировать бар-код" SKIP
     2261           "для товара с кодом: " internal-b-code
     2262           view-as alert-box error title "подрезание кода".
     2263         return error.
     2264       end.
     2265       else do:
     2266         assign
     2267           full-b-code = bc-pfx + substring( tmp-str23, length( bc-pfx ) + 1, length( tmp-str23 ) - length( bc-pfx ) )
     2268           len-code23    = length( full-b-code )
     2269         .
     2270         define variable v-sum-char23 as character no-undo .
     2271         assign
     2272           sum23 = 0
     2273         .
     2274         do i23 = 1 to len-code23 by 2
     2275         :
     2276           assign
     2277             v-sum-char23 = substr(full-b-code, len-code23 - i23 + 1, 1)
     2278           .
     2279           if v-sum-char23 < "0"
     2280           or v-sum-char23 > "9"
     2281           then do:
     2282             message
     2283               "Невозможно сформировать бар-код" skip
     2284               "для товара с кодом: " internal-b-code skip
     2285               view-as alert-box error title "подсчет контрольной суммы".
     2286             return error.
     2287           end.
     2288           assign
     2289             sum23 = sum23 + integer(v-sum-char23)
     2290           .
     2291         end.
     2292         if varcont23 = yes then do:
     2293           assign
     2294             sum23 = sum23 * 3
     2295           .
     2296           do i23 = 2 to len-code23 by 2
     2297           :
     2298             assign
     2299               v-sum-char23 = substr(full-b-code, len-code23 - i23 + 1, 1)
     2300             .
     2301             if v-sum-char23 < "0"
     2302             or v-sum-char23 > "9"
     2303             then do:
     2304               message
     2305                 "Невозможно сформировать бар-код" skip
     2306                 "для товара с кодом: " internal-b-code skip
     2307                 view-as alert-box error title "подсчет контрольной суммы".
     2308               return error.
     2309             end.
     2310             assign
     2311               sum23 = sum23 + integer(v-sum-char23)
     2312             .
     2313           end.
     2314           if varcont23 = yes then do:
     2315              if sum23 mod 10 = 0 then do:
     2316                assign
     2317                  full-b-code = full-b-code + '0'
     2318                .
     2319              end.
     2320              else do:
     2321                assign
     2322                  full-b-code = full-b-code + string(10 - sum23 mod 10)
     2323                .
     2324              end.
     2325           end.
     2326         end.
     2327       end.
     2328     end.
     2329   END PROCEDURE.
     2330   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
