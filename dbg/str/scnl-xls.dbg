     3195   sheetf.Excel-Column-Lable = ubflt.filter.Fields-sort-rus
     3196   sheetf.sizes = ubflt.filter.Where-ysl
     3197   .
     3198   run waitfram-show in this-procedure ("Экспорт в EXCEL. Ждите ...").
     3199   run rep/extitle.p (1).
     3200   iColumn = 0.
     3201   FOR EACH scn-list no-lock,
     3202       first ub.goods no-lock where
     3203             ub.goods.gds-code = scn-list.gds-code:
     3204     if (iColumn modulo 10) = 0 then
