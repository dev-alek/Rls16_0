     3415           input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3416         end.
     3417       end.
     3418       assign
     3419       fld = fld
     3420       lab = lab
     3421       dim = dim + chr(44)
     3422       .
     3423       do na = 1 to num-entries('no-envd,':u):
     3424         run gdshattr-name(
     3425                            input entry(na, 'no-envd,':u)
     3426                           ,output vtype
     3427                           ,output vformat
     3428                           ,output vlabel
     3429                           ,output vuser-can-edit
     3430                           ,output voutput-display
     3431                           ,output vother) no-error.
     3432         if NOT error-status:error and voutput-display = "yes":U then do:
     3433           run prnfield-add in this-procedure(entry(na, 'no-envd,':u), vlabel, 'ATTR.' + VTYPE, prnfield_get-fsize(vtype, vformat, vlabel), vformat,
     3434           input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3435         end.
     3436       end.
     3437       assign
     3438       fld = fld
     3439       lab = lab
     3440       dim = dim + chr(44)
     3441       .
     3442       run prnfield-add in this-procedure('iColumn', '№', 'function.integer', 7, ">>>>>>9":U,
     3443       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3444       run prnfield-add in this-procedure('gdsbcode-graphic', 'Главный код товара-штрихкод', 'function.character', 30, "X(30)":U,
     3445       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3446       run prnfield-add in this-procedure('qnty', 'Кол-во', 'function.integer', 12, "->>>,>>9.999":U,
     3447       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3448       run prnfield-add in this-procedure('vat-value', 'НДС', 'function.decimal', 6, "99.99%":U,
     3449       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3450       run prnfield-add in this-procedure('slt-value', 'НП', 'function.decimal', 6, "99.99%":U,
     3451       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3452       run prnfield-add in this-procedure('price-sale', 'Цена', 'function.decimal', 6, ">>>,>>9.99":U,
     3453       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3454       run prnfield-add in this-procedure('last-inv', '№ и дата посл.инв.', 'function.character', 45, "X(45)":U,
     3455       input-output fld, input-output lab, input-output spr, input-output v-size, input-output v-format, input-output dim)  no-error.
     3456     end.
     3457   end procedure.
