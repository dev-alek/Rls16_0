     3206     assign
     3207     iColumn = iColumn + 1
     3208     v-osn-frm = "":U
     3209     v-eng-frm = "":U
     3210     .
     3211   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3212   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3213     (input  scn-list.gds-code
     3214     ,input  '1':U
     3215     ,input  ?
     3216     ,input  v-host-code
     3217     ,input  p-curr-obj-type
     3218     ,input  p-curr-obj-code
     3219     ,output vat-value
     3220     ) no-error .
     3221   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3222   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3223     (input  scn-list.gds-code
     3224     ,input  '2':U
     3225     ,input  ?
     3226     ,input  v-host-code
     3227     ,input  p-curr-obj-type
     3228     ,input  p-curr-obj-code
     3229     ,output slt-value
     3230     ) no-error .
     3231     do jj = 1 to j-n:
     3232       assign
     3233       f-value = "":U
     3234       v-dop0 = entry(jj, f-name)
     3235       v-dop1 = entry(1, entry(jj, f-name), ".")
     3236       v-dop2 = entry(2, entry(jj, f-name), ".")
     3237       .
     3238       CASE v-dop1 :
     3239         when "function":U then do:
     3240           if Make-Excel then  put   stream ForExcel unformatted
     3241           get-function(substr(v-dop0 ,10 ), entry(jj, ubflt.filter.Where-ysl-rus, chr(4)))
     3242           (if jj < j-n
     3243           then
     3244           CHR(9)
     3245           else chr(10))
     3246           .
     3247         end.
     3248         otherwise do:
     3249           if index(v-dop0, "*":U) > 0 then do:
     3250             do jj-1 = 1 to num-entries(v-dop0, "*":U):
     3251               assign
     3252               f-value-1 = "":U.
     3253               run gds-ref-fi in this-procedure (
     3254                                buffer ub.goods
     3255                               ,buffer ub.gds-obj
     3256                               ,input p-curr-obj-type
     3257                               ,input p-curr-obj-code
     3258                               ,INPUT entry(jj-1, v-dop0, "*":U)
     3259                               ,input yes
     3260                               ,INPUT-OUTPUT f-value-1
     3261                               )  NO-ERROR .
     3262               assign
     3263               f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
     3264               .
     3265             end.
     3266           end.
     3267           else do:
     3268             run gds-ref-fi in this-procedure (
     3269                              buffer ub.goods
     3270                             ,buffer ub.gds-obj
     3271                             ,input p-curr-obj-type
     3272                             ,input p-curr-obj-code
     3273                             ,INPUT v-dop0
     3274                             ,input yes
     3275                             ,INPUT-OUTPUT f-value
     3276                             )  NO-ERROR .
     3277           end.
     3278           if Make-Excel then  put   stream ForExcel unformatted
     3279           if entry(jj, f-name) = "artic" then chr(4) else "":U
     3280           string(replace(f-value, chr(10), ""), substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
     3281           (if jj < j-n
     3282           then
     3283           CHR(9)
     3284           else chr(10))
