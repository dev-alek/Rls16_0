      730   define variable c-point  as character no-undo .
      731   define variable tbl      as character no-undo .
      732   define variable join-tbl as character no-undo .
      733   define variable fld      as character no-undo .
      734   define variable lab      as character no-undo .
      735   define variable spr      as character no-undo .
      736   define variable v-size   as character no-undo .
      737   define variable v-format as character no-undo .
      738   define variable dim      as character no-undo .
      739   procedure prnfield-clear :
      740     define output parameter loc-fld as character no-undo.
      741     define output parameter loc-lab as character no-undo .
      742     define output parameter loc-spr as character no-undo .
      743     define output parameter loc-dim as character no-undo .
      744     define output parameter loc-size as character no-undo .
      745     define output parameter loc-format as character no-undo .
      746     define output parameter loc-type as character no-undo .
      747     assign
      748       loc-fld = ""
      749       loc-lab = ""
      750       loc-spr = ""
      751       loc-dim = "0"
      752       loc-size = "":U
      753       loc-format = "":U
      754       loc-type = "":U
      755     .
      756   end procedure .
      757   procedure prnfield-add :
      758     define input        parameter par-fld as character no-undo.
      759     define input        parameter par-lab as character no-undo .
      760     define input        parameter par-spr as character no-undo .
      761     define input        parameter par-size as integer no-undo .
      762     define input        parameter par-format as character no-undo .
      763     define input-output parameter loc-fld as character no-undo.
      764     define input-output parameter loc-lab as character no-undo .
      765     define input-output parameter loc-spr as character no-undo .
      766     define input-output parameter loc-size as character no-undo .
      767     define input-output parameter loc-format as character no-undo .
      768     define input-output parameter loc-dim as character no-undo .
      769     do
      770     on error undo, return error
      771     :
      772       assign
      773       loc-fld = if loc-dim = '0'
      774                 then par-fld
      775                 else (loc-fld + chr(44) + par-fld)
      776       loc-lab = if loc-dim = '0'
      777                 then par-lab
      778                 else (loc-lab + chr(44) + par-lab)
      779       loc-spr = if loc-dim = '0'
      780                 then par-spr
      781                 else (loc-spr + chr(44) + par-spr)
      782       loc-size = if loc-dim = '0'
      783                 then string(par-size)
      784                 else (loc-size + chr(44) + string(par-size))
      785       loc-format = if loc-dim = '0'
      786                 then par-format
      787                 else (loc-format + chr(4) + string(par-format))
      788       no-error
      789       .
      790       assign
      791       entry(num-entries(loc-dim), loc-dim) = string(integer(entry(num-entries(loc-dim), loc-dim)) + 1)
      792       no-error
      793       .
      794     end.
      795   end procedure.
      796   FUNCTION prnfield_get-fsize returns integer(
      797   input p-type as character,
      798   input p-format as character,
      799   input p-label as character
      800   ):
      801   define variable ii as integer no-undo .
      802   define variable v-max as integer no-undo .
      803     do
      804     on error undo, return error
      805     :
      806       do ii = 1 to num-entries(p-label, chr(32)):
      807         assign
      808         v-max = maximum(v-max, length(entry(ii, p-label, chr(32))))
      809         .
      810       end.
      811       if p-format = "99:99" then return MAXIMUM(v-max,8).
      812       CASE p-type:
      813          when 'C':U or when 'character':U then do:
      814           if p-format = "99:99" or p-format = "99:99-99:99" then return maximum(v-max, 8).
      815           else
      816           return maximum(v-max, integer(left-trim(right-trim(left-trim(left-trim(p-format, "X":U), "(":U), ")":U),">") )).
      817         end.
      818         when 'I':U or when 'D':U or when 'T':U or
      819         when 'integer':U or when 'decimal':U or when 'date':U
      820         then do:
      821           return maximum(v-max,length(p-format)).
      822         end.
      823         when 'L':U or when 'logical':U then do:
      824           return MAXIMUM(v-max, length(entry(1, p-format, chr(47))), length(entry(2, p-format, chr(47)))).
      825         end.
      826       END CASE.
      827     end.
      828   end FUNCTION.
      829   function prnfield_get-fformat returns character ( input p-data-type as character
      830                                           ,input p-format as character ):
      831   define variable v-excel-format as character no-undo .
      832   case p-data-type:
      833     when 'character':U then do:
      834       v-excel-format = "@".
      835     end.
      836     when 'integer':U then do:
      837       v-excel-format = "0".
      838     end.
      839     when 'decimal':U then do:
      840       v-excel-format = substitute("0.&1", fill("0", length(entry(2, p-format, ".")))) no-error.
      841     end.
      842     when 'date':U then do:
      843       v-excel-format = "d/m/yyyy".
      844     end.
      845     otherwise do:
      846       v-excel-format = "@".
      847     end.
      848   end.
      849   if v-excel-format = '' then
      850   v-excel-format = "@".
      851   return v-excel-format .
      852   end function.
      853   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   define variable v-waitfram-action01         as character   no-undo .
      855   define variable v-waitfram-action02         as character   no-undo .
      856   define variable v-waitfram-action03         as character   no-undo .
      857   define variable mWaitFramTextBeg            as character   no-undo.
      858   define variable mWaitFramTextEnd            as character   no-undo.
      859   define variable mWaitFramView               as logical     no-undo.
      860   define variable mWaitProcEvent              as logical     no-undo init yes.
      861   define variable mWaitFramInterval           as integer     no-undo init 1 .
      862   define variable mWaitFramStop               as logical     no-undo.
      863   define variable mWaitFramStopUser           as logical     no-undo.
      864   define variable mWaitFramStopTimeOut        as logical     no-undo.
      865   define variable mWaitFramStartProc          as datetime-tz no-undo.
      866   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      867   define button B-WaitFramStop auto-end-key
      868        label "Стоп"
      869        size 10 by 1 tooltip "Остоновить процесс".
      870   define button B-viewProcInfo
      871        label "Информация"
      872        size 15 by 1 tooltip "Информация о процесс".
      873   define frame waitfram
      874     v-waitfram-action01 format "x(72)" no-label skip
      875     v-waitfram-action02 format "x(72)" no-label skip
      876     v-waitfram-action03 format "x(72)" no-label skip
      877     B-viewProcInfo
      878     B-WaitFramStop at row 4 col 30
      879     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      880     .
      881   define new global shared variable mBatchMode as logical no-undo init ?.
      882   define variable mFramBachModHandle as handle no-undo.
      883   mFramBachModHandle = frame waitfram:handle.
      884   define variable mFameOldVis as logical no-undo.
      885   define variable mVisCUrentVin as logical no-undo.
      886   if session:batch-mode
      887   then
      888      mBatchMode = yes.
      889   if mBatchMode = ? then do:
      890     mVisCUrentVin = current-window:visible.
      891     mFameOldVis = mFramBachModHandle:visible.
      892     mFramBachModHandle:visible  = yes.
      893     mBatchMode = mFramBachModHandle:visible ne yes.
      894     mFramBachModHandle:visible = mFameOldVis.
      895     current-window:visible = mVisCUrentVin.
      896   end.
      897    if  log-manager:logfile-name ne ?
      898     then DO:
      899         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      900         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      901         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      902     end.
      903   on choose of B-WaitFramStop in frame waitfram
      904   do:
      905     mWaitFramStop = yes.
      906     mWaitFramStopUser = yes.
      907   end.
      908   function waitfram-check-timeout returns logical():
      909      define variable vtime as int64 no-undo.
      910      if mWaitFramStopTimeOut
      911      then
      912         return yes.
      913      vtime = ( now - mWaitFramStartProc ) / 1000 .
      914      if     mWaitFramTimeOut ne ?
      915         and mWaitFramTimeOut ne 0
      916         and mWaitFramTimeOut lt vtime
      917      then do:
      918         mWaitFramStopTimeOut = yes.
      919      end.
      920      return mWaitFramStopTimeOut.
      921   end.
      922   procedure waitfram-hide :
      923     if not session:batch-mode
      924     then do
      925     on error undo, return error return-value
      926     :
      927       pause 0 before-hide .
      928       if not mBatchMode then
      929         hide frame waitfram .
      930     if     not mWaitFramView
      931        and mWaitProcEvent
      932     then
      933       process events .
      934     end.
      935   end procedure.
      936   procedure waitfram-show :
      937     define input  parameter p-message as character no-undo .
      938     define variable v-left-margin as integer   no-undo .
      939     if not session:batch-mode
      940     then do
      941     on error undo, return error return-value
      942     :
      943       if length(p-message) <= 70 then do:
      944         assign
      945           v-left-margin = integer((70 - length(p-message)) / 2)
      946         .
      947         assign
      948           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      949         .
      950         assign
      951           v-waitfram-action01 = " "
      952           v-waitfram-action02 = " "
      953                                    + fill(" ", v-left-margin)
      954                                    + p-message
      955           v-waitfram-action03 = " "
      956         .
      957       end.
      958       else do:
      959         define variable vRindex1 as integer no-undo.
      960         define variable vRindex2 as integer no-undo.
      961         vRindex1 = r-index(p-message," ",70).
      962         if vRindex1 = 0
      963         then
      964            vRindex1 = 70.
      965         if length(p-message)  <= vRindex1 + 70 then do:
      966           assign
      967             v-waitfram-action01 = " "
      968             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      969             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      970           .
      971         end.
      972         else do:
      973           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      974           if vRindex2 <= vRindex1
      975           then
      976              vRindex2 = vRindex1 + 70.
      977           assign
      978             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      979             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      980             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      981           .
      982         end.
      983       end.
      984       B-viewProcInfo:visible   in frame waitfram = no.
      985       B-viewProcInfo:sensitive in frame waitfram = no.
      986       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      987       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      988       if  (   mWaitFramView
      989          or  mWaitProcEvent)
      990          and not mBatchMode
      991       then
      992          display
      993             v-waitfram-action01 skip
      994             v-waitfram-action02 skip
      995             v-waitfram-action03 skip
      996          with frame waitfram .
      997       if     mWaitFramView
      998          then do:
      999             if     mWaitFramInterval ne ?
     1000                and not mBatchMode
     1001             then
     1002                wait-for go of frame waitfram pause mWaitFramInterval.
     1003          end.
     1004          else
     1005             if     mWaitProcEvent
     1006                and not mBatchMode
     1007             then
     1008                process events .
     1009     end.
     1010   end procedure.
     1011      procedure waitfram-show-this:
     1012         define input  parameter iInterval as int64 no-undo.
     1013         define variable vtime as int64 no-undo.
     1014         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1015         mWaitFramInterval = iInterval.
     1016         run waitfram-show (substitute("&1&2 &3&4" ,
     1017                                       mWaitFramTextBeg ,
     1018                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1019                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1020                                       mWaitFramTextEnd
     1021                                      )
     1022                           ).
     1023      end.
     1024      procedure WaitFramRunPause:
     1025         define input  parameter iInterval as dec no-undo.
     1026         define variable vStart  as datetime-tz no-undo.
     1027         define variable vend    as datetime-tz no-undo.
     1028         define variable vint as int64 no-undo.
     1029         define variable vOk as logical no-undo.
     1030         vStart = now.
     1031         vend   = vStart.
     1032         publish "WaitFramPause" (iInterval,output vOk).
     1033         vend   =  now.
     1034         vint = vend - vStart.
     1035         vint = iInterval - vint / 1000.
     1036         if     not mWaitFramStop
     1037            and (   vint > 0
     1038                 or (    not vOk
     1039                     and iInterval eq ?
     1040                     )
     1041                 )
     1042         then
     1043            run waitfram-show-this (iInterval).
     1044         vend   =  now.
     1045         vint = vend - vStart.
     1046         vint = iInterval - vint / 1000.
     1047         if     not mWaitFramStop
     1048            and vint > 0
     1049         then do:
     1050            run gbl/pause.p (vint * 1000).
     1051         end.
     1052         if iInterval ne ?
     1053         then
     1054            publish "WaitFramStop".
     1055         waitfram-check-timeout().
     1056      end.
     1057      procedure WaitFramWaitFor:
     1058         define input  parameter iInterval as dec no-undo.
     1059         assign
     1060            mWaitFramStartProc   = now
     1061            mWaitFramStopUser    = no
     1062            mWaitFramStopTimeOut = no
     1063         .
     1064         block-wait:
     1065         do while not mWaitFramStop:
     1066            run WaitFramRunPause (iInterval).
     1067            if  waitfram-check-timeout()
     1068            then do:
     1069               leave block-wait.
     1070            end.
     1071         end.
     1072         run waitfram-hide.
     1073      end.
     1074   procedure waitfram-join :
     1075     define input  parameter p-line-1  as character no-undo .
     1076     define input  parameter p-line-2  as character no-undo .
     1077     define input  parameter p-line-3  as character no-undo .
     1078     define output parameter p-message as character no-undo .
     1079     do
     1080     on error undo, return error return-value
     1081     :
     1082       assign
     1083         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1084                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1085                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1086       .
     1087     end.
     1088   end procedure.
     1089   function waitfram-join-function returns character
     1090     (input p-line-1 as character
     1091     ,input p-line-2 as character
     1092     ,input p-line-3 as character
     1093     ).
     1094     define variable v-message as character no-undo .
     1095     run waitfram-join in this-procedure
     1096       (input  p-line-1
     1097       ,input  p-line-2
     1098       ,input  p-line-3
     1099       ,output v-message
     1100       ) .
     1101     return v-message .
     1102   end function .
