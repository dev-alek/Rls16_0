     2620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2621     (input  p-curr-obj-type
     2622     ,input  p-curr-obj-code
     2623     ,output v-host-code
     2624     )  .
     2625   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2626   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2627   function native-string returns character ( input p-string as character
     2628                                             ,input p-data-type as character
     2629                                             ,input p-format as character):
     2630   define variable v-string as character no-undo .
     2631   case p-data-type:
     2632     when 'character':U then do:
     2633       assign
     2634       v-string = string(p-string, p-format)
     2635       no-error .
     2636     end.
     2637     when 'date':U then do:
     2638       assign
     2639       v-string = string(date(p-string), p-format)
     2640       no-error .
     2641     end.
     2642     when 'decimal':U then do:
     2643       assign
     2644       v-string = string(decimal(p-string), p-format)
     2645       no-error .
     2646     end.
     2647     when 'integer':U then do:
     2648       assign
     2649       v-string = string(integer(p-string), p-format)
     2650       no-error .
     2651     end.
     2652     when 'logical':U then do:
     2653       assign
     2654       v-string = string(logical(p-string), p-format)
     2655       no-error .
     2656     end.
     2657   end case.
     2658   return v-string.
     2659   end function.
     2660   FUNCTION gdsreffi_cond-keep-name returns character ( buffer buf_goods for ub.goods):
     2661   define buffer buf_condition-keeping for ub.condition-keeping.
     2662   find first buf_condition-keeping no-lock where
     2663            buf_condition-keeping.cond-keep-code = buf_goods.cond-keep-code no-error.
     2664   IF AVAIL buf_condition-keeping then do:
     2665     return buf_condition-keeping.cond-keep-name.
     2666   end.
     2667   return "[!!Неизвестные УСЛОВИЯ ХРАНЕНИЯ]".
     2668   end function.
     2669   function gdsreffi_prod-grp-name returns character ( buffer buf_goods for ub.goods):
     2670   define buffer buf_clients for ub.clients.
     2671   find first buf_clients no-lock WHERE
     2672             buf_clients.obj-type = buf_goods.prod-type
     2673         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2674   if available buf_clients then do:
     2675     return buf_clients.grp-name.
     2676   end.
     2677   return "[!!Неизвестная группа ПРОИЗВОДИТЕЛЯ]".
     2678   end function.
     2679   function gdsreffi_prod-name returns character ( buffer buf_goods for ub.goods):
     2680   define buffer buf_clients for ub.clients.
     2681   find first buf_clients no-lock WHERE
     2682             buf_clients.obj-type = buf_goods.prod-type
     2683         and buf_clients.obj-code = buf_goods.prod-code no-error.
     2684   if available buf_clients then do:
     2685     return buf_clients.obj-name.
     2686   end.
     2687   return "[!!Неизвестный ПРОИЗВОДИТЕЛЬ]".
     2688   end function.
     2689   function gdsreffi_prt-root-name returns character ( buffer buf_goods for ub.goods):
     2690   define buffer buf_gds-prt for ub.gds-prt.
     2691   find first buf_gds-prt no-lock where
     2692           buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     2693   if available buf_gds-prt then do:
     2694     return buf_gds-prt.node-name.
     2695   end.
     2696   return "[!!Неизвестный корень ШКАЛЫ]".
     2697   end function.
     2698   function gdsreffi_last-inv returns character ( buffer buf_goods for ub.goods
     2699                                                 ,input p-obj-type as character
     2700                                                 ,input p-obj-code as integer  ):
     2701   define variable v-last-inv-date-num as character format "X(45)" no-undo.
     2702   define buffer buf_doc-line for ub.doc-line.
     2703   define buffer buf_trn-doc  for ub.trn-doc.
     2704   find last buf_doc-line no-lock where
     2705             buf_doc-line.artic = buf_goods.artic
     2706         and buf_doc-line.prod-code = buf_goods.prod-code
     2707         and buf_doc-line.prod-type = buf_goods.prod-type
     2708         and buf_doc-line.obj-code = p-obj-code
     2709         and buf_doc-line.obj-type = p-obj-type
     2710         and buf_doc-line.status_ = 'факт':U
     2711         and buf_doc-line.ext-doc-type = 'vt':U no-error.
     2712   if available buf_doc-line then do :
     2713     find first buf_trn-doc no-lock where
     2714                buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     2715     if available buf_trn-doc then do :
     2716       assign
     2717         v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     2718       .
     2719       return v-last-inv-date-num.
     2720     end.
     2721   end.
     2722   return "[!!Нет инвентаризаций по данному товару]" .
     2723   end function.
