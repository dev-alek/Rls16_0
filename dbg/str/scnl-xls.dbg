      625   define variable g#report-num as integer no-undo .
      626   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   procedure OpenForExcel :
      628      define variable v-ch#ExcelApplication as com-handle no-undo .
      629      define variable v-ch#Workbook         as com-handle no-undo .
      630      define variable v-ch#Worksheet        as com-handle no-undo .
      631      os-delete value( string( session:temp-directory ) +
      632                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      633      os-delete value( string( session:temp-directory ) +
      634                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      635      os-delete value( string( session:temp-directory ) +
      636                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      637      if Make-Excel
      638      then do:
      639         output stream ForExcel to value( string( session:temp-directory +
      640                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      641         assign
      642            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      643            number-list = 1
      644         .
      645         if make-excel-com
      646         then do:
      647   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   if valid-handle(ch#WorkSheet) then
      649   RELEASE OBJECT ch#WorkSheet no-error.
      650   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   if valid-handle(ch#Workbook) then
      652   RELEASE OBJECT ch#Workbook no-error.
      653   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      654   if valid-handle(ch#ExcelApplication) then
      655   RELEASE OBJECT ch#ExcelApplication no-error.
      656            create "Excel.Application" ch#excelApplication connect no-error.
      657            if error-status:error
      658            then do :
      659           create "Excel.Application" ch#excelApplication no-error.
      660       if error-status :error then do:
      661           message
      662           "Ошибка при запуске Excel" skip
      663           error-status :get-message(1) skip
      664           view-as alert-box error .
      665           undo, return error .
      666       end.
      667            end.
      668            assign
      669               num#str#  = 0.
      670               v-ch#excelApplication  = ch#excelApplication.
      671               v-ch#excelApplication:Interactive = false.
      672               v-ch#excelApplication:ScreenUpdating = false.
      673               v-ch#excelApplication:Visible = false.
      674               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      675               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      676               v-ch#Worksheet = ch#WorkSheet.
      677               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      678               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      679               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      680               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      681            no-error .
      682            if error-status:error
      683            then do:
      684               Make-Excel-com = false .
      685               Make-Excel = false .
      686               output Stream  ForExcel close.
      687               os-delete value( string( session:temp-directory ) +
      688                              "rpt" + string( g#report-num ) + ".txt":U ) .
      689               os-delete value( string( session:temp-directory ) +
      690                              "rpt" + string( g#report-num ) + ".frm":U ) .
      691               return.
      692            end.
      693         end.
      694      end.
      695   end.
      696   procedure CloseForExcel :
      697      define variable ii as integer no-undo .
      698      define variable vsheet-num as integer no-undo.
      699      if Make-Excel
      700      then  do:
      701         output Stream  ForExcel close.
      702         os-delete value( string( session:temp-directory ) +
      703                                "rpt" + string( g#report-num ) + ".txt":U ) .
      704         os-delete value( string( session:temp-directory ) +
      705                                "rpt" + string( g#report-num ) + ".frm":U ) .
      706         define buffer buf_sheetf for sheetf.
      707         find last buf_sheetf no-error .
      708         if available buf_sheetf
      709         then
      710            vsheet-num = buf_sheetf.sheet-num.
      711         if vsheet-num > 1
      712         then do:
      713            do ii = 2 to vsheet-num:
      714               os-delete value( string( session:temp-directory ) +
      715                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      716            end.
      717         end.
      718   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      719   if valid-handle(ch#WorkSheet) then
      720   RELEASE OBJECT ch#WorkSheet no-error.
      721   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   if valid-handle(ch#Workbook) then
      723   RELEASE OBJECT ch#Workbook no-error.
      724   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725   if valid-handle(ch#ExcelApplication) then
      726   RELEASE OBJECT ch#ExcelApplication no-error.
