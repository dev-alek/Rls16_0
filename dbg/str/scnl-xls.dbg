     2758   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2759     (input  p-obj-type
     2760     ,input  p-obj-code
     2761     ,output v-host-code
     2762     )  .
     2763   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2764   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2765     (input  buf_goods.gds-code
     2766     ,input  '1':U
     2767     ,input  ?
     2768     ,input  v-host-code
     2769     ,input  p-obj-type
     2770     ,input  p-obj-code
     2771     ,output v-vat-pc
     2772     ) no-error .
     2773   if not error-status:error then do:
     2774     return v-vat-pc.
     2775   end.
     2776   else do:
     2777     return ?.
     2778   end.
     2779   end function.
     2780   FUNCTION gdsreffi_last-pcnt returns decimal ( buffer buf_goods for ub.goods
     2781                                             ,input p-obj-type as character
     2782                                             ,input p-obj-code as integer):
     2783   define buffer buf_gds-obj for ub.gds-obj.
     2784   define variable v-value as decimal no-undo .
     2785   find first buf_gds-obj no-lock where
     2786               buf_gds-obj.gds-code = buf_goods.gds-code
     2787         AND  buf_gds-obj.obj-type = p-obj-type
     2788         AND  buf_gds-obj.obj-code = p-obj-code no-error .
     2789   if available buf_gds-obj then do:
     2790     assign
     2791     v-value =
     2792               (buf_gds-obj.price-sale / (if v-curr-r-b = 'base':U
     2793                                         then buf_gds-obj.last-base
     2794                                         else buf_gds-obj.last-rubl)
     2795                 * 100 - 100)
     2796     no-error
     2797     .
     2798   end.
     2799   else do:
     2800     v-value = ?  .
     2801   end.
     2802   return v-value.
     2803   end FUNCTION.
     2804   FUNCTION gdsreffi_in-doc-cli-name returns character ( buffer buf_goods for ub.goods
     2805                                             ,input p-obj-type as character
     2806                                             ,input p-obj-code as integer):
     2807   define buffer buf_gds-obj for ub.gds-obj.
     2808   define buffer buf_trn-doc for ub.trn-doc.
     2809   define buffer buf_clients for ub.clients.
     2810   define buffer buf_parts for ub.parts.
     2811   define variable v-value as decimal no-undo .
     2812   for first buf_gds-obj no-lock where
     2813               buf_gds-obj.gds-code = buf_goods.gds-code
     2814         AND  buf_gds-obj.obj-type = p-obj-type
     2815         AND  buf_gds-obj.obj-code = p-obj-code ,
     2816             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_gds-obj.in-code,
     2817             first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and  buf_clients.obj-code = buf_trn-doc.cli-code:
     2818           return buf_clients.obj-name .
     2819   end.
     2820   for first buf_parts no-lock where
     2821              buf_parts.artic = buf_goods.artic
     2822         and  buf_parts.prod-type = buf_goods.prod-type
     2823         and  buf_parts.prod-code = buf_goods.prod-code
     2824         AND  buf_parts.obj-type = p-obj-type
     2825         AND  buf_parts.obj-code = p-obj-code
     2826         and  buf_parts.out-code = 'free-zone':U ,
     2827             first buf_clients no-lock where buf_clients.obj-type = buf_parts.supp-type and  buf_clients.obj-code = buf_parts.supp-code:
     2828           return buf_clients.obj-name .
     2829   end.
     2830   end FUNCTION.
     2831   PROCEDURE gds-ref-fi:
     2832   DEFINE PARAMETER BUFFER fi-goods for ub.goods.
     2833   DEFINE PARAMETER BUFFER fi-gds-obj for ub.gds-obj.
     2834   DEFINE INPUT PARAMETER v-obj-type like ub.clients.obj-type.
     2835   DEFINE INPUT PARAMETER v-obj-code like ub.clients.obj-code.
     2836   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2837   define input parameter p-excel as logical no-undo .
     2838   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     2839   DEFINE VARiable II AS INTEGER NO-UNDO.
     2840   DEFINE BUFFER fi-gds-prt for ub.gds-prt.
     2841   define buffer fi-condition-keeping for ub.condition-keeping .
     2842   DEFINE variable myfi as char no-undo extent 1.
     2843   DEFINE VARiable jj as integer no-undo init 1.
     2844   DEFINE variable Myformat as character no-undo.
     2845   DEFINE VARiable vNum-entries as integer no-undo.
     2846   DEFINE VARiable entry-ii as character no-undo.
     2847   DEFINE VARiable vvalue as character no-undo.
     2848   DEFINE VARiable vtype as character no-undo.
     2849   DEFINE VARiable vlabel as character no-undo.
     2850   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2851     IF v-gds-ref-fi = "" then
     2852     v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2853    if avail fi-goods then do:
     2854         FIND FIRST fi-gds-obj NO-LOCK where
     2855                    fi-gds-obj.gds-code = fi-goods.gds-code AND
     2856                    fi-gds-obj.obj-type = p-curr-obj-type AND
     2857                    fi-gds-obj.obj-code = p-curr-obj-code NO-ERROR.
     2858   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2859     DO ii = 1 to vNum-entries:
     2860       entry-ii = ENTRY(ii, v-gds-ref-fi).
     2861       find first buf_usr-flt_custom-labels where
     2862                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2863            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2864            and  buf_usr-flt_custom-labels.call-point =  'gdsreffi':U
     2865            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2866       if  available buf_usr-flt_custom-labels then do:
     2867         case buf_usr-flt_custom-labels.tbl-name:
     2868           when 'goods':U then do:
     2869             if entry(2, entry-ii, ".") begins "#" then do:
     2870               assign
     2871               myfi[jj] =
     2872                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-goods)
     2873                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2874             end.
     2875             else do:
     2876               myfi[jj] =
     2877                           string(buffer fi-goods:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2878             end.
     2879           end.
     2880           when 'gds-obj':U then do:
     2881             if entry(2, entry-ii, ".") begins "#" then do:
     2882               assign
     2883               myfi[jj] =
     2884                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func
     2885                                         ,buffer fi-goods
     2886                                         ,input v-obj-type
     2887                                         ,input v-obj-code
     2888                                         )
     2889                          , buf_usr-flt_custom-labels.custom-format) no-error .
     2890             end.
     2891             else do:
     2892               if available fi-gds-obj then do:
     2893                 myfi[jj] =
     2894                             string(buffer fi-gds-obj:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2895               end.
     2896               else do:
     2897                 myfi[jj] =
     2898                 ""
     2899                 .
     2900               end.
     2901             end.
     2902           end.
     2903           when 'goods-attr':U then do:
     2904             if entry(2, entry-ii, ".") begins "#" then do:
     2905             end.
     2906             else do:
     2907               vvalue = "[!!Ошибка]".
     2908               run gds-attr-value in this-procedure ( fi-goods.gds-code
     2909                                                     ,input entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2910                                                     ,output vvalue
     2911                                                     ,output vtype) no-error.
     2912               myfi[jj] =
     2913                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2914             end.
     2915           end.
     2916           when 'gds-obj-attr':U then do:
     2917             if entry(2, entry-ii, ".") begins "#" then do:
     2918             end.
     2919             else do:
     2920               vvalue = "[!!Ошибка]".
     2921               run gdsoattr-value in this-procedure (
     2922                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2923                                                    ,input  fi-goods.gds-code
     2924                                                    ,input v-obj-type
     2925                                                    ,input v-obj-code
     2926                                                    ,output vvalue
     2927                                                    ,output vtype
     2928                                                    ) no-error .
     2929               myfi[jj] =
     2930                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2931             end.
     2932           end.
     2933           when 'gds-host-attr':U then do:
     2934             if entry(2, entry-ii, ".") begins "#" then do:
     2935             end.
     2936             else do:
     2937               vvalue = "[!!Ошибка]".
     2938               run gdshattr-value in this-procedure (
     2939                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2940                                                    ,input  fi-goods.gds-code
     2941                                                    ,input v-obj-type
     2942                                                    ,input v-obj-code
     2943                                                    ,output vvalue
     2944                                                    ,output vtype
     2945                                                    ) no-error .
     2946               myfi[jj] =
     2947                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2948             end.
     2949           end.
     2950         end case.
     2951         if p-excel then do:
     2952           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     2953           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     2954           then do:
     2955             myfi[jj] = replace(myfi[jj], chr(44), "").
     2956           end.
     2957         end.
     2958         if jj = 9 then LEAVE.
     2959       end.
     2960         else if entry(1, entry-ii, ".") = 'goods-attr':U then  do:
     2961           vvalue = "[!!Ошибка]".
     2962                   run gds-attr-value in this-procedure ( fi-goods.gds-code
     2963                                                         ,input (SUBSTRING (entry-ii,INDEX(entry-ii,"_") + 1))
     2964                                                         ,output vvalue
     2965                                                         ,output vtype) no-error.
     2966                   myfi[jj] = vvalue.
     2967         end.
     2968     END.
     2969     end.
     2970     assign
     2971     fi-1 = myfi[1]
     2972     .
     2973   END PROCEDURE.
     2974   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2975   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2976     (output v-curr-r-b
     2977     )  .
     2978   FUNCTION get-function returns character(
     2979   input p-f-name as character,
     2980   input p-format as character
     2981   ):
     2982   define variable main-b-code like ub.bar-code.b-code no-undo .
     2983   define variable bar_code as character no-undo .
     2984   define variable bar_bar_code as character no-undo .
     2985   define variable price-sale as decimal no-undo .
     2986   define variable for-road as decimal no-undo .
     2987   define variable for-excise as decimal no-undo .
     2988   define variable v-doc-num as character no-undo .
     2989   define variable v-last-inv-date-num as character no-undo.
     2990     do
     2991     on error undo, return error
     2992     :
     2993       CASE p-f-name:
     2994         when "iColumn":U then do:
     2995           return string(iColumn, p-format).
     2996         end.
     2997         when "qnty":U then do:
     2998           return string(scn-list.qnty,  p-format).
     2999         end.
     3000         when "vat-value":U then do:
     3001           return string(vat-value, p-format).
     3002         end.
     3003         when "slt-value":U then do:
     3004           return string(slt-value, p-format).
     3005         end.
     3006         when "price-sale":U then do:
     3007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3008     (input  scn-list.gds-code
     3009     ,input  ?
     3010     ,output main-b-code
     3011     )  .
     3012   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3014     (input  p-curr-obj-type
     3015     ,input  p-curr-obj-code
     3016     ,input  main-b-code
     3017     ,input  main-b-code
     3018     ,input  0
     3019     ,output v-doc-num
     3020     ,output price-sale
     3021     ,output for-road
     3022     ,output for-excise
     3023     ) no-error .
     3024           return string(price-sale, p-format).
     3025         end.
     3026         when "node-name":U then do:
     3027           return string(v-f-name, p-format).
     3028         end.
     3029         when "gdsbcode-graphic":U then do:
     3030   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3031     (input  scn-list.gds-code
     3032     ,input  ?
     3033     ,output main-b-code
     3034     )  .
     3035           RUN gen-bc in this-procedure ( input main-b-code, output bar_code ).
     3036           run gbl/bctotext.p (
     3037                           input (if length(bar_code) = 13 then 'ean13':U else 'ean8':U)
     3038                          ,input bar_code
     3039                          ,output bar_bar_code) no-error .
     3040           return (chr(4) + bar_bar_code).
     3041         end.
     3042         when "last-inv" then do :
     3043           find last buf_doc-line no-lock where
     3044                     buf_doc-line.artic = scn-list.artic
     3045                 and buf_doc-line.prod-code = scn-list.prod-code
     3046                 and buf_doc-line.prod-type = scn-list.prod-type
     3047                 and buf_doc-line.obj-code = p-curr-obj-code
     3048                 and buf_doc-line.obj-type = p-curr-obj-type
     3049                 and buf_doc-line.status_ = 'факт':U
     3050                 and buf_doc-line.ext-doc-type = 'vt':U no-error.
     3051           if available buf_doc-line then do :
     3052             find first buf_trn-doc no-lock where
     3053                       buf_trn-doc.doc-code = buf_doc-line.doc-code no-error.
     3054             if available buf_trn-doc then do :
     3055               assign
     3056                 v-last-inv-date-num = string(buf_trn-doc.fact-date) + " № " + buf_trn-doc.doc-code
     3057               .
     3058             end.
     3059           end.
     3060           else do :
     3061             assign
     3062               v-last-inv-date-num = "[!!Нет инвентаризаций по данному товару]"
     3063             .
     3064           end.
     3065           return v-last-inv-date-num.
     3066         end.
     3067       END CASE.
     3068     end.
     3069   end FUNCTION.
     3070   for each buf_usr-flt_custom-labels:
     3071     delete buf_usr-flt_custom-labels.
     3072   end.
     3073   for each  buf_custom-labels no-lock where
     3074             buf_custom-labels.call-type = 'add-fields':U
     3075         and buf_custom-labels.call-point = 'gdsreffi':U:
     3076     create buf_usr-flt_custom-labels.
     3077     buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     3078   end.
     3079   if not valid-handle(my-handle) then do:
     3080     assign
     3081     my-handle = parparentproc.
     3082   end.
     3083   run init-prn-template in this-procedure .
     3084   run gbl/prntput.p (c-point, output v-rec).
     3085   run gbl/prntmpl.w (
     3086                   input parparentproc
     3087                 , input "":U
     3088                 , input c-point
     3089                 , input Tbl
     3090                 , input join-tbl
     3091                 , input Fld
     3092                 , input Lab
     3093                 , input Spr
     3094                 , input v-size
     3095                 , input v-format
     3096                 , input Dim
     3097                 , input-output v-rec
     3098                 , OUTPUT V-LENGTH
     3099                 , OUTPUT V-NUM-CLMN
     3100               ).
     3101   if v-rec = ? then return.
     3102   find first ubflt.filter no-lock where
     3103              recid(ubflt.filter) = v-rec no-error .
     3104   if not avail ubflt.filter then return.
     3105   do jj = 1 to num-entries(ubflt.filter.Fields-sort):
     3106     assign
     3107     f-name-1 = "":U
     3108     v-frm-set = no
     3109     .
     3110     do jj-1 = 1 to num-entries(entry(jj, ubflt.filter.Fields-sort), "*":U):
     3111       if (entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "artic"
     3112           or
     3113           entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = "b-str")
     3114       and lookup(string(jj) + "=@":U, v-eng-frm) = 0
     3115       then
     3116       assign
     3117       v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3118       v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3119       sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3120       v-frm-set = yes
     3121       .
     3122       case entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), "."):
     3123         when 'goods':U or when 'gds-obj':U then do:
     3124           assign
     3125           f-n = entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3126           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".")
     3127           .
     3128         end.
     3129         when 'gds-obj-attr':U
     3130         or
     3131         when 'gds-host-attr':U
     3132         or
     3133         when 'goods-attr':U
     3134         then do:
     3135           assign
     3136           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3137           entry(1, f-n, ".") = "attr-value_"
     3138           f-n = replace(f-n, ".", "")
     3139           t-name = entry(1, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".").
     3140         end.
     3141         when "function":U then do:
     3142           assign
     3143           t-name = ''
     3144           f-n = entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U)
     3145           .
     3146           if entry(2, entry(jj-1, entry(jj, ubflt.filter.Fields-sort), "*":U), ".") = 'gdsbcode-graphic':U
     3147           then do:
     3148             assign
     3149             v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=0":U
     3150             v-eng-frm = v-eng-frm + (if v-eng-frm = "":U then "":U else ";") + string(jj) + "=@":U
     3151             v-frm-set = yes
     3152             .
     3153             assign
     3154             sheetf.colformat = v-osn-frm + chr(4) + v-eng-frm
     3155             Sheetf.Bas-File = "exe/anyl-xls.bas"
     3156             Sheetf.Bas-Params = Sheetf.Bas-Params +
     3157                                 (if Sheetf.Bas-Params = '':U
     3158                                  then '':U
     3159                                  else chr(4)) + string(jj)
     3160             .
     3161           end.
     3162         end.
     3163       END CASE.
     3164       assign
     3165       f-name-1 = f-name-1 + (if f-name-1 = "":U then "":U else "*":U) + (if t-name <> '':U then (t-name + ".") else '') + f-n
     3166       .
     3167       if v-frm-set = no then do:
     3168         assign
     3169         v-osn-frm = v-osn-frm + (if v-osn-frm = "":U then "":U else ";") + string(jj) + "=" +
     3170                     prnfield_get-fformat(entry(jj, ubflt.filter.lst-cend)
     3171                                ,entry(jj, ubflt.filter.where-ysl-rus, chr(4)))
     3172         .
     3173       end.
     3174     end.
     3175     assign
     3176     f-name = f-name + (if f-name = "":U then "":U else chr(44)) + f-name-1
     3177     .
     3178   end.
     3179   assign
     3180   j-n = num-entries(f-name)
     3181   .
     3182   Sheetf.Bas-Params = string(5) + chr(4) + Sheetf.Bas-Params.
     3183   Make-excel = yes.
     3184   run get-report-num  in parParentProc(output g#report-num).
     3185   if Make-Excel then
     3186   RUN OpenForExcel in this-procedure .
