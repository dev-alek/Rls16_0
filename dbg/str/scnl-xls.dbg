     2424               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2425               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2426               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2427                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2428               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     2429         otherwise do:
     2430           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     2431         end.
     2432       end CASE.
     2433     end.
     2434   end procedure.
     2435   procedure uf-get :
     2436     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2437     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2438     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2439     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2440     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2441     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2442     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2443     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2444     do
     2445     on error undo, return error
     2446     :
     2447       define buffer buf_usr-flt for ubflt.usr-flt .
     2448       define variable v-use-List_     as logical   no-undo .
     2449       define variable v-type-List_     as character no-undo .
     2450       define variable v-format-List_   as character no-undo .
     2451       define variable v-use-Naim      as logical   no-undo .
     2452       define variable v-type-Naim      as character no-undo .
     2453       define variable v-format-Naim    as character no-undo .
     2454       define variable v-use-print-graft as logical   no-undo .
     2455       define variable v-use-sort-gr     as logical   no-undo .
     2456       define variable v-use-type-price  as logical   no-undo .
     2457       define variable v-use-type-val    as logical   no-undo .
     2458       define variable v-label          as character no-undo .
     2459       define variable v-tooltip        as character no-undo .
     2460       define variable v-user-can-edit  as logical   no-undo .
     2461       define variable v-output-display as logical   no-undo .
     2462       define variable v-other          as character no-undo .
     2463       run uf-name in this-procedure
     2464          (input  entry(1, p-code, chr(4))
     2465         ,output v-use-List_
     2466         ,output v-type-List_
     2467         ,output v-format-List_
     2468         ,output v-use-Naim
     2469         ,output v-type-Naim
     2470         ,output v-format-Naim
     2471         ,output v-use-print-graft
     2472         ,output v-use-sort-gr
     2473         ,output v-use-type-price
     2474         ,output v-use-type-val
     2475         ,output v-label
     2476         ,output v-tooltip
     2477         ,output v-user-can-edit
     2478         ,output v-output-display
     2479         ,output v-other
     2480         ) no-error .
     2481       if error-status :error then do:
     2482         undo, return error return-value .
     2483       end.
     2484       find first buf_usr-flt no-lock where
     2485                  buf_usr-flt.Call-point     = p-code AND
     2486                  buf_usr-flt.user-name       = p-user-name
     2487         no-error .
     2488       if avail buf_usr-flt then do:
     2489         assign
     2490         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2491         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2492         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2493         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2494         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2495         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2496         .
     2497       end.
     2498       else do:
     2499         assign
     2500         p-List_        = (if v-use-List_       then "":U                    else ?)
     2501         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2502         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2503         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2504         p-type-price   = (if v-use-type-price  then no                      else ?)
     2505         p-type-val     = (if v-use-List_       then no                      else ?)
     2506         .
     2507       end.
     2508     end.
     2509   end procedure.
     2510   procedure uf-set :
     2511     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2512     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2513     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2514     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2515     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2516     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2517     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2518     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2519     do
     2520     on error undo, return error
     2521     :
     2522       define buffer buf_usr-flt for ubflt.usr-flt .
     2523       define variable v-use-List_     as logical   no-undo .
     2524       define variable v-type-List_     as character no-undo .
     2525       define variable v-format-List_   as character no-undo .
     2526       define variable v-use-Naim      as logical   no-undo .
     2527       define variable v-type-Naim      as character no-undo .
     2528       define variable v-format-Naim    as character no-undo .
     2529       define variable v-use-print-graft as logical   no-undo .
     2530       define variable v-use-sort-gr   as logical   no-undo .
     2531       define variable v-use-type-price as logical   no-undo .
     2532       define variable v-use-type-val  as logical   no-undo .
     2533       define variable v-tooltip        as character no-undo .
     2534       define variable v-label          as character no-undo .
     2535       define variable v-user-can-edit  as logical   no-undo .
     2536       define variable v-output-display as logical   no-undo .
     2537       define variable v-other          as character no-undo .
     2538       run uf-name in this-procedure
     2539         (input  entry(1, p-code, chr(4))
     2540         ,output v-use-List_
     2541         ,output v-type-List_
     2542         ,output v-format-List_
     2543         ,output v-use-Naim
     2544         ,output v-type-Naim
     2545         ,output v-format-Naim
     2546         ,output v-use-print-graft
     2547         ,output v-use-sort-gr
     2548         ,output v-use-type-price
     2549         ,output v-use-type-val
     2550         ,output v-label
     2551         ,output v-tooltip
     2552         ,output v-user-can-edit
     2553         ,output v-output-display
     2554         ,output v-other
     2555         ) no-error .
     2556       if error-status :error then do:
     2557         undo, return error return-value .
     2558       end.
     2559       find first buf_usr-flt where
     2560                  buf_usr-flt.Call-point     = p-code AND
     2561                  buf_usr-flt.user-name       = p-user-name
     2562         no-error .
     2563       if not avail buf_usr-flt then do:
     2564           create buf_usr-flt .
     2565           assign
     2566           buf_usr-flt.call-point = p-code
     2567           buf_usr-flt.user-name  = p-user-name
     2568           .
     2569       end.
     2570       if avail buf_usr-flt then do:
     2571        assign
     2572        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2573        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2574        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2575        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2576        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2577        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2578       .
     2579       release buf_usr-flt.
     2580       end.
     2581       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2582     end.
     2583   end procedure.
     2584   DEFINE VARIABLE iColumn                 AS INTEGER no-undo.
     2585   DEFINE VARIABLE ii as integer no-undo.
