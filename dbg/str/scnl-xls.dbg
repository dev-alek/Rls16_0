     2336   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     2337   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     2338   procedure uf-name :
     2339     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2340     define output parameter p-use-List_     as logical   no-undo .
