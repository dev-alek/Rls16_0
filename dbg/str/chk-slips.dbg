        1   define input parameter p-db-num as integer no-undo .
        2   define input parameter p-CheckId as character no-undo .
        3   define input parameter p-RRN as character no-undo .
        4   define variable print-type as character no-undo.
        5   define buffer chk-slip-head for ub.chk-slip-head .
        6   function func-proc-type returns character
        7   (input v-int-type as integer):
        8     case v-int-type :
        9       when 1 then return "Банковский" .
       10       when 2 then return "Лояльность" .
       11       when 3 then return "Топливный" .
       12       otherwise return " - " .
       13     end case .
       14   end function .
       15   DEFINE MENU MENU-B-print
       16          MENU-ITEM m_one         LABEL "Текущий"
       17          MENU-ITEM m_all         LABEL "Все"  .
       18   DEFINE BUTTON b-exit AUTO-END-KEY
       19        LABEL "Выход"
       20        SIZE 15 BY 1.14
       21        BGCOLOR 8 .
       22   DEFINE BUTTON b-print
       23        LABEL "Сохранить в файл"
       24        SIZE 17 BY 1.14
       25        BGCOLOR 8 .
       26   define query br-chk-slip-head for chk-slip-head scrolling .
       27   define browse br-chk-slip-head
       28     query br-chk-slip-head display
       29     chk-slip-head.ID
       30     func-proc-type(chk-slip-head.proc-type) label "Тип процессинга"
       31     chk-slip-head.RRN
       32   WITH SEPARATORS SIZE 70 BY 6 FIT-LAST-COLUMN.
       33   DEFINE FRAME Dialog-Frame
       34        b-exit AT ROW 1.1 COL 2
       35        b-print AT ROW 1.1 COL 18.8 WIDGET-ID 2
       36        br-chk-slip-head at row 2.3 col 2
       37        SPACE(1) SKIP(1)
       38       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       39            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       40            TITLE "Слипы"
       41            CANCEL-BUTTON b-exit WIDGET-ID 100.
       42   ASSIGN
       43          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       44          FRAME Dialog-Frame:HIDDEN           = TRUE.
       45   ASSIGN
       46          b-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
       47   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       48   DO:
       49     APPLY "END-ERROR":U TO SELF.
       50   END.
       51   ON RETURN OF br-chk-slip-head IN FRAME Dialog-Frame
       52   OR mouse-select-dblclick of br-chk-slip-head in frame Dialog-Frame
       53   do:
       54     if not available chk-slip-head
       55     then do :
       56       return no-apply .
       57     end .
       58     run str/chk-slip.w (input chk-slip-head.db-num,
       59                         input chk-slip-head.ID,
       60                         input chk-slip-head.CheckID,
       61                         input chk-slip-head.RRN)
       62                         .
       63   end.
       64   ON CHOOSE OF b-print IN FRAME Dialog-Frame
       65   DO:
       66     if not available chk-slip-head
       67     then do :
       68       return no-apply .
       69     end .
       70     if print-type = "" then do:
       71       run gbl/pop-up.p ( input b-print:handle, input no) no-error.
       72       if error-status:error then return no-apply.
       73     end.
       74     if print-type = "" then return no-apply.
       75     run str/chk-slip-print.p (input chk-slip-head.db-num,
       76                               input chk-slip-head.ID,
       77                               input chk-slip-head.CheckID,
       78                               input chk-slip-head.RRN,
       79                               input print-type)
       80                               .
       81   END.
       82   ON CHOOSE OF MENU-ITEM m_one
       83   DO:
       84       print-type = "one":U.
       85       apply "choose" to b-print in frame Dialog-Frame.
       86   END.
       87   ON CHOOSE OF MENU-ITEM m_all
       88   DO:
       89       if p-RRN = ?
       90       then do :
       91         print-type = "all":U.
       92       end .
       93       else do :
       94         print-type = "all_pay":U.
       95       end .
       96       apply "choose" to b-print in frame Dialog-Frame.
       97   END.
       98   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       99   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      100   MAIN-BLOCK:
      101   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      102      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      103     b-print:MENU-MOUSE = 1 .
      104     if p-RRN = ?
      105     then do :
      106       find first chk-slip-head no-lock where chk-slip-head.db-num = p-db-num
      107                                          and chk-slip-head.CheckID = p-CheckId
      108                                          and chk-slip-head.is-report = 0
      109                                          no-error.
      110       if not available chk-slip-head
      111       then do :
      112         message "Слипы не найдены!" view-as alert-box .
      113         return .
      114       end .
      115     end .
      116     else do :
      117       find first chk-slip-head no-lock where chk-slip-head.db-num = p-db-num
      118                                          and chk-slip-head.CheckID = p-CheckId
      119                                          and chk-slip-head.RRN = p-RRN
      120                                          and chk-slip-head.is-report = 0
      121                                          no-error.
      122       if not available chk-slip-head
      123       then do :
      124         message "Слипы не найдены!" view-as alert-box .
      125         return .
      126       end .
      127     end .
      128     RUN enable_UI.
      129     if p-RRN = ?
      130     then do :
      131       open query br-chk-slip-head for each chk-slip-head no-lock where chk-slip-head.db-num = p-db-num
      132                                                                    and chk-slip-head.CheckID = p-CheckId
      133                                                                    and chk-slip-head.is-report = 0 .
      134     end .
      135     else do :
      136       open query br-chk-slip-head for each chk-slip-head no-lock where chk-slip-head.db-num = p-db-num
      137                                                                    and chk-slip-head.CheckID = p-CheckId
      138                                                                    and chk-slip-head.RRN = p-RRN
      139                                                                    and chk-slip-head.is-report = 0
      140                                                                    .
      141     end .
      142     WAIT-FOR GO OF FRAME Dialog-Frame.
      143   END.
      144   RUN disable_UI.
      145   PROCEDURE disable_UI :
      146     HIDE FRAME Dialog-Frame.
      147   END PROCEDURE.
      148   PROCEDURE enable_UI :
      149     ENABLE b-exit b-print br-chk-slip-head
      150         WITH FRAME Dialog-Frame.
      151     VIEW FRAME Dialog-Frame.
      152   END PROCEDURE.
