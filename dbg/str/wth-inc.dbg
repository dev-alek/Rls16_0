     1697   end.
     1698     DEFINE VARIABLE loc-ref-list as character no-undo.
     1699     DEFINE VARIABLE var-doc-code like ub.wth-doc.doc-code no-undo .
     1700     if tt-wth-doc.borned then do:
     1701       assign
     1702       var-doc-code = tt-wth-doc.source-ref.
     1703     end.
     1704     else do:
     1705       var-doc-code = tt-wth-doc.doc-code.
     1706     end.
     1707     run str/chk-docs.w (
     1708                     input parparentproc
     1709                    ,input '':U
     1710                    ,input 'out-code':U
     1711                    ,input ?
     1712                    ,input parobj-type
     1713                    ,input parobj-code
     1714                    ,input var-doc-code
     1715                    ,input ''
     1716                    ,input 0
     1717                    ,input ?
     1718                    ,input ?
     1719                    ,input 0
     1720                    ,output loc-ref-list) no-error.
     1721     if error-status:error then return no-apply.
     1722   END.
     1723   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
     1724   DO:
     1725   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1726   if lookup(self :type
     1727            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1728            ) = 0
     1729   then do:
     1730     message
     1731       "$Workfile$"
     1732       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1733       "Интерфейсный элемент" self :name  skip
     1734       "Тип" self :type  skip
     1735       "Процедура" this-procedure :file-name skip
     1736       view-as alert-box .
     1737   end.
     1738   else do:
     1739     apply "entry":u to self  .
     1740     if focus :handle <> self :handle  then do:
     1741       return no-apply .
     1742     end.
     1743   end.
     1744    define variable v_rid as character no-undo.
     1745    define variable ref-rec as recid no-undo .
     1746      FIND FIRST buf_clients NO-LOCK WHERE
     1747               buf_clients.obj-type = INPUT FRAME Dialog-Frame tt-wth-doc.cli-type AND
     1748               buf_clients.obj-code = INPUT FRAME Dialog-Frame tt-wth-doc.cli-code  NO-ERROR.
     1749      IF available(buf_clients) then do:
     1750       run ref/cli-all.w (
     1751                    input parparentproc
     1752                  ,input "b-sel":U
     1753                  ,input tt-wth-doc.cli-type
     1754                  ,input 'все':U
     1755                  ,input 'все':U
     1756                  ,input RECID( buf_clients )
     1757                  ,input ",,,,,,NO"
     1758                  ,input ?
     1759                  ,OUTPUT v_rid ).
     1760     END.
     1761     ELSE DO:
     1762       run ref/cli-all.w (
     1763                    input parparentproc
     1764                   ,INPUT "b-sel":U
     1765                  ,input  tt-wth-doc.cli-type:screen-value
     1766                  ,input 'все':U
     1767                  ,input 'текущие':U
     1768                  ,input ?
     1769                  ,input ",,,,,,NO"
     1770                  ,input ?
     1771                  ,OUTPUT v_rid ).
     1772     END.
     1773     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1774       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1775       IF ERROR-STATUS:ERROR THEN DO:
     1776           RETURN NO-APPLY.
     1777       END.
     1778       FIND FIRST buf_clients NO-LOCK WHERE
     1779                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1780       IF AVAIL buf_clients THEN DO:
     1781         CASE buf_clients.obj-type:
     1782           when 'маг':U then dO:
     1783             find first ub.shop No-LOCK WHERE
     1784                       ub.shop.obj-code = buf_clients.obj-code No-ERROR.
     1785             if ub.shop.host-code <> tt-wth-doc.host-code then do:
     1786               message "Нельзя выбрать магазин другой фирмы!"
     1787               view-as alert-box error .
     1788               return no-apply.
     1789             end.
     1790           end.
     1791           when 'скл':U then do:
     1792             find first ub.store No-LOCK WHERE
     1793                       ub.store.obj-code = buf_clients.obj-code No-ERROR.
     1794             if ub.store.host-code <> tt-wth-doc.host-code then do:
     1795               message "Нельзя выбрать склад другой фирмы!"
     1796               view-as alert-box error .
     1797               return no-apply.
     1798             end.
     1799           end.
     1800         end CASE.
     1801         ASSIGN
     1802         tt-wth-doc.cli-code = buf_clients.obj-code
     1803         tt-wth-doc.cli-type = buf_clients.obj-type
     1804         tt-wth-doc.cli-name = buf_clients.obj-name
     1805         .
     1806         DISPLAY
     1807         tt-wth-doc.cli-type
     1808         tt-wth-doc.cli-code
     1809         tt-wth-doc.cli-name
     1810         WITH FRAME Dialog-Frame.
     1811       END.
     1812       ELSE DO:
     1813         RETURN NO-APPLY.
     1814       END.
     1815     END.
     1816     ELSE DO:
     1817       RETURN NO-APPLY.
     1818     END.
     1819     run control-out in this-procedure.
     1820   END.
     1821   ON CHOOSE OF B-current IN FRAME Dialog-Frame
     1822   DO:
     1823   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1824   if lookup(self :type
     1825            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1826            ) = 0
