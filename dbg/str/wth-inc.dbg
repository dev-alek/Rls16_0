     1438   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1439   DO:
     1440   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1441   if lookup(self :type
     1442            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1443            ) = 0
     1444   then do:
     1445     message
     1446       "$Workfile$"
     1447       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1448       "Интерфейсный элемент" self :name  skip
     1449       "Тип" self :type  skip
     1450       "Процедура" this-procedure :file-name skip
     1451       view-as alert-box .
     1452   end.
     1453   else do:
     1454     apply "entry":u to self  .
