     1483     def var v-zone as char no-undo.
     1484     run proc-save-doc in this-procedure ( input no) No-ERROR.
     1485     if error-status:error
     1486     or return-value = 'error'
     1487     then return 'error'.
     1488     assign
     1489     v-doc-rec = recid(bf_wth-doc)
     1490     .
     1491     case tt-wth-doc.ext-doc-type:
     1492       when 'ee':U or when 'df':U     then v-zone = 'free-zone':U.
     1493       when 'ep':U or when 'dp':U then v-zone = 'put-zone':U.
     1494       when 'dc':U or when 'pz':U or when 'xc':U then v-zone = 'cli-zone':U.
     1495       otherwise do:
     1496         message "Для данного типа документа функция ВСЯ ЗОНА не доступна." view-as alert-box.
     1497         return no-apply.
     1498       end.
     1499     end case.
     1500     define variable v_rid-list AS CHAR NO-UNDO.
     1501     run ref/wth-ref.w (
     1502                    input parparentproc
     1503                   ,input "b-sel,b-mark":U
     1504                   ,input tt-wth-doc.host-code
     1505                   ,input tt-wth-doc.obj-type
     1506                   ,input tt-wth-doc.obj-code
     1507                   ,input "wth-ser":U
     1508                   ,input-OUTPUT v_rid-list ) no-error.
     1509     if error-status:error then do:
     1510       message return-value + error-status:get-message(1) view-as alert-box error title 'Ошибка при запуске справочника МЦ'.
     1511       return.
     1512     end.
     1513     if v_rid-list = "":u then return no-apply.
     1514     run proc-allZone in this-procedure (v_rid-list
     1515                                        ,v-zone)  no-error.
     1516     if error-status:error then do:
     1517       run waitfram-hide in this-procedure .
     1518       message return-value + error-status:get-message(1) view-as alert-box error.
     1519       return no-apply.
     1520     end.
     1521   END.
     1522   ON CHOOSE OF B-bar IN FRAME Dialog-Frame
     1523   DO:
     1524     run proc-save-doc in this-procedure ( input no) No-ERROR.
     1525     if error-status:error
     1526     or return-value = 'error'
     1527     then return no-apply.
     1528     run str/bar-wth.w ( input bf_wth-doc.doc-code
     1529                          ,input for-current-w-p-code
     1530                          ,input for-out-w-p-code ) NO-ERROR.
     1531     IF ERROR-STATUS:ERROR THEN DO:
     1532         MESSAGE RETURN-VALUE VIEW-AS ALERT-BOX ERROR.
     1533     END.
