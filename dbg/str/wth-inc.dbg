     4467     end.
     4468     if available cli-buf and can-do( 'чел':U, cli-buf.obj-type ) then do:
     4469       display cli-buf.obj-code @ tt-wth-doc.receiver
     4470               cli-buf.obj-name @ receiver-name with frame Dialog-Frame.
     4471       assign frame Dialog-Frame tt-wth-doc.receiver.
     4472     end.
     4473     else display ? @ tt-wth-doc.receiver
     4474                  ? @ receiver-name with frame Dialog-Frame.
     4475     apply "entry" to  b-exit in frame Dialog-Frame.
     4476   if available cli-buf then do:
     4477         display cli-buf.obj-code @ tt-wth-doc.receiver cli-buf.obj-name @ receiver-name with frame Dialog-Frame.
     4478     end.
     4479     else display ? @ tt-wth-doc.receiver ? @ receiver-name with frame Dialog-Frame.
     4480         return no-apply.
     4481   end.
     4482   if p-man = "receiver" and p-action = "leave" then do:
     4483     define variable v-ref-rec42   as recid no-undo .
     4484     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.receiver
     4485                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4486   if available cli-buf then do:
     4487         display cli-buf.obj-code @ tt-wth-doc.receiver cli-buf.obj-name @ receiver-name with frame Dialog-Frame.
     4488             assign frame Dialog-Frame tt-wth-doc.receiver.
     4489     end.
     4490     else display ? @ tt-wth-doc.receiver ? @ receiver-name with frame Dialog-Frame.
     4491   end.
     4492   END PROCEDURE.
     4493   PROCEDURE lock-proc :
     4494   DEFINE INPUT PARAMETER lock-doc as logical no-undo.
     4495   if lock-doc then do:
     4496       DISABLE
     4497       b-cli
     4498       tt-wth-doc.cli-type
     4499       tt-wth-doc.cli-code
     4500       B-current  when for-current-w-p-code > 0
     4501       B-out
     4502       for-current-w-p-code when for-current-w-p-code > 0
     4503       for-out-w-p-code
     4504       with frame Dialog-Frame
     4505       .
     4506       enable
     4507       b-chg when par-mode <> 'ПРОСМОТР':U
     4508       b-del when par-mode <> 'ПРОСМОТР':U and not tt-wth-doc.auto-fill AND not (lookup(tt-wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and not tt-wth-doc.exter_)
     4509       b-lookup
     4510       B-current when for-current-w-p-code = 0 and tt-wth-doc.ext-doc-type <> 'dc':U
     4511       for-current-w-p-code when for-current-w-p-code = 0 and tt-wth-doc.ext-doc-type <> 'dc':U
     4512       with frame Dialog-Frame
     4513       .
     4514   end.
     4515   else do:
     4516       ENABLE
     4517       b-cli when (not tt-wth-doc.inter_ and not locked-cli)
     4518       tt-wth-doc.cli-type when (not tt-wth-doc.inter_  and not locked-cli)
     4519       tt-wth-doc.cli-code when (not tt-wth-doc.inter_  and not locked-cli)
     4520       B-current  when  tt-wth-doc.ext-doc-type <> 'dc':U
     4521       for-current-w-p-code  when  tt-wth-doc.ext-doc-type <> 'dc':U
     4522       with frame Dialog-Frame
     4523       .
     4524       disable
     4525       b-chg
     4526       b-del
     4527       b-lookup
     4528         with frame Dialog-Frame
     4529       .
     4530       run control-out.
     4531   end.
     4532   END PROCEDURE.
     4533   PROCEDURE MyEnable :
     4534   DEFINE VARIABLE v-place-name-h AS HANDLE NO-UNDO.
     4535   ASSIGN
     4536   v-place-name-h = browse br-lines:FIRST-COLUMN
     4537   .
     4538   DO WHILE VALID-HANDLE(v-place-name-h):
     4539     IF v-place-name-h:label = "Название места" THEN DO:
     4540         LEAVE.
     4541     END.
     4542     v-place-name-h = v-place-name-h:NEXT-COLUMN
     4543     .
     4544   END.
     4545   IF lookup(tt-wth-doc.ext-doc-type , 'ci,ce':U) = 0 THEN DO:
     4546       ASSIGN
     4547       v-place-name-h:VISIBLE = NO
     4548       .
     4549   END.
     4550   assign
     4551   tt-wth-doc.sum-gds-rubl:label in frame Dialog-Frame = "Сумма по тов.(рубл).".
     4552   if lookup(tt-wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
     4553   or tt-wth-doc.doc-type = 'декл':U
     4554   or tt-wth-doc.inter_ = yes
     4555    then
     4556       assign
     4557       locked-cli = yes
     4558       .
     4559   else     locked-cli = no.
     4560   if (tt-wth-doc.doc-type = 'при':U and tt-wth-doc.inter_ = no and  not tt-wth-doc.exter_ ) then
     4561   assign v-view-fact = yes.
     4562   else v-view-fact = no.
     4563   buf_wth-line.creid:READ-ONLY IN BROWSE BR-lines = YES.
     4564     define variable v-ref-rec43   as recid no-undo .
     4565     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.operator
     4566                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4567   if not available cli-buf then do:
     4568     display tt-wth-doc.operator with frame Dialog-Frame.
     4569     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.operator
     4570                            and cli-buf.obj-type = 'чел':U no-error.
     4571   end.
     4572   if available cli-buf then do:
     4573         display cli-buf.obj-code @ tt-wth-doc.operator cli-buf.obj-name @ operator-name with frame Dialog-Frame.
     4574     end.
     4575     else display ? @ tt-wth-doc.operator ? @ operator-name with frame Dialog-Frame.
     4576     define variable v-ref-rec44   as recid no-undo .
     4577     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.deliver
     4578                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4579   if not available cli-buf then do:
     4580     display tt-wth-doc.deliver with frame Dialog-Frame.
     4581     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.deliver
     4582                            and cli-buf.obj-type = 'чел':U no-error.
     4583   end.
     4584   if available cli-buf then do:
     4585         display cli-buf.obj-code @ tt-wth-doc.deliver cli-buf.obj-name @ deliver-name with frame Dialog-Frame.
     4586     end.
     4587     else display ? @ tt-wth-doc.deliver ? @ deliver-name with frame Dialog-Frame.
     4588     define variable v-ref-rec45   as recid no-undo .
     4589     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.receiver
     4590                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     4591   if not available cli-buf then do:
     4592     display tt-wth-doc.receiver with frame Dialog-Frame.
     4593     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-wth-doc.receiver
     4594                            and cli-buf.obj-type = 'чел':U no-error.
     4595   end.
     4596   if available cli-buf then do:
     4597         display cli-buf.obj-code @ tt-wth-doc.receiver cli-buf.obj-name @ receiver-name with frame Dialog-Frame.
     4598     end.
     4599     else display ? @ tt-wth-doc.receiver ? @ receiver-name with frame Dialog-Frame.
     4600   if tt-wth-doc.ext-doc-type = 'pz':U then do:
     4601     tt-wth-doc.deliver:label = 'Получил'.
     4602     tt-wth-doc.receiver:label = 'Возвратил'.
     4603   end.
     4604   if tt-wth-doc.ext-doc-type = 'ie':U then do:
     4605     tt-wth-doc.deliver:label = 'Получил'.
     4606     tt-wth-doc.receiver:label = 'Отпустил'.
     4607   end.
     4608   if tt-wth-doc.doc-type = 'спи':U then do:
     4609     tt-wth-doc.operator:label = 'Председ.'.
     4610     tt-wth-doc.deliver:label = 'Комиссия'.
     4611     tt-wth-doc.receiver:label = 'Комиссия'.
     4612   end.
     4613       DISPLAY
     4614       tt-wth-doc.fact-date
     4615       tt-wth-doc.doc-code
     4616       tt-wth-doc.doc-date
     4617       tt-wth-doc.shift-num
     4618       shift-name-no-err(buffer tt-wth-doc) @ tt-wth-doc.shift-name
     4619       tt-wth-doc.shift-date
     4620       tt-wth-doc.obj-code
     4621       tt-wth-doc.obj-type
     4622       tt-wth-doc.cli-code
     4623       tt-wth-doc.cli-type
     4624       tt-wth-doc.fact-sum  when v-view-fact
     4625       tt-wth-doc.doc-sum
     4626       tt-wth-doc.operator
     4627       tt-wth-doc.deliver
     4628       tt-wth-doc.receiver
     4629       tt-wth-doc.sum-gds-rubl when lookup(tt-wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) = 0
     4630       tt-wth-doc.sum-gds-base when lookup(tt-wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) = 0
     4631       for-out-w-p-code
     4632       for-current-w-p-code  when  lookup(tt-wth-doc.ext-doc-type, 'dc':U) = 0
     4633                                   and
     4634                                   lookup(tt-wth-doc.ext-doc-type, 'ci,ce':U) = 0
     4635     WITH FRAME Dialog-Frame.
     4636     APPLY "VALUE-CHANGED":U TO tt-wth-doc.cli-type IN FRAME Dialog-Frame.
     4637     APPLY "VALUE-CHANGED":U TO tt-wth-doc.obj-type IN FRAME Dialog-Frame.
     4638     IF lookup(tt-wth-doc.ext-doc-type, 'dc':U) = 0
     4639     and lookup(tt-wth-doc.ext-doc-type, 'ci,ce':U) = 0
     4640     then do:
     4641     APPLY "LEAVE":U TO for-current-w-p-code IN FRAME Dialog-Frame.
     4642     END.
     4643     APPLY "LEAVE":U TO for-out-w-p-code IN FRAME Dialog-Frame.
     4644     if lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz,xc") > 0
     4645     OR lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz") > 0 then
     4646     run proc-init-attr no-error.
     4647     IF par-mode = 'ДОБАВЛЕНИЕ':U OR
     4648           par-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     4649         IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     4650           ENABLE
     4651           tt-wth-doc.doc-date
     4652           b-quit
     4653           WITH FRAME Dialog-Frame.
     4654         END.
     4655         ELSE DO:
     4656           IF tt-wth-doc.status_ = 'накл':U      THEN DO:
     4657              ENABLE
     4658               tt-wth-doc.doc-date
     4659               b-cli when (NOT tt-wth-doc.inter_ AND Not locked-cli)
     4660                     WITH FRAME Dialog-Frame.
     4661               HIDE
     4662               b-quit
     4663               tt-wth-doc.fact-date IN FRAME Dialog-Frame
     4664               .
     4665           END.
     4666           ELSE IF tt-wth-doc.status_ = 'разрешен':U THEN DO:
     4667             ENABLE
     4668             tt-wth-doc.fact-sum  when v-view-fact
     4669             b-chg when NOT tt-wth-doc.auto-fill
     4670             WITH FRAME Dialog-Frame.
     4671             assign
     4672             locked-out = yes
     4673             locked-current = yes
     4674             .
     4675           END.
     4676         END.
     4677         ENABLE
     4678         b-add  when NOT tt-wth-doc.auto-fill AND not (lookup(tt-wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and not tt-wth-doc.exter_)
     4679         b-del  when not tt-wth-doc.auto-fill AND not (lookup(tt-wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and not tt-wth-doc.exter_)
     4680         b-bar  when NOT tt-wth-doc.auto-fill AND not (lookup(tt-wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and not tt-wth-doc.exter_) and lookup(tt-wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) = 0 and  tt-wth-doc.ext-doc-type <> 'xc':U
     4681         b-barRange  when NOT tt-wth-doc.auto-fill AND not (lookup(tt-wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and not tt-wth-doc.exter_) and lookup(tt-wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) = 0 and  tt-wth-doc.ext-doc-type <> 'xc':U
     4682         tt-wth-doc.cli-type when not locked-cli
     4683         tt-wth-doc.cli-code when not locked-cli
     4684         b-cli when not locked-cli
     4685         tt-wth-doc.operator
     4686         tt-wth-doc.deliver
     4687         tt-wth-doc.receiver   when not lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz,xc") > 0
     4688         b-operator
     4689         B-deliver
     4690         B-receiver
     4691         B-exit
     4692         b-quit
     4693         b-lookup
     4694         b-bind when NOT (tt-wth-doc.auto-fill)
     4695         b-allZone when (parext-type = 'ee':U  or  parext-type = 'ep':U or parext-type = 'pz':U or parext-type = 'dp':U or parext-type = 'df':U ) and not tt-wth-doc.auto-fill
     4696               B-shcfact when tt-wth-doc.doc-type = 'рас':U and tt-wth-doc.exter_
     4697         WITH FRAME Dialog-Frame.
     4698         if lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz,xc") > 0 then
     4699           enable f-atrReceiver f-atrproxy
     4700           WITH FRAME Dialog-Frame.
     4701           f-atrReceiver:move-to-top().
     4702         if lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz") > 0 then  do:
     4703           ENABLE  f-atrDSF f-atrNSF f-atrPaydoc
     4704                    b-shcfact
     4705           WITH FRAME Dialog-Frame.
     4706         end.
     4707         HIDE
     4708         b-prev IN FRAME Dialog-Frame
     4709         B-Next IN FRAME Dialog-Frame
     4710         .
     4711             enable tt-wth-doc.fact-date
     4712             with frame Dialog-Frame.
     4713   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4714   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4715     (input  tt-wth-doc.obj-type
     4716     ,input  tt-wth-doc.obj-code
     4717     ,input  'shift-on=request'
     4718     ,output glog
     4719     ) no-error .
     4720             if error-status :error then do:
     4721               message
     4722                 vss-workfile vss-revision vss-description skip
     4723                 "Ошибка при запуске процедуры objat" skip
     4724                 error-status :get-message(1) skip
     4725                 return-value skip
     4726                 view-as alert-box error .
     4727               return error.
     4728             end.
     4729             if glog then do:
     4730               display tt-wth-doc.shift-date tt-wth-doc.shift-num tt-wth-doc.shift-name r-sht with frame Dialog-Frame.
     4731               if tt-wth-doc.auto-fill = no then
     4732               enable tt-wth-doc.shift-date tt-wth-doc.shift-num tt-wth-doc.shift-name
     4733                      r-sht
     4734               with frame Dialog-Frame.
     4735             end.
     4736       END.
     4737       ELSE IF par-mode = 'ПРОСМОТР':U  THEN DO:
     4738         assign
     4739         b-quit:label = "&Выход"
     4740         b-quit:col = 1
     4741         .
     4742         ENABLE
     4743         B-Prev
     4744         B-Next
     4745         b-quit
     4746         WITH FRAME Dialog-Frame.
     4747         HIDE
     4748         b-exit
     4749         b-current   IN FRAME Dialog-Frame
     4750         B-out   IN FRAME Dialog-Frame
     4751         B-cli   IN FRAME Dialog-Frame
     4752         B-operator IN FRAME Dialog-Frame
     4753         B-Deliver  IN FRAME Dialog-Frame
     4754         B-Receiver IN FRAME Dialog-Frame
     4755         .
     4756         assign
     4757         locked-out = yes
     4758         locked-current = yes
     4759         .
     4760         if lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz,xc") > 0 then
     4761           view f-atrReceiver f-atrproxy
     4762           in FRAME Dialog-Frame.
     4763           f-atrReceiver:move-to-top().
     4764         if lookup(tt-wth-doc.ext-doc-type, "ie,ee,pz") > 0 then  do:
     4765           view  f-atrDSF f-atrNSF f-atrPaydoc
     4766           in FRAME Dialog-Frame.
     4767         end.
     4768       END.
     4769       ENABLE
     4770       b-help
     4771       br-lines
     4772       b-lookup
     4773       b-hist when par-mode <> 'ДОБАВЛЕНИЕ':U
     4774       b-chk when tt-wth-doc.auto-fill  and  (lookup(tt-wth-doc.ext-doc-type,'ii,fj,jj,pj,oj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,xc':U) >  0
     4775                                              or
     4776                                              lookup(tt-wth-doc.ext-doc-type, 'ej,ee,ij,iy,de':U) >  0
     4777                                              )
     4778       WITH FRAME Dialog-Frame.
     4779       if lookup(tt-wth-doc.ext-doc-type,'ij,ei,rj,ej,we,ci,ce,iy,de':u) > 0 then do:
     4780         buf_wth-line.sum-gds-base:visible in browse br-lines = no.
     4781         buf_wth-line.sum-gds-rubl:visible in browse br-lines = no.
     4782       end.
     4783       else do:
     4784          view
     4785         tt-wth-doc.sum-gds-base
     4786         tt-wth-doc.sum-gds-rubl
     4787         in frame  Dialog-Frame.
     4788       end.
     4789       if  v-view-fact  = yes then
     4790       view
     4791       tt-wth-doc.fact-sum
     4792       in frame Dialog-Frame.
     4793       if lookup(tt-wth-doc.ext-doc-type, 'de':U) > 0 then do:
     4794         HIDE
     4795         tt-wth-doc.fact-sum
     4796         IN FRAME Dialog-Frame.
     4797         assign
     4798         buf_wth-line.fact-sum:visible in browse br-lines = no.
     4799       end.
     4800       if lookup(tt-wth-doc.ext-doc-type , 'dc':U) > 0
     4801       or lookup(tt-wth-doc.ext-doc-type , 'ci,ce':U) > 0
     4802       then do:
     4803         hide
     4804         for-current-w-p-code
     4805         for-current-w-p-name
     4806         b-current
     4807         IN FRAME Dialog-Frame.
     4808       end.
     4809       OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK.
     4810       APPLY "ENTRY":U TO br-lines IN FRAME Dialog-Frame.
     4811      run control-line in this-procedure ( output lock-doc).
     4812      run lock-proc in this-procedure ( input lock-doc).
     4813      parext-type-name = ENTRY(LOOKUP(tt-wth-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u) no-error.
     4814      ASSIGN
     4815       FRAME Dialog-Frame :TITLE = substitute("Документ № &1 движения материальных ценностей - &2"
     4816                                               ,tt-wth-doc.doc-code
     4817                                                , CAPS(parext-type-name) ).
     4818     VIEW FRAME Dialog-Frame .
     4819   END PROCEDURE.
     4820   PROCEDURE proc-allZone :
     4821   define input parameter v_rid-list as char no-undo.
     4822   define input parameter p-zone as character no-undo.
     4823   define variable v-ii    as integer      no-undo.
     4824   define variable v-is-parts  as logical      no-undo.
     4825   define variable parline-rec as recid no-undo.
     4826   define variable v-count    as integer      no-undo.
     4827   empty temp-table tt-wth-line.
     4828   v-count = 0.
     4829   do transaction on error undo, return error return-value
     4830                  on quit undo, return
     4831                  on stop undo, return :
     4832     do v-ii = 1 to num-entries(v_rid-list, chr(44))
     4833     on error undo, next:
     4834       v-is-parts = no.
     4835       empty temp-table tt-wth-parts.
     4836       empty temp-table tt-par-dtl.
     4837       find first buf_wth no-lock where recid(buf_wth) = int(entry(v-ii,v_rid-list,chr(44))) .
     4838       if can-find(first buf_wth-line where buf_wth-line.wth-code = buf_wth.wth-code
     4839                                        and buf_wth-line.doc-code = tt-wth-doc.doc-code
     4840                  )
     4841       then do:
     4842         message substitute('Для МЦ &1 (код &2) уже есть линия в документе.',buf_wth.wth-name,buf_wth.wth-code) view-as alert-box.
     4843         next.
     4844       end.
     4845       run waitfram-show in this-procedure ( input substitute("Создание линии для МЦ &1",buf_wth.wth-name) ).
     4846          for each buf_wth-parts share-lock where
     4847                buf_wth-parts.out-code = p-zone
     4848            and buf_wth-parts.obj-code = tt-wth-doc.obj-code
     4849            and buf_wth-parts.obj-type = tt-wth-doc.obj-type
     4850            and  buf_wth-parts.wth-code = buf_wth.wth-code
     4851            and (if p-zone = 'cli-zone':U then (buf_wth-parts.cli-code = tt-wth-doc.cli-code
     4852                                          and buf_wth-parts.cli-type = tt-wth-doc.cli-type)
     4853                 else buf_wth-parts.w-p-code = FOR-CURRENT-W-P-CODE
     4854                 )
     4855           use-index  out-code
     4856            :
     4857            v-is-parts = yes.
     4858            create tt-wth-parts.
     4859            buffer-copy buf_wth-parts to tt-wth-parts
     4860            assign tt-wth-parts.out-code = tt-wth-doc.doc-code
     4861                   tt-wth-parts.ext-doc-type = tt-wth-doc.ext-doc-type
     4862                   tt-wth-parts.shift-date = tt-wth-doc.shift-date
     4863                   tt-wth-parts.shift-num = tt-wth-doc.shift-num
     4864                   tt-wth-parts.obj-type = tt-wth-doc.obj-type
     4865                   tt-wth-parts.obj-code = tt-wth-doc.obj-code
     4866                   tt-wth-parts.w-p-code = FOR-CURRENT-W-P-CODE
     4867            .
     4868       end.
     4869       if v-is-parts = no
     4870       then next.
     4871       run trg/wthrspt.p (input table tt-wth-parts
     4872                         ,input no ) no-error.
     4873       if error-status:error then do:
     4874         message return-value + error-status:get-message(1) view-as alert-box error.
     4875         undo, next.
     4876       end.
     4877       for each buf_wth-par no-lock where
     4878                buf_wth-par.wth-code = buf_wth.wth-code
     4879           :
     4880           create tt-par-dtl.
     4881           buffer-copy buf_wth-par using wth-code
     4882                                         par-code
     4883                                         par-rate
     4884                                         par-val
     4885                    to tt-par-dtl.
     4886           assign
     4887                  tt-par-dtl.w-p-code = FOR-CURRENT-W-P-CODE
     4888                  tt-par-dtl.doc-code = tt-wth-doc.doc-code
     4889           .
     4890   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4891   assign
     4892   tt-par-dtl.q-ty-doc  = 0
     4893   tt-par-dtl.q-ty-fact = 0
     4894   tt-par-dtl.doc-sum   = 0
     4895   tt-par-dtl.fact-sum  = 0
     4896   tt-par-dtl.sum-gds-rubl = 0
     4897   tt-par-dtl.sum-gds-base = 0
     4898   .
     4899   for each buf_wth-parts no-lock where buf_wth-parts.w-p-code = tt-par-dtl.w-p-code
     4900                          and buf_wth-parts.wth-code = tt-par-dtl.wth-code
     4901                          and buf_wth-parts.par-code = tt-par-dtl.par-code
     4902                          and buf_wth-parts.out-code = tt-par-dtl.doc-code
     4903                          and buf_wth-parts.stts = 0 :
     4904      assign
     4905     tt-par-dtl.q-ty-doc     =  tt-par-dtl.q-ty-doc  + buf_wth-parts.qnty-doc
     4906     tt-par-dtl.q-ty-fact    =  tt-par-dtl.q-ty-fact + buf_wth-parts.fact-qnty
     4907     tt-par-dtl.sum-gds-rubl =  tt-par-dtl.sum-gds-rubl + buf_wth-parts.price-rubl * buf_wth-parts.fact-qnty
     4908     tt-par-dtl.sum-gds-base =  tt-par-dtl.sum-gds-base + buf_wth-parts.price-base * buf_wth-parts.fact-qnty
     4909     no-error
     4910     .
     4911   end.
     4912   assign
     4913     tt-par-dtl.doc-sum     =  tt-par-dtl.q-ty-doc  * tt-par-dtl.par-rate
     4914     tt-par-dtl.fact-sum    =  tt-par-dtl.q-ty-fact * tt-par-dtl.par-rate
     4915     no-error
     4916     .
     4917       end.
     4918       parline-rec = ?.
     4919       create tt-wth-line.
     4920       assign tt-wth-line.wth-code = buf_wth.wth-code
     4921              tt-wth-line.doc-code = tt-wth-doc.doc-code
     4922              tt-wth-line.w-p-code =   FOR-CURRENT-W-P-CODE
     4923       .
     4924   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4925   assign
     4926   tt-wth-line.doc-sum   = 0
     4927   tt-wth-line.fact-sum  = 0
     4928   tt-wth-line.sum-gds-rubl = 0
     4929   tt-wth-line.sum-gds-base = 0
     4930   tt-wth-line.price-rubl   = 0
     4931   tt-wth-line.price-base   = 0.
     4932   for each tt-par-dtl no-lock where tt-par-dtl.w-p-code = tt-wth-line.w-p-code
     4933                          and tt-par-dtl.wth-code = tt-wth-line.wth-code
     4934                          and tt-par-dtl.doc-code = tt-wth-line.doc-code
     4935                          :
     4936     assign
     4937     tt-wth-line.doc-sum      =  tt-wth-line.doc-sum  + tt-par-dtl.doc-sum
     4938     tt-wth-line.fact-sum     =  tt-wth-line.fact-sum + tt-par-dtl.fact-sum
     4939     tt-wth-line.sum-gds-rubl =  tt-wth-line.sum-gds-rubl + tt-par-dtl.sum-gds-rubl
     4940     tt-wth-line.sum-gds-base =  tt-wth-line.sum-gds-base + tt-par-dtl.sum-gds-base
     4941     .
     4942   end.
     4943   assign
     4944     tt-wth-line.price-rubl  =  tt-wth-line.sum-gds-rubl / tt-wth-line.fact-sum
     4945     tt-wth-line.price-base  =  tt-wth-line.sum-gds-base / tt-wth-line.fact-sum
     4946     .
     4947       run str/wth-lnc1.p (
     4948                         input-output parline-rec
     4949                         ,'ДОБАВЛЕНИЕ':U
     4950                         ,input no
     4951                         ,input tt-wth-doc.doc-code
     4952                         ,input tt-wth-line.wth-code
     4953                         ,input FOR-CURRENT-W-P-CODE
     4954                         ,input FOR-OUT-W-P-CODE
     4955                         ,input tt-wth-line.doc-sum
     4956                         ,input tt-wth-line.fact-sum
     4957                         ,input table tt-par-dtl
     4958                         ,input no
     4959                         ,input tt-wth-doc.ext-doc-type
     4960                         ,input tt-wth-line.sum-gds-rubl
     4961                         ,input tt-wth-line.sum-gds-base
     4962                         ) no-error.
     4963       IF ERROR-STATUS:ERROR THEN DO:
     4964         message return-value + error-status:get-message(1) view-as alert-box.
     4965         undo, next.
     4966       end.
     4967       v-count = v-count + 1.
     4968     end.
     4969     assign
     4970     tt-wth-doc.doc-sum = bf_wth-doc.doc-sum
     4971     tt-wth-doc.fact-sum = bf_wth-doc.fact-sum
     4972     tt-wth-doc.sum-gds-rubl = bf_wth-doc.sum-gds-rubl
     4973     tt-wth-doc.sum-gds-base = bf_wth-doc.sum-gds-base
     4974     .
     4975     DISPLAY
     4976     tt-wth-doc.doc-sum
     4977     tt-wth-doc.sum-gds-rubl
     4978     tt-wth-doc.sum-gds-base
     4979     tt-wth-doc.fact-sum when lookup(tt-wth-doc.ext-doc-type, 'de':U) = 0
     4980     with frame Dialog-Frame .
     4981     run control-line in this-procedure ( output lock-doc).
     4982     run lock-proc in this-procedure (input lock-doc).
     4983     OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK.
     4984     reposition br-lines to recid parline-rec no-error.
     4985     run waitfram-hide in this-procedure .
     4986     message substitute('Добавлено &1 линий.',v-count) view-as alert-box.
     4987     apply "entry" to br-lines.
     4988   end.
     4989   END PROCEDURE.
     4990   PROCEDURE proc-b-add :
     4991   DEFINE VARIABLE loc-ref-list as character no-undo .
     4992   DEFINE VARIABLE valid-chk-type-list as character no-undo .
     4993   DEFINE VARIABLE ii as integer no-undo .
     4994   DEFINE VARIABLE ii-ok as integer no-undo .
     4995   define variable v-line-rec as recid no-undo .
     4996   define variable v-doc-rec as recid no-undo .
     4997   define buffer what_chk-doc  for ub.chk-doc .
     4998   define buffer buf_chk-doc  for ub.chk-doc .
     4999   run proc-save-doc in this-procedure ( input no) No-ERROR.
     5000   if error-status:error
     5001   or return-value = 'error'
     5002   then return 'error'.
     5003   assign
     5004   v-doc-rec = recid(bf_wth-doc)
     5005   v-line-rec = ?
     5006   frame Dialog-Frame FOR-CURRENT-W-P-CODE
     5007   FOR-OUT-W-P-CODE
     5008   .
     5009   CASE tt-wth-doc.auto-fill:
     5010     when no then do:
     5011       run str/wth-inca.w ( input parparentproc
     5012                      ,INPUT parhost-code
     5013                      ,INPUT parobj-type
     5014                      ,INPUT parobj-code
     5015                      ,INPUT 'ДОБАВЛЕНИЕ':U
     5016                      ,input v-doc-rec
     5017                      ,input for-current-w-p-code
     5018                      ,input for-out-w-p-code
     5019                      ,INPUT tt-wth-doc.ext-doc-type
     5020                      ,input-output v-LINE-REC ) no-error.
     5021       if error-status:error then do:
     5022         message error-status:get-message(1) return-value view-as alert-box.
     5023         run control-line in this-procedure ( output lock-doc).
     5024         run lock-proc in this-procedure (input lock-doc).
     5025         return 'error'.
     5026       end.
     5027     end.
     5028     when yes then do:
     5029       FIND FIRST what_chk-doc No-LOCK WHERE
     5030                  what_chk-doc.out-code = tt-wth-doc.doc-code No-ERROR.
     5031       if available what_chk-doc then do:
     5032         assign
     5033         valid-chk-type-list = string(what_chk-doc.chk-type).
     5034         run str/chk-docs.w (
     5035                        input parparentproc
     5036                       ,input 'b-sel,b-mark':U
     5037                       ,input 'free':U
     5038                       ,input ?
     5039                       ,input parobj-type
     5040                       ,input parobj-code
     5041                       ,input what_chk-doc.chk-type
     5042                       ,input '':U
     5043                       ,input 0
     5044                       ,input ?
     5045                       ,input ?
     5046                       ,input 0
     5047                       ,output loc-ref-list) no-error.
     5048         if error-status:error then return 'error'.
     5049       end.
     5050       else do:
     5051           IF lookup(tt-wth-doc.ext-doc-type, 'ee,ei,ej,jj,oj,ce,ef,ep':U) > 0 then do:
     5052             valid-chk-type-list = '5':U + chr(44) + '2':U.
     5053           end.
     5054           IF lookup(tt-wth-doc.ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 then do:
     5055             valid-chk-type-list = '3':U.
     5056           end.
     5057               run str/chk-docs.w (
     5058                        input parparentproc
     5059                       ,input 'b-sel,b-mark':U
     5060                       ,input 'free':U
     5061                       ,input ?
     5062                       ,input parobj-type
     5063                       ,input parobj-code
     5064                       ,input 0
     5065                       ,input '':U
     5066                       ,input 0
     5067                       ,input ?
     5068                       ,input ?
     5069                       ,input 0
     5070                       ,output loc-ref-list) no-error.
     5071         if error-status:error then return 'error'.
     5072       end.
     5073       if loc-ref-list = "":U then return.
     5074     _ii:
     5075     DO ii = 1 to num-entries(loc-ref-list):
     5076     find first buf_chk-doc exclusive-lock where
     5077                     recid(buf_chk-doc) = integer(entry(ii, loc-ref-list)) No-ERROR.
     5078         if not avail buf_chk-doc or
     5079           LOOKUP(string(buf_chk-doc.chk-type), valid-chk-type-list) = 0 then NEXT _ii.
     5080         if tt-wth-doc.shift-date = ? then do:
     5081           if buf_chk-doc.shift-date <> tt-wth-doc.doc-date then NEXT _ii.
     5082         end.
     5083         else do:
     5084           if NOT (buf_chk-doc.shift-date = tt-wth-doc.shift-date AND
     5085                   buf_chk-doc.shift-num = tt-wth-doc.shift-num) then NEXT _ii.
     5086         end.
     5087         if avail(what_chk-doc) and buf_chk-doc.pay-desk <> what_chk-doc.pay-desk then NEXT _ii.
     5088         run str/inc-wth1.p (
     5089           buffer buf_chk-doc
     5090         ,input 1
     5091         ,input tt-wth-doc.doc-code
     5092         ,input for-current-w-p-code
     5093         ,input for-out-w-p-code
     5094         ,input tt-wth-doc.ext-doc-type
     5095         ,input buf_chk-doc.chk-type
     5096         ,input no
     5097         ) no-error .
     5098         if error-status:error then NEXT _ii.
     5099         ii-ok = ii-ok + 1.
     5100     END.
     5101     if ii - 1 <> ii-ok then do:
     5102       message
     5103       "Из выбранных Вами " (ii - 1 ) "чеков"
     5104       "удалось включить в документ" ii-ok
     5105       view-as alert-box WARNING.
     5106     end.
     5107     end.
     5108   END CASE.
     5109   RUN control-doc NO-ERROR.
     5110   OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK.
     5111   reposition br-lines to recid v-line-rec no-error.
     5112   apply "entry" to br-lines.
     5113   END PROCEDURE.
     5114   PROCEDURE proc-b-del :
     5115   DEFINE VARIABLE loc-ref-list as character no-undo .
     5116   DEFINE VARIABLE ii as integer no-undo.
     5117   DEFINE VARIABLE ii-ok as integer no-undo.
     5118   define variable v-line-rec as recid no-undo .
     5119   DEFINE buffer buf_chk-doc for ub.chk-doc .
     5120   if not avail buf_wth-line then return no-apply.
     5121     IF tt-wth-doc.status_ <> 'накл':U THEN DO:
     5122       MESSAGE "Документ закрыт - удалять матценности нельзя!"
     5123       VIEW-AS ALERT-BOX ERROR.
     5124       RETURN NO-APPLY.
     5125   END.
     5126   CASE tt-wth-doc.auto-fill:
     5127     when no then do:
     5128       MESSAGE
     5129       "Вы уверены, что хотите удалить строку?"
     5130       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     5131       IF glog <> YES THEN DO:
     5132         RETURN NO-APPLY.
     5133       END.
     5134       ASSIGN v-line-rec = RECID( buf_wth-line).
     5135       Erase-Block:
     5136       DO ON ERROR UNDO Erase-Block, LEAVE Erase-Block
     5137          ON STOP  UNDO Erase-Block, LEAVE Erase-Block :
     5138         run str/wth-lnc1.p (
     5139                          input-output v-line-rec
     5140                         ,input  'удаление':U
     5141                         ,no
     5142                         ,input buf_wth-line.doc-code
     5143                         ,input buf_wth-line.wth-code
     5144                         ,input buf_wth-line.w-p-code
     5145                         ,input buf_wth-line.out-code
     5146                         ,input 0
     5147                         ,input 0
     5148                         ,input table tt-par-dtl
     5149                         ,input yes
     5150                         ,input tt-wth-doc.ext-doc-type
     5151                         ,input buf_wth-line.sum-gds-rubl
     5152                         ,input buf_wth-line.sum-gds-base
     5153                         ) .
     5154       END.
     5155     end.
     5156     when yes then do:
     5157       run str/chk-docs.w (
     5158                      input parparentproc
     5159                     ,input 'b-sel,b-mark':U
     5160                     ,input 'out-code':U
     5161                     ,input ?
     5162                     ,input parobj-type
     5163                     ,input parobj-code
     5164                     ,input tt-wth-doc.doc-code
     5165                     ,input ''
     5166                     ,input 0
     5167                     ,input ?
     5168                     ,input ?
     5169                     ,input 0
     5170                     ,output loc-ref-list) no-error.
     5171       if error-status:error then return error.
     5172       if loc-ref-list = '':U then return.
     5173        _ii:
     5174     DO ii = 1 to num-entries(loc-ref-list):
     5175     find first buf_chk-doc exclusive-lock where
     5176                     recid(buf_chk-doc) = integer(entry(ii, loc-ref-list)) No-ERROR.
     5177         if not avail buf_chk-doc or
     5178           buf_chk-doc.out-code <> tt-wth-doc.doc-code then NEXT _ii.
     5179         run str/inc-wth1.p (
     5180           buffer buf_chk-doc
     5181         ,input - 1
     5182         ,input tt-wth-doc.doc-code
     5183         ,input 0
     5184         ,input for-out-w-p-code
     5185         ,input tt-wth-doc.ext-doc-type
     5186         ,input buf_chk-doc.chk-type
     5187         ,input no
     5188         ) no-error .
     5189         if error-status:error then NEXT _ii.
     5190         ii-ok = ii-ok + 1.
     5191     END.
     5192     if ii - 1 <> ii-ok then do:
     5193       message
     5194       "Из выбранных Вами " (ii - 1)  "чеков"
     5195       "удалось удалить из документа" ii-ok
     5196       view-as alert-box WARNING.
     5197     end.
     5198     end.
     5199   END CASE.
     5200   RUN control-doc NO-ERROR.
     5201   OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK.
     5202   END PROCEDURE.
     5203   PROCEDURE proc-init-attr :
     5204     define variable v-atrValue    as character no-undo .
     5205     define variable v-atrType     as character no-undo .
     5206   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input tt-wth-doc.doc-code ,
     5207                           input 'wthdsf':U ,
     5208                          output v-atrValue ,
     5209                          output v-atrType ) NO-ERROR .
     5210   f-atrDSF = date(v-atrValue) NO-ERROR.
     5211   v-atrValue = ''.
     5212   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input tt-wth-doc.doc-code ,
     5213                           input 'wthnsf':U ,
     5214                          output v-atrValue ,
     5215                          output v-atrType ) NO-ERROR .
     5216   f-atrNSF = v-atrValue.
     5217   v-atrValue = ''.
     5218   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input tt-wth-doc.doc-code ,
     5219                           input 'wthpaydoc':U ,
     5220                          output v-atrValue ,
     5221                          output v-atrType ) NO-ERROR .
     5222   f-atrPaydoc = v-atrValue.
     5223   v-atrValue = ''.
     5224   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input tt-wth-doc.doc-code ,
     5225                           input 'wthproxy':U ,
     5226                          output v-atrValue ,
     5227                          output v-atrType ) NO-ERROR .
     5228   f-atrproxy = v-atrValue.
     5229   v-atrValue = ''.
     5230   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input tt-wth-doc.doc-code ,
     5231                           input 'wthreceiver':U ,
     5232                          output v-atrValue ,
     5233                          output v-atrType ) NO-ERROR .
     5234   f-atrReceiver = v-atrValue.
     5235   DISP f-atrDSF f-atrNSF f-atrPaydoc f-atrReceiver f-atrproxy  f-atrdsf WITH FRAME Dialog-Frame.
     5236   END PROCEDURE.
     5237   PROCEDURE proc-inter__ :
     5238   define input parameter loc-inter like ub.wth-doc.inter_ no-undo.
     5239   CASE loc-inter :
     5240       when yes then do:
     5241           assign
     5242           tt-wth-doc.cli-type = tt-wth-doc.obj-type
     5243           tt-wth-doc.cli-code = tt-wth-doc.obj-code
     5244           .
     5245           display
     5246           tt-wth-doc.cli-type
     5247           tt-wth-doc.cli-code
     5248           with frame Dialog-Frame.
     5249           disable
     5250           tt-wth-doc.cli-type
     5251           tt-wth-doc.cli-code
     5252           b-cli
     5253           with frame Dialog-Frame.
     5254           assign
     5255           for-out-w-p-code = 0
     5256           .
     5257           enable
     5258           b-out
     5259           for-out-w-p-code
     5260           with frame Dialog-Frame.
     5261           display
     5262           '':U @ for-out-w-p-name
     5263           with frame Dialog-Frame.
     5264           APPLY "VALUE-CHANGED" to tt-wth-doc.cli-type.
     5265                   if available out-place then
     5266                   display
     5267                   out-place.w-p-code @ for-out-w-p-code
     5268                   out-place.w-p-name @ for-out-w-p-name
     5269                   with frame Dialog-Frame.
     5270       end.
     5271       when no then do:
     5272         release out-place.
     5273         if not locked-cli  then do:
     5274           assign
     5275           tt-wth-doc.cli-type = 'орг':U
     5276           tt-wth-doc.cli-code = 0
     5277           .
     5278           display
     5279           tt-wth-doc.cli-type
     5280           tt-wth-doc.cli-code
     5281           '':U @ tt-wth-doc.cli-name
     5282           with frame Dialog-Frame.
     5283         end.
     5284         ENABLE
     5285         tt-wth-doc.cli-type when (lock-doc = no and locked-cli = no)
     5286         tt-wth-doc.cli-code when (lock-doc = no and locked-cli = no)
     5287         b-cli when (lock-doc = no and locked-cli = no)
     5288         with frame Dialog-Frame.
     5289         assign
     5290         for-out-w-p-code = 0
     5291         for-out-w-p-name = '':U
     5292         .
     5293         hide
     5294         for-out-w-p-code
     5295         b-out
     5296         for-out-w-p-name
     5297         in frame Dialog-Frame.
     5298       end.
     5299   end CASE.
     5300   END PROCEDURE.
     5301   PROCEDURE proc-save-doc :
     5302    define input parameter parlines-exist as logical no-undo .
     5303    define variable v-doc-rec as recid no-undo .
     5304    define variable varcli-name as character no-undo .
     5305    IF par-mode = 'ПРОСМОТР':U THEN DO:
     5306       RETURN NO-APPLY.
     5307    END.
     5308    if tt-wth-doc.ext-doc-type <> 'dc':U and not avail current-place then do:
     5309     message "Не определено место хранения МЦ"
     5310     view-as alert-box error.
     5311     APPLY "ENTRY":U TO for-current-w-p-code IN FRAME Dialog-Frame.
     5312     return error.
     5313    end.
     5314    assign
     5315    frame Dialog-Frame
     5316    tt-wth-doc.doc-date
     5317    tt-wth-doc.cli-type
     5318    tt-wth-doc.cli-code
     5319    tt-wth-doc.operator
     5320    tt-wth-doc.deliver
     5321    tt-wth-doc.receiver
     5322    tt-wth-doc.fact-date
     5323    tt-wth-doc.shift-date
     5324    tt-wth-doc.shift-num
     5325    tt-wth-doc.shift-name
     5326    tt-wth-doc.doc-sum when not tt-wth-doc.auto-fill
     5327    tt-wth-doc.fact-sum when not tt-wth-doc.auto-fill
     5328   .
     5329   if      tt-wth-doc.cli-type = tt-wth-doc.obj-type
     5330       and tt-wth-doc.cli-code = tt-wth-doc.obj-code
     5331       and for-current-w-p-code:screen-value > '':U
     5332       and for-current-w-p-code:screen-value = for-out-w-p-code:screen-value
     5333   then do:
     5334     message "Нельзя перемещать МЦ в место их хранения."
     5335     view-as alert-box error.
     5336     APPLY "ENTRY":U TO for-out-w-p-code IN FRAME Dialog-Frame.
     5337     return error.
     5338   end.
     5339   run trg/wth-inc2.p (
     5340                    input no
     5341                   ,input tt-wth-doc.doc-code
     5342                   ,input tt-wth-doc.host-code
     5343                   ,input tt-wth-doc.obj-type
     5344                   ,input tt-wth-doc.obj-code
     5345                   ,input tt-wth-doc.cli-type
     5346                   ,input tt-wth-doc.cli-code
     5347                   ,input tt-wth-doc.operator
     5348                   ,input tt-wth-doc.deliver
     5349                   ,input tt-wth-doc.receiver
     5350                   ,input tt-wth-doc.doc-type
     5351                   ,input tt-wth-doc.auto-fill
     5352                   ,input tt-wth-doc.exter_
     5353                   ,input tt-wth-doc.inter_
     5354                   ,input tt-wth-doc.source-ref
     5355                   ,input tt-wth-doc.source-type
     5356                   ,input tt-wth-doc.borned
     5357                   ,input parlines-exist
     5358                   ,input tt-wth-doc.ext-doc-type
     5359                   ,output varcli-name) no-error.
     5360   if error-status:error then do:
     5361   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5362   define variable fh as widget-handle no-undo .
     5363   define variable hh as widget-handle no-undo .
     5364   define variable rv as character no-undo .
     5365   assign
     5366   rv = entry(1, return-value , chr(4)).
     5367   if rv <> "":U then do:
     5368     assign
     5369     fh = frame Dialog-Frame:first-child
     5370     hh = fh:first-child
     5371     .
     5372     do while valid-handle(hh):
     5373       if hh:name = rv then do:
     5374         APPLY "ENTRY" to hh.
     5375         return 'error'.
     5376       end.
     5377       hh = hh:next-sibling.
     5378     end.
     5379   end.
     5380     return error.
     5381   end.
     5382    v-doc-rec = recid(bf_wth-doc).
     5383   run waitfram-show in this-procedure ( input "Сохранение шапки документа..." ).
     5384    run str/wth-inc1.p (
     5385                     input no
     5386                    ,input-output v-doc-rec
     5387                    ,input        'ИЗМЕНЕНИЕ':U
     5388                    ,input tt-wth-doc.doc-code
     5389                    ,input tt-wth-doc.host-code
     5390                    ,input tt-wth-doc.obj-type
     5391                    ,input tt-wth-doc.obj-code
     5392                    ,input tt-wth-doc.cli-type
     5393                    ,input tt-wth-doc.cli-code
     5394                    ,input tt-wth-doc.doc-date
     5395                    ,input tt-wth-doc.fact-date
     5396                    ,input tt-wth-doc.shift-date
     5397                    ,input tt-wth-doc.shift-num
     5398                    ,input tt-wth-doc.shift-name
     5399                    ,input tt-wth-doc.operator
     5400                    ,input tt-wth-doc.deliver
     5401                    ,input tt-wth-doc.receiver
     5402                    ,input tt-wth-doc.doc-type
     5403                    ,input tt-wth-doc.auto-fill
     5404                    ,input tt-wth-doc.exter_
     5405                    ,input tt-wth-doc.inter_
     5406                    ,input tt-wth-doc.source-ref
     5407                    ,input tt-wth-doc.source-type
     5408                    ,input tt-wth-doc.borned
     5409                    ,input tt-wth-doc.doc-sum
     5410                    ,input tt-wth-doc.fact-sum
     5411                    ,input tt-wth-doc.PS
     5412                    ,input tt-wth-doc.status_
     5413                    ,input parlines-exist
     5414                    ,input tt-wth-doc.ext-doc-type
     5415                    ) no-error .
     5416     IF ERROR-STATUS:ERROR THEN DO:
     5417       return 'error'.
     5418     END.
     5419     if f-atrNSF <> f-atrNsf:screen-value
     5420     then do:
     5421     run proc-wrt-attr ( tt-wth-doc.doc-code
     5422                        , 'wthnsf':U
     5423                        , f-atrNsf:screen-value
     5424                        ) no-error.
     5425     end.
     5426     if   f-atrDSF <> date(f-atrDSF:screen-value)
     5427     then do:
     5428     run proc-wrt-attr ( tt-wth-doc.doc-code
     5429                        , 'wthdsf':U
     5430                        , f-atrDsf:screen-value
     5431                        ) no-error.
     5432     end.
     5433     if f-atrPaydoc <> f-atrPaydoc:screen-value
     5434     then do:
     5435     run proc-wrt-attr ( tt-wth-doc.doc-code
     5436                        , 'wthpaydoc':U
     5437                        , f-atrPaydoc:screen-value
     5438                        ) no-error.
     5439     end.
     5440       if f-atrproxy <> f-atrproxy:screen-value
     5441     then do:
     5442     run proc-wrt-attr ( tt-wth-doc.doc-code
     5443                        , 'wthproxy':U
     5444                        , f-atrproxy:screen-value
     5445                        ) no-error.
     5446     end.
     5447       if f-atrReceiver <> f-atrReceiver:screen-value
     5448     then do:
     5449     run proc-wrt-attr ( tt-wth-doc.doc-code
     5450                        , 'wthreceiver':U
     5451                        , f-atrReceiver:screen-value
     5452                        ) no-error.
     5453     end.
     5454     ASSIGN FRAME Dialog-Frame f-atrDSF f-atrNSF f-atrPaydoc.
     5455     if for-current-w-p-code <> int(for-current-w-p-code:screen-value) and par-mode = 'ИЗМЕНЕНИЕ':U
     5456         and tt-wth-doc.doc-type = 'при':U and not tt-wth-doc.exter_ then do:
     5457       for each buf_wth-line exclusive-lock where
     5458         buf_wth-line.doc-code = tt-wth-doc.doc-code:
     5459         buf_wth-line.w-p-code =  int(for-current-w-p-code:screen-value) .
     5460       end.
     5461       for each buf_wth-dtl exclusive-lock where buf_wth-dtl.doc-code = tt-wth-doc.doc-code :
     5462         buf_wth-dtl.w-p-code =    int(for-current-w-p-code:screen-value).
     5463       end.
     5464       for each buf_wth-parts exclusive-lock where
     5465                buf_wth-parts.out-code =  tt-wth-doc.doc-code:
     5466           buf_wth-parts.w-p-code = int(for-current-w-p-code:screen-value).
     5467       end.
     5468       run fill-tables.
     5469     end.
     5470     ASSIGN
     5471     FOR-CURRENT-W-P-CODE
     5472     FOR-OUT-W-P-CODE
     5473     .
     5474   run waitfram-hide in this-procedure .
     5475   END PROCEDURE.
     5476   PROCEDURE proc-shift-name :
     5477     define buffer bf_shift-obj   for ub.shift-obj.
     5478     define variable varfind-shift as integer initial 0.
     5479     define variable varshift-date like ub.shift-obj.shift-date no-undo.
     5480     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
     5481     if input frame Dialog-Frame tt-wth-doc.shift-name <> tt-wth-doc.shift-name then do:
     5482       if input frame Dialog-Frame tt-wth-doc.shift-date <> ? then do:
     5483         for each  bf_shift-obj where bf_shift-obj.obj-type   = tt-wth-doc.obj-type                             and
     5484                                      bf_shift-obj.obj-code   = tt-wth-doc.obj-code                             and
     5485                                      bf_shift-obj.shift-date = input frame Dialog-Frame tt-wth-doc.shift-date and
     5486                                      bf_shift-obj.shift-name = input frame Dialog-Frame tt-wth-doc.shift-name no-lock on error undo, return error return-value :
     5487           assign
     5488             varfind-shift = varfind-shift + 1
     5489             varshift-date = bf_shift-obj.shift-date
     5490             varshift-num  = bf_shift-obj.shift-num.
     5491         end.
     5492         if varfind-shift = 0 or varfind-shift > 1 then do:
     5493           if varfind-shift = 0 then do:
     5494             message "Не найдена смена: " tt-wth-doc.obj-type " " tt-wth-doc.obj-code
     5495                     " Дата " input frame Dialog-Frame tt-wth-doc.shift-date " Номер смены " input frame Dialog-Frame tt-wth-doc.shift-name " ."
     5496             view-as alert-box error.
     5497           end.
     5498           else do:
     5499             message "Найдено более одной смены с одним номером в сменном дне. Объект: " tt-wth-doc.obj-type " " tt-wth-doc.obj-code
     5500                     " Дата " input frame Dialog-Frame tt-wth-doc.shift-date " Номер смены " input frame Dialog-Frame tt-wth-doc.shift-name " ."
     5501             view-as alert-box error.
     5502           end.
     5503           display tt-wth-doc.shift-name with frame Dialog-Frame.
     5504           run proc-sht no-error.
     5505           if error-status:error then do: return error. end.
     5506         end.
     5507         else do:
     5508           assign frame Dialog-Frame
     5509             tt-wth-doc.shift-name.
     5510           assign
     5511             tt-wth-doc.shift-date = varshift-date
     5512             tt-wth-doc.shift-num  = varshift-num.
     5513           display tt-wth-doc.shift-date tt-wth-doc.shift-num tt-wth-doc.shift-name with frame Dialog-Frame.
     5514           if tt-wth-doc.fact-date = ? then do: assign tt-wth-doc.fact-date = tt-wth-doc.shift-date tt-wth-doc.fact-time = (24 * 60 * 60). display tt-wth-doc.fact-date with frame Dialog-Frame. end.
     5515         end.
     5516       end.
     5517     end.
     5518   END PROCEDURE.
     5519   PROCEDURE proc-shift-num :
     5520   define buffer bf_shift-obj   for ub.shift-obj.
     5521     if input frame Dialog-Frame tt-wth-doc.shift-num <> tt-wth-doc.shift-num then do:
     5522       if input frame Dialog-Frame tt-wth-doc.shift-date <> ? then do:
     5523         find first bf_shift-obj where bf_shift-obj.obj-type   = tt-wth-doc.obj-type                             and
     5524                                       bf_shift-obj.obj-code   = tt-wth-doc.obj-code                             and
     5525                                       bf_shift-obj.shift-date = input frame Dialog-Frame tt-wth-doc.shift-date and
     5526                                       bf_shift-obj.shift-num  = input frame Dialog-Frame tt-wth-doc.shift-num  no-lock no-error.
     5527         if not available bf_shift-obj then do:
     5528           message "Не найдена смена: " tt-wth-doc.obj-type " " tt-wth-doc.obj-code
     5529                   " Дата " input frame Dialog-Frame tt-wth-doc.shift-date " Порядок смены " input frame Dialog-Frame tt-wth-doc.shift-num " ."
     5530           view-as alert-box error.
     5531           display tt-wth-doc.shift-num with frame Dialog-Frame.
     5532           run proc-sht no-error.
     5533           if error-status:error then do:
     5534             return error.
     5535           end.
     5536         end.
     5537         else do:
     5538           assign
     5539             tt-wth-doc.shift-date = bf_shift-obj.shift-date
     5540             tt-wth-doc.shift-num  = bf_shift-obj.shift-num
     5541             tt-wth-doc.shift-name = bf_shift-obj.shift-name.
     5542           display tt-wth-doc.shift-date tt-wth-doc.shift-num tt-wth-doc.shift-name with frame Dialog-Frame.
     5543           if tt-wth-doc.fact-date = ? then do:
     5544             assign
     5545               tt-wth-doc.fact-date = tt-wth-doc.shift-date
     5546               tt-wth-doc.fact-time = (24 * 60 * 60).
     5547             display tt-wth-doc.fact-date with frame Dialog-Frame.
     5548           end.
     5549         end.
     5550       end.
     5551     end.
     5552   END PROCEDURE.
     5553   PROCEDURE proc-sht :
     5554     define buffer   bf_shift-obj   for ub.shift-obj.
     5555     define variable varrid-list as character no-undo.
     5556     define variable varrecid    as recid     no-undo.
     5557     assign
     5558       varrid-list = "".
     5559     run str/sht-all.w (parparentproc, v-cntxt-obj-type, v-cntxt-obj-code, 'b-sel', 'obj', tt-wth-doc.obj-type, tt-wth-doc.obj-code ,'':u, input-output varrid-list) no-error .
     5560     if error-status:error or varrid-list = "":u then do:
     5561       return error.
     5562     end.
     5563     else do:
     5564       assign
     5565         varrecid = integer (entry(1, varrid-list)).
     5566       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
     5567       if available bf_shift-obj then do:
     5568         assign
     5569           tt-wth-doc.shift-date = bf_shift-obj.shift-date
     5570           tt-wth-doc.shift-num  = bf_shift-obj.shift-num
     5571           tt-wth-doc.shift-name = bf_shift-obj.shift-name.
     5572         display tt-wth-doc.shift-date tt-wth-doc.shift-num tt-wth-doc.shift-name with frame Dialog-Frame.
     5573           assign
     5574             tt-wth-doc.fact-date = tt-wth-doc.shift-date
     5575             tt-wth-doc.fact-time = (24 * 60 * 60).
     5576           display tt-wth-doc.fact-date with frame Dialog-Frame.
     5577       end.
     5578     end.
     5579   END PROCEDURE.
     5580   PROCEDURE proc-wrt-attr :
     5581   define  input parameter p-doc-code   like ub.wth-doc.doc-code    no-undo.
     5582   define  input parameter p-attr-code  like ub.wth-doc-attr.attr-code  no-undo.
     5583   define  input parameter p-attr-value like ub.wth-doc-attr.attr-value no-undo.
     5584   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-wrt in g#wthcalib ( input p-doc-code ,
     5585                          input p-attr-code ,
     5586                          input p-attr-value ) no-error .
     5587       if error-status :error then do:
     5588         message error-status :error error-status :get-message( 1 ) '"' + p-attr-code + '"'
     5589         view-as alert-box error.
     5590       end.
     5591   END PROCEDURE.
     5592   PROCEDURE reposition-wth-doc :
     5593   define input parameter p-direction as character no-undo .
     5594   define variable v-new-wth-doc-recid as recid no-undo .
     5595   do
     5596   on error undo, return error
     5597   :
     5598     if valid-handle(p-call-prog)
     5599     then do:
     5600       run reposition-wth-doc in p-call-prog
     5601         (input  p-direction
     5602         ,output v-new-wth-doc-recid
     5603         ).
     5604       if v-new-wth-doc-recid <> ?
     5605       then do:
     5606         define buffer buf_wth-doc for ub.wth-doc .
     5607         find first buf_wth-doc no-lock
     5608           where recid(buf_wth-doc) = v-new-wth-doc-recid
     5609           no-error .
     5610         assign
     5611         p-doc-rec = v-new-wth-doc-recid
     5612         p-next-prev = '':U
     5613         .
     5614       end.
     5615     end.
     5616     else do:
     5617       message "Список документов МЦ не определен." view-as alert-box INFORMATION .
     5618       return no-apply.
     5619     end.
     5620     END.
     5621   END PROCEDURE.
     5622   FUNCTION get-place-name RETURNS CHARACTER
     5623     (   INPUT p-obj-type AS CHARACTER
     5624        ,INPUT p-obj-code AS INTEGER
     5625        ,INPUT p-w-p-code AS INTEGER ) :
     5626   DEFINE BUFFER buf_wth-place FOR ub.wth-place.
     5627   IF p-w-p-code = 0
     5628   AND lookup(tt-wth-doc.ext-doc-type, 'ci,ce':U) = 0 THEN DO:
     5629       RETURN ''.
     5630   END.
     5631   FIND FIRST buf_wth-place NO-LOCK WHERE
     5632       buf_wth-place.obj-type = p-obj-type
     5633    AND buf_wth-place.obj-code = p-obj-code
     5634    AND buf_wth-place.w-p-code = p-w-p-code NO-ERROR.
     5635   IF AVAILABLE buf_wth-place THEN DO:
     5636     RETURN buf_wth-place.w-p-name.
     5637   END.
     5638   RETURN "!!!Неизвестное МХ МЦ".
     5639   END FUNCTION.
