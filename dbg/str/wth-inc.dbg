     1535     OPEN QUERY BR-lines FOR EACH buf_wth-line WHERE buf_wth-line.doc-code = tt-wth-doc.doc-code NO-LOCK,              EACH buf_wth WHERE buf_wth.wth-code = buf_wth-line.wth-code NO-LOCK.
     1536     apply "entry" to br-lines.
     1537       RETURN NO-APPLY.
     1538   END.
