     2037   ON CHOOSE OF B-out IN FRAME Dialog-Frame
     2038   DO:
     2039   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2040   if lookup(self :type
     2041            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2042            ) = 0
     2043   then do:
     2044     message
     2045       "$Workfile$"
     2046       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2047       "Интерфейсный элемент" self :name  skip
     2048       "Тип" self :type  skip
     2049       "Процедура" this-procedure :file-name skip
     2050       view-as alert-box .
     2051   end.
     2052   else do:
     2053     apply "entry":u to self  .
     2054     if focus :handle <> self :handle  then do:
     2055       return no-apply .
     2056     end.
     2057   end.
     2058     define variable was_found  AS LOG  NO-UNDO.
     2059     define variable ref-rec as recid no-undo .
     2060     IF tt-wth-doc.cli-type = 'маг':U OR
     2061        tt-wth-doc.cli-type = 'скл':U THEN DO:
     2062       IF CAN-FIND( buf_clients NO-LOCK WHERE
     2063            buf_clients.obj-type = INPUT FRAME Dialog-Frame tt-wth-doc.cli-type   AND
     2064            buf_clients.obj-code = INPUT FRAME Dialog-Frame tt-wth-doc.cli-code )
     2065       THEN DO:
     2066         CASE INPUT FRAME Dialog-Frame tt-wth-doc.cli-type :
     2067           WHEN 'маг':U  THEN DO:
     2068             FIND FIRST ub.shop  NO-LOCK WHERE
     2069                               ub.shop.host-code = tt-wth-doc.host-code  AND
     2070                               ub.shop.obj-code  = INPUT FRAME Dialog-Frame tt-wth-doc.cli-code  NO-ERROR.
     2071             ASSIGN was_found = ( AVAIL ub.shop ).
     2072           END.
     2073           WHEN 'скл':U THEN DO:
     2074             FIND FIRST ub.store NO-LOCK WHERE
     2075                               ub.store.host-code = tt-wth-doc.host-code AND
     2076                               ub.store.obj-code = INPUT FRAME Dialog-Frame tt-wth-doc.cli-code NO-ERROR.
     2077             ASSIGN was_found = ( AVAIL ub.store ).
     2078           END.
     2079         END CASE.
     2080       END.
     2081     END.
     2082     FIND FIRST out-place NO-LOCK WHERE
     2083                       out-place.host-code = tt-wth-doc.host-code               AND
     2084                       out-place.obj-type    = tt-wth-doc.cli-type  AND
     2085                       out-place.obj-code    = tt-wth-doc.cli-code  AND
     2086                       out-place.w-p-code    = INPUT FRAME Dialog-Frame for-out-w-p-code NO-ERROR.
     2087     IF AVAIL out-place THEN DO:
     2088       ASSIGN v_rid = string(RECID( out-place ))
     2089       .
     2090     END.
     2091     run ref/wthplref.w (
     2092                      input parparentproc
     2093                     ,INPUT "b-sel":U
     2094                     ,INPUT tt-wth-doc.host-code
     2095                     ,INPUT tt-wth-doc.cli-type
     2096                     ,INPUT tt-wth-doc.cli-code
     2097                     ,input 'объект':U
     2098                     ,input-output v_rid ).
     2099     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2100       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2101       IF ERROR-STATUS:ERROR THEN DO:
     2102           RETURN NO-APPLY.
     2103       END.
     2104       FIND out-place NO-LOCK WHERE
     2105               RECID( out-place ) = ref-rec NO-ERROR.
     2106       IF AVAIL out-place THEN DO:
     2107         DISPLAY
     2108         out-place.w-p-code @ for-out-w-p-code
     2109         out-place.w-p-name @ for-out-w-p-name
     2110         WITH FRAME Dialog-Frame.
     2111       END.
     2112       ELSE DO:
     2113           RETURN NO-APPLY.
     2114       END.
     2115     END.
     2116     ELSE DO:
     2117       RETURN NO-APPLY.
     2118     END.
     2119   END.
