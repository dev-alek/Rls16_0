     1029   end.
     1030   end procedure.
     1031   procedure thbjattr_delete-section :
     1032   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
     1033   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
     1034   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     1035   do
     1036   on error undo, return error return-value
     1037   :
     1038       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
     1039       (input  p-obj-type
     1040       ,input  p-obj-code
     1041       ,input  p-upper-code
     1042       ) no-error .
     1043     if error-status :error
     1044     then do:
     1045       undo, return error return-value .
     1046     end.
     1047   end.
     1048   end procedure.
     1049   procedure thbjattr_manual-edit :
     1050   define input  parameter p-ucode          as character no-undo .
     1051   define input  parameter p-code           as character no-undo .
     1052   define output parameter p-section-num    as integer no-undo .
     1053   do
     1054   on error undo, return error return-value
     1055   :
     1056       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
     1057       (input  p-ucode
     1058       ,input  p-code
     1059       ,output  p-section-num
     1060       ) no-error .
     1061     if error-status :error
     1062     then do:
     1063       undo, return error return-value .
     1064     end.
     1065   end.
     1066   end procedure.
     1067   define temp-table tt-wth-line  no-undo like ub.wth-line .
