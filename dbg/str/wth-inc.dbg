     1462   ON CHOOSE OF B-allZone IN FRAME Dialog-Frame
     1463   DO:
     1464   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   if lookup(self :type
     1466            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1467            ) = 0
     1468   then do:
     1469     message
