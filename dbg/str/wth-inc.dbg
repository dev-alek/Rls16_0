      655   procedure wthcattr-sprcli :
      656   define input parameter parparentproc  as widget-handle no-undo.
      657   define input parameter p-mode  as character no-undo.
      658   define input-output parameter p-value as character no-undo .
      659   define output parameter p-setted as logical no-undo .
      660     DEFINE VARIABLE v-value as character no-undo .
      661     define variable v-cli-type as character no-undo .
      662     define variable v-cli-code as integer no-undo .
      663     define buffer buf_clients   for ub.clients.
      664     define variable v_rid as character no-undo.
      665     define variable ref-rec as recid no-undo .
      666     do
      667     on error undo, return error
      668     :
      669         v-value = p-value.
      670      if p-value <> '':U then do:
      671       assign
      672       v-cli-type = substring(p-value, 1, 3)
      673       v-cli-code = integer(substring(p-value, 4))
      674       no-error.
      675       if error-status:error then do:
      676         assign
      677         v-cli-type = '':U
      678         v-cli-code = 0
      679         .
      680       end.
      681      end.
      682      FIND FIRST buf_clients NO-LOCK WHERE
      683               buf_clients.obj-type = v-cli-type AND
      684               buf_clients.obj-code = v-cli-code  NO-ERROR.
      685      IF available(buf_clients) then do:
      686       run ref/cli-all.w (
      687                   input parparentproc
      688                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      689                  ,input v-cli-type
      690                  ,input 'все':U
      691                  ,input 'все':U
      692                  ,input RECID( buf_clients )
      693                  ,input ",,,,,,NO"
      694                  ,input ?
      695                  ,OUTPUT v_rid ).
      696     END.
      697     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      698       run ref/cli-all.w (
      699                    input parparentproc
      700                   ,INPUT "b-sel":U
      701                  ,input  v-cli-type
      702                  ,input 'все':U
      703                  ,input 'текущие':U
      704                  ,input ?
      705                  ,input ",,,,,,NO"
      706                  ,input ?
      707                  ,OUTPUT v_rid ).
      708     END.
      709     else do:
      710       message
      711       if p-value = "":U then 'Атрибут не задан!'
      712       else substitute('Не найден клиент &1',p-value)
      713       view-as alert-box warning.
      714     end.
      715     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      716       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      717       IF ERROR-STATUS:ERROR THEN DO:
      718           RETURN NO-APPLY.
      719       END.
      720       FIND FIRST buf_clients NO-LOCK WHERE
      721                  RECID( buf_clients ) = ref-rec NO-ERROR.
      722       IF AVAIL buf_clients THEN DO:
      723         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      724       end.
      725     end.
      726     if v-value <> p-value then do:
      727       p-value = v-value.
      728       p-setted = yes.
      729     end.
      730     end.
      731   end procedure.
