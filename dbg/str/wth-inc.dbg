     2245     apply "entry" to tt-wth-doc.receiver in FRAME Dialog-Frame.
     2246     return no-apply.
     2247   END.
     2248   ON CHOOSE OF B-shcfact IN FRAME Dialog-Frame
     2249   DO:
     2250   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251   if lookup(self :type
     2252            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2253            ) = 0
     2254   then do:
     2255     message
     2256       "$Workfile$"
     2257       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2258       "Интерфейсный элемент" self :name  skip
     2259       "Тип" self :type  skip
     2260       "Процедура" this-procedure :file-name skip
     2261       view-as alert-box .
     2262   end.
     2263   else do:
     2264     apply "entry":u to self  .
     2265     if focus :handle <> self :handle  then do:
     2266       return no-apply .
     2267     end.
     2268   end.
     2269   define variable v-nsf as character no-undo.
     2270   define variable v-dsf as date no-undo.
     2271   if f-atrNsf:screen-value > '' then do:
     2272     message
     2273     "Номер сч.-фактуры заполнен." skip
     2274     "Сгенерировать новый номер?"
     2275     view-as alert-box question buttons yes-no update choice as log.
     2276     if choice then.
     2277     else return no-apply.
     2278   end.
     2279   run str/wthsfgen.p (
     2280                      input tt-wth-doc.obj-type
     2281                     ,input tt-wth-doc.obj-code
     2282                     ,output v-nsf ) no-error.
     2283   if error-status:error then do:
     2284     MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2285     RETURN-VALUE
     2286     VIEW-AS ALERT-BOX.
     2287     return.
     2288   end.
     2289   f-atrNSF:screen-value = v-nsf.
     2290   v-dsf = date(f-atrdsf:screen-value) no-error.
     2291   if v-dsf = ? then f-atrdsf:screen-value = tt-wth-doc.doc-date:screen-value.
     2292   END.
     2293   ON LEAVE OF tt-wth-doc.cli-code IN FRAME Dialog-Frame
     2294   DO:
     2295     assign frame Dialog-Frame tt-wth-doc.cli-type
     2296                                tt-wth-doc.cli-code.
     2297       FIND FIRST buf_clients NO-LOCK WHERE
     2298                   buf_clients.obj-type = INPUT FRAME Dialog-Frame tt-wth-doc.cli-type AND
     2299                   buf_clients.obj-code = INPUT FRAME Dialog-Frame tt-wth-doc.cli-code NO-ERROR.
     2300     IF AVAIL buf_clients THEN DO:
     2301       CASE buf_clients.obj-type:
     2302         when 'маг':U then dO:
     2303           find first ub.shop No-LOCK WHERE
     2304                      ub.shop.obj-code = buf_clients.obj-code No-ERROR.
     2305           if ub.shop.host-code <> tt-wth-doc.host-code then do:
     2306             message "Нельзя выбрать магазин другой фирмы!"
     2307             view-as alert-box error .
     2308             APPLY "ENTRY" to tt-wth-doc.cli-code in frame Dialog-Frame.
     2309             return no-apply.
     2310           end.
     2311         end.
     2312         when 'скл':U then do:
     2313           find first ub.store No-LOCK WHERE
     2314                      ub.store.obj-code = buf_clients.obj-code No-ERROR.
     2315           if ub.store.host-code <> tt-wth-doc.host-code then do:
     2316             message "Нельзя выбрать склад другой фирмы!"
     2317             view-as alert-box error .
     2318             APPLY "ENTRY" to tt-wth-doc.cli-code in frame Dialog-Frame.
     2319             return no-apply.
     2320           end.
     2321         end.
     2322         when 'орг':U then do:
     2323               end.
     2324       end CASE.
     2325       DISPLAY
     2326       buf_clients.obj-name @ tt-wth-doc.cli-name WITH FRAME Dialog-Frame.
     2327     END.
     2328     run control-out in this-procedure.
     2329   END.
     2330   ON VALUE-CHANGED OF tt-wth-doc.cli-type IN FRAME Dialog-Frame
     2331   DO:
     2332     assign frame Dialog-Frame tt-wth-doc.cli-type
     2333                                tt-wth-doc.cli-code.
     2334    run control-out in this-procedure.
     2335    FIND FIRST buf_clients NO-LOCK WHERE
     2336             buf_clients.obj-type = INPUT FRAME Dialog-Frame tt-wth-doc.cli-type AND
     2337             buf_clients.obj-code = INPUT FRAME Dialog-Frame tt-wth-doc.cli-code NO-ERROR.
     2338   IF AVAIL buf_clients THEN DO:
     2339       DISPLAY
     2340       buf_clients.obj-name @ tt-wth-doc.cli-name WITH FRAME Dialog-Frame.
     2341   END.
     2342   ELSE DO:
     2343       DISPLAY
     2344       "":U @ tt-wth-doc.cli-name WITH FRAME Dialog-Frame.
     2345   END.
     2346   END.
     2347   ON LEAVE OF tt-wth-doc.deliver IN FRAME Dialog-Frame
     2348   DO:
     2349     if input frame Dialog-Frame tt-wth-doc.deliver <> tt-wth-doc.deliver then do:
     2350       run local-psn-chk in this-procedure ( input "deliver", input "leave").
     2351     end.
     2352   END.
     2353   ON MOUSE-SELECT-DBLCLICK OF tt-wth-doc.deliver IN FRAME Dialog-Frame
     2354   OR return OF tt-wth-doc.deliver IN FRAME Dialog-Frame DO:
     2355     run local-psn-chk in this-procedure ( input "deliver", input "ret-mouse").
     2356     apply "entry" to tt-wth-doc.deliver in frame Dialog-Frame.
     2357     return no-apply.
     2358   END.
     2359   ON LEAVE OF tt-wth-doc.fact-date IN FRAME Dialog-Frame
     2360   DO:
     2361      run chk-upd-date in this-procedure ( input self :name ) no-error.
     2362      if error-status:error then return no-apply.
     2363   END.
     2364   ON RETURN OF tt-wth-doc.fact-date IN FRAME Dialog-Frame
     2365   DO:
     2366       if tt-wth-doc.fact-date:sensitive in frame Dialog-Frame then do:
     2367       apply "entry" to tt-wth-doc.shift-date in frame Dialog-Frame.
     2368     end.
     2369     else do:
     2370       apply "entry" to b-add in frame Dialog-Frame.
     2371     end.
     2372     return no-apply.
     2373   END.
     2374   ON LEAVE OF for-current-w-p-code IN FRAME Dialog-Frame
     2375   DO:
     2376       FIND FIRST current-place NO-LOCK WHERE
     2377               current-place.host-code = tt-wth-doc.host-code AND
     2378               current-place.obj-type = tt-wth-doc.obj-type      AND
     2379               current-place.obj-code = tt-wth-doc.obj-code      AND
     2380               current-place.w-p-code = INPUT FRAME Dialog-Frame for-current-w-p-code NO-ERROR.
     2381     IF AVAIL current-place THEN DO:
     2382       DISPLAY
     2383       current-place.w-p-name @ for-current-w-p-name
     2384       WITH FRAME Dialog-Frame.
     2385     END.
     2386   END.
     2387   ON LEAVE OF for-out-w-p-code IN FRAME Dialog-Frame
     2388   DO:
     2389     if chkleave
     2390       (input last-event :widget-enter
     2391       ,input "b-quit,b-out":u
     2392       )
     2393     then do:
     2394       FIND FIRST out-place NO-LOCK WHERE
     2395               out-place.host-code = tt-wth-doc.host-code AND
     2396               out-place.obj-type = tt-wth-doc.cli-type AND
     2397               out-place.obj-code = tt-wth-doc.cli-code AND
     2398               out-place.w-p-code = INPUT FRAME Dialog-Frame for-out-w-p-code NO-ERROR.
     2399       IF AVAIL out-place THEN DO:
     2400         DISPLAY
     2401         out-place.w-p-name @ for-out-w-p-name
     2402             WITH FRAME Dialog-Frame.
     2403       END.
     2404       else  IF NOT AVAIL out-place AND
     2405         int(for-out-w-p-code:screen-value) <> 0 AND
     2406         int(for-out-w-p-code:screen-value) <> ? AND
     2407         tt-wth-doc.doc-type <> 'возврат':U and
     2408         tt-wth-doc.doc-type <> 'при':U and
     2409         tt-wth-doc.exter_ = no  and
     2410         tt-wth-doc.inter_ = no THEN DO:
     2411         message  substitute( "Не найдено место хранения МЦ &1 в справочнике!"
     2412                           ,for-out-w-p-code:screen-value
     2413                         ).
     2414        return no-apply.
     2415       end.
     2416       else display    "":U @ for-out-w-p-name
     2417             WITH FRAME Dialog-Frame.
     2418     end.
     2419   END.
     2420   ON VALUE-CHANGED OF tt-wth-doc.obj-type IN FRAME Dialog-Frame
     2421   DO:
     2422      FIND FIRST buf_obj NO-LOCK WHERE
     2423             buf_obj.obj-type = INPUT FRAME Dialog-Frame tt-wth-doc.obj-type AND
     2424             buf_obj.obj-code = INPUT FRAME Dialog-Frame tt-wth-doc.obj-code NO-ERROR.
     2425      IF AVAIL buf_obj THEN DO:
     2426       DISPLAY
     2427       buf_obj.obj-name @ for-object WITH FRAME Dialog-Frame.
     2428      END.
     2429      ELSE DO:
     2430           DISPLAY
     2431           "":U @ for-object WITH FRAME Dialog-Frame.
     2432      END.
     2433   END.
     2434   ON LEAVE OF tt-wth-doc.operator IN FRAME Dialog-Frame
     2435   DO:
     2436     if input frame Dialog-Frame tt-wth-doc.operator <> tt-wth-doc.operator then do:
     2437       run local-psn-chk in this-procedure ( input "operator", input "leave").
     2438     end.
     2439   END.
     2440   ON MOUSE-SELECT-DBLCLICK OF tt-wth-doc.operator IN FRAME Dialog-Frame
     2441   OR return OF tt-wth-doc.operator IN FRAME Dialog-Frame DO:
     2442     run local-psn-chk in this-procedure (input "operator", input "ret-mouse").
     2443     apply "entry" to tt-wth-doc.operator in frame Dialog-Frame.
     2444     return no-apply.
     2445   END.
     2446   ON CHOOSE OF r-sht IN FRAME Dialog-Frame
     2447   DO:
     2448     run proc-sht no-error.
     2449   END.
     2450   ON LEAVE OF tt-wth-doc.receiver IN FRAME Dialog-Frame
     2451   DO:
     2452     if input frame Dialog-Frame tt-wth-doc.receiver <> tt-wth-doc.receiver then do:
     2453       run local-psn-chk in this-procedure (input "receiver", input "leave").
     2454       if  input frame Dialog-Frame tt-wth-doc.receiver > 0 then do:
     2455         hide f-AtrReceiver in  frame Dialog-Frame.
     2456       end.
     2457     end.
     2458   END.
     2459   ON MOUSE-SELECT-DBLCLICK OF tt-wth-doc.receiver IN FRAME Dialog-Frame
     2460   OR return OF tt-wth-doc.receiver IN FRAME Dialog-Frame DO:
     2461     run local-psn-chk in this-procedure (input "receiver", input "ret-mouse").
     2462     apply "entry" to tt-wth-doc.receiver in frame Dialog-Frame.
     2463     return no-apply.
     2464   END.
     2465   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2466   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2467   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   on help of frame Dialog-Frame
     2469   do:
     2470     run gbl/app_help.p
     2471       (input this-procedure :file-name
     2472       ,input ''
     2473       ,input ?
     2474       ) no-error.
     2475     if error-status :error then do:
     2476       message
     2477         "Ошибка при вызове помощи"
     2478         error-status :get-message(1)
     2479         view-as alert-box .
     2480     end.
     2481   end.
     2482   run minbtn-set in this-procedure .
     2483   on choose of b-help in frame Dialog-Frame
     2484   do:
     2485     apply "help":u to frame Dialog-Frame .
     2486   end.
     2487   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2488   procedure minbtn-set :
     2489       do
     2490           on error undo, return error return-value
     2491           :
     2492           define variable ii              as integer       no-undo .
     2493           define variable fh              as widget-handle no-undo .
     2494           define variable hh              as widget-handle no-undo .
     2495           define variable v-h             as handle        extent 4 no-undo .
     2496           define variable v-name-button   as character     no-undo .
     2497           define variable v-help-old-x    as decimal       no-undo .
     2498           define variable v-help-old-y    as decimal       no-undo .
     2499           define variable v-help-old-size as decimal       no-undo .
     2500           define variable v-frame-width   as decimal       no-undo .
     2501           define variable jj              as integer       no-undo .
     2502           do
     2503               on error undo, return error
     2504               :
     2505               assign
     2506                   v-frame-width = frame Dialog-Frame:width - 0.3
     2507                   fh            = frame Dialog-Frame:first-child
     2508                   hh            = fh:first-child
     2509                   ii            = 1
     2510                   .
     2511               do while valid-handle(hh):
     2512                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2513                   do:
     2514                       case lc(hh:name) :
     2515                           when "b-help" then
     2516                               do:
     2517                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2518                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2519                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2520                                   hh:TOOLTIP = "Помощь" .
     2521                                   v-help-old-x = hh:column .
     2522                                   v-help-old-y = hh:row    .
     2523                                   v-help-old-size = hh:width .
     2524                                   hh:width-chars = 2.5 .
     2525                               end.
     2526                           when "b-print" then
     2527                               do:
     2528                                   hh:load-image("cmp/b-print.bmp":u) .
     2529                                   hh:TOOLTIP = "Печать" .
     2530                                   v-h[ii] = hh:handle .
     2531                                   ii = ii + 1 .
     2532                                   hh:width-chars = 3 .
     2533                               end.
     2534                           when "b-history" or
     2535                           when "b-hist" then
     2536                               do:
     2537                                   hh:load-image("cmp/b-hist.bmp":u) .
     2538                                   hh:TOOLTIP = "История" .
     2539                                   v-h[ii] = hh:handle .
     2540                                   ii = ii + 1 .
     2541                                   hh:width-chars = 3 .
     2542                               end.
     2543                           when "b-sch" then
     2544                               do:
     2545                                   hh:load-image("cmp/b-sch.bmp":u) .
     2546                                   hh:TOOLTIP = "Установка Фильтра" .
     2547                                   v-h[ii] = hh:handle .
     2548                                   ii = ii + 1 .
     2549                                   hh:width-chars = 3 .
     2550                               end.
     2551                           when "b-hist-user" then
     2552                               do:
     2553                                   hh:load-image("cmp/b-hist.bmp":u) .
     2554                                   hh:TOOLTIP = "История пользователя" .
     2555                                   ii = ii + 1 .
     2556                               end.
     2557                       end case.
     2558                   end.
     2559                   hh = hh:next-sibling.
     2560               end.
     2561               b-help:column = v-frame-width - b-help:width-chars.
     2562               jj = 0.
     2563               repeat ii = 4 to 1 by -1 :
     2564                   if valid-handle (v-h[ii] ) then
     2565                   do:
     2566                       jj  = jj + 1 .
     2567                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2568                       v-h[ii]:row    = v-help-old-y .
     2569                   end.
     2570               end.
     2571           end.
     2572       end.
     2573   end procedure.
     2574   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2575   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2576   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2577   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2578   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2579   define variable v-diasize-current-frame-height as decimal   no-undo .
     2580   define variable v-diasize-change-size          as logical   no-undo .
     2581   define variable v-diasize-resize-button        as handle    no-undo .
     2582   define variable v-diasize-wndmax               as logical   no-undo .
     2583   define variable v-diasize-wndstore             as logical   no-undo .
     2584   define variable v-diasize-proc-name            as character no-undo .
     2585   define variable v-diasize-browse-handle        as handle    no-undo .
     2586   define variable v-diasize-browse-number        as integer   no-undo .
     2587   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2588   define temp-table temp-diasize-handle no-undo
     2589     field handle-value  as handle
     2590     field save-position as decimal
     2591     index xpk is primary unique handle-value
     2592     .
     2593   define temp-table temp-browse-handle no-undo
     2594     field browse-type   as character
     2595     field browse-number as integer
     2596     field browse-handle as handle
     2597     field original-size as decimal
     2598     index xpk is primary unique browse-type browse-number
     2599     index xie browse-type browse-handle
     2600   .
     2601   procedure diasize_change-height :
     2602     define input  parameter p-change-value  as decimal   no-undo .
     2603     define input  parameter p-move-resize   as logical   no-undo .
     2604     define variable v-field-group-handle    as handle    no-undo .
     2605     define variable v-object-handle         as handle    no-undo .
     2606     define variable v-frame-height          as decimal   no-undo .
     2607     define variable v-frame-virtual-height  as decimal   no-undo .
     2608     define variable v-browse-height         as decimal   no-undo .
     2609     define variable v-window-height         as decimal   no-undo .
     2610     define variable v-window-virtual-height as decimal   no-undo .
     2611     define variable v-change-sign           as integer   no-undo .
     2612     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2613     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2614     if p-change-value > 0
     2615     then do:
     2616       if frame Dialog-Frame :height + p-change-value
     2617           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2618       then do:
     2619         assign
     2620           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2621                           - (frame Dialog-Frame :height-chars)
     2622         .
     2623         if p-change-value <= 0
     2624         then do:
     2625           run diasize_position-resize-button in this-procedure .
     2626           return .
     2627         end.
     2628       end.
     2629     end.
     2630     if p-change-value < 0
     2631     then do:
     2632       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2633       then do:
     2634         assign
     2635           p-change-value = v-diasize-orig-frame-height
     2636                          - (frame Dialog-Frame :height-chars)
     2637         .
     2638         if p-change-value >= 0
     2639         then do:
     2640           run diasize_position-resize-button in this-procedure .
     2641           return .
     2642         end.
     2643       end.
     2644     end.
     2645     if p-change-value >= 0
     2646     then do:
     2647       assign
     2648         v-change-sign = 1
     2649       .
     2650     end.
     2651     else do:
     2652       assign
     2653         v-change-sign = -1
     2654       .
     2655     end.
     2656     assign
     2657       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2658     .
     2659     if p-change-value = 0
     2660     then do:
     2661       run diasize_position-resize-button in this-procedure .
     2662       return .
     2663     end.
     2664     move_block:
     2665     do
     2666     on error undo move_block, retry move_block
     2667     :
     2668       if retry
     2669       then do:
     2670         do
     2671         on error undo move_block, leave move_block
     2672         :
     2673           if p-change-value > 0
     2674           then do:
     2675             for each buf_temp-diasize-handle
     2676             on error undo, next
     2677             :
     2678               assign
     2679                 v-object-handle = buf_temp-diasize-handle.handle-value
     2680               .
     2681               if v-object-handle <> v-diasize-resize-button
     2682               then do:
     2683                 assign
     2684                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2685                 .
     2686               end.
     2687             end.
     2688             assign
     2689               v-diasize-browse-handle :height = v-browse-height
     2690             .
     2691             for each buf_temp-browse-handle
     2692               where buf_temp-browse-handle.browse-type = 'height':u
     2693             on error undo, next
     2694             :
     2695               assign
     2696                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2697               .
     2698             end.
     2699             assign
     2700               frame Dialog-Frame :height = v-frame-height
     2701             .
     2702             if frame Dialog-Frame :scrollable = true
     2703             then do:
     2704               assign
     2705                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2706               .
     2707             end.
     2708             run diasize_position-resize-button in this-procedure .
     2709           end.
     2710           else do:
     2711             if frame Dialog-Frame :scrollable = true
     2712             then do:
     2713               assign
     2714                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2715               .
     2716             end.
     2717             assign
     2718               frame Dialog-Frame :height = v-frame-height
     2719             .
     2720             assign
     2721               v-diasize-browse-handle :height = v-browse-height
     2722             .
     2723             for each buf_temp-browse-handle
     2724               where buf_temp-browse-handle.browse-type = 'height':u
     2725             on error undo, next
     2726             :
     2727               assign
     2728                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2729               .
     2730             end.
     2731             for each buf_temp-diasize-handle
     2732             on error undo, next
     2733             :
     2734               assign
     2735                 v-object-handle = buf_temp-diasize-handle.handle-value
     2736               .
     2737               if v-object-handle <> v-diasize-resize-button
     2738               then do:
     2739                 assign
     2740                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2741                 .
     2742               end.
     2743             end.
     2744             run diasize_position-resize-button in this-procedure .
     2745           end.
     2746           assign
     2747             v-diasize-change-size = false
     2748           .
     2749           leave move_block .
     2750         end.
     2751       end.
     2752       assign
     2753         v-diasize-need-full-display = true
     2754       .
     2755       if v-diasize-change-size = false
     2756       then do:
     2757         assign
     2758           v-diasize-change-size = true
     2759         .
     2760       end.
     2761       else do:
     2762         return .
     2763       end.
     2764       assign
     2765         v-frame-height = frame Dialog-Frame :height
     2766         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2767         v-browse-height = v-diasize-browse-handle :height
     2768       .
     2769       for each buf_temp-browse-handle
     2770         where buf_temp-browse-handle.browse-type = 'height':u
     2771       :
     2772         assign
     2773           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2774         .
     2775       end.
     2776       for each buf_temp-diasize-handle
     2777       :
     2778         delete buf_temp-diasize-handle .
     2779       end.
     2780       assign
     2781         v-field-group-handle = frame Dialog-Frame :first-child
     2782       .
     2783       do while valid-handle(v-field-group-handle)
     2784       :
     2785         assign
     2786           v-object-handle = v-field-group-handle :first-child
     2787         .
     2788         do while valid-handle(v-object-handle)
     2789         :
     2790           if  v-object-handle <> v-diasize-browse-handle :handle
     2791           and can-query(v-object-handle, "row")
     2792           and can-query(v-object-handle, "height")
     2793           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2794           then do:
     2795             find first buf_temp-browse-handle
     2796               where buf_temp-browse-handle.browse-type   = 'height':u
     2797                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2798               no-error .
     2799             if available buf_temp-browse-handle
     2800             then do:
     2801             end.
     2802             else do:
     2803               create buf_temp-diasize-handle .
     2804               assign
     2805                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2806                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2807               .
     2808             end.
     2809           end.
     2810           assign
     2811             v-object-handle = v-object-handle :next-sibling
     2812           .
     2813         end.
     2814         assign
     2815           v-field-group-handle = v-field-group-handle :next-sibling
     2816         .
     2817       end.
     2818       do with frame Dialog-Frame
     2819       :
     2820         hide v-diasize-resize-button .
     2821         assign
     2822           v-diasize-resize-button :row    = 1
     2823           v-diasize-resize-button :column = 1
     2824         .
     2825       end.
     2826       if p-change-value > 0
     2827       then do:
     2828         if frame Dialog-Frame :scrollable = true
     2829         then do:
     2830           assign
     2831             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2832             no-error .
     2833           if error-status :error
     2834           or error-status :get-message(1) <> ""
     2835           then do:
     2836             undo move_block, retry move_block .
     2837           end.
     2838         end.
     2839         assign
     2840           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2841           no-error .
     2842         if error-status :error
     2843         or error-status :get-message(1) <> ""
     2844         then do:
     2845           undo move_block, retry move_block .
     2846         end.
     2847         assign
     2848           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2849           no-error .
     2850         if error-status :error
     2851         or error-status :get-message(1) <> ""
     2852         then do:
     2853           undo move_block, retry move_block .
     2854         end.
     2855         for each buf_temp-browse-handle
     2856           where buf_temp-browse-handle.browse-type = 'height':u
     2857         on error undo move_block, retry move_block
     2858         :
     2859           assign
     2860             buf_temp-browse-handle.browse-handle :height
     2861               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2862             no-error .
     2863           if error-status :error
     2864           or error-status :get-message(1) <> ""
     2865           then do:
     2866             undo move_block, retry move_block .
     2867           end.
     2868         end.
     2869         for each buf_temp-diasize-handle
     2870         on error undo move_block, retry move_block
     2871         :
     2872           assign
     2873             v-object-handle = buf_temp-diasize-handle.handle-value
     2874           .
     2875           if v-object-handle <> v-diasize-resize-button
     2876           then do:
     2877             assign
     2878               v-object-handle :row = v-object-handle :row + p-change-value
     2879               no-error .
     2880             if error-status :error
     2881             or error-status :get-message(1) <> ""
     2882             then do:
     2883               undo move_block, retry move_block .
     2884             end.
     2885           end.
     2886         end.
     2887       end.
     2888       else do:
     2889         for each buf_temp-diasize-handle
     2890         on error undo move_block, retry move_block
     2891         :
     2892           assign
     2893             v-object-handle = buf_temp-diasize-handle.handle-value
     2894           .
     2895           if v-object-handle <> v-diasize-resize-button
     2896           then do:
     2897             assign
     2898               v-object-handle :row = v-object-handle :row + p-change-value
     2899               no-error .
     2900             if error-status :error
     2901             or error-status :get-message(1) <> ""
     2902             then do:
     2903               undo move_block, retry move_block .
     2904             end.
     2905           end.
     2906         end.
     2907         assign
     2908           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2909           no-error .
     2910         if error-status :error
     2911         or error-status :get-message(1) <> ""
     2912         then do:
     2913           undo move_block, retry move_block .
     2914         end.
     2915         for each buf_temp-browse-handle
     2916           where buf_temp-browse-handle.browse-type = 'height':u
     2917         on error undo move_block, retry move_block
     2918         :
     2919           assign
     2920             buf_temp-browse-handle.browse-handle :height
     2921               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2922             no-error .
     2923           if error-status :error
     2924           or error-status :get-message(1) <> ""
     2925           then do:
     2926             undo move_block, retry move_block .
     2927           end.
     2928         end.
     2929         assign
     2930           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2931           no-error .
     2932         if error-status :error
     2933         or error-status :get-message(1) <> ""
     2934         then do:
     2935           undo move_block, retry move_block .
     2936         end.
     2937         if frame Dialog-Frame :scrollable = true
     2938         then do:
     2939           assign
     2940             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2941             no-error .
     2942           if error-status :error
     2943           or error-status :get-message(1) <> ""
     2944           then do:
     2945             undo move_block, retry move_block .
     2946           end.
     2947         end.
     2948       end.
     2949       if p-move-resize = true
     2950       then do:
     2951         run diasize_position-resize-button in this-procedure .
     2952       end.
     2953       if v-diasize-wndstore = true
     2954       then do:
     2955         if connected("ub") = true
     2956         then do:
     2957           define variable v-cntxt-db-num        as integer   no-undo .
     2958           define variable v-cntxt-userid        as character no-undo .
     2959           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2960                                             , OUTPUT v-cntxt-userid
     2961                                             ) .
     2962           run gbl/wndsizew.p
     2963             (input  v-cntxt-db-num
     2964             ,input  v-cntxt-userid
     2965             ,input  v-diasize-proc-name
     2966             ,input  'height':u
     2967             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2968             ) .
     2969         end.
     2970       end.
     2971     end.
     2972     assign
     2973       v-diasize-change-size = false
     2974     .
     2975   end procedure.
     2976   procedure diasize_set-height :
     2977     define input  parameter p-new-height  as decimal   no-undo .
     2978     define input  parameter p-move-resize as logical   no-undo .
     2979     do
     2980     on error undo, return error return-value
     2981     :
     2982       run diasize_change-height in this-procedure
     2983         (input  (p-new-height - frame Dialog-Frame :height)
     2984         ,input  p-move-resize
     2985         ) .
     2986     end.
     2987   end procedure.
     2988   procedure diasize_change-width :
     2989     define input  parameter p-change-value as decimal   no-undo .
     2990     define input  parameter p-move-resize  as logical   no-undo .
     2991     define variable v-field-group-handle   as handle    no-undo .
     2992     define variable v-object-handle        as handle    no-undo .
     2993     define variable v-frame-width          as decimal   no-undo .
     2994     define variable v-frame-virtual-width  as decimal   no-undo .
     2995     define variable v-browse-width         as decimal   no-undo .
     2996     define variable v-window-width         as decimal   no-undo .
     2997     define variable v-window-virtual-width as decimal   no-undo .
     2998     define variable v-change-sign          as integer   no-undo .
     2999     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3000     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3001     if p-change-value > 0
     3002     then do:
     3003       if frame Dialog-Frame :width + p-change-value >
     3004           session :width-chars
     3005       then do:
     3006         assign
     3007           p-change-value = session :width-chars - frame Dialog-Frame :width
     3008         .
     3009         if p-change-value <= 0
     3010         then do:
     3011           run diasize_position-resize-button in this-procedure .
     3012           return .
     3013         end.
     3014       end.
     3015     end.
     3016     if p-change-value < 0
     3017     then do:
     3018       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3019       then do:
     3020         assign
     3021           p-change-value = v-diasize-orig-frame-width
     3022                          - frame Dialog-Frame :width
     3023         .
     3024         if p-change-value >= 0
     3025         then do:
     3026           run diasize_position-resize-button in this-procedure .
     3027           return .
     3028         end.
     3029       end.
     3030     end.
     3031     if p-change-value >= 0
     3032     then do:
     3033       assign
     3034         v-change-sign = 1
     3035       .
     3036     end.
     3037     else do:
     3038       assign
     3039         v-change-sign = -1
     3040       .
     3041     end.
     3042     assign
     3043       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3044     .
     3045     if p-change-value = 0
     3046     then do:
     3047       run diasize_position-resize-button in this-procedure .
     3048       return .
     3049     end.
     3050     move_block:
     3051     do
     3052     on error undo move_block, leave move_block
     3053     :
     3054       if retry
     3055       then do:
     3056         do
     3057         on error undo move_block, leave move_block
     3058         :
     3059           if p-change-value > 0
     3060           then do:
     3061             for each buf_temp-diasize-handle
     3062             on error undo, next
     3063             :
     3064               assign
     3065                 v-object-handle = buf_temp-diasize-handle.handle-value
     3066               .
     3067               if v-object-handle <> v-diasize-resize-button
     3068               then do:
     3069                 assign
     3070                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3071                 .
     3072               end.
     3073             end.
     3074             assign
     3075               v-diasize-browse-handle :width = v-browse-width
     3076             .
     3077             for each buf_temp-browse-handle
     3078               where buf_temp-browse-handle.browse-type = 'width':u
     3079             on error undo, next
     3080             :
     3081               assign
     3082                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3083               .
     3084             end.
     3085             assign
     3086               frame Dialog-Frame :width = v-frame-width
     3087             .
     3088             if frame Dialog-Frame :scrollable = true
     3089             then do:
     3090               assign
     3091                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3092               .
     3093             end.
     3094             run diasize_position-resize-button in this-procedure .
     3095           end.
     3096           else do:
     3097             if frame Dialog-Frame :scrollable = true
     3098             then do:
     3099               assign
     3100                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3101               .
     3102             end.
     3103             assign
     3104               frame Dialog-Frame :width = v-frame-width
     3105             .
     3106             for each buf_temp-browse-handle
     3107               where buf_temp-browse-handle.browse-type = 'width':u
     3108             on error undo, next
     3109             :
     3110               assign
     3111                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3112               .
     3113             end.
     3114             assign
     3115               v-diasize-browse-handle :width = v-browse-width
     3116             .
     3117             for each buf_temp-diasize-handle
     3118             on error undo, next
     3119             :
     3120               assign
     3121                 v-object-handle = buf_temp-diasize-handle.handle-value
     3122               .
     3123               if v-object-handle <> v-diasize-resize-button
     3124               then do:
     3125                 assign
     3126                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3127                 .
     3128               end.
     3129             end.
     3130             run diasize_position-resize-button in this-procedure .
     3131           end.
     3132           assign
     3133             v-diasize-change-size = false
     3134           .
     3135           leave move_block .
     3136         end.
     3137       end.
     3138       assign
     3139         v-diasize-need-full-display = true
     3140       .
     3141       if v-diasize-change-size = false
     3142       then do:
     3143         assign
     3144           v-diasize-change-size = true
     3145         .
     3146       end.
     3147       else do:
     3148         return .
     3149       end.
     3150       assign
     3151         v-frame-width = frame Dialog-Frame :width
     3152         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3153         v-browse-width = v-diasize-browse-handle :width
     3154       .
     3155       for each buf_temp-browse-handle
     3156         where buf_temp-browse-handle.browse-type = 'width':u
     3157       :
     3158         assign
     3159           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3160         .
     3161       end.
     3162       for each buf_temp-diasize-handle
     3163       :
     3164         delete buf_temp-diasize-handle .
     3165       end.
     3166       assign
     3167         v-field-group-handle = frame Dialog-Frame :first-child
     3168       .
     3169       do while valid-handle(v-field-group-handle)
     3170       :
     3171         assign
     3172           v-object-handle = v-field-group-handle :first-child
     3173         .
     3174         do while valid-handle(v-object-handle)
     3175         :
     3176           if  v-object-handle <> v-diasize-browse-handle :handle
     3177           and v-object-handle <> v-diasize-resize-button
     3178           and can-query(v-object-handle, "row")
     3179           and can-query(v-object-handle, "height")
     3180           and ( v-object-handle :col + v-object-handle :width
     3181                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3182               )
     3183           then do:
     3184             find first buf_temp-browse-handle
     3185               where buf_temp-browse-handle.browse-type   = 'width':u
     3186                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3187               no-error .
     3188             if available buf_temp-browse-handle
     3189             then do:
     3190             end.
     3191             else do:
     3192               create buf_temp-diasize-handle .
     3193               assign
     3194                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3195                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3196               .
     3197             end.
     3198           end.
     3199           assign
     3200             v-object-handle = v-object-handle :next-sibling
     3201           .
     3202         end.
     3203         assign
     3204           v-field-group-handle = v-field-group-handle :next-sibling
     3205         .
     3206       end.
     3207       do with frame Dialog-Frame
     3208       :
     3209         hide v-diasize-resize-button .
     3210         v-diasize-resize-button :row = 1.
     3211         v-diasize-resize-button :column = 1.
     3212       end.
     3213       if p-change-value > 0
     3214       then do:
     3215         if frame Dialog-Frame :scrollable = true
     3216         then do:
     3217           assign
     3218             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3219             no-error .
     3220           if error-status :error
     3221           or error-status :get-message(1) <> ""
     3222           then do:
     3223             undo move_block, retry move_block.
     3224           end.
     3225         end.
     3226         assign
     3227           frame Dialog-Frame :width = v-frame-width + p-change-value
     3228           no-error .
     3229         if error-status :error
     3230         or error-status :get-message(1) <> ""
     3231         then do:
     3232           undo move_block, retry move_block.
     3233         end.
     3234         assign
     3235           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3236         no-error .
     3237         if error-status :error
     3238         or error-status :get-message(1) <> ""
     3239         then do:
     3240           undo move_block, retry move_block.
     3241         end.
     3242         for each buf_temp-browse-handle
     3243           where buf_temp-browse-handle.browse-type = 'width':u
     3244         on error undo move_block, retry move_block
     3245         :
     3246           assign
     3247             buf_temp-browse-handle.browse-handle :width
     3248               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3249             no-error .
     3250           if error-status :error
     3251           or error-status :get-message(1) <> ""
     3252           then do:
     3253             undo move_block, retry move_block .
     3254           end.
     3255         end.
     3256         for each buf_temp-diasize-handle
     3257         on error undo move_block, retry move_block
     3258         :
     3259           assign
     3260             v-object-handle = buf_temp-diasize-handle.handle-value
     3261           .
     3262           if v-object-handle <> v-diasize-resize-button
     3263           then do:
     3264             assign
     3265               v-object-handle :col = v-object-handle :col + p-change-value
     3266               no-error .
     3267             if error-status :error
     3268             or error-status :get-message(1) <> ""
     3269             then do:
     3270               undo move_block, retry move_block .
     3271             end.
     3272           end.
     3273         end.
     3274       end.
     3275       else do:
     3276         for each buf_temp-diasize-handle
     3277         on error undo move_block, retry move_block
     3278         :
     3279           assign
     3280             v-object-handle = buf_temp-diasize-handle.handle-value
     3281           .
     3282           if v-object-handle <> v-diasize-resize-button
     3283           then do:
     3284             assign
     3285               v-object-handle :col = v-object-handle :col + p-change-value
     3286               no-error .
     3287             if error-status :error
     3288             or error-status :get-message(1) <> ""
     3289             then do:
     3290               undo move_block, retry move_block .
     3291             end.
     3292           end.
     3293         end.
     3294         for each buf_temp-browse-handle
     3295           where buf_temp-browse-handle.browse-type = 'width':u
     3296         on error undo move_block, retry move_block
     3297         :
     3298           assign
     3299             buf_temp-browse-handle.browse-handle :width
     3300               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3301             no-error .
     3302           if error-status :error
     3303           or error-status :get-message(1) <> ""
     3304           then do:
     3305             undo move_block, retry move_block .
     3306           end.
     3307         end.
     3308         assign
     3309           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3310           no-error .
     3311         if error-status :error
     3312         or error-status :get-message(1) <> ""
     3313         then do:
     3314           undo move_block, retry move_block.
     3315         end.
     3316         assign
     3317           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3318         no-error .
     3319         if error-status :error
     3320         or error-status :get-message(1) <> ""
     3321         then do:
     3322           undo move_block, retry move_block.
     3323         end.
     3324         if frame Dialog-Frame :scrollable = true
     3325         then do:
     3326           assign
     3327             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3328           no-error .
     3329           if error-status :error
     3330           or error-status :get-message(1) <> ""
     3331           then do:
     3332             undo move_block, retry move_block.
     3333           end.
     3334         end.
     3335       end.
     3336       if p-move-resize
     3337       then do:
     3338         run diasize_position-resize-button in this-procedure .
     3339       end.
     3340       if v-diasize-wndstore = true
     3341       then do:
     3342         if connected("ub") = true
     3343         then do:
     3344           define variable v-cntxt-db-num        as integer   no-undo .
     3345           define variable v-cntxt-userid        as character no-undo .
     3346           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3347                                             , OUTPUT v-cntxt-userid
     3348                                             ) .
     3349           run gbl/wndsizew.p
     3350             (input  v-cntxt-db-num
     3351             ,input  v-cntxt-userid
     3352             ,input  v-diasize-proc-name
     3353             ,input  'width':u
     3354             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3355             ) .
     3356         end.
     3357       end.
     3358     end.
     3359     assign
     3360       v-diasize-change-size = false
     3361     .
     3362   end procedure.
     3363   procedure diasize_set-width :
     3364     define input  parameter p-new-width  as decimal   no-undo .
     3365     define input  parameter p-move-resize as logical   no-undo .
     3366     do
     3367     on error undo, return error return-value
     3368     :
     3369       run diasize_change-width in this-procedure
     3370         (input  (p-new-width - frame Dialog-Frame :width)
     3371         ,input  p-move-resize
     3372         ) .
     3373     end.
     3374   end procedure.
     3375   procedure diasize_position-resize-button :
     3376     do with frame Dialog-Frame
     3377     :
     3378       hide v-diasize-resize-button .
     3379       assign
     3380         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3381                     - 1
     3382                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3383         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3384                     - 1
     3385                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3386       .
     3387       view v-diasize-resize-button .
     3388     end.
     3389   end procedure.
     3390   on alt-right anywhere
     3391   do:
     3392     run diasize_change-width in this-procedure
     3393       (input 1
     3394       ,input true
     3395       ) .
     3396     return no-apply .
     3397   end.
     3398   on alt-left anywhere
     3399   do:
     3400     run diasize_change-width in this-procedure
     3401       (input -1
     3402       ,input true
     3403       ) .
     3404     return no-apply .
     3405   end.
     3406   on alt-down anywhere
     3407   do:
     3408     run diasize_change-height in this-procedure
     3409       (input 1
     3410       ,input true
     3411       ) .
     3412     return no-apply .
     3413   end.
     3414   on alt-up anywhere
     3415   do:
     3416     run diasize_change-height in this-procedure
     3417       (input -1
     3418       ,input true
     3419       ) .
     3420     return no-apply .
     3421   end.
     3422   on alt-enter of frame Dialog-Frame
     3423   do:
     3424     run diasize_maximize in this-procedure
     3425       (input  ?
     3426       ).
     3427     return no-apply .
     3428   end.
     3429   procedure diasize_end-move :
     3430     do
     3431     on error undo, return error return-value
     3432     :
     3433       define variable v-row-delta as decimal   no-undo .
     3434       define variable v-col-delta as decimal   no-undo .
     3435       define variable v-new-row as decimal   no-undo .
     3436       define variable v-new-col as decimal   no-undo .
     3437       assign
     3438         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3439         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3440       .
     3441       assign
     3442         v-row-delta = v-new-row - frame Dialog-Frame :height
     3443         v-col-delta = v-new-col - frame Dialog-Frame :width
     3444       .
     3445       run diasize_change-height in this-procedure
     3446         (input v-row-delta
     3447         ,input true
     3448         ) .
     3449       run diasize_change-width in this-procedure
     3450         (input v-col-delta
     3451         ,input true
     3452         ) .
     3453     end.
     3454   end procedure.
     3455   procedure diasize_maximize :
     3456     define input  parameter p-action as logical   no-undo .
     3457     do
     3458     on error undo, return error return-value
     3459     :
     3460       if p-action = ?
     3461       then do:
     3462         if v-diasize-need-maximize = true
     3463         then do:
     3464           assign
     3465             p-action = true
     3466           .
     3467         end.
     3468         else do:
     3469           assign
     3470             p-action = false
     3471           .
     3472         end.
     3473       end.
     3474       if p-action = true
     3475       then do:
     3476         run diasize_change-height in this-procedure
     3477           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3478               - frame Dialog-Frame :height-chars
     3479           ,input true
     3480           ) .
     3481         run diasize_change-width in this-procedure
     3482           (input session :width-chars
     3483               - frame Dialog-Frame :width-chars
     3484           ,input true
     3485           ) .
     3486         assign
     3487           v-diasize-need-maximize = false
     3488         .
     3489       end.
     3490       else do:
     3491         run diasize_change-width in this-procedure
     3492           (input v-diasize-orig-frame-width
     3493               - frame Dialog-Frame :width-chars
     3494           ,input true
     3495           ) .
     3496         run diasize_change-height in this-procedure
     3497           (input v-diasize-orig-frame-height
     3498               - frame Dialog-Frame :height-chars
     3499           ,input true
     3500           ) .
     3501         assign
     3502           v-diasize-need-maximize = true
     3503         .
     3504       end.
     3505     end.
     3506   end procedure.
     3507   procedure diasize_restore-orig-size :
     3508     do
     3509     on error undo, return error return-value
     3510     :
     3511       assign
     3512         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3513         v-diasize-current-frame-height = frame Dialog-Frame :height
     3514       .
     3515       run diasize_set-height in this-procedure
     3516         (input  v-diasize-orig-frame-height
     3517         ,input  true
     3518         ) .
     3519       run diasize_set-width in this-procedure
     3520         (input  v-diasize-orig-frame-width
     3521         ,input  true
     3522         ) .
     3523     end.
     3524   end procedure.
     3525   procedure diasize_restore-current-size :
     3526     do
     3527     on error undo, return error return-value
     3528     :
     3529       run diasize_set-height in this-procedure
     3530         (input  v-diasize-current-frame-height
     3531         ,input  true
     3532         ) .
     3533       run diasize_set-width in this-procedure
     3534         (input  v-diasize-current-frame-width
     3535         ,input  true
     3536         ) .
     3537     end.
     3538   end procedure.
     3539   procedure diasize_set-browse-handle :
     3540     define input  parameter p-browse-handle as handle   no-undo .
     3541     define buffer buf_temp-browse-handle for temp-browse-handle .
     3542     do
     3543     on error undo, return error return-value
     3544     :
     3545       assign
     3546         v-diasize-browse-handle = p-browse-handle
     3547       .
     3548       for each buf_temp-browse-handle
     3549       on error undo, return error return-value
     3550       :
     3551         delete buf_temp-browse-handle .
     3552       end.
     3553     end.
     3554   end procedure.
     3555   procedure diasize_add_browse :
     3556     define input  parameter p-browse-type   as character no-undo .
     3557     define input  parameter p-browse-handle as handle    no-undo .
     3558     define buffer buf_temp-browse-handle for temp-browse-handle .
     3559     do
     3560     on error undo, return error return-value
     3561     :
     3562       assign
     3563         v-diasize-browse-number = v-diasize-browse-number + 1
     3564       .
     3565       create buf_temp-browse-handle .
     3566       assign
     3567         buf_temp-browse-handle.browse-type   = p-browse-type
     3568         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3569         buf_temp-browse-handle.browse-handle = p-browse-handle
     3570       .
     3571     end.
     3572   end procedure.
     3573   procedure diasize_init :
     3574     define variable v-default-value    as logical   no-undo .
     3575     define variable v-restore-saved    as logical   no-undo .
     3576     define variable v-resize-value-str as character no-undo .
     3577     do
     3578     on error undo, return error return-value
     3579     :
     3580       do with frame Dialog-Frame
     3581       :
     3582         assign
     3583           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3584           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3585           v-diasize-browse-handle     = browse BR-lines :handle
     3586         .
     3587         create button v-diasize-resize-button
     3588         assign
     3589           parent        = frame Dialog-Frame :first-child
     3590           label         = "s"
     3591           height-pixels = 16
     3592           width-pixels  = 16
     3593           visible       = true
     3594           sensitive     = true
     3595           movable       = true
     3596           triggers:
     3597             on end-move persistent run diasize_end-move in this-procedure .
     3598           end triggers.
     3599         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3600         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3601         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3602         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3603         assign
     3604           v-diasize-wndmax = false
     3605         .
     3606         if connected("ub") = true
     3607         then do:
     3608           define variable v-cntxt-db-num        as integer   no-undo .
     3609           define variable v-cntxt-userid        as character no-undo .
     3610           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3611                                             , OUTPUT v-cntxt-userid
     3612                                             ) .
     3613           run gbl/wndpar_r.p
     3614             (input  v-cntxt-db-num
     3615             ,input  v-cntxt-userid
     3616             ,input  'wndmax':U
     3617             ,output v-diasize-wndmax
     3618             ,output v-default-value
     3619             ) .
     3620         end.
     3621         assign
     3622           v-diasize-wndstore = false
     3623         .
     3624         if connected("ub") = true
     3625         then do:
     3626           run gbl/wndpar_r.p
     3627             (input  v-cntxt-db-num
     3628             ,input  v-cntxt-userid
     3629             ,input  'wndstore':U
     3630             ,output v-diasize-wndstore
     3631             ,output v-default-value
     3632             ) .
     3633         end.
     3634         assign
     3635           v-diasize-proc-name = entry(1, program-name(2), '.')
     3636         .
     3637         if v-diasize-wndstore = true
     3638         then do:
     3639           assign
     3640             v-restore-saved = false
     3641           .
     3642           if connected("ub") = true
     3643           then do:
     3644             run gbl/wndsizer.p
     3645               (input  v-cntxt-db-num
     3646               ,input  v-cntxt-userid
     3647               ,input  v-diasize-proc-name
     3648               ,input  'height':u
     3649               ,output v-resize-value-str
     3650               ) .
     3651             if v-resize-value-str <> '':U
     3652             then do:
     3653               run diasize_change-height in this-procedure
     3654                 (input  integer(v-resize-value-str)
     3655                 ,input  true
     3656                 ) .
     3657               assign
     3658                 v-restore-saved = true
     3659               .
     3660             end.
     3661           end.
     3662           if connected("ub") = true
     3663           then do:
     3664             run gbl/wndsizer.p
     3665               (input  v-cntxt-db-num
     3666               ,input  v-cntxt-userid
     3667               ,input  v-diasize-proc-name
     3668               ,input  'width':u
     3669               ,output v-resize-value-str
     3670               ) .
     3671             if v-resize-value-str <> '':U
     3672             then do:
     3673               run diasize_change-width in this-procedure
     3674                 (input  integer(v-resize-value-str)
     3675                 ,input  true
     3676                 ) .
     3677               assign
     3678                 v-restore-saved = true
     3679               .
     3680             end.
     3681           end.
     3682           if v-restore-saved <> true
     3683           then do:
     3684             if v-diasize-wndmax = true
     3685             then do:
     3686               run diasize_maximize in this-procedure
     3687                 (input  true
     3688                 ) .
     3689             end.
     3690           end.
     3691         end.
     3692         else do:
     3693           if v-diasize-wndmax = true
     3694           then do:
     3695             run diasize_maximize in this-procedure
     3696               (input  true
     3697               ) .
     3698           end.
     3699         end.
     3700       end.
     3701     end.
     3702   end procedure.
     3703   procedure diasize_need-full-display :
     3704     define output parameter p-need-full-display as logical   no-undo .
     3705     do
     3706     on error undo, return error return-value
     3707     :
     3708       assign
     3709         p-need-full-display = v-diasize-need-full-display
     3710       .
     3711       assign
     3712         v-diasize-need-full-display = false
     3713       .
     3714     end.
     3715   end procedure.
     3716   procedure get-context :
     3717      define output parameter p-db-num as integer          no-undo.
     3718      define output parameter p-user-id as character        no-undo.
     3719      define variable v-login               as character    no-undo.
     3720      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3721      define buffer buf_user-login  for ub.user-login .
     3722      do
     3723      on error undo, return error
     3724      :
     3725            FIND FIRST buf_sys-ctrl no-lock.
     3726            ASSIGN
     3727               v-login = USERID("ub")
     3728               p-db-num = buf_sys-ctrl.db-num
     3729            .
     3730            FIND FIRST buf_user-login
     3731                 WHERE buf_user-login.db-num = p-db-num
     3732                   AND buf_user-login.user-login = v-login
     3733                 no-lock
     3734                 no-error
     3735                 .
     3736            IF AVAILABLE buf_user-login
     3737            THEN DO:
     3738               assign
     3739                  p-user-id = buf_user-login.user-id
     3740               .
     3741            END.
     3742      end.
     3743   end procedure.
     3744       run diasize_init in this-procedure .
     3745   on "END-ERROR":U, stop of frame Dialog-Frame do:
     3746     apply "choose" to b-quit in frame Dialog-Frame.
     3747   end.
     3748   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3749     run mainmenu_getcntxt in parparentproc
     3750       (output v-cntxt-db-num
     3751       ,output v-cntxt-userid
     3752       ,output v-cntxt-level
     3753       ,output v-cntxt-host-code-obj
     3754       ,output v-cntxt-obj-type
     3755       ,output v-cntxt-obj-code
     3756       ,output v-cntxt-db-num-obj
     3757       ,output v-cntxt-is-admin
     3758       ) .
     3759   p-next-prev = '':U.
     3760   n-p: do while p-next-prev = '':U :
     3761   on leave of tt-wth-doc.shift-date in frame Dialog-Frame do:
     3762     if input frame Dialog-Frame tt-wth-doc.shift-date <> tt-wth-doc.shift-date then do:
     3763       assign
     3764         tt-wth-doc.shift-name = ""
     3765         tt-wth-doc.shift-num  = 0.
     3766       display tt-wth-doc.shift-name tt-wth-doc.shift-num with frame Dialog-Frame.
     3767       apply "entry" to tt-wth-doc.shift-name in frame Dialog-Frame.
     3768       return no-apply.
     3769     end.
     3770   end.
     3771   on return of tt-wth-doc.shift-date in frame Dialog-Frame do:
     3772     apply "entry" to tt-wth-doc.shift-name in frame Dialog-Frame.
     3773     return no-apply.
     3774   end.
     3775   on return of tt-wth-doc.shift-name in frame Dialog-Frame do:
     3776     apply "entry" to b-add in frame Dialog-Frame.
     3777     return no-apply.
     3778   end.
     3779   on return of tt-wth-doc.shift-num in frame Dialog-Frame do:
     3780     apply "entry" to b-add in frame Dialog-Frame.
     3781     return no-apply.
     3782   end.
     3783   on leave of tt-wth-doc.shift-num  in frame Dialog-Frame do:
     3784     if not available tt-wth-doc then return .
     3785     run proc-shift-num no-error.
     3786     if error-status:error then do:
     3787       return no-apply.
     3788     end.
     3789   end.
     3790   on leave of tt-wth-doc.shift-name in frame Dialog-Frame do:
     3791   if not available tt-wth-doc then return .
     3792     run proc-shift-name no-error.
     3793     if error-status:error then do:
     3794       return no-apply.
     3795     end.
     3796   end.
     3797   MAIN-BLOCK:
     3798   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3799      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3800       if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
     3801           message vss-workfile vss-revision vss-description skip
     3802                       "Неверный параметр вызова par-mode"
     3803           view-as alert-box ERROR.
     3804           return error.
     3805       end.
     3806       if not par-mode = 'ПРОСМОТР':U then
     3807       p-next-prev = "QUIT".
     3808       find first ub.sysconf No-LOCK WHERE
     3809                        ub.sysconf.host-code = parhost-code No-ERROR.
     3810       if not avail ub.sysconf then do:
     3811           message vss-workfile vss-revision vss-description skip
     3812                           "Неверный параметр вызова parhost-code"
     3813               view-as alert-box ERROR.
     3814               return error.
     3815       end.
     3816       find first ub.clients No-LOCK WHERE
     3817                   ub.clients.obj-type = parobj-type AND
     3818                   ub.clients.obj-code = parobj-code No-ERROR.
     3819       if not avail ub.clients then do:
     3820           message vss-workfile vss-revision vss-description skip
     3821                           "Неверный параметр вызова parobj-type/parobj-code"
     3822               view-as alert-box ERROR.
     3823               return error.
     3824       end.
     3825       if parcli-type <> '':U or parcli-code <> 0 then do:
     3826           find first ub.clients No-LOCK WHERE
     3827                       ub.clients.obj-type = parcli-type AND
     3828                       ub.clients.obj-code = parcli-code No-ERROR.
     3829           if not avail ub.clients then do:
     3830               message vss-workfile vss-revision vss-description skip
     3831                               "Неверный параметр вызова parcli-type/parcli-code"
     3832                   view-as alert-box ERROR.
     3833                   return error.
     3834           end.
     3835       end.
     3836       if LOOKUP(parext-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u) = 0 then do:
     3837               message vss-workfile vss-revision vss-description skip
     3838                               "Неверный параметр вызова parext-type"
     3839                   view-as alert-box ERROR.
     3840                   return error.
     3841       end.
     3842       tt-wth-doc.cli-type:list-items = 'орг':U + chr(44) +
     3843                                       'чел':U + chr(44) +
     3844                                       'маг':U + chr(44) +
     3845                                       'скл':U + chr(44).
     3846       tt-wth-doc.obj-type:list-items = 'орг':U + chr(44) +
     3847                                       'чел':U + chr(44) +
     3848                                       'маг':U + chr(44) +
     3849                                       'скл':U + chr(44).
     3850     Run fill-tables no-error.
     3851     if error-status:error then return error.
     3852     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     3853       if  parobj-type <> tt-wth-doc.obj-type
     3854       or parobj-code <> tt-wth-doc.obj-code then do:
     3855               message vss-workfile vss-revision vss-description skip
     3856                  "Документ может быть изменен только на активной стороне!"
     3857                   view-as alert-box ERROR.
     3858                   return error.
     3859       end.
     3860     end.
     3861     RUN Myenable.
     3862     WAIT-FOR GO OF FRAME Dialog-Frame.
     3863   END.
     3864   end.
     3865   RUN disable_UI.
     3866   PROCEDURE chk-upd-date :
     3867   define input parameter parself-name as character no-undo.
     3868   define variable v-today as date      no-undo.
     3869   define variable v-time  as integer   no-undo.
     3870   if input frame Dialog-Frame tt-wth-doc.fact-date  <> tt-wth-doc.fact-date  or
     3871      input frame Dialog-Frame tt-wth-doc.shift-date <> tt-wth-doc.shift-date or
     3872      input frame Dialog-Frame tt-wth-doc.shift-num  <> tt-wth-doc.shift-num then do:
     3873   if parself-name = "fact-date" then do:
     3874   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3876     (input  v-cntxt-obj-type
     3877     ,input  v-cntxt-obj-code
     3878     ,output v-today
     3879     )  .
     3880     if input frame Dialog-Frame tt-wth-doc.fact-date > v-today then do:
     3881        message "Фактическая Дата документа не должна быть больше сегодняшней даты на объекте." view-as alert-box error.
     3882        display tt-wth-doc.fact-date with frame Dialog-Frame.
     3883        return error.
     3884     end.
     3885     assign glog = no.
     3886   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3887   do:
     3888     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3889       (input  v-cntxt-db-num
     3890       ,input  v-cntxt-userid
     3891       ,input  0
     3892       ,input  'actn_wth-doc_create-back-shift':U
     3893       ,input  'object':U
     3894       ,input  tt-wth-doc.host-code
     3895       ,input  tt-wth-doc.obj-type
     3896       ,input  tt-wth-doc.obj-code
     3897       ,input  0
     3898       ,input  0
     3899       ,input  0
     3900       ,input  true
     3901       ,output glog
     3902       )  .
     3903   end.
     3904     if glog = no then do:
     3905        display tt-wth-doc.fact-date with frame Dialog-Frame.
     3906        return error.
     3907     end.
     3908   end.
     3909   assign frame Dialog-Frame
     3910     tt-wth-doc.fact-date
     3911     tt-wth-doc.shift-date
     3912     tt-wth-doc.shift-num
     3913     tt-wth-doc.shift-name.
     3914   assign tt-wth-doc.fact-time = (24 * 60 * 60).
     3915   end.
     3916   END PROCEDURE.
     3917   PROCEDURE control-doc :
     3918   assign
     3919   tt-wth-doc.doc-sum = bf_wth-doc.doc-sum
     3920   tt-wth-doc.fact-sum = bf_wth-doc.fact-sum
     3921   tt-wth-doc.sum-gds-rubl = bf_wth-doc.sum-gds-rubl
     3922   tt-wth-doc.sum-gds-base = bf_wth-doc.sum-gds-base
     3923   .
     3924   DISPLAY
     3925   tt-wth-doc.doc-sum
     3926   tt-wth-doc.sum-gds-rubl
     3927   tt-wth-doc.sum-gds-base
     3928   tt-wth-doc.fact-sum when lookup(tt-wth-doc.ext-doc-type, 'de':U) = 0
     3929   with frame Dialog-Frame .
     3930   run control-line in this-procedure ( output lock-doc).
     3931   run lock-proc in this-procedure (input lock-doc).
     3932   END PROCEDURE.
     3933   PROCEDURE control-line :
     3934   DEFINE OUTPUT PARAMETER lock-doc as logical no-undo.
     3935   IF CAN-FIND(FIRST ub.wth-line No-LOCK WHERE
     3936                     ub.wth-line.doc-code = tt-wth-doc.doc-code) then do:
     3937    lock-doc = yes.
     3938   end.
     3939   else do:
     3940    lock-doc = no.
     3941   end.
     3942   END PROCEDURE.
     3943   PROCEDURE control-out :
     3944    IF INPUT FRAME Dialog-Frame tt-wth-doc.cli-type = 'чел':U   OR
     3945       INPUT FRAME Dialog-Frame tt-wth-doc.cli-type = 'орг':U
     3946       or tt-wth-doc.ext-doc-type = 'ps':U  THEN DO:
     3947       DISABLE
     3948       for-out-w-p-code
     3949       B-out
     3950       WITH FRAME Dialog-Frame.
     3951       HIDE
     3952       for-out-w-p-code IN FRAME Dialog-Frame
     3953       for-out-w-p-name IN FRAME Dialog-Frame
     3954       B-out    IN FRAME Dialog-Frame
     3955       .
     3956       locked-out = yes.
     3957     END.
     3958     ELSE IF (INPUT FRAME Dialog-Frame tt-wth-doc.cli-type = 'маг':U  OR
     3959             INPUT FRAME Dialog-Frame tt-wth-doc.cli-type = 'скл':U)
     3960             and not tt-wth-doc.ext-doc-type = 'ps':U THEN DO:
     3961       DISPLAY
     3962       for-out-w-p-code WITH FRAME Dialog-Frame.
     3963       ENABLE
     3964       for-out-w-p-code
     3965       B-out
     3966       WITH FRAME Dialog-Frame.
     3967       locked-out = no.
     3968     END.
     3969   END PROCEDURE.
     3970   PROCEDURE disable_UI :
     3971     HIDE FRAME Dialog-Frame.
     3972   END PROCEDURE.
     3973   PROCEDURE enable_UI :
     3974     DISPLAY for-current-w-p-code for-out-w-p-code f-atrDSF f-atrNSF f-atrPaydoc
     3975             f-atrReceiver f-atrproxy for-object for-current-w-p-name
     3976             for-out-w-p-name operator-name deliver-name receiver-name
     3977         WITH FRAME Dialog-Frame.
     3978     IF AVAILABLE tt-wth-doc THEN
     3979       DISPLAY tt-wth-doc.doc-code tt-wth-doc.doc-date tt-wth-doc.fact-date
     3980             tt-wth-doc.shift-date tt-wth-doc.shift-name tt-wth-doc.shift-num
     3981             tt-wth-doc.obj-type tt-wth-doc.obj-code tt-wth-doc.cli-type
     3982             tt-wth-doc.cli-code tt-wth-doc.doc-sum tt-wth-doc.fact-sum
     3983             tt-wth-doc.sum-gds-rubl tt-wth-doc.sum-gds-base tt-wth-doc.operator
     3984             tt-wth-doc.deliver tt-wth-doc.receiver tt-wth-doc.cli-name
     3985         WITH FRAME Dialog-Frame.
     3986     ENABLE B-exit b-quit B-bind B-prev B-next B-Help tt-wth-doc.doc-date
     3987            tt-wth-doc.fact-date tt-wth-doc.shift-date tt-wth-doc.shift-name
     3988            tt-wth-doc.shift-num r-sht tt-wth-doc.obj-code for-current-w-p-code
     3989            B-current tt-wth-doc.cli-type tt-wth-doc.cli-code B-cli
     3990            for-out-w-p-code B-out tt-wth-doc.doc-sum tt-wth-doc.operator
     3991            B-operator B-shcfact B-deliver tt-wth-doc.deliver tt-wth-doc.receiver
     3992            B-receiver BR-lines B-add B-lookup B-del B-chk B-bar B-barRange
     3993            B-allZone B-hist for-object for-current-w-p-name tt-wth-doc.cli-name
     3994            for-out-w-p-name operator-name deliver-name receiver-name
     3995         WITH FRAME Dialog-Frame.
     3996     VIEW FRAME Dialog-Frame.
     3997   END PROCEDURE.
     3998   PROCEDURE fill-tables :
     3999   for each tt-wth-doc:
     4000       delete tt-wth-doc.
     4001   end.
     4002   IF par-mode = 'ДОБАВЛЕНИЕ':U then do:
     4003      run gbl/factdate.p (
     4004                        INPUT        parobj-type
     4005                       ,INPUT        parobj-code
     4006                       ,INPUT-OUTPUT f-date
     4007                       ,INPUT-OUTPUT f-time
     4008                       ,INPUT-OUTPUT s-date
     4009                       ,INPUT-OUTPUT s-num
     4010                       ,INPUT-OUTPUT s-name
     4011                       ,INPUT        YES
     4012                         ) NO-ERROR.
     4013       IF ERROR-STATUS:ERROR THEN DO:
     4014         return error.
     4015       END.
     4016       DO TRANSACTION ON ERROR UNDO, RETURN ERROR:
     4017   define variable l-in-ov31 as logical no-undo .
     4018   define variable v-date31 as date no-undo .
     4019   define variable v-time31 as integer no-undo .
     4020   run cur-time in this-procedure(output v-date31, output v-time31).
     4021   CREATE tt-wth-doc.
     4022   ASSIGN
     4023     tt-wth-doc.host-code = parhost-code
     4024     tt-wth-doc.doc-code  = TRIM( STRING( NEXT-VALUE( s-wth-doc, ub), ">>>>>>>>>9":U ) ) + "-" + TRIM( STRING( parobj-code, ">>>>>>>>9":U ) ) +                   SUBSTR( parobj-type, ( IF g#language = "RUS" THEN 1 ELSE 2 ), 1 )
     4025      tt-wth-doc.doc-type  = par-type
     4026     tt-wth-doc.ext-doc-type  = parext-type
     4027     tt-wth-doc.inter_    = if  lookup(tt-wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
     4028     tt-wth-doc.exter_    = if  lookup(tt-wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
     4029     tt-wth-doc.status_   = 'накл':U
     4030     tt-wth-doc.obj-type  = parobj-type
     4031     tt-wth-doc.obj-code  = parobj-code
     4032     tt-wth-doc.creid     = v-cntxt-userid
     4033     tt-wth-doc.credate   = v-date31
     4034   .
     4035   if tt-wth-doc.doc-type = 'инв':U or lookup(tt-wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
     4036      or tt-wth-doc.doc-type = 'декл':U then do:
     4037     assign
     4038       tt-wth-doc.cli-type  = 'орг':U
     4039       tt-wth-doc.cli-code  = parhost-code
     4040       .
     4041   end.
     4042   else if tt-wth-doc.ext-doc-type = 'ps':U then do:
     4043     assign
     4044     tt-wth-doc.cli-type  = parobj-type
     4045     tt-wth-doc.cli-code  = parobj-code
     4046     .
     4047   end.
     4048   else if tt-wth-doc.inter_  = yes
     4049   then do:
     4050     assign
     4051     tt-wth-doc.cli-type  = parobj-type
     4052     tt-wth-doc.cli-code  = parobj-code
     4053     .
     4054   end.
     4055   else if tt-wth-doc.exter_  = yes
     4056   then do:
     4057     assign
     4058     tt-wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
     4059     tt-wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
     4060     .
     4061   end.
     4062   else assign
     4063       tt-wth-doc.cli-type  = parobj-type
     4064       tt-wth-doc.cli-code  = 0
     4065   .
     4066         ASSIGN
     4067         tt-wth-doc.shift-date = s-date
     4068         tt-wth-doc.shift-num  = s-num
     4069         tt-wth-doc.shift-name = s-name
     4070         tt-wth-doc.doc-date   = f-date
     4071         tt-wth-doc.fact-date  = if (lookup(tt-wth-doc.ext-doc-type,'ii,fj,jj,pj,oj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,xc':U) > 0 and s-num <> 0) then s-date else f-date
     4072         tt-wth-doc.auto-fill = parauto-fill
     4073         .
     4074   define variable l-in-ov32 as logical no-undo .
     4075   define variable v-date32 as date no-undo .
     4076   define variable v-time32 as integer no-undo .
     4077   run cur-time in this-procedure(output v-date32, output v-time32).
     4078   CREATE bf_wth-doc.
     4079   ASSIGN
     4080     bf_wth-doc.host-code = parhost-code
     4081     bf_wth-doc.doc-code  = tt-wth-doc.doc-code
     4082      bf_wth-doc.doc-type  = par-type
     4083     bf_wth-doc.ext-doc-type  = parext-type
     4084     bf_wth-doc.inter_    = if  lookup(bf_wth-doc.ext-doc-type,'ij,pj,fj,jj,oj,ej':U) > 0 then yes else no
     4085     bf_wth-doc.exter_    = if  lookup(bf_wth-doc.ext-doc-type,'ie,ee,we,pc,ps,iy,pz,df,dp,dc,xc':U) > 0 then yes else no
     4086     bf_wth-doc.status_   = 'накл':U
     4087     bf_wth-doc.obj-type  = parobj-type
     4088     bf_wth-doc.obj-code  = parobj-code
     4089     bf_wth-doc.creid     = v-cntxt-userid
     4090     bf_wth-doc.credate   = v-date32
     4091   .
     4092   if bf_wth-doc.doc-type = 'инв':U or lookup(bf_wth-doc.ext-doc-type, 'we,dc,dp,df':U) > 0
     4093      or bf_wth-doc.doc-type = 'декл':U then do:
     4094     assign
     4095       bf_wth-doc.cli-type  = 'орг':U
     4096       bf_wth-doc.cli-code  = parhost-code
     4097       .
     4098   end.
     4099   else if bf_wth-doc.ext-doc-type = 'ps':U then do:
     4100     assign
     4101     bf_wth-doc.cli-type  = parobj-type
     4102     bf_wth-doc.cli-code  = parobj-code
     4103     .
     4104   end.
     4105   else if bf_wth-doc.inter_  = yes
     4106   then do:
     4107     assign
     4108     bf_wth-doc.cli-type  = parobj-type
     4109     bf_wth-doc.cli-code  = parobj-code
     4110     .
     4111   end.
     4112   else if bf_wth-doc.exter_  = yes
     4113   then do:
     4114     assign
     4115     bf_wth-doc.cli-type  =  (if parcli-type <> "" then parcli-type else 'орг':U)
     4116     bf_wth-doc.cli-code  =  (if parcli-code <> 0 then parcli-code else 0)
     4117     .
     4118   end.
     4119   else assign
     4120       bf_wth-doc.cli-type  = parobj-type
     4121       bf_wth-doc.cli-code  = 0
     4122   .
     4123         ASSIGN
     4124         bf_wth-doc.shift-date = s-date
     4125         bf_wth-doc.shift-num  = s-num
     4126         bf_wth-doc.shift-name = s-name
     4127         bf_wth-doc.doc-date   = f-date
     4128         bf_wth-doc.auto-fill = parauto-fill
     4129         v-doc-rec = recid(bf_wth-doc)
     4130         .
     4131         if parauto-fill = yes and lookup(parext-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and
     4132           not (par-mode = 'ПРОСМОТР':U) then do:
     4133           assign
     4134           locked-inter_ = yes
     4135           .
     4136         end.
     4137       END.
     4138   end.
     4139   else do:
     4140     if par-mode = 'ПРОСМОТР':U then do:
     4141       FIND FIRST bf_wth-doc NO-LOCK WHERE
     4142                   recid(bf_wth-doc) = p-doc-rec.
     4143     end.
     4144     ELSE do:
     4145       DO TRANSACTION
     4146         ON ERROR UNDO, RETURN ERROR:
     4147         FIND FIRST bf_wth-doc EXCLUSIVE-LOCK WHERE
     4148                    recid(bf_wth-doc) = p-doc-rec.
     4149       END.
     4150     END.
     4151     IF NOT AVAIL bf_wth-doc then
     4152     return error.
     4153     v-doc-rec = p-doc-rec.
     4154     if bf_wth-doc.status_ = 'факт':U and par-mode <> 'ПРОСМОТР':U then do:
     4155        message "Документ движения МЦ с N" bf_wth-doc.doc-code  "имеет статус" bf_wth-doc.status_ SKIP
     4156                         "Изменения не допускаются"
     4157           view-as alert-box error.
     4158           return error.
     4159       end.
     4160     create tt-wth-doc.
     4161     buffer-copy bf_wth-doc to tt-wth-doc.
     4162       FIND FIRST buf_wth-line No-LOCK where
     4163                  BUF_WTH-LINE.DOC-CODE = TT-WTH-DOC.doc-code nO-ERROR.
     4164       if avail buf_wth-line then do:
     4165         for-current-w-p-code =  buf_wth-line.w-p-code.
     4166         for-out-w-p-code =  buf_wth-line.out-code.
     4167       end.
     4168       CASE tt-wth-doc.source-type:
     4169         when 'док.МЦ':U then do:
     4170           FIND FIRST bind_wth-doc NO-LOCK WHERE
     4171                      bind_wth-doc.doc-code = tt-wth-doc.source-ref NO-ERROR.
     4172         end.
     4173         when 'касса':U then do:
     4174           FIND FIRST bind_inkas NO-LOCK WHERE
     4175                      bind_inkas.inkas-code = tt-wth-doc.source-ref NO-ERROR.
     4176         end.
     4177       END CASE.
     4178       IF (tt-wth-doc.source-type = 'док.МЦ':U and AVAIL bind_wth-doc) OR
     4179          (tt-wth-doc.source-type = 'касса':U and AVAIL bind_inkas)
     4180          THEN DO:
     4181         ASSIGN
     4182         B-Bind:TOOLTIP
     4183         IN FRAME Dialog-Frame = "Связан с " + tt-wth-doc.source-type + chr(32) + tt-wth-doc.source-ref.
     4184       END.
     4185       ELSE DO:
     4186         ASSIGN
     4187         B-Bind:TOOLTIP
     4188         IN FRAME Dialog-Frame = "":U.
     4189       END.
     4190   end.
     4191   if tt-wth-doc.auto-fill = yes and par-mode <> 'ПРОСМОТР':U then do:
     4192   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4193   run gbl/lock-prc.p
     4194       (input 'awth':U
     4195       ,input parobj-code
     4196       ,input 0
     4197       ,input 0
     4198       ,input parobj-type
     4199       ,input ""
     4200       ,input ""
     4201       ,input (
     4202                "Код объекта" + ",,," +
     4203                "Тип объекта" +  ",,,Формирование автоматических документов МЦ"
     4204              )
     4205       ,input true
     4206       ,buffer auto-wth-doc-lock_batchprocess
     4207       ) no-error .
     4208     if error-status :error then do:
     4209       message
     4210         vss-workfile vss-revision vss-description skip
     4211         "В данный момент уже производится формирование автоматических документов МЦ" skip
     4212         view-as alert-box error .
     4213       undo, return error .
     4214     end.
     4215   end.
     4216   END PROCEDURE.
