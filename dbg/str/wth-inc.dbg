     1833       "Процедура" this-procedure :file-name skip
     1834       view-as alert-box .
     1835   end.
     1836   else do:
     1837     apply "entry":u to self  .
     1838     if focus :handle <> self :handle  then do:
     1839       return no-apply .
     1840     end.
