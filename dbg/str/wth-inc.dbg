     2145   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2146   DO:
     2147   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2148   if lookup(self :type
     2149            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2150            ) = 0
     2151   then do:
     2152     message
     2153       "$Workfile$"
     2154       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2155       "Интерфейсный элемент" self :name  skip
     2156       "Тип" self :type  skip
     2157       "Процедура" this-procedure :file-name skip
     2158       view-as alert-box .
     2159   end.
     2160   else do:
     2161     apply "entry":u to self  .
     2162     if focus :handle <> self :handle  then do:
     2163       return no-apply .
     2164     end.
     2165   end.
     2166       IF par-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2167       IF CAN-FIND( FIRST ub.wth-line NO-LOCK WHERE
     2168                          ub.wth-line.doc-code = bf_wth-doc.doc-code ) THEN DO:
     2169         MESSAGE
     2170           "Документ не будет сохранен, а вся введенная Вами информация будет потеряна!" SKIP
     2171           "Для того, чтобы сохранить документ, нужно нажать кнопку ~"" +
     2172           B-exit:LABEL IN FRAME Dialog-Frame + "~"." SKIP( 1 )
     2173           "Вы уверены, что хотите выйти БЕЗ СОХРАНЕНИЯ?" SKIP
     2174           "YES[ДА] - Выйти БЕЗ СОХРАНЕНИЯ;" SKIP
     2175           "NO[НЕТ] - Остаться в документе."
     2176         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO
     2177         TITLE "Выход из документа без сохранения" UPDATE glog.
     2178         IF glog = NO THEN DO:
     2179           RETURN NO-APPLY.
     2180         END.
     2181       END.
     2182       DO TRANSACTION ON ERROR UNDO, LEAVE :
     2183         FIND CURRENT bf_wth-doc EXCLUSIVE-LOCK.
     2184         DELETE bf_wth-doc.
     2185         p-doc-rec = ?.
     2186       END.
     2187     END.
     2188     define variable v-atrValue    as character no-undo .
     2189     define variable v-atrType     as character no-undo .
     2190     define variable v-value-character as character no-undo .
     2191     define variable v-value-date as date no-undo .
     2192     define variable v-value-decimal as decimal no-undo .
     2193     define variable v-value-integer as INTEGER no-undo .
     2194     define variable v-value-logical AS LOGICAL no-undo .
     2195     define variable v-param-type as character no-undo .
     2196     define variable v-stfactpref as character no-undo .
     2197     define variable v-numsfact   as integer no-undo .
     2198     if f-atrNSF <> f-atrNsf:screen-value then do:
     2199     v-atrValue =  f-atrNsf:screen-value.
     2200     run adm/shattri.p (
     2201           input "get":U
     2202           ,input  tt-wth-doc.obj-type
     2203           ,input  tt-wth-doc.obj-code
     2204           ,input  'wthdoc_obj':U
     2205           ,input  '':U
     2206           ,output v-value-character
     2207           ,output v-value-date
     2208           ,output v-value-decimal
     2209           ,output v-value-integer
     2210           ,output v-value-logical
     2211           ,output v-param-type
     2212           ,INPUT-OUTPUT table-handle v-tth
     2213           ) no-error .
     2214       IF not error-status:error  then do:
     2215         for each thbjattr_thbj-attr no-lock:
     2216           if thbjattr_thbj-attr.prop-code = 'stfactpref':U then v-stfactpref = thbjattr_thbj-attr.property-value-character.
     2217           if thbjattr_thbj-attr.prop-code = 'numsfact':U then v-numsfact = thbjattr_thbj-attr.property-value-integer.
     2218         end.
     2219       end.
     2220       if v-atrValue = v-stfactpref + string(v-numsfact) then do:
     2221         v-numsfact = v-numsfact - 1.
     2222         RUN thbjattr_write IN THIS-PROCEDURE (
     2223               input tt-wth-doc.obj-type
     2224             ,input tt-wth-doc.obj-code
     2225             ,input 'wthdoc_obj':U
     2226             ,input 'numsfact':U
     2227             ,input '':U
     2228             ,input ?
     2229             ,input 0
     2230             ,input v-numsfact
     2231             ,input no
     2232         ) NO-ERROR.
     2233         IF ERROR-STATUS:error THEN do:
     2234           MESSAGE ERROR-STATUS:get-message(1)  SKIP
     2235           RETURN-VALUE
     2236           VIEW-AS ALERT-BOX warning.
     2237         END.
     2238       end.
     2239     end.
     2240      p-next-prev = "QUIT".
     2241   END.
     2242   ON CHOOSE OF B-receiver IN FRAME Dialog-Frame
     2243   DO:
