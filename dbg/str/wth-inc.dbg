     1842   define variable v_rid as character no-undo.
     1843   define variable ref-rec as recid no-undo .
     1844   v_rid = "":U.
     1845     run ref/wthplref.w (
     1846                      input parparentproc
     1847                     ,INPUT "b-sel":U
     1848                     ,INPUT tt-wth-doc.host-code
     1849                     ,INPUT tt-wth-doc.obj-type
     1850                     ,INPUT tt-wth-doc.obj-code
     1851                     ,input 'объект':U
     1852                     ,input-OUTPUT v_rid ).
     1853       IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1854       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1855       IF ERROR-STATUS:ERROR THEN DO:
     1856           RETURN NO-APPLY.
     1857       END.
     1858       FIND FIRST current-place NO-LOCK WHERE
     1859                         RECID( current-place ) = ref-rec NO-ERROR.
     1860       IF AVAIL current-place THEN DO:
     1861         if tt-wth-doc.auto-fill and current-place.cash-desk = 0 then do:
     1862           message
     1863           "Для автоматического документа место хранения должно быть кассой"
     1864           view-as alert-box error.
     1865           return no-apply.
     1866         end.
     1867         DISPLAY
     1868         current-place.w-p-code @ for-current-w-p-code
     1869         current-place.w-p-name @ for-current-w-p-name
     1870          WITH FRAME Dialog-Frame.
     1871       END.
     1872       ELSE DO:
     1873           RETURN NO-APPLY.
     1874       END.
     1875     END.
     1876     ELSE DO:
     1877       RETURN NO-APPLY.
     1878     END.
     1879   END.
