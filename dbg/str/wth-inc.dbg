     1947       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1948       "Интерфейсный элемент" self :name  skip
     1949       "Тип" self :type  skip
     1950       "Процедура" this-procedure :file-name skip
     1951       view-as alert-box .
     1952   end.
     1953   else do:
     1954     apply "entry":u to self  .
     1955     if focus :handle <> self :handle  then do:
     1956       return no-apply .
     1957     end.
     1958   end.
     1959     if not avail buf_wth-line then return no-apply.
     1960   END.
     1961   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1962   DO:
     1963   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
