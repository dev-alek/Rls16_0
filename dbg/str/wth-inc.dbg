     1651     run proc-save-doc in this-procedure ( input no) No-ERROR.
     1652     ASSIGN
     1653     v-line-rec = RECID( buf_wth-line )
     1654     v-doc-rec = recid(bf_wth-doc)
     1655     FOR-CURRENT-W-P-CODE
     1656     FOR-OUT-W-P-CODE
     1657     .
     1658     if error-status:error
     1659     or return-value = 'error'
     1660     then return no-apply.
     1661     run str/wth-inca.w (
     1662                       input parparentproc
     1663                      ,INPUT parhost-code
     1664                      ,INPUT parobj-type
     1665                      ,INPUT parobj-code
     1666                      ,INPUT 'ИЗМЕНЕНИЕ':U
     1667                      ,input v-doc-rec
     1668                      ,input for-current-w-p-code
     1669                      ,input for-out-w-p-code
     1670                      ,INPUT tt-wth-doc.ext-doc-type
     1671                      ,input-output v-LINE-REC ) .
     1672     ASSIGN
     1673     glog = br-lines:REFRESH( ).
     1674   RUN control-doc NO-ERROR.
     1675     apply "entry" to br-lines.
     1676   END.
     1677   ON CHOOSE OF B-chk IN FRAME Dialog-Frame
     1678   DO:
     1679   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1680   if lookup(self :type
     1681            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1682            ) = 0
     1683   then do:
     1684     message
     1685       "$Workfile$"
     1686       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1687       "Интерфейсный элемент" self :name  skip
     1688       "Тип" self :type  skip
     1689       "Процедура" this-procedure :file-name skip
     1690       view-as alert-box .
