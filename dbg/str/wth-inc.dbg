        1   DEFINE BUFFER buf_clients FOR clients.
        2   DEFINE BUFFER buf_obj FOR clients.
        3   DEFINE BUFFER buf_wth FOR wealth.
        4   DEFINE BUFFER buf_wth-line FOR wth-line.
        5   DEFINE BUFFER current-place FOR wth-place.
        6   DEFINE BUFFER first_wth-line FOR wth-line.
        7   DEFINE BUFFER out-place FOR wth-place.
        8   DEFINE TEMP-TABLE tt-wth-doc NO-UNDO LIKE wth-doc.
        9   DEFINE BUFFER wth-doc FOR wth-doc.
       10   define input parameter parparentproc as widget-handle no-undo .
       11   define input parameter par-mode AS CHARACTER NO-UNDO.
       12   define input parameter parhost-code like ub.sysconf.host-code no-undo.
       13   define input parameter parobj-type like ub.clients.obj-type no-undo.
       14   define input parameter parobj-code like ub.clients.obj-code no-undo.
       15   define input parameter parcli-type like ub.clients.obj-type no-undo.
       16   define input parameter parcli-code like ub.clients.obj-code no-undo.
       17   define input parameter parext-type like ub.wth-doc.ext-doc-type no-undo.
       18   define input parameter par-type like ub.wth-doc.doc-type no-undo.
       19   define input parameter parauto-fill like ub.wth-doc.auto-fill no-undo .
       20   define input-output parameter p-doc-rec as recid no-undo.
       21   define input parameter p-call-prog as handle no-undo .
       22   define input-output parameter p-next-prev as CHARACTER no-undo .
       23   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       24   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       25   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       26   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       27   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       28   define variable vss-description AS CHAR NO-UNDO INIT "перемещение МЦ: добавление, изменение, просмотр":U.
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   procedure proc-alt-shift-f2:
       90     if not ibs.th.gbl.gbl-var:rcode
       91   then
       92     run gbl\inidebug.p .
       93   end.
       94   procedure proc-alt-shift-f3:
       95     run gbl/prvssinf.p
       96       ( input this-procedure
       97       ) .
       98   end.
       99   define variable v-inform-launched as logical no-undo initial false .
      100   procedure proc-alt-shift-f4:
      101     define variable v-action as character no-undo .
      102     if v-inform-launched = false then do:
      103       assign
      104         v-inform-launched = true
      105       .
      106       run gbl/d-inform.w
      107         (  input self
      108         ,  input this-procedure
      109         , output v-action
      110         ) no-error .
      111       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      112       assign
      113         v-inform-launched = false
      114       .
      115     end.
      116   end.
      117   procedure proc-alt-f1:
      118     run gbl/corrhelp.p
      119       (input this-procedure
      120       ) .
      121   end .
      122   on alt-shift-f2 anywhere do:
      123     run proc-alt-shift-f2.
      124   end.
      125   on alt-shift-f3 anywhere do:
      126     run proc-alt-shift-f3 in this-procedure .
      127   end.
      128   on alt-shift-f4 anywhere do:
      129     run proc-alt-shift-f4 in this-procedure.
      130   end.
      131   on alt-f1 anywhere do:
      132     run proc-alt-f1 in this-procedure .
      133   end.
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360     define variable v-cntxt-db-num        as integer   no-undo .
      361     define variable v-cntxt-userid        as character no-undo .
      362     define variable v-cntxt-level         as character no-undo .
      363     define variable v-cntxt-host-code-obj as integer   no-undo .
      364     define variable v-cntxt-obj-type      as character no-undo .
      365     define variable v-cntxt-obj-code      as integer   no-undo .
      366     define variable v-cntxt-db-num-obj    as integer   no-undo .
      367     define variable v-cntxt-is-admin      as logical   no-undo .
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define variable v-waitfram-action01         as character   no-undo .
      370   define variable v-waitfram-action02         as character   no-undo .
      371   define variable v-waitfram-action03         as character   no-undo .
      372   define variable mWaitFramTextBeg            as character   no-undo.
      373   define variable mWaitFramTextEnd            as character   no-undo.
      374   define variable mWaitFramView               as logical     no-undo.
      375   define variable mWaitProcEvent              as logical     no-undo init yes.
      376   define variable mWaitFramInterval           as integer     no-undo init 1 .
      377   define variable mWaitFramStop               as logical     no-undo.
      378   define variable mWaitFramStopUser           as logical     no-undo.
      379   define variable mWaitFramStopTimeOut        as logical     no-undo.
      380   define variable mWaitFramStartProc          as datetime-tz no-undo.
      381   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      382   define button B-WaitFramStop auto-end-key
      383        label "Стоп"
      384        size 10 by 1 tooltip "Остоновить процесс".
      385   define button B-viewProcInfo
      386        label "Информация"
      387        size 15 by 1 tooltip "Информация о процесс".
      388   define frame waitfram
      389     v-waitfram-action01 format "x(72)" no-label skip
      390     v-waitfram-action02 format "x(72)" no-label skip
      391     v-waitfram-action03 format "x(72)" no-label skip
      392     B-viewProcInfo
      393     B-WaitFramStop at row 4 col 30
      394     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      395     .
      396   define new global shared variable mBatchMode as logical no-undo init ?.
      397   define variable mFramBachModHandle as handle no-undo.
      398   mFramBachModHandle = frame waitfram:handle.
      399   define variable mFameOldVis as logical no-undo.
      400   define variable mVisCUrentVin as logical no-undo.
      401   if session:batch-mode
      402   then
      403      mBatchMode = yes.
      404   if mBatchMode = ? then do:
      405     mVisCUrentVin = current-window:visible.
      406     mFameOldVis = mFramBachModHandle:visible.
      407     mFramBachModHandle:visible  = yes.
      408     mBatchMode = mFramBachModHandle:visible ne yes.
      409     mFramBachModHandle:visible = mFameOldVis.
      410     current-window:visible = mVisCUrentVin.
      411   end.
      412    if  log-manager:logfile-name ne ?
      413     then DO:
      414         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      415         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      416         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      417     end.
      418   on choose of B-WaitFramStop in frame waitfram
      419   do:
      420     mWaitFramStop = yes.
      421     mWaitFramStopUser = yes.
      422   end.
      423   function waitfram-check-timeout returns logical():
      424      define variable vtime as int64 no-undo.
      425      if mWaitFramStopTimeOut
      426      then
      427         return yes.
      428      vtime = ( now - mWaitFramStartProc ) / 1000 .
      429      if     mWaitFramTimeOut ne ?
      430         and mWaitFramTimeOut ne 0
      431         and mWaitFramTimeOut lt vtime
      432      then do:
      433         mWaitFramStopTimeOut = yes.
      434      end.
      435      return mWaitFramStopTimeOut.
      436   end.
      437   procedure waitfram-hide :
      438     if not session:batch-mode
      439     then do
      440     on error undo, return error return-value
      441     :
      442       pause 0 before-hide .
      443       if not mBatchMode then
      444         hide frame waitfram .
      445     if     not mWaitFramView
      446        and mWaitProcEvent
      447     then
      448       process events .
      449     end.
      450   end procedure.
      451   procedure waitfram-show :
      452     define input  parameter p-message as character no-undo .
      453     define variable v-left-margin as integer   no-undo .
      454     if not session:batch-mode
      455     then do
      456     on error undo, return error return-value
      457     :
      458       if length(p-message) <= 70 then do:
      459         assign
      460           v-left-margin = integer((70 - length(p-message)) / 2)
      461         .
      462         assign
      463           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      464         .
      465         assign
      466           v-waitfram-action01 = " "
      467           v-waitfram-action02 = " "
      468                                    + fill(" ", v-left-margin)
      469                                    + p-message
      470           v-waitfram-action03 = " "
      471         .
      472       end.
      473       else do:
      474         define variable vRindex1 as integer no-undo.
      475         define variable vRindex2 as integer no-undo.
      476         vRindex1 = r-index(p-message," ",70).
      477         if vRindex1 = 0
      478         then
      479            vRindex1 = 70.
      480         if length(p-message)  <= vRindex1 + 70 then do:
      481           assign
      482             v-waitfram-action01 = " "
      483             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      484             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      485           .
      486         end.
      487         else do:
      488           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      489           if vRindex2 <= vRindex1
      490           then
      491              vRindex2 = vRindex1 + 70.
      492           assign
      493             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      494             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      495             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      496           .
      497         end.
      498       end.
      499       B-viewProcInfo:visible   in frame waitfram = no.
      500       B-viewProcInfo:sensitive in frame waitfram = no.
      501       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      502       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      503       if  (   mWaitFramView
      504          or  mWaitProcEvent)
      505          and not mBatchMode
      506       then
      507          display
      508             v-waitfram-action01 skip
      509             v-waitfram-action02 skip
      510             v-waitfram-action03 skip
      511          with frame waitfram .
      512       if     mWaitFramView
      513          then do:
      514             if     mWaitFramInterval ne ?
      515                and not mBatchMode
      516             then
      517                wait-for go of frame waitfram pause mWaitFramInterval.
      518          end.
      519          else
      520             if     mWaitProcEvent
      521                and not mBatchMode
      522             then
      523                process events .
      524     end.
      525   end procedure.
      526      procedure waitfram-show-this:
      527         define input  parameter iInterval as int64 no-undo.
      528         define variable vtime as int64 no-undo.
      529         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      530         mWaitFramInterval = iInterval.
      531         run waitfram-show (substitute("&1&2 &3&4" ,
      532                                       mWaitFramTextBeg ,
      533                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      534                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      535                                       mWaitFramTextEnd
      536                                      )
      537                           ).
      538      end.
      539      procedure WaitFramRunPause:
      540         define input  parameter iInterval as dec no-undo.
      541         define variable vStart  as datetime-tz no-undo.
      542         define variable vend    as datetime-tz no-undo.
      543         define variable vint as int64 no-undo.
      544         define variable vOk as logical no-undo.
      545         vStart = now.
      546         vend   = vStart.
      547         publish "WaitFramPause" (iInterval,output vOk).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and (   vint > 0
      553                 or (    not vOk
      554                     and iInterval eq ?
      555                     )
      556                 )
      557         then
      558            run waitfram-show-this (iInterval).
      559         vend   =  now.
      560         vint = vend - vStart.
      561         vint = iInterval - vint / 1000.
      562         if     not mWaitFramStop
      563            and vint > 0
      564         then do:
      565            run gbl/pause.p (vint * 1000).
      566         end.
      567         if iInterval ne ?
      568         then
      569            publish "WaitFramStop".
      570         waitfram-check-timeout().
      571      end.
      572      procedure WaitFramWaitFor:
      573         define input  parameter iInterval as dec no-undo.
      574         assign
      575            mWaitFramStartProc   = now
      576            mWaitFramStopUser    = no
      577            mWaitFramStopTimeOut = no
      578         .
      579         block-wait:
      580         do while not mWaitFramStop:
      581            run WaitFramRunPause (iInterval).
      582            if  waitfram-check-timeout()
      583            then do:
      584               leave block-wait.
      585            end.
      586         end.
      587         run waitfram-hide.
      588      end.
      589   procedure waitfram-join :
      590     define input  parameter p-line-1  as character no-undo .
      591     define input  parameter p-line-2  as character no-undo .
      592     define input  parameter p-line-3  as character no-undo .
      593     define output parameter p-message as character no-undo .
      594     do
      595     on error undo, return error return-value
      596     :
      597       assign
      598         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      599                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      600                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      601       .
      602     end.
      603   end procedure.
      604   function waitfram-join-function returns character
      605     (input p-line-1 as character
      606     ,input p-line-2 as character
      607     ,input p-line-3 as character
      608     ).
      609     define variable v-message as character no-undo .
      610     run waitfram-join in this-procedure
      611       (input  p-line-1
      612       ,input  p-line-2
      613       ,input  p-line-3
      614       ,output v-message
      615       ) .
      616     return v-message .
      617   end function .
      618   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   function chkleave returns logical
      620   (input p-widget-enter as handle
      621   ,input p-button-list  as character
      622   ).
      623     if  valid-handle(p-widget-enter)
      624     and can-query(p-widget-enter, "name":u)
      625     and lookup(p-widget-enter :name, p-button-list) > 0
      626     then do:
      627       return false .
      628     end.
      629     return true .
      630   end function.
