     1556   ON CHOOSE OF B-bind IN FRAME Dialog-Frame
     1557   DO:
     1558   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1559   if lookup(self :type
     1560            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1561            ) = 0
     1562   then do:
     1563     message
     1564       "$Workfile$"
     1565       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1566       "Интерфейсный элемент" self :name  skip
     1567       "Тип" self :type  skip
     1568       "Процедура" this-procedure :file-name skip
     1569       view-as alert-box .
     1570   end.
     1571   else do:
     1572     apply "entry":u to self  .
     1573     if focus :handle <> self :handle  then do:
     1574       return no-apply .
     1575     end.
     1576   end.
     1577   define variable rid#  AS RECID NO-UNDO.
     1578     DEFINE VARIABLE rid-list as character no-undo.
     1579     IF par-mode = 'ПРОСМОТР':U THEN DO:
     1580       RETURN NO-APPLY.
     1581     END.
     1582     FIND FIRST bind_wth-doc NO-LOCK WHERE
     1583                      bind_wth-doc.doc-code = bf_wth-doc.source-ref NO-ERROR.
     1584     IF AVAIL bind_wth-doc THEN DO:
     1585       MESSAGE
     1586         "Документ уже связан с документом" bf_wth-doc.source-ref "!" SKIP( 1 )
     1587         "Вы уверены, что хотите вместо этой связи подставить новую?  "
     1588       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1589       IF glog <> YES THEN DO:
     1590           RETURN NO-APPLY.
     1591       END.
     1592     END.
     1593     rid-list = '':U.
     1594     run str/wth-docs.w ( input parparentproc
     1595                      ,input 'b-sel':U
     1596                      ,input 'фирма':U
     1597                      ,input parhost-code
     1598                      ,input parobj-type
     1599                      ,input parobj-code
     1600                      ,input  '':U
     1601                      ,input 0
     1602                      ,INPUT '':U
     1603                      ,input '':U
     1604                      ,input '':U
     1605                      ,input-OUTPUT rid-list ).
     1606     rid# = integer(rid-list).
     1607     FIND FIRST bind_wth-doc NO-LOCK WHERE
     1608                      RECID( bind_wth-doc ) = rid# NO-ERROR.
     1609     IF AVAIL bind_wth-doc THEN DO:
     1610       IF rid# = RECID( bf_wth-doc ) OR
     1611         bind_wth-doc.doc-code = bf_wth-doc.doc-code THEN DO:
     1612         MESSAGE "Нельзя связать документ с самим собой!" VIEW-AS ALERT-BOX ERROR.
     1613         RETURN NO-APPLY.
     1614       END.
     1615       ASSIGN
     1616       bf_wth-doc.source-ref = bind_wth-doc.doc-code
     1617       bf_wth-doc.source-type = 'док.МЦ':U
     1618       .
     1619       ASSIGN
     1620       B-Bind :TOOLTIP IN FRAME Dialog-Frame = "Связан с " + bf_wth-doc.source-ref.
     1621     END.
     1622     ELSE DO:
     1623       ASSIGN
     1624       B-Bind :TOOLTIP IN FRAME Dialog-Frame = "":U.
     1625     END.
     1626   END.
     1627   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1628   DO:
     1629   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1630   if lookup(self :type
