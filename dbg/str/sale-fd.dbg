        1   define input parameter p-sys-today as date no-undo .
        2   define input-output parameter p-date as date no-undo.
        3   define input parameter p-shift-on as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Окно выбора выбора даты закрытия продажи".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   DEFINE BUTTON B-help
      114        LABEL "Помо&щь"
      115        SIZE 10 BY 1.
      116   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      117        LABEL "Закрыть ТЕКУЩЕЙ датой"
      118        SIZE 27 BY 1.17
      119        BGCOLOR 8 .
      120   DEFINE BUTTON Btn_OK AUTO-GO
      121        LABEL "Закрыть ВЫБРАННОЙ датой"
      122        SIZE 27 BY 1.17
      123        BGCOLOR 8 .
      124   DEFINE VARIABLE f-sys-today AS DATE FORMAT "99/99/9999":U INITIAL ?
      125        LABEL "Текущая дата на объекте"
      126         VIEW-AS TEXT
      127        SIZE 10 BY .67
      128        FGCOLOR 4  NO-UNDO.
      129   DEFINE VARIABLE v-date AS DATE FORMAT "99/99/9999":U
      130        LABEL "Выбрать дату"
      131        VIEW-AS FILL-IN
      132        SIZE 14.3 BY 1 NO-UNDO.
      133   DEFINE RECTANGLE RECT-1
      134        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      135        SIZE 76.9 BY 7.67.
      136   DEFINE FRAME Dialog-Frame
      137        B-help AT ROW 1 COL 61
      138        Btn_OK AT ROW 11 COL 5
      139        Btn_Cancel AT ROW 11 COL 44.5
      140        v-date AT ROW 12.67 COL 16 COLON-ALIGNED
      141        f-sys-today AT ROW 12.77 COL 65 COLON-ALIGNED WIDGET-ID 2
      142        "Внимание !!!" VIEW-AS TEXT
      143             SIZE 13 BY 1 AT ROW 5 COL 25.6
      144             BGCOLOR 8 FGCOLOR 4
      145        "В этом случае укажите более позднюю дату закрытия документа продажи" VIEW-AS TEXT
      146             SIZE 74.9 BY 1 AT ROW 9 COL 2.6
      147             BGCOLOR 8 FGCOLOR 4
      148        "Дата отчета не сегодняшняя." VIEW-AS TEXT
      149             SIZE 28 BY 1 AT ROW 3.67 COL 19.1
      150             BGCOLOR 8 FGCOLOR 4
      151        "Документ продажи не закроется, если по любому из товаров документа продажи" VIEW-AS TEXT
      152             SIZE 74.4 BY 1 AT ROW 6.33 COL 2.5
      153             BGCOLOR 8 FGCOLOR 4
      154        "более поздней датой был проведен документ инвентаризации" VIEW-AS TEXT
      155             SIZE 75 BY 1 AT ROW 7.67 COL 2.3
      156             BGCOLOR 8 FGCOLOR 4
      157        RECT-1 AT ROW 3 COL 1.5
      158        SPACE(0.97) SKIP(3.53)
      159       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      160            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      161            TITLE "Определить дату закрытия"
      162            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      163   ASSIGN
      164          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      165          FRAME Dialog-Frame:HIDDEN           = TRUE.
      166   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      167   DO:
      168     APPLY "END-ERROR":U TO SELF.
      169   END.
      170   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      171   DO:
      172       assign
      173       p-date  = p-sys-today
      174       .
      175   END.
      176   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      177   DO:
      178       assign
      179       v-date
      180       .
      181     if v-date < p-date then do:
      182           message
      183           "Неверно выбрана дата - дата закрытия документа меньше даты, чеков входящих в документ продажи"
      184           view-as alert-box ERROR.
      185           return no-apply.
      186       end.
      187       if v-date > p-sys-today then do:
      188           message
      189           "Неверно выбрана дата - дата закрытия документа больше даты на объекте"
      190           view-as alert-box ERROR.
      191           return no-apply.
      192       end.
      193     if p-shift-on then do:
      194       if v-date <> p-date and v-date <> p-sys-today then do:
      195         message
      196         "Неверно выбрана дата - для сменного объекта можно закрыть документ либо текущей датой"
      197         "либо датой чеков, входящих в документ продажи"
      198         view-as alert-box error .
      199         return no-apply.
      200       end.
      201     end.
      202       assign
      203       p-date = v-date
      204       .
      205   END.
      206   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      207   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      208   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   on help of frame Dialog-Frame
      210   do:
      211     run gbl/app_help.p
      212       (input this-procedure :file-name
      213       ,input ''
      214       ,input ?
      215       ) no-error.
      216     if error-status :error then do:
      217       message
      218         "Ошибка при вызове помощи"
      219         error-status :get-message(1)
      220         view-as alert-box .
      221     end.
      222   end.
      223   run minbtn-set in this-procedure .
      224   on choose of b-help in frame Dialog-Frame
      225   do:
      226     apply "help":u to frame Dialog-Frame .
      227   end.
      228   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   procedure minbtn-set :
      230       do
      231           on error undo, return error return-value
      232           :
      233           define variable ii              as integer       no-undo .
      234           define variable fh              as widget-handle no-undo .
      235           define variable hh              as widget-handle no-undo .
      236           define variable v-h             as handle        extent 4 no-undo .
      237           define variable v-name-button   as character     no-undo .
      238           define variable v-help-old-x    as decimal       no-undo .
      239           define variable v-help-old-y    as decimal       no-undo .
      240           define variable v-help-old-size as decimal       no-undo .
      241           define variable v-frame-width   as decimal       no-undo .
      242           define variable jj              as integer       no-undo .
      243           do
      244               on error undo, return error
      245               :
      246               assign
      247                   v-frame-width = frame Dialog-Frame:width - 0.3
      248                   fh            = frame Dialog-Frame:first-child
      249                   hh            = fh:first-child
      250                   ii            = 1
      251                   .
      252               do while valid-handle(hh):
      253                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      254                   do:
      255                       case lc(hh:name) :
      256                           when "b-help" then
      257                               do:
      258                                   hh:load-image-up("cmp/b-help.bmp":u) .
      259                                   hh:load-image-down("cmp/b-help.bmp":u) .
      260                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      261                                   hh:TOOLTIP = "Помощь" .
      262                                   v-help-old-x = hh:column .
      263                                   v-help-old-y = hh:row    .
      264                                   v-help-old-size = hh:width .
      265                                   hh:width-chars = 2.5 .
      266                               end.
      267                           when "b-print" then
      268                               do:
      269                                   hh:load-image("cmp/b-print.bmp":u) .
      270                                   hh:TOOLTIP = "Печать" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-history" or
      276                           when "b-hist" then
      277                               do:
      278                                   hh:load-image("cmp/b-hist.bmp":u) .
      279                                   hh:TOOLTIP = "История" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-sch" then
      285                               do:
      286                                   hh:load-image("cmp/b-sch.bmp":u) .
      287                                   hh:TOOLTIP = "Установка Фильтра" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-hist-user" then
      293                               do:
      294                                   hh:load-image("cmp/b-hist.bmp":u) .
      295                                   hh:TOOLTIP = "История пользователя" .
      296                                   ii = ii + 1 .
      297                               end.
      298                       end case.
      299                   end.
      300                   hh = hh:next-sibling.
      301               end.
      302               b-help:column = v-frame-width - b-help:width-chars.
      303               jj = 0.
      304               repeat ii = 4 to 1 by -1 :
      305                   if valid-handle (v-h[ii] ) then
      306                   do:
      307                       jj  = jj + 1 .
      308                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      309                       v-h[ii]:row    = v-help-old-y .
      310                   end.
      311               end.
      312           end.
      313       end.
      314   end procedure.
      315   MAIN-BLOCK:
      316   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      317      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      318     assign
      319     v-date = (IF p-sys-today < TODAY THEN p-sys-today ELSE p-date)
      320     f-sys-today = p-sys-today
      321     .
      322     RUN enable_UI.
      323     if p-shift-on then DISABLE v-date.
      324     WAIT-FOR GO OF FRAME Dialog-Frame.
      325   END.
      326   RUN disable_UI.
      327   PROCEDURE disable_UI :
      328     HIDE FRAME Dialog-Frame.
      329   END PROCEDURE.
      330   PROCEDURE enable_UI :
      331     DISPLAY v-date f-sys-today
      332         WITH FRAME Dialog-Frame.
      333     ENABLE RECT-1 B-help Btn_OK Btn_Cancel v-date f-sys-today
      334         WITH FRAME Dialog-Frame.
      335     VIEW FRAME Dialog-Frame.
      336   END PROCEDURE.
