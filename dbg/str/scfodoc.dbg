        1   DEFINE INPUT PARAMETER pardoc-code LIKE ub.c-trn-doc.doc-code NO-UNDO.
        2   DEFINE INPUT PARAMETER parchip-num LIKE ub.c-trn-doc.chip-num NO-UNDO.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Экран финансовых обязательств по удаленному документу".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE TEMP-TABLE tt-fo NO-UNDO LIKE ub.fin-ob
      113   FIELD sum-base-trn LIKE ub.fin-ob.sum-base
      114   FIELD sum-rubl-trn LIKE ub.fin-ob.sum-rubl.
      115   DEFINE BUFFER bf_fin-ob       FOR ub.fin-ob.
      116   DEFINE BUFFER bf_fin-gds-part FOR ub.fin-gds-part.
      117   DEFINE BUFFER bf_c-parts      FOR ub.c-parts.
      118   DEFINE BUFFER bf_c-trn-doc    FOR ub.c-trn-doc.
      119   define buffer bf_goods        for ub.goods.
      120   DEFINE BUFFER bf_fin-doc      FOR ub.fin-doc.
      121   DEFINE BUFFER bf_fin-connect  FOR ub.fin-connect.
      122   DEFINE BUTTON b-exit AUTO-GO
      123        LABEL "&Выход"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON b-help
      127        LABEL "&Помощь"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE QUERY b-fin-doc FOR
      131         bf_fin-connect,
      132         bf_fin-doc SCROLLING.
      133   DEFINE QUERY b-ob FOR
      134         tt-fo SCROLLING.
      135   DEFINE QUERY b-c-parts FOR
      136         bf_fin-gds-part,
      137         bf_goods,
      138         bf_c-parts SCROLLING.
      139   DEFINE BROWSE b-fin-doc
      140     QUERY b-fin-doc DISPLAY
      141    bf_fin-doc.prn-doc-code  COLUMN-LABEL "Платеж"
      142    bf_fin-doc.contract-code COLUMN-LABEL "Договор"
      143    bf_fin-doc.sum-base      FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (вал)"
      144    bf_fin-connect.sum-base  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (вал)"
      145    bf_fin-doc.sum-rubl      FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (вал)"
      146    bf_fin-connect.sum-rubl  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (abbr_rub)"
      147    bf_fin-doc.fin-doc-code  FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Вн. код платежа"
      148       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      149            TITLE "Платежи по финансовому обязательству".
      150   DEFINE BROWSE b-ob
      151     QUERY b-ob DISPLAY
      152         tt-fo.prn-doc-code COLUMN-LABEL "Фин. обяз."
      153   tt-fo.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (вал)"
      154   tt-fo.sum-base-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (вал)"
      155   tt-fo.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (abbr_rub)"
      156   tt-fo.sum-rubl-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (abbr_rub)"
      157   tt-fo.contract-code COLUMN-LABEL "Договор"
      158   tt-fo.doc-code COLUMN-LABEL "Вн. код. фин. обяз."
      159       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      160            TITLE "Финансовые обязательства" ROW-HEIGHT-CHARS .67.
      161   DEFINE BROWSE b-c-parts
      162     QUERY b-c-parts DISPLAY
      163    bf_c-parts.in-code    COLUMN-LABEL "Прих. накл."
      164    bf_c-parts.part-code  COLUMN-LABEL "Код партии"
      165    bf_c-parts.fact-qnty  COLUMN-LABEL "Факт кол-во"
      166    bf_c-parts.price-base COLUMN-LABEL "Цена (вал)"
      167    bf_c-parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
      168       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      169            TITLE "Партии по финансовому обязательству" ROW-HEIGHT-CHARS .67.
      170   DEFINE FRAME Dialog-Frame
      171        b-exit AT ROW 1 COL 1
      172        b-help AT ROW 1 COL 11.5
      173        b-ob AT ROW 2.25 COL 1
      174        b-c-parts AT ROW 8.54 COL 1
      175        b-fin-doc AT ROW 14.83 COL 1
      176        SPACE(0.00) SKIP(0.17)
      177       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      178            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      179            TITLE "Финансовые обязательства на которые повлиял данный складской документ"
      180            DEFAULT-BUTTON b-exit.
      181   ASSIGN
      182          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      183          FRAME Dialog-Frame:HIDDEN           = TRUE.
      184   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      185   DO:
      186     APPLY "END-ERROR":U TO SELF.
      187   END.
      188   ON VALUE-CHANGED OF b-ob IN FRAME Dialog-Frame
      189   DO:
      190     RUN open-c-parts-query IN THIS-PROCEDURE.
      191     RUN open-fin-doc-query IN THIS-PROCEDURE.
      192   END.
      193   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      194   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      195   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   on help of frame Dialog-Frame
      197   do:
      198     run gbl/app_help.p
      199       (input this-procedure :file-name
      200       ,input ''
      201       ,input ?
      202       ) no-error.
      203     if error-status :error then do:
      204       message
      205         "Ошибка при вызове помощи"
      206         error-status :get-message(1)
      207         view-as alert-box .
      208     end.
      209   end.
      210   run minbtn-set in this-procedure .
      211   on choose of b-help in frame Dialog-Frame
      212   do:
      213     apply "help":u to frame Dialog-Frame .
      214   end.
      215   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216   procedure minbtn-set :
      217       do
      218           on error undo, return error return-value
      219           :
      220           define variable ii              as integer       no-undo .
      221           define variable fh              as widget-handle no-undo .
      222           define variable hh              as widget-handle no-undo .
      223           define variable v-h             as handle        extent 4 no-undo .
      224           define variable v-name-button   as character     no-undo .
      225           define variable v-help-old-x    as decimal       no-undo .
      226           define variable v-help-old-y    as decimal       no-undo .
      227           define variable v-help-old-size as decimal       no-undo .
      228           define variable v-frame-width   as decimal       no-undo .
      229           define variable jj              as integer       no-undo .
      230           do
      231               on error undo, return error
      232               :
      233               assign
      234                   v-frame-width = frame Dialog-Frame:width - 0.3
      235                   fh            = frame Dialog-Frame:first-child
      236                   hh            = fh:first-child
      237                   ii            = 1
      238                   .
      239               do while valid-handle(hh):
      240                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      241                   do:
      242                       case lc(hh:name) :
      243                           when "b-help" then
      244                               do:
      245                                   hh:load-image-up("cmp/b-help.bmp":u) .
      246                                   hh:load-image-down("cmp/b-help.bmp":u) .
      247                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      248                                   hh:TOOLTIP = "Помощь" .
      249                                   v-help-old-x = hh:column .
      250                                   v-help-old-y = hh:row    .
      251                                   v-help-old-size = hh:width .
      252                                   hh:width-chars = 2.5 .
      253                               end.
      254                           when "b-print" then
      255                               do:
      256                                   hh:load-image("cmp/b-print.bmp":u) .
      257                                   hh:TOOLTIP = "Печать" .
      258                                   v-h[ii] = hh:handle .
      259                                   ii = ii + 1 .
      260                                   hh:width-chars = 3 .
      261                               end.
      262                           when "b-history" or
      263                           when "b-hist" then
      264                               do:
      265                                   hh:load-image("cmp/b-hist.bmp":u) .
      266                                   hh:TOOLTIP = "История" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-sch" then
      272                               do:
      273                                   hh:load-image("cmp/b-sch.bmp":u) .
      274                                   hh:TOOLTIP = "Установка Фильтра" .
      275                                   v-h[ii] = hh:handle .
      276                                   ii = ii + 1 .
      277                                   hh:width-chars = 3 .
      278                               end.
      279                           when "b-hist-user" then
      280                               do:
      281                                   hh:load-image("cmp/b-hist.bmp":u) .
      282                                   hh:TOOLTIP = "История пользователя" .
      283                                   ii = ii + 1 .
      284                               end.
      285                       end case.
      286                   end.
      287                   hh = hh:next-sibling.
      288               end.
      289               b-help:column = v-frame-width - b-help:width-chars.
      290               jj = 0.
      291               repeat ii = 4 to 1 by -1 :
      292                   if valid-handle (v-h[ii] ) then
      293                   do:
      294                       jj  = jj + 1 .
      295                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      296                       v-h[ii]:row    = v-help-old-y .
      297                   end.
      298               end.
      299           end.
      300       end.
      301   end procedure.
      302   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      303   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      304   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      305   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      306   define variable v-diasize-current-frame-width  as decimal   no-undo .
      307   define variable v-diasize-current-frame-height as decimal   no-undo .
      308   define variable v-diasize-change-size          as logical   no-undo .
      309   define variable v-diasize-resize-button        as handle    no-undo .
      310   define variable v-diasize-wndmax               as logical   no-undo .
      311   define variable v-diasize-wndstore             as logical   no-undo .
      312   define variable v-diasize-proc-name            as character no-undo .
      313   define variable v-diasize-browse-handle        as handle    no-undo .
      314   define variable v-diasize-browse-number        as integer   no-undo .
      315   define variable v-diasize-need-full-display    as logical   no-undo init false .
      316   define temp-table temp-diasize-handle no-undo
      317     field handle-value  as handle
      318     field save-position as decimal
      319     index xpk is primary unique handle-value
      320     .
      321   define temp-table temp-browse-handle no-undo
      322     field browse-type   as character
      323     field browse-number as integer
      324     field browse-handle as handle
      325     field original-size as decimal
      326     index xpk is primary unique browse-type browse-number
      327     index xie browse-type browse-handle
      328   .
      329   procedure diasize_change-height :
      330     define input  parameter p-change-value  as decimal   no-undo .
      331     define input  parameter p-move-resize   as logical   no-undo .
      332     define variable v-field-group-handle    as handle    no-undo .
      333     define variable v-object-handle         as handle    no-undo .
      334     define variable v-frame-height          as decimal   no-undo .
      335     define variable v-frame-virtual-height  as decimal   no-undo .
      336     define variable v-browse-height         as decimal   no-undo .
      337     define variable v-window-height         as decimal   no-undo .
      338     define variable v-window-virtual-height as decimal   no-undo .
      339     define variable v-change-sign           as integer   no-undo .
      340     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      341     define buffer buf_temp-browse-handle  for temp-browse-handle .
      342     if p-change-value > 0
      343     then do:
      344       if frame Dialog-Frame :height + p-change-value
      345           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      346       then do:
      347         assign
      348           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      349                           - (frame Dialog-Frame :height-chars)
      350         .
      351         if p-change-value <= 0
      352         then do:
      353           run diasize_position-resize-button in this-procedure .
      354           return .
      355         end.
      356       end.
      357     end.
      358     if p-change-value < 0
      359     then do:
      360       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      361       then do:
      362         assign
      363           p-change-value = v-diasize-orig-frame-height
      364                          - (frame Dialog-Frame :height-chars)
      365         .
      366         if p-change-value >= 0
      367         then do:
      368           run diasize_position-resize-button in this-procedure .
      369           return .
      370         end.
      371       end.
      372     end.
      373     if p-change-value >= 0
      374     then do:
      375       assign
      376         v-change-sign = 1
      377       .
      378     end.
      379     else do:
      380       assign
      381         v-change-sign = -1
      382       .
      383     end.
      384     assign
      385       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      386     .
      387     if p-change-value = 0
      388     then do:
      389       run diasize_position-resize-button in this-procedure .
      390       return .
      391     end.
      392     move_block:
      393     do
      394     on error undo move_block, retry move_block
      395     :
      396       if retry
      397       then do:
      398         do
      399         on error undo move_block, leave move_block
      400         :
      401           if p-change-value > 0
      402           then do:
      403             for each buf_temp-diasize-handle
      404             on error undo, next
      405             :
      406               assign
      407                 v-object-handle = buf_temp-diasize-handle.handle-value
      408               .
      409               if v-object-handle <> v-diasize-resize-button
      410               then do:
      411                 assign
      412                   v-object-handle :row = buf_temp-diasize-handle.save-position
      413                 .
      414               end.
      415             end.
      416             assign
      417               v-diasize-browse-handle :height = v-browse-height
      418             .
      419             for each buf_temp-browse-handle
      420               where buf_temp-browse-handle.browse-type = 'height':u
      421             on error undo, next
      422             :
      423               assign
      424                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      425               .
      426             end.
      427             assign
      428               frame Dialog-Frame :height = v-frame-height
      429             .
      430             if frame Dialog-Frame :scrollable = true
      431             then do:
      432               assign
      433                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      434               .
      435             end.
      436             run diasize_position-resize-button in this-procedure .
      437           end.
      438           else do:
      439             if frame Dialog-Frame :scrollable = true
      440             then do:
      441               assign
      442                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      443               .
      444             end.
      445             assign
      446               frame Dialog-Frame :height = v-frame-height
      447             .
      448             assign
      449               v-diasize-browse-handle :height = v-browse-height
      450             .
      451             for each buf_temp-browse-handle
      452               where buf_temp-browse-handle.browse-type = 'height':u
      453             on error undo, next
      454             :
      455               assign
      456                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      457               .
      458             end.
      459             for each buf_temp-diasize-handle
      460             on error undo, next
      461             :
      462               assign
      463                 v-object-handle = buf_temp-diasize-handle.handle-value
      464               .
      465               if v-object-handle <> v-diasize-resize-button
      466               then do:
      467                 assign
      468                   v-object-handle :row = buf_temp-diasize-handle.save-position
      469                 .
      470               end.
      471             end.
      472             run diasize_position-resize-button in this-procedure .
      473           end.
      474           assign
      475             v-diasize-change-size = false
      476           .
      477           leave move_block .
      478         end.
      479       end.
      480       assign
      481         v-diasize-need-full-display = true
      482       .
      483       if v-diasize-change-size = false
      484       then do:
      485         assign
      486           v-diasize-change-size = true
      487         .
      488       end.
      489       else do:
      490         return .
      491       end.
      492       assign
      493         v-frame-height = frame Dialog-Frame :height
      494         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      495         v-browse-height = v-diasize-browse-handle :height
      496       .
      497       for each buf_temp-browse-handle
      498         where buf_temp-browse-handle.browse-type = 'height':u
      499       :
      500         assign
      501           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      502         .
      503       end.
      504       for each buf_temp-diasize-handle
      505       :
      506         delete buf_temp-diasize-handle .
      507       end.
      508       assign
      509         v-field-group-handle = frame Dialog-Frame :first-child
      510       .
      511       do while valid-handle(v-field-group-handle)
      512       :
      513         assign
      514           v-object-handle = v-field-group-handle :first-child
      515         .
      516         do while valid-handle(v-object-handle)
      517         :
      518           if  v-object-handle <> v-diasize-browse-handle :handle
      519           and can-query(v-object-handle, "row")
      520           and can-query(v-object-handle, "height")
      521           and ( v-object-handle :row > v-diasize-browse-handle :row )
      522           then do:
      523             find first buf_temp-browse-handle
      524               where buf_temp-browse-handle.browse-type   = 'height':u
      525                 and buf_temp-browse-handle.browse-handle = v-object-handle
      526               no-error .
      527             if available buf_temp-browse-handle
      528             then do:
      529             end.
      530             else do:
      531               create buf_temp-diasize-handle .
      532               assign
      533                 buf_temp-diasize-handle.handle-value  = v-object-handle
      534                 buf_temp-diasize-handle.save-position = v-object-handle :row
      535               .
      536             end.
      537           end.
      538           assign
      539             v-object-handle = v-object-handle :next-sibling
      540           .
      541         end.
      542         assign
      543           v-field-group-handle = v-field-group-handle :next-sibling
      544         .
      545       end.
      546       do with frame Dialog-Frame
      547       :
      548         hide v-diasize-resize-button .
      549         assign
      550           v-diasize-resize-button :row    = 1
      551           v-diasize-resize-button :column = 1
      552         .
      553       end.
      554       if p-change-value > 0
      555       then do:
      556         if frame Dialog-Frame :scrollable = true
      557         then do:
      558           assign
      559             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      560             no-error .
      561           if error-status :error
      562           or error-status :get-message(1) <> ""
      563           then do:
      564             undo move_block, retry move_block .
      565           end.
      566         end.
      567         assign
      568           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      569           no-error .
      570         if error-status :error
      571         or error-status :get-message(1) <> ""
      572         then do:
      573           undo move_block, retry move_block .
      574         end.
      575         assign
      576           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      577           no-error .
      578         if error-status :error
      579         or error-status :get-message(1) <> ""
      580         then do:
      581           undo move_block, retry move_block .
      582         end.
      583         for each buf_temp-browse-handle
      584           where buf_temp-browse-handle.browse-type = 'height':u
      585         on error undo move_block, retry move_block
      586         :
      587           assign
      588             buf_temp-browse-handle.browse-handle :height
      589               = buf_temp-browse-handle.browse-handle :height + p-change-value
      590             no-error .
      591           if error-status :error
      592           or error-status :get-message(1) <> ""
      593           then do:
      594             undo move_block, retry move_block .
      595           end.
      596         end.
      597         for each buf_temp-diasize-handle
      598         on error undo move_block, retry move_block
      599         :
      600           assign
      601             v-object-handle = buf_temp-diasize-handle.handle-value
      602           .
      603           if v-object-handle <> v-diasize-resize-button
      604           then do:
      605             assign
      606               v-object-handle :row = v-object-handle :row + p-change-value
      607               no-error .
      608             if error-status :error
      609             or error-status :get-message(1) <> ""
      610             then do:
      611               undo move_block, retry move_block .
      612             end.
      613           end.
      614         end.
      615       end.
      616       else do:
      617         for each buf_temp-diasize-handle
      618         on error undo move_block, retry move_block
      619         :
      620           assign
      621             v-object-handle = buf_temp-diasize-handle.handle-value
      622           .
      623           if v-object-handle <> v-diasize-resize-button
      624           then do:
      625             assign
      626               v-object-handle :row = v-object-handle :row + p-change-value
      627               no-error .
      628             if error-status :error
      629             or error-status :get-message(1) <> ""
      630             then do:
      631               undo move_block, retry move_block .
      632             end.
      633           end.
      634         end.
      635         assign
      636           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      637           no-error .
      638         if error-status :error
      639         or error-status :get-message(1) <> ""
      640         then do:
      641           undo move_block, retry move_block .
      642         end.
      643         for each buf_temp-browse-handle
      644           where buf_temp-browse-handle.browse-type = 'height':u
      645         on error undo move_block, retry move_block
      646         :
      647           assign
      648             buf_temp-browse-handle.browse-handle :height
      649               = buf_temp-browse-handle.browse-handle :height + p-change-value
      650             no-error .
      651           if error-status :error
      652           or error-status :get-message(1) <> ""
      653           then do:
      654             undo move_block, retry move_block .
      655           end.
      656         end.
      657         assign
      658           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      659           no-error .
      660         if error-status :error
      661         or error-status :get-message(1) <> ""
      662         then do:
      663           undo move_block, retry move_block .
      664         end.
      665         if frame Dialog-Frame :scrollable = true
      666         then do:
      667           assign
      668             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      669             no-error .
      670           if error-status :error
      671           or error-status :get-message(1) <> ""
      672           then do:
      673             undo move_block, retry move_block .
      674           end.
      675         end.
      676       end.
      677       if p-move-resize = true
      678       then do:
      679         run diasize_position-resize-button in this-procedure .
      680       end.
      681       if v-diasize-wndstore = true
      682       then do:
      683         if connected("ub") = true
      684         then do:
      685           define variable v-cntxt-db-num        as integer   no-undo .
      686           define variable v-cntxt-userid        as character no-undo .
      687           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      688                                             , OUTPUT v-cntxt-userid
      689                                             ) .
      690           run gbl/wndsizew.p
      691             (input  v-cntxt-db-num
      692             ,input  v-cntxt-userid
      693             ,input  v-diasize-proc-name
      694             ,input  'height':u
      695             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      696             ) .
      697         end.
      698       end.
      699     end.
      700     assign
      701       v-diasize-change-size = false
      702     .
      703   end procedure.
      704   procedure diasize_set-height :
      705     define input  parameter p-new-height  as decimal   no-undo .
      706     define input  parameter p-move-resize as logical   no-undo .
      707     do
      708     on error undo, return error return-value
      709     :
      710       run diasize_change-height in this-procedure
      711         (input  (p-new-height - frame Dialog-Frame :height)
      712         ,input  p-move-resize
      713         ) .
      714     end.
      715   end procedure.
      716   procedure diasize_change-width :
      717     define input  parameter p-change-value as decimal   no-undo .
      718     define input  parameter p-move-resize  as logical   no-undo .
      719     define variable v-field-group-handle   as handle    no-undo .
      720     define variable v-object-handle        as handle    no-undo .
      721     define variable v-frame-width          as decimal   no-undo .
      722     define variable v-frame-virtual-width  as decimal   no-undo .
      723     define variable v-browse-width         as decimal   no-undo .
      724     define variable v-window-width         as decimal   no-undo .
      725     define variable v-window-virtual-width as decimal   no-undo .
      726     define variable v-change-sign          as integer   no-undo .
      727     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      728     define buffer buf_temp-browse-handle  for temp-browse-handle .
      729     if p-change-value > 0
      730     then do:
      731       if frame Dialog-Frame :width + p-change-value >
      732           session :width-chars
      733       then do:
      734         assign
      735           p-change-value = session :width-chars - frame Dialog-Frame :width
      736         .
      737         if p-change-value <= 0
      738         then do:
      739           run diasize_position-resize-button in this-procedure .
      740           return .
      741         end.
      742       end.
      743     end.
      744     if p-change-value < 0
      745     then do:
      746       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      747       then do:
      748         assign
      749           p-change-value = v-diasize-orig-frame-width
      750                          - frame Dialog-Frame :width
      751         .
      752         if p-change-value >= 0
      753         then do:
      754           run diasize_position-resize-button in this-procedure .
      755           return .
      756         end.
      757       end.
      758     end.
      759     if p-change-value >= 0
      760     then do:
      761       assign
      762         v-change-sign = 1
      763       .
      764     end.
      765     else do:
      766       assign
      767         v-change-sign = -1
      768       .
      769     end.
      770     assign
      771       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      772     .
      773     if p-change-value = 0
      774     then do:
      775       run diasize_position-resize-button in this-procedure .
      776       return .
      777     end.
      778     move_block:
      779     do
      780     on error undo move_block, leave move_block
      781     :
      782       if retry
      783       then do:
      784         do
      785         on error undo move_block, leave move_block
      786         :
      787           if p-change-value > 0
      788           then do:
      789             for each buf_temp-diasize-handle
      790             on error undo, next
      791             :
      792               assign
      793                 v-object-handle = buf_temp-diasize-handle.handle-value
      794               .
      795               if v-object-handle <> v-diasize-resize-button
      796               then do:
      797                 assign
      798                   v-object-handle :col = buf_temp-diasize-handle.save-position
      799                 .
      800               end.
      801             end.
      802             assign
      803               v-diasize-browse-handle :width = v-browse-width
      804             .
      805             for each buf_temp-browse-handle
      806               where buf_temp-browse-handle.browse-type = 'width':u
      807             on error undo, next
      808             :
      809               assign
      810                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      811               .
      812             end.
      813             assign
      814               frame Dialog-Frame :width = v-frame-width
      815             .
      816             if frame Dialog-Frame :scrollable = true
      817             then do:
      818               assign
      819                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      820               .
      821             end.
      822             run diasize_position-resize-button in this-procedure .
      823           end.
      824           else do:
      825             if frame Dialog-Frame :scrollable = true
      826             then do:
      827               assign
      828                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      829               .
      830             end.
      831             assign
      832               frame Dialog-Frame :width = v-frame-width
      833             .
      834             for each buf_temp-browse-handle
      835               where buf_temp-browse-handle.browse-type = 'width':u
      836             on error undo, next
      837             :
      838               assign
      839                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      840               .
      841             end.
      842             assign
      843               v-diasize-browse-handle :width = v-browse-width
      844             .
      845             for each buf_temp-diasize-handle
      846             on error undo, next
      847             :
      848               assign
      849                 v-object-handle = buf_temp-diasize-handle.handle-value
      850               .
      851               if v-object-handle <> v-diasize-resize-button
      852               then do:
      853                 assign
      854                   v-object-handle :col = buf_temp-diasize-handle.save-position
      855                 .
      856               end.
      857             end.
      858             run diasize_position-resize-button in this-procedure .
      859           end.
      860           assign
      861             v-diasize-change-size = false
      862           .
      863           leave move_block .
      864         end.
      865       end.
      866       assign
      867         v-diasize-need-full-display = true
      868       .
      869       if v-diasize-change-size = false
      870       then do:
      871         assign
      872           v-diasize-change-size = true
      873         .
      874       end.
      875       else do:
      876         return .
      877       end.
      878       assign
      879         v-frame-width = frame Dialog-Frame :width
      880         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      881         v-browse-width = v-diasize-browse-handle :width
      882       .
      883       for each buf_temp-browse-handle
      884         where buf_temp-browse-handle.browse-type = 'width':u
      885       :
      886         assign
      887           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      888         .
      889       end.
      890       for each buf_temp-diasize-handle
      891       :
      892         delete buf_temp-diasize-handle .
      893       end.
      894       assign
      895         v-field-group-handle = frame Dialog-Frame :first-child
      896       .
      897       do while valid-handle(v-field-group-handle)
      898       :
      899         assign
      900           v-object-handle = v-field-group-handle :first-child
      901         .
      902         do while valid-handle(v-object-handle)
      903         :
      904           if  v-object-handle <> v-diasize-browse-handle :handle
      905           and v-object-handle <> v-diasize-resize-button
      906           and can-query(v-object-handle, "row")
      907           and can-query(v-object-handle, "height")
      908           and ( v-object-handle :col + v-object-handle :width
      909                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      910               )
      911           then do:
      912             find first buf_temp-browse-handle
      913               where buf_temp-browse-handle.browse-type   = 'width':u
      914                 and buf_temp-browse-handle.browse-handle = v-object-handle
      915               no-error .
      916             if available buf_temp-browse-handle
      917             then do:
      918             end.
      919             else do:
      920               create buf_temp-diasize-handle .
      921               assign
      922                 buf_temp-diasize-handle.handle-value  = v-object-handle
      923                 buf_temp-diasize-handle.save-position = v-object-handle :col
      924               .
      925             end.
      926           end.
      927           assign
      928             v-object-handle = v-object-handle :next-sibling
      929           .
      930         end.
      931         assign
      932           v-field-group-handle = v-field-group-handle :next-sibling
      933         .
      934       end.
      935       do with frame Dialog-Frame
      936       :
      937         hide v-diasize-resize-button .
      938         v-diasize-resize-button :row = 1.
      939         v-diasize-resize-button :column = 1.
      940       end.
      941       if p-change-value > 0
      942       then do:
      943         if frame Dialog-Frame :scrollable = true
      944         then do:
      945           assign
      946             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      947             no-error .
      948           if error-status :error
      949           or error-status :get-message(1) <> ""
      950           then do:
      951             undo move_block, retry move_block.
      952           end.
      953         end.
      954         assign
      955           frame Dialog-Frame :width = v-frame-width + p-change-value
      956           no-error .
      957         if error-status :error
      958         or error-status :get-message(1) <> ""
      959         then do:
      960           undo move_block, retry move_block.
      961         end.
      962         assign
      963           v-diasize-browse-handle :width = v-browse-width + p-change-value
      964         no-error .
      965         if error-status :error
      966         or error-status :get-message(1) <> ""
      967         then do:
      968           undo move_block, retry move_block.
      969         end.
      970         for each buf_temp-browse-handle
      971           where buf_temp-browse-handle.browse-type = 'width':u
      972         on error undo move_block, retry move_block
      973         :
      974           assign
      975             buf_temp-browse-handle.browse-handle :width
      976               = buf_temp-browse-handle.browse-handle :width + p-change-value
      977             no-error .
      978           if error-status :error
      979           or error-status :get-message(1) <> ""
      980           then do:
      981             undo move_block, retry move_block .
      982           end.
      983         end.
      984         for each buf_temp-diasize-handle
      985         on error undo move_block, retry move_block
      986         :
      987           assign
      988             v-object-handle = buf_temp-diasize-handle.handle-value
      989           .
      990           if v-object-handle <> v-diasize-resize-button
      991           then do:
      992             assign
      993               v-object-handle :col = v-object-handle :col + p-change-value
      994               no-error .
      995             if error-status :error
      996             or error-status :get-message(1) <> ""
      997             then do:
      998               undo move_block, retry move_block .
      999             end.
     1000           end.
     1001         end.
     1002       end.
     1003       else do:
     1004         for each buf_temp-diasize-handle
     1005         on error undo move_block, retry move_block
     1006         :
     1007           assign
     1008             v-object-handle = buf_temp-diasize-handle.handle-value
     1009           .
     1010           if v-object-handle <> v-diasize-resize-button
     1011           then do:
     1012             assign
     1013               v-object-handle :col = v-object-handle :col + p-change-value
     1014               no-error .
     1015             if error-status :error
     1016             or error-status :get-message(1) <> ""
     1017             then do:
     1018               undo move_block, retry move_block .
     1019             end.
     1020           end.
     1021         end.
     1022         for each buf_temp-browse-handle
     1023           where buf_temp-browse-handle.browse-type = 'width':u
     1024         on error undo move_block, retry move_block
     1025         :
     1026           assign
     1027             buf_temp-browse-handle.browse-handle :width
     1028               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1029             no-error .
     1030           if error-status :error
     1031           or error-status :get-message(1) <> ""
     1032           then do:
     1033             undo move_block, retry move_block .
     1034           end.
     1035         end.
     1036         assign
     1037           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1038           no-error .
     1039         if error-status :error
     1040         or error-status :get-message(1) <> ""
     1041         then do:
     1042           undo move_block, retry move_block.
     1043         end.
     1044         assign
     1045           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1046         no-error .
     1047         if error-status :error
     1048         or error-status :get-message(1) <> ""
     1049         then do:
     1050           undo move_block, retry move_block.
     1051         end.
     1052         if frame Dialog-Frame :scrollable = true
     1053         then do:
     1054           assign
     1055             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1056           no-error .
     1057           if error-status :error
     1058           or error-status :get-message(1) <> ""
     1059           then do:
     1060             undo move_block, retry move_block.
     1061           end.
     1062         end.
     1063       end.
     1064       if p-move-resize
     1065       then do:
     1066         run diasize_position-resize-button in this-procedure .
     1067       end.
     1068       if v-diasize-wndstore = true
     1069       then do:
     1070         if connected("ub") = true
     1071         then do:
     1072           define variable v-cntxt-db-num        as integer   no-undo .
     1073           define variable v-cntxt-userid        as character no-undo .
     1074           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1075                                             , OUTPUT v-cntxt-userid
     1076                                             ) .
     1077           run gbl/wndsizew.p
     1078             (input  v-cntxt-db-num
     1079             ,input  v-cntxt-userid
     1080             ,input  v-diasize-proc-name
     1081             ,input  'width':u
     1082             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1083             ) .
     1084         end.
     1085       end.
     1086     end.
     1087     assign
     1088       v-diasize-change-size = false
     1089     .
     1090   end procedure.
     1091   procedure diasize_set-width :
     1092     define input  parameter p-new-width  as decimal   no-undo .
     1093     define input  parameter p-move-resize as logical   no-undo .
     1094     do
     1095     on error undo, return error return-value
     1096     :
     1097       run diasize_change-width in this-procedure
     1098         (input  (p-new-width - frame Dialog-Frame :width)
     1099         ,input  p-move-resize
     1100         ) .
     1101     end.
     1102   end procedure.
     1103   procedure diasize_position-resize-button :
     1104     do with frame Dialog-Frame
     1105     :
     1106       hide v-diasize-resize-button .
     1107       assign
     1108         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1109                     - 1
     1110                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1111         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1112                     - 1
     1113                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1114       .
     1115       view v-diasize-resize-button .
     1116     end.
     1117   end procedure.
     1118   on alt-right anywhere
     1119   do:
     1120     run diasize_change-width in this-procedure
     1121       (input 1
     1122       ,input true
     1123       ) .
     1124     return no-apply .
     1125   end.
     1126   on alt-left anywhere
     1127   do:
     1128     run diasize_change-width in this-procedure
     1129       (input -1
     1130       ,input true
     1131       ) .
     1132     return no-apply .
     1133   end.
     1134   on alt-down anywhere
     1135   do:
     1136     run diasize_change-height in this-procedure
     1137       (input 1
     1138       ,input true
     1139       ) .
     1140     return no-apply .
     1141   end.
     1142   on alt-up anywhere
     1143   do:
     1144     run diasize_change-height in this-procedure
     1145       (input -1
     1146       ,input true
     1147       ) .
     1148     return no-apply .
     1149   end.
     1150   on alt-enter of frame Dialog-Frame
     1151   do:
     1152     run diasize_maximize in this-procedure
     1153       (input  ?
     1154       ).
     1155     return no-apply .
     1156   end.
     1157   procedure diasize_end-move :
     1158     do
     1159     on error undo, return error return-value
     1160     :
     1161       define variable v-row-delta as decimal   no-undo .
     1162       define variable v-col-delta as decimal   no-undo .
     1163       define variable v-new-row as decimal   no-undo .
     1164       define variable v-new-col as decimal   no-undo .
     1165       assign
     1166         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1167         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1168       .
     1169       assign
     1170         v-row-delta = v-new-row - frame Dialog-Frame :height
     1171         v-col-delta = v-new-col - frame Dialog-Frame :width
     1172       .
     1173       run diasize_change-height in this-procedure
     1174         (input v-row-delta
     1175         ,input true
     1176         ) .
     1177       run diasize_change-width in this-procedure
     1178         (input v-col-delta
     1179         ,input true
     1180         ) .
     1181     end.
     1182   end procedure.
     1183   procedure diasize_maximize :
     1184     define input  parameter p-action as logical   no-undo .
     1185     do
     1186     on error undo, return error return-value
     1187     :
     1188       if p-action = ?
     1189       then do:
     1190         if v-diasize-need-maximize = true
     1191         then do:
     1192           assign
     1193             p-action = true
     1194           .
     1195         end.
     1196         else do:
     1197           assign
     1198             p-action = false
     1199           .
     1200         end.
     1201       end.
     1202       if p-action = true
     1203       then do:
     1204         run diasize_change-height in this-procedure
     1205           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1206               - frame Dialog-Frame :height-chars
     1207           ,input true
     1208           ) .
     1209         run diasize_change-width in this-procedure
     1210           (input session :width-chars
     1211               - frame Dialog-Frame :width-chars
     1212           ,input true
     1213           ) .
     1214         assign
     1215           v-diasize-need-maximize = false
     1216         .
     1217       end.
     1218       else do:
     1219         run diasize_change-width in this-procedure
     1220           (input v-diasize-orig-frame-width
     1221               - frame Dialog-Frame :width-chars
     1222           ,input true
     1223           ) .
     1224         run diasize_change-height in this-procedure
     1225           (input v-diasize-orig-frame-height
     1226               - frame Dialog-Frame :height-chars
     1227           ,input true
     1228           ) .
     1229         assign
     1230           v-diasize-need-maximize = true
     1231         .
     1232       end.
     1233     end.
     1234   end procedure.
     1235   procedure diasize_restore-orig-size :
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       assign
     1240         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1241         v-diasize-current-frame-height = frame Dialog-Frame :height
     1242       .
     1243       run diasize_set-height in this-procedure
     1244         (input  v-diasize-orig-frame-height
     1245         ,input  true
     1246         ) .
     1247       run diasize_set-width in this-procedure
     1248         (input  v-diasize-orig-frame-width
     1249         ,input  true
     1250         ) .
     1251     end.
     1252   end procedure.
     1253   procedure diasize_restore-current-size :
     1254     do
     1255     on error undo, return error return-value
     1256     :
     1257       run diasize_set-height in this-procedure
     1258         (input  v-diasize-current-frame-height
     1259         ,input  true
     1260         ) .
     1261       run diasize_set-width in this-procedure
     1262         (input  v-diasize-current-frame-width
     1263         ,input  true
     1264         ) .
     1265     end.
     1266   end procedure.
     1267   procedure diasize_set-browse-handle :
     1268     define input  parameter p-browse-handle as handle   no-undo .
     1269     define buffer buf_temp-browse-handle for temp-browse-handle .
     1270     do
     1271     on error undo, return error return-value
     1272     :
     1273       assign
     1274         v-diasize-browse-handle = p-browse-handle
     1275       .
     1276       for each buf_temp-browse-handle
     1277       on error undo, return error return-value
     1278       :
     1279         delete buf_temp-browse-handle .
     1280       end.
     1281     end.
     1282   end procedure.
     1283   procedure diasize_add_browse :
     1284     define input  parameter p-browse-type   as character no-undo .
     1285     define input  parameter p-browse-handle as handle    no-undo .
     1286     define buffer buf_temp-browse-handle for temp-browse-handle .
     1287     do
     1288     on error undo, return error return-value
     1289     :
     1290       assign
     1291         v-diasize-browse-number = v-diasize-browse-number + 1
     1292       .
     1293       create buf_temp-browse-handle .
     1294       assign
     1295         buf_temp-browse-handle.browse-type   = p-browse-type
     1296         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1297         buf_temp-browse-handle.browse-handle = p-browse-handle
     1298       .
     1299     end.
     1300   end procedure.
     1301   procedure diasize_init :
     1302     define variable v-default-value    as logical   no-undo .
     1303     define variable v-restore-saved    as logical   no-undo .
     1304     define variable v-resize-value-str as character no-undo .
     1305     do
     1306     on error undo, return error return-value
     1307     :
     1308       do with frame Dialog-Frame
     1309       :
     1310         assign
     1311           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1312           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1313           v-diasize-browse-handle     = browse b-fin-doc :handle
     1314         .
     1315         create button v-diasize-resize-button
     1316         assign
     1317           parent        = frame Dialog-Frame :first-child
     1318           label         = "s"
     1319           height-pixels = 16
     1320           width-pixels  = 16
     1321           visible       = true
     1322           sensitive     = true
     1323           movable       = true
     1324           triggers:
     1325             on end-move persistent run diasize_end-move in this-procedure .
     1326           end triggers.
     1327         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1328         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1329         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1330         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1331         assign
     1332           v-diasize-wndmax = false
     1333         .
     1334         if connected("ub") = true
     1335         then do:
     1336           define variable v-cntxt-db-num        as integer   no-undo .
     1337           define variable v-cntxt-userid        as character no-undo .
     1338           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1339                                             , OUTPUT v-cntxt-userid
     1340                                             ) .
     1341           run gbl/wndpar_r.p
     1342             (input  v-cntxt-db-num
     1343             ,input  v-cntxt-userid
     1344             ,input  'wndmax':U
     1345             ,output v-diasize-wndmax
     1346             ,output v-default-value
     1347             ) .
     1348         end.
     1349         assign
     1350           v-diasize-wndstore = false
     1351         .
     1352         if connected("ub") = true
     1353         then do:
     1354           run gbl/wndpar_r.p
     1355             (input  v-cntxt-db-num
     1356             ,input  v-cntxt-userid
     1357             ,input  'wndstore':U
     1358             ,output v-diasize-wndstore
     1359             ,output v-default-value
     1360             ) .
     1361         end.
     1362         assign
     1363           v-diasize-proc-name = entry(1, program-name(2), '.')
     1364         .
     1365         if v-diasize-wndstore = true
     1366         then do:
     1367           assign
     1368             v-restore-saved = false
     1369           .
     1370           if connected("ub") = true
     1371           then do:
     1372             run gbl/wndsizer.p
     1373               (input  v-cntxt-db-num
     1374               ,input  v-cntxt-userid
     1375               ,input  v-diasize-proc-name
     1376               ,input  'height':u
     1377               ,output v-resize-value-str
     1378               ) .
     1379             if v-resize-value-str <> '':U
     1380             then do:
     1381               run diasize_change-height in this-procedure
     1382                 (input  integer(v-resize-value-str)
     1383                 ,input  true
     1384                 ) .
     1385               assign
     1386                 v-restore-saved = true
     1387               .
     1388             end.
     1389           end.
     1390           if connected("ub") = true
     1391           then do:
     1392             run gbl/wndsizer.p
     1393               (input  v-cntxt-db-num
     1394               ,input  v-cntxt-userid
     1395               ,input  v-diasize-proc-name
     1396               ,input  'width':u
     1397               ,output v-resize-value-str
     1398               ) .
     1399             if v-resize-value-str <> '':U
     1400             then do:
     1401               run diasize_change-width in this-procedure
     1402                 (input  integer(v-resize-value-str)
     1403                 ,input  true
     1404                 ) .
     1405               assign
     1406                 v-restore-saved = true
     1407               .
     1408             end.
     1409           end.
     1410           if v-restore-saved <> true
     1411           then do:
     1412             if v-diasize-wndmax = true
     1413             then do:
     1414               run diasize_maximize in this-procedure
     1415                 (input  true
     1416                 ) .
     1417             end.
     1418           end.
     1419         end.
     1420         else do:
     1421           if v-diasize-wndmax = true
     1422           then do:
     1423             run diasize_maximize in this-procedure
     1424               (input  true
     1425               ) .
     1426           end.
     1427         end.
     1428       end.
     1429     end.
     1430   end procedure.
     1431   procedure diasize_need-full-display :
     1432     define output parameter p-need-full-display as logical   no-undo .
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436       assign
     1437         p-need-full-display = v-diasize-need-full-display
     1438       .
     1439       assign
     1440         v-diasize-need-full-display = false
     1441       .
     1442     end.
     1443   end procedure.
     1444   procedure get-context :
     1445      define output parameter p-db-num as integer          no-undo.
     1446      define output parameter p-user-id as character        no-undo.
     1447      define variable v-login               as character    no-undo.
     1448      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1449      define buffer buf_user-login  for ub.user-login .
     1450      do
     1451      on error undo, return error
     1452      :
     1453            FIND FIRST buf_sys-ctrl no-lock.
     1454            ASSIGN
     1455               v-login = USERID("ub")
     1456               p-db-num = buf_sys-ctrl.db-num
     1457            .
     1458            FIND FIRST buf_user-login
     1459                 WHERE buf_user-login.db-num = p-db-num
     1460                   AND buf_user-login.user-login = v-login
     1461                 no-lock
     1462                 no-error
     1463                 .
     1464            IF AVAILABLE buf_user-login
     1465            THEN DO:
     1466               assign
     1467                  p-user-id = buf_user-login.user-id
     1468               .
     1469            END.
     1470      end.
     1471   end procedure.
     1472       run diasize_init in this-procedure .
     1473   MAIN-BLOCK:
     1474   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1475      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1476     FIND FIRST bf_c-trn-doc WHERE bf_c-trn-doc.doc-code = pardoc-code and
     1477                                   bf_c-trn-doc.chip-num = parchip-num NO-LOCK.
     1478     RUN cr-tt-fo IN THIS-PROCEDURE.
     1479     ASSIGN FRAME
     1480     Dialog-Frame:TITLE = "Финансовые обязательства по удаленному складскому документу " + pardoc-code.
     1481     assign
     1482     bf_fin-connect.sum-rubl:label in browse b-fin-doc = "Сумма связи (руб)"
     1483     tt-fo.sum-rubl:label in browse b-ob               = "Общая сумма (руб)"
     1484     tt-fo.sum-rubl-trn:label in browse b-ob           = "Сумма по док. (руб)"
     1485     bf_c-parts.price-rubl:label in browse b-c-parts   = "Цена (руб)"
     1486     .
     1487     RUN enable_UI.
     1488     RUN open-c-parts-query IN THIS-PROCEDURE.
     1489     RUN open-fin-doc-query IN THIS-PROCEDURE.
     1490     WAIT-FOR GO OF FRAME Dialog-Frame.
     1491   END.
     1492   RUN disable_UI.
     1493   PROCEDURE cr-tt-fo :
     1494   FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.obj-type = bf_c-trn-doc.obj-type AND
     1495                                  bf_fin-gds-part.obj-code = bf_c-trn-doc.obj-code AND
     1496                                  bf_fin-gds-part.out-code = bf_c-trn-doc.doc-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1497       FIND FIRST bf_fin-ob WHERE bf_fin-ob.host-code = bf_fin-gds-part.host-code   AND
     1498                                  bf_fin-ob.doc-code  = bf_fin-gds-part.fin-ob-code NO-LOCK no-error.
     1499       if available bf_fin-ob then do:
     1500         FIND FIRST tt-fo WHERE tt-fo.host-code = bf_fin-ob.host-code AND
     1501                                tt-fo.doc-code  = bf_fin-ob.doc-code  NO-ERROR.
     1502         IF NOT AVAILABLE tt-fo THEN DO:
     1503           CREATE tt-fo.
     1504           BUFFER-COPY bf_fin-ob TO tt-fo.
     1505         END.
     1506         ASSIGN
     1507           tt-fo.sum-base-trn = tt-fo.sum-base-trn + bf_fin-gds-part.sum-base
     1508           tt-fo.sum-rubl-trn = tt-fo.sum-rubl-trn + bf_fin-gds-part.sum-rubl
     1509         .
     1510      end.
     1511   END.
     1512   END PROCEDURE.
     1513   PROCEDURE disable_UI :
     1514     HIDE FRAME Dialog-Frame.
     1515   END PROCEDURE.
     1516   PROCEDURE enable_UI :
     1517     ENABLE b-exit b-help b-ob b-c-parts b-fin-doc
     1518         WITH FRAME Dialog-Frame.
     1519     VIEW FRAME Dialog-Frame.
     1520     OPEN QUERY b-ob FOR EACH tt-fo.
     1521   END PROCEDURE.
     1522   PROCEDURE open-fin-doc-query :
     1523   IF AVAILABLE tt-fo THEN DO:
     1524       OPEN QUERY b-fin-doc
     1525           FOR EACH bf_fin-connect WHERE bf_fin-connect.host-code = tt-fo.host-code  AND
     1526                                         bf_fin-connect.fin-ob-code = tt-fo.doc-code NO-LOCK,
     1527           FIRST bf_fin-doc WHERE bf_fin-doc.host-code    = bf_fin-connect.host-code    AND
     1528                                  bf_fin-doc.fin-doc-code = bf_fin-connect.fin-doc-code NO-LOCK.
     1529       DISPLAY b-fin-doc WITH FRAME Dialog-Frame.
     1530   END.
     1531   END PROCEDURE.
     1532   PROCEDURE open-c-parts-query :
     1533   IF AVAILABLE tt-fo THEN DO:
     1534       OPEN QUERY b-c-parts
     1535           FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.host-code   = tt-fo.host-code AND
     1536                                          bf_fin-gds-part.fin-ob-code = tt-fo.doc-code  AND
     1537                                          bf_fin-gds-part.out-code    = pardoc-code     NO-LOCK,
     1538           first bf_goods where bf_goods.gds-code = bf_fin-gds-part.gds-code no-lock,
     1539           FIRST bf_c-parts WHERE bf_c-parts.obj-type = bf_fin-gds-part.obj-type AND
     1540                                bf_c-parts.obj-code = bf_fin-gds-part.obj-code AND
     1541                                bf_c-parts.artic    = bf_goods.artic AND
     1542                                bf_c-parts.prod-type = bf_goods.prod-type AND
     1543                                bf_c-parts.prod-code = bf_goods.prod-code AND
     1544                                bf_c-parts.in-code   = bf_fin-gds-part.in-code AND
     1545                                bf_c-parts.out-code  = bf_fin-gds-part.out-code AND
     1546                                bf_c-parts.chip-num  = parchip-num and
     1547                                bf_c-parts.part-code = bf_fin-gds-part.part-code NO-LOCK.
     1548       DISPLAY b-c-parts WITH FRAME Dialog-Frame.
     1549   END.
     1550   END PROCEDURE.
