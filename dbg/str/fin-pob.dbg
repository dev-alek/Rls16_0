     1079        LABEL "Па&ртии"
     1080        SIZE 10 BY 1 TOOLTIP "Просмотр складского документа"
     1081        BGCOLOR 8 .
     1082   DEFINE BUTTON B-print
     1083        LABEL "Пе&чать"
     1084        SIZE 10 BY 1 TOOLTIP "Печать текущего списка"
     1085        BGCOLOR 8 .
     1086   DEFINE BUTTON B-sch
     1087        LABEL "&Фильтр"
     1088        SIZE 10 BY 1 TOOLTIP "Фильтрация списка"
     1089        BGCOLOR 8 .
     1090   DEFINE BUTTON B-sel AUTO-GO
     1091        LABEL "Вы&бор"
     1092        SIZE 10 BY 1 TOOLTIP "Выбор отмеченных или текущей записи"
     1093        BGCOLOR 8 .
     1094   DEFINE BUTTON B-trn
     1095        LABEL "Р&Н"
     1096        SIZE 7 BY 1 TOOLTIP "Просмотр складского документа"
     1097        BGCOLOR 8 .
     1098   DEFINE BUTTON B-trn-2
     1099        LABEL "ПН"
     1100        SIZE 7 BY 1 TOOLTIP "Просмотр складского документа"
     1101        BGCOLOR 8 .
     1102   DEFINE VARIABLE d-abbr AS CHARACTER FORMAT "X(256)":U
     1103         VIEW-AS TEXT
     1104        SIZE 3.88 BY .67
     1105        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1106   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "ПОИСК ПО"
     1107         VIEW-AS TEXT
     1108        SIZE 9 BY .67
     1109        FGCOLOR 4  NO-UNDO.
     1110   DEFINE VARIABLE loc_payer-name AS CHARACTER FORMAT "X(40)"
     1111        LABEL "Плательщик"
     1112         VIEW-AS TEXT
     1113        SIZE 21.13 BY .67
     1114        FGCOLOR 4  NO-UNDO.
     1115   DEFINE VARIABLE loc_receiver-name AS CHARACTER FORMAT "X(40)"
     1116        LABEL "Получатель"
     1117         VIEW-AS TEXT
     1118        SIZE 21.13 BY .67
     1119        FGCOLOR 4  NO-UNDO.
     1120   DEFINE VARIABLE loc_sum-base AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99" INITIAL 0
     1121        LABEL "Сумма б.в."
     1122         VIEW-AS TEXT
     1123        SIZE 17.5 BY .67 NO-UNDO.
     1124   DEFINE VARIABLE loc_sum-contr AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99" INITIAL 0
     1125        LABEL "Сумма дог."
     1126         VIEW-AS TEXT
     1127        SIZE 17.5 BY .67 TOOLTIP "Сумма в валюте договора" NO-UNDO.
     1128   DEFINE VARIABLE loc_sum-doc AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99" INITIAL 0
     1129        LABEL "Сумма док."
     1130         VIEW-AS TEXT
     1131        SIZE 17.5 BY .67 NO-UNDO.
     1132   DEFINE VARIABLE loc_sum-rubl AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99" INITIAL 0
     1133        LABEL "Сумма abbr_rub."
     1134         VIEW-AS TEXT
     1135        SIZE 17.5 BY .67 NO-UNDO.
     1136   DEFINE VARIABLE loc_user-name AS CHARACTER FORMAT "X(10)"
     1137        LABEL "Создал"
     1138         VIEW-AS TEXT
     1139        SIZE 12.88 BY .67 NO-UNDO.
     1140   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1141         VIEW-AS TEXT
     1142        SIZE 6 BY 1
     1143        FGCOLOR 4  NO-UNDO.
     1144   DEFINE VARIABLE p-date AS DATE FORMAT "99/99/9999":U
     1145        LABEL "Дата"
     1146        VIEW-AS FILL-IN
     1147        SIZE 12.75 BY 1 TOOLTIP "Поиск по дате создания пред.фин.об. Поиск первой записи - <ВВОД>;  поиск следующей - <CTRL-J>"
     1148        FGCOLOR 4  NO-UNDO.
     1149   DEFINE VARIABLE p-desc AS CHARACTER FORMAT "X(80)":U
     1150        LABEL "№ договора"
     1151        VIEW-AS FILL-IN
     1152        SIZE 12.75 BY 1 TOOLTIP "Поиск по № договора  Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>"
     1153        FGCOLOR 4  NO-UNDO.
     1154   DEFINE VARIABLE p-desc-2 AS CHARACTER FORMAT "X(80)":U
     1155        LABEL "№ РН"
     1156        VIEW-AS FILL-IN
     1157        SIZE 12.75 BY 1 TOOLTIP "Поиск по № РН  Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>"
     1158        FGCOLOR 4  NO-UNDO.
     1159   DEFINE VARIABLE r-abbr AS CHARACTER FORMAT "X(256)":U INITIAL "abbr_rub_allshift"
     1160         VIEW-AS TEXT
     1161        SIZE 3.88 BY .67
     1162        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1163   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(12)":U
     1164        LABEL "№ ПредФинОбяз"
     1165        VIEW-AS FILL-IN
     1166        SIZE 14 BY 1 TOOLTIP "Поиск по номеру Поиск первой записи - <ВВОД>; поиск следующей -  <CTRL-J>"
     1167        FGCOLOR 4  NO-UNDO.
     1168   DEFINE VARIABLE scr-proc AS DECIMAL FORMAT "->>>>9.99%":U INITIAL 0
     1169         VIEW-AS TEXT
     1170        SIZE 9.5 BY .67 TOOLTIP "Процент суммы ПФО к сумме ПН"
     1171        BGCOLOR 4 FGCOLOR 15  NO-UNDO.
     1172   DEFINE VARIABLE v-abbr AS CHARACTER FORMAT "X(256)":U
     1173         VIEW-AS TEXT
     1174        SIZE 3.88 BY .67
     1175        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1176   DEFINE VARIABLE v-abbr-contr AS CHARACTER FORMAT "X(256)":U
     1177         VIEW-AS TEXT
     1178        SIZE 3.88 BY .67
     1179        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1180   DEFINE VARIABLE T-paket AS LOGICAL INITIAL no
     1181        LABEL "П&акетный режим"
     1182        VIEW-AS TOGGLE-BOX
     1183        SIZE 20.5 BY .83 TOOLTIP "Работа с выделенным списком пред.финобязательств" NO-UNDO.
     1184   DEFINE QUERY BR-docs FOR
     1185         buf_fin-liab-before SCROLLING.
     1186   DEFINE QUERY Dialog-Frame FOR
     1187         ub.fin-ob-before SCROLLING.
     1188   DEFINE BROWSE BR-docs
     1189     QUERY BR-docs DISPLAY
     1190         mark-string(recid( ub.buf_fin-liab-before), rid-list)    COLUMN-LABEL '*'          FORMAT "x(1)"
     1191        buf_fin-liab-before.prn-doc-code    COLUMN-LABEL '№ ПФО'          Format "x(10)"
     1192        val-abbr-type(recid( buf_fin-liab-before))  @ l-curr  COLUMN-LABEL 'Вал'         Format "x(3)"
     1193        buf_fin-liab-before.sum-doc   COLUMN-LABEL 'Сумма в вал.док.'
     1194        buf_fin-liab-before.trn-doc-code   COLUMN-LABEL '№ РН'         Format "x(14)"
     1195        buf_fin-liab-before.doc-code   COLUMN-LABEL 'ФинОб'         Format "x(14)"
     1196        buf_fin-liab-before.trn-doc-code-orig   COLUMN-LABEL '№ ПН'         Format "x(14)"
     1197        substring(string(buf_fin-liab-before.doc-date),1,5)    COLUMN-LABEL 'Создан'          format "x(5)"
     1198        buf_fin-liab-before.fact-date    COLUMN-LABEL 'Закрыт'          format "99/99/99"
     1199        contract-id(recid( buf_fin-liab-before))  @ p-contr  COLUMN-LABEL 'Договор'          Format "x(16)"
     1200        (buf_fin-liab-before.receiver-type + ' ' + string(buf_fin-liab-before.receiver-code))    COLUMN-LABEL 'Получатель'          Format "x(10)"
     1201        (buf_fin-liab-before.payer-type + ' ' + string(buf_fin-liab-before.payer-code))    COLUMN-LABEL 'Плательщик'          Format "x(10)"
     1202        buf_fin-liab-before.sum-rubl   COLUMN-LABEL 'Сумма РУБ'
     1203          buf_fin-liab-before.status_
     1204         enable buf_fin-liab-before.prn-doc-code
     1205       WITH NO-ROW-MARKERS SEPARATORS SIZE 93.75 BY 15.79.
     1206   DEFINE FRAME Dialog-Frame
     1207        B-exit AT ROW 1 COL 1
     1208        B-mark AT ROW 1 COL 11
     1209        B-sel AT ROW 1 COL 21
     1210        B-sch AT ROW 1 COL 31
     1211        b-exec-fo AT ROW 1 COL 41
     1212        B-trn AT ROW 1 COL 51
     1213        B-trn-2 AT ROW 1 COL 58
     1214        B-parts AT ROW 1 COL 65.13
     1215        B-print AT ROW 1 COL 75.13
     1216        B-Help AT ROW 1 COL 85.13
     1217        B-lkp AT ROW 2.13 COL 1
     1218        B-del AT ROW 2.13 COL 11
     1219        B-fo AT ROW 2.13 COL 21
     1220        B-Export AT ROW 2.13 COL 31
     1221        BR-docs AT ROW 3.25 COL 1.25
     1222        T-paket AT ROW 19.96 COL 74.13
     1223        sch-code AT ROW 22.5 COL 1.5
     1224        p-date AT ROW 22.5 COL 31.5
     1225        p-desc-2 AT ROW 22.5 COL 51
     1226        p-desc AT ROW 22.5 COL 70.5
     1227        mark-num AT ROW 1 COL 14.88 NO-LABEL
     1228        scr-proc AT ROW 2.25 COL 83.5 COLON-ALIGNED NO-LABEL
     1229        loc_receiver-name AT ROW 19.13 COL 1.88
     1230        loc_sum-doc AT ROW 19.13 COL 45.25 COLON-ALIGNED
     1231        d-abbr AT ROW 19.13 COL 63.63 COLON-ALIGNED NO-LABEL
     1232        loc_user-name AT ROW 19.13 COL 79.88 COLON-ALIGNED
     1233        loc_payer-name AT ROW 19.96 COL 1.88
     1234        loc_sum-rubl AT ROW 19.96 COL 45.25 COLON-ALIGNED
     1235        r-abbr AT ROW 19.96 COL 63.63 COLON-ALIGNED NO-LABEL
     1236        loc_sum-base AT ROW 20.79 COL 45.25 COLON-ALIGNED
     1237        v-abbr AT ROW 20.79 COL 63.63 COLON-ALIGNED NO-LABEL
     1238        loc_sum-contr AT ROW 21.58 COL 45.25 COLON-ALIGNED
     1239        v-abbr-contr AT ROW 21.58 COL 63.63 COLON-ALIGNED NO-LABEL
     1240        FILL-IN-1 AT ROW 21.88 COL 1 NO-LABEL
     1241        SPACE(85.62) SKIP(1.03)
     1242       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1243            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1244            TITLE "ПредФинОбязательства"
     1245            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-exit.
     1246   ASSIGN
     1247          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1248          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1249   ASSIGN
     1250          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
     1251   ASSIGN
     1252          T-paket:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1253   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1254   DO:
     1255     APPLY "END-ERROR":U TO SELF.
     1256   END.
     1257   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1258   DO:
     1259   if not available buf_fin-liab-before then return .
     1260   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   do:
     1262     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1263       (input  v-cntxt-db-num
     1264       ,input  v-cntxt-userid
     1265       ,input  0
     1266       ,input  'actn_fin-liability_deletion':U
     1267       ,input  'firm':U
     1268       ,input  par-host-code
     1269       ,input  '':U
     1270       ,input  0
     1271       ,input  0
     1272       ,input  0
     1273       ,input  0
     1274       ,input  true
     1275       ,output g-log
     1276       )  .
     1277   end.
     1278   if not g-log then  return .
     1279     else do:
     1280         message "Удалить запись ?"
     1281         view-as alert-box question
     1282         buttons yes-no
     1283         update g-log.
     1284         if g-log = false then return no-apply.
     1285     end.
     1286     if  buf_fin-liab-before.status_ = 'факт':U then do:
     1287         message "ПредФинОбязательство в статусе ФАКТ не может быть удалено !!!"
     1288         view-as alert-box information .
     1289         return no-apply.
     1290     end.
     1291     find current buf_fin-liab-before  exclusive-lock  no-error .
     1292     if available buf_fin-liab-before then do:
     1293       delete buf_fin-liab-before .
     1294       run openbr in this-procedure (yes, no, '':u).
     1295     end.
     1296   END.
     1297   ON CHOOSE OF b-exec-fo IN FRAME Dialog-Frame
     1298   DO:
     1299   define variable par-text as character no-undo .
     1300     run str/gen-bfl.p (
     1301         input parParentProc,
     1302         input par-host-code,
     1303         input true ,
     1304         output par-text
     1305         ).
     1306     run openbr in this-procedure (yes, no, '':u).
     1307   END.
     1308   ON CHOOSE OF B-Export IN FRAME Dialog-Frame
     1309   DO:
     1310   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   do:
     1312     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1313       (input  v-cntxt-db-num
     1314       ,input  v-cntxt-userid
     1315       ,input  0
     1316       ,input  'actn_fin-liability_export':U
     1317       ,input  'firm':U
     1318       ,input  par-host-code
     1319       ,input  '':U
     1320       ,input  0
     1321       ,input  0
     1322       ,input  0
     1323       ,input  0
     1324       ,input  true
     1325       ,output g-log
     1326       )  .
     1327   end.
     1328   if not g-log then  return .
     1329     run proc-b-exp in this-procedure no-error.
     1330     if error-status:error then return no-apply.
     1331   END.
     1332   ON CHOOSE OF B-fo IN FRAME Dialog-Frame
     1333   DO:
     1334   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   do:
     1336     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1337       (input  v-cntxt-db-num
     1338       ,input  v-cntxt-userid
     1339       ,input  0
     1340       ,input  'actn_fin-liability_lookup':U
     1341       ,input  'firm':U
     1342       ,input  par-host-code
     1343       ,input  '':U
     1344       ,input  0
     1345       ,input  0
     1346       ,input  0
     1347       ,input  0
     1348       ,input  true
     1349       ,output g-log
     1350       )  .
     1351   end.
     1352   if not g-log then  return .
     1353   define variable rr as recid no-undo .
     1354   define variable v-doc-type like ub.fin-ob.doc-type  no-undo .
     1355   define variable v-status_  like ub.fin-ob.status_   no-undo .
     1356   define buffer buf_fin-ob for ub.fin-ob .
     1357   find first buf_fin-ob no-lock where buf_fin-ob.doc-code = buf_fin-liab-before.doc-code no-error .
     1358       if available buf_fin-ob then do:
     1359           rr = recid( buf_fin-ob ).
     1360           find first buf_fin-liab no-lock where recid (buf_fin-liab) = rr no-error .
     1361           v-doc-type = buf_fin-ob.doc-type .
     1362           v-status_  = buf_fin-ob.status_  .
     1363           br-handle = ? .
     1364           next-prev = ?.
     1365           run str/fi-liabi.w ( parParentProc, 'ПРОСМОТР':U , input-output rr , input par-host-code  , input v-doc-type, input v-status_).
     1366           br-handle = ? .
     1367        end.
     1368   END.
     1369   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1370   DO:
     1371   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   do:
     1373     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1374       (input  v-cntxt-db-num
     1375       ,input  v-cntxt-userid
     1376       ,input  0
     1377       ,input  'actn_fin-liability_lookup':U
     1378       ,input  'firm':U
     1379       ,input  par-host-code
     1380       ,input  '':U
     1381       ,input  0
     1382       ,input  0
     1383       ,input  0
     1384       ,input  0
     1385       ,input  true
     1386       ,output g-log
     1387       )  .
     1388   end.
     1389   if not g-log then  return .
     1390   define variable rr as recid no-undo .
     1391       if available buf_fin-liab-before then do:
     1392           rr = recid( buf_fin-liab-before ).
     1393           p-doc-type = buf_fin-liab-before.doc-type .
     1394           p-status_  = buf_fin-liab-before.status_  .
     1395         br-handle = BR-docs:handle in frame Dialog-Frame .
     1396         next-prev = no.
     1397         do while next-prev <> ?:
     1398           if not available buf_fin-liab-before then do:
     1399             message "Неправильный выбор документа.".
     1400             return no-apply.
     1401           end.
     1402           run str/fi-liabb.w ( parParentProc, 'ПРОСМОТР':U , input-output rr , input par-host-code  , input p-doc-type, input p-status_).
     1403           if br-handle = ? then reposition BR-docs to recid rr no-error.
     1404         end.
     1405        end.
     1406   END.
     1407   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1408   DO:
     1409         if available buf_fin-liab-before then do:
     1410   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   define variable v-str-recid16 as character no-undo .
     1412   define variable v-num-entry16 as integer   no-undo .
     1413   assign
     1414     v-str-recid16 = trim( string( recid( buf_fin-liab-before ) , "->>>>>>>>>>>9":U ) )
     1415     v-num-entry16 = lookup( v-str-recid16 , rid-list )
     1416   .
     1417   if v-num-entry16 > 0 then do:
     1418     assign
     1419       entry( v-num-entry16, rid-list ) = "":U
     1420       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1421     .
     1422   end.
     1423   else do:
     1424     assign
     1425       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1426     .
     1427   end.
     1428           g-log = br-docs:refresh() .
     1429           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1430               g-log = br-docs:select-next-row ().
     1431               apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1432           end.
     1433           if num-entries( rid-list ) = 0
     1434           then
     1435               hide mark-num in frame Dialog-Frame.
     1436           else do:
     1437               mark-num:screen-value in frame Dialog-Frame  = string (num-entries( rid-list )) .
     1438               enable mark-num with frame Dialog-Frame.
     1439               end.
     1440       end.
     1441       apply "entry" to br-docs in frame Dialog-Frame.
     1442   END.
     1443   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
     1444   DO:
     1445       if not available buf_fin-liab-before then return .
     1446       run str/fi-parts.w
     1447         (input parParentProc ,
     1448          input buf_fin-liab-before.before-code ,
     1449          input par-host-code  ) .
     1450   END.
     1451   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1452   DO:
     1453     run print-proc in this-procedure .
     1454   END.
     1455   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1456   DO:
     1457     run proc-b-sch in this-procedure no-error.
     1458     if error-status:error then return no-apply.
     1459   END.
     1460   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1461   DO:
     1462       if ( available buf_fin-liab-before ) AND ( rid-list = "" ) then
     1463       rid-list = string( recid( buf_fin-liab-before ) ) .
     1464   END.
     1465   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
     1466   DO:
     1467   define buffer buf_trn-doc for ub.trn-doc.
     1468   define buffer buff_fin-ob-trn for ub.fin-ob-trn.
     1469   define variable glog as logical no-undo .
     1470   if not available buf_fin-liab-before then return .
     1471   if  buf_fin-liab-before.trn-doc-code <> ""
     1472     and buf_fin-liab-before.trn-doc-code <> ?
     1473     then do:
     1474      find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_fin-liab-before.trn-doc-code no-error .
     1475      if available buf_trn-doc then do:
     1476         run str/fishdoc.p (  ParParentProc,
     1477                         par-host-code   ,
     1478                         buf_trn-doc.obj-type ,
     1479                         buf_trn-doc.obj-code ,
     1480                         buf_fin-liab-before.trn-doc-code ,
     1481                         ? ) .
     1482         end.
     1483     end.
     1484     else do:
     1485         find first buff_fin-ob-trn no-lock where buff_fin-ob-trn.doc-code = buf_fin-liab-before.before-code     no-error .
     1486         find first buf_trn-doc     no-lock where buf_trn-doc.doc-code     = buff_fin-ob-trn.trn-doc-code no-error .
     1487         if available buff_fin-ob-trn then do:
     1488                 run str/fishdoc.p ( ParParentProc,
     1489                     par-host-code        ,
     1490                     buf_trn-doc.obj-type ,
     1491                     buf_trn-doc.obj-code ,
     1492                     buff_fin-ob-trn.trn-doc-code ,
     1493                     ? ) .
     1494         end.
     1495     end.
     1496   END.
     1497   ON CHOOSE OF B-trn-2 IN FRAME Dialog-Frame
     1498   DO:
     1499   define buffer buf_trn-doc for ub.trn-doc.
     1500   define variable glog as logical no-undo .
     1501   if not available buf_fin-liab-before then return .
     1502   if  buf_fin-liab-before.trn-doc-code-orig <> ""
     1503     and buf_fin-liab-before.trn-doc-code-orig <> ?
     1504     then do:
     1505      find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_fin-liab-before.trn-doc-code-orig no-error .
     1506      if available buf_trn-doc then do:
     1507         run str/fishdoc.p (  ParParentProc,
     1508                    par-host-code ,
