     3149     END.
     3150   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3151   DEF VAR cur-clmn-numBR-docs as INT EXTENT 13 no-undo.
     3152   DEF VAR varmviBR-docs       as INT no-undo.
     3153   DEF VAR varmvjBR-docs       as INT no-undo.
     3154   DEF VAR varmvkBR-docs       as INT no-undo.
     3155   DEF VAR varmvlBR-docs       as INT no-undo.
     3156   DEF VAR move-elementBR-docs as INT no-undo.
     3157   def var jjBR-docs           as int no-undo.
     3158   do varmviBR-docs = 1 to EXTENT(cur-clmn-numBR-docs):
     3159     ASSIGN cur-clmn-numBR-docs[varmviBR-docs] = varmviBR-docs.
     3160   END.
     3161   RUN start-mv-clmnBR-docs.
     3162   PROCEDURE start-mv-clmnBR-docs:
     3163   def var old-session as logical no-undo.
     3164      old-session = SESSION:IMMEDIATE-DISPLAY.
     3165      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3166      SESSION:IMMEDIATE-DISPLAY = old-session.
     3167   END.
     3168   ON ctrl-cursor-right OF BROWSE BR-docs do:
     3169     RUN re-move-clmnBR-docs ( 3, 13).
     3170   END.
     3171   ON ctrl-cursor-left OF BROWSE BR-docs do:
     3172     RUN re-move-clmnBR-docs (13, 3).
     3173   END.
     3174   PROCEDURE re-move-clmnBR-docs:
     3175     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3176     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3177     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     3178       if cur-clmn-numBR-docs[varmviBR-docs] = source-column THEN cur-clmn-numBR-docs[varmviBR-docs] = -1.
     3179     END.
     3180     if BR-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3181     if source-column > target-column THEN
     3182     DO varmvjBR-docs = source-column - 1 to target-column BY -1:
     3183       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     3184           if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     3185             cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] + 1.
     3186           END.
     3187       END.
     3188     END.
     3189     ELSE
     3190     DO varmvjBR-docs = source-column + 1 to target-column:
     3191       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     3192         if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     3193           cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] - 1.
     3194         END.
     3195       END.
     3196     END.
     3197     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     3198       if cur-clmn-numBR-docs[varmviBR-docs] = -1 THEN cur-clmn-numBR-docs[varmviBR-docs] = target-column.
     3199     END.
     3200   END PROCEDURE.
     3201   PROCEDURE ch-clmnBR-docs:
     3202     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3203     if cur-clmn-loc <= 3 then do:
     3204       return .
     3205     end.
     3206     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     3207       if cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-loc THEN move-elementBR-docs = varmviBR-docs.
     3208     END.
     3209     RUN re-move-clmnBR-docs (cur-clmn-loc, 3).
     3210   END PROCEDURE.
     3211   PROCEDURE mv-brw-defaultBR-docs:
     3212   def var old-session as logical no-undo.
     3213     old-session = SESSION:IMMEDIATE-DISPLAY.
     3214     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3215     do varmvlBR-docs = 3 to EXTENT(cur-clmn-numBR-docs):
     3216       RUN re-move-clmnBR-docs (cur-clmn-numBR-docs[varmvlBR-docs], varmvlBR-docs).
     3217     END.
     3218     RUN start-mv-clmnBR-docs.
     3219     SESSION:IMMEDIATE-DISPLAY = old-session.
     3220   END PROCEDURE.
     3221   .
     3222   def var sort-labelBR-docs   as character no-undo .
     3223   def var sort-clmnBR-docs    as handle    no-undo .
     3224   def var cur-clmnBR-docs     as handle    no-undo .
     3225   def var cur-clmn-locBR-docs as integer   no-undo .
     3226   def var re-queryBR-docs     as logical   initial no no-undo .
     3227   on start-search, ctrl-o of BR-docs in frame Dialog-Frame do:
     3228      run sort-brBR-docs
     3229        (input (if available ub.fin-ob-before
     3230                then recid(ub.fin-ob-before)
     3231                else ?
     3232               )
     3233        ).
     3234   end.
     3235   PROCEDURE sort-brBR-docs :
     3236     define input parameter p-recid as recid no-undo .
     3237     if re-queryBR-docs = no then do:
     3238       assign
     3239          cur-clmnBR-docs = BR-docs:current-column in frame Dialog-Frame
     3240       .
     3241       if sort-clmnBR-docs <> ? then sort-clmnBR-docs:column-fgcolor = 0.
     3242       if cur-clmnBR-docs = sort-clmnBR-docs then do:
     3243         assign
     3244            sort-labelBR-docs = ""
     3245            sort-clmnBR-docs = ?
     3246         .
     3247        end.
     3248        else do:
     3249          assign
     3250            sort-labelBR-docs = cur-clmnBR-docs:label
     3251            sort-clmnBR-docs  = cur-clmnBR-docs
     3252            sort-clmnBR-docs:column-fgcolor = 4
     3253          .
     3254        end.
     3255      end.
     3256     assign
     3257       cur-clmn-locBR-docs = 1
     3258     .
     3259     def var column-handle as handle no-undo .
     3260     column-handle = BR-docs:first-column.
     3261     do while valid-handle(column-handle) :
     3262       if column-handle = cur-clmnBR-docs then do:
     3263         leave .
     3264       end.
     3265       column-handle = column-handle:NEXT-COLUMN.
     3266       assign
     3267         cur-clmn-locBR-docs = cur-clmn-locBR-docs + 1
     3268       .
     3269     end.
     3270     case sort-labelBR-docs:
     3271           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_fin-liab-before), &1&2&1)', chr(34), rid-list)     .     run OpenBr(yes, no, '':U).   . END.
     3272           when '№ ПФО'  then DO:    assign       sort-column-name = "buf_fin-liab-before.prn-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3273           when 'Создан'  then DO:    assign       sort-column-name = "substring(string(buf_fin-liab-before.doc-date),1,5)"     .     run OpenBr(yes, no, '':U).   . END.
     3274           when 'Закрыт'  then DO:    assign       sort-column-name = "buf_fin-liab-before.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3275           when 'Договор'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1contract-id&1, recid(buf_fin-liab-before))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3276           when 'Получатель'  then DO:    assign       sort-column-name = "(buf_fin-liab-before.receiver-type + ' ' + string(buf_fin-liab-before.receiver-code))"     .     run OpenBr(yes, no, '':U).   . END.
     3277           when 'Плательщик'  then DO:    assign       sort-column-name = "(buf_fin-liab-before.payer-type + ' ' + string(buf_fin-liab-before.payer-code))"     .     run OpenBr(yes, no, '':U).   . END.
     3278           when 'Сумма РУБ'  then DO:    assign       sort-column-name = "buf_fin-liab-before.sum-rubl"     .     run OpenBr(yes, no, '':U).   . END.
     3279           when 'Вал'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1val-abbr-type&1, recid(buf_fin-liab-before))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3280           when 'Сумма в вал.док.'  then DO:    assign       sort-column-name = "buf_fin-liab-before.sum-doc"     .     run OpenBr(yes, no, '':U).   . END.
     3281           when '№ РН'  then DO:    assign       sort-column-name = "buf_fin-liab-before.trn-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3282           when 'ФинОб'  then DO:    assign       sort-column-name = "buf_fin-liab-before.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3283           when '№ ПН'  then DO:    assign       sort-column-name = "buf_fin-liab-before.trn-doc-code-orig"     .     run OpenBr(yes, no, '':U).   . END.
     3284       otherwise do:
     3285         assign
     3286           sort-column-name = ""
     3287         .
     3288         run OpenBr(yes, no, '':U).
     3289           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-docs') then do:
     3290             run mv-brw-defaultBR-docs.
     3291           end.
     3292         if sort-labelBR-docs <> "" then do:
     3293           assign
     3294             cur-clmnBR-docs:column-fgcolor = 0
     3295           .
     3296         end.
     3297         assign
     3298           cur-clmn-locBR-docs = ?
     3299         .
     3300       end.
     3301     end case.
     3302       if cur-clmn-locBR-docs <> ? then do:
     3303         if can-do( this-procedure:internal-entries, 'ch-clmnBR-docs') then do:
     3304           run ch-clmnBR-docs in this-procedure (cur-clmn-locBR-docs).
     3305         end.
     3306       end.
     3307     if p-recid <> ? then do:
     3308       reposition BR-docs to recid p-recid no-error.
     3309       apply "value-changed" to BR-docs in frame Dialog-Frame.
     3310     end.
     3311     apply "entry" to BR-docs in frame Dialog-Frame.
     3312   END PROCEDURE.
     3313   procedure re-open-query-srt-clmnBR-docs:
     3314   if cur-clmnBR-docs = ? then do:
     3315      run OpenBr(yes, no, '':U).
     3316   end.
     3317   else do:
     3318      assign re-queryBR-docs = yes.
     3319      run sort-brBR-docs
     3320        (input (if available ub.fin-ob-before
     3321                then recid(ub.fin-ob-before)
     3322                else ?
     3323               )
     3324        ).
     3325      assign re-queryBR-docs = no.
     3326   end.
     3327   end.
     3328   MAIN-BLOCK:
     3329   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3330      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3331   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3332     run mainmenu_getcntxt in parparentproc
     3333       (output v-cntxt-db-num
     3334       ,output v-cntxt-userid
     3335       ,output v-cntxt-level
     3336       ,output v-cntxt-host-code-obj
     3337       ,output v-cntxt-obj-type
     3338       ,output v-cntxt-obj-code
     3339       ,output v-cntxt-db-num-obj
     3340       ,output v-cntxt-is-admin
     3341       ) .
     3342   define variable v-right-supp as logical no-undo .
     3343   v-right-supp = true .
     3344   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3345   do:
     3346     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3347       (input  v-cntxt-db-num
     3348       ,input  v-cntxt-userid
     3349       ,input  0
     3350       ,input  'actn_fin-supp':U
     3351       ,input  'firm':U
     3352       ,input  par-host-code
     3353       ,input  ''
     3354       ,input  0
     3355       ,input  0
     3356       ,input  0
     3357       ,input  0
     3358       ,input  true
     3359       ,output v-right-supp
     3360       )  .
     3361   end.
     3362    if v-right-supp = false then return .
     3363   buf_fin-liab-before.prn-doc-code:read-only in browse BR-docs = true .
     3364   define variable p-file-label as character no-undo .
     3365   p-file-label =  "Финансовые обязательства".
     3366   r-abbr =  "РУБ".
     3367   define buffer buf_clients for  ub.clients .
     3368   CASE par-mode:
     3369       WHEN 'фирма':U THEN DO:
     3370         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3371         if not available buf_clients then  return .
     3372       END.
     3373       WHEN "doc-type":U THEN DO:
     3374         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3375         if not available buf_clients then  return .
     3376       END.
     3377       WHEN "status":U THEN DO:
     3378         find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3379         if not available buf_clients then  return .
     3380       END.
     3381       WHEN "fin-ob":U THEN DO:
     3382       end.
     3383       otherwise do:
     3384         message vss-workfile vss-revision vss-description skip
     3385         "Неверный вызов - par-mode=" par-mode
     3386         view-as alert-box ERROR.
     3387         return.
     3388       end.
     3389     end CASE.
     3390       if pardoc-rec <> ? then do:
     3391         FIND FIRST find_code No-LOCK where
     3392                    recid(find_code) = pardoc-rec No-ERROR.
     3393         if not avail find_code then do:
     3394           message
     3395           vss-workfile vss-revision vss-description skip
     3396           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3397           view-as alert-box error .
     3398           return error.
     3399         end.
     3400         doc-rec = pardoc-rec.
     3401       end.
     3402     run calc-proc.
     3403     run my-enable_ui.
     3404     run openbr in this-procedure (yes, no, '':u).
     3405     hide mark-num in frame Dialog-Frame .
     3406     if pardoc-rec <> ? then
     3407     reposition br-docs to recid doc-rec no-error.
     3408     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     3409     WAIT-FOR GO OF FRAME Dialog-Frame focus br-docs.
     3410   END.
     3411   run disable_ui.
     3412   PROCEDURE calc-proc :
     3413    do
     3414    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3415    :
     3416   define buffer buf1_fin-ob for ub.fin-ob.
     3417   define buffer buf1_fin-ob-before for ub.fin-ob-before.
     3418   define variable v-PFO-sum as decimal no-undo init 0.
     3419   define variable v-FO-sum as decimal no-undo init 0 .
     3420   find first buf1_fin-ob no-lock  where
     3421              buf1_fin-ob.host-code = par-host-code and
     3422              buf1_fin-ob.doc-code  =  p-char
     3423              no-error .
     3424   if error-status :error then return .
     3425   v-FO-sum = abs(buf1_fin-ob.sum-doc) .
     3426   for each buf1_fin-ob-before no-lock where
     3427       buf1_fin-ob-before.doc-code = p-char  and
     3428       buf1_fin-ob-before.host-code = par-host-code
     3429       on error undo, return error :
     3430       v-PFO-sum = v-PFO-sum + buf1_fin-ob-before.sum-doc .
     3431   end.
     3432   scr-proc =  100 * v-PFO-sum / v-FO-sum.
     3433     end.
     3434   END PROCEDURE.
     3435   PROCEDURE disable_UI :
     3436     HIDE FRAME Dialog-Frame.
     3437   END PROCEDURE.
     3438   PROCEDURE enable_UI :
     3439     OPEN QUERY Dialog-Frame FOR EACH ub.fin-ob-before SHARE-LOCK.
     3440     GET FIRST Dialog-Frame.
     3441     DISPLAY T-paket sch-code p-date p-desc-2 p-desc mark-num scr-proc
     3442             loc_receiver-name loc_sum-doc d-abbr loc_user-name loc_payer-name
     3443             loc_sum-rubl r-abbr loc_sum-base v-abbr loc_sum-contr v-abbr-contr
     3444             FILL-IN-1
     3445         WITH FRAME Dialog-Frame.
     3446     ENABLE B-exit B-mark B-sel B-sch b-exec-fo B-trn B-trn-2 B-parts B-print
     3447            B-Help B-lkp B-del B-fo B-Export BR-docs sch-code p-date p-desc-2
     3448            p-desc mark-num scr-proc loc_receiver-name loc_sum-doc d-abbr
     3449            loc_user-name loc_payer-name loc_sum-rubl r-abbr loc_sum-base v-abbr
     3450            loc_sum-contr v-abbr-contr FILL-IN-1
     3451         WITH FRAME Dialog-Frame.
     3452     VIEW FRAME Dialog-Frame.
     3453     OPEN QUERY BR-docs FOR EACH buf_fin-liab-before share-lock.
     3454   END PROCEDURE.
     3455   PROCEDURE my-enable_UI :
     3456   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3458     (input  par-host-code
     3459     ,output p-base-code
     3460     )  .
     3461   assign
     3462   loc_sum-rubl:label in frame Dialog-Frame = "Сумма руб."
     3463   .
     3464   DISPLAY sch-code p-desc p-desc-2  p-date mark-num FILL-IN-1
     3465         scr-proc when par-mode = "fin-ob"
     3466         WITH FRAME Dialog-Frame.
     3467     ENABLE B-exit
     3468            B-lkp
     3469            b-exec-fo
     3470            b-trn
     3471            B-trn-2
     3472            b-parts
     3473            B-sch
     3474            B-print
     3475            B-Help
     3476            b-sel       when LOOKUP("b-sel":U,  bttns) > 0
     3477            b-mark      when LOOKUP("b-mark":U, bttns) > 0
     3478            b-del       when LOOKUP("b-del":U,  bttns) > 0
     3479            b-fo
     3480            b-export
     3481             BR-docs sch-code p-desc p-desc-2 p-date  mark-num
     3482            T-paket
     3483         WITH FRAME Dialog-Frame.
     3484     VIEW FRAME Dialog-Frame.
     3485     if  par-mode <> "fin-ob" then
     3486        hide  scr-proc in frame Dialog-Frame .
     3487   END PROCEDURE.
     3488   PROCEDURE OpenBr :
     3489   define input  parameter p-open-query     as logical   no-undo .
     3490   define input  parameter p-find-next      as logical   no-undo .
     3491   define input  parameter p-find-condition as character no-undo .
     3492   define variable  l-query-was-opened as logical no-undo .
     3493   define variable title0 as character no-undo.
     3494   define buffer buff_contract for ub.contract.
     3495   define variable loc_contract-code as character no-undo .
     3496   title0 = caps( "ПредФинОбязательства" ) + chr(32).
     3497   define variable  sort-column-phrase as character no-undo .
     3498   case sort-column-name :
     3499     when "" then do:
     3500       assign
     3501         sort-column-phrase = ""
     3502       .
     3503     end.
     3504     otherwise do:
     3505       assign
     3506         sort-column-phrase = "by " + sort-column-name
     3507       .
     3508     end.
     3509   end case.
     3510   define variable l-open-query as logical   no-undo .
     3511          find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3512          if not available buf_clients then return .
     3513          filter-point = filter-point0 + par-mode.
     3514     CASE par-mode :
     3515       WHEN 'фирма':U THEN DO:
     3516          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + " " +  string(par-host-code).
     3517   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3518   define variable  l-disable-where-29  as logical   no-undo .
     3519   define variable  l-filter-open-29    as logical   .
     3520   define variable  flt-rec-29       as recid     no-undo .
     3521   define variable  filter-name-29      as character no-undo .
     3522   define variable  where-phrase-29     as character no-undo .
     3523   define variable  sort-phrase-29      as character no-undo .
     3524   define variable  where-phrase-rus-29 as character no-undo .
     3525   define variable  sort-phrase-rus-29  as character no-undo .
     3526     run waitfram-show in this-procedure
     3527       (input "ЖДИТЕ ..."
     3528       ).
     3529   run gbl/flt-get.p
     3530     (input filter-point
     3531     ,output flt-rec-29
     3532     ,output filter-name-29
     3533     ,output where-phrase-29
     3534     ,output sort-phrase-29
     3535     ,output where-phrase-rus-29
     3536     ,output sort-phrase-rus-29
     3537     ).
     3538   if p-open-query then do:
     3539       run set-filter-name in this-procedure
     3540         (INPUT filter-name-29
     3541         ) no-error .
     3542     assign
     3543       l-filter-open-29 = false
     3544     .
     3545     if flt-rec-29 <> ?
     3546       or sort-column-phrase > ""
     3547     then do:
     3548       define variable  parameter-2-29 as character no-undo .
     3549       define variable  parameter-3-29 as character no-undo .
     3550       define variable  parameter-4-29 as character no-undo .
     3551       define variable  parameter-5-29 as character no-undo .
     3552       define variable  parameter-6-29 as character no-undo .
     3553       define variable  parameter-7-29 as character no-undo .
     3554         assign
     3555         parameter-3-29 =
     3556                                 "FOR EACH buf_fin-liab-before"
     3557         parameter-4-29 =
     3558           (
     3559             if (" buf_fin-liab-before.host-code = par-host-code   " + " " + where-phrase-29) <> ""
     3560             then substitute(' buf_fin-liab-before.host-code =   &1 ' , par-host-code ) + " " + where-phrase-29
     3561             else "true"
     3562           )
     3563         parameter-5-29 = (" " + "" + " " + "")
     3564         parameter-6-29 = if sort-phrase-29 = ''
     3565                              then
     3566           (
     3567           " " + " USE-INDEX by_date " +
     3568             " " + sort-column-phrase +
     3569           " " + "  "
     3570           )
     3571                              else
     3572           (
     3573           " " + " USE-INDEX by_date " +
     3574             " " + sort-column-phrase +
     3575           " " + sort-phrase-29
     3576           )
     3577         parameter-7-29 =
     3578           "   "
     3579       .
     3580       do
     3581       on stop undo, leave
     3582       on error undo, leave
     3583       :
     3584         assign
     3585           l-disable-where-29 =
     3586             (" buf_fin-liab-before.host-code = par-host-code   " + " " + where-phrase-29 = "")
     3587         .
     3588         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3589                             ,input query br-docs:handle
     3590                             ,input parameter-3-29
     3591                             ,input parameter-4-29
     3592                             ,input parameter-5-29
     3593                             ,input parameter-6-29
     3594                             ,input parameter-7-29
     3595                             )
     3596         .
     3597         assign
     3598           l-filter-open-29 = true
     3599         .
     3600       end.
     3601       if l-filter-open-29 = false then do:
     3602         message
     3603           "Ошибка при фильтрации / сортировке" skip
     3604           "Будут показаны записи без учета фильтра" skip
     3605           view-as alert-box .
     3606       end.
     3607       else do:
     3608           assign
     3609             l-query-was-opened = true
     3610           .
     3611       end.
     3612     end.
     3613     if l-filter-open-29 = false then do:
     3614       OPEN QUERY br-docs FOR EACH buf_fin-liab-before
     3615         where  buf_fin-liab-before.host-code = par-host-code
     3616          USE-INDEX by_date
     3617     .
     3618         assign
     3619           l-query-was-opened = true
     3620         .
     3621     end.
     3622   end.
     3623   else do:
     3624     assign
     3625       doc-rec = recid( buf_fin-liab-before )
     3626     .
     3627     do
     3628     on stop undo, leave
     3629     on error undo, leave
     3630     :
     3631       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_fin-liab-before:handle) then do:
     3632         assign
     3633         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3634         parameter-4-29 =
     3635           "where ":u + substitute(' buf_fin-liab-before.host-code =   &1 ' , par-host-code ) + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3636         parameter-5-29 = " USE-INDEX by_date "
     3637       .
     3638         run fltopend_fltfindd in this-procedure  (
     3639                             input this-procedure:handle
     3640                             ,input query br-docs:handle
     3641                             ,input rowid(buf_fin-liab-before)
     3642                             ,input logical(parameter-2-29)
     3643                             ,input no-lock
     3644                             ,input (buffer buf_fin-liab-before:handle)
     3645                             ,input parameter-4-29
     3646                             ,input parameter-5-29
     3647                             ) no-error.
     3648         .
     3649         assign
     3650           doc-rec = integer(return-value)
     3651           v-fltopend-rowid[1] = ?
     3652         .
     3653       end.
     3654       else do:
     3655         assign
     3656         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3657         parameter-3-29 =  "FOR EACH buf_fin-liab-before"
     3658         parameter-4-29 =
     3659           (
     3660             if (" buf_fin-liab-before.host-code = par-host-code   " + " " + where-phrase-29) <> ""
     3661             then substitute(' buf_fin-liab-before.host-code =   &1 ' , par-host-code ) + " " + where-phrase-29
     3662             else "true"
     3663           )
     3664         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3665         parameter-6-29 = if sort-phrase-29 = ''
     3666                              then
     3667           (
     3668           " " + " USE-INDEX by_date " +
     3669             " " + sort-column-phrase +
     3670           " " + "  "
     3671           )
     3672                              else
     3673           (
     3674           " " + " USE-INDEX by_date " +
     3675             " " + sort-column-phrase +
     3676           " " + sort-phrase-29
     3677           )
     3678         parameter-7-29 =
     3679           "   "
     3680       .
     3681         run fltopend_fltfindq in this-procedure  (
     3682                             input this-procedure:handle
     3683                             ,input query br-docs:handle
     3684                             ,input logical(parameter-2-29)
     3685                             ,input no-lock
     3686                             ,input parameter-3-29
     3687                             ,input parameter-4-29
     3688                             ,input parameter-5-29
     3689                             ,input parameter-6-29
     3690                             ,input parameter-7-29
     3691                             ,output v-fltopend-rowid
     3692                             ) no-error.
     3693         .
     3694         doc-rec = ?.
     3695       end.
     3696       assign
     3697         l-query-was-opened = true
     3698       .
     3699     end.
     3700   end.
     3701     run waitfram-hide in this-procedure .
