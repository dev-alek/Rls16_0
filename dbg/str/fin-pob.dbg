      374   procedure fltfield-clear :
      375     define output parameter loc-fld as character no-undo.
      376     define output parameter loc-lab as character no-undo .
      377     define output parameter loc-spr as character no-undo .
      378     define output parameter loc-dim as character no-undo .
      379     assign
      380       loc-fld = ""
      381       loc-lab = ""
      382       loc-spr = ""
      383       loc-dim = "0"
      384     .
      385   end procedure .
      386   procedure fltfield-add :
      387     define input        parameter par-fld as character no-undo.
      388     define input        parameter par-lab as character no-undo .
      389     define input        parameter par-spr as character no-undo .
      390     define input-output parameter loc-fld as character no-undo.
      391     define input-output parameter loc-lab as character no-undo .
      392     define input-output parameter loc-spr as character no-undo .
      393     define input-output parameter loc-dim as character no-undo .
      394     do
      395     on error undo, return error
      396     :
      397       assign
      398       loc-fld = if loc-dim = '0'
      399                 then par-fld
      400                 else (loc-fld + chr(44) + par-fld)
      401       loc-lab = if loc-dim = '0'
      402                 then par-lab
      403                 else (loc-lab + chr(44) + par-lab)
      404       loc-spr = if loc-dim = '0'
      405                 then par-spr
      406                 else (loc-spr + chr(44) + par-spr)
      407       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      408                 string(integer(if num-entries(loc-dim) > 1
      409                               then entry(2, loc-dim)
      410                               else entry(1, loc-dim)
      411                               ) + 1)
      412       no-error
      413       .
      414     end.
      415   end procedure.
      416   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   define  stream PrnLibStream.
      418   procedure prn-lib-prn-file :
      419     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      420     define input parameter p-DIsabledoptions as integer no-undo .
      421     define variable v-report-name as character no-undo .
      422     define variable v-user-action as character no-undo .
      423     define variable v-printed     as logical   no-undo .
      424     define variable v-exist       as logical   no-undo .
      425     do
      426       on error undo, return error
      427       :
      428       run prn-lib-get-report-name  in this-procedure (
      429         input parParentProc
      430         ,output v-report-name
      431         ).
      432   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      434     (input  v-report-name
      435     ,input  2
      436     ,output v-exist
      437     )  .
      438       if NOT v-exist then
      439       DO:
      440         Message
      441           "Нет заданий на печать ! "
      442           view-as alert-box .
      443         Return  .
      444       End.
      445       run gbl/prnfilen.w
      446         (input  ""
      447         ,input  p-DisabledOptions
      448         ,input  string(v-report-name )
      449         ,input  7
      450         ,output v-user-action
      451         ,output v-printed
      452         ) .
      453       if v-printed then
      454       do:
      455         return "YES" .
      456       end.
      457       else
      458       do:
      459         return "NO" .
      460       end.
      461     end.
      462   end procedure.
      463   procedure prn-lib-open-stream :
      464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      465     define input parameter p-page-size    as integer no-undo .
      466     define input parameter p-is-stream    as logical no-undo .
      467     define input parameter p-append       as logical no-undo .
      468     define variable v-report-name as character no-undo .
      469     do
      470       on error undo, return error
      471       :
      472       run prn-lib-get-report-name  in this-procedure (
      473         input parParentProc
      474         ,output v-report-name
      475         ).
      476       if p-is-stream then
      477       do:
      478         if p-append then
      479         do:
      480           output stream PrnLibStream to value( v-report-name )
      481             page-size value(p-page-size) append .
      482         end.
      483         if not p-append then
      484         do:
      485           output stream PrnLibStream to value( v-report-name )
      486             page-size value(p-page-size) .
      487         end.
      488       end.
      489       if not p-is-stream then
      490       do:
      491         if p-append then
      492         do:
      493           output to value( v-report-name )
      494             page-size value(p-page-size) append .
      495         end.
      496         if not p-append then
      497         do:
      498           output to value( v-report-name )
      499             page-size value(p-page-size) .
      500         end.
      501       end.
      502     end.
      503   end procedure.
      504   procedure prn-lib-open-exp :
      505     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      506     define input parameter p-is-stream    as logical no-undo .
      507     define input parameter p-is-append    as logical no-undo .
      508     define output parameter p-ReportFileName as char init "report" no-undo.
      509     define output parameter p-process as logical no-undo .
      510     define variable glog as logical no-undo .
      511     do
      512       on error undo, return error
      513       :
      514       SYSTEM-DIALOG GET-FILE p-ReportFileName
      515         TITLE      "Укажите путь"
      516         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      517         ASK-OVERWRITE
      518         CREATE-TEST-FILE
      519         SAVE-AS
      520         USE-FILENAME
      521         DEFAULT-EXTENSION "txt"
      522         UPDATE glog
      523         .
      524       if not glog then  return.
      525       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      526       if p-is-stream then
      527       do:
      528         if p-is-append then
      529         do:
      530           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      531         end.
      532         else
      533         do:
      534           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      535         end.
      536       end.
      537       else
      538       do:
      539         if p-is-append then
      540         do:
      541           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      542         end.
      543         else
      544         do:
      545           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      546         end.
      547       end.
      548       p-process = yes.
      549     end.
      550   end procedure.
      551   procedure prn-lib-get-report-name :
      552     define input parameter parParentProc  as widget-handle no-undo.
      553     define output parameter p-report-name as character no-undo .
      554     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      555   end procedure.
      556   procedure prn-lib-reportviewer-report-name :
