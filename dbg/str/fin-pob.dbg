     1669   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1670   procedure minbtn-set :
     1671       do
     1672           on error undo, return error return-value
     1673           :
     1674           define variable ii              as integer       no-undo .
     1675           define variable fh              as widget-handle no-undo .
     1676           define variable hh              as widget-handle no-undo .
     1677           define variable v-h             as handle        extent 4 no-undo .
     1678           define variable v-name-button   as character     no-undo .
     1679           define variable v-help-old-x    as decimal       no-undo .
     1680           define variable v-help-old-y    as decimal       no-undo .
     1681           define variable v-help-old-size as decimal       no-undo .
     1682           define variable v-frame-width   as decimal       no-undo .
     1683           define variable jj              as integer       no-undo .
     1684           do
     1685               on error undo, return error
     1686               :
     1687               assign
     1688                   v-frame-width = frame Dialog-Frame:width - 0.3
     1689                   fh            = frame Dialog-Frame:first-child
     1690                   hh            = fh:first-child
     1691                   ii            = 1
     1692                   .
     1693               do while valid-handle(hh):
     1694                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1695                   do:
     1696                       case lc(hh:name) :
     1697                           when "b-help" then
     1698                               do:
     1699                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1700                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1701                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1702                                   hh:TOOLTIP = "Помощь" .
     1703                                   v-help-old-x = hh:column .
     1704                                   v-help-old-y = hh:row    .
     1705                                   v-help-old-size = hh:width .
     1706                                   hh:width-chars = 2.5 .
     1707                               end.
     1708                           when "b-print" then
     1709                               do:
     1710                                   hh:load-image("cmp/b-print.bmp":u) .
     1711                                   hh:TOOLTIP = "Печать" .
     1712                                   v-h[ii] = hh:handle .
     1713                                   ii = ii + 1 .
     1714                                   hh:width-chars = 3 .
     1715                               end.
     1716                           when "b-history" or
     1717                           when "b-hist" then
     1718                               do:
     1719                                   hh:load-image("cmp/b-hist.bmp":u) .
     1720                                   hh:TOOLTIP = "История" .
     1721                                   v-h[ii] = hh:handle .
     1722                                   ii = ii + 1 .
     1723                                   hh:width-chars = 3 .
     1724                               end.
     1725                           when "b-sch" then
     1726                               do:
     1727                                   hh:load-image("cmp/b-sch.bmp":u) .
     1728                                   hh:TOOLTIP = "Установка Фильтра" .
     1729                                   v-h[ii] = hh:handle .
     1730                                   ii = ii + 1 .
     1731                                   hh:width-chars = 3 .
     1732                               end.
     1733                           when "b-hist-user" then
     1734                               do:
     1735                                   hh:load-image("cmp/b-hist.bmp":u) .
     1736                                   hh:TOOLTIP = "История пользователя" .
     1737                                   ii = ii + 1 .
     1738                               end.
     1739                       end case.
     1740                   end.
     1741                   hh = hh:next-sibling.
     1742               end.
     1743               b-help:column = v-frame-width - b-help:width-chars.
     1744               jj = 0.
     1745               repeat ii = 4 to 1 by -1 :
     1746                   if valid-handle (v-h[ii] ) then
     1747                   do:
     1748                       jj  = jj + 1 .
     1749                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1750                       v-h[ii]:row    = v-help-old-y .
     1751                   end.
     1752               end.
     1753           end.
     1754       end.
     1755   end procedure.
     1756   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1757   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1758   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1759   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1760   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1761   define variable v-diasize-current-frame-height as decimal   no-undo .
     1762   define variable v-diasize-change-size          as logical   no-undo .
     1763   define variable v-diasize-resize-button        as handle    no-undo .
     1764   define variable v-diasize-wndmax               as logical   no-undo .
     1765   define variable v-diasize-wndstore             as logical   no-undo .
     1766   define variable v-diasize-proc-name            as character no-undo .
     1767   define variable v-diasize-browse-handle        as handle    no-undo .
     1768   define variable v-diasize-browse-number        as integer   no-undo .
     1769   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1770   define temp-table temp-diasize-handle no-undo
     1771     field handle-value  as handle
     1772     field save-position as decimal
     1773     index xpk is primary unique handle-value
     1774     .
     1775   define temp-table temp-browse-handle no-undo
     1776     field browse-type   as character
     1777     field browse-number as integer
     1778     field browse-handle as handle
     1779     field original-size as decimal
     1780     index xpk is primary unique browse-type browse-number
     1781     index xie browse-type browse-handle
     1782   .
     1783   procedure diasize_change-height :
     1784     define input  parameter p-change-value  as decimal   no-undo .
     1785     define input  parameter p-move-resize   as logical   no-undo .
     1786     define variable v-field-group-handle    as handle    no-undo .
     1787     define variable v-object-handle         as handle    no-undo .
     1788     define variable v-frame-height          as decimal   no-undo .
     1789     define variable v-frame-virtual-height  as decimal   no-undo .
     1790     define variable v-browse-height         as decimal   no-undo .
     1791     define variable v-window-height         as decimal   no-undo .
     1792     define variable v-window-virtual-height as decimal   no-undo .
     1793     define variable v-change-sign           as integer   no-undo .
     1794     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1795     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1796     if p-change-value > 0
     1797     then do:
     1798       if frame Dialog-Frame :height + p-change-value
     1799           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1800       then do:
     1801         assign
     1802           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1803                           - (frame Dialog-Frame :height-chars)
     1804         .
     1805         if p-change-value <= 0
     1806         then do:
     1807           run diasize_position-resize-button in this-procedure .
     1808           return .
     1809         end.
     1810       end.
     1811     end.
     1812     if p-change-value < 0
     1813     then do:
     1814       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1815       then do:
     1816         assign
     1817           p-change-value = v-diasize-orig-frame-height
     1818                          - (frame Dialog-Frame :height-chars)
     1819         .
     1820         if p-change-value >= 0
     1821         then do:
     1822           run diasize_position-resize-button in this-procedure .
     1823           return .
     1824         end.
     1825       end.
     1826     end.
     1827     if p-change-value >= 0
     1828     then do:
     1829       assign
     1830         v-change-sign = 1
     1831       .
     1832     end.
     1833     else do:
     1834       assign
     1835         v-change-sign = -1
     1836       .
     1837     end.
     1838     assign
     1839       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1840     .
     1841     if p-change-value = 0
     1842     then do:
     1843       run diasize_position-resize-button in this-procedure .
     1844       return .
     1845     end.
     1846     move_block:
     1847     do
     1848     on error undo move_block, retry move_block
     1849     :
     1850       if retry
     1851       then do:
     1852         do
     1853         on error undo move_block, leave move_block
     1854         :
     1855           if p-change-value > 0
     1856           then do:
     1857             for each buf_temp-diasize-handle
     1858             on error undo, next
     1859             :
     1860               assign
     1861                 v-object-handle = buf_temp-diasize-handle.handle-value
     1862               .
     1863               if v-object-handle <> v-diasize-resize-button
     1864               then do:
     1865                 assign
     1866                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1867                 .
     1868               end.
     1869             end.
     1870             assign
     1871               v-diasize-browse-handle :height = v-browse-height
     1872             .
     1873             for each buf_temp-browse-handle
     1874               where buf_temp-browse-handle.browse-type = 'height':u
     1875             on error undo, next
     1876             :
     1877               assign
     1878                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1879               .
     1880             end.
     1881             assign
     1882               frame Dialog-Frame :height = v-frame-height
     1883             .
     1884             if frame Dialog-Frame :scrollable = true
     1885             then do:
     1886               assign
     1887                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1888               .
     1889             end.
     1890             run diasize_position-resize-button in this-procedure .
     1891           end.
     1892           else do:
     1893             if frame Dialog-Frame :scrollable = true
     1894             then do:
     1895               assign
     1896                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1897               .
     1898             end.
     1899             assign
     1900               frame Dialog-Frame :height = v-frame-height
     1901             .
     1902             assign
     1903               v-diasize-browse-handle :height = v-browse-height
     1904             .
     1905             for each buf_temp-browse-handle
     1906               where buf_temp-browse-handle.browse-type = 'height':u
     1907             on error undo, next
     1908             :
     1909               assign
     1910                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1911               .
     1912             end.
     1913             for each buf_temp-diasize-handle
     1914             on error undo, next
     1915             :
     1916               assign
     1917                 v-object-handle = buf_temp-diasize-handle.handle-value
     1918               .
     1919               if v-object-handle <> v-diasize-resize-button
     1920               then do:
     1921                 assign
     1922                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1923                 .
     1924               end.
     1925             end.
     1926             run diasize_position-resize-button in this-procedure .
     1927           end.
     1928           assign
     1929             v-diasize-change-size = false
     1930           .
     1931           leave move_block .
     1932         end.
     1933       end.
     1934       assign
     1935         v-diasize-need-full-display = true
     1936       .
     1937       if v-diasize-change-size = false
     1938       then do:
     1939         assign
     1940           v-diasize-change-size = true
     1941         .
     1942       end.
     1943       else do:
     1944         return .
     1945       end.
     1946       assign
     1947         v-frame-height = frame Dialog-Frame :height
     1948         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1949         v-browse-height = v-diasize-browse-handle :height
     1950       .
     1951       for each buf_temp-browse-handle
     1952         where buf_temp-browse-handle.browse-type = 'height':u
     1953       :
     1954         assign
     1955           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1956         .
     1957       end.
     1958       for each buf_temp-diasize-handle
     1959       :
     1960         delete buf_temp-diasize-handle .
     1961       end.
     1962       assign
     1963         v-field-group-handle = frame Dialog-Frame :first-child
     1964       .
     1965       do while valid-handle(v-field-group-handle)
     1966       :
     1967         assign
     1968           v-object-handle = v-field-group-handle :first-child
     1969         .
     1970         do while valid-handle(v-object-handle)
     1971         :
     1972           if  v-object-handle <> v-diasize-browse-handle :handle
     1973           and can-query(v-object-handle, "row")
     1974           and can-query(v-object-handle, "height")
     1975           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1976           then do:
     1977             find first buf_temp-browse-handle
     1978               where buf_temp-browse-handle.browse-type   = 'height':u
     1979                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1980               no-error .
     1981             if available buf_temp-browse-handle
     1982             then do:
     1983             end.
     1984             else do:
     1985               create buf_temp-diasize-handle .
     1986               assign
     1987                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1988                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1989               .
     1990             end.
     1991           end.
     1992           assign
     1993             v-object-handle = v-object-handle :next-sibling
     1994           .
     1995         end.
     1996         assign
     1997           v-field-group-handle = v-field-group-handle :next-sibling
     1998         .
     1999       end.
     2000       do with frame Dialog-Frame
     2001       :
     2002         hide v-diasize-resize-button .
     2003         assign
     2004           v-diasize-resize-button :row    = 1
     2005           v-diasize-resize-button :column = 1
     2006         .
     2007       end.
     2008       if p-change-value > 0
     2009       then do:
     2010         if frame Dialog-Frame :scrollable = true
     2011         then do:
     2012           assign
     2013             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2014             no-error .
     2015           if error-status :error
     2016           or error-status :get-message(1) <> ""
     2017           then do:
     2018             undo move_block, retry move_block .
     2019           end.
     2020         end.
     2021         assign
     2022           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2023           no-error .
     2024         if error-status :error
     2025         or error-status :get-message(1) <> ""
     2026         then do:
     2027           undo move_block, retry move_block .
     2028         end.
     2029         assign
     2030           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2031           no-error .
     2032         if error-status :error
     2033         or error-status :get-message(1) <> ""
     2034         then do:
     2035           undo move_block, retry move_block .
     2036         end.
     2037         for each buf_temp-browse-handle
     2038           where buf_temp-browse-handle.browse-type = 'height':u
     2039         on error undo move_block, retry move_block
     2040         :
     2041           assign
     2042             buf_temp-browse-handle.browse-handle :height
     2043               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2044             no-error .
     2045           if error-status :error
     2046           or error-status :get-message(1) <> ""
     2047           then do:
     2048             undo move_block, retry move_block .
     2049           end.
     2050         end.
     2051         for each buf_temp-diasize-handle
     2052         on error undo move_block, retry move_block
     2053         :
     2054           assign
     2055             v-object-handle = buf_temp-diasize-handle.handle-value
     2056           .
     2057           if v-object-handle <> v-diasize-resize-button
     2058           then do:
     2059             assign
     2060               v-object-handle :row = v-object-handle :row + p-change-value
     2061               no-error .
     2062             if error-status :error
     2063             or error-status :get-message(1) <> ""
     2064             then do:
     2065               undo move_block, retry move_block .
     2066             end.
     2067           end.
     2068         end.
     2069       end.
     2070       else do:
     2071         for each buf_temp-diasize-handle
     2072         on error undo move_block, retry move_block
     2073         :
     2074           assign
     2075             v-object-handle = buf_temp-diasize-handle.handle-value
     2076           .
     2077           if v-object-handle <> v-diasize-resize-button
     2078           then do:
     2079             assign
     2080               v-object-handle :row = v-object-handle :row + p-change-value
     2081               no-error .
     2082             if error-status :error
     2083             or error-status :get-message(1) <> ""
     2084             then do:
     2085               undo move_block, retry move_block .
     2086             end.
     2087           end.
     2088         end.
     2089         assign
     2090           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2091           no-error .
     2092         if error-status :error
     2093         or error-status :get-message(1) <> ""
     2094         then do:
     2095           undo move_block, retry move_block .
     2096         end.
     2097         for each buf_temp-browse-handle
     2098           where buf_temp-browse-handle.browse-type = 'height':u
     2099         on error undo move_block, retry move_block
     2100         :
     2101           assign
     2102             buf_temp-browse-handle.browse-handle :height
     2103               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2104             no-error .
     2105           if error-status :error
     2106           or error-status :get-message(1) <> ""
     2107           then do:
     2108             undo move_block, retry move_block .
     2109           end.
     2110         end.
     2111         assign
     2112           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2113           no-error .
     2114         if error-status :error
     2115         or error-status :get-message(1) <> ""
     2116         then do:
     2117           undo move_block, retry move_block .
     2118         end.
     2119         if frame Dialog-Frame :scrollable = true
     2120         then do:
     2121           assign
     2122             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2123             no-error .
     2124           if error-status :error
     2125           or error-status :get-message(1) <> ""
     2126           then do:
     2127             undo move_block, retry move_block .
     2128           end.
     2129         end.
     2130       end.
     2131       if p-move-resize = true
     2132       then do:
     2133         run diasize_position-resize-button in this-procedure .
     2134       end.
     2135       if v-diasize-wndstore = true
     2136       then do:
     2137         if connected("ub") = true
     2138         then do:
     2139           define variable v-cntxt-db-num        as integer   no-undo .
     2140           define variable v-cntxt-userid        as character no-undo .
     2141           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2142                                             , OUTPUT v-cntxt-userid
     2143                                             ) .
     2144           run gbl/wndsizew.p
     2145             (input  v-cntxt-db-num
     2146             ,input  v-cntxt-userid
     2147             ,input  v-diasize-proc-name
     2148             ,input  'height':u
     2149             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2150             ) .
     2151         end.
     2152       end.
     2153     end.
     2154     assign
     2155       v-diasize-change-size = false
     2156     .
     2157   end procedure.
     2158   procedure diasize_set-height :
     2159     define input  parameter p-new-height  as decimal   no-undo .
     2160     define input  parameter p-move-resize as logical   no-undo .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       run diasize_change-height in this-procedure
     2165         (input  (p-new-height - frame Dialog-Frame :height)
     2166         ,input  p-move-resize
     2167         ) .
     2168     end.
     2169   end procedure.
     2170   procedure diasize_change-width :
     2171     define input  parameter p-change-value as decimal   no-undo .
     2172     define input  parameter p-move-resize  as logical   no-undo .
     2173     define variable v-field-group-handle   as handle    no-undo .
     2174     define variable v-object-handle        as handle    no-undo .
     2175     define variable v-frame-width          as decimal   no-undo .
     2176     define variable v-frame-virtual-width  as decimal   no-undo .
     2177     define variable v-browse-width         as decimal   no-undo .
     2178     define variable v-window-width         as decimal   no-undo .
     2179     define variable v-window-virtual-width as decimal   no-undo .
     2180     define variable v-change-sign          as integer   no-undo .
     2181     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2182     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2183     if p-change-value > 0
     2184     then do:
     2185       if frame Dialog-Frame :width + p-change-value >
     2186           session :width-chars
     2187       then do:
     2188         assign
     2189           p-change-value = session :width-chars - frame Dialog-Frame :width
     2190         .
     2191         if p-change-value <= 0
     2192         then do:
     2193           run diasize_position-resize-button in this-procedure .
     2194           return .
     2195         end.
     2196       end.
     2197     end.
     2198     if p-change-value < 0
     2199     then do:
     2200       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2201       then do:
     2202         assign
     2203           p-change-value = v-diasize-orig-frame-width
     2204                          - frame Dialog-Frame :width
     2205         .
     2206         if p-change-value >= 0
     2207         then do:
     2208           run diasize_position-resize-button in this-procedure .
     2209           return .
     2210         end.
     2211       end.
     2212     end.
     2213     if p-change-value >= 0
     2214     then do:
     2215       assign
     2216         v-change-sign = 1
     2217       .
     2218     end.
     2219     else do:
     2220       assign
     2221         v-change-sign = -1
     2222       .
     2223     end.
     2224     assign
     2225       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2226     .
     2227     if p-change-value = 0
     2228     then do:
     2229       run diasize_position-resize-button in this-procedure .
     2230       return .
     2231     end.
     2232     move_block:
     2233     do
     2234     on error undo move_block, leave move_block
     2235     :
     2236       if retry
     2237       then do:
     2238         do
     2239         on error undo move_block, leave move_block
     2240         :
     2241           if p-change-value > 0
     2242           then do:
     2243             for each buf_temp-diasize-handle
     2244             on error undo, next
     2245             :
     2246               assign
     2247                 v-object-handle = buf_temp-diasize-handle.handle-value
     2248               .
     2249               if v-object-handle <> v-diasize-resize-button
     2250               then do:
     2251                 assign
     2252                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2253                 .
     2254               end.
     2255             end.
     2256             assign
     2257               v-diasize-browse-handle :width = v-browse-width
     2258             .
     2259             for each buf_temp-browse-handle
     2260               where buf_temp-browse-handle.browse-type = 'width':u
     2261             on error undo, next
     2262             :
     2263               assign
     2264                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2265               .
     2266             end.
     2267             assign
     2268               frame Dialog-Frame :width = v-frame-width
     2269             .
     2270             if frame Dialog-Frame :scrollable = true
     2271             then do:
     2272               assign
     2273                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2274               .
     2275             end.
     2276             run diasize_position-resize-button in this-procedure .
     2277           end.
     2278           else do:
     2279             if frame Dialog-Frame :scrollable = true
     2280             then do:
     2281               assign
     2282                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2283               .
     2284             end.
     2285             assign
     2286               frame Dialog-Frame :width = v-frame-width
     2287             .
     2288             for each buf_temp-browse-handle
     2289               where buf_temp-browse-handle.browse-type = 'width':u
     2290             on error undo, next
     2291             :
     2292               assign
     2293                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2294               .
     2295             end.
     2296             assign
     2297               v-diasize-browse-handle :width = v-browse-width
     2298             .
     2299             for each buf_temp-diasize-handle
     2300             on error undo, next
     2301             :
     2302               assign
     2303                 v-object-handle = buf_temp-diasize-handle.handle-value
     2304               .
     2305               if v-object-handle <> v-diasize-resize-button
     2306               then do:
     2307                 assign
     2308                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2309                 .
     2310               end.
     2311             end.
     2312             run diasize_position-resize-button in this-procedure .
     2313           end.
     2314           assign
     2315             v-diasize-change-size = false
     2316           .
     2317           leave move_block .
     2318         end.
     2319       end.
     2320       assign
     2321         v-diasize-need-full-display = true
     2322       .
     2323       if v-diasize-change-size = false
     2324       then do:
     2325         assign
     2326           v-diasize-change-size = true
     2327         .
     2328       end.
     2329       else do:
     2330         return .
     2331       end.
     2332       assign
     2333         v-frame-width = frame Dialog-Frame :width
     2334         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2335         v-browse-width = v-diasize-browse-handle :width
     2336       .
     2337       for each buf_temp-browse-handle
     2338         where buf_temp-browse-handle.browse-type = 'width':u
     2339       :
     2340         assign
     2341           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2342         .
     2343       end.
     2344       for each buf_temp-diasize-handle
     2345       :
     2346         delete buf_temp-diasize-handle .
     2347       end.
     2348       assign
     2349         v-field-group-handle = frame Dialog-Frame :first-child
     2350       .
     2351       do while valid-handle(v-field-group-handle)
     2352       :
     2353         assign
     2354           v-object-handle = v-field-group-handle :first-child
     2355         .
     2356         do while valid-handle(v-object-handle)
     2357         :
     2358           if  v-object-handle <> v-diasize-browse-handle :handle
     2359           and v-object-handle <> v-diasize-resize-button
     2360           and can-query(v-object-handle, "row")
     2361           and can-query(v-object-handle, "height")
     2362           and ( v-object-handle :col + v-object-handle :width
     2363                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2364               )
     2365           then do:
     2366             find first buf_temp-browse-handle
     2367               where buf_temp-browse-handle.browse-type   = 'width':u
     2368                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2369               no-error .
     2370             if available buf_temp-browse-handle
     2371             then do:
     2372             end.
     2373             else do:
     2374               create buf_temp-diasize-handle .
     2375               assign
     2376                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2377                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2378               .
     2379             end.
     2380           end.
     2381           assign
     2382             v-object-handle = v-object-handle :next-sibling
     2383           .
     2384         end.
     2385         assign
     2386           v-field-group-handle = v-field-group-handle :next-sibling
     2387         .
     2388       end.
     2389       do with frame Dialog-Frame
     2390       :
     2391         hide v-diasize-resize-button .
     2392         v-diasize-resize-button :row = 1.
     2393         v-diasize-resize-button :column = 1.
     2394       end.
     2395       if p-change-value > 0
     2396       then do:
     2397         if frame Dialog-Frame :scrollable = true
     2398         then do:
     2399           assign
     2400             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2401             no-error .
     2402           if error-status :error
     2403           or error-status :get-message(1) <> ""
     2404           then do:
     2405             undo move_block, retry move_block.
     2406           end.
     2407         end.
     2408         assign
     2409           frame Dialog-Frame :width = v-frame-width + p-change-value
     2410           no-error .
     2411         if error-status :error
     2412         or error-status :get-message(1) <> ""
     2413         then do:
     2414           undo move_block, retry move_block.
     2415         end.
     2416         assign
     2417           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2418         no-error .
     2419         if error-status :error
     2420         or error-status :get-message(1) <> ""
     2421         then do:
     2422           undo move_block, retry move_block.
     2423         end.
     2424         for each buf_temp-browse-handle
     2425           where buf_temp-browse-handle.browse-type = 'width':u
     2426         on error undo move_block, retry move_block
     2427         :
     2428           assign
     2429             buf_temp-browse-handle.browse-handle :width
     2430               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2431             no-error .
     2432           if error-status :error
     2433           or error-status :get-message(1) <> ""
     2434           then do:
     2435             undo move_block, retry move_block .
     2436           end.
     2437         end.
     2438         for each buf_temp-diasize-handle
     2439         on error undo move_block, retry move_block
     2440         :
     2441           assign
     2442             v-object-handle = buf_temp-diasize-handle.handle-value
     2443           .
     2444           if v-object-handle <> v-diasize-resize-button
     2445           then do:
     2446             assign
     2447               v-object-handle :col = v-object-handle :col + p-change-value
     2448               no-error .
     2449             if error-status :error
     2450             or error-status :get-message(1) <> ""
     2451             then do:
     2452               undo move_block, retry move_block .
     2453             end.
     2454           end.
     2455         end.
     2456       end.
     2457       else do:
     2458         for each buf_temp-diasize-handle
     2459         on error undo move_block, retry move_block
     2460         :
     2461           assign
     2462             v-object-handle = buf_temp-diasize-handle.handle-value
     2463           .
     2464           if v-object-handle <> v-diasize-resize-button
     2465           then do:
     2466             assign
     2467               v-object-handle :col = v-object-handle :col + p-change-value
     2468               no-error .
     2469             if error-status :error
     2470             or error-status :get-message(1) <> ""
     2471             then do:
     2472               undo move_block, retry move_block .
     2473             end.
     2474           end.
     2475         end.
     2476         for each buf_temp-browse-handle
     2477           where buf_temp-browse-handle.browse-type = 'width':u
     2478         on error undo move_block, retry move_block
     2479         :
     2480           assign
     2481             buf_temp-browse-handle.browse-handle :width
     2482               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2483             no-error .
     2484           if error-status :error
     2485           or error-status :get-message(1) <> ""
     2486           then do:
     2487             undo move_block, retry move_block .
     2488           end.
     2489         end.
     2490         assign
     2491           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2492           no-error .
     2493         if error-status :error
     2494         or error-status :get-message(1) <> ""
     2495         then do:
     2496           undo move_block, retry move_block.
     2497         end.
     2498         assign
     2499           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2500         no-error .
     2501         if error-status :error
     2502         or error-status :get-message(1) <> ""
     2503         then do:
     2504           undo move_block, retry move_block.
     2505         end.
     2506         if frame Dialog-Frame :scrollable = true
     2507         then do:
     2508           assign
     2509             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2510           no-error .
     2511           if error-status :error
     2512           or error-status :get-message(1) <> ""
     2513           then do:
     2514             undo move_block, retry move_block.
     2515           end.
     2516         end.
     2517       end.
     2518       if p-move-resize
     2519       then do:
     2520         run diasize_position-resize-button in this-procedure .
     2521       end.
     2522       if v-diasize-wndstore = true
     2523       then do:
     2524         if connected("ub") = true
     2525         then do:
     2526           define variable v-cntxt-db-num        as integer   no-undo .
     2527           define variable v-cntxt-userid        as character no-undo .
     2528           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2529                                             , OUTPUT v-cntxt-userid
     2530                                             ) .
     2531           run gbl/wndsizew.p
     2532             (input  v-cntxt-db-num
     2533             ,input  v-cntxt-userid
     2534             ,input  v-diasize-proc-name
     2535             ,input  'width':u
     2536             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2537             ) .
     2538         end.
     2539       end.
     2540     end.
     2541     assign
     2542       v-diasize-change-size = false
     2543     .
     2544   end procedure.
     2545   procedure diasize_set-width :
     2546     define input  parameter p-new-width  as decimal   no-undo .
     2547     define input  parameter p-move-resize as logical   no-undo .
     2548     do
     2549     on error undo, return error return-value
     2550     :
     2551       run diasize_change-width in this-procedure
     2552         (input  (p-new-width - frame Dialog-Frame :width)
     2553         ,input  p-move-resize
     2554         ) .
     2555     end.
     2556   end procedure.
     2557   procedure diasize_position-resize-button :
     2558     do with frame Dialog-Frame
     2559     :
     2560       hide v-diasize-resize-button .
     2561       assign
     2562         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2563                     - 1
     2564                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2565         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2566                     - 1
     2567                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2568       .
     2569       view v-diasize-resize-button .
     2570     end.
     2571   end procedure.
     2572   on alt-right anywhere
     2573   do:
     2574     run diasize_change-width in this-procedure
     2575       (input 1
     2576       ,input true
     2577       ) .
     2578     return no-apply .
     2579   end.
     2580   on alt-left anywhere
     2581   do:
     2582     run diasize_change-width in this-procedure
     2583       (input -1
     2584       ,input true
     2585       ) .
     2586     return no-apply .
     2587   end.
     2588   on alt-down anywhere
     2589   do:
     2590     run diasize_change-height in this-procedure
     2591       (input 1
     2592       ,input true
     2593       ) .
     2594     return no-apply .
     2595   end.
     2596   on alt-up anywhere
     2597   do:
     2598     run diasize_change-height in this-procedure
     2599       (input -1
     2600       ,input true
     2601       ) .
     2602     return no-apply .
     2603   end.
     2604   on alt-enter of frame Dialog-Frame
     2605   do:
     2606     run diasize_maximize in this-procedure
     2607       (input  ?
     2608       ).
     2609     return no-apply .
     2610   end.
     2611   procedure diasize_end-move :
     2612     do
     2613     on error undo, return error return-value
     2614     :
     2615       define variable v-row-delta as decimal   no-undo .
     2616       define variable v-col-delta as decimal   no-undo .
     2617       define variable v-new-row as decimal   no-undo .
     2618       define variable v-new-col as decimal   no-undo .
     2619       assign
     2620         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2621         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2622       .
     2623       assign
     2624         v-row-delta = v-new-row - frame Dialog-Frame :height
     2625         v-col-delta = v-new-col - frame Dialog-Frame :width
     2626       .
     2627       run diasize_change-height in this-procedure
     2628         (input v-row-delta
     2629         ,input true
     2630         ) .
     2631       run diasize_change-width in this-procedure
     2632         (input v-col-delta
     2633         ,input true
     2634         ) .
     2635     end.
     2636   end procedure.
     2637   procedure diasize_maximize :
     2638     define input  parameter p-action as logical   no-undo .
     2639     do
     2640     on error undo, return error return-value
     2641     :
     2642       if p-action = ?
     2643       then do:
     2644         if v-diasize-need-maximize = true
     2645         then do:
     2646           assign
     2647             p-action = true
     2648           .
     2649         end.
     2650         else do:
     2651           assign
     2652             p-action = false
     2653           .
     2654         end.
     2655       end.
     2656       if p-action = true
     2657       then do:
     2658         run diasize_change-height in this-procedure
     2659           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2660               - frame Dialog-Frame :height-chars
     2661           ,input true
     2662           ) .
     2663         run diasize_change-width in this-procedure
     2664           (input session :width-chars
     2665               - frame Dialog-Frame :width-chars
     2666           ,input true
     2667           ) .
     2668         assign
     2669           v-diasize-need-maximize = false
     2670         .
     2671       end.
     2672       else do:
     2673         run diasize_change-width in this-procedure
     2674           (input v-diasize-orig-frame-width
     2675               - frame Dialog-Frame :width-chars
     2676           ,input true
     2677           ) .
     2678         run diasize_change-height in this-procedure
     2679           (input v-diasize-orig-frame-height
     2680               - frame Dialog-Frame :height-chars
     2681           ,input true
     2682           ) .
     2683         assign
     2684           v-diasize-need-maximize = true
     2685         .
     2686       end.
     2687     end.
     2688   end procedure.
     2689   procedure diasize_restore-orig-size :
     2690     do
     2691     on error undo, return error return-value
     2692     :
     2693       assign
     2694         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2695         v-diasize-current-frame-height = frame Dialog-Frame :height
     2696       .
     2697       run diasize_set-height in this-procedure
     2698         (input  v-diasize-orig-frame-height
     2699         ,input  true
     2700         ) .
     2701       run diasize_set-width in this-procedure
     2702         (input  v-diasize-orig-frame-width
     2703         ,input  true
     2704         ) .
     2705     end.
     2706   end procedure.
     2707   procedure diasize_restore-current-size :
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711       run diasize_set-height in this-procedure
     2712         (input  v-diasize-current-frame-height
     2713         ,input  true
     2714         ) .
     2715       run diasize_set-width in this-procedure
     2716         (input  v-diasize-current-frame-width
     2717         ,input  true
     2718         ) .
     2719     end.
     2720   end procedure.
     2721   procedure diasize_set-browse-handle :
     2722     define input  parameter p-browse-handle as handle   no-undo .
     2723     define buffer buf_temp-browse-handle for temp-browse-handle .
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       assign
     2728         v-diasize-browse-handle = p-browse-handle
     2729       .
     2730       for each buf_temp-browse-handle
     2731       on error undo, return error return-value
     2732       :
     2733         delete buf_temp-browse-handle .
     2734       end.
     2735     end.
     2736   end procedure.
     2737   procedure diasize_add_browse :
     2738     define input  parameter p-browse-type   as character no-undo .
     2739     define input  parameter p-browse-handle as handle    no-undo .
     2740     define buffer buf_temp-browse-handle for temp-browse-handle .
     2741     do
     2742     on error undo, return error return-value
     2743     :
     2744       assign
     2745         v-diasize-browse-number = v-diasize-browse-number + 1
     2746       .
     2747       create buf_temp-browse-handle .
     2748       assign
     2749         buf_temp-browse-handle.browse-type   = p-browse-type
     2750         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2751         buf_temp-browse-handle.browse-handle = p-browse-handle
     2752       .
     2753     end.
     2754   end procedure.
     2755   procedure diasize_init :
     2756     define variable v-default-value    as logical   no-undo .
     2757     define variable v-restore-saved    as logical   no-undo .
     2758     define variable v-resize-value-str as character no-undo .
     2759     do
     2760     on error undo, return error return-value
     2761     :
     2762       do with frame Dialog-Frame
     2763       :
     2764         assign
     2765           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2766           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2767           v-diasize-browse-handle     = browse BR-docs :handle
     2768         .
     2769         create button v-diasize-resize-button
     2770         assign
     2771           parent        = frame Dialog-Frame :first-child
     2772           label         = "s"
     2773           height-pixels = 16
     2774           width-pixels  = 16
     2775           visible       = true
     2776           sensitive     = true
     2777           movable       = true
     2778           triggers:
     2779             on end-move persistent run diasize_end-move in this-procedure .
     2780           end triggers.
     2781         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2782         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2783         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2784         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2785         assign
     2786           v-diasize-wndmax = false
     2787         .
     2788         if connected("ub") = true
     2789         then do:
     2790           define variable v-cntxt-db-num        as integer   no-undo .
     2791           define variable v-cntxt-userid        as character no-undo .
     2792           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2793                                             , OUTPUT v-cntxt-userid
     2794                                             ) .
     2795           run gbl/wndpar_r.p
     2796             (input  v-cntxt-db-num
     2797             ,input  v-cntxt-userid
     2798             ,input  'wndmax':U
     2799             ,output v-diasize-wndmax
     2800             ,output v-default-value
     2801             ) .
     2802         end.
     2803         assign
     2804           v-diasize-wndstore = false
     2805         .
     2806         if connected("ub") = true
     2807         then do:
     2808           run gbl/wndpar_r.p
     2809             (input  v-cntxt-db-num
     2810             ,input  v-cntxt-userid
     2811             ,input  'wndstore':U
     2812             ,output v-diasize-wndstore
     2813             ,output v-default-value
     2814             ) .
     2815         end.
     2816         assign
     2817           v-diasize-proc-name = entry(1, program-name(2), '.')
     2818         .
     2819         if v-diasize-wndstore = true
     2820         then do:
     2821           assign
     2822             v-restore-saved = false
     2823           .
     2824           if connected("ub") = true
     2825           then do:
     2826             run gbl/wndsizer.p
     2827               (input  v-cntxt-db-num
     2828               ,input  v-cntxt-userid
     2829               ,input  v-diasize-proc-name
     2830               ,input  'height':u
     2831               ,output v-resize-value-str
     2832               ) .
     2833             if v-resize-value-str <> '':U
     2834             then do:
     2835               run diasize_change-height in this-procedure
     2836                 (input  integer(v-resize-value-str)
     2837                 ,input  true
     2838                 ) .
     2839               assign
     2840                 v-restore-saved = true
     2841               .
     2842             end.
     2843           end.
     2844           if connected("ub") = true
     2845           then do:
     2846             run gbl/wndsizer.p
     2847               (input  v-cntxt-db-num
     2848               ,input  v-cntxt-userid
     2849               ,input  v-diasize-proc-name
     2850               ,input  'width':u
     2851               ,output v-resize-value-str
     2852               ) .
     2853             if v-resize-value-str <> '':U
     2854             then do:
     2855               run diasize_change-width in this-procedure
     2856                 (input  integer(v-resize-value-str)
     2857                 ,input  true
     2858                 ) .
     2859               assign
     2860                 v-restore-saved = true
     2861               .
     2862             end.
     2863           end.
     2864           if v-restore-saved <> true
     2865           then do:
     2866             if v-diasize-wndmax = true
     2867             then do:
     2868               run diasize_maximize in this-procedure
     2869                 (input  true
     2870                 ) .
     2871             end.
     2872           end.
     2873         end.
     2874         else do:
     2875           if v-diasize-wndmax = true
     2876           then do:
     2877             run diasize_maximize in this-procedure
     2878               (input  true
     2879               ) .
     2880           end.
     2881         end.
     2882       end.
     2883     end.
     2884   end procedure.
     2885   procedure diasize_need-full-display :
     2886     define output parameter p-need-full-display as logical   no-undo .
     2887     do
     2888     on error undo, return error return-value
     2889     :
     2890       assign
     2891         p-need-full-display = v-diasize-need-full-display
     2892       .
     2893       assign
     2894         v-diasize-need-full-display = false
     2895       .
     2896     end.
     2897   end procedure.
     2898   procedure get-context :
     2899      define output parameter p-db-num as integer          no-undo.
     2900      define output parameter p-user-id as character        no-undo.
     2901      define variable v-login               as character    no-undo.
     2902      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2903      define buffer buf_user-login  for ub.user-login .
     2904      do
     2905      on error undo, return error
     2906      :
     2907            FIND FIRST buf_sys-ctrl no-lock.
     2908            ASSIGN
     2909               v-login = USERID("ub")
     2910               p-db-num = buf_sys-ctrl.db-num
     2911            .
     2912            FIND FIRST buf_user-login
     2913                 WHERE buf_user-login.db-num = p-db-num
     2914                   AND buf_user-login.user-login = v-login
     2915                 no-lock
     2916                 no-error
     2917                 .
     2918            IF AVAILABLE buf_user-login
     2919            THEN DO:
     2920               assign
     2921                  p-user-id = buf_user-login.user-id
     2922               .
     2923            END.
     2924      end.
     2925   end procedure.
     2926       run diasize_init in this-procedure .
     2927   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2928   on ' ' of p-date in frame Dialog-Frame
     2929   do:
     2930     if (can-query (self, "sensitive")
     2931        and
     2932        self :sensitive = true
     2933        )
     2934     or (can-query (self, "read-only")
     2935        and
     2936        self :read-only = false
     2937        )
     2938     then do:
     2939       assign
     2940         self :screen-value = ?
     2941       .
     2942     end.
     2943     return no-apply.
     2944   end.
     2945   on delete-character of p-date in frame Dialog-Frame
     2946   do:
     2947     if (can-query (self, "sensitive")
     2948        and
     2949        self :sensitive = true
     2950        )
     2951     or (can-query (self, "read-only")
     2952        and
     2953        self :read-only = false
     2954        )
     2955     then do:
     2956       assign
     2957         self :screen-value = ?
     2958       .
     2959     end.
     2960     return no-apply.
     2961   end.
     2962   on ctrl-d of p-date in frame Dialog-Frame
     2963   do:
     2964     define variable v-curr-sv-date as date no-undo .
     2965     if (can-query (self, "sensitive")
     2966        and
     2967        self :sensitive = true
     2968        )
     2969     or (can-query (self, "read-only")
     2970        and
     2971        self :read-only = false
     2972        )
     2973     then do:
     2974       if self :handle <> focus :handle
     2975       then do:
     2976         apply "entry":u to self .
     2977       end.
     2978       run gbl/getcurdt.p
     2979         (output v-curr-sv-date
     2980         ) .
     2981       assign
     2982         self :screen-value = string(v-curr-sv-date) .
     2983       .
     2984     end.
     2985     return no-apply.
     2986   end.
     2987   on ctrl-b of p-date in frame Dialog-Frame
     2988   do:
     2989     if (can-query (self, "sensitive")
     2990        and
     2991        self :sensitive = true
     2992        )
     2993     or (can-query (self, "read-only")
     2994        and
     2995        self :read-only = false
     2996        )
     2997     then do:
     2998       if self :handle <> focus :handle
     2999       then do:
     3000         apply "entry":u to self .
     3001       end.
     3002       define variable v-curr-sv-date as date no-undo .
     3003       define variable v-new-sv-date  as date no-undo .
     3004       assign
     3005         v-curr-sv-date = date(self :screen-value) no-error
     3006       .
     3007       if v-curr-sv-date = ?
     3008       then do:
     3009         run gbl/getcurdt.p
     3010           (output v-curr-sv-date
     3011           ) .
     3012       end.
     3013       if v-curr-sv-date <> ?
     3014       then do:
     3015         assign
     3016           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3017         .
     3018         assign
     3019           self :screen-value = string(v-new-sv-date) .
     3020         .
     3021       end.
     3022     end.
     3023     return no-apply .
     3024   end.
     3025   on ctrl-e of p-date in frame Dialog-Frame
     3026   do:
     3027     if (can-query (self, "sensitive")
     3028        and
     3029        self :sensitive = true
     3030        )
     3031     or (can-query (self, "read-only")
     3032        and
     3033        self :read-only = false
     3034        )
     3035     then do:
     3036       if self :handle <> focus :handle
     3037       then do:
     3038         apply "entry":u to self .
     3039       end.
     3040       define variable v-curr-sv-date as date no-undo .
     3041       define variable v-new-sv-date  as date no-undo .
     3042       assign
     3043         v-curr-sv-date = date(self :screen-value) no-error
     3044       .
     3045       if v-curr-sv-date = ?
     3046       then do:
     3047         run gbl/getcurdt.p
     3048           (output v-curr-sv-date
     3049           ) .
     3050       end.
     3051       if v-curr-sv-date <> ?
     3052       then do:
     3053         run gbl/lastdate.p
     3054           (input  v-curr-sv-date
     3055           ,output v-new-sv-date
     3056           ).
     3057         assign
     3058           self :screen-value = string(v-new-sv-date) .
     3059         .
     3060       end.
     3061     end.
     3062     return no-apply .
     3063   end.
     3064   on ctrl-f of p-date in frame Dialog-Frame
     3065   do:
     3066     if (can-query (self, "sensitive")
     3067        and
     3068        self :sensitive = true
     3069        )
     3070     or (can-query (self, "read-only")
     3071        and
     3072        self :read-only = false
     3073        )
     3074     then do:
     3075       if self :handle <> focus :handle
     3076       then do:
     3077         apply "entry":u to self .
     3078       end.
     3079       define variable v-ok            as logical   no-undo .
     3080       define variable v-curr-sv-date  as date      no-undo .
     3081       define variable v-description   as character no-undo .
     3082       assign
     3083         v-curr-sv-date = date(self :screen-value) no-error
     3084       .
     3085       if v-curr-sv-date = ?
     3086       then do:
     3087         run gbl/getcurdt.p
     3088           (output v-curr-sv-date
     3089           ) .
     3090       end.
     3091       if v-curr-sv-date <> ?
     3092       then do:
     3093         run gbl/d-inpday.w
     3094           (input ?
     3095           ,input "Выбор даты"
     3096           ,input v-description
     3097           ,input ""
     3098           ,input-output v-curr-sv-date
     3099           ,output v-ok
     3100           ).
     3101         if v-ok = true
     3102         then do:
     3103           assign
     3104             self :screen-value = string(v-curr-sv-date) .
     3105           .
     3106         end.
     3107       end.
     3108     end.
     3109     return no-apply .
     3110   end.
     3111     define MENU m-ed-date23
     3112       MENU-ITEM m-ed-date23-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3113       MENU-ITEM m-ed-date23-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3114       MENU-ITEM m-ed-date23-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3115       MENU-ITEM m-ed-date23-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3116       .
     3117     if p-date :POPUP-MENU in frame Dialog-Frame = ?
     3118     then do:
     3119       ASSIGN
     3120         p-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date23 :HANDLE
     3121         p-date :MENU-MOUSE in frame Dialog-Frame = 3
     3122       .
     3123     end.
     3124     define variable v-label-handle23 as handle no-undo .
     3125     assign
     3126       v-label-handle23 = p-date :side-label-handle in frame Dialog-Frame
     3127     .
     3128     if valid-handle (v-label-handle23)
     3129     then do:
     3130       if v-label-handle23 :tooltip = ""
     3131       or v-label-handle23 :tooltip = ?
     3132       then do:
     3133         assign
     3134           v-label-handle23 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3135         .
     3136       end.
     3137     end.
     3138     ON CHOOSE OF MENU-ITEM m-ed-date23-1 in menu m-ed-date23 DO:
     3139       apply "ctrl-b":U to p-date in frame Dialog-Frame .
     3140     END.
     3141     ON CHOOSE OF MENU-ITEM m-ed-date23-2 in menu m-ed-date23 DO:
     3142       apply "ctrl-d":U to p-date in frame Dialog-Frame .
     3143     END.
     3144     ON CHOOSE OF MENU-ITEM m-ed-date23-3 in menu m-ed-date23 DO:
     3145       apply "ctrl-e":U to p-date in frame Dialog-Frame .
     3146     END.
     3147     ON CHOOSE OF MENU-ITEM m-ed-date23-4 in menu m-ed-date23 DO:
