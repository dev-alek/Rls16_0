     1546       loc_sum-doc   = buf_fin-liab-before.sum-doc
     1547       loc_sum-rubl  = buf_fin-liab-before.sum-rubl
     1548       loc_sum-contr  =  buf_fin-liab-before.sum-contract
     1549       d-abbr        = sel-abbr(buf_fin-liab-before.curr-code)
