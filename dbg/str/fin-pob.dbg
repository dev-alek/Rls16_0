      561   procedure prn-lib-reportviewer :
      562     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      563     define input parameter p-report-name-html as character no-undo .
      564     define input parameter p-param        as character no-undo .
      565     define variable v-excel           as character no-undo init 'TRUE' .
      566     define variable v-value-character as character no-undo .
      567     define variable v-value-integer   as character no-undo .
      568     define variable v-value-date      as date      no-undo .
      569     define variable v-value-decimal   as decimal   no-undo .
      570     define variable rep-excel         as logical   no-undo .
      571     define variable excel-string      as character no-undo .
      572     define variable v-param-type      as character no-undo .
      573     define variable v-tth             as handle    no-undo .
      574     run adm/shattri.p (
      575       input "get":U
      576       ,input  ""
      577       ,input  0
      578       ,input  'report-glob':U
      579       ,input  'rep-excel':U
      580       ,output v-value-character
      581       ,output v-value-date
      582       ,output v-value-decimal
      583       ,output v-value-integer
      584       ,output rep-excel
      585       ,output v-param-type
      586       ,INPUT-OUTPUT table-handle v-tth
      587       )  .
      588     if rep-excel then v-excel = "TRUE" .
      589     else v-excel = "FALSE" .
      590     if p-param eq ""
      591     then
      592        p-param = "EXCEL:" + v-excel.
      593     else
      594        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      595     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      596   end procedure.
      597   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   define variable v-waitfram-action01         as character   no-undo .
      599   define variable v-waitfram-action02         as character   no-undo .
      600   define variable v-waitfram-action03         as character   no-undo .
      601   define variable mWaitFramTextBeg            as character   no-undo.
      602   define variable mWaitFramTextEnd            as character   no-undo.
      603   define variable mWaitFramView               as logical     no-undo.
      604   define variable mWaitProcEvent              as logical     no-undo init yes.
      605   define variable mWaitFramInterval           as integer     no-undo init 1 .
      606   define variable mWaitFramStop               as logical     no-undo.
      607   define variable mWaitFramStopUser           as logical     no-undo.
      608   define variable mWaitFramStopTimeOut        as logical     no-undo.
      609   define variable mWaitFramStartProc          as datetime-tz no-undo.
      610   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      611   define button B-WaitFramStop auto-end-key
      612        label "Стоп"
      613        size 10 by 1 tooltip "Остоновить процесс".
      614   define button B-viewProcInfo
      615        label "Информация"
      616        size 15 by 1 tooltip "Информация о процесс".
      617   define frame waitfram
      618     v-waitfram-action01 format "x(72)" no-label skip
      619     v-waitfram-action02 format "x(72)" no-label skip
      620     v-waitfram-action03 format "x(72)" no-label skip
      621     B-viewProcInfo
      622     B-WaitFramStop at row 4 col 30
      623     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      624     .
      625   define new global shared variable mBatchMode as logical no-undo init ?.
      626   define variable mFramBachModHandle as handle no-undo.
      627   mFramBachModHandle = frame waitfram:handle.
      628   define variable mFameOldVis as logical no-undo.
      629   define variable mVisCUrentVin as logical no-undo.
      630   if session:batch-mode
      631   then
      632      mBatchMode = yes.
      633   if mBatchMode = ? then do:
      634     mVisCUrentVin = current-window:visible.
      635     mFameOldVis = mFramBachModHandle:visible.
      636     mFramBachModHandle:visible  = yes.
      637     mBatchMode = mFramBachModHandle:visible ne yes.
      638     mFramBachModHandle:visible = mFameOldVis.
      639     current-window:visible = mVisCUrentVin.
      640   end.
      641    if  log-manager:logfile-name ne ?
      642     then DO:
      643         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      644         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      645         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      646     end.
      647   on choose of B-WaitFramStop in frame waitfram
      648   do:
      649     mWaitFramStop = yes.
      650     mWaitFramStopUser = yes.
      651   end.
      652   function waitfram-check-timeout returns logical():
      653      define variable vtime as int64 no-undo.
      654      if mWaitFramStopTimeOut
      655      then
      656         return yes.
      657      vtime = ( now - mWaitFramStartProc ) / 1000 .
      658      if     mWaitFramTimeOut ne ?
      659         and mWaitFramTimeOut ne 0
      660         and mWaitFramTimeOut lt vtime
      661      then do:
      662         mWaitFramStopTimeOut = yes.
      663      end.
      664      return mWaitFramStopTimeOut.
      665   end.
      666   procedure waitfram-hide :
      667     if not session:batch-mode
      668     then do
      669     on error undo, return error return-value
      670     :
      671       pause 0 before-hide .
      672       if not mBatchMode then
      673         hide frame waitfram .
      674     if     not mWaitFramView
      675        and mWaitProcEvent
      676     then
      677       process events .
      678     end.
      679   end procedure.
      680   procedure waitfram-show :
      681     define input  parameter p-message as character no-undo .
      682     define variable v-left-margin as integer   no-undo .
      683     if not session:batch-mode
      684     then do
      685     on error undo, return error return-value
      686     :
      687       if length(p-message) <= 70 then do:
      688         assign
      689           v-left-margin = integer((70 - length(p-message)) / 2)
      690         .
      691         assign
      692           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      693         .
      694         assign
      695           v-waitfram-action01 = " "
      696           v-waitfram-action02 = " "
      697                                    + fill(" ", v-left-margin)
      698                                    + p-message
      699           v-waitfram-action03 = " "
      700         .
      701       end.
      702       else do:
      703         define variable vRindex1 as integer no-undo.
      704         define variable vRindex2 as integer no-undo.
      705         vRindex1 = r-index(p-message," ",70).
      706         if vRindex1 = 0
      707         then
      708            vRindex1 = 70.
      709         if length(p-message)  <= vRindex1 + 70 then do:
      710           assign
      711             v-waitfram-action01 = " "
      712             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      713             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      714           .
      715         end.
      716         else do:
      717           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      718           if vRindex2 <= vRindex1
      719           then
      720              vRindex2 = vRindex1 + 70.
      721           assign
      722             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      723             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      724             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      725           .
      726         end.
      727       end.
      728       B-viewProcInfo:visible   in frame waitfram = no.
      729       B-viewProcInfo:sensitive in frame waitfram = no.
      730       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      731       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      732       if  (   mWaitFramView
      733          or  mWaitProcEvent)
      734          and not mBatchMode
      735       then
      736          display
      737             v-waitfram-action01 skip
      738             v-waitfram-action02 skip
      739             v-waitfram-action03 skip
      740          with frame waitfram .
      741       if     mWaitFramView
      742          then do:
      743             if     mWaitFramInterval ne ?
      744                and not mBatchMode
      745             then
      746                wait-for go of frame waitfram pause mWaitFramInterval.
      747          end.
      748          else
      749             if     mWaitProcEvent
      750                and not mBatchMode
      751             then
      752                process events .
      753     end.
      754   end procedure.
      755      procedure waitfram-show-this:
      756         define input  parameter iInterval as int64 no-undo.
      757         define variable vtime as int64 no-undo.
      758         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      759         mWaitFramInterval = iInterval.
      760         run waitfram-show (substitute("&1&2 &3&4" ,
      761                                       mWaitFramTextBeg ,
      762                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      763                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      764                                       mWaitFramTextEnd
      765                                      )
      766                           ).
      767      end.
      768      procedure WaitFramRunPause:
      769         define input  parameter iInterval as dec no-undo.
      770         define variable vStart  as datetime-tz no-undo.
      771         define variable vend    as datetime-tz no-undo.
      772         define variable vint as int64 no-undo.
      773         define variable vOk as logical no-undo.
      774         vStart = now.
      775         vend   = vStart.
      776         publish "WaitFramPause" (iInterval,output vOk).
      777         vend   =  now.
      778         vint = vend - vStart.
      779         vint = iInterval - vint / 1000.
      780         if     not mWaitFramStop
      781            and (   vint > 0
      782                 or (    not vOk
      783                     and iInterval eq ?
      784                     )
      785                 )
      786         then
      787            run waitfram-show-this (iInterval).
      788         vend   =  now.
      789         vint = vend - vStart.
      790         vint = iInterval - vint / 1000.
      791         if     not mWaitFramStop
      792            and vint > 0
      793         then do:
      794            run gbl/pause.p (vint * 1000).
      795         end.
      796         if iInterval ne ?
      797         then
      798            publish "WaitFramStop".
      799         waitfram-check-timeout().
      800      end.
      801      procedure WaitFramWaitFor:
      802         define input  parameter iInterval as dec no-undo.
      803         assign
      804            mWaitFramStartProc   = now
      805            mWaitFramStopUser    = no
      806            mWaitFramStopTimeOut = no
      807         .
      808         block-wait:
      809         do while not mWaitFramStop:
      810            run WaitFramRunPause (iInterval).
      811            if  waitfram-check-timeout()
      812            then do:
      813               leave block-wait.
      814            end.
      815         end.
      816         run waitfram-hide.
      817      end.
      818   procedure waitfram-join :
      819     define input  parameter p-line-1  as character no-undo .
      820     define input  parameter p-line-2  as character no-undo .
      821     define input  parameter p-line-3  as character no-undo .
      822     define output parameter p-message as character no-undo .
      823     do
      824     on error undo, return error return-value
      825     :
      826       assign
      827         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      828                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      829                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      830       .
      831     end.
      832   end procedure.
      833   function waitfram-join-function returns character
      834     (input p-line-1 as character
      835     ,input p-line-2 as character
      836     ,input p-line-3 as character
      837     ).
      838     define variable v-message as character no-undo .
      839     run waitfram-join in this-procedure
      840       (input  p-line-1
      841       ,input  p-line-2
      842       ,input  p-line-3
      843       ,output v-message
      844       ) .
      845     return v-message .
      846   end function .
      847   define new global shared variable g#lib-farh as handle no-undo .
      848   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849     define variable v-cntxt-db-num        as integer   no-undo .
      850     define variable v-cntxt-userid        as character no-undo .
      851     define variable v-cntxt-level         as character no-undo .
      852     define variable v-cntxt-host-code-obj as integer   no-undo .
      853     define variable v-cntxt-obj-type      as character no-undo .
      854     define variable v-cntxt-obj-code      as integer   no-undo .
      855     define variable v-cntxt-db-num-obj    as integer   no-undo .
      856     define variable v-cntxt-is-admin      as logical   no-undo .
      857   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      859   procedure fltopend_fltopend :
      860   define input parameter p-parent-handle as handle no-undo .
      861   define input parameter p-qh as handle no-undo .
      862   define input parameter p-flt-open-open-query  as character no-undo .
      863   define input parameter p-where-cond as character no-undo .
      864   define input parameter p-use-indFIRST-query-tail as character no-undo .
      865   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      866   define input parameter p-indexed-reposition as character no-undo .
      867     do
      868     on error undo, return error
      869     :
      870   define variable v-prepare-string as character no-undo .
      871   define variable glog as logical no-undo .
      872   assign
      873   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      874                      p-where-cond + chr(32)  +
      875                      p-use-indFIRST-query-tail + chr(32) +
      876                      p-use-ind-sort-clmn-by + chr(32) +
      877                      p-indexed-reposition
      878   .
      879   assign
      880   glog = p-qh:query-prepare(v-prepare-string) no-error .
      881   if not glog
      882   or error-status:error then do:
      883     message error-status:get-message(1) view-as alert-box .
      884     undo, return error .
      885   end.
      886   assign
      887   glog = p-qh:query-open no-error .
      888   if not glog
      889   or error-status:error then do:
      890     message error-status:get-message(1) view-as alert-box .
      891     undo, return error .
      892   end.
      893     end.
      894   end procedure.
      895   procedure fltopend_fltfindd :
      896   define input parameter p-parent-handle as handle no-undo .
      897   define input parameter p-qh as handle no-undo .
      898   define input parameter p-rowid as rowid no-undo .
      899   define input parameter p-next as logical no-undo .
      900   define input parameter p-lock as integer no-undo .
      901   define input parameter p-bh as handle no-undo .
      902   define input parameter p-where-cond as character no-undo .
      903   define input parameter p-use-index-phrase as character no-undo .
      904   define variable glog as logical no-undo .
      905   define variable v-qh as handle no-undo .
      906   define variable v-bh as handle no-undo .
      907   define variable v-recid as recid no-undo .
      908   define variable v-prepare-string as character no-undo .
      909   do
      910   on error undo, return error
      911   on stop undo, return error
      912   :
      913     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      914     create buffer v-bh for table p-bh buffer-name p-bh:name.
      915     create query v-qh.
      916     v-qh:set-buffers(v-bh).
      917     v-prepare-string = substitute("for each &1 &2 &3"
      918                                     ,v-bh:name
      919                                     ,p-where-cond
      920                                     ,p-use-index-phrase).
      921     glog = v-qh:query-prepare(v-prepare-string) no-error.
      922     if not glog then do:
      923       delete object v-qh.
      924       delete object v-bh.
      925       undo, return error .
      926     end.
      927     glog = v-qh:query-open no-error .
      928     if not glog then do:
      929       delete object v-qh.
      930       delete object v-bh.
      931       undo, return error .
      932     end.
      933     if p-next then do:
      934       v-qh:reposition-to-rowid(p-rowid) no-error .
      935       glog = v-qh:get-next( p-lock) no-error .
      936       glog = v-qh:get-next( p-lock) no-error .
      937       if not glog or v-qh:query-off-end = yes then do:
      938         glog = v-qh:get-first( p-lock) no-error .
      939       end.
      940     end.
      941     else do:
      942       glog = v-qh:get-first( p-lock) no-error .
      943     end.
      944     v-recid = v-bh:recid no-error .
      945     delete object v-qh.
      946     delete object v-bh.
      947     return string(v-recid) .
      948   end.
      949   end procedure.
      950   procedure fltopend_fltfindq :
      951   define input parameter p-parent-handle as handle no-undo .
      952   define input parameter p-qh as handle no-undo .
      953   define input parameter p-next as logical no-undo .
      954   define input parameter p-lock as integer no-undo .
      955   define input parameter p-flt-open-open-query  as character no-undo .
      956   define input parameter p-where-cond as character no-undo .
      957   define input parameter p-use-indFIRST-query-tail as character no-undo .
      958   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      959   define input parameter p-indexed-reposition as character no-undo .
      960   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      961   define variable glog as logical no-undo .
      962   define variable v-qh as handle no-undo .
      963   define variable v-bh as handle no-undo extent 18.
      964   define variable v-rowid as rowid no-undo extent 18.
      965   define variable v-ii as integer no-undo .
      966   define variable v-prepare-string as character no-undo .
      967   do
      968   on error undo, return error
      969   on stop undo, return error
      970   :
      971     create query v-qh.
      972     do v-ii = 1 to p-qh:num-buffers:
      973       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      974       assign
      975       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      976       no-error.
      977       v-qh:add-buffer(v-bh[v-ii]).
      978     end.
      979     assign
      980     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      981                       p-where-cond + chr(32)  +
      982                       p-use-indFIRST-query-tail + chr(32) +
      983                       p-use-ind-sort-clmn-by + chr(32) +
      984                       p-indexed-reposition
      985     .
      986     glog = v-qh:query-prepare( v-prepare-string) no-error .
      987     if not glog then do:
      988       delete object v-qh.
      989       do v-ii = 1 to p-qh:num-buffers:
      990         delete object v-bh[v-ii].
      991       end.
      992       undo, return error .
      993     end.
      994     glog = v-qh:query-open no-error .
      995     if not glog then do:
      996       delete object v-qh.
      997       do v-ii = 1 to p-qh:num-buffers:
      998         delete object v-bh[v-ii].
      999       end.
     1000       undo, return error .
     1001     end.
     1002     if p-next then do:
     1003       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1004       glog = v-qh:get-next( p-lock) no-error .
     1005       glog = v-qh:get-next( p-lock) no-error .
     1006       if not glog or v-qh:query-off-end = yes then do:
     1007         glog = v-qh:get-first( p-lock) no-error .
     1008       end.
     1009     end.
     1010     else do:
     1011       glog = v-qh:get-first( p-lock) no-error .
     1012     end.
     1013     do v-ii = 1 to p-qh:num-buffers:
     1014       assign
     1015       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1016       no-error.
     1017     end.
     1018     delete object v-qh.
     1019     do v-ii = 1 to p-qh:num-buffers:
     1020       delete object v-bh[v-ii].
     1021     end.
     1022   end.
     1023   end procedure.
