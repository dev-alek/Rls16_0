     4212                             ,input (buffer buf_fin-liab-before:handle)
     4213                             ,input parameter-4-35
     4214                             ,input parameter-5-35
     4215                             ) no-error.
     4216         .
     4217         assign
     4218           doc-rec = integer(return-value)
     4219           v-fltopend-rowid[1] = ?
     4220         .
     4221       end.
     4222       else do:
     4223         assign
     4224         parameter-2-35 = (if p-find-next then "true":u else "false":u )
     4225         parameter-3-35 =  "FOR EACH buf_fin-liab-before"
     4226         parameter-4-35 =
     4227           (
     4228             if (" buf_fin-liab-before.host-code = par-host-code  and buf_fin-liab-before.doc-code = p-char" + " " + where-phrase-35) <> ""
     4229             then substitute(' buf_fin-liab-before.host-code = &1 and buf_fin-liab-before.doc-code = &3&2&3 ' , par-host-code , p-char , chr(34)  ) + " " + where-phrase-35
     4230             else "true"
     4231           )
     4232         parameter-5-35 = (" " + "" + " " + "" + " " + p-find-condition)
     4233         parameter-6-35 = if sort-phrase-35 = ''
     4234                              then
     4235           (
     4236           " " + " USE-INDEX by_fo " +
     4237             " " + sort-column-phrase +
     4238           " " + "  "
     4239           )
     4240                              else
     4241           (
     4242           " " + " USE-INDEX by_fo " +
     4243             " " + sort-column-phrase +
     4244           " " + sort-phrase-35
     4245           )
     4246         parameter-7-35 =
     4247           "   "
     4248       .
     4249         run fltopend_fltfindq in this-procedure  (
     4250                             input this-procedure:handle
     4251                             ,input query br-docs:handle
     4252                             ,input logical(parameter-2-35)
     4253                             ,input no-lock
     4254                             ,input parameter-3-35
     4255                             ,input parameter-4-35
     4256                             ,input parameter-5-35
     4257                             ,input parameter-6-35
     4258                             ,input parameter-7-35
     4259                             ,output v-fltopend-rowid
     4260                             ) no-error.
     4261         .
     4262         doc-rec = ?.
     4263       end.
     4264       assign
     4265         l-query-was-opened = true
     4266       .
     4267     end.
     4268   end.
     4269     run waitfram-hide in this-procedure .
     4270       END.
     4271   END CASE.
     4272   if not p-open-query then
     4273   REPOSITION br-docs to recid doc-rec No-ERROR.
     4274   if error-status :error then return error .
     4275   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4276   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4277   END PROCEDURE.
     4278   PROCEDURE print-proc :
     4279   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4280   do:
     4281     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4282       (input  v-cntxt-db-num
     4283       ,input  v-cntxt-userid
     4284       ,input  0
     4285       ,input  'actn_fin-liability_print':U
     4286       ,input  'firm':U
     4287       ,input  par-host-code
     4288       ,input  '':U
     4289       ,input  0
     4290       ,input  0
     4291       ,input  0
     4292       ,input  0
     4293       ,input  true
     4294       ,output g-log
     4295       )  .
     4296   end.
     4297   if not g-log then  return .
     4298   define variable  sym1  as character format "X(1)" init ":".
     4299   define variable  sym2  as character format "X(1)" init ":".
     4300   define variable  sym3  as character format "X(1)" init ":".
     4301   define variable  sym4  as character format "X(1)" init ":".
     4302   define variable  sym5  as character format "X(1)" init ":".
     4303   define variable  sym6  as character format "X(1)" init ":".
     4304   define variable  sym7  as character format "X(1)" init ":".
     4305   define variable  sym8  as character format "X(1)" init ":".
     4306   define variable  sym9  as character format "X(1)" init ":".
     4307   define variable  sym10 as character format "X(1)" init ":".
     4308   define variable  sym11 as character format "X(1)" init ":".
     4309   define variable  sym12 as character format "X(1)" init ":".
     4310   define variable  date_string     as      character    no-undo.
     4311   define variable  Line                as      character    no-undo.
     4312   define variable  for-time as char.
     4313   DEFINE FRAME prt-frame
     4314        buf_fin-liab-before.prn-doc-code                  column-label '№ ПФО' Format "x(10)"      space(0)     sym3                      column-label "_"       format "X(1)"       space(0)
     4315        buf_fin-liab-before.doc-date      column-label 'Создан' format  "99/99/99"  space(0)     sym4                      column-label "_"       format "X(1)"       space(0)
     4316        buf_fin-liab-before.fact-date                  column-label 'Закрыт' format "99/99/99"   space(0)     sym5                      column-label "_"       format "X(1)"       space(0)
     4317        p-contr                    column-label 'Договор'                     space(0)     sym6                      column-label "_"       format "X(1)"       space(0)
     4318        buf_fin-liab-before.receiver-name column-label 'Получатель' Format "x(10)"      space(0)        sym7                      column-label "_"       format "X(1)"       space(0)
     4319        buf_fin-liab-before.payer-name    column-label 'Плательщик' Format "x(10)"      space(0)     sym8                      column-label "_"       format "X(1)"       space(0)
     4320        buf_fin-liab-before.sum-rubl                  column-label 'Сумма РУБ'                space(0)     sym9                      column-label "_"       format "X(1)"       space(0)
     4321        l-curr                     column-label 'Вал' Format "x(3)"      space(0)   sym10                     column-label "_"       format "X(1)"       space(0)
     4322        buf_fin-liab-before.sum-doc                 column-label 'Сумма в вал.док.'                    space(0)     sym11                     column-label "_"       format "X(1)"       space(0)
     4323        buf_fin-liab-before.trn-doc-code                 column-label '№ РН' Format "x(14)"      space(0)
     4324           HEADER  date_string AT 5 format "X(35)"
     4325                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     4326                       Line format "X(116)" AT 1
     4327       with width 232 down stream-io use-text    .
     4328       Line = fill("-", 116).
     4329       date_string = cur-time-print() .
     4330       run prn-lib-open-stream  in this-procedure (
     4331          input parParentProc
     4332         ,input 43
     4333         ,input yes
     4334         ,input no
     4335         ).
     4336       PUT  STREAM PrnLibStream
     4337       SPACE(25) ( frame Dialog-Frame:title )
     4338       format "x(116)" SKIP(1) .
     4339       FORM HEADER
     4340               Line format "X(177)" AT 1 SKIP
     4341               "Продолжение - на следующей странице" AT 30 SKIP
     4342               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4343       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4344       FORM with FRAME prt-frame  .
     4345       run waitfram-show in this-procedure ("Ждите...").
     4346       run OpenBR in this-procedure (yes, no, '':U).
     4347        DO WHILE available buf_fin-liab-before :
     4348           Display STREAM PrnLibStream
     4349                buf_fin-liab-before.prn-doc-code
     4350                sym3
     4351                buf_fin-liab-before.doc-date
     4352                sym4
     4353                buf_fin-liab-before.fact-date
     4354                sym5
     4355                contract-id(recid( buf_fin-liab-before)) @ p-contr
     4356                sym6
     4357                buf_fin-liab-before.receiver-name
     4358                sym7
     4359                buf_fin-liab-before.payer-name
     4360                sym8
     4361                buf_fin-liab-before.sum-rubl
     4362                sym9
     4363                val-abbr-type(recid( buf_fin-liab-before)) @ l-curr
     4364                sym10
     4365                buf_fin-liab-before.sum-doc
     4366                sym11
     4367                buf_fin-liab-before.trn-doc-code
     4368               with FRAME prt-frame .
     4369               DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     4370               GET next br-docs.
     4371         END.
     4372         UNDERLINE  STREAM PrnLibStream
     4373                buf_fin-liab-before.prn-doc-code
     4374                sym3
     4375                buf_fin-liab-before.doc-date
     4376                sym4
     4377                buf_fin-liab-before.fact-date
     4378                sym5
     4379                p-contr
     4380                sym6
     4381                buf_fin-liab-before.receiver-name
     4382                sym7
     4383                buf_fin-liab-before.payer-name
     4384                sym8
     4385                buf_fin-liab-before.sum-rubl
     4386                sym9
     4387                l-curr
     4388                sym10
     4389                buf_fin-liab-before.sum-doc
     4390                sym11
     4391                buf_fin-liab-before.trn-doc-code
     4392       with FRAME prt-frame .
     4393       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4394       HIDE  STREAM PrnLibStream FRAME CheckList.
     4395       output  STREAM PrnLibStream CLOSE.
     4396       reposition br-docs  to row 1 no-error .
     4397       run waitfram-hide in this-procedure .
     4398       run prn-lib-prn-file in this-procedure (
     4399           input parParentProc
     4400          ,input 8
     4401           ).
     4402   END PROCEDURE.
     4403   PROCEDURE proc-b-exp :
     4404   define variable varxmldocfl      as character no-undo.
     4405   define variable varxmldocfl-type as character no-undo.
     4406   define variable v-file-name as character no-undo .
     4407   define variable for-dir as character no-undo .
     4408   define variable accum-count as integer no-undo init 0.
     4409   define variable accum-count-ok as integer no-undo init 0 .
     4410   define variable loclog as logical no-undo .
     4411   define variable ii as integer no-undo .
     4412   define variable ii0 as integer no-undo .
     4413   define buffer buf_fin-ob-before for ub.fin-ob-before.
     4414   if not available buf_fin-liab-before then do:
     4415     message "Неправильный выбор документа.".
     4416     return no-apply.
     4417   end.
     4418       assign
     4419       v-file-name =  ?
     4420       .
     4421       run bge/xmlfob.p (input buf_fin-liab-before.host-code, buf_fin-liab-before.before-code, input-output v-file-name, yes, yes) no-error .
     4422   if error-status:ERROR then do:
     4423     message
     4424     "Ошибка при выгрузке ФО в XML-формате" skip
     4425     error-status :get-message(1)
     4426     view-as alert-box .
     4427      return error .
     4428   end.
     4429   define variable v-sys-key   as character         no-undo.
     4430   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     4431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     4432     (output v-sys-key
     4433     ) no-error .
     4434   if search ("exmldoc.bat") <> ? then do:
     4435     os-command silent value(search ("exmldoc.bat") + " " + v-file-name + " " + v-sys-key).
     4436   end.
     4437   else do:
     4438     if search (v-file-name ) <> ? then do:
     4439       if accum-count-ok  > 1 then
     4440          message "ФО выгружены в файл " v-file-name view-as alert-box.
     4441       else
     4442         message "ФО выгружен в файл " v-file-name view-as alert-box.
     4443     end.
     4444   end.
     4445   END PROCEDURE.
     4446   PROCEDURE proc-b-sch :
     4447   assign
     4448     tbl = 'ub.fin-ob-before'
     4449     join-tbl = 'buf_fin-liab-before'
     4450     fld = ""
     4451     lab = ""
     4452     spr = ""
     4453     dim = '0'
     4454     .
     4455   run fltfield-add in this-procedure('before-code', '№ ПФО', '',
     4456   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4457   run fltfield-add in this-procedure('doc-code', 'Вн.№ фин.об', '',
     4458   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4459   run fltfield-add in this-procedure('trn-doc-code', '№ РН', '',
     4460   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4461   run fltfield-add in this-procedure('trn-doc-code-orig', '№ ПН', '',
     4462   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4463   run fltfield-add in this-procedure('contract-code', 'Вн.№ договора', '',
     4464   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4465   run fltfield-add in this-procedure('user-name-doc', 'Создал', 'usr',
     4466   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4467   run fltfield-add in this-procedure('doc-date', 'Дата документа', '',
     4468   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4469   run fltfield-add in this-procedure('fact-date', 'Дата факта', '',
     4470   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4471   run fltfield-add in this-procedure('curr-code', 'Валюта', 'curr',
     4472   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4473   run fltfield-add in this-procedure('status_', 'Статус', '',
     4474   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4475   run fltfield-add in this-procedure('host-code', '', '',
     4476   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4477   Filter-Block:
     4478   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4479       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4480       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4481     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4482     run openbr in this-procedure (yes, no, '':u).
     4483   END.
     4484   END PROCEDURE.
     4485   PROCEDURE proc-find-code :
     4486   define input parameter par-next as logical no-undo.
     4487   define input parameter pardoc-code as character no-undo.
     4488   display "" @ p-desc with frame Dialog-Frame.
     4489   display "" @ p-desc-2 with frame Dialog-Frame.
     4490   display "" @ p-date with frame Dialog-Frame.
     4491   assign
     4492     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4493   run OpenBr in this-procedure
     4494       (input false
     4495       ,input par-next
     4496       ,input substitute("and buf_fin-liab-before.prn-doc-code = &1 "
     4497         , pardoc-code )
     4498       ) no-error .
     4499       if error-status :error or return-value = ? then
     4500          message "Не найдено ни одной записи !" view-as alert-box .
     4501   END PROCEDURE.
     4502   PROCEDURE proc-find-date :
     4503   define input parameter par-next as logical no-undo.
     4504   define input parameter pardoc-code as date no-undo.
     4505   define variable ppp as character no-undo .
     4506   display "" @ p-desc with frame Dialog-Frame.
     4507   display "" @ p-desc-2 with frame Dialog-Frame.
     4508   display "" @ sch-code with frame Dialog-Frame.
     4509   ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4510   run OpenBr in this-procedure
     4511       (input false
     4512       ,input par-next
     4513       ,input substitute("and buf_fin-liab-before.doc-date = &1 "
     4514         , ppp )
     4515       )  no-error .
     4516       if error-status :error or return-value = ? then
     4517          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4518   END PROCEDURE.
     4519   PROCEDURE proc-find-desc :
     4520   define input parameter par-next as logical no-undo.
     4521   define input parameter pardoc-code as character no-undo.
     4522   define variable pp as integer no-undo .
     4523   define buffer b_contract for ub.contract .
     4524   display "" @ sch-code with frame Dialog-Frame.
     4525   display "" @ p-date with frame Dialog-Frame.
     4526   display "" @ p-desc-2 with frame Dialog-Frame.
     4527   if  par-next = true then
     4528       find next b_contract no-lock where b_contract.host-code = par-host-code and b_contract.contract-prn-code = pardoc-code use-index num no-error .
     4529   else
     4530     find first b_contract no-lock where b_contract.host-code = par-host-code and b_contract.contract-prn-code = pardoc-code  use-index num no-error .
     4531   if available b_contract
     4532   then do:
     4533   pp = b_contract.contract-code.
     4534       run OpenBr in this-procedure
     4535           (input false
     4536           ,input par-next
     4537           ,input substitute("and buf_fin-liab-before.contract-code = &1 "
     4538             , pp)
     4539           ) no-error .
     4540       if error-status :error or return-value = ? then
     4541          message "Не найдено ни одной записи !" view-as alert-box .
     4542   end.
     4543   else do:
     4544   message "Договор с таким номером не найден !!!" .
     4545   apply "entry":u to p-desc in frame Dialog-Frame .
     4546   end.
     4547   END PROCEDURE.
     4548   PROCEDURE proc-find-desc-2 :
     4549    do
     4550    on error undo, return error return-value
     4551    :
     4552   define input parameter par-next as logical no-undo.
     4553   define input parameter pardoc-code as character no-undo.
     4554   define variable pp as integer no-undo .
     4555   define buffer b_contract for ub.contract .
     4556   display "" @ sch-code with frame Dialog-Frame.
     4557   display "" @ p-date with frame Dialog-Frame.
     4558   display "" @ p-desc with frame Dialog-Frame.
     4559   run OpenBr in this-procedure
     4560       (input false
     4561       ,input par-next
     4562       ,input substitute("and buf_fin-liab-before.trn-doc-code begins '&1' "
     4563         , pardoc-code)
     4564       ) no-error .
     4565   if error-status :error or return-value = ? then do:
     4566       message "Запись не найдена !!!" .
     4567       apply "entry":u to p-desc-2 in frame Dialog-Frame .
     4568   end.
     4569     end.
     4570   END PROCEDURE.
     4571   PROCEDURE set-filter-name :
     4572   define input parameter p-filter-name as character no-undo .
     4573     do with frame Dialog-Frame:
     4574       if p-filter-name > "" then do:
     4575         assign
     4576           frame Dialog-Frame:title
     4577             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     4578         .
     4579         assign
     4580           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     4581         .
     4582       end.
     4583       else do:
     4584         assign
     4585           b-sch :TOOLTIP = ""
     4586         .
     4587       end.
     4588     end.
     4589   END PROCEDURE.
     4590   FUNCTION contract-id RETURNS CHARACTER
     4591   ( input p-rec as recid ) :
     4592   define  BUFFER loc-fin-liab FOR ub.fin-ob-before .
     4593   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     4594   if error-status :error then return '' .
     4595     define variable rr as character no-undo .
     4596     define buffer buf-f_contract for ub.contract.
     4597     find first buf-f_contract no-lock where  buf-f_contract.host-code      = par-host-code  and
     4598                                             buf-f_contract.contract-code  = loc-fin-liab.contract-code  no-error.
     4599     if available buf-f_contract then   rr = buf-f_contract.contract-prn-code.
     4600        else rr = "".
     4601     RETURN rr.
     4602   END FUNCTION.
     4603   FUNCTION sel-abbr RETURNS CHARACTER
     4604    ( p-curr-code as int ) :
     4605     define variable rr as character no-undo .
     4606     find first ub.currency no-lock where  ub.currency.curr-code  = p-curr-code no-error.
     4607     rr = ub.currency.curr-abbr .
     4608     RETURN rr.
     4609   END FUNCTION.
     4610   FUNCTION val-abbr-type RETURNS CHARACTER
     4611   ( input p-rec as recid ) :
     4612   define  BUFFER loc-fin-liab FOR ub.fin-ob-before .
     4613   find first loc-fin-liab no-lock where recid (loc-fin-liab) = p-rec no-error .
     4614   if error-status :error then return '' .
     4615   define variable rr as character no-undo .
     4616   find first ub.currency no-lock where  ub.currency.curr-code  = loc-fin-liab.curr-code no-error.
     4617   if available ub.currency then  rr = ub.currency.curr-abbr .
     4618   else rr = ""   .
     4619   RETURN rr.
     4620   END FUNCTION.
