     1707   procedure open-br-pump :
     1708     define input parameter p-open-query     as logical   no-undo.
     1709     define input parameter p-find-next      as logical   no-undo.
     1710     define input parameter p-find-condition as character no-undo.
     1711     define input parameter p-pl-code        as integer   no-undo.
     1712     define input parameter p-gds-code       as integer   no-undo.
     1713     define variable l-query-was-opened as logical   no-undo.
     1714     define variable sort-column-phrase as character no-undo.
     1715     define variable p-proc-hand as handle    no-undo.
     1716     define variable p-rvs-code  as character no-undo.
     1717     define variable p-chip-num  as integer   no-undo.
     1718     define variable p-obj-type  as character no-undo.
     1719     define variable p-obj-code  as integer   no-undo.
     1720     assign p-rvs-code  = ub.c-rvs-doc.rvs-code
     1721            p-chip-num  = ub.c-rvs-doc.chip-num
     1722            p-obj-type  = ub.c-rvs-doc.obj-type
     1723            p-obj-code  = ub.c-rvs-doc.obj-code
     1724            p-proc-hand = this-procedure :handle.
     1725     case sort-column-pump :
     1726       when "":U then do: assign sort-column-phrase = "":U. end.
     1727       otherwise      do: assign sort-column-phrase = "by " + sort-column-pump. end.
     1728     end case.
     1729     define variable l-open-query as logical no-undo.
     1730   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1731   define variable  l-disable-where-24  as logical   no-undo .
     1732   define variable  l-filter-open-24    as logical   .
     1733   define variable  flt-rec-24       as recid     no-undo .
     1734   define variable  filter-name-24      as character no-undo .
     1735   define variable  where-phrase-24     as character no-undo .
     1736   define variable  sort-phrase-24      as character no-undo .
     1737   define variable  where-phrase-rus-24 as character no-undo .
     1738   define variable  sort-phrase-rus-24  as character no-undo .
     1739     run waitfram-show in this-procedure
     1740       (input "ЖДИТЕ ..."
     1741       ).
     1742   run gbl/flt-get.p
     1743     (input filter-point0
     1744     ,output flt-rec-24
     1745     ,output filter-name-24
     1746     ,output where-phrase-24
     1747     ,output sort-phrase-24
     1748     ,output where-phrase-rus-24
     1749     ,output sort-phrase-rus-24
     1750     ).
     1751   if p-open-query then do:
     1752       run set-filter-name in this-procedure
     1753         (INPUT filter-name-24
     1754         ) no-error .
     1755     assign
     1756       l-filter-open-24 = false
     1757     .
     1758     if flt-rec-24 <> ?
     1759       or sort-column-phrase > ""
     1760     then do:
     1761       define variable  parameter-2-24 as character no-undo .
     1762       define variable  parameter-3-24 as character no-undo .
     1763       define variable  parameter-4-24 as character no-undo .
     1764       define variable  parameter-5-24 as character no-undo .
     1765       define variable  parameter-6-24 as character no-undo .
     1766       define variable  parameter-7-24 as character no-undo .
     1767         assign
     1768         parameter-3-24 =
     1769                                 "for each r-pump"
     1770         parameter-4-24 =
     1771           (
     1772             if ("                       r-pump.rvs-code = p-rvs-code and                       r-pump.chip-num = p-chip-num and                       r-pump.obj-type = p-obj-type and                       r-pump.obj-code = p-obj-code and                       r-pump.pl-code  = p-pl-code  and                       r-pump.gds-code = p-gds-code                     " + " " + where-phrase-24) <> ""
     1773             then  substitute('                      r-pump.rvs-code = &1&2&1 and                       r-pump.chip-num = &3 and                       r-pump.obj-type = &1&4&1 and                       r-pump.obj-code = &5 and                       r-pump.pl-code  = &6 and                       r-pump.gds-code = &7', chr(34), p-rvs-code, p-chip-num, p-obj-type, p-obj-code, p-pl-code, p-gds-code)                      + " " + where-phrase-24
     1774             else "true"
     1775           )
     1776         parameter-5-24 = (" " + "" + " " + "")
     1777         parameter-6-24 = if sort-phrase-24 = ''
     1778                              then
     1779           (
     1780           " " + "  " +
     1781             " " + sort-column-phrase +
     1782           " " + "  "
     1783           )
     1784                              else
     1785           (
     1786           " " + "  " +
     1787             " " + sort-column-phrase +
     1788           " " + sort-phrase-24
     1789           )
     1790         parameter-7-24 =
     1791           " indexed-reposition  "
     1792       .
     1793       do
     1794       on stop undo, leave
     1795       on error undo, leave
     1796       :
     1797         assign
     1798           l-disable-where-24 =
     1799             ("                       r-pump.rvs-code = p-rvs-code and                       r-pump.chip-num = p-chip-num and                       r-pump.obj-type = p-obj-type and                       r-pump.obj-code = p-obj-code and                       r-pump.pl-code  = p-pl-code  and                       r-pump.gds-code = p-gds-code                     " + " " + where-phrase-24 = "")
     1800         .
     1801         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     1802                             ,input query br-pump:handle
     1803                             ,input parameter-3-24
     1804                             ,input parameter-4-24
     1805                             ,input parameter-5-24
     1806                             ,input parameter-6-24
     1807                             ,input parameter-7-24
     1808                             )
     1809         .
     1810         assign
     1811           l-filter-open-24 = true
     1812         .
     1813       end.
     1814       if l-filter-open-24 = false then do:
     1815         message
     1816           "Ошибка при фильтрации / сортировке" skip
     1817           "Будут показаны записи без учета фильтра" skip
     1818           view-as alert-box .
     1819       end.
     1820       else do:
     1821           assign
     1822             l-query-was-opened = true
     1823           .
     1824       end.
     1825     end.
     1826     if l-filter-open-24 = false then do:
     1827       open query br-pump for each r-pump
     1828         where                        r-pump.rvs-code = p-rvs-code and                       r-pump.chip-num = p-chip-num and                       r-pump.obj-type = p-obj-type and                       r-pump.obj-code = p-obj-code and                       r-pump.pl-code  = p-pl-code  and                       r-pump.gds-code = p-gds-code
     1829         indexed-reposition
     1830     .
     1831         assign
     1832           l-query-was-opened = true
     1833         .
     1834     end.
     1835   end.
     1836   else do:
     1837     assign
     1838       doc-rec = recid( r-pump )
     1839     .
     1840     do
     1841     on stop undo, leave
     1842     on error undo, leave
     1843     :
     1844       if query br-pump:handle:get-buffer-handle(1) = (buffer r-pump:handle) then do:
     1845         assign
     1846         parameter-2-24 = (if p-find-next then "true":u else "false":u )
     1847         parameter-4-24 =
     1848           "where ":u +  substitute('                      r-pump.rvs-code = &1&2&1 and                       r-pump.chip-num = &3 and                       r-pump.obj-type = &1&4&1 and                       r-pump.obj-code = &5 and                       r-pump.pl-code  = &6 and                       r-pump.gds-code = &7', chr(34), p-rvs-code, p-chip-num, p-obj-type, p-obj-code, p-pl-code, p-gds-code)                      + " ":u + where-phrase-24 + " ":u + p-find-condition + " " + ""
     1849         parameter-5-24 = "  "
     1850       .
     1851         run fltopend_fltfindd in this-procedure  (
     1852                             input this-procedure:handle
     1853                             ,input query br-pump:handle
     1854                             ,input rowid(r-pump)
     1855                             ,input logical(parameter-2-24)
     1856                             ,input no-lock
     1857                             ,input (buffer r-pump:handle)
     1858                             ,input parameter-4-24
     1859                             ,input parameter-5-24
     1860                             ) no-error.
     1861         .
     1862         assign
     1863           doc-rec = integer(return-value)
     1864           v-fltopend-rowid[1] = ?
     1865         .
     1866       end.
     1867       else do:
     1868         assign
     1869         parameter-2-24 = (if p-find-next then "true":u else "false":u )
     1870         parameter-3-24 =  "for each r-pump"
     1871         parameter-4-24 =
     1872           (
     1873             if ("                       r-pump.rvs-code = p-rvs-code and                       r-pump.chip-num = p-chip-num and                       r-pump.obj-type = p-obj-type and                       r-pump.obj-code = p-obj-code and                       r-pump.pl-code  = p-pl-code  and                       r-pump.gds-code = p-gds-code                     " + " " + where-phrase-24) <> ""
     1874             then  substitute('                      r-pump.rvs-code = &1&2&1 and                       r-pump.chip-num = &3 and                       r-pump.obj-type = &1&4&1 and                       r-pump.obj-code = &5 and                       r-pump.pl-code  = &6 and                       r-pump.gds-code = &7', chr(34), p-rvs-code, p-chip-num, p-obj-type, p-obj-code, p-pl-code, p-gds-code)                      + " " + where-phrase-24
     1875             else "true"
     1876           )
     1877         parameter-5-24 = (" " + "" + " " + "" + " " + p-find-condition)
     1878         parameter-6-24 = if sort-phrase-24 = ''
     1879                              then
     1880           (
     1881           " " + "  " +
     1882             " " + sort-column-phrase +
     1883           " " + "  "
     1884           )
     1885                              else
     1886           (
     1887           " " + "  " +
     1888             " " + sort-column-phrase +
     1889           " " + sort-phrase-24
     1890           )
     1891         parameter-7-24 =
     1892           " indexed-reposition  "
     1893       .
     1894         run fltopend_fltfindq in this-procedure  (
     1895                             input this-procedure:handle
     1896                             ,input query br-pump:handle
     1897                             ,input logical(parameter-2-24)
     1898                             ,input no-lock
     1899                             ,input parameter-3-24
     1900                             ,input parameter-4-24
     1901                             ,input parameter-5-24
     1902                             ,input parameter-6-24
     1903                             ,input parameter-7-24
     1904                             ,output v-fltopend-rowid
     1905                             ) no-error.
     1906         .
     1907         doc-rec = ?.
     1908       end.
     1909       assign
     1910         l-query-was-opened = true
     1911       .
     1912     end.
     1913   end.
     1914     run waitfram-hide in this-procedure .
     1915     if p-open-query <> yes then do: reposition br-pump to recid doc-rec no-error. end.
     1916     apply "VALUE-CHANGED":U to br-pump in frame fr-D-doca0.
     1917   end procedure.
     1918   procedure get-dev-fact :
     1919       define input parameter p-state-measure-qnty as decimal          no-undo.
     1920       define input parameter p-state-add-qnty     as decimal          no-undo.
     1921       define input parameter p-system-qnty        as decimal          no-undo.
     1922       define output parameter p-qty               as decimal          no-undo.
     1923     assign p-qty = p-state-measure-qnty + p-state-add-qnty - p-system-qnty.
     1924   end procedure.
     1925   procedure get-dev-meas :
     1926     define        parameter buffer loc-buf for ub.c-rvs-line.
     1927     define output parameter        p-qty   as  decimal no-undo.
     1928     assign p-qty = loc-buf.measure-qnty + loc-buf.state-add-qnty - loc-buf.system-qnty.
     1929   end procedure.
     1930   procedure proc-lookup-pump :
     1931     define buffer buf_goods for ub.goods.
     1932     if not available r-pump then do:
     1933       message "Неправильный выбор строки." view-as alert-box error.
     1934       return error.
     1935     end.
     1936     assign rvs-line-rec = ( if available r-line then recid( r-line ) else ? )
     1937            rvs-pump-rec = recid( r-pump ).
     1938     find first buf_goods where buf_goods.gds-code = r-pump.gds-code no-lock.
     1939     run str/rvscpump.w ( input 'ПРОСМОТР':U, input-output rvs-pump-rec ).
     1940     find ub.c-rvs-doc where recid( ub.c-rvs-doc ) = p-rid.
     1941   end procedure.
     1942   procedure proc-lookup-line :
     1943     define buffer buf_goods for ub.goods.
     1944     if not available r-line then do:
     1945       message "Неправильный выбор строки." view-as alert-box error.
     1946       return error.
     1947     end.
     1948     assign rvs-line-rec = recid( r-line )
     1949            rvs-pump-rec = ( if available r-pump then recid( r-pump ) else ? ).
     1950     find first buf_goods no-lock where buf_goods.gds-code = r-line.gds-code.
     1951     run str/rvscline.w ( input 'ПРОСМОТР':U, input-output rvs-line-rec ).
     1952     find ub.c-rvs-doc no-lock where recid( ub.c-rvs-doc ) = p-rid.
     1953   end procedure.
