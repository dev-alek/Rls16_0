        1   define input        parameter p-parent-proc as widget-handle no-undo.
        2   define input        parameter p-mode        as character     no-undo.
        3   define input-output parameter p-rid         as recid         no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision$":U.
        5   define variable vss-author      as character no-undo initial "$Author$":U.
        6   define variable vss-date        as character no-undo initial "$Date$":U.
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        8   define variable vss-archive     as character no-undo initial "$Archive$":U.
        9   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения сверки":U.
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable v-waitfram-action01         as character   no-undo .
      115   define variable v-waitfram-action02         as character   no-undo .
      116   define variable v-waitfram-action03         as character   no-undo .
      117   define variable mWaitFramTextBeg            as character   no-undo.
      118   define variable mWaitFramTextEnd            as character   no-undo.
      119   define variable mWaitFramView               as logical     no-undo.
      120   define variable mWaitProcEvent              as logical     no-undo init yes.
      121   define variable mWaitFramInterval           as integer     no-undo init 1 .
      122   define variable mWaitFramStop               as logical     no-undo.
      123   define variable mWaitFramStopUser           as logical     no-undo.
      124   define variable mWaitFramStopTimeOut        as logical     no-undo.
      125   define variable mWaitFramStartProc          as datetime-tz no-undo.
      126   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      127   define button B-WaitFramStop auto-end-key
      128        label "Стоп"
      129        size 10 by 1 tooltip "Остоновить процесс".
      130   define button B-viewProcInfo
      131        label "Информация"
      132        size 15 by 1 tooltip "Информация о процесс".
      133   define frame waitfram
      134     v-waitfram-action01 format "x(72)" no-label skip
      135     v-waitfram-action02 format "x(72)" no-label skip
      136     v-waitfram-action03 format "x(72)" no-label skip
      137     B-viewProcInfo
      138     B-WaitFramStop at row 4 col 30
      139     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      140     .
      141   define new global shared variable mBatchMode as logical no-undo init ?.
      142   define variable mFramBachModHandle as handle no-undo.
      143   mFramBachModHandle = frame waitfram:handle.
      144   define variable mFameOldVis as logical no-undo.
      145   define variable mVisCUrentVin as logical no-undo.
      146   if session:batch-mode
      147   then
      148      mBatchMode = yes.
      149   if mBatchMode = ? then do:
      150     mVisCUrentVin = current-window:visible.
      151     mFameOldVis = mFramBachModHandle:visible.
      152     mFramBachModHandle:visible  = yes.
      153     mBatchMode = mFramBachModHandle:visible ne yes.
      154     mFramBachModHandle:visible = mFameOldVis.
      155     current-window:visible = mVisCUrentVin.
      156   end.
      157    if  log-manager:logfile-name ne ?
      158     then DO:
      159         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      160         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      161         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      162     end.
      163   on choose of B-WaitFramStop in frame waitfram
      164   do:
      165     mWaitFramStop = yes.
      166     mWaitFramStopUser = yes.
      167   end.
      168   function waitfram-check-timeout returns logical():
      169      define variable vtime as int64 no-undo.
      170      if mWaitFramStopTimeOut
      171      then
      172         return yes.
      173      vtime = ( now - mWaitFramStartProc ) / 1000 .
      174      if     mWaitFramTimeOut ne ?
      175         and mWaitFramTimeOut ne 0
      176         and mWaitFramTimeOut lt vtime
      177      then do:
      178         mWaitFramStopTimeOut = yes.
      179      end.
      180      return mWaitFramStopTimeOut.
      181   end.
      182   procedure waitfram-hide :
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       pause 0 before-hide .
      188       if not mBatchMode then
      189         hide frame waitfram .
      190     if     not mWaitFramView
      191        and mWaitProcEvent
      192     then
      193       process events .
      194     end.
      195   end procedure.
      196   procedure waitfram-show :
      197     define input  parameter p-message as character no-undo .
      198     define variable v-left-margin as integer   no-undo .
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       if length(p-message) <= 70 then do:
      204         assign
      205           v-left-margin = integer((70 - length(p-message)) / 2)
      206         .
      207         assign
      208           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      209         .
      210         assign
      211           v-waitfram-action01 = " "
      212           v-waitfram-action02 = " "
      213                                    + fill(" ", v-left-margin)
      214                                    + p-message
      215           v-waitfram-action03 = " "
      216         .
      217       end.
      218       else do:
      219         define variable vRindex1 as integer no-undo.
      220         define variable vRindex2 as integer no-undo.
      221         vRindex1 = r-index(p-message," ",70).
      222         if vRindex1 = 0
      223         then
      224            vRindex1 = 70.
      225         if length(p-message)  <= vRindex1 + 70 then do:
      226           assign
      227             v-waitfram-action01 = " "
      228             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      230           .
      231         end.
      232         else do:
      233           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      234           if vRindex2 <= vRindex1
      235           then
      236              vRindex2 = vRindex1 + 70.
      237           assign
      238             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      241           .
      242         end.
      243       end.
      244       B-viewProcInfo:visible   in frame waitfram = no.
      245       B-viewProcInfo:sensitive in frame waitfram = no.
      246       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       if  (   mWaitFramView
      249          or  mWaitProcEvent)
      250          and not mBatchMode
      251       then
      252          display
      253             v-waitfram-action01 skip
      254             v-waitfram-action02 skip
      255             v-waitfram-action03 skip
      256          with frame waitfram .
      257       if     mWaitFramView
      258          then do:
      259             if     mWaitFramInterval ne ?
      260                and not mBatchMode
      261             then
      262                wait-for go of frame waitfram pause mWaitFramInterval.
      263          end.
      264          else
      265             if     mWaitProcEvent
      266                and not mBatchMode
      267             then
      268                process events .
      269     end.
      270   end procedure.
      271      procedure waitfram-show-this:
      272         define input  parameter iInterval as int64 no-undo.
      273         define variable vtime as int64 no-undo.
      274         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      275         mWaitFramInterval = iInterval.
      276         run waitfram-show (substitute("&1&2 &3&4" ,
      277                                       mWaitFramTextBeg ,
      278                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      279                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      280                                       mWaitFramTextEnd
      281                                      )
      282                           ).
      283      end.
      284      procedure WaitFramRunPause:
      285         define input  parameter iInterval as dec no-undo.
      286         define variable vStart  as datetime-tz no-undo.
      287         define variable vend    as datetime-tz no-undo.
      288         define variable vint as int64 no-undo.
      289         define variable vOk as logical no-undo.
      290         vStart = now.
      291         vend   = vStart.
      292         publish "WaitFramPause" (iInterval,output vOk).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and (   vint > 0
      298                 or (    not vOk
      299                     and iInterval eq ?
      300                     )
      301                 )
      302         then
      303            run waitfram-show-this (iInterval).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and vint > 0
      309         then do:
      310            run gbl/pause.p (vint * 1000).
      311         end.
      312         if iInterval ne ?
      313         then
      314            publish "WaitFramStop".
      315         waitfram-check-timeout().
      316      end.
      317      procedure WaitFramWaitFor:
      318         define input  parameter iInterval as dec no-undo.
      319         assign
      320            mWaitFramStartProc   = now
      321            mWaitFramStopUser    = no
      322            mWaitFramStopTimeOut = no
      323         .
      324         block-wait:
      325         do while not mWaitFramStop:
      326            run WaitFramRunPause (iInterval).
      327            if  waitfram-check-timeout()
      328            then do:
      329               leave block-wait.
      330            end.
      331         end.
      332         run waitfram-hide.
      333      end.
      334   procedure waitfram-join :
      335     define input  parameter p-line-1  as character no-undo .
      336     define input  parameter p-line-2  as character no-undo .
      337     define input  parameter p-line-3  as character no-undo .
      338     define output parameter p-message as character no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       assign
      343         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      346       .
      347     end.
      348   end procedure.
      349   function waitfram-join-function returns character
      350     (input p-line-1 as character
      351     ,input p-line-2 as character
      352     ,input p-line-3 as character
      353     ).
      354     define variable v-message as character no-undo .
      355     run waitfram-join in this-procedure
      356       (input  p-line-1
      357       ,input  p-line-2
      358       ,input  p-line-3
      359       ,output v-message
      360       ) .
      361     return v-message .
      362   end function .
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define variable c-point  as character no-undo .
      365   define variable tbl      as character no-undo .
      366   define variable join-tbl as character no-undo .
      367   define variable fld      as character no-undo .
      368   define variable lab      as character no-undo .
      369   define variable spr      as character no-undo .
      370   define variable dim      as character no-undo .
      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   procedure fltfield-clear :
      373     define output parameter loc-fld as character no-undo.
      374     define output parameter loc-lab as character no-undo .
      375     define output parameter loc-spr as character no-undo .
      376     define output parameter loc-dim as character no-undo .
      377     assign
      378       loc-fld = ""
      379       loc-lab = ""
      380       loc-spr = ""
      381       loc-dim = "0"
      382     .
      383   end procedure .
      384   procedure fltfield-add :
      385     define input        parameter par-fld as character no-undo.
      386     define input        parameter par-lab as character no-undo .
      387     define input        parameter par-spr as character no-undo .
      388     define input-output parameter loc-fld as character no-undo.
      389     define input-output parameter loc-lab as character no-undo .
      390     define input-output parameter loc-spr as character no-undo .
      391     define input-output parameter loc-dim as character no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       assign
      396       loc-fld = if loc-dim = '0'
      397                 then par-fld
      398                 else (loc-fld + chr(44) + par-fld)
      399       loc-lab = if loc-dim = '0'
      400                 then par-lab
      401                 else (loc-lab + chr(44) + par-lab)
      402       loc-spr = if loc-dim = '0'
      403                 then par-spr
      404                 else (loc-spr + chr(44) + par-spr)
      405       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      406                 string(integer(if num-entries(loc-dim) > 1
      407                               then entry(2, loc-dim)
      408                               else entry(1, loc-dim)
      409                               ) + 1)
      410       no-error
      411       .
      412     end.
      413   end procedure.
      414   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   procedure set-filter-name :
      416   define input parameter p-filter-name as character no-undo .
      417     do with frame fr-D-doca0:
      418       if p-filter-name > "" then do:
      419         assign
      420           frame fr-D-doca0:title
      421             = frame fr-D-doca0:title + "   ФИЛЬТР: " + p-filter-name.
      422         .
      423       end.
      424       else do:
      425       end.
      426     end.
      427   end procedure.
      428   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      430   procedure fltopend_fltopend :
      431   define input parameter p-parent-handle as handle no-undo .
      432   define input parameter p-qh as handle no-undo .
      433   define input parameter p-flt-open-open-query  as character no-undo .
      434   define input parameter p-where-cond as character no-undo .
      435   define input parameter p-use-indFIRST-query-tail as character no-undo .
      436   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      437   define input parameter p-indexed-reposition as character no-undo .
      438     do
      439     on error undo, return error
      440     :
      441   define variable v-prepare-string as character no-undo .
      442   define variable glog as logical no-undo .
      443   assign
      444   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      445                      p-where-cond + chr(32)  +
      446                      p-use-indFIRST-query-tail + chr(32) +
      447                      p-use-ind-sort-clmn-by + chr(32) +
      448                      p-indexed-reposition
      449   .
      450   assign
      451   glog = p-qh:query-prepare(v-prepare-string) no-error .
      452   if not glog
      453   or error-status:error then do:
      454     message error-status:get-message(1) view-as alert-box .
      455     undo, return error .
      456   end.
      457   assign
      458   glog = p-qh:query-open no-error .
      459   if not glog
      460   or error-status:error then do:
      461     message error-status:get-message(1) view-as alert-box .
      462     undo, return error .
      463   end.
      464     end.
      465   end procedure.
      466   procedure fltopend_fltfindd :
      467   define input parameter p-parent-handle as handle no-undo .
      468   define input parameter p-qh as handle no-undo .
      469   define input parameter p-rowid as rowid no-undo .
      470   define input parameter p-next as logical no-undo .
      471   define input parameter p-lock as integer no-undo .
      472   define input parameter p-bh as handle no-undo .
      473   define input parameter p-where-cond as character no-undo .
      474   define input parameter p-use-index-phrase as character no-undo .
      475   define variable glog as logical no-undo .
      476   define variable v-qh as handle no-undo .
      477   define variable v-bh as handle no-undo .
      478   define variable v-recid as recid no-undo .
      479   define variable v-prepare-string as character no-undo .
      480   do
      481   on error undo, return error
      482   on stop undo, return error
      483   :
      484     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      485     create buffer v-bh for table p-bh buffer-name p-bh:name.
      486     create query v-qh.
      487     v-qh:set-buffers(v-bh).
      488     v-prepare-string = substitute("for each &1 &2 &3"
      489                                     ,v-bh:name
      490                                     ,p-where-cond
      491                                     ,p-use-index-phrase).
      492     glog = v-qh:query-prepare(v-prepare-string) no-error.
      493     if not glog then do:
      494       delete object v-qh.
      495       delete object v-bh.
      496       undo, return error .
      497     end.
      498     glog = v-qh:query-open no-error .
      499     if not glog then do:
      500       delete object v-qh.
      501       delete object v-bh.
      502       undo, return error .
      503     end.
      504     if p-next then do:
      505       v-qh:reposition-to-rowid(p-rowid) no-error .
      506       glog = v-qh:get-next( p-lock) no-error .
      507       glog = v-qh:get-next( p-lock) no-error .
      508       if not glog or v-qh:query-off-end = yes then do:
      509         glog = v-qh:get-first( p-lock) no-error .
      510       end.
      511     end.
      512     else do:
      513       glog = v-qh:get-first( p-lock) no-error .
      514     end.
      515     v-recid = v-bh:recid no-error .
      516     delete object v-qh.
      517     delete object v-bh.
      518     return string(v-recid) .
      519   end.
      520   end procedure.
      521   procedure fltopend_fltfindq :
      522   define input parameter p-parent-handle as handle no-undo .
      523   define input parameter p-qh as handle no-undo .
      524   define input parameter p-next as logical no-undo .
      525   define input parameter p-lock as integer no-undo .
      526   define input parameter p-flt-open-open-query  as character no-undo .
      527   define input parameter p-where-cond as character no-undo .
      528   define input parameter p-use-indFIRST-query-tail as character no-undo .
      529   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      530   define input parameter p-indexed-reposition as character no-undo .
      531   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      532   define variable glog as logical no-undo .
      533   define variable v-qh as handle no-undo .
      534   define variable v-bh as handle no-undo extent 18.
      535   define variable v-rowid as rowid no-undo extent 18.
      536   define variable v-ii as integer no-undo .
      537   define variable v-prepare-string as character no-undo .
      538   do
      539   on error undo, return error
      540   on stop undo, return error
      541   :
      542     create query v-qh.
      543     do v-ii = 1 to p-qh:num-buffers:
      544       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      545       assign
      546       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      547       no-error.
      548       v-qh:add-buffer(v-bh[v-ii]).
      549     end.
      550     assign
      551     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      552                       p-where-cond + chr(32)  +
      553                       p-use-indFIRST-query-tail + chr(32) +
      554                       p-use-ind-sort-clmn-by + chr(32) +
      555                       p-indexed-reposition
      556     .
      557     glog = v-qh:query-prepare( v-prepare-string) no-error .
      558     if not glog then do:
      559       delete object v-qh.
      560       do v-ii = 1 to p-qh:num-buffers:
      561         delete object v-bh[v-ii].
      562       end.
      563       undo, return error .
      564     end.
      565     glog = v-qh:query-open no-error .
      566     if not glog then do:
      567       delete object v-qh.
      568       do v-ii = 1 to p-qh:num-buffers:
      569         delete object v-bh[v-ii].
      570       end.
      571       undo, return error .
      572     end.
      573     if p-next then do:
      574       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      575       glog = v-qh:get-next( p-lock) no-error .
      576       glog = v-qh:get-next( p-lock) no-error .
      577       if not glog or v-qh:query-off-end = yes then do:
      578         glog = v-qh:get-first( p-lock) no-error .
      579       end.
      580     end.
      581     else do:
      582       glog = v-qh:get-first( p-lock) no-error .
      583     end.
      584     do v-ii = 1 to p-qh:num-buffers:
      585       assign
      586       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      587       no-error.
      588     end.
      589     delete object v-qh.
      590     do v-ii = 1 to p-qh:num-buffers:
      591       delete object v-bh[v-ii].
      592     end.
      593   end.
      594   end procedure.
