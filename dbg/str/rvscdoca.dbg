     1635         parameter-4-22 =
     1636           "where ":u +  substitute('r-line.rvs-code = &1&2&1 and r-line.chip-num = &3', chr(34), p-rvs-code, p-chip-num ) + " ":u + where-phrase-22 + " ":u + p-find-condition + " " + ""
     1637         parameter-5-22 = "  "
     1638       .
     1639         run fltopend_fltfindd in this-procedure  (
     1640                             input this-procedure:handle
     1641                             ,input query br-line:handle
