      887     end.
      888   end.
      889   assign ParParentProc = p-parent-proc.
      890   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      891   on F9 of frame fr-D-doca0 anywhere do:
      892     if not available ub.goods then
      893       return no-apply.
      894     gds-rec = recid (ub.goods).
      895     run ref/gds-form.w ( input ParParentProc
      896                         ,input 'ПРОСМОТР':U
      897                         ,input ?
      898                         ,input ?
      899                         ,input ?
      900                         ,input-output gds-rec).
      901     apply "entry" to br-line in frame fr-D-doca0.
      902     return no-apply.
      903   end.
      904   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   on F1 of frame fr-D-doca0 anywhere do:
      906     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-doca0. END.
      907     return no-apply.
      908   end.
      909   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   on F3 of frame fr-D-doca0 anywhere do:
      911     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame fr-D-doca0. END.
      912     return no-apply.
      913   end.
      914   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      915   if valid-handle( active-window ) and frame fr-D-doca0 :parent = ? then frame fr-D-doca0 :parent = active-window.
      916   on window-close of frame fr-D-doca0 do: apply "END-ERROR":U to self. end.
      917   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   on help of frame fr-D-doca0
      919   do:
      920     run gbl/app_help.p
      921       (input this-procedure :file-name
      922       ,input ''
      923       ,input ?
      924       ) no-error.
      925     if error-status :error then do:
      926       message
      927         "Ошибка при вызове помощи"
      928         error-status :get-message(1)
      929         view-as alert-box .
      930     end.
      931   end.
      932   run minbtn-set in this-procedure .
      933   on choose of b-help in frame fr-D-doca0
      934   do:
      935     apply "help":u to frame fr-D-doca0 .
      936   end.
      937   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   procedure minbtn-set :
      939       do
      940           on error undo, return error return-value
      941           :
      942           define variable ii              as integer       no-undo .
      943           define variable fh              as widget-handle no-undo .
      944           define variable hh              as widget-handle no-undo .
      945           define variable v-h             as handle        extent 4 no-undo .
      946           define variable v-name-button   as character     no-undo .
      947           define variable v-help-old-x    as decimal       no-undo .
      948           define variable v-help-old-y    as decimal       no-undo .
      949           define variable v-help-old-size as decimal       no-undo .
      950           define variable v-frame-width   as decimal       no-undo .
      951           define variable jj              as integer       no-undo .
      952           do
      953               on error undo, return error
      954               :
      955               assign
      956                   v-frame-width = frame fr-D-doca0:width - 0.3
      957                   fh            = frame fr-D-doca0:first-child
      958                   hh            = fh:first-child
      959                   ii            = 1
      960                   .
      961               do while valid-handle(hh):
      962                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      963                   do:
      964                       case lc(hh:name) :
      965                           when "b-help" then
      966                               do:
      967                                   hh:load-image-up("cmp/b-help.bmp":u) .
      968                                   hh:load-image-down("cmp/b-help.bmp":u) .
      969                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      970                                   hh:TOOLTIP = "Помощь" .
      971                                   v-help-old-x = hh:column .
      972                                   v-help-old-y = hh:row    .
      973                                   v-help-old-size = hh:width .
      974                                   hh:width-chars = 2.5 .
      975                               end.
      976                           when "b-print" then
      977                               do:
      978                                   hh:load-image("cmp/b-print.bmp":u) .
      979                                   hh:TOOLTIP = "Печать" .
      980                                   v-h[ii] = hh:handle .
      981                                   ii = ii + 1 .
      982                                   hh:width-chars = 3 .
      983                               end.
      984                           when "b-history" or
      985                           when "b-hist" then
      986                               do:
      987                                   hh:load-image("cmp/b-hist.bmp":u) .
      988                                   hh:TOOLTIP = "История" .
      989                                   v-h[ii] = hh:handle .
      990                                   ii = ii + 1 .
      991                                   hh:width-chars = 3 .
      992                               end.
      993                           when "b-sch" then
      994                               do:
      995                                   hh:load-image("cmp/b-sch.bmp":u) .
      996                                   hh:TOOLTIP = "Установка Фильтра" .
      997                                   v-h[ii] = hh:handle .
      998                                   ii = ii + 1 .
      999                                   hh:width-chars = 3 .
     1000                               end.
     1001                           when "b-hist-user" then
     1002                               do:
     1003                                   hh:load-image("cmp/b-hist.bmp":u) .
     1004                                   hh:TOOLTIP = "История пользователя" .
     1005                                   ii = ii + 1 .
     1006                               end.
     1007                       end case.
     1008                   end.
     1009                   hh = hh:next-sibling.
     1010               end.
     1011               b-help:column = v-frame-width - b-help:width-chars.
     1012               jj = 0.
     1013               repeat ii = 4 to 1 by -1 :
     1014                   if valid-handle (v-h[ii] ) then
     1015                   do:
     1016                       jj  = jj + 1 .
     1017                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1018                       v-h[ii]:row    = v-help-old-y .
     1019                   end.
     1020               end.
     1021           end.
     1022       end.
     1023   end procedure.
     1024   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   DEF VAR cur-clmn-numbr-line as INT EXTENT 36 no-undo.
     1026   DEF VAR varmvibr-line       as INT no-undo.
     1027   DEF VAR varmvjbr-line       as INT no-undo.
     1028   DEF VAR varmvkbr-line       as INT no-undo.
     1029   DEF VAR varmvlbr-line       as INT no-undo.
     1030   DEF VAR move-elementbr-line as INT no-undo.
     1031   def var jjbr-line           as int no-undo.
     1032   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
     1033     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
     1034   END.
     1035   RUN start-mv-clmnbr-line.
     1036   PROCEDURE start-mv-clmnbr-line:
     1037   def var old-session as logical no-undo.
     1038      old-session = SESSION:IMMEDIATE-DISPLAY.
     1039      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1040      SESSION:IMMEDIATE-DISPLAY = old-session.
     1041   END.
     1042   ON ctrl-cursor-right OF BROWSE br-line do:
     1043     RUN re-move-clmnbr-line ( 5, 36).
     1044   END.
     1045   ON ctrl-cursor-left OF BROWSE br-line do:
     1046     RUN re-move-clmnbr-line (36, 5).
     1047   END.
     1048   PROCEDURE re-move-clmnbr-line:
     1049     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1050     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1051     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1052       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
     1053     END.
     1054     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-doca0 then.
     1055     if source-column > target-column THEN
     1056     DO varmvjbr-line = source-column - 1 to target-column BY -1:
     1057       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1058           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1059             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
     1060           END.
     1061       END.
     1062     END.
     1063     ELSE
     1064     DO varmvjbr-line = source-column + 1 to target-column:
     1065       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1066         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     1067           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
     1068         END.
     1069       END.
     1070     END.
     1071     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1072       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
     1073     END.
     1074   END PROCEDURE.
     1075   PROCEDURE ch-clmnbr-line:
     1076     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1077     if cur-clmn-loc <= 5 then do:
     1078       return .
     1079     end.
     1080     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     1081       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
     1082     END.
     1083     RUN re-move-clmnbr-line (cur-clmn-loc, 5).
     1084   END PROCEDURE.
     1085   PROCEDURE mv-brw-defaultbr-line:
     1086   def var old-session as logical no-undo.
     1087     old-session = SESSION:IMMEDIATE-DISPLAY.
     1088     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1089     do varmvlbr-line = 5 to EXTENT(cur-clmn-numbr-line):
     1090       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
     1091     END.
     1092     RUN start-mv-clmnbr-line.
     1093     SESSION:IMMEDIATE-DISPLAY = old-session.
     1094   END PROCEDURE.
     1095   .
     1096   def var sort-labelbr-line   as character no-undo .
     1097   def var sort-clmnbr-line    as handle    no-undo .
     1098   def var cur-clmnbr-line     as handle    no-undo .
     1099   def var cur-clmn-locbr-line as integer   no-undo .
     1100   def var re-querybr-line     as logical   initial no no-undo .
     1101   on start-search, ctrl-o of br-line in frame fr-D-doca0 do:
     1102      run sort-brbr-line
     1103        (input (if available r-line
     1104                then recid(r-line)
     1105                else ?
     1106               )
     1107        ).
     1108   end.
     1109   PROCEDURE sort-brbr-line :
     1110     define input parameter p-recid as recid no-undo .
     1111     if re-querybr-line = no then do:
     1112       assign
     1113          cur-clmnbr-line = br-line:current-column in frame fr-D-doca0
     1114       .
     1115       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     1116       if cur-clmnbr-line = sort-clmnbr-line then do:
     1117         assign
     1118            sort-labelbr-line = ""
     1119            sort-clmnbr-line = ?
     1120         .
     1121        end.
     1122        else do:
     1123          assign
     1124            sort-labelbr-line = cur-clmnbr-line:label
     1125            sort-clmnbr-line  = cur-clmnbr-line
     1126            sort-clmnbr-line:column-fgcolor = 4
     1127          .
     1128        end.
     1129      end.
     1130     assign
     1131       cur-clmn-locbr-line = 1
     1132     .
     1133     def var column-handle as handle no-undo .
     1134     column-handle = br-line:first-column.
     1135     do while valid-handle(column-handle) :
     1136       if column-handle = cur-clmnbr-line then do:
     1137         leave .
     1138       end.
     1139       column-handle = column-handle:NEXT-COLUMN.
     1140       assign
     1141         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     1142       .
     1143     end.
     1144     case sort-labelbr-line:
     1145           when 'Артикул'  then DO:    assign       sort-column-line = "r-goods.artic"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1146           when 'Название'  then DO:    assign       sort-column-line = "r-goods.gds-name"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1147           when 'Скл.место'  then DO:    assign       sort-column-line = "r-line.pl-code"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1148           when 'Номер резервуара'  then DO:    assign       sort-column-line = "r-place.loc1"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1149           when 'Факт остаток'  then DO:    assign       sort-column-line = "r-line.state-measure-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1150           when 'Измер. остаток'  then DO:    assign       sort-column-line = "r-line.measure-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1151           when 'Учет'  then DO:    assign       sort-column-line = "r-line.system-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1152           when 'Первонач.учет'  then DO:    assign       sort-column-line = "r-line.orig-system-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1153           when 'Факт в!трубопроводе'  then DO:    assign       sort-column-line = "r-line.state-add-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1154           when 'Отклонение(факт)'  then DO:   assign       sort-column-line = substitute('dynamic-function(&1deviation-fact&1, &1&2&1, &1&3&1, &1&4&1)', chr(34), r-line.state-measure-qnty, r-line.state-add-qnty, r-line.system-qnty )     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1155           when 'Отклонение(измер)'  then DO:   assign       sort-column-line = substitute('dynamic-function(&1deviation-measure&1, &1&2&1, &1&3&1, &1&4&1)', chr(34), r-line.state-measure-qnty, r-line.state-add-qnty, r-line.system-qnty )     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1156           when 'Допустимое!отклонение'  then DO:    assign       sort-column-line = "r-line.tolerance"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1157           when 'Факт брутто'  then DO:    assign       sort-column-line = "r-line.state-brutto-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1158           when 'Измер. брутто'  then DO:    assign       sort-column-line = "r-line.brutto-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1159           when 'Плотность'  then DO:    assign       sort-column-line = "r-line.state-density"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1160           when 'Измер.!пл-ть'  then DO:    assign       sort-column-line = "r-line.density"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1161           when 'Факт!(ед. пост.)'  then DO:    assign       sort-column-line = "r-line.state-measure-cli-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1162           when 'Измер.!(ед. пост.)'  then DO:    assign       sort-column-line = "r-line.measure-cli-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1163           when 'Учет (ед.пост.)'  then DO:    assign       sort-column-line = "r-line.system-cli-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1164           when 'Нач.учет(е.п.)'  then DO:    assign       sort-column-line = "r-line.orig-system-cli-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1165           when 'Факт брутто!(ед.пост.)'  then DO:    assign       sort-column-line = "r-line.state-brutto-cli-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1166           when 'Измер. брутто! (ед.пост)'  then DO:    assign       sort-column-line = "r-line.brutto-cli-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1167           when 'Факт оборот'  then DO:    assign       sort-column-line = "r-line.state-mh-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1168           when 'Измер. оборот'  then DO:    assign       sort-column-line = "r-line.meas-mh-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1169           when 'Факт сумма!оборота'  then DO:    assign       sort-column-line = "r-line.state-am-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1170           when 'Измер. сумма!оборота'  then DO:    assign       sort-column-line = "r-line.meas-am-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1171           when 'Факт!кол-во наливов'  then DO:    assign       sort-column-line = "r-line.state-cf-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1172           when 'Измер.!кол-во наливов'  then DO:    assign       sort-column-line = "r-line.meas-cf-qnty"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1173           when 'Факт!общий уровень'  then DO:    assign       sort-column-line = "r-line.state-level-total"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1174           when 'Измер.!общий уровень'  then DO:    assign       sort-column-line = "r-line.level-total"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1175           when 'Факт!уровень топлива'  then DO:    assign       sort-column-line = "r-line.state-level-petrol"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1176           when 'Измер.!уровень топлива'  then DO:    assign       sort-column-line = "r-line.level-petrol"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1177           when 'Факт!уровень воды'  then DO:    assign       sort-column-line = "r-line.state-level-water"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1178           when 'Измер.!уровень воды'  then DO:    assign       sort-column-line = "r-line.level-water"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1179           when 'Температура'  then DO:    assign       sort-column-line = "r-line.state-temperature"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1180           when 'Измер.!темп.'  then DO:    assign       sort-column-line = "r-line.temperature"     .     run open-br-line in this-procedure ( input yes, input no, input '':U ).   . END.
     1181       otherwise do:
     1182         assign
     1183           sort-column-line = ""
     1184         .
     1185         run open-br-line in this-procedure ( input yes, input no, input '':U ).
     1186           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     1187             run mv-brw-defaultbr-line.
     1188           end.
     1189         if sort-labelbr-line <> "" then do:
     1190           assign
     1191             cur-clmnbr-line:column-fgcolor = 0
     1192           .
     1193         end.
     1194         assign
     1195           cur-clmn-locbr-line = ?
     1196         .
     1197       end.
     1198     end case.
     1199     if p-recid <> ? then do:
     1200       reposition br-line to recid p-recid no-error.
     1201       apply "value-changed" to br-line in frame fr-D-doca0.
     1202     end.
     1203     apply "entry" to br-line in frame fr-D-doca0.
     1204   END PROCEDURE.
     1205   procedure re-open-query-srt-clmnbr-line:
     1206   if cur-clmnbr-line = ? then do:
     1207      run open-br-line in this-procedure ( input yes, input no, input '':U ).
     1208   end.
     1209   else do:
     1210      assign re-querybr-line = yes.
     1211      run sort-brbr-line
     1212        (input (if available r-line
     1213                then recid(r-line)
     1214                else ?
     1215               )
     1216        ).
     1217      assign re-querybr-line = no.
     1218   end.
     1219   end.
     1220   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   DEF VAR cur-clmn-numbr-pump as INT EXTENT 18 no-undo.
     1222   DEF VAR varmvibr-pump       as INT no-undo.
     1223   DEF VAR varmvjbr-pump       as INT no-undo.
     1224   DEF VAR varmvkbr-pump       as INT no-undo.
     1225   DEF VAR varmvlbr-pump       as INT no-undo.
     1226   DEF VAR move-elementbr-pump as INT no-undo.
     1227   def var jjbr-pump           as int no-undo.
     1228   do varmvibr-pump = 1 to EXTENT(cur-clmn-numbr-pump):
     1229     ASSIGN cur-clmn-numbr-pump[varmvibr-pump] = varmvibr-pump.
     1230   END.
     1231   RUN start-mv-clmnbr-pump.
     1232   PROCEDURE start-mv-clmnbr-pump:
     1233   def var old-session as logical no-undo.
     1234      old-session = SESSION:IMMEDIATE-DISPLAY.
     1235      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1236      SESSION:IMMEDIATE-DISPLAY = old-session.
     1237   END.
     1238   ON ctrl-cursor-right OF BROWSE br-pump do:
     1239     RUN re-move-clmnbr-pump ( 3, 18).
     1240   END.
     1241   ON ctrl-cursor-left OF BROWSE br-pump do:
     1242     RUN re-move-clmnbr-pump (18, 3).
     1243   END.
     1244   PROCEDURE re-move-clmnbr-pump:
     1245     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1246     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1247     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1248       if cur-clmn-numbr-pump[varmvibr-pump] = source-column THEN cur-clmn-numbr-pump[varmvibr-pump] = -1.
     1249     END.
     1250     if br-pump:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-doca0 then.
     1251     if source-column > target-column THEN
     1252     DO varmvjbr-pump = source-column - 1 to target-column BY -1:
     1253       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1254           if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1255             cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] + 1.
     1256           END.
     1257       END.
     1258     END.
     1259     ELSE
     1260     DO varmvjbr-pump = source-column + 1 to target-column:
     1261       DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1262         if cur-clmn-numbr-pump[varmvibr-pump] = varmvjbr-pump THEN DO:
     1263           cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-numbr-pump[varmvibr-pump] - 1.
     1264         END.
     1265       END.
     1266     END.
     1267     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1268       if cur-clmn-numbr-pump[varmvibr-pump] = -1 THEN cur-clmn-numbr-pump[varmvibr-pump] = target-column.
     1269     END.
     1270   END PROCEDURE.
     1271   PROCEDURE ch-clmnbr-pump:
     1272     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1273     if cur-clmn-loc <= 3 then do:
     1274       return .
     1275     end.
     1276     DO varmvibr-pump = 1 TO EXTENT(cur-clmn-numbr-pump):
     1277       if cur-clmn-numbr-pump[varmvibr-pump] = cur-clmn-loc THEN move-elementbr-pump = varmvibr-pump.
     1278     END.
     1279     RUN re-move-clmnbr-pump (cur-clmn-loc, 3).
     1280   END PROCEDURE.
     1281   PROCEDURE mv-brw-defaultbr-pump:
     1282   def var old-session as logical no-undo.
     1283     old-session = SESSION:IMMEDIATE-DISPLAY.
     1284     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1285     do varmvlbr-pump = 3 to EXTENT(cur-clmn-numbr-pump):
     1286       RUN re-move-clmnbr-pump (cur-clmn-numbr-pump[varmvlbr-pump], varmvlbr-pump).
     1287     END.
     1288     RUN start-mv-clmnbr-pump.
     1289     SESSION:IMMEDIATE-DISPLAY = old-session.
     1290   END PROCEDURE.
     1291   .
     1292   def var sort-labelbr-pump   as character no-undo .
     1293   def var sort-clmnbr-pump    as handle    no-undo .
     1294   def var cur-clmnbr-pump     as handle    no-undo .
     1295   def var cur-clmn-locbr-pump as integer   no-undo .
     1296   def var re-querybr-pump     as logical   initial no no-undo .
     1297   on start-search, ctrl-o of br-pump in frame fr-D-doca0 do:
     1298      run sort-brbr-pump
     1299        (input (if available r-pump
     1300                then recid(r-pump)
     1301                else ?
     1302               )
     1303        ).
     1304   end.
     1305   PROCEDURE sort-brbr-pump :
     1306     define input parameter p-recid as recid no-undo .
     1307     if re-querybr-pump = no then do:
     1308       assign
     1309          cur-clmnbr-pump = br-pump:current-column in frame fr-D-doca0
     1310       .
     1311       if sort-clmnbr-pump <> ? then sort-clmnbr-pump:column-fgcolor = 0.
     1312       if cur-clmnbr-pump = sort-clmnbr-pump then do:
     1313         assign
     1314            sort-labelbr-pump = ""
     1315            sort-clmnbr-pump = ?
     1316         .
     1317        end.
     1318        else do:
     1319          assign
     1320            sort-labelbr-pump = cur-clmnbr-pump:label
     1321            sort-clmnbr-pump  = cur-clmnbr-pump
     1322            sort-clmnbr-pump:column-fgcolor = 4
     1323          .
     1324        end.
     1325      end.
     1326     assign
     1327       cur-clmn-locbr-pump = 1
     1328     .
     1329     def var column-handle as handle no-undo .
     1330     column-handle = br-pump:first-column.
     1331     do while valid-handle(column-handle) :
     1332       if column-handle = cur-clmnbr-pump then do:
     1333         leave .
     1334       end.
     1335       column-handle = column-handle:NEXT-COLUMN.
     1336       assign
     1337         cur-clmn-locbr-pump = cur-clmn-locbr-pump + 1
     1338       .
     1339     end.
     1340     case sort-labelbr-pump:
     1341           when 'ТРК'  then DO:    assign       sort-column-line = "r-pump.pump-code"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1342           when 'П'  then DO:    assign       sort-column-line = "r-pump.nozzle-code"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1343           when 'Факт оборот'  then DO:    assign       sort-column-line = "r-pump.state-mh-qnty"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1344           when 'Измер. оборот'  then DO:    assign       sort-column-line = "r-pump.meas-mh-qnty"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1345           when 'Факт сумма!оборота'  then DO:    assign       sort-column-line = "r-pump.state-am-qnty"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1346           when 'Измер. сумма!оборота'  then DO:    assign       sort-column-line = "r-pump.meas-am-qnty"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1347           when 'Факт!кол-во наливов'  then DO:    assign       sort-column-line = "r-pump.state-cf-qnty"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1348           when 'Измер.!кол-во наливов'  then DO:    assign       sort-column-line = "r-pump.meas-cf-qnty"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1349           when 'Показ. механического!счетчика'  then DO:    assign       sort-column-line = "r-pump.state-mh-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1350           when 'Измер. механического! счетчика'  then DO:    assign       sort-column-line = "r-pump.meas-mh-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1351           when 'Показ. электронного!счетчика'  then DO:    assign       sort-column-line = "r-pump.state-el-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1352           when 'Измер. электронного!счетчика'  then DO:    assign       sort-column-line = "r-pump.meas-el-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1353           when 'Сумма по показ.!счетчика'  then DO:    assign       sort-column-line = "r-pump.state-am-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1354           when 'Сумма по измер.!счетчика'  then DO:    assign       sort-column-line = "r-pump.meas-am-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1355           when 'Кол-во наливов!по показ. счетчика'  then DO:    assign       sort-column-line = "r-pump.state-cf-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1356           when 'Кол-во наливов!по  измер. счетчика'  then DO:    assign       sort-column-line = "r-pump.meas-cf-cnt"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1357           when 'Номер док-та!инвент. счетчика'  then DO:    assign       sort-column-line = "r-pump.icnt-code"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1358           when 'Сверка на начало'  then DO:    assign       sort-column-line = "r-pump.rvs-prev-code"     .     run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).                                . END.
     1359       otherwise do:
     1360         assign
     1361           sort-column-line = ""
     1362         .
     1363                                       run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).
     1364           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pump') then do:
     1365             run mv-brw-defaultbr-pump.
     1366           end.
     1367         if sort-labelbr-pump <> "" then do:
     1368           assign
     1369             cur-clmnbr-pump:column-fgcolor = 0
     1370           .
     1371         end.
     1372         assign
     1373           cur-clmn-locbr-pump = ?
     1374         .
     1375       end.
     1376     end case.
     1377     if p-recid <> ? then do:
     1378       reposition br-pump to recid p-recid no-error.
     1379       apply "value-changed" to br-pump in frame fr-D-doca0.
     1380     end.
     1381     apply "entry" to br-pump in frame fr-D-doca0.
     1382   END PROCEDURE.
     1383   procedure re-open-query-srt-clmnbr-pump:
     1384   if cur-clmnbr-pump = ? then do:
     1385                                    run open-br-pump in this-procedure ( input yes,                                                                          input no,                                                                          input '':U,                                                                          input r-line.pl-code,                                                                          input r-line.gds-code ).
     1386   end.
     1387   else do:
     1388      assign re-querybr-pump = yes.
     1389      run sort-brbr-pump
     1390        (input (if available r-pump
     1391                then recid(r-pump)
     1392                else ?
     1393               )
     1394        ).
     1395      assign re-querybr-pump = no.
     1396   end.
     1397   end.
     1398   Main-Block:
     1399   do on error   undo Main-Block, leave Main-Block
     1400      on end-key undo Main-Block, leave Main-Block :
     1401     if p-mode <> 'ПРОСМОТР':U then do:
     1402       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
     1403               "Неверное значение параметра вызова p-mode:" p-mode
     1404       view-as alert-box error.
     1405       undo Main-Block, return error.
     1406     end.
     1407     find ub.c-rvs-doc no-lock where recid( ub.c-rvs-doc ) = p-rid no-error.
     1408     if not available ub.c-rvs-doc then do:
     1409       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
     1410               "Не найдена КАРТОЧКА ИСТОРИИ СВЕРКИ."
     1411       view-as alert-box error.
     1412       undo Main-Block, return error.
     1413     end.
     1414     find ub.clients no-lock where
     1415          ub.clients.obj-type = ub.c-rvs-doc.obj-type and
     1416          ub.clients.obj-code = ub.c-rvs-doc.obj-code no-error.
     1417     assign frame fr-D-doca0 :title =
     1418       ( if available ub.clients then substring( ub.clients.obj-name, 1, 35 ) else (
     1419         ub.c-rvs-doc.obj-type + " ":U + string( ub.c-rvs-doc.obj-code ) ) ) +
     1420       ":   КАРТОЧКА ИСТОРИИ ИЗМЕНЕНИЯ ДОКУМЕНТА СВЕРКИ - " +
     1421         ub.c-rvs-doc.status_  + " № " + ub.c-rvs-doc.rvs-code + "      - " + p-mode.
     1422     if available ub.clients then do:
     1423       display     ub.clients.obj-name with frame fr-D-doca0.
     1424     end.
     1425     else do:
     1426       display ? @ ub.clients.obj-name with frame fr-D-doca0.
     1427     end.
     1428     disable all with frame fr-D-doca0.
     1429     assign r-line.temperature :read-only in browse br-line = yes
     1430            r-pump.rvs-prev-code :read-only in browse br-pump = yes.
     1431     display ub.c-rvs-doc.obj-code
     1432             ub.c-rvs-doc.obj-type
     1433             ub.c-rvs-doc.doc-date
     1434             ub.c-rvs-doc.state-measure-qnty
     1435             ub.c-rvs-doc.measure-qnty
     1436             ub.c-rvs-doc.system-qnty
     1437             ub.c-rvs-doc.state-measure-cli-qnty
     1438             ub.c-rvs-doc.measure-cli-qnty
     1439             ub.c-rvs-doc.system-cli-qnty
     1440             ub.c-rvs-doc.system-cli-avrg-qnty
     1441             ub.c-rvs-doc.state-mh-qnty
     1442             ub.c-rvs-doc.state-am-qnty
     1443             ub.c-rvs-doc.state-cf-qnty
     1444             ub.c-rvs-doc.out-code
     1445             ub.c-rvs-doc.state-measure-tc-qnty
     1446             ub.c-rvs-doc.measure-tc-qnty
     1447             ub.c-rvs-doc.state-brutto-tc-qnty
     1448             ub.c-rvs-doc.brutto-tc-qnty
     1449     with frame fr-D-doca0.
     1450     enable Btn_Exit b-help b-lkp Btn_Pump Btn_Notes br-line br-pump with frame fr-D-doca0.
     1451     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-doca0. end.
     1452     define variable v-ref-rec18   as recid no-undo .
     1453     find cli-buf where cli-buf.obj-code = input frame fr-D-doca0 ub.c-rvs-doc.wrkr
     1454                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1455   if not available cli-buf then do:
     1456     display ub.c-rvs-doc.wrkr with frame fr-D-doca0.
     1457     find cli-buf no-lock where cli-buf.obj-code = input frame fr-D-doca0 ub.c-rvs-doc.wrkr
     1458                            and cli-buf.obj-type = 'чел':U no-error.
     1459   end.
     1460   if available cli-buf then do:
     1461         display cli-buf.obj-code @ ub.c-rvs-doc.wrkr cli-buf.obj-name @ wrkr-name with frame fr-D-doca0.
     1462     end.
     1463     else display ? @ ub.c-rvs-doc.wrkr ? @ wrkr-name with frame fr-D-doca0.
     1464     define variable v-ref-rec19   as recid no-undo .
     1465     find cli-buf where cli-buf.obj-code = input frame fr-D-doca0 ub.c-rvs-doc.agnt
     1466                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1467   if not available cli-buf then do:
     1468     display ub.c-rvs-doc.agnt with frame fr-D-doca0.
     1469     find cli-buf no-lock where cli-buf.obj-code = input frame fr-D-doca0 ub.c-rvs-doc.agnt
     1470                            and cli-buf.obj-type = 'чел':U no-error.
     1471   end.
     1472   if available cli-buf then do:
     1473         display cli-buf.obj-code @ ub.c-rvs-doc.agnt cli-buf.obj-name @ agnt-name with frame fr-D-doca0.
     1474     end.
     1475     else display ? @ ub.c-rvs-doc.agnt ? @ agnt-name with frame fr-D-doca0.
     1476     define variable v-ref-rec20   as recid no-undo .
     1477     find cli-buf where cli-buf.obj-code = input frame fr-D-doca0 ub.c-rvs-doc.boss
     1478                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     1479   if not available cli-buf then do:
     1480     display ub.c-rvs-doc.boss with frame fr-D-doca0.
     1481     find cli-buf no-lock where cli-buf.obj-code = input frame fr-D-doca0 ub.c-rvs-doc.boss
     1482                            and cli-buf.obj-type = 'чел':U no-error.
     1483   end.
     1484   if available cli-buf then do:
     1485         display cli-buf.obj-code @ ub.c-rvs-doc.boss cli-buf.obj-name @ boss-name with frame fr-D-doca0.
     1486     end.
     1487     else display ? @ ub.c-rvs-doc.boss ? @ boss-name with frame fr-D-doca0.
     1488     run open-br-line in this-procedure ( input yes, input no, input '':U ).
     1489     apply "VALUE-CHANGED":U to br-line in frame fr-D-doca0.
     1490     if num-results( "br-line" ) > 0 then do: if br-line :refresh( ) then. end.
     1491     wait-for go of frame fr-D-doca0.
     1492   end.
     1493   hide frame fr-D-doca0 no-pause.
     1494   procedure open-br-line :
     1495     define input parameter p-open-query     as logical   no-undo.
     1496     define input parameter p-find-next      as logical   no-undo.
     1497     define input parameter p-find-condition as character no-undo.
     1498     define variable l-query-was-opened as logical   no-undo.
     1499     define variable sort-column-phrase as character no-undo.
     1500     define variable p-proc-hand as handle    no-undo.
     1501     define variable p-rvs-code  as character no-undo.
     1502     define variable p-chip-num  as integer   no-undo.
     1503     assign p-rvs-code  = ub.c-rvs-doc.rvs-code
     1504            p-chip-num  = ub.c-rvs-doc.chip-num
     1505            p-proc-hand = this-procedure :handle.
     1506     case sort-column-line :
     1507       when "":U then do: assign sort-column-phrase = "":U. end.
     1508       otherwise      do: assign sort-column-phrase = "by " + sort-column-line. end.
     1509     end case.
     1510     define variable l-open-query as logical no-undo.
     1511     find ub.clients no-lock where
     1512          ub.clients.obj-type = ub.c-rvs-doc.obj-type and
     1513          ub.clients.obj-code = ub.c-rvs-doc.obj-code no-error.
     1514     assign frame fr-D-doca0 :title = ( if available ub.clients then substring( ub.clients.obj-name, 1, 35 )
     1515                                           else ( ub.c-rvs-doc.obj-type + " ":U + string( ub.c-rvs-doc.obj-code ) ) ) +
     1516        ":   КАРТОЧКА ИСТОРИИ ИЗМЕНЕНИЯ ДОКУМЕНТА СВЕРКИ - " + ub.c-rvs-doc.status_  + " № " + ub.c-rvs-doc.rvs-code +
     1517        "      - " + p-mode.
     1518   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   define variable  l-disable-where-22  as logical   no-undo .
     1520   define variable  l-filter-open-22    as logical   .
     1521   define variable  flt-rec-22       as recid     no-undo .
     1522   define variable  filter-name-22      as character no-undo .
     1523   define variable  where-phrase-22     as character no-undo .
     1524   define variable  sort-phrase-22      as character no-undo .
     1525   define variable  where-phrase-rus-22 as character no-undo .
     1526   define variable  sort-phrase-rus-22  as character no-undo .
     1527     run waitfram-show in this-procedure
     1528       (input "ЖДИТЕ ..."
     1529       ).
     1530   run gbl/flt-get.p
     1531     (input filter-point
     1532     ,output flt-rec-22
     1533     ,output filter-name-22
     1534     ,output where-phrase-22
     1535     ,output sort-phrase-22
     1536     ,output where-phrase-rus-22
     1537     ,output sort-phrase-rus-22
     1538     ).
     1539   if p-open-query then do:
     1540       run set-filter-name in this-procedure
     1541         (INPUT filter-name-22
     1542         ) no-error .
     1543     assign
     1544       l-filter-open-22 = false
     1545     .
     1546     if flt-rec-22 <> ?
     1547       or sort-column-phrase > ""
     1548     then do:
     1549       define variable  parameter-2-22 as character no-undo .
     1550       define variable  parameter-3-22 as character no-undo .
     1551       define variable  parameter-4-22 as character no-undo .
     1552       define variable  parameter-5-22 as character no-undo .
     1553       define variable  parameter-6-22 as character no-undo .
     1554       define variable  parameter-7-22 as character no-undo .
     1555         assign
     1556         parameter-3-22 =
     1557                                 "for each r-line no-lock"
     1558         parameter-4-22 =
     1559           (
     1560             if ("                       r-line.rvs-code = p-rvs-code and                       r-line.chip-num = p-chip-num                     " + " " + where-phrase-22) <> ""
     1561             then  substitute('r-line.rvs-code = &1&2&1 and r-line.chip-num = &3', chr(34), p-rvs-code, p-chip-num ) + " " + where-phrase-22
     1562             else "true"
     1563           )
     1564         parameter-5-22 = (" " + "" + " " + ", first r-goods     no-lock where r-goods.gds-code = r-line.gds-code                                     , first r-place     no-lock where r-place.obj-type = r-line.obj-type and                                                                       r-place.obj-code = r-line.obj-code and                                                                       r-place.pl-code  = r-line.pl-code")
     1565         parameter-6-22 = if sort-phrase-22 = ''
     1566                              then
     1567           (
     1568           " " + "  " +
     1569             " " + sort-column-phrase +
     1570           " " + "  "
     1571           )
     1572                              else
     1573           (
     1574           " " + "  " +
     1575             " " + sort-column-phrase +
     1576           " " + sort-phrase-22
     1577           )
     1578         parameter-7-22 =
     1579           "   "
     1580       .
     1581       do
     1582       on stop undo, leave
     1583       on error undo, leave
     1584       :
     1585         assign
     1586           l-disable-where-22 =
     1587             ("                       r-line.rvs-code = p-rvs-code and                       r-line.chip-num = p-chip-num                     " + " " + where-phrase-22 = "")
     1588         .
     1589         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     1590                             ,input query br-line:handle
     1591                             ,input parameter-3-22
     1592                             ,input parameter-4-22
     1593                             ,input parameter-5-22
     1594                             ,input parameter-6-22
     1595                             ,input parameter-7-22
     1596                             )
     1597         .
     1598         assign
     1599           l-filter-open-22 = true
     1600         .
     1601       end.
     1602       if l-filter-open-22 = false then do:
     1603         message
     1604           "Ошибка при фильтрации / сортировке" skip
     1605           "Будут показаны записи без учета фильтра" skip
     1606           view-as alert-box .
     1607       end.
     1608       else do:
     1609           assign
     1610             l-query-was-opened = true
     1611           .
     1612       end.
     1613     end.
     1614     if l-filter-open-22 = false then do:
     1615       open query br-line for each r-line no-lock
     1616         where                        r-line.rvs-code = p-rvs-code and                       r-line.chip-num = p-chip-num
     1617       , first r-goods     no-lock where r-goods.gds-code = r-line.gds-code                                     , first r-place     no-lock where r-place.obj-type = r-line.obj-type and                                                                       r-place.obj-code = r-line.obj-code and                                                                       r-place.pl-code  = r-line.pl-code
     1618     .
