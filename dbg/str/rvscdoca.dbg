     1646                             ,input parameter-4-22
     1647                             ,input parameter-5-22
     1648                             ) no-error.
     1649         .
     1650         assign
     1651           doc-rec = integer(return-value)
     1652           v-fltopend-rowid[1] = ?
     1653         .
     1654       end.
     1655       else do:
     1656         assign
     1657         parameter-2-22 = (if p-find-next then "true":u else "false":u )
     1658         parameter-3-22 =  "for each r-line no-lock"
