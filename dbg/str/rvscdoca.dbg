      603   function deviation-fact returns decimal (
      604         input p-state-measure-qnty as decimal
      605       , input p-state-add-qnty     as decimal
      606       , input p-system-qnty        as decimal
      607   ):
      608       define variable dev-fact-qty as decimal no-undo.
      609       run get-dev-fact in this-procedure (
      610             input p-state-measure-qnty
      611           , input p-state-add-qnty
      612           , input p-system-qnty
      613           , output dev-fact-qty
      614       ).
      615       return ( dev-fact-qty ).
      616   end function.
      617   function deviation-measure returns decimal (
      618         input p-state-measure-qnty as decimal
      619       , input p-state-add-qnty     as decimal
      620       , input p-system-qnty        as decimal
      621   ) :
      622     define variable dev-meas-qty as decimal no-undo.
      623       run get-dev-fact in this-procedure (
      624             input p-state-measure-qnty
      625           , input p-state-add-qnty
      626           , input p-system-qnty
      627           , output dev-meas-qty
      628       ).
      629       return ( dev-meas-qty ).
      630   end function.
