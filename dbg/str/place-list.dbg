        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   define input parameter p-obj-type  as character no-undo.
        6   define input parameter p-obj-code  as integer   no-undo.
        7   define input parameter p-gds-code  as integer   no-undo.
        8   define input-output parameter p-list-tank as character no-undo.
        9   define buffer buf_pl-gds for ub.pl-gds.
       10   define buffer buf_place for ub.place.
       11   define temp-table tt-pl
       12     field pl-code as integer label "Место хранения"
       13     field pl-name as character label "Название"
       14     field pl-coord as character label "Коорд1".
       15   DEFINE BUTTON btn_cancel AUTO-END-KEY
       16        LABEL "Отмена"
       17        SIZE 7 BY 1.
       18   DEFINE BUTTON Btn_OK AUTO-GO
       19        LABEL "Ввод"
       20        SIZE 6 BY 1
       21        BGCOLOR 8 .
       22   DEFINE BUTTON btn_mark
       23        LABEL "*"
       24        SIZE 3 BY 1.
       25   DEFINE QUERY BROWSE-2 FOR
       26         tt-pl SCROLLING.
       27   DEFINE BROWSE BROWSE-2
       28       QUERY BROWSE-2 DISPLAY
       29     tt-pl.pl-code format "99999999999"
       30     tt-pl.pl-name
       31     tt-pl.pl-coord
       32       WITH NO-ROW-MARKERS SEPARATORS SIZE 53 BY 10
       33            TITLE "Места хранения по линии накладной" ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
       34   DEFINE FRAME Dialog-Frame
       35        Btn_OK AT ROW 1.08 COL 1.63
       36        btn_cancel AT ROW 1.08 COL 10.88 WIDGET-ID 2
       37        BROWSE-2 AT ROW 2.25 COL 1.5 WIDGET-ID 200
       38        SPACE(0.49) SKIP(0.24)
       39       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       40            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       41            TITLE "Места хранения"
       42            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
       43   ASSIGN
       44          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       45          FRAME Dialog-Frame:HIDDEN           = TRUE.
       46   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       47   DO:
       48     APPLY "END-ERROR":U TO SELF.
       49   END.
       50   ON choose OF Btn_ok IN FRAME Dialog-Frame
       51   do:
       52     p-list-tank = "".
       53     p-list-tank = left-trim (tt-pl.pl-coord).
       54     end.
       55   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       56   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       57   MAIN-BLOCK:
       58   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       59      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       60     for each buf_pl-gds no-lock where buf_pl-gds.obj-type = p-obj-type
       61                                   and buf_pl-gds.obj-code = p-obj-code
       62                                   and buf_pl-gds.gds-code = p-gds-code
       63                                   :
       64       find first buf_place no-lock where buf_place.obj-type = buf_pl-gds.obj-type
       65                                      and buf_place.obj-code = buf_pl-gds.obj-code
       66                                      and buf_place.pl-code  = buf_pl-gds.pl-code
       67                                      and buf_place.status_  = ""
       68                                      no-error.
       69       if available buf_place
       70       then do :
       71         create tt-pl.
       72         assign
       73           tt-pl.pl-code  = buf_place.pl-code
       74           tt-pl.pl-name  = buf_place.pl-name
       75           tt-pl.pl-coord = buf_place.loc1
       76         .
       77       end .
       78     end.
       79     RUN enable_UI.
       80     WAIT-FOR GO OF FRAME Dialog-Frame.
       81   END.
       82   RUN disable_UI.
       83   PROCEDURE disable_UI :
       84     HIDE FRAME Dialog-Frame.
       85   END PROCEDURE.
       86   PROCEDURE enable_UI :
       87     ENABLE Btn_OK btn_mark btn_cancel BROWSE-2
       88         WITH FRAME Dialog-Frame.
       89     VIEW FRAME Dialog-Frame.
       90     OPEN QUERY BROWSE-2 FOR EACH tt-pl.
       91   END PROCEDURE.
