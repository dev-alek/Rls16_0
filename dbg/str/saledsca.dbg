       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure cur-time :
       73      define output parameter p-today as date      no-undo .
       74      define output parameter p-time  as integer   no-undo .
       75     do
       76     on error undo, return error
       77     :
       78       define variable v-date1 as date      no-undo .
       79       define variable v-date2 as date      no-undo .
       80       define variable v-time  as integer   no-undo .
       81       assign
       82         v-date1 = today
       83         v-time  = time
       84         v-date2 = today
       85       .
       86       if v-date1 <> v-date2
       87       then do:
       88         assign
       89           v-date1 = today
       90           v-time  = v-time
       91         .
       92       end.
       93       assign
       94         p-today = v-date1
       95         p-time  = v-time
       96       .
       97     end.
       98   end.
       99   function cur-time-date returns character
      100   :
      101     return string(today, '99/99/9999':U) .
      102   end.
      103   function cur-time-mjd returns decimal
      104   :
      105     define variable v-date as date      no-undo .
      106     define variable v-time as integer   no-undo .
      107     run cur-time in this-procedure
      108       (output v-date
      109       ,output v-time
      110       ) .
      111     return integer(v-date) - 2400002 + (v-time / 86400) .
      112   end.
      113   function cur-time-get-ending-index returns integer
      114   (input p-number as integer
      115   )
      116   :
      117     if p-number < 0
      118     or p-number = ?
      119     then do:
      120       return 1 .
      121     end.
      122     define variable v-rest as integer   no-undo .
      123     assign
      124       p-number = p-number modulo 100
      125     .
      126     if p-number < 20
      127     then do:
      128       assign
      129         v-rest = p-number
      130       .
      131     end.
      132     else do:
      133       assign
      134         v-rest = p-number modulo 10
      135       .
      136     end.
      137     case v-rest :
      138       when 1
      139       then do:
      140         return 2 .
      141       end.
      142       when 2 or
      143       when 3 or
      144       when 4
      145       then do:
      146         return 3 .
      147       end.
      148       otherwise do:
      149         return 1 .
      150       end.
      151     end case .
      152   end.
      153   procedure cur-time-mjd-to-date :
      154      define input  parameter i-mjd-diff as decimal no-undo.
      155      define output parameter o-Date     as date    no-undo.
      156      define output parameter o-Time     as integer no-undo.
      157      define variable v-day-number as integer   no-undo .
      158      if    i-mjd-diff < 0
      159         or i-mjd-diff = ?
      160      then do:
      161         return "?" .
      162      end.
      163      assign
      164         v-day-number = truncate(i-mjd-diff,0).
      165         o-Date = date(v-day-number + 2400002).
      166         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      167     .
      168   end.
      169   function cur-time-mjd-to-string returns character
      170   (input p-mjd-diff as decimal
      171   )
      172   :
      173     define variable v-day-number as integer   no-undo .
      174     define variable v-seconds    as integer   no-undo .
      175     define variable v-hour       as integer   no-undo .
      176     define variable v-min        as integer   no-undo .
      177     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      178     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      179     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      180     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      181     if p-mjd-diff < 0
      182     or p-mjd-diff = ?
      183     then do:
      184       return "?" .
      185     end.
      186     assign
      187       v-day-number = integer(truncate(p-mjd-diff,0))
      188       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190     if v-seconds > 86400
      191     then do:
      192       assign
      193         v-seconds = 86400 - 1
      194       .
      195     end.
      196     if v-seconds < 0
      197     then do:
      198       assign
      199         v-seconds = 0
      200       .
      201     end.
      202     assign
      203       v-hour = truncate(v-seconds / 3600, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 3600
      207     .
      208     assign
      209       v-min = truncate(v-seconds / 60, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 60
      213     .
      214     return
      215         (if v-day-number <> 0
      216           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0
      220           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      224           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      225           else ""
      226         )
      227       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      228       .
      229   end.
      230   function cur-time-string returns character
      231   :
      232     define variable v-date as date      no-undo .
      233     define variable v-time as integer   no-undo .
      234     run cur-time in this-procedure
      235       (output v-date
      236       ,output v-time
      237       ) .
      238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      239   end.
      240   function cur-time-string-sec returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      249   end.
      250   function cur-time-custom  returns character
      251   (input p-prefix as character
      252   ,input p-date-format as character
      253   ,input p-delimiter as character
      254   ,input p-time-format as character
      255   ,input p-suffix as character
      256   )
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return
      265       p-prefix
      266       + string(v-date, p-date-format)
      267       + p-delimiter
      268       + string(v-time, p-time-format)
      269       + p-suffix
      270       .
      271   end.
      272   function cur-time-print  returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-datetime returns datetime
      283   :
      284     define variable v-char as character no-undo .
      285     define variable v-datetime as datetime no-undo .
      286     v-char = cur-time-string().
      287     v-datetime = datetime(v-char).
      288     return  v-datetime.
      289   end.
      290   function cur-time-string-msec returns character
      291   :
      292     define variable v-date as datetime  no-undo .
      293     v-date = now.
      294     return string(v-date) .
      295   end.
      296   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      298   define new shared variable RepPathName        as character no-undo .
      299   define new shared variable PrintRubl          as logical   no-undo .
      300   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   define  stream PrnLibStream.
      302   procedure prn-lib-prn-file :
      303     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      304     define input parameter p-DIsabledoptions as integer no-undo .
      305     define variable v-report-name as character no-undo .
      306     define variable v-user-action as character no-undo .
      307     define variable v-printed     as logical   no-undo .
      308     define variable v-exist       as logical   no-undo .
      309     do
      310       on error undo, return error
      311       :
      312       run prn-lib-get-report-name  in this-procedure (
      313         input parParentProc
      314         ,output v-report-name
      315         ).
      316   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      318     (input  v-report-name
      319     ,input  2
      320     ,output v-exist
      321     )  .
      322       if NOT v-exist then
      323       DO:
      324         Message
      325           "Нет заданий на печать ! "
      326           view-as alert-box .
      327         Return  .
      328       End.
      329       run gbl/prnfilen.w
      330         (input  ""
      331         ,input  p-DisabledOptions
      332         ,input  string(v-report-name )
      333         ,input  7
      334         ,output v-user-action
      335         ,output v-printed
      336         ) .
      337       if v-printed then
      338       do:
      339         return "YES" .
      340       end.
      341       else
      342       do:
      343         return "NO" .
      344       end.
      345     end.
      346   end procedure.
      347   procedure prn-lib-open-stream :
      348     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      349     define input parameter p-page-size    as integer no-undo .
      350     define input parameter p-is-stream    as logical no-undo .
      351     define input parameter p-append       as logical no-undo .
      352     define variable v-report-name as character no-undo .
      353     do
      354       on error undo, return error
      355       :
      356       run prn-lib-get-report-name  in this-procedure (
      357         input parParentProc
      358         ,output v-report-name
      359         ).
      360       if p-is-stream then
      361       do:
      362         if p-append then
      363         do:
      364           output stream PrnLibStream to value( v-report-name )
      365             page-size value(p-page-size) append .
      366         end.
      367         if not p-append then
      368         do:
      369           output stream PrnLibStream to value( v-report-name )
      370             page-size value(p-page-size) .
      371         end.
      372       end.
      373       if not p-is-stream then
      374       do:
      375         if p-append then
      376         do:
      377           output to value( v-report-name )
      378             page-size value(p-page-size) append .
      379         end.
      380         if not p-append then
      381         do:
      382           output to value( v-report-name )
      383             page-size value(p-page-size) .
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   procedure prn-lib-open-exp :
      389     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      390     define input parameter p-is-stream    as logical no-undo .
      391     define input parameter p-is-append    as logical no-undo .
      392     define output parameter p-ReportFileName as char init "report" no-undo.
      393     define output parameter p-process as logical no-undo .
      394     define variable glog as logical no-undo .
      395     do
      396       on error undo, return error
      397       :
      398       SYSTEM-DIALOG GET-FILE p-ReportFileName
      399         TITLE      "Укажите путь"
      400         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      401         ASK-OVERWRITE
      402         CREATE-TEST-FILE
      403         SAVE-AS
      404         USE-FILENAME
      405         DEFAULT-EXTENSION "txt"
      406         UPDATE glog
      407         .
      408       if not glog then  return.
      409       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      410       if p-is-stream then
      411       do:
      412         if p-is-append then
      413         do:
      414           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      415         end.
      416         else
      417         do:
      418           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      419         end.
      420       end.
      421       else
      422       do:
      423         if p-is-append then
      424         do:
      425           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      426         end.
      427         else
      428         do:
      429           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      430         end.
      431       end.
      432       p-process = yes.
      433     end.
      434   end procedure.
      435   procedure prn-lib-get-report-name :
      436     define input parameter parParentProc  as widget-handle no-undo.
      437     define output parameter p-report-name as character no-undo .
      438     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      439   end procedure.
      440   procedure prn-lib-reportviewer-report-name :
      441     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      442     define input parameter p-report-name-html as character no-undo .
      443     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      444   end procedure.
      445   procedure prn-lib-reportviewer :
      446     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      447     define input parameter p-report-name-html as character no-undo .
      448     define input parameter p-param        as character no-undo .
      449     define variable v-excel           as character no-undo init 'TRUE' .
      450     define variable v-value-character as character no-undo .
      451     define variable v-value-integer   as character no-undo .
      452     define variable v-value-date      as date      no-undo .
      453     define variable v-value-decimal   as decimal   no-undo .
      454     define variable rep-excel         as logical   no-undo .
      455     define variable excel-string      as character no-undo .
      456     define variable v-param-type      as character no-undo .
      457     define variable v-tth             as handle    no-undo .
      458     run adm/shattri.p (
      459       input "get":U
      460       ,input  ""
      461       ,input  0
      462       ,input  'report-glob':U
      463       ,input  'rep-excel':U
      464       ,output v-value-character
      465       ,output v-value-date
      466       ,output v-value-decimal
      467       ,output v-value-integer
      468       ,output rep-excel
      469       ,output v-param-type
      470       ,INPUT-OUTPUT table-handle v-tth
      471       )  .
      472     if rep-excel then v-excel = "TRUE" .
      473     else v-excel = "FALSE" .
      474     if p-param eq ""
      475     then
      476        p-param = "EXCEL:" + v-excel.
      477     else
      478        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      479     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      480   end procedure.
      481   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   define variable v-waitfram-action01         as character   no-undo .
      483   define variable v-waitfram-action02         as character   no-undo .
      484   define variable v-waitfram-action03         as character   no-undo .
      485   define variable mWaitFramTextBeg            as character   no-undo.
      486   define variable mWaitFramTextEnd            as character   no-undo.
      487   define variable mWaitFramView               as logical     no-undo.
      488   define variable mWaitProcEvent              as logical     no-undo init yes.
      489   define variable mWaitFramInterval           as integer     no-undo init 1 .
      490   define variable mWaitFramStop               as logical     no-undo.
      491   define variable mWaitFramStopUser           as logical     no-undo.
      492   define variable mWaitFramStopTimeOut        as logical     no-undo.
      493   define variable mWaitFramStartProc          as datetime-tz no-undo.
      494   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      495   define button B-WaitFramStop auto-end-key
      496        label "Стоп"
      497        size 10 by 1 tooltip "Остоновить процесс".
      498   define button B-viewProcInfo
      499        label "Информация"
      500        size 15 by 1 tooltip "Информация о процесс".
      501   define frame waitfram
      502     v-waitfram-action01 format "x(72)" no-label skip
      503     v-waitfram-action02 format "x(72)" no-label skip
      504     v-waitfram-action03 format "x(72)" no-label skip
      505     B-viewProcInfo
      506     B-WaitFramStop at row 4 col 30
      507     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      508     .
      509   define new global shared variable mBatchMode as logical no-undo init ?.
      510   define variable mFramBachModHandle as handle no-undo.
      511   mFramBachModHandle = frame waitfram:handle.
      512   define variable mFameOldVis as logical no-undo.
      513   define variable mVisCUrentVin as logical no-undo.
      514   if session:batch-mode
      515   then
      516      mBatchMode = yes.
      517   if mBatchMode = ? then do:
      518     mVisCUrentVin = current-window:visible.
      519     mFameOldVis = mFramBachModHandle:visible.
      520     mFramBachModHandle:visible  = yes.
      521     mBatchMode = mFramBachModHandle:visible ne yes.
      522     mFramBachModHandle:visible = mFameOldVis.
      523     current-window:visible = mVisCUrentVin.
      524   end.
      525    if  log-manager:logfile-name ne ?
      526     then DO:
      527         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      528         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      529         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      530     end.
      531   on choose of B-WaitFramStop in frame waitfram
      532   do:
      533     mWaitFramStop = yes.
      534     mWaitFramStopUser = yes.
      535   end.
      536   function waitfram-check-timeout returns logical():
      537      define variable vtime as int64 no-undo.
      538      if mWaitFramStopTimeOut
      539      then
      540         return yes.
      541      vtime = ( now - mWaitFramStartProc ) / 1000 .
      542      if     mWaitFramTimeOut ne ?
      543         and mWaitFramTimeOut ne 0
      544         and mWaitFramTimeOut lt vtime
      545      then do:
      546         mWaitFramStopTimeOut = yes.
      547      end.
      548      return mWaitFramStopTimeOut.
      549   end.
      550   procedure waitfram-hide :
      551     if not session:batch-mode
      552     then do
      553     on error undo, return error return-value
      554     :
      555       pause 0 before-hide .
      556       if not mBatchMode then
      557         hide frame waitfram .
      558     if     not mWaitFramView
      559        and mWaitProcEvent
      560     then
      561       process events .
      562     end.
      563   end procedure.
      564   procedure waitfram-show :
      565     define input  parameter p-message as character no-undo .
      566     define variable v-left-margin as integer   no-undo .
      567     if not session:batch-mode
      568     then do
      569     on error undo, return error return-value
      570     :
      571       if length(p-message) <= 70 then do:
      572         assign
      573           v-left-margin = integer((70 - length(p-message)) / 2)
      574         .
      575         assign
      576           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      577         .
      578         assign
      579           v-waitfram-action01 = " "
      580           v-waitfram-action02 = " "
      581                                    + fill(" ", v-left-margin)
      582                                    + p-message
      583           v-waitfram-action03 = " "
      584         .
      585       end.
      586       else do:
      587         define variable vRindex1 as integer no-undo.
      588         define variable vRindex2 as integer no-undo.
      589         vRindex1 = r-index(p-message," ",70).
      590         if vRindex1 = 0
      591         then
      592            vRindex1 = 70.
      593         if length(p-message)  <= vRindex1 + 70 then do:
      594           assign
      595             v-waitfram-action01 = " "
      596             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      597             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      598           .
      599         end.
      600         else do:
      601           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      602           if vRindex2 <= vRindex1
      603           then
      604              vRindex2 = vRindex1 + 70.
      605           assign
      606             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      607             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      608             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      609           .
      610         end.
      611       end.
      612       B-viewProcInfo:visible   in frame waitfram = no.
      613       B-viewProcInfo:sensitive in frame waitfram = no.
      614       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      615       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      616       if  (   mWaitFramView
      617          or  mWaitProcEvent)
      618          and not mBatchMode
      619       then
      620          display
      621             v-waitfram-action01 skip
      622             v-waitfram-action02 skip
      623             v-waitfram-action03 skip
      624          with frame waitfram .
      625       if     mWaitFramView
      626          then do:
      627             if     mWaitFramInterval ne ?
      628                and not mBatchMode
      629             then
      630                wait-for go of frame waitfram pause mWaitFramInterval.
      631          end.
      632          else
      633             if     mWaitProcEvent
      634                and not mBatchMode
      635             then
      636                process events .
      637     end.
      638   end procedure.
      639      procedure waitfram-show-this:
      640         define input  parameter iInterval as int64 no-undo.
      641         define variable vtime as int64 no-undo.
      642         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      643         mWaitFramInterval = iInterval.
      644         run waitfram-show (substitute("&1&2 &3&4" ,
      645                                       mWaitFramTextBeg ,
      646                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      647                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      648                                       mWaitFramTextEnd
      649                                      )
      650                           ).
      651      end.
      652      procedure WaitFramRunPause:
      653         define input  parameter iInterval as dec no-undo.
      654         define variable vStart  as datetime-tz no-undo.
      655         define variable vend    as datetime-tz no-undo.
      656         define variable vint as int64 no-undo.
      657         define variable vOk as logical no-undo.
      658         vStart = now.
      659         vend   = vStart.
      660         publish "WaitFramPause" (iInterval,output vOk).
      661         vend   =  now.
      662         vint = vend - vStart.
      663         vint = iInterval - vint / 1000.
      664         if     not mWaitFramStop
      665            and (   vint > 0
      666                 or (    not vOk
      667                     and iInterval eq ?
      668                     )
      669                 )
      670         then
      671            run waitfram-show-this (iInterval).
      672         vend   =  now.
      673         vint = vend - vStart.
      674         vint = iInterval - vint / 1000.
      675         if     not mWaitFramStop
      676            and vint > 0
      677         then do:
      678            run gbl/pause.p (vint * 1000).
      679         end.
      680         if iInterval ne ?
      681         then
      682            publish "WaitFramStop".
      683         waitfram-check-timeout().
      684      end.
      685      procedure WaitFramWaitFor:
      686         define input  parameter iInterval as dec no-undo.
      687         assign
      688            mWaitFramStartProc   = now
      689            mWaitFramStopUser    = no
      690            mWaitFramStopTimeOut = no
      691         .
      692         block-wait:
      693         do while not mWaitFramStop:
      694            run WaitFramRunPause (iInterval).
      695            if  waitfram-check-timeout()
      696            then do:
      697               leave block-wait.
      698            end.
      699         end.
      700         run waitfram-hide.
      701      end.
      702   procedure waitfram-join :
      703     define input  parameter p-line-1  as character no-undo .
      704     define input  parameter p-line-2  as character no-undo .
      705     define input  parameter p-line-3  as character no-undo .
      706     define output parameter p-message as character no-undo .
      707     do
      708     on error undo, return error return-value
      709     :
      710       assign
      711         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      712                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      713                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      714       .
      715     end.
      716   end procedure.
      717   function waitfram-join-function returns character
      718     (input p-line-1 as character
      719     ,input p-line-2 as character
      720     ,input p-line-3 as character
      721     ).
      722     define variable v-message as character no-undo .
      723     run waitfram-join in this-procedure
      724       (input  p-line-1
      725       ,input  p-line-2
      726       ,input  p-line-3
      727       ,output v-message
      728       ) .
      729     return v-message .
      730   end function .
      731   DEFINE VARIABLE Line                as character                    no-undo .
      732   define variable v-ov-base           as decimal no-undo .
      733   define variable v-ov-rubl           as decimal no-undo .
      734   define variable v-num as integer no-undo .
      735   define variable v-str as character no-undo extent 7.
      736   define variable ii as integer no-undo .
      737   define variable v-curr-r-b as character no-undo .
      738   define variable v-r-b-abbr as character no-undo .
      739   define variable g#report-num  as integer no-undo .
      740   define variable g#quest-print as logical no-undo .
      741   define variable g#log as logical no-undo .
      742   define buffer buf_inkas for ub.inkas .
      743   define buffer buf_shop for ub.shop.
      744   define buffer buf_clients for ub.clients.
      745   do
      746   on error undo, return error
      747   :
      748   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      749   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      750     (output v-curr-r-b
      751     )  .
      752     find first buf_inkas no-lock where
      753                 buf_inkas.inkas-code = p-inkas-code no-error .
      754     if NOT available buf_inkas then do:
      755       message
      756       vss-workfile vss-revision vss-description skip
      757       "Неправильный выбор кассового отчета."
      758       view-as alert-box WARNING .
      759       return error .
      760     end.
      761   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
      763     (input  buf_inkas.host-code
      764     ,output v-r-b-abbr
      765     )  .
      766     find first buf_shop no-lock where
      767               buf_shop.obj-code = buf_inkas.obj-code no-error .
      768     if not available buf_shop then do:
      769       message
      770       vss-workfile vss-revision vss-description skip
      771       "Не найден объект для кассового отчета." p-inkas-code
      772       view-as alert-box WARNING .
      773       return error .
      774     end.
      775     find first buf_clients no-lock where
      776               buf_clients.obj-type = 'маг':U
      777           AND buf_clients.obj-code = buf_shop.obj-code no-error .
      778     run calculate-discnt in this-procedure (
      779                                              input v-curr-r-b
      780                                            , input buf_inkas.inkas-code
      781                                            , output v-ov-base
      782                                            , output v-ov-rubl) no-error .
      783     if error-status:error then do:
      784       message
      785       vss-workfile vss-revision vss-description skip
      786       "Ошибка при подсчете скидок по переоценкн для кассового отчета." p-inkas-code skip
      787       error-status:get-message(1) skip
      788       return-value
      789       view-as alert-box WARNING .
      790       undo, return error .
      791     end.
      792     run prn-lib-open-stream  in this-procedure (
      793                                                 input parParentProc
      794                                                 ,input 62
      795                                                 ,input yes
      796                                                 ,input no
      797                                                 ).
      798     assign
      799     v-str[1] = "Приложение к реализации, прошедшей"
      800     v-str[2] = substitute("через кассу  №&1 за &2"
      801                           , buf_inkas.inkas-code
      802                           , string(buf_inkas.doc-date, "99/99/9999")
      803                           )
      804     v-str[3] = "":U
      805     v-str[4] = "":U
      806     v-str[5] = '"У Т В Е Р Ж Д А Ю"'
      807     v-str[6] = "":U
      808     v-str[7] = substitute("Директор маг. &1 &2"
      809                           , (if available buf_clients
      810                              then buf_clients.obj-name
      811                              else ("№ " + string(Buf_shop.obj-code))
      812                              )
      813                           ,  buf_shop.director).
      814     .
      815     do ii = 1 to 7:
      816       assign
      817       v-num = length(v-str[ii])
      818       .
      819       PUT  STREAM PrnLibStream unformatted
      820       fill( chr(32) , 136 - v-num)
      821       v-str[ii]
      822       skip.
      823     end .
      824     PUT  STREAM PrnLibStream unformatted skip(2).
      825     assign
      826     v-str[1] = "А К Т"
      827     v-str[2] = "":U
      828     v-str[3] = "":U
      829     v-str[4] = substitute("Скидки по дисконту      &1 &2"
      830                           , string(round(buf_inkas.discnt, 2)
      831                           , "->>>,>>>,>>>,>>9.99")
      832                           , v-r-b-abbr
      833                           )
      834     v-str[5] = substitute("Скидки по переоценкам   &1 &2"
      835                           , string(
      836                                     round(if v-curr-r-b = 'base':U
      837                                     then (v-ov-base - buf_inkas.discnt)
      838                                     else (v-ov-rubl - buf_inkas.discnt), 2)
      839                                    , "->>>,>>>,>>>,>>9.99")
      840                           , v-r-b-abbr
      841                              )
      842     v-str[6] = "":U
      843     v-str[7] = substitute("ИТОГО скидки:           &1 &2"
      844                           ,  string(
      845                                     round(if v-curr-r-b = 'base':U
      846                                     then v-ov-base
      847                                     else v-ov-rubl, 2)
      848                                     , "->>>,>>>,>>>,>>9.99")
      849                           , v-r-b-abbr
      850                           )
      851     .
      852     do ii = 1 to 7:
      853       assign
      854       v-num = length(v-str[ii])
      855       .
      856       PUT  STREAM PrnLibStream unformatted
      857       fill(chr(32) , integer(truncate((136 - v-num) / 2, 0)))
      858       v-str[ii]
      859       fill(chr(32) , integer(truncate((136 - v-num) / 2, 0)))
      860       skip
      861       .
      862     end.
      863     PUT  STREAM PrnLibStream unformatted skip(2)
      864     .
      865     assign
      866     v-str[1] = substitute("Директор магазина                                        &1"
      867                           , buf_shop.director)
      868     .
      869     do ii = 1 to 1:
      870       PUT  STREAM PrnLibStream unformatted
      871       v-str[ii]
      872       skip
      873       .
      874     end.
      875     PUT  STREAM PrnLibStream unformatted
      876     skip(2)
      877     fill("_":U, 136) skip.
      878     output  STREAM PrnLibStream CLOSE.
      879     run get-report-num  in parParentProc(output g#report-num).
      880     run get-quest-print in parParentProc(output g#quest-print).
      881   if g#quest-print = false
      882   then do:
      883     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      884                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      885                                         OUTPUT g#log ).
      886   end.
      887   else do:
      888     os-command silent
      889       value( "COPY /b " +
      890         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      891         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      892         string( session:temp-directory) +  "$" + string( g#report-num )
      893                 ) .
      894     os-command silent
      895       value( "COPY /b " +
      896         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      897         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      898         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      899                 ) .
      900   end.
      901   end.
      902   procedure calculate-discnt :
      903   define input parameter p-curr-r-b as character no-undo .
      904   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      905   define output parameter p-ov-base as decimal no-undo .
      906   define output parameter p-ov-rubl as decimal no-undo .
      907   define variable v-b-code like ub.bar-code.b-code no-undo .
      908   define variable v-gds-code like ub.goods.gds-code no-undo .
      909   define variable v-doc-num         like ub.price-doc.doc-num     no-undo.
      910   define variable v-price-sale      like ub.price-list.price-sale no-undo.
      911   define variable v-price-base      like ub.price-list.price-sale no-undo.
      912   define variable v-price-rubl      like ub.price-list.price-sale no-undo.
      913   define variable v-road-tax        like ub.price-list.road-tax   no-undo.
      914   define variable v-excise          like ub.price-list.excise     no-undo.
      915   define buffer buf_trn for ub.trn-doc.
      916   define buffer buf_ret for ub.trn-doc.
      917   define buffer buf_doc-line for ub.doc-line.
      918   define buffer buf_gds-dtl for ub.gds-dtl.
      919     do
      920     on error undo, return error
      921     :
      922       find first buf_trn no-lock where
      923                 buf_trn.doc-code = p-inkas-code no-error .
      924       if not available buf_trn then do:
      925         undo, return error substitute("Не найдена расходная часть для кассового отчета &1", p-inkas-code).
      926       end.
      927       find first buf_ret no-lock where
      928               buf_ret.doc-code = buf_trn.out-code no-error .
      929       run waitfram-show in this-procedure ("Ждите..." ).
      930       for each buf_doc-line no-lock where
      931                buf_doc-line.doc-code = buf_trn.doc-code:
      932   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      934     (input  buf_doc-line.artic
      935     ,input  buf_doc-line.prod-type
      936     ,input  buf_doc-line.prod-code
      937     ,output v-gds-code
      938     )  .
      939         for each buf_gds-dtl no-lock where
      940                 buf_gds-dtl.doc-code = buf_trn.doc-code
      941            AND buf_gds-dtl.artic = buf_doc-line.artic
      942            AND buf_gds-dtl.prod-type = buf_doc-line.prod-type
      943            AND buf_gds-dtl.prod-code = buf_doc-line.prod-code   :
      944           assign
      945           p-ov-base = p-ov-base + buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-base
      946           p-ov-rubl = p-ov-rubl + buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-rubl
      947           .
      948         end.
      949       end.
      950       if available buf_ret then do:
      951         for each buf_doc-line no-lock where
      952                 buf_doc-line.doc-code = buf_ret.doc-code:
      953   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      955     (input  buf_doc-line.artic
      956     ,input  buf_doc-line.prod-type
      957     ,input  buf_doc-line.prod-code
      958     ,output v-gds-code
      959     )  .
      960           for each buf_gds-dtl no-lock where
      961                   buf_gds-dtl.doc-code = buf_ret.doc-code
      962             AND buf_gds-dtl.artic = buf_doc-line.artic
      963             AND buf_gds-dtl.prod-type = buf_doc-line.prod-type
      964             AND buf_gds-dtl.prod-code = buf_doc-line.prod-code   :
      965             assign
      966             p-ov-base = p-ov-base + buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-base
      967             p-ov-rubl = p-ov-rubl + buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-rubl
      968             .
      969           end.
      970         end.
      971       end.
      972       run waitfram-hide in this-procedure .
      973     end.
      974   end procedure.
