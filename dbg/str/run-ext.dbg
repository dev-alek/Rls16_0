        1   block-level on error undo, throw.
        2   define temp-table temp_recid-list no-undo
        3       field string-recid as character
        4       index pi is primary unique string-recid
        5   .
        6   define input parameter p-recid          as recid            no-undo.
        7   define input parameter table for temp_recid-list.
        8   define input parameter p-place          as character        no-undo.
        9   define input parameter p-init           as character        no-undo.
       10   define output parameter p-button-label  as character        no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision: 3ac8d1d44d52, 3383, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       13   define variable vss-date        as character no-undo init "$Date: 2023/05/31 09:28:12 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: run-ext.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: str/run-ext.p $":U .
       16   define variable vss-description as character no-undo init "Запуск внешней программы пользователя.".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35       assign
       36         p-vss-parameters = substitute('&1|&2|&3|&4|&5':u,p-recid,p-place,p-init)
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   do
       81   on error undo, return error
       82   :
       83   define buffer buf_trn-doc       for ub.trn-doc.
       84   define variable v-sys-key   as character         no-undo.
       85   define variable v-par-type  as character         no-undo.
       86   define variable l-was-error as logical  init yes.
       87   define temp-table temp_ext-list no-undo
       88           field place         as character
       89           field button-name   as character
       90           field proc-name     as character
       91           field sys-key       as character
       92           field sys-key-black as character
       93   index pi is primary unique place
       94   .
       95   def var vss-include-info0 as character format "x(65)" no-undo
       96   initial "@(#)$Workfile$ $Revision$".
       97   create temp_ext-list.
       98   assign
       99       temp_ext-list.place          = 'документы':U
      100       temp_ext-list.button-name    = 'Ана&лиз'
      101       temp_ext-list.proc-name      = 'run-zapr.p'
      102       temp_ext-list.sys-key        = 'BDC'
      103       temp_ext-list.sys-key-black  = ''
      104   .
      105   create temp_ext-list.
      106   assign
      107       temp_ext-list.place          = 'ТОВАР':U
      108       temp_ext-list.button-name    = 'Печ &Ценн'
      109       temp_ext-list.proc-name      = 'run-zenn.p'
      110       temp_ext-list.sys-key        = 'BDC'
      111       temp_ext-list.sys-key-black  = ''
      112   .
      113   create temp_ext-list.
      114   assign
      115       temp_ext-list.place          = 'печать':U
      116       temp_ext-list.button-name    = '&Экспорт'
      117       temp_ext-list.proc-name      = 'run-doc.p'
      118       temp_ext-list.sys-key        = 'BDC'
      119       temp_ext-list.sys-key-black  = ''
      120   .
      121   create temp_ext-list.
      122   assign
      123       temp_ext-list.place          = 'доп-БК':U
      124       temp_ext-list.button-name    = '&Экспорт'
      125       temp_ext-list.proc-name      = 'run-bcod.p'
      126       temp_ext-list.sys-key        = 'BDC'
      127       temp_ext-list.sys-key-black  = ''
      128   .
      129   find first temp_ext-list
      130        where temp_ext-list.place = p-place
      131   no-error.
      132   if not available temp_ext-list
      133   then do:
      134       return error .
      135   end.
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      137   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      138     (output v-sys-key
      139     ) no-error .
      140   if ( ( lookup( v-sys-key, temp_ext-list.sys-key ) <> 0 or v-sys-key = '' )
      141   and lookup( v-sys-key, temp_ext-list.sys-key-black ) = 0 )
      142   or caps( v-sys-key ) = 'ExpertekIBS':U
      143   then do:
      144       if p-init = "init"
      145       then do:
      146           assign
      147               p-button-label          = temp_ext-list.button-name
      148               l-was-error = false
      149           .
      150       end.
      151       else do
      152       on error undo, leave
      153       on stop undo, leave
      154       :
      155           if search( entry( 1, temp_ext-list.proc-name, "." ) + ".r" ) = ?
      156              and search( entry( 1, temp_ext-list.proc-name, "." ) + ".p" ) = ?
      157           then do:
      158               message
      159                      "Не найдена внешняя программа " temp_ext-list.proc-name
      160               view-as alert-box error.
      161           end.
      162           else do:
      163               run value (temp_ext-list.proc-name)  (input p-recid, input table temp_recid-list  ).
      164               assign
      165                   l-was-error = false
      166               .
      167           end.
      168       end.
      169       if l-was-error = true
      170       then do:
      171           message
      172               "При выполнении заказной программы" temp_ext-list.proc-name "возникла ошибка"
      173               skip "Обратитесь к администратору системы"
      174           view-as alert-box error .
      175           return error .
      176       end.
      177   end.
      178   else do:
      179       undo, return error .
      180   end.
      181   end.
