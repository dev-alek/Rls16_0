     4557           p-template-list-group = string(46) + chr(44) +
     4558                             string(47) + chr(44) +
     4559                             string(48) + chr(44) +
     4560                             string(49).
     4561         end.
     4562         otherwise do:
     4563           if p-what-send <> 'ALL' then
     4564           run write-log-and-file in p-log-handle (
     4565                   input 1
     4566                 , input log-file-name
     4567                 , input 1
     4568                 , input substitute("Для маг&1 тип кассы по умолчанию &2 - правила скидок на группы товара не отправляются"
     4569                                   , i-obj-code
     4570                                   , dflt-cd
     4571                                   )
     4572                                                 ).
     4573           return.
     4574         end.
     4575       END CASE.
     4576       run create-dis-rule-by-template in this-procedure ( input 'group':U
     4577                                                          ,input p-template-list-group
     4578                                                          ,input "на группу товара" ) .
     4579     end.
     4580   end procedure.
     4581   procedure prepare-payment-discnt :
     4582   define output parameter p-template-list-payment as character no-undo .
     4583     do
     4584     on error undo, return error
     4585     :
     4586       CASE dflt-cd:
     4587         when 'MARIA':U then do:
     4588           assign
     4589           p-template-list-payment = string(42) + chr(44) +
     4590                             string(43) + chr(44) +
     4591                             string(44) + chr(44) +
     4592                             string(45).
     4593         end.
     4594         otherwise do:
     4595           if p-what-send <> 'ALL' then
     4596           run write-log-and-file in p-log-handle (
     4597                   input 1
     4598                 , input log-file-name
     4599                 , input 1
     4600                 , input substitute("Для маг&1 тип кассы по умолчанию &2 - правила скидок на платеж не отправляются"
     4601                                   , i-obj-code
     4602                                   , dflt-cd
     4603                                   )
     4604                                                 ).
     4605           return.
     4606         end.
     4607       END CASE.
     4608       run create-dis-rule-by-template in this-procedure ( input 'payment':U
     4609                                                          ,input p-template-list-payment
     4610                                                          ,input "на платеж") .
     4611     end.
     4612   end procedure.
     4613   procedure prepare-client-discnt :
     4614   define output parameter p-template-list-client as character no-undo .
     4615     do
     4616     on error undo, return error
     4617     :
     4618       CASE dflt-cd:
     4619         when 'MARIA':U then do:
     4620           assign
     4621           p-template-list-client = string(11) + chr(44) +
     4622                             string(12) + chr(44) +
     4623                             string(40) + chr(44) +
     4624                             string(41)
     4625                             .
     4626         end.
     4627         otherwise do:
     4628           if p-what-send <> 'ALL' then
     4629           run write-log-and-file in p-log-handle (
     4630                   input 1
     4631                 , input log-file-name
     4632                 , input 1
     4633                 , input substitute("Для маг&1 тип кассы по умолчанию &2 - правила скидок для пост. клиентов не отправляются"
     4634                                   , i-obj-code
     4635                                   , dflt-cd
     4636                                   )
     4637                                                 ).
     4638         end.
     4639       END CASE.
     4640       run create-dis-rule-by-template in this-procedure ( input 'client'
     4641                                                         , input p-template-list-client
     4642                                                         , input "для пост. клиентов" ) .
     4643     end.
     4644   end procedure.
     4645   procedure create-dis-rule-by-template :
     4646   define input parameter p-what-create as character no-undo .
     4647   define input parameter p-template-list as character no-undo .
     4648   define input parameter p-discnt-des as character no-undo .
     4649   define variable v-ii as integer no-undo .
     4650   define variable ll as integer no-undo .
     4651   define variable vc-obj-type like ub.clients.obj-type no-undo .
     4652   define variable vc-obj-code like ub.clients.obj-code no-undo .
     4653   define variable vc-host-code like ub.sysconf.host-code no-undo .
     4654   define variable vc-region as character no-undo .
     4655   define variable v-des     as character no-undo .
     4656   define variable  v-level-1           as character no-undo .
     4657   define variable  v-level-2           as character no-undo .
     4658   define variable  v-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     4659   define variable  v-subject-type      like ub.dis-rule.subject-type      no-undo .
     4660   define variable  v-value-type        like ub.dis-rule.value-type        no-undo .
     4661   define variable  v-global            as integer no-undo .
     4662   define variable  v-host              as integer no-undo .
     4663   define variable  v-object            as integer no-undo .
     4664   define variable  v-output-display    as logical   no-undo .
     4665   define variable  v-tree              as character no-undo .
     4666   define variable  v-other             as character no-undo .
     4667   define variable  v-not-found         as integer no-undo .
     4668   define buffer buf_dis-rule for ub.dis-rule.
     4669   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     4670   define buffer buf_cash-dis-rule for cash-dis-rule.
     4671     do
     4672     on error undo, return error return-value
     4673     :
     4674       if p-template-list = '':U then return.
     4675       _v-ii:
     4676       do v-ii = 1 to num-entries(p-template-list):
     4677         run dr-code  in this-procedure (
     4678                                             input  integer(entry(v-ii, p-template-list))
     4679                                             ,output v-des
     4680                                             ,output v-discnt-type
     4681                                             ,output v-subject-type
     4682                                             ,output v-value-type
     4683                                             ,output v-level-1
     4684                                             ,output v-level-2
     4685                                             ,output v-global
     4686                                             ,output v-host
     4687                                             ,output v-object
     4688                                             ,output v-output-display
     4689                                             ,output v-tree
     4690                                             ,output v-other).
     4691         _ll:
     4692         do ll = 1 to 3:
     4693           CASE ll:
     4694             when 1 then do:
     4695               if v-object = 0 then next _ll.
     4696               assign
     4697               vc-obj-code = i-obj-code
     4698               vc-obj-type = 'маг':U
     4699               vc-host-code = v-host-code
     4700               vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
     4701               .
     4702             end.
     4703             when 2 then do:
     4704               if v-host = 0 then next _ll.
     4705               assign
     4706               vc-obj-code = 0
     4707               vc-obj-type = '':U
     4708               vc-host-code = v-host-code
     4709               vc-region    = substitute("Фирма &1&2", vc-host-code)
     4710               .
     4711             end.
     4712             when 3 then do:
     4713               if v-global = 0 then next _ll.
     4714               assign
     4715               vc-obj-code = 0
     4716               vc-obj-type = '':U
     4717               vc-host-code = 0
     4718               vc-region    = "Глобально"
     4719               .
     4720             end.
     4721           END CASE.
     4722           if p-what-create = 'pcnt-tot-kateg':U
     4723           then do:
     4724             _buf_dis-rule:
     4725             for each buf_dis-rule no-lock where
     4726                           buf_dis-rule.upper-rule-num = integer(entry(v-ii, p-template-list))
     4727                       and buf_dis-rule.host-code = vc-host-code
     4728                       AND buf_dis-rule.obj-type = vc-obj-type
     4729                       AND buf_dis-rule.obj-code = vc-obj-code
     4730                       AND buf_dis-rule.sts = integer('0':U),
     4731             first buf_dis-thbj-rule no-lock where
     4732                   buf_dis-thbj-rule.host-code = vc-host-code
     4733               and buf_dis-thbj-rule.obj-type = vc-obj-type
     4734               and buf_dis-thbj-rule.obj-code = vc-obj-code
     4735               and buf_dis-thbj-rule.pos-type = dflt-cd
     4736               and buf_dis-thbj-rule.discnt-role = 'pcnt-tot-kateg':U
     4737               and buf_dis-thbj-rule.rule-num = buf_dis-rule.rule-num
     4738             :
     4739               find first buf_cash-dis-rule no-lock where ll > 1
     4740                 and buf_cash-dis-rule.dis-kat            = buf_dis-rule.dis-kat
     4741                 and buf_cash-dis-rule.templ-rl-root      = buf_dis-rule.templ-rl-root
     4742                 and buf_cash-dis-rule.time-templ-rl-root = buf_dis-rule.time-templ-rl-root no-error .
     4743               if avail buf_cash-dis-rule then next _buf_dis-rule .
     4744               run create-dis-rule in this-procedure ( buf_dis-rule.rule-num, yes) no-error .
     4745               if p-what-create = 'pcnt-tot-kateg':U then do:
     4746                 if lookup("dis-kat", v-level-1) = 0 then do:
     4747                   if v-upper-rule-num-tot-discnt = 0 then
     4748                   assign
     4749                   v-upper-rule-num-tot-discnt = buf_dis-rule.rule-num
     4750                   .
     4751                 end.
     4752                 else do:
     4753                   if v-upper-rule-num-tot-discnt-kat = 0 then
     4754                   assign
     4755                   v-upper-rule-num-tot-discnt-kat = (if buf_Dis-rule.is-term = yes
     4756                                                      then buf_dis-rule.upper-rule-num
     4757                                                      else buf_dis-rule.rule-num)
     4758                   .
     4759                 end.
     4760               end.
     4761             end.
     4762             if action = "U" then do:
     4763               if (ll = 1 and v-host = 0 and v-global = 0)
     4764               or (ll = 2 and v-object = 0 and v-global = 0)
     4765               or (ll = 3 and v-object = 0 and v-host = 0) then do:
     4766                 assign
     4767                 v-not-found = v-not-found + 1.
     4768               end.
     4769             end.
     4770           end.
     4771           else do:
     4772             for each buf_dis-rule no-lock where
     4773                     buf_dis-rule.templ-rl-root = integer(entry(v-ii, p-template-list))
     4774               and  buf_dis-rule.host-code = vc-host-code
     4775               and  buf_dis-rule.obj-type = vc-obj-type
     4776               and  buf_dis-rule.obj-code = vc-obj-code:
     4777               if action = 'U':U and buf_dis-rule.sts <> integer('0':U) then next.
     4778               run create-dis-rule in this-procedure ( buf_dis-rule.rule-num, yes) no-error .
     4779               if p-what-create = 'tot-discnt' then do:
     4780                 if lookup("dis-kat", v-level-1) = 0 then do:
     4781                   if v-upper-rule-num-tot-discnt = 0 then
     4782                   assign
     4783                   v-upper-rule-num-tot-discnt = buf_dis-rule.rule-num
     4784                   .
     4785                 end.
     4786                 else do:
     4787                   if v-upper-rule-num-tot-discnt-kat = 0 then
     4788                   assign
     4789                   v-upper-rule-num-tot-discnt-kat = buf_dis-rule.upper-rule-num
     4790                   .
     4791                 end.
     4792               end.
     4793             end.
     4794             if not can-find(first cash-dis-rule where cash-dis-rule.upper-rule-num = integer(entry(v-ii, p-template-list)) ) then do:
     4795               if (ll = 1 and v-host = 0 and v-global = 0)
     4796               or (ll = 2 and v-object = 0 and v-global = 0)
     4797               or (ll = 3 and v-object = 0 and v-host = 0) then do:
     4798                 assign
     4799                 v-not-found = v-not-found + 1.
     4800               end.
     4801             end.
     4802             else do:
     4803               LEAVE _ll.
     4804             end.
     4805           end.
     4806         end.
     4807       end.
     4808       if v-not-found = num-entries(p-template-list) then do:
     4809               run write-log-and-file in p-log-handle (
     4810                       input 1
     4811                     , input log-file-name
     4812                     , input 1
     4813                     , input substitute("Для маг&1 не определены скидки &2"
     4814                                       , i-obj-code
     4815                                       , p-discnt-des
     4816                                       )
     4817                                                     ).
     4818       end.
     4819     end.
     4820   end procedure.
     4821   procedure putc-dr-maria :
     4822   define parameter buffer buf_cash-desk for ub.cash-desk.
     4823   define input parameter p-template-list as character no-undo .
     4824   define variable v-ii  as  integer     no-undo.
     4825   define variable v-maria-rule-num as integer no-undo .
     4826   define variable v-dop as character no-undo .
     4827   define variable v-string as character no-undo .
     4828   define variable v-maria-rule-type as integer no-undo .
     4829   define variable v-bush as integer no-undo .
     4830   define buffer down_cash-dis-rule for cash-dis-rule.
     4831     do
     4832     on error undo, return error:
     4833       do v-ii = 1 to num-entries(p-template-list):
     4834         for each cash-dis-rule where
     4835                 cash-dis-rule.templ-rl-root = integer(entry( v-ii, p-template-list))
     4836           and  cash-dis-rule.upper-rule-num = integer(entry( v-ii, p-template-list)):
     4837           v-bush = 0.
     4838           if index(dr-list, string(cash-dis-rule.rule-num) + '-') = 0 then do:
     4839             next.
     4840           end.
     4841           assign
     4842           v-dop = substring(dr-list, index(dr-list, string(cash-dis-rule.rule-num) + '-':U))
     4843           v-dop = substring(v-dop, 1, index(v-dop, chr(44)) - 1)
     4844           v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
     4845           .
     4846           if action = 'D':U  then do:
     4847             assign
     4848             v-string  = fill( chr(32) , 12) + chr(4) +
     4849                         '0' + chr(4) +
     4850                         '000' + chr(4) +
     4851                         '00000' + chr(4) +
     4852                         fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5) +
     4853                         fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5)
     4854            .
     4855           end.
     4856           else do:
     4857             if cash-dis-rule.value-type = integer('1':U) then do:
     4858               if index(cash-dis-rule.uniq-field, 'tot-sum') = 0
     4859               and index(cash-dis-rule.uniq-field, 'doc-qnty') = 0 then do:
     4860                 assign
     4861                 v-maria-rule-type = 0.
     4862               end.
     4863               if index(cash-dis-rule.uniq-field, 'tot-sum') > 0
     4864               then do:
     4865                 assign
     4866                 v-maria-rule-type = 1.
     4867               end.
     4868               if index(cash-dis-rule.uniq-field, 'doc-qnty') > 0
     4869               then do:
     4870                 assign
     4871                 v-maria-rule-type = 2.
     4872               end.
     4873             end.
     4874             if cash-dis-rule.value-type = integer('2':U) then do:
     4875               assign
     4876               v-maria-rule-type = 3.
     4877             end.
     4878             assign
     4879             v-string =  string(cash-dis-rule.des, "X(12)") + chr(4) +
     4880                         string(v-maria-rule-type, '999') + chr(4) +
     4881                         (if v-maria-rule-type = 3
     4882                         then string( cash-dis-rule.discnt-value * 100, '999')
     4883                         else '000') + chr(4) +
     4884                         (if v-maria-rule-type = 0
     4885                         then string( cash-dis-rule.discnt-value * 100, '99999')
     4886                         else '00000') + chr(4).
     4887             if v-maria-rule-type = 0
     4888             or v-maria-rule-type = 3 then do:
     4889               assign
     4890               v-string = v-string +
     4891                           fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5) +
     4892                           fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5)
     4893               .
     4894             end.
     4895             else do:
     4896               if v-maria-rule-type = 2 then do:
     4897                 v-string = v-string + fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5).
     4898               end.
     4899               for each down_cash-dis-rule where
     4900                     down_cash-dis-rule.upper-rule-num = cash-dis-rule.rule-num:
     4901                 assign
     4902                 v-bush = v-bush + 1.
     4903                 if v-maria-rule-type = 1 then do:
     4904                   assign
     4905                   v-string = v-string + string(down_cash-dis-rule.tot-sum * 100, '999999999') + chr(4) +
     4906                                         string(down_cash-dis-rule.discnt-value * 100, '99999') + chr(4).
     4907                 end.
     4908                 if v-maria-rule-type = 2 then do:
     4909                   assign
     4910                   v-string = v-string + string(down_cash-dis-rule.doc-qnty * 100, '999999999') + chr(4) +
     4911                                         string(down_cash-dis-rule.discnt-value * 100, '99999') + chr(4).
     4912                 end.
     4913               end.
     4914               if v-bush  < 5 then do:
     4915                  v-string = v-string + fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5 - v-bush).
     4916               end.
     4917               if v-maria-rule-type = 1 then do:
     4918                 v-string = v-string + fill(fill('0', 9) + chr(4) + fill('0', 5) + chr(4) , 5).
     4919               end.
     4920             end.
     4921           end.
     4922           assign
     4923           v-string = right-trim(v-string, chr(4)).
     4924           run maria-put in this-procedure (
     4925                                           buffer buf_cash-desk
     4926                                         , input out
     4927                                         , input fname
     4928                                         , input yes
     4929                                         , input 0
     4930                                         , input no
     4931                                         , input 25
     4932                                         , input 20
     4933                                         , input v-maria-rule-num + 1
     4934                                         , input v-string ).
     4935         end.
     4936       end.
     4937     end.
     4938   end procedure.
