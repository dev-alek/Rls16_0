     2381   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2382   PROCEDURE putc-9.
     2383   define parameter buffer buf_cash-desk for ub.cash-desk.
     2384   define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     2385   define input parameter p-pos-type as char no-undo.
     2386   define variable ii  as  integer     no-undo.
     2387   define variable v-version as decimal no-undo .
     2388   define variable v-maria-discnt-value as character no-undo .
     2389   define variable v-maria-rule-num as integer no-undo .
     2390   define variable v-dop as character no-undo .
     2391   define variable v-date-from as date no-undo .
     2392   define variable v-date-to as date no-undo .
     2393   define variable v-time-rule-num as integer no-undo .
     2394   define buffer buf_dis-rule for ub.dis-rule.
     2395   define buffer buf_cash-dis-rule for cash-dis-rule.
     2396   CASE p-pos-type:
     2397     when 'IBM':U
     2398     then do:
     2399       if v-upper-rule-num-tot-discnt > 0 then do:
     2400         find first cash-dis-rule no-lock where
     2401              cash-dis-rule.upper-rule-num = v-upper-rule-num-tot-discnt no-error.
     2402         if cash-dis-rule.templ-rl-root = 20 then do:
     2403           PUT stream IBMstream unformatted
     2404           '9 "'
     2405           string( "D", "x(1)" )
     2406           '" '.
     2407           PUT stream IBMstream unformatted
     2408           chr(10).
     2409         PUT stream IBMstream unformatted
     2410         '9 "'
     2411         string( action, "x(1)" )
     2412         '" '.
     2413         if action = 'U':U then do:
     2414           for each cash-dis-rule no-lock where
     2415                   cash-dis-rule.upper-rule-num = v-upper-rule-num-tot-discnt
     2416                     :
     2417               PUT stream IBMstream unformatted
     2418               cash-dis-rule.tot-sum chr(32) (- cash-dis-rule.discnt-value) chr(32)
     2419               .
     2420           end.
     2421         end.
     2422         PUT stream IBMstream unformatted
     2423         chr(10).
     2424       end.
     2425       end.
     2426       if p-pos-type = 'IBM':U
     2427       and v-upper-rule-num-tot-discnt-kat > 0 then do:
     2428         find first cash-dis-rule no-lock where
     2429              cash-dis-rule.upper-rule-num = v-upper-rule-num-tot-discnt-kat  no-error.
     2430         assign
     2431         v-version = 0
     2432         v-version = decimal(buf_cash-desk.version)
     2433         no-error.
     2434         if v-version < 4.53 then do:
     2435           run write-log-and-file in p-log-handle (
     2436                 input 1
     2437               , input log-file-name
     2438               , input 1
     2439               , input substitute( "Невозможно передать на кассу &1 &2&3&4" +
     2440                                   "Данный функционал доступен только для POS &5 с версии ПО кассы 4.53"
     2441                                 ,  buf_cash-desk.cash-num
     2442                                 , 'маг':U
     2443                                 , buf_cash-desk.obj-code
     2444                                 , chr(10)
     2445                                 , 'IBM':U
     2446                                 )
     2447                                                 ).
     2448         end.
     2449         if v-version >= 4.53
     2450         and cash-dis-rule.templ-rl-root = 53 then do:
     2451           PUT stream IBMstream unformatted
     2452           '24 "'
     2453           string( "D", "x(1)" )
     2454           '" '.
     2455           PUT stream IBMstream unformatted
     2456           chr(10).
     2457         PUT stream IBMstream unformatted
     2458         '24 "'
     2459         string( action, "x(1)" )
     2460         '" '.
     2461         if action = 'U':U then do:
     2462           for each cash-dis-rule no-lock where
     2463                   cash-dis-rule.upper-rule-num = v-upper-rule-num-tot-discnt-kat
     2464                     :
     2465               PUT stream IBMstream unformatted
     2466               cash-dis-rule.tot-sum chr(32) (- cash-dis-rule.discnt-value) chr(32)
     2467               (if cash-dis-rule.dis-kat >= 0
     2468               then (string(cash-dis-rule.dis-kat) + chr(32))
     2469               else '':U)
     2470               .
     2471           end.
     2472         end.
     2473         PUT stream IBMstream unformatted
     2474         chr(10).
     2475       end.
     2476     end.
     2477     end.
     2478     when 'IBM-XML':U then do:
     2479       if (v-upper-rule-num-tot-discnt > 0
     2480           or
     2481           v-upper-rule-num-tot-discnt-kat > 0)
     2482       and action = 'U':U
     2483       then do:
     2484         run bgelib-tag-open in this-procedure ( input 2, input "TotalDisc"
     2485                                               , input substitute("code='*' ctrl='&1' tms='&2' "
     2486                                                               , "DEL":U
     2487                                                               , integer(OS2-time) - 1)).
     2488         run bgelib-tag-close in this-procedure ( input 2, input "TotalDisc").
     2489         _ii:
     2490         do ii = 1 to 2:
     2491           if ii = 1 and v-upper-rule-num-tot-discnt = 0 then next _ii.
     2492           if ii = 2 and v-upper-rule-num-tot-discnt-kat = 0 then next _ii.
     2493           for each buf_cash-dis-rule no-lock where
     2494                   (ii = 1
     2495                    and v-upper-rule-num-tot-discnt <= 99999
     2496                    and buf_cash-dis-rule.upper-rule-num = v-upper-rule-num-tot-discnt
     2497                   )
     2498                   or
     2499                   (ii = 1
     2500                    and v-upper-rule-num-tot-discnt > 99999
     2501                    and buf_cash-dis-rule.rule-num = v-upper-rule-num-tot-discnt
     2502                   )
     2503                   or
     2504                   (ii = 2
     2505                    and v-upper-rule-num-tot-discnt-kat <= 99999
     2506                    and buf_cash-dis-rule.upper-rule-num = v-upper-rule-num-tot-discnt-kat)
     2507                    or
     2508                   (ii = 2
     2509                    and v-upper-rule-num-tot-discnt-kat > 99999
     2510                    and buf_cash-dis-rule.rule-num = v-upper-rule-num-tot-discnt-kat
     2511                   )
     2512                   ,
     2513             each cash-dis-rule no-lock where
     2514                 (buf_cash-dis-rule.is-term and cash-dis-rule.rule-num = buf_cash-dis-rule.rule-num)
     2515                  or
     2516                  (not buf_cash-dis-rule.is-term and cash-dis-rule.upper-rule-num = buf_cash-dis-rule.rule-num):
     2517             if buf_cash-dis-rule.time-rule-num > 0 then do:
     2518               v-time-rule-num = buf_cash-dis-rule.time-rule-num.
     2519             end.
     2520             if cash-dis-rule.time-rule-num > 0  then do:
     2521               v-time-rule-num = cash-dis-rule.time-rule-num.
     2522             end.
     2523             if v-time-rule-num > 0  then do:
     2524               find first cash-dis-time-rule where
     2525                       cash-dis-time-rule.time-rule-num = v-time-rule-num no-error.
     2526               if available cash-dis-time-rule then do:
     2527                 assign
     2528                 v-date-from = cash-dis-time-rule.date-from
     2529                 v-date-to = cash-dis-time-rule.date-to
     2530                 .
     2531               end.
     2532               else do:
     2533                 assign
     2534                 v-date-from = today
     2535                 v-date-to = 12/31/9999
     2536                 .
     2537               end.
     2538             end.
     2539             else do:
     2540               assign
     2541               v-date-from = today
     2542               v-date-to = 12/31/9999
     2543               .
     2544             end.
     2545             run bgelib-tag-open in this-procedure ( input 2, input "TotalDisc"
     2546                                                   , input substitute("code='&1' ctrl='&2' tms='&3' "
     2547                                                                   , cash-dis-rule.rule-num
     2548                                                                   , (if action = "U"
     2549                                                                       then "ADD":U
     2550                                                                       else "DEL":U)
     2551                                                                     , OS2-time)).
     2552             run bgelib-tag-put in this-procedure ( input 3, input "TotalSum":U
     2553                                                   , input string(cash-dis-rule.tot-sum), input 1 ).
     2554             run bgelib-tag-put in this-procedure ( input 3, input "TotalPercent":U
     2555                                                   , input string(- cash-dis-rule.discnt-value), input 1 ).
     2556             define variable v-dis-kat as integer no-undo .
     2557             if cash-dis-rule.is-term = yes
     2558             and cash-dis-rule.dis-kat <= 0
     2559             and buf_cash-dis-rule.rule-num >  99999
     2560             and buf_cash-dis-rule.dis-kat > 0  then do:
     2561               v-dis-kat = buf_cash-dis-rule.dis-kat.
     2562             end.
     2563             else do:
     2564               v-dis-kat = cash-dis-rule.dis-kat.
     2565             end.
     2566             run bgelib-tag-put in this-procedure ( input 3, input "TotalCat":U
     2567                                                   , input string(if v-dis-kat < 0 then 0 else v-dis-kat), input 1 ).
     2568             run bgelib-tag-put in this-procedure ( input 3, input "TotalDateBegin":U
     2569                                                   , input Xml-CD-DatetoString(v-date-from), input 1 ).
     2570             run bgelib-tag-put in this-procedure ( input 3, input "TotalDateEnd":U
     2571                                                   , input Xml-CD-DatetoString (v-date-to), input 1 ).
     2572             run bgelib-tag-close in this-procedure ( input 2, input "TotalDisc").
     2573           end.
     2574         end.
     2575       end.
     2576       else do:
     2577           run bgelib-tag-open in this-procedure ( input 2, input "TotalDisc"
     2578                                                 , input substitute("code='*' ctrl='&1' tms='&2' "
     2579                                                                   ,"DEL":U
     2580                                                                   , OS2-time)).
     2581           run bgelib-tag-close in this-procedure ( input 2, input "TotalDisc").
     2582       end.
     2583     end.
     2584     when 'NCR-AS@R':U then do:
     2585      if action = 'U':U then do:
     2586        if v-upper-rule-num-tot-discnt > 0 then do:
     2587           find first cash-dis-rule where
     2588                     cash-dis-rule.rule-num = v-upper-rule-num-tot-discnt.
     2589           run create-ncr-kat-discnt in this-procedure (
     2590                                                       input string(0)
     2591                                                       ,input ('SD' + fill( chr(32) , 10) + "****")
     2592                                                       ,input cash-dis-rule.des
     2593                                                       ,input cash-dis-rule.rule-num
     2594                                                       ,input 20
     2595                                                       ,input 'tot-sum':U
     2596                                                       ,input ?
     2597                                                       ) no-error .
     2598        end.
     2599        if v-upper-rule-num-tot-discnt-kat > 0 then do:
     2600        for each cash-dis-rule no-lock where
     2601                 cash-dis-rule.templ-rl-root = 35
     2602             and cash-dis-rule.dis-kat < 0
     2603             :
     2604           run create-ncr-kat-discnt in this-procedure (
     2605                                                       input string(0)
     2606                                                       ,input ('SD' + fill( chr(32) , 10) + "****")
     2607                                                       ,input cash-dis-rule.des
     2608                                                       ,input cash-dis-rule.rule-num
     2609                                                       ,input 35
     2610                                                       ,input 'tot-sum':U
     2611                                                       ,input ?
     2612                                                       ) no-error .
     2613           if error-status:error then do:
     2614           end.
     2615         end.
     2616        end.
     2617      end.
     2618       if action = "D":U then do:
     2619         run create-ncr-kat-discnt in this-procedure (
     2620                                                     input string(0)
     2621                                                     ,input ('SD' + fill( chr(32) , 10) + "****")
     2622                                                     ,input '':U
     2623                                                     ,input 0
     2624                                                     ,input 0
     2625                                                     ,input 'tot-sum':U
     2626                                                     ,input ?
     2627                                                     ) no-error .
     2628       end.
     2629     end.
     2630     when 'MARIA':U then do:
     2631       v-maria-discnt-value = string(0, '999').
     2632       if action <> 'D':U  then do:
     2633         find first cash-dis-rule no-lock where
     2634           cash-dis-rule.obj-type = 'маг':U
     2635               AND cash-dis-rule.obj-code = i-obj-code
     2636               AND cash-dis-rule.rule-num = v-upper-rule-num-tot-discnt
     2637               AND cash-dis-rule.sts = integer('0':U) no-error .
     2638         if  available cash-dis-rule then do:
     2639           if index(dr-list, string(cash-dis-rule.rule-num) + '-') > 0 then do:
     2640             assign
     2641             v-dop = substring(dr-list, index(dr-list, string(cash-dis-rule.rule-num) + '-':U))
     2642             v-dop = substring(v-dop, 1, index(v-dop, chr(44)) - 1)
     2643             v-maria-rule-num = integer(entry(2, v-dop, '-':U)) - 1
     2644             v-maria-discnt-value = string(v-maria-rule-num * 8 + 2, '999')
     2645             .
     2646           end.
     2647         end.
     2648       end.
     2649       entry(1, v-record, chr(4)) = v-maria-discnt-value.
     2650     end.
     2651   END CASE .
     2652   END PROCEDURE .
     2653   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2654   PROCEDURE putctodr.
     2655   define parameter buffer buf_cash-desk for ub.cash-desk.
     2656   define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     2657   define input parameter p-pos-type as char no-undo.
     2658   CASE p-pos-type:
     2659     when 'MARIA':U then do:
     2660       run putc-dr-maria in this-procedure ( buffer buf_cash-desk
     2661                                           ,input v-template-list-tot-discnt ).
     2662     end.
     2663   END CASE .
     2664   END PROCEDURE .
