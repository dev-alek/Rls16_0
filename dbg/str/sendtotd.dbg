        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle     as handle no-undo .
        5   define input parameter p-parameter      as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Пересылка скидки на итог на кассу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable i-obj-code like ub.clients.obj-code no-undo .
       82   define variable action as char no-undo.
       83   define variable p-what-send as character no-undo .
       84   define variable vss-include-info0 as character format "X(65)" no-undo
       85   initial "@(#)$Workfile$ $Revision$".
       86   define variable v-bgelib-bgefmt        as character         no-undo.
       87   define variable v-bgelib-bgeflold      as character         no-undo.
       88   define stream stmXMLOut.
       89   define stream stmXMLLog.
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info2 as character format "X(65)" no-undo
      316   initial "@(#)$Workfile$ $Revision$".
      317   procedure xmlchar-test :
      318   define input parameter p-in-string          as character        no-undo.
      319   define output parameter p-out-string-enc    as character        no-undo.
      320   define output parameter p-out-string-dec    as character        no-undo.
      321   do
      322   on error undo, return error
      323   :
      324          run xmlchar-encode in this-procedure
      325       (
      326             input p-in-string
      327           , output p-out-string-enc
      328       ).
      329          run xmlchar-decode in this-procedure
      330       (
      331             input p-out-string-enc
      332           , output p-out-string-dec
      333       ).
      334   end.
      335   end .
      336   procedure xmlchar-encode :
      337   define input parameter p-in-string      as character        no-undo.
      338   define output parameter p-out-string    as character        no-undo.
      339       define variable v-position      as integer      no-undo.
      340       define variable v-current-char  as character    no-undo.
      341   do
      342   on error undo, return error
      343   :
      344       assign
      345           p-out-string = "":U
      346       .
      347       case p-in-string
      348       :
      349           when ?
      350           then do:
      351               assign
      352                   p-out-string = "?":U
      353               .
      354           end.
      355           when "?":U
      356           then do:
      357               assign
      358                   p-out-string = "&#63;":U
      359               .
      360           end.
      361           otherwise do:
      362               do v-position = 1 to length( p-in-string )
      363               :
      364                   assign
      365                       v-current-char = substring( p-in-string, v-position, 1 )
      366                   .
      367                   case v-current-char
      368                   :
      369                       when "&":U
      370                       then do:
      371                           assign
      372                               p-out-string = p-out-string + "&amp;":U
      373                           .
      374                       end.
      375                       when ">":U
      376                       then do:
      377                           assign
      378                               p-out-string = p-out-string + "&gt;":U
      379                           .
      380                       end.
      381                       when "<":U
      382                       then do:
      383                           assign
      384                               p-out-string = p-out-string + "&lt;":U
      385                           .
      386                       end.
      387                       when "'":U
      388                       then do:
      389                           assign
      390                               p-out-string = p-out-string + "&apos;":U
      391                           .
      392                       end.
      393                       when '"':U
      394                       then do:
      395                           assign
      396                               p-out-string = p-out-string + "&quot;":U
      397                           .
      398                       end.
      399                       when chr(1)
      400                       then do:
      401                           assign
      402                               p-out-string = p-out-string + "":U
      403                           .
      404                       end.
      405                       when chr(2)
      406                       then do:
      407                           assign
      408                               p-out-string = p-out-string + "":U
      409                           .
      410                       end.
      411                       when chr(3)
      412                       then do:
      413                           assign
      414                               p-out-string = p-out-string + "":U
      415                           .
      416                       end.
      417                       when chr(4)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + "":U
      421                           .
      422                       end.
      423                       when chr(5)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + "":U
      427                           .
      428                       end.
      429                       when chr(6)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + "":U
      433                           .
      434                       end.
      435                       when chr(7)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + "":U
      439                           .
      440                       end.
      441                       when chr(8)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "":U
      445                           .
      446                       end.
      447                       when chr(9)
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "":U
      451                           .
      452                       end.
      453                       when chr(29)
      454                       then do:
      455                           assign
      456                               p-out-string = p-out-string + "":U
      457                           .
      458                       end.
      459                       when chr(10)
      460                       then do:
      461                           assign
      462                               p-out-string = p-out-string + "&#10;":U
      463                           .
      464                       end.
      465                       when chr(13)
      466                       then do:
      467                           assign
      468                               p-out-string = p-out-string + "&#13;":U
      469                           .
      470                       end.
      471                       otherwise do:
      472                           assign
      473                               p-out-string = p-out-string + v-current-char
      474                           .
      475                       end.
      476                   end case.
      477               end.
      478           end.
      479       end case.
      480   end.
      481   end .
      482   procedure xmlchar-encode-1c :
      483   define input parameter p-in-string      as character        no-undo.
      484   define output parameter p-out-string    as character        no-undo.
      485       define variable v-position      as integer      no-undo.
      486       define variable v-current-char  as character    no-undo.
      487   do
      488   on error undo, return error
      489   :
      490       assign
      491           p-out-string = "":U
      492       .
      493       case p-in-string
      494       :
      495           when ?
      496           then do:
      497               assign
      498                   p-out-string = "?":U
      499               .
      500           end.
      501           otherwise do:
      502               do v-position = 1 to length( p-in-string )
      503               :
      504                   assign
      505                       v-current-char = substring( p-in-string, v-position, 1 )
      506                   .
      507                   case v-current-char
      508                   :
      509                       when chr(1)
      510                       then do:
