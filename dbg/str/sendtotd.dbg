     3205         _rr2:
     3206         repeat:
     3207           import stream bar unformatted ss.
     3208           assign
     3209           v-next = no
     3210           v-updated-subject-dis-kat = no
     3211           v-cd-subject-code = substring(ss, 1, 16)
     3212           v-cd-disc-string =  substring(ss, 17, 7)
     3213           .
     3214           if not ss begins 'SD'
     3215           then do:
     3216             if substring(ss0, 1, 3) = substring(v-cd-subject-code, 1, 3) then do:
     3217               put stream plucash unformatted
     3218               ss skip.
     3219               ss0 = v-cd-subject-code.
     3220               NEXT _rr2.
     3221             end.
     3222             v-next = yes.
     3223           end.
     3224           _for_rr2:
     3225           for each  buf_cash-ncr-dis-kat no-lock where
     3226                     buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
     3227                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
     3228                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
     3229                 and crf <= cr-ncr-dis-kat
     3230           by buf_cash-ncr-dis-kat.cd-subject-code
     3231           by buf_cash-ncr-dis-kat.cd-disc-string
     3232           descending
     3233           :
     3234             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
     3235             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1,  7) < v-cd-disc-string then do:
     3236               leave  _for_rr2.
     3237             end.
     3238             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
     3239               v-updated-subject-dis-kat = yes.
     3240             end.
     3241             find first  cash-ncr-save-param no-lock where
     3242                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
     3243                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
     3244                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
     3245             if available cash-ncr-save-param then do:
     3246               put stream plucash unformatted
     3247               cash-ncr-save-param.cd-line
     3248               cash-ncr-save-param.cd-other
     3249               skip.
     3250               v-cd-disc-string = substring(cash-ncr-save-param.cd-line , 17, 7)
     3251                                  .
     3252               NEXT _for_rr2.
     3253             end.
     3254             put stream plucash unformatted                                                                               buf_cash-ncr-dis-kat.cd-subject-code                                                                         buf_cash-ncr-dis-kat.cd-disc-string                                                                          buf_cash-ncr-dis-kat.cd-subject-name                                                                         buf_cash-ncr-dis-kat.cd-other                                                                                skip.
     3255           end.
     3256           if v-next then do:
     3257             ss0 = v-cd-subject-code.
     3258             put stream plucash unformatted
     3259             ss skip.
     3260             NEXT _rr2.
     3261           end.
     3262           if not v-updated-subject-dis-kat then do:
     3263             find first buf_cash-ncr-dis-kat no-lock where
     3264                       buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
     3265                   AND buf_cash-ncr-dis-kat.crf <= cr-ncr-dis-kat no-error.
     3266             if not available buf_cash-ncr-dis-kat then do:
     3267               put stream plucash unformatted
     3268               ss skip.
     3269             end.
     3270           end.
     3271           ss0 = v-cd-subject-code.
     3272         end.
     3273         input stream bar close.
     3274         _for_rr3:
     3275         for each  buf_cash-ncr-dis-kat no-lock where
     3276                   buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
     3277               AND buf_cash-ncr-dis-kat.cd-subject-code >= v-cd-subject-code
     3278               and crf <= cr-ncr-dis-kat
