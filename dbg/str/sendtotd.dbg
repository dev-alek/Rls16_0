     3453         , input 1
     3454         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3455                             , ub.cash-desk.pos-type
     3456                             , ub.cash-desk.obj-code
     3457                             , chr(10)
     3458                             , error-status:get-message(1)
     3459                             , return-value )).
     3460     assign
     3461     v-view-log = yes.
     3462     return error.
     3463   end.
     3464   if ub.cash-desk.pos-type = 'IBM-XML':U
     3465   or ub.cash-desk.pos-type = 'Autotank':U
     3466   then do:
     3467     file-info:file-name = (out  + "undelivered").
     3468     if file-info:FULL-PATHNAME <> ? then do:
     3469       run str/rsndxibm.p ( input parparentproc
     3470                           ,input p-parent-handle
     3471                           ,input p-log-handle
     3472                           ,input out  + "undelivered" ) no-error.
     3473     end.
     3474   end.
     3475     end.
     3476     when 'IBM':U
     3477     then do:
     3478   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3479   run str/get-inis.p (
