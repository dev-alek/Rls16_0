     3284             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) >= v-cd-disc-string then do:
     3285               next  _for_rr3.
     3286             end.
     3287           find first  cash-ncr-save-param no-lock where
     3288                         cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
     3289                     AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
     3290                                                       substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
     3291           if available cash-ncr-save-param then do:
