     3639   def var v_found as log no-undo .
     3640      assign
     3641        v_found = no
     3642        .
     3643      for each ub.dis-gds-rule no-lock where ub.dis-gds-rule.pos-type = 'NCR-AS@R':U
     3644                                         and  ub.dis-gds-rule.templ-rl-root = 91 :
     3645        if ub.dis-gds-rule.obj-type = "" and ub.dis-gds-rule.obj-code = 0 then
     3646        do:
     3647           v_found = yes.
     3648           leave.
     3649        end.
     3650        if ub.dis-gds-rule.obj-type = 'орг':U and ub.dis-gds-rule.obj-code = v-host-code then
     3651        do:
     3652           v_found = yes.
     3653           leave.
     3654        end.
     3655        if ub.dis-gds-rule.obj-type = 'маг':U and ub.dis-gds-rule.obj-code = i-obj-code then
     3656        do:
     3657           v_found = yes.
     3658           leave.
     3659        end.
     3660      end.
     3661      if v_found = no then
     3662      do:
     3663       for each ub.dis-thbj-rule no-lock where ub.dis-thbj-rule.pos-type = 'NCR-AS@R':U :
     3664        if (ub.dis-thbj-rule.templ-rl-root = 90 or
     3665           ub.dis-thbj-rule.templ-rl-root = 92 ) and
     3666           ub.dis-thbj-rule.obj-type = "" and
     3667           ub.dis-thbj-rule.obj-code = 0 then
     3668        do:
     3669           v_found = yes.
     3670           leave.
     3671        end.
     3672        if (ub.dis-thbj-rule.templ-rl-root = 90 or
     3673           ub.dis-thbj-rule.templ-rl-root = 92 ) and
     3674           ub.dis-thbj-rule.obj-type = 'орг':U and
     3675           ub.dis-thbj-rule.obj-code = v-host-code then
     3676        do:
     3677           v_found = yes.
     3678           leave.
     3679        end.
     3680        if (ub.dis-thbj-rule.templ-rl-root = 90 or
     3681           ub.dis-thbj-rule.templ-rl-root = 92 ) and
     3682           ub.dis-thbj-rule.obj-type = 'маг':U and
     3683           ub.dis-thbj-rule.obj-code = i-obj-code then
     3684        do:
     3685           v_found = yes.
     3686           leave.
     3687        end.
     3688       end.
     3689      end.
     3690      if v_found then
     3691      do:
     3692        def var ind as int no-undo .
     3693        run output-ncr-bonus in this-procedure ( input v-host-code,
     3694                                                 input i-obj-code,
     3695                                                 input out,
     3696                                                 output fname) .
     3697        _lock-bonus :
     3698        DO while ind < 100 :
     3699          run gbl/lock-prc.p (
     3700            input 'pncr':U
     3701           ,input i-obj-code
     3702           ,input 0
     3703           ,input 0
     3704           ,input 'маг':U
     3705           ,input "":U
     3706           ,input "":U
     3707           ,input ("Код объекта" + ",,,":U +
     3708                   "Тип объекта" +  ",,,":U + 'Передача скидки на итог и/или правил скидок')
     3709           ,input no
     3710           ,buffer lock-batchprocess
     3711           ) no-error .
     3712          if not error-status:error then do:
     3713            leave _lock-bonus.
     3714          end.
     3715          run write-log-and-file in p-log-handle (
     3716           input 1
     3717         , input log-file-name
     3718         , input 1
     3719         , input substitute( "Объект &1: Файл для выгрузки бонусов ЗАНЯТ - Ждите", i-obj-code
     3720                           )
     3721                                           ).
     3722          pause 1.
     3723        end.
     3724       OS-append
     3725       value( out + fname + '.dat':U )
     3726       value( out + fname + ".pmt":U).
     3727       if search(out + 'debug.flg') = ? then do:
     3728         OS-delete value( out + fname + '.dat':U ).
     3729       end.
     3730       if ub.cash-desk.pos-type = 'NCR-AS@R':U then do:
     3731         output stream ibmstream to value( out +  "pmt.ctl":U).
     3732         put unformatted skip.
     3733         output stream ibmstream close.
     3734       end.
     3735       run write-log-and-file in p-log-handle (
     3736             input 1
     3737           , input log-file-name
     3738           , input 1
     3739           , input substitute( "Бонусы выгружены в файл &1"
     3740                               ,( out + fname + ".pmt":U)
     3741                             )
     3742                                            ).
     3743       if g#news
     3744       or g#auto
     3745       or g#esys
     3746       then do:
     3747         run str/waitpn.w (
     3748                      input (out + fname + ".pmt":U)
     3749                     ,input ( if action = 'U'
     3750                               then ('Ждите - ' + 'добавление скидки на итог и/или правил скидок')
     3751                               else ('Ждите - ' + 'удаление скидки на итог и/или правил скидок') )
     3752                     ,input ' Подождите 15 сек '
     3753                     ,input 15
     3754                     ) no-error.
     3755       end.
     3756       else do:
     3757         run str/waitp.w (
     3758                      input (out + fname + ".pmt":U)
     3759                     ,input ( if action = 'U'
     3760                               then ('Ждите - ' + 'добавление скидки на итог и/или правил скидок')
     3761                               else ('Ждите - ' + 'удаление скидки на итог и/или правил скидок') )
     3762                     ,input ' Подождите 15 сек '
     3763                     ,input 'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!'
     3764                     ,input 15
     3765                     )
     3766                     no-error.
     3767       end.
     3768       if error-status:error then do:
     3769           run write-log-and-file in p-log-handle (
     3770                 input 1
     3771               , input log-file-name
     3772               , input 1
     3773               , input substitute( "!!!Прерван обмен информацией с кассой, на кассе осталась устаревшая информация"
     3774                                 )
     3775                                                 ).
     3776           os-delete value( out + fname + ".pmt":U).
     3777           assign
     3778           v-view-log = yes
     3779           .
     3780           return "error":U.
     3781       end.
     3782      end.
     3783     end.
     3784   END CASE.
     3785     END.
     3786   END.
     3787   END PROCEDURE.
     3788   do on error undo, throw:
     3789   assign
     3790   i-obj-code = integer(entry(1, p-parameter, chr(4)))
     3791   action = entry(2, p-parameter, chr(4))
     3792   p-what-send = entry(3, p-parameter, chr(4))
     3793   no-error
     3794   .
