     2713   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2714   PROCEDURE   for-cash-cycle:
     2715   DEFINE VARIABLE v-dir-remote as character no-undo .
     2716   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2717   define variable v-plu as character no-undo .
     2718   define variable ss  as character no-undo .
     2719   define variable ss0  as character no-undo .
     2720   define variable v-temp-kat-file as character no-undo .
     2721   define variable v-kat-file as character no-undo .
     2722   define variable v-updated-subject-dis-kat as logical no-undo .
     2723   define variable v-kat-file-save as character no-undo .
     2724   define variable v-next as logical no-undo .
     2725   define variable v-cd-subject-code as character no-undo .
     2726   define variable v-cd-disc-string as character no-undo .
     2727   define buffer for-cash-desk for ub.cash-desk.
     2728   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
     2729     FOR EACH for-cash-desk NO-LOCK WHERE
     2730             for-cash-desk.db-num = g#db-num AND
     2731             for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2732             for-cash-desk.obj-code = i-obj-code AND
     2733             for-cash-desk.cash-on  = yes:
     2734       IF (LOOKUP(ub.cash-desk.pos-type,
     2735                 ('NCR-GM':U + chr(44) +
     2736                  'IBM-XML':U + chr(44) +
     2737                  'MAGIA-XML':U + chr(44) +
     2738                  'NCR-AS@R':U
     2739                    )) > 0
     2740        and for-cash-desk.autonomy = integer('1':U)) then NEXT.
     2741      if LOOKUP(ub.cash-desk.pos-type,
     2742               'MARIA':U
     2743                  ) > 0
     2744       and for-cash-desk.autonomy = integer('2':U) then next.
     2745       run write-log-and-file in p-log-handle (
     2746             input 1
     2747           , input log-file-name
     2748           , input 1
     2749           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     2750                                                         ).
     2751   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2752   case for-cash-desk.pos-type:
     2753       when 'IBM-XML':U or when 'Autotank':U
     2754     then do:
     2755   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2756   run xml-cd-filename in this-procedure (
     2757         input out
     2758       , output v-xml-file-name
     2759       , output v-xml-file-name-path
     2760       , output v-log-file-name
     2761       , output v-locked
     2762   ).
     2763   run write-log-and-file in p-log-handle (
     2764         input 1
     2765       , input log-file-name
     2766       , input 1
     2767       , input substitute( ("''" + " &1")
     2768                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2769                         )
     2770                                         ).
     2771   run write-log-and-file in p-log-handle (
     2772         input 1
     2773       , input log-file-name
     2774       , input 1
     2775       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2776                                         ).
     2777   assign
     2778   v-obj-list = 'маг':U + string(i-obj-code)
     2779   .
     2780   run xml-cd-write-header in this-procedure (
     2781         input v-xml-file-name
     2782       , input v-xml-file-name-path
     2783       , input 'data'
     2784       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2785       , input v-obj-list
     2786       , input (
     2787                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2788                   then (if for-cash-desk.autonomy = integer('0':U)
     2789                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2790                         else ("КМ"   )
     2791                         )
     2792                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2793                   )
     2794               )
     2795       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2796   ).
     2797   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2798   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2799     end.
     2800     when 'IBM':U
     2801     then do:
     2802   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2803   if for-cash-desk.cash-os = ""
     2804   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2805   then NEXT.
     2806   assign
     2807   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     2808               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2809   Cash-DOS = NOT CASH-OS2
     2810   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     2811   v-dir-remote-tmp = v-remote + "tmp":U
     2812   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     2813   .
     2814   if for-cash-desk.remote = 1 then do:
     2815     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     2816       if error-status:error then do:
     2817         run write-log-and-file in p-log-handle (
     2818               input 1
     2819             , input log-file-name
     2820             , input 1
     2821             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2822                               "и/или попытка его создания не удалась"
     2823                               ,v-dir-remote-tmp
     2824                               ,for-cash-desk.cash-num
     2825                               ,chr(10)
     2826                               )
     2827                                               ).
     2828         NEXT.
     2829     end.
     2830     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     2831       if error-status:error then do:
     2832         run write-log-and-file in p-log-handle (
     2833               input 1
     2834             , input log-file-name
     2835             , input 1
     2836             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2837                               "и/или попытка его создания не удалась"
     2838                               ,v-dir-remote
     2839                               ,for-cash-desk.cash-num
     2840                               ,chr(10)
     2841                               )
     2842                                               ).
     2843         NEXT.
     2844       end.
     2845   end.
     2846   output stream IBMStream
     2847   to value( (if for-cash-desk.remote = 1
     2848               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2849               else out) + fname + '.dat' ) convert target "ibm866".
     2850   OS2-time =       ( if Cash-OS2 then
     2851                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2852                         else "" )
     2853   .
     2854     end.
     2855     when 'NCR-AS@R':U then do:
     2856   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2857     end.
     2858     when 'MARIA':U then do:
     2859   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2860   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
     2861       v-record = fill( chr(63) + chr(4), 1).
     2862     end.
     2863   END CASE.
     2864       if p-what-send = 'all':U
     2865       or p-what-send = 'tot-discnt':U then do:
     2866         RUN putc-9 in this-procedure
     2867                     (  buffer for-cash-desk
     2868                       ,input for-cash-desk.cash-num
     2869                       ,input for-cash-desk.pos-type ).
     2870         RUN putctodr in this-procedure
     2871                     (  buffer for-cash-desk
     2872                       ,input for-cash-desk.cash-num
     2873                       ,input for-cash-desk.pos-type ).
     2874       end.
     2875       if p-what-send = 'all':U
     2876       or p-what-send = 'gds':U then do:
     2877         RUN putcgddr in this-procedure
     2878                     (  buffer for-cash-desk
     2879                       ,input for-cash-desk.cash-num
     2880                       ,input for-cash-desk.pos-type ).
     2881       end.
     2882       if p-what-send = 'all':U
     2883       or p-what-send = 'group':U then do:
     2884         RUN putcgrdr in this-procedure
     2885                     (  buffer for-cash-desk
     2886                       ,input for-cash-desk.cash-num
     2887                       ,input for-cash-desk.pos-type ).
     2888       end.
     2889       if p-what-send = 'all':U
     2890       or p-what-send = 'payment':U then do:
     2891         RUN putcpmdr in this-procedure
     2892                     (  buffer for-cash-desk
     2893                       ,input for-cash-desk.cash-num
     2894                       ,input for-cash-desk.pos-type ).
     2895       end.
     2896       if p-what-send = 'all':U
     2897       or p-what-send = 'client':U then do:
     2898         RUN putccldr in this-procedure
     2899                     (  buffer for-cash-desk
     2900                       ,input for-cash-desk.cash-num
     2901                       ,input for-cash-desk.pos-type ).
     2902       end.
     2903   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   case for-cash-desk.pos-type:
     2905       when 'IBM-XML':U or when 'Autotank':U
     2906     then do:
     2907   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2908   output stream stmxmlout close.
     2909   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2910       , input 'data'
     2911   ).
     2912   run write-log-and-file in p-log-handle (
     2913         input 1
     2914       , input log-file-name
     2915       , input 1
     2916       , input substitute( "Данные выгружены в файл &1"
     2917                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2918                         )
     2919                                          ).
     2920   if (
     2921   not (g#news or g#auto or g#esys )
     2922   or
     2923   (
     2924   for-cash-desk.pos-type = 'MAGIA-XML':U
     2925   or
     2926     (for-cash-desk.pos-type = 'IBM-XML':U
     2927   or (for-cash-desk.pos-type = 'Autotank':U
     2928     and
     2929     for-cash-desk.autonomy = integer('2':U))
     2930     )))
     2931   then do:
     2932     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2933     end.
     2934     if (for-cash-desk.pos-type = 'IBM-XML':U
     2935     and for-cash-desk.autonomy = integer('0':U))
     2936     or (for-cash-desk.pos-type = 'Autotank':U
     2937     and for-cash-desk.autonomy = integer('2':U))
     2938     then do:
     2939       run str/post-xml.p
     2940         (
     2941          input parparentproc
     2942         ,input p-parent-handle
     2943         ,input p-log-handle
     2944         ,input g#news or g#esys
     2945         ,input g#auto
     2946         ,input 'send'
     2947         ,input log-file-name
     2948         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2949         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2950         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2951         ,input 30
     2952         ,input   ( if action = 'U'
     2953                     then ('Ждите - ' + 'добавление скидки на итог и/или правил скидок')
     2954                     else ('Ждите - ' + 'удаление скидки на итог и/или правил скидок') ) +
     2955                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2956         ) no-error .
     2957       if error-status:error
     2958       or return-value = "error" then do:
     2959         run write-log-and-file in p-log-handle (
     2960               input 1
     2961             , input log-file-name
     2962             , input 1
     2963             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2964                                   ,for-cash-desk.obj-code
     2965                                   ,for-cash-desk.cash-num
     2966                                   , chr(10)
     2967                                   , error-status:get-message(1)
     2968                                   , return-value
     2969                               )
     2970                                               ).
     2971         assign
     2972         v-view-log = yes
     2973         .
     2974       end.
     2975     end.
     2976     if not available ub.shop then do:
     2977       find first ub.shop no-lock where
     2978                 ub.shop.obj-code = for-cash-desk.obj-code.
     2979     end.
     2980     if
     2981     not (g#news or g#esys)
     2982     then do:
     2983       run str/getxibmf.p (
     2984                       input parparentproc
     2985                     ,input p-log-handle
     2986                     ,input 'маг':U
     2987                     ,input for-cash-desk.obj-code
     2988                     ,input ub.shop.host-code
     2989                     ,input in_
     2990                     ,input spl
     2991                     ,input (in_ + sav)
     2992                     ,input for-cash-desk.pos-type
     2993                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2994                             and for-cash-desk.autonomy = integer('0':U))
     2995                             or (for-cash-desk.pos-type = 'Autotank':U
     2996                             and for-cash-desk.autonomy = integer('2':U))
     2997                             then "utf-8":U
     2998                             else "windows-1251")
     2999                     ,input log-file-name
     3000                     ,input "data":U
     3001                     ,input v-xml-file-name
     3002                     ,input-output v-view-log
     3003                     ) no-error .
     3004       if error-status:error then do:
     3005         run write-log-and-file in p-log-handle (
     3006               input 1
     3007             , input log-file-name
     3008             , input 1
