     2356   define variable cr-ncr-dis-kat               as integer       no-undo .
     2357   define variable ncr-save-param               as character         no-undo init 'no'.
     2358   define variable v-upper-rule-num-tot-discnt like ub.dis-rule.upper-rule-num no-undo .
     2359   define variable v-upper-rule-num-tot-discnt-kat like ub.dis-rule.upper-rule-num no-undo .
     2360   define variable v-template-list-tot-discnt as character no-undo .
     2361   define variable v-template-list-gds as character no-undo .
     2362   define variable v-template-list-group as character no-undo .
