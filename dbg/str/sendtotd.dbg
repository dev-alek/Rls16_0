     3613   END CASE.
     3614       RUN for-cash-cycle no-error.
     3615     END.
     3616     IF LAST-OF(ub.cash-desk.pos-type) then do:
     3617   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3618   case ub.cash-desk.pos-type:
     3619     when 'NCR-AS@R':U
     3620     then do:
     3621   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3622     for each temp-dis-kat-file where
     3623               temp-dis-kat-file.to-send = yes:
     3624       OS-copy
     3625       value(temp-dis-kat-file.temp-file)
     3626       value(temp-dis-kat-file.send-file).
     3627       if search(out + 'debug.flg') = ? then do:
     3628         OS-delete value(temp-dis-kat-file.temp-file).
     3629       end.
     3630       run write-log-and-file in p-log-handle (
     3631             input 1
     3632           , input log-file-name
     3633           , input 1
     3634           , input substitute( "Данные по скидкам выгружены в файл &1"
     3635                               , temp-dis-kat-file.send-file
     3636                             )
     3637                                             ).
