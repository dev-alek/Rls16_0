     2273   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2274   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     2275   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     2276   procedure create-dis-rule :
     2277   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     2278   define input parameter p-tree as logical no-undo .
     2279   define buffer buf_dis-rule for ub.dis-rule.
     2280   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2281   define buffer term_dis-rule for ub.dis-rule.
     2282   define buffer term_dis-time-rule for ub.dis-time-rule.
     2283   define buffer root_cash-dis-rule for cash-dis-rule.
     2284   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     2285   define buffer term_cash-dis-rule for cash-dis-rule.
     2286   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     2287     do
     2288     on error undo, return error
     2289     :
     2290       find first root_cash-dis-rule no-lock where                                                         ~
     2291                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     2292       if not available root_cash-dis-rule then do:
     2293         find first buf_dis-rule no-lock where
     2294                   buf_dis-rule.rule-num = p-rule-num no-error.
     2295         if available buf_dis-rule then do:
     2296           if buf_dis-rule.time-rule-num <> 0 then do:
     2297             find first buf_dis-time-rule no-lock where
     2298                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     2299           end.
     2300           create root_cash-dis-rule.
     2301           buffer-copy buf_dis-rule to root_cash-dis-rule.
     2302           if available buf_dis-time-rule then do:
     2303             find first root_cash-dis-time-rule no-lock where
     2304                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     2305             if not available root_cash-dis-time-rule then do:
     2306               create root_cash-dis-time-rule.
     2307               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     2308             end.
     2309           end.
     2310           else do:
     2311             assign
     2312             root_cash-dis-rule.time-rule-num = 0.
     2313           end.
     2314           if buf_dis-rule.uniq-field <> "":U then do:
     2315             for each term_dis-rule no-lock where
     2316                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     2317               if term_dis-rule.time-rule-num <> 0 then do:
     2318                 find first term_dis-time-rule no-lock where
     2319                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     2320               end.
     2321               create term_cash-dis-rule.
     2322               buffer-copy term_dis-rule to term_cash-dis-rule.
     2323               if term_dis-rule.time-rule-num = 0
     2324               or available term_dis-time-rule
     2325               or root_cash-dis-rule.time-rule-num = 0
     2326               then do:
     2327                 if available term_dis-time-rule then do:
     2328                   find first term_cash-dis-time-rule no-lock where
     2329                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     2330                   if not available term_cash-dis-time-rule then do:
     2331                     create term_cash-dis-time-rule.
     2332                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     2333                   end.
     2334                 end.
     2335               end.
     2336             end.
     2337           end.
     2338         end.
     2339       end.
     2340     end.
     2341   end procedure.
