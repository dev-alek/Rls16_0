     3417   run adm/shattri.p (
     3418       input "get":U
     3419       ,input  'маг':U
     3420       ,input  ub.cash-desk.obj-code
     3421       ,input  'cd-sending':U
     3422       ,input  'dflt-cd':U
     3423       ,output dflt-cd31
