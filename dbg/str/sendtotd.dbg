     3796     run write-log-and-file in p-log-handle (
     3797           input 1
     3798         , input log-file-name
     3799         , input 1
     3800         , input substitute("Ошибка входных параметров &1:&2&3"
     3801                            , p-parameter
     3802                            , chr(10)
     3803                            , error-status:get-message(1)
     3804                            )).
