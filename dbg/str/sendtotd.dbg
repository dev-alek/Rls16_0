     3429       ,INPUT-OUTPUT table-handle v-tth32
     3430       ) no-error .
     3431   delete object v-tth32 no-error.
     3432   case ub.cash-desk.pos-type:
     3433       when 'IBM-XML':U or when 'Autotank':U
     3434     then do:
     3435   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3436   run str/get-inis.p (
