     3895       or
     3896       p-what-send = 'tot-discnt')
     3897     )
     3898   or can-find(first cash-dis-rule)
     3899   then do:
     3900     RUN SENDING in this-procedure no-error.
     3901     if error-status:error then do:
     3902       run write-log-and-file in p-log-handle (
     3903             input 1
     3904           , input log-file-name
     3905           , input 1
     3906           , input substitute( "!!!Ошибки при отсылке правил скидок на кассы  маг&1"
     3907                             , i-obj-code
     3908                             )
     3909                                             ).
     3910       assign
