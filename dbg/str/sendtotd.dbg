      522                       then do:
      523                           assign
      524                               p-out-string = p-out-string + " ":U
      525                           .
      526                       end.
      527                       when chr(4)
      528                       then do:
      529                           assign
      530                               p-out-string = p-out-string + " ":U
      531                           .
      532                       end.
      533                       when chr(5)
      534                       then do:
      535                           assign
      536                               p-out-string = p-out-string + " ":U
      537                           .
      538                       end.
      539                       when chr(6)
      540                       then do:
      541                           assign
      542                               p-out-string = p-out-string + " ":U
      543                           .
      544                       end.
      545                       when chr(7)
      546                       then do:
      547                           assign
      548                               p-out-string = p-out-string + " ":U
      549                           .
      550                       end.
      551                       when chr(8)
      552                       then do:
      553                           assign
      554                               p-out-string = p-out-string + " ":U
