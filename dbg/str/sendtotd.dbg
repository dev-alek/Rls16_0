     3852       ,output v-value-decimal41
     3853       ,output v-value-integer41
     3854       ,output v-value-logical41
     3855       ,output v-param-type41
     3856       ,INPUT-OUTPUT table-handle v-tth41
     3857       )  .
     3858   delete object v-tth41 no-error.
     3859   if p-what-send = 'ALL'
     3860   or p-what-send = 'tot-discnt' then do:
     3861     run prepare-tot-discnt in this-procedure (
     3862                                               output v-template-list-tot-discnt ) .
     3863     if dflt-cd = 'IBM':U then do:
     3864       if v-upper-rule-num-tot-discnt <> 0 then do:
     3865         find first cash-dis-rule where
     3866           cash-dis-rule.rule-num = v-upper-rule-num-tot-discnt no-error.
     3867         if available cash-dis-rule
     3868         and cash-dis-rule.templ-rl-root = 53 then do:
     3869           v-upper-rule-num-tot-discnt-kat = v-upper-rule-num-tot-discnt.
     3870           v-upper-rule-num-tot-discnt = 0.
     3871         end.
     3872       end.
     3873     end.
     3874   end.
     3875   if p-what-send = 'ALL'
     3876   or p-what-send = 'gds-discnt' then do:
