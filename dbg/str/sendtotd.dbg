      584                           .
      585                       end.
      586                   end case.
      587               end.
      588           end.
      589       end case.
      590   end.
      591   end .
      592   procedure xmlchar-decode :
      593   define input parameter p-in-string      as character        no-undo.
      594   define output parameter p-out-string    as character        no-undo.
      595       define variable v-position      as integer      no-undo.
      596       define variable v-last-position as integer      no-undo.
      597       define variable v-temp-integer  as integer      no-undo.
      598       define variable v-current-char  as character    no-undo.
      599       define variable v-next-char     as character    no-undo.
      600       define variable v-success       as logical      no-undo.
      601   do
      602   on error undo, return error
      603   :
      604       assign
      605           p-out-string = "":U
      606           v-position   = 0
      607       .
      608       replace-cycle:
      609       do while yes
      610       on error undo, return error
      611       :
      612           assign
      613               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      614           .
      615           if v-last-position <= v-position
      616           then do:
      617               if v-position = 0
      618               then do:
      619                   assign
      620                       p-out-string = p-in-string
      621                   .
      622               end.
      623               else do:
      624                   assign
      625                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      626                   .
      627               end.
      628               leave replace-cycle.
      629           end.
      630           else do:
      631               assign
      632                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      633                   v-position      = v-last-position
      634                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      635               .
      636               if v-current-char = "#":U
      637               then do:
      638                   assign
      639                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      640                   .
      641                   if v-last-position > 0
      642                   then do:
      643                       run xmlchar-read-integer in this-procedure
      644                        (
      645                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      646                           , output v-temp-integer
      647                           , output v-success
      648                       ).
      649                       if v-success = yes
      650                       and v-temp-integer >= 1
      651                       and v-temp-integer <= 255
      652                       then do:
      653                           assign
      654                               p-out-string = p-out-string + chr( v-temp-integer )
      655                               v-position   = v-last-position + 1
      656                           .
      657                       end.
      658                       else do:
      659                           assign
      660                               p-out-string = p-out-string + "&":U
      661                               v-position   = v-position   + 1
      662                           .
      663                       end.
      664                   end.
      665                   else do:
      666                       assign
      667                           p-out-string = p-out-string + "&":U
      668                           v-position   = v-position   + 1
      669                       .
      670                   end.
      671               end.
      672               else do:
      673                   case substring( p-in-string, v-position + 1, 3 )
      674                   :
      675                       when "lt;":U
      676                       then do:
      677                           assign
      678                               p-out-string = p-out-string + "<":U
      679                               v-position   = v-position   + 3
      680                           .
      681                       end.
      682                       when "gt;":U
      683                       then do:
      684                           assign
      685                               p-out-string = p-out-string + ">":U
      686                               v-position   = v-position   + 3
      687                           .
      688                       end.
      689                       otherwise do:
      690                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      691                           then do:
      692                               assign
      693                                   p-out-string = p-out-string + "&":U
      694                                   v-position   = v-position   + 4
      695                               .
      696                           end.
      697                           else do:
      698                               case substring( p-in-string, v-position + 1, 5 )
      699                               :
      700                                   when "quot;":U
      701                                   then do:
      702                                       assign
      703                                           p-out-string = p-out-string + '"':U
      704                                           v-position   = v-position   + 5
      705                                       .
      706                                   end.
      707                                   when "apos;":U
      708                                   then do:
      709                                       assign
      710                                           p-out-string = p-out-string + "'":U
      711                                           v-position   = v-position   + 5
      712                                       .
      713                                   end.
      714                                   otherwise do:
      715                                       assign
      716                                           p-out-string = p-out-string + "&":U
      717                                       .
      718                                   end.
      719                               end case.
      720                           end.
      721                       end.
      722                   end case.
      723               end.
      724           end.
      725       end.
      726   end.
      727   end .
      728   procedure xmlchar-read-integer :
      729   define input parameter p-input-string      as character        no-undo.
      730   define output parameter p-output-integer   as integer          no-undo.
      731   define output parameter p-success       as logical          no-undo.
      732   do
      733   on error undo, return error
      734   :
      735       assign
      736           p-output-integer = integer( p-input-string )
      737       no-error.
      738       if error-status :error
      739       then do:
      740           assign
      741               p-success           = no
      742               p-output-integer    = 0
      743           .
      744       end.
      745       else do:
      746           assign
      747               p-success           = yes
      748           .
      749       end.
      750   end.
      751   end.
      752   define variable v-bgelib-bgeclall           as logical      no-undo.
      753   define variable v-bgelib-bgedict            as logical      no-undo.
      754   define temp-table temp_ext-doc-type no-undo
      755       field edt-key               as integer
      756       field ext-doc-type          as character
      757       field ext-doc-type-label    as character
      758       index pi is primary unique
      759           edt-key
      760   .
      761   define temp-table temp_bgelib_goods no-undo
      762       field gds-code as integer
      763       index pi is primary unique
      764           gds-code
      765   .
      766   define temp-table temp_bgelib_clients no-undo
      767       field obj-type as character
      768       field obj-code as integer
      769       index pi is primary unique
      770           obj-type
      771           obj-code
      772   .
      773   define temp-table temp_bgelib_dis-card no-undo
      774       field d-card as character
      775       index pi is primary unique
      776           d-card
      777   .
      778   define temp-table temp_bgelib_trn-doc no-undo
      779       field doc-code as integer
      780   .
      781   procedure bgelib-tag-open:
      782   do
      783   on error undo, return error
      784   :
      785   define input parameter v-tag-level  as integer      no-undo.
      786   define input parameter v-tag-name   as character    no-undo.
      787   define input parameter v-tag-value  as character    no-undo.
      788       put stream stmXMLOut unformatted
      789           chr(10)
      790           + fill(" ", 4 * v-tag-level)
      791           + "<" + v-tag-name
      792           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      793           + v-tag-value + ">"
      794       .
      795   end.
      796   end procedure.
      797   procedure bgelib-tag-put:
      798   do
      799   on error undo, return error
      800   :
      801   define input parameter v-tag-level      as integer      no-undo.
      802   define input parameter v-tag-name       as character    no-undo.
      803   define input parameter v-tag-value      as character    no-undo.
      804   define input parameter v-empty-mode     as integer      no-undo.
      805       v-tag-name = trim(v-tag-name).
      806       if  v-empty-mode = 1
      807       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      808       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      809       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      810       then do:
      811           run xmlchar-encode in this-procedure (
      812                 input v-tag-value
      813               , output v-tag-value
      814           ).
      815           put stream stmXMLOut unformatted
      816               chr(10) + fill(" ", 4 * v-tag-level)
      817                           + '<' + v-tag-name + '>'
      818                           + v-tag-value
      819                           + '</' + v-tag-name + '>'
      820           .
      821       end.
      822   end.
      823   end procedure.
      824   procedure bgelib-tag-close:
      825   do
      826   on error undo, return error
      827   :
      828   define input parameter v-tag-level as integer      no-undo.
      829   define input parameter v-tag-name  as character    no-undo.
      830       put stream stmXMLOut unformatted
      831           chr(10)
      832           + fill( " ", 4 * v-tag-level)
      833           + '</' + v-tag-name + '>'
      834       .
      835   end.
      836   end procedure.
      837   procedure bgelib-write-log:
      838   do
      839   on error undo, return error
      840   :
      841   define input parameter v-filename   as character    no-undo.
      842   define input parameter v-log-level  as integer      no-undo.
      843   define input parameter v-out-string as character    no-undo.
      844       output stream stmXMLLog to value( v-filename ) append.
      845       put stream stmXMLLog unformatted
      846           chr(10)
      847       .
      848       put stream stmXMLLog unformatted
      849           ( if v-log-level = 0
      850             or v-out-string = "&DLine"
      851             or v-out-string = "&Line"
      852             then ""
      853             else cur-time-string-sec() + " " )
      854       .
      855       put stream stmXMLLog unformatted
      856           ( if v-out-string = "&Line"
      857             then fill( "-", 80 )
      858             else if v-out-string = "&DLine"
      859                  then fill( "=", 80 )
      860                  else v-out-string )
      861       .
      862       output stream stmXMLLog close.
      863   end.
      864   end procedure.
      865   procedure bgelib-write-edt:
      866   do
      867   on error undo, return error
      868   :
      869   define input parameter v-editor-handle    as handle       no-undo.
      870   define input parameter v-log-level        as integer      no-undo.
      871   define input parameter v-out-string       as character    no-undo.
      872       if valid-handle ( v-editor-handle )
      873       then do:
      874           v-editor-handle :move-to-eof().
      875           v-editor-handle :insert-string( ( if v-log-level = 0
      876                                             or v-out-string = "&DLine"
      877                                             or v-out-string = "&Line"
      878                                             then ""
      879                                             else cur-time-string-sec() + " "
      880                                         ) ).
      881           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      882                                             then fill( "-", 80 )
      883                                             else if v-out-string = "&DLine" then fill("=", 80)
      884                                             else fill( " ", v-log-level) + v-out-string
      885                                         ) ).
      886           v-editor-handle :insert-string( chr(10) ).
      887       end.
      888       process events.
      889       output to 'bgescn.txt' append.
      890           put unformatted
      891               chr(10)
      892               string( ( if v-log-level = 0
      893                         or v-out-string = "&DLine"
      894                         or v-out-string = "&Line"
      895                         then ""
      896                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      897                     ) )
      898               string( ( if v-out-string = "&Line"
      899                         then fill( "-", 80 )
      900                         else if v-out-string = "&DLine"
      901                              then fill( "=", 80 )
      902                              else fill( " ", v-log-level ) + v-out-string
      903                     ) )
      904           .
      905       output close.
      906   end.
      907   end procedure.
      908   procedure bgelib-show-cnt:
      909   do
      910   on error undo, return error
      911   :
      912   define input parameter v-fillin-handle     as handle   no-undo.
      913       if valid-handle( v-fillin-handle )
      914       then do:
      915           assign
      916               v-fillin-handle :visible = true
      917           .
      918       end.
      919   end.
      920   end procedure.
      921   procedure bgelib-hide-cnt:
      922   do
      923   on error undo, return error
      924   :
      925   define input parameter v-fillin-handle     as handle   no-undo.
      926       if valid-handle( v-fillin-handle )
      927       then do:
      928           assign v-fillin-handle :visible = false.
      929       end.
      930   end.
      931   end procedure.
      932   procedure bgelib-write-cnt:
      933   do
      934   on error undo, return error
      935   :
      936   define input parameter v-fillin-handle    as handle       no-undo.
      937   define input parameter v-fillin-string    as character    no-undo.
      938       if valid-handle( v-fillin-handle )
      939       then do:
      940           assign
      941               v-fillin-handle :SCREEN-value = v-fillin-string
      942           .
      943       end.
      944   end.
      945   end procedure.
      946   procedure bgelib-write-header:
      947   do
      948   on error undo, return error
      949   :
      950   define input parameter p-first-file     as logical      no-undo.
      951   define input parameter p-xml-file-name  as character    no-undo.
      952   define input parameter p-list-file-name as character    no-undo.
      953   define input parameter p-file-number    as integer      no-undo.
      954   define input parameter p-have-prev      as logical      no-undo.
      955   define input parameter p-prev-filename  as character    no-undo.
      956   define input parameter p-obj-list       as character    no-undo.
      957   define input parameter p-doc-type-list  as character    no-undo.
      958   define input parameter p-parameter-list as character    no-undo.
      959       define variable v-counter    as integer        no-undo.
      960       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      961       put stream stmXMLOut unformatted
      962           "<?xml version='1.0' encoding='windows-1251'?>"
      963       .
      964       run bgelib-tag-open( input 0, input "root"  , input "" ).
      965       run bgelib-tag-open( input 0, input "header", input "" ).
      966       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      967       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      968       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      969       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      970       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      971       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      972       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      973       :
      974           run bgelib-tag-put(
      975                 input 1
      976               , input entry( 2 * v-counter, p-parameter-list )
      977               , input entry( 2 * v-counter + 1, p-parameter-list )
      978               , input 0
      979           ).
      980       end.
      981       run bgelib-tag-close( input 0, input "header" ).
      982       output stream stmXMLOut close.
      983       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      984       if p-first-file = yes
      985       then do:
      986           put stream stmXMLOut unformatted
      987               "<?xml version='1.0' encoding='windows-1251'?>"
      988           .
      989           run bgelib-tag-open( input 0, input "export", input "" ).
      990       end.
      991       run bgelib-tag-open( input 1, input "file", input "" ).
      992       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      993       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      994       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      995       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      996       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      997       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      998       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      999       :
     1000           run bgelib-tag-put(
     1001                 input 2
     1002               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1003               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1004               , input 0
     1005           ).
     1006       end.
     1007       run bgelib-tag-close( input 1, input "file" ).
     1008       output stream stmXMLOut close.
     1009   end.
     1010   end procedure.
     1011   procedure bgelib-write-footer:
     1012   do
     1013   on error undo, return error
     1014   :
     1015   define input parameter p-last-file      as logical      no-undo.
     1016   define input parameter p-xml-file-name  as character    no-undo.
     1017   define input parameter p-list-file-name as character    no-undo.
     1018   define input parameter p-have-next      as logical      no-undo.
     1019   define input parameter p-next-file-name as character    no-undo.
     1020       define variable v-error-num     as integer           no-undo.
     1021       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1022       if p-have-next = yes
     1023       then do:
     1024           run bgelib-tag-open( input 0, input "footer", "" ).
     1025           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1026           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1027           run bgelib-tag-close( input 0, input "footer" ).
     1028       end.
     1029       run bgelib-tag-close( input 0, input "root" ).
     1030       output stream stmXMLOut close.
     1031       run bge/os_copy.p (
     1032             input "M"
     1033           , input p-xml-file-name + "tmp"
     1034           , input p-xml-file-name + "xml"
     1035           , output v-error-num
     1036       ).
     1037       if p-last-file = yes
     1038       then do:
     1039           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1040               run bgelib-tag-close( input 0, input "export" ).
     1041           output stream stmXMLOut close.
     1042           run bge/os_copy.p (
     1043                 input "M"
     1044               , input p-list-file-name + "tmp"
     1045               , input p-list-file-name + "xml"
     1046               , output v-error-num
     1047           ).
     1048       end.
     1049   end.
     1050   end procedure.
     1051   procedure bgelib-filename :
     1052   do
     1053   on error undo, return error
     1054   :
     1055   define input parameter p-prefix             as character    no-undo.
     1056   define output parameter p-xml-file-name     as character    no-undo.
     1057   define output parameter p-log-file-name     as character    no-undo.
     1058   define output parameter p-list-file-name    as character    no-undo.
     1059       define variable v-home-dir  as character    no-undo.
     1060       define variable v-error-num as integer      no-undo.
     1061       get-key-value section "BGE" key "outdir" value v-home-dir.
     1062       if v-home-dir = ?
     1063       then do:
     1064           message
     1065             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1066             skip(1)
     1067             skip "Обратитесь к администратору."
     1068           view-as alert-box error.
     1069           undo, return error .
     1070       end.
     1071       run gbl/dir-cre.p (
     1072           input v-home-dir
     1073       ) no-error.
     1074       if error-status :error
     1075       then do:
     1076           message
     1077             skip "Неверно задан каталог экспорта."
     1078             skip(1)
     1079             skip "Обратитесь к администратору."
     1080           view-as alert-box error.
     1081           undo, return error .
     1082       end.
     1083       run bge/genfname.p (
     1084             input v-home-dir
     1085           , input p-prefix
     1086           , input ""
     1087           , input "xml"
     1088           , input "tmp"
     1089           , output p-xml-file-name
     1090       ).
     1091       assign
     1092           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1093           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1094           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1095       .
     1096   end.
     1097   end procedure.
     1098   procedure bgelib-read-config :
     1099   do
     1100   on error undo, return error
     1101   :
     1102   define variable v-par-type as character     no-undo.
     1103     define variable v-param-type      as character  no-undo .
     1104     define variable v-value-character as character  no-undo .
     1105     define variable v-value-date      as date       no-undo .
     1106     define variable v-value-decimal   as decimal    no-undo .
     1107     define variable v-value-integer   as integer    no-undo .
     1108     define variable v-value-logical   as logical    no-undo .
     1109     define variable v-tth             as handle     no-undo .
     1110       assign
     1111           v-bgelib-bgeclall = no
     1112           v-bgelib-bgedict  = no
     1113       .
     1114       run adm/shattri.p ( input "get":U
     1115                         , input  '':u
     1116                         , input  0
     1117                         , input  'bge-export':U
     1118                         , input  'bgeclall':U
     1119                         , output v-value-character
     1120                         , output v-value-date
     1121                         , output v-value-decimal
     1122                         , output v-value-integer
     1123                         , output v-value-logical
     1124                         , output v-param-type
     1125                         , input-output table-handle v-tth
     1126                         ) no-error .
     1127       if error-status :error
     1128       then do:
     1129         assign
     1130           v-bgelib-bgeclall = no
     1131         .
     1132       end.
     1133       else do:
     1134         assign
     1135           v-bgelib-bgeclall = v-value-logical
     1136         .
     1137       end.
     1138       delete object v-tth.
     1139       run adm/shattri.p ( input "get":U
     1140                         , input  '':u
     1141                         , input  0
     1142                         , input  'bge-export':U
     1143                         , input  'bgedict':U
     1144                         , output v-value-character
     1145                         , output v-value-date
     1146                         , output v-value-decimal
     1147                         , output v-value-integer
     1148                         , output v-value-logical
     1149                         , output v-param-type
     1150                         , input-output table-handle v-tth
     1151                         ) no-error .
     1152       if error-status :error
     1153       then do:
     1154         assign
     1155           v-bgelib-bgedict = no
     1156         .
     1157       end.
     1158       else do:
     1159         assign
     1160           v-bgelib-bgedict = v-value-logical
     1161         .
     1162       end.
     1163       delete object v-tth.
     1164       run adm/shattri.p ( input "get":U
     1165                         , input  '':u
     1166                         , input  0
     1167                         , input  'bge-export':U
     1168                         , input  'bgefmt':U
     1169                         , output v-value-character
     1170                         , output v-value-date
     1171                         , output v-value-decimal
     1172                         , output v-value-integer
     1173                         , output v-value-logical
     1174                         , output v-param-type
     1175                         , input-output table-handle v-tth
     1176                         ) no-error .
     1177       if error-status :error
     1178       then do:
     1179         assign
     1180           v-bgelib-bgefmt  = "xml":U
     1181         .
     1182       end.
     1183       else do:
     1184         assign
     1185           v-bgelib-bgefmt  = v-value-character
     1186         .
     1187       end.
     1188       delete object v-tth.
     1189       run adm/shattri.p ( input "get":U
     1190                         , input  '':u
     1191                         , input  0
     1192                         , input  'bge-export':U
     1193                         , input  'bgeflold':U
     1194                         , output v-value-character
     1195                         , output v-value-date
     1196                         , output v-value-decimal
     1197                         , output v-value-integer
     1198                         , output v-value-logical
     1199                         , output v-param-type
     1200                         , input-output table-handle v-tth
     1201                         ) no-error .
     1202       if error-status :error
     1203       then do:
     1204         assign
     1205           v-bgelib-bgeflold  = "old":U
     1206         .
     1207       end.
     1208       else do:
     1209         assign
     1210           v-bgelib-bgeflold  = v-value-character
     1211         .
     1212       end.
     1213       delete object v-tth.
     1214   end.
     1215   end procedure.
     1216   procedure bgelib-check-file-size :
     1217   do
     1218   on error undo, return error
     1219   :
     1220   define input parameter p-out-filename   as character    no-undo.
     1221   define output parameter p-is-big        as logical      no-undo.
     1222       define variable v-current-position    as integer        no-undo.
     1223       assign
     1224           v-current-position = seek( stmXMLOut )
     1225       .
     1226       if v-current-position / 1024 / 1024  >= 100
     1227       then do:
     1228           assign
     1229               p-is-big = yes
     1230           .
     1231       end.
     1232   end.
     1233   end procedure.
     1234   procedure bgelib-init-ext-doc-type :
     1235       define variable v-counter    as integer      no-undo.
     1236       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1237   do
     1238   for buf_temp_ext-doc-type
     1239   on error undo, return error
     1240   :
     1241       empty temp-table buf_temp_ext-doc-type.
     1242       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1243       :
     1244           create buf_temp_ext-doc-type.
     1245           assign
     1246               buf_temp_ext-doc-type.edt-key               = v-counter
     1247               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1248               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1249           .
     1250       end.
     1251   end.
     1252   end procedure.
     1253   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254   define variable v-xml-file-name     as character            no-undo.
     1255   define variable v-xml-file-name-path as character            no-undo.
     1256   define variable v-log-file-name     as character            no-undo.
     1257   define variable v-locked            as logical              no-undo.
     1258   define variable v-log-string        as character            no-undo.
     1259   define variable v-oper-num          as integer              no-undo.
     1260   define variable v-obj-list          as character            no-undo.
     1261   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
