      813       (input  v-cntxt-db-num
      814       ,input  v-cntxt-userid
      815       ,input  0
      816       ,input  'actn_manufacturing_petrolium-manufacturing':U
      817       ,input  'object':U
      818       ,input  v-cntxt-host-code-obj
      819       ,input  v-cntxt-obj-type
      820       ,input  v-cntxt-obj-code
      821       ,input  0
      822       ,input  0
      823       ,input  0
      824       ,input  true
      825       ,output v-yesno
      826       )  .
      827   end.
      828         end.
      829         otherwise do:
      830           message
      831             vss-workfile vss-revision vss-description skip
      832             "Неизвестный тип рецепта" buf_recipe.recipe-type skip
      833             "Код рецепта" buf_recipe.recipe-code skip
      834             view-as alert-box error .
      835           undo, return error return-value .
      836         end.
