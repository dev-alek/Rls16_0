      735       ,input  v-cntxt-obj-type
      736       ,input  v-cntxt-obj-code
      737       ,input  0
      738       ,input  0
      739       ,input  0
      740       ,input  true
      741       ,output v-yesno
      742       )  .
      743   end.
      744         end.
      745         when 'комплектация':U
      746         then do:
      747   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748   do:
