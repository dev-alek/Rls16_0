        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle               no-undo.
        3   define input parameter p-fbrhist-handle     as widget-handle        no-undo.
        4   define input parameter p-goods-recid        as recid                no-undo.
        5   define input parameter p-fbr-doc-recid      as recid                no-undo.
        6   define input parameter p-trn-type           like fbr-line.trn-type  no-undo.
        7   define input parameter p-qnty               like fbr-line.fact-qnty no-undo.
        8   define input parameter p-recipe-recursive   as logical              no-undo.
        9   define input parameter p-recursive-enabled  as logical              no-undo.
       10   define input parameter p-fbr-obj-type       like clients.obj-type   no-undo.
       11   define input parameter p-fbr-obj-code       like clients.obj-code   no-undo.
       12   define input parameter p-ingr-line-exists   as logical              no-undo.
       13   define input parameter p-autofbr            as logical              no-undo.
       14   define input parameter p-have-store         as logical              no-undo.
       15   define output parameter p-new-goods-recid   as recid            no-undo.
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "добавление любой строки в документ производства по рецепту при заданном товаре".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308       def var log-file-name as char no-undo.
      309       assign
      310           log-file-name = 'fbr.log'
      311       .
      312       if log-file-name <> "":U
      313       then do:
      314           if search( 'fbr.log' ) = ?
      315           then do:
      316               output to value( 'fbr.log' ).
      317               output close.
      318           end.
      319       end.
      320       DEF STREAM stm-log.
      321       PROCEDURE writelog:
      322       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      323       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      324       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      325       if p-file-name <> ""
      326       then do:
      327       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      328           PUT STREAM stm-log UNFORMATTED chr(10).
      329           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      330                                           OR p-log-string = "&Line") THEN "" ELSE
      331                                           cur-time-string-sec() + " ").
      332           PUT STREAM stm-log UNFORMATTED
      333                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      334                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      335                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      336       OUTPUT STREAM stm-log CLOSE.
      337       end.
      338       END PROCEDURE.
      339   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340     define variable v-cntxt-db-num        as integer   no-undo .
      341     define variable v-cntxt-userid        as character no-undo .
      342     define variable v-cntxt-level         as character no-undo .
      343     define variable v-cntxt-host-code-obj as integer   no-undo .
      344     define variable v-cntxt-obj-type      as character no-undo .
      345     define variable v-cntxt-obj-code      as integer   no-undo .
      346     define variable v-cntxt-db-num-obj    as integer   no-undo .
      347     define variable v-cntxt-is-admin      as logical   no-undo .
      348   do
      349   on error undo, return error
      350   :
      351       define variable ref-list                as character                no-undo.
      352       define variable r-code                  like recipe.recipe-code     no-undo.
      353       define variable r-type                  as character                no-undo.
      354       define variable v-recipe-OK             as logical  init yes        no-undo.
      355      define variable v-value-character as character  no-undo .
      356      define variable v-value-date      as date       no-undo .
      357      define variable v-value-decimal   as decimal    no-undo .
      358      define variable v-value-integer   as integer    no-undo .
      359      define variable v-value-logical   as logical    no-undo .
      360      define variable v-tth             as handle     no-undo .
      361      define variable v-param-type            as character no-undo .
      362       define variable par-type                as character                no-undo.
      363       define variable comp-qnty               like fbr-line.fact-qnty     no-undo.
      364       define variable v-recipe-list           as character                no-undo.
      365       define variable v-need-goods            as logical                  no-undo.
      366       define variable v-need-goods-list       as character                no-undo.
      367       define variable v-need-goods-qnty-list  as character                no-undo.
      368       define variable v-cancel                as logical                  no-undo.
      369       define variable v-goods-recid           as recid        no-undo.
      370       define variable v-yesno                 as logical      no-undo.
      371       define variable v-fbr-line-recid        as recid        no-undo.
      372       define buffer buf_goods             for goods.
      373       define buffer buf_comp_goods        for goods.
      374       define buffer buf_recipe            for recipe.
      375       define buffer buf_selected_recipe   for recipe.
      376       define buffer buf_recipe-gds        for recipe-gds.
      377       define buffer buf_fbr-doc           for fbr-doc.
      378       find first buf_fbr-doc no-lock
      379            where recid( buf_fbr-doc ) = p-fbr-doc-recid
      380       .
      381       assign
      382           v-goods-recid = p-goods-recid
      383       .
      384       if p-qnty <= 0
      385       then do:
      386           run writelog (log-file-name, 0, "&Line").
      387           run writelog (log-file-name, 0, string(vss-workfile) + ". Передано количество товара <= 0, " + string(p-qnty) + ". Нечего добавлять").
      388           run writelog (log-file-name, 0, "&Line").
      389           assign
      390               p-new-goods-recid = v-goods-recid
      391           .
      392           return.
      393       end.
      394   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395     run mainmenu_getcntxt in p-mainmenu-handle
      396       (output v-cntxt-db-num
      397       ,output v-cntxt-userid
      398       ,output v-cntxt-level
      399       ,output v-cntxt-host-code-obj
      400       ,output v-cntxt-obj-type
      401       ,output v-cntxt-obj-code
      402       ,output v-cntxt-db-num-obj
      403       ,output v-cntxt-is-admin
      404       ) .
      405       find first buf_goods no-lock
      406            where recid (buf_goods) = v-goods-recid
      407       .
      408       find first gds-prt no-lock
      409            where gds-prt.upper-code = buf_goods.prt-root
      410       .
      411       run writelog (log-file-name, 0, "&Line").
      412       run writelog (log-file-name, 1, string( vss-workfile )
      413                                       + chr(32)                       + string(buf_goods.artic       , "X(17)")
      414                                       + chr(32)                       + string(buf_goods.gds-name    , "X(30)")
      415                                       + chr(32) + ". Кол-во: "        + (if p-qnty = ? then "?" else string(p-qnty))
      416                                       + chr(32) + ". Тип строки: "    + (if p-trn-type = ? then "?" else string(p-trn-type))
      417                           ).
      418       if buf_goods.gds-type = 'у':U
      419       then do:
      420           message
      421               "Нельзя добавить услугу."
      422               skip "Товар:" buf_goods.artic buf_goods.gds-name
      423           view-as alert-box error.
      424           run writelog (log-file-name, 0, "Тип товара - Услуга. Добавление невозможно").
      425           assign
      426               p-new-goods-recid = v-goods-recid
      427           .
      428           undo, return error.
      429       end.
      430       if buf_goods.stts <> 0
      431       then do:
      432           message
      433               "Нельзя добавить удаленный товар."
      434               skip "Товар:" buf_goods.artic buf_goods.gds-name
      435           view-as alert-box error.
      436           run writelog (log-file-name, 0, "Товар удален. Добавление невозможно").
      437           assign
      438               p-new-goods-recid = v-goods-recid
      439           .
      440           undo, return error.
      441       end.
      442       if p-recipe-recursive
      443       then do:
      444           run writelog (log-file-name, 2, "Работаем в рекурсии").
      445           if p-trn-type = ?
      446           then do:
      447               run writelog (log-file-name, 0, "Не определен тип строки. Добавление невозможно").
      448               assign
      449                   p-new-goods-recid = v-goods-recid
      450               .
      451               undo, return error.
      452           end.
      453            run adm/shattri.p ( input "get":U
      454                              , input  '':u
      455                              , input  0
      456                              , input  'fbrattr':U
      457                              , input  'fbr-frcp':U
      458                              , output v-value-character
      459                              , output v-value-date
      460                              , output v-value-decimal
      461                              , output v-value-integer
      462                              , output v-value-logical
      463                              , output v-param-type
      464                              , input-output table-handle v-tth
      465                              ) no-error .
      466            if error-status :error then do:
      467               assign
      468                  v-value-logical = FALSE
      469               .
      470            end.
      471           assign
      472               r-code = ?
      473               r-type = ?
      474           .
      475           comp-recipe:
      476           for each buf_recipe no-lock
      477              where buf_recipe.artic     = buf_goods.artic
      478                and buf_recipe.prod-type = buf_goods.prod-type
      479                and buf_recipe.prod-code = buf_goods.prod-code
      480           :
      481               run writelog (log-file-name, 3, "Рецепт: " + string(buf_recipe.recipe-code) + ", Тип: " + string(buf_recipe.recipe-type)).
      482               if p-trn-type = 'при':U
      483               and buf_recipe.recipe-type = 'разделка':U
      484               then do:
      485                   run writelog (log-file-name, 4, "Разделка для составного не может дать прихода. Ищем следующий рецепт").
      486                   next comp-recipe.
      487               end.
      488               if p-trn-type = 'спи':U
      489               and buf_recipe.recipe-type <> 'разделка':U
      490               and buf_recipe.recipe-type <> 'комплектация':U
      491               then do:
      492                   run writelog (log-file-name, 4, "Только разделка или разукомплектация для составного может дать списание. Ищем следующий рецепт").
      493                   next comp-recipe.
      494               end.
      495               if r-type = ?
      496               then do:
      497                   assign
      498                       r-code = buf_recipe.recipe-code
      499                       r-type = "recipe"
      500                   .
      501                   run writelog (log-file-name, 4, "Найден первый подходящий рецепт для составного").
      502                   if v-value-logical
      503                   or p-autofbr = yes
      504                   then do:
      505                       run writelog (log-file-name, 4, "Больше рецепт не ищем: включен параметр fbr-frcp или раскрутка для ресторана.").
      506                       leave comp-recipe.
      507                   end.
      508               end.
      509               else do:
      510                   run writelog (log-file-name, 4, "Найден еще один подходящий рецепт").
      511                   run ref/rcp-all.w (
      512                         input p-mainmenu-handle
      513                       , input "b-sel"
      514                       , input 'все':U
      515                       , input recid( buf_goods )
      516                       , input v-cntxt-obj-type
      517                       , input v-cntxt-obj-code
      518                       , output v-recipe-list
      519                   ).
      520                   find first buf_selected_recipe no-lock
      521                           where recid( buf_selected_recipe ) = integer( entry( 1, v-recipe-list ) )
      522                   no-error.
      523                   if not available buf_selected_recipe
      524                   then do:
      525                       assign
      526                           r-code = ?
      527                       .
      528                   end.
      529                   else do:
      530                       assign
      531                           r-code = buf_selected_recipe.recipe-code
      532                           r-type = "recipe"
      533                       .
      534                       leave comp-recipe.
      535                   end.
      536               end.
      537           end.
      538           if r-type = ?
      539           then do:
      540               search-recipe-gds:
      541               for each buf_recipe-gds
      542                  where buf_recipe-gds.artic       = buf_goods.artic
      543                    and buf_recipe-gds.prod-type   = buf_goods.prod-type
      544                    and buf_recipe-gds.prod-code   = buf_goods.prod-code
      545                , first buf_recipe no-lock
      546                  where buf_recipe.recipe-code = buf_recipe-gds.recipe-code
      547               :
      548                   if p-trn-type = 'при':U
      549                   and buf_recipe.recipe-type <> 'разделка':U
      550                   and buf_recipe.recipe-type <> 'комплектация':U
      551                   then do:
      552                       next search-recipe-gds.
      553                   end.
      554                   if p-trn-type = 'спи':U
      555                   and buf_recipe.recipe-type = 'разделка':U
      556                   then do:
      557                       next search-recipe-gds.
      558                   end.
      559                   if r-type = ?
      560                   then do:
      561                       assign
      562                           r-code = buf_recipe.recipe-code
      563                           r-type = "recipe-gds"
      564                       .
      565                       if v-value-logical
      566                       then do:
      567                           leave search-recipe-gds.
      568                       end.
      569                   end.
      570                   else do:
      571                       assign
      572                           r-code = ?
      573                       .
      574                   end.
      575               end.
      576           end.
      577           if r-code = ?
      578           then do:
      579               assign
      580                   v-recipe-OK = no
      581               .
      582               assign
      583                   p-new-goods-recid = v-goods-recid
      584               .
      585               return.
      586           end.
      587           find first buf_recipe no-lock
      588                where buf_recipe.recipe-code = r-code
      589           .
      590       end.
      591       else do:
      592           run ref/rcp-all.w (
      593                 input p-mainmenu-handle
      594               , input "b-add,b-sel"
      595               , input 'все':U
      596               , input v-goods-recid
      597               , input v-cntxt-obj-type
      598               , input v-cntxt-obj-code
      599               , output v-recipe-list
      600           ).
      601           find first buf_recipe no-lock
      602                where recid( buf_recipe ) = integer( ref-list )
      603           no-error.
      604           if not available buf_recipe
      605           then do:
      606               assign
      607                   v-recipe-OK = no
      608               .
      609               assign
      610                   p-new-goods-recid = v-goods-recid
      611               .
      612               return.
      613           end.
      614           if buf_recipe.artic = buf_goods.artic
      615           and buf_recipe.prod-type = buf_goods.prod-type
      616           and buf_recipe.prod-code = buf_goods.prod-code
      617           then do:
      618               assign
      619                   r-type = "recipe"
      620               .
      621           end.
      622           else do:
      623               assign
      624                   r-type = "recipe-gds"
      625               .
      626           end.
      627           case buf_recipe.recipe-type
      628           :
      629               when 'производство':U
      630               then do:
      631                   if r-type = "recipe"
      632                   then do:
      633                       assign
      634                           p-trn-type = 'при':U
      635                       .
      636                   end.
      637                   else do:
      638                       assign
      639                           p-trn-type = 'спи':U
      640                       .
      641                   end.
      642               end.
      643               when 'альтернатива':U
      644               then do:
      645                   if r-type = "recipe"
      646                   then do:
      647                       assign
      648                           p-trn-type = 'при':U
      649                       .
      650                   end.
      651                   else do:
      652                       assign
      653                           p-trn-type = 'спи':U
      654                       .
      655                   end.
      656               end.
      657               when 'разделка':U
      658               then do:
      659                   if r-type = "recipe-gds"
      660                   then do:
      661                       assign
      662                           p-trn-type = 'при':U
      663                       .
      664                   end.
      665                   else do:
      666                       assign
      667                           p-trn-type = 'спи':U
      668                       .
      669                   end.
      670               end.
      671               when 'комплектация':U
      672               then do:
      673                   assign
      674                       v-yesno = yes
      675                   .
      676                   message
      677                       "Выберите тип операции по рецепту комплектации:"
      678                       skip (2) "YES - комплектация"
      679                       skip     "NO - разукомплектация"
      680                   view-as alert-box question
      681                   buttons YES-NO
      682                   update v-yesno.
      683                   if v-yesno
      684                   then do:
      685                       if r-type = "recipe"
      686                       then do:
      687                           assign
      688                               p-trn-type = 'при':U
      689                           .
      690                       end.
      691                       else do:
      692                           assign
      693                               p-trn-type = 'спи':U
      694                           .
      695                       end.
      696                   end.
      697                   else do:
      698                       if r-type = "recipe-gds"
      699                       then do:
      700                           assign
      701                               p-trn-type = 'при':U
      702                           .
      703                       end.
      704                       else do:
      705                           assign
      706                               p-trn-type = 'спи':U
      707                           .
      708                       end.
      709                   end.
      710               end.
      711           end case.
      712       end.
      713       if r-type = "recipe-gds"
      714       then do:
      715           find first buf_recipe-gds no-lock
      716                where buf_recipe-gds.artic         = buf_goods.artic
      717                  and buf_recipe-gds.prod-type     = buf_goods.prod-type
      718                  and buf_recipe-gds.prod-code     = buf_goods.prod-code
      719                  and buf_recipe-gds.recipe-code   = buf_recipe.recipe-code
      720           .
      721       end.
      722       case buf_recipe.recipe-type
      723       :
      724         when 'производство':U
      725         then do:
      726   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   do:
      728     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      729       (input  v-cntxt-db-num
