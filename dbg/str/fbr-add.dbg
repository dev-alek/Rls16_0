      838       if not v-yesno
      839       then do:
      840           assign
      841               v-recipe-OK = no
      842           .
      843           assign
      844               p-new-goods-recid = v-goods-recid
      845           .
      846           return.
      847       end.
      848       do
      849       on error undo, return error
      850       on stop undo, return error
      851       :
      852           run str/fbr-crln.p (
      853                 input p-mainmenu-handle
      854               , input p-fbr-doc-recid
      855               , input v-goods-recid
      856               , input buf_recipe.recipe-code
      857               , input p-trn-type
      858               , input (r-type = "recipe")
      859               , input p-recipe-recursive
      860               , input p-fbr-obj-type
      861               , input p-fbr-obj-code
      862               , output v-fbr-line-recid
      863           ).
      864           find first fbr-line
      865                where recid( fbr-line ) = v-fbr-line-recid
      866           .
      867           if p-qnty = ?
      868           then do:
      869               run str/fbr-line.w (
      870                     input p-fbrhist-handle
      871                   , input 'ИЗМЕНЕНИЕ':U
      872                   , input fbr-line.doc-code
      873                   , input v-fbr-line-recid
      874                   , input ?
      875                   , output v-cancel
      876               ).
      877           end.
      878           else do:
      879               assign
      880                   fbr-line.fact-qnty = fbr-line.fact-qnty + p-qnty
      881               .
      882           end.
      883           if r-type = "recipe-gds"
      884           then do:
      885               find first buf_comp_goods no-lock
      886                    where buf_comp_goods.artic     = buf_recipe.artic
      887                      and buf_comp_goods.prod-type = buf_recipe.prod-type
      888                      and buf_comp_goods.prod-code = buf_recipe.prod-code
      889               .
      890               assign
      891                   v-goods-recid = recid( buf_comp_goods )
      892               .
      893               if buf_recipe.recipe-type = 'альтернатива':U
      894               then do:
      895                   assign
      896                       comp-qnty = fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty
      897                   .
      898               end.
      899               else do:
      900                   assign
      901                       comp-qnty = fbr-line.fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
      902                   .
      903               end.
      904               run str/fbr-crln.p (
      905                     input p-mainmenu-handle
      906                   , input p-fbr-doc-recid
      907                   , input v-goods-recid
      908                   , input buf_recipe.recipe-code
      909                   , input (if p-trn-type = 'спи':U then 'при':U else 'спи':U)
      910                   , input yes
      911                   , input p-recipe-recursive
      912                   , input p-fbr-obj-type
      913                   , input p-fbr-obj-code
      914                   , output v-fbr-line-recid
      915               ).
      916               find first fbr-line
      917                    where recid( fbr-line ) = v-fbr-line-recid
      918               .
      919               assign
      920                   fbr-line.fact-qnty = comp-qnty
      921                       - ( if p-ingr-line-exists = yes then fbr-line.fact-qnty else 0 )
      922               .
      923           end.
      924           run str/fbr-qnty.p (
      925                 input p-mainmenu-handle
      926               , input p-fbrhist-handle
      927               , input p-fbr-doc-recid
      928               , input recid( fbr-line )
      929               , input no
      930               , input "ingr"
      931               , input p-recursive-enabled
      932               , input p-fbr-obj-type
      933               , input p-fbr-obj-code
      934               , input no
      935               , input p-autofbr
      936               , input p-have-store
      937               , output v-need-goods
      938               , output v-need-goods-list
      939               , output v-need-goods-qnty-list
      940           ).
      941           assign
      942               v-goods-recid = recid( buf_goods )
      943           .
      944       end.
      945       assign
      946           p-new-goods-recid = v-goods-recid
      947       .
      948   end.
