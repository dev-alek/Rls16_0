      998   define button b-mark   label "&*"        size-chars  4.00 by 1.00 default.
      999   define button b-quit    label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
     1000   define button b-lkp   label "&Просмотр" size-chars 10.00 by 1.00 default.
