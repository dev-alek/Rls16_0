     1009   define query br-changes for buf_changes scrolling.
     1010   define browse br-rsn-hosts query br-rsn-hosts display
     1011   mark-string( buffer buf_c-trn-reason-host )  column-label '*'  format 'x(1)':U
     1012   buf_c-trn-reason-host.host-code  column-label 'Фирма'  format ">>>>>>>>9":U
     1013   buf_c-trn-reason-host.ext-doc-type  column-label 'ТД'  format "x(2)":U
     1014   buf_c-trn-reason-host.hold-doc  column-label 'М'  format "+/ ":U
     1015   buf_c-trn-reason-host.reason-code  column-label 'Код основания'  format "->,>>>,>>>,>>9":U
