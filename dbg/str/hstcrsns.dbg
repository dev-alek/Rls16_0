     2360       .
     2361         run fltopend_fltfindq in this-procedure  (
     2362                             input this-procedure:handle
     2363                             ,input query br-rsn-hosts:handle
     2364                             ,input logical(parameter-2-24)
     2365                             ,input no-lock
     2366                             ,input parameter-3-24
     2367                             ,input parameter-4-24
     2368                             ,input parameter-5-24
     2369                             ,input parameter-6-24
     2370                             ,input parameter-7-24
     2371                             ,output v-fltopend-rowid
     2372                             ) no-error.
     2373         .
     2374         v-doc-rec = ?.
     2375       end.
     2376       assign
     2377         l-query-was-opened = true
     2378       .
     2379     end.
     2380   end.
     2381     run waitfram-hide in this-procedure .
     2382     end.
     2383   end case.
     2384   if p-open-query <> yes and v-doc-rec <> ? then
     2385   reposition br-rsn-hosts to recid v-doc-rec no-error.
     2386   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2387   query br-rsn-hosts:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2388   run WaitFram-Hide in this-procedure.
     2389   apply "VALUE-CHANGED":U to br-rsn-hosts in frame fr-reason-host.
     2390   apply "ENTRY":U         to br-rsn-hosts in frame fr-reason-host.
     2391   end procedure.
     2392   procedure proc-filter :
     2393       assign tbl      = 'c-trn-reason'
     2394            join-tbl = 'buf_c-trn-reason-host'
     2395            fld      = '':U
     2396            lab      = '':U
     2397            spr      = '':U
     2398            dim      = '0'.
     2399     run fltfield-add in this-procedure ( input 'host-code',    input 'Код фирмы',      input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2400     run fltfield-add in this-procedure ( input 'ext-doc-type', input 'Расширенн. тип', input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2401     run fltfield-add in this-procedure ( input 'hold-doc',     input 'Межфирменный',   input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2402     run fltfield-add in this-procedure ( input 'reason-code',  input 'Код причины',    input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2403     run fltfield-add in this-procedure ( input 'chip-num',     input 'Щепка',          input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2404     run fltfield-add in this-procedure ( input 'corr-user-db-num',  input 'Номер БД',       input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2405     run fltfield-add in this-procedure ( input 'corr-user-name',    input 'Имя',            input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2406     run fltfield-add in this-procedure ( input 'corr-date',    input 'Дата коррекции', input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2407     run fltfield-add in this-procedure ( input 'corr-time',    input 'Время в сек.',   input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2408     run fltfield-add in this-procedure ( input 'action',       input 'Действие',       input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     2409     Filter-Block:
     2410     do on error   undo Filter-Block, leave Filter-Block
     2411        on end-key undo Filter-Block, leave Filter-Block :
     2412       run gbl/filter.w ( input parParentProc
     2413                       ,input filter-point + chr(4) + filter-label
     2414                       ,input tbl
     2415                       ,input join-tbl
     2416                       ,input fld
     2417                       ,input lab
     2418                       ,input spr
     2419                       ,input dim            ).
     2420       if return-value = 'undo':U then do:
     2421         apply "ENTRY":U to browse br-rsn-hosts.
     2422         return no-apply.
     2423       end.
     2424       assign mark-num = 0
     2425              sch-num  = 0.
     2426       hide   mark-num in frame fr-reason-host.
     2427       hide   sch-num  in frame fr-reason-host.
     2428       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2429       assign b-sch :tooltip in frame fr-reason-host = "Установить/снять фильтр".
     2430     end.
     2431   end procedure.
     2432   procedure proc-view-changes :
     2433   for each temp-changes :
     2434     delete temp-changes.
     2435   end.
     2436   if not available buf_c-trn-reason-host then do:
     2437     run OpenChanges in this-procedure .
     2438     return.
     2439   end.
     2440   define variable v-label-param as character no-undo .
     2441   v-label-param =
     2442     "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     2443    + "ext-doc-type" + chr(4) + "Расш.тип док-та" + chr(4) + "" + chr(8)
     2444    + "hold-doc" + chr(4) + "Межфирменный." + chr(4) + "" + chr(8)
     2445    + "reason-code" + chr(4) + "Код основания" + chr(4).
     2446    run proc-full-temp-changes in this-procedure (
     2447                                                input  (buf_c-trn-reason-host.action = integer('1':U))
     2448                                               ,input  (buf_c-trn-reason-host.action = integer('99':U))
     2449                                               ,input  buffer  buf_c-trn-reason-host:handle
     2450                                               ,input  'c-trn-reason-host':U
     2451                                               ,input  "host-code,ext-doc-type,hold-doc,reason-code"
     2452                                               ,input  v-label-param).
     2453   run OpenChanges in this-procedure .
     2454   end procedure.
     2455   procedure OpenChanges :
     2456    open query br-changes for each buf_changes.
     2457   end procedure.
     2458   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2459   procedure set-filter-name :
     2460   define input parameter p-filter-name as character no-undo .
     2461     do with frame fr-reason-host:
     2462       if p-filter-name > "" then do:
     2463         assign
     2464           frame fr-reason-host:title
     2465             = frame fr-reason-host:title + "   ФИЛЬТР: " + p-filter-name.
     2466         .
     2467         assign
     2468           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2469         .
     2470       end.
     2471       else do:
     2472         assign
     2473           b-sch :tooltip = ""
     2474         .
     2475       end.
     2476     end.
     2477   end procedure.
     2478   procedure get-mark-string :
     2479     define        parameter buffer loc-buf for ub.c-trn-reason-host.
     2480     define output parameter        p-sign  as  character no-undo.
     2481     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     2482   end procedure.
     2483   procedure get-action-name :
     2484     define  input parameter p-code as integer   no-undo.
     2485     define output parameter p-name as character no-undo.
     2486     define variable v_code  as character no-undo.
     2487     define variable j_entry as integer   no-undo.
     2488     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     2489     assign v_code  = Int2Char( p-code ).
     2490     assign j_entry = lookup(   v_code, p-act-codes ).
     2491     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     2492   end procedure.
     2493   procedure get-frm-name :
     2494     define        parameter buffer loc-buf for ub.c-trn-reason-host.
     2495     define output parameter        p-name  as  character no-undo.
     2496     define buffer buf_cli for ub.clients.
     2497     find first buf_cli no-lock where
     2498                buf_cli.obj-type = 'орг':U            and
     2499                buf_cli.obj-code = loc-buf.host-code no-error.
     2500     assign p-name = ( if available buf_cli then buf_cli.obj-name else ( 'орг':U + " ":U + Int2Char( loc-buf.host-code ) ) ).
     2501   end procedure.
     2502   procedure get-ext-name :
     2503     define  input parameter p-code as character no-undo.
     2504     define output parameter p-name as character no-undo.
     2505     define variable v_code  as character no-undo.
     2506     define variable j_entry as integer   no-undo.
     2507     assign j_entry = lookup( p-code, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ).
     2508     assign p-name  = ( if j_entry > 0 then entry( j_entry, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) else "":U ).
     2509   end procedure.
     2510   procedure proc-find-rsn :
     2511     define input parameter p-next as logical no-undo.
     2512     define input parameter p-code as integer no-undo.
     2513     run OpenBr in this-procedure ( input no,
     2514                                    input p-next,
     2515                                    input substitute( " and buf_c-trn-reason-host.reason-code = &1 ", p-code ) ).
     2516     if v-doc-rec <> ? then do:
     2517       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     2518       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     2519       assign  sch-num = sch-num + 1.
     2520       display sch-num with frame fr-reason-host.
     2521     end.
     2522     else do:
     2523       assign  sch-num = 0.
     2524       hide    sch-num in frame fr-reason-host.
     2525     end.
     2526     apply "ENTRY":U to sch-rsn in frame fr-reason-host.
     2527   end procedure.
     2528   procedure proc-find-frm :
     2529     define input parameter p-next as logical no-undo.
     2530     define input parameter p-code as integer no-undo.
     2531     run OpenBr in this-procedure ( input no,
     2532                                    input p-next,
     2533                                    input substitute( " and buf_c-trn-reason-host.host-code = &1 ", p-code ) ).
     2534     if v-doc-rec <> ? then do:
     2535       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     2536       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     2537       assign  sch-num = sch-num + 1.
     2538       display sch-num with frame fr-reason-host.
     2539     end.
     2540     else do:
     2541       assign  sch-num = 0.
     2542       hide    sch-num in frame fr-reason-host.
     2543     end.
     2544     apply "ENTRY":U to sch-frm in frame fr-reason-host.
     2545   end procedure.
     2546   procedure proc-find-ext :
     2547     define input parameter p-next as logical   no-undo.
     2548     define input parameter p-name as character no-undo.
     2549     assign p-name = replace( p-name, chr(34), chr(34) + chr(34) )
     2550            p-name = replace( p-name, chr(39), chr(39) + chr(39) )
     2551            p-name = chr(34) + p-name + chr(34).
     2552     run OpenBr in this-procedure ( input no,
     2553                                    input p-next,
     2554                                    input substitute( " and buf_c-trn-reason-host.ext-doc-type = &1 ", p-name ) ).
     2555     if v-doc-rec <> ? then do:
     2556       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     2557       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     2558       assign  sch-num = sch-num + 1.
     2559       display sch-num with frame fr-reason-host.
     2560     end.
     2561     else do:
     2562       assign  sch-num = 0.
     2563       hide    sch-num in frame fr-reason-host.
     2564     end.
     2565     apply "ENTRY":U to sch-ext in frame fr-reason-host.
     2566   end procedure.
