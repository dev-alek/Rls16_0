        1   define input        parameter parParentProc  as widget-handle no-undo.
        2   define input        parameter p-bttns        as character     no-undo.
        3   define input        parameter p-mode         as character     no-undo.
        4   define input        parameter p-host-code    as integer       no-undo.
        5   define input        parameter p-ext-doc-type as character     no-undo.
        6   define input        parameter p-hold-doc     as logical       no-undo.
        7   define input-output parameter p-rid-list     as character     no-undo.
        8   define variable vss-revision    as character no-undo initial "$Revision$":U.
        9   define variable vss-author      as character no-undo initial "$Author$":U.
       10   define variable vss-date        as character no-undo initial "$Date$":U.
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       12   define variable vss-archive     as character no-undo initial "$Archive$":U.
       13   define variable vss-description as character no-undo initial "История оснований (причин) создания документа по фирме":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable c-point  as character no-undo .
      121   define variable tbl      as character no-undo .
      122   define variable join-tbl as character no-undo .
      123   define variable fld      as character no-undo .
      124   define variable lab      as character no-undo .
      125   define variable spr      as character no-undo .
      126   define variable dim      as character no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-waitfram-action01         as character   no-undo .
      129   define variable v-waitfram-action02         as character   no-undo .
      130   define variable v-waitfram-action03         as character   no-undo .
      131   define variable mWaitFramTextBeg            as character   no-undo.
      132   define variable mWaitFramTextEnd            as character   no-undo.
      133   define variable mWaitFramView               as logical     no-undo.
      134   define variable mWaitProcEvent              as logical     no-undo init yes.
      135   define variable mWaitFramInterval           as integer     no-undo init 1 .
      136   define variable mWaitFramStop               as logical     no-undo.
      137   define variable mWaitFramStopUser           as logical     no-undo.
      138   define variable mWaitFramStopTimeOut        as logical     no-undo.
      139   define variable mWaitFramStartProc          as datetime-tz no-undo.
      140   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      141   define button B-WaitFramStop auto-end-key
      142        label "Стоп"
      143        size 10 by 1 tooltip "Остоновить процесс".
      144   define button B-viewProcInfo
      145        label "Информация"
      146        size 15 by 1 tooltip "Информация о процесс".
      147   define frame waitfram
      148     v-waitfram-action01 format "x(72)" no-label skip
      149     v-waitfram-action02 format "x(72)" no-label skip
      150     v-waitfram-action03 format "x(72)" no-label skip
      151     B-viewProcInfo
      152     B-WaitFramStop at row 4 col 30
      153     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      154     .
      155   define new global shared variable mBatchMode as logical no-undo init ?.
      156   define variable mFramBachModHandle as handle no-undo.
      157   mFramBachModHandle = frame waitfram:handle.
      158   define variable mFameOldVis as logical no-undo.
      159   define variable mVisCUrentVin as logical no-undo.
      160   if session:batch-mode
      161   then
      162      mBatchMode = yes.
      163   if mBatchMode = ? then do:
      164     mVisCUrentVin = current-window:visible.
      165     mFameOldVis = mFramBachModHandle:visible.
      166     mFramBachModHandle:visible  = yes.
      167     mBatchMode = mFramBachModHandle:visible ne yes.
      168     mFramBachModHandle:visible = mFameOldVis.
      169     current-window:visible = mVisCUrentVin.
      170   end.
      171    if  log-manager:logfile-name ne ?
      172     then DO:
      173         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      174         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      175         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      176     end.
      177   on choose of B-WaitFramStop in frame waitfram
      178   do:
      179     mWaitFramStop = yes.
      180     mWaitFramStopUser = yes.
      181   end.
      182   function waitfram-check-timeout returns logical():
      183      define variable vtime as int64 no-undo.
      184      if mWaitFramStopTimeOut
      185      then
      186         return yes.
      187      vtime = ( now - mWaitFramStartProc ) / 1000 .
      188      if     mWaitFramTimeOut ne ?
      189         and mWaitFramTimeOut ne 0
      190         and mWaitFramTimeOut lt vtime
      191      then do:
      192         mWaitFramStopTimeOut = yes.
      193      end.
      194      return mWaitFramStopTimeOut.
      195   end.
      196   procedure waitfram-hide :
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       pause 0 before-hide .
      202       if not mBatchMode then
      203         hide frame waitfram .
      204     if     not mWaitFramView
      205        and mWaitProcEvent
      206     then
      207       process events .
      208     end.
      209   end procedure.
      210   procedure waitfram-show :
      211     define input  parameter p-message as character no-undo .
      212     define variable v-left-margin as integer   no-undo .
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       if length(p-message) <= 70 then do:
      218         assign
      219           v-left-margin = integer((70 - length(p-message)) / 2)
      220         .
      221         assign
      222           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      223         .
      224         assign
      225           v-waitfram-action01 = " "
      226           v-waitfram-action02 = " "
      227                                    + fill(" ", v-left-margin)
      228                                    + p-message
      229           v-waitfram-action03 = " "
      230         .
      231       end.
      232       else do:
      233         define variable vRindex1 as integer no-undo.
      234         define variable vRindex2 as integer no-undo.
      235         vRindex1 = r-index(p-message," ",70).
      236         if vRindex1 = 0
      237         then
      238            vRindex1 = 70.
      239         if length(p-message)  <= vRindex1 + 70 then do:
      240           assign
      241             v-waitfram-action01 = " "
      242             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      244           .
      245         end.
      246         else do:
      247           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      248           if vRindex2 <= vRindex1
      249           then
      250              vRindex2 = vRindex1 + 70.
      251           assign
      252             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      255           .
      256         end.
      257       end.
      258       B-viewProcInfo:visible   in frame waitfram = no.
      259       B-viewProcInfo:sensitive in frame waitfram = no.
      260       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       if  (   mWaitFramView
      263          or  mWaitProcEvent)
      264          and not mBatchMode
      265       then
      266          display
      267             v-waitfram-action01 skip
      268             v-waitfram-action02 skip
      269             v-waitfram-action03 skip
      270          with frame waitfram .
      271       if     mWaitFramView
      272          then do:
      273             if     mWaitFramInterval ne ?
      274                and not mBatchMode
      275             then
      276                wait-for go of frame waitfram pause mWaitFramInterval.
      277          end.
      278          else
      279             if     mWaitProcEvent
      280                and not mBatchMode
      281             then
      282                process events .
      283     end.
      284   end procedure.
      285      procedure waitfram-show-this:
      286         define input  parameter iInterval as int64 no-undo.
      287         define variable vtime as int64 no-undo.
      288         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      289         mWaitFramInterval = iInterval.
      290         run waitfram-show (substitute("&1&2 &3&4" ,
      291                                       mWaitFramTextBeg ,
      292                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      293                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      294                                       mWaitFramTextEnd
      295                                      )
      296                           ).
      297      end.
      298      procedure WaitFramRunPause:
      299         define input  parameter iInterval as dec no-undo.
      300         define variable vStart  as datetime-tz no-undo.
      301         define variable vend    as datetime-tz no-undo.
      302         define variable vint as int64 no-undo.
      303         define variable vOk as logical no-undo.
      304         vStart = now.
      305         vend   = vStart.
      306         publish "WaitFramPause" (iInterval,output vOk).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and (   vint > 0
      312                 or (    not vOk
      313                     and iInterval eq ?
      314                     )
      315                 )
      316         then
      317            run waitfram-show-this (iInterval).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and vint > 0
      323         then do:
      324            run gbl/pause.p (vint * 1000).
      325         end.
      326         if iInterval ne ?
      327         then
      328            publish "WaitFramStop".
      329         waitfram-check-timeout().
      330      end.
      331      procedure WaitFramWaitFor:
      332         define input  parameter iInterval as dec no-undo.
      333         assign
      334            mWaitFramStartProc   = now
      335            mWaitFramStopUser    = no
      336            mWaitFramStopTimeOut = no
      337         .
      338         block-wait:
      339         do while not mWaitFramStop:
      340            run WaitFramRunPause (iInterval).
      341            if  waitfram-check-timeout()
      342            then do:
      343               leave block-wait.
      344            end.
      345         end.
      346         run waitfram-hide.
      347      end.
      348   procedure waitfram-join :
      349     define input  parameter p-line-1  as character no-undo .
      350     define input  parameter p-line-2  as character no-undo .
      351     define input  parameter p-line-3  as character no-undo .
      352     define output parameter p-message as character no-undo .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      360       .
      361     end.
      362   end procedure.
      363   function waitfram-join-function returns character
      364     (input p-line-1 as character
      365     ,input p-line-2 as character
      366     ,input p-line-3 as character
      367     ).
      368     define variable v-message as character no-undo .
      369     run waitfram-join in this-procedure
      370       (input  p-line-1
      371       ,input  p-line-2
      372       ,input  p-line-3
      373       ,output v-message
      374       ) .
      375     return v-message .
      376   end function .
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure fltfield-clear :
      379     define output parameter loc-fld as character no-undo.
      380     define output parameter loc-lab as character no-undo .
      381     define output parameter loc-spr as character no-undo .
      382     define output parameter loc-dim as character no-undo .
      383     assign
      384       loc-fld = ""
      385       loc-lab = ""
      386       loc-spr = ""
      387       loc-dim = "0"
      388     .
      389   end procedure .
      390   procedure fltfield-add :
      391     define input        parameter par-fld as character no-undo.
      392     define input        parameter par-lab as character no-undo .
      393     define input        parameter par-spr as character no-undo .
      394     define input-output parameter loc-fld as character no-undo.
      395     define input-output parameter loc-lab as character no-undo .
      396     define input-output parameter loc-spr as character no-undo .
      397     define input-output parameter loc-dim as character no-undo .
      398     do
      399     on error undo, return error
      400     :
      401       assign
      402       loc-fld = if loc-dim = '0'
      403                 then par-fld
      404                 else (loc-fld + chr(44) + par-fld)
      405       loc-lab = if loc-dim = '0'
      406                 then par-lab
      407                 else (loc-lab + chr(44) + par-lab)
      408       loc-spr = if loc-dim = '0'
      409                 then par-spr
      410                 else (loc-spr + chr(44) + par-spr)
      411       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      412                 string(integer(if num-entries(loc-dim) > 1
      413                               then entry(2, loc-dim)
      414                               else entry(1, loc-dim)
      415                               ) + 1)
      416       no-error
      417       .
      418     end.
      419   end procedure.
      420   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   define   temp-table temp-changes no-undo
      422   field f_name as character
      423   field l_name as character
      424   field v_old as character
      425   field v_new as character
      426   field t_name as character
      427   field num_ as integer
      428   field uniq-key-rec as character
      429   field action as integer
      430   field fNotChange as logical
      431   index pi is unique primary
      432   num_
      433   t_name
      434   f_name
      435   index
      436   Chan
      437   fnotChange
      438   t_name
      439   f_name
      440   index imain uniq-key-rec
      441   .
      442   FUNCTION get-all-fields returns character (p-file-name as character ):
      443   define variable v-dop as character no-undo .
      444     find first _file no-lock where _file._file-name = p-file-name no-error .
      445     if not available _file then return "":U.
      446     for each _field no-lock where
      447              _field._file-recid = recid(_file) :
      448       assign
      449       v-dop = v-dop + _field._field-name + chr(44)
      450       .
      451     end.
      452     return trim(v-dop).
      453   END FUNCTION.
      454   PROCEDURE proc-full-temp-changes :
      455     define input  parameter p-act-create as logical   no-undo .
      456     define input  parameter p-act-delete as logical   no-undo .
      457     define input  parameter p-hst-handle as handle    no-undo .
      458     define input  parameter p-main-table as character no-undo .
      459     define input  parameter p-field-list as character no-undo .
      460     define input  parameter p-label-form as character no-undo .
      461     define variable h-new-buf         as handle    no-undo .
      462     define variable h-main-buf        as handle    no-undo .
      463     define variable h-for-comp        as handle    no-undo .
      464     define variable v-inform          as character no-undo .
      465     define variable v-ind             as integer   no-undo .
      466     define variable v-idx-field-qnty  as integer   no-undo .
      467     define variable v-num-entries     as integer   no-undo .
      468     define variable fh                as handle    no-undo .
      469     define variable fh-main           as handle    no-undo .
      470     define variable fh-old            as handle    no-undo .
      471     define variable fh-new            as handle    no-undo .
      472     define variable v-field-name      as character no-undo .
      473     define variable v-field-lvl       as character no-undo .
      474     define variable v-field-form      as character no-undo .
      475     define variable v-search-exp      as character no-undo .
      476     define variable v-srch-main       as character no-undo .
      477     define variable v-word-link       as character no-undo .
      478     define variable v-av-chip-num     as logical   no-undo .
      479     define variable v-main-pi-fld-lst as character no-undo .
      480     define variable v-main-fld-lst    as character no-undo .
      481     define variable v-delim-list      as character no-undo .
      482     define variable v-label           as character no-undo .
      483     define variable v-old-value       as character no-undo case-sensitive.
      484     define variable v-new-value       as character no-undo case-sensitive.
      485     define variable v-chg-fields as character no-undo.
      486     for each temp-changes:
      487       delete temp-changes.
      488     end.
      489     if not p-hst-handle:available then do:
      490       return .
      491     end.
      492     create buffer h-new-buf  for table p-hst-handle .
      493     create buffer h-main-buf for table p-main-table .
      494     assign
      495       v-inform = h-main-buf:index-information(1)
      496       v-ind    = 2
      497     .
      498     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      499     on error undo, return error
      500     :
      501       assign
      502         v-inform = h-main-buf:index-information( v-ind )
      503         v-ind    = v-ind + 1
      504       .
      505     end.
      506     if v-inform = ?
      507       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      508       or entry( 3, v-inform, ",":U ) <> "1":U
      509     then do:
      510       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      511     end.
      512     assign
      513       v-idx-field-qnty = num-entries( v-inform ) - 4
      514     .
      515     if v-idx-field-qnty < 2 then do:
      516       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      517     end.
      518     assign
      519       v-srch-main   = "where":U
      520       v-word-link   = "":U
      521       v-av-chip-num = false
      522       v-delim-list  = "":U
      523     .
      524     do v-ind = 1 to v-idx-field-qnty by 2
      525     on error undo, return error
      526     :
      527       assign
      528         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      529         fh                = p-hst-handle:buffer-field( v-field-name )
      530         fh-main           = h-main-buf:buffer-field( v-field-name )
      531         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      532         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      533       .
      534       if fh:data-type ="character":U then do:
      535         assign
      536           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      537         .
      538       end.
      539       else do:
      540         assign
      541           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      542         .
      543       end.
      544       if v-delim-list = "":U then do:
      545         assign
      546           v-delim-list = ",":U
      547         .
      548       end.
      549       if v-word-link = "":U then do:
      550         assign
      551           v-word-link = "and":U
      552         .
      553       end.
      554     end.
      555     assign
      556       v-delim-list  = "":U
      557     .
      558     do v-ind = 1 to h-main-buf:num-fields
      559     on error undo, return error
      560     :
      561       assign
      562         fh-main      = h-main-buf:buffer-field( v-ind )
      563         v-field-name = fh-main:name
      564       .
      565         assign
      566           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      567         .
      568         if v-delim-list = "":U then do:
      569           assign
      570             v-delim-list = ",":U
      571           .
      572         end.
      573     end.
      574     assign
      575       v-inform = p-hst-handle:index-information(1)
      576       v-ind    = 2
      577     .
      578     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      579     on error undo, return error
      580     :
      581       assign
      582         v-inform = p-hst-handle:index-information( v-ind )
      583         v-ind    = v-ind + 1
      584       .
      585     end.
      586     if v-inform = ?
      587       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      588       or entry( 3, v-inform, ",":U ) <> "1":U
      589     then do:
      590       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      591     end.
      592     assign
      593       v-idx-field-qnty = num-entries( v-inform ) - 4
      594     .
      595     if v-idx-field-qnty < 2 then do:
      596       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      597     end.
      598     assign
      599       v-search-exp  = "where":U
      600       v-word-link   = "":U
      601       v-av-chip-num = false
      602     .
      603     do v-ind = 1 to v-idx-field-qnty by 2
      604     on error undo, return error
      605     :
      606       assign
      607         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      608         fh           = p-hst-handle:buffer-field( v-field-name )
      609         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      610       .
      611       if v-field-name = "chip-num":U then do:
      612         assign
      613           v-search-exp  = substitute( "&1 >", v-search-exp )
      614           v-av-chip-num = true
      615         .
      616       end.
      617       else do:
      618         assign
      619           v-search-exp = substitute( "&1 =", v-search-exp )
      620         .
      621       end.
      622       if fh:data-type ="character":U then do:
      623         assign
      624           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      625         .
      626       end.
      627       else do:
      628         assign
      629           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      630         .
      631       end.
      632       if v-word-link = "":U then do:
      633         assign
      634           v-word-link = "and":U
      635         .
      636       end.
      637     end.
      638     if v-av-chip-num = false then do:
      639       message
      640         vss-workfile vss-revision vss-description skip
      641         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      642         "Использование данной процедуры невозможно!" skip
      643         view-as alert-box error .
      644       return error .
      645     end.
      646     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      647     if not h-new-buf:available then do:
      648       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      649       if not h-main-buf:available then do:
      650         assign
      651           h-for-comp = ?
      652         .
      653       end.
      654       else do:
      655         assign
      656           h-for-comp = h-main-buf
      657         .
      658       end.
      659     end.
      660     else do:
      661       assign
      662         h-for-comp = h-new-buf
      663       .
      664     end.
      665     assign
      666       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      667     .
      668     do v-ind = 1 to v-num-entries
      669     on error undo, return error return-value
      670     :
      671       assign
      672         v-field-name = entry( v-ind, v-main-fld-lst )
      673         fh-old       = p-hst-handle:buffer-field( v-field-name )
      674         v-old-value  = fh-old:buffer-value()
      675         v-label      = trim( fh-old:label )
      676       .
      677       if ( trim( p-field-list ) <> "":U
      678            and lookup( v-field-name, p-field-list ) > 0
      679          )
      680          or trim( p-field-list ) = "":U
      681       then do:
      682         if h-for-comp <> ? then do:
      683           assign
      684             fh-new      = h-for-comp:buffer-field( v-field-name )
      685             v-new-value = fh-new:buffer-value()
      686           .
      687         end.
      688         else do:
      689           assign
      690             v-new-value = "":U
      691           .
      692         end.
      693           if p-act-create = true then do:
      694             assign
      695               v-old-value = "":U
      696             .
      697           end.
      698           if p-act-delete = true then do:
      699             assign
      700               v-new-value = "":U
      701             .
      702           end.
      703         if v-old-value <> v-new-value
      704         then do:
      705           create temp-changes.
      706           assign
      707             temp-changes.t_name = p-main-table
      708             temp-changes.f_name = v-field-name
      709             temp-changes.l_name = replace( v-label, "&":U, "":U )
      710             temp-changes.v_old  = trim( v-old-value )
      711             temp-changes.v_new  = trim( v-new-value )
      712             temp-changes.num_   = 0
      713             temp-changes.fNotChange = v-old-value eq v-new-value
      714           .
      715         end.
      716       end.
      717     end.
      718     assign
      719       v-num-entries = num-entries( p-label-form, chr(8) )
      720     .
      721     do v-ind = 1 to v-num-entries
      722     on error undo, return error return-value
      723     :
      724       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      725         assign
      726           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      727           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      728           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      729         .
      730         find first temp-changes
      731           where temp-changes.f_name = v-field-name
      732           no-error .
      733         if available temp-changes then do:
      734           if trim( v-field-lvl ) <> "":U then do:
      735             assign
      736               temp-changes.l_name = v-field-lvl
      737             .
      738           end.
      739           if trim( v-field-form ) <> "":U then do:
      740             assign
      741               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      742             .
      743             if h-for-comp <> ? then do:
      744               assign
      745                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      746               .
      747             end.
      748           end.
      749         end.
      750       end.
      751       else do:
      752         message
      753           vss-workfile vss-revision vss-description skip
      754           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      755           substitute( "список для поля '&1': '&2'"
      756                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      757                       ,entry( v-ind, p-label-form, chr(8) )
      758                     ) skip
      759           substitute( "полный список: &2", p-label-form ) skip
      760           view-as alert-box error .
      761       end.
      762     end.
      763     delete object h-new-buf .
      764     delete object h-main-buf .
      765   END PROCEDURE.
      766   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      767   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      768   procedure fltopend_fltopend :
      769   define input parameter p-parent-handle as handle no-undo .
      770   define input parameter p-qh as handle no-undo .
      771   define input parameter p-flt-open-open-query  as character no-undo .
      772   define input parameter p-where-cond as character no-undo .
      773   define input parameter p-use-indFIRST-query-tail as character no-undo .
      774   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      775   define input parameter p-indexed-reposition as character no-undo .
      776     do
      777     on error undo, return error
      778     :
      779   define variable v-prepare-string as character no-undo .
      780   define variable glog as logical no-undo .
      781   assign
      782   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      783                      p-where-cond + chr(32)  +
      784                      p-use-indFIRST-query-tail + chr(32) +
      785                      p-use-ind-sort-clmn-by + chr(32) +
      786                      p-indexed-reposition
      787   .
      788   assign
      789   glog = p-qh:query-prepare(v-prepare-string) no-error .
      790   if not glog
      791   or error-status:error then do:
      792     message error-status:get-message(1) view-as alert-box .
      793     undo, return error .
      794   end.
      795   assign
      796   glog = p-qh:query-open no-error .
      797   if not glog
      798   or error-status:error then do:
      799     message error-status:get-message(1) view-as alert-box .
      800     undo, return error .
      801   end.
      802     end.
      803   end procedure.
      804   procedure fltopend_fltfindd :
      805   define input parameter p-parent-handle as handle no-undo .
      806   define input parameter p-qh as handle no-undo .
      807   define input parameter p-rowid as rowid no-undo .
      808   define input parameter p-next as logical no-undo .
      809   define input parameter p-lock as integer no-undo .
      810   define input parameter p-bh as handle no-undo .
      811   define input parameter p-where-cond as character no-undo .
      812   define input parameter p-use-index-phrase as character no-undo .
      813   define variable glog as logical no-undo .
      814   define variable v-qh as handle no-undo .
      815   define variable v-bh as handle no-undo .
      816   define variable v-recid as recid no-undo .
      817   define variable v-prepare-string as character no-undo .
      818   do
      819   on error undo, return error
      820   on stop undo, return error
      821   :
      822     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      823     create buffer v-bh for table p-bh buffer-name p-bh:name.
      824     create query v-qh.
      825     v-qh:set-buffers(v-bh).
      826     v-prepare-string = substitute("for each &1 &2 &3"
      827                                     ,v-bh:name
      828                                     ,p-where-cond
      829                                     ,p-use-index-phrase).
      830     glog = v-qh:query-prepare(v-prepare-string) no-error.
      831     if not glog then do:
      832       delete object v-qh.
      833       delete object v-bh.
      834       undo, return error .
      835     end.
      836     glog = v-qh:query-open no-error .
      837     if not glog then do:
      838       delete object v-qh.
      839       delete object v-bh.
      840       undo, return error .
      841     end.
      842     if p-next then do:
      843       v-qh:reposition-to-rowid(p-rowid) no-error .
      844       glog = v-qh:get-next( p-lock) no-error .
      845       glog = v-qh:get-next( p-lock) no-error .
      846       if not glog or v-qh:query-off-end = yes then do:
      847         glog = v-qh:get-first( p-lock) no-error .
      848       end.
      849     end.
      850     else do:
      851       glog = v-qh:get-first( p-lock) no-error .
      852     end.
      853     v-recid = v-bh:recid no-error .
      854     delete object v-qh.
      855     delete object v-bh.
      856     return string(v-recid) .
      857   end.
      858   end procedure.
      859   procedure fltopend_fltfindq :
      860   define input parameter p-parent-handle as handle no-undo .
      861   define input parameter p-qh as handle no-undo .
      862   define input parameter p-next as logical no-undo .
      863   define input parameter p-lock as integer no-undo .
      864   define input parameter p-flt-open-open-query  as character no-undo .
      865   define input parameter p-where-cond as character no-undo .
      866   define input parameter p-use-indFIRST-query-tail as character no-undo .
      867   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      868   define input parameter p-indexed-reposition as character no-undo .
      869   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      870   define variable glog as logical no-undo .
      871   define variable v-qh as handle no-undo .
      872   define variable v-bh as handle no-undo extent 18.
      873   define variable v-rowid as rowid no-undo extent 18.
      874   define variable v-ii as integer no-undo .
      875   define variable v-prepare-string as character no-undo .
      876   do
      877   on error undo, return error
      878   on stop undo, return error
      879   :
      880     create query v-qh.
      881     do v-ii = 1 to p-qh:num-buffers:
      882       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      883       assign
      884       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      885       no-error.
      886       v-qh:add-buffer(v-bh[v-ii]).
      887     end.
      888     assign
      889     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      890                       p-where-cond + chr(32)  +
      891                       p-use-indFIRST-query-tail + chr(32) +
      892                       p-use-ind-sort-clmn-by + chr(32) +
      893                       p-indexed-reposition
      894     .
      895     glog = v-qh:query-prepare( v-prepare-string) no-error .
      896     if not glog then do:
      897       delete object v-qh.
      898       do v-ii = 1 to p-qh:num-buffers:
      899         delete object v-bh[v-ii].
      900       end.
      901       undo, return error .
      902     end.
      903     glog = v-qh:query-open no-error .
      904     if not glog then do:
      905       delete object v-qh.
      906       do v-ii = 1 to p-qh:num-buffers:
      907         delete object v-bh[v-ii].
      908       end.
      909       undo, return error .
      910     end.
      911     if p-next then do:
      912       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      913       glog = v-qh:get-next( p-lock) no-error .
      914       glog = v-qh:get-next( p-lock) no-error .
      915       if not glog or v-qh:query-off-end = yes then do:
      916         glog = v-qh:get-first( p-lock) no-error .
      917       end.
      918     end.
      919     else do:
      920       glog = v-qh:get-first( p-lock) no-error .
      921     end.
      922     do v-ii = 1 to p-qh:num-buffers:
      923       assign
      924       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      925       no-error.
      926     end.
      927     delete object v-qh.
      928     do v-ii = 1 to p-qh:num-buffers:
      929       delete object v-bh[v-ii].
      930     end.
      931   end.
      932   end procedure.
      933   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   function usrfulnf returns character ( input p-user-id as character):
      935   define variable v-user-name as character no-undo .
      936   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      938     (input  p-user-id
      939     ,output v-user-name
      940     ) no-error .
      941   if error-status:error
      942   or v-user-name = ""
      943   then do:
      944     return p-user-id.
      945   end.
      946   else do:
      947     return v-user-name.
      948   end.
      949   end function.
      950   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      951   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      952     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      953     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      954     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      955   END FUNCTION.
      956   PROCEDURE conv-rec-to-char :
      957     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      958     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      959     DO ON ERROR UNDO, RETURN ERROR :
      960       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      961     END.
      962   END PROCEDURE.
