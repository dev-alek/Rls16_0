     1406   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   procedure minbtn-set :
     1408       do
     1409           on error undo, return error return-value
     1410           :
     1411           define variable ii              as integer       no-undo .
     1412           define variable fh              as widget-handle no-undo .
     1413           define variable hh              as widget-handle no-undo .
     1414           define variable v-h             as handle        extent 4 no-undo .
     1415           define variable v-name-button   as character     no-undo .
     1416           define variable v-help-old-x    as decimal       no-undo .
     1417           define variable v-help-old-y    as decimal       no-undo .
     1418           define variable v-help-old-size as decimal       no-undo .
     1419           define variable v-frame-width   as decimal       no-undo .
     1420           define variable jj              as integer       no-undo .
     1421           do
     1422               on error undo, return error
     1423               :
     1424               assign
     1425                   v-frame-width = frame fr-reason-host:width - 0.3
     1426                   fh            = frame fr-reason-host:first-child
     1427                   hh            = fh:first-child
     1428                   ii            = 1
     1429                   .
     1430               do while valid-handle(hh):
     1431                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1432                   do:
     1433                       case lc(hh:name) :
     1434                           when "b-help" then
     1435                               do:
     1436                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1437                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1438                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1439                                   hh:TOOLTIP = "Помощь" .
     1440                                   v-help-old-x = hh:column .
     1441                                   v-help-old-y = hh:row    .
     1442                                   v-help-old-size = hh:width .
     1443                                   hh:width-chars = 2.5 .
     1444                               end.
     1445                           when "b-print" then
     1446                               do:
     1447                                   hh:load-image("cmp/b-print.bmp":u) .
     1448                                   hh:TOOLTIP = "Печать" .
     1449                                   v-h[ii] = hh:handle .
     1450                                   ii = ii + 1 .
     1451                                   hh:width-chars = 3 .
     1452                               end.
     1453                           when "b-history" or
     1454                           when "b-hist" then
     1455                               do:
     1456                                   hh:load-image("cmp/b-hist.bmp":u) .
     1457                                   hh:TOOLTIP = "История" .
     1458                                   v-h[ii] = hh:handle .
     1459                                   ii = ii + 1 .
     1460                                   hh:width-chars = 3 .
     1461                               end.
     1462                           when "b-sch" then
     1463                               do:
     1464                                   hh:load-image("cmp/b-sch.bmp":u) .
     1465                                   hh:TOOLTIP = "Установка Фильтра" .
     1466                                   v-h[ii] = hh:handle .
     1467                                   ii = ii + 1 .
     1468                                   hh:width-chars = 3 .
     1469                               end.
     1470                           when "b-hist-user" then
     1471                               do:
     1472                                   hh:load-image("cmp/b-hist.bmp":u) .
     1473                                   hh:TOOLTIP = "История пользователя" .
     1474                                   ii = ii + 1 .
     1475                               end.
     1476                       end case.
     1477                   end.
     1478                   hh = hh:next-sibling.
     1479               end.
     1480               b-help:column = v-frame-width - b-help:width-chars.
     1481               jj = 0.
     1482               repeat ii = 4 to 1 by -1 :
     1483                   if valid-handle (v-h[ii] ) then
     1484                   do:
     1485                       jj  = jj + 1 .
     1486                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1487                       v-h[ii]:row    = v-help-old-y .
     1488                   end.
     1489               end.
     1490           end.
     1491       end.
     1492   end procedure.
     1493   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1494   DEF VAR cur-clmn-numbr-rsn-hosts as INT EXTENT 13 no-undo.
     1495   DEF VAR varmvibr-rsn-hosts       as INT no-undo.
     1496   DEF VAR varmvjbr-rsn-hosts       as INT no-undo.
     1497   DEF VAR varmvkbr-rsn-hosts       as INT no-undo.
     1498   DEF VAR varmvlbr-rsn-hosts       as INT no-undo.
     1499   DEF VAR move-elementbr-rsn-hosts as INT no-undo.
     1500   def var jjbr-rsn-hosts           as int no-undo.
     1501   do varmvibr-rsn-hosts = 1 to EXTENT(cur-clmn-numbr-rsn-hosts):
     1502     ASSIGN cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = varmvibr-rsn-hosts.
     1503   END.
     1504   RUN start-mv-clmnbr-rsn-hosts.
     1505   PROCEDURE start-mv-clmnbr-rsn-hosts:
     1506   def var old-session as logical no-undo.
     1507      old-session = SESSION:IMMEDIATE-DISPLAY.
     1508      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1509      SESSION:IMMEDIATE-DISPLAY = old-session.
     1510   END.
     1511   ON ctrl-cursor-right OF BROWSE br-rsn-hosts do:
     1512     RUN re-move-clmnbr-rsn-hosts ( 2, 13).
     1513   END.
     1514   ON ctrl-cursor-left OF BROWSE br-rsn-hosts do:
     1515     RUN re-move-clmnbr-rsn-hosts (13, 2).
     1516   END.
     1517   PROCEDURE re-move-clmnbr-rsn-hosts:
     1518     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1519     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1520     DO varmvibr-rsn-hosts = 1 TO EXTENT(cur-clmn-numbr-rsn-hosts):
     1521       if cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = source-column THEN cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = -1.
     1522     END.
     1523     if br-rsn-hosts:MOVE-COLUMN(source-column, target-column) IN FRAME fr-reason-host then.
     1524     if source-column > target-column THEN
     1525     DO varmvjbr-rsn-hosts = source-column - 1 to target-column BY -1:
     1526       DO varmvibr-rsn-hosts = 1 TO EXTENT(cur-clmn-numbr-rsn-hosts):
     1527           if cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = varmvjbr-rsn-hosts THEN DO:
     1528             cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] + 1.
     1529           END.
     1530       END.
     1531     END.
     1532     ELSE
     1533     DO varmvjbr-rsn-hosts = source-column + 1 to target-column:
     1534       DO varmvibr-rsn-hosts = 1 TO EXTENT(cur-clmn-numbr-rsn-hosts):
     1535         if cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = varmvjbr-rsn-hosts THEN DO:
     1536           cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] - 1.
     1537         END.
     1538       END.
     1539     END.
     1540     DO varmvibr-rsn-hosts = 1 TO EXTENT(cur-clmn-numbr-rsn-hosts):
     1541       if cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = -1 THEN cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = target-column.
     1542     END.
     1543   END PROCEDURE.
     1544   PROCEDURE ch-clmnbr-rsn-hosts:
     1545     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1546     if cur-clmn-loc <= 2 then do:
     1547       return .
     1548     end.
     1549     DO varmvibr-rsn-hosts = 1 TO EXTENT(cur-clmn-numbr-rsn-hosts):
     1550       if cur-clmn-numbr-rsn-hosts[varmvibr-rsn-hosts] = cur-clmn-loc THEN move-elementbr-rsn-hosts = varmvibr-rsn-hosts.
     1551     END.
     1552     RUN re-move-clmnbr-rsn-hosts (cur-clmn-loc, 2).
     1553   END PROCEDURE.
     1554   PROCEDURE mv-brw-defaultbr-rsn-hosts:
     1555   def var old-session as logical no-undo.
     1556     old-session = SESSION:IMMEDIATE-DISPLAY.
     1557     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1558     do varmvlbr-rsn-hosts = 2 to EXTENT(cur-clmn-numbr-rsn-hosts):
     1559       RUN re-move-clmnbr-rsn-hosts (cur-clmn-numbr-rsn-hosts[varmvlbr-rsn-hosts], varmvlbr-rsn-hosts).
     1560     END.
     1561     RUN start-mv-clmnbr-rsn-hosts.
     1562     SESSION:IMMEDIATE-DISPLAY = old-session.
     1563   END PROCEDURE.
     1564   .
     1565   def var sort-labelbr-rsn-hosts   as character no-undo .
     1566   def var sort-clmnbr-rsn-hosts    as handle    no-undo .
     1567   def var cur-clmnbr-rsn-hosts     as handle    no-undo .
     1568   def var cur-clmn-locbr-rsn-hosts as integer   no-undo .
     1569   def var re-querybr-rsn-hosts     as logical   initial no no-undo .
     1570   on start-search, ctrl-o of br-rsn-hosts in frame fr-reason-host do:
     1571      run sort-brbr-rsn-hosts
     1572        (input (if available buf_c-trn-reason-host
     1573                then recid(buf_c-trn-reason-host)
     1574                else ?
     1575               )
     1576        ).
     1577   end.
     1578   PROCEDURE sort-brbr-rsn-hosts :
     1579     define input parameter p-recid as recid no-undo .
     1580     if re-querybr-rsn-hosts = no then do:
     1581       assign
     1582          cur-clmnbr-rsn-hosts = br-rsn-hosts:current-column in frame fr-reason-host
     1583       .
     1584       if sort-clmnbr-rsn-hosts <> ? then sort-clmnbr-rsn-hosts:column-fgcolor = 0.
     1585       if cur-clmnbr-rsn-hosts = sort-clmnbr-rsn-hosts then do:
     1586         assign
     1587            sort-labelbr-rsn-hosts = ""
     1588            sort-clmnbr-rsn-hosts = ?
     1589         .
     1590        end.
     1591        else do:
     1592          assign
     1593            sort-labelbr-rsn-hosts = cur-clmnbr-rsn-hosts:label
     1594            sort-clmnbr-rsn-hosts  = cur-clmnbr-rsn-hosts
     1595            sort-clmnbr-rsn-hosts:column-fgcolor = 4
     1596          .
     1597        end.
     1598      end.
     1599     assign
     1600       cur-clmn-locbr-rsn-hosts = 1
     1601     .
     1602     def var column-handle as handle no-undo .
     1603     column-handle = br-rsn-hosts:first-column.
     1604     do while valid-handle(column-handle) :
     1605       if column-handle = cur-clmnbr-rsn-hosts then do:
     1606         leave .
     1607       end.
     1608       column-handle = column-handle:NEXT-COLUMN.
     1609       assign
     1610         cur-clmn-locbr-rsn-hosts = cur-clmn-locbr-rsn-hosts + 1
     1611       .
     1612     end.
     1613     case sort-labelbr-rsn-hosts:
     1614           when 'Фирма'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.host-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1615           when 'ТД'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.ext-doc-type"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1616           when 'М'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.hold-doc"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1617           when 'Код основания'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.reason-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1618           when 'Расширенный тип документа'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ext-name&1, buf_c-trn-reason-host.ext-doc-type)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1619           when 'Изменил'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, buf_c-trn-reason-host.corr-user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1620           when 'Действие'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ShowAction&1, buf_c-trn-reason-host.action)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1621           when 'Дата корр.'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1622           when 'Время'  then DO:    assign       sort-column-name = "STRING( buf_c-trn-reason-host.corr-time, 'HH:MM:SS':U )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1623           when 'Щепка'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1624           when 'БД'  then DO:    assign       sort-column-name = "buf_c-trn-reason-host.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     1625       otherwise do:
     1626         assign
     1627           sort-column-name = ""
     1628         .
     1629         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     1630           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-rsn-hosts') then do:
     1631             run mv-brw-defaultbr-rsn-hosts.
     1632           end.
     1633         if sort-labelbr-rsn-hosts <> "" then do:
     1634           assign
     1635             cur-clmnbr-rsn-hosts:column-fgcolor = 0
     1636           .
     1637         end.
     1638         assign
     1639           cur-clmn-locbr-rsn-hosts = ?
     1640         .
     1641       end.
     1642     end case.
     1643     if p-recid <> ? then do:
     1644       reposition br-rsn-hosts to recid p-recid no-error.
     1645       apply "value-changed" to br-rsn-hosts in frame fr-reason-host.
     1646     end.
     1647     apply "entry" to br-rsn-hosts in frame fr-reason-host.
     1648   END PROCEDURE.
     1649   procedure re-open-query-srt-clmnbr-rsn-hosts:
     1650   if cur-clmnbr-rsn-hosts = ? then do:
     1651      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     1652   end.
     1653   else do:
     1654      assign re-querybr-rsn-hosts = yes.
     1655      run sort-brbr-rsn-hosts
     1656        (input (if available buf_c-trn-reason-host
     1657                then recid(buf_c-trn-reason-host)
     1658                else ?
     1659               )
     1660        ).
     1661      assign re-querybr-rsn-hosts = no.
     1662   end.
     1663   end.
     1664   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   DEF VAR cur-clmn-numbr-changes as INT EXTENT 3 no-undo.
     1666   DEF VAR varmvibr-changes       as INT no-undo.
     1667   DEF VAR varmvjbr-changes       as INT no-undo.
     1668   DEF VAR varmvkbr-changes       as INT no-undo.
     1669   DEF VAR varmvlbr-changes       as INT no-undo.
     1670   DEF VAR move-elementbr-changes as INT no-undo.
     1671   def var jjbr-changes           as int no-undo.
     1672   do varmvibr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     1673     ASSIGN cur-clmn-numbr-changes[varmvibr-changes] = varmvibr-changes.
     1674   END.
     1675   RUN start-mv-clmnbr-changes.
     1676   PROCEDURE start-mv-clmnbr-changes:
     1677   def var old-session as logical no-undo.
     1678      old-session = SESSION:IMMEDIATE-DISPLAY.
     1679      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1680      SESSION:IMMEDIATE-DISPLAY = old-session.
     1681   END.
     1682   ON ctrl-cursor-right OF BROWSE br-changes do:
     1683     RUN re-move-clmnbr-changes ( 1, 3).
     1684   END.
     1685   ON ctrl-cursor-left OF BROWSE br-changes do:
     1686     RUN re-move-clmnbr-changes (3, 1).
     1687   END.
     1688   PROCEDURE re-move-clmnbr-changes:
     1689     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     1690     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     1691     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     1692       if cur-clmn-numbr-changes[varmvibr-changes] = source-column THEN cur-clmn-numbr-changes[varmvibr-changes] = -1.
     1693     END.
     1694     if br-changes:MOVE-COLUMN(source-column, target-column) IN FRAME fr-reason-host then.
     1695     if source-column > target-column THEN
     1696     DO varmvjbr-changes = source-column - 1 to target-column BY -1:
     1697       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     1698           if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     1699             cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] + 1.
     1700           END.
     1701       END.
     1702     END.
     1703     ELSE
     1704     DO varmvjbr-changes = source-column + 1 to target-column:
     1705       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     1706         if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     1707           cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] - 1.
     1708         END.
     1709       END.
     1710     END.
     1711     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     1712       if cur-clmn-numbr-changes[varmvibr-changes] = -1 THEN cur-clmn-numbr-changes[varmvibr-changes] = target-column.
     1713     END.
     1714   END PROCEDURE.
     1715   PROCEDURE ch-clmnbr-changes:
     1716     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     1717     if cur-clmn-loc <= 1 then do:
     1718       return .
     1719     end.
     1720     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     1721       if cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-loc THEN move-elementbr-changes = varmvibr-changes.
     1722     END.
     1723     RUN re-move-clmnbr-changes (cur-clmn-loc, 1).
     1724   END PROCEDURE.
     1725   PROCEDURE mv-brw-defaultbr-changes:
     1726   def var old-session as logical no-undo.
     1727     old-session = SESSION:IMMEDIATE-DISPLAY.
     1728     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     1729     do varmvlbr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     1730       RUN re-move-clmnbr-changes (cur-clmn-numbr-changes[varmvlbr-changes], varmvlbr-changes).
     1731     END.
     1732     RUN start-mv-clmnbr-changes.
     1733     SESSION:IMMEDIATE-DISPLAY = old-session.
     1734   END PROCEDURE.
     1735   .
     1736   Main-Block:
     1737   do on error   undo Main-Block, leave Main-Block
     1738      on end-key undo Main-Block, leave Main-Block :
     1739     if lookup( p-mode, 'все,frm,one':U ) = 0 then do:
     1740       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     1741               "Неверное значение параметра вызова p-mode:" p-mode
     1742       view-as alert-box error.
     1743       return.
     1744     end.
     1745     if p-mode = 'frm':U and
     1746        p-mode = 'one':U then do:
     1747       find first sch_c-trn-reason-host no-lock where
     1748                  sch_c-trn-reason-host.host-code = p-host-code no-error.
     1749       if not available sch_c-trn-reason-host then do:
     1750         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     1751                 'Неверное значение параметра вызова p-host-code:' p-host-code '.'
     1752         view-as alert-box error.
     1753         return.
     1754       end.
     1755     end.
     1756     if p-mode = 'one':U then do:
     1757       find first sch_c-trn-reason-host no-lock where
     1758                  sch_c-trn-reason-host.host-code    = p-host-code    and
     1759                  sch_c-trn-reason-host.ext-doc-type = p-ext-doc-type and
     1760                  sch_c-trn-reason-host.hold-doc     = p-hold-doc     no-error.
     1761       if not available sch_c-trn-reason-host then do:
     1762         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     1763                 'Неверное значение параметров вызова p-ext-doc-type и p-hold-doc:' p-ext-doc-type p-hold-doc '.'
     1764         view-as alert-box error.
     1765         return.
     1766       end.
     1767     end.
     1768     if p-rid-list <> "":U then do:
     1769       find first sch_c-trn-reason-host no-lock where
     1770           recid( sch_c-trn-reason-host ) = integer( entry( 1, p-rid-list ) ) no-error.
     1771       if not available sch_c-trn-reason-host then do:
     1772         message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     1773                 'Неверное значение параметра вызова p-rid-list: "' + p-rid-list + '".'
     1774         view-as alert-box error.
     1775         return error.
     1776       end.
     1777       else do:
     1778         assign v-doc-rec = recid( sch_c-trn-reason-host ).
     1779       end.
     1780     end.
     1781     enable  b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     1782             b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     1783             b-sch b-help b-quit b-lkp br-rsn-hosts br-changes sch-rsn sch-frm sch-ext
     1784     with frame fr-reason-host.
     1785     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     1786     hide mark-num in frame fr-reason-host.
     1787     hide  sch-num in frame fr-reason-host.
     1788     if p-rid-list <> "":U then do:
     1789       reposition br-rsn-hosts to recid v-doc-rec no-error.
     1790     end.
     1791     br-rsn-hosts :set-repositioned-row( 5, "CONDITIONAL":U ).
     1792     wait-for go of frame fr-reason-host.
     1793   end.
     1794   hide frame fr-reason-host no-pause.
     1795   procedure OpenBr :
     1796   define input parameter p-open-query     as logical   no-undo.
     1797   define input parameter p-find-next      as logical   no-undo.
     1798   define input parameter p-find-condition as character no-undo.
     1799   define variable l-query-was-opened as logical   no-undo.
     1800   define variable title0             as character no-undo.
     1801   define variable sort-column-phrase as character no-undo.
     1802   define variable l-open-query       as logical   no-undo.
     1803   case sort-column-name :
     1804     when "":U then do:
     1805       assign sort-column-phrase = "":U.
     1806     end.
     1807     otherwise      do:
     1808       assign sort-column-phrase = "by " + sort-column-name.
     1809    end.
     1810   end case.
     1811   assign
     1812   filter-point = substitute('&1 - &2', filter-point0, p-mode)
     1813   filter-label = substitute('&1 - &2', filter-label0, p-mode)
     1814   .
     1815   case p-mode :
     1816     when 'все':U  then do:
     1817       assign
     1818       frame fr-reason-host :title = "История оснований (причин) создания документов по объектам".
     1819   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1820   define variable  l-disable-where-20  as logical   no-undo .
     1821   define variable  l-filter-open-20    as logical   .
     1822   define variable  flt-rec-20       as recid     no-undo .
     1823   define variable  filter-name-20      as character no-undo .
     1824   define variable  where-phrase-20     as character no-undo .
     1825   define variable  sort-phrase-20      as character no-undo .
     1826   define variable  where-phrase-rus-20 as character no-undo .
     1827   define variable  sort-phrase-rus-20  as character no-undo .
     1828     run waitfram-show in this-procedure
     1829       (input "ЖДИТЕ ..."
     1830       ).
