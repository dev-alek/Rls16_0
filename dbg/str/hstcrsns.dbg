     1055          buf_c-trn-reason-host.ext-doc-type :read-only          in browse br-rsn-hosts = yes
     1056          buf_changes.l_name :read-only          in browse   br-changes   = yes.
     1057   assign b-mark    :tooltip in frame fr-reason-host = "Поставить/снять отметку записи"
