        1   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
        2   DEFINE TEMP-TABLE x_parts NO-UNDO LIKE  ub.parts.
        3   define input  parameter parparentproc as widget-handle no-undo.
        4   define input  parameter p-handle      as handle no-undo .
        5   define output parameter table for x_parts .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Связывание ФиБ серий из Excel и БД".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define variable c-point  as character no-undo .
      118   define variable tbl      as character no-undo .
      119   define variable join-tbl as character no-undo .
      120   define variable fld      as character no-undo .
      121   define variable lab      as character no-undo .
      122   define variable spr      as character no-undo .
      123   define variable dim      as character no-undo .
      124   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure fltfield-clear :
      126     define output parameter loc-fld as character no-undo.
      127     define output parameter loc-lab as character no-undo .
      128     define output parameter loc-spr as character no-undo .
      129     define output parameter loc-dim as character no-undo .
      130     assign
      131       loc-fld = ""
      132       loc-lab = ""
      133       loc-spr = ""
      134       loc-dim = "0"
      135     .
      136   end procedure .
      137   procedure fltfield-add :
      138     define input        parameter par-fld as character no-undo.
      139     define input        parameter par-lab as character no-undo .
      140     define input        parameter par-spr as character no-undo .
      141     define input-output parameter loc-fld as character no-undo.
      142     define input-output parameter loc-lab as character no-undo .
      143     define input-output parameter loc-spr as character no-undo .
      144     define input-output parameter loc-dim as character no-undo .
      145     do
      146     on error undo, return error
      147     :
      148       assign
      149       loc-fld = if loc-dim = '0'
      150                 then par-fld
      151                 else (loc-fld + chr(44) + par-fld)
      152       loc-lab = if loc-dim = '0'
      153                 then par-lab
      154                 else (loc-lab + chr(44) + par-lab)
      155       loc-spr = if loc-dim = '0'
      156                 then par-spr
      157                 else (loc-spr + chr(44) + par-spr)
      158       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      159                 string(integer(if num-entries(loc-dim) > 1
      160                               then entry(2, loc-dim)
      161                               else entry(1, loc-dim)
      162                               ) + 1)
      163       no-error
      164       .
      165     end.
      166   end procedure.
      167   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      169   procedure fltopend_fltopend :
      170   define input parameter p-parent-handle as handle no-undo .
      171   define input parameter p-qh as handle no-undo .
      172   define input parameter p-flt-open-open-query  as character no-undo .
      173   define input parameter p-where-cond as character no-undo .
      174   define input parameter p-use-indFIRST-query-tail as character no-undo .
      175   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      176   define input parameter p-indexed-reposition as character no-undo .
      177     do
      178     on error undo, return error
      179     :
      180   define variable v-prepare-string as character no-undo .
      181   define variable glog as logical no-undo .
      182   assign
      183   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      184                      p-where-cond + chr(32)  +
      185                      p-use-indFIRST-query-tail + chr(32) +
      186                      p-use-ind-sort-clmn-by + chr(32) +
      187                      p-indexed-reposition
      188   .
      189   assign
      190   glog = p-qh:query-prepare(v-prepare-string) no-error .
      191   if not glog
      192   or error-status:error then do:
      193     message error-status:get-message(1) view-as alert-box .
      194     undo, return error .
      195   end.
      196   assign
      197   glog = p-qh:query-open no-error .
      198   if not glog
      199   or error-status:error then do:
      200     message error-status:get-message(1) view-as alert-box .
      201     undo, return error .
      202   end.
      203     end.
      204   end procedure.
      205   procedure fltopend_fltfindd :
      206   define input parameter p-parent-handle as handle no-undo .
      207   define input parameter p-qh as handle no-undo .
      208   define input parameter p-rowid as rowid no-undo .
      209   define input parameter p-next as logical no-undo .
      210   define input parameter p-lock as integer no-undo .
      211   define input parameter p-bh as handle no-undo .
      212   define input parameter p-where-cond as character no-undo .
      213   define input parameter p-use-index-phrase as character no-undo .
      214   define variable glog as logical no-undo .
      215   define variable v-qh as handle no-undo .
      216   define variable v-bh as handle no-undo .
      217   define variable v-recid as recid no-undo .
      218   define variable v-prepare-string as character no-undo .
      219   do
      220   on error undo, return error
      221   on stop undo, return error
      222   :
      223     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      224     create buffer v-bh for table p-bh buffer-name p-bh:name.
      225     create query v-qh.
      226     v-qh:set-buffers(v-bh).
      227     v-prepare-string = substitute("for each &1 &2 &3"
      228                                     ,v-bh:name
      229                                     ,p-where-cond
      230                                     ,p-use-index-phrase).
      231     glog = v-qh:query-prepare(v-prepare-string) no-error.
      232     if not glog then do:
      233       delete object v-qh.
      234       delete object v-bh.
      235       undo, return error .
      236     end.
      237     glog = v-qh:query-open no-error .
      238     if not glog then do:
      239       delete object v-qh.
      240       delete object v-bh.
      241       undo, return error .
      242     end.
      243     if p-next then do:
      244       v-qh:reposition-to-rowid(p-rowid) no-error .
      245       glog = v-qh:get-next( p-lock) no-error .
      246       glog = v-qh:get-next( p-lock) no-error .
      247       if not glog or v-qh:query-off-end = yes then do:
      248         glog = v-qh:get-first( p-lock) no-error .
      249       end.
      250     end.
      251     else do:
      252       glog = v-qh:get-first( p-lock) no-error .
      253     end.
      254     v-recid = v-bh:recid no-error .
      255     delete object v-qh.
      256     delete object v-bh.
      257     return string(v-recid) .
      258   end.
      259   end procedure.
      260   procedure fltopend_fltfindq :
      261   define input parameter p-parent-handle as handle no-undo .
      262   define input parameter p-qh as handle no-undo .
      263   define input parameter p-next as logical no-undo .
      264   define input parameter p-lock as integer no-undo .
      265   define input parameter p-flt-open-open-query  as character no-undo .
      266   define input parameter p-where-cond as character no-undo .
      267   define input parameter p-use-indFIRST-query-tail as character no-undo .
      268   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      269   define input parameter p-indexed-reposition as character no-undo .
      270   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      271   define variable glog as logical no-undo .
      272   define variable v-qh as handle no-undo .
      273   define variable v-bh as handle no-undo extent 18.
      274   define variable v-rowid as rowid no-undo extent 18.
      275   define variable v-ii as integer no-undo .
      276   define variable v-prepare-string as character no-undo .
      277   do
      278   on error undo, return error
      279   on stop undo, return error
      280   :
      281     create query v-qh.
      282     do v-ii = 1 to p-qh:num-buffers:
      283       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      284       assign
      285       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      286       no-error.
      287       v-qh:add-buffer(v-bh[v-ii]).
      288     end.
      289     assign
      290     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      291                       p-where-cond + chr(32)  +
      292                       p-use-indFIRST-query-tail + chr(32) +
      293                       p-use-ind-sort-clmn-by + chr(32) +
      294                       p-indexed-reposition
      295     .
      296     glog = v-qh:query-prepare( v-prepare-string) no-error .
      297     if not glog then do:
      298       delete object v-qh.
      299       do v-ii = 1 to p-qh:num-buffers:
      300         delete object v-bh[v-ii].
      301       end.
      302       undo, return error .
      303     end.
      304     glog = v-qh:query-open no-error .
      305     if not glog then do:
      306       delete object v-qh.
      307       do v-ii = 1 to p-qh:num-buffers:
      308         delete object v-bh[v-ii].
      309       end.
      310       undo, return error .
      311     end.
      312     if p-next then do:
      313       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      314       glog = v-qh:get-next( p-lock) no-error .
      315       glog = v-qh:get-next( p-lock) no-error .
      316       if not glog or v-qh:query-off-end = yes then do:
      317         glog = v-qh:get-first( p-lock) no-error .
      318       end.
      319     end.
      320     else do:
      321       glog = v-qh:get-first( p-lock) no-error .
      322     end.
      323     do v-ii = 1 to p-qh:num-buffers:
      324       assign
      325       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      326       no-error.
      327     end.
      328     delete object v-qh.
      329     do v-ii = 1 to p-qh:num-buffers:
      330       delete object v-bh[v-ii].
      331     end.
      332   end.
      333   end procedure.
      334   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   define variable v-waitfram-action01         as character   no-undo .
      336   define variable v-waitfram-action02         as character   no-undo .
      337   define variable v-waitfram-action03         as character   no-undo .
      338   define variable mWaitFramTextBeg            as character   no-undo.
      339   define variable mWaitFramTextEnd            as character   no-undo.
      340   define variable mWaitFramView               as logical     no-undo.
      341   define variable mWaitProcEvent              as logical     no-undo init yes.
      342   define variable mWaitFramInterval           as integer     no-undo init 1 .
      343   define variable mWaitFramStop               as logical     no-undo.
      344   define variable mWaitFramStopUser           as logical     no-undo.
      345   define variable mWaitFramStopTimeOut        as logical     no-undo.
      346   define variable mWaitFramStartProc          as datetime-tz no-undo.
      347   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      348   define button B-WaitFramStop auto-end-key
      349        label "Стоп"
      350        size 10 by 1 tooltip "Остоновить процесс".
      351   define button B-viewProcInfo
      352        label "Информация"
      353        size 15 by 1 tooltip "Информация о процесс".
      354   define frame waitfram
      355     v-waitfram-action01 format "x(72)" no-label skip
      356     v-waitfram-action02 format "x(72)" no-label skip
      357     v-waitfram-action03 format "x(72)" no-label skip
      358     B-viewProcInfo
      359     B-WaitFramStop at row 4 col 30
      360     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      361     .
      362   define new global shared variable mBatchMode as logical no-undo init ?.
      363   define variable mFramBachModHandle as handle no-undo.
      364   mFramBachModHandle = frame waitfram:handle.
      365   define variable mFameOldVis as logical no-undo.
      366   define variable mVisCUrentVin as logical no-undo.
      367   if session:batch-mode
      368   then
      369      mBatchMode = yes.
      370   if mBatchMode = ? then do:
      371     mVisCUrentVin = current-window:visible.
      372     mFameOldVis = mFramBachModHandle:visible.
      373     mFramBachModHandle:visible  = yes.
      374     mBatchMode = mFramBachModHandle:visible ne yes.
      375     mFramBachModHandle:visible = mFameOldVis.
      376     current-window:visible = mVisCUrentVin.
      377   end.
      378    if  log-manager:logfile-name ne ?
      379     then DO:
      380         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      381         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      382         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      383     end.
      384   on choose of B-WaitFramStop in frame waitfram
      385   do:
      386     mWaitFramStop = yes.
      387     mWaitFramStopUser = yes.
      388   end.
      389   function waitfram-check-timeout returns logical():
      390      define variable vtime as int64 no-undo.
      391      if mWaitFramStopTimeOut
      392      then
      393         return yes.
      394      vtime = ( now - mWaitFramStartProc ) / 1000 .
      395      if     mWaitFramTimeOut ne ?
      396         and mWaitFramTimeOut ne 0
      397         and mWaitFramTimeOut lt vtime
      398      then do:
      399         mWaitFramStopTimeOut = yes.
      400      end.
      401      return mWaitFramStopTimeOut.
      402   end.
      403   procedure waitfram-hide :
      404     if not session:batch-mode
      405     then do
      406     on error undo, return error return-value
      407     :
      408       pause 0 before-hide .
      409       if not mBatchMode then
      410         hide frame waitfram .
      411     if     not mWaitFramView
      412        and mWaitProcEvent
      413     then
      414       process events .
      415     end.
      416   end procedure.
      417   procedure waitfram-show :
      418     define input  parameter p-message as character no-undo .
      419     define variable v-left-margin as integer   no-undo .
      420     if not session:batch-mode
      421     then do
      422     on error undo, return error return-value
      423     :
      424       if length(p-message) <= 70 then do:
      425         assign
      426           v-left-margin = integer((70 - length(p-message)) / 2)
      427         .
      428         assign
      429           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      430         .
      431         assign
      432           v-waitfram-action01 = " "
      433           v-waitfram-action02 = " "
      434                                    + fill(" ", v-left-margin)
      435                                    + p-message
      436           v-waitfram-action03 = " "
      437         .
      438       end.
      439       else do:
      440         define variable vRindex1 as integer no-undo.
      441         define variable vRindex2 as integer no-undo.
      442         vRindex1 = r-index(p-message," ",70).
      443         if vRindex1 = 0
      444         then
      445            vRindex1 = 70.
      446         if length(p-message)  <= vRindex1 + 70 then do:
      447           assign
      448             v-waitfram-action01 = " "
      449             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      450             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      451           .
      452         end.
      453         else do:
      454           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      455           if vRindex2 <= vRindex1
      456           then
      457              vRindex2 = vRindex1 + 70.
      458           assign
      459             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      460             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      461             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      462           .
      463         end.
      464       end.
      465       B-viewProcInfo:visible   in frame waitfram = no.
      466       B-viewProcInfo:sensitive in frame waitfram = no.
      467       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      468       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      469       if  (   mWaitFramView
      470          or  mWaitProcEvent)
      471          and not mBatchMode
      472       then
      473          display
      474             v-waitfram-action01 skip
      475             v-waitfram-action02 skip
      476             v-waitfram-action03 skip
      477          with frame waitfram .
      478       if     mWaitFramView
      479          then do:
      480             if     mWaitFramInterval ne ?
      481                and not mBatchMode
      482             then
      483                wait-for go of frame waitfram pause mWaitFramInterval.
      484          end.
      485          else
      486             if     mWaitProcEvent
      487                and not mBatchMode
      488             then
      489                process events .
      490     end.
      491   end procedure.
      492      procedure waitfram-show-this:
      493         define input  parameter iInterval as int64 no-undo.
      494         define variable vtime as int64 no-undo.
      495         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      496         mWaitFramInterval = iInterval.
      497         run waitfram-show (substitute("&1&2 &3&4" ,
      498                                       mWaitFramTextBeg ,
      499                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      500                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      501                                       mWaitFramTextEnd
      502                                      )
      503                           ).
      504      end.
      505      procedure WaitFramRunPause:
      506         define input  parameter iInterval as dec no-undo.
      507         define variable vStart  as datetime-tz no-undo.
      508         define variable vend    as datetime-tz no-undo.
      509         define variable vint as int64 no-undo.
      510         define variable vOk as logical no-undo.
      511         vStart = now.
      512         vend   = vStart.
      513         publish "WaitFramPause" (iInterval,output vOk).
      514         vend   =  now.
      515         vint = vend - vStart.
      516         vint = iInterval - vint / 1000.
      517         if     not mWaitFramStop
      518            and (   vint > 0
      519                 or (    not vOk
      520                     and iInterval eq ?
      521                     )
      522                 )
      523         then
      524            run waitfram-show-this (iInterval).
      525         vend   =  now.
      526         vint = vend - vStart.
      527         vint = iInterval - vint / 1000.
      528         if     not mWaitFramStop
      529            and vint > 0
      530         then do:
      531            run gbl/pause.p (vint * 1000).
      532         end.
      533         if iInterval ne ?
      534         then
      535            publish "WaitFramStop".
      536         waitfram-check-timeout().
      537      end.
      538      procedure WaitFramWaitFor:
      539         define input  parameter iInterval as dec no-undo.
      540         assign
      541            mWaitFramStartProc   = now
      542            mWaitFramStopUser    = no
      543            mWaitFramStopTimeOut = no
      544         .
      545         block-wait:
      546         do while not mWaitFramStop:
      547            run WaitFramRunPause (iInterval).
      548            if  waitfram-check-timeout()
      549            then do:
      550               leave block-wait.
      551            end.
      552         end.
      553         run waitfram-hide.
      554      end.
      555   procedure waitfram-join :
      556     define input  parameter p-line-1  as character no-undo .
      557     define input  parameter p-line-2  as character no-undo .
      558     define input  parameter p-line-3  as character no-undo .
      559     define output parameter p-message as character no-undo .
      560     do
      561     on error undo, return error return-value
      562     :
      563       assign
      564         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      565                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      566                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      567       .
      568     end.
      569   end procedure.
      570   function waitfram-join-function returns character
      571     (input p-line-1 as character
      572     ,input p-line-2 as character
      573     ,input p-line-3 as character
      574     ).
      575     define variable v-message as character no-undo .
      576     run waitfram-join in this-procedure
      577       (input  p-line-1
      578       ,input  p-line-2
      579       ,input  p-line-3
      580       ,output v-message
      581       ) .
      582     return v-message .
      583   end function .
      584   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      585   procedure gen-key-rec :
      586     define input  parameter p-tbl-name    as character no-undo.
      587     define input  parameter p-bh_tbl-name as handle    no-undo.
      588     define output parameter p-key-rec     as character no-undo.
      589     do
      590     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      591     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      592     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      593     :
      594       define variable fh               as handle    no-undo .
      595       define variable v-ok             as logical   no-undo .
      596       define variable v-inform         as character no-undo .
      597       define variable v-ind            as integer   no-undo .
      598       define variable v-idx-field-qnty as integer   no-undo .
      599       if p-tbl-name = ?
      600         or p-tbl-name = "":U
      601       then do:
      602         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      603       end.
      604       if not p-bh_tbl-name:available then do:
      605         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      606       end.
      607       assign
      608         p-key-rec = p-tbl-name
      609         v-inform  = p-bh_tbl-name:index-information(1)
      610         v-ind     = 2
      611       .
      612       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      613       on error undo, return error
      614       :
      615         assign
      616           v-inform = p-bh_tbl-name:index-information( v-ind )
      617           v-ind    = v-ind + 1
      618         .
      619       end.
      620       if v-inform = ?
      621         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      622         or entry( 3, v-inform, ",":U ) <> "1":U
      623       then do:
      624         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      625       end.
      626       else do:
      627         assign
      628           v-idx-field-qnty = num-entries( v-inform ) - 4
      629         .
      630         if v-idx-field-qnty < 2 then do:
      631           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      632         end.
      633         do v-ind = 1 to v-idx-field-qnty by 2
      634         on error undo, return error
      635         :
      636           assign
      637             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      638             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      639           .
      640         end.
      641       end.
      642       if p-key-rec = ? then do:
      643         assign
      644           p-key-rec = "":U
      645         .
      646         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      647       end.
      648     end.
      649     return.
      650   end procedure.
      651   procedure gen-where-keyr-tab :
      652     define input  parameter i-tableSerach as character no-undo.
      653     define input  parameter i-tablekey   as character  no-undo.
      654     define input  parameter p-key-rec    as character  no-undo.
      655     define input  parameter p-key-handle as handle     no-undo .
      656     define input  parameter p-db-name    as character  no-undo .
      657     define input  parameter p-tt-handle  as handle     no-undo .
      658     define output parameter o-Where      as character  no-undo.
      659     do
      660     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      661     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      662     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      663     :
      664       define variable v-full-tbl-name  as character no-undo .
      665       define variable bh_tbl-name      as handle    no-undo .
      666       define variable fh_key           as handle    no-undo .
      667       define variable fh_search        as handle    no-undo .
      668       define variable v-field-num      as integer   no-undo .
      669       define variable v-count-fld      as integer   no-undo .
      670       define variable v-inform         as character no-undo .
      671       define variable v-ind            as integer   no-undo .
      672       define variable v-idx-field-qnty as integer   no-undo .
      673       define variable v-field-name     as character no-undo .
      674       define variable v-field-val      as character no-undo .
      675       define variable v-word-link      as character no-undo .
      676       define variable vTable           as character no-undo.
      677       define variable bh_tbl-key       as handle    no-undo .
      678       assign
      679         p-key-rec = trim( p-key-rec )
      680       .
      681       if p-key-handle <> ? then do:
      682         if not valid-handle(p-key-handle)
      683            or p-key-handle:type <> "buffer"
      684         then do:
      685           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      686         end.
      687         if num-entries( p-key-rec, chr(3) ) > 1
      688           or p-key-rec = ?
      689           or p-key-rec = "":U
      690         then do:
      691           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      692         end.
      693       end.
      694       else do:
      695         if p-key-rec = ?
      696           or p-key-rec = "":U
      697         then do:
      698           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      699         end.
      700       end.
      701       assign
      702         vTable = entry( 1 , p-key-rec, chr(3) )
      703       .
      704       if p-tt-handle <> ?
      705         and ( not valid-handle(p-tt-handle)
      706               or p-tt-handle:type <> "buffer"
      707             )
      708       then do:
      709         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      710       end.
      711       if p-tt-handle = ? then do:
      712         assign
      713           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      714         .
      715         create buffer bh_tbl-name for table v-full-tbl-name .
      716       end.
      717       else do:
      718         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      719       end.
      720       assign
      721         v-inform = bh_tbl-name:index-information(1)
      722         v-ind    = 2
      723       .
      724       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      725       on error undo, return error
      726       :
      727         assign
      728           v-inform = bh_tbl-name:index-information( v-ind )
      729           v-ind    = v-ind + 1
      730         .
      731       end.
      732       if v-inform = ?
      733         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      734         or entry( 3, v-inform, ",":U ) <> "1":U
      735       then do:
      736         delete object bh_tbl-name no-error.
      737         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      738       end.
      739       assign
      740         v-idx-field-qnty = num-entries( v-inform ) - 4
      741       .
      742       if v-idx-field-qnty < 2 then do:
      743         delete object bh_tbl-name no-error.
      744         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      745       end.
      746       assign
      747         o-where     = "where":U
      748         v-word-link = "":U
      749         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      750         v-count-fld = 0
      751       .
      752       if i-tablekey ne "" and i-tablekey ne ?
      753       then do:
      754         assign
      755           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      756         .
      757         create buffer bh_tbl-key for table v-full-tbl-name .
      758       end.
      759       if i-tableSerach ne "" and i-tableSerach ne ?
      760       then do:
      761         delete object bh_tbl-name no-error.
      762         assign
      763           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      764         .
      765         create buffer bh_tbl-name for table v-full-tbl-name .
      766       end.
      767       block_where:
      768       do v-ind = 1 to v-idx-field-qnty by 2
      769       on error undo, return error
      770       :
      771         assign
      772           v-count-fld = v-count-fld + 1
      773         .
      774         if p-key-handle = ?
      775           and v-count-fld > v-field-num
      776         then do:
      777           leave block_where.
      778         end.
      779         define variable VfieldKeyTable as handle no-undo.
      780         assign
      781           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      782           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      783         .
      784         if     bh_tbl-key ne ?
      785         then do:
      786            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      787            if VfieldKeyTable eq ?
      788            then next block_where.
      789         end.
      790         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      791         then
      792            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      793         else
      794            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      795         if p-key-handle = ? then do:
      796           assign
      797             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      798           .
      799         end.
      800         else do:
      801           assign
      802             fh_key = p-key-handle:buffer-field( v-field-name )
      803           .
      804           if fh_key = ?
      805             or not valid-handle( fh_key )
      806           then do:
      807             delete object bh_tbl-name.
      808             if     bh_tbl-key ne ?
      809             then
      810                delete object bh_tbl-key.
      811             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      812           end.
      813           assign
      814             v-field-val = fh_key:buffer-value
      815           .
      816         end.
      817         if fh_search:data-type ="character":U then do:
      818           assign
      819             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      820             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      821             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      822             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      823             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      824             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      825             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      826             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      827             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      828             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      829             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      830             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      831             v-field-val = substitute( '"&1"', v-field-val )
      832           .
      833         end.
      834         assign
      835           o-where = substitute( "&1 &2", o-where, v-field-val )
      836         .
      837         if v-word-link = "":U then do:
      838           assign
      839             v-word-link = "and":U
      840           .
      841         end.
      842       end.
      843       delete object bh_tbl-name.
      844       if     bh_tbl-key ne ?
      845       then
      846          delete object bh_tbl-key.
      847       if p-key-handle = ?
      848         and v-count-fld <> v-field-num
      849       then do:
      850         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      851       end.
      852     end.
      853   end procedure.
      854   procedure gen-hn-keyr-tab :
      855     define input  parameter i-tableSerach as character no-undo.
      856     define input  parameter i-tablekey   as character no-undo.
      857     define input  parameter p-key-rec    as character no-undo.
      858     define input  parameter p-key-handle as handle    no-undo .
      859     define input  parameter p-db-name    as character no-undo .
      860     define input  parameter p-tt-handle  as handle    no-undo .
      861     define input  parameter p-stts-lock  as integer   no-undo .
      862     define output parameter o-hn         as handle    no-undo.
      863     define variable v-full-tbl-name as character no-undo.
      864     define variable v-where         as character no-undo.
      865     define variable bh_tbl-name     as handle    no-undo.
      866     define variable vTable          as character no-undo.
      867     do
      868     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      869     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      870     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      871         run gen-where-keyr-tab(i-tableSerach,
      872                                i-tablekey,
      873                                p-key-rec,
      874                                p-key-handle,
      875                                p-db-name,
      876                                p-tt-handle,
      877                                output v-where).
      878         if i-tableSerach ne "" and i-tableSerach ne ?
      879         then do:
      880            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      881            create buffer bh_tbl-name for table v-full-tbl-name .
      882         end.
      883         else do:
      884            if p-tt-handle = ? then do:
      885               assign
      886                  vTable = entry( 1 , p-key-rec, chr(3) )
      887               .
      888               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      889               create buffer bh_tbl-name for table v-full-tbl-name .
      890            end.
      891            else do:
      892               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      893            end.
      894         end.
      895         if p-tt-handle = ? then do:
      896            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      897         end.
      898         else do:
      899            bh_tbl-name:find-first( v-where ) no-error .
      900         end.
      901         o-hn = bh_tbl-name.
      902      end.
      903   end procedure.
      904   procedure gen-hn-keyr :
      905     define input  parameter p-key-rec    as character no-undo.
      906     define input  parameter p-key-handle as handle    no-undo .
      907     define input  parameter p-db-name    as character no-undo .
      908     define input  parameter p-tt-handle  as handle    no-undo .
      909     define input  parameter p-stts-lock  as integer   no-undo .
      910     define output parameter o-hn         as handle    no-undo.
      911     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      912   end.
      913   procedure gen-row-keyr :
      914     define input  parameter p-key-rec    as character no-undo.
      915     define input  parameter p-key-handle as handle    no-undo .
      916     define input  parameter p-db-name    as character no-undo .
      917     define input  parameter p-tt-handle  as handle    no-undo .
      918     define input  parameter p-stts-lock  as integer   no-undo .
      919     define output parameter p-tbl-row    as rowid     no-undo.
      920     define output parameter p-tbl-name   as character no-undo.
      921     define variable vHn as handle no-undo.
      922       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      923       p-tbl-row = if vHn:available then vHn:rowid else ?.
      924       p-tbl-name =  vHn:table.
      925       delete object vHn no-error.
      926     if p-tbl-row = ? then do:
      927       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      928     end.
      929     else do:
      930       return.
      931     end.
      932   end procedure.
      933   procedure gen-key-fv :
      934     define input  parameter p-key-rec    as character no-undo .
      935     define output parameter p-field-list as character no-undo .
      936     define output parameter p-value-list as character no-undo.
      937     do
      938     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      939     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      940     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      941     :
      942       define variable v-full-tbl-name  as character no-undo .
      943       define variable bh_tbl-name      as handle    no-undo .
      944       define variable v-tbl-name       as character no-undo .
      945       define variable v-field-num      as integer   no-undo .
      946       define variable v-count-fld      as integer   no-undo .
      947       define variable v-inform         as character no-undo .
      948       define variable v-ind            as integer   no-undo .
      949       define variable v-idx-field-qnty as integer   no-undo .
      950       define variable v-delim-key      as character no-undo .
      951       if p-key-rec = ?
      952         or p-key-rec = "":U
      953       then do:
      954         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      955       end.
      956       assign
      957         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      958         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      959       .
      960       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      961       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      962       assign
      963         v-inform = bh_tbl-name:index-information(1)
      964         v-ind    = 2
      965       .
      966       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      967       on error undo, return error
      968       :
      969         assign
      970           v-inform = bh_tbl-name:index-information( v-ind )
      971           v-ind    = v-ind + 1
      972         .
      973       end.
      974       if v-inform = ?
      975         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      976         or entry( 3, v-inform, ",":U ) <> "1":U
      977       then do:
      978         delete object bh_tbl-name no-error.
      979         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      980       end.
      981       assign
      982         v-idx-field-qnty = num-entries( v-inform ) - 4
      983       .
      984       if v-idx-field-qnty < 2 then do:
      985         delete object bh_tbl-name no-error.
      986         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      987       end.
      988       assign
      989         p-field-list = "":U
      990         p-value-list = "":U
      991         v-delim-key  = "":U
      992         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      993         v-count-fld  = 0
      994       .
      995       block_where:
      996       do v-ind = 1 to v-idx-field-qnty by 2
      997       on error undo, return error
      998       :
      999         assign
     1000           v-count-fld = v-count-fld + 1
     1001         .
     1002         if v-count-fld > v-field-num then do:
     1003           leave block_where.
     1004         end.
     1005         assign
     1006           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1007           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1008         .
     1009         if v-ind = 1 then do:
     1010           assign
     1011             v-delim-key = chr(3)
     1012           .
     1013         end.
     1014       end.
     1015       delete object bh_tbl-name.
     1016       if v-count-fld <> v-field-num then do:
     1017         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     1018       end.
     1019     end.
     1020   end procedure.
     1021   procedure gen-key-field :
     1022     define input  parameter p-table      as character no-undo .
     1023     define output parameter p-field-list as character no-undo .
     1024     do
     1025     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1026     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1027     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1028     :
     1029       define variable v-full-tbl-name  as character no-undo .
     1030       define variable bh_tbl-name      as handle    no-undo .
     1031       define variable v-tbl-name       as character no-undo .
     1032       define variable v-field-num      as integer   no-undo .
     1033       define variable v-count-fld      as integer   no-undo .
     1034       define variable v-inform         as character no-undo .
     1035       define variable v-ind            as integer   no-undo .
     1036       define variable v-idx-field-qnty as integer   no-undo .
     1037       define variable v-delim-key      as character no-undo .
     1038       if p-table = ?
     1039         or p-table = "":U
     1040       then do:
     1041         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     1042       end.
     1043       assign
     1044         v-tbl-name      = p-table
     1045         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1046       .
     1047       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1048       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     1049       assign
     1050         v-inform = bh_tbl-name:index-information(1)
     1051         v-ind    = 2
     1052       .
     1053       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1054       on error undo, return error
     1055       :
     1056         assign
     1057           v-inform = bh_tbl-name:index-information( v-ind )
     1058           v-ind    = v-ind + 1
     1059         .
     1060       end.
     1061       if v-inform = ?
     1062         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1063         or entry( 3, v-inform, ",":U ) <> "1":U
     1064       then do:
     1065         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1066       end.
     1067       assign
     1068         v-idx-field-qnty = num-entries( v-inform ) - 4
     1069       .
     1070       if v-idx-field-qnty < 2 then do:
     1071         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1072       end.
     1073       assign
     1074         p-field-list = "":U
     1075         v-delim-key  = "":U
     1076         v-count-fld  = 0
     1077       .
     1078       block_where:
     1079       do v-ind = 1 to v-idx-field-qnty by 2
     1080       on error undo, return error
     1081       :
     1082         assign
     1083           v-count-fld = v-count-fld + 1
     1084         .
     1085         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1086         if v-ind = 1 then do:
     1087           assign
     1088             v-delim-key = chr(3)
     1089           .
     1090         end.
     1091       end.
     1092       delete object bh_tbl-name.
     1093     end.
     1094   end procedure.
     1095   define new shared variable chexcelapplication      as com-handle no-undo .
     1096   define new shared variable chworkbook              as com-handle no-undo .
     1097   define new shared variable chworksheet             as com-handle no-undo .
     1098   define new shared variable chrange                 as com-handle no-undo .
     1099   define variable filter-point as character no-undo init "Сведение товаров ФиБ и товаров в БД" .
     1100   define variable filter-point0 as character no-undo init "Сведение товаров ФиБ и товаров в БД" .
     1101   define variable sort-column-name as character no-undo .
     1102   define variable g-log as logical   no-undo .
     1103   define variable gds-rec as recid no-undo .
     1104   define variable v-gds-code as character no-undo .
     1105   define variable v-gds-name as character no-undo .
     1106   function f-gds-code returns char
     1107   ( input p-rec as recid  ) .
     1108   def buffer e-c for ub.ext-classif .
     1109   find first e-c no-lock where recid(e-c) = p-rec no-error . if error-status :error then return '' .
     1110   define buffer goo for ub.goods.
     1111   find first goo no-lock where goo.gds-code = integer(entry(2,e-c.uniq-key-rec, chr(3)))  no-error .
     1112   if avail goo then do:
     1113     return trim(string(goo.gds-code)).
     1114   end.
     1115   else return '' .
     1116   end function.
     1117   function f-gds-name returns char
     1118   ( input p-rec as recid  ) .
     1119   def buffer e-c for ub.ext-classif .
     1120   find first e-c no-lock where recid(e-c) = p-rec no-error . if error-status :error then return '' .
     1121   define buffer goo for ub.goods.
     1122   find first goo no-lock where goo.gds-code = integer(entry(2,e-c.uniq-key-rec, chr(3)))  no-error .
     1123   if avail goo then do:
     1124     return trim(goo.gds-name) .
     1125   end.
     1126   else return '' .
     1127   end function.
     1128   DEFINE BUTTON B-Cancel AUTO-END-KEY
     1129        LABEL "Отмена"
     1130        SIZE 10 BY 1 TOOLTIP "Выход без изменения состояния БД"
     1131        BGCOLOR 8 .
     1132   DEFINE BUTTON B-charm
     1133        IMAGE-UP FILE "cmp/b-wizard.bmp":U
     1134        LABEL ""
     1135        SIZE 3 BY 1 TOOLTIP "Авто подбор товарв в БД по совпадению в названии".
     1136   DEFINE BUTTON B-delete-all
     1137        IMAGE-UP FILE "cmp/cross.bmp":U
     1138        LABEL ""
     1139        SIZE 3 BY 1 TOOLTIP "все удалить".
     1140   DEFINE BUTTON B-Help
     1141        LABEL "&Help"
     1142        SIZE 3 BY 1
     1143        BGCOLOR 8 .
     1144   DEFINE BUTTON B-import
     1145        LABEL "Импорт"
     1146        SIZE 10 BY 1 TOOLTIP "Импорт из файла Excel ФиБ товаров".
     1147   DEFINE BUTTON B-norel
     1148        LABEL "Развязать"
     1149        SIZE 10 BY 1 TOOLTIP "Развязать товары Excel с товарами из БД TradeHouse".
     1150   DEFINE BUTTON B-OK AUTO-GO
     1151        LABEL "Ввод"
     1152        SIZE 10 BY 1 TOOLTIP "Выйти и занести ФИБ в БД"
     1153        BGCOLOR 8 .
     1154   DEFINE BUTTON B-rel
     1155        LABEL "Связать"
     1156        SIZE 10 BY 1 TOOLTIP "Связать товары Excel с товарами из БД TradeHouse".
     1157   DEFINE VARIABLE v-name AS CHARACTER
     1158        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1159        SIZE 96.5 BY 2.75 TOOLTIP "Описание товара в файле Excel"
     1160        FGCOLOR 4 FONT 2 NO-UNDO.
     1161   DEFINE VARIABLE v-name-th AS CHARACTER
     1162        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1163        SIZE 96.5 BY 1.5 TOOLTIP "Описание товара в БД TH"
     1164        FGCOLOR 1 FONT 2 NO-UNDO.
     1165   DEFINE VARIABLE f-name AS CHARACTER FORMAT "X(256)":U
     1166        VIEW-AS FILL-IN
     1167        SIZE 28.5 BY 1 TOOLTIP "Поиск по Фальсификантам" NO-UNDO.
     1168   DEFINE VARIABLE f-name-th AS CHARACTER FORMAT "X(256)":U
     1169        VIEW-AS FILL-IN
     1170        SIZE 37.5 BY 1 TOOLTIP "Поиск по БД TradeHouse" NO-UNDO.
     1171   DEFINE VARIABLE v-name-exel AS CHARACTER FORMAT "X(256)":U
     1172         VIEW-AS TEXT
     1173        SIZE 96.5 BY .67
     1174        FGCOLOR 4  NO-UNDO.
     1175   DEFINE VARIABLE R-find AS INTEGER
     1176        VIEW-AS RADIO-SET HORIZONTAL
     1177        RADIO-BUTTONS
     1178             "По Названию", 1,
     1179   "По Серии", 2
     1180        SIZE 29 BY 1
     1181        FGCOLOR 4  NO-UNDO.
     1182   DEFINE VARIABLE R-find-2 AS INTEGER
     1183        VIEW-AS RADIO-SET HORIZONTAL
     1184        RADIO-BUTTONS
     1185             "По коду товара в ТН", 3
     1186        SIZE 37 BY 1
     1187        FGCOLOR 1  NO-UNDO.
     1188   DEFINE QUERY BROWSE-ext-goods FOR
     1189         buf_ext-classif SCROLLING.
     1190   DEFINE BROWSE BROWSE-ext-goods
     1191     QUERY BROWSE-ext-goods NO-LOCK DISPLAY
     1192         buf_ext-classif.CharKey_One               COLUMN-LABEL 'Фальсификат!Серия' FORMAT "X(20)":U
     1193         buf_ext-classif.CharKey_Three               COLUMN-LABEL 'Название товара!из Excel' FORMAT "X(140)":U
     1194         f-gds-code(recid(buf_ext-classif))  @ v-gds-code COLUMN-LABEL 'Код Товара!в TH' FORMAT "X(16)":U
     1195         f-gds-name(recid(buf_ext-classif))  @ v-gds-name COLUMN-LABEL 'Название!в TH' FORMAT "X(40)":U
     1196         buf_ext-classif.whole-send-news               COLUMN-LABEL '§'
     1197         enable buf_ext-classif.CharKey_One
     1198       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.5 BY 13 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1199   DEFINE FRAME Dialog-Frame
     1200        B-OK AT ROW 1 COL 1
     1201        B-Cancel AT ROW 1 COL 11
     1202        B-import AT ROW 1 COL 26.13 WIDGET-ID 2
     1203        B-rel AT ROW 1 COL 36.25 WIDGET-ID 4
     1204        B-norel AT ROW 1 COL 46.38 WIDGET-ID 6
     1205        B-charm AT ROW 1 COL 56.5 WIDGET-ID 28
     1206        B-delete-all AT ROW 1 COL 59.5 WIDGET-ID 30
     1207        B-Help AT ROW 1 COL 95
     1208        R-find AT ROW 2 COL 1.5 NO-LABEL WIDGET-ID 12
     1209        R-find-2 AT ROW 2 COL 61 NO-LABEL WIDGET-ID 20
     1210        f-name AT ROW 2.96 COL 2.13 NO-LABEL WIDGET-ID 16
     1211        f-name-th AT ROW 2.96 COL 60.5 NO-LABEL WIDGET-ID 18
     1212        BROWSE-ext-goods AT ROW 4 COL 1.5 WIDGET-ID 200
     1213        v-name AT ROW 18 COL 1.5 NO-LABEL WIDGET-ID 24
     1214        v-name-th AT ROW 20.75 COL 1.5 NO-LABEL WIDGET-ID 10
     1215        v-name-exel AT ROW 17.13 COL 1.5 NO-LABEL WIDGET-ID 26
     1216        SPACE(0.37) SKIP(4.55)
     1217       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1218            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1219            TITLE "<insert dialog title>"
     1220            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
     1221   ASSIGN
     1222          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1223          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1224   ASSIGN
     1225          v-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1226   ASSIGN
     1227          v-name-th:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1228   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1229   DO:
     1230     APPLY "END-ERROR":U TO SELF.
     1231   END.
     1232   ON CHOOSE OF B-charm IN FRAME Dialog-Frame
     1233   DO:
     1234     run proc-charm .
     1235   END.
     1236   ON CHOOSE OF B-delete-all IN FRAME Dialog-Frame
     1237   DO:
     1238     run delete-all .
     1239   END.
     1240   ON CHOOSE OF B-import IN FRAME Dialog-Frame
     1241   DO:
     1242      define variable ff as character no-undo.
     1243      define variable var-name-sheet as character no-undo .
     1244      chworkbook = chexcelapplication:activeworkbook no-error.
     1245           define variable okpressed as logical initial true no-undo.
     1246           system-dialog get-file ff
     1247               title      "Выберите файл ..."
     1248               filters    "excel (*.xls)"   "*.xls"
     1249                           use-filename
     1250                           must-exist
     1251                           update okpressed.
     1252                           if okpressed = true then
     1253                              do:
     1254                                 run ex-file in this-procedure   (ff, false) .
     1255                              end.
     1256                           else do:
     1257                             return no-apply .
     1258                           end.
     1259      chworkbook   = chexcelapplication:activeworkbook no-error.
     1260      chworksheet  = chexcelapplication:sheets:item(1):select  no-error.
     1261      chworksheet  = chexcelapplication:sheets:item(1) no-error.
     1262     run import-proc in this-procedure  no-error .
     1263     if error-status :error then message
     1264       vss-workfile vss-revision vss-description skip
     1265       error-status :get-message(1) skip
     1266       return-value skip
     1267       "import-proc"
     1268       view-as alert-box error
     1269     .
     1270     RELEASE OBJECT chWorksheet NO-ERROR.
     1271     RELEASE OBJECT chWorkbook NO-ERROR.
     1272     chExcelApplication :QUIT().
     1273     RELEASE OBJECT  chExcelApplication  NO-ERROR.
     1274     run openbr in this-procedure (yes, no, '':U).
     1275   END.
     1276   ON CHOOSE OF B-norel IN FRAME Dialog-Frame
     1277   DO:
     1278     if available buf_ext-classif then do:
     1279         find current buf_ext-classif exclusive-lock.
     1280         buf_ext-classif.uniq-key-rec = "".
     1281         buf_ext-classif.whole-send-news = 0.
     1282         g-log =  BROWSE-ext-goods:refresh() .
     1283         apply "VALUE-CHANGED" TO BROWSE-ext-goods IN FRAME Dialog-Frame .
     1284     end.
     1285   END.
     1286   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
     1287   DO:
     1288   define buffer buf_parts for ub.parts  .
     1289   define buffer buf_goods for ub.goods  .
     1290   run waitfram-show in this-procedure ("Поиск ФиБ в БД...")   .
     1291     for each buf_ext-classif no-lock where
     1292           buf_ext-classif.uniq-key-rec <> "" and
     1293           Buf_ext-classif.classif-subject = 'goods':U  AND
     1294           Buf_ext-classif.classif-name    = 'goods_fib':U  :
     1295           find first buf_goods no-lock where buf_goods.gds-code = integer(entry(2,buf_ext-classif.uniq-key-rec, chr(3)))  no-error .
     1296           if error-status :error then next.
     1297           find first  buf_parts no-lock where
     1298                       buf_parts.artic      = buf_goods.artic     and
     1299                       buf_parts.prod-type  = buf_goods.prod-type and
     1300                       buf_parts.prod-code  = buf_goods.prod-code and
     1301                       buf_parts.part-code  = buf_ext-classif.CharKey_One no-error .
     1302          if available buf_parts then do:
     1303             create x_parts.
     1304             buffer-copy buf_parts to x_parts.
     1305          end.
     1306     end.
     1307   run waitfram-hide in this-procedure   .
     1308   END.
     1309   ON CHOOSE OF B-rel IN FRAME Dialog-Frame
     1310   DO:
     1311   define variable v-uniq-key-rec as character no-undo .
     1312   define variable v-rid-list as character no-undo .
     1313   define buffer buf_goods for ub.goods  .
     1314     if available buf_ext-classif then do:
     1315     find current buf_ext-classif exclusive-lock.
     1316       run ref/gds-ref.p ( input parparentproc
     1317                         , input "b-sel"
     1318                         , input 'текущие':U
     1319                         , input 'все':U
     1320                         , input ?
     1321                         , input ?
     1322                         , input ?
     1323                         , input ?
     1324                         , input ?
     1325                         , input ?
     1326                         , input ?
     1327                         , input ?
     1328                         , output v-rid-list
     1329                         ) no-error.
     1330       if not error-status:error
     1331       and v-rid-list <> '' then do:
     1332           find first buf_goods no-lock where
     1333                     recid(buf_goods) = integer(v-rid-list) no-error.
     1334           run gen-key-rec IN THIS-PROCEDURE
     1335             ( input 'goods':U
     1336             , input (buffer buf_goods:handle)
     1337             , output v-uniq-key-rec ).
     1338         buf_ext-classif.uniq-key-rec = v-uniq-key-rec .
     1339         buf_ext-classif.whole-send-news = 0.
     1340         g-log =  BROWSE-ext-goods:refresh() .
     1341         apply "VALUE-CHANGED" TO BROWSE-ext-goods IN FRAME Dialog-Frame .
     1342         end.
     1343     end.
     1344   END.
     1345   ON ROW-DISPLAY OF BROWSE-ext-goods IN FRAME Dialog-Frame
     1346   DO:
     1347   if available buf_ext-classif then do:
     1348      if buf_ext-classif.whole-send-news = 1 then do:
     1349       assign
     1350         buf_ext-classif.CharKey_One:bgcolor   in browse BROWSE-ext-goods  = 14
     1351         buf_ext-classif.CharKey_Three:bgcolor   in browse BROWSE-ext-goods  = 14
     1352         v-gds-code:bgcolor  in browse BROWSE-ext-goods  = 14
     1353         v-gds-name:bgcolor  in browse BROWSE-ext-goods  = 14
     1354       .
     1355      end.
     1356      if buf_ext-classif.whole-send-news = 0 then do:
     1357       assign
     1358         buf_ext-classif.CharKey_One:bgcolor  in browse BROWSE-ext-goods = ?
     1359         buf_ext-classif.CharKey_Three:bgcolor  in browse BROWSE-ext-goods = ?
     1360         v-gds-code:bgcolor in browse BROWSE-ext-goods = ?
     1361         v-gds-name:bgcolor in browse BROWSE-ext-goods = ?
     1362       .
     1363      end.
     1364   end.
     1365   END.
     1366   ON VALUE-CHANGED OF BROWSE-ext-goods IN FRAME Dialog-Frame
     1367   DO:
     1368   if available buf_ext-classif then do:
     1369     v-name-exel  =  substitute("&1" ,buf_ext-classif.CharKey_Three  ) .
     1370     v-name  =  substitute("&1" ,buf_ext-classif.CharKey_Two ) .
     1371     v-name-th = f-gds-name ( recid(buf_ext-classif) )  .
     1372     display v-name-exel  v-name v-name-th with frame Dialog-Frame .
     1373   end.
     1374   END.
     1375   ON RETURN OF f-name IN FRAME Dialog-Frame
     1376   DO:
     1377    assign r-find f-name.
     1378     case r-find:
     1379     when 1 then do:
     1380        run proc-find-name in this-procedure(no, f-name) no-error.
     1381     end.
     1382     when 2 then do:
     1383        run proc-find-part-code in this-procedure(no, f-name) no-error.
     1384     end.
     1385     end case.
     1386     return no-apply.
     1387   END.
     1388   ON CTRL-J  OF f-name IN FRAME Dialog-Frame
     1389   do:
     1390    assign r-find f-name.
     1391     case r-find:
     1392     when 1 then do:
     1393        run proc-find-name in this-procedure(yes, f-name) no-error.
     1394     end.
     1395     when 2 then do:
     1396        run proc-find-part-code in this-procedure(yes, f-name) no-error.
     1397     end.
     1398     end case.
     1399     return no-apply.
     1400   end.
     1401   ON RETURN OF f-name-th IN FRAME Dialog-Frame
     1402   DO:
     1403    assign r-find-2 f-name-th.
     1404     case r-find-2:
     1405     when 1 then do:
     1406        run proc-find-name-th in this-procedure(no, f-name-th) no-error.
     1407     end.
     1408     when 3 then do:
     1409        run proc-find-part-code-th in this-procedure(no, f-name-th) no-error.
     1410     end.
     1411     end case.
     1412     return no-apply.
     1413   END.
     1414   ON CTRL-J  OF f-name-th IN FRAME Dialog-Frame
     1415   do:
     1416    assign r-find-2 f-name-th.
     1417     case r-find-2:
     1418     when 1 then do:
     1419        run proc-find-name-th in this-procedure(yes, f-name-th) no-error.
     1420     end.
     1421     when 3 then do:
     1422        run proc-find-part-code-th in this-procedure(yes, f-name-th) no-error.
     1423     end.
     1424     end case.
     1425     return no-apply.
     1426   end.
     1427   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1428   on F9 of frame Dialog-Frame anywhere do:
     1429     run init-gds-rec.
     1430     if gds-rec = ? then
     1431       return no-apply.
     1432     run ref/gds-form.w ( input parParentProc
     1433                         ,input 'ПРОСМОТР':U
     1434                         ,input ?
     1435                         ,input ?
     1436                         ,input ?
     1437                         ,input-output gds-rec).
     1438     apply "entry" to BROWSE-ext-goods in frame Dialog-Frame.
     1439     return no-apply.
     1440   end.
     1441   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1442   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1443   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   on help of frame Dialog-Frame
     1445   do:
     1446     run gbl/app_help.p
     1447       (input this-procedure :file-name
     1448       ,input ''
     1449       ,input ?
     1450       ) no-error.
     1451     if error-status :error then do:
     1452       message
     1453         "Ошибка при вызове помощи"
     1454         error-status :get-message(1)
     1455         view-as alert-box .
     1456     end.
     1457   end.
     1458   run minbtn-set in this-procedure .
     1459   on choose of b-help in frame Dialog-Frame
     1460   do:
     1461     apply "help":u to frame Dialog-Frame .
     1462   end.
     1463   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1464   procedure minbtn-set :
     1465       do
     1466           on error undo, return error return-value
     1467           :
     1468           define variable ii              as integer       no-undo .
     1469           define variable fh              as widget-handle no-undo .
     1470           define variable hh              as widget-handle no-undo .
     1471           define variable v-h             as handle        extent 4 no-undo .
     1472           define variable v-name-button   as character     no-undo .
     1473           define variable v-help-old-x    as decimal       no-undo .
     1474           define variable v-help-old-y    as decimal       no-undo .
     1475           define variable v-help-old-size as decimal       no-undo .
     1476           define variable v-frame-width   as decimal       no-undo .
     1477           define variable jj              as integer       no-undo .
     1478           do
     1479               on error undo, return error
     1480               :
     1481               assign
     1482                   v-frame-width = frame Dialog-Frame:width - 0.3
     1483                   fh            = frame Dialog-Frame:first-child
     1484                   hh            = fh:first-child
     1485                   ii            = 1
     1486                   .
     1487               do while valid-handle(hh):
     1488                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1489                   do:
     1490                       case lc(hh:name) :
     1491                           when "b-help" then
     1492                               do:
     1493                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1494                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1495                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1496                                   hh:TOOLTIP = "Помощь" .
     1497                                   v-help-old-x = hh:column .
     1498                                   v-help-old-y = hh:row    .
     1499                                   v-help-old-size = hh:width .
     1500                                   hh:width-chars = 2.5 .
     1501                               end.
     1502                           when "b-print" then
     1503                               do:
     1504                                   hh:load-image("cmp/b-print.bmp":u) .
     1505                                   hh:TOOLTIP = "Печать" .
     1506                                   v-h[ii] = hh:handle .
     1507                                   ii = ii + 1 .
     1508                                   hh:width-chars = 3 .
     1509                               end.
     1510                           when "b-history" or
     1511                           when "b-hist" then
     1512                               do:
     1513                                   hh:load-image("cmp/b-hist.bmp":u) .
     1514                                   hh:TOOLTIP = "История" .
     1515                                   v-h[ii] = hh:handle .
     1516                                   ii = ii + 1 .
     1517                                   hh:width-chars = 3 .
     1518                               end.
     1519                           when "b-sch" then
     1520                               do:
     1521                                   hh:load-image("cmp/b-sch.bmp":u) .
     1522                                   hh:TOOLTIP = "Установка Фильтра" .
     1523                                   v-h[ii] = hh:handle .
     1524                                   ii = ii + 1 .
     1525                                   hh:width-chars = 3 .
     1526                               end.
     1527                           when "b-hist-user" then
     1528                               do:
     1529                                   hh:load-image("cmp/b-hist.bmp":u) .
     1530                                   hh:TOOLTIP = "История пользователя" .
     1531                                   ii = ii + 1 .
     1532                               end.
     1533                       end case.
     1534                   end.
     1535                   hh = hh:next-sibling.
     1536               end.
     1537               b-help:column = v-frame-width - b-help:width-chars.
     1538               jj = 0.
     1539               repeat ii = 4 to 1 by -1 :
     1540                   if valid-handle (v-h[ii] ) then
     1541                   do:
     1542                       jj  = jj + 1 .
     1543                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1544                       v-h[ii]:row    = v-help-old-y .
     1545                   end.
     1546               end.
     1547           end.
     1548       end.
     1549   end procedure.
     1550   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1551   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1552   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1553   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1554   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1555   define variable v-diasize-current-frame-height as decimal   no-undo .
     1556   define variable v-diasize-change-size          as logical   no-undo .
     1557   define variable v-diasize-resize-button        as handle    no-undo .
     1558   define variable v-diasize-wndmax               as logical   no-undo .
     1559   define variable v-diasize-wndstore             as logical   no-undo .
     1560   define variable v-diasize-proc-name            as character no-undo .
     1561   define variable v-diasize-browse-handle        as handle    no-undo .
     1562   define variable v-diasize-browse-number        as integer   no-undo .
     1563   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1564   define temp-table temp-diasize-handle no-undo
     1565     field handle-value  as handle
     1566     field save-position as decimal
     1567     index xpk is primary unique handle-value
     1568     .
     1569   define temp-table temp-browse-handle no-undo
     1570     field browse-type   as character
     1571     field browse-number as integer
     1572     field browse-handle as handle
     1573     field original-size as decimal
     1574     index xpk is primary unique browse-type browse-number
     1575     index xie browse-type browse-handle
     1576   .
     1577   procedure diasize_change-height :
     1578     define input  parameter p-change-value  as decimal   no-undo .
     1579     define input  parameter p-move-resize   as logical   no-undo .
     1580     define variable v-field-group-handle    as handle    no-undo .
     1581     define variable v-object-handle         as handle    no-undo .
     1582     define variable v-frame-height          as decimal   no-undo .
     1583     define variable v-frame-virtual-height  as decimal   no-undo .
     1584     define variable v-browse-height         as decimal   no-undo .
     1585     define variable v-window-height         as decimal   no-undo .
     1586     define variable v-window-virtual-height as decimal   no-undo .
     1587     define variable v-change-sign           as integer   no-undo .
     1588     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1589     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1590     if p-change-value > 0
     1591     then do:
     1592       if frame Dialog-Frame :height + p-change-value
     1593           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1594       then do:
     1595         assign
     1596           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1597                           - (frame Dialog-Frame :height-chars)
     1598         .
     1599         if p-change-value <= 0
     1600         then do:
     1601           run diasize_position-resize-button in this-procedure .
     1602           return .
     1603         end.
     1604       end.
     1605     end.
     1606     if p-change-value < 0
     1607     then do:
     1608       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1609       then do:
     1610         assign
     1611           p-change-value = v-diasize-orig-frame-height
     1612                          - (frame Dialog-Frame :height-chars)
     1613         .
     1614         if p-change-value >= 0
     1615         then do:
     1616           run diasize_position-resize-button in this-procedure .
     1617           return .
     1618         end.
     1619       end.
     1620     end.
     1621     if p-change-value >= 0
     1622     then do:
     1623       assign
     1624         v-change-sign = 1
     1625       .
     1626     end.
     1627     else do:
     1628       assign
     1629         v-change-sign = -1
     1630       .
     1631     end.
     1632     assign
     1633       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1634     .
     1635     if p-change-value = 0
     1636     then do:
     1637       run diasize_position-resize-button in this-procedure .
     1638       return .
     1639     end.
     1640     move_block:
     1641     do
     1642     on error undo move_block, retry move_block
     1643     :
     1644       if retry
     1645       then do:
     1646         do
     1647         on error undo move_block, leave move_block
     1648         :
     1649           if p-change-value > 0
     1650           then do:
     1651             for each buf_temp-diasize-handle
     1652             on error undo, next
     1653             :
     1654               assign
     1655                 v-object-handle = buf_temp-diasize-handle.handle-value
     1656               .
     1657               if v-object-handle <> v-diasize-resize-button
     1658               then do:
     1659                 assign
     1660                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1661                 .
     1662               end.
     1663             end.
     1664             assign
     1665               v-diasize-browse-handle :height = v-browse-height
     1666             .
     1667             for each buf_temp-browse-handle
     1668               where buf_temp-browse-handle.browse-type = 'height':u
     1669             on error undo, next
     1670             :
     1671               assign
     1672                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1673               .
     1674             end.
     1675             assign
     1676               frame Dialog-Frame :height = v-frame-height
     1677             .
     1678             if frame Dialog-Frame :scrollable = true
     1679             then do:
     1680               assign
     1681                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1682               .
     1683             end.
     1684             run diasize_position-resize-button in this-procedure .
     1685           end.
     1686           else do:
     1687             if frame Dialog-Frame :scrollable = true
     1688             then do:
     1689               assign
     1690                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1691               .
     1692             end.
     1693             assign
     1694               frame Dialog-Frame :height = v-frame-height
     1695             .
     1696             assign
     1697               v-diasize-browse-handle :height = v-browse-height
     1698             .
     1699             for each buf_temp-browse-handle
     1700               where buf_temp-browse-handle.browse-type = 'height':u
     1701             on error undo, next
     1702             :
     1703               assign
     1704                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1705               .
     1706             end.
     1707             for each buf_temp-diasize-handle
     1708             on error undo, next
     1709             :
     1710               assign
     1711                 v-object-handle = buf_temp-diasize-handle.handle-value
     1712               .
     1713               if v-object-handle <> v-diasize-resize-button
     1714               then do:
     1715                 assign
     1716                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1717                 .
     1718               end.
     1719             end.
     1720             run diasize_position-resize-button in this-procedure .
     1721           end.
     1722           assign
     1723             v-diasize-change-size = false
     1724           .
     1725           leave move_block .
     1726         end.
     1727       end.
     1728       assign
     1729         v-diasize-need-full-display = true
     1730       .
     1731       if v-diasize-change-size = false
     1732       then do:
     1733         assign
     1734           v-diasize-change-size = true
     1735         .
     1736       end.
     1737       else do:
     1738         return .
     1739       end.
     1740       assign
     1741         v-frame-height = frame Dialog-Frame :height
     1742         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1743         v-browse-height = v-diasize-browse-handle :height
     1744       .
     1745       for each buf_temp-browse-handle
     1746         where buf_temp-browse-handle.browse-type = 'height':u
     1747       :
     1748         assign
     1749           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1750         .
     1751       end.
     1752       for each buf_temp-diasize-handle
     1753       :
     1754         delete buf_temp-diasize-handle .
     1755       end.
     1756       assign
     1757         v-field-group-handle = frame Dialog-Frame :first-child
     1758       .
     1759       do while valid-handle(v-field-group-handle)
     1760       :
     1761         assign
     1762           v-object-handle = v-field-group-handle :first-child
     1763         .
     1764         do while valid-handle(v-object-handle)
     1765         :
     1766           if  v-object-handle <> v-diasize-browse-handle :handle
     1767           and can-query(v-object-handle, "row")
     1768           and can-query(v-object-handle, "height")
     1769           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1770           then do:
     1771             find first buf_temp-browse-handle
     1772               where buf_temp-browse-handle.browse-type   = 'height':u
     1773                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1774               no-error .
     1775             if available buf_temp-browse-handle
     1776             then do:
     1777             end.
     1778             else do:
     1779               create buf_temp-diasize-handle .
     1780               assign
     1781                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1782                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1783               .
     1784             end.
     1785           end.
     1786           assign
     1787             v-object-handle = v-object-handle :next-sibling
     1788           .
     1789         end.
     1790         assign
     1791           v-field-group-handle = v-field-group-handle :next-sibling
     1792         .
     1793       end.
     1794       do with frame Dialog-Frame
     1795       :
     1796         hide v-diasize-resize-button .
     1797         assign
     1798           v-diasize-resize-button :row    = 1
     1799           v-diasize-resize-button :column = 1
     1800         .
     1801       end.
     1802       if p-change-value > 0
     1803       then do:
     1804         if frame Dialog-Frame :scrollable = true
     1805         then do:
     1806           assign
     1807             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1808             no-error .
     1809           if error-status :error
     1810           or error-status :get-message(1) <> ""
     1811           then do:
     1812             undo move_block, retry move_block .
     1813           end.
     1814         end.
     1815         assign
     1816           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1817           no-error .
     1818         if error-status :error
     1819         or error-status :get-message(1) <> ""
     1820         then do:
     1821           undo move_block, retry move_block .
     1822         end.
     1823         assign
     1824           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1825           no-error .
     1826         if error-status :error
     1827         or error-status :get-message(1) <> ""
     1828         then do:
     1829           undo move_block, retry move_block .
     1830         end.
     1831         for each buf_temp-browse-handle
     1832           where buf_temp-browse-handle.browse-type = 'height':u
     1833         on error undo move_block, retry move_block
     1834         :
     1835           assign
     1836             buf_temp-browse-handle.browse-handle :height
     1837               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1838             no-error .
     1839           if error-status :error
     1840           or error-status :get-message(1) <> ""
     1841           then do:
     1842             undo move_block, retry move_block .
     1843           end.
     1844         end.
     1845         for each buf_temp-diasize-handle
     1846         on error undo move_block, retry move_block
     1847         :
     1848           assign
     1849             v-object-handle = buf_temp-diasize-handle.handle-value
     1850           .
     1851           if v-object-handle <> v-diasize-resize-button
     1852           then do:
     1853             assign
     1854               v-object-handle :row = v-object-handle :row + p-change-value
     1855               no-error .
     1856             if error-status :error
     1857             or error-status :get-message(1) <> ""
     1858             then do:
     1859               undo move_block, retry move_block .
     1860             end.
     1861           end.
     1862         end.
     1863       end.
     1864       else do:
     1865         for each buf_temp-diasize-handle
     1866         on error undo move_block, retry move_block
     1867         :
     1868           assign
     1869             v-object-handle = buf_temp-diasize-handle.handle-value
     1870           .
     1871           if v-object-handle <> v-diasize-resize-button
     1872           then do:
     1873             assign
     1874               v-object-handle :row = v-object-handle :row + p-change-value
     1875               no-error .
     1876             if error-status :error
     1877             or error-status :get-message(1) <> ""
     1878             then do:
     1879               undo move_block, retry move_block .
     1880             end.
     1881           end.
     1882         end.
     1883         assign
     1884           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1885           no-error .
     1886         if error-status :error
     1887         or error-status :get-message(1) <> ""
     1888         then do:
     1889           undo move_block, retry move_block .
     1890         end.
     1891         for each buf_temp-browse-handle
     1892           where buf_temp-browse-handle.browse-type = 'height':u
     1893         on error undo move_block, retry move_block
     1894         :
     1895           assign
     1896             buf_temp-browse-handle.browse-handle :height
     1897               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1898             no-error .
     1899           if error-status :error
     1900           or error-status :get-message(1) <> ""
     1901           then do:
     1902             undo move_block, retry move_block .
     1903           end.
     1904         end.
     1905         assign
     1906           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1907           no-error .
     1908         if error-status :error
     1909         or error-status :get-message(1) <> ""
     1910         then do:
     1911           undo move_block, retry move_block .
     1912         end.
     1913         if frame Dialog-Frame :scrollable = true
     1914         then do:
     1915           assign
     1916             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1917             no-error .
     1918           if error-status :error
     1919           or error-status :get-message(1) <> ""
     1920           then do:
     1921             undo move_block, retry move_block .
     1922           end.
     1923         end.
     1924       end.
     1925       if p-move-resize = true
     1926       then do:
     1927         run diasize_position-resize-button in this-procedure .
     1928       end.
     1929       if v-diasize-wndstore = true
     1930       then do:
     1931         if connected("ub") = true
     1932         then do:
     1933           define variable v-cntxt-db-num        as integer   no-undo .
     1934           define variable v-cntxt-userid        as character no-undo .
     1935           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1936                                             , OUTPUT v-cntxt-userid
     1937                                             ) .
     1938           run gbl/wndsizew.p
     1939             (input  v-cntxt-db-num
     1940             ,input  v-cntxt-userid
     1941             ,input  v-diasize-proc-name
     1942             ,input  'height':u
     1943             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1944             ) .
     1945         end.
     1946       end.
     1947     end.
     1948     assign
     1949       v-diasize-change-size = false
     1950     .
     1951   end procedure.
     1952   procedure diasize_set-height :
     1953     define input  parameter p-new-height  as decimal   no-undo .
     1954     define input  parameter p-move-resize as logical   no-undo .
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       run diasize_change-height in this-procedure
     1959         (input  (p-new-height - frame Dialog-Frame :height)
     1960         ,input  p-move-resize
     1961         ) .
     1962     end.
     1963   end procedure.
     1964   procedure diasize_change-width :
     1965     define input  parameter p-change-value as decimal   no-undo .
     1966     define input  parameter p-move-resize  as logical   no-undo .
     1967     define variable v-field-group-handle   as handle    no-undo .
     1968     define variable v-object-handle        as handle    no-undo .
     1969     define variable v-frame-width          as decimal   no-undo .
     1970     define variable v-frame-virtual-width  as decimal   no-undo .
     1971     define variable v-browse-width         as decimal   no-undo .
     1972     define variable v-window-width         as decimal   no-undo .
     1973     define variable v-window-virtual-width as decimal   no-undo .
     1974     define variable v-change-sign          as integer   no-undo .
     1975     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1976     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1977     if p-change-value > 0
     1978     then do:
     1979       if frame Dialog-Frame :width + p-change-value >
     1980           session :width-chars
     1981       then do:
     1982         assign
     1983           p-change-value = session :width-chars - frame Dialog-Frame :width
     1984         .
     1985         if p-change-value <= 0
     1986         then do:
     1987           run diasize_position-resize-button in this-procedure .
     1988           return .
     1989         end.
     1990       end.
     1991     end.
     1992     if p-change-value < 0
     1993     then do:
     1994       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1995       then do:
     1996         assign
     1997           p-change-value = v-diasize-orig-frame-width
     1998                          - frame Dialog-Frame :width
     1999         .
     2000         if p-change-value >= 0
     2001         then do:
     2002           run diasize_position-resize-button in this-procedure .
     2003           return .
     2004         end.
     2005       end.
     2006     end.
     2007     if p-change-value >= 0
     2008     then do:
     2009       assign
     2010         v-change-sign = 1
     2011       .
     2012     end.
     2013     else do:
     2014       assign
     2015         v-change-sign = -1
     2016       .
     2017     end.
     2018     assign
     2019       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2020     .
     2021     if p-change-value = 0
     2022     then do:
     2023       run diasize_position-resize-button in this-procedure .
     2024       return .
     2025     end.
     2026     move_block:
     2027     do
     2028     on error undo move_block, leave move_block
     2029     :
     2030       if retry
     2031       then do:
     2032         do
     2033         on error undo move_block, leave move_block
     2034         :
     2035           if p-change-value > 0
     2036           then do:
     2037             for each buf_temp-diasize-handle
     2038             on error undo, next
     2039             :
     2040               assign
     2041                 v-object-handle = buf_temp-diasize-handle.handle-value
     2042               .
     2043               if v-object-handle <> v-diasize-resize-button
     2044               then do:
     2045                 assign
     2046                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2047                 .
     2048               end.
     2049             end.
     2050             assign
     2051               v-diasize-browse-handle :width = v-browse-width
     2052             .
     2053             for each buf_temp-browse-handle
     2054               where buf_temp-browse-handle.browse-type = 'width':u
     2055             on error undo, next
     2056             :
     2057               assign
     2058                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2059               .
     2060             end.
     2061             assign
     2062               frame Dialog-Frame :width = v-frame-width
     2063             .
     2064             if frame Dialog-Frame :scrollable = true
     2065             then do:
     2066               assign
     2067                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2068               .
     2069             end.
     2070             run diasize_position-resize-button in this-procedure .
     2071           end.
     2072           else do:
     2073             if frame Dialog-Frame :scrollable = true
     2074             then do:
     2075               assign
     2076                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2077               .
     2078             end.
     2079             assign
     2080               frame Dialog-Frame :width = v-frame-width
     2081             .
     2082             for each buf_temp-browse-handle
     2083               where buf_temp-browse-handle.browse-type = 'width':u
     2084             on error undo, next
     2085             :
     2086               assign
     2087                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2088               .
     2089             end.
     2090             assign
     2091               v-diasize-browse-handle :width = v-browse-width
     2092             .
     2093             for each buf_temp-diasize-handle
     2094             on error undo, next
     2095             :
     2096               assign
     2097                 v-object-handle = buf_temp-diasize-handle.handle-value
     2098               .
     2099               if v-object-handle <> v-diasize-resize-button
     2100               then do:
     2101                 assign
     2102                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2103                 .
     2104               end.
     2105             end.
     2106             run diasize_position-resize-button in this-procedure .
     2107           end.
     2108           assign
     2109             v-diasize-change-size = false
     2110           .
     2111           leave move_block .
     2112         end.
     2113       end.
     2114       assign
     2115         v-diasize-need-full-display = true
     2116       .
     2117       if v-diasize-change-size = false
     2118       then do:
     2119         assign
     2120           v-diasize-change-size = true
     2121         .
     2122       end.
     2123       else do:
     2124         return .
     2125       end.
     2126       assign
     2127         v-frame-width = frame Dialog-Frame :width
     2128         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2129         v-browse-width = v-diasize-browse-handle :width
     2130       .
     2131       for each buf_temp-browse-handle
     2132         where buf_temp-browse-handle.browse-type = 'width':u
     2133       :
     2134         assign
     2135           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2136         .
     2137       end.
     2138       for each buf_temp-diasize-handle
     2139       :
     2140         delete buf_temp-diasize-handle .
     2141       end.
     2142       assign
     2143         v-field-group-handle = frame Dialog-Frame :first-child
     2144       .
     2145       do while valid-handle(v-field-group-handle)
     2146       :
     2147         assign
     2148           v-object-handle = v-field-group-handle :first-child
     2149         .
     2150         do while valid-handle(v-object-handle)
     2151         :
     2152           if  v-object-handle <> v-diasize-browse-handle :handle
     2153           and v-object-handle <> v-diasize-resize-button
     2154           and can-query(v-object-handle, "row")
     2155           and can-query(v-object-handle, "height")
     2156           and ( v-object-handle :col + v-object-handle :width
     2157                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2158               )
     2159           then do:
     2160             find first buf_temp-browse-handle
     2161               where buf_temp-browse-handle.browse-type   = 'width':u
     2162                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2163               no-error .
     2164             if available buf_temp-browse-handle
     2165             then do:
     2166             end.
     2167             else do:
     2168               create buf_temp-diasize-handle .
     2169               assign
     2170                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2171                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2172               .
     2173             end.
     2174           end.
     2175           assign
     2176             v-object-handle = v-object-handle :next-sibling
     2177           .
     2178         end.
     2179         assign
     2180           v-field-group-handle = v-field-group-handle :next-sibling
     2181         .
     2182       end.
     2183       do with frame Dialog-Frame
     2184       :
     2185         hide v-diasize-resize-button .
     2186         v-diasize-resize-button :row = 1.
     2187         v-diasize-resize-button :column = 1.
     2188       end.
     2189       if p-change-value > 0
     2190       then do:
     2191         if frame Dialog-Frame :scrollable = true
     2192         then do:
     2193           assign
     2194             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2195             no-error .
     2196           if error-status :error
     2197           or error-status :get-message(1) <> ""
     2198           then do:
     2199             undo move_block, retry move_block.
     2200           end.
     2201         end.
     2202         assign
     2203           frame Dialog-Frame :width = v-frame-width + p-change-value
     2204           no-error .
     2205         if error-status :error
     2206         or error-status :get-message(1) <> ""
     2207         then do:
     2208           undo move_block, retry move_block.
     2209         end.
     2210         assign
     2211           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2212         no-error .
     2213         if error-status :error
     2214         or error-status :get-message(1) <> ""
     2215         then do:
     2216           undo move_block, retry move_block.
     2217         end.
     2218         for each buf_temp-browse-handle
     2219           where buf_temp-browse-handle.browse-type = 'width':u
     2220         on error undo move_block, retry move_block
     2221         :
     2222           assign
     2223             buf_temp-browse-handle.browse-handle :width
     2224               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2225             no-error .
     2226           if error-status :error
     2227           or error-status :get-message(1) <> ""
     2228           then do:
     2229             undo move_block, retry move_block .
     2230           end.
     2231         end.
     2232         for each buf_temp-diasize-handle
     2233         on error undo move_block, retry move_block
     2234         :
     2235           assign
     2236             v-object-handle = buf_temp-diasize-handle.handle-value
     2237           .
     2238           if v-object-handle <> v-diasize-resize-button
     2239           then do:
     2240             assign
     2241               v-object-handle :col = v-object-handle :col + p-change-value
     2242               no-error .
     2243             if error-status :error
     2244             or error-status :get-message(1) <> ""
     2245             then do:
     2246               undo move_block, retry move_block .
     2247             end.
     2248           end.
     2249         end.
     2250       end.
     2251       else do:
     2252         for each buf_temp-diasize-handle
     2253         on error undo move_block, retry move_block
     2254         :
     2255           assign
     2256             v-object-handle = buf_temp-diasize-handle.handle-value
     2257           .
     2258           if v-object-handle <> v-diasize-resize-button
     2259           then do:
     2260             assign
     2261               v-object-handle :col = v-object-handle :col + p-change-value
     2262               no-error .
     2263             if error-status :error
     2264             or error-status :get-message(1) <> ""
     2265             then do:
     2266               undo move_block, retry move_block .
     2267             end.
     2268           end.
     2269         end.
     2270         for each buf_temp-browse-handle
     2271           where buf_temp-browse-handle.browse-type = 'width':u
     2272         on error undo move_block, retry move_block
     2273         :
     2274           assign
     2275             buf_temp-browse-handle.browse-handle :width
     2276               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2277             no-error .
     2278           if error-status :error
     2279           or error-status :get-message(1) <> ""
     2280           then do:
     2281             undo move_block, retry move_block .
     2282           end.
     2283         end.
     2284         assign
     2285           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2286           no-error .
     2287         if error-status :error
     2288         or error-status :get-message(1) <> ""
     2289         then do:
     2290           undo move_block, retry move_block.
     2291         end.
     2292         assign
     2293           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2294         no-error .
     2295         if error-status :error
     2296         or error-status :get-message(1) <> ""
     2297         then do:
     2298           undo move_block, retry move_block.
     2299         end.
     2300         if frame Dialog-Frame :scrollable = true
     2301         then do:
     2302           assign
     2303             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2304           no-error .
     2305           if error-status :error
     2306           or error-status :get-message(1) <> ""
     2307           then do:
     2308             undo move_block, retry move_block.
     2309           end.
     2310         end.
     2311       end.
     2312       if p-move-resize
     2313       then do:
     2314         run diasize_position-resize-button in this-procedure .
     2315       end.
     2316       if v-diasize-wndstore = true
     2317       then do:
     2318         if connected("ub") = true
     2319         then do:
     2320           define variable v-cntxt-db-num        as integer   no-undo .
     2321           define variable v-cntxt-userid        as character no-undo .
     2322           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2323                                             , OUTPUT v-cntxt-userid
     2324                                             ) .
     2325           run gbl/wndsizew.p
     2326             (input  v-cntxt-db-num
     2327             ,input  v-cntxt-userid
     2328             ,input  v-diasize-proc-name
     2329             ,input  'width':u
     2330             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2331             ) .
     2332         end.
     2333       end.
     2334     end.
     2335     assign
     2336       v-diasize-change-size = false
     2337     .
     2338   end procedure.
     2339   procedure diasize_set-width :
     2340     define input  parameter p-new-width  as decimal   no-undo .
     2341     define input  parameter p-move-resize as logical   no-undo .
     2342     do
     2343     on error undo, return error return-value
     2344     :
     2345       run diasize_change-width in this-procedure
     2346         (input  (p-new-width - frame Dialog-Frame :width)
     2347         ,input  p-move-resize
     2348         ) .
     2349     end.
     2350   end procedure.
     2351   procedure diasize_position-resize-button :
     2352     do with frame Dialog-Frame
     2353     :
     2354       hide v-diasize-resize-button .
     2355       assign
     2356         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2357                     - 1
     2358                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2359         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2360                     - 1
     2361                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2362       .
     2363       view v-diasize-resize-button .
     2364     end.
     2365   end procedure.
     2366   on alt-right anywhere
     2367   do:
     2368     run diasize_change-width in this-procedure
     2369       (input 1
     2370       ,input true
     2371       ) .
     2372     return no-apply .
     2373   end.
     2374   on alt-left anywhere
     2375   do:
     2376     run diasize_change-width in this-procedure
     2377       (input -1
     2378       ,input true
     2379       ) .
     2380     return no-apply .
     2381   end.
     2382   on alt-down anywhere
     2383   do:
     2384     run diasize_change-height in this-procedure
     2385       (input 1
     2386       ,input true
     2387       ) .
     2388     return no-apply .
     2389   end.
     2390   on alt-up anywhere
     2391   do:
     2392     run diasize_change-height in this-procedure
     2393       (input -1
     2394       ,input true
     2395       ) .
     2396     return no-apply .
     2397   end.
     2398   on alt-enter of frame Dialog-Frame
     2399   do:
     2400     run diasize_maximize in this-procedure
     2401       (input  ?
     2402       ).
     2403     return no-apply .
     2404   end.
     2405   procedure diasize_end-move :
     2406     do
     2407     on error undo, return error return-value
     2408     :
     2409       define variable v-row-delta as decimal   no-undo .
     2410       define variable v-col-delta as decimal   no-undo .
     2411       define variable v-new-row as decimal   no-undo .
     2412       define variable v-new-col as decimal   no-undo .
     2413       assign
     2414         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2415         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2416       .
     2417       assign
     2418         v-row-delta = v-new-row - frame Dialog-Frame :height
     2419         v-col-delta = v-new-col - frame Dialog-Frame :width
     2420       .
     2421       run diasize_change-height in this-procedure
     2422         (input v-row-delta
     2423         ,input true
     2424         ) .
     2425       run diasize_change-width in this-procedure
     2426         (input v-col-delta
     2427         ,input true
     2428         ) .
     2429     end.
     2430   end procedure.
     2431   procedure diasize_maximize :
     2432     define input  parameter p-action as logical   no-undo .
     2433     do
     2434     on error undo, return error return-value
     2435     :
     2436       if p-action = ?
     2437       then do:
     2438         if v-diasize-need-maximize = true
     2439         then do:
     2440           assign
     2441             p-action = true
     2442           .
     2443         end.
     2444         else do:
     2445           assign
     2446             p-action = false
     2447           .
     2448         end.
     2449       end.
     2450       if p-action = true
     2451       then do:
     2452         run diasize_change-height in this-procedure
     2453           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2454               - frame Dialog-Frame :height-chars
     2455           ,input true
     2456           ) .
     2457         run diasize_change-width in this-procedure
     2458           (input session :width-chars
     2459               - frame Dialog-Frame :width-chars
     2460           ,input true
     2461           ) .
     2462         assign
     2463           v-diasize-need-maximize = false
     2464         .
     2465       end.
     2466       else do:
     2467         run diasize_change-width in this-procedure
     2468           (input v-diasize-orig-frame-width
     2469               - frame Dialog-Frame :width-chars
     2470           ,input true
     2471           ) .
     2472         run diasize_change-height in this-procedure
     2473           (input v-diasize-orig-frame-height
     2474               - frame Dialog-Frame :height-chars
     2475           ,input true
     2476           ) .
     2477         assign
     2478           v-diasize-need-maximize = true
     2479         .
     2480       end.
     2481     end.
     2482   end procedure.
     2483   procedure diasize_restore-orig-size :
     2484     do
     2485     on error undo, return error return-value
     2486     :
     2487       assign
     2488         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2489         v-diasize-current-frame-height = frame Dialog-Frame :height
     2490       .
     2491       run diasize_set-height in this-procedure
     2492         (input  v-diasize-orig-frame-height
     2493         ,input  true
     2494         ) .
     2495       run diasize_set-width in this-procedure
     2496         (input  v-diasize-orig-frame-width
     2497         ,input  true
     2498         ) .
     2499     end.
     2500   end procedure.
     2501   procedure diasize_restore-current-size :
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505       run diasize_set-height in this-procedure
     2506         (input  v-diasize-current-frame-height
     2507         ,input  true
     2508         ) .
     2509       run diasize_set-width in this-procedure
     2510         (input  v-diasize-current-frame-width
     2511         ,input  true
     2512         ) .
     2513     end.
     2514   end procedure.
     2515   procedure diasize_set-browse-handle :
     2516     define input  parameter p-browse-handle as handle   no-undo .
     2517     define buffer buf_temp-browse-handle for temp-browse-handle .
     2518     do
     2519     on error undo, return error return-value
     2520     :
     2521       assign
     2522         v-diasize-browse-handle = p-browse-handle
     2523       .
     2524       for each buf_temp-browse-handle
     2525       on error undo, return error return-value
     2526       :
     2527         delete buf_temp-browse-handle .
     2528       end.
     2529     end.
     2530   end procedure.
     2531   procedure diasize_add_browse :
     2532     define input  parameter p-browse-type   as character no-undo .
     2533     define input  parameter p-browse-handle as handle    no-undo .
     2534     define buffer buf_temp-browse-handle for temp-browse-handle .
     2535     do
     2536     on error undo, return error return-value
     2537     :
     2538       assign
     2539         v-diasize-browse-number = v-diasize-browse-number + 1
     2540       .
     2541       create buf_temp-browse-handle .
     2542       assign
     2543         buf_temp-browse-handle.browse-type   = p-browse-type
     2544         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2545         buf_temp-browse-handle.browse-handle = p-browse-handle
     2546       .
     2547     end.
     2548   end procedure.
     2549   procedure diasize_init :
     2550     define variable v-default-value    as logical   no-undo .
     2551     define variable v-restore-saved    as logical   no-undo .
     2552     define variable v-resize-value-str as character no-undo .
     2553     do
     2554     on error undo, return error return-value
     2555     :
     2556       do with frame Dialog-Frame
     2557       :
     2558         assign
     2559           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2560           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2561           v-diasize-browse-handle     = browse BROWSE-ext-goods :handle
     2562         .
     2563         create button v-diasize-resize-button
     2564         assign
     2565           parent        = frame Dialog-Frame :first-child
     2566           label         = "s"
     2567           height-pixels = 16
     2568           width-pixels  = 16
     2569           visible       = true
     2570           sensitive     = true
     2571           movable       = true
     2572           triggers:
     2573             on end-move persistent run diasize_end-move in this-procedure .
     2574           end triggers.
     2575         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2576         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2577         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2578         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2579         assign
     2580           v-diasize-wndmax = false
     2581         .
     2582         if connected("ub") = true
     2583         then do:
     2584           define variable v-cntxt-db-num        as integer   no-undo .
     2585           define variable v-cntxt-userid        as character no-undo .
     2586           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2587                                             , OUTPUT v-cntxt-userid
     2588                                             ) .
     2589           run gbl/wndpar_r.p
     2590             (input  v-cntxt-db-num
     2591             ,input  v-cntxt-userid
     2592             ,input  'wndmax':U
     2593             ,output v-diasize-wndmax
     2594             ,output v-default-value
     2595             ) .
     2596         end.
     2597         assign
     2598           v-diasize-wndstore = false
     2599         .
     2600         if connected("ub") = true
     2601         then do:
     2602           run gbl/wndpar_r.p
     2603             (input  v-cntxt-db-num
     2604             ,input  v-cntxt-userid
     2605             ,input  'wndstore':U
     2606             ,output v-diasize-wndstore
     2607             ,output v-default-value
     2608             ) .
     2609         end.
     2610         assign
     2611           v-diasize-proc-name = entry(1, program-name(2), '.')
     2612         .
     2613         if v-diasize-wndstore = true
     2614         then do:
     2615           assign
     2616             v-restore-saved = false
     2617           .
     2618           if connected("ub") = true
     2619           then do:
     2620             run gbl/wndsizer.p
     2621               (input  v-cntxt-db-num
     2622               ,input  v-cntxt-userid
     2623               ,input  v-diasize-proc-name
     2624               ,input  'height':u
     2625               ,output v-resize-value-str
     2626               ) .
     2627             if v-resize-value-str <> '':U
     2628             then do:
     2629               run diasize_change-height in this-procedure
     2630                 (input  integer(v-resize-value-str)
     2631                 ,input  true
     2632                 ) .
     2633               assign
     2634                 v-restore-saved = true
     2635               .
     2636             end.
     2637           end.
     2638           if connected("ub") = true
     2639           then do:
     2640             run gbl/wndsizer.p
     2641               (input  v-cntxt-db-num
     2642               ,input  v-cntxt-userid
     2643               ,input  v-diasize-proc-name
     2644               ,input  'width':u
     2645               ,output v-resize-value-str
     2646               ) .
     2647             if v-resize-value-str <> '':U
     2648             then do:
     2649               run diasize_change-width in this-procedure
     2650                 (input  integer(v-resize-value-str)
     2651                 ,input  true
     2652                 ) .
     2653               assign
     2654                 v-restore-saved = true
     2655               .
     2656             end.
     2657           end.
     2658           if v-restore-saved <> true
     2659           then do:
     2660             if v-diasize-wndmax = true
     2661             then do:
     2662               run diasize_maximize in this-procedure
     2663                 (input  true
     2664                 ) .
     2665             end.
     2666           end.
     2667         end.
     2668         else do:
     2669           if v-diasize-wndmax = true
     2670           then do:
     2671             run diasize_maximize in this-procedure
     2672               (input  true
     2673               ) .
     2674           end.
     2675         end.
     2676       end.
     2677     end.
     2678   end procedure.
     2679   procedure diasize_need-full-display :
     2680     define output parameter p-need-full-display as logical   no-undo .
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       assign
     2685         p-need-full-display = v-diasize-need-full-display
     2686       .
     2687       assign
     2688         v-diasize-need-full-display = false
     2689       .
     2690     end.
     2691   end procedure.
     2692   procedure get-context :
     2693      define output parameter p-db-num as integer          no-undo.
     2694      define output parameter p-user-id as character        no-undo.
     2695      define variable v-login               as character    no-undo.
     2696      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2697      define buffer buf_user-login  for ub.user-login .
     2698      do
     2699      on error undo, return error
     2700      :
     2701            FIND FIRST buf_sys-ctrl no-lock.
     2702            ASSIGN
     2703               v-login = USERID("ub")
     2704               p-db-num = buf_sys-ctrl.db-num
     2705            .
     2706            FIND FIRST buf_user-login
     2707                 WHERE buf_user-login.db-num = p-db-num
     2708                   AND buf_user-login.user-login = v-login
     2709                 no-lock
     2710                 no-error
     2711                 .
     2712            IF AVAILABLE buf_user-login
     2713            THEN DO:
     2714               assign
     2715                  p-user-id = buf_user-login.user-id
     2716               .
     2717            END.
     2718      end.
     2719   end procedure.
     2720       run diasize_init in this-procedure .
     2721   def var sort-labelBROWSE-ext-goods   as character no-undo .
     2722   def var sort-clmnBROWSE-ext-goods    as handle    no-undo .
     2723   def var cur-clmnBROWSE-ext-goods     as handle    no-undo .
     2724   def var cur-clmn-locBROWSE-ext-goods as integer   no-undo .
     2725   def var re-queryBROWSE-ext-goods     as logical   initial no no-undo .
     2726   on start-search, ctrl-o of BROWSE-ext-goods in frame Dialog-Frame do:
     2727      run sort-brBROWSE-ext-goods
     2728        (input (if available buf_ext-classif
     2729                then recid(buf_ext-classif)
     2730                else ?
     2731               )
     2732        ).
     2733   end.
     2734   PROCEDURE sort-brBROWSE-ext-goods :
     2735     define input parameter p-recid as recid no-undo .
     2736     if re-queryBROWSE-ext-goods = no then do:
     2737       assign
     2738          cur-clmnBROWSE-ext-goods = BROWSE-ext-goods:current-column in frame Dialog-Frame
     2739       .
     2740       if sort-clmnBROWSE-ext-goods <> ? then sort-clmnBROWSE-ext-goods:column-fgcolor = 0.
     2741       if cur-clmnBROWSE-ext-goods = sort-clmnBROWSE-ext-goods then do:
     2742         assign
     2743            sort-labelBROWSE-ext-goods = ""
     2744            sort-clmnBROWSE-ext-goods = ?
     2745         .
     2746        end.
     2747        else do:
     2748          assign
     2749            sort-labelBROWSE-ext-goods = cur-clmnBROWSE-ext-goods:label
     2750            sort-clmnBROWSE-ext-goods  = cur-clmnBROWSE-ext-goods
     2751            sort-clmnBROWSE-ext-goods:column-fgcolor = 4
     2752          .
     2753        end.
     2754      end.
     2755     assign
     2756       cur-clmn-locBROWSE-ext-goods = 1
     2757     .
     2758     def var column-handle as handle no-undo .
     2759     column-handle = BROWSE-ext-goods:first-column.
     2760     do while valid-handle(column-handle) :
     2761       if column-handle = cur-clmnBROWSE-ext-goods then do:
     2762         leave .
     2763       end.
     2764       column-handle = column-handle:NEXT-COLUMN.
     2765       assign
     2766         cur-clmn-locBROWSE-ext-goods = cur-clmn-locBROWSE-ext-goods + 1
     2767       .
     2768     end.
     2769     case sort-labelBROWSE-ext-goods:
     2770           when 'Фальсификат!Серия'  then DO:    assign       sort-column-name = "buf_ext-classif.CharKey_One"     .     run OpenBr(yes,no,'':U).   . END.
     2771           when 'Название товара!из Excel'  then DO:    assign       sort-column-name = "buf_ext-classif.CharKey_Three"     .     run OpenBr(yes,no,'':U).   . END.
     2772           when 'Код Товара!в TH'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-gds-code&1, recid(buf_ext-classif))', chr(34))     .     run OpenBr(yes,no,'':U).   . END.
     2773           when 'Название!в TH'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-gds-name&1, recid(buf_ext-classif))', chr(34))     .     run OpenBr(yes,no,'':U).   . END.
     2774           when '§'  then DO:    assign       sort-column-name = "buf_ext-classif.whole-send-news"     .     run OpenBr(yes,no,'':U).   . END.
     2775       otherwise do:
     2776         assign
     2777           sort-column-name = ""
     2778         .
     2779         run OpenBr(yes,no,'':U).
     2780         if sort-labelBROWSE-ext-goods <> "" then do:
     2781           assign
     2782             cur-clmnBROWSE-ext-goods:column-fgcolor = 0
     2783           .
     2784         end.
     2785         assign
     2786           cur-clmn-locBROWSE-ext-goods = ?
     2787         .
     2788       end.
     2789     end case.
     2790     if p-recid <> ? then do:
     2791       reposition BROWSE-ext-goods to recid p-recid no-error.
     2792       apply "value-changed" to BROWSE-ext-goods in frame Dialog-Frame.
     2793     end.
     2794     apply "entry" to BROWSE-ext-goods in frame Dialog-Frame.
     2795   END PROCEDURE.
     2796   procedure re-open-query-srt-clmnBROWSE-ext-goods:
     2797   if cur-clmnBROWSE-ext-goods = ? then do:
     2798      run OpenBr(yes,no,'':U).
     2799   end.
     2800   else do:
     2801      assign re-queryBROWSE-ext-goods = yes.
     2802      run sort-brBROWSE-ext-goods
     2803        (input (if available buf_ext-classif
     2804                then recid(buf_ext-classif)
     2805                else ?
     2806               )
     2807        ).
     2808      assign re-queryBROWSE-ext-goods = no.
     2809   end.
     2810   end.
     2811   MAIN-BLOCK:
     2812   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2813      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2814      buf_ext-classif.CharKey_Three :resizable in browse BROWSE-ext-goods   = true .
     2815      buf_ext-classif.CharKey_One   :resizable in browse BROWSE-ext-goods   = true .
     2816      buf_ext-classif.CharKey_One   :width     in browse BROWSE-ext-goods   = 16.
     2817      buf_ext-classif.CharKey_Three :width     in browse BROWSE-ext-goods   = 35.
     2818      buf_ext-classif.CharKey_One:read-only in browse BROWSE-ext-goods   = true .
     2819     RUN enable_UI.
     2820     run openbr in this-procedure (yes, no, '':U) .
     2821     WAIT-FOR GO OF FRAME Dialog-Frame.
     2822   END.
     2823   RUN disable_UI.
     2824   PROCEDURE delete-all :
     2825   define variable v-ok as logical   no-undo .
     2826   message
     2827    "Запустить удаление всего хранимого списка ФИБ ? "
     2828    view-as alert-box question
     2829          BUTTONS yes-no
     2830          TITLE "Внимание !"
     2831          UPDATE v-ok
     2832          .
     2833   if not v-ok then return .
     2834     run waitfram-show in this-procedure ("Процедура связывания товара по первому слову...")   .
     2835     for each buf_ext-classif exclusive-lock where
     2836       Buf_ext-classif.classif-subject = 'goods':U  AND
     2837       Buf_ext-classif.classif-name    = 'goods_fib':U  :
     2838       delete Buf_ext-classif .
     2839     end.
     2840     run waitfram-hide in this-procedure .
     2841     run openbr in this-procedure (yes, no, '':U).
     2842   END PROCEDURE.
     2843   PROCEDURE disable_UI :
     2844     HIDE FRAME Dialog-Frame.
     2845   END PROCEDURE.
     2846   PROCEDURE enable_UI :
     2847     DISPLAY R-find R-find-2 f-name f-name-th v-name v-name-th v-name-exel
     2848         WITH FRAME Dialog-Frame.
     2849     ENABLE B-OK B-Cancel B-import B-rel B-norel B-charm B-delete-all B-Help
     2850            R-find R-find-2 f-name f-name-th BROWSE-ext-goods v-name v-name-th
     2851            v-name-exel
     2852         WITH FRAME Dialog-Frame.
     2853     VIEW FRAME Dialog-Frame.
     2854     OPEN QUERY BROWSE-ext-goods FOR EACH buf_ext-classif NO-LOCK INDEXED-REPOSITION.
     2855   END PROCEDURE.
     2856   PROCEDURE ex-file :
     2857   define input parameter ff as character no-undo .
     2858   define input parameter ex as logical no-undo .
     2859     if ex = false then do:
     2860         create "excel.application" chexcelapplication connect no-error.
     2861        if error-status:error then
     2862        do:
     2863           create "excel.application" chexcelapplication no-error.
     2864           if error-status :error then
     2865           do:
     2866              message
     2867                 "Ошибка при запуске Excel" skip
     2868                 error-status :get-message(1) skip
     2869                 view-as alert-box error .
     2870              undo, return error .
     2871           end.
     2872        end.
     2873       if ff = ""  then do:
     2874         chworkbook   = chexcelapplication:workbooks:add( ).
     2875       end.
     2876       else do:
     2877         chworkbook   = chexcelapplication:workbooks:open( ff ).
     2878       end.
     2879     end.
     2880     assign     chexcelapplication:interactive = false      chexcelapplication:screenupdating = false      chexcelapplication:visible = false  .
     2881     chworksheet  = chexcelapplication:sheets:item (1).
     2882   END PROCEDURE.
     2883   PROCEDURE import-proc :
     2884   define variable ii         as integer   no-undo .
     2885   define variable v-i        as integer   no-undo .
     2886   define variable t          as character no-undo .
     2887   define variable g-name-gds as character no-undo .
     2888   define variable g-doz      as character no-undo .
     2889   define variable g-fas      as character no-undo .
     2890   define variable g-form     as character no-undo .
     2891   define variable g-serii    as character no-undo .
     2892   define variable g-prod     as character no-undo .
     2893   define variable g-brak     as character no-undo .
     2894   define variable g-docn     as character no-undo .
     2895   define variable g-dodd     as character no-undo .
     2896   define variable g-fpost    as character no-undo .
     2897   define variable g-rpost    as character no-undo .
     2898   define variable v-desc as character no-undo .
     2899   define buffer buf_ext-classif for ub.ext-classif  .
     2900   ii = 1 .
     2901   v-i = 0 .
     2902   run waitfram-show in this-procedure ("Закачка данных из Excel...")   .
     2903   define variable v-a as integer   no-undo .
     2904   v-a = 0.
     2905    do while  ( ii <= 100000 ) :
     2906       ii = ii  + 1.
     2907       T = string(ii) .
     2908    if chWorkSheet:Range ('A' + T):Value  = ? then v-a = v-a + 1.
     2909    else v-a = 0.
     2910    if v-a >= 4 then leave.
     2911    Assign
     2912     g-name-gds = chWorkSheet:Range ('A' + T):Value
     2913     g-doz      = chWorkSheet:Range ('B' + T):Value
     2914     g-fas      = chWorkSheet:Range ('C' + T):Value
     2915     g-form     = chWorkSheet:Range ('D' + T):Value
     2916     g-serii    = chWorkSheet:Range ('E' + T):Value
     2917     g-prod     = chWorkSheet:Range ('F' + T):Value
     2918     g-brak     = chWorkSheet:Range ('G' + T):Value
     2919     g-docn     = chWorkSheet:Range ('H' + T):Value
     2920     g-dodd     = chWorkSheet:Range ('I' + T):Value
     2921     g-fpost    = chWorkSheet:Range ('J' + T):Value
     2922     g-rpost    = chWorkSheet:Range ('K' + T):Value
     2923     no-error .
     2924     if error-status :error then message
     2925       vss-workfile vss-revision vss-description skip
     2926       error-status :get-message(1) skip
     2927       return-value skip
     2928       ""
     2929       view-as alert-box error
     2930     .
     2931     v-desc = substitute("доза:&1 фасовка:&2 форма:&3 брак:&5документ:&6 от:&7 производитель:&4 фед.пост.:&8 рег.пост.:&9 " ,
     2932               g-doz  ,
     2933               g-fas  ,
     2934               g-form,
     2935               g-prod,
     2936               g-brak,
     2937               g-docn ,
     2938               g-dodd ,
     2939               g-fpost,
     2940               g-rpost
     2941               )
     2942     no-error.
     2943     if g-serii    = ? or
     2944        g-name-gds = ? or
     2945        v-desc     = ?  then next.
     2946     find first ub.ext-classif exclusive-lock where
     2947       ub.ext-classif.classif-name    = 'goods_fib':U    and
     2948       ub.ext-classif.classif-subject = 'goods':U        and
     2949       ub.ext-classif.db-num          =  -1                      and
     2950       ub.ext-classif.CharKey_One     = g-serii                  and
     2951       ub.ext-classif.CharKey_Three   = g-name-gds               and
     2952       ub.ext-classif.CharKey_Two     = v-desc                   and
     2953       ub.ext-classif.Key#_One        = 0                        and
     2954       ub.ext-classif.Key#_Three      = 0                        and
     2955       ub.ext-classif.Key#_Two        = 0                        and
     2956       ub.ext-classif.nonunique       = 0
     2957    no-error .
     2958       if not available ub.ext-classif then do:
     2959         create ub.ext-classif no-error .
     2960         if error-status :error then message
     2961           vss-workfile vss-revision vss-description skip
     2962           error-status :get-message(1) skip
     2963           return-value skip
     2964           "create"
     2965           view-as alert-box error
     2966         .
     2967         assign
     2968           ub.ext-classif.classif-name    = 'goods_fib':U
     2969           ub.ext-classif.classif-subject = 'goods':U
     2970           ub.ext-classif.db-num          =  -1
     2971           ub.ext-classif.CharKey_One     = g-serii
     2972           ub.ext-classif.CharKey_Three   = g-name-gds
     2973           ub.ext-classif.CharKey_Two     = v-desc
     2974           ub.ext-classif.Key#_One        = 0
     2975           ub.ext-classif.Key#_Three      = 0
     2976           ub.ext-classif.Key#_Two        = 0
     2977           ub.ext-classif.nonunique       = 0
     2978         no-error .
     2979         if error-status :error then message
     2980           vss-workfile vss-revision vss-description skip
     2981           error-status :get-message(1) skip
     2982           return-value skip
     2983           "update"
     2984           view-as alert-box error
     2985         .
     2986         v-i = v-i + 1.
     2987       end.
     2988       else do:
     2989       end.
     2990    end.
     2991    run waitfram-hide in this-procedure  .
     2992    message "Импортировано " v-i  " строк".
     2993   END PROCEDURE.
     2994   PROCEDURE init-gds-rec :
     2995   define buffer buf_goods for ub.goods  .
     2996   gds-rec = ? .
     2997   if available buf_ext-classif then do:
     2998     find first   buf_goods no-lock where
     2999                  buf_goods.gds-code = integer ( entry ( 2,buf_ext-classif.uniq-key-rec, chr(3))) no-error .
     3000      if available buf_goods then do:
     3001         gds-rec = recid(buf_goods) .
     3002      end.
     3003   end.
     3004   END PROCEDURE.
     3005   PROCEDURE openbr :
     3006   define input  parameter p-open-query     as logical   no-undo .
     3007   define input  parameter p-find-next      as logical   no-undo .
     3008   define input  parameter p-find-condition as character no-undo .
     3009   def var l-query-was-opened as logical no-undo .
     3010   define variable doc-rec  as recid     no-undo .
     3011   def var sort-column-phrase as character no-undo .
     3012   case sort-column-name :
     3013     when "" then do:
     3014       assign
     3015         sort-column-phrase = ""
     3016       .
     3017     end.
     3018     otherwise do:
     3019       assign
     3020         sort-column-phrase = "by " + sort-column-name
     3021       .
     3022     end.
     3023   end case.
     3024   define variable title0 as character no-undo init "ФиБ" .
     3025   title0 = "ФиБ" .
     3026       if p-open-query then do:
     3027         frame Dialog-Frame:TITLE = title0  .
     3028       end.
     3029   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3030   define variable  l-disable-where-12  as logical   no-undo .
     3031   define variable  l-filter-open-12    as logical   .
     3032   define variable  flt-rec-12       as recid     no-undo .
     3033   define variable  filter-name-12      as character no-undo .
     3034   define variable  where-phrase-12     as character no-undo .
     3035   define variable  sort-phrase-12      as character no-undo .
     3036   define variable  where-phrase-rus-12 as character no-undo .
     3037   define variable  sort-phrase-rus-12  as character no-undo .
     3038     run waitfram-show in this-procedure
     3039       (input "ЖДИТЕ ..."
     3040       ).
     3041   run gbl/flt-get.p
     3042     (input filter-point
     3043     ,output flt-rec-12
     3044     ,output filter-name-12
     3045     ,output where-phrase-12
     3046     ,output sort-phrase-12
     3047     ,output where-phrase-rus-12
     3048     ,output sort-phrase-rus-12
     3049     ).
     3050   if p-open-query then do:
     3051     assign
     3052       l-filter-open-12 = false
     3053     .
     3054     if flt-rec-12 <> ?
     3055       or sort-column-phrase > ""
     3056     then do:
     3057       define variable  parameter-2-12 as character no-undo .
     3058       define variable  parameter-3-12 as character no-undo .
     3059       define variable  parameter-4-12 as character no-undo .
     3060       define variable  parameter-5-12 as character no-undo .
     3061       define variable  parameter-6-12 as character no-undo .
     3062       define variable  parameter-7-12 as character no-undo .
     3063         assign
     3064         parameter-3-12 =
     3065                                 "FOR EACH Buf_ext-classif"
     3066         parameter-4-12 =
     3067           (
     3068             if ("                      Buf_ext-classif.classif-subject = 'goods':U  AND                     Buf_ext-classif.classif-name = 'goods_fib':U                     " + " " + where-phrase-12) <> ""
     3069             then            substitute('            Buf_ext-classif.classif-subject = &1&2&1  AND            Buf_ext-classif.classif-name = &1&3&1 '  ,            chr(34), 'goods':U ,  'goods_fib':U) + " " + where-phrase-12
     3070             else "true"
     3071           )
     3072         parameter-5-12 = (" " + "" + " " + '')
     3073         parameter-6-12 = if sort-phrase-12 = ''
     3074                              then
     3075           (
     3076           " " + " " +
     3077             " " + sort-column-phrase +
     3078           " " + " "
     3079           )
     3080                              else
     3081           (
     3082           " " + " " +
     3083             " " + sort-column-phrase +
     3084           " " + sort-phrase-12
     3085           )
     3086         parameter-7-12 =
     3087           " indexed-reposition  "
     3088       .
     3089       do
     3090       on stop undo, leave
     3091       on error undo, leave
     3092       :
     3093         assign
     3094           l-disable-where-12 =
     3095             ("                      Buf_ext-classif.classif-subject = 'goods':U  AND                     Buf_ext-classif.classif-name = 'goods_fib':U                     " + " " + where-phrase-12 = "")
     3096         .
     3097         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3098                             ,input query BROWSE-ext-goods:handle
     3099                             ,input parameter-3-12
     3100                             ,input parameter-4-12
     3101                             ,input parameter-5-12
     3102                             ,input parameter-6-12
     3103                             ,input parameter-7-12
     3104                             )
     3105         .
     3106         assign
     3107           l-filter-open-12 = true
     3108         .
     3109       end.
     3110       if l-filter-open-12 = false then do:
     3111         message
     3112           "Ошибка при фильтрации / сортировке" skip
     3113           "Будут показаны записи без учета фильтра" skip
     3114           view-as alert-box .
     3115       end.
     3116       else do:
     3117           assign
     3118             l-query-was-opened = true
     3119           .
     3120       end.
     3121     end.
     3122     if l-filter-open-12 = false then do:
     3123       OPEN QUERY BROWSE-ext-goods FOR EACH Buf_ext-classif
     3124         where                       Buf_ext-classif.classif-subject = 'goods':U  AND                     Buf_ext-classif.classif-name = 'goods_fib':U
     3125         indexed-reposition
     3126     .
     3127         assign
     3128           l-query-was-opened = true
     3129         .
     3130     end.
     3131   end.
     3132   else do:
     3133     assign
     3134       doc-rec = recid( buf_ext-classif )
     3135     .
     3136     do
     3137     on stop undo, leave
     3138     on error undo, leave
     3139     :
     3140       if query BROWSE-ext-goods:handle:get-buffer-handle(1) = (buffer Buf_ext-classif:handle) then do:
     3141         assign
     3142         parameter-2-12 = (if p-find-next then "true":u else "false":u )
     3143         parameter-4-12 =
     3144           "where ":u +            substitute('            Buf_ext-classif.classif-subject = &1&2&1  AND            Buf_ext-classif.classif-name = &1&3&1 '  ,            chr(34), 'goods':U ,  'goods_fib':U) + " ":u + where-phrase-12 + " ":u + p-find-condition + " " + ""
     3145         parameter-5-12 = " "
     3146       .
     3147         run fltopend_fltfindd in this-procedure  (
     3148                             input this-procedure:handle
     3149                             ,input query BROWSE-ext-goods:handle
     3150                             ,input rowid(buf_ext-classif)
     3151                             ,input logical(parameter-2-12)
     3152                             ,input no-lock
     3153                             ,input (buffer buf_ext-classif:handle)
     3154                             ,input parameter-4-12
     3155                             ,input parameter-5-12
     3156                             ) no-error.
     3157         .
     3158         assign
     3159           doc-rec = integer(return-value)
     3160           v-fltopend-rowid[1] = ?
     3161         .
     3162       end.
     3163       else do:
     3164         assign
     3165         parameter-2-12 = (if p-find-next then "true":u else "false":u )
     3166         parameter-3-12 =  "FOR EACH Buf_ext-classif"
     3167         parameter-4-12 =
     3168           (
     3169             if ("                      Buf_ext-classif.classif-subject = 'goods':U  AND                     Buf_ext-classif.classif-name = 'goods_fib':U                     " + " " + where-phrase-12) <> ""
     3170             then            substitute('            Buf_ext-classif.classif-subject = &1&2&1  AND            Buf_ext-classif.classif-name = &1&3&1 '  ,            chr(34), 'goods':U ,  'goods_fib':U) + " " + where-phrase-12
     3171             else "true"
     3172           )
     3173         parameter-5-12 = (" " + "" + " " + '' + " " + p-find-condition)
     3174         parameter-6-12 = if sort-phrase-12 = ''
     3175                              then
     3176           (
     3177           " " + " " +
     3178             " " + sort-column-phrase +
     3179           " " + " "
     3180           )
     3181                              else
     3182           (
     3183           " " + " " +
     3184             " " + sort-column-phrase +
     3185           " " + sort-phrase-12
     3186           )
     3187         parameter-7-12 =
     3188           " indexed-reposition  "
     3189       .
     3190         run fltopend_fltfindq in this-procedure  (
     3191                             input this-procedure:handle
     3192                             ,input query BROWSE-ext-goods:handle
     3193                             ,input logical(parameter-2-12)
     3194                             ,input no-lock
     3195                             ,input parameter-3-12
     3196                             ,input parameter-4-12
     3197                             ,input parameter-5-12
     3198                             ,input parameter-6-12
     3199                             ,input parameter-7-12
     3200                             ,output v-fltopend-rowid
     3201                             ) no-error.
     3202         .
     3203         doc-rec = ?.
     3204       end.
     3205       assign
     3206         l-query-was-opened = true
     3207       .
     3208     end.
     3209   end.
     3210     run waitfram-hide in this-procedure .
     3211   if not p-open-query then do:
     3212    reposition BROWSE-ext-goods  to recid doc-rec no-error.
     3213    end.
     3214   if not p-open-query and v-fltopend-rowid[1] <> ? then do:
     3215      query BROWSE-ext-goods:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     3216   end.
     3217   APPLY "VALUE-CHANGED" TO BROWSE-ext-goods in frame Dialog-Frame.
     3218   END PROCEDURE.
     3219   PROCEDURE proc-charm :
     3220   define variable v-ok as logical   no-undo .
     3221   define variable v-first as character no-undo .
     3222   define variable v-uniq-key-rec as character no-undo .
     3223   define buffer buf_goods for ub.goods  .
     3224   message
     3225    "Запустить связывание хранимого списка ФИБ  и справочника товаров TradeHouse ? "
     3226    "Критерий связывания  - по первому слову"
     3227    view-as alert-box question
     3228          BUTTONS yes-no
     3229          TITLE "Внимание !"
     3230          UPDATE v-ok
     3231          .
     3232   if not v-ok then return .
     3233   run waitfram-show in this-procedure ("Процедура связывания товара по первому слову...")   .
     3234   for each buf_ext-classif exclusive-lock where
     3235            buf_ext-classif.db-num          = -1 and
     3236            buf_ext-classif.uniq-key-rec    = "" and
     3237            buf_ext-classif.classif-subject = 'goods':U  and
     3238            buf_ext-classif.classif-name    = 'goods_fib':U :
     3239            v-first = entry( 1 , buf_ext-classif.CharKey_Three, "," ) .
     3240       find first buf_goods no-lock where
     3241                  buf_goods.gds-name begins  substitute("&1" , v-first)  no-error .
     3242      if available buf_goods then do:
     3243           run gen-key-rec IN THIS-PROCEDURE
     3244             ( input 'goods':U
     3245             , input (buffer buf_goods:handle)
     3246             , output v-uniq-key-rec ).
     3247         buf_ext-classif.uniq-key-rec = v-uniq-key-rec .
     3248         buf_ext-classif.whole-send-news = 1.
     3249      end.
     3250   end.
     3251   run waitfram-hide in this-procedure .
     3252   run openbr in this-procedure (yes, no, '':U).
     3253   END PROCEDURE.
     3254   PROCEDURE proc-find-name :
     3255   define input parameter par-next as logical no-undo.
     3256   define input parameter p-var    as char no-undo.
     3257   run openbr in this-procedure (no, par-next , substitute(" and buf_ext-classif.CharKey_Three begins  '&1'" , p-var )) .
     3258   END PROCEDURE.
     3259   PROCEDURE proc-find-name-th :
     3260   define input parameter par-next as logical no-undo.
     3261   define input parameter p-var    as char no-undo.
     3262   run openbr in this-procedure (no, par-next ,
     3263   substitute(' and buf_ext-classif.uniq-key-rec <> "" and dynamic-function(&1f-gds-name&1, recid(buf_ext-classif)) = &1&2&1 ', chr(34), p-var) ).
     3264   END PROCEDURE.
     3265   PROCEDURE proc-find-part-code :
     3266   define input parameter par-next as logical no-undo .
     3267   define input parameter p-var    as character no-undo .
     3268   run openbr in this-procedure ( no , par-next , substitute (" and buf_ext-classif.CharKey_One begins '&1' " , p-var )) .
     3269   END PROCEDURE.
     3270   PROCEDURE proc-find-part-code-th :
     3271   define input parameter par-next as logical no-undo .
     3272   define input parameter p-var    as character no-undo .
     3273   run openbr in this-procedure ( no , par-next ,
     3274       substitute(' and buf_ext-classif.uniq-key-rec = &1goods&3&2&1 ', chr(34),  p-var , chr(3)) ).
     3275   END PROCEDURE.
