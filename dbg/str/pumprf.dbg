        1   CREATE WIDGET-POOL.
        2   define input  parameter parparentproc as   widget-handle       no-undo .
        3   define input  parameter parobj-type   like ub.clients.obj-type no-undo.
        4   define input  parameter parobj-code   like ub.clients.obj-code no-undo.
        5   define output parameter parrec-id     as   recid               no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Выбор ТРК".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE VARIABLE h_b-pump AS HANDLE NO-UNDO.
      112   DEFINE BUTTON b-cancel AUTO-END-KEY
      113        LABEL "&Отмена"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "&Помощь"
      118        SIZE 10 BY 1.
      119   DEFINE BUTTON b-sel AUTO-GO
      120        LABEL "&Выбор"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE FRAME D-Dialog
      124        b-help AT ROW 1.25 COL 38 WIDGET-ID 2
      125        b-sel AT ROW 1.33 COL 2
      126        b-cancel AT ROW 1.33 COL 12.63
      127        SPACE(26.11) SKIP(11.41)
      128       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      129            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      130            TITLE "Выбор ТРК"
      131            DEFAULT-BUTTON b-sel CANCEL-BUTTON b-cancel.
      132   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      133   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      134   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      135   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      136   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      137   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      138   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      139   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      140       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      141   RUN ensure-broker.
      142   THIS-PROCEDURE:ADM-DATA =
      143        'ADM1.1~`':U +
      144        'SmartDialog~`':U +
      145        'DIALOG-BOX~`':U +
      146        'NO ~`':U +
      147        '~`':U +
      148        '~`':U +
      149        '~`':U +
      150        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      151           + "~`":U +
      152        'Layout,Hide-on-Init~`':U +
      153        '~`':U +
      154        '~`':U +
      155        '~`~`~`~`~`~`~`~`~`~`~`':U +
      156        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      157            THEN "^^":U
      158        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      159             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      160   PROCEDURE adm-apply-entry :
      161     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      162   END PROCEDURE.
      163   PROCEDURE adm-destroy :
      164    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      165   END PROCEDURE.
      166   PROCEDURE adm-disable :
      167       DISABLE b-help b-sel b-cancel WITH FRAME D-Dialog.
      168       RUN dispatch ('disable-fields':U).
      169       RUN set-attribute-list ('ENABLED=no':U).
      170       RETURN.
      171   END PROCEDURE.
      172   PROCEDURE adm-edit-attribute-list :
      173         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      174         RETURN.
      175   END PROCEDURE.
      176   PROCEDURE adm-enable :
      177       ENABLE UNLESS-HIDDEN b-help b-sel b-cancel WITH FRAME D-Dialog.
      178       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      179       RUN set-attribute-list ('ENABLED=yes':U).
      180       RETURN.
      181   END PROCEDURE.
      182   PROCEDURE adm-exit :
      183        RUN notify ('exit':U).
      184     RETURN.
      185   END PROCEDURE.
      186   PROCEDURE adm-hide :
      187     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      188   END PROCEDURE.
      189   PROCEDURE adm-initialize :
      190     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      191   END PROCEDURE.
      192   PROCEDURE adm-show-errors :
      193       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      194       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      195           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      196       END.
      197       RETURN.
      198   END PROCEDURE.
      199   PROCEDURE adm-UIB-mode :
      200     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      201   END PROCEDURE.
      202   PROCEDURE adm-view :
      203     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      204   END PROCEDURE.
      205   PROCEDURE dispatch :
      206       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      207       RUN broker-dispatch IN adm-broker-hdl
      208           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      209       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      210   END PROCEDURE.
      211   PROCEDURE ensure-broker :
      212   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      213   IF RETURN-VALUE NE "ADM-Broker":U THEN
      214   DO:
      215       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      216       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      217   END.
      218   END PROCEDURE.
      219   PROCEDURE get-attribute :
      220     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      221     RUN broker-get-attribute IN adm-broker-hdl
      222         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      223     RETURN RETURN-VALUE.
      224   END PROCEDURE.
      225   PROCEDURE get-attribute-list :
      226     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      227     RUN broker-get-attribute-list IN adm-broker-hdl
      228         (INPUT THIS-PROCEDURE,
      229          INPUT ?,
      230          OUTPUT p-attr-list) NO-ERROR.
      231     RETURN.
      232   END PROCEDURE.
      233   PROCEDURE new-state :
      234     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      235     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      236     RETURN.
      237   END PROCEDURE.
      238   PROCEDURE notify :
      239     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      240     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      241     IF RETURN-VALUE = "ADM-ERROR":U THEN
      242         RETURN "ADM-ERROR":U.
      243     RETURN.
      244   END PROCEDURE.
      245   PROCEDURE set-attribute-list :
      246     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      247     RUN ensure-broker.
      248     RUN broker-set-attribute-list IN adm-broker-hdl
      249         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      250     RETURN.
      251   END PROCEDURE.
      252   PROCEDURE set-position :
      253       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      254       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      255       IF VALID-HANDLE(adm-object-hdl) THEN
      256       DO:
      257           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      258           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      259           DO:
      260             IF p-row = 0 THEN p-row =
      261               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      262             IF p-col = 0 THEN p-col =
      263               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      264           END.
      265           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      266           DO:
      267             parent-hdl = adm-object-hdl:PARENT.
      268             IF p-row = 0 THEN p-row =
      269               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      270                 parent-hdl:ROW.
      271             IF p-col = 0 THEN p-col =
      272               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      273                 parent-hdl:COL.
      274           END.
      275           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      276           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      277         ASSIGN adm-object-hdl:ROW    =   p-row
      278                adm-object-hdl:COLUMN =   p-col.
      279       END.
      280       RETURN.
      281   END PROCEDURE.
      282   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      283       STRING(adm-object-hdl)).
      284   PAUSE 0 BEFORE-HIDE.
      285   PROCEDURE adm-change-page :
      286     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      287     END PROCEDURE.
      288   PROCEDURE delete-page :
      289     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      290     RUN broker-delete-page IN adm-broker-hdl
      291         (INPUT THIS-PROCEDURE, INPUT p-page#).
      292     END PROCEDURE.
      293   PROCEDURE init-object :
      294     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      295     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      296     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      297     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      298     RUN broker-init-object IN adm-broker-hdl
      299         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      300          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      301     RETURN.
      302   END PROCEDURE.
      303   PROCEDURE init-pages :
      304     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      305     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      306         INPUT p-page-list) NO-ERROR.
      307     END PROCEDURE.
      308   PROCEDURE select-page :
      309     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      310     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      311         INPUT p-page#) NO-ERROR.
      312     END PROCEDURE.
      313   PROCEDURE view-page :
      314     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      315     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      316         INPUT p-page#).
      317     END PROCEDURE.
      318   ASSIGN
      319          FRAME D-Dialog:SCROLLABLE       = FALSE
      320          FRAME D-Dialog:HIDDEN           = TRUE.
      321   ON WINDOW-CLOSE OF FRAME D-Dialog
      322   DO:
      323     APPLY "END-ERROR":U TO SELF.
      324   END.
      325   run set-attribute-list ('parparentproc='  + string(parparentproc)).
      326   run set-attribute-list ('obj-type=' + string(parobj-type)).
      327   run set-attribute-list ('obj-code=' + string(parobj-code)).
      328   run set-attribute-list ('buttons=b-help').
      329   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      330       MESSAGE "A SmartDialog is not intended ":U SKIP
      331               "to be run Persistent or to be placed ":U SKIP
      332               "in another SmartObject at UIB design time.":U
      333               VIEW-AS ALERT-BOX ERROR.
      334       RUN disable_UI.
      335       DELETE PROCEDURE THIS-PROCEDURE.
      336       RETURN.
      337   END.
      338   RUN dispatch ('create-objects':U).
      339   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      340   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      341   MAIN-BLOCK:
      342   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      343      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      344     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      345     WAIT-FOR GO OF FRAME D-Dialog.
      346   END.
      347   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      348   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   on help of frame D-Dialog
      350   do:
      351     run gbl/app_help.p
      352       (input this-procedure :file-name
      353       ,input ''
      354       ,input ?
      355       ) no-error.
      356     if error-status :error then do:
      357       message
      358         "Ошибка при вызове помощи"
      359         error-status :get-message(1)
      360         view-as alert-box .
      361     end.
      362   end.
      363   run minbtn-set in this-procedure .
      364   on choose of b-help in frame D-Dialog
      365   do:
      366     apply "help":u to frame D-Dialog .
      367   end.
      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   procedure minbtn-set :
      370       do
      371           on error undo, return error return-value
      372           :
      373           define variable ii              as integer       no-undo .
      374           define variable fh              as widget-handle no-undo .
      375           define variable hh              as widget-handle no-undo .
      376           define variable v-h             as handle        extent 4 no-undo .
      377           define variable v-name-button   as character     no-undo .
      378           define variable v-help-old-x    as decimal       no-undo .
      379           define variable v-help-old-y    as decimal       no-undo .
      380           define variable v-help-old-size as decimal       no-undo .
      381           define variable v-frame-width   as decimal       no-undo .
      382           define variable jj              as integer       no-undo .
      383           do
      384               on error undo, return error
      385               :
      386               assign
      387                   v-frame-width = frame D-Dialog:width - 0.3
      388                   fh            = frame D-Dialog:first-child
      389                   hh            = fh:first-child
      390                   ii            = 1
      391                   .
      392               do while valid-handle(hh):
      393                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      394                   do:
      395                       case lc(hh:name) :
      396                           when "b-help" then
      397                               do:
      398                                   hh:load-image-up("cmp/b-help.bmp":u) .
      399                                   hh:load-image-down("cmp/b-help.bmp":u) .
      400                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      401                                   hh:TOOLTIP = "Помощь" .
      402                                   v-help-old-x = hh:column .
      403                                   v-help-old-y = hh:row    .
      404                                   v-help-old-size = hh:width .
      405                                   hh:width-chars = 2.5 .
      406                               end.
      407                           when "b-print" then
      408                               do:
      409                                   hh:load-image("cmp/b-print.bmp":u) .
      410                                   hh:TOOLTIP = "Печать" .
      411                                   v-h[ii] = hh:handle .
      412                                   ii = ii + 1 .
      413                                   hh:width-chars = 3 .
      414                               end.
      415                           when "b-history" or
      416                           when "b-hist" then
      417                               do:
      418                                   hh:load-image("cmp/b-hist.bmp":u) .
      419                                   hh:TOOLTIP = "История" .
      420                                   v-h[ii] = hh:handle .
      421                                   ii = ii + 1 .
      422                                   hh:width-chars = 3 .
      423                               end.
      424                           when "b-sch" then
      425                               do:
      426                                   hh:load-image("cmp/b-sch.bmp":u) .
      427                                   hh:TOOLTIP = "Установка Фильтра" .
      428                                   v-h[ii] = hh:handle .
      429                                   ii = ii + 1 .
      430                                   hh:width-chars = 3 .
      431                               end.
      432                           when "b-hist-user" then
      433                               do:
      434                                   hh:load-image("cmp/b-hist.bmp":u) .
      435                                   hh:TOOLTIP = "История пользователя" .
      436                                   ii = ii + 1 .
      437                               end.
      438                       end case.
      439                   end.
      440                   hh = hh:next-sibling.
      441               end.
      442               b-help:column = v-frame-width - b-help:width-chars.
      443               jj = 0.
      444               repeat ii = 4 to 1 by -1 :
      445                   if valid-handle (v-h[ii] ) then
      446                   do:
      447                       jj  = jj + 1 .
      448                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      449                       v-h[ii]:row    = v-help-old-y .
      450                   end.
      451               end.
      452           end.
      453       end.
      454   end procedure.
      455   PROCEDURE adm-create-objects :
      456     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
      457     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
      458     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
      459     CASE adm-current-page:
      460       WHEN 0 THEN DO:
      461          RUN init-object IN THIS-PROCEDURE (
      462                INPUT  'str/b-pump.w':U ,
      463                INPUT  FRAME D-Dialog:HANDLE ,
      464                INPUT  'Layout = ':U ,
      465                OUTPUT h_b-pump ).
      466          RUN set-position IN h_b-pump ( 2.79 , 1.50 ) NO-ERROR.
      467          RUN set-size IN h_b-pump ( 10.54 , 46.25 ) NO-ERROR.
      468          RUN add-link IN adm-broker-hdl ( h_b-pump , 'recid-pump':U , THIS-PROCEDURE ).
      469          RUN adjust-tab-order IN adm-broker-hdl ( h_b-pump ,
      470                b-cancel:HANDLE , 'AFTER':U ).
      471       END.
      472     END CASE.
      473   END PROCEDURE.
      474   PROCEDURE adm-row-available :
      475     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      476     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      477     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      478     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      479     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      480     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      481     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      482     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      483     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      484     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      485     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      486     IF adm-updating-record THEN RETURN.
      487     RUN get-attribute ('FIELDS-ENABLED':U).
      488     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      489     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      490         OUTPUT link-handle) NO-ERROR.
      491     IF link-handle = "":U THEN
      492         RETURN.
      493     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      494     IF NUM-ENTRIES(link-handle) > 1 THEN
      495         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      496             "encountered more than one RECORD-SOURCE.":U SKIP
      497             "The first - ":U record-source-hdl:file-name " - will be used.":U
      498                VIEW-AS ALERT-BOX ERROR.
      499     RUN get-attribute ('Key-Name':U).
      500     key-name = RETURN-VALUE.
      501     IF key-name = "":U THEN key-name = ?.
      502     IF key-name NE ? THEN DO:
      503       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      504         NO-ERROR.
      505       IF key-value NE ? THEN
      506         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      507     END.
      508   IF VALID-HANDLE (adm-object-hdl) THEN
      509       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      510   RUN notify IN THIS-PROCEDURE ('row-available':U).
      511   END PROCEDURE.
      512   PROCEDURE disable_UI :
      513     HIDE FRAME D-Dialog.
      514   END PROCEDURE.
      515   PROCEDURE enable_UI :
      516     ENABLE b-help b-sel b-cancel
      517         WITH FRAME D-Dialog.
      518     VIEW FRAME D-Dialog.
      519   END PROCEDURE.
      520   PROCEDURE recid-pump :
      521     RUN get-attribute IN h_b-pump (INPUT 'recid-pump':U).
      522     assign parrec-id = integer(return-value).
      523   END PROCEDURE.
      524   PROCEDURE send-records :
      525   END PROCEDURE.
      526   PROCEDURE state-changed :
      527     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      528     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      529   END PROCEDURE.
