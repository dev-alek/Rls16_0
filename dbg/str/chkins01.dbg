        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode    as character no-undo .
        4   define input parameter pardoc-code like ub.chk-pay.doc-code no-undo .
        5   define input parameter pardoc-type as integer no-undo .
        6   define input parameter parchk-type like ub.chk-doc.chk-type no-undo .
        7   define input parameter parobj-type like ub.clients.obj-type no-undo .
        8   define input parameter parobj-code like ub.clients.obj-code no-undo .
        9   define input parameter parchk-date like ub.chk-doc.chk-date no-undo .
       10   define input parameter parchk-time like ub.chk-doc.chk-time no-undo .
       11   define input parameter parpay-code like ub.chk-pay.pay-code no-undo .
       12   define input parameter parcurr-code like ub.chk-pay.curr-code no-undo .
       13   define input parameter parbase-code like ub.sysconf.base-code no-undo .
       14   define input parameter r-b as character no-undo .
       15   define input parameter parcas-curs as logical no-undo .
       16   define input parameter parline-num like ub.chk-pay.line-num no-undo .
       17   define input parameter parcash-rate as decimal no-undo .
       18   define input parameter parbank-rate as decimal no-undo .
       19   define input parameter parbank-scale as integer no-undo .
       20   define input parameter par-sum as decimal no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       22   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       23   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile: chkins01.p $":U .
       25   define variable vss-archive     as character no-undo init "$Archive: str/chkins01.p $":U .
       26   define variable vss-description as character no-undo init "Сохранение изменений в строке оплаты чека МЦ".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   DEFINE VARIABLE var-entry as character no-undo .
       86   DEFINE VARIABLE varopl-curs as decimal no-undo .
       87   DEFINE VARIABLE varbase-curs as decimal no-undo .
       88   define variable v-par-code as integer no-undo .
       89   define buffer buf_chk-doc for ub.chk-doc.
       90   define buffer buf_chk-pay  for ub.chk-pay.
       91   if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
       92     message
       93     vss-workfile vss-revision vss-description skip
       94     "Неверный параметр вызова par-mode" par-mode
       95     view-as alert-box ERROR.
       96     return error '':U.
       97   end.
       98   FIND FIRST buf_chk-doc EXCLUSIVE-LOCK WHERE
       99              buf_chk-doc.doc-code = pardoc-code No-ERROR No-WAIT.
      100   IF LOCKED buf_chk-doc then do:
      101     message vss-workfile vss-revision vss-description skip
      102             "Запись шапки чека МЦ" pardoc-code "занята"
      103             "добавление/изменение строки невозможно"
      104     view-as alert-box error .
      105   end.
      106   IF NOT available buf_chk-doc then do:
      107     message vss-workfile vss-revision vss-description skip
      108             "Не найден чек МЦ" pardoc-code
      109     view-as alert-box error .
      110   end.
      111   if buf_chk-doc.out-code <> ? then do:
      112     message
      113     vss-workfile vss-revision vss-description skip
      114     "Чек МЦ имеет включен в документ" buf_chk-doc.out-code
      115    "добавление/изменение строки невозможно"
      116     view-as alert-box ERROR.
      117     return error '':U.
      118   end.
      119   run trg/chkins02.p (
      120                     input  pardoc-code
      121                    ,input  pardoc-type
      122                    ,input  parchk-type
      123                    ,input  parobj-type
      124                    ,input  parobj-code
      125                    ,input  parchk-date
      126                    ,input  parchk-time
      127                    ,input  parpay-code
      128                    ,input  parcurr-code
      129                    ,input  parbase-code
      130                    ,input  r-b
      131                    ,input  parcas-curs
      132                    ,input-output  parcash-rate
      133                    ,input-output  parbank-rate
      134                    ,input-output  parbank-scale
      135                    ,input  par-rid
      136                    ,output varbase-curs
      137                    ,output varopl-curs
      138                    ,output v-par-code
      139                  ) no-error.
      140   if error-status:error then return error.
      141   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      142     FIND FIRST buf_chk-pay NO-LOCK WHERE
      143               buf_chk-pay.doc-code    = pardoc-code   AND
      144               buf_chk-pay.line-num    = parline-num  NO-ERROR.
      145     IF AVAIL buf_chk-pay THEN DO:
      146       MESSAGE
      147       "Уже есть строка оплат с номером строки" parline-num "в чеке МЦ" pardoc-code
      148       VIEW-AS ALERT-BOX ERROR.
      149       var-entry = "line-num":U.
      150       RETURN ERROR var-entry.
      151     END.
      152   end.
      153   if par-mode = 'ИЗМЕНЕНИЕ':U and par-sum = 0 then do:
      154     MESSAGE
      155     "Сумма МЦ по строчке чека равна 0 - строка " parline-num  "чек МЦ" pardoc-code
      156     VIEW-AS ALERT-BOX ERROR.
      157     var-entry = "sum":U.
      158     RETURN ERROR var-entry.
      159   end.
      160   DO ON ERROR UNDO, return '':U
      161      On STOP UNDO, return '':U:
      162     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      163       CREATE buf_chk-pay .
      164       assign
      165       buf_chk-pay.doc-code = pardoc-code
      166       buf_chk-pay.line-num = parline-num
      167       .
      168       assign par-rid = recid(buf_chk-pay).
      169     end.
      170     else do:
      171       FIND FIRST buf_chk-pay EXCLUSIVE-LOCK WHERE
      172                 recid(buf_chk-pay) = par-rid No-WAIT No-ERROR.
      173       if locked buf_chk-pay then do:
      174         message "Строка чека МЦ занята"
      175         view-as alert-box error .
      176         return error '':U.
      177       end.
      178       if not avail buf_chk-pay then do:
      179         message "Не найдена строка чека МЦ"
      180         view-as alert-box error .
      181         return error '':U.
      182       end.
      183       if (buf_chk-pay.doc-code <> pardoc-code OR
      184         buf_chk-pay.pay-code <> parpay-code OR
      185         buf_chk-pay.curr-code <> parcurr-code OR
      186         buf_chk-pay.line-num <> parline-num OR
      187         buf_chk-pay.obj-type <> parobj-type OR
      188         buf_chk-pay.obj-code <> parobj-code ) then dO:
      189         message
      190         vss-workfile vss-revision vss-description skip
      191         "При редактировании чека МЦ"
      192         "возможно изменить только сумму и курсы валют"
      193         view-as alert-box ERROR.
      194         return error '':U.
      195       end.
      196     end.
      197   assign
      198   buf_chk-pay.doc-code = pardoc-code
      199   buf_chk-pay.line-num = parline-num
      200   buf_chk-pay.chk-date = buf_chk-doc.chk-date
      201   buf_chk-pay.pay-code = parpay-code
      202   buf_chk-pay.curr-code = parcurr-code
      203   buf_chk-pay.obj-code = parobj-code
      204   buf_chk-pay.obj-type = parobj-type
      205   buf_chk-pay.pay-card = ''
      206   buf_chk-pay.cash-rate = parcash-rate
      207   buf_chk-pay.bank-rate = parbank-rate
      208   buf_chk-pay.bank-scale = parbank-scale
      209   buf_chk-pay.time-oper = (if par-mode = 'ДОБАВЛЕНИЕ':U then parchk-time else buf_chk-pay.time-oper )
      210   buf_chk-pay.tot-sum = par-sum
      211   buf_chk-pay.tot-rubl = 0
      212   buf_chk-pay.tot-base = 0
      213   buf_chk-pay.out-code = ?
      214   .
      215   return '':U.
      216   END.
