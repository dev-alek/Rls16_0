      388   define variable v-fbrlib-recipe-order               as integer  no-undo.
      389   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   procedure cur-time :
      391      define output parameter p-today as date      no-undo .
      392      define output parameter p-time  as integer   no-undo .
      393     do
      394     on error undo, return error
      395     :
      396       define variable v-date1 as date      no-undo .
      397       define variable v-date2 as date      no-undo .
      398       define variable v-time  as integer   no-undo .
      399       assign
      400         v-date1 = today
      401         v-time  = time
      402         v-date2 = today
      403       .
      404       if v-date1 <> v-date2
      405       then do:
      406         assign
      407           v-date1 = today
      408           v-time  = v-time
      409         .
      410       end.
      411       assign
      412         p-today = v-date1
      413         p-time  = v-time
      414       .
      415     end.
      416   end.
      417   function cur-time-date returns character
      418   :
      419     return string(today, '99/99/9999':U) .
      420   end.
      421   function cur-time-mjd returns decimal
      422   :
      423     define variable v-date as date      no-undo .
      424     define variable v-time as integer   no-undo .
      425     run cur-time in this-procedure
      426       (output v-date
      427       ,output v-time
      428       ) .
      429     return integer(v-date) - 2400002 + (v-time / 86400) .
      430   end.
      431   function cur-time-get-ending-index returns integer
      432   (input p-number as integer
      433   )
      434   :
      435     if p-number < 0
      436     or p-number = ?
      437     then do:
      438       return 1 .
      439     end.
      440     define variable v-rest as integer   no-undo .
      441     assign
      442       p-number = p-number modulo 100
      443     .
      444     if p-number < 20
      445     then do:
      446       assign
      447         v-rest = p-number
      448       .
      449     end.
      450     else do:
      451       assign
      452         v-rest = p-number modulo 10
      453       .
      454     end.
      455     case v-rest :
      456       when 1
      457       then do:
      458         return 2 .
      459       end.
      460       when 2 or
      461       when 3 or
      462       when 4
      463       then do:
      464         return 3 .
      465       end.
      466       otherwise do:
      467         return 1 .
      468       end.
      469     end case .
      470   end.
      471   procedure cur-time-mjd-to-date :
      472      define input  parameter i-mjd-diff as decimal no-undo.
      473      define output parameter o-Date     as date    no-undo.
      474      define output parameter o-Time     as integer no-undo.
      475      define variable v-day-number as integer   no-undo .
      476      if    i-mjd-diff < 0
      477         or i-mjd-diff = ?
      478      then do:
      479         return "?" .
      480      end.
      481      assign
      482         v-day-number = truncate(i-mjd-diff,0).
      483         o-Date = date(v-day-number + 2400002).
      484         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      485     .
      486   end.
      487   function cur-time-mjd-to-string returns character
      488   (input p-mjd-diff as decimal
      489   )
      490   :
      491     define variable v-day-number as integer   no-undo .
      492     define variable v-seconds    as integer   no-undo .
      493     define variable v-hour       as integer   no-undo .
      494     define variable v-min        as integer   no-undo .
      495     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      496     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      497     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      498     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      499     if p-mjd-diff < 0
      500     or p-mjd-diff = ?
      501     then do:
      502       return "?" .
      503     end.
      504     assign
      505       v-day-number = integer(truncate(p-mjd-diff,0))
      506       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      507     .
      508     if v-seconds > 86400
      509     then do:
      510       assign
      511         v-seconds = 86400 - 1
      512       .
      513     end.
      514     if v-seconds < 0
      515     then do:
      516       assign
      517         v-seconds = 0
      518       .
      519     end.
      520     assign
      521       v-hour = truncate(v-seconds / 3600, 0)
      522     .
      523     assign
      524       v-seconds = v-seconds modulo 3600
      525     .
      526     assign
      527       v-min = truncate(v-seconds / 60, 0)
      528     .
      529     assign
      530       v-seconds = v-seconds modulo 60
      531     .
      532     return
      533         (if v-day-number <> 0
      534           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      535           else ""
      536         )
      537       + (if v-day-number <> 0 or v-hour <> 0
      538           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      539           else ""
      540         )
      541       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      542           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      543           else ""
      544         )
      545       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      546       .
      547   end.
      548   function cur-time-string returns character
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      557   end.
      558   function cur-time-string-sec returns character
      559   :
      560     define variable v-date as date      no-undo .
      561     define variable v-time as integer   no-undo .
      562     run cur-time in this-procedure
      563       (output v-date
      564       ,output v-time
      565       ) .
      566     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      567   end.
      568   function cur-time-custom  returns character
      569   (input p-prefix as character
      570   ,input p-date-format as character
      571   ,input p-delimiter as character
      572   ,input p-time-format as character
      573   ,input p-suffix as character
      574   )
      575   :
      576     define variable v-date as date      no-undo .
      577     define variable v-time as integer   no-undo .
      578     run cur-time in this-procedure
      579       (output v-date
      580       ,output v-time
      581       ) .
      582     return
      583       p-prefix
      584       + string(v-date, p-date-format)
      585       + p-delimiter
      586       + string(v-time, p-time-format)
      587       + p-suffix
      588       .
      589   end.
      590   function cur-time-print  returns character
      591   :
      592     define variable v-date as date      no-undo .
      593     define variable v-time as integer   no-undo .
      594     run cur-time in this-procedure
      595       (output v-date
      596       ,output v-time
      597       ) .
      598     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      599   end.
      600   function cur-time-datetime returns datetime
      601   :
      602     define variable v-char as character no-undo .
      603     define variable v-datetime as datetime no-undo .
      604     v-char = cur-time-string().
      605     v-datetime = datetime(v-char).
      606     return  v-datetime.
      607   end.
      608   function cur-time-string-msec returns character
      609   :
      610     define variable v-date as datetime  no-undo .
      611     v-date = now.
      612     return string(v-date) .
      613   end.
      614   procedure fbrlib_create-fbr-doc :
      615   define input parameter p-obj-type as character no-undo .
      616   define input parameter p-obj-code as integer no-undo .
      617   define input parameter p-userid as character no-undo .
      618   define output parameter p-fbr-doc-code as character no-undo .
      619   define output parameter p-recid as recid no-undo .
      620   define variable v-host-code as integer no-undo .
      621   define variable v-base-code as integer no-undo .
      622   define variable v-obj-db-num as integer no-undo .
      623   define variable v-db-num as integer no-undo .
      624   DEFINE VARIABLE v-today as date no-undo .
      625   DEFINE VARIABLE v-time as integer no-undo .
      626   define variable v-doc-code as character no-undo .
      627   define variable fi-pay-code as integer no-undo .
      628   define buffer buf_fbr-doc for ub.fbr-doc.
      629   define buffer buf_curr-accnt for ub.curr-accnt.
      630   do
      631   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      632   on stop   undo , return error substitute( "&1. stop", vss-workfile )
      633   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      634   :
      635   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      637     (input  p-obj-type
      638     ,input  p-obj-code
      639     ,output v-host-code
      640     )  .
      641   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      643     (input  p-obj-type
      644     ,input  p-obj-code
      645     ,output v-obj-db-num
      646     )  .
      647   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      649     (output v-db-num
      650     )  .
      651   if v-obj-db-num <> v-db-num then do:
      652     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
      653                             , chr(10)
      654                             , p-obj-type
      655                             , p-obj-code
      656                             , v-obj-db-num
      657                             , v-db-num).
      658   end.
      659   run cur-time in this-procedure ( output v-today, output v-time).
      660   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      662     (input  p-obj-type
      663     ,input  p-obj-code
      664     ,output v-today
      665     )  .
      666   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      668     (input  v-host-code
      669     ,output v-base-code
      670     )  .
      671   find last buf_curr-accnt no-lock
      672       where buf_curr-accnt.curr-code = v-base-code
      673         and buf_curr-accnt.exch-date <= v-today use-index pi
      674   no-error.
      675   if not available buf_curr-accnt
      676   then do:
      677     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
      678                                     , string(v-today, "99/99/9999")
      679                                     , v-base-code).
      680   end.
      681   run doc-code in this-procedure (
      682         input  "main"
      683       , input  p-obj-type
      684       , input  p-obj-code
      685       , input  ?
      686       , output v-doc-code
      687   ) no-error.
      688   if error-status:error
      689   then do:
      690     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
      691                                   , chr(10)
      692                                   , error-status:get-message(1)
      693                                   , return-value ).
      694   end.
      695   run trg/chkdocnm.p (
      696         input v-doc-code
      697       , input 'fbr-doc':U
      698       , input ?
      699   ) no-error.
      700   if error-status:error
      701   then do:
      702     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
      703                                   , chr(10)
      704                                   , error-status:get-message(1)
      705                                   , return-value ).
      706   end.
      707   create buf_fbr-doc.
      708   assign
      709   buf_fbr-doc.doc-code  = v-doc-code
      710   buf_fbr-doc.creid     = p-userid
      711   buf_fbr-doc.doc-date  = v-today
      712   buf_fbr-doc.doc-type  = 'производство':U
      713   buf_fbr-doc.host-code = v-host-code
      714   buf_fbr-doc.obj-code  = p-obj-code
      715   buf_fbr-doc.obj-type  = p-obj-type
      716   buf_fbr-doc.PS        = "@"
      717   buf_fbr-doc.status_   = 'новый':U
      718   buf_fbr-doc.user-db-num = v-obj-db-num
      719   buf_fbr-doc.user-name   = p-userid
      720   .
      721   run fbrlib_get-default-pay-code in this-procedure (
      722         input buf_fbr-doc.obj-type
      723       , input buf_fbr-doc.obj-code
      724       , output fi-pay-code
      725   ).
      726   buf_fbr-doc.pay-code = fi-pay-code.
      727   p-recid = recid(buf_fbr-doc).
      728   p-fbr-doc-code = buf_fbr-doc.doc-code.
      729   end.
      730   end procedure.
      731   procedure fbrlib_get-default-pay-code :
      732   define input parameter p-obj-type   as character        no-undo.
      733   define input parameter p-obj-code   as integer          no-undo.
      734   define output parameter p-pay-code  as integer          no-undo.
      735   define variable v-host-code as integer no-undo .
      736   define buffer buf_shop          for ub.shop.
      737   define buffer buf_store         for ub.store.
      738   define buffer buf_sysconf       for ub.sysconf.
      739   do
      740   for buf_shop
      741     , buf_store
      742     , buf_sysconf
      743   on error undo, return error
      744   :
      745     case p-obj-type  :
      746       when 'маг':U then do:
      747           find first buf_shop no-lock
      748                 where buf_shop.obj-code = p-obj-code
      749           no-error.
      750           if available buf_shop
      751           then do:
      752               assign
      753                   p-pay-code = buf_shop.fbr-pay
      754               .
      755           end.
      756       end.
      757       when 'скл':U then do:
      758           find first buf_store no-lock
      759                 where buf_store.obj-code = p-obj-code
      760           no-error.
      761           if available buf_store
      762           then do:
      763               assign
      764                   p-pay-code = buf_store.fbr-pay
      765               .
      766           end.
      767       end.
      768     end case.
      769     if p-pay-code = ?
      770     or p-pay-code = 0
      771     then do:
      772   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      774     (input  p-obj-type
      775     ,input  p-obj-code
      776     ,output v-host-code
      777     )  .
      778         find first buf_sysconf no-lock
      779               where buf_sysconf.host-code = v-host-code
      780         no-error.
      781         if available buf_sysconf
      782         then do:
      783             assign
      784                 p-pay-code = buf_sysconf.fbr-pay
      785             .
      786         end.
      787     end.
      788     if p-pay-code = ?
      789     or p-pay-code = 0
      790     then do:
      791   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
      793     (input  p-obj-type
      794     ,input  p-obj-code
      795     ,output p-pay-code
      796     )  .
      797     end.
      798   end.
      799   end procedure.
      800   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
      801   do
      802   on error undo, return error
      803   :
      804   define input parameter p-fbr-doc-code as character    no-undo.
      805       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
      806       define variable v-gds-name      as character    no-undo.
      807       define buffer buf_fbr-doc               for ub.fbr-doc.
      808       define buffer buf_fbr-line              for ub.fbr-line.
      809       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
      810       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
      811       find first buf_fbr-doc no-lock
      812            where buf_fbr-doc.doc-code = p-fbr-doc-code
      813       .
      814       for each buf_temp_fbrlib_recipe
      815       :
      816           delete buf_temp_fbrlib_recipe.
      817       end.
      818       for each buf_fbr-line no-lock
      819          where buf_fbr-line.doc-code = p-fbr-doc-code
      820       :
      821           find first buf_temp_fbrlib_recipe
      822                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
      823           no-error.
      824           if not available buf_temp_fbrlib_recipe
      825           then do:
      826               create buf_temp_fbrlib_recipe.
      827               assign
      828                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
      829                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
      830               .
      831           end.
      832       end.
      833       for each buf_temp_fbrlib_recipe
      834       :
      835           assign
      836               buf_temp_fbrlib_recipe.count-income                = 0
      837               buf_temp_fbrlib_recipe.qnty-income                 = 0
      838               buf_temp_fbrlib_recipe.sum-income-sale             = 0
      839               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
      840               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
      841               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
      842               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
      843               buf_temp_fbrlib_recipe.count-write-off             = 0
      844               buf_temp_fbrlib_recipe.qnty-write-off              = 0
      845               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
      846               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
      847               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
      848               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
      849               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
      850           .
      851           for each buf_fbr-line no-lock
      852              where buf_fbr-line.doc-code     = p-fbr-doc-code
      853                and buf_fbr-line.trn-type     = 'при':U
      854                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
      855           :
      856               if ( buf_fbr-line.price-base   = ?
      857                   or buf_fbr-line.price-rubl = ?
      858                   or buf_fbr-line.price-base <= 0
      859                   or buf_fbr-line.price-rubl <= 0 )
      860               and buf_fbr-line.fact-qnty <> 0
      861               and buf_fbr-line.rsrv-qnty <> ?
      862               and buf_fbr-doc.is-free    = no
      863               then do:
      864   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
      866     (input  buf_fbr-line.artic
      867     ,input  buf_fbr-line.prod-type
      868     ,input  buf_fbr-line.prod-code
      869     ,output v-gds-name
      870     ) no-error .
      871                   if error-status :error
      872                   then do:
      873                       assign
      874                           v-gds-name = ""
      875                       .
      876                   end.
      877                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
      878                                                 ,vss-description
      879                                                 ,buf_fbr-doc.doc-code
      880                                                 ,chr(10)
      881                                                 ,buf_fbr-line.recipe-code
      882                                                 ,buf_fbr-line.artic
      883                                                 ,v-gds-name).
      884               end.
      885               assign
      886                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
      887                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
      888                                                                   + buf_fbr-line.fact-qnty
      889                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
      890                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
      891               .
      892               if buf_fbr-line.is-waste = no
      893               then do:
      894                   assign
      895                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
      896                                                                       + buf_fbr-line.price-sum-base
      897                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
      898                                                                       + buf_fbr-line.price-sum-rubl
      899                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      900                                                                       + buf_fbr-line.price-sum-vat-base
      901                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      902                                                                       + buf_fbr-line.price-sum-vat-rubl
      903                   .
      904               end.
      905           end.
      906           for each buf_fbr-line no-lock
      907              where buf_fbr-line.doc-code     = p-fbr-doc-code
      908                and buf_fbr-line.trn-type     = 'спи':U
      909                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
      910           :
      911               if ( buf_fbr-line.price-base   = ?
      912                   or buf_fbr-line.price-rubl = ?
      913                   or buf_fbr-line.price-base <= 0
      914                   or buf_fbr-line.price-rubl <= 0 )
      915               and buf_fbr-line.fact-qnty <> 0
      916               and buf_fbr-line.rsrv-qnty <> ?
      917               and buf_fbr-doc.is-free    = no
      918               and buf_fbr-doc.status_    = 'разрешен':U
      919               then do:
      920   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
      922     (input  buf_fbr-line.artic
      923     ,input  buf_fbr-line.prod-type
      924     ,input  buf_fbr-line.prod-code
      925     ,output v-gds-name
      926     ) no-error .
      927                   if error-status :error
      928                   then do:
      929                       assign
      930                           v-gds-name = ""
      931                       .
      932                   end.
      933                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
      934                                                 ,vss-description
      935                                                 ,buf_fbr-doc.doc-code
      936                                                 ,chr(10)
      937                                                 ,buf_fbr-line.recipe-code
      938                                                 ,buf_fbr-line.artic
      939                                                 ,v-gds-name).
      940               end.
      941               assign
      942                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
      943                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
      944                                                                   + buf_fbr-line.fact-qnty
      945                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
      946                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
      947               .
      948               if buf_fbr-line.is-waste = no
      949               then do:
      950                   assign
      951                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
      952                                                                       + buf_fbr-line.price-sum-base
      953                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      954                                                                       + buf_fbr-line.price-sum-rubl
      955                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      956                                                                       + buf_fbr-line.price-sum-vat-base
      957                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      958                                                                       + buf_fbr-line.price-sum-vat-rubl
      959                   .
      960               end.
      961           end.
      962           if buf_fbr-doc.status_    = 'разрешен':U
      963           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
      964           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
      965           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
      966           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
      967               )
      968           then do:
      969            undo, return error
      970               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
      971                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
      972                           "Сумма в баз.вал.&4&5&4&4&6&2" +
      973                           "Сумма в &9.&4&7&4&4&8&2"
      974                          , buf_fbr-doc.doc-code
      975                          , chr(10)
      976                          , buf_temp_fbrlib_recipe.recipe-code
      977                          , chr(9)
      978                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
      979                          , buf_temp_fbrlib_recipe.sum-income-cost-base
      980                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      981                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
      982                          , "руб"
      983                          )
      984              +
      985              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
      986                         "НДС в &7.&1&5&1&1&6&4"
      987                        ,  chr(9)
      988                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      989                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      990                        ,chr(10)
      991                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      992                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      993                        ,"руб"
      994                        )       .
      995           end.
      996       end.
      997   end.
      998   end procedure.
      999   procedure fbrlib-fill-sum-fbr-doc :
     1000   do
     1001   on error undo, return error
     1002   :
     1003   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1004   define input parameter p-mode           as character    no-undo.
     1005       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1006       define buffer buf_fbr-doc           for ub.fbr-doc.
     1007       define buffer buf_fbr-line          for ub.fbr-line.
     1008       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1009       define variable v-in-count          as integer       no-undo.
     1010       define variable v-out-count         as integer       no-undo.
     1011       find first buf_fbr-doc exclusive-lock
     1012            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1013       .
     1014       find first buf_temp_fbrlib_recipe no-error.
     1015       if not available buf_temp_fbrlib_recipe
     1016       then do:
     1017           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1018               input buf_fbr-doc.doc-code
     1019           ) no-error.
     1020           if error-status :error
     1021           then do:
     1022               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1023                                              , vss-description
     1024                                              , chr(10)
     1025                                              , error-status:get-message(1)
     1026                                              , return-value ).
     1027           end.
     1028       end.
     1029       assign
     1030           v-in-count                  = 0
     1031           buf_fbr-doc.in-qnty         = 0
     1032           buf_fbr-doc.in-sale         = 0
     1033           buf_fbr-doc.in-base         = 0
     1034           buf_fbr-doc.in-rubl         = 0
     1035           buf_fbr-doc.in-vat-base     = 0
     1036           buf_fbr-doc.in-vat-rubl     = 0
     1037           v-out-count                 = 0
     1038           buf_fbr-doc.out-qnty        = 0
     1039           buf_fbr-doc.out-sale        = 0
     1040           buf_fbr-doc.out-base        = 0
     1041           buf_fbr-doc.out-rubl        = 0
     1042           buf_fbr-doc.out-vat-base    = 0
     1043           buf_fbr-doc.out-vat-rubl    = 0
     1044       .
     1045       for each buf_temp_fbrlib_recipe
     1046       :
     1047           assign
     1048               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1049               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1050               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1051               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1052               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1053               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1054               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1055               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1056               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1057               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1058               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1059               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1060               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1061               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1062           .
     1063       end.
     1064       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1065       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1066       or p-mode <> 'факт':U
     1067       then do:
     1068           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1069           then do:
     1070               assign
     1071                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1072                                   + string( v-out-count, ">>>,>>9" )
     1073                                   + chr(10) + "Строк исходных товаров : "
     1074                                   + string( v-in-count, ">>>,>>9" )
     1075               .
     1076           end.
     1077       end.
     1078       else do:
     1079         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1080                                       "Сумма списанных товаров в &3 - &4&2" +
     1081                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1082                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1083                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1084                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1085                                       , buf_fbr-doc.doc-code
     1086                                       , chr(10)
     1087                                       , "рублях"
     1088                                       , round( buf_fbr-doc.out-rubl, 2 )
     1089                                       , round( buf_fbr-doc.in-rubl,  2 )
     1090                                       , round( buf_fbr-doc.in-rubl,  2 )
     1091                                       , round( buf_fbr-doc.out-base, 2 )
     1092                                       , round( buf_fbr-doc.in-base,  2 )).
     1093       end.
     1094   end.
     1095   end procedure.
     1096   procedure fbrlib-calc-prices :
     1097   do
     1098   on error undo, return error
     1099   :
     1100   define input parameter p-fbr-line-recid as recid        no-undo.
     1101   define input parameter p-price-obj-type as character    no-undo.
     1102   define input parameter p-price-obj-code as integer      no-undo.
     1103   define output parameter p-current-price as decimal      no-undo.
     1104       define variable v-void          as decimal       no-undo.
     1105       define variable v-void-char     as character     no-undo.
     1106       define variable v-gds-code      as integer       no-undo.
     1107       define variable v-b-code        as integer       no-undo.
     1108       define buffer buf_fbr-doc   for ub.fbr-doc.
     1109       define buffer buf_fbr-line  for ub.fbr-line.
     1110       define buffer buf_gds-prt   for ub.gds-prt.
     1111       define buffer buf_bar-code  for ub.bar-code.
     1112       find first buf_fbr-line no-lock
     1113           where recid( buf_fbr-line ) = p-fbr-line-recid
     1114       .
     1115   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1117     (input  buf_fbr-line.artic
     1118     ,input  buf_fbr-line.prod-type
     1119     ,input  buf_fbr-line.prod-code
     1120     ,output v-gds-code
     1121     ) no-error .
     1122       if error-status :error
     1123       then do:
     1124         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1125                                         ,vss-workfile
     1126                                         ,vss-revision
     1127                                         ,vss-description
     1128                                         ,chr(10)
     1129                                         , error-status:get-message(1)
     1130                                         , return-value
     1131                                         , buf_fbr-line.artic
     1132                                         ).
     1133       end.
     1134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1135     (input  v-gds-code
     1136     ,input  ?
     1137     ,output v-b-code
     1138     ) no-error .
     1139       if error-status :error
     1140       then do:
     1141         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1142                                         ,vss-workfile
     1143                                         ,vss-revision
     1144                                         ,vss-description
     1145                                         ,chr(10)
     1146                                         , error-status:get-message(1)
     1147                                         , return-value
     1148                                         , v-gds-code
     1149                                         ).
     1150       end.
     1151       if buf_fbr-line.is-calc = no
     1152       then do:
     1153   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1155     (input  p-price-obj-type
     1156     ,input  p-price-obj-code
     1157     ,input  v-b-code
     1158     ,input  0
     1159     ,input  0
     1160     ,output v-void-char
     1161     ,output p-current-price
     1162     ,output v-void
     1163     ,output v-void
     1164     ) no-error .
     1165           if error-status :error
     1166           then do:
     1167             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1168                                             ,vss-workfile
     1169                                             ,vss-revision
     1170                                             ,vss-description
     1171                                             ,chr(10)
     1172                                             , error-status:get-message(1)
     1173                                             , return-value
     1174                                             , v-gds-code
     1175                                             ).
     1176           end.
     1177       end.
     1178       else do:
     1179           assign
     1180               p-current-price = buf_fbr-line.price-sale
     1181           .
     1182       end.
     1183   end.
     1184   end procedure.
     1185   procedure fbrlib-put-in-order-recipe :
     1186   do
     1187   on error undo, return error
     1188   :
     1189   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1190       define variable v-recipe-counter    as integer          no-undo.
     1191       define variable v-recipe-amount     as integer init 0   no-undo.
     1192       define variable v-child-counter     as integer          no-undo.
     1193       define variable v-is-call-cycle     as logical          no-undo.
     1194       define variable v-str as character     no-undo.
     1195       define buffer buf_in_fbr-line       for ub.fbr-line.
     1196       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1197       define buffer buf_fbr-line          for ub.fbr-line.
     1198       define buffer buf_recipe-gds        for ub.recipe-gds.
     1199       define buffer buf_recipe            for ub.recipe.
     1200       for each temp_recipe-childs-qnty
     1201       :
     1202           delete temp_recipe-childs-qnty.
     1203       end.
     1204       for each temp_recipe-childs
     1205       :
     1206           delete temp_recipe-childs.
     1207       end.
     1208       for each temp_recipe-order
     1209       :
     1210           delete temp_recipe-order.
     1211       end.
     1212       for each buf_fbr-line no-lock
     1213          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1214       on error undo, return error
     1215       :
     1216           find first temp_recipe-childs-qnty
     1217                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1218           no-error.
     1219           if not available temp_recipe-childs-qnty
     1220           then do:
     1221               create temp_recipe-childs-qnty.
     1222               assign
     1223                   v-recipe-amount                     = v-recipe-amount + 1
     1224                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1225                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1226                   temp_recipe-childs-qnty.childs-qnty = 0
     1227                   v-child-counter                     = 0
     1228               .
     1229           end.
     1230       end.
     1231       for each buf_in_fbr-line no-lock
     1232          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1233            and buf_in_fbr-line.trn-type = 'спи':U
     1234       on error undo, return error
     1235       :
     1236           for each buf_dress_fbr-line no-lock
     1237              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1238                and buf_dress_fbr-line.trn-type    = 'при':U
     1239                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1240                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1241                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1242           on error undo, return error
     1243           :
     1244               find first buf_recipe no-lock
     1245                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1246               .
     1247               if buf_in_fbr-line.is-comp = yes
     1248               then do:
     1249                   find last temp_recipe-childs-qnty
     1250                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1251                   .
     1252                   assign
     1253                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1254                   .
     1255                   create temp_recipe-childs.
     1256                   assign
     1257                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1258                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1259                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1260                   .
     1261               end.
     1262               else do:
     1263               end.
     1264           end.
     1265       end.
     1266       for each buf_in_fbr-line no-lock
     1267          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1268            and buf_in_fbr-line.trn-type = 'при':U
     1269       on error undo, return error
     1270       :
     1271           find first buf_recipe no-lock
     1272                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1273           no-error.
     1274           if buf_in_fbr-line.is-comp = no
     1275           then do:
     1276           end.
     1277           else do:
     1278               for each buf_recipe-gds no-lock
     1279               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1280               :
     1281                   for each buf_fbr-line no-lock
     1282                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1283                       and buf_fbr-line.trn-type    = 'при':U
     1284                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1285                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1286                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1287                   on error undo, return error
     1288                   :
     1289                       find first buf_recipe no-lock
     1290                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1291                       .
     1292                       if buf_recipe.recipe-type = 'разделка':U
     1293                       then do:
     1294                       end.
     1295                       else do:
     1296                           find last temp_recipe-childs-qnty
     1297                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1298                           .
     1299                           assign
     1300                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1301                           .
     1302                           create temp_recipe-childs.
     1303                           assign
     1304                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1305                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1306                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1307                           .
     1308                       end.
     1309                   end.
     1310               end.
     1311           end.
     1312       end.
     1313       for each temp_recipe-order
     1314       on error undo, return error
     1315       :
     1316           delete temp_recipe-order.
     1317       end.
     1318       assign
     1319           v-fbrlib-recipe-order = 0
     1320       .
     1321       do v-recipe-counter = 1 to v-recipe-amount
     1322       on error undo, return error
     1323       :
     1324           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1325                 input v-recipe-counter
     1326               , input 0
     1327               , output v-is-call-cycle
     1328           ).
     1329           if v-is-call-cycle = yes
     1330           then do:
     1331               message
     1332                       "Достигнут максимальный уровень вложенности рецептов."
     1333                   skip(1)
     1334                   skip "Невозможно упорядочить рецепты."
     1335                   skip(1)
     1336                   skip "Необходимо изменить структуру рецептов,"
     1337                   skip "используемых при формировании"
     1338                   skip "данного документа производства."
     1339               view-as alert-box error
     1340               title "Невозможно рассчитать документ производства".
     1341               for each temp_recipe-childs-qnty
     1342               :
     1343                   delete temp_recipe-childs-qnty.
     1344               end.
     1345               for each temp_recipe-childs
     1346               :
     1347                   delete temp_recipe-childs.
     1348               end.
     1349               for each temp_recipe-order
     1350               :
     1351                   delete temp_recipe-order.
     1352               end.
     1353               for each temp_recipe-order
     1354               on error undo, return error
     1355               :
     1356                   delete temp_recipe-order.
     1357               end.
     1358               for each temp_fbrlib_recipe
     1359               on error undo, return error
     1360               :
     1361                   delete temp_recipe-order.
     1362               end.
     1363               undo, return error.
     1364           end.
     1365       end.
     1366   end.
     1367   end procedure.
     1368   procedure fbrlib-add-recipe-in-tmp-order :
     1369   do
     1370   on error undo, return error
     1371   :
     1372   define input parameter p-order              as integer      no-undo.
     1373   define input parameter p-call-counter       as integer      no-undo.
     1374   define output parameter p-is-call-cycle     as logical      no-undo.
     1375       define variable v-nodes-counter     as integer       no-undo.
     1376       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1377       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1378       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1379       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1380       assign
     1381           p-call-counter = p-call-counter + 1
     1382       .
     1383       if p-call-counter > 50
     1384       then do:
     1385           assign
     1386               p-is-call-cycle = yes
     1387           .
     1388       end.
     1389       else do:
     1390           find first buf_temp_recipe-childs-qnty
     1391                where buf_temp_recipe-childs-qnty.order = p-order
     1392           .
     1393           find first buf_temp_recipe-order
     1394                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1395           no-error.
     1396           if not available buf_temp_recipe-order
     1397           then do:
     1398               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1399               :
     1400                   find first buf_temp_recipe-childs
     1401                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1402                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1403                   .
     1404                   find first buf_c_temp_recipe-childs-qnty
     1405                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1406                   .
     1407                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1408                         input buf_c_temp_recipe-childs-qnty.order
     1409                       , input p-call-counter
     1410                       , output p-is-call-cycle
     1411                   ).
     1412                   if p-is-call-cycle = yes
     1413                   then do:
     1414                       return.
     1415                   end.
     1416               end.
     1417               assign
     1418                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1419               .
     1420               create buf_temp_recipe-order.
     1421               assign
     1422                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1423                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1424               .
     1425           end.
     1426       end.
     1427   end.
     1428   end procedure.
     1429   procedure fbrlib-get-trn-type :
     1430   define input parameter p-recipe-code    as character    no-undo.
     1431   define input parameter p-goods-recid    as recid        no-undo.
     1432   define input parameter p-is-integration as logical      no-undo.
     1433   define output parameter p-is-comp       as logical      no-undo.
     1434   define output parameter p-trn-type      as character    no-undo.
     1435   define buffer buf_recipe    for ub.recipe.
     1436   define buffer buf_goods     for ub.goods.
     1437   do
     1438   for buf_recipe
     1439     , buf_goods
     1440   on error undo, return error
     1441   :
     1442       find first buf_goods no-lock
     1443            where recid( buf_goods ) = p-goods-recid
     1444       .
     1445       find first buf_recipe no-lock
     1446            where buf_recipe.recipe-code = p-recipe-code
     1447       no-error.
     1448       if not available buf_recipe
     1449       then do:
     1450           assign
     1451               p-is-comp = no
     1452               p-trn-type = "":U
     1453           .
     1454           undo, return.
     1455       end.
     1456       if  buf_recipe.artic        = buf_goods.artic
     1457       and buf_recipe.prod-type    = buf_goods.prod-type
     1458       and buf_recipe.prod-code    = buf_goods.prod-code
     1459       then do:
     1460           assign
     1461               p-is-comp = yes
     1462           .
     1463       end.
     1464       else do:
     1465           assign
     1466               p-is-comp = no
     1467           .
     1468       end.
     1469       case buf_recipe.recipe-type
     1470       :
     1471           when 'производство':U
     1472           then do:
     1473               if p-is-comp = yes
     1474               then do:
     1475                   assign
     1476                       p-trn-type = 'при':U
     1477                   .
     1478               end.
     1479               else do:
     1480                   assign
     1481                       p-trn-type = 'спи':U
     1482                   .
     1483               end.
     1484           end.
     1485           when 'альтернатива':U
     1486           then do:
     1487               if p-is-comp = yes
     1488               then do:
     1489                   assign
     1490                       p-trn-type = 'при':U
     1491                   .
     1492               end.
     1493               else do:
     1494                   assign
     1495                       p-trn-type = 'спи':U
     1496                   .
     1497               end.
     1498           end.
     1499           when 'разделка':U
     1500           then do:
     1501               if p-is-comp = no
     1502               then do:
     1503                   assign
     1504                       p-trn-type = 'при':U
     1505                   .
     1506               end.
     1507               else do:
     1508                   assign
     1509                       p-trn-type = 'спи':U
     1510                   .
     1511               end.
     1512           end.
     1513           when 'комплектация':U
     1514           then do:
     1515               if p-is-integration = ?
     1516               then do:
     1517                   message
     1518                       "Выберите тип операции по рецепту комплектации:"
     1519                       skip (2) "YES - комплектация"
     1520                       skip     "NO - разукомплектация"
     1521                   view-as alert-box question
     1522                   buttons YES-NO
     1523                   update p-is-integration.
     1524               end.
     1525               if p-is-integration = yes
     1526               then do:
     1527                   if p-is-comp = yes
     1528                   then do:
     1529                       assign
     1530                           p-trn-type = 'при':U
     1531                       .
     1532                   end.
     1533                   else do:
     1534                       assign
     1535                           p-trn-type = 'спи':U
     1536                       .
     1537                   end.
     1538               end.
     1539               else do:
     1540                   if p-is-comp = yes
     1541                   then do:
     1542                       assign
     1543                           p-trn-type = 'спи':U
     1544                       .
     1545                   end.
     1546                   else do:
     1547                       assign
     1548                           p-trn-type = 'при':U
     1549                       .
     1550                   end.
     1551               end.
     1552           end.
     1553       end case.
     1554   end.
     1555   end procedure.
     1556   procedure fbrlib-get-mark :
     1557   define input parameter p-recipe-code    as character    no-undo.
     1558   define output parameter p-mark          as logical    no-undo.
     1559   define buffer buf_goods-attr     for ub.goods-attr.
     1560   define buffer buf_recipe-gds for ub.recipe-gds .
     1561       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     1562            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     1563                                               buf_goods-attr.attr-code = 'mark-type':U:
     1564            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     1565               p-mark = true .
     1566               return .
     1567            end.
     1568       end.
     1569   end procedure.
     1570   procedure fbrlib-check-temp-tables :
     1571   do
     1572   on error undo, return error
     1573   :
     1574   define input parameter p-title  as character    no-undo.
     1575       define variable v-str               as character        no-undo.
     1576       assign
     1577           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     1578       .
     1579       for each temp_recipe-childs-qnty
     1580       on error undo, return error
     1581       :
     1582           assign
     1583               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     1584                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     1585                       + "   " + string( temp_recipe-childs-qnty.order )
     1586                       + chr(10)
     1587           .
     1588       end.
     1589       assign
     1590           v-str = v-str + "temp_recipe-childs:" + chr(10)
     1591       .
     1592       for each temp_recipe-childs
     1593       on error undo, return error
     1594       :
     1595           assign
     1596               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     1597                       + "   " + string( temp_recipe-childs.child-code )
     1598                       + "   " + string( temp_recipe-childs.child-recipe-code )
     1599                       + chr(10)
     1600           .
     1601       end.
     1602       assign
     1603           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     1604       .
     1605       for each temp_recipe-order
     1606       on error undo, return error
     1607       :
     1608           assign
     1609               v-str   = v-str + string( temp_recipe-order.recipe-code )
     1610                       + "   " + string( temp_recipe-order.order )
     1611                       + chr(10)
     1612           .
     1613       end.
     1614       assign
     1615           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     1616       .
     1617       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     1618       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1619       for each temp_fbrlib_recipe
     1620       on error undo, return error
     1621       :
     1622           assign
     1623               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     1624                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     1625                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     1626                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     1627                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     1628                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     1629                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     1630                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     1631                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     1632                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     1633                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     1634                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     1635                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     1636                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     1637                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     1638                       + chr(10)
     1639           .
     1640           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1641       end.
     1642   end.
     1643   end procedure.
     1644   procedure fbrlib-s-coeff-value :
     1645   define input  parameter p-gds-code    as integer        no-undo.
     1646   define input  parameter p-date        as date           no-undo.
     1647   define input  parameter p-obj-type    as character      no-undo.
     1648   define input  parameter p-obj-code    as integer        no-undo.
     1649   define output parameter p-coeff-value as decimal        no-undo.
     1650   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     1651       define variable v-date          as date         no-undo.
     1652       define variable v-host-code     as integer      no-undo.
     1653       define buffer buf_goods       for ub.goods.
     1654       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     1655       define buffer buf_clients     for ub.clients.
     1656       define buffer buf_s-coeff     for ub.s-coeff.
     1657   do
     1658   for buf_goods
     1659     , buf_fbr-gds-obj
     1660     , buf_clients
     1661     , buf_s-coeff
     1662   on error undo, return error return-value
     1663   :
     1664       find first buf_goods no-lock
     1665            where buf_goods.gds-code = p-gds-code
     1666       no-error .
     1667       if not available buf_goods
     1668       then do:
     1669          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     1670       end.
     1671       find first buf_clients no-lock
     1672            where buf_clients.obj-type = p-obj-type
     1673              and buf_clients.obj-code = p-obj-code
     1674       no-error.
     1675       if not available buf_clients
     1676       then do:
     1677          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     1678       end.
     1679       assign
     1680           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     1681       .
     1682       find first buf_fbr-gds-obj no-lock
     1683            where buf_fbr-gds-obj.gds-code = p-gds-code
     1684              and buf_fbr-gds-obj.obj-type = p-obj-type
     1685              and buf_fbr-gds-obj.obj-code = p-obj-code
     1686       no-error.
     1687       if not available buf_fbr-gds-obj
     1688       or buf_fbr-gds-obj.is-season = no
     1689       then do:
     1690           assign
     1691               p-coeff-value = 0
     1692           .
     1693           return.
     1694       end.
     1695   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1697     (input  p-obj-type
     1698     ,input  p-obj-code
     1699     ,output v-host-code
     1700     )  .
     1701       find last buf_s-coeff no-lock
     1702           where buf_s-coeff.gds-code = p-gds-code
     1703             and buf_s-coeff.host-code = v-host-code
     1704             and buf_s-coeff.obj-type = p-obj-type
     1705             and buf_s-coeff.obj-code = p-obj-code
     1706             and buf_s-coeff.s-date <= v-date
     1707       no-error.
     1708       if available buf_s-coeff
     1709       then do:
     1710           assign
     1711               p-coeff-value = buf_s-coeff.coeff-value
     1712           .
     1713           return.
     1714       end.
     1715       find last buf_s-coeff no-lock
     1716           where buf_s-coeff.gds-code = p-gds-code
     1717             and buf_s-coeff.host-code = v-host-code
     1718             and buf_s-coeff.obj-type = "":U
     1719             and buf_s-coeff.obj-code = 0
     1720             and buf_s-coeff.s-date <= v-date
     1721       no-error.
     1722       if available buf_s-coeff
     1723       then do:
     1724           assign
     1725               p-coeff-value = buf_s-coeff.coeff-value
     1726           .
     1727           return.
     1728       end.
     1729       find last buf_s-coeff no-lock
     1730           where buf_s-coeff.gds-code = p-gds-code
     1731             and buf_s-coeff.host-code = 0
     1732             and buf_s-coeff.obj-type = "":U
     1733             and buf_s-coeff.obj-code = 0
     1734             and buf_s-coeff.s-date <= v-date
     1735       no-error.
     1736       if available buf_s-coeff
     1737       then do:
     1738           assign
     1739               p-coeff-value = buf_s-coeff.coeff-value
     1740           .
     1741       end.
     1742       else do:
     1743           assign
     1744               p-coeff-value = 0
     1745           .
     1746       end.
     1747   end.
     1748   end procedure.
     1749   procedure fbrlib_create-fbr-recipe-gds :
     1750   define input parameter p-doc-code         as character      no-undo.
     1751   define input parameter p-recipe-code      as character      no-undo.
     1752   define input parameter p-prod-type        as character      no-undo.
     1753   define input parameter p-prod-code        as integer        no-undo.
     1754   define input parameter p-artic            as character      no-undo.
     1755   define input parameter p-gds-code         as integer        no-undo.
     1756   define input parameter p-is-waste         as logical        no-undo.
     1757   define input parameter p-proc-number      as integer        no-undo.
     1758   define input parameter p-obj-date         as date           no-undo.
     1759   define input parameter p-obj-type         as character      no-undo.
     1760   define input parameter p-obj-code         as integer        no-undo.
     1761   define input parameter p-calc-method      as decimal        no-undo.
     1762   define input parameter p-coeff-waste      as decimal        no-undo.
     1763   define input parameter p-orig-qnty        as decimal        no-undo.
     1764   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     1765       define variable v-coeff-season  as decimal      no-undo.
     1766       define variable v-void-decimal  as decimal      no-undo.
     1767       define variable v-void-integer  as integer      no-undo.
     1768       define variable v-recipe-type   as character    no-undo.
     1769       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     1770       define buffer buf_goods             for ub.goods.
     1771       define buffer buf_recipe            for ub.recipe.
     1772   do
     1773   for buf_fbr-recipe-gds
     1774     , buf_recipe
     1775     , buf_goods
     1776   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1777   :
     1778       find first buf_fbr-recipe-gds exclusive-lock
     1779            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     1780              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     1781              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     1782              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     1783              and buf_fbr-recipe-gds.artic       = p-artic
     1784       no-error.
     1785       if not available buf_fbr-recipe-gds
     1786       then do:
     1787           create buf_fbr-recipe-gds.
     1788           assign
     1789               buf_fbr-recipe-gds.doc-code           = p-doc-code
     1790               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     1791               buf_fbr-recipe-gds.prod-type          = p-prod-type
     1792               buf_fbr-recipe-gds.prod-code          = p-prod-code
     1793               buf_fbr-recipe-gds.artic              = p-artic
     1794               buf_fbr-recipe-gds.gds-code           = p-gds-code
     1795               buf_fbr-recipe-gds.is-waste           = p-is-waste
     1796               buf_fbr-recipe-gds.proc-number        = p-proc-number
     1797               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     1798               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     1799           .
     1800           find first buf_goods no-lock
     1801                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     1802                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     1803                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     1804           .
     1805           run fbrlib-s-coeff-value in this-procedure (
     1806                 input buf_goods.gds-code
     1807               , input p-obj-date
     1808               , input p-obj-type
     1809               , input p-obj-code
     1810               , output v-coeff-season
     1811           ) no-error.
     1812           if error-status:error
     1813           then do:
     1814               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     1815           end.
     1816           assign
     1817               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     1818               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     1819               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     1820           .
     1821           run fbrlib-get-recipe-type in this-procedure (
     1822                 input buf_fbr-recipe-gds.doc-code
     1823               , input buf_fbr-recipe-gds.recipe-code
     1824               , output v-recipe-type
     1825           ).
     1826           if v-recipe-type <> 'производство':U
     1827           then do:
     1828               assign
     1829                   buf_fbr-recipe-gds.coeff-value  = 0
     1830                   buf_fbr-recipe-gds.coeff-waste  = 0
     1831                   buf_fbr-recipe-gds.calc-method  = 1
     1832                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     1833               .
     1834           end.
     1835           else do:
     1836               run fbrlib-calc-brutto in this-procedure (
     1837                     input v-recipe-type
     1838                   , input buf_fbr-recipe-gds.qnty
     1839                   , input buf_fbr-recipe-gds.coeff-value
     1840                   , input buf_fbr-recipe-gds.coeff-waste
     1841                   , input 0
     1842                   , input 3
     1843                   , output v-void-decimal
     1844                   , output v-void-decimal
     1845                   , output buf_fbr-recipe-gds.brutto-qnty
     1846                   , output v-void-integer
     1847               ).
     1848               assign
     1849                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     1850               .
     1851               run fbrlib-calc-brutto in this-procedure (
     1852                     input v-recipe-type
     1853                   , input buf_fbr-recipe-gds.qnty
     1854                   , input buf_fbr-recipe-gds.coeff-value
     1855                   , input buf_fbr-recipe-gds.coeff-waste
     1856                   , input buf_fbr-recipe-gds.brutto-qnty
     1857                   , input buf_fbr-recipe-gds.calc-method
     1858                   , output buf_fbr-recipe-gds.qnty
     1859                   , output v-void-decimal
     1860                   , output v-void-decimal
     1861                   , output v-void-integer
     1862               ).
     1863           end.
     1864       end.
     1865   end.
     1866   end procedure.
     1867   procedure fbrlib-set-default-recipe :
     1868   define input parameter p-obj-type   as character    no-undo.
     1869   define input parameter p-obj-code   as integer      no-undo.
     1870   define input parameter p-gds-code   as integer      no-undo.
     1871       define variable v-artic             as character    no-undo.
     1872       define variable v-prod-type         as character    no-undo.
     1873       define variable v-prod-code         as character    no-undo.
     1874       define variable v-recipe-code       as character    no-undo.
     1875       define variable v-fbr-gds-obj-recid as recid        no-undo.
     1876       define variable v-recipe-found      as logical      no-undo.
     1877       define buffer buf_recipe        for ub.recipe.
     1878       define buffer buf_other_recipe  for ub.recipe.
     1879       define buffer buf_goods         for ub.goods.
     1880       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     1881   do
     1882   for buf_recipe
     1883     , buf_goods
     1884     , buf_fbr-gds-obj
     1885   on error undo, return error
     1886   :
     1887       find first buf_goods no-lock
     1888            where buf_goods.gds-code = p-gds-code
     1889       .
     1890       run fbrlib-get-obj-recipe in this-procedure (
     1891             input p-obj-type
     1892           , input p-obj-code
     1893           , input p-gds-code
     1894           , output v-recipe-code
     1895       ).
     1896       if v-recipe-code <> ""
     1897       then do:
     1898           find first buf_recipe no-lock
     1899               where buf_recipe.recipe-code = v-recipe-code
     1900           no-error.
     1901           if not available buf_recipe
     1902           then do:
     1903               assign
     1904                   v-recipe-code = ""
     1905               .
     1906           end.
     1907       end.
     1908       if v-recipe-code = ""
     1909       then do:
     1910           find first buf_fbr-gds-obj exclusive-lock
     1911                where buf_fbr-gds-obj.obj-type = p-obj-type
     1912                  and buf_fbr-gds-obj.obj-code = p-obj-code
     1913                  and buf_fbr-gds-obj.gds-code = p-gds-code
     1914           no-error.
     1915           if not available buf_fbr-gds-obj
     1916           then do:
     1917               run ref/fgdsobj1.p (
     1918                     input-output v-fbr-gds-obj-recid
     1919                   , input 'ДОБАВЛЕНИЕ':U
     1920                   , input no
     1921                   , input p-gds-code
     1922                   , input p-obj-type
     1923                   , input p-obj-code
     1924                   , input 0
     1925                   , input ""
     1926                   , input 0
     1927                   , input no
     1928                   , input no
     1929                   , input no
     1930                   , input no
     1931                   , input no
     1932                   , input no
     1933               ) no-error.
     1934               if error-status:error
     1935               then do:
     1936                   message
     1937                           vss-workfile vss-revision vss-description
     1938                       skip "Ошибка изменения атрибутов товара на объекте"
     1939                       skip return-value
     1940                       skip trim(error-status :get-message(1))
     1941                               trim(error-status :get-message(2))
     1942                               trim(error-status :get-message(3))
     1943                   view-as alert-box error.
     1944                   undo, return error .
     1945               end.
     1946               find first buf_fbr-gds-obj exclusive-lock
     1947                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     1948               .
     1949           end.
     1950           assign
     1951               v-recipe-found = no
     1952           .
     1953           for first buf_recipe no-lock
     1954               where buf_recipe.obj-type    = p-obj-type
     1955                 and buf_recipe.obj-code    = p-obj-code
     1956                 and buf_recipe.artic       = buf_goods.artic
     1957                 and buf_recipe.prod-type   = buf_goods.prod-type
     1958                 and buf_recipe.prod-code   = buf_goods.prod-code
     1959                 and buf_recipe.recipe-type = 'производство':U
     1960                 or (
     1961                     buf_recipe.obj-type    = ""
     1962                 and buf_recipe.obj-code    = 0
     1963                 and buf_recipe.artic       = buf_goods.artic
     1964                 and buf_recipe.prod-type   = buf_goods.prod-type
     1965                 and buf_recipe.prod-code   = buf_goods.prod-code
     1966                 and buf_recipe.recipe-type = 'производство':U
     1967                     )
     1968           :
     1969               assign
     1970                   v-recipe-found = yes
     1971                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1972               .
     1973           end.
     1974           if v-recipe-found = no
     1975           then do:
     1976               for first buf_recipe no-lock
     1977                   where buf_recipe.obj-type    = p-obj-type
     1978                     and buf_recipe.obj-code    = p-obj-code
     1979                     and buf_recipe.artic       = buf_goods.artic
     1980                     and buf_recipe.prod-type   = buf_goods.prod-type
     1981                     and buf_recipe.prod-code   = buf_goods.prod-code
     1982                     and buf_recipe.recipe-type <> 'альтернатива':U
     1983                     or (
     1984                         buf_recipe.obj-type    = ""
     1985                     and buf_recipe.obj-code    = 0
     1986                     and buf_recipe.artic       = buf_goods.artic
     1987                     and buf_recipe.prod-type   = buf_goods.prod-type
     1988                     and buf_recipe.prod-code   = buf_goods.prod-code
     1989                     and buf_recipe.recipe-type <> 'альтернатива':U
     1990                         )
     1991               :
     1992                   assign
     1993                       v-recipe-found = yes
     1994                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1995                   .
     1996               end.
     1997               if v-recipe-found = no
     1998               then do:
     1999                   for first buf_recipe no-lock
     2000                       where buf_recipe.obj-type    = p-obj-type
     2001                         and buf_recipe.obj-code    = p-obj-code
     2002                         and buf_recipe.artic       = buf_goods.artic
     2003                         and buf_recipe.prod-type   = buf_goods.prod-type
     2004                         and buf_recipe.prod-code   = buf_goods.prod-code
     2005                         or (
     2006                             buf_recipe.obj-type    = ""
     2007                         and buf_recipe.obj-code    = 0
     2008                         and buf_recipe.artic       = buf_goods.artic
     2009                         and buf_recipe.prod-type   = buf_goods.prod-type
     2010                         and buf_recipe.prod-code   = buf_goods.prod-code
     2011                             )
     2012                   :
     2013                       assign
     2014                           v-recipe-found = yes
     2015                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2016                       .
     2017                   end.
     2018                   if v-recipe-found = no
     2019                   then do:
     2020                       assign
     2021                           buf_fbr-gds-obj.default-recipe-code = ""
     2022                       .
     2023                   end.
     2024               end.
     2025           end.
     2026       end.
     2027   end.
     2028   end procedure.
     2029   procedure fbrlib-get-obj-recipe :
     2030   define input parameter p-obj-type       as character    no-undo.
     2031   define input parameter p-obj-code       as integer      no-undo.
     2032   define input parameter p-gds-code       as integer      no-undo.
     2033   define output parameter p-recipe-code   as character    no-undo.
     2034       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2035   do
     2036   for buf_fbr-gds-obj
     2037   on error undo, return error
     2038   :
     2039       find first buf_fbr-gds-obj no-lock
     2040            where buf_fbr-gds-obj.obj-type = p-obj-type
     2041              and buf_fbr-gds-obj.obj-code = p-obj-code
     2042              and buf_fbr-gds-obj.gds-code = p-gds-code
     2043       no-error.
     2044       if available buf_fbr-gds-obj
     2045       then do:
     2046           assign
     2047               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2048           .
     2049       end.
     2050       else do:
     2051           assign
     2052               p-recipe-code = ""
     2053           .
     2054       end.
     2055   end.
     2056   end procedure.
     2057   procedure fbrlib-create-or-update-recipe-gds :
     2058   define input parameter p-recipe-code    as character        no-undo.
     2059   define input parameter p-gds-code       as integer          no-undo.
     2060   define input parameter p-is-waste       as logical          no-undo.
     2061   define input parameter p-qnty           as decimal          no-undo.
     2062   define input parameter p-proc-number    as integer          no-undo.
     2063   define input parameter p-nws-self       as logical          no-undo.
     2064       define variable v-max-proc-num  as integer      no-undo.
     2065       define variable v-recipe-type   as character    no-undo.
     2066       define buffer buf_goods             for ub.goods.
     2067       define buffer buf_recipe-gds        for ub.recipe-gds.
     2068       define buffer buf_recipe            for ub.recipe.
     2069       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2070   do
     2071   for buf_goods
     2072     , buf_recipe-gds
     2073     , buf_recipe
     2074     , buf_proc_recipe-gds
     2075   on error undo, return error
     2076   :
     2077       find first buf_recipe no-lock
     2078            where buf_recipe.recipe-code = p-recipe-code
     2079       .
     2080       find first buf_goods no-lock
     2081            where buf_goods.gds-code = p-gds-code
     2082       .
     2083       find first buf_recipe-gds
     2084            where buf_recipe-gds.recipe-code = p-recipe-code
     2085              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2086              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2087              and buf_recipe-gds.artic       = buf_goods.artic
     2088       no-error.
     2089       if not available buf_recipe-gds
     2090       then do:
     2091           create buf_recipe-gds.
     2092           assign
     2093               buf_recipe-gds.recipe-code = p-recipe-code
     2094               buf_recipe-gds.gds-code    = p-gds-code
     2095               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2096               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2097               buf_recipe-gds.artic       = buf_goods.artic
     2098           .
     2099           assign
     2100               buf_recipe-gds.is-waste    = no
     2101               buf_recipe-gds.qnty        = 0
     2102               buf_recipe-gds.coeff-waste = 0
     2103               buf_recipe-gds.brutto-qnty = 0
     2104               buf_recipe-gds.proc-number = 0
     2105               buf_recipe-gds.nws-self    = no
     2106           .
     2107       end.
     2108       assign
     2109           buf_recipe-gds.is-waste    = p-is-waste
     2110       .
     2111       run fbrlib-get-recipe-type in this-procedure (
     2112             input "":U
     2113           , input buf_recipe-gds.recipe-code
     2114           , output v-recipe-type
     2115       ).
     2116       if v-recipe-type <> 'производство':U
     2117       then do:
     2118           assign
     2119               buf_recipe-gds.calc-method = 1
     2120               buf_recipe-gds.qnty        = p-qnty
     2121               buf_recipe-gds.brutto-qnty = p-qnty
     2122               buf_recipe-gds.coeff-waste = 0
     2123           .
     2124       end.
     2125       else do:
     2126           assign
     2127               buf_recipe-gds.calc-method = 1
     2128               buf_recipe-gds.brutto-qnty = p-qnty
     2129           .
     2130           run fbrlib-calc-brutto in this-procedure (
     2131                 input v-recipe-type
     2132               , input 0
     2133               , input 0
     2134               , input buf_recipe-gds.coeff-waste
     2135               , input buf_recipe-gds.brutto-qnty
     2136               , input 1
     2137               , output buf_recipe-gds.qnty
     2138               , output buf_recipe-gds.coeff-waste
     2139               , output buf_recipe-gds.brutto-qnty
     2140               , output buf_recipe-gds.calc-method
     2141           ).
     2142       end.
     2143       assign
     2144           buf_recipe-gds.nws-self    = p-nws-self
     2145       .
     2146       if buf_recipe.recipe-type = 'альтернатива':U
     2147       and buf_recipe-gds.proc-number <> 0
     2148       then do:
     2149       end.
     2150       else do:
     2151           if p-proc-number <> 0
     2152           then do:
     2153               assign
     2154                   buf_recipe-gds.proc-number = p-proc-number
     2155               .
     2156           end.
     2157           else do:
     2158               assign
     2159                   v-max-proc-num = 0
     2160               .
     2161               for each buf_proc_recipe-gds no-lock
     2162                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2163               :
     2164                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2165                   then do:
     2166                       assign
     2167                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2168                       .
     2169                   end.
     2170               end.
     2171               assign
     2172                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2173               .
     2174           end.
     2175       end.
     2176   end.
     2177   end procedure.
     2178   PROCEDURE fbrlib-create-or-update-recipe :
     2179   define input parameter p-mode               as character    no-undo.
     2180   define input parameter p-obj-type           as character    no-undo.
     2181   define input parameter p-obj-code           as integer      no-undo.
     2182   define input parameter p-recipe-code        as character    no-undo.
     2183   define input parameter p-recipe-type        as character    no-undo.
     2184   define input parameter p-gds-code           as integer      no-undo.
     2185   define input parameter p-name               as character    no-undo.
     2186   define input parameter p-design             as character    no-undo.
     2187   define input parameter p-order              as integer      no-undo.
     2188   define input parameter p-quality            as character    no-undo.
     2189   define input parameter p-ref-num            as character    no-undo.
     2190   define input parameter p-technique          as character    no-undo.
     2191   define input parameter p-template           as character    no-undo.
     2192   define input parameter p-qnty               as decimal      no-undo.
     2193   define input parameter p-portion-qnty       as integer      no-undo.
     2194   define input parameter p-portion-weight     as decimal      no-undo.
     2195   define output parameter p-new-recipe-code   as character    no-undo.
     2196       define variable v-host-code         as integer      no-undo.
     2197       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2198       define buffer buf_recipe    for ub.recipe.
     2199       define buffer buf_goods     for ub.goods.
     2200   do
     2201   for buf_recipe
     2202     , buf_goods
     2203   on error undo, return error
     2204   :
     2205       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2206       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2207       then do:
     2208           message
     2209               skip "Ошибка задания типа операции для создания или измения рецепта."
     2210               skip (1)
     2211               skip "Задан тип операции:" p-mode
     2212           view-as alert-box error.
     2213           undo, return error .
     2214       end.
     2215       if p-recipe-code = ""
     2216       then do:
     2217   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2219     (input  p-obj-type
     2220     ,input  p-obj-code
     2221     ,output v-host-code
     2222     )  .
     2223           find first buf_goods no-lock
     2224                where buf_goods.gds-code = p-gds-code
     2225           .
     2226           create buf_recipe .
     2227           run fbrcode-gen-recipe-code in this-procedure (
     2228                 input p-obj-type
     2229               , input p-obj-code
     2230               , output buf_recipe.recipe-code
     2231           ).
     2232           assign
     2233               buf_recipe.artic               = buf_goods.artic
     2234               buf_recipe.prod-type           = buf_goods.prod-type
     2235               buf_recipe.prod-code           = buf_goods.prod-code
     2236               buf_recipe.recipe-type         = p-recipe-type
     2237               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2238               buf_recipe.gds-code            = p-gds-code
     2239               buf_recipe.host-code           = v-host-code
     2240               buf_recipe.obj-type            = p-obj-type
     2241               buf_recipe.obj-code            = p-obj-code
     2242               buf_recipe.recipe-design       = ""
     2243               buf_recipe.recipe-order        = 0
     2244               buf_recipe.recipe-quality      = ""
     2245               buf_recipe.recipe-ref-num      = ""
     2246               buf_recipe.recipe-technique    = ""
     2247               buf_recipe.recipe-template     = ""
     2248               buf_recipe.qnty                = 1.0
     2249               buf_recipe.portion-qnty        = 1
     2250               buf_recipe.portion-weight      = 0
     2251           .
     2252       end.
     2253       if p-name <> ""
     2254       then do:
     2255           assign
     2256               buf_recipe.recipe-name = p-name
     2257           .
     2258       end.
     2259       assign
     2260           buf_recipe.recipe-design       = p-design
     2261           buf_recipe.recipe-order        = p-order
     2262           buf_recipe.recipe-quality      = p-quality
     2263           buf_recipe.recipe-ref-num      = p-ref-num
     2264           buf_recipe.recipe-technique    = p-technique
     2265           buf_recipe.recipe-template     = p-template
     2266           buf_recipe.qnty                = p-qnty
     2267           buf_recipe.portion-qnty        = p-portion-qnty
     2268           buf_recipe.portion-weight      = p-portion-weight
     2269       .
     2270       assign
     2271           p-new-recipe-code = buf_recipe.recipe-code
     2272       .
     2273       run fbrlib-set-default-recipe in this-procedure (
     2274             input p-obj-type
     2275           , input p-obj-code
     2276           , input buf_goods.gds-code
     2277       ).
     2278   end.
     2279   END PROCEDURE.
     2280   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2281   define input parameter parparentproc-handle as widget-handle no-undo .
     2282   define input parameter p-doc-code   as character no-undo.
     2283   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2284       define variable v-shift-on      as logical      no-undo.
     2285       define variable v-shift-date    as date         no-undo.
     2286       define variable v-shift-num     as integer      no-undo.
     2287       define variable v-shift-name    as character    no-undo.
     2288       define variable v-obj-date      as date         no-undo.
     2289       define variable v-chip-num      as integer      no-undo.
     2290       define buffer buf_fbr-doc       for ub.fbr-doc.
     2291       define buffer buf_fbr-line      for ub.fbr-line.
     2292       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2293       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2294       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2295       define buffer buf_marking-lines for ub.marking-lines .
     2296       define buffer buf_marking       for ub.marking .
     2297       define buffer buf_goods         for ub.goods .
     2298   do
     2299   for buf_fbr-doc
     2300     , buf_fbr-line
     2301     , buf_c-fbr-doc
     2302     , buf_fbr-recipe
     2303     , buf_fbr-recipe-gds
     2304     , buf_goods
     2305     , buf_marking
     2306     , buf_marking-lines
     2307   on error undo, return error
     2308   :
     2309   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2310     define variable v-cntxt-db-num        as integer   no-undo .
     2311     define variable v-cntxt-userid        as character no-undo .
     2312     define variable v-cntxt-level         as character no-undo .
     2313     define variable v-cntxt-host-code-obj as integer   no-undo .
     2314     define variable v-cntxt-obj-type      as character no-undo .
     2315     define variable v-cntxt-obj-code      as integer   no-undo .
     2316     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2317     define variable v-cntxt-is-admin      as logical   no-undo .
     2318   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2319     run mainmenu_getcntxt in parparentproc-handle
     2320       (output v-cntxt-db-num
     2321       ,output v-cntxt-userid
     2322       ,output v-cntxt-level
     2323       ,output v-cntxt-host-code-obj
     2324       ,output v-cntxt-obj-type
     2325       ,output v-cntxt-obj-code
     2326       ,output v-cntxt-db-num-obj
     2327       ,output v-cntxt-is-admin
     2328       ) .
     2329       if search ("delfbr.err") <> ?
     2330       then do:
     2331           os-delete "delfbr.err".
     2332       end.
     2333     _del-block:
     2334       do transaction
     2335     on error undo _del-block, return error return-value
     2336     on endkey undo _del-block , return error return-value
     2337     on stop undo _del-block , return error return-value
     2338       :
     2339           find first buf_fbr-doc exclusive-lock
     2340                where buf_fbr-doc.doc-code = p-doc-code
     2341           no-error.
     2342           if not available buf_fbr-doc
     2343           then do:
     2344         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2345                                           ,vss-workfile
     2346                                           ,vss-revision
     2347                                           ,vss-description
     2348                                           ,chr(10)
     2349                                           , p-doc-code).
     2350           end.
     2351           run fbrlib-delete-fact-trn-doc in this-procedure (
     2352               input parparentproc-handle
     2353              ,input p-doc-code
     2354              ,input 'при':U
     2355              ,input p-chip-num
     2356              ,output v-chip-num
     2357           ) no-error.
     2358           if error-status :error
     2359           then do:
     2360               run fbrlib-print-del-error-message in this-procedure .
     2361         undo _del-block, return error.
     2362           end.
     2363           assign
     2364           p-chip-num = (if p-chip-num = ?
     2365                         then v-chip-num
     2366                         else p-chip-num).
     2367           run fbrlib-delete-fact-trn-doc in this-procedure (
     2368               input parparentproc-handle
     2369              ,input p-doc-code
     2370              ,input 'рас':U
     2371              ,input p-chip-num
     2372              ,output v-chip-num
     2373           ) no-error.
     2374           if error-status :error
     2375           then do:
     2376               run fbrlib-print-del-error-message in this-procedure .
     2377         undo _del-block, return error.
     2378           end.
     2379           run fbrlib-delete-fact-trn-doc in this-procedure (
     2380               input parparentproc-handle
     2381              ,input p-doc-code
     2382              ,input 'спи':U
     2383              ,input p-chip-num
     2384              ,output v-chip-num
     2385           ) no-error.
     2386           if error-status :error
     2387           then do:
     2388               run fbrlib-print-del-error-message in this-procedure .
     2389         undo _del-block, return error.
     2390           end.
     2391           create buf_c-fbr-doc.
     2392           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2393   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2395     (input  buf_fbr-doc.obj-type
     2396     ,input  buf_fbr-doc.obj-code
     2397     ,output v-obj-date
     2398     ) no-error .
     2399           if error-status :error
     2400           or v-obj-date = ?
     2401           then do:
     2402         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2403           end.
     2404   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2405   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2406     (input  buf_fbr-doc.obj-type
     2407     ,input  buf_fbr-doc.obj-code
     2408     ,input  'shift-on=request'
     2409     ,output v-shift-on
     2410     )  .
     2411           if v-shift-on
     2412           then do:
     2413   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2415     (input  buf_fbr-doc.obj-type
     2416     ,input  buf_fbr-doc.obj-code
     2417     ,output v-shift-date
     2418     ,output v-shift-num
     2419     ,output v-shift-name
     2420     ) no-error .
     2421               if error-status :error
     2422               then do:
     2423           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2424               end.
     2425           end.
     2426           else do:
     2427               assign
     2428                   v-shift-date = ?
     2429                   v-shift-num  = ?
     2430                   v-shift-name = ?
     2431               .
     2432           end.
     2433           define variable v-today       as date         no-undo.
     2434           define variable v-time        as integer      no-undo.
     2435           run cur-time in this-procedure (
     2436                 output v-today
     2437               , output v-time
     2438           ).
     2439           assign
     2440               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2441               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2442               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2443               buf_c-fbr-doc.corr-date        = v-today
     2444               buf_c-fbr-doc.corr-time        = v-time
     2445               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2446               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2447               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2448               buf_c-fbr-doc.is-del           = yes
     2449           .
     2450           assign
     2451               buf_fbr-doc.is-del = yes
     2452           .
     2453           for each buf_fbr-line exclusive-lock
     2454              where buf_fbr-line.doc-code = p-doc-code
     2455       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2456       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2457       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2458           :
     2459               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2460                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2461                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2462               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2463                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2464                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2465                                                       and buf_marking-lines.in-code  = "manufacturing"
     2466                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2467                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2468                                                       and buf_marking-lines.prt-code = 0
     2469               :
     2470                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2471                   assign
     2472                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2473                   .
     2474                 end .
     2475                 delete buf_marking-lines.
     2476               end .
     2477               delete buf_fbr-line.
     2478           end.
     2479           for each buf_fbr-recipe exclusive-lock
     2480              where buf_fbr-recipe.doc-code = p-doc-code
     2481       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2482       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2483       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2484           :
     2485               delete buf_fbr-recipe.
     2486           end.
     2487           for each buf_fbr-recipe-gds exclusive-lock
     2488              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2489       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2490       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2491       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2492           :
     2493               delete buf_fbr-recipe-gds.
     2494           end.
     2495           delete buf_fbr-doc.
     2496       end.
     2497   end.
     2498   END PROCEDURE.
     2499   PROCEDURE fbrlib-del-trn-doc :
     2500   do
     2501   on error undo, return error
     2502   :
     2503   define input parameter parparentproc        as widget-handle no-undo .
     2504   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2505   define input parameter p-trn-doc-type       as character    no-undo.
     2506   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2507   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     2508       define variable v-trn-doc-doc-code  as character     no-undo.
     2509       define buffer buf_trn-doc       for ub.trn-doc.
     2510   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2511     define variable v-cntxt-db-num        as integer   no-undo .
     2512     define variable v-cntxt-userid        as character no-undo .
     2513     define variable v-cntxt-level         as character no-undo .
     2514     define variable v-cntxt-host-code-obj as integer   no-undo .
     2515     define variable v-cntxt-obj-type      as character no-undo .
     2516     define variable v-cntxt-obj-code      as integer   no-undo .
     2517     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2518     define variable v-cntxt-is-admin      as logical   no-undo .
     2519   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2520     run mainmenu_getcntxt in parparentproc
     2521       (output v-cntxt-db-num
     2522       ,output v-cntxt-userid
     2523       ,output v-cntxt-level
     2524       ,output v-cntxt-host-code-obj
     2525       ,output v-cntxt-obj-type
     2526       ,output v-cntxt-obj-code
     2527       ,output v-cntxt-db-num-obj
     2528       ,output v-cntxt-is-admin
     2529       ) .
     2530       run fbrcode-trn-doc in this-procedure (
     2531             input 'производство':U
     2532           , input p-fbr-doc-doc-code
     2533           , input p-trn-doc-type
     2534           , output v-trn-doc-doc-code
     2535       ).
     2536       find first buf_trn-doc no-lock
     2537            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     2538       no-error.
     2539       if available buf_trn-doc
     2540       then do:
     2541           run str/del-doc.p (
     2542                 input parparentproc
     2543               , input buf_trn-doc.doc-code
     2544               , input v-cntxt-db-num
     2545               , input "del-doc.err"
     2546               , input ?
     2547               , input p-fbr-doc-doc-code
     2548               , input v-cntxt-userid
     2549               , input 0
     2550               , input p-phchip-num
     2551               , output p-chip-num
     2552           ) no-error.
     2553           if error-status :error
     2554           then do:
     2555             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     2556                                           ,v-trn-doc-doc-code
     2557                                           ,p-fbr-doc-doc-code
     2558                                           , chr(10)
     2559                                           , error-status:get-message(1)
     2560                                           , return-value ).
     2561           end.
     2562       end.
     2563   end.
     2564   END PROCEDURE.
     2565   PROCEDURE fbrlib-delete-fact-trn-doc :
     2566   define input parameter parparentproc    as widget-handle    no-undo.
     2567   define input parameter p-fbr-doc-code   as character        no-undo.
     2568   define input parameter p-doc-type       as character    no-undo.
     2569   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     2570   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     2571       define variable v-doc-code          as character        no-undo.
     2572       define variable v-ext-doc-type      as character        no-undo.
     2573       define variable v-trn-doc-recid     as recid            no-undo.
     2574       define variable varchip-code        as integer          no-undo.
     2575       define variable varchip-code2       as integer          no-undo.
     2576       define variable v-chip-counter      as integer          no-undo.
     2577       define buffer buf_trn-doc       for ub.trn-doc.
     2578       define buffer buf_pri_trn-doc   for ub.trn-doc.
     2579       define buffer buf_cons_trn-doc  for ub.trn-doc.
     2580   do
     2581   for buf_trn-doc
     2582     , buf_pri_trn-doc
     2583     , buf_cons_trn-doc
     2584   on error undo, return error
     2585   :
     2586   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2587     define variable v-cntxt-db-num        as integer   no-undo .
     2588     define variable v-cntxt-userid        as character no-undo .
     2589     define variable v-cntxt-level         as character no-undo .
     2590     define variable v-cntxt-host-code-obj as integer   no-undo .
     2591     define variable v-cntxt-obj-type      as character no-undo .
     2592     define variable v-cntxt-obj-code      as integer   no-undo .
     2593     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2594     define variable v-cntxt-is-admin      as logical   no-undo .
     2595   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2596     run mainmenu_getcntxt in parparentproc
     2597       (output v-cntxt-db-num
     2598       ,output v-cntxt-userid
     2599       ,output v-cntxt-level
     2600       ,output v-cntxt-host-code-obj
     2601       ,output v-cntxt-obj-type
     2602       ,output v-cntxt-obj-code
     2603       ,output v-cntxt-db-num-obj
     2604       ,output v-cntxt-is-admin
     2605       ) .
     2606       run fbrcode-trn-doc in this-procedure (
     2607             input 'производство':U
     2608           , input p-fbr-doc-code
     2609           , input p-doc-type
     2610           , output v-doc-code
     2611       ).
     2612       find first buf_trn-doc no-lock
     2613            where buf_trn-doc.doc-code = v-doc-code
     2614       no-error.
     2615       if not available buf_trn-doc
     2616       then do:
     2617           if p-doc-type <> 'спи':U
     2618           then do:
     2619               message
     2620                   "Не найден документ '" p-doc-type "'"
     2621                   "по документу производства " p-fbr-doc-code
     2622               view-as alert-box.
     2623               undo, return error.
     2624           end.
     2625           else do:
     2626           end.
     2627       end.
     2628       else do:
     2629           assign
     2630               v-trn-doc-recid = recid( buf_trn-doc )
     2631               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     2632           .
     2633           if v-ext-doc-type = 'ev':U
     2634           then do:
     2635               find first buf_pri_trn-doc no-lock
     2636                    where buf_pri_trn-doc.out-code     = v-doc-code
     2637                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     2638               no-error.
     2639               if available buf_pri_trn-doc
     2640               then do:
     2641                   run str/del-doc.p (
     2642                         input parparentproc
     2643                       , input buf_pri_trn-doc.doc-code
     2644                       , input v-cntxt-db-num
     2645                       , input "delfbr.err"
     2646                       , input ?
     2647                       , input p-fbr-doc-code
     2648                       , input v-cntxt-userid
     2649                       , input 0
     2650                       , input (if p-ph-chip-num <> ?
     2651                               then p-ph-chip-num
     2652                               else (if varchip-code <> 0
     2653                                   then varchip-code
     2654                                   else ?)
     2655                               )
     2656                       , output varchip-code2
     2657                   ) no-error.
     2658                   if error-status :error
     2659                   then do:
     2660                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2661                                                   ,buf_pri_trn-doc.doc-code
     2662                                                   ,p-fbr-doc-code
     2663                                                   , chr(10)
     2664                                                   , error-status:get-message(1)
     2665                                                   , return-value ).
     2666                   end.
     2667               end.
     2668           end.
     2669           define buffer buf_out_trn-doc       for ub.trn-doc.
     2670           if p-doc-type = 'при':U
     2671           then do:
     2672               assign
     2673                   v-chip-counter = 0
     2674               .
     2675               for each buf_out_trn-doc exclusive-lock
     2676                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     2677               on error undo, return error
     2678               :
     2679                   assign
     2680                       v-chip-counter = v-chip-counter + 1
     2681                   .
     2682                   if v-chip-counter > 1
     2683                   then do:
     2684                       assign
     2685                           varchip-code = varchip-code2
     2686                       .
     2687                   end.
     2688                   run str/del-doc.p (
     2689                         input parparentproc
     2690                       , input buf_out_trn-doc.doc-code
     2691                       , input v-cntxt-db-num
     2692                       , input "delfbr.err"
     2693                       , input ?
     2694                       , input p-fbr-doc-code
     2695                       , input v-cntxt-userid
     2696                       , input 0
     2697                       , input (if p-ph-chip-num <> ?
     2698                               then p-ph-chip-num
     2699                               else (if varchip-code <> 0
     2700                                   then varchip-code
     2701                                   else ?)
     2702                               )
     2703                       , output varchip-code2
     2704                   ) no-error.
     2705                   if error-status :error
     2706                   then do:
     2707                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     2708                                                   ,buf_out_trn-doc.doc-code
     2709                                                   ,buf_trn-doc.doc-code
     2710                                                   ,p-fbr-doc-code
     2711                                                   , chr(10)
     2712                                                   , error-status:get-message(1)
     2713                                                   , return-value ).
     2714                   end.
     2715               end.
     2716           end.
     2717           run str/del-doc.p (
     2718                 input parparentproc
     2719               , input buf_trn-doc.doc-code
     2720               , input v-cntxt-db-num
     2721               , input "delfbr.err"
     2722               , input ?
     2723               , input p-fbr-doc-code
     2724               , input v-cntxt-userid
     2725               , input 0
     2726               , input (if p-ph-chip-num <> ?
     2727                        then p-ph-chip-num
     2728                        else (if varchip-code <> 0
     2729                              then varchip-code
     2730                              else ?)
     2731                        )
     2732               , output varchip-code2
     2733           ) no-error.
     2734           if error-status :error
     2735           then do:
     2736               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2737                                             ,buf_trn-doc.doc-code
     2738                                             ,p-fbr-doc-code
     2739                                             , chr(10)
     2740                                             , error-status:get-message(1)
     2741                                             , return-value ).
     2742           end.
     2743           if p-doc-type = 'рас':U
     2744           or p-doc-type = 'спи':U
     2745           then do:
     2746               assign
     2747                   v-chip-counter = 0
     2748               .
     2749               for each buf_cons_trn-doc no-lock
     2750                  where buf_cons_trn-doc.out-code      = v-doc-code
     2751                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     2752               :
     2753                   assign
     2754                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     2755                       v-chip-counter = v-chip-counter + 1
     2756                   .
     2757                   assign
     2758                   varchip-code = if v-chip-counter = 2
     2759                                  then varchip-code2
     2760                                  else varchip-code.
     2761                   run str/del-doc.p (
     2762                         input parparentproc
     2763                       , input buf_cons_trn-doc.doc-code
     2764                       , input v-cntxt-db-num
     2765                       , input "delfbr.err"
     2766                       , input ?
     2767                       , input ?
     2768                       , input v-cntxt-userid
     2769                       , input 0
     2770                       , input (if p-ph-chip-num <> ?
     2771                                then p-ph-chip-num
     2772                                else ( if v-chip-counter = 1
     2773                                       then ?
     2774                                       else varchip-code )
     2775                                )
     2776                       , output varchip-code2
     2777                   ) no-error.
     2778                   if error-status :error
     2779                   then do:
     2780                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     2781                                                     ,buf_cons_trn-doc.doc-code
     2782                                                     ,p-fbr-doc-code
     2783                                                     , chr(10)
     2784                                                     , error-status:get-message(1)
     2785                                                     , return-value ).
     2786                   end.
     2787                   assign
     2788                       p-chip-num = varchip-code2
     2789                   .
     2790               end.
     2791           end.
     2792           assign
     2793               p-chip-num = varchip-code2
     2794           .
     2795       end.
     2796   end.
     2797   END PROCEDURE.
     2798   PROCEDURE fbrlib-print-del-error-message :
     2799   do
     2800   on error undo, return error
     2801   :
     2802       define variable v-user-action   as character    no-undo.
     2803       define variable v-printed       as logical      no-undo.
     2804       message
     2805           vss-workfile vss-revision vss-description
     2806           skip "Ошибка при удалении документа."
     2807           skip return-value
     2808           skip trim(error-status :get-message(1))
     2809           skip trim(error-status :get-message(2))
     2810           skip trim(error-status :get-message(3))
     2811       view-as alert-box error.
     2812       if search ("delfbr.err") <> ?
     2813       then do:
     2814         run gbl/prnfilen.w
     2815           (input  "Ошибки при удалении документа производства"
     2816           ,input  0
     2817           ,input  "delfbr.err"
     2818           ,input  7
     2819           ,output v-user-action
     2820           ,output v-printed
     2821           ).
     2822       end.
     2823   end.
     2824   END PROCEDURE.
     2825   procedure fbrlib-calc-brutto :
     2826   define input parameter p-recipe-type        as character        no-undo.
     2827   define input parameter p-netto              as decimal          no-undo.
     2828   define input parameter p-coeff-value        as decimal          no-undo.
     2829   define input parameter p-coeff-waste        as decimal          no-undo.
     2830   define input parameter p-brutto             as decimal          no-undo.
     2831   define input parameter p-calc-method        as integer          no-undo.
     2832   define output parameter p-new-netto         as decimal          no-undo.
     2833   define output parameter p-new-coeff-waste   as decimal          no-undo.
     2834   define output parameter p-new-brutto        as decimal          no-undo.
     2835   define output parameter p-new-calc-method   as integer          no-undo.
     2836   do
     2837   on error undo, return error
     2838   :
     2839       if p-recipe-type <> 'производство':U
     2840       then do:
     2841           assign
     2842               p-new-coeff-waste = 0
     2843               p-new-calc-method = 1
     2844               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     2845               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     2846           .
     2847       end.
     2848       else do:
     2849           assign
     2850               p-new-calc-method = p-calc-method
     2851           .
     2852           if p-coeff-waste = 0
     2853           then do:
     2854               assign
     2855                   p-coeff-value = 0
     2856               .
     2857           end.
     2858           case p-calc-method
     2859           :
     2860               when 1
     2861               then do:
     2862                   assign
     2863                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     2864                       p-new-coeff-waste   = p-coeff-waste
     2865                       p-new-brutto        = p-brutto
     2866                   .
     2867               end.
     2868               when 2
     2869               then do:
     2870                   assign
     2871                       p-new-netto         = p-netto
     2872                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     2873                       p-new-brutto        = p-brutto
     2874                   .
     2875               end.
     2876               when 3
     2877               then do:
     2878                   assign
     2879                       p-new-netto         = p-netto
     2880                       p-new-coeff-waste   = p-coeff-waste
     2881                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     2882                   .
     2883               end.
     2884               otherwise do:
     2885                   define variable v-yesno    as logical      no-undo.
     2886                   assign
     2887                       v-yesno = yes
     2888                   .
     2889                   message
     2890                       "Неверный метод для расчета брутто, нетто и процента потерь."
     2891                       skip "Значение метода должно быть 1, 2 или 3."
     2892                       skip(1)
     2893                       skip "Заданное значение:" p-calc-method
     2894                       skip(1)
     2895                       skip "Установить значение метода расчета 1"
     2896                       skip "(расчет нетто по брутто и проценту потерь)?"
     2897                   view-as alert-box warning
     2898                   buttons yes-no
     2899                   title "Неверное значение метода пересчета в строках документа-производства"
     2900                   update v-yesno
     2901                   .
     2902                   if v-yesno = yes
     2903                   then do:
     2904                       assign
     2905                           p-new-calc-method   = 1
     2906                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     2907                           p-new-coeff-waste   = p-coeff-waste
     2908                           p-new-brutto        = p-brutto
     2909                       .
     2910                   end.
     2911                   else do:
     2912                       message
     2913                               vss-workfile vss-revision vss-description
     2914                           skip(1)
     2915                           skip "Ошибка расчета брутто, нетто и процента потерь."
     2916                           skip return-value
     2917                           skip trim(error-status :get-message(1))
     2918                               trim(error-status :get-message(2))
     2919                               trim(error-status :get-message(3))
     2920                       view-as alert-box error
     2921                       title "Неверное значение метода расчета"
     2922                       .
     2923                       undo, return error .
     2924                   end.
     2925               end.
     2926           end case.
     2927       end.
     2928   end.
     2929   end procedure.
     2930   procedure fbrlib-check-brutto :
     2931   define input parameter p-recipe-type        as character        no-undo.
     2932   define input parameter p-netto              as decimal          no-undo.
     2933   define input parameter p-coeff-value        as decimal          no-undo.
     2934   define input parameter p-coeff-waste        as decimal          no-undo.
     2935   define input parameter p-brutto             as decimal          no-undo.
     2936   define input parameter p-calc-method        as integer          no-undo.
     2937   define output parameter p-error-message     as character        no-undo.
     2938   define output parameter p-not-good          as logical          no-undo.
     2939   do
     2940   on error undo, return error
     2941   :
     2942       if p-recipe-type <> 'производство':U
     2943       then do:
     2944           if p-netto <> p-brutto
     2945           or p-coeff-waste <> 0
     2946           then do:
     2947               assign
     2948                   p-not-good      = yes
     2949                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     2950                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     2951               .
     2952           end.
     2953       end.
     2954       else do:
     2955           if p-coeff-waste = 0
     2956           then do:
     2957               assign
     2958                   p-coeff-value = 0
     2959               .
     2960           end.
     2961           case p-calc-method
     2962           :
     2963               when 1
     2964               then do:
     2965                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     2966                   then do:
     2967                       assign
     2968                           p-not-good      = yes
     2969                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     2970                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     2971                       .
     2972                   end.
     2973               end.
     2974               when 2
     2975               then do:
     2976                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     2977                   then do:
     2978                       assign
     2979                           p-not-good      = yes
     2980                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     2981                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     2982                       .
     2983                   end.
     2984               end.
     2985               when 3
     2986               then do:
     2987                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     2988                   then do:
     2989                       assign
     2990                           p-not-good      = yes
     2991                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     2992                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     2993                       .
     2994                   end.
     2995               end.
     2996               otherwise do:
     2997                   assign
     2998                       p-not-good      = yes
     2999                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3000                   .
     3001               end.
     3002           end case.
     3003       end.
     3004   end.
     3005   end procedure.
     3006   procedure fbrlib-check-fbr-recipe :
     3007   define input parameter p-doc-code       as character        no-undo.
     3008   define input parameter p-recipe-code    as character        no-undo.
     3009   define output parameter p-is-correct    as logical          no-undo.
     3010       define variable v-comp-factor    as decimal      no-undo.
     3011       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3012       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3013       define buffer buf_fbr-line          for ub.fbr-line.
     3014   do
     3015   for buf_fbr-recipe
     3016     , buf_fbr-recipe-gds
     3017     , buf_fbr-line
     3018   on error undo, return error
     3019   :
     3020       assign
     3021           p-is-correct = yes
     3022       .
     3023       find first buf_fbr-recipe no-lock
     3024            where buf_fbr-recipe.doc-code    = p-doc-code
     3025              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3026       .
     3027       if not available buf_fbr-recipe then do:
     3028         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3029       end.
     3030       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3031       then do:
     3032       end.
     3033       else do:
     3034           find first buf_fbr-line no-lock
     3035                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3036                  and buf_fbr-line.is-comp     = yes
     3037                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3038                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3039                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3040                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3041           .
     3042           assign
     3043               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3044           .
     3045           recipe-line-cycle:
     3046           for each buf_fbr-recipe-gds no-lock
     3047              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3048                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3049           on error undo, return error
     3050           :
     3051               find first buf_fbr-line no-lock
     3052                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3053                      and buf_fbr-line.is-comp     = no
     3054                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3055                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3056                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3057                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3058               .
     3059               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3060               then do:
     3061                   assign
     3062                       p-is-correct = no
     3063                   .
     3064                   leave recipe-line-cycle.
     3065               end.
     3066           end.
     3067       end.
     3068   end.
     3069   end procedure.
     3070   procedure fbrlib-get-recipe-type :
     3071   define input parameter p-fbr-doc-code   as character        no-undo.
     3072   define input parameter p-recipe-code    as character        no-undo.
     3073   define output parameter p-recipe-type   as character        no-undo.
     3074       define buffer buf_recipe        for ub.recipe.
     3075       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3076   do
     3077   for buf_recipe
     3078     , buf_fbr-recipe
     3079   on error undo, return error
     3080   :
     3081       if p-fbr-doc-code = ""
     3082       then do:
     3083           find first buf_recipe no-lock
     3084                where buf_recipe.recipe-code = p-recipe-code
     3085           no-error.
     3086           if available buf_recipe
     3087           then do:
     3088               assign
     3089                   p-recipe-type = buf_recipe.recipe-type
     3090               .
     3091           end.
     3092           else do:
     3093               assign
     3094                   p-recipe-type = "":U
     3095               .
     3096           end.
     3097       end.
     3098       else do:
     3099           find first buf_fbr-recipe no-lock
     3100                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3101                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3102           no-error.
     3103           if available buf_fbr-recipe
     3104           then do:
     3105               assign
     3106                   p-recipe-type = buf_fbr-recipe.recipe-type
     3107               .
     3108           end.
     3109           else do:
     3110               assign
     3111                   p-recipe-type = "":U
     3112               .
     3113           end.
     3114       end.
     3115   end.
     3116   end procedure.
     3117   PROCEDURE calc-comp-from-ingr :
     3118   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3119   define input parameter p-fact-qnty                          as decimal      no-undo.
     3120   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3121   define output parameter p-comp-qnty                         as decimal      no-undo.
     3122       define variable v-ingr-qnty     as decimal       no-undo.
     3123       define buffer buf_i_fbr-line    for ub.fbr-line.
     3124       define buffer buf_fbr-line      for ub.fbr-line.
     3125       define buffer buf_recipe        for ub.fbr-recipe.
     3126       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3127   do
     3128   for buf_i_fbr-line
     3129     , buf_fbr-line
     3130     , buf_recipe
     3131     , buf_recipe-gds
     3132   on error undo, return error
     3133   :
     3134       find first buf_i_fbr-line no-lock
     3135            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3136       .
     3137       find first buf_recipe no-lock
     3138            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3139              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3140       no-error.
     3141       if not available buf_recipe
     3142       then do:
     3143           message
     3144                   vss-workfile vss-revision vss-description
     3145               skip "В строке производства не указан рецепт."
     3146               skip "Невозможно рассчитать количество составного товара."
     3147               skip return-value
     3148               skip trim(error-status :get-message(1))
     3149                   trim(error-status :get-message(2))
     3150                   trim(error-status :get-message(3))
     3151           view-as alert-box error.
     3152           undo, return error .
     3153       end.
     3154       if buf_recipe.recipe-type = 'альтернатива':U
     3155       then do:
     3156           for each buf_fbr-line no-lock
     3157              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3158                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3159                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3160           on error undo, return error
     3161           :
     3162               find first buf_recipe-gds no-lock
     3163                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3164                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3165                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3166                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3167                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3168               .
     3169               assign
     3170                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3171               .
     3172           end.
     3173           assign
     3174               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3175           .
     3176       end.
     3177       else do:
     3178           find first buf_recipe-gds no-lock
     3179                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3180                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3181                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3182                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3183                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3184           .
     3185           assign
     3186               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3187           .
     3188       end.
     3189       find first buf_fbr-line no-lock
     3190            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3191              and buf_fbr-line.is-comp     = yes
     3192              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3193       .
     3194       assign
     3195           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3196       .
     3197   end.
     3198   END PROCEDURE.
     3199   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3200   define input parameter p-recipe-code    as character    no-undo.
     3201   define input parameter p-gds-code       as integer      no-undo.
     3202   define output parameter p-line-qnty     as decimal      no-undo.
     3203   define output parameter p-used-qnty     as decimal      no-undo.
     3204   define output parameter p-recipe-qnty   as decimal      no-undo.
     3205       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3206   do
     3207   for buf_temp_dressing-ingr
     3208   on error undo, return error
     3209   :
     3210       find first buf_temp_dressing-ingr no-lock
     3211            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3212              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3213       no-error.
     3214       if available buf_temp_dressing-ingr
     3215       then do:
     3216           assign
     3217               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3218               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3219               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3220           .
     3221       end.
     3222       else do:
     3223           assign
     3224               p-line-qnty     = 0
     3225               p-used-qnty     = 0
     3226               p-recipe-qnty   = 0
     3227           .
     3228       end.
     3229   end.
     3230   END PROCEDURE.
     3231   PROCEDURE fbrlib_adjust-recipe :
     3232   do
     3233   on error undo, return error
     3234   :
     3235   define input parameter parparentproc as widget-handle no-undo .
     3236   define input parameter p-fbrhist-handle as handle no-undo .
     3237   define input parameter p-doc-code       as character    no-undo.
     3238   define input parameter p-recipe-code    as character    no-undo.
     3239   define input parameter p-price-sale-obj-type as character no-undo .
     3240   define input parameter p-price-sale-obj-code as integer no-undo .
     3241       define variable v-recipe-qnty       as decimal      no-undo.
     3242       define variable v-comp-qnty         as decimal      no-undo.
     3243       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3244       define variable v-ingr-qnty         as decimal      no-undo.
     3245       define variable v-qnty              as decimal      no-undo.
     3246       define variable v-coeff-waste       as decimal      no-undo.
     3247       define variable v-brutto-qnty       as decimal      no-undo.
     3248       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3249       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3250       define buffer buf_fbr-line          for ub.fbr-line.
     3251       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3252       find first buf_fbr-recipe no-lock
     3253            where buf_fbr-recipe.doc-code      = p-doc-code
     3254              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3255       .
     3256       assign
     3257           v-recipe-qnty = buf_fbr-recipe.qnty
     3258       .
     3259       find first buf_fbr-line no-lock
     3260            where buf_fbr-line.doc-code    = p-doc-code
     3261              and buf_fbr-line.is-comp     = yes
     3262              and buf_fbr-line.recipe-code = p-recipe-code
     3263       .
     3264       assign
     3265           v-comp-qnty = buf_fbr-line.fact-qnty
     3266       .
     3267       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3268       then do:
     3269       end.
     3270       else do:
     3271           for each buf_fbr-recipe-gds no-lock
     3272              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3273                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3274           on error undo, return error
     3275           :
     3276               find first buf_fbr-line no-lock
     3277                    where buf_fbr-line.doc-code    = p-doc-code
     3278                      and buf_fbr-line.is-comp     = no
     3279                      and buf_fbr-line.recipe-code = p-recipe-code
     3280                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3281                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3282                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3283               .
     3284               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3285               then do:
     3286                   do transaction
     3287                   on error undo, return error
     3288                   :
     3289                       find first buf_el_fbr-recipe-gds exclusive-lock
     3290                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3291                       .
     3292                       assign
     3293                           buf_el_fbr-recipe-gds.calc-method   = 1
     3294                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3295                       .
     3296                       run fbrlib-calc-brutto in this-procedure (
     3297                             input buf_fbr-recipe.recipe-type
     3298                           , input 0
     3299                           , input buf_el_fbr-recipe-gds.coeff-value
     3300                           , input buf_el_fbr-recipe-gds.coeff-waste
     3301                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3302                           , input 1
     3303                           , output buf_el_fbr-recipe-gds.qnty
     3304                           , output buf_el_fbr-recipe-gds.coeff-waste
     3305                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3306                           , output buf_el_fbr-recipe-gds.calc-method
     3307                       ).
     3308                   end.
     3309               end.
     3310           end.
     3311           run fbrlib_adjust-doc-lines in this-procedure (
     3312                 input parparentproc
     3313               , input p-fbrhist-handle
     3314               , input p-doc-code
     3315               , input p-recipe-code
     3316               , input p-price-sale-obj-type
     3317               , input p-price-sale-obj-code
     3318           ).
     3319       end.
     3320   end.
     3321   END PROCEDURE.
     3322   PROCEDURE fbrlib_adjust-doc-lines :
     3323   define input parameter parparentproc as widget-handle no-undo .
     3324   define input parameter p-fbrhist-handle as handle no-undo .
     3325   define input parameter p-doc-code       as character    no-undo.
     3326   define input parameter p-recipe-code    as character    no-undo.
     3327   define input parameter p-price-sale-obj-type as character no-undo .
     3328   define input parameter p-price-sale-obj-code as integer no-undo .
     3329   define variable v-comp-qnty         as decimal      no-undo.
     3330   define variable v-trn-type          as character    no-undo.
     3331   define variable v-ingr-qnty         as decimal      no-undo.
     3332   define variable v-recipe-qnty       as decimal      no-undo.
     3333   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3334   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3335   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3336   define buffer buf_fbr-line          for ub.fbr-line.
     3337   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3338   define buffer buf_goods             for ub.goods.
     3339   define buffer buf_fbr-doc           for ub.fbr-doc.
     3340   do
     3341   for buf_fbr-recipe
     3342     , buf_fbr-recipe-gds
     3343     , buf_fbr-line
     3344     , buf_coeff_fbr-line
     3345     , buf_goods
     3346     , buf_fbr-doc
     3347   on error undo, return error
     3348   :
     3349       find first buf_fbr-line no-lock
     3350            where buf_fbr-line.doc-code      = p-doc-code
     3351              and buf_fbr-line.is-comp       = yes
     3352              and buf_fbr-line.recipe-code   = p-recipe-code
     3353       .
     3354       find first buf_fbr-doc no-lock
     3355            where buf_fbr-doc.doc-code      = p-doc-code
     3356       .
     3357       assign
     3358           v-comp-qnty = buf_fbr-line.fact-qnty
     3359           v-trn-type  = buf_fbr-line.trn-type
     3360       .
     3361       find first buf_fbr-recipe no-lock
     3362            where buf_fbr-recipe.doc-code    = p-doc-code
     3363              and buf_fbr-recipe.recipe-code = p-recipe-code
     3364       .
     3365       assign
     3366       v-recipe-qnty = buf_fbr-recipe.qnty
     3367       .
     3368       do transaction
     3369       on error undo, return error
     3370       :
     3371           for each buf_fbr-recipe-gds no-lock
     3372              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3373                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3374           on error undo, return error
     3375           :
     3376               find first buf_fbr-line no-lock
     3377                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3378                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3379                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3380                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3381                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3382               no-error.
     3383               if not available buf_fbr-line
     3384               then do:
     3385                   find first buf_goods no-lock
     3386                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3387                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3388                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3389                   .
     3390                   run str/fbr-crln.p (
     3391                         input parparentproc
     3392                       , input recid( buf_fbr-doc )
     3393                       , input recid( buf_goods )
     3394                       , input buf_fbr-recipe-gds.recipe-code
     3395                       , input v-trn-type
     3396                       , input no
     3397                       , input no
     3398                       , input buf_fbr-doc.obj-type
     3399                       , input buf_fbr-doc.obj-code
     3400                       , output v-fbr-v-fbr-doc-line-recid
     3401                   ).
     3402                   find first buf_fbr-line no-lock
     3403                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3404                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3405                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3406                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3407                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3408                   no-error.
     3409                   if not available buf_fbr-line
     3410                   then do:
     3411                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3412                                                      , p-doc-code
     3413                                                      , buf_fbr-recipe-gds.artic
     3414                                                      , buf_fbr-recipe-gds.prod-type
     3415                                                      , buf_fbr-recipe-gds.prod-code).
     3416                   end.
     3417               end.
     3418               find first buf_coeff_fbr-line exclusive-lock
     3419                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3420               .
     3421               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3422               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3423               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3424               then do:
     3425                   assign
     3426                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3427                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3428                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3429                   .
     3430               end.
     3431           end.
     3432       end.
     3433       define variable v-need-goods    as logical       no-undo.
     3434       define variable v-need-goods-list       as character     no-undo.
     3435       define variable v-need-goods-qnty-list  as character     no-undo.
     3436       find first buf_fbr-line no-lock
     3437            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3438              and buf_fbr-line.is-comp     = yes
     3439              and buf_fbr-line.recipe-code = p-recipe-code
     3440       .
     3441       run str/fbr-qnty.p (
     3442             input parparentproc
     3443           , input p-fbrhist-handle
     3444           , input recid( buf_fbr-doc )
     3445           , input recid( buf_fbr-line )
     3446           , input no
     3447           , input "ingr"
     3448           , input no
     3449           , input p-price-sale-obj-type
     3450           , input p-price-sale-obj-code
     3451           , input no
     3452           , input no
     3453           , input no
     3454           , output v-need-goods
     3455           , output v-need-goods-list
     3456           , output v-need-goods-qnty-list
     3457       ).
     3458   end.
     3459   END PROCEDURE.
     3460   procedure fbrlib_check-before-close :
     3461   define input parameter p-doc-code as character no-undo .
     3462   define variable same-sale as decimal no-undo .
     3463   define variable is-waste as logical no-undo .
     3464   define variable fix-price as logical no-undo .
     3465   define buffer buf_fbr-doc for ub.fbr-doc.
     3466   define buffer buf_fbr-line for ub.fbr-line.
     3467   define buffer buf_goods for ub.goods.
     3468   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3469   do
     3470   on error undo, return error
     3471   :
     3472     for each buf_fbr-line no-lock
     3473         where buf_fbr-line.doc-code = p-doc-code
     3474       , each buf_goods no-lock
     3475         where buf_goods.artic     = buf_fbr-line.artic
     3476           and buf_goods.prod-type = buf_fbr-line.prod-type
     3477           and buf_goods.prod-code = buf_fbr-line.prod-code
     3478     break by buf_fbr-line.prod-type
     3479           by buf_fbr-line.prod-code
     3480           by buf_fbr-line.artic
     3481     :
     3482       if first-of (buf_fbr-line.artic)
     3483       then do:
     3484         assign
     3485         same-sale = buf_fbr-line.price-sale
     3486         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3487         fix-price = buf_fbr-line.is-calc
     3488         .
     3489       end.
     3490       if same-sale <> buf_fbr-line.price-sale
     3491       then do:
     3492           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3493                                         ,p-doc-code
     3494                                         ,buf_goods.artic
     3495                                         ,buf_goods.gds-name
     3496                                         ,chr(10)).
     3497       end.
     3498       if fix-price <> buf_fbr-line.is-calc then do:
     3499           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3500                                         ,p-doc-code
     3501                                         ,buf_goods.artic
     3502                                         ,buf_goods.gds-name
     3503                                         ,chr(10)).
     3504       end.
     3505       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3506       then do:
     3507         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     3508                                         ,p-doc-code
     3509                                         ,buf_goods.artic
     3510                                         ,buf_goods.gds-name
     3511                                         ,chr(10)).
     3512       end.
     3513       if buf_fbr-line.rsrv-qnty <> ?
     3514       and buf_goods.gds-type <> 'у':U
     3515       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     3516       and buf_fbr-line.fact-qnty <> 0
     3517       then do:
     3518         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     3519           if  can-find(first buf_fbr-gds-obj no-lock where
     3520                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3521               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     3522               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     3523               and buf_fbr-gds-obj.is-null-price  )  then .
     3524                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3525                                         ,p-doc-code
     3526                                         ,buf_goods.artic
     3527                                         ,buf_goods.gds-name
     3528                                         ,chr(10)
     3529                                         ,buf_fbr-line.recipe-code
     3530                                         ).
     3531         end.
     3532         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3533                                         ,p-doc-code
     3534                                         ,buf_goods.artic
     3535                                         ,buf_goods.gds-name
     3536                                         ,chr(10)
     3537                                         ,buf_fbr-line.recipe-code
     3538                                         ).
     3539       end.
     3540     end.
     3541   end.
     3542   end procedure.
     3543   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3544       define variable v-chip-num like ub.c-trn-doc.chip-num no-undo .
     3545       define buffer buf_temp_fbrcode-doc-code        for temp_fbrcode-doc-code.
     3546       define buffer buf_trn-doc                   for trn-doc.
     3547   do
     3548   for buf_temp_fbrcode-doc-code
     3549     , buf_trn-doc
     3550   on error undo, return error
     3551   :
     3552       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
     3553           input p-sale-code
     3554       ).
     3555       for each buf_temp_fbrcode-doc-code
     3556       by buf_temp_fbrcode-doc-code.order descending
     3557       on error undo, return error
     3558       :
     3559           case buf_temp_fbrcode-doc-code.rec-type
     3560           :
     3561               when 'производство':U
     3562               then do:
     3563                   run fbrlib-delete-fact-fbr-doc in this-procedure (
     3564                       input parparentproc
     3565                      ,input buf_temp_fbrcode-doc-code.doc-code
     3566                      ,input p-chip-num
     3567                   ) no-error.
     3568                   if error-status :error
     3569                   then do:
     3570                       message
     3571                                vss-workfile vss-revision vss-description
     3572                           skip(1)
     3573                           skip "Ошибка удаления документа производства."
     3574                           skip(1)
     3575                           skip "Номер документа:" buf_temp_fbrcode-doc-code.doc-code
     3576                           skip return-value
     3577                           skip trim(error-status :get-message(1))
     3578                                trim(error-status :get-message(2))
     3579                                trim(error-status :get-message(3))
     3580                       view-as alert-box error.
     3581                       undo, return error .
     3582                   end.
     3583               end.
     3584               when 'маг':U
     3585               or when 'скл':U
     3586               then do:
     3587                   find first buf_trn-doc exclusive-lock
     3588                        where buf_trn-doc.doc-code = buf_temp_fbrcode-doc-code.doc-code
     3589                   no-error.
     3590                   if available buf_trn-doc
     3591                   then do:
     3592                   run fbrlib-delete-fact-trn-doc in this-procedure (
     3593                         input parparentproc
     3594                       , input buf_temp_fbrcode-doc-code.doc-code
     3595                       , input buf_temp_fbrcode-doc-code.doc-type
     3596                       , input p-chip-num
     3597                       , output v-chip-num
     3598                   ) no-error.
     3599                   if error-status :error
     3600                   then do:
     3601                       message
     3602                                vss-workfile vss-revision vss-description
     3603                           skip(1)
     3604                           skip "Ошибка удаления складского документа."
     3605                           skip(1)
     3606                           skip "Номер документа:" buf_temp_fbrcode-doc-code.doc-code
     3607                           skip "Тип документа:  " buf_temp_fbrcode-doc-code.doc-type
     3608                           skip return-value
     3609                           skip trim(error-status :get-message(1))
     3610                                trim(error-status :get-message(2))
     3611                                trim(error-status :get-message(3))
     3612                       view-as alert-box error.
     3613                       undo, return error .
     3614                   end.
     3615                   end.
     3616               end.
     3617           end case.
     3618       end.
     3619   end.
