        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-sale-code      as character        no-undo.
        4   define input parameter p-chip-num       like ub.c-trn-doc.chip-num no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: fbrdel.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/fbrdel.p $":U .
       10   define variable vss-description as character no-undo init "Удаление документов производства и внутренних перемещений при удалении закрытой продажи".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "X(65)" no-undo
       81   initial "@(#)$Workfile$ $Revision$".
       82   define temp-table temp_fbrcode-doc-code no-undo
       83       field rec-type      as character
       84       field doc-code      as character
       85       field obj-type      as character
       86       field obj-code      as integer
       87       field cli-type      as character
       88       field cli-code      as integer
       89       field ext-doc-type  as character
       90       field doc-type      as character
       91       field order         as integer
       92       index pi is primary unique rec-type doc-code
       93       index od order
       94   .
       95   procedure fbrcode-gen-recipe-code :
       96   do
       97   on error undo, return error
       98   :
       99   define input parameter p-obj-type           as character    no-undo.
      100   define input parameter p-obj-code           as integer      no-undo.
      101   define output parameter p-recipe-code       as character    no-undo.
      102       assign
      103           p-recipe-code   = string( next-value( s-recipe, ub ) )
      104                               + "-"
      105                               + trim( string( p-obj-code, ">>>>9" ) )
      106                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      107       .
      108   end.
      109   end procedure.
      110   procedure fbrcode-is-from-object :
      111   do
      112   on error undo, return error
      113   :
      114   define input parameter p-doc-code           as character    no-undo.
      115   define input parameter p-obj-type           as character    no-undo.
      116   define input parameter p-obj-code           as integer      no-undo.
      117   define output parameter p-is-from-object    as logical      no-undo.
      118       if num-entries( p-doc-code, "-" ) < 2
      119       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      120                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      121       then do:
      122           assign
      123               p-is-from-object = no
      124           .
      125       end.
      126       else do:
      127           assign
      128               p-is-from-object = yes
      129           .
      130       end.
      131   end.
      132   end procedure.
      133   procedure fbrcode-trn-doc :
      134   do
      135   on error undo, return error
      136   :
      137       define input parameter p-out-doc-type       as character    no-undo.
      138       define input parameter p-out-code           as character    no-undo.
      139       define input parameter p-trn-doc-out-type   as character    no-undo.
      140       define output parameter p-trn-doc-doc-code  as character   no-undo.
      141       case p-out-doc-type:
      142           when 'производство':U
      143           then do:
      144               case p-trn-doc-out-type :
      145                   when 'рас':U
      146                   then do:
      147                       assign
      148                           p-trn-doc-doc-code = p-out-code
      149                       .
      150                   end.
      151                   when 'при':U
      152                   then do:
      153                       assign
      154                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      155                       .
      156                   end.
      157                   when 'спи':U
      158                   then do:
      159                       assign
      160                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      161                       .
      162                   end.
      163                   otherwise do:
      164                       assign
      165                           p-trn-doc-doc-code = ""
      166                       .
      167                       undo, return error "Не может быть обработан тип складского документа '"
      168                                           + p-trn-doc-out-type + "' во входных параметрах".
      169                   end.
      170               end case.
      171           end.
      172           otherwise do:
      173               assign
      174                   p-trn-doc-doc-code = ""
      175               .
      176               undo, return error "Не может быть обработан тип внешнего документа '"
      177                                   + p-out-doc-type + "' во входных параметрах".
      178           end.
      179       end case.
      180   end.
      181   end procedure.
      182   procedure fbrcode-fill-fbr-by-sale-or-pln :
      183   define input parameter p-main-doc-code      as character        no-undo.
      184       define variable v-order    as integer      no-undo.
      185       define buffer buf_fbr-doc               for ub.fbr-doc.
      186       define buffer buf_trn-doc               for ub.trn-doc.
      187       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      188   do
      189   for buf_fbr-doc
      190     , buf_trn-doc
      191     , buf_temp_fbrcode-doc-code
      192   on error undo, return error
      193   :
      194       for each buf_temp_fbrcode-doc-code
      195       on error undo, return error
      196       :
      197           delete buf_temp_fbrcode-doc-code.
      198       end.
      199       assign
      200           v-order = 0
      201       .
      202       for each buf_fbr-doc no-lock
      203          where buf_fbr-doc.out-code = p-main-doc-code
      204       on error undo, return error
      205       :
      206           create buf_temp_fbrcode-doc-code.
      207           assign
      208               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      209               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      210               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      211               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      212               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      213               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      214               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      215               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      216           .
      217           for each buf_trn-doc no-lock
      218              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      219           by buf_trn-doc.fact-order
      220           on error undo, return error
      221           :
      222               if buf_trn-doc.ext-doc-type = 'em':U
      223               or buf_trn-doc.ext-doc-type = 'im':U
      224               or buf_trn-doc.ext-doc-type = 'wm':U
      225               or buf_trn-doc.ext-doc-type = 'ev':U
      226               then do:
      227                   assign
      228                       v-order = v-order + 1
      229                   .
      230                   create buf_temp_fbrcode-doc-code.
      231                   assign
      232                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      233                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      234                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      235                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      236                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      237                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      238                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      239                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      240                       buf_temp_fbrcode-doc-code.order         = v-order
      241                   .
      242               end.
      243           end.
      244           assign
      245               v-order  = v-order + 1
      246           .
      247           find first buf_temp_fbrcode-doc-code
      248                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      249                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      250           .
      251           assign
      252               buf_temp_fbrcode-doc-code.order = v-order
      253           .
      254       end.
      255       for each buf_trn-doc no-lock
      256          where buf_trn-doc.out-code = p-main-doc-code
      257       by buf_trn-doc.fact-order
      258       on error undo, return error
      259       :
      260           assign
      261               v-order = v-order + 1
      262           .
      263           create buf_temp_fbrcode-doc-code.
      264           assign
      265               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      266               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      267               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      268               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      269               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      270               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      271               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      272               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      273               buf_temp_fbrcode-doc-code.order         = v-order
      274           .
      275       end.
      276   end.
      277   end procedure.
      278   procedure fbrcode-get-final-doc :
      279   define input parameter p-main-doc-code      as character        no-undo.
      280   define output parameter p-income-doc-code   as character        no-undo.
      281       define variable v-main-obj-type    as character    no-undo.
      282       define variable v-main-obj-code    as integer      no-undo.
      283       define buffer buf_trn-doc               for ub.trn-doc.
      284       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      285   do
      286   for buf_trn-doc
      287   on error undo, return error
      288   :
      289       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      290           input p-main-doc-code
      291       ).
      292       find first buf_trn-doc no-lock
      293            where buf_trn-doc.doc-code = p-main-doc-code
      294       .
      295       assign
      296           v-main-obj-type = buf_trn-doc.obj-type
      297           v-main-obj-code = buf_trn-doc.obj-code
      298       .
      299       find first buf_temp_fbrcode-doc-code
      300            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      301              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      302              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      303       no-error.
      304       if available buf_temp_fbrcode-doc-code
      305       then do:
      306           find first buf_trn-doc no-lock
      307                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      308                  and buf_trn-doc.ext-doc-type = 'iv':U
      309           .
      310           assign
      311               p-income-doc-code = buf_trn-doc.doc-code
      312           .
      313       end.
      314       else do:
      315           find first buf_temp_fbrcode-doc-code
      316                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      317                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      318                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      319           no-error.
      320           if available buf_temp_fbrcode-doc-code
      321           then do:
      322               assign
      323                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      324               .
      325           end.
      326           else do:
      327               assign
      328                   p-income-doc-code = "":U
      329               .
      330           end.
      331       end.
      332   end.
      333   end procedure.
      334   define variable vss-include-info1 as character format "X(65)" no-undo
      335   initial "@(#)$Workfile$ $Revision$".
      336   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      337   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      338   define temp-table temp_fbrlib_recipe no-undo
      339       field recipe-code                   as character
      340       field fbr-doc-code                  as character
      341       field income-goods-doc-code         as character
      342       field count-income                  as integer
      343       field qnty-income                   as decimal
      344       field sum-income-sale               as decimal
      345       field sum-income-cost-base          as decimal
      346       field sum-income-cost-rubl          as decimal
      347       field sum-income-vat-cost-base      as decimal
      348       field sum-income-vat-cost-rubl      as decimal
      349       field write-off-goods-doc-code      as character
      350       field write-off-office-doc-code     as character
      351       field count-write-off               as integer
      352       field qnty-write-off                as decimal
      353       field sum-write-off-sale            as decimal
      354       field sum-write-off-cost-base       as decimal
      355       field sum-write-off-cost-rubl       as decimal
      356       field sum-write-off-vat-cost-base   as decimal
      357       field sum-write-off-vat-cost-rubl   as decimal
      358   index pi is primary unique recipe-code
      359   index income income-goods-doc-code
      360   index wogds write-off-goods-doc-code
