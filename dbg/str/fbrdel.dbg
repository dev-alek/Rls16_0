      370   .
      371   define temp-table temp_recipe-order no-undo
      372       field recipe-code   as character
      373       field order         as integer
      374       index pi is primary unique order
      375   .
      376   define temp-table temp_recipe-childs-qnty no-undo
      377       field recipe-code   as character
      378       field childs-qnty   as integer
      379       field order         as integer
      380       index pi is primary unique recipe-code
      381   .
      382   define temp-table temp_recipe-childs no-undo
      383       field recipe-code       as character
      384       field child-code        as integer
