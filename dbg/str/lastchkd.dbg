      406         VIEW-AS TEXT
      407        SIZE 1 BY .83 NO-UNDO.
      408   DEFINE VARIABLE F-delim-12 AS CHARACTER FORMAT "X(256)":U INITIAL ":"
      409         VIEW-AS TEXT
      410        SIZE 1 BY .67 NO-UNDO.
      411   DEFINE VARIABLE F-delim-21 AS CHARACTER FORMAT "X(256)":U INITIAL ":"
      412         VIEW-AS TEXT
      413        SIZE 1 BY .67 NO-UNDO.
      414   DEFINE VARIABLE F-delim-22 AS CHARACTER FORMAT "X(256)":U INITIAL ":"
