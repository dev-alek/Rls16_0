      383        SIZE 10 BY 1
      384        BGCOLOR 8 .
      385   DEFINE BUTTON b-quit AUTO-END-KEY
      386        LABEL "&Отмена"
      387        SIZE 10 BY 1
      388        BGCOLOR 8 .
      389   DEFINE VARIABLE F-chk-num-1 LIKE chk-doc.chk-num
