     1101           (output v-curr-sv-date
     1102           ) .
     1103       end.
     1104       if v-curr-sv-date <> ?
     1105       then do:
     1106         run gbl/lastdate.p
     1107           (input  v-curr-sv-date
     1108           ,output v-new-sv-date
     1109           ).
     1110         assign
     1111           self :screen-value = string(v-new-sv-date) .
     1112         .
     1113       end.
     1114     end.
     1115     return no-apply .
     1116   end.
     1117   on ctrl-f of f-date-2 in frame Dialog-Frame
     1118   do:
     1119     if (can-query (self, "sensitive")
     1120        and
     1121        self :sensitive = true
     1122        )
     1123     or (can-query (self, "read-only")
     1124        and
     1125        self :read-only = false
     1126        )
     1127     then do:
     1128       if self :handle <> focus :handle
     1129       then do:
     1130         apply "entry":u to self .
     1131       end.
     1132       define variable v-ok            as logical   no-undo .
     1133       define variable v-curr-sv-date  as date      no-undo .
     1134       define variable v-description   as character no-undo .
     1135       assign
     1136         v-curr-sv-date = date(self :screen-value) no-error
     1137       .
     1138       if v-curr-sv-date = ?
     1139       then do:
     1140         run gbl/getcurdt.p
     1141           (output v-curr-sv-date
     1142           ) .
     1143       end.
     1144       if v-curr-sv-date <> ?
     1145       then do:
     1146         run gbl/d-inpday.w
     1147           (input ?
     1148           ,input "Выбор даты"
     1149           ,input v-description
     1150           ,input ""
     1151           ,input-output v-curr-sv-date
     1152           ,output v-ok
     1153           ).
     1154         if v-ok = true
     1155         then do:
     1156           assign
     1157             self :screen-value = string(v-curr-sv-date) .
     1158           .
     1159         end.
     1160       end.
     1161     end.
     1162     return no-apply .
     1163   end.
     1164     define MENU m-ed-date6
     1165       MENU-ITEM m-ed-date6-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1166       MENU-ITEM m-ed-date6-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1167       MENU-ITEM m-ed-date6-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1168       MENU-ITEM m-ed-date6-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1169       .
     1170     if f-date-2 :POPUP-MENU in frame Dialog-Frame = ?
     1171     then do:
     1172       ASSIGN
     1173         f-date-2 :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date6 :HANDLE
     1174         f-date-2 :MENU-MOUSE in frame Dialog-Frame = 3
     1175       .
     1176     end.
     1177     define variable v-label-handle6 as handle no-undo .
     1178     assign
     1179       v-label-handle6 = f-date-2 :side-label-handle in frame Dialog-Frame
     1180     .
     1181     if valid-handle (v-label-handle6)
     1182     then do:
     1183       if v-label-handle6 :tooltip = ""
     1184       or v-label-handle6 :tooltip = ?
     1185       then do:
     1186         assign
     1187           v-label-handle6 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1188         .
     1189       end.
     1190     end.
     1191     ON CHOOSE OF MENU-ITEM m-ed-date6-1 in menu m-ed-date6 DO:
     1192       apply "ctrl-b":U to f-date-2 in frame Dialog-Frame .
     1193     END.
     1194     ON CHOOSE OF MENU-ITEM m-ed-date6-2 in menu m-ed-date6 DO:
     1195       apply "ctrl-d":U to f-date-2 in frame Dialog-Frame .
     1196     END.
     1197     ON CHOOSE OF MENU-ITEM m-ed-date6-3 in menu m-ed-date6 DO:
     1198       apply "ctrl-e":U to f-date-2 in frame Dialog-Frame .
     1199     END.
     1200     ON CHOOSE OF MENU-ITEM m-ed-date6-4 in menu m-ed-date6 DO:
     1201       apply "ctrl-f":U to f-date-2 in frame Dialog-Frame .
     1202     END.
     1203   MAIN-BLOCK:
     1204   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1205      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1206     RUN MYenable.
     1207     WAIT-FOR GO OF FRAME Dialog-Frame.
     1208   END.
     1209   RUN disable_UI.
     1210   PROCEDURE disable_UI :
     1211     HIDE FRAME Dialog-Frame.
     1212   END PROCEDURE.
     1213   PROCEDURE enable_UI :
     1214     DISPLAY f-date-1 l-loc-hour-1 l-loc-min-1 l-loc-sec-1 f-date-2 l-loc-hour-2
     1215             l-loc-min-2 l-loc-sec-2 F-shift-num-1 F-shift-num-2 f-z-count-1
     1216             f-z-count-2 F-chk-num-1 F-chk-num-2 F-delim-11 F-delim-12 F-delim-21
     1217             F-delim-22
     1218         WITH FRAME Dialog-Frame.
     1219     ENABLE B-exit b-quit B-Help RECT-from RECT-to f-date-1 l-loc-hour-1
     1220            l-loc-min-1 l-loc-sec-1 f-date-2 l-loc-hour-2 l-loc-min-2 l-loc-sec-2
     1221            F-shift-num-1 F-shift-num-2 f-z-count-1 f-z-count-2 F-chk-num-1
     1222            F-chk-num-2 F-delim-11 F-delim-12 F-delim-21 F-delim-22
     1223         WITH FRAME Dialog-Frame.
     1224     VIEW FRAME Dialog-Frame.
     1225   END PROCEDURE.
     1226   PROCEDURE MyEnable :
     1227   ASSIGN
     1228   f-date-1 = p-date-1
     1229   f-date-2 = p-date-2
     1230   l-loc-hour-1  = integer(substring(string(p-time-1, "hh:mm:ss":U), 1, 2))
     1231   l-loc-min-1  = integer(substring(string(p-time-1, "hh:mm:ss":U), 4, 2))
     1232   l-loc-sec-1 = integer(substring(string(p-time-1, "hh:mm:ss":U), 7, 2))
     1233   l-loc-hour-2  = integer(substring(string(p-time-2, "hh:mm:ss":U), 1, 2))
     1234   l-loc-min-2  = integer(substring(string(p-time-2, "hh:mm:ss":U), 4, 2))
     1235   l-loc-sec-2 = integer(substring(string(p-time-2, "hh:mm:ss":U), 7, 2))
     1236   f-shift-num-1 = p-shift-num-1
     1237   f-shift-num-2 = p-shift-num-2
     1238   f-Z-count-1 = p-Z-count-1
     1239   f-Z-count-2 = p-Z-count-2
     1240   f-chk-num-1 = p-chk-num-1
     1241   f-chk-num-2 = p-chk-num-2
     1242   FRAME Dialog-Frame:TITLE = ENTRY(1, p-title-label, chr(4))
     1243   f-date-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 1
     1244                                            THEN ENTRY(2, p-title-label, chr(4))
     1245                                            ELSE f-date-1:LABEL IN FRAME Dialog-Frame)
     1246   f-date-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 2
     1247                                           THEN ENTRY(3, p-title-label, chr(4))
     1248                                           ELSE f-date-2:LABEL IN FRAME Dialog-Frame)
     1249   l-loc-hour-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 3
     1250                                               THEN ENTRY(4, p-title-label, chr(4))
     1251                                               ELSE l-loc-hour-1:LABEL IN FRAME Dialog-Frame)
     1252   l-loc-hour-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 4
     1253                                               THEN ENTRY(5, p-title-label, chr(4))
     1254                                               ELSE l-loc-hour-2:LABEL IN FRAME Dialog-Frame)
     1255   f-shift-num-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 5
     1256                                            THEN ENTRY(6, p-title-label, chr(4))
     1257                                            ELSE f-shift-num-1:LABEL IN FRAME Dialog-Frame)
     1258   f-shift-num-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 6
     1259                                           THEN ENTRY(7, p-title-label, chr(4))
     1260                                           ELSE f-shift-num-2:LABEL IN FRAME Dialog-Frame)
     1261   f-Z-count-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 7
     1262                                            THEN ENTRY(8, p-title-label, chr(4))
     1263                                            ELSE f-z-count-1:LABEL IN FRAME Dialog-Frame)
     1264   f-Z-count-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 8
     1265                                           THEN ENTRY(9, p-title-label, chr(4))
     1266                                           ELSE f-z-count-2:LABEL IN FRAME Dialog-Frame)
     1267   f-chk-num-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 9
     1268                                            THEN ENTRY(8, p-title-label, chr(4))
     1269                                            ELSE f-chk-num-1:LABEL IN FRAME Dialog-Frame)
     1270   f-chk-num-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 10
     1271                                           THEN ENTRY(9, p-title-label, chr(4))
     1272                                           ELSE f-chk-num-2:LABEL IN FRAME Dialog-Frame)
     1273   .
     1274   DISPLAY
     1275   f-date-1
     1276   l-loc-hour-1
     1277   l-loc-min-1
     1278   f-delim-11
     1279   f-shift-num-1
     1280   f-z-count-1
     1281   f-chk-num-1
     1282   WITH FRAME Dialog-Frame.
     1283   IF p-mode = 0 OR p-mode = 1 THEN DO:
     1284       DISPLAY
     1285       l-loc-sec-1
     1286       f-delim-12
     1287       WITH FRAME Dialog-Frame.
     1288   END.
     1289   IF p-mode = 0 OR p-mode = 2 THEN DO:
     1290       DISPLAY
     1291       f-date-2
     1292       l-loc-hour-2
     1293       l-loc-min-2
     1294       f-delim-21
     1295       f-shift-num-2
     1296       f-z-count-2
     1297       f-chk-num-2
     1298       WITH FRAME Dialog-Frame.
     1299   END.
     1300   IF p-mode = 0 THEN DO:
     1301       DISPLAY
     1302       l-loc-sec-2
     1303       f-delim-22
     1304       WITH FRAME Dialog-Frame.
     1305   END.
     1306   IF p-mode = 2 OR p-mode = 3 THEN DO:
     1307       HIDE
     1308       l-loc-sec-1
     1309       f-delim-12
     1310       IN FRAME Dialog-Frame.
     1311   END.
     1312   IF p-mode = 1 OR p-mode = 3 THEN DO:
     1313       HIDE
     1314       f-date-2
     1315       l-loc-hour-2
     1316       l-loc-min-2
     1317       f-delim-21
     1318       f-shift-num-2
     1319       f-z-count-2
     1320       f-chk-num-2
     1321       in FRAME Dialog-Frame.
     1322   END.
     1323   IF p-mode = 3 THEN DO:
     1324       HIDE
     1325       l-loc-sec-2
     1326       f-delim-22
     1327       IN FRAME Dialog-Frame.
     1328   END.
     1329   ENABLE
     1330   b-quit
     1331   B-exit
     1332   B-Help
     1333   f-date-1
     1334   l-loc-hour-1
     1335   l-loc-min-1
     1336   l-loc-sec-1 WHEN (p-mode = 0 OR p-mode = 1)
     1337   f-date-2 WHEN (p-mode = 0 OR p-mode = 2)
     1338   l-loc-hour-2 WHEN (p-mode = 0 OR p-mode = 2)
     1339   l-loc-min-2 WHEN (p-mode = 0 OR p-mode = 2)
     1340   l-loc-sec-2 WHEN p-mode = 0
     1341   f-shift-num-2 WHEN (p-mode = 0 OR p-mode = 2)
     1342   f-z-count-2 WHEN (p-mode = 0 OR p-mode = 2)
     1343   f-chk-num-2 WHEN (p-mode = 0 OR p-mode = 2)
     1344   WITH FRAME Dialog-Frame.
     1345   VIEW FRAME Dialog-Frame.
     1346   if p-code = "report" then do:
     1347       f-z-count-1:hidden = true .
     1348       f-z-count-2:hidden = true .
     1349       f-chk-num-1:hidden = true .
     1350       f-chk-num-2:hidden = true .
     1351   end.
     1352   END PROCEDURE.
     1353   PROCEDURE proc-save :
     1354   define variable v-ok as logical no-undo .
     1355   define variable v-mes as character no-undo .
     1356     ASSIGN
     1357     f-date-1 FRAME Dialog-Frame
     1358     l-loc-hour-1
     1359     l-loc-min-1
     1360     p-date-1 = f-date-1
     1361     p-time-1 = l-loc-hour-1 * 3600 + l-loc-min-1 * 60 + l-loc-sec-1
     1362     f-shift-num-1
     1363     f-z-count-1
     1364     f-chk-num-1
     1365     p-z-count-1 = f-z-count-1
     1366     p-shift-num-1 = f-shift-num-1
     1367     p-chk-num-1 = f-chk-num-1
     1368     .
     1369     IF f-date-2:VISIBLE IN FRAME Dialog-Frame THEN DO:
     1370       ASSIGN
     1371       f-date-2
     1372       l-loc-hour-2
     1373       l-loc-min-2
     1374       p-date-2 = f-date-2
     1375       p-time-2 = l-loc-hour-2 * 3600 + l-loc-min-2 * 60 + l-loc-sec-2
     1376       f-shift-num-2
     1377       f-z-count-2
     1378       f-chk-num-2
     1379       p-z-count-2 = f-z-count-2
     1380       p-shift-num-2 = f-shift-num-2
     1381       p-chk-num-2 = f-chk-num-2
     1382       .
     1383     END.
     1384     if  h-callback <> ?
     1385     and valid-handle(h-callback)
     1386     then do:
     1387       if h-callback :get-signature("cb-d-time-validate") <> ""
     1388       then do:
     1389         define variable lok as logical no-undo .
     1390         run cb-d-time-validate in h-callback
     1391           (
     1392             input p-date-1
     1393            ,input p-date-2
     1394            ,input p-time-1
     1395            ,input p-time-2
     1396            ,output v-ok
     1397            ,output v-mes
     1398           ) no-error .
     1399         if error-status :error then do:
     1400           message
     1401             vss-workfile vss-revision vss-description skip
     1402             "Ошибка при вызове процедуры проверки допустимости даты и времени" skip
     1403             "файл" h-callback :file-name skip
     1404             "процедура" "cb-d-time-validate" skip
     1405             error-status :get-message(1) skip
     1406             return-value skip
     1407             view-as alert-box error .
     1408           return no-apply .
     1409         end.
     1410         if v-ok <> true then do:
     1411           return no-apply .
     1412         end.
     1413       end.
     1414       else do:
     1415         message
     1416           vss-workfile vss-revision vss-description skip
     1417           "Программе был передан указатель на процедуру для проверки даты-времени" skip
     1418           "В указанной процедуре отсутствует внутренняя процедура cb-d-time-validate " skip
     1419           "файл" h-callback :file-name skip
     1420           view-as alert-box error .
     1421         return no-apply .
     1422       end.
     1423       if not v-ok then do:
     1424         message
     1425         v-mes
     1426         view-as alert-box error .
     1427         return no-apply.
     1428       end.
     1429       else do:
     1430        p-ok = YES.
     1431       end.
     1432     end.
     1433     p-ok = yes.
     1434   END PROCEDURE.
