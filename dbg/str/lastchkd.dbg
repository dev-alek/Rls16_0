      650   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   on help of frame Dialog-Frame
      652   do:
      653     run gbl/app_help.p
      654       (input this-procedure :file-name
      655       ,input ''
      656       ,input ?
      657       ) no-error.
      658     if error-status :error then do:
      659       message
      660         "Ошибка при вызове помощи"
      661         error-status :get-message(1)
      662         view-as alert-box .
      663     end.
      664   end.
      665   run minbtn-set in this-procedure .
      666   on choose of b-help in frame Dialog-Frame
      667   do:
      668     apply "help":u to frame Dialog-Frame .
      669   end.
      670   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   procedure minbtn-set :
      672       do
      673           on error undo, return error return-value
      674           :
      675           define variable ii              as integer       no-undo .
      676           define variable fh              as widget-handle no-undo .
      677           define variable hh              as widget-handle no-undo .
      678           define variable v-h             as handle        extent 4 no-undo .
      679           define variable v-name-button   as character     no-undo .
      680           define variable v-help-old-x    as decimal       no-undo .
      681           define variable v-help-old-y    as decimal       no-undo .
      682           define variable v-help-old-size as decimal       no-undo .
      683           define variable v-frame-width   as decimal       no-undo .
      684           define variable jj              as integer       no-undo .
      685           do
      686               on error undo, return error
      687               :
      688               assign
      689                   v-frame-width = frame Dialog-Frame:width - 0.3
      690                   fh            = frame Dialog-Frame:first-child
      691                   hh            = fh:first-child
      692                   ii            = 1
      693                   .
      694               do while valid-handle(hh):
      695                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      696                   do:
      697                       case lc(hh:name) :
      698                           when "b-help" then
      699                               do:
      700                                   hh:load-image-up("cmp/b-help.bmp":u) .
      701                                   hh:load-image-down("cmp/b-help.bmp":u) .
      702                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      703                                   hh:TOOLTIP = "Помощь" .
      704                                   v-help-old-x = hh:column .
      705                                   v-help-old-y = hh:row    .
      706                                   v-help-old-size = hh:width .
      707                                   hh:width-chars = 2.5 .
      708                               end.
      709                           when "b-print" then
      710                               do:
      711                                   hh:load-image("cmp/b-print.bmp":u) .
      712                                   hh:TOOLTIP = "Печать" .
      713                                   v-h[ii] = hh:handle .
      714                                   ii = ii + 1 .
      715                                   hh:width-chars = 3 .
      716                               end.
      717                           when "b-history" or
      718                           when "b-hist" then
      719                               do:
      720                                   hh:load-image("cmp/b-hist.bmp":u) .
      721                                   hh:TOOLTIP = "История" .
      722                                   v-h[ii] = hh:handle .
      723                                   ii = ii + 1 .
      724                                   hh:width-chars = 3 .
      725                               end.
      726                           when "b-sch" then
      727                               do:
      728                                   hh:load-image("cmp/b-sch.bmp":u) .
      729                                   hh:TOOLTIP = "Установка Фильтра" .
      730                                   v-h[ii] = hh:handle .
      731                                   ii = ii + 1 .
      732                                   hh:width-chars = 3 .
      733                               end.
      734                           when "b-hist-user" then
      735                               do:
      736                                   hh:load-image("cmp/b-hist.bmp":u) .
      737                                   hh:TOOLTIP = "История пользователя" .
      738                                   ii = ii + 1 .
      739                               end.
      740                       end case.
      741                   end.
      742                   hh = hh:next-sibling.
      743               end.
      744               b-help:column = v-frame-width - b-help:width-chars.
      745               jj = 0.
      746               repeat ii = 4 to 1 by -1 :
      747                   if valid-handle (v-h[ii] ) then
      748                   do:
      749                       jj  = jj + 1 .
      750                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      751                       v-h[ii]:row    = v-help-old-y .
      752                   end.
      753               end.
      754           end.
      755       end.
      756   end procedure.
      757   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   on ' ' of f-date-1 in frame Dialog-Frame
      759   do:
      760     if (can-query (self, "sensitive")
      761        and
      762        self :sensitive = true
      763        )
      764     or (can-query (self, "read-only")
      765        and
      766        self :read-only = false
      767        )
      768     then do:
      769       assign
      770         self :screen-value = ?
      771       .
      772     end.
      773     return no-apply.
      774   end.
      775   on delete-character of f-date-1 in frame Dialog-Frame
      776   do:
      777     if (can-query (self, "sensitive")
      778        and
      779        self :sensitive = true
      780        )
      781     or (can-query (self, "read-only")
      782        and
      783        self :read-only = false
      784        )
      785     then do:
      786       assign
      787         self :screen-value = ?
      788       .
      789     end.
      790     return no-apply.
      791   end.
      792   on ctrl-d of f-date-1 in frame Dialog-Frame
      793   do:
      794     define variable v-curr-sv-date as date no-undo .
      795     if (can-query (self, "sensitive")
      796        and
      797        self :sensitive = true
      798        )
      799     or (can-query (self, "read-only")
      800        and
      801        self :read-only = false
      802        )
      803     then do:
      804       if self :handle <> focus :handle
      805       then do:
      806         apply "entry":u to self .
      807       end.
      808       run gbl/getcurdt.p
      809         (output v-curr-sv-date
      810         ) .
      811       assign
      812         self :screen-value = string(v-curr-sv-date) .
      813       .
      814     end.
      815     return no-apply.
      816   end.
      817   on ctrl-b of f-date-1 in frame Dialog-Frame
      818   do:
      819     if (can-query (self, "sensitive")
      820        and
      821        self :sensitive = true
      822        )
      823     or (can-query (self, "read-only")
      824        and
      825        self :read-only = false
      826        )
      827     then do:
      828       if self :handle <> focus :handle
      829       then do:
      830         apply "entry":u to self .
      831       end.
      832       define variable v-curr-sv-date as date no-undo .
      833       define variable v-new-sv-date  as date no-undo .
      834       assign
      835         v-curr-sv-date = date(self :screen-value) no-error
      836       .
      837       if v-curr-sv-date = ?
      838       then do:
      839         run gbl/getcurdt.p
      840           (output v-curr-sv-date
      841           ) .
      842       end.
      843       if v-curr-sv-date <> ?
      844       then do:
      845         assign
      846           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      847         .
      848         assign
      849           self :screen-value = string(v-new-sv-date) .
      850         .
      851       end.
      852     end.
      853     return no-apply .
      854   end.
      855   on ctrl-e of f-date-1 in frame Dialog-Frame
      856   do:
      857     if (can-query (self, "sensitive")
      858        and
      859        self :sensitive = true
      860        )
      861     or (can-query (self, "read-only")
      862        and
      863        self :read-only = false
      864        )
      865     then do:
      866       if self :handle <> focus :handle
      867       then do:
      868         apply "entry":u to self .
      869       end.
      870       define variable v-curr-sv-date as date no-undo .
      871       define variable v-new-sv-date  as date no-undo .
      872       assign
      873         v-curr-sv-date = date(self :screen-value) no-error
      874       .
      875       if v-curr-sv-date = ?
      876       then do:
      877         run gbl/getcurdt.p
      878           (output v-curr-sv-date
      879           ) .
      880       end.
      881       if v-curr-sv-date <> ?
      882       then do:
      883         run gbl/lastdate.p
      884           (input  v-curr-sv-date
      885           ,output v-new-sv-date
      886           ).
      887         assign
      888           self :screen-value = string(v-new-sv-date) .
      889         .
      890       end.
      891     end.
      892     return no-apply .
      893   end.
      894   on ctrl-f of f-date-1 in frame Dialog-Frame
      895   do:
      896     if (can-query (self, "sensitive")
      897        and
      898        self :sensitive = true
      899        )
      900     or (can-query (self, "read-only")
      901        and
      902        self :read-only = false
      903        )
      904     then do:
      905       if self :handle <> focus :handle
      906       then do:
      907         apply "entry":u to self .
      908       end.
      909       define variable v-ok            as logical   no-undo .
      910       define variable v-curr-sv-date  as date      no-undo .
      911       define variable v-description   as character no-undo .
      912       assign
      913         v-curr-sv-date = date(self :screen-value) no-error
      914       .
      915       if v-curr-sv-date = ?
      916       then do:
      917         run gbl/getcurdt.p
      918           (output v-curr-sv-date
      919           ) .
      920       end.
      921       if v-curr-sv-date <> ?
      922       then do:
      923         run gbl/d-inpday.w
      924           (input ?
      925           ,input "Выбор даты"
      926           ,input v-description
      927           ,input ""
      928           ,input-output v-curr-sv-date
      929           ,output v-ok
      930           ).
      931         if v-ok = true
      932         then do:
      933           assign
      934             self :screen-value = string(v-curr-sv-date) .
      935           .
      936         end.
      937       end.
      938     end.
      939     return no-apply .
      940   end.
      941     define MENU m-ed-date4
      942       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      943       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      944       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      945       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      946       .
