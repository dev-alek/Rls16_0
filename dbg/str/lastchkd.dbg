      948     then do:
      949       ASSIGN
      950         f-date-1 :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      951         f-date-1 :MENU-MOUSE in frame Dialog-Frame = 3
      952       .
      953     end.
      954     define variable v-label-handle4 as handle no-undo .
      955     assign
      956       v-label-handle4 = f-date-1 :side-label-handle in frame Dialog-Frame
      957     .
      958     if valid-handle (v-label-handle4)
      959     then do:
      960       if v-label-handle4 :tooltip = ""
      961       or v-label-handle4 :tooltip = ?
      962       then do:
      963         assign
      964           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      965         .
      966       end.
      967     end.
      968     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      969       apply "ctrl-b":U to f-date-1 in frame Dialog-Frame .
      970     END.
      971     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      972       apply "ctrl-d":U to f-date-1 in frame Dialog-Frame .
      973     END.
      974     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      975       apply "ctrl-e":U to f-date-1 in frame Dialog-Frame .
      976     END.
      977     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      978       apply "ctrl-f":U to f-date-1 in frame Dialog-Frame .
      979     END.
