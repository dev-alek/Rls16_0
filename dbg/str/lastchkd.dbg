      459   DEFINE FRAME Dialog-Frame
      460        B-exit AT ROW 1 COL 1
      461        b-quit AT ROW 1 COL 11
      462        B-Help AT ROW 1 COL 54.88
      463        f-date-1 AT ROW 3 COL 6 COLON-ALIGNED
      464        l-loc-hour-1 AT ROW 3 COL 30.5 COLON-ALIGNED
      465        l-loc-min-1 AT ROW 3 COL 35.5 COLON-ALIGNED NO-LABEL
      466        l-loc-sec-1 AT ROW 3 COL 40.5 COLON-ALIGNED NO-LABEL
      467        f-date-2 AT ROW 3 COL 54 COLON-ALIGNED
      468        l-loc-hour-2 AT ROW 3 COL 78.5 COLON-ALIGNED
      469        l-loc-min-2 AT ROW 3 COL 83.5 COLON-ALIGNED NO-LABEL
      470        l-loc-sec-2 AT ROW 3 COL 88.5 COLON-ALIGNED NO-LABEL
      471        F-shift-num-1 AT ROW 4.5 COL 14 COLON-ALIGNED HELP
      472             ""
      473             LABEL "№ смены"
      474        F-shift-num-2 AT ROW 4.5 COL 62 COLON-ALIGNED HELP
      475             ""
      476             LABEL "№ смены"
      477        f-z-count-1 AT ROW 6 COL 14 COLON-ALIGNED
      478        f-z-count-2 AT ROW 6 COL 62 COLON-ALIGNED
      479        F-chk-num-1 AT ROW 7.5 COL 14 COLON-ALIGNED HELP
      480             ""
      481             LABEL "Номер чека" FORMAT "->>>>>>>>>>9"
      482        F-chk-num-2 AT ROW 7.5 COL 62 COLON-ALIGNED HELP
      483             ""
      484             LABEL "Номер чека" FORMAT "->>>>>>>>>>9"
      485        F-delim-11 AT ROW 3.17 COL 34 COLON-ALIGNED NO-LABEL
      486        F-delim-12 AT ROW 3.17 COL 39 COLON-ALIGNED NO-LABEL
      487        F-delim-21 AT ROW 3.17 COL 82 COLON-ALIGNED NO-LABEL
      488        F-delim-22 AT ROW 3.17 COL 87 COLON-ALIGNED NO-LABEL
      489        RECT-from AT ROW 2.25 COL 1
      490        RECT-to AT ROW 2.25 COL 48.5
      491        SPACE(0.49) SKIP(0.03)
      492       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      493            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      494            TITLE "Параметры последнего чека"
      495            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      496   ASSIGN
      497          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      498          FRAME Dialog-Frame:HIDDEN           = TRUE.
      499   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      500   DO:
      501     APPLY "END-ERROR":U TO SELF.
      502   END.
      503   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      504   DO:
      505     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      506     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      507   END.
      508   ON CURSOR-DOWN OF l-loc-hour-1 IN FRAME Dialog-Frame
      509   DO:
      510     assign  frame Dialog-Frame l-loc-hour-1 .
      511     l-loc-hour-1 = l-loc-hour-1 -  1.
      512     if l-loc-hour-1 < 0 then return no-apply.
      513     display l-loc-hour-1 with frame Dialog-Frame.
      514   END.
      515   ON CURSOR-UP OF l-loc-hour-1 IN FRAME Dialog-Frame
      516   DO:
      517     assign  frame Dialog-Frame l-loc-hour-1 .
      518     l-loc-hour-1 = l-loc-hour-1 +  1.
      519     if l-loc-hour-1 > 24 then return no-apply.
      520     display l-loc-hour-1 with frame Dialog-Frame.
      521   END.
      522   ON LEAVE OF l-loc-hour-1 IN FRAME Dialog-Frame
      523   DO:
      524       assign frame Dialog-Frame l-loc-hour-1 .
      525      if l-loc-hour-1 > 24 then do:
      526      message "Часы должны быть   до 24 ! " .
      527      return no-apply.
      528      end.
      529       if l-loc-hour-1 < 0 then do:
      530      message "Часы должны быть  от 0 до 24 ! " .
      531      return no-apply.
      532      end.
      533   END.
