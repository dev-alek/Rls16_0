      433   DEFINE VARIABLE l-loc-hour-1 AS INTEGER FORMAT "99":U INITIAL 0
      434        LABEL "Время"
      435        VIEW-AS FILL-IN
      436        SIZE 3.25 BY 1 TOOLTIP "Стрелка вверх, вниз - изменение часа" NO-UNDO.
      437   DEFINE VARIABLE l-loc-hour-2 AS INTEGER FORMAT "99":U INITIAL 0
