      425   DEFINE VARIABLE f-z-count-1 AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      426        LABEL "№ Z-отчета"
      427        VIEW-AS FILL-IN
      428        SIZE 11.5 BY 1 NO-UNDO.
      429   DEFINE VARIABLE f-z-count-2 AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
