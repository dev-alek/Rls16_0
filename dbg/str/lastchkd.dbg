      439        VIEW-AS FILL-IN
      440        SIZE 3.25 BY 1 TOOLTIP "Стрелка вверх, вниз - изменение часа" NO-UNDO.
      441   DEFINE VARIABLE l-loc-min-1 AS INTEGER FORMAT "99":U INITIAL 0
      442        VIEW-AS FILL-IN
      443        SIZE 3.25 BY 1 TOOLTIP "Стрелка вверх, вниз - изменение минут" NO-UNDO.
