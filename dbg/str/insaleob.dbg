      157   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   define variable v-waitfram-action01         as character   no-undo .
      159   define variable v-waitfram-action02         as character   no-undo .
      160   define variable v-waitfram-action03         as character   no-undo .
      161   define variable mWaitFramTextBeg            as character   no-undo.
      162   define variable mWaitFramTextEnd            as character   no-undo.
      163   define variable mWaitFramView               as logical     no-undo.
      164   define variable mWaitProcEvent              as logical     no-undo init yes.
      165   define variable mWaitFramInterval           as integer     no-undo init 1 .
      166   define variable mWaitFramStop               as logical     no-undo.
      167   define variable mWaitFramStopUser           as logical     no-undo.
      168   define variable mWaitFramStopTimeOut        as logical     no-undo.
      169   define variable mWaitFramStartProc          as datetime-tz no-undo.
      170   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      171   define button B-WaitFramStop auto-end-key
      172        label "Стоп"
      173        size 10 by 1 tooltip "Остоновить процесс".
      174   define button B-viewProcInfo
      175        label "Информация"
      176        size 15 by 1 tooltip "Информация о процесс".
      177   define frame waitfram
      178     v-waitfram-action01 format "x(72)" no-label skip
      179     v-waitfram-action02 format "x(72)" no-label skip
      180     v-waitfram-action03 format "x(72)" no-label skip
      181     B-viewProcInfo
      182     B-WaitFramStop at row 4 col 30
      183     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      184     .
      185   define new global shared variable mBatchMode as logical no-undo init ?.
      186   define variable mFramBachModHandle as handle no-undo.
      187   mFramBachModHandle = frame waitfram:handle.
      188   define variable mFameOldVis as logical no-undo.
      189   define variable mVisCUrentVin as logical no-undo.
      190   if session:batch-mode
      191   then
      192      mBatchMode = yes.
      193   if mBatchMode = ? then do:
      194     mVisCUrentVin = current-window:visible.
      195     mFameOldVis = mFramBachModHandle:visible.
      196     mFramBachModHandle:visible  = yes.
      197     mBatchMode = mFramBachModHandle:visible ne yes.
      198     mFramBachModHandle:visible = mFameOldVis.
      199     current-window:visible = mVisCUrentVin.
      200   end.
      201    if  log-manager:logfile-name ne ?
      202     then DO:
      203         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      204         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      205         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      206     end.
      207   on choose of B-WaitFramStop in frame waitfram
      208   do:
      209     mWaitFramStop = yes.
      210     mWaitFramStopUser = yes.
      211   end.
      212   function waitfram-check-timeout returns logical():
      213      define variable vtime as int64 no-undo.
      214      if mWaitFramStopTimeOut
      215      then
      216         return yes.
      217      vtime = ( now - mWaitFramStartProc ) / 1000 .
      218      if     mWaitFramTimeOut ne ?
      219         and mWaitFramTimeOut ne 0
      220         and mWaitFramTimeOut lt vtime
      221      then do:
      222         mWaitFramStopTimeOut = yes.
      223      end.
      224      return mWaitFramStopTimeOut.
      225   end.
      226   procedure waitfram-hide :
      227     if not session:batch-mode
      228     then do
      229     on error undo, return error return-value
      230     :
      231       pause 0 before-hide .
      232       if not mBatchMode then
      233         hide frame waitfram .
      234     if     not mWaitFramView
      235        and mWaitProcEvent
      236     then
      237       process events .
      238     end.
      239   end procedure.
      240   procedure waitfram-show :
      241     define input  parameter p-message as character no-undo .
      242     define variable v-left-margin as integer   no-undo .
      243     if not session:batch-mode
      244     then do
      245     on error undo, return error return-value
      246     :
      247       if length(p-message) <= 70 then do:
      248         assign
      249           v-left-margin = integer((70 - length(p-message)) / 2)
      250         .
      251         assign
      252           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      253         .
      254         assign
      255           v-waitfram-action01 = " "
      256           v-waitfram-action02 = " "
      257                                    + fill(" ", v-left-margin)
      258                                    + p-message
      259           v-waitfram-action03 = " "
      260         .
      261       end.
      262       else do:
      263         define variable vRindex1 as integer no-undo.
      264         define variable vRindex2 as integer no-undo.
      265         vRindex1 = r-index(p-message," ",70).
      266         if vRindex1 = 0
      267         then
      268            vRindex1 = 70.
      269         if length(p-message)  <= vRindex1 + 70 then do:
      270           assign
      271             v-waitfram-action01 = " "
      272             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      273             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      274           .
      275         end.
      276         else do:
      277           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      278           if vRindex2 <= vRindex1
      279           then
      280              vRindex2 = vRindex1 + 70.
      281           assign
      282             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      283             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      284             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      285           .
      286         end.
      287       end.
      288       B-viewProcInfo:visible   in frame waitfram = no.
      289       B-viewProcInfo:sensitive in frame waitfram = no.
      290       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      291       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      292       if  (   mWaitFramView
      293          or  mWaitProcEvent)
      294          and not mBatchMode
      295       then
      296          display
      297             v-waitfram-action01 skip
      298             v-waitfram-action02 skip
      299             v-waitfram-action03 skip
      300          with frame waitfram .
      301       if     mWaitFramView
      302          then do:
      303             if     mWaitFramInterval ne ?
      304                and not mBatchMode
      305             then
      306                wait-for go of frame waitfram pause mWaitFramInterval.
      307          end.
      308          else
      309             if     mWaitProcEvent
      310                and not mBatchMode
      311             then
      312                process events .
      313     end.
      314   end procedure.
      315      procedure waitfram-show-this:
      316         define input  parameter iInterval as int64 no-undo.
      317         define variable vtime as int64 no-undo.
      318         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      319         mWaitFramInterval = iInterval.
      320         run waitfram-show (substitute("&1&2 &3&4" ,
      321                                       mWaitFramTextBeg ,
      322                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      323                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      324                                       mWaitFramTextEnd
      325                                      )
      326                           ).
      327      end.
      328      procedure WaitFramRunPause:
      329         define input  parameter iInterval as dec no-undo.
      330         define variable vStart  as datetime-tz no-undo.
      331         define variable vend    as datetime-tz no-undo.
      332         define variable vint as int64 no-undo.
      333         define variable vOk as logical no-undo.
      334         vStart = now.
      335         vend   = vStart.
      336         publish "WaitFramPause" (iInterval,output vOk).
      337         vend   =  now.
      338         vint = vend - vStart.
      339         vint = iInterval - vint / 1000.
      340         if     not mWaitFramStop
      341            and (   vint > 0
      342                 or (    not vOk
      343                     and iInterval eq ?
      344                     )
      345                 )
      346         then
      347            run waitfram-show-this (iInterval).
      348         vend   =  now.
      349         vint = vend - vStart.
      350         vint = iInterval - vint / 1000.
      351         if     not mWaitFramStop
      352            and vint > 0
      353         then do:
      354            run gbl/pause.p (vint * 1000).
      355         end.
      356         if iInterval ne ?
      357         then
      358            publish "WaitFramStop".
      359         waitfram-check-timeout().
      360      end.
      361      procedure WaitFramWaitFor:
      362         define input  parameter iInterval as dec no-undo.
      363         assign
      364            mWaitFramStartProc   = now
      365            mWaitFramStopUser    = no
      366            mWaitFramStopTimeOut = no
      367         .
      368         block-wait:
      369         do while not mWaitFramStop:
      370            run WaitFramRunPause (iInterval).
      371            if  waitfram-check-timeout()
      372            then do:
      373               leave block-wait.
      374            end.
      375         end.
      376         run waitfram-hide.
      377      end.
      378   procedure waitfram-join :
      379     define input  parameter p-line-1  as character no-undo .
      380     define input  parameter p-line-2  as character no-undo .
      381     define input  parameter p-line-3  as character no-undo .
      382     define output parameter p-message as character no-undo .
      383     do
      384     on error undo, return error return-value
      385     :
      386       assign
      387         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      388                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      389                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      390       .
      391     end.
      392   end procedure.
      393   function waitfram-join-function returns character
      394     (input p-line-1 as character
      395     ,input p-line-2 as character
      396     ,input p-line-3 as character
      397     ).
      398     define variable v-message as character no-undo .
      399     run waitfram-join in this-procedure
      400       (input  p-line-1
      401       ,input  p-line-2
      402       ,input  p-line-3
      403       ,output v-message
      404       ) .
      405     return v-message .
      406   end function .
      407   define variable ii as integer no-undo.
      408   define variable kk as integer no-undo.
      409   define variable glog as logical no-undo .
      410   define variable lns-cnt as integer no-undo .
      411   define variable line-rec as recid no-undo .
      412   define variable v-doc-prt as logical no-undo .
      413   define variable v-is-petrolium as logical no-undo .
      414   define variable v-is-pieces as logical no-undo .
      415   define buffer buf_shop for ub.shop.
      416   define buffer buf_store for ub.store.
      417   define buffer buf_gds-prt for ub.gds-prt .
      418   define buffer buf_units for ub.units.
      419   define buffer buf_goods for ub.goods.
      420   define buffer buf_gds-obj for ub.gds-obj.
      421   glog = no.
      422   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Заполняется список..." ).
      423   fill-list:
      424   do
      425   on stop undo fill-list, return no-apply
      426   on error undo fill-list, return no-apply:
      427     FOR EACH buf_gds-obj where
      428             buf_gds-obj.obj-type = p-obj-type
      429         AND buf_gds-obj.obj-code = p-obj-code
      430         AND buf_gds-obj.insalepr = integer('1':U),
      431         FIRST buf_goods where
      432               buf_goods.artic     = buf_gds-obj.artic
      433           AND buf_goods.prod-type = buf_gds-obj.prod-type
      434           AND buf_goods.prod-code = buf_gds-obj.prod-code no-lock
      435         on stop undo fill-list, return no-apply
      436         on error undo fill-list, return no-apply:
      437   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   find gds-list
      439     where gds-list.prod-type = buf_goods.prod-type
      440       and gds-list.prod-code = buf_goods.prod-code
      441       and gds-list.artic     = buf_goods.artic
      442     no-error .
      443   if available gds-list then do:
      444     assign
      445       gds-list.to-del = no
      446     .
      447   end.
      448   else do:
      449     define variable v-last5 as integer no-undo .
      450     find last gds-list use-index oi no-error.
      451     if available gds-list then do:
      452       v-last5 = gds-list.order-num .
      453     end.
      454     else do:
      455       v-last5 = 0 .
      456     end.
      457     create gds-list .
      458     buffer-copy buf_goods to gds-list
      459     assign
      460       gds-list.to-del = no
      461       gds-list.order-num = v-last5 + 1
      462     .
      463     assign
      464       lns-cnt = lns-cnt + 1
      465       line-rec = recid (gds-list)
      466     .
      467   end.
      468   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   find del-list
      470     where del-list.prod-type = buf_goods.prod-type
      471       and del-list.prod-code = buf_goods.prod-code
      472       and del-list.artic     = buf_goods.artic
      473     no-error .
      474   if available del-list then do:
      475     assign
      476       del-list.to-del = no
      477     .
      478   end.
      479   else do:
      480     define variable v-last6 as integer no-undo .
      481     find last del-list use-index oi no-error.
      482     if available del-list then do:
      483       v-last6 = del-list.order-num .
      484     end.
      485     else do:
      486       v-last6 = 0 .
      487     end.
      488     create del-list .
      489     buffer-copy buf_goods to del-list
      490     assign
      491       del-list.to-del = no
      492       del-list.order-num = v-last6 + 1
      493     .
      494   end.
      495       assign
      496       gds-list.to-del = yes
      497       del-list.to-del = yes
      498       .
      499     END.
      500   end.
      501   run waitfram-hide in this-procedure .
      502   run str/gds-list.w ( input parparentproc
      503                      , input p-host-code
      504                      , input p-obj-type
      505                      , input p-obj-code).
      506   glog = no.
      507   message "Установить признак прихода по продажной цене" skip
      508   "на текущем объекте для всех товаров списка?"
      509   view-as alert-box QUESTION buttons YES-NO
      510   update glog.
      511   if NOT glog then return.
      512   run waitfram-show in this-procedure ( input ("ЖДИТЕ.  Устанавливается признак прихода по продажной цене на текущем объекте по списку товаров..")).
      513   _del-list:
      514   FOR EACH del-list :
      515     if NOT can-find(first gds-list where
      516                         gds-list.artic = del-list.artic
      517                     AND gds-list.prod-type = del-list.prod-type
      518                     AND gds-list.prod-code = del-list.prod-code ) then do:
      519       ii = ii + 1.
      520       if ii modulo 100 = 0 then do:
      521         run waitfram-show in this-procedure ("ЖДИТЕ.  Обработано строк списка : " + string (ii)).
      522       end.
      523   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   do:
      525     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      526       (input  g#db-num
      527       ,input  g#userid
      528       ,input  0
      529       ,input  'actn_reference_insalepr':U
      530       ,input  'object':U
      531       ,input  p-host-code
      532       ,input  p-obj-type
      533       ,input  p-obj-code
      534       ,input  0
      535       ,input  del-list.grp-code
      536       ,input  0
      537       ,input  false
      538       ,output glog
      539       )  .
      540   end.
      541       if glog then do :
      542   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      544     (input  p-obj-type
      545     ,input  p-obj-code
      546     ,input  del-list.artic
      547     ,input  del-list.prod-type
      548     ,input  del-list.prod-code
      549     ,input  'insalepr=false'
      550     ,output glog
      551     ) no-error .
      552         if error-status:error then do:
      553           delete del-list.
      554           undo, next _del-list.
      555         end.
      556         kk = kk + 1.
      557       end.
      558     end.
      559     delete del-list.
      560   END.
      561   _assign-list:
      562   FOR EACH gds-list where
      563           gds-list.to-del = no no-lock
      564   on stop undo _assign-list, return no-apply
      565   on error undo _assign-list, return no-apply:
      566     ii = ii + 1.
      567     if ii modulo 100 = 0 then
      568     run waitfram-show in this-procedure ("ЖДИТЕ.  Обработано строк списка : " + string (ii)).
      569   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   do:
      571     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      572       (input  g#db-num
      573       ,input  g#userid
      574       ,input  0
      575       ,input  'actn_reference_insalepr':U
      576       ,input  'object':U
      577       ,input  p-host-code
      578       ,input  p-obj-type
      579       ,input  p-obj-code
      580       ,input  0
      581       ,input  gds-list.grp-code
      582       ,input  0
      583       ,input  false
      584       ,output glog
      585       )  .
      586   end.
      587     if glog then do :
      588   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      590     (input  p-obj-type
      591     ,input  p-obj-code
      592     ,input  gds-list.artic
      593     ,input  gds-list.prod-type
      594     ,input  gds-list.prod-code
      595     ,input  'insalepr=true'
      596     ,output glog
      597     ) no-error .
      598       if error-status:error then do:
      599         delete gds-list.
      600         undo, next _assign-list.
      601       end.
      602       run str/gdsbccr.p (
      603                           input  p-obj-type
      604                           ,input  p-obj-code
      605                           ,input gds-list.artic
      606                           ,input gds-list.prod-type
      607                           ,input gds-list.prod-code) no-error.
      608       if error-status:error then do:
      609         message
      610         error-status:get-message(1) view-as alert-box.
      611         delete gds-list.
      612         undo, next _assign-list.
      613       end.
      614       delete gds-list.
      615       kk = kk + 1.
      616     end.
      617   END.
      618   if ii = kk then do:
      619     message
      620     "Признак прихода по продажной цене на текущем объекте" skip
      621     "                 по списку товаров установлен"
      622     view-as alert-box.
      623   end.
      624   else do:
      625     message
      626     substitute("Из &1 строк списка признак прихода по продажной цене на текущем объекте&2" +
      627                "                     удалось установить по &3 товарам"
      628               , ii
      629               , chr(10)
      630               , kk)
      631     view-as alert-box.
      632   end.
      633   run waitfram-hide in this-procedure .
