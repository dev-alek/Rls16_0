        1   define variable vss-revision    as character no-undo init "$Revision$":u .
        2   define variable vss-author      as character no-undo init "$Author$":u .
        3   define variable vss-date        as character no-undo init "$Date$":u .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        5   define variable vss-archive     as character no-undo init "$Archive$":u .
        6   define variable vss-description as character no-undo init "$Дополнительная информация договора":U.
        7   DEFINE INPUT  PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        8   DEFINE INPUT  PARAMETER parBackHandle  AS WIDGET-HANDLE NO-UNDO.
        9   DEFINE INPUT  PARAMETER p-Ref-mode     AS CHARACTER  NO-UNDO.
       10   DEFINE INPUT  PARAMETER p-Doc-type     AS CHARACTER  NO-UNDO.
       11   DEFINE INPUT  PARAMETER iRid           AS RECID      NO-UNDO.
       12   DEFINE OUTPUT PARAMETER cError         AS CHARACTER  NO-UNDO INITIAL "".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
      118   FUNCTION Get-Contract-Attr RETURN CHARACTER(
      119            INPUT iHost-Code AS INTEGER,
      120            INPUT iContract-Code  AS INTEGER,
      121            INPUT cAttr-code      AS CHARACTER):
      122      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
      123      FIND FIRST buf_Contract-Attr WHERE
      124                 buf_Contract-Attr.Host-code     = iHost-Code
      125             AND buf_Contract-Attr.Contract-code = iContract-Code
      126             AND buf_Contract-Attr.Attr-code     = cAttr-code
      127           NO-LOCK NO-ERROR.
      128      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
      129   END FUNCTION.
      130   PROCEDURE Modify-Contract-Attr:
      131      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
      132      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
      133      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
      134      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
      135      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
      136      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
      137      Tran:
      138      DO TRANSACTION
      139         ON ENDKEY UNDO Tran, RETRY Tran
      140         ON ERROR  UNDO Tran, RETRY Tran
      141         ON QUIT   UNDO Tran, RETRY Tran
      142         ON STOP   UNDO Tran, RETRY Tran:
      143         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      144         FIND FIRST buf_Contract-Attr WHERE
      145                    buf_Contract-Attr.Host-Code      = iHost-Code
      146                AND buf_Contract-Attr.Contract-Code  = iContract-Code
      147                AND buf_Contract-Attr.Attr-code      = cAttr-code
      148              NO-LOCK NO-ERROR.
      149         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
      150            CREATE buf_Contract-Attr NO-ERROR.
      151            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      152         END. ELSE DO:
      153            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
      154            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      155         END.
      156         ASSIGN
      157            buf_Contract-Attr.Host-Code      = iHost-Code
      158            buf_Contract-Attr.Contract-Code  = iContract-Code
      159            buf_Contract-Attr.Attr-code      = cAttr-code
      160            buf_Contract-Attr.Attr-value     = cAttr-value
      161            NO-ERROR.
      162         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      163         RELEASE buf_Contract-Attr NO-ERROR.
      164         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      165      END.
      166      RETURN.
      167   END PROCEDURE.
      168   PROCEDURE Create-Contract-Attr:
      169      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
      170      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
      171      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
      172      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
      173      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
      174      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
      175      Tran:
      176      DO TRANSACTION
      177         ON ENDKEY UNDO Tran, RETRY Tran
      178         ON ERROR  UNDO Tran, RETRY Tran
      179         ON QUIT   UNDO Tran, RETRY Tran
      180         ON STOP   UNDO Tran, RETRY Tran:
      181         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
      182         CREATE buf_Contract-Attr NO-ERROR.
      183         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      184         ASSIGN
      185            buf_Contract-Attr.Host-Code      = iHost-Code
      186            buf_Contract-Attr.Contract-Code  = iContract-Code
      187            buf_Contract-Attr.Attr-code      = cAttr-code
      188            buf_Contract-Attr.Attr-value     = cAttr-value
      189            NO-ERROR.
      190         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      191         RELEASE buf_Contract-Attr NO-ERROR.
      192         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
      193      END.
      194      RETURN.
      195   END PROCEDURE.
      196   DEFINE BUFFER buf_Contract FOR ub.contract.
      197   DEFINE BUTTON b-Exit
      198        LABEL "&Отмена"
      199        SIZE 11.5 BY 1.13
      200        BGCOLOR 8 .
      201   DEFINE BUTTON b-Ok
      202        LABEL "&Ввод"
      203        SIZE 12.5 BY 1.13
      204        BGCOLOR 8 .
      205   DEFINE VARIABLE v-EdUvd AS CHARACTER
      206        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      207        SIZE 83 BY 12.5 NO-UNDO.
      208   DEFINE FRAME Dialog-Frame
      209        b-Ok AT ROW 1 COL 1
      210        b-Exit AT ROW 1 COL 13.5
      211        v-EdUvd AT ROW 2.67 COL 2.5 NO-LABEL WIDGET-ID 16
      212        SPACE(1.12) SKIP(0.32)
      213       WITH VIEW-AS DIALOG-BOX
      214            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      215            TITLE "Дополнительная информация" WIDGET-ID 100.
      216   ASSIGN
      217          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      218          FRAME Dialog-Frame:HIDDEN           = TRUE.
      219   ASSIGN
      220          v-EdUvd:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      221   ON ENTRY OF FRAME Dialog-Frame
      222   DO:
      223      IF p-Ref-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
      224         ASSIGN
      225             b-Exit:HIDDEN = TRUE
      226             b-Ok:LABEL     = "&Выход"
      227             .
      228      END.
      229   END.
      230   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      231   DO:
      232     APPLY "END-ERROR":U TO SELF.
      233   END.
      234   ON CHOOSE OF b-Exit IN FRAME Dialog-Frame
      235   DO:
      236   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if lookup(self :type
      238            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      239            ) = 0
      240   then do:
      241     message
      242       "$Workfile$"
      243       "Указанному интерфейсному элементу фокус не может быть передан" skip
      244       "Интерфейсный элемент" self :name  skip
      245       "Тип" self :type  skip
      246       "Процедура" this-procedure :file-name skip
      247       view-as alert-box .
      248   end.
      249   else do:
      250     apply "entry":u to self  .
      251     if focus :handle <> self :handle  then do:
      252       return no-apply .
      253     end.
      254   end.
      255      APPLY "END-ERROR":U TO SELF.
      256   END.
      257   ON CHOOSE OF b-Ok IN FRAME Dialog-Frame
      258   DO:
      259   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   if lookup(self :type
      261            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      262            ) = 0
      263   then do:
      264     message
      265       "$Workfile$"
      266       "Указанному интерфейсному элементу фокус не может быть передан" skip
      267       "Интерфейсный элемент" self :name  skip
      268       "Тип" self :type  skip
      269       "Процедура" this-procedure :file-name skip
      270       view-as alert-box .
      271   end.
      272   else do:
      273     apply "entry":u to self  .
      274     if focus :handle <> self :handle  then do:
      275       return no-apply .
      276     end.
      277   end.
      278      IF v-EdUvd:SENSITIVE AND v-EdUvd:MODIFIED THEN DO:
      279         ASSIGN
      280            v-EdUvd.
      281         RUN Modify-Contract-Attr IN THIS-PROCEDURE(
      282             buf_Contract.Host-code,
      283             buf_Contract.Contract-code,
      284             v-gl-Uvedomlenie,
      285             v-EdUvd,
      286             OUTPUT cError
      287             ).
      288      END.
      289      APPLY "GO":U TO SELF.
      290   END.
      291   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      292   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      293   FIND FIRST buf_Contract WHERE
      294              RECID(buf_Contract) = iRid
      295        NO-LOCK NO-ERROR.
      296   IF NOT AVAILABLE buf_Contract THEN DO:
      297      MESSAGE
      298          "Не найден договор RECID(buf_Contract) = " iRid
      299          VIEW-AS ALERT-BOX INFO BUTTONS OK.
      300      RETURN.
      301   END.
      302   ASSIGN
      303      FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE +
      304            " для договора: " + buf_Contract.contract-prn-code + " " +
      305            "Фирма: " + buf_Contract.own-name + " (Уведомление)" .
      306   MAIN-BLOCK:
      307   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      308      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      309     ASSIGN
      310        v-EdUvd = Get-contract-attr(
      311                  buf_Contract.Host-code,
      312                  buf_Contract.Contract-code,
      313                  v-gl-Uvedomlenie).
      314     IF p-Ref-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      315        ASSIGN
      316           v-EdUvd:READ-ONLY = FALSE.
      317     END.
      318     RUN enable_UI.
      319     WAIT-FOR GO OF FRAME Dialog-Frame.
      320   END.
      321   RUN disable_UI.
      322   PROCEDURE disable_UI :
      323     HIDE FRAME Dialog-Frame.
      324   END PROCEDURE.
      325   PROCEDURE enable_UI :
      326     DISPLAY v-EdUvd
      327         WITH FRAME Dialog-Frame.
      328     ENABLE b-Ok b-Exit v-EdUvd
      329         WITH FRAME Dialog-Frame.
      330     VIEW FRAME Dialog-Frame.
      331   END PROCEDURE.
