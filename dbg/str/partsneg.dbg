      772   ON LEAVE OF s-code IN FRAME Dialog-Frame
      773   DO:
      774     def var v-s-code as integer no-undo .
      775     assign
      776       v-s-code = input frame Dialog-Frame s-code
      777     .
      778     define buffer buf_bar-code for ub.bar-code .
      779     define buffer buf_goods    for ub.goods    .
      780     define buffer buf_parts    for ub.parts    .
      781     find first buf_bar-code no-lock
      782       where buf_bar-code.b-code = v-s-code
      783       no-error .
      784     if available buf_bar-code then do:
      785       find first buf_goods no-lock
      786         where buf_goods.gds-code = buf_bar-code.gds-code
      787         .
      788       for each buf_parts no-lock
      789         where buf_parts.artic     = buf_goods.artic
      790           and buf_parts.prod-type = buf_goods.prod-type
      791           and buf_parts.prod-code = buf_goods.prod-code
      792           and buf_parts.in-code   = buf_bar-code.in-code
      793           and buf_parts.part-code = buf_bar-code.part-code
      794       :
      795         reposition br-parts to recid recid(buf_parts) no-error.
      796         if not error-status :error then do:
      797           run reposition-query in this-procedure
      798             (input recid(buf_parts)
      799             ).
      800           return no-apply.
      801         end.
      802       end.
      803     end.
      804     message
      805       "Бар-код не найден !"
      806       view-as alert-box .
      807     return no-apply.
      808   END.
      809   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      810   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      811   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   on help of frame Dialog-Frame
      813   do:
      814     run gbl/app_help.p
      815       (input this-procedure :file-name
      816       ,input ''
      817       ,input ?
      818       ) no-error.
      819     if error-status :error then do:
      820       message
      821         "Ошибка при вызове помощи"
      822         error-status :get-message(1)
      823         view-as alert-box .
      824     end.
      825   end.
      826   run minbtn-set in this-procedure .
      827   on choose of b-help in frame Dialog-Frame
      828   do:
      829     apply "help":u to frame Dialog-Frame .
      830   end.
      831   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   procedure minbtn-set :
      833       do
      834           on error undo, return error return-value
      835           :
      836           define variable ii              as integer       no-undo .
      837           define variable fh              as widget-handle no-undo .
      838           define variable hh              as widget-handle no-undo .
      839           define variable v-h             as handle        extent 4 no-undo .
      840           define variable v-name-button   as character     no-undo .
      841           define variable v-help-old-x    as decimal       no-undo .
      842           define variable v-help-old-y    as decimal       no-undo .
      843           define variable v-help-old-size as decimal       no-undo .
      844           define variable v-frame-width   as decimal       no-undo .
      845           define variable jj              as integer       no-undo .
      846           do
      847               on error undo, return error
      848               :
      849               assign
      850                   v-frame-width = frame Dialog-Frame:width - 0.3
      851                   fh            = frame Dialog-Frame:first-child
      852                   hh            = fh:first-child
      853                   ii            = 1
      854                   .
      855               do while valid-handle(hh):
      856                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      857                   do:
      858                       case lc(hh:name) :
      859                           when "b-help" then
      860                               do:
      861                                   hh:load-image-up("cmp/b-help.bmp":u) .
      862                                   hh:load-image-down("cmp/b-help.bmp":u) .
      863                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      864                                   hh:TOOLTIP = "Помощь" .
      865                                   v-help-old-x = hh:column .
      866                                   v-help-old-y = hh:row    .
      867                                   v-help-old-size = hh:width .
      868                                   hh:width-chars = 2.5 .
      869                               end.
      870                           when "b-print" then
      871                               do:
      872                                   hh:load-image("cmp/b-print.bmp":u) .
      873                                   hh:TOOLTIP = "Печать" .
      874                                   v-h[ii] = hh:handle .
      875                                   ii = ii + 1 .
      876                                   hh:width-chars = 3 .
      877                               end.
      878                           when "b-history" or
      879                           when "b-hist" then
      880                               do:
      881                                   hh:load-image("cmp/b-hist.bmp":u) .
      882                                   hh:TOOLTIP = "История" .
      883                                   v-h[ii] = hh:handle .
      884                                   ii = ii + 1 .
      885                                   hh:width-chars = 3 .
      886                               end.
      887                           when "b-sch" then
      888                               do:
      889                                   hh:load-image("cmp/b-sch.bmp":u) .
      890                                   hh:TOOLTIP = "Установка Фильтра" .
      891                                   v-h[ii] = hh:handle .
      892                                   ii = ii + 1 .
      893                                   hh:width-chars = 3 .
      894                               end.
      895                           when "b-hist-user" then
      896                               do:
      897                                   hh:load-image("cmp/b-hist.bmp":u) .
      898                                   hh:TOOLTIP = "История пользователя" .
      899                                   ii = ii + 1 .
      900                               end.
      901                       end case.
      902                   end.
      903                   hh = hh:next-sibling.
      904               end.
      905               b-help:column = v-frame-width - b-help:width-chars.
      906               jj = 0.
      907               repeat ii = 4 to 1 by -1 :
      908                   if valid-handle (v-h[ii] ) then
      909                   do:
      910                       jj  = jj + 1 .
      911                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      912                       v-h[ii]:row    = v-help-old-y .
      913                   end.
      914               end.
      915           end.
      916       end.
      917   end procedure.
      918   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      919   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      920   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      921   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      922   define variable v-diasize-current-frame-width  as decimal   no-undo .
      923   define variable v-diasize-current-frame-height as decimal   no-undo .
      924   define variable v-diasize-change-size          as logical   no-undo .
      925   define variable v-diasize-resize-button        as handle    no-undo .
      926   define variable v-diasize-wndmax               as logical   no-undo .
      927   define variable v-diasize-wndstore             as logical   no-undo .
      928   define variable v-diasize-proc-name            as character no-undo .
      929   define variable v-diasize-browse-handle        as handle    no-undo .
      930   define variable v-diasize-browse-number        as integer   no-undo .
      931   define variable v-diasize-need-full-display    as logical   no-undo init false .
      932   define temp-table temp-diasize-handle no-undo
      933     field handle-value  as handle
      934     field save-position as decimal
      935     index xpk is primary unique handle-value
      936     .
      937   define temp-table temp-browse-handle no-undo
      938     field browse-type   as character
      939     field browse-number as integer
      940     field browse-handle as handle
      941     field original-size as decimal
      942     index xpk is primary unique browse-type browse-number
      943     index xie browse-type browse-handle
      944   .
      945   procedure diasize_change-height :
      946     define input  parameter p-change-value  as decimal   no-undo .
      947     define input  parameter p-move-resize   as logical   no-undo .
      948     define variable v-field-group-handle    as handle    no-undo .
      949     define variable v-object-handle         as handle    no-undo .
      950     define variable v-frame-height          as decimal   no-undo .
      951     define variable v-frame-virtual-height  as decimal   no-undo .
      952     define variable v-browse-height         as decimal   no-undo .
      953     define variable v-window-height         as decimal   no-undo .
      954     define variable v-window-virtual-height as decimal   no-undo .
      955     define variable v-change-sign           as integer   no-undo .
      956     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      957     define buffer buf_temp-browse-handle  for temp-browse-handle .
      958     if p-change-value > 0
      959     then do:
      960       if frame Dialog-Frame :height + p-change-value
      961           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      962       then do:
      963         assign
      964           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      965                           - (frame Dialog-Frame :height-chars)
      966         .
      967         if p-change-value <= 0
      968         then do:
      969           run diasize_position-resize-button in this-procedure .
      970           return .
      971         end.
      972       end.
      973     end.
      974     if p-change-value < 0
      975     then do:
      976       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      977       then do:
      978         assign
      979           p-change-value = v-diasize-orig-frame-height
      980                          - (frame Dialog-Frame :height-chars)
      981         .
      982         if p-change-value >= 0
      983         then do:
      984           run diasize_position-resize-button in this-procedure .
      985           return .
      986         end.
      987       end.
      988     end.
      989     if p-change-value >= 0
      990     then do:
      991       assign
      992         v-change-sign = 1
      993       .
      994     end.
      995     else do:
      996       assign
      997         v-change-sign = -1
      998       .
      999     end.
     1000     assign
     1001       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1002     .
     1003     if p-change-value = 0
     1004     then do:
     1005       run diasize_position-resize-button in this-procedure .
     1006       return .
     1007     end.
     1008     move_block:
     1009     do
     1010     on error undo move_block, retry move_block
     1011     :
     1012       if retry
     1013       then do:
     1014         do
     1015         on error undo move_block, leave move_block
     1016         :
     1017           if p-change-value > 0
     1018           then do:
     1019             for each buf_temp-diasize-handle
     1020             on error undo, next
     1021             :
     1022               assign
     1023                 v-object-handle = buf_temp-diasize-handle.handle-value
     1024               .
     1025               if v-object-handle <> v-diasize-resize-button
     1026               then do:
     1027                 assign
     1028                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1029                 .
     1030               end.
     1031             end.
     1032             assign
     1033               v-diasize-browse-handle :height = v-browse-height
     1034             .
