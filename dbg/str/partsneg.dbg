       98   procedure proc-alt-shift-f2:
       99     if not ibs.th.gbl.gbl-var:rcode
      100   then
      101     run gbl\inidebug.p .
      102   end.
      103   procedure proc-alt-shift-f3:
      104     run gbl/prvssinf.p
      105       ( input this-procedure
      106       ) .
      107   end.
      108   define variable v-inform-launched as logical no-undo initial false .
      109   procedure proc-alt-shift-f4:
      110     define variable v-action as character no-undo .
      111     if v-inform-launched = false then do:
      112       assign
      113         v-inform-launched = true
      114       .
      115       run gbl/d-inform.w
      116         (  input self
      117         ,  input this-procedure
      118         , output v-action
      119         ) no-error .
      120       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      121       assign
      122         v-inform-launched = false
      123       .
      124     end.
      125   end.
      126   procedure proc-alt-f1:
      127     run gbl/corrhelp.p
      128       (input this-procedure
      129       ) .
      130   end .
      131   on alt-shift-f2 anywhere do:
      132     run proc-alt-shift-f2.
      133   end.
      134   on alt-shift-f3 anywhere do:
      135     run proc-alt-shift-f3 in this-procedure .
      136   end.
      137   on alt-shift-f4 anywhere do:
      138     run proc-alt-shift-f4 in this-procedure.
      139   end.
      140   on alt-f1 anywhere do:
      141     run proc-alt-f1 in this-procedure .
      142   end.
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      145   procedure fltopend_fltopend :
      146   define input parameter p-parent-handle as handle no-undo .
      147   define input parameter p-qh as handle no-undo .
      148   define input parameter p-flt-open-open-query  as character no-undo .
      149   define input parameter p-where-cond as character no-undo .
      150   define input parameter p-use-indFIRST-query-tail as character no-undo .
      151   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      152   define input parameter p-indexed-reposition as character no-undo .
      153     do
      154     on error undo, return error
      155     :
      156   define variable v-prepare-string as character no-undo .
      157   define variable glog as logical no-undo .
      158   assign
      159   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      160                      p-where-cond + chr(32)  +
      161                      p-use-indFIRST-query-tail + chr(32) +
      162                      p-use-ind-sort-clmn-by + chr(32) +
      163                      p-indexed-reposition
      164   .
      165   assign
      166   glog = p-qh:query-prepare(v-prepare-string) no-error .
      167   if not glog
      168   or error-status:error then do:
      169     message error-status:get-message(1) view-as alert-box .
      170     undo, return error .
      171   end.
      172   assign
      173   glog = p-qh:query-open no-error .
      174   if not glog
      175   or error-status:error then do:
      176     message error-status:get-message(1) view-as alert-box .
      177     undo, return error .
      178   end.
      179     end.
      180   end procedure.
      181   procedure fltopend_fltfindd :
      182   define input parameter p-parent-handle as handle no-undo .
      183   define input parameter p-qh as handle no-undo .
      184   define input parameter p-rowid as rowid no-undo .
      185   define input parameter p-next as logical no-undo .
      186   define input parameter p-lock as integer no-undo .
      187   define input parameter p-bh as handle no-undo .
      188   define input parameter p-where-cond as character no-undo .
      189   define input parameter p-use-index-phrase as character no-undo .
      190   define variable glog as logical no-undo .
      191   define variable v-qh as handle no-undo .
      192   define variable v-bh as handle no-undo .
      193   define variable v-recid as recid no-undo .
      194   define variable v-prepare-string as character no-undo .
      195   do
      196   on error undo, return error
      197   on stop undo, return error
      198   :
      199     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      200     create buffer v-bh for table p-bh buffer-name p-bh:name.
      201     create query v-qh.
      202     v-qh:set-buffers(v-bh).
      203     v-prepare-string = substitute("for each &1 &2 &3"
      204                                     ,v-bh:name
      205                                     ,p-where-cond
      206                                     ,p-use-index-phrase).
      207     glog = v-qh:query-prepare(v-prepare-string) no-error.
      208     if not glog then do:
      209       delete object v-qh.
      210       delete object v-bh.
      211       undo, return error .
      212     end.
      213     glog = v-qh:query-open no-error .
      214     if not glog then do:
      215       delete object v-qh.
      216       delete object v-bh.
      217       undo, return error .
      218     end.
      219     if p-next then do:
      220       v-qh:reposition-to-rowid(p-rowid) no-error .
      221       glog = v-qh:get-next( p-lock) no-error .
      222       glog = v-qh:get-next( p-lock) no-error .
      223       if not glog or v-qh:query-off-end = yes then do:
      224         glog = v-qh:get-first( p-lock) no-error .
      225       end.
      226     end.
      227     else do:
      228       glog = v-qh:get-first( p-lock) no-error .
      229     end.
      230     v-recid = v-bh:recid no-error .
      231     delete object v-qh.
      232     delete object v-bh.
      233     return string(v-recid) .
      234   end.
      235   end procedure.
      236   procedure fltopend_fltfindq :
      237   define input parameter p-parent-handle as handle no-undo .
      238   define input parameter p-qh as handle no-undo .
      239   define input parameter p-next as logical no-undo .
      240   define input parameter p-lock as integer no-undo .
      241   define input parameter p-flt-open-open-query  as character no-undo .
      242   define input parameter p-where-cond as character no-undo .
      243   define input parameter p-use-indFIRST-query-tail as character no-undo .
      244   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      245   define input parameter p-indexed-reposition as character no-undo .
      246   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      247   define variable glog as logical no-undo .
      248   define variable v-qh as handle no-undo .
      249   define variable v-bh as handle no-undo extent 18.
      250   define variable v-rowid as rowid no-undo extent 18.
      251   define variable v-ii as integer no-undo .
      252   define variable v-prepare-string as character no-undo .
      253   do
      254   on error undo, return error
      255   on stop undo, return error
      256   :
      257     create query v-qh.
      258     do v-ii = 1 to p-qh:num-buffers:
      259       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      260       assign
      261       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      262       no-error.
      263       v-qh:add-buffer(v-bh[v-ii]).
      264     end.
      265     assign
      266     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      267                       p-where-cond + chr(32)  +
      268                       p-use-indFIRST-query-tail + chr(32) +
      269                       p-use-ind-sort-clmn-by + chr(32) +
      270                       p-indexed-reposition
      271     .
      272     glog = v-qh:query-prepare( v-prepare-string) no-error .
      273     if not glog then do:
      274       delete object v-qh.
      275       do v-ii = 1 to p-qh:num-buffers:
      276         delete object v-bh[v-ii].
      277       end.
      278       undo, return error .
      279     end.
      280     glog = v-qh:query-open no-error .
      281     if not glog then do:
      282       delete object v-qh.
      283       do v-ii = 1 to p-qh:num-buffers:
      284         delete object v-bh[v-ii].
      285       end.
      286       undo, return error .
      287     end.
      288     if p-next then do:
      289       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      290       glog = v-qh:get-next( p-lock) no-error .
      291       glog = v-qh:get-next( p-lock) no-error .
      292       if not glog or v-qh:query-off-end = yes then do:
      293         glog = v-qh:get-first( p-lock) no-error .
      294       end.
      295     end.
      296     else do:
      297       glog = v-qh:get-first( p-lock) no-error .
      298     end.
      299     do v-ii = 1 to p-qh:num-buffers:
      300       assign
      301       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      302       no-error.
      303     end.
      304     delete object v-qh.
      305     do v-ii = 1 to p-qh:num-buffers:
      306       delete object v-bh[v-ii].
      307     end.
      308   end.
      309   end procedure.
