     1642           assign
     1643             buf_temp-browse-handle.browse-handle :width
     1644               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1645             no-error .
     1646           if error-status :error
     1647           or error-status :get-message(1) <> ""
     1648           then do:
     1649             undo move_block, retry move_block .
     1650           end.
     1651         end.
     1652         assign
     1653           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1654           no-error .
     1655         if error-status :error
     1656         or error-status :get-message(1) <> ""
     1657         then do:
     1658           undo move_block, retry move_block.
     1659         end.
     1660         assign
     1661           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1662         no-error .
     1663         if error-status :error
     1664         or error-status :get-message(1) <> ""
     1665         then do:
     1666           undo move_block, retry move_block.
     1667         end.
     1668         if frame Dialog-Frame :scrollable = true
     1669         then do:
     1670           assign
     1671             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1672           no-error .
     1673           if error-status :error
     1674           or error-status :get-message(1) <> ""
     1675           then do:
     1676             undo move_block, retry move_block.
     1677           end.
     1678         end.
     1679       end.
     1680       if p-move-resize
     1681       then do:
     1682         run diasize_position-resize-button in this-procedure .
     1683       end.
     1684       if v-diasize-wndstore = true
     1685       then do:
     1686         if connected("ub") = true
     1687         then do:
     1688           define variable v-cntxt-db-num        as integer   no-undo .
     1689           define variable v-cntxt-userid        as character no-undo .
     1690           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1691                                             , OUTPUT v-cntxt-userid
     1692                                             ) .
     1693           run gbl/wndsizew.p
     1694             (input  v-cntxt-db-num
     1695             ,input  v-cntxt-userid
     1696             ,input  v-diasize-proc-name
     1697             ,input  'width':u
     1698             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1699             ) .
     1700         end.
     1701       end.
     1702     end.
     1703     assign
     1704       v-diasize-change-size = false
     1705     .
     1706   end procedure.
     1707   procedure diasize_set-width :
     1708     define input  parameter p-new-width  as decimal   no-undo .
     1709     define input  parameter p-move-resize as logical   no-undo .
     1710     do
     1711     on error undo, return error return-value
     1712     :
     1713       run diasize_change-width in this-procedure
     1714         (input  (p-new-width - frame Dialog-Frame :width)
     1715         ,input  p-move-resize
     1716         ) .
     1717     end.
     1718   end procedure.
     1719   procedure diasize_position-resize-button :
     1720     do with frame Dialog-Frame
     1721     :
     1722       hide v-diasize-resize-button .
     1723       assign
     1724         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1725                     - 1
     1726                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1727         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1728                     - 1
     1729                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1730       .
     1731       view v-diasize-resize-button .
     1732     end.
     1733   end procedure.
     1734   on alt-right anywhere
     1735   do:
     1736     run diasize_change-width in this-procedure
     1737       (input 1
     1738       ,input true
     1739       ) .
     1740     return no-apply .
     1741   end.
     1742   on alt-left anywhere
     1743   do:
     1744     run diasize_change-width in this-procedure
     1745       (input -1
     1746       ,input true
     1747       ) .
     1748     return no-apply .
     1749   end.
     1750   on alt-down anywhere
     1751   do:
     1752     run diasize_change-height in this-procedure
     1753       (input 1
     1754       ,input true
     1755       ) .
     1756     return no-apply .
     1757   end.
     1758   on alt-up anywhere
     1759   do:
     1760     run diasize_change-height in this-procedure
     1761       (input -1
     1762       ,input true
     1763       ) .
     1764     return no-apply .
     1765   end.
     1766   on alt-enter of frame Dialog-Frame
     1767   do:
     1768     run diasize_maximize in this-procedure
     1769       (input  ?
     1770       ).
     1771     return no-apply .
     1772   end.
     1773   procedure diasize_end-move :
     1774     do
     1775     on error undo, return error return-value
     1776     :
     1777       define variable v-row-delta as decimal   no-undo .
     1778       define variable v-col-delta as decimal   no-undo .
     1779       define variable v-new-row as decimal   no-undo .
     1780       define variable v-new-col as decimal   no-undo .
     1781       assign
     1782         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1783         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1784       .
     1785       assign
     1786         v-row-delta = v-new-row - frame Dialog-Frame :height
     1787         v-col-delta = v-new-col - frame Dialog-Frame :width
     1788       .
     1789       run diasize_change-height in this-procedure
     1790         (input v-row-delta
     1791         ,input true
     1792         ) .
     1793       run diasize_change-width in this-procedure
     1794         (input v-col-delta
     1795         ,input true
     1796         ) .
     1797     end.
     1798   end procedure.
     1799   procedure diasize_maximize :
     1800     define input  parameter p-action as logical   no-undo .
     1801     do
     1802     on error undo, return error return-value
     1803     :
     1804       if p-action = ?
     1805       then do:
     1806         if v-diasize-need-maximize = true
     1807         then do:
     1808           assign
     1809             p-action = true
     1810           .
     1811         end.
     1812         else do:
     1813           assign
     1814             p-action = false
     1815           .
     1816         end.
     1817       end.
     1818       if p-action = true
     1819       then do:
     1820         run diasize_change-height in this-procedure
     1821           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1822               - frame Dialog-Frame :height-chars
     1823           ,input true
     1824           ) .
     1825         run diasize_change-width in this-procedure
     1826           (input session :width-chars
     1827               - frame Dialog-Frame :width-chars
     1828           ,input true
     1829           ) .
     1830         assign
     1831           v-diasize-need-maximize = false
     1832         .
     1833       end.
     1834       else do:
     1835         run diasize_change-width in this-procedure
     1836           (input v-diasize-orig-frame-width
     1837               - frame Dialog-Frame :width-chars
     1838           ,input true
     1839           ) .
     1840         run diasize_change-height in this-procedure
     1841           (input v-diasize-orig-frame-height
     1842               - frame Dialog-Frame :height-chars
     1843           ,input true
     1844           ) .
     1845         assign
     1846           v-diasize-need-maximize = true
     1847         .
     1848       end.
     1849     end.
     1850   end procedure.
     1851   procedure diasize_restore-orig-size :
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       assign
     1856         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1857         v-diasize-current-frame-height = frame Dialog-Frame :height
     1858       .
     1859       run diasize_set-height in this-procedure
     1860         (input  v-diasize-orig-frame-height
     1861         ,input  true
     1862         ) .
     1863       run diasize_set-width in this-procedure
     1864         (input  v-diasize-orig-frame-width
     1865         ,input  true
     1866         ) .
     1867     end.
     1868   end procedure.
     1869   procedure diasize_restore-current-size :
     1870     do
     1871     on error undo, return error return-value
     1872     :
     1873       run diasize_set-height in this-procedure
     1874         (input  v-diasize-current-frame-height
     1875         ,input  true
     1876         ) .
     1877       run diasize_set-width in this-procedure
     1878         (input  v-diasize-current-frame-width
     1879         ,input  true
     1880         ) .
     1881     end.
     1882   end procedure.
     1883   procedure diasize_set-browse-handle :
     1884     define input  parameter p-browse-handle as handle   no-undo .
     1885     define buffer buf_temp-browse-handle for temp-browse-handle .
     1886     do
     1887     on error undo, return error return-value
     1888     :
     1889       assign
     1890         v-diasize-browse-handle = p-browse-handle
     1891       .
     1892       for each buf_temp-browse-handle
     1893       on error undo, return error return-value
     1894       :
     1895         delete buf_temp-browse-handle .
     1896       end.
     1897     end.
     1898   end procedure.
     1899   procedure diasize_add_browse :
     1900     define input  parameter p-browse-type   as character no-undo .
     1901     define input  parameter p-browse-handle as handle    no-undo .
     1902     define buffer buf_temp-browse-handle for temp-browse-handle .
     1903     do
     1904     on error undo, return error return-value
     1905     :
     1906       assign
     1907         v-diasize-browse-number = v-diasize-browse-number + 1
     1908       .
     1909       create buf_temp-browse-handle .
     1910       assign
     1911         buf_temp-browse-handle.browse-type   = p-browse-type
     1912         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1913         buf_temp-browse-handle.browse-handle = p-browse-handle
     1914       .
     1915     end.
     1916   end procedure.
     1917   procedure diasize_init :
     1918     define variable v-default-value    as logical   no-undo .
     1919     define variable v-restore-saved    as logical   no-undo .
     1920     define variable v-resize-value-str as character no-undo .
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       do with frame Dialog-Frame
     1925       :
     1926         assign
     1927           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1928           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1929           v-diasize-browse-handle     = browse br-parts :handle
     1930         .
     1931         create button v-diasize-resize-button
     1932         assign
     1933           parent        = frame Dialog-Frame :first-child
     1934           label         = "s"
     1935           height-pixels = 16
     1936           width-pixels  = 16
     1937           visible       = true
     1938           sensitive     = true
     1939           movable       = true
     1940           triggers:
     1941             on end-move persistent run diasize_end-move in this-procedure .
     1942           end triggers.
     1943         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1944         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1945         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1946         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1947         assign
     1948           v-diasize-wndmax = false
     1949         .
     1950         if connected("ub") = true
     1951         then do:
     1952           define variable v-cntxt-db-num        as integer   no-undo .
     1953           define variable v-cntxt-userid        as character no-undo .
     1954           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1955                                             , OUTPUT v-cntxt-userid
     1956                                             ) .
     1957           run gbl/wndpar_r.p
     1958             (input  v-cntxt-db-num
     1959             ,input  v-cntxt-userid
     1960             ,input  'wndmax':U
     1961             ,output v-diasize-wndmax
     1962             ,output v-default-value
     1963             ) .
     1964         end.
     1965         assign
     1966           v-diasize-wndstore = false
     1967         .
     1968         if connected("ub") = true
     1969         then do:
     1970           run gbl/wndpar_r.p
     1971             (input  v-cntxt-db-num
     1972             ,input  v-cntxt-userid
     1973             ,input  'wndstore':U
     1974             ,output v-diasize-wndstore
     1975             ,output v-default-value
     1976             ) .
     1977         end.
     1978         assign
     1979           v-diasize-proc-name = entry(1, program-name(2), '.')
     1980         .
     1981         if v-diasize-wndstore = true
     1982         then do:
     1983           assign
     1984             v-restore-saved = false
     1985           .
     1986           if connected("ub") = true
     1987           then do:
     1988             run gbl/wndsizer.p
     1989               (input  v-cntxt-db-num
     1990               ,input  v-cntxt-userid
     1991               ,input  v-diasize-proc-name
     1992               ,input  'height':u
     1993               ,output v-resize-value-str
     1994               ) .
     1995             if v-resize-value-str <> '':U
     1996             then do:
     1997               run diasize_change-height in this-procedure
     1998                 (input  integer(v-resize-value-str)
     1999                 ,input  true
     2000                 ) .
     2001               assign
     2002                 v-restore-saved = true
     2003               .
     2004             end.
     2005           end.
     2006           if connected("ub") = true
     2007           then do:
     2008             run gbl/wndsizer.p
     2009               (input  v-cntxt-db-num
     2010               ,input  v-cntxt-userid
     2011               ,input  v-diasize-proc-name
     2012               ,input  'width':u
     2013               ,output v-resize-value-str
     2014               ) .
     2015             if v-resize-value-str <> '':U
     2016             then do:
     2017               run diasize_change-width in this-procedure
     2018                 (input  integer(v-resize-value-str)
     2019                 ,input  true
     2020                 ) .
     2021               assign
     2022                 v-restore-saved = true
     2023               .
     2024             end.
     2025           end.
     2026           if v-restore-saved <> true
     2027           then do:
     2028             if v-diasize-wndmax = true
     2029             then do:
     2030               run diasize_maximize in this-procedure
     2031                 (input  true
     2032                 ) .
     2033             end.
     2034           end.
     2035         end.
     2036         else do:
     2037           if v-diasize-wndmax = true
     2038           then do:
     2039             run diasize_maximize in this-procedure
     2040               (input  true
     2041               ) .
     2042           end.
     2043         end.
     2044       end.
     2045     end.
     2046   end procedure.
     2047   procedure diasize_need-full-display :
     2048     define output parameter p-need-full-display as logical   no-undo .
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       assign
     2053         p-need-full-display = v-diasize-need-full-display
     2054       .
     2055       assign
     2056         v-diasize-need-full-display = false
     2057       .
     2058     end.
     2059   end procedure.
     2060   procedure get-context :
     2061      define output parameter p-db-num as integer          no-undo.
     2062      define output parameter p-user-id as character        no-undo.
     2063      define variable v-login               as character    no-undo.
     2064      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2065      define buffer buf_user-login  for ub.user-login .
     2066      do
     2067      on error undo, return error
     2068      :
     2069            FIND FIRST buf_sys-ctrl no-lock.
     2070            ASSIGN
     2071               v-login = USERID("ub")
     2072               p-db-num = buf_sys-ctrl.db-num
     2073            .
     2074            FIND FIRST buf_user-login
     2075                 WHERE buf_user-login.db-num = p-db-num
     2076                   AND buf_user-login.user-login = v-login
     2077                 no-lock
     2078                 no-error
     2079                 .
     2080            IF AVAILABLE buf_user-login
     2081            THEN DO:
     2082               assign
     2083                  p-user-id = buf_user-login.user-id
     2084               .
     2085            END.
     2086      end.
     2087   end procedure.
     2088       run diasize_init in this-procedure .
     2089   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2090   on F3 of frame Dialog-Frame anywhere do:
     2091     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2092     return no-apply.
     2093   end.
     2094   run init-filter-point .
     2095   assign
     2096     parts.qnty      :read-only in browse br-parts = true
     2097     parts.fact-qnty :read-only in browse br-parts = true
     2098   .
     2099   if browse br-parts:set-repositioned-row(3, "CONDITIONAL" ) then .
     2100   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2101   DEF VAR cur-clmn-numbr-parts as INT EXTENT 11 no-undo.
     2102   DEF VAR varmvibr-parts       as INT no-undo.
     2103   DEF VAR varmvjbr-parts       as INT no-undo.
     2104   DEF VAR varmvkbr-parts       as INT no-undo.
     2105   DEF VAR varmvlbr-parts       as INT no-undo.
     2106   DEF VAR move-elementbr-parts as INT no-undo.
     2107   def var jjbr-parts           as int no-undo.
     2108   do varmvibr-parts = 1 to EXTENT(cur-clmn-numbr-parts):
     2109     ASSIGN cur-clmn-numbr-parts[varmvibr-parts] = varmvibr-parts.
     2110   END.
     2111   RUN start-mv-clmnbr-parts.
     2112   PROCEDURE start-mv-clmnbr-parts:
     2113   def var old-session as logical no-undo.
     2114      old-session = SESSION:IMMEDIATE-DISPLAY.
     2115      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2116      SESSION:IMMEDIATE-DISPLAY = old-session.
     2117   END.
     2118   ON ctrl-cursor-right OF BROWSE br-parts do:
     2119     RUN re-move-clmnbr-parts ( 3, 11).
     2120   END.
     2121   ON ctrl-cursor-left OF BROWSE br-parts do:
     2122     RUN re-move-clmnbr-parts (11, 3).
     2123   END.
     2124   PROCEDURE re-move-clmnbr-parts:
     2125     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2126     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2127     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     2128       if cur-clmn-numbr-parts[varmvibr-parts] = source-column THEN cur-clmn-numbr-parts[varmvibr-parts] = -1.
     2129     END.
     2130     if br-parts:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2131     if source-column > target-column THEN
     2132     DO varmvjbr-parts = source-column - 1 to target-column BY -1:
     2133       DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     2134           if cur-clmn-numbr-parts[varmvibr-parts] = varmvjbr-parts THEN DO:
     2135             cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-numbr-parts[varmvibr-parts] + 1.
     2136           END.
     2137       END.
     2138     END.
     2139     ELSE
     2140     DO varmvjbr-parts = source-column + 1 to target-column:
     2141       DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     2142         if cur-clmn-numbr-parts[varmvibr-parts] = varmvjbr-parts THEN DO:
     2143           cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-numbr-parts[varmvibr-parts] - 1.
     2144         END.
     2145       END.
     2146     END.
     2147     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     2148       if cur-clmn-numbr-parts[varmvibr-parts] = -1 THEN cur-clmn-numbr-parts[varmvibr-parts] = target-column.
     2149     END.
     2150   END PROCEDURE.
     2151   PROCEDURE ch-clmnbr-parts:
     2152     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2153     if cur-clmn-loc <= 3 then do:
     2154       return .
     2155     end.
     2156     DO varmvibr-parts = 1 TO EXTENT(cur-clmn-numbr-parts):
     2157       if cur-clmn-numbr-parts[varmvibr-parts] = cur-clmn-loc THEN move-elementbr-parts = varmvibr-parts.
     2158     END.
     2159     RUN re-move-clmnbr-parts (cur-clmn-loc, 3).
     2160   END PROCEDURE.
     2161   PROCEDURE mv-brw-defaultbr-parts:
     2162   def var old-session as logical no-undo.
     2163     old-session = SESSION:IMMEDIATE-DISPLAY.
     2164     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2165     do varmvlbr-parts = 3 to EXTENT(cur-clmn-numbr-parts):
     2166       RUN re-move-clmnbr-parts (cur-clmn-numbr-parts[varmvlbr-parts], varmvlbr-parts).
     2167     END.
     2168     RUN start-mv-clmnbr-parts.
     2169     SESSION:IMMEDIATE-DISPLAY = old-session.
     2170   END PROCEDURE.
     2171   .
     2172   def var sort-labelbr-parts   as character no-undo .
     2173   def var sort-clmnbr-parts    as handle    no-undo .
     2174   def var cur-clmnbr-parts     as handle    no-undo .
     2175   def var cur-clmn-locbr-parts as integer   no-undo .
     2176   def var re-querybr-parts     as logical   initial no no-undo .
     2177   on start-search, ctrl-o of br-parts in frame Dialog-Frame do:
     2178      run sort-brbr-parts
     2179        (input (if available ub.parts
     2180                then recid(ub.parts)
     2181                else ?
     2182               )
     2183        ).
     2184   end.
     2185   PROCEDURE sort-brbr-parts :
     2186     define input parameter p-recid as recid no-undo .
     2187     if re-querybr-parts = no then do:
     2188       assign
     2189          cur-clmnbr-parts = br-parts:current-column in frame Dialog-Frame
     2190       .
     2191       if sort-clmnbr-parts <> ? then sort-clmnbr-parts:column-fgcolor = 0.
     2192       if cur-clmnbr-parts = sort-clmnbr-parts then do:
     2193         assign
     2194            sort-labelbr-parts = ""
     2195            sort-clmnbr-parts = ?
     2196         .
     2197        end.
     2198        else do:
     2199          assign
     2200            sort-labelbr-parts = cur-clmnbr-parts:label
     2201            sort-clmnbr-parts  = cur-clmnbr-parts
     2202            sort-clmnbr-parts:column-fgcolor = 4
     2203          .
     2204        end.
     2205      end.
     2206     assign
     2207       cur-clmn-locbr-parts = 1
     2208     .
     2209     def var column-handle as handle no-undo .
     2210     column-handle = br-parts:first-column.
     2211     do while valid-handle(column-handle) :
     2212       if column-handle = cur-clmnbr-parts then do:
     2213         leave .
     2214       end.
     2215       column-handle = column-handle:NEXT-COLUMN.
     2216       assign
     2217         cur-clmn-locbr-parts = cur-clmn-locbr-parts + 1
     2218       .
     2219     end.
     2220     case sort-labelbr-parts:
     2221           when ub.parts.artic:label in browse br-parts then DO:    assign       sort-column-name = "ub.parts.artic"     .     run reopen-query.   . END.
     2222           when parts-prod:label in browse br-parts then DO:    assign       sort-column-name = "parts-prod"     .     run reopen-query.   . END.
     2223           when ub.parts.qnty:label in browse br-parts then DO:    assign       sort-column-name = "ub.parts.qnty"     .     run reopen-query.   . END.
     2224           when ub.parts.fact-qnty:label in browse br-parts then DO:    assign       sort-column-name = "ub.parts.fact-qnty"     .     run reopen-query.   . END.
     2225           when ub.parts.price-base:label in browse br-parts then DO:    assign       sort-column-name = "ub.parts.price-base"     .     run reopen-query.   . END.
     2226           when ub.parts.price-rubl:label in browse br-parts then DO:    assign       sort-column-name = "ub.parts.price-rubl"     .     run reopen-query.   . END.
     2227           when parts-part-code:label in browse br-parts then DO:    assign       sort-column-name = "parts-part-code"     .     run reopen-query.   . END.
     2228           when parts-b-code :label in browse br-parts  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-goods-bar-code&1,&1&2&1,&1&3&1,&1&4&1)', chr(34) ,ub.parts.artic, ub.parts.prod-type, ub.parts.prod-code)     .     run reopen-query.   . END.
     2229           when parts-gds-name :label in browse br-parts  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-goods-gds-name&1,&1&2&1,&1&3&1,&1&4&1)', chr(34) ,ub.parts.artic, ub.parts.prod-type, ub.parts.prod-code)     .     run reopen-query.   . END.
     2230           when is-supp:label in browse br-parts then DO:    assign       sort-column-name = "is-supp"     .     run reopen-query.   . END.
     2231           when parts-supp:label in browse br-parts then DO:    assign       sort-column-name = "parts-supp"     .     run reopen-query.   . END.
     2232       otherwise do:
     2233         assign
     2234           sort-column-name = ""
     2235         .
     2236         run reopen-query.
     2237         if sort-labelbr-parts <> "" then do:
     2238           assign
     2239             cur-clmnbr-parts:column-fgcolor = 0
     2240           .
     2241         end.
     2242         assign
     2243           cur-clmn-locbr-parts = ?
     2244         .
     2245       end.
     2246     end case.
     2247       if cur-clmn-locbr-parts <> ? then do:
     2248         if can-do( this-procedure:internal-entries, 'ch-clmnbr-parts') then do:
     2249           run ch-clmnbr-parts in this-procedure (cur-clmn-locbr-parts).
     2250         end.
     2251       end.
     2252     if p-recid <> ? then do:
     2253       reposition br-parts to recid p-recid no-error.
     2254       apply "value-changed" to br-parts in frame Dialog-Frame.
     2255     end.
     2256     apply "entry" to br-parts in frame Dialog-Frame.
     2257   END PROCEDURE.
     2258   procedure re-open-query-srt-clmnbr-parts:
     2259   if cur-clmnbr-parts = ? then do:
     2260      run reopen-query.
     2261   end.
     2262   else do:
     2263      assign re-querybr-parts = yes.
     2264      run sort-brbr-parts
     2265        (input (if available ub.parts
     2266                then recid(ub.parts)
     2267                else ?
     2268               )
     2269        ).
     2270      assign re-querybr-parts = no.
     2271   end.
     2272   end.
     2273   MAIN-BLOCK:
     2274   DO
     2275   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2276   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2277   :
     2278     run main-block-procedure no-error .
     2279     if error-status :error then do:
     2280       undo MAIN-BLOCK, LEAVE MAIN-BLOCK .
     2281     end.
     2282   END.
     2283   RUN disable_UI.
     2284   PROCEDURE disable_UI :
     2285     HIDE FRAME Dialog-Frame.
     2286   END PROCEDURE.
     2287   PROCEDURE display-parts-info :
     2288     define buffer buf_clients  for ub.clients .
     2289     def var v-b-code like ub.bar-code.b-code no-undo .
     2290     do with frame Dialog-Frame:
     2291       if available ub.parts then do:
     2292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2293     (buffer ub.parts
     2294     ,output v-b-code
     2295     ) no-error .
     2296         display
     2297           v-b-code @ s-code
     2298           with frame Dialog-Frame.
     2299         find buf_clients no-lock
     2300           where buf_clients.obj-type = parts.prod-type
     2301             and buf_clients.obj-code = parts.prod-code
     2302           no-error .
     2303         if available buf_clients then do:
     2304           assign
     2305             fi-prod-name :screen-value = buf_clients.obj-name
     2306           .
     2307         end.
     2308         find buf_clients no-lock
     2309           where buf_clients.obj-type = parts.supp-type
     2310             and buf_clients.obj-code = parts.supp-code
     2311           no-error .
     2312         if available buf_clients then do:
     2313           assign
     2314             fi-supp-name :screen-value = buf_clients.obj-name
     2315           .
     2316         end.
     2317         display
     2318           parts.artic
     2319           parts.prod-type
     2320           parts.prod-code
     2321           parts.supp-type
     2322           parts.supp-code
     2323           parts.is-supp
     2324           parts.price-base
     2325           parts.price-rubl
     2326           parts.price-cli
     2327           parts.SLT-pc
     2328           parts.SLT-type
     2329           parts.VAT-pc
     2330           parts.VAT-type
     2331           parts.qnty
     2332           parts.fact-qnty
     2333           with frame Dialog-Frame.
     2334       end.
     2335     end.
     2336   END PROCEDURE.
     2337   PROCEDURE enable_UI :
     2338     DISPLAY s-code fi-prod-name fi-curr-base fi-curr-rubl fi-curr-cli fi-supp-name
     2339         WITH FRAME Dialog-Frame.
     2340     IF AVAILABLE ub.parts THEN
     2341       DISPLAY parts.artic parts.prod-type parts.prod-code parts.price-base
     2342             parts.SLT-pc parts.SLT-type parts.price-rubl parts.VAT-pc
     2343             parts.VAT-type parts.price-cli parts.qnty parts.fact-qnty
     2344             parts.supp-type parts.supp-code parts.is-supp
     2345         WITH FRAME Dialog-Frame.
     2346     ENABLE rect-flt s-code b-exit b-lkp b-gds b-in b-sch b-b-alt b-pl b-help
     2347            br-parts RECT-1
     2348         WITH FRAME Dialog-Frame.
     2349   END PROCEDURE.
     2350   PROCEDURE get-goods-cache :
     2351     define input parameter p-artic     like ub.goods.artic     no-undo .
     2352     define input parameter p-prod-type like ub.goods.prod-type no-undo .
     2353     define input parameter p-prod-code like ub.goods.prod-code no-undo .
     2354     define parameter buffer buf_goods-cache for goods-cache .
     2355     find first buf_goods-cache no-lock
     2356       where buf_goods-cache.artic     = p-artic
     2357         and buf_goods-cache.prod-type = p-prod-type
     2358         and buf_goods-cache.prod-code = p-prod-code
     2359       no-error .
     2360     if not available buf_goods-cache then do:
     2361       create buf_goods-cache .
     2362       assign
     2363         buf_goods-cache.artic     = p-artic
     2364         buf_goods-cache.prod-type = p-prod-type
     2365         buf_goods-cache.prod-code = p-prod-code
     2366       .
     2367       define buffer buf_goods for ub.goods .
     2368       find first buf_goods no-lock
     2369         where buf_goods.artic     = p-artic
     2370           and buf_goods.prod-type = p-prod-type
     2371           and buf_goods.prod-code = p-prod-code
     2372         .
     2373       assign
     2374         buf_goods-cache.gds-name = buf_goods.gds-name
     2375       .
     2376   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2378     (input  buf_goods.artic
     2379     ,input  buf_goods.prod-type
     2380     ,input  buf_goods.prod-code
     2381     ,output buf_goods-cache.root-node
     2382     )  .
     2383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2384     (input  buf_goods.gds-code
     2385     ,input  buf_goods-cache.root-node
     2386     ,output buf_goods-cache.b-code
     2387     )  .
     2388     end.
     2389   END PROCEDURE.
     2390   PROCEDURE init-filter-point :
     2391     assign
     2392       filter-point = entry(1, entry(2, vss-workfile, ' '), '.')
     2393     .
     2394   END PROCEDURE.
     2395   PROCEDURE main-block-procedure :
     2396     do
     2397     on error   undo , return error
     2398     on end-key undo , return error
     2399     :
     2400       find first ub.trn-doc no-lock
     2401         where ub.trn-doc.doc-code = p-doc-code
     2402         no-error .
     2403       if not available ub.trn-doc then do:
     2404         message
     2405           vss-workfile vss-revision vss-description skip
     2406           "Документ не найден" skip
     2407           "Документ" p-doc-code skip
     2408           view-as alert-box error .
     2409         undo, return error .
     2410       end.
     2411       assign
     2412         p-part-recid = ?
     2413       .
     2414       if p-line-mode = 'ИЗМЕНЕНИЕ':U
     2415       then do:
     2416         do with frame Dialog-Frame:
     2417           assign
     2418             b-lkp :label = "&Измен"
     2419           .
     2420         end.
     2421       end.
     2422       RUN enable_UI .
     2423       run reopen-query .
     2424       WAIT-FOR GO OF FRAME Dialog-Frame focus br-parts .
     2425     end.
     2426   END PROCEDURE.
     2427   PROCEDURE reopen-query :
     2428     run UI-on .
     2429   END PROCEDURE.
     2430   PROCEDURE reposition-parts :
     2431     define input  parameter p-direction   as character no-undo .
     2432     define output parameter p-parts-recid as recid no-undo .
     2433     case p-direction :
     2434       when "first":U then do:
     2435         get first br-parts.
     2436       end.
     2437       when "last":U then do:
     2438         get last br-parts.
     2439       end.
     2440       when "prev":U then do:
     2441         get prev br-parts.
     2442       end.
     2443       when "next":U then do:
     2444         get next br-parts.
     2445       end.
     2446       otherwise do:
     2447         reposition br-parts to recid integer(p-direction) no-error .
     2448       end.
     2449     end case .
     2450     assign
     2451       p-parts-recid = recid(ub.parts)
     2452     .
     2453     run reposition-query in this-procedure
     2454       (input p-parts-recid
     2455       ).
     2456   END PROCEDURE.
     2457   PROCEDURE reposition-query :
     2458     define input parameter p-recid as recid no-undo .
     2459     if p-recid <> ? then do:
     2460       reposition br-parts to recid p-recid no-error.
     2461     end.
     2462     do with frame Dialog-Frame:
     2463       apply "entry":u to browse br-parts .
     2464     end.
     2465     run display-parts-info .
     2466   END PROCEDURE.
     2467   PROCEDURE set-filter-name :
     2468     define input parameter p-filter-name as character no-undo .
     2469     do with frame Dialog-Frame:
     2470       if p-filter-name > "" then do:
     2471         assign
     2472           frame Dialog-Frame:title
     2473             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2474         .
     2475         assign
     2476           rect-flt :BGCOLOR = RED_COLOR
     2477           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2478         .
     2479       end.
     2480       else do:
     2481         assign
     2482           rect-flt :BGCOLOR = GREY_COLOR
     2483           b-sch :TOOLTIP = ""
     2484         .
     2485       end.
     2486     end.
     2487   END PROCEDURE.
     2488   PROCEDURE UI-on :
     2489   def var l-query-was-opened as logical no-undo .
     2490   assign
     2491     l-query-was-opened = false
     2492   .
     2493   def var sort-column-phrase as character no-undo .
     2494   case sort-column-name :
     2495     when "" then do:
     2496       assign
     2497         sort-column-phrase = ""
     2498       .
     2499     end.
     2500     when "parts-out-code" then do:
     2501       assign
     2502         sort-column-phrase = "by parts.out-code"
     2503       .
     2504     end.
     2505     when "parts-prod" then do:
     2506       assign
     2507         sort-column-phrase = "by parts.prod-type by parts.prod-code"
     2508       .
     2509     end.
     2510     when "parts-supp" then do:
     2511       assign
     2512         sort-column-phrase = "by parts.supp-type by parts.supp-code"
     2513       .
     2514     end.
     2515     when "parts-part-code" then do:
     2516       assign
     2517         sort-column-phrase = "by parts.part-code"
     2518       .
     2519     end.
     2520     otherwise do:
     2521       assign
     2522         sort-column-phrase = "by " + sort-column-name
     2523       .
     2524     end.
     2525   end case.
     2526   assign
     2527     frame Dialog-Frame:title = "Порожденные партии по документу " + string(p-doc-code)
     2528   .
     2529   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2530   define variable  l-disable-where-16  as logical   no-undo .
     2531   define variable  l-filter-open-16    as logical   .
     2532   define variable  flt-rec-16       as recid     no-undo .
     2533   define variable  filter-name-16      as character no-undo .
     2534   define variable  where-phrase-16     as character no-undo .
     2535   define variable  sort-phrase-16      as character no-undo .
     2536   define variable  where-phrase-rus-16 as character no-undo .
     2537   define variable  sort-phrase-rus-16  as character no-undo .
     2538   run gbl/flt-get.p
     2539     (input filter-point
     2540     ,output flt-rec-16
     2541     ,output filter-name-16
     2542     ,output where-phrase-16
     2543     ,output sort-phrase-16
     2544     ,output where-phrase-rus-16
     2545     ,output sort-phrase-rus-16
     2546     ).
     2547       run set-filter-name in this-procedure
     2548         (INPUT filter-name-16
     2549         ) no-error .
     2550     assign
     2551       l-filter-open-16 = false
     2552     .
     2553     if flt-rec-16 <> ?
     2554       or sort-column-phrase > ""
     2555     then do:
     2556       define variable  parameter-2-16 as character no-undo .
     2557       define variable  parameter-3-16 as character no-undo .
     2558       define variable  parameter-4-16 as character no-undo .
     2559       define variable  parameter-5-16 as character no-undo .
     2560       define variable  parameter-6-16 as character no-undo .
     2561       define variable  parameter-7-16 as character no-undo .
     2562         assign
     2563         parameter-3-16 =
     2564                                 "FOR EACH ub.parts"
     2565         parameter-4-16 =
     2566           (
     2567             if ("ub.parts.out-code  = ub.trn-doc.doc-code               and ub.parts.obj-type = ub.trn-doc.obj-type               and ub.parts.obj-code = ub.trn-doc.obj-code               and ub.parts.in-code  = ub.trn-doc.doc-code " + " " + where-phrase-16) <> ""
     2568             then  substitute('                    ub.parts.out-code = &1&2&1                and ub.parts.obj-type = &1&3&1                and ub.parts.obj-code = &4                   and ub.parts.in-code  = &1&5&1                   '  , chr(34)                   ,ub.trn-doc.doc-code                      ,ub.trn-doc.obj-type                      ,ub.trn-doc.obj-code                      ,ub.trn-doc.doc-code )  + " " + where-phrase-16
     2569             else "true"
     2570           )
     2571         parameter-5-16 = (" " + "" + " " + "")
     2572         parameter-6-16 = if sort-phrase-16 = ''
     2573                              then
     2574           (
     2575           " " + " use-index out-code " +
     2576             " " + sort-column-phrase +
     2577           " " + "by ub.parts.artic by ub.parts.prod-type by ub.parts.prod-code"
     2578           )
     2579                              else
     2580           (
     2581           " " + " use-index out-code " +
     2582             " " + sort-column-phrase +
     2583           " " + sort-phrase-16
     2584           )
     2585         parameter-7-16 =
     2586           " indexed-reposition  "
     2587       .
     2588       do
     2589       on stop undo, leave
     2590       on error undo, leave
     2591       :
     2592         assign
     2593           l-disable-where-16 =
     2594             ("ub.parts.out-code  = ub.trn-doc.doc-code               and ub.parts.obj-type = ub.trn-doc.obj-type               and ub.parts.obj-code = ub.trn-doc.obj-code               and ub.parts.in-code  = ub.trn-doc.doc-code " + " " + where-phrase-16 = "")
     2595         .
     2596         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2597                             ,input query br-parts:handle
     2598                             ,input parameter-3-16
     2599                             ,input parameter-4-16
     2600                             ,input parameter-5-16
     2601                             ,input parameter-6-16
     2602                             ,input parameter-7-16
     2603                             )
     2604         .
     2605         assign
     2606           l-filter-open-16 = true
     2607         .
     2608       end.
     2609       if l-filter-open-16 = false then do:
     2610         message
     2611           "Ошибка при фильтрации / сортировке" skip
     2612           "Будут показаны записи без учета фильтра" skip
     2613           view-as alert-box .
     2614       end.
     2615       else do:
     2616           assign
     2617             l-query-was-opened = true
     2618           .
     2619       end.
     2620     end.
     2621     if l-filter-open-16 = false then do:
     2622       open query br-parts for each ub.parts no-lock
     2623         where ub.parts.out-code  = ub.trn-doc.doc-code               and ub.parts.obj-type = ub.trn-doc.obj-type               and ub.parts.obj-code = ub.trn-doc.obj-code               and ub.parts.in-code  = ub.trn-doc.doc-code
     2624          use-index out-code
     2625         by ub.parts.artic by ub.parts.prod-type by ub.parts.prod-code
     2626         indexed-reposition
     2627     .
     2628         assign
     2629           l-query-was-opened = true
     2630         .
     2631     end.
     2632   run reposition-query in this-procedure
     2633     (input p-part-recid
     2634     ).
     2635   if v-fltopend-rowid[1] <> ? then
     2636   query br-parts:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     2637   END PROCEDURE.
     2638   FUNCTION get-goods-bar-code RETURNS INTEGER
     2639     ( p-artic as character, p-prod-type as character, p-prod-code as integer ) :
     2640      def var v-b-code as integer no-undo .
     2641      define buffer buf_goods-cache for goods-cache .
     2642      run get-goods-cache
     2643        (input  p-artic
     2644        ,input  p-prod-type
     2645        ,input  p-prod-code
     2646        ,buffer buf_goods-cache
     2647        ).
     2648      assign
     2649        v-b-code = buf_goods-cache.b-code
     2650      .
     2651      return v-b-code .
     2652   END FUNCTION.
     2653   FUNCTION get-goods-gds-name RETURNS CHARACTER
     2654     ( p-artic as character, p-prod-type as character, p-prod-code as integer ) :
     2655      def var v-gds-name as character no-undo .
     2656      define buffer buf_goods-cache for goods-cache .
     2657      run get-goods-cache
     2658        (input  p-artic
     2659        ,input  p-prod-type
     2660        ,input  p-prod-code
     2661        ,buffer buf_goods-cache
     2662        ).
     2663      assign
     2664        v-gds-name = buf_goods-cache.gds-name
     2665      .
     2666      return v-gds-name .
     2667   END FUNCTION.
