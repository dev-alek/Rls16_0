     1320   procedure diasize_set-height :
     1321     define input  parameter p-new-height  as decimal   no-undo .
     1322     define input  parameter p-move-resize as logical   no-undo .
     1323     do
     1324     on error undo, return error return-value
     1325     :
     1326       run diasize_change-height in this-procedure
     1327         (input  (p-new-height - frame Dialog-Frame :height)
     1328         ,input  p-move-resize
     1329         ) .
     1330     end.
     1331   end procedure.
     1332   procedure diasize_change-width :
     1333     define input  parameter p-change-value as decimal   no-undo .
     1334     define input  parameter p-move-resize  as logical   no-undo .
     1335     define variable v-field-group-handle   as handle    no-undo .
     1336     define variable v-object-handle        as handle    no-undo .
     1337     define variable v-frame-width          as decimal   no-undo .
     1338     define variable v-frame-virtual-width  as decimal   no-undo .
     1339     define variable v-browse-width         as decimal   no-undo .
     1340     define variable v-window-width         as decimal   no-undo .
     1341     define variable v-window-virtual-width as decimal   no-undo .
     1342     define variable v-change-sign          as integer   no-undo .
     1343     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1344     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1345     if p-change-value > 0
     1346     then do:
     1347       if frame Dialog-Frame :width + p-change-value >
     1348           session :width-chars
     1349       then do:
     1350         assign
     1351           p-change-value = session :width-chars - frame Dialog-Frame :width
     1352         .
     1353         if p-change-value <= 0
     1354         then do:
     1355           run diasize_position-resize-button in this-procedure .
     1356           return .
     1357         end.
     1358       end.
     1359     end.
     1360     if p-change-value < 0
     1361     then do:
     1362       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1363       then do:
     1364         assign
     1365           p-change-value = v-diasize-orig-frame-width
     1366                          - frame Dialog-Frame :width
     1367         .
     1368         if p-change-value >= 0
     1369         then do:
     1370           run diasize_position-resize-button in this-procedure .
     1371           return .
     1372         end.
     1373       end.
     1374     end.
     1375     if p-change-value >= 0
     1376     then do:
     1377       assign
     1378         v-change-sign = 1
     1379       .
     1380     end.
     1381     else do:
     1382       assign
     1383         v-change-sign = -1
     1384       .
     1385     end.
     1386     assign
     1387       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1388     .
     1389     if p-change-value = 0
     1390     then do:
     1391       run diasize_position-resize-button in this-procedure .
     1392       return .
     1393     end.
