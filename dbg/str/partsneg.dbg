      603       lab      = 'Артик 3,Номер ПН,,Производитель,Объект,Поставщик,,Закр,Кол.док.,Факт.кол.,Дата,Код Оплаты,Тип Докум.,Цена (вал),Цена (руб),Цена пост. (вал),Валюта пост.,Поставка'
      604       spr      = 'function_character,,,,cli,cli,cli,,,,,,pay,trn-type,,,curr,'
      605       dim      = '18'
      606     .
