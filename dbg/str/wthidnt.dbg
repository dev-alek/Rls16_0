        1   block-level on error undo, throw.
        2   define input  parameter p-bar-code  as character no-undo.
        3   define output parameter p-ser-code  as integer no-undo.
        4   define output parameter p-db-num    like ub.wth-ser.db-num no-undo.
        5   define output parameter p-stts      as integer no-undo.
        6   define output parameter p-wth-code  like ub.wth-parts.wth-code no-undo.
        7   define output parameter p-gds-code  as character no-undo.
        8   define output parameter p-par-code  like ub.wth-parts.par-code no-undo.
        9   define output parameter p-zone      as character no-undo.
       10   define output parameter p-FromDate  as date no-undo.
       11   define output parameter p-ToDate    as date no-undo.
       12   define output parameter p-range     like ub.wth-parts.fact-rangeFrom  no-undo.
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: wthidnt.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: str/wthidnt.p $":U .
       18   define variable vss-description as character no-undo init "Процедура идентификации топливных талонов".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37       assign
       38         p-vss-parameters = substitute('&1|&2',p-bar-code,p-zone)
       39       .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   define buffer   buf_wth-ser    for ub.wth-ser.
       92   define buffer   buf_wth-parts  for ub.wth-parts.
       93   define buffer   buf_wth-gds    for wth-gds.
       94   define variable v-beg-yy    as character    no-undo.
       95   define variable v-beg-mm    as character    no-undo.
       96   define variable v-beg-dd    as character    no-undo.
       97   define variable v-end-yy    as character    no-undo.
       98   define variable v-end-mm    as character    no-undo.
       99   define variable v-end-dd    as character    no-undo.
      100   define variable v-isser     as logical      no-undo.
      101   Main-Block: do
      102   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      103   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      104   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      105   :
      106     if p-bar-code > '' then.
      107     else return error "Не задан параметр штрих-код!".
      108     for each buf_wth-ser  where buf_wth-ser.stts = 0
      109     no-lock on error undo, return error:
      110       if buf_wth-ser.chk-ser <> 0 then do:
      111         if substring(p-bar-code,int(buf_wth-ser.ser-rule),length(buf_wth-ser.ser-smb)) <> buf_wth-ser.ser-smb
      112         then next.
      113       end.
      114       if buf_wth-ser.chk-gds = 1 then do:
      115         if substring(p-bar-code,int(buf_wth-ser.gds-rule),length(buf_wth-ser.gds-smb)) <> buf_wth-ser.gds-smb
      116         then next.
      117       end.
      118       if buf_wth-ser.chk-par = 1 then do:
      119         if substring(p-bar-code,int(buf_wth-ser.par-rule),length(buf_wth-ser.par-smb)) <> buf_wth-ser.par-smb
      120         then next.
      121       end.
      122       p-range = int(substring(p-bar-code,int(buf_wth-ser.range-rule),int(buf_wth-ser.range-smb) - int(buf_wth-ser.range-rule) + 1)) no-error.
      123       if p-range = ? then next.
      124       if buf_wth-ser.chk-bdt = 1  then do:
      125         v-beg-yy = substring(p-bar-code,int(buf_wth-ser.beg-yy),length(buf_wth-ser.beg-yy-smb)) no-error.
      126         v-beg-mm = substring(p-bar-code,int(buf_wth-ser.beg-mm),2) no-error.
      127         v-beg-dd = substring(p-bar-code,int(buf_wth-ser.beg-dd),2) no-error.
      128         p-FromDate = date(substitute("&1/&2/&3":U,v-beg-dd,v-beg-mm,v-beg-yy)) no-error.
      129         if p-FromDate = ? then next.
      130       end.
      131       if buf_wth-ser.chk-bdt = 2  then do:
      132         p-FromDate = buf_wth-ser.beg-dt.
      133       end.
      134       if buf_wth-ser.chk-edt = 1  then do:
      135         v-end-yy = substring(p-bar-code,int(buf_wth-ser.end-yy),length(buf_wth-ser.end-yy-smb)) no-error.
      136         v-end-mm = substring(p-bar-code,int(buf_wth-ser.end-mm),2) no-error.
      137         v-end-dd = substring(p-bar-code,int(buf_wth-ser.end-dd),2) no-error.
      138         p-FromDate = date(substitute("&1/&2/&3":U,v-end-dd,v-end-mm,v-end-yy)) no-error.
      139         if p-ToDate = ? then next.
      140       end.
      141       if buf_wth-ser.chk-edt = 2  then do:
      142         p-ToDate = buf_wth-ser.end-dt.
      143       end.
      144       assign p-ser-code = buf_wth-ser.ser-code
      145              p-db-num   = buf_wth-ser.db-num
      146              p-stts     = buf_wth-ser.stts
      147              p-wth-code = buf_wth-ser.wth-code
      148              p-par-code = buf_wth-ser.par-code
      149              v-isser = yes.
      150              leave.
      151     end.
      152     if not v-isser then return error substitute("Штрих-код &1 не удалось идентифицировать.",p-bar-code).
      153     for each buf_wth-gds no-lock
      154       where buf_wth-gds.wth-code = p-wth-code
      155         and buf_wth-gds.stts = 0
      156     :
      157       p-gds-code = p-gds-code + (if p-gds-code > '':U then ',':U else '':U) + string(buf_wth-gds.gds-code).
      158     end.
      159     find first buf_wth-parts no-lock
      160     where  buf_wth-parts.ser-code = p-ser-code
      161        and buf_wth-parts.db-num   = p-db-num
      162        and buf_wth-parts.wth-code = p-wth-code
      163        and buf_wth-parts.par-code = p-par-code
      164        and buf_wth-parts.fact-rangeFrom <= p-range
      165        and buf_wth-parts.fact-rangeTo >= p-range
      166        and (buf_wth-parts.out-code = 'free-zone':U or
      167             buf_wth-parts.out-code = 'cli-zone':U  or
      168             buf_wth-parts.out-code = 'put-zone':U  or
      169             buf_wth-parts.out-code = 'out-zone':U  )
      170     no-error.
      171     if available buf_wth-parts then do:
      172       assign
      173           p-zone = buf_wth-parts.out-code
      174       .
      175       if buf_wth-parts.beg-dt <> ?  then p-FromDate = buf_wth-parts.beg-dt.
      176       if buf_wth-parts.end-dt <> ?  then p-ToDate = buf_wth-parts.end-dt.
      177     end.
      178   end.
