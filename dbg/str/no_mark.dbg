      409   procedure thobjs :
      410      define input        parameter parparentproc     as widget-handle no-undo .
      411      define input        parameter i-bttns           as character     no-undo .
      412      define input        parameter i-list-mode       as character     no-undo.
      413      define input        parameter i-obj-type        as character     no-undo.
      414      define input        parameter i-db-num          as integer       no-undo.
      415      define input        parameter i-host-code       as integer       no-undo.
      416      define input-output parameter p-rid-list        as character     no-undo .
      417   run ref/thobjs.p
      418           ( input parparentproc
      419            ,input  this-procedure :handle
      420           , input i-bttns
      421           , input i-list-mode
