      662   define  stream PrnLibStream.
      663   procedure prn-lib-prn-file :
      664     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      665     define input parameter p-DIsabledoptions as integer no-undo .
      666     define variable v-report-name as character no-undo .
      667     define variable v-user-action as character no-undo .
      668     define variable v-printed     as logical   no-undo .
      669     define variable v-exist       as logical   no-undo .
      670     do
      671       on error undo, return error
      672       :
      673       run prn-lib-get-report-name  in this-procedure (
      674         input parParentProc
      675         ,output v-report-name
      676         ).
      677   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      679     (input  v-report-name
      680     ,input  2
      681     ,output v-exist
      682     )  .
      683       if NOT v-exist then
      684       DO:
      685         Message
      686           "Нет заданий на печать ! "
      687           view-as alert-box .
      688         Return  .
      689       End.
      690       run gbl/prnfilen.w
      691         (input  ""
      692         ,input  p-DisabledOptions
      693         ,input  string(v-report-name )
      694         ,input  7
      695         ,output v-user-action
      696         ,output v-printed
      697         ) .
      698       if v-printed then
      699       do:
      700         return "YES" .
      701       end.
      702       else
      703       do:
      704         return "NO" .
      705       end.
      706     end.
      707   end procedure.
      708   procedure prn-lib-open-stream :
      709     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      710     define input parameter p-page-size    as integer no-undo .
      711     define input parameter p-is-stream    as logical no-undo .
      712     define input parameter p-append       as logical no-undo .
      713     define variable v-report-name as character no-undo .
      714     do
      715       on error undo, return error
      716       :
      717       run prn-lib-get-report-name  in this-procedure (
      718         input parParentProc
      719         ,output v-report-name
      720         ).
      721       if p-is-stream then
      722       do:
      723         if p-append then
      724         do:
      725           output stream PrnLibStream to value( v-report-name )
      726             page-size value(p-page-size) append .
      727         end.
      728         if not p-append then
      729         do:
      730           output stream PrnLibStream to value( v-report-name )
      731             page-size value(p-page-size) .
      732         end.
      733       end.
      734       if not p-is-stream then
      735       do:
      736         if p-append then
      737         do:
      738           output to value( v-report-name )
      739             page-size value(p-page-size) append .
      740         end.
      741         if not p-append then
      742         do:
      743           output to value( v-report-name )
      744             page-size value(p-page-size) .
      745         end.
      746       end.
      747     end.
      748   end procedure.
      749   procedure prn-lib-open-exp :
      750     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      751     define input parameter p-is-stream    as logical no-undo .
      752     define input parameter p-is-append    as logical no-undo .
      753     define output parameter p-ReportFileName as char init "report" no-undo.
      754     define output parameter p-process as logical no-undo .
      755     define variable glog as logical no-undo .
      756     do
      757       on error undo, return error
      758       :
      759       SYSTEM-DIALOG GET-FILE p-ReportFileName
      760         TITLE      "Укажите путь"
      761         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      762         ASK-OVERWRITE
      763         CREATE-TEST-FILE
      764         SAVE-AS
      765         USE-FILENAME
      766         DEFAULT-EXTENSION "txt"
      767         UPDATE glog
      768         .
      769       if not glog then  return.
      770       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      771       if p-is-stream then
      772       do:
      773         if p-is-append then
      774         do:
      775           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      776         end.
      777         else
      778         do:
      779           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      780         end.
      781       end.
      782       else
      783       do:
      784         if p-is-append then
      785         do:
      786           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      787         end.
      788         else
      789         do:
      790           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      791         end.
      792       end.
      793       p-process = yes.
      794     end.
      795   end procedure.
      796   procedure prn-lib-get-report-name :
      797     define input parameter parParentProc  as widget-handle no-undo.
      798     define output parameter p-report-name as character no-undo .
      799     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      800   end procedure.
      801   procedure prn-lib-reportviewer-report-name :
      802     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      803     define input parameter p-report-name-html as character no-undo .
      804     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      805   end procedure.
      806   procedure prn-lib-reportviewer :
      807     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      808     define input parameter p-report-name-html as character no-undo .
      809     define input parameter p-param        as character no-undo .
      810     define variable v-excel           as character no-undo init 'TRUE' .
      811     define variable v-value-character as character no-undo .
      812     define variable v-value-integer   as character no-undo .
      813     define variable v-value-date      as date      no-undo .
      814     define variable v-value-decimal   as decimal   no-undo .
      815     define variable rep-excel         as logical   no-undo .
      816     define variable excel-string      as character no-undo .
      817     define variable v-param-type      as character no-undo .
      818     define variable v-tth             as handle    no-undo .
      819     run adm/shattri.p (
      820       input "get":U
      821       ,input  ""
      822       ,input  0
      823       ,input  'report-glob':U
      824       ,input  'rep-excel':U
      825       ,output v-value-character
      826       ,output v-value-date
      827       ,output v-value-decimal
      828       ,output v-value-integer
      829       ,output rep-excel
      830       ,output v-param-type
      831       ,INPUT-OUTPUT table-handle v-tth
      832       )  .
      833     if rep-excel then v-excel = "TRUE" .
      834     else v-excel = "FALSE" .
      835     if p-param eq ""
      836     then
      837        p-param = "EXCEL:" + v-excel.
      838     else
      839        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      840     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      841   end procedure.
      842   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   define variable v-waitfram-action01         as character   no-undo .
      844   define variable v-waitfram-action02         as character   no-undo .
      845   define variable v-waitfram-action03         as character   no-undo .
      846   define variable mWaitFramTextBeg            as character   no-undo.
      847   define variable mWaitFramTextEnd            as character   no-undo.
      848   define variable mWaitFramView               as logical     no-undo.
      849   define variable mWaitProcEvent              as logical     no-undo init yes.
      850   define variable mWaitFramInterval           as integer     no-undo init 1 .
      851   define variable mWaitFramStop               as logical     no-undo.
      852   define variable mWaitFramStopUser           as logical     no-undo.
      853   define variable mWaitFramStopTimeOut        as logical     no-undo.
      854   define variable mWaitFramStartProc          as datetime-tz no-undo.
      855   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      856   define button B-WaitFramStop auto-end-key
      857        label "Стоп"
      858        size 10 by 1 tooltip "Остоновить процесс".
      859   define button B-viewProcInfo
      860        label "Информация"
      861        size 15 by 1 tooltip "Информация о процесс".
      862   define frame waitfram
      863     v-waitfram-action01 format "x(72)" no-label skip
      864     v-waitfram-action02 format "x(72)" no-label skip
      865     v-waitfram-action03 format "x(72)" no-label skip
      866     B-viewProcInfo
      867     B-WaitFramStop at row 4 col 30
      868     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      869     .
      870   define new global shared variable mBatchMode as logical no-undo init ?.
      871   define variable mFramBachModHandle as handle no-undo.
      872   mFramBachModHandle = frame waitfram:handle.
      873   define variable mFameOldVis as logical no-undo.
      874   define variable mVisCUrentVin as logical no-undo.
      875   if session:batch-mode
      876   then
      877      mBatchMode = yes.
      878   if mBatchMode = ? then do:
      879     mVisCUrentVin = current-window:visible.
      880     mFameOldVis = mFramBachModHandle:visible.
      881     mFramBachModHandle:visible  = yes.
      882     mBatchMode = mFramBachModHandle:visible ne yes.
      883     mFramBachModHandle:visible = mFameOldVis.
      884     current-window:visible = mVisCUrentVin.
      885   end.
      886    if  log-manager:logfile-name ne ?
      887     then DO:
      888         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      889         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      890         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      891     end.
      892   on choose of B-WaitFramStop in frame waitfram
      893   do:
      894     mWaitFramStop = yes.
      895     mWaitFramStopUser = yes.
      896   end.
      897   function waitfram-check-timeout returns logical():
      898      define variable vtime as int64 no-undo.
      899      if mWaitFramStopTimeOut
      900      then
      901         return yes.
      902      vtime = ( now - mWaitFramStartProc ) / 1000 .
      903      if     mWaitFramTimeOut ne ?
      904         and mWaitFramTimeOut ne 0
      905         and mWaitFramTimeOut lt vtime
      906      then do:
      907         mWaitFramStopTimeOut = yes.
      908      end.
      909      return mWaitFramStopTimeOut.
      910   end.
      911   procedure waitfram-hide :
      912     if not session:batch-mode
      913     then do
      914     on error undo, return error return-value
      915     :
      916       pause 0 before-hide .
      917       if not mBatchMode then
      918         hide frame waitfram .
      919     if     not mWaitFramView
      920        and mWaitProcEvent
      921     then
      922       process events .
      923     end.
      924   end procedure.
      925   procedure waitfram-show :
      926     define input  parameter p-message as character no-undo .
      927     define variable v-left-margin as integer   no-undo .
      928     if not session:batch-mode
      929     then do
      930     on error undo, return error return-value
      931     :
      932       if length(p-message) <= 70 then do:
      933         assign
      934           v-left-margin = integer((70 - length(p-message)) / 2)
      935         .
      936         assign
      937           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      938         .
      939         assign
      940           v-waitfram-action01 = " "
      941           v-waitfram-action02 = " "
      942                                    + fill(" ", v-left-margin)
      943                                    + p-message
      944           v-waitfram-action03 = " "
      945         .
      946       end.
      947       else do:
      948         define variable vRindex1 as integer no-undo.
      949         define variable vRindex2 as integer no-undo.
      950         vRindex1 = r-index(p-message," ",70).
      951         if vRindex1 = 0
      952         then
      953            vRindex1 = 70.
      954         if length(p-message)  <= vRindex1 + 70 then do:
      955           assign
      956             v-waitfram-action01 = " "
      957             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      958             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      959           .
      960         end.
      961         else do:
      962           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      963           if vRindex2 <= vRindex1
      964           then
      965              vRindex2 = vRindex1 + 70.
      966           assign
      967             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      968             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      969             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      970           .
      971         end.
      972       end.
      973       B-viewProcInfo:visible   in frame waitfram = no.
      974       B-viewProcInfo:sensitive in frame waitfram = no.
      975       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      976       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      977       if  (   mWaitFramView
      978          or  mWaitProcEvent)
      979          and not mBatchMode
      980       then
      981          display
      982             v-waitfram-action01 skip
      983             v-waitfram-action02 skip
      984             v-waitfram-action03 skip
      985          with frame waitfram .
      986       if     mWaitFramView
      987          then do:
      988             if     mWaitFramInterval ne ?
      989                and not mBatchMode
      990             then
      991                wait-for go of frame waitfram pause mWaitFramInterval.
      992          end.
      993          else
      994             if     mWaitProcEvent
      995                and not mBatchMode
      996             then
      997                process events .
      998     end.
      999   end procedure.
     1000      procedure waitfram-show-this:
     1001         define input  parameter iInterval as int64 no-undo.
     1002         define variable vtime as int64 no-undo.
     1003         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1004         mWaitFramInterval = iInterval.
     1005         run waitfram-show (substitute("&1&2 &3&4" ,
     1006                                       mWaitFramTextBeg ,
     1007                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1008                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1009                                       mWaitFramTextEnd
     1010                                      )
     1011                           ).
     1012      end.
     1013      procedure WaitFramRunPause:
     1014         define input  parameter iInterval as dec no-undo.
     1015         define variable vStart  as datetime-tz no-undo.
     1016         define variable vend    as datetime-tz no-undo.
     1017         define variable vint as int64 no-undo.
     1018         define variable vOk as logical no-undo.
     1019         vStart = now.
     1020         vend   = vStart.
     1021         publish "WaitFramPause" (iInterval,output vOk).
     1022         vend   =  now.
     1023         vint = vend - vStart.
     1024         vint = iInterval - vint / 1000.
     1025         if     not mWaitFramStop
     1026            and (   vint > 0
     1027                 or (    not vOk
     1028                     and iInterval eq ?
     1029                     )
     1030                 )
     1031         then
     1032            run waitfram-show-this (iInterval).
     1033         vend   =  now.
     1034         vint = vend - vStart.
     1035         vint = iInterval - vint / 1000.
     1036         if     not mWaitFramStop
     1037            and vint > 0
     1038         then do:
     1039            run gbl/pause.p (vint * 1000).
     1040         end.
     1041         if iInterval ne ?
     1042         then
     1043            publish "WaitFramStop".
     1044         waitfram-check-timeout().
     1045      end.
     1046      procedure WaitFramWaitFor:
     1047         define input  parameter iInterval as dec no-undo.
     1048         assign
     1049            mWaitFramStartProc   = now
     1050            mWaitFramStopUser    = no
     1051            mWaitFramStopTimeOut = no
     1052         .
     1053         block-wait:
     1054         do while not mWaitFramStop:
     1055            run WaitFramRunPause (iInterval).
     1056            if  waitfram-check-timeout()
     1057            then do:
     1058               leave block-wait.
     1059            end.
     1060         end.
     1061         run waitfram-hide.
     1062      end.
     1063   procedure waitfram-join :
     1064     define input  parameter p-line-1  as character no-undo .
     1065     define input  parameter p-line-2  as character no-undo .
     1066     define input  parameter p-line-3  as character no-undo .
     1067     define output parameter p-message as character no-undo .
     1068     do
     1069     on error undo, return error return-value
     1070     :
     1071       assign
     1072         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1073                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1074                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1075       .
     1076     end.
     1077   end procedure.
     1078   function waitfram-join-function returns character
     1079     (input p-line-1 as character
     1080     ,input p-line-2 as character
     1081     ,input p-line-3 as character
     1082     ).
     1083     define variable v-message as character no-undo .
     1084     run waitfram-join in this-procedure
     1085       (input  p-line-1
     1086       ,input  p-line-2
     1087       ,input  p-line-3
     1088       ,output v-message
     1089       ) .
     1090     return v-message .
     1091   end function .
     1092   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   FUNCTION mark-string RETURNS CHARACTER
     1094     ( input p-recid as recid, input mark-list as character  ) :
     1095     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1096   END FUNCTION.
     1097   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
