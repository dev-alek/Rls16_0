      427   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   procedure cur-time :
      429      define output parameter p-today as date      no-undo .
      430      define output parameter p-time  as integer   no-undo .
      431     do
      432     on error undo, return error
      433     :
      434       define variable v-date1 as date      no-undo .
      435       define variable v-date2 as date      no-undo .
      436       define variable v-time  as integer   no-undo .
      437       assign
      438         v-date1 = today
      439         v-time  = time
      440         v-date2 = today
      441       .
      442       if v-date1 <> v-date2
      443       then do:
      444         assign
      445           v-date1 = today
      446           v-time  = v-time
      447         .
      448       end.
      449       assign
      450         p-today = v-date1
      451         p-time  = v-time
      452       .
      453     end.
      454   end.
      455   function cur-time-date returns character
      456   :
      457     return string(today, '99/99/9999':U) .
      458   end.
      459   function cur-time-mjd returns decimal
      460   :
      461     define variable v-date as date      no-undo .
      462     define variable v-time as integer   no-undo .
      463     run cur-time in this-procedure
      464       (output v-date
      465       ,output v-time
      466       ) .
      467     return integer(v-date) - 2400002 + (v-time / 86400) .
      468   end.
      469   function cur-time-get-ending-index returns integer
      470   (input p-number as integer
      471   )
      472   :
      473     if p-number < 0
      474     or p-number = ?
      475     then do:
      476       return 1 .
      477     end.
      478     define variable v-rest as integer   no-undo .
      479     assign
      480       p-number = p-number modulo 100
      481     .
      482     if p-number < 20
      483     then do:
      484       assign
      485         v-rest = p-number
      486       .
      487     end.
      488     else do:
      489       assign
      490         v-rest = p-number modulo 10
      491       .
      492     end.
      493     case v-rest :
      494       when 1
      495       then do:
      496         return 2 .
      497       end.
      498       when 2 or
      499       when 3 or
      500       when 4
      501       then do:
      502         return 3 .
      503       end.
      504       otherwise do:
      505         return 1 .
      506       end.
      507     end case .
      508   end.
      509   procedure cur-time-mjd-to-date :
      510      define input  parameter i-mjd-diff as decimal no-undo.
      511      define output parameter o-Date     as date    no-undo.
      512      define output parameter o-Time     as integer no-undo.
      513      define variable v-day-number as integer   no-undo .
      514      if    i-mjd-diff < 0
      515         or i-mjd-diff = ?
      516      then do:
      517         return "?" .
      518      end.
      519      assign
      520         v-day-number = truncate(i-mjd-diff,0).
      521         o-Date = date(v-day-number + 2400002).
      522         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      523     .
      524   end.
      525   function cur-time-mjd-to-string returns character
      526   (input p-mjd-diff as decimal
      527   )
      528   :
      529     define variable v-day-number as integer   no-undo .
      530     define variable v-seconds    as integer   no-undo .
      531     define variable v-hour       as integer   no-undo .
      532     define variable v-min        as integer   no-undo .
      533     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      534     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      535     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      536     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      537     if p-mjd-diff < 0
      538     or p-mjd-diff = ?
      539     then do:
      540       return "?" .
      541     end.
      542     assign
      543       v-day-number = integer(truncate(p-mjd-diff,0))
      544       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      545     .
      546     if v-seconds > 86400
      547     then do:
      548       assign
      549         v-seconds = 86400 - 1
      550       .
      551     end.
      552     if v-seconds < 0
      553     then do:
      554       assign
      555         v-seconds = 0
      556       .
      557     end.
      558     assign
      559       v-hour = truncate(v-seconds / 3600, 0)
      560     .
      561     assign
      562       v-seconds = v-seconds modulo 3600
      563     .
      564     assign
      565       v-min = truncate(v-seconds / 60, 0)
      566     .
      567     assign
      568       v-seconds = v-seconds modulo 60
      569     .
      570     return
      571         (if v-day-number <> 0
      572           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      573           else ""
      574         )
      575       + (if v-day-number <> 0 or v-hour <> 0
      576           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      577           else ""
      578         )
      579       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      580           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      581           else ""
      582         )
      583       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      584       .
      585   end.
      586   function cur-time-string returns character
      587   :
      588     define variable v-date as date      no-undo .
      589     define variable v-time as integer   no-undo .
      590     run cur-time in this-procedure
      591       (output v-date
      592       ,output v-time
      593       ) .
      594     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      595   end.
      596   function cur-time-string-sec returns character
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      605   end.
      606   function cur-time-custom  returns character
      607   (input p-prefix as character
      608   ,input p-date-format as character
      609   ,input p-delimiter as character
      610   ,input p-time-format as character
      611   ,input p-suffix as character
      612   )
      613   :
      614     define variable v-date as date      no-undo .
      615     define variable v-time as integer   no-undo .
      616     run cur-time in this-procedure
      617       (output v-date
      618       ,output v-time
      619       ) .
      620     return
      621       p-prefix
      622       + string(v-date, p-date-format)
      623       + p-delimiter
      624       + string(v-time, p-time-format)
      625       + p-suffix
      626       .
      627   end.
      628   function cur-time-print  returns character
      629   :
      630     define variable v-date as date      no-undo .
      631     define variable v-time as integer   no-undo .
      632     run cur-time in this-procedure
      633       (output v-date
      634       ,output v-time
      635       ) .
      636     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      637   end.
      638   function cur-time-datetime returns datetime
      639   :
      640     define variable v-char as character no-undo .
      641     define variable v-datetime as datetime no-undo .
      642     v-char = cur-time-string().
      643     v-datetime = datetime(v-char).
      644     return  v-datetime.
      645   end.
      646   function cur-time-string-msec returns character
      647   :
      648     define variable v-date as datetime  no-undo .
      649     v-date = now.
      650     return string(v-date) .
      651   end.
