      145   procedure vss-get-parameters :
      146     define output parameter p-vss-parameters as character no-undo .
      147   end procedure.
      148   define new global shared variable g#vssrevis-logger as handle    no-undo .
      149   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      150   define variable v-vssrevis-logger                   as handle    no-undo .
      151   procedure vss-logevent :
      152     define input  parameter p-extra-paramters as character no-undo .
      153     define variable v-vssrevis-parameters as character no-undo .
      154     do
      155     on error undo, return error return-value
      156     :
      157       if  valid-handle(v-vssrevis-logger)
      158       and v-vssrevis-logger :get-signature("logevent") <> ""
      159       then do:
      160         run vss-get-parameters in this-procedure
      161           (output v-vssrevis-parameters
      162           ).
      163         run logevent in v-vssrevis-logger
      164           (input vss-workfile
      165           ,input vss-revision
      166           ,input v-vssrevis-parameters
      167           ,input p-extra-paramters
      168           ).
      169       end.
      170     end.
      171   end procedure.
      172   assign
      173     v-vssrevis-logger = g#vssrevis-logger
      174   .
      175   if  valid-handle(v-vssrevis-logger)
      176   and v-vssrevis-logger :get-signature("logevent") <> ""
      177   then do:
      178     assign
      179       v-vssrevis-logevent = true
      180     .
      181     run vss-logevent in this-procedure (input vss-description) .
      182   end.
      183   define new global shared variable g#language as character no-undo .
      184   if g#language <> '' and g#language <> 'rus':U then do:
      185     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      186   end.
      187   define new global shared variable g#library  as handle no-undo .
      188   define new global shared variable g#library2 as handle no-undo .
      189   procedure proc-alt-shift-f2:
      190     if not ibs.th.gbl.gbl-var:rcode
      191   then
      192     run gbl\inidebug.p .
      193   end.
      194   procedure proc-alt-shift-f3:
      195     run gbl/prvssinf.p
      196       ( input this-procedure
      197       ) .
      198   end.
      199   define variable v-inform-launched as logical no-undo initial false .
      200   procedure proc-alt-shift-f4:
      201     define variable v-action as character no-undo .
      202     if v-inform-launched = false then do:
      203       assign
      204         v-inform-launched = true
      205       .
      206       run gbl/d-inform.w
      207         (  input self
      208         ,  input this-procedure
      209         , output v-action
      210         ) no-error .
      211       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      212       assign
      213         v-inform-launched = false
      214       .
      215     end.
      216   end.
      217   procedure proc-alt-f1:
      218     run gbl/corrhelp.p
      219       (input this-procedure
      220       ) .
      221   end .
      222   on alt-shift-f2 anywhere do:
      223     run proc-alt-shift-f2.
      224   end.
      225   on alt-shift-f3 anywhere do:
      226     run proc-alt-shift-f3 in this-procedure .
      227   end.
      228   on alt-shift-f4 anywhere do:
      229     run proc-alt-shift-f4 in this-procedure.
      230   end.
      231   on alt-f1 anywhere do:
      232     run proc-alt-f1 in this-procedure .
      233   end.
      234   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      236   define new shared variable RepPathName        as character no-undo .
      237   define new shared variable PrintRubl          as logical   no-undo .
