      239   define temp-table userobjs_temp-user-obj no-undo
      240     field obj-type as character
      241     field obj-code as integer
      242     index xpk is primary unique obj-type obj-code
      243     .
      244   procedure userobjs_clear :
      245     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      246     do
      247     on error undo, return error return-value
      248     :
      249       for each buf_userobjs_temp-user-obj
      250       on error undo, return error return-value
      251       :
      252         delete buf_userobjs_temp-user-obj .
      253       end.
      254     end.
      255   end .
      256   procedure userobjs_object-count :
      257     define output parameter p-total-count as integer   no-undo .
      258     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      259     do
      260     on error undo, return error return-value
      261     :
      262       assign
      263         p-total-count = 0
      264       .
      265       for each buf_userobjs_temp-user-obj
      266       on error undo, return error return-value
      267       :
      268         assign
      269           p-total-count = p-total-count + 1
      270         .
      271       end.
      272     end.
      273   end.
      274   procedure userobjs_append :
      275      define input  parameter p-obj-type as character no-undo .
      276      define input  parameter p-obj-code as integer   no-undo .
      277     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      278     do
      279     on error undo, return error return-value
      280     :
      281       find first buf_userobjs_temp-user-obj
      282         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      283           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      284         no-error .
      285       if not available buf_userobjs_temp-user-obj
      286       then do:
      287         create buf_userobjs_temp-user-obj .
      288         assign
      289           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      290           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      291         .
      292       end.
      293     end.
      294   end.
      295   procedure userobjs_object-exist :
      296     define output parameter p-object-exist as logical   no-undo .
      297     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      298     do
      299     on error undo, return error return-value
      300     :
      301       find first buf_userobjs_temp-user-obj
      302         no-error .
      303       if not available buf_userobjs_temp-user-obj
      304       then do:
      305         assign
      306           p-object-exist = false
      307         .
      308       end.
      309       else do:
      310         assign
      311           p-object-exist = true
      312         .
      313       end.
      314     end.
      315   end.
      316   procedure userobjs_transfer :
      317     define input  parameter p-callback-handle as handle no-undo .
      318     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      319     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      320     do
      321     on error undo, return error return-value
      322     :
      323       if valid-handle(p-callback-handle) <> true
      324       then do:
      325         message
      326           vss-workfile vss-revision vss-description skip
      327           "Ошибка задания входных параметров" skip
      328           "Неизвестный указатель на процедуру" skip
      329           view-as alert-box error .
      330         undo, return error return-value .
      331       end.
      332       if p-callback-handle :get-signature("userobjs_append") = ""
      333       then do:
      334         message
      335           vss-workfile vss-revision vss-description skip
      336           "Ошибка задания входных параметров" skip
      337           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      338                     ,p-callback-handle :file-name
      339                     ) skip
      340           view-as alert-box error .
      341         undo, return error return-value .
      342       end.
      343       for each buf_userobjs_temp-user-obj
      344       on error undo, return error return-value
      345       :
      346         run userobjs_append in p-callback-handle
      347           (input  buf_userobjs_temp-user-obj.obj-type
      348           ,input  buf_userobjs_temp-user-obj.obj-code
      349           ) .
      350       end.
      351     end.
      352   end procedure.
      353   procedure userobjs_select-one :
      354      define input  parameter parparentproc     as widget-handle no-undo .
      355      define input  parameter p-db-num          as integer   no-undo .
      356      define input  parameter p-user-id         as character no-undo .
      357      define input  parameter p-host-code-obj   as integer   no-undo .
      358      define input  parameter p-obj-type        as character no-undo .
