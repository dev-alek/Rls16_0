      129   procedure vss-get-info :
      130     define output parameter p-vss-revision    like vss-revision    no-undo .
      131     define output parameter p-vss-author      like vss-author      no-undo .
      132     define output parameter p-vss-date        like vss-date        no-undo .
      133     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      134     define output parameter p-vss-archive     like vss-archive     no-undo .
