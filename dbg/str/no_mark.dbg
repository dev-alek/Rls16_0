     1115   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   procedure gen-key-rec :
     1117     define input  parameter p-tbl-name    as character no-undo.
     1118     define input  parameter p-bh_tbl-name as handle    no-undo.
     1119     define output parameter p-key-rec     as character no-undo.
     1120     do
     1121     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1122     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1123     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1124     :
     1125       define variable fh               as handle    no-undo .
     1126       define variable v-ok             as logical   no-undo .
     1127       define variable v-inform         as character no-undo .
     1128       define variable v-ind            as integer   no-undo .
     1129       define variable v-idx-field-qnty as integer   no-undo .
     1130       if p-tbl-name = ?
     1131         or p-tbl-name = "":U
     1132       then do:
     1133         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
     1134       end.
     1135       if not p-bh_tbl-name:available then do:
     1136         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
     1137       end.
     1138       assign
     1139         p-key-rec = p-tbl-name
     1140         v-inform  = p-bh_tbl-name:index-information(1)
     1141         v-ind     = 2
     1142       .
     1143       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1144       on error undo, return error
     1145       :
     1146         assign
     1147           v-inform = p-bh_tbl-name:index-information( v-ind )
     1148           v-ind    = v-ind + 1
     1149         .
     1150       end.
     1151       if v-inform = ?
     1152         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1153         or entry( 3, v-inform, ",":U ) <> "1":U
     1154       then do:
     1155         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
     1156       end.
     1157       else do:
     1158         assign
     1159           v-idx-field-qnty = num-entries( v-inform ) - 4
     1160         .
     1161         if v-idx-field-qnty < 2 then do:
     1162           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
     1163         end.
     1164         do v-ind = 1 to v-idx-field-qnty by 2
     1165         on error undo, return error
     1166         :
     1167           assign
     1168             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1169             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1170           .
     1171         end.
     1172       end.
     1173       if p-key-rec = ? then do:
     1174         assign
     1175           p-key-rec = "":U
     1176         .
     1177         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
     1178       end.
     1179     end.
     1180     return.
     1181   end procedure.
     1182   procedure gen-where-keyr-tab :
     1183     define input  parameter i-tableSerach as character no-undo.
     1184     define input  parameter i-tablekey   as character  no-undo.
     1185     define input  parameter p-key-rec    as character  no-undo.
     1186     define input  parameter p-key-handle as handle     no-undo .
     1187     define input  parameter p-db-name    as character  no-undo .
     1188     define input  parameter p-tt-handle  as handle     no-undo .
     1189     define output parameter o-Where      as character  no-undo.
     1190     do
     1191     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1192     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1193     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1194     :
     1195       define variable v-full-tbl-name  as character no-undo .
     1196       define variable bh_tbl-name      as handle    no-undo .
     1197       define variable fh_key           as handle    no-undo .
     1198       define variable fh_search        as handle    no-undo .
     1199       define variable v-field-num      as integer   no-undo .
     1200       define variable v-count-fld      as integer   no-undo .
     1201       define variable v-inform         as character no-undo .
     1202       define variable v-ind            as integer   no-undo .
     1203       define variable v-idx-field-qnty as integer   no-undo .
     1204       define variable v-field-name     as character no-undo .
     1205       define variable v-field-val      as character no-undo .
     1206       define variable v-word-link      as character no-undo .
     1207       define variable vTable           as character no-undo.
     1208       define variable bh_tbl-key       as handle    no-undo .
     1209       assign
     1210         p-key-rec = trim( p-key-rec )
     1211       .
     1212       if p-key-handle <> ? then do:
     1213         if not valid-handle(p-key-handle)
     1214            or p-key-handle:type <> "buffer"
     1215         then do:
     1216           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
     1217         end.
     1218         if num-entries( p-key-rec, chr(3) ) > 1
     1219           or p-key-rec = ?
     1220           or p-key-rec = "":U
     1221         then do:
     1222           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
     1223         end.
     1224       end.
     1225       else do:
     1226         if p-key-rec = ?
     1227           or p-key-rec = "":U
     1228         then do:
     1229           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1230         end.
     1231       end.
     1232       assign
     1233         vTable = entry( 1 , p-key-rec, chr(3) )
     1234       .
     1235       if p-tt-handle <> ?
     1236         and ( not valid-handle(p-tt-handle)
     1237               or p-tt-handle:type <> "buffer"
     1238             )
     1239       then do:
     1240         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
     1241       end.
     1242       if p-tt-handle = ? then do:
     1243         assign
     1244           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1245         .
     1246         create buffer bh_tbl-name for table v-full-tbl-name .
     1247       end.
     1248       else do:
     1249         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1250       end.
     1251       assign
     1252         v-inform = bh_tbl-name:index-information(1)
     1253         v-ind    = 2
     1254       .
     1255       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1256       on error undo, return error
     1257       :
     1258         assign
     1259           v-inform = bh_tbl-name:index-information( v-ind )
     1260           v-ind    = v-ind + 1
     1261         .
     1262       end.
     1263       if v-inform = ?
     1264         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1265         or entry( 3, v-inform, ",":U ) <> "1":U
     1266       then do:
     1267         delete object bh_tbl-name no-error.
     1268         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
     1269       end.
     1270       assign
     1271         v-idx-field-qnty = num-entries( v-inform ) - 4
     1272       .
     1273       if v-idx-field-qnty < 2 then do:
     1274         delete object bh_tbl-name no-error.
     1275         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
     1276       end.
     1277       assign
     1278         o-where     = "where":U
     1279         v-word-link = "":U
     1280         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1281         v-count-fld = 0
     1282       .
     1283       if i-tablekey ne "" and i-tablekey ne ?
     1284       then do:
     1285         assign
     1286           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1287         .
     1288         create buffer bh_tbl-key for table v-full-tbl-name .
     1289       end.
     1290       if i-tableSerach ne "" and i-tableSerach ne ?
     1291       then do:
     1292         delete object bh_tbl-name no-error.
     1293         assign
     1294           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1295         .
     1296         create buffer bh_tbl-name for table v-full-tbl-name .
     1297       end.
     1298       block_where:
     1299       do v-ind = 1 to v-idx-field-qnty by 2
     1300       on error undo, return error
     1301       :
     1302         assign
     1303           v-count-fld = v-count-fld + 1
     1304         .
     1305         if p-key-handle = ?
     1306           and v-count-fld > v-field-num
     1307         then do:
     1308           leave block_where.
     1309         end.
     1310         define variable VfieldKeyTable as handle no-undo.
     1311         assign
     1312           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1313           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1314         .
     1315         if     bh_tbl-key ne ?
     1316         then do:
     1317            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1318            if VfieldKeyTable eq ?
     1319            then next block_where.
     1320         end.
     1321         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1322         then
     1323            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1324         else
     1325            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1326         if p-key-handle = ? then do:
     1327           assign
     1328             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1329           .
     1330         end.
     1331         else do:
     1332           assign
     1333             fh_key = p-key-handle:buffer-field( v-field-name )
     1334           .
     1335           if fh_key = ?
     1336             or not valid-handle( fh_key )
     1337           then do:
     1338             delete object bh_tbl-name.
     1339             if     bh_tbl-key ne ?
     1340             then
     1341                delete object bh_tbl-key.
     1342             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
     1343           end.
     1344           assign
     1345             v-field-val = fh_key:buffer-value
     1346           .
     1347         end.
     1348         if fh_search:data-type ="character":U then do:
     1349           assign
     1350             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1351             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1352             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1353             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1354             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1355             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1356             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1357             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1358             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1359             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1360             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1361             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1362             v-field-val = substitute( '"&1"', v-field-val )
     1363           .
     1364         end.
     1365         assign
     1366           o-where = substitute( "&1 &2", o-where, v-field-val )
     1367         .
     1368         if v-word-link = "":U then do:
     1369           assign
     1370             v-word-link = "and":U
     1371           .
     1372         end.
     1373       end.
     1374       delete object bh_tbl-name.
     1375       if     bh_tbl-key ne ?
     1376       then
     1377          delete object bh_tbl-key.
     1378       if p-key-handle = ?
     1379         and v-count-fld <> v-field-num
     1380       then do:
     1381         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
     1382       end.
     1383     end.
     1384   end procedure.
     1385   procedure gen-hn-keyr-tab :
     1386     define input  parameter i-tableSerach as character no-undo.
     1387     define input  parameter i-tablekey   as character no-undo.
     1388     define input  parameter p-key-rec    as character no-undo.
     1389     define input  parameter p-key-handle as handle    no-undo .
     1390     define input  parameter p-db-name    as character no-undo .
     1391     define input  parameter p-tt-handle  as handle    no-undo .
     1392     define input  parameter p-stts-lock  as integer   no-undo .
     1393     define output parameter o-hn         as handle    no-undo.
     1394     define variable v-full-tbl-name as character no-undo.
     1395     define variable v-where         as character no-undo.
     1396     define variable bh_tbl-name     as handle    no-undo.
     1397     define variable vTable          as character no-undo.
     1398     do
     1399     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1400     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1401     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1402         run gen-where-keyr-tab(i-tableSerach,
     1403                                i-tablekey,
     1404                                p-key-rec,
     1405                                p-key-handle,
     1406                                p-db-name,
     1407                                p-tt-handle,
     1408                                output v-where).
     1409         if i-tableSerach ne "" and i-tableSerach ne ?
     1410         then do:
     1411            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1412            create buffer bh_tbl-name for table v-full-tbl-name .
     1413         end.
     1414         else do:
     1415            if p-tt-handle = ? then do:
     1416               assign
     1417                  vTable = entry( 1 , p-key-rec, chr(3) )
     1418               .
     1419               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1420               create buffer bh_tbl-name for table v-full-tbl-name .
     1421            end.
     1422            else do:
     1423               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1424            end.
     1425         end.
     1426         if p-tt-handle = ? then do:
     1427            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1428         end.
     1429         else do:
     1430            bh_tbl-name:find-first( v-where ) no-error .
     1431         end.
     1432         o-hn = bh_tbl-name.
     1433      end.
     1434   end procedure.
     1435   procedure gen-hn-keyr :
     1436     define input  parameter p-key-rec    as character no-undo.
     1437     define input  parameter p-key-handle as handle    no-undo .
     1438     define input  parameter p-db-name    as character no-undo .
     1439     define input  parameter p-tt-handle  as handle    no-undo .
     1440     define input  parameter p-stts-lock  as integer   no-undo .
     1441     define output parameter o-hn         as handle    no-undo.
     1442     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1443   end.
     1444   procedure gen-row-keyr :
     1445     define input  parameter p-key-rec    as character no-undo.
     1446     define input  parameter p-key-handle as handle    no-undo .
     1447     define input  parameter p-db-name    as character no-undo .
     1448     define input  parameter p-tt-handle  as handle    no-undo .
     1449     define input  parameter p-stts-lock  as integer   no-undo .
     1450     define output parameter p-tbl-row    as rowid     no-undo.
     1451     define output parameter p-tbl-name   as character no-undo.
     1452     define variable vHn as handle no-undo.
     1453       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1454       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1455       p-tbl-name =  vHn:table.
     1456       delete object vHn no-error.
     1457     if p-tbl-row = ? then do:
     1458       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
     1459     end.
     1460     else do:
     1461       return.
     1462     end.
     1463   end procedure.
     1464   procedure gen-key-fv :
     1465     define input  parameter p-key-rec    as character no-undo .
     1466     define output parameter p-field-list as character no-undo .
     1467     define output parameter p-value-list as character no-undo.
     1468     do
     1469     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1470     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1471     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1472     :
     1473       define variable v-full-tbl-name  as character no-undo .
     1474       define variable bh_tbl-name      as handle    no-undo .
     1475       define variable v-tbl-name       as character no-undo .
     1476       define variable v-field-num      as integer   no-undo .
     1477       define variable v-count-fld      as integer   no-undo .
     1478       define variable v-inform         as character no-undo .
     1479       define variable v-ind            as integer   no-undo .
     1480       define variable v-idx-field-qnty as integer   no-undo .
     1481       define variable v-delim-key      as character no-undo .
     1482       if p-key-rec = ?
     1483         or p-key-rec = "":U
     1484       then do:
     1485         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1486       end.
     1487       assign
     1488         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1489         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1490       .
     1491       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1492       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
     1493       assign
     1494         v-inform = bh_tbl-name:index-information(1)
     1495         v-ind    = 2
     1496       .
     1497       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1498       on error undo, return error
     1499       :
     1500         assign
     1501           v-inform = bh_tbl-name:index-information( v-ind )
     1502           v-ind    = v-ind + 1
     1503         .
     1504       end.
     1505       if v-inform = ?
     1506         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1507         or entry( 3, v-inform, ",":U ) <> "1":U
     1508       then do:
     1509         delete object bh_tbl-name no-error.
     1510         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1511       end.
     1512       assign
     1513         v-idx-field-qnty = num-entries( v-inform ) - 4
     1514       .
     1515       if v-idx-field-qnty < 2 then do:
     1516         delete object bh_tbl-name no-error.
     1517         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1518       end.
     1519       assign
     1520         p-field-list = "":U
     1521         p-value-list = "":U
     1522         v-delim-key  = "":U
     1523         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1524         v-count-fld  = 0
     1525       .
     1526       block_where:
     1527       do v-ind = 1 to v-idx-field-qnty by 2
     1528       on error undo, return error
     1529       :
     1530         assign
     1531           v-count-fld = v-count-fld + 1
     1532         .
     1533         if v-count-fld > v-field-num then do:
     1534           leave block_where.
     1535         end.
     1536         assign
     1537           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1538           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1539         .
     1540         if v-ind = 1 then do:
     1541           assign
     1542             v-delim-key = chr(3)
     1543           .
     1544         end.
     1545       end.
     1546       delete object bh_tbl-name.
     1547       if v-count-fld <> v-field-num then do:
     1548         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
     1549       end.
     1550     end.
     1551   end procedure.
     1552   procedure gen-key-field :
     1553     define input  parameter p-table      as character no-undo .
     1554     define output parameter p-field-list as character no-undo .
     1555     do
     1556     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1557     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1558     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1559     :
     1560       define variable v-full-tbl-name  as character no-undo .
     1561       define variable bh_tbl-name      as handle    no-undo .
     1562       define variable v-tbl-name       as character no-undo .
     1563       define variable v-field-num      as integer   no-undo .
     1564       define variable v-count-fld      as integer   no-undo .
     1565       define variable v-inform         as character no-undo .
     1566       define variable v-ind            as integer   no-undo .
     1567       define variable v-idx-field-qnty as integer   no-undo .
     1568       define variable v-delim-key      as character no-undo .
     1569       if p-table = ?
     1570         or p-table = "":U
     1571       then do:
     1572         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
     1573       end.
     1574       assign
     1575         v-tbl-name      = p-table
     1576         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1577       .
     1578       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1579       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
     1580       assign
     1581         v-inform = bh_tbl-name:index-information(1)
     1582         v-ind    = 2
     1583       .
     1584       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-inform = bh_tbl-name:index-information( v-ind )
     1589           v-ind    = v-ind + 1
     1590         .
     1591       end.
     1592       if v-inform = ?
     1593         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1594         or entry( 3, v-inform, ",":U ) <> "1":U
     1595       then do:
     1596         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1597       end.
     1598       assign
     1599         v-idx-field-qnty = num-entries( v-inform ) - 4
     1600       .
     1601       if v-idx-field-qnty < 2 then do:
     1602         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1603       end.
     1604       assign
     1605         p-field-list = "":U
     1606         v-delim-key  = "":U
     1607         v-count-fld  = 0
     1608       .
     1609       block_where:
     1610       do v-ind = 1 to v-idx-field-qnty by 2
     1611       on error undo, return error
     1612       :
     1613         assign
     1614           v-count-fld = v-count-fld + 1
     1615         .
     1616         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1617         if v-ind = 1 then do:
     1618           assign
     1619             v-delim-key = chr(3)
     1620           .
     1621         end.
     1622       end.
     1623       delete object bh_tbl-name.
     1624     end.
     1625   end procedure.
     1626   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1627   define variable vss-include-info11 as character format "X(65)" no-undo
     1628   initial "@(#)$Workfile$ $Revision$".
     1629   procedure xmlchar-test :
     1630   define input parameter p-in-string          as character        no-undo.
     1631   define output parameter p-out-string-enc    as character        no-undo.
     1632   define output parameter p-out-string-dec    as character        no-undo.
     1633   do
     1634   on error undo, return error
     1635   :
     1636          run xmlchar-encode in this-procedure
     1637       (
     1638             input p-in-string
     1639           , output p-out-string-enc
     1640       ).
     1641          run xmlchar-decode in this-procedure
     1642       (
     1643             input p-out-string-enc
     1644           , output p-out-string-dec
     1645       ).
     1646   end.
     1647   end .
     1648   procedure xmlchar-encode :
     1649   define input parameter p-in-string      as character        no-undo.
     1650   define output parameter p-out-string    as character        no-undo.
     1651       define variable v-position      as integer      no-undo.
     1652       define variable v-current-char  as character    no-undo.
     1653   do
     1654   on error undo, return error
     1655   :
     1656       assign
     1657           p-out-string = "":U
     1658       .
     1659       case p-in-string
     1660       :
     1661           when ?
     1662           then do:
     1663               assign
     1664                   p-out-string = "?":U
     1665               .
     1666           end.
     1667           when "?":U
     1668           then do:
     1669               assign
     1670                   p-out-string = "&#63;":U
     1671               .
     1672           end.
     1673           otherwise do:
     1674               do v-position = 1 to length( p-in-string )
     1675               :
     1676                   assign
     1677                       v-current-char = substring( p-in-string, v-position, 1 )
     1678                   .
     1679                   case v-current-char
     1680                   :
     1681                       when "&":U
     1682                       then do:
     1683                           assign
     1684                               p-out-string = p-out-string + "&amp;":U
     1685                           .
     1686                       end.
     1687                       when ">":U
     1688                       then do:
     1689                           assign
     1690                               p-out-string = p-out-string + "&gt;":U
     1691                           .
     1692                       end.
     1693                       when "<":U
     1694                       then do:
     1695                           assign
     1696                               p-out-string = p-out-string + "&lt;":U
     1697                           .
     1698                       end.
     1699                       when "'":U
     1700                       then do:
     1701                           assign
     1702                               p-out-string = p-out-string + "&apos;":U
     1703                           .
     1704                       end.
     1705                       when '"':U
     1706                       then do:
     1707                           assign
     1708                               p-out-string = p-out-string + "&quot;":U
     1709                           .
     1710                       end.
     1711                       when chr(1)
     1712                       then do:
     1713                           assign
     1714                               p-out-string = p-out-string + "":U
     1715                           .
     1716                       end.
     1717                       when chr(2)
     1718                       then do:
     1719                           assign
     1720                               p-out-string = p-out-string + "":U
     1721                           .
     1722                       end.
     1723                       when chr(3)
     1724                       then do:
     1725                           assign
     1726                               p-out-string = p-out-string + "":U
     1727                           .
     1728                       end.
     1729                       when chr(4)
     1730                       then do:
     1731                           assign
     1732                               p-out-string = p-out-string + "":U
     1733                           .
     1734                       end.
     1735                       when chr(5)
     1736                       then do:
     1737                           assign
     1738                               p-out-string = p-out-string + "":U
     1739                           .
     1740                       end.
     1741                       when chr(6)
     1742                       then do:
     1743                           assign
     1744                               p-out-string = p-out-string + "":U
     1745                           .
     1746                       end.
     1747                       when chr(7)
     1748                       then do:
     1749                           assign
     1750                               p-out-string = p-out-string + "":U
     1751                           .
     1752                       end.
     1753                       when chr(8)
     1754                       then do:
     1755                           assign
     1756                               p-out-string = p-out-string + "":U
     1757                           .
     1758                       end.
     1759                       when chr(9)
     1760                       then do:
     1761                           assign
     1762                               p-out-string = p-out-string + "":U
     1763                           .
     1764                       end.
     1765                       when chr(29)
     1766                       then do:
     1767                           assign
     1768                               p-out-string = p-out-string + "":U
     1769                           .
     1770                       end.
     1771                       when chr(10)
     1772                       then do:
     1773                           assign
     1774                               p-out-string = p-out-string + "&#10;":U
     1775                           .
     1776                       end.
     1777                       when chr(13)
     1778                       then do:
     1779                           assign
     1780                               p-out-string = p-out-string + "&#13;":U
     1781                           .
     1782                       end.
     1783                       otherwise do:
     1784                           assign
     1785                               p-out-string = p-out-string + v-current-char
     1786                           .
     1787                       end.
     1788                   end case.
     1789               end.
     1790           end.
     1791       end case.
     1792   end.
     1793   end .
     1794   procedure xmlchar-encode-1c :
     1795   define input parameter p-in-string      as character        no-undo.
     1796   define output parameter p-out-string    as character        no-undo.
     1797       define variable v-position      as integer      no-undo.
     1798       define variable v-current-char  as character    no-undo.
     1799   do
     1800   on error undo, return error
     1801   :
     1802       assign
     1803           p-out-string = "":U
     1804       .
     1805       case p-in-string
     1806       :
     1807           when ?
     1808           then do:
     1809               assign
     1810                   p-out-string = "?":U
     1811               .
     1812           end.
     1813           otherwise do:
     1814               do v-position = 1 to length( p-in-string )
     1815               :
     1816                   assign
     1817                       v-current-char = substring( p-in-string, v-position, 1 )
     1818                   .
     1819                   case v-current-char
     1820                   :
     1821                       when chr(1)
     1822                       then do:
     1823                           assign
     1824                               p-out-string = p-out-string + " ":U
     1825                           .
     1826                       end.
     1827                       when chr(2)
     1828                       then do:
     1829                           assign
     1830                               p-out-string = p-out-string + " ":U
     1831                           .
     1832                       end.
     1833                       when chr(3)
     1834                       then do:
     1835                           assign
     1836                               p-out-string = p-out-string + " ":U
     1837                           .
     1838                       end.
     1839                       when chr(4)
     1840                       then do:
     1841                           assign
     1842                               p-out-string = p-out-string + " ":U
     1843                           .
     1844                       end.
     1845                       when chr(5)
     1846                       then do:
     1847                           assign
     1848                               p-out-string = p-out-string + " ":U
     1849                           .
     1850                       end.
     1851                       when chr(6)
     1852                       then do:
     1853                           assign
     1854                               p-out-string = p-out-string + " ":U
     1855                           .
     1856                       end.
     1857                       when chr(7)
     1858                       then do:
     1859                           assign
     1860                               p-out-string = p-out-string + " ":U
     1861                           .
     1862                       end.
     1863                       when chr(8)
     1864                       then do:
     1865                           assign
     1866                               p-out-string = p-out-string + " ":U
     1867                           .
     1868                       end.
     1869                       when chr(9)
     1870                       then do:
     1871                           assign
     1872                               p-out-string = p-out-string + " ":U
     1873                           .
     1874                       end.
     1875                       when chr(29)
     1876                       then do:
     1877                           assign
     1878                               p-out-string = p-out-string + " ":U
     1879                           .
     1880                       end.
     1881                       when chr(10)
     1882                       then do:
     1883                           assign
     1884                               p-out-string = p-out-string + " ":U
     1885                           .
     1886                       end.
     1887                       when chr(13)
     1888                       then do:
     1889                           assign
     1890                               p-out-string = p-out-string + " ":U
     1891                           .
     1892                       end.
     1893                       otherwise do:
     1894                           assign
     1895                               p-out-string = p-out-string + v-current-char
     1896                           .
     1897                       end.
     1898                   end case.
     1899               end.
     1900           end.
     1901       end case.
     1902   end.
     1903   end .
     1904   procedure xmlchar-decode :
     1905   define input parameter p-in-string      as character        no-undo.
     1906   define output parameter p-out-string    as character        no-undo.
     1907       define variable v-position      as integer      no-undo.
     1908       define variable v-last-position as integer      no-undo.
     1909       define variable v-temp-integer  as integer      no-undo.
     1910       define variable v-current-char  as character    no-undo.
     1911       define variable v-next-char     as character    no-undo.
     1912       define variable v-success       as logical      no-undo.
     1913   do
     1914   on error undo, return error
     1915   :
     1916       assign
     1917           p-out-string = "":U
     1918           v-position   = 0
     1919       .
     1920       replace-cycle:
     1921       do while yes
     1922       on error undo, return error
     1923       :
     1924           assign
     1925               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1926           .
     1927           if v-last-position <= v-position
     1928           then do:
     1929               if v-position = 0
     1930               then do:
     1931                   assign
     1932                       p-out-string = p-in-string
     1933                   .
     1934               end.
     1935               else do:
     1936                   assign
     1937                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1938                   .
     1939               end.
     1940               leave replace-cycle.
     1941           end.
     1942           else do:
     1943               assign
     1944                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1945                   v-position      = v-last-position
     1946                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1947               .
     1948               if v-current-char = "#":U
     1949               then do:
     1950                   assign
     1951                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1952                   .
     1953                   if v-last-position > 0
     1954                   then do:
     1955                       run xmlchar-read-integer in this-procedure
     1956                        (
     1957                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1958                           , output v-temp-integer
     1959                           , output v-success
     1960                       ).
     1961                       if v-success = yes
     1962                       and v-temp-integer >= 1
     1963                       and v-temp-integer <= 255
     1964                       then do:
     1965                           assign
     1966                               p-out-string = p-out-string + chr( v-temp-integer )
     1967                               v-position   = v-last-position + 1
     1968                           .
     1969                       end.
     1970                       else do:
     1971                           assign
     1972                               p-out-string = p-out-string + "&":U
     1973                               v-position   = v-position   + 1
     1974                           .
     1975                       end.
     1976                   end.
     1977                   else do:
     1978                       assign
     1979                           p-out-string = p-out-string + "&":U
     1980                           v-position   = v-position   + 1
     1981                       .
     1982                   end.
     1983               end.
     1984               else do:
     1985                   case substring( p-in-string, v-position + 1, 3 )
     1986                   :
     1987                       when "lt;":U
     1988                       then do:
     1989                           assign
     1990                               p-out-string = p-out-string + "<":U
     1991                               v-position   = v-position   + 3
     1992                           .
     1993                       end.
     1994                       when "gt;":U
     1995                       then do:
     1996                           assign
     1997                               p-out-string = p-out-string + ">":U
     1998                               v-position   = v-position   + 3
     1999                           .
     2000                       end.
     2001                       otherwise do:
     2002                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2003                           then do:
     2004                               assign
     2005                                   p-out-string = p-out-string + "&":U
     2006                                   v-position   = v-position   + 4
     2007                               .
     2008                           end.
     2009                           else do:
     2010                               case substring( p-in-string, v-position + 1, 5 )
     2011                               :
     2012                                   when "quot;":U
     2013                                   then do:
     2014                                       assign
     2015                                           p-out-string = p-out-string + '"':U
     2016                                           v-position   = v-position   + 5
     2017                                       .
     2018                                   end.
     2019                                   when "apos;":U
     2020                                   then do:
     2021                                       assign
     2022                                           p-out-string = p-out-string + "'":U
     2023                                           v-position   = v-position   + 5
     2024                                       .
     2025                                   end.
     2026                                   otherwise do:
     2027                                       assign
     2028                                           p-out-string = p-out-string + "&":U
     2029                                       .
     2030                                   end.
     2031                               end case.
     2032                           end.
     2033                       end.
     2034                   end case.
     2035               end.
     2036           end.
     2037       end.
     2038   end.
     2039   end .
     2040   procedure xmlchar-read-integer :
     2041   define input parameter p-input-string      as character        no-undo.
     2042   define output parameter p-output-integer   as integer          no-undo.
     2043   define output parameter p-success       as logical          no-undo.
     2044   do
     2045   on error undo, return error
     2046   :
     2047       assign
     2048           p-output-integer = integer( p-input-string )
     2049       no-error.
     2050       if error-status :error
     2051       then do:
     2052           assign
     2053               p-success           = no
     2054               p-output-integer    = 0
     2055           .
     2056       end.
     2057       else do:
     2058           assign
     2059               p-success           = yes
     2060           .
     2061       end.
     2062   end.
     2063   end.
     2064   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2065   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2066   define new global shared variable g#attr-lib  as handle no-undo .
     2067   define variable v-attr-lib-variable as handle no-undo .
     2068   define variable mMRCCode  as logical    no-undo.
     2069   define variable mTypeMark as character  no-undo.
     2070   function IS-NeedMark returns logical
     2071   ( input ib-code as integer  ,
     2072     input ib-str as character ):
     2073      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2074      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2075                                    and buf_prod-bc-attr.b-str  eq ib-str
     2076                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2077        no-lock no-error.
     2078      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2079   end.
     2080   function repTegforDm return char
     2081   (iDM as char ):
     2082       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2083       define variable vteg as character no-undo.
     2084       define variable oDM as character no-undo.
     2085       define variable vi as integer no-undo.
     2086       oDM = iDm.
     2087       do vi = 1 to num-entries(vTeglist):
     2088          vTeg = entry(vi,vTeglist).
     2089          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2090       end.
     2091       return oDM.
     2092   end.
     2093   function repSpecSimbforDm return char
     2094   (iDM as char ):
     2095       define variable oDM as character no-undo.
     2096     run
     2097       xmlchar-decode(iDM, output oDM).
     2098     return repTegforDm (oDM).
     2099   end.
     2100   function CheckGtin return logical
     2101   (iGtin as char):
     2102      define variable bar_code as character no-undo.
     2103      define variable vGtin as logical no-undo init "yes".
     2104      if length(iGtin) eq 14
     2105      then do:
     2106         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2107         run str/chk-sum.p
     2108          (input-output bar_code ) no-error .
     2109         if iGtin ne  bar_code
     2110         then
     2111            vGtin = no.
     2112      end.
     2113      else
     2114         vGtin = no.
     2115      return vgtin.
     2116   end.
     2117   function repSpecSimbforXlm return char
     2118   (iDM as char ):
     2119       iDM = replace(iDM,chr(29),"").
     2120       return iDM.
     2121   end.
     2122   function getGtinByDM return char
     2123   (IDM as char):
     2124      define variable VTXT as char no-undo.
     2125      define variable vGtin as char no-undo.
     2126      vTXt = IdM.
     2127      vGtin = IDM.
     2128      if    length(vtxt) > 14
     2129      then do:
     2130         if   vtxt begins "(01)"
     2131                or vtxt begins "(02)"
     2132         then
     2133            vGtin = substring(vtxt,5,14).
     2134         else if   (vtxt begins "01"
     2135                or vtxt begins "02" )
     2136                and (   (    substring(iDm,17,2) eq "21"
     2137                         and length(vtxt) >= 21)
     2138                     or substring(iDm,17,2) eq "37"
     2139                     or substring(iDm,17,4) eq "(37)" )
     2140         then do:
     2141            vGtin = substring(vtxt,3,14).
     2142            if not checkGtin(vGtin)
     2143            then
     2144               vGtin = substring(vtxt,1,14).
     2145         end.
     2146         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2147             or length(vtxt) eq 14 + 7 + 4
     2148             or length(vtxt) eq 14 + 7
     2149         then
     2150            vGtin = substring(vtxt,1,14).
     2151      end.
     2152      if not checkGtin(vGtin)
     2153      then
     2154         vGtin = "".
     2155      return vgtin.
     2156   end.
     2157   function getGdsCodeByGtin return int
     2158   (iGtin as char):
     2159      define buffer prod-bc  for ub.prod-bc.
     2160      define buffer bar-code for ub.bar-code.
     2161      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2162      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2163      return if avail bar-code then bar-code.gds-code else ?.
     2164   end.
     2165   function getQntyCodeByGtin return decimal
     2166   (iGtin as char):
     2167      define buffer prod-bc  for ub.prod-bc.
     2168      define buffer bar-code for ub.bar-code.
     2169      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2170      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2171      return if avail bar-code then bar-code.cli-base-rate else ?.
     2172   end.
     2173   function getGdsCodeByDM return int
     2174   (iDm as char):
     2175      define variable vGtin as char no-undo.
     2176      define buffer prod-bc for ub.prod-bc.
     2177      vGtin  = getGtinByDM (IDM ).
     2178      return getGdsCodeByGtin (vGtin).
     2179   end.
     2180   function ChekTypeMarkByGds return logical
     2181   (iGds-code as integer ):
     2182      define buffer goods-attr for ub.goods-attr.
     2183      find first goods-attr where goods-attr.gds-code   = iGds-code
     2184                              and goods-attr.attr-code  = 'mark-type':U
     2185      no-lock no-error.
     2186      if available goods-attr
     2187      then do:
     2188         mTypeMark = goods-attr.attr-value.
     2189         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2190           .
     2191      end.
     2192      else
     2193         return no.
     2194   end.
     2195   function ChekTypeMarkByDm return logical
     2196   (iDM as char ):
     2197      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2198   end.
     2199   function ChekTypeMarkByGtin return logical
     2200   (iGtin as char ):
     2201      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2202   end.
     2203   function GetNextElement return character
     2204     (input iAllTeg        as logical
     2205     ,output oteg          as character
     2206     ,output otegval       as character
     2207     ,input-output pstr    as character
     2208      ):
     2209        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2210        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2211        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2212        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2213        define variable vTeg as character no-undo.
     2214        define variable vLength as integer no-undo.
     2215        define variable vi as integer no-undo.
     2216        define variable vj as integer no-undo.
     2217        define buffer code for ub.code.
     2218        find first code where Code.parent eq "MarkType"
     2219                          and Code.CodeValue   eq mTypeMark
     2220                          no-lock no-error.
     2221        if     available code
     2222           and Code.misc1 ne ""
     2223           and Code.misc1 ne ?
     2224        then do:
     2225           integer (Code.misc1) no-error.
     2226           if not error-status:error
     2227           then
     2228             entry (4,vlistleng) = Code.misc1.
     2229        end.
     2230        if iAllTeg
     2231        then
     2232           assign
     2233              vlistElem     = vlistElem    + vlistElemDop
     2234              vlistleng     = vlistleng    + vlistlengDop
     2235           .
     2236        else if mMRCCode
     2237        then
     2238           assign
     2239              vlistElem     = vlistElem    + ",(8005),8005"
     2240              vlistleng     = vlistleng    + ",000006,0006"
     2241           .
     2242       block-elem:
     2243       do vi = 1 to num-entries(vlistElem):
     2244          vTeg = entry(vi,vlistElem).
     2245          if pstr begins vTeg
     2246          then do:
     2247             if    vTeg eq "21"
     2248             then
     2249                vLength = index(pstr,chr(29)) - 2 no-error.
     2250             if vLength  <= 0
     2251             then
     2252                vLength = int(entry(vi,vlistleng)).
     2253             otegval = substring (pstr,length(vteg) + 1, vLength).
     2254             oteg = replace(replace(vteg,")",""),"(","").
     2255             vTeg = vteg + otegval.
     2256             otegval = replace(otegval,chr(29),"").
     2257             oteg = replace(replace(oteg,")",""),"(","").
     2258             pstr = substring (pstr,length(vTeg)+ 1).
     2259             vTeg = replace(vTeg,chr(29),"").
     2260             leave block-elem.
     2261          end.
     2262          else
     2263             vTeg = "".
     2264       end.
     2265       return vteg.
     2266   end.
     2267   function GetCodeIdent return character
     2268   (iDm as char):
     2269      define variable Velement   as character no-undo init "first".
     2270      define variable oCodeIdent as character no-undo.
     2271      define variable vteg as character no-undo.
     2272      define variable vtegval as character no-undo.
     2273      define variable vGtin as character no-undo.
     2274      define buffer marking for ub.marking.
     2275      for first marking no-lock where
     2276                marking.mark eq iDm
     2277            and marking.unit-ext = "LEVEL2"
     2278      :
     2279        return iDm.
     2280      end.
     2281      vGtin  = getGtinByDM (iDm ).
     2282      ChekTypeMarkByDm(idm).
     2283      if iDm begins 'tech_':U
     2284      then
     2285         oCodeIdent = iDm.
     2286      else if length(iDm) < 21
     2287      then do:
     2288         find first marking where marking.mark eq idm
     2289         no-lock no-error.
     2290         oCodeIdent = if available marking then marking.mark else  ?.
     2291      end.
     2292      else if     length(iDm) eq 29
     2293         and not iDm begins "01"
     2294         and not iDm begins "02"
     2295      then
     2296         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2297      else  if     length(iDm) >= 24
     2298               and (  iDm begins "01"
     2299                   or iDm begins "02")
     2300               and  substring(iDm,17,2) ne "21"
     2301      then do:
     2302         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2303                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2304         then
     2305            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2306         else
     2307            oCodeIdent = iDM.
     2308      end.
     2309      else  if     (   length(iDm) eq 25
     2310                    or length(iDm) eq 21)
     2311               and (not iDm begins "01"
     2312               and  not iDm begins "02")
     2313      then
     2314         oCodeIdent = substring(iDm,1,21).
     2315      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2316      then
     2317         oCodeIdent = substring(iDm,1,21).
     2318      else do while Velement ne "" and idm ne "":
     2319         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2320         oCodeIdent = oCodeIdent + Velement.
     2321      end.
     2322      return oCodeIdent.
     2323   end.
     2324   function GetTegCod return character
     2325   (icodeIdent as char, iTeg as char):
     2326      define variable Velement   as character no-undo init "first".
     2327      define variable oTeg as character no-undo init ?.
     2328      define variable vteg as character no-undo.
     2329      define variable vtegval as character no-undo.
     2330      if     ((length(icodeIdent) eq 21
     2331         and not icodeIdent begins "01"
     2332         and not icodeIdent begins "02")
     2333         or
     2334             ( length(icodeIdent) eq 25
     2335               and not icodeIdent begins "01"
     2336               and not icodeIdent begins "02"))
     2337      then do:
     2338         if iTeg eq "01" or iTeg eq "02"
     2339         then
     2340            oTeg = substring(icodeIdent,1,21).
     2341         else  if  iTeg eq "21"
     2342         then
     2343            oTeg = substring(icodeIdent,15,7).
     2344      end.
     2345      else do:
     2346         ChekTypeMarkByDm(icodeIdent).
     2347         block-teg:
     2348            do while Velement ne "" and icodeIdent ne "":
     2349            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2350            if    Velement begins iTeg
     2351               or Velement begins "(" + iTeg + ")"
     2352            then do:
     2353               oTeg = vtegval.
     2354               leave block-teg.
     2355            end.
     2356         end.
     2357      end.
     2358      return oTeg.
     2359   end.
     2360   function isOAD return logical
     2361   (icodeIdent as character):
     2362      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2363   end.
     2364   function isMark return logical
     2365   (icodeIdent as character):
     2366      define buffer buf_marking for ub.marking.
     2367      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2368             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2369   end.
     2370   function addBracketForCode return character
     2371   (icodeIdent as char):
     2372      define variable Velement   as character no-undo init "first".
     2373      define variable oTeg as character no-undo.
     2374      define variable vteg as character no-undo.
     2375      define variable vtegval as character no-undo.
     2376      define buffer marking for ub.marking.
     2377      find first marking no-lock where
     2378                 marking.mark begins icodeIdent no-error.
     2379      if    not ChekTypeMarkByDm(icodeIdent)
     2380         or length(icodeIdent) le 24
     2381         or (avail marking and marking.unit-ext = "LEVEL2")
     2382      then
     2383         oTeg = icodeIdent.
     2384      else do:
     2385         if (  icodeIdent begins "01"
     2386            or icodeIdent begins "02"
     2387            ) and CheckGtin(substring (icodeIdent,3,14))
     2388            and substring (icodeIdent,17,2) eq "21"
     2389         then do:
     2390            mMRCCode = yes.
     2391            ChekTypeMarkByDm(icodeIdent).
     2392            block-teg:
     2393            do while Velement ne "" and icodeIdent ne "":
     2394               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2395               if vteg ne ""
     2396               then
     2397                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2398            end.
     2399            mMRCCode = no.
     2400         end.
     2401         else do:
     2402            oTeg = icodeIdent.
     2403         end.
     2404      end.
     2405      return oTeg.
     2406   end.
     2407   function getlevelByCodId return int
     2408   (iCode as char):
     2409      define variable vLength as int no-undo.
     2410      define variable vLevel  as int no-undo.
     2411      if not ChekTypeMarkByDM (icode) then return ?.
     2412      vLength = length(iCode).
     2413      if    vLength eq 18
     2414         or vLength eq 20
     2415      then
     2416         Vlevel = 4.
     2417      else if vLength eq 21
     2418      then
     2419         Vlevel = 1.
     2420      else if vLength eq 25
     2421      then do:
     2422         if  iCode begins "01"
     2423         then
     2424            Vlevel = 3.
     2425         else
     2426            Vlevel = 1.
     2427      end.
     2428      else if     vLength >= 26
     2429              and vLength <= 46
     2430      then do:
     2431         if    substring(iCode,17,2) eq "11"
     2432            or substring(iCode,17,2) eq "13"
     2433            or (    substring(iCode,17,2) eq "21"
     2434                and vLength >= 33
     2435                and substring(iCode,26,4) ne "8005")
     2436         then
     2437            Vlevel = 4.
     2438         else if    vLength eq 31
     2439                 or vLength eq 38
     2440                 or vLength eq 39
     2441                 or vLength eq 45
     2442         then
     2443            Vlevel = 1.
     2444         else if    vLength eq 35
     2445                 or vLength eq 43
     2446         then
     2447            Vlevel = 3.
     2448         else
     2449            Vlevel = ?.
     2450      end.
     2451      else
     2452         Vlevel = ?.
     2453      return Vlevel.
     2454   end.
     2455   function getLevelMotpBycodid return character
     2456   (iDm as char):
     2457      define variable vLevel as integer no-undo.
     2458      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2459      vLevel = getlevelByCodId(iDm).
     2460      if    vLevel eq ?
     2461         or vLevel < 1
     2462         or vLevel > 6
     2463      then
     2464         return ?.
     2465      else
     2466         return entry(vlevel,vList).
     2467   end.
     2468   function getLevelUTDByLevelMotp return character
     2469   (iUnit as char):
     2470      define variable vLevel as integer no-undo.
     2471      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2472      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2473      vLevel = lookup(iUnit,vListMOTP).
     2474      if    vLevel eq ?
     2475         or vLevel < 1
     2476         or vLevel > 4
     2477      then
     2478         return ?.
     2479      else
     2480         return entry(vlevel,vListutd).
     2481   end.
     2482   function getLevelMotpByDM return character
     2483   (iDm as char):
     2484      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2485   end.
     2486   function getLevelUTDByCodId return character
     2487   (iDm as char):
     2488      define variable vLevel as integer no-undo.
     2489      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2490      vLevel = getlevelByCodId(iDm).
     2491      if    vLevel eq ?
     2492         or vLevel < 1
     2493         or vLevel > 4
     2494      then
     2495         return ?.
     2496      else
     2497         return entry(vlevel,vList).
     2498   end.
     2499   function getLevelUTDByDM return character
     2500   (iDm as char):
     2501      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2502   end.
     2503   define variable mNotMarkQnty as logical no-undo.
     2504   function getQntyUTDByCodId return decimal
     2505   (iDM as char):
     2506      define variable vLevel as integer no-undo.
     2507      define variable vList as character no-undo init "1,5,10,500".
     2508      define variable vGtin as character no-undo.
     2509      define variable vqnty as decimal no-undo init ?.
     2510      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2511      if vqnty eq ?
     2512      then do:
     2513         if not mNotMarkQnty
     2514         then do:
     2515            define buffer marking for ub.marking.
     2516            define variable vCodident as character no-undo.
     2517            vCodident = GetCodeIdent(idm).
     2518            find first marking where marking.mark begins vCodident no-lock no-error.
     2519            if     available marking
     2520               and marking.box-qnty ne ?
     2521            then
     2522               return marking.box-qnty.
     2523         end.
     2524         vGtin = getGtinByDm(iDM).
     2525         if ChekTypeMarkByGtin (vGtin)
     2526         then do:
     2527            vLevel = getlevelByCodId(iDM).
     2528            if     vLevel >= 1
     2529               and vLevel <= 4
     2530            then
     2531               vqnty = int(entry(vlevel,vList)).
     2532         end.
     2533         else
     2534            vqnty = getQntyCodeByGtin(vgtin).
     2535      end.
     2536      return vqnty.
     2537   end.
     2538   function getQntyUTDByDM return decimal
     2539   (iDm as char):
     2540      define variable vDM as character no-undo.
     2541      if     length (iDm) ne 25
     2542         and length (iDm) ne 29
     2543         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2544      then
     2545         vDM = substring (iDm,1,length (iDm) - 6 ).
     2546      else
     2547         vDM = substring (iDm,1,length (iDm) - 4 ).
     2548      return getQntyUTDByCodId(vDM).
     2549   end.
     2550   function getMRC4 return decimal
     2551   (iMRC as char):
     2552      define variable oMrc     as decimal no-undo init ?.
     2553      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2554      define variable vi       as integer no-undo.
     2555      define variable vfound   as integer no-undo.
     2556      define variable vposStart   as integer no-undo.
     2557      do:
     2558      OMRc = 0.
     2559      do vi = 1 to 4:
     2560         define variable vsimb as character no-undo.
     2561         vsimb = substring(iMRC,vi,1).
     2562         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2563         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2564         if vfound > 0
     2565         then
     2566            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2567         end.
     2568         OMRc = OMRc / 100.
     2569      end.
     2570      return OMRc.
     2571   end.
     2572   function getMRCByDM return decimal
     2573   (iDm as char):
     2574      define variable vMRC     as character no-undo.
     2575      define variable oMrc     as decimal no-undo init ?.
     2576      define variable Velement as character no-undo init "empty".
     2577      define variable vteg as character no-undo.
     2578      define variable vtegval as character no-undo.
     2579      if    length(idm) eq 14 + 7 + 4 + 4
     2580         or length(idm) eq 14 + 7 + 4
     2581      then do:
     2582         vMRC = substring(idm,22,4).
     2583         omrc = getMRC4(vMRC).
     2584      end.
     2585      else do:
     2586          ChekTypeMarkByDm(iDm).
     2587          block-mrc:
     2588          do while Velement ne "" and idm ne "":
     2589             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2590             if Velement begins "8005"
     2591             then do:
     2592                vMRC = substring(Velement,5,6).
     2593                leave block-mrc.
     2594             end.
     2595             else if Velement begins "(8005)"
     2596             then do:
     2597                vMRC = substring(Velement,7,6).
     2598                leave block-mrc.
     2599             end.
     2600          end.
     2601          if vMRC ne ""
     2602          then
     2603             OMRc = dec(vmrc) / 100 no-error.
     2604      end.
     2605      return OMRc.
     2606   end.
     2607   function MoveDate return Date
     2608   (idate as date,
     2609    iMonth as int64):
     2610      define variable vMonth   as int64 no-undo.
     2611      define variable vYear    as int64 no-undo.
     2612      define variable vDateNew as date  no-undo.
     2613       define variable vDay     as int64 no-undo.
     2614       vMonth = month(iDate) + iMonth.
     2615       vYear =  year(iDate).
     2616       if vMonth <= 0
     2617       then assign
     2618          vMonth = vMonth + 12
     2619           vYear  = vYear - 1
     2620       .
     2621       else if vMonth > 12
     2622       then assign
     2623          vMonth = vMonth - 12
     2624           vYear  = vYear + 1
     2625       .
     2626       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2627       do while error-status:error eq yes:
     2628          VDay = vDay + 1.
     2629          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2630       end.
     2631       if VDay > 0
     2632       then
     2633          vDateNew + 1.
     2634       return vDateNew.
     2635   end.
     2636   procedure checkEMRC:
     2637   define input  parameter iDm as character no-undo.
     2638   define output parameter vok as logical   no-undo init yes.
     2639      define variable v-value-emrc as character no-undo.
     2640      define variable v-type-emrc  as character no-undo.
     2641      define variable vDateIso     as character no-undo.
     2642      define variable vMRC         as decimal no-undo.
     2643      define variable vqnty        as decimal no-undo.
     2644      define variable vPrice       as decimal no-undo.
     2645      define variable vparent      as character no-undo.
     2646      define variable vgds-code    as integer no-undo.
     2647      define buffer code for ub.code.
     2648      vMRC = getMRCByDM(iDm).
     2649      if vMRC > 0
     2650      then do:
     2651         vgds-code = getGdsCodeByDM(iDm).
     2652         vqnty     = getQntyUTDByDM(iDm).
     2653               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2654            (
     2655             input   vgds-code
     2656            ,input   'emrc-type':U
     2657            ,output   v-value-emrc
     2658            ,output   v-type-emrc
     2659          ) no-error.
     2660          if     v-value-emrc ne ""
     2661             and v-value-emrc ne ?
     2662          then do:
     2663             vDateIso = iso-date(today).
     2664             vPrice = vMRC / vqnty.
     2665             vparent ="emc" + chr(4) + v-value-emrc.
     2666             find last code where Code.parent      eq vparent
     2667                              and Code.code        le vDateIso
     2668                              and code.status_  eq 0
     2669             no-lock no-error.
     2670             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2671             then
     2672                vOk = true .
     2673             else do:
     2674                 define variable vText      as character no-undo.
     2675                 define variable vDate      as date no-undo.
     2676                 define variable vDateLast  as character no-undo.
     2677                 define variable vDateFirst as character no-undo.
     2678                 define variable vDate3     as date no-undo.
     2679                 vdate = date(code.misc1).
     2680                 vDateLast = code.misc1.
     2681                 vDate3 = MoveDate(today, - 3 ).
     2682                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2683                                      string(vDate3  , "99/99/9999"),
     2684                                      string(vDate   , "99/99/9999")
     2685                                      ).
     2686                 vdateIso = iso-date(vdate3).
     2687                 find last code  where Code.parent      eq vparent
     2688                                   and Code.code        le vDateIso
     2689                                   and code.status_  eq 0 no-lock no-error.
     2690                 if available code
     2691                 then
     2692                    vDateIso = code.code.
     2693                 vDateFirst = vDateIso.
     2694                 vDateLast = iso-date(vdate).
     2695                 define variable vGood as logical no-undo.
     2696                 define variable vDateSale as date no-undo.
     2697                 define buffer bcode for code.
     2698                 for last code where Code.parent   eq vparent
     2699                                 and code.status_  eq 0
     2700                                 and code.code     < vDateLast
     2701                                 and code.code     >= vDateFirst
     2702                 no-lock:
     2703                    find first bcode where bCode.parent   eq vparent
     2704                                       and bcode.status_  eq 0
     2705                                       and bcode.code     > code.code no-lock no-error.
     2706                    if available bcode
     2707                    then do:
     2708                       if vPrice < dec(Code.CodeValue)
     2709                       then
     2710                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2711                                                     chr(10),
     2712                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2713                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2714                                                     ).
     2715                       else do:
     2716                          vGood = yes.
     2717                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2718                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2719                                                     chr(10),
     2720                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2721                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2722                                                     string(         vDateSale            ,"99/99/9999"),
     2723                                                     string(vDateSale - today)
     2724                                                     ).
     2725                       end.
     2726                    end.
     2727                 end.
     2728                 if vgood
     2729                 then do:
     2730                    define variable choice as integer no-undo .
     2731                    run gbl/d-askw.w (input "Уточнение"
     2732                           ,input  vText
     2733                           ,input "|"
     2734                           ,input "Принять|Вернуть"
     2735                           ,input "Принять данный товар|Вернуть товар постащику"
     2736                           ,input 1
     2737                           ,input 2
     2738                           ,output choice) no-error.
     2739                    vok = choice eq 1.
     2740                 end.
     2741                 else
     2742                    vok =false.
     2743             end.
     2744          end.
     2745      end.
     2746   end.
     2747   function addGs2Mark return character
     2748   (iMark as char):
     2749      define variable vDM   as character no-undo.
     2750      define variable vIdx  as integer   no-undo.
     2751      if index(iMark,chr(29),1) > 0
     2752      then return iMark.
     2753      if substring(iMark,26,4) = "8005" then
     2754      do:
     2755        vIdx = index(iMark,"93",26 + 4 + 5).
     2756        if vIdx > 1 then do:
     2757          vDM = substitute("&1&4&2&4&3",
     2758                           substring(iMark,1,25),
     2759                           substring(iMark,26,vIdx - 25 - 1),
     2760                           substring(iMark,vIdx),
     2761                           chr(29)) no-error.
     2762          vIdx = index(vDm,"240",vIdx + 4).
     2763          if vIdx > 0 then
     2764          do:
     2765            vDM = substitute("&1&3&2",
     2766                             substring(vDm,1,vIdx - 1),
     2767                             substring(vDm,vIdx),
     2768                             chr(29)) no-error.
     2769          end.
     2770        end.
     2771        else
     2772          vDM = substitute("&1&3&2",
     2773                           substring(iMark,1,25),
     2774                           substring(iMark,26),
     2775                           chr(29)) no-error.
     2776      end.
     2777      else if substring(iMark,32,2) = "91" then
     2778      do:
     2779        vIdx = index(iMark,"92",32).
     2780        if vIdx > 1 then
     2781          vDM = substitute("&1&4&2&4&3",
     2782                           substring(iMark,1,31),
     2783                           substring(iMark,32,vIdx - 31 - 1),
     2784                           substring(iMark,vIdx),
     2785                           chr(29)) no-error.
     2786        else
     2787          vDM = substitute("&1&3&2",
     2788                           substring(iMark,1,31),
     2789                           substring(iMark,32),
     2790                           chr(29)) no-error.
     2791      end.
     2792      else if substring(iMark,39,2) = "91" then
     2793      do:
     2794        vIdx = index(iMark,"92",38).
     2795        if vIdx > 1 then
     2796          vDM = substitute("&1&4&2&4&3",
     2797                           substring(iMark,1,38),
     2798                           substring(iMark,39,vIdx - 38 - 1),
     2799                           substring(iMark,vIdx),
     2800                           chr(29)) no-error.
     2801        else
     2802          vDM = substitute("&1&3&2",
     2803                           substring(iMark,1,38),
     2804                           substring(iMark,39),
     2805                           chr(29)) no-error.
     2806      end.
     2807      else if substring(iMark,25,2) = "93" then
     2808      do:
     2809        vIdx = index(iMark,"92",25).
     2810        if vIdx > 1 then
     2811          vDM = substitute("&1&4&2&4&3",
     2812                           substring(iMark,1,24),
     2813                           substring(iMark,25,vIdx - 24 - 1),
     2814                           substring(iMark,vIdx),
     2815                           chr(29)) no-error.
     2816        else
     2817          vIdx = index(iMark,"3103",25).
     2818          if vIdx > 0 then
     2819          vDM = substitute("&1&4&2&4&3",
     2820                           substring(iMark,1,24),
     2821                           substring(iMark,25,vIdx - 24 - 1),
     2822                           substring(iMark,vIdx),
     2823                           chr(29)) no-error.
     2824          else
     2825            vDM = substitute("&1&3&2",
     2826                             substring(iMark,1,24),
     2827                             substring(iMark,25),
     2828                             chr(29)) no-error.
     2829      end.
     2830      else if substring(iMark,32,2) = "93" then
     2831      do:
     2832        vDM = substitute("&1&3&2",
     2833              substring(iMark,1,31),
     2834              substring(iMark,32),
     2835              chr(29)) no-error.
     2836      end.
     2837      return if vDM <> "" then vDm else iMark.
     2838   end.
     2839   DEFINE BUFFER X_marking             FOR tt-tech-mark.
     2840   DEFINE BUTTON b-exit AUTO-GO
     2841        LABEL "&Выход ":L
     2842        SIZE 10 BY 1.
     2843   DEFINE BUTTON b-save AUTO-GO
     2844        LABEL "&Ввод":L
     2845        SIZE 10 BY 1.
     2846   DEFINE QUERY br-no-mark FOR
     2847         X_marking SCROLLING.
     2848   DEFINE BROWSE br-no-mark
     2849     QUERY br-no-mark NO-LOCK DISPLAY
     2850         X_marking.gds-code COLUMN-LABEL "Код товара" FORMAT "999999999":U
     2851         X_marking.gds-name COLUMN-LABEL "Наименование" FORMAT "x(210)":U width 25
     2852         X_marking.qnty-doc COLUMN-LABEL "Кол-во марок!документ" FORMAT "->,>>>,>>9":U
     2853         X_marking.qnty-fact COLUMN-LABEL "Кол-во марок!фактическое" FORMAT "->,>>>,>>9":U
     2854     ENABLE
     2855         X_marking.qnty-fact
     2856       WITH NO-ROW-MARKERS SEPARATORS SIZE 86 BY 15.25 FIT-LAST-COLUMN.
     2857   DEFINE FRAME d-mark
     2858        b-save AT ROW 1 COL 1
     2859        b-exit AT ROW 1 COL 11 WIDGET-ID 292
     2860        br-no-mark AT ROW 2.5 COL 1.5 WIDGET-ID 200
     2861        SPACE(1.24) SKIP(0.41)
     2862       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2863            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2864            TITLE "Немаркированная продукция":L.
     2865   ASSIGN
     2866          FRAME d-mark:SCROLLABLE       = FALSE.
     2867   ASSIGN
     2868          br-no-mark:COLUMN-RESIZABLE IN FRAME d-mark       = TRUE.
     2869   ON leave OF br-no-mark IN FRAME d-mark
     2870     DO:
     2871       if available (tt-tech-mark) then do:
     2872         if tt-tech-mark.qnty-fact > tt-tech-mark.qnty-doc then do:
     2873           message "Фактическое кол-во марок не может быть больше кол-ва марок по документу"
     2874           view-as alert-box.
     2875           return no-apply.
     2876         end.
     2877       end.
     2878         END.
     2879   ON value-changed OF br-no-mark IN FRAME d-mark
     2880     DO:
     2881       if available (tt-tech-mark) then do:
     2882         if tt-tech-mark.qnty-fact > tt-tech-mark.qnty-doc then do:
     2883           message "Фактическое кол-во марок не может быть больше кол-ва марок по документу"
     2884           view-as alert-box.
     2885           return no-apply.
     2886         end.
     2887       end.
     2888         END.
     2889   ON return OF br-no-mark IN FRAME d-mark
     2890     DO:
     2891       if available (tt-tech-mark) then do:
     2892         if tt-tech-mark.qnty-fact > tt-tech-mark.qnty-doc then do:
     2893           message "Фактическое кол-во марок не может быть больше кол-ва марок по документу"
     2894           view-as alert-box.
     2895           return no-apply.
     2896         end.
     2897       end.
     2898         END.
     2899   ON choose OF b-exit IN FRAME d-mark
     2900     DO:
     2901       p-ok = false .
     2902         END.
     2903   ON choose OF b-save IN FRAME d-mark
     2904     DO:
     2905       for each tt-tech-mark:
     2906         if tt-tech-mark.qnty-fact > tt-tech-mark.qnty-doc then do:
     2907           message "Фактическое кол-во марок не может быть больше кол-ва марок по документу"
     2908           view-as alert-box.
     2909           return no-apply.
     2910         end.
     2911       end.
     2912       p-ok = true .
     2913         END.
     2914   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-mark:PARENT eq ?
     2915     THEN FRAME d-mark:PARENT = ACTIVE-WINDOW.
     2916   ON WINDOW-CLOSE OF FRAME d-mark
     2917     APPLY "END-ERROR":U TO SELF.
     2918   MAIN-BLOCK:
     2919   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2920     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2921   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2922     run mainmenu_getcntxt in parparentproc
     2923       (output v-cntxt-db-num
     2924       ,output v-cntxt-userid
     2925       ,output v-cntxt-level
     2926       ,output v-cntxt-host-code-obj
     2927       ,output v-cntxt-obj-type
     2928       ,output v-cntxt-obj-code
     2929       ,output v-cntxt-db-num-obj
     2930       ,output v-cntxt-is-admin
     2931       ) .
     2932   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2933   do:
     2934     br-no-mark :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2935   end.
     2936     run init-temp in this-procedure .
     2937     run enable_UI in this-procedure .
     2938     WAIT-FOR GO OF FRAME d-mark focus br-no-mark.
     2939   END.
     2940   run disable_UI in this-procedure .
     2941   PROCEDURE disable_UI :
     2942     HIDE FRAME d-mark.
     2943   END PROCEDURE.
     2944   PROCEDURE enable_UI :
     2945     ENABLE
     2946       b-exit
     2947       b-save
     2948       with frame d-mark .
     2949       if p-mode <> 'ПРОСМОТР':U then do:
     2950         enable br-no-mark with frame d-mark .
     2951       end.
     2952       else do:
     2953         disable br-no-mark with frame d-mark .
     2954       end.
     2955   END PROCEDURE.
     2956   PROCEDURE init-temp :
     2957     OPEN QUERY br-no-mark FOR EACH X_marking exclusive-LOCK INDEXED-REPOSITION.
     2958   END PROCEDURE.
