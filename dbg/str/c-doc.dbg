      134     ( buffer local-c-parts for c-parts )  FORWARD.
      135   FUNCTION priznak RETURNS character
      136     ( buffer local-gds-prt for gds-prt,
      137       buffer local-goods   for goods )  FORWARD.
      138   FUNCTION sum-base RETURNS DECIMAL
      139     ( buffer  local-c-doc-line for c-doc-line)  FORWARD.
      140   FUNCTION sum-cli RETURNS DECIMAL
      141    ( buffer  local-c-doc-line for c-doc-line)  FORWARD.
      142   FUNCTION sum-dsc-base RETURNS DECIMAL
      143     ( buffer local-c-gds-dtl for c-gds-dtl )  FORWARD.
      144   FUNCTION sum-dsc-rubl RETURNS DECIMAL
      145     ( buffer local-c-gds-dtl for c-gds-dtl )  FORWARD.
      146   FUNCTION sum-rubl RETURNS DECIMAL
      147    ( buffer  local-c-doc-line for c-doc-line)  FORWARD.
      148   FUNCTION sum-sale-base RETURNS DECIMAL
      149     ( buffer local-c-gds-dtl for c-gds-dtl )  FORWARD.
      150   FUNCTION sum-sale-rubl RETURNS DECIMAL
      151     ( buffer local-c-gds-dtl for c-gds-dtl )  FORWARD.
      152   DEFINE BUTTON b-exit AUTO-GO
      153        LABEL "&Выход"
      154        SIZE 10 BY 1
      155        BGCOLOR 8 .
      156   DEFINE BUTTON b-help
      157        LABEL "&Помощь"
      158        SIZE 10 BY 1
      159        BGCOLOR 8 .
      160   DEFINE BUTTON b-Lines
      161        LABEL "&Строки"
      162        SIZE 10 BY 1.
