      187         ub.c-trn-doc,
      188         ub.currency SCROLLING.
      189   DEFINE BROWSE b-doc-line
      190     QUERY b-doc-line DISPLAY
      191         c-doc-line.artic column-label "Артикул"
      192   goods.gds-name format "x(30)" column-label "Имя"
      193   c-doc-line.doc-qnty column-label "Док. кол-во"
      194   c-doc-line.fact-qnty column-label "Факт кол-во"
      195   goods.unit-base column-label "Изм"
      196   c-doc-line.cli-qnty column-label "Кол-во пост"
      197   c-doc-line.unit-cli column-label "Изм"
      198   c-doc-line.price-base column-label "Уч цена(вал)"
      199   sum-base (buffer c-doc-line) column-label "Сумма уч (вал)" format "->>>>>>>>>>>>>9.99"
      200   c-doc-line.price-rubl column-label "Уч цена(руб)"
      201   sum-rubl (buffer c-doc-line) column-label "Сумма уч (руб)" format "->>>>>>>>>>>>>9.99"
      202   c-doc-line.price-cli column-label "Цена пост"
