      164        LABEL "&Топливо"
      165        SIZE 10 BY 1.
      166   DEFINE BUTTON b-suppcnt
      167        LABEL "&ДогП"
      168        SIZE 10 BY 1.
      169   DEFINE VARIABLE vardiscnt AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      170        LABEL "Скидка"
      171        VIEW-AS FILL-IN NATIVE
      172        SIZE 23.88 BY .88.
      173   DEFINE VARIABLE varfact-sum AS DECIMAL FORMAT "->,>>>,>>>,>>>,>>9.99" INITIAL 0
      174        LABEL "К оплате"
      175        VIEW-AS FILL-IN NATIVE
      176        SIZE 23.63 BY 1.
      177   DEFINE QUERY b-doc-line FOR
      178         c-doc-line,
      179         goods SCROLLING.
      180   DEFINE QUERY b-gds-dtl FOR
      181         c-gds-dtl,
      182         gds-prt,
      183         bar-code SCROLLING.
      184   DEFINE QUERY b-parts FOR
      185         c-parts SCROLLING.
