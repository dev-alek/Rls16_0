      220   DEFINE BROWSE b-gds-dtl
      221     QUERY b-gds-dtl DISPLAY
      222         bar-code.b-code column-label "Бар-код"
      223   c-gds-dtl.doc-qnty column-label "Док кол-во"
      224   c-gds-dtl.fact-qnty column-label "Факт кол-во"
      225   c-gds-dtl.price-base column-label "Цена (вал)"
      226   sum-sale-base (buffer c-gds-dtl) column-label "Сумма (вал)"
      227   sum-dsc-base (buffer c-gds-dtl) column-label "Скидка (вал)"
      228   itogo-base (buffer c-gds-dtl) column-label "Итого (вал)"
      229   c-gds-dtl.discnt-pc column-label "Скидка (%)"
      230   sum-sale-rubl (buffer c-gds-dtl) column-label "Сумма (руб)"
      231   sum-dsc-rubl (buffer c-gds-dtl) column-label "Скидка (руб)"
      232   itogo-rubl (buffer c-gds-dtl) column-label "Итого (руб)"
      233   priznak  (buffer gds-prt, buffer goods) column-label "Признак"
      234       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.38 BY 5
      235            TITLE "Продажные цены (признаки)".
      236   DEFINE BROWSE b-parts
