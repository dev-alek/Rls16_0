      294        ub.c-trn-doc.exch-scale AT ROW 3.67 COL 16.88 COLON-ALIGNED NO-LABEL
      295             VIEW-AS FILL-IN NATIVE
      296             SIZE 4 BY 1
      297        vardiscnt AT ROW 3.75 COL 38.5 COLON-ALIGNED
      298        ub.c-trn-doc.d-card AT ROW 4.75 COL 18.25 COLON-ALIGNED
      299             VIEW-AS FILL-IN NATIVE
      300             SIZE 17.5 BY 1
      301        ub.c-trn-doc.doc-qnty AT ROW 4.79 COL 71.88 COLON-ALIGNED
      302             LABEL "Количество по документу"
      303             VIEW-AS FILL-IN NATIVE
      304             SIZE 23.75 BY 1
      305        ub.c-trn-doc.discnt-type AT ROW 5.79 COL 8.13 COLON-ALIGNED
      306             VIEW-AS FILL-IN NATIVE
      307             SIZE 16.63 BY 1
      308        ub.c-trn-doc.discnt-pc AT ROW 5.83 COL 25.5 COLON-ALIGNED NO-LABEL
      309             VIEW-AS FILL-IN NATIVE
      310             SIZE 10 BY 1
      311        ub.c-trn-doc.fact-qnty AT ROW 5.92 COL 72 COLON-ALIGNED
      312             LABEL "Фактическое количество"
      313             VIEW-AS FILL-IN NATIVE
      314             SIZE 23.5 BY 1
      315        b-doc-line AT ROW 6.92 COL 1.25
      316        b-gds-dtl AT ROW 12 COL 1
      317        b-parts AT ROW 17 COL 1
      318        b-suppcnt AT ROW 22.25 COL 1
      319        b-Petrol AT ROW 22.25 COL 31.13
      320        b-Lines AT ROW 22.25 COL 41.13
      321        SPACE(48.11) SKIP(0.07)
      322       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      323            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      324            TITLE "<insert dialog title>"
      325            DEFAULT-BUTTON b-exit.
      326   ASSIGN
      327          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      328          FRAME Dialog-Frame:HIDDEN           = TRUE.
      329   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      330   DO:
      331     APPLY "END-ERROR":U TO SELF.
