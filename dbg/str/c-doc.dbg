      206   c-doc-line.slt-pc column-label "НП"
      207   c-doc-line.road-tax column-label "Доп. компонента"
      208   c-doc-line.excise column-label "Акциз"
      209   c-doc-line.transport-base column-label "Трансп. расходы (вал)"
      210   c-doc-line.transport-rubl column-label "Трансп. расходы (руб)"
      211   c-doc-line.other-base column-label "Прочие расходы (вал)"
      212   c-doc-line.other-rubl column-label "Прочие расходы (руб)"
      213   ub.c-doc-line.doc-density column-label "Плотность док"
      214   ub.c-doc-line.fact-density column-label "Плотность факт"
      215   ub.c-doc-line.temperature column-label "Температура"
      216   ub.c-doc-line.num-place column-label "Кол-во мест"
