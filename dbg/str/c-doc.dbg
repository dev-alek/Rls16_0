      244   ub.c-parts.cli-qnty column-label "Кол-во пост"
      245   ub.c-parts.price-base column-label "Цена (вал)"
      246   ub.c-parts.price-rubl column-label "Цена (руб)"
      247   ub.c-parts.price-cli column-label "Цена пост"
      248   ub.c-parts.VAT-pc column-label "НДС"
      249   ub.c-parts.SLT-pc column-label "НП"
      250   ub.c-parts.road-tax-base column-label "Доп. комп. (вал)"
      251   ub.c-parts.road-tax-rubl column-label "Доп. комп. (руб)"
      252   ub.c-parts.transport-base column-label "Транспортные расходы (вал)"
      253   ub.c-parts.transport-rubl column-label "Транспортные расходы (руб)"
      254   ub.c-parts.other-base column-label "Прочие расходы (вал)"
      255   ub.c-parts.other-rubl column-label "Прочие расходы (руб)"
      256   ub.c-parts.cst-code column-label "ГТД" FORMAT "X(31)"
      257   ub.c-parts.pay-code column-label "Код оплаты"
      258   name-purch-code (buffer ub.c-parts) column-label "Код приобретения"
      259       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.38 BY 5
      260            TITLE "Учетные цены (партии)".
      261   DEFINE FRAME Dialog-Frame
      262        b-exit AT ROW 1.17 COL 1.5
      263        b-help AT ROW 1.17 COL 11.63
