        1   define input  parameter  ParParentProc as handle no-undo .
        2   define input  parameter  P-Parent as handle no-undo .
        3   define input-output parameter  p-value     as character no-undo .
        4   define input-output parameter  p-full-name as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable v-mode as character no-undo .
      115   define variable ref-rec   as recid no-undo .
      116   define variable rep-rec2 as recid no-undo .
      117   v-mode = 'ИЗМЕНЕНИЕ':U .
      118   DEFINE BUTTON B-Cancel AUTO-END-KEY
      119        LABEL "&Отмена"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON B-clear
      123        LABEL "&Очистить"
      124        SIZE 10 BY 1 TOOLTIP "Очистить значение"
      125        BGCOLOR 8 .
      126   DEFINE BUTTON B-Help
      127        LABEL "&Help"
      128        SIZE 6 BY 1
      129        BGCOLOR 8 .
      130   DEFINE BUTTON B-OK AUTO-GO
      131        LABEL "&Ввод"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON r-cli
      135        IMAGE-UP FILE "btn-down-arrow":U
      136        IMAGE-DOWN FILE "btn-down-arrow":U
      137        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      138        LABEL "r-cli"
      139        SIZE 3 BY 1.
      140   DEFINE VARIABLE cli AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      141        LABEL "Грузополучатель"
      142        VIEW-AS FILL-IN
      143        SIZE 10.5 BY 1 NO-UNDO.
      144   DEFINE VARIABLE cli-name AS CHARACTER FORMAT "X(256)":U
      145         VIEW-AS TEXT
      146        SIZE 42.5 BY .67
      147        FGCOLOR 1  NO-UNDO.
      148   DEFINE VARIABLE cli-type AS CHARACTER FORMAT "X(3)":U
      149        VIEW-AS FILL-IN
      150        SIZE 4 BY 1 NO-UNDO.
      151   DEFINE FRAME Dialog-Frame
      152        B-OK AT ROW 1 COL 1
      153        B-Cancel AT ROW 1 COL 11
      154        B-clear AT ROW 1 COL 21 WIDGET-ID 10
      155        B-Help AT ROW 1 COL 74
      156        cli AT ROW 3.75 COL 17 COLON-ALIGNED WIDGET-ID 2
      157        cli-type AT ROW 3.75 COL 28 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      158        r-cli AT ROW 3.75 COL 34.25 WIDGET-ID 6
      159        cli-name AT ROW 3.92 COL 35.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      160        SPACE(0.37) SKIP(4.48)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "<insert dialog title>"
      164            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF B-clear IN FRAME Dialog-Frame
      173   DO:
      174     if v-mode = 'ПРОСМОТР':U then return.
      175     assign
      176       cli = 0
      177       cli-type = ""
      178     .
      179       p-value      = "" .
      180       p-full-name  = "" .
      181       cli-name     = "" .
      182       display  cli  cli-type cli-name  with frame Dialog-Frame .
      183   END.
      184   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      185   OR HELP OF FRAME Dialog-Frame
      186   DO:
      187   END.
      188   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      189   DO:
      190   define buffer buf_clients for ub.clients  .
      191     if v-mode = 'ПРОСМОТР':U then return.
      192     assign
      193       cli
      194       cli-type
      195     .
      196      find first buf_clients no-lock where
      197           buf_clients.obj-code = cli and
      198           buf_clients.obj-type = cli-type no-error .
      199           if not available buf_clients and  not(
      200              cli = 0 and cli-type = "" )
      201           then do:
      202              message "Не верно введен Грузополучатель!" view-as alert-box error .
      203              return no-apply.
      204           end.
      205       if cli = 0 and cli-type = "" then do:
      206           p-value      = "" .
      207           p-full-name  = "" .
      208       end.
      209       else do:
      210         p-value      = trim(cli-type) + string(cli)  .
      211         p-full-name  = buf_clients.obj-name          .
      212       end.
      213   END.
      214   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      215   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      216   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
      218   DO:
      219      run proc-r-cli in this-procedure .
      220   END.
      221   ON LEAVE OF cli IN FRAME Dialog-Frame
      222   DO:
      223      run leave-proc-cli in this-procedure .
      224   END.
      225   procedure leave-proc-cli :
      226    do
      227    on error undo, return error return-value
      228    :
      229   define buffer cli-clients for ub.clients.
      230     Assign frame Dialog-Frame cli  cli-type .
      231     if cli-type = "" then do:
      232        find cli-clients no-lock where  cli-clients.obj-code = cli no-error.
      233        if not error-status :error  then
      234        assign
      235          cli-type  =  cli-clients.obj-type
      236          cli-name  =  cli-clients.obj-name
      237        .
      238        Display  cli cli-type cli-name with frame Dialog-Frame.
      239     end.
      240     else do:
      241        find first  cli-clients no-lock where  cli-clients.obj-code = cli  and cli-clients.obj-type  = cli-type no-error.
      242        if available cli-clients then
      243        assign
      244          cli-type  =  cli-clients.obj-type
      245          cli-name  =  cli-clients.obj-name
      246        .
      247        else run proc-r-cli .
      248        Display  cli cli-type cli-name with frame Dialog-Frame.
      249     end.
      250   end.
      251   end procedure.
      252   ON  RETURN OF cli IN FRAME Dialog-Frame
      253   DO:
      254       if cli = ?  then run proc-r-cli in this-procedure .
      255       apply "entry" to cli-type in frame Dialog-Frame.
      256       return no-apply .
      257   END.
      258   ON MOUSE-SELECT-DBLCLICK OF cli IN FRAME Dialog-Frame
      259   DO:
      260     apply "choose" to r-cli in frame Dialog-Frame.
      261     apply "entry" to cli in frame Dialog-Frame.
      262     return no-apply .
      263   end.
      264   Procedure proc-r-cli :
      265    do
      266    on error undo, return error return-value
      267    :
      268     define variable rid-list    as  char no-undo .
      269     define buffer cli#clients for ub.clients.
      270       run ref/cli-all.w
      271       ( input parParentProc,
      272         input "b-sel",
      273         input 'все':U,
      274         input ?,
      275         input ?,
      276         input ref-rec ,
      277         input ",,,,,,NO"   ,
      278         input "",
      279         output  rid-list
      280         ) .
      281       Assign
      282         rep-rec2 = integer(rid-list)
      283         ref-rec = integer(rid-list)
      284         no-error.
      285       find first cli#clients where recid(cli#clients) = rep-rec2 no-lock no-error.
      286       if available cli#clients then
      287           Assign
      288               cli      = cli#clients.obj-code
      289               cli-name = cli#clients.obj-name
      290               cli-type = cli#clients.obj-type
      291                .
      292       Display cli cli-type cli-name with frame Dialog-Frame .
      293   end.
      294   end procedure.
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   on help of frame Dialog-Frame
      297   do:
      298     run gbl/app_help.p
      299       (input this-procedure :file-name
      300       ,input ''
      301       ,input ?
      302       ) no-error.
      303     if error-status :error then do:
      304       message
      305         "Ошибка при вызове помощи"
      306         error-status :get-message(1)
      307         view-as alert-box .
      308     end.
      309   end.
      310   run minbtn-set in this-procedure .
      311   on choose of b-help in frame Dialog-Frame
      312   do:
      313     apply "help":u to frame Dialog-Frame .
      314   end.
      315   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   procedure minbtn-set :
      317       do
      318           on error undo, return error return-value
      319           :
      320           define variable ii              as integer       no-undo .
      321           define variable fh              as widget-handle no-undo .
      322           define variable hh              as widget-handle no-undo .
      323           define variable v-h             as handle        extent 4 no-undo .
      324           define variable v-name-button   as character     no-undo .
      325           define variable v-help-old-x    as decimal       no-undo .
      326           define variable v-help-old-y    as decimal       no-undo .
      327           define variable v-help-old-size as decimal       no-undo .
      328           define variable v-frame-width   as decimal       no-undo .
      329           define variable jj              as integer       no-undo .
      330           do
      331               on error undo, return error
      332               :
      333               assign
      334                   v-frame-width = frame Dialog-Frame:width - 0.3
      335                   fh            = frame Dialog-Frame:first-child
      336                   hh            = fh:first-child
      337                   ii            = 1
      338                   .
      339               do while valid-handle(hh):
      340                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      341                   do:
      342                       case lc(hh:name) :
      343                           when "b-help" then
      344                               do:
      345                                   hh:load-image-up("cmp/b-help.bmp":u) .
      346                                   hh:load-image-down("cmp/b-help.bmp":u) .
      347                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      348                                   hh:TOOLTIP = "Помощь" .
      349                                   v-help-old-x = hh:column .
      350                                   v-help-old-y = hh:row    .
      351                                   v-help-old-size = hh:width .
      352                                   hh:width-chars = 2.5 .
      353                               end.
      354                           when "b-print" then
      355                               do:
      356                                   hh:load-image("cmp/b-print.bmp":u) .
      357                                   hh:TOOLTIP = "Печать" .
      358                                   v-h[ii] = hh:handle .
      359                                   ii = ii + 1 .
      360                                   hh:width-chars = 3 .
      361                               end.
      362                           when "b-history" or
      363                           when "b-hist" then
      364                               do:
      365                                   hh:load-image("cmp/b-hist.bmp":u) .
      366                                   hh:TOOLTIP = "История" .
      367                                   v-h[ii] = hh:handle .
      368                                   ii = ii + 1 .
      369                                   hh:width-chars = 3 .
      370                               end.
      371                           when "b-sch" then
      372                               do:
      373                                   hh:load-image("cmp/b-sch.bmp":u) .
      374                                   hh:TOOLTIP = "Установка Фильтра" .
      375                                   v-h[ii] = hh:handle .
      376                                   ii = ii + 1 .
      377                                   hh:width-chars = 3 .
      378                               end.
      379                           when "b-hist-user" then
      380                               do:
      381                                   hh:load-image("cmp/b-hist.bmp":u) .
      382                                   hh:TOOLTIP = "История пользователя" .
      383                                   ii = ii + 1 .
      384                               end.
      385                       end case.
      386                   end.
      387                   hh = hh:next-sibling.
      388               end.
      389               b-help:column = v-frame-width - b-help:width-chars.
      390               jj = 0.
      391               repeat ii = 4 to 1 by -1 :
      392                   if valid-handle (v-h[ii] ) then
      393                   do:
      394                       jj  = jj + 1 .
      395                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      396                       v-h[ii]:row    = v-help-old-y .
      397                   end.
      398               end.
      399           end.
      400       end.
      401   end procedure.
      402   MAIN-BLOCK:
      403   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      404      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      405     frame Dialog-Frame:title = "Определение грузополучателя" .
      406     assign
      407       cli = integer(substring(p-value,4,10))
      408       cli-type = substring(p-value,1,3)
      409       no-error .
      410     if error-status :error then do:
      411         assign
      412           cli = 0
      413           cli-type = ""
      414           .
      415      end.
      416      else do:
      417       apply "LEAVE"  to cli  in frame Dialog-Frame .
      418      end.
      419     RUN enable_UI.
      420     if v-mode <> 'ИЗМЕНЕНИЕ':U then do:
      421        disable cli cli-type r-cli cli-name  b-clear  with frame Dialog-Frame.
      422        B-ok:label = "Вы&ход"  .
      423        hide B-cancel in frame Dialog-Frame .
      424     END.
      425     WAIT-FOR GO OF FRAME Dialog-Frame.
      426   END.
      427   RUN disable_UI.
      428   PROCEDURE disable_UI :
      429     HIDE FRAME Dialog-Frame.
      430   END PROCEDURE.
      431   PROCEDURE enable_UI :
      432     DISPLAY cli cli-type cli-name
      433         WITH FRAME Dialog-Frame.
      434     ENABLE B-OK B-Cancel B-clear B-Help cli cli-type r-cli cli-name
      435         WITH FRAME Dialog-Frame.
      436     VIEW FRAME Dialog-Frame.
      437   END PROCEDURE.
