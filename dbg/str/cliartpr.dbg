     1908                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1909                                                      then ";":U
     1910                                                      else "":U) +
     1911                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     1912                                                     )
     1913                                               else (if l-col-type = "CHARACTER"
     1914                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     1915                                                           then ";":U
     1916                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     1917                                                     else "":U)
     1918                                               )
     1919   .
     1920   v-single-line = fill( "-" , 230 ).
     1921   run waitfram-show in this-procedure ( "Ждите..." ).
     1922   run prn-lib-open-stream  in this-procedure (
     1923                                                input parParentProc
     1924                                               ,input 62
     1925                                               ,input yes
     1926                                               ,input no
     1927                                               ).
     1928   if not valid-handle(my-handle) then do:
     1929     assign
     1930     my-handle = parparentproc.
     1931   end.
     1932   run get-report-num in parparentproc(output g#report-num).
     1933   RUN OpenForExcel in this-procedure .
     1934   run rep/extitle.p ( 1 ) .
     1935   put stream PrnLibStream "Список товаров по поставщикам с артикулами поставщика" at 21 skip.
     1936   form with frame f-doc.
     1937   for each buf_cli-list no-lock ,
     1938       each buf_cli-gds no-lock
     1939             where   buf_cli-gds.cli-type  = buf_cli-list.obj-type
     1940                 and buf_cli-gds.cli-code  = buf_cli-list.obj-code
     1941                 and buf_cli-gds.cli-art   <> ""
     1942                 and buf_cli-gds.cli-art   <> ? ,
     1943       each buf_goods no-lock
     1944             where buf_goods.artic     = buf_cli-gds.artic
     1945                 and buf_goods.prod-type = buf_cli-gds.prod-type
     1946                 and buf_goods.prod-code = buf_cli-gds.prod-code
     1947       break by buf_cli-list.obj-name
     1948       :
     1949         if first-of( buf_cli-list.obj-name ) then do :
     1950           run check-bottom in this-procedure ( 5 ) .
     1951           if not first( buf_cli-list.obj-name ) and line-counter( PrnLibStream ) <> 1 then do :
     1952             put stream PrnLibStream v-single-line format "X(94)".
     1953           end.
     1954           run print-obj-name in this-procedure.
     1955         end.
     1956         run print-line in this-procedure.
     1957   end.
     1958   run print-itog in this-procedure.
     1959   hide stream PrnLibStream frame BottomFrame.
     1960   hide stream PrnLibStream frame f-doc.
     1961   output stream PrnLibStream close.
     1962   if Make-Excel then output stream ForExcel close.
     1963   delete widget-pool "My-pool".
     1964   run waitfram-hide in this-procedure .
     1965   end.
     1966   procedure print-line :
     1967   do
     1968   on error undo, return error :
     1969     run check-bottom in this-procedure ( 0 ).
     1970     display stream PrnLibStream
     1971       buf_goods.gds-name
     1972       buf_goods.artic
     1973       buf_cli-gds.cli-art
     1974       sym1 sym2 sym3 sym4
     1975     with frame f-doc.
     1976     down stream PrnLibStream with frame f-doc.
     1977     if use-column[1]
     1978     then  C-v-gds-name:screen-value = string(buf_goods.gds-name, entry(1, c-v-gds-name:private-data, chr(4))).
     1979     if use-column[2]
     1980     then  C-v-artic:screen-value = string(buf_goods.artic, entry(1, c-v-artic:private-data, chr(4))).
     1981     if use-column[3]
     1982     then  C-v-cli-art:screen-value = string(buf_cli-gds.cli-art, entry(1, c-v-cli-art:private-data, chr(4))).
     1983     if use-column[4]
     1984     then  C-v-cli-obj-name:screen-value = string(buf_cli-list.obj-name, entry(1, c-v-cli-obj-name:private-data, chr(4))).
     1985         if Make-Excel then  put   stream ForExcel unformatted
     1986     if use-column[1]
     1987     then (reg-output(
     1988                       string(buf_goods.gds-name, entry(1, c-v-gds-name:private-data, chr(4)))
     1989                      ,c-v-gds-name:private-data
     1990                      ,v-reg-replace
     1991                      ,no
     1992                      ,v-dec-sep
     1993                      ,v-th-sep)  +
     1994           (if 1 < last-col-num
     1995            then CHR(9)
     1996            else ""))
     1997     else "":U
     1998     if use-column[2]
     1999     then (reg-output(
     2000                       string(buf_goods.artic, entry(1, c-v-artic:private-data, chr(4)))
     2001                      ,c-v-artic:private-data
     2002                      ,v-reg-replace
     2003                      ,no
     2004                      ,v-dec-sep
     2005                      ,v-th-sep)  +
     2006           (if 2 < last-col-num
     2007            then CHR(9)
     2008            else ""))
     2009     else "":U
     2010     if use-column[3]
     2011     then (reg-output(
     2012                       string(buf_cli-gds.cli-art, entry(1, c-v-cli-art:private-data, chr(4)))
     2013                      ,c-v-cli-art:private-data
     2014                      ,v-reg-replace
     2015                      ,no
     2016                      ,v-dec-sep
     2017                      ,v-th-sep)  +
     2018           (if 3 < last-col-num
     2019            then CHR(9)
     2020            else ""))
     2021     else "":U
     2022     if use-column[4]
     2023     then (reg-output(
     2024                       string(buf_cli-list.obj-name, entry(1, c-v-cli-obj-name:private-data, chr(4)))
     2025                      ,c-v-cli-obj-name:private-data
     2026                      ,v-reg-replace
     2027                      ,no
     2028                      ,v-dec-sep
     2029                      ,v-th-sep)  +
     2030           (if 4 < last-col-num
     2031            then CHR(9)
     2032            else ""))
     2033     else "":U
     2034         skip.
     2035   end.
     2036   end procedure.
     2037   procedure print-obj-name :
     2038   do
     2039   on error undo, return error :
     2040     display stream PrnLibStream
     2041       buf_cli-list.obj-name @ buf_goods.gds-name
     2042       sym1 sym4
     2043     with frame f-doc.
     2044     put stream PrnLibStream v-single-line format "X(94)" skip.
     2045   end.
     2046   end.
     2047   procedure print-itog :
     2048   do
     2049   on error undo, return error :
     2050   put stream PrnLibStream v-single-line format "X(94)".
     2051   end.
     2052   end.
     2053   procedure check-bottom :
     2054   define input parameter num_lines as integer no-undo.
     2055   do
     2056   on error undo, return error :
     2057     if line-counter( PrnLibStream) + num_lines > page-size( PrnLibStream ) then do :
     2058       view stream PrnLibStream frame BottomFrame .
     2059       page stream PrnLibStream.
     2060     end.
     2061   end.
     2062   end.
