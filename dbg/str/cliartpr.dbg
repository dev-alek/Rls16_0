      173   procedure create_obj-list :
      174      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      175      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      176      do
      177      on error undo, return error return-value
      178      :
      179         define buffer cli-obj for ub.clients .
      180         define variable p-var as integer no-undo .
      181         define buffer buf_obj-list for obj-list .
      182         find last buf_obj-list  use-index pi no-error .
      183         if available buf_obj-list
      184         then
      185            p-var = buf_obj-list.obj-id + 1.
      186         else
      187            p-var = 1.
      188         find first cli-obj where
      189                   cli-obj.obj-type = p-obj-type
      190               and cli-obj.obj-code = p-obj-code
      191         no-lock no-error.
      192         if available cli-obj
      193         then do:
      194            create buf_obj-list.
      195            assign
      196               buf_obj-list.obj-id   = p-var
      197               buf_obj-list.obj-code = cli-obj.obj-code
      198               buf_obj-list.obj-type = cli-obj.obj-type
      199               buf_obj-list.obj-name = cli-obj.obj-name
      200               buf_obj-list.db-num   = cli-obj.db-num
      201            .
      202         end.
      203      end.
      204   end.
