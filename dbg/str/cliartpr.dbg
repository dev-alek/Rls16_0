      715   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   procedure cur-time :
      717      define output parameter p-today as date      no-undo .
      718      define output parameter p-time  as integer   no-undo .
      719     do
      720     on error undo, return error
      721     :
      722       define variable v-date1 as date      no-undo .
      723       define variable v-date2 as date      no-undo .
      724       define variable v-time  as integer   no-undo .
      725       assign
      726         v-date1 = today
      727         v-time  = time
      728         v-date2 = today
      729       .
      730       if v-date1 <> v-date2
      731       then do:
      732         assign
      733           v-date1 = today
      734           v-time  = v-time
      735         .
      736       end.
      737       assign
      738         p-today = v-date1
      739         p-time  = v-time
      740       .
      741     end.
      742   end.
      743   function cur-time-date returns character
      744   :
      745     return string(today, '99/99/9999':U) .
      746   end.
      747   function cur-time-mjd returns decimal
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return integer(v-date) - 2400002 + (v-time / 86400) .
      756   end.
      757   function cur-time-get-ending-index returns integer
      758   (input p-number as integer
      759   )
      760   :
      761     if p-number < 0
      762     or p-number = ?
      763     then do:
      764       return 1 .
      765     end.
      766     define variable v-rest as integer   no-undo .
      767     assign
      768       p-number = p-number modulo 100
      769     .
      770     if p-number < 20
      771     then do:
      772       assign
      773         v-rest = p-number
      774       .
      775     end.
      776     else do:
      777       assign
      778         v-rest = p-number modulo 10
      779       .
      780     end.
      781     case v-rest :
      782       when 1
      783       then do:
      784         return 2 .
      785       end.
      786       when 2 or
      787       when 3 or
      788       when 4
      789       then do:
      790         return 3 .
      791       end.
      792       otherwise do:
      793         return 1 .
      794       end.
      795     end case .
      796   end.
      797   procedure cur-time-mjd-to-date :
      798      define input  parameter i-mjd-diff as decimal no-undo.
      799      define output parameter o-Date     as date    no-undo.
      800      define output parameter o-Time     as integer no-undo.
      801      define variable v-day-number as integer   no-undo .
      802      if    i-mjd-diff < 0
      803         or i-mjd-diff = ?
      804      then do:
      805         return "?" .
      806      end.
      807      assign
      808         v-day-number = truncate(i-mjd-diff,0).
      809         o-Date = date(v-day-number + 2400002).
      810         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      811     .
      812   end.
      813   function cur-time-mjd-to-string returns character
      814   (input p-mjd-diff as decimal
      815   )
      816   :
      817     define variable v-day-number as integer   no-undo .
      818     define variable v-seconds    as integer   no-undo .
      819     define variable v-hour       as integer   no-undo .
      820     define variable v-min        as integer   no-undo .
      821     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      822     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      823     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      824     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      825     if p-mjd-diff < 0
      826     or p-mjd-diff = ?
      827     then do:
      828       return "?" .
      829     end.
      830     assign
      831       v-day-number = integer(truncate(p-mjd-diff,0))
      832       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      833     .
      834     if v-seconds > 86400
      835     then do:
      836       assign
      837         v-seconds = 86400 - 1
      838       .
      839     end.
      840     if v-seconds < 0
      841     then do:
      842       assign
      843         v-seconds = 0
      844       .
      845     end.
      846     assign
      847       v-hour = truncate(v-seconds / 3600, 0)
      848     .
      849     assign
      850       v-seconds = v-seconds modulo 3600
      851     .
      852     assign
      853       v-min = truncate(v-seconds / 60, 0)
      854     .
      855     assign
      856       v-seconds = v-seconds modulo 60
      857     .
      858     return
      859         (if v-day-number <> 0
      860           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      861           else ""
      862         )
      863       + (if v-day-number <> 0 or v-hour <> 0
      864           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      865           else ""
      866         )
      867       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      868           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      869           else ""
      870         )
      871       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      872       .
      873   end.
      874   function cur-time-string returns character
      875   :
      876     define variable v-date as date      no-undo .
      877     define variable v-time as integer   no-undo .
      878     run cur-time in this-procedure
      879       (output v-date
      880       ,output v-time
      881       ) .
      882     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      883   end.
      884   function cur-time-string-sec returns character
      885   :
      886     define variable v-date as date      no-undo .
      887     define variable v-time as integer   no-undo .
      888     run cur-time in this-procedure
      889       (output v-date
      890       ,output v-time
      891       ) .
      892     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      893   end.
      894   function cur-time-custom  returns character
      895   (input p-prefix as character
      896   ,input p-date-format as character
      897   ,input p-delimiter as character
      898   ,input p-time-format as character
      899   ,input p-suffix as character
      900   )
      901   :
      902     define variable v-date as date      no-undo .
      903     define variable v-time as integer   no-undo .
      904     run cur-time in this-procedure
      905       (output v-date
      906       ,output v-time
      907       ) .
      908     return
      909       p-prefix
      910       + string(v-date, p-date-format)
      911       + p-delimiter
      912       + string(v-time, p-time-format)
      913       + p-suffix
      914       .
      915   end.
      916   function cur-time-print  returns character
      917   :
      918     define variable v-date as date      no-undo .
      919     define variable v-time as integer   no-undo .
      920     run cur-time in this-procedure
      921       (output v-date
      922       ,output v-time
      923       ) .
      924     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      925   end.
      926   function cur-time-datetime returns datetime
      927   :
      928     define variable v-char as character no-undo .
      929     define variable v-datetime as datetime no-undo .
      930     v-char = cur-time-string().
      931     v-datetime = datetime(v-char).
      932     return  v-datetime.
      933   end.
      934   function cur-time-string-msec returns character
      935   :
      936     define variable v-date as datetime  no-undo .
      937     v-date = now.
      938     return string(v-date) .
      939   end.
      940   define variable l-col-type         as character no-undo .
      941   define variable l-col-pos          as integer no-undo .
      942   define variable l-col-len          as integer no-undo .
      943   define variable l-col-format       as character no-undo .
      944   define variable l-col-lable        as character no-undo .
      945   define variable v-dec-sep          as character no-undo init ? .
      946   define variable v-th-sep           as character no-undo init ? .
      947   define variable v-r-col-num        as integer no-undo .
      948   define variable v-reg-replace      as logical no-undo .
      949   define variable v-date-col-format  as character no-undo .
      950   DEFINE VARIABLE last-col-num as integer no-undo.
      951   run gbl/getlocal.p (
      952                     output v-dec-sep
      953                    ,output v-th-sep
      954                    ,output v-sdate
      955                    ,output v-shortdate
      956                    ) no-error .
      957   assign
      958   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
      959                   AND (v-dec-sep <> ? and v-th-sep <> ?)
      960   .
      961     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
      962                                               INPUT p-dec-sep AS CHARACTER  ) :
      963       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
      964       IF TRIM( p-string ) = "0"                    OR
      965          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
      966          TRIM( p-string ) =       p-dec-sep + "00" OR
      967          TRIM( p-string ) =       p-dec-sep + "0"  OR
      968          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
      969                                                    ELSE DO: ASSIGN v-string = p-string. END.
      970       RETURN ( TRIM( v-string ) ).
      971     END FUNCTION.
      972   FUNCTION reg-output returns character( input p-string as character
      973                                         ,input p-private-data as character
      974                                         ,input p-replace as logical
      975                                         ,input p-supress as logical
      976                                         ,input p-dec-sep as character
      977                                         ,input p-th-sep as character
      978                                         ):
      979   DEFINE VARIABLE v-reg-output as character no-undo .
      980   DEFINE VARIABLE v-data-type as character no-undo .
      981   DEFINE VARIABLE v-progress-format as character no-undo .
      982   assign
      983   v-progress-format = entry(1, p-private-data, chr(4))
      984   v-data-type = entry(2, p-private-data, chr(4))
      985   .
      986   if p-string = ? then return chr(63).
      987   if (v-data-type = "INTEGER"
      988       OR v-data-type = "DECIMAL" ) THEN DO:
      989     IF p-replace THEN DO:
      990       assign
      991         v-reg-output = replace( p-string
      992                                         ,chr(44)
      993                                         ,"":U
      994                                       )
      995         v-reg-output = trim(v-reg-output)
      996       .
      997     END.
      998     else do:
      999       v-reg-output = p-string.
     1000     end.
     1001     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1002     return v-reg-output.
     1003   end.
     1004     return p-string.
     1005   END FUNCTION.
     1006   procedure OpenForExcel :
     1007      define variable v-ch#ExcelApplication as com-handle no-undo .
     1008      define variable v-ch#Workbook         as com-handle no-undo .
     1009      define variable v-ch#Worksheet        as com-handle no-undo .
     1010      os-delete value( string( session:temp-directory ) +
     1011                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1012      os-delete value( string( session:temp-directory ) +
     1013                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1014      os-delete value( string( session:temp-directory ) +
     1015                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1016      if Make-Excel
     1017      then do:
     1018         output stream ForExcel to value( string( session:temp-directory +
     1019                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1020         assign
     1021            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1022            number-list = 1
     1023         .
     1024         if make-excel-com
     1025         then do:
     1026   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   if valid-handle(ch#WorkSheet) then
     1028   RELEASE OBJECT ch#WorkSheet no-error.
     1029   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   if valid-handle(ch#Workbook) then
     1031   RELEASE OBJECT ch#Workbook no-error.
     1032   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1033   if valid-handle(ch#ExcelApplication) then
     1034   RELEASE OBJECT ch#ExcelApplication no-error.
     1035            create "Excel.Application" ch#excelApplication connect no-error.
     1036            if error-status:error
     1037            then do :
     1038           create "Excel.Application" ch#excelApplication no-error.
     1039       if error-status :error then do:
     1040           message
     1041           "Ошибка при запуске Excel" skip
     1042           error-status :get-message(1) skip
     1043           view-as alert-box error .
     1044           undo, return error .
     1045       end.
     1046            end.
     1047            assign
     1048               num#str#  = 0.
     1049               v-ch#excelApplication  = ch#excelApplication.
     1050               v-ch#excelApplication:Interactive = false.
     1051               v-ch#excelApplication:ScreenUpdating = false.
     1052               v-ch#excelApplication:Visible = false.
     1053               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1054               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1055               v-ch#Worksheet = ch#WorkSheet.
     1056               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1057               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1058               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1059               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1060            no-error .
     1061            if error-status:error
     1062            then do:
     1063               Make-Excel-com = false .
     1064               Make-Excel = false .
     1065               output Stream  ForExcel close.
     1066               os-delete value( string( session:temp-directory ) +
     1067                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1068               os-delete value( string( session:temp-directory ) +
     1069                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1070               return.
     1071            end.
     1072         end.
     1073      end.
     1074   end.
     1075   procedure CloseForExcel :
     1076      define variable ii as integer no-undo .
     1077      define variable vsheet-num as integer no-undo.
     1078      if Make-Excel
     1079      then  do:
     1080         output Stream  ForExcel close.
     1081         os-delete value( string( session:temp-directory ) +
     1082                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1083         os-delete value( string( session:temp-directory ) +
     1084                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1085         define buffer buf_sheetf for sheetf.
     1086         find last buf_sheetf no-error .
     1087         if available buf_sheetf
     1088         then
     1089            vsheet-num = buf_sheetf.sheet-num.
     1090         if vsheet-num > 1
     1091         then do:
     1092            do ii = 2 to vsheet-num:
     1093               os-delete value( string( session:temp-directory ) +
     1094                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1095            end.
     1096         end.
     1097   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   if valid-handle(ch#WorkSheet) then
     1099   RELEASE OBJECT ch#WorkSheet no-error.
     1100   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1101   if valid-handle(ch#Workbook) then
     1102   RELEASE OBJECT ch#Workbook no-error.
     1103   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1104   if valid-handle(ch#ExcelApplication) then
     1105   RELEASE OBJECT ch#ExcelApplication no-error.
     1106      end.
     1107   end.
     1108   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   define variable v-waitfram-action01         as character   no-undo .
     1110   define variable v-waitfram-action02         as character   no-undo .
     1111   define variable v-waitfram-action03         as character   no-undo .
     1112   define variable mWaitFramTextBeg            as character   no-undo.
     1113   define variable mWaitFramTextEnd            as character   no-undo.
     1114   define variable mWaitFramView               as logical     no-undo.
     1115   define variable mWaitProcEvent              as logical     no-undo init yes.
     1116   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1117   define variable mWaitFramStop               as logical     no-undo.
     1118   define variable mWaitFramStopUser           as logical     no-undo.
     1119   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1120   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1121   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1122   define button B-WaitFramStop auto-end-key
     1123        label "Стоп"
     1124        size 10 by 1 tooltip "Остоновить процесс".
     1125   define button B-viewProcInfo
     1126        label "Информация"
     1127        size 15 by 1 tooltip "Информация о процесс".
     1128   define frame waitfram
     1129     v-waitfram-action01 format "x(72)" no-label skip
     1130     v-waitfram-action02 format "x(72)" no-label skip
     1131     v-waitfram-action03 format "x(72)" no-label skip
     1132     B-viewProcInfo
     1133     B-WaitFramStop at row 4 col 30
     1134     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1135     .
     1136   define new global shared variable mBatchMode as logical no-undo init ?.
     1137   define variable mFramBachModHandle as handle no-undo.
     1138   mFramBachModHandle = frame waitfram:handle.
     1139   define variable mFameOldVis as logical no-undo.
     1140   define variable mVisCUrentVin as logical no-undo.
     1141   if session:batch-mode
     1142   then
     1143      mBatchMode = yes.
     1144   if mBatchMode = ? then do:
     1145     mVisCUrentVin = current-window:visible.
     1146     mFameOldVis = mFramBachModHandle:visible.
     1147     mFramBachModHandle:visible  = yes.
     1148     mBatchMode = mFramBachModHandle:visible ne yes.
     1149     mFramBachModHandle:visible = mFameOldVis.
     1150     current-window:visible = mVisCUrentVin.
     1151   end.
     1152    if  log-manager:logfile-name ne ?
     1153     then DO:
     1154         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1155         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1156         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1157     end.
     1158   on choose of B-WaitFramStop in frame waitfram
     1159   do:
     1160     mWaitFramStop = yes.
     1161     mWaitFramStopUser = yes.
     1162   end.
     1163   function waitfram-check-timeout returns logical():
     1164      define variable vtime as int64 no-undo.
     1165      if mWaitFramStopTimeOut
     1166      then
     1167         return yes.
     1168      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1169      if     mWaitFramTimeOut ne ?
     1170         and mWaitFramTimeOut ne 0
     1171         and mWaitFramTimeOut lt vtime
     1172      then do:
     1173         mWaitFramStopTimeOut = yes.
     1174      end.
     1175      return mWaitFramStopTimeOut.
     1176   end.
     1177   procedure waitfram-hide :
     1178     if not session:batch-mode
     1179     then do
     1180     on error undo, return error return-value
     1181     :
     1182       pause 0 before-hide .
     1183       if not mBatchMode then
     1184         hide frame waitfram .
     1185     if     not mWaitFramView
     1186        and mWaitProcEvent
     1187     then
     1188       process events .
     1189     end.
     1190   end procedure.
     1191   procedure waitfram-show :
     1192     define input  parameter p-message as character no-undo .
     1193     define variable v-left-margin as integer   no-undo .
     1194     if not session:batch-mode
     1195     then do
     1196     on error undo, return error return-value
     1197     :
     1198       if length(p-message) <= 70 then do:
     1199         assign
     1200           v-left-margin = integer((70 - length(p-message)) / 2)
     1201         .
     1202         assign
     1203           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1204         .
     1205         assign
     1206           v-waitfram-action01 = " "
     1207           v-waitfram-action02 = " "
     1208                                    + fill(" ", v-left-margin)
     1209                                    + p-message
     1210           v-waitfram-action03 = " "
     1211         .
     1212       end.
     1213       else do:
     1214         define variable vRindex1 as integer no-undo.
     1215         define variable vRindex2 as integer no-undo.
     1216         vRindex1 = r-index(p-message," ",70).
     1217         if vRindex1 = 0
     1218         then
     1219            vRindex1 = 70.
     1220         if length(p-message)  <= vRindex1 + 70 then do:
     1221           assign
     1222             v-waitfram-action01 = " "
     1223             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1224             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1225           .
     1226         end.
     1227         else do:
     1228           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1229           if vRindex2 <= vRindex1
     1230           then
     1231              vRindex2 = vRindex1 + 70.
     1232           assign
     1233             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1234             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1235             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1236           .
     1237         end.
     1238       end.
     1239       B-viewProcInfo:visible   in frame waitfram = no.
     1240       B-viewProcInfo:sensitive in frame waitfram = no.
     1241       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1242       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1243       if  (   mWaitFramView
     1244          or  mWaitProcEvent)
     1245          and not mBatchMode
     1246       then
     1247          display
     1248             v-waitfram-action01 skip
     1249             v-waitfram-action02 skip
     1250             v-waitfram-action03 skip
     1251          with frame waitfram .
     1252       if     mWaitFramView
     1253          then do:
     1254             if     mWaitFramInterval ne ?
     1255                and not mBatchMode
     1256             then
     1257                wait-for go of frame waitfram pause mWaitFramInterval.
     1258          end.
     1259          else
     1260             if     mWaitProcEvent
     1261                and not mBatchMode
     1262             then
     1263                process events .
     1264     end.
     1265   end procedure.
     1266      procedure waitfram-show-this:
     1267         define input  parameter iInterval as int64 no-undo.
     1268         define variable vtime as int64 no-undo.
     1269         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1270         mWaitFramInterval = iInterval.
     1271         run waitfram-show (substitute("&1&2 &3&4" ,
     1272                                       mWaitFramTextBeg ,
     1273                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1274                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1275                                       mWaitFramTextEnd
     1276                                      )
     1277                           ).
     1278      end.
     1279      procedure WaitFramRunPause:
     1280         define input  parameter iInterval as dec no-undo.
     1281         define variable vStart  as datetime-tz no-undo.
     1282         define variable vend    as datetime-tz no-undo.
     1283         define variable vint as int64 no-undo.
     1284         define variable vOk as logical no-undo.
     1285         vStart = now.
     1286         vend   = vStart.
     1287         publish "WaitFramPause" (iInterval,output vOk).
     1288         vend   =  now.
     1289         vint = vend - vStart.
     1290         vint = iInterval - vint / 1000.
     1291         if     not mWaitFramStop
     1292            and (   vint > 0
     1293                 or (    not vOk
     1294                     and iInterval eq ?
     1295                     )
     1296                 )
     1297         then
     1298            run waitfram-show-this (iInterval).
     1299         vend   =  now.
     1300         vint = vend - vStart.
     1301         vint = iInterval - vint / 1000.
     1302         if     not mWaitFramStop
     1303            and vint > 0
     1304         then do:
     1305            run gbl/pause.p (vint * 1000).
     1306         end.
     1307         if iInterval ne ?
     1308         then
     1309            publish "WaitFramStop".
     1310         waitfram-check-timeout().
     1311      end.
     1312      procedure WaitFramWaitFor:
     1313         define input  parameter iInterval as dec no-undo.
     1314         assign
     1315            mWaitFramStartProc   = now
     1316            mWaitFramStopUser    = no
     1317            mWaitFramStopTimeOut = no
     1318         .
     1319         block-wait:
     1320         do while not mWaitFramStop:
     1321            run WaitFramRunPause (iInterval).
     1322            if  waitfram-check-timeout()
     1323            then do:
     1324               leave block-wait.
     1325            end.
     1326         end.
     1327         run waitfram-hide.
     1328      end.
     1329   procedure waitfram-join :
     1330     define input  parameter p-line-1  as character no-undo .
     1331     define input  parameter p-line-2  as character no-undo .
     1332     define input  parameter p-line-3  as character no-undo .
     1333     define output parameter p-message as character no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       assign
     1338         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1339                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1340                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1341       .
     1342     end.
     1343   end procedure.
     1344   function waitfram-join-function returns character
     1345     (input p-line-1 as character
     1346     ,input p-line-2 as character
     1347     ,input p-line-3 as character
     1348     ).
     1349     define variable v-message as character no-undo .
     1350     run waitfram-join in this-procedure
     1351       (input  p-line-1
     1352       ,input  p-line-2
     1353       ,input  p-line-3
     1354       ,output v-message
     1355       ) .
     1356     return v-message .
     1357   end function .
     1358   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   define  stream PrnLibStream.
     1360   procedure prn-lib-prn-file :
     1361     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1362     define input parameter p-DIsabledoptions as integer no-undo .
     1363     define variable v-report-name as character no-undo .
     1364     define variable v-user-action as character no-undo .
     1365     define variable v-printed     as logical   no-undo .
     1366     define variable v-exist       as logical   no-undo .
     1367     do
     1368       on error undo, return error
     1369       :
     1370       run prn-lib-get-report-name  in this-procedure (
     1371         input parParentProc
     1372         ,output v-report-name
     1373         ).
     1374   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1376     (input  v-report-name
     1377     ,input  2
     1378     ,output v-exist
     1379     )  .
     1380       if NOT v-exist then
     1381       DO:
     1382         Message
     1383           "Нет заданий на печать ! "
     1384           view-as alert-box .
     1385         Return  .
     1386       End.
     1387       run gbl/prnfilen.w
     1388         (input  ""
     1389         ,input  p-DisabledOptions
     1390         ,input  string(v-report-name )
     1391         ,input  7
     1392         ,output v-user-action
     1393         ,output v-printed
     1394         ) .
     1395       if v-printed then
     1396       do:
     1397         return "YES" .
     1398       end.
     1399       else
     1400       do:
     1401         return "NO" .
     1402       end.
     1403     end.
     1404   end procedure.
     1405   procedure prn-lib-open-stream :
     1406     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1407     define input parameter p-page-size    as integer no-undo .
     1408     define input parameter p-is-stream    as logical no-undo .
     1409     define input parameter p-append       as logical no-undo .
     1410     define variable v-report-name as character no-undo .
     1411     do
     1412       on error undo, return error
     1413       :
     1414       run prn-lib-get-report-name  in this-procedure (
     1415         input parParentProc
     1416         ,output v-report-name
     1417         ).
     1418       if p-is-stream then
     1419       do:
     1420         if p-append then
     1421         do:
     1422           output stream PrnLibStream to value( v-report-name )
     1423             page-size value(p-page-size) append .
     1424         end.
     1425         if not p-append then
     1426         do:
     1427           output stream PrnLibStream to value( v-report-name )
     1428             page-size value(p-page-size) .
     1429         end.
     1430       end.
     1431       if not p-is-stream then
     1432       do:
     1433         if p-append then
     1434         do:
     1435           output to value( v-report-name )
     1436             page-size value(p-page-size) append .
     1437         end.
     1438         if not p-append then
     1439         do:
     1440           output to value( v-report-name )
     1441             page-size value(p-page-size) .
     1442         end.
     1443       end.
     1444     end.
     1445   end procedure.
     1446   procedure prn-lib-open-exp :
     1447     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1448     define input parameter p-is-stream    as logical no-undo .
     1449     define input parameter p-is-append    as logical no-undo .
     1450     define output parameter p-ReportFileName as char init "report" no-undo.
     1451     define output parameter p-process as logical no-undo .
     1452     define variable glog as logical no-undo .
     1453     do
     1454       on error undo, return error
     1455       :
     1456       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1457         TITLE      "Укажите путь"
     1458         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1459         ASK-OVERWRITE
     1460         CREATE-TEST-FILE
     1461         SAVE-AS
     1462         USE-FILENAME
     1463         DEFAULT-EXTENSION "txt"
     1464         UPDATE glog
     1465         .
     1466       if not glog then  return.
     1467       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1468       if p-is-stream then
     1469       do:
     1470         if p-is-append then
     1471         do:
     1472           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1473         end.
     1474         else
     1475         do:
     1476           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1477         end.
     1478       end.
     1479       else
     1480       do:
     1481         if p-is-append then
     1482         do:
     1483           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1484         end.
     1485         else
     1486         do:
     1487           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1488         end.
     1489       end.
     1490       p-process = yes.
     1491     end.
     1492   end procedure.
     1493   procedure prn-lib-get-report-name :
     1494     define input parameter parParentProc  as widget-handle no-undo.
     1495     define output parameter p-report-name as character no-undo .
     1496     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1497   end procedure.
     1498   procedure prn-lib-reportviewer-report-name :
     1499     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1500     define input parameter p-report-name-html as character no-undo .
     1501     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1502   end procedure.
     1503   procedure prn-lib-reportviewer :
     1504     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1505     define input parameter p-report-name-html as character no-undo .
     1506     define input parameter p-param        as character no-undo .
     1507     define variable v-excel           as character no-undo init 'TRUE' .
     1508     define variable v-value-character as character no-undo .
     1509     define variable v-value-integer   as character no-undo .
     1510     define variable v-value-date      as date      no-undo .
     1511     define variable v-value-decimal   as decimal   no-undo .
     1512     define variable rep-excel         as logical   no-undo .
     1513     define variable excel-string      as character no-undo .
     1514     define variable v-param-type      as character no-undo .
     1515     define variable v-tth             as handle    no-undo .
     1516     run adm/shattri.p (
     1517       input "get":U
     1518       ,input  ""
     1519       ,input  0
     1520       ,input  'report-glob':U
     1521       ,input  'rep-excel':U
     1522       ,output v-value-character
     1523       ,output v-value-date
     1524       ,output v-value-decimal
     1525       ,output v-value-integer
     1526       ,output rep-excel
     1527       ,output v-param-type
     1528       ,INPUT-OUTPUT table-handle v-tth
     1529       )  .
     1530     if rep-excel then v-excel = "TRUE" .
     1531     else v-excel = "FALSE" .
     1532     if p-param eq ""
     1533     then
     1534        p-param = "EXCEL:" + v-excel.
     1535     else
     1536        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1537     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1538   end procedure.
     1539   define buffer buf_cli-list  for cli-list.
     1540   define buffer buf_goods     for ub.goods.
     1541   define buffer buf_cli-gds   for ub.cli-gds.
     1542   define variable sym1              as char     init ":"  no-undo.
     1543   define variable sym2              as char     init ":"  no-undo.
     1544   define variable sym3              as char     init ":"  no-undo.
     1545   define variable sym4              as char     init ":"  no-undo.
     1546   define variable v-single-line     as char               no-undo.
     1547   define variable v-under-line      as char               no-undo.
     1548   define variable v-merge-cols      as char     init "/"  no-undo.
     1549   define variable v-notes           as char               no-undo.
     1550   define variable ii                as integer no-undo .
     1551   do
     1552   on error undo, return error
     1553   :
     1554   assign
     1555     v-notes = cur-time-print()
     1556   .
     1557   define frame f-doc
     1558           sym1 column-label ":!:!" format "X(1)" space(0)
     1559           buf_goods.gds-name COLUMN-LABEL "Наименование товара! " format "X(50)" space(0)
     1560           sym2 column-label ":!:!" format "X(1)" space(0)
     1561           buf_goods.artic COLUMN-LABEL "Артикул! " format "X(20)" space(0)
     1562           sym3 column-label ":!:!" format "X(1)" space(0)
     1563           buf_cli-gds.cli-art COLUMN-LABEL "Артикул поставщика! " format "X(20)" space(0)
     1564           sym4 column-label ":!:!" format "X(1)" space(0)
     1565       header
     1566           v-notes at 2 format "X(35)" string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) at 83 format "X(13)" SKIP
     1567           v-single-line format "X(94)" at 1
     1568       with width 235 down stream-io.
     1569   form header
     1570           v-single-line format "X(94)" at 1 SKIP
     1571           "Продолжение - на следующей странице" at 1 SKIP
     1572       with frame BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     1573   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1574        VIEW-AS EDITOR
     1575        SIZE 1 BY 5 NO-UNDO.
     1576   DEFINE FRAME top-frame
     1577   t-1       AT ROW 1 COL 1 no-label
     1578   HEADER
     1579   v-notes AT 5 format "x(35)"
     1580   string( "Страница" ) AT 45 PAGE-NUMBER( PrnLibStream ) AT 55 FORMAT ">>>,>>9" SKIP
     1581       with width 232 down stream-io use-text NO-BOX.
     1582   DEFINE FRAME x1
     1583   with width 232 down stream-io use-text NO-BOX.
     1584   assign
     1585     use-column[1] = yes
     1586     use-column[2] = yes
     1587     use-column[3] = yes
     1588     use-column[4] = yes
     1589     p-frame-width = 94
     1590   .
     1591   FOR EACH sheetf where sheetf.sheet-num > 1:
     1592     delete sheetf.
     1593   end.
     1594   FIND FIRST sheetf where
     1595              sheetf.sheet-num = 1 No-ERROR.
     1596   assign
     1597   ReportName = "Список товаров по поставщикам с артикулами поставщика"
     1598   sheetf.Excel-Column-Lable =  ""
     1599   sheetf.sizes = ""
     1600   Make-Excel = yes
     1601   .
     1602   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1603   l-col-pos = 1.
     1604   assign
     1605     l-col-type = "CHARACTER"
     1606     l-col-len = 50
     1607     l-col-format = "x(50)"
     1608     l-col-lable = "Наименование товара"
     1609   .
     1610     define variable ed1 as handle no-undo.
     1611     define variable l-1 as handle no-undo.
     1612     define variable ll-1 as handle no-undo.
     1613     define variable c-v-gds-name as widget-handle no-undo.
     1614      if l-col-pos > 320 then l-col-pos = 320 .
     1615     if use-column[1] = true then DO:
     1616           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1617             ASSIGN
     1618               FRAME = FRAME top-Frame:HANDLE
     1619               ROW = 1
     1620               COLUMN = l-col-pos
     1621               screen-value = Fill("-", l-col-len)
     1622               WIDTH-CHARS = l-col-len
     1623               HEIGHT-CHARS = 3
