     1646               DATA-TYPE = "CHARACTER"
     1647               FORMAT = "X(":U + string(l-col-len) + ")":U
     1648               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1649               ROW = 1
     1650               COLUMN = l-col-pos
     1651           .
     1652        assign
     1653        l-col-pos =  l-col-pos + l-col-len + 1
     1654        v-r-col-num = v-r-col-num + 1
     1655        .
     1656     end.
     1657   if use-column[1] then
     1658   assign
     1659   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     1660                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1661                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1662                                )
     1663   sheetf.sizes =  (if sheetf.sizes = ""
     1664                    then (sheetf.sizes + string(l-col-len))
     1665                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1666                   )
     1667   last-col-num = 1
     1668   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     1669                                              (if l-col-type = "DATE"
     1670                                               then (
     1671                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1672                                                      then ";":U
     1673                                                      else "":U) +
     1674                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     1675                                                     )
     1676                                               else (if l-col-type = "CHARACTER"
     1677                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     1678                                                           then ";":U
     1679                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     1680                                                     else "":U)
     1681                                               )
     1682   .
     1683   assign
     1684     l-col-type = "CHARASTER"
     1685     l-col-len = 20
     1686     l-col-format = "x(20)"
     1687     l-col-lable = "Артикул"
     1688   .
     1689     define variable ed2 as handle no-undo.
     1690     define variable l-2 as handle no-undo.
     1691     define variable ll-2 as handle no-undo.
     1692     define variable c-v-artic as widget-handle no-undo.
     1693      if l-col-pos > 320 then l-col-pos = 320 .
     1694     if use-column[2] = true then DO:
     1695           CREATE EDITOR LL-2 IN WIDGET-POOL "My-pool"
     1696             ASSIGN
     1697               FRAME = FRAME top-Frame:HANDLE
     1698               ROW = 1
     1699               COLUMN = l-col-pos
     1700               screen-value = Fill("-", l-col-len)
     1701               WIDTH-CHARS = l-col-len
     1702               HEIGHT-CHARS = 3
     1703           .
     1704           CREATE EDITOR ed2 IN WIDGET-POOL "My-pool"
     1705             ASSIGN
     1706               FRAME = FRAME top-Frame:HANDLE
     1707               ROW = 2
     1708               COLUMN = l-col-pos
     1709               screen-value = l-col-lable
     1710               WIDTH-CHARS = l-col-len
     1711               HEIGHT-CHARS = 3
     1712           .
     1713           CREATE EDITOR L-2 IN WIDGET-POOL "My-pool"
     1714             ASSIGN
     1715               FRAME = FRAME top-Frame:HANDLE
     1716               ROW = 4
     1717               COLUMN = l-col-pos
     1718               screen-value = Fill("-", l-col-len)
     1719               WIDTH-CHARS = l-col-len
     1720               HEIGHT-CHARS = 3
     1721           .
