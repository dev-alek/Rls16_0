     1723             ASSIGN
     1724               FRAME = FRAME x1:HANDLE
     1725               DATA-TYPE = "CHARACTER"
     1726               FORMAT = "X(":U + string(l-col-len) + ")":U
     1727               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1728               ROW = 1
     1729               COLUMN = l-col-pos
     1730           .
     1731        assign
     1732        l-col-pos =  l-col-pos + l-col-len + 1
     1733        v-r-col-num = v-r-col-num + 1
     1734        .
     1735     end.
     1736   if use-column[2] then
     1737   assign
     1738   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     1739                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1740                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1741                                )
     1742   sheetf.sizes =  (if sheetf.sizes = ""
     1743                    then (sheetf.sizes + string(l-col-len))
     1744                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1745                   )
     1746   last-col-num = 2
     1747   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     1748                                              (if l-col-type = "DATE"
     1749                                               then (
     1750                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1751                                                      then ";":U
     1752                                                      else "":U) +
     1753                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     1754                                                     )
     1755                                               else (if l-col-type = "CHARACTER"
     1756                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     1757                                                           then ";":U
     1758                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     1759                                                     else "":U)
     1760                                               )
     1761   .
     1762   assign
     1763     l-col-type = "CHARASTER"
     1764     l-col-len = 20
     1765     l-col-format = "x(20)"
     1766     l-col-lable ="Артикул поставщика"
     1767   .
     1768     define variable ed3 as handle no-undo.
     1769     define variable l-3 as handle no-undo.
     1770     define variable ll-3 as handle no-undo.
     1771     define variable c-v-cli-art as widget-handle no-undo.
     1772      if l-col-pos > 320 then l-col-pos = 320 .
     1773     if use-column[3] = true then DO:
     1774           CREATE EDITOR LL-3 IN WIDGET-POOL "My-pool"
     1775             ASSIGN
     1776               FRAME = FRAME top-Frame:HANDLE
     1777               ROW = 1
     1778               COLUMN = l-col-pos
     1779               screen-value = Fill("-", l-col-len)
     1780               WIDTH-CHARS = l-col-len
     1781               HEIGHT-CHARS = 3
     1782           .
     1783           CREATE EDITOR ed3 IN WIDGET-POOL "My-pool"
     1784             ASSIGN
     1785               FRAME = FRAME top-Frame:HANDLE
     1786               ROW = 2
     1787               COLUMN = l-col-pos
     1788               screen-value = l-col-lable
     1789               WIDTH-CHARS = l-col-len
     1790               HEIGHT-CHARS = 3
     1791           .
     1792           CREATE EDITOR L-3 IN WIDGET-POOL "My-pool"
     1793             ASSIGN
     1794               FRAME = FRAME top-Frame:HANDLE
     1795               ROW = 4
     1796               COLUMN = l-col-pos
     1797               screen-value = Fill("-", l-col-len)
     1798               WIDTH-CHARS = l-col-len
     1799               HEIGHT-CHARS = 3
     1800           .
     1801           CREATE FILL-IN C-v-cli-art IN WIDGET-POOL "My-pool"
     1802             ASSIGN
     1803               FRAME = FRAME x1:HANDLE
     1804               DATA-TYPE = "CHARACTER"
     1805               FORMAT = "X(":U + string(l-col-len) + ")":U
     1806               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1807               ROW = 1
     1808               COLUMN = l-col-pos
     1809           .
     1810        assign
     1811        l-col-pos =  l-col-pos + l-col-len + 1
     1812        v-r-col-num = v-r-col-num + 1
     1813        .
     1814     end.
     1815   if use-column[3] then
     1816   assign
     1817   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     1818                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1819                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1820                                )
     1821   sheetf.sizes =  (if sheetf.sizes = ""
     1822                    then (sheetf.sizes + string(l-col-len))
     1823                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1824                   )
     1825   last-col-num = 3
     1826   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     1827                                              (if l-col-type = "DATE"
     1828                                               then (
     1829                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     1830                                                      then ";":U
     1831                                                      else "":U) +
     1832                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     1833                                                     )
     1834                                               else (if l-col-type = "CHARACTER"
     1835                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     1836                                                           then ";":U
     1837                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     1838                                                     else "":U)
     1839                                               )
     1840   .
     1841   assign
     1842     l-col-type = "CHARASTER"
     1843     l-col-len = 50
     1844     l-col-format = "X(50)"
     1845     l-col-lable = "Поставщик"
     1846   .
     1847     define variable ed4 as handle no-undo.
     1848     define variable l-4 as handle no-undo.
     1849     define variable ll-4 as handle no-undo.
     1850     define variable c-v-cli-obj-name as widget-handle no-undo.
     1851      if l-col-pos > 320 then l-col-pos = 320 .
     1852     if use-column[4] = true then DO:
     1853           CREATE EDITOR LL-4 IN WIDGET-POOL "My-pool"
     1854             ASSIGN
     1855               FRAME = FRAME top-Frame:HANDLE
     1856               ROW = 1
     1857               COLUMN = l-col-pos
     1858               screen-value = Fill("-", l-col-len)
     1859               WIDTH-CHARS = l-col-len
     1860               HEIGHT-CHARS = 3
     1861           .
     1862           CREATE EDITOR ed4 IN WIDGET-POOL "My-pool"
     1863             ASSIGN
     1864               FRAME = FRAME top-Frame:HANDLE
     1865               ROW = 2
     1866               COLUMN = l-col-pos
     1867               screen-value = l-col-lable
     1868               WIDTH-CHARS = l-col-len
     1869               HEIGHT-CHARS = 3
     1870           .
     1871           CREATE EDITOR L-4 IN WIDGET-POOL "My-pool"
     1872             ASSIGN
     1873               FRAME = FRAME top-Frame:HANDLE
     1874               ROW = 4
     1875               COLUMN = l-col-pos
     1876               screen-value = Fill("-", l-col-len)
     1877               WIDTH-CHARS = l-col-len
     1878               HEIGHT-CHARS = 3
     1879           .
     1880           CREATE FILL-IN C-v-cli-obj-name IN WIDGET-POOL "My-pool"
     1881             ASSIGN
     1882               FRAME = FRAME x1:HANDLE
     1883               DATA-TYPE = "CHARACTER"
     1884               FORMAT = "X(":U + string(l-col-len) + ")":U
     1885               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     1886               ROW = 1
     1887               COLUMN = l-col-pos
     1888           .
     1889        assign
     1890        l-col-pos =  l-col-pos + l-col-len + 1
     1891        v-r-col-num = v-r-col-num + 1
     1892        .
     1893     end.
     1894   if use-column[4] then
     1895   assign
     1896   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     1897                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     1898                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     1899                                )
     1900   sheetf.sizes =  (if sheetf.sizes = ""
     1901                    then (sheetf.sizes + string(l-col-len))
     1902                    else (sheetf.sizes + chr(44) + string(l-col-len))
     1903                   )
     1904   last-col-num = 4
     1905   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     1906                                              (if l-col-type = "DATE"
