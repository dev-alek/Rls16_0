     7086   procedure main-road-taxs :
     7087   define input param p-artic     like ub.gds-obj.artic     no-undo .
     7088   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     7089   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     7090   define input-output param p-road-tax-base as decimal no-undo .
     7091   define input-output param p-road-tax-rubl as decimal no-undo .
     7092       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     7093       define buffer   in-vatp-parts    for ub.parts   .
     7094       define buffer   in-vatp-doc      for ub.trn-doc .
     7095       define buffer   in-vatp-goods    for ub.goods   .
     7096       define buffer   in-vatp-sysconf  for ub.sysconf .
     7097       define buffer   in-vatp_doc-attr for ub.doc-attr.
     7098       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     7099       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     7100       define variable varinvprb                  as   character              no-undo.
     7101       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     7102       define variable cli-base-rate              as   decimal                no-undo.
     7103       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     7104       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     7105       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     7106       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     7107       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     7108       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     7109       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     7110       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     7111       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     7112       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     7113       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     7114       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     7115       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     7116       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     7117       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     7118       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     7119       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     7120       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     7121       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     7122       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     7123       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     7124       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     7125       define variable varinvatp-envd             as   character              no-undo.
     7126       define variable varinvatp-type             as   character              no-undo.
     7127     do
     7128     on error undo, return error return-value
     7129     :
     7130   define buffer buff-goods   for ub.goods    .
     7131   define buffer buf_gds-obj  for ub.gds-obj  .
     7132   define buffer buf_parts    for ub.parts    .
     7133   define buffer buf_trn-doc  for ub.trn-doc  .
     7134   define buffer buf_doc-line for ub.doc-line .
     7135   define variable is-petrolium as logical   no-undo .
     7136   define variable is-pieces   as  logical   no-undo .
     7137   define variable p-in-code   as  character no-undo .
     7138   define variable p-obj-type  as  character no-undo .
     7139   define variable p-obj-code  as  integer   no-undo .
     7140   define variable v-rec as recid no-undo .
     7141   define variable t-ret as logical no-undo .
     7142   define variable v-total-avrg-base as decimal no-undo .
     7143   define variable v-total-avrg-rubl as decimal no-undo .
     7144   define variable v-total-avrg-qnty as decimal no-undo .
     7145   define variable v-total-road-tax-base     as decimal no-undo .
     7146   define variable v-total-road-tax-rubl     as decimal no-undo .
     7147   define variable v-all-total-road-tax-base as decimal no-undo .
     7148   define variable v-all-total-road-tax-rubl as decimal no-undo .
     7149   assign
     7150     p-road-tax-base = 0
     7151     p-road-tax-rubl = 0
     7152     .
     7153     Find first buff-goods no-lock where
     7154                buff-goods.artic     = p-artic and
     7155                buff-goods.prod-type = p-prod-type and
     7156                buff-goods.prod-code = p-prod-code
     7157         no-error .
     7158         if available buff-goods then do:
     7159            v-rec = recid (buff-goods).
     7160            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     7161   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7162     (
     7163        input p-artic
     7164     ,  input p-prod-type
     7165     ,  input p-prod-code
     7166     , output is-petrolium
     7167     , output is-pieces
     7168     ) .
     7169              t-ret =  session:SET-WAIT-STATE("") .
     7170              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     7171                 assign
     7172                   p-road-tax-base = 0
     7173                   p-road-tax-rubl = 0
     7174                   .
     7175                  return.
     7176              end.
     7177         end.
     7178         assign
     7179             v-total-avrg-qnty = 0
     7180             v-total-road-tax-base =  0
     7181             v-total-road-tax-rubl =  0
     7182             v-all-total-road-tax-base =  0
     7183             v-all-total-road-tax-rubl =  0
     7184             .
     7185       for each  x_obj-group ,
     7186           each buf_parts no-lock
     7187           where buf_parts.obj-type  = x_obj-group.obj-type
     7188             and buf_parts.obj-code  = x_obj-group.obj-code
     7189             and buf_parts.artic     = p-artic
     7190             and buf_parts.prod-type = p-prod-type
     7191             and buf_parts.prod-code = p-prod-code
     7192             and buf_parts.status_   = no
     7193             and buf_parts.out-code  = 'free-zone':U
     7194             and buf_parts.qnty      > 0
     7195         on error undo, return error
     7196         :
     7197            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     7198   assign
     7199     price-rubl-with-tax-loc = buf_parts.price-rubl
     7200     price-base-with-tax-loc = buf_parts.price-base
     7201   .
     7202   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7204     (output varinvprb
     7205     )  .
     7206     if buf_parts.out-code = 'free-zone':U     or
     7207        buf_parts.out-code = 'out-zone':U   or
     7208        buf_parts.doc-type = 'акт':U then do:
     7209       assign
     7210         in-vatp-have-vat-slt = yes.
     7211     end.
     7212     else do:
     7213       find first in-vatp_doc-attr no-lock
     7214         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     7215           and in-vatp_doc-attr.attr-code = 'envd':U
     7216         no-error .
     7217       if not available in-vatp_doc-attr then do:
     7218         assign
     7219           in-vatp-have-vat-slt = yes.
     7220       end.
     7221       else do:
     7222            in-vatp-have-vat-slt = no.
     7223       end.
     7224     end.
     7225     assign
     7226      price-cli-with-tax-loc = buf_parts.price-cli
     7227      cli-base-rate          = buf_parts.cli-base-rate.
     7228     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     7229              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     7230     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     7231             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     7232             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     7233             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     7234             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     7235             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     7236             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
