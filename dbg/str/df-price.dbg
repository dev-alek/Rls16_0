     6764       ,v-road-tax-base
     6765       ,v-road-tax-doc
     6766       ,v-road-tax-rubl
     6767       ,v-excise-base
     6768       ,v-excise-doc
     6769       ,v-excise-rubl
     6770       ,v-vat-pc
     6771       ,v-slt-pc
     6772       ,v-prev-doc-code
     6773       ,0
     6774       ,input-output v-sec
     6775        ) no-error  .
     6776        if error-status :error then
     6777        message
     6778          vss-workfile vss-revision vss-description skip
     6779          error-status :get-message(1) skip
     6780          return-value skip
     6781          "4567"
     6782          view-as alert-box error
     6783        .
     6784     end.
     6785   end procedure.
     6786   procedure re-define :
     6787   define input-output parameter p-calc-method      as character no-undo .
     6788   define input        parameter p-gds-code         as integer   no-undo .
     6789     do
     6790     on error undo, return error return-value
     6791     :
     6792   define buffer buf_goods for ub.goods  .
     6793   define buffer buf_gds-grp for ub.gds-grp  .
     6794       case p-calc-method :
     6795         when 'Товар':U then do:
     6796              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6797                   case buf_goods.calc-method:
     6798                     when 'Группа':U then do:
     6799                       find first buf_gds-grp no-lock where
     6800                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6801                       p-calc-method  = buf_gds-grp.calc-method.
     6802                     end.
     6803                   otherwise do:
     6804                       p-calc-method  =  buf_goods.calc-method .
     6805                   end.
     6806                   end case.
     6807              run  re-define in this-procedure (
     6808                         input-output  p-calc-method ,
     6809                         input p-gds-code )  .
     6810         end.
     6811         when 'Группа':U then do:
     6812              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     6813              find first buf_gds-grp no-lock where
     6814                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     6815              run re-define in this-procedure (
     6816                         input-output buf_gds-grp.calc-method ,
     6817                         input p-gds-code )  .
     6818         end.
     6819         when 'Учетная':U or
     6820         when 'Учет-объект':U then do:
     6821              p-calc-method = 'УчетнаяS':U .
     6822         end.
     6823         when 'Учет-резерв':U then do:
     6824              p-calc-method = 'Учет-рзрвS':U.
     6825         end.
     6826         when 'Приходная':U or
     6827         when 'Прих-объект':U then do:
     6828              p-calc-method = 'ПриходнаяS':U.
     6829         end.
     6830         when 'Учет-безНДС':U then do:
     6831              p-calc-method = 'Учет-НДСS':U .
     6832         end.
     6833       end case.
     6834     end.
     6835   end procedure.
     6836   procedure create-line-pdf-mpl-lib :
     6837   define input  parameter  p-plt-db-num as integer   no-undo .
     6838   define input  parameter  p-plt-id     as integer   no-undo .
     6839   define input  parameter  p-pdf-db     as integer   no-undo .
