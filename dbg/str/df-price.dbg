      172     .
      173   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   define  new shared  temp-table gds-list-hist no-undo
      175   field list-table as character
      176   field id as integer
      177   field line as integer
      178   field hist-mode as character
      179   field des as character
      180   field num-recs as integer
      181   field option_ as character
      182   field item_ as character
      183   field status_ as character
      184   field num-add as integer
      185   field num-ignored as integer
      186   field done as logical
      187   field err_ as logical
      188   field err-mes as character
      189   index pi is primary
      190   id
      191   line
      192   index isdone
      193   done
      194   .
      195   define variable v-str as character no-undo .
      196   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      197   define temp-table x_obj-group no-undo like ub.clients  .
      198   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      199   procedure metod-gop-obj :
      200     do
      201     on error undo, return error return-value
      202     :
      203   define input  parameter p-cntxt-db-num as integer   no-undo .
      204   define input  parameter p-gop-id       as integer   no-undo .
      205   define input  parameter p-gop-db-num   as integer   no-undo .
      206   define buffer buf1_clients for ub.clients  .
      207   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      208   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      209   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      210   for each  x_obj-group : delete x_obj-group. end.
      211   if p-gop-id = 0 or p-gop-id = ?  then do:
      212      if p-cntxt-db-num = 0  then do:
      213           for each buf1_clients no-lock where
      214                   (buf1_clients.obj-type = 'маг':U  or
      215                    buf1_clients.obj-type = 'скл':U  )
      216                   and
      217                   buf1_clients.db-num >= 0  and
      218                   buf1_clients.stts = 0
      219                   :
      220             create x_obj-group .
      221             assign
      222               x_obj-group.obj-code   = buf1_clients.obj-code
      223               x_obj-group.obj-type   = buf1_clients.obj-type
      224               x_obj-group.obj-name   = buf1_clients.obj-name
      225               x_obj-group.db-num     = buf1_clients.db-num
      226             .
      227           end.
      228      end.
      229      else do:
      230           for each buf1_clients no-lock where
      231                   (buf1_clients.obj-type = 'маг':U  or
      232                    buf1_clients.obj-type = 'скл':U  ) and
      233                    buf1_clients.db-num = p-cntxt-db-num  and
      234                    buf1_clients.stts = 0
      235                   :
      236             create x_obj-group .
      237             assign
      238               x_obj-group.obj-code   = buf1_clients.obj-code
      239               x_obj-group.obj-type   = buf1_clients.obj-type
      240               x_obj-group.obj-name   = buf1_clients.obj-name
      241               x_obj-group.db-num     = buf1_clients.db-num
      242             .
      243           end.
      244      end.
      245   end.
      246   else do:
      247         for each buf_db-grp-obj-price  where
      248                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      249                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      250                 buf_db-grp-obj-price.stts = 0  no-lock :
      251           for each buf1_clients no-lock where
      252                  (buf1_clients.obj-type = 'маг':U  or
      253                   buf1_clients.obj-type = 'скл':U  ) and
      254                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      255                   buf1_clients.stts = 0
      256                   :
      257             create x_obj-group .
      258             assign
      259               x_obj-group.obj-code   = buf1_clients.obj-code
      260               x_obj-group.obj-type   = buf1_clients.obj-type
      261               x_obj-group.obj-name   = buf1_clients.obj-name
      262               x_obj-group.db-num     = buf1_clients.db-num
      263             .
      264           end.
      265         end.
      266       for each buf_host-grp-obj-price where
      267               buf_host-grp-obj-price.gop-id     = p-gop-id and
      268               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      269               buf_host-grp-obj-price.stts = 0
      270               no-lock :
      271         for each buf1_clients no-lock where
      272                (buf1_clients.obj-type = 'маг':U  or
      273                 buf1_clients.obj-type = 'скл':U  ) and
      274                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      275                 buf1_clients.stts = 0
      276                 :
      277             find first x_obj-group no-lock  where
      278                       x_obj-group.obj-code   = buf1_clients.obj-code and
      279                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      280             if not available  x_obj-group then   create x_obj-group .
      281             assign
      282               x_obj-group.obj-code   = buf1_clients.obj-code
      283               x_obj-group.obj-type   = buf1_clients.obj-type
      284               x_obj-group.obj-name   = buf1_clients.obj-name
      285               x_obj-group.db-num     = buf1_clients.db-num
      286             .
      287         end.
      288       end.
      289       for each buf_obj-grp-obj-price where
      290               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      291               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      292               buf_obj-grp-obj-price.stts = 0
      293               no-lock :
      294         for each buf1_clients no-lock where
      295                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      296                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      297                   buf1_clients.stts     = 0
      298                   :
      299             find first  x_obj-group no-lock  where
      300                         x_obj-group.obj-code   = buf1_clients.obj-code and
      301                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      302             if not available  x_obj-group then   create x_obj-group .
      303             assign
      304               x_obj-group.obj-code   = buf1_clients.obj-code
      305               x_obj-group.obj-type   = buf1_clients.obj-type
      306               x_obj-group.obj-name   = buf1_clients.obj-name
      307               x_obj-group.db-num     = buf1_clients.db-num
      308             .
      309         end.
      310       end.
      311   end.
      312   end.
      313   end procedure.
      314   procedure metod-obj-in-gop :
      315   define input  parameter p-curr-db-num as integer   no-undo .
      316   define input  parameter p-obj-type as character no-undo .
      317   define input  parameter p-obj-code as integer   no-undo .
      318   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      319     do
      320     on error undo, return error return-value
      321     :
      322       empty temp-table x_grp-obj-price.
      323       for each buf_grp-obj-price where
      324                buf_grp-obj-price.stts = 0
      325                no-lock :
      326                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      327                  for each x_obj-group where
      328                           x_obj-group.obj-type = p-obj-type and
      329                           x_obj-group.obj-code = p-obj-code :
      330                       create  x_grp-obj-price.
      331                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      332                  end.
      333       end.
      334     end.
      335   end procedure.
      336   procedure metod-delobj-usr :
      337   define input  parameter p-pdf-id  as integer   no-undo .
      338   define input  parameter p-pdf-db  as integer   no-undo .
      339   define input  parameter p-plt-id  as integer   no-undo .
      340   define input  parameter p-plt-db-num as integer   no-undo .
      341   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      342     do
      343     on error undo, return error return-value
      344     :
      345   for each buf_price-doc-forming-attr no-lock  where
      346            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      347            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      348            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      349            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      350            buf_price-doc-forming-attr.attr-code begins "obj" :
      351      for each x_obj-group  where
      352               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      353               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      354        delete x_obj-group.
      355      end.
      356   end.
      357     if not can-find (first x_obj-group) then do:
      358        return "nullobj" .
      359     end.
      360   end.
      361   end procedure.
      362   procedure metod-obj-pdf :
      363   define input  parameter p-cntxt-db-num as integer   no-undo .
      364   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      365   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      366   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      367   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      368   define buffer buf_price-list-type for ub.price-list-type  .
      369   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      370     do
      371     on error undo, return error return-value
      372     :
      373    for each  x_obj-group : delete x_obj-group. end.
      374    find first buf_price-list-type no-lock where
      375               buf_price-list-type.plt-id = p-plt-id and
      376               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      377   if error-status :error then return error return-value .
      378    find first buf_price-doc-forming no-lock where
      379               buf_price-doc-forming.plt-id     = p-plt-id and
      380               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      381               buf_price-doc-forming.pdf-id     = p-pdf-id and
      382               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      383               no-error .
      384   if error-status :error then return error return-value .
      385     run metod-gop-obj in this-procedure (
      386         p-cntxt-db-num,
      387         buf_price-list-type.gop-id ,
      388         buf_price-list-type.gop-db-num
      389         ) no-error .
      390     run metod-delobj-usr in this-procedure (
      391       buf_price-doc-forming.pdf-id ,
      392       buf_price-doc-forming.pdf-db ,
      393       buf_price-doc-forming.plt-id ,
      394       buf_price-doc-forming.plt-db-num
      395       ) no-error .
      396     end.
      397   end procedure.
      398   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   procedure grp-obj-write :
      401   do
      402   on error undo, return error
      403   :
      404   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      405   define input parameter p-host-code  as integer                          no-undo.
      406   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      407   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      408   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      409   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      410   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      411   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      412   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      413   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      414   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      415   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      416   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      417       find first buf_gds-grp-obj exclusive-lock
      418            where buf_gds-grp-obj.node-code  = p-node-code
      419              and buf_gds-grp-obj.host-code  = p-host-code
      420              and buf_gds-grp-obj.obj-type   = p-obj-type
      421              and buf_gds-grp-obj.obj-code   = p-obj-code
      422       no-error.
      423       if not available buf_gds-grp-obj
      424       then do:
      425           create buf_gds-grp-obj.
      426           assign
      427                   buf_gds-grp-obj.node-code  = p-node-code
      428                   buf_gds-grp-obj.host-code  = p-host-code
      429                   buf_gds-grp-obj.obj-type   = p-obj-type
      430                   buf_gds-grp-obj.obj-code   = p-obj-code
      431           .
      432       end.
      433       assign
      434       buf_gds-grp-obj.min-increase = p-min-increase
      435       buf_gds-grp-obj.max-increase = p-max-increase
      436       buf_gds-grp-obj.increase-pc = p-increase-pc
      437       buf_gds-grp-obj.calc-method = p-calc-method
      438       buf_gds-grp-obj.round-method = p-round-method
      439       buf_gds-grp-obj.round-coef = p-round-coef
      440       buf_gds-grp-obj.cli-type   = p-cli-type
      441       buf_gds-grp-obj.cli-code   = p-cli-code
      442       .
      443   end.
      444   end procedure.
      445   procedure grp-obj-margin-value :
      446   do
      447   on error undo, return error
      448   :
      449   define input parameter p-node-code as integer      no-undo.
      450   define input parameter p-obj-type  as character    no-undo.
      451   define input parameter p-obj-code  as integer      no-undo.
      452   define output parameter p-min-value as decimal      no-undo init ?.
      453   define output parameter p-max-value as decimal      no-undo init ?.
      454   define output parameter p-increase-pc as decimal      no-undo init ?.
      455   define output parameter p-round-method as character no-undo init "":U.
      456   define output parameter p-base as decimal no-undo init ?.
      457   define output parameter p-range-margin     as integer      no-undo.
      458   define output parameter p-exists-margin    as logical      no-undo.
      459   define output parameter p-range-increase     as integer      no-undo.
      460   define output parameter p-exists-increase    as logical      no-undo.
      461   define output parameter p-range-rmethod     as integer no-undo .
      462   define output parameter p-exists-rmethod    as logical no-undo .
      463   define variable v-host-code as integer      no-undo.
      464   DEFINE VARIABLE v-found as logical no-undo .
      465   DEFINE VARIABLE v-exists as logical no-undo .
      466   DEFINE VARIABLE v-range as integer no-undo .
      467   DEFINE VARIABLE jj as integer no-undo .
      468   DEFINE VARIABLE v-margin-found as logical no-undo .
      469   DEFINE VARIABLE v-increase-found as logical no-undo .
      470   DEFINE VARIABLE v-min-value as decimal      no-undo.
      471   DEFINE VARIABLE v-max-value as decimal      no-undo.
      472   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      473   define variable v-round-method as character no-undo .
      474   define variable v-base as decimal no-undo .
      475   define variable v-print-code as character no-undo .
      476   define buffer buf_gds-grp for ub.gds-grp.
      477   find first buf_gds-grp no-lock where
      478              buf_gds-grp.node-code = p-node-code no-error .
      479   if not avail buf_gds-grp and p-node-code <> 0 then do:
      480     message
      481       vss-workfile vss-revision vss-description
      482       skip "Не удалось найти группу товаров с кодом" p-node-code
      483       view-as alert-box error .
      484     undo, return error .
      485   end.
      486   if p-obj-type <> '' then do:
      487   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      489     (input  p-obj-type
      490     ,input  p-obj-code
      491     ,output v-host-code
      492     ) no-error .
      493     if error-status :error
      494     then do:
      495         message
      496           vss-workfile vss-revision vss-description
      497           skip "Не удалось найти фирму объекта"
      498           skip p-obj-type p-obj-code
      499           skip return-value
      500           skip trim(error-status :get-message(1))
      501               trim(error-status :get-message(2))
      502               trim(error-status :get-message(3))
      503               trim(error-status :get-message(4))
      504               trim(error-status :get-message(5))
      505         view-as alert-box error.
      506         undo, return error .
      507     end.
      508   end.
      509   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      510   do while v-found = no and jj < 2:
      511     if v-range <> 3 then do:
      512       find first buf_gds-grp-obj no-lock
      513           where buf_gds-grp-obj.node-code = p-node-code
      514             and buf_gds-grp-obj.host-code = v-host-code
      515             and buf_gds-grp-obj.obj-type  = p-obj-type
      516             and buf_gds-grp-obj.obj-code  = p-obj-code
      517       no-error .
      518     end.
      519     if v-range = 3 or not available buf_gds-grp-obj
      520     then do:
      521        if v-range <> 2 then do:
      522           find first buf_gds-grp-obj no-lock
      523               where buf_gds-grp-obj.node-code = p-node-code
      524                 and buf_gds-grp-obj.host-code = v-host-code
      525                 and buf_gds-grp-obj.obj-type  = ""
      526                 and buf_gds-grp-obj.obj-code  = 0
      527           no-error .
      528         end.
      529         if v-range = 2 or not available buf_gds-grp-obj
      530         then do:
      531             if v-range <> 1 then do:
      532               find first buf_gds-grp-obj no-lock
      533                   where buf_gds-grp-obj.node-code = p-node-code
      534                   and buf_gds-grp-obj.host-code = 0
      535                   and buf_gds-grp-obj.obj-type  = ""
      536                   and buf_gds-grp-obj.obj-code  = 0
      537               no-error .
      538             end.
      539             if v-range = 1 or not available buf_gds-grp-obj
      540             then do:
      541                 assign
      542                     v-exists = no
      543                 .
      544             end.
      545             else do:
      546                 assign
      547                     v-exists = yes
      548                     v-range = 1
      549                 .
      550             end.
      551         end.
      552         else do:
      553             assign
      554                 v-exists = yes
      555                 v-range  = 2
      556             .
      557         end.
      558     end.
      559     else do:
      560         assign
      561             v-exists = yes
      562             v-range  = 3
      563         .
      564     end.
      565     if available buf_gds-grp-obj
      566     then do:
      567       assign
      568       v-min-value    = buf_gds-grp-obj.min-increase
      569       v-max-value    = buf_gds-grp-obj.max-increase
      570       v-increase-pc  = buf_gds-grp-obj.increase-pc
      571       v-round-method = buf_gds-grp-obj.round-method
      572       v-base         = buf_gds-grp-obj.round-coef
      573       .
      574       assign
      575       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      576                           then yes
      577                           else p-exists-margin)
      578       p-range-margin = if p-exists-margin and p-min-value = ?
      579                         then v-range
      580                         else p-range-margin
      581       p-min-value   =  if p-exists-margin and  p-min-value = ?
      582                         then v-min-value
      583                         else p-min-value
      584       p-max-value   =  if p-exists-margin and  p-max-value = ?
      585                         then v-max-value
      586                         else p-max-value
      587       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      588                           then yes
      589                           else p-exists-increase)
      590       p-range-increase = if p-exists-increase and p-increase-pc = ?
      591                         then v-range
      592                         else p-range-increase
      593       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      594                         then v-increase-pc
      595                         else p-increase-pc)
      596       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      597                           then yes
      598                           else p-exists-rmethod
      599       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      600                           then v-range
      601                           else p-range-rmethod)
      602       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      603                           then v-round-method
      604                           else p-round-method)
      605       p-base          = (if p-exists-rmethod and p-base = ?
      606                           then v-base
      607                           else p-base)
      608       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      609       jj = jj + 1
      610       .
      611     end.
      612     else do:
      613       assign
      614       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      615       jj = jj + 1
      616       .
      617     end.
      618   end.
      619   end.
      620   end procedure.
      621   procedure grp-obj-income-cli-value :
      622   do
