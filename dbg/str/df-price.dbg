    17453   PROCEDURE proc-b-mark :
    17454   define variable varlog as logical   no-undo .
    17455     if not available buf_price-doc-forming-gds then return.
    17456     run local-mark in this-procedure.
    17457     assign varlog = BROWSE-1 :select-next-row( ) in frame Dialog-Frame.
    17458     apply "ENTRY":U to BROWSE-1 in frame Dialog-Frame.
    17459     BROWSE-1:refresh() in frame Dialog-Frame .
    17460     run vc-pdf in this-procedure .
    17461   END PROCEDURE.
    17462   PROCEDURE proc-b-move :
    17463   define input parameter par-action as character no-undo.
    17464   define variable  loc#log as logical no-undo .
    17465     assign
    17466     p-doc-rec = recid( buf_price-doc-forming )
    17467     .
    17468     case par-action:
    17469       when "b-next":u then do:
    17470         if valid-handle (p-br-handle) then do:
    17471             loc#log = p-br-handle:select-next-row().
    17472         end.
    17473       end.
    17474       when "b-prev":u then do:
    17475         if valid-handle (p-br-handle) then do:
    17476             loc#log = p-br-handle:select-prev-row().
    17477         end.
    17478       end.
    17479     end case.
    17480     assign p-doc-rec = p-buffer-handle:recid .
    17481     if not loc#log then do:
    17482       message
    17483         "Это" ( if par-action = "b-next":u then "последний" else "первый" )
    17484         "документ в списке!"
    17485       view-as alert-box information.
    17486       return no-apply.
    17487     end.
    17488   END PROCEDURE.
    17489   PROCEDURE proc-end-o :
    17490      hide FILL-IN_end-shift-date in frame Dialog-Frame
    17491           FILL-IN_end-shift-num
    17492           FILL-IN_end-date
    17493           FILL-IN_end-sys-date
    17494           l-loc-hour-2
    17495           l-loc-min-2
    17496           in frame Dialog-Frame .
    17497   if buf-price-list-type.main = true then do:
    17498      hide FILL-IN_have-end-period in frame Dialog-Frame .
    17499      return .
    17500   end.
    17501   if FILL-IN_have-end-period   =  true then do:
    17502      case buf-price-list-type.work-date:
    17503      when integer( '1':U ) then do:
    17504         if p-mode <> 'ПРОСМОТР':U
    17505         then enable FILL-IN_end-date with frame Dialog-Frame .
    17506         display FILL-IN_end-date with frame Dialog-Frame .
    17507      end.
    17508      when integer( '2':U ) then do:
    17509         display FILL-IN_end-shift-date FILL-IN_end-shift-num  with frame Dialog-Frame .
    17510         if p-mode <> 'ПРОСМОТР':U then enable FILL-IN_end-shift-date FILL-IN_end-shift-num  with frame Dialog-Frame .
    17511      end.
    17512      when integer( '3':U ) then do:
    17513         display FILL-IN_end-sys-date l-loc-hour-2 l-loc-min-2 with frame Dialog-Frame .
    17514         if p-mode <> 'ПРОСМОТР':U then enable FILL-IN_end-sys-date l-loc-hour-2 l-loc-min-2  with frame Dialog-Frame .
    17515      end.
    17516      end case.
    17517   end.
    17518   END PROCEDURE.
    17519   PROCEDURE proc-start-o :
    17520      hide FILL-IN_start-shift-date in frame Dialog-Frame
    17521           FILL-IN_start-shift-num
    17522           FILL-IN_start-date
    17523           FILL-IN_start-sys-date
    17524           l-loc-hour
    17525           l-loc-min
    17526           in frame Dialog-Frame .
    17527   if buf-price-list-type.main = true then do:
    17528      hide FILL-IN_have-start-period in frame Dialog-Frame .
    17529      return .
    17530   end.
    17531   if FILL-IN_have-start-period  =  true then do:
    17532      case buf-price-list-type.work-date:
    17533      when integer ( '1':U ) then do:
    17534         display FILL-IN_start-date with frame Dialog-Frame .
    17535         if p-mode <> 'ПРОСМОТР':U then enable FILL-IN_start-date with frame Dialog-Frame .
    17536      end.
    17537      when integer ( '2':U ) then do:
    17538         display FILL-IN_start-shift-date FILL-IN_start-shift-num with frame Dialog-Frame .
    17539         if p-mode <> 'ПРОСМОТР':U then enable FILL-IN_start-shift-date FILL-IN_start-shift-num  with frame Dialog-Frame .
    17540      end.
    17541      when integer ( '3':U ) then do:
    17542         display FILL-IN_start-sys-date l-loc-hour l-loc-min with frame Dialog-Frame .
    17543         if p-mode <> 'ПРОСМОТР':U then enable FILL-IN_start-sys-date l-loc-hour l-loc-min with frame Dialog-Frame .
    17544      end.
    17545      end case.
    17546   end.
    17547   END PROCEDURE.
    17548   PROCEDURE proc-value-1 :
    17549     case calc-method :
    17550       when 'Объект':U then do:
    17551         enable copy-type copy-code r-copy with frame Dialog-Frame.
    17552         display copy-type copy-code with frame Dialog-Frame.
    17553       end.
    17554       when 'Накладная':U or
    17555       when 'Накл-безНДС':U or
    17556       when 'НсП+накл':U or
    17557       when 'Переоценка':U or
    17558       when 'ДокФормЦены':U
    17559       then do:
    17560         enable doc-code r-copy with frame Dialog-Frame.
    17561         display doc-code with frame Dialog-Frame.
    17562       end.
    17563       when 'Единая':U then do:
    17564         enable common-price with frame Dialog-Frame.
    17565         display common-price with frame Dialog-Frame.
    17566       end.
    17567     end case.
    17568   if (calc-method = 'Накладная':U or
    17569       calc-method = 'Накл-безНДС':U or
    17570       calc-method = 'НсП+накл':U or
    17571       calc-method = 'Переоценка':U or
    17572       calc-method = 'ДокФормЦены':U
    17573       ) and
    17574      doc-code = "" then
    17575     apply "entry" to doc-code in frame Dialog-Frame.
    17576   else do:
    17577      if (calc-method = 'Единая':U ) then apply "entry" to common-price in frame Dialog-Frame.
    17578      else
    17579      apply "entry" to browse-1 in frame Dialog-Frame.
    17580   end.
    17581     if par-is-pharm = "yes" then do:
    17582         display
    17583           doc-code
    17584         with frame Dialog-Frame no-error .
    17585         enable doc-code r-copy with frame Dialog-Frame .
    17586      end.
    17587   END PROCEDURE.
    17588   PROCEDURE proc-value-2 :
    17589   if  lookup( input frame Dialog-Frame round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
    17590       enable round-base with frame Dialog-Frame.
    17591   end.
    17592   ELSE do:
    17593       hide round-base in frame Dialog-Frame.
    17594   end.
    17595   END PROCEDURE.
    17596   PROCEDURE recalc-neos :
    17597   define input  parameter p-b-code    as integer   no-undo .
    17598   define input  parameter p-artic     as character no-undo .
    17599   define input  parameter p-prod-type as character no-undo .
    17600   define input  parameter p-prod-code as integer   no-undo .
    17601   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
    17602   for each buf_price-doc-forming-gds exclusive-lock where
    17603                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    17604                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    17605                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    17606                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    17607                buf_price-doc-forming-gds.artic = p-artic and
    17608                buf_price-doc-forming-gds.prod-type = p-prod-type and
    17609                buf_price-doc-forming-gds.prod-code = p-prod-code and
    17610                buf_price-doc-forming-gds.b-code    <>  p-b-code
    17611                :
    17612     run calc-price-alt in this-procedure
    17613         (input  buf_price-doc-forming-gds.b-code
    17614         ,input  recid ( buf_price-doc-forming )
    17615         ,input  buf_price-doc-forming-gds.d-pcnt
    17616         ,input  round-method
    17617         ,input  round-base
    17618         ,output buf_price-doc-forming-gds.price-sale-base
    17619         ,output buf_price-doc-forming-gds.price-sale-doc
    17620         ,output buf_price-doc-forming-gds.price-sale-rubl
    17621         ).
    17622   end.
    17623   END PROCEDURE.
    17624   PROCEDURE save-header :
    17625   do
    17626     on error undo, return error return-value
    17627     :
    17628     define variable v-param-sp as character no-undo .
    17629     if calc-method  = ? then calc-method  = ''.
    17630     if increase-pc  = ? then     increase-pc  = 0 .
    17631     if round-method = ? then     round-method = ''.
    17632     if round-base   = ? then     round-base   =  0.
    17633     if doc-code     = ? then     doc-code     = '' .
    17634     if common-price = ? then     common-price =   0 .
    17635     if copy-type    = ? then     copy-type    = ''  .
    17636     if copy-code    = ? then     copy-code    =    0 .
    17637   v-param-sp =                       calc-method + chr(4)      .
    17638   v-param-sp = v-param-sp + string(  increase-pc   ) + chr(4).
    17639   v-param-sp = v-param-sp +          round-method    + chr(4).
    17640   v-param-sp = v-param-sp +  string( round-base   ) + chr(4).
    17641   v-param-sp = v-param-sp +          doc-code        + chr(4).
    17642   v-param-sp = v-param-sp +  string( common-price ) + chr(4).
    17643   v-param-sp = v-param-sp +          copy-type                  .
    17644   v-param-sp = v-param-sp +  string( copy-code    ) .
    17645   run pdf-write (
    17646       buf_price-doc-forming.pdf-id  ,
    17647       buf_price-doc-forming.pdf-db  ,
    17648       buf_price-doc-forming.plt-id  ,
    17649       buf_price-doc-forming.plt-db-num ,
    17650       'pricedocI' ,
    17651       v-param-sp
    17652       ) no-error .
    17653   if error-status :error then message
    17654     vss-workfile vss-revision vss-description skip
    17655     error-status :get-message(1) skip
    17656     return-value skip
    17657     ""
    17658     view-as alert-box error
    17659   .
    17660     end.
    17661   end procedure.
    17662   PROCEDURE save-proc :
    17663      run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf-price-list-type.gop-id , buf-price-list-type.gop-db-num) .
    17664      run metod-delobj-usr (
    17665       buf_price-doc-forming.pdf-id  ,
    17666       buf_price-doc-forming.pdf-db ,
    17667       buf_price-doc-forming.plt-id    ,
    17668       buf_price-doc-forming.plt-db-num
    17669      ).
    17670       if return-value = "nullobj"  then
    17671      do:
    17672       message
    17673         "Внимание !!! Нет ни одного объекта для ДНЦ !!!"
    17674         view-as alert-box error
    17675         .
    17676        return error "Внимание !!! Нет ни одного объекта для ДНЦ !!!" .
    17677      end.
    17678   find current buf_price-doc-forming exclusive-lock no-error .
    17679   if error-status :error then return error "запись захвачена" .
    17680    assign frame Dialog-Frame
