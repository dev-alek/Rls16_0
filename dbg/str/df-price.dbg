    17171              v-errr = true .
    17172              v-errstr = substitute("Запрет на добавление товаров и услуг в переоценку " , buf1_goods.artic, buf1_goods.gds-name, buf1_goods.gds-type , buf1_goods.unit-base ) .
    17173              next .
    17174           end.
    17175           if buf1_goods.gds-type = 'у':U then do:
    17176              v-errr = true .
    17177              v-errstr = substitute("Запрет на добавление товаров и услуг в переоценку " , buf1_goods.artic, buf1_goods.gds-name, buf1_goods.gds-type ) .
    17178              next .
    17179           end.
    17180       end.
    17181       when '6':U  then do:
    17182           if buf1_goods.gds-type <> 'у':U  then do:
    17183               v-errr = true .
    17184               v-errstr = substitute("Запрет на добавление топлива и товара в переоценку " , buf1_goods.artic, buf1_goods.gds-name, buf1_goods.gds-type, buf1_goods.unit-base ) .
