     3671   END PROCEDURE.
     3672   PROCEDURE write-retro-bonus :
     3673   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3674   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3675   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3676   define input  parameter v-retro-bonus as character   no-undo .
     3677     do
     3678     on error undo, return error return-value
     3679     :
     3680       find first ub.contract-specif-attr exclusive-lock  where
     3681                 ub.contract-specif-attr.contract-num = p-contract-num  and
     3682                 ub.contract-specif-attr.host-code    = p-host-code     and
     3683                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     3684                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3685                 no-error .
     3686         if not available ub.contract-specif-attr then do:
     3687            create ub.contract-specif-attr .
     3688            assign
     3689                 ub.contract-specif-attr.contract-num = p-contract-num
     3690                 ub.contract-specif-attr.host-code    = p-host-code
     3691                 ub.contract-specif-attr.gds-code     = p-gds-code
     3692                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     3693            .
     3694            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3695            if error-status:error then
     3696               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3697         end.
     3698         else do:
     3699            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     3700            if error-status:error then
     3701               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     3702         end.
     3703       find first ub.contract-specif exclusive-lock where
     3704           ub.contract-specif.contract-num = p-contract-num and
     3705           ub.contract-specif.host-code    = p-host-code    and
     3706           ub.contract-specif.gds-code     = p-gds-code.
     3707           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3708   end.
     3709   END PROCEDURE.
     3710   PROCEDURE read-retro-bonus :
     3711   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     3712   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     3713   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     3714   define output parameter v-retro-bonus as character   no-undo .
     3715     do
     3716     on error undo, return error return-value
     3717     :
     3718   find first ub.contract-specif-attr no-lock  where
     3719              ub.contract-specif-attr.contract-num = p-contract-num  and
     3720              ub.contract-specif-attr.host-code    = p-host-code     and
     3721              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3722              ub.contract-specif-attr.attr-code    = "retro-bonus"
     3723              no-error .
     3724      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     3725                                           else  v-retro-bonus = "" .
     3726   end.
     3727   END PROCEDURE.
     3728   define variable v-str1 as character no-undo .
     3729   FUNCTION fnc-base-price-doc RETURN decimal
     3730     ( local-bc as integer, p-recid as recid ).
     3731   define buffer   base-price       for ub.price-doc-forming-gds .
     3732   define variable local-main-code like ub.bar-code.b-code no-undo.
     3733   define variable local-base-code like ub.bar-code.b-code no-undo.
     3734   define buffer   buf_main-pdf     for ub.price-doc-forming .
     3735   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     3736     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     3737     find base-price no-lock where
     3738          base-price.pdf-id = buf_main-pdf.pdf-id and
     3739          base-price.pdf-db = buf_main-pdf.pdf-db and
     3740          base-price.plt-id = buf_main-pdf.plt-id and
     3741          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3742          base-price.b-code  = local-base-code
     3743          no-error.
     3744     if not available base-price then do:
     3745       run prc-main-code in this-procedure
     3746          ( input local-bc, output local-main-code ).
     3747       find  base-price no-lock where
     3748             base-price.pdf-id = buf_main-pdf.pdf-id and
     3749             base-price.pdf-db = buf_main-pdf.pdf-db and
     3750             base-price.plt-id = buf_main-pdf.plt-id and
     3751             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     3752             base-price.b-code  = local-main-code
     3753             no-error.
     3754     end.
     3755     if available base-price then
     3756       return (base-price.price-sale-doc).
     3757     else
     3758       return (?).
     3759   END FUNCTION.
     3760   procedure set-price-line :
     3761     do
     3762     on error undo, return error return-value
     3763     :
     3764   define input  parameter p-plt-id as integer   no-undo .
     3765   define input  parameter p-plt-db as integer   no-undo .
     3766   define input  parameter  p-calc-method      as character no-undo .
     3767   define input  parameter  p-increase-pc      as decimal   no-undo .
     3768   define input  parameter  p-round-method     as character no-undo .
     3769   define input  parameter  p-round-base       as decimal   no-undo .
     3770   define input  parameter  p-b-code           as integer   no-undo .
     3771   define input  parameter  p-gds-code         as integer   no-undo .
     3772   define input  parameter  p-artic            as character no-undo .
     3773   define input  parameter  p-prod-type        as character no-undo .
     3774   define input  parameter  p-prod-code        as integer   no-undo .
     3775   define input  parameter  p-base-rate        as decimal   no-undo .
     3776   define input  parameter  p-base-scale       as decimal   no-undo .
     3777   define input  parameter  p-exch-scale       as decimal   no-undo .
     3778   define input  parameter  p-exch-rate        as decimal   no-undo .
     3779   define input  parameter  v-doc-code         as character no-undo .
     3780   define input  parameter  common-price       as decimal   no-undo .
     3781   define input  parameter  v-copy-type        as character no-undo .
     3782   define input  parameter  v-copy-code        as integer   no-undo .
     3783   define output parameter  p-new-calc-method  as character no-undo .
     3784   define output parameter  p-price-calc-base  as decimal   no-undo .
     3785   define output parameter  p-price-calc-doc   as decimal   no-undo .
     3786   define output parameter  p-price-calc-rubl  as decimal   no-undo .
     3787   define output parameter  p-price-prev-base  as decimal   no-undo .
     3788   define output parameter  p-price-prev-doc   as decimal   no-undo .
     3789   define output parameter  p-price-prev-rubl  as decimal   no-undo .
     3790   define output parameter  p-price-sale-base  as decimal   no-undo .
     3791   define output parameter  p-price-sale-doc   as decimal   no-undo .
     3792   define output parameter  p-price-sale-rubl  as decimal   no-undo .
     3793   define output parameter  p-road-tax-base    as decimal   no-undo .
     3794   define output parameter  p-road-tax-doc     as decimal   no-undo .
