    15140   def var sort-labelbrowse-1   as character no-undo .
    15141   def var sort-clmnbrowse-1    as handle    no-undo .
    15142   def var cur-clmnbrowse-1     as handle    no-undo .
    15143   def var cur-clmn-locbrowse-1 as integer   no-undo .
    15144   def var re-querybrowse-1     as logical   initial no no-undo .
    15145   on start-search, ctrl-o of browse-1 in frame Dialog-Frame do:
    15146      run sort-brbrowse-1
    15147        (input (if available buf_price-doc-forming-gds
    15148                then recid(buf_price-doc-forming-gds)
    15149                else ?
    15150               )
    15151        ).
    15152   end.
    15153   PROCEDURE sort-brbrowse-1 :
    15154     define input parameter p-recid as recid no-undo .
    15155     if re-querybrowse-1 = no then do:
    15156       assign
    15157          cur-clmnbrowse-1 = browse-1:current-column in frame Dialog-Frame
    15158       .
    15159       if sort-clmnbrowse-1 <> ? then sort-clmnbrowse-1:column-fgcolor = 0.
    15160       if cur-clmnbrowse-1 = sort-clmnbrowse-1 then do:
    15161         assign
    15162            sort-labelbrowse-1 = ""
    15163            sort-clmnbrowse-1 = ?
    15164         .
    15165        end.
    15166        else do:
    15167          assign
    15168            sort-labelbrowse-1 = cur-clmnbrowse-1:label
    15169            sort-clmnbrowse-1  = cur-clmnbrowse-1
    15170            sort-clmnbrowse-1:column-fgcolor = 4
    15171          .
    15172        end.
    15173      end.
    15174     assign
    15175       cur-clmn-locbrowse-1 = 1
    15176     .
    15177     def var column-handle as handle no-undo .
    15178     column-handle = browse-1:first-column.
    15179     do while valid-handle(column-handle) :
    15180       if column-handle = cur-clmnbrowse-1 then do:
    15181         leave .
    15182       end.
    15183       column-handle = column-handle:NEXT-COLUMN.
    15184       assign
    15185         cur-clmn-locbrowse-1 = cur-clmn-locbrowse-1 + 1
    15186       .
    15187     end.
    15188     case sort-labelbrowse-1:
    15189           when '№'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.line-num"     .     run OpenBr (yes, no, '':U).   . END.
    15190           when 'Бар-код'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.b-code"     .     run OpenBr (yes, no, '':U).   . END.
    15191           when 'Артикул'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.artic"     .     run OpenBr (yes, no, '':U).   . END.
    15192           when 'Ед.'  then DO:    assign       sort-column-name = "buf_bar-code.unit-cli"     .     run OpenBr (yes, no, '':U).   . END.
    15193           when 'Наименование'  then DO:    assign       sort-column-name = "v-name"     .     run OpenBr (yes, no, '':U).   . END.
    15194           when 'НДС%'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.vat-pc"     .     run OpenBr (yes, no, '':U).   . END.
    15195           when 'Новая (вал.док)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-sale-doc"     .     run OpenBr (yes, no, '':U).   . END.
    15196           when 'Последняя (вал.док)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-prev-doc"     .     run OpenBr (yes, no, '':U).   . END.
    15197           when '%Н/П'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1func-old-pc&1,recid(buf_price-doc-forming-gds))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
    15198           when 'Исходная  (вал.док)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-calc-doc"     .     run OpenBr (yes, no, '':U).   . END.
    15199           when '%Н/И'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1func-calc-pc&1,recid(buf_price-doc-forming-gds))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
    15200           when 'Комп.цены (вал.док)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.road-tax-doc"     .     run OpenBr (yes, no, '':U).   . END.
    15201           when 'Акциз (вал.док)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.excise-doc"     .     run OpenBr (yes, no, '':U).   . END.
    15202           when 'Статус'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.stts"     .     run OpenBr (yes, no, '':U).   . END.
    15203           when 'Новая (нац.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-sale-rubl"     .     run OpenBr (yes, no, '':U).   . END.
    15204           when 'Последняя (нац.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-prev-rubl"     .     run OpenBr (yes, no, '':U).   . END.
    15205           when 'Исходная  (нац.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-calc-rubl"     .     run OpenBr (yes, no, '':U).   . END.
    15206           when 'Комп.цены (нац.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.road-tax-rubl"     .     run OpenBr (yes, no, '':U).   . END.
    15207           when 'Акциз (нац.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.excise-rubl"     .     run OpenBr (yes, no, '':U).   . END.
    15208           when 'Новая (баз.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-sale-base"     .     run OpenBr (yes, no, '':U).   . END.
    15209           when 'Последняя (баз.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-prev-base"     .     run OpenBr (yes, no, '':U).   . END.
    15210           when 'Исходная  (баз.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.price-calc-base"     .     run OpenBr (yes, no, '':U).   . END.
    15211           when 'Комп.цены (баз.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.road-tax-base"     .     run OpenBr (yes, no, '':U).   . END.
    15212           when 'Акциз (баз.вал)'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.excise-base"     .     run OpenBr (yes, no, '':U).   . END.
    15213           when 'Посл.ДНЦ'  then DO:    assign       sort-column-name = "buf_price-doc-forming-gds.prev-doc-code"     .     run OpenBr (yes, no, '':U).   . END.
    15214           when '*'  then DO:    assign       sort-column-name = "get-mark  (BUFFER buf_price-doc-forming-gds)"     .     run OpenBr (yes, no, '':U).   . END.
    15215           when '№ Партии'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1func-part-code&1,recid(buf_price-doc-forming-gds))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
    15216       otherwise do:
    15217         assign
    15218           sort-column-name = ""
    15219         .
    15220         run Open1 .
    15221         if sort-labelbrowse-1 <> "" then do:
    15222           assign
    15223             cur-clmnbrowse-1:column-fgcolor = 0
    15224           .
    15225         end.
    15226         assign
    15227           cur-clmn-locbrowse-1 = ?
    15228         .
    15229       end.
    15230     end case.
    15231     if p-recid <> ? then do:
    15232       reposition browse-1 to recid p-recid no-error.
    15233       apply "value-changed" to browse-1 in frame Dialog-Frame.
    15234     end.
    15235     apply "entry" to browse-1 in frame Dialog-Frame.
    15236   END PROCEDURE.
    15237   procedure re-open-query-srt-clmnbrowse-1:
    15238   if cur-clmnbrowse-1 = ? then do:
    15239      run Open1 .
    15240   end.
    15241   else do:
    15242      assign re-querybrowse-1 = yes.
    15243      run sort-brbrowse-1
    15244        (input (if available buf_price-doc-forming-gds
    15245                then recid(buf_price-doc-forming-gds)
    15246                else ?
    15247               )
    15248        ).
    15249      assign re-querybrowse-1 = no.
    15250   end.
    15251   end.
    15252   define variable vss-include-info127 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15253   on F9 of frame Dialog-Frame anywhere do:
    15254     run get-gds-rec.
    15255     if gds-rec = ? then
    15256       return no-apply.
    15257     run ref/gds-form.w ( input parParentProc
    15258                         ,input 'ПРОСМОТР':U
    15259                         ,input ?
    15260                         ,input ?
    15261                         ,input ?
    15262                         ,input-output gds-rec).
    15263     apply "entry" to BROWSE-1 in frame Dialog-Frame.
    15264     return no-apply.
    15265   end.
    15266   buf_price-doc-forming-gds.price-sale-doc:label-fgcolor in browse browse-1 = blue_color .
    15267   buf_price-doc-forming-gds.excise-doc:label-fgcolor in browse browse-1 = blue_color .
    15268   buf_price-doc-forming-gds.road-tax-rubl:label-fgcolor in browse browse-1 = blue_color .
