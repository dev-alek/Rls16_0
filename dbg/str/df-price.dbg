     6956   ,input  p-prod-code
     6957   ,input  V-base-rate
     6958   ,input  V-base-scale
     6959   ,input  V-exch-scale
     6960   ,input  V-exch-rate
     6961   ,input  ""
     6962   ,input  p-price
     6963   ,input  ""
     6964   ,input  ?
     6965   ,output p-new-calc-method
     6966   ,output v-price-calc-base
     6967   ,output v-price-calc-doc
     6968   ,output v-price-calc-rubl
     6969   ,output v-price-prev-base
     6970   ,output v-price-prev-doc
     6971   ,output v-price-prev-rubl
     6972   ,output v-price-sale-base
     6973   ,output v-price-sale-doc
     6974   ,output v-price-sale-rubl
     6975   ,output v-road-tax-base
     6976   ,output v-road-tax-doc
     6977   ,output v-road-tax-rubl
     6978   ,output v-excise-base
     6979   ,output v-excise-doc
     6980   ,output v-excise-rubl
