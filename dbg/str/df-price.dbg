     9208   procedure last-incom-S :
     9209   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     9210   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     9211   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     9212   define output parameter p-in-code   as character no-undo .
     9213   define output parameter p-obj-type  as character no-undo .
     9214   define output parameter p-obj-code  as integer   no-undo .
     9215     do
     9216     on error undo, return error return-value
     9217     :
     9218     define buffer buf_trn-doc for ub.trn-doc .
     9219     define buffer buf_gds-obj for ub.gds-obj  .
     9220     do
     9221     on error undo, return error
     9222     :
     9223       assign
     9224         p-in-code  = ""
     9225         p-obj-type = ""
     9226         p-obj-code = 0
     9227       .
     9228        for each x_obj-group ,
     9229         each buf_gds-obj no-lock
     9230         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     9231           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     9232           and buf_gds-obj.artic     = p-artic
     9233           and buf_gds-obj.prod-type = p-prod-type
     9234           and buf_gds-obj.prod-code = p-prod-code
     9235       , first buf_trn-doc no-lock
     9236         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     9237           and buf_trn-doc.status_  = 'факт':U
     9238       on error undo, return error
     9239       by buf_trn-doc.fact-order descending
     9240       :
     9241         assign
     9242           p-in-code  = buf_gds-obj.in-code
     9243           p-obj-type = buf_gds-obj.obj-type
     9244           p-obj-code = buf_gds-obj.obj-code
     9245         .
     9246         leave .
     9247       end.
     9248     end.
     9249     end.
     9250   end procedure.
