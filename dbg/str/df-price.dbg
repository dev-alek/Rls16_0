    11683   ON CHOOSE OF b-notes IN FRAME Dialog-Frame
    11684   DO:
    11685   define variable vss-include-info104 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11686   if lookup(self :type
    11687            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    11688            ) = 0
    11689   then do:
