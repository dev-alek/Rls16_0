    17940   PROCEDURE seach-artic :
    17941   define input  parameter p-artic as character no-undo .
    17942   define input  parameter p-next as logical   no-undo .
    17943   if p-next = true then do:
    17944      find next buf_price-doc-forming-gds no-lock where
    17945                buf_price-doc-forming-gds.artic begins loc-art and
    17946                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    17947                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    17948                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    17949                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
    17950                 if not available buf_price-doc-forming-gds then do:
    17951                   message "Еще запись не найдена ! " view-as alert-box information .
    17952                   return .
    17953                 end.
    17954   end.
    17955   else do:
    17956     find first buf_price-doc-forming-gds no-lock where
    17957                buf_price-doc-forming-gds.artic begins loc-art and
    17958                buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id and
    17959                buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db and
    17960                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    17961                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
    17962                 if not available buf_price-doc-forming-gds then do:
    17963                   message "Запись не найдена !" view-as alert-box information .
    17964                   return .
    17965                 end.
    17966   end.
    17967   reposition BROWSE-1 to rowid rowid(buf_price-doc-forming-gds) no-error .
    17968   apply "value-changed" to BROWSE-1 in frame Dialog-Frame.
    17969   END PROCEDURE.
