    16897         parameter-5-140 = (" " + "" + " " + ", EACH buf_goods OF buf_price-doc-forming-gds NO-LOCK,                                    EACH buf_bar-code OF buf_price-doc-forming-gds NO-LOCK                                    where buf_goods.unit-base = buf_bar-code.unit-cli" + " " + p-find-condition)
    16898         parameter-6-140 = if sort-phrase-140 = ''
    16899                              then
    16900           (
    16901           " " + " " +
    16902             " " + sort-column-phrase +
    16903           " " + " by buf_price-doc-forming-gds.line-num  "
    16904           )
    16905                              else
    16906           (
    16907           " " + " " +
    16908             " " + sort-column-phrase +
    16909           " " + sort-phrase-140
    16910           )
    16911         parameter-7-140 =
    16912           "   "
    16913       .
    16914         run fltopend_fltfindq in this-procedure  (
    16915                             input this-procedure:handle
    16916                             ,input query BROWSE-1:handle
    16917                             ,input logical(parameter-2-140)
    16918                             ,input no-lock
    16919                             ,input parameter-3-140
    16920                             ,input parameter-4-140
    16921                             ,input parameter-5-140
    16922                             ,input parameter-6-140
    16923                             ,input parameter-7-140
    16924                             ,output v-fltopend-rowid
    16925                             ) no-error.
    16926         .
    16927         doc-rec = ?.
    16928       end.
    16929       assign
    16930         l-query-was-opened = true
    16931       .
    16932     end.
    16933   end.
    16934     run waitfram-hide in this-procedure .
    16935   end.
    16936   end case.
    16937   run vc-pdf in this-procedure .
    16938   if not p-open-query then
    16939   reposition browse-1 to recid doc-rec no-error.
