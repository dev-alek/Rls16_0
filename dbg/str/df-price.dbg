     5085              old1_price-doc-forming-gds.b-code      = p-b-code
     5086              no-error .
     5087   if available old1_price-doc-forming-gds then do:
     5088      p-d-pcnt = old1_price-doc-forming-gds.d-pcnt .
     5089   end.
     5090   else do:
     5091     p-d-pcnt = 0 .
     5092   end.
     5093   case p-calc-method :
     5094      when 'Новая':U or
     5095      when 'Не-считать':U then do:
     5096       assign
     5097         p-new-calc-method = p-calc-method
     5098         cost-rubl = ?
     5099         cost-base = ?
     5100       .
     5101         if available buf_price-doc-forming then do:
     5102           assign
     5103             v-pdf-id      = buf_price-doc-forming.pdf-id
     5104             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     5105             v-plt-id2     = buf_price-doc-forming.plt-id
     5106             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     5107           .
     5108           find first buf_buf_price-doc-forming-gds no-lock where
     5109                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     5110                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     5111                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     5112                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     5113                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     5114                 no-error .
     5115               if available buf_buf_price-doc-forming-gds then do:
     5116                   assign
     5117                     cost-rubl = buf_buf_price-doc-forming-gds.price-sale-rubl
     5118                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     5119                   .
     5120               end.
     5121         end.
     5122      end.
     5123      when 'УчетнаяS':U  or
     5124      when 'Учет-рзрвS':U  or
     5125      when 'ПриходнаяS':U
     5126      then do:
     5127         run str/sgdsavrg.p
     5128         (   input  p-calc-method    ,
     5129             input  table x_obj-group ,
     5130             input  p-b-code    ,
     5131             input  p-artic     ,
     5132             input  p-prod-type ,
     5133             input  p-prod-code ,
     5134             output cost-base   ,
     5135             output cost-rubl   ,
     5136             output cur-rt-base ,
     5137             output cur-rt-rubl
     5138             ).
     5139      end.
     5140      when 'Учет-НДСS':U or
     5141      when 'Накл-безНДС':U or
     5142      when 'Стар-безНДС':U or
     5143      when 'Старая':U or
     5144      when 'Учет+накл':U or
     5145      when 'Уч+накл-НДС':U or
     5146      when 'Откат_цен':U then do:
     5147         run str/mplnovat.p
     5148           ( input  p-calc-method    ,
     5149             input  table x_obj-group ,
     5150             input  p-b-code    ,
     5151             input  p-artic     ,
     5152             input  p-prod-type ,
     5153             input  p-prod-code ,
     5154             input  0 ,
     5155             input  v-doc-code ,
     5156             input  p-vat-pc      ,
     5157             input  p-slt-pc      ,
     5158             output vd  ,
     5159             output vd  ,
     5160             output cost-base   ,
     5161             output cost-rubl   ,
     5162             output cur-rt-base ,
     5163             output cur-rt-rubl
     5164             ).
     5165      end.
     5166      when 'Накладная':U then do:
     5167           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     5168           find first buf_doc-line  no-lock where
     5169                     buf_doc-line.doc-code = v-doc-code      and
     5170                     buf_doc-line.artic    = p-artic         and
     5171                     buf_doc-line.prod-type   = p-prod-type  and
     5172                     buf_doc-line.prod-code   = p-prod-code no-error .
     5173           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     5174           find first buf_gds-dtl no-lock where
     5175                      buf_gds-dtl.doc-code  = v-doc-code   and
     5176                      buf_gds-dtl.artic     = p-artic      and
     5177                      buf_gds-dtl.prod-type = p-prod-type  and
     5178                      buf_gds-dtl.prod-code = p-prod-code  and
     5179                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     5180           assign
     5181             v1 = recid (buf_trn-doc)
     5182             v2 = recid (buf_doc-line)
     5183             v3 = recid (buf_gds-dtl)
     5184             v4  = buf_gds-dtl.prt-code
     5185             no-error .
     5186             if not v-base then do:
     5187               run str/pr-wbil.p
     5188               ( input "pr-doc"            ,
     5189                 input 'Накладная':U ,
     5190                 input v1               ,
     5191                 input v2               ,
     5192                 input v3               ,
     5193                 input v-doc-code       ,
     5194                 input ""               ,
     5195                 input p-gds-code       ,
     5196                 input p-artic          ,
     5197                 input p-prod-type      ,
     5198                 input p-prod-code      ,
     5199                 input v4               ,
     5200                 input 0                ,
     5201                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     5202                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     5203                 output cost-rubl       ,
     5204                 output v4
     5205                 ) no-error .
     5206             end.
     5207             else do:
     5208               run str/pr-wbil.p
     5209               ( input "pr-doc"            ,
     5210                 input 'Накладная':U ,
     5211                 input v1               ,
     5212                 input v2               ,
     5213                 input v3               ,
     5214                 input v-doc-code       ,
     5215                 input ""               ,
     5216                 input p-gds-code       ,
     5217                 input p-artic          ,
     5218                 input p-prod-type      ,
     5219                 input p-prod-code      ,
     5220                 input v4               ,
     5221                 input 0                ,
     5222                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     5223                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     5224                 output cost-base       ,
     5225                 output v4
     5226                 ) no-error .
     5227             end.
     5228             if not error-status :error then
     5229                 assign
     5230                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     5231                .
     5232       end.
     5233       when 'Переоценка':U then do:
     5234         find prev-list where
     5235              prev-list.b-code     = p-b-code and
     5236              prev-list.price-type = "" and
     5237              prev-list.doc-num    = v-doc-code no-lock no-error.
     5238         if available prev-list then
     5239           assign
     5240             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     5241             cur-rt-base = prev-list.road-tax
     5242             cur-rt-rubl = prev-list.road-tax
     5243             cost-rubl = prev-list.price-sale
     5244             cost-base = prev-list.price-sale
     5245             .
     5246         else
     5247           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     5248                   "- расчет невозможен."
     5249                   view-as alert-box information .
     5250       end.
     5251       when 'ДокФормЦены':U then do:
     5252       find first b_price-doc-forming no-lock where
     5253                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     5254                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     5255                  no-error .
     5256         find b_price-doc-forming-gds no-lock where
     5257              b_price-doc-forming-gds.b-code     = p-b-code and
     5258              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     5259              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     5260              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     5261              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     5262              no-error.
     5263         if available b_price-doc-forming-gds then
     5264           assign
     5265             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     5266             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     5267             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     5268             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     5269             cost-base   = b_price-doc-forming-gds.price-sale-base
     5270             .
     5271         else
     5272           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     5273                   "для товара :" skip
     5274                    "Бар-код" p-b-code     skip
     5275                    "Артикул" p-artic      skip
     5276                     p-prod-type  skip
     5277                     p-prod-code  skip
     5278                   "- расчет невозможен."
     5279                   view-as alert-box information .
     5280       end.
     5281       when 'Единая':U then do:
     5282           assign
     5283             p-new-calc-method = 'Единая':U + " " + string(common-price)
     5284             cost-rubl = common-price
     5285             cost-base = common-price
     5286             .
     5287       end.
     5288       when 'Объект':U then do:
     5289       find first buf_gds-obj no-lock where
     5290                  buf_gds-obj.gds-code = p-gds-code and
     5291                  buf_gds-obj.obj-type = v-copy-type and
     5292                  buf_gds-obj.obj-code = v-copy-code no-error .
     5293           if available buf_gds-obj then do:
     5294           assign
     5295             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     5296             cost-rubl = buf_gds-obj.price-sale
     5297             cost-base = buf_gds-obj.price-sale
     5298             .
     5299           end.
     5300           else do:
     5301               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     5302                       "для товара :" p-artic  "- расчет невозможен."
     5303                       view-as alert-box information .
     5304           end.
     5305       end.
     5306      when 'Отсутствует':U or
     5307      when "" then do:
     5308         run str/mplnovat.p
     5309           ( input  'Отсутствует':U    ,
     5310             input  table x_obj-group ,
     5311             input  p-b-code    ,
     5312             input  p-artic     ,
     5313             input  p-prod-type ,
     5314             input  p-prod-code ,
     5315             input  0 ,
     5316             input  v-doc-code ,
     5317             input  p-vat-pc      ,
     5318             input  p-slt-pc      ,
     5319             output vd  ,
     5320             output vd  ,
     5321             output cost-base   ,
     5322             output cost-rubl   ,
     5323             output cur-rt-base ,
     5324             output cur-rt-rubl
     5325             ).
     5326             cost-rubl = vd * p-exch-rate / p-exch-scale .
     5327             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5328             p-new-calc-method = 'Отсутствует':U .
     5329      end.
     5330      when 'Основная':U then do:
     5331      end.
     5332       when 'ПорогПр-НДС':U then do:
     5333         find first x_obj-group.
     5334             run calc-price-levelprod (
     5335               input 2          ,
     5336               input var-pr-r-b ,
     5337               input p-b-code   ,
     5338               input x_obj-group.obj-type ,
     5339               input x_obj-group.obj-code ,
     5340               output vd,
     5341               output v-descript
     5342             ) no-error.
     5343         if vd = 0 or vd = ?  then do:
     5344           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5345                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5346                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     5347                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     5348         end.
     5349         else do:
     5350             cost-rubl = vd .
     5351             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5352             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     5353         end.
     5354       end.
     5355       when 'ПорогПр+НДС':U then do:
     5356         find first x_obj-group.
     5357             run calc-price-levelprod (
     5358               input 1          ,
     5359               input var-pr-r-b ,
     5360               input p-b-code   ,
     5361               input x_obj-group.obj-type ,
     5362               input x_obj-group.obj-code ,
     5363               output vd ,
     5364               output v-descript
     5365             ) no-error.
     5366         if vd = 0 or vd = ?  then do:
     5367           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5368                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5369                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     5370                   view-as alert-box information .
     5371         end.
     5372         else do:
     5373             cost-rubl = vd .
     5374             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5375             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     5376         end.
     5377       end.
     5378       when 'Производит':U
     5379       then do:
     5380         find first x_obj-group.
     5381   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     5383   (  input  p-b-code
     5384    , input  x_obj-group.obj-type
     5385    , input  x_obj-group.obj-code
     5386    , output v-PriceWithVat
     5387    , output vd
     5388    , output v-prod-vat
     5389    , output v-str1
     5390    , output v-str1
     5391           ) no-error .
     5392         if error-status :error then
     5393         message
     5394           vss-workfile vss-revision vss-description skip
     5395           error-status :get-message(1) skip
     5396           return-value skip
     5397           "proprice.i"
     5398           view-as alert-box error
     5399         .
     5400         if vd = 0 or vd = ?  then do:
     5401           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5402                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5403                   "- расчет по производителю от последней приходной накладной невозможен."
     5404                   view-as alert-box question buttons OK-Cancel title "#3" update g#log as logical .
     5405         end.
     5406         else do:
     5407             cost-rubl = vd .
     5408             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5409             p-new-calc-method = p-calc-method .
     5410         end.
     5411       end.
     5412       when 'Произв-НДС':U
     5413       then do:
     5414         find first x_obj-group.
     5415   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     5417   (  input  p-b-code
     5418    , input  x_obj-group.obj-type
     5419    , input  x_obj-group.obj-code
     5420    , output vd
     5421    , output v-PriceWithVat
     5422    , output v-prod-vat
     5423    , output v-str1
     5424    , output v-str1
     5425           ) no-error .
     5426         if error-status :error then
     5427         message
     5428           vss-workfile vss-revision vss-description skip
     5429           error-status :get-message(1) skip
     5430           return-value skip
     5431           "proprice.i"
     5432           view-as alert-box error
     5433         .
     5434         if vd = 0 or vd = ?  then do:
     5435           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     5436                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     5437                   "- расчет по производителю от последней приходной накладной невозможен."
     5438                   view-as alert-box  .
     5439         end.
     5440         else do:
     5441             cost-rubl = vd .
     5442             cost-base = cost-rubl / p-base-rate * p-base-scale .
     5443             p-new-calc-method = p-calc-method .
     5444         end.
     5445       end.
     5446      when 'Спецификация':U
     5447      then do:
     5448         find first x_obj-group.
     5449         assign
     5450           v-num-specif    = 0
     5451           v-contract-code = 0
     5452         .
     5453         for each buf_contract no-lock
     5454         where buf_contract.host-code = v-cntxt-host-code-obj
     5455         :
     5456   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5457   ASSIGN
     5458      i-gl-Host-Code      = 0
     5459      i-gl-Contract-Code  = 0
     5460      i-gl-Extent3        = 0
     5461      .
     5462   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5463       INPUT  v-cntxt-host-code-obj,
     5464       INPUT  buf_contract.contract-code,
     5465       OUTPUT i-gl-Extent3
     5466      ).
     5467   IF i-gl-Extent3[1] = 2 THEN DO:
     5468      ASSIGN
     5469         i-gl-Host-Code      = i-gl-Extent3[2]
     5470         i-gl-Contract-Code  = i-gl-Extent3[3]
     5471         .
     5472   END. ELSE DO:
     5473      ASSIGN
     5474         i-gl-Host-Code      = v-cntxt-host-code-obj
     5475         i-gl-Contract-Code  = buf_contract.contract-code
     5476         .
     5477   END.
     5478   FOR EACH
     5479       buf_contract-specif
     5480        NO-LOCK
     5481        WHERE
     5482            buf_contract-specif.Host-code    = i-gl-Host-Code
     5483        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5484              :
     5485               if buf_contract-specif.gds-code = p-gds-code then do:
     5486                 assign
     5487                   v-num-specif = v-num-specif + 1
     5488                   v-contract-code = buf_contract.contract-code
     5489                 .
     5490               end.
     5491           end.
     5492         end.
     5493         if v-num-specif > 1 then do:
     5494            run str/gds-cnts.w
     5495               (input parparentproc
     5496               ,input p-gds-code
     5497               , "b-sel":U
     5498               ,output v-spis
     5499             ) no-error.
     5500           find first buf_contract-specif no-lock
     5501           where recid(buf_contract-specif) = integer(v-spis)
     5502             no-error.
     5503             if available buf_contract-specif then do:
     5504                 run read-bonus (
     5505                     input  buf_contract-specif.contract-num  ,
     5506                     input  buf_contract-specif.host-code     ,
     5507                     input  buf_contract-specif.gds-code      ,
     5508                     output v-bonus  ) .
     5509                 assign
     5510                   cost-rubl = buf_contract-specif.price-cli
     5511                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5512                   p-new-calc-method = 'Спецификация':U
     5513                 .
     5514                 if v-bonus <> ? and v-bonus <> 0 then do:
     5515                    assign
     5516                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5517                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5518                    .
     5519                 end.
     5520             end.
     5521             else do:
     5522               message "Не найдена спецификация с recid " v-spis skip
     5523                       "для товара с артикулом " p-artic skip
     5524                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5525                       view-as alert-box information .
     5526             end.
     5527         end.
     5528         if v-num-specif = 0 then do:
     5529             message "Не найдена ни одна спецификация" skip
     5530                     "для товара с артикулом " p-artic skip
     5531                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     5532                     view-as alert-box information .
     5533         end.
     5534         if v-num-specif = 1 then do:
     5535   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5536   ASSIGN
     5537      i-gl-Host-Code      = 0
     5538      i-gl-Contract-Code  = 0
     5539      i-gl-Extent3        = 0
     5540      .
     5541   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     5542       INPUT  v-cntxt-host-code-obj,
     5543       INPUT  v-contract-code,
     5544       OUTPUT i-gl-Extent3
     5545      ).
     5546   IF i-gl-Extent3[1] = 2 THEN DO:
     5547      ASSIGN
     5548         i-gl-Host-Code      = i-gl-Extent3[2]
     5549         i-gl-Contract-Code  = i-gl-Extent3[3]
     5550         .
     5551   END. ELSE DO:
     5552      ASSIGN
     5553         i-gl-Host-Code      = v-cntxt-host-code-obj
     5554         i-gl-Contract-Code  = v-contract-code
     5555         .
     5556   END.
     5557   FOR EACH
     5558       buf_contract-specif
     5559        NO-LOCK
     5560        WHERE
     5561            buf_contract-specif.Host-code    = i-gl-Host-Code
     5562        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     5563               :
     5564               if buf_contract-specif.gds-code = p-gds-code then do:
     5565                 run read-bonus (
     5566                     input  buf_contract-specif.contract-num  ,
     5567                     input  buf_contract-specif.host-code     ,
     5568                     input  buf_contract-specif.gds-code      ,
     5569                     output v-bonus  ) .
     5570                 assign
     5571                   cost-rubl = buf_contract-specif.price-cli
     5572                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     5573                   p-new-calc-method = 'Спецификация':U
     5574                 .
     5575                 if v-bonus <> ? and v-bonus <> 0 then do:
     5576                    assign
     5577                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     5578                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     5579                    .
     5580                 end.
     5581               end.
     5582             end.
     5583         end.
     5584      end.
     5585      otherwise do:
     5586        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     5587                  p-new-calc-method  skip
     5588                 "p-price-prev-doc " p-price-prev-doc  skip
     5589                 "mpl-lib ERR !!! " skip
     5590                 'артикул ' p-artic skip
     5591                 view-as alert-box information .
     5592      end.
     5593    end case.
     5594   run main-road-taxs in this-procedure
     5595     ( input p-artic     ,
     5596       input p-prod-type ,
     5597       input p-prod-code ,
     5598       input-output cur-rt-base ,
     5599       input-output cur-rt-rubl )
     5600       .
     5601     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     5602       return error "Не определен курс валюты документа" .
     5603     end.
     5604     if p-base-scale = 0  or  p-base-scale = ?  then do:
     5605        return error "Не определен курс базовой валюты " .
     5606     end.
     5607   if v-base = false then var-pr-r-b = "rubl":U .
     5608                     else var-pr-r-b =  "base":U .
     5609       if var-pr-r-b = "rubl":U then do:
     5610            case p-calc-method :
     5611            when 'ПорогПр-НДС':U then do:
     5612               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     5613            end.
     5614            when 'ПорогПр+НДС':U then do:
     5615               p-price-sale-rubl  =  cost-rubl .
     5616            end.
     5617            when  'Производит':U then do:
     5618               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     5619            end.
     5620            when  'Произв-НДС':U then do:
     5621               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     5622            end.
     5623            otherwise do:
     5624               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     5625            end.
     5626           end case.
     5627           assign
     5628             p-price-calc-rubl  =  cost-rubl
     5629             p-road-tax-rubl    =  cur-rt-rubl
     5630             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5631             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5632             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5633           .
     5634       end.
     5635       else do:
     5636            case p-calc-method:
     5637               when 'ПорогПр-НДС':U then do:
     5638                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     5639               end.
     5640               when 'ПорогПр+НДС':U then do:
     5641                   p-price-sale-base  =  cost-base .
     5642               end.
     5643               when 'Производит':U then do:
     5644                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     5645               end.
     5646               when 'Произв-НДС':U then do:
     5647                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     5648               end.
     5649               otherwise do:
     5650                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     5651               end.
     5652            end case.
     5653           assign
     5654             p-price-calc-base  =  cost-base
     5655             p-road-tax-base    =  cur-rt-base
     5656             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     5657             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     5658             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     5659             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     5660             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     5661             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     5662           .
     5663       end.
     5664      if p-price-sale-doc <> 0 then do:
     5665   case p-round-method :
     5666     when '9-окончание':U then do:
     5667       if p-price-sale-doc < 29 then do:
     5668         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     5669           assign
     5670             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     5671           .
     5672         end.
     5673       end.
     5674       else do:
     5675         if (p-price-sale-doc modulo 10) < 3 then do:
     5676           assign
     5677             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5678                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5679                   - 1 ) * 10
     5680                 + 9
     5681           .
     5682         end.
     5683         else do:
     5684           assign
     5685             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     5686                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     5687                   ) * 10
     5688                 + 9
     5689           .
     5690         end.
     5691         assign
     5692           p-price-sale-doc = round (p-price-sale-doc, 0)
     5693         .
     5694       end.
     5695     end.
     5696     when '9-99окончание':U then do:
     5697       if p-price-sale-doc < p-round-base then do:
     5698         assign
     5699           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     5700         .
     5701       end.
     5702       else do:
     5703         assign
     5704           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     5705         .
     5706       end.
     5707     end.
     5708     when 'Без-дробных':U then do:
     5709       assign
     5710         p-price-sale-doc = round (p-price-sale-doc, 0)
     5711       .
     5712     end.
     5713     when 'Произвольно':U then do:
     5714       if p-round-base <> 0 then do:
     5715         assign
     5716           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     5717         .
     5718         if p-price-sale-doc = 0 then do:
     5719           assign
     5720             p-price-sale-doc = p-round-base
     5721           .
     5722         end.
     5723       end.
     5724     end.
     5725     when 'Вверх':U then do:
     5726       if p-round-base <> 0 then do:
     5727         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     5728           assign
     5729             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     5730           .
     5731         end.
     5732       end.
     5733       if p-price-sale-doc = 0 then do:
     5734         assign
     5735           p-price-sale-doc = p-round-base
     5736         .
     5737       end.
     5738     end.
     5739     when 'Коэффициент':U then do:
     5740       if p-round-base <> 0 then do:
     5741         assign
     5742           p-price-sale-doc = p-price-sale-doc * p-round-base
     5743         .
     5744       end.
     5745     end.
     5746     when 'Отключено':U then do:
     5747     end.
     5748     otherwise do:
     5749       message
     5750         vss-workfile vss-revision vss-description skip
     5751         "Неизвестный метод округления продажной цены" skip
     5752         "round-method" p-round-method skip
     5753         "round-base"   p-round-base   skip
     5754         "price"        p-price-sale-doc             skip
     5755         view-as alert-box error .
     5756     end.
     5757   end.
     5758     end.
     5759     assign
     5760       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     5761       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     5762       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     5763       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     5764      .
     5765     assign
     5766       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     5767       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     5768       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     5769       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     5770     .
     5771     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     5772     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     5773     p-prev-doc-code = if available bufold_price-doc-forming
     5774                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     5775                          else "" .
     5776   END PROCEDURE.
     5777   PROCEDURE create-line :
     5778   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     5779   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     5780   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     5781   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     5782   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     5783   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     5784   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     5785   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     5786   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     5787   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     5788   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     5789   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     5790   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     5791   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     5792   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     5793   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     5794   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     5795   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     5796   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     5797   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     5798   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     5799   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     5800   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     5801   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     5802   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     5803   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     5804   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     5805   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     5806   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     5807   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     5808   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     5809   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     5810   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     5811   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     5812   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     5813   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     5814   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     5815   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     5816   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     5817   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     5818   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     5819   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     5820   define input  parameter p-prev-doc-code     as character no-undo .
     5821   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     5822   define input-output parameter  v-sec        as integer   no-undo .
     5823     run check-use-bar-code ( p-b-code ) no-error .
     5824     if error-status :error then do:
     5825       message
     5826         return-value skip
     5827         "Ошибка !"
     5828         view-as alert-box error
     5829       .
     5830       undo, return error return-value.
     5831     end.
     5832   find first ub.price-doc-forming-gds exclusive-lock where
     5833              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     5834              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     5835              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     5836              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     5837              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     5838       if not available ub.price-doc-forming-gds then
     5839       do:
     5840         create ub.price-doc-forming-gds .
     5841          assign
     5842           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     5843           ub.price-doc-forming-gds.plt-id     = p-plt-id
     5844           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     5845           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     5846           ub.price-doc-forming-gds.b-code     = p-b-code
     5847           ub.price-doc-forming-gds.line-num   = p-line-num
     5848          .
     5849       end.
     5850     assign
     5851       ub.price-doc-forming-gds.artic            = p-artic
     5852       ub.price-doc-forming-gds.prod-type        = p-prod-type
     5853       ub.price-doc-forming-gds.prod-code        = p-prod-code
     5854       ub.price-doc-forming-gds.calc-method      = p-calc-method
     5855       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     5856       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     5857       ub.price-doc-forming-gds.start-date       = p-start-date
     5858       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     5859       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     5860       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     5861       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     5862       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     5863       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     5864       ub.price-doc-forming-gds.end-date         = p-end-date
     5865       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     5866       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     5867       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     5868       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     5869       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     5870       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     5871       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     5872       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     5873       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     5874       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     5875       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     5876       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     5877       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     5878       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     5879       ub.price-doc-forming-gds.excise-base      = p-excise-base
     5880       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     5881       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     5882       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     5883       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     5884       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     5885       ub.price-doc-forming-gds.stts             = p-stts
     5886       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     5887       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     5888       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     5889       .
     5890     run ref/h-pdfgds.p
     5891       ( buffer ub.price-doc-forming-gds ,
     5892         input p-price-sale-doc ,
     5893         input-output v-sec
     5894         ) .
     5895   END PROCEDURE.
     5896   PROCEDURE last-num :
     5897   define input  parameter p-recid as recid no-undo .
     5898   define output parameter p-last-id as integer   no-undo .
     5899   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     5900   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5901   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     5902         if error-status :error then do:
     5903           p-last-id = ? .
     5904           return .
     5905         end.
     5906       for each buf2_price-doc-forming-gds no-lock  where
     5907               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     5908               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     5909               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     5910               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     5911               by buf2_price-doc-forming-gds.line-num
     5912               :
     5913               p-last-id = buf2_price-doc-forming-gds.line-num .
     5914       end.
     5915   END PROCEDURE.
     5916   PROCEDURE calc-price-alt :
     5917   define input parameter bc         like ub.bar-code.b-code   no-undo.
     5918   define input parameter p-recid as recid no-undo .
     5919   define input parameter d-pcnt as decimal   no-undo .
     5920   define input parameter r-method   as character no-undo .
     5921   define input parameter r-base     as decimal   no-undo .
     5922   define output parameter pa-price-sale-base  as decimal   no-undo .
     5923   define output parameter pa-price-sale-doc   as decimal   no-undo .
     5924   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     5925   pr-alt:
     5926   do on error undo pr-alt, return error:
     5927     if r-method = ? or
     5928        r-base = ? then do:
     5929       message
     5930         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     5931         "Код:" bc skip
     5932         view-as alert-box error.
     5933       undo pr-alt, return error.
     5934     end.
     5935   define buffer buf_bar-code for ub.bar-code  .
     5936   define buffer buf_main_bar-code for ub.bar-code  .
     5937   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     5938   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     5939   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     5940   if error-status :error then
     5941   message
     5942     vss-workfile vss-revision vss-description skip
     5943     error-status :get-message(1) skip
     5944     return-value skip
     5945     "Ошибка "
     5946     view-as alert-box error
     5947   .
     5948   find first buf_bar-code no-lock where
     5949              buf_bar-code.b-code = bc no-error .
     5950   if error-status :error then
     5951   message
     5952     vss-workfile vss-revision vss-description skip
     5953     error-status :get-message(1) skip
     5954     return-value skip
     5955     "3"
     5956     view-as alert-box error
     5957   .
     5958         assign
     5959           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     5960                               buf_bar-code.cli-base-rate *
     5961                               (1 - d-pcnt / 100)
     5962                                 .
     5963     if pa-price-sale-doc <> 0 then do:
     5964   case r-method :
     5965     when '9-окончание':U then do:
     5966       if pa-price-sale-doc < 29 then do:
     5967         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     5968           assign
     5969             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     5970           .
     5971         end.
     5972       end.
     5973       else do:
     5974         if (pa-price-sale-doc modulo 10) < 3 then do:
     5975           assign
     5976             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5977                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5978                   - 1 ) * 10
     5979                 + 9
     5980           .
     5981         end.
     5982         else do:
     5983           assign
     5984             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     5985                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     5986                   ) * 10
     5987                 + 9
     5988           .
     5989         end.
     5990         assign
     5991           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5992         .
     5993       end.
     5994     end.
     5995     when '9-99окончание':U then do:
     5996       if pa-price-sale-doc < r-base then do:
     5997         assign
     5998           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     5999         .
     6000       end.
     6001       else do:
     6002         assign
     6003           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     6004         .
     6005       end.
     6006     end.
     6007     when 'Без-дробных':U then do:
     6008       assign
     6009         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     6010       .
     6011     end.
     6012     when 'Произвольно':U then do:
     6013       if r-base <> 0 then do:
     6014         assign
     6015           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     6016         .
     6017         if pa-price-sale-doc = 0 then do:
     6018           assign
     6019             pa-price-sale-doc = r-base
     6020           .
     6021         end.
     6022       end.
     6023     end.
     6024     when 'Вверх':U then do:
     6025       if r-base <> 0 then do:
     6026         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     6027           assign
     6028             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     6029           .
     6030         end.
     6031       end.
     6032       if pa-price-sale-doc = 0 then do:
     6033         assign
     6034           pa-price-sale-doc = r-base
     6035         .
     6036       end.
     6037     end.
     6038     when 'Коэффициент':U then do:
     6039       if r-base <> 0 then do:
     6040         assign
     6041           pa-price-sale-doc = pa-price-sale-doc * r-base
     6042         .
     6043       end.
     6044     end.
     6045     when 'Отключено':U then do:
     6046     end.
     6047     otherwise do:
     6048       message
     6049         vss-workfile vss-revision vss-description skip
     6050         "Неизвестный метод округления продажной цены" skip
     6051         "round-method" r-method skip
     6052         "round-base"   r-base   skip
     6053         "price"        pa-price-sale-doc             skip
     6054         view-as alert-box error .
     6055     end.
     6056   end.
     6057     end.
     6058     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     6059     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     6060   end.
     6061   END PROCEDURE.
     6062   procedure calc-price-discnt :
     6063     do
     6064     on error undo, return error return-value
     6065     :
     6066   define input parameter p-recid as recid no-undo .
     6067   define input parameter bc    like ub.bar-code.b-code   no-undo.
     6068   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     6069   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6070   define buffer buf-bar-code                      for ub.bar-code.
     6071   define buffer buf-goods                         for ub.goods.
     6072   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     6073   define variable pr-rec   as   recid                     no-undo.
     6074   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     6075   pr-discnt:
     6076   do on error undo pr-discnt, return error:
     6077     find  buf-price-doc-forming no-lock where
     6078           recid(buf-price-doc-forming) = p-recid .
     6079     find  buf-bar-code no-lock where
     6080           buf-bar-code.b-code = bc.
     6081     find  buf-goods no-lock where
     6082           buf-goods.gds-code = buf-bar-code.gds-code.
     6083     find  buf-price-doc-forming-gds exclusive-lock where
     6084           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6085           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6086           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6087           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6088           buf-price-doc-forming-gds.b-code  = bc.
     6089      if available buf-price-doc-forming-gds then do:
     6090         buf-price-doc-forming-gds.d-pcnt =
     6091         (1 - buf-price-doc-forming-gds.price-sale-doc /
     6092               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     6093               buf-bar-code.cli-base-rate) * 100 .
     6094      end.
     6095   end.
     6096     end.
     6097   end procedure.
     6098   procedure calc-price-sub :
     6099   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     6100   define  input  parameter p-recid      as recid no-undo .
     6101   define  input  parameter calc-method  as character         no-undo.
     6102   define  input  parameter increase-pc  as decimal           no-undo.
     6103   define  input  parameter round-method as character         no-undo.
     6104   define  input  parameter round-base   as decimal           no-undo.
     6105   define  input  parameter doc-code     as character no-undo .
     6106   define  input  parameter common-price as decimal   no-undo .
     6107   define  input  parameter copy-type    as character no-undo .
     6108   define  input  parameter copy-code    as integer   no-undo .
     6109   define  output parameter calc-rec     as recid             no-undo.
     6110   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6111   define  buffer buf-bar-code              for ub.bar-code.
     6112   define  buffer buf-goods                 for ub.goods.
     6113   define  buffer buf-gds-prt               for ub.gds-prt.
     6114   define  buffer buf-gds-grp               for ub.gds-grp.
     6115   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     6116   calc-sub:
     6117   do on error undo calc-sub, return error:
     6118     find  buf-price-doc-forming no-lock where
     6119           recid (buf-price-doc-forming) =  p-recid .
     6120     find  buf-bar-code no-lock where
     6121           buf-bar-code.b-code = bc.
     6122     find  buf-goods no-lock where
     6123           buf-goods.gds-code = buf-bar-code.gds-code.
     6124     find  buf-gds-prt no-lock where
     6125           buf-gds-prt.node-code = buf-bar-code.node-code.
     6126     find  buf-price-doc-forming-gds where
     6127           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6128           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6129           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6130           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6131           buf-price-doc-forming-gds.b-code      = bc no-error .
     6132     calc-rec = recid (buf-price-doc-forming-gds).
     6133     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     6134       for each  buf-price-doc-forming-gds exclusive-lock where
     6135                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6136                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6137                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6138                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     6139                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     6140                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     6141                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     6142           first buf-bar-code no-lock where
     6143                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     6144                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     6145           first buf-gds-prt no-lock where
     6146                 buf-gds-prt.node-code = buf-bar-code.node-code and
     6147                 buf-gds-prt.upper-code <> buf-goods.prt-root
     6148           on error undo calc-sub, return error:
     6149             run calc-price-line  in this-procedure
     6150               ( input  calc-method
     6151               , input  increase-pc
     6152               , input  round-method
     6153               , input  round-base
     6154               , input  buf-bar-code.b-code
     6155               , input  buf-goods.gds-code
     6156               , input  buf-goods.artic
     6157               , input  buf-goods.prod-type
     6158               , input  buf-goods.prod-code
     6159               , input  buf-price-doc-forming.base-rate
     6160               , input  buf-price-doc-forming.base-scale
     6161               , input  buf-price-doc-forming.exch-scale
     6162               , input  buf-price-doc-forming.exch-rate
     6163               , input  doc-code
     6164               , input  common-price
     6165               , input  copy-type
     6166               , input  copy-code
     6167               , output buf-price-doc-forming-gds.calc-method
     6168               , output buf-price-doc-forming-gds.price-calc-base
     6169               , output buf-price-doc-forming-gds.price-calc-doc
     6170               , output buf-price-doc-forming-gds.price-calc-rubl
     6171               , output buf-price-doc-forming-gds.price-prev-base
     6172               , output buf-price-doc-forming-gds.price-prev-doc
     6173               , output buf-price-doc-forming-gds.price-prev-rubl
     6174               , output buf-price-doc-forming-gds.price-sale-base
     6175               , output buf-price-doc-forming-gds.price-sale-doc
     6176               , output buf-price-doc-forming-gds.price-sale-rubl
     6177               , output buf-price-doc-forming-gds.road-tax-base
     6178               , output buf-price-doc-forming-gds.road-tax-doc
     6179               , output buf-price-doc-forming-gds.road-tax-rubl
     6180               , output buf-price-doc-forming-gds.excise-base
     6181               , output buf-price-doc-forming-gds.excise-doc
     6182               , output buf-price-doc-forming-gds.excise-rubl
     6183               , output buf-price-doc-forming-gds.vat-pc
     6184               , output buf-price-doc-forming-gds.slt-pc
     6185               , output buf-price-doc-forming-gds.prev-doc-code
     6186               , output buf-price-doc-forming-gds.d-pcnt
     6187               ) no-error .
     6188             if error-status :error then do :
     6189               message
     6190                 vss-workfile vss-revision vss-description skip
     6191                 error-status :get-message(1) skip
     6192                 return-value skip
     6193                 "calc-price-line"
     6194                 view-as alert-box error
     6195               .
     6196               undo calc-sub, return error.
     6197               end.
     6198         calc-rec = recid (buf-price-doc-forming-gds).
     6199       end.
     6200       for each  buf-price-doc-forming-gds exclusive-lock where
     6201                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     6202                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     6203                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     6204                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     6205                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     6206                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     6207                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     6208           first buf-bar-code no-lock where
     6209                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     6210                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     6211           first buf-gds-prt no-lock where
     6212                 buf-gds-prt.node-code = buf-bar-code.node-code
     6213           on error undo calc-sub, return error:
     6214       end.
     6215     end.
     6216     else do:
     6217     end.
     6218   end.
     6219   end procedure.
     6220   procedure calc-base-update :
     6221   define input parameter bc           like ub.bar-code.b-code   no-undo.
     6222   define input parameter p-recid      as recid no-undo .
     6223   define input parameter round-method as character    no-undo.
     6224   define input parameter round-base   as decimal      no-undo.
     6225   define buffer alt-bar-code              for ub.bar-code.
     6226   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     6227   define buffer buf-bar-code              for ub.bar-code.
     6228   define buffer buf-goods                 for ub.goods.
     6229   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     6230   calc-base:
     6231   do on error undo calc-base, return error :
     6232     find  buf-price-doc-forming no-lock where
     6233           recid (buf-price-doc-forming) =  p-recid .
     6234     find  buf-bar-code no-lock where
     6235           buf-bar-code.b-code = bc.
     6236     find  buf-goods no-lock where
     6237           buf-goods.gds-code = buf-bar-code.gds-code.
     6238     for each  alt-bar-code no-lock where
     6239               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     6240               alt-bar-code.node-code = buf-bar-code.node-code and
     6241               alt-bar-code.part-code = buf-bar-code.part-code and
     6242               alt-bar-code.in-code   = buf-bar-code.in-code and
     6243               alt-bar-code.unit-cli <> buf-goods.unit-base,
     6244         each  alt-price-doc-forming-gds exclusive-lock where
     6245               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     6246               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     6247               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     6248               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     6249               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     6250         on error undo calc-base, return error:
     6251     run calc-price-alt in this-procedure
     6252         ( input  alt-price-doc-forming-gds.b-code
     6253         , input  p-recid
     6254         , input  alt-price-doc-forming-gds.d-pcnt
     6255         , input  round-method
     6256         , input  round-base
     6257         , output alt-price-doc-forming-gds.price-sale-base
     6258         , output alt-price-doc-forming-gds.price-sale-doc
     6259         , output alt-price-doc-forming-gds.price-sale-rubl
     6260         ) no-error .
     6261       if error-status:error then do:
     6262       message
     6263         vss-workfile vss-revision vss-description skip
     6264         error-status :get-message(1) skip
     6265         return-value skip
     6266         "calc-price-alt"
     6267         view-as alert-box error
     6268       .
     6269         undo calc-base, return error.
     6270       end.
     6271     end.
     6272   end.
     6273   end procedure.
     6274   define temp-table temp-exp-partbc no-undo
     6275   field b-code  as integer
     6276   index pi b-code
     6277   .
     6278   procedure expose-prt :
     6279   define input  parameter p-calc-method  as character no-undo .
     6280   define input  parameter p-increase-pc as decimal   no-undo .
     6281   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     6282   define input  parameter old-recid      as recid no-undo .
     6283   define input  parameter new-recid      as recid no-undo .
     6284   define input  parameter p-round-method as character no-undo .
     6285   define input  parameter p-round-base   as decimal   no-undo .
     6286   define input  parameter v-doc-code     as character no-undo .
     6287   define input  parameter v-common-price as decimal   no-undo .
     6288   define input  parameter v-copy-type    as character no-undo .
     6289   define input  parameter v-copy-code    as integer   no-undo .
     6290   define input-output parameter v-line-num as integer   no-undo .
     6291   define input-output parameter v-sec      as integer   no-undo .
     6292   define output parameter new-rec-str      as recid   no-undo.
     6293   define buffer buf-bar-code              for ub.bar-code.
     6294   define buffer buf-goods                 for ub.goods.
     6295   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     6296   define buffer buf-price-list            for ub.price-doc-forming-gds.
     6297   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     6298   define buffer new-price-doc-forming     for ub.price-doc-forming.
     6299   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     6300   define buffer buf-gds-prt               for ub.gds-prt  .
     6301   define buffer buf_parts for ub.parts  .
     6302   define buffer buf_goods for ub.goods  .
     6303     do
     6304     on error undo, return error return-value
     6305     :
     6306     find  buf-price-doc-forming no-lock where
     6307           recid(buf-price-doc-forming) = old-recid .
     6308     find  new-price-doc-forming no-lock where
     6309           recid(new-price-doc-forming) = new-recid .
     6310     find  buf-bar-code no-lock where
     6311           buf-bar-code.b-code = p-main-code.
     6312     find  buf-goods no-lock where
     6313           buf-goods.gds-code = buf-bar-code.gds-code.
     6314     find  buf-price-doc-forming-gds no-lock  where
     6315           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     6316           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     6317           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     6318           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     6319           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     6320     if error-status :error then return .
     6321     find  buf-gds-prt no-lock where
     6322           buf-gds-prt.node-code = buf-bar-code.node-code.
     6323   if par-pr-altex = "yes" and
     6324      par-pr-notls = "yes" then do:
     6325   for each  buf-price-list where
     6326             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     6327             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     6328             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     6329             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     6330             buf-price-list.b-code     <> p-main-code and
     6331             buf-price-list.artic       = buf-goods.artic  and
     6332             buf-price-list.prod-type   = buf-goods.prod-type and
     6333             buf-price-list.prod-code   = buf-goods.prod-code
     6334             ,
     6335       first buf-bar-code no-lock where
     6336             buf-bar-code.b-code   = buf-price-list.b-code and
     6337             buf-bar-code.unit-cli <> buf-goods.unit-base:
     6338      run create-calc-bc in this-procedure
     6339          ( input  recid( new-price-doc-forming )
     6340           ,input  p-calc-method
     6341           ,input  p-increase-pc
     6342           ,input  p-round-method
     6343           ,input  p-round-base
     6344           ,input  buf-bar-code.b-code
     6345           ,input  buf-goods.gds-code
     6346           ,input  buf-goods.artic
     6347           ,input  buf-goods.prod-type
     6348           ,input  buf-goods.prod-code
     6349           ,input  new-price-doc-forming.base-rate
     6350           ,input  new-price-doc-forming.base-scale
     6351           ,input  new-price-doc-forming.exch-scale
     6352           ,input  new-price-doc-forming.exch-rate
     6353           ,input  v-doc-code
     6354           ,input  v-common-price
     6355           ,input  v-copy-type
     6356           ,input  v-copy-code
     6357           ,input-output v-line-num
     6358           ,input-output v-sec
     6359         ) no-error .
     6360     if error-status:error then do:
     6361       message
