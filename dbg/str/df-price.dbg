     3661     :
     3662   find first ub.contract-specif-attr no-lock  where
     3663              ub.contract-specif-attr.contract-num = p-contract-num  and
     3664              ub.contract-specif-attr.host-code    = p-host-code     and
     3665              ub.contract-specif-attr.gds-code     = p-gds-code      and
     3666              ub.contract-specif-attr.attr-code    = 'prc-min':U
     3667              no-error .
     3668      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     3669                                           else  v-prc-min = 0 .
