     8673                        if var-pr-r-b = "rubl"
     8674                           then l_price = v-price-rubl.
     8675                           else l_price = v-price-base.
     8676           end.
     8677           when "sale":u then do:
     8678                 l_price = ( if var-pr-r-b = "rubl"
     8679                                then b_doc-line.price-rubl
     8680                                else b_doc-line.price-base ).
     8681           end.
     8682           when "prod":u then do:
     8683   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8685   (  input  b_price-doc-forming-gds.b-code
     8686    , input  p-obj-type
     8687    , input  p-obj-code
     8688    , output l_pricewithoutvat
     8689    , output l_price
     8690    , output l_prod-vat
     8691    , output v-str2
     8692    , output v-str2
     8693           )  .
     8694       end.
     8695      when "prod-vat":u then do:
     8696   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8697   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     8698   (  input  b_price-doc-forming-gds.b-code
     8699    , input  p-obj-type
     8700    , input  p-obj-code
     8701    , output l_price
     8702    , output l_pricewithvat
     8703    , output l_prod-vat
     8704    , output v-str2
     8705    , output v-str2
     8706           )  .
     8707       end.
     8708         end case.
     8709           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     8710           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     8711      end.
     8712   end.
     8713     if  p-prc-max <> ? then do:
     8714       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     8715       then do:
     8716         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8717             else "По признаку"  )
     8718             b_price-doc-forming-gds.artic
     8719             b_price-doc-forming-gds.prod-type
     8720             b_price-doc-forming-gds.prod-code skip
     8721             "бар-код: " b_price-doc-forming-gds.b-code
     8722              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8723                else "" ) skip
     8724             fnc-pr  (buffer b_price-doc-forming-gds)
     8725             skip
     8726           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8727           "Процент не менее :" p-prc-min "%" skip
     8728           "Процент не более :" p-prc-max "%" skip
     8729           "Процент фактический :" t-prc  "%"  skip
     8730           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     8731           "БД" b_price-doc-forming-gds.pdf-db
     8732             view-as alert-box error .
     8733                 p-err = true .
     8734                 undo , return error .
     8735       end.
     8736       else do:
     8737          if  t-prc = ? then  do:
     8738             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     8739             else "По признаку"  )
     8740             b_price-doc-forming-gds.artic
     8741             b_price-doc-forming-gds.prod-type
     8742             b_price-doc-forming-gds.prod-code skip
     8743             "бар-код: " b_price-doc-forming-gds.b-code
     8744              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     8745                else "" ) skip
     8746             fnc-pr  (buffer b_price-doc-forming-gds)
     8747             skip
     8748             "Нет базовой цены для расчета процента наценки !" skip
     8749             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     8750             "Процент не менее :" p-prc-min "%" skip
     8751             "Процент не более :" p-prc-max "%" skip
     8752             "Процент фактический :" t-prc  "%"  skip
     8753             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     8754             "БД" b_price-doc-forming-gds.pdf-db
     8755             view-as alert-box error .
     8756             p-err = true .
     8757             undo , return error .
     8758          end.
     8759       end.
     8760     end.
     8761   end.
     8762     end.
     8763   end procedure.
     8764   procedure del-doc-line :
     8765   define input  parameter p-recid as recid no-undo .
     8766     do
     8767     on error undo, return error return-value
     8768     :
     8769     find first ub.price-doc-forming-gds exclusive-lock where
     8770          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     8771      if available ub.price-doc-forming-gds then do:
     8772         delete ub.price-doc-forming-gds no-error .
     8773      end.
     8774     end.
     8775   end procedure.
     8776   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8777   procedure factord :
     8778     define input  parameter p-fact-date            as date    no-undo .
     8779     define input  parameter p-fact-time            as integer no-undo .
     8780     define input  parameter p-fact-num             as integer no-undo .
     8781     define input  parameter p-shift-date           as date    no-undo .
     8782     define input  parameter p-shift-num            as integer no-undo .
     8783     define input  parameter p-shift-on             as logical no-undo .
     8784     define output parameter p-fact-order           as decimal no-undo .
     8785     define output parameter p-shift-end-fact-order as decimal no-undo .
     8786     define output parameter p-day-end-fact-order   as decimal no-undo .
     8787     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     8788     if p-fact-date = ?
     8789     then do:
     8790       return error "Не указана фактическая дата" .
     8791     end.
     8792     define variable v-fact-date-num as integer no-undo .
     8793     assign
     8794       v-fact-date-num = integer(p-fact-date)
     8795     .
     8796     if p-fact-num = ?
     8797     or p-fact-num = 0
     8798     then do:
     8799       return error "Не задан p-fact-num " + string(p-fact-num) .
     8800     end.
     8801     if p-fact-num < 0
     8802     then do:
     8803       return error "Отрицательный fact-num " + string(p-fact-num) .
     8804     end.
     8805     if p-fact-num >= 100000000
     8806     then do:
     8807       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     8808     end.
     8809     if p-shift-on = true
     8810     then do:
     8811       if p-shift-date = ?
     8812       then do:
     8813         return error "Не задана дата смены" .
     8814       end.
     8815       if p-shift-num = ?
     8816       or p-shift-num = 0
     8817       then do:
     8818         return error "Не задан номер смены" .
     8819       end.
     8820     end.
     8821     else do:
     8822       assign
     8823         p-shift-date = p-fact-date
     8824         p-shift-num  = 24
     8825       .
     8826     end.
     8827     define variable v-shift-offset as integer no-undo .
     8828     if p-shift-date = p-fact-date
     8829     then do:
     8830       assign
     8831         v-shift-offset = 1
     8832       .
     8833     end.
     8834     if p-shift-date < p-fact-date
     8835     then do:
     8836       assign
     8837         v-shift-offset = 0
     8838       .
     8839     end.
     8840     if p-shift-date > p-fact-date
     8841     then do:
     8842       message
     8843         vss-workfile vss-revision vss-description skip
     8844         "Неправильная дата закрытия смены" skip
     8845         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     8846         view-as alert-box error .
     8847       undo, return error
     8848         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     8849           ,string(p-fact-date, '99/99/9999':U)
     8850           ,string(p-shift-date, '99/99/9999':U)
     8851           )
     8852       .
     8853     end.
     8854     if p-shift-num < 1
     8855     or p-shift-num > 24
     8856     then do:
     8857       message
     8858         vss-workfile vss-revision vss-description skip
     8859         "Неправильный номер смены" skip
     8860         "p-shift-num" p-shift-num skip
     8861         view-as alert-box error .
     8862       undo, return error return-value .
     8863     end.
     8864     assign
     8865       p-fact-order           = v-fact-date-num
     8866                              + v-shift-offset * 0.5
     8867                              + p-shift-num    * 0.02 - 0.01
     8868                              + p-fact-num     * 0.0000000001
     8869       p-shift-end-fact-order = v-fact-date-num
     8870                              + v-shift-offset * 0.5
     8871                              + p-shift-num    * 0.02
     8872       p-day-end-fact-order   = v-fact-date-num
     8873                              + 0.99
     8874     .
     8875     if p-fact-order           <= v-fact-date-num
     8876     or p-shift-end-fact-order <= v-fact-date-num
     8877     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     8878     or p-shift-end-fact-order >= p-day-end-fact-order
     8879     then do:
     8880       message
     8881         vss-workfile vss-revision vss-description skip
     8882         "Внутренняя ошибка при генерации фактического номера" skip
     8883         "p-fact-date"            p-fact-date            skip
     8884         "p-fact-time"            p-fact-time            skip
     8885         "p-fact-num"             p-fact-num             skip
     8886         "p-shift-date"           p-shift-date           skip
     8887         "p-shift-num"            p-shift-num            skip
     8888         "p-shift-on"             p-shift-on             skip
     8889         "p-shift-end-fact-order" p-shift-end-fact-order skip
     8890         "p-day-end-fact-order"   p-day-end-fact-order   skip
     8891         "v-fact-date-num"        v-fact-date-num        skip
     8892         view-as alert-box error .
     8893       undo, return error return-value .
     8894     end.
     8895   end procedure.
     8896   procedure day-begin-fact-order :
     8897     define input  parameter p-fact-date            as date    no-undo .
     8898     define output parameter p-day-begin-fact-order as decimal no-undo .
     8899     do
     8900     on error undo, return error return-value
     8901     :
     8902       if p-fact-date = ?
     8903       then do:
     8904         assign
     8905           p-day-begin-fact-order = 0
     8906         .
     8907       end.
     8908       else do:
     8909         assign
     8910           p-day-begin-fact-order = integer(p-fact-date)
     8911         .
     8912       end.
     8913     end.
     8914   end procedure.
     8915   procedure factord-max-fact-order :
     8916     define output parameter p-max-fact-order as decimal   no-undo .
     8917     do
     8918     on error undo, return error return-value
     8919     :
     8920       run day-begin-fact-order in this-procedure
     8921         (input  date(1, 1, 5000)
     8922         ,output p-max-fact-order
     8923         ) .
     8924     end.
     8925   end procedure.
     8926   procedure factord-cut-archive :
     8927     define input  parameter p-obj-type             as character no-undo .
     8928     define input  parameter p-obj-code             as integer   no-undo .
     8929     define input  parameter p-fact-date            as date      no-undo .
     8930     define output parameter p-shift-on             as logical   no-undo .
     8931     define output parameter p-shift-date           as date      no-undo .
     8932     define output parameter p-shift-num            as integer   no-undo .
     8933     define output parameter p-day-end-fact-order   as decimal   no-undo .
     8934     define output parameter p-shift-end-fact-order as decimal   no-undo .
     8935     define variable v-fact-order as decimal   no-undo .
     8936     define buffer buf_shift-obj for ub.shift-obj .
     8937     do
     8938     on error undo, return error return-value
     8939     :
     8940   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8942     (input  p-obj-type
     8943     ,input  p-obj-code
     8944     ,input  'shift-on=request'
     8945     ,output p-shift-on
     8946     ) no-error .
     8947       if error-status :error
     8948       then do:
     8949         message
     8950           vss-workfile vss-revision vss-description skip
     8951           "Ошибка при определении атрибута объекта" skip
     8952           "Объект" p-obj-type p-obj-code skip
     8953           error-status :get-message(1) skip
     8954           return-value skip
     8955           view-as alert-box error .
     8956         undo, return error return-value .
     8957       end.
     8958       if p-shift-on = false
     8959       then do:
     8960         assign
     8961           p-shift-date               = ?
     8962           p-shift-num                = 0
     8963         .
     8964       end.
     8965       else do:
     8966         find first buf_shift-obj share-lock
     8967           where buf_shift-obj.obj-type   = p-obj-type
     8968             and buf_shift-obj.obj-code   = p-obj-code
     8969             and buf_shift-obj.shift-date > p-fact-date
     8970           use-index pi
     8971           no-error .
     8972         if not available buf_shift-obj
     8973         or buf_shift-obj.status_ <> 'зкр':U
     8974         then do:
     8975           message
     8976             vss-workfile vss-revision vss-description skip
     8977             "Невозможно вычислить последнюю смену" skip
     8978             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     8979             "Объект" p-obj-type p-obj-code skip
     8980             "Дата" p-fact-date skip
     8981             view-as alert-box error .
     8982           undo, return error return-value .
     8983         end.
     8984         find last buf_shift-obj share-lock
     8985           where buf_shift-obj.obj-type = p-obj-type
     8986             and buf_shift-obj.obj-code = p-obj-code
     8987             and buf_shift-obj.shift-date <= p-fact-date
     8988           use-index pi
     8989           no-error .
     8990         if available buf_shift-obj
     8991         then do:
     8992           if  buf_shift-obj.status_ = 'зкр':U
     8993           then do:
     8994             assign
     8995               p-shift-date = buf_shift-obj.shift-date
     8996               p-shift-num  = buf_shift-obj.shift-num
     8997             .
     8998           end.
     8999           else do:
     9000             message
     9001               vss-workfile vss-revision vss-description skip
     9002               "Невозможно вычислить последнюю смену" skip
     9003               "Статус смены отличен от статуса" 'зкр':U skip
     9004               "Объект" p-obj-type p-obj-code skip
     9005               "Дата" p-fact-date skip
     9006               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     9007               view-as alert-box error .
     9008             undo, return error return-value .
     9009           end.
     9010         end.
     9011         else do:
     9012           assign
     9013             p-shift-date = p-fact-date - 1
     9014             p-shift-num  = 1
     9015           .
     9016         end.
     9017       end.
     9018       run factord in this-procedure
     9019         (input  p-fact-date
     9020         ,input  1
     9021         ,input  1
     9022         ,input  p-shift-date
     9023         ,input  p-shift-num
     9024         ,input  p-shift-on
     9025         ,output v-fact-order
     9026         ,output p-shift-end-fact-order
     9027         ,output p-day-end-fact-order
     9028         ) no-error .
     9029       if error-status :error
     9030       then do:
     9031         message
     9032           vss-workfile vss-revision vss-description skip
     9033           "Ошибка при вызове процедуры factord"
     9034           error-status :get-message(1) skip
     9035           return-value skip
     9036           view-as alert-box error .
     9037         undo, return error return-value .
     9038       end.
     9039     end.
     9040   end procedure.
     9041   procedure factord-lock-shift :
     9042     define input  parameter p-obj-type  as character no-undo .
     9043     define input  parameter p-obj-code  as integer   no-undo .
     9044     define input  parameter p-fact-date as date      no-undo .
     9045     define parameter buffer buf_shift-obj for ub.shift-obj .
     9046     define variable v-shift-on      as logical   no-undo .
     9047     define variable v-extra-message as character no-undo .
     9048     define variable v-error as character no-undo .
     9049     do
     9050     on error undo, return error return-value
     9051     :
     9052   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9054     (input  p-obj-type
     9055     ,input  p-obj-code
     9056     ,input  'shift-on=request'
     9057     ,output v-shift-on
     9058     ) no-error .
     9059       if error-status :error
     9060       then do:
     9061         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     9062         undo, return error v-error .
     9063       end.
     9064       if v-shift-on = true
     9065       then do:
     9066         find first buf_shift-obj share-lock
     9067           where buf_shift-obj.obj-type   = p-obj-type
     9068             and buf_shift-obj.obj-code   = p-obj-code
     9069             and buf_shift-obj.shift-date > p-fact-date
     9070           use-index pi
     9071           no-error .
     9072         if not available buf_shift-obj
     9073         or buf_shift-obj.status_ <> 'зкр':U
     9074         then do:
     9075           find last buf_shift-obj
     9076             where buf_shift-obj.obj-type = p-obj-type
     9077               and buf_shift-obj.obj-code = p-obj-code
     9078               and buf_shift-obj.status_  = 'зкр':U
     9079             use-index stts
     9080             no-error .
     9081           if available buf_shift-obj
     9082           then do:
     9083             assign
     9084               v-extra-message =
     9085                     substitute("Дата начала последеней закрытой смены на объекте &1"
     9086                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     9087                               )
     9088             .
     9089           end.
     9090           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     9091           undo, return error v-error .
     9092         end.
     9093       end.
     9094     end.
     9095   end procedure.
     9096   procedure factord-end-day :
     9097     define input  parameter p-fact-date            as date    no-undo .
     9098     define output parameter p-day-end-fact-order   as decimal no-undo .
     9099     do
     9100     on error undo, return error return-value
     9101     :
     9102       if p-fact-date = ?
     9103       then do:
     9104         return error "Не указана фактическая дата" .
     9105       end.
     9106       assign
     9107         p-day-end-fact-order = integer(p-fact-date) + 0.99
     9108       .
     9109     end.
     9110   end procedure.
     9111   procedure factord-to-date :
     9112     define input  parameter p-fact-order as decimal no-undo .
     9113     define output parameter p-fact-date  as date    no-undo .
     9114     define variable v-ref-date  as date      no-undo .
     9115     define variable v-ref-delta as integer   no-undo .
     9116     do
     9117     on error undo, return error return-value
     9118     :
     9119       if p-fact-order = ?
     9120       or p-fact-order = 0
     9121       then do:
     9122         return error "Не указан fact-order" .
     9123       end.
     9124       assign
     9125         v-ref-date  = date(1, 1, 2000)
     9126       .
     9127       assign
     9128         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     9129       .
     9130       assign
     9131         p-fact-date = v-ref-date + v-ref-delta
     9132       .
     9133     end.
     9134   end procedure.
     9135   procedure factord-to-fact-num :
     9136     define input  parameter p-fact-order as decimal no-undo .
     9137     define output parameter p-fact-num   as integer no-undo .
     9138     define variable v-fact-order-trunc as decimal no-undo .
     9139     do
     9140     on error undo, return error return-value
     9141     :
     9142       if p-fact-order = ?
     9143       or p-fact-order = 0
     9144       then do:
     9145         return error "Не указан fact-order" .
     9146       end.
     9147       assign
     9148        v-fact-order-trunc = truncate(p-fact-order, 2)
     9149       .
     9150       assign
     9151         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     9152       .
     9153     end.
     9154   end procedure.
     9155   procedure factord-to-shift-num :
     9156     define input  parameter p-fact-order as decimal no-undo .
     9157     define output parameter p-shift-num   as integer no-undo .
     9158     define variable  p-shift-numd  as decimal   no-undo .
     9159     define variable v-fact-order-trunc as decimal no-undo .
     9160     do
     9161     on error undo, return error return-value
     9162     :
     9163       if p-fact-order = ?
     9164       or p-fact-order = 0
     9165       then do:
     9166         return error "Не указан fact-order" .
     9167       end.
     9168       assign
     9169        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     9170       .
     9171       if v-fact-order-trunc < 0.5 then do:
     9172         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     9173       end.
     9174       assign
     9175         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     9176         .
     9177        assign
     9178         p-shift-num = truncate (p-shift-numd , 0)
     9179       .
     9180     end.
     9181   end procedure.
     9182   def var vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9183   procedure tax-name:
     9184   define input  parameter pardef-tax  as character           no-undo.
     9185   define output parameter parname-tax as character initial ? no-undo.
     9186   define buffer bf_tax for ub.tax.
     9187   do on error undo, return error :
     9188      case pardef-tax:
     9189         when 'vat':U then do:
     9190                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     9191         end.
     9192         when 'slt':U then do:
     9193                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     9194         end.
     9195         when 'rdt':U then do:
     9196                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     9197         end.
     9198         when 'exc':U then do:
     9199                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     9200         end.
     9201         otherwise do:
     9202            return error "Задан неверный параметр " + pardef-tax + " .".
     9203         end.
     9204      end case.
     9205   end.
     9206   end procedure.
