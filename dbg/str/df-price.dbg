    11786   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
    11787   DO:
    11788     assign del-list = "".
    11789     if not available buf_price-doc-forming-gds then return.
    11790     for each buf_price-doc-forming-gds
    11791        where buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
    11792          and buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
    11793          and buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id
    11794          and buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db no-lock :
    11795   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11796   define variable v-str-recid107 as character no-undo .
    11797   define variable v-num-entry107 as integer   no-undo .
    11798   assign
    11799     v-str-recid107 = trim( string( recid( buf_price-doc-forming-gds ) , "->>>>>>>>>>>9":U ) )
    11800     v-num-entry107 = lookup( v-str-recid107 , del-list )
    11801   .
    11802   if v-num-entry107 > 0 then do:
    11803     assign
    11804       entry( v-num-entry107, del-list ) = "":U
    11805       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    11806     .
    11807   end.
    11808   else do:
    11809     assign
    11810       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid107
    11811     .
    11812   end.
    11813     end.
    11814     BROWSE-1:refresh() in frame Dialog-Frame .
    11815   END.
