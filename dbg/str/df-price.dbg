     4228             output cost-rubl   ,
     4229             output cur-rt-base ,
     4230             output cur-rt-rubl
     4231             ).
     4232      end.
     4233      when 'Учет-НДСS':U or
     4234      when 'Накл-безНДС':U or
     4235      when 'Стар-безНДС':U or
     4236      when 'Старая':U or
     4237      when 'Учет+накл':U or
     4238      when 'Уч+накл-НДС':U or
     4239      when 'Откат_цен':U then do:
     4240         run str/mplnovat.p
     4241           ( input  p-calc-method    ,
     4242             input  table x_obj-group ,
     4243             input  p-b-code    ,
     4244             input  p-artic     ,
