     4259      when 'Накладная':U then do:
     4260           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     4261           find first buf_doc-line  no-lock where
     4262                     buf_doc-line.doc-code = v-doc-code      and
     4263                     buf_doc-line.artic    = p-artic         and
     4264                     buf_doc-line.prod-type   = p-prod-type  and
     4265                     buf_doc-line.prod-code   = p-prod-code no-error .
     4266           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     4267           find first buf_gds-dtl no-lock where
     4268                      buf_gds-dtl.doc-code  = v-doc-code   and
     4269                      buf_gds-dtl.artic     = p-artic      and
     4270                      buf_gds-dtl.prod-type = p-prod-type  and
     4271                      buf_gds-dtl.prod-code = p-prod-code  and
     4272                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     4273           assign
     4274             v1 = recid (buf_trn-doc)
     4275             v2 = recid (buf_doc-line)
     4276             v3 = recid (buf_gds-dtl)
     4277             v4  = buf_gds-dtl.prt-code
     4278             no-error .
     4279             if not v-base then do:
     4280               run str/pr-wbil.p
     4281               ( input "pr-doc"            ,
     4282                 input 'Накладная':U ,
     4283                 input v1               ,
     4284                 input v2               ,
     4285                 input v3               ,
     4286                 input v-doc-code       ,
     4287                 input ""               ,
     4288                 input p-gds-code       ,
     4289                 input p-artic          ,
     4290                 input p-prod-type      ,
     4291                 input p-prod-code      ,
     4292                 input v4               ,
     4293                 input 0                ,
     4294                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4295                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4296                 output cost-rubl       ,
     4297                 output v4
     4298                 ) no-error .
     4299             end.
     4300             else do:
     4301               run str/pr-wbil.p
     4302               ( input "pr-doc"            ,
     4303                 input 'Накладная':U ,
     4304                 input v1               ,
     4305                 input v2               ,
     4306                 input v3               ,
     4307                 input v-doc-code       ,
     4308                 input ""               ,
     4309                 input p-gds-code       ,
     4310                 input p-artic          ,
     4311                 input p-prod-type      ,
     4312                 input p-prod-code      ,
     4313                 input v4               ,
     4314                 input 0                ,
     4315                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4316                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4317                 output cost-base       ,
     4318                 output v4
     4319                 ) no-error .
     4320             end.
     4321             if not error-status :error then
     4322                 assign
     4323                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     4324                .
     4325       end.
     4326       when 'Переоценка':U then do:
     4327         find prev-list where
     4328              prev-list.b-code     = p-b-code and
     4329              prev-list.price-type = "" and
     4330              prev-list.doc-num    = v-doc-code no-lock no-error.
     4331         if available prev-list then
     4332           assign
     4333             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     4334             cur-rt-base = prev-list.road-tax
     4335             cur-rt-rubl = prev-list.road-tax
     4336             cost-rubl = prev-list.price-sale
     4337             cost-base = prev-list.price-sale
     4338             .
     4339         else
     4340           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     4341                   "- расчет невозможен."
     4342                   view-as alert-box information .
     4343       end.
     4344       when 'ДокФормЦены':U then do:
     4345       find first b_price-doc-forming no-lock where
     4346                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     4347                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     4348                  no-error .
     4349         find b_price-doc-forming-gds no-lock where
     4350              b_price-doc-forming-gds.b-code     = p-b-code and
     4351              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     4352              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     4353              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     4354              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     4355              no-error.
     4356         if available b_price-doc-forming-gds then
     4357           assign
     4358             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     4359             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     4360             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     4361             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     4362             cost-base   = b_price-doc-forming-gds.price-sale-base
     4363             .
     4364         else
     4365           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     4366                   "для товара :" skip
     4367                    "Бар-код" p-b-code     skip
     4368                    "Артикул" p-artic      skip
     4369                     p-prod-type  skip
     4370                     p-prod-code  skip
     4371                   "- расчет невозможен."
     4372                   view-as alert-box information .
     4373       end.
     4374       when 'Единая':U then do:
     4375           assign
     4376             p-new-calc-method = 'Единая':U + " " + string(common-price)
     4377             cost-rubl = common-price
     4378             cost-base = common-price
     4379             .
     4380       end.
     4381       when 'Объект':U then do:
     4382       find first buf_gds-obj no-lock where
     4383                  buf_gds-obj.gds-code = p-gds-code and
     4384                  buf_gds-obj.obj-type = v-copy-type and
     4385                  buf_gds-obj.obj-code = v-copy-code no-error .
     4386           if available buf_gds-obj then do:
     4387           assign
     4388             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     4389             cost-rubl = buf_gds-obj.price-sale
     4390             cost-base = buf_gds-obj.price-sale
     4391             .
     4392           end.
     4393           else do:
     4394               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     4395                       "для товара :" p-artic  "- расчет невозможен."
     4396                       view-as alert-box information .
     4397           end.
     4398       end.
     4399      when 'Отсутствует':U or
     4400      when "" then do:
     4401         run str/mplnovat.p
     4402           ( input  'Отсутствует':U    ,
     4403             input  table x_obj-group ,
     4404             input  p-b-code    ,
     4405             input  p-artic     ,
     4406             input  p-prod-type ,
     4407             input  p-prod-code ,
     4408             input  0 ,
     4409             input  v-doc-code ,
     4410             input  p-vat-pc      ,
     4411             input  p-slt-pc      ,
     4412             output vd  ,
     4413             output vd  ,
     4414             output cost-base   ,
     4415             output cost-rubl   ,
     4416             output cur-rt-base ,
     4417             output cur-rt-rubl
     4418             ).
     4419             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4420             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4421             p-new-calc-method = 'Отсутствует':U .
     4422      end.
     4423      when 'Основная':U then do:
     4424      end.
     4425     when 'ПорогПр-НДС':U then do:
     4426       message 1.
     4427     end.
     4428     when 'ПорогПр+НДС':U then do:
     4429       message 2.
     4430     end.
     4431     when 'Производит':U
     4432        then do:
     4433         find first x_obj-group .
     4434   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4435   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4436   (  input  p-b-code
     4437    , input  x_obj-group.obj-type
     4438    , input  x_obj-group.obj-code
     4439    , output v-PriceWithVat
     4440    , output vd
     4441    , output v-prod-vat
     4442    , output v-str1
     4443    , output v-str1
     4444           ) no-error .
     4445         if vd = 0 or vd = ?  then do:
     4446           message "Нет ПН для товара :" p-artic  p-b-code
     4447                   "- расчет по производителю от последней приходной накладной невозможен."
     4448                   view-as alert-box question buttons OK-Cancel title "#2" update g#log as logical .
     4449         end.
     4450         else do:
     4451             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4452             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4453         end.
     4454     end.
     4455     when 'Произв-НДС':U
     4456       then do:
     4457         find first x_obj-group .
     4458   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     4460   (  input  p-b-code
     4461    , input  x_obj-group.obj-type
     4462    , input  x_obj-group.obj-code
     4463    , output vd
     4464    , output v-PriceWithVat
     4465    , output v-prod-vat
     4466    , output v-str1
     4467    , output v-str1
     4468           ) no-error .
     4469         if vd = 0 or vd = ?  then do:
     4470           message "Нет ПН для товара :" p-artic  p-b-code
     4471                   "- расчет по производителю от последней приходной накладной невозможен."
     4472                   view-as alert-box .
     4473         end.
     4474         else do:
     4475             cost-rubl = vd * p-exch-rate / p-exch-scale .
     4476             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4477         end.
     4478       end.
     4479      otherwise do:
     4480        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     4481                  p-new-calc-method  skip
     4482                 "p-price-prev-doc " p-price-prev-doc  skip
     4483                 "mpl-lib ERR !!! " skip
     4484                 'артикул ' p-artic skip
     4485                 view-as alert-box information .
     4486      end.
     4487    end case.
     4488   run main-road-taxs in this-procedure
     4489     ( input p-artic     ,
     4490       input p-prod-type ,
     4491       input p-prod-code ,
     4492       input-output cur-rt-base ,
     4493       input-output cur-rt-rubl )
     4494       no-error .
     4495       if error-status :error then do:
     4496          message
     4497            error-status :get-message(1) skip
     4498            return-value skip
     4499            "main-road-taxs"
     4500            view-as alert-box error
     4501          .
     4502       end.
     4503     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     4504       return error "Не определен курс валюты документа" .
     4505     end.
     4506     if p-base-scale = 0  or  p-base-scale = ?  then do:
     4507        return error "Не определен курс базовой валюты " .
     4508     end.
     4509   if v-base = false then var-pr-r-b = "rubl":U .
     4510                     else var-pr-r-b =  "base":U .
     4511       if var-pr-r-b = "rubl":U then do:
     4512           case p-calc-method :
     4513            when 'ПорогПр-НДС':U then do:
     4514               message 3.
     4515            end.
     4516            when 'ПорогПр+НДС':U then do:
     4517                message 4.
     4518            end.
     4519            when 'Производит':U then do:
     4520               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)   .
     4521            end.
     4522            when 'Произв-НДС':U then do:
     4523               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 +  p-vat-pc / 100)  .
     4524            end.
     4525            otherwise do:
     4526               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     4527            end.
     4528           end case.
     4529           assign
     4530             p-price-calc-rubl  =  cost-rubl
     4531             p-road-tax-rubl    =  cur-rt-rubl
     4532             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4533             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4534             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4535           .
     4536       end.
     4537       else dO:
     4538            case p-calc-method :
     4539            when 'ПорогПр-НДС':U then do:
     4540               message 5.
     4541            end.
     4542            when 'ПорогПр+НДС':U then do:
     4543                message 6.
     4544            end.
     4545            when 'Производит':U then do:
     4546               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4547            end.
     4548            when 'Произв-НДС':U then do:
     4549               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     4550            end.
     4551            otherwise do:
     4552               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4553            end.
     4554            end case.
     4555           assign
     4556             p-price-calc-base  =  cost-base
     4557             p-road-tax-base    =  cur-rt-base
     4558             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4559             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4560             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4561             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4562             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4563             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4564           .
     4565       end.
     4566   case p-round-method :
     4567     when '9-окончание':U then do:
     4568       if p-price-sale-doc < 29 then do:
     4569         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4570           assign
     4571             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4572           .
     4573         end.
     4574       end.
     4575       else do:
     4576         if (p-price-sale-doc modulo 10) < 3 then do:
     4577           assign
     4578             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4579                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4580                   - 1 ) * 10
     4581                 + 9
     4582           .
     4583         end.
     4584         else do:
     4585           assign
     4586             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4587                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4588                   ) * 10
     4589                 + 9
     4590           .
     4591         end.
     4592         assign
     4593           p-price-sale-doc = round (p-price-sale-doc, 0)
     4594         .
     4595       end.
     4596     end.
     4597     when '9-99окончание':U then do:
     4598       if p-price-sale-doc < p-round-base then do:
     4599         assign
     4600           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     4601         .
     4602       end.
     4603       else do:
     4604         assign
     4605           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     4606         .
     4607       end.
     4608     end.
     4609     when 'Без-дробных':U then do:
     4610       assign
     4611         p-price-sale-doc = round (p-price-sale-doc, 0)
     4612       .
     4613     end.
     4614     when 'Произвольно':U then do:
     4615       if p-round-base <> 0 then do:
     4616         assign
     4617           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     4618         .
     4619         if p-price-sale-doc = 0 then do:
     4620           assign
     4621             p-price-sale-doc = p-round-base
     4622           .
     4623         end.
     4624       end.
     4625     end.
     4626     when 'Вверх':U then do:
     4627       if p-round-base <> 0 then do:
     4628         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     4629           assign
     4630             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     4631           .
     4632         end.
     4633       end.
     4634       if p-price-sale-doc = 0 then do:
     4635         assign
     4636           p-price-sale-doc = p-round-base
     4637         .
     4638       end.
     4639     end.
     4640     when 'Коэффициент':U then do:
     4641       if p-round-base <> 0 then do:
     4642         assign
     4643           p-price-sale-doc = p-price-sale-doc * p-round-base
     4644         .
     4645       end.
     4646     end.
     4647     when 'Отключено':U then do:
     4648     end.
     4649     otherwise do:
     4650       message
     4651         vss-workfile vss-revision vss-description skip
     4652         "Неизвестный метод округления продажной цены" skip
     4653         "round-method" p-round-method skip
     4654         "round-base"   p-round-base   skip
     4655         "price"        p-price-sale-doc             skip
     4656         view-as alert-box error .
     4657     end.
     4658   end.
     4659       if error-status :error then do:
     4660       message
     4661         error-status :get-message(1) skip
     4662         return-value skip
     4663         "pr-99"
     4664         view-as alert-box error
     4665       .
     4666       end.
     4667     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     4668     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     4669     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     4670     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     4671     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     4672     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     4673     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     4674     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     4675     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4676     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4677     p-prev-doc-code = if available bufold_price-doc-forming
     4678                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4679                          else "" .
     4680     end.
     4681   end procedure.
     4682   PROCEDURE calc-price-line :
     4683   define input  parameter  p-calc-method      as character no-undo .
     4684   define input  parameter  p-increase-pc      as decimal   no-undo .
     4685   define input  parameter  p-round-method     as character no-undo .
