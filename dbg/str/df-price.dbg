    18022                buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id and
    18023                buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num and
    18024                can-find ( ub.goods where ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
    18025                                          ub.goods.prod-code = buf_price-doc-forming-gds.prod-code and
    18026                                          ub.goods.artic     = buf_price-doc-forming-gds.artic and
