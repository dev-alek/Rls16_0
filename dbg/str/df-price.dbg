     1711   define variable v-base-rate  as decimal   no-undo .
     1712   define variable v-base-scale as integer   no-undo .
     1713   define variable v-exch-rate  as decimal   no-undo .
     1714   define variable v-exch-scale as integer   no-undo .
     1715   define variable v-base as logical   no-undo .
