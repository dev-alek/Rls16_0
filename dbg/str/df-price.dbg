    15877                      main_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      and
    15878                      main_price-doc-forming-gds.b-code     = main-b-code
    15879                      no-error .
    15880           if available buf_price-doc-forming-gds then do:
    15881              buf_price-doc-forming-gds.d-pcnt =
    15882              (( (main_price-doc-forming-gds.price-sale-doc * bf_bar-code.cli-base-rate) - v-price  ) * 100) /
    15883                ( main_price-doc-forming-gds.price-sale-doc * bf_bar-code.cli-base-rate) no-error .
    15884           end.
    15885           end.
    15886     end.
    15887     input stream imp close.
