      741                         then v-cli-type-value
      742                         else p-cli-type
      743       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      744                         then v-cli-code-value
      745                         else p-cli-code
      746       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      747       jj = jj + 1
      748       .
      749     end.
      750     else do:
      751       assign
      752       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      753       jj = jj + 1
      754       .
      755     end.
      756   end.
      757   end.
