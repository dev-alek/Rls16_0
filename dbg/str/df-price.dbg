      724             v-range  = 3
      725         .
      726     end.
      727     if available buf_gds-grp-obj
      728     then do:
      729       assign
      730       v-cli-type-value    = buf_gds-grp-obj.cli-type
      731       v-cli-code-value    = buf_gds-grp-obj.cli-code
      732       .
      733       assign
      734       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
