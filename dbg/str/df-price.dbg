     9766   procedure del-pdf-attr-objdel :
     9767   define input  parameter p-pdf-id     as integer   no-undo .
     9768   define input  parameter p-pdf-db-num as integer   no-undo .
     9769   define input  parameter p-plt-id     as integer   no-undo .
     9770   define input  parameter p-plt-db-num as integer   no-undo .
     9771   define input  parameter p-obj-type   as character no-undo .
     9772   define input  parameter p-obj-code   as integer   no-undo .
     9773   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     9774     do
     9775     on error undo, return error return-value
     9776     :
     9777     find first buf_price-doc-forming-attr exclusive-lock where
     9778                buf_price-doc-forming-attr.pdf-id     = p-pdf-id      and
     9779                buf_price-doc-forming-attr.pdf-db     = p-pdf-db-num  and
     9780                buf_price-doc-forming-attr.plt-id     = p-plt-id      and
